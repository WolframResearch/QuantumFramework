Cell[BoxData[{
 RowBox[{
  RowBox[{"wig", " ", "=", " ", 
   RowBox[{"WignerRepresentation", "[", 
    RowBox[{
     RowBox[{"FockState", "[", "2", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
