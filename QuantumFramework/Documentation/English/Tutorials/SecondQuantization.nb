Cell[CellGroupData[{

Cell[TextData[{
 "Compute the expectation value ",
 Cell[BoxData[
  RowBox[{"\[LeftAngleBracket]", 
   SuperscriptBox["x", "4"], "\[RightAngleBracket]"}]], "InlineFormula",
  ExpressionUUID->"7692e4ed-531c-414d-8d0e-54aefc524f49"],
 ", for a purely position operator ",
 Cell[BoxData[
  SuperscriptBox["x", "4"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "338ba569-8e63-314a-be2e-47198b865013"],
 " its Weyl symbol is ",
 Cell[BoxData[
  SuperscriptBox["x", "4"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "fe22c973-8a22-9649-8691-5d472e3d045a"],
 ", hence the expectation value is ",
 Cell[BoxData[
  RowBox[{"\[Integral]", " ", 
   RowBox[{"\[Integral]", 
    RowBox[{
     SuperscriptBox["x", "4"], 
     SubscriptBox["W", "2"], 
     RowBox[{"(", 
      RowBox[{"x", ",", "p"}], ")"}], " ", 
     RowBox[{"\[DifferentialD]", "x"}], " ", 
     RowBox[{"\[DifferentialD]", "p"}]}]}]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "59b30c25-75ef-a94c-9c66-5f77796b16b3"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9394001458762684`*^9, 3.9394001539702168`*^9}, {
  3.939400239582983*^9, 3.939400247447489*^9}, {3.9780059470762215`*^9, 
  3.9780059482907143`*^9}, {3.9876179255620365`*^9, 3.987618056936081*^9}},
 CellID->582810044,ExpressionUUID->"b07da94d-d562-3c4a-a1e8-2364f9924346"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NIntegrate", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["x", "4"], 
    RowBox[{"wig", "[", 
     RowBox[{"x", ",", "p"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"p", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
   RowBox[{"Method", "->", "\"\<MultiPeriodic\>\""}]}], "]"}]], "Input",
