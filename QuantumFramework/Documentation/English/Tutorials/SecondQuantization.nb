Cell[CellGroupData[{

Cell["Jaynes-Cummings with dissipation", "Subsection",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.939727987589573*^9, 3.939727994750868*^9}},
 CellID->93921446,ExpressionUUID->"090fbcc2-8e0e-cd43-b1ae-4ec95fce4781"],

Cell[TextData[Cell[BoxData[{
 RowBox[{
  OverscriptBox["H", "^"], "=", " ", 
  RowBox[{
   RowBox[{"\[HBar]\[Nu]", 
    SuperscriptBox[
     OverscriptBox["a", "^"], "\[Dagger]"], 
    OverscriptBox["a", "^"]}], "+", 
   RowBox[{
    FractionBox["1", "2"], 
    SubscriptBox["\[HBar]\[Omega]\[Sigma]", "z"]}], "+", 
   RowBox[{"\[HBar]g", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Sigma]", "+"], 
       OverscriptBox["a", "^"]}], "+", 
      RowBox[{
       SubscriptBox["\[Sigma]", "-"], 
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"]}]}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  FractionBox[
   RowBox[{"\[DifferentialD]", "\[Rho]"}], 
   RowBox[{"\[DifferentialD]", "t"}]], "=", " ", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{
     FractionBox["\[ImaginaryI]", "\[HBar]"], "[", 
     RowBox[{
      OverscriptBox["H", "^"], ",", " ", "\[Rho]"}], "]"}]}], "+", 
   RowBox[{
    SubscriptBox["\[ScriptCapitalD]", "decay"], 
    RowBox[{"(", "\[Rho]", ")"}]}], "+", 
   RowBox[{
    SubscriptBox["\[ScriptCapitalD]", "loss"], 
    RowBox[{
    "(", "\[Rho]", 
     ")"}]}]}]}]}], \
"DisplayMath",ExpressionUUID->"8980b9dd-8e76-744f-823d-a5e1c3a51f23"]], "Text",
 CellChangeTimes->{{3.9397312340962296`*^9, 3.9397314207524796`*^9}, {
  3.987675575309025*^9, 3.987675583719475*^9}},
 TextAlignment->Center,
 CellID->302752619,ExpressionUUID->"e6e6a799-7def-3f4b-85ba-b65a2f0a334d"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptCapitalD]", "decay"], ",", 
   SubscriptBox["\[ScriptCapitalD]", "loss"]}]], "InlineFormula",
  ExpressionUUID->"a4ff537b-53ca-364f-8fb2-fe2a503575cf"],
 " are the master equation dissipator terms related to Lindblad jump \
operators ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["L", "1"], "=", 
   RowBox[{
    SqrtBox[
     SubscriptBox["\[Gamma]", "1"]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Sigma]", "-"], "\[CircleTimes]", " ", 
      "\[ScriptCapitalI]"}], ")"}]}]}]], "InlineFormula",ExpressionUUID->
  "a6f13aac-4252-aa45-bae1-747050f5af1d"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["L", "2"], "=", 
   RowBox[{
    SqrtBox[
     SubscriptBox["\[Gamma]", "2"]], 
    RowBox[{"(", 
     RowBox[{"\[ScriptCapitalI]", " ", "\[CircleTimes]", " ", 
      OverscriptBox["a", "^"]}], ")"}]}]}]], "InlineFormula",ExpressionUUID->
  "edeaa240-c699-7046-a930-d32f89b28aa4"],
 ", consider the initial state |e\[RightAngleBracket]|n\[RightAngleBracket] \
with ",
 Cell[BoxData[
  RowBox[{"n", "=", "2"}]], "InlineFormula",ExpressionUUID->
  "e36aa500-1218-fe46-9c43-cc3dc5c6e7ee"],
 "."
}], "Text",
 CellChangeTimes->{{3.9397314505783634`*^9, 3.9397316029433384`*^9}, {
  3.939731642678316*^9, 3.939731659238167*^9}, {3.939731727157261*^9, 
  3.939731754215887*^9}, {3.939731830672798*^9, 3.939731862372658*^9}, {
  3.9876755906459007`*^9, 3.9876755953192577`*^9}, {3.987675688273674*^9, 
  3.9876756900615673`*^9}},
 CellID->660228877,ExpressionUUID->"abbbe722-aca4-2f40-97a4-0a971d2c5ed7"],

Cell[CellGroupData[{

Cell["Definition of the basis and the necessary operators:", "Text",
 CellChangeTimes->{{3.987675838884962*^9, 3.9876758567843094`*^9}},
 CellID->259157347,ExpressionUUID->"9d4172fe-f70a-f846-805b-42032dcca159"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"atomBasis", " ", "=", " ", 
   RowBox[{"QuantumBasis", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<e\>\"", ",", "\"\<g\>\""}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]plus", " ", "=", "  ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<+\>\"", ",", "atomBasis"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]minus", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<-\>\"", ",", "atomBasis"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", " ", ":=", " ", 
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"{", "2", "}"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.935507675735445*^9, 3.935507693292776*^9}, {
   3.9355077544952316`*^9, 3.935507763653515*^9}, {3.935509227340187*^9, 
   3.9355092288229694`*^9}, {3.9355093266277733`*^9, 3.935509327445307*^9}, {
   3.936098875328287*^9, 3.936098875902157*^9}, {3.93610038385375*^9, 
   3.9361004076151543`*^9}, 3.936101245579539*^9, {3.9369728423656025`*^9, 
   3.936972842564335*^9}, {3.936973003942936*^9, 3.936973004509838*^9}, {
   3.9369775118561954`*^9, 3.936977513300394*^9}, {3.937065871323984*^9, 
   3.9370658738213463`*^9}, {3.9668876404252567`*^9, 
   3.9668876474894695`*^9}, {3.9668877087409496`*^9, 3.9668877227831364`*^9}, 
   3.987619244832184*^9, {3.987675816923973*^9, 3.9876758178840218`*^9}},
 CellLabel->"In[69]:=",
 CellID->33060201,ExpressionUUID->"bd45cec3-b016-2e48-a5ba-0d3728a658d3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Parameter setting:", "Text",
 CellChangeTimes->{{3.9780301001686554`*^9, 3.9780301042286663`*^9}},
 CellID->178781131,ExpressionUUID->"f3b30600-91c8-6340-81d3-9f9275c552eb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "8", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Nu]", " ", "=", " ", "10."}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"field", " ", "frequency"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]", " ", "=", " ", "10."}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"atomic", " ", "frequency"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gc", " ", "=", " ", "15."}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"interaction", " ", "coupling", " ", "strength"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tf", "=", "1"}], ";"}], "        ", 
  RowBox[{"(*", " ", 
   RowBox[{"Final", " ", "time"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]0", " ", "=", " ", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<0\>\"", ",", "atomBasis"}], "]"}], ",", 
     RowBox[{"FockState", "[", "2", "]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.936137924774555*^9, 3.936138006364668*^9}, {
   3.93618342611852*^9, 3.936183426506338*^9}, {3.936183843732508*^9, 
   3.936183872408489*^9}, {3.936186409387272*^9, 3.9361864153614674`*^9}, {
   3.936273142640812*^9, 3.936273145008524*^9}, {3.936273329727913*^9, 
   3.936273332380949*^9}, 3.9362734933618536`*^9, {3.936273785338318*^9, 
   3.936273788658304*^9}, {3.9362745930924883`*^9, 3.936274623879608*^9}, 
   3.936276714326666*^9, {3.936719471363962*^9, 3.93671953521561*^9}, {
   3.937430547225905*^9, 3.937430547876737*^9}, {3.939731807043066*^9, 
   3.939731808158186*^9}, {3.939731914675392*^9, 3.9397319248201866`*^9}, {
   3.939736723060295*^9, 3.939736758968239*^9}, {3.9668881147735863`*^9, 
   3.9668881214338703`*^9}, {3.9780301191483307`*^9, 3.978030122765415*^9}, {
   3.987675709671713*^9, 3.98767571701392*^9}, {3.9876758776464825`*^9, 
   3.9876759086352253`*^9}},
 CellLabel->"In[79]:=",
 CellID->20383292,ExpressionUUID->"4398d07e-954e-0a44-bba3-49b4e7e3abc9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Hamiltonian definition:", "Text",
 CellChangeTimes->{{3.939737430965744*^9, 3.9397374356952877`*^9}},
 CellID->261621505,ExpressionUUID->"961168ea-77ff-b84d-8fe2-a0f0a929573e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H", " ", "=", "  ", 
   RowBox[{
    RowBox[{"\[Nu]", " ", 
     RowBox[{
      SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], "+", " ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", "\[Omega]", " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Z\>\"", ",", "atomBasis"}], "]"}]}], "+", 
    RowBox[{"gc", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Sigma]plus", "@", "a"}], "+", 
       RowBox[{"\[Sigma]minus", "@", 
        SuperscriptBox["a", "\[Dagger]"]}]}], ")"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.939736775248953*^9, 3.939736781302271*^9}, {
  3.9668881501103306`*^9, 3.9668881880991364`*^9}},
 CellLabel->"In[85]:=",
 CellID->2955276,ExpressionUUID->"16077b32-a64d-034e-9ebe-30eb23604ee3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Jump operators:", "Text",
 CellChangeTimes->{{3.939737445512848*^9, 3.939737448272585*^9}},
 CellID->106389070,ExpressionUUID->"66278bdf-2db4-774c-aea3-5e88697bd289"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"decayAtom", " ", "=", " ", 
   RowBox[{"\[Sigma]minus", "@", 
    RowBox[{"QuantumOperator", "[", 
     RowBox[{
      RowBox[{"\"\<I\>\"", "[", "$FockSize", "]"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lossField", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"\"\<I\>\"", ",", "atomBasis"}], "]"}], "@", "a"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9397368503673954`*^9, 3.93973685218326*^9}, 
   3.9668884341579*^9, 3.966888538090782*^9},
 CellLabel->"In[86]:=",
 CellID->54074933,ExpressionUUID->"258c7161-bc50-ad4a-9525-41bc9d174b90"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Helper definition to get the probability of finding the atom in the excited \
state in a time window:\
\>", "Text",
 CellChangeTimes->{{3.9668886487763863`*^9, 3.9668886632159805`*^9}, {
  3.978029882630108*^9, 3.9780298951242027`*^9}},
 CellID->115898076,ExpressionUUID->"49734be2-e149-2047-808b-b96378be8465"],

Cell[BoxData[
 RowBox[{
  RowBox[{"atomProb", "[", 
   RowBox[{"evolved_", ",", "tspecs_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"QuantumState", "[", 
           RowBox[{"\"\<0\>\"", ",", "atomBasis"}], "]"}], "\[Dagger]"], "@", 
         RowBox[{"evolved", "[", "t", "]"}]}], ")"}], "[", "\"\<Norm\>\"", 
       "]"}]}], "}"}], ",", " ", 
    RowBox[{"Evaluate", "[", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", 
       RowBox[{"Sequence", "@@", "tspecs"}]}], "}"}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{3.9876759915273895`*^9},
 CellLabel->"In[88]:=",
 CellID->234842619,ExpressionUUID->"789cfdf0-de72-fd41-b676-3063ab49b5ab"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Compute the evolution for different damping parameters ",
 Cell[BoxData[
  RowBox[{"\[Gamma]", "=", 
   RowBox[{
    SubscriptBox["\[Gamma]", "1"], "=", 
    SubscriptBox["\[Gamma]", "2"]}]}]], "InlineFormula",ExpressionUUID->
  "7fb85e92-886e-be40-87c8-806927c3fddf"],
 ", and record the probability of finding the atom in the excited state:"
}], "Text",
 CellChangeTimes->{{3.939737406517824*^9, 3.93973741257666*^9}, {
  3.939737456624159*^9, 3.9397375413894653`*^9}},
 CellID->158286289,ExpressionUUID->"a7b0c67e-b5ec-de44-9ef6-d52254407d0f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"probsE", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[ScriptCapitalH]", " ", "=", " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<Hamiltonian\>\"", "[", 
         RowBox[{"H", ",", " ", 
          RowBox[{"{", 
           RowBox[{"decayAtom", ",", " ", "lossField"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "x"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
      "   ", 
      RowBox[{"evolved", " ", "=", " ", 
       RowBox[{"QuantumEvolve", "[", 
        RowBox[{"\[ScriptCapitalH]", ",", " ", "\[Psi]0", ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], ";", 
      "\n", "   ", 
      RowBox[{"atomProb", "[", 
       RowBox[{"evolved", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0.01"}], "}"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.8", ",", " ", "0.4", ",", " ", "0.2"}], "}"}]}], "}"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9397371513070602`*^9, 3.9397371534454136`*^9}, {
   3.9668887942689495`*^9, 3.966888830253027*^9}, {3.9780301449638023`*^9, 
   3.9780301519390335`*^9}, 3.9780302341762657`*^9, {3.9876760526583633`*^9, 
   3.9876760651282997`*^9}, {3.987676122030548*^9, 3.9876761226414623`*^9}},
 CellLabel->"In[91]:=",
 CellID->22774527,ExpressionUUID->"a0a7347e-3801-7d4a-8791-c94b9b4c0468"]
}, Open  ]],

