   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", " ", "\"\<\>\""}], "}"}]}], ",", " ", "\n", 
   " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(EE\)]\)\>\"", ",", " ", 
      "\n", "   ", "\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(EG\)]\)\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", "0.5"}], ",", " ", "\n", " ", 
