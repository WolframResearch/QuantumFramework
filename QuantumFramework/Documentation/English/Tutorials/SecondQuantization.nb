}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Equivalent bracket notation ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", " ", 
    RowBox[{"\[Psi]", " ", "|", 
     RowBox[{
      SuperscriptBox["a", "\[Dagger]"], "a"}], "|", "\[Psi]"}], 
    "\[RightAngleBracket]"}], " "}]], "InlineFormula",ExpressionUUID->
  "2f88a767-6899-2446-ac65-f3b86ab8a69d"],
 ":"
}], "Text",
 CellChangeTimes->{{3.939294084661381*^9, 3.939294146279785*^9}},
 CellID->330339647,ExpressionUUID->"c52b2550-fcb0-7948-83b5-fa8eb6fd9124"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{
   RowBox[{"(", " ", 
    RowBox[{
     SuperscriptBox["\[Psi]", "\[Dagger]"], "@", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["a", "\[Dagger]"], "@", "a"}], ")"}], "@", 
      "\[Psi]"}]}], " ", ")"}], "[", "\"\<Scalar\>\"", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.939375983257292*^9, 3.9393760619730587`*^9}, {
  3.939376185074789*^9, 3.9393763096436768`*^9}, {3.9393765906988564`*^9, 
