 "(0) = |0\[RightAngleBracket] \[LeftAngleBracket]0|, the system evolves to \
the coherent state \[VerticalSeparator] -\[ImaginaryI] ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "b48d8fd7-27e2-564a-a355-10f5a76fd2bc"],
 " t \[RightAngleBracket]\[LeftAngleBracket]- \[ImaginaryI] ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "15803a88-3b6f-164f-8c2b-dbc2f48b6969"],
 " t | for short times; the complex amplitude is independent of \[Gamma]."
}], "Text",
 CellChangeTimes->{3.939727135894436*^9, 3.9780149973928814`*^9},
 CellID->257755094,ExpressionUUID->"1867318f-497d-5341-8bf9-42ed40aad1c8"],

Cell[CellGroupData[{

Cell["Initial state:", "Text",
 CellChangeTimes->{{3.978015002836941*^9, 3.9780150066053734`*^9}},
 CellID->319308428,ExpressionUUID->"6a64bacc-2ef1-9c4f-a628-1bdfb144e5ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<0\>\"", ",", "$FockSize"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9397271538001328`*^9, 3.939727155725094*^9}},
 CellLabel->"In[115]:=",
 CellID->22791540,ExpressionUUID->"7039a13f-7c8e-484c-a997-a0b6a865cdbd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Evolved state:", "Text",
 CellChangeTimes->{{3.97801563772237*^9, 3.9780156399491005`*^9}},
 CellID->13033599,ExpressionUUID->"51fee157-ffb9-3346-a483-55bc3bb9f20f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]t", " ", "=", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{"\[ScriptCapitalH]", ",", "\[Rho]0", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.978015606742342*^9, 3.978015635550579*^9}},
 CellLabel->"In[116]:=",
 CellID->287487264,ExpressionUUID->"db5ed19f-1c56-644c-9316-65d565ce6397"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Photon number expectations and fidelity:", "Text",
 CellChangeTimes->{{3.978015031478567*^9, 3.978015052651924*^9}},
 CellID->565392980,ExpressionUUID->"8783f040-30c1-ec42-8da2-30a7b4669be1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"time", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "0.8", ",", "0.02"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"qs", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumSimilarity", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CoherentState", "[", "]"}], "[", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "g", " ", "#"}], "]"}], ",", 
       RowBox[{"\[Rho]t", "[", "#", "]"}]}], "]"}], "&"}], " ", "/@", " ", 
    "time"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"meanN", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{"$FockSize", "-", "1"}]}], "]"}], ".", 
       RowBox[{"Diagonal", "[", 
        RowBox[{
         RowBox[{"\[Rho]t", "[", "#", "]"}], "[", "\"\<DensityMatrix\>\"", 
         "]"}], "]"}]}], "]"}], "&"}], " ", "/@", " ", "time"}]}], " ", 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9397271721658382`*^9, 3.9397271744638195`*^9}, 
   3.979331744213592*^9, {3.9876192033289948`*^9, 3.987619206034876*^9}},
 CellLabel->"In[117]:=",
 CellID->136004513,ExpressionUUID->"dd189df9-b198-3041-ad1a-cbea6e9cdc74"]
}, Open  ]],

