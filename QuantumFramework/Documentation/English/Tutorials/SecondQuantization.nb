Cell[TextData[{
 "Compute the commutator of the quadrature operators. It should be ",
 Cell[BoxData[
  RowBox[{
   FractionBox["\[ImaginaryI]", "2"], 
   StyleBox["1",
    FontSlant->"Italic"]}]], "InlineFormula",ExpressionUUID->
  "0b84f442-49f0-be4f-b79a-b317fa5e64b9"],
 "; any small deviation in the last term is expected due to truncation:"
}], "Text",
 CellChangeTimes->{{3.934453424700657*^9, 3.934453425651228*^9}, {
  3.93445354201499*^9, 3.9344535548663635`*^9}, {3.934453937481714*^9, 
