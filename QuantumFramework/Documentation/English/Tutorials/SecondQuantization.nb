     SpanMaxSize->1], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a0f2024-2f71-09ca-6a34-b98e4a045b10"],
 " :"
}], "Text",
 CellID->959507005,ExpressionUUID->"277956ac-4c9d-d338-4d07-4ff66529be02"],

