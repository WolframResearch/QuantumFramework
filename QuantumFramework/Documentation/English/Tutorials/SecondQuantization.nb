Cell[CellGroupData[{

Cell["Compute the Wigner function for the Fock state \
|2\[RightAngleBracket]:", "Text",
 CellChangeTimes->{{3.951575017609297*^9, 3.951575029465637*^9}, {
  3.9780055358235207`*^9, 3.9780055395616817`*^9}},
 CellID->441580659,ExpressionUUID->"91eef221-0e36-324c-8880-19bcaf1e7d4c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wig", " ", "=", " ", 
   RowBox[{"WignerRepresentation", "[", 
    RowBox[{
     RowBox[{"FockState", "[", "2", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.939399732433668*^9, 3.9393997866944237`*^9}, {
