Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Alpha]", " ", "=", " ", 
   RowBox[{"4", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"2", " ", "\[Pi]"}]}], "}"}], "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]0", "=", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<1\>\"", ",", "atomBasis"}], "]"}], ",", 
     RowBox[{
      RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]t", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"U", " ", "@", " ", "\[Psi]0"}], ",", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"g", ",", "t"}], "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9397296480523167`*^9, 3.9397296877447987`*^9}, {
  3.966887907342209*^9, 3.966887913241377*^9}, {3.987675413117647*^9, 
  3.9876754280966415`*^9}},
 CellLabel->"In[54]:=",
 CellID->651780770,ExpressionUUID->"a912940f-318b-a74e-82e4-fe88e81399ce"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Extracting the coefficients  ",
 Cell[BoxData[
  SubscriptBox["c", "e"]], "InlineFormula",ExpressionUUID->
  "22e64149-a765-2747-85d6-9d66092ea78d"],
 " and ",
 Cell[BoxData[
  SubscriptBox["c", "g"]], "InlineFormula",ExpressionUUID->
  "b5e4a24b-64d1-ca40-8b70-de6df6a220c3"],
 " for all n as a function of time:"
}], "Text",
 CellChangeTimes->{{3.9668899337989635`*^9, 3.9668899705760612`*^9}},
 CellID->96769339,ExpressionUUID->"bf132384-e457-054b-b070-6cfb9b66050c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cet", "[", "t_", "]"}], ",", " ", 
     RowBox[{"cgt", "[", "t_", "]"}]}], "}"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"#", "[", "\"\<Dagger\>\"", "]"}], "@", 
        RowBox[{"\[Psi]t", "[", 
         RowBox[{"1", ",", " ", "t"}], "]"}]}], ")"}], 
      "[", "\"\<AmplitudesList\>\"", "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"atomBasis", "[", "\"\<BasisStates\>\"", "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9397297053783417`*^9, 3.939729706789505*^9}, {
  3.9876754621183987`*^9, 3.987675468316948*^9}},
 CellLabel->"In[57]:=",
 CellID->17553131,ExpressionUUID->"28d497c2-5433-9a41-8bd8-4c1270f7e7d1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Plotting the population inversion  ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"W", 
    RowBox[{"(", "t", ")"}]}], "=", 
   RowBox[{
    SubscriptBox["\[Sum]", 
     RowBox[{" ", "n", " "}]], 
    RowBox[{"|", 
     RowBox[{
      SubscriptBox["c", 
       RowBox[{"e", ",", "n"}]], 
      RowBox[{"(", "t", ")"}]}], 
     SuperscriptBox["|", "2"], 
     RowBox[{"-", 
      RowBox[{"|", 
       RowBox[{
        SubscriptBox["c", 
         RowBox[{"g", ",", "n"}]], 
        RowBox[{"(", "t", ")"}]}], 
       SuperscriptBox["|", "2"]}]}]}]}]}]], "InlineFormula",ExpressionUUID->
  "7594d053-c5e7-9a4d-8130-988f638bfaaa"]
}], "Text",
 CellChangeTimes->{{3.939729848426779*^9, 3.9397298537477264`*^9}, {
  3.9397301752780094`*^9, 3.9397301824271564`*^9}, {3.9397302623854504`*^9, 
  3.939730351168524*^9}, {3.939730512210556*^9, 3.939730515139389*^9}},
 CellID->3240485,ExpressionUUID->"ced22e63-2c90-e845-861c-4f3b40df90df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Total", " ", "@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"cet", "[", "t", "]"}], "]"}], "^", "2"}], "-", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"cgt", "[", "t", "]"}], "]"}], "^", "2"}]}], ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "40"}], "}"}], ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["8", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["808", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    PlotRange -> All, Frame -> True, FrameLabel -> {"gt", "W(t)"}, PlotTheme -> 
     "Detailed", PlotLegends -> None, ImageSize -> 400, LabelStyle -> 10, 
     PlotLabel -> "Population inversion W(t) for the atom"],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellChangeTimes->{{3.9397292320982685`*^9, 3.939729233139406*^9}, {
  3.9397297255236473`*^9, 3.939729810742607*^9}, {3.9397302358809624`*^9, 
