     RowBox[{"[", 
      RowBox[{"1", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], "]"}], "]"}], ",", " ", 
   
   RowBox[{"{", 
