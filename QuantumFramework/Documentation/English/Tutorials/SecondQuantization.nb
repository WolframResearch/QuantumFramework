Cell[CellGroupData[{

Cell["\<\
Atom \"thermalization\" (atom interacting with a thermal state field)\
\>", "Subsubsection",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9397305531560955`*^9, 3.9397305536901093`*^9}, {
   3.9397305861068726`*^9, 3.93973062962381*^9}, 3.9397307799125137`*^9, 
   3.978029620586773*^9},
 CellID->62277995,ExpressionUUID->"65d481fb-df56-e84d-b3a8-dc59a00c0ebd"],

Cell[CellGroupData[{

Cell[TextData[{
 "Atom initially in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox["1", 
         SqrtBox["2"]], 
        RowBox[{"(", 
         RowBox[{"|", "g"}]}]}], "\[RightAngleBracket]"}], "+"}], "|", "e"}], 
    "\[RightAngleBracket]"}], ")"}]], "InlineFormula",ExpressionUUID->
  "881450dd-e4df-634e-8499-fab79d56e1c2"],
 " and field in a thermal state with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["n", "_"], "=", "5"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ff71fd38-9e40-e14d-9140-4ebce38b498f"],
 ":"
}], "Text",
 CellChangeTimes->{{3.939730655530796*^9, 3.939730775465435*^9}, 
   3.939730818537359*^9},
 CellID->88962120,ExpressionUUID->"047ac57d-56b5-9544-b10e-103e47ab2092"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<+\>\"", ",", "atomBasis"}], "]"}], ",", 
     RowBox[{"ThermalState", "[", "5.", "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.939730645356533*^9, 3.939730650800108*^9}, {
  3.9397308375056744`*^9, 3.9397308392570305`*^9}, {3.96688797018075*^9, 
  3.9668879918811398`*^9}, {3.9876755150811234`*^9, 3.9876755228680534`*^9}},
 CellLabel->"In[59]:=",
 CellID->477652890,ExpressionUUID->"d554425c-41a1-de40-ac6a-71cba512e947"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Evolve the density matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", "t", ")"}], " ", "=", 
    RowBox[{
     RowBox[{
      OverscriptBox["U", "^"], "(", "t", ")"}], " ", 
     RowBox[{"\[Rho]", "(", "0", ")"}], " ", 
     RowBox[{
      SuperscriptBox[
       OverscriptBox["U", "^"], "\[Dagger]"], "(", "t", ")"}], " "}]}], 
   TraditionalForm]],ExpressionUUID->"881c5dd7-e845-3c49-b25a-49495a6947dc"],
 ". We use shortcut notation applied to matrix states:"
}], "Text",
 CellChangeTimes->{
  3.9397308161733017`*^9, {3.966889003787712*^9, 3.966889020523121*^9}, {
   3.978029653873541*^9, 3.978029663379196*^9}, {3.978029720396654*^9, 
   3.978029729666355*^9}},
 CellID->239443333,ExpressionUUID->"f0094a20-0780-5340-b4d5-6914a112111c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]t", "  ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["U", "\[Dagger]"], "[", "\[Rho]0", "]"}], ",", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"g", ",", "t"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.9397308307028217`*^9},
 CellLabel->"In[60]:=",
 CellID->77709687,ExpressionUUID->"2b6244e7-00eb-cc4c-a427-d44d85e33adc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Reduced density matrix of the atom:", "Text",
 CellChangeTimes->{{3.966888029179081*^9, 3.966888041617962*^9}},
 CellID->272791191,ExpressionUUID->"027081e9-7355-194c-8a05-ccdb51bff874"],

Cell[BoxData[
 RowBox[{
  RowBox[{"atomMatrix", " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{
       RowBox[{"QuantumPartialTrace", "[", 
        RowBox[{
         RowBox[{"\[Rho]t", "[", 
          RowBox[{"1", ",", "t"}], "]"}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<DensityMatrix\>\"", 
       "]"}], "]"}], "//", "ComplexExpand"}], "//", "Simplify"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.93973087009272*^9, 3.939730905802576*^9}},
 CellLabel->"In[61]:=",
 CellID->15441814,ExpressionUUID->"45f5d040-4edc-2e4b-b7c2-33c535cdaa23"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Plot two components of the matrix:", "Text",
