Cell[CellGroupData[{

Cell[TextData[StyleBox["Heisenberg evolution of annihilation operator ", \
"Subsection"]], "Subsection",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{
  3.9392956101610985`*^9, {3.9392956980889606`*^9, 3.939295716880167*^9}},
 CellID->65766379,ExpressionUUID->"b029af74-67ee-b74a-961d-d97832e59293"],

Cell[TextData[{
 "In the Heisenberg picture, the annihilation operator evolves as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox["a", "^"], 
    RowBox[{"(", "t", ")"}]}], "=", 
   RowBox[{
    OverscriptBox["a", "^"], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", "t"}]]}]}]], 
  "InlineFormula",ExpressionUUID->"7ededdf0-07df-b445-be6f-e4afded7a6ae"],
 ". We can reproduce this using super-operators in the framework."
}], "Text",
 CellChangeTimes->{{3.9392960600196705`*^9, 3.9392962088380375`*^9}, 
   3.966889723767681*^9, 3.9780036070937977`*^9},
 CellID->43986669,ExpressionUUID->"4adef8d2-5a57-4b46-9855-2ee21f932d57"],

Cell[CellGroupData[{

Cell["Define the Hamiltonian:", "Text",
 CellChangeTimes->{{3.9668897130178013`*^9, 3.9668897199230785`*^9}},
 CellID->276433583,ExpressionUUID->"c2e86693-b0b9-a148-a840-47c7fbf369aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H", " ", "=", " ", 
   RowBox[{"\[HBar]", " ", "\[Omega]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["a", "\[Dagger]"], "@", "a"}], "+", 
      RowBox[{"1", "/", "2"}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9392946245128*^9, 3.939294646808161*^9}, {
   3.9392946950583763`*^9, 3.939294696479643*^9}, 3.939295743212919*^9},
 CellLabel->"In[58]:=",
 CellID->503934690,ExpressionUUID->"e2ce6003-3c72-3840-b934-53c7975521a1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Construct the evolution super-operator:", "Text",
 CellChangeTimes->{{3.9668897365217705`*^9, 3.966889752285776*^9}, {
  3.978003591272148*^9, 3.978003604973881*^9}},
 CellID->701539000,ExpressionUUID->"3ec4edd6-e2fc-0d4f-a960-8ba38a0d414e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"exp\[ScriptCapitalH]", " ", "=", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Hamiltonian\>\"", "[", 
       RowBox[{"H", "/", "\[HBar]"}], "]"}], "]"}], "t"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{
  3.9392957623680058`*^9, 3.9392958036879272`*^9, 3.9392962164894886`*^9, {
   3.9668911863642673`*^9, 3.966891187308653*^9}, 3.9668920171643047`*^9, {
   3.966892182917101*^9, 3.9668921837698*^9}, {3.9668922232490044`*^9, 
   3.966892283087267*^9}, 3.9668923487615223`*^9, {3.966892462265587*^9, 
   3.966892519527239*^9}},
 CellLabel->"In[59]:=",
 CellID->462049813,ExpressionUUID->"b685e1e8-24fb-4449-8f19-c3093019ea94"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Evolve the operator:", "Text",
 CellChangeTimes->{{3.966889762534767*^9, 3.966889765538601*^9}},
 CellID->326729144,ExpressionUUID->"99c3e914-6efa-794c-90e2-5a13977b59cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"heisenbergAnnihilation", " ", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"exp\[ScriptCapitalH]", "[", "\"\<Dagger\>\"", "]"}], "[", 
       RowBox[{"a", "[", "\"\<MatrixQuantumState\>\"", "]"}], "]"}], 
      "[", "\"\<Operator\>\"", "]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", ",", "\[Omega]"}], "}"}], "\[Element]", " ", "Reals"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.9392958185114956`*^9, {3.939295851863552*^9, 3.939295872284975*^9}, {
   3.9392959405095024`*^9, 3.939295964818224*^9}, 3.9780035561742744`*^9},
 CellLabel->"In[60]:=",
 CellID->151467214,ExpressionUUID->"4716cd23-040b-7344-9de2-dfd8127034b5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compare the result to the known result of quantum mechanics:", "Text",
 CellChangeTimes->{{3.966889770016735*^9, 3.96688977417054*^9}, {
  3.978005023840269*^9, 3.978005034075329*^9}, {3.978005072760771*^9, 
  3.97800508817461*^9}, {3.9780051484669075`*^9, 3.9780051514052925`*^9}},
 CellID->278813483,ExpressionUUID->"af4c3b18-bf3a-d046-8af0-a9d769c9a0f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"a", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", "t"}]]}], "==", 
  "heisenbergAnnihilation"}]], "Input",
 CellChangeTimes->{{3.939295986652506*^9, 3.939296031556038*^9}, {
  3.966892071118847*^9, 3.966892143202425*^9}, {3.966892547841873*^9, 
  3.9668925592417793`*^9}},
 CellLabel->"In[61]:=",
 CellID->27161599,ExpressionUUID->"e73ea176-1525-b14d-be1e-991f6e3ec287"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.939296009975439*^9, 3.9392960322643147`*^9}, {
   3.9668920539660034`*^9, 3.9668921436480618`*^9}, {3.9668925561073513`*^9, 
   3.966892559650177*^9}, 3.9780035593442383`*^9, 3.979331356045268*^9, 
   3.9793842100722523`*^9, 3.9876171703885593`*^9},
 CellLabel->"Out[61]=",
 CellID->517460265,ExpressionUUID->"c7326a36-b74f-0141-8960-59f173bd14cb"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Quasi-probability Representations ", "Section",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.934294598195235*^9, 3.934294625177122*^9}, {
  3.9780060025800056`*^9, 3.978006008855419*^9}},
 CellTags->"quasi",
 CellID->239316975,ExpressionUUID->"54be095d-7e0e-944b-a6e8-3187cabf5061"],

Cell[TextData[{
 "Two phase-space quasi-probability representations are included: Wigner and \
HusimiQ. They are used extensively in quantum mechanics and quantum optics. \
Each is computed numerically on a grid of phase-space points and returns an \
interpolating function. ",
 StyleBox["Glauber",
  IgnoreSpellCheck->True],
 " representation is not included because, for a general state, a stable \
numerical algorithm is not feasible due to highly singular behavior."
}], "Text",
 CellChangeTimes->{{3.9343709371539707`*^9, 3.934370949092924*^9}, {
   3.9343710762299805`*^9, 3.93437111720105*^9}, {3.934371156709332*^9, 
   3.934371257950283*^9}, {3.934371327460842*^9, 3.934371333135708*^9}, {
   3.93437137323472*^9, 3.934371473219927*^9}, {3.934371819286619*^9, 
   3.934371819598745*^9}, 3.934371860758461*^9, {3.951568036417515*^9, 
   3.95156805945442*^9}, {3.9515743189170494`*^9, 3.9515743194549217`*^9}, {
   3.987617200859747*^9, 3.9876172081060143`*^9}},
 CellID->59512050,ExpressionUUID->"ec9a9012-34c5-4f47-9db9-8ac1d5270736"],

Cell[BoxData[GridBox[{
   {
    RowBox[{
     ButtonBox["WignerRepresentation",
      BaseStyle->"Link",
      ButtonData->"paclet:Wolfram/QuantumFramework/ref/WignerRepresentation"],
      "[", 
     RowBox[{
      StyleBox["\[Psi]", "TR"], 
      StyleBox[",", "TR"], 
      RowBox[{
       StyleBox["{", "TR"], 
       RowBox[{
        StyleBox["xmin", "TI"], 
        StyleBox[",", "TR"], 
        StyleBox["xmax", "TI"]}], 
       StyleBox["}", "TR"]}], 
      StyleBox[",", "TR"], 
      RowBox[{
       StyleBox["{", "TR"], 
       RowBox[{
        StyleBox["pmin", "TI"], 
        StyleBox[",", "TR"], 
        StyleBox["pmax", "TI"]}], 
       StyleBox["}", "TR"]}], 
      StyleBox[",", "TI"], 
      StyleBox["opts", "TI"]}], "]"}], Cell[TextData[{
     "Computes the Wigner quasi-probabilty representation of a quantum state",
     StyleBox[" ",
      FontSlant->"Italic"],
     "\[Psi] , in a phase space rectangular region defined by the given \
limits of  ",
     StyleBox["x",
      FontSlant->"Italic"],
     " and ",
     StyleBox["p",
      FontSlant->"Italic"]
