Cell[CellGroupData[{

Cell["\<\
Rabi oscillations when the field is initially in a Fock state\
\>", "Text",
 CellChangeTimes->{{3.9397292385052433`*^9, 3.9397292539999275`*^9}, {
   3.939729424644417*^9, 3.9397294256684*^9}, 3.9397307872327995`*^9, 
