Cell[CellGroupData[{

Cell["BeamSplitter operator: Method option", "Subsubsection",
 CellChangeTimes->{{3.978000683866022*^9, 3.97800070899959*^9}},
 CellID->210439676,ExpressionUUID->"28fe5d70-6ea4-4716-8f28-f76433b93a67"],

Cell[TextData[{
 "BeamSplitterOperator supports two computation methods via the Method \
option. The default is ",
 StyleBox["MatrixExp ",
  FontSlant->"Italic"],
 "which uses direct matrix exponentiation; ",
 StyleBox["Recurrence ",
  FontSlant->"Italic"],
 "uses an efficient recurrence relation for the beam splitter matrix \
elements. Performance can vary depending on whether the angle arguments are \
numeric or exact/symbolic."
}], "Text",
 CellChangeTimes->{{3.9780009673114815`*^9, 3.978001018429886*^9}, {
  3.9780013319401016`*^9, 3.978001416413828*^9}, {3.978001472320013*^9, 
  3.978001508605118*^9}, {3.97800159343824*^9, 3.9780016508032665`*^9}, {
  3.978001723704794*^9, 3.9780018271569195`*^9}, {3.9793310885628567`*^9, 
  3.979331088566231*^9}},
 CellID->97317285,ExpressionUUID->"b91dba9e-eb76-4ede-bc70-defdbbfba5ab"],

Cell[CellGroupData[{

Cell["Use the \"Recurrence\" method with exact parameters:", "Text",
 CellChangeTimes->{{3.9780009673114815`*^9, 3.978001018429886*^9}, {
   3.9780013319401016`*^9, 3.978001416413828*^9}, {3.978001472320013*^9, 
   3.978001508605118*^9}, {3.97800159343824*^9, 3.9780016508032665`*^9}, {
   3.978001723704794*^9, 3.9780018271569195`*^9}, 3.979331088985035*^9, {
   3.987615318530567*^9, 3.9876153197822113`*^9}},
 CellID->1964254562,ExpressionUUID->"3e163ee0-c7dd-4a89-ba98-af903e770dd5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BeamSplitterOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "4"}], ",", 
       RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
     RowBox[{"Method", "->", "\"\<Recurrence\>\""}]}], "]"}], "[", 
   RowBox[{"FockState", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}], "]"}], "]"}], "[", "\"\<Formula\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{3.978000409946001*^9, 3.978000458618679*^9}, {
  3.9793310490568113`*^9, 3.979331050490911*^9}, {3.9876152951441746`*^9, 
  3.9876152983103237`*^9}},
 CellLabel->"In[9]:=",
