Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<+\>\"", ",", " ", "atomBasis"}], "]"}], ",", " ", 
     RowBox[{"ThermalState", "[", "5.", "]"}]}], "]"}]}], ";"}]], "Input",
