Cell[CellGroupData[{

Cell["\<\
Using the probabilities of the diagonal of the density matrix:\
\>", "Text",
 CellChangeTimes->{{3.9392942289676647`*^9, 3.93929423658885*^9}, {
  3.939294380512253*^9, 3.939294410388897*^9}, {3.987617042957779*^9, 
  3.9876170451887836`*^9}},
 CellID->322279955,ExpressionUUID->"164ba3b2-580e-3e4f-9f35-b734c1882bb5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "@", 
  RowBox[{"Dot", "[", 
   RowBox[{
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", 
      RowBox[{"$FockSize", "-", "1"}]}], "]"}], ",", 
    RowBox[{"Diagonal", "@", 
     RowBox[{"\[Psi]", "[", "\"\<DensityMatrix\>\"", "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9392942480714855`*^9, 3.939294258533617*^9}, {
  3.9392943124546204`*^9, 3.9392943684057465`*^9}, {3.978003286600401*^9, 
  3.9780032876844635`*^9}},
