}, Open  ]],

Cell[CellGroupData[{

Cell["Driven-Dissipative Kerr Nonlinear Oscillator", "Subsection",
 CellChangeTimes->{{3.9876812856557827`*^9, 3.987681309597353*^9}},
 CellID->220884971,ExpressionUUID->"6493b8d7-dff2-3942-914a-67d86cd0be4b"],

Cell["The Hamiltonian is:", "Text",
 CellChangeTimes->{{3.9876813366556416`*^9, 3.98768135444112*^9}, {
  3.987692763392233*^9, 3.9876927661924496`*^9}},
 CellID->282601268,ExpressionUUID->"069db1cc-4c27-e840-8837-e2fe68aa353b"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  OverscriptBox["H", "^"], "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "\[CapitalDelta]"}], 
    SuperscriptBox[
     OverscriptBox["a", "^"], "\[Dagger]"], 
    OverscriptBox["a", "^"]}], "+", 
   RowBox[{
    FractionBox["K", "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"], "2"], 
      SuperscriptBox[
       OverscriptBox["a", "^"], "2"]}], ")"}]}], "+", 
   RowBox[{"\[CurlyEpsilon]", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       OverscriptBox["a", "^"], "\[Dagger]"], "+", 
      OverscriptBox["a", "^"]}], ")"}]}]}]}]], "DisplayMath",
 FontSize->14,ExpressionUUID->"6e09b779-3048-6941-be9f-52c3a750dffa"]], "Text",
 CellChangeTimes->{{3.9397312340962296`*^9, 3.9397314207524796`*^9}, {
  3.987675575309025*^9, 3.987675583719475*^9}, {3.987681380315876*^9, 
  3.9876814709333878`*^9}, {3.9876817369232655`*^9, 3.987681745061863*^9}},
 TextAlignment->-0.5,
 CellID->104231420,ExpressionUUID->"aec23119-98f8-8049-908c-7ced029fa042"],

Cell[CellGroupData[{

Cell[TextData[{
 "where \[CapitalDelta] is the detuning, K, is the Kerr nonlinearity and \
\[CurlyEpsilon] is the drive strength. Dissipation can be added with the \
photon loss channel with Lindblad operator ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["L", "loss"], "=", 
   RowBox[{
    SqrtBox["\[Kappa]"], 
    OverscriptBox["a", "^"]}]}]], "DisplayMath",ExpressionUUID->
  "d9feff04-f5c6-414f-a546-911464d893a6"]
}], "Text",
 CellChangeTimes->{{3.987681654740513*^9, 3.9876816983002872`*^9}, {
  3.9876818004600296`*^9, 3.9876818326332664`*^9}},
 CellID->678578855,ExpressionUUID->"a058f4fd-c0d2-ea4b-be6c-589945601a3b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", ":=", 
   RowBox[{"AnnihilationOperator", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "25", "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.987681841939493*^9, 3.9876818525284405`*^9}, {
  3.9876820404353848`*^9, 3.9876820434936695`*^9}},
 CellLabel->"In[186]:=",
 CellID->186461369,ExpressionUUID->"48c13cd6-cd24-8841-9d39-2e5350697e7b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Define the Hamiltonian:", "Text",
 CellChangeTimes->{{3.9876911356231747`*^9, 3.98769114313892*^9}},
 CellID->200288666,ExpressionUUID->"167ef93c-3755-214c-93ea-f353394f0570"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "\[CapitalDelta]"}], " ", 
       RowBox[{
        SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], "+", 
      RowBox[{
       RowBox[{"K", "/", "2"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          SuperscriptBox["a", "\[Dagger]"], "2"], "@", 
         SuperscriptBox["a", "2"]}], ")"}]}], "+", 
      RowBox[{"\[CurlyEpsilon]", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["a", "\[Dagger]"], "+", "a"}], ")"}]}]}], ",", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\[CapitalDelta]", ",", "K", ",", "\[CurlyEpsilon]"}], 
       "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.98768186125601*^9, 3.9876819395081863`*^9}},
 CellLabel->"In[188]:=",
 CellID->174149861,ExpressionUUID->"b5adc86b-4ae0-234f-a00b-4f47f24d74db"]
}, Open  ]],

Cell[CellGroupData[{

Cell["We take the vacuum as the initial state:", "Text",
 CellChangeTimes->{{3.9876911483219376`*^9, 3.987691155461817*^9}},
 CellID->425029682,ExpressionUUID->"b39a945a-72d0-4043-899f-d984270d43c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{"FockState", "[", "0", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.987682129649849*^9, 3.987682136780113*^9}, {
  3.9876826316419773`*^9, 3.987682650128372*^9}, {3.987682854554409*^9, 
  3.9876828562106514`*^9}, {3.987691401462946*^9, 3.98769140182127*^9}, {
  3.987691762603348*^9, 3.9876917628430767`*^9}},
 CellLabel->"In[322]:=",
 CellID->230329940,ExpressionUUID->"6d44686d-9a55-c743-80b6-1359c3ca9563"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Set up the Lindbladian with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[CapitalDelta]", "=", "3"}], ",", 
   RowBox[{"K", "=", "1"}], ",", 
   RowBox[{"\[CurlyEpsilon]", "=", "1.5"}], ",", 
   RowBox[{"\[Kappa]", "=", "0.5", " "}]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "ff9496a6-3619-6547-a0b8-b398d5b13bc3"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9876919060746193`*^9, 3.9876919735670204`*^9}, {
  3.9876929474598846`*^9, 3.987692956550049*^9}, {3.9876932640681915`*^9, 
  3.9876932645586777`*^9}, {3.98769449663113*^9, 3.987694496998007*^9}},
 CellID->450409479,ExpressionUUID->"34994bc9-ad12-e448-a87c-d3dad976f0f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalL]", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Liouvillian\>\"", "[", 
     RowBox[{
      RowBox[{"H", "[", 
       RowBox[{"3", ",", "1", ",", "1.5"}], "]"}], ",", 
      RowBox[{"{", "a", "}"}], ",", 
      RowBox[{"{", "0.5", "}"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9876820856200027`*^9, 3.9876820973105087`*^9}, {
  3.987682146101345*^9, 3.9876821693337765`*^9}, {3.9876828508846664`*^9, 
  3.987682862374508*^9}, {3.987683125672058*^9, 3.987683125992052*^9}, {
  3.987691300756279*^9, 3.9876913088527164`*^9}, {3.987691679582241*^9, 
  3.987691701275715*^9}, {3.9876918558738403`*^9, 3.9876918699339867`*^9}, {
  3.9876922521752357`*^9, 3.9876922678103848`*^9}, {3.987692501055887*^9, 
  3.9876925120010834`*^9}, {3.9876926543887043`*^9, 3.9876926673941555`*^9}, {
  3.9876927132874966`*^9, 3.987692724004488*^9}, {3.987692926470257*^9, 
  3.9876929348384953`*^9}, {3.9876930349074726`*^9, 3.987693036077915*^9}, {
  3.987693115305586*^9, 3.987693115597994*^9}, {3.9876931866828384`*^9, 
  3.9876931871689053`*^9}, {3.987694499583067*^9, 3.9876944999361496`*^9}},
 CellLabel->"In[350]:=",
 CellID->78652097,ExpressionUUID->"cbfcaae4-a928-bf44-8879-17b39bcfc089"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Calculate the evolution numerically , with final time ",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{
    SubscriptBox["t", "f"], "=", "15"}]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "e6a3f90f-a02d-2b4e-9dcf-106e00503aba"],
 ":"
}], "Text",
 CellChangeTimes->{{3.987693453867962*^9, 3.9876935292943687`*^9}},
 CellID->11616466,ExpressionUUID->"98a5fe6b-8662-2b4e-9bfb-0c8e14d0852f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evolved", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", "\[ScriptCapitalL]"}], ",", "\[Rho]0", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "15"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9876821984557705`*^9, 3.9876822274251347`*^9}, {
  3.9876888411418552`*^9, 3.9876888415018654`*^9}},
 CellLabel->"In[351]:=",
 CellID->460806412,ExpressionUUID->"7ceb7148-c7e8-d948-860e-71fc38b1dacd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Wigner function snapshots:", "Text",
 CellChangeTimes->{{3.987693538624588*^9, 3.987693541577463*^9}, {
  3.9876935883187866`*^9, 3.9876935927194424`*^9}},
 CellID->12311705,ExpressionUUID->"71b25090-08de-ef4f-ba0c-49eaa7ab892d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Partition", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"wig", "=", 
        RowBox[{"WignerRepresentation", "[", 
         RowBox[{
          RowBox[{"evolved", "[", "t", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]}], ";", 
       RowBox[{"DensityPlot", "[", 
        RowBox[{
         RowBox[{"wig", "[", 
          RowBox[{"x", ",", "p"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", 
           RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
         RowBox[{"PlotPoints", "->", "60"}], ",", 
         RowBox[{"ColorFunction", "->", "\"\<DeepSeaColors\>\""}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<p\>\""}], "}"}]}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"StringForm", "[", 
           RowBox[{"\"\<t = ``\>\"", ",", "t"}], "]"}]}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"{", 
         RowBox[{
         "0", ",", "1.25", ",", "2.5", ",", "5", ",", "7.5", ",", "10"}], 
         "}"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"{", "2", "}"}]}], "]"}], "//", "GraphicsGrid"}]], "Input",
 CellChangeTimes->{{3.9876823035117016`*^9, 3.987682404930414*^9}, {
  3.9876824506679554`*^9, 3.987682468793535*^9}, {3.9876828160556927`*^9, 
