Cell[TextData[{
 "Atom initially in ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", 
    SqrtBox["2"]], 
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], "+", 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"]}], ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d950d76-dd18-2b24-2baa-a533d4ad760e"],
 " and field in a thermal state with ",
