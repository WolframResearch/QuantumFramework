 "Compute the HusimiQ representation for a Fock state with ",
 Cell[BoxData[
  RowBox[{"n", " ", "=", " ", "4"}]], "InlineFormula",ExpressionUUID->
  "3bb455d6-40dc-1649-8887-230da954a300"],
 ":"
}], "Text",
