Cell[CellGroupData[{

Cell[TextData[StyleBox["Setting the space size", "Subsection"]], "Subsection",
 CellChangeTimes->{{3.9351438731924114`*^9, 3.9351438781889*^9}},
 CellID->350355536,ExpressionUUID->"b2864e9d-c3c8-c849-af49-04fe7c35651a"],

Cell[TextData[{
 "The global variable ",
 Cell[BoxData[
 "$FockSize"],ExpressionUUID->"0c47293a-eb3a-48e4-ad06-541798548b93"],
 " stores the default truncation size (dimension) of the Fock space. It is \
used by all second-quantization functions when the ",
 StyleBox["size",
  FontSlant->"Italic"],
 " parameter is not explicitly specified.\n\[Bullet] Default value: 16\n\
\[Bullet] Use ",
 Cell[BoxData[
  RowBox[{"SetFockSpaceSize", "[", "n", "]"}]],ExpressionUUID->
  "b155e29b-0059-4810-9b30-6bb3e122e0ce"],
 " to change the default.\n\[Bullet] Use ",
 Cell[BoxData[
  RowBox[{"SetFockSpaceSize", "[", "]"}]],ExpressionUUID->
  "3ca4c2b0-bb58-4b73-83ac-f8d8ac397d8b"],
 " to reset to 16."
}], "Text",
 CellChangeTimes->{3.979303442738669*^9, 3.979303473209807*^9},
 CellID->109293109,ExpressionUUID->"9f14cc72-a17a-48bf-97a8-e968d61e836d"],

Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " Larger truncation sizes improve accuracy for high photon-number states, \
but increase computational cost."
}], "Text",
 CellChangeTimes->{3.979303442738669*^9},
 CellID->1223671907,ExpressionUUID->"e6ab52a9-f107-4a7b-9f25-81b7aa3104cf"],

