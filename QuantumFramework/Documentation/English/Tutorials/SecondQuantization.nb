        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    PlotRange -> All, AxesLabel -> {"g t", "Time Average"}, LabelStyle -> 10],
    SelectWithContents->True,
