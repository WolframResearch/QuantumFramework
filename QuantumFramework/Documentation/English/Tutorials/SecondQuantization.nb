Cell[CellGroupData[{

Cell["\<\
Define the annihilation operator and create a random pure state:\
\>", "Text",
 CellChangeTimes->{{3.9780031807946663`*^9, 3.9780031892925606`*^9}},
 CellID->874709361,ExpressionUUID->"6347095e-0adb-b547-a5b5-423d24a3cc2c"],

Cell[BoxData[{
 RowBox[{"a", ":=", 
  RowBox[{"AnnihilationOperator", "[", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<RandomPure\>\"", ",", "$FockSize"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.939293922718481*^9, 3.939294001364734*^9}, {
  3.979331249829814*^9, 3.979331253285028*^9}},
