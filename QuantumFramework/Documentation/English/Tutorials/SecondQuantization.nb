Cell[CellGroupData[{

Cell["\<\
Calculate the variance of the quadrature operators for the ground state:\
\>", "Text",
 CellChangeTimes->{{3.934451263783296*^9, 3.9344512651468277`*^9}, 
   3.934451360635341*^9},
