Cell[CellGroupData[{

Cell[TextData[{
 "Steady state solution is a coherent state with amplitude ",
 Cell[BoxData[
  RowBox[{"\[Alpha]", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "2"}], "\[ImaginaryI]", " ", 
    RowBox[{"g", "/", "\[Gamma]"}]}]}]], "InlineFormula",ExpressionUUID->
  "40cf2405-b245-da43-91a1-2d25a5ec863c"],
 " via phase-space integration:"
}], "Text",
 CellChangeTimes->{{3.9397269276060524`*^9, 3.939726998768667*^9}, {
  3.979331726554262*^9, 3.97933172655433*^9}},
