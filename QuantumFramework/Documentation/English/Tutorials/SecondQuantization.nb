 CellID->546816275,ExpressionUUID->"5a3f70a5-22c0-7548-bea7-70e2aee4ccbd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Compute the mean number of photons using QuantumMeasurementOperator:\
\>", "Text",
 CellChangeTimes->{{3.93929402231242*^9, 3.9392940234196014`*^9}, {
  3.978003226014797*^9, 3.978003236383024*^9}},
