Cell["Jaynes-Cummings with dissipation", "Subsection",
 CellID->979112453,ExpressionUUID->"319e51f9-a9ce-1d21-67a6-48a2c87b640b"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", "\[HBar]", 
    StyleBox["\[Nu]", "TI"], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    FractionBox["1", "2"], "\[HBar]", 
    StyleBox["\[Omega]", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["z", "TI"]], "+", "\[HBar]", 
    StyleBox["g", "TI"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Sigma]", "TI"], "+"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "+", 
     SubscriptBox[
      StyleBox["\[Sigma]", "TI"], "-"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    FractionBox[
     StyleBox[
      RowBox[{"d", "\[Rho]"}], "TI"], 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       FractionBox[
        StyleBox["i", "TI"], "\[HBar]"], 
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        OverscriptBox[
         StyleBox["H", "TI"], "^"], ",", 
        StyleBox["\[Rho]", "TI"]}], 
       StyleBox["]",
        SpanMaxSize->1]}]}], "+", 
     RowBox[{
      SubscriptBox["\|01d49f", 
       StyleBox["decay",
        FontSlant->"Plain"]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["\[Rho]", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}], "+", 
     RowBox[{
      SubscriptBox["\|01d49f", 
       StyleBox["loss",
        FontSlant->"Plain"]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["\[Rho]", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1275520950,ExpressionUUID->"26f4962c-805e-a216-4e8b-087631e8f17c"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\|01d49f", 
    StyleBox[
     RowBox[{"d", "e", "c", "a", "y"}], "TI"]], ",", 
   SubscriptBox["\|01d49f", 
    StyleBox[
     RowBox[{"l", "o", "s", "s"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "313d5a7b-7caf-7acc-60c3-5c25755a4816"],
 " are the master equation dissipator terms related to Lindblad jump \
operators ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["L", "TI"], "1"], "=", 
   SqrtBox[
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "1"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], "-"], "\[CircleTimes]", "\[ThinSpace]", 
    "\[ScriptCapitalI]"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2da78195-91be-94f0-5b5c-18df2048feda"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["L", "TI"], "2"], "=", 
   SqrtBox[
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "2"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
   "\[ScriptCapitalI]", "\[ThinSpace]", "\[CircleTimes]", "\[ThinSpace]", 
    OverscriptBox[
     StyleBox["a", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39c6b7ab-78e0-e73c-6ffd-2ef5789aca06"],
 ", consider the initial state |e\[RightAngleBracket]|n\[RightAngleBracket] \
with ",
 Cell[BoxData[
  RowBox[{"n", "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f7d0c35-7157-44bf-6502-a67f00e22e85"],
 "."
}], "Text",
 CellID->1453852156,ExpressionUUID->"47b49f91-c3c7-4deb-6d4b-16daf6721731"],

Cell["Definition of the basis and the necessary operators:", "Text",
 CellID->428051484,ExpressionUUID->"064e3005-d89e-7c03-2e75-aa6ed92b4769"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"atomBasis", " ", "=", " ", 
   RowBox[{"QuantumBasis", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<e\>\"", ",", " ", "\"\<g\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]plus", " ", "=", "  ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<+\>\"", ",", " ", "atomBasis"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]minus", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<-\>\"", ",", " ", "atomBasis"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a", " ", ":=", " ", 
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"{", "2", "}"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[128]:= ",
 CellID->916399008,ExpressionUUID->"76c2caed-aea0-13a2-1ef1-e3b6cb556188"],

Cell["Parameter setting:", "Text",
 CellID->958201811,ExpressionUUID->"260c3025-1fa9-9acd-4e33-a98f9a5de817"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "8", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Nu]", " ", "=", " ", "10."}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"field", " ", "frequency"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]", " ", "=", " ", "10."}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"atomic", " ", "frequency"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gc", " ", "=", " ", "15."}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"interaction", " ", "coupling", " ", "strength"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tf", " ", "=", " ", "1"}], ";"}], "        ", 
  RowBox[{"(*", " ", 
   RowBox[{"Final", " ", "time"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"\[Psi]0", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<0\>\"", ",", " ", "atomBasis"}], "]"}], ",", " ", 
     RowBox[{"FockState", "[", "2", "]"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[129]:= ",
 CellID->758281744,ExpressionUUID->"4b1e6c2c-0452-4134-7925-8676ade7101e"],

Cell["Hamiltonian definition:", "Text",
 CellID->267282080,ExpressionUUID->"2982aea8-af87-65d7-5fb1-47f5ca324f3d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H", " ", "=", "  ", 
   RowBox[{
    RowBox[{"\[Nu]", " ", 
     RowBox[{
      RowBox[{"SuperDagger", "[", "a", "]"}], "@", "a"}]}], " ", "+", " ", 
    "\n", "   ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", "\[Omega]", " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Z\>\"", ",", " ", "atomBasis"}], "]"}]}], " ", "+", " ", 
    "\n", "   ", 
    RowBox[{"gc", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Sigma]plus", "@", "a"}], " ", "+", " ", 
       RowBox[{"\[Sigma]minus", "@", 
        RowBox[{"SuperDagger", "[", "a", "]"}]}]}], ")"}]}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[130]:= ",
 CellID->525320152,ExpressionUUID->"19ac3a5e-0cd6-873c-4f53-bc18a560ea06"],

Cell["Jump operators:", "Text",
 CellID->1343012926,ExpressionUUID->"6e8690e9-968f-68b3-16bd-09b3233a3a99"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"decayAtom", " ", "=", " ", 
   RowBox[{"\[Sigma]minus", "@", 
    RowBox[{"QuantumOperator", "[", 
     RowBox[{
      RowBox[{"\"\<I\>\"", "[", "$FockSize", "]"}], ",", " ", 
      RowBox[{"{", "2", "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lossField", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"\"\<I\>\"", ",", " ", "atomBasis"}], "]"}], "@", "a"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[131]:= ",
 CellID->877538218,ExpressionUUID->"2b6bc1ec-c569-bd9f-5968-d8c9ec1d07e5"],

Cell["\<\
Helper definition to get the probability of finding the atom in the excited \
state in a time window:\
\>", "Text",
 CellID->1440747355,ExpressionUUID->"25f1a39a-81e0-db80-538e-3ac4379aa9ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"atomProb", "[", 
   RowBox[{"evolved_", ",", " ", "tspecs_"}], "]"}], " ", ":=", " ", "\n", 
  " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SuperDagger", "[", 
          RowBox[{"QuantumState", "[", 
           RowBox[{"\"\<0\>\"", ",", " ", "atomBasis"}], "]"}], "]"}], "@", 
         RowBox[{"evolved", "[", "t", "]"}]}], ")"}], "[", "\n", 
       "    ", "\"\<Norm\>\"", "]"}]}], "}"}], ",", " ", 
    RowBox[{"Evaluate", "[", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", 
       RowBox[{"Sequence", " ", "@@", " ", "tspecs"}]}], "}"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[132]:= ",
 CellID->1362359959,ExpressionUUID->"35466be2-b7a8-26dc-637d-82cfc2428c26"],

Cell[TextData[{
 "Compute the evolution for different damping parameters ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58bdea72-0ba3-5f4c-0842-0c3cae562596"],
 ", and record the probability of finding the atom in the excited state:"
}], "Text",
 CellID->2112650841,ExpressionUUID->"6e8cef58-e908-949c-16b3-070588a2fee6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"probsE", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[ScriptCapitalH]", " ", "=", " ", "\n", "    ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<Hamiltonian\>\"", "[", 
         RowBox[{"H", ",", " ", 
          RowBox[{"{", 
           RowBox[{"decayAtom", ",", " ", "lossField"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "x"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
      "      ", 
      RowBox[{"evolved", " ", "=", " ", 
       RowBox[{"QuantumEvolve", "[", 
        RowBox[{"\[ScriptCapitalH]", ",", " ", "\[Psi]0", ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], ";", 
      "\n", "      ", 
      RowBox[{"atomProb", "[", 
       RowBox[{"evolved", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "0.01"}], "}"}]}], "]"}]}], ",",
      "\n", "      ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.8", ",", " ", "0.4", ",", " ", "0.2"}], "}"}]}], "}"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[133]:= ",
 CellID->78108254,ExpressionUUID->"0abc4047-6c7b-4886-3a44-5a21050e1aec"],

Cell["Damped Rabi oscillations:", "Text",
 CellID->99991631,ExpressionUUID->"24e21d63-fe6b-5877-4c91-954cfb1e2b5d"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"probsE", ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Mesh", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}], ",", " ", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", " ", "\n", 
      "   ", "\"\<\!\(\*SubscriptBox[\(P\), \(\( | \(e\)\)\(\
\[RightAngleBracket]\)\)]\)(t)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"LabelStyle", " ", "->", " ", "9"}], ",", " ", "\n", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "350"}], ",", " ", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Gamma],\[Kappa] = 0.8\>\"", ",", 
      " ", "\"\<\[Gamma],\[Kappa] = 0.4\>\"", ",", " ", "\n", 
      "   ", "\"\<\[Gamma],\[Kappa] = 0.2\>\""}], "}"}]}], ",", " ", "\n", 
   " ", 
   RowBox[{
   "PlotLabel", " ", "->", " ", "\n", 
    "  ", "\"\<Damped Rabi oscillations for different dissipation \
parameters\>\""}]}], "]"}]], "Input",
 CellLabel->"In[134]:= ",
 CellID->2135723872,ExpressionUUID->"348d2737-4aeb-e3cb-5cb2-bf716e9fb111"],

Cell[TextData[{
 "Now let's evolve different states of the form |e\[RightAngleBracket] \
\[CircleTimes] |\[Alpha]\[RightAngleBracket], for decay parameters ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], ",", 
   RowBox[{
    StyleBox["\[Kappa]", "TI"], "=", "\[ThinSpace]", "0.5"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2161c865-0900-0907-571e-e24fa8b5586d"]
}], "Text",
 CellID->2122331774,ExpressionUUID->"3cadbe4b-a339-c651-6452-3014d6cdacbb"],

Cell["Define the states:", "Text",
 CellID->1105063295,ExpressionUUID->"31169419-f57b-983b-672d-0e42fc0feb01"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"alphas", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.3", ",", " ", "0.6", ",", " ", "1.2", ",", " ", "1.8"}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"states0", " ", "=", " ", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"\"\<0\>\"", ",", " ", "atomBasis"}], "]"}], " ", "//", " ", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]", "]"}]}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", " ", "alphas"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[135]:= ",
 CellID->49362880,ExpressionUUID->"40aa99e8-53bd-499c-70a9-10b266481be6"],

Cell["Define the master equation super-operator:", "Text",
 CellID->354212003,ExpressionUUID->"5d165407-aaf3-867b-0b2e-4e60ce87ed41"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalH]", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Hamiltonian\>\"", "[", 
     RowBox[{"H", ",", " ", 
      RowBox[{"{", 
       RowBox[{"decayAtom", ",", " ", "lossField"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.5", ",", " ", "0.5"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[136]:= ",
 CellID->353755861,ExpressionUUID->"75cb8946-a0dc-0da7-23c8-2123d169578d"],

Cell["Calculate the probabilities of the evolved states:", "Text",
 CellID->1381752550,ExpressionUUID->"63688a50-35e7-99e6-1117-2c1a4393ebcc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"probsE", " ", "=", " ", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"atomProb", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"QuantumEvolve", "[", 
        RowBox[{"\[ScriptCapitalH]", ",", " ", "#", ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "2", ",", " ", "0.01"}], "}"}]}], "]"}], " ", 
     "&"}], " ", "/@", "\n", "    ", "states0"}]}], ";"}]], "Input",
 CellLabel->"In[137]:= ",
 CellID->240240661,ExpressionUUID->"12187c95-2034-8b29-4238-75df51c6d673"],

Cell["Plot the results:", "Text",
 CellID->717709873,ExpressionUUID->"34b193bd-0a67-a7a6-5c4e-0ae7af130d8c"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"probsE", ",", " ", 
   RowBox[{"InterpolationOrder", " ", "->", " ", "2"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "350"}], ",", " ", "\n", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", " ", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"StringForm", "[", 
        RowBox[{"\"\<\[Alpha] = ``\>\"", ",", " ", "#"}], "]"}], " ", "&"}], 
      " ", "/@", " ", "alphas"}], ")"}]}], ",", " ", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", "\n", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", " ", "\n", 
      "   ", "\"\<\!\(\*SubscriptBox[\(P\), \(\( | \(e\)\)\(\
\[RightAngleBracket]\)\)]\)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"LabelStyle", " ", "->", " ", "13"}], ",", " ", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"Thickness", "[", "0.005", "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[138]:= ",
 CellID->1579862385,ExpressionUUID->"4fca8ec2-4b73-3b52-75c9-27ac6e0789b8"],

Cell["Driven-Dissipative Kerr Nonlinear Oscillator", "Subsection",
 CellID->1519548544,ExpressionUUID->"656925a1-dac3-d209-1316-bc0adf77a153"],

Cell["The Hamiltonian is:", "Text",
 CellID->1310584264,ExpressionUUID->"09e13884-5cc5-f650-3f9e-b1ee5571dcba"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  OverscriptBox[
   StyleBox["H", "TI"], "^"], "=", "\[ThinSpace]", "-", "\[CapitalDelta]", 
  SuperscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "\[Dagger]"], 
  OverscriptBox[
   StyleBox["a", "TI"], "^"], "+", 
  FractionBox[
   StyleBox["K", "TI"], "2"], 
  StyleBox["(",
   SpanMaxSize->1], 
  RowBox[{
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    RowBox[{"\[Dagger]", "2"}]], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2"]}], 
  StyleBox[")",
   SpanMaxSize->1], "+", "\[Epsilon]", 
  StyleBox["(",
   SpanMaxSize->1], 
  RowBox[{
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], "+", 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}], 
  StyleBox[")",
   SpanMaxSize->1]}]], "InlineFormula",
 FontSize->0.9 
  Inherited,ExpressionUUID->"29829495-262a-abaa-5fb1-0ddf53dcf9f0"]], "Text",
 CellID->1486299183,ExpressionUUID->"136212ad-a4c2-b9f3-4111-8bf6cd740bd9"],

Cell[TextData[{
 "where \[CapitalDelta] is the detuning, K, is the Kerr nonlinearity and \
\[CurlyEpsilon] is the drive strength. Dissipation can be added with the \
photon loss channel with Lindblad operator ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["L", "TI"], 
    StyleBox[
     RowBox[{"l", "o", "s", "s"}], "TI"]], "=", 
   SqrtBox[
    StyleBox["\[Kappa]", "TI"]], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67f6b273-a0bf-ee61-0d8d-343cd14bb54b"]
}], "Text",
 CellID->397945072,ExpressionUUID->"07a2a6c0-d7ac-3784-2d51-3fade25e9dee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", " ", ":=", " ", 
   RowBox[{"AnnihilationOperator", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "25", "]"}], ";"}]}], "Input",
 CellLabel->"In[139]:= ",
 CellID->1376055927,ExpressionUUID->"7d29df82-54ab-6c21-24d6-d6ec5d5e370b"],

Cell["Define the Hamiltonian:", "Text",
 CellID->831978544,ExpressionUUID->"2673b224-f5d9-a24c-4e00-2b81fc6df096"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "\[CapitalDelta]"}], " ", 
       RowBox[{
        RowBox[{"SuperDagger", "[", "a", "]"}], "@", "a"}]}], " ", "+", " ", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"K", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"SuperDagger", "[", "a", "]"}], "^", "2"}], ")"}], "@", 
         RowBox[{"(", 
          RowBox[{"a", "^", "2"}], ")"}]}], ")"}]}], " ", "+", " ", 
      RowBox[{"\[CurlyEpsilon]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SuperDagger", "[", "a", "]"}], " ", "+", "\n", "        ", 
         "a"}], ")"}]}]}], ",", " ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[CapitalDelta]", ",", " ", "K", ",", " ", "\[CurlyEpsilon]"}], 
       "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[140]:= ",
 CellID->742981267,ExpressionUUID->"27388ee6-22a7-f122-4ec7-27c05753c008"],

Cell["We take the vacuum as the initial state:", "Text",
 CellID->222677598,ExpressionUUID->"51cd4bfd-d3fa-9dcf-07f3-62a6e58ce715"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{"FockState", "[", "0", "]"}]}], ";"}]], "Input",
 CellLabel->"In[141]:= ",
 CellID->1759027522,ExpressionUUID->"06a776cb-b9d0-3c58-2e5d-6f95386a86a2"],

Cell[TextData[{
 "Set up the Lindbladian with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[CapitalDelta]", "=", "3"}], ",", 
   RowBox[{
    StyleBox["K", "TI"], "=", "1"}], ",", 
   RowBox[{"\[Epsilon]", "=", "1.5"}], ",", 
   RowBox[{
    StyleBox["\[Kappa]", "TI"], "=", "0.5", "\[ThinSpace]"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7641b941-63e8-8619-1e7e-312b1582ed63"],
 ":"
}], "Text",
 CellID->842995745,ExpressionUUID->"42b8cf72-fa81-ffe6-7247-e73fff35c5cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalL]", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Liouvillian\>\"", "[", 
     RowBox[{
      RowBox[{"H", "[", 
       RowBox[{"3", ",", " ", "1", ",", " ", "1.5"}], "]"}], ",", " ", 
      RowBox[{"{", "a", "}"}], ",", " ", 
      RowBox[{"{", "0.5", "}"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[142]:= ",
 CellID->826855062,ExpressionUUID->"1c8db7a0-3aa3-299f-44b2-2e0abf567be5"],

Cell[TextData[{
 "Calculate the evolution numerically , with final time ",
 Cell[BoxData[
  RowBox[{"\[ThinSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["f", "TI"]], "=", "15"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "473593be-64fb-e664-6eca-0af80c8fcd4e"],
 ":"
}], "Text",
 CellID->1819871389,ExpressionUUID->"79a8e286-b760-8808-2f57-fbe3c21adb52"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evolved", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{"I", " ", "\[ScriptCapitalL]"}], ",", " ", "\[Rho]0", ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "15"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[143]:= ",
 CellID->1369109689,ExpressionUUID->"766f3dde-6e6e-8ae3-1e14-b4980b18d8c9"],

Cell["Wigner function snapshots:", "Text",
 CellID->969435735,ExpressionUUID->"7acff19c-f8f8-c05b-2af4-e8d9f97292a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Partition", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"wig", " ", "=", " ", 
        RowBox[{"WignerRepresentation", "[", 
         RowBox[{
          RowBox[{"evolved", "[", "t", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "5"}], ",", " ", "5"}], "}"}]}], "]"}]}], ";", " ", 
       "\n", "   ", 
       RowBox[{"DensityPlot", "[", 
        RowBox[{
         RowBox[{"wig", "[", 
          RowBox[{"x", ",", " ", "p"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", 
           RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", 
           RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
         RowBox[{"PlotPoints", " ", "->", " ", "60"}], ",", " ", "\n", "    ", 
         RowBox[{"ColorFunction", " ", "->", " ", "\"\<DeepSeaColors\>\""}], ",",
          " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",", " ", 
         "\n", "    ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", "\n", "    ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"StringForm", "[", 
           RowBox[{"\"\<t = ``\>\"", ",", " ", "t"}], "]"}]}]}], "]"}]}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", 
        RowBox[{"{", 
         RowBox[{
         "0", ",", " ", "1.25", ",", " ", "2.5", ",", " ", "5", ",", " ", 
          "7.5", ",", " ", "\n", "     ", "10"}], "}"}]}], "}"}]}], "]"}], ",",
     " ", 
    RowBox[{"{", "2", "}"}]}], "]"}], " ", "//", " ", 
  "GraphicsGrid"}]], "Input",
 CellLabel->"In[144]:= ",
 CellID->2139671006,ExpressionUUID->"36bb0aa4-099e-3511-5e58-a30ea8289c7b"],

Cell["\<\
We see the steady state resembles a coherent state up to distortion that \
depends of the parameters, it is known that evolution in Kerr nonlinear \
oscillators can produce coherent state manifold convergence\
\>", "Text",
 CellID->2132865528,ExpressionUUID->"6fab4322-7f5b-c123-15a9-5a8c7aef9009"],

Cell[TextData[{
 "Set up a numerical function for comparing the fidelity of the evolved state \
at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], 
   StyleBox["f", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "559c0528-76f1-864e-03a3-9d720285ec94"],
 " and a coherent state:"
}], "Text",
 CellID->2076214023,ExpressionUUID->"4c3b3e9a-7f95-6e09-75d8-b7c47a203553"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
  RowBox[{"QuantumSimilarity", "[", 
   RowBox[{
    RowBox[{"evolved", "[", "15", "]"}], ",", " ", 
    RowBox[{
     RowBox[{"CoherentState", "[", "]"}], "[", "x", "]"}]}], "]"}]}]], "Input",\

 CellLabel->"In[145]:= ",
 CellID->1646421792,ExpressionUUID->"7b834648-1855-f17e-29b1-581299e1c044"],

Cell[TextData[{
 "Look for a coherent state that maximizes the fidelity with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[ThinSpace]", "=", 
   StyleBox["x", "TI"], "+", 
   StyleBox["i", "TI"], "\[ThinSpace]", 
   StyleBox["y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aa15cf4-f328-f435-1a5f-55b186c2df1f"],
 ", we limit the region from ",
 Cell[BoxData[
  RowBox[{"1", "/", "4", "\[LessEqual]", GridBox[{
     {
      StyleBox["\[Alpha]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fa3178e-7287-38be-4550-8ee807338a84"],
 ":"
}], "Text",
 CellID->498624839,ExpressionUUID->"33c53063-afff-c489-61fa-aa4cc98baed3"],

Cell[BoxData[
 RowBox[{"sol", " ", "=", " ", 
  RowBox[{"NMaximize", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"x", " ", "+", " ", 
      RowBox[{"I", "  ", "y"}]}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y"}], "}"}], " ", "\[Element]", " ", 
     RowBox[{"Annulus", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "4"}], ",", " ", "1"}], "}"}]}], "]"}]}], ",", " ",
     "\n", "  ", 
    RowBox[{"Method", " ", "->", " ", "\"\<SimulatedAnnealing\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[146]:= ",
 CellID->1956171421,ExpressionUUID->"08d8bcb3-70a4-55b3-38e7-35fd01513f99"],

Cell[TextData[{
 "Following a semi-classical approach such the parameters are in the \
stability regime the coherent state amplitude of convergence can be derived \
as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[ThinSpace]", "=", "\[ThinSpace]", 
   FractionBox["\[Epsilon]", 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CapitalDelta]", "\[ThinSpace]", "-", "\[ThinSpace]", 
      StyleBox["K", "TI"], "\[ThinSpace]", 
      SuperscriptBox[GridBox[{
         {
          StyleBox["\[Alpha]", "TI"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
     StyleBox[")",
      SpanMaxSize->1], "+", 
     StyleBox["i", "TI"], "\[ThinSpace]", 
     FractionBox[
      StyleBox["\[Kappa]", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20e38226-5aed-155d-5090-1b805e987fa7"]
}], "Text",
 CellID->451051907,ExpressionUUID->"160727ef-d1b8-0069-3e3c-bec8e04d52b3"],

Cell["Taking the root with less energy:", "Text",
 CellID->319345791,ExpressionUUID->"261df1b1-b81e-57af-4e22-e8fb39ab3df5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\[Alpha]", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalDelta]", " ", "=", " ", "3"}], ",", " ", 
     RowBox[{"\[CurlyEpsilon]", " ", "=", " ", 
      RowBox[{"3", "/", "2"}]}], ",", " ", 
     RowBox[{"\[Kappa]", " ", "=", " ", 
      RowBox[{"1", "/", "2"}]}], ",", " ", "\n", "  ", 
     RowBox[{"K", " ", "=", " ", "1"}]}], "}"}], ",", " ", 
   RowBox[{"First", "@", "\n", "  ", 
