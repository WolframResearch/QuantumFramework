Cell[CellGroupData[{

Cell["\<\
Atom gets \"thermalized\"; the time-average of the coherences \[RightArrow] 0:\
\>", "Text",
 CellChangeTimes->{3.939730982574957*^9},
 CellID->537489911,ExpressionUUID->"1359ef50-7531-1d47-9e7f-6809ee80c134"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"timeAverages", " ", "=", " ", 
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"atomMatrix", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}], ")"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "tf"}], "}"}]}], "]"}], "/", "tf"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{"timeAverages", ",", 
   RowBox[{"{", 
    RowBox[{"tf", ",", "5", ",", "200"}], "}"}], ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
