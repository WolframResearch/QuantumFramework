Cell[CellGroupData[{

Cell["Details and options", "Section",
 CellChangeTimes->{{3.9668797306193485`*^9, 3.9668797332567024`*^9}},
 CellTags->"details",
 CellID->84098118,ExpressionUUID->"7938d1b2-9701-dc47-900f-cce2ed9a6134"],

Cell[CellGroupData[{

Cell["Operators Mathematical Definitions", "Subsection",
 CellChangeTimes->{{3.9668798562716274`*^9, 3.9668798579051685`*^9}, {
  3.966880536153078*^9, 3.966880541335865*^9}},
 CellID->513931050,ExpressionUUID->"26cd2805-64c7-f143-9d4d-522fcab205fe"],

Cell[BoxData[GridBox[{
   {"DisplacementOperator", Cell[TextData[Cell[BoxData[
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"\[Alpha]", " ", 
        SuperscriptBox["a", "\[Dagger]"]}], " ", "-", 
       RowBox[{
        SuperscriptBox["\[Alpha]", "*"], "a"}]}], "]"}]],
     CellChangeTimes->{{3.9668805854458694`*^9, 3.966880765448469*^9}, {
      3.9668816618727665`*^9, 3.9668817104304543`*^9}},ExpressionUUID->
     "6febd74e-d86c-ef4c-93af-14435a8a3377"]], "TableText",ExpressionUUID->
     "57c7a8ff-5d11-8d44-a4f2-878efce35d1e"]},
   {"SqueezeOperator", 
    RowBox[{"Exp", "[", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Xi]", "\[Conjugate]"}], " ", 
         SuperscriptBox["a", "2"]}], " ", "-", " ", 
        RowBox[{"\[Xi]", "  ", 
         SuperscriptBox["a", "\[Dagger]2"]}]}], ")"}]}], "]"}]},
   {"PhaseShiftOperator", 
    RowBox[{"Exp", "[", 
     RowBox[{"\[ImaginaryI]", " ", "\[Theta]", " ", 
      SuperscriptBox["a", "\[Dagger]"], "a"}], "]"}]},
   {"BeamSplitterOperator", 
    RowBox[{"Exp", "[", 
     RowBox[{"\[Theta]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]], 
         SubscriptBox["a", "1"], 
         SuperscriptBox[
          SubscriptBox["a", "2"], "\[Dagger]"]}], "-", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Phi]"}]], 
         SuperscriptBox[
          SubscriptBox["a", "1"], "\[Dagger]"], 
         SubscriptBox["a", "2"]}]}], ")"}]}], "]"}]},
   {"QuadratureOperators", 
    RowBox[{
     RowBox[{
      SubscriptBox["X", "1"], ":", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"(", 
        RowBox[{"a", "+", 
         SuperscriptBox["a", "\[Dagger]"]}], ")"}]}]}], "\[LineSeparator]", 
     RowBox[{
      SubscriptBox["X", "2"], ":", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", " ", "\[ImaginaryI]"}]], 
       RowBox[{"(", 
        RowBox[{"a", "-", 
         SuperscriptBox["a", "\[Dagger]"]}], ")"}]}]}]}]}
  }]], "DefinitionBox",
 CellChangeTimes->{{3.9668805854458694`*^9, 3.966880765448469*^9}, {
  3.9668816618727665`*^9, 3.966881776836359*^9}, {3.966881809335121*^9, 
  3.9668819180852413`*^9}, {3.9668819834330215`*^9, 3.966882022793955*^9}},
 CellID->236089205,ExpressionUUID->"73b62542-3232-6b4d-b430-ba556bd7e1e5"],

Cell[CellGroupData[{

Cell["Displacement operator ordering", "Subsubsection",
 CellChangeTimes->{{3.934935727535406*^9, 3.934935729192171*^9}, {
  3.935142577202791*^9, 3.935142578767905*^9}, {3.935143403449379*^9, 
  3.9351434139013977`*^9}, {3.939238273300802*^9, 3.939238290158264*^9}},
 CellID->51071553,ExpressionUUID->"68f53579-716a-c944-9d3b-3636cfdc5c32"],

Cell["\<\
By default, when \"Ordering\" is not specified, normal ordering is used. The \
formulas for the three orderings are shown below:\
\>", "Text",
 CellChangeTimes->{{3.935143242360747*^9, 3.93514329436088*^9}, {
  3.935143507732025*^9, 3.935143559227091*^9}},
 CellID->808531428,ExpressionUUID->"5369df4d-6d4b-ea47-a43f-0bfc65bfe3d3"],

Cell[BoxData[GridBox[{
   {
    RowBox[{
     ButtonBox["DisplacementOperator",
      BaseStyle->"Link",
      ButtonData->"paclet:Wolfram/QuantumFramework/ref/DisplacementOperator"],
      "[", 
     RowBox[{"..", ",", 
      RowBox[{"\"\<Ordering\>\"", "\[Rule]", 
       StyleBox["st", "TI"]}]}], "]"}], Cell[TextData[Cell[BoxData[{
     RowBox[{
      RowBox[{
       RowBox[{
        StyleBox["st", "TI"], " ", "can", " ", "be", " ", "\"\<Normal\>\""}], 
       ",", " ", 
       RowBox[{"\"\<Weak\>\"", " ", "or", " ", 
        RowBox[{"\"\<Antinormal\>\"", ".", "\n", "\n", "For"}], 
        " ", "\"\<Normal\>\""}], ",", " ", 
       RowBox[{"one", " ", 
        RowBox[{"gets", ":", "\n", Cell[TextData[Cell[BoxData[
          FormBox[
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{"-", 
              RowBox[{"|", "\[Alpha]", 
               SuperscriptBox["|", "2"], 
               RowBox[{"/", "2"}]}]}], "]"}], 
            RowBox[{"Exp", "[", 
             RowBox[{"\[Alpha]", " ", "\.01", 
              SuperscriptBox["a", "\[Dagger]"]}], "]"}], 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"\[Alpha]", "\[Conjugate]"}]}], " ", "a"}], "]"}]}], 
           TraditionalForm]], "InlineFormula",ExpressionUUID->
          "5cd31484-bc37-ac4c-9129-900dcfe475d8"]],ExpressionUUID->
          "9e89e391-02af-6647-95e9-fed5a6c23a99"]}]}]}], "\n"}], "\n", 
     RowBox[{
      RowBox[{
       RowBox[{"For", " ", "\"\<Weak\>\""}], ",", " ", 
       RowBox[{"one", " ", 
        RowBox[{"gets", ":", "\n", Cell[TextData[Cell[BoxData[
          FormBox[
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"\[Alpha]", " ", 
              SuperscriptBox["a", "\[Dagger]"]}], "-", 
             RowBox[{
              RowBox[{"\[Alpha]", "\[Conjugate]"}], "a"}]}], "]"}], 
           TraditionalForm]], "InlineFormula",ExpressionUUID->
          "c834c064-066e-8049-abd1-550f01154ab6"]],ExpressionUUID->
          "abbdada9-81e2-b54d-8010-db8097f6ea5e"]}]}]}], "\n"}], "\n", 
     RowBox[{
      RowBox[{"For", " ", "\"\<Antinormal\>\""}], ",", " ", 
      RowBox[{"one", " ", 
       RowBox[{"gets", ":", "\n", Cell[TextData[Cell[BoxData[
         FormBox[
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"|", "\[Alpha]", 
             SuperscriptBox["|", "2"], 
             RowBox[{"/", "2"}]}], "]"}], 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"\[Alpha]", "\[Conjugate]"}]}], "a"}], "]"}], 
           RowBox[{"Exp", "[", 
            RowBox[{"\[Alpha]", " ", 
             SuperscriptBox["a", "\[Dagger]"]}], "]"}]}], TraditionalForm]], 
         "InlineFormula",ExpressionUUID->
         "977eaf0b-3e2e-2e48-b13f-b1702e1177e0"]],ExpressionUUID->
         "005560f9-7b49-f84b-81ce-9fefd573440d"]}]}]}]}],ExpressionUUID->
     "dcc1789c-5f9e-6541-a334-b93ffb8c5345"]], "TableText",ExpressionUUID->
     "ad906918-b166-a74a-b31f-9cf2c0ff8cbc"]}
  }]], "DefinitionBox",
 CellChangeTimes->{{3.935143314495157*^9, 3.93514334029138*^9}, {
   3.9351660629595776`*^9, 3.935166077307043*^9}, {3.935166167752891*^9, 
   3.935166167752891*^9}, 3.935238473572525*^9, {3.9358376758445873`*^9, 
   3.935837739520411*^9}},
 CellID->366259675,ExpressionUUID->"73e84a8a-dbb8-c846-9d2c-966930abb925"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Squeeze operator ordering", "Subsubsection"]], \
"Subsubsection",
 CellChangeTimes->{{3.935144028528902*^9, 3.935144029444059*^9}, {
  3.939238475068777*^9, 3.939238480301512*^9}},
 CellID->19049080,ExpressionUUID->"57a647cb-50ce-4949-88c8-5e884c4d9159"],

Cell["\<\
By default, when \"Ordering\" is not specified, normal ordering is used. The \
formulas for the three orderings are shown below:\
\>", "Text",
 CellChangeTimes->{3.9351440498314896`*^9},
 CellID->185154664,ExpressionUUID->"eb775168-74be-f94e-91dd-b37ed0e4b7c7"],

Cell[BoxData[GridBox[{
   {
    RowBox[{
     ButtonBox["SqueezeOperator",
      BaseStyle->"Link",
      ButtonData->"paclet:Wolfram/QuantumFramework/ref/SqueezeOperator"], "[", 
     RowBox[{"\[Ellipsis]", ",", 
      RowBox[{"\"\<Ordering\>\"", "\[Rule]", 
       StyleBox["st", "TI"]}]}], "]"}], Cell[TextData[{
     Cell[BoxData[
      StyleBox["st", "TI"]], "InlineFormula",ExpressionUUID->
      "2072a4aa-0b50-0c4d-8596-485de3351608"],
     " can be \"Normal\", \"Antinormal\" or \"Weak\". Given  ",
     Cell[BoxData[
      RowBox[{"\[Xi]", "=", 
       SuperscriptBox["r\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}]], "InlineFormula",
      ExpressionUUID->"bdbc010c-3a23-974d-8303-38f492b497d9"],
     "\nfor \"Normal\", one gets:\n",
     Cell[BoxData[Cell[TextData[Cell[BoxData[
       FormBox[
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], " ", 
           RowBox[{"Tanh", "[", "r", "]"}], 
           SuperscriptBox[Cell[TextData[Cell[BoxData[
             FormBox["a", TraditionalForm]], "InlineFormula",ExpressionUUID->
             "1cae5a19-ed30-9e42-a455-1e2ce21c960a"]],ExpressionUUID->
             "afa62b31-5c23-c34e-9d47-8b0edba0da3c"], "\[Dagger]2"]}], "]"}], 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Log", "[", 
             RowBox[{"Cosh", "[", "r", "]"}], "]"}]}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SuperscriptBox["a", "\[Dagger]"], "a"}], " ", "+", " ", 
             FractionBox["1", "2"]}], ")"}]}], "]"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           FractionBox["1", "2"], 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Theta]"}]], 
           RowBox[{"Tanh", "[", "r", "]"}], 
           SuperscriptBox["a", "2"]}], "]"}]}], TraditionalForm]], 
       "InlineFormula",ExpressionUUID->
       "63b519d4-e0c5-3b43-9a1f-7c463f91ef10"]],ExpressionUUID->
       "a85d0551-a4c8-634b-84a7-36f2afb090c2"]], "InlineFormula",
      ExpressionUUID->"e6487efd-3121-d44d-b21d-3254b35b35eb"],
     "\n\nFor \"Weak\", one gets:\n",
     Cell[BoxData[
      RowBox[{"Exp", "[", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Xi]", "\[Conjugate]"}], " ", 
           SuperscriptBox["a", "2"]}], " ", "-", " ", 
          RowBox[{"\[Xi]", "  ", 
           SuperscriptBox["a", "\[Dagger]2"]}]}], ")"}]}], "]"}]], 
      "InlineFormula",ExpressionUUID->"767d1334-2069-c74d-bd9a-450a8ebf40ba"],
     "\n\nFor \"Antinormal\", one gets:\n",
     Cell[BoxData[
      FormBox[
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          FractionBox["1", "2"], " ", Cell[TextData[Cell[BoxData[
           FormBox[Cell[TextData[Cell[BoxData[
             FormBox[Cell[TextData[Cell[BoxData[
               FormBox[
                SuperscriptBox["\[ExponentialE]", 
                 RowBox[{"-", "\[ImaginaryI]\[Theta]"}]], TraditionalForm]], 
               "InlineFormula",ExpressionUUID->
               "19f6b2f8-f14f-e84e-a82b-17ac5b1aeb43"]],ExpressionUUID->
               "33e79d47-6422-224b-9641-d2064151475c"], TraditionalForm]], 
             "InlineFormula",ExpressionUUID->
             "5837a767-564f-5f43-8704-b9da7fd53ca0"]],ExpressionUUID->
             "8f82793c-f0ed-fe4b-867a-09f053de78d1"], TraditionalForm]], 
           "InlineFormula",ExpressionUUID->
           "18a645cb-02c3-1543-afdc-d8e0ad1525be"]],ExpressionUUID->
           "f8b7ddb7-e4ef-3c4b-90b5-a97780498b33"], " ", 
          RowBox[{"Tanh", "[", "r", "]"}], 
          SuperscriptBox["a", "2"]}], "]"}], 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"Cosh", "[", "r", "]"}], "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             SuperscriptBox["a", "\[Dagger]"], "a"}], " ", "+", " ", 
            FractionBox["1", "2"]}], ")"}]}], "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "2"]}], 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], 
          RowBox[{"Tanh", "[", "r", "]"}], 
          SuperscriptBox["a", "\[Dagger]2"]}], "]"}]}], TraditionalForm]], 
      "InlineFormula",ExpressionUUID->"4e9bdbcd-3e17-d144-ab55-89a6ede81e2b"]
    }], "TableText",ExpressionUUID->"59e5967d-ba49-e44a-ae53-b7cf3ef6e05a"]}
  }]], "DefinitionBox",
 CellChangeTimes->{
  3.935144080512148*^9, {3.9351441193974934`*^9, 3.935144150966263*^9}, {
   3.935166186589561*^9, 3.9351662698870754`*^9}, {3.9351665823024845`*^9, 
   3.93516658247114*^9}, 3.935238518626517*^9, {3.935837444691313*^9, 
   3.935837469261279*^9}, {3.9358375065157413`*^9, 3.935837521661323*^9}, {
   3.93583756058722*^9, 3.935837653471539*^9}},
 CellID->580698945,ExpressionUUID->"e22d4227-f9f0-b84c-8dbd-f50a6bcf97e6"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Coherence and correlation functions", \
"Subsubsection"]], "Subsubsection",
 CellChangeTimes->{{3.935144028528902*^9, 3.935144029444059*^9}, {
  3.939238475068777*^9, 3.939238480301512*^9}, {3.979303328919059*^9, 
  3.979303337109976*^9}, {3.9797477824529495`*^9, 3.9797477954676647`*^9}},
 CellID->800866360,ExpressionUUID->"f45b0635-6dac-41a3-bcc3-faa97ed5991e"],

Cell[BoxData[GridBox[{
   {
    RowBox[{
     ButtonBox["G2Coherence",
      BaseStyle->"Link",
      ButtonData->"paclet:Wolfram/QuantumFramework/ref/G2Coherence"], "[", 
     StyleBox["\[Psi]", "TR"], "]"}], Cell[TextData[{
     "Second-order coherence ",
     Cell[BoxData[
      FormBox[
       SuperscriptBox["g", 
        RowBox[{"(", "2", ")"}]], TraditionalForm]],ExpressionUUID->
      "864ca871-6e45-4d46-8f5a-4fe9126a14d3"],
     "(0) for state \[Psi] "
    }], "TableText",ExpressionUUID->"8e9d9a06-c104-174c-8cdd-90f24e8b418a"]},
   {
    RowBox[{
     ButtonBox["G1Correlation",
      BaseStyle->"Link",
      ButtonData->"paclet:Wolfram/QuantumFramework/ref/G1Correlation"], "[", 
     RowBox[{
      StyleBox["\[Psi]", "TR"], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          StyleBox[
           SubscriptBox["r", "1"], "TI"], ",", 
          StyleBox[
           SubscriptBox["t", "1"], "TI"]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox[
           SubscriptBox["r", "2"], "TI"], ",", 
          StyleBox[
           SubscriptBox["t", "2"], "TI"]}], "}"}]}], "}"}]}], "]"}], Cell[
    TextData[{
     "First-order correlation function ",
     Cell[BoxData[
      RowBox[{
       SuperscriptBox["G", 
        RowBox[{"(", "1", ")"}]], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["x", "1"], ",", 
         SubscriptBox["x", "2"]}], ")"}]}]], "InlineFormula",
      FormatType->StandardForm,ExpressionUUID->
      "145a6808-c72c-a14d-bed7-2dac9cd4fc6e"],
     " for state \[Psi] at the space and time coordinates ",
     Cell[BoxData[
      RowBox[{
       SubscriptBox["r", "1"], ",", 
       SubscriptBox["t", "1"], ",", 
       SubscriptBox["r", "2"], ",", 
       SubscriptBox["t", "2"]}]], "InlineFormula",
      FormatType->StandardForm,ExpressionUUID->
      "3e872e03-7d12-1e4d-823a-43f41169233a"]
    }], "TableText",ExpressionUUID->"3a3de7ac-859f-594e-bed7-d8cfb7df27ab"]}
  }]], "DefinitionBox",
 CellChangeTimes->{{3.9343729113143234`*^9, 3.93437307161562*^9}, {
   3.934464743181917*^9, 3.934464752770138*^9}, 3.935161745203053*^9, 
   3.935161903738392*^9, 3.9351619364412975`*^9, 3.935161974737898*^9, {
   3.9351621761426926`*^9, 3.935162217205831*^9}, {3.9352379277614994`*^9, 
   3.9352379422274647`*^9}, 3.935237989684992*^9, 3.9352380887746525`*^9, {
   3.9352381525922604`*^9, 3.935238163702259*^9}, {3.9779401706778374`*^9, 
   3.9779401822389965`*^9}, {3.97799899055941*^9, 3.977998990810072*^9}, 
   3.979303345461733*^9, {3.9797477667610874`*^9, 3.979747838784096*^9}, {
   3.9797479104917126`*^9, 3.979748033300785*^9}, {3.979751139806656*^9, 
   3.9797511532994633`*^9}, 3.9797513671542377`*^9, 3.979751421014393*^9},
 CellID->2069717438,ExpressionUUID->"f081f15b-92e3-1f4c-b5ff-02f8e3ead85d"]
