Cell[TextData[{
 "Now let's evolve different states of the form |e\[RightAngleBracket] \
\[CircleTimes] |\[Alpha]\[RightAngleBracket], for decay parameters  ",
 Cell[BoxData[
  RowBox[{"\[Gamma]", ",", 
   RowBox[{"\[Kappa]", "=", " ", "0.5"}]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "05216de0-e88b-7045-981a-dc21ab2390ee"]
}], "Text",
 CellChangeTimes->{{3.987679034957239*^9, 3.987679052802065*^9}},
 CellID->29012051,ExpressionUUID->"b20f3997-0bb7-2145-8ae2-e0be5df85274"],

Cell[CellGroupData[{

Cell["Define the states:", "Text",
 CellChangeTimes->{{3.9876790575545406`*^9, 3.987679060193434*^9}},
 CellID->44000714,ExpressionUUID->"2612db78-4c0f-4844-bbf9-87db58eda041"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"alphas", " ", "=", 
   RowBox[{"{", 
    RowBox[{"0.3", ",", "0.6", ",", "1.2", ",", "1.8"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"states0", " ", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"\"\<0\>\"", ",", "atomBasis"}], "]"}], "//", 
      RowBox[{
       RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "alphas"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9876764516618633`*^9, 3.9876764545259457`*^9}, {
  3.987676885903879*^9, 3.9876769689048347`*^9}, {3.987677055748335*^9, 
  3.987677093325712*^9}, {3.9876775575101337`*^9, 3.9876775581004295`*^9}, {
  3.9876783105216236`*^9, 3.987678311000057*^9}},
 CellLabel->"In[133]:=",
 CellID->756703616,ExpressionUUID->"3624c457-a43a-224d-884a-5026f2f26f32"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Define the master equation super-operator:", "Text",
 CellChangeTimes->{{3.987680940869505*^9, 3.987680968762171*^9}},
 CellID->94421638,ExpressionUUID->"af875b4d-6035-1744-a853-15e61e8dc646"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalH]", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Hamiltonian\>\"", "[", 
     RowBox[{"H", ",", " ", 
      RowBox[{"{", 
       RowBox[{"decayAtom", ",", " ", "lossField"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.5", ",", " ", "0.5"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.987676978376951*^9, 3.9876770012884007`*^9}, {
  3.9876773244338093`*^9, 3.9876773269607754`*^9}, {3.987677370761652*^9, 
  3.987677373511421*^9}, {3.9876781676652412`*^9, 3.98767817090189*^9}, {
  3.987678314880499*^9, 3.9876783168706436`*^9}, {3.9876785752107124`*^9, 
  3.987678578275116*^9}, {3.9876786172859344`*^9, 3.9876786324430294`*^9}, {
  3.987678704465906*^9, 3.9876787073549175`*^9}},
 CellLabel->"In[153]:=",
 CellID->420536364,ExpressionUUID->"65450d1c-e981-1c44-8b7d-033f1b78f7a1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Calculate the probabilities of the evolved states:", "Text",
 CellChangeTimes->{{3.9876790660313377`*^9, 3.9876790745853176`*^9}},
 CellID->161407798,ExpressionUUID->"b3d68a1a-ac40-9643-836a-e6418fcd7685"],

Cell[BoxData[
 RowBox[{
  RowBox[{"probsE", " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"atomProb", "[", 
      RowBox[{
       RowBox[{"QuantumEvolve", "[", 
        RowBox[{"\[ScriptCapitalH]", ",", " ", "#", ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "2", ",", " ", "0.01"}], "}"}]}], "]"}], "&"}],
     "/@", "states0"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.987677186517515*^9, 3.9876772615490856`*^9}, {
  3.9876773639365997`*^9, 3.9876773824620285`*^9}},
 CellLabel->"In[154]:=",
 CellID->100792915,ExpressionUUID->"0102bf92-1069-6f44-be24-9f8323fa8997"]
}, Open  ]],

