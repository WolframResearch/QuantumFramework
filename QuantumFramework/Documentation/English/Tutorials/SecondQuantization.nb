Cell[TextData[{
 "Evolve the density matrix ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Rho]", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "\[ThinSpace]", "=", 
   RowBox[{
    OverscriptBox[
     StyleBox["U", "TI"], "^"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "\[ThinSpace]", 
    StyleBox["\[Rho]", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "0", 
     StyleBox[")",
      SpanMaxSize->1]}], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["U", "TI"], "^"], "\[Dagger]"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "\[ThinSpace]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69698b1d-3dc2-3628-1f16-2347b4749d72"],
 ". We use shortcut notation applied to matrix states:"
}], "Text",
 CellID->1671307962,ExpressionUUID->"701e1eb7-eeba-61c8-2025-97f08b4f3312"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]t", "  ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SuperDagger", "[", "U", "]"}], "[", "\[Rho]0", "]"}], ",", " ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"g", ",", " ", "t"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
