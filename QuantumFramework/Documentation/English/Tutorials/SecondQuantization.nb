  "adabe799-cd2d-d04b-b935-71ec0e750161"], "DisplayMath"],
 StyleBox[" ", "DisplayMath"],
 " with Lindblad jump operator ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["L", "1"], " ", "=", " ", 
   RowBox[{
    SqrtBox["\[Gamma]"], 
    OverscriptBox["a", "^"]}]}]], "InlineFormula",ExpressionUUID->
  "791ff9ea-d45d-7842-8894-0561dbcf45a5"],
 " (single-photon loss channel), and set ",
 Cell[BoxData[
  RowBox[{"\[Omega]", " ", "=", " ", "1"}]], "InlineFormula",ExpressionUUID->
  "52e18f82-09da-134a-a5af-70614de99139"]
}], "Text",
 CellChangeTimes->{{3.939724206866108*^9, 3.9397242450345497`*^9}, {
   3.939724389667036*^9, 3.939724491944227*^9}, {3.939725077041073*^9, 
   3.939725079101248*^9}, {3.978013098946186*^9, 3.978013120449339*^9}, 
   3.9780131893251896`*^9},
 CellID->417650805,ExpressionUUID->"026c1acd-17ab-5449-bee2-dda8ed1e43bf"],

Cell[CellGroupData[{

Cell[TextData[{
 "Define the annihilation operator and use a coherent state with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"|", "\[Alpha]", "|"}], " ", "=", " ", "2"}]], "InlineFormula",
  ExpressionUUID->"d9d58e71-49df-884e-a53a-18421eed8155"],
 " as the initial state:"
}], "Text",
 CellChangeTimes->{{3.978013193056978*^9, 3.9780132367344494`*^9}},
 CellID->225915482,ExpressionUUID->"efdd22ff-2451-a641-a4ef-da9cd3ea6543"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", ":=", 
   RowBox[{"AnnihilationOperator", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "15", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]", " ", "=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"2", "Pi"}]}], "}"}], "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{
    RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.939723857488302*^9, 3.9397238974074135`*^9}, {
   3.9397241574299717`*^9, 3.939724166631735*^9}, 3.978013169978506*^9, {
   3.9876188382438583`*^9, 3.9876188483598347`*^9}},
 CellLabel->"In[97]:=",
 CellID->245004512,ExpressionUUID->"6ed814e0-faa2-1540-8ee1-e4df2d8340ed"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Set the decay rate \[Gamma]:", "Text",
 CellChangeTimes->{{3.9780131722762585`*^9, 3.9780131794478397`*^9}},
 CellID->310472194,ExpressionUUID->"cc5c7995-978c-ef4f-bbc3-f95ef43dce1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Gamma]", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.939723857488302*^9, 3.9397238974074135`*^9}, {
   3.9397241574299717`*^9, 3.939724166631735*^9}, 3.978013169978506*^9},
 CellLabel->"In[101]:=",
 CellID->383735794,ExpressionUUID->"ee3ecf41-cad5-5e43-b166-7418b225b027"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Define the Hamiltonian including photon loss:", "Text",
 CellChangeTimes->{{3.9397251674647293`*^9, 3.9397251728829956`*^9}, {
  3.978013302402298*^9, 3.978013306507206*^9}},
 CellID->267985992,ExpressionUUID->"96af15cd-7a4b-de41-b334-663ddccec63e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalH]", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Hamiltonian\>\"", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox["a", "\[Dagger]"], "@", "a"}], ",", 
      RowBox[{"{", "a", "}"}], ",", 
      RowBox[{"{", "\[Gamma]", "}"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.939723951975933*^9},
 CellLabel->"In[102]:=",
 CellID->155571871,ExpressionUUID->"7446e911-0fa7-ac41-9834-efc5b84c2acd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["State evolution, we can do it symbolically:", "Text",
 CellChangeTimes->{{3.9397251761338673`*^9, 3.9397251802771397`*^9}, {
  3.987619002897011*^9, 3.9876190087680435`*^9}},
 CellID->209014580,ExpressionUUID->"18838a2c-7851-0c4a-abbf-b8c3bce78852"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]t", " ", "=", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{"\[ScriptCapitalH]", ",", "\[Rho]0", ",", "t"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.937070865885565*^9, 3.937070951150661*^9}, {
   3.937070984270387*^9, 3.937071033361496*^9}, 3.9370711477828293`*^9, {
   3.937071797615963*^9, 3.937071798683155*^9}, 3.9370719271381207`*^9, {
   3.9370721618428345`*^9, 3.937072162146517*^9}, {3.937320838955311*^9, 
   3.937320840779654*^9}, {3.9374906784041176`*^9, 3.937490680415438*^9}, {
   3.937582006959781*^9, 3.937582011949812*^9}, 3.937585631693239*^9, 
   3.937585964074503*^9, {3.97801333653611*^9, 3.978013337258213*^9}, {
   3.978013370115513*^9, 3.978013403303734*^9}},
 CellLabel->"In[103]:=",
 CellID->385481085,ExpressionUUID->"5cc27513-e934-ee41-9d94-a5f3e5c91aca"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Plot the mean photon number as a function of time:", "Text",
 CellChangeTimes->{{3.93972592923505*^9, 3.939725932498375*^9}, {
  3.9780139922933197`*^9, 3.9780140027903366`*^9}},
 CellID->564375853,ExpressionUUID->"94126e21-6f7c-d341-9c5c-3300f59fe182"],

Cell[BoxData[
 RowBox[{
  RowBox[{"meanPhotonPlot", " ", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{"$FockSize", "-", "1"}]}], "]"}], ".", 
       RowBox[{"Diagonal", "[", 
        RowBox[{
         RowBox[{"\[Rho]t", "[", "t", "]"}], "[", "\"\<DensityMatrix\>\"", 
         "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
     InterpretationBox[
      DynamicModuleBox[{Typeset`open = False}, 
       TemplateBox[{"Expression", "SequenceIcon", 
         GridBox[{{
            RowBox[{
              TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["Sequence", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["6", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Byte count: \"", "IconizedLabel"], 
              "\[InvisibleSpace]", 
              TagBox["680", "IconizedItem"]}]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
          "Column", 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
         Dynamic[Typeset`open]},
        "IconizedObject"]],
      Sequence[
      Frame -> True, FrameLabel -> {"t", "Mean photon number"}, GridLines -> 
       Automatic, LabelStyle -> 10, ImageSize -> 220, PlotRange -> {0, 4}],
      SelectWithContents->True,
      Selectable->False]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9780139719297333`*^9, 3.978013986560442*^9}, 
   3.9793314715728607`*^9, {3.979331616979826*^9, 3.979331624173712*^9}},
 CellLabel->"In[107]:=",
 CellID->898743199,ExpressionUUID->"a5890825-49ae-5e48-bd4a-50e085cca53b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Plot the fidelity with respect to the analytic expression:", "Text",
 CellChangeTimes->{{3.9780140074803944`*^9, 3.9780140235657825`*^9}},
 CellID->461786818,ExpressionUUID->"2ea80a0e-c2f7-f844-8360-91b2a8c1c39d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fidelityPlot", " ", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"QuantumSimilarity", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CoherentState", "[", "]"}], "[", 
        RowBox[{"\[Alpha]", " ", 
         FormBox[
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], " ", "t"}]], " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             RowBox[{"-", 
              FractionBox["1", "2"]}], " ", "t", " ", "\[Gamma]"}]]}],
          TraditionalForm]}], "]"}], ",", 
       RowBox[{"\[Rho]t", "[", "t", "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
     InterpretationBox[
      DynamicModuleBox[{Typeset`open = False}, 
       TemplateBox[{"Expression", "SequenceIcon", 
         GridBox[{{
            RowBox[{
              TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["Sequence", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["6", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Byte count: \"", "IconizedLabel"], 
              "\[InvisibleSpace]", 
              TagBox["680", "IconizedItem"]}]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
          "Column", 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
         Dynamic[Typeset`open]},
        "IconizedObject"]],
      Sequence[
      Frame -> True, FrameLabel -> {"t", "State similarity"}, GridLines -> 
       Automatic, LabelStyle -> 10, PlotRange -> {0, 1.1}, ImageSize -> 220],
      SelectWithContents->True,
      Selectable->False]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.978014032579647*^9, 3.9780140416196423`*^9}, {
  3.9876190890870457`*^9, 3.9876190950767555`*^9}},
 CellLabel->"In[108]:=",
 CellID->140723838,ExpressionUUID->"340a5227-eb3e-c344-b8db-8bcfb584c1ec"]
}, Open  ]],

