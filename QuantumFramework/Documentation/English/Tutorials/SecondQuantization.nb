Cell[TextData[{
 "If your detector clicks, it means you caught a photon. Because photons only \
exist in pairs in this specific state, the probability that a second photon \
is right there with it is virtually 100%.Therefore, ",
 Cell[BoxData[
  SuperscriptBox["g", "2"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "a45a8442-82d2-104a-b655-fec81a1af50e"],
 " diverges because the conditional probability of detecting a second photon \
(given that you just detected a first) is massively disproportionate to the \
absolute probability of detecting a photon randomly in the dark field (\
\[Epsilon] \[Rule]0)"
}], "Text",
 CellChangeTimes->{{3.987616170970644*^9, 3.9876161927347126`*^9}},
 CellID->430750577,ExpressionUUID->"9f4c68d5-c51f-a149-a1f9-2b283a20ae60"]
}, Open  ]],

Cell[CellGroupData[{

Cell["G1Correlation (first - order correlation)", "Subsection",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.979758886232725*^9, 3.97975889821212*^9}},
 CellID->25383635,ExpressionUUID->"50c6ff98-421f-9844-a7a6-e89cd09ae265"],

Cell["The first-order correlation is defined for some state |\[Psi]\
\[RightAngleBracket] as", "Text",
 CellChangeTimes->{{3.9797589382846146`*^9, 3.9797589436797943`*^9}, {
  3.9797590334528503`*^9, 3.9797590640242176`*^9}},
 CellID->184679887,ExpressionUUID->"c71db4a8-c89d-9545-b2fe-53eb78527d04"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["G", 
     RowBox[{"(", "1", ")"}]], "(", 
    RowBox[{
     SubscriptBox["x", "1"], ",", 
     SubscriptBox["x", "2"]}], ")"}], "=", 
   RowBox[{"\[LeftAngleBracket]", " ", 
    RowBox[{"\[Psi]", " ", "|", " ", 
     RowBox[{
      RowBox[{
       SuperscriptBox["E", 
        RowBox[{"(", "-", ")"}]], "(", 
       RowBox[{
        SubscriptBox["r", "1"], ",", 
        SubscriptBox["t", "1"]}], ")"}], " ", 
      RowBox[{
       SuperscriptBox["E", 
        RowBox[{"(", "+", ")"}]], "(", 
       RowBox[{
        SubscriptBox["r", "2"], ",", 
        SubscriptBox["t", "2"]}], ")"}]}], " ", "|", "\[Psi]"}], 
    "\[RightAngleBracket]"}]}], 
  TraditionalForm]],ExpressionUUID->"190ef594-5e4f-c34b-81a3-c60effbfcc4c"]], \
"Text",
 CellChangeTimes->{{3.979759073164133*^9, 3.979759175690544*^9}},
 CellID->26277864,ExpressionUUID->"ad12b5bc-4b58-604c-acf9-d600f44c7e68"],

Cell[TextData[{
 "where the ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["E", 
    RowBox[{"(", "+", ")"}]], ",", 
   SuperscriptBox["E", 
    RowBox[{"(", "-", ")"}]]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "970b7c38-87a6-e94f-80cf-cf25c9ee8b83"],
 " are the positive and negative frequency components of a single-mode field"
}], "Text",
 CellChangeTimes->{{3.9797593239578743`*^9, 3.979759324774008*^9}},
 CellID->688587865,ExpressionUUID->"05157ede-911b-ff49-b683-a7f6b22d17a5"],

