Cell[BoxData[{
 RowBox[{
  RowBox[{"timeAverages", " ", "=", " ", 
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"atomMatrix", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], ")"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "0", ",", " ", "tf"}], "}"}]}], "]"}], "/", 
    "tf"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{"timeAverages", ",", " ", 
   RowBox[{"{", 
    RowBox[{"tf", ",", " ", "5", ",", " ", "200"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", "\n", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<g t\>\"", ",", " ", "\"\<Time Average\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"LabelStyle", " ", "->", " ", "10"}]}], "]"}]}], "Input",
 CellLabel->"In[127]:= ",
