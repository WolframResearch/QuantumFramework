Cell[CellGroupData[{

Cell["Optical balance", "Subsection",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.93972610896122*^9, 3.9397261110666637`*^9}},
 CellID->78610014,ExpressionUUID->"2a827ff5-49dd-194d-a4f3-63c899d6934c"],

Cell["\<\
Consider the following master equation, which balances a driving field \
Hamiltonian and single-photon loss:\
\>", "Text",
 CellChangeTimes->{{3.9397263922728615`*^9, 3.9397264000764008`*^9}, {
  3.9397264352398148`*^9, 3.9397264717704697`*^9}},
 CellID->739726139,ExpressionUUID->"96293b67-3d22-5341-b098-1ba8bef21cf8"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"\[DifferentialD]", " ", "\[Rho]"}], 
   RowBox[{"\[DifferentialD]", "t"}]], "=", " ", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"\[ImaginaryI]g", "[", 
     RowBox[{
      RowBox[{
       OverscriptBox["a", "^"], "+", 
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"]}], ",", 
      OverscriptBox["\[Rho]", "^"]}], "]"}]}], "+", 
   RowBox[{
    FractionBox["\[Gamma]", "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", 
       OverscriptBox["a", "^"], 
       OverscriptBox["\[Rho]", "^"], 
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"]}], "-", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"], 
       OverscriptBox["a", "^"], 
       OverscriptBox["\[Rho]", "^"]}], "-", 
      RowBox[{
       OverscriptBox["\[Rho]", "^"], 
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"], 
       OverscriptBox["a", "^"]}]}], ")"}]}]}]}]], "DisplayMath",
 FontSize->18,ExpressionUUID->"ca840adb-edca-d94b-9c8b-9dbbd7d86433"]], "Text",
 CellChangeTimes->{{3.9397261554325123`*^9, 3.939726326575058*^9}, {
  3.939726357452097*^9, 3.939726386301983*^9}, {3.979331713131145*^9, 
  3.97933171313124*^9}},
 TextAlignment->Center,
 CellID->81870317,ExpressionUUID->"a7681e37-7294-5241-8c44-8987bd5b82f5"],

Cell[CellGroupData[{

Cell["Set the drive strength g:", "Text",
 CellChangeTimes->{{3.9780147547215385`*^9, 3.978014758887701*^9}, 
   3.97933171569773*^9},
 CellID->528824710,ExpressionUUID->"3d9ebbed-4058-fd4e-b853-2dd68f812d31"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9397264858274593`*^9, 3.9397264921520405`*^9}, 
   3.9793317171197863`*^9},
 CellLabel->"In[110]:=",
 CellID->442135777,ExpressionUUID->"6c370bbc-81b8-0c4c-bb96-bcf0f43dc261"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Random initial state:", "Text",
 CellChangeTimes->{{3.9397265987885647`*^9, 3.9397266044503136`*^9}},
 CellID->179887015,ExpressionUUID->"761f1c04-6ce5-ee44-8e28-13920c871575"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<RandomPure\>\"", ",", "$FockSize"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.937586701941025*^9},
 CellLabel->"In[111]:=",
 CellID->288579784,ExpressionUUID->"ed203b24-296a-5c45-ad98-ad7d57aa1246"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Set up the master equation:", "Text",
 CellChangeTimes->{{3.939726561723749*^9, 3.9397265716174393`*^9}, {
  3.9780147762314873`*^9, 3.978014780098421*^9}},
 CellID->12042636,ExpressionUUID->"433adcc3-dbd4-9445-aff3-f8551590bba1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalH]", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Hamiltonian\>\"", "[", 
     RowBox[{
      RowBox[{"g", 
       RowBox[{"(", 
        RowBox[{"a", "+", 
         RowBox[{"a", "[", "\"\<Dagger\>\"", "]"}]}], ")"}]}], ",", 
      RowBox[{"{", "a", "}"}], ",", 
      RowBox[{"{", "\[Gamma]", "}"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.939726503994396*^9, 3.979331722072147*^9},
 CellLabel->"In[112]:=",
 CellID->94776920,ExpressionUUID->"c12a98dd-8871-184f-baa8-0e3ec1ba133a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Numerical evolution from ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["t", "i"], "=", "0", " "}]], "InlineFormula",ExpressionUUID->
  "ecf40f40-3d0a-8041-a822-a3b2532a99ae"],
 " to ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["t", "f"], "=", "3"}]], "InlineFormula",ExpressionUUID->
  "bf271128-1240-024e-8e9e-2a11b66a38db"],
 "  :"
}], "Text",
 CellChangeTimes->{{3.939726695159668*^9, 3.939726778603817*^9}, {
   3.978014788470318*^9, 3.9780148165316734`*^9}, 3.9780151402572823`*^9},
 CellID->841316915,ExpressionUUID->"de51f4fb-1b13-364a-bed1-6a8d714dfb84"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]t", "=", 
   RowBox[{"QuantumEvolve", "[", " ", 
    RowBox[{"\[ScriptCapitalH]", ",", "\[Rho]0", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9370730828642197`*^9, 3.937073085681879*^9}, {
   3.9370731997703304`*^9, 3.937073202332178*^9}, {3.937073268811537*^9, 
   3.937073271709444*^9}, {3.9370733125378838`*^9, 3.9370733174537163`*^9}, {
   3.9370738594434376`*^9, 3.937073882692065*^9}, {3.937323486748808*^9, 
   3.937323489166176*^9}, 3.937323599603386*^9, {3.937324665411724*^9, 
   3.937324724802521*^9}, {3.937324768440838*^9, 3.937324839537554*^9}, 
   3.937325358584535*^9, 3.937326330061312*^9, 3.937326526514427*^9, {
   3.9374904696743317`*^9, 3.937490491365692*^9}, {3.93756651121846*^9, 
   3.937566512397928*^9}, 3.937566700233761*^9, {3.937567204790858*^9, 
   3.937567205562834*^9}, {3.937567826021511*^9, 3.9375678286467338`*^9}, {
