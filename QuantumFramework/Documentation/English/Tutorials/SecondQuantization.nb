Cell[CellGroupData[{

Cell["\<\
Calculate the evolution for the states |g\[RightAngleBracket] \[CircleTimes] \
|n\[RightAngleBracket], varying the number state n:\
\>", "Text",
 CellChangeTimes->{{3.9876198412915516`*^9, 3.987619855679453*^9}, {
  3.987675302372059*^9, 3.9876753291911125`*^9}},
 CellID->523755230,ExpressionUUID->"8952ecda-7d1e-e44c-8f31-6f22b759febf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"TableForm", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"s", "=", 
        RowBox[{"QuantumTensorProduct", "[", 
         RowBox[{
          RowBox[{"QuantumState", "[", 
           RowBox[{"\"\<1\>\"", ",", " ", "atomBasis"}], "]"}], ",", " ", 
          RowBox[{"FockState", "[", "x", "]"}]}], "]"}]}], ";", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"s", "[", "\"\<Formula\>\"", "]"}], ",", 
         RowBox[{"U", "@", "s"}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "10"}], "}"}]}], "]"}], ",", 
    RowBox[{"TableHeadings", "->", 
     RowBox[{"{", 
      RowBox[{"None", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Initial State\>\"", ",", "\"\<Evolved State\>\""}], 
        "}"}]}], "}"}]}]}], "]"}], "//", "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.9876196627471504`*^9, 3.9876197280616817`*^9}, {
  3.98767478509181*^9, 3.987674864864752*^9}, {3.98767490066584*^9, 
  3.9876749165989933`*^9}, {3.987675338695423*^9, 3.9876753588952923`*^9}},
 CellLabel->"In[53]:=",
 CellID->38835049,ExpressionUUID->"faa51654-f27f-484c-b8a1-845068cc6416"],

Cell[BoxData[
 FormBox[
  TagBox[
   TagBox[GridBox[{
      {
       TagBox["\<\"Initial State\"\>",
