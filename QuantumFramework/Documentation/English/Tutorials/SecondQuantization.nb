Cell[TextData[StyleBox["Cat State", "Subsection"]], "Subsection",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9344171244986763`*^9, 3.93441713893866*^9}},
 CellID->491356533,ExpressionUUID->"da4a0c1f-a3bc-bb4d-acd1-be1bd7d9a866"],

Cell[CellGroupData[{

Cell[TextData[{
 "Create a cat state ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptCapitalN]", "\[Alpha]"], 
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"\[Alpha]"},
      "Ket"], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", "\[ImaginaryI]\[Phi]"], 
      TemplateBox[{
        RowBox[{"-", "\[Alpha]"}]},
       "Ket"], Cell[
      ")",ExpressionUUID->"893df086-e6ed-3c4a-94b8-859ba84b88b1"]}]}]}]}]], 
  "InlineFormula",ExpressionUUID->"6f29257a-dbcc-41f8-9e99-497f32d4aebd"],
 " with amplitude ",
 Cell[BoxData[
  RowBox[{"\[Alpha]", "=", 
   RowBox[{"2", "+", "\[ImaginaryI]"}]}]], "InlineFormula",ExpressionUUID->
  "73431a3d-6c24-4c9d-aa74-040859d38dd3"],
 " and phase ",
 Cell[BoxData[
  RowBox[{"\[Phi]", "=", 
   RowBox[{"3", 
    RowBox[{"\[Pi]", "/", "4"}]}]}]], "InlineFormula",ExpressionUUID->
  "2f3e3d90-1572-4ed7-a5f0-4e6855558ee8"],
 ":"
}], "Text",
 CellChangeTimes->{{3.934417143019993*^9, 3.93441720073132*^9}, {
  3.934481880962816*^9, 3.934481984081724*^9}, {3.9392934833741884`*^9, 
  3.939293533777208*^9}},
 CellID->222039466,ExpressionUUID->"04889f87-f581-7045-862c-f7059f5cc9a3"],

