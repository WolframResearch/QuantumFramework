Cell["\<\
The following error messages may be generated by second-quantization \
functions:\
\>", "Text",
 CellID->97317287,ExpressionUUID->"dbb0c2ae-05ca-4d68-a9f8-6ffeeee99d42"],

Cell[BoxData[GridBox[{
   {Cell[BoxData[
     RowBox[{"FockState", "::", "clip"}]],ExpressionUUID->
     "02d5b8bf-02a2-4143-b32f-b9c3b605c2e9"], 
    RowBox[{
    "Issued", " ", "when", " ", "the", " ", "Fock", " ", "state", " ", 
     "index", " ", "is", " ", "outside", " ", "the", " ", "valid", " ", 
     RowBox[{
      RowBox[{"range", " ", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"size", "-", "1"}]}], "]"}], ".", " ", "The"}], " ", "index", 
     " ", "is", " ", "clipped", " ", "to", " ", "the", " ", "nearest", " ", 
     "valid", " ", 
     RowBox[{"value", "."}]}]},
   {Cell[BoxData[
     RowBox[{"FockVals", "::", "len"}]], "TableText",ExpressionUUID->
     "fc6be276-b6ff-4082-920b-3d1dc7dd4a6e"], 
    RowBox[{
    "Issued", " ", "when", " ", "multimode", " ", "Fock", " ", "state", " ", 
     "values", " ", "contain", " ", "invalid", " ", 
     RowBox[{"(", 
      RowBox[{"negative", " ", "or", " ", "too", " ", "large"}], ")"}], " ", 
     RowBox[{"integers", "."}]}]},
   {Cell[BoxData[
     RowBox[{"DisplacementOperator", "::", "invalidorder"}]], "TableText",
     ExpressionUUID->"fb964a6d-8680-44e0-9223-e11c314e955d"], Cell["\<\
Issued when the \"Ordering\" option is not \"Normal\", \"Weak\", or \
\"Antinormal\".\
\>", "TableText",ExpressionUUID->"69ddd1a3-8330-4c69-80c5-0463a8f77872"]},
   {Cell[BoxData[
     RowBox[{"SqueezeOperator", "::", "invalidorder"}]], "TableText",
     ExpressionUUID->"e8c33149-5467-4eb7-9aac-124036364aa1"], Cell["\<\
Issued when the \"Ordering\" option is not \"Normal\", \"Weak\", or \
\"Antinormal\".\
\>", "TableText",ExpressionUUID->"198d3b60-d573-40b4-beb5-6efbbe5ef799"]},
   {Cell[BoxData[
     RowBox[{"BeamSplitterOperator", "::", "badmethod"}]], "TableText",
     ExpressionUUID->"816c42d7-cdaa-4237-b7d5-6953c332638e"], Cell["\<\
Issued when the Method option is not \"MatrixExp\" or \"Recurrence\".\
\>", "TableText",ExpressionUUID->"1ac390d4-b7a2-4d01-b687-972a33e8355a"]}
  }]], "DefinitionBox",
 CellID->97317288,ExpressionUUID->"23d0e47e-87ca-4e8a-8767-2aa0ac63c130"],

