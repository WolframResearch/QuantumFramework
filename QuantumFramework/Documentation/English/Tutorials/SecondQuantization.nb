 CellID->541070449,ExpressionUUID->"fe46ba0e-17e0-de4d-af6d-97b35d75a7f0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\[Alpha]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalDelta]", "=", "3"}], ",", 
     RowBox[{"\[CurlyEpsilon]", "=", 
      RowBox[{"3", "/", "2"}]}], ",", 
     RowBox[{"\[Kappa]", "=", 
      RowBox[{"1", "/", "2"}]}], ",", 
     RowBox[{"K", "=", "1"}]}], "}"}], ",", 
   RowBox[{"First", "@", 
    RowBox[{"SortBy", "[", 
     RowBox[{
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Alpha]", "==", 
          FractionBox["\[CurlyEpsilon]", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[CapitalDelta]", "-", 
              RowBox[{"K", " ", 
               SuperscriptBox[
                RowBox[{"Abs", "[", "\[Alpha]", "]"}], "2"]}]}], ")"}], "+", 
            RowBox[{"\[ImaginaryI]", " ", 
             FractionBox["\[Kappa]", "2"], " "}]}]]}], "}"}], ",", 
        "\[Alpha]"}], "]"}], ",", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "&"}]}], "]"}]}]}], 
  "]"}]}], "Input",
