Cell[TextData[{
 "Wigner representation of a squeezed vacuum state with parameter ",
 Cell[BoxData[
  RowBox[{"\[Xi]", " ", "=", " ", "0.5"}]], "InlineFormula",ExpressionUUID->
  "9d55e21d-bc54-cc46-8534-ce7d3c6a4032"],
 ":"
}], "Text",
