Cell[CellGroupData[{

Cell[TextData[StyleBox["G2Coherence (Second-Order Coherence)", \
"Subsection"]], "Subsection",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9797503881319275`*^9, 3.9797503882176647`*^9}, {
  3.979755019205097*^9, 3.979755020037592*^9}},
 CellID->725669586,ExpressionUUID->"f0380c7a-d418-47df-b12a-750406684815"],

Cell[TextData[{
 "The function G2Coherence computes the equal-time second-order coherence ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["g", 
    RowBox[{"(", "2", ")"}]], 
   RowBox[{"(", "0", ")"}]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "adadddc8-a526-7a4c-80e7-c8498c0ab583"],
 " which characterizes the photon statistics of a quantum state. It is \
defined as:"
}], "Text",
 CellChangeTimes->{{3.979748630942938*^9, 3.9797486505404034`*^9}},
 CellID->406419882,ExpressionUUID->"7dd6f399-f114-484e-9a22-3f0c9ac71ba5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"(", "2", ")"}]], 
    RowBox[{"(", "0", ")"}], "=", 
    FractionBox[
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SuperscriptBox["a", "\[Dagger]"], 
       SuperscriptBox["a", "\[Dagger]"], "a", " ", "a"}], 
      "\[RightAngleBracket]"}], 
     SuperscriptBox[
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        SuperscriptBox["a", "\[Dagger]"], "a"}], "\[RightAngleBracket]"}], 
      "2"]]}], TraditionalForm]],ExpressionUUID->
  "ce390a06-74a0-491f-addb-7ce24fa44c34"],
 "\nPhysical interpretation:\n\[Bullet] ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["g", 
    RowBox[{"(", "2", ")"}]], "=", "1"}]], "InlineFormula",ExpressionUUID->
  "823fe3ab-015b-4162-b939-7c0082f7c6d1"],
 ": Poissonian statistics (coherent light)\n\[Bullet] ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["g", 
    RowBox[{"(", "2", ")"}]], "<", "1"}]], "InlineFormula",ExpressionUUID->
  "a7aabd34-15b9-4786-93d2-dab24906113c"],
 ": Sub-Poissonian (antibunching, nonclassical light)\n\[Bullet] ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["g", 
    RowBox[{"(", "2", ")"}]], ">", "1"}]], "InlineFormula",ExpressionUUID->
  "190a7fde-e49a-4874-b35c-3d83d9610db3"],
 ": Super-Poissonian (bunching, thermal light)\n\[Bullet] ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["g", 
    RowBox[{"(", "2", ")"}]], "=", "0"}]], "InlineFormula",ExpressionUUID->
  "1067a5c0-02b9-4dc6-9814-6362c0be8687"],
 ": Single-photon state"
}], "Text",
 CellChangeTimes->{{3.979308623165399*^9, 3.979308672936358*^9}, {
   3.979308741681452*^9, 3.97930875266558*^9}, 3.979320011335826*^9},
 CellID->406419883,ExpressionUUID->"83a16a75-e4d7-47b3-b91b-a86bc4cd0502"],

Cell[CellGroupData[{

Cell[TextData[{
 "For a coherent state, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["g", 
    RowBox[{"(", "2", ")"}]], "=", "1"}]],ExpressionUUID->
  "f2a27aa8-0fd4-4c51-80cf-c9be091e2a63"],
 ":"
}], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.979308756871002*^9, 3.979308758499427*^9}, {
  3.987615421834549*^9, 3.9876154247167473`*^9}},
 CellID->406419884,ExpressionUUID->"b92e829b-3283-49bc-af9e-2ff23cde6104"],

