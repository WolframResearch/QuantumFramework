 CellID->1824722239,ExpressionUUID->"f7d0f1ee-9ef5-4b48-9b8f-0c479c24e9d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DisplacementOperator", "[", 
   RowBox[{
    RowBox[{"0.5", "+", "\[ImaginaryI]"}], ",", 
    RowBox[{"\"\<Ordering\>\"", "->", "\"\<Weak\>\""}]}], "]"}], 
  "[", "\"\<UnitaryQ\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.934935838696339*^9, 3.9349358664339275`*^9}, {
