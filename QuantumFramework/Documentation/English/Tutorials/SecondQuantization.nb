Cell["Reduced density matrix of the atom:", "Text",
 CellID->196765340,ExpressionUUID->"61beb272-ef15-9663-1745-343f8aa1fd49"],

Cell[BoxData[
 RowBox[{
  RowBox[{"atomMatrix", " ", "=", " ", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{
       RowBox[{"QuantumPartialTrace", "[", 
        RowBox[{
         RowBox[{"\[Rho]t", "[", 
          RowBox[{"1", ",", " ", "t"}], "]"}], ",", " ", 
         RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<DensityMatrix\>\"", 
       "]"}], "]"}], " ", "//", " ", "\n", "    ", "ComplexExpand"}], " ", "//",
     " ", "Simplify"}]}], ";"}]], "Input",
 CellLabel->"In[125]:= ",
 CellID->977498757,ExpressionUUID->"5e8a6a96-06b4-6465-0689-83d0b3414f4f"],

Cell["Plot two components of the matrix:", "Text",
 CellID->1960241259,ExpressionUUID->"55951090-ef25-ccfd-03aa-89dd8ad196c7"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
