     "156728ce-0023-e03b-431c-c1a8b1d7b301"]], "TableText",ExpressionUUID->
     "7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"], Cell[TextData[Cell[BoxData[
     SqrtBox["2"]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "26ff5c08-e081-ff27-4e85-56559135c20d"]], "TableText",ExpressionUUID->
     "07c988c4-3ef2-8066-2df6-21aeba84d34c"], Cell[
    "Scaling factor of the representation", "TableText",ExpressionUUID->
     "4bc0a2f3-6150-447f-79ff-3bbd10e52f45"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7ac66077-3bfa-1f18-2afe-7a31bd8f6262"], Cell[TextData[Cell[
    BoxData["\"\<GridSize\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
