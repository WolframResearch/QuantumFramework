Cell[CellGroupData[{

Cell["\<\
Find the probability of the atom being in the excited state, using the \
projector as a measurement operator:\
\>", "Text",
 CellChangeTimes->{{3.9668898624254208`*^9, 3.9668898801513596`*^9}, {
  3.9876746969643497`*^9, 3.9876747054341297`*^9}},
 CellID->523752773,ExpressionUUID->"eb686e84-8ee3-1c4e-ab0c-f0f8c16f5f30"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"proj", " ", "=", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"\"\<0\>\"", ",", "atomBasis"}], "]"}], "[", "\"\<Operator\>\"", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"probE", " ", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"QuantumMeasurementOperator", "[", "proj", "]"}], "@", " ", 
      "\[Psi]t"}], ")"}], "[", "\"\<Mean\>\"", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.936101519118845*^9, 3.936101532471716*^9}, {
   3.936101562717808*^9, 3.936101640535839*^9}, {3.9361017236915493`*^9, 
   3.936101742141755*^9}, {3.936101817734251*^9, 3.936101840886004*^9}, {
   3.936101935830538*^9, 3.936101944688246*^9}, {3.937579518722328*^9, 
   3.937579535348167*^9}, 3.987674293329666*^9, {3.987674359877001*^9, 
   3.9876744151873817`*^9}, {3.9876746327281246`*^9, 3.987674639063469*^9}},
 CellLabel->"In[43]:=",
 CellID->39262926,ExpressionUUID->"1dd7ca4b-21db-9e46-b02f-b65f53ecbd76"]
}, Open  ]],

