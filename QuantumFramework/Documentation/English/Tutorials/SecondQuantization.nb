  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", "=", 
     RowBox[{"AnnihilationOperator", "[", "]"}]}], "}"}], ",", 
   RowBox[{"OperatorVariance", "[", 
    RowBox[{
     RowBox[{"FockState", "[", "2", "]"}], ",", 
     RowBox[{
      SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], "]"}]}], "]"}]], "Input",
