Cell[TextData[{
 "For a squeezed vacuum state with ",
 Cell[BoxData[
  RowBox[{"\[Xi]", " ", "=", " ", 
   RowBox[{"1.5", " ", "+", 
    RowBox[{"0.5", " ", "\[ImaginaryI]"}]}]}]], "InlineFormula",
  ExpressionUUID->"3cfd2e2b-89fc-7148-8fa0-b6af3379fcc5"],
 " and ",
 Cell[BoxData[
  RowBox[{"size", " ", "=", " ", "20"}]], "InlineFormula",ExpressionUUID->
  "a3c0b315-4698-3d4a-8dd6-cc06e02a7203"],
 " compare the numerical error of \"Weak\" and \"Normal\" orderings against \
the analytic expression. For this value of \[Xi], the truncation size is not \
sufficient for the weak-ordered operator, and the normal-ordered one is more \
accurate."
}], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.93514569784511*^9, 3.935145699495142*^9}, {
  3.93514576601371*^9, 3.935145789266681*^9}, {3.935158464437456*^9, 
  3.935158489999656*^9}, {3.9351592047765884`*^9, 3.935159283202743*^9}, {
  3.93515931592341*^9, 3.9351593723304424`*^9}},
 CellID->51765876,ExpressionUUID->"daa4a175-63e1-1e41-b6bb-eea6b98c1017"],

Cell[CellGroupData[{

Cell["Amplitudes obtained from a known analytic formula:", "Text",
 CellChangeTimes->{{3.9780030446603317`*^9, 3.978003072689781*^9}},
 CellID->39328641,ExpressionUUID->"6244a60a-6a78-9148-b8be-edd1d96f32ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"analytic", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", 
      SqrtBox[
       RowBox[{"Cosh", "[", 
        RowBox[{"Abs", "[", "\[Xi]", "]"}], "]"}]]}], 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         SqrtBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "m"}], ")"}], "!"}]], "/", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["2", "m"], 
           RowBox[{"m", "!"}]}], ")"}]}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "m"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "m", " ", 
          RowBox[{"Arg", "[", "\[Xi]", "]"}]}]], 
        SuperscriptBox[
         RowBox[{"Tanh", "[", 
          RowBox[{"Abs", "[", "\[Xi]", "]"}], "]"}], "m"]}], ",", 
       RowBox[{"{", 
        RowBox[{"m", ",", "0", ",", "9"}], "}"}]}], "]"}]}], "/.", 
    RowBox[{"\[Xi]", "->", 
     RowBox[{"(", 
      RowBox[{"1.5", "+", 
       RowBox[{"0.5", "\[ImaginaryI]"}]}], ")"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.935144747622265*^9, 3.9351447833561783`*^9}, {
   3.9351452052043304`*^9, 3.93514523027107*^9}, 3.935145267528045*^9, {
   3.935145340208954*^9, 3.9351453405478077`*^9}},
 CellLabel->"In[43]:=",
 CellID->787205352,ExpressionUUID->"374345ce-c564-f646-95bb-7575b29fea0f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compute absolute errors:", "Text",
 CellChangeTimes->{{3.9780030089788456`*^9, 3.9780030137586403`*^9}},
 CellID->480418249,ExpressionUUID->"4e23dc8d-db01-a54a-92e8-a607842f4a16"],

Cell[BoxData[
 RowBox[{
  RowBox[{"absoluteErrors", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"SqueezeOperator", "[", 
          RowBox[{
           RowBox[{"1.5", "+", 
            RowBox[{"0.5", "\[ImaginaryI]"}]}], ",", "20", ",", 
           RowBox[{"\"\<Ordering\>\"", "->", "#"}]}], "]"}], "[", "]"}], 
        "[", "\"\<AmplitudeList\>\"", "]"}], "-", "analytic"}], ")"}], "&"}], 
    " ", "/@", 
    RowBox[{"{", 
     RowBox[{"\"\<Normal\>\"", ",", "\"\<Weak\>\""}], "}"}]}]}], 
  ";"}]], "Input",
