Cell[CellGroupData[{

Cell["\<\
Define the atomic operators and the annihilation operator in second mode: \
\>", "Text",
 CellChangeTimes->{{3.9876192478679047`*^9, 3.9876192847688885`*^9}},
 CellID->107080814,ExpressionUUID->"b2965857-541f-d948-ba74-2a3ba06a6fb6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Sigma]plus", " ", "=", "  ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<+\>\"", ",", "atomBasis"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]minus", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<-\>\"", ",", "atomBasis"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", " ", ":=", " ", 
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"{", "2", "}"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.935507675735445*^9, 3.935507693292776*^9}, {
   3.9355077544952316`*^9, 3.935507763653515*^9}, {3.935509227340187*^9, 
   3.9355092288229694`*^9}, {3.9355093266277733`*^9, 3.935509327445307*^9}, {
   3.936098875328287*^9, 3.936098875902157*^9}, {3.93610038385375*^9, 
   3.9361004076151543`*^9}, 3.936101245579539*^9, {3.9369728423656025`*^9, 
   3.936972842564335*^9}, {3.936973003942936*^9, 3.936973004509838*^9}, {
   3.9369775118561954`*^9, 3.936977513300394*^9}, {3.937065871323984*^9, 
   3.9370658738213463`*^9}, {3.9668876404252567`*^9, 
   3.9668876474894695`*^9}, {3.9668877087409496`*^9, 3.9668877227831364`*^9}, 
   3.987619244832184*^9},
 CellLabel->"In[12]:=",
 CellID->315475521,ExpressionUUID->"40026ca2-ea01-ed43-b3d0-87c2c4ed685e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Free Hamiltonian  ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptCapitalH]", "0"], "=", " ", 
   RowBox[{
    RowBox[{"\[HBar]\[Nu]", 
     SuperscriptBox[
      OverscriptBox["a", "^"], "\[Dagger]"], 
     OverscriptBox["a", "^"]}], "+", 
    RowBox[{
     FractionBox["1", "2"], 
     SubscriptBox["\[HBar]\[Omega]\[Sigma]", "z"]}]}]}]], "InlineFormula",
  ExpressionUUID->"dac96cc6-37e5-8d41-9b40-e47f31cfd2c9"],
 ":"
}], "Text",
 CellChangeTimes->{{3.939728632623377*^9, 3.939728709755678*^9}, 
   3.9397289416733932`*^9},
 CellID->666209288,ExpressionUUID->"ec2d3dc9-7a11-464a-8f72-2c029884783a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H0", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"h", " ", "\[Nu]", " ", 
       RowBox[{
        SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], "+", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", "h", " ", "\[Omega]", " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<Z\>\"", ",", "atomBasis"}], "]"}]}]}], ",", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", "\[Omega]"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.939728736019867*^9, 3.9397287543879604`*^9}, {
  3.966887733540798*^9, 3.96688773768062*^9}},
 CellLabel->"In[15]:=",
 CellID->172501333,ExpressionUUID->"490ecf87-83b4-ec49-bf87-da208f7d2ab9"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Atom-field interaction term ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptCapitalH]", "I"], "=", " ", 
   RowBox[{"\[HBar]g", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Sigma]", "+"], 
       OverscriptBox["a", "^"]}], "+", 
      RowBox[{
       SubscriptBox["\[Sigma]", "-"], 
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"]}]}], ")"}]}]}]], 
  "InlineFormula",ExpressionUUID->"13d2ba28-9bd4-b746-acea-82ca68f8d17c"],
 ":"
}], "Text",
 CellChangeTimes->{{3.939728868169529*^9, 3.9397289392969017`*^9}},
 CellID->257714933,ExpressionUUID->"4a4b96f5-5d1e-a04b-be33-df6a92df3f89"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H1", "=", 
   RowBox[{"h", " ", "g", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Sigma]plus", "@", "a"}], "+", 
      RowBox[{"\[Sigma]minus", "@", 
       SuperscriptBox["a", "\[Dagger]"]}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9397288295148697`*^9, 3.939728836863428*^9}, {
  3.9397289526562557`*^9, 3.9397289728244743`*^9}, {3.9668877451837177`*^9, 
  3.966887758179743*^9}, {3.9780200153318233`*^9, 3.9780200232986507`*^9}, {
  3.9780245635057144`*^9, 3.978024568089224*^9}, {3.9780254783282776`*^9, 
  3.978025480926365*^9}},
 CellLabel->"In[16]:=",
 CellID->450590204,ExpressionUUID->"9ffd08bf-9d8d-c141-98c2-9a391b74ef76"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Going to the interaction picture at resonance, we get a time-independent \
Hamiltonian and from it we get the unitary operator to evolve states:\
\>", "Text",
 CellChangeTimes->{{3.9397289841476936`*^9, 3.939728987658327*^9}, {
  3.9397290193819427`*^9, 3.939729139668396*^9}, {3.987619312641924*^9, 
  3.987619325095949*^9}},
 CellID->4965375,ExpressionUUID->"b5229a7d-1ca5-d649-82b6-6c15467822fe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"HInteract", "=", 
   RowBox[{
    RowBox[{"MatrixExp", "[", 
     RowBox[{"I", " ", 
      RowBox[{"H0", "/", "h"}], " ", "t"}], "]"}], "@", 
    RowBox[{"H1", "@", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{"H0", "/", "h"}], " ", "t"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"U", "=", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{
      RowBox[{"HInteract", "[", 
       RowBox[{"\[Nu]", ",", "\[Nu]"}], "]"}], "/", "h"}], " ", "t"}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9397291629640903`*^9, 3.939729167252676*^9}, {
  3.9668878178690968`*^9, 3.9668878526817036`*^9}, {3.9780201115902424`*^9, 
  3.9780201193363304`*^9}, {3.9780293421366577`*^9, 3.9780293473449364`*^9}},
 CellLabel->"In[17]:=",
 CellID->4525447,ExpressionUUID->"ba0b7117-09c3-c84a-9ebd-634b584489c6"]
}, Open  ]]
}, Open  ]],

