  }]], "3ColumnTableMod",
 CellID->698397110,ExpressionUUID->"4b06bf63-5f43-ed7c-793d-374d5af7b446"],

Cell["Scaling of the representation for ground state", "Subsubsection",
 CellID->1804501477,ExpressionUUID->"0fd1c247-21a4-d962-35ee-e4215056a848"],

Cell["Set the Gaussian scaling parameter to 0.5:", "Text",
 CellID->1282790066,ExpressionUUID->"09347675-9fce-c17b-38cc-683f1a789041"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wig", " ", "=", " ", 
   RowBox[{"WignerRepresentation", "[", 
    RowBox[{
     RowBox[{"FockState", "[", "0", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<GaussianScaling\>\"", " ", "->", " ", "0.5"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[88]:= ",
 CellID->1271105746,ExpressionUUID->"2c597ed5-00d9-d535-5467-779fb16dbc1f"],

Cell["Visualize the result:", "Text",
 CellID->406260488,ExpressionUUID->"66c4d8d6-27c8-a0db-0efb-d1905262f221"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"wig", "[", 
    RowBox[{"x", ",", " ", "p"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", ",", " ", 
     RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", "\n", " ", 
   RowBox[{"ColorFunction", " ", "->", " ", "\"\<Rainbow\>\""}], ",", "\n", 
   " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"PlotPoints", " ", "->", " ", "80"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "200"}]}], "]"}]], "Input",
 CellLabel->"In[89]:= ",
 CellID->1300527012,ExpressionUUID->"4d3801b6-8b23-0df3-74c7-98f02ed657d9"],

Cell["Using GridSize", "Subsubsection",
 CellID->712875671,ExpressionUUID->"09816d05-11e9-fb6e-3fbe-856fa79dc9b4"],

Cell["\<\
Compute the Wigner function value at the origin for the Fock state |2\
\[RightAngleBracket] using a grid size of 140:\
\>", "Text",
 CellID->1019167872,ExpressionUUID->"35ec423d-cde2-7917-6394-6466eb97487d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"wig", " ", "=", " ", 
   RowBox[{"WignerRepresentation", "[", 
    RowBox[{
     RowBox[{"FockState", "[", "2", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<GridSize\>\"", " ", "->", " ", "140"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"wig", "[", 
  RowBox[{"0", ",", " ", "0"}], "]"}]}], "Input",
 CellLabel->"In[90]:= ",
 CellID->433474298,ExpressionUUID->"05e0e9bc-56b1-1bf2-339f-00e6634469d8"],

Cell["\<\
A grid size of 20 is insufficient for this region and yields noticeable \
numerical error:\
\>", "Text",
 CellID->189302667,ExpressionUUID->"46408f14-a324-388b-6e7f-2751d6d68ad1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"wig2", " ", "=", " ", 
   RowBox[{"WignerRepresentation", "[", 
    RowBox[{
     RowBox[{"FockState", "[", "2", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<GridSize\>\"", " ", "->", " ", "20"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"wig2", "[", 
  RowBox[{"0", ",", " ", "0"}], "]"}]}], "Input",
 CellLabel->"In[91]:= ",
 CellID->159437347,ExpressionUUID->"40213c85-9219-7c2b-71de-b5ef27ac4771"],

Cell["The exact value from the analytic expression is:", "Text",
 CellID->693877873,ExpressionUUID->"678faed4-2cca-f411-0db4-479e457cdf7b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"exact", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "\[Pi]"}], " ", 
     RowBox[{"E", "^", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "^", "2"}], " ", "+", " ", 
         RowBox[{"p", "^", "2"}]}], ")"}]}]}], " ", 
     RowBox[{"LaguerreL", "[", 
      RowBox[{"2", ",", " ", 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", "2"}], " ", "+", " ", 
          RowBox[{"p", "^", "2"}]}], ")"}]}]}], "]"}]}], " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", " ", "->", " ", "\n", "     ", 
       RowBox[{"0", " ", "\.08"}]}], ",", " ", 
      RowBox[{"p", " ", "->", " ", "0"}]}], "}"}]}]}], ";"}]], "Input",
 CellLabel->"In[92]:= ",
 CellID->623402222,ExpressionUUID->"3b3cac94-919f-f08d-6ac3-45de202bc2d7"],

Cell["Compare absolute errors:", "Text",
 CellID->834452501,ExpressionUUID->"634a1270-2707-566e-1149-943a52b23cb4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"exact", " ", "-", " ", 
    RowBox[{"wig", "[", 
     RowBox[{"0", ",", " ", "0"}], "]"}]}], ",", " ", 
   RowBox[{"exact", " ", "-", " ", 
    RowBox[{"wig2", "[", 
     RowBox[{"0", ",", " ", "0"}], "]"}]}]}], "}"}]], "Input",
 CellLabel->"In[93]:= ",
 CellID->1916953122,ExpressionUUID->"571f0194-b08e-3ab4-7d24-98d1c138889e"],

Cell["Advanced examples", "Section",
 CellID->960527452,ExpressionUUID->"79764466-e076-5945-2f0e-5e4391032baf"],

Cell["Decay of a coherent state", "Subsection",
 CellID->216876097,ExpressionUUID->"54e8dec7-14b1-519a-7c97-d7a19d4423e0"],

Cell[TextData[{
 "Consider ",
 Cell[BoxData[
  RowBox[{"\[ScriptCapitalH]", "=", "\[ThinSpace]", 
   StyleBox["\[Omega]", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25f5c72f-3423-741a-538a-de89bdd65f60"],
 " with Lindblad jump operator ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["L", "TI"], "1"], "\[ThinSpace]", "=", "\[ThinSpace]", 
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dbbd446-5835-e39a-1b58-ce2059c1b1e0"],
 " (single-photon loss channel), and set ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "\[ThinSpace]", "=", "\[ThinSpace]", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d34e655-b983-17e8-14cb-f81f38367d32"]
}], "Text",
 CellID->1315573129,ExpressionUUID->"5c435daa-0d1c-c5df-0471-54f4a4aeaf25"],

Cell[TextData[{
 "Define the annihilation operator and use a coherent state with ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      StyleBox["\[Alpha]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[ThinSpace]", "=", 
   "\[ThinSpace]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21714cd0-c04e-e57a-570f-659df1f8cc40"],
 " as the initial state:"
}], "Text",
 CellID->857563029,ExpressionUUID->"74ff421b-073b-c6d4-1c85-6445b2cfac3e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", " ", ":=", " ", 
   RowBox[{"AnnihilationOperator", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "15", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Alpha]", " ", "=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{
    RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]", "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[94]:= ",
 CellID->1392409653,ExpressionUUID->"3ebc3a74-dd7c-3fa6-6643-bc31d40e858c"],

Cell["Set the decay rate \[Gamma]:", "Text",
 CellID->1608158347,ExpressionUUID->"7d5c93fe-a057-3a16-2b63-0abbd1e3897c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Gamma]", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[95]:= ",
 CellID->1095708849,ExpressionUUID->"487dadd0-5ed6-7873-7802-449a5b634b59"],

Cell["Define the Hamiltonian including photon loss:", "Text",
 CellID->200935325,ExpressionUUID->"5219761b-8a64-c9ff-0227-68452f169bc5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalH]", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Hamiltonian\>\"", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"SuperDagger", "[", "a", "]"}], "@", "a"}], ",", " ", 
      RowBox[{"{", "a", "}"}], ",", " ", 
      RowBox[{"{", "\[Gamma]", "}"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[96]:= ",
 CellID->1449261142,ExpressionUUID->"69346765-6d1c-e9c9-18cc-7f4f04aebb13"],

Cell["State evolution, we can do it symbolically:", "Text",
 CellID->2143194162,ExpressionUUID->"7c22b8c2-70f4-0562-25d1-31ac00816c48"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]t", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{"\[ScriptCapitalH]", ",", " ", "\[Rho]0", ",", " ", "t"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[97]:= ",
 CellID->972470462,ExpressionUUID->"04fec585-b88c-469b-2c85-dcef39392ce1"],

Cell["Plot the mean photon number as a function of time:", "Text",
 CellID->1402301269,ExpressionUUID->"7aa617d4-4041-969d-2a5d-8e9e71f5fce7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"meanPhotonPlot", " ", "=", " ", "\n", "  ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Chop", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"$FockSize", " ", "-", " ", "1"}]}], "]"}], " ", ".", " ", 
       "\n", "     ", 
       RowBox[{"Diagonal", "[", 
        RowBox[{
         RowBox[{"\[Rho]t", "[", "t", "]"}], "[", "\"\<DensityMatrix\>\"", 
         "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", "\n", "   ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<t\>\"", ",", " ", "\"\<Mean photon number\>\""}], "}"}]}],
      ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", "\n", 
     "   ", 
     RowBox[{"LabelStyle", " ", "->", " ", "10"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "220"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "4"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[98]:= ",
 CellID->2082648425,ExpressionUUID->"5e86e5c8-d785-1389-06bd-fc95e23061d3"],

Cell["Plot the fidelity with respect to the analytic expression:", "Text",
 CellID->2054523427,ExpressionUUID->"3582ea65-851b-2569-63b1-0c4f2caf8fb3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fidelityPlot", " ", "=", " ", "\n", "  ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"QuantumSimilarity", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CoherentState", "[", "]"}], "[", 
        RowBox[{"\[Alpha]", " ", 
         RowBox[{"\\!", 
          RowBox[{"\\(", 
           RowBox[{"TraditionalForm", "\\`", "\n", 
            RowBox[{
             RowBox[{"\\*", 
              RowBox[{"SuperscriptBox", "[", 
               RowBox[{
                RowBox[{"\\(", "E", "\\)"}], ",", " ", 
                RowBox[{"\\(", 
                 RowBox[{
                  RowBox[{"\\(", 
                   RowBox[{"-", "I"}], "\\)"}], "\\", " ", "t"}], "\\)"}]}], 
               "]"}]}], "\\", " ", "\n", 
             RowBox[{"\\*", 
              RowBox[{"SuperscriptBox", "[", 
               RowBox[{
                RowBox[{"\\(", "E", "\\)"}], ",", " ", 
                RowBox[{"\\(", 
                 RowBox[{
                  RowBox[{"\\(", 
                   RowBox[{"-", "\n", 
                    RowBox[{"\\*", 
                    RowBox[{"FractionBox", "[", 
                    RowBox[{
                    RowBox[{"\\(", "1", "\\)"}], ",", " ", 
                    RowBox[{"\\(", "2", "\\)"}]}], "]"}]}]}], "\\)"}], "\\", 
                  " ", "t", "\\", " ", "\[Gamma]"}], "\\)"}]}], "]"}]}]}]}], 
           "\\)"}]}]}], "]"}], ",", " ", 
       RowBox[{"\[Rho]t", "[", "t", "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "\n", "    ", "1"}], "}"}], ",", 
     " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<t\>\"", ",", " ", "\"\<State similarity\>\""}], "}"}]}], ",",
      " ", "\n", "   ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"LabelStyle", " ", "->", " ", "10"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1.1"}], "}"}]}], ",", " ", "\n", "   ", 
     RowBox[{"ImageSize", " ", "->", " ", "220"}]}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[99]:= ",
 CellID->321253538,ExpressionUUID->"5e81d752-d9a7-cf7a-06be-cf1fd8539240"],

Cell["Show the results:", "Text",
 CellID->657760644,ExpressionUUID->"6dc17641-57cc-3497-1bff-682b627e9efd"],

Cell[BoxData[
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{"meanPhotonPlot", ",", " ", "fidelityPlot"}], "}"}], "]"}], ",", 
   " ", "\n", " ", 
   RowBox[{"Style", "[", 
    RowBox[{"\"\<Evolution statistics of a coherent state\>\"", ",", " ", 
     "\n", "  ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Arial\>\""}]}], "]"}], ",", 
   " ", "Top"}], "]"}]], "Input",
 CellLabel->"In[100]:= ",
 CellID->2107872958,ExpressionUUID->"647a9320-5a37-336f-0c19-0a8a5fc381b5"],

Cell["Optical balance", "Subsection",
 CellID->2076944729,ExpressionUUID->"57b40e76-1aa6-da65-7d4b-a0309f50a94f"],

Cell["\<\
Consider the following master equation, which balances a driving field \
Hamiltonian and single-photon loss:\
\>", "Text",
 CellID->2070089908,ExpressionUUID->"575b10e3-003a-b957-7d78-89cdb1cc0bbd"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    StyleBox["d", "TI"], "\[ThinSpace]", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox[
    RowBox[{"d", "t"}], "TI"]], "=", "\[ThinSpace]", "-", 
  StyleBox["i", "TI"], 
  StyleBox["g", "TI"], 
  StyleBox["[",
   SpanMaxSize->1], 
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], ",", 
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "^"]}], 
  StyleBox["]",
   SpanMaxSize->1], "+", 
  FractionBox[
   StyleBox["\[Gamma]", "TI"], "2"], 
  StyleBox["(",
   SpanMaxSize->1], 
  RowBox[{"2", 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "^"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], "-", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "^"], "-", 
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "^"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}], 
  StyleBox[")",
   SpanMaxSize->1]}]], "InlineFormula",
 FontSize->0.9 
  Inherited,ExpressionUUID->"7c7345dd-208f-a284-2401-5c87513bf0ee"]], "Text",
 CellID->1154483336,ExpressionUUID->"0121a537-2575-8479-30de-3d714c01ef43"],

Cell["Set the drive strength g:", "Text",
 CellID->1679674803,ExpressionUUID->"7f325126-465a-e19d-26c2-488073ecb3e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[101]:= ",
 CellID->1050672319,ExpressionUUID->"739af998-c5c1-31b3-21b9-f0c5ec758399"],

Cell["Random initial state:", "Text",
 CellID->257892954,ExpressionUUID->"003becda-d908-4451-31d8-0587d8bd2ebb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<RandomPure\>\"", ",", " ", "$FockSize"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[102]:= ",
 CellID->527652451,ExpressionUUID->"7aeb468a-2cc6-59e2-2ae9-5fd445732bc8"],

Cell["Set up the master equation:", "Text",
 CellID->289997235,ExpressionUUID->"3873a668-04d7-31ac-6800-3832ad6383f6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalH]", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Hamiltonian\>\"", "[", 
     RowBox[{
      RowBox[{"g", " ", 
       RowBox[{"(", 
        RowBox[{"a", " ", "+", " ", 
         RowBox[{"a", "[", "\"\<Dagger\>\"", "]"}]}], ")"}]}], ",", " ", 
      RowBox[{"{", "a", "}"}], ",", " ", 
      RowBox[{"{", "\[Gamma]", "}"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[103]:= ",
 CellID->748159432,ExpressionUUID->"4156c81a-8a68-59d7-776d-e2442f1d2b3d"],

Cell[TextData[{
 "Numerical evolution from ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["i", "TI"]], "=", "0", "\[ThinSpace]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e7ab4-00f8-e339-7ea6-73feb172ce03"],
 " to ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["f", "TI"]], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b3ec616-de69-0141-3ac5-d853db1c53ab"],
 " :"
}], "Text",
 CellID->2003843030,ExpressionUUID->"7c0d57bf-7ae8-3253-2433-4ef97e8280b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]t", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", " ", 
    RowBox[{"\[ScriptCapitalH]", ",", " ", "\[Rho]0", ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[104]:= ",
 CellID->511250849,ExpressionUUID->"0aaecb0d-dff0-cd78-3a55-e356d98a9442"],

Cell[TextData[{
 "Steady state solution is a coherent state with amplitude ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[ThinSpace]", "=", "\[ThinSpace]", "-", "2", 
   
   StyleBox["i", "TI"], "\[ThinSpace]", 
   StyleBox["g", "TI"], "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fe4a286-576e-fd11-759b-3be06218c47b"],
 " via phase-space integration:"
}], "Text",
 CellID->1610110264,ExpressionUUID->"07179650-9fbb-2bc1-2d2c-081a1a4e792b"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"QuantumSimilarity", "[", 
    RowBox[{
     RowBox[{"\[Rho]t", "[", "t", "]"}], ",", " ", "\n", "  ", 
     RowBox[{
      RowBox[{"CoherentState", "[", "]"}], "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", "2", " ", 
       RowBox[{"g", "/", "\[Gamma]"}]}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", " ", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", " ", "\n", 
    "  ", "\"\<Convergence to a coherent state |-2\[ImaginaryI]G/\[Gamma]\
\[RightAngleBracket]\>\""}], ",", " ", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Time(t)\>\"", ",", " ", "\"\<Fidelity\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]], "Input",
 CellLabel->"In[105]:= ",
 CellID->705810229,ExpressionUUID->"7aecd320-e31f-2936-2a93-ca8d96aa781c"],

Cell[TextData[{
 "For the initial state ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["\[Rho]", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "326b0854-5043-0b63-6268-a21e61f65649"],
 "(0) = |0\[RightAngleBracket] \[LeftAngleBracket]0|, the system evolves to \
the coherent state ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{"-", 
       StyleBox["i", "TI"], 
       StyleBox["g", "TI"], 
       StyleBox["t", "TI"]}]},
    "Ket"], 
   TemplateBox[{
     RowBox[{"-", 
       StyleBox["i", "TI"], 
       StyleBox["g", "TI"], 
       StyleBox["t", "TI"]}]},
    "Bra"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d6edc53-4ce5-e0f2-4b15-d61d6491b2d8"],
 " for short times; the complex amplitude is independent of \[Gamma]."
}], "Text",
 CellID->1868441620,ExpressionUUID->"45f7e4e6-4e1c-a184-738c-fdc06baef3ee"],

Cell["Initial state:", "Text",
 CellID->41163462,ExpressionUUID->"70e98525-204e-6ba4-2096-1c8f51fb398e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<0\>\"", ",", " ", "$FockSize"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[106]:= ",
 CellID->88890771,ExpressionUUID->"704169dd-a4db-5005-207e-8086cd6e236f"],

Cell["Evolved state:", "Text",
 CellID->1580934692,ExpressionUUID->"7b2d1c14-5aff-cd5f-2ad2-965e5e8b97a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]t", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{"\[ScriptCapitalH]", ",", " ", "\[Rho]0", ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[107]:= ",
 CellID->1619475837,ExpressionUUID->"62ac11c1-6d0b-a8c0-1253-88ab04bffa2a"],

Cell["Photon number expectations and fidelity:", "Text",
 CellID->282409467,ExpressionUUID->"2e7621e1-2fba-a33a-560d-b8cb4a4c0e00"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"time", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", "0.8", ",", " ", "0.02"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qs", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumSimilarity", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CoherentState", "[", "]"}], "[", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "g", " ", "#"}], "]"}], ",", " ", 
       RowBox[{"\[Rho]t", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@", 
    " ", "time"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"meanN", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Chop", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"$FockSize", " ", "-", " ", "1"}]}], "]"}], " ", ".", " ", 
       "\n", "      ", 
       RowBox[{"Diagonal", "[", 
        RowBox[{
         RowBox[{"\[Rho]t", "[", "#", "]"}], "[", "\"\<DensityMatrix\>\"", 
         "]"}], "]"}]}], "]"}], " ", "&"}], " ", "/@", " ", "time"}]}], " ", 
  ";"}]}], "Input",
 CellLabel->"In[108]:= ",
 CellID->109109752,ExpressionUUID->"15938457-0322-a4d9-43a0-1e11b6d40e23"],

Cell["Plot both quantities versus time:", "Text",
 CellID->584489562,ExpressionUUID->"7f1ed2e3-b722-4b37-2525-cbccc2d7161d"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{"time", ",", " ", "qs"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{"time", ",", " ", "meanN"}], "}"}], "]"}]}], "}"}], ",", " ", 
   "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.1"}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<t (Time)\>\"", ",", " ", "\"\<\>\""}], "}"}]}], ",", " ", 
   "\n", " ", 
   RowBox[{"LabelStyle", " ", "->", " ", "10"}], ",", " ", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Fidelity\>\"", ",", " ", "\"\<Mean number of photons\>\""}],
      "}"}]}], ",", " ", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", " ", "\"\<Optical balance for short times\>\""}], ",",
    " ", 
   RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]], "Input",
 CellLabel->"In[109]:= ",
 CellID->581169661,ExpressionUUID->"52e63e44-9d5c-26a1-029d-b02e14ee8c8b"],

Cell["Jaynes-Cummings Model: Calculating the unitary", "Subsection",
 CellID->2057728315,ExpressionUUID->"6e766a94-5ec6-6187-160d-83de5b7333ed"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", "g", "]"}]], "Input",
 CellLabel->"In[110]:= ",
 CellID->930077504,ExpressionUUID->"2eead67c-41e5-1519-56e9-c82677907c63"],

Cell["Define the basis and the relevant operators:", "Text",
 CellID->595943781,ExpressionUUID->"23a655ec-dad2-e192-515e-4cc9df64b3f8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "32", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"atomBasis", " ", "=", " ", 
   RowBox[{"QuantumBasis", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<e\>\"", ",", " ", "\"\<g\>\""}], "}"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[111]:= ",
 CellID->1764185489,ExpressionUUID->"62ef85cc-c62f-39ac-1294-1ca9f3db8bf6"],

Cell["\<\
Define the atomic operators and the annihilation operator in second mode:\
\>", "Text",
 CellID->1087423328,ExpressionUUID->"7d6c313b-6800-4a9b-2b13-a96509b518e1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Sigma]plus", " ", "=", "  ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<+\>\"", ",", " ", "atomBasis"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]minus", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<-\>\"", ",", " ", "atomBasis"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a", " ", ":=", " ", 
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"{", "2", "}"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[112]:= ",
 CellID->1788590141,ExpressionUUID->"75dfb56b-bb47-a02b-23e4-2d353ef3f371"],

Cell[TextData[{
 "Free Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptCapitalH]", "0"], "=", "\[ThinSpace]", "\[HBar]", 
   StyleBox["\[Nu]", "TI"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "+", 
   FractionBox["1", "2"], "\[HBar]", 
   StyleBox["\[Omega]", "TI"], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57533ce7-69d6-be0e-7d60-b5c108600554"],
 ":"
}], "Text",
 CellID->450467926,ExpressionUUID->"27c3fefb-2ee6-8038-4df0-f7a54a90d302"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H0", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"h", " ", "\[Nu]", " ", 
       RowBox[{
        RowBox[{"SuperDagger", "[", "a", "]"}], "@", "a"}]}], " ", "+", " ", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", "h", " ", "\[Omega]", " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<Z\>\"", ",", " ", "atomBasis"}], "]"}]}]}], ",", " ", 
     "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", " ", "\[Omega]"}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[113]:= ",
 CellID->1641630741,ExpressionUUID->"60d4995f-bb7f-b80c-10eb-11193e0b0b56"],

Cell[TextData[{
 "Atom-field interaction term ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptCapitalH]", 
    StyleBox["I", "TI"]], "=", "\[ThinSpace]", "\[HBar]", 
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], "+"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], "-"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64608bbe-760c-8af3-0c1f-22f803bed8d9"],
 ":"
}], "Text",
 CellID->1739676204,ExpressionUUID->"09661063-a2cf-675e-3f1d-8a4cd77a4da4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H1", " ", "=", " ", 
   RowBox[{"h", " ", "g", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Sigma]plus", "@", "a"}], " ", "+", " ", 
      RowBox[{"\[Sigma]minus", "@", 
       RowBox[{"SuperDagger", "[", "a", "]"}]}]}], ")"}]}]}], ";"}]], "Input",\

 CellLabel->"In[114]:= ",
 CellID->406456496,ExpressionUUID->"5561d787-26b0-8d0a-031e-cee1534ad450"],

Cell["\<\
Going to the interaction picture at resonance, we get a time-independent \
Hamiltonian and from it we get the unitary operator to evolve states:\
\>", "Text",
 CellID->631730329,ExpressionUUID->"0fea91e8-e80e-a1ed-35e9-08b589b8f337"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"HInteract", " ", "=", " ", 
   RowBox[{
    RowBox[{"MatrixExp", "[", 
     RowBox[{"I", " ", 
      RowBox[{"H0", "/", "h"}], " ", "t"}], "]"}], "@", 
    RowBox[{"H1", "@", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{"H0", "/", "h"}], " ", "t"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"U", " ", "=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{
      RowBox[{"HInteract", "[", 
       RowBox[{"\[Nu]", ",", " ", "\[Nu]"}], "]"}], "/", "h"}], " ", "t"}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[115]:= ",
 CellID->1951413411,ExpressionUUID->"37725419-c8bf-c4cd-5d02-4e42e94bae17"],

Cell["Jaynes-Cummings Model: Evolving states", "Subsection",
 CellID->1419737149,ExpressionUUID->"6eee5857-8f9d-bf63-1696-52112a290249"],

Cell["Field in a Fock State", "Subsubsection",
 CellID->1515856909,ExpressionUUID->"2635f536-2fc9-ab3c-4fca-ed704a7df606"],

Cell["\<\
Rabi oscillations when the field is initially in a Fock state\
\>", "Text",
 CellID->2130236311,ExpressionUUID->"1b3760e9-4a32-92b2-4acd-79b36fc4e098"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Psi]0", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<1\>\"", ",", " ", "atomBasis"}], "]"}], ",", " ", 
     RowBox[{"FockState", "[", "1", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"\[Psi]t", " ", "=", " ", 
  RowBox[{"U", " ", "@", " ", "\[Psi]0"}]}]}], "Input",
 CellLabel->"In[116]:= ",
 CellID->66223118,ExpressionUUID->"14fe93a8-4ee9-5b9e-3c85-0af26a9c29e4"],

Cell["\<\
Find the probability of the atom being in the excited state, using the \
projector as a measurement operator:\
\>", "Text",
 CellID->1801397453,ExpressionUUID->"11cf5d11-52cc-ddbb-47f5-555b677ea781"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"proj", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"\"\<0\>\"", ",", " ", "atomBasis"}], "]"}], 
    "[", "\"\<Operator\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"probE", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"QuantumMeasurementOperator", "[", "proj", "]"}], "@", " ", 
      "\[Psi]t"}], ")"}], "[", "\"\<Mean\>\"", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[117]:= ",
 CellID->658220090,ExpressionUUID->"7ba8138a-66ce-478c-2957-8ad4137b2dd6"],

Cell["Plot the result:", "Text",
 CellID->250791599,ExpressionUUID->"35c9e6d4-f3c4-84c1-63f6-ff918676ee2b"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"probE", " ", "/.", " ", 
    RowBox[{"g", " ", "->", " ", "1"}]}], " ", ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", 
     RowBox[{"3", " ", "\[Pi]"}]}], "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<T\>\"", ",", " ", "\"\<Probability\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"LabelStyle", " ", "->", " ", "10"}], ",", " ", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", " ", "\"\<Resonant Rabi oscillations\>\""}], ",", 
   " ", 
   RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]], "Input",
 CellLabel->"In[118]:= ",
 CellID->726989337,ExpressionUUID->"6fd66644-13e4-6fa7-15ee-782ea591358d"],

Cell["\<\
Calculate the evolution for the states |g\[RightAngleBracket] \[CircleTimes] \
|n\[RightAngleBracket], varying the number state n:\
\>", "Text",
 CellID->551803451,ExpressionUUID->"00abf1cf-696b-3507-30a8-e8a9081f9c6d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TableForm", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"s", " ", "=", " ", "\n", "    ", 
        RowBox[{"QuantumTensorProduct", "[", 
         RowBox[{
          RowBox[{"QuantumState", "[", 
           RowBox[{"\"\<1\>\"", ",", " ", "atomBasis"}], "]"}], ",", " ", 
          "\n", "     ", 
          RowBox[{"FockState", "[", "x", "]"}]}], "]"}]}], ";", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"s", "[", "\"\<Formula\>\"", "]"}], ",", " ", 
         RowBox[{"U", "@", "s"}]}], "}"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", " ", "10"}], "}"}]}], "]"}], ",", " ",
     "\n", "  ", 
    RowBox[{"TableHeadings", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"None", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Initial State\>\"", ",", " ", "\n", 
         "     ", "\"\<Evolved State\>\""}], "}"}]}], "}"}]}]}], "]"}], " ", "//",
   " ", "TraditionalForm"}]], "Input",
 CellLabel->"In[119]:= ",
 CellID->1081615051,ExpressionUUID->"03d898fe-d35a-9eef-31e7-11bbe6ece435"],

Cell["Coherent state: Collapse and revivals", "Subsubsection",
 CellID->869645169,ExpressionUUID->"03dda600-4b0b-c3af-31e2-386a6ebf91f5"],

Cell[TextData[{
 "Define the initial state ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], "0"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["\[Alpha]", "TI"]},
      "Ket"], 
     StyleBox["w", "TI"], 
     StyleBox["i", "TI"], 
     StyleBox["t", "TI"], 
     StyleBox["h", "TI"], GridBox[{
       {
        StyleBox["\[Alpha]", "TI"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}]}], "=", "4"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4de38b79-ee67-8bee-7b90-23228b13d934"],
 " and evolve it (we use a random \[Alpha]):"
}], "Text",
 CellID->1303418848,ExpressionUUID->"347cf1ed-0cc4-b4dc-5c03-e8b7a5761e26"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Alpha]", " ", "=", " ", 
   RowBox[{"4", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"2", " ", "\[Pi]"}]}], "}"}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Psi]0", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<1\>\"", ",", " ", "atomBasis"}], "]"}], ",", " ", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]", "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Psi]t", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"U", " ", "@", " ", "\[Psi]0"}], ",", " ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"g", ",", " ", "t"}], "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[120]:= ",
 CellID->1706305219,ExpressionUUID->"7d81b9ce-3a4c-aa2a-2bbe-30a8bffef970"],

Cell[TextData[{
 "Extracting the coefficients ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["e", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bb9b374-9caf-337d-1946-2b3e155b9e47"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["g", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c340229-13f4-0181-15cb-a473a58153eb"],
 " for all n as a function of time:"
}], "Text",
 CellID->1545518015,ExpressionUUID->"25dfa134-0866-9bb5-53e4-397ea910e99f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cet", "[", "t_", "]"}], ",", " ", 
     RowBox[{"cgt", "[", "t_", "]"}]}], "}"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"#", "[", "\"\<Dagger\>\"", "]"}], "@", 
        RowBox[{"\[Psi]t", "[", 
         RowBox[{"1", ",", " ", "t"}], "]"}]}], ")"}], 
      "[", "\"\<AmplitudesList\>\"", "]"}], " ", "&"}], " ", "/@", " ", "\n", 
    "   ", 
    RowBox[{"atomBasis", "[", "\"\<BasisStates\>\"", "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[121]:= ",
 CellID->481786650,ExpressionUUID->"425139cc-45a5-cefb-726e-b0966c5194c1"],

Cell[TextData[{
 "Plotting the population inversion ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["W", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"\[ThinSpace]", 
       StyleBox["n", "TI"], "\[ThinSpace]"}],
      LimitsPositioning->False], 
     SuperscriptBox[GridBox[{
        {
         RowBox[{
          SubscriptBox[
           StyleBox["c", "TI"], 
           RowBox[{
            StyleBox["e", "TI"], ",", 
            StyleBox["n", "TI"]}]], 
          StyleBox["(",
           SpanMaxSize->1], 
          StyleBox["t", "TI"], 
          StyleBox[")",
           SpanMaxSize->1]}]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], "-", 
    SuperscriptBox[GridBox[{
       {
        RowBox[{
         SubscriptBox[
          StyleBox["c", "TI"], 
          RowBox[{
           StyleBox["g", "TI"], ",", 
           StyleBox["n", "TI"]}]], 
         StyleBox["(",
          SpanMaxSize->1], 
         StyleBox["t", "TI"], 
         StyleBox[")",
          SpanMaxSize->1]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d922994-f334-45bb-7ba1-c0d186c12f81"]
}], "Text",
 CellID->1253594352,ExpressionUUID->"06c25578-1780-b25e-2ef2-4d22a23a00a4"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
