Cell["\<\
We see the steady state resembles a coherent state up to distortion that \
depends of the parameters, it is known that evolution in Kerr nonlinear \
oscillators can produce coherent state manifold convergence\
\>", "Text",
 CellChangeTimes->{{3.9876946593008842`*^9, 3.9876947165355434`*^9}, {
  3.987694750515938*^9, 3.9876947781845093`*^9}},
 CellID->514780717,ExpressionUUID->"c65b6eea-eace-5949-b063-065dc5c7dc44"],

Cell[CellGroupData[{

Cell[TextData[{
 "Set up a numerical function for comparing the fidelity of the evolved state \
at ",
 Cell[BoxData[
  SubscriptBox["t", "f"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "be9cdbff-940d-d54b-9cde-f100b61e9696"],
 " and a coherent state:"
}], "Text",
 CellChangeTimes->{{3.9876942228380547`*^9, 3.987694266123705*^9}, {
  3.987694643630415*^9, 3.9876946475432777`*^9}},
 CellID->99803548,ExpressionUUID->"233298e8-abda-ca4c-8ff8-2794cf07c565"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"QuantumSimilarity", "[", 
   RowBox[{
    RowBox[{"evolved", "[", "15", "]"}], ",", 
    RowBox[{
     RowBox[{"CoherentState", "[", "]"}], "[", "x", "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9876887202109413`*^9, 3.987688729314516*^9}, {
   3.987688852854002*^9, 3.98768885309894*^9}, {3.987689050837475*^9, 
   3.9876891169092884`*^9}, {3.9876891620583305`*^9, 3.987689178299429*^9}, {
   3.9876897864809093`*^9, 3.9876898065036755`*^9}, {3.9876898848663063`*^9, 
   3.9876898858026752`*^9}, 3.9876899361525497`*^9},
 CellLabel->"In[342]:=",
 CellID->477176347,ExpressionUUID->"51391234-4ee6-ff41-8820-dd4b80261721"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Look for a coherent state that maximizes the fidelity with ",
 Cell[BoxData[
  RowBox[{"\[Alpha]", " ", "=", 
   RowBox[{"x", "+", 
    RowBox[{"\[ImaginaryI]", " ", "y"}]}]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "4c127653-2c82-c34b-b2f6-96ad01347c2a"],
 ", we limit the region from ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", "4"}], "\[LessEqual]"}], "|", "\[Alpha]", "|", 
   RowBox[{"\[LessEqual]", "1"}]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "4a85920f-bc18-314b-b5d4-566793d8cce0"],
 ":"
}], "Text",
 CellChangeTimes->{{3.987694840685423*^9, 3.987694848147251*^9}, {
  3.987694883658989*^9, 3.987694912517851*^9}, {3.987695149948984*^9, 
  3.9876951961822376`*^9}},
 CellID->288299928,ExpressionUUID->"9bc09117-66d7-3f4c-bb04-ba6d942b6cb3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", " ", "=", " ", 
  RowBox[{"NMaximize", "[", 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"x", "+", 
      RowBox[{"\[ImaginaryI]", "  ", "y"}]}], "]"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], "\[Element]", 
     RowBox[{"Annulus", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", "4"], ",", "1"}], "}"}]}], "]"}]}], ",", 
    RowBox[{"Method", "->", "\"\<SimulatedAnnealing\>\""}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9876891849953423`*^9, 3.9876892638691883`*^9}, {
   3.9876893166597977`*^9, 3.987689317502239*^9}, {3.9876893743225555`*^9, 
   3.9876893770414696`*^9}, {3.987689458707512*^9, 3.9876894639180775`*^9}, 
   3.9876895734810295`*^9, {3.9876896423595467`*^9, 3.987689693410578*^9}, {
   3.987689858042742*^9, 3.987689861642967*^9}, {3.9876899557057686`*^9, 
   3.9876899900514145`*^9}, {3.9876936379630623`*^9, 
   3.9876936394393997`*^9}, {3.9876940455847054`*^9, 3.9876940466348724`*^9}},
 CellLabel->"In[353]:=",
 CellID->177136219,ExpressionUUID->"b18cff24-3a3d-7f4b-b0e5-be74aeb8c0da"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.8582964662043396`", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "0.5744996988033755`"}], ",", 
     RowBox[{"y", "\[Rule]", 
      RowBox[{"-", "0.07221018542963574`"}]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.987689290814619*^9, 3.987689365744871*^9, 3.987689479327896*^9, 
   3.987689593189228*^9, {3.987689659833153*^9, 3.9876896868948536`*^9}, 
   3.987689802802105*^9, 3.987689919650305*^9, 3.987689982956026*^9, 
   3.9876901011585865`*^9, 3.987693451438196*^9, 3.987694063400839*^9, 
   3.9876948151791687`*^9},
 CellLabel->"Out[353]=",
 CellID->708297450,ExpressionUUID->"2a3f86a1-50b9-a643-9936-acc3bee7a87a"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Following a semi-classical approach such the parameters are in the \
stability regime the coherent state amplitude of convergence can be derived \
as ",
 Cell[BoxData[
  RowBox[{"\[Alpha]", " ", "=", " ", 
   FractionBox["\[CurlyEpsilon]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", " ", "-", " ", "K"}], " ", "|", "\[Alpha]", 
       SuperscriptBox["|", "2"]}], ")"}], "+", 
     RowBox[{"\[ImaginaryI]", " ", 
      FractionBox["\[Kappa]", "2"]}]}]]}]], "InlineFormula",
  FormatType->StandardForm,
  FontSize->14,ExpressionUUID->"cea7167d-d923-4641-ac27-ba768c28cf8b"]
}], "Text",
