Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"QuantumMeasurementOperator", "[", 
     RowBox[{
      SuperscriptBox["a", "\[Dagger]"], "@", "a"}], "]"}], "[", "\[Psi]", 
    "]"}], ")"}], "[", "\"\<Mean\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.93929402581485*^9, 3.9392940730226135`*^9}, {
  3.979331259499948*^9, 3.979331300258442*^9}, {3.9793313439158163`*^9, 
  3.979331344174322*^9}},
