     RowBox[{#, ",", 
       RowBox[{"Placed", "[", 
         RowBox[{#2, ",", "After"}], "]"}]}], "]"}]& )]], "Output",
 CellChangeTimes->{{3.9876779188132744`*^9, 3.987677928168356*^9}, 
   3.9876782454984245`*^9, 3.9876783499613285`*^9, {3.987678498055704*^9, 
   3.987678515395151*^9}, 3.9876786022873*^9, 3.987678655646206*^9, {
   3.987678787382078*^9, 3.9876788056099377`*^9}, {3.987678875476755*^9, 
   3.9876789191881695`*^9}, {3.987680162273821*^9, 3.987680190765091*^9}},
