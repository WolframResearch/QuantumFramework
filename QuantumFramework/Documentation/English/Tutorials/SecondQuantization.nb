Cell[CellGroupData[{

Cell["\<\
Phase shift operator coincides with the \"Z\" gate for qudits when the angle \
is 2\[Pi]/n (up to conjugation):\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9668906129953785`*^9, 3.9668906841310463`*^9}},
 CellID->177819261,ExpressionUUID->"7f84c992-a05d-7241-915a-bb8728bd5920"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", "=", 
     RowBox[{"RandomInteger", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"$FockSize", "-", "1"}]}], "}"}], "]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"PhaseShiftOperator", "[", 
     RowBox[{
      RowBox[{"2", 
       RowBox[{"\[Pi]", "/", "n"}]}], ",", "n"}], "]"}], "==", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Z\>\"", "[", "n", "]"}], "]"}], "[", "\"\<Conjugate\>\"", 
     "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9668903291552258`*^9, 3.966890346888788*^9}, {
  3.9668903934980183`*^9, 3.966890395472021*^9}, {3.966890431785532*^9, 
