 CellLabel->"In[80]:= ",
 CellID->1739470850,ExpressionUUID->"5b84d4d6-858d-5842-09bb-cd902c382aa8"],

Cell[TextData[{
 "Compute the expectation value ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["x", "TI"], "4"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67558936-e5eb-8680-0d6a-2173939fecea"],
 ", for a purely position operator ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["x", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1072dc7c-f7d5-c74e-4001-d6398261ad94"],
 " its Weyl symbol is ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["x", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3462f0a3-098c-f6b3-5c11-e90da83edc99"],
 ", hence the expectation value is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], "\[ThinSpace]", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["x", "TI"], "4"], 
   SubscriptBox[
    StyleBox["W", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04cac1af-436c-9192-2cc9-d809761ee3f8"],
 ":"
}], "Text",
 CellID->1570208593,ExpressionUUID->"63be94f2-239e-9b81-1145-0dbc5628e9eb"],

Cell[BoxData[
 RowBox[{"NIntegrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "^", "4"}], " ", 
    RowBox[{"wig", "[", 
     RowBox[{"x", ",", " ", "p"}], "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", ",", " ", 
     RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", "\n", " ", 
   RowBox[{"Method", " ", "->", " ", "\"\<MultiPeriodic\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[81]:= ",
 CellID->1989834147,ExpressionUUID->"5a3d7a71-218e-1995-0bc3-7c3b503b6bff"],

