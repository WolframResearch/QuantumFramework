Cell[CellGroupData[{

Cell["The exact value from the analytic expression is:", "Text",
 CellChangeTimes->{{3.951582950260399*^9, 3.9515829768350334`*^9}},
 CellID->301773101,ExpressionUUID->"3e4b4311-6b3c-f14b-bee4-df1d35a3b0a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"exact", " ", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "\[Pi]"], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["x", "2"], "+", 
         SuperscriptBox["p", "2"]}], ")"}]}]], 
     RowBox[{"LaguerreL", "[", 
      RowBox[{"2", ",", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["x", "2"], "+", 
          SuperscriptBox["p", "2"]}], ")"}]}]}], "]"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "->", 
       RowBox[{"0", "\.08"}]}], ",", 
      RowBox[{"p", "->", "0"}]}], "}"}]}]}], ";"}]], "Input",
