Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Psi]0", " ", "=", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<1\>\"", ",", " ", "atomBasis"}], "]"}], ",", " ", 
     RowBox[{"FockState", "[", "1", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Psi]t", " ", "=", " ", 
  RowBox[{"U", " ", "@", " ", "\[Psi]0"}]}]}], "Input",
