Cell[CellGroupData[{

Cell[TextData[StyleBox["Mode Order (Multimode Systems)", "Subsection"]], \
"Subsection",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.987616528446228*^9, 3.9876165287713604`*^9}},
 CellID->50172528,ExpressionUUID->"3a54d0c2-507a-4690-8a71-31cf2a60dfda"],

Cell[TextData[{
 "Many operators accept an optional ",
 StyleBox["order",
  FontSlant->"Italic"],
 " parameter that specifies which mode(s) the operator acts on in a multimode \
system. The order is a list of positive integers.\n\[Bullet] Default: ",
 Cell[BoxData[
  RowBox[{"{", "1", "}"}]],ExpressionUUID->
  "ad9b669c-3d0d-4e2b-962c-33a6b02d5b26"],
 " (single mode, acts on mode 1)\n\[Bullet] Two modes: ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", "2"}], "}"}]],ExpressionUUID->
  "b0a505b2-7902-4131-977e-0d082595c399"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "3"}], "}"}]],ExpressionUUID->
  "97d8682c-b36e-4893-ad08-94187f90c7d4"],
 " etc.\nThe order parameter is essential for:\n\[Bullet] Creating operators \
that act on specific modes in a tensor-product space.\n\[Bullet] Building \
multimode quantum circuits (e.g., beam splitters coupling modes 1 and 2)."
}], "Text",
 CellChangeTimes->{{3.9793029574915123`*^9, 3.979302967622472*^9}},
 CellID->195531493,ExpressionUUID->"9f63db8a-e8c6-43ec-b39d-c1f36e7001fb"],

Cell[CellGroupData[{

Cell["Single-mode operator with explicit order:", "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellID->195531494,ExpressionUUID->"4f00d872-863f-450c-a8fa-260d4d256150"],

