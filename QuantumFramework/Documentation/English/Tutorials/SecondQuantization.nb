Cell[BoxData[{
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "32", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"atomBasis", " ", "=", " ", 
   RowBox[{"QuantumBasis", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<e\>\"", ",", "\"\<g\>\""}], "}"}], "]"}]}], ";"}]}], "Input",
