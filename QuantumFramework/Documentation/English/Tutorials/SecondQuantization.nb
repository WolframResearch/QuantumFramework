Cell[CellGroupData[{

Cell["Ordering option", "Subsection",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.966880335629883*^9, 3.966880339095581*^9}},
 CellID->19700798,ExpressionUUID->"9ec94a94-bc6f-a74c-b2fa-b44fb6957ddf"],

Cell["\<\
Displacement and squeeze operators can be defined with different orderings. \
Use the \"Ordering\" option to choose \"Weak\", \"Normal\", or \
\"Antinormal\". In the infinite-dimensional limit these are equivalent, but \
in a truncated space the numerical error depends on the ordering, so one \
choice may be more accurate for a given calculation.\
\>", "Text",
 CellID->552576173,ExpressionUUID->"97fa2c3f-f758-5146-a2b0-2fafb13958fe"],

Cell[CellGroupData[{

Cell[TextData[{
 "Check unitarity of the displacement operator using \"UnitaryQ\" for ",
 Cell[BoxData[
  RowBox[{"\[Alpha]", " ", "=", " ", 
   RowBox[{"0.5", "+", "\[ImaginaryI]"}]}]], "InlineFormula",ExpressionUUID->
  "8be5788e-8dd5-ba4d-8339-51ad0517abaf"],
 ". For this case, weak ordering gives the expected result:"
}], "Text",
 CellChangeTimes->{{3.934935753147475*^9, 3.934935759869097*^9}, {
   3.934935791246628*^9, 3.934935800686924*^9}, {3.9349359524628887`*^9, 
   3.934935975437401*^9}, {3.934936038387163*^9, 3.934936043293417*^9}, 
   3.978002760737961*^9, {3.978002875613247*^9, 3.9780028768789597`*^9}, {
   3.9876168594656067`*^9, 3.9876168614108906`*^9}, {3.9876168937879353`*^9, 
   3.9876168995187416`*^9}},
 CellID->502478918,ExpressionUUID->"4c701373-858d-3240-85b8-8f3ea92e603a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DisplacementOperator", "[", 
   RowBox[{"0.5", "+", "\[ImaginaryI]"}], "]"}], "[", "\"\<UnitaryQ\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{3.934935773887255*^9, 3.934935807720991*^9}, 
   3.978002778003456*^9, {3.978002879721628*^9, 3.9780028815933056`*^9}},
 CellLabel->"In[41]:=",
 CellID->98998397,ExpressionUUID->"7fcad597-b345-d146-a82d-caa524d8dd42"],

