     "06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"], Cell[TextData[Cell[BoxData[
    "QuadratureOperators"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "12d95fcb-3316-2212-42e7-569546a37178"]], "TableText",ExpressionUUID->
     "733995c2-f5bf-78ee-22c6-0caffc4a4a34"], Cell[TextData[{
     Cell[BoxData[
      SubscriptBox[
       StyleBox["X", "TI"], "1"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4f8ab258-7e7f-0723-7589-34027b0a6a09"],
     ":",
     Cell[BoxData[
      RowBox[{"1", "/", "2"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6b12ee74-9953-131d-1921-003e18e67e67"],
     "(a+",
     Cell[BoxData[
      SuperscriptBox[
       StyleBox["a", "TI"], "\[Dagger]"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "65262d3c-fccc-1dc6-0cdd-c579f579672c"],
     ") ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["X", "TI"], "2"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5e157ee2-48da-d240-062b-77cc696ca0aa"],
     ":",
     Cell[BoxData[
      RowBox[{"1", "/", "2", "\[ThinSpace]", 
       StyleBox["i", "TI"]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "78287f93-0f12-7c52-2828-76ddaaa746b8"],
     "(a-",
     Cell[BoxData[
      SuperscriptBox[
       StyleBox["a", "TI"], "\[Dagger]"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "08285353-0e0e-39f8-3828-4b1dabb88bc2"],
     ")"
    }], "TableText",ExpressionUUID->"1daed7d3-93e8-7698-4b55-ce9d259d5ce2"]}
  }]], "2ColumnTableMod",
 CellID->1002769646,ExpressionUUID->"187adc3d-3961-76c2-4819-d667b8145c28"],

Cell["Displacement operator ordering", "Subsubsection",
 CellID->436346740,ExpressionUUID->"641c78eb-7f03-7846-0c24-71b57ab64aac"],

Cell["\<\
By default, when \"Ordering\" is not specified, normal ordering is used. The \
formulas for the three orderings are shown below:\
\>", "Text",
 CellID->2122865143,ExpressionUUID->"5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "112ae6ec-4b5c-6ad2-4729-ffb66ee93838"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"6121b9de-dddd-aca8-10de-309bd469f6f2"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"30209679-023a-ee91-61df-0823b7ccb4fb"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "29bc1606-c22d-409d-5f43-8863f7d812e7"], Cell[TextData[{
     Cell[BoxData["DisplacementOperator"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],
     "[..,\"Ordering\"->",
     StyleBox["st", "TI"],
     "]"
    }], "TableText",ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"], 
    Cell[TextData[{
     StyleBox["st", "TI"],
     " can be \"Normal\", \"Weak\" or \"Antinormal\". For \"Normal\", one \
gets $e^{-"
    }], "TableText",ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"]}
  }]], "2ColumnTableMod",
 CellID->1735808809,ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],

Cell["Squeeze operator ordering", "Subsubsection",
 CellID->753514147,ExpressionUUID->"51fce014-dca1-0630-0783-fa51d5546d1a"],

Cell["\<\
By default, when \"Ordering\" is not specified, normal ordering is used. The \
formulas for the three orderings are shown below:\
\>", "Text",
 CellID->1164297175,ExpressionUUID->"657c1c65-980e-511d-1303-964f19bb2067"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"], Cell[TextData[{
     Cell[BoxData["SqueezeOperator"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "370294fd-9e49-2d35-5d31-0da71bfc741f"],
     "[\[Ellipsis],\"Ordering\"->",
     StyleBox["st", "TI"],
     "]"
    }], "TableText",ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"], 
    Cell[TextData[{
     StyleBox["st", "TI"],
     " can be \"Normal\", \"Antinormal\" or \"Weak\". Given ",
     Cell[BoxData[
      RowBox[{
       StyleBox["\[Xi]", "TI"], "=", 
       StyleBox["r", "TI"], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox[
         RowBox[{"i", "\[Theta]"}], "TI"]]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7519012f-e657-215b-2326-988893e273a1"],
     ", for \"Normal\", one gets ",
     Cell[BoxData[
      RowBox[{
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
         FractionBox["1", "2"], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox[
           RowBox[{"i", "\[Theta]"}], "TI"]], 
         StyleBox["tanh",
          FontSlant->"Plain"], "\[ThinSpace]", 
         StyleBox["r", "TI"], "\[ThinSpace]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          RowBox[{"\[Dagger]", "2"}]]}]], "\[ThinSpace]", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
         StyleBox["ln",
          FontSlant->"Plain"], "\[ThinSpace]", 
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{
          StyleBox["cosh",
           FontSlant->"Plain"], "\[ThinSpace]", 
          StyleBox["r", "TI"]}], 
         StyleBox[")",
          SpanMaxSize->1], "\[ThinSpace]", 
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{
          SuperscriptBox[
           StyleBox["a", "TI"], "\[Dagger]"], 
          StyleBox["a", "TI"], "+", 
          FractionBox["1", "2"]}], 
         StyleBox[")",
          SpanMaxSize->1]}]], "\[ThinSpace]", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{
         FractionBox["1", "2"], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
           StyleBox["i", "TI"], 
           StyleBox["\[Theta]", "TI"]}]], 
         StyleBox["tanh",
          FontSlant->"Plain"], "\[ThinSpace]", 
         StyleBox["r", "TI"], "\[ThinSpace]", 
         SuperscriptBox[
          StyleBox["a", "TI"], "2"]}]]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "594776df-9e75-d16a-0f7d-6f991b01a3b0"],
     "; for \"Weak\", ",
     Cell[BoxData[
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{
        FractionBox["1", "2"], 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         SuperscriptBox[
          StyleBox["\[Xi]", "TI"], "*"], 
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], "-", 
         StyleBox["\[Xi]", "TI"], 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          RowBox[{"\[Dagger]", "2"}]]}], 
        StyleBox[")",
         SpanMaxSize->1]}]]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6405505f-4b92-3bd6-0c3b-4a196e24893c"],
     "; for \"Antinormal\", ",
     Cell[BoxData[
      RowBox[{
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{
         FractionBox["1", "2"], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
           StyleBox["i", "TI"], 
           StyleBox["\[Theta]", "TI"]}]], 
         StyleBox["tanh",
          FontSlant->"Plain"], "\[ThinSpace]", 
         StyleBox["r", "TI"], "\[ThinSpace]", 
         SuperscriptBox[
          StyleBox["a", "TI"], "2"]}]], "\[ThinSpace]", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{
         StyleBox["ln",
          FontSlant->"Plain"], "\[ThinSpace]", 
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{
          StyleBox["cosh",
           FontSlant->"Plain"], "\[ThinSpace]", 
          StyleBox["r", "TI"]}], 
         StyleBox[")",
          SpanMaxSize->1], "\[ThinSpace]", 
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{
          SuperscriptBox[
           StyleBox["a", "TI"], "\[Dagger]"], 
          StyleBox["a", "TI"], "+", 
          FractionBox["1", "2"]}], 
         StyleBox[")",
          SpanMaxSize->1]}]], "\[ThinSpace]", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
         FractionBox["1", "2"], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox[
           RowBox[{"i", "\[Theta]"}], "TI"]], 
         StyleBox["tanh",
          FontSlant->"Plain"], "\[ThinSpace]", 
         StyleBox["r", "TI"], "\[ThinSpace]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          RowBox[{"\[Dagger]", "2"}]]}]]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6878c7f8-419e-9db5-1807-dea27028e79f"],
     "."
    }], "TableText",ExpressionUUID->"48a3d607-c312-9dd3-7850-c860f6a4e739"]}
  }]], "2ColumnTableMod",
 CellID->632614636,ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"],

Cell["Coherence and correlation functions", "Subsubsection",
 CellID->1689610856,ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "023f49e2-a747-9723-33c5-60cfd2f3fa09"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"21aa1c49-e16c-f406-57a9-9612901edf6c"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "12f3dbee-abc4-6375-4280-d2cbce714e5f"], Cell[TextData[{
     Cell[BoxData["G2Coherence"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
     "[\[Psi]]"
    }], "TableText",ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"], 
    Cell[TextData[{
     "Second-order coherence ",
     Cell[BoxData[
      SuperscriptBox[
       StyleBox["g", "TI"], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], "2", 
        StyleBox[")",
         SpanMaxSize->1]}]]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "362a4e41-4988-041f-5e2a-602b683d6f65"],
     "(0) for state \[Psi]"
    }], "TableText",ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "107fa29c-d013-1000-4004-3bd9e1a6636a"], Cell[TextData[{
     Cell[BoxData["G1Correlation"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6798df62-4cc7-e4e1-0da7-d74c6573cecb"],
     "[\[Psi],{{",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["r", "TI"], "1"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "49f5450b-e8d1-97dd-7f8b-5d548965fd27"],
     ",",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["t", "TI"], "1"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],
     "},{",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["r", "TI"], "2"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0b990c23-b656-01a6-39a6-a58cc3e3538c"],
     ",",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["t", "TI"], "2"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "52243646-2fbd-210e-03db-a8204a487054"],
     "}}]"
    }], "TableText",ExpressionUUID->"1acd7f4d-3da3-7753-4af3-7717b4565db9"], 
    Cell[TextData[{
     "First-order correlation function ",
     Cell[BoxData[
      RowBox[{
       SuperscriptBox[
        StyleBox["G", "TI"], 
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], "1", 
         StyleBox[")",
          SpanMaxSize->1]}]], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         StyleBox["x", "TI"], "1"], ",", 
        SubscriptBox[
         StyleBox["x", "TI"], "2"]}], 
       StyleBox[")",
        SpanMaxSize->1]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "062d91f0-6326-41c0-2fd2-08ba16d3132a"],
     " for state \[Psi] at the space and time coordinates ",
     Cell[BoxData[
      RowBox[{
       SubscriptBox[
        StyleBox["r", "TI"], "1"], ",", 
       SubscriptBox[
        StyleBox["t", "TI"], "1"], ",", 
       SubscriptBox[
        StyleBox["r", "TI"], "2"], ",", 
       SubscriptBox[
        StyleBox["t", "TI"], "2"]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"]
    }], "TableText",ExpressionUUID->"6f6ad260-8ee1-565a-1569-d44a2a943ca0"]}
  }]], "2ColumnTableMod",
 CellID->1303163127,ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell["Basic usage", "Section",
 CellID->2098230307,ExpressionUUID->"26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],

Cell["Setting the space size", "Subsection",
 CellID->1930159659,ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],

Cell[TextData[{
 "The global variable ",
 Cell[BoxData["$FockSize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b853673-18d0-d9fa-19ba-a83d996aabc0"],
 " stores the default truncation size (dimension) of the Fock space. It is \
used by all second-quantization functions when the ",
 StyleBox["size", "TI"],
 " parameter is not explicitly specified. \[Bullet] Default value: 16 \
\[Bullet] Use ",
 Cell[BoxData[
  RowBox[{
   StyleBox["SetFockSpaceSize",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["n", "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25b5b884-ef74-61b3-534a-31e18a013399"],
 " to change the default. \[Bullet] Use ",
 Cell[BoxData[
  RowBox[{
   StyleBox["SetFockSpaceSize",
    FontSlant->"Plain"], "[", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "574a2197-51ef-7938-7d49-b8d1679a4802"],
 " to reset to 16."
}], "Text",
 CellID->1113655915,ExpressionUUID->"6e85e9ed-427b-8528-16ba-00b7770fec72"],

Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " Larger truncation sizes improve accuracy for high photon-number states, \
but increase computational cost."
}], "Text",
 CellID->1606118752,ExpressionUUID->"73b76025-96bb-3fff-214d-798f234f85c5"],

Cell["Show the default truncation size:", "Text",
 CellID->2141499446,ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"],

Cell[BoxData["$FockSize"], "Input",
 CellLabel->"In[2]:= ",
 CellID->339082558,ExpressionUUID->"72ff7667-e560-b2c0-2285-68408c1a002a"],

Cell["Set the truncation size to 20:", "Text",
 CellID->432388834,ExpressionUUID->"7c9be80e-0554-61c1-24b8-0268ace1332b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "20", "]"}], ";"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->443736588,ExpressionUUID->"106b7ad8-6378-599b-4069-7382160d2be1"],

Cell["Show new truncation size:", "Text",
 CellID->1593449978,ExpressionUUID->"7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],

Cell[BoxData["$FockSize"], "Input",
 CellLabel->"In[4]:= ",
 CellID->1742646261,ExpressionUUID->"304452a4-201b-d64c-607c-4b0e51afbc96"],

Cell["Set the default size again:", "Text",
 CellID->29467524,ExpressionUUID->"6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "]"}], ";"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->1939141443,ExpressionUUID->"4b5b9263-9199-4e16-7978-144d202c157c"],

Cell["Show the current truncation size:", "Text",
 CellID->5047578,ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"],

Cell[BoxData["$FockSize"], "Input",
 CellLabel->"In[6]:= ",
 CellID->15008895,ExpressionUUID->"2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],

Cell["Fock States", "Subsection",
 CellID->1892712309,ExpressionUUID->"3343f580-98d5-e31c-6170-ecea1961ce66"],

Cell["\<\
Create a single-mode Fock state with occupation number 5 using the default \
truncation size:\
\>", "Text",
 CellID->787969749,ExpressionUUID->"20a7420b-376a-b23f-505d-6455421c0105"],

Cell[BoxData[
 RowBox[{"FockState", "[", "5", "]"}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->525088789,ExpressionUUID->"6af863a9-1098-c609-1a98-7af3a112ad53"],

Cell["\<\
Create a single-mode Fock state with occupation number 5 using truncation \
size 10:\
\>", "Text",
 CellID->357930410,ExpressionUUID->"055bc2ad-6b92-a3be-3378-dbf70e24f184"],

Cell[BoxData[
 RowBox[{"FockState", "[", 
  RowBox[{"5", ",", " ", "10"}], "]"}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->1802489801,ExpressionUUID->"2b0fb60e-2211-365f-5934-286857a59ca5"],

Cell["\<\
Create a two-mode Fock state with occupation numbers 2 and 12:\
\>", "Text",
 CellID->115301326,ExpressionUUID->"201a2509-bdd9-2fa1-5039-bd53346c758b"],

Cell[BoxData[
 RowBox[{"FockState", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "12"}], "}"}], "]"}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->1651187567,ExpressionUUID->"7085d256-6adc-aa08-20ba-d4100f6ef952"],

Cell["\<\
Verify the shorthand string representation matches the two-mode state:\
\>", "Text",
 CellID->941376513,ExpressionUUID->"5f932952-49a5-d34f-05a0-c11c6851a195"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FockState", "[", 
   RowBox[{"{", 
    RowBox[{"6", ",", " ", "6"}], "}"}], "]"}], " ", "==", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"\"\<66\>\"", ",", " ", "$FockSize"}], "]"}]}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->2120243592,ExpressionUUID->"160f17c4-d31a-fe19-3e34-8ea1e6acc563"],

Cell["\<\
This shorthand does not work for numbers \[GreaterEqual] 10 because the \
digits are interpreted as separate qudits:\
\>", "Text",
 CellID->1047559317,ExpressionUUID->"10beb8bd-bdb6-ee93-4045-31e73440b4f9"],

Cell[BoxData[{
 RowBox[{"FockState", "[", 
  RowBox[{"{", 
   RowBox[{"10", ",", " ", "10"}], "}"}], "]"}], "\n", 
 RowBox[{"QuantumState", "[", 
  RowBox[{"\"\<1010\>\"", ",", " ", "$FockSize"}], "]"}], "\n", 
 RowBox[{"%", " ", "==", " ", "%%"}]}], "Input",
 CellLabel->"In[11]:= ",
 CellID->1820947576,ExpressionUUID->"3fdc991b-fead-14b0-65e3-1144fb587e9a"],

Cell["Annihilation and creation operators", "Subsection",
 CellID->670734585,ExpressionUUID->"3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],

Cell["\<\
Create a single-mode annihilation operator with the default truncation size:\
\>", "Text",
 CellID->58232708,ExpressionUUID->"0642d375-09f3-9942-2e71-cb3faf87eba8"],

Cell[BoxData[
 RowBox[{"AnnihilationOperator", "[", "]"}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->393464600,ExpressionUUID->"0651775d-2bad-791b-2e6f-6f074e584861"],

Cell["\<\
Create an annihilation operator with truncation size 8 (an 8\[Times]8 matrix) \
using the default mode order {1}:\
\>", "Text",
 CellID->1484396876,ExpressionUUID->"63b9e3d6-2298-231e-1146-fa9057128e64"],

Cell[BoxData[
 RowBox[{"AnnihilationOperator", "[", "8", "]"}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->1149283354,ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"],

Cell["\<\
Create an annihilation operator acting on mode 2 using the default truncation \
size:\
\>", "Text",
 CellID->1092188694,ExpressionUUID->"4c440104-ea8a-4285-747b-99618f3f10ef"],

Cell[BoxData[
 RowBox[{"AnnihilationOperator", "[", 
  RowBox[{"{", "2", "}"}], "]"}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->559599970,ExpressionUUID->"66c9a615-af45-c085-0ef6-385ecaf192ef"],

Cell["\<\
Create an annihilation operator with size 5 acting on mode 3:\
\>", "Text",
 CellID->1710123944,ExpressionUUID->"0513e607-0f4c-1e20-3320-f861aaf9650a"],

Cell[BoxData[
 RowBox[{"AnnihilationOperator", "[", 
  RowBox[{"5", ",", " ", 
   RowBox[{"{", "3", "}"}]}], "]"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->934597701,ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"],

Cell["Apply the annihilation operator to a Fock state:", "Text",
 CellID->284780108,ExpressionUUID->"6833ae6a-6ac5-a2c8-19c0-40340f71f012"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AnnihilationOperator", "[", "]"}], "[", 
   RowBox[{"FockState", "[", "2", "]"}], "]"}], "[", "\"\<Formula\>\"", 
  "]"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->643798763,ExpressionUUID->"5f7f2999-1aee-25a5-0504-c0c39e988f8f"],

Cell["\<\
Define the creation operator by taking the adjoint (SuperDagger) of the \
annihilation operator, then apply it to a Fock state:\
\>", "Text",
 CellID->268959046,ExpressionUUID->"128c7526-c883-085d-42b4-6c83e9365aa7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"SuperDagger", "[", 
     RowBox[{"AnnihilationOperator", "[", "]"}], "]"}], "@", " ", 
    RowBox[{"FockState", "[", "1", "]"}]}], ")"}], "[", "\"\<Formula\>\"", 
  "]"}]], "Input",
 CellLabel->"In[17]:= ",
 CellID->403125484,ExpressionUUID->"3279c00f-c9e2-8758-6206-da68ef94eda2"],

Cell["Or use the \"Dagger\" property directly:", "Text",
 CellID->931950651,ExpressionUUID->"50b12ff8-e606-85f7-004e-c6a593b0efdd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"AnnihilationOperator", "[", "]"}], "[", "\"\<Dagger\>\"", "]"}],
     "@", 
    RowBox[{"FockState", "[", "1", "]"}]}], ")"}], "[", "\"\<Formula\>\"", 
  "]"}]], "Input",
 CellLabel->"In[18]:= ",
 CellID->412518898,ExpressionUUID->"640f47a5-4648-c62d-0c35-5e0f73e2ad77"],

Cell["Coherent state", "Subsection",
 CellID->622967176,ExpressionUUID->"63a48922-0fac-666c-115b-208caa594cb6"],

Cell["\<\
Create a symbolic coherent state with the default truncation size:\
\>", "Text",
 CellID->1358080856,ExpressionUUID->"387a9e0d-0234-0e73-6819-1057b7c15559"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CoherentState", "[", "]"}], "[", "\[Beta]", "]"}]], "Input",
 CellLabel->"In[19]:= ",
 CellID->320615307,ExpressionUUID->"3f64ca0d-9927-5f44-651b-ec5718d225ae"],

Cell[TextData[{
 "Create a symbolic coherent state with truncation size ",
 Cell[BoxData["20"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "399d1ff3-4632-be92-6fa2-96bd73c404f8"],
 ", it is possible to specify that the state is not normalized to avoid the \
truncated space normalization factor (can be impractical for symbolic \
manipulations):"
}], "Text",
 CellID->1594238871,ExpressionUUID->"1170384d-2f38-2c50-470f-b2174acd76ba"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CoherentState", "[", 
    RowBox[{"20", ",", " ", 
     RowBox[{"\"\<Normalized\>\"", " ", "->", " ", "False"}]}], "]"}], "[", 
   "\[Beta]", "]"}], "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->2002505366,ExpressionUUID->"6ce33075-6d34-44a7-1490-aa3f04c12e8d"],

Cell[TextData[{
 "Photon-number distribution for a coherent state with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[ThinSpace]", "=", "\[ThinSpace]", "1.3", "+",
    "2", 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],
 " using truncation size ",
 Cell[BoxData["25"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6334ac9c-43f1-85c0-12cb-45c67585ef2a"],
 ":"
}], "Text",
 CellID->2121396920,ExpressionUUID->"74397683-04f4-1d4d-1dc7-6fedac816797"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CoherentState", "[", "25", "]"}], "[", 
   RowBox[{"1.3", " ", "+", " ", 
    RowBox[{"2", " ", "I"}]}], "]"}], "[", 
  RowBox[{"\"\<ProbabilityPlot\>\"", ",", " ", 
   RowBox[{"LabelStyle", " ", "->", " ", "8"}], ",", " ", "\n", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "4"}]}]}], "]"}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->993357154,ExpressionUUID->"735e49d5-32a1-4a48-2166-609f47541892"],

Cell["Cat State", "Subsection",
 CellID->50259360,ExpressionUUID->"335d55a2-cf9b-493d-6163-4c0fea2e1807"],

Cell[TextData[{
 "Create a cat state ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\|01d4a9", 
    StyleBox["\[Alpha]", "TI"]], 
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{
       StyleBox["\[Alpha]", "TI"]},
      "Ket"], "+", 
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       StyleBox[
        RowBox[{"i", "\[Phi]"}], "TI"]], 
      TemplateBox[{
        RowBox[{"-", 
          StyleBox["\[Alpha]", "TI"]}]},
       "Ket"]}]}], ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bfbbd45-edb8-1b0b-6998-352e844d6651"],
 " with amplitude ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", "2", "+", 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "045023ab-c37d-b770-2c6f-baf4f6091a5a"],
 " and phase ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Phi]", "TI"], "=", "3", "\[Pi]", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73e8aeff-5b91-f8f4-2197-47b95e25cade"],
 ":"
}], "Text",
 CellID->680111415,ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CatState", "[", "25", "]"}], "[", 
  RowBox[{
   RowBox[{"2", " ", "+", " ", "I"}], ",", " ", 
   RowBox[{"3", " ", 
    RowBox[{"\[Pi]", "/", "4"}]}]}], "]"}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->1912025938,ExpressionUUID->"794a4309-908b-2549-2f4a-5b53213f8f93"],

Cell["Photon distribution of the same state:", "Text",
 CellID->1678275947,ExpressionUUID->"167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CatState", "[", "25", "]"}], "[", 
   RowBox[{
    RowBox[{"2.", " ", "+", " ", "I"}], ",", " ", 
    RowBox[{"3", " ", 
     RowBox[{"\[Pi]", "/", "4"}]}]}], "]"}], "[", 
  RowBox[{"\"\<ProbabilityPlot\>\"", ",", " ", 
   RowBox[{"LabelStyle", " ", "->", " ", "6"}], ",", " ", "\n", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "4"}]}]}], "]"}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->1570109414,ExpressionUUID->"15eb24b6-b946-3a65-43e8-bdf038f0894f"],

Cell["Thermal state", "Subsection",
 CellID->746824257,ExpressionUUID->"27d2a24c-1e84-19ee-4de1-44169b316b34"],

Cell[TextData[{
 "Create a thermal state with mean photon number ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "_"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "285985c7-a1c8-13eb-5866-1ca0d07d6131"],
 " using truncation size ",
 Cell[BoxData["40"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57868ed1-450c-c474-7dbd-279b6cbeaf5e"],
 ":"
}], "Text",
 CellID->966663717,ExpressionUUID->"0c5e608e-35dc-f74f-3466-79e8bc6edd95"],

Cell[BoxData[
 RowBox[{"ThermalState", "[", 
  RowBox[{"2.", ",", " ", "40"}], "]"}]], "Input",
 CellLabel->"In[24]:= ",
 CellID->634665076,ExpressionUUID->"1a1e4090-3303-05ed-4a26-59da46b66f37"],

Cell[TextData[{
 "Plot the photon-number distribution (diagonal of the density matrix), for \
",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "_"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10256af3-3972-af7a-41da-83bdb804f240"],
 " and truncation dimension ",
 Cell[BoxData["40"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "457602f1-d86e-ac86-730d-9bbad918f6ec"],
 ":"
}], "Text",
 CellID->1607396713,ExpressionUUID->"499f95c1-a958-6c18-7fa4-0caac8ed3762"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Diagonal", "[", 
    RowBox[{
     RowBox[{"ThermalState", "[", 
      RowBox[{"4", ",", " ", "40"}], "]"}], "[", "\"\<DensityMatrix\>\"", 
     "]"}], "]"}], ",", " ", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Filling", " ", "->", " ", "Axis"}], ",", " ", "\n", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Fock States\>\"", ",", " ", "\"\<Probability\>\""}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[25]:= ",
 CellID->171231949,ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

Cell["\<\
Define a parametric thermal state in terms of the mean photon number:\
\>", "Text",
 CellID->820919957,ExpressionUUID->"0c02104f-9807-e6c4-3431-8a2919b3cc2e"],

Cell[BoxData[
 RowBox[{"state", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{"ThermalState", "[", 
     RowBox[{"x", ",", " ", "40"}], "]"}], ",", " ", 
    RowBox[{"\"\<Parameters\>\"", " ", "->", " ", "x"}]}], "]"}]}]], "Input",
 CellLabel->"In[26]:= ",
 CellID->1006830744,ExpressionUUID->"6f909018-5ea1-6a32-15af-0a425b543918"],

Cell["Plot the entropy as a function of the mean photon number:", "Text",
 CellID->1175763064,ExpressionUUID->"2f4595f3-090a-1216-557a-0cbda8bf617c"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"state", "[", "x", "]"}], "[", "\"\<Entropy\>\"", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "0", ",", " ", "5"}], "}"}], ",", " ", "\n", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*OverscriptBox[\(n\), \(\[LongDash]\)]\)\>\"", ",", 
      " ", "\n", "   ", "\"\<Entropy\>\""}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[27]:= ",
 CellID->1074416020,ExpressionUUID->"06385f5e-e9d4-4e6c-2fd8-571b886114b6"],

Cell["Displacement operator", "Subsection",
 CellID->2143439988,ExpressionUUID->"25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],

Cell["\<\
Create a displacement operator with truncation size 40 and amplitude 3+i:\
\>", "Text",
 CellID->1933756212,ExpressionUUID->"3b9a140e-d97a-4136-69b9-8e6bd80f101c"],

Cell[BoxData[
 RowBox[{"DisplacementOperator", "[", 
  RowBox[{
   RowBox[{"3", " ", "+", " ", "I"}], ",", " ", "40"}], "]"}]], "Input",
 CellLabel->"In[28]:= ",
 CellID->943735407,ExpressionUUID->"4f9438da-b80f-a114-75ab-b18439bbf07e"],

Cell["Verify that displacing the vacuum produces a coherent state:", "Text",
 CellID->865519937,ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DisplacementOperator", "[", 
    RowBox[{"\[Alpha]", ",", " ", "40"}], "]"}], "[", "]"}], " ", "==", " ", 
  RowBox[{
   RowBox[{"CoherentState", "[", "40", "]"}], "[", "\[Alpha]", 
   "]"}]}]], "Input",
 CellLabel->"In[29]:= ",
 CellID->845186625,ExpressionUUID->"3c8746fc-db76-c487-64bd-5fb9de00aeed"],

Cell["\<\
Specify the mode (order) of the operator with the default size, mode 2 in \
this case:\
\>", "Text",
 CellID->14312863,ExpressionUUID->"11f0f87a-e6f0-91cd-478f-f227928ae317"],

Cell[BoxData[
 RowBox[{"DisplacementOperator", "[", 
  RowBox[{"0.5", ",", " ", 
   RowBox[{"{", "2", "}"}]}], "]"}]], "Input",
 CellLabel->"In[30]:= ",
 CellID->315698450,ExpressionUUID->"473164ce-b547-c1f4-6ecf-7da83cf393de"],

Cell["Phase shift operator", "Subsection",
 CellID->1751204118,ExpressionUUID->"12c4fc3b-e00c-2bba-42fb-f66491b97980"],

Cell["\<\
Matrix form of the phase-shift operator for truncation size 10:\
\>", "Text",
 CellID->2116603297,ExpressionUUID->"1d7e6892-18cd-6f45-4b05-81dc997835af"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PhaseShiftOperator", "[", 
    RowBox[{"\[Theta]", ",", " ", "10"}], "]"}], "[", "\"\<Matrix\>\"", "]"}],
   " ", "//", " ", "MatrixForm"}]], "Input",
 CellLabel->"In[31]:= ",
 CellID->530919167,ExpressionUUID->"325c8f47-cd85-89da-6263-2720e431db20"],

Cell["Effect of phase shift on a single-mode symbolic state:", "Text",
 CellID->1242319925,ExpressionUUID->"43fcea2e-12ab-c026-7183-0388a75f930c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PhaseShiftOperator", "[", "\[Theta]", "]"}], "[", "\n", "  ", 
   RowBox[{"QuantumState", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\[FormalC]", ",", " ", "#"}], "]"}], " ", "&"}], ",", " ", 
       "$FockSize", ",", " ", "\n", "    ", "0"}], "]"}], ",", " ", 
     "$FockSize"}], "]"}], "]"}], " ", "//", " ", 
  "TraditionalForm"}]], "Input",
 CellLabel->"In[32]:= ",
 CellID->1600082692,ExpressionUUID->"5b416c07-c3d3-bf4f-097e-8660f6670595"],

Cell["Effect of phase shift on a two-mode superposition state:", "Text",
 CellID->1091979148,ExpressionUUID->"5add4728-e92e-eff1-0ae3-5f7588d8b5db"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PhaseShiftOperator", "[", 
    RowBox[{"\[Theta]", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}], "[", "\n", "  ", 
   RowBox[{
    RowBox[{"FockState", "[", 
     RowBox[{"{", 
      RowBox[{"5", ",", " ", "3"}], "}"}], "]"}], " ", "+", " ", 
    RowBox[{"FockState", "[", 
     RowBox[{"{", 
      RowBox[{"5", ",", " ", "6"}], "}"}], "]"}]}], "]"}], 
  "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[33]:= ",
 CellID->1239660989,ExpressionUUID->"621761a3-d300-b412-122d-780ce6ba1f78"],

Cell["\<\
Phase shift operator coincides with the \"Z\" gate for qudits when the angle \
is 2\[Pi]/n (up to conjugation):\
\>", "Text",
 CellID->234435634,ExpressionUUID->"5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"RandomInteger", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"$FockSize", " ", "-", " ", "1"}]}], "}"}], "]"}]}], "}"}], ",",
    " ", "\n", " ", 
   RowBox[{
    RowBox[{"PhaseShiftOperator", "[", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"\[Pi]", "/", "n"}]}], ",", " ", "n"}], "]"}], " ", "==", " ", 
    "\n", "  ", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Z\>\"", "[", "n", "]"}], "]"}], "[", "\"\<Conjugate\>\"", 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[34]:= ",
 CellID->417968184,ExpressionUUID->"7d3ffb2e-09a8-fc78-24c4-f288a842c742"],

Cell["Squeeze operator", "Subsection",
 CellID->1274591649,ExpressionUUID->"4139b36b-52b1-2977-70c6-2b356744785d"],

Cell["\<\
Create a squeeze operator with complex parameter 1+i using the default size:\
\>", "Text",
 CellID->1243964799,ExpressionUUID->"494d6e39-7750-b6eb-7f72-806302ea1c31"],

Cell[BoxData[
 RowBox[{"SqueezeOperator", "[", 
  RowBox[{"1.", " ", "+", " ", "I"}], "]"}]], "Input",
 CellLabel->"In[35]:= ",
 CellID->1828403510,ExpressionUUID->"39b01e29-d171-5c92-6f4f-9072e00426f8"],

Cell[TextData[{
 "Create a two-mode state with mode 2 in a squeezed vacuum |0\
\[RightAngleBracket] \[CircleTimes] |\[Xi]\[RightAngleBracket] (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Xi]", "TI"], "\[ThinSpace]", "=", "\[ThinSpace]", "0.9"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f6d713e-2461-11c8-7513-69784d146312"],
 ") using truncation size 15:"
}], "Text",
 CellID->623026911,ExpressionUUID->"14ad582f-66ff-93eb-3c53-5189128be131"],

Cell[BoxData[
 RowBox[{"state", " ", "=", " ", 
  RowBox[{
   RowBox[{"SqueezeOperator", "[", 
    RowBox[{"0.9", ",", " ", "15", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}], "@", 
   RowBox[{"FockState", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "15"}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[36]:= ",
 CellID->308489360,ExpressionUUID->"4f7ea056-2d28-85ec-7505-3a1044c2ef36"],

Cell["Plot the non-zero amplitudes of the state:", "Text",
 CellID->387004599,ExpressionUUID->"16b00368-b832-202d-3e4f-9b3239c77377"],

Cell[BoxData[
 RowBox[{"state", "[", 
  RowBox[{"\"\<AmplitudePlot\>\"", ",", " ", 
   RowBox[{"ChartLegends", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "200"}]}], "]"}]], "Input",
 CellLabel->"In[37]:= ",
 CellID->1976158344,ExpressionUUID->"06d00634-a672-f252-2eef-9871d304c0b8"],

Cell["Beam-Splitter Operator", "Subsection",
 CellID->1232186413,ExpressionUUID->"05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],

Cell[TextData[{
 "Set a symmetric beam splitter with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", "=", "\[ThinSpace]", "\[Pi]", "/",
    "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583a98af-415b-100e-09d9-110970ee6354"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Phi]", "TI"], "\[ThinSpace]", "=", "\[ThinSpace]", "\[Pi]", "/",
    "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07beae85-a317-6bf9-2d45-47eed6a239c3"],
 ":"
}], "Text",
 CellID->655687319,ExpressionUUID->"503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],

Cell[BoxData[
 RowBox[{"symmetricBS", " ", "=", " ", 
  RowBox[{"BeamSplitterOperator", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Pi]", "/", "4."}], ",", " ", 
     RowBox[{"\[Pi]", "/", "2."}]}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[38]:= ",
 CellID->1589358908,ExpressionUUID->"60049622-f570-0e0e-103b-0f8ffc055554"],

Cell["Transform the state |1,1\[RightAngleBracket] with the symmetric beam \
splitter:", "Text",
 CellID->1191517648,ExpressionUUID->"40ea559d-da93-7842-70ea-4cc6df264aa8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Chop", "[", 
   RowBox[{"symmetricBS", "[", 
    RowBox[{"FockState", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], "]"}], "]"}], "]"}], 
  "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[39]:= ",
 CellID->960670710,ExpressionUUID->"23ccc6ee-92c0-e596-51f3-dfc8277acffc"],

Cell["\<\
Specify the mode order (where the operator acts) and the truncation size:\
\>", "Text",
 CellID->1307080411,ExpressionUUID->"114d8d02-b276-9c05-4772-256fc700e76f"],

Cell[BoxData[
 RowBox[{"BeamSplitterOperator", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.2", ",", " ", "0.9"}], "}"}], ",", " ", "6", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[40]:= ",
 CellID->1960030258,ExpressionUUID->"2dc22b63-32d1-862f-5bf1-c34d4765ed75"],

Cell["BeamSplitter operator: Method option", "Subsubsection",
 CellID->535682707,ExpressionUUID->"36ea7e2c-072a-2221-5eea-7076b2df710b"],

Cell[TextData[{
 "BeamSplitterOperator supports two computation methods via the Method \
option. The default is ",
 StyleBox["MatrixExp ", "TI"],
 "which uses direct matrix exponentiation; ",
 StyleBox["Recurrence ", "TI"],
 "uses an efficient recurrence relation for the beam splitter matrix \
elements. Performance can vary depending on whether the angle arguments are \
numeric or exact/symbolic."
}], "Text",
 CellID->1167207179,ExpressionUUID->"5b23761c-2477-64e8-0ad1-68464d024e32"],

Cell["Use the \"Recurrence\" method with exact parameters:", "Text",
 CellID->1612953718,ExpressionUUID->"73216bcf-7cf1-61ac-22de-82a9748433f6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BeamSplitterOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "4"}], ",", " ", 
       RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"Method", " ", "->", " ", "\"\<Recurrence\>\""}]}], "]"}], "[", 
   "\n", "  ", 
   RowBox[{"FockState", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}], "]"}], "]"}], "[", "\"\<Formula\>\"",
   "]"}]], "Input",
 CellLabel->"In[41]:= ",
 CellID->790826209,ExpressionUUID->"69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],

Cell["OperatorVariance", "Subsection",
 CellID->1163030741,ExpressionUUID->"409bca18-cbd6-e54d-70b8-ec45ee60cf97"],

Cell["\<\
Calculate the variance of the quadrature operators for the ground state:\
\>", "Text",
 CellID->1753119213,ExpressionUUID->"10b62b5f-1d3f-f012-404d-c31994cbc378"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"OperatorVariance", "[", 
    RowBox[{
     RowBox[{"FockState", "[", "0", "]"}], ",", " ", "#"}], "]"}], " ", "&"}],
   " ", "/@", " ", 
  RowBox[{"QuadratureOperators", "[", "]"}]}]], "Input",
 CellLabel->"In[42]:= ",
 CellID->2037256,ExpressionUUID->"79984792-c453-565a-2fb8-5edfede63ca0"],

Cell["\<\
A Fock state has a definite number of photons, so the variance of the number \
operator is zero:\
\>", "Text",
 CellID->339747688,ExpressionUUID->"1d45428e-8fa1-6801-4b7b-5be82a543b6b"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"AnnihilationOperator", "[", "]"}]}], "}"}], ",", " ", "\n", " ", 
   RowBox[{"OperatorVariance", "[", 
    RowBox[{
     RowBox[{"FockState", "[", "2", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"SuperDagger", "[", "a", "]"}], "@", "a"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[43]:= ",
 CellID->1569376968,ExpressionUUID->"604bb87d-3174-a116-1048-32274006f07c"],

Cell["G2Coherence (Second-Order Coherence)", "Subsection",
 CellID->1336445995,ExpressionUUID->"763191a2-6f8b-197a-1fce-080c0a3e6840"],

Cell[TextData[{
 "The function G2Coherence computes the equal-time second-order coherence ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "2", 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "635fdfdb-2856-deda-1164-d68549e0a420"],
 " which characterizes the photon statistics of a quantum state. It is \
defined as:"
}], "Text",
 CellID->797627498,ExpressionUUID->"0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "2", 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     RowBox[{
      SuperscriptBox[
       StyleBox["a", "TI"], "\[Dagger]"], 
      SuperscriptBox[
       StyleBox["a", "TI"], "\[Dagger]"], 
      StyleBox["a", "TI"], "\[ThinSpace]", 
      StyleBox["a", "TI"]}], "\[VeryThinSpace]", 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    SuperscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      RowBox[{
       SuperscriptBox[
        StyleBox["a", "TI"], "\[Dagger]"], 
       StyleBox["a", "TI"]}], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], "2"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8469dd-bfc7-2a7a-04bb-80873a727940"],
 " Physical interpretation: \[Bullet] ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "2", 
     StyleBox[")",
      SpanMaxSize->1]}]], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],
 ": Poissonian statistics (coherent light) \[Bullet] ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "2", 
     StyleBox[")",
      SpanMaxSize->1]}]], "<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3921e4bb-f5e4-3596-68de-fde483969ffc"],
 ": Sub-Poissonian (antibunching, nonclassical light) \[Bullet] ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "2", 
     StyleBox[")",
      SpanMaxSize->1]}]], ">", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13db9173-5387-1c16-41f8-093d6632677c"],
 ": Super-Poissonian (bunching, thermal light) \[Bullet] ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "2", 
     StyleBox[")",
      SpanMaxSize->1]}]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6804c0ab-fd16-b7db-183b-d9f4f4a01d21"],
 ": Single-photon state"
}], "Text",
 CellID->151045137,ExpressionUUID->"77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],

Cell[TextData[{
 "For a coherent state, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "2", 
     StyleBox[")",
      SpanMaxSize->1]}]], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4289b0c6-8043-1b93-72b6-29a031f669f9"],
 ":"
}], "Text",
 CellID->1063989564,ExpressionUUID->"070f3e08-556d-9d60-2d34-b0525c19e44a"],

Cell[BoxData[
 RowBox[{"G2Coherence", "[", 
  RowBox[{
   RowBox[{"CoherentState", "[", "]"}], "[", "2.", "]"}], "]"}]], "Input",
 CellLabel->"In[44]:= ",
 CellID->1987333543,ExpressionUUID->"6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],

Cell[TextData[{
 "For a Fock state |n\[RightAngleBracket] with n > 0, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "2", 
     StyleBox[")",
      SpanMaxSize->1]}]], "=", "1", "-", "1", "/", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4140e475-1e41-1f16-777f-fe3f9bf4627c"],
 ":"
}], "Text",
 CellID->616753397,ExpressionUUID->"67f13035-938c-831a-0d8e-aa7f263eee60"],

Cell[BoxData[
 RowBox[{"G2Coherence", "[", 
  RowBox[{"FockState", "[", "3", "]"}], "]"}]], "Input",
 CellLabel->"In[45]:= ",
 CellID->1146256261,ExpressionUUID->"16b44e14-0404-e868-3e4c-605eadb6bab2"],

Cell[TextData[{
 "For a thermal state with mean photon number ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "2", 
     StyleBox[")",
      SpanMaxSize->1]}]], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e10bd94-ae42-3b4d-262f-34d1cbf48997"],
 ":"
}], "Text",
 CellID->1280025883,ExpressionUUID->"5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"],

Cell[BoxData[
 RowBox[{"G2Coherence", "[", 
  RowBox[{"ThermalState", "[", "2.", "]"}], "]"}]], "Input",
 CellLabel->"In[46]:= ",
 CellID->681114160,ExpressionUUID->"013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],

Cell["Improve the result increasing the truncation size:", "Text",
 CellID->1719384190,ExpressionUUID->"4b734859-75e7-efa6-7901-62030393b58c"],

Cell[BoxData[
 RowBox[{"G2Coherence", "[", 
  RowBox[{"ThermalState", "[", 
   RowBox[{"2.", ",", " ", "40"}], "]"}], "]"}]], "Input",
 CellLabel->"In[47]:= ",
 CellID->1020643561,ExpressionUUID->"4ae31c17-eefa-a706-7a90-96508a8c0a6c"],

Cell["\<\
It is not exactly 2 because of truncation: the thermal distribution has some \
weight at photon numbers beyond the cutoff.\
\>", "Text",
 CellID->1064479054,ExpressionUUID->"00844d77-2817-3ec6-30bc-653149a3842c"],

Cell[TextData[{
 "The single photon state |1\[RightAngleBracket] has ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "2", 
     StyleBox[")",
      SpanMaxSize->1]}]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20b97f64-b973-0c8a-5047-774e380656d0"],
 " (perfect antibunching):"
}], "Text",
 CellID->1710804206,ExpressionUUID->"04469009-6b02-dcc3-2c7d-0a530eb4a629"],

Cell[BoxData[
 RowBox[{"G2Coherence", "[", 
  RowBox[{"FockState", "[", "1", "]"}], "]"}]], "Input",
 CellLabel->"In[48]:= ",
 CellID->762016048,ExpressionUUID->"4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],

Cell["Consider the mixed state (1-\[Epsilon]) |0\[RightAngleBracket] \
\[LeftAngleBracket]0| + \[Epsilon] |2\[RightAngleBracket] \
\[LeftAngleBracket]2|:", "Text",
 CellID->953318213,ExpressionUUID->"5547dfb6-0e84-e145-037c-d6f0ab36b3af"],

Cell[BoxData[
 RowBox[{"\[Rho]", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", "\[Epsilon]"}], ")"}], " ", 
    RowBox[{
     RowBox[{"FockState", "[", "0", "]"}], "[", "\n", 
     "    ", "\"\<MatrixState\>\"", "]"}]}], " ", "+", " ", 
   RowBox[{"\[Epsilon]", " ", 
    RowBox[{
     RowBox[{"FockState", "[", "2", "]"}], "[", "\"\<MatrixState\>\"", 
     "]"}]}]}]}]], "Input",
 CellLabel->"In[49]:= ",
 CellID->1320676321,ExpressionUUID->"12b61bfc-9cd7-eca9-424d-92a61563b6f3"],

Cell["Extreme bunching when \[Epsilon] -> 0:", "Text",
 CellID->1600517155,ExpressionUUID->"451364b5-819d-fb99-7321-7dff3029c9e3"],

Cell[BoxData[
 RowBox[{"G2Coherence", "[", "\[Rho]", "]"}]], "Input",
 CellLabel->"In[50]:= ",
 CellID->1655262560,ExpressionUUID->"13b49e24-0fb7-4441-414b-178eaa422eab"],

Cell[TextData[{
 "If your detector clicks, it means you caught a photon. Because photons only \
exist in pairs in this specific state, the probability that a second photon \
is right there with it is virtually 100%.Therefore, ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["g", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],
 " diverges because the conditional probability of detecting a second photon \
(given that you just detected a first) is massively disproportionate to the \
absolute probability of detecting a photon randomly in the dark field (\
\[Epsilon] ->0)"
}], "Text",
 CellID->843709254,ExpressionUUID->"089aa42d-ce49-3603-38b9-3e76ebfd9d69"],

Cell["G1Correlation (first - order correlation)", "Subsection",
 CellID->1241281984,ExpressionUUID->"48fccab3-b886-a0f7-7883-e3fd3930f2dd"],

Cell["The first-order correlation is defined for some state |\[Psi]\
\[RightAngleBracket] as", "Text",
 CellID->2083544408,ExpressionUUID->"0cdaad60-2181-5e26-34f9-454a5034250c"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox[
    StyleBox["G", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "1", 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["x", "TI"], "1"], ",", 
     SubscriptBox[
      StyleBox["x", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}], "=", 
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Bra"], 
   SuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "-", 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["r", "TI"], "1"], ",", 
     SubscriptBox[
      StyleBox["t", "TI"], "1"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   SuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "+", 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["r", "TI"], "2"], ",", 
     SubscriptBox[
      StyleBox["t", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]}]], "InlineFormula",
 FontSize->0.9 
  Inherited,ExpressionUUID->"542cff75-84e0-b601-7dd3-f73f2c9a1d6b"]], "Text",
 CellID->960626294,ExpressionUUID->"00dd9d4d-f7ec-565f-30e2-151681993ca5"],

Cell[TextData[{
 "where the ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "+", 
     StyleBox[")",
      SpanMaxSize->1]}]], ",", 
   SuperscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "-", 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],
 " are the positive and negative frequency components of a single-mode field"
}], "Text",
 CellID->1275597307,ExpressionUUID->"3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],

Cell[TextData[{
 "Calculate ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["G", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "1", 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "333832e2-8bec-4128-62c7-abcc2d991072"],
 " for |4\[RightAngleBracket]:"
}], "Text",
 CellID->180386896,ExpressionUUID->"78cf51d6-d7cd-4672-28f5-4893e2782d58"],

Cell[BoxData[
 RowBox[{"G1Correlation", "[", 
  RowBox[{
   RowBox[{"FockState", "[", "4", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "t"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "t"}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[51]:= ",
 CellID->1150052415,ExpressionUUID->"1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],

Cell[TextData[{
 "Calculate ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["G", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "1", 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["x", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "710db4a8-d877-0db2-2732-2df5d9025798"],
 " for |4\[RightAngleBracket]:"
}], "Text",
 CellID->1256596424,ExpressionUUID->"71e12f72-3ad4-a92f-279e-c73cbf66f875"],

Cell[BoxData[
 RowBox[{"G1Correlation", "[", 
  RowBox[{
   RowBox[{"FockState", "[", "4", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r1", ",", " ", "t1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r2", ",", " ", "t2"}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[52]:= ",
 CellID->969862745,ExpressionUUID->"06ea8612-dd18-b4f0-2ee9-185fd4921eda"],

Cell["Quadrature Operators", "Subsection",
 CellID->1199935485,ExpressionUUID->"0b02f270-2101-5c3d-3931-f43a50b42707"],

Cell[TextData[{
 "Compute the commutator of the quadrature operators. It should be ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    StyleBox["i", "TI"], "2"], "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],
 "; any small deviation in the last term is expected due to truncation:"
}], "Text",
 CellID->641748961,ExpressionUUID->"669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"Commutator", " ", "@@", " ", 
    RowBox[{"QuadratureOperators", "[", "]"}]}], ")"}], " ", "//", " ", 
  "TraditionalForm"}]], "Input",
 CellLabel->"In[53]:= ",
 CellID->1055869762,ExpressionUUID->"5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],

Cell[TextData[{
 "Expectation value of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubsuperscriptBox[
    StyleBox["X", "TI"], "1", "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],
 " for Fock state ",
 Cell[BoxData[
  TemplateBox[{"3"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e73fafe-05d0-7203-6600-f3b8ac654169"],
 ":"
}], "Text",
 CellID->1607759830,ExpressionUUID->"7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", " ", "=", " ", 
      RowBox[{"FockState", "[", "3", "]"}]}], "}"}], ",", " ", "\n", "  ", 
    RowBox[{
     RowBox[{"SuperDagger", "[", "s", "]"}], "@", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"QuadratureOperators", "[", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], ")"}], "@", "s"}]}]}], 
   "]"}], "[", "\"\<Scalar\>\"", "]"}]], "Input",
 CellLabel->"In[54]:= ",
 CellID->1074210535,ExpressionUUID->"12c044c4-b778-74e1-42f0-5da1c20d5ecb"],

Cell["Or alternatively because the operator is Hermitian:", "Text",
 CellID->1050391292,ExpressionUUID->"3d9aa029-60a8-273a-6bb9-3a7311428a00"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"QuadratureOperators", "[", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "@", 
     RowBox[{"FockState", "[", "3", "]"}]}], ")"}], "[", "\"\<Norm\>\"", 
   "]"}], "^", "2"}]], "Input",
 CellLabel->"In[55]:= ",
 CellID->1113110913,ExpressionUUID->"64adc082-4122-deff-0c52-d9ec70d4a4c5"],

Cell["Mode Order (Multimode Systems)", "Subsection",
 CellID->39476879,ExpressionUUID->"7e451771-8a55-ceec-267a-8f3b2fe19436"],

Cell[TextData[{
 "Many operators accept an optional ",
 StyleBox["order", "TI"],
 " parameter that specifies which mode(s) the operator acts on in a multimode \
system. The order is a list of positive integers. \[Bullet] Default: ",
 Cell[BoxData[
  RowBox[{"{", "1", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4670f053-f537-0b3f-6e0f-ea1cfcc25605"],
 " (single mode, acts on mode 1) \[Bullet] Two modes: ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "330aabc0-bdd5-22a3-6109-42aa34607089"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "3"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],
 " etc. The order parameter is essential for: \[Bullet] Creating operators \
that act on specific modes in a tensor-product space. \[Bullet] Building \
multimode quantum circuits (e.g., beam splitters coupling modes 1 and 2)."
}], "Text",
 CellID->1462859254,ExpressionUUID->"70d705b8-410a-1477-20ec-9ce270bf7f5d"],

Cell["Single-mode operator with explicit order:", "Text",
 CellID->1067972408,ExpressionUUID->"737c509e-bc52-eefb-2104-49d835e4b4c1"],

Cell[BoxData[
 RowBox[{"AnnihilationOperator", "[", 
  RowBox[{"{", "2", "}"}], "]"}]], "Input",
 CellLabel->"In[56]:= ",
 CellID->1289039002,ExpressionUUID->"01a44b6b-c85f-9e0e-375c-6334e9ebe554"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  RowBox[{
   TemplateBox[{
     RowBox[{
       SubscriptBox[
        StyleBox["n", "TI"], "1"], ",", 
       SubscriptBox[
        StyleBox["n", "TI"], "2"]}]},
    "Bra"], 
   SubscriptBox[
    StyleBox["a", "TI"], "2"], 
   TemplateBox[{
     RowBox[{
       SubscriptBox[
        StyleBox["n", "TI"], "1"], ",", 
       SubscriptBox[
        StyleBox["n", "TI"], "2"]}]},
    "Ket"]}], "=", 
  RowBox[{
   SqrtBox[
    SubscriptBox[
     StyleBox["n", "TI"], "2"]], 
   TemplateBox[{
     RowBox[{
       SubscriptBox[
        StyleBox["n", "TI"], "1"], ",", 
       SubscriptBox[
        StyleBox["n", "TI"], "2"], "-", "1"}]},
    "Ket"]}]}]], "InlineFormula",
 FontSize->0.9 
  Inherited,ExpressionUUID->"10bcaec6-cc03-bcfd-4043-47a3e5b706c7"]], "Text",
 CellID->214787233,ExpressionUUID->"25120901-cfbc-a8e6-5321-a16aea4efacc"],

Cell["Verify the property:", "Text",
 CellID->2022853894,ExpressionUUID->"3ee7491f-72c3-8814-669d-61590777db7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"{", "2", "}"}], "]"}], "[", 
   RowBox[{"FockState", "[", 
    RowBox[{"{", 
     RowBox[{"3", ",", " ", "5"}], "}"}], "]"}], "]"}], " ", "==", " ", "\n", 
  " ", 
  RowBox[{
   RowBox[{"Sqrt", "[", "5", "]"}], " ", 
   RowBox[{"FockState", "[", 
    RowBox[{"{", 
     RowBox[{"3", ",", " ", 
      RowBox[{"5", " ", "-", " ", "1"}]}], "}"}], "]"}]}]}]], "Input",
 CellLabel->"In[57]:= ",
 CellID->1022435225,ExpressionUUID->"67860241-8011-89c8-0dbd-a42b31a5db12"],

Cell["Two-mode beam splitter acting on modes 1 and 3:", "Text",
 CellID->249582051,ExpressionUUID->"1318f44b-7a0d-b86f-4127-ee157fb90ab5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BeamSplitterOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "4"}], ",", " ", 
       RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "\n", "   ", 
     RowBox[{"Method", " ", "->", " ", "\"\<Recurrence\>\""}]}], "]"}], "[", 
   RowBox[{"FockState", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "3", ",", " ", "1"}], "}"}], "]"}], "]"}], 
  "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[58]:= ",
 CellID->1464174193,ExpressionUUID->"221ecbfd-1ed7-d323-5225-e2a79b63be09"],

Cell["Displacement operator on mode 3:", "Text",
 CellID->2044678727,ExpressionUUID->"3f067a83-888f-4db3-653e-73ed293a1799"],

Cell[BoxData[
 RowBox[{"DisplacementOperator", "[", 
  RowBox[{"1.5", ",", " ", "8", ",", " ", 
   RowBox[{"{", "3", "}"}]}], "]"}]], "Input",
 CellLabel->"In[59]:= ",
 CellID->598605201,ExpressionUUID->"287fc527-5526-9e30-5804-dc815cd0e51a"],

Cell[TextData[{
 "Note: When using mode order, all operators in a calculation should use \
consistent mode assignments. The ",
 StyleBox["order", "TI"],
 " parameter does NOT change the Fock space dimension\[LongDash]it only \
labels which mode the operator acts on."
}], "Text",
 CellID->1178108964,ExpressionUUID->"2207e002-80f7-0285-523c-fa6c308250ef"],

Cell["Error Messages", "Subsection",
 CellID->728825311,ExpressionUUID->"440467ae-8db5-79b4-6c3c-7e0824404b9e"],

Cell["\<\
The following error messages may be generated by second-quantization \
functions:\
\>", "Text",
 CellID->639517814,ExpressionUUID->"141585f4-d1c1-5bbd-3c2a-1cb1e0742987"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3d27d006-86b8-9131-64dc-ca603332e01b"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"3e44340b-ef5c-51d5-667b-ae548ae9233f"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"321034f4-436e-dcec-622f-adbe7618a636"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1287d3f9-6500-de4e-42bc-caa30cbaa494"], Cell[TextData[Cell[BoxData[
     RowBox[{"FockState", "::", "clip"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"]], "TableText",ExpressionUUID->
     "087f5f2f-6486-1b59-3805-56890d3369a3"], Cell["\<\
Issued when the Fock state index is outside the valid range [0, size-1]. The \
index is clipped to the nearest valid value.\
\>", "TableText",ExpressionUUID->"7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"], Cell[TextData[Cell[BoxData[
     RowBox[{"FockVals", "::", "len"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "13ecd9ee-6506-67bb-4193-d0c80cb34d81"]], "TableText",ExpressionUUID->
     "6724c974-bdf1-27a5-0edb-e13e3b858d8f"], Cell["\<\
Issued when multimode Fock state values contain invalid (negative or too \
large) integers.\
\>", "TableText",ExpressionUUID->"2b52875c-0948-9ae8-5961-1f06a8e2e832"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "53412643-5a68-df00-017e-b82d5f02a26a"], Cell[TextData[Cell[BoxData[
     RowBox[{"DisplacementOperator", "::", "invalidorder"}]], "InlineFormula",
     
     FontSize->0.9 Inherited,ExpressionUUID->
     "696f5b1d-d56b-3a26-1f15-5346dc1f890c"]], "TableText",ExpressionUUID->
     "0eb02373-2484-618c-364f-bb3d4d3133d6"], Cell["\<\
Issued when the \"Ordering\" option is not \"Normal\", \"Weak\", or \
\"Antinormal\".\
\>", "TableText",ExpressionUUID->"640353f1-ff8e-e9b3-0c31-4abafa38bb99"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "37161f66-4600-a3a8-5d2d-974073baf1f2"], Cell[TextData[Cell[BoxData[
     RowBox[{"SqueezeOperator", "::", "invalidorder"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2e44757e-c407-f813-567c-6d3bedb3cb79"]], "TableText",ExpressionUUID->
     "07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"], Cell["\<\
Issued when the \"Ordering\" option is not \"Normal\", \"Weak\", or \
\"Antinormal\".\
\>", "TableText",ExpressionUUID->"539b0e4e-9e5a-5525-01b8-a0281bef3c0f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1cd82739-42e3-b7ed-44e7-bf6376971d37"], Cell[TextData[Cell[BoxData[
     RowBox[{"BeamSplitterOperator", "::", "badmethod"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0971a20b-7913-467e-3f0e-445578a62d44"]], "TableText",ExpressionUUID->
     "09df342d-d743-5809-3fe4-ae76e2f62b53"], Cell["\<\
Issued when the Method option is not \"MatrixExp\" or \"Recurrence\".\
\>", "TableText",ExpressionUUID->"0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"]}
  }]], "2ColumnTableMod",
 CellID->1709586986,ExpressionUUID->"21fdaace-430e-f3f9-5782-43a876b8c1c3"],

Cell["Example: FockState index clipping", "Text",
 CellID->783356103,ExpressionUUID->"1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"],

Cell[BoxData[
 RowBox[{"FockState", "[", 
  RowBox[{"100", ",", " ", "16"}], "]"}]], "Input",
 CellLabel->"In[60]:= ",
 CellID->896659851,ExpressionUUID->"10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],

Cell["Ordering option", "Subsection",
 CellID->1161108776,ExpressionUUID->"41c6bfc6-0792-5005-77fd-36a0b227236f"],

Cell["\<\
Displacement and squeeze operators can be defined with different orderings. \
Use the \"Ordering\" option to choose \"Weak\", \"Normal\", or \
\"Antinormal\". In the infinite-dimensional limit these are equivalent, but \
in a truncated space the numerical error depends on the ordering, so one \
choice may be more accurate for a given calculation.\
\>", "Text",
 CellID->950316697,ExpressionUUID->"62752e4e-571f-d961-120a-c02862aba84b"],

Cell[TextData[{
 "Check unitarity of the displacement operator using \"UnitaryQ\" for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[ThinSpace]", "=", "\[ThinSpace]", "0.5", "+", 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],
 ". For this case, weak ordering gives the expected result:"
}], "Text",
 CellID->691399421,ExpressionUUID->"166277e1-e8de-815f-3e12-6eca8968d3a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DisplacementOperator", "[", 
   RowBox[{"0.5", " ", "+", " ", "I"}], "]"}], "[", "\"\<UnitaryQ\>\"", 
  "]"}]], "Input",
 CellLabel->"In[61]:= ",
 CellID->2104867922,ExpressionUUID->"0ae7a534-7379-468c-3a9c-3d7e060c2cd6"],

Cell["Repeat the check using weak ordering:", "Text",
 CellID->771870489,ExpressionUUID->"34baef30-7963-b757-5c59-077a78171dbd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DisplacementOperator", "[", 
   RowBox[{
    RowBox[{"0.5", " ", "+", " ", "I"}], ",", " ", 
    RowBox[{"\"\<Ordering\>\"", " ", "->", " ", "\"\<Weak\>\""}]}], "]"}], 
  "[", "\"\<UnitaryQ\>\"", "]"}]], "Input",
 CellLabel->"In[62]:= ",
 CellID->1879165774,ExpressionUUID->"15ce0314-20ee-2b64-43f5-9b5e509b764e"],

Cell[TextData[{
 "For a squeezed vacuum state with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Xi]", "TI"], "\[ThinSpace]", "=", "\[ThinSpace]", "1.5", 
   "\[ThinSpace]", "+", "0.5", "\[ThinSpace]", 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38a9ac88-4644-6c0e-6856-45d273f13754"],
 " and ",
 Cell[BoxData[
  RowBox[{"size", " ", "=", " ", "20"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64802aa2-b136-451c-0cbf-c30fc0c32c66"],
 " compare the numerical error of \"Weak\" and \"Normal\" orderings against \
the analytic expression. For this value of \[Xi], the truncation size is not \
sufficient for the weak-ordered operator, and the normal-ordered one is more \
accurate."
}], "Text",
 CellID->1568237090,ExpressionUUID->"67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"],

Cell["Amplitudes obtained from a known analytic formula:", "Text",
 CellID->1215643129,ExpressionUUID->"233ecb8e-17f3-8d32-52c5-e2e8a187d418"],

Cell[BoxData[
 RowBox[{
  RowBox[{"analytic", " ", "=", " ", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Cosh", "[", 
        RowBox[{"Abs", "[", "\[Xi]", "]"}], "]"}], "]"}]}], " ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", " ", "m"}], ")"}], "!"}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "^", "m"}], " ", 
           RowBox[{"m", "!"}]}], ")"}]}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{"I", " ", "m", " ", 
           RowBox[{"Arg", "[", "\[Xi]", "]"}]}], ")"}]}], " ", 
        RowBox[{
         RowBox[{"Tanh", "[", 
          RowBox[{"Abs", "[", "\[Xi]", "]"}], "]"}], "^", "\n", "      ", 
         "m"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "9"}], "}"}]}], "]"}]}], " ", "/.",
     " ", 
    RowBox[{"\[Xi]", " ", "->", " ", 
     RowBox[{"(", 
      RowBox[{"1.5", " ", "+", " ", 
       RowBox[{"0.5", " ", "I"}]}], ")"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[63]:= ",
 CellID->1905081759,ExpressionUUID->"7dd949a9-d8cf-50b3-2be7-60f2d97a2299"],

Cell["Compute absolute errors:", "Text",
 CellID->1421144675,ExpressionUUID->"4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"absoluteErrors", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"SqueezeOperator", "[", 
          RowBox[{
           RowBox[{"1.5", " ", "+", " ", 
            RowBox[{"0.5", " ", "I"}]}], ",", " ", "20", ",", " ", 
           RowBox[{"\"\<Ordering\>\"", " ", "->", " ", "#"}]}], "]"}], "[", 
         "]"}], "[", "\n", "       ", "\"\<AmplitudeList\>\"", "]"}], " ", "-",
        " ", "analytic"}], ")"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Normal\>\"", ",", " ", "\"\<Weak\>\""}], "}"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[64]:= ",
 CellID->2106544241,ExpressionUUID->"598f41e5-f1df-a461-0fb5-58ce806b0f4b"],

Cell["Show the results:", "Text",
 CellID->540539268,ExpressionUUID->"1e0f0df5-2071-c96f-4634-a4bf51059bb5"],

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"absoluteErrors", " ", "//", " ", "Transpose"}], ",", " ", "\n", 
   " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Ket", "[", 
         RowBox[{"{", "i", "}"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "0", ",", " ", "20", ",", " ", "2"}], "}"}]}],
        "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Normal\>\"", ",", " ", "\"\<Weak\>\""}], "}"}]}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[65]:= ",
 CellID->1735548981,ExpressionUUID->"7f6e12d5-e3b9-0bb9-2515-8b9e964c5983"],

Cell["Applications: States and operators", "Subsection",
 CellID->243931157,ExpressionUUID->"41ecc127-3c02-05fa-7793-d881b5b76fc0"],

Cell["Mean number of photons", "Subsection",
 CellID->674797301,ExpressionUUID->"1190ff72-a9fe-60f8-47af-f73fcf8b32c2"],

Cell["\<\
Define the annihilation operator and create a random pure state:\
\>", "Text",
 CellID->1379404226,ExpressionUUID->"19c80315-d7de-7125-4ff7-9b5ee26b400f"],

Cell[BoxData[{
 RowBox[{"a", " ", ":=", " ", 
  RowBox[{"AnnihilationOperator", "[", "]"}]}], "\n", 
 RowBox[{
  RowBox[{"\[Psi]", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<RandomPure\>\"", ",", " ", "$FockSize"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[66]:= ",
 CellID->790948907,ExpressionUUID->"6fdf78a7-59a9-97d9-15e5-7101585dfd23"],

Cell["\<\
Compute the mean number of photons using QuantumMeasurementOperator:\
\>", "Text",
 CellID->630069941,ExpressionUUID->"7a87483f-bfa4-2eb6-2abd-62793a51749c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"QuantumMeasurementOperator", "[", 
     RowBox[{
      RowBox[{"SuperDagger", "[", "a", "]"}], "@", "a"}], "]"}], "[", 
    "\[Psi]", "]"}], ")"}], "[", "\"\<Mean\>\"", "]"}]], "Input",
 CellLabel->"In[67]:= ",
 CellID->129729226,ExpressionUUID->"09b26917-59e6-8729-3f41-81515f90ea73"],

Cell[TextData[{
 "Equivalent bracket notation ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Bra"], 
   SuperscriptBox[
    StyleBox["a", "TI"], "\[Dagger]"], 
   StyleBox["a", "TI"], 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "521ad179-838d-ce9b-0239-c923363994e1"],
 ":"
}], "Text",
 CellID->2142768544,ExpressionUUID->"136d7364-bcfb-8461-4113-6b4e348fef4b"],

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{
   RowBox[{"(", " ", 
    RowBox[{
     RowBox[{"SuperDagger", "[", "\[Psi]", "]"}], "@", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SuperDagger", "[", "a", "]"}], "@", "a"}], ")"}], "@", 
      "\[Psi]"}]}], " ", ")"}], "[", "\"\<Scalar\>\"", "]"}], "]"}]], "Input",\

 CellLabel->"In[68]:= ",
 CellID->466094680,ExpressionUUID->"2b78534b-7a52-d624-5918-4b157fe4bd0e"],

Cell["Number operator is Hermitian:", "Text",
 CellID->1071716993,ExpressionUUID->"30c454b2-bdb8-e427-60fc-4dfc3432cf0d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"a", "[", "\[Psi]", "]"}], "[", "\"\<Norm\>\"", "]"}], "^", 
  "2"}]], "Input",
 CellLabel->"In[69]:= ",
 CellID->498033274,ExpressionUUID->"6879dfe8-0276-0c7b-1806-d6b2b7035741"],

Cell["\<\
Using the probabilities of the diagonal of the density matrix:\
\>", "Text",
 CellID->2059214793,ExpressionUUID->"7cc522fa-6a93-e579-24fa-bba40f27cc43"],

Cell[BoxData[
 RowBox[{"Chop", "@", 
  RowBox[{"Dot", "[", 
   RowBox[{
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", 
      RowBox[{"$FockSize", " ", "-", " ", "1"}]}], "]"}], ",", " ", 
    RowBox[{"Diagonal", "@", 
     RowBox[{"\[Psi]", "[", "\"\<DensityMatrix\>\"", "]"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[70]:= ",
 CellID->1358245629,ExpressionUUID->"5b82e386-6ff5-c0ee-09b1-fae009819234"],

Cell["Heisenberg evolution of annihilation operator", "Subsection",
 CellID->2020715939,ExpressionUUID->"34a39a2f-b372-ffce-5c50-1388c604c514"],

Cell[TextData[{
 "In the Heisenberg picture, the annihilation operator evolves as ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], "\[ThinSpace]", 
     StyleBox["\[Omega]", "TI"], "\[ThinSpace]", 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66ca9132-7812-8248-0ec9-097c79a4d092"],
 ". We can reproduce this using super-operators in the framework."
}], "Text",
 CellID->1652125120,ExpressionUUID->"023b1c4a-5b09-a8c9-33d8-96145ebdfa13"],

Cell["Define the Hamiltonian:", "Text",
 CellID->1271733325,ExpressionUUID->"29a4f364-fd74-7ca4-5f5b-eb41f401468e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H", " ", "=", " ", 
   RowBox[{"\[HBar]", " ", "\[Omega]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"SuperDagger", "[", "a", "]"}], "@", "a"}], " ", "+", " ", 
      RowBox[{"1", "/", "2"}]}], ")"}]}]}], ";"}]], "Input",
 CellLabel->"In[71]:= ",
 CellID->163945760,ExpressionUUID->"47740231-7fc8-4299-6d0b-a47b7a7d10e3"],

Cell["Construct the evolution super-operator:", "Text",
 CellID->872684874,ExpressionUUID->"1af52337-5e42-c8c3-4a8a-bb715bf49a29"],

Cell[BoxData[
 RowBox[{
  RowBox[{"exp\[ScriptCapitalH]", " ", "=", " ", "\n", "  ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Hamiltonian\>\"", "[", 
       RowBox[{"H", "/", "\[HBar]"}], "]"}], "]"}], " ", "t"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[72]:= ",
 CellID->465017216,ExpressionUUID->"2fdb82dc-2353-e9b3-55f8-1b8656e7bb99"],

Cell["Evolve the operator:", "Text",
 CellID->673931302,ExpressionUUID->"5782d92f-a790-094a-7db1-d088d2255b90"],

Cell[BoxData[
 RowBox[{
  RowBox[{"heisenbergAnnihilation", " ", "=", " ", "\n", "  ", 
   RowBox[{"Simplify", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"exp\[ScriptCapitalH]", "[", "\"\<Dagger\>\"", "]"}], "[", 
       RowBox[{"a", "[", "\"\<MatrixQuantumState\>\"", "]"}], "]"}], "[", 
      "\n", "    ", "\"\<Operator\>\"", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "\[Omega]"}], "}"}], " ", "\[Element]", " ", 
      "Reals"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[73]:= ",
 CellID->1757804831,ExpressionUUID->"05d48452-325d-a277-33eb-1e1c47e9f15d"],

Cell["Compare the result to the known result of quantum mechanics:", "Text",
 CellID->273265946,ExpressionUUID->"087ffcf6-194e-431e-3804-f5b098fb2e64"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", " ", 
   RowBox[{"E", "^", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "\[Omega]", " ", "t"}], ")"}]}]}], " ", "==", 
  " ", "heisenbergAnnihilation"}]], "Input",
 CellLabel->"In[74]:= ",
 CellID->1690214831,ExpressionUUID->"615fadf7-df9a-5675-1764-44b0da2f3d5f"],

Cell["Quasi-probability Representations", "Section",
 CellID->134683244,ExpressionUUID->"5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"],

Cell["\<\
Two phase-space quasi-probability representations are included: Wigner and \
HusimiQ. They are used extensively in quantum mechanics and quantum optics. \
Each is computed numerically on a grid of phase-space points and returns an \
interpolating function. Glauber representation is not included because, for a \
general state, a stable numerical algorithm is not feasible due to highly \
singular behavior.\
\>", "Text",
 CellID->1556257858,ExpressionUUID->"2d0df906-1ebb-1081-5b32-f1609b4e62eb"],

