}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "For a Fock state |n\[RightAngleBracket] with n > 0, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["g", 
    RowBox[{"(", "2", ")"}]], "=", 
   RowBox[{"1", "-", 
    RowBox[{"1", "/", "n"}]}]}]],ExpressionUUID->
