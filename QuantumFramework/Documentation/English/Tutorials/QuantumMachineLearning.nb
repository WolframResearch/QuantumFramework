Cell["Details", "Section",
 CellID->1820947576,ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell[TextData[{
 Cell[BoxData["\"\<NetGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],
 " is a valid ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b45e796-37a7-eecc-197a-fed04253b416"],
 " value for ",
 Cell[BoxData["TensorNetworkContraction"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 " but is deliberately absent from ",
 Cell[BoxData[
  StyleBox["Wolfram`TensorNetworks`$TensorNetworkContractionMethods", 
   "InlineCode"]], "InlineCode",ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 ", which lists the interchangeable methods that all return arrays."
}], "Item",
 CellID->670734585,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell[TextData[{
 "A compiled circuit is a source net: no input ports, and an output port \
carrying the shape. That is what makes it an array container in the ",
 Cell[BoxData[
  StyleBox["Wolfram`Arrays`", "InlineCode"]], "InlineCode",ExpressionUUID->
  "58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],
 " sense, and what lets it be a node inside a larger net."
}], "Item",
 CellID->58232708,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

Cell[TextData[{
 "The gate array sits at ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<tensor\>\"", ",", " ", "\"\<Array\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c54d9-3079-6bba-5c24-4d83410c3980"],
 " in a gate-only circuit; a multi-tensor circuit names its leaves ",
 Cell[BoxData["\"\<tensor1\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],
 ", ",
 Cell[BoxData["\"\<tensor2\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f449897-1a0e-51e7-357b-11d19fbb23cd"],
 " and so on, which ",
 Cell[BoxData[
  RowBox[{"NetExtract", "[", 
   RowBox[{"net", ",", " ", "All"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],
 " lists."
}], "Item",
 CellID->393464600,ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

Cell["Possible Issues", "Section",
 CellID->1484396876,ExpressionUUID->"07359582-e823-44a1-2eca-0cef89d62e8b"],

Cell[TextData[{
 "Without ",
 Cell[BoxData[
  RowBox[{"\"\<Computational\>\"", " ", "->", " ", "False"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c239bd0-3ff5-3b18-25d0-129ab9818662"],
 " the compiled tensors carry basis-change factors from the computational \
frame and are complex, and complex arrays cannot be lifted into net layers, \
so the contraction names the offending tensor and fails:"
}], "Text",
 CellID->1149283354,ExpressionUUID->"68c76573-72ce-0c1a-18fd-7d3d077b5760"],

