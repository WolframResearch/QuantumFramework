Cell["The Gate as a Trainable Parameter", "Section",
 CellID->339082558,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell[TextData[{
 "To train a gate rather than a state, compile the gate alone. With ",
 Cell[BoxData[
  RowBox[{"\"\<PrependInitial\>\"", " ", "->", " ", "False"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "608e87cc-8fce-afdf-10b5-1e962a78f525"],
 " no initial state is attached, and the net's output is the gate's own \
phase-space kernel:"
}], "Text",
 CellID->432388834,ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gate", "[", "theta_", "]"}], " ", ":=", " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"QuantumPhaseSpaceTransform", "[", 
         RowBox[{"QuantumCircuitOperator", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<RY\>\"", "[", "theta", "]"}], "}"}], "]"}], "]"}]}], ",",
        " ", "t"}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"t", " ", "=", " ", 
       RowBox[{"p", "[", 
        RowBox[{"\"\<TensorNetwork\>\"", ",", " ", 
         RowBox[{"\"\<Computational\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<PrependInitial\>\"", " ", "->", " ", "False"}]}], 
        "]"}]}], ";", "\n", "    ", 
      RowBox[{"TensorNetworkContraction", "[", 
       RowBox[{"t", ",", " ", 
        RowBox[{"GreedyContractionPath", "[", "t", "]"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<NetGraph\>\""}]}], "]"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gate", "[", "0.7", "]"}], "[", "]"}]}], "Input",
 CellLabel->"In[13]:= ",
 CellID->930323300,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1.`", ",", "0.`", ",", "0.`", ",", "0.`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "0.`", ",", "0.7648422122001648`", ",", "0.6442176699638367`", ",", 
     "0.`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.`", ",", 
     RowBox[{"-", "0.6442176699638367`"}], ",", "0.7648422122001648`", ",", 
     "0.`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.`", ",", "0.`", ",", "0.`", ",", "1.`"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[13]= ",
 CellID->312909297,ExpressionUUID->"337c2d89-644e-5b5e-6103-c4d30dfb29a4"]
}, Open  ]],

Cell["\<\
The kernel is a rotation by the angle in its middle block, so the angle can \
be read straight off it:\
\>", "Text",
 CellID->1593449978,ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ArcTan", " ", "@@", " ", 
  RowBox[{
   RowBox[{"Chop", "[", 
    RowBox[{
     RowBox[{"gate", "[", "0.7", "]"}], "[", "]"}], "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"2", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->470259450,ExpressionUUID->"644cc522-c7c4-9b18-0c73-dc8ff276e662"],

