Cell[TextData[{
 "Training is then ordinary ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NetTrain"]], "paclet:ref/NetTrain"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],
 ": one example, the net's own ",
