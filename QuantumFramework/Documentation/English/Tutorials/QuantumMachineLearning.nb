Cell[TextData[{
 "Training is then ordinary ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NetTrain"]], "paclet:ref/NetTrain"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bba82b81-71a4-4f60-a115-f042bb0bd321"],
 ": one example, the net's own ",
 Cell[BoxData["\"\<Loss\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e148ac8-3ba9-4eba-8243-12dc2c0dbff8"],
 " port as the objective, and the gate array is what gets updated."
}], "Text",ExpressionUUID->"565b3efa-d605-4fe2-965e-61f3c107ee20"],

