Cell["Learning the Angle", "Section",
 CellID->29467524,ExpressionUUID->"6801f052-da94-0b6f-183e-ea1fdf2159b5"],

Cell[TextData[{
 "Take the circuit at 0.7 as the target and a circuit at 0 as the model. The \
only thing built by hand is the loss: the compiled circuit becomes one node \
of a net whose other node is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MeanAbsoluteLossLayer"]], "paclet:ref/MeanAbsoluteLossLayer"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0daf8e98-7628-e40b-3b54-27c203c2cf51"],
 "."
}], "Text",
 CellID->1939141443,ExpressionUUID->"7b6211f5-475c-1194-2911-88bf72e963fe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"target", " ", "=", " ", 
   RowBox[{
    RowBox[{"gate", "[", "0.7", "]"}], "[", "]"}]}], ";"}], "\n", 
 RowBox[{"lossNet", " ", "=", " ", 
  RowBox[{"NetGraph", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<circuit\>\"", " ", "->", " ", 
       RowBox[{"gate", "[", "0.", "]"}]}], ",", " ", 
      RowBox[{"\"\<loss\>\"", " ", "->", " ", 
       RowBox[{"MeanAbsoluteLossLayer", "[", "]"}]}]}], "|>"}], ",", "\n", 
    "    ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<circuit\>\"", " ", "->", " ", 
       RowBox[{"NetPort", "[", 
        RowBox[{"\"\<loss\>\"", ",", " ", "\"\<Input\>\""}], "]"}]}], ",", 
      " ", 
      RowBox[{
       RowBox[{"NetPort", "[", "\"\<Target\>\"", "]"}], " ", "->", " ", 
       RowBox[{"NetPort", "[", 
        RowBox[{"\"\<loss\>\"", ",", " ", "\"\<Target\>\""}], "]"}]}]}], 
     "}"}]}], "]"}]}]}], "Input",
 CellLabel->"In[15]:= ",
 CellID->1814428022,ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

