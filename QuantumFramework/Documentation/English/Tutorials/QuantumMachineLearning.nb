Cell["\<\
The net takes no input and its output is the state the circuit produces, so \
running it gives the Wigner vector directly - no separate state extraction:\
\>", "Text",ExpressionUUID->"13403876-46bd-48e4-9022-a09349b27f3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"net", "[", "]"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"0b572a98-23e3-49c0-a4d8-554cbfc12abb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.25`", ",", "0.16105441749095917`", ",", "0.1912105530500412`", ",", 
   "0.`"}], "}"}]], "Output",
 CellLabel->
  "Out[10]= ",ExpressionUUID->"b39bc5f3-1ba9-45ec-b3f6-ebda20faeefb"]
}, Open  ]],

Cell["\<\
That is the Wigner vector of the state an RY rotation by 0.7 produces from \
the initial one:\
\>", "Text",ExpressionUUID->"6407df88-11c8-4ae0-9b93-be9d3cd62a78"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"QuantumPhaseSpaceTransform", "[", 
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "0.35", "]"}], ",", " ", 
         RowBox[{"Sin", "[", "0.35", "]"}]}], "}"}], "]"}], "]"}], 
     "[", "\"\<StateVector\>\"", "]"}], "]"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"4310a736-adeb-46e0-bba0-77c72f4c8d9b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.25`", ",", "0.16105442180942278`", ",", "0.1912105468211221`", ",", 
   "0"}], "}"}]], "Output",
 CellLabel->
  "Out[11]= ",ExpressionUUID->"bd58d7c9-39db-4d1d-88fc-115fecb8274f"]
}, Open  ]],

Cell["\<\
Because the net is a source net, it is also an array container: its shape \
reads off the output port with nothing evaluated:\
\>", "Text",ExpressionUUID->"eedd18c6-ee18-445e-8931-bf4d4df948c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ArrayDimensions", "[", "net", "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"4bb1ab8f-6d63-44a7-aa74-896e005c0587"],

Cell[BoxData[
 RowBox[{"{", "4", "}"}]], "Output",
 CellLabel->
  "Out[12]= ",ExpressionUUID->"8e95e25b-e169-41c4-8284-7635b284438e"]
}, Open  ]],

Cell["The Gate as a Trainable Parameter", "Section",ExpressionUUID->"134d5c44-78da-4bc2-b297-b6025cf1d564"],

Cell[TextData[{
 "To train a gate rather than a state, compile the gate alone. With ",
 Cell[BoxData[
  RowBox[{"\"\<PrependInitial\>\"", " ", "->", " ", "False"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4b49b7a-c2ce-43b9-8f2d-dad79d4827d0"],
 " no initial state is attached, and the net's output is the gate's own \
phase-space kernel:"
}], "Text",ExpressionUUID->"625d7daa-b508-4221-8a72-fc04e52b3a90"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gate", "[", "theta_", "]"}], " ", ":=", " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"QuantumPhaseSpaceTransform", "[", 
         RowBox[{"QuantumCircuitOperator", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<RY\>\"", "[", "theta", "]"}], "}"}], "]"}], "]"}]}], ",",
        " ", "t"}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"t", " ", "=", " ", 
       RowBox[{"p", "[", 
        RowBox[{"\"\<TensorNetwork\>\"", ",", " ", 
         RowBox[{"\"\<Computational\>\"", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"\"\<PrependInitial\>\"", " ", "->", " ", "False"}]}], 
        "]"}]}], ";", "\n", "    ", 
      RowBox[{"TensorNetworkContraction", "[", 
       RowBox[{"t", ",", " ", 
        RowBox[{"GreedyContractionPath", "[", "t", "]"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<NetGraph\>\""}]}], "]"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gate", "[", "0.7", "]"}], "[", "]"}]}], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"b10f6ce8-9177-4c5a-b1e6-e99203dc72f9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1.`", ",", "0.`", ",", "0.`", ",", "0.`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "0.`", ",", "0.7648422122001648`", ",", "0.6442176699638367`", ",", 
     "0.`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.`", ",", 
     RowBox[{"-", "0.6442176699638367`"}], ",", "0.7648422122001648`", ",", 
     "0.`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.`", ",", "0.`", ",", "0.`", ",", "1.`"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"414ec229-a741-4f1a-8e30-e9aadcb2ddd1"]
}, Open  ]],

Cell["\<\
The kernel is a rotation by the angle in its middle block, so the angle can \
be read straight off it:\
\>", "Text",ExpressionUUID->"358c56e6-8593-479d-b964-bc8a64b93040"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ArcTan", " ", "@@", " ", 
  RowBox[{
   RowBox[{"Chop", "[", 
    RowBox[{
     RowBox[{"gate", "[", "0.7", "]"}], "[", "]"}], "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"2", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"fe84c8c9-8ecf-4653-ba56-3310549c5a5d"],

Cell[BoxData["0.6999999707371083`"], "Output",
 CellLabel->
  "Out[14]= ",ExpressionUUID->"e1ea61b9-9343-42e3-aa6a-f271fb49a408"]
}, Open  ]],

Cell["Learning the Angle", "Section",ExpressionUUID->"d9c3aaf2-129d-4b5d-aeac-3b04ad3a6a1b"],

Cell[TextData[{
 "Take the circuit at 0.7 as the target and a circuit at 0 as the model. The \
only thing built by hand is the loss: the compiled circuit becomes one node \
of a net whose other node is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MeanAbsoluteLossLayer"]], "paclet:ref/MeanAbsoluteLossLayer"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d4b93dd1-eb56-4492-b309-8649d8ac8786"],
 "."
}], "Text",ExpressionUUID->"1616f4bf-ce49-4edf-a3da-ac962e7ebf41"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"target", " ", "=", " ", 
   RowBox[{
    RowBox[{"gate", "[", "0.7", "]"}], "[", "]"}]}], ";"}], "\n", 
 RowBox[{"lossNet", " ", "=", " ", 
  RowBox[{"NetGraph", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<circuit\>\"", " ", "->", " ", 
       RowBox[{"gate", "[", "0.", "]"}]}], ",", " ", 
      RowBox[{"\"\<loss\>\"", " ", "->", " ", 
       RowBox[{"MeanAbsoluteLossLayer", "[", "]"}]}]}], "|>"}], ",", "\n", 
    "    ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<circuit\>\"", " ", "->", " ", 
       RowBox[{"NetPort", "[", 
        RowBox[{"\"\<loss\>\"", ",", " ", "\"\<Input\>\""}], "]"}]}], ",", 
      " ", 
      RowBox[{
       RowBox[{"NetPort", "[", "\"\<Target\>\"", "]"}], " ", "->", " ", 
       RowBox[{"NetPort", "[", 
        RowBox[{"\"\<loss\>\"", ",", " ", "\"\<Target\>\""}], "]"}]}]}], 
     "}"}]}], "]"}]}]}], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"d1860c9e-4977-42a2-b6fd-a3c94199ce8e"],

