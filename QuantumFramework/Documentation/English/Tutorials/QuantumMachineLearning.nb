   "0.`"}], "}"}]], "Output",
 CellLabel->"Out[10]= ",
 CellID->1468078176,ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"]
}, Open  ]],

Cell["\<\
That is the Wigner vector of the state an RY rotation by 0.7 produces from \
the initial one:\
\>", "Text",
 CellID->1930159659,ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"QuantumPhaseSpaceTransform", "[", 
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "0.35", "]"}], ",", " ", 
         RowBox[{"Sin", "[", "0.35", "]"}]}], "}"}], "]"}], "]"}], 
     "[", "\"\<StateVector\>\"", "]"}], "]"}], "]"}], "]"}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->1960700846,ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],

