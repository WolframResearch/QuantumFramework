Cell["Details", "Section",ExpressionUUID->"ce90e8e1-ff77-42c6-b4dc-03fc39b60428"],

Cell[TextData[{
 Cell[BoxData["\"\<NetGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41fb08a3-166f-4f11-8d76-6765fdc5a3c3"],
 " is a valid ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb24621b-28bc-4179-8d07-9d607bb626b0"],
 " value for ",
 Cell[BoxData["TensorNetworkContraction"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53290849-1eab-4837-abe4-c041152f8b58"],
 " but is deliberately absent from ",
 Cell[BoxData[
  StyleBox["Wolfram`TensorNetworks`$TensorNetworkContractionMethods", 
   "InlineCode"]], "InlineCode",ExpressionUUID->
  "3a5cb8db-8a38-4d8f-913d-4df2db6e80fb"],
 ", which lists the interchangeable methods that all return arrays."
}], "Item",ExpressionUUID->"f55cd3bd-18b1-4077-afb4-c7d77cf4c393"],

Cell[TextData[{
 "A compiled circuit is a source net: no input ports, and an output port \
carrying the shape. That is what makes it an array container in the ",
 Cell[BoxData[
  StyleBox["Wolfram`Arrays`", "InlineCode"]], "InlineCode",ExpressionUUID->
  "e881bb60-497b-4288-b987-8432d5db0f0b"],
 " sense, and what lets it be a node inside a larger net."
}], "Item",ExpressionUUID->"ff06b3ac-2915-42d9-8898-132c6825e8b5"],

Cell[TextData[{
 "The gate array sits at ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<tensor\>\"", ",", " ", "\"\<Array\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "782200d8-6f41-4e2f-8117-08d3777fff4a"],
 " in a gate-only circuit; a multi-tensor circuit names its leaves ",
 Cell[BoxData["\"\<tensor1\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2a9ea64-49ef-414a-978f-d3c43cd088cb"],
 ", ",
 Cell[BoxData["\"\<tensor2\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d4db558-d0b9-4923-a3fe-5dafff2b6ef6"],
 " and so on, which ",
 Cell[BoxData[
  RowBox[{"NetExtract", "[", 
   RowBox[{"net", ",", " ", "All"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f282700b-c3f5-41dd-bd88-ca853fc0846b"],
 " lists."
}], "Item",ExpressionUUID->"f559cd22-6c21-4252-bf78-721ab1b2740d"],

Cell["Possible Issues", "Section",ExpressionUUID->"a4f3110e-f5a7-414e-9474-8fa5b9a3b042"],

Cell[TextData[{
 "Without ",
 Cell[BoxData[
  RowBox[{"\"\<Computational\>\"", " ", "->", " ", "False"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34283a18-9bc0-48be-a44f-5783933fb5a2"],
 " the compiled tensors carry basis-change factors from the computational \
frame and are complex, and complex arrays cannot be lifted into net layers, \
so the contraction names the offending tensor and fails:"
}], "Text",ExpressionUUID->"19cc01bf-d516-425b-a392-ebaadd04aba4"],

