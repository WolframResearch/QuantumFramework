         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}]}],
       ")"}], " ", "&"}], "@", "\n", "   ", "meas14"}], "]"}]}]], "Input",
 CellLabel->"In[41]:= ",
 CellID->530919167,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell["Plug them into Bell\[CloseCurlyQuote]s inequality:", "Text",
 CellID->1242319925,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"cor12", " ", "-", " ", "cor14"}], "]"}], " ", "+", " ", 
   RowBox[{"Abs", "[", 
    RowBox[{"cor32", " ", "+", " ", "cor34"}], "]"}]}], " ", "<=", " ", 
  "2"}]], "Input",
 CellLabel->"In[42]:= ",
 CellID->1600082692,ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"],

Cell["Plot the region that Bell\[CloseCurlyQuote]s inequality (above) is \
violated:", "Text",
 CellID->1091979148,ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],

Cell[BoxData[
 RowBox[{"NumberLinePlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Not", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"cor12", " ", "-", " ", "cor14"}], "]"}], " ", "+", " ", 
      RowBox[{"Abs", "[", 
       RowBox[{"cor32", " ", "+", " ", "cor34"}], "]"}]}], " ", "<=", " ", 
     "2"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Phi]", ",", " ", "0", ",", " ", "\n", "  ", 
     RowBox[{"2", " ", 
      RowBox[{"\[Pi]", "/", "3"}]}]}], "}"}], ",", " ", 
   RowBox[{"Ticks", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"\[Pi]", "/", "6"}], ",", " ", 
       RowBox[{"\[Pi]", "/", "3"}], ",", " ", 
       RowBox[{"\[Pi]", "/", "2"}], ",", " ", 
       RowBox[{"2", " ", 
        RowBox[{"\[Pi]", "/", "3"}]}]}], "}"}], "}"}]}], ",", " ", "\n", " ", 
   
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<Regions within the Bell's inequality is voilated\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[43]:= ",
 CellID->1239660989,ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],

Cell["\<\
Certainly, the aforementioned circuits may be executed using existing QPUs to \
obtain empirical correlations. However, such findings hold little value \
unless we know the details of experimental setting employed, to address \
problems commonly known as \[OpenCurlyDoubleQuote]loopholes\
\[CloseCurlyDoubleQuote] (such as the locality loophole).\
\>", "Text",
 CellID->234435634,ExpressionUUID->"51fce014-dca1-0630-0783-fa51d5546d1a"],

