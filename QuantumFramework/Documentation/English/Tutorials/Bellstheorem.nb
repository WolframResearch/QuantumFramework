Notebook[{

Cell[CellGroupData[{
Cell["Bell's Theorem: CHSH inequality", "Title",
 CellID->509267359,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[BoxData[
 RowBox[{"Column", "@", 
  RowBox[{"EntityValue", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Entity", "[", 
     RowBox[{"\"\<Person\>\"", ",", " ", "\"\<JohnStewartBell::364v4\>\""}], 
     "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Image\>\"", ",", " ", "\"\<BirthDate\>\"", ",", " ", "\n", 
      "   ", "\"\<DeathDate\>\"", ",", " ", "\"\<NotableFacts\>\""}], "}"}]}],
    "]"}]}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->329621944,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell["\<\
Bell's inequalities are examined within the Wolfram quantum framework, using \
the standard language of quantum computation. A straightforward computational \
approach is employed to comprehend the underlying derivations of those \
equations, fully derived from standard quantum computation.\
\>", "Text",
 CellID->515379898,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell["Entangled states, correlations, and measurement", "Section",
 CellID->604760901,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell["\<\
Consider a 2-qubit quantum system that is prepared in the following quantum \
state\
\>", "Text",
 CellID->1476799103,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell[BoxData[
 RowBox[{"\[Psi]m", " ", "=", " ", 
  RowBox[{"QuantumState", "[", "\"\<PsiMinus\>\"", "]"}]}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->448336599,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell["Check if it is an entangled state:", "Text",
 CellID->970785311,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell[BoxData[
 RowBox[{"QuantumEntangledQ", "[", "\[Psi]m", "]"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->1377816002,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell["which is, of course, maximally entangled:", "Text",
 CellID->1439899046,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[BoxData[
 RowBox[{"QuantumEntanglementMonotone", "[", "\[Psi]m", "]"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->1641200340,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell[TextData[{
 "An entangled state is a state that cannot be written as product of two \
states ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "1"], "\[CircleTimes]", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 ". This possibility can be tested using ",
 ButtonBox["QuantumEntangledQ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/PacletRepository/resources/\
Wolfram/QuantumFramework/ref/QuantumEntangledQ.html"], None}],
 " which returns as True or False."
}], "Text",
 CellID->1424533854,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"],

Cell["\<\
Let\[CloseCurlyQuote]s define a unit vector in 3D (which is parametrized by \
two angles):\
\>", "Text",
 CellID->535457321,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", "[", 
   RowBox[{"\[Theta]_", ",", " ", "\[Phi]_"}], "]"}], " ", ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
     RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", " ", "\n", "  ", 
    RowBox[{
     RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
     RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", " ", 
    RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->141959522,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell["Given two unit vectors, let\[CloseCurlyQuote]s find the angle \
between:", "Text",
 CellID->299517738,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell[BoxData[
 RowBox[{"vecAngle", " ", "=", " ", "\n", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"VectorAngle", "[", 
     RowBox[{
      RowBox[{"a", "[", 
       RowBox[{"\[Theta]1", ",", " ", "\[Phi]1"}], "]"}], ",", " ", 
      RowBox[{"a", "[", 
       RowBox[{"\[Theta]2", ",", " ", "\[Phi]2"}], "]"}]}], "]"}], ",", "\n", 
    "   ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Theta]1", " ", "\[Element]", " ", "Reals"}], ",", " ", 
       RowBox[{"\[Theta]2", " ", "\[Element]", " ", "\n", "     ", "Reals"}], 
       ",", " ", 
       RowBox[{"\[Phi]1", " ", "\[Element]", " ", "Reals"}], ",", " ", 
       RowBox[{"\[Phi]2", " ", "\[Element]", " ", "Reals"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->2142391071,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell[TextData[{
 "Now let us calculate the quantum expectation (i.e. the mean value) of a \
composite operator as follows: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SuperscriptBox[
      StyleBox["\[Psi]", "TI"], "-"]},
    "Bra"], 
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "\[RightVector]"], "1"], ".", 
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], "\[CircleTimes]", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "\[RightVector]"], "2"], ".", 
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]}], 
   TemplateBox[{
     SuperscriptBox[
      StyleBox["\[Psi]", "TI"], "-"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23253b8d-1c99-a6bf-52da-b2d7952d0c85"],
 " with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SuperscriptBox[
      StyleBox["\[Psi]", "TI"], "-"]},
    "Ket"], "=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox["2"]], 
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{"01"},
       "Ket"], "-", 
      TemplateBox[{"10"},
       "Ket"]}], ")"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e84829b-9667-6594-16bb-1bc523124ffe"],
 " and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["\[Sigma]", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e173f-6b36-b240-7ea5-8f790ec000aa"],
 " the Pauli vector."
}], "Text",
 CellID->1002769646,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

Cell["Define a Pauli vector:", "Text",
 CellID->436346740,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Sigma]", "[", 
   RowBox[{"\[Theta]_", ",", " ", "\[Phi]_"}], "]"}], " ", ":=", " ", "\n", 
  " ", 
  RowBox[{"QuantumOperator", "[", 
   RowBox[{
    RowBox[{"a", "[", 
     RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "]"}], " ", ".", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "i", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->2122865143,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell[TextData[{
 "Calculate ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SuperscriptBox[
      StyleBox["\[Psi]", "TI"], "-"]},
    "Bra"], 
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "\[RightVector]"], "1"], ".", 
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], "\[CircleTimes]", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "\[RightVector]"], "2"], ".", 
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]}], 
   TemplateBox[{
     SuperscriptBox[
      StyleBox["\[Psi]", "TI"], "-"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76dfbc62-92ac-7b6e-1ee4-364c275949b4"],
 ":"
}], "Text",
 CellID->1735808809,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]m", "[", "\"\<Dagger\>\"", "]"}], "[", "\n", " ", 
  RowBox[{
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"\[Sigma]", "[", 
      RowBox[{"\[Theta]1", ",", " ", "\[Phi]1"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\\\n", "\[Sigma]"}], "[", 
      RowBox[{"\[Theta]2", ",", " ", "\[Phi]2"}], "]"}]}], "]"}], "[", 
   "\[Psi]m", "]"}], "]"}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->753514147,ExpressionUUID->"4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],

Cell["\<\
Note that the result is a scalar, but as an object, we treat it as a quantum \
state object, with 0 number of qudits (look at the summary box of above \
result). The actual scalar number can be extracted like this:\
\>", "Text",
 CellID->1164297175,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell[BoxData[
 RowBox[{"\[CapitalPhi]12", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"%", "[", "\"\<Number\>\"", "]"}], "]"}]}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->632614636,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell["\<\
The expectation value is related to the vector angle as follows:\
\>", "Text",
 CellID->1689610856,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   RowBox[{"Cos", "[", "vecAngle", "]"}]}], " ", "==", " ", 
  "\[CapitalPhi]12"}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->1303163127,ExpressionUUID->"3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],

Cell[TextData[{
 "In other words: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox[
       StyleBox["\[Psi]", "TI"], "-"]},
     "Bra"], 
    RowBox[{
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "\[RightVector]"], "1"], ".", 
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], "\[CircleTimes]", 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "\[RightVector]"], "2"], ".", 
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]}], 
    TemplateBox[{
      SuperscriptBox[
       StyleBox["\[Psi]", "TI"], "-"]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{"-", 
     StyleBox["c", "TI"]}], 
    StyleBox["o", "TI"], 
    StyleBox["s", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     SubscriptBox["\[CapitalPhi]", "12"], 
     StyleBox[")",
      SpanMaxSize->1]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbaaaf7-1388-e538-4b59-43b1a622cc02"],
 " Remember this result. We will use it later within Bell\[CloseCurlyQuote]s \
inequality. But before jumping to Bell\[CloseCurlyQuote]s inequality, let\
\[CloseCurlyQuote]s explore how above expectation value can be calculated or \
obtained experimentally using quantum circuits."
}], "Text",
 CellID->2098230307,ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell["\<\
For simplicity, let\[CloseCurlyQuote]s consider the case where qubit-1 is \
measured in Pauli-X basis, and qubit-2 in another basis which obtained by \
rotating Pauli-X basis by \[Pi]/8 around z-axis\
\>", "Text",
 CellID->1930159659,ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"],

Cell["\<\
Define new basis (Pauli-X which is rotated by \[Pi]/8 around z-axis) and \
label it:\
\>", "Text",
 CellID->1113655915,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"newBasis", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumBasis", "[", 
    RowBox[{
     RowBox[{"N", "@", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<RZ\>\"", ",", " ", 
          RowBox[{"\[Pi]", "/", "8"}]}], "}"}], "]"}], "[", 
       RowBox[{"QuantumBasis", "[", "\"\<X\>\"", "]"}], "]"}]}], ",", " ", 
     "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "\n", 
      "    ", "\"\<\!\(\*SubscriptBox[\((\*FractionBox[\(\[Pi]\), \(8\)])\), \
\(xz\)]\)\>\""}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->1606118752,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell["\<\
Note I added N, just to enforce numeric calculations, which are faster.\
\>", "Text",
 CellID->2141499446,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell[TextData[{
 "Measure in Pauli-X basis on qubit-1, in new basis on qubit-2, when the \
system is prepared in ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Psi]", "TI"], "-"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f908cf3-3c70-d55a-45af-25bdb50abfa0"],
 ":"
}], "Text",
 CellID->339082558,ExpressionUUID->"5dac66ba-272d-3627-0b54-7fe452d99d0d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"meas", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumMeasurementOperator", "[", "\"\<X\>\"", "]"}], "@", "\n", 
    "   ", 
    RowBox[{
     RowBox[{"QuantumMeasurementOperator", "[", 
      RowBox[{"newBasis", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], "@", 
     RowBox[{"QuantumState", "[", "\"\<PsiMinus\>\"", "]"}]}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->432388834,ExpressionUUID->"110914de-bbdd-83a1-4736-8d983e69d18b"],

Cell["Find the measurement probabilities:", "Text",
 CellID->443736588,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell[BoxData[
 RowBox[{"prob", " ", "=", " ", 
  RowBox[{"meas", "[", "\"\<Probabilities\>\"", "]"}]}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->1593449978,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell["\<\
Note the first and last results correspond to + eigenvalue (their \
multiplication) and middle ones -. So for the mean value, we do as follows:\
\>", "Text",
 CellID->1742646261,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell[BoxData[
 RowBox[{
  RowBox[{"prob", "[", 
   RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
  RowBox[{"prob", "[", 
   RowBox[{"[", "4", "]"}], "]"}], " ", "-", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"prob", "[", 
     RowBox[{"[", "2", "]"}], "]"}], " ", "+", " ", 
    RowBox[{"prob", "[", 
     RowBox[{"[", "3", "]"}], "]"}]}], ")"}]}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->29467524,ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell[TextData[{
 "Taking ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], 
   StyleBox["o", "TI"], 
   SuperscriptBox[
    StyleBox["s", "TI"], 
    RowBox[{"-", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 " of above result (note ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox[
       StyleBox["\[Psi]", "TI"], "-"]},
     "Bra"], 
    RowBox[{
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "\[RightVector]"], "1"], ".", 
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], "\[CircleTimes]", 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "\[RightVector]"], "2"], ".", 
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]}], 
    TemplateBox[{
      SuperscriptBox[
       StyleBox["\[Psi]", "TI"], "-"]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{"-", 
     StyleBox["c", "TI"]}], 
    StyleBox["o", "TI"], 
    StyleBox["s", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     SubscriptBox["\[CapitalPhi]", "12"], 
     StyleBox[")",
      SpanMaxSize->1]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 ") one can confirm:"
}], "Text",
 CellID->1939141443,ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ArcCos", "[", 
   RowBox[{"-", "%"}], "]"}], " ", "==", " ", 
  RowBox[{"\[Pi]", "/", "8"}]}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->5047578,ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"],

Cell["\<\
which is what we expected. Now let\[CloseCurlyQuote]s focus on the circuit \
version.\
\>", "Text",
 CellID->15008895,ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],

Cell[TextData[{
 "The following quantum circuit prepare a 2-qubit quantum system in ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Psi]", "TI"], "-"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 " first, and then two measurements are performed on 2-qubits (as described \
previously)."
}], "Text",
 CellID->1892712309,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc1", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"QuantumCircuitOperator", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<X\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", "\n", 
          "      ", "\"\<H\>\"", ",", " ", "\"\<CNOT\>\""}], "}"}], ",", " ", 
        "\n", "     ", "\"\<Circuit to create \
\!\(\*SuperscriptBox[\(\[Psi]\), \(-\)]\)\>\""}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"\\\n", 
        RowBox[{"{", 
         RowBox[{"\"\<RZ\>\"", ",", " ", 
          RowBox[{"\[Pi]", "/", "8"}]}], "}"}]}], " ", "->", " ", "2"}], ",", 
      " ", 
      RowBox[{"\"\<H\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
      RowBox[{"{", "1", "}"}], ",", " ", 
      RowBox[{"{", "2", "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"qc1", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[16]:= ",
 CellID->787969749,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell["\<\
The above circuit is the one you see in many literature, mostly because that \
is how you send it to a Quantum Processing Unit (QPU, ie a quantum hardware). \
However, in our framework, you can define the measurement in any basis, for \
example:\
\>", "Text",
 CellID->525088789,ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc2", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"QuantumCircuitOperator", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<X\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", "\n", 
          "      ", "\"\<H\>\"", ",", " ", "\"\<CNOT\>\""}], "}"}], ",", " ", 
        "\n", "     ", "\"\<Circuit to create \
\!\(\*SuperscriptBox[\(\[Psi]\), \(-\)]\)\>\""}], "]"}], ",", " ", "\n", 
      "    ", 
      RowBox[{"QuantumMeasurementOperator", "[", "\"\<X\>\"", "]"}], ",", " ",
       "\n", "    ", 
      RowBox[{"QuantumMeasurementOperator", "[", 
       RowBox[{"newBasis", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"qc2", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[17]:= ",
 CellID->357930410,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell[TextData[{
 "Note that those light purple boxes representing measurement are \
fundamentally different from other boxes representing usual gates. But that \
is a different story (",
 ButtonBox["refer to this for more details",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/0806.0647.pdf"], None}],
 ")."
}], "Text",
 CellID->1802489801,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell["\<\
The above circuits are equivalent. However, for the sake of communicating \
with a QPU, some transpilers may have some issues with defining measurements \
for a customized basis. So let\[CloseCurlyQuote]s focus on first circuit:\
\>", "Text",
 CellID->115301326,ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"],

Cell[BoxData[
 RowBox[{"qc1", "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[18]:= ",
 CellID->1651187567,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell[TextData[{
 "In above circuit, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "\[RightVector]"], "1"], "\[Rule]", "{", 
    StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "2"}], ",", 
   RowBox[{
    StyleBox["\[Phi]", "TI"], "=", "0", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 " (measurement on qubit-1) and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "\[RightVector]"], "2"], "\[Rule]", "{", 
    StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "2"}], ",", 
   RowBox[{
    StyleBox["\[Phi]", "TI"], "=", "\[Pi]", "/", "8", "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 " (measurement on qubit-2). Note the Hadamard (H) boxes before measurements \
are transforming the measurement to Pauli-X, and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["R", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 " rotation rotates it by an angle in xy-plane. So the correlation function \
should be ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["c", "TI"], 
   StyleBox["o", "TI"], 
   StyleBox["s", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", "/", "8"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"]
}], "Text",
 CellID->941376513,ExpressionUUID->"6801f052-da94-0b6f-183e-ea1fdf2159b5"],

Cell["Find the probabilities from above circuit:", "Text",
 CellID->2120243592,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell[BoxData[
 RowBox[{"prob1", " ", "=", " ", 
  RowBox[{"FullSimplify", " ", "/@", " ", 
   RowBox[{
    RowBox[{"qc1", "[", "]"}], "[", "\"\<Probabilities\>\"", 
    "]"}]}]}]], "Input",
 CellLabel->"In[19]:= ",
 CellID->1047559317,ExpressionUUID->"7b6211f5-475c-1194-2911-88bf72e963fe"],

Cell["Calculate the correlation function:", "Text",
 CellID->1820947576,ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"prob1", "[", "\n", 
    RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}], " ", 
   "+", " ", 
   RowBox[{"prob1", "[", "\n", 
    RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "\n", "    ", 
      RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}], " ", 
   "-", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"prob1", "[", "\n", 
      RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}], 
     " ", "+", " ", 
     RowBox[{"prob1", "[", "\n", 
      RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", "\n", "      ", 
        RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}]}], 
    ")"}]}], " ", "//", " ", "FullSimplify"}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->670734585,ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell["which is, of course, what we expected.", "Text",
 CellID->58232708,ExpressionUUID->"5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],

Cell["\<\
Note that the experimental results that one gets out of a QPU is counters per \
measurement results; something like this:\
\>", "Text",
 CellID->393464600,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell[BoxData[
 RowBox[{"exp", " ", "=", " ", 
  RowBox[{"qc1", "[", "]"}]}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->1484396876,ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

Cell["Simulate measurement results for 1024 shots:", "Text",
 CellID->1149283354,ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"],

Cell[BoxData[
 RowBox[{"counts", " ", "=", " ", 
  RowBox[{"Counts", "[", 
   RowBox[{"exp", "[", 
    RowBox[{"\"\<SimulatedMeasurement\>\"", ",", " ", "1024"}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->1092188694,ExpressionUUID->"4b6e5dad-9702-0c1f-7916-54f722b75765"],

Cell["\<\
Calculate the corresponding correlation (using frequency of occurrence for \
each result):\
\>", "Text",
 CellID->559599970,ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"counts", "[", "\n", 
      RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}], 
     " ", "+", " ", "\n", "  ", 
     RowBox[{"counts", "[", "\n", 
      RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}], 
     " ", "-", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"counts", "[", "\n", 
        RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}], 
       " ", "+", " ", "\n", "    ", 
       RowBox[{"counts", "[", "\n", 
        RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}]}],
       ")"}]}], ")"}], "/", "1024"}], " ", "//", "\n", "  ", "N"}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->1710123944,ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell["\<\
which is what we expected (close enough, given number of shots)\
\>", "Text",
 CellID->934597701,ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   RowBox[{"Cos", "[", 
    RowBox[{"\[Pi]", "/", "8"}], "]"}]}], " ", "//", " ", "N"}]], "Input",
 CellLabel->"In[24]:= ",
 CellID->284780108,ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],

Cell["\<\
Now let\[CloseCurlyQuote]s see how those correlations are used in Bell \
inequality\
\>", "Text",
 CellID->643798763,ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

Cell["Bell\[CloseCurlyQuote]s inequality", "Section",
 CellID->268959046,ExpressionUUID->"25a0bfbe-b1d4-2428-535f-36fbc0668f72"],

Cell[TextData[{
 "There are many good literature on the Bell\[CloseCurlyQuote]s inequality \
and what it implies. If you are looking for a short paper, with some nice \
[personal] history, we highly recommend this preprint by ",
 ButtonBox["GianCarlo Ghirardi",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Giancarlo_Ghirardi"], None}],
 ": ",
 ButtonBox["John Stuart Bell: recollections of a great scientist and a great \
man",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/1411.1425.pdf"], None}],
 "."
}], "Text",
 CellID->403125484,ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell["\<\
Let us rephrase the reasoning behind the derivation of \
Bell\[CloseCurlyQuote]s inequality (following Ghirardi):\
\>", "Text",
 CellID->931950651,ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]Experimental Perfect Correlations\
\[CloseCurlyDoubleQuote] \[And] \
\[OpenCurlyDoubleQuote]Bell\[CloseCurlyQuote]s Locality\
\[CloseCurlyDoubleQuote] ",
 Cell[BoxData["\[DoubleRightArrow]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1ff276-b82a-c3ca-5b24-f43039dc9110"],
 " \[OpenCurlyDoubleQuote]Determinism\[CloseCurlyDoubleQuote]  \
\[OpenCurlyDoubleQuote]Determinism\[CloseCurlyDoubleQuote] \[And] \
\[OpenCurlyDoubleQuote]Bell\[CloseCurlyQuote]s Locality\
\[CloseCurlyDoubleQuote] ",
 Cell[BoxData["\[DoubleRightArrow]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fd1512-f616-8834-3c82-8d5f83a0db1e"],
 " \[OpenCurlyDoubleQuote]Bell\[CloseCurlyQuote]s Inequality\
\[CloseCurlyDoubleQuote]  \[OpenCurlyDoubleQuote]General Quantum Correlations\
\[CloseCurlyDoubleQuote] ",
 Cell[BoxData["\[DoubleRightArrow]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c67103-72a1-9427-0efe-696d0755ff0d"],
 " \[Not] \[OpenCurlyDoubleQuote]Bell\[CloseCurlyQuote]s Inequality\
\[CloseCurlyDoubleQuote]  \
\[Not]\[OpenCurlyDoubleQuote]Bell\[CloseCurlyQuote]s Inequality\
\[CloseCurlyDoubleQuote] ",
 Cell[BoxData["\[DoubleRightArrow]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
 " \[Not] \[OpenCurlyDoubleQuote]Determinism\[CloseCurlyDoubleQuote] \[Or] \
\[Not]\[OpenCurlyDoubleQuote]Bell\[CloseCurlyQuote]s Locality\
\[CloseCurlyDoubleQuote]  Summarizing: \[OpenCurlyDoubleQuote]Natural \
Processes\[CloseCurlyDoubleQuote] ",
 Cell[BoxData["\[DoubleRightArrow]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58ee7ecb-1370-1005-0896-7795a605636f"],
 " \[Not]\[OpenCurlyDoubleQuote]Bell\[CloseCurlyQuote]s Locality\
\[CloseCurlyDoubleQuote], i.e.: ",
 StyleBox["Nature is non-locally causal", "TI"],
 "."
}], "Text",
 CellID->412518898,ExpressionUUID->"11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],

Cell["\<\
From locality to determinism. If distant measurements on the singlet state \
always give opposite results (perfect correlations), and if we insist that \
what happens at one site cannot depend on what happens at the other (Bell's \
Locality), then the outcomes must have been fixed in advance, determinism \
follows as a consequence. If outcomes are predetermined and Bell's Locality \
holds, then the correlations between measurement results are constrained, \
they must satisfy Bell's inequality. Quantum mechanics violates the \
inequality. The correlations predicted by quantum theory (and confirmed by \
experiment) exceed the bound imposed by Bell's inequality. Something must \
give. Since the inequality is violated, at least one of its premises fails: \
either determinism is wrong, or Bell's Locality is wrong (or both). Locality \
fails regardless. Suppose we try to save things by abandoning determinism. \
But then we lose the only local explanation for why perfect correlations \
occur. Without locality, we can't derive determinism, and without \
determinism, we can't locally account for the perfect correlations we \
actually observe. So dropping determinism alone doesn't help; locality must \
fail too.\
\>", "Text",
 CellID->622967176,ExpressionUUID->"7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],

Cell["\<\
Well, if anything, let's comment on Bell\[CloseCurlyQuote]s Locality, which \
implies that measurement probabilities (accessible or not, to observer) at \
two space-like regions are independent.\
\>", "Text",
 CellID->1358080856,ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell[TextData[{
 "Bell\[CloseCurlyQuote]s inequality in the ",
 ButtonBox["CHSH form",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/CHSH_inequality"], None}],
 " can be written as follows: ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      RowBox[{
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["\[Mu]", "TI"]], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "1"], ",", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "2"]}], 
       StyleBox[")",
        SpanMaxSize->1], "-", 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["\[Mu]", "TI"]], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "1"], ",", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "4"]}], 
       StyleBox[")",
        SpanMaxSize->1], "+", 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["\[Mu]", "TI"]], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "3"], ",", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "2"]}], 
       StyleBox[")",
        SpanMaxSize->1], "+", 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["\[Mu]", "TI"]], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "3"], ",", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "4"]}], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", GridBox[{
     {
      RowBox[{
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["\[Mu]", "TI"]], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "1"], ",", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "2"]}], 
       StyleBox[")",
        SpanMaxSize->1], "-", 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["\[Mu]", "TI"]], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "1"], ",", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "4"]}], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "+", GridBox[{
     {
      RowBox[{
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["\[Mu]", "TI"]], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "3"], ",", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "2"]}], 
       StyleBox[")",
        SpanMaxSize->1], "+", 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["\[Mu]", "TI"]], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "3"], ",", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "4"]}], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "2"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],
 " with \[Mu] the accessible variable of the system that specifies the \
quantum state (eg the preparation step). Note there is another variable in \
the derivation of Bell\[CloseCurlyQuote]s inequality, usually denoted b \
\[Lambda], which is inaccessible variable specifying the quantum state (the \
quantum world/level is obtained by averaging over \[Lambda])."
}], "Text",
 CellID->320615307,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell[TextData[{
 "Also, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["\[Mu]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "\[RightVector]"], 
     StyleBox["i", "TI"]], ",", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "\[RightVector]"], 
     StyleBox["j", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 " is identified as the quantum expectation value. Assuming that the state is \
",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Psi]", "TI"], "-"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 " and using the result for the correlation function (",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SuperscriptBox[
       StyleBox["\[Psi]", "TI"], "-"]},
     "Bra"], 
    RowBox[{
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "\[RightVector]"], "1"], ".", 
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], "\[CircleTimes]", 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "\[RightVector]"], "2"], ".", 
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]}], 
    TemplateBox[{
      SuperscriptBox[
       StyleBox["\[Psi]", "TI"], "-"]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{"-", 
     StyleBox["c", "TI"]}], 
    StyleBox["o", "TI"], 
    StyleBox["s", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     SubscriptBox["\[CapitalPhi]", "12"], 
     StyleBox[")",
      SpanMaxSize->1]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a9104d-5625-6af3-4356-8a1763d038d9"],
 " with ",
 Cell[BoxData[
  SubscriptBox["\[CapitalPhi]", "12"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],
 " the vector angle between ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43821c38-6720-b4f9-71b1-966212da1ec3"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c54d9-3079-6bba-5c24-4d83410c3980"],
 "), the left-side of above inequality can be written as:"
}], "Text",
 CellID->1594238871,ExpressionUUID->"1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"VectorAngle", "[", 
       RowBox[{"a1", ",", " ", "a2"}], "]"}], "]"}], " ", "-", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"VectorAngle", "[", 
       RowBox[{"a1", ",", " ", "a4"}], "]"}], "]"}]}], "]"}], " ", "+", " ", 
   "\n", "  ", 
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"VectorAngle", "[", 
       RowBox[{"a3", ",", " ", "a2"}], "]"}], "]"}], " ", "+", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"VectorAngle", "[", 
       RowBox[{"a3", ",", " ", "a4"}], "]"}], "]"}]}], "]"}]}], " ", "<=", 
  " ", "2"}]], "Input",
 CellLabel->"In[25]:= ",
 CellID->2002505366,ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"],

Cell[TextData[{
 "For example, let us consider this case: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["e", "TI"], 
   StyleBox["c", "TI"], 
   StyleBox["t", "TI"], 
   StyleBox["o", "TI"], 
