Cell[BoxData[{
 RowBox[{
  RowBox[{"corQC12", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<X\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", "\"\<H\>\"", ",", 
      " ", "\n", "    ", "\"\<CNOT\>\"", ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<RZ\>\"", ",", " ", "\[Phi]"}], "}"}], " ", "->", " ", 
       "2"}], ",", " ", 
      RowBox[{"\"\<H\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"corQC12", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[29]:= ",
 CellID->966663717,ExpressionUUID->"511b3347-8d7d-ab60-0738-ab212409f64a"],

