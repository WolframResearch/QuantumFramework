       ")"}], " ", "&"}], "@", "\n", "   ", "meas34"}], "]"}]}]], "Input",
 CellLabel->"In[39]:= ",
 CellID->315698450,ExpressionUUID->"5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],

Cell[TextData[{
 "Measurement probabilities from circuit to find ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["\[Mu]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "\[RightVector]"], "1"], ",", 
