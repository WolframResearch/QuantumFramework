Cell[TextData[{
 "Calculate the nonlocal probability for ",
 Cell[BoxData[
  TemplateBox[{"000"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3181a460-bc62-f1ee-67be-3e4a3514c334"],
 " (where one considers only cases where 3rd qubit is nonzero) as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], "000"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], "000"], "+", 
    SubscriptBox[
     StyleBox["P", "TI"], "100"], "+", 
    SubscriptBox[
     StyleBox["P", "TI"], "010"], "+", 
    SubscriptBox[
     StyleBox["P", "TI"], "110"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],
 ":"
}], "Text",
 CellID->2121396920,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell[BoxData[
 RowBox[{"nonlocalProb", " ", "=", " ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"prob", " ", "=", " ", 
       RowBox[{
        RowBox[{"final", "[", "\"\<Amplitudes\>\"", "]"}], "^", "2"}]}], 
      "}"}], ",", " ", 
     RowBox[{
      RowBox[{"prob", "[", "\n", 
       RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", "\n", 
         "      ", 
         RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"prob", "[", "\n", 
         RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}], 
        " ", "+", " ", 
        RowBox[{"prob", "[", "\n", 
         RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}], 
        " ", "+", " ", 
        RowBox[{"prob", "[", "\n", 
         RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}], 
        " ", "+", " ", 
        RowBox[{"prob", "[", "\n", 
         RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], 
         "]"}]}], ")"}]}]}], "]"}], " ", "//", " ", "\n", "  ", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{"#", ",", " ", 
      RowBox[{
       RowBox[{"\[Theta]1", " ", "\[Element]", " ", "Reals"}], " ", "&&", " ", 
       RowBox[{
       "\[Theta]2", " ", "\[Element]", " ", "\n", "      ", "Reals"}]}]}], 
     "]"}], " ", "&"}]}]}]], "Input",
 CellLabel->"In[29]:= ",
 CellID->993357154,ExpressionUUID->"5e187950-8ca2-2ab2-0638-711a25577898"],

