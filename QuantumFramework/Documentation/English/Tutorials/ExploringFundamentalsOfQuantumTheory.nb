Notebook[{

Cell[CellGroupData[{
Cell["Exploring Fundamentals of Quantum Theory", "Title",
 CellID->509267359,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell["\<\
We will explore some important experiment in the foundation of quantum \
theory, using the Wolfram Quantum Framework. In this document, we will \
discuss quantum eraser, Elitzur-Vaidman bomb experiment, Hardy\
\[CloseCurlyQuote]s paradox, and quantum SWITCH.\
\>", "Text",
 CellID->329621944,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell["Quantum Eraser", "Section",
 CellID->515379898,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell["\<\
If there is path information (stored somewhere, regardless of whether it is \
measured or not), there won\[CloseCurlyQuote]t be any interference. The mere \
presence of path information kills quantum interference. But by erasing the \
path information, one can recover quantum interference. In the following \
setup, clicking all detectors corresponds to a no-interference case, and \
clicking of only D1 and D4 corresponds to the interference case.\
\>", "Text",
 CellID->604760901,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell["With path information: no interference", "Subsection",
 CellID->1476799103,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell["\<\
Prepare a series of quantum gates representing the above setup:\
\>", "Text",
 CellID->448336599,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ops", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<H\>\"", ",", " ", "\"\<CX\>\"", ",", " ", "\"\<H\>\"", ",", 
     " ", 
     RowBox[{"{", "1", "}"}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->970785311,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell["Construct the quantum circuit:", "Text",
 CellID->1377816002,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", "ops", "]"}]}], ";"}], "\n", 
 RowBox[{"qc", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[2]:= ",
 CellID->1439899046,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell["Calculate the system evolution through each step:", "Text",
 CellID->1641200340,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"steps", " ", "=", " ", 
   RowBox[{"ComposeList", "[", 
    RowBox[{
     RowBox[{"qc", "[", "\"\<Operators\>\"", "]"}], ",", " ", 
     RowBox[{"QuantumState", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<Register\>\"", ",", " ", "2"}], "}"}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->1424533854,ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"],

Cell["Show the states prior to measurement:", "Text",
 CellID->535457321,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Initial state\>\"", ",", " ", "\n", 
         "     ", "\"\<After 1st Hadamard\>\"", ",", " ", "\"\<After CNOT\>\"",
          ",", " ", "\n", "     ", "\"\<After 2nd Hadamard\>\""}], "}"}]}], ",",
       " ", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", "\"\<Formula\>\"", "]"}], " ", "&"}], " ", "/@", 
       " ", 
       RowBox[{"steps", "[", 
        RowBox[{"[", 
         RowBox[{";;", " ", 
          RowBox[{"-", "3"}]}], "]"}], "]"}]}]}], "}"}], "]"}], ",", " ", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->141959522,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell["Get the probability of each outcome:", "Text",
 CellID->299517738,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qc", "[", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<Register\>\"", ",", " ", "2"}], "}"}], "]"}], "]"}], 
  "[", "\"\<ProbabilityPlot\>\"", "]"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->2142391071,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell["Erasing path information: interference", "Subsection",
 CellID->1002769646,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell["Prepare a series of quantum gates representing above setup:", "Text",
 CellID->436346740,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ops", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<H\>\"", ",", " ", "\"\<CX\>\"", ",", " ", "\"\<H\>\"", ",", 
     " ", 
     RowBox[{"\"\<H\>\"", " ", "->", " ", "2"}], ",", " ", 
     RowBox[{"{", "1", "}"}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->2122865143,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell["Construct the quantum circuit:", "Text",
 CellID->1735808809,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", "ops", "]"}]}], ";"}], "\n", 
 RowBox[{"qc", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[7]:= ",
 CellID->753514147,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

Cell["\<\
Note that the Hadamard gate acting on 2nd qubit serves as quantum eraser.\
\>", "Text",
 CellID->1164297175,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell["Calculate the system evolution through each step:", "Text",
 CellID->632614636,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell[BoxData[
 RowBox[{
  RowBox[{"steps", " ", "=", " ", 
   RowBox[{"ComposeList", "[", 
    RowBox[{
     RowBox[{"qc", "[", "\"\<Operators\>\"", "]"}], ",", " ", 
     RowBox[{"QuantumState", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<Register\>\"", ",", " ", "2"}], "}"}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->1689610856,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell["Show the states prior to measurement:", "Text",
 CellID->1303163127,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"#", ",", " ", "Bold"}], "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Initial state\>\"", ",", " ", "\n", 
         "     ", "\"\<After Hadamard on 1st qubit\>\"", ",", 
         " ", "\"\<After CNOT\>\"", ",", " ", "\n", 
         "     ", "\"\<After Hadamard on 1st qubit\>\"", ",", " ", "\n", 
         "     ", "\"\<After Hadamard on 2nd qubit\>\""}], "}"}]}], ",", " ", 
      
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", "\"\<Formula\>\"", "]"}], " ", "&"}], " ", "/@", 
       " ", 
       RowBox[{"steps", "[", 
        RowBox[{"[", 
         RowBox[{";;", " ", 
          RowBox[{"-", "3"}]}], "]"}], "]"}]}]}], "}"}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->2098230307,ExpressionUUID->"4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],

Cell["Get the probability of each outcome:", "Text",
 CellID->1930159659,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qc", "[", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<Register\>\"", ",", " ", "2"}], "}"}], "]"}], "]"}], 
  "[", "\"\<ProbabilityPlot\>\"", "]"}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->1113655915,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell["Elitzur-Vaidman bomb", "Section",
 CellID->1606118752,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"],

Cell["\<\
Given quantum interference in a Mach-Zehnder setup with only one \
beam-splitter, a detector click can be inferred as the presence of an object \
along one arm of interferometer. However, due to the interference, there is a \
50% chance that the photon does not move through that arm, as if one can \
infer the presence of that object without any interaction. To dramatize the \
case, think about that object as a bomb! This thought experiment is also \
called the interaction-free measurement.\
\>", "Text",
 CellID->2141499446,ExpressionUUID->"3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],

Cell["Simple case: 50:50 beam splitter", "Subsection",
 CellID->339082558,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell["\<\
Prepare a series of quantum gates representing the above setup:\
\>", "Text",
 CellID->432388834,ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ops", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<H\>\"", ",", " ", "\"\<CX\>\"", ",", " ", "\"\<H\>\"", ",", 
     " ", 
     RowBox[{"{", "1", "}"}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->443736588,ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"],

Cell["Construct the quantum circuit:", "Text",
 CellID->1593449978,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", "ops", "]"}]}], ";"}], "\n", 
 RowBox[{"qc", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[12]:= ",
 CellID->1742646261,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell["Get the probability of each outcome:", "Text",
 CellID->29467524,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell[BoxData[
 RowBox[{"prob", " ", "=", " ", 
  RowBox[{
   RowBox[{"qc", "[", "]"}], "[", "\"\<Probabilities\>\"", "]"}]}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->1939141443,ExpressionUUID->"1f908cf3-3c70-d55a-45af-25bdb50abfa0"],

Cell[TextData[{
 "Note that detecting ",
 Cell[BoxData[
  TemplateBox[{"01"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " or ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 " means that there is interaction with bomb (or a photon passed through the \
arm where the bomb is), while ",
 Cell[BoxData[
  TemplateBox[{"00"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d004f9-29e5-6665-1eef-9da34f904d4f"],
 " means that, with the help of quantum interference, the bomb is detected \
with no interaction. Therefore, the efficiency rate ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c76c797-c249-79ca-540d-ded0f7fc4b10"],
 " can be expressed as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", 
   SubscriptBox[
    StyleBox["P", "TI"], "00"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], "00"], "+", 
    SubscriptBox[
     StyleBox["P", "TI"], "01"], "+", 
    SubscriptBox[
     StyleBox["P", "TI"], "11"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["P", "TI"], "00"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SubscriptBox[
     StyleBox["P", "TI"], "10"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35077f55-9291-6519-633d-771f27244c63"],
 "."
}], "Text",
 CellID->5047578,ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell["Calculate the probability:", "Text",
 CellID->15008895,ExpressionUUID->"65de4a87-3471-cd9f-13e6-63e1bd0597e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"prob", "[", "\n", 
   RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}], "/", 
  RowBox[{"(", 
   RowBox[{"1", " ", "-", " ", 
    RowBox[{"prob", "[", "\n", 
     RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}]}], 
   ")"}]}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->1892712309,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell["Beyond 50:50 beam splitter", "Subsection",
 CellID->787969749,ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],

Cell[TextData[{
 "The Hadamard gate acts like a 50:50 beam splitter. One can replace it with \
a ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["y", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Theta]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 " gate, which is rotates along the ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "034d641c-5834-e412-3173-7e4659c6cf78"],
 "-axis with an arbitrary angle \[Theta]:"
}], "Text",
 CellID->525088789,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],

Cell[BoxData[
 RowBox[{"QuantumOperator", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<RY\>\"", ",", " ", "\[Theta]"}], "}"}], "]"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->357930410,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell[TextData[{
 "Compare the Hadamard gate with the ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["y", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Theta]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "134534fb-1061-d656-417a-ada5a115bcbc"],
 " gate on the quantum state ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],
 ":"
}], "Text",
 CellID->1802489801,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", "\"\<H\>\"", "]"}], "[", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], "]"}], 
  "[", "\"\<Amplitudes\>\"", "]"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->115301326,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell[BoxData[
 RowBox[{"FullSimplify", " ", "/@", " ", "\n", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<RY\>\"", ",", " ", "\[Theta]"}], "}"}], "]"}], "[", 
    RowBox[{"QuantumState", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], "]"}], 
   "[", "\"\<Amplitudes\>\"", "]"}]}]], "Input",
 CellLabel->"In[17]:= ",
 CellID->1651187567,ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"],

Cell[TextData[{
 "Note that the reflection will turn the qubit to ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66b4bee0-d247-b105-0e4b-37cde7f3006f"],
 ", meaning it will be in the arm where the bomb is located."
}], "Text",
 CellID->941376513,ExpressionUUID->"337c2d89-644e-5b5e-6103-c4d30dfb29a4"],

Cell[TextData[{
 "Define a new quantum circuit using ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["y", "TI"]], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Theta]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], "\[ThinSpace]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 ":"
}], "Text",
 CellID->2120243592,ExpressionUUID->"644cc522-c7c4-9b18-0c73-dc8ff276e662"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<RY\>\"", ",", " ", "\[Theta]"}], "}"}], ",", " ", "\n", 
      "    ", "\"\<CX\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<RY\>\"", ",", " ", "\[Theta]"}], "}"}], ",", " ", 
      RowBox[{"{", "1", "}"}], ",", " ", 
      RowBox[{"{", "2", "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"qc", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[18]:= ",
 CellID->1047559317,ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],

Cell["Get the probability of each outcome:", "Text",
 CellID->1820947576,ExpressionUUID->"6801f052-da94-0b6f-183e-ea1fdf2159b5"],

Cell[BoxData[
 RowBox[{"prob", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{"#", ",", " ", 
      RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}]}], "]"}], " ", 
    "&"}], " ", "/@", " ", "\n", "  ", 
   RowBox[{
    RowBox[{"qc", "[", 
     RowBox[{"QuantumState", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<Register\>\"", ",", " ", "2"}], "}"}], "]"}], "]"}], 
    "[", "\"\<Probabilities\>\"", "]"}]}]}]], "Input",
 CellLabel->"In[19]:= ",
 CellID->670734585,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell["Return the efficiency rate:", "Text",
 CellID->58232708,ExpressionUUID->"7b6211f5-475c-1194-2911-88bf72e963fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"prob", "[", "\n", 
   RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}], "/", 
  RowBox[{"(", 
   RowBox[{"1", " ", "-", " ", 
    RowBox[{"prob", "[", "\n", 
     RowBox[{"Wolfram`QuantumFramework`QuditName", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}], "]"}]}], 
   ")"}]}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->393464600,ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

Cell["Plot the efficiency rate:", "Text",
 CellID->1484396876,ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
