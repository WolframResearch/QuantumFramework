Cell["Create two random commuting operators:", "Text",
 CellID->171231949,ExpressionUUID->"07359582-e823-44a1-2eca-0cef89d62e8b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"u", "@", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Phase\>\"", ",", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"2", " ", "\[Pi]"}]}], "}"}], "]"}]}], "}"}], "]"}], "@", 
       RowBox[{"u", "[", "\"\<Dagger\>\"", "]"}]}]}], ",", "\n", "    ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<A\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"B", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"u", "@", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Phase\>\"", ",", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"2", " ", "\[Pi]"}]}], "}"}], "]"}]}], "}"}], "]"}], "@", 
       RowBox[{"u", "[", "\"\<Dagger\>\"", "]"}]}]}], ",", "\n", "    ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<B\>\""}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[33]:= ",
 CellID->820919957,ExpressionUUID->"7c239bd0-3ff5-3b18-25d0-129ab9818662"],

Cell["Consider the case where [A,B]=0:", "Text",
 CellID->1006830744,ExpressionUUID->"68c76573-72ce-0c1a-18fd-7d3d077b5760"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"A", "@", "B"}], " ", "-", " ", 
      RowBox[{"B", "@", "A"}]}], ")"}], "[", "\"\<Matrix\>\"", "]"}], " ", "//",
    " ", "Chop"}], " ", "//", " ", "MatrixForm"}]], "Input",
 CellLabel->"In[34]:= ",
 CellID->1175763064,ExpressionUUID->"6184d2f2-049e-728e-17bb-cbbcad2b40d4"],

Cell[TextData[{
 "The action of following circuit on an initial state ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
