        RowBox[{"3", " ", 
         RowBox[{"\[Pi]", "/", "2"}]}], ",", " ", 
        RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", " ", "Automatic"}], 
     "}"}]}]}], "]"}]], "Input",
