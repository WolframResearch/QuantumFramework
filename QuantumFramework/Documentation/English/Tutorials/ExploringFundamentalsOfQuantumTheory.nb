 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36c19c85-764d-0b01-5efe-15ef03f8566b"],
 ", which means if the qubit 1 is observed in the state ",
