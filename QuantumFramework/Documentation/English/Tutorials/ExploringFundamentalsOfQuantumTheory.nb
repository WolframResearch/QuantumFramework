Cell[TextData[{
 "Return the efficiency rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", 
   SubscriptBox[
    StyleBox["P", "TI"], 
    RowBox[{"00", ",", ".", ".", ".", ",", "0"}]], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SubscriptBox[
     StyleBox["P", "TI"], 
     RowBox[{"10", ",", ".", ".", ".", ",", "0"}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2055bfee-d4b5-7aa2-506a-36cbdd404888"],
 ":"
}], "Text",
 CellID->284780108,ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Eta]", "[", 
   RowBox[{"\[Theta]_", ",", " ", "n_"}], "]"}], " ", ":=", " ", "\n", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Psi]r", ",", " ", "\[Psi]t", ",", " ", "\[Psi]f", ",", " ", "pDet", ",",
       " ", "pNul"}], "}"}], ",", "\n", "  ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"|", "000"}], ",", "...", ",", "00"}], 
      "\[RightAngleBracket]"}], "*)"}], "\n", "  ", 
    RowBox[{
     RowBox[{"\[Psi]r", " ", "=", " ", 
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Register\>\"", ",", " ", "n"}], "}"}], "]"}]}], ";", 
     "\n", "  ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"|", "100"}], ",", "...", ",", "00"}], 
       "\[RightAngleBracket]"}], "*)"}], "\n", "  ", 
     RowBox[{"\[Psi]t", " ", "=", " ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], "@", 
       RowBox[{"QuantumState", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Register\>\"", ",", " ", "n"}], "}"}], "]"}]}]}], ";", 
     "\n", "  ", 
     RowBox[{"(*", 
      RowBox[{
      "final", " ", "state", " ", "at", " ", "the", " ", "end", " ", "of", " ",
        "the", " ", "cicruit"}], "*)"}], "\n", "  ", 
     RowBox[{"\[Psi]f", " ", "=", " ", 
      RowBox[{
       RowBox[{"qcN", "[", 
        RowBox[{"\[Theta]", ",", " ", "n"}], "]"}], "[", "\[Psi]r", "]"}]}], ";",
      "\n", "  ", 
     RowBox[{"(*", 
      RowBox[{
      "inner", " ", "products", " ", "wrt", " ", "final", " ", "state"}], 
      "*)"}], "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pDet", ",", " ", "pNul"}], "}"}], " ", "=", " ", "\n", "   ", 
      
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"First", "@", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", "\"\<Dagger\>\"", "]"}], "[", "\[Psi]f", "]"}],
             "[", "\n", "         ", "\"\<StateVector\>\"", "]"}]}], "]"}], "^",
          "2"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"\[Psi]r", ",", " ", "\[Psi]t"}], "}"}]}]}], ";", "\n", "  ", 
     
     RowBox[{"(*", "\[Eta]", "*)"}], "\n", "  ", 
     RowBox[{"pDet", "/", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", "pNul"}], ")"}]}]}]}], "\n", "  ", 
   "]"}]}]], "Input",
 CellLabel->"In[24]:= ",
 CellID->643798763,ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],

Cell["Plot the efficiency rate:", "Text",
