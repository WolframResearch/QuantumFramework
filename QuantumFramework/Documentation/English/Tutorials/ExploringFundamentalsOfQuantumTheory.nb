Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qcH", "[", 
    RowBox[{"\[Theta]1_", ",", " ", "\[Theta]2_"}], "]"}], " ", ":=", " ", 
   "\n", "  ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<YRotation\>\"", ",", " ", "\[Theta]1"}], "}"}], "]"}], ",",
       " ", "\n", "    ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<YRotation\>\"", ",", " ", "\[Theta]2"}], "}"}], ",", 
        " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", "\n", "    ", 
      RowBox[{"QuantumOperator", "[", "\"\<Toffoli\>\"", "]"}], ",", " ", 
      "\n", "    ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<YRotation\>\"", ",", " ", 
         RowBox[{"\[Pi]", " ", "-", " ", "\[Theta]1"}]}], "}"}], "]"}], ",", 
      " ", "\n", "    ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<YRotation\>\"", ",", " ", 
          RowBox[{"\[Pi]", " ", "-", " ", "\[Theta]2"}]}], "}"}], ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[26]:= ",
 CellID->1358080856,ExpressionUUID->"48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],

