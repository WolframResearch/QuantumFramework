Cell[TextData[{
 "Note that the dimension of matrices is ",
 Cell[BoxData[
  SuperscriptBox["2", 
   RowBox[{"#", 
    StyleBox["BS",
     FontSlant->"Plain"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04786d0e-016a-d127-2c07-8568b01ca00d"],
 ", so increasing the number of qubits can lengthen the computation time."
}], "Text",
