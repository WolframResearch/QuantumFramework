Cell["Increasing efficiency by using a series of beam splitters", "Subsection",
 CellID->1092188694,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell[TextData[{
 "Define a new quantum circuit using ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["y", "TI"]], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Theta]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], "\[ThinSpace]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cb5c01f-62f5-68e0-144a-da5916803aca"],
 ":"
}], "Text",
 CellID->559599970,ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qcN", "[", 
    RowBox[{"\[Theta]_", ",", " ", "m_Integer"}], "]"}], " ", ":=", " ", "\n",
    "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", " ", "=", " ", 
       RowBox[{"m", " ", "-", " ", "1"}]}], "}"}], ",", " ", "\n", "   ", 
     RowBox[{"QuantumCircuitOperator", "@", "\n", "    ", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<RY\>\"", ",", " ", "\[Theta]"}], "}"}], ",", " ", 
            RowBox[{"\"\<CX\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", 
               RowBox[{"i", " ", "+", " ", "1"}]}], "}"}]}]}], "}"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "\n", "       ", "n"}], "}"}]}], "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"\"\<RY\>\"", ",", " ", "\[Theta]"}], "}"}]}], "]"}]}]}], 
    "\n", "   ", "]"}]}], ";"}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->1710123944,ExpressionUUID->"4b6e5dad-9702-0c1f-7916-54f722b75765"],

Cell[BoxData[
 RowBox[{
