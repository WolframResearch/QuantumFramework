Cell["\<\
Construct the circuit based on a quantum switch (defined in the \
initialization):\
\>", "Text",
 CellID->2143439988,ExpressionUUID->"6b12ee74-9953-131d-1921-003e18e67e67"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Switch\>\"", ",", " ", "A", ",", " ", "B"}], "}"}], 
       "]"}], ",", " ", "\n", "    ", 
      RowBox[{"QuantumOperator", "[", "\"\<H\>\"", "]"}], ",", " ", 
      RowBox[{"QuantumMeasurementOperator", "[", "]"}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"qc", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[35]:= ",
 CellID->1933756212,ExpressionUUID->"65262d3c-fccc-1dc6-0cdd-c579f579672c"],

Cell[TextData[{
 "Get the tensor product for ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"+"},
    "Ket"], 
   TemplateBox[{
     RowBox[{
       StyleBox["R", "TI"], 
       StyleBox["a", "TI"], 
       StyleBox["n", "TI"], 
       StyleBox["d", "TI"], 
       StyleBox["o", "TI"], 
       StyleBox["m", "TI"], 
       StyleBox["P", "TI"], 
       StyleBox["u", "TI"], 
       StyleBox["r", "TI"], 
       StyleBox["e", "TI"]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e157ee2-48da-d240-062b-77cc696ca0aa"],
 ":"
}], "Text",
 CellID->943735407,ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"],

Cell[BoxData[
 RowBox[{"\[Psi]0", " ", "=", " ", "\n", " ", 
  RowBox[{"QuantumTensorProduct", "[", 
   RowBox[{
    RowBox[{"QuantumState", "[", "\"\<Plus\>\"", "]"}], ",", " ", 
    RowBox[{"QuantumState", "[", "\"\<RandomPure\>\"", "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[36]:= ",
 CellID->865519937,ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"],

Cell["Perform the measurement:", "Text",
 CellID->845186625,ExpressionUUID->"1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qc", "[", "\[Psi]0", "]"}], "[", "\"\<ProbabilityPlot\>\"", 
  "]"}]], "Input",
 CellLabel->"In[37]:= ",
 CellID->14312863,ExpressionUUID->"187adc3d-3961-76c2-4819-d667b8145c28"],

Cell["The result confirms the commuting case.", "Text",
 CellID->315698450,ExpressionUUID->"641c78eb-7f03-7846-0c24-71b57ab64aac"],

Cell["Anti-commuting example", "Subsection",
 CellID->1751204118,ExpressionUUID->"5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],

Cell["Create a random 2D unitary operator:", "Text",
 CellID->2116603297,ExpressionUUID->"112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],

Cell[BoxData[
 RowBox[{
  RowBox[{"u", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", "\"\<RandomUnitary\>\"", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[38]:= ",
 CellID->530919167,ExpressionUUID->"6121b9de-dddd-aca8-10de-309bd469f6f2"],

Cell["Create two commuting operators:", "Text",
 CellID->1242319925,ExpressionUUID->"30209679-023a-ee91-61df-0823b7ccb4fb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{"u", "@", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], "@", 
       RowBox[{"u", "[", "\"\<Dagger\>\"", "]"}]}]}], ",", " ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<A\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"B", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{"u", "@", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "@", 
       RowBox[{"u", "[", "\"\<Dagger\>\"", "]"}]}]}], ",", " ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<B\>\""}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[39]:= ",
 CellID->1600082692,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell["Note that we consider the case where {A,B}=0:", "Text",
 CellID->1091979148,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"A", "@", "B"}], " ", "+", " ", 
      RowBox[{"B", "@", "A"}]}], ")"}], "[", "\"\<Matrix\>\"", "]"}], " ", "//",
    " ", "Chop"}], " ", "//", " ", "MatrixForm"}]], "Input",
 CellLabel->"In[40]:= ",
 CellID->1239660989,ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"],

Cell[TextData[{
 "The action of following circuit on an initial state ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],
 Cell[BoxData[
