       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["W", "TI"]], "-", "1"}], ")", 
      StyleBox["a", "TI"]}]], " ", 
    SubscriptBox[":", "N"], " "}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "317b6ad6-ddf9-9844-a394-42c0a147b123"],
 ":"
}], "MathCaption",
