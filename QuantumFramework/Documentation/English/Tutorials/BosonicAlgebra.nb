Cell[CellGroupData[{

Cell[TextData[{
 "A driven and squeezed oscillator, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   SuperscriptBox[
    StyleBox["a", "TI"], "\[Dagger]"], 
   StyleBox["a", "TI"], "+", 
   FractionBox["1", "3"], "(", 
   RowBox[{
    SuperscriptBox[
