Cell[CellGroupData[{

Cell[TextData[{
 "A beam splitter conserves the photon number, and its normal-ordered form is \
a single middle that mixes the modes, ",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{":", " ", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
