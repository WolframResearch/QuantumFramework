Cell[CellGroupData[{

Cell[TextData[{
 "Squeezed vacuum amplitude ",
 Cell[BoxData[
  RowBox[{"\[LeftAngleBracket]", "2", "|", 
   StyleBox["S", "TI"], "|", "0", "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cc0c1d9-3814-4b4c-9d96-a3f593b188c4"],
 " from the ordered exponential:"
}], "MathCaption",
 CellChangeTimes->{4.0040223481285744`*^9},
 CellID->133862615,ExpressionUUID->"8cfee88b-311b-7243-adae-fd4dc75cc67b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BosonicMatrixElement", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "0"}], "}"}], ",", 
   RowBox[{"Exp", "[", 
    RowBox[{
     FractionBox["1", "2"], " ", "r", " ", 
     RowBox[{"(", 
      RowBox[{
       TemplateBox[{"NonCommutativeMultiply", "a", "2", "**"},
        "GeneralizedPower"], "-", 
       TemplateBox[{"NonCommutativeMultiply", "ad", "2", "**"},
        "GeneralizedPower"]}], ")"}]}], "]"}], ",", "v", ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"r", ">", "0"}]}]}], "]"}]], "Input",
 CellChangeTimes->{4.0040223517291145`*^9},
 CellLabel->"In[168]:=",
 CellID->131333075,ExpressionUUID->"ac9fbf05-0fa8-de4a-a922-51e7dbb99a68"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"Sech", "[", "r", "]"}], 
     RowBox[{"3", "/", "2"}]], " ", 
    RowBox[{"Sinh", "[", "r", "]"}]}], 
   SqrtBox["2"]]}]], "Output",
 CellChangeTimes->{4.0040223534789906`*^9},
 CellLabel->"Out[168]=",
 CellID->236376245,ExpressionUUID->"fb7ce35b-5aa4-2943-8315-312764d4d270"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The two-mode squeezer creates photons in pairs, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      StyleBox["k", "TI"]}], ",", "\[ThinSpace]", 
     RowBox[{
      StyleBox["k", "TI"], "|", 
      SubscriptBox[
       StyleBox["S", "TI"], "2"], "|", "0"}], ",", "\[ThinSpace]", "0"}], 
    "\[RightAngleBracket]"}], "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["tanh",
       FontSlant->"Plain"], 
      StyleBox["k", "TI"]], 
     StyleBox["r", "TI"]}], 
    StyleBox[
     RowBox[{"cosh", " ", "r"}],
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91b62bee-77b2-b54d-81ef-da0a96cd88d6"],
 ":"
}], "MathCaption",
 CellChangeTimes->{4.00402236264163*^9},
 CellID->246664695,ExpressionUUID->"75b1b84b-7a58-0b47-b39b-eb2640ad45e5"],

Cell[CellGroupData[{

