Cell[CellGroupData[{

Cell["\<\
Two-mode squeezer, with wings creating and annihilating pairs and a number \
middle:\
\>", "MathCaption",
 CellChangeTimes->{4.0040220414059277`*^9},
 CellID->434352704,ExpressionUUID->"5b2d101d-989d-6749-a9ae-319e552b66fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BosonicExpOrder", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{"r", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"bd1", "**", "bd2"}], "-", 
       RowBox[{"b1", "**", "b2"}]}], ")"}]}], "]"}], ",", "v2", ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"r", ">", "0"}]}]}], "]"}]], "Input",
 CellChangeTimes->{4.0040220493681927`*^9},
 CellLabel->"In[155]:=",
 CellID->70486255,ExpressionUUID->"8eb234bf-56db-804d-8408-15fd4034f847"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"sech", "(", "r", ")"}], " ", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"tanh", "(", "r", ")"}], " ", 
      RowBox[{
       SuperscriptBox["\[FormalA]1", "\[Dagger]"], "**", 
       SuperscriptBox["\[FormalA]2", "\[Dagger]"]}]}]], "**", 
    RowBox[{
     SuperscriptBox["sech", 
      RowBox[{
       RowBox[{
