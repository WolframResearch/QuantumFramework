Cell[CellGroupData[{

Cell[TextData[{
 "Photon hopping ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", "1"}], ",", "\[ThinSpace]", 
   RowBox[{"0", "|", 
    StyleBox["U", "TI"], "|", "0"}], ",", "\[ThinSpace]", 
