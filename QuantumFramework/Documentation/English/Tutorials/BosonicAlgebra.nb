 CellID->624055607,ExpressionUUID->"18aec436-eceb-9b3f-2c9a-7568db74ab83"],

Cell[CellGroupData[{

Cell[TextData[{
 "Second-order term of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "(", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"\[Alpha]", 
      SuperscriptBox[
       StyleBox["a", "TI"], "\[Dagger]"]}]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"\[Beta]", 
      StyleBox["a", "TI"]}]]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b4b2805-21b1-b34d-a15d-b7f48c9f0c40"],
 ":"
}], "MathCaption",
 CellChangeTimes->{4.004021662593296*^9},
 CellID->656475385,ExpressionUUID->"37d24f36-a65c-be4c-a959-ae4088815e81"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BosonicBCHTerms", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", " ", "ad"}], ",", " ", 
     RowBox[{"\[Beta]", " ", "a"}]}], "}"}], ",", " ", "2", ",", " ", "v"}], 
  "]"}]], "Input",
