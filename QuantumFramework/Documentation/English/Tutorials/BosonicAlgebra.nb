Cell[CellGroupData[{

Cell["Ordering exponentials", "Section",
 CellID->883174433,ExpressionUUID->"057b95be-e81e-1eb3-3148-0f16ca0b667a"],

Cell[TextData[{
 "An exponential of a sum of non-commuting operators does not factor for \
free. For generators of degree at most two, the factors are fixed by a ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["N", "TI"], "\[Times]", "2", 
   StyleBox["N", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48058b58-86ff-f9ab-3178-cc1d9d70d799"],
 " matrix built from the coefficients  and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BosonicExpOrder"]], 
    "paclet:Wolfram/QuantumFramework/ref/BosonicExpOrder", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3dca1517-27e5-ef8c-1a0b-7c6c19cd47df"],
 " computes them exactly."
}], "Text",
 CellChangeTimes->{4.004012249177128*^9},
 CellID->1323376091,ExpressionUUID->"25444a9d-2d86-1b53-683b-1ce7d419c6e0"],

Cell[CellGroupData[{

Cell["One mode", "Subsection",
 CellID->1633196076,ExpressionUUID->"74c84243-311d-793c-13e1-342369e1383f"],

Cell[CellGroupData[{

