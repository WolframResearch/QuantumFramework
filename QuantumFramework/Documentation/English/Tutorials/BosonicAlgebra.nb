Cell[CellGroupData[{

Cell["Ordering identities", "Subsection",
 CellID->234207732,ExpressionUUID->"14895ca5-73c6-2626-55c6-571f64c33380"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "04a83674-c538-d948-292c-8e5813da26bb"], Cell[
    "Displacement", "TableText",ExpressionUUID->
     "44389583-018c-c855-4a66-8cb65abd80d0"], Cell[TextData[Cell[BoxData[
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"\[Alpha]", 
        SuperscriptBox[
         StyleBox["a", "TI"], "\[Dagger]"], "-", 
        SuperscriptBox["\[Alpha]", "*"], 
        StyleBox["a", "TI"]}]], "=", 
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox[
          RowBox[{"|", "\[Alpha]", "|"}], "2"], "2"]}]], 
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"\[Alpha]", 
        SuperscriptBox[
         StyleBox["a", "TI"], "\[Dagger]"]}]], 
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"-", 
        SuperscriptBox["\[Alpha]", "*"], 
        StyleBox["a", "TI"]}]]}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1052be48-b6ab-5c0f-5c42-c3f271ff7413"]], "TableText",ExpressionUUID->
     "7e67c588-a37b-b49d-2635-8b9e7a17ce0c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1f800fe0-b0ec-3442-3238-1401708852ae"], Cell[
    "Number exponential", "TableText",ExpressionUUID->
     "5629b47f-3231-2bdc-24c2-cc0340fe4d53"], Cell[TextData[Cell[BoxData[
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"\[Lambda]", 
        SuperscriptBox[
         StyleBox["a", "TI"], "\[Dagger]"], 
        StyleBox["a", "TI"]}]], "=", ":", 
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          StyleBox["e", "TI"], "\[Lambda]"], "-", "1"}], ")", 
        SuperscriptBox[
         StyleBox["a", "TI"], "\[Dagger]"], 
        StyleBox["a", "TI"]}]], ":"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4d8c64f7-b1f9-2f8e-540c-53e535e02115"]], "TableText",ExpressionUUID->
     "4994a442-5c78-28c3-76e9-1593c8132489"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3faebca9-451b-6822-02eb-51eda09a1c4d"], Cell[
    "Passive mode mixing", "TableText",ExpressionUUID->
     "2f14137f-52ff-5831-0c6f-67e0f67b2a9a"], Cell[TextData[Cell[BoxData[
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{
        SuperscriptBox[
         StyleBox["a", "TI"], "\[Dagger]"], 
        StyleBox["W", "TI"], 
        StyleBox["a", "TI"]}]], "=", ":", 
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{
        SuperscriptBox[
         StyleBox["a", "TI"], "\[Dagger]"], "(", 
        RowBox[{
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["W", "TI"]], "-", "1"}], ")", 
        StyleBox["a", "TI"]}]], ":"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "657fb2a2-3607-381b-44fe-507c732e18ab"]], "TableText",ExpressionUUID->
     "42f9a457-30d2-1f71-7175-093d7607898f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2bb98c94-79e9-3c5f-6984-4b4711b50907"], Cell[
    "Gauss form (\"Disentangled\")", "TableText",ExpressionUUID->
     "3f0db80d-c2f4-7e1c-2e24-57b828f32ed7"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{":", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "\[Dagger]"], "(", 
         RowBox[{
          StyleBox["M", "TI"], "-", "1"}], ")", 
         StyleBox["a", "TI"]}]], ":", "=", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "\[Dagger]"], "(", 
         RowBox[{
          StyleBox["log",
           FontSlant->"Plain"], 
          StyleBox["U", "TI"]}], ")", 
         StyleBox["a", "TI"]}]], 
       SuperscriptBox["\[CapitalLambda]", 
        StyleBox["N", "TI"]], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{
         SuperscriptBox[
