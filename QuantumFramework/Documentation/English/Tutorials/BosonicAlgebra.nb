Cell[CellGroupData[{

Cell["Check against a truncated evolution with 22 levels per mode:", \
"MathCaption",
 CellChangeTimes->{4.0040224402814007`*^9},
 CellID->404207596,ExpressionUUID->"46396f09-e94a-e247-96aa-c32f000e521e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a1", "=", 
       RowBox[{"AnnihilationOperator", "[", 
        RowBox[{"22", ",", 
         RowBox[{"{", "1", "}"}]}], "]"}]}], ",", 
      RowBox[{"a2", "=", 
       RowBox[{"AnnihilationOperator", "[", 
        RowBox[{"22", ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}]}], "}"}], ",", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"H", "=", 
        RowBox[{"h2", "/.", "\[VeryThinSpace]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"bd1", "\[Rule]", 
            SuperscriptBox["a1", "\[Dagger]"]}], ",", 
           RowBox[{"bd2", "\[Rule]", 
            SuperscriptBox["a2", "\[Dagger]"]}], ",", 
           RowBox[{"b1", "\[Rule]", "a1"}], ",", 
           RowBox[{"b2", "\[Rule]", "a2"}], ",", 
           RowBox[{"NonCommutativeMultiply", "\[Rule]", "Construct"}]}], 
          "}"}]}]}], "\[VeryThinSpace]", "}"}], ",", 
      RowBox[{"hop", "-", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           SuperscriptBox[
            RowBox[{"FockState", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", "0"}], "}"}], ",", "22"}], "]"}], 
            "\[Dagger]"], "[", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "\[ImaginaryI]"}], " ", 
              RowBox[{"N", "@", "tt"}], " ", "H"}], "]"}], "[", 
            RowBox[{"FockState", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", "22"}], "]"}], "]"}], 
           "]"}], "[", "\"\<Scalar\>\"", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"tt", ",", "1", ",", "3"}], "}"}]}], "]"}]}]}], "]"}]}], 
   "]"}], "]"}]], "Input",
 CellChangeTimes->{{4.0040236149614105`*^9, 4.0040237458734703`*^9}},
 CellLabel->"In[182]:=",
 CellID->102711400,ExpressionUUID->"d2778547-0c65-5643-b12c-dea73980dce9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{{4.004023657192957*^9, 4.0040237671849117`*^9}, 
   4.004023805607542*^9},
 CellLabel->"Out[182]=",
 CellID->337575114,ExpressionUUID->"c05a50e2-4e15-d84c-8a39-be8579d05876"]
}, Open  ]]
