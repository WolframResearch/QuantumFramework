Cell[CellGroupData[{

Cell["Coherent amplitude of the two-mode squeezed vacuum:", "MathCaption",
 CellChangeTimes->{4.0040238519934425`*^9},
 CellID->85773168,ExpressionUUID->"7a1433a4-aa82-8b45-b860-07699f70093d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"amp", " ", "=", 
  RowBox[{"BosonicMatrixElement", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Alpha]1", ",", " ", "\[Alpha]2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"r", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"bd1", " ", "**", " ", "bd2"}], " ", "-", " ", 
        RowBox[{"b1", " ", "**", " ", "b2"}]}], ")"}]}], "]"}], ",", " ", 
    "v2", ",", " ", 
    RowBox[{"\"\<Basis\>\"", " ", "->", " ", "\"\<Coherent\>\""}], ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{"r", " ", ">", " ", "0"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{4.004023855677273*^9},
 CellLabel->"In[184]:=",
 CellID->398197339,ExpressionUUID->"ca707683-ea2c-3d49-b047-2b630f7cc71b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"sech", "(", "r", ")"}], " ", 
   RowBox[{"exp", "(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"\[Alpha]1", " ", 
        TemplateBox[{"\[Alpha]1"},
         "Conjugate"]}], "2"]}], "-", 
     FractionBox[
      RowBox[{"\[Alpha]2", " ", 
       TemplateBox[{"\[Alpha]2"},
        "Conjugate"]}], "2"], "+", 
     RowBox[{
      TemplateBox[{"\[Alpha]1"},
       "Conjugate"], " ", 
      TemplateBox[{"\[Alpha]2"},
       "Conjugate"], " ", 
      RowBox[{"tanh", "(", "r", ")"}]}]}], ")"}]}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{{4.0040238593743668`*^9, 4.004023860842663*^9}},
 CellLabel->"Out[184]=",
 CellID->57141293,ExpressionUUID->"17c1758f-361a-654d-8504-61dfcd3b8349"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Same result as the textbook form ",
