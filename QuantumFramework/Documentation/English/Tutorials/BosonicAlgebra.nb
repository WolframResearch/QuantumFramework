Cell[CellGroupData[{

Cell[TextData[{
 "The moments ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", "0", "|", 
    RowBox[{
     SuperscriptBox[
      StyleBox["a", "TI"], 
      StyleBox["m", "TI"]], 
     SuperscriptBox[
      StyleBox["a", "TI"], 
      RowBox[{"\[Dagger]", 
       StyleBox["m", "TI"]}]]}], "|", "0", "\[RightAngleBracket]", "=", 
    StyleBox["m", "TI"]}], "!"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09e810fa-4b06-bb46-adba-20c86c0e4b9b"],
 " check the algebra at every degree:"
