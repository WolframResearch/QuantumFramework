Cell[CellGroupData[{

Cell["The Blasiak formula and the default reduction agree:", "MathCaption",
 CellChangeTimes->{4.004021021276249*^9},
 CellID->496300532,ExpressionUUID->"b2cf7460-773b-3a45-ac23-48316c46bd5c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"w", "=", 
     RowBox[{
      TemplateBox[{"NonCommutativeMultiply", "a", "3", "**"},
       "GeneralizedPower"], "**", 
      TemplateBox[{"NonCommutativeMultiply", "ad", "3", "**"},
       "GeneralizedPower"]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"BosonicNormalOrder", "[", 
     RowBox[{"w", ",", "v", ",", 
      RowBox[{"Method", "\[Rule]", "\"\<Blasiak\>\""}]}], "]"}], "===", 
    RowBox[{"BosonicNormalOrder", "[", 
     RowBox[{"w", ",", "v"}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{4.0040210250879326`*^9},
 CellLabel->"In[116]:=",
 CellID->87061545,ExpressionUUID->"4b00d40c-7706-4c4b-bcbb-c420d1d10e0d"],

Cell[BoxData["True"], "Output",
