Cell[CellGroupData[{

Cell["Normal symbol", "Subsection",
 CellID->394902720,ExpressionUUID->"5eb09038-1e1f-6e24-0cc9-aea4b8922cd1"],

Cell[CellGroupData[{

Cell[TextData[{
 "The normal symbol ",
 Cell[BoxData[
  RowBox[{
   StyleBox["F", "TI"], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[Alpha]", "*"], ",", "\[ThinSpace]", "\[Beta]"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "302c54b0-af58-124c-8b5e-5cad1d9e69c1"],
 " of an operator is defined by ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", "\[Alpha]", "|", 
      StyleBox["A", "TI"], "|", "\[Beta]", "\[RightAngleBracket]", "=", "\[LeftAngleBracket]",
       "\[Alpha]"}], "|", "\[Beta]"}], "\[RightAngleBracket]"}], 
   StyleBox["F", "TI"], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[Alpha]", "*"], ",", "\[ThinSpace]", "\[Beta]"}], 
    ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "111383c0-5119-5842-8d40-ec0f6b0df84a"],
 " , so it is the coherent element divided by the overlap. \
\[LineSeparator]For a number exponential it is ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], "\[Lambda]"], "-", "1"}], ")", 
    SuperscriptBox["\[Alpha]", "*"], "\[Beta]"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17963202-6387-3c49-b5d6-c036694a3618"],
 ":"
}], "MathCaption",
 CellChangeTimes->{{4.00402390074032*^9, 4.004023929705942*^9}},
 CellID->135637711,ExpressionUUID->"cfc537d6-1d6c-b64f-8cb8-13b8b64e2712"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  FractionBox[
   RowBox[{"BosonicMatrixElement", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", 
     RowBox[{"Exp", "[", 
      RowBox[{"\[Lambda]", " ", 
       RowBox[{"ad", "**", "a"}]}], "]"}], ",", "v", ",", 
     RowBox[{"\"\<Basis\>\"", "\[Rule]", "\"\<Coherent\>\""}]}], "]"}], 
   RowBox[{"BosonicMatrixElement", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", "1", ",", 
     RowBox[{"\"\<Basis\>\"", "\[Rule]", "\"\<Coherent\>\""}]}], "]"}]], 
  "]"}]], "Input",
