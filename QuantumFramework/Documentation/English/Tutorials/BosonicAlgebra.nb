Cell[CellGroupData[{

Cell[TextData[{
 "A function of the number operator between ladder operators, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     StyleBox["a", "TI"], "1", "\[Dagger]"], 
    StyleBox["f", "TI"], "(", 
    SubscriptBox[
     StyleBox["N", "TI"], "1"], ")", 
    SubscriptBox[
     StyleBox["a", "TI"], "1"]}], "|", 
   RowBox[{
    StyleBox["n", "TI"], "\[RightAngleBracket]", "=", 
    StyleBox["n", "TI"], 
    StyleBox["f", "TI"], "(", 
    RowBox[{
     StyleBox["n", "TI"], "-", "1"}], ")"}], "|", 
   RowBox[{
    StyleBox["n", "TI"], "\[RightAngleBracket]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74dcafcc-8269-c94b-aa9b-cd9e37504bbe"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], "(", 
   StyleBox["N", "TI"], ")", "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["N", "TI"]], "-", 
   StyleBox["e", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5148a998-868e-8f42-889e-90790fafb6ad"],
 "  vanishing at the index but not one below it:"
}], "MathCaption",
 CellChangeTimes->{{4.004023818630045*^9, 4.00402383962957*^9}},
 CellID->330624088,ExpressionUUID->"02b26244-d692-9844-beae-928ce1182751"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BosonicMatrixElement", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"bd1", "**", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"bd1", "**", "b1"}], "]"}], "-", "\[ExponentialE]"}], ")"}], "**",
