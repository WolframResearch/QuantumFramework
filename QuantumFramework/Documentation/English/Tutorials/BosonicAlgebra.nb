  RowBox[{
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"\[Alpha]", " ", "ad"}], "-", 
      RowBox[{"\[Alpha]", " ", "a"}]}], "]"}], "**", "a", "**", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"\[Alpha]", " ", "a"}], "-", 
      RowBox[{"\[Alpha]", " ", "ad"}]}], "]"}]}], ",", "v"}], "]"}]], "Input",
