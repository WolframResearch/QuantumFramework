Cell[CellGroupData[{

Cell[TextData[{
 "The normal-ordered middle of a passive evolution is the second-quantized \
image ",
 Cell[BoxData[
  RowBox[{"\[CapitalGamma]", "(", 
   StyleBox["M", "TI"], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a37f1623-7081-514e-bb04-d3f5da72d431"],
 " of a matrix ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9949315c-5141-0146-9dba-bf4741843676"],
 ", and ",
 Cell[BoxData[
  RowBox[{"\[CapitalGamma]", "(", 
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], "1"], 
    SubscriptBox[
     StyleBox["M", "TI"], "2"]}], ")", "=", "\[CapitalGamma]", "(", 
   SubscriptBox[
    StyleBox["M", "TI"], "1"], ")", "\[CapitalGamma]", "(", 
   SubscriptBox[
    StyleBox["M", "TI"], "2"], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3140833d-7193-c140-aefb-0ca6d13e718c"],
 ". Factoring ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], "=", 
   StyleBox["U", "TI"], "\[CapitalLambda]", 
   StyleBox["L", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8eefae3-0f7d-9c40-9ca0-c8a78b5bda2f"],
 " therefore factors the operator into raising, diagonal and lowering \
exponentials. For a beam splitter this is the SU(2) disentangling:"
}], "MathCaption",
 CellChangeTimes->{4.004022154048937*^9},
 CellID->686027539,ExpressionUUID->"3925aa8e-33cb-df41-858d-e3d3bc4f9228"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BosonicExpOrder", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"x", " ", 
      RowBox[{"bd1", " ", "**", " ", "b2"}]}], " ", "-", " ", 
     RowBox[{"y", " ", 
      RowBox[{"bd2", " ", "**", " ", "b1"}]}]}], "]"}], ",", " ", "v2", ",", 
   " ", 
   RowBox[{"\"\<Ordering\>\"", " ", "->", " ", "\"\<Disentangled\>\""}]}], 
  "]"}]], "Input",
 CellChangeTimes->{4.0040221587416077`*^9},
 CellLabel->"In[160]:=",
 CellID->737358049,ExpressionUUID->"2725545f-344e-0545-8df8-353cad5723cf"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   FractionBox[
    RowBox[{
     SqrtBox[
      RowBox[{"x", " ", "y"}]], " ", 
     RowBox[{
      SuperscriptBox["\[FormalA]1", "\[Dagger]"], "**", "\[FormalA]2"}], " ", 
     RowBox[{"Tan", "[", 
      SqrtBox[
       RowBox[{"x", " ", "y"}]], "]"}]}], "y"]], "**", 
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Cos", "[", 
      SqrtBox[
       RowBox[{"x", " ", "y"}]], "]"}], 
     RowBox[{
      SuperscriptBox["\[FormalA]2", "\[Dagger]"], "**", "\[FormalA]2"}]], " ", 
    SuperscriptBox[
     RowBox[{"Sec", "[", 
      SqrtBox[
       RowBox[{"x", " ", "y"}]], "]"}], 
     RowBox[{
      SuperscriptBox["\[FormalA]1", "\[Dagger]"], "**", "\[FormalA]1"}]]}], 
   ")"}], "**", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      SqrtBox[
       RowBox[{"x", " ", "y"}]], " ", 
      RowBox[{
       SuperscriptBox["\[FormalA]2", "\[Dagger]"], "**", "\[FormalA]1"}], " ", 
      RowBox[{"Tan", "[", 
       SqrtBox[
        RowBox[{"x", " ", "y"}]], "]"}]}], "x"]}]]}]], "Output",
 CellChangeTimes->{4.0040221594602394`*^9},
 CellLabel->"Out[160]=",
 CellID->364321849,ExpressionUUID->"0d3b0fbf-c90d-7b46-8819-aa33c68e3315"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The factorization needs a non-vanishing pivot, and the Gauss form itself is \
singular at the 50:50 point, where ",
 Cell[BoxData[
  StyleBox["tan",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e83fff22-a8fe-2347-b7ef-e72444bdf2db"],
 " diverges. There the middle stays normal ordered:"
}], "MathCaption",
 CellChangeTimes->{4.004022171656765*^9},
 CellID->208437539,ExpressionUUID->"b743d6bb-76e4-dd4b-a111-233d7372fea5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BosonicExpOrder", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Pi]"}], ")"}], "  ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"bd1", "**", "b2"}], "+", 
       RowBox[{"bd2", "**", "b1"}]}], ")"}]}], "]"}], ",", "v2", ",", 
   RowBox[{"\"\<Ordering\>\"", "\[Rule]", "\"\<Disentangled\>\""}]}], 
  "]"}]], "Input",
 CellChangeTimes->{4.0040221994851303`*^9},
 CellLabel->"In[161]:=",
 CellID->519135821,ExpressionUUID->"401f9302-59d1-674e-bedd-28c273a55308"],

Cell[BoxData[
 RowBox[{"NormalOrdered", "[", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[FormalA]1", "\[Dagger]"], "**", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "\[FormalA]1"}], "-", 
        RowBox[{"\[ImaginaryI]", " ", "\[FormalA]2"}]}], ")"}]}], "+", 
     RowBox[{
      SuperscriptBox["\[FormalA]2", "\[Dagger]"], "**", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "\[FormalA]1"}], "-", 
        "\[FormalA]2"}], ")"}]}]}]], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox["\[FormalA]1", "\[Dagger]"], ",", 
       SuperscriptBox["\[FormalA]2", "\[Dagger]"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[FormalA]1", ",", "\[FormalA]2"}], "}"}]}], "}"}]}], 
  "]"}]], "Output",
 CellChangeTimes->{{4.0040222008365955`*^9, 4.004022224831396*^9}},
 CellLabel->"Out[161]=",
 CellID->74993195,ExpressionUUID->"a7eedd15-8eb9-634a-991f-91cd356529ab"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Ordered products", "Section",
 CellID->1225590873,ExpressionUUID->"1f48d68b-527c-64d8-00cf-172e36605814"],

Cell[CellGroupData[{

Cell[TextData[{
 "On a polynomial, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NormalOrdered"]], 
    "paclet:Wolfram/QuantumFramework/ref/NormalOrdered", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8a91a316-0c76-9f42-9165-d2f9dcefdb9c"],
 " is the normal-ordered product ",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{":", " ", 
    RowBox[{"\[CenterDot]", " ", 
     RowBox[{":", " "}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8dcbf220-87a3-f641-9131-a2d5cc1d1b61"],
 " of field theory, which moves creators left without applying the \
commutator. It is a different operator from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BosonicNormalOrder"]], 
    "paclet:Wolfram/QuantumFramework/ref/BosonicNormalOrder", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "99a8a8ca-6ae0-c043-bbc4-82ad047df80d"],
 ", and the two differ by the vacuum term:"
}], "MathCaption",
 CellChangeTimes->{4.004022236751177*^9},
 CellID->879092079,ExpressionUUID->"ef9bc973-3f48-b642-8a1b-8208e53de192"],

