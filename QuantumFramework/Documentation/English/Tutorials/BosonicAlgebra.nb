  FontSize->0.9 Inherited,ExpressionUUID->
  "398f37c8-57ce-7043-88ae-e34934d6db25"],
 " for the coupled evolution at ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["t", "TI"], "=", "1"}], ",", "\[ThinSpace]", "2", ",", 
   "\[ThinSpace]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a697a314-fdf9-074e-8099-a504d4875122"],
 ":"
}], "MathCaption",
