Cell[CellGroupData[{

Cell["Merging and braiding", "Section",
 CellID->826641493,ExpressionUUID->"7ee7c61f-7bfc-c570-78e5-877c66016723"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BosonicExpSimplify"]], 
    "paclet:Wolfram/QuantumFramework/ref/BosonicExpSimplify", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4a62ec63-5a0a-734e-a855-0b61d037b659"],
 " goes the other way, merging exponentials whenever the algebra closes. For \
linear generators Baker-Campbell-Hausdorff terminates and the merge is exact:"
}], "MathCaption",
 CellChangeTimes->{4.004022267246319*^9},
 CellID->189206459,ExpressionUUID->"ac748ad1-9a61-7545-9a24-90b525614e02"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BosonicExpSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"\[Alpha]", " ", "ad"}], "]"}], "**", 
    RowBox[{"Exp", "[", 
     RowBox[{"\[Beta]", " ", "a"}], "]"}]}], ",", "v"}], "]"}]], "Input",
 CellChangeTimes->{4.0040222716672974`*^9},
 CellLabel->"In[164]:=",
 CellID->7934004,ExpressionUUID->"d6014e03-f633-0245-9ad0-d0f3ea28b142"],

Cell[BoxData[
 SuperscriptBox["\[ExponentialE]", 
  RowBox[{
   RowBox[{"\[FormalA]", " ", "\[Beta]"}], "-", 
   FractionBox[
    RowBox[{"\[Alpha]", " ", "\[Beta]"}], "2"], "+", 
   RowBox[{"\[Alpha]", " ", 
    SuperscriptBox["\[FormalA]", "\[Dagger]"]}]}]]], "Output",
 CellChangeTimes->{4.0040222723363132`*^9},
 CellLabel->"Out[164]=",
 CellID->243232998,ExpressionUUID->"8fa407d0-50d3-6148-8580-297fe0fd42c5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["A conjugation by a displacement shifts the mode:", "MathCaption",
