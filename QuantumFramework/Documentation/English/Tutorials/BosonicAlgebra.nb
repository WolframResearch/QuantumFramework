}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BosonicExpBraid"]], 
    "paclet:Wolfram/QuantumFramework/ref/BosonicExpBraid", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "72eb3a16-723f-b44b-a251-baa18a10570f"],
 " only moves one exponential past the other, transporting its generator:"
}], "MathCaption",
