Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"exp", "(", 
    FractionBox[
     RowBox[{
      RowBox[{"625", " ", "\[ImaginaryI]", " ", 
       SuperscriptBox["t", "3"], " ", 
       RowBox[{"sinc", "(", 
        RowBox[{
         FractionBox["1", "3"], " ", 
         SqrtBox["5"], " ", 
         SqrtBox[
          SuperscriptBox["t", "2"]]}], ")"}]}], "+", 
      RowBox[{"18", " ", "\[ImaginaryI]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "t"}], "+", 
         RowBox[{
          SqrtBox["5"], " ", 
          SqrtBox[
           SuperscriptBox["t", "2"]], " ", 
          RowBox[{"(", 
           RowBox[{"t", "+", "\[ImaginaryI]"}], ")"}], " ", 
          RowBox[{"sin", "(", 
           RowBox[{
            FractionBox["1", "3"], " ", 
            SqrtBox["5"], " ", 
            SqrtBox[
             SuperscriptBox["t", "2"]]}], ")"}]}]}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"655", " ", "t"}], "+", 
         RowBox[{"18", " ", "\[ImaginaryI]"}]}], ")"}], " ", "t", " ", 
       RowBox[{"cos", "(", 
        RowBox[{
         FractionBox["1", "3"], " ", 
         SqrtBox["5"], " ", 
         SqrtBox[
          SuperscriptBox["t", "2"]]}], ")"}]}]}], 
     RowBox[{"1250", " ", "t", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"t", " ", 
         RowBox[{"sinc", "(", 
          RowBox[{
           FractionBox["1", "3"], " ", 
           SqrtBox["5"], " ", 
           SqrtBox[
            SuperscriptBox["t", "2"]]}], ")"}]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"cos", "(", 
          RowBox[{
           FractionBox["1", "3"], " ", 
           SqrtBox["5"], " ", 
           SqrtBox[
            SuperscriptBox["t", "2"]]}], ")"}]}]}], ")"}]}]], ")"}], " ", 
   RowBox[{
    RowBox[{"exp", "(", 
     RowBox[{
      FractionBox[
       RowBox[{"t", " ", 
        RowBox[{"tan", "(", 
         RowBox[{
          FractionBox["1", "3"], " ", 
          SqrtBox["5"], " ", 
          SqrtBox[
           SuperscriptBox["t", "2"]]}], ")"}], " ", 
        TemplateBox[{"NonCommutativeMultiply", 
          RowBox[{"(", 
            SuperscriptBox["\[FormalA]", "\[Dagger]"], ")"}], "2", "**"},
         "GeneralizedPower"]}], 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"3", " ", "t", " ", 
          RowBox[{"tan", "(", 
           RowBox[{
            FractionBox["1", "3"], " ", 
            SqrtBox["5"], " ", 
            SqrtBox[
             SuperscriptBox["t", "2"]]}], ")"}]}]}], "+", 
        RowBox[{"\[ImaginaryI]", " ", 
         SqrtBox["5"], " ", 
         SqrtBox[
          SuperscriptBox["t", "2"]]}]}]], "-", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[FormalA]", "\[Dagger]"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"5", " ", "\[ImaginaryI]", " ", "t", " ", 
           RowBox[{"sinc", "(", 
            RowBox[{
             FractionBox["1", "3"], " ", 
             SqrtBox["5"], " ", 
             SqrtBox[
              SuperscriptBox["t", "2"]]}], ")"}]}], "+", 
          RowBox[{"3", " ", 
           RowBox[{"cos", "(", 
            RowBox[{
             FractionBox["1", "3"], " ", 
             SqrtBox["5"], " ", 
             SqrtBox[
              SuperscriptBox["t", "2"]]}], ")"}]}], "-", "3"}], ")"}]}], 
       RowBox[{"25", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"cos", "(", 
           RowBox[{
            FractionBox["1", "3"], " ", 
            SqrtBox["5"], " ", 
            SqrtBox[
             SuperscriptBox["t", "2"]]}], ")"}], "+", 
          RowBox[{"\[ImaginaryI]", " ", "t", " ", 
           RowBox[{"sinc", "(", 
            RowBox[{
             FractionBox["1", "3"], " ", 
             SqrtBox["5"], " ", 
             SqrtBox[
              SuperscriptBox["t", "2"]]}], ")"}]}]}], ")"}]}]]}], ")"}], "**", 
    FractionBox[
     RowBox[{"exp", "(", 
      RowBox[{
       RowBox[{
        RowBox[{
         SuperscriptBox["\[FormalA]", "\[Dagger]"], "**", "\[FormalA]"}], " ", 
        RowBox[{"log", "(", 
         FractionBox[
          RowBox[{
           SqrtBox["5"], " ", 
           SqrtBox[
            SuperscriptBox["t", "2"]], " ", 
           RowBox[{"sec", "(", 
            RowBox[{
             FractionBox["1", "3"], " ", 
             SqrtBox["5"], " ", 
             SqrtBox[
              SuperscriptBox["t", "2"]]}], ")"}]}], 
          RowBox[{
           RowBox[{
            SqrtBox["5"], " ", 
            SqrtBox[
             SuperscriptBox["t", "2"]]}], "+", 
           RowBox[{"3", " ", "\[ImaginaryI]", " ", "t", " ", 
            RowBox[{"tan", "(", 
             RowBox[{
              FractionBox["1", "3"], " ", 
              SqrtBox["5"], " ", 
              SqrtBox[
               SuperscriptBox["t", "2"]]}], ")"}]}]}]], ")"}]}], "-", 
       RowBox[{
        FractionBox["1", "6"], " ", "\[ImaginaryI]", " ", 
        SqrtBox["5"], " ", "t"}]}], ")"}], 
     SqrtBox[
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "3"]}], " ", "\[ImaginaryI]", " ", 
         SqrtBox["5"], " ", "t"}]], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"cos", "(", 
          RowBox[{
           FractionBox["1", "3"], " ", 
           SqrtBox["5"], " ", 
           SqrtBox[
            SuperscriptBox["t", "2"]]}], ")"}], "+", 
         RowBox[{"\[ImaginaryI]", " ", "t", " ", 
          RowBox[{"sinc", "(", 
           RowBox[{
            FractionBox["1", "3"], " ", 
            SqrtBox["5"], " ", 
            SqrtBox[
             SuperscriptBox["t", "2"]]}], ")"}]}]}], ")"}]}]]], "**", 
    RowBox[{"exp", "(", 
     RowBox[{
      FractionBox[
       RowBox[{"t", " ", 
        RowBox[{"tan", "(", 
         RowBox[{
          FractionBox["1", "3"], " ", 
          SqrtBox["5"], " ", 
          SqrtBox[
           SuperscriptBox["t", "2"]]}], ")"}], " ", 
        TemplateBox[{"NonCommutativeMultiply", "\[FormalA]", "2", "**"},
         "GeneralizedPower"]}], 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"3", " ", "t", " ", 
          RowBox[{"tan", "(", 
           RowBox[{
            FractionBox["1", "3"], " ", 
            SqrtBox["5"], " ", 
            SqrtBox[
             SuperscriptBox["t", "2"]]}], ")"}]}]}], "+", 
        RowBox[{"\[ImaginaryI]", " ", 
         SqrtBox["5"], " ", 
         SqrtBox[
          SuperscriptBox["t", "2"]]}]}]], "-", 
      FractionBox[
       RowBox[{"\[FormalA]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"5", " ", "\[ImaginaryI]", " ", "t", " ", 
           RowBox[{"sinc", "(", 
            RowBox[{
             FractionBox["1", "3"], " ", 
             SqrtBox["5"], " ", 
             SqrtBox[
              SuperscriptBox["t", "2"]]}], ")"}]}], "+", 
          RowBox[{"3", " ", 
           RowBox[{"cos", "(", 
            RowBox[{
             FractionBox["1", "3"], " ", 
             SqrtBox["5"], " ", 
             SqrtBox[
              SuperscriptBox["t", "2"]]}], ")"}]}], "-", "3"}], ")"}]}], 
       RowBox[{"25", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"cos", "(", 
           RowBox[{
            FractionBox["1", "3"], " ", 
            SqrtBox["5"], " ", 
            SqrtBox[
             SuperscriptBox["t", "2"]]}], ")"}], "+", 
          RowBox[{"\[ImaginaryI]", " ", "t", " ", 
           RowBox[{"sinc", "(", 
            RowBox[{
             FractionBox["1", "3"], " ", 
             SqrtBox["5"], " ", 
             SqrtBox[
              SuperscriptBox["t", "2"]]}], ")"}]}]}], ")"}]}]]}], ")"}]}]}], 
