Cell[CellGroupData[{

Cell[TextData[{
 "The ordered form carries a square root of a time-dependent quantity, and \
the principal branch of that root flips sign every half period. The engine \
follows the branch continuously in ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f852a148-8b3b-4541-aa23-d17aea1d9234"],
 ", so the vacuum amplitude stays correct at long times. Against a truncated \
evolution at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "7.3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81ec3e51-947a-5142-bc29-d63ddaee11f6"],
 " with 40, 60 and 80 levels, the difference is the truncation error and goes \
to zero:"
}], "MathCaption",
 CellChangeTimes->{4.0040220060553703`*^9},
 CellID->70172433,ExpressionUUID->"7cfed287-afc9-a14d-b5a1-fc189ce6a371"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"low", "=", 
       RowBox[{"N", "[", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{
          SqrtBox[
           RowBox[{"Range", "[", 
            RowBox[{"s", "-", "1"}], "]"}]], ",", "1"}], "]"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"BosonicMatrixElement", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", "u1", ",", "v"}], "]"}], "/.",
          "\[VeryThinSpace]", 
         RowBox[{"t", "\[Rule]", 
          FractionBox["73", "10"]}]}], "]"}], "-", 
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "7.3"}], " ", "\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"h1", "/.", "\[VeryThinSpace]", 
              RowBox[{"NonCommutativeMultiply", "\[Rule]", "Dot"}]}], "/.", 
             "\[VeryThinSpace]", 
             RowBox[{
              TemplateBox[{"Dot", "m_", "k_", "."},
               "GeneralizedPower"], "\[RuleDelayed]", 
              RowBox[{"MatrixPower", "[", 
               RowBox[{"m", ",", "k"}], "]"}]}]}], "/.", "\[VeryThinSpace]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ad", "\[Rule]", 
               RowBox[{"Transpose", "[", "low", "]"}]}], ",", 
              RowBox[{"a", "\[Rule]", "low"}]}], "}"}]}], ")"}]}], "]"}], "\[LeftDoubleBracket]", 
        RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}]}], "]"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", 
     RowBox[{"{", 
      RowBox[{"40", ",", "60", ",", "80"}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{4.004022012685068*^9},
 CellLabel->"In[153]:=",
 CellID->100877440,ExpressionUUID->"66fc2bae-a2b1-2347-be45-366b35fadef1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "5.478121047526501`*^-8", ",", "9.26705283282141`*^-12", ",", 
