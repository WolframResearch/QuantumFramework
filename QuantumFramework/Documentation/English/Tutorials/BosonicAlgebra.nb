 CellLabel->"Out[116]=",
 CellID->85841256,ExpressionUUID->"2962e018-2bb2-1145-b8a6-2d594416d2ac"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Blasiak method can be specially useful for single long products with high \
exponents:\
\>", "MathCaption",
 CellChangeTimes->{{4.0040215564813404`*^9, 4.0040215795522823`*^9}},
 CellID->200022447,ExpressionUUID->"db071d81-58b6-784c-bd58-cc6e390c7ba7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"BosonicNormalOrder", "[", 
   RowBox[{
    TemplateBox[{"NonCommutativeMultiply", 
      RowBox[{"(", 
        RowBox[{
          
          TemplateBox[{"NonCommutativeMultiply", "\[FormalB]", "5", "**"}, 
           "GeneralizedPower"], "**", 
          TemplateBox[{"NonCommutativeMultiply", 
            RowBox[{"(", 
              SuperscriptBox["\[FormalB]", "\[Dagger]"], ")"}], "5", "**"}, 
           "GeneralizedPower"]}], ")"}], "15", "**"},
     "GeneralizedPower"], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       SuperscriptBox["\[FormalB]", "\[Dagger]"], "}"}], ",", 
      RowBox[{"{", "\[FormalB]", "}"}]}], "}"}], ",", 
    RowBox[{"Method", "->", "\"\<Blasiak\>\""}]}], "]"}], "//", 
  RowBox[{
   RowBox[{"Short", "[", 
    RowBox[{"#", ",", "3"}], "]"}], "&"}]}]], "Input",
 CellChangeTimes->{{4.004021591040346*^9, 4.004021599351099*^9}},
