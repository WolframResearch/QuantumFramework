          RowBox[{"Exp", "[", 
           RowBox[{"r", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"bd1", "**", "bd2"}], "-", 
              RowBox[{"b1", "**", "b2"}]}], ")"}]}], "]"}], ",", "v2", ",", 
          RowBox[{"Assumptions", "\[Rule]", 
           RowBox[{"r", ">", "0"}]}]}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", "3"}], "}"}]}], "]"}], ",", "k"}], "]"}], 
