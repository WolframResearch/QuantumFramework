Cell[CellGroupData[{

Cell[TextData[{
 "The trace of ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["x", "TI"], "1", 
    SubscriptBox[
     StyleBox["N", "TI"], "1"]], 
   SubsuperscriptBox[
    StyleBox["x", "TI"], "2", 
    SubscriptBox[
     StyleBox["N", "TI"], "2"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aaf5206-2b3d-4b49-8bef-66f51ef3d209"],
 " is a product of geometric series, provided ",
 Cell[BoxData[
  RowBox[{"|", 
   SubscriptBox[
    StyleBox["x", "TI"], "i"], "|", 
   RowBox[{"<", "1"}]}]], "InlineFormula",ExpressionUUID->
  "783bc936-0366-4844-a8f1-89caf82bf512"],
 " :"
}], "MathCaption",
 CellChangeTimes->{4.0040239944627*^9},
 CellID->403544108,ExpressionUUID->"a19cbf11-e966-194a-ba20-4fb426fab86f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  UnderoverscriptBox["\[Sum]", 
   RowBox[{"k1", "=", "0"}], "\[Infinity]"], 
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"k2", "=", "0"}], "\[Infinity]"], 
   RowBox[{"BosonicMatrixElement", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k1", ",", "k2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k1", ",", "k2"}], "}"}]}], "}"}], ",", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", "x1", "]"}], " ", 
        RowBox[{"bd1", "**", "b1"}]}], "+", 
       RowBox[{
        RowBox[{"Log", "[", "x2", "]"}], " ", 
        RowBox[{"bd2", "**", "b2"}]}]}], "]"}], ",", "v2"}], 
    "]"}]}]}]], "Input",
