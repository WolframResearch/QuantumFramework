 FormBox[
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"\[Beta]", " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", "\[Lambda]"], "-", "1"}], ")"}], " ", 
    TemplateBox[{"\[Alpha]"},
     "Conjugate"]}]], TraditionalForm]], "Output",
 CellChangeTimes->{{4.0040239393839455`*^9, 4.00402394195644*^9}},
 CellLabel->"Out[186]=",
 CellID->34075130,ExpressionUUID->"e344009b-2e89-4c4c-be4b-07dd5174203e"]
}, Open  ]]
