 FormBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[Beta]", " ", 
     RowBox[{"(", 
      RowBox[{"\[FormalA]", "-", "\[Alpha]"}], ")"}]}]], "**", 
   SuperscriptBox["\[ExponentialE]", 
