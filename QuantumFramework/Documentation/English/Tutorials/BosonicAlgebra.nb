Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"h1", "=", 
   RowBox[{
    RowBox[{"ad", "**", "a"}], "+", 
    RowBox[{
     FractionBox["1", "3"], " ", 
     RowBox[{"(", 
      RowBox[{
       TemplateBox[{"NonCommutativeMultiply", "a", "2", "**"},
        "GeneralizedPower"], "+", 
       TemplateBox[{"NonCommutativeMultiply", "ad", "2", "**"},
        "GeneralizedPower"]}], ")"}]}], "+", 
    FractionBox[
     RowBox[{"ad", "+", "a"}], "5"]}]}], ";"}], "\[IndentingNewLine]", 
