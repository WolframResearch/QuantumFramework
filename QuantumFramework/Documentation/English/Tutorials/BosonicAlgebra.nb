Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindSequenceFunction", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"BosonicVEV", "[", 
      RowBox[{
       RowBox[{
        TemplateBox[{"NonCommutativeMultiply", "a", "m", "**"},
         "GeneralizedPower"], "**", 
        TemplateBox[{"NonCommutativeMultiply", "ad", "m", "**"},
         "GeneralizedPower"]}], ",", "v"}], "]"}], ",", 
     RowBox[{"{", 
