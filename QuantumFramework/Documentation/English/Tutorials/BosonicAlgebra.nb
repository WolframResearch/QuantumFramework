   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"\[Alpha]", " ", "ad"}], "]"}], " ", "**", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"\[Beta]", " ", "a"}], "]"}]}], ",", " ", "v"}], "]"}]], "Input",
