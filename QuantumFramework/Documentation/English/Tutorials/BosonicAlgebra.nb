 CellID->511430997,ExpressionUUID->"eccbdfe7-48c1-ec4a-9038-7e7b137ff9a3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"uh", "=", 
   RowBox[{"BosonicExpOrder", "[", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", "h2"}], "]"}], ",", 
     "v2"}], "]"}]}], ";"}], "\n", 
 RowBox[{"hop", "=", 
  RowBox[{"N", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"BosonicMatrixElement", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", "uh", ",", "v2"}], 
       "]"}], "/.", "\[VeryThinSpace]", 
      RowBox[{"t", "\[Rule]", "tt"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"tt", ",", "1", ",", "3"}], "}"}]}], "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{4.0040223835626793`*^9},
 CellLabel->"In[170]:=",
 CellID->115879268,ExpressionUUID->"03747be7-e35e-cc4b-990b-baa1ad19fba3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "0.22355216504441872`"}], "-", 
    RowBox[{"0.08277741270018923`", " ", "\[ImaginaryI]"}]}], ",", 
   RowBox[{
    RowBox[{"-", "0.30756721136721055`"}], "+", 
    RowBox[{"0.34161429852268865`", " ", "\[ImaginaryI]"}]}], ",", 
   RowBox[{"0.30425845836088994`", "\[VeryThinSpace]", "+", 
    RowBox[{"0.5397755509328437`", " ", "\[ImaginaryI]"}]}]}], 
  "}"}]], "Output",
