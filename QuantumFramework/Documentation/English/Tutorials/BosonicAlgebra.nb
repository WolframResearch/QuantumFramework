     RowBox[{
      StyleBox["tanh",
       FontSlant->"Plain"], 
      StyleBox["r", "TI"]}], ")", 
     SubsuperscriptBox["\[Alpha]", "1", "*"], 
     SubsuperscriptBox["\[Alpha]", "2", "*"]}]], 
   FractionBox[
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Alpha]", "1"], 
       SubscriptBox["\[Alpha]", "2"]}], "|", 
      RowBox[{"0", " ", "0"}]}], "\[RightAngleBracket]"}], 
