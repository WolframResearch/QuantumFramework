Cell["\<\
We will briefly discuss how the abstraction is done in our framework and how \
quantum objects depend on each other.\
\>", "Text",
 CellID->515379898,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell["QuditName", "Section",
 CellID->604760901,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuditName"]], "paclet:Wolfram/QuantumFramework/ref/QuditName", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "35077f55-9291-6519-633d-771f27244c63"],
 " is a convenient wrapper around qudit names with unique formatting. It \
supports both bra and ket formatting. Its general input is as follows: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuditName"]], "paclet:Wolfram/QuantumFramework/ref/QuditName",
      "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", " ", 
    RowBox[{"\"\<Dual\>\"", " ", "->", " ", 
     StyleBox["bool", "TI"]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebf3687-f906-130d-7644-afe0f8b37e57"],
 ", where ",
 StyleBox["bool", "TI"],
 " can be ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 "."
}], "Text",
 CellID->1476799103,ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],

Cell["A qudit name, as \[CapitalPhi], in bra format:", "Text",
 CellID->448336599,ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"],

Cell[BoxData[
 RowBox[{"QuditName", "[", 
  RowBox[{"\"\<\[CapitalPhi]\>\"", ",", " ", 
   RowBox[{"\"\<Dual\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->970785311,ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],

Cell["A qudit name, as \[CapitalPhi], in ket format:", "Text",
 CellID->1377816002,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],

Cell[BoxData[
 RowBox[{"QuditName", "[", 
  RowBox[{"\"\<\[CapitalPhi]\>\"", ",", " ", 
   RowBox[{"\"\<Dual\>\"", " ", "->", " ", "False"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->1439899046,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell["\<\
1D qudit does not represent a physical qudit, and we will use it as dummy \
qudit. We should also consider the cases of no qudit, which is defined as \
follows\
\>", "Text",
 CellID->1641200340,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell[BoxData[
 RowBox[{"QuditName", "[", "]"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->1424533854,ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell["A zero-dimension qudit is also possible:", "Text",
 CellID->535457321,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell[BoxData[
 RowBox[{"QuditName", "[", 
  RowBox[{"{", "}"}], "]"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->141959522,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell["\<\
We will explain in the following sections why it is important to have a \
well-defined no-qudit case.\
\>", "Text",
 CellID->299517738,ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"],

Cell["QuditBasis", "Section",
 CellID->2142391071,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell[TextData[{
 "The next level of abstraction is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuditBasis"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuditBasis", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 ", which is a wrapper for an association with keys as ",
 StyleBox["names", "TI"],
 " and values as the corresponding ",
 StyleBox["tensor", "TI"],
 " representation. The key-value has this form: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["Q", "TI"], 
    StyleBox["u", "TI"], 
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"], 
    StyleBox["t", "TI"], 
    StyleBox["N", "TI"], 
    StyleBox["a", "TI"], 
    StyleBox["m", "TI"], 
    StyleBox["e", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], "\[Ellipsis]", 
    StyleBox["]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["i", "TI"], "}", "\[Rule]", 
    StyleBox["tensor",
     FontSlant->"Italic"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 ", where ",
 StyleBox["i", "TI"],
 " enumerates qudits (to describe many qudit systems)."
}], "Text",
 CellID->1002769646,ExpressionUUID->"644cc522-c7c4-9b18-0c73-dc8ff276e662"],

Cell[TextData[{
 "Show ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MatrixForm"]], "paclet:ref/MatrixForm"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
 " of a qubit basis:"
}], "Text",
 CellID->436346740,ExpressionUUID->"6801f052-da94-0b6f-183e-ea1fdf2159b5"],

Cell[BoxData[
 RowBox[{"MatrixForm", " ", "/@", " ", 
  RowBox[{
   RowBox[{"QuditBasis", "[", "2", "]"}], "[", "\"\<Representations\>\"", 
   "]"}]}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->2122865143,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell[TextData[{
 "Show ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MatrixForm"]], "paclet:ref/MatrixForm"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 " of a 3D qudit basis:"
}], "Text",
 CellID->1735808809,ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

Cell[BoxData[
 RowBox[{"MatrixForm", " ", "/@", " ", 
  RowBox[{
   RowBox[{"QuditBasis", "[", "3", "]"}], "[", "\"\<Representations\>\"", 
   "]"}]}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->753514147,ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell[TextData[{
 "Show ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MatrixForm"]], "paclet:ref/MatrixForm"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],
 " of a 2D\[CircleTimes]3D qudit basis:"
}], "Text",
 CellID->1164297175,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell[BoxData[
 RowBox[{"MatrixForm", " ", "/@", " ", 
  RowBox[{
   RowBox[{"QuditBasis", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<I\>\"", ",", " ", "\"\<X\>\""}], "}"}], "]"}], 
   "[", "\"\<Representations\>\"", "]"}]}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->632614636,ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

Cell["\<\
The actual basis for the above example is generated by the tensor product of \
above tensors:\
\>", "Text",
 CellID->1689610856,ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"],

Cell[BoxData[
 RowBox[{"MatrixForm", " ", "/@", " ", 
  RowBox[{
   RowBox[{"QuditBasis", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<I\>\"", ",", " ", "\"\<X\>\""}], "}"}], "]"}], 
   "[", "\"\<Association\>\"", "]"}]}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->1303163127,ExpressionUUID->"4b6e5dad-9702-0c1f-7916-54f722b75765"],

Cell["\<\
For example, the first element of above association is generated as\
\>", "Text",
 CellID->2098230307,ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TensorProduct", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}]}], "]"}], " ", "//", " ", 
  "MatrixForm"}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->1930159659,ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell["Unit-basis is defined as 1D-qudit case:", "Text",
 CellID->1113655915,ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell[BoxData[
 RowBox[{"QuditBasis", "[", "]"}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->1606118752,ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],

Cell["QuantumBasis", "Subsection",
 CellID->2141499446,ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

Cell[TextData[{
 "The next level of abstraction is our framework is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumBasis"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 ". Its generic form is as follows: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Input\>\"", " ", "->", " ", 
      RowBox[{"QuditBasis", "[", "\[Ellipsis]", "]"}]}], ",", " ", 
     RowBox[{"\"\<Output\>\"", " ", "->", " ", 
      RowBox[{"QuditBasis", "[", "\[Ellipsis]", "]"}]}], ",", " ", 
     RowBox[{"\"\<Picture\>\"", " ", "->", " ", "\[Ellipsis]"}], ",", " ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "\[Ellipsis]"}], ",", " ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", "\[Ellipsis]"}]}], "|>"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04786d0e-016a-d127-2c07-8568b01ca00d"],
 "."
}], "Text",
 CellID->339082558,ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

Cell[TextData[{
 "In contrast to previous quantum objects, the key additions for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumBasis"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2d1ff276-b82a-c3ca-5b24-f43039dc9110"],
 " are the input and output information. All other details are the basis \
options:"
}], "Text",
 CellID->432388834,ExpressionUUID->"14fd1512-f616-8834-3c82-8d5f83a0db1e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", 
   RowBox[{
    RowBox[{"{", "2", "}"}], ",", " ", 
    RowBox[{"{", "3", "}"}]}], "]"}], "[", "\"\<Options\>\"", "]"}]], "Input",\

 CellLabel->"In[11]:= ",
 CellID->443736588,ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"],

Cell["Pauli-X quantum basis:", "Text",
 CellID->1593449978,ExpressionUUID->"48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", "2", "]"}], " ", "//", " ", 
  "InputForm"}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->1742646261,ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],

Cell["Note in this case, there is no input, and only one output:", "Text",
 CellID->29467524,ExpressionUUID->"11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", "2", "]"}], "[", "\"\<Input\>\"", 
  "]"}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->1939141443,ExpressionUUID->"7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", "2", "]"}], "[", "\"\<Output\>\"", 
  "]"}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->5047578,ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell["\<\
The diagram for the basis shows clearly the input and output:\
\>", "Text",
 CellID->15008895,ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", "2", "]"}], "[", "\"\<Diagram\>\"", 
  "]"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->1892712309,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell["\<\
In the Wolfram Quantum Framework, the bold formatting in the summary box \
signifies input, corresponding to column indices (covariant, or bra), whereas \
the normal formatting represents output, corresponding to row indices \
(contravariant, or ket). An illustration of this distinction can be found in \
the summary box of the following basis:\
\>", "Text",
 CellID->787969749,ExpressionUUID->"5e187950-8ca2-2ab2-0638-711a25577898"],

Cell[BoxData[
 RowBox[{"QuantumBasis", "[", 
  RowBox[{
   RowBox[{"{", "2", "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->525088789,ExpressionUUID->"250a2d7c-9b81-05b0-5309-c5261e346f9a"],

Cell["QuantumState", "Section",
 CellID->357930410,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell[TextData[{
 "The next level of abstraction is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumState"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumState", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],
 ", which has the general form of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumState"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumState", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["state", "TI"], ",", " ", 
    RowBox[{"QuantumBasis", "[", "\[Ellipsis]", "]"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43821c38-6720-b4f9-71b1-966212da1ec3"],
 ", with ",
 StyleBox["state", "TI"],
 " can be a state vector or a density matrix."
}], "Text",
 CellID->1802489801,ExpressionUUID->"341c54d9-3079-6bba-5c24-4d83410c3980"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"state", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "1", ",", " ", "I", ",", " ", "1", ",", " ", "I", ",", " ", "3", ",", 
       " ", 
       RowBox[{"3", " ", "I"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"state", " ", "//", " ", "InputForm"}]}], "Input",
 CellLabel->"In[17]:= ",
 CellID->115301326,ExpressionUUID->"1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],

Cell["\<\
The above state is a conventional quantum state (a composite 2\[CircleTimes]3 \
dimensional state), with two outputs and no input:\
\>", "Text",
 CellID->1651187567,ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"],

Cell[BoxData[
 RowBox[{"state", "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[18]:= ",
 CellID->941376513,ExpressionUUID->"6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],

Cell["Show input:", "Text",
 CellID->2120243592,ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

Cell[BoxData[
 RowBox[{"state", "[", "\"\<Input\>\"", "]"}]], "Input",
 CellLabel->"In[19]:= ",
 CellID->1047559317,ExpressionUUID->"07359582-e823-44a1-2eca-0cef89d62e8b"],

Cell["Show output:", "Text",
 CellID->1820947576,ExpressionUUID->"7c239bd0-3ff5-3b18-25d0-129ab9818662"],

Cell[BoxData[
 RowBox[{"state", "[", "\"\<Output\>\"", "]"}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->670734585,ExpressionUUID->"68c76573-72ce-0c1a-18fd-7d3d077b5760"],

Cell["\<\
Create a bra state, which is the conjugate-transpose of the original state:\
\>", "Text",
 CellID->58232708,ExpressionUUID->"6184d2f2-049e-728e-17bb-cbbcad2b40d4"],

Cell[BoxData[
 RowBox[{"bra", " ", "=", " ", 
  InterpretationBox[
   FormBox[
    SuperscriptBox[
     RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], "\[Dagger]"],
    StandardForm],
   SuperDagger[
    Wolfram`QuantumFramework`QuantumState["0"]]]}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->393464600,ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"],

Cell["\<\
A state with no output and only input is called an effect (see the above \
summary box).\
\>", "Text",
 CellID->1484396876,ExpressionUUID->"19bb1c5e-57ab-6e36-4f58-9618625e351c"],

Cell["As one can see, a bra has no output, but only input:", "Text",
 CellID->1149283354,ExpressionUUID->"5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],

Cell[BoxData[
 RowBox[{"bra", "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->1092188694,ExpressionUUID->"30baa1c8-66ad-75e0-6059-389213585fca"],

Cell["Return the input:", "Text",
 CellID->559599970,ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"],

Cell[BoxData[
 RowBox[{"bra", "[", "\"\<Input\>\"", "]"}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->1710123944,ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell["Return the output:", "Text",
 CellID->934597701,ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"],

Cell[BoxData[
 RowBox[{"bra", "[", "\"\<Output\>\"", "]"}]], "Input",
 CellLabel->"In[24]:= ",
 CellID->284780108,ExpressionUUID->"511b3347-8d7d-ab60-0738-ab212409f64a"],

Cell["An inner product (bra-ket):", "Text",
 CellID->643798763,ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"],

Cell[BoxData[
 RowBox[{"braket", " ", "=", " ", 
  RowBox[{
   InterpretationBox[
    FormBox[
     SuperscriptBox[
      RowBox[{"QuantumState", "[", "\"\<Plus\>\"", "]"}], "\[Dagger]"],
     StandardForm],
    SuperDagger[
     Wolfram`QuantumFramework`QuantumState["Plus"]]], "@", 
   RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}]}]}]], "Input",
 CellLabel->"In[25]:= ",
 CellID->268959046,ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

Cell["An inner product is a scalar (see the summary box above):", "Text",
 CellID->403125484,ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"],

Cell[BoxData[
 RowBox[{"braket", "[", "\"\<Scalar\>\"", "]"}]], "Input",
 CellLabel->"In[26]:= ",
 CellID->931950651,ExpressionUUID->"5900aac7-5263-773e-0f3f-43a167165a04"],

Cell["The inner product is a pure scalar (no input, no output):", "Text",
 CellID->412518898,ExpressionUUID->"06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],

Cell[BoxData[
 RowBox[{"AssociationMap", "[", 
  RowBox[{"braket", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Input\>\"", ",", " ", "\"\<Output\>\""}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[27]:= ",
 CellID->622967176,ExpressionUUID->"12d95fcb-3316-2212-42e7-569546a37178"],

Cell["Create a ket-bra:", "Text",
 CellID->1358080856,ExpressionUUID->"733995c2-f5bf-78ee-22c6-0caffc4a4a34"],

Cell[BoxData[
 RowBox[{"ketbra", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], "@", 
   InterpretationBox[
    FormBox[
     SuperscriptBox[
      RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}], "\[Dagger]"],
     StandardForm],
    SuperDagger[
     Wolfram`QuantumFramework`QuantumState["1"]]]}]}]], "Input",
 CellLabel->"In[28]:= ",
 CellID->320615307,ExpressionUUID->"4f8ab258-7e7f-0723-7589-34027b0a6a09"],

Cell["Return the traditional form:", "Text",
 CellID->1594238871,ExpressionUUID->"6b12ee74-9953-131d-1921-003e18e67e67"],

Cell[BoxData[
 RowBox[{"TraditionalForm", "[", "ketbra", "]"}]], "Input",
 CellLabel->"In[29]:= ",
 CellID->2002505366,ExpressionUUID->"65262d3c-fccc-1dc6-0cdd-c579f579672c"],

Cell["A ket-bra is called map, which has both input and output:", "Text",
 CellID->2121396920,ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"],

Cell[BoxData[
 RowBox[{"AssociationMap", "[", 
  RowBox[{"ketbra", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Input\>\"", ",", " ", "\"\<Output\>\""}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[30]:= ",
 CellID->993357154,ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"],

Cell["Show diagram:", "Text",
 CellID->50259360,ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"],

Cell[BoxData[
 RowBox[{"ketbra", "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[31]:= ",
 CellID->680111415,ExpressionUUID->"1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],

Cell[TextData[{
 "The above ket-bra is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Composition"]], "paclet:ref/Composition"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "187adc3d-3961-76c2-4819-d667b8145c28"],
 " of ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "641c78eb-7f03-7846-0c24-71b57ab64aac"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Bra"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],
 ", which is reflected in its label."
}], "Text",
 CellID->1912025938,ExpressionUUID->"112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],

Cell[BoxData[
 RowBox[{"ketbra", "[", "\"\<Label\>\"", "]"}]], "Input",
 CellLabel->"In[32]:= ",
 CellID->1678275947,ExpressionUUID->"6121b9de-dddd-aca8-10de-309bd469f6f2"],

Cell["Show corresponding quantum basis", "Text",
 CellID->1570109414,ExpressionUUID->"30209679-023a-ee91-61df-0823b7ccb4fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ketbra", "[", "\"\<Basis\>\"", "]"}], " ", "//", " ", 
  "InputForm"}]], "Input",
 CellLabel->"In[33]:= ",
 CellID->746824257,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell["QuantumOperator", "Section",
 CellID->966663717,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell[TextData[{
 "The next level of abstraction in our framework is QuantumOperator, which is \
QuantumOperator[QuantumState[\[Ellipsis]], ",
 StyleBox["order", "TI"],
 "]. In other words, one can see it as a quantum state plus an order, where \
the order describes where the operator acts."
}], "Text",
 CellID->634665076,ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"],

Cell["Show input form of Pauli-x operator, acting on 2nd qubit", "Text",
 CellID->1607396713,ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumOperator", "[", 
   RowBox[{"\"\<X\>\"", ",", " ", 
    RowBox[{"{", "2", "}"}]}], "]"}], " ", "//", " ", "InputForm"}]], "Input",\

 CellLabel->"In[34]:= ",
 CellID->171231949,ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],

Cell["Show diagram of a Pauli-X operator acting on 2nd qubit", "Text",
 CellID->820919957,ExpressionUUID->"51fce014-dca1-0630-0783-fa51d5546d1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumOperator", "[", 
   RowBox[{"\"\<X\>\"", ",", " ", 
    RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",\

 CellLabel->"In[35]:= ",
 CellID->1006830744,ExpressionUUID->"657c1c65-980e-511d-1303-964f19bb2067"],

Cell[TextData[{
 "Show the order of above operator (note the order has the form ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"output", ",", "input"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],
 ")"
}], "Text",
 CellID->1175763064,ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumOperator", "[", 
   RowBox[{"\"\<X\>\"", ",", " ", 
    RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<Order\>\"", "]"}]], "Input",
 CellLabel->"In[36]:= ",
 CellID->1074416020,ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"],

Cell["Show input order", "Text",
 CellID->2143439988,ExpressionUUID->"1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumOperator", "[", 
   RowBox[{"\"\<X\>\"", ",", " ", 
    RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<InputOrder\>\"", 
  "]"}]], "Input",
 CellLabel->"In[37]:= ",
 CellID->1933756212,ExpressionUUID->"370294fd-9e49-2d35-5d31-0da71bfc741f"],

Cell["Show output order", "Text",
 CellID->943735407,ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumOperator", "[", 
   RowBox[{"\"\<X\>\"", ",", " ", 
    RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<OutputOrder\>\"", 
  "]"}]], "Input",
 CellLabel->"In[38]:= ",
 CellID->865519937,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell["QuantumMeasurementOperator", "Section",
 CellID->845186625,ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell[TextData[{
 "QuantumMeasurementOperator is abstracted as quantum operator plus target, \
i.e. QuantumMeasurementOperator[QuantumOperator[\[Ellipsis]], ",
 StyleBox["target", "TI"],
 "]which is ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   StyleBox["e", "TI"], 
   StyleBox["i", "TI"], 
   StyleBox["g", "TI"], 
   StyleBox["e", "TI"], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox["p", "TI"], 
   StyleBox["r", "TI"], 
   StyleBox["o", "TI"], 
   StyleBox["j", "TI"], 
   StyleBox["e", "TI"], 
   StyleBox["c", "TI"], 
   StyleBox["t", "TI"], 
   StyleBox["o", "TI"], 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6405505f-4b92-3bd6-0c3b-4a196e24893c"],
 " of that measurement."
}], "Text",
 CellID->14312863,ExpressionUUID->"6878c7f8-419e-9db5-1807-dea27028e79f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumMeasurementOperator", "[", "\"\<X\>\"", "]"}], " ", "//", 
  " ", "InputForm"}]], "Input",
 CellLabel->"In[39]:= ",
 CellID->315698450,ExpressionUUID->"48a3d607-c312-9dd3-7850-c860f6a4e739"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumMeasurementOperator", "[", 
   RowBox[{"\"\<X\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}], " ", "//", " ", 
  "TraditionalForm"}]], "Input",
 CellLabel->"In[40]:= ",
 CellID->1751204118,ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"],

Cell["QuantumMeasurement", "Section",
 CellID->2116603297,ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell["\<\
It is a wrapper for quantum measurement operator, that represents a quantum \
measurement\
\>", "Text",
 CellID->530919167,ExpressionUUID->"023f49e2-a747-9723-33c5-60cfd2f3fa09"],

Cell[BoxData[
 RowBox[{"mea", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumMeasurementOperator", "[", "]"}], "@", "\n", "  ", 
   RowBox[{
    RowBox[{"QuantumMeasurementOperator", "[", "]"}], "[", 
    RowBox[{"QuantumState", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[41]:= ",
 CellID->1242319925,ExpressionUUID->"21aa1c49-e16c-f406-57a9-9612901edf6c"],

Cell[BoxData[
 RowBox[{"mea", " ", "//", " ", "InputForm"}]], "Input",
 CellLabel->"In[42]:= ",
 CellID->1600082692,ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"],

Cell["QuantumChannel", "Section",
 CellID->1091979148,ExpressionUUID->"12f3dbee-abc4-6375-4280-d2cbce714e5f"],

Cell["\<\
It is a wrapper for quantum operators, representing a quantum channel\
\>", "Text",
 CellID->1239660989,ExpressionUUID->"7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumChannel", "[", 
   RowBox[{
    RowBox[{"\"\<BitFlip\>\"", "[", "p", "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], " ", "//", " ", 
  "InputForm"}]], "Input",
 CellLabel->"In[43]:= ",
 CellID->234435634,ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"],

Cell["QuantumCircuitOperator", "Section",
 CellID->417968184,ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell["\<\
QuantumCircuitOperator is abstracted as an association with elements as list \
of operators, ops, and a circuit label, i.e. QuantumCircuitOperator[<|\
\[CloseCurlyDoubleQuote]Elements\[CloseCurlyDoubleQuote] -> ops, \
\[OpenCurlyDoubleQuote]Label\[CloseCurlyDoubleQuote] -> \
\[OpenCurlyDoubleQuote]Bell\[CloseCurlyDoubleQuote]|>]\
\>", "Text",
 CellID->1274591649,ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[TextData[{
 "The elements of the Bell circuit as ",
 Cell[BoxData["ops"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa29c-d013-1000-4004-3bd9e1a6636a"],
 ":"
}], "Text",
 CellID->1243964799,ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[BoxData[
 RowBox[{"ops", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", "\"\<Bell\>\"", "]"}], 
   "[", "\"\<Elements\>\"", "]"}]}]], "Input",
 CellLabel->"In[44]:= ",
 CellID->1828403510,ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell["The circuit rebuilt from its association:", "Text",
 CellID->623026911,ExpressionUUID->"2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],

Cell[BoxData[
 RowBox[{"QuantumCircuitOperator", "[", 
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<Elements\>\"", " ", "->", " ", "ops"}], ",", " ", 
    RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<Bell\>\""}]}], "|>"}], 
  "]"}]], "Input",
 CellLabel->"In[45]:= ",
 CellID->308489360,ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", "\"\<Bell\>\"", "]"}], " ", "//", 
  " ", "InputForm"}]], "Input",
 CellLabel->"In[46]:= ",
 CellID->387004599,ExpressionUUID->"52243646-2fbd-210e-03db-a8204a487054"],

