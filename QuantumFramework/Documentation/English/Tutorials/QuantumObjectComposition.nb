Cell[576, 22, 118, 1, 70, "Title",ExpressionUUID->"2570a8a5-7a6f-59e7-530f-410f7f1a2bcd",
 CellID->509267359],
Cell[697, 25, 2047, 50, 70, "Text",ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c",
 CellID->329621944],
Cell[2747, 77, 138, 1, 70, "Section",ExpressionUUID->"52243646-2fbd-210e-03db-a8204a487054",
 CellID->515379898],
Cell[2888, 80, 697, 16, 70, "Text",ExpressionUUID->"1acd7f4d-3da3-7753-4af3-7717b4565db9",
 CellID->604760901],
Cell[3588, 98, 483, 13, 70, "Input",ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a",
 CellID->1476799103],
Cell[4074, 113, 499, 8, 70, "Text",ExpressionUUID->"1ac7f74a-ce09-be58-4afc-ef17ebbd04a2",
 CellID->448336599],
Cell[4576, 123, 519, 14, 70, "Input",ExpressionUUID->"6f6ad260-8ee1-565a-1569-d44a2a943ca0",
 CellID->970785311],
