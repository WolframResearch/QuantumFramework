Cell["Watching for Events", "Section",ExpressionUUID->"ac31c1d1-729d-4882-986d-3be81c8760d0"],

Cell[TextData[{
 Cell[BoxData["\"\<AdditionalEquations\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88bb2911-d84c-4224-93b8-cc81af19f725"],
 " injects extra equations or specifications into the solve, which is how \
hybrid and piecewise systems are expressed - and how events are detected. \
Here a strong pulsed drive with a constant detuning:"
}], "Text",ExpressionUUID->"35880d83-93f5-400f-bdb1-6def04b114e8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rabiDrive", " ", "=", " ", 
   RowBox[{
    RowBox[{"10.", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"Pi", " ", "t"}], "]"}], " ", 
     RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], " ", "-", " ", 
    RowBox[{
     RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}], "[", "\"\<Operator\>\"",
      "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pulsed", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{"rabiDrive", ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"pulsed", "[", "t", "]"}], "[", "\"\<Probability\>\"", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "2"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->
  "In[52]:= ",ExpressionUUID->"6202e85a-c243-4d13-b98e-cf23888bae5e"],

