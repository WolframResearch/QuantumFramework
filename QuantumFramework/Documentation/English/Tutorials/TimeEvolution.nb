Notebook[{

Cell[CellGroupData[{
Cell["Time Evolution", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumEvolve"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumEvolve", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1575da03-bf08-47a1-b2ad-c65d0ea43ced"],
 " solves the equation of motion of a quantum system. Which equation that is \
depends on what you hand it: the Schrodinger equation for a closed system, \
the Lindblad master equation once jump operators are present, the Heisenberg \
equation when the thing being evolved is an operator, and the Kossakowski \
equation when the jump operators are correlated."
}], "Text",ExpressionUUID->"ee367179-5b7f-408c-a82d-579474887e2d"],

Cell["\<\
The call is the same shape in every case - a Hamiltonian, optionally some \
dissipation, an initial condition, and a time - and the result is always an \
object that depends on time. Supply a time to it and you get an ordinary \
state or operator back, which answers every property the framework knows \
about.\
\>", "Text",ExpressionUUID->"5a69752b-63fb-4332-8c93-7d5d8c01bb5a"],

Cell[TextData[{
 "Two choices control everything else. A bare symbol for the time solves the \
equation ",
 StyleBox["exactly", "TI"],
 ", through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DSolve"]], "paclet:ref/DSolve"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "19d8ba83-33fd-4dcf-acd4-9f3763fede8a"],
 "; a ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"t", ",", " ", "t0", ",", " ", "t1"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b60421cb-bdfb-493f-90ea-22032a09b8bb"],
 " interval solves it ",
 StyleBox["numerically", "TI"],
 ", through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NDSolve"]], "paclet:ref/NDSolve"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fc224235-091c-4b1f-88fe-7ca222d35902"],
 ". And an initial condition of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["None"]], "paclet:ref/None"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ce166eed-d743-4702-ab2a-20ac35d8f65d"],
 " evolves the propagator instead of any particular state, which can then be \
applied to whatever state you like."
}], "Text",ExpressionUUID->"6faa2594-bf99-4900-8e3b-a6a8a456a0ca"],

Cell[BoxData[
 RowBox[{"<<", " ", "Wolfram`QuantumFramework`"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9ba9b4df-7c47-4a0d-86d6-a9467cf38b3f"],

Cell["A Driven Qubit", "Section",ExpressionUUID->"df249651-13bc-40a2-9043-b3879b98572c"],

Cell[TextData[{
 "A ",
 Cell[BoxData["PauliX"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "797d81de-9074-43ef-92ea-e4fea74b22c9"],
 " Hamiltonian drives a qubit between ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4f932f9-e827-44d1-b2a3-469e0f522538"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1ddc553-fad2-4f72-946f-c4f83371bd4b"],
 ". Evolving ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efc180ab-913a-4619-9348-ebfbede1dcaa"],
 " over one full period:"
}], "Text",ExpressionUUID->"e3cb62e9-2a57-46ed-966f-c33b838f2b6d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"psi", " ", "=", " ", 
  RowBox[{"QuantumEvolve", "[", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", "\"\<PauliX\>\"", "]"}], ",", " ", 
    RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "0", ",", " ", 
      RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"958c9b56-2d62-49a8-9fe5-082b7f353d1f"],

