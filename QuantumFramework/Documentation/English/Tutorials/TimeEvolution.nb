Cell[TextData[{
 "To find the times at which the population crosses one half, solve again \
with a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WhenEvent"]], "paclet:ref/WhenEvent"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "61e675db-e635-488f-a336-49a54b012a30"],
 ". The dependent variable of the internal differential equation is the \
formal symbol ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a77cee5-5a73-4911-a9a2-b58731f955c6"],
 ", so the condition is written on ",
 Cell[BoxData[
  RowBox[{"Indexed", "[", 
   RowBox[{
    RowBox[{"\[FormalS]", "[", "t", "]"}], ",", " ", "1"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e98524a8-e6ed-4bc0-aa0f-08c2f9f45fe4"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sow"]], "paclet:ref/Sow"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "041eceb0-3b42-4aa6-b91b-2790cd2f5306"],
 "/",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Reap"]], "paclet:ref/Reap"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a3f6db73-3248-43cf-9eac-830c2c8b2570"],
 " collect the crossings:"
}], "Text",ExpressionUUID->"919f3af5-600c-4f75-b44c-5f499fb6db9e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sol", ",", " ", "points"}], "}"}], " ", "=", " ", 
   RowBox[{"Reap", " ", "@", " ", 
    RowBox[{"QuantumEvolve", "[", 
     RowBox[{"rabiDrive", ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "0", ",", " ", "5"}], "}"}], ",", "\n", "    ", 
      
      RowBox[{"\"\<AdditionalEquations\>\"", " ", "->", " ", 
       RowBox[{"WhenEvent", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"Indexed", "[", 
             RowBox[{
              RowBox[{"\[FormalS]", "[", "t", "]"}], ",", " ", "1"}], "]"}], 
            "]"}], " ", "^", " ", "2"}], " ", "==", " ", "0.5"}], ",", " ", 
         RowBox[{"Sow", "[", "t", "]"}]}], "]"}]}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{"Length", "[", 
  RowBox[{"First", "[", "points", "]"}], "]"}]}], "Input",
 CellLabel->
  "In[53]:= ",ExpressionUUID->"850a266e-5f97-42cb-849d-b30cf3f35179"],

Cell[BoxData["20"], "Output",
 CellLabel->
  "Out[53]= ",ExpressionUUID->"79f46d3e-2ebb-4973-a9bf-93771654904c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Round", "[", 
  RowBox[{
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"First", "[", "points", "]"}], ",", " ", "4"}], "]"}], ",", " ", 
   "0.0001"}], "]"}]], "Input",
 CellLabel->
  "In[54]:= ",ExpressionUUID->"f738a340-3068-46fb-b6b9-0d6f9b9b2d32"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.22870000000000001`", ",", "0.4156`", ",", "0.5747`", ",", 
   "0.7573000000000001`"}], "}"}]], "Output",
 CellLabel->
  "Out[54]= ",ExpressionUUID->"a9641395-52ea-4805-a9b7-dd0159fef935"]
}, Open  ]],

Cell["\<\
The crossings really are crossings - evaluating the returned solution at them \
gives one half back:\
\>", "Text",ExpressionUUID->"ed64bbe0-1e70-489e-9fb7-b71e041cb21d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"sol", "[", "#", "]"}], "[", "\"\<Probability\>\"", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"First", "[", "points", "]"}]}], ")"}], " ", "-", " ", "0.5"}], 
   "]"}], "]"}]], "Input",
 CellLabel->
  "In[55]:= ",ExpressionUUID->"f7532a9f-4b30-42db-8697-7e9755c8e176"],

Cell[BoxData["1.783993921589122`*^-6"], "Output",
 CellLabel->
  "Out[55]= ",ExpressionUUID->"5d978d41-64c8-4c8c-8291-c4e4dd80fd01"]
}, Open  ]],

Cell["\<\
Shading the plot between them marks out the intervals where the qubit is \
mostly excited:\
\>", "Text",ExpressionUUID->"f5d9dea1-74c3-4a1d-aa97-392a831fc412"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sol", "[", "t", "]"}], "[", "\"\<Probability\>\"", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "2"}], "}"}], ",", " ", 
   RowBox[{"Mesh", " ", "->", " ", 
    RowBox[{"First", "[", "points", "]"}]}], ",", "\n", "    ", 
   RowBox[{"MeshShading", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Green", ",", " ", "Orange"}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[56]:= ",ExpressionUUID->"25fb4295-724f-42d6-b5cf-1b407710b663"],

