Cell[TextData[{
 "The rates can equally be folded into the operators as ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["i", "TI"]]], 
   SubscriptBox[
    StyleBox["L", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51632b5f-405a-4f29-aa4e-58a4af851339"],
 ", in which case the jump operators are given as a plain list and the result \
is identical:"
}], "Text",ExpressionUUID->"b4a6ae11-4262-4f17-a644-ceefe3a85e92"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]t2", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{"H", ",", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", "\[Gamma]s", "]"}], " ", "Ls"}], ",", " ", 
     "\[Rho]0", ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{
      RowBox[{"\[Rho]t2", "[", "1.", "]"}], "[", "\"\<DensityMatrix\>\"", 
      "]"}], "]"}], " ", "-", " ", 
    RowBox[{"Normal", "[", 
     RowBox[{
      RowBox[{"\[Rho]t", "[", "1.", "]"}], "[", "\"\<DensityMatrix\>\"", 
      "]"}], "]"}]}], "]"}], "]"}]}], "Input",
 CellLabel->
  "In[34]:= ",ExpressionUUID->"3542c84c-9161-4a1a-be96-4f1859f0b187"],

Cell[BoxData["0.`"], "Output",
 CellLabel->
  "Out[34]= ",ExpressionUUID->"43816c9c-7efa-4e70-9ac1-ec74d5dc192f"]
}, Open  ]],

