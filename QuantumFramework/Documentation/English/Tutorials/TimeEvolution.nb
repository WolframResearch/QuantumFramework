Cell["Exact Solutions", "Section",ExpressionUUID->"01d6fb57-f638-4f1d-b856-a3933d3e767b"],

Cell["\<\
Passing a bare symbol instead of an interval solves the equation symbolically \
rather than numerically:\
\>", "Text",ExpressionUUID->"d330472f-e496-4da5-9c3d-f0d9a09e853e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"exact", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", "\"\<PauliX\>\"", "]"}], ",", " ", 
     RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", "t"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{"Normal", "[", 
