Cell[TextData[{
 "The Bloch vector traces the slow Rabi nutation underneath the fast Larmor \
precession. Over the interval ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]", "/", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["p", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6ebdecc-9e5a-4f00-af13-c7774a39cf29"],
 " it makes one full circuit from the north pole and back:"
}], "Text",ExpressionUUID->"122172c3-039e-4048-8997-b6bce25598a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Re", "[", 
     RowBox[{
      RowBox[{"rabi", "[", "t", "]"}], "[", "\"\<BlochVector\>\"", "]"}], 
     "]"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "tf"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "    ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Subscript", "[", 
       RowBox[{"r", ",", " ", "x"}], "]"}], ",", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"r", ",", " ", "y"}], "]"}], ",", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"r", ",", " ", "z"}], "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"cd7cdea3-d7c6-40ac-813d-6f623d3c39f3"],

