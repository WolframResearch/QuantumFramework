Cell[TextData[{
 "The correlation between the two channels is the off-diagonal ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "12"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69ccda16-2eb7-4e10-823a-f779e053cd66"],
 "; the matrix is positive semidefinite as long as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "\[GreaterEqual]", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "12"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d56bce5-876b-4f16-a398-bf7cc710200b"],
 ":"
}], "Text",ExpressionUUID->"7c44c2e2-30b6-498f-8702-572a929ec9ea"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Gamma]d", " ", "=", " ", "0.5"}], ";", " ", 
  RowBox[{"\[Gamma]12", " ", "=", " ", "0.45"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Beta]", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Gamma]d", ",", " ", "\[Gamma]12"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Gamma]12", ",", " ", "\[Gamma]d"}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"\[ScriptCapitalL]k", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Liouvillian\>\"", "[", 
     RowBox[{"Hk", ",", " ", "jumpOps", ",", " ", "\[Beta]"}], "]"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{"Dimensions", "[", 
  RowBox[{"\[ScriptCapitalL]k", "[", "\"\<Matrix\>\"", "]"}], "]"}]}], "Input",\

 CellLabel->
  "In[47]:= ",ExpressionUUID->"7c5639cc-a018-4654-81a0-8a4703461a60"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"16", ",", "16"}], "}"}]], "Output",
 CellLabel->
  "Out[47]= ",ExpressionUUID->"b5447842-72cf-4298-8194-c8d22a349425"]
}, Open  ]],

Cell["\<\
Evolve three initial states with one excitation between them - a product \
state, the singlet, and the triplet. When the Hamiltonian is already a \
superoperator, the initial state comes directly after it:\
\>", "Text",ExpressionUUID->"447744e7-6898-486c-8b4f-eb32c74f4bb2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"states", " ", "=", " ", 
   RowBox[{"QuantumState", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<01\>\"", ",", " ", "\"\<PsiMinus\>\"", ",", 
      " ", "\"\<PsiPlus\>\""}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evolved", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{"I", " ", "\[ScriptCapitalL]k"}], ",", " ", "#", ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], " ", 
     "&"}], " ", "/@", " ", "states"}]}], ";"}]}], "Input",
 CellLabel->
  "In[48]:= ",ExpressionUUID->"b55fd23e-b187-4ee1-a772-353309021749"],

Cell["\<\
Count the excitations left at each time with the total-number operator:\
\>", "Text",ExpressionUUID->"8a60fcb3-703c-4eea-b74c-d851205ffff0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"totalExcitation", " ", "=", " ", 
   RowBox[{"Total", " ", "@", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"mat", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}], ",", " ", 
      RowBox[{"Array", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"mat", ",", " ", 
           RowBox[{"{", "#", "}"}]}], "]"}], " ", "&"}], ",", " ", "2"}], 
       "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"excitations", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{
            RowBox[{"#", "[", "t", "]"}], "[", "\"\<DensityMatrix\>\"", "]"}],
            "]"}], " ", ".", " ", 
          RowBox[{"Normal", "[", 
           RowBox[{"totalExcitation", "[", "\"\<Matrix\>\"", "]"}], "]"}]}], 
         "]"}], "]"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "5", ",", " ", "0.05"}], 
        "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", "evolved"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[49]:= ",ExpressionUUID->"d81c80c8-7fbd-4687-9984-88fb84672f5c"],

Cell[TextData[{
 "All three start with one excitation and all three decay, but at three \
different rates. The correlation splits the symmetric and antisymmetric \
combinations apart: the singlet is subradiant, decaying at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "-", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "12"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0263146-2343-4eba-9dd8-ec1e2ac60d23"],
 ", and the triplet is superradiant, decaying at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "+", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "12"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7a200be-a78e-48fc-aa32-0e99e852f613"],
 " - here a factor of nineteen between them:"
}], "Text",ExpressionUUID->"195c1408-5ee9-48f8-a592-638665e95117"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"excitations", ",", " ", 
   RowBox[{"DataRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "5"}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<|01\[RightAngleBracket]\>\"", ",", " ", "\"\<singlet\>\"", ",",
       " ", "\"\<triplet\>\""}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", " ", "\"\<excitations\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[50]:= ",ExpressionUUID->"82126447-8314-4932-a914-946d01c8d472"],

