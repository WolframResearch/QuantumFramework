Cell["Time-Dependent Hamiltonians", "Section",ExpressionUUID->"25fa5ccd-ec9c-499e-9d64-0a8b42b8acd8"],

Cell[TextData[{
 "Nothing requires the Hamiltonian to be constant. A symbol in it that \
matches the evolution parameter simply makes the generator time dependent. \
This is a spin with splitting ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2759b02-fa55-4ffa-af6d-9f31e31fd4c2"],
 " driven transversally at the same frequency - a resonant drive:"
}], "Text",ExpressionUUID->"b0c25c4d-dd6a-466c-80cd-12b3085df176"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Omega]0", " ", "=", " ", 
   RowBox[{"2", " ", "Pi"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Omega]p", " ", "=", " ", 
   RowBox[{"Pi", "/", "10"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tf", " ", "=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Pi", "/", "\[Omega]p"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"driven", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Omega]0", " ", 
     RowBox[{"QuantumOperator", "[", "\"\<JZ\>\"", "]"}]}], " ", "+", " ", 
    RowBox[{"2", " ", "\[Omega]p", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"\[Omega]0", " ", "t"}], "]"}], " ", 
     RowBox[{"QuantumOperator", "[", "\"\<JX\>\"", "]"}]}]}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"7457cac2-23aa-4bc0-a73e-a0eac72d6696"],

Cell["\<\
With no initial state given, the register state is used, so the Hamiltonian \
and the time interval are the whole call:\
\>", "Text",ExpressionUUID->"06014a6a-7045-4d5d-8fe5-e08b4939915d"],

