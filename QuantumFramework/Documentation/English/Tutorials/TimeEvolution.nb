Cell["Open Systems: the Lindblad Equation", "Section",ExpressionUUID->"65f52289-0d04-452b-86e9-9319ceb7c6db"],

Cell["\<\
Jump operators turn the Schrodinger equation into the Lindblad master \
equation,\
\>", "Text",ExpressionUUID->"f0ee1ad1-56c0-4bca-9cf6-3dd3b8090747"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", 
     StyleBox["t", "TI"]], 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["H", "TI"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["i", "TI"],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["i", "TI"]], "(", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["i", "TI"]], 
      StyleBox["\[Rho]", "TI"], 
      SubsuperscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["i", "TI"], "\[Dagger]"], "-", 
      FractionBox["1", "2"], "{", 
      SubsuperscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["i", "TI"], "\[Dagger]"], 
      SubscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["i", "TI"]]}], ",", 
     RowBox[{
      StyleBox["\[Rho]", "TI"], "}"}]}], ")"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"78e4992a-6f98-453a-\
9e3b-c66f1c0e0631"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c330c1cb-521c-4647-8c74-79bd788d730c"],
 " the density matrix, ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["L", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d07b4f6c-c75b-43ed-b595-25c3e268a779"],
 " the jump operators and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e835bd76-7438-4838-a895-7d2bbf7d373f"],
 " their rates. Passing them as ",
 Cell[BoxData[
  RowBox[{"Ls", " ", "->", " ", "rates"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b677a23e-5c2d-4427-b7c3-64984ea9380a"],
 " is enough to switch equations. Here a ",
 Cell[BoxData["PauliZ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44973f16-b0b5-4729-a2b8-386cc612a4fc"],
 " Hamiltonian with ",
 Cell[BoxData["PauliX"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d04e0376-7532-4e99-995b-f841f68be4ed"],
 " dephasing at rate 0.6:"
}], "Text",ExpressionUUID->"01fcf8cb-568e-4515-84a9-a842ea03a436"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"noisy", " ", "=", " ", 
  RowBox[{"QuantumEvolve", "[", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", "\"\<PauliZ\>\"", "]"}], ",", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"QuantumOperator", "[", "\"\<PauliX\>\"", "]"}], "}"}], " ", "->",
      " ", 
     RowBox[{"{", "0.6", "}"}]}], ",", "\n", "    ", 
    RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"1ee3bcf2-bf6a-4362-a6f1-887865992ad4"],

