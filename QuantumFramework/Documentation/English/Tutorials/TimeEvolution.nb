Cell["Relaxing to a Thermal State", "Section",ExpressionUUID->"5740a224-8fe0-4597-9665-dc6910b24221"],

Cell[TextData[{
 "Dephasing drives a qubit to the maximally mixed state because it has no \
preferred direction. Amplitude damping does have one, and at finite \
temperature the two directions compete. With a mean occupation ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "584754d9-f7c9-4e7d-8d0b-2117a2b8f11c"],
 " of the bath, decay happens at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8ba9876-7488-401e-8279-508d2aa383d2"],
 " and absorption at rate ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\[Gamma]", "n"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "670dd39f-fd64-41c0-b418-50b34cdd1e6f"],
 ":"
}], "Text",ExpressionUUID->"573e5079-703f-43bc-bf93-813f0e89199f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalOmega]", " ", "=", " ", "50"}], ";", " ", 
  RowBox[{"\[Gamma]", " ", "=", " ", "1"}], ";", " ", 
  RowBox[{"n", " ", "=", " ", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"H", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
    RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]m", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ls", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"\[Sigma]m", ",", " ", 
     RowBox[{"\[Sigma]m", "[", "\"\<Dagger\>\"", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Gamma]s", " ", "=", " ", 
   RowBox[{"\[Gamma]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", " ", "+", " ", "1"}], ",", " ", "n"}], "}"}]}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"b3b12e0d-f45e-4240-a550-1c6f38780be9"],

Cell["Starting from a pure state tilted off the axis:", "Text",ExpressionUUID->"d53ccb03-dbc4-4230-a940-04f49729f804"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Rho]0", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"Pi", "/", "8"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"Pi", "/", "4"}]}], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"Pi", "/", "8"}], "]"}]}]}], "}"}], "]"}]}]], "Input",
 CellLabel->
  "In[29]:= ",ExpressionUUID->"18c96235-f9d2-49fb-86a9-1c0b6cea70fd"],

