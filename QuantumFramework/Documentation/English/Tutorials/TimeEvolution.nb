Cell["The Equations Themselves", "Section",ExpressionUUID->"4579406b-181e-43b3-9886-e8f292e21b35"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<ReturnEquations\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18363702-dde5-40b4-98b2-fd0d092a8ef1"],
 " stops short of solving and hands back the system instead, in exactly the \
form the solver would have been called with - equations, dependent variable, \
and time specification:"
}], "Text",ExpressionUUID->"9ca34ca4-2711-4629-ac69-b28ae2aa4424"],

