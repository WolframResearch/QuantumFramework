Cell[TextData[{
 "Reaching for this is worthwhile when the system needs to be handed to a \
solver directly - to couple it to equations of a different kind, to pick a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Method"]], "paclet:ref/Method"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "03054176-cfba-4989-b0b1-2097efac7104"],
 " by hand, or simply to see what is being integrated."
}], "Text",ExpressionUUID->"9cb5b458-6a6c-4827-b90f-0825df323dda"],

Cell[TextData[{
 "The triple is in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NDSolveValue"]], "paclet:ref/NDSolveValue"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b3105c41-89d1-42c3-be3b-fe6a18de6604"],
 "'s argument order, but two things in it are for the framework's benefit \
rather than the solver's: the matrices are sparse, which ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NDSolveValue"]], "paclet:ref/NDSolveValue"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3fc59cb5-acb1-4af5-963f-77ac597b48d4"],
 " will not accept as an initial condition, and the dependent variable is a \
formal symbol. Make both ordinary and it runs:"
}], "Text",ExpressionUUID->"3b48e3de-42c1-4db0-968d-0d3d20aad624"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"solved", " ", "=", " ", 
  RowBox[{"NDSolveValue", " ", "@@", " ", 
   RowBox[{"(", 
    RowBox[{"eqs", " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sa_SparseArray", " ", ":>", " ", 
        RowBox[{"Normal", "[", "sa", "]"}]}], ",", " ", 
       RowBox[{"\[FormalS]", " ", "->", " ", "s"}]}], "}"}]}], 
    ")"}]}]}]], "Input",
 CellLabel->
  "In[59]:= ",ExpressionUUID->"c8bfc7cd-13c1-4347-a3ab-6c951b7f5d54"],

