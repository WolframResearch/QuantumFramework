Cell[TextData[{
 "Halfway through, the spin has been driven to the south pole - a ",
 Cell[BoxData["\[Pi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "baef38ee-9d0c-49e8-8bd4-15936d8d90a4"],
 " pulse:"
}], "Text",ExpressionUUID->"6d9e6e4d-9d6e-499b-9f33-62cd13905c0a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Round", "[", 
  RowBox[{
   RowBox[{"Chop", "[", 
    RowBox[{"Re", "[", 
     RowBox[{
      RowBox[{"rabi", "[", 
       RowBox[{"tf", "/", "2"}], "]"}], "[", "\"\<BlochVector\>\"", "]"}], 
     "]"}], "]"}], ",", " ", "0.0001"}], "]"}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"f1be0e88-938b-4b56-bb3c-4fb8e36aad1f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "0.025`"}], ",", 
   RowBox[{"-", "0.0002`"}], ",", 
   RowBox[{"-", "0.9997`"}]}], "}"}]], "Output",
 CellLabel->
  "Out[20]= ",ExpressionUUID->"d2bf8e19-1514-49b4-a00f-332c36fd690a"]
}, Open  ]],

Cell["\<\
The evolution is unitary throughout, so the state stays pure and the Bloch \
vector stays on the sphere:\
\>", "Text",ExpressionUUID->"ba56f1f2-cc1b-4aeb-a64a-58abcea65c34"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"rabi", "[", 
   RowBox[{"tf", "/", "2"}], "]"}], "[", "\"\<Purity\>\"", "]"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"49bec309-a699-49c2-87a2-c1f297424e4c"],

Cell[BoxData["1"], "Output",
 CellLabel->
  "Out[21]= ",ExpressionUUID->"19155aa7-d949-48f8-b3ea-a3e8ac6bff3f"]
}, Open  ]],

Cell["Observables and Trajectories", "Section",ExpressionUUID->"372fb5c2-2722-401c-8dc2-22da45c7f6f8"],

Cell["\<\
An evolved state answers every ordinary state property once a time is given, \
so an observable is measured as it would be on any state:\
\>", "Text",ExpressionUUID->"399e5fee-f183-4e5a-a3c1-6c63a35ef853"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumMeasurement", "[", 
   RowBox[{
    RowBox[{"QuantumMeasurementOperator", "[", 
     RowBox[{"QuantumOperator", "[", "\"\<PauliZ\>\"", "]"}], "]"}], " ", "@",
     " ", 
    RowBox[{"psi", "[", "1.", "]"}]}], "]"}], "[", "\"\<Mean\>\"", 
  "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"769c3613-b418-4dfa-8226-94d25da99809"],

Cell[BoxData[
 RowBox[{"-", "0.4161467845713413`"}]], "Output",
 CellLabel->
  "Out[22]= ",ExpressionUUID->"d66209e8-9ff0-40e4-9861-2445b507790d"]
}, Open  ]],

Cell[TextData[{
 "For a qubit the Bloch vector gives the motion directly. Under ",
 Cell[BoxData["PauliX"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8e87f56-d60d-4c32-85ba-aab6109a6cf1"],
 " the state precesses about the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d14b3cd5-c2dc-471f-afd8-4a991cec9446"],
 " axis, so the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd4fa3a6-f3a6-43e9-9e13-41de664624b2"],
 " component stays zero:"
}], "Text",ExpressionUUID->"1893ef95-8944-4aa4-8f53-91bc99a7d505"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{
   RowBox[{"psi", "[", "1.", "]"}], "[", "\"\<BlochCartesianCoordinates\>\"", 
   "]"}], "]"}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"0dd6c964-1478-4693-aa59-1bbf38e49168"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"-", "0.9092974506127978`"}], ",", 
   RowBox[{"-", "0.4161467845713415`"}]}], "}"}]], "Output",
 CellLabel->
  "Out[23]= ",ExpressionUUID->"d2852497-5469-4210-84b8-1cf124e5aaed"]
}, Open  ]],

Cell["\<\
Drawing that as a curve on the Bloch sphere shows the precession as the great \
circle it is:\
\>", "Text",ExpressionUUID->"517a78b2-4d50-4374-bad1-e8b629dc654b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumState", "[", "\"\<UniformMixture\>\"", "]"}], 
    "[", "\"\<BlochPlot\>\"", "]"}], ",", "\n", "    ", 
