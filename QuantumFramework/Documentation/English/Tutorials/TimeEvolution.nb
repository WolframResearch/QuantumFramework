Cell["\<\
Because it is the map and not a trajectory, it can be applied to any state \
without solving again:\
\>", "Text",ExpressionUUID->"cd1976ad-d852-4533-8011-b96c40c8934b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]start", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"Pi", "/", "8"}], "]"}], ",", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"Pi", "/", "8"}], "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"U", "[", "2.", "]"}], "[", "\[Rho]start", "]"}], 
  "[", "\"\<ProbabilitiesList\>\"", "]"}]}], "Input",
 CellLabel->
  "In[38]:= ",ExpressionUUID->"12e4c131-b039-40d0-a3ba-60230a1bf240"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.9196283974343614`", ",", "0.08037160256563854`"}], 
  "}"}]], "Output",
 CellLabel->
  "Out[38]= ",ExpressionUUID->"7873e60c-da4a-4b33-9912-cc8cfb33a6c7"]
}, Open  ]],

Cell["\<\
Solving the same problem directly as a Lindblad equation gives the same \
answer, to the solver's tolerance:\
\>", "Text",ExpressionUUID->"f0f65615-1522-457c-a0fd-274b371c051d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"{", "\[Sigma]m", "}"}], " ", "->", " ", 
      RowBox[{"{", "0.3", "}"}]}], ",", " ", "\[Rho]start", ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], "[", "2.", 
   "]"}], "[", "\"\<ProbabilitiesList\>\"", "]"}]], "Input",
 CellLabel->
  "In[39]:= ",ExpressionUUID->"84d8c84c-1440-46c3-b0ba-7c94c1074320"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.919628396623777`", ",", "0.08037160337622301`"}], 
  "}"}]], "Output",
 CellLabel->
  "Out[39]= ",ExpressionUUID->"dcc698b6-32dc-4c5e-aedd-4e8dd349bd10"]
}, Open  ]],

Cell["\<\
The propagator also exists for closed systems, where it is the familiar \
unitary. Solved exactly it is a closed form:\
\>", "Text",ExpressionUUID->"161f833e-9221-478a-8fb8-d18c08e49fda"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{"QuantumEvolve", "[", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", "\"\<PauliX\>\"", "]"}], ",", " ", 
      "None", ",", " ", "t"}], "]"}], "[", "\"\<Matrix\>\"", "]"}], "]"}], 
  "]"}]], "Input",
 CellLabel->
  "In[40]:= ",ExpressionUUID->"6c847b51-04c1-408a-ba98-9c2c7b32b880"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", 
      RowBox[{"Sin", "[", "t", "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", 
      RowBox[{"Sin", "[", "t", "]"}]}], ",", 
     RowBox[{"Cos", "[", "t", "]"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[40]= ",ExpressionUUID->"81785005-cfa5-4143-b7f9-92baef5240e2"]
}, Open  ]],

Cell["The Heisenberg Picture", "Section",ExpressionUUID->"07de9fe8-7c90-45cb-a0ca-cf006bec4604"],

Cell[TextData[{
 "The same superoperator run backwards evolves ",
 StyleBox["observables", "TI"],
 " instead of states. Taking its adjoint and applying it to an operator - \
passed through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumState"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumState", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "347a0da1-a2cf-4b7b-a6e7-8fe91964e73f"],
 " as a matrix state, then read back as an operator - gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bc3894e-55e8-4e29-8040-1f03374a4f64"],
 ":"
}], "Text",ExpressionUUID->"4d724781-ce47-41ac-a0c1-1b3cc914f51b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A0", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"At", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"U", "[", "\"\<Dagger\>\"", "]"}], "[", 
     RowBox[{"A0", "[", "\"\<MatrixQuantumState\>\"", "]"}], "]"}], 
    "[", "\"\<Operator\>\"", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[41]:= ",ExpressionUUID->"a76a3ca0-9574-4a6a-9410-a882bc5633e5"],

Cell[TextData[{
 "The two pictures are two ways of writing the same number, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["A", "TI"], "0"], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["A", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], "0"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5c1e5bf-a9ea-42b9-a7b4-671f502c4ae9"],
 ". In the Schrodinger picture the state moves:"
}], "Text",ExpressionUUID->"1497f54f-282c-4e0a-92da-cb545f004c63"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Re", "[", 
  RowBox[{"Tr", "[", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"A0", "[", "\"\<Matrix\>\"", "]"}], "]"}], " ", ".", " ", 
    RowBox[{"Normal", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"U", "[", "2.", "]"}], "[", "\[Rho]start", "]"}], 
      "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[42]:= ",ExpressionUUID->"deaac8d0-2145-4385-9c4e-aa7cb3c7a8d2"],

Cell[BoxData["0.8392567948687228`"], "Output",
 CellLabel->
  "Out[42]= ",ExpressionUUID->"426b627b-8b8c-4923-8578-6748a047054d"]
}, Open  ]],

Cell["\<\
In the Heisenberg picture the observable moves and the state does not:\
\>", "Text",ExpressionUUID->"a5f89a1b-25d9-4157-926f-df5acfa71ccd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Re", "[", 
  RowBox[{"Tr", "[", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{
      RowBox[{"At", "[", "2.", "]"}], "[", "\"\<Matrix\>\"", "]"}], "]"}], 
    " ", ".", " ", 
    RowBox[{"Normal", "[", 
     RowBox[{"\[Rho]start", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], 
   "]"}], "]"}]], "Input",
 CellLabel->
  "In[43]:= ",ExpressionUUID->"d3c0de16-33ef-4de2-ad8b-e64829908ca3"],

Cell[BoxData["0.839256794868723`"], "Output",
 CellLabel->
  "Out[43]= ",ExpressionUUID->"f46ecb7c-5c8f-4384-8868-a9e849f3ff56"]
}, Open  ]],

Cell["\<\
They agree to machine precision across the interval, since both read the same \
solved propagator:\
\>", "Text",ExpressionUUID->"a764aa60-ce59-4c53-af96-200b4249cd38"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"Normal", "[", 
         RowBox[{"A0", "[", "\"\<Matrix\>\"", "]"}], "]"}], " ", ".", " ", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"U", "[", "t", "]"}], "[", "\[Rho]start", "]"}], 
          "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], "]"}], " ", "-", "\n",
       "    ", 
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{"At", "[", "t", "]"}], "[", "\"\<Matrix\>\"", "]"}], "]"}], 
        " ", ".", " ", 
        RowBox[{"Normal", "[", 
         RowBox[{"\[Rho]start", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], 
       "]"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "0", ",", " ", "5", ",", " ", "0.5"}], "}"}]}], 
   "]"}], "]"}]], "Input",
 CellLabel->
  "In[44]:= ",ExpressionUUID->"a5ada997-43fe-4200-a534-9fb0646a66ed"],

Cell[BoxData["1.1102230246251565`*^-16"], "Output",
 CellLabel->
  "Out[44]= ",ExpressionUUID->"27e3fb60-c2fa-476e-bec3-8d0322cf9dfb"]
}, Open  ]],

Cell["The Kossakowski Equation", "Section",ExpressionUUID->"b03bb2b8-d26f-4744-b579-af753b6d9f58"],

Cell["\<\
The Lindblad equation assumes the jump operators are uncorrelated. Dropping \
that assumption gives the Kossakowski equation,\
\>", "Text",ExpressionUUID->"5cf558b6-eeb0-4f6b-859a-f68df619b21e"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", 
     StyleBox["t", "TI"]], 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["H", "TI"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox[
      RowBox[{"i", "j"}], "TI"],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["\[Beta]", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], "(", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["i", "TI"]], 
      StyleBox["\[Rho]", "TI"], 
      SubsuperscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["j", "TI"], "\[Dagger]"], "-", 
      FractionBox["1", "2"], "{", 
      SubsuperscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["j", "TI"], "\[Dagger]"], 
      SubscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["i", "TI"]]}], ",", 
     RowBox[{
      StyleBox["\[Rho]", "TI"], "}"}]}], ")"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"675d6db5-c507-467e-\
89c9-746e225ebec4"],

Cell[TextData[{
 "where the rates become a positive-semidefinite matrix ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Beta]", "TI"], 
   StyleBox[
    RowBox[{"i", "j"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dc4e65c-fa97-4b50-a49d-a9263e48f89a"],
 " whose off-diagonal entries encode correlations between channels. A \
diagonal ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e06876ca-223d-486d-b1f2-3ccb109daf5f"],
 " recovers the Lindblad equation. Building the Liouvillian with a matrix in \
place of a list of rates is all it takes."
}], "Text",ExpressionUUID->"4fec6dc2-3ec9-4501-bc19-21e583a80130"],

Cell["\<\
Two atoms decaying into a shared field is the standard example. The \
Hamiltonian is just their bare energies:\
\>", "Text",ExpressionUUID->"0a2890a2-6932-47a7-bd0b-d66a316ddf35"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Omega]1", " ", "=", " ", "0.9"}], ";", " ", 
  RowBox[{"\[Omega]2", " ", "=", " ", "0.7"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Hk", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Omega]1", "/", "2"}], " ", "\"\<ZI\>\""}], " ", "+", " ", 
     RowBox[{
      RowBox[{"\[Omega]2", "/", "2"}], " ", "\"\<IZ\>\""}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[45]:= ",ExpressionUUID->"6b426d81-35c4-4143-87a2-b6fa2beaaf34"],

Cell["Each atom decays through its own lowering operator:", "Text",ExpressionUUID->"9ce58350-e701-4c35-8906-0662a046f87d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"jumpOps", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumTensorProduct", "[", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", "#", "]"}], ",", " ", 
      RowBox[{"QuantumOperator", "[", "#2", "]"}]}], "]"}], " ", "&"}], " ", "@@@",
    " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<-\>\"", ",", " ", "\"\<I\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<I\>\"", ",", " ", "\"\<-\>\""}], "}"}]}], 
    "}"}]}]}]], "Input",
 CellLabel->
  "In[46]:= ",ExpressionUUID->"24da6c76-3d4d-4fdf-9313-9156b400702a"],

