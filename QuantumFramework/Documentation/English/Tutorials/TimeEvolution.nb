       "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", 
       RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"8634c041-2561-41c8-b910-5abfeac3e8d0"],

