  FontSize->0.9 Inherited,ExpressionUUID->
  "71e841ac-bf76-4c5d-9e6a-051a7a39ea1c"],
 ":"
}], "Text",ExpressionUUID->"0fa8c4aa-a9b9-4c82-9bb9-e9580b3e179c"],

