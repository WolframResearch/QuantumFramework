Cell["What the Solution Actually Is", "Section",ExpressionUUID->"84719366-7c2c-480d-9a89-6b8fc2dc98d8"],

Cell[TextData[{
 "A numerically evolved state is not a table of samples and it is not a \
symbolic expression. Its amplitudes ",
 StyleBox["are", "TI"],
 " the solver's own ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InterpolatingFunction"]], "paclet:ref/InterpolatingFunction"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8a24b6b2-3a18-439d-96e9-cc5309c389e0"],
 ", held as the state's array and applied to the time parameter:"
}], "Text",ExpressionUUID->"8788ba87-ce22-4578-8070-e66c58681cbc"],

