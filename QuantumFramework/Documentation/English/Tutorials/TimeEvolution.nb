Cell[TextData[{
 "What comes back is the same solution ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumEvolve"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumEvolve", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "760c9a2d-a4bb-411e-b129-59dbe84eb7a1"],
 " would have handed over wrapped in a state - ",
 Cell[BoxData[
  TemplateBox[{"00"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d09fc757-c262-4948-ad1c-c5cdb5f76a06"],
 " rotating into ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da685101-097c-4ed5-9be5-314b6364179f"],
 " as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a06dc366-bcc4-4280-88a2-22ccca056c64"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed44b316-d2e3-4535-bf1a-79928067e8cd"],
 ":"
}], "Text",ExpressionUUID->"3b79c2ab-c1f1-4ff2-842a-c4456ed489b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"solved", "[", "1.", "]"}], "]"}]], "Input",
 CellLabel->
  "In[60]:= ",ExpressionUUID->"14c41996-78f2-4cc2-a360-ac0c1958b42f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.5403023235460563`", ",", "0", ",", "0", ",", 
   RowBox[{"0.`", "\[VeryThinSpace]", "-", 
    RowBox[{"0.8414709538478929`", " ", "\[ImaginaryI]"}]}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[60]= ",ExpressionUUID->"988a642e-2c56-4f06-a2ad-7bab19ba5b2c"]
}, Open  ]],

Cell["Details", "Section",ExpressionUUID->"b3bf504d-c5fb-4fc2-be79-2ad2d487b100"],

Cell[TextData[{
 "The time argument is either a symbol, which solves the equation exactly \
with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DSolve"]], "paclet:ref/DSolve"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d303da50-c4e9-4b08-8d2c-7a8d5b2c4f36"],
 ", or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"t", ",", " ", "t0", ",", " ", "t1"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea4abd90-13ae-4942-bfad-ed7d4b24879d"],
 ", which solves it numerically with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NDSolve"]], "paclet:ref/NDSolve"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6f53f358-1965-4e57-b103-f47bdec2020d"],
 ". Options not recognized by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumEvolve"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumEvolve", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "26813bfb-bb67-4c10-8aa2-d9681f447d0f"],
 " are passed through to whichever solver runs, so ",
 Cell[BoxData["AccuracyGoal"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0d5ffca-d052-4d4b-b26c-34916eb54790"],
 ", ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69bdd480-cf59-4261-8bc1-717d91bf821e"],
 ", ",
 Cell[BoxData["MaxSteps"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "799bb28c-bea0-4776-a8a6-965e40109093"],
 " and the rest all work."
}], "Item",ExpressionUUID->"a6f52c62-280b-4d5b-91af-376d9fafbcc4"],

Cell[TextData[{
 "The initial condition selects the equation. A state gives the Schrodinger \
or Lindblad equation; an operator gives the Heisenberg equation; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["None"]], "paclet:ref/None"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1f923cc4-a731-45d4-a468-0a6ceaad356e"],
 " gives the propagator. Omitting it uses the register state ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"0", "\[Ellipsis]", "0"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a91049d-ab9d-475e-8db9-9c788cefdcba"],
 ", and omitting the time along with it uses the formal symbol ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba5eeeea-79bd-4378-95dd-9237dc509553"],
 "."
}], "Item",ExpressionUUID->"0e0ec6ce-df39-4378-95f4-9c9de5c6e618"],

Cell[TextData[{
 "Jump operators are given either as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"L1", ",", " ", "L2", ",", " ", "..."}], "}"}], " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\[Gamma]1", ",", " ", "\[Gamma]2", ",", " ", "..."}], "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9921eb7c-8478-4f49-aadd-df09196ec67b"],
 " or as a plain list with the rates folded in as ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["i", "TI"]]], 
   SubscriptBox[
    StyleBox["L", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a85fe209-a3a6-4b62-bb7e-1d83b2e1d957"],
 ". Correlated channels need the Kossakowski form, which is reached by \
building ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Liouvillian\>\"", "[", 
     RowBox[{"H", ",", " ", "Ls", ",", " ", "\[Beta]"}], "]"}], "]"}], 
   "InlineCode"]], "InlineCode",ExpressionUUID->
  "f064a5c5-f5f6-46dd-9199-a006908d0a01"],
 " with a rate matrix and evolving ",
 Cell[BoxData[
  RowBox[{"I", " ", "\[ScriptCapitalL]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fac193cc-805c-407b-8119-c4f7363f0eb1"],
 "."
}], "Item",ExpressionUUID->"359b3d1d-5e27-4427-955d-6266f0a23cfd"],

Cell[TextData[{
 "With a Hamiltonian that is already a superoperator, the state argument \
comes directly after it: ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{"\[ScriptCapitalL]", ",", " ", "state", ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], 
   "InlineCode"]], "InlineCode",ExpressionUUID->
  "571bc2bc-d19e-4134-9c88-ccc22bd2897f"],
 "."
}], "Item",ExpressionUUID->"2ca5321c-337d-4dff-8a7e-98705244fe5f"],

Cell[TextData[{
 "The evolution parameter is recorded on the returned object, so ",
 Cell[BoxData[
  RowBox[{"state", "[", "\"\<Parameters\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09ae3965-4e1a-419b-96fb-e85e4476bc5f"],
 " names it and ",
 Cell[BoxData[
  RowBox[{"state", "[", "t", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8802b70-2ba8-43a2-94d1-ca6bd5ac3af3"],
 " supplies it."
}], "Item",ExpressionUUID->"d95ed923-2f26-4661-8e3c-a1eccfd02945"],

Cell[TextData[{
 "A numerically evolved state holds the solver's ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InterpolatingFunction"]], "paclet:ref/InterpolatingFunction"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "22664c87-6692-4e89-8d90-231e3109d770"],
 " as its amplitudes, so it answers questions about its shape without \
evaluating anything, and interpolation happens once a time is supplied. ",
 Cell[BoxData[
  RowBox[{"\"\<Expand\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9787323-a50a-4df0-8d69-23d39697ca19"],
 " instead stores one scalar interpolation per amplitude, each carrying its \
own copy of the solver's time grid."
}], "Item",ExpressionUUID->"821c3a12-e850-496b-a301-5a8127d8f4b0"],

Cell[TextData[{
 Cell[BoxData["\"\<MergeInterpolatingFunctions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cac29c59-8de0-42a9-ba84-18bb37b70883"],
 " controls what happens when the Hamiltonian itself contains interpolating \
functions of time. The default merges them into a single sparse \
interpolation, which is substantially faster than letting each enter the \
dynamical equation separately."
}], "Item",ExpressionUUID->"6e00bfe7-0edc-4963-8bcd-c2be2a6bfa74"],

Cell["Possible Issues", "Section",ExpressionUUID->"3f363ebc-a80a-4c44-ae23-00b4a3778bcb"],

Cell["\<\
Ask for amplitudes before supplying a time and the answer is a function of \
the parameter rather than numbers, which is rarely what is wanted from a \
numerical solve. Supply the time first:\
\>", "Text",ExpressionUUID->"24fc005a-f36b-4f3d-9303-61e60c5d0dac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"psi", "[", "0.5", "]"}], "[", "\"\<ProbabilitiesList\>\"", 
  "]"}]], "Input",
 CellLabel->
  "In[61]:= ",ExpressionUUID->"9cc1beb5-53de-4b3c-8f41-ce27b9be8759"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.7701511674960476`", ",", "0.2298488325039524`"}], 
  "}"}]], "Output",
 CellLabel->
  "Out[61]= ",ExpressionUUID->"b43fcb75-4386-442d-8d7b-b06d1dfe4eaa"]
}, Open  ]],

Cell[TextData[{
 "The numerical and exact routes agree to the solver's tolerance, not to \
machine precision, and the difference above is around the eighth decimal. \
Tighten it with the usual ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NDSolve"]], "paclet:ref/NDSolve"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6df84aec-3f59-42eb-a912-0c4ad43bf0f3"],
 " options."
}], "Text",ExpressionUUID->"a3ddbe13-febb-4138-83e8-1a46ac09c5fb"],

Cell[TextData[{
 "Defining a time-dependent Hamiltonian as a function of its time argument \
does not work the way it looks like it should. The operator's matrix is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SparseArray"]], "paclet:ref/SparseArray"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e10a89b-5a56-4faa-ba9e-69d06c3e1fe8"],
 ", and a pattern variable is not substituted into it, so the symbol in the \
stored expression is never replaced:"
}], "Text",ExpressionUUID->"ada849a6-8f52-4897-a2fb-0cfe244b2f5d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"badH", "[", "x_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], " ", 
    RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}]}], ";"}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{
   RowBox[{"badH", "[", "0.3", "]"}], "[", "\"\<Matrix\>\"", "]"}], 
  "]"}]}], "Input",
 CellLabel->
  "In[62]:= ",ExpressionUUID->"817d2808-b315-44c0-971f-d40475f896ba"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"Sin", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], ",", "0"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[62]= ",ExpressionUUID->"94cbe404-bf1a-4c8a-945c-f0f7ca490f36"]
}, Open  ]],

Cell[TextData[{
 "Write the Hamiltonian as a plain expression in the evolution parameter \
instead, and let ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumEvolve"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumEvolve", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "82a1f69f-6e2b-4575-83dc-ea2a80e5bc04"],
 " handle the substitution:"
}], "Text",ExpressionUUID->"60a42f8e-5528-46e5-acd3-47eb63e02a5c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Sin", "[", "t", "]"}], " ", 
     RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], ")"}], 
   "[", "\"\<Matrix\>\"", "]"}], "]"}]], "Input",
 CellLabel->
  "In[63]:= ",ExpressionUUID->"794584f9-85da-4392-842d-90583b285852"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"Sin", "[", "t", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", "t", "]"}], ",", "0"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[63]= ",ExpressionUUID->"6d1b0133-db4e-4448-ab9d-4354fa884c1b"]
}, Open  ]],

Cell["\<\
If the exact solver cannot find a closed form, the output is the unevaluated \
solver call it gave up on, along with a message. Here a Rabi problem with a \
general detuning, which has no elementary solution:\
\>", "Text",ExpressionUUID->"d61d3c69-5fb8-4aa2-9428-4745072349c4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumEvolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[Omega]", ",", " ", "0"}], "]"}], " ", 
     RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", "\n", 
    "    ", 
    RowBox[{"\[Gamma]r", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"\[Omega]", ",", " ", "p"}], "]"}], " ", "t"}], "]"}], " ", 
     RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}]}], ",", " ", "t"}], 
  "]"}]], "Input",
 CellLabel->
  "In[64]:= ",ExpressionUUID->"220ce6fe-e68f-4a04-970c-ef6e2c016dc1"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"QuantumEvolve", "::", "error"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{
  "Differential", " ", "Solver", " ", "failed", " ", "to", " ", "find", " ", 
   "a", " ", "solution"}]}]], "Message", \
"MSG",ExpressionUUID->"c18f78cf-b0a8-449b-a04a-f2da79687a61"],

Cell[BoxData[
 RowBox[{"DSolveValue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["\[FormalS]", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            FractionBox[
             RowBox[{"\[ImaginaryI]", " ", 
              SubscriptBox["\[Omega]", "0"]}], "2"]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", 
               SubscriptBox["\[Omega]", "p"]}]], " ", "\[Gamma]r"}], "-", 
            RowBox[{
             FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"\[ImaginaryI]", " ", "t", " ", 
               SubscriptBox["\[Omega]", "p"]}]], " ", "\[Gamma]r"}]}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", 
               SubscriptBox["\[Omega]", "p"]}]], " ", "\[Gamma]r"}], "-", 
            RowBox[{
             FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"\[ImaginaryI]", " ", "t", " ", 
               SubscriptBox["\[Omega]", "p"]}]], " ", "\[Gamma]r"}]}], ",", 
           FractionBox[
            RowBox[{"\[ImaginaryI]", " ", 
             SubscriptBox["\[Omega]", "0"]}], "2"]}], "}"}]}], "}"}], ".", 
       RowBox[{"\[FormalS]", "[", "t", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"\[FormalS]", "[", "0", "]"}], "\[Equal]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"\[FormalS]", "[", "t", "]"}], "\[Element]", 
    RowBox[{"Vectors", "[", 
     RowBox[{"2", ",", 
      TemplateBox[{},
       "Complexes"]}], "]"}]}], ",", "t", ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Output",
 CellLabel->
  "Out[64]= ",ExpressionUUID->"c19ac88b-4f42-4a99-ab7d-7ec00d1c17dc"]
}, Open  ]],

Cell["\<\
Numbers in the Hamiltonian make the same problem solvable numerically, so the \
fallback when a closed form does not exist is to give the parameters values \
and pass an interval instead.\
\>", "Text",ExpressionUUID->"6dd1f293-e391-4116-afa6-8fe6033b176e"],

Cell[CellGroupData[{

Cell["Related Guides", "TutorialMoreAboutSection",
