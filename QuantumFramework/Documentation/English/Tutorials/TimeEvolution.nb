Cell["\<\
The state is a density matrix now rather than a vector, because dissipation \
does not preserve purity. Purity falls from 1 toward the maximally mixed \
value of 1/2:\
\>", "Text",ExpressionUUID->"402c42a4-4ecc-4458-803d-a6ef860815e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"noisy", "[", "t", "]"}], "[", "\"\<Purity\>\"", "]"}], ",", " ", 
   
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"1193a9e9-ea85-4420-aa26-0211fbc5a565"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1.`", ",", "0.5453589757953925`", ",", "0.5041148713352459`", ",", 
   "0.5003732925729159`"}], "}"}]], "Output",
 CellLabel->
  "Out[26]= ",ExpressionUUID->"5097a195-51e0-45c2-aede-4c104003c1cf"]
}, Open  ]],

