Cell[TextData[{
 "The generator is right there in the equation, and it is exactly ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   StyleBox["H", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a72a7144-46da-47ae-ba9d-eff74aa750a0"],
 " for the Hamiltonian that went in - here ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], " ", 
   StyleBox["X", "TI"], "\[CircleTimes]", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "599ddd59-a578-4da6-8f0b-69b3381ea683"],
 ":"
}], "Text",ExpressionUUID->"00bf2920-1e4c-40a3-a870-4c41a4fe15cc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqs", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", "\"\<XX\>\"", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"\"\<ReturnEquations\>\"", " ", "->", " ", "True"}]}], "]"}]}], 
