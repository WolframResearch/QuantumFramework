Cell[TextData[{
 "Before spending QPU time, you can sample the circuit on a local noiseless \
simulator. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumCircuitOperator"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumCircuitOperator", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "04646437-faee-7dfc-2c1c-7e70fe9b47c6"],
 "'s ",
 Cell[BoxData["\"\<Qiskit\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbde497-e826-5557-4442-fdd089d33fbd"],
 " interface runs through a local Qiskit Aer simulator when no provider is \
given, returning a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumMeasurement"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumMeasurement", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],
 " whose statistics converge to the exact distribution as the shot count \
grows (this needs the Python Qiskit stack):"
}], "Text",
 CellID->1735808809,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qc", "[", "\"\<Qiskit\>\"", "]"}], "[", 
   RowBox[{"\"\<Shots\>\"", " ", "->", " ", "4096"}], "]"}], 
  "[", "\"\<ProbabilityPlot\>\"", "]"}]], "Input",
 CellID->753514147,ExpressionUUID->"1f908cf3-3c70-d55a-45af-25bdb50abfa0"],

Cell["Inspecting the circuit as OpenQASM", "Section",
 CellID->1164297175,ExpressionUUID->"5dac66ba-272d-3627-0b54-7fe452d99d0d"],

Cell[TextData[{
 "A QPU does not read a Wolfram Language expression: the circuit is sent as \
OpenQASM. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumQASM"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumQASM", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 " is the single hub for it. Called on a circuit with no extra arguments it \
emits OpenQASM ",
 StyleBox["3.0",
  FontWeight->"Bold"],
 " natively, in pure Wolfram Language with no external dependency, \
serializing the circuit exactly as built. Measurements become classical-bit \
assignments:"
}], "Text",
 CellID->632614636,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumQASM", "[", "qc", "]"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->758895630,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell[BoxData["\<\"OPENQASM 3.0;\\nqubit[3] q;\\nbit[3] \
c;\\nU(1.5707963267948966, 0., 3.141592653589793) q[0];\\nctrl(1) @ \
negctrl(0) @ U(3.141592653589793, 0., 3.141592653589793) q[0] q[1];\\nctrl(1) \
@ negctrl(0) @ U(3.141592653589793, 0., 3.141592653589793) q[1] \
q[2];\\nU(1.5707963267948966, 0., 3.141592653589793) q[0];\\nctrl(1) @ \
negctrl(0) @ U(0., 0., 1.5707963267948966) q[1] q[0];\\nctrl(1) @ negctrl(0) \
@ U(0., 0., 0.7853981633974483) q[2] q[0];\\nU(1.5707963267948966, 0., \
3.141592653589793) q[1];\\nctrl(1) @ negctrl(0) @ U(0., 0., \
1.5707963267948966) q[2] q[1];\\nU(1.5707963267948966, 0., 3.141592653589793) \
q[2];\\nswap q[0] q[2];\\nc[0] = measure q[0];\\nc[1] = measure q[1];\\nc[2] \
= measure q[2];\"\>"], "Output",
 CellLabel->"Out[4]= ",
 CellID->1126217256,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"]
}, Open  ]],

Cell[TextData[{
 "The hub is also an importer: handing OpenQASM source (or a ",
 Cell[".qasm", "InlineCode",ExpressionUUID->
  "4ebf3687-f906-130d-7644-afe0f8b37e57"],
 " file) back to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumCircuitOperator"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumCircuitOperator", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 " reconstructs the circuit, again with no external dependency. The round \
trip recovers a circuit equal to the original:"
}], "Text",
 CellID->1303163127,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"QuantumQASM", "[", "qc", "]"}], "]"}], " ", "==", " ", 
  "qc"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->1939205009,ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",
 CellID->1468078176,ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"]
}, Open  ]],

Cell[TextData[{
 "OpenQASM 3.0 is the native and recommended target. For older toolchains \
that still require the legacy ",
 Cell["qelib1.inc", "InlineCode",ExpressionUUID->
  "034d641c-5834-e412-3173-7e4659c6cf78"],
 " gate set, pass ",
 Cell[BoxData[
  RowBox[{"\"\<Version\>\"", " ", "->", " ", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 " to emit OpenQASM 2.0. This path renders through Qiskit, so it needs the \
Python Qiskit stack configured:"
}], "Text",
 CellID->1930159659,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell[BoxData[
 RowBox[{"QuantumQASM", "[", 
  RowBox[{"qc", ",", " ", 
   RowBox[{"\"\<Version\>\"", " ", "->", " ", "2"}]}], "]"}]], "Input",
 CellID->1113655915,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell["Running on hardware", "Section",
 CellID->1606118752,ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell[TextData[{
 "With an active connection, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IBMJobSubmit"]], 
    "paclet:Wolfram/QuantumFramework/ref/IBMJobSubmit", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e1c99a5-dcef-9c28-1623-100ed49be772"],
 " is the one call that runs a circuit on a QPU. It transpiles the circuit \
against the backend's own error-aware ",
 Cell[BoxData["Target"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "608e87cc-8fce-afdf-10b5-1e962a78f525"],
 " (per-instruction error and duration), submits it through the ",
 Cell[BoxData["SamplerV2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aa912c6-4938-1bb7-5a56-8ba068cd699d"],
 " primitive, and returns immediately with an asynchronous ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IBMJob"]], "paclet:Wolfram/QuantumFramework/ref/IBMJob", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "66b4bee0-d247-b105-0e4b-37cde7f3006f"],
 " handle while the job sits in the queue. There is no manual OpenQASM, no \
raw request and no hex decoding of the classical register: the handle carries \
the per-bit to qubit map captured at transpile time, so results come back \
already in the Wolfram Language qubit order."
}], "Text",
 CellID->2141499446,ExpressionUUID->"337c2d89-644e-5b5e-6103-c4d30dfb29a4"],

Cell[BoxData[
 RowBox[{"job", " ", "=", " ", 
  RowBox[{"IBMJobSubmit", "[", 
   RowBox[{"qc", ",", " ", "\"\<ibm_fez\>\""}], "]"}]}]], "Input",
 CellID->339082558,ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],

Cell[TextData[{
 "The handle reports the job's status. Poll it while the job is queued, or \
pass ",
 Cell[BoxData[
  RowBox[{"\"\<Wait\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 " to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IBMJobSubmit"]], 
    "paclet:Wolfram/QuantumFramework/ref/IBMJobSubmit", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
 " to block until the job reaches a terminal status:"
}], "Text",
 CellID->432388834,ExpressionUUID->"6801f052-da94-0b6f-183e-ea1fdf2159b5"],

Cell[BoxData[
 RowBox[{"job", "[", "\"\<Status\>\"", "]"}]], "Input",
 CellID->443736588,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell[TextData[{
 "Refresh the handle to pull a fresh snapshot from the service. Once the \
status is ",
 Cell[BoxData["\"\<Completed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 ", applying the handle returns the measurement reconstructed from the \
hardware counts:"
}], "Text",
 CellID->1593449978,ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

Cell[BoxData[
 RowBox[{"qpu", " ", "=", " ", 
  RowBox[{
   RowBox[{"job", "[", "\"\<Refresh\>\"", "]"}], "[", "]"}]}]], "Input",
 CellID->1742646261,ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell[TextData[{
 "The same handle keeps every response IBM returns under ",
 Cell[BoxData["\"\<Raw\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],
 " and exposes curated accessors on top, so the run's metadata is one query \
away. For example, the billed quantum runtime:"
}], "Text",
 CellID->29467524,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell[BoxData[
 RowBox[{"job", "[", "\"\<QuantumSeconds\>\"", "]"}]], "Input",
 CellID->1939141443,ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

Cell["Choosing the qubit layout", "Section",
 CellID->5047578,ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"],

Cell[TextData[{
 "By default ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IBMJobSubmit"]], 
    "paclet:Wolfram/QuantumFramework/ref/IBMJobSubmit", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 " lays the circuit out for you: it runs the backend's error-aware preset \
transpiler, which picks the physical qubits and the routing. Two options hand \
that choice back to you."
}], "Text",
 CellID->15008895,ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell[TextData[{
 Cell[BoxData["\"\<InitialLayout\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2055bfee-d4b5-7aa2-506a-36cbdd404888"],
 " pins the physical qubits. Give it the device qubit indices (0-indexed, the \
same numbering the backend and its error map use) that the circuit's logical \
qubits map onto in order. The circuit is still transpiled to the backend's \
native gates and routed, so it stays hardware-valid, but it runs on the \
qubits you chose, and the counts still return in the original logical-qubit \
order:"
}], "Text",
 CellID->1892712309,ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell[BoxData[
 RowBox[{"job", " ", "=", " ", 
  RowBox[{"IBMJobSubmit", "[", 
   RowBox[{"qc", ",", " ", "\"\<ibm_fez\>\"", ",", " ", 
    RowBox[{"\"\<InitialLayout\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"12", ",", " ", "13", ",", " ", "14"}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellID->787969749,ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Transpile\>\"", " ", "->", " ", "False"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea251ed-865f-e03c-1652-48b733ebb306"],
 " submits the circuit exactly as given, skipping layout and routing. Use it \
for a circuit that is already in the backend's native gate set on physical \
qubits, for example one you transpiled yourself to control every pass. Here \
the circuit is compiled with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QiskitCircuit"]], 
    "paclet:Wolfram/QuantumFramework/ref/QiskitCircuit", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 "'s ",
 Cell[BoxData["\"\<Transpile\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04786d0e-016a-d127-2c07-8568b01ca00d"],
 " property (which itself takes an ",
 Cell[BoxData["\"\<InitialLayout\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],
 ") and handed straight to submission:"
}], "Text",
 CellID->525088789,ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"isa", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"qc", "[", "\"\<Qiskit\>\"", "]"}], "[", 
     RowBox[{"\"\<Transpile\>\"", ",", " ", 
      RowBox[{"\"\<Provider\>\"", " ", "->", " ", "\"\<IBMProvider\>\""}], ",",
       " ", 
      RowBox[{"\"\<Backend\>\"", " ", "->", " ", "\"\<ibm_fez\>\""}], ",", 
      " ", 
      RowBox[{"\"\<InitialLayout\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"12", ",", " ", "13", ",", " ", "14"}], "}"}]}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"job", " ", "=", " ", 
  RowBox[{"IBMJobSubmit", "[", 
   RowBox[{"isa", ",", " ", "\"\<ibm_fez\>\"", ",", " ", 
    RowBox[{"\"\<Transpile\>\"", " ", "->", " ", "False"}]}], 
   "]"}]}]}], "Input",
 CellID->357930410,ExpressionUUID->"14fd1512-f616-8834-3c82-8d5f83a0db1e"],

Cell[TextData[{
 "The ",
 Cell[BoxData["SamplerV2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c67103-72a1-9427-0efe-696d0755ff0d"],
 " primitive only accepts a hardware-ready (ISA) circuit, so with ",
 Cell[BoxData[
  RowBox[{"\"\<Transpile\>\"", " ", "->", " ", "False"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
 " a circuit that is not already native for the backend is rejected by the \
QPU rather than silently re-laid-out. When you only need to fix which qubits \
are used, ",
 Cell[BoxData["\"\<InitialLayout\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58ee7ecb-1370-1005-0896-7795a605636f"],
 " is the safer choice: it hands you that control while still producing a \
valid circuit."
}], "Text",
 CellID->1802489801,ExpressionUUID->"11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],

Cell["Comparing exact and hardware results", "Section",
 CellID->115301326,ExpressionUUID->"7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],

Cell[TextData[{
 Cell[BoxData["qpu"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3181a460-bc62-f1ee-67be-3e4a3514c334"],
 " is the hardware measurement returned by the handle; the circuit ",
 Cell[BoxData["qc"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],
 " gives the exact, noiseless reference. Take the corresponding Wolfram \
Language measurement:"
}], "Text",
 CellID->1651187567,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wl", " ", "=", " ", 
   RowBox[{"qc", "[", "]"}]}], ";"}]], "Input",
 CellID->941376513,ExpressionUUID->"5e187950-8ca2-2ab2-0638-711a25577898"],

Cell[TextData[{
 "Putting the two distributions side by side shows how much of the \
interference pattern survives the hardware. Each ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumMeasurement"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumMeasurement", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 " exposes its outcome distribution through ",
 Cell[BoxData["\"\<Probabilities\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a9104d-5625-6af3-4356-8a1763d038d9"],
 "; sorting both by outcome and overlaying them, the dominant ",
 Cell[BoxData["000"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],
 ", ",
 Cell[BoxData["001"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43821c38-6720-b4f9-71b1-966212da1ec3"],
 " and ",
 Cell[BoxData["111"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c54d9-3079-6bba-5c24-4d83410c3980"],
 " peaks and the all-but-forbidden ",
 Cell[BoxData["100"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],
 " still come through, while decoherence erodes the contrast and pulls the \
rest toward a uniform distribution:"
}], "Text",
 CellID->2120243592,ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"],

Cell[BoxData[
 RowBox[{"BarChart", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{
     RowBox[{"Values", " ", "@*", " ", "KeySort"}], " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"wl", "[", "\"\<Probabilities\>\"", "]"}], ",", " ", 
       RowBox[{"qpu", "[", "\"\<Probabilities\>\"", "]"}]}], "}"}]}], "]"}], ",",
    "\n", "    ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"ChartLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Exact WL\>\"", ",", " ", "\"\<QPU ibm_fez\>\""}], "}"}]}], ",",
    "\n", "    ", 
   RowBox[{"PlotLabels", " ", "->", " ", 
    RowBox[{"Keys", "[", 
     RowBox[{"wl", "[", "\"\<Probabilities\>\"", "]"}], "]"}]}]}], 
  "]"}]], "Input",
 CellID->1047559317,ExpressionUUID->"6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],

Cell["\<\
The differences are not in the queries but in device noise: each shot passes \
through a deep transpiled circuit on superconducting hardware, and the noise \
varies from job to job.\
\>", "Text",
 CellID->1820947576,ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

