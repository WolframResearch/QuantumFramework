Notebook[{

Cell[CellGroupData[{
Cell["Sending Queries to IBM QPUs", "Title",
 CellID->509267359,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 "In the ",
 ButtonBox["Wolfram Quantum Framework",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/quantum-computation-framework/"], None}],
 " a quantum circuit is a single symbolic object: you can simulate it exactly \
and send that same object to a real ",
 ButtonBox["IBM Quantum",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.ibm.com/quantum"], None}],
 " processing unit (QPU). This tutorial walks the full path: connect to the \
IBM Quantum Platform, build and check a circuit, inspect it as ",
 ButtonBox["OpenQASM",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://openqasm.com/"], None}],
 " (the portable text format QPUs read), submit it to hardware with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IBMJobSubmit"]], 
    "paclet:Wolfram/QuantumFramework/ref/IBMJobSubmit", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 ", and hold the hardware counts up against the exact result."
}], "Text",
 CellID->329621944,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell["\<\
Building and checking run locally with no account. The hardware cells need an \
IBM Quantum account and are marked so you can read the tutorial without \
running them. For help, write to quantum@wolfram.com.\
\>", "Text",
 CellID->515379898,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell[BoxData[
 RowBox[{"<<", " ", "Wolfram`QuantumFramework`"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->604760901,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell["Connecting to the IBM Quantum Platform", "Section",
 CellID->1476799103,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell[TextData[{
 "Create an account at ",
 ButtonBox["quantum.cloud.ibm.com",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://quantum.cloud.ibm.com/"], None}],
 ". From the dashboard you need two things: an ",
 StyleBox["IAM API key",
  FontWeight->"Bold"],
 " (the long secret string shown once when you create the key, not the key's \
display name) and the ",
 StyleBox["instance CRN",
  FontWeight->"Bold"],
 " (a ",
 Cell[BoxData[
  RowBox[{"crn", ":", "v1", ":", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 " string identifying your instance)."
}], "Text",
 CellID->448336599,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell["\<\
The API key is a secret and is stored in your encrypted system credential \
store. The CRN is read from a local symbol that the connection consults when \
it builds the request headers, so set both before connecting:\
\>", "Text",
 CellID->970785311,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"api", " ", "=", " ", "\"\<XXX\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LocalSymbol", "[", "\"\<ibm_crn\>\"", "]"}], " ", "=", 
   " ", "\"\<XXX\>\""}], ";"}]}], "Input",
 CellID->1377816002,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell[TextData[{
 "Loading the Wolfram Quantum Framework registers the IBM Quantum Platform \
service automatically, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ServiceConnect"]], "paclet:ref/ServiceConnect"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 " recognizes the ",
 Cell[BoxData["\"\<IBMQuantumPlatform\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166f8969-5e31-e8e5-3e14-21335bc5bacf"],
 " name directly:"
}], "Text",
 CellID->1439899046,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[BoxData[
 RowBox[{"ibm", " ", "=", " ", 
  RowBox[{"ServiceConnect", "[", 
   RowBox[{"\"\<IBMQuantumPlatform\>\"", ",", " ", "\"\<New\>\"", ",", " ", 
    RowBox[{"Authentication", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<apikey\>\"", " ", "->", " ", "api"}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellID->1641200340,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell[TextData[{
 "A connected service object lists the QPUs your account can reach through ",
 Cell[BoxData["\"\<Backends\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],
 ". Submitting and retrieving jobs is handled for you by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IBMJobSubmit"]], 
    "paclet:Wolfram/QuantumFramework/ref/IBMJobSubmit", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6ec9a758-58be-624c-16f6-3f02594b3096"],
 " and the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IBMJob"]], "paclet:Wolfram/QuantumFramework/ref/IBMJob", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "23253b8d-1c99-a6bf-52da-b2d7952d0c85"],
 " handle, shown below. List the available backends:"
}], "Text",
 CellID->1424533854,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell[BoxData[
 RowBox[{"ibm", "[", "\"\<Backends\>\"", "]"}]], "Input",
 CellID->535457321,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell[TextData[{
 "Before spending QPU time, you can inspect a backend's live calibration as \
an error map with ",
 Cell[BoxData[
  RowBox[{"ibm", "[", 
   RowBox[{"\"\<ErrorMap\>\"", ",", " ", 
    RowBox[{"\"\<Backend\>\"", " ", "->", " ", "\"\<ibm_fez\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],
 " (and read the numbers through ",
 Cell[BoxData[
  RowBox[{"ibm", "[", 
   RowBox[{"\"\<DeviceModel\>\"", ",", " ", "\[Ellipsis]"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "779c57de-bb93-d239-1da4-4e983e27a103"],
 "); see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["the IBM error map tutorial"]], 
    "paclet:Wolfram/QuantumFramework/tutorial/IBMQuantumErrorMap"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "2867ea9b-6e8d-517b-581c-03c50b382041"],
 "."
}], "Text",
 CellID->141959522,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell["Building and checking a circuit", "Section",
 CellID->299517738,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[TextData[{
 "Build the circuit in the Wolfram Language first, so you have an exact \
reference to compare the hardware against. This example prepares a \
three-qubit GHZ state ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["GHZ", FontSlant -> "Plain"]},
    "Ket"], "=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox["2"]], 
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{"000"},
       "Ket"], "+", 
      TemplateBox[{"111"},
       "Ket"]}], ")"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 ", applies a quantum Fourier transform and measures all three qubits. The \
transform turns the GHZ entanglement into a definite interference pattern \
across the eight outcomes, and that structure is exactly what device noise \
erodes, which makes the circuit a sensitive benchmark:"
}], "Text",
 CellID->2142391071,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<GHZ\>\"", ",", " ", 
      RowBox[{"\"\<Fourier\>\"", "[", "3", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"qc", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[2]:= ",
 CellID->187047899,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

