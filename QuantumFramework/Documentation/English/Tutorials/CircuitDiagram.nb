\>", "Text",
 CellID->2122865143,ExpressionUUID->"574a2197-51ef-7938-7d49-b8d1679a4802"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<CX\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", " ", 
     RowBox[{"\"\<CY\>\"", " ", "->", " ", 
