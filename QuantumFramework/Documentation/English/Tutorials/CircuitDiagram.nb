     RowBox[{"\"\<Y\>\"", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"Thickness", "[", "0.02", "]"}], ",", " ", "Red"}], "]"}]}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->1735808809,ExpressionUUID->"6e85e9ed-427b-8528-16ba-00b7770fec72"],

