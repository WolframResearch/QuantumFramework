Cell["\<\
\"GateShapeFunction\" can be specified to render gates with a custom function \
that takes {center, label, horizontalPositions, verticalPositions} arguments:\
\
\>", "Text",
 CellID->1164297175,ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<X\>\"", ",", " ", "\"\<SWAP\>\"", ",", " ", 
     RowBox[{"\"\<SWAP\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}]}], "}"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", "\n", " ", 
   RowBox[{"\"\<GateShapeFunction\>\"", " ", "->", " ", "\n", "  ", 
    RowBox[{"\"\<SWAP\>\"", " ", "->", " ", "\n", "   ", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "center", ",", " ", "label", ",", " ", "hPos", ",", " ", "vPos"}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"EdgeForm", "[", "Red", "]"}], ",", " ", "\n", "     ", 
         RowBox[{"FaceForm", "[", 
          RowBox[{"Directive", "[", 
           RowBox[{"Red", ",", " ", 
            RowBox[{"Opacity", "[", "0.25", "]"}]}], "]"}], "]"}], ",", " ", 
         "\n", "     ", 
         RowBox[{"Rectangle", "[", 
          RowBox[{
           RowBox[{"center", " ", "-", " ", 
            RowBox[{"{", 
             RowBox[{".375", ",", " ", 
              RowBox[{".75", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Max", "[", "vPos", "]"}], " ", "-", " ", 
                 RowBox[{"Min", "[", "vPos", "]"}]}], ")"}]}]}], "}"}]}], ",",
            " ", "\n", "      ", 
           RowBox[{"center", " ", "+", " ", 
            RowBox[{"{", 
             RowBox[{".375", ",", " ", 
              RowBox[{".75", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Max", "[", "vPos", "]"}], " ", "-", " ", 
                 RowBox[{"Min", "[", "vPos", "]"}]}], ")"}]}]}], "}"}]}], ",",
            " ", "\n", "      ", 
           RowBox[{"RoundingRadius", " ", "->", " ", "0.1"}]}], "]"}], ",", 
         " ", "\n", "     ", 
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"Rotate", "[", 
              RowBox[{"label", ",", " ", 
               RowBox[{
                RowBox[{"-", "Pi"}], "/", "2"}]}], "]"}], ",", " ", "20", ",",
              " ", "Blue"}], "]"}], ",", " ", "center"}], "]"}]}], "}"}]}], 
      "]"}]}]}]}], "\n", " ", "]"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->632614636,ExpressionUUID->"72ff7667-e560-b2c0-2285-68408c1a002a"],

