 "\"ShowMeasurementWire\" -> ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0651775d-2bad-791b-2e6f-6f074e584861"],
 " hides a measurement wire:"
}], "Text",
 CellID->525088789,ExpressionUUID->"63b9e3d6-2298-231e-1146-fa9057128e64"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<H\>\"", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "}"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", "\n", " ", 
   RowBox[{"\"\<ShowMeasurementWire\>\"", " ", "->", " ", "False"}]}], 
  "]"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->357930410,ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"],

Cell[TextData[{
 "\"MeasurementWirePosition\" can be ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Top"]], "paclet:ref/Top"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4c440104-ea8a-4285-747b-99618f3f10ef"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Bottom"]], "paclet:ref/Bottom"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "66c9a615-af45-c085-0ef6-385ecaf192ef"],
 ":"
}], "Text",
 CellID->1802489801,ExpressionUUID->"0513e607-0f4c-1e20-3320-f861aaf9650a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<H\>\"", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "}"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", "\n", " ", 
   RowBox[{"\"\<MeasurementWirePosition\>\"", " ", "->", " ", "Bottom"}]}], 
  "]"}]], "Input",
 CellLabel->"In[17]:= ",
 CellID->115301326,ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"],

Cell["Show extra qudits used by channels and measurements:", "Text",
 CellID->1651187567,ExpressionUUID->"6833ae6a-6ac5-a2c8-19c0-40340f71f012"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<H\>\"", ",", " ", "\"\<BitFlip\>\"", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "}"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", "\n", " ", 
   RowBox[{"\"\<ShowExtraQudits\>\"", " ", "->", " ", "True"}]}], 
  "]"}]], "Input",
 CellLabel->"In[18]:= ",
 CellID->941376513,ExpressionUUID->"5f7f2999-1aee-25a5-0504-c0c39e988f8f"],

Cell["\<\
Extra qudits are always shown when there is an explicit gate there:\
\>", "Text",
 CellID->2120243592,ExpressionUUID->"128c7526-c883-085d-42b4-6c83e9365aa7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<H\>\"", ",", " ", 
     RowBox[{"\"\<X\>\"", " ", "->", " ", "0"}], ",", " ", "\"\<BitFlip\>\"", 
     ",", " ", 
     RowBox[{"{", "2", "}"}]}], "}"}], "]"}], "[", "\"\<Diagram\>\"", 
  "]"}]], "Input",
 CellLabel->"In[19]:= ",
 CellID->1047559317,ExpressionUUID->"3279c00f-c9e2-8758-6206-da68ef94eda2"],

Cell["\"WireLabels\" can be a list of labels or a list of rules:", "Text",
 CellID->1820947576,ExpressionUUID->"50b12ff8-e606-85f7-004e-c6a593b0efdd"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<X\>\"", ",", " ", 
        RowBox[{"\"\<H\>\"", " ", "->", " ", 
         RowBox[{"{", "2", "}"}]}], ",", " ", 
        RowBox[{"\"\<T\>\"", " ", "->", " ", 
         RowBox[{"{", "3", "}"}]}]}], "}"}], "]"}], "[", 
     RowBox[{"\"\<Diagram\>\"", ",", " ", "\n", "   ", 
      RowBox[{"\"\<WireLabels\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b"}], "}"}]}]}], "]"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<X\>\"", ",", " ", 
        RowBox[{"\"\<H\>\"", " ", "->", " ", 
         RowBox[{"{", "2", "}"}]}], ",", " ", 
        RowBox[{"\"\<T\>\"", " ", "->", " ", 
         RowBox[{"{", "3", "}"}]}]}], "}"}], "]"}], "[", 
     RowBox[{"\"\<Diagram\>\"", ",", " ", "\n", "   ", 
      RowBox[{"\"\<WireLabels\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", " ", "->", " ", 
          RowBox[{"Placed", "[", 
           RowBox[{"\"\<two\>\"", ",", " ", "Right"}], "]"}]}], ",", " ", 
         "\n", "     ", 
         RowBox[{"1", " ", "->", " ", 
          RowBox[{"Placed", "[", 
           RowBox[{"\"\<one\>\"", ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", ".1"}], "}"}]}], "]"}]}]}], "}"}]}]}], 
     "]"}]}], "\n", "  ", "}"}], "]"}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->670734585,ExpressionUUID->"640f47a5-4648-c62d-0c35-5e0f73e2ad77"],

