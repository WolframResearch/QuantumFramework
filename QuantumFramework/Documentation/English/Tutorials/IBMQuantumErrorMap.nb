Notebook[{

Cell[CellGroupData[{
Cell["An IBM Quantum Error Map", "Title",
 CellID->509267359,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell["\<\
A quantum processor is only as good as its current calibration, and that \
calibration drifts from hour to hour. This note draws a single picture of an \
IBM device's instantaneous health: the qubit connectivity graph with the live \
per-qubit and per-bond calibration painted onto it.\
\>", "Text",
 CellID->329621944,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell["What IBM actually exposes", "Section",
 CellID->515379898,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell[TextData[{
 "Two read-only endpoints carry everything the map needs. The device's ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ServiceConnect"]], "paclet:ref/ServiceConnect"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "75d93363-5da6-51a4-23e6-ab4d5453238e"],
 " connection to ",
 Cell[BoxData["\"\<IBMQuantumPlatform\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a568a6-87a2-527f-535a-810032572145"],
 " already defines both as raw requests."
}], "Text",
 CellID->604760901,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell[TextData[{
 Cell[BoxData["configuration"], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 " gives the static layout: the coupling map (the list of physically \
connected qubit pairs), a per-qubit grid coordinate, and the native gate set \
(",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["c", "TI"], 
    StyleBox["z", "TI"]}], ",", 
   StyleBox[
    RowBox[{"i", "d"}], "TI"], ",", 
   StyleBox[
    RowBox[{"r", "x"}], "TI"], ",", 
   StyleBox[
    RowBox[{"r", "z"}], "TI"], ",", 
   StyleBox[
    RowBox[{"r", "z", "z"}], "TI"], ",", 
   StyleBox[
    RowBox[{"s", "x"}], "TI"], ",", 
   RowBox[{
    StyleBox["x", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5902d484-617f-9570-0f31-cdee100bfc5a"],
 " on Heron)."
}], "Item",
 CellID->1476799103,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[TextData[{
 Cell[BoxData["properties"], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],
 " gives the live calibration, each value time-stamped: per qubit the \
relaxation time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 ", the dephasing time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166f8969-5e31-e8e5-3e14-21335bc5bacf"],
 ", the single-shot readout error, and the asymmetric \
state-preparation-and-measurement probabilities; per gate the error and \
duration; and, in a ",
 Cell[BoxData["general"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "234f1fb7-07c6-bba9-5174-96f1b27009f3"],
 " block, the static ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Z", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
 " crosstalk for every coupled pair."
}], "Item",
 CellID->448336599,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell[TextData[{
 "One thing is worth stating plainly: ",
 StyleBox["IBM publishes no Bell-state fidelity",
  FontWeight->"Bold"],
 ". There is no two-qubit fidelity number beyond the ",
 Cell[BoxData["cz"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ec9a758-58be-624c-16f6-3f02594b3096"],
 " gate error itself. So the ",
 Cell[BoxData["cz"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23253b8d-1c99-a6bf-52da-b2d7952d0c85"],
 " error becomes the bond ",
 StyleBox["color", "TI"],
 ", and the natural second per-bond channel is the static ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Z", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e84829b-9667-6594-16bb-1bc523124ffe"],
 " crosstalk: the always-on residual coupling a pair carries even while idle, \
an error source independent of the gate error."
}], "Text",
 CellID->970785311,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell["Building the map", "Section",
 CellID->1377816002,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

Cell[TextData[{
 "The error map is a property of the ",
 Cell[BoxData["\"\<IBMQuantumPlatform\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "779c57de-bb93-d239-1da4-4e983e27a103"],
 " ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ServiceConnect"]], "paclet:ref/ServiceConnect"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2867ea9b-6e8d-517b-581c-03c50b382041"],
 " connection. It needs IBM credentials for the read-only metadata fetch: an \
API key, and the IBM Cloud resource name stored as ",
 Cell[BoxData[
  RowBox[{"LocalSymbol", "[", "\"\<ibm_crn\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76dfbc62-92ac-7b6e-1ee4-364c275949b4"],
 "."
}], "Text",
 CellID->1439899046,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"api", " ", "=", " ", "\"\<Your_IBM_API\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LocalSymbol", "[", "\"\<ibm_crn\>\"", "]"}], " ", "=", 
   " ", "\"\<Your_IBM_CRN\>\""}], ";"}], "\n", 
 RowBox[{"ibm", " ", "=", " ", 
  RowBox[{"ServiceConnect", "[", 
   RowBox[{"\"\<IBMQuantumPlatform\>\"", ",", " ", "\"\<New\>\"", ",", " ", 
    RowBox[{"Authentication", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<apikey\>\"", " ", "->", " ", "api"}], "}"}]}]}], 
   "]"}]}]}], "Input",
 CellID->1641200340,ExpressionUUID->"4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],

Cell[TextData[{
 "Draw the map. The ",
 Cell[BoxData["\"\<Backend\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "741b091d-feb2-1a39-1c38-a146fb476903"],
 " parameter is required and names the device; the curated default styling is \
used:"
}], "Text",
 CellID->1424533854,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell[BoxData[
 RowBox[{"ibm", "[", 
  RowBox[{"\"\<ErrorMap\>\"", ",", " ", 
   RowBox[{"\"\<Backend\>\"", " ", "->", " ", "\"\<ibm_fez\>\""}]}], 
  "]"}]], "Input",
 CellID->535457321,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"],

Cell["\<\
The connection also exposes the underlying error model and its projections, \
each keyed by the sorted qubit pair, so the map's numbers are independently \
queryable (still no circuit, no quantum time):\
\>", "Text",
 CellID->141959522,ExpressionUUID->"3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],

Cell[BoxData[
 RowBox[{"ibm", "[", 
  RowBox[{"\"\<DeviceModel\>\"", ",", " ", 
   RowBox[{"\"\<Backend\>\"", " ", "->", " ", "\"\<ibm_fez\>\""}]}], 
  "]"}]], "Input",
 CellID->299517738,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell[TextData[{
 "The accessor family is ",
 Cell[BoxData["\"\<DeviceModel\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77d99fdb-a351-2d53-1de6-1684d6e477b9"],
 ", ",
 Cell[BoxData["\"\<CouplingMap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04646437-faee-7dfc-2c1c-7e70fe9b47c6"],
 ", ",
 Cell[BoxData["\"\<CouplingGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbde497-e826-5557-4442-fdd089d33fbd"],
 ", ",
 Cell[BoxData["\"\<CZErrors\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],
 ", ",
 Cell[BoxData["\"\<CZDurations\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c358d3e-86d3-ec5f-75ca-25783367b6a5"],
 ", ",
 Cell[BoxData["\"\<ZZ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f908cf3-3c70-d55a-45af-25bdb50abfa0"],
 ", ",
 Cell[BoxData["\"\<GateErrors\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " (which takes a ",
 Cell[BoxData["\"\<GateName\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 " parameter, default ",
 Cell[BoxData["\"\<cz\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d004f9-29e5-6665-1eef-9da34f904d4f"],
 "), ",
 Cell[BoxData["\"\<ReadoutErrors\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c76c797-c249-79ca-540d-ded0f7fc4b10"],
 ", ",
 Cell[BoxData["\"\<Coherence\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35077f55-9291-6519-633d-771f27244c63"],
 ", and ",
 Cell[BoxData["\"\<Qubits\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebf3687-f906-130d-7644-afe0f8b37e57"],
 ". ",
 Cell[BoxData["\"\<DeviceModel\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 " fetches once and carries every projection as a key, so it is the efficient \
path when you need several at once; nothing device-specific is hardcoded, so \
a metric the device adds later is ingested with no change."
}], "Text",
 CellID->2142391071,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell[TextData[{
 "Where ",
 Cell[BoxData["\"\<CouplingMap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 " returns the bare list of connected pairs, ",
 Cell[BoxData["\"\<CouplingGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 " returns that same connectivity as a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "034d641c-5834-e412-3173-7e4659c6cf78"],
 ": the physical qubit indices as vertices, the couplers as edges, and the \
device's heavy-hex layout carried as the vertex coordinates. Because it is an \
ordinary graph, the built-in graph functions apply to it directly, from ",
 Cell[BoxData["FindShortestPath"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 " between two qubits to a ",
 Cell[BoxData["Subgraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfe104a-50de-a555-0985-8a1461680fbf"],
 " that picks out a linear chain to map a circuit onto."
}], "Text",
 CellID->1002769646,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell[BoxData[
 RowBox[{"ibm", "[", 
  RowBox[{"\"\<CouplingGraph\>\"", ",", " ", 
   RowBox[{"\"\<Backend\>\"", " ", "->", " ", "\"\<ibm_fez\>\""}]}], 
  "]"}]], "Input",
 CellID->436346740,ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell["Reading the map", "Section",
 CellID->2122865143,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell["\<\
The drawing carries four calibration channels at once, plus the qubit labels \
and the defect markers.\
\>", "Text",
 CellID->1735808809,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell[TextData[{
 StyleBox["Bond color",
  FontWeight->"Bold"],
 " is the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["log",
    FontSlant->"Plain"], "10"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aa912c6-4938-1bb7-5a56-8ba068cd699d"],
 " of the ",
 Cell[BoxData["cz"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66b4bee0-d247-b105-0e4b-37cde7f3006f"],
 " gate error, on a temperature scale: blue is a clean coupler, red a lossy \
one."
}], "Item",
 CellID->753514147,ExpressionUUID->"337c2d89-644e-5b5e-6103-c4d30dfb29a4"],

Cell[TextData[{
 StyleBox["Bond thickness",
  FontWeight->"Bold"],
 " is the static ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Z", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 " crosstalk (0 to about 26 kHz on ",
 Cell[BoxData["ibm_fez"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 "): a thick bond leaks more always-on coupling."
}], "Item",
 CellID->1164297175,ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],

Cell[TextData[{
 StyleBox["Vertex color",
  FontWeight->"Bold"],
 " is ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 " on an avocado scale. Larger ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0daf8e98-7628-e40b-3b54-27c203c2cf51"],
 " is better, so a long-lived qubit is dark green and a short-lived one glows \
yellow."
}], "Item",
 CellID->632614636,ExpressionUUID->"7b6211f5-475c-1194-2911-88bf72e963fe"],

Cell[TextData[{
 StyleBox["Vertex size",
  FontWeight->"Bold"],
 " is the readout error, but ",
 StyleBox["inverted", "TI"],
 " so that a big disk is a good (low-readout) qubit. The single worst qubit \
is therefore the smallest dot."
}], "Item",
 CellID->1689610856,ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

Cell[TextData[{
 StyleBox["Vertex label",
  FontWeight->"Bold"],
 " is the physical qubit index, so a problem qubit can be named, not just \
pointed at."
}], "Item",
 CellID->1303163127,ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell["\<\
A coupler IBM currently flags as uncalibrated (gate error reported as exactly \
1) is drawn as a dashed gray defect bond, and a qubit with no readout number \
as a dashed defect site, so the full physical lattice is always visible. The \
bonds carry double-headed arrows; the next section says why.\
\>", "Text",
 CellID->2098230307,ExpressionUUID->"5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],

Cell["Options", "Section",
 CellID->1930159659,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell[TextData[{
 "Every channel is a parameter of the ",
 Cell[BoxData["\"\<ErrorMap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cb5c01f-62f5-68e0-144a-da5916803aca"],
 " request, so the look is fully steerable; the defaults are the curated dark \
look. Because ",
 Cell[BoxData["\"\<Backend\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f417ec-7166-d78d-038b-8eb60010bdd7"],
 " is required, pass it together with any style overrides as one list of \
rules (the standard ",
 Cell[BoxData["ServiceConnect"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 " parameter form)."
}], "Text",
 CellID->1113655915,ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2055bfee-d4b5-7aa2-506a-36cbdd404888"], Cell["Parameter", "TableText",
     FontWeight->Bold,ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
     Cell["Meaning", "TableText",
     FontWeight->Bold,ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "25a0bfbe-b1d4-2428-535f-36fbc0668f72"], Cell[TextData[Cell[
    BoxData["\"\<EdgeColorScheme\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "04786d0e-016a-d127-2c07-8568b01ca00d"]], "TableText",ExpressionUUID->
     "2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"], Cell[TextData[Cell[
    BoxData["\"\<TemperatureMap\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2d1ff276-b82a-c3ca-5b24-f43039dc9110"]], "TableText",ExpressionUUID->
     "14fd1512-f616-8834-3c82-8d5f83a0db1e"], Cell[TextData[{
     "gradient for the ",
     Cell[BoxData["cz"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "66c67103-72a1-9427-0efe-696d0755ff0d"],
     "-error bond color"
    }], "TableText",ExpressionUUID->"48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "58ee7ecb-1370-1005-0896-7795a605636f"], Cell[TextData[Cell[
    BoxData["\"\<VertexColorScheme\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"]], "TableText",ExpressionUUID->
     "7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"], Cell[TextData[Cell[
    BoxData["\"\<AvocadoColors\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3181a460-bc62-f1ee-67be-3e4a3514c334"]], "TableText",ExpressionUUID->
     "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"], Cell[TextData[{
     "gradient for the ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["T", "TI"], "1"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6b45e796-37a7-eecc-197a-fed04253b416"],
     " vertex color"
    }], "TableText",ExpressionUUID->"5e187950-8ca2-2ab2-0638-711a25577898"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "250a2d7c-9b81-05b0-5309-c5261e346f9a"], Cell[TextData[Cell[
    BoxData["\"\<VertexColorReversed\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "15a9104d-5625-6af3-4356-8a1763d038d9"]], "TableText",ExpressionUUID->
     "58c17d8b-1b7e-6f79-08ff-74d59e0b3243"], Cell[TextData[Cell[BoxData[
    "True"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "43821c38-6720-b4f9-71b1-966212da1ec3"]], "TableText",ExpressionUUID->
     "341c54d9-3079-6bba-5c24-4d83410c3980"], Cell[TextData[{
     "map low ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["T", "TI"], "1"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],
     " to the gradient's bright end"
    }], "TableText",ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"], Cell[TextData[Cell[
    BoxData["\"\<VertexSizeReversed\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5077c06e-c394-b43c-000c-da4bf6261f06"]], "TableText",ExpressionUUID->
     "07359582-e823-44a1-2eca-0cef89d62e8b"], Cell[TextData[Cell[BoxData[
    "True"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7c239bd0-3ff5-3b18-25d0-129ab9818662"]], "TableText",ExpressionUUID->
     "68c76573-72ce-0c1a-18fd-7d3d077b5760"], Cell[TextData[{
     "big disk = low readout error (good); set ",
     Cell[BoxData["False"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6184d2f2-049e-728e-17bb-cbbcad2b40d4"],
     " for big = bad"
    }], "TableText",ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "19bb1c5e-57ab-6e36-4f58-9618625e351c"], Cell[TextData[Cell[
    BoxData["\"\<EdgeThicknessMetric\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
