Notebook[{

Cell[CellGroupData[{
Cell["Getting Started", "Title",
 CellID->509267359,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell["How to install and load the paclet", "Text",
 CellID->329621944,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell["Install the paclet and load it:", "Text",
 CellID->515379898,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell[BoxData[{
 RowBox[{"PacletInstall", "[", "\"\<Wolfram/QuantumFramework\>\"", "]"}], "\n", 
 RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}]}], "Input",
 CellID->604760901,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell["Check whether definitions are now available:", "Text",
 CellID->1476799103,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell[BoxData[
 RowBox[{"Names", "[", "\"\<Quantum*\>\"", "]"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->448336599,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell["\<\
A quantum gate for the magic basis transformation (transforming 2 qubit \
computational basis to the Bell basis):\
\>", "Text",
 CellID->970785311,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", "\"\<Magic\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{"qc", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[2]:= ",
 CellID->1377816002,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell["\<\
Test how above circuit transforms computational basis of 2-qubit into Bell \
states:\
\>", "Text",
 CellID->1439899046,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qc", "[", 
   RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}], "]"}], " ", "==", " ", 
  RowBox[{"QuantumState", "[", "\"\<PhiPlus\>\"", "]"}]}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->1641200340,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qc", "[", 
   RowBox[{"QuantumState", "[", "\"\<10\>\"", "]"}], "]"}], " ", "==", " ", 
  RowBox[{"I", " ", 
   RowBox[{"QuantumState", "[", "\"\<PsiPlus\>\"", "]"}]}]}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->1424533854,ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qc", "[", 
   RowBox[{"QuantumState", "[", "\"\<01\>\"", "]"}], "]"}], " ", "==", " ", 
  RowBox[{"I", " ", 
   RowBox[{"QuantumState", "[", "\"\<PhiMinus\>\"", "]"}]}]}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->535457321,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qc", "[", 
   RowBox[{"QuantumState", "[", "\"\<11\>\"", "]"}], "]"}], " ", "==", " ", 
  RowBox[{"QuantumState", "[", "\"\<PsiMinus\>\"", "]"}]}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->141959522,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell["Generate corresponding tensor network of the circuit", "Text",
 CellID->299517738,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell[BoxData[
 RowBox[{"qc", "[", 
  RowBox[{"\"\<TensorNetwork\>\"", ",", " ", 
   RowBox[{"EdgeLabels", " ", "->", " ", "Automatic"}]}], "]"}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->2142391071,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell["Add measurements into above circuit", "Text",
 CellID->1002769646,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc2", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "1", "}"}], ",", " ", 
      RowBox[{"{", "2", "}"}]}], "}"}], "@*", "qc"}]}], ";"}], "\n", 
 RowBox[{"qc2", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[8]:= ",
 CellID->436346740,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell["Calculate the result of circuit on registered state:", "Text",
 CellID->2122865143,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell[BoxData[
 RowBox[{"mea", " ", "=", " ", 
  RowBox[{"qc2", "[", "]"}]}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->1735808809,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell["Represents the corresponding probabilities:", "Text",
 CellID->753514147,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

Cell[BoxData[
 RowBox[{"mea", "[", "\"\<ProbabilityPlot\>\"", "]"}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->1164297175,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

