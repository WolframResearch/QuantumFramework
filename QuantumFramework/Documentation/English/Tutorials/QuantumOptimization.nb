Cell["\<\
We then assign weights based on inter-subgraph interactions and repeat the \
QAOA process at this higher level:\
\>", "Text",
 CellID->1762595683,ExpressionUUID->"39672ae7-82f4-b353-6f1c-c3c1368601b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"subweights2", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"<|", "\n", "     ", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"List", " ", "@@@", " ", 
         RowBox[{"EdgeList", "[", "#", "]"}]}], " ", "->", " ", 
        RowBox[{
         RowBox[{"(", "\n", "       ", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"PropertyValue", "[", 
            RowBox[{"#", ",", " ", "EdgeWeight"}], "]"}]}], ")"}], "/", 
         "2"}]}], "]"}], "|>"}], " ", "&"}], "@", "g2"}]}], ";"}]], "Input",
 CellLabel->"In[182]:= ",
 CellID->1187103035,ExpressionUUID->"0c48aba4-6f27-6a39-3477-420e0ad23903"],

Cell[BoxData[
 RowBox[{
  RowBox[{"subHc2", " ", "=", " ", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"Table", "[", "\n", "      ", 
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"#", "[", "i", "]"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"QuantumOperator", "[", 
            RowBox[{"\"\<I\>\"", ",", " ", "i"}], "]"}], " ", "-", " ", "\n", 
           "         ", 
           RowBox[{"QuantumOperator", "[", 
            RowBox[{"\"\<Z\>\"", ",", " ", "i"}], "]"}]}], ")"}]}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Keys", "@", "#"}]}], "}"}]}], "]"}], "]"}], " ", "&"}], "@",
     "subweights2"}]}], ";"}]], "Input",
 CellLabel->"In[183]:= ",
 CellID->596084392,ExpressionUUID->"2f62374d-f3df-131c-5511-af16866a7e66"],

Cell[BoxData[
 RowBox[{"subQAOA2", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{
      RowBox[{"{", "\n", "     ", 
       RowBox[{
        RowBox[{"\"\<+\>\"", " ", "->", " ", 
         RowBox[{"VertexList", "[", "#1", "]"}]}], ",", "\n", "     ", 
        RowBox[{"Sequence", " ", "@@", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<R\>\"", ",", " ", "t", ",", " ", "\"\<ZZ\>\""}], 
              "}"}], " ", "->", " ", "#1"}], " ", "&"}], ")"}], " ", "/@", 
          " ", 
          RowBox[{"List", " ", "@@@", " ", 
           RowBox[{"EdgeList", "[", "#1", "]"}]}]}]}], ",", "\n", "     ", 
        RowBox[{
         RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], " ", "->", " ", 
         RowBox[{"VertexList", "[", "#1", "]"}]}]}], "\n", "     ", "}"}], ",",
       "\n", "    ", 
      RowBox[{"\"\<Label\>\"", " ", "->", " ", "None"}], ",", " ", 
      RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", " ", "t"}], "}"}]}]}], "]"}], " ", "&"}], "@",
    "g2"}]}]], "Input",
 CellLabel->"In[184]:= ",
 CellID->807532227,ExpressionUUID->"455ea632-3d4d-f0d3-7365-387cb4f9c239"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"QAOAstates2", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"QuantumOperator", "[", "#", "]"}], "[", "\"\<State\>\"", "]"}],
      " ", "&"}], "@", "subQAOA2"}]}], ";"}], "\n", 
 RowBox[{"subcost2", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\"\<Scalar\>\"", " ", "//", " ", "\n", "     ", 
      RowBox[{
       RowBox[{"SuperDagger", "[", "QAOAstates2", "]"}], "@", 
       RowBox[{
        RowBox[{"subHc2", "[", "\"\<State\>\"", "]"}], "@", 
        "QAOAstates2"}]}]}], ")"}], " ", "//", " ", "\n", "   ", 
    "ComplexExpand"}], " ", "//", " ", "Simplify"}]}]}], "Input",
 CellLabel->"In[185]:= ",
 CellID->1432509556,ExpressionUUID->"1f0fb95c-030e-c889-4534-3106b6b89ad3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"subres2", " ", "=", " ", 
   RowBox[{"NMaximize", "[", 
    RowBox[{"subcost2", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", " ", "t"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[186]:= ",
 CellID->1693881419,ExpressionUUID->"16268eae-a572-7912-3fdd-270bcc074878"],

Cell["\<\
Finally, we observe the resulting probability distribution and solve the \
MaxCut problem for the higher-level graph:\
\>", "Text",
 CellID->1209160228,ExpressionUUID->"346a0e1a-2221-987e-5c69-a04457d5eb44"],

Cell[BoxData[
 RowBox[{
  RowBox[{"result2", " ", "=", " ", 
   RowBox[{
    RowBox[{"subQAOA2", "[", "\"\<State\>\"", "]"}], "[", 
    RowBox[{"<|", " ", 
     RowBox[{"Last", "[", "subres2", "]"}], "|>"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[187]:= ",
 CellID->1444031424,ExpressionUUID->"366be24c-537a-43bb-5e68-0416660f1181"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"probplot", " ", "=", " ", "\n", "  ", 
   RowBox[{"result2", "[", 
    RowBox[{"\"\<ProbabilityPlot\>\"", ",", " ", 
     RowBox[{"BarOrigin", " ", "->", " ", "Left"}], ",", " ", 
     RowBox[{"\"\<Range\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0.02", ",", " ", "1"}], "}"}]}], ",", " ", "\n", "   ", 
     RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"groups2", " ", "=", " ", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Part", "[", 
       RowBox[{
        RowBox[{"Keys", "@", 
         RowBox[{"ReverseSortBy", "[", 
          RowBox[{
           RowBox[{"#", "[", "\"\<Probabilities\>\"", "]"}], ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ",", " ", "2"}], "]"}],
       "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], "@", "\n", "   ", 
    "result2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"solution2", " ", "=", " ", "\n", "  ", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Thread", " ", "/@", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"First", "[", 
          RowBox[{"#", "[", "\"\<Order\>\"", "]"}], "]"}], " ", "&"}], "@", 
        "subQAOA2"}], " ", "->", " ", "groups2"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grouped2", " ", "=", " ", "\n", "  ", 
   RowBox[{"HighlightGraph", "[", 
    RowBox[{"g2", ",", " ", "\n", "   ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Subgraph", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], ",", " ", 
       RowBox[{
        RowBox[{"GatherBy", "[", 
         RowBox[{"solution2", ",", " ", "Last"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "All", ",", " ", "1"}], "]"}], "]"}]}], 
      "]"}], ",", " ", "\n", "   ", 
     RowBox[{"VertexLabelStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", " ", "12"}], "]"}]}], ",", " ", "\n", "   ", 
     RowBox[{"GraphHighlightStyle", " ", "->", " ", "\"\<Thick\>\""}], ",", 
     " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"probplot", ",", " ", "grouped2"}], "}"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]}], "Input",
 CellLabel->"In[188]:= ",
 CellID->1548955826,ExpressionUUID->"501b1457-1a1d-907b-0038-8e119fa9e341"],

Cell["\<\
n the final step, we take the subgraphs that are yellow nodes in the higher \
level graph and flip their node values. For instance, in some subgraphs, \
yellow nodes may become red, as the global optimization balances local and \
global constraints.\
\>", "Text",
 CellID->246642249,ExpressionUUID->"291c68e0-f532-6cdd-5f23-81cdfcc73627"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"flip", " ", "=", " ", 
   RowBox[{"Keys", "[", 
    RowBox[{"Select", "[", 
     RowBox[{"solution2", ",", " ", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"Rule", "[", 
          RowBox[{"_", ",", " ", "1"}], "]"}]}], "]"}], " ", "&"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"newsolution", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"#", " ", "->", " ", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"as", "[", "#", "]"}]}]}], " ", "&"}], " ", "/@", " ", "\n", 
    "   ", 
    RowBox[{"Keys", "[", 
     RowBox[{"Select", "[", 
      RowBox[{"smallToBig", ",", " ", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"Rule", "[", 
           RowBox[{"_", ",", " ", 
            RowBox[{"Alternatives", " ", "@@", " ", "flip"}]}], "]"}]}], 
         "]"}], " ", "&"}]}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"finalsolution", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{"Association", "[", 
     RowBox[{"Join", " ", "@@", " ", 
      RowBox[{"{", 
       RowBox[{"solution", ",", " ", "newsolution"}], "}"}]}], "]"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{"finalsol", " ", "=", " ", "\n", " ", 
  RowBox[{"HighlightGraph", "[", 
   RowBox[{"g", ",", " ", "\n", "  ", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Subgraph", "[", 
        RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], ",", " ", 
      RowBox[{
       RowBox[{"GatherBy", "[", 
        RowBox[{"finalsolution", ",", " ", "Last"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "All", ",", " ", "1"}], "]"}], "]"}]}], 
     "]"}], ",", "\n", "   ", 
    RowBox[{"VertexLabelStyle", " ", "->", " ", 
     RowBox[{"Directive", "[", 
      RowBox[{"Black", ",", " ", "12"}], "]"}]}], ",", " ", "\n", "  ", 
    RowBox[{"GraphHighlightStyle", " ", "->", " ", "\"\<Thick\>\""}], ",", 
    " ", 
    RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}]}], "Input",
 CellLabel->"In[189]:= ",
 CellID->991699790,ExpressionUUID->"5c29c458-c353-7b98-05d6-de05f6e649e2"],

Cell["Quantum Natural Gradient Descent", "Section",
 CellID->645525702,ExpressionUUID->"6e1a2d6a-d2ad-c32a-1639-c537e759ae70"],

Cell["\<\
Gradient-based optimization methods represent a cornerstone in the field of \
numerical optimization, offering powerful techniques to minimize or maximize \
objective functions in various domains, ranging from machine learning and \
deep learning to physics and engineering. These methods utilize the gradient, \
or derivative, of the objective function with respect to its parameters to \
iteratively update them in a direction that reduces the function's value.\
\>", "Text",
 CellID->1632390239,ExpressionUUID->"6eb5612b-2266-f0f1-164b-79755710c2db"],

Cell["\<\
This section will include a brief introduction to the Gradient Descent \
methods, the Fubini-Study metric tensor and Quantum Natural Gradient Descent. \
We will provide illustrative examples and compare these methods to regular \
gradient descent algorithms.\
\>", "Text",
 CellID->1693358941,ExpressionUUID->"1f4b4965-e043-b514-4549-614e91f71c7e"],

Cell["Quantum Circuit Derivative?", "Subsection",
 CellID->2093346670,ExpressionUUID->"5bf36e21-2d79-2b6f-0980-878b440c79b5"],

Cell[TextData[{
 "Now, you might be wondering: ",
 StyleBox["how do we compute the derivative of a quantum circuit? ", "TI"]
}], "Text",
 CellID->182236639,ExpressionUUID->"6fe9f85b-1ce6-27f0-1596-f20594908dda"],

Cell[TextData[{
 "Great question! While it may seem complex at first, the process is actually \
quite manageable,and, thanks to the ",
 StyleBox["Parameter Shift Rule",
  FontWeight->"Bold"],
 " (PSR), it can even be done analytically!"
}], "Text",
 CellID->2014738409,ExpressionUUID->"3eadea9f-7d43-757d-6652-03d974f65c47"],

Cell["\<\
PSR is a mathematical technique that enables the computation of a quantum \
circuit\[CloseCurlyQuote]s gradient by evaluating the expectation value \
twice, each time with one parameter shifted by a fixed amount.\
\>", "Text",
 CellID->860640743,ExpressionUUID->"68be2dd2-eea3-f2cb-1845-c49f8b57c011"],

Cell[TextData[{
 "The expected value of a circuit in relation to a measurement operator ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1279eb8d-ef8a-5dbb-4206-02d68a3f2781"],
 " varies smoothly with the circuit\[CloseCurlyQuote]s gate parameters ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6afb4307-9f81-9d1b-1a99-5b611a35e461"],
 ":"
}], "Text",
 CellID->815247479,ExpressionUUID->"2e902be9-4fb4-3e90-56af-c2b36a4684fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", "\n", "   ", 
    RowBox[{
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<0\>\"", ",", "\n", "     ", 
         RowBox[{"\"\<0\>\"", " ", "->", " ", 
          RowBox[{"{", "2", "}"}]}], ",", "\n", "     ", 
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<RandomUnitary\>\"", ",", " ", 
           RowBox[{"{", "1", "}"}], ",", " ", 
           RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<Any gate\>\""}]}], 
          "]"}], ",", "\n", "     ", 
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<RandomUnitary\>\"", ",", " ", 
           RowBox[{"{", "2", "}"}], ",", " ", 
           RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<Any gate\>\""}]}], 
          "]"}]}], "}"}], ",", " ", "\n", "    ", 
       RowBox[{"\"\<Label\>\"", " ", "->", 
        " ", "\"\<Initial preparation\>\""}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<PauliZ\>\"", ",", " ", 
          
          RowBox[{"\"\<Label\>\"", " ", "->", 
           " ", "\"\<\!\(\*\nStyleBox[\\\"U\\\",\n\
FontSlant->\\\"Italic\\\"]\)(\[Theta])\>\""}]}], "]"}], "}"}], ",", " ", "\n",
        "    ", 
       RowBox[{"\"\<Label\>\"", " ", "->", 
        " ", "\"\<Gate to be differentiated\>\""}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{
       RowBox[{"{", "\n", "     ", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<RandomUnitary\>\"", ",", " ", 
           RowBox[{"{", "1", "}"}], ",", " ", 
           RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<Any gate\>\""}]}], 
          "]"}], ",", "\n", "     ", 
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<RandomUnitary\>\"", ",", " ", 
           RowBox[{"{", "2", "}"}], ",", " ", 
           RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<Any gate\>\""}]}], 
          "]"}], ",", "\n", "     ", 
         RowBox[{"QuantumMeasurementOperator", "[", 
          RowBox[{"\"\<PauliZ\>\"", ",", " ", 
           RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<A'\>\""}]}], "]"}]}],
         "\n", "     ", "}"}], ",", " ", 
       RowBox[{"\"\<Label\>\"", " ", "->", 
        " ", "\"\<Posterior gates and measurement\>\""}]}], "]"}]}], "\n", 
    "   ", "}"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}], ",", " ", "\n", " ", 
   RowBox[{"\"\<WireLabels\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Placed", "[", 
         RowBox[{"\"\<1st qubit\>\"", ",", " ", "Left"}], "]"}], ",", " ", 
        "\n", "    ", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           
           RowBox[{"\"\<\[LeftAngleBracket] A' \[RightAngleBracket]\>\"", ",",
             " ", "\n", "      ", 
            RowBox[{"FontSize", " ", "->", " ", "20"}]}], "]"}], ",", " ", 
          "Right"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"Placed", "[", 
       RowBox[{"\"\<2nd qubit\>\"", ",", " ", "Left"}], "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[190]:= ",
 CellID->158641381,ExpressionUUID->"46e8ad28-93a4-355d-6e97-457226569fa7"],

Cell[TextData[{
 "Typically, the quantum circuit whose gradient we seek consists of multiple \
gates. Here, we\[CloseCurlyQuote]ll focus on computing the gradient for a \
specific type of unitary gate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Theta]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43090fa7-5002-8b65-7136-a60161b4d64f"],
 "."
}], "Text",
 CellID->1667280292,ExpressionUUID->"0d6689b0-bbf9-a698-3b1d-20fa3d8d0ce2"],

Cell[TextData[{
 "Any unitary gate can be cast in the form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "\[Theta]", "G"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ac87485-b214-a6e0-7ac8-6deec7a60cca"],
 ", where ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e1d4b5-6b25-2976-7e9e-cdff0ed0785c"],
 " is the Hermitian generator of the gate ",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e41722a-1026-02f0-567f-7474a1d350da"],
 ". Then let\[CloseCurlyQuote]s assume that every gate before it is the \
initial state and then every gate after is part of the measurement. Let\
\[CloseCurlyQuote]s call this expected value of A:"
}], "Text",
 CellID->908621377,ExpressionUUID->"6aacec8a-85e6-bbaa-1a53-05d4339009f0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", "\n", "   ", 
    RowBox[{"\"\<0\>\"", ",", "\n", "   ", 
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<RandomUnitary\>\"", ",", " ", "\n", "      ", 
          
          RowBox[{"\"\<Label\>\"", " ", "->", " ", "\n", 
           "       ", "\"\<\!\(\*SuperscriptBox[\(\[ExponentialE]\), \(\
\[ImaginaryI]\[Theta]\[InvisibleComma]\[InvisibleComma]G\)]\)\>\""}]}], "]"}],
         "}"}], ",", " ", "\n", "    ", 
       RowBox[{"\"\<Label\>\"", " ", "->", 
        " ", "\"\<Gate to be differentiated\>\""}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"QuantumMeasurementOperator", "[", 
      RowBox[{"\"\<Computational\>\"", ",", " ", 
       RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<A\>\""}]}], "]"}]}], 
    "\n", "   ", "}"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}], ",", " ", 
   RowBox[{"\"\<ShowMeasurementWire\>\"", " ", "->", " ", "False"}], ",", " ",
    "\n", " ", 
   RowBox[{"\"\<WireLabels\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Placed", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<\[LeftAngleBracket] A \[RightAngleBracket]\>\"", ",", 
         " ", "\n", "     ", 
         RowBox[{"FontSize", " ", "->", " ", "20"}]}], "]"}], ",", " ", 
       "Right"}], "]"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[191]:= ",
 CellID->464822703,ExpressionUUID->"1c51a735-fee5-6802-446e-3f7efa903b68"],

Cell["\<\
In order to apply the parameter shift rule we need to \
\[OpenCurlyDoubleQuote]shift\[CloseCurlyDoubleQuote] our parameter for a \
given value, you can use pi/2. Then we calculate the difference between the \
shifted expected values of A:\
\>", "Text",
 CellID->1062698146,ExpressionUUID->"5e54a15d-ecde-9aa9-066b-39068568e8f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", "\n", "   ", 
    RowBox[{"\"\<0\>\"", ",", "\n", "   ", 
     RowBox[{"QuantumCircuitOperator", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<RandomUnitary\>\"", ",", " ", "\n", "     ", 
         RowBox[{"\"\<Label\>\"", " ", "->", " ", "\n", 
          "      ", "\"\<\!\(\*SuperscriptBox[\(\[ExponentialE]\), \(\
\[ImaginaryI]\:f88c \((\[InvisibleComma]\(\[Theta]\\\  \[PlusMinus] \\\ \
\*FractionBox[\(\[Pi]\), \(2\)]\)\(\[InvisibleComma]\))\) G\)]\)\>\""}]}], 
        "]"}], ",", " ", 
       RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<PSR Gate\>\""}]}], "]"}],
      ",", "\n", "   ", 
     RowBox[{"QuantumMeasurementOperator", "[", 
      RowBox[{"\"\<Computational\>\"", ",", " ", "\n", "    ", 
       RowBox[{"\"\<Label\>\"", " ", "->", 
        " ", "\"\<A(\[Theta]\[ImplicitPlus] \[PlusMinus] \[Pi]/2)\>\""}]}], 
      "]"}]}], "\n", "   ", "}"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"\"\<ShowMeasurementWire\>\"", " ", "->", " ", "False"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}], ",", " ", "\n", " ", 
   RowBox[{"\"\<WireLabels\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Placed", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<\[LeftAngleBracket]\!\(\*SubscriptBox[\(r\), \(\
\[PlusMinus]\)]\)\[RightAngleBracket]\>\"", ",", " ", 
         RowBox[{"FontSize", " ", "->", " ", "20"}]}], "]"}], ",", " ", 
       "Right"}], "]"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[192]:= ",
 CellID->1311737908,ExpressionUUID->"27fb6428-ecec-27d4-4d99-7e75849e8d3e"],

Cell[TextData[{
 "The parameter\[Dash]shift rule states that in order to obtain the \
derivative ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[Del]", 
    StyleBox["\[Theta]", "TI"]], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51f5ca74-88a2-9d2c-078a-ec3e2954e476"],
 " from gate ",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1154648e-ef0b-aa2b-476c-7deb8abff971"],
 ", we need to compute:"
}], "Text",
 CellID->2019184821,ExpressionUUID->"4c057904-8649-af2b-743b-716e33fdf271"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Del]", 
     StyleBox["\[Theta]", "TI"]], 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], "\[VeryThinSpace]", 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "\[ThinSpace]", 
     RowBox[{
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["A", "TI"], 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         StyleBox["\[Theta]", "TI"], "+", 
         FractionBox["\[Pi]", "2"]}], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], "-", 
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["A", "TI"], 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         StyleBox["\[Theta]", "TI"], "-", 
         FractionBox["\[Pi]", "2"]}], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]}], "\[ThinSpace]", 
     StyleBox[")",
      SpanMaxSize->1]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1233152777,ExpressionUUID->"2baf9433-2e90-ebaf-5954-0e7d4b2ab9f5"],

Cell["\<\
Let\[CloseCurlyQuote]s say that we have this simple circuit with a rotation \
in x with a measurement in Z:\
\>", "Text",
 CellID->157440270,ExpressionUUID->"340e6ec8-e38f-b030-5c35-8795963b031a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"RXCircuit", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], ",", " ", "\n", "    ", 
       RowBox[{"QuantumMeasurementOperator", "[", 
        RowBox[{"\"\<Z\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "}"}], ",", " ", "\n", 
     "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", "\[Theta]", "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"RXCircuit", "[", "\[Theta]", "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]}], "Input",
 CellLabel->"In[193]:= ",
 CellID->1244108099,ExpressionUUID->"64bff79f-1679-3ebc-0c44-eed9a30d8486"],

Cell["If we check the mean value it is:", "Text",
 CellID->424072762,ExpressionUUID->"126dc52b-3dd5-bd31-4212-dd75b461041b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"RXCircuit", "[", "\[Theta]", "]"}], "[", "]"}], 
    "[", "\"\<Mean\>\"", "]"}], " ", "//", " ", "ComplexExpand"}], " ", "//", 
  " ", "Simplify"}]], "Input",
 CellLabel->"In[194]:= ",
 CellID->1878258118,ExpressionUUID->"28023c0b-10a3-7000-5831-b655a156436a"],

Cell["\<\
Applying the parameter shift rule shows that indeed we obtain the derivative:\
\
\>", "Text",
 CellID->1858767312,ExpressionUUID->"4f1b960d-0301-b7cd-7538-0857b6b51d17"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"RXCircuit", "[", 
         RowBox[{"\[Theta]", " ", "+", " ", 
          RowBox[{"\[Pi]", "/", "2"}]}], "]"}], "[", "]"}], 
       "[", "\"\<Mean\>\"", "]"}], " ", "-", " ", "\n", "     ", 
      RowBox[{
       RowBox[{
        RowBox[{"RXCircuit", "[", 
         RowBox[{"\[Theta]", " ", "-", " ", 
          RowBox[{"\[Pi]", "/", "2"}]}], "]"}], "[", "]"}], 
       "[", "\"\<Mean\>\"", "]"}]}], ")"}]}], " ", "//", " ", "\n", "  ", 
   "ComplexExpand"}], " ", "//", " ", "Simplify"}]], "Input",
 CellLabel->"In[195]:= ",
 CellID->1848694443,ExpressionUUID->"268b8fe7-2cf2-fa64-4e88-26c14484c94e"],

Cell["\<\
The main benefit of Parameter Shift Rule is that it enables the use of the \
Gradient Descent optimizer for variational circuits.\
\>", "Text",
 CellID->1036696308,ExpressionUUID->"41763b34-5a53-ec31-770d-b37e5fe7b71b"],

Cell["Stochastic Parameter Shift\[Dash]Rule", "Subsubsection",
 CellID->261326684,ExpressionUUID->"5d61c4f4-c0fb-847a-0b1e-ddb1f08fef40"],

Cell["\<\
The Stochastic Parameter Shift Rule (SPSR) represents a powerful optimization \
technique specifically tailored for parameterized quantum circuits. Unlike \
conventional gradient-based methods, SPSR offers a stochastic approach to \
computing gradients, making it particularly well-suited for scenarios \
involving noisy quantum devices or large-scale quantum circuits. At its core, \
SPSR leverages the principles of quantum calculus to estimate gradients by \
probabilistically sampling from parameter space and evaluating the quantum \
circuit's expectation values. By incorporating random perturbations in \
parameter values and exploiting symmetry properties, SPSR effectively \
mitigates the detrimental effects of noise and provides robust optimization \
solutions.\
\>", "Text",
 CellID->725818167,ExpressionUUID->"72fe9a0c-0c49-239f-2285-1c56a5fc71e5"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "14bcbead-0cb8-f132-3c43-37f7a532c018"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"4a015340-38cc-91ca-7a3f-4b2ab97ee310"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"44807b7f-366d-41a7-6cb0-73394318138d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "56b5d630-2397-dc8b-7e4a-c87a5623a6d1"], Cell[TextData[Cell[BoxData[
     RowBox[{"SPSRGradientValues", "[", 
      RowBox[{
       RowBox[{"GeneratorMatrix", "[", "\[Theta]", "]"}], ",", " ", 
       "PauliOperator"}], "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "066e8396-42fa-b64f-2e15-1ad0768c1c95"]], "TableText",ExpressionUUID->
     "0fee4e15-659c-ade9-3596-605f0c2ef733"], Cell["\<\
calculates the numeric derivative of a QuantumOperator corresponding to the \
Hermitian GeneratorMatrix. The PauliOperator correspond to the parameter \
\[Theta] being differentiated.\
\>", "TableText",ExpressionUUID->"6f99faa1-7599-adaa-15a6-f30b7c2df7f0"]}
  }]], "2ColumnTableMod",
 CellID->247262320,ExpressionUUID->"6c80f068-193e-1d5a-14bf-ea3298cb67a0"],

Cell["\<\
By the other hand, the Approximate Stochastic Parameter Shift Rule (ASPSR) \
emerges as a pragmatic solution to address the computational complexity \
associated with exact Stochastic Parameter Shift Rule (SPSR) calculations, \
particularly in scenarios involving high-dimensional parameter spaces or \
resource-constrained environments. ASPSR strategically balances computational \
efficiency with optimization accuracy by employing approximation techniques \
to streamline gradient estimation procedures. By leveraging simplified or \
truncated calculations while preserving the essential characteristics of \
SPSR, ASPSR facilitates faster gradient computations without significantly \
compromising optimization quality.\
\>", "Text",
 CellID->640211720,ExpressionUUID->"77601adb-bf25-4789-1d1f-93853ad02dd3"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "48b830c7-d270-6a57-7847-a9a0e70538bd"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"62f1d7f5-6807-0c72-128e-cebf09b25758"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"1e2af966-75ba-f15e-4629-f1407c4cc3a4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7fcb302b-9e92-9019-25c8-aa751b24e363"], Cell[TextData[Cell[BoxData[
     RowBox[{"ASPSRGradientValues", "[", 
      RowBox[{
       RowBox[{"GeneratorMatrix", "[", "\[Theta]", "]"}], ",", " ", 
       "PauliOperator", ",", "H"}], "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "361ba0ac-b25b-03c3-5e38-3909c7ee5129"]], "TableText",ExpressionUUID->
     "36c5768f-9366-0c29-5efb-6fe926135773"], Cell["\<\
calculates the approximate derivative of a QuantumOperator corresponding to \
the Hermitian GeneratorMatrix. The PauliOperator correspond to the parameter \
\[Theta] being differentiated and H correspond to the operator associated \
with different parameters.\
\>", "TableText",ExpressionUUID->"43fcd6d4-594a-1482-7183-cf9e58ff7ee8"]}
  }]], "2ColumnTableMod",
 CellID->725710883,ExpressionUUID->"4719bc21-ede2-73f0-6d26-358a8b9741da"],

Cell["Example using SPSRGradientValues", "Subsubsection",
 CellID->1916800065,ExpressionUUID->"71a147e0-ad25-39c0-275f-5ecdc4d18b2a"],

Cell["For this example we will use the following generator:", "Text",
 CellID->11650839,ExpressionUUID->"0d94734f-f5fd-5b1e-3bac-6b2883882664"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   SubscriptBox[
    StyleBox["G", "TI"], 
    StyleBox[
     RowBox[{"C", "R"}], "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Theta]", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["\[Theta]", "TI"], "2"], ",", 
    SubscriptBox[
     StyleBox["\[Theta]", "TI"], "3"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], "1"], 
   StyleBox["X", "TI"], "\[CircleTimes]", "\|01d7d9", "\[ThinSpace]", "-", 
   "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], "2"], "\[ThinSpace]", 
   StyleBox["Z", "TI"], "\[CircleTimes]", 
   StyleBox["X", "TI"], "\[ThinSpace]", "+", "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], "3"], "\[ThinSpace]", "\|01d7d9", "\[CircleTimes]", 
   StyleBox["X", "TI"]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->397994562,ExpressionUUID->"4a66d044-93ea-cfa5-7a1d-ca2e259c958f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generator", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Theta]1", "*", "\n", "      ", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<X\>\"", " ", "->", " ", 
            RowBox[{"{", "1", "}"}]}], ",", " ", 
           RowBox[{"\"\<I\>\"", " ", "->", " ", 
            RowBox[{"{", "2", "}"}]}]}], "}"}], "]"}]}], " ", "-", " ", 
       RowBox[{"\[Theta]2", "*", "\n", "      ", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<Z\>\"", " ", "->", " ", 
            RowBox[{"{", "1", "}"}]}], ",", " ", 
           RowBox[{"\"\<X\>\"", " ", "->", " ", 
            RowBox[{"{", "2", "}"}]}]}], "}"}], "]"}]}], " ", "+", " ", 
       RowBox[{"\[Theta]3", "*", "\n", "      ", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<I\>\"", " ", "->", " ", 
            RowBox[{"{", "1", "}"}]}], ",", " ", 
           RowBox[{"\"\<X\>\"", " ", "->", " ", 
            RowBox[{"{", "2", "}"}]}]}], "}"}], "]"}]}]}], ")"}], ",", " ", 
     "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[Theta]1", ",", " ", "\[Theta]2", ",", " ", "\[Theta]3"}], 
       "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[196]:= ",
 CellID->486553936,ExpressionUUID->"08e3a6ae-198b-2f89-3890-3f08983e75d3"],

Cell["\<\
We will differentiate \[Theta]1. Implement the correspondant matrix fixing \
other parameters:\
\>", "Text",
 CellID->25801152,ExpressionUUID->"07ff9e3d-196e-b566-2d84-106798181c4c"],

