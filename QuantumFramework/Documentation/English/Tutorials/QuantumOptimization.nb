 CellID->1914258213,ExpressionUUID->"0249f5b1-f79b-eab1-3276-ecfa822fb89b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LocalHadamardState", " ", "=", " ", 
   RowBox[{"LocalHadamardCircuit", "[", "]"}]}], ";"}]], "Input",
