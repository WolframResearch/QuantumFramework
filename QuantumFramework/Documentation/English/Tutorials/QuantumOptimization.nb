Cell["Find the Max-Cut for the following graph:", "Text",
 CellID->60502313,ExpressionUUID->"79e9b65a-67eb-1624-2f96-2804119e7d0e"],

Cell[BoxData[
 RowBox[{"g3", " ", "=", " ", 
  RowBox[{"Graph", "[", 
   RowBox[{
    RowBox[{"Range", "[", "5", "]"}], ",", " ", "\n", "  ", 
    RowBox[{"UndirectedEdge", " ", "@@@", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "\n", "     ", "5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "6"}], "}"}]}], "}"}]}], ",", " ", 
    RowBox[{"GraphStyle", " ", "->", " ", "\"\<NameLabeled\>\""}], ",", " ", 
    "\n", "  ", 
    RowBox[{"EdgeStyle", " ", "->", " ", 
