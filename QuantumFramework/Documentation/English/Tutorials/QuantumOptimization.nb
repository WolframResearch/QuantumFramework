         RowBox[{"White", ",", " ", 
          RowBox[{"{", 
           RowBox[{"None", ",", " ", 
            RowBox[{"Lighter", "[", 
             RowBox[{"Yellow", ",", " ", ".9"}], "]"}]}], "}"}]}], "}"}]}], ",",
