       RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}], " ", "&"}], "@",
     "\n", "   ", "bigedges"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ggg", " ", "=", " ", 
   RowBox[{"Show", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{"{", "\n", "      ", 
        RowBox[{
         RowBox[{"Hue", "[", 
          RowBox[{
          "0.15", ",", " ", "0.82", ",", " ", "0.87", ",", " ", "0.4"}], 
          "]"}], ",", " ", 
         RowBox[{"Disk", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1.7", ",", " ", "0.5"}], "}"}], ",", " ", "0.8"}], "]"}],
          ",", "\n", "      ", 
         RowBox[{"Hue", "[", 
          RowBox[{"0", ",", " ", "0.57", ",", " ", "0.78", ",", " ", "0.4"}], 
