Cell["\<\
In this more challenging example, we have a graph with six nodes, which \
results in a much larger cost Hamiltonian:\
\>", "Text",
 CellID->1160487429,ExpressionUUID->"5d3de1d4-e864-19c9-04c2-f89189116b13"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"index3", " ", "=", " ", 
   RowBox[{
    RowBox[{"MapApply", "[", 
     RowBox[{"List", ",", " ", 
      RowBox[{"EdgeRules", "[", "g3", "]"}]}], "]"}], " ", "/.", " ", 
    RowBox[{"x_Integer", " ", ":>", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "x"}], "}"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"op\[DoubleStruckOne]3", " ", "=", " ", 
   RowBox[{"StringRepeat", "[", 
    RowBox[{"\"\<I\>\"", ",", " ", 
     RowBox[{"VertexCount", "[", "g3", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"sum3", " ", "=", " ", 
  RowBox[{"Total", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{"op\[DoubleStruckOne]3", " ", "-", " ", "\n", "       ", 
        RowBox[{"StringReplacePart", "[", 
         RowBox[{
         "op\[DoubleStruckOne]3", ",", " ", "\"\<Z\>\"", ",", " ", "#"}], 
         "]"}]}], ")"}]}], " ", "&"}], " ", "/@", " ", "index3"}], 
   "]"}]}]}], "Input",
 CellLabel->"In[158]:= ",
 CellID->958824893,ExpressionUUID->"1adc8861-0296-99d3-4ae3-224bb720eb39"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Hc3", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", "sum3", "]"}]}], ";"}], "\n", 
 RowBox[{"ArrayPlot", "[", 
  RowBox[{
   RowBox[{"Hc3", "[", "\"\<Matrix\>\"", "]"}], ",", " ", 
   RowBox[{"ColorFunction", " ", "->", " ", "\"\<IslandColors\>\""}], ",", 
   " ", "\n", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]}], "Input",
 CellLabel->"In[159]:= ",
 CellID->1943573055,ExpressionUUID->"47f3727e-1788-b883-6d81-7438a2220ae9"],

Cell[TextData[{
 "Implement directly the QAOA circuit using the ",
 StyleBox["Graph ",
  FontWeight->"Bold"],
 "functionalities:"
}], "Text",
 CellID->1853692184,ExpressionUUID->"02bfa0ec-e0fe-2fa7-3244-39c9908b758d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qaoa3", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<0\>\"", " ", "->", " ", 
        RowBox[{"VertexList", "[", "g3", "]"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<H\>\"", " ", "->", " ", 
        RowBox[{"VertexList", "[", "g3", "]"}]}], ",", "\n", "    ", 
       RowBox[{"Sequence", " ", "@@", " ", "\n", "     ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             
             RowBox[{"\"\<R\>\"", ",", " ", "\[Gamma]", ",", 
              " ", "\"\<ZZ\>\""}], "}"}], " ", "->", " ", "#"}], " ", "&"}], ",",
           " ", 
          RowBox[{"List", " ", "@@@", " ", 
           RowBox[{"EdgeList", "[", "g3", "]"}]}]}], "]"}]}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], " ", "->", " ", 
        RowBox[{"VertexList", "[", "g3", "]"}]}]}], "\n", "    ", "}"}], ",", 
     "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "None"}], ",", " ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", " ", "\[Gamma]"}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[160]:= ",
 CellID->1053005417,ExpressionUUID->"7cc1833e-1ead-5711-24fe-1b789b583a7b"],

Cell[BoxData[
 RowBox[{"qaoa3", "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[161]:= ",
 CellID->88614423,ExpressionUUID->"3cb4236e-91b2-9328-644b-bb482044fe72"],

Cell["\<\
Implement the symbolic cost function using the Cost Hamiltonian and the \
resulting parametrized state from the previous circuit:\
\>", "Text",
 CellID->1704626979,ExpressionUUID->"631da35c-735e-7e3b-1122-3b0606eb4501"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ket", "[", 
     RowBox[{"{", "\[Phi]3", "}"}], "]"}], " ", "=", " ", 
    RowBox[{"qaoa3", "[", "]"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Bra", "[", 
    RowBox[{"{", "\[Phi]3", "}"}], "]"}], " ", "=", " ", 
   RowBox[{"SuperDagger", "[", 
    RowBox[{"Ket", "[", 
     RowBox[{"{", "\[Phi]3", "}"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[162]:= ",
 CellID->2144568247,ExpressionUUID->"44b7daea-ed84-b50e-6c4c-d3b784361c54"],

Cell[BoxData[
 RowBox[{"costfunction3", " ", "=", " ", "\n", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"\"\<Scalar\>\"", " ", "//", " ", 
     RowBox[{
      RowBox[{"Bra", "[", 
       RowBox[{"{", "\[Phi]3", "}"}], "]"}], "@", 
      RowBox[{"Hc3", "@", 
       RowBox[{"Ket", "[", 
        RowBox[{"{", "\[Phi]3", "}"}], "]"}]}]}]}], " ", "//", " ", 
    "ComplexExpand"}], " ", "//", " ", "\n", "  ", "Simplify"}]}]], "Input",
 CellLabel->"In[163]:= ",
 CellID->1920423021,ExpressionUUID->"39f2334d-24de-3dcb-6f81-ab174d688711"],

Cell[TextData[{
 "Use ",
 StyleBox["NMaximize",
  FontWeight->"Bold"],
 " for the optimization:"
}], "Text",
 CellID->1790270308,ExpressionUUID->"1ec600b7-0050-8550-46fd-99f1b1eaefba"],

Cell[BoxData[
 RowBox[{"result3", " ", "=", " ", 
  RowBox[{"NMaximize", "[", 
   RowBox[{"costfunction3", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", " ", "\[Gamma]"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[164]:= ",
 CellID->2141927324,ExpressionUUID->"33bfe66e-cd59-d601-6144-f84be4edbd6b"],

Cell["\<\
We obtain multiple possible solutions; however, with just a single QAOA \
layer, we observe four solutions with higher probability:\
\>", "Text",
 CellID->1696359460,ExpressionUUID->"6a3ee8c1-8740-e1ad-1bc5-01ab32fab3f7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"qaoa3", " ", "@@", " ", 
    RowBox[{"Values", "[", 
     RowBox[{"Last", "[", "result3", "]"}], "]"}]}], ")"}], "[", 
  RowBox[{"\"\<ProbabilityPlot\>\"", ",", " ", 
   RowBox[{"BarOrigin", " ", "->", " ", "Left"}], ",", "\n", "  ", 
   RowBox[{"\"\<Range\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{".02", ",", " ", "1"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[165]:= ",
 CellID->1249186605,ExpressionUUID->"33885b0f-111a-0c54-6188-5369a0af56be"],

Cell["Solve it clasically:", "Text",
 CellID->963265468,ExpressionUUID->"5c9080a8-67dd-9047-04af-19f21269e2ad"],

Cell[BoxData[
 RowBox[{"FindMaximumCut", "[", "g3", "]"}]], "Input",
 CellLabel->"In[166]:= ",
 CellID->8971482,ExpressionUUID->"2abc9d06-0494-496b-5a43-1560ad211bb1"],

Cell["\<\
The quantum algorithm does not achieve the maximum value compared to the \
classical solution, but we can analyze the four most probable solutions \
indicated by the ProbabilityPlot:\
\>", "Text",
 CellID->823701889,ExpressionUUID->"43e301a0-76bb-1057-7190-980a034e62bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReverseSortBy", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"qaoa3", " ", "@@", " ", 
        RowBox[{"Values", "[", 
         RowBox[{"Last", "[", "result3", "]"}], "]"}]}], ")"}], 
      "[", "\"\<Probabilities\>\"", "]"}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"#", "[", 
      RowBox[{"[", "\n", "    ", "2", "]"}], "]"}], " ", "&"}]}], "]"}], "[", 
  
  RowBox[{"[", 
   RowBox[{";;", " ", "4"}], "]"}], "]"}]], "Input",
 CellLabel->"In[167]:= ",
 CellID->992310483,ExpressionUUID->"1ae06f2b-7109-3ba5-4a9f-877500bd898f"],

Cell[TextData[{
 "Following the labels in the vertex, the solution ",
 Cell[BoxData[
  TemplateBox[{"010011"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0856a555-3f58-6085-386d-3d1fbaed32ef"],
 " is the one found by the classical method. The following diagram \
corresponds to this solution:"
}], "Text",
 CellID->716640429,ExpressionUUID->"71eecbe3-9be0-9ba6-2795-e2cd1d9ae98c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"maxcut3", " ", "=", " ", "\n", " ", 
   RowBox[{"HighlightGraph", "[", 
    RowBox[{"g3", ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Subgraph", "[", 
         RowBox[{"g3", ",", " ", "#1"}], "]"}], " ", "&"}], ")"}], " ", "/@", 
      " ", 
      RowBox[{"Last", "[", 
       RowBox[{"FindMaximumCut", "[", "g3", "]"}], "]"}]}], ",", " ", "\n", 
     "  ", 
     RowBox[{"VertexLabels", " ", "->", " ", "\n", "   ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Thread", " ", "/@", " ", "\n", "     ", 
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"Last", "[", "\n", "        ", 
           RowBox[{"FindMaximumCut", "[", "$CellContext`g2", "]"}], "]"}], 
          " ", "->", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Placed", "[", 
              RowBox[{"#1", ",", " ", "\n", "           ", "Center"}], "]"}], 
             " ", "&"}], " ", ")"}], " ", "/@", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "1"}], "}"}]}]}], "]"}]}], "]"}]}]}], 
    "]"}]}], ";", " ", 
  RowBox[{"cut3", " ", "=", " ", "\n", " ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"maxcut3", ",", " ", "\n", "   ", 
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{"Red", ",", " ", "Dashed", ",", " ", "\n", "     ", 
          RowBox[{"BSplineCurve", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "0.1"}], ",", " ", "2"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"2.2", ",", " ", 
               RowBox[{"-", "2.7"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"1.5", ",", " ", "2"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"2.4", ",", " ", "0.7"}], "}"}]}], "}"}], "]"}]}], 
         "}"}], "]"}]}], "}"}], ",", " ", "\n", "  ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.2"}], ",", " ", "3.5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.2"}], ",", " ", "1.5"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"GraphicsColumn", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g3", ",", " ", "cut3"}], "}"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], "Input",
 CellLabel->"In[168]:= ",
 CellID->17477376,ExpressionUUID->"59070895-187c-42ea-0f3c-a1df99091030"],

Cell["QAOA-in-QAOA", "Subsubsection",
 CellID->264643262,ExpressionUUID->"189fe470-6cd8-7cf4-48a4-fe3a056d46de"],

Cell["\<\
To tackle large graphs, we use a method called QAOA-in-QAOA, inspired by the \
Divide and Conquer algorithm.\
\>", "Text",
 CellID->945138026,ExpressionUUID->"04ed2843-d86c-272a-2c92-c22cd91e8a70"],

Cell["Here\[CloseCurlyQuote]s the idea:", "Text",
 CellID->1341477503,ExpressionUUID->"70d9e217-b7c7-416b-20e6-0450c27213b1"],

Cell["First, we partition the graph into smaller subgraphs.", "Item",
 CellID->239206043,ExpressionUUID->"29221b72-bc55-8ef4-58d1-933c35e1d4de"],

Cell["\<\
Next, we solve a mini-QAOA on each subgraph and combine the solutions.\
\>", "Item",
 CellID->1190015767,ExpressionUUID->"41172bde-c012-830e-772c-c29bf1a4ee54"],

Cell["\<\
Then, to correct any possible issue with the solutions between the subgraphs, \
we treat each subgraph as a node in a new coarse-grained graph.\
\>", "Item",
 CellID->1716457709,ExpressionUUID->"3dd84232-0c35-660d-6bf8-647ca5c04d57"],

Cell["\<\
Finally, we apply QAOA again to this higher-level graph and correct the final \
solution.\
\>", "Item",
 CellID->1915956100,ExpressionUUID->"5558c8fc-3d33-9e90-0367-e1a6b4c7e4fa"],

Cell["\<\
This process is recursive and scalable, making it suitable for large problem \
instances.\
\>", "Text",
 CellID->586453305,ExpressionUUID->"53291d47-a111-bd44-02d6-9520d0a507ae"],

Cell["\<\
Now let\[CloseCurlyQuote]s see how the Wolfram Quantum Framework enables us \
to symbolically model and analyze this algorithm. Given the following graph:\
\>", "Text",
 CellID->1409766990,ExpressionUUID->"14460f59-6b0f-818e-3c7d-a7030ebbd3d4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[ScriptX]1", " ", "=", " ", "\n", "  ", 
   RowBox[{"UndirectedEdge", " ", "@@@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[ScriptX]2", " ", "=", " ", "\n", "  ", 
   RowBox[{"UndirectedEdge", " ", "@@@", " ", 
    RowBox[{"(", 
     RowBox[{"4", " ", "+", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "\n", "       ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[ScriptX]3", " ", "=", " ", 
   RowBox[{"UndirectedEdge", " ", "@@@", " ", 
    RowBox[{"(", 
     RowBox[{"8", " ", "+", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "1"}], "}"}]}], "}"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[ScriptX]4", " ", "=", " ", 
   RowBox[{"UndirectedEdge", " ", "@@@", " ", 
    RowBox[{"(", 
     RowBox[{"11", " ", "+", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "}"}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"connection", " ", "=", " ", "\n", "  ", 
   RowBox[{"UndirectedEdge", " ", "@@@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "11"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"10", ",", " ", "7"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "12"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"13", ",", " ", "5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "7"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "\n", "     ", "8"}], "}"}]}], "}"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"edges", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "\[ScriptX]1", ",", " ", "\[ScriptX]2", ",", " ", "\[ScriptX]3", ",", " ",
      "\[ScriptX]4"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fullEdges", " ", "=", " ", "\n", "  ", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[ScriptX]4", ",", " ", "\[ScriptX]2", ",", " ", "\[ScriptX]1", ",", 
        " ", "\[ScriptX]3"}], "}"}], ",", " ", "\n", "    ", "connection"}], 
     "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"g", " ", "=", " ", 
  RowBox[{"Graph", "[", 
