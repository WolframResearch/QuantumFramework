  ";"}]], "Input",
 CellLabel->"In[365]:= ",
 CellID->735862608,ExpressionUUID->"16d64695-ef97-7390-3eee-5fde8a2241fa"],

Cell[TextData[{
 "Since it can be a heavy computation, we will compute the state vector \
variations on the variables that are not part of the Variational Circuit ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "492272d1-18a5-64bf-78d2-6b9b99504e85"],
 ". Remember that ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f8fc6a3-d6eb-41c0-45b4-df0ce29e132a"],
 " and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"l", "p"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "740a6ce3-9f6e-a7ea-1c09-85cd1a180d30"],
 " correspond to the controlled ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["A", "TI"], 
   StyleBox["l", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "355eb3db-64ad-28a6-6365-2a850d587a8c"],
 " gates index (from 2 to 5) and ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "224bec90-94dc-e798-5248-05da1d6ecde2"],
 " to the qubits (from 2 to 4 and -1 for the normalization term):"
}], "Text",
 CellID->138465164,ExpressionUUID->"19da10ea-d928-9e66-4ff9-89b7d8c2e54c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LocalHadamardStateVectors", " ", "=", " ", 
    RowBox[{"Association", "@", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"Rule", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[DoubleStruckL]", ",", " ", "\[DoubleStruckL]\[DoubleStruckP]", ",",
            " ", 
           RowBox[{"\\\n", "\[DoubleStruckJ]"}]}], "}"}], ",", " ", "\n", 
         "      ", 
         RowBox[{"N", "@", 
          RowBox[{"Replace", "[", "\n", "        ", 
           RowBox[{"LocalHadamardStateVector", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"l", " ", "->", " ", "\[DoubleStruckL]"}], ",", " ", 
              "\n", "         ", 
              RowBox[{
              "lp", " ", "->", " ", "\[DoubleStruckL]\[DoubleStruckP]"}], ",",
               " ", "\n", "         ", 
              RowBox[{"j", " ", "->", " ", "\[DoubleStruckJ]"}]}], "}"}], ",",
             " ", 
            RowBox[{"{", 
             RowBox[{"7", ",", " ", "12"}], "}"}]}], "]"}]}]}], "]"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"\[DoubleStruckL]", ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "2", ",", " ", "3", ",", " ", "4", ",", " ", "\n", "       ", "5"}],
           "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[DoubleStruckL]\[DoubleStruckP]", ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "2", ",", " ", "3", ",", " ", "4", ",", " ", "\n", "       ", "5"}],
           "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[DoubleStruckJ]", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "2", ",", " ", "3", ",", " ", "4"}], 
          "}"}]}], "}"}]}], "]"}]}]}], ";"}], " ", "//", " ", 
  "AbsoluteTiming"}]], "Input",
 CellLabel->"In[366]:= ",
 CellID->605137979,ExpressionUUID->"6cf78db7-632c-d0e2-148c-24f116dea2c8"],

Cell["\<\
Now we will implement the functions to calculate the local cost for this \
circuit:\
\>", "Text",
 CellID->1555423883,ExpressionUUID->"634058bc-0e0e-c957-1170-51e6abb89bbd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<Z\>\"", " ", "->", " ", 
         RowBox[{"{", "1", "}"}]}], ",", " ", 
        RowBox[{"\"\<I\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}]}], "}"}], 
      "]"}], "[", "\"\<Matrix\>\"", "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[367]:= ",
 CellID->931568852,ExpressionUUID->"187ea1f6-0b66-2b61-4805-38b0ae13764b"],

Cell[TextData[{
 "In this LocalHadamardMeanValues version, we call ",
 StyleBox["LocalHadamardStateVectors[",
  FontWeight->"Bold"],
 StyleBox["{l, lp, j}", "TI"],
 "] for the state vector already computed to save time per each execution of ",
 StyleBox["LocalCost",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellID->227081211,ExpressionUUID->"6a5920d9-eb16-a7a4-1a66-b9828ea00d8e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "LocalHadamardMeanValues", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"LocalHadamardMeanValues", "[", 
   RowBox[{
   "v1_", ",", " ", "v2_", ",", " ", "v3_", ",", " ", "v4_", ",", " ", "v5_", 
    ",", " ", "v6_", ",", " ", "v7_", ",", " ", "v8_", ",", " ", "v9_", ",", 
    " ", "\n", "  ", "l_", ",", " ", "lp_", ",", " ", "j_"}], "]"}], " ", ":=",
   " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ket", ",", " ", "bra"}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"ket", " ", "=", " ", 
      RowBox[{"Replace", "[", 
       RowBox[{
        RowBox[{"LocalHadamardStateVectors", "[", 
         RowBox[{"{", 
          RowBox[{"l", ",", " ", "lp", ",", " ", "j"}], "}"}], "]"}], ",", 
        " ", "\n", "    ", 
        RowBox[{"Thread", "[", 
         RowBox[{"Rule", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\[Omega]3", ",", 
             " ", "\[Omega]4", ",", " ", 
             RowBox[{"\\\n", "\[Omega]5"}], ",", " ", "\[Omega]6", ",", " ", 
             "\[Omega]7", ",", " ", "\[Omega]8", ",", " ", "\[Omega]9"}], 
            "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
            "v1", ",", " ", "v2", ",", " ", "v3", ",", " ", "\n", "       ", 
             "v4", ",", " ", "v5", ",", " ", "v6", ",", " ", "v7", ",", " ", 
             "v8", ",", " ", "v9"}], "}"}]}], "]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "23"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"bra", " ", "=", " ", 
      RowBox[{"ConjugateTranspose", "[", "ket", "]"}]}], ";", "\n", "  ", 
     RowBox[{"bra", " ", ".", " ", "H", " ", ".", " ", "ket"}]}]}], "\n", 
   "  ", "]"}]}]}], "Input",
 CellLabel->"In[368]:= ",
 CellID->1137764648,ExpressionUUID->"09f2771d-8da8-86b6-3f82-6f472442ec9c"],

Cell[TextData[{
 "Define ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Mu]", "TI"], 
   RowBox[{
    StyleBox["l", "TI"], ",", 
    StyleBox["v", "TI"], ",", 
    StyleBox["j", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eae7486-c77b-107a-5656-6de3f20e6340"],
 " :"
}], "Text",
 CellID->1622709399,ExpressionUUID->"58a71232-b93f-0bc4-085c-947c38ca592e"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\[Mu]", "]"}], "\n", 
 RowBox[{
  RowBox[{"\[Mu]", "[", 
   RowBox[{
   "v1_", ",", " ", "v2_", ",", " ", "v3_", ",", " ", "v4_", ",", " ", "v5_", 
    ",", " ", "v6_", ",", " ", "v7_", ",", " ", "v8_", ",", " ", "v9_", ",", 
    " ", "l_", ",", " ", "lp_", ",", " ", "j_"}], "]"}], " ", ":=", " ", "\n",
   " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mu", ",", " ", "\[Mu]Re", ",", " ", "\[Mu]Im"}], "}"}], ",", 
    "\n", "  ", 
    RowBox[{
     RowBox[{"mu", " ", "=", " ", 
      RowBox[{"LocalHadamardMeanValues", "[", 
       RowBox[{
       "v1", ",", " ", "v2", ",", " ", "v3", ",", " ", "v4", ",", " ", "v5", ",",
         " ", "v6", ",", " ", "v7", ",", " ", "v8", ",", " ", "v9", ",", " ", 
        "l", ",", " ", "\n", "    ", "lp", ",", " ", "j"}], "]"}]}], ";", 
     "\n", "  ", 
     RowBox[{"\[Mu]Re", " ", "=", " ", 
      RowBox[{"Replace", "[", 
       RowBox[{"mu", ",", " ", 
        RowBox[{"\[Theta]", " ", "->", " ", "0"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"\[Mu]Im", " ", "=", " ", 
      RowBox[{"Replace", "[", 
       RowBox[{"mu", ",", " ", 
        RowBox[{"\[Theta]", " ", "->", " ", 
         RowBox[{
          RowBox[{"-", "\[Pi]"}], "/", "2"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"N", "[", 
      RowBox[{"\[Mu]Re", " ", "+", " ", 
       RowBox[{"j", " ", "\[Mu]Im"}]}], "]"}]}]}], "\n", "  ", 
   "]"}]}]}], "Input",
 CellLabel->"In[369]:= ",
 CellID->1483750552,ExpressionUUID->"0590db7a-de3c-d1b6-33af-d327dbcea39c"],

Cell["Implement the normalization term:", "Text",
 CellID->970734650,ExpressionUUID->"2f6adbb8-aab7-c223-5569-d2e5cf439109"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0", ",", " ", "0.75", ",", " ", "0.0625", ",", " ", "0.0625", ",", " ", 
     "0.125"}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[370]:= ",
 CellID->416326014,ExpressionUUID->"360b7cf2-7095-e6b8-5e09-75bc0121cc82"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "PsiNorm", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PsiNorm", "[", 
    RowBox[{
     RowBox[{"w1_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"w2_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"w3_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"w4_", "?", "NumericQ"}], ",", " ", "\n", "   ", 
     RowBox[{"w5_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"w6_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"w7_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"w8_", "?", "NumericQ"}], ",", " ", "\n", "   ", 
     RowBox[{"w9_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Abs", "[", "\n", "   ", 
    RowBox[{"Sum", "[", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"c", "[", 
        RowBox[{"[", "l", "]"}], "]"}], "*", "\n", "     ", 
       RowBox[{"Conjugate", "[", 
        RowBox[{"c", "[", 
         RowBox[{"[", "lp", "]"}], "]"}], "]"}], "*", 
       RowBox[{"\[Mu]", "[", 
        RowBox[{
        "w1", ",", " ", "w2", ",", " ", "w3", ",", " ", "w4", ",", " ", "w5", 
         ",", " ", "w6", ",", " ", "w7", ",", " ", "w8", ",", " ", "w9", ",", 
         " ", "l", ",", " ", "\n", "      ", "lp", ",", " ", 
         RowBox[{"-", "1"}]}], "]"}]}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"l", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], "}"}]}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"lp", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], "}"}]}], 
       "}"}]}], "\n", "    ", "]"}], "\n", "   ", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[371]:= ",
 CellID->1210485987,ExpressionUUID->"571ae662-c9c7-b1ca-7d39-f84fe8730310"],

Cell[TextData[{
 "Following the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["C", "TI"], 
   StyleBox["L", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45b5dbb0-b576-45eb-734a-d2fa3c032f31"],
 " equation, we define the cost function:"
}], "Text",
 CellID->1818149501,ExpressionUUID->"4ce9c8c0-fe52-3cd7-7496-e1adfbe4863d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "LocalCost", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LocalCost", "[", 
    RowBox[{
     RowBox[{"w1_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"w2_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"w3_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"w4_", "?", "NumericQ"}], ",", " ", "\n", "   ", 
     RowBox[{"w5_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"w6_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"w7_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"w8_", "?", "NumericQ"}], ",", " ", "\n", "   ", 
     RowBox[{"w9_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", "\n", "  ", 
   RowBox[{"0.5", " ", "-", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"0.5", "/", 
        RowBox[{"(", 
         RowBox[{"3", "*", 
          RowBox[{"PsiNorm", "[", 
           RowBox[{
           "w1", ",", " ", "w2", ",", " ", "w3", ",", " ", "w4", ",", " ", 
            "w5", ",", " ", "w6", ",", " ", "w7", ",", " ", "w8", ",", " ", 
            "w9"}], "]"}]}], ")"}]}], ")"}], "*", 
      RowBox[{"Abs", "[", "\n", "      ", 
       RowBox[{"Sum", "[", "\n", "       ", 
        RowBox[{
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"[", "l", "]"}], "]"}], "*", "\n", "        ", 
          RowBox[{"Conjugate", "[", 
           RowBox[{"c", "[", 
            RowBox[{"[", "lp", "]"}], "]"}], "]"}], "*", 
          RowBox[{"\[Mu]", "[", 
           RowBox[{
           "w1", ",", " ", "w2", ",", " ", "w3", ",", " ", "w4", ",", " ", 
            "w5", ",", " ", "w6", ",", " ", "w7", ",", " ", "w8", ",", " ", 
            "w9", ",", " ", "\n", "         ", "l", ",", " ", "lp", ",", " ", 
            "j"}], "]"}]}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"l", ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], 
            "}"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"lp", ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], 
            "}"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "}"}]}], 
        "\n", "       ", "]"}], "\n", "      ", "]"}]}], "\n", "    ", 
     ")"}]}]}], ";"}]}], "Input",
 CellLabel->"In[372]:= ",
 CellID->1354575844,ExpressionUUID->"4c678cac-5cc4-b18e-741c-25f6557603d4"],

Cell["Cost Function Optimization", "Text",
 CellID->1533071064,ExpressionUUID->"0528a095-4bdb-63f8-2cd7-39df6e6e31c2"],

Cell["\<\
We will calculate the gradient descent for our cost function:\
\>", "Text",
 CellID->1779418628,ExpressionUUID->"1a78d2a2-b26e-4f45-4a07-cb0fc71b15af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"w", " ", "=", " ", 
   RowBox[{"0.001", " ", "*", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", "]"}], ",", " ", "9"}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[373]:= ",
 CellID->1356235482,ExpressionUUID->"316f19e5-f7db-2937-6714-90ce826e781d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GradientParameters", " ", "=", " ", "\n", "   ", 
    RowBox[{"GradientDescent", "[", 
     RowBox[{"LocalCost", ",", " ", "w", ",", " ", 
      RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "40"}], ",", " ", "\n",
       "    ", 
      RowBox[{"\"\<LearningRate\>\"", " ", "->", " ", "0.8"}]}], "]"}]}], 
   ";"}], " ", "//", " ", "AbsoluteTiming"}]], "Input",
 CellLabel->"In[374]:= ",
 CellID->1116436607,ExpressionUUID->"3daec99f-8291-5f2c-6b55-e0d937242276"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"lc", " ", "=", " ", 
    RowBox[{"LocalCost", " ", "@@@", " ", "GradientParameters"}]}], ";"}], 
  " ", "//", " ", "AbsoluteTiming"}]], "Input",
 CellLabel->"In[375]:= ",
 CellID->1890464303,ExpressionUUID->"5dea9ab6-68b8-c529-0be9-13f00932ac73"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{"lc", ",", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Optimization steps\>\"", ",", 
      " ", "\"\<Cost Function Value\>\""}], "}"}]}], ",", " ", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{
    "{", "\"\<1 \[Dash] \[VerticalSeparator]\!\(\*TemplateBox[{\\\"b\\\", \
\\\"\[Psi]\\\"},\n\
\\\"BraKet\\\"]\)\!\(\*SuperscriptBox[\(\[VerticalSeparator]\), \(2\)]\)\>\"",
      "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[376]:= ",
 CellID->782510934,ExpressionUUID->"030af18e-b5e5-d347-3109-e8ebc391a1ad"],

Cell["Classical Linear System Solving", "Text",
 CellID->1534589069,ExpressionUUID->"405f2726-590a-86f0-7064-be8058bcecda"],

Cell[TextData[{
 "We can build the ",
 StyleBox["A", "TI"],
 " matrix and state",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["b", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "385fe069-90bd-43ce-6864-fa3321481114"],
 " of the present problem:"
}], "Text",
 CellID->237276937,ExpressionUUID->"709f1246-ab2e-00b9-20a4-9423cedb5283"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   StyleBox["A", "TI"], "=", "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0.75", "\|01d7d9", "+", "0.0625", 
    SubscriptBox[
     StyleBox["Z", "TI"], "4"], "+", "0.0625", 
    SubscriptBox[
     StyleBox["Z", "TI"], "3"], "+", "0.125", 
    SubscriptBox[
     StyleBox["Z", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1223395457,ExpressionUUID->"50a39cef-8bd0-9934-0050-15c92e6ae81e"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     StyleBox["b", "TI"]},
    "Ket"], "=", 
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], "2"], 
    SubscriptBox[
     StyleBox["H", "TI"], "3"], 
    SubscriptBox[
     StyleBox["H", "TI"], "4"], 
    TemplateBox[{"0"},
     "Ket"]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->107451856,ExpressionUUID->"6eea4472-a755-a6aa-16ea-5e3fd2e10cf0"],

Cell["\<\
Solve the system by operating over the correspondent matrices:\
\>", "Text",
 CellID->419270701,ExpressionUUID->"1d344668-2780-d87f-44cc-5832523aab45"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A2", " ", "=", " ", 
   RowBox[{"IdentityMatrix", "[", "8", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"A3", " ", "=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "\n", "   ", 
     RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"A4", " ", "=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
     RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", "\n", "   ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"A5", " ", "=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "\n", "   ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[377]:= ",
 CellID->1555712680,ExpressionUUID->"7ae7ede6-d60d-06a2-2a9c-04c3e3b86c88"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"c", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "*", "A2"}], " ", "+", " ", 
    RowBox[{
     RowBox[{"c", "[", 
      RowBox[{"[", "3", "]"}], "]"}], "*", "A3"}], " ", "+", " ", 
    RowBox[{
     RowBox[{"c", "[", 
      RowBox[{"[", "4", "]"}], "]"}], "*", "A4"}], " ", "+", " ", 
    RowBox[{
     RowBox[{"c", "[", 
      RowBox[{"[", "5", "]"}], "]"}], "*", "A5"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", " ", "=", " ", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"Sqrt", "[", "8", "]"}]}], ",", " ", "8"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\"\<A\>\"", " ", "->", " ", 
     RowBox[{"MatrixForm", "[", "A", "]"}]}], ",", " ", "\n", "  ", 
    RowBox[{"\"\<\!\(\*TemplateBox[{\\\"b\\\"},\n\\\"Ket\\\"]\)\>\"", " ", "->",
      " ", 
     RowBox[{"MatrixForm", "[", "b", "]"}]}]}], "}"}], " ", "//", " ", 
  "N"}]}], "Input",
 CellLabel->"In[378]:= ",
 CellID->800810386,ExpressionUUID->"71444f73-786e-4642-277c-673d791b2ca8"],

Cell["Finally, compute the probabilities:", "Text",
 CellID->597240091,ExpressionUUID->"74f6de95-8032-4c15-1c8d-d7df31c7177f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"LinearSystemResult", " ", "=", " ", 
   RowBox[{
    RowBox[{"Normalize", "[", 
     RowBox[{"LinearSolve", "[", 
      RowBox[{"A", ",", " ", "b"}], "]"}], "]"}], "^", "2"}]}], ";"}], "\n", 
 RowBox[{"Thread", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Ket", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Delete", "[", "0", "]"}], "@", "#"}], "}"}], "]"}], " ", 
     "&"}], " ", "/@", " ", 
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"SubPlus", "[", "z", "]"}], ",", " ", 
        RowBox[{"SubMinus", "[", "z", "]"}]}], "}"}], ",", " ", "3"}], 
     "]"}]}], " ", "->", "\n", "   ", "LinearSystemResult"}], "]"}]}], "Input",\

 CellLabel->"In[379]:= ",
 CellID->8577255,ExpressionUUID->"389004b5-9a2c-3ef3-68af-9dff1fde84d9"],

Cell["Symbolic & Numeric Quantum Circuit Result", "Text",
 CellID->1474640019,ExpressionUUID->"2d697f6b-3d93-338c-5b17-7735b42781d6"],

Cell["\<\
We can build the Variational circuit from the example and test it with the \
optimized parameters result:\
\>", "Text",
 CellID->423172014,ExpressionUUID->"20a70809-2e49-b141-505c-a2534bfd03ab"],

Cell["\<\
Test the Variational circuit with the optimized parameters results:\
\>", "Text",
 CellID->1195348698,ExpressionUUID->"7723626c-4939-a85b-1ed0-843668cdfaa1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VariationalMeasurement", " ", "=", " ", "\n", "  ", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{"VariationalBlock", ",", " ", "\n", "     ", 
       RowBox[{"QuantumMeasurementOperator", "[", 
        RowBox[{
         RowBox[{"\"\<Z\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"-", "1"}]}], "}"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}]}], 
      "}"}], "]"}], "[", "]"}]}], ";"}]], "Input",
 CellLabel->"In[380]:= ",
 CellID->1975192065,ExpressionUUID->"6663ba53-1d85-6946-0e10-3c1d94303bac"],

Cell["The optimization resultant probabilities:", "Text",
 CellID->643618096,ExpressionUUID->"2a52a343-e04e-4391-5a61-3b2c91fb11fb"],

Cell[BoxData[
 RowBox[{"NumericalResult", " ", "=", " ", "\n", " ", 
  RowBox[{
   RowBox[{"VariationalMeasurement", "[", "\n", "   ", 
    RowBox[{"AssociationThread", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\[Omega]3", ",", " ", 
        "\[Omega]4", ",", " ", 
        RowBox[{"\\\n", "\[Omega]5"}], ",", " ", "\[Omega]6", ",", " ", 
        "\[Omega]7", ",", " ", "\[Omega]8", ",", " ", "\[Omega]9"}], "}"}], ",",
       " ", "\n", "    ", 
      RowBox[{"Last", "@", "GradientParameters"}]}], "]"}], "]"}], 
   "[", "\"\<Probabilities\>\"", "]"}]}]], "Input",
 CellLabel->"In[381]:= ",
 CellID->605270364,ExpressionUUID->"48a3001a-e719-cbe1-7850-9a4792ad99cb"],

Cell["\<\
We can calculate how different one distribution is from another using the \
Kullback\[Dash]Leibler divergence:\
\>", "Text",
 CellID->649485054,ExpressionUUID->"31ebe54c-d1b5-c56d-67e8-fd29e041afb7"],

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "*", 
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "/", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], " ", "&"}], " ", "/@", " ",
    "\n", "  ", 
   RowBox[{"Thread", "[", 
    RowBox[{"{", 
     RowBox[{"LinearSystemResult", ",", " ", 
      RowBox[{"Values", "@", "NumericalResult"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[382]:= ",
 CellID->2110238440,ExpressionUUID->"1dddb0f1-9068-854b-4be2-29bb2102ef91"],

Cell["\<\
Since the results are small, it is an indicator that the distributions are \
similar.\
\>", "Text",
 CellID->1756407447,ExpressionUUID->"4eea920a-da78-9b5c-76e9-1457dff2e9a6"],

Cell["We can also employ a Kolmogorov Smirnov Test:", "Text",
 CellID->2079154320,ExpressionUUID->"7f55f164-a56a-0bbf-256a-e941cc1f5985"],

Cell[BoxData[
 RowBox[{"KolmogorovSmirnovTest", "[", 
  RowBox[{
   RowBox[{"Values", "@", "NumericalResult"}], ",", " ", 
   "LinearSystemResult"}], "]"}]], "Input",
 CellLabel->"In[383]:= ",
 CellID->621458366,ExpressionUUID->"66a2faf2-58b3-40d9-0e51-f3bc59461223"],

Cell["\<\
In this case, the number is considered big enough to indicate that the \
results are from the reference distribution.\
\>", "Text",
 CellID->1974735042,ExpressionUUID->"1685e188-3be3-a90f-3eba-f8d2bd97f855"],

Cell["Let\[CloseCurlyQuote]s plot the probabilities for a visual \
comparison:", "Text",
 CellID->1371454782,ExpressionUUID->"1a321877-2c7f-2cce-4bc1-9231450a7614"],

Cell[BoxData[
 RowBox[{"BarChart", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"LinearSystemResult", ",", " ", 
      RowBox[{"Values", "@", "NumericalResult"}]}], "}"}], "]"}], ",", " ", 
   "\n", " ", 
   RowBox[{"ChartLayout", " ", "->", " ", "\"\<Grouped\>\""}], ",", " ", "\n",
    " ", 
   RowBox[{"ChartLabels", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Ket", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Delete", "[", "0", "]"}], "@", "#"}], "}"}], "]"}], " ", 
        "&"}], " ", "/@", " ", "\n", "    ", 
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"SubPlus", "[", "z", "]"}], ",", " ", 
           RowBox[{"SubMinus", "[", "z", "]"}]}], "}"}], ",", " ", "3"}], 
        "]"}]}], ",", " ", "None"}], "}"}]}], ",", " ", "\n", " ", 
   RowBox[{"ChartLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Classical Linear System Solving\>\"", ",", " ", "\n", 
      "   ", "\"\<Numerical Quantum Circuit\>\""}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}], ",", " ", "\n", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<States\>\"", ",", " ", "\"\<Probabilities\>\""}], "}"}]}]}],
   "]"}]], "Input",
 CellLabel->"In[384]:= ",
 CellID->178229948,ExpressionUUID->"4421f40f-2283-9b1b-6dde-ee695737e661"],

Cell["\<\
Multiplexer-based Variational Quantum Linear Solver (MB-VQLS)\
\>", "Subsection",
 CellID->1521048583,ExpressionUUID->"612520b5-066b-562d-10da-b9ffb31e3d77"],

Cell[TextData[{
 "The Variational Quantum Linear Solver (VQLS) is a hybrid quantum-classical \
technique designed to address Quantum Linear Systems Problems (QLSP). The \
main goal is to find linear solutions for systems as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], ".", 
   RowBox[{
    StyleBox["x", "TI"], "=", 
    StyleBox["b", "TI"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b20a0de-bf05-fd95-7adf-39983ab1c7ff"],
 "."
}], "Text",
 CellID->304130544,ExpressionUUID->"4a88aa2f-b14b-d52b-7ab7-4388c0ffbc71"],

Cell[TextData[{
 "In this Tech Note we will explain the applications and options of ",
 Cell[BoxData["QuantumLinearSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57b69005-8bc5-b0fd-7d4d-0a6f2e7102c7"],
 " function implemented in the Wolfram Quantum Computation Framework to solve \
QLSP problems."
}], "Text",
 CellID->1205771972,ExpressionUUID->"72f2455d-c49b-2bf1-2282-5d06ed2e79db"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "77416ebe-6e08-cf7c-1d7e-87f80ba29246"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"18599260-685f-792c-4866-144a09ea4876"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"32a0fa91-0c97-025a-625f-f3dba52250a0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1d4f6d29-8280-add7-4b74-8573373af73d"], Cell[TextData[{
     Cell[BoxData["QuantumLinearSolve"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7d1d4b7f-00e8-6ae3-2b23-6339b09d38c9"],
     "[",
     StyleBox["m", "TI"],
     ",",
     StyleBox["b", "TI"],
     ",",
     StyleBox["opts", "TI"],
     "]"
    }], "TableText",ExpressionUUID->"3b093cc2-afd1-7ed1-6936-b5afca64443b"], 
    Cell[TextData[{
     "uses a hybrid optimization algorithm to find a quantum state described \
by the state vector ",
     Cell[BoxData[
      StyleBox["x", "TI"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "023dde7a-8e23-336a-33c2-d0242bd781b0"],
     " that satisfies ",
     Cell[BoxData[
      RowBox[{
       StyleBox["m", "TI"], ".", 
       RowBox[{
        StyleBox["x", "TI"], "=", 
        StyleBox["b", "TI"]}]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "40fb5a43-fbb5-27db-7099-5c2cfe418d21"],
     "."
    }], "TableText",ExpressionUUID->"2425f502-e1b1-2adc-4dda-ed6f90447826"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "212476b8-b137-7f4a-50dc-6fe5c0c24590"], Cell[TextData[{
     Cell[BoxData["QuantumLinearSolve"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3db10d53-0e34-1357-6b4e-a51dabc161bd"],
     "[",
     Cell[BoxData[
      RowBox[{
       StyleBox["m", "TI"], ",", 
       StyleBox["b", "TI"], ",", 
       StyleBox["prop",
        FontSlant->"Italic"], ",", 
       StyleBox["opts",
        FontSlant->"Italic"]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3e4bd926-69e3-4ee0-6648-d0800f9614ca"],
     "]"
    }], "TableText",ExpressionUUID->"57d10123-a1d4-e454-7dee-988cd066cebe"], 
    Cell[TextData[{
     "solves ",
     Cell[BoxData[
      RowBox[{
       StyleBox["m", "TI"], ".", 
       RowBox[{
        StyleBox["x", "TI"], "=", 
        StyleBox["b", "TI"]}]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "27645c90-4345-b83d-4d1c-55da76f10b07"],
     " by including the specified properties ",
     Cell[BoxData[
      StyleBox[
       RowBox[{"p", "r", "o", "p"}], "TI"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "245848e5-b774-8ea9-4c78-61cec206d4f3"],
     "."
    }], "TableText",ExpressionUUID->"0581f938-6b6a-81e3-33be-f1620e1cd3c9"]}
  }]], "2ColumnTableMod",
 CellID->1920497229,ExpressionUUID->"7e58b706-7f01-9af1-2667-2f607ab5e8db"],

Cell["\<\
We will briefly demonstrate how to apply all these functions in Wolfram \
quantum framework.\
\>", "Text",
 CellID->1382209768,ExpressionUUID->"0b1945ac-ce61-156f-3927-5c09eb147fb5"],

Cell["Details and Options", "Subsubsection",
 CellID->1932047069,ExpressionUUID->"3d8aaa59-0983-f6a5-6b89-4c03a837dc8f"],

Cell[TextData[{
 "QuantumLinearSolve works on numerical matrices. The argument ",
 StyleBox["b", "TI"],
 " must be a vector, while the argument ",
 StyleBox["m", "TI"],
 " must be a square matrix. QuantumLinearSolve is able to compute solutions \
for ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f61b3a8-54be-2aae-151e-2af25d4b78f4"],
 "\[Dash]dimension problems."
}], "Text",
 CellID->240207130,ExpressionUUID->"334edda2-111d-1275-6175-d40ca0a8615f"],

Cell["\<\
QuantumLinearSolve utilizes a multiplexer-based variational quantum linear \
solver algorithm. The primary distinctions from a conventional variational \
quantum linear solver algorithm are as follows:\
\>", "Text",
 CellID->1580514867,ExpressionUUID->"705f43d3-b8fa-6681-2065-5a9d388f4ceb"],

Cell[TextData[{
 "The multiplication of the matrix ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e6e22f7-e70d-ed4b-3615-bbb092b9b791"],
 " is implemented by a multiplexer, enabling the accurate representation of \
the operation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], ".", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f79e66b-a47f-c7f6-5506-f834cd0baddc"],
 " within the quantum circuit."
}], "Item",
 CellID->960165026,ExpressionUUID->"26eacd00-7450-3870-4ee9-e56a7dea8b5a"],

Cell["\<\
The solution to the linear system is encoded directly in the amplitudes of \
the resultant quantum state.\
\>", "Item",
 CellID->2134254160,ExpressionUUID->"0a9819e1-44ec-6fcb-3aa7-90cb6c993511"],

Cell["\<\
This approach simplifies the standard variational quantum linear solver by \
reducing the need for multiple circuits used in the real-imaginary \
decomposition of the solution and the term-by-term computation within quantum \
circuits. A detailed step-by-step implementation is outlined in this \
documentation.\
\>", "Text",
 CellID->1650262063,ExpressionUUID->"2241f5e7-2cd3-435b-527e-ecc1456611a1"],

Cell["\<\
The basic steps to implement the algorithm are the following:\
\>", "Text",
 CellID->1874624977,ExpressionUUID->"2d2e5055-b89d-3ae5-54d6-4a1f392988cf"],

