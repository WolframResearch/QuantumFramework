Cell["\<\
Aiming to get rid of the \[OpenCurlyDoubleQuote]information\
\[CloseCurlyDoubleQuote] from the state projections:.\
\>", "Text",
 CellID->1619640766,ExpressionUUID->"05590d03-2064-1772-3366-a56d51117a58"],

Cell["\<\
From normalizing this expression, the norm of this \
\[OpenCurlyDoubleQuote]measurement of changes in the projective space\
\[CloseCurlyDoubleQuote] gives the differential form of the distance which is \
the Fubini-Study metric:\
\>", "Text",
 CellID->340226632,ExpressionUUID->"3b9b9f37-eb8f-88a6-69b8-17708e3bda8c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["s", "TI"], 
     StyleBox[
      RowBox[{"F", "S"}], "TI"], "2"]}], "=", 
   RowBox[{
    FractionBox[
     TemplateBox[{
       RowBox[{
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["\[Psi]", "TI"], "\[Perpendicular]"]}], 
       RowBox[{
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["\[Psi]", "TI"], "\[Perpendicular]"]}]},
      "BraKet"], 
     TemplateBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["\[Psi]", "TI"]},
      "BraKet"]], "=", 
    RowBox[{
     FractionBox[
      TemplateBox[{
        RowBox[{
          StyleBox["d", "TI"], 
          StyleBox["\[Psi]", "TI"]}], 
        RowBox[{
          StyleBox["d", "TI"], 
          StyleBox["\[Psi]", "TI"]}]},
       "BraKet"], 
      TemplateBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["\[Psi]", "TI"]},
       "BraKet"]], "-", 
     FractionBox[
      RowBox[{GridBox[{
         {
          TemplateBox[{
            StyleBox["\[Psi]", "TI"], 
            RowBox[{
              StyleBox["d", "TI"], 
              StyleBox["\[Psi]", "TI"]}]},
           "BraKet"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], 
       SuperscriptBox["", "2"]}], 
      SuperscriptBox[
       TemplateBox[{
         StyleBox["\[Psi]", "TI"], 
         StyleBox["\[Psi]", "TI"]},
        "BraKet"], "2"]]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->547552490,ExpressionUUID->"7ef0eca9-2ea7-fc5e-268f-05f34b53c6a4"],

Cell["\<\
With this concept in mind, we can now understand how the formula for the \
Fubini-Study metric is derived. For further exploration of the theory, you \
can refer to literature on the Quantum Geometric Tensor.\
\>", "Text",
 CellID->1706163375,ExpressionUUID->"53b0040e-15e9-970f-014f-9e68a39dfa55"],

Cell["Implement a simple single qubit state:", "Text",
 CellID->1029219123,ExpressionUUID->"49c5479d-c9fe-ab26-7ffb-5ec6ef88f60c"],

Cell[BoxData[
 RowBox[{"state", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", "\[Theta]1", "]"}], ",", " ", "\n", "   ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"2", "*", "I", "*", "\[Theta]2"}], "]"}], "*", 
       RowBox[{"Sin", "[", "\[Theta]1", "]"}]}]}], "}"}], ",", " ", "\n", 
    "  ", 
    RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\[Theta]1", ",", " ", "\[Theta]2"}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[221]:= ",
 CellID->316990196,ExpressionUUID->"73b5640c-4acf-57ea-214b-7e566f7a3d30"],

Cell[BoxData[
 RowBox[{"state", "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[222]:= ",
 CellID->148447129,ExpressionUUID->"12e31b8a-6cd9-3185-4290-92d4056d83ef"],

Cell["\<\
Let\[CloseCurlyQuote]s calculate the ket, bra and cost function by applying \
the VQE over a single Pauli X hamiltonian:\
\>", "Text",
 CellID->196547055,ExpressionUUID->"1c8dfb5f-95aa-8549-44b2-f3191c5cef93"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "cost", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ket", "[", 
     RowBox[{"{", "\[Psi]", "}"}], "]"}], " ", "=", " ", 
    RowBox[{"state", "[", "\"\<StateVector\>\"", "]"}]}], ";"}], 
  " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Bra", "[", 
    RowBox[{"{", "\[Psi]", "}"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"SuperDagger", "[", "state", "]"}], "[", "\"\<StateVector\>\"", 
    "]"}]}], ";"}], "\n", 
 RowBox[{"cost", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Bra", "[", 
      RowBox[{"{", "\[Psi]", "}"}], "]"}], " ", ".", " ", 
     RowBox[{"PauliMatrix", "[", "1", "]"}], " ", ".", " ", 
     RowBox[{"Ket", "[", 
      RowBox[{"{", "\[Psi]", "}"}], "]"}]}], " ", "//", " ", "\n", "   ", 
    "ComplexExpand"}], " ", "//", " ", "Simplify"}]}]}], "Input",
 CellLabel->"In[223]:= ",
 CellID->47083302,ExpressionUUID->"77ba1ed5-dc9c-5ed1-1d59-979ed529243b"],

Cell[TextData[{
 "Now, we can calculate by ourselves the Fubini-Study metric tensor by \
calculating all the derivatives of ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "122b6086-f39f-774a-4229-79e3862a5d90"],
 ", in this case 2 for \[Theta]1 and \[Theta]2:"
}], "Text",
 CellID->673262832,ExpressionUUID->"562fd52b-4ccb-95a8-7fd4-cd75657ffff2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"d\[Psi]", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Ket", "[", 
        RowBox[{"{", "\[Psi]", "}"}], "]"}], ",", " ", "i"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Theta]1", ",", " ", "\[Theta]2"}], "}"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"fubini", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", 
          RowBox[{"d\[Psi]", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], " ", ".", " ", "\n", 
         "       ", 
         RowBox[{"d\[Psi]", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "]"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", 
           RowBox[{"d\[Psi]", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], " ", ".", " ", "\n", 
          "        ", 
          RowBox[{"Ket", "[", 
           RowBox[{"{", "\[Psi]", "}"}], "]"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", 
           RowBox[{"Ket", "[", 
            RowBox[{"{", "\[Psi]", "}"}], "]"}], "]"}], " ", ".", " ", "\n", 
          "        ", 
          RowBox[{"d\[Psi]", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}]}], ",", "\t\t\t", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", 
        RowBox[{"Length", "@", "d\[Psi]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", 
        RowBox[{"Length", "@", "d\[Psi]"}]}], "}"}]}], "\n", "    ", "]"}], 
    " ", "//", " ", "ComplexExpand"}], " ", "//", " ", 
   "FullSimplify"}]}]}], "Input",
 CellLabel->"In[224]:= ",
 CellID->309032399,ExpressionUUID->"6a176158-c8f1-b5ca-1a2d-7905e8851f10"],

Cell[TextData[{
 "Apply the ",
 StyleBox["FubiniStudyMetricTensor",
  FontWeight->"Bold"],
 " function to obtain the calculated QuantumOperator:"
}], "Text",
 CellID->692508659,ExpressionUUID->"59294b9d-2c6b-0af3-08d7-62c7451e58d9"],

Cell[BoxData[
 RowBox[{"metric", " ", "=", " ", 
  RowBox[{"FubiniStudyMetricTensor", "[", "state", "]"}]}]], "Input",
 CellLabel->"In[225]:= ",
 CellID->1893265363,ExpressionUUID->"4c93342e-976f-2690-74a0-ad88221b8cfa"],

Cell[BoxData[
 RowBox[{"FubiniStudyMetricTensor", "[", 
  RowBox[{"state", ",", " ", "\"\<MatrixForm\>\""}], "]"}]], "Input",
 CellLabel->"In[226]:= ",
 CellID->904686067,ExpressionUUID->"0c05a0c6-8ada-cee6-343a-39a02f6c94cc"],

Cell["\<\
The Fubini-Study metric tensor plays a crucial role in Quantum Natural \
Gradient Descent. Originating from the field of differential geometry, the \
Fubini-Study metric tensor enables the quantification of distances between \
quantum states on the complex projective Hilbert space.\
\>", "Text",
 CellID->1192782202,ExpressionUUID->"386c40c3-2c7c-2bd7-6814-59ad4509793d"],

Cell["Properties", "Subsubsection",
 CellID->1581584719,ExpressionUUID->"38a5d185-6c33-4099-685a-c8ef05c612e3"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "705b2160-d6f6-9bc7-2078-b94de280e92d"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"3ad5a48d-d13d-ee7b-6aea-3dd6e0c9b541"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"3e286ad4-f19d-13f8-67d7-8391802861c2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "40ae3c14-0aab-252d-7055-b65eaf5f8c77"], Cell[TextData[Cell[
    BoxData["\"\<Matrix\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3710829e-7f3a-eae8-5d2f-1bd87accb832"]], "TableText",ExpressionUUID->
     "514f46f4-7214-5441-0775-5fbe07a13eab"], Cell["\<\
obtain the correspondant Fubini-Study metric tensor matrix in as a list.\
\>", "TableText",ExpressionUUID->"5a8341fe-fd5d-b2cd-0ab1-58bbf4e90017"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4cf942e0-12f7-a17b-7487-5bcaa683f041"], Cell[TextData[Cell[
    BoxData["\"\<MatrixForm\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4db09b50-0334-b760-7b4f-131ab6c61a4a"]], "TableText",ExpressionUUID->
     "7cb56032-9c81-172f-244b-7a7c15347a75"], Cell["\<\
obtain the correspondant Fubini-Study metric tensor matrix in MatrixForm.\
\>", "TableText",ExpressionUUID->"55f15dca-bfed-9606-038f-54943999fd6c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5589ad74-704a-26e9-03b6-453e01fc8c33"], Cell[TextData[Cell[
    BoxData["\"\<Parameters\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "37fda5d4-10fa-7e26-5d82-3c9ea08f450c"]], "TableText",ExpressionUUID->
     "6cc64ef1-7b65-373d-14fe-67bb7e119a07"], Cell[
    "obtain parameters used for the differentiation process.", "TableText",
     ExpressionUUID->"542582fc-1c6f-cfd5-7dda-1ba6951b953f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7ad84463-32de-d6a2-2af8-5e4d4768bc88"], Cell[TextData[Cell[
    BoxData["\"\<SparseArray\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3261459d-f728-27c9-621f-5cc682c28d13"]], "TableText",ExpressionUUID->
     "331c7f17-1677-2611-6124-7751a3038d7b"], Cell["\<\
obtain the correspondant Fubini-Study metric tensor matrix as a SparseArray.\
\>", "TableText",ExpressionUUID->"14cbe893-f079-1a7f-3cc8-01dc810c6945"]}
  }]], "2ColumnTableMod",
 CellID->1309780430,ExpressionUUID->"3a1d5a8b-943b-deab-6a23-53d51dcfa4f1"],

Cell["\<\
Use \"Matrix\" and \"MatrixForm\" to obtain a simplified matrix expression \
which assumes Real-valued parameters:\
\>", "Text",
 CellID->8822066,ExpressionUUID->"355f53e5-dafb-cebc-6365-4acede8f9486"],

Cell[BoxData[
 RowBox[{"FubiniStudyMetricTensor", "[", 
  RowBox[{"state", ",", " ", "\"\<Matrix\>\""}], "]"}]], "Input",
 CellLabel->"In[227]:= ",
 CellID->1657448353,ExpressionUUID->"492c649c-8337-646c-78d4-7dc636c24eb6"],

Cell[BoxData[
 RowBox[{"FubiniStudyMetricTensor", "[", 
  RowBox[{"state", ",", " ", "\"\<MatrixForm\>\""}], "]"}]], "Input",
 CellLabel->"In[228]:= ",
 CellID->1715023617,ExpressionUUID->"1678747f-7a6a-a1d6-3e18-6e397f1cf33c"],

Cell["\<\
Use \"Parameters\" to obtain the parameters pre-defined in the QuantumState \
used as input:\
\>", "Text",
 CellID->2117517091,ExpressionUUID->"5c54ceec-a669-4ede-046b-e7c9d31c1424"],

Cell[BoxData[
 RowBox[{"FubiniStudyMetricTensor", "[", 
  RowBox[{"state", ",", " ", "\"\<Parameters\>\""}], "]"}]], "Input",
 CellLabel->"In[229]:= ",
 CellID->1567534325,ExpressionUUID->"336f4c4f-cb14-5955-6115-6628eea12bbf"],

Cell["Use \"SparseArray\" for a non-simplified result:", "Text",
 CellID->989807887,ExpressionUUID->"192b8c2c-1b0f-3631-4f28-26769ebb9d1b"],

Cell[BoxData[
 RowBox[{"FubiniStudyMetricTensor", "[", 
  RowBox[{"state", ",", " ", "\"\<SparseArray\>\""}], "]"}]], "Input",
 CellLabel->"In[230]:= ",
 CellID->184681434,ExpressionUUID->"2580083d-358c-3435-53bf-a267bc3e9f1f"],

Cell[TextData[{
 "Request them all using ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "477fde83-a5ae-c17e-6d04-d7eccc589044"],
 " as third argument:"
}], "Text",
 CellID->1168583271,ExpressionUUID->"0782fdeb-454d-5eca-2db1-f4b56cf82410"],

Cell[BoxData[
 RowBox[{"FubiniStudyMetricTensor", "[", 
  RowBox[{"state", ",", " ", "All"}], "]"}]], "Input",
 CellLabel->"In[231]:= ",
 CellID->238100634,ExpressionUUID->"69a01936-08b2-60cf-1f5f-9170a9473215"],

Cell["Quantum Natural Gradient Descent", "Subsection",
 CellID->29752097,ExpressionUUID->"553ebd3d-d82b-159a-7cc5-3566d9de7fe0"],

Cell["\<\
Quantum Natural Gradient Optimization Method represent a cutting-edge \
approach to optimizing parameterized quantum circuits in the field of quantum \
computing. Unlike classical gradient-based methods, Quantum Natural Gradient \
techniques account for the unique geometry of the quantum state manifold, \
mitigating issues such as barren plateaus and enabling faster convergence \
rates.\
\>", "Text",
 CellID->1952363278,ExpressionUUID->"6c0b44c7-b7b3-5c45-1409-5da0c24626af"],

Cell[TextData[{
 "The quantum state space features an invariant metric tensor referred to as \
the Fubini\[Dash]Study metric tensor ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["g", "TI"], 
   StyleBox[
    RowBox[{"i", "j"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dba914e-52ed-e087-7b59-09286699b2ed"],
 " , which can be used to develop a ",
 StyleBox["quantum", "TI"],
 " version of a natural gradient descent. Then each optimization step is \
given by:"
}], "Text",
 CellID->2095068549,ExpressionUUID->"497e5609-e734-e246-7f06-485292c6b0ac"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    RowBox[{
     StyleBox["t", "TI"], "+", "1"}]], "=", "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox["t", "TI"]], "-", 
   StyleBox["\[Eta]", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["g", "TI"], "+"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Theta]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[Del]", "\[ScriptCapitalL]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Theta]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1328314581,ExpressionUUID->"08c79fc2-e932-c645-38fc-16af88c4acaf"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["g", "TI"], "+"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2184153d-b162-7859-57bb-8d66c0174aa3"],
 " the Fubini-Study metric tensor pseudo-inverse."
}], "Text",
 CellID->464594184,ExpressionUUID->"2402dcb3-2cfa-7570-4c31-d5fd448f5c5a"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "554ef748-00c8-cf17-0375-ef12b162927d"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"40bb2fe5-4c06-79cb-7058-c6cf65b34b11"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"7ee2421b-c68a-4a96-2692-6444f33f18fc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "79971006-243c-6fe2-2fac-8a604dc935c8"], Cell[TextData[Cell[BoxData[
