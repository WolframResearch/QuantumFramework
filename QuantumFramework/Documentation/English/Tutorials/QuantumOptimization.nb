Cell["Examples", "Subsubsection",
 CellID->960527452,ExpressionUUID->"13e711b4-4d78-4d68-419c-88fe640d17b2"],

Cell[TextData[{
 "Use ",
 Cell[BoxData["QuantumAdiabaticEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fd09d86-aea1-a602-65ef-14e3cb550d68"],
 " to prepare and analyze the ground state of a target Hamiltonian via \
adiabatic evolution."
}], "Text",
 CellID->216876097,ExpressionUUID->"2f6c0922-6605-ed68-5513-a08c13b1b7b2"],

Cell["Construct a simple single-qubit adiabatic interpolation:", "Text",
 CellID->1315573129,ExpressionUUID->"2caab86a-2af9-b1b1-54a9-32344e8d039b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Hi", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Ht", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], ")"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[74]:= ",
 CellID->857563029,ExpressionUUID->"7f56169e-4783-4dbb-256d-8fd872361781"],

Cell[BoxData[
 RowBox[{"evol", " ", "=", " ", 
  RowBox[{"QuantumAdiabaticEvolve", "[", 
   RowBox[{"Hi", ",", " ", "Ht"}], "]"}]}]], "Input",
 CellLabel->"In[75]:= ",
 CellID->1392409653,ExpressionUUID->"5b84d4d6-858d-5842-09bb-cd902c382aa8"],

Cell["\<\
Compute the interpolating Hamiltonian and the corresponding eigensystem:\
\>", "Text",
 CellID->1608158347,ExpressionUUID->"67558936-e5eb-8680-0d6a-2173939fecea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evol", "[", "\"\<Hamiltonian\>\"", "]"}], " ", "//", " ", 
  "TraditionalForm"}]], "Input",
 CellLabel->"In[76]:= ",
 CellID->1095708849,ExpressionUUID->"1072dc7c-f7d5-c74e-4001-d6398261ad94"],

Cell[BoxData[
 RowBox[{"evol", "[", "\"\<Eigensystem\>\"", "]"}]], "Input",
 CellLabel->"In[77]:= ",
 CellID->200935325,ExpressionUUID->"3462f0a3-098c-f6b3-5c11-e90da83edc99"],

Cell["\<\
Inspect its spectral properties, plotting the energy spectrum:\
\>", "Text",
 CellID->1449261142,ExpressionUUID->"04cac1af-436c-9192-2cc9-d809761ee3f8"],

Cell[BoxData[
 RowBox[{"evol", "[", "\"\<EnergySpectrumPlot\>\"", "]"}]], "Input",
 CellLabel->"In[78]:= ",
 CellID->2143194162,ExpressionUUID->"63be94f2-239e-9b81-1145-0dbc5628e9eb"],

Cell["Analyze the EnergyGap and the AdiabaticCoupling", "Text",
 CellID->972470462,ExpressionUUID->"5a3d7a71-218e-1995-0bc3-7c3b503b6bff"],

Cell[BoxData[
 RowBox[{"evol", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<EnergyGap\>\"", ",", " ", "\"\<AdiabaticCoupling\>\""}], 
   "}"}], "]"}]], "Input",
 CellLabel->"In[79]:= ",
 CellID->1402301269,ExpressionUUID->"3a0f2024-2f71-09ca-6a34-b98e4a045b10"],

Cell[BoxData[
 RowBox[{"evol", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<SpectralGapPlot\>\"", ",", 
    " ", "\"\<AdiabaticCouplingPlot\>\""}], "}"}], "]"}]], "Input",
 CellLabel->"In[80]:= ",
 CellID->2082648425,ExpressionUUID->"277956ac-4c9d-d338-4d07-4ff66529be02"],

Cell["\<\
Estimate the required evolution time using the minimum spectral gap and the \
maximum adiabatic coupling:\
\>", "Text",
 CellID->2054523427,ExpressionUUID->"178a6a52-23e4-1142-3d89-8c1c559163a8"],

Cell[BoxData[
 RowBox[{"evol", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<MinimalEnergyGap\>\"", ",", 
    " ", "\"\<MaxAdiabaticCoupling\>\""}], "}"}], "]"}]], "Input",
 CellLabel->"In[81]:= ",
 CellID->321253538,ExpressionUUID->"52ddf811-e480-8137-02e2-f25a8d3ad01d"],

Cell["\<\
By default, the function uses a scaling factor \[Lambda]=10 to enforce the \
adiabatic condition when estimating the total evolution time:\
\>", "Text",
 CellID->657760644,ExpressionUUID->"719ae17a-c654-ed44-27b9-f927f3e6b7ae"],

Cell[BoxData[
 RowBox[{"evol", "[", "\"\<AdiabaticTimeEstimate\>\"", "]"}]], "Input",
 CellLabel->"In[82]:= ",
 CellID->2107872958,ExpressionUUID->"62c8f42b-c628-388a-12f7-ee74f3c28ad0"],

Cell["\<\
From the previous example, we now analyze the instantaneous ground state \
along the interpolation:\
\>", "Text",
 CellID->2076944729,ExpressionUUID->"36e5ffeb-8179-694d-5e9a-f6b5300c3b97"],

Cell[BoxData[
 RowBox[{"ground", " ", "=", " ", 
  RowBox[{"evol", "[", "\"\<LowestEnergyEigenvector\>\"", "]"}]}]], "Input",
 CellLabel->"In[83]:= ",
 CellID->2070089908,ExpressionUUID->"7af061c8-c44a-ae8e-2a80-7895edfcf4d4"],

Cell["\<\
Visualize how the ground state evolves in the computational basis:\
\>", "Text",
 CellID->1154483336,ExpressionUUID->"0d437dad-8290-de9a-3b71-74f7372aa4e0"],

Cell[BoxData[
 RowBox[{"evol", "[", "\"\<AdiabaticPathPlot\>\"", "]"}]], "Input",
 CellLabel->"In[84]:= ",
 CellID->1679674803,ExpressionUUID->"7aafc905-908a-67da-2a54-e16f213f4d20"],

Cell["\<\
Observe the transition from the ground state of the initial Hamiltonian to \
that of the target Hamiltonian:\
\>", "Text",
 CellID->1050672319,ExpressionUUID->"62016b94-8ad8-fb56-123e-82de2f52c9bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ground", "[", "0", "]"}], "[", "\"\<Probability\>\"", 
  "]"}]], "Input",
 CellLabel->"In[85]:= ",
 CellID->257892954,ExpressionUUID->"0e7c794a-82c2-56e7-3604-711437773ccd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Limit", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"s", " ", "->", " ", "1"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
  
  RowBox[{
   RowBox[{"ground", "[", "s", "]"}], "[", "\"\<Probability\>\"", 
   "]"}]}]], "Input",
 CellLabel->"In[86]:= ",
 CellID->527652451,ExpressionUUID->"30f601cf-5001-fb68-608d-98a961b5c9b2"],

Cell[TextData[{
 "The ground state matches the target ground state of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["H", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04bc0f0b-f02f-243d-2c43-a75481db8f07"],
 ", confirming the success of the adiabatic evolution."
}], "Text",
 CellID->289997235,ExpressionUUID->"1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],

Cell["Scope", "Subsubsection",
 CellID->748159432,ExpressionUUID->"705e212e-f5a4-7717-2065-b88bfc515a7d"],

Cell["\<\
Extend the analysis to more general Hamiltonians, such as perturbed systems, \
where the target ground state is not known analytically:\
\>", "Text",
 CellID->2003843030,ExpressionUUID->"5c2f5325-a3f6-c048-05d5-4a8ed5809292"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"perturbation", " ", "=", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"10", "^", 
      RowBox[{"-", "2."}]}], "*", 
     RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Hz", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], ")"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[87]:= ",
 CellID->511250849,ExpressionUUID->"211ecaf2-61ee-418f-5725-e3bc179b13d5"],

Cell[BoxData[
 RowBox[{"evol", " ", "=", " ", 
  RowBox[{"QuantumAdiabaticEvolve", "[", 
   RowBox[{
    RowBox[{"Hz", " ", "+", " ", "perturbation"}], ",", " ", "Ht"}], 
   "]"}]}]], "Input",
 CellLabel->"In[88]:= ",
 CellID->1610110264,ExpressionUUID->"51e4dffc-d38f-5703-079b-d6b9e63a3a69"],

Cell["Avoided crossing induced by a small perturbation:", "Text",
 CellID->705810229,ExpressionUUID->"30e43b5d-74af-d0fb-609b-b3077d5ba2c1"],

Cell[BoxData[
 RowBox[{"evol", "[", "\"\<Energies\>\"", "]"}]], "Input",
 CellLabel->"In[89]:= ",
 CellID->1868441620,ExpressionUUID->"44d9380c-2e05-8f35-6ce6-b2564bb1d21f"],

Cell[BoxData[
 RowBox[{"evol", "[", "\"\<EnergySpectrumPlot\>\"", "]"}]], "Input",
 CellLabel->"In[90]:= ",
 CellID->41163462,ExpressionUUID->"36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"],

Cell["\<\
The perturbation lifts the degeneracy, opening a small but nonzero spectral \
gap that enables adiabatic evolution:\
\>", "Text",
 CellID->88890771,ExpressionUUID->"138e1639-4d05-8b97-41b5-886364b1d9fd"],

Cell[BoxData[
 RowBox[{"evol", "[", "\"\<MinimalEnergyGap\>\"", "]"}]], "Input",
 CellLabel->"In[91]:= ",
 CellID->1580934692,ExpressionUUID->"156728ce-0023-e03b-431c-c1a8b1d7b301"],

Cell["A finite gap ensures the success of the adiabatic evolution:", "Text",
 CellID->1619475837,ExpressionUUID->"7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"],

Cell[BoxData[
 RowBox[{"evol", "[", "\"\<AdiabaticPathPlot\>\"", "]"}]], "Input",
 CellLabel->"In[92]:= ",
 CellID->282409467,ExpressionUUID->"26ff5c08-e081-ff27-4e85-56559135c20d"],

Cell["Applications", "Subsubsection",
 CellID->109109752,ExpressionUUID->"07c988c4-3ef2-8066-2df6-21aeba84d34c"],

Cell["\<\
Apply the method to a search problem, where the target Hamiltonian encodes \
the marked state, illustrating how adiabatic evolution can be used to perform \
quantum search:\
\>", "Text",
 CellID->584489562,ExpressionUUID->"4bc0a2f3-6150-447f-79ff-3bbd10e52f45"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H0", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"\"\<I\>\"", ",", " ", "6"}], "]"}], " ", "-", " ", "\n", "   ", 
    
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<UniformSuperposition\>\"", "[", "6", "]"}], "]"}], 
     "[", "\"\<Operator\>\"", "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[93]:= ",
 CellID->581169661,ExpressionUUID->"7ac66077-3bfa-1f18-2afe-7a31bd8f6262"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Hm", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"\"\<I\>\"", ",", " ", "6"}], "]"}], " ", "-", " ", "\n", "   ", 
    
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<Register\>\"", "[", 
       RowBox[{"6", ",", " ", "2"}], "]"}], "]"}], "[", "\"\<Operator\>\"", 
     "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[94]:= ",
 CellID->2057728315,ExpressionUUID->"3d863d84-94ab-5643-6bbd-b4ee1d5e3ca9"],

Cell[BoxData[
 RowBox[{"search", " ", "=", " ", 
  RowBox[{"QuantumAdiabaticEvolve", "[", 
   RowBox[{"H0", ",", " ", "Hm"}], "]"}]}]], "Input",
 CellLabel->"In[95]:= ",
 CellID->930077504,ExpressionUUID->"7ab8b877-e011-189c-2a47-323091a46ae6"],

Cell["We analyze the energy spectrum:", "Text",
 CellID->595943781,ExpressionUUID->"35eb0178-2238-e094-63e8-992257b2b2fe"],

Cell[BoxData[
 RowBox[{"search", "[", "\"\<Energies\>\"", "]"}]], "Input",
 CellLabel->"In[96]:= ",
 CellID->1764185489,ExpressionUUID->"0da6433d-a7a4-ba24-3b5e-5b66d256090e"],

Cell[BoxData[
 RowBox[{"search", "[", "\"\<EnergySpectrumPlot\>\"", "]"}]], "Input",
 CellLabel->"In[97]:= ",
 CellID->1087423328,ExpressionUUID->"462f64f6-435d-c7dd-6fd5-7db076e9ad27"],

Cell["Verify that the spectral gap remains nonzero:", "Text",
 CellID->1788590141,ExpressionUUID->"4b06bf63-5f43-ed7c-793d-374d5af7b446"],

Cell[BoxData[
 RowBox[{"search", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<EnergyGap\>\"", ",", " ", "\"\<AdiabaticCoupling\>\""}], 
   "}"}], "]"}]], "Input",
 CellLabel->"In[98]:= ",
 CellID->450467926,ExpressionUUID->"0fd1c247-21a4-d962-35ee-e4215056a848"],

Cell[BoxData[
 RowBox[{"search", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<SpectralGapPlot\>\"", ",", 
    " ", "\"\<AdiabaticCouplingPlot\>\""}], "}"}], "]"}]], "Input",
 CellLabel->"In[99]:= ",
 CellID->1641630741,ExpressionUUID->"09347675-9fce-c17b-38cc-683f1a789041"],

Cell["\<\
Confirm that the final ground state corresponds to the marked state:\
\>", "Text",
 CellID->1739676204,ExpressionUUID->"2c597ed5-00d9-d535-5467-779fb16dbc1f"],

Cell[BoxData[
 RowBox[{"search", "[", "\"\<AdiabaticPathPlot\>\"", "]"}]], "Input",
 CellLabel->"In[100]:= ",
 CellID->406456496,ExpressionUUID->"66c4d8d6-27c8-a0db-0efb-d1905262f221"],

Cell["Possible Issues", "Subsubsection",
 CellID->631730329,ExpressionUUID->"4d3801b6-8b23-0df3-74c7-98f02ed657d9"],

Cell[TextData[{
 "If the minimum spectral gap is zero, a message is issued and the function \
returns ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09816d05-11e9-fb6e-3fbe-856fa79dc9b4"],
 ", as the adiabatic condition cannot be satisfied."
}], "Text",
 CellID->1951413411,ExpressionUUID->"35ec423d-cde2-7917-6394-6466eb97487d"],

Cell[BoxData[
 RowBox[{"evolerror", " ", "=", " ", 
  RowBox[{"QuantumAdiabaticEvolve", "[", 
   RowBox[{"Hz", ",", " ", "Ht"}], "]"}]}]], "Input",
 CellLabel->"In[101]:= ",
 CellID->1419737149,ExpressionUUID->"05e0e9bc-56b1-1bf2-339f-00e6634469d8"],

Cell["\<\
If the eigensystem contains Root objects, symbolic expressions may remain \
unresolved and the computation proceeds using numerical approximations \
instead of exact arithmetic:\
\>", "Text",
 CellID->1515856909,ExpressionUUID->"46408f14-a324-388b-6e7f-2751d6d68ad1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hbroot", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<XI\>\"", " ", "+", " ", "\"\<IX\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hproot", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<ZZ\>\"", " ", "+", " ", 
     RowBox[{"0.6", "*", "\"\<ZI\>\""}], " ", "-", " ", 
     RowBox[{"0.8", "*", "\"\<IZ\>\""}], " ", "+", " ", 
     RowBox[{"0.5", "*", "\"\<XZ\>\""}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[102]:= ",
 CellID->2130236311,ExpressionUUID->"40213c85-9219-7c2b-71de-b5ef27ac4771"],

Cell[BoxData[
 RowBox[{"resroot", " ", "=", " ", 
  RowBox[{"QuantumAdiabaticEvolve", "[", 
   RowBox[{"hbroot", ",", " ", "hproot"}], "]"}]}]], "Input",
 CellLabel->"In[103]:= ",
 CellID->66223118,ExpressionUUID->"678faed4-2cca-f411-0db4-479e457cdf7b"],

Cell[TextData[{
 "Properties contain Root objects and also depend on the time parameter ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["s", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b3cac94-919f-f08d-6ac3-45de202bc2d7"],
 ":"
}], "Text",
 CellID->1801397453,ExpressionUUID->"634a1270-2707-566e-1149-943a52b23cb4"],

Cell[BoxData[
 RowBox[{"resroot", "[", "\"\<EnergyGap\>\"", "]"}]], "Input",
 CellLabel->"In[104]:= ",
 CellID->658220090,ExpressionUUID->"571f0194-b08e-3ab4-7d24-98d1c138889e"],

Cell[TextData[{
 Cell[BoxData["QuantumAdiabaticEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79764466-e076-5945-2f0e-5e4391032baf"],
 " evaluates quantities numerically with finite precision:"
}], "Text",
 CellID->250791599,ExpressionUUID->"54e8dec7-14b1-519a-7c97-d7a19d4423e0"],

Cell[BoxData[
 RowBox[{"resroot", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<MinimalEnergyGap\>\"", ",", 
    " ", "\"\<MaxAdiabaticCoupling\>\""}], "}"}], "]"}]], "Input",
 CellLabel->"In[105]:= ",
 CellID->726989337,ExpressionUUID->"25f5c72f-3423-741a-538a-de89bdd65f60"],

Cell["\<\
This allows the adiabatic evolution to be analyzed correctly:\
\>", "Text",
 CellID->551803451,ExpressionUUID->"6dbbd446-5835-e39a-1b58-ce2059c1b1e0"],

Cell[BoxData[
 RowBox[{"resroot", "[", "\"\<AdiabaticPathPlot\>\"", "]"}]], "Input",
 CellLabel->"In[106]:= ",
 CellID->1081615051,ExpressionUUID->"6d34e655-b983-17e8-14cb-f81f38367d32"],

Cell["Quantum Approximate Optimization Algorithm (QAOA)", "Section",
 CellID->869645169,ExpressionUUID->"5c435daa-0d1c-c5df-0471-54f4a4aeaf25"],

Cell["\<\
The Quantum Approximate Optimization Algorithm (QAOA) is a well-studied \
approach for solving combinatorial optimization problems.\
\>", "Text",
 CellID->1303418848,ExpressionUUID->"21714cd0-c04e-e57a-570f-659df1f8cc40"],

Cell["The QAOA process involves the following steps:", "Text",
 CellID->1706305219,ExpressionUUID->"74ff421b-073b-c6d4-1c85-6445b2cfac3e"],

Cell[TextData[{
 "Defining a Cost Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["C", "TI"]], ":"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ebc3a74-dd7c-3fa6-6643-bc31d40e858c"],
 " This Hamiltonian is designed such that its ground state encodes the \
optimal solution to the combinatorial optimization problem."
}], "Item",
 CellID->1545518015,ExpressionUUID->"7d5c93fe-a057-3a16-2b63-0abbd1e3897c"],

Cell[TextData[{
 "Defining a Mixer Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["M", "TI"]], ":"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "487dadd0-5ed6-7873-7802-449a5b634b59"],
 " This Hamiltonian is used to explore the solution space by driving \
transitions between different states."
}], "Item",
 CellID->481786650,ExpressionUUID->"5219761b-8a64-c9ff-0227-68452f169bc5"],

Cell["Defining the Oracles:", "Item",
 CellID->1253594352,ExpressionUUID->"69346765-6d1c-e9c9-18cc-7f4f04aebb13"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["U", "TI"], 
     StyleBox["C", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["t", "TI"], 
      SubscriptBox[
       StyleBox["H", "TI"], 
       StyleBox["C", "TI"]]}]]}], ",", "\[ThinSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["U", "TI"], 
      StyleBox["M", "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Theta]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[Theta]", "TI"], 
      SubscriptBox[
       StyleBox["H", "TI"], 
       StyleBox["M", "TI"]]}]]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->744538296,ExpressionUUID->"7c22b8c2-70f4-0562-25d1-31ac00816c48"],

Cell["\<\
Applying the Oracles alternately in layers, forming the unitary:\
\>", "Item",
 CellID->339902903,ExpressionUUID->"04fec585-b88c-469b-2c85-dcef39392ce1"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["t", "TI"], ",", 
    StyleBox["\[Theta]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   UnderoverscriptBox["\[Product]", 
    RowBox[{
     StyleBox["i", "TI"], "=", "1"}], 
    StyleBox["N", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["U", "TI"], 
    StyleBox["c", "TI"]], 
   SubscriptBox[
    StyleBox["U", "TI"], 
    StyleBox["M", "TI"]]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1382577677,ExpressionUUID->"7aa617d4-4041-969d-2a5d-8e9e71f5fce7"],

Cell[TextData[{
 "Preparing an Initial State and Applying ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["U", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["t", "TI"], ",", 
     StyleBox["\[Theta]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ":"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e86e5c8-d785-1389-06bd-fc95e23061d3"],
 " The initial state is typically a superposition of all possible states. The \
alternating application of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["U", "TI"], 
   StyleBox["C", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3582ea65-851b-2569-63b1-0c4f2caf8fb3"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["U", "TI"], 
   StyleBox["M", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e81d752-d9a7-cf7a-06be-cf1fd8539240"],
 " evolves this state according to the chosen parameters."
}], "Item",
 CellID->1913035195,ExpressionUUID->"6dc17641-57cc-3497-1bff-682b627e9efd"],

Cell[TextData[{
 "Optimizing Parameters and Measuring: Classical optimization techniques are \
used to adjust the parameters ",
 StyleBox["t ", "TI"],
 "and \[Theta] to maximize the expectation value of the cost Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["C", "TI"]], "."}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "647a9320-5a37-336f-0c19-0a8a5fc381b5"],
 " The measurement of the final state provides an approximate solution to the \
original problem."
}], "Item",
 CellID->1671307962,ExpressionUUID->"57b40e76-1aa6-da65-7d4b-a0309f50a94f"],

Cell["Quantum Combinational Optimization", "Text",
 CellID->741265168,ExpressionUUID->"575b10e3-003a-b957-7d78-89cdb1cc0bbd"],

Cell["\<\
The combinatorial optimization problem involves finding an optimal solution \
from a finite set of possibilities. This problem can be formulated as \
maximizing an objective function, which is expressed as a sum of Boolean \
functions.\
\>", "Text",
 CellID->196765340,ExpressionUUID->"7c7345dd-208f-a284-2401-5c87513bf0ee"],

Cell[TextData[{
 "Each Boolean function ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["i", "TI"]], ":", 
   RowBox[{"{", "0"}], ",", 
   RowBox[{"1", 
    SuperscriptBox["}", 
     StyleBox["n", "TI"]], "\[Rule]", "{", "0"}], ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0121a537-2575-8479-30de-3d714c01ef43"],
 " takes a ",
 StyleBox["n", "TI"],
 "-bit string ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", 
   SubscriptBox[
    StyleBox["z", "TI"], "1"], 
   SubscriptBox[
    StyleBox["z", "TI"], "2"], "\[Ellipsis]", 
   SubscriptBox[
    StyleBox["z", "TI"], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f325126-465a-e19d-26c2-488073ecb3e7"],
 " as input and produces a single bit (0 or 1) as output."
}], "Text",
 CellID->977498757,ExpressionUUID->"739af998-c5c1-31b3-21b9-f0c5ec758399"],

Cell[TextData[{
 "For a problem with ",
 StyleBox["n", "TI"],
 " bits and ",
 StyleBox["m", "TI"],
 " clauses, the goal is to find a ",
 StyleBox["n", "TI"],
 "-bit string ",
 StyleBox["z", "TI"],
 " that maximizes the function:"
}], "Text",
 CellID->1960241259,ExpressionUUID->"003becda-d908-4451-31d8-0587d8bd2ebb"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["i", "TI"], "=", "1"}], 
    StyleBox["m", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->198205207,ExpressionUUID->"7aeb468a-2cc6-59e2-2ae9-5fd445732bc8"],

Cell[TextData[{
 "Approximate optimization aims to find a near-optimal solution to this \
problem, which is often NP-hard. The approximate solution is an ",
 StyleBox["n", "TI"],
 "-bit string ",
 StyleBox["z ", "TI"],
 "that closely maximizes the objective function \|01d436(",
 StyleBox["t)", "TI"],
 "."
}], "Text",
 CellID->954778721,ExpressionUUID->"3873a668-04d7-31ac-6800-3832ad6383f6"],

Cell["Max-Cut Problem", "Subsubsection",
 CellID->276186112,ExpressionUUID->"4156c81a-8a68-59d7-776d-e2442f1d2b3d"],

Cell["\<\
The Max\[Dash]Cut problem is a well-known optimization problem in graph \
theory. The Maximum Cut problem involves partitioning the set of vertices V \
of a graph into two disjoint subsets, such that the number of edges \
connecting nodes in different subsets is maximized.\
\>", "Text",
 CellID->979112453,ExpressionUUID->"569e7ab4-00f8-e339-7ea6-73feb172ce03"],

Cell["Formulating Max-Cut with Classical Binary Variables", "Text",
 CellID->1275520950,ExpressionUUID->"0b3ec616-de69-0141-3ac5-d853db1c53ab"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", " ", "=", " ", 
   RowBox[{"Graph", "[", 
    RowBox[{
     RowBox[{"Range", "[", "4", "]"}], ",", " ", 
     RowBox[{"UndirectedEdge", " ", "@@@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"GraphStyle", " ", "->", " ", "\"\<NameLabeled\>\""}], ",", " ", 
     
     RowBox[{"EdgeStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", " ", "Thick"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"highlited", " ", "=", " ", "\n", "  ", 
   RowBox[{"HighlightGraph", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Subgraph", "[", 
         RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], ")"}], " ", "/@", 
      " ", 
      RowBox[{"Last", "[", 
       RowBox[{"FindMaximumCut", "[", "g", "]"}], "]"}]}], ",", " ", "\n", 
     "   ", 
     RowBox[{"VertexLabels", " ", "->", " ", "\n", "    ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"$CellContext`i", " ", "->", " ", "\n", "      ", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", "$CellContext`i"}], ",", " ", 
           "Center"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"$CellContext`i", ",", " ", "4"}], "}"}]}], "]"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cut", " ", "=", " ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{"Red", ",", " ", "Dashed", ",", " ", "\n", "      ", 
          RowBox[{"BSplineCurve", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1.2"}], ",", " ", 
               RowBox[{"-", "1"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "0.5"}], ",", " ", "1.8"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0.5", ",", " ", "1.8"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"1.2", ",", " ", 
               RowBox[{"-", "1"}]}], "}"}]}], "}"}], "]"}]}], "}"}], "]"}], ",",
        "\n", "     ", "highlited"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1.2"}], ",", " ", "1.2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1.2"}], ",", " ", "1.2"}], "}"}]}], "}"}]}], ",", " ",
      "\n", "   ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{"{", 
   RowBox[{"g", ",", " ", "cut"}], "}"}], "]"}]}], "Input",
 CellLabel->"In[107]:= ",
 CellID->1453852156,ExpressionUUID->"7c0d57bf-7ae8-3253-2433-4ef97e8280b9"],

Cell[TextData[{
 "Consider a graph, our goal is to find a partition ",
 Cell[BoxData["\|01d4c5"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aaecb0d-dff0-cd78-3a55-e356d98a9442"],
 " of the graph's vertices ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fe4a286-576e-fd11-759b-3be06218c47b"],
 " into two sets, ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07179650-9fbb-2bc1-2d2c-081a1a4e792b"],
 " and ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aecd320-e31f-2936-2a93-ca8d96aa781c"],
 " , that maximizes the following cost function that counts the number of \
edges cut. To represent this problem mathematically, we assign each vertex a \
binary variable ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", "\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "326b0854-5043-0b63-6268-a21e61f65649"]
}], "Text",
 CellID->428051484,ExpressionUUID->"1d6edc53-4ce5-e0f2-4b15-d61d6491b2d8"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["C", "TI"], "=", 
    FractionBox["1", "2"], 
    UnderscriptBox["\[Sum]", 
     RowBox[{"\|01d4be", ",", 
      RowBox[{"\|01d4bf", "\[ThinSpace]", "\[Element]", "\[ThinSpace]", 
       StyleBox["V", "TI"]}]}],
     LimitsPositioning->False], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     SubscriptBox[
      StyleBox["s", "TI"], "\|01d4be"], 
     SubscriptBox[
      StyleBox["s", "TI"], "\|01d4bf"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", "\[ThinSpace]", 
   RowBox[{
    StyleBox["s", "TI"], "\[Element]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", 
      RowBox[{"+", "1", "}"}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->916399008,ExpressionUUID->"45f7e4e6-4e1c-a184-738c-fdc06baef3ee"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70e98525-204e-6ba4-2096-1c8f51fb398e"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "704169dd-a4db-5005-207e-8086cd6e236f"],
 " have opposite signs:  The cut contributes to the objective function \
because the vertices are placed in different sets. Mathematically, this \
happens because ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["C", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], "=", "1", "-", 
   SubscriptBox[
    StyleBox["s", "TI"], "\|01d4be"], 
   SubscriptBox[
    StyleBox["s", "TI"], "\|01d4bf"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b2d1c14-5aff-cd5f-2ad2-965e5e8b97a5"],
 "."
}], "Item",
 CellID->958201811,ExpressionUUID->"62ac11c1-6d0b-a8c0-1253-88ab04bffa2a"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e7621e1-2fba-a33a-560d-b8cb4a4c0e00"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15938457-0322-a4d9-43a0-1e11b6d40e23"],
 " have same sign:  Then they remain in the same subset, meaning there is no \
cut and the edge does not contribute to the objective function because ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["C", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], "=", "1", "-", 
   SubscriptBox[
    StyleBox["s", "TI"], "\|01d4be"], 
   SubscriptBox[
    StyleBox["s", "TI"], "\|01d4bf"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f1ed2e3-b722-4b37-2525-cbccc2d7161d"],
 "."
}], "Item",
 CellID->758281744,ExpressionUUID->"52e63e44-9d5c-26a1-029d-b02e14ee8c8b"],

Cell["Solve the classical Max-Cut problem:", "Text",
 CellID->267282080,ExpressionUUID->"6e766a94-5ec6-6187-160d-83de5b7333ed"],

Cell[BoxData[
 RowBox[{"FindMaximumCut", "[", "g", "]"}]], "Input",
 CellLabel->"In[108]:= ",
 CellID->525320152,ExpressionUUID->"2eead67c-41e5-1519-56e9-c82677907c63"],

Cell["This follows the solution given in the first image:", "Text",
 CellID->1343012926,ExpressionUUID->"23a655ec-dad2-e192-515e-4cc9df64b3f8"],

Cell[BoxData["cut"], "Input",
 CellLabel->"In[109]:= ",
 CellID->877538218,ExpressionUUID->"62ef85cc-c62f-39ac-1294-1ca9f3db8bf6"],

Cell["Formulating Max-Cut with Quantum Mechanics", "Text",
 CellID->1440747355,ExpressionUUID->"7d6c313b-6800-4a9b-2b13-a96509b518e1"],

Cell["\<\
To solve the Max-Cut problem on a quantum computer, we need to reformulate it \
in terms of quantum mechanics. Specifically, we convert the classical \
optimization problem into one of finding the eigenstate of a quantum \
Hamiltonian.\
\>", "Text",
 CellID->1362359959,ExpressionUUID->"75dfb56b-bb47-a02b-23e4-2d353ef3f371"],

Cell[TextData[{
 "In the classical case, we represent a solution using a binary string where \
each ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"v", "e", "r", "t", "e", "x"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57533ce7-69d6-be0e-7d60-b5c108600554"],
 " has an associated value ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], "\|01d4be"], "=", "\[PlusMinus]", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27c3fefb-2ee6-8038-4df0-f7a54a90d302"],
 ". In the quantum case, we represent each vertex using a qubit. Since the \
eigenvalues of Z are also \[PlusMinus]1, we map these classical binary \
variables onto the eigenvalues of the Pauli-Z operator."
}], "Text",
 CellID->2112650841,ExpressionUUID->"60d4995f-bb7f-b80c-10eb-11193e0b0b56"],

Cell["\<\
Our goal now shifts from finding a binary string to identifying the \
highest-energy eigenstate of a quantum Hamiltonian.\
\>", "Text",
 CellID->78108254,ExpressionUUID->"64608bbe-760c-8af3-0c1f-22f803bed8d9"],

Cell[TextData[{
 "Max-Cut Hamiltonian obtained by mapping the binary variables ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09661063-a2cf-675e-3f1d-8a4cd77a4da4"],
 " onto Pauli-Z eigenvalues:"
}], "Text",
 CellID->99991631,ExpressionUUID->"5561d787-26b0-8d0a-031e-cee1534ad450"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["C", "TI"]], "=", 
   FractionBox["1", "2"], 
   UnderscriptBox["\[Sum]", 
    RowBox[{"\|01d4be", ",", 
     RowBox[{"\|01d4bf", "\[ThinSpace]", "\[Element]", "\[ThinSpace]", 
      StyleBox["V", "TI"]}]}],
    LimitsPositioning->False], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\|01d7d9", "-", 
    SubscriptBox[
     StyleBox["Z", "TI"], "\|01d4be"], 
    SubscriptBox[
     StyleBox["Z", "TI"], "\|01d4bf"]}], 
   StyleBox[")",
    SpanMaxSize->1]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2135723872,ExpressionUUID->"0fea91e8-e80e-a1ed-35e9-08b589b8f337"],

Cell["where:", "Text",
 CellID->2122331774,ExpressionUUID->"37725419-c8bf-c4cd-5d02-4e42e94bae17"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["Z", "TI"], 
      StyleBox["i", "TI"]], 
     SubscriptBox[
      StyleBox["Z", "TI"], 
      StyleBox["j", "TI"]], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "0"], "\[Ellipsis]", 
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["n", "TI"]]}]},
      "Ket"]}], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"-", "1"}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      SubscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["i", "TI"]]], 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"-", "1"}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      SubscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["j", "TI"]]], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "0"], "\[Ellipsis]", 
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["n", "TI"]]}]},
      "Ket"]}]}], ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["i", "TI"]], "\[Element]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1105063295,ExpressionUUID->"6eee5857-8f9d-bf63-1696-52112a290249"],

Cell[TextData[{
 "We redefine our variables as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["i", "TI"]], "=", "0", "\[ThinSpace]", 
   StyleBox["o", "TI"], 
   StyleBox["r", "TI"], "\[ThinSpace]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2635f536-2fc9-ab3c-4fca-ed704a7df606"],
 "."
}], "Text",
 CellID->49362880,ExpressionUUID->"1b3760e9-4a32-92b2-4acd-79b36fc4e098"],

Cell[TextData[{
 "Considering the initial image, we can implement ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["H", "TI"], 
   StyleBox["C", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fe93a8-4ee9-5b9e-3c85-0af26a9c29e4"],
 ":"
}], "Text",
 CellID->354212003,ExpressionUUID->"11cf5d11-52cc-ddbb-47f5-555b677ea781"],

Cell[BoxData[
 RowBox[{"Hc", " ", "=", " ", 
  RowBox[{"QuantumOperator", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"\"\<IIII\>\"", " ", "-", " ", "\"\<ZZII\>\""}], ")"}]}], " ", "+",
     " ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"\"\<IIII\>\"", " ", "-", " ", "\"\<IZZI\>\""}], ")"}]}], " ", "+",
     " ", "\n", "   ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"\"\<IIII\>\"", " ", "-", " ", "\"\<IIZZ\>\""}], ")"}]}], " ", "+",
     " ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"\"\<IIII\>\"", " ", "-", " ", "\"\<ZIIZ\>\""}], ")"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[110]:= ",
 CellID->353755861,ExpressionUUID->"7ba8138a-66ce-478c-2957-8ad4137b2dd6"],

Cell["\<\
We just need to express the summatory and for each term indicate which qubits \
are connected with a Z operator.\
\>", "Text",
 CellID->1381752550,ExpressionUUID->"35c9e6d4-f3c4-84c1-63f6-ff918676ee2b"],

Cell["Represent each node as a qubit, then we have the bitstring:", "Text",
 CellID->240240661,ExpressionUUID->"6fd66644-13e4-6fa7-15ee-782ea591358d"],

Cell[BoxData[
 PaneBox[
  TemplateBox[{
    RowBox[{
      SubscriptBox[
       StyleBox["x", "TI"], "1"], "\[Ellipsis]", 
      SubscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["n", "TI"]]}]},
   "Ket"],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->717709873,ExpressionUUID->"00abf1cf-696b-3507-30a8-e8a9081f9c6d"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["i", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03d898fe-d35a-9eef-31e7-11bbe6ece435"],
 " or ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["i", "TI"]], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03dda600-4b0b-c3af-31e2-386a6ebf91f5"],
 " if the node is in set ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4de38b79-ee67-8bee-7b90-23228b13d934"],
 " or ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "347cf1ed-0cc4-b4dc-5c03-e8b7a5761e26"],
 "."
}], "Text",
 CellID->1579862385,ExpressionUUID->"7d81b9ce-3a4c-aa2a-2bbe-30a8bffef970"],

Cell[TextData[{
 "For the previous problem, we obtained as solution ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0101"},
    "Ket"], "\[Rule]", 
   StyleBox["C", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bb9b374-9caf-337d-1946-2b3e155b9e47"],
 "."
}], "Text",
 CellID->1519548544,ExpressionUUID->"6c340229-13f4-0181-15cb-a473a58153eb"],

Cell["Understanding QAOA Ansatz", "Text",
 CellID->1310584264,ExpressionUUID->"25dfa134-0866-9bb5-53e4-397ea910e99f"],

Cell["\<\
To implement the Max-Cut problem on a quantum computer, we start by putting \
the nodes in superposition. This ensures that each node (qubit) has an equal \
probability of being in either partition.\
\>", "Text",
 CellID->1486299183,ExpressionUUID->"425139cc-45a5-cefb-726e-b0966c5194c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"superposition", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<00\>\"", ",", " ", "\"\<HH\>\""}], "}"}], ",", " ", "\n", 
     "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "\n", 
      "    ", "\"\<\!\(\*SuperscriptBox[TemplateBox[{\\\"+\\\"},\n\
\\\"Ket\\\"], \(\[TensorProduct]\(4\)\)]\)\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"superposition", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]}], "Input",
 CellLabel->"In[111]:= ",
 CellID->397945072,ExpressionUUID->"4d922994-f334-45bb-7ba1-c0d186c12f81"],

Cell[TextData[{
 "We apply a Hadamard gate (H) to each qubit, This transforms the initial \
state ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06c25578-1780-b25e-2ef2-4d22a23a00a4"],
 " of all qubits into a superposition of all possible cuts:"
}], "Text",
 CellID->1376055927,ExpressionUUID->"5f70617e-b140-9f95-0500-793bc0fae5ff"],

Cell[BoxData[
 RowBox[{"superposition", "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[112]:= ",
 CellID->831978544,ExpressionUUID->"79d0371a-30a6-04e5-2fef-af4441536ecf"],

Cell[BoxData[
 RowBox[{"superposition", "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellLabel->"In[113]:= ",
 CellID->742981267,ExpressionUUID->"7d950d76-dd18-2b24-2baa-a533d4ad760e"],

Cell["\<\
Some initial intuition comes from our first example, which involves \
identifying a periodic pattern, such as 0101 or 1010, within a bitstring.\
\>", "Text",
 CellID->222677598,ExpressionUUID->"7234a9f4-3232-6781-23cb-40be47c74deb"],

Cell["\<\
To achieve this, we need to establish connections between nodes or qubits \
that reflect the structure of the cost Hamiltonian. For this initial idea, we \
can evaluate the gate sequence CNOT + RZ + CNOT.\
\>", "Text",
 CellID->1759027522,ExpressionUUID->"42668d78-f434-72a4-721d-2525fdc1408e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qcrzz", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<CNOT\>\"", ",", " ", 
       RowBox[{
        RowBox[{"\"\<RZ\>\"", "[", "\[Gamma]", "]"}], " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", "\"\<CNOT\>\""}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<Cost\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"qcrzz", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[114]:= ",
 CellID->842995745,ExpressionUUID->"0c7cc198-0ad8-2426-3403-d8c2af528f0c"],

Cell[TextData[{
 "We can verify that it distinguish the ",
 StyleBox["possible", "TI"],
 " correct solutions from the non-periodic bitstrings in order to solve the \
problem:"
}], "Text",
 CellID->826855062,ExpressionUUID->"69698b1d-3dc2-3628-1f16-2347b4749d72"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qcrzz", "[", 
   RowBox[{"QuantumState", "[", "\"\<++\>\"", "]"}], "]"}], 
  "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[115]:= ",
 CellID->1819871389,ExpressionUUID->"701e1eb7-eeba-61c8-2025-97f08b4f3312"],

Cell["\<\
We can gain some initial insights and visualize the differences in the \
solution amplitudes in the following plot:\
\>", "Text",
 CellID->1369109689,ExpressionUUID->"0e322415-281a-3695-37c1-be5f49ac9cff"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"Im", "[", 
       RowBox[{"Values", "[", "#", "]"}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Gamma]", ",", " ", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[Pi]"}], ",", " ", 
       RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", " ", "\n", "   ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"Keys", "[", "#1", "]"}]}], ",", " ", 
     RowBox[{"PlotLabels", " ", "->", " ", 
      RowBox[{"Placed", "[", 
       RowBox[{"Automatic", ",", " ", "Above"}], "]"}]}], ",", " ", "\n", 
     "   ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<Amplitude\>\""}], "}"}]}]}],
     "]"}], " ", "&"}], "@", "\n", " ", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"qcrzz", "[", 
      RowBox[{"QuantumState", "[", "\"\<++\>\"", "]"}], "]"}], 
     "[", "\"\<Amplitudes\>\"", "]"}], "]"}], "[", 
   RowBox[{"[", 
    RowBox[{";;", " ", "2"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[116]:= ",
 CellID->969435735,ExpressionUUID->"61beb272-ef15-9663-1745-343f8aa1fd49"],

Cell["\<\
The concept becomes clearer when we observe that the probabilities of regular \
bitstrings are minimal when the probabilities of periodic bitstrings are \
maximal, and vice versa:\
\>", "Text",
 CellID->2139671006,ExpressionUUID->"5e8a6a96-06b4-6465-0689-83d0b3414f4f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qcrzz", "[", 
   RowBox[{"QuantumState", "[", "\"\<++\>\"", "]"}], "]"}], 
  "[", "\"\<Probability\>\"", "]"}]], "Input",
 CellLabel->"In[117]:= ",
 CellID->2132865528,ExpressionUUID->"55951090-ef25-ccfd-03aa-89dd8ad196c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Values", "[", "#", "]"}], " ", "/.", " ", 
       RowBox[{
        RowBox[{"Im", "[", "\[Gamma]", "]"}], " ", ":>", " ", "\[Gamma]"}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Gamma]", ",", " ", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[Pi]"}], ",", " ", "\n", "    ", 
       RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"Keys", "[", "#1", "]"}]}], ",", " ", "\n", "   ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<Probability\>\""}], "}"}]}],
      ",", " ", "\n", "   ", 
     RowBox[{"PlotLabels", " ", "->", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"#1", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"#1", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", " ", "0.49"}], "}"}]}], 
          "]"}], " ", "&"}], " ", ")"}], " ", "/@", " ", "\n", "     ", 
       RowBox[{"Thread", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Values", "[", "#1", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", 
            RowBox[{"-", "4"}]}], "}"}]}], "}"}], "]"}]}]}]}], "]"}], " ", 
   "&"}], "@", "\n", " ", 
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"qcrzz", "[", 
      RowBox[{"QuantumState", "[", "\"\<++\>\"", "]"}], "]"}], 
     "[", "\"\<Probability\>\"", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{";;", " ", "2"}], "]"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[118]:= ",
 CellID->2076214023,ExpressionUUID->"53a2ca13-da2c-324e-0151-ec5cdfde8094"],

Cell["\<\
The set of gates outlined earlier is commonly referred to as an RZZ gate, \
which combines rotations and controlled operations:\
\>", "Text",
 CellID->1646421792,ExpressionUUID->"5930221d-821b-4026-08cf-c44737ae130c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"\"\<R\>\"", ",", " ", "\[Gamma]", ",", " ", "\"\<ZZ\>\""}], 
     "}"}], "}"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", "\n", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]], "Input",
 CellLabel->"In[119]:= ",
 CellID->498624839,ExpressionUUID->"76ba63e9-5df8-c241-1e5a-7ab3547290ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"\"\<R\>\"", ",", " ", "\[Gamma]", ",", " ", "\"\<ZZ\>\""}], 
     "}"}], "}"}], "]"}], "[", "\"\<Table\>\"", "]"}]], "Input",
 CellLabel->"In[120]:= ",
 CellID->1956171421,ExpressionUUID->"319e51f9-a9ce-1d21-67a6-48a2c87b640b"],

Cell["\<\
Now that we understand this, we can apply it to every pair of qubits \
connected in the graph. In other words, we apply the RZZ gate to every edge \
in the graph. This ensures that the quantum state evolves according to the \
problem constraints.\
\>", "Text",
 CellID->451051907,ExpressionUUID->"26f4962c-805e-a216-4e8b-087631e8f17c"],

Cell["\<\
The previous step does not explore all possible cuts because some amplitudes \
remain unchanged, so we need to mix things a little bit!\
\>", "Text",
 CellID->319345791,ExpressionUUID->"313d5a7b-7caf-7acc-60c3-5c25755a4816"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"miniMixer", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<Mixer\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"miniqaoa", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"qcrzz", ",", " ", "miniMixer"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"miniqaoa", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[121]:= ",
 CellID->702656322,ExpressionUUID->"2da78195-91be-94f0-5b5c-18df2048feda"],

Cell["\<\
Visualize the symbolic function corresponding to each possible state:\
\>", "Text",
 CellID->1752107011,ExpressionUUID->"39c6b7ab-78e0-e73c-6ffd-2ef5789aca06"],

Cell[BoxData[
 RowBox[{
  RowBox[{"miniqaoa", "[", "\"\<Simplify\>\"", "]"}], "[", "\"\<Table\>\"", 
  "]"}]], "Input",
 CellLabel->"In[122]:= ",
 CellID->725895375,ExpressionUUID->"3f7d0c35-7157-44bf-6502-a67f00e22e85"],

Cell[TextData[{
 "Considering the initial state preparation, we recover a ",
 StyleBox["mini", "TI"],
 "-QAOA:"
}], "Text",
 CellID->1726434701,ExpressionUUID->"47b49f91-c3c7-4deb-6d4b-16daf6721731"],

Cell[BoxData[
 RowBox[{
  RowBox[{"miniqaoa", "[", "superposition", "]"}], "[", "\"\<Diagram\>\"", 
  "]"}]], "Input",
 CellLabel->"In[123]:= ",
 CellID->1669114229,ExpressionUUID->"064e3005-d89e-7c03-2e75-aa6ed92b4769"],

Cell["\<\
The increased expressibility of the resulting state from this ansatz, as \
compared to previous circuits, comes from the final mixing performed by the \
mixing layer of gates:\
\>", "Text",
 CellID->1778215125,ExpressionUUID->"76c2caed-aea0-13a2-1ef1-e3b6cb556188"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"miniqaoa", "[", "superposition", "]"}], "[", "\"\<Simplify\>\"", 
   "]"}], "[", "\"\<Table\>\"", "]"}]], "Input",
 CellLabel->"In[124]:= ",
 CellID->1396800808,ExpressionUUID->"260c3025-1fa9-9acd-4e33-a98f9a5de817"],

Cell["\<\
From the following plot, we can observe how the probabilities for regular and \
periodic bitstrings oscillate, similar to the previous plots. The new \
parameter \[Theta] does not interfere with this behavior; instead, it expands \
the parameter space, providing additional expressibility to our ansatz:\
\>", "Text",
 CellID->1288573280,ExpressionUUID->"4b1e6c2c-0452-4134-7925-8676ade7101e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"ComplexExpand", "@", 
       RowBox[{"Values", "[", "#", "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Gamma]", ",", " ", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[Pi]"}], ",", " ", "\n", "    ", 
       RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", " ", 
       RowBox[{"-", "\[Pi]"}], ",", " ", "\[Pi]"}], "}"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"Keys", "[", "#", "]"}]}], ",", " ", "\n", "   ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<\[Theta]\>\"", ",", 
        " ", "\"\<Probability\>\""}], "}"}]}]}], "]"}], " ", "&"}], "@", "\n",
   " ", 
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"miniqaoa", "[", "superposition", "]"}], 
     "[", "\"\<Probabilities\>\"", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{";;", " ", "2"}], "]"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[125]:= ",
 CellID->2122205111,ExpressionUUID->"2982aea8-af87-65d7-5fb1-47f5ca324f3d"],

Cell["Step\[Dash]by\[Dash]Step: 4-Edge Graph Example", "Text",
 CellID->1262138330,ExpressionUUID->"19ac3a5e-0cd6-873c-4f53-bc18a560ea06"],

Cell["Find the Max-Cut for the following graph:", "Text",
 CellID->1378891623,ExpressionUUID->"6e8690e9-968f-68b3-16bd-09b3233a3a99"],

Cell[BoxData[
 RowBox[{"g", " ", "=", " ", 
  RowBox[{"Graph", "[", 
   RowBox[{
    RowBox[{"Range", "[", "4", "]"}], ",", " ", 
    RowBox[{"UndirectedEdge", " ", "@@@", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}], ",", "\n", "   ", 
    RowBox[{"GraphStyle", " ", "->", " ", "\"\<NameLabeled\>\""}], ",", " ", 
    RowBox[{"EdgeStyle", " ", "->", " ", 
     RowBox[{"Directive", "[", 
      RowBox[{"Black", ",", " ", "Thick"}], "]"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[126]:= ",
 CellID->2115785531,ExpressionUUID->"2b6bc1ec-c569-bd9f-5968-d8c9ec1d07e5"],

Cell["Implement the Cost Hamiltonian:", "Text",
 CellID->2041830862,ExpressionUUID->"25f1a39a-81e0-db80-538e-3ac4379aa9ea"],

Cell[BoxData[
 RowBox[{"Hc", " ", "=", " ", 
  RowBox[{"QuantumOperator", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"\"\<IIII\>\"", " ", "-", " ", "\"\<ZZII\>\""}], ")"}]}], " ", "+",
     " ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"\"\<IIII\>\"", " ", "-", " ", "\"\<IZZI\>\""}], ")"}]}], " ", "+",
     " ", "\n", "   ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"\"\<IIII\>\"", " ", "-", " ", "\"\<IIZZ\>\""}], ")"}]}], " ", "+",
     " ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"\"\<IIII\>\"", " ", "-", " ", "\"\<ZIIZ\>\""}], ")"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[127]:= ",
 CellID->1659948011,ExpressionUUID->"35466be2-b7a8-26dc-637d-82cfc2428c26"],

Cell["Initial state preparation for superposition:", "Text",
 CellID->1218359638,ExpressionUUID->"58bdea72-0ba3-5f4c-0842-0c3cae562596"],

Cell[BoxData[
 RowBox[{
  RowBox[{"stateprep", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<0000\>\"", ",", " ", 
       RowBox[{"\"\<H\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], 
         "}"}]}]}], "}"}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "\n", 
      "    ", "\"\<\!\(\*SuperscriptBox[TemplateBox[{\\\"+\\\"},\n\
\\\"Ket\\\"], \(\[TensorProduct]\(4\)\)]\)\>\""}]}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[128]:= ",
 CellID->957029627,ExpressionUUID->"6e8cef58-e908-949c-16b3-070588a2fee6"],

Cell[TextData[{
 "We can use Wolfram Mathematica's ",
 StyleBox["Graph",
  FontWeight->"Bold"],
 " functionalities to establish connections between qubits within the \
Cost-Circuit:"
}], "Text",
 CellID->1501487002,ExpressionUUID->"0abc4047-6c7b-4886-3a44-5a21050e1aec"],

Cell[BoxData[
 RowBox[{"qpairs", " ", "=", " ", 
  RowBox[{"List", " ", "@@@", " ", 
   RowBox[{"EdgeList", "[", "g", "]"}]}]}]], "Input",
 CellLabel->"In[129]:= ",
 CellID->424936060,ExpressionUUID->"24e21d63-fe6b-5877-4c91-954cfb1e2b5d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qcost", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<R\>\"", ",", " ", "\[Gamma]", ",", " ", "\"\<ZZ\>\""}],
           "}"}], " ", "->", " ", "#"}], " ", "&"}], ",", " ", "qpairs"}], 
      "]"}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", "\[Gamma]", "}"}]}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", 
      " ", "\"\<\!\(\*SubscriptBox[\(U\), \(Cost\)]\)\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"qcost", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[130]:= ",
 CellID->295797955,ExpressionUUID->"348d2737-4aeb-e3cb-5cb2-bf716e9fb111"],

Cell["\<\
This layer of gates actually corresponds to the operator generated by the \
Cost Hamiltonian we defined earlier:\
\>", "Text",
 CellID->1393495545,ExpressionUUID->"2161c865-0900-0907-571e-e24fa8b5586d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["c", "TI"]], "=", 
   FractionBox["1", "2"], 
   UnderscriptBox["\[Sum]", 
    RowBox[{"\|01d4be", ",", 
     RowBox[{"\|01d4bf", "\[ThinSpace]", "\[Element]", "\[ThinSpace]", 
      StyleBox["V", "TI"]}]}],
    LimitsPositioning->False], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\|01d7d9", "-", 
    SubscriptBox[
     StyleBox["Z", "TI"], "\|01d4be"], 
    SubscriptBox[
     StyleBox["Z", "TI"], "\|01d4bf"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[Rule]", 
   SubscriptBox[
    StyleBox["U", "TI"], 
    StyleBox[
     RowBox[{"C", "o", "s", "t"}], "TI"]], "=", 
   UnderscriptBox["\[Product]", 
    RowBox[{"\|01d4be", ",", "\|01d4bf"}],
    LimitsPositioning->False], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       StyleBox["i", "TI"], "\[ThinSpace]", 
       StyleBox["t", "TI"]}], "2"], "*", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\|01d7d9", "-", 
      SubscriptBox[
       StyleBox["Z", "TI"], "\|01d4be"], 
      SubscriptBox[
       StyleBox["Z", "TI"], "\|01d4bf"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->941982473,ExpressionUUID->"3cadbe4b-a339-c651-6452-3014d6cdacbb"],

Cell[BoxData[
 RowBox[{"qcost", " ", "==", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"E", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "I", " ", "t"}], ")"}]}], "*", 
    RowBox[{"E", "^", 
     RowBox[{"(", 
      RowBox[{"I", "*", "t", "*", "Hc"}], ")"}]}]}], ")"}]}]], "Input",
 CellLabel->"In[131]:= ",
 CellID->1972337026,ExpressionUUID->"31169419-f57b-983b-672d-0e42fc0feb01"],

Cell["\<\
To ensure full exploration, we need a mixer Hamiltonian that allows \
transitions between different states:\
\>", "Text",
 CellID->273662916,ExpressionUUID->"40aa99e8-53bd-499c-70a9-10b266481be6"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["M", "TI"]], "=", 
   UnderscriptBox["\[Sum]", 
    RowBox[{"\|01d4bf", "\[ThinSpace]", "\[Element]", "\[ThinSpace]", 
     StyleBox["V", "TI"]}],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["X", "TI"], 
    StyleBox["j", "TI"]], "\[Rule]", 
   SubscriptBox[
    StyleBox["U", "TI"], 
    StyleBox[
     RowBox[{"M", "i", "x", "e", "r"}], "TI"]], "=", 
   UnderoverscriptBox["\[Product]", 
    RowBox[{"\|01d4bf", "=", "1"}], 
    StyleBox["n", "TI"],
    LimitsPositioning->False], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Theta]", "TI"], "*", 
     SubscriptBox[
      StyleBox["X", "TI"], "\|01d4bf"]}]]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1779403725,ExpressionUUID->"5d165407-aaf3-867b-0b2e-4e60ce87ed41"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mixer", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], " ", "->", " ", 
       RowBox[{"VertexList", "[", "g", "]"}]}], "}"}], ",", " ", "\n", "   ", 
     
     RowBox[{"\"\<Label\>\"", " ", "->", 
      " ", "\"\<\!\(\*SubscriptBox[\(U\), \(Mixer\)]\)\>\""}], ",", " ", "\n",
      "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", "\[Theta]", "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[132]:= ",
 CellID->70429485,ExpressionUUID->"75cb8946-a0dc-0da7-23c8-2123d169578d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qaoa", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"stateprep", ",", " ", "qcost", ",", " ", "mixer"}], "}"}], ",",
      " ", "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", " ", "\[Gamma]"}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"qaoa", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[133]:= ",
 CellID->1493116229,ExpressionUUID->"63688a50-35e7-99e6-1117-2c1a4393ebcc"],

Cell["\<\
Define the variational states to calculate the Cost function:\
\>", "Text",
 CellID->790021474,ExpressionUUID->"12187c95-2034-8b29-4238-75df51c6d673"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Ket", "[", 
    RowBox[{"{", "\[Phi]", "}"}], "]"}], " ", "=", " ", 
   RowBox[{"qaoa", "[", "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"Bra", "[", 
    RowBox[{"{", "\[Phi]", "}"}], "]"}], " ", "=", " ", 
   RowBox[{"SuperDagger", "[", 
    RowBox[{"Ket", "[", 
     RowBox[{"{", "\[Phi]", "}"}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[134]:= ",
 CellID->337057283,ExpressionUUID->"34b193bd-0a67-a7a6-5c4e-0ae7af130d8c"],

Cell[BoxData[
 RowBox[{"costfunction", " ", "=", " ", "\n", " ", 
  RowBox[{
   RowBox[{"FullSimplify", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"Bra", "[", 
       RowBox[{"{", "\[Phi]", "}"}], "]"}], "@", 
      RowBox[{"Hc", "@", 
       RowBox[{"Ket", "[", 
        RowBox[{"{", "\[Phi]", "}"}], "]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", " ", "\[Gamma]"}], "}"}], " ", "\[Element]", 
      " ", "\n", "    ", "Reals"}]}], "]"}], "[", "\"\<Scalar\>\"", 
   "]"}]}]], "Input",
 CellLabel->"In[135]:= ",
 CellID->57831149,ExpressionUUID->"4fca8ec2-4b73-3b52-75c9-27ac6e0789b8"],

Cell["Let's try out the NMaximize optimizer:", "Text",
 CellID->1835924984,ExpressionUUID->"656925a1-dac3-d209-1316-bc0adf77a153"],

Cell[BoxData[
 RowBox[{"qaoaOpt", " ", "=", " ", 
  RowBox[{"NMaximize", "[", 
   RowBox[{"costfunction", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", " ", "\[Gamma]"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[136]:= ",
 CellID->1260965803,ExpressionUUID->"09e13884-5cc5-f650-3f9e-b1ee5571dcba"],

Cell["Visualize the most probable solutions:", "Text",
 CellID->2114079996,ExpressionUUID->"29829495-262a-abaa-5fb1-0ddf53dcf9f0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qaoa", "[", 
    RowBox[{"<|", 
     RowBox[{"Last", "@", "qaoaOpt"}], "|>"}], "]"}], "[", "]"}], 
  "[", "\"\<ProbabilityPlot\>\"", "]"}]], "Input",
 CellLabel->"In[137]:= ",
 CellID->1069691150,ExpressionUUID->"136212ad-a4c2-b9f3-4111-8bf6cd740bd9"],

Cell[TextData[{
 "We obtain an initial approximate result. We detect that the solutions with \
higher probability are the correct answers. However, the exact solution for \
this problem is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67f6b273-a0bf-ee61-0d8d-343cd14bb54b"],
 ", so we haven't reached the desired outcome yet."
}], "Text",
 CellID->1104099090,ExpressionUUID->"07a2a6c0-d7ac-3784-2d51-3fade25e9dee"],

Cell["\<\
We can enhance the precision of our solution by increasing the number of QAOA \
layers. This is easy to do since we can use QuantumCircuitOperator with the \
previous circuit but replacing the parameters:\
\>", "Text",
 CellID->1781675435,ExpressionUUID->"7d29df82-54ab-6c21-24d6-d6ec5d5e370b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"twolayers", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"stateprep", ",", " ", 
       RowBox[{"qcost", "[", "\[Gamma]1", "]"}], ",", " ", "\n", "    ", 
       RowBox[{
        RowBox[{"mixer", "[", "\[Theta]1", "]"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
       ",", " ", 
       RowBox[{"qcost", "[", "\[Gamma]2", "]"}], ",", " ", "\n", "    ", 
       RowBox[{
        RowBox[{"mixer", "[", "\[Theta]2", "]"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], 
         "}"}]}]}], "}"}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[Gamma]1", ",", " ", "\[Gamma]2", ",", " ", "\[Theta]1", ",", " ", 
        "\[Theta]2"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[138]:= ",
 CellID->360899224,ExpressionUUID->"2673b224-f5d9-a24c-4e00-2b81fc6df096"],

Cell["\<\
We can utilize the Parameters option from the Wolfram Quantum Framework to \
re-name the gate parameters, allowing us to distinguish one layer from \
another.\
\>", "Text",
 CellID->1870248829,ExpressionUUID->"27388ee6-22a7-f122-4ec7-27c05753c008"],

Cell[BoxData[
 RowBox[{"twolayers", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]], "Input",
 CellLabel->"In[139]:= ",
 CellID->848437960,ExpressionUUID->"51cd4bfd-d3fa-9dcf-07f3-62a6e58ce715"],

Cell["Implement the cost function:", "Text",
 CellID->644210089,ExpressionUUID->"06a776cb-b9d0-3c58-2e5d-6f95386a86a2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ket", "[", 
     RowBox[{"{", "\[CapitalPhi]", "}"}], "]"}], " ", "=", " ", 
    RowBox[{"twolayers", "[", "]"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Bra", "[", 
    RowBox[{"{", "\[CapitalPhi]", "}"}], "]"}], " ", "=", " ", 
   RowBox[{"SuperDagger", "[", 
    RowBox[{"Ket", "[", 
     RowBox[{"{", "\[CapitalPhi]", "}"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[140]:= ",
 CellID->1012067904,ExpressionUUID->"7641b941-63e8-8619-1e7e-312b1582ed63"],

Cell[BoxData[
 RowBox[{"costFunction", " ", "=", " ", "\n", " ", 
  RowBox[{
   RowBox[{"FullSimplify", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"Bra", "[", 
       RowBox[{"{", "\[CapitalPhi]", "}"}], "]"}], "@", "\n", "    ", 
      RowBox[{"Hc", "@", 
       RowBox[{"Ket", "[", 
        RowBox[{"{", "\[CapitalPhi]", "}"}], "]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Gamma]1", ",", " ", "\[Gamma]2", ",", " ", "\[Theta]1", ",", " ", 
        RowBox[{"\\\n", "\[Theta]2"}]}], "}"}], " ", "\[Element]", " ", 
      "Reals"}]}], "]"}], "[", "\"\<Scalar\>\"", "]"}]}]], "Input",
 CellLabel->"In[141]:= ",
 CellID->734766532,ExpressionUUID->"42b8cf72-fa81-ffe6-7247-e73fff35c5cc"],

Cell["Optimimize:", "Text",
 CellID->1422368213,ExpressionUUID->"1c8db7a0-3aa3-299f-44b2-2e0abf567be5"],

Cell[BoxData[
 RowBox[{"result", " ", "=", " ", "\n", " ", 
  RowBox[{"NMaximize", "[", 
   RowBox[{"costFunction", ",", " ", 
    RowBox[{"{", 
     RowBox[{
     "\[Theta]1", ",", " ", "\[Theta]2", ",", " ", "\[Gamma]1", ",", " ", 
      "\[Gamma]2"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[142]:= ",
 CellID->830610349,ExpressionUUID->"473593be-64fb-e664-6eca-0af80c8fcd4e"],

Cell["Now, we obtain the exact result.", "Text",
 CellID->1258367624,ExpressionUUID->"79a8e286-b760-8808-2f57-fbe3c21adb52"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"twolayers", "[", 
    RowBox[{"<|", 
     RowBox[{"Last", "@", "result"}], "|>"}], "]"}], "[", "]"}], 
  "[", "\"\<ProbabilityPlot\>\"", "]"}]], "Input",
 CellLabel->"In[143]:= ",
 CellID->351236497,ExpressionUUID->"766f3dde-6e6e-8ae3-1e14-b4980b18d8c9"],

Cell["\<\
This solution represents the cut shown in the first image of this section:\
\>", "Text",
 CellID->1315476664,ExpressionUUID->"7acff19c-f8f8-c05b-2af4-e8d9f97292a1"],

Cell[BoxData[
 RowBox[{"Replace", "[", 
  RowBox[{"cut", ",", " ", 
   RowBox[{
    RowBox[{"-", "1"}], " ", "->", " ", "0"}], ",", " ", 
   RowBox[{"{", "9", "}"}]}], "]"}]], "Input",
 CellLabel->"In[144]:= ",
 CellID->1530528305,ExpressionUUID->"36bb0aa4-099e-3511-5e58-a30ea8289c7b"],

Cell[TextData[{
 "We can see that ",
 Cell[BoxData[
  TemplateBox[{"0101"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fab4322-7f5b-c123-15a9-5a8c7aef9009"],
 " is represented in this image by reading the nodes according to their \
indexing order. A symmetric solution can be obtained by renaming the nodes to \
",
 Cell[BoxData[
  TemplateBox[{"1010"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "559c0528-76f1-864e-03a3-9d720285ec94"],
 ". Ultimately, what matters most is that the qubits are divided into two \
distinct sets, labeled as 0 or 1."
}], "Text",
 CellID->1166714009,ExpressionUUID->"4c3b3e9a-7f95-6e09-75d8-b7c47a203553"],

Cell["Example: 5-Edge Graph", "Text",
 CellID->1981522841,ExpressionUUID->"7b834648-1855-f17e-29b1-581299e1c044"],

Cell["\<\
With a clear understanding of each step involved in solving the Max-Cut \
problem using QAOA, we are now ready to proceed with the direct \
implementation of the solution.\
\>", "Text",
 CellID->47515052,ExpressionUUID->"6aa15cf4-f328-f435-1a5f-55b186c2df1f"],

Cell["Find the Max-Cut for the following graph:", "Text",
 CellID->118900944,ExpressionUUID->"1fa3178e-7287-38be-4550-8ee807338a84"],

Cell[BoxData[
 RowBox[{"g2", " ", "=", " ", 
  RowBox[{"Graph", "[", 
   RowBox[{
    RowBox[{"Range", "[", "4", "]"}], ",", " ", "\n", "  ", 
    RowBox[{"UndirectedEdge", " ", "@@@", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "5"}], "}"}]}], "}"}]}], ",", "\n", "   ", 
    RowBox[{"GraphStyle", " ", "->", " ", "\"\<NameLabeled\>\""}], ",", " ", 
    RowBox[{"EdgeStyle", " ", "->", " ", 
     RowBox[{"Directive", "[", 
      RowBox[{"Black", ",", " ", "Thick"}], "]"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[145]:= ",
 CellID->2141044246,ExpressionUUID->"33c53063-afff-c489-61fa-aa4cc98baed3"],

Cell["\<\
In this more challenging example, we will generate the Hamiltonian \
programmatically instead of writing it explicitly:\
\>", "Text",
 CellID->238643478,ExpressionUUID->"08d8bcb3-70a4-55b3-38e7-35fd01513f99"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"index2", " ", "=", " ", 
   RowBox[{
    RowBox[{"MapApply", "[", 
     RowBox[{"List", ",", " ", 
      RowBox[{"EdgeRules", "[", "g2", "]"}]}], "]"}], " ", "/.", " ", 
    RowBox[{"x_Integer", " ", ":>", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "x"}], "}"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"op\[DoubleStruckOne]2", " ", "=", " ", 
   RowBox[{"StringRepeat", "[", 
    RowBox[{"\"\<I\>\"", ",", " ", 
     RowBox[{"VertexCount", "[", "g2", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"sum2", " ", "=", " ", 
  RowBox[{"Total", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{"op\[DoubleStruckOne]2", " ", "-", " ", "\n", "       ", 
        RowBox[{"StringReplacePart", "[", 
         RowBox[{
         "op\[DoubleStruckOne]2", ",", " ", "\"\<Z\>\"", ",", " ", "#"}], 
         "]"}]}], ")"}]}], " ", "&"}], " ", "/@", " ", "index2"}], 
   "]"}]}]}], "Input",
 CellLabel->"In[146]:= ",
 CellID->728760695,ExpressionUUID->"20e38226-5aed-155d-5090-1b805e987fa7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Hc2", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", "sum2", "]"}]}], ";"}], "\n", 
 RowBox[{"ArrayPlot", "[", 
  RowBox[{
   RowBox[{"Hc2", "[", "\"\<Matrix\>\"", "]"}], ",", " ", 
   RowBox[{"ColorFunction", " ", "->", " ", "\"\<IslandColors\>\""}], ",", 
   " ", "\n", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]}], "Input",
 CellLabel->"In[147]:= ",
 CellID->1018099468,ExpressionUUID->"160727ef-d1b8-0069-3e3c-bec8e04d52b3"],

Cell[TextData[{
 "Implement directly the QAOA circuit using the ",
 StyleBox["Graph ",
  FontWeight->"Bold"],
 "functionalities:"
}], "Text",
 CellID->1977345240,ExpressionUUID->"261df1b1-b81e-57af-4e22-e8fb39ab3df5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qaoa2", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<0\>\"", " ", "->", " ", 
        RowBox[{"VertexList", "[", "g2", "]"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<H\>\"", " ", "->", " ", 
        RowBox[{"VertexList", "[", "g2", "]"}]}], ",", "\n", "    ", 
       RowBox[{"Sequence", " ", "@@", " ", "\n", "     ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             
             RowBox[{"\"\<R\>\"", ",", " ", "\[Gamma]", ",", 
              " ", "\"\<ZZ\>\""}], "}"}], " ", "->", " ", "#"}], " ", "&"}], ",",
           " ", 
          RowBox[{"List", " ", "@@@", " ", 
           RowBox[{"EdgeList", "[", "g2", "]"}]}]}], "]"}]}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], " ", "->", " ", 
        RowBox[{"VertexList", "[", "g2", "]"}]}]}], "\n", "    ", "}"}], ",", 
     "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "None"}], ",", " ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", " ", "\[Gamma]"}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[148]:= ",
 CellID->133342556,ExpressionUUID->"00ba9d2f-c328-50fc-3059-1488f6dd22c6"],

Cell[BoxData[
 RowBox[{"qaoa2", "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[149]:= ",
 CellID->723341412,ExpressionUUID->"02964792-f196-8b6e-32ae-5edf8020d9b4"],

Cell["\<\
Implement the symbolic cost function using the Cost Hamiltonian and the \
resulting parametrized state from the previous circuit:\
\>", "Text",
 CellID->263355689,ExpressionUUID->"166d4e5f-4333-9385-3e13-601976c7e1ef"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ket", "[", 
     RowBox[{"{", "\[Phi]2", "}"}], "]"}], " ", "=", " ", 
    RowBox[{"qaoa2", "[", "]"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Bra", "[", 
    RowBox[{"{", "\[Phi]2", "}"}], "]"}], " ", "=", " ", 
   RowBox[{"SuperDagger", "[", 
    RowBox[{"Ket", "[", 
     RowBox[{"{", "\[Phi]2", "}"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[150]:= ",
 CellID->720085371,ExpressionUUID->"1c99ee20-d785-d362-44a6-078de231be48"],

Cell[BoxData[
 RowBox[{"costfunction2", " ", "=", " ", "\n", " ", 
  RowBox[{
   RowBox[{"FullSimplify", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"Bra", "[", 
       RowBox[{"{", "\[Phi]2", "}"}], "]"}], "@", 
      RowBox[{"Hc2", "@", 
       RowBox[{"Ket", "[", 
        RowBox[{"{", "\[Phi]2", "}"}], "]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Gamma]", ",", " ", "\[Theta]"}], "}"}], " ", "\[Element]", 
      " ", "\n", "    ", "Reals"}]}], "]"}], "[", "\"\<Scalar\>\"", 
   "]"}]}]], "Input",
 CellLabel->"In[151]:= ",
 CellID->2050359490,ExpressionUUID->"60858f89-56d8-6615-10ba-26d3636d4d7f"],

Cell[TextData[{
 "Use ",
 StyleBox["NMaximize",
  FontWeight->"Bold"],
 " for the optimization:"
}], "Text",
 CellID->126242720,ExpressionUUID->"2e45545e-c429-efe4-567b-4e1bedddb5ce"],

Cell[BoxData[
 RowBox[{"result2", " ", "=", " ", 
  RowBox[{"NMaximize", "[", 
   RowBox[{"costfunction2", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", " ", "\[Gamma]"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[152]:= ",
 CellID->1931985535,ExpressionUUID->"24564246-a2b2-7a9b-4c6e-6423d74748e1"],

Cell["\<\
We obtain multiple possible solutions; however, with just a single QAOA \
layer, we observe four solutions with higher probability:\
\>", "Text",
 CellID->431389196,ExpressionUUID->"273d1382-afb1-09c0-4ec2-8aefca445b2a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"qaoa2", " ", "@@", " ", 
    RowBox[{"Values", "[", 
     RowBox[{"Last", "[", "result2", "]"}], "]"}]}], ")"}], "[", 
  RowBox[{"\"\<ProbabilityPlot\>\"", ",", " ", 
   RowBox[{"BarOrigin", " ", "->", " ", "Left"}], ",", "\n", "  ", 
   RowBox[{"\"\<Range\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{".02", ",", " ", "1"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[153]:= ",
 CellID->508842608,ExpressionUUID->"39c9e52f-ed06-87fb-6ff6-fc8884b0edc1"],

Cell["Solve it clasically:", "Text",
 CellID->745134935,ExpressionUUID->"46be6341-4be3-06d9-6e46-7b2b6d966c23"],

Cell[BoxData[
 RowBox[{"FindMaximumCut", "[", "g2", "]"}]], "Input",
 CellLabel->"In[154]:= ",
 CellID->580541475,ExpressionUUID->"352b8971-1d3f-d4c9-6328-213b94cbbe13"],

Cell["\<\
The quantum algorithm does not achieve the maximum value compared to the \
classical solution, but we can analyze the four most probable solutions \
indicated by the ProbabilityPlot:\
\>", "Text",
 CellID->2074312001,ExpressionUUID->"227c7e4b-1c68-aac8-5204-70159502f812"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReverseSortBy", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"qaoa2", " ", "@@", " ", 
        RowBox[{"Values", "[", 
         RowBox[{"Last", "[", "result2", "]"}], "]"}]}], ")"}], 
      "[", "\"\<Probabilities\>\"", "]"}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"#", "[", 
      RowBox[{"[", "\n", "    ", "2", "]"}], "]"}], " ", "&"}]}], "]"}], "[", 
  
  RowBox[{"[", 
   RowBox[{";;", " ", "4"}], "]"}], "]"}]], "Input",
 CellLabel->"In[155]:= ",
 CellID->1926769728,ExpressionUUID->"6cd9b5a9-dbed-51da-14e6-2cf2dd982320"],

Cell[TextData[{
 "Following the labels in the vertex, the solution ",
 Cell[BoxData[
  TemplateBox[{"10110"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4becebe3-5bfe-fac0-7993-02cd5d88c82a"],
 " is the one found by the classical method. The following diagram \
corresponds to this solution:"
}], "Text",
 CellID->434783908,ExpressionUUID->"312d182f-c6c7-5e1e-60d2-9188f3722564"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"maxcut2", " ", "=", " ", "\n", " ", 
   RowBox[{"HighlightGraph", "[", 
    RowBox[{"g2", ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Subgraph", "[", 
         RowBox[{"g2", ",", " ", "#1"}], "]"}], " ", "&"}], ")"}], " ", "/@", 
      " ", 
      RowBox[{"Last", "[", 
       RowBox[{"FindMaximumCut", "[", "g2", "]"}], "]"}]}], ",", " ", "\n", 
     "  ", 
     RowBox[{"VertexLabels", " ", "->", " ", "\n", "   ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Thread", " ", "/@", " ", "\n", "     ", 
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"Last", "[", "\n", "        ", 
           RowBox[{"FindMaximumCut", "[", "$CellContext`g2", "]"}], "]"}], 
          " ", "->", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Placed", "[", 
              RowBox[{"#1", ",", " ", "\n", "           ", "Center"}], "]"}], 
             " ", "&"}], " ", ")"}], " ", "/@", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "1"}], "}"}]}]}], "]"}]}], "]"}]}]}], 
    "]"}]}], ";", " ", 
  RowBox[{"cut2", " ", "=", " ", "\n", " ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"maxcut2", ",", " ", "\n", "   ", 
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{"Red", ",", " ", "Dashed", ",", " ", "\n", "     ", 
          RowBox[{"BSplineCurve", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", " ", "1.5"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"3", ",", " ", 
               RowBox[{"-", "2.5"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "0.1"}], ",", " ", "3"}], "}"}]}], "}"}], "]"}]}],
          "}"}], "]"}]}], "}"}], ",", " ", "\n", "  ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.3"}], ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.5"}], ",", " ", "1.5"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", 
      RowBox[{"10", "^", "2.6"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g2", ",", " ", "cut2"}], "}"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]}], "Input",
 CellLabel->"In[156]:= ",
 CellID->1093515459,ExpressionUUID->"1449d45f-8382-90b9-3c76-ce193634e283"],

