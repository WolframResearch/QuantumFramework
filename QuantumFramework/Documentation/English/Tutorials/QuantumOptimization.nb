Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     StyleBox["x", "TI"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["V", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Omega]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     TemplateBox[{"0"},
      "Ket"]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["[",
