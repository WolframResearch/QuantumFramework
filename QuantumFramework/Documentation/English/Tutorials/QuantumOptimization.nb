 RowBox[{
  RowBox[{"generatorMatrix", "[", "\[Theta]1_", "]"}], " ", "=", " ", "\n", 
  " ", 
  RowBox[{
   RowBox[{
    RowBox[{"generator", "[", 
     RowBox[{"<|", 
