Cell[BoxData[
 RowBox[{
  RowBox[{"Ub", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<H\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "}"}], ",", " ",
      "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", 
      " ", "\"\<\!\(\*SubscriptBox[\(U\), \(b\)]\)\>\""}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[328]:= ",
 CellID->466005007,ExpressionUUID->"3f3745d9-f640-89cf-66cd-5c8283fadb15"],

Cell[TextData[{
 "In this case we have multiple controlled ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["A", "TI"], 
   StyleBox["l", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2af3e211-783e-5495-5a80-045b79cb3eff"],
 " gates to perform the Hardamard\[Dash]test and controlled ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["Z", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "526c503f-6148-6cb6-0214-4a7910fd369c"],
 " gates as the previous example, so we will directly implement an optimized \
version of the circuit using KroneckerProduct:"
}], "Text",
 CellID->68867736,ExpressionUUID->"3a901ca6-02d7-1d1b-6aaf-9500b7626461"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ControlledGateA", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumOperator", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"QuantumOperator", "[", "\"\<I\>\"", "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"l", ",", " ", "2"}], "]"}]}], " ", "+", " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
          RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "3"}], "}"}]}]}], "}"}], "]"}], "*", "\n", 
       "     ", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"l", ",", " ", "3"}], "]"}]}], " ", "+", " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}], "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"l", ",", " ", "4"}], "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", "l", "}"}]}], ",", "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", 
      " ", "\"\<Controlled \!\(\*SubscriptBox[\(A\), \(l\)]\) Gate\>\""}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[329]:= ",
 CellID->2064232452,ExpressionUUID->"0decacba-7d10-76c3-3b93-45e474a55c29"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ControlledGateZ", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j", ",", " ", "2"}], "]"}]}], " ", "+", " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j", ",", " ", "3"}], "]"}]}], " ", "+", " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "4"}], "}"}]}], "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j", ",", " ", "4"}], "]"}]}], " ", "+", " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", "\"\<I\>\"", "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j", ",", " ", 
         RowBox[{"-", "1"}]}], "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", "j", "}"}]}], ",", "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", 
      " ", "\"\<Controlled \!\(\*SubscriptBox[\(Z\), \(j\)]\) Gate\>\""}]}], 
    "\n", "   ", "]"}]}], ";"}]], "Input",
 CellLabel->"In[330]:= ",
 CellID->1869165111,ExpressionUUID->"256534ec-e492-cc88-531a-adc98d2496d2"],

Cell[TextData[{
