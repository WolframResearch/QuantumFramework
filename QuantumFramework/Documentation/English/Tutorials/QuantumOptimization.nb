     "491026a6-dd30-329c-7f2f-bf03d4ca80e6"]], "TableText",ExpressionUUID->
     "78f9e5c0-5bc5-e73b-2886-fcaa5e71ca01"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
