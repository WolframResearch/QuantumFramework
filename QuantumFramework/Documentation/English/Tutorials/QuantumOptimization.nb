Cell["Let\[CloseCurlyQuote]s define some helping functions:", "Text",
 CellID->2131394165,ExpressionUUID->"151d482b-bd7d-21e9-4323-627534087333"],

Cell[BoxData[
 RowBox[{
  RowBox[{"variance", "[", 
   RowBox[{"state_", ",", " ", "\n", "  ", "qmo_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], ")"}], " ", "&"}], "@", 
    "\n", "   ", 
    RowBox[{"Values", "[", 
     RowBox[{
      RowBox[{"qmo", "[", "state", "]"}], "[", "\"\<Probabilities\>\"", "]"}],
      "]"}]}], " ", "//", " ", "N"}]}]], "Input",
 CellLabel->"In[262]:= ",
 CellID->373842945,ExpressionUUID->"5613a8b7-1620-2919-7e20-41f1a3d57863"],

Cell[BoxData[
 RowBox[{
  RowBox[{"covariance", "[", 
   RowBox[{"state_", ",", " ", "qmo1_", ",", " ", "\n", "  ", "qmo2_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "4", "]"}], "]"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "+", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}], ")"}]}]}], ")"}], " ", "&"}], "@",
     "\n", "   ", 
    RowBox[{"Values", "[", 
     RowBox[{
      RowBox[{"qmo2", "[", 
       RowBox[{"qmo1", "[", "state", "]"}], "]"}], 
      "[", "\"\<Probabilities\>\"", "]"}], "]"}]}], " ", "//", " ", 
   "N"}]}]], "Input",
 CellLabel->"In[263]:= ",
 CellID->340761576,ExpressionUUID->"5ae8fe52-8d2a-0d13-0a97-f01c24df5479"],

Cell["Calculate the first layer using the following formula:", "Text",
