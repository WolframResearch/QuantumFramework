Cell["Ansatz variational circuit:", "Text",
 CellID->105423310,ExpressionUUID->"143db07b-777b-32d6-3dc2-2a25020f803c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VariationalBlock", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<Hadamard\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Omega]1", "]"}], " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Omega]2", "]"}], " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", "\n", "    ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Omega]3", "]"}], " ", "->", " ", 
        RowBox[{"{", "3", "}"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Omega]4", "]"}], " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Omega]5", "]"}], " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", "\n", "    ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Omega]6", "]"}], " ", "->", " ", 
        RowBox[{"{", "3", "}"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Omega]7", "]"}], " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Omega]8", "]"}], " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", "\n", "    ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Omega]9", "]"}], " ", "->", " ", 
        RowBox[{"{", "3", "}"}]}]}], "\n", "    ", "}"}], ",", "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<V(\[Omega])\>\""}], ",", 
     " ", "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\[Omega]3", ",", " ", 
        "\[Omega]4", ",", " ", 
        RowBox[{"\\\n", "\[Omega]5"}], ",", " ", "\[Omega]6", ",", " ", 
        "\[Omega]7", ",", " ", "\[Omega]8", ",", " ", "\[Omega]9"}], 
       "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[361]:= ",
 CellID->886368806,ExpressionUUID->"78b7e50c-4773-01ae-284c-fd56720653f4"],

Cell[TextData[{
 "In order to obtain ",
