Cell["Classiq Integration", "Section",
 CellID->1694365793,ExpressionUUID->"21898f1f-7ce2-17d9-57b6-275974977d23"],

Cell["Register an account with Classiq", "Subsubsection",
 CellID->605124715,ExpressionUUID->"4692cd91-7435-14b3-6ea1-e4db7dc07e99"],

Cell[TextData[{
 "In order to authenticate with the Classiq servers, you will need to follow ",
 ButtonBox["Classiq's registration instructions",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://docs.classiq.io/latest/classiq_101/registration_\
installations/"], None}],
 ", and be logged in to https://platform.classiq.io/"
}], "Text",
 CellID->988255153,ExpressionUUID->"000a09f6-5b3f-ef45-3009-a0b05ecbb5af"],

Cell["\<\
This takes less than five minutes. Much of Classiq\[CloseCurlyQuote]s library \
can be used without registration. However, the circuit synthesis and state \
vector simulation for a very large circuit will require this registration and \
authentication step.\
\>", "Text",
 CellID->280321589,ExpressionUUID->"29133634-70e6-2af3-5f20-a87e009378d9"],

Cell["\<\
from classiq import authenticate
authenticate(overwrite=True)\
\>", "Program",
 CellID->1975386872,ExpressionUUID->"59a11c54-6c5b-70c2-0f5e-961e05ee4228"],

Cell["Functionalities", "Subsubsection",
 CellID->1420024112,ExpressionUUID->"2480a9a0-11fa-1869-4cbf-400aa78f6ab3"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4bc2c5e6-2df7-f0b4-79f1-dcc04b83c29e"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"2d4459f2-9267-9bdb-5b7c-50bc2713e921"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"2830cc4d-ff27-6d9e-59cf-e616fad237e4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "28a95ddb-d98e-e41c-5857-5484d838cf66"], Cell[TextData[Cell[BoxData[
     RowBox[{"ClassiqSetup", "[", 
      RowBox[{"prop", ",", "opts"}], "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0df78371-259d-4014-3b8c-1b3b4c28137e"]], "TableText",ExpressionUUID->
     "2757147d-ed01-5031-4d6c-8e2684b4231b"], Cell["\<\
This support function automates the installation and management of the \
Classiq platform within a dedicated Python session embedded in Wolfram \
Mathematica.\
\>", "TableText",ExpressionUUID->"0d7703a7-7e82-d2bb-3b0c-9a017b34a081"]}
  }]], "2ColumnTableMod",
 CellID->1520648670,ExpressionUUID->"313bd3d6-a81b-5e6e-60d8-ca93c9ae24b4"],

Cell["\<\
You can run the following line to install Classiq and retrieve information \
about the Python session that will be used for subsequent operations:\
\>", "Text",
 CellID->1342263618,ExpressionUUID->"25416759-7698-4697-537f-7f03032d2cfd"],

Cell[BoxData[
 RowBox[{"classiq", " ", "=", " ", 
  RowBox[{"ClassiqSetup", "[", "]"}]}]], "Input",
 CellID->1494450007,ExpressionUUID->"0a04e1f2-9872-3cce-3a3b-f8bc19048614"],

Cell[BoxData[
 RowBox[{"session", " ", "=", " ", 
  RowBox[{"classiq", "[", "\"\<Session\>\"", "]"}]}]], "Input",
 CellLabel->"In[482]:= ",
 CellID->815475822,ExpressionUUID->"55e5145d-e893-2f9b-039a-8e06892675e1"],

Cell["Properties", "Subsubsection",
 CellID->1657960501,ExpressionUUID->"6ed6f41e-2589-ab78-16ed-ee584c3df642"],

