     "37161f66-4600-a3a8-5d2d-974073baf1f2"], Cell[TextData[{
     "interpolating Hamiltonian ",
     Cell[BoxData[
      RowBox[{
       StyleBox["H", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["s", "TI"], 
       StyleBox[")",
        SpanMaxSize->1], "=", 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "-", 
        StyleBox["s", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1], 
       SubscriptBox[
        StyleBox["H", "TI"], "0"], "+", 
