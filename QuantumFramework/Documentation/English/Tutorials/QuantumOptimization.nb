Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Fit", "[", 
     RowBox[{"generatorGradient", ",", " ", "\n", "    ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "n", " ", "\[Theta]"}], "]"}], ",", " ", 
