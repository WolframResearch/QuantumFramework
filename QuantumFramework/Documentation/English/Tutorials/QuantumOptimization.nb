       SubscriptBox[
        StyleBox["R", "TI"], 
        StyleBox["y", "TI"]], 
       RowBox[{
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         SubscriptBox[
          StyleBox["\[Omega]", "TI"], "1"], 
         StyleBox[")",
          SpanMaxSize->1]}], "\[CircleTimes]", 
        SubscriptBox[
         StyleBox["R", "TI"], 
