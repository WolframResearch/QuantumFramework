          SpanMaxSize->1]}], "\[CircleTimes]", 
        SubscriptBox[
         StyleBox["R", "TI"], 
         StyleBox["y", "TI"]]}], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        SubscriptBox[
         StyleBox["\[Omega]", "TI"], "4"], 
        StyleBox[")",
         SpanMaxSize->1]}]}], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     SubscriptBox[
      StyleBox["H", "TI"], "2"], 
     SubscriptBox[
      StyleBox["H", "TI"], "3"], 
     SubscriptBox[
      StyleBox["H", "TI"], "4"], 
     TemplateBox[{"0"},
      "Ket"]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2062326348,ExpressionUUID->"038c2d24-7693-7bfc-31b3-c48e032649c6"],

