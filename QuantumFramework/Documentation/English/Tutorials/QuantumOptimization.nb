Cell[BoxData[
 RowBox[{
  RowBox[{"VariationalBlock", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<Hadamard\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Omega]1", "]"}], " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Omega]2", "]"}], " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", "\n", "    ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Omega]3", "]"}], " ", "->", " ", 
        RowBox[{"{", "3", "}"}]}]}], "\n", "    ", "}"}], ",", "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<V(\[Omega])\>\""}], ",", 
     "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\[Omega]3"}], 
       "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[331]:= ",
 CellID->172379513,ExpressionUUID->"14b48af2-5d27-861c-3c4b-23bc54d3ed66"],

Cell[TextData[{
 "In order to obtain ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Mu]", "TI"], 
   RowBox[{
    StyleBox["l", "TI"], "\[ThinSpace]", ",", "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["l", "TI"], "\[Prime]"], ",", "\[ThinSpace]", 
    StyleBox["j", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72f98829-a4e0-9e42-2286-2272cc9ae4a8"],
 " we will implement a circuit that will deploy a Hadamard test:"
}], "Text",
 CellID->561102974,ExpressionUUID->"1350650b-6691-6e3e-4160-7d5513243504"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "LocalHadamardCircuit", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"LocalHadamardCircuit", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<Hadamard\>\"", " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<P\>\"", "[", "\[Theta]", "]"}], ",", "\n", "    ", 
       RowBox[{"VariationalBlock", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], ",", "\n", 
       "    ", "ControlledGateA", ",", "\n", "    ", "Ub", ",", "\n", "    ", 
       "ControlledGateZ", ",", "\n", "    ", "Ub", ",", "\n", "    ", 
       RowBox[{"ControlledGateA", "[", 
        RowBox[{"<|", 
         RowBox[{"l", " ", "->", " ", "lp"}], "|>"}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"\"\<Hadamard\>\"", " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}]}], "\n", "    ", "}"}], ",", " ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\[Omega]3", ",", " ", 
        "l", ",", " ", "lp", ",", " ", "\n", "     ", "j", ",", " ", 
        "\[Theta]"}], "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[332]:= ",
 CellID->410193546,ExpressionUUID->"532d51c4-b79b-7573-02d3-48a1c22e5c59"],

Cell[BoxData[
 RowBox[{"LocalHadamardCircuit", "[", 
