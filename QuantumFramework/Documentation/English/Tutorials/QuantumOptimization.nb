Cell["Given the following partition:", "Text",
 CellID->1206419202,ExpressionUUID->"142f588d-e120-bc70-3dd5-51d690da075a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"subgraphs", " ", "=", " ", "\n", "  ", 
