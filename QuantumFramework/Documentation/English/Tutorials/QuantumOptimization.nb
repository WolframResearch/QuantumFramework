    "ComplexExpand"}], " ", "//", " ", 
  RowBox[{
   RowBox[{"Chop", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "2"}]}]}], "]"}], " ", "&"}]}]], "Input",
 CellLabel->"In[200]:= ",
