Cell["\<\
Cerezo, M., Arrasmith, A., Babbush, R. et al. Variational quantum algorithms. \
Nat Rev Phys 3, 625\[Dash]644 (2021)\
\>", "Text",
 CellID->1164297175,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell["\<\
Now, rather than just describing it, let\[CloseCurlyQuote]s dive into \
parametrized circuits!\
\>", "Text",
 CellID->632614636,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell["Variational Circuits", "Section",
 CellID->1689610856,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell[TextData[{
 "The area of Quantum Optimization depends heavily in variational algorithms. \
This algorithms work by exploring and comparing variational states ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["\[Phi]", "TI"], 
      StyleBox["(", SpanMaxSize -> 1], 
      StyleBox["\[Theta]", "TI"], 
      StyleBox[")", SpanMaxSize -> 1]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],
 " that depends on a set of ",
 Cell[BoxData[
  RowBox[{"{", "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubscriptBox["}", 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 " parameters."
}], "Text",
 CellID->1303163127,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell[TextData[{
 "You can build this variational states using a fixed initial state as ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf5a20e-c541-e06e-698a-446becf5b2b4"],
 " and a parametrized or variational quantum circuit ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Theta]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07964fa7-8d1e-ff14-2dae-660124a8c27e"],
 ":"
}], "Text",
 CellID->2098230307,ExpressionUUID->"3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Phi]", "TI"], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["\[Theta]", "TI"], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Ket"], "=", 
   RowBox[{
    StyleBox["V", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Theta]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{"0"},
     "Ket"]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1930159659,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell["\<\
We aim to train these variational quantum circuits using an optimizer in \
conjunction with a cost function that reflects the objective of our \
optimization. Many of the algorithms presented here are Hybrid Algorithms, \
meaning they combine a quantum circuit with a classical optimizer.\
\>", "Text",
 CellID->1113655915,ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell[TextData[{
 "Wolfram Quantum Framework supports ",
 StyleBox["\"free parameters\"", "TI"],
 " in their quantum circuits. In order to implement a variational quantum \
circuit, you only need to specify this tunable parameters by using the \
\"Parameters\" option:"
}], "Text",
 CellID->1606118752,ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vqc", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<00\>\"", ",", " ", 
       RowBox[{
        RowBox[{"\"\<RX\>\"", "[", "\[Theta]1", "]"}], " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", " ", "\n", "    ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Theta]2", "]"}], " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}]}], "}"}], ",", " ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[Theta]1", ",", " ", "\[Theta]2"}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->2141499446,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell[BoxData[
 RowBox[{"vqc", "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->339082558,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell[TextData[{
 "The parameters defined for a Wolfram Quantum Framework Operator are \
heritable, so you do not need to redefine it in later steps. For example we \
can calculate the resultant ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["\[Phi]", "TI"], 
      StyleBox["(", SpanMaxSize -> 1], 
      StyleBox["\[Theta]", "TI"], 
      StyleBox[")", SpanMaxSize -> 1]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c358d3e-86d3-ec5f-75ca-25783367b6a5"],
 " state from our defined variational circuit:"
}], "Text",
 CellID->432388834,ExpressionUUID->"1f908cf3-3c70-d55a-45af-25bdb50abfa0"],

Cell[BoxData[
 RowBox[{"vqs", " ", "=", " ", 
  RowBox[{"vqc", "[", "]"}]}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->443736588,ExpressionUUID->"5dac66ba-272d-3627-0b54-7fe452d99d0d"],

Cell["We can verify that the \"Parameters\" option values:", "Text",
 CellID->1593449978,ExpressionUUID->"110914de-bbdd-83a1-4736-8d983e69d18b"],

Cell[BoxData[
 RowBox[{"vqs", "[", "\"\<Parameters\>\"", "]"}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->1742646261,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell["\<\
This option simplifies the repeated execution of the circuit by using the \
symbolic computation capabilities provided by the Wolfram Quantum Framework:\
\>", "Text",
 CellID->29467524,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell[BoxData[
 RowBox[{"vqc", "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->1939141443,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell["Replace \[Theta]1 value as follows:", "Text",
 CellID->5047578,ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vqc", "[", 
   RowBox[{"<|", 
    RowBox[{"\[Theta]1", " ", "->", " ", "0"}], "|>"}], "]"}], 
  "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->15008895,ExpressionUUID->"65de4a87-3471-cd9f-13e6-63e1bd0597e5"],

Cell["\<\
As mentioned earlier, you can use the parameters at any stage of your \
algorithm, as they are carried through each step:\
\>", "Text",
 CellID->1892712309,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell[BoxData[
 RowBox[{"vqs", "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->787969749,ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vqs", "[", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\[Theta]2", " ", "->", " ", "0"}], ",", " ", 
     RowBox[{"\[Theta]1", " ", "->", " ", "0"}]}], "|>"}], "]"}], 
  "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->525088789,ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"],

Cell["\<\
You can directly replace the values for each parameter following the same \
order you defined them:\
\>", "Text",
 CellID->357930410,ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vqs", "[", 
   RowBox[{"0", ",", " ", "0"}], "]"}], "[", "\"\<Formula\>\"", 
  "]"}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->1802489801,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vqs", "[", 
   RowBox[{"a", ",", " ", "b"}], "]"}], "[", "\"\<Formula\>\"", 
  "]"}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->115301326,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell["\<\
In the following sections, we will explore variational algorithms, which will \
require an understanding of how to properly design (ansatz circuits) and \
train (classical optimizers) these variational circuits.\
\>", "Text",
 CellID->1651187567,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell["Initial State Preparation", "Subsection",
 CellID->941376513,ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell[TextData[{
 "A reference state serves as the fixed starting point for our problem. To \
prepare a reference state, we apply a non-parameterized unitary gate ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["U", "TI"], 
   StyleBox["R", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1c99a5-dcef-9c28-1623-100ed49be772"],
 "\:200b at the beginning of our quantum circuit, ensuring that our initial \
state is given by:"
}], "Text",
 CellID->2120243592,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell[TextData[Cell[BoxData[
 RowBox[{"|", 
  SubscriptBox["\[Psi]", 
   StyleBox["i", "TI"]], "\[RightAngleBracket]", "\[LongEqual]", 
  SubscriptBox[
   StyleBox["U", "TI"], 
   StyleBox["R", "TI"]], 
  RowBox[{"|", "0"}], "\[RightAngleBracket]"}]], "InlineFormula",
 FontSize->0.9 
  Inherited,ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"]], "Text",
 CellID->1047559317,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell["\<\
If you have an educated guess or an existing optimal solution, using it as \
the reference state can help the variational algorithm converge faster.\
\>", "Text",
 CellID->1820947576,ExpressionUUID->"337c2d89-644e-5b5e-6103-c4d30dfb29a4"],

Cell["\<\
The simplest reference state is the default state, where we initialize an \
n-qubit quantum circuit in the all-zero state:\
\>", "Text",
 CellID->670734585,ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],

Cell[TextData[Cell[BoxData[
 RowBox[{"|", 
  SubscriptBox["\[Psi]", 
   StyleBox["i", "TI"]], "\[RightAngleBracket]", "\[LongEqual]", 
  RowBox[{"|", "0"}], 
  SuperscriptBox["\[RightAngleBracket]", 
   RowBox[{"\[CircleTimes]", 
    StyleBox["n", "TI"]}]], 
  RowBox[{",", " "}], 
  SubscriptBox[
   StyleBox["U", "TI"], 
   StyleBox["R", "TI"]], "\[LongEqual]", 
  StyleBox["1",
   FontSlant->"Plain"]}]], "InlineFormula",
 FontSize->0.9 
  Inherited,ExpressionUUID->"644cc522-c7c4-9b18-0c73-dc8ff276e662"]], "Text",
 CellID->58232708,ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],

Cell["\<\
For this default state, our unitary operator is simply the identity operator. \
Due to its simplicity, this default state is widely used as a reference state \
in many applications.\
\>", "Text",
 CellID->393464600,ExpressionUUID->"6801f052-da94-0b6f-183e-ea1fdf2159b5"],

Cell["\<\
If we want to start with a more complex reference state that involves \
superposition and entanglement, we can prepare a state such as:\
\>", "Text",
 CellID->1484396876,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}]}], "}"}], ",", " ", "\n", 
     "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", 
      " ", "\"\<\!\(\*SubscriptBox[\(U\), \(R\)]\)\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qc", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<00\>\"", ",", " ", "qc"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"qc", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]}], "Input",
 CellLabel->"In[13]:= ",
 CellID->1149283354,ExpressionUUID->"7b6211f5-475c-1194-2911-88bf72e963fe"],

Cell["Which is also called a Bell State:", "Text",
 CellID->1092188694,ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qc", "[", "]"}], "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->559599970,ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell["Ansatz Circuits", "Subsection",
 CellID->1710123944,ExpressionUUID->"5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],

Cell["\<\
In physics and mathematics, the German word \[OpenCurlyDoubleQuote]Ansatz\
\[CloseCurlyDoubleQuote] refers to an educated guess for solving a problem. \
You may have done this before\[LongDash]trying out a potential solution based \
on intuition or prior knowledge. However, an ansatz is not just any guess; it \
must be well-informed.\
\>", "Text",
 CellID->934597701,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell["\<\
In Variational Quantum Algorithms (VQAs), what we are guessing is the quantum \
circuit that will solve our problem. This is why we refer to this circuit \
simply as the ansatz\
\>", "Text",
 CellID->284780108,ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

Cell["Generate a collection of parametrized states:", "Text",
 CellID->643798763,ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"],

Cell[TextData[Cell[BoxData[
 RowBox[{"|", "\[Psi]", 
  RowBox[{"(", 
   OverscriptBox["\[Theta]", 
    RowBox[{" ", ";"}]], ")"}], "\[RightAngleBracket]", "\[LongEqual]", 
  SubscriptBox[
   StyleBox["U", "TI"], 
   StyleBox["V", "TI"]], 
  RowBox[{"(", 
   OverscriptBox["\[Theta]", 
    RowBox[{" ", ";"}]], ")"}], 
  SubscriptBox[
   StyleBox["U", "TI"], 
   StyleBox["R", "TI"]], 
  RowBox[{"|", "0"}], "\[RightAngleBracket]"}]], "InlineFormula",
 FontSize->0.9 
  Inherited,ExpressionUUID->"4b6e5dad-9702-0c1f-7916-54f722b75765"]], "Text",
 CellID->268959046,ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell[TextData[StyleBox["How Do We Choose an Ansatz?",
 FontWeight->"Bold"]], "Text",
 CellID->403125484,ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell["Problem-Inspired Ansatz", "Item",
 CellID->931950651,ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell["\<\
If we have prior knowledge about the problem, we can use physical intuition \
or mathematical insights to design a circuit tailored to the task. This \
approach typically leads to more efficient circuits with fewer parameters, \
making optimization easier. These are usually referred to generally as \
Hardware-Efficient ansatz.\
\>", "Item",
 CellID->412518898,ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],

Cell["Problem-Agnostic Ansatz", "Item",
 CellID->622967176,ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

Cell["\<\
If we lack detailed knowledge about the problem, we can use a more general \
universal ansatz that does not rely on problem-specific intuition. These \
ansatze are more expressive, meaning they can represent a wide range of \
solutions. However, they also tend to be larger, with more gates and \
parameters, making the optimization process significantly harder.\
\>", "Item",
 CellID->1358080856,ExpressionUUID->"25a0bfbe-b1d4-2428-535f-36fbc0668f72"],

Cell["\<\
If we consider this simple ansatz, consisting of a pair of rotations and a \
CNOT gate, we can evaluate it and examine the states that can be generated:\
\>", "Text",
 CellID->320615307,ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ansatz", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<00\>\"", ",", " ", 
      RowBox[{"\"\<RY\>\"", "[", 
       RowBox[{"2", " ", "\[Theta]1"}], "]"}], ",", " ", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<RY\>\"", "[", 
        RowBox[{"2", " ", "\[Theta]2"}], "]"}], " ", "->", " ", 
       RowBox[{"{", "2", "}"}]}], ",", " ", "\"\<CNOT\>\""}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"ansatz", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[15]:= ",
 CellID->1594238871,ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

Cell["\<\
As we observe, the possible states generated by this ansatz are limited to \
those determined by the sine and cosine functions. Therefore, even with an \
excellent optimizer, there will be certain values that this ansatz will never \
be able to reach:\
\>", "Text",
 CellID->2002505366,ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell[BoxData[
 RowBox[{"ansatz", "[", "\"\<Table\>\"", "]"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->2121396920,ExpressionUUID->"14fd1512-f616-8834-3c82-8d5f83a0db1e"],

Cell[TextData[StyleBox["How good is an ansatz?",
 FontWeight->"Bold"]], "Text",
 CellID->993357154,ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"],

Cell["Expressibility", "Item",
 CellID->50259360,ExpressionUUID->"48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],

Cell["\<\
This measures the range of functions that the quantum circuit can represent. \
Higher expressibility is generally linked to more entanglement and a greater \
number of parameters. The more expressive an ansatz is, the more problems it \
can potentially solve.\
\>", "Item",
 CellID->680111415,ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],

Cell["Trainability", "Item",
 CellID->1912025938,ExpressionUUID->"11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],

Cell["\<\
This refers to how easy it is to find the right parameters for the circuit. \
Larger, highly expressive circuits are harder to optimize because the \
optimizer must explore a vast parameter space. The difficulty of training \
also depends on the cost function and the classical optimizer used.\
\>", "Item",
 CellID->1678275947,ExpressionUUID->"7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],

Cell["\<\
There is a natural trade-off between expressibility and trainability. Highly \
expressive circuits are powerful but harder to train, while simpler circuits \
may be easier to optimize but might not capture the necessary complexity of \
the problem.\
\>", "Text",
 CellID->1570109414,ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell["\<\
The goal is to find an ansatz in the \[OpenCurlyDoubleQuote]sweet spot\
\[CloseCurlyDoubleQuote]\[LongDash]one that is expressive enough to solve the \
problem but still trainable within a reasonable amount of time.\
\>", "Text",
 CellID->746824257,ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],

Cell["Now, let\[CloseCurlyQuote]s explore this concept further with an \
exercise!", "Text",
 CellID->966663717,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell["Exercise 1:", "Item",
 CellID->634665076,ExpressionUUID->"5e187950-8ca2-2ab2-0638-711a25577898"],

Cell["\<\
Express the collection of parametrized states generated by the following \
ansatz:\
\>", "Text",
 CellID->1607396713,ExpressionUUID->"250a2d7c-9b81-05b0-5309-c5261e346f9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], ",", " ", "\"\<CNOT\>\""}],
     "}"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", "\n", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]], "Input",
 CellLabel->"In[17]:= ",
 CellID->171231949,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell["Step by step:", "Text",
 CellID->820919957,ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], "]"}], "@", 
   RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], " ", "//", " ", 
  "TraditionalForm"}]], "Input",
 CellLabel->"In[18]:= ",
 CellID->1006830744,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

Cell[BoxData[
 RowBox[{"result1", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumOperator", "[", "\"\<CNOT\>\"", "]"}], "@", 
   "%"}]}]], "Input",
 CellLabel->"In[19]:= ",
 CellID->1175763064,ExpressionUUID->"341c54d9-3079-6bba-5c24-4d83410c3980"],

Cell[BoxData[
 RowBox[{"result1", "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->1074416020,ExpressionUUID->"1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],

Cell["Exercise 2:", "Item",
 CellID->2143439988,ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"],

Cell["\<\
Express the collection of parametrized states generated by the following \
ansatz:\
\>", "Text",
 CellID->1933756212,ExpressionUUID->"6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<RX\>\"", "[", "\[Theta]1", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\"\<RX\>\"", "[", "\[Theta]2", "]"}], " ", "->", " ", 
      RowBox[{"{", "2", "}"}]}], ",", " ", "\n", "   ", "\"\<CNOT\>\""}], 
    "}"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->943735407,ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

Cell["Following the same steps:", "Text",
 CellID->865519937,ExpressionUUID->"07359582-e823-44a1-2eca-0cef89d62e8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumOperator", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<RX\>\"", "[", "\[Theta]1", "]"}], " ", "->", " ", "1"}], ",",
       " ", 
      RowBox[{
       RowBox[{"\"\<RX\>\"", "[", "\[Theta]2", "]"}], " ", "->", " ", "2"}]}],
      "}"}], ",", " ", "\n", "  ", 
    RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\[Theta]1", ",", " ", "\[Theta]2"}], "}"}]}]}], "]"}], "@", 
  RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->845186625,ExpressionUUID->"7c239bd0-3ff5-3b18-25d0-129ab9818662"],

Cell[BoxData[
 RowBox[{"result2", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumOperator", "[", "\"\<CNOT\>\"", "]"}], "@", 
   "%"}]}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->14312863,ExpressionUUID->"68c76573-72ce-0c1a-18fd-7d3d077b5760"],

Cell[BoxData[
 RowBox[{"result2", "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[24]:= ",
 CellID->315698450,ExpressionUUID->"6184d2f2-049e-728e-17bb-cbbcad2b40d4"],

Cell["\<\
We can verify that the second ansatz has more expressibility by the simple \
fact that:\
\>", "Text",
 CellID->1751204118,ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"],

Cell[BoxData[
 RowBox[{
  RowBox[{"result2", "[", 
   RowBox[{"\[Theta]", ",", " ", "0"}], "]"}], "[", "\"\<Formula\>\"", 
  "]"}]], "Input",
 CellLabel->"In[25]:= ",
 CellID->2116603297,ExpressionUUID->"19bb1c5e-57ab-6e36-4f58-9618625e351c"],

Cell["The first ansatz is a specific case of the second ansatz:", "Text",
 CellID->530919167,ExpressionUUID->"5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],

Cell[BoxData[
 RowBox[{"result1", "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[26]:= ",
 CellID->1242319925,ExpressionUUID->"30baa1c8-66ad-75e0-6059-389213585fca"],

Cell["Layered Circuit Architecture", "Subsubsection",
 CellID->1600082692,ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"],

Cell["What happens if we have no idea about the problem solution?", "Text",
 CellID->1091979148,ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell["\<\
Layered gate architectures, where the ansatz is repeated multiple times, have \
been shown to offer a good balance between expressibility and relatively low \
circuit depth, making them effective for tackling a broad range of problems.\
\>", "Text",
 CellID->1239660989,ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"],

Cell["\<\
If the problem we are trying to solve doesn\[CloseCurlyQuote]t require a \
large number of parameters, a good option might be to use an ansatz called \
the Basic Entangler. This ansatz is often favored for its simplicity and \
efficiency in cases where the problem doesn\[CloseCurlyQuote]t demand an \
overly complex parameterized quantum circuit. This layers consist of \
one-parameter single-qubit rotations on each qubit, followed by a closed \
chain or ring of CNOT gates.\
\>", "Text",
 CellID->234435634,ExpressionUUID->"511b3347-8d7d-ab60-0738-ab212409f64a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"basicentanglement", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<000\>\"", ",", " ", 
      RowBox[{
       RowBox[{"\"\<RX\>\"", "[", "\[Theta]1", "]"}], " ", "->", " ", "1"}], ",",
       " ", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<RX\>\"", "[", "\[Theta]2", "]"}], " ", "->", " ", "2"}], ",",
       " ", 
      RowBox[{
       RowBox[{"\"\<RX\>\"", "[", "\[Theta]3", "]"}], " ", "->", " ", "3"}], ",",
       " ", 
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", "\n", "    ", 
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "1"}], "}"}]}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"basicentanglement", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[27]:= ",
 CellID->417968184,ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"],

Cell[BoxData[
 RowBox[{"basicentanglement", "[", "\"\<Table\>\"", "]"}]], "Input",
 CellLabel->"In[28]:= ",
 CellID->1274591649,ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

Cell["\<\
In order to generate multiple layers of parametrized gates or controlled \
gates you can use the following functionalities:\
\>", "Text",
 CellID->1243964799,ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5900aac7-5263-773e-0f3f-43a167165a04"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"12d95fcb-3316-2212-42e7-569546a37178"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "733995c2-f5bf-78ee-22c6-0caffc4a4a34"], Cell[TextData[Cell[BoxData[
     RowBox[{"GenerateParameters", "[", 
      RowBox[{"n", ",", "m", ",", "opts"}], "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4f8ab258-7e7f-0723-7589-34027b0a6a09"]], "TableText",ExpressionUUID->
     "6b12ee74-9953-131d-1921-003e18e67e67"], Cell[TextData[{
     "generate ",
     StyleBox["n x m ", "TI"],
     "parameters, indicating the ",
     StyleBox["n", "TI"],
     " number of qubits and ",
     StyleBox["m", "TI"],
     " number of layers. The parameters are named ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["\[Theta]", "TI"], 
       StyleBox["i", "TI"]]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "65262d3c-fccc-1dc6-0cdd-c579f579672c"],
     " for i \[Element] {1,\[Ellipsis], ",
     StyleBox["n x m", "TI"],
     "}"
    }], "TableText",ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "78287f93-0f12-7c52-2828-76ddaaa746b8"], Cell["\<\
ParametrizedLayer[gate,qubits,index, opts] ParametrizedLayer[gate,index, opts]\
\>", "TableText",ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"], 
    Cell[TextData[{
     "generates a layer of parameterized gates on the specified ",
     StyleBox["qubits", "TI"],
     ". The parameters are denoted as ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["\[Theta]", "TI"], 
       StyleBox["i", "TI"]]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],
     " where i \[Element] ",
     StyleBox["index", "TI"],
     ". If only ",
     StyleBox["index", "TI"],
     " is provided (with no ",
     Cell[BoxData[
      StyleBox[
       RowBox[{"q", "u", "b", "i", "t", "s"}], "TI"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "187adc3d-3961-76c2-4819-d667b8145c28"],
     "), a layer of gates with the same length is generated for all qubits."
    }], "TableText",ExpressionUUID->"641c78eb-7f03-7846-0c24-71b57ab64aac"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5bfcc75d-c21d-6fb0-0983-df06f7a8359a"], Cell[TextData[Cell[BoxData[
     RowBox[{"EntanglementLayer", "[", 
      RowBox[{"cgate", ",", "qubits"}], "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "112ae6ec-4b5c-6ad2-4729-ffb66ee93838"]], "TableText",ExpressionUUID->
     "6121b9de-dddd-aca8-10de-309bd469f6f2"], Cell[
    "generate a layer of controlled cgate connecting each qubits", 
     "TableText",ExpressionUUID->"30209679-023a-ee91-61df-0823b7ccb4fb"]}
  }]], "2ColumnTableMod",
 CellID->1828403510,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell["ParametrizedLayer & GenerateParameters", "Subsubsection",
 CellID->623026911,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell[TextData[StyleBox["ParametrizedLayer",
 FontWeight->"Bold"]], "Text",
 CellID->308489360,ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"],

Cell[TextData[{
 "The ",
 StyleBox["ParametrizedLayer",
  FontWeight->"Bold"],
 " function reduces redundant code in layered quantum circuit architectures \
by applying parameterized gates and automatically generating the necessary \
parameters."
}], "Text",
 CellID->387004599,ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],

Cell["\<\
It is possible to specify both the qubits on which the parameterized gates \
will be applied and the index for each parameter:\
\>", "Text",
 CellID->1976158344,ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],

Cell[BoxData[
 RowBox[{"ParametrizedLayer", "[", 
  RowBox[{"\"\<RY\>\"", ",", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"1", ",", " ", "3"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[29]:= ",
 CellID->1232186413,ExpressionUUID->"51fce014-dca1-0630-0783-fa51d5546d1a"],

Cell[BoxData[
 RowBox[{"ParametrizedLayer", "[", 
  RowBox[{"\"\<RY\>\"", ",", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"97", ",", " ", "99"}], "]"}], ",", " ", 
   RowBox[{"Range", "[", "3", "]"}]}], "]"}]], "Input",
 CellLabel->"In[30]:= ",
 CellID->655687319,ExpressionUUID->"657c1c65-980e-511d-1303-964f19bb2067"],

Cell["\<\
Alternatively, you can specify only the parameter indices, and the gates will \
be generated sequentially for each qubit, starting from qubit 1:\
\>", "Text",
 CellID->1589358908,ExpressionUUID->"0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],

Cell[BoxData[
 RowBox[{"ParametrizedLayer", "[", 
  RowBox[{"\"\<RY\>\"", ",", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"4", ",", " ", "6"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[31]:= ",
 CellID->1191517648,ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", "%", "}"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]], "Input",
 CellLabel->"In[32]:= ",
 CellID->960670710,ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"],

Cell[TextData[StyleBox["GenerateParameters",
 FontWeight->"Bold"]], "Text",
 CellID->1307080411,ExpressionUUID->"1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],

Cell[TextData[{
 "The ",
 StyleBox["GenerateParameters",
  FontWeight->"Bold"],
 " function generates a list of symbols; you only need to specify the number \
of qubits and layers in the quantum circuit:"
}], "Text",
 CellID->1960030258,ExpressionUUID->"370294fd-9e49-2d35-5d31-0da71bfc741f"],

Cell[BoxData[
 RowBox[{"GenerateParameters", "[", 
  RowBox[{"3", ",", " ", "3"}], "]"}]], "Input",
 CellLabel->"In[33]:= ",
 CellID->535682707,ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

Cell["Example", "Text",
 CellID->1167207179,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"basicentaglement", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<00000\>\"", ",", "\n", "    ", 
       RowBox[{"ParametrizedLayer", "[", 
        RowBox[{"\"\<RY\>\"", ",", " ", 
         RowBox[{"Range", "[", "5", "]"}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"EntanglementLayer", "[", 
        RowBox[{"\"\<CNOT\>\"", ",", " ", 
         RowBox[{"Range", "[", "5", "]"}], ",", " ", 
         RowBox[{"\"\<Entanglement\>\"", " ", "->", " ", "\"\<Linear\>\""}]}],
         "]"}], ",", "\n", "    ", "\"\<Barrier\>\"", ",", "\n", "    ", 
       RowBox[{"ParametrizedLayer", "[", 
        RowBox[{"\"\<RY\>\"", ",", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"6", ",", " ", "10"}], "]"}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"EntanglementLayer", "[", 
        RowBox[{"\"\<CNOT\>\"", ",", " ", 
         RowBox[{"Range", "[", "5", "]"}], ",", " ", 
         RowBox[{"\"\<Entanglement\>\"", " ", "->", " ", "\"\<Linear\>\""}]}],
         "]"}], ",", "\n", "    ", "\"\<Barrier\>\"", ",", "\n", "    ", 
       RowBox[{"ParametrizedLayer", "[", 
        RowBox[{"\"\<RY\>\"", ",", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"11", ",", " ", "15"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"GenerateParameters", "[", 
       RowBox[{"5", ",", " ", "3"}], "]"}]}]}], "\n", "   ", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[34]:= ",
 CellID->1612953718,ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell[BoxData[
 RowBox[{"basicentaglement", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Full"}]}], "]"}]], "Input",
 CellLabel->"In[35]:= ",
 CellID->790826209,ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"],

Cell[TextData[StyleBox["Options",
 FontWeight->"Bold"]], "Text",
 CellID->1163030741,ExpressionUUID->"6878c7f8-419e-9db5-1807-dea27028e79f"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "48a3d607-c312-9dd3-7850-c860f6a4e739"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"023f49e2-a747-9723-33c5-60cfd2f3fa09"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "21aa1c49-e16c-f406-57a9-9612901edf6c"], Cell[TextData[Cell[
    BoxData["\"\<Symbol\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "289b85cd-827f-9a9c-58b8-1c97370be8e6"]], "TableText",ExpressionUUID->
     "12f3dbee-abc4-6375-4280-d2cbce714e5f"], Cell[
    "\"\[Theta]\"", "TableText",ExpressionUUID->
     "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"], Cell[
    "define the main symbol used for the parameters", "TableText",
     ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"]}
  }]], "3ColumnTableMod",
 CellID->1753119213,ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell["\<\
GenerateParameters and ParametrizedLayer functions use \"\[Theta]\" as \
default symbol:\
\>", "Text",
 CellID->2037256,ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[BoxData[
 RowBox[{"GenerateParameters", "[", 
  RowBox[{"3", ",", " ", "3"}], "]"}]], "Input",
 CellLabel->"In[36]:= ",
 CellID->339747688,ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"],

Cell[BoxData[
 RowBox[{"ParametrizedLayer", "[", 
  RowBox[{"\"\<RY\>\"", ",", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"4", ",", " ", "6"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[37]:= ",
 CellID->1569376968,ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell["Use \"Symbol\" option to change the default symbol:", "Text",
 CellID->1336445995,ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell[BoxData[
 RowBox[{"GenerateParameters", "[", 
  RowBox[{"3", ",", " ", "3", ",", " ", 
   RowBox[{"\"\<Symbol\>\"", " ", "->", " ", "\"\<\[Phi]\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[38]:= ",
 CellID->797627498,ExpressionUUID->"2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],

Cell[BoxData[
 RowBox[{"ParametrizedLayer", "[", 
  RowBox[{"\"\<RY\>\"", ",", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"4", ",", " ", "6"}], "]"}], ",", " ", 
   RowBox[{"\"\<Symbol\>\"", " ", "->", " ", "\"\<\[Phi]\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[39]:= ",
 CellID->151045137,ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c"],

Cell["EntanglementLayer", "Subsubsection",
 CellID->1063989564,ExpressionUUID->"52243646-2fbd-210e-03db-a8204a487054"],

Cell[TextData[{
 "The ",
 StyleBox["EntanglementLayer",
  FontWeight->"Bold"],
 " function is designed to reduce redundant code in layered quantum circuit \
architectures by facilitating controlled operations between qubits."
}], "Text",
 CellID->1987333543,ExpressionUUID->"1acd7f4d-3da3-7753-4af3-7717b4565db9"],

Cell[BoxData[
 RowBox[{"EntanglementLayer", "[", 
  RowBox[{"\"\<CNOT\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[40]:= ",
 CellID->616753397,ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a"],

Cell[TextData[{
 "The ",
 StyleBox["EntanglementLayer",
  FontWeight->"Bold"],
 " function returns a Sequence of multiple Rules, each representing a \
controlled gate applied to connected qubits according to the chosen \
entanglement strategy. Currently, the function supports only named controlled \
gates between two qubits."
}], "Text",
 CellID->1146256261,ExpressionUUID->"1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", "\n", "   ", 
    RowBox[{"EntanglementLayer", "[", 
     RowBox[{"\"\<CH\>\"", ",", " ", 
      RowBox[{"Range", "[", "10", "]"}], ",", " ", 
      RowBox[{"\"\<Entanglement\>\"", " ", "->", " ", "\"\<Linear\>\""}]}], 
     "]"}], "\n", "   ", "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",\

 CellLabel->"In[41]:= ",
 CellID->1280025883,ExpressionUUID->"6f6ad260-8ee1-565a-1569-d44a2a943ca0"],

Cell["Entanglement", "Text",
 CellID->681114160,ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell["\<\
The \"Entanglement\" option specifies the strategy used for entanglement. It \
supports the following values:\
\>", "Text",
 CellID->1719384190,ExpressionUUID->"26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"6b853673-18d0-d9fa-19ba-a83d996aabc0"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "574a2197-51ef-7938-7d49-b8d1679a4802"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6e85e9ed-427b-8528-16ba-00b7770fec72"]], "TableText",ExpressionUUID->
     "73b76025-96bb-3fff-214d-798f234f85c5"], Cell[
    "each qubit is entangled with all the others.", "TableText",
     ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "72ff7667-e560-b2c0-2285-68408c1a002a"], Cell[TextData[Cell[
    BoxData["\"\<Linear\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7c9be80e-0554-61c1-24b8-0268ace1332b"]], "TableText",ExpressionUUID->
     "106b7ad8-6378-599b-4069-7382160d2be1"], Cell["\<\
each qubit is entangled with the following qubit in the sequence\
\>", "TableText",ExpressionUUID->"7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "304452a4-201b-d64c-607c-4b0e51afbc96"], Cell[TextData[Cell[
    BoxData["\"\<Circular\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"]], "TableText",ExpressionUUID->
     "4b5b9263-9199-4e16-7978-144d202c157c"], Cell["\<\
each qubit is entangled with all others, with an additional connection \
between the first and last qubit before the sequence.\
\>", "TableText",ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"], Cell[TextData[Cell[
    BoxData["\"\<ReverseLinear\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3343f580-98d5-e31c-6170-ecea1961ce66"]], "TableText",ExpressionUUID->
     "20a7420b-376a-b23f-505d-6455421c0105"], Cell["\<\
each qubit is entangled with the following one, in reverse order from last to \
first\
\>", "TableText",ExpressionUUID->"6af863a9-1098-c609-1a98-7af3a112ad53"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "055bc2ad-6b92-a3be-3378-dbf70e24f184"], Cell[TextData[Cell[
    BoxData["\"\<Pairwise\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2b0fb60e-2211-365f-5934-286857a59ca5"]], "TableText",ExpressionUUID->
     "201a2509-bdd9-2fa1-5039-bd53346c758b"], Cell["\<\
consists of two layers: one for even-positioned qubits and another for \
odd-positioned qubits, each entangled with the next.\
\>", "TableText",ExpressionUUID->"7085d256-6adc-aa08-20ba-d4100f6ef952"]}
  }]], "2ColumnTableMod",
 CellID->1020643561,ExpressionUUID->"5f932952-49a5-d34f-05a0-c11c6851a195"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qubits", " ", "=", " ", 
   RowBox[{"Range", "[", "5", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"strategy", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "Automatic", ",", " ", "\"\<Linear\>\"", ",", " ", "\"\<ReverseLinear\>\"",
      ",", " ", "\"\<Pairwise\>\"", ",", " ", "\n", 
     "   ", "\"\<Circular\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"subqc", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"EntanglementLayer", "[", 
         RowBox[{"\"\<CNOT\>\"", ",", " ", "qubits", ",", " ", "\n", 
          "       ", 
          RowBox[{"\"\<Entanglement\>\"", " ", "->", " ", "#"}]}], "]"}], 
        "}"}], ",", " ", 
       RowBox[{"\"\<Label\>\"", " ", "->", " ", "#"}]}], "]"}], " ", "&"}], 
    " ", "/@", " ", "strategy"}]}], ";"}]}], "Input",
 CellLabel->"In[42]:= ",
 CellID->1064479054,ExpressionUUID->"160f17c4-d31a-fe19-3e34-8ea1e6acc563"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", "subqc", "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]], "Input",
 CellLabel->"In[43]:= ",
 CellID->1710804206,ExpressionUUID->"10beb8bd-bdb6-ee93-4045-31e73440b4f9"],

Cell["Variational Quantum Eigensolver (VQE)", "Section",
 CellID->762016048,ExpressionUUID->"3fdc991b-fead-14b0-65e3-1144fb587e9a"],

Cell["\<\
The variational quantum eigensolver (VQE) is a hybrid algorithm that combines \
classical and quantum computing to determine the ground state energy of a \
Hamiltonian. It utilizes quantum algorithms to calculate expected energy \
values and classical optimization techniques for minimizing that energy.\
\>", "Text",
 CellID->953318213,ExpressionUUID->"3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],

Cell["\<\
VQE plays a crucial role in quantum optimization, particularly in solving \
complex problems in quantum chemistry and materials science. By enabling \
efficient simulations of intricate systems, VQE can address optimization \
tasks that are challenging for classical methods alone.\
\>", "Text",
 CellID->1320676321,ExpressionUUID->"0642d375-09f3-9942-2e71-cb3faf87eba8"],

Cell[TextData[{
 "Given a Hamiltonian operator ",
 StyleBox["H", "TI"],
 ", this method consist of two main components:"
}], "Text",
 CellID->1600517155,ExpressionUUID->"0651775d-2bad-791b-2e6f-6f074e584861"],

Cell[TextData[{
 "A variational circuit ansatz ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Theta]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63b9e3d6-2298-231e-1146-fa9057128e64"],
 "."
}], "Item",
 CellID->1655262560,ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"],

Cell[TextData[{
 "A cost function ",
 Cell[BoxData[
  RowBox[{"\[ScriptCapitalL]", "=", 
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["\[Phi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["\[Theta]", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Bra"], 
    StyleBox["H", "TI"], 
    TemplateBox[{
      RowBox[{
        StyleBox["\[Phi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["\[Theta]", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c440104-ea8a-4285-747b-99618f3f10ef"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Phi]", "TI"], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["\[Theta]", "TI"], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Ket"], "=", 
   RowBox[{
    StyleBox["V", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Theta]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{"0"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c9a615-af45-c085-0ef6-385ecaf192ef"],
 " ."
}], "Item",
 CellID->843709254,ExpressionUUID->"0513e607-0f4c-1e20-3320-f861aaf9650a"],

Cell["\<\
The method involves iteratively adjusting \[Theta] to minimize the average \
energy or cost function \|01d4bb.\
\>", "Text",
 CellID->1241281984,ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"],

Cell["Implementation", "Subsubsection",
 CellID->2083544408,ExpressionUUID->"6833ae6a-6ac5-a2c8-19c0-40340f71f012"],

Cell[TextData[{
 "In order to understand how to proceed with the VQE algorithm, let's drive \
the a variational state",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["\[Phi]", "TI"], 
      StyleBox["(", SpanMaxSize -> 1], 
      StyleBox["\[Theta]", "TI"], 
      StyleBox[")", SpanMaxSize -> 1]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7f2999-1aee-25a5-0504-c0c39e988f8f"],
 " to the ground state of the following Hamiltonian:"
}], "Text",
 CellID->960626294,ExpressionUUID->"128c7526-c883-085d-42b4-6c83e9365aa7"],

Cell[BoxData[
 RowBox[{"H", " ", "=", " ", 
  RowBox[{"QuantumOperator", "[", 
   RowBox[{"\"\<X\>\"", " ", "+", " ", "\"\<Z\>\""}], "]"}]}]], "Input",
 CellLabel->"In[44]:= ",
 CellID->1275597307,ExpressionUUID->"3279c00f-c9e2-8758-6206-da68ef94eda2"],

Cell["Define the ansatz circuit V(\[Theta]):", "Text",
 CellID->180386896,ExpressionUUID->"50b12ff8-e606-85f7-004e-c6a593b0efdd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"V", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<0\>\"", ",", " ", 
       RowBox[{
        RowBox[{"\"\<RX\>\"", "[", "\[Theta]1", "]"}], " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", " ", "\n", "    ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Theta]2", "]"}], " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}]}], "}"}], ",", " ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[Theta]1", ",", " ", "\[Theta]2"}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"\"\<Diagram\>\"", " ", "//", " ", "V"}]}], "Input",
 CellLabel->"In[45]:= ",
 CellID->1150052415,ExpressionUUID->"640f47a5-4648-c62d-0c35-5e0f73e2ad77"],

Cell[TextData[{
 "Calculate ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["\[Phi]", "TI"], 
      StyleBox["(", SpanMaxSize -> 1], 
      StyleBox["\[Theta]", "TI"], 
      StyleBox[")", SpanMaxSize -> 1]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63a48922-0fac-666c-115b-208caa594cb6"],
 " from the ansatz circuit V:"
}], "Text",
 CellID->1256596424,ExpressionUUID->"387a9e0d-0234-0e73-6819-1057b7c15559"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Phi]", " ", "=", " ", 
   RowBox[{"V", "[", "]"}]}], ";"}], "\n", 
 RowBox[{"\"\<Formula\>\"", " ", "//", " ", "\[Phi]"}]}], "Input",
 CellLabel->"In[46]:= ",
 CellID->969862745,ExpressionUUID->"3f64ca0d-9927-5f44-651b-ec5718d225ae"],

Cell["Implement the cost function \[ScriptCapitalL] as stated before:", "Text",
 CellID->1199935485,ExpressionUUID->"399d1ff3-4632-be92-6fa2-96bd73c404f8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalL]", "[", 
    RowBox[{"\[Theta]1_", ",", " ", "\[Theta]2_"}], "]"}], " ", "=", " ", 
   "\n", "  ", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"\"\<Scalar\>\"", " ", "//", " ", 
     RowBox[{
      RowBox[{"SuperDagger", "[", "\[Phi]", "]"}], "@", 
      RowBox[{"H", "@", "\[Phi]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[ScriptCapitalL]", "[", 
   RowBox[{"\[Theta]1", ",", " ", "\[Theta]2"}], "]"}], " ", "//", " ", 
  "Simplify"}]}], "Input",
 CellLabel->"In[47]:= ",
 CellID->641748961,ExpressionUUID->"1170384d-2f38-2c50-470f-b2174acd76ba"],

Cell[TextData[{
 "Calculate the ground state eigenvalue of ",
 StyleBox["H", "TI"],
 " by minimizing \|01d4bb:"
}], "Text",
 CellID->1055869762,ExpressionUUID->"6ce33075-6d34-44a7-1490-aa3f04c12e8d"],

Cell[BoxData[
 RowBox[{"MinValue", "[", 
  RowBox[{
   RowBox[{"\[ScriptCapitalL]", "[", 
    RowBox[{"\[Theta]1", ",", " ", "\[Theta]2"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]1", ",", " ", 
     RowBox[{"\\\n", "\[Theta]2"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[48]:= ",
 CellID->1607759830,ExpressionUUID->"54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],

Cell["Visualizations", "Subsubsection",
 CellID->1074210535,ExpressionUUID->"6334ac9c-43f1-85c0-12cb-45c67585ef2a"],

Cell["\<\
In order to visualize the optimization process, we need to get all the \
parameter values during the evolution, in this case we will use a simple \
gradient descent method:\
\>", "Text",
 CellID->1050391292,ExpressionUUID->"74397683-04f4-1d4d-1dc7-6fedac816797"],

Cell[BoxData[
 RowBox[{
  RowBox[{"initialPosition", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.1", ",", " ", "0.1"}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[49]:= ",
 CellID->1113110913,ExpressionUUID->"735e49d5-32a1-4a48-2166-609f47541892"],

Cell[BoxData[
 RowBox[{
  RowBox[{"params", " ", "=", " ", 
   RowBox[{"GradientDescent", "[", 
    RowBox[{"\[ScriptCapitalL]", ",", " ", "initialPosition"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[50]:= ",
 CellID->39476879,ExpressionUUID->"335d55a2-cf9b-493d-6163-4c0fea2e1807"],

Cell["\<\
It would be also useful to calculate all the cost function values during each \
step of the parameter evolution:\
\>", "Text",
 CellID->1462859254,ExpressionUUID->"3bfbbd45-edb8-1b0b-6998-352e844d6651"],

Cell[BoxData[
 RowBox[{
  RowBox[{"costs", " ", "=", " ", 
   RowBox[{"\[ScriptCapitalL]", " ", "@@@", " ", "params"}]}], ";"}]], "Input",\

 CellLabel->"In[51]:= ",
 CellID->1067972408,ExpressionUUID->"045023ab-c37d-b770-2c6f-baf4f6091a5a"],

Cell["Cost curve", "Text",
 CellID->1289039002,ExpressionUUID->"73e8aeff-5b91-f8f4-2197-47b95e25cade"],

Cell["\<\
We can visualize the evolution of our optimization during time in an Cost \
Curve, also known as Loss Curve:\
\>", "Text",
 CellID->214787233,ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"costs", ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "15"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1.5"}], ",", " ", "0.1"}], "}"}]}], "}"}]}], ",", " ", 
   "\n", " ", 
   RowBox[{"PlotLabel", " ", "->", " ", "\"\<Loss Curve\>\""}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Step\>\"", ",", " ", "\"\<Cost function\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{"ImageMargins", " ", "->", " ", "1"}], ",", " ", "\n", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Red", ",", " ", "Dashed", ",", " ", "\n", "    ", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"-", 
              RowBox[{"Sqrt", "[", "2", "]"}]}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"15", ",", " ", 
             RowBox[{"-", 
              RowBox[{"Sqrt", "[", "2", "]"}]}]}], "}"}]}], "}"}], "]"}]}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"Red", ",", " ", "\n", "    ", 
        RowBox[{"Inset", "[", 
         RowBox[{"\"\<-\!\(\*SqrtBox[\(2\)]\)\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", 
            RowBox[{"-", "1.3"}]}], "}"}]}], "]"}]}], "}"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[52]:= ",
 CellID->2022853894,ExpressionUUID->"794a4309-908b-2549-2f4a-5b53213f8f93"],

Cell["Parameter Space", "Text",
 CellID->1022435225,ExpressionUUID->"167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],

Cell["\<\
We can visualize the evolution of our optimization in the parameter space in \
a Contour Plot:\
\>", "Text",
 CellID->249582051,ExpressionUUID->"15eb24b6-b946-3a65-43e8-bdf038f0894f"],

Cell[BoxData[
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{"\[ScriptCapitalL]", "[", 
    RowBox[{"\[Theta]1", ",", " ", "\[Theta]2"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"$CellContext`", "\\\n", "\[Theta]1"}], ",", " ", 
     RowBox[{"-", "2"}], ",", " ", "2"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"$CellContext`\[Theta]2", ",", " ", 
     RowBox[{"-", "3"}], ",", " ", "1"}], "}"}], ",", " ", 
   RowBox[{"ImageMargins", " ", "->", " ", "1"}], ",", " ", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]1\>\"", ",", " ", "\"\<\[Theta]2\>\""}], "}"}]}], ",",
    " ", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", " ", "\"\<Cost Function Parameter Space\>\""}], ",",
    " ", 
   RowBox[{"ContourStyle", " ", "->", " ", "None"}], ",", " ", "\n", " ", 
   RowBox[{"Contours", " ", "->", " ", "10"}], ",", " ", "\n", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Dashed", ",", " ", 
        RowBox[{"Line", "[", "$CellContext`params", "]"}]}], "}"}], ",", " ", 
      "\n", "   ", 
      RowBox[{"PointSize", "[", "Large", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", " ", 
        RowBox[{"Point", "[", 
         RowBox[{"First", "[", "$CellContext`params", "]"}], "]"}]}], "}"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"Red", ",", " ", "\n", "    ", 
        RowBox[{"Point", "[", 
         RowBox[{"Last", "[", "$CellContext`params", "]"}], "]"}]}], "}"}], ",",
       " ", "\n", "   ", 
      RowBox[{"Inset", "[", 
       RowBox[{"\"\<Initial Value\>\"", ",", " ", 
        RowBox[{"First", "[", "$CellContext`params", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"-", "2"}]}], "}"}]}], "]"}], ",", " ", "\n", "   ", 
      "White", ",", " ", 
      RowBox[{"Inset", "[", 
       RowBox[{"\"\<Final Value\>\"", ",", " ", 
        RowBox[{"Last", "[", "$CellContext`params", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1.5"}], ",", " ", 
          RowBox[{"-", "2"}]}], "}"}]}], "]"}]}], "}"}]}], ",", " ", "\n", 
   " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]], "Input",
 CellLabel->"In[53]:= ",
 CellID->1464174193,ExpressionUUID->"27d2a24c-1e84-19ee-4de1-44169b316b34"],

Cell["Gradient Vector Plot", "Text",
 CellID->2044678727,ExpressionUUID->"285985c7-a1c8-13eb-5866-1ca0d07d6131"],

Cell["\<\
The stream plot of the gradient of our cost function can provide insight into \
the behavior of the evolution as observed in its parameter space:\
\>", "Text",
 CellID->598605201,ExpressionUUID->"57868ed1-450c-c474-7dbd-279b6cbeaf5e"],

Cell[BoxData[
 RowBox[{"StreamPlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"-", 
     RowBox[{"Grad", "[", 
      RowBox[{
       RowBox[{"\[ScriptCapitalL]", "[", 
        RowBox[{"\[Theta]1", ",", " ", "\[Theta]2"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Theta]1", ",", " ", 
         RowBox[{"\\\n", "\[Theta]2"}]}], "}"}]}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"$CellContext`\[Theta]1", ",", " ", 
     RowBox[{"-", "2"}], ",", " ", "\n", "  ", "2"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"$CellContext`\[Theta]2", ",", " ", 
     RowBox[{"-", "3"}], ",", " ", "1"}], "}"}], ",", " ", 
   RowBox[{"ImageMargins", " ", "->", " ", "1"}], ",", " ", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]1\>\"", ",", " ", "\"\<\[Theta]2\>\""}], "}"}]}], ",",
    " ", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<Cost Function Gradient Vector Plot\>\""}], ",", " ", "\n", " ", 
   
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"PointSize", "[", "Large", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", " ", "\n", "    ", 
        RowBox[{"Point", "[", 
         RowBox[{"First", "[", "$CellContext`params", "]"}], "]"}]}], "}"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"Red", ",", " ", "\n", "    ", 
        RowBox[{"Point", "[", 
         RowBox[{"Last", "[", "$CellContext`params", "]"}], "]"}]}], "}"}], ",",
       " ", "\n", "   ", 
      RowBox[{"Inset", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Initial Value\>\"", ",", " ", "Bold"}], "]"}], ",", " ",
         "\n", "    ", 
        RowBox[{"First", "[", "$CellContext`params", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2"}], ",", " ", "0"}], "}"}]}], "]"}], ",", " ", "\n",
       "   ", 
      RowBox[{"Inset", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Final Value\>\"", ",", " ", "Bold"}], "]"}], ",", " ", 
        "\n", "    ", 
        RowBox[{"Last", "[", "$CellContext`params", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2.5"}], ",", " ", "0"}], "}"}]}], "]"}]}], "}"}]}], ",",
    " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]], "Input",
 CellLabel->"In[54]:= ",
 CellID->1178108964,ExpressionUUID->"0c5e608e-35dc-f74f-3466-79e8bc6edd95"],

Cell["Quantum Chemistry", "Subsubsection",
 CellID->728825311,ExpressionUUID->"1a1e4090-3303-05ed-4a26-59da46b66f37"],

Cell["\<\
The Variational Quantum Eigensolver (VQE) is a valuable tool in quantum \
chemistry for finding the minimal energy of a molecule. The task is \
essentially an optimization problem, where the goal is to minimize the total \
energy of the molecule with respect to the positions of the atomic nuclei.\
\>", "Text",
 CellID->639517814,ExpressionUUID->"10256af3-3972-af7a-41da-83bdb804f240"],

Cell["\<\
In the case of VQE, we use parameterized quantum circuits to approximate the \
ground state energy of the system. This results in the determination of the \
minimal energy of the system, which corresponds to the lowest energy \
configuration of the molecule in its ground state.\
\>", "Text",
 CellID->1709586986,ExpressionUUID->"457602f1-d86e-ac86-730d-9bbad918f6ec"],

Cell["\<\
This minimal energy result can be incredibly useful in determining the \
geometry of the molecule as well, as the lowest energy corresponds to the \
optimized configuration of the atomic nuclei. Therefore, although the main \
goal is to minimize the energy, this process can also provide insights into \
the stable arrangement of atoms in the molecule.\
\>", "Text",
 CellID->783356103,ExpressionUUID->"499f95c1-a958-6c18-7fa4-0caac8ed3762"],

Cell[TextData[{
 "Toy ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["H", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1e874b-6d22-b8ab-3525-1f1504d40af1"],
 " Molecule"
}], "Text",
 CellID->896659851,ExpressionUUID->"0c02104f-9807-e6c4-3431-8a2919b3cc2e"],

Cell[TextData[{
 "The current problem is finding the ground state of the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["H", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f909018-5ea1-6a32-15af-0a425b543918"],
 " molecule;,the Hamiltonian can be reduced and modeled using two qubits as:"
}], "Text",
 CellID->1161108776,ExpressionUUID->"2f4595f3-090a-1216-557a-0cbda8bf617c"],

Cell[BoxData[
 RowBox[{"H2", " ", "=", " ", 
  RowBox[{"QuantumOperator", "[", 
   RowBox[{
    RowBox[{"\[Alpha]", " ", 
     RowBox[{"(", 
      RowBox[{"\"\<ZI\>\"", " ", "+", " ", "\"\<IZ\>\""}], ")"}]}], " ", "+", 
    " ", 
    RowBox[{"\[Beta]", "*", "\"\<XX\>\""}]}], "]"}]}]], "Input",
 CellLabel->"In[55]:= ",
 CellID->950316697,ExpressionUUID->"06385f5e-e9d4-4e6c-2fd8-571b886114b6"],

Cell["Implement the algorithm as we learned last class:", "Text",
 CellID->691399421,ExpressionUUID->"25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],

Cell[TextData[{
 StyleBox["First:",
  FontWeight->"Bold"],
 " Parametrized quantum circuits, state and ansatz preparation."
}], "Item",
 CellID->2104867922,ExpressionUUID->"3b9a140e-d97a-4136-69b9-8e6bd80f101c"],

Cell["\<\
In this case we will use a typical hardware-efficient ansatz: Two layers of \
Rotations and a CNOT to ensure the entanglement.\
\>", "Text",
 CellID->771870489,ExpressionUUID->"4f9438da-b80f-a114-75ab-b18439bbf07e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"HEAnsatz", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<00\>\"", ",", " ", 
      RowBox[{
       RowBox[{"\"\<RY\>\"", "[", 
        RowBox[{"2", " ", "\[Theta]1"}], "]"}], " ", "->", " ", "1"}], ",", 
      " ", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<RY\>\"", "[", 
        RowBox[{"2", " ", "\[Theta]2"}], "]"}], " ", "->", " ", "2"}], ",", 
      " ", 
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
      RowBox[{
       RowBox[{"\"\<RY\>\"", "[", 
        RowBox[{"2", " ", "\[Theta]3"}], "]"}], " ", "->", " ", "1"}], ",", 
      " ", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<RY\>\"", "[", 
        RowBox[{"2", " ", "\[Theta]4"}], "]"}], " ", "->", " ", "2"}]}], 
     "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"HEAnsatz", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[56]:= ",
 CellID->1879165774,ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell[TextData[{
 "Second: Cost function ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Theta]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "\[ThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8746fc-db76-c487-64bd-5fb9de00aeed"]
}], "Item",
 CellID->1568237090,ExpressionUUID->"11f0f87a-e6f0-91cd-478f-f227928ae317"],

Cell["\<\
We need a cost function, so let\[CloseCurlyQuote]s obtain the QuantumState \
from the QuantumCircuit and define the bra and ket.\
\>", "Text",
 CellID->1215643129,ExpressionUUID->"473164ce-b547-c1f4-6ecf-7da83cf393de"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ket", "[", 
     RowBox[{"{", "\[Phi]", "}"}], "]"}], " ", "=", " ", 
    RowBox[{"HEAnsatz", "[", "]"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Bra", "[", 
    RowBox[{"{", "\[Phi]", "}"}], "]"}], " ", "=", " ", 
   RowBox[{"SuperDagger", "[", 
    RowBox[{"Ket", "[", 
     RowBox[{"{", "\[Phi]", "}"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[57]:= ",
 CellID->1905081759,ExpressionUUID->"12c4fc3b-e00c-2bba-42fb-f66491b97980"],

Cell["\<\
Finally lets compute the energy of our system and define a function that will \
work as the cost function. In this step we should help the optimizer by \
Simplifying and replacing fixed values.\
\>", "Text",
 CellID->1421144675,ExpressionUUID->"1d7e6892-18cd-6f45-4b05-81dc997835af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"energy", " ", "=", " ", 
   RowBox[{
    RowBox[{"Bra", "[", 
     RowBox[{"{", "\[Phi]", "}"}], "]"}], "@", 
    RowBox[{"H2", "@", 
     RowBox[{"Ket", "[", 
      RowBox[{"{", "\[Phi]", "}"}], "]"}]}]}]}], " ", ";"}]], "Input",
 CellLabel->"In[58]:= ",
 CellID->2106544241,ExpressionUUID->"325c8f47-cd85-89da-6263-2720e431db20"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"values", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", " ", "->", " ", "0.4"}], ",", " ", 
     RowBox[{"\[Beta]", " ", "->", " ", "0.2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"costH2", "[", 
   RowBox[{
   "\[Theta]1_", ",", " ", "\[Theta]2_", ",", " ", "\[Theta]3_", ",", " ", 
    "\[Theta]4_"}], "]"}], " ", "=", " ", "\n", " ", 
  RowBox[{
   RowBox[{"FullSimplify", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"\"\<Scalar\>\"", " ", "//", " ", "\n", "    ", "energy"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Theta]1", ",", " ", "\[Theta]2", ",", " ", "\[Theta]3", ",", " ", 
        "\[Theta]4"}], "}"}], " ", "\[Element]", " ", "\n", "    ", 
      "Reals"}]}], "]"}], " ", "/.", " ", "values"}]}]}], "Input",
 CellLabel->"In[59]:= ",
 CellID->540539268,ExpressionUUID->"43fcea2e-12ab-c026-7183-0388a75f930c"],

Cell["\<\
As I mentioned, the cost function we are working with is not trivial, but the \
advantage is that we can compute it symbolically, which significantly helps \
in the optimization process.\
\>", "Text",
 CellID->1735548981,ExpressionUUID->"5b416c07-c3d3-bf4f-097e-8660f6670595"],

Cell["Third: Optimization", "Item",
 CellID->243931157,ExpressionUUID->"5add4728-e92e-eff1-0ae3-5f7588d8b5db"],

Cell["\<\
To find the optimal parameters for our quantum circuit, we can use the \
NMinimize function in Mathematica.\
\>", "Text",
 CellID->674797301,ExpressionUUID->"621761a3-d300-b412-122d-780ce6ba1f78"],

Cell[BoxData[
 RowBox[{"resultH2", " ", "=", " ", "\n", " ", 
  RowBox[{"NMinimize", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"costH2", "[", 
     RowBox[{
     "\[Theta]1", ",", " ", "\[Theta]2", ",", " ", "\[Theta]3", ",", " ", 
      "\[Theta]4"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Theta]1", ",", " ", 
      RowBox[{"\\\n", "\[Theta]2"}], ",", " ", "\[Theta]3", ",", " ", 
      "\[Theta]4"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[60]:= ",
 CellID->1379404226,ExpressionUUID->"5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],

Cell["\<\
This function allows us to minimize the cost function by adjusting the \
parameters, and after performing this minimization, we obtain the optimized \
parameters and the minimum value of the cost function, which in this case is \
approximately -0.824.\
\>", "Text",
 CellID->790948907,ExpressionUUID->"7d3ffb2e-09a8-fc78-24c4-f288a842c742"],

Cell[BoxData[
 RowBox[{"paramH2", " ", "=", " ", 
  RowBox[{
   RowBox[{"Last", "[", "resultH2", "]"}], " ", "//", " ", 
   "Association"}]}]], "Input",
 CellLabel->"In[61]:= ",
 CellID->630069941,ExpressionUUID->"4139b36b-52b1-2977-70c6-2b356744785d"],

Cell["\<\
Now that we have the optimal value, it is insightful to inspect the behavior \
of the cost function around these points. Since we have four variables (the \
parameters in the ansatz), we need to fix two of the values in order to \
visualize the function.\
\>", "Text",
 CellID->129729226,ExpressionUUID->"494d6e39-7750-b6eb-7f72-806302ea1c31"],

Cell[TextData[{
 "We can do this by using a ",
 StyleBox["ContourPlot",
  FontWeight->"Bold"],
 ", which will allow us to observe the shape of the cost function in two \
dimensions."
}], "Text",
 CellID->2142768544,ExpressionUUID->"39b01e29-d171-5c92-6f4f-9072e00426f8"],

Cell[BoxData[
 RowBox[{"ContourPlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"costH2", "[", 
    RowBox[{"\[Theta]1", ",", " ", "\[Theta]2", ",", " ", 
     RowBox[{"paramH2", "[", "\[Theta]3", "]"}], ",", " ", "\n", "  ", 
     RowBox[{"paramH2", "[", "\[Theta]4", "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]1", ",", " ", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", " ", 
     RowBox[{"\[Pi]", "/", "\n", "   ", "2"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]2", ",", " ", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", " ", 
     RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", "Automatic"}]}], "]"}]], "Input",
 CellLabel->"In[62]:= ",
 CellID->466094680,ExpressionUUID->"4f6d713e-2461-11c8-7513-69784d146312"],

Cell[TextData[{
 StyleBox["ContourPlot",
  FontWeight->"Bold"],
 " is useful here because it highlights where the cost function attains \
higher and lower values. In this plot, the lighter sections correspond to \
higher values, and the blue sections represent the lowest values of the cost \
function."
}], "Text",
 CellID->1071716993,ExpressionUUID->"14ad582f-66ff-93eb-3c53-5189128be131"],

Cell[BoxData[
 RowBox[{"ContourPlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"costH2", "[", 
    RowBox[{"\[Theta]1", ",", " ", 
     RowBox[{"paramH2", "[", "\[Theta]2", "]"}], ",", " ", "\[Theta]3", ",", 
     " ", "\n", "  ", 
     RowBox[{"paramH2", "[", "\[Theta]4", "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]1", ",", " ", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", " ", 
     RowBox[{"\[Pi]", "/", "\n", "   ", "2"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]3", ",", " ", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", " ", 
     RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", "Automatic"}]}], "]"}]], "Input",
 CellLabel->"In[63]:= ",
 CellID->498033274,ExpressionUUID->"4f7ea056-2d28-85ec-7505-3a1044c2ef36"],

Cell["\<\
If the optimization algorithm has started with a point near the blue section \
(where the minimum lies), we can expect it to converge towards this blue \
region, as this represents the optimal set of parameters. The algorithm \
searches for regions where the cost is minimized, and this plot helps \
visualize the \[OpenCurlyDoubleQuote]shape\[CloseCurlyDoubleQuote] of the \
function.\
\>", "Text",
 CellID->2059214793,ExpressionUUID->"16b00368-b832-202d-3e4f-9b3239c77377"],

Cell[BoxData[
 RowBox[{"ContourPlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"costH2", "[", 
    RowBox[{
     RowBox[{"paramH2", "[", "\[Theta]1", "]"}], ",", " ", "\n", "  ", 
     RowBox[{"paramH2", "[", "\[Theta]2", "]"}], ",", " ", "\[Theta]3", ",", 
     " ", "\[Theta]4"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]3", ",", " ", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], "/", "\n", "   ", "2"}], ",", " ", 
     RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]4", ",", " ", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", " ", 
     RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[64]:= ",
 CellID->1358245629,ExpressionUUID->"06d00634-a672-f252-2eef-9871d304c0b8"],

Cell["\<\
When the cost function is relatively simple and can be expressed \
symbolically, the ContourPlot can exhibit repetitive patterns. This \
repetition often results from the periodic nature of trigonometric functions \
(e.g., sin\:2061and cos) that may appear in the cost function due to the \
rotation gates used in the ansatz.\
\>", "Text",
 CellID->2020715939,ExpressionUUID->"05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],

Cell["Example from https://arxiv.org/pdf/1909.05074v1", "Text",
 CellID->1652125120,ExpressionUUID->"583a98af-415b-100e-09d9-110970ee6354"],

Cell["Trihydrogen cation", "Text",
 CellID->1271733325,ExpressionUUID->"07beae85-a317-6bf9-2d45-47eed6a239c3"],

Cell[TextData[{
 "In this example we will obtain the minimal energy for the molecule Cation \
",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["H", "TI"], "3", "+"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],
 "."
}], "Text",
 CellID->163945760,ExpressionUUID->"60049622-f570-0e0e-103b-0f8ffc055554"],

Cell[TextData[{
 "First we will use some python code from ",
 StyleBox["PennyLane", "TI"],
 " to obtain the Hamiltonian corresponding to the H3 cation."
}], "Text",
 CellID->872684874,ExpressionUUID->"40ea559d-da93-7842-70ea-4cc6df264aa8"],

Cell["\<\
We just need to indicate the molecules \[OpenCurlyDoubleQuote]H\
\[CloseCurlyDoubleQuote] and the coordinates:\
\>", "Text",
 CellID->465017216,ExpressionUUID->"23ccc6ee-92c0-e596-51f3-dfc8277acffc"],

Cell["\<\
import pennylane as qml
from pennylane import numpy as np

symbols = [\"H\", \"H\", \"H\"]
coordinates = np.array([0.028, 0.054, 0.0, 0.986, 1.610, 0.0, 1.855, 0.002, \
0.0])

# Building the molecular hamiltonian for the trihydrogen cation
hamiltonian, qubits = qml.qchem.molecular_hamiltonian(symbols, coordinates, \
charge=1)

qml.matrix(hamiltonian)\
\>", "Program",
 CellID->673931302,ExpressionUUID->"114d8d02-b276-9c05-4772-256fc700e76f"],

Cell["\<\
In case Python is not available, you can import it from this location:\
\>", "Text",
 CellID->1757804831,ExpressionUUID->"2dc22b63-32d1-862f-5bf1-c34d4765ed75"],

Cell[BoxData[
 RowBox[{"Import", "[", "\"\<https://wolfr.am/1uXbew3vg\>\"", "]"}]], "Input",\

 CellLabel->"In[65]:= ",
 CellID->273265946,ExpressionUUID->"36ea7e2c-072a-2221-5eea-7076b2df710b"],

Cell["\<\
Finally we obtain a NumericArray which we will turn into a QuantumOperator:\
\>", "Text",
 CellID->1690214831,ExpressionUUID->"5b23761c-2477-64e8-0ad1-68464d024e32"],

Cell[BoxData[
 RowBox[{"H3", " ", "=", " ", 
  RowBox[{"QuantumOperator", "[", 
   RowBox[{"%", " ", "//", " ", "Normal"}], "]"}]}]], "Input",
 CellLabel->"In[66]:= ",
 CellID->134683244,ExpressionUUID->"73216bcf-7cf1-61ac-22de-82a9748433f6"],

Cell["\<\
If we have no prior knowledge of the structure of the circuit, a reasonable \
starting point could be a layered circuit consisting of rotations around the \
Y-axis and CNOT gates.\
\>", "Text",
 CellID->1556257858,ExpressionUUID->"69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],

Cell["\<\
To encode the occupation numbers of the molecular spin-orbitals, we would \
need six qubits.\
\>", "Text",
 CellID->1577223441,ExpressionUUID->"409bca18-cbd6-e54d-70b8-ec45ee60cf97"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"param", " ", "=", " ", 
   RowBox[{"GenerateParameters", "[", 
    RowBox[{"6", ",", " ", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"basicMixAnsatz", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"ParametrizedLayer", "[", 
        RowBox[{"\"\<RY\>\"", ",", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"1", ",", " ", "6"}], "]"}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"EntanglementLayer", "[", 
        RowBox[{"\"\<CNOT\>\"", ",", " ", 
         RowBox[{"Range", "[", "6", "]"}]}], "]"}], ",", "\n", 
       "    ", "\"\<Barrier\>\"", ",", "\n", "    ", 
       RowBox[{"ParametrizedLayer", "[", 
        RowBox[{"\"\<RY\>\"", ",", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"7", ",", " ", "12"}], "]"}]}], "]"}]}], "\n", "    ", 
      "}"}], ",", "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", "param"}]}], "\n", "   ", 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[67]:= ",
 CellID->2139778645,ExpressionUUID->"10b62b5f-1d3f-f012-404d-c31994cbc378"],

Cell[TextData[{
 "If you\[CloseCurlyQuote]d like to learn how to construct layered circuits \
using ",
 StyleBox["ParametrizedLayer",
  FontWeight->"Bold"],
 " and ",
 StyleBox["EntanglementLayer ",
  FontWeight->"Bold"],
 "please refer to the ",
 ButtonBox["Quantum Optimization documentation",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/PacletRepository/resources/\
Wolfram/QuantumFramework/tutorial/QuantumOptimization.html"], None}],
 "."
}], "Text",
 CellID->1405851554,ExpressionUUID->"79984792-c453-565a-2fb8-5edfede63ca0"],

Cell[BoxData[
 RowBox[{"basicMixAnsatz", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Full"}]}], "]"}]], "Input",
 CellLabel->"In[68]:= ",
 CellID->1087479710,ExpressionUUID->"1d45428e-8fa1-6801-4b7b-5be82a543b6b"],

Cell["\<\
In this case, you can expect a very complex symbolic cost function. To handle \
this, we could choose to implement a numerical function instead.\
\>", "Text",
 CellID->1803747723,ExpressionUUID->"604bb87d-3174-a116-1048-32274006f07c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"stateAnsatz", " ", "=", " ", 
   RowBox[{"basicMixAnsatz", "[", "]"}]}], ";"}]], "Input",
 CellLabel->"In[69]:= ",
 CellID->1593422651,ExpressionUUID->"763191a2-6f8b-197a-1fce-080c0a3e6840"],

Cell[BoxData[
 RowBox[{
  RowBox[{"matrixH3", " ", "=", " ", 
   RowBox[{"H3", "[", "\"\<Matrix\>\"", "]"}]}], ";"}]], "Input",
 CellLabel->"In[70]:= ",
 CellID->436649491,ExpressionUUID->"635fdfdb-2856-deda-1164-d68549e0a420"],

Cell[TextData[{
 "We begin by using Module to define the quantum state with parameters \
replaced by real numbers. Next, we define the ket and bra, and then compute \
the scalar resulting from the expectation value of the Hamiltonian ",
 StyleBox["H", "TI"],
 "."
}], "Text",
 CellID->180700730,ExpressionUUID->"0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "meanEnergy", "]"}], "\n", 
 RowBox[{
  RowBox[{"meanEnergy", "[", 
   RowBox[{"values_", ",", " ", "H_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ket", ",", " ", "bra", ",", " ", "state"}], "}"}], ",", "\n", 
    "  ", 
    RowBox[{
     RowBox[{"state", " ", "=", " ", 
      RowBox[{"stateAnsatz", "[", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{"param", ",", " ", "values"}], "]"}], "]"}]}], ";", "\n", 
     "  ", 
     RowBox[{"ket", " ", "=", " ", 
      RowBox[{"state", "[", "\"\<StateVector\>\"", "]"}]}], ";", "\n", "  ", 
     RowBox[{"bra", " ", "=", " ", 
      RowBox[{
       RowBox[{"SuperDagger", "[", "state", "]"}], "[", "\"\<StateVector\>\"",
        "]"}]}], ";", "\n", "  ", 
     RowBox[{"Re", "[", 
      RowBox[{"bra", " ", ".", " ", "H", " ", ".", " ", "ket"}], "]"}]}]}], 
   "\n", "  ", "]"}]}]}], "Input",
 CellLabel->"In[71]:= ",
 CellID->1734663358,ExpressionUUID->"5c8469dd-bfc7-2a7a-04bb-80873a727940"],

Cell["\<\
After defining the cost function, we can apply a classical optimizer starting \
from an initial guess to find the minimum energy value.\
\>", "Text",
 CellID->1532583077,ExpressionUUID->"182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"init", " ", "=", " ", 
   RowBox[{"Thread", "[", 
    RowBox[{"{", 
     RowBox[{"param", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\[Pi]", ",", " ", "0", ",", " ", "0", ",", " ", "0", ",", " ", 
        RowBox[{"\[Pi]", "/", "2"}], ",", " ", "\[Pi]", ",", " ", "0", ",", 
        " ", "0", ",", " ", "0", ",", " ", "\n", "     ", "0", ",", " ", 
        "\[Pi]", ",", " ", "0"}], "}"}]}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[72]:= ",
 CellID->557779582,ExpressionUUID->"3921e4bb-f5e4-3596-68de-fde483969ffc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindMinimum", "[", 
   RowBox[{
    RowBox[{"meanEnergy", "[", 
     RowBox[{"param", ",", " ", "matrixH3"}], "]"}], ",", " ", "init"}], 
   "]"}], " ", "//", " ", "Quiet"}]], "Input",
 CellLabel->"In[73]:= ",
 CellID->340907555,ExpressionUUID->"13db9173-5387-1c16-41f8-093d6632677c"],

Cell["Adiabatic Quantum Computing", "Section",
 CellID->359745509,ExpressionUUID->"6804c0ab-fd16-b7db-183b-d9f4f4a01d21"],

Cell["Introduction", "Subsection",
 CellID->1221057804,ExpressionUUID->"77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],

Cell["\<\
Adiabatic quantum computing provides an alternative paradigm for quantum \
algorithms, where the solution to a problem is encoded in the ground state of \
a final Hamiltonian. Instead of applying a sequence of quantum gates, the \
system is initialized in the ground state of a simple Hamiltonian and then \
slowly evolved toward a problem Hamiltonian whose ground state contains the \
desired answer.\
\>", "Text",
 CellID->1036598437,ExpressionUUID->"4289b0c6-8043-1b93-72b6-29a031f669f9"],

Cell["\<\
In practical implementations, however, the success of the algorithm depends \
on spectral properties such as the minimum energy gap between the ground and \
first excited states and related quantities that bound the required evolution \
time.\
\>", "Text",
 CellID->2050461533,ExpressionUUID->"070f3e08-556d-9d60-2d34-b0525c19e44a"],

Cell["\<\
In this post we illustrate these ideas with an extremely simple one-qubit \
example, using the Wolfram Quantum Framework to construct the Hamiltonians, \
visualize the spectral gap, estimate the adiabatic condition, and simulate \
the quantum evolution. Despite its simplicity, this example clearly shows how \
the spectral gap governs whether the adiabatic algorithm succeeds or fails, \
and how small perturbations on the system can dramatically affect the outcome.\
\>", "Text",
 CellID->797097006,ExpressionUUID->"6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],

Cell["Adiabatic Framework", "Subsection",
 CellID->464347903,ExpressionUUID->"4140e475-1e41-1f16-777f-fe3f9bf4627c"],

Cell["\<\
In adiabatic quantum computing, a computational problem is solved by evolving \
a quantum system from the ground state of a simple Hamiltonian to the ground \
state of a second Hamiltonian whose ground state encodes the solution. \
Instead of applying a sequence of discrete quantum gates, one prepares the \
system in the easy initial ground state and lets it evolve under a \
Hamiltonian that slowly interpolates between the two:\
\>", "Text",
 CellID->446903902,ExpressionUUID->"67f13035-938c-831a-0d8e-aa7f263eee60"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["H", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["s", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     StyleBox["s", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["B", "TI"]], "+", 
    StyleBox["s", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["P", "TI"]]}], ",", "\[ThinSpace]", 
   RowBox[{
    StyleBox["s", "TI"], "\[Element]"}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1739470850,ExpressionUUID->"16b44e14-0404-e868-3e4c-605eadb6bab2"],

Cell[TextData[{
 "Time appears through a rescaled parameter ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "\[ThinSpace]", "=", "\[ThinSpace]", 
   StyleBox["t", "TI"], "/", 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],
 " , where T is the total evolution time. The state obeys the \
time\:2011dependent Schr\[ODoubleDot]dinger equation:"
}], "Text",
 CellID->1570208593,ExpressionUUID->"7e10bd94-ae42-3b4d-262f-34d1cbf48997"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["i", "TI"], 
    FractionBox[
     StyleBox["d", "TI"], 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]], 
    TemplateBox[{
      RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["t", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Ket"]}], "=", 
   RowBox[{
    StyleBox["H", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{
      RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["t", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Ket"]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1989834147,ExpressionUUID->"5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"],

Cell["\<\
and at every instant the Hamiltonian has a complete set of instantaneous \
eigenstates and eigenvalues defined by:\
\>", "Text",
 CellID->959507005,ExpressionUUID->"013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["H", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["s", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     TemplateBox[{
       RowBox[{
         StyleBox["l", "TI"], ";", 
         StyleBox["s", "TI"]}]},
      "Ket"]}], "=", 
    RowBox[{
     SubscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["l", "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["s", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     TemplateBox[{
       RowBox[{
         StyleBox["l", "TI"], ";", 
         StyleBox["s", "TI"]}]},
      "Ket"]}]}], ",", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["E", "TI"], "0"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["s", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "\[LessEqual]", 
    RowBox[{
     SubscriptBox[
      StyleBox["E", "TI"], "1"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["s", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "\[LessEqual]", "\[Ellipsis]", "\[LessEqual]", 
    RowBox[{
     SubscriptBox[
      StyleBox["E", "TI"], 
      RowBox[{
       StyleBox["N", "TI"], "-", "1"}]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["s", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1118877932,ExpressionUUID->"4b734859-75e7-efa6-7901-62030393b58c"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ae31c17-eefa-a706-7a90-96508a8c0a6c"],
 " is the dimension of the Hilbert space. If the system is initialized in the \
ground state of the initial Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["s", "TI"], "=", "0"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00844d77-2817-3ec6-30bc-653149a3842c"],
 ":"
}], "Text",
 CellID->1907869029,ExpressionUUID->"20b97f64-b973-0c8a-5047-774e380656d0"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], "0"], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["s", "TI"], "=", "0", 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Ket"], "=", 
   TemplateBox[{
     RowBox[{
       StyleBox["l", "TI"], "=", "0", ";", 
       StyleBox["s", "TI"], "=", "0"}]},
    "Ket"]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->246496523,ExpressionUUID->"04469009-6b02-dcc3-2c7d-0a530eb4a629"],

Cell[TextData[{
 "then the Adiabatic Theorem states that if the energy gap between the two \
lowest levels ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["s", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["E", "TI"], "1"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["s", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   SubscriptBox[
    StyleBox["E", "TI"], "0"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["s", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],
 " remains strictly greater than zero for all ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "\[Element]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5547dfb6-0e84-e145-037c-d6f0ab36b3af"],
 ", and the evolution time \|01d447 is sufficiently large, the system will \
remain arbitrarily close to the instantaneous ground state throughout the \
evolution:"
}], "Text",
 CellID->3393050,ExpressionUUID->"12b61bfc-9cd7-eca9-424d-92a61563b6f3"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   StyleBox["l", "TI"], 
   StyleBox["i", "TI"], 
   SubscriptBox[
    StyleBox["m", "TI"], 
    RowBox[{"\|01d447", "\[Rule]", "\[Infinity]"}]], GridBox[{
     {
      TemplateBox[{
        RowBox[{
          StyleBox["l", "TI"], "=", "0", ";", 
          StyleBox["s", "TI"], "=", "1"}], 
        RowBox[{
          StyleBox["\[Psi]", "TI"], 
          StyleBox["(", SpanMaxSize -> 1], "\|01d447", 
          StyleBox[")", SpanMaxSize -> 1]}]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", "1"}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->217514705,ExpressionUUID->"451364b5-819d-fb99-7321-7dff3029c9e3"],

Cell[TextData[{
 "A nonzero gap forces the dynamics to follow the instantaneous ground state \
from the trivial start to the informative end, rather than wandering through \
the rest of Hilbert space . The minimum value of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["s", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13b49e24-0fb7-4441-414b-178eaa422eab"],
 " along the path therefore plays a privileged role : it sets how slow the \
evolution must be."
}], "Text",
 CellID->1659100998,ExpressionUUID->"445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],

Cell["\<\
How slow exactly? A more precise statement of the adiabatic condition \
involves not only the gap but also how strongly the changing Hamiltonian \
couples the ground and first excited states. The transition probability from \
the ground state to the first excited state depends on the matrix element:\
\>", "Text",
 CellID->1785475256,ExpressionUUID->"089aa42d-ce49-3603-38b9-3e76ebfd9d69"],

Cell[BoxData[
 PaneBox[GridBox[{
    {
     RowBox[{
      TemplateBox[{
        RowBox[{"1", ";", 
          StyleBox["s", "TI"]}]},
       "Bra"], 
      FractionBox[
       StyleBox[
        RowBox[{"d", "H"}], "TI"], 
       StyleBox[
        RowBox[{"d", "s"}], "TI"]], 
      TemplateBox[{
        RowBox[{"0", ";", 
          StyleBox["s", "TI"]}]},
       "Ket"]}]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->652560260,ExpressionUUID->"48fccab3-b886-a0f7-7883-e3fd3930f2dd"],

Cell["\<\
which measures how strongly the changing Hamiltonian couples the \
instantaneous ground state and the excited state. Then we define:\
\>", "Text",
 CellID->1636372342,ExpressionUUID->"0cdaad60-2181-5e26-34f9-454a5034250c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   StyleBox["\[Xi]", "TI"], "=", 
   RowBox[{
    StyleBox["m", "TI"], 
    StyleBox["a", "TI"], 
    SubscriptBox[
     StyleBox["x", "TI"], 
     RowBox[{
      StyleBox["s", "TI"], "\[ThinSpace]", "\[Element]", "\[ThinSpace]"}]], 
    GridBox[{
      {
       RowBox[{
        TemplateBox[{
          RowBox[{"1", ";", 
            StyleBox["s", "TI"]}]},
         "Bra"], 
        FractionBox[
         StyleBox[
          RowBox[{"d", "H"}], "TI"], 
         StyleBox[
          RowBox[{"d", "s"}], "TI"]], 
        TemplateBox[{
          RowBox[{"0", ";", 
            StyleBox["s", "TI"]}]},
         "Ket"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->95822906,ExpressionUUID->"542cff75-84e0-b601-7dd3-f73f2c9a1d6b"],

Cell["\<\
the adiabatic theorem implies that the total evolution time must satisfy \
approximately:\
\>", "Text",
 CellID->718055985,ExpressionUUID->"00dd9d4d-f7ec-565f-30e2-151681993ca5"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"\|01d447", ">", ">", 
    FractionBox[
     StyleBox["\[Xi]", "TI"], 
     SubsuperscriptBox[
      StyleBox["g", "TI"], 
      StyleBox[
       RowBox[{"m", "i", "n"}], "TI"], "2"]]}], "\[ThinSpace]", ",", 
   "\[ThinSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox[
      RowBox[{"m", "i", "n"}], "TI"]], "=", 
    RowBox[{
     StyleBox["m", "TI"], 
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["n", "TI"], 
      RowBox[{
       StyleBox["s", "TI"], "\[ThinSpace]", "\[Element]", "\[ThinSpace]"}]], "\[ThinSpace]", 
     StyleBox["g", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["s", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->746692575,ExpressionUUID->"0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],

Cell[TextData[{
 "Two quantities, then, control the algorithm: ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["g", "TI"], 
   StyleBox[
    RowBox[{"m", "i", "n"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],
 " measures how close the relevant levels come, and \|01d709 measures how \
strongly the Hamiltonian mixes them. We will compute both in the example \
below and then watch what happens when each one fails."
}], "Text",
 CellID->1284040510,ExpressionUUID->"333832e2-8bec-4128-62c7-abcc2d991072"],

Cell["QuantumAdiabaticEvolve", "Subsection",
 CellID->589806807,ExpressionUUID->"78cf51d6-d7cd-4672-28f5-4893e2782d58"],

