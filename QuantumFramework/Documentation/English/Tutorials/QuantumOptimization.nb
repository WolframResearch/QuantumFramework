Cell[BoxData[
 RowBox[{
  RowBox[{"costgrad", "[", 
   RowBox[{"\[Theta]1_", ",", " ", "\[Theta]2_"}], "]"}], " ", "=", " ", "\n",
   " ", 
  RowBox[{"Grad", "[", 
   RowBox[{
