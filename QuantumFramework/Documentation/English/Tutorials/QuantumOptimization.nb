         RowBox[{"\"\<X\>\"", ",", " ", 
          RowBox[{"{", "3", "}"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"covariance", "[", 
       RowBox[{"st2", ",", " ", 
        RowBox[{"QuantumMeasurementOperator", "[", 
         RowBox[{"\"\<X\>\"", ",", " ", 
          RowBox[{"{", "3", "}"}]}], "]"}], ",", " ", "\n", "    ", 
        RowBox[{"QuantumMeasurementOperator", "[", 
         RowBox[{"\"\<Y\>\"", ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}], ",", " ", "\n", "   ", 
      RowBox[{"variance", "[", 
       RowBox[{"st2", ",", " ", 
        RowBox[{"QuantumMeasurementOperator", "[", 
         RowBox[{"\"\<X\>\"", ",", " ", 
          RowBox[{"{", "3", "}"}]}], "]"}]}], "]"}]}], "}"}]}], "\n", "  ", 
   "}"}]}]], "Input",
 CellLabel->"In[267]:= ",
 CellID->1648462599,ExpressionUUID->"3f53e49d-d2a9-b4ee-6560-fdc6e75d1e34"],

Cell["Then the block diagonal matrix is the following:", "Text",
 CellID->345153179,ExpressionUUID->"672c7908-ff3c-85a7-0ed4-7155faceef8d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BlockDiagonalMatrix", "[", 
   RowBox[{"Chop", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g1", ",", " ", "g2"}], "}"}], ",", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "8"}]}]}], "]"}], "]"}], " ", "//", " ", 
  "MatrixForm"}]], "Input",
 CellLabel->"In[268]:= ",
 CellID->2088847814,ExpressionUUID->"4f36945c-6fe2-68e0-76cd-0e0609973aca"],

Cell["Cost function", "Text",
 CellID->726591063,ExpressionUUID->"250c2a2d-8da6-5f9d-5333-cc77245325e7"],

Cell[TextData[{
 "Continuing with the usual workflow, consider the system Hamiltonian to be \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["Y", "TI"]], "\[CircleTimes]", "\[ThinSpace]", "1", 
    "\[ThinSpace]", "\[CircleTimes]", "\[ThinSpace]", "1", 
    "\[ThinSpace]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67928f76-a8f6-4c39-0da1-2733c8831703"]
}], "Text",
 CellID->1671451775,ExpressionUUID->"6f8d9e4d-778e-395a-15b2-101702388ba0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VQCCost", "[", 
    RowBox[{
    "\[Theta]1_", ",", " ", "\[Theta]2_", ",", " ", "\[Theta]3_", ",", " ", 
     "\[Theta]4_"}], "]"}], " ", "=", " ", "\n", "  ", 
   RowBox[{"\"\<Scalar\>\"", " ", "//", " ", 
    RowBox[{
     RowBox[{"SuperDagger", "[", "VQCState", "]"}], "@", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", "\"\<YII\>\"", "]"}], "@", 
      "VQCState"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[269]:= ",
 CellID->1685164738,ExpressionUUID->"4897ab63-07fe-7036-78ac-434db18b431c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VQCCost", "[", 
    RowBox[{
    "\[Theta]1", ",", " ", "\[Theta]2", ",", " ", "\[Theta]3", ",", " ", 
     "\[Theta]4"}], "]"}], " ", "//", " ", "\n", "  ", "ComplexExpand"}], " ",
   "//", " ", "FullSimplify"}]], "Input",
 CellLabel->"In[270]:= ",
 CellID->1054397630,ExpressionUUID->"3afe1774-f6b9-1a20-6a85-8f31834c690a"],

Cell[TextData[{
 "Proceed to calculate the correspondent gradient for each ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Theta]", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cb96547-3d6c-b437-3447-7d21b41e1f1d"],
 ":"
}], "Text",
 CellID->1370415851,ExpressionUUID->"2231aed9-983c-87b7-53ce-478319ceed9d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VQCCostGrad", "[", 
   RowBox[{
   "\[Theta]1_", ",", " ", "\[Theta]2_", ",", " ", "\[Theta]3_", ",", " ", 
    "\[Theta]4_"}], "]"}], " ", "=", " ", "\n", " ", 
  RowBox[{"Grad", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"VQCCost", "[", 
       RowBox[{
       "\[Theta]1", ",", " ", "\[Theta]2", ",", " ", "\[Theta]3", ",", " ", 
        "\[Theta]4"}], "]"}], " ", "//", " ", "\n", "    ", "ComplexExpand"}],
      " ", "//", " ", "\n", "   ", "Simplify"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
     "\[Theta]1", ",", " ", "\[Theta]2", ",", " ", "\[Theta]3", ",", " ", 
      "\[Theta]4"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[271]:= ",
 CellID->736121047,ExpressionUUID->"4d324fdb-2677-e56b-74c2-66855303cfb1"],

Cell["Optimization", "Text",
 CellID->1859218103,ExpressionUUID->"5da8286f-a7a3-9cec-0b57-c248d257e636"],

Cell[TextData[{
 "For this example we will test using ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "\[ThinSpace]", "=", "\[ThinSpace]", "0.01"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d602230-5f26-2f06-2b1f-c47a5ad3726c"],
 " for 200 steps using ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    RowBox[{"\[ThinSpace]", 
     StyleBox[
      RowBox[{"i", "n", "i", "t", "i", "a", "l"}], "TI"]}]], "=", 
   RowBox[{"{", 
    RowBox[{"0.432", ",", 
     RowBox[{"-", "0.123"}], ",", "0.543", ",", 
     RowBox[{"0.233", "}"}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77db54cc-ee9f-ec5f-1df9-4da98b2bb6a5"]
}], "Text",
 CellID->1735201298,ExpressionUUID->"6a072e47-9a01-f132-1a3c-c0211fb5c018"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VQCQuantumParameters", " ", "=", " ", 
   RowBox[{"QuantumNaturalGradientDescent", "[", 
    RowBox[{"VQCCost", ",", " ", "metric", ",", "\n", "   ", 
     RowBox[{"\"\<Gradient\>\"", " ", "->", " ", "VQCCostGrad"}], ",", "\n", 
     "   ", 
     RowBox[{"\"\<LearningRate\>\"", " ", "->", " ", "0.01"}], ",", "\n", 
     "   ", 
     RowBox[{"\"\<InitialPoint\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0.432", ",", " ", 
        RowBox[{"-", "0.123"}], ",", " ", "0.543", ",", " ", "0.233"}], 
       "}"}]}], ",", "\n", "   ", 
     RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "200"}]}], "\n", "   ", 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[272]:= ",
 CellID->906785362,ExpressionUUID->"03b41a97-fa59-5a01-314b-93d0ffec296b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VQCStateVainillaParameters", " ", "=", " ", "\n", "  ", 
   RowBox[{"GradientDescent", "[", 
    RowBox[{"VQCCost", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.432", ",", " ", 
       RowBox[{"-", "0.123"}], ",", " ", "0.543", ",", " ", "0.233"}], "}"}], 
     ",", "\n", "   ", 
     RowBox[{"\"\<LearningRate\>\"", " ", "->", " ", "0.01"}], ",", "\n", 
