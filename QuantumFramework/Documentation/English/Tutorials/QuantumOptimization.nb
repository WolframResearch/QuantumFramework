 CellID->1185869569,ExpressionUUID->"68418108-62e2-e866-187e-19521694bb4c"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\[Mu]", "]"}], "\n", 
 RowBox[{
  RowBox[{"\[Mu]", "[", 
   RowBox[{
   "\[Omega]1_", ",", " ", "\[Omega]2_", ",", " ", "\[Omega]3_", ",", " ", 
    "l_", ",", " ", "lp_", ",", " ", "j_"}], "]"}], " ", ":=", " ", "\n", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Mu]Re", ",", " ", "\[Mu]Im"}], "}"}], ",", "\n", "  ", "\n", 
    "  ", 
    RowBox[{
     RowBox[{"\[Mu]Re", " ", "=", " ", "\n", "   ", 
      RowBox[{"LocalMeanValues", "[", 
       RowBox[{
       "\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\[Omega]3", ",", " ", 
        "l", ",", " ", "lp", ",", " ", "j", ",", " ", "0"}], "]"}]}], ";", 
     "\n", "  ", 
     RowBox[{"\[Mu]Im", " ", "=", " ", "\n", "   ", 
      RowBox[{"LocalMeanValues", "[", 
       RowBox[{
       "\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\[Omega]3", ",", " ", 
        "l", ",", " ", "lp", ",", " ", "\n", "    ", "j", ",", " ", 
        RowBox[{
         RowBox[{"-", "\[Pi]"}], "/", "2."}]}], "]"}]}], ";", "\n", "  ", 
     "\n", "  ", "\n", "  ", 
     RowBox[{"N", "[", 
      RowBox[{"\[Mu]Re", " ", "+", " ", 
       RowBox[{"j", "  ", "\[Mu]Im"}]}], "]"}]}]}], "\n", "  ", 
   "]"}]}]}], "Input",
 CellLabel->"In[339]:= ",
 CellID->1911467353,ExpressionUUID->"01703913-adda-f952-370f-b15cc46ccbb8"],

Cell[TextData[{
 "We prepend a 0 value in the constants from the ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6126f6d0-c79c-20ba-10dd-ef9df2297280"],
 " problem matrixso it later matches with the system qubits index:"
}], "Text",
 CellID->606833914,ExpressionUUID->"1e4879c1-44de-859e-4648-70ab6d68efe4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.", ",", " ", "1.0", ",", " ", "0.2", ",", " ", "0.2"}], 
    "}"}]}], ";"}]], "Input",
 CellLabel->"In[340]:= ",
 CellID->1061597539,ExpressionUUID->"6d2a80d4-ca9b-9dca-1b29-1991ef2fe710"],

Cell[TextData[{
 "Now we will implement the normalization term. In this case ",
 StyleBox["l", "TI"],
 " and ",
 StyleBox["lp", "TI"],
 " values correspond to our system qubits:"
}], "Text",
 CellID->904580048,ExpressionUUID->"56de89fa-72f1-8b5c-7ee5-20a40685d9a6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "PsiNorm", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PsiNorm", "[", 
    RowBox[{"\[Omega]1_", ",", " ", "\[Omega]2_", ",", " ", "\[Omega]3_"}], 
    "]"}], " ", ":=", " ", "\n", "  ", 
   RowBox[{"Abs", "[", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"c", "[", 
        RowBox[{"[", "l", "]"}], "]"}], "*", "\n", "     ", 
       RowBox[{"Conjugate", "[", 
        RowBox[{"c", "[", 
         RowBox[{"[", "lp", "]"}], "]"}], "]"}], "*", 
       RowBox[{"\[Mu]", "[", 
        RowBox[{
        "\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\[Omega]3", ",", " ", 
         "l", ",", " ", "\n", "      ", "lp", ",", " ", 
         RowBox[{"-", "1"}]}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"l", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"lp", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "}"}]}], "]"}],
     "]"}]}], ";"}]}], "Input",
 CellLabel->"In[341]:= ",
 CellID->2121593724,ExpressionUUID->"081b024f-dee7-bb3c-3838-a428da930606"],

Cell[TextData[{
 "Following the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["C", "TI"], 
   StyleBox["L", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3068938a-aea6-7f4c-6017-0ad7cb534596"],
 " equation, we define the cost function:"
}], "Text",
 CellID->1473938160,ExpressionUUID->"59143b51-5090-fe62-0f2b-b31b612ac548"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "LocalCost", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"LocalCost", "[", 
   RowBox[{"\[Omega]1_", ",", " ", "\[Omega]2_", ",", " ", "\[Omega]3_"}], 
   "]"}], " ", ":=", " ", "\n", " ", 
  RowBox[{"0.5", " ", "-", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"0.5", "/", 
      RowBox[{"(", 
       RowBox[{"3", " ", 
        RowBox[{"PsiNorm", "[", 
         RowBox[{"\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\[Omega]3"}], 
         "]"}]}], ")"}]}], ")"}], " ", 
    RowBox[{"Abs", "[", "\n", "    ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"c", "[", 
         RowBox[{"[", "l", "]"}], "]"}], "*", "\n", "      ", 
        RowBox[{"Conjugate", "[", 
         RowBox[{"c", "[", 
          RowBox[{"[", "lp", "]"}], "]"}], "]"}], "*", 
        RowBox[{"\[Mu]", "[", 
         RowBox[{
         "\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\[Omega]3", ",", " ", 
          "l", ",", " ", "lp", ",", "\n", "        ", "j"}], "]"}]}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"l", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"lp", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "}"}]}], 
      "]"}], "]"}]}]}]}]}], "Input",
 CellLabel->"In[342]:= ",
 CellID->1459782673,ExpressionUUID->"4b8a926c-2b03-23e8-7989-14364eb67132"],

Cell["Symbolic Cost Function Optimization", "Text",
 CellID->163957365,ExpressionUUID->"0eb42765-6752-c125-364b-bf4f12e4900f"],

Cell["\<\
Let\[CloseCurlyQuote]s calculate the symbolic equation for the cost function. \
It is not that huge of an expression, but surely not visually pleasant to \
show here:\
\>", "Text",
 CellID->989116332,ExpressionUUID->"3dda19df-f0ae-deb2-6bf9-90988158a498"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "LocalCostFunction", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LocalCostFunction", "[", 
     RowBox[{"\[Omega]1_", ",", " ", "\[Omega]2_", ",", " ", "\[Omega]3_"}], 
     "]"}], " ", "=", " ", "\n", "   ", 
    RowBox[{"Simplify", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"LocalCost", "[", 
       RowBox[{"\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\[Omega]3"}], 
       "]"}], ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Omega]1", ",", " ", 
         RowBox[{"\\\n", "\[Omega]2"}], ",", " ", "\[Omega]3"}], "}"}], " ", "\[Element]",
        " ", "Reals"}]}], "]"}]}], ";"}], " ", "//", " ", 
  "AbsoluteTiming"}]}], "Input",
 CellLabel->"In[343]:= ",
 CellID->481615410,ExpressionUUID->"40683ad5-3e3c-3dc9-7017-b39fbbce8713"],

Cell["Since we have the symbolic function, we can use NMinimize:", "Text",
 CellID->1876573571,ExpressionUUID->"1b8f60bd-75aa-c5dc-49b5-79e77c5caf26"],

Cell[BoxData[
 RowBox[{"GradientParameters", " ", "=", " ", "\n", " ", 
  RowBox[{"NMinimize", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"LocalCostFunction", "[", 
     RowBox[{"\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\[Omega]3"}], 
     "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Omega]1", ",", " ", 
      RowBox[{"\\\n", "\[Omega]2"}], ",", " ", "\[Omega]3"}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[344]:= ",
 CellID->1834937724,ExpressionUUID->"5fc740cd-cbf6-6955-05fd-5996ed833bbf"],

Cell["Numerical Cost Function Optimization", "Text",
 CellID->1619955370,ExpressionUUID->"003aef4b-20aa-e832-31d9-0715515cbb18"],

Cell["\<\
We can use our previously defined LocalCost for numerical calculations using \
a numerical gradient descent:\
\>", "Text",
 CellID->924053440,ExpressionUUID->"28e0bad7-cafc-1653-589f-3390ee897cb9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Omega]", " ", "=", " ", 
   RowBox[{"0.001", " ", "*", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", "]"}], ",", " ", "3"}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[345]:= ",
 CellID->1393824139,ExpressionUUID->"2580c3d6-5855-812a-53bf-da9059e1d070"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NGradientParameters", " ", "=", " ", "\n", "   ", 
    RowBox[{"GradientDescent", "[", 
     RowBox[{"LocalCost", ",", " ", "\[Omega]", ",", " ", 
      RowBox[{"\"\<LearningRate\>\"", " ", "->", " ", "0.8"}], ",", " ", "\n",
       "    ", 
      RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "15"}]}], "]"}]}], 
   ";"}], " ", "//", " ", "AbsoluteTiming"}]], "Input",
 CellLabel->"In[346]:= ",
 CellID->1951021798,ExpressionUUID->"56436948-eb78-7da0-7e70-81158e0d478a"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"LocalCostFunction", " ", "@@@", " ", "NGradientParameters"}], ",",
    " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", "\n", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Optimization steps\>\"", ",", 
      " ", "\"\<Cost Function Value\>\""}], "}"}]}], ",", " ", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{
    "{", "\"\<1 \[Dash] \[VerticalSeparator]\!\(\*TemplateBox[{\\\"b\\\", \
\\\"\[Psi]\\\"},\n\
\\\"BraKet\\\"]\)\!\(\*SuperscriptBox[\(\[VerticalSeparator]\), \(2\)]\)\>\"",
      "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[347]:= ",
 CellID->488321874,ExpressionUUID->"1d2fa041-c708-9d58-44d4-3a2af2a2e7a2"],

Cell["Classical Linear System Solving", "Text",
 CellID->1170011309,ExpressionUUID->"77a399cd-5599-60ee-1d50-10975c2c3234"],

Cell[TextData[{
 "We can build the ",
 StyleBox["A", "TI"],
 " matrix and state",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["b", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "225dc93e-a235-4cfc-5262-e17bd7c016c6"],
 "of the present problem:"
}], "Text",
 CellID->1313618093,ExpressionUUID->"6f2e1950-aca6-616f-16d5-911dc55333b5"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   SubscriptBox[
    StyleBox["c", "TI"], "2"], 
   SubscriptBox[
    StyleBox["A", "TI"], "2"], "+", 
   SubscriptBox[
    StyleBox["c", "TI"], "3"], 
   SubscriptBox[
    StyleBox["A", "TI"], "3"], "+", 
   SubscriptBox[
    StyleBox["c", "TI"], "4"], 
   SubscriptBox[
    StyleBox["A", "TI"], "4"], "=", "\|01d7d9", "+", "0.2", 
   SubscriptBox[
    StyleBox["X", "TI"], "2"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "3"], "+", "0.2", 
   SubscriptBox[
    StyleBox["X", "TI"], "2"]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->776389205,ExpressionUUID->"716ae4bc-5935-f42e-2769-fde658c1df74"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     StyleBox["b", "TI"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["U", "TI"], 
     TemplateBox[{"0"},
      "Ket"]}], "=", 
    RowBox[{
     SubscriptBox[
      StyleBox["H", "TI"], "2"], 
     SubscriptBox[
      StyleBox["H", "TI"], "3"], 
     SubscriptBox[
      StyleBox["H", "TI"], "4"], 
     TemplateBox[{"0"},
      "Ket"]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1475018355,ExpressionUUID->"59aa617b-186b-0315-0faa-7925991e6e7f"],

Cell["\<\
Solve the system by operating over the corresponding matrices:\
\>", "Text",
 CellID->364308012,ExpressionUUID->"008b4284-ba53-483f-3089-5bee3fe61b05"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"c", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "*", 
     RowBox[{"IdentityMatrix", "[", "8", "]"}]}], " ", "+", "\n", "   ", 
    RowBox[{
     RowBox[{"c", "[", 
      RowBox[{"[", "3", "]"}], "]"}], "*", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", "\n", "     ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], " ", "+", " ", 
    "\n", "   ", 
    RowBox[{
     RowBox[{"c", "[", 
      RowBox[{"[", "4", "]"}], "]"}], "*", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "\n", "     ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"b", " ", "=", " ", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"Sqrt", "[", "8", "]"}]}], ",", " ", "8"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<A\>\"", " ", "->", " ", 
    RowBox[{"MatrixForm", "[", "A", "]"}]}], ",", " ", "\n", " ", 
   RowBox[{"\"\<\!\(\*TemplateBox[{\\\"b\\\"},\n\\\"Ket\\\"]\)\>\"", " ", "->",
     " ", 
    RowBox[{"MatrixForm", "[", "b", "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[348]:= ",
 CellID->800406252,ExpressionUUID->"3c0a4c18-9cc5-5190-640a-6642157023fa"],

Cell["Finally, compute the probabilities:", "Text",
 CellID->868584379,ExpressionUUID->"1ec90d37-5b76-64dd-46f6-a5715e034e27"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"LinearSystemResult", " ", "=", " ", 
   RowBox[{
    RowBox[{"Normalize", "[", 
     RowBox[{"LinearSolve", "[", 
      RowBox[{"A", ",", " ", "b"}], "]"}], "]"}], "^", "2"}]}], ";"}], "\n", 
 RowBox[{"Thread", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Ket", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Delete", "[", "0", "]"}], "@", "#"}], "}"}], "]"}], " ", 
     "&"}], " ", "/@", " ", 
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<0\>\"", ",", " ", "\"\<1\>\""}], "}"}], ",", " ", "3"}], 
     "]"}]}], " ", "->", " ", "\n", "  ", "LinearSystemResult"}], 
  "]"}]}], "Input",
 CellLabel->"In[349]:= ",
 CellID->753301360,ExpressionUUID->"0f4a94b8-2093-0aa7-3549-0de25126588d"],

Cell["Symbolic & Numeric Quantum Circuit Result", "Text",
 CellID->1978950738,ExpressionUUID->"746ef244-02b1-295f-1c15-f42eb7447ba5"],

Cell["\<\
Test the Variational circuit with the optimized parameters results:\
\>", "Text",
 CellID->1722777548,ExpressionUUID->"16a579b4-853c-ad3d-3e5b-70fe2ccef407"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VariationalMeasurement", " ", "=", " ", "\n", "  ", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{"VariationalBlock", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "}"}], "]"}], "[",
     "]"}]}], ";"}]], "Input",
 CellLabel->"In[350]:= ",
 CellID->1415836705,ExpressionUUID->"3d0d0eda-2f65-a967-6b32-a7844a11f84d"],

Cell["The symbolic optimization resultant probabilities:", "Text",
 CellID->998055726,ExpressionUUID->"25424d11-215d-69ec-5372-655b50e83b36"],

Cell[BoxData[
 RowBox[{"SymbolicResult", " ", "=", " ", "\n", " ", 
  RowBox[{
   RowBox[{"VariationalMeasurement", "[", 
    RowBox[{"Association", "[", 
     RowBox[{"GradientParameters", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "[", "\n", 
   "  ", "\"\<Probabilities\>\"", "]"}]}]], "Input",
 CellLabel->"In[351]:= ",
 CellID->51177994,ExpressionUUID->"38b2585b-f0b8-eb1e-6842-52048132b664"],

Cell["The numerical optimization resultant probabilities:", "Text",
 CellID->1006291039,ExpressionUUID->"310aba1e-c173-53a6-6709-3c5bf006218c"],

Cell[BoxData[
 RowBox[{"NumericalResult", " ", "=", " ", "\n", " ", 
  RowBox[{
   RowBox[{"VariationalMeasurement", "[", "\n", "   ", 
    RowBox[{"AssociationThread", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\[Omega]3"}], 
       "}"}], ",", " ", "\n", "    ", 
      RowBox[{"Last", "@", "NGradientParameters"}]}], "]"}], "]"}], 
   "[", "\"\<Probabilities\>\"", "]"}]}]], "Input",
 CellLabel->"In[352]:= ",
 CellID->158911658,ExpressionUUID->"6d663f9d-52b3-ad35-1b1d-b6c76747f41f"],

Cell["\<\
We can calculate how different one distribution is from another using the \
Kullback\[Dash]Leibler divergence:\
\>", "Text",
 CellID->1288431282,ExpressionUUID->"0ae604be-6e2a-038b-3a9d-9df80bdf51d1"],

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "*", 
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "/", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], " ", "&"}], " ", "/@", " ",
    "\n", "  ", 
   RowBox[{"Thread", "[", 
    RowBox[{"{", 
     RowBox[{"LinearSystemResult", ",", " ", 
      RowBox[{"Values", "@", "SymbolicResult"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[353]:= ",
 CellID->1357490061,ExpressionUUID->"5a3bb7fa-395b-d8d2-0bd8-2ea4b8efaa38"],

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "*", 
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "/", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], " ", "&"}], " ", "/@", " ",
    "\n", "  ", 
   RowBox[{"Thread", "[", 
    RowBox[{"{", 
     RowBox[{"LinearSystemResult", ",", " ", 
      RowBox[{"Values", "@", "NumericalResult"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[354]:= ",
 CellID->1685734529,ExpressionUUID->"77106238-91db-a6eb-1d2f-8462206f0c31"],

Cell["\<\
Since the results are small, it is an indicator that the distributions are \
similar.\
\>", "Text",
 CellID->1120748791,ExpressionUUID->"01a00532-4a0e-3544-375f-9d7c6fb89fae"],

Cell["We can also employ a Kolmogorov Smirnov Test:", "Text",
 CellID->1261495738,ExpressionUUID->"1f5de8ef-4b2e-05e8-4562-01c96edb6f32"],

Cell[BoxData[
 RowBox[{"KolmogorovSmirnovTest", "[", 
  RowBox[{
   RowBox[{"Values", "@", "SymbolicResult"}], ",", " ", 
   "LinearSystemResult"}], "]"}]], "Input",
 CellLabel->"In[355]:= ",
 CellID->1489870152,ExpressionUUID->"39671b4e-a434-cf2d-6f1c-932bcdc69277"],

Cell[BoxData[
 RowBox[{"KolmogorovSmirnovTest", "[", 
  RowBox[{
   RowBox[{"Values", "@", "NumericalResult"}], ",", " ", 
   "LinearSystemResult"}], "]"}]], "Input",
 CellLabel->"In[356]:= ",
 CellID->1285364544,ExpressionUUID->"1fdf432e-aa6d-b711-45e5-5a8bcf191a7b"],

Cell["\<\
In this case, the number is considered big enough to indicate that the \
results are from the reference distribution.\
\>", "Text",
 CellID->378341706,ExpressionUUID->"6d59f3c2-2879-5f97-1b66-eaac490c25fd"],

Cell["Let\[CloseCurlyQuote]s plot the probabilities for a visual \
comparison:", "Text",
 CellID->2124605039,ExpressionUUID->"2630e3fa-641e-82e1-4fcf-faa40da8d0cb"],

Cell[BoxData[
 RowBox[{"BarChart", "[", "\n", " ", 
  RowBox[{
