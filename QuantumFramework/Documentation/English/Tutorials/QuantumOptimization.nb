Cell["\<\
The ground state is reached in less steps by the quantum gradient descent.\
\>", "Text",
 CellID->363842804,ExpressionUUID->"0b03a0e0-ac2b-54e8-3930-39cdc5de3e32"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"VQCCost", " ", "@@@", " ", "VQCQuantumParameters"}], ",", " ", 
     "\n", "  ", 
     RowBox[{"VQCCost", " ", "@@@", " ", "VQCStateVainillaParameters"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
