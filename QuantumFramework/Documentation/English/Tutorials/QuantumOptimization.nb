      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Theta]1", ",", " ", "\[Theta]2"}], "}"}], " ", "\[Element]",
        " ", "\n", "    ", "Reals"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Theta]1", ",", " ", "\[Theta]2"}], "}"}]}], "]"}]}]], "Input",\

