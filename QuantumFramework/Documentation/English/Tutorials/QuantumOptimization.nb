Cell[TextData[{
 "Start with a variational circuit ansatz ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b2a7c99-762e-0564-192a-75c303db6c4e"],
 " or directly an state ansatz ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["x", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox["i", "TI"]], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    StyleBox["V", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox["i", "TI"]], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{"0"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15f5c2c8-4d3f-e85b-438a-db9264cbbaa1"]
}], "Item",
 CellID->1434588493,ExpressionUUID->"14c9f408-7194-4cc4-3cf6-ee520021162e"],

Cell[TextData[{
 "Apply the multiplexer to perform ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], ".", 
   RowBox[{
    StyleBox["x", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox["i", "TI"]], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38fb8547-75f1-44dc-6898-1d2103842e26"],
 " and obtain resultant ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71ac5ef3-5fe8-d867-2754-57bd5982ab4d"],
 " state"
}], "Item",
 CellID->1965360996,ExpressionUUID->"29854b4c-a654-c8a2-5fbb-6329d3e69a88"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59c17136-c551-666f-0fff-6973ece44cb5"],
 " state as the input for the optimizer with the cost function ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Omega]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{"1", "-", 
    RowBox[{GridBox[{
       {
        TemplateBox[{
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["\[Psi]", "TI"], 
            StyleBox["(", SpanMaxSize -> 1], 
            StyleBox["\[Omega]", "TI"], 
            StyleBox[")", SpanMaxSize -> 1]}]},
         "BraKet"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], 
     SuperscriptBox["", 
      RowBox[{"\[ThinSpace]", "2"}]]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "345db6df-ede1-7415-5c62-2f988b945f7f"],
 "to obtain new ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23d8e320-2d42-669a-51e7-fa8a44f74ce0"],
 " parameters"
}], "Item",
 CellID->738829623,ExpressionUUID->"296ab46d-a3f4-f13b-5f69-2e36d586c001"],

Cell[TextData[{
 "Use new ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cac3d4d-2028-a76d-1453-b51751c20db7"],
 " parameters with the variational circuit ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f515ffd-22dc-f8c8-256f-56a7576eca12"],
 " or state ansatz ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["j", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36fe791f-fced-9eb8-5e86-7158f499e482"]
}], "Item",
 CellID->1064021658,ExpressionUUID->"76a256fd-37ed-da8a-1e52-4fa74199a8d0"],

Cell[TextData[{
 "Repeat the process until you obtain ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox[
       RowBox[{"o", "p", "t"}], "TI"]], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    RowBox[{"1", "-", 
     RowBox[{GridBox[{
        {
         TemplateBox[{
           StyleBox["b", "TI"], 
           RowBox[{
             StyleBox["\[Psi]", "TI"], 
             StyleBox["(", SpanMaxSize -> 1], 
             SubscriptBox[
              StyleBox["\[Omega]", "TI"], 
              RowBox[{
                StyleBox["o", "TI"], 
                StyleBox["p", "TI"], 
                StyleBox["t", "TI"]}]], 
             StyleBox[")", SpanMaxSize -> 1]}]},
          "BraKet"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], 
      SuperscriptBox["", 
       RowBox[{"\[ThinSpace]", "2"}]]}]}], "=", "0"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6deb6a83-c2a1-684f-1be8-83ecf7543a95"]
}], "Item",
 CellID->1219022038,ExpressionUUID->"789236d2-9f43-12ba-28a1-af9c1af66080"],

Cell["Example", "Subsubsection",
 CellID->308356936,ExpressionUUID->"383adb7b-ef12-e6f5-69d9-d3248aa4ccdf"],

Cell["Simple example", "Text",
 CellID->1464556755,ExpressionUUID->"4d2f2d89-c57c-c791-74d4-c4d2ec0eadfb"],

Cell["Generate a random 4\[Times]4 real matrix:", "Text",
 CellID->952856188,ExpressionUUID->"0be1af94-d211-8aa3-399e-46d1e7a5d889"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"m", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"m", " ", "//", " ", "MatrixForm"}]}], "Input",
 CellLabel->"In[385]:= ",
 CellID->1459080717,ExpressionUUID->"20c93ef5-aaf5-6d2e-50f6-b7bece803474"],

Cell["Generate a random complex vector of the length 4:", "Text",
 CellID->532908105,ExpressionUUID->"2d278640-9b14-0749-54dc-182a1ea16d93"],

Cell[BoxData[
 RowBox[{"b", " ", "=", " ", 
  RowBox[{"RandomComplex", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "0.1"}], " ", "-", " ", 
       RowBox[{"0.1", " ", "I"}]}], ",", " ", 
      RowBox[{"0.1", " ", "+", " ", 
       RowBox[{"0.1", " ", "I"}]}]}], "}"}], ",", " ", "4"}], 
   "]"}]}]], "Input",
 CellLabel->"In[386]:= ",
 CellID->925215622,ExpressionUUID->"27508344-1169-d276-4d6f-1b2ea01da15c"],

Cell[TextData[{
 "Use them as input in the ",
 Cell[BoxData["QuantumLinearSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52bd9efb-5696-d8d3-0242-17a56320aa39"],
 ":"
}], "Text",
 CellID->1935095580,ExpressionUUID->"59d784c6-d1d1-3822-0fec-1da3e0658b08"],

Cell[BoxData[
 RowBox[{"QuantumLinearSolve", "[", 
  RowBox[{"m", ",", " ", "b"}], "]"}]], "Input",
 CellLabel->"In[387]:= ",
 CellID->1182693673,ExpressionUUID->"0af74c3d-c5cb-eb2b-3a8d-6666ec7fb671"],

