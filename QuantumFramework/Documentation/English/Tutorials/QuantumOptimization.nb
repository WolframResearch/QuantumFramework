     "146756d1-ea39-ec02-3c1d-4f9a8fcdb768"]], "TableText",ExpressionUUID->
     "1a7ee52b-d767-0389-4a05-fd74e21251d3"], Cell[
    "step size taken during each iteration", "TableText",ExpressionUUID->
     "419fd7e1-c297-cbe2-77a4-cecaf72399c8"]}
  }]], "3ColumnTableMod",
 CellID->302342835,ExpressionUUID->"7a33ac2f-4fb5-380e-2bc0-45896a418b54"],

Cell["Gradient", "Text",
 CellID->1440790055,ExpressionUUID->"3b56b9eb-04f6-5b17-696d-30b5ac83267d"],

Cell[TextData[{
 "You can specify the correspondant gradient function ",
 Cell[BoxData[
  RowBox[{"\[Del]", 
   StyleBox["f", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e9dc2e4-4753-bfbd-16a2-dbce72e70587"],
 ":"
}], "Text",
 CellID->335633755,ExpressionUUID->"7db41629-8d3d-b9f9-2b4b-887324c90bc3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"df", "[", 
   RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", "=", " ", 
  RowBox[{"\\!", 
   RowBox[{"\\(", "\n", 
    RowBox[{
     RowBox[{"\\*", 
      RowBox[{"SubscriptBox", "[", 
       RowBox[{
        RowBox[{"\\(", "\[Del]", "\\)"}], ",", " ", 
        RowBox[{"\\(", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], "\\)"}]}], "]"}]}], 
     RowBox[{"\\(", 
      RowBox[{"f", "[", 
       RowBox[{"x", ",", " ", "y"}], "]"}], "\\)"}]}], "\\)"}]}]}]], "Input",
 CellLabel->"In[213]:= ",
 CellID->781316651,ExpressionUUID->"3f51d24b-32fb-3155-656e-d415468f83bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"parameters", " ", "=", " ", 
   RowBox[{"GradientDescent", "[", 
    RowBox[{"f", ",", " ", "initial", ",", " ", 
     RowBox[{"\"\<Gradient\>\"", " ", "->", " ", "df"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[214]:= ",
 CellID->30392753,ExpressionUUID->"32e9efb5-7328-71d0-6296-06ff06dd433a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", " ", "@@", " ", "#"}], ",", " ", 
     RowBox[{"x", " ", "->", " ", 
      RowBox[{"#", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
     RowBox[{"y", " ", "->", " ", 
      RowBox[{"#", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], " ", "&"}], "@", 
  RowBox[{"Last", "[", "parameters", "]"}]}]], "Input",
 CellLabel->"In[215]:= ",
 CellID->840947663,ExpressionUUID->"0aa19f46-928a-afd4-3a5e-1720273cf53e"],

Cell["\<\
If the gradient is not specified, it is calculated numerically using a center \
finite differnece algorithm.\
\>", "Text",
 CellID->1354069952,ExpressionUUID->"31860dcc-84f8-941b-67bd-a4962d72ff61"],

Cell["MaxIterations", "Text",
 CellID->86332890,ExpressionUUID->"08371d00-4cf7-24ac-39cc-956a64838ef6"],

Cell["Specify the maximum number of iterations to use:", "Text",
 CellID->83865236,ExpressionUUID->"6e555e8f-0ad0-492d-166b-57e9af651877"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"parameters1", " ", "=", " ", 
   RowBox[{"GradientDescent", "[", 
    RowBox[{"f", ",", " ", "initial", ",", " ", 
     RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "5"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"parameters2", " ", "=", " ", 
   RowBox[{"GradientDescent", "[", 
    RowBox[{"f", ",", " ", "initial", ",", " ", 
     RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "15"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[216]:= ",
 CellID->438684355,ExpressionUUID->"348b0551-d20e-4e96-5c88-9d1ae7bb14fc"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{"{", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"f", " ", "@@@", " ", "#"}], "}"}], ",", "\n", "     ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Optimization steps\>\"", ",", " ", "\"\<f\>\""}], 
         "}"}]}], ",", "\n", "     ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", "\n", 
       "     ", 
       RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}], " ", "&"}], 
    " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"parameters1", ",", " ", "parameters2"}], "}"}]}], "}"}], "\n", 
  " ", "]"}]], "Input",
 CellLabel->"In[217]:= ",
 CellID->1361658265,ExpressionUUID->"5c065349-950a-8738-043e-4b131cbcea02"],

Cell["LearningRate", "Text",
 CellID->598931314,ExpressionUUID->"4ff276a9-5e86-52e3-7582-6ff35b3320c9"],

Cell["\<\
Specify step size (\[Eta]) taken during each iteration, compare the following \
gradient descent setups:\
\>", "Text",
 CellID->328986207,ExpressionUUID->"24b6e2ad-c501-b7fc-4c4d-fbf6ecb51dc6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"parameters1", " ", "=", " ", "\n", "  ", 
   RowBox[{"GradientDescent", "[", 
    RowBox[{"f", ",", " ", "initial", ",", " ", 
     RowBox[{"\"\<LearningRate\>\"", " ", "->", " ", "0.9"}], ",", " ", "\n", 
     "   ", 
     RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "5"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"parameters2", " ", "=", " ", "\n", "  ", 
   RowBox[{"GradientDescent", "[", 
    RowBox[{"f", ",", " ", "initial", ",", " ", 
     RowBox[{"\"\<LearningRate\>\"", " ", "->", " ", "0.5"}], ",", " ", "\n", 
     "   ", 
     RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "5"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[218]:= ",
 CellID->32491118,ExpressionUUID->"230cad6b-7900-e120-5133-453578bab00a"],

Cell["\<\
In this case, the optimization is done almost instantly by \"LearningRate\" \
-> 0.5:\
\>", "Text",
 CellID->813803762,ExpressionUUID->"086f7f71-a7b7-bd3e-3815-773ad2430404"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", " ", "@@@", " ", "parameters1"}], ",", " ", 
     RowBox[{"f", " ", "@@@", " ", "parameters2"}]}], "}"}], ",", " ", "\n", 
   " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Optimization steps\>\"", ",", " ", "\"\<f\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Eta] = 0.9\>\"", ",", " ", "\"\<\[Eta] = 0.5\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}]}], "]"}]], "Input",
 CellLabel->"In[219]:= ",
 CellID->2055424800,ExpressionUUID->"0cdf8892-1d3f-31f6-34e4-21dc94cb83dc"],

Cell["\<\
We can visually verify that \[Eta] = 0.9 was not efficent to find the \
solution:\
\>", "Text",
 CellID->1582751234,ExpressionUUID->"7e0217c2-6a7a-d359-2631-8eac0f0ca1a3"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", "\n", "  ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Labeled", "[", 
       RowBox[{
        RowBox[{"parameters1", "[", 
         RowBox[{"[", "n", "]"}], "]"}], ",", " ", "n"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "5"}], "}"}]}], "]"}], "\n", "  ", "}"}], ",", 
   "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", " ", "\"\<y\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]], "Input",
 CellLabel->"In[220]:= ",
 CellID->1785120453,ExpressionUUID->"4104c6da-03d7-a765-773b-df84b6630a4f"],

Cell["Natural Gradient Descent", "Subsection",
 CellID->301291799,ExpressionUUID->"731f4b84-5335-8b87-2125-62ee66c1d9ed"],

Cell["\<\
When using a regular gradient descent, we assume a flat or Euclidean \
parameter space. The algorithm does not consider the intrinsic geometry of \
the cost function, which can result in not\[Dash]unique parametrizations \
which would lead to inefficient search for the minimum value, specially near \
to singular points.\
\>", "Text",
 CellID->829823394,ExpressionUUID->"315717aa-70ab-e706-676c-8ef4015fca6c"],

Cell["\<\
To account for the geometry of our cost function, we can generalize the \
Gradient Descent to the Natural Gradient Descent by incorporating a metric \
tensor \[ScriptCapitalF]. Specifically, we utilize the inverse of the \
corresponding metric tensor to adjust the gradient direction. This approach \
can lead to improved optimization results.\
\>", "Text",
 CellID->2109767706,ExpressionUUID->"7c1b1617-f81f-7a45-2438-8850f9aa48af"],

Cell["The step of the Natural Gradient Descent is given by:", "Text",
 CellID->451634577,ExpressionUUID->"70b05f1a-470c-9c9d-2040-574472bee6e7"],

