Cell["\<\
where \[ScriptCapitalL](\[Theta]) is the cost function with parameters \
\[Theta], and \[Eta] is the step rate.\
\>", "Text",
 CellID->1206895343,ExpressionUUID->"529c5c95-0588-d8f1-02a4-55dfac22aadb"],

Cell["Workflow", "Subsubsection",
 CellID->1225011434,ExpressionUUID->"18bedc4a-f6ca-97e0-4845-d617837cfdca"],

Cell["Initialization", "Item",
 CellID->351011596,ExpressionUUID->"5f18273e-5cf5-00f5-0527-bf78548052df"],

Cell["\<\
Begin with an initial set of parameters. This initial guess can either be \
random or from a heuristic approach.\
\>", "Item",
 CellID->158147379,ExpressionUUID->"1890d11b-851d-d227-48af-c9452ca9a10d"],

Cell[TextData[{
 "Calculate the gradient ",
 Cell[BoxData[
  RowBox[{"\[Del]", "\[ScriptCapitalL]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b8be800-baff-aedd-0988-026a3e8bf427"]
}], "Item",
 CellID->61284932,ExpressionUUID->"224fae0e-4768-b263-5274-406872020149"],

Cell[TextData[{
 "Represented as the vector in the previous image, which are the partial \
derivatives of the objective function ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d32ba1d-71ed-60b8-64c1-3c4707983282"],
 " with respect to each parameter ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ccd4f42-4869-4b08-64f3-672c691c1652"],
 ". The gradient indicates the direction of the steepest ascent."
}], "Item",
 CellID->7534582,ExpressionUUID->"0cf63df4-f608-7ba6-348d-b4b183bd498c"],

Cell["Update parameters", "Item",
 CellID->1253762927,ExpressionUUID->"60948258-d69f-7f2c-10ab-2405e32a4276"],

Cell["\<\
Adjust the parameters in the opposite direction of the gradient to minimize \
the function. The update rule is the one in the image.\
\>", "Item",
 CellID->1443799103,ExpressionUUID->"5bf5c13c-8c81-f0bf-098a-d9662535c285"],

Cell["\<\
The learning rate, is a small positive scalar that controls the step size \
towards the minimum.\
\>", "Item",
 CellID->698730821,ExpressionUUID->"27ebc314-3813-af61-4de8-db5eb9a7f24b"],

Cell["Iterate Until Convergence", "Item",
 CellID->778202397,ExpressionUUID->"59cd495b-92f8-de82-0ff3-61052772a4e8"],

Cell["\<\
Repeat steps 2 and 3 until a stopping criterion is satisfied.\
\>", "Item",
 CellID->322721677,ExpressionUUID->"1597811c-d04f-58d0-43ac-1959e1fa2a3a"],

Cell["\<\
The convergence criterion could be based on a threshold for changes in the \
function value or when the gradient\[CloseCurlyQuote]s magnitude falls below \
a specific limit, indicating that further updates won\[CloseCurlyQuote]t \
substantially improve the result. In some cases, steps 2 and 3 may simply be \
performed for a fixed number of iterations.\
\>", "Text",
 CellID->382408521,ExpressionUUID->"0d69ae9d-d0a3-a5e3-3b16-47c6e1570fc9"],

Cell["\<\
Also, selecting an appropriate learning rate is critical: if it\
\[CloseCurlyQuote]s too small, convergence will be slow; if it\
\[CloseCurlyQuote]s too large, it can lead to oscillations or even divergence.\
\>", "Text",
 CellID->1500760326,ExpressionUUID->"1e10fbdd-fcac-b923-462f-f286f55e0809"],

Cell["Example", "Subsubsection",
 CellID->902241290,ExpressionUUID->"68c26b95-e958-d351-18f1-82de88d2a1bb"],

Cell["Implement a simple function", "Text",
 CellID->1428011457,ExpressionUUID->"56b7d10b-4c3b-5ee0-7e4c-c95565ce24ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"x", "^", "2"}], " ", "+", " ", 
   RowBox[{"y", "^", "2"}]}]}]], "Input",
 CellLabel->"In[207]:= ",
 CellID->891909510,ExpressionUUID->"40ed67f4-ffa0-5cce-7093-7eb1fa552614"],

Cell[TextData[{
 "Set initial parameters and use ",
 StyleBox["GradientDescent",
  FontWeight->"Bold"],
 " to minimize the function:"
}], "Text",
 CellID->857394593,ExpressionUUID->"4dc0df98-8a2c-0889-7bff-d6c22fd95ad3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"initial", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "4"}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[208]:= ",
 CellID->170897694,ExpressionUUID->"2226f602-e60c-c55a-53dd-e86f93beafa0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"parameters", " ", "=", " ", 
   RowBox[{"GradientDescent", "[", 
    RowBox[{"f", ",", " ", "initial"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[209]:= ",
 CellID->211740260,ExpressionUUID->"4ed808ee-885a-0ea1-76e7-a1c829ef548b"],

Cell[TextData[{
 StyleBox["GradientDescent",
  FontWeight->"Bold"],
 " returns all the parameters obtained until convergence. We can check how \
the minimization evolved:"
}], "Text",
 CellID->1384883633,ExpressionUUID->"1627cdbb-2852-50d0-3fdc-e4e549e7223a"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"f", " ", "@@@", " ", "parameters"}], ",", " ", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Optimization steps\>\"", ",", " ", "\"\<f\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}]}], "]"}]], "Input",
 CellLabel->"In[210]:= ",
 CellID->488506383,ExpressionUUID->"6801141d-c5dc-e96b-183e-8e46ec6ebbb1"],

Cell["\<\
The last parameters obtained correspond to the minimized function:\
\>", "Text",
 CellID->337904332,ExpressionUUID->"2fb5e010-3b47-28f4-554a-fa5abef27ade"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", " ", "@@", " ", "#"}], ",", " ", 
     RowBox[{"x", " ", "->", " ", 
      RowBox[{"#", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
     RowBox[{"y", " ", "->", " ", 
      RowBox[{"#", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], " ", "&"}], "@", 
  RowBox[{"Last", "[", "parameters", "]"}]}]], "Input",
 CellLabel->"In[211]:= ",
 CellID->325222869,ExpressionUUID->"69461d9a-9714-a717-1f7d-94c422a60a7d"],

Cell["We can contrast the result using NMinimize:", "Text",
 CellID->399992999,ExpressionUUID->"1b3cd9b2-b2f5-0832-4ac3-d0ffc6805b18"],

Cell[BoxData[
 RowBox[{"NMinimize", "[", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x", ",", " ", "y"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[212]:= ",
 CellID->133795044,ExpressionUUID->"17254721-59fc-dba5-3edb-5e8b5f8ea98f"],

Cell["Options", "Subsubsection",
 CellID->567663292,ExpressionUUID->"52d6b4d2-7b23-95d3-02ed-2d9c7ed7ff39"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "133f88c9-4e43-c7a8-42c4-21936bf7adf2"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"525bf512-066b-f79b-0278-ed5cb31fdde1"],
