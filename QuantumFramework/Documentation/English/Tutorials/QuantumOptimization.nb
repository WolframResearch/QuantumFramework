Cell[TextData[{
 "This phenomenon is more clearly illustrated by looking at the StreamPlots \
generated for the gradient and the preconditioned gradient. On the left, the \
standard gradient allows us to pass through ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], "1"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66994d41-411f-db5d-0ea7-652b70aba9a7"],
 ", while on the right, the corrected gradient prevents this from \
happening.:"
}], "Text",
 CellID->2102998422,ExpressionUUID->"5ba5d17e-cdbf-5380-095a-c93be44a21ea"],

