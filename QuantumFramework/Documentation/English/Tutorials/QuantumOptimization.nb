Cell[BoxData[
 RowBox[{
  RowBox[{"generator", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Theta]1", "*", "\n", "      ", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<X\>\"", " ", "->", " ", 
            RowBox[{"{", "1", "}"}]}], ",", " ", 
           RowBox[{"\"\<I\>\"", " ", "->", " ", 
            RowBox[{"{", "2", "}"}]}]}], "}"}], "]"}]}], " ", "-", " ", 
       RowBox[{"\[Theta]2", "*", "\n", "      ", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<Z\>\"", " ", "->", " ", 
            RowBox[{"{", "1", "}"}]}], ",", " ", 
           RowBox[{"\"\<X\>\"", " ", "->", " ", 
            RowBox[{"{", "2", "}"}]}]}], "}"}], "]"}]}], " ", "+", " ", 
       RowBox[{"\[Theta]3", "*", "\n", "      ", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<I\>\"", " ", "->", " ", 
            RowBox[{"{", "1", "}"}]}], ",", " ", 
           RowBox[{"\"\<X\>\"", " ", "->", " ", 
            RowBox[{"{", "2", "}"}]}]}], "}"}], "]"}]}]}], ")"}], ",", " ", 
     "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[Theta]1", ",", " ", "\[Theta]2", ",", " ", "\[Theta]3"}], 
       "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[201]:= ",
 CellID->1471331040,ExpressionUUID->"0c6e076f-8b93-3c10-3415-9f492e27877a"],

Cell["\<\
We will differentiate \[Theta]1. Implement the correspondant matrix fixing \
other parameters:\
\>", "Text",
 CellID->1667468316,ExpressionUUID->"29094997-c9cb-f733-5f37-60d0e87fda19"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generatorMatrix", "[", "\[Theta]1_", "]"}], " ", "=", " ", "\n", 
  " ", 
  RowBox[{
   RowBox[{
    RowBox[{"generator", "[", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\[Theta]2", " ", "->", " ", "0.15"}], ",", " ", 
       RowBox[{"\[Theta]3", " ", "->", " ", "1.6"}]}], "|>"}], "]"}], 
    "[", "\"\<Matrix\>\"", "]"}], " ", "//", " ", "\n", "  ", 
   "Normal"}]}]], "Input",
 CellLabel->"In[202]:= ",
 CellID->1895525730,ExpressionUUID->"284fc6fb-b6ce-6422-5874-dfa4c37b4f08"],

Cell["\<\
For this algorithm we need the operator not associated with \[Theta]1:\
\>", "Text",
 CellID->1565214496,ExpressionUUID->"0cad16aa-0a89-b805-3452-8ff4af3d0b6f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "0.15"}], "*", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<Z\>\"", " ", "->", " ", 
         RowBox[{"{", "1", "}"}]}], ",", " ", 
        RowBox[{"\"\<X\>\"", " ", "->", " ", 
         RowBox[{"{", "2", "}"}]}]}], "}"}], "]"}]}], " ", "+", " ", "\n", 
    "   ", 
    RowBox[{"1.6", "*", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<I\>\"", " ", "->", " ", 
         RowBox[{"{", "1", "}"}]}], ",", " ", 
        RowBox[{"\"\<X\>\"", " ", "->", " ", 
         RowBox[{"{", "2", "}"}]}]}], "}"}], "]"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[203]:= ",
 CellID->307249831,ExpressionUUID->"5640583a-c911-1fe8-7e70-5267e8a46532"],

Cell[TextData[{
 "Calculate the gradient using ",
 StyleBox["SPSRGradientValues ",
  FontWeight->"Bold"],
 "indicating the Pauli matrix associated with \[Theta]1 and the H opeator \
defined before:"
}], "Text",
 CellID->1691696036,ExpressionUUID->"6944803a-8297-e066-1f7b-1a643723b34c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generatorGradient", " ", "=", " ", 
   RowBox[{"ASPSRGradientValues", "[", 
    RowBox[{"generatorMatrix", ",", " ", "\"\<PauliX\>\"", ",", " ", "H"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[204]:= ",
 CellID->959885487,ExpressionUUID->"7e9e495e-a796-7cd0-26a6-611bd223463a"],

Cell["Check the result and find a suitable fit:", "Text",
 CellID->780129813,ExpressionUUID->"534f7e63-03c8-ee33-0175-704db662b519"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"generatorGradient", ",", " ", "\n", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", "\"\<\!\(\*SubscriptBox[\(\[Theta]\), \(1\)]\)\>\"", "}"}]}],
    ",", "\n", " ", 
   RowBox[{"PlotLabel", " ", "->", " ", "\"\<SPSR\[Dash]Gradient value\>\""}],
    ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]], "Input",
 CellLabel->"In[205]:= ",
 CellID->938531488,ExpressionUUID->"3b07ad27-9e6a-154b-693c-44811b1f7f91"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Fit", "[", 
     RowBox[{"generatorGradient", ",", " ", "\n", "    ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "n", " ", "\[Theta]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", 
          RowBox[{"-", "5"}], ",", " ", "5"}], "}"}]}], "]"}], ",", " ", 
      "\[Theta]"}], "]"}], " ", "//", " ", "Re"}], " ", "//", " ", "\n", "  ",
    "ComplexExpand"}], " ", "//", " ", 
  RowBox[{
   RowBox[{"Chop", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "1"}]}]}], "]"}], " ", "&"}]}]], "Input",
 CellLabel->"In[206]:= ",
 CellID->1883068862,ExpressionUUID->"1c7a415c-3e53-b7cb-441a-5906bbe71d11"],

Cell["Gradient Descent", "Subsection",
 CellID->1358375441,ExpressionUUID->"417aec05-2fbb-8238-7719-066f4a4fd102"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4705486f-1ac0-4964-6d3b-62499f75184e"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"3af5a034-7641-6879-6a8a-3a7e03f43b43"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"68379bed-79e9-22be-19cc-12b77f9c7084"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "460eb9f9-c41e-8ef4-6e35-30a2eda8d4de"], Cell[TextData[{
     "GradientDescent[",
     StyleBox["f", "TI"],
     ",",
     Cell[BoxData[
      RowBox[{
       RowBox[{"{", 
        SubscriptBox[
         StyleBox["value",
          FontSlant->"Italic"], "1"]}], ",", 
       SubscriptBox[
        StyleBox["value",
         FontSlant->"Italic"], "2"], ",", 
       RowBox[{"\[Ellipsis]", "\[ThinSpace]", "}"}], ",", "\[ThinSpace]", 
       StyleBox["opts",
        FontSlant->"Italic"]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "258251be-7c16-7495-53b2-48f875a35eff"],
     "]]"
    }], "TableText",ExpressionUUID->"35c1f832-722b-ca69-63fe-f27c07df98b3"], 
    Cell[TextData[{
     "calculates the gradient descent of ",
     StyleBox["f", "TI"],
     " using ",
     Cell[BoxData[
      RowBox[{
       StyleBox["v", "TI"], 
       StyleBox["a", "TI"], 
       StyleBox["l", "TI"], 
       StyleBox["u", "TI"], 
       SubscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["i", "TI"]]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7b6a50da-eb07-3910-296a-49878eb3887a"],
     " as initial parameters."
    }], "TableText",ExpressionUUID->"23591dbb-79d4-ec10-5166-94e57866b77a"]}
  }]], "2ColumnTableMod",
 CellID->350735935,ExpressionUUID->"114fd905-c79d-9420-4774-d16ef229ff0a"],

Cell["\<\
From an analytical perspective, setting the gradient equal to zero and \
solving for the parameters would give us the solution. However, this is not \
something a computer can easily compute. Instead, computers rely on \
calculating the gradient to \[OpenCurlyDoubleQuote]move toward the minimum.\
\[CloseCurlyDoubleQuote]\
\>", "Text",
 CellID->1960614345,ExpressionUUID->"0047a90f-9cb0-808d-307c-4169154ad2d7"],

Cell["\<\
One optimizer that stands out in this context is the well-known Gradient \
Descent!\
\>", "Text",
 CellID->205251588,ExpressionUUID->"42e32fd7-26e6-6b71-7290-c6915293365b"],

Cell["\<\
Gradient Descent is a fundamental optimization technique used to minimize a \
function. It is widely used across various fields, such as machine learning, \
numerical optimization, and quantum computing.\
\>", "Text",
 CellID->68643055,ExpressionUUID->"4a2652ed-88d4-efb2-7bde-4bb72966b598"],

Cell["\<\
The goal of Gradient Descent is to find the minimum of a cost function by \
adjusting the parameters iteratively in the direction of the steepest descent \
of the function being minimized as you can see in this image equation:\
\>", "Text",
 CellID->2084984838,ExpressionUUID->"0962d9db-7466-8598-3f11-d0857d10efe2"],

