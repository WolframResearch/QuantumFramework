           RowBox[{"Delete", "[", "0", "]"}], "@", "#"}], "}"}], "]"}], " ", 
        "&"}], " ", "/@", " ", 
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<0\>\"", ",", " ", "\"\<1\>\""}], "}"}], ",", " ", 
         "2"}], "]"}]}], ",", " ", "None"}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"ChartLegends", " ", "->", " ", 
