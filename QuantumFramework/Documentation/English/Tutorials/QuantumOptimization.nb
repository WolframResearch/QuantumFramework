Cell["\<\
Each minigraph contributes to a partial solution, illustrated by colored \
nodes yellow and red:\
\>", "Text",
 CellID->393497398,ExpressionUUID->"684f0173-fe99-1571-1874-993cfb2c7c5b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"states", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Keys", "@", 
      RowBox[{"ReverseSortBy", "[", 
       RowBox[{
        RowBox[{"#", "[", "\"\<Probabilities\>\"", "]"}], ",", " ", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], " ", "&"}], " ", "/@", 
    " ", "result"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"groups", " ", "=", " ", "\n", "  ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"states", "[", 
        RowBox[{"[", 
         RowBox[{"Sequence", " ", "@@", " ", "##1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "\n", "     ", "1"}], "}"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"solution", " ", "=", " ", "\n", "  ", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Thread", " ", "/@", " ", "\n", "    ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"#1", "[", "\"\<Order\>\"", "]"}], "]"}], " ", "&"}], 
         ")"}], " ", "/@", " ", "subQAOA"}], " ", "->", " ", "groups"}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"minig", " ", "=", " ", 
   RowBox[{"Graph", "[", 
    RowBox[{"g", ",", " ", "\n", "  ", 
     RowBox[{"VertexLabels", " ", "->", " ", "\n", "   ", 
      RowBox[{"MapAt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Placed", "[", 
          RowBox[{"#1", ",", " ", "Center"}], "]"}], " ", "&"}], " ", ",", 
        " ", "$CellContext`solution", ",", " ", 
        RowBox[{"{", 
         RowBox[{"All", ",", " ", "\n", "     ", "2"}], "}"}]}], "]"}]}]}], 
    "]"}]}], ";", " ", 
  RowBox[{"incompleteHigh", " ", "=", " ", "\n", " ", 
   RowBox[{"HighlightGraph", "[", "\n", "  ", 
    RowBox[{"minig", ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Subgraph", "[", 
         RowBox[{"$CellContext`g", ",", " ", "#1"}], "]"}], " ", "&"}], " ", 
       ")"}], " ", "/@", " ", "\n", "   ", 
      RowBox[{
       RowBox[{"GatherBy", "[", 
        RowBox[{"$CellContext`solution", ",", " ", "Last"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "All", ",", " ", "1"}], "]"}], "]"}]}], ",", 
     " ", "\n", "  ", 
     RowBox[{"VertexLabelStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", " ", "12"}], "]"}]}], ",", " ", "\n", "  ", 
     RowBox[{"GraphHighlightStyle", " ", "->", " ", "\"\<Thick\>\""}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"gsub", ",", " ", "incompleteHigh"}], "}"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Full"}]}], "]"}]}], "Input",
 CellLabel->"In[180]:= ",
 CellID->367031453,ExpressionUUID->"6e32c5a8-aee9-5273-17c1-dcf5ca9c2159"],

Cell["Conquer (Big graph)", "Subsection",
 CellID->205825583,ExpressionUUID->"607492e2-157b-ba0c-100b-0bcc9c0f0956"],

Cell["\<\
In the Conquer phase, we construct a new graph where each node represents a \
subgraph, and the edges are based on their prior connections:\
\>", "Text",
 CellID->750655011,ExpressionUUID->"7781757c-388d-abb9-1dbf-6d26b939f983"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"as", " ", "=", " ", 
   RowBox[{"<|", "solution", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bigEdges", " ", "=", " ", "\n", "  ", 
   RowBox[{"Complement", "[", 
    RowBox[{
     RowBox[{"EdgeList", "[", "g", "]"}], ",", " ", "\n", "   ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"EdgeList", " ", "/@", " ", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Subgraph", "[", 
           RowBox[{"g", ",", " ", "#"}], "]"}], " ", "&"}], ",", " ", 
         "edges"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"smallToBig", " ", "=", " ", "\n", "  ", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Thread", " ", "/@", " ", "\n", "    ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"VertexList", " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{
         "\[ScriptX]1", ",", " ", "\[ScriptX]2", ",", " ", "\[ScriptX]3", ",",
           " ", 
          RowBox[{"\\\n", "\[ScriptX]4"}]}], "}"}]}], " ", "->", " ", 
       RowBox[{"Range", "[", "4", "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bigedges", " ", "=", " ", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"EdgeList", "[", "bigEdges", "]"}], " ", "/.", " ", "\n", 
      "     ", 
      RowBox[{
       RowBox[{"z", " ", ":", " ", 
        RowBox[{"UndirectedEdge", "[", 
         RowBox[{"x_", ",", " ", "y_"}], "]"}]}], " ", ":>", " ", "\n", 
       "      ", 
       RowBox[{"Rule", "[", 
        RowBox[{
         RowBox[{"z", " ", "/.", " ", "smallToBig"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", 
           RowBox[{"as", "[", "x", "]"}]}], "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", 
           RowBox[{"as", "[", "y", "]"}]}]}]}], "]"}]}]}], " ", "//", " ", 
     "\n", "    ", 
     RowBox[{
      RowBox[{"Merge", "[", 
       RowBox[{"#", ",", " ", "Total"}], "]"}], " ", "&"}]}], " ", "//", " ", 
    "Normal"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g2", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Reverse", "@", 
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"EdgeWeight", " ", "->", " ", "#"}], ",", " ", "\n", "     ", 
       RowBox[{"EdgeLabels", " ", "->", " ", "\"\<EdgeWeight\>\""}], ",", " ", 
       RowBox[{"EdgeLabelStyle", " ", "->", " ", "20"}], ",", " ", "\n", 
       "     ", 
