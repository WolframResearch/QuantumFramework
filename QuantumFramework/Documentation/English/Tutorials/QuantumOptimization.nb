Cell["Details and Options", "Subsubsection",
 CellID->1282790066,ExpressionUUID->"7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],

Cell["Details & Options", "Section",
 CellID->1271105746,ExpressionUUID->"12c044c4-b778-74e1-42f0-5da1c20d5ecb"],

Cell[TextData[{
 "The interpolating Hamiltonian is defined as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["s", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["s", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["b", "TI"]], "+", 
   StyleBox["s", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["p", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d9aa029-60a8-273a-6bb9-3a7311428a00"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "\[ThinSpace]", "\[Element]", "\[ThinSpace]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64adc082-4122-deff-0c52-d9ec70d4a4c5"],
 "."
}], "Item",
 CellID->406260488,ExpressionUUID->"7e451771-8a55-ceec-267a-8f3b2fe19436"],

Cell[TextData[{
 "The evolution is used to prepare the ground state of the target Hamiltonian \
",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["H", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4670f053-f537-0b3f-6e0f-ea1cfcc25605"],
 " from the ground state of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["H", "TI"], 
   StyleBox["b", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "330aabc0-bdd5-22a3-6109-42aa34607089"],
 "."
}], "Item",
 CellID->1300527012,ExpressionUUID->"38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],

Cell["\<\
The function computes the eigensystem along the interpolation, the spectral \
gap, the minimum gap, the adiabatic coupling and the estimated evolution time.\
\>", "Item",
 CellID->712875671,ExpressionUUID->"70d705b8-410a-1477-20ec-9ce270bf7f5d"],

Cell["\<\
The eigensystem is internally ordered by energy to identify the ground state \
and first excited state along the interpolation.\
\>", "Item",
 CellID->1019167872,ExpressionUUID->"737c509e-bc52-eefb-2104-49d835e4b4c1"],

Cell["\<\
The adiabatic condition is evaluated using the gap and coupling between these \
two lowest energy levels, which typically dominate non-adiabatic transitions.\
\
\>", "Item",
 CellID->433474298,ExpressionUUID->"01a44b6b-c85f-9e0e-375c-6334e9ebe554"],

Cell[TextData[{
 "These are the available options for ",
 Cell[BoxData["QuantumAdiabaticEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],
 ":"
}], "Item",
