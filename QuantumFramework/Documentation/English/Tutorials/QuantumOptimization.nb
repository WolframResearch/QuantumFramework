Cell["\<\
where \[Eta] is the learning rate, \[Del]\[ScriptCapitalL](\[Theta]) the \
gradient cost function and \[ScriptCapitalF](\[Theta]) the metric tensor that \
inform us about the geometry of parameter space.\
\>", "Text",
 CellID->567083581,ExpressionUUID->"4fa3f928-0446-c8dd-7550-f172adf09a27"],

Cell["The Fubini\[Dash]Study Metric Tensor", "Subsection",
 CellID->299420638,ExpressionUUID->"3727240c-f62b-7b8f-5edc-be6983de49d5"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "50637aef-2122-41f7-0011-73c950d713dd"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"63773809-2d44-01f7-110c-b25344f153dd"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"7ede8b7e-b317-5b7c-26e5-233bc6a22646"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "75c8f24b-f46e-7672-23f7-f414fd1b5d58"], Cell[TextData[Cell[BoxData[
     RowBox[{"FubiniStudyMetricTensor", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumState", "[", "...", "]"}], "\\"}], ",", " ", ",", 
       RowBox[{
        RowBox[{"\\", "mathit"}], 
        RowBox[{"{", "opts", "}"}]}]}], "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2d149507-d3df-875e-5b2b-0d60e66beda4"]], "TableText",ExpressionUUID->
     "772d62ae-4bf9-dab0-1ed3-7b086d8da89a"], Cell[TextData[{
     "calculates the Fubini\[Dash]Study metric tensor as defined by the VQE \
approach from a ",
     StyleBox["QuantumState", "TI"],
     " with defined parameters"
    }], "TableText",ExpressionUUID->"7a8c9a4d-0caa-515e-2ab3-1c17a55f23a4"]}
  }]], "2ColumnTableMod",
 CellID->1652743706,ExpressionUUID->"6a4c6a75-6554-e0e6-1a73-8c3f0ce6b2cc"],

Cell["\<\
So what happens when we have a quantum optimization problem? When using a \
Quantum Variational Algorithm, we will face a similar problem. In this case \
the parameter space is defined in the space of quantum states.\
\>", "Text",
 CellID->682260934,ExpressionUUID->"29c3108e-8c9d-f317-5ff0-89e82529de7d"],

Cell[TextData[{
 "In the search for a metric tensor for the quantum state space, we found the \
Fubini\[Dash]Study metric tensor ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["g", "TI"], 
   StyleBox[
    RowBox[{"i", "j"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b90d741-2df1-4c37-09af-cf2b4b84171d"],
 ":"
}], "Text",
 CellID->207770031,ExpressionUUID->"5a353f88-1ea4-a3d5-0bca-b6d29b56f13f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], "=", 
    RowBox[{
     RowBox[{
      StyleBox["R", "TI"], 
      StyleBox["e", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       TemplateBox[{
         RowBox[{
           SubscriptBox["\[PartialD]", 
            StyleBox["i", "TI"]], 
           StyleBox["\[Psi]", "TI"]}], 
         RowBox[{
           SubscriptBox["\[PartialD]", 
            StyleBox["j", "TI"]], 
           StyleBox["\[Psi]", "TI"]}]},
        "BraKet"], 
       StyleBox[")",
        SpanMaxSize->1]}]}], "-", 
     RowBox[{
      TemplateBox[{
        RowBox[{
          SubscriptBox["\[PartialD]", 
           StyleBox["i", "TI"]], 
          StyleBox["\[Psi]", "TI"]}], 
        StyleBox["\[Psi]", "TI"]},
       "BraKet"], 
      TemplateBox[{
        StyleBox["\[Psi]", "TI"], 
        RowBox[{
          SubscriptBox["\[PartialD]", 
           StyleBox["j", "TI"]], 
          StyleBox["\[Psi]", "TI"]}]},
       "BraKet"]}]}]}], ",", 
   RowBox[{
    TemplateBox[{
      RowBox[{
        SubscriptBox["\[PartialD]", 
         StyleBox["i", "TI"]], 
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["\[Theta]", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Ket"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", 
       StyleBox["i", "TI"]], 
      TemplateBox[{
        RowBox[{
          StyleBox["\[Psi]", "TI"], 
          StyleBox["(", SpanMaxSize -> 1], 
          StyleBox["\[Theta]", "TI"], 
          StyleBox[")", SpanMaxSize -> 1]}]},
       "Ket"]}], "/", 
     RowBox[{"\[PartialD]", 
      SubscriptBox[
       StyleBox["\[Theta]", "TI"], 
       StyleBox["i", "TI"]]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1992745372,ExpressionUUID->"3c3a5085-d835-7232-65da-49eed9c04118"],

Cell["\<\
The Fubini-Study metric is a way to measure the \
\[OpenCurlyDoubleQuote]distance\[CloseCurlyDoubleQuote] between two quantum \
states, helping us understand how different or similar they are. For qubits, \
you can picture it as part of the way we understand their movement on the \
Bloch sphere.\
\>", "Text",
 CellID->1453681403,ExpressionUUID->"2f71b61d-3801-a1b0-550e-2847b9b5f39a"],

Cell["\<\
In order to understand this, we should think about \
\[OpenCurlyDoubleQuote]distance\[CloseCurlyDoubleQuote] in the quantum state:\
\
\>", "Text",
 CellID->2140630416,ExpressionUUID->"3c7c9f19-7bfc-9bea-6403-17437d8ee930"],

Cell["Definition for distance:", "Item",
 CellID->1102871050,ExpressionUUID->"4bcd3c0f-0044-41be-79f2-b669b1f11384"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[GreaterEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250574e2-7568-dee6-533b-6dcc7c02a4cc"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "0", "\[ThinSpace]", "\[DoubleLeftRightArrow]", 
   StyleBox["x", "TI"], "=", 
   StyleBox["y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "570dea5b-028b-2dc3-7d32-0c05b73e7729"]
}], "Item",
 CellID->1983153569,ExpressionUUID->"559114f0-95cd-3728-03ae-8dba1c799a72"],

Cell["\<\
The distance between any two points is always greater than or equal to zero. \
Furthermore, the distance between two points is zero if and only if those two \
points are the same.\
\>", "Item",
 CellID->134903130,ExpressionUUID->"499d2cc9-9173-f7c8-7fa2-c5932007dd12"],

Cell[TextData[{
 "Symmetry: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["D", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["y", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3687b6-15a3-de20-4acd-1ef09c57a50a"]
}], "Item",
 CellID->622869377,ExpressionUUID->"073f26db-34e5-c8c2-2ec4-bf85bc919a28"],

Cell["\<\
The distance between two points is the same regardless of the order in which \
we measure them. That is, the distance from x to y is equal to the distance \
from y to x.\
\>", "Item",
 CellID->1281934360,ExpressionUUID->"27056d96-6b3e-545a-4d3a-84d00ecb3ea0"],

Cell[TextData[{
 "Triangle inequality: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[LessEqual]", 
   StyleBox["D", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["D", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "031df9cf-6b45-d275-3122-f0a90ef1a15f"]
}], "Item",
 CellID->1979223046,ExpressionUUID->"79902eb9-9fc4-d4aa-2faf-c7e31a76bef0"],

Cell["\<\
The distance between two points x and z must be less than or equal to the sum \
of the distances from x to y and from y to z\
\>", "Item",
 CellID->955466983,ExpressionUUID->"6e90dac8-e749-9c1a-16af-d39592fde760"],

Cell["\<\
The first property is key for defining a correct distance function for \
quantum states.\
\>", "Text",
 CellID->1341563544,ExpressionUUID->"2f026f1c-d8c2-1814-5531-8759d9776b7e"],

Cell[TextData[{
 "How to define a distance between quantum states? Since two vectors of \
Hilbert space that differ by a constant actually correspond to the same \
quantum state, one would like to have a definition of distance that should be \
zero between states that differ by a constant, like ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c65fa9b-46f3-ebf0-041a-f3c57287b9da"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583cd303-9cb1-03ae-09c3-cb6d154451f4"],
 " multiplied by a constant lambda."
}], "Text",
 CellID->1440438252,ExpressionUUID->"18f1bad1-a8d9-f26a-488e-339ac96dc0b0"],

Cell["Extra physical condition:", "Item",
 CellID->350424091,ExpressionUUID->"6cd8e50a-7117-62ea-14e7-fd5400a23030"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"], "\[Congruent]", 
  RowBox[{
   StyleBox["\[Lambda]", "TI"], 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]}]], "InlineFormula",
 FontSize->0.9 
  Inherited,ExpressionUUID->"7b9c4f1f-9707-8ca1-29a4-675922b3d68b"]], "Item",
 CellID->173027359,ExpressionUUID->"0839f778-d15e-09ff-39c6-ef25e0eb5bc5"],

Cell["\<\
This means that the distance will be defined in a projective Hilbert space. A \
projective space is obtained from a vector space by identifying vectors that \
differ by a nonzero factor. We need a differential form that does not \
distinguish parallel vectors ( this means that we are looking for a metric in \
projective space, which includes non-normalized states).\
\>", "Text",
 CellID->1543912719,ExpressionUUID->"7962e333-0c57-77b8-2f11-fb7da5e25d82"],

Cell[TextData[{
 "Now let\[CloseCurlyQuote]s consider ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["d", "TI"], 
      StyleBox["\[Psi]", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e58b71a-bb3b-e382-3667-2f443ecfb1e8"],
 " an infinitesimal variation of state ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7517e465-645e-477c-232c-fe4f0deb2a46"],
 " such that:"
}], "Text",
 CellID->752961826,ExpressionUUID->"560e68d9-da1a-2272-7e35-8182dfaf7158"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["d", "TI"], 
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], "\[Perpendicular]"]}]},
    "Ket"], "=", 
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["d", "TI"], 
        StyleBox["\[Psi]", "TI"]}]},
     "Ket"], "-", 
    RowBox[{
     FractionBox[
      RowBox[{
       TemplateBox[{
         StyleBox["\[Psi]", "TI"]},
        "Ket"], 
       TemplateBox[{
         StyleBox["\[Psi]", "TI"]},
        "Bra"]}], 
      TemplateBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["\[Psi]", "TI"]},
       "BraKet"]], 
     TemplateBox[{
       RowBox[{
         StyleBox["d", "TI"], 
         StyleBox["\[Psi]", "TI"]}]},
      "Ket"]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1095921113,ExpressionUUID->"46aa8ea3-37c3-4040-6ea9-270d427612aa"],

Cell["\<\
which defines the component of the differential of psi orthogonal to the \
state psi. This equation becomes easier to understand when you refer to the \
vectors in the image:\
\>", "Text",
 CellID->133271748,ExpressionUUID->"6acb7fb5-f6da-6094-1ac9-76fe836f32fe"],

