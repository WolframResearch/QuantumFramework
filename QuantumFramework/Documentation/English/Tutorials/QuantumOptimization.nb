     "1c40da22-9bf5-6106-447f-d38c1d80306c"], Cell[
    "retrieve the ClassiqVersion installed", "TableText",ExpressionUUID->
     "03b56da4-ec92-94f9-314a-84018524fec3"]}
  }]], "2ColumnTableMod",
 CellID->797329364,ExpressionUUID->"5dcedae6-c63c-0fd1-0bf5-d3c3f3c9553b"],

Cell["Examples", "Text",
 CellID->1412712532,ExpressionUUID->"027aacd9-8b9b-ca0d-3219-45832e2f9957"],

Cell[BoxData[
 RowBox[{"ClassiqSetup", "[", "\"\<ClassiqVersion\>\"", "]"}]], "Input",
 CellID->2073133186,ExpressionUUID->"018fad51-cc5f-c6f3-37b4-451ae5ebacd9"],

Cell[BoxData[
 RowBox[{"ClassiqSetup", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<Session\>\"", ",", " ", "\"\<Evaluators\>\""}], "}"}], 
  "]"}]], "Input",
 CellID->1837523960,ExpressionUUID->"792601a7-7c2e-1618-28dd-980175db7d62"],

Cell["\<\
You can also retrieve all available properties by using All as the argument.\
\>", "Text",
 CellID->980947500,ExpressionUUID->"422fa001-3abb-a233-73d4-3a6bbf4ff119"],

Cell[BoxData[
 RowBox[{"ClassiqSetup", "[", "All", "]"}]], "Input",
 CellID->830183667,ExpressionUUID->"5d968898-757e-5b71-0bad-21c27c0b265b"],

Cell["Session", "Text",
 CellID->1838912726,ExpressionUUID->"5c787eaa-3916-aaa9-0418-77f4b8a0f8f3"],

Cell["\<\
The Session object can be especially useful when integrating information from \
Python into Mathematica, as it provides a persistent context for data \
exchange and function evaluation:\
\>", "Text",
 CellID->1868106433,ExpressionUUID->"321c9a0a-53e4-3b3a-6223-1c5465968600"],

Cell[BoxData[
 RowBox[{"session", " ", "=", " ", 
  RowBox[{"classiq", "[", "\"\<Session\>\"", "]"}]}]], "Input",
 CellLabel->"In[483]:= ",
 CellID->1941903976,ExpressionUUID->"4556754e-32f3-38f6-736e-6d2846878adc"],

Cell["python_variable = 1 + 1", "Program",
 CellID->1471041264,ExpressionUUID->"21d5e407-72d6-097c-57ea-fe6107635846"],

Cell[BoxData[
 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{"session", ",", " ", "\"\<python_variable\>\""}], "]"}]], "Input",
 CellLabel->"In[484]:= ",
 CellID->1861479581,ExpressionUUID->"3df2759c-2159-6077-6b82-6cc650ec335d"],

Cell[TextData[{
 "You can also define functions in Python and call them from within \
Mathematica. For more information, click ",
 ButtonBox["here",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/guide/\
ExternalLanguageInterfaces.html"], None}],
 "."
}], "Text",
 CellID->1052234605,ExpressionUUID->"1353847d-73f3-4ff8-4160-1e27058615c2"],

Cell["Options", "Subsubsection",
 CellID->799116041,ExpressionUUID->"023adce6-f477-0954-33d9-d5c3fd025bbe"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "76eb59fc-b473-b7c5-1ee9-50a63d071d2f"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"7dd80473-c718-e3dd-2be7-9e3cf292b127"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"0073a097-0f1d-653d-3000-39d1aaa84c07"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "265272e3-db49-f23d-4e62-6bccdefdc107"], Cell[TextData[Cell[
    BoxData["\"\<CheckDependencies\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4172bb43-7495-39b2-7701-332d7d218b98"]], "TableText",ExpressionUUID->
     "230bdc3d-d065-76ac-5108-d666e1105cf6"], Cell["\<\
option to verify if an specific library is already installed. Often used to \
check dependencies from Classiq but you can use it to check any other package \
installed in your python session\
\>", "TableText",ExpressionUUID->"7083369b-c5f9-1da2-20b0-afc4f38c6788"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "600ff364-211e-db59-1034-eb4e50a8a9a3"], Cell[TextData[Cell[
    BoxData["\"\<InstallPackages\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "540b5a94-14ca-6d57-7c09-53de9d7f37bd"]], "TableText",ExpressionUUID->
     "0db8d008-2b7e-6047-3b47-ca524e0b32ad"], Cell["\<\
option to install an specific library by indicating the library name\
\>", "TableText",ExpressionUUID->"1b5f3c3c-a0bd-b40a-4964-b679d1491f50"]}
  }]], "2ColumnTableMod",
 CellID->103856769,ExpressionUUID->"50e3ced9-efa3-8fb9-0090-e7828a57d583"],

Cell["CheckDependencies", "Text",
 CellID->906074434,ExpressionUUID->"51e2478e-a4b0-4c7f-0792-5eebcd451745"],

Cell["\<\
When installing Classiq, you can verify if any dependencies are missing by \
indicating their name:\
\>", "Text",
 CellID->1986355024,ExpressionUUID->"7464e148-f188-b1ce-1c1b-f91580220314"],

Cell[BoxData[
 RowBox[{"ClassiqSetup", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<Session\>\"", ",", " ", "\"\<ClassiqVersion\>\""}], "}"}], ",",
    " ", "\n", " ", 
   RowBox[{"\"\<CheckDependencies\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<pyomo\>\"", ",", " ", "\"\<networkx\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellID->2073466009,ExpressionUUID->"3f8db726-7604-9df5-65b2-2e8003b6e7df"],

Cell["InstallPackages", "Text",
 CellID->306546030,ExpressionUUID->"22a876b6-5c8c-915d-52a8-6ff0553ee3a7"],

Cell["\<\
In case there is a library missing, you can install it by indicating their \
name:\
\>", "Text",
 CellID->2028102480,ExpressionUUID->"38f0db08-93d0-aa19-688f-d352266af963"],

Cell[BoxData[
 RowBox[{"ClassiqSetup", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<Session\>\"", ",", " ", "\"\<ClassiqVersion\>\""}], "}"}], ",",
    " ", "\n", " ", 
   RowBox[{"\"\<CheckDependencies\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<pyomo\>\"", ",", " ", "\"\<plotly\>\"", ",", 
      " ", "\"\<simpy\>\""}], "}"}]}], ",", " ", "\n", " ", 
   RowBox[{"\"\<InstallPackages\>\"", " ", "->", " ", 
    RowBox[{"{", "\"\<simpy\>\"", "}"}]}]}], "]"}]], "Input",
 CellID->115251350,ExpressionUUID->"76285bca-be73-b625-1e28-52943b071d0f"],

