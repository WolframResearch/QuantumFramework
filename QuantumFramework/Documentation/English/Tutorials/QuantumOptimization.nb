     "6368bf1a-89ab-f709-1117-3744285fda53"], Cell[TextData[Cell[BoxData[
    "50"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "18aa8291-c565-6e81-48a9-1bdaec1034eb"]], "TableText",ExpressionUUID->
     "0fb37437-3ad9-e813-3541-6e71bf6dbb79"], Cell[
