Cell["As the previous example, we implement the Hadamard test:", "Text",
 CellID->568059892,ExpressionUUID->"3a680f33-ae9a-dfdd-6a17-a77ccb2ca527"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "LocalHadamardCircuit", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"LocalHadamardCircuit", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<Hadamard\>\"", " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<P\>\"", "[", "\[Theta]", "]"}], ",", "\n", "    ", 
       RowBox[{"VariationalBlock", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], ",", "\n", 
       "    ", "ControlledGateA", ",", "\n", "    ", "Ub", ",", "\n", "    ", 
       "ControlledGateZ", ",", "\n", "    ", "Ub", ",", "\n", "    ", 
       RowBox[{"ControlledGateA", "[", 
        RowBox[{"<|", 
         RowBox[{"l", " ", "->", " ", "lp"}], "|>"}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"\"\<Hadamard\>\"", " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}]}], "\n", "    ", "}"}], ",", " ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\[Omega]3", ",", " ", 
        "\[Omega]4", ",", " ", 
        RowBox[{"\\\n", "\[Omega]5"}], ",", " ", "\[Omega]6", ",", " ", 
        "\[Omega]7", ",", " ", "\[Omega]8", ",", " ", "\[Omega]9", ",", " ", 
        "l", ",", " ", "lp", ",", " ", "\n", "     ", "j", ",", " ", 
        "\[Theta]"}], "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[362]:= ",
 CellID->1821847886,ExpressionUUID->"3043dcf6-9c3e-c649-6070-d5b015c8ac93"],

Cell[BoxData[
 RowBox[{"LocalHadamardCircuit", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]], "Input",
 CellLabel->"In[363]:= ",
 CellID->82728126,ExpressionUUID->"32a697fb-66fd-3c96-625d-0ea5128986fc"],

Cell["Local Cost Function", "Text",
 CellID->1330197580,ExpressionUUID->"6e733b29-d0f2-c400-1600-b372e084af6a"],

