Cell["\<\
We will briefly demonstrate how to apply all these functions in Wolfram \
quantum framework.\
\>", "Text",
 CellID->1226129208,ExpressionUUID->"79999c45-ea42-0b46-2fa6-162e8ff759ac"],

Cell[TextData[{
 "QuantumNaturalGradientDescent function follows the fundamental process of \
the Variational Quantum Eigensolver (VQE) which involves using a brief \
quantum circuit U(\[Theta]), characterized by parameters ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Theta]", "TI"], "=", "{", 
    SubscriptBox[
     StyleBox["\[Theta]", "TI"], "1"]}], ",", 
   RowBox[{"\[Ellipsis]", 
    SubscriptBox[
     StyleBox["\[Theta]", "TI"], 
     StyleBox["m", "TI"]], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fae9c0a-8a55-fd6e-0555-16542fe1c7b4"],
 " to iteratively adjust \[Theta] to minimize the average energy or cost \
function: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Theta]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["\[Phi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["\[Theta]", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Bra"], 
    StyleBox["H", "TI"], 
    TemplateBox[{
      RowBox[{
        StyleBox["\[Phi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["\[Theta]", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ae1fb24-4e58-6c4d-4a9e-f28e6bed3697"],
 " for the ansatz ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Phi]", "TI"], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["\[Theta]", "TI"], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Ket"], "=", 
   RowBox[{
    StyleBox["U", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Theta]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{"0"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a4afb14-05e6-4298-3a49-f35eb39310e2"],
 "."
}], "Text",
 CellID->2131141040,ExpressionUUID->"1a681de3-120d-8f0a-4a17-94cda7b9d250"],

Cell["Example", "Subsubsection",
 CellID->1842490185,ExpressionUUID->"7fe8910c-2477-6bad-2597-09564d0239f7"],

Cell["Implement a simple single qubit state:", "Text",
 CellID->1136406834,ExpressionUUID->"4724aa69-80a2-605c-6edb-4c33315732a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"state", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", "\[Theta]1", "]"}], ",", " ", "\n", "    ", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"2", "*", "I", "*", "\[Theta]2"}], "]"}], "*", 
        RowBox[{"Sin", "[", "\[Theta]1", "]"}]}]}], "}"}], ",", " ", "\n", 
     "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[Theta]1", ",", " ", "\[Theta]2"}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[232]:= ",
 CellID->732582821,ExpressionUUID->"7db6e0a3-5ee4-0113-2b4d-f90d5a915079"],

Cell[BoxData[
 RowBox[{"state", "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[233]:= ",
 CellID->1874608125,ExpressionUUID->"64959d98-6722-362c-0caa-14c212d49d76"],

Cell["Calculate the Fubiny-Study metric tensor:", "Text",
 CellID->510277130,ExpressionUUID->"5f8c04ec-8c47-4bdf-05b3-9db625f21925"],

Cell[BoxData[
 RowBox[{"metric", " ", "=", " ", 
  RowBox[{"FubiniStudyMetricTensor", "[", "state", "]"}]}]], "Input",
 CellLabel->"In[234]:= ",
 CellID->121793118,ExpressionUUID->"023e8ab0-46e5-584b-33c5-23fa72902a91"],

Cell[BoxData[
 RowBox[{"FubiniStudyMetricTensor", "[", 
  RowBox[{"state", ",", " ", "\"\<Matrix\>\""}], "]"}]], "Input",
 CellLabel->"In[235]:= ",
 CellID->1768969755,ExpressionUUID->"5a0eac86-50d0-15df-0a35-45e061657f25"],

Cell[TextData[{
 "Calculate a ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["\[Phi]", "TI"], 
      StyleBox["(", SpanMaxSize -> 1], 
      StyleBox["\[Theta]", "TI"], 
      StyleBox[")", SpanMaxSize -> 1]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58394c25-48c8-3ecd-09c7-658f69628417"],
 " state vector:"
}], "Text",
 CellID->882192241,ExpressionUUID->"1424a2b0-695c-dfcb-3ddb-3bfa08eea511"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ket", "[", 
     RowBox[{"{", "\[Phi]", "}"}], "]"}], " ", "=", " ", 
    RowBox[{"state", "[", "\"\<StateVector\>\"", "]"}]}], ";"}], 
  " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Bra", "[", 
    RowBox[{"{", "\[Phi]", "}"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"SuperDagger", "[", "state", "]"}], "[", "\"\<StateVector\>\"", 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[236]:= ",
 CellID->781875236,ExpressionUUID->"05101942-3b9c-ad10-332f-912cbe2ef47a"],

Cell["Implement a cost function \[LeftAngleBracket]\[Phi](\[Theta])|H \
|\[Phi](\[Theta])\[RightAngleBracket] :", "Text",
 CellID->924770633,ExpressionUUID->"35394d45-77a0-03f4-5cc7-652f025551de"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cost", "[", 
    RowBox[{"\[Theta]1_", ",", " ", "\[Theta]2_"}], "]"}], " ", "=", " ", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"Bra", "[", 
     RowBox[{"{", "\[Phi]", "}"}], "]"}], " ", ".", " ", 
    RowBox[{"PauliMatrix", "[", "1", "]"}], " ", ".", " ", 
    RowBox[{"Ket", "[", 
     RowBox[{"{", "\[Phi]", "}"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[237]:= ",
 CellID->312372480,ExpressionUUID->"3f9454e1-244e-40e6-65ac-4dcb4dfb12cc"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", "\n", " ", 
  RowBox[{
   RowBox[{"cost", "[", 
    RowBox[{"\[Theta]1", ",", " ", "\[Theta]2"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Theta]1", ",", " ", "\[Theta]2"}], "}"}], " ", "\[Element]", 
    " ", "Reals"}]}], "]"}]], "Input",
 CellLabel->"In[238]:= ",
 CellID->1884905321,ExpressionUUID->"530b93a6-4244-79d7-0108-0a0077f14b3d"],

Cell[TextData[{
 "Use ",
 StyleBox["QuantumNaturalGradientDescent",
  FontWeight->"Bold"],
 " to minimize the function:"
}], "Text",
 CellID->548998949,ExpressionUUID->"4c785ed8-c9e5-405c-7418-5785ef9012a6"],

