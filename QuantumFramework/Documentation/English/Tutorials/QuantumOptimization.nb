     RowBox[{"\"\<Quantum Natural Gradient Descent\>\"", ",", " ", "\n", 
      "   ", "\"\<Gradient Descent\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Optimization steps\>\"", ",", 
      " ", "\"\<Cost Function Value\>\""}], "}"}]}], ",", " ", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}]}], "]"}]], "Input",
 CellLabel->"In[274]:= ",
 CellID->1783586468,ExpressionUUID->"23998a05-7963-184f-51a6-2c6f78166a95"],

Cell["Quantum Linear Solvers", "Section",
 CellID->1526502960,ExpressionUUID->"422628af-426c-374e-73dd-c109771e9d94"],

Cell["Harrow\[Dash]Hassidim\[Dash]Lloyd algorithm (HHL)", "Subsection",
 CellID->1285674194,ExpressionUUID->"26e7e4d8-634d-0d10-4e9c-fd8216f8547a"],

Cell[TextData[{
 "The main goal of HHL algorithm is too solve a linear system ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"A", ".", "x"}], "=", "b"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "027e254c-1480-02c1-3205-bd169d35502b"],
 " by preparing a quantum state of the solution: HHL outputs ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["x", "TI"], "\[Proportional]", 
    SuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{"-", "1"}]]}], ".", 
   StyleBox["b", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6456a901-44b8-c553-0c6d-416b6d32afb9"],
 ", enabling estimation of properties of ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5de3bc1f-ff0d-b0a4-0b90-3658fab9028e"],
 " with (under sparsity, good conditioning, and oracle access) runtime \
polylogarithmic in the dimension."
}], "Text",
 CellID->805612777,ExpressionUUID->"05b0da98-ac84-313a-334f-d3c5c5368000"],

Cell["Theory", "Subsubsection",
 CellID->680527979,ExpressionUUID->"1895dfb3-965d-1c83-48aa-d6fd23e866e9"],

Cell["\<\
The Harrow\[Dash]Hassidim\[Dash]Lloyd (HHL) algorithm is a quantum procedure \
designed to solve systems of linear equations of the form:\
\>", "Text",
 CellID->734792945,ExpressionUUID->"2deed3b4-be8d-db40-5b95-cafe3b39a9aa"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  StyleBox["A", "TI"], 
  OverscriptBox[
   StyleBox["x", "TI"], "\[RightVector]"], "=", 
  OverscriptBox[
   StyleBox["b", "TI"], "\[RightVector]"]}]], "InlineFormula",
 FontSize->0.9 
  Inherited,ExpressionUUID->"78e6b17c-c991-15ef-289d-2939e8247f35"]], "Text",
 CellID->1006104233,ExpressionUUID->"24acbe62-bdf4-ffe2-4c53-304c3b86c5c8"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38f0085c-4734-4722-688f-a20672c12a08"],
 " is a Hermitian matrix and ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b9216eb-8f9f-eb69-19a1-8fb52a2bb9b3"],
 " is a known vector. The importance of HHL lies in its potential to provide \
exponential speedup over classical algorithms under certain conditions, and \
in the fact that it serves as a foundation for several advanced algorithms in \
areas such as machine learning, optimization, and quantum simulation."
}], "Text",
 CellID->1603194520,ExpressionUUID->"59f120da-5631-2eb2-0f8e-b98463c47498"],

Cell["\<\
The quantum circuit implementing HHL (as shown in the schematic) is organized \
into five main sections:\
\>", "Text",
 CellID->78326750,ExpressionUUID->"5fa7ad17-3a9c-8e6e-055c-4551bf2ed4b4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pe", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<RandomUnitary\>\"", ",", " ", "\n", "      ", 
          
          RowBox[{"\"\<Label\>\"", " ", "->", " ", "\n", 
           "       ", "\"\<\!\(\*SuperscriptBox[\(H\), \
\(\[TensorProduct]\(n\)\)]\)\>\""}]}], "]"}], " ", "->", " ", 
        RowBox[{"\\\n", 
         RowBox[{"{", "2", "}"}]}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"\"\<C\>\"", "[", 
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<RandomUnitary\>\"", ",", " ", "\n", "       ", 
           
           RowBox[{"\"\<Label\>\"", " ", "->", " ", "\n", 
            "        ", "\"\<\!\(\*SuperscriptBox[\(\[ExponentialE]\), \(\
\[ImaginaryI]*A*t\)]\)\>\""}]}], "]"}], "]"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<RandomUnitary\>\"", ",", " ", 
          RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<IQFT\>\""}]}], "]"}], 
        " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}]}], "\n", "    ", "}"}], ",", " ", 
     RowBox[{"\"\<Label\>\"", " ", "->", 
      " ", "\"\<Quantum Phase Estimation (QPE)\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ipe", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<RandomUnitary\>\"", ",", " ", 
          RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<QFT\>\""}]}], "]"}], 
        " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"\"\<C\>\"", "[", 
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<RandomUnitary\>\"", ",", " ", "\n", "       ", 
           
           RowBox[{"\"\<Label\>\"", " ", "->", " ", "\n", 
            "        ", "\"\<\!\(\*SuperscriptBox[\(\[ExponentialE]\), \(\(-\
\[ImaginaryI]\)*A*t\)]\)\>\""}]}], "]"}], "]"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<RandomUnitary\>\"", ",", " ", "\n", "      ", 
          
          RowBox[{"\"\<Label\>\"", " ", "->", " ", "\n", 
           "       ", "\"\<\!\(\*SuperscriptBox[\(H\), \
\(\[TensorProduct]\(n\)\)]\)\>\""}]}], "]"}], " ", "->", " ", 
        RowBox[{"\\\n", 
         RowBox[{"{", "2", "}"}]}]}]}], "\n", "    ", "}"}], ",", " ", 
     RowBox[{"\"\<Label\>\"", " ", "->", 
      " ", "\"\<Inverse Quantum Phase Estimation (IQPE)\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"im", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"\"\<I\>\"", " ", "->", " ", 
       RowBox[{"Range", "[", "2", "]"}]}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumState", "[", 
        RowBox[{"\"\<RandomPure\>\"", ",", " ", "\n", "      ", 
         RowBox[{"\"\<Label\>\"", " ", "->", " ", "\n", 
          "       ", "\"\<\!\(\*OverscriptBox[\(b\), \
\(\[RightVector]\)]\)\>\""}]}], "]"}], " ", "->", " ", 
       RowBox[{"{", "3", "}"}]}], ",", "\n", "    ", "pe", ",", "\n", "    ", 
      
      RowBox[{
       RowBox[{"\"\<C\>\"", "[", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<RY\>\"", "[", "\[Theta]", "]"}], "]"}], "]"}], " ", "->",
        " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1"}], "}"}]}], ",", "\n", "    ", 
      RowBox[{"{", "1", "}"}], ",", "\n", "    ", 
      RowBox[{"\"\<I\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", "\n", "    ", "ipe"}], 
     "\n", "    ", "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"im", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Full"}], ",", "\n", " ", 
   RowBox[{"\"\<WireLabels\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<1\nLSB\!\(\*SubscriptBox[TemplateBox[{\\\"0\\\"},\n\
\\\"Ket\\\"], \(a\)]\)\>\"", ",", " ", "\n", 
      "   ", "\"\<c-register\n\!\(\*SuperscriptBox[TemplateBox[{\\\"0\\\"},\n\
\\\"Ket\\\"], \(\[TensorProduct]\(n\)\)]\)\>\"", ",", " ", "\n", 
      "   ", "\"\<b-register\n\!\(\*TemplateBox[{\nRowBox[{\n\
SubscriptBox[\\\"b\\\", \nRowBox[{\\\"0\\\", \\\"\[Ellipsis]\\\"}]], \n\
SubscriptBox[\\\"b\\\", \nSubscriptBox[\\\"n\\\", \\\"b\\\"]]}]},\n\
\\\"Ket\\\"]\)\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"\"\<GateBackgroundStyle\>\"", " ", "->", " ", 
    RowBox[{"{", "\n", "   \t", 
     RowBox[{
      RowBox[{"\"\<State\n Preparation\>\"", " ", "->", " ", "LightOrange"}], 
      ",", "\n", "   \t", 
      RowBox[{
       RowBox[{"\"\<\!\(\*SuperscriptBox[\(H\), \
\(\[TensorProduct]\(n\)\)]\)\>\"", " ", "|", " ", "\n", 
        "     ", "\"\<\!\(\*SuperscriptBox[\(\[ExponentialE]\), \(\
\[ImaginaryI]*A*t\)]\)\>\"", " ", "|", " ", "\n", 
        "     ", "\"\<\!\(\*SuperscriptBox[\(\[ExponentialE]\), \(\(-\
\[ImaginaryI]\)*A*t\)]\)\>\"", " ", "|", " ", "\"\<IQFT\>\"", " ", "|", 
        " ", "\"\<QFT\>\""}], " ", "->", " ", "\n", "    ", 
       RowBox[{"Lighter", "@", 
        RowBox[{"Hue", "[", 
         RowBox[{"0.33", ",", " ", "0.3", ",", " ", "0.79"}], "]"}]}]}]}], 
     "\n", "   \t", "}"}]}], ",", "\n", " ", 
   RowBox[{"\"\<GateBoundaryStyle\>\"", " ", "->", " ", 
    RowBox[{"{", "\n", "   \t", 
     RowBox[{
      RowBox[{"\"\<State\n Preparation\>\"", " ", "->", " ", "Orange"}], ",", 
      "\n", "   \t", 
      RowBox[{
       RowBox[{"\"\<\!\(\*SuperscriptBox[\(H\), \
\(\[TensorProduct]\(n\)\)]\)\>\"", " ", "|", " ", "\n", 
        "     ", "\"\<\!\(\*SuperscriptBox[\(\[ExponentialE]\), \(\
\[ImaginaryI]*A*t\)]\)\>\"", " ", "|", " ", "\n", 
        "     ", "\"\<\!\(\*SuperscriptBox[\(\[ExponentialE]\), \(\(-\
\[ImaginaryI]\)*A*t\)]\)\>\"", " ", "|", " ", "\"\<IQFT\>\"", " ", "|", 
        " ", "\"\<QFT\>\""}], " ", "->", " ", "\n", "    ", 
       RowBox[{"Darker", "@", 
        RowBox[{"Hue", "[", 
         RowBox[{"0.33", ",", " ", "0.3", ",", " ", "0.79"}], "]"}]}]}]}], 
     "\n", "   \t", "}"}]}]}], "\n", " ", "]"}]}], "Input",
 CellLabel->"In[275]:= ",
 CellID->645942642,ExpressionUUID->"2c844eb4-1a55-00c1-54bc-67fe9fe0522b"],

Cell[TextData[{
 StyleBox["State ",
  FontWeight->"Bold"],
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cf619f4-16c8-91d6-148d-90bea362e33c"],
 StyleBox[" preparation",
  FontWeight->"Bold"]
}], "Item",
 CellID->921008706,ExpressionUUID->"66b1d308-016b-0c10-0e4e-cb52b01e577a"],

Cell[TextData[{
 "The vector ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0764fd02-d65e-847f-2d1b-f56fe3e8ef45"],
 " is encoded into the amplitudes of a register of qubits (the b-register). \
This step translates the classical problem into a quantum state ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["b", "TI"]},
    "Ket"], "."}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c98820f-8b6f-75b8-34a7-24692e1a5f82"]
}], "Item",
 CellID->1653007637,ExpressionUUID->"6abb7d62-34cd-b03b-1a59-754cbd790301"],

Cell[TextData[StyleBox["Quantum Phase Estimation (QPE)",
 FontWeight->"Bold"]], "Item",
 CellID->361218406,ExpressionUUID->"2d7b53f1-7ae1-3c16-5b19-4abb7e95877c"],

Cell[TextData[{
 "QPE is applied to decompose ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["b", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "342ac02e-94b9-9375-5c29-d9881d4dfe5f"],
 " in the eigenbasis of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "."}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e47f25d-3ed8-a4c4-267c-f407bb520e2e"],
 " The eigenvalues ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "420d2e93-75d1-66df-7232-c7dd7c644c25"],
 " of ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0eb3603b-0e30-9ef6-3641-7a65abcae4dc"],
 " are encoded into an auxiliary register of clock qubits (the c-register)."
}], "Item",
 CellID->657823953,ExpressionUUID->"0da293aa-5e01-ac71-3b51-0af45bb5f75b"],

Cell[TextData[StyleBox["Controlled Rotation & Measurement of the ancilla \
qubit",
 FontWeight->"Bold"]], "Item",
 CellID->1586586178,ExpressionUUID->"32c08ae5-f3ed-cbfa-62ff-23ce859999c0"],

Cell[TextData[{
 "An auxiliary qubit (the ancilla, Least Significant Bit - ",
 StyleBox["LSB",
  FontWeight->"Bold"],
 ") is rotated in a way that depends on the eigenvalues stored in the \
c-register. This step effectively implements the action of ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["A", "TI"], 
   RowBox[{"-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cfb14f9-38ed-478b-4498-8da3b8982dd1"],
 ", since the amplitudes are scaled by ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["i", "TI"]], "\[ThinSpace]", "."}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "683f5ed1-9434-8a9e-19c5-579b1dc6d8e4"],
 " Measure the ancilla and keep only outcomes ",
 Cell[BoxData[
  SubscriptBox[
   TemplateBox[{"1"},
    "Ket"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07cd5cb3-9399-0155-2df3-55fd262c53bf"],
 "."
}], "Item",
 CellID->359369745,ExpressionUUID->"4f9e6b1d-931e-a284-75a5-834726a8f0ee"],

Cell[TextData[StyleBox["Inverse Quantum Phase Estimation (IQPE)",
 FontWeight->"Bold"]], "Item",
 CellID->1865770764,ExpressionUUID->"7129e602-6ec3-689c-20d6-f86c0b763ae6"],

Cell["\<\
The inverse QPE is applied to disentangle the c-register from the b-register, \
ensuring that the solution is properly isolated in the latter.\
\>", "Item",
 CellID->1025921643,ExpressionUUID->"24548d70-e349-6090-4c6b-253d96fc32fa"],

Cell[TextData[StyleBox["Measurement",
 FontWeight->"Bold"]], "Item",
 CellID->1330795313,ExpressionUUID->"24053d10-b77f-7f73-4c3a-b55dc20a4259"],

Cell[TextData[{
 "After post-selecting the ancilla in the desired state, the quantum system \
in the b-register encodes the solution ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["x", "TI"]},
    "Ket"], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], 
     RowBox[{"-", "1"}]], 
    RowBox[{
     TemplateBox[{
       StyleBox["b", "TI"]},
      "Ket"], "."}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16592835-d9b8-94b1-3e66-c27ed832fe9b"],
 " While the algorithm does not yield the classical solution vector directly, \
it enables the estimation of global properties of the solution, such as \
norms, probability distributions, or expectation values of observables."
}], "Item",
 CellID->178269570,ExpressionUUID->"141ca810-4c49-bb60-3c23-425a65fd064a"],

Cell["\<\
This way, HHL combines three central tools of quantum computing:\
\>", "Text",
 CellID->1802014013,ExpressionUUID->"68e9730c-176f-ed31-1897-6b56a21bb41b"],

Cell["superposition", "Item",
 CellID->1937242430,ExpressionUUID->"045a1c11-48b2-feff-2c79-965b6944c4c5"],

Cell["phase estimation", "Item",
 CellID->706157633,ExpressionUUID->"5000470d-6ead-2730-0030-5f570b598a1a"],

Cell["controlled operations", "Item",
 CellID->1315949921,ExpressionUUID->"5b36215d-7c1e-6467-0acd-b90775ab4f4d"],

Cell["\<\
And turn it into a coherent algorithm that addresses a fundamental problem in \
science and engineering.\
\>", "Text",
 CellID->226158774,ExpressionUUID->"648fe92d-3764-e6d2-0cb4-01774216cc38"],

Cell["Encoding Scheme", "Subsubsection",
 CellID->1284421836,ExpressionUUID->"51ab5adf-11d7-a41b-07a9-5399a0630f61"],

Cell["\<\
We implement the HHL algorithm for the following system of linear equations:\
\>", "Text",
 CellID->1497841191,ExpressionUUID->"6ea1ee02-7e80-589f-165e-006c7b352ae5"],

Cell[TextData[Cell[BoxData[
 RowBox[{"{", GridBox[{
    {GridBox[{
       {
        RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "1"], "-", 
         FractionBox["1", "3"], 
         SubscriptBox[
          StyleBox["x", "TI"], "2"], "=", "0"}]},
       {
        RowBox[{"-", 
         FractionBox["1", "3"], 
         SubscriptBox[
          StyleBox["x", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["x", "TI"], "2"], "=", "1"}]}
      }], 
     RowBox[{
      RowBox[{
       StyleBox["o", "TI"], 
       StyleBox["r", "TI"], "\[ThinSpace]", 
       StyleBox["e", "TI"], 
       StyleBox["q", "TI"], 
       StyleBox["u", "TI"], 
       StyleBox["i", "TI"], 
       StyleBox["v", "TI"], 
       StyleBox["a", "TI"], 
       StyleBox["l", "TI"], 
       StyleBox["e", "TI"], 
       StyleBox["n", "TI"], 
       StyleBox["t", "TI"], 
       StyleBox["l", "TI"], 
       StyleBox["y", "TI"], "\[ThinSpace]", 
       RowBox[{"(", GridBox[{
          {"1", 
           RowBox[{"-", "1", "/", "3"}]},
          {
           RowBox[{"-", "1", "/", "3"}], "1"}
         }], ")"}], 
       RowBox[{"(", GridBox[{
          {
           SubscriptBox[
            StyleBox["x", "TI"], "1"]},
          {
           SubscriptBox[
            StyleBox["x", "TI"], "2"]}
         }], ")"}]}], "=", 
      RowBox[{"(", GridBox[{
         {"0"},
         {"1"}
        }], ")"}], "\[ThinSpace]"}]}
   },
   GridBoxAlignment->{
    "Columns" -> {{Left}}, "Rows" -> {{Baseline}}}]}]], "InlineFormula",
 FontSize->0.9 
  Inherited,ExpressionUUID->"481e4aee-9cf5-9d73-7826-63c81481e459"]], "Text",
 CellID->1649149558,ExpressionUUID->"3565e36d-8dcc-1be9-631a-fb3724796933"],

Cell["with", "Text",
 CellID->217548495,ExpressionUUID->"235d73f5-0285-a3fd-5163-6abfb731f1c7"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  RowBox[{
   StyleBox["A", "TI"], "=", 
   RowBox[{"(", GridBox[{
      {"1", 
       RowBox[{"-", "1", "/", "3"}]},
      {
       RowBox[{"-", "1", "/", "3"}], "1"}
     }], ")"}]}], "\[ThinSpace]", ",", "\[ThinSpace]", 
  RowBox[{
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"], "=", 
   RowBox[{"(", GridBox[{
      {"0"},
      {"1"}
     }], ")"}]}]}]], "InlineFormula",
 FontSize->0.9 
  Inherited,ExpressionUUID->"2a726cbd-ee36-06ea-5a01-85e68bc36c30"]], "Text",
 CellID->1489068421,ExpressionUUID->"545cfe61-129d-c9b2-7c63-f04ba7299b98"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "3"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", "3"}], ",", " ", "1"}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"b", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1"}], "}"}]}], ";"}]}], "Input",
 CellLabel->"In[276]:= ",
 CellID->520216713,ExpressionUUID->"2a738979-6fd1-4d91-5a00-21230a6417fb"],

Cell["The eigenvalues and eigenvectors of \|01d434 are:", "Text",
 CellID->913351179,ExpressionUUID->"1cda659f-caad-1800-44fa-7cd8ef586b6a"],

Cell[BoxData[
 RowBox[{"Eigensystem", "[", "A", "]"}]], "Input",
 CellLabel->"In[277]:= ",
 CellID->720016585,ExpressionUUID->"6bd8f04d-1eeb-cc47-19e7-ea179a9f96ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"\[Lambda]1", ",", " ", "\[Lambda]0"}], "}"}], " ", "=", " ", 
  RowBox[{"Eigenvalues", "[", "A", "]"}]}]], "Input",
 CellLabel->"In[278]:= ",
 CellID->2075983445,ExpressionUUID->"4131a38c-3cb1-61e0-70ce-3ad6b54433ca"],

Cell["\<\
To encode the eigenvalues in the clock register, we use basis encoding. Two \
qubits are sufficient to represent the eigenvalues while maintaining their \
ratio:\
\>", "Text",
 CellID->1725083935,ExpressionUUID->"66dd1d78-a26e-793a-0ee2-9525d71b4800"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Lambda]", "TI"], "\[NonBreakingSpace]"], "0"], "=", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "497210fc-93c1-a1bc-7f01-89a62675f386"],
 " encoded as ",
 Cell[BoxData[
  TemplateBox[{"01"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d97aad1-2ffc-78e2-5bac-439b49894ac8"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Lambda]", "TI"], "\[NonBreakingSpace]"], "1"], "=", "2"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45812a49-00f9-159c-73be-cc13b08c7fe6"],
 " encoded as ",
 Cell[BoxData[
  TemplateBox[{"10"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e72335e-d71b-483f-5601-ab1be2ae1b05"]
}], "Text",
 CellID->217986995,ExpressionUUID->"00379a47-1bf1-fdbf-31cc-1c219d85c785"],

Cell[TextData[{
 "This preserves the ratio ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "0"], "/", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "1"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19c466c6-94fb-625d-4ffc-7fa01c8e30a7"],
 ":"
}], "Text",
 CellID->878195850,ExpressionUUID->"20cc8908-a147-10ca-50f3-2155d0f26210"],

Cell[BoxData[
 RowBox[{"n", " ", "=", " ", 
  RowBox[{"Divide", " ", "@@", " ", 
   RowBox[{"Eigenvalues", "[", "A", "]"}]}]}]], "Input",
 CellLabel->"In[279]:= ",
 CellID->1802115315,ExpressionUUID->"13bcd130-62a3-8c70-4143-c97a1757d75a"],

Cell[TextData[{
 "This gives a perfect encoding with ",
 Cell[BoxData[
  RowBox[{"\|01d45b", "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6565394a-c196-6bdd-131a-b117f0233927"],
 " (i.e., ",
 Cell[BoxData[
  RowBox[{"\|01d441", "=", 
   SuperscriptBox["2", 
    StyleBox["n", "TI"]], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "654f987a-f98e-d016-1374-1227f838a37c"],
 "). The evolution time \|01d461 is chosen to satisfy:"
}], "Text",
 CellID->1645045368,ExpressionUUID->"631c7298-8e73-d34d-1124-6bc22b07a197"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Lambda]", "TI"], "\[NonBreakingSpace]"], 
   StyleBox["j", "TI"]], "=", 
  StyleBox["N", "TI"], 
  SubscriptBox[
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["j", "TI"]], 
  StyleBox["t", "TI"], "/", "2", "\[Pi]"}]], "InlineFormula",
 FontSize->0.9 
  Inherited,ExpressionUUID->"2e9b4f74-ee28-5e2b-56b9-67318bdd2571"]], "Text",
 CellID->1727156915,ExpressionUUID->"7ff84a3f-8ea3-8415-2598-6c792b57ef7f"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"1", " ", "==", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "^", "n"}], "*", "\[Lambda]0", "*", "t"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "\[Pi]"}], ")"}]}]}], ",", " ", 
   RowBox[{"{", "t", "}"}]}], "]"}]], "Input",
 CellLabel->"In[280]:= ",
 CellID->2122539543,ExpressionUUID->"4d7fc3a7-f4ac-747e-7b04-da00fd595f44"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"2", " ", "==", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "^", "n"}], "*", "\[Lambda]1", "*", "t"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "\[Pi]"}], ")"}]}]}], ",", " ", 
   RowBox[{"{", "t", "}"}]}], "]"}]], "Input",
 CellLabel->"In[281]:= ",
 CellID->1635916478,ExpressionUUID->"6b0a0ef4-2602-73b0-1909-a7be53b7419a"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7324c1ff-ae1d-8266-22db-d8b8cba9d14c"],
 " is a 2-dimensional vector, it can be encoded using one qubit, so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["b", "TI"]], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a19e89c-6899-3c78-3a26-01c6092d8742"]
}], "Text",
 CellID->1330640924,ExpressionUUID->"39663cc9-297d-9b4a-6f1d-b5934809e990"],

Cell["The exact solution to the linear system is:", "Text",
 CellID->1392736130,ExpressionUUID->"7331868a-f3de-6799-22ce-1fd7866b4de3"],

Cell[BoxData[
 RowBox[{"LinearSolve", "[", 
  RowBox[{"A", ",", " ", "b"}], "]"}]], "Input",
 CellLabel->"In[282]:= ",
 CellID->1436829511,ExpressionUUID->"2e54b5d3-3a50-bfef-566b-2c9dbfea0535"],

Cell[TextData[{
 "We can verify the ratio of the squared amplitudes ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       SubscriptBox[
        StyleBox["x", "TI"], "1"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], ":", 
   RowBox[{
    SuperscriptBox[GridBox[{
       {
        SubscriptBox[
         StyleBox["x", "TI"], "2"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", "1"}], ":", 
   "9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "290d3a44-5bc8-0dba-5f32-bc2e5e7d5780"],
 ":"
}], "Text",
 CellID->1267009611,ExpressionUUID->"24441621-d1c3-83e7-4c7b-8f8ae077d1cd"],

Cell[BoxData[
 RowBox[{"Divide", " ", "@@", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Reverse", "[", "%", "]"}], "^", "2"}], ")"}]}]], "Input",
 CellLabel->"In[283]:= ",
 CellID->110542788,ExpressionUUID->"40c04446-bf75-68d5-70f0-5e203a003a3f"],

Cell["Implementation of the controlled-rotation of ancilla qubit", \
"Subsubsection",
 CellID->1120362432,ExpressionUUID->"337e031d-61ac-97b3-6105-9b47105efd99"],

Cell[TextData[{
 "The next step is to rotate the ancilla qubit ",
 Cell[BoxData[
  SubscriptBox[
   TemplateBox[{"0"},
    "Ket"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c1a2f33-e4c4-62b1-1439-c77c8d71309b"],
 " using a controlled RY(\[Theta]) rotation, where the control comes from the \
encoded eigenvalues in the clock (c-) register."
}], "Text",
 CellID->1509344714,ExpressionUUID->"617ac38b-bfe7-c8e3-1719-dad539939ac9"],

Cell["The rotation maps:", "Text",
 CellID->759404798,ExpressionUUID->"0820ecb4-5495-9c54-39df-05fe5d21e6be"],

Cell[TextData[Cell[BoxData[
 RowBox[{
  SubscriptBox[
   TemplateBox[{"0"},
    "Ket"], 
   StyleBox["a", "TI"]], "\[Rule]", 
  RowBox[{
   RowBox[{
    SqrtBox[
     RowBox[{"1", "-", 
      FractionBox[
       StyleBox["C", "TI"], 
       SuperscriptBox[
        OverscriptBox[
         SubscriptBox[
          StyleBox["\[Lambda]", "TI"], 
          StyleBox["j", "TI"]], "\[NonBreakingSpace]"], "2"]]}]], 
    SubscriptBox[
     TemplateBox[{"0"},
      "Ket"], 
     StyleBox["a", "TI"]]}], "+", 
   RowBox[{
    FractionBox[
     StyleBox["C", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Lambda]", "TI"], "\[NonBreakingSpace]"], 
      StyleBox["j", "TI"]]], 
    SubscriptBox[
     TemplateBox[{"1"},
      "Ket"], 
     StyleBox["a", "TI"]]}]}]}]], "InlineFormula",
 FontSize->0.9 
  Inherited,ExpressionUUID->"5e80e7d7-2c44-8e80-06bf-fe9145f6d4ea"]], "Text",
 CellID->691659446,ExpressionUUID->"26f5fcf3-bda8-2342-4e8a-f5bd345d71a8"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "2", 
   StyleBox["A", "TI"], 
   StyleBox["r", "TI"], 
   StyleBox["c", "TI"], 
   StyleBox["S", "TI"], 
   StyleBox["i", "TI"], 
   StyleBox["n", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   FractionBox[
    StyleBox["C", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Lambda]", "TI"], "\[NonBreakingSpace]"], 
     StyleBox["j", "TI"]]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15b39007-6d36-072c-4340-0a6104c36a76"],
 " and ",
 StyleBox["C", "TI"],
 " is a constant chosen to maximize the probability of measuring ",
 Cell[BoxData[
  SubscriptBox[
   TemplateBox[{"1"},
    "Ket"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24baaecf-7f93-f980-4c59-47a97a27cbea"],
 "."
}], "Text",
 CellID->1692422771,ExpressionUUID->"76f70144-dc0f-2312-1e8c-9921d5bb8e78"],

Cell[TextData[{
 "The sum of the squares of the coefficients of ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fe7a9e0-94ce-d707-459c-40ca1d78ba6d"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d41bad8-5432-fbcd-6b7e-33825dc4c917"],
 " is 1, as required for a normalized quantum state. This also implies that \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "\[LessEqual]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Lambda]", "TI"], "\[NonBreakingSpace]"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dba7410-c818-dfcb-3b5a-6e5de992a511"],
 " for all eigenvalues. Since the minimal ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Lambda]", "TI"], "\[NonBreakingSpace]"], 
    StyleBox["j", "TI"]], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30c9b337-f958-fd8c-60f6-2b70f8d2c7d6"],
 " in our example, we set ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ef4fbe9-42ce-bb3a-268b-f2b377780600"],
 " to maximize the probability of measuring ",
 Cell[BoxData[
  SubscriptBox[
   TemplateBox[{"1"},
    "Ket"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b93c9b6-6d32-b3d4-19a0-e0f004c4013e"],
 " during the ancilla measurement."
}], "Text",
 CellID->752878131,ExpressionUUID->"78b94e11-c6dd-a6bf-2847-605af3690c85"],

Cell["\<\
To implement this rotation in the algorithm,we solve for \[Theta] in terms of \
the encoded eigenvalues:\
\>", "Text",
 CellID->1632119710,ExpressionUUID->"1b080b4d-7396-a957-4937-a3170620fbbd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rotation", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"\"\<RY\>\"", "[", "\[Theta]", "]"}], "]"}], "@", 
    RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}]}]}], ";"}], "\n", 
 RowBox[{"rotation", "[", "\"\<Formula\>\"", "]"}]}], "Input",
 CellLabel->"In[284]:= ",
 CellID->6208515,ExpressionUUID->"343c9421-c983-3b23-5dc3-0d8ae8378609"],

Cell[BoxData[
 RowBox[{"\[Theta]solutions", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"rotation", "[", "\"\<AmplitudeList\>\"", "]"}], " ", "==", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"1", "/", "\n", 
             RowBox[{
              RowBox[{"\\!", 
               RowBox[{"\\(", 
                RowBox[{"\\*", 
                 RowBox[{"OverscriptBox", "[", 
                  RowBox[{
                   RowBox[{"\\(", "\[Lambda]", "\\)"}], ",", " ", 
                   RowBox[{"\\(", "~", "\\)"}]}], "]"}]}], "\\)"}]}], "^", 
              "2"}]}]}], "]"}], ",", " ", 
          RowBox[{"1", "/", "\n", 
           RowBox[{"\\!", 
            RowBox[{"\\(", 
             RowBox[{"\\*", 
              RowBox[{"OverscriptBox", "[", 
               RowBox[{
                RowBox[{"\\(", "\[Lambda]", "\\)"}], ",", " ", 
                RowBox[{"\\(", "~", "\\)"}]}], "]"}]}], "\\)"}]}]}]}], 
         "}"}]}], ",", " ", 
       RowBox[{"{", "\[Theta]", "}"}]}], "]"}], " ", "/.", " ", "\n", "    ", 
     
     RowBox[{
      RowBox[{"ArcCos", "[", "x_", "]"}], " ", ":>", " ", 
      RowBox[{"ArcSin", "[", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"x", "^", "2"}]}], "]"}], "]"}]}]}], " ", "//", " ", 
    "FullSimplify"}], " ", "//", " ", "Quiet"}]}]], "Input",
 CellLabel->"In[285]:= ",
 CellID->74347427,ExpressionUUID->"205770a9-e847-de3f-506d-69f289f3a505"],

Cell["Assigning the actual eigenvalues:", "Text",
 CellID->1633617975,ExpressionUUID->"78b78126-006e-7c03-284c-1880b11b4769"],

Cell[BoxData[
 RowBox[{"\[Theta]values", " ", "=", " ", 
  RowBox[{
   RowBox[{"\[Theta]", " ", "/.", " ", 
    RowBox[{"Last", "[", "\[Theta]solutions", "]"}]}], " ", "/.", " ", "\n", 
   RowBox[{
    RowBox[{"\\!", 
     RowBox[{"\\(", 
      RowBox[{"\\*", 
       RowBox[{"OverscriptBox", "[", 
        RowBox[{
         RowBox[{"\\(", "\[Lambda]", "\\)"}], ",", " ", 
         RowBox[{"\\(", "~", "\\)"}]}], "]"}]}], "\\)"}]}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}]}]}]}]], "Input",
 CellLabel->"In[286]:= ",
 CellID->1697339300,ExpressionUUID->"5e949e5e-c771-e653-06ab-101bf205ccb9"],

Cell[TextData[{
 "When the ancilla qubit is measured, it collapses to either ",
 Cell[BoxData[
  SubscriptBox[
   TemplateBox[{"0"},
    "Ket"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "359bcca5-e220-9ec0-63b8-e50e97dae42a"],
 " or ",
 Cell[BoxData[
  SubscriptBox[
   TemplateBox[{"1"},
    "Ket"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d973432-f49b-24e6-6bac-ae7ffd2f8ecc"],
 ":"
}], "Text",
 CellID->2070102233,ExpressionUUID->"2740d0b2-6fee-93c4-4d7f-c9fc0998e12e"],

Cell[TextData[{
 "If it collapses to ",
 Cell[BoxData[
  SubscriptBox[
   TemplateBox[{"0"},
    "Ket"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28899a3f-5003-79db-58b6-1c7961b64b21"],
 ", the computation is discarded and repeated."
}], "Item",
 CellID->698088351,ExpressionUUID->"091a51ee-65fb-201c-3f3a-48c8138e7366"],

Cell[TextData[{
 "If it collapses to ",
 Cell[BoxData[
  SubscriptBox[
   TemplateBox[{"1"},
    "Ket"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60c488fa-b38d-2f14-10fb-21a7c638727e"],
 ", the resulting state is proportional to the solution ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["x", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dab8a61-8541-a5e8-6ba8-2c4b2cf50f32"],
 ", but the b-register is still entangled with the clock register."
}], "Item",
 CellID->1574573697,ExpressionUUID->"6cd9d50f-b32b-5aae-14e6-cd68c6de28f4"],

Cell["\<\
To obtain the correct amplitudes in the computational basis, we need to \
uncompute the clock register. This disentangles the b-register from the clock \
qubits.\
\>", "Text",
 CellID->2051866585,ExpressionUUID->"25697345-b0fc-afe2-5317-6b2ec08ef5c8"],

Cell["Quantum Phase Estimation", "Subsubsection",
 CellID->282288942,ExpressionUUID->"7b535da6-b53b-b46b-2961-54003ccf1eb1"],

Cell["\<\
Quantum Phase Estimation (QPE) is a core eigenvalue estimation algorithm used \
in HHL. It consists of three main steps:\
\>", "Text",
 CellID->133247718,ExpressionUUID->"44232014-649d-d43d-6dd0-ba5e0d29bf07"],

Cell["\<\
Creating a superposition of the clock qubits using Hadamard gates.\
\>", "Item",
 CellID->835168588,ExpressionUUID->"7586ae08-7861-bb88-23bd-4052791509d2"],

Cell[TextData[{
 "Applying controlled-unitary operations ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"C", "U"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e345b1-bc57-c084-7c91-5cfb35e392ee"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "*", 
     StyleBox["A", "TI"], "*", 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c2b12ae-6045-71e4-0428-8b0811f043ce"],
 "."
}], "Item",
 CellID->547755865,ExpressionUUID->"180e6a9a-5611-2942-4835-83c463a47ba8"],

Cell["\<\
Performing the inverse quantum Fourier transform (IQFT) on the clock register.\
\>", "Item",
 CellID->1127057817,ExpressionUUID->"6dd95d70-b540-f840-1be7-553a3cfacaaa"],

Cell[TextData[{
 "The goal of QPE is to estimate the phase of the eigenvalues of the unitary \
operator ",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29eb0418-0bd1-ce19-5fe8-9e42ae659563"],
 ". In HHL, the controlled-\|01d448 operation is applied to the b-register, \
conditioned on the clock qubits:"
}], "Text",
 CellID->1146240541,ExpressionUUID->"2fcc496e-9c46-13ea-55f4-614815f36130"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"img", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"\"\<I\>\"", " ", "->", " ", 
       RowBox[{"Range", "[", "4", "]"}]}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<C\>\"", "[", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<RandomUnitary\>\"", ",", " ", "\n", "       ", 
          
          RowBox[{"\"\<Label\>\"", " ", "->", " ", "\n", 
           "        ", "\"\<\!\(\*SuperscriptBox[\(U\), \(\\\ \
\*SuperscriptBox[\(2\), \(n\:f88c - 1\)]\)]\)\>\""}]}], "]"}], "]"}], " ", "->",
        " ", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "6"}], "}"}]}], ",", "\n", "    ", 
      RowBox[{"Sequence", " ", "@@", " ", "\n", "     ", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"QuantumOperator", "[", 
            RowBox[{"\"\<X\>\"", ",", " ", "\n", "         ", 
             RowBox[{"\"\<Label\>\"", " ", "->", " ", 
              RowBox[{"Style", "[", 
               
               RowBox[{"\"\<\[Ellipsis]\>\"", ",", " ", "15", ",", " ", 
                "Bold"}], "]"}]}]}], "]"}], " ", "->", " ", 
           RowBox[{"{", "#", "}"}]}], " ", "&"}], ",", " ", 
         RowBox[{"Range", "[", "6", "]"}]}], "]"}]}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<C\>\"", "[", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<RandomUnitary\>\"", ",", " ", "\n", "       ", 
          
          RowBox[{"\"\<Label\>\"", " ", "->", " ", "\n", 
           "        ", "\"\<\!\(\*SuperscriptBox[\(U\), \(\\\ \
\*SuperscriptBox[\(2\), \(1\)]\)]\)\>\""}]}], "]"}], "]"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "6"}], "}"}]}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<C\>\"", "[", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<RandomUnitary\>\"", ",", " ", "\n", "       ", 
          
          RowBox[{"\"\<Label\>\"", " ", "->", " ", "\n", 
           "        ", "\"\<\!\(\*SuperscriptBox[\(U\), \(\\\ \
\*SuperscriptBox[\(2\), \(0\)]\)]\)\>\""}]}], "]"}], "]"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "6"}], "}"}]}]}], "\n", "    ", "\n", "    ", 
     "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"img", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", "\n", " ", 
   RowBox[{"\"\<WireLabels\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "\n", "   ", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"Rotate", "[", 
         RowBox[{"\"\<\[Ellipsis]\>\"", ",", " ", 
          RowBox[{"\[Pi]", "/", "2"}]}], "]"}], ",", " ", "20", ",", " ", 
        "Bold"}], "]"}], ",", " ", "\"\<n\>\"", ",", " ", "\n", 
      "   ", "\"\<\!\(\*SubscriptBox[\(n\), \(b\)]\)\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"\"\<GateBackgroundStyle\>\"", " ", "->", " ", 
    RowBox[{"{", "\n", "   \t", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<\[Ellipsis]\>\"", ",", " ", "15", ",", " ", "Bold"}], 
        "]"}], " ", "->", " ", "None"}], ",", "\n", "   \t", 
      RowBox[{
       RowBox[{"\"\<\!\(\*SuperscriptBox[\(U\), \(\\\ \*SuperscriptBox[\(2\), \
\(n\:f88c - 1\)]\)]\)\>\"", " ", "|", " ", "\n", 
        "     ", "\"\<\!\(\*SuperscriptBox[\(U\), \(\\\ \
\*SuperscriptBox[\(2\), \(1\)]\)]\)\>\"", " ", "|", " ", "\n", 
        "     ", "\"\<\!\(\*SuperscriptBox[\(U\), \(\\\ \
\*SuperscriptBox[\(2\), \(0\)]\)]\)\>\""}], " ", "->", " ", 
       RowBox[{"Lighter", "@", 
        RowBox[{"Hue", "[", 
         RowBox[{"0.33", ",", " ", "0.3", ",", " ", "0.79"}], "]"}]}]}]}], 
     "\n", "   \t", "}"}]}], ",", "\n", " ", 
   RowBox[{"\"\<GateBoundaryStyle\>\"", " ", "->", " ", 
    RowBox[{"{", "\n", "   \t", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<\[Ellipsis]\>\"", ",", " ", "15", ",", " ", "Bold"}], 
        "]"}], " ", "->", " ", "None"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{"\"\<\!\(\*SuperscriptBox[\(U\), \(\\\ \*SuperscriptBox[\(2\), \
\(n\:f88c - 1\)]\)]\)\>\"", " ", "|", " ", "\n", 
        "     ", "\"\<\!\(\*SuperscriptBox[\(U\), \(\\\ \
\*SuperscriptBox[\(2\), \(1\)]\)]\)\>\"", " ", "|", " ", "\n", 
        "     ", "\"\<\!\(\*SuperscriptBox[\(U\), \(\\\ \
\*SuperscriptBox[\(2\), \(0\)]\)]\)\>\""}], " ", "->", " ", 
       RowBox[{"Darker", "@", 
        RowBox[{"Hue", "[", 
         RowBox[{"0.33", ",", " ", "0.3", ",", " ", "0.79"}], "]"}]}]}]}], 
     "\n", "   \t", "}"}]}]}], "\n", " ", "]"}]}], "Input",
 CellLabel->"In[287]:= ",
 CellID->640958903,ExpressionUUID->"191acd8d-6e98-c427-4f39-e4d70b12af0d"],

Cell["For our 2\[Times]2 example (\|01d45b=2), the required operations are:", \
"Text",
 CellID->664395832,ExpressionUUID->"2305a976-3107-1e82-513a-413040b264e8"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["U", "TI"], 
    SuperscriptBox["2", "1"]], "=", 
   SuperscriptBox[
    StyleBox["U", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7db30b64-26ac-b1af-2b40-a34e535e03f5"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["U", "TI"], 
    SuperscriptBox["2", "0"]], "=", 
   StyleBox["U", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7eeaae22-94f7-017f-26e9-478c1c825045"]
}], "Text",
 CellID->1464804462,ExpressionUUID->"09646c1c-8840-439e-3f1b-864629f511e4"],

Cell[TextData[{
 "To construct these gates, we first derive the unitary ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "*", 
     StyleBox["A", "TI"], "*", 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63ab22ce-56be-71a3-11a8-bba8634b4389"],
 " by performing a similarity transformation on ",
 StyleBox["A", "TI"],
 ", exponentiating, and transforming back to the original basis:"
}], "Text",
 CellID->660834090,ExpressionUUID->"1cf7fb29-0d40-1e28-448c-f373a4f56572"],

Cell[BoxData[
 RowBox[{"U", " ", "=", " ", 
  RowBox[{"QuantumOperator", "[", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"3", " ", "Pi"}], ")"}], "/", "4"}], ")"}], " ", "I", " ", 
     "A"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[288]:= ",
 CellID->1329190074,ExpressionUUID->"2d412947-9e62-7904-5b7e-c1211b17486e"],

Cell["Inspecting the resulting matrix:", "Text",
 CellID->1098626693,ExpressionUUID->"6fd69df2-7b02-a961-15ed-14bc7eb4f84b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"U", "[", "\"\<Matrix\>\"", "]"}], " ", "//", " ", 
  "MatrixForm"}]], "Input",
 CellLabel->"In[289]:= ",
 CellID->1614557393,ExpressionUUID->"768fd558-59bf-0a63-1eb4-cd02584a5949"],

Cell[TextData[{
 "and for ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["U", "TI"], "2"], ":"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26b5396e-c871-0359-4e4a-b14be90451a3"]
}], "Text",
 CellID->461646698,ExpressionUUID->"1f77ebf2-aec9-563c-450c-02bfcb7c3d06"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"U", "^", "2"}], ")"}], "[", "\"\<Matrix\>\"", "]"}], " ", "//", 
  " ", "MatrixForm"}]], "Input",
 CellLabel->"In[290]:= ",
 CellID->720797685,ExpressionUUID->"5317ee41-6066-3577-012c-002b11109c5d"],

Cell[TextData[{
 "This gate encodes the Hamiltonian defined by the matrix ",
 StyleBox["A.", "TI"],
 " Since ",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0454080f-5b74-5a26-2c6b-a2695e01290c"],
 " is unitary, its eigenvalues are roots of unity meaning that the phase of \
each eigenvalue of ",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "200c839f-1e44-fe5c-5033-1ad99bf6c4a6"],
 " is proportional to the corresponding eigenvalue of ",
 StyleBox["A", "TI"],
 ". Consequently, when QPE is applied in HHL, the eigenvalues of ",
 StyleBox["A", "TI"],
 " are encoded in the clock (c-) register through basis encoding, rather than \
storing their exact numerical values."
}], "Text",
 CellID->1577067366,ExpressionUUID->"573cfa27-29ff-38cf-7ec3-f3814f8b8a15"],

Cell["\<\
We can also implement QPE directly using the built-in \
\[OpenCurlyDoubleQuote]PhaseEstimation\[CloseCurlyDoubleQuote] gate in \
Wolfram Language:\
\>", "Text",
 CellID->1360338734,ExpressionUUID->"7bb83578-78e8-07f4-2947-ad22789d6dde"],

Cell[BoxData[
 RowBox[{"QPE", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<PhaseEstimation\>\"", "[", 
     RowBox[{"U", ",", " ", "n"}], "]"}], "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"2", " ", ";;", " ", 
     RowBox[{"-", "3"}]}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[291]:= ",
 CellID->908636880,ExpressionUUID->"48fc1f1f-3652-ba13-7883-975943e40979"],

Cell[BoxData[
 RowBox[{"QPE", "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[292]:= ",
 CellID->697043297,ExpressionUUID->"0a3cf3ec-7071-038e-3bc3-eab6010451d4"],

Cell[TextData[{
 "Note that in our framework, the controlled-unitary gates are constructed in \
the opposite direction compared to this paper conventions. ",
 StyleBox["(remove this, focus only on our convention, we do not want to say \
we reproduce exactly a specific result etc)",
  FontWeight->"Bold"]
}], "Text",
 CellID->4907145,ExpressionUUID->"44b6a437-3794-76b8-6c4d-3e7142215c82"],

Cell["Circuit Implementation", "Subsubsection",
 CellID->1598914473,ExpressionUUID->"3e37a26f-afb3-2e6c-67cc-4448ca4674b6"],

Cell["\<\
We can now implement the full HHL algorithm as a quantum circuit in Wolfram \
Language. The circuit includes the following steps:\
\>", "Text",
 CellID->1665928469,ExpressionUUID->"576120e7-4357-336c-7d1e-b9c176e381b6"],

Cell[TextData[{
 "Initialize the b-register with the state ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["b", "TI"]},
    "Ket"], "."}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "375ed7c0-a5a4-d638-5d65-ceadcc56bd02"]
}], "Item",
 CellID->697287287,ExpressionUUID->"1106a12f-2723-9187-473d-388952d7e3ed"],

Cell["Apply Quantum Phase Estimation (QPE) on the clock qubits.", "Item",
 CellID->1434680038,ExpressionUUID->"0df9f048-7a44-7b96-3b86-ea127ff149fc"],

Cell["\<\
Perform controlled RY(\[Theta]) rotations on the ancilla qubit, using the \
angles computed from the encoded eigenvalues.\
\>", "Item",
 CellID->865619979,ExpressionUUID->"11feb189-ad07-7b90-4785-28d2c4b249fa"],

Cell["\<\
Uncompute the QPE to disentangle the b-register from the clock qubits.\
\>", "Item",
 CellID->586448307,ExpressionUUID->"74f078bc-d989-92d9-1c80-71f9d83de023"],

Cell["Measure the b-register to extract the solution.", "Item",
 CellID->351569132,ExpressionUUID->"587682b0-1dd8-f3c6-080d-1bfa9452c12c"],

Cell[BoxData[
 RowBox[{"HHL", " ", "=", " ", 
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumState", "[", "b", "]"}], " ", "->", " ", 
      RowBox[{"{", "4", "}"}]}], ",", " ", "\"\<Barrier\>\"", ",", "\n", 
     "   ", 
     RowBox[{"QPE", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], ",", 
     " ", "\"\<Barrier\>\"", ",", "\n", "   ", 
     RowBox[{
      RowBox[{"\"\<C\>\"", "[", 
       RowBox[{"\"\<RY\>\"", "[", 
        RowBox[{"\[Theta]values", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "1"}], "}"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"\"\<C\>\"", "[", 
       RowBox[{"\"\<RY\>\"", "[", 
        RowBox[{"\[Theta]values", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "1"}], "}"}]}], ",", "\n", 
     "   ", "\"\<Barrier\>\"", ",", " ", 
     RowBox[{"{", "1", "}"}], ",", " ", "\"\<Barrier\>\"", ",", "\n", "   ", 
     RowBox[{
      RowBox[{"SuperDagger", "[", "QPE", "]"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"{", "4", "}"}]}], "\n", "   ", "}"}], "]"}]}]], "Input",
 CellLabel->"In[293]:= ",
 CellID->1406322398,ExpressionUUID->"252e0451-1a36-40ed-4cd5-9e1b9fc31237"],

Cell["We can visualize the circuit:", "Text",
 CellID->1919796405,ExpressionUUID->"6b506e1e-f100-9568-196f-805b80baffb2"],

Cell[BoxData[
 RowBox[{"HHL", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"Expand", " ", "->", " ", "2"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Full"}]}], "]"}]], "Input",
 CellLabel->"In[294]:= ",
 CellID->254713522,ExpressionUUID->"45e6cda3-0332-8806-739d-e40db6c4db6c"],

Cell["Perform the measurement:", "Text",
 CellID->558852891,ExpressionUUID->"10a6fcee-2410-cb5f-405d-f5c84daa99a5"],

Cell[BoxData[
 RowBox[{"measurement", " ", "=", " ", 
  RowBox[{"HHL", "[", "]"}]}]], "Input",
 CellLabel->"In[295]:= ",
 CellID->90989803,ExpressionUUID->"20b3c3fd-ce47-45e5-5040-daa6ebf22fcf"],

Cell["\<\
After executing the circuit and measuring the qubits, the probabilities of \
each computational basis state are:\
\>", "Text",
 CellID->1087645828,ExpressionUUID->"0dd5773b-5215-a52c-3beb-6f6567a10c76"],

Cell[BoxData[
 RowBox[{"result", " ", "=", " ", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"measurement", "[", "\"\<Probabilities\>\"", "]"}], "]"}], " ", "//",
    " ", "FullSimplify"}]}]], "Input",
 CellLabel->"In[296]:= ",
 CellID->1525018268,ExpressionUUID->"7da02f1b-35d4-9174-2b5f-c745bc66e05e"],

Cell["\<\
The solution correspond to the measured probabilities of the b-register. \
Selecting the relevant outcomes:\
\>", "Text",
 CellID->1003506344,ExpressionUUID->"1be4ea81-18b8-2b05-499b-03eb994d766f"],

Cell[BoxData[
 RowBox[{"x", " ", "=", " ", 
  RowBox[{
   RowBox[{"Values", "[", "result", "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"{", 
     RowBox[{"3", ",", " ", "4"}], "}"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[297]:= ",
 CellID->348094811,ExpressionUUID->"2bec375e-30ea-24bd-5993-af18409c8e87"],

Cell["\<\
Finally, we verify that the ratio of the measured amplitudes matches the \
ratio of squared solutions obtained classically:\
\>", "Text",
 CellID->507554168,ExpressionUUID->"7dcf5242-c9ff-a686-2bf5-542fef8b0cec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Divide", " ", "@@", " ", "x"}], " ", "==", " ", 
  RowBox[{"Divide", " ", "@@", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"LinearSolve", "[", 
      RowBox[{"A", ",", " ", "b"}], "]"}], "^", "2"}], ")"}]}]}]], "Input",
 CellLabel->"In[298]:= ",
 CellID->292292423,ExpressionUUID->"52da685f-2498-05f2-02f9-82194d2d6fd8"],

Cell["\<\
This confirms that the HHL implementation successfully encodes the solution \
to the linear system in the amplitudes of the b-register, consistent with the \
classical solution.\
\>", "Text",
 CellID->215854723,ExpressionUUID->"12aa8adb-4d50-9545-42a9-238564eaffaf"],

Cell["Variational Quantum Linear Solver (VQLS)", "Subsection",
 CellID->1110291207,ExpressionUUID->"6bddd79b-6823-400d-19e2-cec509d61357"],

Cell["\<\
The Variational Quantum Linear Solver (VQLS) is a a hybrid quantum-classical \
technique designed to address Quantum Linear Systems Problem (QLSP). It aims \
to find linear system solutions using quantum computing techniques. The \
corresponding quantum algorithm can be summarized as follows:\
\>", "Text",
 CellID->669011842,ExpressionUUID->"0292d5cf-fba4-5fb5-32a1-cca8fe51259f"],

Cell["Given:", "Text",
 CellID->2092273288,ExpressionUUID->"315a5c02-c518-37e9-677a-566fec929d33"],

Cell[TextData[{
 "A quantum state ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["b", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "601c6277-b8fa-6d82-1023-8431388f37e8"],
 " such that ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["b", "TI"]},
    "Ket"], "=", 
   RowBox[{
    StyleBox["U", "TI"], 
    TemplateBox[{"0"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "056e5c3e-0591-d839-3316-5678ac25ab03"]
}], "Item",
 CellID->816649243,ExpressionUUID->"7362f573-955d-4629-2111-ed3d1ce82d73"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["2", 
    StyleBox["n", "TI"]], "\[ThinSpace]", 
   StyleBox["x", "TI"], "\[ThinSpace]", 
   SuperscriptBox["2", 
    StyleBox["n", "TI"]], "\[ThinSpace]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d4a449b-9aea-2b01-4b4a-5dc51e9f766b"],
 "dimensional matrix ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "693f6746-f6ea-213d-18c5-7f23829f7007"],
 " such that ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   UnderoverscriptBox["\[Sum]", "0", 
    RowBox[{
     StyleBox["L", "TI"], "-", "1"}],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["l", "TI"]], 
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["l", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58bbc0e4-f422-75b6-0858-d9c1fdd75f9c"],
 " where ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["l", "TI"]], "\[ThinSpace]", 
   StyleBox["\[CurlyEpsilon]", "TI"], "\[ThinSpace]", "\:2102", 
   "\[ThinSpace]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "512ebd8c-9517-4b4e-00d5-34d61ca21994"],
 "and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["A", "TI"], 
   StyleBox["l", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38255ff6-675c-bc9f-69db-56b012ee06e5"],
 "are unitary gates"
}], "Item",
 CellID->1789875593,ExpressionUUID->"0868aa04-f8be-0db7-3817-4c61f94b579d"],

Cell["One wants to prepare:", "Text",
 CellID->1026777853,ExpressionUUID->"0889c062-717f-f29f-38b6-da4c000bc0e5"],

Cell[TextData[{
 "A quantum state ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["x", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f19c016-97c3-092d-0526-da5022765877"],
 " such that ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "=", 
   RowBox[{
    StyleBox["A", "TI"], 
    TemplateBox[{
      StyleBox["x", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c809b18-7d36-d224-44bf-134274c0a10e"],
 " and ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"], 
    SqrtBox[
     TemplateBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["\[Psi]", "TI"]},
      "BraKet"]]], "\[Rule]", 
   TemplateBox[{
     StyleBox["b", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7167cc0d-03c8-d238-271c-e657b662a102"]
}], "Item",
 CellID->314602653,ExpressionUUID->"324c55d1-ee3a-374b-6274-4c9a8bcc9d91"],

Cell["VQLS Approach", "Text",
 CellID->1307363292,ExpressionUUID->"4495e7b4-eb19-1195-6caa-fef18eac63ff"],

Cell[TextData[{
 "We will get an approximate ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["x", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "561855fc-8d4a-f767-7e38-4ca624fcda4d"],
 " state using a variational quantum circuit ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cc16cd1-dd21-1c76-14fe-859ad4d4675c"],
 "(\[Omega]), in other words:"
}], "Text",
 CellID->1555921901,ExpressionUUID->"30881872-2ed2-344c-60b7-923c4b649e96"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     StyleBox["x", "TI"]},
    "Ket"], "=", 
   RowBox[{
    StyleBox["V", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Omega]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{"0"},
     "Ket"]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->778760422,ExpressionUUID->"06a6bc82-b4ed-9511-2e5d-35ec3c99fc7b"],

Cell[TextData[{
 "Then, we look to optimize the parameters ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["\[Omega]", "TI"], "=", "{", 
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], "0"]}], ",", 
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], "1"], ",", 
    RowBox[{".", ".", "."}]}], "\[ThinSpace]", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15240c0a-58c5-65f1-3cdb-a65459704fdb"],
 " in order to minimize the cost function. We can propose the following cost \
function:"
}], "Text",
 CellID->434963440,ExpressionUUID->"6874cd6b-f967-cd5b-180b-e534f81397a1"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   SubscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["G", "TI"]], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      TemplateBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["\[Psi]", "TI"]},
       "BraKet"]], 
     TemplateBox[{
       StyleBox["x", "TI"]},
      "Bra"], 
     SubscriptBox[
      StyleBox["H", "TI"], 
      StyleBox["G", "TI"]], 
     TemplateBox[{
       StyleBox["x", "TI"]},
      "Ket"]}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       TemplateBox[{
         StyleBox["\[Psi]", "TI"], 
         StyleBox["\[Psi]", "TI"]},
        "BraKet"]], 
      RowBox[{
       StyleBox["Tr",
        FontSlant->"Plain"], 
       StyleBox["[",
        FontSize->1.2 Inherited], 
       RowBox[{
        TemplateBox[{
          StyleBox["\[Psi]", "TI"]},
         "Ket"], 
        TemplateBox[{
          StyleBox["\[Psi]", "TI"]},
         "Bra"], 
        RowBox[{"(", 
         RowBox[{"\|01d7d9", "-", 
          RowBox[{
           TemplateBox[{
             StyleBox["b", "TI"]},
            "Ket"], 
           TemplateBox[{
             StyleBox["b", "TI"]},
            "Bra"]}]}], ")"}]}], 
       StyleBox["]",
        FontSize->1.2 Inherited]}]}], "=", 
     RowBox[{"1", "-", 
      SuperscriptBox[GridBox[{
         {
          TemplateBox[{
            StyleBox["b", "TI"], 
            StyleBox[
             StyleBox["\[Psi]", "TI"], FontWeight -> "Bold"]},
           "BraKet"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->211411563,ExpressionUUID->"16aea7ca-f02c-8fa8-3e55-3e9781ded5f2"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "=", 
   FractionBox[
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"], 
    SqrtBox[
     TemplateBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["\[Psi]", "TI"]},
      "BraKet"]]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68bcb404-3168-9397-1843-2e6e4002e1fd"],
 "."
}], "Text",
 CellID->1975237389,ExpressionUUID->"3074fef3-0190-9aee-600b-f7bdb02ae834"],

Cell[TextData[{
 "You can write ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["C", "TI"], 
   StyleBox["G", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5132409c-0c71-a3d8-00c2-59c6a505f122"],
 " explicitly as:"
}], "Text",
 CellID->662478076,ExpressionUUID->"65312e6e-5674-5434-0cce-c04863013f1e"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   SubscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["G", "TI"]], "=", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["l", "TI"], ",", 
         SuperscriptBox[
          StyleBox["l", "TI"], "\[Prime]"]}],
        LimitsPositioning->False], 
       RowBox[{
        SubscriptBox[
         StyleBox["c", "TI"], 
         StyleBox["l", "TI"]], 
        SubsuperscriptBox[
         StyleBox["c", "TI"], 
         SuperscriptBox[
          StyleBox["l", "TI"], "\[Prime]"], "*"], 
        TemplateBox[{"0"},
         "Bra"], 
        SuperscriptBox[
         StyleBox["V", "TI"], "\[Dagger]"], 
        SubsuperscriptBox[
         StyleBox["A", "TI"], 
         SuperscriptBox[
          StyleBox["l", "TI"], "\[Prime]"], "\[Dagger]"], 
        StyleBox["U", "TI"], 
        TemplateBox[{"0"},
         "Ket"], 
        TemplateBox[{"0"},
         "Bra"], 
        SuperscriptBox[
         StyleBox["U", "TI"], "\[Dagger]"], 
        SubscriptBox[
         StyleBox["A", "TI"], 
         StyleBox["l", "TI"]], 
        StyleBox["V", "TI"], 
        TemplateBox[{"0"},
         "Ket"]}]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "/", 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["l", "TI"], ",", 
         SuperscriptBox[
          StyleBox["l", "TI"], "\[Prime]"]}],
        LimitsPositioning->False], 
       RowBox[{
        SubscriptBox[
         StyleBox["c", "TI"], 
         StyleBox["l", "TI"]], 
        SubsuperscriptBox[
         StyleBox["c", "TI"], 
         SuperscriptBox[
          StyleBox["l", "TI"], "\[Prime]"], "*"], 
        TemplateBox[{"0"},
         "Bra"], 
        SuperscriptBox[
         StyleBox["V", "TI"], "\[Dagger]"], 
        SubsuperscriptBox[
         StyleBox["A", "TI"], 
         SuperscriptBox[
          StyleBox["l", "TI"], "\[Prime]"], "\[Dagger]"], 
        SubscriptBox[
         StyleBox["A", "TI"], 
         StyleBox["l", "TI"]], 
        StyleBox["V", "TI"], 
        TemplateBox[{"0"},
         "Ket"]}]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1079147241,ExpressionUUID->"0235daed-fad3-6b5f-33ca-d3b6ff6639a5"],

Cell[TextData[{
 "As ",
 ButtonBox["Bravo-Prieto",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://doi.org/10.48550/ARXIV.1909.05820"], None}],
 " explains, a barren plateau might arise from using this global cost \
function. In other words, it indicates that the gradients of the cost \
function with respect to the parameters of the quantum circuit vanish \
exponentially as the number of qubits ",
 StyleBox["n", "TI"],
 " increases. When gradients become extremely small, it becomes hard for \
optimization algorithms to make meaningful progress in adjusting the \
parameters of the quantum circuit to minimize the cost function."
}], "Text",
 CellID->1195805688,ExpressionUUID->"3c9f7e12-83c1-89ed-64a5-705c3675db37"],

Cell[TextData[{
 "Instead, we can work with a \[OpenCurlyDoubleQuote]local\
\[CloseCurlyDoubleQuote] version of it and apply the Hadamard test to \
estimate the expectation values. According to Bravo-Prieto, the local version \
is calculaton by changing ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["G", "TI"]], "\[Rule]", 
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["L", "TI"]]}], "=", 
   RowBox[{"[", 
    RowBox[{
     SuperscriptBox[
      StyleBox["A", "TI"], "\[Dagger]"], 
     StyleBox["U", "TI"], 
     RowBox[{"(", 
      RowBox[{"\|01d7d9", "-", 
       RowBox[{
        FractionBox["1", 
         StyleBox["n", "TI"]], 
        RowBox[{
         StyleBox["\[Sum]",
          FontSize->1.15 Inherited], 
         RowBox[{
          SubscriptBox[
           TemplateBox[{"0"},
            "Ket"], 
           StyleBox["j", "TI"]], 
          RowBox[{
           SubscriptBox[
            TemplateBox[{"0"},
             "Bra"], 
            StyleBox["j", "TI"]], "\[CircleTimes]", 
           SubscriptBox["\|01d7d9", 
            OverscriptBox[
             StyleBox["j", "TI"], "-"]]}]}]}]}]}], ")"}], 
     SuperscriptBox[
      StyleBox["U", "TI"], "\[Dagger]"], 
     StyleBox["A", "TI"]}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "505aa7d0-1afc-86f2-0079-3e9a9e8eecd8"],
 ", where ",
 StyleBox["j ", "TI"],
 "is the qubit index and ",
 Cell[BoxData[
  SubscriptBox["\|01d7d9", 
   OverscriptBox[
    StyleBox["j", "TI"], "-"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5143f96d-83a3-6ed2-0770-f13736563438"],
 " the indentity on all qubits except ",
 StyleBox["j", "TI"],
 "."
}], "Text",
 CellID->1438181175,ExpressionUUID->"7e0ac860-85ff-08e4-2609-e24a338a5ace"],

Cell["\<\
Finally we can express the local cost function explicitly as:\
\>", "Text",
 CellID->1583099613,ExpressionUUID->"2c4a7891-0723-3e0d-544a-71dbb2d78557"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   SubscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["L", "TI"]], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], "-", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"2", 
        StyleBox["n", "TI"]}]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["j", "TI"], "=", "0"}], 
        RowBox[{
         StyleBox["n", "TI"], "-", "1"}],
        LimitsPositioning->False], 
       FractionBox[
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["l", "TI"], ",", 
           SuperscriptBox[
            StyleBox["l", "TI"], "\[Prime]"]}],
          LimitsPositioning->False], 
         RowBox[{
          SubscriptBox[
           StyleBox["c", "TI"], 
           StyleBox["l", "TI"]], 
          SubsuperscriptBox[
           StyleBox["c", "TI"], 
           SuperscriptBox[
            StyleBox["l", "TI"], "\[Prime]"], "*"], 
          TemplateBox[{"0"},
           "Bra"], 
          SuperscriptBox[
           StyleBox["V", "TI"], "\[Dagger]"], 
          SubsuperscriptBox[
           StyleBox["A", "TI"], 
           SuperscriptBox[
            StyleBox["l", "TI"], "\[Prime]"], "\[Dagger]"], 
          StyleBox["U", "TI"], 
          SubscriptBox[
           StyleBox["Z", "TI"], 
           StyleBox["j", "TI"]], 
          SuperscriptBox[
           StyleBox["U", "TI"], "\[Dagger]"], 
          SubscriptBox[
           StyleBox["A", "TI"], 
           StyleBox["l", "TI"]], 
          StyleBox["V", "TI"], 
          TemplateBox[{"0"},
           "Ket"]}]}], 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["l", "TI"], ",", 
           SuperscriptBox[
            StyleBox["l", "TI"], "\[Prime]"]}],
          LimitsPositioning->False], 
         RowBox[{
          SubscriptBox[
           StyleBox["c", "TI"], 
           StyleBox["l", "TI"]], 
          SubsuperscriptBox[
           StyleBox["c", "TI"], 
           SuperscriptBox[
            StyleBox["l", "TI"], "\[Prime]"], "*"], 
          TemplateBox[{"0"},
           "Bra"], 
          SuperscriptBox[
           StyleBox["V", "TI"], "\[Dagger]"], 
          SubsuperscriptBox[
           StyleBox["A", "TI"], 
           SuperscriptBox[
            StyleBox["l", "TI"], "\[Prime]"], "\[Dagger]"], 
          SubscriptBox[
           StyleBox["A", "TI"], 
           StyleBox["l", "TI"]], 
          StyleBox["V", "TI"], 
          TemplateBox[{"0"},
           "Ket"]}]}]]}]}]}], "=", 
    RowBox[{
     FractionBox["1", "2"], "-", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"2", 
        StyleBox["n", "TI"]}]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["j", "TI"], "=", "0"}], 
        RowBox[{
         StyleBox["n", "TI"], "-", "1"}],
        LimitsPositioning->False], 
       FractionBox[
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["l", "TI"], ",", 
           SuperscriptBox[
            StyleBox["l", "TI"], "\[Prime]"]}],
          LimitsPositioning->False], 
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["l", "TI"]], 
         SubsuperscriptBox[
          StyleBox["c", "TI"], 
          SuperscriptBox[
           StyleBox["l", "TI"], "\[Prime]"], "*"], 
         SubscriptBox[
          StyleBox["\[Mu]", "TI"], 
          RowBox[{
           StyleBox["l", "TI"], ",", 
           SuperscriptBox[
            StyleBox["l", "TI"], "\[Prime]"], ",", 
           StyleBox["j", "TI"]}]]}], 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["l", "TI"], ",", 
           SuperscriptBox[
            StyleBox["l", "TI"], "\[Prime]"]}],
          LimitsPositioning->False], 
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["l", "TI"]], 
         SubsuperscriptBox[
          StyleBox["c", "TI"], 
          SuperscriptBox[
           StyleBox["l", "TI"], "\[Prime]"], "*"], 
         SubscriptBox[
          StyleBox["\[Mu]", "TI"], 
          RowBox[{
           StyleBox["l", "TI"], ",", 
           SuperscriptBox[
            StyleBox["l", "TI"], "\[Prime]"], ",", 
           RowBox[{"-", "1"}]}]]}]]}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->268967786,ExpressionUUID->"567bfdcc-56c6-5358-7e18-f496637321a2"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Mu]", "TI"], 
    RowBox[{
     StyleBox["l", "TI"], "\[ThinSpace]", ",", "\[ThinSpace]", 
     SuperscriptBox[
      StyleBox["l", "TI"], "\[Prime]"], ",", 
     StyleBox["j", "TI"]}]], "=", 
   RowBox[{
    TemplateBox[{"0"},
     "Bra"], 
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Dagger]"], 
    SubsuperscriptBox[
     StyleBox["A", "TI"], 
     SuperscriptBox[
      StyleBox["l", "TI"], "\[Prime]"], "\[Dagger]"], 
    StyleBox["U", "TI"], 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["J", "TI"]], 
    SuperscriptBox[
     StyleBox["U", "TI"], "\[Dagger]"], 
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox["l", "TI"]], 
    StyleBox["V", "TI"], 
    TemplateBox[{"0"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b371d01-a041-5dbe-3acc-956ad1f42784"],
 " , ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Z", "TI"], 
    RowBox[{"-", "1"}]], "\[Rule]", "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09dcd030-ee58-59fb-3fe3-ca7d8bed2bc1"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["G", "TI"]], "\[Rule]", "0", "\[ThinSpace]", "\[LeftRightArrow]", 
   SubscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["L", "TI"]], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3eb66b53-0a81-4482-664d-831daf342ee8"],
 "."
}], "Text",
 CellID->1291073451,ExpressionUUID->"4513a2b6-5679-71cc-7320-3bf0630c4316"],

Cell["References used for this section:", "Text",
 CellID->1748059461,ExpressionUUID->"0a5000e8-62c3-6dca-3a6f-99b217763710"],

Cell["\<\
Bravo-Prieto, C., LaRose, R., Cerezo, M., Subasi, Y., Cincio, L., & Coles, P. \
J. (2019). Variational Quantum Linear Solver. arXiv. \
https://doi.org/10.48550/ARXIV.1909.05820\
\>", "Item",
 CellID->1803146654,ExpressionUUID->"72376a19-67f8-2d8a-23cc-8c43118d77d0"],

Cell["\<\
Mari, A. Variational Quantum Linear Solver. PennyLane Demos. \
https://pennylane.ai/qml/demos/tutorial_vqls/\
\>", "Item",
 CellID->1483678341,ExpressionUUID->"6261e651-652e-b57b-121e-f81b0cd81c41"],

Cell["QLSP introductory example", "Subsubsection",
 CellID->242000893,ExpressionUUID->"02289828-dcb6-ed3d-33d7-1275d540b407"],

Cell["\<\
In this implementation we will consider the first qubit as our auxiliary \
qubit, since in the Wolfram QuantumFramework negative qubits and qubit 0 are \
used only for classical bits.\
\>", "Text",
 CellID->223023470,ExpressionUUID->"7e4925e4-2eb0-6ad8-2676-bcce4b453822"],

Cell["\<\
For this example we will consider a 2 qubits system plus an auxiliary qubit.\
\>", "Text",
 CellID->736258701,ExpressionUUID->"3f48fd62-d18c-e56b-6577-f54fe03ecfb1"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   SubscriptBox[
    StyleBox["X", "TI"], "2"], 
   SubscriptBox[
    StyleBox["H", "TI"], "3"]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1218947026,ExpressionUUID->"09732abd-5fe3-4802-3f00-c3e759961b68"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     StyleBox["b", "TI"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["U", "TI"], 
     TemplateBox[{"0"},
      "Ket"]}], "=", 
    RowBox[{
     SubscriptBox[
      StyleBox["H", "TI"], "2"], 
     SubscriptBox[
      StyleBox["H", "TI"], "3"], 
     TemplateBox[{"0"},
      "Ket"]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1233403082,ExpressionUUID->"6ab4141e-cc6c-4672-1a4b-8e5be5192d58"],

Cell["\<\
where the operator\[CloseCurlyQuote]s index indicate the qubit it is applied \
on.\
\>", "Text",
 CellID->1812951937,ExpressionUUID->"0f1d8418-8fb4-2aea-3522-1e422a417830"],

Cell["Given the ansatz:", "Text",
 CellID->1778200237,ExpressionUUID->"7b1b0b32-6c87-d322-2938-a37c0533be08"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     StyleBox["x", "TI"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["V", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Omega]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     TemplateBox[{"0"},
      "Ket"]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["R", "TI"], 
        StyleBox["y", "TI"]], 
       RowBox[{
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         SubscriptBox[
          StyleBox["\[Omega]", "TI"], "2"], 
         StyleBox[")",
          SpanMaxSize->1]}], "\[CircleTimes]", 
        SubscriptBox[
         StyleBox["R", "TI"], 
         StyleBox["y", "TI"]]}], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        SubscriptBox[
         StyleBox["\[Omega]", "TI"], "3"], 
        StyleBox[")",
         SpanMaxSize->1]}]}], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     SubscriptBox[
      StyleBox["H", "TI"], "2"], 
     SubscriptBox[
      StyleBox["H", "TI"], "3"], 
     TemplateBox[{"0"},
      "Ket"]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->366872725,ExpressionUUID->"0b382293-4179-aaf9-3ac7-bbdd700df8c3"],

Cell[TextData[{
 "We will proceed to build the circuit to minimize ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["C", "TI"], 
   StyleBox["L", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e8da17c-ff26-3788-56b2-3939fad09dd2"],
 "."
}], "Text",
 CellID->1973513661,ExpressionUUID->"3669af04-3982-74bb-5e16-476eb8375e81"],

Cell["Circuit Implementation", "Text",
 CellID->1612189410,ExpressionUUID->"28fe05af-1890-3d45-5885-9c09992a87af"],

Cell["First we define the gates associated with the example:", "Text",
 CellID->1597078343,ExpressionUUID->"01001107-76e3-9dfc-373f-89610297e7c6"],

Cell[TextData[{
 "The unitary matrix such that ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["b", "TI"]},
    "Ket"], "=", 
   RowBox[{
    SubscriptBox[
     StyleBox["U", "TI"], 
     StyleBox["b", "TI"]], 
    TemplateBox[{"0"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "524d5b64-939d-9e2e-0273-534e2629e574"],
 " :"
}], "Text",
 CellID->1009067156,ExpressionUUID->"3bbb36c0-925a-ccd2-6958-afaa27ec9638"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Ub", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<H\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<H\>\"", " ", "->", " ", 
        RowBox[{"{", "3", "}"}]}]}], "}"}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", 
      " ", "\"\<\!\(\*SubscriptBox[\(U\), \(b\)]\)\>\""}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[299]:= ",
 CellID->859453278,ExpressionUUID->"1a695b16-67b9-69b9-4a17-5350124c3b83"],

Cell[TextData[{
 "Because our goal is to conduct a Hadamard test, it\[CloseCurlyQuote]s \
necessary for the unitary operation ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0deaf6de-bcac-37fa-3be9-ef98355e9dc0"],
 " to be controlled by the state of an auxiliary qubit:"
}], "Text",
 CellID->628694109,ExpressionUUID->"7a9276f6-63cd-444b-2aa2-6fb016782e91"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ControlledAGate", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<CH\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}]}], "}"}], ",", " ", "\n", 
     "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", 
      " ", "\"\<\!\(\*SubscriptBox[\(A\), \(2\)]\)\>\""}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[300]:= ",
 CellID->1531170301,ExpressionUUID->"286ae68d-79c0-1125-5869-ffd77875600f"],

Cell[TextData[{
 "Next, we implement the variational quantum circuit that generates a guess \
for ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["x", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e79da95-910a-a6b5-3606-d3df20bc0c9f"],
 ":"
}], "Text",
 CellID->735884698,ExpressionUUID->"09d777b6-b63f-ed25-3fed-6ef3c3cbb40f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     StyleBox["x", "TI"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["V", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Omega]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     TemplateBox[{"0"},
      "Ket"]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["R", "TI"], 
        StyleBox["x", "TI"]], 
       RowBox[{
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         SubscriptBox[
          StyleBox["\[Omega]", "TI"], "1"], 
         StyleBox[")",
          SpanMaxSize->1]}], "\[CircleTimes]", 
        SubscriptBox[
         StyleBox["R", "TI"], 
         StyleBox["x", "TI"]]}], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        SubscriptBox[
         StyleBox["\[Omega]", "TI"], "2"], 
        StyleBox[")",
         SpanMaxSize->1]}]}], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     SubscriptBox[
      StyleBox["H", "TI"], "2"], 
     SubscriptBox[
      StyleBox["H", "TI"], "3"], 
     TemplateBox[{"0"},
      "Ket"]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->558963547,ExpressionUUID->"2768433a-cec7-30dc-4d68-5b67eb738226"],

Cell["\<\
The first layer prepare an equal superposition of states and the second layer \
is the ansatz proposed before:\
\>", "Text",
 CellID->550808739,ExpressionUUID->"6f776597-6eed-bc41-150d-7cd10a9906ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VariationalBlock", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<H\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Omega]1", "]"}], " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"\"\<RY\>\"", "[", "\[Omega]2", "]"}], " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<V(\[Omega])\>\""}], ",", 
     " ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[Omega]1", ",", " ", "\[Omega]2"}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[301]:= ",
 CellID->176525378,ExpressionUUID->"37f31662-30b3-53e3-5d80-884c414621c9"],

Cell[TextData[{
 "In order to obtain ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Mu]", "TI"], 
   RowBox[{
    StyleBox["l", "TI"], "\[ThinSpace]", ",", "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["l", "TI"], "\[Prime]"], ",", "\[ThinSpace]", 
    StyleBox["j", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0465595f-3759-9855-2c1b-511942edeabf"],
 " we will implement a circuit that will deploy a Hadamard test:"
}], "Text",
 CellID->1835898617,ExpressionUUID->"4b103241-69e7-988c-792f-b42b0f93ead6"],

Cell[TextData[{
 StyleBox["1. ",
  FontWeight->"Bold"],
 "We first apply a Hadamard in the auxiliar qubit to prepare a state in \
superposition. ",
 StyleBox["2. ",
  FontWeight->"Bold"],
 "We apply a Phase Shift to estimate the imaginary or real part of the \[Mu]: \
Re[\[Mu]] when \[Theta] -> 0 and Im[\[Mu]] when \[Theta] -> ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox["\[Pi]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "423e0d65-9e44-f34a-73c5-a54f1bf6c190"],
 "."
}], "Text",
 CellID->1439759482,ExpressionUUID->"1bc261b5-654b-a677-49f2-78ff0cff0d5d"],

Cell[TextData[{
 StyleBox["3.",
  FontWeight->"Bold"],
 " Apply the Variational Circuit to generare a guess on ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["x", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34f1caf0-755d-71af-5c8e-e3ba7ce843f5"],
 ". ",
 StyleBox["4.",
  FontWeight->"Bold"],
 " Apply the Controlled Gate corresponding to the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["A", "TI"], 
   RowBox[{
    StyleBox["l", "TI"], "\[ThinSpace]"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14d4f14a-07e3-3752-3ceb-e914b1979db8"],
 "component. ",
 StyleBox["5. ",
  FontWeight->"Bold"],
 "Apply the adjoint ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["U", "TI"], 
   StyleBox["b", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b5a0245-2820-625f-2979-a42f49d530a5"],
 ", but in this case is the same as ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["U", "TI"], 
   StyleBox["b", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45aa5bc0-73da-807d-73aa-52aa066cd347"],
 ". ",
 StyleBox["6.",
  FontWeight->"Bold"],
 " Implement a controlled Z operator from the auxiliar qubit to the system \
qubit ",
 StyleBox["j", "TI"],
 ". For the normalization calculation, we will use ",
 StyleBox["j", "TI"],
 " = -1 to apply the identity. ",
 StyleBox["7.",
  FontWeight->"Bold"],
 " From this step, we will \
\[OpenCurlyDoubleQuote]undo\[CloseCurlyDoubleQuote] our operations, first by \
applying ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["U", "TI"], 
   StyleBox["b", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "688d67fd-2a77-4fd5-18b3-7ea74f02153f"],
 ". ",
 StyleBox["8. ",
  FontWeight->"Bold"],
 "Apply the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["A", "TI"], 
   StyleBox["l", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "206ab830-fe85-388c-5069-327dfb318ad6"],
 " Controlled gate\[OpenCurlyQuote]s adjoint, which is the same as ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["A", "TI"], 
   StyleBox["l", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6259337f-42f1-dd99-1266-ab397685a7e3"],
 ". ",
 StyleBox["9.",
  FontWeight->"Bold"],
 " Last Hadamard gate for the Hadamard test At the end we apply a \
QuantumMeasureOperator to measure the expectation values."
}], "Text",
 CellID->1933047734,ExpressionUUID->"36c57d9d-81e8-42ea-5efb-74c7379d1030"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "LocalHadamardCircuit", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"LocalHadamardCircuit", "[", "j_", "]"}], " ", ":=", " ", 
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{
    RowBox[{"{", "\n", "   ", 
     RowBox[{
      RowBox[{"\"\<Hadamard\>\"", " ", "->", " ", 
       RowBox[{"{", "1", "}"}]}], ",", "\n", "   ", 
      RowBox[{"\"\<P\>\"", "[", "\[Theta]", "]"}], ",", "\n", "   ", 
      RowBox[{"VariationalBlock", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", "\n", "   ", 
      "ControlledAGate", ",", "\n", "   ", "Ub", ",", "\n", "   ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"MatchQ", "[", 
          RowBox[{"j", ",", " ", 
           RowBox[{"-", "1"}]}], "]"}]}], ",", " ", 
        RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "j"}], "}"}]}], ",", " ", "Nothing"}], "]"}],
       ",", "\n", "   ", "Ub", ",", "\n", "   ", "ControlledAGate", ",", "\n",
       "   ", 
      RowBox[{"\"\<Hadamard\>\"", " ", "->", " ", 
       RowBox[{"{", "1", "}"}]}], ",", "\n", "   ", 
      RowBox[{"QuantumMeasurementOperator", "[", 
       RowBox[{
        RowBox[{"\"\<Z\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", " ", 
        RowBox[{"{", "1", "}"}]}], "]"}]}], "\n", "   ", "}"}], ",", "\n", 
    "  ", 
    RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\[Theta]"}], 
      "}"}]}]}], "\n", "  ", "]"}]}]}], "Input",
 CellLabel->"In[302]:= ",
 CellID->391041503,ExpressionUUID->"45788596-5db6-3a96-7307-1cd0544088fc"],

Cell["\<\
You can test the multiple variations of the circuit for each controlled gate:\
\
\>", "Text",
 CellID->1791934732,ExpressionUUID->"6c54ae11-ac51-e949-146b-405ac5e5bb93"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LocalHadamardCircuit", "[", "2", "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]], "Input",
 CellLabel->"In[303]:= ",
 CellID->619223464,ExpressionUUID->"5d4030e4-6c2c-f7e9-0b7f-a9ce05dedd33"],

Cell["Optimized Circuit Implementation", "Text",
 CellID->1278113205,ExpressionUUID->"503b1edc-b945-4d24-01d8-978638f0140e"],

Cell["\<\
As you might notice, the past implementation might be slow if we want to \
obtain the expected value for each combination. Moreover, the local cost \
function that we will implement later to optimize will need to calculate the \
mean value multiple times.\
\>", "Text",
 CellID->462942992,ExpressionUUID->"0f836107-b46e-407e-35b1-79613d1b1344"],

Cell[TextData[{
 "Instead we could try to use the useful ",
 StyleBox["KroneckerProduct",
  FontWeight->"Bold"],
 " to build the same circuit with all the variations."
}], "Text",
 CellID->1674644155,ExpressionUUID->"267182e5-332f-0e8d-4e0e-1bcf46da54d7"],

Cell[TextData[{
 "We can re-implement ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"C", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "154e4ea8-041b-018f-4376-67f2adae53d5"],
 " gate, since it depends in which qubit it will be applied on:"
}], "Text",
 CellID->1967515850,ExpressionUUID->"16f6496c-6c93-397b-3e8e-613605278841"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ControlledGateZ", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j", ",", " ", "2"}], "]"}]}], " ", "+", " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j", ",", " ", "3"}], "]"}]}], " ", "+", " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", "\"\<I\>\"", "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j", ",", " ", 
         RowBox[{"-", "1"}]}], "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", 
      " ", "\"\<Controlled \!\(\*SubscriptBox[\(Z\), \(j\)]\) Gate\>\""}]}], 
    "\n", "   ", "]"}]}], ";"}]], "Input",
 CellLabel->"In[304]:= ",
 CellID->1251698388,ExpressionUUID->"2e61f31d-599e-ef91-561e-eb475828b5fb"],

Cell["\<\
As you might notice, we just apply a KroneckerDelta to get rid of the qubits \
we won\[CloseCurlyQuote]t be using for each case, this is possible since we \
already know how many qubits we are working on.\
\>", "Text",
 CellID->2105422338,ExpressionUUID->"591a22e5-07a0-ff20-0f39-bbcfb25ac20a"],

Cell["As the previous subsection, we implement the Hadamard test:", "Text",
 CellID->1436440935,ExpressionUUID->"352cfa2a-2f90-a2db-5cd3-fc744a2af021"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "LocalHadamardCircuit", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"LocalHadamardCircuit", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<Hadamard\>\"", " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<P\>\"", "[", "\[Theta]", "]"}], ",", "\n", "    ", 
       RowBox[{"VariationalBlock", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", "\n", "    ", 
       "ControlledAGate", ",", "\n", "    ", "Ub", ",", "\n", "    ", 
       "ControlledGateZ", ",", "\n", "    ", "Ub", ",", "\n", "    ", 
       "ControlledAGate", ",", "\n", "    ", 
       RowBox[{"\"\<Hadamard\>\"", " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}]}], "\n", "    ", "}"}], ",", " ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "j", ",", " ", 
        "\[Theta]"}], "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[305]:= ",
 CellID->701243115,ExpressionUUID->"76eee8f9-1f6f-e745-1e95-01a39a1bcdaf"],

Cell["Check out the newly implemented circuit diagram:", "Text",
 CellID->1684784208,ExpressionUUID->"5d128122-8bef-720a-0b21-188c2d9a4150"],

Cell[BoxData[
 RowBox[{"LocalHadamardCircuit", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]], "Input",
 CellLabel->"In[306]:= ",
 CellID->1139398047,ExpressionUUID->"04c061a2-1318-56b6-2cf0-780ca6ad3c9c"],

Cell["Local Cost Function", "Text",
 CellID->1083048344,ExpressionUUID->"4605043a-8429-851b-6e3a-9e642dddec61"],

Cell[TextData[{
 "You might noticed that we didn\[CloseCurlyQuote]t include the \
QuantumMeasurementOperator. In order to calculate even faster the mean \
values, we will calculate ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Phi]", "TI"]},
    "Bra"], 
   StyleBox["H", "TI"], 
   TemplateBox[{
     StyleBox["\[Phi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17a8a95e-16a9-5185-3d57-4118a35c23ef"],
 " where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]], "\[ThinSpace]", "\[CircleTimes]", "\|01d7d9", 
   "\[ThinSpace]", "\[CircleTimes]", "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6164d6ec-2035-6999-171b-cfb651c03be3"],
 ":"
}], "Text",
 CellID->510874127,ExpressionUUID->"6ca33e02-c939-75ea-1450-b06fe8cc5f30"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ket", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"LocalHadamardCircuit", "[", "]"}], "[", "\"\<StateVector\>\"", 
     "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[307]:= ",
 CellID->1156958958,ExpressionUUID->"22ebf147-b876-3430-52e8-e92139009f1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bra", " ", "=", " ", 
   RowBox[{"ConjugateTranspose", "[", "ket", "]"}]}], ";"}]], "Input",
 CellLabel->"In[308]:= ",
 CellID->1562142822,ExpressionUUID->"6cfbc0fa-05b7-6e65-1498-d9a4ac42354f"],

Cell[TextData[{
 "Finally we use the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"k", "e", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5726608a-327b-32d7-7ede-79d4470f803d"],
 " and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"b", "r", "a"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1988f3c5-ff1f-c744-4fb7-eaaefaabadae"],
 " obtained to calculate the expected value:"
}], "Text",
 CellID->1150706376,ExpressionUUID->"5f1f17bc-e58b-5e92-0524-8ef98c3e24f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<Z\>\"", " ", "->", " ", 
         RowBox[{"{", "1", "}"}]}], ",", " ", 
        RowBox[{"\"\<I\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}]}], "}"}], "]"}], 
     "[", "\"\<Matrix\>\"", "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[309]:= ",
 CellID->1352526937,ExpressionUUID->"5792d973-b7d4-8b8a-7da1-d13cc266d9d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LocalMean", " ", "=", " ", 
   RowBox[{"bra", " ", ".", " ", "H", " ", ".", " ", "ket"}]}], 
  ";"}]], "Input",
 CellLabel->"In[310]:= ",
 CellID->724680039,ExpressionUUID->"5edc8535-c3b1-a7f4-06e3-1d7ef6450dde"],

Cell["\<\
We just obtained the Symbolic Mean value of our circuit, in order to replace \
the variables quickly we define the following function:\
\>", "Text",
 CellID->1104706321,ExpressionUUID->"6224b0f8-da78-eb38-13db-29a5dff2b602"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "LocalMeanValues", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LocalMeanValues", "[", 
    RowBox[{
    "\[Omega]1_", ",", " ", "\[Omega]2_", ",", " ", "j_", ",", " ", 
     "\[Theta]_"}], "]"}], " ", "=", " ", "LocalMean"}], ";"}]}], "Input",
 CellLabel->"In[311]:= ",
 CellID->1815481970,ExpressionUUID->"41c93b30-61da-1cc4-77f6-b37a106f662e"],

Cell["\<\
Now we will implement all the functions needed for the cost function defined \
in the Theory section:\
\>", "Text",
 CellID->1081503572,ExpressionUUID->"50e14eb3-b435-065f-009f-67fd3dc06ca5"],

Cell[TextData[{
 "Define ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Mu]", "TI"], 
   RowBox[{
    StyleBox["l", "TI"], ",", 
    StyleBox["v", "TI"], ",", 
    StyleBox["j", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e168156-9322-bc9f-762d-191026d406e5"],
 " , note that you get Re[\[Mu]] when \[Theta] -> 0 and Im[\[Mu]] when \
\[Theta] -> ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox["\[Pi]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c24659b-7133-dc8c-65dc-7cc500c7a6d6"],
 ":"
}], "Text",
 CellID->1428038691,ExpressionUUID->"2c508251-7fc9-b51c-546f-241b7a7d1c66"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\[Mu]", "]"}], "\n", 
 RowBox[{
  RowBox[{"\[Mu]", "[", 
   RowBox[{"\[Omega]1_", ",", " ", "\[Omega]2_", ",", " ", "j_"}], "]"}], " ",
   ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Mu]Re", ",", " ", "\[Mu]Im"}], "}"}], ",", "\n", "  ", "\n", 
    "  ", 
    RowBox[{
     RowBox[{"\[Mu]Re", " ", "=", " ", 
      RowBox[{"LocalMeanValues", "[", 
       RowBox[{
       "\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "j", ",", " ", "0"}], 
       "]"}]}], ";", "\n", "  ", 
     RowBox[{"\[Mu]Im", " ", "=", " ", 
      RowBox[{"LocalMeanValues", "[", 
       RowBox[{"\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "j", ",", " ", 
        RowBox[{
         RowBox[{"-", "\[Pi]"}], "/", "2."}]}], "]"}]}], ";", "\n", "  ", 
     "\n", "  ", "\n", "  ", 
     RowBox[{"N", "[", 
      RowBox[{"\[Mu]Re", " ", "+", " ", 
       RowBox[{"j", "  ", "\[Mu]Im"}]}], "]"}]}]}], "\n", "  ", 
   "]"}]}]}], "Input",
 CellLabel->"In[312]:= ",
 CellID->308829509,ExpressionUUID->"1eef6872-bce7-1e04-4694-823c3492656e"],

Cell["Next, implement the normalization term:", "Text",
 CellID->301453637,ExpressionUUID->"30befcd9-b2cd-4711-6045-f582c7782a7b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "PsiNorm", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PsiNorm", "[", 
    RowBox[{"\[Omega]1_", ",", " ", "\[Omega]2_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Abs", "[", 
    RowBox[{"\[Mu]", "[", 
     RowBox[{"\[Omega]1", ",", " ", "\[Omega]2", ",", " ", 
      RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[313]:= ",
 CellID->584536085,ExpressionUUID->"75516dcf-8dc3-fc25-236e-84a92477c70f"],

Cell[TextData[{
 "Following the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["C", "TI"], 
   StyleBox["L", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0310a516-2392-3bde-312f-3d5056248924"],
 " equation, we define the cost function:"
}], "Text",
 CellID->1661522098,ExpressionUUID->"1f6c7faf-a6fa-97ca-4514-7608d28cfd10"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "LocalCost", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"LocalCost", "[", 
   RowBox[{"\[Omega]1_", ",", " ", "\[Omega]2_"}], "]"}], " ", ":=", " ", 
  "\n", " ", 
  RowBox[{"0.5", " ", "-", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"0.5", "/", 
      RowBox[{"(", "\n", "    ", 
       RowBox[{"3", " ", 
        RowBox[{"PsiNorm", "[", 
         RowBox[{"\[Omega]1", ",", " ", "\[Omega]2"}], "]"}]}], ")"}]}], 
     ")"}], " ", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"\[Mu]", "[", 
       RowBox[{
       "\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "\n", "      ", "2"}], 
       "]"}], " ", "+", " ", 
      RowBox[{"\[Mu]", "[", 
       RowBox[{"\[Omega]1", ",", " ", "\[Omega]2", ",", " ", "3"}], "]"}]}], 
     "]"}]}]}]}]}], "Input",
 CellLabel->"In[314]:= ",
 CellID->210190278,ExpressionUUID->"2573a629-b9de-50ac-5300-3873386b22f6"],

Cell["Symbolic Cost Function Optimization", "Text",
 CellID->690302512,ExpressionUUID->"59197c34-7185-90b0-0f27-767e0031e29a"],

Cell["\<\
Let\[CloseCurlyQuote]s calculate the symbolic equation for the cost function. \
It is not that huge of an expression, but surely not visually pleasant to \
show here:\
\>", "Text",
 CellID->280481820,ExpressionUUID->"2c633381-a2a9-ed02-5410-aaead75db468"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "LocalCostFunction", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LocalCostFunction", "[", 
     RowBox[{"\[Omega]1_", ",", " ", "\[Omega]2_"}], "]"}], " ", "=", " ", 
    "\n", "   ", 
    RowBox[{"Simplify", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"LocalCost", "[", 
       RowBox[{"\[Omega]1", ",", " ", "\[Omega]2"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Omega]1", ",", " ", "\[Omega]2"}], "}"}], " ", "\[Element]",
        " ", "\n", "     ", "Reals"}]}], "]"}]}], ";"}], " ", "//", " ", 
  "AbsoluteTiming"}]}], "Input",
 CellLabel->"In[315]:= ",
 CellID->231520216,ExpressionUUID->"60c43628-0d8b-12d9-10fb-a872a43e6023"],

Cell[TextData[{
 "Since we have the symbolic function, we can use ",
 StyleBox["NMinize",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellID->637731119,ExpressionUUID->"5f555f5b-d3f6-518f-056b-5704e58323d5"],

Cell[BoxData[
 RowBox[{"GradientParameters", " ", "=", " ", "\n", " ", 
  RowBox[{"NMinimize", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"LocalCostFunction", "[", 
     RowBox[{"\[Omega]1", ",", " ", "\[Omega]2"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Omega]1", ",", " ", "\[Omega]2"}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[316]:= ",
 CellID->1463122338,ExpressionUUID->"3145b7cb-6bdc-88b3-677a-2e950e6eda99"],

Cell["Numerical Cost Function Optimization", "Text",
 CellID->1692228194,ExpressionUUID->"6b7074b7-b7c4-ad31-1900-6df0c276f41b"],

Cell["\<\
We can use our previously defined LocalCost for numerical calculations using \
a numerical gradient descent:\
\>", "Text",
 CellID->1726817321,ExpressionUUID->"6b848cdb-7c95-016b-19bb-2585752053b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Omega]", " ", "=", " ", 
   RowBox[{"0.001", " ", "*", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", "]"}], ",", " ", "2"}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[317]:= ",
 CellID->1497793531,ExpressionUUID->"479e0012-80c3-e229-6da5-9a5c3177b173"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NGradientParameters", " ", "=", " ", "\n", "   ", 
    RowBox[{"GradientDescent", "[", 
     RowBox[{"LocalCost", ",", " ", "\[Omega]", ",", " ", 
      RowBox[{"\"\<LearningRate\>\"", " ", "->", " ", "0.8"}], ",", " ", "\n",
       "    ", 
      RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "15"}]}], "]"}]}], 
   ";"}], " ", "//", " ", "AbsoluteTiming"}]], "Input",
 CellLabel->"In[318]:= ",
 CellID->656729387,ExpressionUUID->"3d6e3eb6-fa93-dc86-6b15-b7f3ff27a6ec"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"LocalCostFunction", " ", "@@@", " ", "NGradientParameters"}], ",",
    " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", "\n", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Optimization steps\>\"", ",", 
      " ", "\"\<Cost Function Value\>\""}], "}"}]}], ",", " ", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{
    "{", "\"\<1 \[Dash] \[VerticalSeparator]\!\(\*TemplateBox[{\\\"b\\\", \
\\\"\[Psi]\\\"},\n\
\\\"BraKet\\\"]\)\!\(\*SuperscriptBox[\(\[VerticalSeparator]\), \(2\)]\)\>\"",
      "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[319]:= ",
 CellID->1783615158,ExpressionUUID->"43bbad2d-592e-7807-7158-457758db4b6d"],

Cell["Classical Linear System Solving", "Text",
 CellID->2093360215,ExpressionUUID->"6945d0ce-c536-08cf-1f7a-c9abecc35a15"],

Cell[TextData[{
 "We can build the ",
 StyleBox["A", "TI"],
 " matrix and state",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["b", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fccf01f-c27b-aa81-65f3-ea58f70ff8eb"],
 "of the present problem:"
}], "Text",
 CellID->2146948930,ExpressionUUID->"580a63e8-e8bd-fc69-080a-7ab58949c6b3"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   SubscriptBox[
    StyleBox["X", "TI"], "2"], 
   SubscriptBox[
    StyleBox["H", "TI"], "3"]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1473052984,ExpressionUUID->"1e444979-635e-5aae-467c-612316eb28f4"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     StyleBox["b", "TI"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["U", "TI"], 
     TemplateBox[{"0"},
      "Ket"]}], "=", 
    RowBox[{
     SubscriptBox[
      StyleBox["H", "TI"], "2"], 
     SubscriptBox[
      StyleBox["H", "TI"], "3"], 
     TemplateBox[{"0"},
      "Ket"]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1377776473,ExpressionUUID->"5291a49d-a239-bb17-02ae-3dc6d7cd067d"],

Cell["\<\
Solve the system by operating over the correspondant matrices:\
\>", "Text",
 CellID->1871424593,ExpressionUUID->"2ed3e0f7-5290-ff26-56e0-f9b1672ac20c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", 
     RowBox[{"HadamardMatrix", "[", "2", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", " ", "=", " ", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"Sqrt", "[", "8", "]"}]}], ",", " ", "4"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<A\>\"", " ", "->", " ", 
    RowBox[{"MatrixForm", "[", "A", "]"}]}], ",", " ", "\n", " ", 
   RowBox[{"\"\<\!\(\*TemplateBox[{\\\"b\\\"},\n\\\"Ket\\\"]\)\>\"", " ", "->",
     " ", 
    RowBox[{"MatrixForm", "[", "b", "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[320]:= ",
 CellID->435854031,ExpressionUUID->"5e38d601-1464-7519-07c7-c86b9d115c63"],

Cell["Finally, compute the probabilities:", "Text",
 CellID->1287273958,ExpressionUUID->"0fc3dc78-1302-6f10-35f0-d622a6b7327a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"LinearSystemResult", " ", "=", " ", 
   RowBox[{
    RowBox[{"Normalize", "[", 
     RowBox[{"LinearSolve", "[", 
      RowBox[{"A", ",", " ", "b"}], "]"}], "]"}], "^", "2"}]}], ";"}], "\n", 
 RowBox[{"Thread", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Ket", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Delete", "[", "0", "]"}], "@", "#"}], "}"}], "]"}], " ", 
     "&"}], " ", "/@", " ", 
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<0\>\"", ",", " ", "\"\<1\>\""}], "}"}], ",", " ", "2"}], 
     "]"}]}], " ", "->", " ", "\n", "  ", "LinearSystemResult"}], 
  "]"}]}], "Input",
 CellLabel->"In[321]:= ",
 CellID->1653105675,ExpressionUUID->"4a61f55e-757a-9228-7a1e-ed187c0ce172"],

Cell["Symbolic & Numeric Quantum Circuit Result", "Text",
 CellID->1865792612,ExpressionUUID->"792e178f-59c5-2aa3-28d5-8ee958707889"],

Cell["\<\
Test the Variational circuit with the optimized parameters results:\
\>", "Text",
 CellID->1858808141,ExpressionUUID->"106526ab-6ace-99f4-401a-bff50f78ebde"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VariationalMeasurement", " ", "=", " ", "\n", "  ", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{"VariationalBlock", ",", " ", 
       RowBox[{"{", "1", "}"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "}"}], "]"}], "[", "]"}]}], ";"}]], "Input",\

 CellLabel->"In[322]:= ",
 CellID->2108559044,ExpressionUUID->"14f1cae1-901f-fe6e-3c8e-e3cb21abc4b4"],

Cell["The symbolic optimization resultant probabilities:", "Text",
 CellID->298754920,ExpressionUUID->"20e5bc00-ef5d-9182-509a-366d8ae9e3e8"],

Cell[BoxData[
 RowBox[{"SymbolicResult", " ", "=", " ", "\n", " ", 
  RowBox[{
   RowBox[{"VariationalMeasurement", "[", 
    RowBox[{"Association", "[", 
     RowBox[{"GradientParameters", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "[", "\n", 
   "  ", "\"\<Probabilities\>\"", "]"}]}]], "Input",
 CellLabel->"In[323]:= ",
 CellID->647382752,ExpressionUUID->"0eb778b1-5bb9-ca6f-364d-71fb5e4d98b5"],

Cell["The numerical optimization resultant probabilities:", "Text",
 CellID->1787413975,ExpressionUUID->"60fa5ffe-638f-3fb5-109a-56b8163b859f"],

Cell[BoxData[
 RowBox[{"NumericalResult", " ", "=", " ", "\n", " ", 
  RowBox[{
   RowBox[{"VariationalMeasurement", "[", "\n", "   ", 
    RowBox[{"AssociationThread", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Omega]1", ",", " ", "\[Omega]2"}], "}"}], ",", " ", 
      RowBox[{"Last", "@", "NGradientParameters"}]}], "]"}], "]"}], "[", "\n",
    "  ", "\"\<Probabilities\>\"", "]"}]}]], "Input",
 CellLabel->"In[324]:= ",
 CellID->298599682,ExpressionUUID->"730b2763-752d-95c0-2108-bf4d7cd9ff2a"],

Cell["\<\
We can calculate how different one distribution is from another using a \
Kolmogorov Smirnov Test:\
\>", "Text",
 CellID->497882556,ExpressionUUID->"1fb8ba9f-9118-d887-4547-33d92092aaed"],

Cell[BoxData[
 RowBox[{"KolmogorovSmirnovTest", "[", 
  RowBox[{
   RowBox[{"Values", "@", "SymbolicResult"}], ",", " ", 
   "LinearSystemResult"}], "]"}]], "Input",
 CellLabel->"In[325]:= ",
 CellID->1373294390,ExpressionUUID->"04257d5a-c533-40c1-2ddb-7507ecc6122b"],

Cell[BoxData[
 RowBox[{"KolmogorovSmirnovTest", "[", 
  RowBox[{
   RowBox[{"Values", "@", "NumericalResult"}], ",", " ", 
   "LinearSystemResult"}], "]"}]], "Input",
 CellLabel->"In[326]:= ",
 CellID->784314976,ExpressionUUID->"3e9a3b8c-0d9b-39c6-66b9-b2d6a42f8b2c"],

Cell["\<\
In this case, the number is considered big enough to indicate that the \
results are from the reference distribution.\
\>", "Text",
 CellID->326763740,ExpressionUUID->"57c094f8-e1f7-16c3-7dff-0da597827c29"],

Cell["Let\[CloseCurlyQuote]s plot the probabilities for a visual \
comparison:", "Text",
 CellID->1720985320,ExpressionUUID->"53c10e17-89f4-5846-01fe-a0512f812aac"],

Cell[BoxData[
 RowBox[{"BarChart", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"LinearSystemResult", ",", " ", 
      RowBox[{"Values", "@", "SymbolicResult"}], ",", " ", "\n", "   ", 
      RowBox[{"Values", "@", "NumericalResult"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"ChartLayout", " ", "->", " ", "\"\<Grouped\>\""}], ",", " ", "\n",
    " ", 
