Cell["Cost Function", "Text",
 CellID->2100571609,ExpressionUUID->"31701ca2-f4c0-d723-670f-950ffd7aba09"],

Cell[TextData[{
 "We are recovering our results from state\[CloseCurlyQuote]s amplitudes and \
there are some consideration to take on account. The cost function ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42383645-cae2-5342-73c7-a82eee9721a8"],
 " we defined previously depends heavily on the quantum fidelity from b and \
",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b11b9e5-bb8f-782a-392e-30cf3e3a4b70"],
 " states:"
}], "Text",
 CellID->1651408966,ExpressionUUID->"49614dfc-87d5-9726-7f1f-64a63261fa0c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Omega]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    RowBox[{"0", "\[LeftRightArrow]", "\[ScriptCapitalF]"}], "=", 
    RowBox[{
     RowBox[{GridBox[{
        {
         TemplateBox[{
           StyleBox["b", "TI"], 
           RowBox[{
             StyleBox["\[Psi]", "TI"], 
             StyleBox["(", SpanMaxSize -> 1], 
             SubscriptBox[
              StyleBox["\[Omega]", "TI"], 
              RowBox[{
                StyleBox["o", "TI"], 
                StyleBox["p", "TI"], 
                StyleBox["t", "TI"]}]], 
             StyleBox[")", SpanMaxSize -> 1]}]},
          "BraKet"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], 
      SuperscriptBox["", "2"]}], "=", "1"}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1504094613,ExpressionUUID->"4eaeef1c-70dd-f5e5-7655-07460169dfcf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CostFunction", "[", 
    RowBox[{"v1_", ",", " ", "v2_", ",", " ", "v3_", ",", " ", "v4_"}], "]"}],
    " ", ":=", "\n", "  ", 
   RowBox[{"QuantumDistance", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumState", "[", "b", "]"}], "[", "\"\<Normalize\>\"", 
      "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\[Psi]", "[", 
       RowBox[{"v1", ",", " ", "v2", ",", " ", "v3", ",", " ", "v4"}], "]"}], 
      "[", "\"\<Normalize\>\"", "]"}], ",", " ", "\n", 
     "   ", "\"\<Fidelity\>\""}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[411]:= ",
 CellID->1962444873,ExpressionUUID->"5ab084b1-712e-e46c-0a4f-1dfb00d8ceb6"],

Cell[TextData[{
 "The cost function minimization ensures that the probability distributions \
of ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "009434ca-e8a5-36b3-30ab-ad9789519c99"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a229ce6-e7c6-f6b5-5bd1-15c39270dc9f"],
 " are identical, such that:"
}], "Text",
 CellID->768789606,ExpressionUUID->"56ef6f30-06fe-ca48-7e94-877ab2889892"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(", SpanMaxSize -> 1], 
       SubscriptBox[
        StyleBox["\[Omega]", "TI"], 
        RowBox[{
          StyleBox["o", "TI"], 
          StyleBox["p", "TI"], 
          StyleBox["t", "TI"]}]], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Ket"], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox[
      RowBox[{"i", "\[Phi]"}], "TI"]], 
    TemplateBox[{
      StyleBox["b", "TI"]},
     "Ket"]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->208826253,ExpressionUUID->"3d7e8caf-dec1-3276-6b05-2508db75815c"],

Cell["\<\
In other words, this cost function does not ensure that the amplitudes of \
both states are identical, but rather that they are proportional by a global \
phase:\
\>", "Text",
 CellID->452759606,ExpressionUUID->"2a4b2e91-3e68-2f67-5a48-c7dbbb1d724d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"], "=", 
    RowBox[{
     StyleBox["\[Sum]",
      FontSize->1.4 Inherited], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], 
       StyleBox["i", "TI"]], 
      TemplateBox[{
        StyleBox["i", "TI"]},
       "Ket"]}]}]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    TemplateBox[{
      StyleBox["b", "TI"]},
     "Ket"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       StyleBox["\[Sum]",
        FontSize->1.4 Inherited], 
       RowBox[{
        SubscriptBox[
         StyleBox["\[Beta]", "TI"], 
         StyleBox["i", "TI"]], 
        TemplateBox[{
          StyleBox["i", "TI"]},
         "Ket"]}]}], "\[NonBreakingSpace]\[NonBreakingSpace]", "\[Rule]", 
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], 
       StyleBox["i", "TI"]]}], "=", 
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       StyleBox[
        RowBox[{"i", "\[Phi]"}], "TI"]], 
      SubscriptBox[
       StyleBox["\[Beta]", "TI"], 
       StyleBox["i", "TI"]]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1647313933,ExpressionUUID->"2e070ed5-18e9-e926-563c-a79f989db80c"],

Cell[TextData[{
 "In order to correct our result, we need to find the global phase and apply \
it along with the normalization terms for both ",
 StyleBox["b", "TI"],
 " and ",
 StyleBox["m", "TI"],
 " once our calculation is done such that:"
}], "Text",
 CellID->1505075130,ExpressionUUID->"7866ed4e-196e-bd16-281d-05289818047c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox[
     RowBox[{"s", "o", "l"}], "TI"]], "=", 
   FractionBox["1", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox[
      RowBox[{"i", "\[Phi]"}], "TI"]]], 
   FractionBox[GridBox[{
      {GridBox[{
         {
          StyleBox["b", "TI"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], GridBox[{
      {GridBox[{
         {
          StyleBox["m", "TI"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}]], 
   StyleBox["x", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox[
     RowBox[{"o", "p", "t"}], "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->113906083,ExpressionUUID->"5d58b19a-61e1-4a53-0b67-28c4179418b9"],

Cell["Algorithm Implementation", "Subsubsection",
 CellID->898018343,ExpressionUUID->"039e17dc-7135-1c98-31a5-8e8600c066e2"],

Cell["Initial problem setup", "Text",
 CellID->813813308,ExpressionUUID->"76f331b0-e4d2-d206-1e80-a8fd8d64a16c"],

Cell[TextData[{
 "In order to implement this algorithm, we will start coding a simple example \
using a random vector ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5aa658dd-12e3-7f58-0a5e-5187a69645a2"],
 " and a random ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a3641b-c972-205a-5351-7e44e80772a0"],
 " matrix:"
}], "Text",
 CellID->628460354,ExpressionUUID->"0d85d5e7-830f-4689-3bba-ccc136ba2cd3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"matrixA", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[412]:= ",
 CellID->1926105532,ExpressionUUID->"06d28d0f-e448-85b2-2ee1-25688de2ef98"],

Cell[BoxData[
 RowBox[{"matrixA", " ", "//", " ", "MatrixForm"}]], "Input",
 CellLabel->"In[413]:= ",
 CellID->221703818,ExpressionUUID->"51b905fb-db49-ff7a-0746-9ca4defdc240"],

Cell[BoxData[
 RowBox[{"vectorb", " ", "=", " ", 
  RowBox[{"RandomReal", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "0.1"}], ",", " ", 
      RowBox[{"+", "0.1"}]}], "}"}], ",", " ", "4"}], "]"}]}]], "Input",
 CellLabel->"In[414]:= ",
 CellID->1996350181,ExpressionUUID->"1f015443-b004-ded7-453f-4e2cc1b6a43d"],

Cell["\<\
We need to save the normalization terms, since we will be working with the \
normalized matrix and vector:\
\>", "Text",
 CellID->572509570,ExpressionUUID->"79dc6473-7f99-4552-2fe4-7e3d7a2c2fb8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"normA", " ", "=", " ", 
   RowBox[{"Norm", "[", "matrixA", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"normb", " ", "=", " ", 
   RowBox[{"Norm", "[", "vectorb", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[415]:= ",
 CellID->1323500507,ExpressionUUID->"74d8dc7d-61a6-0fac-1ce7-d627105355f6"],

Cell[TextData[{
 "In later steps, we will refer to ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "254b6ea2-640f-5114-5348-870c0dba207e"],
 " and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["A", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a37b9ca-0c89-88bb-7bcc-3094a53dda81"],
 " as the normalized vector ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57618033-75bd-c863-7d1e-1a7d7c499b49"],
 " and matrix ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b228fec-7489-5fb6-4ad1-26b67d3c259c"],
 ", respectively. Then the solution for the ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["A", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15cf7838-770d-10a7-43f5-726202b8628d"],
 " and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b95bd50-7b57-adaf-39aa-351a7ee3f7f5"],
 " problem would be called ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox[
     RowBox[{"o", "p", "t"}], "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "216b1f6b-5cec-53ab-5768-9735549921f1"],
 ". Applying ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16ee990f-09f0-daa5-3e95-1169af8aa88f"],
 " and ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00067b34-c3cd-1811-303e-7371f6786b7b"],
 " normalization terms will help us recover the original ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], ".", 
   RowBox[{
    StyleBox["x", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Theta]", "TI"], 
     StyleBox[
      RowBox[{"o", "p", "t"}], "TI"]], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["b", "TI"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2db117d6-0b72-000c-5b4e-8e90ae075356"],
 " solution."
}], "Text",
 CellID->471443154,ExpressionUUID->"68a1b4b4-f7f8-1850-185e-2df1818d6aba"],

Cell["Multiplexer implementation", "Text",
 CellID->272971860,ExpressionUUID->"666da514-18bd-d59b-0e12-3d5e9949bfe1"],

Cell[TextData[{
 "First, we need to decompose ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["A", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29592712-3b20-e448-5f66-bf5cbedace92"],
 " in Pauli matrices such that ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["A", "TI"], "^"], "=", 
   StyleBox["\[Sum]",
    FontSize->1.15 Inherited], 
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22115567-c1d8-2747-522f-4d40f0528dad"],
 ":"
}], "Text",
 CellID->1407781111,ExpressionUUID->"6b71a00b-a0b6-756c-190e-3a54d1435fb6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pauliDecompose", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"matrixA", "/", "normA"}], "]"}], "[", "\"\<PauliDecompose\>\"", 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[416]:= ",
 CellID->1716884206,ExpressionUUID->"79f35eab-5065-8c8a-2f81-57f56111d6d0"],

Cell[BoxData["pauliDecompose"], "Input",
 CellLabel->"In[417]:= ",
 CellID->1585376427,ExpressionUUID->"6cbd088d-a6f8-eb62-1442-a1d6d372b648"],

Cell["Next, implement the multiplexer:", "Text",
 CellID->928209393,ExpressionUUID->"71854dcf-cc44-2a9b-27bb-64a8e5f178e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"multiplexer", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<Multiplexer\>\"", " ", "@@", " ", 
     RowBox[{"Keys", "[", "pauliDecompose", "]"}]}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[418]:= ",
 CellID->615959215,ExpressionUUID->"412c5b26-c47d-b90f-70d4-5283ed090855"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ancillary", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"Sqrt", "@", 
      RowBox[{"Values", "[", "pauliDecompose", "]"}]}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", 
      " ", "\"\<\!\(\*SqrtBox[\(c\)]\)\>\""}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[419]:= ",
 CellID->1102495055,ExpressionUUID->"5f352ef2-4ae2-2c59-06ca-c7bc6e9776a3"],

Cell["\<\
We obtain the first section of the variational circuit for the VQLS:\
\>", "Text",
 CellID->1407528526,ExpressionUUID->"0d7f7a51-5ff5-70fd-3b05-7c1b598042c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qlscircuit", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{"ancillary", ",", "\n", "    ", "multiplexer", ",", "\n", "    ", 
      RowBox[{"SuperDagger", "[", 
       RowBox[{"(", 
        RowBox[{"ancillary", "[", "\"\<Conjugate\>\"", "]"}], ")"}], "]"}]}], 
     "\n", "    ", "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[420]:= ",
 CellID->355841406,ExpressionUUID->"3089d968-2504-f1ea-60b6-d1324cb6c330"],

Cell[BoxData[
 RowBox[{"qlscircuit", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Full"}]}], "]"}]], "Input",
 CellLabel->"In[421]:= ",
 CellID->221681971,ExpressionUUID->"2b65a66f-d41b-de4c-591a-3848ddafa496"],

Cell["General symbolic ansatz", "Text",
 CellID->1571803998,ExpressionUUID->"428af588-0a0e-1d2d-7289-ecd2afbb6477"],

Cell[TextData[{
 "Define a general state ansatz for 4-qubits with real amplitudes. Remember \
we are working with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64da9960-6030-4ffa-0cf9-114a11c515c0"],
 " instead of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c687fea-7568-041a-1468-76b47c1d6f60"],
 "; label it so we do not forget about it:"
}], "Text",
 CellID->398806204,ExpressionUUID->"0cbccda1-a060-0aa2-3443-e40ad1155888"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"parameters", " ", "=", " ", 
   RowBox[{"GenerateParameters", "[", 
    RowBox[{"1", ",", " ", "4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ansatz", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"parameters", ",", " ", "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", 
      " ", "\"\<\!\(\*OverscriptBox[\(x\), \(^\)]\)(\[Theta])\>\""}], ",", 
     " ", "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", "parameters"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[422]:= ",
 CellID->447014937,ExpressionUUID->"447fe503-da77-e068-6c04-fd6cdf03b2b2"],

Cell[BoxData[
 RowBox[{"ansatz", "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[423]:= ",
 CellID->673499299,ExpressionUUID->"708a530c-476f-43a5-208a-4b56721a118f"],

Cell["\<\
Finally, we implement the circuit and the correspondent state:\
\>", "Text",
 CellID->474151483,ExpressionUUID->"7c4be775-fc25-beb3-2448-ff3ef5d10499"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vqlscircuit", " ", "=", " ", 
   RowBox[{"qlscircuit", "[", 
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"ansatz", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "6"}], "}"}]}], "]"}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[424]:= ",
 CellID->73102581,ExpressionUUID->"144f2f1f-85ce-1d43-3c74-c7592c7b67a9"],

Cell[BoxData[
 RowBox[{"vqlscircuit", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]], "Input",
 CellLabel->"In[425]:= ",
 CellID->109545521,ExpressionUUID->"6c6a609e-b44f-cf74-146a-79d83dfb925e"],

Cell["\<\
Wolfram Quantum Framework quantum states (and measurements) keep the \
parameters defined in previously used circuits, so it would be optimum to \
work with the resultant state:\
\>", "Text",
 CellID->981617102,ExpressionUUID->"25b14c23-2eb1-df26-534f-658d4b45a20c"],

Cell[BoxData[
 RowBox[{"\[Psi]", " ", "=", " ", 
  RowBox[{"vqlscircuit", "[", "]"}]}]], "Input",
 CellLabel->"In[426]:= ",
 CellID->485382558,ExpressionUUID->"008546a0-c650-abb4-30bb-5f0df3eaf99e"],

Cell[TextData[{
 "We can perform a first test to obtain ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Psi]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox[
      RowBox[{"i", "n", "i", "t"}], "TI"]], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    OverscriptBox[
     StyleBox["A", "TI"], "^"]}], ".", 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Theta]", "TI"], 
     StyleBox[
      RowBox[{"i", "n", "i", "t"}], "TI"]], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25dc0687-8bfe-aded-53e3-9fe12d88f737"],
 ":"
}], "Text",
 CellID->470071966,ExpressionUUID->"39ea782b-3727-74ef-6fea-727542d25e35"],

Cell[BoxData[
 RowBox[{"init", " ", "=", " ", 
  RowBox[{"Normalize", "[", 
   RowBox[{"0.01", "*", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", "]"}], ",", " ", "4"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[427]:= ",
 CellID->1590549955,ExpressionUUID->"0337beb4-3f4a-26a7-32cc-37febafc8c8d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]", "[", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{"parameters", " ", "->", " ", "init"}], "]"}], "]"}], 
  "[", "\"\<Table\>\"", "]"}]], "Input",
 CellLabel->"In[428]:= ",
 CellID->842792881,ExpressionUUID->"19027a34-c886-4faa-4f32-7c71e93315f0"],

Cell[TextData[{
 "As we can see, it is not close enough to ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a07d01d-1b7c-2a0f-6a3c-ca479e097955"],
 " in order to call it a good approximation:"
}], "Text",
 CellID->1520894056,ExpressionUUID->"27ef5936-9de9-9a7d-4d95-51701b9de947"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"vectorb", "/", "normb"}], "]"}], "[", "\"\<Table\>\"", 
  "]"}]], "Input",
 CellLabel->"In[429]:= ",
 CellID->1253718345,ExpressionUUID->"61b66095-ece2-945e-174e-79de8494fea4"],

Cell["Optimization", "Text",
 CellID->1606449838,ExpressionUUID->"5d61acce-ca29-858f-0b1e-45abefddefd5"],

Cell["\<\
Implement the cost functions previously defined, remember to use the \
normalized vector b:\
\>", "Text",
 CellID->97592725,ExpressionUUID->"337dac42-7f47-0b68-6102-462c7af259b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qb", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"vectorb", "/", "normb"}], "]"}], "[", "\"\<Normalize\>\"", 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[430]:= ",
 CellID->537918325,ExpressionUUID->"3b31e76a-9cc9-3dd2-6ace-ff34157d8738"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fidelity", "[", 
    RowBox[{"v1_", ",", " ", "v2_", ",", " ", "v3_", ",", " ", "v4_"}], "]"}],
    " ", ":=", " ", "\n", "  ", 
   RowBox[{"QuantumDistance", "[", 
    RowBox[{"qb", ",", " ", 
     RowBox[{
      RowBox[{"\[Psi]", "[", 
       RowBox[{"v1", ",", " ", "v2", ",", " ", "v3", ",", " ", "v4"}], "]"}], 
      "[", "\"\<Normalize\>\"", "]"}], ",", " ", "\"\<Fidelity\>\""}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[431]:= ",
 CellID->1874332293,ExpressionUUID->"0462e13d-5914-5391-2c11-f96758a121fb"],

Cell[TextData[{
 "Now, let\[CloseCurlyQuote]s optimize the cost function using ",
 StyleBox["FindMinimum",
  FontWeight->"Bold"],
 ", with our initial guess as the starting point:"
}], "Text",
 CellID->2119658773,ExpressionUUID->"5fafb436-a125-8572-0554-2e73d0d1ec58"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ip", " ", "=", " ", 
   RowBox[{"Thread", "[", 
    RowBox[{"{", 
     RowBox[{"parameters", ",", " ", "init"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"optFM", " ", "=", " ", 
    RowBox[{"FindMinimum", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"fidelity", "[", 
       RowBox[{
       "\[Theta]1", ",", " ", "\[Theta]2", ",", " ", "\[Theta]3", ",", " ", 
        "\[Theta]4"}], "]"}], ",", " ", "\n", "    ", "ip"}], "]"}]}], ";"}], 
  " ", "//", " ", "Quiet"}]}], "Input",
 CellLabel->"In[432]:= ",
 CellID->2057843125,ExpressionUUID->"5937c2c5-33c1-e073-08cc-dbaf4675b359"],

Cell[BoxData["optFM"], "Input",
 CellLabel->"In[433]:= ",
 CellID->918597756,ExpressionUUID->"0f5c2ef4-7109-f5b8-3563-c7be00bddf82"],

Cell[TextData[{
 "As we can see, ",
 StyleBox["FindMinimum",
  FontWeight->"Bold"],
 " is having some difficulty finding the minimal value, so we might switch to \
",
 StyleBox["NMinimize",
  FontWeight->"Bold"],
 ", which will return a value for the cost function that is very close to \
zero:"
}], "Text",
 CellID->37768681,ExpressionUUID->"249f21f6-b74e-bacc-4ca4-b8b3c2f80816"],

Cell[BoxData[
 RowBox[{
  RowBox[{"optNM", " ", "=", " ", 
   RowBox[{"NMinimize", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"fidelity", "[", 
      RowBox[{
      "\[Theta]1", ",", " ", "\[Theta]2", ",", " ", "\[Theta]3", ",", " ", 
       "\[Theta]4"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Theta]1", ",", " ", 
       RowBox[{"\\\n", "\[Theta]2"}], ",", " ", "\[Theta]3", ",", " ", 
       "\[Theta]4"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[434]:= ",
 CellID->1890403329,ExpressionUUID->"6d7028df-510c-978f-1b0f-c19960befdd5"],

Cell[BoxData["optNM"], "Input",
 CellLabel->"In[435]:= ",
 CellID->1091040064,ExpressionUUID->"67e8013d-d0f3-07d6-0d97-9966e0866d3c"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s compare the probability distribution of ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["\[Psi]", "TI"], 
      StyleBox["(", SpanMaxSize -> 1], 
      StyleBox["\[Theta]", "TI"], 
      StyleBox[")", SpanMaxSize -> 1]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aeb0016-a16b-917c-5ae8-9a53d01fe046"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["b", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e2a9277-acfe-a475-1629-1430c4880f5f"],
 " probability distributions:"
}], "Text",
 CellID->1505553003,ExpressionUUID->"7757f304-1d73-ea00-1d6c-eb6e9407b96a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Dataset", "[", 
   RowBox[{"<|", "\n", "   ", 
    RowBox[{
     RowBox[{"\"\<\!\(\*TemplateBox[{\\\"\[Psi]\\\"},\n\\\"Ket\\\"]\)\>\"", 
      " ", "->", " ", 
      RowBox[{
       RowBox[{"\[Psi]", "[", 
        RowBox[{"<|", "\n", "       ", 
         RowBox[{"Last", "[", "optNM", "]"}], "|>"}], "]"}], 
       "[", "\"\<Probabilities\>\"", "]"}]}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<\!\(\*TemplateBox[{\\\"b\\\"},\n\\\"Ket\\\"]\)\>\"", " ", "->",
       " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumState", "[", 
        RowBox[{"vectorb", "/", "normb"}], "]"}], "[", "\"\<Probabilities\>\"",
        "]"}]}]}], "|>"}], "]"}], " ", "//", " ", "Transpose"}]], "Input",
 CellLabel->"In[436]:= ",
 CellID->2047217867,ExpressionUUID->"3fa4a1ef-0881-bd46-655b-38c9a93507ac"],

Cell["\<\
As we can notice, the values are quite close! However, as mentioned earlier, \
while the probability distributions match, the amplitudes do not necessarily \
align:\
\>", "Text",
 CellID->2146809527,ExpressionUUID->"6f9797aa-fa32-a424-15ac-0ef7ffc40f0e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Dataset", "[", 
   RowBox[{"<|", "\n", "   ", 
    RowBox[{
     RowBox[{"\"\<\!\(\*TemplateBox[{\\\"\[Psi]\\\"},\n\\\"Ket\\\"]\)\>\"", 
      " ", "->", " ", 
      RowBox[{
       RowBox[{"\[Psi]", "[", 
        RowBox[{"<|", "\n", "       ", 
         RowBox[{"Last", "[", "optNM", "]"}], "|>"}], "]"}], 
       "[", "\"\<Amplitudes\>\"", "]"}]}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<\!\(\*TemplateBox[{\\\"b\\\"},\n\\\"Ket\\\"]\)\>\"", " ", "->",
       " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumState", "[", 
        RowBox[{"vectorb", "/", "normb"}], "]"}], "[", "\"\<Amplitudes\>\"", 
       "]"}]}]}], "|>"}], "]"}], " ", "//", " ", "Transpose"}]], "Input",
 CellLabel->"In[437]:= ",
 CellID->850571759,ExpressionUUID->"73356d58-d9e6-c51e-22ca-8505df90ac64"],

Cell[TextData[{
 "This is basically is saying that we found ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox[
     RowBox[{"o", "p", "t"}], "TI"]], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "\[Phi]"}], "TI"]], 
   OverscriptBox[
    StyleBox["b", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ecebc9e-fbf5-4932-26f5-35dbfd801818"],
 ":"
}], "Text",
 CellID->1888811941,ExpressionUUID->"5942b0b3-6f6e-6b43-0f71-29fd0a1b39a9"],

Cell[BoxData[
 RowBox[{"opt\[Psi]", " ", "=", " ", 
  RowBox[{
   RowBox[{"\[Psi]", "[", 
    RowBox[{"<|", 
     RowBox[{"Last", "@", "optNM"}], "|>"}], "]"}], 
   "[", "\"\<AmplitudesList\>\"", "]"}]}]], "Input",
 CellLabel->"In[438]:= ",
 CellID->643875206,ExpressionUUID->"68dbfb54-9cec-44d9-18f8-f31e14992e23"],

Cell[TextData[{
 "The following step is to obtain the global phase ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "\[Phi]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "490cd331-563c-164f-7f33-cb7b63c97c95"],
 ". We can check that it is the same for each amplitude:"
}], "Text",
 CellID->546253310,ExpressionUUID->"657c510c-49b2-e75b-1304-49566844cda1"],

Cell[BoxData[
 RowBox[{"globalphase", " ", "=", " ", 
  RowBox[{"opt\[Psi]", "/", 
   RowBox[{"(", 
    RowBox[{"vectorb", "/", "normb"}], ")"}]}]}]], "Input",
 CellLabel->"In[439]:= ",
 CellID->1097788529,ExpressionUUID->"0d6ec52d-5cc9-067c-3b15-dd77557c6d46"],

Cell[TextData[{
 "We can verify ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox[
      RowBox[{"i", "\[Phi]"}], "TI"]]], 
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox[
     RowBox[{"o", "p", "t"}], "TI"]], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   OverscriptBox[
    StyleBox["b", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3668f576-4c14-1c4a-5e17-ed3065a16690"],
 " using the mean value of the global phase:"
}], "Text",
 CellID->586661742,ExpressionUUID->"5f9031bc-85db-b36a-05af-a8e62c6f01b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"Mean", "[", "globalphase", "]"}]}], "*", "opt\[Psi]"}], " ", "-",
    " ", 
   RowBox[{"qb", "[", "\"\<AmplitudesList\>\"", "]"}]}], " ", "//", " ", 
  "Chop"}]], "Input",
 CellLabel->"In[440]:= ",
 CellID->1839444871,ExpressionUUID->"1f7beb9c-7c94-54df-4518-02c675213e25"],

Cell[TextData[{
 "Calculate ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox[
     RowBox[{"o", "p", "t"}], "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61ce2c0b-0128-d3f4-17f5-c655b0c2a1de"],
 ":"
}], "Text",
 CellID->854106743,ExpressionUUID->"4bb1fc90-7b0c-5559-794e-f5da7eb93fa3"],

Cell[BoxData[
 RowBox[{"optX", " ", "=", " ", 
  RowBox[{
   RowBox[{"ansatz", "[", 
    RowBox[{"<|", 
     RowBox[{"Last", "@", "optNM"}], "|>"}], "]"}], 
   "[", "\"\<AmplitudesList\>\"", "]"}]}]], "Input",
 CellLabel->"In[441]:= ",
 CellID->1537555325,ExpressionUUID->"47947242-81c8-9b15-6dac-742c3062e67f"],

Cell[TextData[{
 "Now recover ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox[
     RowBox[{"o", "p", "t"}], "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e52a655-39e3-731f-4661-381fbf965e65"],
 " by applying the global phase and normalization terms: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox[
     RowBox[{"o", "p", "t"}], "TI"]], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox[
      RowBox[{"i", "\[Phi]"}], "TI"]]], 
   FractionBox[GridBox[{
      {GridBox[{
         {
          StyleBox["b", "TI"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], GridBox[{
      {GridBox[{
         {
          StyleBox["A", "TI"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}]], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox[
     RowBox[{"o", "p", "t"}], "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e91b615-0ed0-3b31-16ae-285fab6a861b"],
 ":"
}], "Text",
 CellID->1629976190,ExpressionUUID->"070d5859-2054-d468-2d33-520351e6beb2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"Mean", "[", "globalphase", "]"}]}], "*", 
   RowBox[{"normb", "/", "normA"}], "*", "optX"}], " ", "//", " ", 
  "Chop"}]], "Input",
 CellLabel->"In[442]:= ",
 CellID->1341084535,ExpressionUUID->"2322320f-c27e-967c-52d1-b468f708fd46"],

Cell["We can verify our result:", "Text",
 CellID->17375906,ExpressionUUID->"043be316-2158-5fff-2dd8-fb5050ed25c5"],

Cell[BoxData[
 RowBox[{"LinearSolve", "[", 
  RowBox[{"matrixA", ",", " ", "vectorb"}], "]"}]], "Input",
 CellLabel->"In[443]:= ",
 CellID->1251432093,ExpressionUUID->"6802a81d-2cf4-f5d5-1831-42474486df3f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"%%", " ", "-", " ", "%"}], " ", "//", " ", "Abs"}]], "Input",
 CellLabel->"In[444]:= ",
 CellID->1543998881,ExpressionUUID->"6e402ad6-5057-5ed2-167f-c39061e22438"],

Cell["Optimization using Quantum Natural Gradient Descent", "Text",
 CellID->287841107,ExpressionUUID->"41b7e238-0be5-970e-774c-0462ad91fa54"],

Cell[TextData[{
 "As explained in a ",
 ButtonBox["previous example",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/3131997"], None}],
 ", we can optimize using ",
 ButtonBox["QuantumNaturalGradientDescent",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/PacletRepository/resources/\
Wolfram/QuantumFramework/tutorial/ExampleRepositoryFunctions.html#14652158"], 
    None}],
 ", calculating their correspondent Fubini\[Dash]Study metric tensor."
}], "Text",
 CellID->1048239329,ExpressionUUID->"2eb3f556-206c-8695-5640-ed10511eecff"],

Cell[TextData[{
 "A useful question to consider is: \[OpenCurlyDoubleQuote]Which state are we \
using in the Fubini-Study metric tensor function?\[CloseCurlyDoubleQuote] In \
this context, the ansatz does not capture the full geometry of the problem, \
so the most appropriate choice is the variational state ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48778410-45aa-a58c-780c-1e5a6c5c0fd6"],
 ", which is parameterized and encodes the essential information about the \
system."
}], "Text",
 CellID->1330756316,ExpressionUUID->"6663666a-17cc-8c5b-0e11-7834a27ed6a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fubini", " ", "=", " ", 
   RowBox[{"FubiniStudyMetricTensor", "[", "\[Psi]", "]"}]}], ";"}]], "Input",\

 CellLabel->"In[445]:= ",
 CellID->484378824,ExpressionUUID->"39cc1c7e-c0bc-15c6-6ff3-963bf1497f2c"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s try with a pair of steps on the optimizer with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "\[Rule]", "0.6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d6a022c-3310-f1e4-1b69-a47646aac3ce"],
 ":"
}], "Text",
 CellID->959186032,ExpressionUUID->"4a5cf6b6-efb6-dcec-7a63-eff38a40a636"],

Cell[BoxData[
 RowBox[{
  RowBox[{"opt", " ", "=", " ", 
   RowBox[{"GradientDescent", "[", 
    RowBox[{"fidelity", ",", " ", "init", ",", " ", 
     RowBox[{"\"\<LearningRate\>\"", " ", "->", " ", "0.6"}], ",", " ", "\n", 
     "   ", 
     RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "2"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[446]:= ",
 CellID->1156421307,ExpressionUUID->"3c334b92-ac05-23e1-65c1-62dfc5b071cb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qopt", " ", "=", " ", 
   RowBox[{"QuantumNaturalGradientDescent", "[", 
    RowBox[{"fidelity", ",", " ", "fubini", ",", " ", "\n", "   ", 
     RowBox[{"\"\<InitialPoint\>\"", " ", "->", " ", "init"}], ",", " ", 
     RowBox[{"\"\<LearningRate\>\"", " ", "->", " ", "0.6"}], ",", " ", "\n", 
     "   ", 
     RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "2"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[447]:= ",
 CellID->1091177881,ExpressionUUID->"269d5917-f35c-fcc3-4ea3-515086eec629"],

Cell["\<\
The result is quite remarkable: the Quantum Natural Gradient Descent \
outperforms regular gradient descent and reaches the minimum value in only \
two steps!\
\>", "Text",
 CellID->84398105,ExpressionUUID->"220c9cc5-a2c2-16ad-5233-15aed7777cf7"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fidelity", " ", "@@@", " ", "opt"}], ",", " ", 
     RowBox[{"fidelity", " ", "@@@", " ", "qopt"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Steps\>\"", ",", " ", "\"\<Cost function\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"FrameTicks", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", "3", "]"}], ",", " ", "None"}], "}"}]}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[448]:= ",
 CellID->1307078669,ExpressionUUID->"52062e5b-b148-8aac-023d-c004c0e2d8f6"],

Cell["We can verify that the minimization approaches to 0:", "Text",
 CellID->25976719,ExpressionUUID->"4b9e800e-167b-cc53-79a5-1a68a30f96b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fidelity", " ", "@@@", " ", "qopt"}], " ", "//", " ", 
  "Last"}]], "Input",
 CellLabel->"In[449]:= ",
 CellID->898249782,ExpressionUUID->"09a99be4-f821-127c-3f56-12c1f9d46146"],

Cell[TextData[{
 "Check",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["\[Psi]", "TI"], 
      StyleBox["(", SpanMaxSize -> 1], 
      StyleBox["\[Theta]", "TI"], 
      StyleBox[")", SpanMaxSize -> 1]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21fc4796-9fa1-d99c-5784-5ed01a55abe6"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["b", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ea97580-6bed-1077-6657-6cea0d98635d"],
 " probability distributions:"
}], "Text",
 CellID->346794469,ExpressionUUID->"345a0710-bfec-3876-5c79-9f5a399e8b5c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"association", " ", "=", " ", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{"parameters", ",", " ", 
     RowBox[{"Last", "@", "qopt"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[450]:= ",
 CellID->872189371,ExpressionUUID->"56a4078a-bfa3-4726-7e5b-9ed43a562a0c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Dataset", "[", 
   RowBox[{"<|", "\n", "   ", 
    RowBox[{
     RowBox[{"\"\<\!\(\*TemplateBox[{\\\"\[Psi]\\\"},\n\\\"Ket\\\"]\)\>\"", 
      " ", "->", " ", 
      RowBox[{
       RowBox[{"\[Psi]", "[", "\n", "      ", "association", "]"}], 
       "[", "\"\<Probabilities\>\"", "]"}]}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<\!\(\*TemplateBox[{\\\"b\\\"},\n\\\"Ket\\\"]\)\>\"", " ", "->",
       " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumState", "[", 
        RowBox[{"vectorb", "/", "normb"}], "]"}], "[", "\"\<Probabilities\>\"",
        "]"}]}]}], "|>"}], "]"}], " ", "//", " ", "Transpose"}]], "Input",
 CellLabel->"In[451]:= ",
 CellID->2041164558,ExpressionUUID->"26fb0827-d9bf-287b-4e98-a180d84a7b41"],

Cell["\<\
As you may have noticed, the probabilities match, but with less precision in \
this case. However, the amplitudes are completely different, and they even \
have different signs!\
\>", "Text",
 CellID->1808276752,ExpressionUUID->"5706a8dc-de84-4347-7d3d-4199db3111ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Dataset", "[", 
   RowBox[{"<|", "\n", "   ", 
    RowBox[{
     RowBox[{"\"\<\!\(\*TemplateBox[{\\\"\[Psi]\\\"},\n\\\"Ket\\\"]\)\>\"", 
      " ", "->", " ", 
      RowBox[{
       RowBox[{"\[Psi]", "[", "\n", "      ", "association", "]"}], 
       "[", "\"\<Amplitudes\>\"", "]"}]}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<\!\(\*TemplateBox[{\\\"b\\\"},\n\\\"Ket\\\"]\)\>\"", " ", "->",
       " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumState", "[", 
        RowBox[{"vectorb", "/", "normb"}], "]"}], "[", "\"\<Amplitudes\>\"", 
       "]"}]}]}], "|>"}], "]"}], " ", "//", " ", "Transpose"}]], "Input",
 CellLabel->"In[452]:= ",
 CellID->672757341,ExpressionUUID->"2d69e98f-64de-6fdb-5b16-00e90d6b3521"],

Cell[TextData[{
 "This is basically is saying that we found ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox[
     RowBox[{"o", "p", "t"}], "TI"]], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "\[Phi]"}], "TI"]], 
   OverscriptBox[
    StyleBox["b", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "168d2c40-6f69-6af1-3eb2-c62a0a1c38db"],
 ":"
}], "Text",
 CellID->1456333282,ExpressionUUID->"5ba2698e-fe1d-1d69-0951-80ebfba867b3"],

Cell[BoxData[
 RowBox[{"opt\[Psi]", " ", "=", " ", 
  RowBox[{
   RowBox[{"\[Psi]", "[", "association", "]"}], "[", "\"\<AmplitudesList\>\"",
    "]"}]}]], "Input",
 CellLabel->"In[453]:= ",
 CellID->488132230,ExpressionUUID->"0ea67a49-9063-84e3-365e-7c132117eec9"],

Cell[TextData[{
 "The following step is to obtain the global phase ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "\[Phi]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58f54a37-a74b-68c6-088b-6c70d2fe3a2c"],
 ":"
}], "Text",
 CellID->945655672,ExpressionUUID->"75e1b769-bd43-d492-239e-2f3334f7bef8"],

Cell[BoxData[
 RowBox[{"globalphase", " ", "=", " ", 
  RowBox[{"opt\[Psi]", "/", 
   RowBox[{"(", 
    RowBox[{"vectorb", "/", "normb"}], ")"}]}]}]], "Input",
 CellLabel->"In[454]:= ",
 CellID->980003529,ExpressionUUID->"6ca9690d-8fe0-3108-1456-8157299a8052"],

Cell["\<\
Now, during the process of obtaining the global phase, we observe that the \
values are not exactly the same. In this case, when we use the mean value of \
the global phase, we can check that the deviation is small enough for the \
desired precision.\
\>", "Text",
 CellID->1024370899,ExpressionUUID->"647c50fc-34e3-bac8-0c04-49a6bc970812"],

Cell[TextData[{
 "Calculate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox[
     RowBox[{"o", "p", "t"}], "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f185d1-6f58-e3b1-4e8e-1c9b0ad2b19b"],
 ":"
}], "Text",
 CellID->1624771488,ExpressionUUID->"2068c8a6-f8a3-ae64-5017-e103f957f54e"],

Cell[BoxData[
 RowBox[{"optX", " ", "=", " ", 
  RowBox[{
   RowBox[{"ansatz", "[", "association", "]"}], "[", "\"\<AmplitudesList\>\"",
    "]"}]}]], "Input",
 CellLabel->"In[455]:= ",
 CellID->1379376595,ExpressionUUID->"71e08206-fd12-5e06-279f-2463f4a7256c"],

Cell[TextData[{
 "Now recover ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox[
     RowBox[{"o", "p", "t"}], "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d887537-d4d2-c16f-3b88-6d70dd6493b5"],
 " by applying the global phase and normalization terms ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox[
     RowBox[{"o", "p", "t"}], "TI"]], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox[
      RowBox[{"i", "\[Phi]"}], "TI"]]], 
   FractionBox[GridBox[{
      {GridBox[{
         {
          StyleBox["b", "TI"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], GridBox[{
      {GridBox[{
         {
          StyleBox["A", "TI"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}]], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox[
     RowBox[{"o", "p", "t"}], "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f5790be-8388-a9de-756c-09f83622fb24"],
 ":"
}], "Text",
 CellID->1418214672,ExpressionUUID->"3df4e37b-637b-fece-6b8b-fb25160fc414"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"Mean", "[", "globalphase", "]"}]}], "*", 
   RowBox[{"normb", "/", "normA"}], "*", "optX"}], " ", "//", " ", 
  "Chop"}]], "Input",
 CellLabel->"In[456]:= ",
 CellID->583935298,ExpressionUUID->"4a3f75be-20c7-75c2-7bc5-6cf851725f28"],

Cell["We can verify our result approximation:", "Text",
 CellID->1173760731,ExpressionUUID->"3be838d6-abbf-bcfe-6997-b193ce4b06c4"],

Cell[BoxData[
 RowBox[{"LinearSolve", "[", 
  RowBox[{"matrixA", ",", " ", "vectorb"}], "]"}]], "Input",
 CellLabel->"In[457]:= ",
 CellID->644020303,ExpressionUUID->"4edd261b-067a-5094-76e2-b845b30f22fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"%%", " ", "-", " ", "%"}], " ", "//", " ", "Abs"}]], "Input",
 CellLabel->"In[458]:= ",
 CellID->2124556566,ExpressionUUID->"037c0c65-d4c7-b425-3103-a64edd731f0f"],

Cell["\<\
After repeating all the same steps from the previous example, we get a final \
result that is close to the true result but with slightly less precision. \
What\[CloseCurlyQuote]s remarkable about this solution is that we achieved it \
in only two steps! Of course, the results depend heavily on the learning rate \
eta, so it\[CloseCurlyQuote]s important to fine-tune it to ensure that the \
optimization is done efficiently.\
\>", "Text",
 CellID->2061762906,ExpressionUUID->"574a8c08-e927-fc17-7d49-265588d3c77d"],

Cell["Options", "Subsubsection",
 CellID->1132694509,ExpressionUUID->"661d9b09-967b-e29f-0e22-1353230fb0e5"],

