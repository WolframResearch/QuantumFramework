 CellID->386305266,ExpressionUUID->"4b1b5b6f-b43d-594b-7939-53493dc82b91"],

Cell["We load the Hamiltonian for each minigraph:", "Text",
 CellID->851052457,ExpressionUUID->"32f703b9-71e1-95eb-628c-9ae30795ff31"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"subweights", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"<|", "\n", "     ", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"List", " ", "@@@", " ", 
         RowBox[{"EdgeList", "[", "#", "]"}]}], " ", "->", " ", "\n", 
        "       ", 
        RowBox[{"PropertyValue", "[", 
         RowBox[{"#", ",", " ", "EdgeWeight"}], "]"}]}], "]"}], "|>"}], " ", 
     "&"}], " ", "/@", " ", "subgraphs"}]}], ";"}], "\n", 
 RowBox[{"subHc", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Total", "[", "\n", "    ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", 
        RowBox[{"#", "[", "\n", "       ", "i", "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"QuantumOperator", "[", 
           RowBox[{"\"\<I\>\"", ",", " ", "i"}], "]"}], " ", "-", " ", 
          RowBox[{"QuantumOperator", "[", 
           RowBox[{"\"\<Z\>\"", ",", " ", "i"}], "]"}]}], ")"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "\n", "      ", 
         RowBox[{"Keys", "@", "#"}]}], "}"}]}], "]"}], "]"}], " ", "&"}], " ",
    "/@", " ", "subweights"}]}]}], "Input",
 CellLabel->"In[171]:= ",
 CellID->2058506768,ExpressionUUID->"0c860bbc-8d1f-f590-34bd-a2e624abdffa"],

Cell["\<\
We then construct symbolic QAOA circuits, with qubit indices mapping directly \
to graph nodes:\
\>", "Text",
 CellID->1517481976,ExpressionUUID->"1bab88a0-6539-d521-49a8-210a0ccdbc0b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"subQAOA", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{
       RowBox[{"{", "\n", "      ", 
        RowBox[{
         RowBox[{"\"\<+\>\"", " ", "->", " ", 
          RowBox[{"VertexList", "[", "#1", "]"}]}], ",", "\n", "      ", 
         RowBox[{"Sequence", " ", "@@", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<R\>\"", ",", " ", "t", ",", " ", "\"\<ZZ\>\""}], 
               "}"}], " ", "->", " ", "#1"}], " ", "&"}], ")"}], " ", "/@", 
           " ", 
           RowBox[{"List", " ", "@@@", " ", 
            RowBox[{"EdgeList", "[", "#1", "]"}]}]}]}], ",", "\n", "      ", 
         RowBox[{
          RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], " ", "->", " ", 
          RowBox[{"VertexList", "[", "#1", "]"}]}]}], "\n", "      ", "}"}], ",",
        "\n", "     ", 
       RowBox[{"\"\<Label\>\"", " ", "->", " ", "None"}], ",", " ", 
       RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", " ", "t"}], "}"}]}]}], "]"}], " ", "&"}], 
    " ", "/@", " ", "subgraphs"}]}], ";"}]], "Input",
 CellLabel->"In[172]:= ",
 CellID->1801018163,ExpressionUUID->"74b37722-3fdc-1a4f-1c41-6e8cba696895"],

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Partition", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"\"\<Diagram\>\"", ",", " ", 
         RowBox[{"\"\<ShowEmptyWires\>\"", " ", "->", " ", "False"}]}], "]"}],
        " ", "&"}], " ", "/@", " ", "subQAOA"}], ",", " ", "2"}], "]"}], ",", 
   " ", "\n", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]], "Input",
 CellLabel->"In[173]:= ",
 CellID->1876597567,ExpressionUUID->"31781dc2-1028-33d4-6707-94aca1c2813e"],

Cell["\<\
After simulating the states, we can observe how the symbolic computation can \
give insights about cost functions for each subgraph. We can visualize the \
parameter space using contour plots, giving us deep insight into the \
optimization behavior.\
\>", "Text",
 CellID->342110625,ExpressionUUID->"2148b02c-d62e-5336-5777-2989e3db3e1c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QAOAstates", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"QuantumOperator", "[", "#", "]"}], "[", "\"\<State\>\"", "]"}],
      " ", "&"}], " ", "/@", " ", "subQAOA"}]}], ";"}]], "Input",
 CellLabel->"In[174]:= ",
 CellID->893866949,ExpressionUUID->"183293a6-0d60-7813-49c1-0a00a4154b79"],

Cell[BoxData[
 RowBox[{
  RowBox[{"subcost", " ", "=", " ", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ket", ",", " ", "bra", ",", " ", "hc"}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"ket", " ", "=", " ", 
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "[", "\"\<StateVector\>\"", 
          "]"}]}], ";", " ", "\n", "     ", 
        RowBox[{"bra", " ", "=", " ", 
         RowBox[{
          RowBox[{"SuperDagger", "[", 
           RowBox[{"#1", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "[", "\"\<StateVector\>\"",
           "]"}]}], ";", " ", "\n", "     ", 
        RowBox[{"hc", " ", "=", " ", 
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<Matrix\>\"", "]"}]}], ";",
         " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"bra", " ", ".", " ", "hc", " ", ".", " ", "ket"}], ")"}], 
          " ", "//", " ", "ComplexExpand"}], " ", "//", " ", "\n", "      ", 
         "FullSimplify"}]}]}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"Thread", "[", 
     RowBox[{"{", 
      RowBox[{"subHc", ",", " ", "QAOAstates"}], "}"}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[175]:= ",
