Cell["Algorithm Components", "Subsubsection",
 CellID->1459056000,ExpressionUUID->"4ce0809c-d5c3-af14-749f-19d9dc77f27e"],

Cell["Ansatz", "Text",
 CellID->1086341798,ExpressionUUID->"319d38eb-f6c5-3702-67a2-b1b483719a68"],

Cell["Generate a variational state in 4D:", "Text",
 CellID->340678722,ExpressionUUID->"7b2144f6-69f3-9218-2adf-5db00f87e162"],

Cell[BoxData[
 RowBox[{"QuantumState", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"\[Omega]", ",", " ", "1"}], "]"}], ",", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[Omega]", ",", " ", "2"}], "]"}], ",", " ", "\n", "  ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[Omega]", ",", " ", "3"}], "]"}], ",", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[Omega]", ",", " ", "4"}], "]"}]}], "}"}], ",", " ", "\n", 
   " ", 
   RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Subscript", "[", 
       RowBox[{"\[Omega]", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\[Omega]", ",", " ", "2"}], "]"}], ",", " ", "\n", "   ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\[Omega]", ",", " ", "3"}], "]"}], ",", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\[Omega]", ",", " ", "4"}], "]"}]}], "}"}]}], ",", " ", "\n", 
   " ", 
   RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<Ansatz\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[395]:= ",
 CellID->1413264280,ExpressionUUID->"10a6d73c-c2c2-eea0-405d-cf79f774b48a"],

Cell["Show its formula:", "Text",
 CellID->1315865472,ExpressionUUID->"3710847d-4883-61f0-5d2f-1e27693633da"],

Cell[BoxData[
 RowBox[{"%", "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[396]:= ",
 CellID->1326455115,ExpressionUUID->"4a5dfbae-20e5-2129-7a62-f20850907073"],

Cell["Represent it directly in a quantum circuit:", "Text",
 CellID->213532961,ExpressionUUID->"54fe873c-afbe-d0b8-7c85-1f79ca48a282"],

Cell[BoxData[
 RowBox[{"%%", "[", 
  RowBox[{"\"\<CircuitDiagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]], "Input",
 CellLabel->"In[397]:= ",
 CellID->1161339902,ExpressionUUID->"41b5ee91-8ab8-27e2-774a-07db2f328dc8"],

Cell["Request \"Ansatz\" from QuantumLinearSolve function:", "Text",
 CellID->1150494212,ExpressionUUID->"033b6291-8419-2638-32d9-7bdb2dad8d02"],

Cell[BoxData[
 RowBox[{"QuantumLinearSolve", "[", "\n", " ", 
  RowBox[{
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4"}], "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", "I"}], ")"}], " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", ".1"}], ",", " ", ".1"}], "}"}]}], ",", " ", "4"}], 
    "]"}], ",", "\n", " ", "\"\<Ansatz\>\""}], "\n", " ", "]"}]], "Input",
 CellLabel->"In[398]:= ",
 CellID->1416655727,ExpressionUUID->"69bf3242-ce45-6744-1f44-b42febf04dae"],

Cell[BoxData[
 RowBox[{"%", "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->"In[399]:= ",
 CellID->1396168158,ExpressionUUID->"34f98250-b9a0-779e-5c86-241a38555de4"],

Cell["All parameters are real in above equation.", "Text",
 CellID->1091840343,ExpressionUUID->"6ff43cc4-be71-93f0-158b-b5ae3b05e1da"],

Cell["Multiplexer", "Text",
 CellID->1977153780,ExpressionUUID->"51b5abc0-0202-0151-074a-42aab7b753bb"],

Cell[TextData[{
 "The Multiplexer encodes all the information from ",
 StyleBox["m ", "TI"],
 "matrix problem into the quantum circuit and simulates the ",
 StyleBox["m.x ", "TI"],
 "operation in the quantum circuit. First, we need to decompose a ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["2", 
    StyleBox["n", "TI"]], 
   StyleBox["x", "TI"], 
   SuperscriptBox["2", 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "126b1bc1-46f5-8a3a-4268-92ab7281d900"],
 " ",
 StyleBox["m", "TI"],
 "\[Dash]matrix in Pauli matrices such that ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", 
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox["\[CircleTimes]", 
     StyleBox["n", "TI"],
     LimitsPositioning->False], 
    StyleBox["\[Sigma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "046e4336-067c-8bff-2c16-5b70b30ed9c5"],
 "."
}], "Text",
 CellID->1335623228,ExpressionUUID->"07815119-4e7f-a41e-2dbf-49436b0b0f64"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"m", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"m", " ", "//", " ", "MatrixForm"}]}], "Input",
 CellLabel->"In[400]:= ",
 CellID->782362339,ExpressionUUID->"7918a344-d32d-e3ba-2f27-3b21e6d9b180"],

Cell[BoxData[
 RowBox[{"x", " ", "=", " ", 
  RowBox[{"RandomComplex", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], " ", "-", " ", 
       RowBox[{"1", "*", "I"}]}], ",", " ", 
      RowBox[{
       RowBox[{"+", "1"}], " ", "+", " ", 
       RowBox[{"1", "*", "I"}]}]}], "}"}], ",", " ", "4"}], "]"}]}]], "Input",\

 CellLabel->"In[401]:= ",
 CellID->778044813,ExpressionUUID->"3d8a8157-75dd-89f2-6b89-19117c69dbd8"],

Cell[TextData[{
 "Use QuantumOperator property to obtain the Pauli decomposition of matrix ",
 StyleBox["m", "TI"],
 ":"
}], "Text",
 CellID->178007381,ExpressionUUID->"280c132e-a962-3439-5833-8a8bc8149f03"],

Cell[BoxData[
 RowBox[{"\[Sigma]", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumOperator", "[", "m", "]"}], "[", "\"\<PauliDecompose\>\"", 
   "]"}]}]], "Input",
 CellLabel->"In[402]:= ",
 CellID->357417868,ExpressionUUID->"5c58460f-1f98-22b3-0478-58699a2d7099"],

Cell["\<\
It is possible to apply the tensor product of Pauli matrices as controlled \
operations:\
\>", "Text",
 CellID->1326796101,ExpressionUUID->"0f9d878a-7798-33b0-35a2-1ed40212819a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<Multiplexer\>\"", " ", "@@", " ", 
    RowBox[{"Keys", "[", "\[Sigma]", "]"}]}], "]"}], "[", "\"\<Diagram\>\"", 
  "]"}]], "Input",
 CellLabel->"In[403]:= ",
 CellID->1997232599,ExpressionUUID->"7e9a25a0-be60-edc7-26b9-bc0a3b1ab72d"],

Cell[TextData[{
 "Use the squared-roots constants ",
 Cell[BoxData[
  SqrtBox[
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["i", "TI"]]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3456b4ad-9984-7479-5c6d-2df718315f43"],
 " to define a quantum state to act on the control qubits and use vector ",
 StyleBox["x", "TI"],
 " QuantumState in the taget qubits:"
}], "Text",
 CellID->2063879813,ExpressionUUID->"69d1a328-4310-c880-1fee-3b7276aa9aea"],

Cell[BoxData[
 RowBox[{"QuantumCircuitOperator", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"x", ",", " ", 
       RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<x\>\""}]}], "]"}], " ", "->",
      " ", 
     RowBox[{"{", 
      RowBox[{"5", ",", " ", "6"}], "}"}]}], ",", "\n", "  ", 
    RowBox[{"QuantumState", "[", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"Values", "[", "\[Sigma]", "]"}], "]"}], ",", " ", "\n", "   ", 
      RowBox[{"\"\<Label\>\"", " ", "->", 
       " ", "\"\<\!\(\*SqrtBox[\(m\)]\)\>\""}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"\"\<Multiplexer\>\"", " ", "@@", " ", 
     RowBox[{"Keys", "[", "\[Sigma]", "]"}]}], ",", "\n", "  ", 
    RowBox[{"SuperDagger", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"Values", "[", "\[Sigma]", "]"}], "]"}], ",", " ", "\n", 
        "    ", 
        RowBox[{"\"\<Label\>\"", " ", "->", 
         " ", "\"\<\!\(\*SqrtBox[\(m\)]\)\>\""}]}], "]"}], 
      "[", "\"\<Conjugate\>\"", "]"}], "]"}]}], "\n", "  ", "}"}], "\n", " ", 
  "]"}]], "Input",
 CellLabel->"In[404]:= ",
 CellID->1626633690,ExpressionUUID->"1c27efc5-dd5c-0ea0-45dc-06aed4e9548a"],

Cell[BoxData[
 RowBox[{"%", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Full"}]}], "]"}]], "Input",
 CellLabel->"In[405]:= ",
 CellID->390613001,ExpressionUUID->"7f9ca573-a525-e7a3-25a3-3d3cccd1cd89"],

Cell[TextData[{
 "Visualize the application the multiplexer as the representation of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], ".", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1eda8955-2ca4-ffeb-46f9-211f4556c531"],
 " operation:"
}], "Text",
 CellID->782841974,ExpressionUUID->"04eee7d5-a4c3-ea8f-2c95-fe9ecd77b8d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"%%", "[", "]"}], "[", "\"\<AmplitudesList\>\"", "]"}]], "Input",
 CellLabel->"In[406]:= ",
 CellID->445529888,ExpressionUUID->"2fb07358-8f92-ce5d-5540-6b022a2494a7"],

Cell[BoxData[
 RowBox[{"m", " ", ".", " ", "x"}]], "Input",
 CellLabel->"In[407]:= ",
 CellID->1019331220,ExpressionUUID->"18c8dd31-1ea6-1036-48f7-d57b9b53631c"],

Cell[TextData[{
 "In contrast with the circuit implemented above, in this variational problem \
we are given matrix ",
 StyleBox["m", "TI"],
 " and vector ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "154dc22c-e6d4-21a3-4372-db8993617389"],
 ", so we do not know the value for ",
 StyleBox["x", "TI"],
 " such that ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], ".", 
   RowBox[{
    StyleBox["x", "TI"], "=", 
    StyleBox["b", "TI"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00023c2b-283d-9017-3031-b67549c9e37d"],
 ". In order to look up for it, we need to change ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "\[Rule]", 
   StyleBox["x", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "495d6937-f906-8dd0-7f62-8170f8b0d73a"],
 ". This change will establish our variational circuit, necessitating the \
design of an ansatz circuit to generate the corresponding state. In this \
case, we can use Wolfram Quantum Framework tools to generate a variational \
state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d937789-2253-fc97-1ba1-6ed357e7c6fd"],
 " symbolically."
}], "Text",
 CellID->1885906112,ExpressionUUID->"579a3a64-9432-ab70-7db9-bc4e1dc4f65a"],

Cell["\<\
Request \"CircuitOperator\" from QuantumLinearSolve function to obtain the \
variational circuit including the multiplexer and the variational ansatz:\
\>", "Text",
 CellID->979485254,ExpressionUUID->"194a91b0-0c16-7c4e-4f49-08faa5a34694"],

Cell[BoxData[
 RowBox[{"QuantumLinearSolve", "[", "\n", " ", 
  RowBox[{
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4"}], "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.1"}], ",", " ", 
       RowBox[{"+", "0.1"}]}], "}"}], ",", " ", "4"}], "]"}], ",", "\n", 
   " ", "\"\<CircuitOperator\>\""}], "\n", " ", "]"}]], "Input",
 CellLabel->"In[408]:= ",
 CellID->969485559,ExpressionUUID->"1e65ff1b-2e7b-83a1-461a-f7454b0fd18b"],

Cell[BoxData[
 RowBox[{"%", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Full"}]}], "]"}]], "Input",
 CellLabel->"In[409]:= ",
 CellID->1207871365,ExpressionUUID->"2949918d-6dca-6327-5f76-08d7047f4e0d"],

