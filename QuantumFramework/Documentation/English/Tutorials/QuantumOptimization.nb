Cell[BoxData[
 RowBox[{
  RowBox[{"ControlledGateA", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumOperator", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"QuantumOperator", "[", "\"\<I\>\"", "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"l", ",", " ", "2"}], "]"}]}], " ", "+", " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "4"}], "}"}]}], "}"}], "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"l", ",", " ", "3"}], "]"}]}], " ", "+", " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"l", ",", " ", "4"}], "]"}]}], " ", "+", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}], "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"l", ",", " ", "5"}], "]"}]}]}], "\n", "   ", ",", "\n", 
     "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", "l", "}"}]}], ",", "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", 
      " ", "\"\<Controlled \!\(\*SubscriptBox[\(A\), \(l\)]\) Gate\>\""}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[359]:= ",
 CellID->1825180589,ExpressionUUID->"45dcfd53-12c9-ed0c-73e3-f51da77db456"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ControlledGateZ", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j", ",", " ", "2"}], "]"}]}], " ", "+", " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j", ",", " ", "3"}], "]"}]}], " ", "+", " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "4"}], "}"}]}], "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j", ",", " ", "4"}], "]"}]}], " ", "+", " ", "\n", "    ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", "\"\<I\>\"", "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j", ",", " ", 
         RowBox[{"-", "1"}]}], "]"}]}]}], ",", "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", "j", "}"}]}], ",", "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", 
      " ", "\"\<Controlled \!\(\*SubscriptBox[\(Z\), \(j\)]\) Gate\>\""}]}], 
