Cell["Ansatz", "Text",
 CellID->892324061,ExpressionUUID->"56b731d2-b1dc-5164-7e4c-a89fc069204e"],

Cell[TextData[{
 "You can specify the ansatz to be used as a ",
 Cell[BoxData["QuantumState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0758e084-cdd2-0fbb-2d67-f9e1e4675581"],
 " or ",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53f282fc-d9f3-c4a2-0181-1bb9df87ae88"],
 ":"
}], "Text",
 CellID->388188027,ExpressionUUID->"065deb70-832e-a04f-2e62-033a36d8f295"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ansatz", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Alpha]1", ",", " ", "\[Alpha]2", ",", " ", "\[Alpha]3", ",", " ", 
       "\[Alpha]4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[Alpha]1", ",", " ", "\[Alpha]2", ",", " ", "\[Alpha]3", ",", " ", 
        "\[Alpha]4"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ansatz", "[", "\"\<Formula\>\"", "]"}]}], "Input",
 CellLabel->"In[459]:= ",
 CellID->1829003450,ExpressionUUID->"023a3ab5-9b7c-3e4c-33d9-b3ff1e0e8496"],

Cell[BoxData[
 RowBox[{"m", " ", "=", " ", 
  RowBox[{"RandomReal", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"4", ",", " ", "4"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[460]:= ",
 CellID->592570502,ExpressionUUID->"0950ae2c-fd95-e5a5-3f6f-4789f421cf8f"],

Cell[BoxData[
 RowBox[{"b", " ", "=", " ", 
  RowBox[{"RandomReal", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "4"}], "]"}]}]], "Input",
 CellLabel->"In[461]:= ",
 CellID->1163120224,ExpressionUUID->"63d73e3d-5e6d-9b2c-11ec-b0675b19e676"],

Cell[BoxData[
 RowBox[{"QuantumLinearSolve", "[", 
  RowBox[{"m", ",", " ", "b", ",", " ", 
   RowBox[{"\"\<Ansatz\>\"", " ", "->", " ", "ansatz"}]}], "]"}]], "Input",
 CellLabel->"In[462]:= ",
 CellID->1375473625,ExpressionUUID->"19261c33-408d-2b93-48dd-967d713879f9"],

Cell["Compare the result with the classical method:", "Text",
 CellID->653708785,ExpressionUUID->"61f29a52-27f6-2d9f-1781-1c1c518377e5"],

Cell[BoxData[
 RowBox[{"LinearSolve", "[", 
  RowBox[{"m", ",", " ", "b"}], "]"}]], "Input",
 CellLabel->"In[463]:= ",
 CellID->1308625607,ExpressionUUID->"39b8808a-080a-fb1f-6f47-19d4a9bcc665"],

Cell[BoxData[
 RowBox[{
  RowBox[{"%", " ", "-", " ", "%%"}], " ", "//", " ", "Abs"}]], "Input",
 CellLabel->"In[464]:= ",
 CellID->1317243799,ExpressionUUID->"01c3b6b5-4696-f194-37f0-2fff7320c3fe"],

Cell["GlobalPhaseAccuracy", "Text",
 CellID->540912137,ExpressionUUID->"41915581-04ed-47bc-77af-4cebac982d86"],

Cell[TextData[{
 "The ",
 Cell[BoxData["QuantumLinearSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3329119b-60db-b2d6-62d6-88c5116f003c"],
 " function does an approximation to recover the result once the variational \
circuit \[Psi](\[Omega]) is close enough to the vector \|01d553 problem such \
that ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], "\[TildeEqual]", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "\[Phi]"}], "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\|01d553"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1615cf65-d1a2-5497-3e2a-e74ee0573efd"],
 ". \"GlobalPhaseAccuracy\" option sets the accuracy of the global phase \
calculated."
}], "Text",
 CellID->1886711942,ExpressionUUID->"1cd77268-421f-8518-44ed-743277abec62"],

Cell[BoxData[
 RowBox[{"m", " ", "=", " ", 
  RowBox[{"RandomReal", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"4", ",", " ", "4"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[465]:= ",
 CellID->846206671,ExpressionUUID->"47ae9621-0454-0efb-6d55-0f8bade154c1"],

Cell[BoxData[
 RowBox[{"b", " ", "=", " ", 
  RowBox[{"RandomReal", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "4"}], "]"}]}]], "Input",
 CellLabel->"In[466]:= ",
 CellID->217256349,ExpressionUUID->"750c318a-354e-3de3-2333-a8d4bcf887c9"],

Cell["Let's indicate a high accuracy:", "Text",
 CellID->2019067734,ExpressionUUID->"31301a4b-de00-df4c-60cf-9c14dbbaa596"],

Cell[BoxData[
 RowBox[{"QuantumLinearSolve", "[", 
  RowBox[{"m", ",", " ", "b", ",", " ", 
   RowBox[{"\"\<GlobalPhaseAccuracy\>\"", " ", "->", " ", 
    RowBox[{"10", "^", 
     RowBox[{"-", "10"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[467]:= ",
 CellID->1352114184,ExpressionUUID->"7bf891b7-a846-9636-2987-08f0c9f0fd1c"],

Cell["AccuracyGoal & PrecisionGoal", "Text",
 CellID->1215308922,ExpressionUUID->"470c2033-8417-1ad4-6d33-ba7d2da2683e"],

Cell[TextData[{
 "This enforces the convergence criteria ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {GridBox[{
        {
         RowBox[{
