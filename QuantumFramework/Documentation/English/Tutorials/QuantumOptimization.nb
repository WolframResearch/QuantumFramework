        "\n", "     ", 
       RowBox[{"VertexStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", " ", "->", " ", 
           RowBox[{"Hue", "[", 
            RowBox[{
            "0", ",", " ", "0.57", ",", " ", "0.78", ",", " ", "0.4"}], 
            "]"}]}], ",", " ", "\n", "       ", 
          RowBox[{"2", " ", "->", " ", 
           RowBox[{"Hue", "[", 
            RowBox[{
            "0.15", ",", " ", "0.82", ",", " ", "0.87", ",", " ", "0.4"}], 
            "]"}]}], ",", " ", 
          RowBox[{"3", " ", "->", " ", 
