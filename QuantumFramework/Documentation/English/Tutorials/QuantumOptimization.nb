 RowBox[{
  RowBox[{"qp", " ", "=", " ", 
   RowBox[{"QuantumNaturalGradientDescent", "[", 
    RowBox[{"cost", ",", " ", "metric", ",", " ", "\n", "   ", 
     RowBox[{"\"\<InitialPoint\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Pi]", "/", "12"}], ",", " ", 
        RowBox[{"\[Pi]", "/", "12"}]}], "}"}]}], ",", " ", 
