     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["L", "TI"]], ".", ".", ".", 
     SubscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["l", "TI"]]}], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["\[Theta]", "TI"], 
      StyleBox["l", "TI"]], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["l", "TI"]], ".", ".", ".", 
     SubscriptBox[
      StyleBox["V", "TI"], "0"]}], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["\[Theta]", "TI"], "0"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    SubscriptBox[
     StyleBox["W", "TI"], "0"], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], "0"]},
     "Ket"]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1698333316,ExpressionUUID->"5d16072b-4094-e7d7-0b2d-9f757126cd3d"],

Cell[TextData[{
 "where W are layers of non-parametrized gates and ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["K", "TI"], 
   StyleBox["i", "TI"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["l", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e71c00a-9fc6-07cd-160e-da541a736d17"],
 " are the generators of the parametrized gates V of the form ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{
    StyleBox["i", "TI"], 
    SubsuperscriptBox[
     StyleBox["\[Theta]", "TI"], 
     StyleBox["i", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["l", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]], 
    SubsuperscriptBox[
     StyleBox["K", "TI"], 
     StyleBox["i", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["l", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59da3beb-dbdf-0123-0ff9-b2b4de6a5009"],
 "."
}], "Text",
 CellID->610891702,ExpressionUUID->"28f3c6b4-96e3-425b-5880-dffe229610a1"],

Cell["The quantum state before the application of layer l is:", "Text",
 CellID->1837741667,ExpressionUUID->"50dcf632-b06e-d3ec-00e3-e87fc118a136"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], 
      RowBox[{
        StyleBox["l", "TI"], "-", "1"}]]},
    "Ket"], "=", 
   RowBox[{
    SubscriptBox[
     StyleBox["V", "TI"], 
     RowBox[{
      StyleBox["l", "TI"], "-", "1"}]], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["\[Theta]", "TI"], 
      RowBox[{
       StyleBox["l", "TI"], "-", "1"}]], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{
     SubscriptBox[
      StyleBox["W", "TI"], 
      RowBox[{
       StyleBox["l", "TI"], "-", "1"}]], ".", ".", ".", 
     SubscriptBox[
      StyleBox["V", "TI"], "0"]}], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["\[Theta]", "TI"], "0"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    SubscriptBox[
     StyleBox["W", "TI"], "0"], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], "0"]},
     "Ket"]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1367899646,ExpressionUUID->"0192d3b7-44a5-149f-37a1-caf16d507ee5"],

Cell["Let\[CloseCurlyQuote]s build a circuit for the following example:", \
"Text",
 CellID->1430029607,ExpressionUUID->"0300f609-8c78-c232-313f-e85325f29118"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[ScriptCapitalR]", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\"\<RY\>\"", "[", 
       RowBox[{"\[Pi]", "/", "4"}], "]"}], " ", "->", " ", "1"}], ",", " ", 
     RowBox[{
      RowBox[{"\"\<RY\>\"", "[", 
       RowBox[{"\[Pi]", "/", "3"}], "]"}], " ", "->", " ", "2"}], ",", " ", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"\"\<RY\>\"", "[", 
       RowBox[{"\[Pi]", "/", "7"}], "]"}], " ", "->", " ", "3"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"V1", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\"\<RZ\>\"", "[", "\[Theta]1", "]"}], " ", "->", " ", "1"}], ",",
      " ", 
     RowBox[{
      RowBox[{"\"\<RZ\>\"", "[", "\[Theta]2", "]"}], " ", "->", " ", "2"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"V2", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\"\<RY\>\"", "[", "\[Theta]3", "]"}], " ", "->", " ", "2"}], ",",
      " ", 
     RowBox[{
      RowBox[{"\"\<RX\>\"", "[", "\[Theta]4", "]"}], " ", "->", " ", "3"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"W", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<CNOT\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<CNOT\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[256]:= ",
 CellID->77479944,ExpressionUUID->"366efd8d-b3b0-5f87-5e15-f4d6c64525ed"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"VQC", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
      "\[ScriptCapitalR]", ",", " ", "V1", ",", " ", "W", ",", " ", "V2", ",",
        " ", "W"}], "]"}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[Theta]1", ",", " ", "\[Theta]2", ",", " ", "\[Theta]3", ",", " ", 
        "\[Theta]4"}], "}"}]}], ",", " ", "\n", "   ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "None"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"VQCState", " ", "=", " ", 
   RowBox[{"VQC", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"VQC2", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumMeasurementOperator", "[", 
     RowBox[{"\"\<PauliY\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}]}], "]"}], "[", "VQC", "]"}]}], ";"}], "\n", 
 RowBox[{"VQC2", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[257]:= ",
 CellID->612387568,ExpressionUUID->"3db21443-28a2-09d2-6b41-8e2d49575b38"],

