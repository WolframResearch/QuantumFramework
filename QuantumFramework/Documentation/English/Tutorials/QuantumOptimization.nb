Specify the initial point to start the iteration, compare the following \
gradient descent setups:\
\>", "Text",
 CellID->1052683380,ExpressionUUID->"51798d79-74e7-e8a1-0706-25237c93ba8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qp", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumNaturalGradientDescent", "[", "\n", "     ", 
      RowBox[{"cost", ",", "\n", "     ", "metric", ",", "\n", "     ", 
       RowBox[{"\"\<InitialPoint\>\"", " ", "->", " ", "#"}], ",", "\n", 
       "     ", 
       RowBox[{"\"\<LearningRate\>\"", " ", "->", " ", "0.1"}]}], "]"}], " ", 
     "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"5", " ", 
         RowBox[{"\[Pi]", "/", "12"}]}], ",", " ", 
        RowBox[{"\[Pi]", "/", "12"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Pi]", "/", "\n", "      ", "12"}], ",", " ", 
        RowBox[{"\[Pi]", "/", "12"}]}], "}"}]}], "}"}]}]}], ";"}]], "Input",
 CellLabel->"In[245]:= ",
 CellID->1686874831,ExpressionUUID->"0e7478e0-34bc-b2ae-360c-71cabd4e00f4"],

Cell["\<\
Analyze the parameters evolution with different starting point:\
\>", "Text",
 CellID->1369828235,ExpressionUUID->"107fa139-5ae3-ed74-4004-39635e97b45e"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Chop", "[", "qp", "]"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "Dashed", "}"}], ",", " ", 
      RowBox[{"{", "Dashed", "}"}]}], "}"}]}], ",", " ", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Theta]\), \(1\)]\)\>\"", ",", " ", 
      "\n", "   ", "\"\<\!\(\*SubscriptBox[\(\[Theta]\), \(2\)]\)\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", "\n", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", " ", "\n", 
    "  ", "\"\<Trajectories of the parameters \
\!\(\*SubscriptBox[\(\[Theta]\), \(1\)]\) & \!\(\*SubscriptBox[\(\[Theta]\), \
\(2\)]\)\>\""}], ",", "\n", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", "\n", "   ", 
     RowBox[{
      RowBox[{"PointSize", "[", "Large", "]"}], ",", "\n", "   ", "Black", ",",
       " ", 
      RowBox[{"Point", "[", 
       RowBox[{"{", 
        RowBox[{"Re", "@", 
         RowBox[{"Last", "@", 
          RowBox[{"Last", "@", "qp"}]}]}], "}"}], "]"}], ",", "\n", "   ", 
      RowBox[{"Text", "[", 
       RowBox[{"\"\<\!\(\*SubscriptBox[\(P\), \(final\)]\)\>\"", ",", " ", 
        "\n", "    ", 
        RowBox[{"Re", "@", 
         RowBox[{"Last", "@", 
          RowBox[{"Last", "@", "qp"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "2.5"}]}], "}"}]}], "]"}], ",", "\n", "   ", "Orange", 
      ",", " ", 
      RowBox[{"Point", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "12"}], ",", " ", 
