     "295a1104-8f0a-9295-5f79-896e2abce0ff"]], "TableText",ExpressionUUID->
     "34e49fcf-314b-942d-5c9b-16a940ffff77"], Cell[TextData[{
     "indicate correspondant gradient function ",
     Cell[BoxData[
      RowBox[{"\[Del]", 
