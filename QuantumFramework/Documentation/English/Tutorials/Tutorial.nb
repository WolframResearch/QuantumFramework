Notebook[{

Cell[CellGroupData[{
Cell["Quantum Computation", "Title",
 CellID->509267359,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell["\<\
Quantum computation is the use of quantum mechanical systems to perform \
computations. Wolfram quantum framework aims to simulate a wide range of \
quantum computations in the Wolfram Mathematica.\
\>", "Text",
 CellID->329621944,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell["Basic quantum objects", "Section",
 CellID->515379898,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "75d93363-5da6-51a4-23e6-ab4d5453238e"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2f3e8453-9762-68ea-56c5-1e1d22173a30"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["QuantumBasis"]], 
       "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
       "Wolfram/QuantumFramework Package Symbol"},
      "PackageLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "5902d484-617f-9570-0f31-cdee100bfc5a"]], "TableText",ExpressionUUID->
     "56e0e12c-de7d-6135-7e9f-f889db08301f"], Cell[
    "basis vectors encoding quantum states and operators", "TableText",
     ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3b7807e8-9504-b25a-6907-9eb21cb600a0"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["QuantumState"]], 
       "paclet:Wolfram/QuantumFramework/ref/QuantumState", 
       "Wolfram/QuantumFramework Package Symbol"},
      "PackageLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "166f8969-5e31-e8e5-3e14-21335bc5bacf"]], "TableText",ExpressionUUID->
     "234f1fb7-07c6-bba9-5174-96f1b27009f3"], Cell["\<\
quantum discrete state, defined by an association, a complex vector, or a \
density matrix\
\>", "TableText",ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"], Cell[TextData[Cell[BoxData[
     TemplateBox[{
       Cell[
        TextData["QuantumOperator"]], 
       "paclet:Wolfram/QuantumFramework/ref/QuantumOperator", 
       "Wolfram/QuantumFramework Package Symbol"},
      "PackageLink",
      BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
     "6ec9a758-58be-624c-16f6-3f02594b3096"]], "TableText",ExpressionUUID->
     "23253b8d-1c99-a6bf-52da-b2d7952d0c85"], Cell["\<\
quantum discrete operator, defined by an association or a matrix \
representation\
\>", "TableText",ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "569e173f-6b36-b240-7ea5-8f790ec000aa"], Cell[TextData[Cell[BoxData[
    "QuantumMeasurementOperator"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"]], "TableText",ExpressionUUID->
     "779c57de-bb93-d239-1da4-4e983e27a103"], Cell["\<\
quantum measurement operator, defined by a matrix, a collection of positive \
matrices (POVM) or an eigenbasis (projective)\
\>", "TableText",ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "76dfbc62-92ac-7b6e-1ee4-364c275949b4"], Cell[TextData[Cell[BoxData[
    "QuantumMeasurement"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"]], "TableText",ExpressionUUID->
     "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"], Cell["\<\
description of possible measurement results, containing a probability \
distribution as well as possible quantum states after the measurement\
\>", "TableText",ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"]}
  }]], "2ColumnTableMod",
 CellID->604760901,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell["Basic objects of discrete quantum mechanics.", "Text",
 CellID->1476799103,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"],

Cell[TextData[{
 "A fundamental object in our framework is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumBasis"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],
 ". Quantum states and operators are defined with respect to a basis. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumBasis"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1dbaaaf7-1388-e538-4b59-43b1a622cc02"],
 " can be constructed for any number of qudits, with any dimensionality. \
There are also a set of named basis (e.g., PauliX or Bell) built-in into the \
quantum framework."
}], "Text",
 CellID->448336599,ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell["Define a quantum basis given dimensions (3x5):", "Text",
 CellID->970785311,ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"],

Cell[BoxData[
 RowBox[{"QuantumBasis", "[", 
  RowBox[{"{", 
   RowBox[{"3", ",", " ", "5"}], "}"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->1377816002,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell["Define a quantum basis by an association:", "Text",
 CellID->1439899046,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell[BoxData[
 RowBox[{"QuantumBasis", "[", 
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"0", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], ",", " ", 
    RowBox[{"1", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", "I"}]}], "}"}]}]}], "|>"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->1641200340,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell["There are many named-basis built into the framework:", "Text",
 CellID->1424533854,ExpressionUUID->"1f908cf3-3c70-d55a-45af-25bdb50abfa0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"QuantumBasis", "[", "\"\<I\>\"", "]"}], ",", " ", 
   RowBox[{"QuantumBasis", "[", "\"\<Y\>\"", "]"}], ",", " ", 
   RowBox[{"QuantumBasis", "[", "\"\<Bell\>\"", "]"}], ",", " ", "\n", " ", 
   RowBox[{"QuantumBasis", "[", "\"\<Dirac\>\"", "]"}], ",", " ", 
   RowBox[{"QuantumBasis", "[", "\"\<Schwinger\>\"", "]"}], ",", " ", "\n", 
   " ", 
   RowBox[{"QuantumBasis", "[", "\"\<Wigner\>\"", "]"}]}], "}"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->535457321,ExpressionUUID->"5dac66ba-272d-3627-0b54-7fe452d99d0d"],

Cell[TextData[{
 "There are many properties that can be extracted from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumBasis"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 " object. For example:"
}], "Text",
 CellID->141959522,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"basis", " ", "=", " ", 
   RowBox[{"QuantumBasis", "[", "3", "]"}]}], ";"}], "\n", 
 RowBox[{"Normal", " ", "/@", " ", 
  RowBox[{"basis", "[", "\"\<ElementAssociation\>\"", "]"}]}]}], "Input",
 CellLabel->"In[4]:= ",
 CellID->299517738,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumBasis"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "35077f55-9291-6519-633d-771f27244c63"],
 " supports cases with input and output:"
}], "Text",
 CellID->2142391071,ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell[BoxData[
 RowBox[{"QuantumBasis", "[", 
  RowBox[{
   RowBox[{"{", "2", "}"}], ",", " ", 
   RowBox[{"{", "3", "}"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->1002769646,ExpressionUUID->"65de4a87-3471-cd9f-13e6-63e1bd0597e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"#", "[", "\"\<Input\>\"", "]"}], ",", " ", 
     RowBox[{"#", "[", "\"\<Output\>\"", "]"}]}], "}"}], " ", "&"}], "@", 
  RowBox[{"QuantumBasis", "[", 
   RowBox[{
    RowBox[{"{", "2", "}"}], ",", " ", 
    RowBox[{"{", "3", "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->436346740,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell[TextData[{
 "A quantum state is represented by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumState"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumState", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 " object and a quantum operator is represented by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumOperator"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumOperator", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 "."
}], "Text",
 CellID->2122865143,ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],

Cell["\<\
Define a pure 2-dimensional quantum state (qubit) in Pauli-X basis:\
\>", "Text",
 CellID->1735808809,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],

Cell[BoxData[
 RowBox[{"QuantumState", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", 
     RowBox[{"-", "I"}]}], "}"}], ",", " ", "\"\<X\>\""}], "]"}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->753514147,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell[BoxData[
 RowBox[{"%", "[", "\"\<Amplitudes\>\"", "]"}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->1164297175,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell["\<\
If the basis is not specified, the default is the computational basis:\
\>", "Text",
 CellID->632614636,ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"state", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<RandomPure\>\"", "[", "3", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"state", "[", "\"\<Formula\>\"", "]"}]}], "Input",
 CellLabel->"In[9]:= ",
 CellID->1689610856,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell["Many named states are available for easy access:", "Text",
 CellID->1303163127,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"QuantumState", "[", "\"\<UniformSuperposition\>\"", "]"}], ",", 
   " ", 
   RowBox[{"QuantumState", "[", "\"\<PsiPlus\>\"", "]"}], ",", " ", "\n", " ", 
   RowBox[{"QuantumState", "[", "\"\<GHZ\>\"", "]"}]}], "}"}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->2098230307,ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"],

Cell["\<\
We can also define a qubit state by specifying a Bloch vector:\
\>", "Text",
 CellID->1930159659,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell[BoxData[
 RowBox[{"QuantumState", "[", 
  RowBox[{"\"\<BlochVector\>\"", "[", 
   RowBox[{"{", 
    RowBox[{".1", ",", " ", ".2", ",", " ", ".3"}], "}"}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->1113655915,ExpressionUUID->"337c2d89-644e-5b5e-6103-c4d30dfb29a4"],

Cell["\<\
Define a quantum operator by a matrix, basis, and order. The order is the \
information about which subsystems the operator would act on. For example \
order {1,2} means it would act on subsystem 1 and 2. If the basis is not \
specified, the default is the computational basis.\
\>", "Text",
 CellID->1606118752,ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],

Cell[BoxData[
 RowBox[{"QuantumOperator", "[", 
  RowBox[{"\"\<CNOT\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", "\"\<XI\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->2141499446,ExpressionUUID->"644cc522-c7c4-9b18-0c73-dc8ff276e662"],

Cell["Define operator by names:", "Text",
 CellID->339082558,ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<H\>\"", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
   RowBox[{"QuantumOperator", "[", "\"\<CNOT\>\"", "]"}], ",", " ", "\n", " ", 
   RowBox[{"QuantumOperator", "[", "\"\<Toffoli\>\"", "]"}]}], "}"}]], "Input",\

 CellLabel->"In[13]:= ",
 CellID->432388834,ExpressionUUID->"6801f052-da94-0b6f-183e-ea1fdf2159b5"],

Cell["Extract properties of operator:", "Text",
 CellID->443736588,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"operator", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<CNOT\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"operator", "[", "\"\<Table\>\"", "]"}]}], "Input",
 CellLabel->"In[14]:= ",
 CellID->1593449978,ExpressionUUID->"7b6211f5-475c-1194-2911-88bf72e963fe"],

Cell[BoxData[
 RowBox[{"operator", "[", "\"\<HermitianQ\>\"", "]"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->1742646261,ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumOperator"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumOperator", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],
 " can operate on a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumState"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumState", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],
 ":"
}], "Text",
 CellID->29467524,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumOperator", "[", "\"\<H\>\"", "]"}], "[", 
  RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->1939141443,ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

Cell[TextData[{
 "In Wolfram quantum framework, a measurement is represented by ",
 Cell[BoxData["QuantumMeasurementOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f417ec-7166-d78d-038b-8eb60010bdd7"],
 " and ",
 Cell[BoxData["QuantumMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 "."
}], "Text",
 CellID->5047578,ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell["\<\
Define a measurement operator on the 2nd qubit (in computational basis):\
\>", "Text",
 CellID->15008895,ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell[BoxData[
 RowBox[{"QuantumMeasurementOperator", "[", 
  RowBox[{"{", "2", "}"}], "]"}]], "Input",
 CellLabel->"In[17]:= ",
 CellID->1892712309,ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell["Define measurement operator by names:", "Text",
 CellID->787969749,ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],

Cell[BoxData[{
 RowBox[{"QuantumMeasurementOperator", "[", "\"\<X\>\"", "]"}], "\n", 
 RowBox[{"QuantumMeasurementOperator", "[", "\"\<QBismSICPOVM\>\"", 
  "]"}]}], "Input",
 CellLabel->"In[18]:= ",
 CellID->525088789,ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

Cell[TextData[{
 "Define measurement operator by a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumBasis"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 " object (as an eigenbasis) and a list of eigenvalues:"
}], "Text",
 CellID->357930410,ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell[BoxData[
 RowBox[{"qmo", " ", "=", " ", 
  RowBox[{"QuantumMeasurementOperator", "[", 
   RowBox[{"\"\<Bell\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[19]:= ",
 CellID->1802489801,ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qmo", "[", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3", ",", " ", "0", ",", " ", "I"}], "}"}], ",", 
     " ", "\"\<Bell\>\""}], "]"}], "]"}], "[", 
  RowBox[{"\"\<ProbabilityPlot\>\"", ",", " ", "\n", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "4"}]}]}], "]"}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->115301326,ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell["Define a POVM measurement:", "Text",
 CellID->1651187567,ExpressionUUID->"14fd1512-f616-8834-3c82-8d5f83a0db1e"],

Cell[BoxData[
 RowBox[{"povm", " ", "=", " ", 
  RowBox[{
  "QuantumMeasurementOperator", "[", "\"\<TetrahedronSICPOVM\>\"", 
   "]"}]}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->941376513,ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"povm", "[", 
   RowBox[{"QuantumState", "[", "\"\<RandomPure\>\"", "]"}], "]"}], 
  "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->2120243592,ExpressionUUID->"48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],

Cell[TextData[{
 "When ",
 Cell[BoxData["QuantumMeasurementOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58ee7ecb-1370-1005-0896-7795a605636f"],
 " acts on ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumState"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumState", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],
 ", ",
 Cell[BoxData["QuantumMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],
 " is generated:"
}], "Text",
 CellID->1047559317,ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell[BoxData[
 RowBox[{"result", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumMeasurementOperator", "[", "\"\<X\>\"", "]"}], "[", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", " ", "0.6"}], "}"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->1820947576,ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],

Cell[BoxData[
 RowBox[{"result", "[", 
  RowBox[{"\"\<ProbabilityPlot\>\"", ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "4"}]}]}], "]"}]], "Input",
 CellLabel->"In[24]:= ",
 CellID->670734585,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell["\<\
There are two ways we can perform multiqubit measurements. The first method \
is sequential measurement:\
\>", "Text",
 CellID->58232708,ExpressionUUID->"5e187950-8ca2-2ab2-0638-711a25577898"],

Cell[BoxData[
 RowBox[{"result1", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumMeasurementOperator", "[", "]"}], "[", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<RandomPure\>\"", "[", "2", "]"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[25]:= ",
 CellID->393464600,ExpressionUUID->"250a2d7c-9b81-05b0-5309-c5261e346f9a"],

Cell[BoxData[
 RowBox[{"result2", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumMeasurementOperator", "[", 
    RowBox[{"{", "2", "}"}], "]"}], "[", "result1", "]"}]}]], "Input",
 CellLabel->"In[26]:= ",
 CellID->1484396876,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell[BoxData[
 RowBox[{"result2", "[", 
  RowBox[{"\"\<ProbabilityPlot\>\"", ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "4"}]}]}], "]"}]], "Input",
 CellLabel->"In[27]:= ",
 CellID->1149283354,ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

Cell[TextData[{
 "To define the state of non-interacting subsystem or to define local \
operations on composite system, ",
 Cell[BoxData["QuantumTensorProduct"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43821c38-6720-b4f9-71b1-966212da1ec3"],
 " is used. It can performs tensor product on bases, states, or operators."
}], "Text",
 CellID->1092188694,ExpressionUUID->"341c54d9-3079-6bba-5c24-4d83410c3980"],

Cell["Tensor product of states and bases:", "Text",
 CellID->559599970,ExpressionUUID->"1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],

Cell[BoxData[
 RowBox[{"QuantumTensorProduct", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", 
    RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}]}], "}"}], "]"}]], "Input",\

 CellLabel->"In[28]:= ",
 CellID->1710123944,ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"],

Cell[BoxData[
 RowBox[{"QuantumTensorProduct", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"QuantumBasis", "[", "\"\<X\>\"", "]"}], ",", " ", 
    RowBox[{"QuantumBasis", "[", "\"\<Y\>\"", "]"}]}], "}"}], "]"}]], "Input",\

 CellLabel->"In[29]:= ",
 CellID->934597701,ExpressionUUID->"6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],

Cell[TextData[{
 "Tensor product of operators (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumOperator"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumOperator", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5077c06e-c394-b43c-000c-da4bf6261f06"],
 " or ",
 Cell[BoxData["QuantumMeasurementOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07359582-e823-44a1-2eca-0cef89d62e8b"],
 "):"
}], "Text",
 CellID->284780108,ExpressionUUID->"7c239bd0-3ff5-3b18-25d0-129ab9818662"],

Cell[BoxData[
 RowBox[{"QuantumTensorProduct", "[", 
  RowBox[{
   RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], ",", " ", 
   RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], "]"}]], "Input",
 CellLabel->"In[30]:= ",
 CellID->643798763,ExpressionUUID->"68c76573-72ce-0c1a-18fd-7d3d077b5760"],

Cell[BoxData[
 RowBox[{"QuantumTensorProduct", "[", "\n", " ", 
  RowBox[{
   RowBox[{"QuantumMeasurementOperator", "[", "\"\<X\>\"", "]"}], ",", " ", 
   RowBox[{"QuantumMeasurementOperator", "[", "\"\<Y\>\"", "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[31]:= ",
 CellID->268959046,ExpressionUUID->"6184d2f2-049e-728e-17bb-cbbcad2b40d4"],

Cell[TextData[{
 "The representation of quantum state and operator can be changed according \
to any basis transformation. Basis transformation is applicable to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumState"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumState", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4fd967ef-5008-0b29-75e7-7ec961bd5673"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumOperator"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumOperator", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "19bb1c5e-57ab-6e36-4f58-9618625e351c"],
 ", and ",
 Cell[BoxData["QuantumMeasurementOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],
 " as demonstrated below:"
}], "Text",
 CellID->403125484,ExpressionUUID->"30baa1c8-66ad-75e0-6059-389213585fca"],

Cell["Basis change for a quantum state:", "Text",
 CellID->931950651,ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"],

Cell[BoxData[
 RowBox[{"QuantumState", "[", 
  RowBox[{
   RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}], ",", " ", "\"\<Y\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[32]:= ",
 CellID->412518898,ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell["Basis change for a quantum operator:", "Text",
 CellID->622967176,ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"],

Cell[BoxData[
 RowBox[{"QuantumOperator", "[", 
  RowBox[{
   RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], ",", 
   " ", "\"\<Y\>\""}], "]"}]], "Input",
 CellLabel->"In[33]:= ",
 CellID->1358080856,ExpressionUUID->"511b3347-8d7d-ab60-0738-ab212409f64a"],

Cell["\<\
One can do more operations on quantum operators and the result will be a \
QuantumOperator:\
\>", "Text",
 CellID->320615307,ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"],

Cell[BoxData[
 RowBox[{"op", " ", "=", " ", 
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", "I"}], " ", 
    RowBox[{"\[Phi]", "/", "2"}], " ", 
    RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[34]:= ",
 CellID->1594238871,ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"op", " ", "==", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<RX\>\"", "[", "\[Phi]", "]"}], "]"}]}], " ", "//", " ", 
  "FullSimplify"}]], "Input",
 CellLabel->"In[35]:= ",
 CellID->2002505366,ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"],

Cell["Advanced quantum objects", "Section",
 CellID->2121396920,ExpressionUUID->"5900aac7-5263-773e-0f3f-43a167165a04"],

