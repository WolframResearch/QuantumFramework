   {Cell["      ", "ModInfo",ExpressionUUID->
     "06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"12d95fcb-3316-2212-42e7-569546a37178"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"733995c2-f5bf-78ee-22c6-0caffc4a4a34"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4f8ab258-7e7f-0723-7589-34027b0a6a09"], Cell[TextData[Cell[BoxData[
    "QuantumCircuitOperator"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6b12ee74-9953-131d-1921-003e18e67e67"]], "TableText",ExpressionUUID->
     "65262d3c-fccc-1dc6-0cdd-c579f579672c"], Cell[
    "quantum circuit as a list of quantum operations", "TableText",
     ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"]},
