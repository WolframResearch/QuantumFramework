Cell["Decoherence and the Best Pulse Length", "Section",
 CellID->1047559317,ExpressionUUID->"7c239bd0-3ff5-3b18-25d0-129ab9818662"],

Cell[TextData[{
 "Leakage falls with the pulse length, and decay and dephasing grow with it. \
Energy decay enters as the jump operator ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c76573-72ce-0c1a-18fd-7d3d077b5760"],
 " at rate ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6184d2f2-049e-728e-17bb-cbbcad2b40d4"],
 ", which empties level ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fd967ef-5008-0b29-75e7-7ec961bd5673"],
 " at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "/", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19bb1c5e-57ab-6e36-4f58-9618625e351c"],
 ". Pure dephasing enters as ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["b", "TI"], "\[Dagger]"], 
   StyleBox["b", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],
 " at rate ",
 Cell[BoxData[
  RowBox[{"2", "/", 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["\[Phi]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30baa1c8-66ad-75e0-6059-389213585fca"],
 ", with ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["\[Phi]", "TI"]], "=", "1", "/", 
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "-", "1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SubscriptBox[
     StyleBox["T", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52535901-cb26-8b9c-0261-516aeed0d9e6"],
 ". Both coherence times, 100 \[Mu]s, in nanoseconds:"
}], "Text",
 CellID->1820947576,ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

