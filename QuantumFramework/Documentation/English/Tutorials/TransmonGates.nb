Cell[TextData[{
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
 " = 1 cuts the leakage by a factor of 80 but leaves 8% of the population \
short of |1\:27e9. A scan over ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58ee7ecb-1370-1005-0896-7795a605636f"],
 " shows the two errors reaching their minima at different values:"
}], "Text",
 CellID->787969749,ExpressionUUID->"11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],

