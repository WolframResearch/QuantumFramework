Cell[TextData[{
 "The leakage is smallest just above ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],
 " = 1, and the transfer error near ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b45e796-37a7-eecc-197a-fed04253b416"],
 " = 0.6, so no single ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 " serves both. A detuning ",
 Cell[BoxData[
  StyleBox["\[Delta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 " added to the search resolves this. The transfer error as a function of the \
three controls:"
}], "Text",
 CellID->357930410,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"transferError", "[", 
   RowBox[{
    RowBox[{"drag_", "?", "NumericQ"}], ",", " ", 
    RowBox[{"detuning_", "?", "NumericQ"}], ",", " ", 
    RowBox[{"length_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
  RowBox[{"1", " ", "-", " ", 
   RowBox[{
    RowBox[{"populations", "[", 
     RowBox[{"drag", ",", " ", "detuning", ",", " ", "length"}], "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->1802489801,ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

Cell["The best DRAG coefficient and detuning for a 12 ns pulse:", "Text",
 CellID->115301326,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"optimum", " ", "=", " ", 
  RowBox[{"FindMinimum", "[", 
   RowBox[{
    RowBox[{"transferError", "[", 
     RowBox[{"drag", ",", " ", "detuning", ",", " ", "12"}], "]"}], ",", " ", 
    
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"drag", ",", " ", "0.75"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"detuning", ",", " ", "0.03"}], "}"}]}], "}"}], ",", " ", 
    RowBox[{"Method", " ", "->", " ", "\"\<PrincipalAxis\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[17]:= ",
