Cell[TextData[{
 "A drive couples neighboring levels with strengths 1, ",
 Cell[BoxData[
  SqrtBox["2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],
 ", ",
 Cell[BoxData[
  SqrtBox["3"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "779c57de-bb93-d239-1da4-4e983e27a103"],
 " and 2, so it drives the transition from |1\:27e9 to |2\:27e9 more strongly \
than the qubit transition:"
}], "Text",
 CellID->1641200340,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

