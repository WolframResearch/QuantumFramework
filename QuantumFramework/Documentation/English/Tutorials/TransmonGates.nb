Cell["\<\
Leakage falls by more than four orders of magnitude between 4 and 24 ns, but \
even at 24 ns a pulse without DRAG leaves 1.1 \[Times] 10\:207b\:2075 of the \
population in |2\:27e9.\
\>", "Text",
 CellID->1939141443,ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],

Cell["DRAG", "Section",
 CellID->5047578,ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

Cell[TextData[{
 "To first order in ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 ", the DRAG quadrature removes the leakage at ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04786d0e-016a-d127-2c07-8568b01ca00d"],
 " = 1. The transfer error counts the population that does not reach \
|1\:27e9, leakage included. Leakage and transfer error at 8 ns for ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],
 " = 0, 1/2 and 1:"
}], "Text",
 CellID->15008895,ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"With", "[", 
