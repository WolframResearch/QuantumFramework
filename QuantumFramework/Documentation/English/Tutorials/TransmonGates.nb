Cell[TextData[{
 "In the rotating frame the qubit levels |0\:27e9 and |1\:27e9 are \
degenerate, and the higher levels are shifted by ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
 ", ",
 Cell[BoxData[
  RowBox[{"3", 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],
 " and ",
 Cell[BoxData[
  RowBox[{"6", 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ec9a758-58be-624c-16f6-3f02594b3096"],
 ":"
}], "Text",
 CellID->1377816002,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixForm", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Alpha]", "/", "2"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"b", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
        RowBox[{
         RowBox[{"b", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
         RowBox[{"b", " ", "@", " ", "b"}]}]}], ")"}]}], ")"}], 
    "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->293863717,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

