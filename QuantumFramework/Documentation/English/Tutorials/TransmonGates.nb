Cell[TextData[{
 "The transfer error falls to 2.1 \[Times] 10\:207b\:2074 at ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f449897-1a0e-51e7-357b-11d19fbb23cd"],
 " = 0.70 and a detuning of 0.030 rad/ns, 4.7 MHz. Without DRAG, the best \
detuning at 12 ns leaves ten times the error:"
}], "Text",
 CellID->941376513,ExpressionUUID->"6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"noDRAG", " ", "=", " ", 
