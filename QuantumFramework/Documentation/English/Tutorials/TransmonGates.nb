Cell["Five Levels Are Enough", "Section",
 CellID->50259360,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell[TextData[{
 "Every result above keeps five levels. The leakage of the 8 ns pulse without \
DRAG, for a transmon truncated to ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "594776df-9e75-d16a-0f7d-6f991b01a3b0"],
 " levels:"
}], "Text",
 CellID->680111415,ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"leakageWithLevels", "[", "d_", "]"}], " ", ":=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"AnnihilationOperator", "[", "d", "]"}]}], "}"}], ",", "\n", 
    "  ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"QuantumEvolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"anharmonicity", "/", "2"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"a", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
             RowBox[{
              RowBox[{"a", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
              RowBox[{"a", " ", "@", " ", "a"}]}]}], ")"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"envelope", " ", "/.", " ", 
               RowBox[{"\[Tau]", " ", "->", " ", "8"}]}], ")"}], "/", "2"}], 
            ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"a", " ", "+", " ", 
             RowBox[{"a", "[", "\"\<Dagger\>\"", "]"}]}], ")"}]}]}], ",", 
         "\n", "    ", 
         RowBox[{"FockState", "[", 
          RowBox[{"0", ",", " ", "d"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "8"}], "}"}]}], "]"}], "[", 
       "8", "]"}], "[", "\"\<ProbabilitiesList\>\"", "]"}], "[", 
     RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[30]:= ",
 CellID->1912025938,ExpressionUUID->"6878c7f8-419e-9db5-1807-dea27028e79f"],

