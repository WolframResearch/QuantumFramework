Cell["The Pulse", "Section",
 CellID->535457321,ExpressionUUID->"4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],

Cell[TextData[{
 "The drive has the cosine envelope ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["\[Pi]", 
    StyleBox["\[Tau]", "TI"]], "(", 
   RowBox[{"1", "-", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    FractionBox[
     RowBox[{"2", "\[Pi]", 
      StyleBox["t", "TI"]}], 
     StyleBox["\[Tau]", "TI"]]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "741b091d-feb2-1a39-1c38-a146fb476903"],
 ", which starts and ends at zero. DRAG (Motzoi, Gambetta, Rebentrost and \
Wilhelm, 2009) adds an out-of-phase quadrature proportional to the derivative \
of the envelope, and a detuning ",
 Cell[BoxData[
  StyleBox["\[Delta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf5a20e-c541-e06e-698a-446becf5b2b4"],
 " moves the drive off the qubit frequency:"
}], "Text",
 CellID->141959522,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    StyleBox["\[Alpha]", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["b", "TI"], "\[Dagger]"], 
   SuperscriptBox[
    StyleBox["b", "TI"], "\[Dagger]"], 
   StyleBox["b", "TI"], 
   StyleBox["b", "TI"], "+", 
   StyleBox["\[Delta]", "TI"], 
   SuperscriptBox[
    StyleBox["b", "TI"], "\[Dagger]"], 
   StyleBox["b", "TI"], "+", 
   FractionBox[
    RowBox[{"\[CapitalOmega]", 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], "(", 
   RowBox[{
    StyleBox["b", "TI"], "+", 
    SuperscriptBox[
     StyleBox["b", "TI"], "\[Dagger]"]}], ")", "-", 
   FractionBox[
    RowBox[{
     StyleBox["\[Lambda]", "TI"], 
     OverscriptBox["\[CapitalOmega]", "."], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{"2", 
     StyleBox["\[Alpha]", "TI"]}]], 
   StyleBox["i", "TI"], "(", 
   RowBox[{
    SuperscriptBox[
     StyleBox["b", "TI"], "\[Dagger]"], "-", 
    StyleBox["b", "TI"]}], ")"}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->299517738,ExpressionUUID->"3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],

Cell[TextData[{
 "The envelope, with ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbaaaf7-1388-e538-4b59-43b1a622cc02"],
 " the pulse length:"
}], "Text",
 CellID->2142391071,ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"envelope", " ", "=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"Pi", "/", "\[Tau]"}], ")"}], " ", 
