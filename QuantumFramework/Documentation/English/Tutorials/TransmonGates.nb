Cell["\<\
The transfer error with decay and dephasing, from the Lindblad master \
equation:\
\>", "Text",
 CellID->1484396876,ExpressionUUID->"5900aac7-5263-773e-0f3f-43a167165a04"],

Cell[BoxData[
 RowBox[{
  RowBox[{"openError", "[", 
   RowBox[{
    RowBox[{"drag_", "?", "NumericQ"}], ",", " ", 
    RowBox[{"detuning_", "?", "NumericQ"}], ",", " ", 
    RowBox[{"length_", "?", "NumericQ"}]}], "]"}], " ", ":=", "\n", "  ", 
  RowBox[{"1", " ", "-", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"QuantumEvolve", "[", 
       RowBox[{
        RowBox[{"model", "[", 
         RowBox[{
         "anharmonicity", ",", " ", "drag", ",", " ", "detuning", ",", " ", 
          "length"}], "]"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"b", ",", " ", 
           RowBox[{
            RowBox[{"b", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", "b"}]}],
           "}"}], " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "T1"}], ",", " ", 
           RowBox[{"2", "/", "dephasingTime"}]}], "}"}]}], ",", " ", 
        RowBox[{"FockState", "[", 
         RowBox[{"0", ",", " ", "5"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", ",", " ", "length"}], "}"}]}], "]"}], "[",
       "length", "]"}], "[", "\"\<ProbabilitiesList\>\"", "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->1149283354,ExpressionUUID->"06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],

Cell["At the 12 ns optimum, decoherence adds 6 \[Times] 10\:207b\:2075:", \
"Text",
 CellID->1092188694,ExpressionUUID->"12d95fcb-3316-2212-42e7-569546a37178"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"openError", "[", 
  RowBox[{
   RowBox[{"drag", " ", "/.", " ", 
    RowBox[{"Last", "[", "optimum", "]"}]}], ",", " ", 
   RowBox[{"detuning", " ", "/.", " ", 
    RowBox[{"Last", "[", "optimum", "]"}]}], ",", " ", "12"}], "]"}]], "Input",\

 CellLabel->"In[22]:= ",
 CellID->282054156,ExpressionUUID->"733995c2-f5bf-78ee-22c6-0caffc4a4a34"],

Cell[BoxData["0.0002768221344375821`"], "Output",
 CellLabel->"Out[22]= ",
 CellID->1959731966,ExpressionUUID->"4f8ab258-7e7f-0723-7589-34027b0a6a09"]
}, Open  ]],

Cell[TextData[{
 "Across pulse lengths, ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b12ee74-9953-131d-1921-003e18e67e67"],
 " is held at its 12 ns optimum: it is dimensionless, and the derivative term \
scales with the pulse by itself. The detuning compensates a shift that grows \
with the drive power, which goes as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SuperscriptBox[
    StyleBox["\[Tau]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65262d3c-fccc-1dc6-0cdd-c579f579672c"],
 ", so it is optimized again at each length, starting from the 12 ns value \
scaled by ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"12", "/", 
     StyleBox["\[Tau]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e157ee2-48da-d240-062b-77cc696ca0aa"],
 ". The error with decoherence at the best detuning:"
}], "Text",
 CellID->1710123944,ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bestError", "[", 
   RowBox[{
    RowBox[{"drag_", "?", "NumericQ"}], ",", " ", 
    RowBox[{"reference_", "?", "NumericQ"}], ",", " ", 
    RowBox[{"length_", "?", "NumericQ"}]}], "]"}], " ", ":=", "\n", "  ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"opt", " ", "=", " ", 
      RowBox[{"FindMinimum", "[", 
       RowBox[{
        RowBox[{"transferError", "[", 
         RowBox[{"drag", ",", " ", "detuning", ",", " ", "length"}], "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"detuning", ",", " ", 
          RowBox[{"reference", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"12", "/", "length"}], ")"}], "^", "2"}]}]}], "}"}], ",",
         " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<PrincipalAxis\>\""}]}], 
       "]"}]}], "}"}], ",", "\n", "    ", 
    RowBox[{"openError", "[", 
     RowBox[{"drag", ",", " ", 
      RowBox[{"detuning", " ", "/.", " ", 
       RowBox[{"Last", "[", "opt", "]"}]}], ",", " ", "length"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->934597701,ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"],

