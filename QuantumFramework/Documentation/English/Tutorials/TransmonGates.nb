Cell["The pure dephasing time:", "Text",
 CellID->58232708,ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dephasingTime", " ", "=", " ", 
  RowBox[{"1", "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"1", "/", "T2"}], " ", "-", " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "T1"}], ")"}]}]}], ")"}]}]}]], "Input",
