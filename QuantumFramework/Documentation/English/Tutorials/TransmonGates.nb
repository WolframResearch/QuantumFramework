Cell[TextData[{
 "Pulses are compared through a function of the three controls. Numeric code \
here names them ",
 Cell[BoxData["drag"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66b4bee0-d247-b105-0e4b-37cde7f3006f"],
 ", ",
 Cell[BoxData["detuning"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 " and ",
 Cell[BoxData["length"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 " rather than ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Delta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 ": ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Table"]], "paclet:ref/Table"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0daf8e98-7628-e40b-3b54-27c203c2cf51"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindMinimum"]], "paclet:ref/FindMinimum"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 " localize their variables dynamically, so iterating over ",
 Cell[BoxData["\[Tau]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],
 " would also set it inside ",
 Cell[BoxData["model"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],
 ". The final populations for a given DRAG coefficient, detuning and length:"
}], "Text",
 CellID->339082558,ExpressionUUID->"5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"populations", "[", 
   RowBox[{
    RowBox[{"drag_", "?", "NumericQ"}], ",", " ", 
    RowBox[{"detuning_", "?", "NumericQ"}], ",", " ", 
    RowBox[{"length_", "?", "NumericQ"}]}], "]"}], " ", ":=", "\n", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumEvolve", "[", 
     RowBox[{
      RowBox[{"model", "[", 
       RowBox[{
       "anharmonicity", ",", " ", "drag", ",", " ", "detuning", ",", " ", 
        "length"}], "]"}], ",", " ", 
      RowBox[{"FockState", "[", 
       RowBox[{"0", ",", " ", "5"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "0", ",", " ", "length"}], "}"}]}], "]"}], "[", 
    "length", "]"}], "[", "\"\<ProbabilitiesList\>\"", "]"}]}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->432388834,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

