Notebook[{

Cell[CellGroupData[{
Cell["Connecting to QPU Services", "Title",
 CellID->509267359,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 "The ",
 ButtonBox["Wolfram Quantum Framework",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/quantum-computation-framework/"], None}],
 " lets you build, simulate and analyze quantum circuits symbolically and \
numerically. The same circuit object can also be sent to real quantum \
processing units (QPUs) hosted in the cloud. This tutorial covers the three \
pieces you need for that: ",
 ButtonBox["OpenQASM",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://openqasm.com/"], None}],
 ", the portable text format that QPUs speak; the ",
 ButtonBox["IBM Quantum",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.ibm.com/quantum"], None}],
 " platform; and ",
 ButtonBox["Amazon Braket",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://aws.amazon.com/braket/"], None}],
 ", which exposes several hardware vendors through a single service."
}], "Text",
 CellID->329621944,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell["\<\
Everything in the OpenQASM section runs locally with no account. The hardware \
sections need credentials with the respective provider, and those cells are \
marked so you can read the tutorial without running them. For help, write to \
quantum@wolfram.com.\
\>", "Text",
 CellID->515379898,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell[BoxData[
 RowBox[{"<<", " ", "Wolfram`QuantumFramework`"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->604760901,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell["OpenQASM: the common language of QPUs", "Section",
 CellID->1476799103,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell[TextData[{
 "A quantum circuit built in the Wolfram Language is a symbolic object. To \
run it on hardware it has to be expressed in a format the device understands, \
and the de facto standard is OpenQASM. Both IBM and Amazon Braket accept \
OpenQASM, so it is the bridge between a ",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 " and the cloud."
}], "Text",
 CellID->448336599,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell[TextData[{
 "Build a small reference circuit that we reuse throughout: a three-qubit GHZ \
state ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["GHZ", FontSlant -> "Plain"]},
    "Ket"], "=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox["2"]], 
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{"000"},
       "Ket"], "+", 
      TemplateBox[{"111"},
       "Ket"]}], ")"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5902d484-617f-9570-0f31-cdee100bfc5a"],
 ", followed by a quantum Fourier transform and a measurement of all three \
qubits."
}], "Text",
 CellID->970785311,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<GHZ\>\"", ",", " ", 
      RowBox[{"\"\<Fourier\>\"", "[", "3", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"qc", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[2]:= ",
 CellID->1377816002,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell[TextData[{
 Cell[BoxData["QuantumQASM"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 " is the single hub for OpenQASM. Called on a circuit with no extra \
arguments it emits OpenQASM ",
 StyleBox["3.0",
  FontWeight->"Bold"],
 " natively, in pure Wolfram Language with no external dependency, \
serializing the circuit exactly as built. Measurements become classical-bit \
assignments:"
}], "Text",
 CellID->1439899046,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"],

Cell[BoxData[
 RowBox[{"QuantumQASM", "[", "qc", "]"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->1641200340,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[TextData[{
 "The hub is also an importer: handing OpenQASM source (or a ",
 Cell[".qasm", "InlineCode",ExpressionUUID->
  "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
 " file) back to ",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],
 " reconstructs the circuit, again with no external dependency. The round \
trip recovers a circuit equal to the original:"
}], "Text",
 CellID->1424533854,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"QuantumQASM", "[", "qc", "]"}], "]"}], " ", "==", " ", 
  "qc"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->535457321,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell[TextData[{
 "OpenQASM 3.0 is the native and recommended target. For older toolchains \
that still require the legacy ",
 Cell["qelib1.inc", "InlineCode",ExpressionUUID->
  "6e84829b-9667-6594-16bb-1bc523124ffe"],
 " gate set, pass ",
 Cell[BoxData[
  RowBox[{"\"\<Version\>\"", " ", "->", " ", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e173f-6b36-b240-7ea5-8f790ec000aa"],
 " to emit OpenQASM 2.0. This path renders through Qiskit, so it needs the \
Python Qiskit stack configured:"
}], "Text",
 CellID->141959522,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

Cell[BoxData[
 RowBox[{"QuantumQASM", "[", 
  RowBox[{"qc", ",", " ", 
   RowBox[{"\"\<Version\>\"", " ", "->", " ", "2"}]}], "]"}]], "Input",
 CellID->299517738,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell["IBM Quantum", "Section",
 CellID->2142391071,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell["Connecting to the IBM Quantum Platform", "Subsection",
 CellID->1002769646,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell[TextData[{
 "Create an account at ",
 ButtonBox["quantum.cloud.ibm.com",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://quantum.cloud.ibm.com/"], None}],
 ". From the dashboard you need two things: an ",
 StyleBox["IAM API key",
  FontWeight->"Bold"],
 " (the long secret string shown once when you create the key, not the key's \
display name) and the ",
 StyleBox["instance CRN",
  FontWeight->"Bold"],
 " (a ",
 Cell[BoxData[
  RowBox[{"crn", ":", "v1", ":", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],
 " string identifying your instance)."
}], "Text",
 CellID->436346740,ExpressionUUID->"4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],

Cell["\<\
The API key is a secret and is stored in your encrypted system credential \
store. The CRN is read from a local symbol that the connection consults when \
it builds the request headers, so set both before connecting:\
\>", "Text",
 CellID->2122865143,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"api", " ", "=", " ", "\"\<XXX\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LocalSymbol", "[", "\"\<ibm_crn\>\"", "]"}], " ", "=", 
   " ", "\"\<XXX\>\""}], ";"}]}], "Input",
 CellID->1735808809,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell[TextData[{
 "Loading the Wolfram Quantum Framework registers the IBM Quantum Platform \
service automatically, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ServiceConnect"]], "paclet:ref/ServiceConnect"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "07964fa7-8d1e-ff14-2dae-660124a8c27e"],
 " recognizes the ",
 Cell[BoxData["\"\<IBMQuantumPlatform\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],
 " name directly:"
}], "Text",
 CellID->753514147,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell[BoxData[
 RowBox[{"ibm", " ", "=", " ", 
  RowBox[{"ServiceConnect", "[", 
   RowBox[{"\"\<IBMQuantumPlatform\>\"", ",", " ", "\"\<New\>\"", ",", " ", 
    RowBox[{"Authentication", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<apikey\>\"", " ", "->", " ", "api"}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellID->1164297175,ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell[TextData[{
 "A connected service object lists the QPUs your account can reach through ",
 Cell[BoxData["\"\<Backends\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04646437-faee-7dfc-2c1c-7e70fe9b47c6"],
 ". Submitting and retrieving jobs is handled for you by ",
 Cell[BoxData["IBMJobSubmit"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbde497-e826-5557-4442-fdd089d33fbd"],
 " and the ",
 Cell[BoxData["IBMJob"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],
 " handle, shown below. List the available backends:"
}], "Text",
 CellID->632614636,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell[BoxData[
 RowBox[{"ibm", "[", "\"\<Backends\>\"", "]"}]], "Input",
 CellID->1689610856,ExpressionUUID->"1f908cf3-3c70-d55a-45af-25bdb50abfa0"],

Cell["Inspecting a backend", "Subsection",
 CellID->1303163127,ExpressionUUID->"5dac66ba-272d-3627-0b54-7fe452d99d0d"],

Cell[TextData[{
 "Before committing a circuit to a device, you can see its live calibration \
as an error map: the qubit lattice with the ",
 Cell[BoxData["cz"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 " gate error, the static ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Z", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d004f9-29e5-6665-1eef-9da34f904d4f"],
 " crosstalk, the relaxation time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c76c797-c249-79ca-540d-ded0f7fc4b10"],
 ", and the readout error painted on at once. This reads only the free \
metadata endpoints, so it runs no circuit and spends no quantum time."
}], "Text",
 CellID->2098230307,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell[BoxData[
 RowBox[{"ibm", "[", 
  RowBox[{"\"\<ErrorMap\>\"", ",", " ", 
   RowBox[{"\"\<Backend\>\"", " ", "->", " ", "\"\<ibm_fez\>\""}]}], 
  "]"}]], "Input",
 CellID->1930159659,ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell[TextData[{
 "The same calibration is available as data through ",
 Cell[BoxData[
  RowBox[{"ibm", "[", 
   RowBox[{"\"\<DeviceModel\>\"", ",", " ", 
    RowBox[{"\"\<Backend\>\"", " ", "->", " ", "\"\<ibm_fez\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 " and its per-pair and per-qubit projections (",
 Cell[BoxData["\"\<CouplingMap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 ", ",
 Cell[BoxData["\"\<CZErrors\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 ", ",
 Cell[BoxData["\"\<ZZ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 ", ",
 Cell[BoxData["\"\<ReadoutErrors\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "034d641c-5834-e412-3173-7e4659c6cf78"],
 ", ",
 Cell[BoxData["\"\<Coherence\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 ", and the rest), which is how you compare devices before choosing one for \
",
 Cell[BoxData["IBMJobSubmit"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfe104a-50de-a555-0985-8a1461680fbf"],
 ". For the full picture see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["the IBM error map tutorial"]], 
    "paclet:Wolfram/QuantumFramework/tutorial/IBMQuantumErrorMap"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "134534fb-1061-d656-417a-ada5a115bcbc"],
 "."
}], "Text",
 CellID->1113655915,ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell["Building and checking a circuit", "Subsection",
 CellID->1606118752,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell[TextData[{
 "Using the circuit ",
 Cell[BoxData["qc"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "608e87cc-8fce-afdf-10b5-1e962a78f525"],
 " from the previous section, plot its exact output distribution: the \
noiseless ground truth a QPU run approximates, and the reference we overlay \
with the hardware counts:"
}], "Text",
 CellID->2141499446,ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qc", "[", "]"}], "[", "\"\<ProbabilityPlot\>\"", "]"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->339082558,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell[TextData[{
 "Before spending QPU time, you can sample the circuit on a local noiseless \
simulator. ",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 "'s ",
 Cell[BoxData["\"\<Qiskit\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 " interface runs through a local Qiskit Aer simulator when no provider is \
given, returning a ",
 Cell[BoxData["QuantumMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 " whose statistics converge to the exact distribution as the shot count \
grows (this needs the Python Qiskit stack):"
}], "Text",
 CellID->432388834,ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qc", "[", "\"\<Qiskit\>\"", "]"}], "[", 
   RowBox[{"\"\<Shots\>\"", " ", "->", " ", "4096"}], "]"}], 
  "[", "\"\<ProbabilityPlot\>\"", "]"}]], "Input",
 CellID->443736588,ExpressionUUID->"6801f052-da94-0b6f-183e-ea1fdf2159b5"],

Cell["Running on hardware", "Subsection",
 CellID->1593449978,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell[TextData[{
 "With an active connection, ",
 Cell[BoxData["IBMJobSubmit"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 " is the one call that runs a circuit on a QPU. It transpiles the circuit \
against the backend's own error-aware ",
 Cell[BoxData["Target"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],
 " (per-instruction error and duration), submits it through the ",
 Cell[BoxData["SamplerV2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],
 " primitive, and returns immediately with an asynchronous ",
 Cell[BoxData["IBMJob"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],
 " handle while the job sits in the queue. There is no manual OpenQASM, no \
raw request and no hex decoding of the classical register: the handle carries \
the per-bit to qubit map captured at transpile time, so results come back \
already in the Wolfram Language qubit order."
}], "Text",
 CellID->1742646261,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell[BoxData[
 RowBox[{"job", " ", "=", " ", 
  RowBox[{"IBMJobSubmit", "[", 
   RowBox[{"qc", ",", " ", "\"\<ibm_fez\>\""}], "]"}]}]], "Input",
 CellID->29467524,ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

Cell[TextData[{
 "The handle reports the job's status. Poll it while the job is queued, or \
pass ",
 Cell[BoxData[
  RowBox[{"\"\<Wait\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f417ec-7166-d78d-038b-8eb60010bdd7"],
 " to ",
 Cell[BoxData["IBMJobSubmit"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 " to block until the job reaches a terminal status:"
}], "Text",
 CellID->1939141443,ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell[BoxData[
 RowBox[{"job", "[", "\"\<Status\>\"", "]"}]], "Input",
 CellID->5047578,ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell[TextData[{
 "Refresh the handle to pull a fresh snapshot from the service. Once the \
status is ",
 Cell[BoxData["\"\<Completed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 ", applying the handle returns the measurement reconstructed from the \
hardware counts, in the Wolfram Language qubit order:"
}], "Text",
 CellID->15008895,ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],

Cell[BoxData[
 RowBox[{"qpu", " ", "=", " ", 
  RowBox[{
   RowBox[{"job", "[", "\"\<Refresh\>\"", "]"}], "[", "]"}]}]], "Input",
 CellID->1892712309,ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

Cell[TextData[{
 "The same handle keeps every response IBM returns under ",
 Cell[BoxData["\"\<Raw\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 " and exposes curated accessors on top, so the run's metadata is one query \
away. For example, the billed quantum runtime:"
}], "Text",
 CellID->787969749,ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell[BoxData[
 RowBox[{"job", "[", "\"\<QuantumSeconds\>\"", "]"}]], "Input",
 CellID->525088789,ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

Cell["Comparing exact and hardware results", "Subsection",
 CellID->357930410,ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell[TextData[{
 "Putting the exact distribution next to the hardware run shows the structure \
surviving the device noise: the dominant ",
 Cell[BoxData["000"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fd1512-f616-8834-3c82-8d5f83a0db1e"],
 ", ",
 Cell[BoxData["001"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c67103-72a1-9427-0efe-696d0755ff0d"],
 " and ",
 Cell[BoxData["111"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
 " outcomes and the near-zero ",
 Cell[BoxData["100"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58ee7ecb-1370-1005-0896-7795a605636f"],
 " all come through, with the noise flattening the distribution. The hardware \
values below are ",
 Cell[BoxData[
  RowBox[{"qpu", "[", "\"\<Probabilities\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],
 " from a recorded ",
 Cell[BoxData["ibm_fez"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],
 " run:"
}], "Text",
 CellID->1802489801,ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"exact", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"Values", "[", 
     RowBox[{"KeySort", "[", 
      RowBox[{"FullSimplify", " ", "/@", " ", 
       RowBox[{
        RowBox[{"qc", "[", "]"}], "[", "\"\<Probabilities\>\"", "]"}]}], 
      "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hardware", " ", "=", " ", 
   RowBox[{"Values", " ", "@", " ", 
    RowBox[{"KeySort", " ", "@", " ", 
     RowBox[{"<|", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], " ", "->", " ", 
        "0.255"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], " ", "->", " ", 
        "0.197"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], " ", "->", " ", 
        "0.149"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "1"}], "}"}], " ", "->", " ", 
        "0.054"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}], " ", "->", " ", 
        "0.019"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0", ",", " ", "1"}], "}"}], " ", "->", " ", 
        "0.035"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "0"}], "}"}], " ", "->", " ", 
        "0.120"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], " ", "->", " ", 
        "0.171"}]}], "|>"}]}]}]}], ";"}], "\n", 
 RowBox[{"BarChart", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"exact", ",", " ", "hardware"}], "}"}], "]"}], ",", "\n", "    ", 
   RowBox[{"ChartLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Exact WL\>\"", ",", " ", "\"\<QPU ibm_fez\>\""}], "}"}]}], ",",
    "\n", "    ", 
   RowBox[{"ChartLabels", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "3"}], "]"}], ",", 
      " ", "None"}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}]}], "]"}]}], "Input",
 CellLabel->"In[6]:= ",
 CellID->115301326,ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],

Cell["\<\
The differences are not in the queries but in device noise: each shot passes \
through a deep transpiled circuit on superconducting hardware, and the noise \
varies from job to job.\
\>", "Text",
 CellID->1651187567,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell["Amazon Braket", "Section",
 CellID->941376513,ExpressionUUID->"5e187950-8ca2-2ab2-0638-711a25577898"],

Cell[TextData[{
 "Amazon Braket is a quantum computing service on ",
 ButtonBox["Amazon Web Services",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://aws.amazon.com/"], None}],
 " (AWS). Unlike IBM, which exposes its own superconducting devices, Braket \
fronts several vendors (IonQ, Rigetti, QuEra and others) and on-demand \
simulators through one API, which makes it convenient for comparing \
technologies side by side. The Wolfram Language reaches it through the \
standard AWS service connection."
}], "Text",
 CellID->2120243592,ExpressionUUID->"250a2d7c-9b81-05b0-5309-c5261e346f9a"],

Cell["Connecting to AWS", "Subsection",
 CellID->1047559317,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell[TextData[{
 "Connect to AWS with your credentials (access key ID and secret access key); \
see the workflow ",
 ButtonBox["Authenticate with Amazon Web Services",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/workflow/\
AuthenticateWithAmazonWebServices.html"], None}],
 " for details on storing them:"
}], "Text",
 CellID->1820947576,ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

Cell[BoxData[
 RowBox[{"aws", " ", "=", " ", 
  RowBox[{"ServiceConnect", "[", 
   RowBox[{"\"\<AWS\>\"", ",", " ", "\"\<New\>\""}], "]"}]}]], "Input",
 CellID->670734585,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

Cell[TextData[{
 "Braket writes every task result to an S3 bucket, so you reach two AWS \
services through the connection: S3 for storage and Braket for the quantum \
tasks. If you do not have an S3 bucket yet, ",
 ButtonBox["create one",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://s3.console.aws.amazon.com/"], None}],
 " first:"
}], "Text",
 CellID->58232708,ExpressionUUID->"341c54d9-3079-6bba-5c24-4d83410c3980"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"s3", " ", "=", " ", 
   RowBox[{"ServiceExecute", "[", 
    RowBox[{"aws", ",", " ", "\"\<GetService\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Name\>\"", " ", "->", " ", "\"\<S3\>\""}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"braket", " ", "=", " ", 
   RowBox[{"ServiceExecute", "[", 
    RowBox[{"aws", ",", " ", "\"\<GetService\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Name\>\"", " ", "->", " ", "\"\<Braket\>\""}], "}"}]}], 
    "]"}]}], ";"}]}], "Input",
 CellID->393464600,ExpressionUUID->"1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],

Cell["Finding devices", "Subsection",
 CellID->1484396876,ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"],

Cell["List the available devices, both simulators and QPUs:", "Text",
 CellID->1149283354,ExpressionUUID->"6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"devices", " ", "=", " ", 
   RowBox[{
    RowBox[{"braket", "[", 
     RowBox[{"\"\<SearchDevices\>\"", ",", " ", 
      RowBox[{"\"\<Filters\>\"", " ", "->", " ", 
       RowBox[{"{", "}"}]}]}], "]"}], "[", 
    RowBox[{"\"\<Devices\>\"", ",", " ", "All"}], "]"}]}], ";"}], "\n", 
 RowBox[{"devices", "[", 
  RowBox[{"All", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<DeviceName\>\"", ",", " ", "\"\<DeviceType\>\"", ",", 
     " ", "\"\<DeviceStatus\>\""}], "}"}]}], "]"}]}], "Input",
 CellID->1092188694,ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

Cell["\<\
Select one on-demand simulator (Amazon's state-vector simulator SV1) and one \
QPU by their Amazon Resource Names (ARNs), decoding each device's \
capabilities from JSON:\
\>", "Text",
 CellID->559599970,ExpressionUUID->"07359582-e823-44a1-2eca-0cef89d62e8b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sim", " ", "=", " ", 
   RowBox[{"devices", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{
       "#DeviceArn", " ", "==", 
        " ", "\"\<arn:aws:braket:::device/quantum-simulator/amazon/sv1\>\""}],
        " ", "&"}], "]"}], ",", "\n", "    ", 
     RowBox[{"MapAt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ImportString", "[", 
         RowBox[{"#", ",", " ", "\"\<RawJSON\>\""}], "]"}], " ", "&"}], ",", 
       " ", "\"\<DeviceCapabilities\>\""}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qpu", " ", "=", " ", 
   RowBox[{"devices", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"StringContainsQ", "[", 
        RowBox[{"#DeviceArn", ",", " ", "\"\<ionq\>\""}], "]"}], " ", "&"}], 
      "]"}], ",", "\n", "    ", 
     RowBox[{"MapAt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ImportString", "[", 
         RowBox[{"#", ",", " ", "\"\<RawJSON\>\""}], "]"}], " ", "&"}], ",", 
       " ", "\"\<DeviceCapabilities\>\""}], "]"}]}], "]"}]}], ";"}]}], "Input",\

 CellID->1710123944,ExpressionUUID->"7c239bd0-3ff5-3b18-25d0-129ab9818662"],

Cell["Preparing the circuit as OpenQASM", "Subsection",
 CellID->934597701,ExpressionUUID->"68c76573-72ce-0c1a-18fd-7d3d077b5760"],

Cell[TextData[{
 "Build the circuit, then express it as OpenQASM for submission. Braket \
accepts OpenQASM, so the native ",
 Cell[BoxData["QuantumQASM"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6184d2f2-049e-728e-17bb-cbbcad2b40d4"],
 " output is a good way to inspect exactly what will be sent:"
}], "Text",
 CellID->284780108,ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<GHZ\>\"", ",", " ", 
      RowBox[{"\"\<Fourier\>\"", "[", "3", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"QuantumQASM", "[", "qc", "]"}]}], "Input",
 CellLabel->"In[7]:= ",
 CellID->643798763,ExpressionUUID->"19bb1c5e-57ab-6e36-4f58-9618625e351c"],

Cell[TextData[{
 "For submission to a specific Braket backend it is safest to render the \
device dialect of OpenQASM, which maps the circuit onto that vendor's \
supported gate set. Passing ",
 Cell[BoxData[
  RowBox[{"\"\<Provider\>\"", " ", "->", " ", "\"\<AWSBraket\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],
 " to the Qiskit interface does this conversion (it needs the Python Qiskit \
and Braket providers configured):"
}], "Text",
 CellID->268959046,ExpressionUUID->"30baa1c8-66ad-75e0-6059-389213585fca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qasm", " ", "=", " ", 
   RowBox[{
    RowBox[{"qc", "[", "\"\<Qiskit\>\"", "]"}], "[", 
    RowBox[{"\"\<QASM\>\"", ",", " ", 
     RowBox[{"\"\<Provider\>\"", " ", "->", " ", "\"\<AWSBraket\>\""}]}], 
    "]"}]}], ";"}]], "Input",
 CellID->403125484,ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"],

Cell["Submitting a quantum task", "Subsection",
 CellID->931950651,ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell["\<\
A Braket job is a \"quantum task\". Submit the OpenQASM as the task action, \
naming the device ARN, the destination S3 bucket and the number of shots. Run \
it once on the simulator:\
\>", "Text",
 CellID->412518898,ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"],

Cell[BoxData[
 RowBox[{"taskSV1", " ", "=", " ", 
  RowBox[{"braket", "[", 
   RowBox[{"\"\<CreateQuantumTask\>\"", ",", "\n", "    ", 
    RowBox[{"\"\<DeviceArn\>\"", " ", "->", " ", 
     RowBox[{"sim", "[", "\"\<DeviceArn\>\"", "]"}]}], ",", "\n", "    ", 
    RowBox[{"\"\<Shots\>\"", " ", "->", " ", "100"}], ",", "\n", "    ", 
    RowBox[{"\"\<Action\>\"", " ", "->", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"braketSchemaHeader", " ", "->", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{
          "name", " ", "->", " ", "\"\<braket.ir.openqasm.program\>\""}], ",",
           " ", 
          RowBox[{"version", " ", "->", " ", "\"\<1\>\""}]}], "|>"}]}], ",", 
       " ", 
       RowBox[{"source", " ", "->", " ", "qasm"}]}], "|>"}]}], ",", "\n", 
    "    ", 
    RowBox[{"\"\<OutputS3Bucket\>\"", " ", "->", 
     " ", "\"\<amazon-braket-my-bucket\>\""}], ",", " ", 
    RowBox[{"\"\<OutputS3KeyPrefix\>\"", " ", "->", " ", "\"\<tasks\>\""}], ",",
     "\n", "    ", 
    RowBox[{"\"\<RequestRegion\>\"", " ", "->", " ", "\"\<us-east-1\>\""}]}], 
   "]"}]}]], "Input",
 CellID->622967176,ExpressionUUID->"511b3347-8d7d-ab60-0738-ab212409f64a"],

Cell["The same call against the QPU ARN queues a hardware run:", "Text",
 CellID->1358080856,ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"],

Cell[BoxData[
 RowBox[{"taskIonQ", " ", "=", " ", 
  RowBox[{"braket", "[", 
   RowBox[{"\"\<CreateQuantumTask\>\"", ",", "\n", "    ", 
    RowBox[{"\"\<DeviceArn\>\"", " ", "->", " ", 
     RowBox[{"qpu", "[", "\"\<DeviceArn\>\"", "]"}]}], ",", "\n", "    ", 
    RowBox[{"\"\<Shots\>\"", " ", "->", " ", "100"}], ",", "\n", "    ", 
    RowBox[{"\"\<Action\>\"", " ", "->", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"braketSchemaHeader", " ", "->", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{
          "name", " ", "->", " ", "\"\<braket.ir.openqasm.program\>\""}], ",",
           " ", 
          RowBox[{"version", " ", "->", " ", "\"\<1\>\""}]}], "|>"}]}], ",", 
       " ", 
       RowBox[{"source", " ", "->", " ", "qasm"}]}], "|>"}]}], ",", "\n", 
    "    ", 
    RowBox[{"\"\<OutputS3Bucket\>\"", " ", "->", 
     " ", "\"\<amazon-braket-my-bucket\>\""}], ",", " ", 
    RowBox[{"\"\<OutputS3KeyPrefix\>\"", " ", "->", " ", "\"\<tasks\>\""}], ",",
     "\n", "    ", 
    RowBox[{"\"\<RequestRegion\>\"", " ", "->", " ", "\"\<us-east-1\>\""}]}], 
   "]"}]}]], "Input",
 CellID->320615307,ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

Cell["Checking status and fetching results", "Subsection",
 CellID->1594238871,ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"],

Cell[TextData[{
 "Query a task by its ARN. The simulator usually completes in seconds; a QPU \
task may sit ",
 Cell[BoxData["QUEUED"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5900aac7-5263-773e-0f3f-43a167165a04"],
 " until the device is available:"
}], "Text",
 CellID->2002505366,ExpressionUUID->"06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"braket", "[", 
   RowBox[{"\"\<GetQuantumTask\>\"", ",", " ", 
    RowBox[{"\"\<QuantumTaskArn\>\"", " ", "->", " ", 
     RowBox[{"taskSV1", "[", "\"\<quantumTaskArn\>\"", "]"}]}], ",", " ", 
    RowBox[{"\"\<RequestRegion\>\"", " ", "->", " ", "\"\<us-east-1\>\""}]}], 
   "]"}], "[", "\"\<status\>\"", "]"}]], "Input",
 CellID->2121396920,ExpressionUUID->"12d95fcb-3316-2212-42e7-569546a37178"],

Cell[TextData[{
 "The result is written to S3. Locate its directory, then read ",
 Cell["results.json", "InlineCode",ExpressionUUID->
  "733995c2-f5bf-78ee-22c6-0caffc4a4a34"],
 " from the bucket:"
}], "Text",
 CellID->993357154,ExpressionUUID->"4f8ab258-7e7f-0723-7589-34027b0a6a09"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"outputPath", " ", "=", " ", 
   RowBox[{
    RowBox[{"braket", "[", 
     RowBox[{"\"\<GetQuantumTask\>\"", ",", "\n", "    ", 
      RowBox[{"\"\<QuantumTaskArn\>\"", " ", "->", " ", 
       RowBox[{"taskSV1", "[", "\"\<quantumTaskArn\>\"", "]"}]}], ",", " ", 
      RowBox[{"\"\<RequestRegion\>\"", " ", "->", 
       " ", "\"\<us-east-1\>\""}]}], "]"}], "[", "\"\<outputS3Directory\>\"", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"results", " ", "=", " ", 
   RowBox[{"ImportByteArray", "[", "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"s3", "[", 
       RowBox[{"\"\<GetObject\>\"", ",", " ", 
        RowBox[{"\"\<Bucket\>\"", " ", "->", 
         " ", "\"\<amazon-braket-my-bucket\>\""}], ",", "\n", "        ", 
        RowBox[{"\"\<Key\>\"", " ", "->", " ", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"outputPath", ",", " ", "\"\<results.json\>\""}], "}"}], 
          "]"}]}], ",", " ", 
        RowBox[{"\"\<RequestRegion\>\"", " ", "->", 
         " ", "\"\<us-east-1\>\""}]}], "]"}], "[", "\"\<Body\>\"", "]"}], ",",
      "\n", "    ", "\"\<RawJSON\>\""}], "]"}]}], ";"}]}], "Input",
 CellID->50259360,ExpressionUUID->"6b12ee74-9953-131d-1921-003e18e67e67"],

Cell[TextData[{
 "The exact shape depends on the device: SV1 returns per-shot readouts under ",
 Cell[BoxData["\"\<measurements\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65262d3c-fccc-1dc6-0cdd-c579f579672c"],
 ", while IonQ returns aggregated ",
 Cell[BoxData["\"\<measurementProbabilities\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e157ee2-48da-d240-062b-77cc696ca0aa"],
 ". Either way you reduce to a probability over the eight basis states."
}], "Text",
 CellID->680111415,ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"],

Cell["Comparing exact and simulator results", "Subsection",
 CellID->1912025938,ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"],

Cell[TextData[{
 "SV1 is a noiseless state-vector simulator, so its finite-shot output is a \
sample from the exact distribution, exactly what ",
 Cell[BoxData["QuantumMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],
 "'s own sampler produces. Comparing the exact probabilities with a 100-shot \
sample shows the sampling spread you should expect before any device noise \
enters:"
}], "Text",
 CellID->1678275947,ExpressionUUID->"187adc3d-3961-76c2-4819-d667b8145c28"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<GHZ\>\"", ",", " ", 
      RowBox[{"\"\<Fourier\>\"", "[", "3", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"exact", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"qc", "[", "]"}], "[", "\"\<ProbabilitiesList\>\"", "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ordered", " ", "=", " ", 
   RowBox[{"Keys", "[", 
    RowBox[{"KeySort", "[", 
     RowBox[{
      RowBox[{"qc", "[", "]"}], "[", "\"\<Probabilities\>\"", "]"}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"counts", " ", "=", " ", 
   RowBox[{"Counts", "[", 
    RowBox[{
     RowBox[{"qc", "[", "]"}], "[", 
     RowBox[{"\"\<SimulatedMeasurement\>\"", ",", " ", "100"}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sv1", " ", "=", " ", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"Lookup", "[", 
      RowBox[{"counts", ",", " ", "ordered", ",", " ", "0"}], "]"}], "]"}], "/",
     "100"}]}], ";"}], "\n", 
 RowBox[{"BarChart", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"exact", ",", " ", "sv1"}], "}"}], "]"}], ",", "\n", "    ", 
   RowBox[{"ChartLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Exact WL\>\"", ",", " ", "\"\<SV1 (100 shots)\>\""}], 
     "}"}]}], ",", "\n", "    ", 
   RowBox[{"ChartLabels", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "3"}], "]"}], ",", 
      " ", "None"}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}]}], "]"}]}], "Input",
 CellLabel->"In[8]:= ",
 CellID->1570109414,ExpressionUUID->"641c78eb-7f03-7846-0c24-71b57ab64aac"],

Cell[TextData[{
 "On a real QPU the same overlay would show the additional device noise, just \
as the IBM run did above. Running the IonQ task and reading back its ",
 Cell[BoxData["\"\<measurementProbabilities\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],
 " gives the third bar to add to this chart."
}], "Text",
 CellID->746824257,ExpressionUUID->"112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],

Cell[CellGroupData[{

Cell["Related Guides", "TutorialMoreAboutSection",
 CellChangeTimes->{{3.843042384656711*^9, 3.843042386024461*^9}},
 CellID->23220180,ExpressionUUID->"6121b9de-dddd-aca8-10de-309bd469f6f2"],

