  BaseStyle->{
   "InlineFormula"}]], \
"InlineFormula",ExpressionUUID->"30209679-023a-ee91-61df-0823b7ccb4fb"]], \
"TutorialMoreAbout",
 CellID->1061190080,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"]
