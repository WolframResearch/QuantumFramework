Notebook[{

Cell[CellGroupData[{
Cell["Tensor Network", "Title",
 CellID->509267359,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "25a568a6-87a2-527f-535a-810032572145"], Cell[TextData[{
     Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
     "[\[Ellipsis]][\"TensorNetwork\"]"
    }], "TableText",ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"], 
    Cell["returns the tensor network of a circuit", "TableText",
     ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "56e0e12c-de7d-6135-7e9f-f889db08301f"], Cell[TextData[{
     Cell[BoxData["TensorNetworkIndexGraph"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5708d032-2150-04f2-7d37-ca7c50e56ed8"],
     "[\[Ellipsis]]"
    }], "TableText",ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"], 
    Cell["\<\
transforms a tensor network into a new graph with indices as vertices\
\>", "TableText",ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "234f1fb7-07c6-bba9-5174-96f1b27009f3"], Cell[TextData[{
     Cell[BoxData["TensorNetworkFreeIndices"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
     "[\[Ellipsis]]"
    }], "TableText",ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"], 
    Cell["returns free indices in a tensor network index graph", "TableText",
     ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "23253b8d-1c99-a6bf-52da-b2d7952d0c85"], Cell[TextData[{
     Cell[BoxData["ContractTensorNetwork"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6e84829b-9667-6594-16bb-1bc523124ffe"],
     "[\[Ellipsis]]"
    }], "TableText",ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"], 
    Cell["contracts indices in a tensor network", "TableText",ExpressionUUID->
     "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"]}
  }]], "2ColumnTableMod",
 CellID->329621944,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell["Create a quantum circuit:", "Text",
 CellID->515379898,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"circuit", " ", "=", " ", "\n", "  ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<S\>\"", ",", " ", 
      RowBox[{"\"\<H\>\"", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"\"\<X\>\"", " ", "->", " ", "3"}], ",", " ", "\"\<CNOT\>\"", ",",
       " ", "\n", "    ", 
      RowBox[{"\"\<SWAP\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
      RowBox[{"{", "1", "}"}], ",", " ", 
      RowBox[{"{", "2", "}"}], ",", " ", 
      RowBox[{"{", "3", "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"circuit", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->604760901,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell["\<\
In the Wolfram Quantum Framework, measurement outcomes are recorded in an \
ancillary quantum register (serving as a detector), so the complete circuit \
diagram includes both the system and this detector subsystem.\
\>", "Text",
 CellID->1476799103,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[BoxData[
 RowBox[{"circuit", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", " ", 
   RowBox[{"\"\<ShowExtraQudits\>\"", " ", "->", " ", "True"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->448336599,ExpressionUUID->"4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],

Cell["\<\
The first measurement result is stored in wire index 0, with subsequent \
results assigned to decreasing (negative) wire indices.\
\>", "Text",
 CellID->970785311,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell["\<\
Returns the tensor network representation corresponding to the given quantum \
circuit:\
\>", "Text",
 CellID->1377816002,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell[BoxData[
 RowBox[{"net", " ", "=", " ", 
  RowBox[{"circuit", "[", 
   RowBox[{"\"\<TensorNetwork\>\"", ",", " ", "\n", "  ", 
    RowBox[{"GraphLayout", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<LayeredDigraphEmbedding\>\"", ",", " ", 
       RowBox[{"\"\<Orientation\>\"", " ", "->", " ", "Left"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->1439899046,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"],

Cell["\<\
The tensor network is a graph annotated with tensors and contraction indices.\
\
\>", "Text",
 CellID->1641200340,ExpressionUUID->"3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GraphQ", "[", "net", "]"}], " ", "&&", " ", 
  RowBox[{"TensorNetworkQ", "[", "net", "]"}]}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->1424533854,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell[TextData[{
 "For a graph to be a tensor network, two main conditions must be met, which \
is what ",
 Cell[BoxData["TensorNetworkQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77d99fdb-a351-2d53-1de6-1684d6e477b9"],
 " does. First, every vertex in the graph must have properly formatted \
indices consisting only of Subscript or Superscript expressions, and each \
vertex cannot contain any duplicate indices - all indices at any single \
vertex must be unique from each other."
}], "Text",
 CellID->535457321,ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"],

Cell["\<\
Second, the tensor rank compatibility condition must be satisfied. This can \
happen in two ways: either each vertex's tensor rank must exactly match the \
number of indices assigned to that vertex, and when counting all index \
occurrences throughout the entire graph, every distinct index must appear \
exactly twice across all vertices (ensuring proper pairing for tensor \
contraction), or alternatively, all tensors in the network must have rank \
zero representing scalar tensors with no indices.\
\>", "Text",
 CellID->141959522,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell["Lists all annotation keys available for the tensor network:", "Text",
 CellID->299517738,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell[BoxData[
 RowBox[{"AnnotationKeys", "[", 
  RowBox[{"{", 
   RowBox[{"net", ",", " ", "0"}], "}"}], "]"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->2142391071,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell["\<\
Let\[CloseCurlyQuote]s look at tensor, vertex labels, and corresponding \
indexes in the tensor network:\
\>", "Text",
 CellID->1002769646,ExpressionUUID->"1f908cf3-3c70-d55a-45af-25bdb50abfa0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"list", " ", "=", " ", 
   RowBox[{"Developer`FromPackedArray", "@", 
    RowBox[{"VertexList", "[", "net", "]"}]}]}], ";"}], "\n", 
 RowBox[{"TableForm", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Transpose", "[", "\n", "  ", 
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"AnnotationValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"net", ",", " ", "list"}], "}"}], ",", " ", "#"}], "]"}], 
        " ", "&"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Tensor\>\"", ",", " ", "\"\<Index\>\""}], "}"}]}], ",", 
      " ", "\n", "   ", 
      RowBox[{"Sort", "@", 
       RowBox[{"AnnotationValue", "[", 
        RowBox[{"net", ",", " ", "VertexLabels"}], "]"}]}]}], "]"}], "]"}], ",",
    " ", 
   RowBox[{"TableDepth", " ", "->", " ", "2"}], ",", " ", "\n", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"#1", ",", " ", "\n", "       ", "Bold"}], "]"}], " ", 
         "&"}], ")"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Vertex index ->\n Vertex label\>\"", ",", 
         " ", "\"\<Tensor\>\"", ",", " ", "\n", 
         "     ", "\"\<Leg indices\>\""}], "}"}]}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[6]:= ",
 CellID->436346740,ExpressionUUID->"5dac66ba-272d-3627-0b54-7fe452d99d0d"],

Cell["\<\
Tensors in the tensor network are mixed type, meaning they consist of \
so-called \[OpenCurlyDoubleQuote]contravariant\[CloseCurlyDoubleQuote] \
(upper) indices and \[OpenCurlyDoubleQuote]covariant\[CloseCurlyDoubleQuote] \
(lower) indices. For example, the 2nd measurement (7th vertex), acts on \
qubit-2 (denoted by contravariant and covariant indices 2) and its result is \
saved on wire, denoted by the index \[OpenCurlyDoubleQuote]-1\
\[CloseCurlyDoubleQuote].\
\>", "Text",
 CellID->2122865143,ExpressionUUID->"110914de-bbdd-83a1-4736-8d983e69d18b"],

Cell["\<\
Vertices correspond to circuit\[CloseCurlyQuote]s operators/gate indices, in \
addition to \[OpenCurlyDoubleQuote]Initial\[CloseCurlyDoubleQuote] tensor \
with index 0 (for the initial state):\
\>", "Text",
 CellID->1735808809,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell[BoxData[
 RowBox[{"VertexList", "[", "net", "]"}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->753514147,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell[BoxData[
 RowBox[{"Length", "@", 
  RowBox[{
   RowBox[{"circuit", "[", "\"\<Flatten\>\"", "]"}], "[", "\"\<Operators\>\"",
    "]"}]}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->1164297175,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell[BoxData[
 RowBox[{"%", " ", "==", " ", 
  RowBox[{"Max", "[", "%%", "]"}]}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->632614636,ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell["\<\
Note that each edge represents (i.e., is tagged by) a contraction:\
\>", "Text",
 CellID->1689610856,ExpressionUUID->"65de4a87-3471-cd9f-13e6-63e1bd0597e5"],

Cell[BoxData[
 RowBox[{"EdgeList", "[", "net", "]"}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->1303163127,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell["Corresponding contraction:", "Text",
 CellID->2098230307,ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],

Cell[BoxData[
 RowBox[{"EdgeTags", "[", "net", "]"}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->1930159659,ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"],

Cell["Perform the contraction:", "Text",
 CellID->1113655915,ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],

Cell[BoxData[
 RowBox[{"finalTensor", " ", "=", " ", 
  RowBox[{"ContractTensorNetwork", "[", "net", "]"}]}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->1606118752,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],

Cell["\<\
Confirm that the result is the same as default circuit application:\
\>", "Text",
 CellID->2141499446,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"circuit", "[", "]"}], "[", "\"\<Tensor\>\"", "]"}], " ", "==", 
  " ", "finalTensor"}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->339082558,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell["\<\
Another tensor network representation uses indices as graph vertices with \
tensors as cliques:\
\>", "Text",
 CellID->432388834,ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell[BoxData[
 RowBox[{"indexNet", " ", "=", " ", "\n", " ", 
  RowBox[{"TensorNetworkIndexGraph", "[", 
   RowBox[{"net", ",", " ", "\n", "  ", 
    RowBox[{"GraphLayout", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<LayeredDigraphEmbedding\>\"", ",", " ", 
       RowBox[{"\"\<Orientation\>\"", " ", "->", " ", "Left"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->443736588,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell["\<\
In the above graph, the directed edges imply tensor contraction; also tensors \
are cliques in above graph:\
\>", "Text",
 CellID->1593449978,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell[BoxData[
 RowBox[{"HighlightGraph", "[", 
  RowBox[{"indexNet", ",", " ", "\n", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Subgraph", "[", 
      RowBox[{"indexNet", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    
    RowBox[{"FindClique", "[", 
     RowBox[{"indexNet", ",", " ", "Infinity", ",", " ", "All"}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->1742646261,ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"],

Cell["Free indices are the ones that left after contraction:", "Text",
 CellID->29467524,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell[BoxData[
 RowBox[{"TensorNetworkFreeIndices", "[", "net", "]"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->1939141443,ExpressionUUID->"337c2d89-644e-5b5e-6103-c4d30dfb29a4"],

Cell["Highlight free indices:", "Text",
 CellID->5047578,ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],

Cell[BoxData[
 RowBox[{"HighlightGraph", "[", 
  RowBox[{"indexNet", ",", " ", 
   RowBox[{"TensorNetworkFreeIndices", "[", "net", "]"}]}], "]"}]], "Input",
 CellLabel->"In[17]:= ",
 CellID->15008895,ExpressionUUID->"644cc522-c7c4-9b18-0c73-dc8ff276e662"],

Cell["\<\
Free indices can be extracted as vertices with zero in- and out- degree:\
\>", "Text",
 CellID->1892712309,ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],

Cell[BoxData[
 RowBox[{"Pick", "[", 
  RowBox[{
   RowBox[{"VertexList", "[", "indexNet", "]"}], ",", " ", "\n", " ", 
   RowBox[{
    RowBox[{"VertexInDegree", "[", "indexNet", "]"}], " ", "+", " ", 
    RowBox[{"VertexOutDegree", "[", "indexNet", "]"}]}], ",", " ", "0"}], 
  "]"}]], "Input",
 CellLabel->"In[18]:= ",
 CellID->787969749,ExpressionUUID->"6801f052-da94-0b6f-183e-ea1fdf2159b5"],

Cell[BoxData[
 RowBox[{"ContainsExactly", "[", 
  RowBox[{
   RowBox[{"TensorNetworkFreeIndices", "[", "net", "]"}], ",", " ", "\n", " ", 
   RowBox[{"TensorNetworkFreeIndices", "[", "net", "]"}]}], "]"}]], "Input",
 CellLabel->"In[19]:= ",
 CellID->525088789,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell["Contraction and Einstein Summation", "Subsection",
 CellID->357930410,ExpressionUUID->"7b6211f5-475c-1194-2911-88bf72e963fe"],

Cell["\<\
Many useful information of a tensor network can be extracted using \
TensorNetworkData:\
\>", "Text",
 CellID->1802489801,ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TensorNetworkData", "[", "net", "]"}], " ", "//", " ", 
  "Dataset"}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->115301326,ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell["\<\
Also, one can get the useful data using graph functionalities, too:\
\>", "Text",
 CellID->1651187567,ExpressionUUID->"5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],

Cell[BoxData[{
 RowBox[{"indices", " ", "=", " ", "\n", " ", 
  RowBox[{
   RowBox[{"AnnotationValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"net", ",", " ", "list"}], "}"}], ",", " ", "\"\<Index\>\""}], 
    "]"}], " ", "/.", " ", 
   RowBox[{"Rule", " ", "@@@", " ", 
    RowBox[{"EdgeTags", "[", "net", "]"}]}]}]}], "\n", 
 RowBox[{"out", " ", "=", " ", 
  RowBox[{"TensorNetworkFreeIndices", "[", "net", "]"}]}], "\n", 
 RowBox[{
  RowBox[{"tensors", " ", "=", " ", 
   RowBox[{"AnnotationValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"net", ",", " ", "list"}], "}"}], ",", " ", "\"\<Tensor\>\""}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[21]:= ",
 CellID->941376513,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell["Show ContractTensorNetwork is the same as EinsteinSummation:", "Text",
 CellID->2120243592,ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ContractTensorNetwork", "[", "net", "]"}], " ", "===", " ", "\n", 
  " ", 
  RowBox[{"ActivateTensor", "@", 
   RowBox[{"EinsteinSummation", "[", 
    RowBox[{
     RowBox[{"indices", " ", "->", " ", "out"}], ",", " ", "tensors"}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->1047559317,ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"],

Cell["\<\
One can compare the performance, on how the relevant computation is done\
\>", "Text",
 CellID->1820947576,ExpressionUUID->"4b6e5dad-9702-0c1f-7916-54f722b75765"],

Cell["Perform the contraction in the order of network\[CloseCurlyQuote]s \
EdgeList:", "Text",
 CellID->670734585,ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ContractTensorNetwork", "[", 
    RowBox[{"net", ",", " ", 
     RowBox[{"Method", " ", "->", " ", "\"\<Naive\>\""}]}], "]"}], ";"}], " ",
   "//", " ", "RepeatedTiming"}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->58232708,ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell["\<\
Optimize the order for contraction, using EinsteinSummation and symbolic \
tensors package:\
\>", "Text",
 CellID->393464600,ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ContractTensorNetwork", "[", "net", "]"}], ";"}], " ", "//", " ", 
  "RepeatedTiming"}]], "Input",
 CellLabel->"In[24]:= ",
 CellID->1484396876,ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],

Cell["Initial state different from ground state", "Subsection",
 CellID->1149283354,ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

Cell["\<\
Note that the initial tensor in the tensor network we studied here was a \
registered state. Additionally, one can start from any initial state.\
\>", "Text",
 CellID->1092188694,ExpressionUUID->"25a0bfbe-b1d4-2428-535f-36fbc0668f72"],

Cell["Generate a random state:", "Text",
 CellID->559599970,ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]0", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<RandomPure\>\"", ",", " ", "3"}], "}"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[25]:= ",
 CellID->1710123944,ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

Cell["Initialize the tensor network from above state:", "Text",
 CellID->934597701,ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell[BoxData[
 RowBox[{
  RowBox[{"net2", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{"\[Psi]0", ",", " ", "circuit"}], "}"}], "]"}], 
    "[", "\"\<TensorNetwork\>\"", "]"}]}], ";"}]], "Input",
 CellLabel->"In[26]:= ",
 CellID->284780108,ExpressionUUID->"14fd1512-f616-8834-3c82-8d5f83a0db1e"],

Cell["See supplement info, for package-scoped symbols.", "Text",
 CellID->643798763,ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"],

Cell["\<\
Show the tensor contraction is the same as transformation of state by the \
circuit:\
\>", "Text",
 CellID->268959046,ExpressionUUID->"48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ContractTensorNetwork", "[", "net2", "]"}], " ", "==", " ", 
  RowBox[{
   RowBox[{"circuit", "[", "\[Psi]0", "]"}], "[", "\"\<Tensor\>\"", 
   "]"}]}]], "Input",
 CellLabel->"In[27]:= ",
 CellID->403125484,ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],

Cell["Supplement info", "Section",
 CellID->931950651,ExpressionUUID->"11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],

Cell["FromTensorNetwork", "Subsection",
 CellID->412518898,ExpressionUUID->"7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],

Cell["\<\
Any directed graph can be turned into a tensor network, even if the graph is \
not annotated.\
\>", "Text",
 CellID->622967176,ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"graph", " ", "=", " ", 
  RowBox[{"DirectedGraph", "[", 
   RowBox[{
    RowBox[{"RandomGraph", "[", 
     RowBox[{"{", 
      RowBox[{"10", ",", " ", "10"}], "}"}], "]"}], ",", 
    " ", "\"\<Acyclic\>\"", ",", " ", "\n", "  ", 
    RowBox[{"VertexLabels", " ", "->", " ", 
     RowBox[{"v_", " ", ":>", " ", 
      RowBox[{"HoldForm", "[", "v", "]"}]}]}]}], "]"}]}]}], "Input",
 CellLabel->"In[28]:= ",
 CellID->1358080856,ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],

Cell[TextData[{
 "Convert the graph into a tensor network such that tensors for each vertex \
is randomly generated in the dimension ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "2"}], ",", "2", ",", 
   RowBox[{"\[Ellipsis]", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b45e796-37a7-eecc-197a-fed04253b416"],
 " where the overall length of dimensions is determined by the tensor rank \
(overall legs/edges):"
}], "Text",
 CellID->320615307,ExpressionUUID->"5e187950-8ca2-2ab2-0638-711a25577898"],

Cell[BoxData[
 RowBox[{"qcTN", " ", "=", " ", 
  RowBox[{"GraphTensorNetwork", "@", "graph"}]}]], "Input",
 CellLabel->"In[29]:= ",
 CellID->1594238871,ExpressionUUID->"250a2d7c-9b81-05b0-5309-c5261e346f9a"],

Cell["Get the tensor network data:", "Text",
 CellID->2002505366,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell[BoxData[
 RowBox[{"TensorNetworkData", "@", "qcTN"}]], "Input",
 CellLabel->"In[30]:= ",
 CellID->2121396920,ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

Cell["One can assign symbolic tensor into vertices too:", "Text",
 CellID->993357154,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qcTNSymbolic", " ", "=", " ", 
   RowBox[{"GraphTensorNetwork", "[", 
    RowBox[{"graph", ",", " ", 
     RowBox[{"Method", " ", "->", " ", "\"\<Symbolic\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"TensorNetworkData", "@", "qcTNSymbolic"}]}], "Input",
 CellLabel->"In[31]:= ",
 CellID->50259360,ExpressionUUID->"341c54d9-3079-6bba-5c24-4d83410c3980"],

Cell["Package-scoped symbols", "Subsection",
 CellID->680111415,ExpressionUUID->"1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],

Cell[TextData[{
 "In the Wolfram quantum framework, there are some package-scoped symbols \
that live in the ",
 Cell[BoxData[
  StyleBox["Wolfram`QuantumFramework`PackageScope`", "InlineCode"]], 
  "InlineCode",ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"],
 " context."
}], "Text",
 CellID->1912025938,ExpressionUUID->"6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],

Cell[BoxData[
 RowBox[{"?", 
  RowBox[{"Wolfram`QuantumFramework`PackageScope`$", "*"}]}]], "Input",
 CellLabel->"In[32]:= ",
 CellID->1678275947,ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

