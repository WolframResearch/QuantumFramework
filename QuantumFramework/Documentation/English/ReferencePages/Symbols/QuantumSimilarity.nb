        RowBox[{"1", "/", "4"}], ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"3", "/", "4"}]}], "}"}]}], "}"}], "]"}], ",", " ", "\n", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
