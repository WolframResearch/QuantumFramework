Cell[TextData[{
 "The maximally mixed state and ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3119d855-3ffd-7401-6726-d21fb9885f6b"],
 " have the same populations in the computational basis, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1", "/", "2"}], ",", 
   RowBox[{"1", "/", "2", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],
 ", but different fidelity similarities to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"1", "/", "4"}], ",", 
    RowBox[{"3", "/", "4"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],
 ". The maximally mixed state commutes with it, so its similarity is the \
overlap ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SqrtBox[
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["i", "TI"]], 
     SubscriptBox[
      StyleBox["q", "TI"], 
      StyleBox["i", "TI"]]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51fce014-dca1-0630-0783-fa51d5546d1a"],
 " of the populations ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657c1c65-980e-511d-1303-964f19bb2067"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["q", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],
 " of the two states; ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9b7e66-629a-1114-26b9-7040172f607e"],
 " does not commute with it, and its similarity is smaller:"
}], "ExampleText",
 CellID->1555662820,ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"],

