Cell[CellGroupData[{
Cell["QuantumSimilarity", "ObjectName",
 CellID->1224892054,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumSimilarity"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumSimilarity", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["qs", "TI"], 
     StyleBox["1", "TR"]], ",", 
    SubscriptBox[
     StyleBox["qs", "TI"], 
     StyleBox["2", "TR"]], ",", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 "\[LineSeparator]",
 "returns the similarity between two quantum discrete states using measure ",
 StyleBox["t", "TI"],
 ", a number in [0,1] for density matrices and normalized state vectors."
}], "Usage",
 CellID->329621944,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumSimilarity"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumSimilarity", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "\[Ellipsis]", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a568a6-87a2-527f-535a-810032572145"],
 " returns the similarity between two input states, a number in [0,1] when \
both are numeric and each is a density matrix or a normalized state vector. \
In ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumSimilarity"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumSimilarity", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["qs", "TI"], 
     StyleBox["1", "TR"]], ",", 
    SubscriptBox[
     StyleBox["qs", "TI"], 
     StyleBox["2", "TR"]], ",", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 " the following similarity measures ",
 StyleBox["t", "TI"],
 " are supported:"
}], "Notes",
 CellID->515379898,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5902d484-617f-9570-0f31-cdee100bfc5a"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3b7807e8-9504-b25a-6907-9eb21cb600a0"], Cell[TextData[Cell[
    BoxData["\"\<Fidelity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "166f8969-5e31-e8e5-3e14-21335bc5bacf"]], "TableText",ExpressionUUID->
     "234f1fb7-07c6-bba9-5174-96f1b27009f3"], Cell[
    "Similarity based on the fidelity between two states", "TableText",
     ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"], Cell[TextData[Cell[
    BoxData["\"\<Trace\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6ec9a758-58be-624c-16f6-3f02594b3096"]], "TableText",ExpressionUUID->
     "23253b8d-1c99-a6bf-52da-b2d7952d0c85"], Cell[
    "Similarity based on the trace distance between two states", "TableText",
     ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "569e173f-6b36-b240-7ea5-8f790ec000aa"], Cell[TextData[Cell[
    BoxData["\"\<Bures\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"]], "TableText",ExpressionUUID->
     "779c57de-bb93-d239-1da4-4e983e27a103"], Cell[
    "Similarity based on the Bures distance between two states", "TableText",
     ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "76dfbc62-92ac-7b6e-1ee4-364c275949b4"], Cell[TextData[Cell[
    BoxData["\"\<BuresAngle\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"]], "TableText",ExpressionUUID->
     "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"], Cell[
    "Similarity based on the Bures angle between two states", "TableText",
     ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3bf5a20e-c541-e06e-698a-446becf5b2b4"], Cell[TextData[Cell[
    BoxData["\"\<HilbertSchmidt\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "07964fa7-8d1e-ff14-2dae-660124a8c27e"]], "TableText",ExpressionUUID->
     "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"], Cell[
    "Similarity based on the Hilbert-Schmidt distance", "TableText",
     ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "77d99fdb-a351-2d53-1de6-1684d6e477b9"], Cell[TextData[Cell[
    BoxData["\"\<Bloch\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "04646437-faee-7dfc-2c1c-7e70fe9b47c6"]], "TableText",ExpressionUUID->
     "1cbde497-e826-5557-4442-fdd089d33fbd"], Cell["\<\
Similarity based on the Euclidean distance between two Bloch vectors (single \
qubit only)\
\>", "TableText",ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4c358d3e-86d3-ec5f-75ca-25783367b6a5"], Cell[TextData[Cell[
    BoxData["\"\<RelativeEntropy\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1f908cf3-3c70-d55a-45af-25bdb50abfa0"]], "TableText",ExpressionUUID->
     "5dac66ba-272d-3627-0b54-7fe452d99d0d"], Cell["\<\
Similarity based on the relative von Neumann entropy between two states\
\>", "TableText",ExpressionUUID->"110914de-bbdd-83a1-4736-8d983e69d18b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "76d004f9-29e5-6665-1eef-9da34f904d4f"], Cell[TextData[Cell[
    BoxData["\"\<RelativePurity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2c76c797-c249-79ca-540d-ded0f7fc4b10"]], "TableText",ExpressionUUID->
     "35077f55-9291-6519-633d-771f27244c63"], Cell[TextData[Cell[BoxData[
     RowBox[{
      StyleBox["T", "TI"], 
      StyleBox["r", "TI"], 
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "1"], ".", 
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "2"]}], 
      StyleBox["]",
       SpanMaxSize->1]}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4ebf3687-f906-130d-7644-afe0f8b37e57"]], "TableText",ExpressionUUID->
     "65de4a87-3471-cd9f-13e6-63e1bd0597e5"]}
  }]], "2ColumnTableMod",
 CellID->604760901,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell[TextData[{
 "If no measure ",
 StyleBox["t", "TI"],
 " is given, ",
 Cell[BoxData["\"\<Fidelity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 " is used."
}], "Notes",
 CellID->1476799103,ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"],

Cell[TextData[{
 "Each similarity is constructed from the corresponding ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumDistance"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumDistance", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "034d641c-5834-e412-3173-7e4659c6cf78"],
 " measure ",
 StyleBox["d", "TI"],
 " by the rules below, so that identical states give similarity ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 " and states with orthogonal supports give similarity ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfe104a-50de-a555-0985-8a1461680fbf"],
 ", with two exceptions: the ",
 Cell[BoxData["\"\<RelativePurity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "134534fb-1061-d656-417a-ada5a115bcbc"],
 " similarity of a mixed state with itself is its purity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], 
   StyleBox["r", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "2"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],
 ", less than ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1c99a5-dcef-9c28-1623-100ed49be772"],
 ", and the ",
 Cell[BoxData["\"\<HilbertSchmidt\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "608e87cc-8fce-afdf-10b5-1e962a78f525"],
 " similarity of two states with orthogonal supports is ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SqrtBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["T", "TI"], 
      StyleBox["r", "TI"], 
      StyleBox["[",
       SpanMaxSize->1], 
      SubsuperscriptBox[
       StyleBox["\[Rho]", "TI"], "1", "2"], 
      StyleBox["]",
       SpanMaxSize->1], "+", 
      StyleBox["T", "TI"], 
      StyleBox["r", "TI"], 
      StyleBox["[",
       SpanMaxSize->1], 
      SubsuperscriptBox[
       StyleBox["\[Rho]", "TI"], "2", "2"], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     StyleBox[")",
      SpanMaxSize->1], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aa912c6-4938-1bb7-5a56-8ba068cd699d"],
 ", above ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66b4bee0-d247-b105-0e4b-37cde7f3006f"],
 " unless both states are pure. For ",
 Cell[BoxData["\"\<Fidelity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 ", ",
 Cell[BoxData["\"\<Trace\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 ", ",
 Cell[BoxData["\"\<Bloch\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 ", and ",
 Cell[BoxData["\"\<RelativePurity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
 ", the similarity is ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 ". For ",
 Cell[BoxData["\"\<Bures\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0daf8e98-7628-e40b-3b54-27c203c2cf51"],
 " and ",
 Cell[BoxData["\"\<HilbertSchmidt\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 " (whose distance ranges in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    SqrtBox["2"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],
 "), the similarity is ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   FractionBox[
    StyleBox["d", "TI"], 
    SqrtBox["2"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],
 ". For ",
 Cell[BoxData["\"\<BuresAngle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],
 " (whose distance ranges in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    FractionBox["\[Pi]", "2"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7fe4cc-5889-7f4e-6904-fd96593c4594"],
 "), the similarity is ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   FractionBox[
    StyleBox["d", "TI"], 
    FractionBox["\[Pi]", "2"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cb5c01f-62f5-68e0-144a-da5916803aca"],
 ". The ",
 Cell[BoxData["\"\<RelativeEntropy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f417ec-7166-d78d-038b-8eb60010bdd7"],
 " case is unbounded and uses an exponential decay: similarity is ",
 Cell[BoxData[
  SuperscriptBox["2", 
   RowBox[{"-", 
    StyleBox["d", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 ". See ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumDistance"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumDistance", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1d359769-845f-cd94-44ca-0f332deb97fe"],
 " for the underlying distance formulas."
}], "Notes",
 CellID->448336599,ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell[TextData[{
 "The range [0,1] holds for density matrices, which are positive semidefinite \
with unit trace; a normalized state vector qualifies. The inputs are used as \
given: a state whose density matrix does not have unit trace, such as an \
unnormalized state vector, is not rescaled first, except by ",
 Cell[BoxData["\"\<Bloch\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 ", which reads the Bloch vector of the rescaled state; ",
 Cell[BoxData[
  RowBox[{
   StyleBox["qs", "TI"], "[", "\"\<Normalized\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 " gives the rescaled state. An input whose density matrix is numeric and has \
an eigenvalue below ",
 Cell[BoxData[
  RowBox[{"-", 
   SuperscriptBox["10", 
    RowBox[{"-", "8"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea251ed-865f-e03c-1652-48b733ebb306"],
 " issues a ",
 Cell[BoxData[
  RowBox[{"QuantumDistance", "::", "notphysical"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 " message; a symbolic input is not checked."
}], "Notes",
 CellID->970785311,ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"]
}, Open  ]],

