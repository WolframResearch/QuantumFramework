Cell[TextData[{
 "The maximally mixed state and ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9b7e66-629a-1114-26b9-7040172f607e"],
 " have the same populations in the computational basis, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1", "/", "2"}], ",", 
   RowBox[{"1", "/", "2", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "585a51e6-774f-2dd2-087a-48c002fa7738"],
 ", but different fidelity similarities to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"1", "/", "4"}], ",", 
    RowBox[{"3", "/", "4"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],
 ". The maximally mixed state commutes with it, so its similarity is the \
overlap ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SqrtBox[
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["i", "TI"]], 
     SubscriptBox[
      StyleBox["q", "TI"], 
      StyleBox["i", "TI"]]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370294fd-9e49-2d35-5d31-0da71bfc741f"],
 " of the populations ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2845529c-454d-b13b-587b-4bc66cf90001"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["q", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7519012f-e657-215b-2326-988893e273a1"],
 " of the two states; ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "594776df-9e75-d16a-0f7d-6f991b01a3b0"],
 " does not commute with it, and its similarity is smaller:"
}], "ExampleText",
 CellID->1555662820,ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"],

Cell[CellGroupData[{

