        RowBox[{"1", "/", "2"}], ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", 
        RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ",", 
   " ", "\"\<Trace\>\""}], "]"}]], "Input",
 CellLabel->"In[1]:= ",
