Cell["\<\
Find the similarity between two pure states in terms of fidelity:\
\>", "ExampleText",
 CellID->542889645,ExpressionUUID->"1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumSimilarity", "[", 
  RowBox[{
