Cell["\<\
Find the distance between two mixed states in terms of fidelity:\
\>", "ExampleText",
 CellID->2091929370,ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumDistance", "[", 
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
