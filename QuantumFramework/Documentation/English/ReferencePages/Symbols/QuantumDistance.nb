Cell["QuantumDistance", "ObjectName",
 CellID->69445383,ExpressionUUID->"f8efc2c5-4818-4c99-a53a-249328ce19f3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"43e15778-6294-431c-88d8-26a558d473a9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["QuantumDistance",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/QuantumFramework/ref/QuantumDistance"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["qs", "TI"], 
     StyleBox["1", "TR"]], ",", 
    SubscriptBox[
     StyleBox["qs", "TI"], 
     StyleBox["2", "TR"]], ",", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "dcf47c14-3067-4a45-ade1-0f2136c8bb95"],
 "\[LineSeparator]returns the distance between two quantum discrete states \
using measure ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "3ca9228d-807a-4474-ab5b-124d0592a95b"],
 "."
}], "Usage",
 CellChangeTimes->{{3.8589647321554604`*^9, 3.858964798430506*^9}, {
  3.873851751271063*^9, 3.873851754136777*^9}},
 CellID->107665970,ExpressionUUID->"1806a414-6957-46d2-8b42-2f9139bd4521"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["QuantumDistance",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/QuantumFramework/ref/QuantumDistance"], "[", 
   "\[Ellipsis]", "]"}]], "InlineFormula",ExpressionUUID->
  "84991a66-895c-4a37-a8ad-4a47f7ec32a1"],
 " returns a number representing the distance between two input states. In ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["QuantumDistance",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/QuantumFramework/ref/QuantumDistance"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["qs", "TI"], 
     StyleBox["1", "TR"]], ",", 
    SubscriptBox[
     StyleBox["qs", "TI"], 
     StyleBox["2", "TR"]], ",", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c13cd339-a13d-4760-80ed-3b1e0ef3b9a0"],
 " the following distance measures ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "c84d575e-587f-473d-b89a-27f210b15f4b"],
 " are supported:"
}], "Notes",
 CellChangeTimes->{{3.858964807565445*^9, 3.858964813000077*^9}, {
  3.873851775243643*^9, 3.873851778656911*^9}},
 CellID->345037101,ExpressionUUID->"b4a326f3-cff0-4994-9221-0db9feb5737c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2c58d1f2-7237-4b01-9788-7dd6b54f2e37"], "\"\<Fidelity\>\"", Cell[
    "Distance between two states in terms of fidelity", "TableText",
     ExpressionUUID->"89e89ee3-c891-4485-b728-d311269f96df"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b29bb590-3eb1-4da0-b18e-efd33d462d54"], "\"\<Trace\>\"", Cell[
    "Trace distance between two states", "TableText",ExpressionUUID->
     "f66db38e-194d-40e6-9c98-fd72c8a2657e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8aa36115-4e6f-4997-928a-64e5eb940e95"], "\"\<Bures\>\"", Cell[
    "Bures distance between two states", "TableText",ExpressionUUID->
     "0a3eec18-b0bb-4cd9-bdde-4aef1a33bd2c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f96b658f-97a6-4b0d-b1f5-7f2a44621cb1"], "\"\<BuresAngle\>\"", Cell[
    "Bures angle between two states", "TableText",ExpressionUUID->
     "a3925bb0-4362-47db-acb5-08927c38ce00"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "06481e5c-2a79-41a8-a952-462ca6758e27"], "\"\<HilbertSchmidt\>\"", Cell[
    "Hilbert-Schmidt distance", "TableText",ExpressionUUID->
     "e82734d5-a4aa-41d9-8334-3f8e0f18f03a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "664d52ee-5594-4b92-a305-ef7cfc284c1e"], "\"\<Bloch\>\"", Cell[
    "Euclidean distance between two Bloch vectors", "TableText",
     ExpressionUUID->"b1e2862b-d0d3-44c6-bba3-6760d97a5cae"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "dbfa134d-e967-4f47-838d-9cb76392b677"], "\"\<RelativeEntropy\>\"", Cell[
    "Relative von Neumann entropy between two states", "TableText",
     ExpressionUUID->"4fed18fc-938f-4427-9619-787c6b1a2ecd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c2cce32d-21dd-483e-a5f0-3c852a9ddca2"], "\"\<RelativePurity\>\"", Cell[
    TextData[Cell[BoxData[
     RowBox[{
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{
         SubscriptBox["\[Rho]", "1"], ".", 
         SubscriptBox["\[Rho]", "2"]}]}], ")"}], "]"}]],ExpressionUUID->
     "2b42c063-b6ee-4fb5-bc00-fa6070d96654"]], "TableText",ExpressionUUID->
     "7b2e3cc0-620e-48f5-b65d-9dceadc920c2"]}
  }]], "2ColumnTableMod",
 CellChangeTimes->{{3.8589648510251*^9, 3.858964906929641*^9}, {
  3.873455410493829*^9, 3.873455460325648*^9}, {3.87873888808296*^9, 
  3.878738933525199*^9}, {3.8835138982638283`*^9, 3.883513910437805*^9}, {
  3.933956190674983*^9, 3.9339561915796137`*^9}, {3.93395638491542*^9, 
  3.93395639255672*^9}, {3.933956532335535*^9, 3.933956537750797*^9}, {
  3.934370909641387*^9, 3.934370936335413*^9}},
 CellID->422116337,ExpressionUUID->"0951c88e-e52e-428e-8790-38c2004a9f8b"],

Cell[TextData[{
 "The distance based on fidelity is calculated as ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   RowBox[{"Tr", "[", 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       SubscriptBox["\[Rho]", "1"], 
       RowBox[{"1", "/", "2"}]], ".", 
      SubscriptBox["\[Rho]", "2"], ".", 
      SuperscriptBox[
       SubscriptBox["\[Rho]", "1"], 
       RowBox[{"1", "/", "2"}]]}]], "]"}]}]], "InlineFormula",ExpressionUUID->
  "1a2efb7c-2b2e-4ed7-87d5-ef83ac839215"],
 " with ",
 Cell[BoxData[
  SubscriptBox["\[Rho]", 
   RowBox[{"1", ",", "2"}]]], "InlineFormula",ExpressionUUID->
  "94883332-90bb-4e7f-8749-a3b0e5f1471f"],
 " the corresponding density matrices and  ",
 Cell[BoxData[
  RowBox[{"Tr", "[", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Rho]", "1"], 
      RowBox[{"1", "/", "2"}]], ".", 
     SubscriptBox["\[Rho]", "2"], ".", 
     SuperscriptBox[
      SubscriptBox["\[Rho]", "1"], 
      RowBox[{"1", "/", "2"}]]}]], "]"}]], "InlineFormula",ExpressionUUID->
  "8d6becda-d230-42a7-b6b7-032ad74c9c43"],
 " the fidelity. The trace distance is ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   RowBox[{"Tr", "[", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Rho]", "1"], "-", 
       SubscriptBox["\[Rho]", "2"]}], ")"}], "2"], "]"}]}]], "InlineFormula",
  ExpressionUUID->"df85c8ef-5d88-45da-b85b-840bc3afa697"],
 ".  The Bures distance is ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{"1", " ", "-", "  ", 
      StyleBox["fidelity", "TI"]}], ")"}]}]]], "InlineFormula",ExpressionUUID->
  "649ba2ca-a99a-4728-ba91-99ad02e96192"],
 ", and Bures angle is ",
 Cell[BoxData[
  RowBox[{"ArcCos", "[", 
   StyleBox["fidelity", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "27af42e7-ac2b-4960-8074-b6d421c9964b"],
 ". The Hilbert-Schmidt is the ",
 ButtonBox["Hilbert-Schmidt norm",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://mathworld.wolfram.com/Hilbert-SchmidtNorm.html"], None},
  ButtonNote->"https://mathworld.wolfram.com/Hilbert-SchmidtNorm.html"],
 " of the difference between density matrices ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"Tr", "[", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Rho]", "1"], "-", 
       SubscriptBox["\[Rho]", "2"]}], ")"}], "2"], "]"}]]], "InlineFormula",
  ExpressionUUID->"dcdb25d0-af02-4a3a-9cd8-3f650ab05031"],
 ". The Bloch distance is the ",
 Cell[BoxData[
  ButtonBox["EuclideanDistance",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "8c485fbe-65d5-4e54-9379-b6ea4912950e"],
 " between two Bloch vectors. And the relative entropy is ",
 Cell[BoxData[
  RowBox[{"Tr", "[", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Rho]", "1"], ".", 
     RowBox[{"Log", "[", 
      SubscriptBox["\[Rho]", "1"], "]"}]}], "-", 
    RowBox[{
     SubscriptBox["\[Rho]", "1"], ".", 
     RowBox[{"Log", "[", 
      SubscriptBox["\[Rho]", "2"], "]"}]}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"723e7e28-acc1-4529-9d24-46ade495f2f7"],
 "."
}], "Notes",
 CellChangeTimes->{{3.878738950037938*^9, 3.87873913053618*^9}, {
   3.878739180010042*^9, 3.878739321601468*^9}, {3.883514020097792*^9, 
   3.883514023362274*^9}, {3.883514078442555*^9, 3.883514079074986*^9}, 
