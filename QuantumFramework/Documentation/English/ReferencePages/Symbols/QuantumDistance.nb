Cell["\<\
These two Hermitian matrices have unit trace but each has a negative \
eigenvalue, so neither is a density matrix; a message is issued, and their \
trace distance exceeds 1, the largest trace distance two density matrices can \
have:\
\>", "ExampleText",
 CellID->1635850333,ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumDistance", "[", 
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "4"}], ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"3", "/", "4"}]}], "}"}]}], "}"}], "]"}], ",", " ", "\n", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", 
        RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ",", 
   " ", "\"\<Trace\>\""}], "]"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->185668621,ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"QuantumDistance", "::", "notphysical"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{
   RowBox[{
    RowBox[{
    "An", " ", "input", " ", "is", " ", "not", " ", "a", " ", "positive"}], "-", 
    RowBox[{"semidefinite", " ", "density", " ", "matrix"}]}], ";", " ", 
   RowBox[{
    RowBox[{
    "a", " ", "distance", " ", "or", " ", "similarity", " ", "involving", " ",
      "a", " ", "non"}], "-", 
    RowBox[{"physical", " ", "state", " ", "may", " ", "be", " ", 
     RowBox[{"meaningless", "."}]}]}]}]}]], "Message", "MSG",
 CellID->2064602208,ExpressionUUID->"023f49e2-a747-9723-33c5-60cfd2f3fa09"],

