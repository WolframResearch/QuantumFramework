 CellID->1483842723,ExpressionUUID->"1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],

Cell["Initial maximum distance for orthogonal states:", "ExampleText",
 CellID->1118160166,ExpressionUUID->"370294fd-9e49-2d35-5d31-0da71bfc741f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumDistance", "[", 
  RowBox[{
   RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], ",", " ", 
   RowBox[{"QuantumState", "[", "\"\<-\>\"", "]"}], ",", 
   " ", "\"\<Trace\>\""}], "]"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->583667978,ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

Cell[BoxData["1"], "Output",
 CellLabel->"Out[1]= ",
 CellID->1520434058,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"]
}, Open  ]],

Cell["Apply the \"AmplitudeDamping\" channel to both states:", "ExampleText",
 CellID->471855084,ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qs1", ",", " ", "qs2"}], "}"}], " ", "=", " ", "\n", "  ", 
   RowBox[{
    RowBox[{"QuantumChannel", "[", 
     RowBox[{"\"\<AmplitudeDamping\>\"", "[", "\[Gamma]", "]"}], "]"}], " ", "/@",
     " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], ",", " ", "\n", "    ", 
      RowBox[{"QuantumState", "[", "\"\<-\>\"", "]"}]}], "}"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->1670583624,ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"],

Cell["\<\
Compute the trace distance as function of the channel parameter:\
\>", "ExampleText",
 CellID->1494693401,ExpressionUUID->"6878c7f8-419e-9db5-1807-dea27028e79f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"QuantumDistance", "[", 
    RowBox[{"qs1", ",", " ", "qs2", ",", " ", "\"\<Trace\>\""}], "]"}], ",", 
   " ", 
   RowBox[{"0", " ", "<", " ", "\[Gamma]", " ", "<", " ", "1"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->1771785218,ExpressionUUID->"48a3d607-c312-9dd3-7850-c860f6a4e739"],

Cell[BoxData[
 SqrtBox[
  RowBox[{"1", "-", "\[Gamma]"}]]], "Output",
 CellLabel->"Out[3]= ",
 CellID->261125145,ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"]
}, Open  ]]
}, Open  ]],

