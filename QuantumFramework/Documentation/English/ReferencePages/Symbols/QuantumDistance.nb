Cell[TextData[{
 "If no measure ",
 StyleBox["t", "TI"],
 " is given, ",
 Cell[BoxData["\"\<Fidelity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 " is used."
}], "Notes",
 CellID->1476799103,ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],

Cell[TextData[{
 "The distance based on fidelity is calculated as ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   StyleBox["T", "TI"], 
   StyleBox["r", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SqrtBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["\[Rho]", "TI"], "1", 
      RowBox[{"1", "/", "2"}]], ".", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], "2"], ".", 
     SubsuperscriptBox[
      StyleBox["\[Rho]", "TI"], "1", 
      RowBox[{"1", "/", "2"}]]}]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 " with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   RowBox[{"1", ",", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfe104a-50de-a555-0985-8a1461680fbf"],
 " the corresponding density matrices and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], 
   StyleBox["r", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SqrtBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["\[Rho]", "TI"], "1", 
      RowBox[{"1", "/", "2"}]], ".", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], "2"], ".", 
     SubsuperscriptBox[
      StyleBox["\[Rho]", "TI"], "1", 
      RowBox[{"1", "/", "2"}]]}]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "134534fb-1061-d656-417a-ada5a115bcbc"],
 " the fidelity. The trace distance is ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["T", "TI"], 
   StyleBox["r", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SqrtBox[
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "1"], "-", 
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "2"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],
 ". The Bures distance is ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"2", "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "\[ThinSpace]", "-", "\[ThinSpace]", 
     StyleBox["fidelity",
      FontSlant->"Italic"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1c99a5-dcef-9c28-1623-100ed49be772"],
 ", and Bures angle is ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArcCos",
    BaseStyle->"Link"], "[", 
   StyleBox["fidelity", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "608e87cc-8fce-afdf-10b5-1e962a78f525"],
 ". The Hilbert-Schmidt distance is the ",
 ButtonBox["Hilbert-Schmidt norm",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://mathworld.wolfram.com/Hilbert-SchmidtNorm.html"], None}],
 " of the difference between density matrices ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["T", "TI"], 
    StyleBox["r", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "1"], "-", 
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "2"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], 
    StyleBox["]",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aa912c6-4938-1bb7-5a56-8ba068cd699d"],
 ". The Bloch distance is half the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EuclideanDistance"]], "paclet:ref/EuclideanDistance"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "66b4bee0-d247-b105-0e4b-37cde7f3006f"],
 " between two Bloch vectors. And the relative entropy is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    ButtonBox["Tr",
     BaseStyle->"Link"], "[", 
    RowBox[{
     RowBox[{"$", "\\r", 
      StyleBox["ho", "TI"], " ", "_", 
      RowBox[{"{", "1", "}"}], 
      RowBox[{"$", ".", 
       RowBox[{
        ButtonBox["MatrixLog",
         BaseStyle->"Link"], "[", 
        RowBox[{"$", "\\r", 
         StyleBox["ho", "TI"], " ", "_", 
         RowBox[{"{", "1", "}"}], "$"}], "]"}]}]}], "-", 
     RowBox[{"$", "\\r", 
      StyleBox["ho", "TI"], " ", "_", 
      RowBox[{"{", "1", "}"}], 
      RowBox[{"$", ".", 
       RowBox[{
        ButtonBox["MatrixLog",
         BaseStyle->"Link"], "[", 
        RowBox[{"$", "\\r", 
         StyleBox["ho", "TI"], " ", "_", 
         RowBox[{"{", "2", "}"}], "$"}], "]"}]}]}]}], "]"}], "/", 
   RowBox[{
    ButtonBox["Log",
     BaseStyle->"Link"], "[", "2", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 ", returned as a quantity in bits."
}], "Notes",
 CellID->448336599,ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],

Cell[TextData[{
 "The measures are defined for density matrices, which are positive \
semidefinite with unit trace; a normalized state vector qualifies. The inputs \
are used as given: a state whose density matrix does not have unit trace, \
such as an unnormalized state vector, is not rescaled first, except by ",
 Cell[BoxData["\"\<Bloch\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 ", which reads the Bloch vector of the rescaled state; ",
 Cell[BoxData[
  RowBox[{
   StyleBox["qs", "TI"], "[", "\"\<Normalized\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
 " gives the rescaled state. An input whose density matrix is numeric and has \
an eigenvalue below ",
 Cell[BoxData[
  RowBox[{"-", 
   SuperscriptBox["10", 
    RowBox[{"-", "8"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 " issues a ",
 Cell[BoxData[
  RowBox[{"QuantumDistance", "::", "notphysical"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0daf8e98-7628-e40b-3b54-27c203c2cf51"],
 " message; a symbolic input is not checked."
}], "Notes",
 CellID->970785311,ExpressionUUID->"7b6211f5-475c-1194-2911-88bf72e963fe"]
}, Open  ]],

