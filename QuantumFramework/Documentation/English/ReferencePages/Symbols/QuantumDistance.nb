Cell["Apply the \"AmplitudeDamping\" channel to both states:", "ExampleText",
 CellID->471855084,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qs1", ",", " ", "qs2"}], "}"}], " ", "=", " ", "\n", "  ", 
   RowBox[{
    RowBox[{"QuantumChannel", "[", 
     RowBox[{"\"\<AmplitudeDamping\>\"", "[", "\[Gamma]", "]"}], "]"}], " ", "/@",
     " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], ",", " ", "\n", "    ", 
