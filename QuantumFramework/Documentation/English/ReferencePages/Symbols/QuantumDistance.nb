Cell["\<\
These two Hermitian matrices have unit trace but each has a negative \
eigenvalue, so neither is a density matrix; a message is issued, and their \
trace distance exceeds 1, the largest trace distance two density matrices can \
have:\
\>", "ExampleText",
 CellID->1635850333,ExpressionUUID->"2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumDistance", "[", 
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "4"}], ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"3", "/", "4"}]}], "}"}]}], "}"}], "]"}], ",", " ", "\n", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", 
        RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ",", 
   " ", "\"\<Trace\>\""}], "]"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->185668621,ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c"],

