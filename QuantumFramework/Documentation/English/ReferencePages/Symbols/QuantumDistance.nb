     "110914de-bbdd-83a1-4736-8d983e69d18b"], Cell[
    "Relative von Neumann entropy between two states", "TableText",
     ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2c76c797-c249-79ca-540d-ded0f7fc4b10"], Cell[TextData[Cell[
