Cell[TextData[{
 "If no measure ",
 StyleBox["t", "TI"],
 " is given, ",
 Cell[BoxData["\"\<Fidelity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 " is used."
}], "Notes",
 CellID->1476799103,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell[TextData[{
 "The distance based on fidelity is calculated as ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   StyleBox["T", "TI"], 
   StyleBox["r", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SqrtBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["\[Rho]", "TI"], "1", 
      RowBox[{"1", "/", "2"}]], ".", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], "2"], ".", 
     SubsuperscriptBox[
      StyleBox["\[Rho]", "TI"], "1", 
      RowBox[{"1", "/", "2"}]]}]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "134534fb-1061-d656-417a-ada5a115bcbc"],
 " with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   RowBox[{"1", ",", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],
 " the corresponding density matrices and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], 
   StyleBox["r", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SqrtBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["\[Rho]", "TI"], "1", 
      RowBox[{"1", "/", "2"}]], ".", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], "2"], ".", 
     SubsuperscriptBox[
      StyleBox["\[Rho]", "TI"], "1", 
      RowBox[{"1", "/", "2"}]]}]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1c99a5-dcef-9c28-1623-100ed49be772"],
 " the fidelity. The trace distance is ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["T", "TI"], 
   StyleBox["r", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SqrtBox[
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "1"], "-", 
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "2"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "608e87cc-8fce-afdf-10b5-1e962a78f525"],
 ". The Bures distance is ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"2", "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "\[ThinSpace]", "-", "\[ThinSpace]", 
     StyleBox["fidelity",
      FontSlant->"Italic"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aa912c6-4938-1bb7-5a56-8ba068cd699d"],
 ", and Bures angle is ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArcCos",
    BaseStyle->"Link"], "[", 
   StyleBox["fidelity", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66b4bee0-d247-b105-0e4b-37cde7f3006f"],
 ". The Hilbert-Schmidt distance is the ",
 ButtonBox["Hilbert-Schmidt norm",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://mathworld.wolfram.com/Hilbert-SchmidtNorm.html"], None}],
 " of the difference between density matrices ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["T", "TI"], 
    StyleBox["r", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "1"], "-", 
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "2"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], 
    StyleBox["]",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 ". The Bloch distance is half the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EuclideanDistance"]], "paclet:ref/EuclideanDistance"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 " between two Bloch vectors. And the relative entropy is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    ButtonBox["Tr",
     BaseStyle->"Link"], "[", 
    RowBox[{
     RowBox[{"$", "\\r", 
      StyleBox["ho", "TI"], " ", "_", 
      RowBox[{"{", "1", "}"}], 
      RowBox[{"$", ".", 
       RowBox[{
        ButtonBox["MatrixLog",
         BaseStyle->"Link"], "[", 
        RowBox[{"$", "\\r", 
         StyleBox["ho", "TI"], " ", "_", 
         RowBox[{"{", "1", "}"}], "$"}], "]"}]}]}], "-", 
     RowBox[{"$", "\\r", 
      StyleBox["ho", "TI"], " ", "_", 
      RowBox[{"{", "1", "}"}], 
      RowBox[{"$", ".", 
       RowBox[{
        ButtonBox["MatrixLog",
         BaseStyle->"Link"], "[", 
        RowBox[{"$", "\\r", 
         StyleBox["ho", "TI"], " ", "_", 
         RowBox[{"{", "2", "}"}], "$"}], "]"}]}]}]}], "]"}], "/", 
   RowBox[{
    ButtonBox["Log",
     BaseStyle->"Link"], "[", "2", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 ", returned as a quantity in bits."
}], "Notes",
 CellID->448336599,ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],

Cell[TextData[{
 "The measures are defined for density matrices, which are Hermitian and \
positive semidefinite with unit trace. An input whose trace is a positive \
number other than 1, such as a state vector whose squared norm is not 1, is \
divided by its trace first. An exact positive trace other than 1 issues a ",
 Cell[BoxData[
  RowBox[{"QuantumDistance", "::", "notnormalized"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 " message; a machine-precision trace is divided in any case, and issues the \
message when it is more than ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"-", "8"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0daf8e98-7628-e40b-3b54-27c203c2cf51"],
 " from 1. A symbolic input is rescaled only when its trace evaluates to a \
number, and is otherwise used as given; ",
 Cell[BoxData[
  RowBox[{
   StyleBox["qs", "TI"], "[", "\"\<Normalized\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 " gives the state it stands for. An input whose trace is 0, negative, or not \
real, or a numeric input that, once divided by its trace, is not Hermitian \
(tested exactly when its entries, once divided, are exact rational or complex \
rational numbers, and otherwise by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HermitianMatrixQ"]], "paclet:ref/HermitianMatrixQ"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],
 " with a tolerance of ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"-", "8"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],
 ") or has a machine-precision eigenvalue below ",
 Cell[BoxData[
  RowBox[{"-", 
   SuperscriptBox["10", 
    RowBox[{"-", "8"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],
 ", issues a ",
 Cell[BoxData[
  RowBox[{"QuantumDistance", "::", "notphysical"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7fe4cc-5889-7f4e-6904-fd96593c4594"],
 " message. The entries of an exact input multiplied by an irrational number, \
as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cb5c01f-62f5-68e0-144a-da5916803aca"],
 " for a matrix ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f417ec-7166-d78d-038b-8eb60010bdd7"],
 " of rational entries, need not be rational once divided by the trace, and \
such an input is then tested with the tolerance. A machine-precision trace \
counts as 0 when its absolute value is at most ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"-", "8"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 " times the Frobenius norm of the numeric entries of the matrix, as positive \
when its real part exceeds, and its imaginary part is at most, ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"-", "8"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d359769-845f-cd94-44ca-0f332deb97fe"],
 " times the larger of that norm and the absolute value of the trace, and \
otherwise as negative or not real. A machine-precision state vector whose \
squared norm underflows to 0 counts as the zero vector. An exact trace whose \
sign cannot be decided, numerically or, for an algebraic trace, with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RootReduce"]], "paclet:ref/RootReduce"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2055bfee-d4b5-7aa2-506a-36cbdd404888"],
 ", is used as given, and a matrix with a symbolic entry is checked only \
through its trace."
}], "Notes",
 CellID->970785311,ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<Bloch\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 " distance is defined for a single qubit, whose Bloch vectors give the trace \
distance; for any other dimension it returns a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea251ed-865f-e03c-1652-48b733ebb306"],
 " object."
}], "Notes",
 CellID->1377816002,ExpressionUUID->"25a0bfbe-b1d4-2428-535f-36fbc0668f72"]
}, Open  ]],

