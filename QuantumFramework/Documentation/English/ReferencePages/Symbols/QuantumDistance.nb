Cell[TextData[{
 "Find the distance between a symbolic qubit state and the ",
 Cell[BoxData["\"\<+\>\""], "InlineFormula",ExpressionUUID->
  "42c74bfc-8024-284b-8f65-e3781a55337c"],
 " state in terms of fidelity:"
}], "ExampleText",
 CellChangeTimes->{{3.9960576489100456`*^9, 3.9960576838577576`*^9}, {
  3.9960594060553665`*^9, 3.996059441696003*^9}},
 CellID->50287500,ExpressionUUID->"5e0c19d5-b81b-034a-9faa-f77a697b1016"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"#", ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", "\[Phi]"}], "}"}], "\[Element]", 
      TemplateBox[{},
       "Reals"]}]}], "]"}], "&"}], "[", 
  RowBox[{"QuantumDistance", "[", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", 
        FractionBox["\[Theta]", "2"], "]"}], ",", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]], " ", 
        RowBox[{"Sin", "[", 
         FractionBox["\[Theta]", "2"], "]"}]}]}], "}"}], "]"}], ",", 
    RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}]}], "]"}], "]"}]], "Input",\

 CellLabel->"In[1]:=",
 CellID->94431146,ExpressionUUID->"9c5112ca-54c3-d34b-8082-7ff9866ea2fc"],

Cell[BoxData[
 RowBox[{"1", "-", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   SqrtBox[
    RowBox[{"2", "+", 
     RowBox[{"2", " ", 
      RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}]]}]}]], "Output",
 CellChangeTimes->{3.9960576102145767`*^9},
 CellLabel->"Out[1]=",
 CellID->782917483,ExpressionUUID->"6d56f478-402d-204f-b90f-f5d56787b9a2"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

