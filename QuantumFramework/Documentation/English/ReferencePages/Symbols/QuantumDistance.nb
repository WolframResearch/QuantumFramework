Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumDistance"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumDistance", 
     "Wolfram/QuantumFramework Package Symbol"},
