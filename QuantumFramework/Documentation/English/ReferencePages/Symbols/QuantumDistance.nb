Cell["\<\
Relative entropy is asymmetric, reversing the order of the quantum states \
changes the value:\
\>", "ExampleText",
 CellID->1791983110,ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumDistance", "[", 
    RowBox[{"##", ",", " ", "\"\<RelativeEntropy\>\""}], "]"}], " ", "&"}], 
  " ", "@@@", " ", "\n", " ", 
  RowBox[{"Permutations", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", "\"\<RandomMixed\>\"", "]"}], ",", " ", 
     "2"}], "]"}]}]}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->1705657336,ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[{"0.3005475376932935`", "\"b\"", "bits", "\"Bits\""},
    "Quantity"], ",", 
   TemplateBox[{"0.3056761312843223`", "\"b\"", "bits", "\"Bits\""},
    "Quantity"]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->1068798779,ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

