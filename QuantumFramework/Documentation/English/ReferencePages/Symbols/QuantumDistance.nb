        RowBox[{"1", "/", "4"}], ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"3", "/", "4"}]}], "}"}]}], "}"}], "]"}], ",", " ", "\n", " ", 
   RowBox[{"QuantumState", "[", 
