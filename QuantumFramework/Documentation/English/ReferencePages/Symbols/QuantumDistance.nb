Cell[TextData[{
 "Find the distance between a symbolic qubit state and the ",
 Cell[BoxData["\"\<+\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29bc1606-c22d-409d-5f43-8863f7d812e7"],
 " state in terms of fidelity:"
}], "ExampleText",
 CellID->1258921795,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", 
      " ", "Reals"}]}], "]"}], " ", "&"}], "[", "\n", " ", 
  RowBox[{"QuantumDistance", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{"I", " ", "\[Phi]"}], ")"}]}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], "]"}], ",", " ", 
    "\n", "  ", 
    RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}]}], "]"}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",
 CellID->456697606,ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"],

Cell[BoxData[
 RowBox[{"1", "-", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   SqrtBox[
    RowBox[{"2", "+", 
     RowBox[{"2", " ", 
      RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}]]}]}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->864433130,ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

