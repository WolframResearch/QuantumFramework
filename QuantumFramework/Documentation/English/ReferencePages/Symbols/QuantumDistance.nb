  "25a568a6-87a2-527f-535a-810032572145"],
 " returns the distance between two input states, a number for numeric input, \
a quantity in bits for ",
 Cell[BoxData["\"\<RelativeEntropy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 ", and a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Failure"]], "paclet:ref/Failure"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 " object for ",
 Cell[BoxData["\"\<Bloch\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5902d484-617f-9570-0f31-cdee100bfc5a"],
 " beyond a single qubit. In ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumDistance"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumDistance", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
