Cell["Apply the \"AmplitudeDamping\" channel to both states:", "ExampleText",
 CellChangeTimes->{{3.9959999680982876`*^9, 3.9959999897525063`*^9}, {
  3.996000207598793*^9, 3.9960002101849937`*^9}},
 CellID->634342889,ExpressionUUID->"d03fed8b-668b-b043-9206-2432fdbb964b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qs1", ",", "qs2"}], "}"}], "=", 
   RowBox[{
    RowBox[{"QuantumChannel", "[", 
     RowBox[{"\"\<AmplitudeDamping\>\"", "[", "\[Gamma]", "]"}], "]"}], "/@", 
    
    RowBox[{"{", 
     RowBox[{
      RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], ",", 
      RowBox[{"QuantumState", "[", "\"\<-\>\"", "]"}]}], "}"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9959983850034733`*^9, 3.9959983873973217`*^9}},
 CellLabel->"In[2]:=",
 CellID->245286397,ExpressionUUID->"be731e7d-1c5f-5347-adcc-59125804ceed"],

Cell["\<\
Compute the trace distance as function of the channel parameter:\
\>", "ExampleText",
 CellChangeTimes->{{3.9960000557050953`*^9, 3.996000070031351*^9}, {
  3.996000219449238*^9, 3.996000220326849*^9}, {3.9960604684912777`*^9, 
  3.9960604699154816`*^9}},
 CellID->2608896,ExpressionUUID->"454e2227-e610-7549-818f-3de0f14c7668"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"QuantumDistance", "[", 
    RowBox[{"qs1", ",", "qs2", ",", "\"\<Trace\>\""}], "]"}], ",", 
   RowBox[{"0", "<", "\[Gamma]", "<", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{3.9959984056423187`*^9},
 CellLabel->"In[3]:=",
 CellID->683777162,ExpressionUUID->"f7f83e68-10ee-9347-81de-7d060650f493"],

Cell[BoxData[
 SqrtBox[
  RowBox[{"1", "-", "\[Gamma]"}]]], "Output",
