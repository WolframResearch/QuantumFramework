Cell[TextData[{
 "Find the distance between a symbolic qubit state and the ",
 Cell[BoxData["\"\<+\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f8ab258-7e7f-0723-7589-34027b0a6a09"],
 " state in terms of fidelity:"
}], "ExampleText",
 CellID->1258921795,ExpressionUUID->"6b12ee74-9953-131d-1921-003e18e67e67"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", 
      " ", "Reals"}]}], "]"}], " ", "&"}], "[", "\n", " ", 
  RowBox[{"QuantumDistance", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{"I", " ", "\[Phi]"}], ")"}]}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], "]"}], ",", " ", 
    "\n", "  ", 
    RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}]}], "]"}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",
 CellID->456697606,ExpressionUUID->"65262d3c-fccc-1dc6-0cdd-c579f579672c"],

Cell[BoxData[
 RowBox[{"1", "-", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   SqrtBox[
    RowBox[{"2", "+", 
     RowBox[{"2", " ", 
      RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}]]}]}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->864433130,ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

