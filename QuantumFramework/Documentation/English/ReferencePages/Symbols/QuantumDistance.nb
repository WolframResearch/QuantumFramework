 CellID->320358404,ExpressionUUID->"42b8950a-3b9d-c848-b856-972248b03e4e"],

Cell["\<\
Relative entropy is asymmetric, reversing the order of the quantum states \
changes the value:\
\>", "ExampleText",
 CellChangeTimes->{{3.9960008138048153`*^9, 3.996000827638832*^9}, {
  3.996057402629095*^9, 3.996057452448477*^9}, {3.9960575163870907`*^9, 
  3.996057533664503*^9}},
 CellID->137427686,ExpressionUUID->"a2a303c2-ada8-df4f-983a-99a7035262fa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumDistance", "[", 
    RowBox[{"##", ",", "\"\<RelativeEntropy\>\""}], "]"}], "&"}], "@@@", 
  RowBox[{"Permutations", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", "\"\<RandomMixed\>\"", "]"}], ",", "2"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9960003230991592`*^9, 3.9960003489950314`*^9}, {
   3.996000397354868*^9, 3.9960005397717876`*^9}, {3.996000571397854*^9, 
   3.996000582296459*^9}, {3.9960006180949535`*^9, 3.996000681169407*^9}, {
