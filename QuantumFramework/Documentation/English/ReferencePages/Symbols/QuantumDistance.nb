     FontSize->0.9 Inherited,ExpressionUUID->
     "76d004f9-29e5-6665-1eef-9da34f904d4f"]], "TableText",ExpressionUUID->
     "2c76c797-c249-79ca-540d-ded0f7fc4b10"], Cell[
    "Relative von Neumann entropy between two states", "TableText",
     ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4ebf3687-f906-130d-7644-afe0f8b37e57"], Cell[TextData[Cell[
    BoxData["\"\<RelativePurity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "65de4a87-3471-cd9f-13e6-63e1bd0597e5"]], "TableText",ExpressionUUID->
     "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"], Cell[TextData[Cell[BoxData[
