Cell["\<\
Find the distance between two pure states in terms of fidelity:\
\>", "ExampleText",
 CellID->542889645,ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumDistance", "[", 
  RowBox[{
   RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", 
   RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->2054848121,ExpressionUUID->"48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],

Cell[BoxData["1"], "Output",
 CellLabel->"Out[1]= ",
