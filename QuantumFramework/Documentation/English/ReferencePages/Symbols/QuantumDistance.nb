Cell["\<\
Relative entropy is asymmetric, reversing the order of the quantum states \
changes the value:\
\>", "ExampleText",
 CellID->1791983110,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumDistance", "[", 
    RowBox[{"##", ",", " ", "\"\<RelativeEntropy\>\""}], "]"}], " ", "&"}], 
  " ", "@@@", " ", "\n", " ", 
  RowBox[{"Permutations", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", "\"\<RandomMixed\>\"", "]"}], ",", " ", 
     "2"}], "]"}]}]}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->1705657336,ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[{"1.4961205707577485`", "\"b\"", "bits", "\"Bits\""},
    "Quantity"], ",", 
   TemplateBox[{"1.4545232973181348`", "\"b\"", "bits", "\"Bits\""},
    "Quantity"]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->1068798779,ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

