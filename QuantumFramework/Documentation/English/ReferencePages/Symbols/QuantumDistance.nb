Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumDistance", "[", 
  RowBox[{
   RowBox[{"QuantumState", "[", "\"\<RandomMixed\>\"", "]"}], ",", 
   RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], 
   ",", "\"\<RelativeEntropy\>\""}], "]"}]], "Input",
 CellChangeTimes->{{3.995996075077944*^9, 3.995996118845564*^9}},
 CellLabel->"In[1]:=",
 CellID->89389255,ExpressionUUID->"a60bb34d-9b46-6f4e-ab25-6614e49d8fc9"],

Cell[BoxData[
