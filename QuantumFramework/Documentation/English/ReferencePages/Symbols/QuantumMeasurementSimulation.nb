Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c98d5d56-6e35-40a7-9d63-ce9367b1475f"],
 Cell[BoxData[
  RowBox[{"QuantumMeasurementSimulation", "[", 
   RowBox[{
    StyleBox["state", "TI",
     FontSlant->"Italic"], ",", 
    StyleBox["qmo", "TI",
     FontSlant->"Italic"], ",", 
    StyleBox["counts", "TI",
     FontSlant->"Italic"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7bd1e7e3-db41-4a6f-b581-0724d0781fd1"],
 " \[LineSeparator]simulates quantum measurement results for a list of \
quantum measurement operators (",
 Cell[BoxData[
  StyleBox["qmo",
   FontSlant->"Italic"]], "InlineFormula",ExpressionUUID->
  "d960e787-786a-405d-87c1-f70df5a4790c"],
 ") given a quantum state ",
 Cell[BoxData[
  StyleBox["state", "TI",
   FontSlant->"Italic"]], "InlineFormula",ExpressionUUID->
  "6ded9e1b-4089-4443-8067-24c00d123e6a"],
 ", for a given number of results (repetitions) ",
 Cell[BoxData[
  StyleBox["counts", "TI",
   FontSlant->"Italic"]], "InlineFormula",ExpressionUUID->
  "0d2531ee-1658-4ad2-89e2-1187a87a95bc"],
 "."
}], "Usage",
 CellChangeTimes->{{3.858969213096569*^9, 3.858969262806422*^9}, {
   3.859330670219985*^9, 3.8593307099400883`*^9}, {3.859330943141594*^9, 
