 CellID->14939724,ExpressionUUID->"cb0c1d31-beb9-4309-9ccf-9e0a1de3bfad"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"QuantumMeasurementSimulation", "[", 
   StyleBox["\[Ellipsis]", "TR"], "]"}]], "InlineFormula",ExpressionUUID->
  "d8c64a0c-7afd-44d8-be60-d3e7510c7041"],
 " simulates experimental results of a list of measurement, for given number \
of times (i.e. repetition) when a quantum system is prepared in a given state."
}], "Notes",
