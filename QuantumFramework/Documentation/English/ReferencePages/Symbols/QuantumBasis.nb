Cell["\<\
Given the elements of tetrahedron basis, find the corresponding quantum \
states and their Bloch vectors:\
\>", "ExampleText",ExpressionUUID->"af0d96b3-b439-4adc-9734-1c9e4e816d00"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pnts2", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Normalize", "@", 
      RowBox[{
       RowBox[{"QuantumState", "[", "#", "]"}], 
       "[", "\"\<BlochCartesianCoordinates\>\"", "]"}]}], " ", "&"}], " ", "/@",
     " ", "\n", "   ", 
    RowBox[{
     RowBox[{"QuditBasis", "[", "\"\<Tetrahedron\>\"", "]"}], 
     "[", "\"\<Elements\>\"", "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a9542316-978c-4c2e-8bcc-fa83209164f5"],

Cell["Show the Bloch vectors:", "ExampleText",ExpressionUUID->"7584ab20-69c3-4fd7-b3b0-07da287350d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumState", "[", "\"\<UniformMixture\>\"", "]"}], 
    "[", "\"\<BlochPlot\>\"", "]"}], ",", " ", "\n", " ", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Opacity", "[", ".3", "]"}], ",", " ", "Red", ",", " ", 
      RowBox[{"Tetrahedron", "[", "pnts2", "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"26bda99c-25ed-4dfe-aede-a7e443769e9c"],

