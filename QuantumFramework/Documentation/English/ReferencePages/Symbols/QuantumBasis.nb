Cell["\<\
Given the elements of tetrahedron basis, find the corresponding quantum \
states and their Bloch vectors:\
\>", "ExampleText",ExpressionUUID->"cc738800-6dad-43d5-a3cf-91493209dcf9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pnts2", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Normalize", "@", 
      RowBox[{
       RowBox[{"QuantumState", "[", "#", "]"}], 
       "[", "\"\<BlochCartesianCoordinates\>\"", "]"}]}], " ", "&"}], " ", "/@",
     " ", "\n", "   ", 
    RowBox[{
     RowBox[{"QuditBasis", "[", "\"\<Tetrahedron\>\"", "]"}], 
     "[", "\"\<Elements\>\"", "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"3562b67e-12ba-4f85-b652-4e59bae9ec14"],

Cell["Show the Bloch vectors:", "ExampleText",ExpressionUUID->"7798f0e8-7fbc-4cc3-b033-66688ba29995"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumState", "[", "\"\<UniformMixture\>\"", "]"}], 
    "[", "\"\<BlochPlot\>\"", "]"}], ",", " ", "\n", " ", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Opacity", "[", ".3", "]"}], ",", " ", "Red", ",", " ", 
      RowBox[{"Tetrahedron", "[", "pnts2", "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"a6ab6bdc-448d-4b5d-9392-fb1cf8745d8a"],

