Cell[CellGroupData[{
Cell["QuantumBasis", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"477bb898-3565-434c-bee1-73df29fab88d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], 
   "[", "\"\<\!\(\*StyleBox[\"name\", \"TI\"]\)\>\"", "]"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3cc81c2-037d-46fa-bf8a-8e51de13d369"],
 "\[LineSeparator]",
 "represents a named quantum basis ",
 StyleBox["name", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"57571038-346a-41a0-91eb-b62e8764e9cf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["name", "TI"], 
       StyleBox["1", "TR"]], " ", "->", " ", 
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["1", "TR"]]}], ",", " ", 
     RowBox[{
      SubscriptBox[
       StyleBox["name", "TI"], 
       StyleBox["2", "TR"]], " ", "->", " ", 
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["2", "TR"]]}], ",", " ", "\[Ellipsis]"}], "|>"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01d6e2a0-5b0f-4438-826d-a462e4e41c40"],
 "\[LineSeparator]",
 "represents a quantum basis with basis elements ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["b", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf2f9e70-e65f-4598-a640-c3d8e5c4871a"],
 ", having names ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["name",
    FontSlant->"Italic"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17c8fab1-baa5-47bf-881b-40451475ae34"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b4e7130c-0c40-4d9d-b731-9f28fc957184"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["n", "TI"], 
      StyleBox["1", "TR"]], ",", 
