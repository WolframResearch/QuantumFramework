Cell[TextData[{
 "Note that the basis names (i.e. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuditName"]], "paclet:Wolfram/QuantumFramework/ref/QuditName", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "02f01f9c-c0b5-4847-8634-6276ff67dd83"],
 ") has the format as ",
 Cell[BoxData[
  SubscriptBox["\|01d4b2", 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["q", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00d89ded-078e-48f1-a16b-81c192de164d"],
 " with ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " runs from 0 to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "624abab1-fa2a-47fe-a9a9-d62d33f51dee"],
 ". See ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumWignerTransform"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumWignerTransform", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2f878c22-7919-4c33-9fb0-ce97072362e2"],
 " for more details."
}], "ExampleText",ExpressionUUID->"7e377740-0100-4025-a3c9-bbba58323c96"],

