  FontSize->0.9 Inherited,ExpressionUUID->
  "47eba199-cc2d-4804-90b3-26c27d75ccd9"],
 "\[LineSeparator]",
 "represents a ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e622f30-4015-4b64-922b-a6f3ed3b7219"],
 " dimensional computational basis of a composite system (",
 StyleBox["m", "TI"],
 " qudits, each one, ",
 StyleBox["n", "TI"],
 "-dimensional).",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b83d76ef-c6f9-441d-8772-9f75d8241ca7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["1", "TR"]], ",", 
       SubscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["2", "TR"]], ",", "\[Ellipsis]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["1", "TR"]], ",", 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["2", "TR"]], ",", "\[Ellipsis]"}], "}"}]}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76376f90-5c0f-446a-a862-4392d0fc9a30"],
 "\[LineSeparator]",
 "represents a ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], "1"], "\[Times]", 
