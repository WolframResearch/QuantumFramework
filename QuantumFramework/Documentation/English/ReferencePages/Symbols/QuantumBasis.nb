Cell["\<\
Geometrical representations of qubit pure states in different bases:\
\>", "ExampleText",ExpressionUUID->"7eb40294-c5b1-4064-940d-32354791c6bc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"refpoints", " ", "=", " ", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
           RowBox[{"Prepend", "[", 
            RowBox[{"#", ",", " ", 
             RowBox[{"Norm", "[", "#", "]"}]}], "]"}]}], " ", "&"}], "@", 
         "\n", "      ", 
         RowBox[{
          RowBox[{"QuantumState", "[", "#", "]"}], "[", "\"\<BlochVector\>\"",
           "]"}]}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<1\>\"", ",", " ", "\"\<0\>\"", ",", " ", "\"\<+\>\"", ",",
          " ", "\"\<R\>\""}], "}"}]}]}], ",", "\n", "  ", 
     RowBox[{"pointNames", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<1\>\"", ",", " ", "\"\<0\>\"", ",", " ", "\"\<+\>\"", ",",
         " ", "\"\<R\>\""}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"spheres", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Bloch\>\"", ",", " ", "\"\<Wigner\>\"", ",", 
        " ", "\"\<WignerMIC\>\"", ",", " ", "\"\<Wootters\>\"", ",", 
        " ", "\"\<Tetrahedron\>\"", ",", "\n", "     ", "\"\<Pauli\>\"", ",", 
        " ", "\"\<GellMann\>\"", ",", " ", "\"\<RandomMIC\>\"", ",", " ", 
        RowBox[{"\"\<RandomMIC\>\"", "[", 
         RowBox[{"Method", " ", "->", " ", "\"\<Bloch\>\""}], "]"}]}], 
       "}"}]}], ",", "\n", "   ", 
     RowBox[{"colors", " ", "=", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Bloch\>\"", " ", "->", " ", "LightGray"}], ",", " ", 
        RowBox[{"\"\<Wigner\>\"", " ", "->", " ", "Red"}], ",", " ", "\n", 
        "    ", 
        RowBox[{"\"\<WignerMIC\>\"", " ", "->", " ", "Blue"}], ",", " ", 
        RowBox[{"\"\<Wootters\>\"", " ", "->", " ", "Orange"}], ",", " ", 
        RowBox[{"\"\<Tetrahedron\>\"", " ", "->", " ", "Green"}], ",", "\n", 
        "     ", 
        RowBox[{"\"\<Pauli\>\"", " ", "->", " ", "Black"}], ",", " ", 
        RowBox[{"\"\<GellMann\>\"", " ", "->", " ", "Magenta"}], ",", " ", 
        RowBox[{"\"\<RandomMIC\>\"", " ", "->", " ", "Cyan"}], ",", " ", "\n",
         "    ", 
        RowBox[{
         RowBox[{"\"\<RandomMIC\>\"", "[", 
          RowBox[{"Method", " ", "->", " ", "\"\<Bloch\>\""}], "]"}], " ", "->",
          " ", "LightCyan"}]}], "|>"}]}], ",", " ", 
     RowBox[{"showLabels", " ", "=", " ", "False"}], ",", "\n", "   ", 
     "vectors"}], "}"}], ",", "\n", " ", 
   RowBox[{"Panel", "@", 
    RowBox[{"Column", "[", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"CheckboxBar", "[", 
        RowBox[{
         RowBox[{"Dynamic", "[", "spheres", "]"}], ",", " ", "spheres", ",", 
         " ", "\n", "     ", 
         RowBox[{"Appearance", " ", "->", " ", 
          RowBox[{"\"\<Vertical\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "4"}], "}"}]}]}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"spheres", " ", "=", " ", "\n", "     ", 
         RowBox[{"DeleteElements", "[", "\n", "      ", 
          RowBox[{"spheres", ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<RandomMIC\>\"", ",", " ", 
             RowBox[{"\"\<RandomMIC\>\"", "[", 
              RowBox[{"Method", " ", "->", " ", "\"\<Bloch\>\""}], "]"}]}], 
            "}"}]}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<Labels: \>\"", ",", " ", 
           RowBox[{"Checkbox", "[", 
            RowBox[{"Dynamic", "[", "showLabels", "]"}], "]"}]}], "}"}], 
         "]"}]}], ",", "\n", "    ", 
       RowBox[{"Dynamic", "[", "\n", "     ", 
        RowBox[{"Panel", "[", 
         RowBox[{
          RowBox[{"Legended", "[", 
           RowBox[{
            RowBox[{"Graphics3D", "[", 
             RowBox[{
