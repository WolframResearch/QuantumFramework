       RowBox[{
        RowBox[{"\[Rho]", "[", "\"\<BlochVector\>\"", "]"}], " ", ".", " ", 
        RowBox[{"Normalize", "[", "#", "]"}]}], " ", "+", " ", "1"}], ")"}], "/",
      "4"}], " ", "&"}], " ", "/@", " ", "\n", "  ", 
   RowBox[{"PolyhedronCoordinates", "@", 
    RowBox[{"Tetrahedron", "[", "]"}]}]}]}]], "Input",
