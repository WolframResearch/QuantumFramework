Cell["Generate a random mixed state in 3D Hilbert space:", "ExampleText",ExpressionUUID->"f6b8ba12-cb52-43c8-9207-d5a0b964ee3f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "0", "]"}], ";"}], "\n", 
 RowBox[{"r", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"\"\<RandomMixed\>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{"d", " ", "=", " ", "3"}], "}"}]}], "]"}]}]}], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"03fe5f9d-d14d-4312-b4ee-14c625b0fbf1"],

