Cell["\<\
Reshape the amplitudes into 2\[Times]2 matrix and check if it is the same as \
\"PrimeQuasiProbability\" of the state:\
\>", "ExampleText",ExpressionUUID->"6c045a19-041a-41c4-8558-f04de9d75806"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Partition", "[", 
   RowBox[{
    RowBox[{"w", "[", "\"\<AmplitudesList\>\"", "]"}], ",", " ", 
    RowBox[{"{", "2", "}"}]}], "]"}], " ", "==", " ", 
  RowBox[{"\[Rho]", "[", "\"\<PrimeQuasiProbability\>\"", "]"}]}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"9998aba9-d0d6-4c2c-a6fd-ecad4d4d54b4"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"51a32ba1-8c4e-4584-b5f6-3fe999f3503f"]
}, Open  ]],

Cell["\<\
Verify that the sum of each column matches the probabilities in the \
computational basis (i.e., position basis):\
\>", "ExampleText",ExpressionUUID->"47f63121-23b7-4f4e-abdf-8554dd2ff87a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Total", "@", 
   RowBox[{"\[Rho]", "[", "\"\<PrimeQuasiProbability\>\"", "]"}]}], " ", "==",
   " ", 
  RowBox[{"\[Rho]", "[", "\"\<ProbabilitiesList\>\"", "]"}]}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"ab450ca7-f10c-4455-be94-e02c684edf7f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"49c3c2c6-9587-49ae-93e8-fc40d397e587"]
}, Open  ]],

Cell["\<\
Verify that the sum of each row matches the probabilities in the Pauli-X \
basis (i.e., momentum basis):\
\>", "ExampleText",ExpressionUUID->"f0b4df2b-855c-4ed3-a24c-a808e029fb0b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Total", " ", "/@", " ", 
   RowBox[{"\[Rho]", "[", "\"\<PrimeQuasiProbability\>\"", "]"}]}], " ", "==",
   " ", "\n", " ", 
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{"\[Rho]", ",", " ", "\"\<X\>\""}], "]"}], 
   "[", "\"\<ProbabilitiesList\>\"", "]"}]}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"e68e8f3e-66b7-4aa9-84bf-3ad1a5483fad"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"56675f81-e89f-4b3f-8621-08b5843ad77d"]
}, Open  ]]
}, Open  ]],

