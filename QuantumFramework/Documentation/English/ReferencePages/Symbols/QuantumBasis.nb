Cell["\<\
From TetrahedronSICPOVM which is a SIC-POVM, find the corresponding quantum \
states and their Bloch vectors and classify into two distinct categories \
based on their eigenvalues: those with an eigenvalue of 0 and those with an \
eigenvalue of 1/2:\
\>", "ExampleText",ExpressionUUID->"99c530a6-c47b-4aca-be97-791b94831e10"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pnts3", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumState", "[", "#", "]"}], 
        "[", "\"\<BlochCartesianCoordinates\>\"", "]"}], " ", "&"}], "]"}], 
     " ", "/@", " ", "\n", "    ", 
     RowBox[{"Eigenvectors", " ", "/@", " ", "\n", "     ", 
      RowBox[{
       RowBox[{
       "QuantumMeasurementOperator", "[", "\"\<TetrahedronSICPOVM\>\"", "]"}],
        "[", "\n", "      ", "\"\<POVMElements\>\"", "]"}]}]}], " ", "//", 
    " ", "Transpose"}]}], ";"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"7c85b96c-f2a1-4037-94f7-261c1668e7b1"],

Cell["\<\
To visualize these states, plot them on the Bloch sphere, with a red \
tetrahedron representing states with eigenvalue 1/2, and a blue tetrahedron \
representing states with eigenvalue 0.\
\>", "ExampleText",ExpressionUUID->"267209d7-315d-412a-a9e8-571b321f1c84"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumState", "[", "\"\<UniformMixture\>\"", "]"}], 
    "[", "\"\<BlochPlot\>\"", "]"}], ",", " ", "\n", " ", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Opacity", "[", ".5", "]"}], ",", " ", "Red", ",", " ", 
      RowBox[{"Tetrahedron", "[", 
       RowBox[{"pnts3", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", "Blue", ",", " ", 
      "\n", "   ", 
      RowBox[{"Tetrahedron", "[", 
       RowBox[{"pnts3", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"99587ac4-c3ff-4e4b-9087-844807f17cbf"],

