Cell["\<\
Every basis is also written in a picture, which defaults to the Schrodinger \
one:\
\>", "ExampleText",ExpressionUUID->"5093ab6f-2dcd-428d-a747-41ab589985c8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", "]"}], "[", "\"\<Picture\>\"", "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"ddc10b5c-0058-4dc1-886a-e76ae9ee0456"],

Cell[BoxData["\<\"Schrodinger\"\>"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"db342920-dd96-4b69-9150-97ed6fbbeadd"]
}, Open  ]],

Cell["Name a picture to get the default basis written in it:", "ExampleText",ExpressionUUID->"ef72d5c6-afd0-4369-b212-95e303357511"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", "\"\<Heisenberg\>\"", "]"}], 
  "[", "\"\<Picture\>\"", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b99d8800-8289-4432-b794-6d10ba92dadc"],

Cell[BoxData["\<\"Heisenberg\"\>"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"db401ed3-01ef-4c9a-a33f-04cb611607ab"]
}, Open  ]],

Cell["\<\
The picture may sit on either side of the basis specification, or be given as \
an option, and the three agree:\
\>", "ExampleText",ExpressionUUID->"c36cac04-f89b-4187-bcd2-febf21f92f54"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", 
   RowBox[{"\"\<Heisenberg\>\"", ",", " ", "\"\<PauliX\>\""}], "]"}], " ", "===",
   " ", 
  RowBox[{"QuantumBasis", "[", 
   RowBox[{"\"\<PauliX\>\"", ",", " ", "\"\<Heisenberg\>\""}], "]"}], " ", "===",
   " ", "\n", " ", 
  RowBox[{"QuantumBasis", "[", 
   RowBox[{"\"\<PauliX\>\"", ",", " ", 
    RowBox[{"\"\<Picture\>\"", " ", "->", " ", "\"\<Heisenberg\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"68fb76fc-1d93-4b3d-8ca1-3df636ab71d8"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"344ef54b-41a2-4761-a4ae-7e8442e0e6c1"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

