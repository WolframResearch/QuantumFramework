Cell["\<\
Every basis is also written in a picture, which defaults to the Schrodinger \
one:\
\>", "ExampleText",ExpressionUUID->"092b04c4-dab8-42b1-b6c3-d1fbd2bcc3ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", "]"}], "[", "\"\<Picture\>\"", "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"e2e374ce-b9a8-48ec-bd10-fb83e702e1ca"],

Cell[BoxData["\<\"Schrodinger\"\>"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"185cbc1d-8caa-42f3-bc1d-5ae37a67fa80"]
}, Open  ]],

Cell["Name a picture to get the default basis written in it:", "ExampleText",ExpressionUUID->"e0d41a5f-59f9-4faa-9c52-95a1f6758346"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", "\"\<Heisenberg\>\"", "]"}], 
  "[", "\"\<Picture\>\"", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7f28507c-09b9-4147-b037-4e1df3d8e443"],

Cell[BoxData["\<\"Heisenberg\"\>"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"065467c6-6118-4093-8a47-1319753fed3a"]
}, Open  ]],

Cell["\<\
The picture may sit on either side of the basis specification, or be given as \
an option, and the three agree:\
\>", "ExampleText",ExpressionUUID->"83373eff-dc55-45a7-907e-6de52ccaf6d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", 
   RowBox[{"\"\<Heisenberg\>\"", ",", " ", "\"\<PauliX\>\""}], "]"}], " ", "===",
   " ", 
  RowBox[{"QuantumBasis", "[", 
   RowBox[{"\"\<PauliX\>\"", ",", " ", "\"\<Heisenberg\>\""}], "]"}], " ", "===",
   " ", "\n", " ", 
  RowBox[{"QuantumBasis", "[", 
   RowBox[{"\"\<PauliX\>\"", ",", " ", 
    RowBox[{"\"\<Picture\>\"", " ", "->", " ", "\"\<Heisenberg\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"0d803579-2036-4fd5-b550-cb587bc36151"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"4dbeacea-6d2d-4c74-9cde-ac450564d299"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

