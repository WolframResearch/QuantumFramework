Cell[TextData[{
 "Note that the basis names (i.e. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuditName"]], "paclet:Wolfram/QuantumFramework/ref/QuditName", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c260cb70-a271-4eea-923b-ca849938dd6e"],
 ") has the format as ",
 Cell[BoxData[
  SubscriptBox["\|01d4b2", 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["q", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59cb8662-d229-4282-8c24-f515f8150663"],
 " with ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " runs from 0 to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "560dca58-0c6c-4551-b4dd-8af0142e6508"],
 ". See ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumWignerTransform"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumWignerTransform", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "73cbf609-2b92-4200-83b7-d850316667a8"],
 " for more details."
}], "ExampleText",ExpressionUUID->"9f9a5dda-99da-43f2-8b26-b19277fb2674"],

