    StyleBox["n", "TI"], "2"], "\[Times]", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b626f16-d4f7-4158-9b95-1e387113a1fe"],
 " dimensional computational basis output qudits, and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["m", "TI"], "1"], "\[Times]", 
   SubscriptBox[
    StyleBox["m", "TI"], "2"], "\[Times]", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edba305c-80f9-430c-9b65-984572e3d2b3"],
 " dimensional of the input qudits. Instead of dimension, one can add named \
basis, too."
}], "Usage",ExpressionUUID->"996b5747-1718-4b3f-90d0-fe2f223bd029"],

Cell[TextData[{
 "A quantum basis may consist of distinct input and output qudits. For \
instance, a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumOperator"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumOperator", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3c1ed8bd-13ee-4bf4-be47-1f8c7b41bccc"],
 " operates with both input and output qudits, while a typical ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumState"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumState", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e185748f-b3e5-47ce-a1a3-afaddb3e0b15"],
 " only pertains to output. Therefore, it's important to recognize that the \
concept of a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumBasis"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "953e7ccd-17a2-485d-b2f4-de729f126d1d"],
 " differs fundamentally from that of a basis in a Hilbert space. While users \
typically won't need to interact with this distinction directly, it is \
automatically handled behind the scenes for most practical purposes."
}], "Notes",ExpressionUUID->"2e0e219e-6b96-4e4b-81cf-18774db00a49"],

Cell["The keys names can be any expression.", "Notes",ExpressionUUID->"f00133cf-8ab0-46a0-a584-af964e5f52bd"],

Cell["Built-in names in the Hilbert space include:", "Notes",ExpressionUUID->"687db139-c769-43df-b65d-b8990367e4b6"],

