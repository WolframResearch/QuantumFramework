     FontSize->0.9 Inherited,ExpressionUUID->
     "0fff0f20-eba4-4108-9ea4-88406c0dae55"]], "TableText",ExpressionUUID->
     "d864340c-fb45-4c6e-9bec-e9d81f56d74c"], Cell[
    "2-dimensional phase space basis", "TableText",ExpressionUUID->
     "5050cf8c-964f-498f-8240-07f7baf68d91"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "03165416-5c3a-4bd2-a758-80c4e13049a1"], Cell[TextData[Cell[BoxData[
     RowBox[{"\"\<Wootters\>\"", "[", "p", "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "951547ff-30e1-4e4c-838c-d5031b57c5d8"]], "TableText",ExpressionUUID->
