Cell["Generate a random mixed state in 3D Hilbert space:", "ExampleText",ExpressionUUID->"0aa59b15-b54e-4e3e-90a3-2595c727e0a8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"RandomSeed", "[", "0", "]"}], ";"}], "\n", 
 RowBox[{"r", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"\"\<RandomMixed\>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{"d", " ", "=", " ", "3"}], "}"}]}], "]"}]}]}], "Input",
