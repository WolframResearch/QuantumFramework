    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["n", "TI"], ",", 
    StyleBox["m", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46552fb1-3d4d-44cd-8a2b-3eff9c2753ed"],
 "\[LineSeparator]",
 "represents a ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1645266-db55-4e6c-9533-6b9167b85659"],
 " dimensional computational basis of a composite system (",
 StyleBox["m", "TI"],
 " qudits, each one, ",
 StyleBox["n", "TI"],
 "-dimensional).",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"837eeee6-c9fb-4c3f-be2f-2cb3d65ce036"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["1", "TR"]], ",", 
       SubscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["2", "TR"]], ",", "\[Ellipsis]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["1", "TR"]], ",", 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["2", "TR"]], ",", "\[Ellipsis]"}], "}"}]}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ecb5d69-3357-413c-896c-454865252cc4"],
 "\[LineSeparator]",
 "represents a ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], "1"], "\[Times]", 
   SubscriptBox[
    StyleBox["n", "TI"], "2"], "\[Times]", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b431ccbd-5f64-4203-bac2-a0ffea887489"],
 " dimensional computational basis output qudits, and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["m", "TI"], "1"], "\[Times]", 
   SubscriptBox[
    StyleBox["m", "TI"], "2"], "\[Times]", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b197ccc8-542c-449e-8cc0-e5ddd0ebe4ec"],
 " dimensional of the input qudits. Instead of dimension, one can add named \
basis, too."
}], "Usage",ExpressionUUID->"d66c9c9b-3b2f-4f10-92bd-2b64ced158ff"],

Cell[TextData[{
 "A quantum basis may consist of distinct input and output qudits. For \
instance, a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumOperator"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumOperator", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "67e4583f-3767-40db-aa33-6fdb477f742f"],
 " operates with both input and output qudits, while a typical ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumState"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumState", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f194a504-ccca-48e2-88c0-855a6f6df378"],
 " only pertains to output. Therefore, it's important to recognize that the \
concept of a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumBasis"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "68d5d7f5-6b9f-4f5c-b084-ee8c2787e3da"],
 " differs fundamentally from that of a basis in a Hilbert space. While users \
typically won't need to interact with this distinction directly, it is \
automatically handled behind the scenes for most practical purposes."
}], "Notes",ExpressionUUID->"8240502e-c3c8-475e-839f-34c5c0f47da8"],

Cell["The keys names can be any expression.", "Notes",ExpressionUUID->"779dd087-487a-4681-9998-de5fd4a803b4"],

Cell["Built-in names in the Hilbert space include:", "Notes",ExpressionUUID->"2f43da5b-c344-41eb-abd4-bf100f4863e2"],

