Cell["\<\
From TetrahedronSICPOVM which is a SIC-POVM, find the corresponding quantum \
states and their Bloch vectors and classify into two distinct categories \
based on their eigenvalues: those with an eigenvalue of 0 and those with an \
eigenvalue of 1/2:\
\>", "ExampleText",ExpressionUUID->"08ace55a-1cad-483f-abb3-5e99742bcc16"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pnts3", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumState", "[", "#", "]"}], 
        "[", "\"\<BlochCartesianCoordinates\>\"", "]"}], " ", "&"}], "]"}], 
     " ", "/@", " ", "\n", "    ", 
     RowBox[{"Eigenvectors", " ", "/@", " ", "\n", "     ", 
      RowBox[{
       RowBox[{
       "QuantumMeasurementOperator", "[", "\"\<TetrahedronSICPOVM\>\"", "]"}],
        "[", "\n", "      ", "\"\<POVMElements\>\"", "]"}]}]}], " ", "//", 
    " ", "Transpose"}]}], ";"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"2548acef-434e-42de-a4ae-582364dc2c97"],

Cell["\<\
To visualize these states, plot them on the Bloch sphere, with a red \
tetrahedron representing states with eigenvalue 1/2, and a blue tetrahedron \
representing states with eigenvalue 0.\
\>", "ExampleText",ExpressionUUID->"0b3b101e-0b6a-4eab-939d-dc1993e43ad6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumState", "[", "\"\<UniformMixture\>\"", "]"}], 
    "[", "\"\<BlochPlot\>\"", "]"}], ",", " ", "\n", " ", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Opacity", "[", ".5", "]"}], ",", " ", "Red", ",", " ", 
      RowBox[{"Tetrahedron", "[", 
       RowBox[{"pnts3", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", "Blue", ",", " ", 
      "\n", "   ", 
      RowBox[{"Tetrahedron", "[", 
       RowBox[{"pnts3", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"28326627-2360-484b-9d2d-98b5b9bce44e"],

