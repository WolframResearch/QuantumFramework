Cell["\<\
Reshape the amplitudes into 2\[Times]2 matrix and check if it is the same as \
\"PrimeQuasiProbability\" of the state:\
\>", "ExampleText",ExpressionUUID->"1a51e4bf-5338-497f-afea-a1fa6827ccc8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Partition", "[", 
   RowBox[{
    RowBox[{"w", "[", "\"\<AmplitudesList\>\"", "]"}], ",", " ", 
    RowBox[{"{", "2", "}"}]}], "]"}], " ", "==", " ", 
  RowBox[{"\[Rho]", "[", "\"\<PrimeQuasiProbability\>\"", "]"}]}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"790c79f5-a319-42c4-a1a9-0233bb3ca429"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"82271c01-92d2-43c7-a687-ede251c0c5e8"]
}, Open  ]],

Cell["\<\
Verify that the sum of each column matches the probabilities in the \
computational basis (i.e., position basis):\
\>", "ExampleText",ExpressionUUID->"4bbe1481-993c-48a1-a8b8-deb2452e7478"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Total", "@", 
   RowBox[{"\[Rho]", "[", "\"\<PrimeQuasiProbability\>\"", "]"}]}], " ", "==",
   " ", 
  RowBox[{"\[Rho]", "[", "\"\<ProbabilitiesList\>\"", "]"}]}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"0274e03e-4653-4624-a35e-63acb832f7ec"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"fd95e277-2b3d-48d2-9a82-015f206bf6b2"]
}, Open  ]],

Cell["\<\
Verify that the sum of each row matches the probabilities in the Pauli-X \
basis (i.e., momentum basis):\
\>", "ExampleText",ExpressionUUID->"13a57547-6669-455d-840c-cfb33cea95b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Total", " ", "/@", " ", 
   RowBox[{"\[Rho]", "[", "\"\<PrimeQuasiProbability\>\"", "]"}]}], " ", "==",
   " ", "\n", " ", 
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{"\[Rho]", ",", " ", "\"\<X\>\""}], "]"}], 
   "[", "\"\<ProbabilitiesList\>\"", "]"}]}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"b63d1a40-9d8d-4d79-94d5-9b7e71435be6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"f6c69e0a-8d05-42b0-8ffa-e9a9ccddb130"]
}, Open  ]]
}, Open  ]],

