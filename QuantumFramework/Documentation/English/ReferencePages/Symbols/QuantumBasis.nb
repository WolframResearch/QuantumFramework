  FontSize->0.9 Inherited,ExpressionUUID->
  "a334d92b-339c-4a8f-9262-45ed745a7f40"],
 "\[LineSeparator]",
 "represents a named quantum basis ",
 StyleBox["name", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fcfda5b6-2ad8-44b2-96a4-cff564dd49e4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["name", "TI"], 
       StyleBox["1", "TR"]], " ", "->", " ", 
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["1", "TR"]]}], ",", " ", 
     RowBox[{
      SubscriptBox[
       StyleBox["name", "TI"], 
       StyleBox["2", "TR"]], " ", "->", " ", 
