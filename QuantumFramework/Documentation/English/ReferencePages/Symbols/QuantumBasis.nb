     " is a prime number"
    }], "TableText",ExpressionUUID->"563047e0-621b-4a85-8654-957fe1beed01"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "aec26bd8-d349-4fec-97b7-dc62f92d076d"], Cell[TextData[Cell[
    BoxData["\"\<Bloch\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b3c1a325-9459-4e4f-92a1-d860aeef9744"]], "TableText",ExpressionUUID->
     "c0c6d264-9ec0-4087-ae95-2e6dd9d87959"], Cell[
    "Phase space basis of generalized Bloch coordinates", "TableText",
     ExpressionUUID->"98bee42a-b184-480a-82cc-14c58cc8cb18"]}
  }]], "2ColumnTableMod",ExpressionUUID->"813ec9ee-055b-4d4e-82e3-\
a93034bf75ef"],

Cell[TextData[{
 "A few properties of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumBasis"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7b25592a-cb46-40eb-8453-0c13934321e9"],
 " are:"
}], "Notes",ExpressionUUID->"b3700a6c-5a3e-48e5-b322-570e324d9946"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c09b8a0e-615a-4ec8-a877-3cb31d13148e"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"b3c74746-44ab-4393-a660-bb5dd0a5a5e0"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"f5a6ef7e-2b6f-40eb-a09b-998808996353"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c7ab8d86-b39b-4f48-ade6-21e87e966315"], Cell[TextData[Cell[
    BoxData["\"\<Association\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "da171d2e-11ba-4725-87d4-6934bf369660"]], "TableText",ExpressionUUID->
     "20840dc0-0849-4cab-89de-ef988ff0609e"], Cell["\<\
An association with keys the formatted symbols of basis elements, and values \
the corresponding tensor\
\>", "TableText",ExpressionUUID->"c33ab677-fc58-4a63-9d53-6a82c24c4bae"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1bcc7546-1a60-4035-80de-b3f2d87e490e"], Cell[TextData[Cell[
    BoxData["\"\<Elements\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "87dccf04-e6c0-483d-b9eb-3c5b1fd11be4"]], "TableText",ExpressionUUID->
     "b05a4bf4-2876-4e57-8dd6-489724a7dff7"], Cell[
    "Corresponding elements of a basis", "TableText",ExpressionUUID->
     "68c31137-1ec2-4583-bc56-b9bc0d1bc1f6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6c1efa0b-ae33-47b4-8e9e-d6fab54d4ba0"], Cell[TextData[Cell[
    BoxData["\"\<OrthogonalElements\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7872d019-14ed-43d9-934c-9f1366361604"]], "TableText",ExpressionUUID->
     "fe503d12-9b09-4306-aee1-ef2042da2447"], Cell[
    "Corresponding orthogonal elements of a basis", "TableText",
     ExpressionUUID->"3208b554-583c-453b-bc55-dec133c8ab8a"]}
  }]], "2ColumnTableMod",ExpressionUUID->"999c9063-fabb-471d-8e0c-\
0bfc90412354"],

Cell[TextData[{
 "Besides its input and output qudits, a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumBasis"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e84cac0d-a2ac-4c97-a9e3-bfb30be0c6f5"],
 " carries a ",
 StyleBox["picture",
  FontWeight->"Bold"],
 ", recovered with ",
 Cell[BoxData[
  RowBox[{"qb", "[", "\"\<Picture\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0534d77-c54d-4340-a951-ae1b2e18f680"],
 ". The picture records where the time dependence of a system written in this \
basis is kept; it is part of the basis identity but says nothing about the \
basis elements themselves. Built-in pictures are:"
}], "Notes",ExpressionUUID->"6d242db0-fe25-4052-b777-a9a5cc97e49a"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f2f5955b-d1a7-4e96-be79-fafb69a28bae"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"dc23f3c8-a0b4-424a-8d78-ab64413b6101"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"f9f76140-63ee-480f-83b5-d1c15c554221"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "330eb922-6f7f-40e3-b6aa-7695e6b0896b"], Cell[TextData[Cell[
    BoxData["\"\<Schrodinger\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0828d5e1-0510-4c32-8cd6-fb553c019f14"]], "TableText",ExpressionUUID->
     "8db54844-5fbb-4625-a191-8dfb31d94ac4"], Cell["\<\
states carry the time dependence and operators are fixed; the default\
\>", "TableText",ExpressionUUID->"82cb8fe8-8409-4bbd-bfa1-bbb698f7f7d0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e638f59d-766f-4cb7-858d-c782311cbc57"], Cell[TextData[Cell[
    BoxData["\"\<Heisenberg\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4e771b75-1c37-4eef-ba6c-c098aa73a97f"]], "TableText",ExpressionUUID->
     "df960605-56df-4d6a-9986-494d1f24dd0f"], Cell[
    "operators carry the time dependence and states are fixed", "TableText",
     ExpressionUUID->"d37f0580-951d-4591-ae54-fb164630bf6d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f4fe648b-fbea-46a4-a19b-62a03ae41ee1"], Cell[TextData[Cell[
    BoxData["\"\<Interaction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "52fcabb8-04bc-452c-9f8b-8f47b139b8d9"]], "TableText",ExpressionUUID->
     "aafae23d-a7e5-4c90-93eb-f39e844a7524"], Cell[
    "the time dependence is divided between states and operators", 
     "TableText",ExpressionUUID->"bc1e7146-c694-4a70-a2f1-7b0363f54139"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e40f384d-b723-4d03-85b2-616645945f8b"], Cell[TextData[Cell[
    BoxData["\"\<PhaseSpace\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "00dea32a-85f2-42aa-9e5a-6102cef47c6e"]], "TableText",ExpressionUUID->
     "51764d76-a032-4bb1-9d96-0799a0bf5cdd"], Cell[TextData[{
     "the tag a phase-space basis carries; a basis whose ",
     StyleBox["elements", "TI"],
     " form a phase-space frame sets it for itself, and a state expanded in \
such a basis is a quasi-probability distribution rather than an amplitude \
vector"
    }], "TableText",ExpressionUUID->"d995f421-89e2-4841-8bd5-f0ed174bb1fc"]}
  }]], "2ColumnTableMod",ExpressionUUID->"671388b7-8620-434c-adee-\
7e9fee99711a"],

Cell[TextData[{
 "A picture may be named positionally, on either side of the basis \
specification, or given as the ",
 Cell[BoxData["\"\<Picture\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20045eac-ee04-4e71-8de3-06e6e3c1de63"],
 " option, and the three forms agree. So ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "\"\<Heisenberg\>\"", "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec15822d-dad2-472c-8b77-095f7cf86895"],
 " is the default basis in the Heisenberg picture, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "\"\<Schrodinger\>\"", "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a33879bb-8351-4238-8476-dbd17a84faf6"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e00bdd7-26e6-423f-a5d6-e028f2012565"],
 ". A picture may also trail a two-sided specification, as in ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", 
    " ", "\"\<Heisenberg\>\""}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca4c55da-c587-481e-bce5-e6085d46aef9"],
 "."
}], "Notes",ExpressionUUID->"d9a4e4e7-4f5d-4766-9f17-6e4b416efee8"],

Cell[TextData[{
 "When more than one picture is written, the one written ",
 StyleBox["first",
  FontWeight->"Bold"],
 " wins, positional and option alike: the arguments are folded in reverse, so \
the earliest is applied last. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"\"\<Heisenberg\>\"", ",", " ", 
    RowBox[{"\"\<Picture\>\"", " ", "->", " ", "\"\<Interaction\>\""}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bc86e05-98d5-42f3-bb49-098a2ba9dfe8"],
 " is in the Heisenberg picture."
}], "Notes",ExpressionUUID->"ab2daed6-6eae-4f85-84d1-296a0ad5104a"],

Cell[TextData[{
 "A trailing integer is read as a multiplicity rather than a dimension, so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"\"\<Heisenberg\>\"", ",", " ", "3"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0848442e-d269-414b-94b8-6d303cc3370f"],
 " is three qubits in the Heisenberg picture."
}], "Notes",ExpressionUUID->"df6b5b70-b2a3-42c0-ab61-65a85a2cb98d"],

Cell[TextData[{
 "A phase-space basis name sets ",
 Cell[BoxData["\"\<PhaseSpace\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8bab32b-6d07-4dd7-b524-6141da002486"],
 " on its own, so a picture normally only needs naming for ",
 Cell[BoxData["\"\<Heisenberg\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49ad56a7-6ae5-40b4-9858-73cc8c4f7bed"],
 " and ",
 Cell[BoxData["\"\<Interaction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dab1e7af-088b-475c-b6d1-e6f838730f53"],
 "."
}], "Notes",ExpressionUUID->"4787dba7-b126-4d4a-bc64-52f4522a3ada"],

Cell[TextData[{
 "Such a basis will not be renamed to another picture positionally: its \
elements, not a label, are what put it in phase space, so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"\"\<Wigner\>\"", ",", " ", "\"\<Heisenberg\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "682f0d3f-8716-45a3-948c-85e8dd7bbaec"],
 " is rejected with ",
 Cell[BoxData[
  RowBox[{"QuantumBasis", "::", "phaseSpacePicture"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b0fb407-a3e7-4c73-9450-9d3135fe9117"],
 ". The ",
 Cell[BoxData["\"\<Picture\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78a4bf9d-0af2-46af-a3d5-cf711e74dff9"],
 " option is deliberately left open for code that has actually undone the \
transform."
}], "Notes",ExpressionUUID->"7461ee3d-2b38-4acc-bd9b-922fa9b57c52"],

Cell[TextData[{
 "The picture travels with the basis into whatever is built on it, so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumState"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumState", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["spec", "TI"], ",", " ", "\"\<Heisenberg\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aaab025-6df4-4a22-bb34-f9764eddd448"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumOperator"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumOperator", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["spec", "TI"], ",", " ", "\"\<Heisenberg\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f11aaf70-1cae-4515-bce9-432cc36c6745"],
 " both land in the Heisenberg picture."
}], "Notes",ExpressionUUID->"c807f341-ff44-4c19-9eab-a83e37a160f4"],

Cell[TextData[{
 "Any picture outside the four above is rejected with ",
 Cell[BoxData[
  RowBox[{"QuantumBasis", "::", "picture"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb2bec52-9b64-40ad-8d77-0b28566443cc"],
 ". A picture followed by a tail that is not a basis specification at all, \
such as a bare symbol or a non-integer number, is rejected with ",
 Cell[BoxData[
  RowBox[{"QuantumBasis", "::", "invalidSpec"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c9e83be-466e-4825-b27c-a393232fc3bd"],
 " naming that tail; a tail that fails on its own terms reports its own \
reason instead, so an unrecognized basis ",
 StyleBox["name", "TI"],
 " gives ",
 Cell[BoxData[
  RowBox[{"QuditBasis", "::", "invalidName"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5374e4a1-34b0-4fc7-a67a-cf4e9708bd83"],
 " and a negative integer gives ",
 Cell[BoxData[
  RowBox[{"QuditBasis", "::", "invalidArgs"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2012041-1c85-4946-8dcc-fe79bf8dfadf"],
 "."
}], "Notes",ExpressionUUID->"46eb65ef-99a7-436c-8f40-a960c4f7ecd0"],

