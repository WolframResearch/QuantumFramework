Cell[TextData[{
 "Check POVM elements are explicitly positive semidefinite, and sum up to \
identity. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ComplexExpand"]], "paclet:ref/ComplexExpand"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "64fb7870-c19e-4570-845d-3766340d0036"],
 " rewrites the stored roots of unity as explicit radicals, which keeps the \
positivity test in exact arithmetic and collapses the sum to the identity:"
}], "ExampleText",ExpressionUUID->"2d8ef7d9-e95c-4535-9e39-a568cab44d0b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"And", " ", "@@", " ", 
  RowBox[{"(", 
   RowBox[{"PositiveSemidefiniteMatrixQ", " ", "/@", " ", "\n", "   ", 
    RowBox[{"ComplexExpand", "[", 
     RowBox[{"\[ScriptCapitalM]", "[", "\"\<POVMElements\>\"", "]"}], "]"}]}],
    ")"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Total", "[", 
    RowBox[{"\[ScriptCapitalM]", "[", "\"\<POVMElements\>\"", "]"}], "]"}], 
   " ", "//", " ", "Normal"}], " ", "//", " ", "ComplexExpand"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"694e7c35-9fdb-4c36-8acc-fe91832ee487"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[2@1]= ",ExpressionUUID->"9a479aba-9871-44aa-b2d6-c1f6e224ffd6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[2@2]= ",ExpressionUUID->"0fe0e2fc-1b79-43c1-8a10-b49f21fde436"]
}, Open  ]],

Cell["\<\
Gram matrix is used to transform between basis and its corresponding POVM:\
\>", "ExampleText",ExpressionUUID->"976cd066-7b51-4028-96e2-57bda8e36cf3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalG]", " ", "=", " ", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Inverse", "[", 
       RowBox[{"Outer", "[", 
        RowBox[{
         RowBox[{"Tr", "@*", "Dot"}], ",", " ", "#", ",", " ", "#", ",", " ", 
         "1"}], "]"}], "]"}], " ", "&"}], "@", 
     RowBox[{
     "\[ScriptCapitalM]", "[", "\n", "     ", "\"\<POVMElements\>\"", "]"}]}],
     " ", "//", " ", "Simplify"}]}], ";"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"4625c221-1ee1-42f9-b824-d14407c28e02"],

Cell["Check if Gram matrix is explicitly positive semidefinite:", \
"ExampleText",ExpressionUUID->"bd351a43-a4e3-4645-b85d-41e7c46d4640"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PositiveSemidefiniteMatrixQ", "[", "\[ScriptCapitalG]", 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"2c829064-7160-43e4-94c8-c1424e125aae"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"ee36008a-6f1e-4b0b-a4c6-36e1f38b74dc"]
}, Open  ]],

