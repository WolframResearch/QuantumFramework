Cell["\<\
Geometrical representations of qubit pure states in different bases:\
\>", "ExampleText",ExpressionUUID->"d9efeb48-f7de-4fed-bf6d-e05c599cab3e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"refpoints", " ", "=", " ", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
           RowBox[{"Prepend", "[", 
            RowBox[{"#", ",", " ", 
             RowBox[{"Norm", "[", "#", "]"}]}], "]"}]}], " ", "&"}], "@", 
         "\n", "      ", 
         RowBox[{
          RowBox[{"QuantumState", "[", "#", "]"}], "[", "\"\<BlochVector\>\"",
           "]"}]}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<1\>\"", ",", " ", "\"\<0\>\"", ",", " ", "\"\<+\>\"", ",",
          " ", "\"\<R\>\""}], "}"}]}]}], ",", "\n", "  ", 
     RowBox[{"pointNames", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<1\>\"", ",", " ", "\"\<0\>\"", ",", " ", "\"\<+\>\"", ",",
         " ", "\"\<R\>\""}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"spheres", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Bloch\>\"", ",", " ", "\"\<Wigner\>\"", ",", 
        " ", "\"\<WignerMIC\>\"", ",", " ", "\"\<Wootters\>\"", ",", 
        " ", "\"\<Tetrahedron\>\"", ",", "\n", "     ", "\"\<Pauli\>\"", ",", 
        " ", "\"\<GellMann\>\"", ",", " ", "\"\<RandomMIC\>\"", ",", " ", 
        RowBox[{"\"\<RandomMIC\>\"", "[", 
         RowBox[{"Method", " ", "->", " ", "\"\<Bloch\>\""}], "]"}]}], 
       "}"}]}], ",", "\n", "   ", 
     RowBox[{"colors", " ", "=", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Bloch\>\"", " ", "->", " ", "LightGray"}], ",", " ", 
        RowBox[{"\"\<Wigner\>\"", " ", "->", " ", "Red"}], ",", " ", "\n", 
        "    ", 
        RowBox[{"\"\<WignerMIC\>\"", " ", "->", " ", "Blue"}], ",", " ", 
        RowBox[{"\"\<Wootters\>\"", " ", "->", " ", "Orange"}], ",", " ", 
        RowBox[{"\"\<Tetrahedron\>\"", " ", "->", " ", "Green"}], ",", "\n", 
        "     ", 
        RowBox[{"\"\<Pauli\>\"", " ", "->", " ", "Black"}], ",", " ", 
        RowBox[{"\"\<GellMann\>\"", " ", "->", " ", "Magenta"}], ",", " ", 
        RowBox[{"\"\<RandomMIC\>\"", " ", "->", " ", "Cyan"}], ",", " ", "\n",
         "    ", 
        RowBox[{
         RowBox[{"\"\<RandomMIC\>\"", "[", 
          RowBox[{"Method", " ", "->", " ", "\"\<Bloch\>\""}], "]"}], " ", "->",
          " ", "LightCyan"}]}], "|>"}]}], ",", " ", 
     RowBox[{"showLabels", " ", "=", " ", "False"}], ",", "\n", "   ", 
     "vectors"}], "}"}], ",", "\n", " ", 
   RowBox[{"Panel", "@", 
    RowBox[{"Column", "[", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"CheckboxBar", "[", 
        RowBox[{
         RowBox[{"Dynamic", "[", "spheres", "]"}], ",", " ", "spheres", ",", 
         " ", "\n", "     ", 
         RowBox[{"Appearance", " ", "->", " ", 
          RowBox[{"\"\<Vertical\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "4"}], "}"}]}]}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"spheres", " ", "=", " ", "\n", "     ", 
         RowBox[{"DeleteElements", "[", "\n", "      ", 
          RowBox[{"spheres", ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<RandomMIC\>\"", ",", " ", 
             RowBox[{"\"\<RandomMIC\>\"", "[", 
              RowBox[{"Method", " ", "->", " ", "\"\<Bloch\>\""}], "]"}]}], 
            "}"}]}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<Labels: \>\"", ",", " ", 
           RowBox[{"Checkbox", "[", 
            RowBox[{"Dynamic", "[", "showLabels", "]"}], "]"}]}], "}"}], 
         "]"}]}], ",", "\n", "    ", 
       RowBox[{"Dynamic", "[", "\n", "     ", 
        RowBox[{"Panel", "[", 
         RowBox[{
          RowBox[{"Legended", "[", 
           RowBox[{
            RowBox[{"Graphics3D", "[", 
             RowBox[{
              RowBox[{"{", "\n", "         ", 
               RowBox[{
                RowBox[{"Opacity", "[", ".3", "]"}], ",", "\n", "         ", 
                "\n", "         ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"MemberQ", "[", 
                   RowBox[{"spheres", ",", " ", "\"\<Bloch\>\""}], "]"}], ",",
                   " ", 
                  RowBox[{"{", 
                   RowBox[{"LightGray", ",", " ", 
                    RowBox[{"Sphere", "[", "]"}], ",", " ", "\n", 
                    "           ", 
                    RowBox[{"If", "[", 
                    RowBox[{"showLabels", ",", " ", "\n", "            ", 
                    RowBox[{"MapThread", "[", "\n", "             ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Text", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"Ket", "[", 
                    RowBox[{"{", "#1", "}"}], "]"}], ",", " ", "Black"}], 
                    "]"}], ",", " ", 
                    RowBox[{"Rest", "[", "#2", "]"}]}], "]"}], " ", "&"}], ",",
                     " ", 
                    RowBox[{"{", 
                    RowBox[{
                    "pointNames", ",", " ", "\n", "              ", 
                    "refpoints"}], "}"}]}], "]"}], ",", " ", "Nothing"}], 
                    "]"}]}], "}"}], ",", " ", "Nothing"}], "]"}], ",", "\n", 
                "         ", "\n", "         ", 
                RowBox[{"Map", "[", 
                 RowBox[{
                  RowBox[{"basisName", " ", "|->", " ", "\n", "           ", 
                   RowBox[{"Block", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"basis", " ", "=", " ", 
                    RowBox[{"QuditBasis", "[", "basisName", "]"}]}], ",", " ",
                     "center", ",", "\n", "             ", "points"}], "\n", 
                    "             ", "}"}], ",", "\n", "            ", "\n", 
                    "            ", 
                    RowBox[{
                    RowBox[{"center", " ", "=", " ", "\n", "             ", 
                    RowBox[{
                    RowBox[{"QuantumState", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    "QuantumState", "[", "\"\<UniformMixture\>\"", "]"}], 
                    "[", "\"\<Double\>\"", "]"}], ",", " ", "\n", 
                    "               ", "basis"}], "]"}], 
                    "[", "\"\<StateVector\>\"", "]"}]}], ";", "\n", 
                    "            ", "\n", "            ", 
                    RowBox[{"points", " ", "=", " ", "\n", "             ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Chop", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"QuantumState", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"QuantumState", "[", "#", "]"}], 
                    "[", "\"\<Double\>\"", "]"}], ",", " ", "basis"}], "]"}], 
                    "[", "\n", "                   ", "\"\<StateVector\>\"", 
                    "]"}], " ", "-", " ", "center"}], "]"}], " ", "&"}], " ", 
                    "/@", " ", "pointNames"}], " ", "//", " ", "Normal"}]}], ";",
                     "\n", "            ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"colors", "[", "basisName", "]"}], ",", " ", 
                    RowBox[{"PointSize", "[", "0.03", "]"}], ",", " ", "\n", 
