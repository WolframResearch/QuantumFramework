     "43cc9072-f090-4dde-880d-07dc829d7bfd"], Cell[TextData[{
     StyleBox["d", "TI"],
     "-dimensional basis of the Wigner phase space operators with respect to \
the computational basis"
    }], "TableText",ExpressionUUID->"b8c5bb84-b4fd-4bca-af1e-99992d6791a0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6787719d-8400-4cd6-b125-30ff531c1f43"], Cell[TextData[Cell[
    BoxData["\"\<Wootters\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "232d0cc8-390e-4343-ac7c-c9f24bf247fb"]], "TableText",ExpressionUUID->
     "50c4a318-092c-4ca7-ac75-3a06d319abc2"], Cell[
    "2-dimensional phase space basis", "TableText",ExpressionUUID->
     "4c6f14b6-dc9c-4b51-923a-e986ff399809"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a008ecbb-db29-4d3d-afb0-bc01c782f52b"], Cell[TextData[Cell[BoxData[
     RowBox[{"\"\<Wootters\>\"", "[", "p", "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "22954ee3-2cb9-447e-be51-4c521936afbc"]], "TableText",ExpressionUUID->
     "6cf101f8-9e8f-4170-b2ee-be794b4836b3"], Cell[TextData[{
     StyleBox["p", "TI"],
     "-dimensional phase space basis where ",
     StyleBox["p", "TI"],
     " is a prime number"
    }], "TableText",ExpressionUUID->"ff1b13c2-e813-417b-8a66-3b298f1f5094"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "403e4e2d-9a00-49c9-b15c-bd25a721c37a"], Cell[TextData[Cell[
    BoxData["\"\<Bloch\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "14cb30a3-1354-43bb-8c93-57de285b4105"]], "TableText",ExpressionUUID->
     "7c54ae1b-452b-4fe0-a3ec-2072460de633"], Cell[
    "Phase space basis of generalized Bloch coordinates", "TableText",
     ExpressionUUID->"697e7d38-f5ea-4831-8c7d-96a955da38ff"]}
  }]], "2ColumnTableMod",ExpressionUUID->"df4ce39c-9e13-4bba-9dc2-\
46934498faf7"],

Cell[TextData[{
 "A few properties of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumBasis"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2325bf01-530c-4919-81e3-b0e1775bf986"],
 " are:"
}], "Notes",ExpressionUUID->"c766d98c-198a-4d63-95be-6eea8f5d1243"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "338c4bfb-afe1-45fc-9399-f51f80201b03"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"e83b0c2d-7c8e-4e44-84f3-a0f8acc9d346"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"8dd1909a-cbf8-49fd-87aa-cafca956b4b9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ac284079-0b69-4046-b615-511b21216e66"], Cell[TextData[Cell[
    BoxData["\"\<Association\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "04cc89d4-0ac6-4e06-8d87-dfa969373f7a"]], "TableText",ExpressionUUID->
     "f64f9d0d-fe17-428a-9110-4f2e1b45d79b"], Cell["\<\
An association with keys the formatted symbols of basis elements, and values \
the corresponding tensor\
\>", "TableText",ExpressionUUID->"1a1e7b15-95b2-4a6c-b664-e4ca2bd4369b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "49f0de8a-f28c-42e1-95ea-605ad55f0132"], Cell[TextData[Cell[
    BoxData["\"\<Elements\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f4897ec8-d55e-419f-b878-db5ffd79f7e2"]], "TableText",ExpressionUUID->
     "e0606295-c627-4a49-b2ab-4decf61e828e"], Cell[
    "Corresponding elements of a basis", "TableText",ExpressionUUID->
     "c39cddb0-4346-4b6b-8f83-db01fb073f42"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b2344978-c090-40d6-a28e-cb05d284938d"], Cell[TextData[Cell[
    BoxData["\"\<OrthogonalElements\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c71a400a-9692-4818-a836-ace2208b9515"]], "TableText",ExpressionUUID->
     "da4ed726-33e6-4cbf-ae96-e474db64e0dc"], Cell[
    "Corresponding orthogonal elements of a basis", "TableText",
     ExpressionUUID->"edc641cd-23ae-4015-b0db-5e6ac838f953"]}
  }]], "2ColumnTableMod",ExpressionUUID->"ffaec27b-ca06-4afb-9131-\
6641e5bd6bcb"],

Cell[TextData[{
 "Besides its input and output qudits, a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumBasis"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3284919b-2147-4a32-aa04-6316dc8d893b"],
 " carries a ",
 StyleBox["picture",
  FontWeight->"Bold"],
 ", recovered with ",
 Cell[BoxData[
  RowBox[{"qb", "[", "\"\<Picture\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc3d9720-3b6e-4ac7-a43d-25ee6d291ca2"],
 ". The picture records where the time dependence of a system written in this \
basis is kept; it is part of the basis identity but says nothing about the \
basis elements themselves. Built-in pictures are:"
}], "Notes",ExpressionUUID->"e45552d3-c725-4262-8b37-285b155ea9ac"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ce7f0c90-ff85-491c-b3ca-89c93903ab21"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"374d6a5b-36b2-43e4-a14a-ea91ee7b3968"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"2fbe2cc8-f60c-4ad8-a60a-ff5bb3a2c926"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "067a73d0-5749-41e7-a435-aa8f759e2f8e"], Cell[TextData[Cell[
    BoxData["\"\<Schrodinger\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a336f851-0d2f-4e8c-a024-82cc42462802"]], "TableText",ExpressionUUID->
     "971fe0f6-3fe4-49f1-b23f-eb55a12d5765"], Cell["\<\
states carry the time dependence and operators are fixed; the default\
\>", "TableText",ExpressionUUID->"9ddc6df5-3aed-412b-be79-21b4666b16ab"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5057c538-3d60-4b53-bb00-831a25ce030e"], Cell[TextData[Cell[
    BoxData["\"\<Heisenberg\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cc7cabec-ceb5-4666-9933-aa0b9c74afec"]], "TableText",ExpressionUUID->
     "d17fd9f1-c5bf-4b36-86eb-155d0fd11a3e"], Cell[
    "operators carry the time dependence and states are fixed", "TableText",
     ExpressionUUID->"2780d16f-7027-41c7-8289-2c168f806e82"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ec1beddc-30d6-4119-b970-dc55da77330b"], Cell[TextData[Cell[
    BoxData["\"\<Interaction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "79eb0465-1138-4fed-99c1-597b2747dbc3"]], "TableText",ExpressionUUID->
     "b9575c7d-838c-4c1a-9979-27b42665e681"], Cell[
    "the time dependence is divided between states and operators", 
     "TableText",ExpressionUUID->"4b2bbf17-4138-4c9a-9cbd-a6edd863a0c4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6592078a-184a-4c09-b6d2-cc4d0683fb96"], Cell[TextData[Cell[
    BoxData["\"\<PhaseSpace\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "54b6ed1e-87b4-4d3e-b453-0a418147c3e3"]], "TableText",ExpressionUUID->
     "2820c2b8-3745-4e08-b96b-09eb787feba8"], Cell["\<\
the basis is a phase-space frame, so a state expanded in it is a \
quasi-probability distribution rather than an amplitude vector\
\>", "TableText",ExpressionUUID->"e1d64480-ed5b-4d36-b90a-78aada983aa4"]}
  }]], "2ColumnTableMod",ExpressionUUID->"98d5a0b4-19e7-46d6-a7e4-\
31ec21523675"],

Cell[TextData[{
 "A picture may be named positionally, on either side of the basis \
specification, or given as the ",
 Cell[BoxData["\"\<Picture\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "296221f8-feeb-44e7-b25b-57f80a5241cf"],
 " option, and the three forms agree. So ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "\"\<Heisenberg\>\"", "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99b796a7-41fe-4ed5-9239-8411e697c194"],
 " is the default basis in the Heisenberg picture, and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "\"\<Schrodinger\>\"", "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3812d2b0-9bb8-4ca2-afa4-1cb5b90f3eb9"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c1d5204-7de8-449a-923a-2da5e9f193c5"],
 ". A picture may also trail a two-sided specification, as in ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", 
    " ", "\"\<Heisenberg\>\""}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13bc1efa-977c-4ea8-bfa4-cd0451d49193"],
 "."
}], "Notes",ExpressionUUID->"1ba0cebe-fd86-48f0-84ca-f867314c5aa7"],

Cell[TextData[{
 "When more than one picture is written, the one written ",
 StyleBox["first",
  FontWeight->"Bold"],
 " wins, positional and option alike: the arguments are folded in reverse, so \
the earliest is applied last. ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"\"\<Heisenberg\>\"", ",", " ", 
    RowBox[{"\"\<Picture\>\"", " ", "->", " ", "\"\<Interaction\>\""}]}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cfd60e88-dd64-4ebb-b5e0-e5b5f995b4f4"],
 " is in the Heisenberg picture."
}], "Notes",ExpressionUUID->"479ce1e9-eb02-4c36-a16b-6129b4cfa15c"],

Cell[TextData[{
 "A trailing integer is read as a multiplicity rather than a dimension, so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"\"\<Heisenberg\>\"", ",", " ", "3"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d2133bf-7fc8-4584-971e-f2bd4f055fb8"],
 " is three qubits in the Heisenberg picture."
}], "Notes",ExpressionUUID->"2d33883b-e672-4634-8334-d69b442eb105"],

Cell[TextData[{
 "A phase-space basis name sets ",
 Cell[BoxData["\"\<PhaseSpace\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee85b2c6-44fd-4cc9-a9c5-92f252955a14"],
 " on its own, so a picture normally only needs naming for ",
 Cell[BoxData["\"\<Heisenberg\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5ce2346-4720-4937-9526-bbc5ca741eb6"],
 " and ",
 Cell[BoxData["\"\<Interaction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2faa4b3f-d2c6-49d4-9564-a8a1a8c51f08"],
 "."
}], "Notes",ExpressionUUID->"095c2c4f-b431-478b-9d9c-f9412aa5bedb"],

Cell[TextData[{
 "The picture travels with the basis into whatever is built on it, so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumState"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumState", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["spec", "TI"], ",", " ", "\"\<Heisenberg\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78b27b9c-6965-4bcb-a07e-e962d43a24e6"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumOperator"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumOperator", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["spec", "TI"], ",", " ", "\"\<Heisenberg\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea77ea8c-ec74-4d46-8f8a-5309ceb5a950"],
 " both land in the Heisenberg picture."
}], "Notes",ExpressionUUID->"3f6f101f-6340-49f0-8e6b-a1f12f891e55"],

Cell[TextData[{
 "Any picture outside the four above is rejected with a ",
 Cell[BoxData[
  RowBox[{"QuantumBasis", "::", "picture"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
