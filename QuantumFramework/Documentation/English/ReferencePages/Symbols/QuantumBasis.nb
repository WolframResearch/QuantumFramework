      StyleBox["n", "TI"], 
      StyleBox["2", "TR"]], ",", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d2e7bb4-aa30-4e06-aa85-6bf2821f39aa"],
 "\[LineSeparator]",
 "represents a ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], "1"], "\[Times]", 
   SubscriptBox[
    StyleBox["n", "TI"], "2"], "\[Times]", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35e5def7-0caa-4a72-9c5d-07a83e8e496f"],
 " dimensional computational basis of a composite system (many qudits).",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"592be77b-e982-4356-a2b7-3769857b23e3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumBasis", 
