       RowBox[{"Sqrt", "[", 
        RowBox[{"2", "/", "3"}], "]"}]}], "]"}]}], " ", "//", " ", 
    "Simplify"}]}], ";"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"78341b30-bbba-4467-a05b-b76c8de64ea7"],

