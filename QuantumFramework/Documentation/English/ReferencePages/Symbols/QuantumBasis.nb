  FontSize->0.9 Inherited,ExpressionUUID->
  "224dd16a-9afc-48fb-ae98-a937ea2acac6"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"70c48eb0-3aa2-4666-bde7-71224907afc5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumBasis"]], 
