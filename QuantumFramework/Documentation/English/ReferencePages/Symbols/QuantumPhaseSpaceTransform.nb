Cell["\<\
Check that the transformation in the phase space returns the same stat as the \
one in the Hilbert space:\
\>", "ExampleText",ExpressionUUID->"0e8ff682-1add-4f3a-9859-3e021c608d7c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumWeylTransform", "@", "\n", "  ", 
   RowBox[{
    RowBox[{"QuantumPhaseSpaceTransform", "[", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", "\"\<H\>\"", "]"}], ",", 
      " ", "\"\<QBismSIC\>\""}], "]"}], "@", "\n", "   ", 
    RowBox[{"QuantumPhaseSpaceTransform", "[", 
