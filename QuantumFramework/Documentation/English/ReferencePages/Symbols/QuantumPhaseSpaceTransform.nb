Cell["Inverse basis means that the direction of input is flipped:", \
"ExampleText",ExpressionUUID->"6c9fcb16-2243-4c24-b392-6cf982cd1ec2"],

Cell[BoxData[
 InterpretationBox[
  GraphicsBox[
   {EdgeForm[GrayLevel[0]], FaceForm[{GrayLevel[0], Opacity[0]}], 
    GeometricTransformationBox[
     RectangleBox[NCache[{Rational[-1, 2], Rational[-1, 2]}, {-0.5, -0.5}],
      RoundingRadius->{{Left, Top} -> 0.2}], {{{1, 0}, {0, 1}}, {0, 0}}], 
    InsetBox[
     TemplateBox[{
       TagBox["\"H\"", HoldForm], 
       RowBox[{"Diagram", "[", 
         RowBox[{"\"H\"", ",", "a", ",", 
           SuperscriptBox["b", "*"]}], "]"}]},
      "ClickToCopy2"], {0, 0}], 
    {Arrowheads[Small], {ArrowBox[{{0., 0.5}, {0., 0.75}}], InsetBox[
       TemplateBox[{
         InterpretationBox[
          TagBox["a", HoldForm], 
          
          ProcessTheory`Port`Port[<|
           "Expression" :> $CellContext`a, "Type" -> \[FormalCapitalT]|>], 
          Tooltip -> "\[FormalCapitalT]"], 
         RowBox[{"ProcessTheory`Port`Port", "[", "a", "]"}]},
        "ClickToCopy2"], {0., 1.}]}, {ArrowBox[{{0., -0.5}, {0., -0.75}}], 
      InsetBox[
       TemplateBox[{
         InterpretationBox[
          TagBox["b", HoldForm], 
          
          ProcessTheory`Port`Port[<|
           "Expression" :> $CellContext`b, "Type" -> \[FormalCapitalT]|>], 
          Tooltip -> "\[FormalCapitalT]"], 
         RowBox[{"ProcessTheory`Port`Port", "[", "b", "]"}]},
        "ClickToCopy2"], {0., -1.}]}}},
   BaseStyle->{$CellContext`GraphicsHighlightColor -> RGBColor[1, 0, 1]},
   FormatType->StandardForm,
   ImageSize->Tiny],
  $CellContext`Diagram[<|
   "DiagramOptions" -> {}, "Expression" :> "H", "InputPorts" -> {
      ProcessTheory`Port`Port[<|
       "Expression" :> $CellContext`b, "Type" -> \[FormalCapitalT]|>]}, 
    "OutputPorts" -> {
      ProcessTheory`Port`Port[<|
       "Expression" :> $CellContext`a, 
        "Type" -> \[FormalCapitalT]|>]}|>]]], "Output",ExpressionUUID->\
"a28048b9-4ed9-4c6b-9eb1-d72e56a1823f"],

