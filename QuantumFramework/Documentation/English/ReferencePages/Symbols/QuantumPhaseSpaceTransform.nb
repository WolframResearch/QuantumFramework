Cell["\<\
Some elements are negative, implying negative joint probability if one takes \
the transformation more seriously. To turn those negative (quasi) \
probabilities into positive values, one can use inverse basis:\
\>", "ExampleText",ExpressionUUID->"315437e2-37df-4a83-b7f2-c6270a953f76"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"inverseQB", " ", "=", " ", 
   RowBox[{"QuantumBasis", "[", 
    RowBox[{"\"\<QBismSIC\>\"", ",", " ", 
     RowBox[{
      RowBox[{"QuditBasis", "[", "\"\<QBismSIC\>\"", "]"}], 
      "[", "\"\<Inverse\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"QuantumPhaseSpaceTransform", "[", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", "\"\<H\>\"", "]"}], ",", " ", 
    "inverseQB"}], "]"}], "[", "\"\<Table\>\"", "]"}]}], "Input",
 CellTags->"MTNScreenshot",
 CellLabel->"In[2]:= ",ExpressionUUID->"01b62222-8c72-45c0-b782-a76716d555c8"],

