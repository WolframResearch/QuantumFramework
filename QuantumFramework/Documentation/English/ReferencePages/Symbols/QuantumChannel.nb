Cell["\<\
Let us explore the effect of different channels on the Bloch sphere. We shall \
start by defining a normalized pure state\
\>", "ExampleText",
 CellChangeTimes->{{3.7945812070693426`*^9, 3.7945812474508953`*^9}, 
   3.8593317430894012`*^9},
 CellID->1140376088,ExpressionUUID->"92a69dcc-7be8-42c3-b7e4-b1253fdac63f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]i", "=", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<BlochVector\>\"", "[", 
     RowBox[{"FromSphericalCoordinates", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], "]"}], "]"}], 
    "]"}]}], ";"}]], "Input",
 CellID->9361541,ExpressionUUID->"2d2ca22e-75bc-47b3-9b67-c8a1dac1c2c7"],

Cell["Effect of different channels on the Bloch sphere:", "ExampleText",
 CellChangeTimes->{{3.8593317873171597`*^9, 3.859331795856031*^9}},
 CellID->1524490933,ExpressionUUID->"df169011-0cbe-4fee-8122-631c53da17e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", 
  RowBox[{
   RowBox[{"Partition", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"bloch", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"QuantumChannel", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"StringDelete", "[", 
                 RowBox[{"#", ",", "\"\<\\n\>\""}], "]"}], ",", ".35"}], 
               "}"}], "]"}], "[", "\[Psi]i", "]"}], 
            "[", "\"\<BlochCartesianCoordinates\>\"", "]"}]}], "}"}], ",", 
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"QuantumState", "[", "\"\<UniformMixture\>\"", "]"}], "[", 
            RowBox[{"\"\<BlochPlot\>\"", ",", 
             RowBox[{"\"\<ShowLabels\>\"", "->", "False"}]}], "]"}], ",", 
           RowBox[{"ParametricPlot3D", "[", 
            RowBox[{"bloch", ",", 
             RowBox[{"{", 
              RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Phi]", ",", "0", ",", 
               RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
             RowBox[{"PlotRange", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], ",", 
             RowBox[{"PlotStyle", "->", 
              RowBox[{"Opacity", "[", ".5", "]"}]}], ",", 
             RowBox[{"Mesh", "->", "None"}]}], "]"}], ",", 
           RowBox[{"PlotLabel", "->", "#"}]}], "]"}]}], "]"}], "&"}], "/@", 
      RowBox[{"{", 
       RowBox[{"\"\<BitFlip\>\"", ",", "\"\<PhaseFlip\>\"", 
        ",", "\"\<BitPhaseFlip\>\"", ",", "\"\<Depolarizing\>\"", 
        ",", "\"\<AmplitudeDamping\>\"", ",", "\"\<PhaseDamping\>\"", 
        ",", "\"\<ResetError\>\"", 
        ",", "\"\<Generalized\\nAmplitudeDamping\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"UpTo", "[", "3", "]"}]}], "]"}], ",", 
   RowBox[{"ImageSize", "->", "Full"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellID->931785468,ExpressionUUID->"c0e91a21-7b40-48f8-b115-fb28c4888c9e"],

