Cell[CellGroupData[{

Cell["QuantumChannel", "ObjectName",
 CellChangeTimes->{{3.859330646449872*^9, 3.859330649018085*^9}, 
   3.8593309379266243`*^9},
 CellID->322642526,ExpressionUUID->"f85d290b-46a3-46c2-a1b7-4a83e38e451c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c98d5d56-6e35-40a7-9d63-ce9367b1475f"],
 Cell[BoxData[
  RowBox[{"QuantumChannel", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox[
        ButtonBox["B",
         BaseStyle->"Link",
         ButtonData->"paclet:Wolfram/QuantumFramework/ref/B"], "TI"], 
       StyleBox["1", "TR"]], ",", 
      SubscriptBox[
       StyleBox[
        ButtonBox["B",
         BaseStyle->"Link",
         ButtonData->"paclet:Wolfram/QuantumFramework/ref/B"], "TI"], 
       StyleBox["2", "TR"]], ",", "\[Ellipsis]"}], "}"}], ",", 
    StyleBox["order", "TI"], ",", 
    StyleBox["basis", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7bd1e7e3-db41-4a6f-b581-0724d0781fd1"],
 " \[LineSeparator]represents a quantum channel with Kraus operators ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["B", "TI"], "i"]], "InlineFormula",ExpressionUUID->
  "6ded9e1b-4089-4443-8067-24c00d123e6a"],
 ", in  ",
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",ExpressionUUID->
  "b4bd2dbd-7689-4530-b764-aeb8ac7dc8f5"],
 ", to be applied onto the qubits indexed in ",
 Cell[BoxData[
  StyleBox["order", "TI"]], "InlineFormula",ExpressionUUID->
  "0d2531ee-1658-4ad2-89e2-1187a87a95bc"],
 ".\n",
 Cell["      ", "ModInfo",ExpressionUUID->
  "b1e36568-5148-42c2-9bd8-d2b85866ea32"],
 Cell[BoxData[
  RowBox[{"QuantumChannel", "[", 
   StyleBox[
    RowBox[{
     RowBox[{"name", "[", "params", "]"}], ",", "..."}], "TI"], "]"}]], 
  "InlineFormula",ExpressionUUID->"6673767e-e63e-4b34-9274-2f6e834fe978"],
 "\[LineSeparator]represents a the named quantum channel with ",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",ExpressionUUID->
  "ff36e941-0712-431b-b318-dd0875e056da"],
 ", and potential parameters specified by ",
 Cell[BoxData[
  StyleBox["params", "TI"]], "InlineFormula",ExpressionUUID->
  "a163fc4a-3746-47a9-9099-ec936bfaef02"],
 "."
}], "Usage",
 CellChangeTimes->{{3.858969213096569*^9, 3.858969262806422*^9}, {
   3.859330670219985*^9, 3.8593307099400883`*^9}, {3.859330943141594*^9, 
   3.859330943141634*^9}, 3.859331088549025*^9, {3.925409156281448*^9, 
   3.925409192986207*^9}, {3.9254093879531384`*^9, 3.9254093983744*^9}, {
   3.925410486302616*^9, 3.9254105471002827`*^9}},
 CellID->14939724,ExpressionUUID->"cb0c1d31-beb9-4309-9ccf-9e0a1de3bfad"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"QuantumChannel", "[", 
   StyleBox["\[Ellipsis]", "TR"], "]"}]], "InlineFormula",ExpressionUUID->
  "d8c64a0c-7afd-44d8-be60-d3e7510c7041"],
 " describes a transformation of a density matrix \[Rho] into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sum]", "k"], 
    RowBox[{
     SubscriptBox["B", "k"], "\[Rho]", " ", 
     SubsuperscriptBox["B", "k", "\[ConjugateTranspose]"]}]}], 
   TraditionalForm]],ExpressionUUID->"5298db37-d0e8-4ba4-8c3d-8250265772e4"],
 ". In our framework, it is define by specifying the operators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "k"], TraditionalForm]],ExpressionUUID->
  "92f30349-5d37-42b2-b9e8-4c56b51f8980"],
 " with the function QuantumChannel. The transformation due to a channel can \
be trace preserving (i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Sum]", "k"], 
     RowBox[{
      SubsuperscriptBox["B", "k", "\[ConjugateTranspose]"], 
      SubscriptBox["B", "k"]}]}], "=", "I"}], TraditionalForm]],
  ExpressionUUID->"2edc43c1-e234-4903-bc31-985c565c0fd0"],
 ") or not."
}], "Notes",
 CellChangeTimes->{{3.856111372969252*^9, 3.8561114332824574`*^9}, {
  3.856111466022993*^9, 3.856111519907502*^9}, {3.856111551072344*^9, 
  3.856111604462084*^9}, {3.856731724005067*^9, 3.856731732796025*^9}, {
  3.8593315138270893`*^9, 3.85933151571295*^9}, {3.889696915249704*^9, 
  3.8896969452756166`*^9}, {3.9960775340884743`*^9, 3.996077535923958*^9}},
 CellID->522186077,ExpressionUUID->"d30a31c3-4bfb-41ee-8fdc-7ab52ee8ed29"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",ExpressionUUID->
  "99e7587c-3d1e-4c32-a74a-82eaa44680f4"],
 " isn't specified, the default is taken to be the computational basis."
}], "Notes",
 CellChangeTimes->{
  3.859331106538005*^9, {3.925410559100217*^9, 3.925410561458192*^9}},
 CellID->1573756927,ExpressionUUID->"636f6c58-332d-4185-a91a-bf6b25a2a47c"],

Cell["\<\
When the order order isn't specified, the default is taken to be the range of \
the arity of the operators.\
\>", "Notes",
 CellChangeTimes->{3.859331111781591*^9},
 CellID->1724075637,ExpressionUUID->"4d43f30a-8bfb-4444-98c3-a137be1d48d9"],

Cell["The following named operators are supported:", "Notes",
 CellID->189500052,ExpressionUUID->"87086554-6d49-4fef-9ba6-711005ac5982"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2988ad1d-5174-4b41-8f2d-439d0f6802bc"], 
    RowBox[{"\"\<BitFlip\>\"", "[", 
     StyleBox["p", "TI"], "]"}], Cell[TextData[{
     "the bit flip channel with probability ",
     Cell[BoxData[
      StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
      "91589a28-038e-45c1-a0d0-3e0ec7c496c7"]
    }], "TableText",ExpressionUUID->"2745aecf-8fb5-41d5-80da-4217f58d97a6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "14003b64-c3b1-4606-963b-e4cdafccd714"], 
    RowBox[{"\"\<PhaseFlip\>\"", "[", 
     StyleBox["p", "TI"], "]"}], Cell[TextData[{
     "the phase flip channel with probability ",
     Cell[BoxData[
      StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
      "f97689f0-df46-4293-807d-20cea2d1f29b"]
    }], "TableText",ExpressionUUID->"93e395d0-8e47-421d-b104-de360c7622c6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c2bea61a-d195-4533-905a-0fb9599f4e31"], 
    RowBox[{"\"\<BitPhaseFlip\>\"", "[", 
     StyleBox["p", "TI"], "]"}], Cell[TextData[{
     "the bit phase flip channel with probability ",
     Cell[BoxData[
      StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
      "a444cbb3-25ef-4b99-9a63-deb5b7f5e48a"]
    }], "TableText",ExpressionUUID->"c6148ed8-616d-4235-a2c8-c1da47140839"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8489d647-fe1d-47f2-9aea-eaabc1a24bbe"], 
    RowBox[{"\"\<Depolarizing\>\"", "[", 
     StyleBox["p", "TI"], "]"}], Cell[TextData[{
     "the depolarizing channel with probability ",
     Cell[BoxData[
      StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
      "5d611cc0-00e5-4fcb-ab3b-7de43767c182"]
    }], "TableText",ExpressionUUID->"524c57bc-0fcb-4f16-b5a6-a3a2ff6802a3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c79c0beb-21dd-41ce-8e8a-86b2568f5225"], 
    RowBox[{"\"\<AmplitudeDamping\>\"", "[", 
     StyleBox["\[Gamma]", "TI"], "]"}], Cell[TextData[{
     "the amplitude damping channel with decay ",
     Cell[BoxData[
      StyleBox["\[Gamma]", "TI"]], "InlineFormula",ExpressionUUID->
      "ba928255-0db8-4800-a2f3-8ad4a866f8df"]
    }], "TableText",ExpressionUUID->"4b8901aa-b021-47ed-8d52-3c8ddfd52a65"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "53d204bd-4613-4b42-a314-812496b36a1c"], 
    RowBox[{"\"\<GeneralizedAmplitudeDamping\>\"", "[", 
     RowBox[{
      StyleBox["\[Gamma]", "TI"], ",", 
      StyleBox["p", "TI"]}], "]"}], Cell[TextData[{
     "the generalized amplitude damping channel, with decay ",
     Cell[BoxData[
      StyleBox["\[Gamma]", "TI"]], "InlineFormula",ExpressionUUID->
      "ec7c5f3e-97b3-4653-858b-fd882aa861c1"],
     " and probability ",
     Cell[BoxData[
      StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
      "8035d118-38c9-4114-b69c-282691114ea3"]
    }], "TableText",ExpressionUUID->"92e2991d-31e2-43df-a456-9ffd3127f60d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ffd226d3-6c03-4237-af3d-77f36fb7bb7e"], 
    RowBox[{"\"\<PhaseDamping\>\"", "[", 
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["]", "TI"]}], Cell[
    "the Phase damping channel with decay \[Lambda]", "TableText",
     ExpressionUUID->"8daeb4e6-cdbe-454c-a40c-528af67dcaf2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cf6ff71f-c7b4-4131-890e-1990f0bd77e0"], 
    RowBox[{"\"\<ResetError\>\"", "[", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["0", "TR"]], ",", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]]}], "]"}], Cell[TextData[{
     "the reset error channel, with probability ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["0", "TR"]]], "InlineFormula",ExpressionUUID->
      "c8baff65-626d-4776-9984-7753bdaad232"],
     " for |0\[RightAngleBracket] state and ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]]], "InlineFormula",ExpressionUUID->
      "ef57ff9a-ad28-40f5-89ac-772584f9bb33"],
     " for |1\[RightAngleBracket]"
    }], "TableText",ExpressionUUID->"67868c3a-c53b-43b3-b289-8346393a1853"]}
  }]], "2ColumnTableMod",
 CellChangeTimes->{{3.858967619443546*^9, 3.858967994593912*^9}, {
  3.859331164392575*^9, 3.859331412170659*^9}, {3.889699828776596*^9, 
  3.889699829065022*^9}, {3.889699930228571*^9, 3.889699969297139*^9}, {
  3.889700198636417*^9, 3.88970021204999*^9}, {3.889700609940556*^9, 
  3.889700615556405*^9}, {3.890938435044691*^9, 3.890938537723618*^9}, {
  3.9209982633132567`*^9, 3.920998285557257*^9}, {3.925409413423377*^9, 
  3.925409423149951*^9}, {3.9254104984737883`*^9, 3.92541050677883*^9}, {
  3.9254105675884132`*^9, 3.92541060381078*^9}},
 CellID->218016135,ExpressionUUID->"840102da-7c41-4f8b-9eeb-f486947170f7"],

Cell["The following properties specific to channels are supported:", "Notes",
 CellChangeTimes->{{3.9960796890798187`*^9, 3.9960796986562138`*^9}},
 CellID->57633297,ExpressionUUID->"9121ac23-fb35-e542-87bc-3b3916f3e47e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "829428dd-4e5d-c041-9967-03a0f3e90b5e"], Cell[
    "\"TracePreservingQ\"", "TableText",ExpressionUUID->
     "fa8c9000-06be-d54d-9344-104d6fc3e46e"], Cell[TextData[{
     "tests if the channel preserves the trace of any state ",
     Cell[BoxData[
      FormBox[
       RowBox[{
        RowBox[{
         UnderscriptBox[
          RowBox[{" ", "\[Sum]"}], 
          StyleBox[
           RowBox[{" ", "k"}], "TI"],
          LimitsPositioning->True], 
         RowBox[{
          SubsuperscriptBox[
           StyleBox["B", "TI"], 
           StyleBox["k", "TI"], "\[Dagger]"], 
          SubscriptBox[
           StyleBox["B", "TI"], 
           StyleBox["k", "TI"]]}]}], "\[LongEqual]", 
        StyleBox["I", "TI"]}], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c4498cc4-983f-3445-ac14-e2abf899e0ab"]
    }], "TableText",ExpressionUUID->"5b0bb7a6-1e2a-f24b-92d8-4bf0afd9040d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "71c717fa-77db-904a-ab5e-e57a57032e72"], Cell[
    "\"UnitalQ\"", "TableText",ExpressionUUID->
     "ac48c6ff-6dc2-694f-986e-9782e42556cd"], Cell[TextData[{
     "tests if the channel fixes the identity  ",
     Cell[BoxData[
      FormBox[
       RowBox[{" ", 
        RowBox[{
         RowBox[{"\[ScriptCapitalN]", "(", "I", ")"}], "=", "I"}]}], 
       TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "48dcf82b-9bcb-d14e-89de-94df2335e4e1"]
    }], "TableText",ExpressionUUID->"db7c306e-bfeb-c64d-b7fd-d704a4f8de44"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c1c70a27-9331-9844-bd45-9bd52d81e3b5"], Cell[
    "\"Unitality\"", "TableText",ExpressionUUID->
     "0987a48f-ce4e-de40-bd39-24a4c0737de2"], Cell[TextData[{
     "gives the operator ",
     Cell[BoxData[
      FormBox[
       RowBox[{" ", 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          StyleBox[
           RowBox[{" ", "k"}], "TI"],
          LimitsPositioning->True], 
         RowBox[{
          SubscriptBox[
           StyleBox["B", "TI"], 
           StyleBox["k", "TI"]], 
          SuperscriptBox[
           SubscriptBox[
            StyleBox["B", "TI"], 
            StyleBox["k", "TI"]], "\[Dagger]"]}]}]}], TraditionalForm]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "be023932-1883-4043-a95e-1b996e1f0127"]
    }], "TableText",ExpressionUUID->"eefa748a-5279-e844-aa2f-a07e60265f92"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "18c9505e-1f7d-224e-b1ca-9bfc3562cbaf"], Cell[
    "\"Operator\"", "TableText",ExpressionUUID->
     "4907434a-4b3c-1543-b6c3-d7358a418093"], Cell["\<\
returns the operator with extra qudits according to Stinespring dilation\
\>", "TableText",ExpressionUUID->"195861c5-4ced-534c-a4bd-d2389fbac44e"]}
  }]], "2ColumnTableMod",
 CellChangeTimes->{{3.996079642117378*^9, 3.9960796484684925`*^9}, {
  3.9960797351484547`*^9, 3.996079769718525*^9}, {3.9960798321297836`*^9, 
  3.996079921614441*^9}, {3.9960800352563744`*^9, 3.996080205453615*^9}, {
  3.99608023818347*^9, 3.9960802577937527`*^9}, {3.996080314586685*^9, 
  3.996080337514168*^9}, {3.996080399154728*^9, 3.9960804559755745`*^9}, {
  3.9960807570715656`*^9, 3.996080786474119*^9}, {3.9960808701902294`*^9, 
  3.9960809214205093`*^9}, {3.996081027561306*^9, 3.996081090734087*^9}},
 CellID->28138070,ExpressionUUID->"fe540ac1-f552-fd40-9f10-b7776e90378a"],

Cell["\<\
Equivalent description of the channels in terms of the Kraus operators that \
builds them:\
\>", "Notes",
 CellChangeTimes->{{3.9960796890798187`*^9, 3.9960796986562138`*^9}, {
  3.996082246039011*^9, 3.996082284434244*^9}},
 CellID->412360193,ExpressionUUID->"9a143da5-297e-bd49-a5b5-ad496b2521e9"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "df378425-7f2f-0c47-90f3-24dd6884fa6c"], 
    RowBox[{"\"\<BitFlip\>\"", "[", 
     StyleBox["p", "TI"], "]"}], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SqrtBox[
        StyleBox["p", "TI"]], "\"\<X\>\""}], ",", 
      RowBox[{
       SqrtBox[
        RowBox[{"1", "-", 
         StyleBox["p", "TI"]}]], "\"\<I\>\""}]}], "}"}], Cell["\<\
The bit-flip channel represents  bit-flip operation with probability p and \
remains unchanged with probability 1 - p.\
\>", "TableText",ExpressionUUID->"055f16d0-4aed-7140-9390-96c6d667ef1b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "10c2ce0d-50e6-e248-bbb6-493df7e9bcd5"], 
    RowBox[{"\"\<PhaseFlip\>\"", "[", 
     StyleBox["p", "TI"], "]"}], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SqrtBox[
        StyleBox["p", "TI"]], "\"\<Z\>\""}], ",", 
      RowBox[{
       SqrtBox[
        RowBox[{"1", "-", 
         StyleBox["p", "TI"]}]], "\"\<I\>\""}]}], "}"}], Cell["\<\
The phase-flip channel is represents a qubit undergoes a phase-flip operation \
with probability p and remains unchanged with probability 1 - p\
\>", "TableText",ExpressionUUID->"b7fc444b-5673-f344-95ca-6b20194d1af8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8261af3b-2825-fa43-b18d-332e8400e781"], 
    RowBox[{"\"\<BitPhaseFlip\>\"", "[", 
     StyleBox["p", "TI"], "]"}], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SqrtBox[
        StyleBox["p", "TI"]], "\"\<Y\>\""}], ",", 
      RowBox[{
       SqrtBox[
        RowBox[{"1", "-", 
         StyleBox["p", "TI"]}]], "\"\<I\>\""}]}], "}"}], Cell["\<\
The bit-phase-flip channel represents a qubit undergoes a combined bit and \
phase-flip operation with probability p and remains unchanged with \
probability 1 - p.\
\>", "TableText",ExpressionUUID->"1647d755-4fd3-1143-b7e4-d92e28fc5863"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "560519e1-6237-1b44-8179-2eb99881ca66"], 
    RowBox[{"\"\<Depolarizing\>\"", "[", 
     StyleBox["p", "TI"], "]"}], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SqrtBox[
        RowBox[{
         StyleBox["p", "TI"], "/", "4"}]], "\"\<X\>\""}], ",", 
      RowBox[{
       SqrtBox[
        RowBox[{
         StyleBox["p", "TI"], "/", "4"}]], "\"\<Y\>\""}], ",", 
      RowBox[{
       SqrtBox[
        RowBox[{
         StyleBox["p", "TI"], "/", "4"}]], "\"\<Z\>\""}], ",", 
      RowBox[{
       SqrtBox[
        RowBox[{"1", "-", 
         RowBox[{"3", 
          RowBox[{
           StyleBox["p", "TI"], "/", "4"}]}]}]], "\"\<I\>\""}]}], "}"}], 
    Cell["\<\
The depolarizing channel represents a qubit undergoes a random Pauli \
operation (X, Y, or Z) with equal probability p/4 or remains unchanged with \
probability 1 - 3p/4.\
\>", "TableText",ExpressionUUID->"e72b6fee-fb6d-7c41-b9c2-e93c5c14db13"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d915e15f-0352-014f-9300-b16f50166453"], 
    RowBox[{"\"\<AmplitudeDamping\>\"", "[", 
     StyleBox["\[Gamma]", "TI"], "]"}], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          SqrtBox[
           RowBox[{"1", "-", "\[Gamma]"}]]}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", 
          SqrtBox["\[Gamma]"]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], "}"}], Cell["\<\
The amplitude damping channel models the energy relaxation of a qubit, where \
\[Gamma] is the damping rate.\
\>", "TableText",ExpressionUUID->"1a768aeb-1e40-b94e-bef2-245f513aecf4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7d386ab3-d9a7-2149-837e-4ab67218d8fe"], 
    RowBox[{"\"\<GeneralizedAmplitudeDamping\>\"", "[", 
     RowBox[{
      StyleBox["\[Gamma]", "TI"], ",", 
      StyleBox["p", "TI"]}], "]"}], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SqrtBox["p"], 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           SqrtBox[
            RowBox[{"1", "-", "\[Gamma]"}]]}], "}"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       SqrtBox["p"], " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           SqrtBox["\[Gamma]"]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], ",", 
      RowBox[{
       SqrtBox[
        RowBox[{"1", "-", "p"}]], " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SqrtBox[
            RowBox[{"1", "-", "\[Gamma]"}]], ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
      RowBox[{
       SqrtBox[
        RowBox[{"1", "-", "p"}]], " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           SqrtBox["\[Gamma]"], ",", "0"}], "}"}]}], "}"}]}]}], "}"}], 
    Cell["\<\
The generalized amplitude damping  models the energy relaxation of a qubit in \
the presence of a thermal environment, where p is the probability of the \
qubit being excited and \[Gamma] is the damping rate.\
\>", "TableText",ExpressionUUID->"888e6267-8539-a74a-940a-748474eae79e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0e3ac051-d6ce-af43-b966-ba46cca0e52a"], 
    RowBox[{"\"\<PhaseDamping\>\"", "[", 
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["]", "TI"]}], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          SqrtBox[
           RowBox[{"1", "-", "\[Lambda]"}]]}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          SqrtBox["\[Lambda]"]}], "}"}]}], "}"}]}], "}"}], Cell["\<\
The phase damping channel models the dephasing of a qubit, where \[Lambda] is \
the dephasing rate.\
\>", "TableText",ExpressionUUID->"ec9f972f-09f0-1f40-b0c4-51131563e11e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9e69cbb7-72c0-a54b-a6e5-4704ab677965"], 
    RowBox[{"\"\<ResetError\>\"", "[", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["0", "TR"]], ",", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]]}], "]"}], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SqrtBox[
        RowBox[{"1", "-", 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["0", "TR"]], "-", 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["1", "TR"]]}]], " ", "\"\<I\>\""}], ",", 
      RowBox[{
       SqrtBox[
        SubscriptBox[
         StyleBox["p", "TI"], 
         StyleBox["0", "TR"]]], 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], ",", 
      RowBox[{
       SqrtBox[
        SubscriptBox[
         StyleBox["p", "TI"], 
         StyleBox["0", "TR"]]], 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], ",", 
      RowBox[{
       SqrtBox[
        SubscriptBox[
         StyleBox["p", "TI"], "1"]], 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ",", 
      RowBox[{
       SqrtBox[
        SubscriptBox[
         StyleBox["p", "TI"], 
         StyleBox["1", "TR"]]], 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}]}], "}"}], Cell[TextData[{
     "\nThe reset error channel describes with ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["0", "TR"]]], "InlineFormula",ExpressionUUID->
      "d9ecf88d-8fc8-2d48-b5f6-0ba57bf66431"],
     " the probability for reset error of |0\[RightAngleBracket] and ",
     Cell[BoxData[
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]]], "InlineFormula",ExpressionUUID->
      "cb99e95d-4e30-d849-a840-a236c19765db"],
     " of |1\[RightAngleBracket]"
    }], "TableText",ExpressionUUID->"4ba3fefd-dec1-3042-b9d1-3987bdc4ac28"]}
  }]], "3ColumnTableMod",
 CellChangeTimes->{{3.996083481393999*^9, 3.9960835005879784`*^9}, {
