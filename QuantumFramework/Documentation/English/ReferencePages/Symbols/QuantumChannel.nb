Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumChannel", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], "}"}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}], "]"}], " ", "==",
   " ", 
  RowBox[{"QuantumChannel", "[", 
   RowBox[{"\"\<AmplitudeDamping\>\"", "[", 
    RowBox[{"1", "/", "4"}], "]"}], "]"}]}]], "Input",
