Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixForm", "/@", 
  RowBox[{
   RowBox[{"QuantumChannel", "[", 
    RowBox[{"\"\<Depolarizing\>\"", "[", "p", "]"}], "]"}], 
   "[", "\"\<Tensor\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.996077790598755*^9, 3.996077811536585*^9}},
 CellLabel->"In[2]:=",
