Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "d30e6dc3-8c27-4e67-bde1-bfa0c902dcdc"],
  $Line = 0; Null]], "ExampleSection",
 CellID->277971883,ExpressionUUID->"7ea1c2b8-f4dd-4591-98de-37d6250e9585"],

Cell["\<\
Amplitude damping is trace preserving but not unital, since it has a \
preferred state to decay into:\
\>", "ExampleText",
 CellChangeTimes->{3.9960786997879124`*^9},
 CellID->414514,ExpressionUUID->"8d11a22b-62ba-244a-b6c8-cd6c1c664a67"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumChannel", "[", 
   RowBox[{"\"\<AmplitudeDamping\>\"", "[", "0.3", "]"}], "]"}], "/@", 
  RowBox[{"{", 
   RowBox[{"\"\<TracePreservingQ\>\"", ",", "\"\<UnitalQ\>\""}], 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.9960786041605625`*^9, 3.9960786232967052`*^9}, {
  3.996078653979767*^9, 3.9960786827375565`*^9}},
 CellLabel->"In[7]:=",
 CellID->181477821,ExpressionUUID->"c5ce988c-f318-bf47-b56a-e2f71cd45185"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellChangeTimes->{
  3.9960786237329464`*^9, {3.996078660707306*^9, 3.9960786829675484`*^9}},
 CellLabel->"Out[7]=",
 CellID->51680465,ExpressionUUID->"9afd8f24-170b-b348-b76f-0ecac88ea828"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "e3cfe170-dd84-8845-a80a-48a4e54f7524"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->71206309,ExpressionUUID->"ead9cfe0-b781-4243-9137-b864e5cbaea7"],

Cell["\<\
The depolarizing channel is both, because mixing with the identity leaves the \
identity alone:\
\>", "ExampleText",
 CellChangeTimes->{3.996078773078907*^9},
 CellID->8651068,ExpressionUUID->"b3b79f8b-eab6-ab4f-a742-5ab6801094d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumChannel", "[", 
   RowBox[{"\"\<Depolarizing\>\"", "[", "0.5", "]"}], " ", "]"}], "/@", 
  RowBox[{"{", 
   RowBox[{"\"\<TracePreservingQ\>\"", ",", "\"\<UnitalQ\>\""}], 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.9960787470233784`*^9, 3.996078765028345*^9}},
 CellLabel->"In[1]:=",
 CellID->160972462,ExpressionUUID->"39190e93-8d17-f340-a44d-cdcee306317b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.99607876620837*^9},
 CellLabel->"Out[1]=",
 CellID->381819234,ExpressionUUID->"cddd3745-f9e0-fe42-a9bb-b2a9566a7a3d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "a39df1e7-03da-f240-9038-eabd480dfe7b"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->416859287,ExpressionUUID->"44f925f4-6fb7-e940-b6f8-432e41a4542f"],

Cell["\<\
Tracing out the Kraus qudit discards the environment and recovers the channel:\
\>", "ExampleText",
 CellChangeTimes->{3.996081239749796*^9},
 CellID->854943811,ExpressionUUID->"32d7d72a-b445-1b40-bcfc-57d637faa7a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ch", "=", 
      RowBox[{"QuantumChannel", "[", 
       RowBox[{"\"\<BitPhaseFlip\>\"", "[", 
        RowBox[{"1", "/", "2"}], "]"}], "]"}]}], ",", 
     RowBox[{"psi", "=", 
      RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"QuantumPartialTrace", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ch", "[", "\"\<Operator\>\"", "]"}], "[", "psi", "]"}], ",", 
      RowBox[{"{", "1", "}"}]}], "]"}], "==", 
    RowBox[{"ch", "[", "psi", "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9960811994275684`*^9, 3.996081209737465*^9}},
 CellLabel->"In[9]:=",
 CellID->140379825,ExpressionUUID->"4af238c4-1bca-934f-8547-61020e60e296"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.996081206708685*^9, 3.9960812103680897`*^9}},
 CellLabel->"Out[9]=",
 CellID->240692301,ExpressionUUID->"03def904-e045-9840-b848-05b31ca2e8c1"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

