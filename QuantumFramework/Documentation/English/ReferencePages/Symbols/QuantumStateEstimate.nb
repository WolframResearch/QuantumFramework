Cell["\<\
Generate a random mixed state and define the measurement operators:\
\>", "ExampleText",
 CellChangeTimes->{{3.996337425456808*^9, 3.9963374300910892`*^9}, {
  3.996337519687025*^9, 3.9963375268201447`*^9}},
 CellID->670472674,ExpressionUUID->"ce31e0ce-323b-a047-aa7b-14287a0c863e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"truth", "=", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<RandomMixed\>\"", "[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ops", "=", 
   RowBox[{"QuantumMeasurementOperator", "/@", 
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}], ",", 
      "2"}], "]"}]}]}], ";"}]}], "Input",
