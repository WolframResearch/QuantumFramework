Cell[BoxData[
 RowBox[{
  RowBox[{"truth", "=", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<BlochVector\>\"", "[", 
     RowBox[{"{", 
      RowBox[{"0.1", ",", "0.15", ",", "0.7"}], "}"}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996336050026018*^9, 3.9963360511223717`*^9}, 
   3.996336118144535*^9, 3.996336186100418*^9},
 CellLabel->"In[6]:=",
