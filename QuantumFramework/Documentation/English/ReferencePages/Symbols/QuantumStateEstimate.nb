Cell["Define the measurement operators:", "ExampleText",
 CellChangeTimes->{{3.996336195496563*^9, 3.996336200771921*^9}},
 CellID->109497071,ExpressionUUID->"82985bce-6084-1b40-bf86-ab15b5e95669"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ops", "=", 
   RowBox[{"QuantumMeasurementOperator", "/@", 
    RowBox[{"{", 
     RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996336050026018*^9, 3.9963360511223717`*^9}, 
   3.996336118144535*^9, {3.996336186100418*^9, 3.9963362039001465`*^9}},
 CellLabel->"In[7]:=",
 CellID->773021050,ExpressionUUID->"57f62ec6-3ba9-1743-a724-af904b6c6004"],

Cell["\<\
Estimate the state sampled by the \"BayesianSampler\", the standard deviation \
of each Bloch coordinate for the samples, and the fidelity of the maximum \
likelihood state, while varying the number of measurement counts:\
\>", "ExampleText",
 CellChangeTimes->{{3.996336215790472*^9, 3.9963363281919975`*^9}, 
   3.996336471177828*^9, {3.996336503464405*^9, 3.996336518655752*^9}},
 CellID->74943903,ExpressionUUID->"3a9763af-8384-df4f-974f-a150706e2abd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"est", "=", 
        RowBox[{"QuantumStateEstimate", "[", 
         RowBox[{"QuantumMeasurementSimulation", "[", 
          RowBox[{"truth", ",", "ops", ",", "n"}], "]"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "\[IndentingNewLine]", 
        RowBox[{"StandardDeviation", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#1", "[", "\"\<BlochCartesianCoordinates\>\"", "]"}], 
            "&"}], ")"}], "/@", 
          RowBox[{
           RowBox[{"est", "[", "\"\<BayesianSampler\>\"", "]"}], "[", 
           RowBox[{"200", ",", 
            RowBox[{"\"\<Burn\>\"", "\[Rule]", "50"}]}], "]"}]}], "]"}], ",", 
        
        RowBox[{"QuantumSimilarity", "[", 
         RowBox[{"truth", ",", 
          RowBox[{"est", "[", "\"\<MaximumLikelihoodState\>\"", "]"}]}], 
         "]"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", 
      RowBox[{"{", 
       RowBox[{"20", ",", "100", ",", "1000", ",", "10000"}], "}"}]}], 
     "}"}]}], "]"}], "//", "Column"}]], "Input",
 CellChangeTimes->{{3.996336050026018*^9, 3.9963360511223717`*^9}, 
   3.996336118144535*^9, {3.996336186100418*^9, 3.9963362039001465`*^9}, {
   3.996336522737726*^9, 3.996336524424923*^9}, {3.996336570730177*^9, 
   3.9963365850631256`*^9}},
 CellLabel->"In[8]:=",
