Cell["\<\
Find its concurrence vector across the first subsystem and the rest:\
\>", "ExampleText",
 CellID->52970081,ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"cv", " ", "=", " ", 
  RowBox[{"QuantumEntanglementMonotone", "[", 
   RowBox[{"st", ",", " ", "\"\<ConcurrenceVector\>\""}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->1545719872,ExpressionUUID->"6b853673-18d0-d9fa-19ba-a83d996aabc0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.2546817733603802`", ",", "0.34167700469615936`", ",", 
   "0.21441553905696453`", ",", "0.22177427695422322`", ",", 
   "0.39232684531066486`", ",", "0.3811920626200058`", ",", 
   "0.04834384048737212`", ",", "0.07666615266469001`", ",", 
   "0.2439339990135533`", ",", "0.02699142777110611`", ",", 
   "0.22290713050311986`", ",", "0.21730423802043466`", ",", 
   "0.06090302726371273`", ",", "0.10122708105307872`", ",", 
