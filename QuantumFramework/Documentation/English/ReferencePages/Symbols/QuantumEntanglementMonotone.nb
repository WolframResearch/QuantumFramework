Cell["The concurrence is defined for a mixed state:", "ExampleText",
 CellID->1555662820,ExpressionUUID->"27d2a24c-1e84-19ee-4de1-44169b316b34"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumEntanglementMonotone", "[", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"\"\<RandomMixed\>\"", "[", "2", "]"}], "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->1852680185,ExpressionUUID->"285985c7-a1c8-13eb-5866-1ca0d07d6131"],

Cell[BoxData["0.07941718015273924`"], "Output",
 CellLabel->"Out[1]= ",
 CellID->494381976,ExpressionUUID->"57868ed1-450c-c474-7dbd-279b6cbeaf5e"]
}, Open  ]],

Cell[TextData[{
 "The entanglement entropy is not defined for a mixed state: on a genuinely \
mixed input, ",
 Cell[BoxData["\"\<EntanglementEntropy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c5e608e-35dc-f74f-3466-79e8bc6edd95"],
 " returns ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1a1e4090-3303-05ed-4a26-59da46b66f37"],
 " and issues a ",
 Cell[BoxData[
  RowBox[{"QuantumEntanglementMonotone", "::", "mixedentropy"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10256af3-3972-af7a-41da-83bdb804f240"],
 " message, since the reduced entropy of a mixed state measures classical \
mixing rather than entanglement:"
}], "ExampleText",
 CellID->1932788388,ExpressionUUID->"457602f1-d86e-ac86-730d-9bbad918f6ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumEntanglementMonotone", "[", 
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<UniformMixture\>\"", "[", "2", "]"}], "]"}], ",", 
   " ", "\"\<EntanglementEntropy\>\""}], "]"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->1012894407,ExpressionUUID->"499f95c1-a958-6c18-7fa4-0caac8ed3762"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"QuantumEntanglementMonotone", "::", "mixedentropy"}], 
   "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{
   RowBox[{
    RowBox[{
    "The", " ", "entanglement", " ", "entropy", " ", "of", " ", "a", " ", 
     "subsystem", " ", "measures", " ", "entanglement", " ", "only", " ", 
     "for", " ", "a", " ", "pure", " ", "state"}], ";", " ", 
    RowBox[{
    "the", " ", "reduced", " ", "von", " ", "Neumann", " ", "or", " ", 
     "Renyi", " ", "entropy", " ", "of", " ", "a", " ", "mixed", " ", "state",
      " ", "is", " ", "not", " ", "an", " ", "entanglement", " ", 
     RowBox[{"measure", ".", " ", "Use"}], " ", "Negativity"}]}], ",", " ", 
   "LogNegativity", ",", " ", 
   RowBox[{
   "or", " ", "Concurrence", " ", "for", " ", "a", " ", "mixed", " ", 
    RowBox[{"state", "."}]}]}]}]], "Message", "MSG",
 CellID->40139268,ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

Cell[BoxData["Indeterminate"], "Output",
 CellLabel->"Out[2]= ",
 CellID->302691079,ExpressionUUID->"0c02104f-9807-e6c4-3431-8a2919b3cc2e"]
}, Open  ]],

