Cell[TextData[{
 "Plot several entanglement monotones for the state ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Beta]", "TI"], 
    TemplateBox[{"00"},
     "Ket"]}], "+", 
   RowBox[{
    SqrtBox[
     RowBox[{"1", "-", 
      SuperscriptBox[
       StyleBox["\[Beta]", "TI"], "2"]}]], 
    TemplateBox[{"11"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "045023ab-c37d-b770-2c6f-baf4f6091a5a"],
 ":"
}], "ExampleText",
 CellID->1989380596,ExpressionUUID->"73e8aeff-5b91-f8f4-2197-47b95e25cade"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"betaConc", "[", 
    RowBox[{"b_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"QuantumEntanglementMonotone", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"{", 
       RowBox[{"b", ",", " ", "0", ",", " ", "0", ",", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"b", "^", "2"}]}], "]"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "}"}], ",", " ", "\"\<Concurrence\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"betaLogNeg", "[", 
    RowBox[{"b_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"QuantumEntanglementMonotone", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"{", 
       RowBox[{"b", ",", " ", "0", ",", " ", "0", ",", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"b", "^", "2"}]}], "]"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "}"}], ",", " ", "\"\<LogNegativity\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"betaEntEntropy", "[", 
    RowBox[{"b_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"QuantumEntanglementMonotone", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"{", 
       RowBox[{"b", ",", " ", "0", ",", " ", "0", ",", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"b", "^", "2"}]}], "]"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "}"}], ",", 
     " ", "\"\<EntanglementEntropy\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"betaConc", "[", "b", "]"}], ",", " ", 
     RowBox[{"betaLogNeg", "[", "b", "]"}], ",", " ", 
