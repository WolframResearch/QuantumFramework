Cell["Its total correlation is one bit of mutual information:", "ExampleText",
 CellID->1243596203,ExpressionUUID->"3fdc991b-fead-14b0-65e3-1144fb587e9a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumEntanglementMonotone", "[", 
  RowBox[{"classical", ",", " ", "\"\<MutualInformationI\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->1029628243,ExpressionUUID->"3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],

Cell[BoxData[
 TemplateBox[{"1", "\"b\"", "bit", "\"Bits\""},
  "Quantity"]], "Output",
 CellLabel->"Out[2]= ",
 CellID->358706646,ExpressionUUID->"0642d375-09f3-9942-2e71-cb3faf87eba8"]
}, Open  ]],

Cell["\<\
The default measurement is a projective measurement in the computational \
basis of the second qubit. The state is perfectly correlated in that basis, \
so all of its correlation is classical and the discord vanishes:\
\>", "ExampleText",
 CellID->1305910373,ExpressionUUID->"0651775d-2bad-791b-2e6f-6f074e584861"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumEntanglementMonotone", "[", 
  RowBox[{"classical", ",", " ", "\"\<Discord\>\""}], "]"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->1046067521,ExpressionUUID->"63b9e3d6-2298-231e-1146-fa9057128e64"],

Cell[BoxData[
 TemplateBox[{"0", "\"b\"", "bits", "\"Bits\""},
  "Quantity"]], "Output",
 CellLabel->"Out[3]= ",
 CellID->711881040,ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"]
}, Open  ]],

Cell["\<\
Measuring the second qubit in a different basis leaves correlations that no \
single measurement outcome accounts for, so the discord for that measurement \
is nonzero. The value depends on the measurement, and the computational basis \
is not privileged:\
\>", "ExampleText",
 CellID->1424360972,ExpressionUUID->"4c440104-ea8a-4285-747b-99618f3f10ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumEntanglementMonotone", "[", 
  RowBox[{"classical", ",", " ", 
   RowBox[{"QuantumMeasurementOperator", "[", "\"\<X\>\"", "]"}], ",", 
   " ", "\"\<Discord\>\""}], "]"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->1143036926,ExpressionUUID->"66c9a615-af45-c085-0ef6-385ecaf192ef"],

Cell[BoxData[
 TemplateBox[{"1", "\"b\"", "bit", "\"Bits\""},
  "Quantity"]], "Output",
 CellLabel->"Out[4]= ",
 CellID->1015936140,ExpressionUUID->"0513e607-0f4c-1e20-3320-f861aaf9650a"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

