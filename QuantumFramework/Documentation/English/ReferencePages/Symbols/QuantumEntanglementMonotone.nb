Cell[TextData[{
 "The entanglement of a ",
 Cell[BoxData["\"\<W\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640f47a5-4648-c62d-0c35-5e0f73e2ad77"],
 " state is more robust than ",
 Cell[BoxData["\"\<GHZ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63a48922-0fac-666c-115b-208caa594cb6"],
 " entanglement, because a ",
 Cell[BoxData["\"\<W\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "387a9e0d-0234-0e73-6819-1057b7c15559"],
 " state is not bi-separable:"
}], "ExampleText",
 CellID->1483842723,ExpressionUUID->"3f64ca0d-9927-5f44-651b-ec5718d225ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumEntanglementMonotone", "[", 
  RowBox[{"QuantumState", "[", "\"\<W\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->1161221974,ExpressionUUID->"399d1ff3-4632-be92-6fa2-96bd73c404f8"],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", " ", 
   SqrtBox["2"]}], "3"]], "Output",
 CellLabel->"Out[1]= ",
 CellID->515766335,ExpressionUUID->"1170384d-2f38-2c50-470f-b2174acd76ba"]
}, Open  ]],

