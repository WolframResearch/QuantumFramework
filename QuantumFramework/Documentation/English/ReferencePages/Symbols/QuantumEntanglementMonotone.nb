 RowBox[{"logNeg13", " ", "==", " ", 
  RowBox[{"QuantumEntanglementMonotone", "[", 
   RowBox[{
    RowBox[{"QuantumPartialTrace", "[", 
     RowBox[{"st", ",", " ", 
      RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", "\"\<LogNegativity\>\""}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->1764265925,ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",
