Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumEntanglementMonotone"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumEntanglementMonotone", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "01ed6b92-5a5f-fa78-3792-82dc5febc942"],
 " works for a state of any dimension. Consider the maximally entangled \
two-qutrit state:"
}], "ExampleText",
 CellID->1147788002,ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"qutrit", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"Sqrt", "[", "3", "]"}]}], ",", " ", "0", ",", " ", "0", ",", 
       " ", "0", ",", " ", 
       RowBox[{"1", "/", 
        RowBox[{"Sqrt", "[", "3", "]"}]}], ",", " ", "0", ",", " ", "0", ",", 
       " ", "0", ",", " ", 
       RowBox[{"1", "/", 
        RowBox[{"Sqrt", "[", "3", "]"}]}]}], "}"}], ",", " ", "3"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"qutrit", "[", "\"\<Formula\>\"", "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1627450959,ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["1", 
    SqrtBox["3"]], 
   InterpretationBox[
    StyleBox[
     TemplateBox[{
       RowBox[{"0", "\[InvisibleSpace]", "0"}]},
      "Ket"],
     FontWeight->"Plain"],
    Wolfram`QuantumFramework`QuditName[{0, 0}, "Dual" -> False]]}], "+", 
  RowBox[{
   FractionBox["1", 
    SqrtBox["3"]], 
   InterpretationBox[
    StyleBox[
     TemplateBox[{
       RowBox[{"1", "\[InvisibleSpace]", "1"}]},
      "Ket"],
     FontWeight->"Plain"],
    Wolfram`QuantumFramework`QuditName[{1, 1}, "Dual" -> False]]}], "+", 
  RowBox[{
   FractionBox["1", 
    SqrtBox["3"]], 
   InterpretationBox[
    StyleBox[
     TemplateBox[{
       RowBox[{"2", "\[InvisibleSpace]", "2"}]},
      "Ket"],
     FontWeight->"Plain"],
    Wolfram`QuantumFramework`QuditName[{2, 2}, "Dual" -> 
     False]]}]}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->1155227106,ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"]
