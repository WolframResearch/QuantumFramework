}, Open  ]],

Cell[TextData[{
 "Since the state is pure, the norm equals ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"2", "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     StyleBox["Tr",
      FontSlant->"Plain"], 
     StyleBox["[",
      SpanMaxSize->1], 
     SubsuperscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["A", "TI"], "2"], 
     StyleBox["]",
      SpanMaxSize->1]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],
 ", with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["A", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b5b9263-9199-4e16-7978-144d202c157c"],
 " the reduced density matrix of one part:"
}], "ExampleText",
 CellID->654274215,ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Chop", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{
          RowBox[{"QuantumPartialTrace", "[", 
           RowBox[{
            RowBox[{"st", "[", "\"\<Bipartition\>\"", "]"}], ",", " ", 
            RowBox[{"{", "1", "}"}]}], "]"}], "[", "\"\<DensityMatrix\>\"", 
          "]"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"Tr", "[", 
            RowBox[{"r", " ", ".", " ", "r"}], "]"}]}], ")"}]}], "]"}]}], 
      "]"}], " ", "-", " ", 
     RowBox[{"Norm", "[", "cv", "]"}]}], ",", " ", 
    RowBox[{"10", "^", 
     RowBox[{"-", "6"}]}]}], "]"}], " ", "==", " ", "0"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->1844908790,ExpressionUUID->"2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",
 CellID->569999104,ExpressionUUID->"3343f580-98d5-e31c-6170-ecea1961ce66"]
}, Open  ]]
}, Open  ]],

