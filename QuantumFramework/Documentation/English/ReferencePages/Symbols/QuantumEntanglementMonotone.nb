Cell[TextData[{
 "The vector has ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], "1"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["d", "TI"], "1"], "-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], "\[CenterDot]", 
   FractionBox[
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], "2"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["d", "TI"], "2"], "-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "574a2197-51ef-7938-7d49-b8d1679a4802"],
 " components, with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["d", "TI"], "1"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e85e9ed-427b-8528-16ba-00b7770fec72"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["d", "TI"], "2"], "=", "2", "\[Times]", "2", "=", "4"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73b76025-96bb-3fff-214d-798f234f85c5"],
 " the dimensions of the two parts:"
}], "ExampleText",
 CellID->1809536896,ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"3", " ", 
      RowBox[{"(", 
       RowBox[{"3", " ", "-", " ", "1"}], ")"}]}], ")"}], "/", "2"}], " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"4", " ", 
      RowBox[{"(", 
       RowBox[{"4", " ", "-", " ", "1"}], ")"}]}], ")"}], "/", "2"}]}], " ", "==",
   " ", 
  RowBox[{"Length", "[", "cv", "]"}]}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->1244278730,ExpressionUUID->"72ff7667-e560-b2c0-2285-68408c1a002a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",
 CellID->580385305,ExpressionUUID->"7c9be80e-0554-61c1-24b8-0268ace1332b"]
}, Open  ]],

Cell["Its norm is the concurrence:", "ExampleText",
 CellID->1799849109,ExpressionUUID->"106b7ad8-6378-599b-4069-7382160d2be1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Norm", "[", "cv", "]"}]], "Input",
 CellLabel->"In[4]:= ",
