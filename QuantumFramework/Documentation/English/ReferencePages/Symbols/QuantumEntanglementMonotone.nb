Cell[CellGroupData[{
Cell["QuantumEntanglementMonotone", "ObjectName",
 CellID->1224892054,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumEntanglementMonotone"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumEntanglementMonotone", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["qs", "TI"], ",", " ", 
    StyleBox["bipart", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 "\[LineSeparator]",
 "computes the entanglement monotone using the measure or metric ",
 StyleBox["t", "TI"],
 " on the quantum state ",
 StyleBox["qs", "TI"],
 " between the subsystems of the bipartition list ",
 StyleBox["bipart", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["QuantumEntanglementMonotone"]], 
     "paclet:Wolfram/QuantumFramework/ref/QuantumEntanglementMonotone", 
     "Wolfram/QuantumFramework Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["qs", "TI"], ",", " ", 
    StyleBox["m", "TI"], ",", " ", 
    StyleBox["bipart", "TI"], ",", " ", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a568a6-87a2-527f-535a-810032572145"],
 "\[LineSeparator]",
 "uses the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumMeasurementOperator"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumMeasurementOperator", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 " ",
 StyleBox["m", "TI"],
 " on the second subsystem, for the measurement-dependent measures ",
 Cell[BoxData["\"\<Discord\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 " and ",
 Cell[BoxData["\"\<MutualInformationJ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5902d484-617f-9570-0f31-cdee100bfc5a"],
 "."
}], "Usage",
 CellID->329621944,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell["The following measures or metrics are supported:", "Notes",
 CellID->515379898,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3b7807e8-9504-b25a-6907-9eb21cb600a0"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"], Cell[TextData[Cell[
    BoxData["\"\<Concurrence\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"]], "TableText",ExpressionUUID->
     "6ec9a758-58be-624c-16f6-3f02594b3096"], Cell["\<\
the generalized concurrence, exact for two qubits and for pure states of any \
dimension\
\>", "TableText",ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6e84829b-9667-6594-16bb-1bc523124ffe"], Cell[TextData[Cell[
    BoxData["\"\<Negativity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "569e173f-6b36-b240-7ea5-8f790ec000aa"]], "TableText",ExpressionUUID->
     "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"], Cell[
    "the negativity (Peres-Horodecki criterion)", "TableText",ExpressionUUID->
     "779c57de-bb93-d239-1da4-4e983e27a103"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2867ea9b-6e8d-517b-581c-03c50b382041"], Cell[TextData[Cell[
    BoxData["\"\<LogNegativity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "76dfbc62-92ac-7b6e-1ee4-364c275949b4"]], "TableText",ExpressionUUID->
     "0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"], Cell[
    "the logarithmic negativity (Peres-Horodecki criterion)", "TableText",
     ExpressionUUID->"4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "741b091d-feb2-1a39-1c38-a146fb476903"], Cell[TextData[Cell[
    BoxData["\"\<EntanglementEntropy\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3bf5a20e-c541-e06e-698a-446becf5b2b4"]], "TableText",ExpressionUUID->
     "07964fa7-8d1e-ff14-2dae-660124a8c27e"], Cell["\<\
the von Neumann entropy of a reduced subsystem, for a pure state\
\>", "TableText",ExpressionUUID->"3e367b18-9aa8-58f9-67ce-73421f5d2ac3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1dbaaaf7-1388-e538-4b59-43b1a622cc02"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", 
      RowBox[{"\"\<RenyiEntropy\>\"", ",", " ", "\[Alpha]"}], "}"}]], 
     "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "77d99fdb-a351-2d53-1de6-1684d6e477b9"]], "TableText",ExpressionUUID->
     "04646437-faee-7dfc-2c1c-7e70fe9b47c6"], Cell[TextData[{
     "the Renyi-",
     StyleBox["\[Alpha]", "TI"],
     " entropy of a reduced subsystem, for a pure state"
    }], "TableText",ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"], Cell[TextData[Cell[
    BoxData["\"\<Realignment\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4c358d3e-86d3-ec5f-75ca-25783367b6a5"]], "TableText",ExpressionUUID->
     "1f908cf3-3c70-d55a-45af-25bdb50abfa0"], Cell["\<\
the realignment metric: the summed singular values of the realigned density \
matrix, minus one\
\>", "TableText",ExpressionUUID->"5dac66ba-272d-3627-0b54-7fe452d99d0d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "110914de-bbdd-83a1-4736-8d983e69d18b"], Cell[TextData[Cell[
    BoxData["\"\<ConcurrenceVector\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "76d004f9-29e5-6665-1eef-9da34f904d4f"]], "TableText",ExpressionUUID->
     "2c76c797-c249-79ca-540d-ded0f7fc4b10"], Cell["\<\
the generalized concurrence vector, whose norm is the concurrence\
\>", "TableText",ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4ebf3687-f906-130d-7644-afe0f8b37e57"], Cell[TextData[Cell[
    BoxData["\"\<MutualInformationI\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "65de4a87-3471-cd9f-13e6-63e1bd0597e5"]], "TableText",ExpressionUUID->
     "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"], Cell[TextData[{
     "the quantum mutual information ",
     Cell[BoxData[
      RowBox[{
       StyleBox["I", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["A", "TI"], ":", 
        StyleBox["B", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1], "=", 
       StyleBox["S", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], 
        StyleBox["A", "TI"]], 
       StyleBox[")",
        SpanMaxSize->1], "+", 
       StyleBox["S", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], 
        StyleBox["B", "TI"]], 
       StyleBox[")",
        SpanMaxSize->1], "-", 
       StyleBox["S", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], 
        StyleBox[
         RowBox[{"A", "B"}], "TI"]], 
       StyleBox[")",
        SpanMaxSize->1]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"]
    }], "TableText",ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "034d641c-5834-e412-3173-7e4659c6cf78"], Cell[TextData[Cell[
    BoxData["\"\<MutualInformationJ\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"]], "TableText",ExpressionUUID->
     "5bfe104a-50de-a555-0985-8a1461680fbf"], Cell[TextData[{
     "the one-sided classical correlation ",
     Cell[BoxData[
      StyleBox["J", "TI"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "134534fb-1061-d656-417a-ada5a115bcbc"],
     " for a given measurement on the second subsystem"
    }], "TableText",ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6e1c99a5-dcef-9c28-1623-100ed49be772"], Cell[TextData[Cell[
    BoxData["\"\<Discord\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "608e87cc-8fce-afdf-10b5-1e962a78f525"]], "TableText",ExpressionUUID->
     "2aa912c6-4938-1bb7-5a56-8ba068cd699d"], Cell[TextData[{
     "the quantum discord relative to a given measurement, ",
     Cell[BoxData[
      RowBox[{
       StyleBox["I", "TI"], "-", 
       StyleBox["J", "TI"]}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "66b4bee0-d247-b105-0e4b-37cde7f3006f"]
    }], "TableText",ExpressionUUID->"337c2d89-644e-5b5e-6103-c4d30dfb29a4"]}
  }]], "2ColumnTableMod",
 CellID->604760901,ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],

Cell[TextData[{
 "The bipartition list ",
 StyleBox["bipart", "TI"],
 " has the form ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["i", "TI"], 
       StyleBox["1", "TR"]], ",", " ", 
      SubscriptBox[
       StyleBox["i", "TI"], 
       StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["j", "TI"], 
       StyleBox["1", "TR"]], ",", " ", 
      SubscriptBox[
       StyleBox["j", "TI"], 
       StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 ". For example, ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
    RowBox[{"{", "3", "}"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
 " splits the state into the subsystem ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 " and the subsystem ",
 Cell[BoxData[
  RowBox[{"{", "3", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0daf8e98-7628-e40b-3b54-27c203c2cf51"],
 ". If no bipartition list ",
 StyleBox["bipart", "TI"],
 " is given, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["qs", "TI"], "[", "\"\<Bipartition\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 " is performed first, which splits the system into its first subsystem and \
the rest (that is, ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", "1", "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "3", ",", " ", "\[Ellipsis]"}], "}"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],
 ")."
}], "Notes",
 CellID->1476799103,ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell[TextData[{
 "The measure or metric ",
 StyleBox["t", "TI"],
 " is ",
 Cell[BoxData["\"\<Concurrence\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],
 " by default, unless specified otherwise."
}], "Notes",
 CellID->448336599,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell[TextData[{
 "For ",
 Cell[BoxData["\"\<Concurrence\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cb5c01f-62f5-68e0-144a-da5916803aca"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumEntanglementMonotone"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumEntanglementMonotone", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "55f417ec-7166-d78d-038b-8eb60010bdd7"],
 " uses the Rungta-Buzek-Caves-Hillery-Milburn generalization of the \
Hill-Wootters concurrence (Phys. Rev. A 64, 042315 (2001)), which applies in \
any dimension. It is exact for two qubits and for pure states of any \
dimension, and a lower bound on the convex-roof concurrence for a \
higher-dimensional mixed state, where (unlike the two-qubit case) it is \
basis-dependent and not invariant under local unitaries. The value is the \
norm of the concurrence vector, whose components are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"0", ",", " ", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Sigma]", "TI"], "1"], "-", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["i", "TI"], "\[GreaterEqual]", "2"}],
        LimitsPositioning->False], 
       SubscriptBox[
        StyleBox["\[Sigma]", "TI"], 
        StyleBox["i", "TI"]]}]}]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 " with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d359769-845f-cd94-44ca-0f332deb97fe"],
 " the singular values of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", 
   SqrtBox[
    StyleBox["\[Rho]", "TI"]], " ", 
   SqrtBox[
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "~"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2055bfee-d4b5-7aa2-506a-36cbdd404888"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "~"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["\[Alpha]", "TI"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["\[Beta]", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "*"], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["\[Alpha]", "TI"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["\[Beta]", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 " is the spin-flipped state built from a pair of antisymmetric ",
 Cell[BoxData[
  RowBox[{"\|01d530", "\|01d532", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["d", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 " generators. For a bipartition of dimensions ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["d", "TI"], "1"], "\[Times]", 
   SubscriptBox[
    StyleBox["d", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea251ed-865f-e03c-1652-48b733ebb306"],
 " the concurrence vector has ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], "1"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["d", "TI"], "1"], "-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], "\[CenterDot]", 
   FractionBox[
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], "2"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["d", "TI"], "2"], "-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 " components. For a pure state its norm reduces to ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"2", "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     StyleBox["Tr",
      FontSlant->"Plain"], 
     StyleBox["[",
      SpanMaxSize->1], 
     SubsuperscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["A", "TI"], "2"], 
     StyleBox["]",
      SpanMaxSize->1]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04786d0e-016a-d127-2c07-8568b01ca00d"],
 ", with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["A", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],
 " the reduced density matrix of one part."
}], "Notes",
 CellID->970785311,ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell[TextData[{
 "If no ",
 StyleBox["\[Alpha]", "TI"],
 " is given for ",
 Cell[BoxData["\"\<RenyiEntropy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fd1512-f616-8834-3c82-8d5f83a0db1e"],
 ", it is set to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c67103-72a1-9427-0efe-696d0755ff0d"],
 ". The alias ",
 Cell[BoxData["\"\<RenyiEntanglementEntropy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
 " behaves identically."
}], "Notes",
 CellID->1377816002,ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<EntanglementEntropy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],
 " and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<RenyiEntropy\>\"", ",", " ", "\[Alpha]"}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],
 " measures quantify entanglement only for a pure global state. For a \
genuinely mixed input they return ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indeterminate"]], "paclet:ref/Indeterminate"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3181a460-bc62-f1ee-67be-3e4a3514c334"],
 " and issue a ",
 Cell[BoxData[
  RowBox[{"QuantumEntanglementMonotone", "::", "mixedentropy"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],
 " message, since the reduced von Neumann or Renyi entropy of a mixed state \
counts classical mixing rather than entanglement. Use ",
 Cell[BoxData["\"\<Negativity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b45e796-37a7-eecc-197a-fed04253b416"],
 ", ",
 Cell[BoxData["\"\<LogNegativity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 ", or ",
 Cell[BoxData["\"\<Concurrence\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 " for a mixed state."
}], "Notes",
 CellID->1439899046,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell[TextData[{
 Cell[BoxData["\"\<Discord\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],
 " returns ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["A", "TI"], ":", 
    StyleBox["B", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43821c38-6720-b4f9-71b1-966212da1ec3"],
 " for the measurement supplied as the second argument (a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["QuantumMeasurementOperator"]], 
    "paclet:Wolfram/QuantumFramework/ref/QuantumMeasurementOperator", 
    "Wolfram/QuantumFramework Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "341c54d9-3079-6bba-5c24-4d83410c3980"],
 "), or a projective computational-basis measurement on the second subsystem \
when none is given. It is therefore the discord for that fixed measurement, \
an upper bound on the Ollivier-Zurek quantum discord, which minimizes over \
all local measurements (equivalently maximizes ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],
 "). The value depends on the chosen measurement, and the computational-basis \
default carries no special physical status. Likewise ",
 Cell[BoxData["\"\<MutualInformationJ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f449897-1a0e-51e7-357b-11d19fbb23cd"],
 " is the classical correlation for the given measurement, whose maximum over \
measurements is the Ollivier-Zurek classical correlation. (References: \
Ollivier & Zurek, Phys. Rev. Lett. 88, 017901 (2001); Henderson & Vedral, J. \
Phys. A 34, 6899 (2001).)"
}], "Notes",
 CellID->1641200340,ExpressionUUID->"6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"]
}, Open  ]],

