Cell["\<\
Plot the concurrence and the logarithmic negativity of a Werner state, and \
read off the range of the parameter for which the state is separable:\
\>", "ExampleText",
 CellID->1520434058,ExpressionUUID->"6334ac9c-43f1-85c0-12cb-45c67585ef2a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"wernerLogNeg", "[", 
    RowBox[{"p_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"QuantumEntanglementMonotone", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<Werner\>\"", "[", "p", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "}"}], ",", " ", "\"\<LogNegativity\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wernerConc", "[", 
    RowBox[{"p_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"QuantumEntanglementMonotone", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<Werner\>\"", "[", "p", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "}"}], ",", " ", "\"\<Concurrence\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"wernerLogNeg", "[", "p", "]"}], ",", " ", 
     RowBox[{"wernerConc", "[", "p", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<LogNegativity\>\"", ",", " ", "\"\<Concurrence\>\""}], 
     "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1598517210,ExpressionUUID->"74397683-04f4-1d4d-1dc7-6fedac816797"],

