Cell["The bipartition list need not span the whole state:", "ExampleText",
 CellID->1245349523,ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"st", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<RandomPure\>\"", "[", "3", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"logNeg13", " ", "=", " ", 
  RowBox[{"QuantumEntanglementMonotone", "[", 
   RowBox[{"st", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "1", "}"}], ",", " ", 
      RowBox[{"{", "3", "}"}]}], "}"}], ",", " ", "\"\<LogNegativity\>\""}], 
   "]"}]}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->535795172,ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"],

Cell[BoxData["0.36238403559496746`"], "Output",
 CellLabel->"Out[1]= ",
 CellID->940399158,ExpressionUUID->"6878c7f8-419e-9db5-1807-dea27028e79f"]
}, Open  ]],

Cell["\<\
Tracing out the excluded subsystem first gives the same value:\
\>", "ExampleText",
 CellID->1233998414,ExpressionUUID->"48a3d607-c312-9dd3-7850-c860f6a4e739"],

Cell[CellGroupData[{

