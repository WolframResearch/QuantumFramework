Notebook[{
Cell["Quantum in Continuous Space: Worked Solutions (Parts 1 to 3)", "Title",ExpressionUUID->"dd21e3b3-97e5-4a0a-ac8e-984fc32f19f4"],

Cell[TextData[{
 "Pure Wolfram Language answers to ",
 Cell[BoxData[
  ButtonBox[
   RowBox[{"Question", "-", 
    RowBox[{"List", ".", "md"}]}],
   BaseStyle->"Hyperlink",
   ButtonData->{
     URL["Question-List.md"], None}]], "InlineFormula",ExpressionUUID->
  "c861b602-b437-4fd3-9873-62e816d8eb8a"],
 ": the wavefunction and the state space ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["L", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02742c92-41e3-4a9a-8be2-91f2b6674261"],
 " (Part 1), the position and momentum operators and the Fourier bridge (Part \
2), and the time-independent Schrodinger equation as an ODE eigenvalue \
problem (Part 3). No quantum package; natural units ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", 
   StyleBox["m", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3c6b01c-d288-41cb-a839-cc94c53a57d4"],
 ". Each answer is self-contained: it defines the state or operator it uses, \
computes from that definition, and can be read or run on its own."
}], "Text",ExpressionUUID->"ce06fac6-e78d-49cf-8973-643a64c1b516"],

Cell[TextData[{
 "Part 1. The wavefunction and the state space ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["L", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a79de0eb-8b53-4898-ac2e-415d001195da"]
}], "Section",ExpressionUUID->"bfa36f7b-b13f-4b46-88d3-0ad26558054f"],

Cell[TextData[{
 "A particle on the line is a complex ",
 StyleBox["wavefunction", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5814efc5-e894-47bc-8b78-9d22e85d27af"],
 " in the Hilbert space ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["L", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], "\:211d", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce7b83b2-aed0-428e-b04a-8bfdaf1d27bb"],
 " of square-integrable functions, ",
 Cell[BoxData[
  RowBox[{
   UnderoverscriptBox["\[Integral]", 
    RowBox[{"-", "\[Infinity]"}], "\[Infinity]",
    LimitsPositioning->False], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "<", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "287d626c-2f7d-4b1b-9d46-8b4f83b0e534"],
 ". Its ",
 StyleBox["inner product", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Phi]", "TI"], 
     StyleBox["\[Psi]", "TI"]},
    "BraKet"], "=", 
   UnderoverscriptBox["\[Integral]", 
    RowBox[{"-", "\[Infinity]"}], "\[Infinity]",
    LimitsPositioning->False], 
   SuperscriptBox[
    StyleBox["\[Phi]", "TI"], "*"], 
   StyleBox["\[Psi]", "TI"], 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7504b8c7-0c7f-4660-9d23-175e7fbd72ee"],
 " gives the norm, the orthogonality, and the overlap whose modulus squared \
",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["\[Phi]", "TI"], 
        StyleBox["\[Psi]", "TI"]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe3ef0ad-07f8-4afb-a8fb-01fec99831e1"],
 " is a transition probability. The ",
 StyleBox["Born rule", "TI"],
 " makes ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["x", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19819250-7a72-4cd4-a1fb-c4acc97984cf"],
 " a probability density, so ",
 Cell[BoxData[
  RowBox[{
   UnderoverscriptBox["\[Integral]", 
    StyleBox["a", "TI"], 
    StyleBox["b", "TI"],
    LimitsPositioning->False], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6e9b6e5-b7b2-4e81-a738-0fc1ba1a7a93"],
 " is the probability of finding the particle in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80da03b4-1550-4325-9d1d-d11a8eddca50"],
 " and a physical state is normalized to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"], 
     StyleBox["\[Psi]", "TI"]},
    "BraKet"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58cb3979-9bff-41f6-961d-2e47c06530fe"],
 ". ",
 StyleBox["Expectation values", "TI"],
 " are inner products ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["A", "TI"], "^"], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Bra"], 
    OverscriptBox[
     StyleBox["A", "TI"], "^"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0e0941-ccb0-402d-ab9a-ba869ce52e48"],
 ", giving the mean position ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea184492-4856-446f-90d9-326f8de529f6"],
 " and the spread ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb0ecfba-266e-4c5c-8433-e50b9758b7b4"],
 ". Probability is locally conserved by the current ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2929a2a9-d2a6-4be9-8c66-786b2524dd4b"],
 " through the continuity equation whenever the potential is real, and \
because only such bilinear quantities are observable, an overall constant \
phase of ",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7fcdd86-9070-460f-a1ab-7cfde7c6fd70"],
 " carries no physics. Throughout, ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", 
   StyleBox["m", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45f518c7-d2f4-40e2-8b93-da6d1b2d372c"],
 "."
}], "Text",ExpressionUUID->"d5b745c8-7bdc-4ead-9930-00408c2bdd00"],

Cell[TextData[{
 "1.1 [BSc] How do I represent a one-dimensional wavefunction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b8b4e98-5d97-4181-b156-431f5d3a2ec3"],
 " as a Wolfram Language function and plot its probability density ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["x", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e67195c1-749b-4d40-9d47-d6b8a80147f6"],
 "?"
}], "Subsection",ExpressionUUID->"763e7f36-68ee-4fa2-a9ea-dacc917a2a16"],

Cell[TextData[{
 "A state on the line is a complex function ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa791745-25c8-4ef6-9907-e68e50a9bced"],
 " in ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["L", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], "\:211d", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10dff1b5-468a-4d04-be0a-12a656890a52"],
 ". Measuring position returns a single number, one point of the continuous \
spectrum of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["x", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2b1e1b3-ff47-4199-8174-dc00692f811e"],
 ", and Born's rule fixes only the statistics of that outcome: ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["x", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca45d966-30f7-4d52-9c56-d0fd16cfec0f"],
 " is the probability that the result falls in ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "x"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e976ddc4-27bc-4c72-bc91-2d39fa3bd08a"],
 ", a distribution an ensemble of identically prepared states reproduces and \
a single run never does. The density is therefore not the state's whole \
physical content, only the outcome distribution of one observable: the phase \
it discards carries the momentum distribution, the current, and the energy, \
so two states with the same density can differ in every other measurement."
}], "Text",ExpressionUUID->"5d7880e2-cc76-4c55-bd9c-340c8af72eef"],

Cell[TextData[{
 "We take the ground state of the Morse oscillator, the standard model of a \
vibrating diatomic molecule. With the bond measured from its equilibrium \
length as ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df78c1de-8ff9-4684-b27e-1ce4aa25e84f"],
 ", the potential is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["D", "TI"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "2", 
     StyleBox["a", "TI"], 
     StyleBox["x", "TI"]}]], "-", "2", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["a", "TI"], 
     StyleBox["x", "TI"]}]], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4f24331-0db3-4969-9bff-c782a94fb719"],
 ": a hard repulsive wall as the atoms are pushed together (",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "\[Rule]", "-", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3f4e531-c2e6-46c3-ae80-834f4ee00259"],
 ") and a soft tail as they are pulled apart (",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "\[Rule]", "+", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da6acc6b-a135-4620-9c18-4eb291545717"],
 "), with well depth ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d494e60-2a04-454d-9377-87ce99b0bd0e"],
 " and range set by ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32397bd7-60df-40e9-857b-a2da1fedfa08"],
 ". The ground state is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], "0"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[Proportional]", 
   SuperscriptBox[
    StyleBox["z", "TI"], 
    RowBox[{
     StyleBox["\[Lambda]", "TI"], "-", "1", "/", "2"}]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["z", "TI"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e889ea06-eacc-4c5c-ac9c-b23f51f03698"],
 " in the variable ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "2", 
   StyleBox["\[Lambda]", "TI"], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["a", "TI"], 
     StyleBox["x", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348b46e3-b659-455e-ac63-664179eeb66d"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", 
   SqrtBox[
    RowBox[{"2", 
     StyleBox["D", "TI"]}]], "/", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2a4d3d5-add0-4b1e-8df0-bceb8a7ee9f8"],
 " is the dimensionless depth. Unlike every symmetric state in this Part, \
this one has no parity: it inherits the lopsidedness of the well, and that \
asymmetry is the whole physical interest, so it is the feature to watch."
}], "Text",ExpressionUUID->"23c87b31-81bc-46a2-8769-5d0ac28ae146"],

Cell[TextData[{
 "Substitute ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Psi]", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97990e88-35d8-4107-9419-608ea9a6c39c"],
 " into the Morse stationary equation ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox["1", "2"], 
   SubsuperscriptBox[
    StyleBox["\[Psi]", "TI"], "0", "\[DoublePrime]"], "+", 
   StyleBox["V", "TI"], 
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], "0"], "=", 
   SubscriptBox[
    StyleBox["E", "TI"], "0"], 
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16648c3a-8d96-475e-865b-1a426375b1e0"],
 " and confirm the residual vanishes at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "0"], "=", "-", 
   FractionBox[
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], "2"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   StyleBox["\[Lambda]", "TI"], "-", 
   FractionBox["1", "2"], 
   SuperscriptBox[
    StyleBox[")",
     FontSize->1.2 Inherited], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86da7831-dd36-46de-a98b-02efcd6b40a2"],
 ":"
}], "Text",ExpressionUUID->"639d1239-4dee-4db1-b260-f5f369ced18c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]0", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", " ", "\[Lambda]", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "a"}], " ", "x"}], "]"}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"\[Lambda]", " ", "-", " ", 
       RowBox[{"1", "/", "2"}]}], ")"}]}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "\[Lambda]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "a"}], " ", "x"}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Vmorse", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Lambda]", "^", "2"}], " ", 
      RowBox[{
       RowBox[{"a", "^", "2"}], "/", "2"}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "a", " ", "x"}], "]"}], " ", "-", " ", 
      RowBox[{"2", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "a"}], " ", "x"}], "]"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], " ", 
     RowBox[{
      RowBox[{"\[Psi]0", "''"}], "[", "x", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"Vmorse", "[", "x", "]"}], " ", 
     RowBox[{"\[Psi]0", "[", "x", "]"}]}], " ", "-", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a", "^", "2"}], "/", "2"}], ")"}]}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Lambda]", " ", "-", " ", 
          RowBox[{"1", "/", "2"}]}], ")"}], "^", "2"}]}], ")"}], " ", 
     RowBox[{"\[Psi]0", "[", "x", "]"}]}]}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"a", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Lambda]", " ", ">", " ", 
     RowBox[{"1", "/", "2"}]}], " ", "&&", " ", 
    RowBox[{"x", " ", "\[Element]", " ", "Reals"}]}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6dcd5151-723e-4852-bd01-c09e9930281b"],

Cell[TextData[{
 "The residual is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c13ba6d0-4361-400f-a3fb-4f83e9a0089d"],
 " for every ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "027e728e-c1e5-4098-8a00-d3b2aba62ac7"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], ">", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2acb6b8a-7041-4d72-a8d8-e334845c04d2"],
 ", so ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Psi]", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fae8f72e-a919-435f-ac1f-86d5d94106bc"],
 " is the exact ground state with energy ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "0"], "=", "-", 
   FractionBox[
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], "2"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   StyleBox["\[Lambda]", "TI"], "-", 
   FractionBox["1", "2"], 
   SuperscriptBox[
    StyleBox[")",
     FontSize->1.2 Inherited], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fae3afe6-6081-418d-ba87-82a444f3bb77"],
 ", a binding energy of ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], "2"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   StyleBox["\[Lambda]", "TI"], "-", 
   FractionBox["1", "2"], 
   SuperscriptBox[
    StyleBox[")",
     FontSize->1.2 Inherited], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1e5302d-29b8-4826-9810-de66c950fc02"],
 " below the dissociation threshold at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc33cb5a-bd1b-4d97-aad9-1875b6ec53f0"],
 ". The depth is written ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["\[Lambda]", "TI"], "2"], 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6947db45-5f9f-446d-9017-f69ef8e8ef52"],
 " so that ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72a69e29-cd4f-4bd3-8a50-f95f43840e32"],
 " is the only shape parameter. The state is not yet normalized; the \
substitution ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "2", 
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["a", "TI"], 
     StyleBox["x", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d044cb70-be83-4f23-b430-1253f6106238"],
 " turns the norm into a Gamma integral, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[GridBox[{
      {
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], "0"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "=", 
   FractionBox["1", 
    StyleBox["a", "TI"]], 
   UnderoverscriptBox["\[Integral]", "0", "\[Infinity]",
    LimitsPositioning->False], 
   SuperscriptBox[
    StyleBox["z", "TI"], 
    RowBox[{"2", 
     StyleBox["\[Lambda]", "TI"], "-", "2"}]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["z", "TI"]}]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39f19c30-4a23-4478-97a8-63faf1a2caa9"],
 ". Compute it:"
}], "Text",ExpressionUUID->"8c3a81e3-6f51-416e-b8bc-e2b279effc60"],

Cell[BoxData[
 RowBox[{"norm2", " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Psi]0", "[", "x", "]"}], "^", "2"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", 
      RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{
      RowBox[{"a", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[Lambda]", " ", ">", " ", 
       RowBox[{"1", "/", "2"}]}]}]}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3d4fc6fb-ac4e-4779-a641-4c5ac66ac462"],

Cell[TextData[{
 "It is ",
 Cell[BoxData[
  RowBox[{"\[CapitalGamma]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["\[Lambda]", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4d6163d-f638-4269-837e-77bf02dea991"],
 ", finite exactly when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], ">", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0060a561-782a-4d9b-9be4-5a1520ba2409"],
 ": the Gamma pole at ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Lambda]", "TI"], "-", "1", "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e930b1c1-9b99-4611-bd85-059bd502f932"],
 " is the edge of existence, the shallowest well that still binds a \
normalizable ground state, below which ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      StyleBox["\[Psi]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "620e2534-63df-4c72-89d3-0c485655bb01"],
 " is not a probability density at all. Divide by its square root and confirm \
the normalized state carries unit probability:"
}], "Text",ExpressionUUID->"35544aff-3c5f-405c-a100-7dc5724888f5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"\[Psi]0", "[", "x", "]"}], "/", 
    RowBox[{"Sqrt", "[", "norm2", "]"}]}]}], ";"}], "\n", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Psi]", "[", "x", "]"}], "^", "2"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{
     RowBox[{"a", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Lambda]", " ", ">", " ", 
      RowBox[{"1", "/", "2"}]}]}]}]}], "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"3feea692-9c92-4d5b-aee7-dff9bc9d3e30"],

Cell[TextData[{
 "Now read off the density ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["x", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
   FractionBox[
    StyleBox["a", "TI"], 
    RowBox[{"\[CapitalGamma]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"2", 
      StyleBox["\[Lambda]", "TI"], "-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    FontSize->1.2 Inherited], "2", 
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["a", "TI"], 
     StyleBox["x", "TI"]}]], 
   SuperscriptBox[
    StyleBox[")",
     FontSize->1.2 Inherited], 
    RowBox[{"2", 
     StyleBox["\[Lambda]", "TI"], "-", "1"}]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "2", 
     StyleBox["\[Lambda]", "TI"], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["a", "TI"], 
       StyleBox["x", "TI"]}]]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f246a11d-3146-4c9b-8a62-12aa1e9a9c7f"],
 ":"
}], "Text",ExpressionUUID->"e61261d6-7c82-4c5e-a0df-eba0c7a66ca6"],

Cell[BoxData[
 RowBox[{"dens", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Psi]", "[", "x", "]"}], "^", "2"}], ",", " ", 
    RowBox[{
     RowBox[{"a", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Lambda]", " ", ">", " ", 
      RowBox[{"1", "/", "2"}]}], " ", "&&", " ", 
     RowBox[{"x", " ", "\[Element]", " ", "Reals"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"99d887c1-278b-4026-80e5-76d1caf0f4f3"],

Cell[TextData[{
 "Plot it at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "678341b9-b852-4ac3-a42e-ea521609c295"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", 
   FractionBox["5", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f752e7d-fae5-43b9-8733-0750153f4823"],
 ", a representative depth:"
}], "Text",ExpressionUUID->"d10c80bb-5e27-4e40-817f-9d07f03f266e"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"dens", " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\[Lambda]", " ", "->", " ", 
       RowBox[{"5", "/", "2"}]}]}], "}"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "1"}], ",", " ", "7"}], "}"}], ",", " ", 
   RowBox[{"Filling", " ", "->", " ", "Axis"}], ",", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", " ", "\"\<|\[Psi]|^2\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"28d417c2-3c92-4887-988a-c83ab9daec81"],

Cell[TextData[{
 "The density is a single skewed hump, a steep rise on the compression side \
and a long tail on the stretch side, nothing like a symmetric bell. That \
lopsidedness is what the plot is for. It shows first in where the density \
peaks: not at the bottom of the well, but at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], "\[FivePointedStar]"], "=", 
   FractionBox["1", 
    StyleBox["a", "TI"]], 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", 
   FractionBox[
    RowBox[{"2", 
     StyleBox["\[Lambda]", "TI"]}], 
    RowBox[{"2", 
     StyleBox["\[Lambda]", "TI"], "-", "1"}]], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "625da210-a8b9-4558-a76c-39c62a0aff6c"],
 ", displaced toward the soft side. Confirm that this is where the density is \
stationary:"
}], "Text",ExpressionUUID->"699830c0-00e6-439f-b3a6-d066db99cdd9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"xstar", " ", "=", " ", 
   RowBox[{
    RowBox[{"Log", "[", 
     RowBox[{"2", " ", 
      RowBox[{"\[Lambda]", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "\[Lambda]"}], " ", "-", " ", "1"}], ")"}]}]}], 
     "]"}], "/", "a"}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"dens", ",", " ", "x"}], "]"}], " ", "/.", " ", 
    RowBox[{"x", " ", "->", " ", "xstar"}]}], ",", " ", 
   RowBox[{
    RowBox[{"a", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Lambda]", " ", ">", " ", 
     RowBox[{"1", "/", "2"}]}]}]}], "]"}]}], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"16c151b3-9d75-4227-9a1a-12dba0cc8a55"],

Cell[TextData[{
 "The derivative vanishes at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], "\[FivePointedStar]"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c33b2b8-0a04-4c35-98cb-730abfead912"],
 ": the crest of the plotted density lies to the stretch side of the force \
minimum at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d64a5c8d-4db0-4706-91ab-9e9ae7b1ad4b"],
 ". Cross-check the closed form against a direct numerical maximization at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "402e4dda-222e-4358-833d-300c00ca9f7b"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", 
   FractionBox["5", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d3a9a6d-9545-4f77-a7be-a4949034c1b5"],
 ":"
}], "Text",ExpressionUUID->"9f322a4e-5546-4138-a6ca-a489f105077c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"N", "[", 
    RowBox[{"xstar", " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"\[Lambda]", " ", "->", " ", 
        RowBox[{"5", "/", "2"}]}]}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"x", " ", "/.", " ", 
    RowBox[{"Last", "@", 
     RowBox[{"FindMaximum", "[", 
      RowBox[{
       RowBox[{"dens", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"\[Lambda]", " ", "->", " ", 
           RowBox[{"5", "/", "2"}]}]}], "}"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "0.2"}], "}"}]}], "]"}]}]}]}], "}"}]], "Input",\

 CellLabel->"In[7]:= ",ExpressionUUID->"f01d7b0c-55ed-4ef4-8e3f-8398e0e3b9c0"],

Cell[TextData[{
 "Both locate the peak at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], "\[FivePointedStar]"], "\[TildeTilde]", "0.223"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1af8764-2657-42a2-8c62-058ed011061e"],
 ". Deepening the well washes the asymmetry out: as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "\[Rule]", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fc82c23-84b1-446d-9f08-6f88e83669a4"],
 " the peak slides back to the origin and the hump tends to the symmetric \
Gaussian of the harmonic oscillator."
}], "Text",ExpressionUUID->"0d7a09da-8f78-4a4f-a642-95657bee2ac4"],

Cell[BoxData[
 RowBox[{"Limit", "[", 
  RowBox[{"xstar", ",", " ", 
   RowBox[{"\[Lambda]", " ", "->", " ", "Infinity"}]}], "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"1fe70c5f-870b-4632-9fe2-c1ce83b94ddb"],

Cell[TextData[{
 "The limit is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b238dd3-254b-4f30-8028-fb7fc7f4ff5b"],
 ". The single plot then carries the state's whole character: a normalized \
probability density, manifestly lopsided at finite depth with its crest \
pushed to the soft side, and symmetric only in the deep-well limit where the \
Morse well becomes harmonic."
}], "Text",ExpressionUUID->"de8fc1f8-f7e2-4635-b4fc-eaefe91731aa"],

Cell[TextData[{
 "1.2 [BSc] How do I normalize a wavefunction with ",
 Cell[BoxData[
  RowBox[{
   UnderoverscriptBox["\[Integral]", 
    RowBox[{"-", "\[Infinity]"}], "\[Infinity]",
    LimitsPositioning->False], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4c8cdd0-3610-4ee4-80c1-05eab3fc6074"],
 ", and recognize a state that cannot be normalized?"
}], "Subsection",ExpressionUUID->"d732467f-7941-415c-a5f0-cc47cc51dc79"],

Cell[TextData[{
 "Normalizing a state means dividing it by the square root of its total \
probability, so that ",
 Cell[BoxData[
  RowBox[{
   UnderoverscriptBox["\[Integral]", 
    RowBox[{"-", "\[Infinity]"}], "\[Infinity]",
    LimitsPositioning->False], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94743085-3fbd-46d7-ba4f-352c3f37a2e6"],
 ". Equivalently, a wavefunction is admissible only when that integral is \
finite, that is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], "\[Element]", 
   SuperscriptBox[
    StyleBox["L", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aaf0b12-ec91-4f5d-9779-f406b23925f7"],
 ". Take the Lorentzian profile ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Phi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", 
    RowBox[{
     SuperscriptBox[
      StyleBox["x", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77a2810c-0f69-4343-9ef2-d4240984c382"],
 ", a heavy-tailed alternative to the usual bell curve. Its shape is the one \
familiar from Breit-Wigner lineshapes, though there the Lorentzian is a \
function of energy rather than position; and note that the density here, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Phi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "\[Proportional]", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SuperscriptBox[
       StyleBox["x", "TI"], "2"], "+", 
      SuperscriptBox[
       StyleBox["a", "TI"], "2"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{"-", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f546b7bb-5f82-4f33-bbf2-194913b83f26"],
 ", is a ",
 StyleBox["squared", "TI"],
 " Lorentzian, so the name describes the amplitude and not the observable \
distribution."
}], "Text",ExpressionUUID->"59a1407d-cf12-4c6b-ae1b-95f21f37d3e0"],

Cell[TextData[{
 "Compute its total probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Phi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf013132-9bc2-4a10-8a84-b9e05031fa23"],
 ":"
}], "Text",ExpressionUUID->"443aadbf-65a6-4d43-b91f-6552da95fd19"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"x", "^", "2"}], " ", "+", " ", 
      RowBox[{"a", "^", "2"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"norm2", " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"\[Phi]", "[", "x", "]"}], "]"}], "^", "2"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", 
      RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{"a", " ", ">", " ", "0"}]}]}], "]"}]}]}], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"e4046191-3c8e-4400-8751-a054905dfc81"],

Cell[TextData[{
 "The integral is ",
 Cell[BoxData[
  RowBox[{"\[Pi]", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SuperscriptBox[
     StyleBox["a", "TI"], "3"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e810d550-6a5b-4d88-ae0f-422447f3d7cc"],
 ", finite, so the profile is normalizable. Before trusting that closed form, \
cross-check it against a direct numerical integral at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b76b3bca-2860-4dce-9c0e-585eb781ee06"],
 ", where ",
 Cell[BoxData[
  RowBox[{"\[Pi]", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SuperscriptBox[
     StyleBox["a", "TI"], "3"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f507f65-2d71-4c56-a781-fba7a57734ba"],
 ":"
}], "Text",ExpressionUUID->"3613d28a-a558-43b7-9664-9ef4372d8515"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"norm2", " ", "/.", " ", 
    RowBox[{"a", " ", "->", " ", "1"}]}], ",", " ", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"\[Phi]", "[", "x", "]"}], "]"}], "^", "2"}], " ", "/.", " ", 
      
      RowBox[{"a", " ", "->", " ", "1"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"a46f9b3b-64bc-4df4-9ac7-4858267a96b9"],

Cell[TextData[{
 "The symbolic value and the independent numeric quadrature agree, so the \
closed form is not a ",
 Cell[BoxData["Simplify"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24b4d895-8fd5-4bff-a768-298e5735b068"],
 " artifact. Divide by its square root and confirm the normalized state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SqrtBox[
    FractionBox[
     RowBox[{"2", 
      SuperscriptBox[
       StyleBox["a", "TI"], "3"]}], "\[Pi]"]], " ", 
   FractionBox["1", 
    RowBox[{
     SuperscriptBox[
      StyleBox["x", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["a", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c547f77d-b56a-4e22-bb6c-97d3d438f6ea"],
 " integrates to ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c246bc2-ebc4-4b09-8b55-998ee5948a09"],
 ":"
}], "Text",ExpressionUUID->"c2ecae95-9c49-4a55-8972-31ded91a0e57"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"\[Phi]", "[", "x", "]"}], "/", 
    RowBox[{"Sqrt", "[", "norm2", "]"}]}]}], ";"}], "\n", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], "^", "2"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"a", " ", ">", " ", "0"}]}]}], "]"}]}], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"5f571e46-91bf-48f3-9062-b6292e9e8cd7"],

Cell[TextData[{
 "As expected, the result is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9267bd5f-6f9b-4e74-ac86-83e7be8c61fc"],
 ": the normalized Lorentzian carries exactly unit probability, with a width \
set by ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad2bee18-85d6-4674-bb96-297fd74c94ab"],
 ". Now the opposite case. Compute the total probability of a plane wave ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "k", "x"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6ece016-13db-40b6-bd55-a83078b0258b"],
 ", whose density ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fea5ab7-c118-46cc-b759-e848f83a4557"],
 " is the same at every point:"
}], "Text",ExpressionUUID->"c21bd862-9069-43da-8bff-7a25b1baef5c"],

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"Exp", "[", 
      RowBox[{"I", " ", "k", " ", "x"}], "]"}], "]"}], "^", "2"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "x"}], "}"}], ",", " ", "Reals"}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"fe182379-7000-4572-b220-e24e34785d06"],

Cell[TextData[{
 "The integral diverges to ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e6506a-f581-4c17-a2d1-694a3a137555"],
 ": a momentum eigenstate cannot be normalized to unity at all. It lives \
outside ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["L", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c81118a-9091-4628-add7-9e478b64d221"],
 ", and the most one can do is normalize it to a Dirac delta in the momentum \
label."
}], "Text",ExpressionUUID->"1cee26ac-8026-453f-a6cd-01bff97642ac"],

Cell[TextData[{
 "1.3 [BSc] How do I compute the Born-rule probability ",
 Cell[BoxData[
  RowBox[{
   UnderoverscriptBox["\[Integral]", 
    StyleBox["a", "TI"], 
    StyleBox["b", "TI"],
    LimitsPositioning->False], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a496ce41-9658-460f-8efd-8b4630034783"],
 " of finding the particle in a region?"
}], "Subsection",ExpressionUUID->"2964d8ce-851a-4451-a006-7f8f91697a4d"],

Cell[TextData[{
 "The Born rule gives the probability of finding the particle in a window ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb502411-2f5d-41f2-9fd1-e7708c6fe7f8"],
 " as the integral of the density there, ",
 Cell[BoxData[
  RowBox[{
   UnderoverscriptBox["\[Integral]", 
    StyleBox["a", "TI"], 
    StyleBox["b", "TI"],
    LimitsPositioning->False], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3f77912-0124-40b1-856c-0e3150c036dc"],
 ". Take the sinc state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["x", "TI"]}], 
    RowBox[{
     StyleBox["x", "TI"], 
     SqrtBox["\[Pi]"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "008c04c8-4979-4cd5-a6c1-c798b7f9daad"],
 ", the position wavefunction of a particle whose momentum is spread \
uniformly over ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", "1"}], ",", "1"}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eafbcfca-9832-43c9-b69e-05f9d467ff1c"],
 "; it is the Wannier function of the lowest free-electron band, built from \
Bloch waves of uniform weight across the Brillouin zone, and equally the \
single-slit diffraction amplitude."
}], "Text",ExpressionUUID->"71fcd639-5c9d-47d6-86e4-1d37671af343"],

Cell[TextData[{
 "For a windowed integral to be a probability at all, the state must first \
carry unit total probability. Confirm ",
 Cell[BoxData[
  RowBox[{
   UnderoverscriptBox["\[Integral]", 
    RowBox[{"-", "\[Infinity]"}], "\[Infinity]",
    LimitsPositioning->False], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80805bee-8342-42dd-b58b-afa5ea073f0c"],
 ":"
}], "Text",ExpressionUUID->"86ef5c71-6624-43af-82b7-721a6a1b922f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"x", " ", 
      RowBox[{"Sqrt", "[", "Pi", "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], "^", "2"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"9c76c3fa-5227-46ab-be0d-b7bd5f257d41"],

Cell[TextData[{
 "The total norm is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c9ec2f3-ce60-439a-b49f-0cbfb18d3729"],
 "; the ",
 Cell[BoxData[
  SqrtBox["\[Pi]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03814fd6-0187-4451-a6f6-fd2648304c11"],
 " in the denominator is there precisely because ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["x", "TI"], "/", 
      StyleBox["x", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "=", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79540d1c-4b51-464a-a411-612d4ea56c1c"],
 ". Now compute the probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{GridBox[{
      {
       StyleBox["x", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "<", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   UnderoverscriptBox["\[Integral]", 
    RowBox[{"-", 
     StyleBox["b", "TI"]}], 
    StyleBox["b", "TI"],
    LimitsPositioning->False], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09d87df6-61ae-4294-ba24-7f61504515ec"],
 " of finding the particle within ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9b4814c-ea4a-471d-8108-3188aae13317"],
 " of the origin:"
}], "Text",ExpressionUUID->"2ee71dd9-a489-450c-9de1-1e31ee064c9d"],

Cell[BoxData[
 RowBox[{"P", " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], "^", "2"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", 
      RowBox[{"-", "b"}], ",", " ", "b"}], "}"}], ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{"b", " ", ">", " ", "0"}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"54662ecb-6053-4596-8275-f82197ef9b2c"],

Cell[TextData[{
 "The probability is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["b", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    RowBox[{"-", "1", "+", 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", "2", 
     StyleBox["b", "TI"], "+", "2", 
     StyleBox["b", "TI"], " ", 
     StyleBox["Si",
      FontSlant->"Plain"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"2", 
      StyleBox["b", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{
     StyleBox["b", "TI"], " ", "\[Pi]"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b3bb786-35c5-4c0c-b69a-7106061bb27e"],
 ", where ",
 Cell[BoxData[
  StyleBox["Si",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e25cebc6-f656-418e-8a11-652653f3a131"],
 " is the sine integral. Cross-check this closed form against a direct \
numerical integral at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["b", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd8438cc-e2e6-499e-9c25-b25583aab302"],
 ":"
}], "Text",ExpressionUUID->"c612da90-acb3-4911-8c0a-0440e650bf29"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"P", " ", "/.", " ", 
    RowBox[{"b", " ", "->", " ", "3"}]}], ",", " ", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], "^", "2"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "3"}], ",", " ", "3"}], "}"}]}], "]"}]}], "}"}]], "Input",\

 CellLabel->
  "In[15]:= ",ExpressionUUID->"b7224868-c60f-4976-b8b4-b38212c02056"],

Cell[TextData[{
 "The symbolic and numeric values agree. A probability must swallow \
everything as the window opens and nothing as it closes; verify ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], "\[Rule]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "917c404c-67f5-4d82-a1bb-fcd718a6f485"],
 " as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["b", "TI"], "\[Rule]", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6bc6a47-0183-4c29-88c8-e59ffea7f8ef"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d80d3f2-5062-4fbd-b2d4-155ac4943fbe"],
 " as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["b", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b56dd7d6-13a8-4175-9fae-f0f89e28c8cc"],
 ":"
}], "Text",ExpressionUUID->"05edcc3b-208e-4c64-bfaa-b722ad63614f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Limit", "[", 
    RowBox[{"P", ",", " ", 
     RowBox[{"b", " ", "->", " ", "Infinity"}]}], "]"}], ",", " ", 
   RowBox[{"Limit", "[", 
    RowBox[{"P", ",", " ", 
     RowBox[{"b", " ", "->", " ", "0"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"1ebbdddb-5533-4d92-9c19-912129e39414"],

Cell[TextData[{
 "The limits are ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b46670b3-0d00-46fa-99cb-976482a541d2"],
 " and ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b90e88d5-1ad2-431b-a97a-399059ef01e3"],
 ", exactly as a probability demands. Unlike a state with exponential tails, \
the sinc decays only as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9afff8a8-f166-4752-8585-694750d0eae7"],
 ", so its density has long oscillatory tails and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["b", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dac64b2-80cc-4228-af4c-c25f71a15441"],
 " approaches ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ac7761a-7621-44b3-8204-0f4466ebbf5d"],
 " slowly (through the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Si",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[Rule]", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d6d9aa5-793a-4749-89f6-2bff8f6f5721"],
 " term). That slow approach is the price of the sharp momentum cutoff: \
confining momentum to a box smears position out into a ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53c5f3ba-9641-4dc7-ac5c-c65bbc4018e1"],
 " tail."
}], "Text",ExpressionUUID->"bc615576-5af6-4131-bc28-f288d04e877d"],

Cell[TextData[{
 "1.4 [BSc] How do I compute the inner product ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Phi]", "TI"], 
     StyleBox["\[Psi]", "TI"]},
    "BraKet"], "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["\[Phi]", "TI"], "*"], 
   StyleBox["\[Psi]", "TI"], 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1fcd45a-bf99-4f2b-8aab-097f6ebe12c4"],
 ", its modulus, and the transition probability ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["\[Phi]", "TI"], 
        StyleBox["\[Psi]", "TI"]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bab174aa-eb99-408a-a708-2d3b4301f8ad"],
 "?"
}], "Subsection",ExpressionUUID->"cf27f8ff-1e1c-4d97-980c-f1574e9d43fa"],

Cell[TextData[{
 "The overlap of two states is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["\[Phi]", "TI"], "*"], 
   StyleBox["\[Psi]", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee59a529-492d-4214-b704-31b2f0aef4c5"],
 "; its squared modulus is the probability that a system prepared as ",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da0ed662-1006-4184-ae97-4c1b7a4cdd17"],
 " is found in ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3465c43-5ee8-4535-90bf-96eaa3d4f746"],
 ". We take the state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "2", 
   SuperscriptBox[
    StyleBox["\[Kappa]", "TI"], 
    RowBox[{"3", "/", "2"}]], 
   StyleBox["x", "TI"], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Kappa]", "TI"], 
     StyleBox["x", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40ac699b-4e46-466c-95f9-cefcf8d9c116"],
 " on the half-line, which is the hydrogen ",
 Cell[BoxData[
  RowBox[{"1", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5211fe3e-6a59-44db-984c-90031337f301"],
 " reduced radial ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["r", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["r", "TI"], 
   StyleBox["R", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["r", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc6fd72a-0e0c-4e6a-9ddf-1e7d22eb7a93"],
 ". That claim is earned by the radial equation: confirm ",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a40e259-5a99-41dc-b788-390134071570"],
 " solves the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["l", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09c28223-c52e-4e8c-8971-bf9d475dfbfe"],
 " Coulomb radial equation ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox["1", "2"], 
   SuperscriptBox[
    StyleBox["\[Psi]", "TI"], "\[DoublePrime]"], "-", 
   FractionBox[
    StyleBox["\[Kappa]", "TI"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[Psi]", "TI"], "=", 
   StyleBox["E", "TI"], 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9a7ae6b-0573-4ec9-ad7d-5c03149c0244"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", "-", 
   SuperscriptBox[
    StyleBox["\[Kappa]", "TI"], "2"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bef67b15-a64c-4085-8a0c-4f801cf8e783"],
 ":"
}], "Text",ExpressionUUID->"6370efda-ca00-4fa1-af62-fb615eec3e40"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"\[Kappa]", "^", 
     RowBox[{"(", 
      RowBox[{"3", "/", "2"}], ")"}]}], " ", "x", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "\[Kappa]"}], " ", "x"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], " ", 
     RowBox[{
      RowBox[{"\[Psi]", "''"}], "[", "x", "]"}]}], " ", "-", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Kappa]", "/", "x"}], ")"}], " ", 
     RowBox[{"\[Psi]", "[", "x", "]"}]}], " ", "-", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"\[Kappa]", "^", "2"}]}], "/", "2"}], ")"}], " ", 
     RowBox[{"\[Psi]", "[", "x", "]"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"\[Kappa]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"x", " ", ">", " ", "0"}]}]}], "]"}]}], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"6a85b411-4ab1-4668-9a09-ecc994e924d5"],

Cell[TextData[{
 "The residual is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79c1e5ef-dcae-4b21-9a4b-4783351ef97c"],
 ", so ",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69cea36a-27e8-4f35-9b0d-b61801d0a3a2"],
 " is the ",
 Cell[BoxData[
  RowBox[{"1", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d660deb1-d7a6-4b54-aefc-76f235118d51"],
 " radial with energy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", "-", 
   SuperscriptBox[
    StyleBox["\[Kappa]", "TI"], "2"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95b882d9-07d1-4f70-9a2a-cbaee25c970c"],
 ", a binding energy of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Kappa]", "TI"], "2"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3516050f-5989-422e-afff-7f3a023517d0"],
 ", where ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd08b028-c636-46b9-bcae-0b8f06bef520"],
 " is the nuclear charge and ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Kappa]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8427687d-383f-4429-9c90-98bc9e93ea4a"],
 " the Bohr radius. Being a bound state, it is normalized on the half-line; \
confirm ",
 Cell[BoxData[
  RowBox[{
   UnderoverscriptBox["\[Integral]", "0", "\[Infinity]",
    LimitsPositioning->False], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d86960c2-9fc9-4428-b46d-ca3afe71f81d"],
 ":"
}], "Text",ExpressionUUID->"b2b56f26-6402-48a5-9dae-a31e665cce4e"],

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], "^", "2"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "0", ",", " ", "Infinity"}], "}"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"\[Kappa]", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"09abbc96-b085-4b77-9930-82cb44e69902"],

Cell[TextData[{
 "The norm is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bdc66a6-005a-4e8a-9181-437428424fa0"],
 ". Now take the ",
 StyleBox["same", "TI"],
 " state after a sudden momentum kick ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31e5a928-38d0-4bfd-9ea6-5059c16b2ede"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Phi]", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "q", "x"}], "TI"]], 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "945bcaef-2fe3-478c-8e67-2ba81087f0db"],
 " (the survival amplitude in the sudden approximation), and compute the \
overlap ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Phi]", "TI"], 
     StyleBox["\[Psi]", "TI"]},
    "BraKet"], "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["\[Phi]", "TI"], "*"], 
   StyleBox["\[Psi]", "TI"], 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e998941-7882-4247-865e-ef7f166bb550"],
 ":"
}], "Text",ExpressionUUID->"95a2d5f1-27e2-4391-bd02-15c9967c5252"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "q", " ", "x"}], "]"}], " ", 
    RowBox[{"\[Psi]", "[", "x", "]"}]}]}], ";"}], "\n", 
 RowBox[{"ovl", " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      RowBox[{"\[Phi]", "[", "x", "]"}], "]"}], " ", 
     RowBox[{"\[Psi]", "[", "x", "]"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "0", ",", " ", "Infinity"}], "}"}], ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{
      RowBox[{"\[Kappa]", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"q", " ", "\[Element]", " ", "Reals"}]}]}]}], "]"}]}]}], "Input",\

 CellLabel->
  "In[19]:= ",ExpressionUUID->"6c91a52e-79b0-4166-8183-7c09650d9f89"],

Cell[TextData[{
 "The overlap is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Phi]", "TI"], 
     StyleBox["\[Psi]", "TI"]},
    "BraKet"], "=", "8", 
   SuperscriptBox[
    StyleBox["\[Kappa]", "TI"], "3"], "/", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"2", 
      StyleBox["\[Kappa]", "TI"], "+", 
      StyleBox["i", "TI"], 
      StyleBox["q", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d718581c-3c0f-40d5-abab-4887187341b6"],
 ", genuinely complex: the phase records the momentum kick. Cross-check it \
against a numerical integral at ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Kappa]", "TI"], "=", "1"}], ",", 
   RowBox[{
    StyleBox["q", "TI"], "=", "2"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe2affe2-15e8-4714-8197-53491a7c86d9"],
 ", where it should equal ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox["1", "4"], "-", 
   FractionBox[
    StyleBox["i", "TI"], "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c6b4e54-f18b-4c47-9fcb-de2ffb99e368"],
 ":"
}], "Text",ExpressionUUID->"e957c100-7cd1-46be-a84c-68d3d886489a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ovl", " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Kappa]", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"q", " ", "->", " ", "2"}]}], "}"}]}], ",", " ", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", 
        RowBox[{"\[Phi]", "[", "x", "]"}], "]"}], " ", 
       RowBox[{"\[Psi]", "[", "x", "]"}]}], " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Kappa]", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"q", " ", "->", " ", "2"}]}], "}"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"809b1c60-324b-4989-8e70-32a10916ee4b"],

Cell[TextData[{
 "The symbolic overlap and the numeric quadrature agree. Read off its modulus \
and the survival probability ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["\[Phi]", "TI"], 
        StyleBox["\[Psi]", "TI"]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4805883c-c405-4c55-92c8-b0430dd4cca4"],
 "; ",
 Cell[BoxData["ComplexExpand"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e6e1e39-9776-4f98-8bf2-1d340eeba481"],
 " pulls the real modulus out of the complex denominator (",
 Cell[BoxData["Simplify"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41187cdc-c13d-4afc-9eef-c18f6c8a80cb"],
 " alone leaves an unreduced ",
 Cell[BoxData["Abs"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d77c327-cbe4-4c92-9545-939561f003e0"],
 "):"
}], "Text",ExpressionUUID->"ccdfdb8c-f7be-4863-8fa5-6a1cc1a7a110"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Abs", "[", "ovl", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"Abs", "[", "ovl", "]"}], "^", "2"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"\[Kappa]", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"e67e0ede-f17b-4f22-bb3a-a946ee92a394"],

Cell[TextData[{
 "The modulus is ",
 Cell[BoxData[
  RowBox[{"8", 
   SuperscriptBox[
    StyleBox["\[Kappa]", "TI"], "3"], "/", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"4", 
      SuperscriptBox[
       StyleBox["\[Kappa]", "TI"], "2"], "+", 
      SuperscriptBox[
       StyleBox["q", "TI"], "2"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{"3", "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47d33cf1-0453-48d1-9e97-ec54e6d6d2d1"],
 " and the survival probability ",
 Cell[BoxData[
  RowBox[{"64", 
   SuperscriptBox[
    StyleBox["\[Kappa]", "TI"], "6"], "/", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"4", 
      SuperscriptBox[
       StyleBox["\[Kappa]", "TI"], "2"], "+", 
      SuperscriptBox[
       StyleBox["q", "TI"], "2"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "251adce0-2ef6-4f34-94b6-223bf812f00d"],
 ". Confirm the hard-kick falloff by expanding the survival probability at \
large ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5d09051-fc72-4e37-b2f4-216912ef5fd7"],
 ":"
}], "Text",ExpressionUUID->"f157dbbb-813a-4f04-9cdd-f02be0f594b8"],

Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"64", " ", 
    RowBox[{
     RowBox[{"\[Kappa]", "^", "6"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", " ", 
         RowBox[{"\[Kappa]", "^", "2"}]}], " ", "+", " ", 
        RowBox[{"q", "^", "2"}]}], ")"}], "^", "3"}]}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"q", ",", " ", "Infinity", ",", " ", "6"}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"0aa13e06-c549-4c33-aac8-516cc3f683a9"],

Cell[TextData[{
 "The leading term is ",
 Cell[BoxData[
  RowBox[{"64", 
   SuperscriptBox[
    StyleBox["\[Kappa]", "TI"], "6"], "/", 
   SuperscriptBox[
    StyleBox["q", "TI"], "6"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bef5f938-3169-42b1-8b7a-a37fbc9f4b39"],
 ": a kick much larger than the orbital momentum scale ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a666bdf7-4172-4a30-a304-bf62b3f85b97"],
 " ",
 StyleBox["leaves", "TI"],
 " the electron in its initial state with probability only ",
 Cell[BoxData[
  RowBox[{"\[Tilde]", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["\[Kappa]", "TI"], "/", 
      StyleBox["q", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "6"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8eaccae-4328-4ef6-aa92-2b6c30a270d8"],
 ", so it is almost certainly knocked out, with ejection probability ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   StyleBox["O", "TI"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["\[Kappa]", "TI"], "/", 
      StyleBox["q", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "6"], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc106ea6-ce8f-4786-89f6-ce089f1b990e"],
 ". What this computes is a one-dimensional overlap of a half-line state with \
its own momentum-shifted copy, the sudden-approximation survival amplitude \
for a kick of momentum ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f973789b-7848-4e67-97cd-f700b22abb61"],
 ". It is not the atomic form factor, which lives in three dimensions and \
carries an angular integration that produces ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"q", "r"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"q", "r"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54313073-239f-4b3a-b6e3-89fb3c5cfc1b"],
 " in place of the plane wave used here, and which falls off faster as a \
result."
}], "Text",ExpressionUUID->"877b87a9-b8c3-4acf-b17a-c5d1424f2410"],

Cell[TextData[{
 "1.5 [BSc] How do I compute the position expectation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be504c8a-489e-43c9-8ac7-d4e7c719078f"],
 " and the spread ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SuperscriptBox[
      StyleBox["x", "TI"], "2"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1], "-", 
     SuperscriptBox[
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       StyleBox["x", "TI"], "\[VeryThinSpace]", 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05119781-b5b2-4586-a657-2b8ca44f0dd1"],
 "?"
}], "Subsection",ExpressionUUID->"2a520749-9217-43ab-8e40-d86f1f94cac6"],

Cell[TextData[{
 "The mean position is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   StyleBox["x", "TI"], " ", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c51b848-f667-4b10-baaa-ecd3bf18bf80"],
 " and the spread is the root-variance of that distribution. Take the first \
excited state of the harmonic oscillator, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox["4", "\[Pi]"], ")"}], 
    RowBox[{"1", "/", "4"}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], "-", 
    SubscriptBox[
     StyleBox["x", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["x", "TI"], "-", 
        SubscriptBox[
         StyleBox["x", "TI"], "0"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "016c53f5-e632-4c70-9f7b-f927a838f5fe"],
 ", centered at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["x", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d842c05-36db-4404-9a8d-587cf618597f"],
 ". It is a Hermite function with a single node at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["x", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6eb26345-ab87-4f2e-97cb-5266aca1a91d"],
 ", not a Gaussian, and its density is a symmetric double hump about ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["x", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb2764c7-a7e5-46a0-a3e0-177de8165a3d"],
 "."
}], "Text",ExpressionUUID->"cd26eb88-9da5-4e20-925d-376f3d89500e"],

Cell[TextData[{
 "Every expectation is an average against ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      StyleBox["\[Psi]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4b991b5-a559-4b0d-a3e3-dfdb6da525c1"],
 ", so it is meaningful only for a normalized state. Confirm ",
 Cell[BoxData[
  RowBox[{
   UnderoverscriptBox["\[Integral]", 
    RowBox[{"-", "\[Infinity]"}], "\[Infinity]",
    LimitsPositioning->False], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27afa3c1-d7e9-4e06-b1ed-b8a402bd1ec1"],
 ":"
}], "Text",ExpressionUUID->"2ca82ccb-a3ba-4474-af45-930347a2c9ed"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"4", "/", "Pi"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"1", "/", "4"}], ")"}]}], " ", 
    RowBox[{"(", 
     RowBox[{"x", " ", "-", " ", "x0"}], ")"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", " ", "-", " ", "x0"}], ")"}], "^", "2"}]}], "/", "2"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], "^", "2"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"x0", " ", "\[Element]", " ", "Reals"}]}]}], "]"}]}], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"c3c2fa64-1d71-4712-ba28-7e48e9dafc13"],

Cell[TextData[{
 "The norm is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "286da8da-1ab0-40f3-95fc-b5e4635c18cb"],
 ", so the averages need no denominator. Compute the mean position ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   StyleBox["x", "TI"], " ", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5a909d1-9d69-482d-83a0-54c3bd509da7"],
 ":"
}], "Text",ExpressionUUID->"7bf7dcfc-e041-48c9-b1fe-5cc6d267e321"],

Cell[BoxData[
 RowBox[{"mx", " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"x", " ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], "^", "2"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", 
      RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{"x0", " ", "\[Element]", " ", "Reals"}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"78eca379-d175-4a80-b4eb-8f7687e932c7"],

Cell[TextData[{
 "The mean is ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["x", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b867e434-c73e-4c6d-9660-cc39a986b0b7"],
 ": the node sits at the center and the two humps balance. Compute the second \
moment ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7eef2c65-31ce-4e5b-90b3-736dd9fc867f"],
 ":"
}], "Text",ExpressionUUID->"47258db4-9e43-407a-91b0-6393b0e73302"],

Cell[BoxData[
 RowBox[{"mx2", " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "^", "2"}], " ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], "^", "2"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", 
      RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{"x0", " ", "\[Element]", " ", "Reals"}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"162f5253-8f49-48b4-890f-d6a350bf92dd"],

Cell[TextData[{
 "It is ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["x", "TI"], "0", "2"], "+", 
   FractionBox["3", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc67cc9d-dbfb-4e5b-9af5-0cc640b8618a"],
 ". Cross-check that closed form against a numerical integral at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], "0"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5e32c96-dfed-47b3-b83b-926b716cc242"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   FractionBox["3", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec2f3869-5f8c-49c9-96d6-188f1a2a5411"],
 ":"
}], "Text",ExpressionUUID->"790b11d2-5115-441e-9edb-f2f2b734853e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"mx2", " ", "/.", " ", 
    RowBox[{"x0", " ", "->", " ", "0"}]}], ",", " ", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], "^", "2"}]}], " ", "/.", 
      " ", 
      RowBox[{"x0", " ", "->", " ", "0"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"ba81eee0-475c-4c29-a29e-7c441555906d"],

Cell[TextData[{
 "The symbolic and numeric second moments agree. The spread is ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SuperscriptBox[
      StyleBox["x", "TI"], "2"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1], "-", 
     SuperscriptBox[
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       StyleBox["x", "TI"], "\[VeryThinSpace]", 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba478b42-e8d6-4842-9ea3-efe03ff38023"],
 ":"
}], "Text",ExpressionUUID->"3dc5ca27-f5e2-4d8f-a5ff-1212e1347ed2"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Sqrt", "[", 
    RowBox[{"mx2", " ", "-", " ", 
     RowBox[{"mx", "^", "2"}]}], "]"}], ",", " ", 
   RowBox[{"x0", " ", "\[Element]", " ", "Reals"}]}], "]"}]], "Input",
 CellLabel->
  "In[27]:= ",ExpressionUUID->"82b1e6ec-8ff6-4fe7-93af-748035fc2d1d"],

Cell[TextData[{
 "The spread is ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"], "=", 
   SqrtBox[
    RowBox[{"3", "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bdf46532-91ee-4457-9e4a-85ca90c8050a"],
 ", larger than the ground state's ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"1", "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aac944f4-0699-4533-a8f3-181e25b1971a"],
 " because the node pushes probability outward into the two humps. This is \
the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb98ab71-fbcb-4206-9377-1baa4d736f6b"],
 " case of the oscillator law ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["n", "TI"], "+", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3096359e-3929-4e90-823f-020ff5aca717"],
 ". Rather than assert that law, widen from this single state to the whole \
Hermite ladder ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["\[Psi]", "TI"], 
     StyleBox["n", "TI"]], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["x", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         SuperscriptBox["2", 
          StyleBox["n", "TI"]], " ", 
         StyleBox["n", "TI"]}], "!"}], " ", 
       SqrtBox["\[Pi]"]}], ")"}], 
     RowBox[{"-", "1", "/", "2"}]], 
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["n", "TI"]], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["x", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], " ", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SuperscriptBox[
       StyleBox["x", "TI"], "2"], "/", "2"}]]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b568eae5-83cf-41a1-98e9-cca20f345764"],
 " and read off the second moment for the first few ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ca3a583-7b68-48dd-a1c1-daa130fdde22"],
 " at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], "0"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "936ca270-2a1c-4305-b8e2-f63d86370193"],
 ":"
}], "Text",ExpressionUUID->"76035533-46bd-489b-96ea-f53b264d6eaa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]n", "[", 
    RowBox[{"x_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "^", "n"}], " ", 
       RowBox[{"n", "!"}], " ", 
       RowBox[{"Sqrt", "[", "Pi", "]"}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}], ")"}]}], " ", 
    RowBox[{"HermiteH", "[", 
     RowBox[{"n", ",", " ", "x"}], "]"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"x", "^", "2"}]}], "/", "2"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "^", "2"}], " ", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"\[Psi]n", "[", 
         RowBox[{"x", ",", " ", "n"}], "]"}], "]"}], "^", "2"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], "]"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"b645249c-1489-4584-8dd0-0c2e03d3e4f5"],

Cell[TextData[{
 "The moments come out ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    FractionBox["1", "2"], ",", 
    FractionBox["3", "2"], ",", 
    FractionBox["5", "2"], ",", 
    FractionBox["7", "2"]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a9a994e-4712-49f7-8a8a-65732cf0a70c"],
 ", exactly ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "+", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0afdd5f-6ada-4b86-952f-098c7ec585c0"],
 ", so the spread widens as ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["n", "TI"], "+", 
    FractionBox["1", "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4399673-5c10-4cb3-af04-5af1531acd4e"],
 " with every node added. And it is independent of where the state sits: \
shifting ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["x", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cee2ec2-b1e7-423b-94c9-4222d8dcb38f"],
 " moves the mean but leaves the shape, and so ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8183a3b-843b-4cc2-a97c-b7e24d8da032"],
 ", untouched."
}], "Text",ExpressionUUID->"80aa2efc-b853-494f-9974-e3a002a46304"],

Cell[TextData[{
 "1.6 [BSc] How do I compute the probability current density ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d8bea69-4ec5-476d-bf29-325a0a69bab5"],
 " and verify the continuity equation ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[PartialD]", 
    StyleBox["t", "TI"]], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "+", 
   SubscriptBox["\[PartialD]", 
    StyleBox["x", "TI"]], 
   StyleBox["j", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cae96c8-c54e-4a46-9cf3-08e3032eac0d"],
 "?"
}], "Subsection",ExpressionUUID->"bd5d950f-d473-4efa-9a6b-699b385cad7e"],

Cell[TextData[{
 "Probability is locally conserved: the density's rate of change is minus the \
divergence of the current ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", 
   FractionBox["1", 
    RowBox[{"2", 
     StyleBox["i", "TI"]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Psi]", "TI"], "*"], 
    SubscriptBox["\[PartialD]", 
     StyleBox["x", "TI"]], 
    StyleBox["\[Psi]", "TI"], "-", 
    StyleBox["\[Psi]", "TI"], " ", 
    SubscriptBox["\[PartialD]", 
     StyleBox["x", "TI"]], 
    SuperscriptBox[
     StyleBox["\[Psi]", "TI"], "*"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33c598ab-e61a-4bfe-b2a9-9c51b8dad685"],
 " (with ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", 
   StyleBox["m", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e846f35-9a71-4941-be36-5f9e84cda8b4"],
 "). Its two terms are complex conjugates of each other, so equivalently ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", 
   StyleBox["Im",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Psi]", "TI"], "*"], 
    SubscriptBox["\[PartialD]", 
     StyleBox["x", "TI"]], 
    StyleBox["\[Psi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25e1fd74-0b99-4a69-a8db-aa2b16bed823"],
 "."
}], "Text",ExpressionUUID->"0c846175-3af2-4811-850c-e8ad86ff016a"],

Cell[TextData[{
 "The cleanest place to see the current at work is an ordinary normalizable \
state that actually moves. Take a particle in an infinite well ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    StyleBox["L", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e027954-eaa0-4632-8f6d-7fe9593df44c"],
 " in an equal superposition of the ground and first excited levels, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", 
    SqrtBox["2"]], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   SubscriptBox[
    StyleBox["\[Chi]", "TI"], "1"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["E", "TI"], "1"], 
     StyleBox["t", "TI"]}]], "+", 
   SubscriptBox[
    StyleBox["\[Chi]", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["E", "TI"], "2"], 
     StyleBox["t", "TI"]}]], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b3086f5-cc25-4071-81b3-a2bc7064ef76"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Chi]", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SqrtBox[
    RowBox[{"2", "/", 
     StyleBox["L", "TI"]}]], " ", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["n", "TI"], "\[Pi]", 
    StyleBox["x", "TI"], "/", 
    StyleBox["L", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d284ca3b-744c-4a99-b974-decf857607f3"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"]], "=", 
   SuperscriptBox[
    StyleBox["n", "TI"], "2"], 
   SuperscriptBox["\[Pi]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SuperscriptBox[
     StyleBox["L", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71037d43-5007-4283-9913-3a94c2a79f04"],
 ": two stationary states beating against each other. Confirm it is a bona \
fide state, ",
 Cell[BoxData[
  RowBox[{
   UnderoverscriptBox["\[Integral]", "0", 
    StyleBox["L", "TI"],
    LimitsPositioning->False], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6da9c2ee-f375-43fb-809a-920e57c10471"],
 ":"
}], "Text",ExpressionUUID->"142e9eee-5e06-4c43-a06c-eab0354475c9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Chi]", "[", 
    RowBox[{"n_", ",", " ", "x_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", "/", "L"}], "]"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"n", " ", "Pi", " ", 
      RowBox[{"x", "/", "L"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"En", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"n", "^", "2"}], " ", 
    RowBox[{
     RowBox[{"Pi", "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"L", "^", "2"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", 
    RowBox[{"x_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Chi]", "[", 
        RowBox[{"1", ",", " ", "x"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "I"}], " ", 
         RowBox[{"En", "[", "1", "]"}], " ", "t"}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"\[Chi]", "[", 
        RowBox[{"2", ",", " ", "x"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "I"}], " ", 
         RowBox[{"En", "[", "2", "]"}], " ", "t"}], "]"}]}]}], ")"}], "/", 
    RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}], "\n", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{"x", ",", " ", "t"}], "]"}], "]"}], "^", "2"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "0", ",", " ", "L"}], "}"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{
     RowBox[{"L", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"t", " ", "\[Element]", " ", "Reals"}]}]}]}], "]"}]}], "Input",
 CellLabel->
  "In[29]:= ",ExpressionUUID->"25bd9630-aa6d-44fb-bc1b-111fdeefb79b"],

Cell[TextData[{
 "The norm is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7842b853-933b-4e15-b8d5-2d55a7087630"],
 ", with no caveats about tails or convergence. Read off the density ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab45bc2a-2a40-4c15-92a8-e35a0993644c"],
 ", using ",
 Cell[BoxData["ComplexExpand"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebe089a9-fc11-4d4b-b0a8-99d4c6f711b9"],
 " to turn the modulus of the complex superposition into real trigonometric \
form (it treats ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], ",", 
   StyleBox["t", "TI"], ",", 
   StyleBox["L", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39c62366-11a7-4bbf-8c7e-73ddfd951e40"],
 " as real):"
}], "Text",ExpressionUUID->"eb060ca3-d5f5-48ab-ba6e-dafa42d6bf3a"],

Cell[BoxData[
 RowBox[{"dens", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"ComplexExpand", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"\[Psi]", "[", 
        RowBox[{"x", ",", " ", "t"}], "]"}], "]"}], "^", "2"}], "]"}], ",", 
    " ", 
    RowBox[{"L", " ", ">", " ", "0"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[30]:= ",ExpressionUUID->"628eda38-d028-421e-a646-e8591ab27f94"],

Cell[TextData[{
 "The two stationary pieces interfere through a cross term oscillating at the \
beat frequency ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "2"], "-", 
   SubscriptBox[
    StyleBox["E", "TI"], "1"], "=", "3", 
   SuperscriptBox["\[Pi]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SuperscriptBox[
     StyleBox["L", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8af02ea-c04f-43fd-baea-fc2d49994068"],
 ": the probability sloshes from one side of the well to the other. That \
sloshing is exactly what the current reports. Compute ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", 
   StyleBox["Im",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Psi]", "TI"], "*"], 
    SubscriptBox["\[PartialD]", 
     StyleBox["x", "TI"]], 
    StyleBox["\[Psi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "123f9bee-8a38-4157-9f67-8e307f99c100"],
 ":"
}], "Text",ExpressionUUID->"c9ab936d-4ab2-4dd6-8ebf-1279f95e7540"],

Cell[BoxData[
 RowBox[{"j", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Im", "[", 
     RowBox[{
      RowBox[{"Conjugate", "[", 
       RowBox[{"\[Psi]", "[", 
        RowBox[{"x", ",", " ", "t"}], "]"}], "]"}], " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Psi]", "[", 
         RowBox[{"x", ",", " ", "t"}], "]"}], ",", " ", "x"}], "]"}]}], "]"}],
     ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"L", " ", ">", " ", "0"}], ",", " ", 
      RowBox[{"Element", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "t"}], "}"}], ",", " ", "Reals"}], "]"}]}], 
     "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[31]:= ",ExpressionUUID->"8c3cfaa1-a942-46ca-9343-1b3d46a3c6cc"],

Cell[TextData[{
 "The current is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", 
   FractionBox[
    RowBox[{"2", "\[Pi]"}], 
    SuperscriptBox[
     StyleBox["L", "TI"], "2"]], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   FractionBox[
    RowBox[{"3", 
     SuperscriptBox["\[Pi]", "2"], 
     StyleBox["t", "TI"]}], 
    RowBox[{"2", 
     SuperscriptBox[
      StyleBox["L", "TI"], "2"]}]], 
   StyleBox[")",
    FontSize->1.2 Inherited], 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "3"], "\[ThinSpace]", "\[NegativeThinSpace]", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   FractionBox[
    RowBox[{"\[Pi]", 
     StyleBox["x", "TI"]}], 
    StyleBox["L", "TI"]], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc329a5b-5b58-497a-a93e-3d05cd9e5365"],
 ": it oscillates in time at the same beat frequency, positive while \
probability flows toward the right wall and negative as it flows back, and it \
vanishes at both walls ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["x", "TI"], "=", "0"}], ",", 
   StyleBox["L", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0c6a53c-6249-44e1-9663-1a326aaa0905"],
 ", so no probability ever leaves the box. Verify continuity ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[PartialD]", 
    StyleBox["t", "TI"]], 
   StyleBox["\[Rho]", "TI"], "+", 
   SubscriptBox["\[PartialD]", 
    StyleBox["x", "TI"]], 
   StyleBox["j", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da3ae448-d90f-4b82-9e50-93f416c422b5"],
 ":"
}], "Text",ExpressionUUID->"645917a5-b96c-44b2-8e7f-7f847cf6541f"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"dens", ",", " ", "t"}], "]"}], " ", "+", " ", 
    RowBox[{"D", "[", 
     RowBox[{"j", ",", " ", "x"}], "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"L", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "t"}], "}"}], ",", " ", "Reals"}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[32]:= ",ExpressionUUID->"11c76ff4-ae52-436b-90f8-ae56c85fac52"],

Cell[TextData[{
 "The residual is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e64e6a2b-f3b9-4413-b703-ecf017a520c1"],
 ": on this everyday normalizable state, the local bookkeeping of density and \
current balances exactly. A single stationary level (drop one term) would \
give a real wavefunction with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "\[Congruent]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f15ca25c-500b-439c-a18c-3d30885d0c40"],
 " and nothing flowing; it is the interference of two levels that sets the \
probability in motion."
}], "Text",ExpressionUUID->"7551ced1-06c9-445e-9f73-c20f16fcc95f"],

Cell[TextData[{
 "A more exotic solution carries the same identity into territory the well \
never reaches. The Berry-Balazs ",
 StyleBox["Airy beam", "TI"],
 " is the exact free-particle solution ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["Ai",
    FontSlant->"Plain"], "\[NegativeThinSpace]", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   StyleBox["x", "TI"], "-", 
   FractionBox[
    SuperscriptBox[
     StyleBox["t", "TI"], "2"], "4"], 
   StyleBox[")",
    FontSize->1.2 Inherited], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["t", "TI"], 
      StyleBox["x", "TI"], "/", "2", "-", 
      SuperscriptBox[
       StyleBox["t", "TI"], "3"], "/", "12"}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9943b8fe-d213-45c9-8025-4868ee39f8d4"],
 ": a wave packet that neither spreads nor decays but ",
 StyleBox["accelerates", "TI"],
 ", its ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["Ai",
    FontSlant->"Plain"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d73630b-dc89-4e45-809e-c4a7672e4a4c"],
 " profile sliding rigidly along the parabola ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3614856d-8b5b-4bda-9cc9-badaaf5bab4d"],
 " with no force acting. It is the quantum cousin of the optical Airy beam \
and has been produced with free electrons."
}], "Text",ExpressionUUID->"166d959b-53a4-43ce-a7aa-9a3c0f51c255"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", 
    RowBox[{"x_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"AiryAi", "[", 
     RowBox[{"x", " ", "-", " ", 
      RowBox[{
       RowBox[{"t", "^", "2"}], "/", "4"}]}], "]"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"t", " ", 
         RowBox[{"x", "/", "2"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"t", "^", "3"}], "/", "12"}]}], ")"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"I", " ", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[Psi]", "[", 
        RowBox[{"x", ",", " ", "t"}], "]"}], ",", " ", "t"}], "]"}]}], " ", "+",
     " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}], " ", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[Psi]", "[", 
        RowBox[{"x", ",", " ", "t"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}]}], ",", " ", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "t"}], "}"}], ",", " ", "Reals"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[33]:= ",ExpressionUUID->"7e16ae58-81f9-4a55-ae7d-316440ba4727"],

Cell[TextData[{
 "The residual is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44607ef3-cba8-4765-8b12-8319354171ff"],
 ": the Airy beam is an exact free-particle solution. Unlike every state \
above, though, it is not square-integrable: its ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["Ai",
    FontSlant->"Plain"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bdc2f454-344a-4b91-9d2c-668901f6199d"],
 " tail decays only as ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      StyleBox["x", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], 
   RowBox[{"-", "1", "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c4d0a03-362f-477e-ab80-38ff5fa975f2"],
 " as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "\[Rule]", "-", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e865fff1-fc44-46b0-94ed-ed633a3ec727"],
 ", so the norm integral diverges. Confirm it does not converge:"
}], "Text",ExpressionUUID->"10adc63e-e7c0-4a52-8bfe-728e2b4f8cac"],

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"AiryAi", "[", "x", "]"}], "^", "2"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[34]:= ",ExpressionUUID->"8fb0b856-0460-498d-b241-113e82a1173e"],

Cell[TextData[{
 "The integral fails to converge (",
 Cell[BoxData[
  RowBox[{"Integrate", "::", "idiv"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82291353-c1b3-41c1-a937-fc7efbcabcf0"],
 "), so the Airy beam lives outside ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["L", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c392be94-df92-4876-a0a4-5ef6781a40e5"],
 ", alongside the plane wave. Its ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      StyleBox["\[Psi]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03fc6c85-f0ae-4986-ba5b-bd824f0101bb"],
 " is therefore an improper density and ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13cb3d50-bdb0-438a-b80f-d06f0ae5375d"],
 " a current of a non-normalizable state, an idealized carrier of probability \
flux rather than a bona fide probability distribution. Continuity, being a \
local identity, still holds pointwise regardless. Read off the density ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      StyleBox["\[Psi]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7bf473e-2517-4e82-903a-c93b81f2f761"],
 ":"
}], "Text",ExpressionUUID->"6118dc89-2b13-4eec-8867-b035fbd8b4ec"],

Cell[BoxData[
 RowBox[{"dens", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"\[Psi]", "[", 
       RowBox[{"x", ",", " ", "t"}], "]"}], "]"}], "^", "2"}], ",", " ", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "t"}], "}"}], ",", " ", "Reals"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[35]:= ",ExpressionUUID->"8daa40f2-946a-48f7-87d5-7bd940715b1d"],

Cell[TextData[{
 "The density is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Ai",
    FontSlant->"Plain"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["x", "TI"], "-", 
      FractionBox[
       SuperscriptBox[
        StyleBox["t", "TI"], "2"], "4"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c33a9fef-515c-4974-981b-e72f360d0afd"],
 ", a fixed Airy profile whose peak slides along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df5da3bf-a686-4da2-ae7a-8f6d5d428ca8"],
 ": the beam accelerates without spreading. Compute the current ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", 
   StyleBox["Im",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Psi]", "TI"], "*"], 
    SubscriptBox["\[PartialD]", 
     StyleBox["x", "TI"]], 
    StyleBox["\[Psi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15127a33-ecbe-46f5-be09-072ae327076b"],
 ":"
}], "Text",ExpressionUUID->"3cf1230e-2e09-45b1-b22e-a1b3b4d75d50"],

Cell[BoxData[
 RowBox[{"j", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Im", "[", 
     RowBox[{
      RowBox[{"Conjugate", "[", 
       RowBox[{"\[Psi]", "[", 
        RowBox[{"x", ",", " ", "t"}], "]"}], "]"}], " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Psi]", "[", 
         RowBox[{"x", ",", " ", "t"}], "]"}], ",", " ", "x"}], "]"}]}], "]"}],
     ",", " ", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "t"}], "}"}], ",", " ", "Reals"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[36]:= ",ExpressionUUID->"4405ce44-e3b8-44d9-b08b-590ae8647f9d"],

Cell[TextData[{
 "The current is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", 
   FractionBox[
    StyleBox["t", "TI"], "2"], 
   StyleBox["Ai",
    FontSlant->"Plain"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["x", "TI"], "-", 
      FractionBox[
       SuperscriptBox[
        StyleBox["t", "TI"], "2"], "4"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], "=", 
   FractionBox[
    StyleBox["t", "TI"], "2"], " ", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b0a81a4-dce3-467a-a5a2-b693c0c8c364"],
 ", the density times the velocity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4af31c3-b907-4c6c-afa4-d9ecfed55e90"],
 ": every point of the profile moves at the same instantaneous speed, so the \
shape is carried rigidly, which is precisely why the beam does not spread. \
Verify continuity ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[PartialD]", 
    StyleBox["t", "TI"]], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "+", 
   SubscriptBox["\[PartialD]", 
    StyleBox["x", "TI"]], 
   StyleBox["j", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65885545-9d92-46be-9421-b612f0571568"],
 ":"
}], "Text",ExpressionUUID->"d2da3a37-e3c4-4019-bc6d-1874e4c1e53c"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"dens", ",", " ", "t"}], "]"}], " ", "+", " ", 
    RowBox[{"D", "[", 
     RowBox[{"j", ",", " ", "x"}], "]"}]}], ",", " ", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "t"}], "}"}], ",", " ", "Reals"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[37]:= ",ExpressionUUID->"cadecbfb-513d-4459-9643-45ea2e9f468c"],

Cell[TextData[{
 "The residual is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bc0b933-d2ec-4c21-80db-3104e0933e62"],
 ": probability is locally conserved. Continuity is not special to this \
state; it follows from the equation of motion for any potential, provided \
that potential is real. Writing ",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47dcb7be-fbe4-4206-a39a-d041e4172cd0"],
 " and ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Psi]", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "171d9118-d639-40fa-a9de-cdcb0072c7d8"],
 " as independent functions ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], ",", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3652365d-db5c-49cd-8827-c26bc59fb7c5"],
 " and imposing ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[PartialD]", 
    StyleBox["t", "TI"]], 
   StyleBox["f", "TI"], "=", 
   FractionBox[
    StyleBox["i", "TI"], "2"], 
   SubsuperscriptBox["\[PartialD]", 
    StyleBox["x", "TI"], "2"], 
   StyleBox["f", "TI"], "-", 
   StyleBox["i", "TI"], 
   StyleBox["V", "TI"], 
   StyleBox["f", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7855393-8b32-40b5-aad7-f94a36cbf280"],
 " together with its conjugate makes the residual vanish for every solution \
at once:"
}], "Text",ExpressionUUID->"d3b14613-5b00-4c11-8320-a942f1c997fb"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"x", ",", " ", "t"}], "]"}], " ", 
        RowBox[{"f", "[", 
         RowBox[{"x", ",", " ", "t"}], "]"}]}], ",", " ", "t"}], "]"}], "\n", 
     "     ", "+", " ", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"x", ",", " ", "t"}], "]"}], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"x", ",", " ", "t"}], "]"}], ",", " ", "x"}], "]"}]}], 
          " ", "-", " ", 
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"x", ",", " ", "t"}], "]"}], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"x", ",", " ", "t"}], "]"}], ",", " ", "x"}], "]"}]}]}],
          ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "I"}], ")"}]}], ",", " ", "x"}], "]"}]}], ")"}], 
   " ", "/.", "\n", "   ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", 
         RowBox[{"0", ",", " ", "1"}], "]"}], "[", "f", "]"}], "[", 
       RowBox[{"x", ",", " ", "t"}], "]"}], " ", "->", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"I", "/", "2"}], ")"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"x", ",", " ", "t"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "-", " ", 
       RowBox[{"I", " ", 
        RowBox[{"V", "[", "x", "]"}], " ", 
        RowBox[{"f", "[", 
         RowBox[{"x", ",", " ", "t"}], "]"}]}]}]}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", 
         RowBox[{"0", ",", " ", "1"}], "]"}], "[", "g", "]"}], "[", 
       RowBox[{"x", ",", " ", "t"}], "]"}], " ", "->", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"I", "/", "2"}], ")"}]}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"x", ",", " ", "t"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", " ", 
       RowBox[{"I", " ", 
        RowBox[{"V", "[", "x", "]"}], " ", 
        RowBox[{"g", "[", 
         RowBox[{"x", ",", " ", "t"}], "]"}]}]}]}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->
  "In[38]:= ",ExpressionUUID->"c11ba5b1-1987-42b1-b635-fdda715029e7"],

Cell[TextData[{
 "The residual is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99bac2d8-3cc5-4f8e-a379-8393766e3496"],
 " for any ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], ",", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83714f27-4bfb-4a2c-8f13-d57b4736e1cf"],
 " and any ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "475cbaed-5d26-4e0c-b5b2-228738f093e5"],
 ", so continuity holds for every state moving in a real potential, the Airy \
beam (with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5759053f-8c9b-46d2-8c2f-e8511acc67a4"],
 ") being one concrete instance. The reality of ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe3dc249-b035-413d-a38b-55b5bfe445ad"],
 " is doing real work here: the two potential terms cancel between ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7b7926c-8a63-4416-b066-e98cf3896833"],
 " and ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657b47e2-4630-47cc-b4e9-159cc3abfdd6"],
 " only because the same ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb6443be-9913-4cfa-9c90-bcb140e18609"],
 " appears in both. Let the potential be absorptive, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], "=", 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["R", "TI"]], "-", 
   StyleBox["i", "TI"], "\[CapitalGamma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "353d1012-6cce-4eac-86aa-d316278f7c7f"],
 ", and the cancellation fails:"
}], "Text",ExpressionUUID->"90dee149-8ae2-42a8-85d8-1d4e972857f2"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"x", ",", " ", "t"}], "]"}], " ", 
        RowBox[{"f", "[", 
         RowBox[{"x", ",", " ", "t"}], "]"}]}], ",", " ", "t"}], "]"}], "\n", 
     "     ", "+", " ", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"x", ",", " ", "t"}], "]"}], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"x", ",", " ", "t"}], "]"}], ",", " ", "x"}], "]"}]}], 
          " ", "-", " ", 
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"x", ",", " ", "t"}], "]"}], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"x", ",", " ", "t"}], "]"}], ",", " ", "x"}], "]"}]}]}],
          ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "I"}], ")"}]}], ",", " ", "x"}], "]"}]}], ")"}], 
   " ", "/.", "\n", "   ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", 
         RowBox[{"0", ",", " ", "1"}], "]"}], "[", "f", "]"}], "[", 
       RowBox[{"x", ",", " ", "t"}], "]"}], " ", "->", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"I", "/", "2"}], ")"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"x", ",", " ", "t"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "-", " ", 
       RowBox[{"I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"VR", "[", "x", "]"}], " ", "-", " ", 
          RowBox[{"I", " ", 
           RowBox[{"\[CapitalGamma]", "[", "x", "]"}]}]}], ")"}], " ", 
        RowBox[{"f", "[", 
         RowBox[{"x", ",", " ", "t"}], "]"}]}]}]}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", 
         RowBox[{"0", ",", " ", "1"}], "]"}], "[", "g", "]"}], "[", 
       RowBox[{"x", ",", " ", "t"}], "]"}], " ", "->", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"I", "/", "2"}], ")"}]}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"x", ",", " ", "t"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", " ", 
       RowBox[{"I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"VR", "[", "x", "]"}], " ", "+", " ", 
          RowBox[{"I", " ", 
           RowBox[{"\[CapitalGamma]", "[", "x", "]"}]}]}], ")"}], " ", 
        RowBox[{"g", "[", 
         RowBox[{"x", ",", " ", "t"}], "]"}]}]}]}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->
  "In[39]:= ",ExpressionUUID->"d14986bd-7699-418c-a9a4-c8821dbff5ab"],

Cell[TextData[{
 "The residual is now ",
 Cell[BoxData[
  RowBox[{"-", "2", "\[CapitalGamma]", " ", 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c0f227-38db-44a5-81b6-8252a0a68a27"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[PartialD]", 
    StyleBox["t", "TI"]], 
   StyleBox["\[Rho]", "TI"], "+", 
   SubscriptBox["\[PartialD]", 
    StyleBox["x", "TI"]], 
   StyleBox["j", "TI"], "=", "-", "2", "\[CapitalGamma]", 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d86a34c-5d28-4421-bd96-c106fe0be134"],
 ": probability drains away at rate ",
 Cell[BoxData[
  RowBox[{"2", "\[CapitalGamma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fde56aa9-f59a-40f6-baf8-e192dff78784"],
 " instead of being conserved. That is not a defect but the design of an \
optical potential, which models absorption out of the channel being described."
}], "Text",ExpressionUUID->"4adf35af-35b0-4ca5-80ee-2847ebaf8ad4"],

Cell[TextData[{
 "1.7 [BSc] How do I represent a state on a discrete spatial grid so that \
integrals become sums, building the bridge from ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["L", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a305ddd-4992-440c-aecf-d8244fa6a8ba"],
 " to the finite vector a computer can hold?"
}], "Subsection",ExpressionUUID->"05953675-a2ab-4672-98bd-319d420268d6"],

Cell[TextData[{
 "Every numerical method replaces ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "310aa1d8-4334-49f9-93a6-fa07c8597c6e"],
 " by its samples and every integral by a Riemann sum ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "\[TildeTilde]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["n", "TI"],
    LimitsPositioning->False], 
   SuperscriptBox[GridBox[{
      {
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], 
        StyleBox["n", "TI"]]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", "\[CapitalDelta]", 
   
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57c926c4-3b5f-4013-a082-6407b1d2c549"],
 ". Take the tent (triangular) state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SqrtBox[
    FractionBox["3", 
     RowBox[{"2", 
      StyleBox["L", "TI"]}]]], "(", 
   RowBox[{"1", "-", 
    FractionBox[GridBox[{
       {
        StyleBox["x", "TI"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], 
     StyleBox["L", "TI"]]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02c909d4-85ed-4b51-b19e-dbe11db55abb"],
 " on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", 
     StyleBox["L", "TI"]}], ",", 
    StyleBox["L", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9501216-e7d5-48b6-aeac-e41272e19a12"],
 " and zero outside, the classic Rayleigh-Ritz variational trial \
wavefunction. It has kinks at the peak ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fccf2656-64f4-488b-a391-4fdde5ebbee4"],
 " and at the two edges ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "\[PlusMinus]", 
   StyleBox["L", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0aa5baa-26f5-48a0-abdd-e2d87999a606"],
 ", exactly the non-smooth features a grid must resolve, and its exact norm \
is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e1e9b54-9168-4c6c-9b52-881dcceab6be"],
 " by construction."
}], "Text",ExpressionUUID->"9d4de070-be81-4780-9a12-fb61826afec9"],

Cell[TextData[{
 "Confirm the exact norm is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72a28ada-9e77-43d2-8e72-34233ac87242"],
 ", then compare it to a Riemann sum over a grid of ",
 Cell[BoxData["4000"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1862dc9-6891-45aa-9c97-237d880740da"],
 " points on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", "1"}], ",", "1"}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4bbedc7-0026-4795-909c-3470f8ba28ca"],
 " (setting ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d2f336c-7442-40f9-b9c3-4fcae4b007fc"],
 "):"
}], "Text",ExpressionUUID->"8ef60953-4070-4d06-ae56-eecca569a92f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"3", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "L"}], ")"}]}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], "/", "L"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exact", " ", "=", " ", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], "^", "2"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "L"}], ",", " ", "L"}], "}"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"L", " ", ">", " ", "0"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grid", " ", "=", " ", 
   RowBox[{"Subdivide", "[", 
    RowBox[{
     RowBox[{"-", "1."}], ",", " ", "1.", ",", " ", "4000"}], "]"}]}], ";", 
  " ", 
  RowBox[{"dx", " ", "=", " ", 
   RowBox[{
    RowBox[{"grid", "[", 
     RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
    RowBox[{"grid", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"exact", ",", " ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"\[Psi]", "[", "grid", "]"}], " ", "/.", " ", 
        RowBox[{"L", " ", "->", " ", "1."}]}], "]"}], "^", "2"}], "]"}], " ", 
    "dx"}]}], "}"}]}], "Input",
 CellLabel->
  "In[40]:= ",ExpressionUUID->"60a5cf6a-5ca2-4a3f-b564-adb483f4b827"],

Cell[TextData[{
 "The exact norm is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5e6107f-5549-462b-b098-0d4416f2012d"],
 ", and the grid sum returns ",
 Cell[BoxData[
  RowBox[{"1.0000", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "461e28b6-7b8d-44ee-b5e8-87ef26d956b0"],
 ", converging to it as the grid is refined. The kinks at ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53fa73cd-95fa-4092-aa3f-a43b5bd89d5b"],
 " and ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   StyleBox["L", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79514ad1-f1a2-4a82-99eb-adc470130120"],
 " cost a little accuracy (the density has corners there), which is why a \
piecewise-linear trial state is a more honest grid test than a smooth bell \
curve: it stresses exactly the corners a real grid struggles with. These tent \
functions are the building blocks of the finite element method, where the \
wavefunction is a sum of them."
}], "Text",ExpressionUUID->"6322b878-65b8-4b13-9591-5fbe739fb7ef"],

Cell[TextData[{
 "1.8 [BSc] How do I show that an overall constant phase is unobservable, \
while the local phase gradient ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[PartialD]", 
    StyleBox["x", "TI"]], 
   StyleBox["arg",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d3481c8-eb22-4f53-b9c1-0cf14b164ffe"],
 " carries the current (the velocity field)?"
}], "Subsection",ExpressionUUID->"cb2d9126-b57a-41cf-b6c2-99c0a015f601"],

Cell[TextData[{
 "A global phase ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "\[Alpha]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a002594-20de-498c-b753-eb51dde9f6a9"],
 " cancels in ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      StyleBox["\[Psi]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fdee5e38-cbef-4060-be36-359ca9a2d79a"],
 " and every expectation value, so it is pure gauge. A ",
 StyleBox["position-dependent", "TI"],
 " phase is physical: its gradient is the local velocity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], "=", 
   StyleBox["j", "TI"], "/", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cdf17de-46a8-4346-9102-99089d4dea8e"],
 ". Take the chirped packet ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", 
    SqrtBox["2"]], 
   StyleBox["sech",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["\[Beta]", "TI"], 
     SuperscriptBox[
      StyleBox["x", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31253e8f-61dd-4df9-877b-32c4b01cad55"],
 ", whose phase ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Beta]", "TI"], 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af2b12d5-85c6-40bc-b9bb-bd741ee177a1"],
 " varies across the profile."
}], "Text",ExpressionUUID->"b8a8296a-8ff4-4137-93a4-07f65349224e"],

Cell[TextData[{
 "First, confirm a global phase ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "\[Alpha]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10c1c845-e64b-44db-b7bb-69e4b863d6b2"],
 " leaves the density unchanged:"
}], "Text",ExpressionUUID->"9640de56-f1fe-4aa4-8344-cc129372c248"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sech", "[", "x", "]"}], " ", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"I", " ", "\[Beta]", " ", 
       RowBox[{"x", "^", "2"}]}], "]"}], "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "\[Alpha]"}], "]"}], " ", 
       RowBox[{"\[Psi]", "[", "x", "]"}]}], "]"}], "^", "2"}], " ", "-", " ", 
    
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], "^", "2"}]}], ",", " ", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", " ", "\[Beta]", ",", " ", "x"}], "}"}], ",", 
     " ", "Reals"}], "]"}]}], "]"}]}], "Input",
 CellLabel->
  "In[41]:= ",ExpressionUUID->"822312dd-0c95-4ce1-a628-7728a1a311d0"],

Cell[TextData[{
 "The difference is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84fe5923-a10b-4553-a988-1989d4263493"],
 ": the global phase is unobservable. The ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3727e355-f1d2-44dc-9d9c-c3900dc975d4"],
 " prefactor normalizes the state; confirm ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "526b4d06-007b-42d1-9637-6e3b6e932fa0"],
 ":"
}], "Text",ExpressionUUID->"3da19485-00cc-4c51-bf35-0cc31f0a1e89"],

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], "^", "2"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"\[Beta]", " ", "\[Element]", " ", "Reals"}]}]}], "]"}]], "Input",\

 CellLabel->
  "In[42]:= ",ExpressionUUID->"3a708aea-0dd2-4672-96ec-8f86c5b0f9db"],

Cell[TextData[{
 "The norm is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90e6cea6-c712-4d48-bf1b-f15c2a22f4c6"],
 ". Now compute the current, again the imaginary part ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", 
   StyleBox["Im",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Psi]", "TI"], "*"], 
    SubscriptBox["\[PartialD]", 
     StyleBox["x", "TI"]], 
    StyleBox["\[Psi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6077806f-4bcf-497a-8029-44854272685d"],
 ", which the position-dependent phase makes nonzero:"
}], "Text",ExpressionUUID->"4da372fb-0b94-41d7-8234-76864854eb31"],

Cell[BoxData[
 RowBox[{"j", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"Im", "[", 
     RowBox[{
      RowBox[{"Conjugate", "[", 
       RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Psi]", "[", "x", "]"}], ",", " ", "x"}], "]"}]}], "]"}], ",",
     " ", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Beta]", ",", " ", "x"}], "}"}], ",", " ", "Reals"}], 
     "]"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[43]:= ",ExpressionUUID->"79f40df3-ffec-4071-8edd-fef81d6fe718"],

Cell[TextData[{
 "The current is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", 
   StyleBox["\[Beta]", "TI"], 
   StyleBox["x", "TI"], 
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddac5a1d-638b-4d39-9598-f9fc3e012f79"],
 ". Divide by the density to get the local velocity field ",
 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], "=", 
   StyleBox["j", "TI"], "/", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69a94be1-90ce-4364-acfc-5260261a8678"],
 ":"
}], "Text",ExpressionUUID->"e2a1fc88-6631-4b17-aeef-93a12ec112b4"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"j", "/", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], "^", "2"}]}], ",", " ", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Beta]", ",", " ", "x"}], "}"}], ",", " ", "Reals"}], "]"}]}],
   "]"}]], "Input",
 CellLabel->
  "In[44]:= ",ExpressionUUID->"4e1d3944-b5e1-4217-9ccb-c468c298885f"],

Cell[TextData[{
 "The velocity field is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "2", 
   StyleBox["\[Beta]", "TI"], 
   StyleBox["x", "TI"], "=", 
   SubscriptBox["\[PartialD]", 
    StyleBox["x", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Beta]", "TI"], 
    SuperscriptBox[
     StyleBox["x", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c64a5d1e-c74a-41ae-9bba-f46f7e230df3"],
 ", the slope of the local phase. Unlike a plain plane-wave phase ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"k", "x"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8ae0bc9-1491-42a9-9662-831eaf37685b"],
 ", which gives uniform flow, the chirp gives a position-dependent velocity \
growing linearly with ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cda51ff2-2037-4e6a-9c91-ad8a4bc6d70a"],
 ", and its sign decides the fate of the packet. For ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9576487e-c945-4827-a04c-dd3402e68849"],
 " the flow points outward everywhere and the packet spreads; for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], "<", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d700a0f5-76ee-4cf4-a983-c21c520861fa"],
 " it points inward, so the packet focuses, contracting to a waist before \
spreading again, which is free spreading run backwards in time."
}], "Text",ExpressionUUID->"3b90595d-7820-4153-9756-258dee4e1ede"],

Cell[TextData[{
 "1.9 [BSc] How does a Galilean boost transform a wave packet (the boost \
phase factor), and why is ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["x", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40b2ea7c-3300-43db-b40f-f8e896c10829"],
 " unchanged in shape?"
}], "Subsection",ExpressionUUID->"435682e4-06aa-45a2-b4a2-3975cb133fea"],

Cell[TextData[{
 "A Galilean boost to velocity ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b257b2d-680b-4d29-8a70-98360b8c093b"],
 " multiplies a state by the boost phase and shifts its argument, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["v", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["v", "TI"], 
      StyleBox["x", "TI"], "-", 
      SuperscriptBox[
       StyleBox["v", "TI"], "2"], 
      StyleBox["t", "TI"], "/", "2"}], 
     StyleBox[")",
      SpanMaxSize->1]}]], " ", 
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["x", "TI"], "-", 
     StyleBox["v", "TI"], 
     StyleBox["t", "TI"]}], ",", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d057f1f-4d6b-49ee-88f7-1916f7a7e0c8"],
 " (with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2d7dba4-d51a-41e2-8137-8a3b002f5f7f"],
 "). This is the ",
 StyleBox["active", "TI"],
 " boost, which adds ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de01e979-0f04-4f50-bc23-d65bbf0edd59"],
 " to the momentum of the state; viewing that same state from a frame moving \
at ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cfe9eeb-1972-4346-b1f9-91678422caad"],
 " would subtract it instead."
}], "Text",ExpressionUUID->"48cfde4a-fc8d-46b1-992c-5b7a68a1ea4f"],

Cell[TextData[{
 "The content of the statement is that this operation maps solutions to \
solutions. Rather than test that on one packet, impose it on a generic free \
solution ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "360d275f-61e6-4f05-ae64-aa7ebe8abe29"],
 ", replacing every time derivative of ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4913bc4-99b6-4340-97c2-99c279aec043"],
 " by the free Schrodinger equation ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[PartialD]", 
    StyleBox["t", "TI"]], 
   StyleBox["f", "TI"], "=", 
   FractionBox[
    StyleBox["i", "TI"], "2"], 
   SubsuperscriptBox["\[PartialD]", 
    StyleBox["x", "TI"], "2"], 
   StyleBox["f", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b61f2ec7-e649-43e8-80de-595de1b9c13b"],
 ":"
}], "Text",ExpressionUUID->"4ad9169c-de09-402d-9458-debd08fba50f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]B", "[", 
    RowBox[{"x_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"v", " ", "x"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"v", "^", "2"}], " ", 
         RowBox[{"t", "/", "2"}]}]}], ")"}]}], "]"}], " ", 
    RowBox[{"f", "[", 
     RowBox[{
      RowBox[{"x", " ", "-", " ", 
       RowBox[{"v", " ", "t"}]}], ",", " ", "t"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"I", " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Psi]B", "[", 
         RowBox[{"x", ",", " ", "t"}], "]"}], ",", " ", "t"}], "]"}]}], " ", "+",
      " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Psi]B", "[", 
         RowBox[{"x", ",", " ", "t"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}]}], ")"}], " ", "/.", 
   "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Derivative", "[", 
       RowBox[{"0", ",", " ", "1"}], "]"}], "[", "f", "]"}], "[", 
     RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":>", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"I", "/", "2"}], ")"}], " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Derivative", "[", 
        RowBox[{"2", ",", " ", "0"}], "]"}], "[", "f", "]"}], "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}]}]}]}], "]"}]}], "Input",
 CellLabel->
  "In[45]:= ",ExpressionUUID->"28089f0a-bc19-4656-98e7-631ef61aaf61"],

Cell[TextData[{
 "The residual is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1477d784-84c1-462e-b94f-cefbaf3a2520"],
 " for every free solution ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aba4989-d519-4c6f-a0cf-f3fdf7a46a3b"],
 ", so the boosted state solves the same free equation. That is Galilean \
covariance, established once for all states rather than checked on one. Now \
for what the phase does and does not do. Confirm it has unit modulus:"
}], "Text",ExpressionUUID->"d55e5765-d0d0-4a9b-a4c4-e7a247a3d483"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"boost", " ", "=", " ", 
   RowBox[{"Exp", "[", 
    RowBox[{"I", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"v", " ", "x"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"v", "^", "2"}], " ", 
        RowBox[{"t", "/", "2"}]}]}], ")"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", "boost", "]"}], "^", "2"}], ",", " ", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "x", ",", " ", "t"}], "}"}], ",", " ", "Reals"}],
     "]"}]}], "]"}]}], "Input",
 CellLabel->
  "In[46]:= ",ExpressionUUID->"4808b1fa-837b-4d21-ac29-703cf6fec8f8"],

Cell[TextData[{
 "The modulus is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a4062d5-ef73-40fb-ac83-caef5e620e3e"],
 ", so the boost cannot change a density: ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], 
         StyleBox["v", "TI"]], 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         StyleBox["x", "TI"], ",", 
         StyleBox["t", "TI"]}], 
        StyleBox[")",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         RowBox[{
          StyleBox["x", "TI"], "-", 
          StyleBox["v", "TI"], 
          StyleBox["t", "TI"]}], ",", 
         StyleBox["t", "TI"]}], 
        StyleBox[")",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f85998a8-1adf-4b06-9861-1010ee601cb1"],
 ", the density of the boosted solution being the original's carried along at \
speed ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6bdb86e-4d45-4dd7-94a6-0a8e56e155b0"],
 ". A position measurement sees that drift and nothing of the phase. The \
momentum is another matter, and that is where the physics lives. Take a \
snapshot at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d85a5cda-b805-41fe-8244-c4931f36b603"],
 ", where the boost is simply ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "v", "x"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63deb5f9-70a6-449d-bac1-a90386e37c8e"],
 ", and apply it to the harmonic oscillator's first excited state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox["4", "\[Pi]"], ")"}], 
    RowBox[{"1", "/", "4"}]], 
   StyleBox["x", "TI"], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["x", "TI"], "2"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5371465-c94f-486c-8313-04adb12a6e79"],
 ", a packet with internal structure (a node). Compute the mean momentum ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["\[Psi]", "TI"], "*"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", 
    StyleBox["i", "TI"], " ", 
    SubscriptBox["\[PartialD]", 
     StyleBox["x", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["\[Psi]", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5eead8df-dc3a-48e9-9edd-dc75ecbd9d36"],
 " of the un-boosted state:"
}], "Text",ExpressionUUID->"72cf1065-3576-4a83-be34-ce3e25fb757f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"4", "/", "Pi"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"1", "/", "4"}], ")"}]}], " ", "x", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"x", "^", "2"}]}], "/", "2"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Conjugate", "[", 
     RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{"-", "I"}], ")"}], " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"\[Psi]", "[", "x", "]"}], ",", " ", "x"}], "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[47]:= ",ExpressionUUID->"4fa7cc53-8ef0-435b-be23-c6a5892e5017"],

Cell[TextData[{
 "The mean momentum is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c002044b-f100-4939-bea0-6cbdac2e3e43"],
 ": the stationary excited state carries no net current. Now compute ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e877db28-53f8-4903-a66e-4f7b7b632c99"],
 " for the boosted state ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["v", "TI"]], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "v", "x"}], "TI"]], 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7266d433-bcbc-4b97-b0c0-d396d2d00788"],
 ":"
}], "Text",ExpressionUUID->"e4ac1c43-a1ca-4f05-9ada-a6126416418e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]v", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "v", " ", "x"}], "]"}], " ", 
    RowBox[{"\[Psi]", "[", "x", "]"}]}]}], ";"}], "\n", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Conjugate", "[", 
     RowBox[{"\[Psi]v", "[", "x", "]"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{"-", "I"}], ")"}], " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"\[Psi]v", "[", "x", "]"}], ",", " ", "x"}], "]"}]}], ",", " ", 
   
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"v", " ", "\[Element]", " ", "Reals"}]}]}], "]"}]}], "Input",
 CellLabel->
  "In[48]:= ",ExpressionUUID->"61260666-4a2b-47be-a06d-cb808be42d75"],

Cell[TextData[{
 "The mean momentum is exactly ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a97ddc0-dc4e-45f0-8da9-4f2695ef8203"],
 ": the boost adds ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33f6fce3-06a9-443f-a43a-82ef1798357c"],
 " to every momentum component. It shifts the energy too. Compute the \
free-particle energy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["H", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["\[Psi]", "TI"], "*"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", 
    FractionBox["1", "2"], 
    SubsuperscriptBox["\[PartialD]", 
     StyleBox["x", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["\[Psi]", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ea6272e-3c1c-457c-896e-1f104c94898c"],
 " of the un-boosted state:"
}], "Text",ExpressionUUID->"5045462d-a1f5-4b36-af29-967aa0352fba"],

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Conjugate", "[", 
     RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], ")"}], " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"\[Psi]", "[", "x", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[49]:= ",ExpressionUUID->"2c7ac86c-c8ee-4626-a528-62fce9df707f"],

Cell[TextData[{
 "The un-boosted energy is ",
 Cell[BoxData[
  FractionBox["3", "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e280a306-fc17-4f5a-a1ec-bfbd6156773d"],
 ", the kinetic energy of the first excited oscillator profile. Now the \
boosted state:"
}], "Text",ExpressionUUID->"f29e9cc2-5edf-46aa-badc-b1a356d5be30"],

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Conjugate", "[", 
     RowBox[{"\[Psi]v", "[", "x", "]"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], ")"}], " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"\[Psi]v", "[", "x", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"v", " ", "\[Element]", " ", "Reals"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[50]:= ",ExpressionUUID->"9f82d46c-9957-4e82-9e67-0d762d93c0b6"],

Cell[TextData[{
 "The boosted energy is ",
 Cell[BoxData[
  RowBox[{
   FractionBox["3", "4"], "+", 
   FractionBox["1", "2"], 
   SuperscriptBox[
    StyleBox["v", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f041de1-c4a1-4207-8a9b-3ab748a56a2e"],
 ": the boost raises it by exactly ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   SuperscriptBox[
    StyleBox["v", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f61054d-2993-4e97-8844-b85e3b7deb4a"],
 ", the kinetic energy of the added drift. This is the physical content that \
the unit-modulus phase alone cannot show: at a fixed instant ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "v", "x"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f64644b-d1c1-448b-8416-ccda06af5765"],
 " leaves the density identical while adding ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10833acf-91e4-4630-b955-663ab9200753"],
 " to every momentum component and ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   SuperscriptBox[
    StyleBox["v", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae4add04-d913-4ff7-af7f-e523513d140d"],
 " to the energy. A position measurement made then sees nothing at all; a \
momentum measurement sees the entire boost."
}], "Text",ExpressionUUID->"cdf9c692-4301-4af6-a408-795755eb54b3"],

Cell["\<\
Part 2. Operators, position and momentum, and the Fourier bridge\
\>", "Section",ExpressionUUID->"43dc9fe1-ee6f-425a-aad6-906425eaaaec"],

Cell[TextData[{
 "In the position representation the observables are operators on ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["L", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6368830d-a8be-41d6-b8ed-9b03f4d584e4"],
 ": position ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["x", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e09b729-1d4c-4a5c-ab27-cf48b1a80f57"],
 " multiplies by ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "887dcbfe-17e2-4ac1-ae90-0f0a996ad758"],
 ", and momentum ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "^"], "=", "-", 
   StyleBox["i", "TI"], " ", 
   SubscriptBox["\[PartialD]", 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bff5a57-fea1-4a9a-b0bd-8c8089084fff"],
 " differentiates. They do not commute, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e8c82a4-6f53-457e-b469-8f22d5e8fac9"],
 ", the algebraic root of the uncertainty relation ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"], " ", "\[CapitalDelta]", 
   StyleBox["p", "TI"], "\[GreaterEqual]", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "697bb93f-5f22-4e09-a96e-a5b493751bb6"],
 ". A physical observable must be ",
 StyleBox["self-adjoint", "TI"],
 "; formal Hermiticity, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Phi]", "TI"], 
     RowBox[{
       OverscriptBox[
        StyleBox["A", "TI"], "^"], 
       StyleBox["\[Psi]", "TI"]}]},
    "BraKet"], "=", 
   TemplateBox[{
     RowBox[{
       OverscriptBox[
        StyleBox["A", "TI"], "^"], 
       StyleBox["\[Phi]", "TI"]}], 
     StyleBox["\[Psi]", "TI"]},
    "BraKet"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82fb9f60-42c8-4ef3-bcaf-5f4304f18beb"],
 ", is only half of that. For ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["p", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "343dbe20-5bba-488f-a9de-8631668a42f3"],
 " the Hermitian half holds by integration by parts once a boundary term \
vanishes, and on a finite domain the gap between the two conditions becomes \
the whole story. The Fourier transform ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Psi]", "TI"], "~"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", 
    SqrtBox[
     RowBox[{"2", "\[Pi]"}]]], 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["p", "TI"], 
     StyleBox["x", "TI"]}]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c011aa32-015f-4df2-88ed-bf2bb2196444"],
 " carries a state to the momentum representation, where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["n", "TI"]], 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        OverscriptBox[
         StyleBox["\[Psi]", "TI"], "~"], 
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["p", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63b554ab-d852-431b-b804-14ca2588e370"],
 " is an ordinary moment and the momentum eigenfunctions ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "p", "x"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c88dd8df-24e3-4cdd-a2f1-d03e3b8a60ed"],
 ", not themselves in ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["L", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93c90bd8-9dbe-4321-8a69-f9f9e6fc2210"],
 ", are normalized to a Dirac delta. Throughout, ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", 
   StyleBox["m", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50ecaf73-f2f7-498b-8e84-4135be806157"],
 "."
}], "Text",ExpressionUUID->"970379c6-b706-4420-9147-460460dc9ea9"],

Cell[TextData[{
 "2.1 [BSc] How do I represent the position operator ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["x", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e049a9f-2542-4ca1-bced-f36153d083c1"],
 " as multiplication and the momentum operator ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "^"], "=", "-", 
   StyleBox["i", "TI"], " ", 
   StyleBox["d", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e350c619-a770-49a1-80b8-1b0907cd9483"],
 " as differentiation, acting on a test function?"
}], "Subsection",ExpressionUUID->"b936e5d5-86b3-460e-a61b-d69e089e9e45"],

Cell[TextData[{
 "In the position representation the position operator acts by \
multiplication, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[Psi]", "TI"], "=", 
   StyleBox["x", "TI"], 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c321ad4b-24cb-47fc-91c4-3a8c7d4b6c29"],
 ", and the momentum operator by differentiation, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "^"], 
   StyleBox["\[Psi]", "TI"], "=", "-", 
   StyleBox["i", "TI"], " ", 
   SubscriptBox["\[PartialD]", 
    StyleBox["x", "TI"]], 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b06a9b4-456a-4baa-a86a-b2a86d5270fc"],
 ". The cleanest witness is a plane wave ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "k", "x"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb9b5031-7851-4f0e-970d-be6cdcefa94c"],
 ", which carries a single sharp momentum. Define the two operators as \
functions of the wavefunction and apply them to ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "k", "x"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4d6fe64-7318-457f-a1ac-862ed5094e49"],
 ":"
}], "Text",ExpressionUUID->"8ed4f2cf-1330-459f-967d-ad91a4f91594"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"xop", "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{"x", " ", "f"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pop", "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"-", "I"}], " ", 
    RowBox[{"D", "[", 
     RowBox[{"f", ",", " ", "x"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"xop", "[", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "k", " ", "x"}], "]"}], "]"}], ",", " ", 
   RowBox[{"pop", "[", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "k", " ", "x"}], "]"}], "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[51]:= ",ExpressionUUID->"e02f2df1-915f-49e5-b689-60a89cf21bda"],

Cell[TextData[{
 "The results are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "k", "x"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cbc7f728-b576-44d0-b818-7e12371b0cca"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "k", "x"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1179168-3ea6-4148-98f8-642981af2efd"],
 ": the plane wave is an eigenfunction of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["p", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5ecf9eb-af6a-45ba-ad79-b1e6d4b2b041"],
 " with eigenvalue ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9ff8260-381b-4501-bb31-c69d05b66446"],
 ", the precise sense in which ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "k", "x"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5fc9810-a7fb-4e62-9c61-18e308da4702"],
 " carries momentum ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5745921f-f233-4552-9474-25f78d4593de"],
 ", while ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["x", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53ffccaf-2bd1-4e8c-8b20-344040ea66d4"],
 " only reweights it by position. Every operator in this part is built from \
these two operations."
}], "Text",ExpressionUUID->"5d5fd0e4-fdb3-4871-a02e-01f10a0980d7"],

Cell[TextData[{
 "2.2 [BSc] How do I verify the canonical commutator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f0915be-5a2d-4e0d-ad08-5d9b48c212fa"],
 " by letting it act on an arbitrary function?"
}], "Subsection",ExpressionUUID->"8864a1d3-260d-4fc2-b798-5293c666661a"],

Cell[TextData[{
 "The canonical commutator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6493ec29-202c-4f34-ad8c-2f02bfbd792f"],
 " is an operator identity, so it must hold acting on an arbitrary function \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "151ad51f-3d27-4477-b73e-0992161acf0a"],
 ", not just on a special state. With ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["x", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d05fb8da-f77d-4d6d-b99f-7a50d6734392"],
 " multiplying and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "^"], "=", "-", 
   StyleBox["i", "TI"], " ", 
   SubscriptBox["\[PartialD]", 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6350458a-4948-4291-9c80-f078cd50dd45"],
 ", form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["f", "TI"], "=", 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   OverscriptBox[
    StyleBox["p", "TI"], "^"], 
   StyleBox["f", "TI"], "-", 
   OverscriptBox[
    StyleBox["p", "TI"], "^"], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["f", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3cb0491-8d65-4385-86b8-cdee9a03ede1"],
 " and simplify:"
}], "Text",ExpressionUUID->"aca4f7fb-12ff-4ec0-ad2c-1d61c391b177"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"xop", "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{"x", " ", "f"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pop", "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"-", "I"}], " ", 
    RowBox[{"D", "[", 
     RowBox[{"f", ",", " ", "x"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"xop", "[", 
    RowBox[{"pop", "[", 
     RowBox[{"f", "[", "x", "]"}], "]"}], "]"}], " ", "-", " ", 
   RowBox[{"pop", "[", 
    RowBox[{"xop", "[", 
     RowBox[{"f", "[", "x", "]"}], "]"}], "]"}]}], "]"}]}], "Input",
 CellLabel->
  "In[52]:= ",ExpressionUUID->"ed07ea6d-e07d-43d8-96ad-08015a0a6e3f"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], " ", 
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a429e894-a26f-4cbf-80aa-0280c51fa6c5"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c0d4741-e377-496c-95f1-8e5a7bced971"],
 ". The surviving term is the one from differentiating the product ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", "f"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6354036b-beff-4a60-b557-dd551fc8f6aa"],
 " inside ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "^"], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "783fedb8-5d93-44fc-b2b9-60b5d75e9492"],
 ": position and momentum fail to commute by exactly one unit, and that \
single unit is what forbids a state from being sharp in both at once. One \
qualification the manipulation quietly needs: ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "430cd348-2004-448e-b7bf-5b705e012ff8"],
 " must lie in a domain on which both orderings are defined, which on the \
line the Schwartz functions supply. That is not decoration. On a box with a \
twisted boundary condition, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a246058-45a0-4512-8155-f3c4c15ccadc"],
 " violates the condition and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "^"], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65e1d1f6-8f19-4aba-8033-9bbc8b076cce"],
 " is undefined, which is why the identity cannot be imposed on just any \
space."
}], "Text",ExpressionUUID->"1ad0c15d-a6b7-4417-a6de-e993dc6b1020"],

Cell[TextData[{
 "2.3 [BSc] How do I compute the momentum expectation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "debe84e8-d8bd-412f-80ce-dddd4bf63e54"],
 " and spread ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80aab21d-1dd8-4651-b85e-29a5463b5d2c"],
 " in the position representation?"
}], "Subsection",ExpressionUUID->"423fcb70-8979-4565-a481-9cb11e9121ba"],

Cell[TextData[{
 "Without leaving position space, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["\[Psi]", "TI"], "*"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    SubscriptBox["\[PartialD]", 
     StyleBox["x", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["\[Psi]", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7a72069-37a9-4607-9b71-131bcbb271bf"],
 ", and using the manifestly positive, boundary-free form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        SubscriptBox["\[PartialD]", 
         StyleBox["x", "TI"]], 
        StyleBox["\[Psi]", "TI"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "446530fa-5c56-49a5-86b8-00b0fa3a62fc"],
 " (equal to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["\[Psi]", "TI"], "*"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "2"], 
   StyleBox["\[Psi]", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "419cca0e-e410-4a6d-b67f-71cc4e82629f"],
 " because ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["p", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f08bf82-5687-43eb-93d7-4e9e0515dba1"],
 " is Hermitian), the spread is ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["p", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SuperscriptBox[
      StyleBox["p", "TI"], "2"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1], "-", 
     SuperscriptBox[
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       StyleBox["p", "TI"], "\[VeryThinSpace]", 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f36768a-d7bb-4e35-bc30-96ef2b9f0319"],
 ". Take the first excited state of the Poschl-Teller well ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", "3", 
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], "2"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8db8fca2-2a82-4e89-9722-dbcf53169e24"],
 ", namely ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    FractionBox["3", "2"]], " ", 
   StyleBox["sech",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["tanh",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fba851e3-e0ea-4dd4-8fbd-01f8bec69c16"],
 " at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", "-", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cad827e-da8f-492a-b76b-80da605fd0f1"],
 " (that well's ground state being ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], "2"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf4951b-4559-4d70-96da-61e17ab0e5f3"],
 " at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", "-", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32dc93f7-feea-4303-b4cd-b98f122201d6"],
 "), a state with a node, and give it a uniform drift with a boost ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "k", "x"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2351220f-8bd2-473b-b084-7fecb4a20b64"],
 ": ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SqrtBox[
    FractionBox["3", "2"]], " ", 
   StyleBox["sech",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["tanh",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "k", "x"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c866f02-6112-48e3-a6c9-eed5dad41646"],
 ". Confirm it is normalized:"
}], "Text",ExpressionUUID->"98dbaeca-e532-4bb6-979f-4d3e0d3e3750"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"3", "/", "2"}], "]"}], " ", 
    RowBox[{"Sech", "[", "x", "]"}], " ", 
    RowBox[{"Tanh", "[", "x", "]"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "k", " ", "x"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], "^", "2"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"k", " ", "\[Element]", " ", "Reals"}]}]}], "]"}]}], "Input",
 CellLabel->
  "In[53]:= ",ExpressionUUID->"94762bb9-db5b-4e0c-b1f5-bd8ceb33c45b"],

Cell[TextData[{
 "The norm is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37341c4d-4458-4ba4-82ab-9adf14f41adb"],
 ". Compute the mean momentum ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["\[Psi]", "TI"], "*"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    SubscriptBox["\[PartialD]", 
     StyleBox["x", "TI"]], 
    StyleBox["\[Psi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32154e7d-c0a3-4561-9468-9c66cd81e8bb"],
 ":"
}], "Text",ExpressionUUID->"dddeffc8-5b63-440c-a973-5d2f6e0dbc99"],

Cell[BoxData[
 RowBox[{"mp", " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"\[Psi]", "[", "x", "]"}], ",", " ", "x"}], "]"}]}], ")"}]}],
     ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", 
      RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{"k", " ", "\[Element]", " ", "Reals"}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[54]:= ",ExpressionUUID->"6767f78a-bbcf-4a6d-926e-613f7b7ae03c"],

Cell[TextData[{
 "The mean is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b71e914-6eea-46fe-b42b-23d61a1f2a4c"],
 ", the drift stamped in by the boost; the real, odd envelope carries no \
current of its own. Compute the second moment ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        SubscriptBox["\[PartialD]", 
         StyleBox["x", "TI"]], 
        StyleBox["\[Psi]", "TI"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2631faa7-2035-466f-bd04-2a2feb1f78e0"],
 ":"
}], "Text",ExpressionUUID->"ca0e854a-4182-4c12-8151-eb09520f1d13"],

Cell[BoxData[
 RowBox[{"p2", " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Psi]", "[", "x", "]"}], ",", " ", "x"}], "]"}], "]"}], "^",
      "2"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", 
      RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{"k", " ", "\[Element]", " ", "Reals"}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[55]:= ",ExpressionUUID->"86046f52-56a1-4450-94b0-c9c213f35563"],

Cell[TextData[{
 "It is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], "+", 
   FractionBox["7", "5"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070ef767-6208-450f-b243-950bcbb01bba"],
 ": the drift energy ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1de6ba76-1469-417d-aec9-25bf08c55b9f"],
 " plus an intrinsic piece set by the node. The spread is ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["p", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SuperscriptBox[
      StyleBox["p", "TI"], "2"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1], "-", 
     SuperscriptBox[
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       StyleBox["p", "TI"], "\[VeryThinSpace]", 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "558425d6-ceee-4298-9a18-113eb338a831"],
 ":"
}], "Text",ExpressionUUID->"a7d98bf8-b386-4997-ac46-c57f4ec5bd38"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Sqrt", "[", 
    RowBox[{"p2", " ", "-", " ", 
     RowBox[{"mp", "^", "2"}]}], "]"}], ",", " ", 
   RowBox[{"k", " ", "\[Element]", " ", "Reals"}]}], "]"}]], "Input",
 CellLabel->
  "In[56]:= ",ExpressionUUID->"5f50706d-02c4-4bb7-afd7-16b0868511cd"],

Cell[TextData[{
 "The spread is ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["p", "TI"], "=", 
   SqrtBox[
    RowBox[{"7", "/", "5"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a0e3ffb-7f3b-41e1-917e-56394d718ca3"],
 ", independent of the boost ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75cf50df-efb8-4eab-8c82-6591be375740"],
 ": shifting the mean momentum slides the whole distribution rigidly without \
changing its width, exactly as a Galilean boost should. The width is set by \
the node in the envelope, not by the drift."
}], "Text",ExpressionUUID->"a7f27a06-ee27-4cc5-a0db-eadb7b6ce895"],

Cell[TextData[{
 "2.4 [BSc] How do I show that ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["p", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c06b587-5173-4d2d-8eeb-f1ce5997a4d4"],
 " is Hermitian by integration by parts, and see that the boundary terms \
vanish for an ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["L", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5ad52d8-00b0-46f1-9fb9-c173d2cce45f"],
 " state?"
}], "Subsection",ExpressionUUID->"f7705429-aae4-44ec-a1f1-6815b1ae35f1"],

Cell[TextData[{
 "Hermiticity of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["p", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "186e7f01-1c1a-4cc4-a4ad-9b4c0698373a"],
 " means ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Phi]", "TI"], 
     RowBox[{
       OverscriptBox[
        StyleBox["p", "TI"], "^"], 
       StyleBox["\[Chi]", "TI"]}]},
    "BraKet"], "=", 
   TemplateBox[{
     RowBox[{
       OverscriptBox[
        StyleBox["p", "TI"], "^"], 
       StyleBox["\[Phi]", "TI"]}], 
     StyleBox["\[Chi]", "TI"]},
    "BraKet"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbcbb33-34cb-4cae-9618-3bedf7f62c0d"],
 " for states in its domain. Integration by parts turns the difference of the \
two matrix elements into a pure surface term. Writing ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Phi]", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d16835b-b51b-4763-88cd-9cdb0f40b933"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "888029e8-78ac-41b8-9159-ecfe053cad13"],
 " as independent functions ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97fc1ba4-e7e0-4136-89c8-a3e091aafb39"],
 " and ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed640e6b-c8e3-4843-a391-cc62cd836499"],
 ", so nothing is assumed of either, confirm that the integrand of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Phi]", "TI"], 
     RowBox[{
       OverscriptBox[
        StyleBox["p", "TI"], "^"], 
       StyleBox["\[Chi]", "TI"]}]},
    "BraKet"], "-", 
   TemplateBox[{
     RowBox[{
       OverscriptBox[
        StyleBox["p", "TI"], "^"], 
       StyleBox["\[Phi]", "TI"]}], 
     StyleBox["\[Chi]", "TI"]},
    "BraKet"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f02fffc0-6e20-4d02-b832-f2376f3558c7"],
 " is the total derivative ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], " ", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox[
      RowBox[{"g", "f"}], "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "\[Prime]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1475ba41-cfb6-40cc-919d-86a620e71c9c"],
 ":"
}], "Text",ExpressionUUID->"f20658ec-f935-4d20-9c8e-d1336de3b1a8"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"g", "[", "x", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{
       RowBox[{"f", "'"}], "[", "x", "]"}]}], ")"}]}], " ", "-", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"I", " ", 
      RowBox[{
       RowBox[{"g", "'"}], "[", "x", "]"}]}], ")"}], " ", 
    RowBox[{"f", "[", "x", "]"}]}], " ", "+", " ", 
   RowBox[{"I", " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", "x", "]"}], " ", 
       RowBox[{"f", "[", "x", "]"}]}], ",", " ", "x"}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[57]:= ",ExpressionUUID->"9aaa3c0a-2e11-49a6-809d-c827f1566919"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d412b51-fde6-4543-9f4a-c3f92b24101e"],
 ", so the difference is ",
 Cell[BoxData[
  RowBox[{
   UnderoverscriptBox["\[Integral]", 
    RowBox[{"-", "\[Infinity]"}], "\[Infinity]",
    LimitsPositioning->False], "-", 
   StyleBox["i", "TI"], " ", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox[
      RowBox[{"g", "f"}], "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "\[Prime]"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "=", "-", 
   StyleBox["i", "TI"], 
   SubsuperscriptBox[" ", 
    RowBox[{"-", "\[Infinity]"}], "\[Infinity]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "959beaba-4d28-4581-ad43-f7fff786175b"],
 ", a boundary term and nothing else. Hence ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["p", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51a46b9e-c527-43e5-b1cb-203ee7fc168e"],
 " is Hermitian exactly when that term vanishes. For any state that decays at \
infinity it does; confirm it for a concrete decaying pair ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Phi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", 
    RowBox[{"1", "+", 
     SuperscriptBox[
      StyleBox["x", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f01b2205-43aa-40cf-9f99-c141b5e8f999"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Chi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox[
      RowBox[{"i", "x"}], "TI"]], 
    RowBox[{"1", "+", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["x", "TI"], "-", "1"}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d45ea3c4-c5de-403e-bb88-8a6aafeac343"],
 ":"
}], "Text",ExpressionUUID->"9c1116b1-23d7-45e7-ad16-e55de57c7511"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{"x", "^", "2"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Chi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "x"}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", " ", "-", " ", "1"}], ")"}], "^", "2"}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Limit", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{"Conjugate", "[", 
      RowBox[{"\[Phi]", "[", "x", "]"}], "]"}], " ", 
     RowBox[{"\[Chi]", "[", "x", "]"}]}], ",", " ", 
    RowBox[{"x", " ", "->", " ", "Infinity"}]}], "]"}], " ", "-", " ", 
  RowBox[{"Limit", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{"Conjugate", "[", 
      RowBox[{"\[Phi]", "[", "x", "]"}], "]"}], " ", 
     RowBox[{"\[Chi]", "[", "x", "]"}]}], ",", " ", 
    RowBox[{"x", " ", "->", " ", 
     RowBox[{"-", "Infinity"}]}]}], "]"}]}]}], "Input",
 CellLabel->
  "In[58]:= ",ExpressionUUID->"710cfc60-db1b-41aa-ae4f-d9d2609d5951"],

Cell[TextData[{
 "The boundary term is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "471d12ed-bef3-4bdd-b68e-ba68106d97f5"],
 ": both amplitudes vanish at infinity, so the two matrix elements agree. \
Note what that does and does not establish. Belonging to ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["L", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61e61c7f-1093-435b-b973-c6f0f24f8422"],
 " does not by itself force a function to decay pointwise (spikes of fixed \
height and shrinking width are square-integrable and do not tend to zero), \
and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["p", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8dd4e765-fb95-45d4-aa9d-9811706dd0b3"],
 " is unbounded, so it is not defined on all of ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["L", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f15f6df-ff23-47e8-8e1a-4e977903b0b2"],
 " but only on a dense domain. So ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["p", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22b2d161-e9fb-4a4a-bd4d-fc76c02df1d9"],
 " is symmetric on the domain of functions for which this surface term \
vanishes, not on ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["L", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1aeb3ce-5795-4271-b2bc-5b9df8388a98"],
 " as a whole. That the whole content sits in a surface term is the crux: on \
a finite domain the term need not vanish, and then everything depends on the \
boundary conditions imposed."
}], "Text",ExpressionUUID->"00b6b3f4-4865-491d-a21f-84e1e847ae1e"],

Cell[TextData[{
 "2.5 [BSc] How do I write the momentum eigenfunctions ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "p", "x"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce6421b8-20c3-4492-99cf-af8316f43ea9"],
 ", see that they are not square-integrable, and normalize them to a Dirac \
delta?"
}], "Subsection",ExpressionUUID->"f71148e6-e80a-4a5f-b8ad-32b1c00567ca"],

Cell[TextData[{
 "The momentum eigenfunctions ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "p", "x"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29a6648a-dea1-498d-87e4-35fc4b959b7c"],
 " have ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox[
         RowBox[{"i", "p", "x"}], "TI"]]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffb81e15-5851-4d7a-b70f-16a7e94760e2"],
 " everywhere, so they are not square-integrable and cannot be normalized to ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74e9507b-3a73-4649-9321-f75dcd0b2363"],
 "; the continuum replacement is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SuperscriptBox[
      StyleBox["p", "TI"], "\[Prime]"], 
     StyleBox["p", "TI"]},
    "BraKet"], "=", 
   StyleBox["\[Delta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], "-", 
   SuperscriptBox[
    StyleBox["p", "TI"], "\[Prime]"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba5f5e8a-7f07-4ef3-81a7-5591cf88877b"],
 " for ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["p", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", 
    SqrtBox[
     RowBox[{"2", "\[Pi]"}]]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "p", "x"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b540a31-30ea-4988-b35f-7213716a5024"],
 ". The ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cfd59dea-c7ac-45e7-a4cd-e0b373e6e1d1"],
 " that makes this work is the Fourier integral of a constant. Compute ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "q", "x"}], "TI"]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "061a3d62-1289-43de-bcf7-9f311795b240"],
 " as a Fourier transform:"
}], "Text",ExpressionUUID->"83e75149-522c-4dd2-b436-d9b030efe1e7"],

Cell[BoxData[
 RowBox[{"FourierTransform", "[", 
  RowBox[{"1", ",", " ", "x", ",", " ", "q"}], "]"}]], "Input",
 CellLabel->
  "In[59]:= ",ExpressionUUID->"029a7f89-aaed-4c18-8d3b-9b769fe6ae93"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    RowBox[{"2", "\[Pi]"}]], " ", 
   StyleBox["\[Delta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["q", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a081f979-6158-4222-b08d-cd7be712d55d"],
 ", that is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "q", "x"}], "TI"]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "=", "2", "\[Pi]", " ", 
   StyleBox["\[Delta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["q", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8efe984f-640c-47c8-9c45-0424819e6dd3"],
 ". Now transform the normalized eigenstate ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["p", "TI"]], "=", 
   FractionBox["1", 
    SqrtBox[
     RowBox[{"2", "\[Pi]"}]]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "p", "x"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2a69853-91ce-4642-b6be-1cc8ff4c2cea"],
 " into momentum space and read off its overlap with a momentum label ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["p", "TI"], "\[Prime]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d0b21f1-0f97-42c6-8acf-45bf39c9ba1d"],
 ":"
}], "Text",ExpressionUUID->"721814ba-b9e0-4020-ab04-71b18d600cf7"],

Cell[BoxData[
 RowBox[{"FourierTransform", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", "Pi"}], "]"}]}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "p", " ", "x"}], "]"}]}], ",", " ", "x", ",", " ", 
   "pp", ",", " ", 
   RowBox[{"FourierParameters", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", 
      RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[60]:= ",ExpressionUUID->"c6fe29be-8bfc-4a42-aa64-5c90a6e0b3ff"],

Cell[TextData[{
 "The transform is exactly ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["p", "TI"], "-", 
    SuperscriptBox[
     StyleBox["p", "TI"], "\[Prime]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88ed24d0-fb4e-4849-a769-1539e7a63bc2"],
 ": a sharp momentum state is a delta spike at its eigenvalue, the continuum \
analog of an orthonormal basis vector. The price of perfect momentum \
definiteness is a state spread uniformly over all space, outside ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["L", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bb9cc35-d675-4fa7-96f4-bec3f5b10c69"],
 " entirely."
}], "Text",ExpressionUUID->"3f88b5bc-52de-40de-9e42-c1424b2a1774"],

Cell[TextData[{
 "2.6 [BSc] How do I obtain the momentum-space wavefunction ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Psi]", "TI"], "~"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49d73ef8-8eeb-492c-b208-bc5e320a7714"],
 " by Fourier transform and compute ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d533728-f9b7-4626-bca9-e386381fa61b"],
 " as a moment in ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efeb8e59-c9a2-4b94-9d7e-ea6f22577391"],
 "?"
}], "Subsection",ExpressionUUID->"db6f2e63-ccd1-4d2d-8ad3-342469dc30f5"],

Cell[TextData[{
 "The momentum-space wavefunction is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Psi]", "TI"], "~"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", 
    SqrtBox[
     RowBox[{"2", "\[Pi]"}]]], 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["p", "TI"], 
     StyleBox["x", "TI"]}]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "291ab681-40e4-4d5e-b3ae-915be3cf0e24"],
 " (the option ",
 Cell[BoxData[
  RowBox[{"FourierParameters", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", 
     RowBox[{"-", "1"}]}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69bcdcaa-c6d5-458d-bc8d-7166d2ca85e5"],
 " fixes the quantum-mechanics sign), after which ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["n", "TI"]], 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        OverscriptBox[
         StyleBox["\[Psi]", "TI"], "~"], 
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["p", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe89869b-c134-4dd2-b31f-e5ac305f8c45"],
 " is an ordinary moment. Take the ground state of the infinite square well \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    StyleBox["L", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9bb3ce78-61a0-46ec-aa97-96254dd5caba"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SqrtBox[
    RowBox[{"2", "/", 
     StyleBox["L", "TI"]}]], " ", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", 
    StyleBox["x", "TI"], "/", 
    StyleBox["L", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef2964ff-27fe-4201-b120-8ca0be967f8d"],
 ", a state with hard edges rather than smooth tails. Transform it over its \
support:"
}], "Text",ExpressionUUID->"951f69f6-0cb6-4974-9115-82e09c556827"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", "/", "L"}], "]"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"Pi", " ", 
      RowBox[{"x", "/", "L"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"\[Psi]T", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Psi]", "[", "x", "]"}], " ", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "p", " ", "x"}], "]"}], "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", " ", "Pi"}], "]"}]}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", " ", "L"}], "}"}], ",", " ", 
      RowBox[{"Assumptions", " ", "->", " ", 
       RowBox[{
        RowBox[{"L", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"p", " ", "\[Element]", " ", "Reals"}]}]}]}], "]"}], ",", " ", 
    RowBox[{"L", " ", ">", " ", "0"}]}], "]"}]}]}], "Input",
 CellLabel->
  "In[61]:= ",ExpressionUUID->"16a914ec-7308-4524-b11a-38381f2c7b50"],

Cell[TextData[{
 "The transform is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Psi]", "TI"], "~"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   FractionBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"-", 
        StyleBox["i", "TI"], 
        StyleBox["L", "TI"], 
        StyleBox["p", "TI"]}]]}], 
     StyleBox[")",
      SpanMaxSize->1], 
     SqrtBox[
      RowBox[{
       StyleBox["L", "TI"], "\[Pi]"}]]}], 
    RowBox[{
     SuperscriptBox[
      StyleBox["L", "TI"], "2"], 
     SuperscriptBox[
      StyleBox["p", "TI"], "2"], "-", 
     SuperscriptBox["\[Pi]", "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e867b61-187b-4665-a8c3-841cf1737559"],
 ", peaked near ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", "\[PlusMinus]", "\[Pi]", "/", 
   StyleBox["L", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c81a3f68-0ae5-466a-a68d-a98c4301349d"],
 ", the momenta of the two counter-propagating waves that make up the \
standing state. Confirm it carries unit probability:"
}], "Text",ExpressionUUID->"e606388d-13b4-4ce5-85fa-aab7bba5a981"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", "\[Psi]T", "]"}], "^", "2"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", 
       RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"L", " ", ">", " ", "0"}]}]}], "]"}], ",", " ", 
   RowBox[{"L", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->
  "In[62]:= ",ExpressionUUID->"eb8a6811-c6d2-4774-8bce-1d26a026db8c"],

Cell[TextData[{
 "The norm is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c718cf6-34bd-4cb2-8ffc-cbe182b4e879"],
 ". Compute the second moment ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        OverscriptBox[
         StyleBox["\[Psi]", "TI"], "~"], 
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["p", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c003a4e2-b189-43dc-ab2e-0cde3a377126"],
 ":"
}], "Text",ExpressionUUID->"4c71cd6e-6ade-4cc7-832a-fb5866ea5c21"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"p", "^", "2"}], " ", 
      RowBox[{
       RowBox[{"Abs", "[", "\[Psi]T", "]"}], "^", "2"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", 
       RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"L", " ", ">", " ", "0"}]}]}], "]"}], ",", " ", 
   RowBox[{"L", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->
  "In[63]:= ",ExpressionUUID->"f4e4f157-18ac-4b11-8704-b05c3588d8d5"],

Cell[TextData[{
 "The moment is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[Pi]", "/", 
      StyleBox["L", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39b68237-8019-4978-bf68-c9f5eabe70b9"],
 ", exactly twice the ground-state energy ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "1"], "=", 
   SuperscriptBox["\[Pi]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SuperscriptBox[
     StyleBox["L", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bdfd384a-d13f-4d58-b72f-f9817c9ede0d"],
 ", now read off in momentum space. Cross-check it against the position-space \
form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        SubscriptBox["\[PartialD]", 
         StyleBox["x", "TI"]], 
        StyleBox["\[Psi]", "TI"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86fda928-5175-4894-9796-fd96fe03af4a"],
 ", which shares no machinery with the transform:"
}], "Text",ExpressionUUID->"47988c84-0664-4c63-86f9-45d7aa48ccda"],

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[Psi]", "[", "x", "]"}], ",", " ", "x"}], "]"}], "]"}], "^", 
    "2"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "0", ",", " ", "L"}], "}"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"L", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[64]:= ",ExpressionUUID->"c1f550f0-ef86-4115-8e5d-579d60947acb"],

Cell[TextData[{
 "The two routes agree at ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[Pi]", "/", 
     StyleBox["L", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23386580-4b00-440b-b233-2228bfb13210"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8175bfd8-d34e-461a-9e57-770dc10462a6"],
 " by the symmetry of ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      OverscriptBox[
       StyleBox["\[Psi]", "TI"], "~"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3e03909-74e5-40e0-ac02-ff3fcf33c1c6"],
 ". The hard walls put weight in tails of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["\[Psi]", "TI"], "~"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "239a232b-931a-4ea0-b536-3e9a3661c7b6"],
 " that fall only as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7c0a5b3-ef6e-4679-8496-6ec3944e0cba"],
 ": sharp edges in position cost a broad momentum spread, so the well ground \
state sits well above minimum uncertainty."
}], "Text",ExpressionUUID->"51460368-8b5b-4839-91e1-9bfe05735963"],

Cell[TextData[{
 "2.7 [BSc] How do I verify the position-momentum uncertainty relation ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"], " ", "\[CapitalDelta]", 
   StyleBox["p", "TI"], "\[GreaterEqual]", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc3b436c-533d-4e1f-8183-6c35e8e38600"],
 " and show that a Gaussian saturates it?"
}], "Subsection",ExpressionUUID->"c2da418c-c950-4656-89f9-07f1a45d28ff"],

Cell[TextData[{
 "The bound ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"], " ", "\[CapitalDelta]", 
   StyleBox["p", "TI"], "\[GreaterEqual]", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab7b43b5-de7d-438c-a985-2f00812b76c6"],
 " (with ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22f9b1e1-2ac3-478f-9b42-419e9d80a08c"],
 ") is saturated by a Gaussian and by nothing else, so it is worth computing \
the product for a non-Gaussian state first and for the Gaussian second. Take \
the hyperbolic-secant profile ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", 
    SqrtBox["2"]], 
   StyleBox["sech",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6e65928-d215-41e0-ab9a-ec722f18baa0"],
 ", the ground state and only bound state of the well ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], "2"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73bdb89c-43af-4674-b168-4a24295e80f6"],
 ", and form ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"], " ", "\[CapitalDelta]", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c88e1cab-1e2d-42ec-806d-fffe14d395b2"],
 " from its second moments:"
}], "Text",ExpressionUUID->"2efcded1-d06c-40e8-8c6f-fea3d945867a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sech", "[", "x", "]"}], "/", 
    RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dxS", " ", "=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"\[Psi]", "[", "x", "]"}], "]"}], "^", "2"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dpS", " ", "=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[Psi]", "[", "x", "]"}], ",", " ", "x"}], "]"}], "]"}], "^",
        "2"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"dxS", " ", "dpS"}]}], "Input",
 CellLabel->
  "In[65]:= ",ExpressionUUID->"b4f558a2-c0ac-4187-a8af-ed10cf46345d"],

Cell[TextData[{
 "The product is ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"], " ", "\[CapitalDelta]", 
   StyleBox["p", "TI"], "=", "\[Pi]", "/", "6", "\[TildeTilde]", "0.524"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8c9f051-86ff-451f-a9a1-e437f37592b4"],
 ", just above the floor: a state can be beautifully localized and still not \
minimal. Now the Gaussian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox["\[Pi]", 
    RowBox[{"-", "1", "/", "4"}]], 
   SuperscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    RowBox[{"-", "1", "/", "2"}]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["x", "TI"], "2"], "/", "2", 
     SuperscriptBox[
      StyleBox["\[Sigma]", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5057f978-6c09-473f-9058-23058ed5f9a8"],
 ", at arbitrary width ",
 Cell[BoxData[
  StyleBox["\[Sigma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c246723b-f24a-4766-a617-a78c254079e6"],
 ":"
}], "Text",ExpressionUUID->"66fa122d-a9d8-4d94-ad45-566f14a4ba62"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]G", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Pi", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "4"}], ")"}]}], " ", 
    RowBox[{"\[Sigma]", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}], ")"}]}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"x", "^", "2"}]}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"\[Sigma]", "^", "2"}]}], ")"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dxG", " ", "=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"\[Psi]G", "[", "x", "]"}], "]"}], "^", "2"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
      RowBox[{"Assumptions", " ", "->", " ", 
       RowBox[{"\[Sigma]", " ", ">", " ", "0"}]}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dpG", " ", "=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[Psi]G", "[", "x", "]"}], ",", " ", "x"}], "]"}], "]"}], "^",
        "2"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
      RowBox[{"Assumptions", " ", "->", " ", 
       RowBox[{"\[Sigma]", " ", ">", " ", "0"}]}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"dxG", " ", "dpG"}], ",", " ", 
   RowBox[{"\[Sigma]", " ", ">", " ", "0"}]}], "]"}]}], "Input",
 CellLabel->
  "In[66]:= ",ExpressionUUID->"bab84c42-4403-4524-836d-88820f494a79"],

Cell[TextData[{
 "The Gaussian gives exactly ",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9b01c3c-189b-4b98-a46f-9e5e6027b167"],
 " for every width ",
 Cell[BoxData[
  StyleBox["\[Sigma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3c6502b-f58f-4c71-9cfd-6537deb1d8c3"],
 ": squeezing it in position inflates it in momentum and vice versa, so it \
traces the very edge of the allowed region while every other state, the sech \
included, lies strictly above. This is the one place the Gaussian earns its \
keep, as the unique minimum-uncertainty state."
}], "Text",ExpressionUUID->"6ee3b7f9-56f7-4a87-aeeb-e09c202558e3"],

Cell[TextData[{
 "2.8 [MSc] How do I build a function ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aeea1524-0e44-4375-ba49-099e23764b79"],
 " of noncommuting operators, and resolve the ordering ambiguity by Weyl \
symmetric ordering?"
}], "Subsection",ExpressionUUID->"d1a3c1ec-5c0a-4d97-9409-575ae86096a4"],

Cell[TextData[{
 "Because ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["x", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea84f355-8acd-4e6f-9b93-09668c37970a"],
 " and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["p", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b31a56c0-2178-4486-a1fe-b3f253c7d4c4"],
 " do not commute, the classical product ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", "p"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b88c673c-0ae5-4e58-b000-b176ab1f8120"],
 " has several inequivalent quantizations. Of the combinations of ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   OverscriptBox[
    StyleBox["p", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0eb7e58-04cf-4393-a57c-bb62397ab653"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "^"], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d6d91d3-3bc0-4e47-841f-f3d8d6224df6"],
 ", the Weyl (symmetric) prescription ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], 
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "+", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"], 
    OverscriptBox[
     StyleBox["x", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d55ddf1a-542f-4090-bba4-adc44804aff5"],
 " is the only Hermitian one, up to an additive real constant. Build the \
symmetric operator and let it act on a generic function ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c668ff82-6e26-4db2-b979-ca6ca31eab2f"],
 ":"
}], "Text",ExpressionUUID->"0b758abb-cafa-43d6-8f32-bea9aac29b4c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"xop", "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{"x", " ", "f"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pop", "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"-", "I"}], " ", 
    RowBox[{"D", "[", 
     RowBox[{"f", ",", " ", "x"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sym", "[", "h_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"xop", "[", 
       RowBox[{"pop", "[", "h", "]"}], "]"}], " ", "+", " ", 
      RowBox[{"pop", "[", 
       RowBox[{"xop", "[", "h", "]"}], "]"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{"sym", "[", 
   RowBox[{"h", "[", "x", "]"}], "]"}], "]"}]}], "Input",
 CellLabel->
  "In[67]:= ",ExpressionUUID->"0b10cbc3-897d-40c8-a3be-bd633e2ca11e"],

Cell[TextData[{
 "The symmetric operator acts as ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   FractionBox["1", "2"], 
   StyleBox["h", "TI"], "+", 
   StyleBox["x", "TI"], 
   SuperscriptBox[
    StyleBox["h", "TI"], "\[Prime]"], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db51b5d6-089e-4ed8-8515-1f71cac83ca0"],
 ", the naive ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   OverscriptBox[
    StyleBox["p", "TI"], "^"], "=", "-", 
   StyleBox["i", "TI"], " ", 
   StyleBox["x", "TI"], 
   SuperscriptBox[
    StyleBox["h", "TI"], "\[Prime]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "466ac46c-2d5d-4df7-8c29-94c4f36e8ab9"],
 " plus half the commutator. What the naive ordering lacks is Hermiticity; \
test the matrix-element difference for the symmetric operator against the \
same difference for ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   OverscriptBox[
    StyleBox["p", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0933956e-b1e2-4c55-9be1-98fcd504c2b5"],
 ", using two convenient decaying test functions (displaced Gaussians, used \
only as smooth probes, not as the object of study):"
}], "Text",ExpressionUUID->"b331c338-d49e-4caf-b9ff-04c40bc684ed"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Pi", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "4"}], ")"}]}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", " ", "-", " ", "1"}], ")"}], "^", "2"}]}], "/", "2"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Chi]", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Pi", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "4"}], ")"}]}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", " ", "+", " ", "1"}], ")"}], "^", "2"}]}], "/", "2"}], 
     "]"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "x"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", 
        RowBox[{"\[Phi]", "[", "x", "]"}], "]"}], " ", 
       RowBox[{"sym", "[", 
        RowBox[{"\[Chi]", "[", "x", "]"}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], "]"}], 
    " ", "-", " ", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", 
        RowBox[{"sym", "[", 
         RowBox[{"\[Phi]", "[", "x", "]"}], "]"}], "]"}], " ", 
       RowBox[{"\[Chi]", "[", "x", "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], "]"}]}], ",",
    "\n", " ", 
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", 
        RowBox[{"\[Phi]", "[", "x", "]"}], "]"}], " ", 
       RowBox[{"xop", "[", 
        RowBox[{"pop", "[", 
         RowBox[{"\[Chi]", "[", "x", "]"}], "]"}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], "]"}], 
    " ", "-", " ", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", 
        RowBox[{"xop", "[", 
         RowBox[{"pop", "[", 
          RowBox[{"\[Phi]", "[", "x", "]"}], "]"}], "]"}], "]"}], " ", 
       RowBox[{"\[Chi]", "[", "x", "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], "]"}]}]}],
   "}"}]}], "Input",
 CellLabel->
  "In[68]:= ",ExpressionUUID->"ff22b1a2-e24c-4a0c-b1c2-6a124e1d2535"],

Cell[TextData[{
 "The first entry is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f269b00-0231-4a14-b7af-9fa366c565ff"],
 " and the second is nonzero: only ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], 
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "+", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"], 
    OverscriptBox[
     StyleBox["x", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1696e958-eeba-4d44-9f4e-6d199a7afc85"],
 " is Hermitian, so only it can represent an observable, while ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   OverscriptBox[
    StyleBox["p", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84f07667-49cc-4bbc-a320-badc2400523e"],
 " cannot. The ambiguity between ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   OverscriptBox[
    StyleBox["p", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57f3616c-5b2f-4365-9b3e-d4e296cbbb48"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "^"], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39739699-1b1b-4adc-844d-5ab251e66578"],
 " is precisely the commutator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a58098a8-4a7f-4c3e-84a5-eac2ff23fbd1"],
 ", now seen as an ordering choice with physical consequences. Hermiticity \
settles the ordering here, but it does not do so in general: for ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6345b7a7-1931-4fca-89a7-f348f7313c48"],
 " the Weyl and Born-Jordan prescriptions are both Hermitian and differ from \
each other, so picking a quantization takes more than requiring a real \
spectrum."
}], "Text",ExpressionUUID->"207dd69a-3b7a-4b20-b3d2-eb91334a5f67"],

Cell["\<\
2.9 [MSc] How do I distinguish self-adjointness from formal Hermiticity \
through the operator domain and boundary conditions (the box versus the \
half-line)?\
\>", "Subsection",ExpressionUUID->"418efab3-9107-4f0a-bac1-edf3bcff8c10"],

Cell[TextData[{
 "Formal Hermiticity is the bulk identity just proved: it needs the boundary \
term ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Phi]", "TI"], "*"], 
    StyleBox["\[Psi]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64bbb306-8d8f-48c4-ba41-1e40affdfc57"],
 " to vanish, which is a condition on the domain. Self-adjointness demands \
more, namely that the operator and its adjoint have the ",
 StyleBox["same", "TI"],
 " domain, ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["A", "TI"], "^"], "\[Dagger]"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "\|01d49f", 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["A", "TI"], "^"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f9537b8-4b90-490a-82ea-6729c0fe48c3"],
 ". The two requirements come apart differently on a box and on a half-line. \
On the box ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    StyleBox["L", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bfc578f2-fa27-46f0-8e88-e54434315757"],
 ", impose the twisted boundary condition ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["L", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "\[Theta]"}], "TI"]], 
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b120d1c6-878e-4453-825d-7a0ca211b9dd"],
 " and evaluate the surface term:"
}], "Text",ExpressionUUID->"b32e4f6e-e68c-408b-94d1-ad1bb786a7bf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bt", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Conjugate", "[", "pL", "]"}], " ", "sL"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"Conjugate", "[", "p0", "]"}], " ", "s0"}]}], ")"}]}], " ", "/.",
     " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"sL", " ", "->", " ", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "\[Theta]"}], "]"}], " ", "s0"}]}], ",", " ", 
      RowBox[{"pL", " ", "->", " ", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "\[Theta]"}], "]"}], " ", "p0"}]}]}], "}"}]}]}], 
  ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{"bt", ",", " ", 
   RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}]}], "]"}]}], "Input",
 CellLabel->
  "In[69]:= ",ExpressionUUID->"05088da5-1eb2-442c-9e89-ef1fbc03d215"],

Cell[TextData[{
 "The surface term is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d1226d4-5ebc-4830-b3df-e5f477eaf261"],
 " for every real ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cbf8930b-9023-4d7e-aeb8-91d069a0f069"],
 ": each twist angle defines a genuine self-adjoint momentum operator, a \
one-parameter family of extensions. Now the half-line ",
 Cell[BoxData[
  RowBox[{"[", "0", ",", "\[Infinity]", ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98d9c155-2ba1-4abc-b248-7de12777009b"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "\[Infinity]", 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "664f841f-9d88-4121-a5a6-c7b34f2e1801"],
 " but ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e642e7b3-6a9a-4fa2-a03a-c747163873b0"],
 " is free:"
}], "Text",ExpressionUUID->"51855adb-89a0-4079-b15a-172ddff7e1aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "I"}], " ", 
  RowBox[{"(", 
   RowBox[{"0", " ", "-", " ", 
    RowBox[{
     RowBox[{"Conjugate", "[", "p0", "]"}], " ", "s0"}]}], ")"}]}]], "Input",
 CellLabel->
  "In[70]:= ",ExpressionUUID->"d91137fc-44cc-49f6-b77e-03087ec686bb"],

Cell[TextData[{
 "The term reduces to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], " ", 
   SuperscriptBox[
    StyleBox["\[Phi]", "TI"], "*"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc917c6c-673e-4cda-966c-d2fbe48d82e5"],
 ", and it ",
 StyleBox["can", "TI"],
 " be made to vanish, by requiring ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2888785-504e-4d35-a29e-9ad6b8e8ba7e"],
 ". So ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["p", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5456a422-e56c-480f-89f9-cbe9bf0767bd"],
 " is symmetric on the half-line, and the surface term alone does not \
distinguish this case from the box. The obstruction lies deeper, in the \
deficiency indices: solving ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "\[Dagger]"], 
   StyleBox["\[Psi]", "TI"], "=", "\[PlusMinus]", 
   StyleBox["i", "TI"], 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3aaffd2e-f9c9-40f1-9dd7-4099c066a589"],
 " gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"\[MinusPlus]", 
     StyleBox["x", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a062bacf-58ef-40a7-b6f9-ca56c9b65e51"],
 ", and on ",
 Cell[BoxData[
  RowBox[{"[", "0", ",", "\[Infinity]", ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d36a7cd2-48c5-45eb-a9ee-fbbbaeb12824"],
 " only ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["x", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0d01c4e-5ca8-40d4-8006-5c044b8e7451"],
 " is square-integrable, so the indices are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0447929e-066f-489e-900c-b3913ab0618b"],
 ". They are unequal, and von Neumann's theorem then forbids any self-adjoint \
extension whatever. Unlike the box, the half-line has no second endpoint \
whose phase could be twisted to restore the balance. Hermiticity is a \
property of a formula; self-adjointness is a property of a formula together \
with its domain, and the difference is physical, since only a self-adjoint \
operator has the real spectrum and unitary evolution that an observable \
requires."
}], "Text",ExpressionUUID->"34c7985a-e495-46bc-a9de-a2d913d6e28a"],

Cell["\<\
Part 3. The time-independent Schrodinger equation as an ODE eigenvalue problem\
\>", "Section",ExpressionUUID->"602f1b9c-e258-415e-bae8-6f3e0f6fe42a"],

Cell[TextData[{
 "The stationary Schrodinger equation ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox["1", "2"], 
   SuperscriptBox[
    StyleBox["\[Psi]", "TI"], "\[DoublePrime]"], "+", 
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["\[Psi]", "TI"], "=", 
   StyleBox["E", "TI"], 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cb8d4bb-2249-4b73-ab4c-8776cad45331"],
 " is an eigenvalue problem, and it is the boundary conditions, not the \
differential equation alone, that decide which energies are allowed. Where ",
 Cell[BoxData[
  StyleBox["E", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70e6977a-4b10-4543-8ebc-2769d69e5548"],
 " lies below the potential's value at infinity, the solutions that stay \
normalizable exist only at isolated energies, the discrete bound spectrum; \
above it every energy is permitted and the solutions are non-normalizable \
scattering states. Because ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a1b4a2d-860b-4841-b688-d5742f8bc5ea"],
 " is Hermitian, bound eigenfunctions of different energies are orthogonal \
and, once normalized, satisfy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SubsuperscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["m", "TI"], "*"], 
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["n", "TI"]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "=", 
   SubscriptBox[
    StyleBox["\[Delta]", "TI"], 
    StyleBox[
     RowBox[{"m", "n"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c8a038-0868-4552-a491-dd117d2bba55"],
 ", while together they are complete, so any state expands in them. Two \
structural facts then organize the spectrum, both resting on the \
non-degeneracy of bound levels in one dimension: in a symmetric potential ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc053ba0-121b-4db0-9222-16bb8c911171"],
 " every bound eigenstate has definite parity, and the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ab77702-3f9e-4af1-afd9-6e8b2cff7833"],
 "-th bound state has exactly ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f26a94aa-9d1b-4ed1-b8e3-b51e897a5d4c"],
 " nodes, so counting zeros counts levels. Closed forms exist only for \
particular potentials; elsewhere the quantization condition becomes a \
transcendental equation to be rooted, or the problem passes to a numerical \
eigensolver or to direct integration. Throughout, ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", 
   StyleBox["m", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7330e156-d7f6-4d05-b84b-f6f99fbd3c2d"],
 "."
}], "Text",ExpressionUUID->"e1674a26-a6e5-4393-abba-cf91406762ed"],

Cell[TextData[{
 "3.1 [BSc] How do I write the stationary Schrodinger equation ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox["1", "2"], 
   SuperscriptBox[
    StyleBox["\[Psi]", "TI"], "\[DoublePrime]"], "+", 
   StyleBox["V", "TI"], 
   StyleBox["\[Psi]", "TI"], "=", 
   StyleBox["E", "TI"], 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c70820db-ea59-4122-9787-b51b5bbfa1a3"],
 ", and what distinguishes a normalizable bound state from a scattering state?"
}], "Subsection",ExpressionUUID->"f42b9a8d-b3da-4fae-ba0a-bf945416b9bc"],

Cell[TextData[{
 "The stationary equation asks which functions the Hamiltonian merely \
rescales. It is an eigenvalue problem, and its two kinds of solution are \
separated not by the equation but by the energy: below the potential's value \
at infinity a solution can decay and be normalized, above it the solution \
must oscillate forever and cannot. To see both without changing potentials we \
take the Poschl-Teller family ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["\[Lambda]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   FractionBox[
    RowBox[{
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["\[Lambda]", "TI"], "+", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], 
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db809c22-4ff3-4fd7-8149-7b9d435b77a3"],
 ", a whole one-parameter tower of wells rather than a single one, whose ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ce3f103-2833-4fe6-9d00-854f38166af1"],
 " member is the well ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["V", "TI"], "1"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac321b9b-bf44-4739-8ab5-2e17a5b28745"],
 " with ground state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sech",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed2e8ed7-c657-4ca0-8b4d-8c9681ffdc7b"],
 "."
}], "Text",ExpressionUUID->"8cb8ab1c-3357-45ec-9382-a202d8dc9656"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Vpt", "[", 
    RowBox[{"x_", ",", " ", "\[Lambda]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"-", "\[Lambda]"}], " ", 
    RowBox[{"(", 
     RowBox[{"\[Lambda]", " ", "+", " ", "1"}], ")"}], " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Sech", "[", "x", "]"}], "^", "2"}], "/", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"asl", " ", "=", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{
     RowBox[{"\[Lambda]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"Element", "[", 
      RowBox[{"x", ",", " ", "Reals"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sech", "[", "x", "]"}], "^", "\[Lambda]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"Vpt", "[", 
        RowBox[{"x", ",", " ", "\[Lambda]"}], "]"}], " ", 
       RowBox[{
        RowBox[{"Sech", "[", "x", "]"}], "^", "\[Lambda]"}]}], "\n", "   ", "-",
       " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"\[Lambda]", "^", "2"}]}], "/", "2"}], ")"}], " ", 
       RowBox[{
        RowBox[{"Sech", "[", "x", "]"}], "^", "\[Lambda]"}]}]}], ",", " ", 
     "asl"}], "]"}], ",", "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sech", "[", "x", "]"}], "^", 
        RowBox[{"(", 
         RowBox[{"2", " ", "\[Lambda]"}], ")"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
       "asl"}], "]"}], ",", " ", "asl"}], "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[71]:= ",ExpressionUUID->"92b15ba0-eea4-4c81-878a-ac3d3e4682b6"],

Cell[TextData[{
 "The cell returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", 
    FractionBox[
     RowBox[{
      SqrtBox["\[Pi]"], " ", "\[CapitalGamma]", 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Lambda]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{"\[CapitalGamma]", 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Lambda]", "TI"], "+", 
       FractionBox["1", "2"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3eff6812-8df9-4fa3-b67c-cbf3221b7e51"],
 ": for ",
 StyleBox["every",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f4cf717-1bb6-4754-a6d4-bc8700c9c0f1"],
 " the function ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], 
    StyleBox["\[Lambda]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8355f46b-dc9e-46a1-8e18-5b25ec0017f5"],
 " is an exact bound state with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "0"], "=", "-", 
   SuperscriptBox[
    StyleBox["\[Lambda]", "TI"], "2"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e5c0f6c-a027-4347-8f11-de239c58d574"],
 ", and its squared norm is a closed form in ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "610aaa71-f43a-46cf-82ce-b0b00d4e10a7"],
 ". At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a337cc49-e917-4266-b19f-c2c45e1e33c7"],
 " that norm is ",
 Cell[BoxData[
  RowBox[{
   SqrtBox["\[Pi]"], " ", "\[CapitalGamma]", 
   StyleBox["(",
    SpanMaxSize->1], "1", 
   StyleBox[")",
    SpanMaxSize->1], "/", "\[CapitalGamma]", 
   StyleBox["(",
    SpanMaxSize->1], 
   FractionBox["3", "2"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6139ebb-376e-4ba8-af46-8c84babde341"],
 ", the familiar ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], "2"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "855ecd17-3359-4e58-bce3-f3b3abfd660e"],
 ", which is one member of a family rather than an isolated integral. The \
binding deepens as ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Lambda]", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d47794a-8379-4aa5-8b78-26a73ec402d6"],
 " while the well deepens as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Lambda]", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a5ae756-c099-4a4b-a9af-0f0a4ee5c8c1"],
 ", so a deeper well binds its ground state more tightly but not \
proportionally."
}], "Text",ExpressionUUID->"34ff4a33-566b-4bf8-8cdd-0aff87ab3e3b"],

Cell[TextData[{
 "One state is not a spectrum, and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cfaccc5f-099e-4b3f-9f7b-f1b584376087"],
 " is a poor advertisement for this family: it is the ",
 StyleBox["largest", "TI"],
 " coupling that binds only one state, since every ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Lambda]", "TI"], "\[Element]"}], "(", 
   RowBox[{"0", ",", "1"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ecb9c1d-ca78-4a33-bbef-e3a277bc2951"],
 " binds exactly one. Push ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4edda3e5-0530-49af-933f-17904f79f56f"],
 " past ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e8f6de8-b860-4116-ae97-8cfeb0c10fdf"],
 " and a tower appears, closing symbolically in ",
 StyleBox["both",
  FontWeight->"Bold"],
 " indices at once with no integer pinned anywhere."
}], "Text",ExpressionUUID->"a9a001ef-5537-4ff4-9709-a742a3084fb8"],

Cell[TextData[{
 "One caution decides which function to write down. A second-order equation \
has a two-dimensional solution space, so a vanishing residual says only that \
a function solves the equation, never that it is a state; normalizability is \
the extra condition, and it selects a branch. Here the normalizable branch is \
the associated Legendre function of ",
 StyleBox["negative", "TI"],
 " order, ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["\[Lambda]", "TI"], 
    RowBox[{"-", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["\[Lambda]", "TI"], "-", 
      StyleBox["n", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5c1ac24-35c3-4767-aa97-1343a25368a2"],
 ", because ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["\[Nu]", "TI"], 
    StyleBox["\[Mu]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[Tilde]", 
   FractionBox["1", 
    RowBox[{"\[CapitalGamma]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["\[Mu]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   FractionBox[
    RowBox[{"1", "+", 
     StyleBox["z", "TI"]}], 
    RowBox[{"1", "-", 
     StyleBox["z", "TI"]}]], 
   SuperscriptBox[
    StyleBox[")",
     FontSize->1.2 Inherited], 
    RowBox[{
     StyleBox["\[Mu]", "TI"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f999ec48-be7e-4311-aefd-ace27f94151b"],
 " as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "\[Rule]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "561230e1-efc8-4025-b70c-3aba9e1e8543"],
 ", so positive order diverges at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "\[Rule]", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a88ad74c-9071-474b-ab9b-3de55561f44b"],
 " except at positive integers, while negative order decays. Check the two \
conditions together, the residual and the norm:"
}], "Text",ExpressionUUID->"778d4de5-fee9-47fc-8df6-ea3d3246de85"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"H", "[", "\[Lambda]_", "]"}], "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], " ", 
     RowBox[{"D", "[", 
      RowBox[{"f", ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"Vpt", "[", 
      RowBox[{"x", ",", " ", "\[Lambda]"}], "]"}], " ", "f"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]t", "[", 
    RowBox[{"\[Lambda]_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{"LegendreP", "[", 
    RowBox[{"\[Lambda]", ",", " ", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"\[Lambda]", " ", "-", " ", "n"}], ")"}]}], ",", " ", 
     RowBox[{"Tanh", "[", "x", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"H", "[", "\[Lambda]", "]"}], "[", 
       RowBox[{"\[Psi]t", "[", 
        RowBox[{"\[Lambda]", ",", " ", "n"}], "]"}], "]"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Lambda]", " ", "-", " ", "n"}], ")"}], "^", "2"}]}], "/",
          "2"}], ")"}], " ", 
       RowBox[{"\[Psi]t", "[", 
        RowBox[{"\[Lambda]", ",", " ", "n"}], "]"}]}]}], ",", " ", "asl"}], 
    "]"}], ",", "\n", " ", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Psi]t", "[", 
       RowBox[{"1.3", ",", " ", "0"}], "]"}], "^", "2"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "30"}], ",", " ", "30"}], "}"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->
  "In[72]:= ",ExpressionUUID->"e22b7ce2-0f8f-44a8-bb4c-09250911bbf2"],

Cell[TextData[{
 "The residual is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "319c0c20-aa2d-44f5-9ec9-7e3992f4198a"],
 " and the norm is finite: ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["n", "TI"]], "\[Proportional]", 
   SubsuperscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["\[Lambda]", "TI"], 
    RowBox[{"-", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["\[Lambda]", "TI"], "-", 
      StyleBox["n", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d435484-093b-4833-9500-d18e865ebc15"],
 " is an exact ",
 StyleBox["bound",
  FontWeight->"Bold"],
 " state at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"]], "=", "-", 
   FractionBox[
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Lambda]", "TI"], "-", 
       StyleBox["n", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d198d3e5-5268-4534-b24c-e670b63f2621"],
 " for arbitrary ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7885d31f-8b33-4077-a954-3654ce9d8250"],
 " and arbitrary ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c047b40d-96d3-4449-969f-dce5125b759c"],
 ", the spectrum as a theorem rather than as a list. What ends the tower is \
normalizability and not the sign of the energy: ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"]], "=", "-", 
   FractionBox[
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Lambda]", "TI"], "-", 
       StyleBox["n", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a5cf6e5-8d1b-42fd-b61c-dc7270741c27"],
 " is negative for every ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[NotEqual]", 
   StyleBox["\[Lambda]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ff0bade-8849-4afb-a004-8fda92231c64"],
 ", including ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], ">", 
   StyleBox["\[Lambda]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "691683d4-207d-4e3c-b848-c46bc5e426e6"],
 ", but there the order ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Lambda]", "TI"], "-", 
    StyleBox["n", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de9b904f-f07a-4d44-9571-f4628ee80a8f"],
 " turns positive and the function diverges instead of decaying. The \
condition is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "-", 
   StyleBox["n", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25b319c5-8249-44d2-bcef-1fba3a3a0459"],
 ", so the well holds ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftCeiling]",
    SpanMaxSize->1], 
   StyleBox["\[Lambda]", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightCeiling]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c155d2b4-82ae-4894-a5a6-ad8a1a071ed1"],
 " states, and at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fa21219-caac-4339-ba71-db2e6fa2b37e"],
 " that count is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13e21853-31e9-49b9-9c91-5d09d2a6e5e2"],
 ": a single level, and no tower in sight."
}], "Text",ExpressionUUID->"87f8d537-13b2-477e-84f3-eaa0a1b2d73d"],

Cell[TextData[{
 "Nothing here is special to integer ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c667a18-0cbb-4ff8-b498-98f6309ab403"],
 ": ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", 
   FractionBox["5", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4301bd8-e84a-404a-8c88-292b86dc174f"],
 " carries ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], 
    RowBox[{"3", "/", "2"}]], 
   StyleBox["x", "TI"], 
   StyleBox["tanh",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15cbc040-60d8-4b7f-8b14-7110951c5524"],
 " at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "1"], "=", "-", 
   FractionBox["9", "8"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f33f061-01c7-41ab-80bb-f9e9c3d07eab"],
 " just as happily. But the ",
 StyleBox["elementary", "TI"],
 " members are worth seeing explicitly, since ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "020d60a8-fcc8-4a7f-9a37-40ae593b9c62"],
 " is where a second state first appears."
}], "Text",ExpressionUUID->"84367e89-a24a-4ddc-9ec3-400f248d0fbb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"H", "[", "2", "]"}], "[", 
      RowBox[{
       RowBox[{"Sech", "[", "x", "]"}], "^", "2"}], "]"}], " ", "-", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "2"}], ")"}], " ", 
      RowBox[{
       RowBox[{"Sech", "[", "x", "]"}], "^", "2"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"H", "[", "2", "]"}], "[", 
      RowBox[{
       RowBox[{"Sech", "[", "x", "]"}], " ", 
       RowBox[{"Tanh", "[", "x", "]"}]}], "]"}], " ", "-", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}], ")"}], " ", 
      RowBox[{"Sech", "[", "x", "]"}], " ", 
      RowBox[{"Tanh", "[", "x", "]"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"H", "[", "\[Lambda]", "]"}], "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sech", "[", "x", "]"}], "^", 
         RowBox[{"(", 
          RowBox[{"\[Lambda]", " ", "-", " ", "1"}], ")"}]}], " ", 
        RowBox[{"Tanh", "[", "x", "]"}]}], "]"}], "\n", "   ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Lambda]", " ", "-", " ", "1"}], ")"}], "^", "2"}]}], "/",
          "2"}], ")"}], " ", 
       RowBox[{
        RowBox[{"Sech", "[", "x", "]"}], "^", 
        RowBox[{"(", 
         RowBox[{"\[Lambda]", " ", "-", " ", "1"}], ")"}]}], " ", 
       RowBox[{"Tanh", "[", "x", "]"}]}]}], ",", "\n", "  ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{
       RowBox[{"\[Lambda]", " ", ">", " ", "1"}], " ", "&&", " ", 
       RowBox[{"Element", "[", 
        RowBox[{"x", ",", " ", "Reals"}], "]"}]}]}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->
  "In[73]:= ",ExpressionUUID->"2f8cb34f-52ce-4320-a397-f3c4f3d942ce"],

Cell[TextData[{
 "All three residuals vanish: the well ",
 Cell[BoxData[
  RowBox[{"-", "3", 
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], "2"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21254a78-0aa5-4b89-ae42-0003ad669fc6"],
 " holds ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], "2"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25e345f3-406b-46d3-8c39-0baa34913289"],
 " at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "0"], "=", "-", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42378785-b2f4-402a-afd2-83582f4d043e"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sech",
    FontSlant->"Plain"], 
   StyleBox["x", "TI"], 
   StyleBox["tanh",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71ba3f93-6c3b-4c56-a226-f091bde82e92"],
 " at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "1"], "=", "-", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec88ee3d-40d5-4cd3-b7f2-ff66dac45517"],
 ", and the third cell shows the first excited state is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["\[Lambda]", "TI"], "-", "1"}]], 
   StyleBox["x", "TI"], 
   StyleBox["tanh",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06a40f12-ac3f-4d3d-8f40-82250477155e"],
 " at ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox[
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Lambda]", "TI"], "-", "1"}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8294c42-97e4-4a25-aed3-09fe90865141"],
 " for every ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], ">", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a91118b1-6a26-48ce-a86d-35b0471d8181"],
 ", matching the assumption the cell carries: at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87c6e01c-afbb-41b0-912b-0d87b9bc472b"],
 " the well holds only its ground state and there is no excited level to \
find. That excited state is odd and has one node, which is parity and the \
node theorem arriving early."
}], "Text",ExpressionUUID->"7cc8b134-f4aa-4f04-b00d-e3a936bd6539"],

Cell[TextData[{
 "The coincidence ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "1"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Lambda]", "TI"], "2"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   FractionBox["1", "2"], "=", 
   SubscriptBox[
    StyleBox["E", "TI"], "0"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Lambda]", "TI"], "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aeb7a5b-05d9-4998-8c0b-f72f56eca5ec"],
 " is not a coincidence, and noticing it is not the same as explaining it. \
The explanation is a factorization: define ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["\[Lambda]", "TI"]], "=", 
   FractionBox["1", 
    SqrtBox["2"]], "(", 
   RowBox[{
    SubscriptBox["\[PartialD]", 
     StyleBox["x", "TI"]], "+", 
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["tanh",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["x", "TI"]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ca258b0-0b9c-457b-a2e9-a403090c503e"],
 " and its adjoint, and the whole tower follows."
}], "Text",ExpressionUUID->"dbc41015-0295-4430-a4cb-01fe30c53e32"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"A", "[", "\[Lambda]_", "]"}], "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"f", ",", " ", "x"}], "]"}], " ", "+", " ", 
      RowBox[{"\[Lambda]", " ", 
       RowBox[{"Tanh", "[", "x", "]"}], " ", "f"}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ad", "[", "\[Lambda]_", "]"}], "[", "f_", "]"}], " ", ":=", " ", 
   
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"D", "[", 
        RowBox[{"f", ",", " ", "x"}], "]"}]}], " ", "+", " ", 
      RowBox[{"\[Lambda]", " ", 
       RowBox[{"Tanh", "[", "x", "]"}], " ", "f"}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Ad", "[", "\[Lambda]", "]"}], "[", 
      RowBox[{
       RowBox[{"A", "[", "\[Lambda]", "]"}], "[", 
       RowBox[{"f", "[", "x", "]"}], "]"}], "]"}], " ", "-", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"H", "[", "\[Lambda]", "]"}], "[", 
        RowBox[{"f", "[", "x", "]"}], "]"}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Lambda]", "^", "2"}], "/", "2"}], " ", 
        RowBox[{"f", "[", "x", "]"}]}]}], ")"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"A", "[", "\[Lambda]", "]"}], "[", 
      RowBox[{
       RowBox[{"Ad", "[", "\[Lambda]", "]"}], "[", 
       RowBox[{"f", "[", "x", "]"}], "]"}], "]"}], " ", "-", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"H", "[", 
         RowBox[{"\[Lambda]", " ", "-", " ", "1"}], "]"}], "[", 
        RowBox[{"f", "[", "x", "]"}], "]"}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Lambda]", "^", "2"}], "/", "2"}], " ", 
        RowBox[{"f", "[", "x", "]"}]}]}], ")"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"A", "[", "\[Lambda]", "]"}], "[", 
      RowBox[{
       RowBox[{"Sech", "[", "x", "]"}], "^", "\[Lambda]"}], "]"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"\[Lambda]", " ", ">", " ", "0"}]}]}], "]"}]}], "}"}]}], "Input",\

 CellLabel->
  "In[74]:= ",ExpressionUUID->"dad6246d-8e01-44fd-8162-34145b5486d1"],

Cell[TextData[{
 "Three zeros, each doing separate work. The first is the factorization ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["\[Lambda]", "TI"]], "=", 
   SubsuperscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["\[Lambda]", "TI"], "\[Dagger]"], 
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["\[Lambda]", "TI"]], "-", 
   FractionBox[
    SuperscriptBox[
     StyleBox["\[Lambda]", "TI"], "2"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f617919-0719-4c21-add2-f0db784ca77f"],
 ", which alone proves no state can lie below ",
 Cell[BoxData[
  RowBox[{"-", 
   SuperscriptBox[
    StyleBox["\[Lambda]", "TI"], "2"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50cf4901-763a-483e-8cb8-3cba6ad57335"],
 ", since ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["A", "TI"], "\[Dagger]"], 
   StyleBox["A", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "333be26c-e646-4d6b-8b3f-3b34b57cf20c"],
 " is positive. The second is ",
 StyleBox["shape invariance",
  FontWeight->"Bold"],
 ": reversing the product gives the ",
 StyleBox["same family with ", "TI"],
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "\[Rule]", 
   StyleBox["\[Lambda]", "TI"], "-", "1"}]], "InlineFormula", "TI",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6a2980b-b4af-4065-b50a-f5ae03a5aea1"],
 ", so ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["A", "TI"], 
   StyleBox["\[Lambda]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4ed09af-ab36-44aa-80da-e5a0ba4124f0"],
 " maps the spectrum of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], 
   StyleBox["\[Lambda]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6ed1b30-a7e4-4acd-867f-bfa73c5e132a"],
 " onto that of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], 
   RowBox[{
    StyleBox["\[Lambda]", "TI"], "-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a24a1e9c-08b1-4b52-8f54-ac83472a0475"],
 " and the ladder is forced, not observed. The third says the ground state is \
annihilated, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["\[Lambda]", "TI"]], 
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], 
    StyleBox["\[Lambda]", "TI"]], 
   StyleBox["x", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a33f4d-8ec5-48a8-860e-6a13a5e18108"],
 ", which is why ",
 Cell[BoxData[
  RowBox[{"-", 
   SuperscriptBox[
    StyleBox["\[Lambda]", "TI"], "2"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "621c2f9a-6814-4038-8dad-65d5a80fef42"],
 " is attained rather than merely bounded. This is the machinery of 8.5 and \
8.6, and the tower above is its corollary."
}], "Text",ExpressionUUID->"6cd280eb-04bb-451d-ad07-78056d07b4f0"],

Cell[TextData[{
 "Now the other half of the spectrum, at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3cfbaab-5c26-486d-b4be-6b2dfdf76591"],
 " where the scattering state is simplest."
}], "Text",ExpressionUUID->"fab26175-91a8-4001-be7d-8a6f4eb0b3a3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]k", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "k", " ", "x"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Tanh", "[", "x", "]"}], " ", "-", " ", 
      RowBox[{"I", " ", "k"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"\[Psi]k", "[", "x", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"Vpt", "[", 
        RowBox[{"x", ",", " ", "1"}], "]"}], " ", 
       RowBox[{"\[Psi]k", "[", "x", "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k", "^", "2"}], "/", "2"}], ")"}], " ", 
       RowBox[{"\[Psi]k", "[", "x", "]"}]}]}], ",", "\n", "  ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"Element", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "x"}], "}"}], ",", " ", "Reals"}], "]"}]}]}], 
    "]"}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Psi]k", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "k", " ", "x"}], "]"}]}], ",", " ", 
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "Infinity"}]}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"Element", "[", 
         RowBox[{"k", ",", " ", "Reals"}], "]"}]}]}], "]"}], ",", "\n", "  ", 
     
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Psi]k", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "k", " ", "x"}], "]"}]}], ",", " ", 
       RowBox[{"x", " ", "->", " ", "Infinity"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"Element", "[", 
         RowBox[{"k", ",", " ", "Reals"}], "]"}]}]}], "]"}]}], "}"}]}], 
  "}"}]}], "Input",
 CellLabel->
  "In[75]:= ",ExpressionUUID->"ef56df62-c8cf-42c2-9039-98cb3cde4c20"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tk", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"ComplexExpand", "[", 
      RowBox[{
       RowBox[{"Arg", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"I", " ", "k"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], " ", "-", " ", 
           RowBox[{"I", " ", "k"}]}], ")"}]}], "]"}], ",", " ", 
       RowBox[{"TargetFunctions", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Re", ",", " ", "Im"}], "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"k", " ", ">", " ", "0"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d0", " ", "=", " ", 
   RowBox[{"Limit", "[", 
    RowBox[{"tk", ",", " ", 
     RowBox[{"k", " ", "->", " ", "0"}], ",", " ", 
     RowBox[{"Direction", " ", "->", " ", "\"\<FromAbove\>\""}]}], "]"}]}], ";",
   " ", 
  RowBox[{"dInf", " ", "=", " ", 
   RowBox[{"Limit", "[", 
    RowBox[{"tk", ",", " ", 
     RowBox[{"k", " ", "->", " ", "Infinity"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"I", " ", "k"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], " ", "-", " ", 
          RowBox[{"I", " ", "k"}]}], ")"}]}], "]"}], "^", "2"}], ",", " ", 
     RowBox[{"Element", "[", 
      RowBox[{"k", ",", " ", "Reals"}], "]"}]}], "]"}], ",", " ", "tk", ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"d0", ",", " ", "dInf", ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"d0", " ", "-", " ", "dInf"}], ")"}], "/", "Pi"}]}], "}"}]}], 
  "}"}]}], "Input",
 CellLabel->
