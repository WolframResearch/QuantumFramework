CellTagsIndex->{}
*)
(*NotebookFileOutline
Notebook[{
Cell[554, 20, 132, 0, 70, "Title",ExpressionUUID->"dd21e3b3-97e5-4a0a-ac8e-984fc32f19f4"],
Cell[689, 22, 1118, 26, 70, "Text",ExpressionUUID->"ce06fac6-e78d-49cf-8973-643a64c1b516"],
Cell[1810, 50, 301, 7, 70, "Section",ExpressionUUID->"bfa36f7b-b13f-4b46-88d3-0ad26558054f"],
Cell[2114, 59, 5806, 188, 70, "Text",ExpressionUUID->"d5b745c8-7bdc-4ead-9930-00408c2bdd00"],
Cell[7923, 249, 942, 29, 70, "Subsection",ExpressionUUID->"763e7f36-68ee-4fa2-a9ea-dacc917a2a16"],
Cell[8868, 280, 2124, 60, 70, "Text",ExpressionUUID->"5d7880e2-cc76-4c55-bd9c-340c8af72eef"],
Cell[10995, 342, 3269, 101, 70, "Text",ExpressionUUID->"23c87b31-81bc-46a2-8769-5d0ac28ae146"],
