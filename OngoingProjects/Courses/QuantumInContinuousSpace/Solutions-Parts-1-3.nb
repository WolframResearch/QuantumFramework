Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tAmp", "[", 
    RowBox[{"\[Lambda]_", ",", " ", "k_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Gamma", "[", 
     RowBox[{"1", " ", "+", " ", "\[Lambda]", " ", "-", " ", 
      RowBox[{"I", " ", "k"}]}], "]"}], " ", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{
       RowBox[{"-", "\[Lambda]"}], " ", "-", " ", 
       RowBox[{"I", " ", "k"}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"I", " ", "k"}]}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "k"}], "]"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"refl", "[", 
    RowBox[{"\[Lambda]_", ",", " ", "k_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"Pi", " ", "\[Lambda]"}], "]"}], "^", "2"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"Pi", " ", "\[Lambda]"}], "]"}], "^", "2"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"Sinh", "[", 
        RowBox[{"Pi", " ", "k"}], "]"}], "^", "2"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"tAmp", "[", 
       RowBox[{"1", ",", " ", "k"}], "]"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"I", " ", "k"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], " ", "-", " ", 
         RowBox[{"I", " ", "k"}]}], ")"}]}]}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"k", " ", ">", " ", "0"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"1", " ", "-", " ", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"tAmp", "[", 
         RowBox[{"\[Lambda]", ",", " ", "k"}], "]"}], "]"}], "^", "2"}], " ", 
      "-", " ", 
      RowBox[{"refl", "[", 
       RowBox[{"\[Lambda]", ",", " ", "k"}], "]"}]}], ",", "\n", "  ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{
       RowBox[{"k", " ", ">", " ", "0"}], " ", "&&", " ", 
       RowBox[{"\[Lambda]", " ", ">", " ", "0"}]}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"N", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"refl", "[", 
       RowBox[{"\[Lambda]", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\[Lambda]", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", 
          RowBox[{"1", "/", "2"}], ",", " ", 
          RowBox[{"3", "/", "2"}], ",", " ", 
          RowBox[{"13", "/", "10"}]}], "}"}]}], "}"}]}], "]"}]}]}], 
  "}"}]}], "Input",
 CellLabel->
  "In[77]:= ",ExpressionUUID->"6169773f-88f1-4a4e-a78d-41339f8b14ae"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"Arg", "[", 
      RowBox[{"tAmp", "[", 
       RowBox[{
        RowBox[{"13", "/", "10"}], ",", " ", 
        RowBox[{"10.", "^", 
         RowBox[{"-", "8"}]}]}], "]"}], "]"}], "/", "Pi"}], "]"}], ",", " ", 
   RowBox[{"Ceiling", "[", 
    RowBox[{"13", "/", "10"}], "]"}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"tAmp", "[", 
        RowBox[{
         RowBox[{"13", "/", "10"}], ",", " ", 
         RowBox[{"10.", "^", 
          RowBox[{"-", "8"}]}]}], "]"}], "]"}], "^", "2"}], ",", " ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"tAmp", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"10.", "^", 
          RowBox[{"-", "8"}]}]}], "]"}], "]"}], "^", "2"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"LegendreP", "[", 
       RowBox[{"1", ",", " ", "0", ",", " ", 
        RowBox[{"Tanh", "[", "x", "]"}]}], "]"}], "]"}], ",", "\n", "  ", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}]}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Tanh", "[", "x", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"Vpt", "[", 
         RowBox[{"x", ",", " ", "1"}], "]"}], " ", 
        RowBox[{"Tanh", "[", "x", "]"}]}]}], "]"}]}], "}"}]}], "}"}]], "Input",\

 CellLabel->
  "In[78]:= ",ExpressionUUID->"e0efcb34-a0cc-46a1-92ae-5652105a73d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dens", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"\[Psi]k", "[", "x", "]"}], "]"}], "^", "2"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"Element", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "x"}], "}"}], ",", " ", "Reals"}], "]"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pn", " ", "=", " ", 
   RowBox[{"Integrate", "[", 
    RowBox[{"dens", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "a"}], ",", " ", "a"}], "}"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{
       RowBox[{"a", " ", ">", " ", "0"}], " ", "&&", " ", 
       RowBox[{"Element", "[", 
        RowBox[{"k", ",", " ", "Reals"}], "]"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"dens", ",", " ", "pn", ",", " ", 
   RowBox[{"Limit", "[", 
    RowBox[{"pn", ",", " ", 
     RowBox[{"a", " ", "->", " ", "Infinity"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"Element", "[", 
       RowBox[{"k", ",", " ", "Reals"}], "]"}]}]}], "]"}]}], "}"}]}], "Input",\

 CellLabel->
  "In[79]:= ",ExpressionUUID->"7910bcad-49fc-4aa6-b248-8210a2238557"],

Cell[TextData[{
 "The residual is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b7fa97e-bd77-456c-b8ac-e80c80061933"],
 " for every real ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1672b60-4bf4-4ec9-a504-f3465542f3df"],
 ": ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["k", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "k", "x"}], "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["x", "TI"], "-", 
    StyleBox["i", "TI"], 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cab4871-d466-4f1b-ab44-c8fefc9643c7"],
 " solves the ",
 StyleBox["same", "TI"],
 " equation at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], "/", "2", ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fdbcce0-8ef8-495c-b42c-abee50319fb9"],
 ". The difference from the bound state is entirely in the norm. ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], 
        StyleBox["k", "TI"]]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], "+", 
   SuperscriptBox[
    StyleBox["tanh",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e28e124d-7910-4b42-a3f4-751549d41585"],
 " integrates over ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", 
     StyleBox["a", "TI"]}], ",", 
    StyleBox["a", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e670b76-502e-4306-a83e-c930a35df6f8"],
 " to exactly ",
 Cell[BoxData[
  RowBox[{"2", "(", 
   RowBox[{
    StyleBox["a", "TI"], "+", 
    StyleBox["a", "TI"], 
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", 
    StyleBox["tanh",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["a", "TI"]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "191a1019-6abc-4676-ac38-498b8752182a"],
 ", growing linearly in the box and diverging as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "\[Rule]", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81e0ef6c-34ba-4e04-a978-189de8262c91"],
 ". No constant can normalize it, so it must be delta-normalized in the sense \
of a delta-normalized momentum eigenstate, and the linear growth is why: the \
natural measure of a continuum state is ",
 StyleBox["per unit length", "TI"],
 ", and ",
 Cell[BoxData[
  RowBox[{"1", "+", 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e96b3450-8c59-403b-a3af-65ffef37e726"],
 " is that density."
}], "Text",ExpressionUUID->"2afff0d9-5a76-4fab-9b5f-4627c145836d"],

Cell[TextData[{
 "The reflectionless statement is done properly by stripping the carrier \
wave. ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["k", "TI"]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["k", "TI"], 
     StyleBox["x", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84c09b4b-ca09-48f2-a564-f6487f02af9e"],
 " tends to the constant ",
 Cell[BoxData[
  RowBox[{"-", "1", "-", 
   StyleBox["i", "TI"], 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "186c88d5-60cb-48da-8df8-6a1b28af1606"],
 " as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "\[Rule]", "-", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f803c6a-0077-42cc-b293-44ed48621b5b"],
 " and to ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   StyleBox["i", "TI"], 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3437ddd7-296e-4252-9a4b-d19a273df090"],
 " as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "\[Rule]", "+", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "282fcb6c-5297-46c0-af14-5593107fa102"],
 ". Constants, both: on the left there is ",
 StyleBox["no",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "2", 
    StyleBox["i", "TI"], 
    StyleBox["k", "TI"], 
    StyleBox["x", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4678c69-b356-4623-acb9-4febddae0c1b"],
 " piece, so the reflected amplitude is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "961ffd14-65b2-488a-9656-b64b08de7ff5"],
 " identically, not merely small. (This is why the limit existing at all is \
the content: had there been a reflected piece, ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox[
    StyleBox["lim",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["x", "TI"], "\[Rule]", "-", "\[Infinity]"}],
    LimitsPositioning->False], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "2", 
     StyleBox["i", "TI"], 
     StyleBox["k", "TI"], 
     StyleBox["x", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2117d6f-ca6a-4426-b611-29d7e2d47e9d"],
 " is ",
 Cell[BoxData["Indeterminate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24e77ff1-dbaa-4705-a8a3-02893c311875"],
 " and the cell would not have returned a number.) Equal asymptotic densities \
on the two sides would have been necessary but not sufficient."
}], "Text",ExpressionUUID->"b3e3f848-f773-47fe-a547-69a76d855e2d"],

Cell[TextData[{
 "The transmission is then ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["i", "TI"], 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", "1", "-", 
    StyleBox["i", "TI"], 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae8e9f06-c103-4bb4-8a39-37a17db3a78b"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       StyleBox["t", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07afc142-2a3f-4d63-893a-80610ed68dce"],
 " for every ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "350b1be2-022c-4b20-88ef-d4a95c886bfb"],
 ": perfectly transparent at every energy, all it does is imprint the phase \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["k", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["arg",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["t", "TI"], "=", 
   StyleBox["arctan",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["k", "TI"], "2"], "-", "1"}], ",", 
    RowBox[{"2", 
     StyleBox["k", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e400bf3-6cdd-4c62-86dd-69d4fdfc4c6b"],
 ", which is ",
 Cell[BoxData[
  RowBox[{"\[Pi]", "-", "2", 
   StyleBox["arctan",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d1645d9-5b7c-418e-b586-be187513c5c9"],
 ". And at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41e26386-0cae-4bf6-ae8b-70efbf433c43"],
 " that phase counts the bound states: the third entry returns ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "\[Pi]"}], ",", " ", "0", ",", " ", "1"}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8e55aab-7a13-4989-8398-a334f0b28c8f"],
 ", so ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    StyleBox["\[Delta]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], "0", 
    StyleBox[")",
     SpanMaxSize->1], "-", 
    StyleBox["\[Delta]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], "\[Infinity]", 
    StyleBox[")",
     SpanMaxSize->1]}], ")", "/", "\[Pi]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a7773fe-7b7f-489b-ae9f-e442e52baab9"],
 ", matching the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftCeiling]",
    SpanMaxSize->1], 
   StyleBox["\[Lambda]", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightCeiling]",
    SpanMaxSize->1], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81d526c9-1b9f-4afb-b47b-ef019eff32b0"],
 " counted from the tower. That is ",
 StyleBox["Levinson's theorem",
  FontWeight->"Bold"],
 ", and the two halves of this question are not independent facts."
}], "Text",ExpressionUUID->"ca96de22-2a84-4aad-b888-cceeb5504d9c"],

Cell[TextData[{
 StyleBox["But the count comes out an integer here only because ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"4f7f6453-f92d-4d02-b899-0025338276d6"],
 StyleBox[" is exceptional.",
  FontWeight->"Bold"],
 " In one dimension Levinson's theorem carries a half-unit: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "(", 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["b", "TI"]], "-", 
    FractionBox["1", "2"]}], ")", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f13021b7-95b7-4304-87c3-a9923d649683"],
 " generically. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", 
   FractionBox["13", "10"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c5c7785-f412-4cea-aff8-27cf35c27ac9"],
 " the cell returns ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "/", "\[Pi]", "=", "-", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9270df42-adac-46b1-9c03-2cd5221df810"],
 " against ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["b", "TI"]], "=", 
   StyleBox["\[LeftCeiling]",
    SpanMaxSize->1], "1.3", 
   StyleBox["\[RightCeiling]",
    SpanMaxSize->1], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c56dbd-f25b-479d-aa7d-136edf0f95eb"],
 ", and the two reconcile only modulo ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cd1e087-463a-4cd2-acaa-6d57aee940c2"],
 ": ",
 Cell[BoxData["Arg"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f33ca8c4-11b4-4f3a-8bff-f8cceafa93f6"],
 " is principal-valued on ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{"-", "\[Pi]"}], ",", "\[Pi]", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52af434b-d3a0-445c-b5b6-87de55943e92"],
 ", so it pins the phase only up to ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b7ac4b5-4278-4839-95be-47dee3620122"],
 ", and unwrapping gives ",
 Cell[BoxData[
  RowBox[{
   FractionBox["3", "2"], "=", 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["b", "TI"]], "-", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16150fa7-3da6-4525-9c11-903be249d6cd"],
 ". That caveat is not cosmetic, because it means this cell by itself cannot \
count bound states: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bf79389-6f84-43ba-b46c-04c9938d1996"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["b", "TI"]], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "921d0d3b-3487-4297-ab16-7657009bb7bc"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", 
   FractionBox["12", "5"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8dba7299-a640-45b4-9467-5833947c049d"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["b", "TI"]], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "472f43eb-fca2-4226-b560-7fad50f1a315"],
 " both return ",
 Cell[BoxData[
  RowBox[{"+", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "831af88f-173a-4f08-9877-c2af75d4967d"],
 ". Counting requires following the phase continuously in ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d04118a-da95-4621-a011-1ad060baae61"],
 " and unwrapping it, not reading one principal value. The integer ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ba9478b-5615-4501-9e5c-ed05e4370ccd"],
 " are the exception, and the reason is in the same cell: ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        StyleBox["t", "TI"], 
        StyleBox["(",
         SpanMaxSize->1], "0", 
        StyleBox[")",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b7d5d2e-19d6-45c0-b2e0-ef8f3b167cb7"],
 " at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3492bc9-1d68-4421-b46a-59d7c08e522d"],
 " but ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"-", "15"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab760c11-2e7a-428c-8d24-e02d80635740"],
 " at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1.3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99461117-c7c0-49c8-b515-a149594c75e0"],
 ". Generic wells reflect ",
 StyleBox["totally", "TI"],
 " at zero energy; integer-",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86f1d39e-bfd7-4b02-a228-ff7f26bf8ed0"],
 " wells transmit perfectly even there, a zero-energy resonance, and it is \
that resonance that promotes the half-unit to a whole one."
}], "Text",ExpressionUUID->"50543cb7-8a78-423d-9dba-51d3c5e36bb0"],

Cell[TextData[{
 "The resonance has a name and it has been hiding in our own formulas. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a922326-5509-44bd-95fe-89d115ec984a"],
 " the scattering state degenerates to ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], "0"], "=", 
   StyleBox["tanh",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1dd1793-664d-4e0b-ae9b-0d92e6689f92"],
 ", which the cell confirms is exactly ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["\[Lambda]", "TI"], 
    RowBox[{
     StyleBox["\[Lambda]", "TI"], "-", 
     StyleBox["n", "TI"]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c97e0f4-1ef9-4be6-95ff-ad4ce80e2849"],
 " at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", 
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fd412de-70be-41a2-be01-8e336c391063"],
 ", the top member of the tower, sitting precisely at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc10a516-fe8e-4555-9ca8-3ceac5d28619"],
 ". It solves ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["H", "TI"], "1"], 
   StyleBox["\[Psi]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4f71e7f-1407-4100-ba5e-3ed335282e98"],
 " (residual ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f506cba-4c68-44cd-a7de-afb67861e8a1"],
 "), it is bounded, and it is not normalizable: a ",
 StyleBox["half-bound state",
  FontWeight->"Bold"],
 ", neither in the discrete spectrum nor properly in the continuum. That is \
also why the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d06fcb72-bfe9-48a5-aa79-03a41b91ddce"],
 " limit needed ",
 Cell[BoxData[
  RowBox[{"Direction", " ", "->", " ", "\"\<FromAbove\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7b2cf0e-e5f3-4ebe-b963-d92c0e42c877"],
 ": at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e4952ce-e177-4ba5-8857-8ee1a9405c84"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "468d30c0-e301-4911-851e-a105102ecc7a"],
 " exactly, and ",
 Cell[BoxData["Arg"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c51c7b19-6ed3-47b4-986d-7b023a10503c"],
 " sits on its branch cut there. At generic ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56bd4be6-0c0f-4cc5-b246-640b37c2819c"],
 " the limit fails for a different reason entirely, namely ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "131252c1-d51b-4f2b-ba9d-79831924918d"],
 "."
}], "Text",ExpressionUUID->"07682396-d6ea-4233-b5db-7deb1ec95258"],

Cell[TextData[{
 "The reflection coefficient of the whole family says why transparency is \
quantized: ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["\[Lambda]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["k", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["sin",
       FontSlant->"Plain"], "2"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[Pi]", 
      StyleBox["\[Lambda]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{
     SuperscriptBox[
      StyleBox["sin",
       FontSlant->"Plain"], "2"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[Pi]", 
      StyleBox["\[Lambda]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "+", 
     SuperscriptBox[
      StyleBox["sinh",
       FontSlant->"Plain"], "2"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[Pi]", 
      StyleBox["k", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "715d2645-e286-4706-bf06-253b9f200e4d"],
 ", which vanishes ",
 StyleBox["identically in ",
  FontWeight->"Bold"],
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"02b10a66-487a-4e6e-ab5e-3d002f7157b2"],
 " exactly when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", 
    StyleBox["\[Lambda]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ebd067f-95ae-4d12-bd0a-f41d4233e48e"],
 ". Numerically it is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "0"}], ",", "0", ",", 
   RowBox[{"0", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cc4f08e-1707-465f-a00d-6dc48ef10262"],
 " at ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Lambda]", "TI"], "=", "1"}], ",", 
   RowBox[{"2", ",", "3"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "417d5cc8-9656-4277-bec7-738487a62b42"],
 " against ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "0.0074"}], ",", "0.0074", ",", 
   RowBox[{"0.0049", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54cf92bd-90be-4499-969b-100b51aaf996"],
 " at ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Lambda]", "TI"], "=", 
    FractionBox["1", "2"]}], ",", 
   FractionBox["3", "2"], ",", "1.3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62bd2bcf-c494-4fad-96c8-d78b148cb1de"],
 ". That formula must not be taken on faith, so the cell above ties it to the \
equation rather than to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", 
    StyleBox["\[Lambda]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d525615-e5d1-4ef3-97cd-ce08d7013c42"],
 ": the transmission amplitude of the family is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", 
   FractionBox[
    RowBox[{"\[CapitalGamma]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      StyleBox["\[Lambda]", "TI"], "-", 
      StyleBox["i", "TI"], 
      StyleBox["k", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "\[CapitalGamma]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"-", 
      StyleBox["\[Lambda]", "TI"], "-", 
      StyleBox["i", "TI"], 
      StyleBox["k", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{"\[CapitalGamma]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["i", "TI"], 
      StyleBox["k", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "\[CapitalGamma]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["k", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a754b4a-f4ef-4805-9731-fe53e3944c46"],
 ", which reduces to the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["i", "TI"], 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", "1", "-", 
    StyleBox["i", "TI"], 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "228b39cc-4990-40c1-8dfb-66e0543a7734"],
 " derived above at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29f6af90-4344-409d-8c6a-54c475f90008"],
 " (first entry, ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01b27c03-57eb-4334-bc02-1192588a7522"],
 "), and ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["t", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "-", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["\[Lambda]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81de6cd0-f214-48b1-a037-e46f4b06cb04"],
 " vanishes symbolically for arbitrary ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f7d5f0b-58ae-4ea9-ad56-f746bfc31349"],
 " and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "251fe6fc-d113-4f39-8338-39440b74b2f4"],
 " (second entry, ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e3ed0df-3b2e-458f-bf79-a5fb361413e5"],
 "). Unitarity is the link: without it, ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47bf6e2c-2541-4ba5-8e47-8eb38f09b7cd"],
 " would be a formula asserted next to some numbers, and a wrong one with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sinh",
    FontSlant->"Plain"], "\[ThinSpace]", "\[Rule]", 
   StyleBox["cosh",
    FontSlant->"Plain"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e320d25-c100-4b56-afcc-70daa68ed2b9"],
 " would sail through the same numerical spot-checks."
}], "Text",ExpressionUUID->"80a364be-5bf1-4bf7-9edc-a1d3049e24b0"],

Cell[TextData[{
 "So reflectionlessness is not a property of ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["sech",
    FontSlant->"Plain"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1f20174-516b-490d-849a-740535a332d9"],
 " wells in general, it is a property of the ones whose coupling sits at an \
integer ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e49bdcd-0d88-41e2-83c2-56ccd28d4e21"],
 ", where a half-bound state sits at threshold. The ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbc12379-02e6-49d7-aa0c-4c0fd44118e0"],
 " well is the first of them, and its single bound state and its transparency \
are the same fact about ",
 Cell[BoxData[
  StyleBox["sech",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43d7749a-7171-4d92-bb12-330ed5ea6d43"],
 " seen from two sides."
}], "Text",ExpressionUUID->"5c930422-bfb0-47c1-812a-36adad912e84"],

Cell["\<\
3.2 [BSc] How do I solve the infinite square well by imposing boundary \
conditions on the ODE, and read off the spectrum and eigenfunctions?\
\>", "Subsection",ExpressionUUID->"0dbc88a9-264d-41e6-a4ba-d11f802ff15d"],

Cell[TextData[{
 "The infinite well is the one bound-state problem that is exactly solvable \
with nothing but a boundary condition, so it is the benchmark every later \
numerical route is measured against. Routing it: the class is a second-order \
linear ODE eigenproblem on a bounded domain with homogeneous Dirichlet \
conditions, which admits the exact symbolic eigenproblem (",
 Cell[BoxData["DEigensystem"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14cd8f67-fba4-48e2-8f96-72b455f19264"],
 "), and exactness is the first criterion, so that is the primary route. It \
closes, and it closes with ",
 Cell[BoxData[
  StyleBox["L", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5eb6399c-2bdf-4126-bfdd-4db7166370e4"],
 " still symbolic, which no numerical route could give."
}], "Text",ExpressionUUID->"c696af43-9857-492e-9535-4c25a0b86247"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"es", ",", " ", "fs"}], "}"}], " ", "=", " ", 
  RowBox[{"DEigensystem", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u", "[", "x", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", 
      RowBox[{"DirichletCondition", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"u", "[", "x", "]"}], " ", "==", " ", "0"}], ",", " ", 
        "True"}], "]"}]}], "}"}], ",", "\n", "   ", 
    RowBox[{"u", "[", "x", "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "0", ",", " ", "L"}], "}"}], ",", " ", "4", ",", 
    " ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{"L", " ", ">", " ", "0"}]}], ",", " ", 
    RowBox[{"Method", " ", "->", " ", "\"\<Normalize\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[80]:= ",ExpressionUUID->"7a8ebdc6-11c4-4d1c-abc7-4ee35d7d46f5"],

Cell[BoxData[
 RowBox[{"DEigenvalues", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}]}], " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"u", "[", "x", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", 
   RowBox[{"u", "[", "x", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "0", ",", " ", "L"}], "}"}], ",", " ", "4", ",", 
   " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"L", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[81]:= ",ExpressionUUID->"917509b5-e0b4-4323-9aa8-923fddacecfc"],

Cell[TextData[{
 "The first cell returns the spectrum ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    FractionBox[
     SuperscriptBox["\[Pi]", "2"], 
     RowBox[{"2", 
      SuperscriptBox[
       StyleBox["L", "TI"], "2"]}]], ",", 
    FractionBox[
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], 
     SuperscriptBox[
      StyleBox["L", "TI"], "2"]], ",", 
    FractionBox[
     RowBox[{"9", 
      SuperscriptBox["\[Pi]", "2"]}], 
     RowBox[{"2", 
      SuperscriptBox[
       StyleBox["L", "TI"], "2"]}]], ",", 
    FractionBox[
     RowBox[{"8", 
      SuperscriptBox["\[Pi]", "2"]}], 
     SuperscriptBox[
      StyleBox["L", "TI"], "2"]]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68390c59-5c1f-4211-948e-a082d57fb7a3"],
 " with the normalized eigenfunctions ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    RowBox[{"2", "/", 
     StyleBox["L", "TI"]}]], " ", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["n", "TI"], "\[Pi]", 
    StyleBox["x", "TI"], "/", 
    StyleBox["L", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15e250a0-5106-4c48-b0ed-2fd69777bcf6"],
 ": the energies scale as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SuperscriptBox[
    StyleBox["L", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56ea61eb-3ed6-4654-a118-f97b60fe8dd9"],
 ", so squeezing the box costs energy quadratically, which is the uncertainty \
principle wearing a boundary condition."
}], "Text",ExpressionUUID->"1c0135a6-eca7-466b-9adf-a5a819b0fae5"],

Cell[TextData[{
 "The second cell is the trap, and it is worth running. Drop the ",
 Cell[BoxData["DirichletCondition"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e38d03c6-7865-4fd7-897a-a6332c1ad69b"],
 " and ",
 Cell[BoxData["DEigenvalues"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e049a85-bfd5-44be-b4d1-066dcec36d1d"],
 " does not complain: it returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", 
    FractionBox[
     SuperscriptBox["\[Pi]", "2"], 
     RowBox[{"2", 
      SuperscriptBox[
       StyleBox["L", "TI"], "2"]}]], ",", 
    FractionBox[
     RowBox[{"2", 
      SuperscriptBox["\[Pi]", "2"]}], 
     SuperscriptBox[
      StyleBox["L", "TI"], "2"]], ",", 
    FractionBox[
     RowBox[{"9", 
      SuperscriptBox["\[Pi]", "2"]}], 
     RowBox[{"2", 
      SuperscriptBox[
       StyleBox["L", "TI"], "2"]}]]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc0f63e1-7d26-4e2d-9750-d6c451cb9466"],
 ", the ",
 StyleBox["Neumann", "TI"],
 " spectrum, headed by a spurious zero-energy state (the constant function, \
which has zero derivative at both walls and is not an infinite-well state at \
all). No boundary condition does not mean no boundary condition; it means ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Psi]", "TI"], "\[Prime]"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25336588-6363-46a6-a441-8975189b7893"],
 " at the walls. The physics of the infinite well is the Dirichlet condition, \
and supplying it is not a formality."
}], "Text",ExpressionUUID->"cf75b835-cc07-4f51-b4eb-094b7b282044"],

Cell[TextData[{
 "Four levels are four data points, not a theorem, and ",
 Cell[BoxData["DEigensystem"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da34a3a-ae42-475f-9901-629bd251d65e"],
 " cannot be asked for a symbolic count (given ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f11de0e-844c-46fb-a174-dc6b990543fb"],
 " in place of ",
 Cell[BoxData["4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "187c6bf3-1eb9-4971-bc42-d18878c9678c"],
 " it returns unevaluated). So the general claim ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"]], "=", 
   SuperscriptBox[
    StyleBox["n", "TI"], "2"], 
   SuperscriptBox["\[Pi]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SuperscriptBox[
     StyleBox["L", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffda75e1-f982-4f1f-b526-09a6d92bff42"],
 " has to be made by supplying the closed form and verifying the eigenvalue \
equation as an identity in ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9402e6a-46e6-4ba1-a25e-09d293c17b6c"],
 "."
}], "Text",ExpressionUUID->"0af589dc-e814-4406-b2f3-2b58f6b7df22"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]n", "[", 
    RowBox[{"n_", ",", " ", "x_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", "/", "L"}], "]"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"n", " ", "Pi", " ", 
      RowBox[{"x", "/", "L"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"asn", " ", "=", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{
     RowBox[{"L", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"Element", "[", 
      RowBox[{"n", ",", " ", "Integers"}], "]"}], " ", "&&", " ", 
     RowBox[{"n", " ", ">=", " ", "1"}]}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"\[Psi]n", "[", 
          RowBox[{"n", ",", " ", "x"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"n", "^", "2"}], " ", 
         RowBox[{
          RowBox[{"Pi", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", 
            RowBox[{"L", "^", "2"}]}], ")"}]}]}], ")"}], " ", 
       RowBox[{"\[Psi]n", "[", 
        RowBox[{"n", ",", " ", "x"}], "]"}]}]}], ",", " ", "asn"}], "]"}], ",",
    "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Psi]n", "[", 
         RowBox[{"n", ",", " ", "x"}], "]"}], "^", "2"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "0", ",", " ", "L"}], "}"}], ",", " ", "asn"}],
       "]"}], ",", " ", "asn"}], "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[82]:= ",ExpressionUUID->"9cd7760e-590d-40e1-8bbb-62ba7ac613ae"],

Cell[TextData[{
 "The cell returns ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "0"}], ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4479a05d-0b5b-4a95-ab2b-fe9c29ec0899"],
 ": ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["n", "TI"]], "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["n", "TI"], "2"], 
     SuperscriptBox["\[Pi]", "2"]}], 
    RowBox[{"2", 
     SuperscriptBox[
      StyleBox["L", "TI"], "2"]}]], 
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "496b4681-2bd2-42b7-acae-2c150c27cd82"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], 
      StyleBox["n", "TI"]], 
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], 
      StyleBox["n", "TI"]]},
    "BraKet"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8478a5fa-c29e-4cf3-9f11-c950539f7339"],
 " for ",
 StyleBox["every", "TI"],
 " integer ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[GreaterEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a2b1a84-4dbe-4276-934e-187efe8ea4d5"],
 " and every ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "875aa52a-4b46-404e-ab22-1fa4e83e6d15"],
 ", not merely the four the solver listed. The two checks are independent and \
both are needed: the eigenvalue equation is invariant under ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], "\[Rule]", 
   StyleBox["c", "TI"], 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddd648af-fd6d-44d6-9174-209d9bf7a19d"],
 ", so it is blind to the ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"2", "/", 
    StyleBox["L", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38f74e0c-b34d-4fce-b04f-ad7eea49499c"],
 " prefactor, and the norm is what pins it down."
}], "Text",ExpressionUUID->"ee95abf5-0c8f-41d4-a1cc-e9b2698cfd8f"],

Cell["\<\
3.3 [BSc] How do I verify the orthonormality and completeness of the well \
eigenfunctions?\
\>", "Subsection",ExpressionUUID->"ddf82f83-aca0-4064-9b41-5fa7c819a1d4"],

Cell["\<\
Orthonormality says the eigenfunctions are a set of perpendicular unit \
vectors; completeness says there are enough of them to build anything. The \
first is an integral, the second is a statement about a limit, and only the \
second has real content: a basis can be orthonormal and still miss a whole \
direction.\
\>", "Text",ExpressionUUID->"84aebf8d-f274-46e2-a16e-891566fb5b35"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Psi]n", "[", 
       RowBox[{"m", ",", " ", "x"}], "]"}], " ", 
      RowBox[{"\[Psi]n", "[", 
       RowBox[{"n", ",", " ", "x"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", " ", "L"}], "}"}], ",", "\n", "   ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{
       RowBox[{"L", " ", ">", " ", "0"}], " ", "&&", " ", 
       RowBox[{"Element", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "n"}], "}"}], ",", " ", "Integers"}], "]"}], 
       " ", "&&", " ", 
       RowBox[{"m", " ", ">=", " ", "1"}], " ", "&&", " ", 
       RowBox[{"n", " ", ">=", " ", "1"}], " ", "&&", " ", 
       RowBox[{"m", " ", "!=", " ", "n"}]}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "n"}], "}"}], ",", " ", "Integers"}], "]"}], 
     " ", "&&", " ", 
     RowBox[{"m", " ", "!=", " ", "n"}]}]}]}], "]"}]], "Input",
 CellLabel->
  "In[83]:= ",ExpressionUUID->"098f3e5b-1769-49e6-818c-42842414c748"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fC", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"x", "^", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{"L", " ", "-", " ", "x"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"cn", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Psi]n", "[", 
        RowBox[{"n", ",", " ", "x"}], "]"}], " ", 
       RowBox[{"fC", "[", "x", "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", " ", "L"}], "}"}], ",", " ", "asn"}], 
     "]"}], ",", " ", "asn"}], "]"}]}]}], "Input",
 CellLabel->
  "In[84]:= ",ExpressionUUID->"79d6b9ae-8986-494d-9971-6e34275dbaa1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"res", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"cn", " ", 
      RowBox[{"\[Psi]n", "[", 
       RowBox[{"n", ",", " ", "x"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", "Infinity"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lv", " ", "=", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xv", " ", "=", " ", 
         RowBox[{
          RowBox[{"RandomReal", "[", 
           RowBox[{"{", 
            RowBox[{"0.01", ",", " ", "0.99"}], "}"}], "]"}], " ", "lv"}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"res", " ", "-", " ", 
             RowBox[{"fC", "[", "x", "]"}]}], ")"}], " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"L", " ", "->", " ", "lv"}], ",", " ", 
             RowBox[{"x", " ", "->", " ", "xv"}]}], "}"}]}], "]"}], ",", " ", 
         
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}], "]"}]}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", "8", "}"}]}], "]"}]}], "Input",
 CellLabel->
  "In[85]:= ",ExpressionUUID->"6eba19b4-ea98-4de5-8d6d-2c6f080adeb0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"cn", "^", "2"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "1", ",", " ", "Infinity"}], "}"}]}], "]"}], ",",
      " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"L", " ", ">", " ", "0"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"fC", "[", "x", "]"}], "^", "2"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", " ", "L"}], "}"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"L", " ", ">", " ", "0"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"cn", " ", "/.", " ", 
          RowBox[{"n", " ", "->", " ", 
           RowBox[{
            RowBox[{"2", " ", "j"}], " ", "-", " ", "1"}]}]}], ")"}], "^", 
        "2"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "1", ",", " ", "Infinity"}], "}"}]}], "]"}], ",",
      " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"L", " ", ">", " ", "0"}]}]}], "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[86]:= ",ExpressionUUID->"97bd206d-a0b9-4de2-b0b1-5634a704aed6"],

Cell[TextData[{
 "The first cell returns ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1877e881-1dd3-4e25-84aa-17b387c75de4"],
 " for arbitrary integers ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "\[NotEqual]", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1f7728d-9009-4ee3-8555-d7c4afcc2531"],
 ", which together with the unit norm of 3.2 is the statement ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], 
      StyleBox["m", "TI"]], 
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], 
      StyleBox["n", "TI"]]},
    "BraKet"], "=", 
   SubscriptBox[
    StyleBox["\[Delta]", "TI"], 
    StyleBox[
     RowBox[{"m", "n"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90894848-c96b-4315-9727-fea7c7f52cfb"],
 ", proved symbolically rather than sampled. The ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "\[NotEqual]", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5b04b4a-7feb-47c7-bef0-7102f0bfb24f"],
 " assumption is not removable: ask for ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox[
     StyleBox["\[Psi]", "TI"], 
     StyleBox["m", "TI"]], 
    SubscriptBox[
     StyleBox["\[Psi]", "TI"], 
     StyleBox["n", "TI"]]},
   "BraKet"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "379f055b-cf38-4f0c-bebd-22fc41e307b5"],
 " without it and the kernel reasons about generic ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], ",", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4724f2c1-34a8-48be-a3ef-f0024ad3b798"],
 " and returns a bare ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80a8665c-6193-4881-8e17-74d84b52e2cc"],
 ", which would assert that the states are orthogonal to ",
 StyleBox["themselves", "TI"],
 " and contradict the unit norm of the well eigenfunctions. The delta is two \
statements and they have to be made separately."
}], "Text",ExpressionUUID->"7e81ac66-830f-41c6-91df-ce746b3214dd"],

Cell[TextData[{
 "For completeness we expand a function that is ",
 StyleBox["not", "TI"],
 " one of the modes. The obvious choice, the symmetric parabola ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["L", "TI"], "-", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc658d69-ca32-4b2f-ab03-ff736ecdc7d0"],
 ", is a trap: it is symmetric about the midpoint ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bfbf1c4-61d7-4697-9f72-d5c67db0988e"],
 " while the even modes are antisymmetric there, so every even ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a14a2d3-3494-4ac9-9e0c-a06edb5e76b3"],
 " vanishes and the expansion never tests them. Take the ",
 StyleBox["asymmetric",
  FontWeight->"Bold"],
 " cubic ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["C", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["L", "TI"], "-", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3fbaf4b-fb96-4c0a-b072-b6b97c269514"],
 " instead (named ",
 Cell[BoxData["fC"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c56b36fa-6f2b-4ce2-8392-050ccf9c8e0e"],
 " so it does not shadow the generic test function ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53241a75-65de-4994-9a6c-d4b7377d68b1"],
 " used in the parity and delta-well arguments), whose coefficients do not \
vanish for any ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a718c96-6d6b-4223-a36d-ae0ff62df73b"],
 "."
}], "Text",ExpressionUUID->"2f957143-f520-48cd-8f34-1a2f3fb65685"],

Cell[TextData[{
 "Resumming the series is where the symbolic route runs out, and it is worth \
being exact about how. ",
 Cell[BoxData["Sum"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69657bb8-2868-4d2c-aa34-575e9d276cfb"],
 " does return a closed form, but as a combination of trilogarithms, and ",
 Cell[BoxData["FullSimplify"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96899d87-290d-4e68-9ad4-b4ac4885aa85"],
 " will not reduce it to ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["C", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32768935-d1dd-45e5-bced-6c0e295dfbf7"],
 ". Rather than assert an identity the kernel declined to prove, the \
spot-check cell takes the documented next rung and evaluates the difference \
at eight random pairs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["L", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dcbed98-cbba-4ce2-90cb-7ded0a374ce5"],
 ": all eight return ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "821f6997-e269-41f1-b67e-ee540306b6fc"],
 ". The series does reproduce the cubic; only the simplifier is beaten. Eight \
agreeing draws are not a proof, and the honest label for this is \"checked, \
not proved\"."
}], "Text",ExpressionUUID->"255d7cf3-db38-4d60-adb7-e6451fc4cc4f"],

Cell[TextData[{
 "The Parseval cell is the statement that does close, and it is the better \
one anyway. The identity ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["n", "TI"],
    LimitsPositioning->False], 
   SuperscriptBox[GridBox[{
      {
       SubscriptBox[
        StyleBox["c", "TI"], 
        StyleBox["n", "TI"]]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
   UnderoverscriptBox["\[Integral]", "0", 
    StyleBox["L", "TI"],
    LimitsPositioning->False], 
   SubsuperscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["C", "TI"], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4744dd70-9867-493a-b6c4-038f450164a0"],
 " returns ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["L", "TI"], "7"], "/", "105"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b5e514d-8eeb-4190-bcd6-5461d9a2ae0f"],
 " on both sides, exactly and symbolically in ",
 Cell[BoxData[
  StyleBox["L", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5e6a072-53e4-4251-9598-fa01f5c114aa"],
 ". Be careful about what that establishes: Parseval holding for one function \
says the whole weight of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["f", "TI"], 
   StyleBox["C", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb0a6897-fb82-4c59-874e-65fc8f1fba31"],
 " is accounted for, so ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["f", "TI"], 
   StyleBox["C", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "630f4d35-a6e6-4990-9842-d64caa6fb6b2"],
 " lies in the closed span of the basis. It does not by itself say the basis \
spans everything, since a basis with a mode deleted still satisfies Parseval \
on any function having no weight in that mode. Completeness is the statement \
that this holds for ",
 StyleBox["every", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], "\[Element]", 
   SuperscriptBox[
    StyleBox["L", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "500af202-9e5c-4a97-987b-ddee1e3682bc"],
 ", and it comes from Sturm-Liouville theory rather than from a single test \
function."
}], "Text",ExpressionUUID->"03e0a4ff-4dae-4a90-8d9c-90e260b849fd"],

Cell[TextData[{
 "The third entry is what makes it a test rather than an assertion. Summing \
over the ",
 StyleBox["odd modes only",
  FontWeight->"Bold"],
 ", i.e. deliberately deleting every even eigenfunction from the basis, gives \
",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["L", "TI"], "7"], "/", "120"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7407f106-6e0f-4d3f-9913-c43b55e360ec"],
 ", which falls short of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["L", "TI"], "7"], "/", "105"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41618022-3650-45bb-aa86-8b6eaa55e8a4"],
 " by exactly the weight the deleted modes carried. That is the failure mode \
the identity is supposed to detect, exhibited rather than described. It also \
shows why the choice of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["f", "TI"], 
   StyleBox["C", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "159595f8-7ea0-4fcf-808b-778d720febc5"],
 " was not cosmetic: run the same deletion against the symmetric parabola ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["L", "TI"], "-", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88467e67-7aa4-4ac4-8ca7-f18d5a095870"],
 " and the odd-only sum still returns the full ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["L", "TI"], "5"], "/", "30"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec0e721d-1791-407b-bae8-94de786fd034"],
 ", because its even coefficients were zero to begin with. The check would \
have passed on a basis missing half its vectors. A completeness test is only \
as good as the function you ask it to build, and a symmetric test function \
cannot see a missing antisymmetric mode."
}], "Text",ExpressionUUID->"4a4d4bc7-6976-4f2e-939e-da541fa2ccf7"],

Cell[TextData[{
 "3.4 [BSc] How do I find the finite-square-well bound states from the \
even/odd transcendental quantization conditions with ",
 Cell[BoxData["FindRoot"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efbae60c-808d-4b71-89e0-0d1cbe8e727c"],
 "?"
}], "Subsection",ExpressionUUID->"a1b99875-cb1f-48d9-ae82-a4ecd0f0bf64"],

Cell[TextData[{
 "Make the walls finite and the exactness of the infinite well is gone: the \
wavefunction leaks into the barrier, matching it across the edges produces a \
transcendental equation, and no closed form for the levels exists. Routing \
it: the symbolic eigenproblem is the natural first try, and it is ",
 StyleBox["blocked",
  FontWeight->"Bold"],
 " here, established by probe rather than by assumption."
}], "Text",ExpressionUUID->"78e0bb0f-dfec-4c37-87c4-84897c1baf46"],

Cell[BoxData[
 RowBox[{"Head", "@", 
  RowBox[{"DEigenvalues", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}]}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"Piecewise", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "12.5"}], ",", " ", 
             RowBox[{
              RowBox[{"Abs", "[", "x", "]"}], " ", "<", " ", "1."}]}], "}"}], 
           "}"}], ",", " ", "0."}], "]"}], " ", 
        RowBox[{"u", "[", "x", "]"}]}]}], ",", "\n", "   ", 
      RowBox[{"DirichletCondition", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"u", "[", "x", "]"}], " ", "==", " ", "0"}], ",", " ", 
        "True"}], "]"}]}], "}"}], ",", " ", 
    RowBox[{"u", "[", "x", "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", 
      RowBox[{"-", "8."}], ",", " ", "8."}], "}"}], ",", " ", "4"}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[87]:= ",ExpressionUUID->"7c714059-3f33-4fc7-b72b-9ae58cbf348a"],

Cell[TextData[{
 "The head comes back as ",
 Cell[BoxData["DEigenvalues"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4178481-fec2-40ad-abd2-02741df56945"],
 ", in about a third of a second: the expression is handed straight back \
untouched. That is the cheapest possible verdict and the most honest kind, \
because declining to evaluate is a ",
 StyleBox["loud", "TI"],
 " failure. Contrast it with 3.5, where the numerical route answers \
confidently and wrongly. A route that says nothing has told you more than a \
route that says ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "-", "0.087"}], ",", "0.102", ",", "0.152", ",", 
   RowBox[{"0.407", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "591f31fe-ee37-45f0-a9c2-85eaa991f840"],
 "."
}], "Text",ExpressionUUID->"1a63c11e-7bed-4ea9-b4af-6bf21efa362f"],

Cell[TextData[{
 "The refusal has a second mode worth knowing about, because it changes what \
\"probe the gate\" costs. Write the same well with the depth and half-width \
left ",
 StyleBox["symbolic", "TI"],
 ", which is what criterion 4 would prefer, and ",
 Cell[BoxData["DEigensystem"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf5633d7-8513-4e27-9aab-1ecb73453080"],
 " does not decline at all: it grinds, still running after 95 seconds. So the \
route is closed either way, but only the machine-real form says so quickly. \
Probing a gate is cheap only when the answer is \"no\"; when the answer is \
\"not in any reasonable time\" the probe costs exactly as much as you are \
willing to wait, and the discipline is to bound it with ",
 Cell[BoxData["TimeConstrained"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d11c1e8-cbac-4805-9dff-24e44595a41f"],
 " and record the bound rather than to sit and hope."
}], "Text",ExpressionUUID->"7f30a9af-2a4f-40ce-a8c6-5c14879a8445"],

Cell[TextData[{
 "What remains is the transcendental condition solved by ",
 Cell[BoxData["FindRoot"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28607e6f-fceb-4306-8f06-c70cd0310ae8"],
 ", which is better than a numerical PDE route anyway because it stays \
inspectable: the whole problem depends on the single dimensionless \
combination ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["u", "TI"], "0"], "=", 
   StyleBox["a", "TI"], 
   SqrtBox[
    RowBox[{"2", 
     SubscriptBox[
      StyleBox["V", "TI"], "0"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b27294fc-251a-4447-aa0b-be8649790aff"],
 ", with ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44ff61d9-67d3-48c2-ad60-d6eac2fee56a"],
 " the half-width and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f0ada0e-ec31-443a-b86e-0b0b8419cb8d"],
 " the depth."
}], "Text",ExpressionUUID->"56dcfd81-6cda-4d0e-a6b2-b1cf6a5c14d0"],

Cell[TextData[{
 "Stay symbolic while the problem still is. Even the bound-state ",
 StyleBox["count", "TI"],
 " has a closed form, because even and odd roots interlace at spacing ",
 Cell[BoxData[
  RowBox[{"\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2aca26a-c887-4728-8a10-3d370bb4323b"],
 " across ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    SubscriptBox[
     StyleBox["u", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e822ab19-4881-4dd0-bb7e-b7ea05c1e25d"],
 ", so pin numbers only after the count is known. The conditions are written \
pole-free so the root finder never meets the poles of ",
 Cell[BoxData[
  StyleBox["tan",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f772c41c-ff1f-44f3-9d5f-47f8e2524e53"],
 " and ",
 Cell[BoxData[
  StyleBox["cot",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e798212-6a55-4baf-bffc-3f7add8bc603"],
 "."
}], "Text",ExpressionUUID->"a0797fe8-1a95-479b-9886-2203fad43c22"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fEven", "[", "u0_", "]"}], "[", 
    RowBox[{"u_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"u", " ", 
     RowBox[{"Sin", "[", "u", "]"}]}], " ", "-", " ", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"u0", "^", "2"}], " ", "-", " ", 
       RowBox[{"u", "^", "2"}]}], "]"}], " ", 
     RowBox[{"Cos", "[", "u", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fOdd", "[", "u0_", "]"}], "[", 
    RowBox[{"u_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"u", " ", 
     RowBox[{"Cos", "[", "u", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"u0", "^", "2"}], " ", "-", " ", 
       RowBox[{"u", "^", "2"}]}], "]"}], " ", 
     RowBox[{"Sin", "[", "u", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bracket", "[", 
    RowBox[{"f_", ",", " ", "u0_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"us", " ", "=", " ", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"10.", "^", 
          RowBox[{"-", "9"}]}], ",", " ", 
         RowBox[{"u0", " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"10.", "^", 
             RowBox[{"-", "9"}]}]}], ")"}]}], ",", " ", "4000"}], "]"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"fs", " ", "=", " ", 
         RowBox[{"f", " ", "/@", " ", "us"}]}], "}"}], ",", " ", 
       RowBox[{"Pick", "[", 
        RowBox[{
         RowBox[{"Partition", "[", 
          RowBox[{"us", ",", " ", "2", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"Sign", "[", 
          RowBox[{
           RowBox[{"Most", "[", "fs", "]"}], " ", 
           RowBox[{"Rest", "[", "fs", "]"}]}], "]"}], ",", " ", 
         RowBox[{"-", "1"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rootsOf", "[", 
    RowBox[{"f_", ",", " ", "u0_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"u", " ", "/.", " ", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{"f", "[", "u", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"u", ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Brent\>\""}]}], "]"}]}], 
      ")"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"bracket", "[", 
     RowBox[{"f", ",", " ", "u0"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uAll", "[", "u0_", "]"}], " ", ":=", " ", 
   RowBox[{"Sort", "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"rootsOf", "[", 
       RowBox[{
        RowBox[{"fEven", "[", "u0", "]"}], ",", " ", "u0"}], "]"}], ",", " ", 
      
      RowBox[{"rootsOf", "[", 
       RowBox[{
        RowBox[{"fOdd", "[", "u0", "]"}], ",", " ", "u0"}], "]"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nBound", "[", "u0_", "]"}], " ", ":=", " ", 
   RowBox[{"Ceiling", "[", 
    RowBox[{"2", " ", 
     RowBox[{"u0", "/", "Pi"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"uAll", "[", "5.", "]"}], ",", " ", 
   RowBox[{"nBound", "[", "5.", "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[88]:= ",ExpressionUUID->"a01ad6c1-5625-48ec-9081-4c28117d758f"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Length", "[", 
     RowBox[{"uAll", "[", "u0", "]"}], "]"}], " ", "==", " ", 
    RowBox[{"nBound", "[", "u0", "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"u0", ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "0.05", ",", " ", "0.5", ",", " ", "1.5", ",", " ", "2.0", ",", " ", 
       "3.2", ",", " ", "7.9", ",", " ", "12.8", ",", " ", "20.1", ",", " ", 
       "50.3"}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[89]:= ",ExpressionUUID->"110ae24f-17cb-4a22-9e39-a722f4e43874"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Esym", "[", 
    RowBox[{"u0_", ",", " ", "u_", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"u0", "^", "2"}], " ", "-", " ", 
       RowBox[{"u", "^", "2"}]}], ")"}]}], "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"a", "^", "2"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eFinite", " ", "=", " ", 
   RowBox[{"Esym", "[", 
    RowBox[{"5.", ",", " ", 
     RowBox[{"uAll", "[", "5.", "]"}], ",", " ", "1."}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"eFinite", ",", "\n", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u0", " ", "=", " ", 
         RowBox[{"a", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", " ", "12.5"}], "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"First", "@", 
        RowBox[{"Esym", "[", 
         RowBox[{"u0", ",", " ", 
          RowBox[{"uAll", "[", "u0", "]"}], ",", " ", "a"}], "]"}]}]}], "]"}],
      ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1.", ",", " ", "2.", ",", " ", "4."}], "}"}]}], "}"}]}], 
    "]"}], ",", "\n", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"V0", " ", "=", " ", 
         RowBox[{"12.5", "/", 
          RowBox[{"a", "^", "2"}]}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"a", "^", "2"}], " ", 
        RowBox[{"First", "@", 
         RowBox[{"Esym", "[", 
          RowBox[{
           RowBox[{"a", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"2", " ", "V0"}], "]"}]}], ",", " ", 
           RowBox[{"uAll", "[", 
            RowBox[{"a", " ", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"2", " ", "V0"}], "]"}]}], "]"}], ",", " ", "a"}], 
          "]"}]}]}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1.", ",", " ", "2.", ",", " ", "4."}], "}"}]}], "}"}]}], 
    "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[90]:= ",ExpressionUUID->"b990c9c9-0c71-4b52-bf9d-c594afabe2ab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"us", " ", "=", " ", 
       RowBox[{"uAll", "[", "200.", "]"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"us", "[", 
         RowBox[{"[", 
          RowBox[{"1", " ", ";;", " ", "4"}], "]"}], "]"}], "^", "2"}], ")"}],
       "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"us", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], ")"}]}]}], "]"}], ",", 
   " ", 
   RowBox[{"Length", "[", 
    RowBox[{"uAll", "[", "0.01", "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[91]:= ",ExpressionUUID->"ed5f151b-53d1-4b82-a9ed-5fd4d2c230ab"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["u", "TI"], "0"], "=", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50105d37-6a10-471f-89bd-faad94c69563"],
 " the roots are ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["u", "TI"], "\[TildeTilde]", "{", "1.306"}], ",", "2.596", ",", 
   "3.837", ",", 
   RowBox[{"4.906", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f7c96a3-eab7-4a6b-a32b-2ae112a6ce27"],
 " and there are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftCeiling]",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SubscriptBox[
     StyleBox["u", "TI"], "0"], "/", "\[Pi]"}], 
   StyleBox["\[RightCeiling]",
    SpanMaxSize->1], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2183187-e044-4d0b-aeb9-e84d64cd44fc"],
 " of them, so the closed-form count is right. One value is one data point, \
so the second cell sweeps ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["u", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2980d9c-816d-4b38-b777-27e67dcfb47f"],
 " from ",
 Cell[BoxData["0.05"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5279fe97-3bd3-4682-be8d-829c2f8d3eaf"],
 " to ",
 Cell[BoxData["50.3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23a2bd58-930b-4592-b17b-55bbdee89751"],
 " and the count formula holds at every one."
}], "Text",ExpressionUUID->"4b352ac6-d40f-4c0a-8c2d-aecb4065b48c"],

Cell[TextData[{
 "The energies keep the half-width symbolic: ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"]], "=", "-", "(", 
   RowBox[{
    SubsuperscriptBox[
     StyleBox["u", "TI"], "0", "2"], "-", 
    SubsuperscriptBox[
     StyleBox["u", "TI"], 
     StyleBox["n", "TI"], "2"]}], ")", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SuperscriptBox[
     StyleBox["a", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "019406d3-0663-41b5-b967-1d060d19a195"],
 ". At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6039267c-9341-4497-9625-bd36cbeffcc9"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["V", "TI"], "0"], "=", "12.5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a260e7e6-3bb3-481e-b433-56a2c87d1a06"],
 " the levels are ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "-", "11.65"}], ",", 
   RowBox[{"-", "9.13"}], ",", 
   RowBox[{"-", "5.14"}], ",", 
   RowBox[{"-", "0.46", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "362fe5ed-2068-46ec-a54c-dfb275bba681"],
 ", all lying strictly between ",
 Cell[BoxData[
  RowBox[{"-", 
   SubscriptBox[
    StyleBox["V", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2036a651-46de-4939-a9b1-392158295aeb"],
 " and ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a436ce48-75d4-4efc-9cab-12e17ffda14c"],
 ", as a bound state of a well of depth ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d873c77b-6135-40c9-a2c2-8a042f69d27e"],
 " must. Naming them ",
 Cell[BoxData["eFinite"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10f8d1aa-7d6f-43d4-a397-3b97bbb6daf7"],
 " also means 3.5 compares against one computation of the roots rather than \
re-running the bracketing search each time."
}], "Text",ExpressionUUID->"1d04b248-fa1c-456a-bef0-d4620ad2dbe3"],

Cell[TextData[{
 "The other two entries are there to kill a scaling law that looks obvious \
and is wrong. It is tempting to read ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"]], "=", "-", "(", 
   RowBox[{
    SubsuperscriptBox[
     StyleBox["u", "TI"], "0", "2"], "-", 
    SubsuperscriptBox[
     StyleBox["u", "TI"], 
     StyleBox["n", "TI"], "2"]}], ")", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SuperscriptBox[
     StyleBox["a", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3de0681d-99eb-413a-8750-ff19851d3d71"],
 " as \"the spectrum scales as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SuperscriptBox[
    StyleBox["a", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "085f76ca-7ab3-417e-a5a0-c2d04bfabfa1"],
 "\", the same squeeze 3.2 found for the infinite well. It does not. Widen \
the well at fixed depth ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["V", "TI"], "0"], "=", "12.5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd5d5b2c-1d6c-467e-811e-afd31f4ffebf"],
 " and the ground level goes ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "-", "11.65"}], ",", " ", 
    RowBox[{"-", "12.25"}], ",", " ", 
    RowBox[{"-", "12.43"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6706d62d-637f-4285-85e4-0f3eae36ea15"],
 " for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["a", "TI"], "=", "1"}], ",", 
   RowBox[{"2", ",", "4"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f19bbf84-ea70-4d56-a42b-daa4f677c5dd"],
 ": it ",
 StyleBox["deepens", "TI"],
 " toward ",
 Cell[BoxData[
  RowBox[{"-", 
   SubscriptBox[
    StyleBox["V", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d8492e0-ce7b-40a8-895f-bb44b248d078"],
 ", where ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SuperscriptBox[
    StyleBox["a", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afd4ffdf-5391-4574-82cb-6ac8b2411311"],
 " would demand ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "-", "11.65"}], ",", " ", 
    RowBox[{"-", "2.91"}], ",", " ", 
    RowBox[{"-", "0.73"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4afe900c-fa60-4443-87ac-c85c279a5dde"],
 ". The reason is that ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["u", "TI"], "0"], "=", 
   StyleBox["a", "TI"], 
   SqrtBox[
    RowBox[{"2", 
     SubscriptBox[
      StyleBox["V", "TI"], "0"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6aae03b-3d18-410c-98ea-c2a8090f2fc6"],
 " carries its own ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aeecc262-56b2-440d-becf-ce67f99d994c"],
 ", so the roots ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["u", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b32ebe2a-516a-49ca-ab76-6a6b7c397582"],
 " move too, and a wider well simply holds its states more securely. The \
document's own 3.9 already contradicts the naive reading: shrinking ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2815ceb-be67-49c9-840a-ae757863893c"],
 " at fixed ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], "=", "2", 
   StyleBox["a", "TI"], 
   SubscriptBox[
    StyleBox["V", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2accd20e-df85-4a7b-81a1-609556fadcb6"],
 " sends ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "\[Rule]", "-", 
   SuperscriptBox[
    StyleBox["g", "TI"], "2"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bf84431-b7f7-420d-a421-08b03de14972"],
 ", a constant, not ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SuperscriptBox[
    StyleBox["a", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa7d634e-9d6c-4878-812c-98d2b5b33ace"],
 "."
}], "Text",ExpressionUUID->"57dfcbf7-6fe9-46f9-a96d-23208b1c6413"],

Cell[TextData[{
 "The true statement is the third entry: ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a443b17-d134-40dc-8ec1-7af5bb2d40f4"],
 " depends on ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca4c43ca-4d19-4c19-b43b-db2824d59c31"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88a85ef6-c087-4bc7-99df-ef448e1bac2e"],
 " ",
 StyleBox["only through ",
  FontWeight->"Bold"],
 Cell[BoxData[
  SubscriptBox[
   StyleBox["u", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"490b91a6-5865-4bc9-87b4-fe138ceb5ee7"],
 ". Holding ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["u", "TI"], "0"], "=", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0af2ccd-6f3b-4d81-997d-fe22745e0212"],
 " fixed while ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c41cb3d-748f-4615-b986-238ac63b263c"],
 " runs over ",
 Cell[BoxData[
  RowBox[{"1", ",", "2", ",", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94df80ec-88ed-4bf0-ad22-4dca7e405d1b"],
 " (with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ca286d9-38ca-4505-8ac6-9608c0a4ef9b"],
 " compensating) returns ",
 Cell[BoxData[
  RowBox[{"-", "11.646607252"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "533b578d-b13a-4bdc-8259-c77e6ac1bd81"],
 " every time, identical to ten digits. That is what \"the problem depends on \
one dimensionless parameter\" means, and it is falsifiable, which the ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SuperscriptBox[
    StyleBox["a", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d351232-9a57-499b-acee-e132d2555f23"],
 " story was not."
}], "Text",ExpressionUUID->"9f7f992d-ee90-439e-b986-9038cd562965"],

Cell[TextData[{
 "The last cell closes the two limits that could fail. Deep well: at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["u", "TI"], "0"], "=", "200"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c283bc8-b291-4eae-bf33-c2633ebe0b49"],
 " the ratios of ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["u", "TI"], 
   StyleBox["n", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f5af9be-99fb-4ec6-8fa4-2c9ab23eb064"],
 " come back as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1.000000"}], ",", "3.999999", ",", "8.999993", ",", 
   RowBox[{"15.999976", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "535744bb-91fe-4370-927f-699b026f9afb"],
 ", which is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", 
   RowBox[{"4", ",", "9"}], ",", 
   RowBox[{"16", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eef9465f-098c-45e0-b3ba-aa9e8f515474"],
 " to five significant figures (the worst, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f653041b-d192-46d7-92f9-7326f601d13f"],
 ", is off by ",
 Cell[BoxData[
  RowBox[{"1.5", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "6"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1721e7df-2c9e-41a6-ac08-24beab595354"],
 " relative, since the highest state is the least deeply bound and so the \
slowest to reach its limit). That is the infinite-well infinite-well spectrum \
for a box of width ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "557ab020-1215-4700-97f6-ab864399c959"],
 ", recovered as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["V", "TI"], "0"], "\[Rule]", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c3eed0b-c7fe-42ff-9211-8e758675a073"],
 " exactly as the roots crowd toward ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["u", "TI"], 
    StyleBox["n", "TI"]], "\[Rule]", 
   StyleBox["n", "TI"], "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f445e684-7a2a-4505-9124-a02a40f02a45"],
 ". Shallow well: at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["u", "TI"], "0"], "=", "0.01"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "802fbcac-09a4-4b29-af29-3f3515b23a54"],
 " there is still exactly one root. However weak the attraction, a \
one-dimensional well always binds, which is a genuinely quantum statement \
with no classical counterpart and is the same fact the delta well makes exact."
}], "Text",ExpressionUUID->"d5cbb168-6ddd-4513-94fc-7f6ffb4e069f"],

Cell[TextData[{
 "3.5 [BSc] How do I compute numerical bound states with ",
 Cell[BoxData["NDEigensystem"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e74b018-6b14-4499-a222-30e8358df5a0"],
 " on a finite interval and compare them to the analytic answer?"
}], "Subsection",ExpressionUUID->"ffa27f90-f919-4d28-98cd-aa82557b43f9"],

Cell["\<\
This is the question the whole routing discipline exists for, so it is worth \
doing slowly. The numerical route must (a) truncate the infinite line to a \
box and (b) discretize it, and both truncations are lies that must be shown \
to stop mattering. Worse, the default is wrong here, and it is wrong silently.\
\>", "Text",ExpressionUUID->"5030799f-ff2e-49cc-9d93-6f37a430e948"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"well", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "12.5"}], ",", " ", 
        RowBox[{
         RowBox[{"Abs", "[", "x", "]"}], " ", "<", " ", "1."}]}], "}"}], 
      "}"}], ",", " ", "0."}], "]"}]}], ";"}], "\n", 
 RowBox[{"NDEigenvalues", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u", "[", "x", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"well", "[", "x", "]"}], " ", 
       RowBox[{"u", "[", "x", "]"}]}]}], ",", " ", 
     RowBox[{"DirichletCondition", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"u", "[", "x", "]"}], " ", "==", " ", "0."}], ",", " ", 
       "True"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"u", "[", "x", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "8."}], ",", " ", "8."}], "}"}], ",", " ", "4"}], 
  "]"}]}], "Input",
 CellLabel->
  "In[92]:= ",ExpressionUUID->"fe06d1f2-71bb-4fd5-9188-d5f3f730d9cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ndAll", "[", 
    RowBox[{"box_", ",", " ", "mcm_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Sort", "@", 
    RowBox[{"NDEigenvalues", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}]}], " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"u", "[", "x", "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"well", "[", "x", "]"}], " ", 
          RowBox[{"u", "[", "x", "]"}]}]}], ",", "\n", "    ", 
        RowBox[{"DirichletCondition", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"u", "[", "x", "]"}], " ", "==", " ", "0."}], ",", " ", 
          "True"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"u", "[", "x", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "box"}], ",", " ", "box"}], "}"}], ",", " ", "4", ",", 
      "\n", "   ", 
      RowBox[{"Method", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<SpatialDiscretization\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<FiniteElement\>\"", ",", "\n", "      ", 
            RowBox[{"{", 
             RowBox[{"\"\<MeshOptions\>\"", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"MaxCellMeasure", " ", "->", " ", "mcm"}], "}"}]}], 
             "}"}]}], "}"}]}], ",", "\n", "     ", 
         RowBox[{"\"\<Eigensystem\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Arnoldi\>\"", ",", " ", 
            RowBox[{"\"\<Shift\>\"", " ", "->", " ", 
             RowBox[{"-", "12.5"}]}]}], "}"}]}]}], "}"}]}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"ndAll", "[", 
    RowBox[{"8.", ",", " ", "mcm"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"mcm", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", " ", "0.1", ",", " ", "0.02", ",", " ", "0.005"}], 
      "}"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->
  "In[93]:= ",ExpressionUUID->"8d7dbc19-403a-4f71-84b4-dbe05fc86e17"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"ndAll", "[", 
    RowBox[{"box", ",", " ", "0.005"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"box", ",", " ", 
     RowBox[{"{", 
      RowBox[{"4.", ",", " ", "6.", ",", " ", "8.", ",", " ", "12."}], 
      "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[94]:= ",ExpressionUUID->"d4c056b1-c35f-4132-a32f-b7eb408fa9b2"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"ndAll", "[", 
       RowBox[{"12.", ",", " ", "0.005"}], "]"}], " ", "-", " ", "eFinite"}], 
     ")"}], "/", "eFinite"}], "]"}]}]], "Input",
 CellLabel->
  "In[95]:= ",ExpressionUUID->"c0a8d0e2-5ac7-472b-807e-96c6f19d85af"],

Cell[TextData[{
 "The first cell returns ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "-", "0.087"}], ",", " ", "0.102", ",", " ", "0.152", ",", 
    " ", "0.407"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "075c1128-092e-4b4a-8946-5a3cd1e9b3e4"],
 " and ",
 StyleBox["not one of those is a bound state of this well",
  FontWeight->"Bold"],
 ". The true levels are the ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "-", "11.65"}], ",", 
   RowBox[{"-", "9.13"}], ",", 
   RowBox[{"-", "5.14"}], ",", 
   RowBox[{"-", "0.46", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e8fc448-94a5-4bba-9f1b-f522079aa6d4"],
 " found from the transcendental conditions. ",
 Cell[BoxData["NDEigensystem"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "688fbcee-18dc-4630-a271-6fdd86bebc98"],
 " returns the eigenvalues smallest in ",
 StyleBox["magnitude", "TI"],
 ", and for a spectrum that runs negative that is the wrong end entirely: \
what came back are discretized continuum states of the surrounding box. There \
is no error, no warning, and the numbers look perfectly reasonable. This is \
the documented behavior, not a bug, and it is why the physics has to supply a \
spectral shift near the expected eigenvalue."
}], "Text",ExpressionUUID->"222782ec-7169-41a8-a21b-2def47368d75"],

Cell[TextData[{
 "With the shift in place the mesh sweep converges monotonically to the \
analytic answer, and the box sweep tells a physical story worth reading \
rather than skipping: the three deep levels are already converged at a box of \
",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa84a5ba-7324-468a-9c03-76242cac1f78"],
 ", but the shallowest state at ",
 Cell[BoxData[
  RowBox[{"-", "0.46"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb9d5674-be65-4021-acd3-4677c3817c1c"],
 " keeps moving until the box reaches ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "12"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9698c55-afaa-4c5f-bdbc-7d45d1fa6c63"],
 ". That state is the most weakly bound, so its exponential tail ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["\[Kappa]", "TI"], GridBox[{
      {
       StyleBox["x", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5452cbc6-f7d4-4a15-a3e0-ea546171630c"],
 " has the smallest ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ef73da3-b5d6-4b0c-b89a-cb12ac72ba76"],
 " and reaches furthest; squeeze the box and you squeeze the state, raising \
its energy. The last cell measures the final disagreement against 3.4 rather \
than eyeballing it: at a box of ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "12"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a153bdac-1777-4efc-9838-e652aebb5347"],
 " and a mesh of ",
 Cell[BoxData["0.005"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7c3d4d9-6d45-4c36-a885-f9e9d3c0892a"],
 " the two routes agree to ",
 Cell[BoxData[
  RowBox[{"7", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "9"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dab72879-eb8e-4fbc-9277-3f373a66a738"],
 " relative, and they share no machinery, one being a transcendental root of ",
 Cell[BoxData[
  StyleBox["tan",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b0080ba-1b62-488f-872f-edce02003f47"],
 " and ",
 Cell[BoxData[
  StyleBox["cot",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71357603-bfac-46a5-a903-926857a05ed2"],
 " and the other a finite element discretization of the operator."
}], "Text",ExpressionUUID->"ceaf5b9e-ea5d-42d8-a379-032002e87e9b"],

Cell[TextData[{
 "A message does fire during the mesh sweep, ",
 Cell[BoxData[
  RowBox[{"Eigensystem", "::", "chnpdef"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3de7e8bf-9208-4889-962b-b2aad82d6628"],
 ", warning that positive definiteness cannot be assured for the shifted \
Arnoldi solve. It is reported rather than suppressed: it is a warning about \
the method, and the agreement with 3.4 to seven digits is the evidence that \
it did not spoil the answer here."
}], "Text",ExpressionUUID->"195090ef-cd5e-421e-9fed-e62ac2574353"],

Cell["\<\
3.6 [BSc] How do I implement the shooting and Numerov methods from scratch to \
find a bound state?\
\>", "Subsection",ExpressionUUID->"708cef2e-e2dc-483d-ba51-4f20415df897"],

Cell[TextData[{
 "A canned eigensolver hides the fact that a bound state is a ",
 StyleBox["coincidence", "TI"],
 ": integrate the ODE outward from one wall at an arbitrary energy and the \
solution generically fails to satisfy the far boundary condition (on an \
unbounded domain it diverges outright in the classically forbidden region), \
and only at an eigenvalue does it land on zero. Shooting makes the eigenvalue \
condition explicit as a root of the endpoint value. Numerov is the sharpened \
version, a three-term recurrence exact to fourth order in the step, obtained \
by using the ODE itself to eliminate the leading error term. Both are written \
here with ",
 Cell[BoxData["NestList"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efe8ac0d-a021-4afb-83b3-a053c8d61939"],
 " rather than a loop."
}], "Text",ExpressionUUID->"efaf5de4-d4eb-4659-89b8-ec9de84889a4"],

Cell[TextData[{
 "The recurrence relates three consecutive points, so the natural WL object \
is not an index but the sliding window ",
 Cell[BoxData[
  RowBox[{"Partition", "[", 
   RowBox[{"...", ",", " ", "3", ",", " ", "1"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2fe53e3-1231-43d4-8721-8ac1aa6ebc3b"],
 ", folded over. Written that way there is no counter, no ",
 Cell[BoxData["Part"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fee7eb4-8959-48df-99bd-d01f7d3a69d4"],
 " offset arithmetic, and no chance of an off-by-one. The window carries both \
",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07058378-336a-4b8e-8443-d64b686d7ab8"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], "=", "1", "+", 
   SuperscriptBox[
    StyleBox["h", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], "/", "12"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6df0896-af1e-4e67-8e3d-e44ec9bd12d9"],
 " at each point, which matters: eliminating ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "728bb206-5f58-4b42-8eba-a19e17d0e125"],
 " in favour of ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fb3823a-04bf-4304-91f7-ad7d3d8e9b83"],
 " alone would force the middle coefficient to be computed as ",
 Cell[BoxData[
  RowBox[{"12", "-", "10", 
   StyleBox["f", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "490fe8a7-1b59-474c-b18b-14e9ebc158d9"],
 ", and subtracting two numbers near ",
 Cell[BoxData["12"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "342ad23c-178d-4bcb-99c4-c9442a976802"],
 " and ",
 Cell[BoxData["10"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0311e60-d06f-46ea-8619-927762f3f3d6"],
 " to get a small one is exactly the cancellation that costs digits. Keeping ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ea3aee9-e62b-446d-bfca-8ece7de25bc3"],
 " lets it be written as ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", "5", 
    SuperscriptBox[
     StyleBox["h", "TI"], "2"], 
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "/", "12"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3bf59cb-8020-47a9-8b6e-abddcb0c6ae7"],
 " and computed directly."
}], "Text",ExpressionUUID->"265c605f-fd37-46e1-9e22-0676162579ec"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"numerov", "[", 
    RowBox[{
     RowBox[{"En_", "?", "NumericQ"}], ",", " ", "v_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x0_", ",", " ", "x1_"}], "}"}], ",", " ", "npts_Integer"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x1", " ", "-", " ", "x0"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"npts", " ", "-", " ", "1"}], ")"}]}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ks", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"En", " ", "-", " ", 
              RowBox[{"v", "[", 
               RowBox[{"x0", " ", "+", " ", 
                RowBox[{"#", " ", "h"}]}], "]"}]}], ")"}]}], " ", "&"}], " ", 
          "/@", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"npts", " ", "-", " ", "1"}]}], "]"}]}]}], "}"}], ",", 
       "\n", "    ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"w", " ", "=", " ", 
           RowBox[{"Partition", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"ks", ",", " ", 
                RowBox[{"1", " ", "+", " ", 
                 RowBox[{
                  RowBox[{"h", "^", "2"}], " ", 
                  RowBox[{"ks", "/", "12"}]}]}]}], "}"}], "]"}], ",", " ", 
             "3", ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"Last", " ", "/@", " ", 
            RowBox[{"FoldList", "[", "\n", "        ", 
             RowBox[{
              RowBox[{
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"fm", " ", "=", " ", 
                    RowBox[{"#2", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], ",", " ", 
                   RowBox[{"k0", " ", "=", " ", 
                    RowBox[{"#2", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
                   RowBox[{"fp", " ", "=", " ", 
                    RowBox[{"#2", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", " ", "2"}], "]"}], "]"}]}]}], "}"}], ",",
                  "\n", "          ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"#1", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", " ", 
                    RowBox[{"(", 
                    RowBox[{"1", " ", "-", " ", 
                    RowBox[{"5", " ", 
                    RowBox[{"h", "^", "2"}], " ", 
                    RowBox[{"k0", "/", "12"}]}]}], ")"}], " ", 
                    RowBox[{"#1", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], " ", "-", " ", 
                    RowBox[{"fm", " ", 
                    RowBox[{"#1", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], "/", "fp"}]}], 
                  "}"}]}], "]"}], " ", "&"}], ",", "\n", "        ", 
              RowBox[{"{", 
               RowBox[{"0.", ",", " ", "1.*^-6"}], "}"}], ",", " ", "w"}], 
             "]"}]}], ",", " ", "0."}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"shoot", "[", 
    RowBox[{"En_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"Last", "[", 
    RowBox[{"numerov", "[", 
     RowBox[{"En", ",", " ", 
      RowBox[{"0.", " ", "&"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.", ",", " ", "1."}], "}"}], ",", " ", "2001"}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "@", 
    RowBox[{"numerov", "[", 
     RowBox[{"4.9348", ",", " ", 
      RowBox[{"0.", " ", "&"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.", ",", " ", "1."}], "}"}], ",", " ", "201"}], "]"}]}], ",",
    "\n", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{
        RowBox[{"n", "^", "2"}], " ", 
        RowBox[{
         RowBox[{"Pi", "^", "2"}], "/", "2."}]}], ",", " ", 
       RowBox[{"u", " ", "/.", " ", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{"shoot", "[", "u", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"n", "^", "2"}], " ", 
              RowBox[{
               RowBox[{"Pi", "^", "2"}], "/", "2."}]}], " ", "-", " ", 
             "0.4"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"n", "^", "2"}], " ", 
              RowBox[{
               RowBox[{"Pi", "^", "2"}], "/", "2."}]}], " ", "+", " ", 
             "0.4"}]}], "}"}], ",", "\n", "     ", 
          RowBox[{"Method", " ", "->", " ", "\"\<Brent\>\""}]}], "]"}]}]}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->
  "In[96]:= ",ExpressionUUID->"017ae1b7-2328-46bd-bd3b-5ceb5b16167b"],

Cell[TextData[{
 "The ",
 Cell[BoxData["Prepend"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "098ebf5f-9af5-44de-be94-d7f5fed6f88e"],
 " restores ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], "0"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91de658d-224a-47fd-bcda-01a858dec957"],
 ", the wall value the fold consumes as its seed rather than emits, so the \
returned list is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], "0"], ",", "\[Ellipsis]", ",", 
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    RowBox[{
     StyleBox["N", "TI"], "-", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db420a11-8ae8-43d1-bb54-c13872e4de52"],
 " and pairs with the grid. Nothing above needs it, since only ",
 Cell[BoxData["Last"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41ef5e7f-30d0-49dd-8157-f19cfb6dae25"],
 " is ever taken, but a reader who plots the eigenfunction would otherwise \
silently misalign every point by one step. ",
 Cell[BoxData["Length"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a6f1662-dfea-4237-88af-334fdfd7cdff"],
 " returning ",
 Cell[BoxData["201"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d725d694-ad60-442a-8807-7065594da94a"],
 " for a ",
 Cell[BoxData["201"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f95ce941-65c4-41fc-a2ea-1545167c2979"],
 "-point grid is the contract."
}], "Text",ExpressionUUID->"5db0cf29-2be3-4cb3-900c-ecb429346e95"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"shootND", "[", 
    RowBox[{"En_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"u", "''"}], "[", "x", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"-", "2"}], " ", "En", " ", 
         RowBox[{"u", "[", "x", "]"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"u", "[", "0", "]"}], " ", "==", " ", "0"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"u", "'"}], "[", "0", "]"}], " ", "==", " ", "1"}]}], "}"}], 
     ",", "\n", "   ", 
     RowBox[{"u", "[", "1", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", ",", " ", 
     RowBox[{
      RowBox[{"n", "^", "2"}], " ", 
      RowBox[{
       RowBox[{"Pi", "^", "2"}], "/", "2."}]}], ",", " ", 
     RowBox[{"v", " ", "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{"shootND", "[", "v", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"v", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"n", "^", "2"}], " ", 
            RowBox[{
             RowBox[{"Pi", "^", "2"}], "/", "2."}]}], " ", "-", " ", "0.4"}], 
          ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"n", "^", "2"}], " ", 
            RowBox[{
             RowBox[{"Pi", "^", "2"}], "/", "2."}]}], " ", "+", " ", 
           "0.4"}]}], "}"}], ",", "\n", "    ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Brent\>\""}]}], "]"}]}]}], 
    "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}]}], "Input",
 CellLabel->
  "In[97]:= ",ExpressionUUID->"0a890fbf-aebc-4468-a369-7ca682773059"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"shootN", "[", 
    RowBox[{
     RowBox[{"En_", "?", "NumericQ"}], ",", " ", "np_Integer"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"Last", "[", 
    RowBox[{"numerov", "[", 
     RowBox[{"En", ",", " ", 
      RowBox[{"0.", " ", "&"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.", ",", " ", "1."}], "}"}], ",", " ", "np"}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"np", ",", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"u", " ", "/.", " ", 
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{"shootN", "[", 
            RowBox[{"u", ",", " ", "np"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"u", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Pi", "^", "2"}], "/", "2."}], " ", "-", " ", "0.4"}], 
             ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Pi", "^", "2"}], "/", "2."}], " ", "+", " ", 
              "0.4"}]}], "}"}], ",", "\n", "     ", 
           RowBox[{"Method", " ", "->", " ", "\"\<Brent\>\""}]}], "]"}]}], 
        ")"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"Pi", "^", "2"}], "/", "2."}]}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"np", ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "51", ",", " ", "101", ",", " ", "201", ",", " ", "401", ",", " ", 
       "801"}], "}"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->
  "In[98]:= ",ExpressionUUID->"6d984de3-4965-448b-88dd-b7a0efbf7a89"],

Cell[TextData[{
 "Run on the infinite well of width ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40ff1365-1869-40fd-b180-9ce3ad086eb8"],
 ", whose exact levels are ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"]], "=", 
   SuperscriptBox[
    StyleBox["n", "TI"], "2"], 
   SuperscriptBox["\[Pi]", "2"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52b584a0-9b51-4f28-9ac8-397abdcfedb7"],
 ", Numerov returns all four to about ",
 Cell[BoxData[
  RowBox[{"3.4", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "10"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9caf647f-dfc5-4261-98fa-999a9e5f1473"],
 ", evenly across the four. That evenness is not the scheme tracking ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["h", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef0af4a2-55d9-4d8c-b94b-71dedb689b52"],
 " across the levels: the refinement sweep below shows this grid already sits \
on the roundoff floor, where a ",
 StyleBox["finer", "TI"],
 " grid does slightly worse, so the flat ",
 Cell[BoxData[
  RowBox[{"3.4", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "10"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4249af76-7329-4d73-b95a-5c93e5405a90"],
 " is arithmetic noise rather than truncation error. ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98c5cbcc-0e8b-460d-8191-2c99be268c72"],
 " shooting, an independent scheme sharing none of Numerov's machinery, is \
markedly worse and degrades with the level: ",
 Cell[BoxData[
  RowBox[{"5", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "8"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "386979b8-8d9d-4c0b-99f0-f6d118cc5d10"],
 " on the ground state but ",
 Cell[BoxData[
  RowBox[{"2.2", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "6"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d0a0cff-90a3-4102-a52d-394f393f4a30"],
 " by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "577cd525-2a25-4422-b36a-5022195f3f99"],
 ", since a more oscillatory state is harder for a general-purpose stepper to \
track across the interval. The two numerical routes therefore disagree with \
",
 StyleBox["each other", "TI"],
 " by about ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "6"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87604794-e033-4d37-a1a8-3deddd552f11"],
 ", four orders more than Numerov disagrees with the exact answer. That \
ordering is the reason to run both: Numerov is fourth order by construction \
on exactly this equation, ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a35b7fa4-3d33-44f9-8309-a304a730a422"],
 " is general, and the exact answer is what reveals which of the two to \
believe. Had the analytic benchmark been unavailable, their mutual agreement \
to ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "6"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "813db7fa-ca8b-4ba6-ba0c-165e4918ccd0"],
 " would have been the only accuracy claim on offer, and it would have \
understated Numerov by four orders."
}], "Text",ExpressionUUID->"dea12faf-81f1-4b0c-9160-411490b2c55b"],

Cell[TextData[{
 "The refinement sweep is the part that cannot be skipped. The ground-state \
error falls ",
 Cell[BoxData[
  RowBox[{"3.2", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "7"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7577e413-e764-4787-919f-2b01638f0f4e"],
 ", ",
 Cell[BoxData[
  RowBox[{"2.0", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "8"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5c71116-5a29-4af1-8612-4e315996644f"],
 ", ",
 Cell[BoxData[
  RowBox[{"1.3", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "9"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0f9635c-9c2b-4157-9ed1-a1f4af647832"],
 ", ",
 Cell[BoxData[
  RowBox[{"8.9", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "11"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95bd5a2a-1c69-4a70-abed-06bc84686fef"],
 ", ",
 Cell[BoxData[
  RowBox[{"3.6", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "11"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3760f4fa-fb0d-42cf-bd49-2a018d76b7d1"],
 " as the grid doubles, which is ratios of ",
 Cell[BoxData["16.0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c274ac1-f8b8-4f86-8367-f799dfcefbac"],
 ", ",
 Cell[BoxData["16.0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0942ddaf-b140-4f1c-83f2-75ad50d60104"],
 ", ",
 Cell[BoxData["14.0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65117258-d06e-4ff7-a23b-0e7d62dc0992"],
 " and ",
 Cell[BoxData["2.5"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b94d7846-ea69-4cb7-86db-848fd55342e9"],
 ". The first two are ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["h", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "017ff9d0-75d7-494a-9694-861ea6a2e239"],
 " convergence measured rather than asserted: halve the step, cut the error \
sixteenfold. The third, ",
 Cell[BoxData["14.0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "192b0e49-e05c-4418-8460-f850e5165a9e"],
 ", is already ",
 Cell[BoxData[
  RowBox[{"12", "%"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "846cd31c-eca2-43a3-a5a8-9cf2790f41d9"],
 " short of ",
 Cell[BoxData["16"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fa23659-94f7-472f-a9e3-05b3724ec342"],
 ", and the fourth abandons the pattern entirely. That decay of the decay is \
the roundoff floor arriving: below about ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"-", "10"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b1dc2ea-f14d-4627-be03-6df70c1c9426"],
 " the truncation error the scheme controls has fallen beneath the arithmetic \
noise it does not, and refining the grid stops buying accuracy. A scheme's \
order is a claim about a sequence, and a single run cannot express it; nor, \
as the last two ratios show, can a sequence taken too far."
}], "Text",ExpressionUUID->"dd8d2959-71a4-4996-9feb-1aab6363b17e"],

Cell[TextData[{
 "The infinite well is the right ",
 StyleBox["benchmark", "TI"],
 " and the wrong ",
 StyleBox["test", "TI"],
 ", because ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], "\[Congruent]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16a10422-b851-499f-9c44-aaaad7c4d87e"],
 " makes ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "510c9916-896d-4417-a4ff-a3287c34bdf1"],
 " constant and the recurrence degenerate: the weights ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], "=", "1", "+", 
   SuperscriptBox[
    StyleBox["h", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], "/", "12"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "952b9a53-296e-4257-afb3-4420a66a4407"],
 " never vary, which is precisely the thing Numerov exists to track. A scheme \
tuned to a varying ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["k", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10678d91-fd0a-4a0f-a93d-b64e41e491fb"],
 " has not been exercised by a problem with no potential. So run the same ",
 Cell[BoxData["numerov"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f1b3fda-f65c-4f0a-9d44-9d518d938fa4"],
 " on a real well, the Poschl-Teller ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e93fa037-02a6-4c76-9694-7b88891226d4"],
 " whose exact levels ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "-", "2"}], ",", 
   RowBox[{"-", 
    FractionBox["1", "2"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f12a079-f77b-4885-ac04-9ca6e57c7fa8"],
 " we already know."
}], "Text",ExpressionUUID->"7cac2b7a-8d64-4015-aa97-07c2ade82a93"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"shootPT", "[", 
    RowBox[{"En_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"Last", "[", 
    RowBox[{"numerov", "[", 
     RowBox[{"En", ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "3"}], " ", 
        RowBox[{
         RowBox[{"Sech", "[", "#", "]"}], "^", "2"}]}], " ", "&"}], ",", " ", 
      
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "8."}], ",", " ", "8."}], "}"}], ",", " ", "4001"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"SameQ", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"0.", " ", "-", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "3"}], " ", 
              RowBox[{
               RowBox[{"Sech", "[", "#", "]"}], "^", "2"}]}], " ", "&"}], 
            ")"}], "[", 
           RowBox[{
            RowBox[{"-", "8."}], " ", "+", " ", 
            RowBox[{"#", " ", "0.004"}]}], "]"}]}], ")"}]}], " ", "&"}], " ", 
      "/@", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", "5"}], "]"}]}], ")"}]}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u", " ", "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{"shootPT", "[", "u", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"u", ",", " ", 
          RowBox[{"-", "2.3"}], ",", " ", 
          RowBox[{"-", "1.7"}]}], "}"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Brent\>\""}]}], "]"}]}], ",", 
     "\n", "  ", 
     RowBox[{"u", " ", "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{"shootPT", "[", "u", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"u", ",", " ", 
          RowBox[{"-", "0.8"}], ",", " ", 
          RowBox[{"-", "0.3"}]}], "}"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Brent\>\""}]}], "]"}]}]}], 
    "}"}]}], "}"}]}], "Input",
 CellLabel->
  "In[99]:= ",ExpressionUUID->"b5fd4c1b-391e-4ef9-bf0d-95f1f75cf8b5"],

Cell[TextData[{
 "The first entry is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1702e4d-08a9-4aed-a18e-8977f1cfa909"],
 ": on this well ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abde7f73-03af-4e77-b3df-a4f62b264598"],
 " genuinely varies from point to point, unlike the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], "\[Congruent]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b3212d0-0272-438a-9428-a00f1c3f85e5"],
 " case, so the ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2b020bf-a05c-4524-ac6f-5ba804f88934"],
 " weights are doing their job. The levels come back as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "-", "2.0000000000064"}], ",", " ", 
    RowBox[{"-", "0.4999986"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f32a136-e623-4604-b4d1-43b2a8b5dfcc"],
 " against the exact ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "-", "2"}], ",", 
   RowBox[{"-", 
    FractionBox["1", "2"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e177359-37dc-4b86-8d1f-5881a829beae"],
 ". Two things are worth reading off. The ground state is recovered to ",
 Cell[BoxData[
  RowBox[{"6", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa6c025d-e99c-4d84-bb57-57da21f0a7bd"],
 ", better than the infinite well managed, because the state is smooth and \
dies exponentially inside the box. The excited state is only good to ",
 Cell[BoxData[
  RowBox[{"1.4", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "6"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52c2fcf8-30e9-498d-9031-80c5c9af9844"],
 " and ",
 Cell[BoxData["FindRoot"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0431cf9-7ca0-4cb4-b430-e0897e395a06"],
 " reports ",
 Cell[BoxData["brmp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6334f404-c619-4eb9-abc9-2364f5043875"],
 ", that it has bracketed the root as tightly as machine precision allows: at \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", "-", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "009bca2e-d471-4ace-849f-8a76b1ac44b1"],
 " the decay constant ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "=", 
   SqrtBox[
    RowBox[{"2", GridBox[{
       {
        StyleBox["E", "TI"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "=", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd14c1b9-0c49-4977-8e1d-2e014604306e"],
 " is the slowest of the two, so on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", "8"}], ",", "8"}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78504dcd-1440-49df-9010-208885c4d888"],
 " that state has not finished decaying, and shooting outward through a long \
classically forbidden region amplifies the growing solution exponentially. \
That is the real limitation of naive shooting for weakly bound states, and it \
is why 3.5's box sweep found the same state to be the fussy one."
}], "Text",ExpressionUUID->"4b0a7895-dd00-4dba-aa56-8ab028dc7104"],

Cell[TextData[{
 "One trap here is worth more than the method. Guard ",
 Cell[BoxData["numerov"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91e47c63-bf24-4760-81f0-52c379cf3661"],
 " with ",
 Cell[BoxData["NumericQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "450636d7-cc15-459c-9e1a-65d5e0f40b37"],
 " but hand ",
 Cell[BoxData["FindRoot"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53a35db2-1bbc-4137-afb8-a96f72ec309e"],
 " the expression ",
 Cell[BoxData[
  RowBox[{"Last", "[", 
   RowBox[{"numerov", "[", 
    RowBox[{"En", ",", " ", "..."}], "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "014dd572-0467-4089-b952-d63c82945db4"],
 " directly, and the symbolic ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"E", "n"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41193d44-5a85-4af4-be31-c2921ccc61e2"],
 " leaves the call unevaluated, so ",
 Cell[BoxData["Last"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0b22f3-c953-4168-8ba0-6d8bd2d8882c"],
 " returns the last ",
 StyleBox["argument", "TI"],
 ", the integer ",
 Cell[BoxData["2001"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2114ff12-4bcb-434d-acff-4085fa4a9584"],
 ". ",
 Cell[BoxData["FindRoot"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33c6c242-5bac-4355-97e1-d7898fdd34a6"],
 " then dutifully searches for a root of the constant ",
 Cell[BoxData["2001"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "149e79fd-7315-4734-a387-85aa576c7f5e"],
 ", reports a singular Jacobian, and returns its own starting guess \
unchanged. Since the guess was near the answer, the output looks like a \
converged eigenvalue and is off by exactly the offset you seeded. The fix is \
to guard the composite, so ",
 Cell[BoxData[
  RowBox[{"shoot", "[", "En", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "224bf428-0b28-4d8e-9b14-81fb5e091a07"],
 " stays a single unevaluated head until ",
 Cell[BoxData["FindRoot"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "379d4563-ec97-47ca-bed6-c01840a297d9"],
 " supplies a number."
}], "Text",ExpressionUUID->"e8da72a1-5946-47d6-8543-66b23ffc1c46"],

Cell["\<\
3.7 [BSc] How do I show that the eigenstates of a symmetric potential have \
definite parity?\
\>", "Subsection",ExpressionUUID->"61d193f0-ac4a-4344-8937-4c9a19741264"],

Cell[TextData[{
 "Parity is the cleanest symmetry argument in quantum mechanics: if the \
potential is even then the parity operator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9c5c389-e99b-4f3f-80f9-6836933c1a71"],
 " commutes with ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0d30fc3-a1b0-4f1f-8a97-25292044aeef"],
 ", and a nondegenerate eigenstate of ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f162907-32b9-451b-9b78-4c8953f1a7ff"],
 " must then be an eigenstate of ",
 Cell[BoxData[
  StyleBox["P", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e019f4c8-fb01-4fc4-b4f5-21a3b741ed47"],
 " too, with eigenvalue ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9eb9c97f-4155-496c-9433-74d55d7caa8e"],
 " since ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["P", "TI"], "2"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e3c45ef-d208-4797-8683-a5f7162b43b2"],
 ". The whole statement is an operator identity, so no solver is needed."
}], "Text",ExpressionUUID->"0f26ac57-31b4-4295-8d68-79272a4a46a7"],

Cell[TextData[{
 "The potential here must be a genuinely ",
 StyleBox["unknown", "TI"],
 " symbol, so it is called ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8c1234b-7e43-43d4-80df-4a0bbecf6e6e"],
 ": reusing the ",
 Cell[BoxData["V"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12596d02-8e3d-4726-8742-79f77d9e1430"],
 " of 3.1 would silently supply the Poschl-Teller well, which is already \
even, and the commutator would collapse to zero for a reason having nothing \
to do with the argument being made."
}], "Text",ExpressionUUID->"1a1b8d0e-c866-4560-97cd-475282258e4b"],

Cell[BoxData[
 RowBox[{"comm", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"-", "x"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"W", "[", "x", "]"}], " ", 
       RowBox[{"f", "[", 
        RowBox[{"-", "x"}], "]"}]}]}], ")"}], "\n", "    ", "-", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}]}], " ", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"f", "[", "x", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"W", "[", "x", "]"}], " ", 
         RowBox[{"f", "[", "x", "]"}]}]}], ")"}], " ", "/.", " ", 
      RowBox[{"x", " ", "->", " ", 
       RowBox[{"-", "x"}]}]}], ")"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[100]:= ",ExpressionUUID->"f46d6443-6312-4a91-925f-c36b3b20a15c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{"comm", " ", "/.", " ", 
     RowBox[{
      RowBox[{"W", "[", 
       RowBox[{"-", "x"}], "]"}], " ", "->", " ", 
      RowBox[{"W", "[", "x", "]"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}]}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"-", "x"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"Vpt", "[", 
         RowBox[{"x", ",", " ", "1"}], "]"}], " ", 
        RowBox[{"f", "[", 
         RowBox[{"-", "x"}], "]"}]}]}], ")"}], "\n", "   ", "-", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}]}], " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"f", "[", "x", "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"Vpt", "[", 
           RowBox[{"x", ",", " ", "1"}], "]"}], " ", 
          RowBox[{"f", "[", "x", "]"}]}]}], ")"}], " ", "/.", " ", 
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"-", "x"}]}]}], ")"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[101]:= ",ExpressionUUID->"bcb49dbf-260c-408b-a60d-faec83ed46de"],

Cell[TextData[{
 "The first cell returns ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "(", 
   RowBox[{
    StyleBox["W", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "-", 
    StyleBox["W", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"-", 
     StyleBox["x", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "887c8dc1-703f-4cd6-904a-532cfef81d28"],
 " for a ",
 StyleBox["generic", "TI"],
 " ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bfecf621-2a07-410c-8bf1-b15e7349420b"],
 ", which is the useful form: the commutator is not zero in general, and it \
fails by exactly the odd part of the potential. This matters, because a check \
that returns zero for every ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26277840-db6d-4049-b01a-f981908e99e5"],
 " would prove nothing about symmetry, and it is the easiest way to fool \
yourself here. The second cell then imposes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7b50f45-10c0-496b-84bf-3b0520b84abb"],
 " and gets ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f14aef31-3acb-4a51-9f5e-e36fb5b52b4f"],
 ", and repeats it on the concrete even potential ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["V", "TI"], "1"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e8922d1-0269-431f-901d-6ef9a3e42aa4"],
 ", with no hand substitution, again ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c877239-80d3-4a6c-b7f2-3b401c118975"],
 "."
}], "Text",ExpressionUUID->"6e88717f-5027-4184-a85a-41d610cdc828"],

Cell[TextData[{
 "So ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["H", "TI"], ",", 
    StyleBox["P", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bd163ac-2e10-43e9-bd64-10093e39cf45"],
 " precisely when ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92d141d8-0b6a-4c29-b2a8-5030e3e4263d"],
 " is even. The consequence is the physics: if ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["\[Psi]", "TI"], "=", 
   StyleBox["E", "TI"], 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b90a3f3b-3d16-4bd6-9144-1774ed16e220"],
 " then ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"P", "\[Psi]"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["E", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"P", "\[Psi]"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92e1a9f0-a97d-4f6c-bb30-982a1b08a379"],
 ", so ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"P", "\[Psi]"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "272fc804-4f9e-4454-8f01-512d362ca370"],
 " is an eigenstate at the same energy; if that level is nondegenerate then \
",
 Cell[BoxData[
  StyleBox[
   RowBox[{"P", "\[Psi]"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab0d6551-bae3-4a55-9738-90d010398d3d"],
 " can only be a multiple of ",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35c51560-cb4c-44e2-8461-0b2e3cf65fa3"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["P", "TI"], "2"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "431c10a3-1928-466b-8080-2188ae8bed6a"],
 " forces the multiple to be ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62429faf-f5f0-4833-a269-8ff1d6fd2ec0"],
 "."
}], "Text",ExpressionUUID->"0d71a1da-cd04-4d1b-8a20-d71bce8abcb8"],

Cell[TextData[{
 "That conclusion is a claim about states, so it should be checked on states \
rather than left as an inference. 3.4 already ",
 StyleBox["assumed", "TI"],
 " it by splitting the finite well into separate even and odd quantization \
conditions; here is the assumption tested, on the well's own numerical \
eigenfunctions."
}], "Text",ExpressionUUID->"945a4201-bfdd-4bd0-9615-43ffac35a57d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fvals", ",", " ", "ffuns"}], "}"}], " ", "=", " ", 
   RowBox[{"NDEigensystem", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}]}], " ", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"u", "[", "x", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"well", "[", "x", "]"}], " ", 
         RowBox[{"u", "[", "x", "]"}]}]}], ",", "\n", "    ", 
       RowBox[{"DirichletCondition", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], " ", "==", " ", "0."}], ",", " ", 
         "True"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"u", "[", "x", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "12."}], ",", " ", "12."}], "}"}], ",", " ", "4", ",", 
     "\n", "   ", 
     RowBox[{"Method", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<SpatialDiscretization\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<FiniteElement\>\"", ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<MeshOptions\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"MaxCellMeasure", " ", "->", " ", "0.005"}], "}"}]}], 
            "}"}]}], "}"}]}], ",", "\n", "     ", 
        RowBox[{"\"\<Eigensystem\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Arnoldi\>\"", ",", " ", 
           RowBox[{"\"\<Shift\>\"", " ", "->", " ", 
            RowBox[{"-", "12.5"}]}]}], "}"}]}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{
        RowBox[{"ffuns", "[", 
         RowBox[{"[", 
          RowBox[{"Ordering", "[", "fvals", "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{"g", " ", 
           RowBox[{"(", 
            RowBox[{"g", " ", "/.", " ", 
             RowBox[{"x", " ", "->", " ", 
              RowBox[{"-", "x"}]}]}], ")"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", 
            RowBox[{"-", "12."}], ",", " ", "12."}], "}"}]}], "]"}], "/", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{"g", "^", "2"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", 
            RowBox[{"-", "12."}], ",", " ", "12."}], "}"}]}], "]"}]}], ",", 
       " ", "0.001"}], "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"j", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}]}], "Input",
 CellLabel->
  "In[102]:= ",ExpressionUUID->"12faf142-4135-4971-bcee-38fa1ab0aa02"],

Cell[TextData[{
 "The expectation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["P", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a9d5dc3-ccea-4db4-84e5-d04b1ca79e55"],
 " comes back as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", 
   RowBox[{"-", "1"}], ",", "1", ",", 
   RowBox[{"-", "1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4150b102-7161-42c5-b025-6f547937575a"],
 ": the finite well's four bound states well alternate strictly between even \
and odd, starting even, with no state of mixed parity and no value between ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40b5b385-6545-4a05-99b6-a2955cbc169e"],
 ". So the even/odd split of the quantization conditions was not a \
convenience, it was the spectrum's actual structure, and the numerical \
solver, which was told nothing about symmetry, discovered it anyway."
}], "Text",ExpressionUUID->"c610108d-ded5-4303-9e1c-77ec609c908b"],

Cell[TextData[{
 "The nondegeneracy clause is load-bearing rather than decorative: in one \
dimension bound states are nondegenerate, so the conclusion is safe here, but \
drop it and the argument fails, since in a degenerate level one can always \
form combinations of no definite parity. That is why the same ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["P", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c906f6b3-8f50-42c8-8110-b5c94ac32a39"],
 " result cannot be expected of, say, the 2D box's degenerate levels (8.5 of \
the routing reference makes exactly this point about eigenvectors in a \
degenerate subspace)."
}], "Text",ExpressionUUID->"3fdc95bf-9d99-44d8-a0ec-d0da8b529e0f"],

Cell[TextData[{
 "3.8 [MSc] How do I verify the node theorem, that the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "516dc998-ed88-4959-bc00-7204306d7ce9"],
 "-th bound state has exactly ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1f3e4e9-dfcc-4472-b70e-554b7c4a0af2"],
 " nodes?"
}], "Subsection",ExpressionUUID->"d0b615ba-9275-4ece-a42c-b227ee30d153"],

Cell[TextData[{
 "The node theorem orders the spectrum by shape alone: count the interior \
zeros of a bound state and you know its place in the spectrum, no energies \
needed. It is a theorem about a whole spectrum, so checking it on one state \
is no check; it has to be checked as a statement in ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58d8eedb-c821-4528-a26c-131ddc4bea66"],
 ", and it has to be checked somewhere the nodes are not already obvious."
}], "Text",ExpressionUUID->"7e801836-87c0-4aba-892d-598ba0d767a5"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"n", " ", "Pi", " ", 
       RowBox[{"x", "/", "L"}]}], "]"}], " ", "==", " ", "0"}], " ", "&&", 
    " ", 
    RowBox[{"0", " ", "<", " ", "x", " ", "<", " ", "L"}]}], ",", " ", "x", ",",
    " ", "Reals", ",", "\n", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{"n", ",", " ", "Integers"}], "]"}], " ", "&&", " ", 
     RowBox[{"n", " ", ">=", " ", "1"}], " ", "&&", " ", 
     RowBox[{"L", " ", ">", " ", "0"}]}]}]}], "]"}]], "Input",
 CellLabel->
  "In[103]:= ",ExpressionUUID->"ff1425ae-05a9-4a48-bfa6-84ec4d357f90"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Sin", "[", 
    RowBox[{"n", " ", "Pi", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"kk", " ", 
        RowBox[{"L", "/", "n"}]}], ")"}], "/", "L"}]}], "]"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "kk"}], "}"}], ",", " ", "Integers"}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[104]:= ",ExpressionUUID->"196287fb-813d-432e-89ee-1ec9a21b402c"],

Cell[TextData[{
 "For the infinite well the whole node family comes back at once, \
symbolically: ",
 Cell[BoxData["Solve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce99ebac-06b4-4dae-9ad8-842bb050cd80"],
 " returns ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "2", 
   StyleBox["L", "TI"], 
   SubscriptBox[
    StyleBox["C", "TI"], "1"], "/", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e75a6fc-1106-4587-871f-6870e3f863ce"],
 " subject to ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["C", "TI"], "1"], "\[Element]", "\:2124"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "954da830-2ec7-4cf6-9f5c-fb66f53af44b"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["C", "TI"], "1"], "\[GreaterEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79c6772c-72ba-4982-a00c-0cf02efcdcdb"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], ">", "2", 
   SubscriptBox[
    StyleBox["C", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce331b34-ac65-40c4-ab48-5c1730811318"],
 ", together with the odd companion. Those constraints are the statement ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", 
   StyleBox["k", "TI"], 
   StyleBox["L", "TI"], "/", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ebfc516-2685-4b02-942e-b728f6855a96"],
 " for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["k", "TI"], "=", "1"}], ",", "\[Ellipsis]", ",", 
   RowBox[{
    StyleBox["n", "TI"], "-", "1"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a64130c-313c-4fca-a1be-edff8a87de21"],
 ", so the well's ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47a7de84-3e6e-4175-98c4-340eb781c41f"],
 "-th eigenfunction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["n", "TI"], "\[Pi]", 
    StyleBox["x", "TI"], "/", 
    StyleBox["L", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2279f260-07d9-4a9c-a2cc-2c06a3074217"],
 " has exactly ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f2db29b-6716-443a-b884-9b9f1c13f9f2"],
 " interior nodes for ",
 StyleBox["arbitrary",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38933979-e9c0-4193-bef9-a05131bdd1a5"],
 " and ",
 StyleBox["symbolic",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  StyleBox["L", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f1bfb8f-35f4-4772-9c50-96508c2f3ee4"],
 ", not for five values of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16d78da8-1deb-447a-84cd-0dbba7db3053"],
 " at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "284548c6-bb35-4cca-8adb-238405362e25"],
 ". Counting levels from the ground state as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3330619b-6b73-47bd-a22a-8ae7be8e4f8e"],
 ", as the oscillator and the finite well below both do, that is the same \
law: level ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad361a6b-9648-4b78-9bee-54ef6568dde9"],
 " carries ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "909d373b-6a4a-4649-a6f4-f94d60dc2c37"],
 " nodes. The second cell confirms the zeros are where the constraints say, \
again for arbitrary integers."
}], "Text",ExpressionUUID->"3bc2a066-26d6-410f-8f55-8ead602cac3b"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"CountRoots", "[", 
    RowBox[{
     RowBox[{"HermiteH", "[", 
      RowBox[{"n", ",", " ", "y"}], "]"}], ",", " ", "y"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[105]:= ",ExpressionUUID->"9c5ec4b7-6da6-40d5-a6da-d68f23d3dc57"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nodesTol", "[", 
    RowBox[{"f_", ",", " ", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{"f", ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", 
           RowBox[{"-", "11.9"}], ",", " ", "11.9", ",", " ", "0.005"}], 
          "}"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"keep", " ", "=", " ", 
         RowBox[{"Pick", "[", 
          RowBox[{"v", ",", " ", 
           RowBox[{"UnitStep", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "v", "]"}], " ", "-", " ", 
             RowBox[{"tol", " ", 
              RowBox[{"Max", "[", 
               RowBox[{"Abs", "[", "v", "]"}], "]"}]}]}], "]"}], ",", " ", 
           "1"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{"Sign", "[", 
          RowBox[{
           RowBox[{"Most", "[", "keep", "]"}], " ", 
           RowBox[{"Rest", "[", "keep", "]"}]}], "]"}], ",", " ", 
         RowBox[{"-", "1"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nodes", "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{"nodesTol", "[", 
    RowBox[{"f", ",", " ", "1.*^-6"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nodes", " ", "/@", " ", 
    RowBox[{"ffuns", "[", 
     RowBox[{"[", 
      RowBox[{"Ordering", "[", "fvals", "]"}], "]"}], "]"}]}], ",", " ", 
   RowBox[{"nodes", "[", 
    RowBox[{"Sin", "[", 
     RowBox[{"6", " ", "Pi", " ", 
      RowBox[{"x", "/", "24"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"nodes", "[", 
    RowBox[{"1.", " ", "+", " ", 
     RowBox[{"0", " ", "x"}]}], "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[106]:= ",ExpressionUUID->"3d11a4a4-7254-43f6-8cfe-3b50c86b63ff"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"nodesTol", "[", 
      RowBox[{"#", ",", " ", "tol"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"ffuns", "[", 
     RowBox[{"[", 
      RowBox[{"Ordering", "[", "fvals", "]"}], "]"}], "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"tol", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"10.", "^", 
        RowBox[{"-", "14"}]}], ",", " ", 
       RowBox[{"10.", "^", 
        RowBox[{"-", "6"}]}], ",", " ", "0.5"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[107]:= ",ExpressionUUID->"a1828d32-0cd1-40c2-ba43-b4fac4225091"],

Cell[TextData[{
 "The oscillator makes the same count with a different potential and a \
different special function: ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["n", "TI"]], "\[Proportional]", 
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["y", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["y", "TI"], "2"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9875306c-aa10-452a-bcb0-ea226729cc02"],
 " has zeros exactly where the Hermite polynomial does, and ",
 Cell[BoxData["CountRoots"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e28e6d6-29ae-45af-bb73-7d818ff9999e"],
 " gives ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "0"}], ",", 
   RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], ",", 
   RowBox[{"6", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abf938bd-2812-4502-8cb4-a570638dc67c"],
 " for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["n", "TI"], "=", "0"}], ",", "\[Ellipsis]", ",", "6"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b6b35fc-bde7-4cce-9f50-ae9f91ba5486"],
 " (it counts ",
 StyleBox["real", "TI"],
 " roots, so this can fail: ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["y", "TI"], "6"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "958c2943-a40a-4e13-9a42-6698881a72fa"],
 " has degree ",
 Cell[BoxData["6"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dcaaf144-4831-4f03-a699-a2ea7456ff2a"],
 " and zero real roots)."
}], "Text",ExpressionUUID->"1af2d62f-c414-4166-8eee-ce00864cafe0"],

Cell[TextData[{
 "But ",
 Cell[BoxData[
  StyleBox["sin",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76b379f9-7a68-4e99-8b6c-6314d202aa5d"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["H", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a60171e-67e7-40cc-a603-c275319605ef"],
 " both wear their nodes on their sleeve, and a theorem checked only where \
the answer is visible by inspection has not been tested. The last cell counts \
nodes on the finite well's numerical eigenfunctions, a potential whose ",
 StyleBox["levels",
  FontWeight->"Bold"],
 " have no closed form (its eigenfunctions are elementary, but only once the \
transcendental ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["u", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bae908f-e000-4225-8b7b-acf7d10ee7af"],
 " is in hand, so the nodes still have to be counted numerically), and gets \
",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "0"}], ",", 
   RowBox[{"1", ",", "2"}], ",", 
   RowBox[{"3", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca6d59a6-cf28-4be2-92ce-60b50f4feb77"],
 ": the same law where the answer cannot simply be read off."
}], "Text",ExpressionUUID->"6376a9b4-78b7-4645-8ad4-12d6f7802a71"],

Cell[TextData[{
 "The mask in ",
 Cell[BoxData["nodes"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "928a613b-487f-4d88-bca5-9798e6443bbe"],
 " is doing real work rather than tidying: outside the well the numerical \
state decays to ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"-", "16"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba6a65b7-ef45-4657-8ba9-30089ee12ea6"],
 " and its ",
 StyleBox["sign", "TI"],
 " there is pure roundoff, so a naive sign-change count returns ",
 Cell[BoxData["153"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "721d36f0-5ed3-42af-9cb3-defdf4776fa0"],
 " nodes for the nodeless ground state. Discarding samples below ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"-", "6"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110f61d4-a7d0-4565-a4ff-41c5407ec50f"],
 " of the peak keeps only where the wavefunction actually is."
}], "Text",ExpressionUUID->"194e73f7-3292-43d2-837f-698f59bc29b4"],

Cell[TextData[{
 "A tolerance introduced to make an answer come out right deserves suspicion, \
so the last cell sweeps it. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tol",
    FontSlant->"Plain"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b3f6120-6fc3-46b3-96ec-df4abfad5c8d"],
 " the count is the nonsense ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "153"}], ",", 
   RowBox[{"16", ",", "2"}], ",", 
   RowBox[{"3", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2388307d-1ff9-4a86-814f-9901b2f0c38e"],
 "; at every threshold from ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"-", "14"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45acd78d-1cfa-4965-8e57-a596a4f28415"],
 " to ",
 Cell[BoxData["0.5"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7934b6fd-7c1a-4cb7-b477-0f604eae239a"],
 " it is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "0"}], ",", 
   RowBox[{"1", ",", "2"}], ",", 
   RowBox[{"3", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4de0c5bb-7154-43cb-85bd-1d183eda1af1"],
 ". That is a plateau spanning fourteen orders of magnitude, which is what \
distinguishes a principled cut from a fudge factor: the answer does not \
depend on where the cut is put, only on there being one. The two controls \
confirm the counter is not rigged to return the level index: it gives ",
 Cell[BoxData["5"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3ead4ad-0245-4b28-96ed-8c9e86473eb9"],
 " on a five-zero function and ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c88eb07a-de43-4add-a219-f361035d03f2"],
 " on a constant."
}], "Text",ExpressionUUID->"ad6e6f97-8fb1-45b0-892b-715ec675cc45"],

Cell["\<\
The law being tested has hypotheses, and they are what set its reach. Sturm's \
oscillation theorem applies to bound states of a one-dimensional \
Sturm-Liouville problem, ordered by increasing energy, and needs those levels \
non-degenerate. Drop any of them and the count fails: in a two-dimensional \
box the degenerate levels can be recombined at will, and their nodal patterns \
are lines whose count is not fixed by the level index at all. So four \
confirming instances are not what gives the theorem its scope; the hypotheses \
are.\
\>", "Text",ExpressionUUID->"c7b862f7-345d-4f59-8669-0b81e472a2a1"],

Cell[TextData[{
 "Three exactly solvable problems and one whose levels are transcendental, \
sharing one counting law: that is evidence the node theorem is about the \
structure of second-order eigenproblems, not about ",
 Cell[BoxData[
  StyleBox["sin",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a514f2d4-1f15-4e4a-b707-9d91ece1c083"],
 " or ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["H", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2536dd8-4dee-4ab8-88ce-2ca55daa5011"],
 "."
}], "Text",ExpressionUUID->"9c69de2b-195b-4cde-8e19-0b4be0007fb3"],

Cell["\<\
3.9 [BSc] How do I find the single bound state of an attractive \
delta-function potential?\
\>", "Subsection",ExpressionUUID->"33430cf5-aa60-4b06-9eae-e5536961cd6d"],

Cell[TextData[{
 "The delta well is the sharpest bound-state problem there is: a potential \
with no width, one parameter, and exactly one bound state no matter how weak. \
It is also where the symbolic route runs out and has to be replaced by \
physics rather than by a bigger solver. ",
 Cell[BoxData["DSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3bd02bb-6ce2-4c33-80fa-805846fe991a"],
 " on ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox["1", "2"], 
   SuperscriptBox[
    StyleBox["\[Psi]", "TI"], "\[DoublePrime]"], "-", 
   StyleBox["g", "TI"], " ", 
   StyleBox["\[Delta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["\[Psi]", "TI"], "=", 
   StyleBox["E", "TI"], 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d9fa609-6856-433d-8543-f2d3fc713f16"],
 " returns unevaluated, so the route is closed; and ",
 Cell[BoxData["NIntegrate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d15f0c4-8f76-422e-8d25-54f5f50f1d63"],
 " cannot help either, since it misses point measures entirely."
}], "Text",ExpressionUUID->"54d4c16a-16ab-4ca4-a123-b75a2ed04a93"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"DiracDelta", "[", "x", "]"}], " ", 
      RowBox[{"f", "[", "x", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "e"}], ",", " ", "e"}], "}"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"e", " ", ">", " ", "0"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"DiracDelta", "[", "x", "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", 
        RowBox[{"x", "^", "2"}]}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}]}], "}"}]], "Input",\

 CellLabel->
  "In[108]:= ",ExpressionUUID->"68a431fc-98b4-4c9c-afaa-6ac0ea626b12"],

Cell[TextData[{
 "The exact ",
 Cell[BoxData["Integrate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "323ad04c-946d-4fab-8157-1534a70a8d90"],
 " picks out ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a5d20da-db7a-4caf-a019-6c6923eae4ca"],
 "; ",
 Cell[BoxData["NIntegrate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5682d0f4-ddc8-4272-a685-841d0ca7a00f"],
 " returns ",
 Cell[BoxData["0."], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f026370-2e35-45f3-994f-cf2497fe4c66"],
 " and says so with an ",
 Cell[BoxData["izero"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d624a17-a866-4c98-9b0c-3e1e914a7abb"],
 " message. Any quadrature-based route to this problem is dead on arrival, \
which is the content of the trap rather than a detail of this example."
}], "Text",ExpressionUUID->"6745bfe2-96a7-451a-b925-17f3659d6aef"],

Cell[TextData[{
 "So integrate the equation itself across the origin. Over ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", 
     StyleBox["\[CurlyEpsilon]", "TI"]}], ",", 
    StyleBox["\[CurlyEpsilon]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3ff7736-91b8-4e9c-aea5-c17b2c8f0113"],
 " the ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Psi]", "TI"], "\[DoublePrime]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e8224f9-6e7b-48f0-87ba-2631568c295f"],
 " term gives the jump ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Psi]", "TI"], "\[Prime]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox["0", "+"], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   SuperscriptBox[
    StyleBox["\[Psi]", "TI"], "\[Prime]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox["0", "-"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14158ab3-765c-471b-8baa-1f1c1cf4cfd1"],
 ", the delta term gives ",
 Cell[BoxData[
  RowBox[{"-", "2", 
   StyleBox["g", "TI"], 
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c0f990c-63ea-4968-80f6-764409115c2a"],
 ", and the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"E", "\[Psi]"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0735bda9-0c40-4e1e-bf4f-0dfd9a251fff"],
 " term vanishes as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[CurlyEpsilon]", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8af214c9-6aec-444f-b76c-2f64424082b5"],
 " because ",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f38368f-ce78-45f9-a7e9-f4e583d965c9"],
 " is bounded. Away from the origin the potential is zero and a bound state (",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "<", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c391001c-03d8-4235-a44a-3923939ad811"],
 ") must decay, so the general candidate is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"\[Kappa]", "x"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c75c926-51bd-448e-ac3d-75b6f1dbf91e"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "<", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7578317-f7d9-4477-9225-8b861c0552fd"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Kappa]", "TI"], 
     StyleBox["x", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96986523-a677-4700-9a6a-e9e682bf8269"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "231ec9b4-8501-4c0d-ad34-7e5c2d678763"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", "-", 
   SuperscriptBox[
    StyleBox["\[Kappa]", "TI"], "2"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f7d06c6-0955-4a93-85d0-10fee96f7e35"],
 ". The delta puts its jump in ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Psi]", "TI"], "\[Prime]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e76c21e4-3267-4936-92ef-0cff23bb79ea"],
 ", not in ",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53d810a5-9f8e-463e-aed7-9e39d852b401"],
 ", so ",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e17ddf3-b985-4774-95b5-2af01e2ea9ee"],
 " stays continuous at the origin and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   StyleBox["B", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05cc582b-20c9-41c0-ba77-187ed1c8d1f9"],
 ": every bound state of this potential is automatically even, and there is \
no odd sector to check separately. That leaves ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], "=", 
   SqrtBox[
    StyleBox["\[Kappa]", "TI"]], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Kappa]", "TI"], GridBox[{
       {
        StyleBox["x", "TI"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc9028f9-7d34-4ce2-a368-60b421529a66"],
 ", continuous by construction, and imposing the jump fixes ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed8f9cb4-0380-4d4a-aba7-57c2009b7b54"],
 "."
}], "Text",ExpressionUUID->"285797b0-1ff9-4543-9f64-676c84a75828"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]R", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "k", "]"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "k"}], " ", "x"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]L", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "k", "]"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"+", "k"}], " ", "x"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[Psi]R", "'"}], "[", "0", "]"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"\[Psi]L", "'"}], "[", "0", "]"}]}], " ", "==", " ", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "g", " ", 
       RowBox[{"\[Psi]R", "[", "0", "]"}]}]}], ",", " ", 
     RowBox[{"k", " ", ">", " ", "0"}]}], "}"}], ",", " ", "k", ",", " ", 
   "Reals"}], "]"}]}], "Input",
 CellLabel->
  "In[109]:= ",ExpressionUUID->"2874f789-b470-4e0b-9396-9fe0ba36dff1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"k", "^", "2"}]}], "/", "2"}], " ", "/.", " ", 
    RowBox[{"First", "@", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Psi]R", "'"}], "[", "0", "]"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"\[Psi]L", "'"}], "[", "0", "]"}]}], " ", "==", " ", 
          RowBox[{
           RowBox[{"-", "2"}], " ", "g", " ", 
           RowBox[{"\[Psi]R", "[", "0", "]"}]}]}], ",", " ", 
         RowBox[{"k", " ", ">", " ", "0"}]}], "}"}], ",", " ", "k", ",", " ", 
       "Reals"}], "]"}]}]}], ",", "\n", " ", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"k", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "k", " ", 
        RowBox[{"Abs", "[", "x", "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"k", " ", ">", " ", "0"}]}]}], "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[110]:= ",ExpressionUUID->"d042afed-604e-4ab3-a0fd-62ab3b4399a2"],

Cell[TextData[{
 "The jump condition gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "=", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2db914e-ff9a-4301-8225-a008ad96014f"],
 ", so the bound state is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SqrtBox[
    StyleBox["g", "TI"]], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["g", "TI"], GridBox[{
       {
        StyleBox["x", "TI"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1df60e8-1ece-415a-abb6-f56ab855b723"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", "-", 
   SuperscriptBox[
    StyleBox["g", "TI"], "2"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb6823fe-4366-46ae-968d-c84336ff32f8"],
 " and unit norm, the cusped exponential ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Kappa]", "TI"]], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Kappa]", "TI"], GridBox[{
       {
        StyleBox["x", "TI"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c5b488d-a469-4325-8a88-0ddfc0c9707f"],
 " at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "=", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5ba355a-f487-413d-bd90-6baccb0be588"],
 ". The kink is now explained rather than merely observed: the cusp is the \
wavefunction's response to a potential concentrated at a point, and the jump \
in ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Psi]", "TI"], "\[Prime]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9780d6db-cc32-465a-a411-dcc17d64944c"],
 " ",
 StyleBox["is", "TI"],
 " the delta."
}], "Text",ExpressionUUID->"62a9d585-ce01-472b-977c-62c2762fb523"],

Cell[TextData[{
 "The constraint ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e836fad-2131-448f-b601-f4da9df46bf3"],
 " in the ",
 Cell[BoxData["Solve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56dfbc91-aa10-4155-ad0e-8a4f22973ea7"],
 " is doing real work. Drop it and the equation ",
 Cell[BoxData[
  RowBox[{"-", "2", 
   StyleBox["\[Kappa]", "TI"], 
   SqrtBox[
    StyleBox["\[Kappa]", "TI"]], "=", "-", "2", 
   StyleBox["g", "TI"], 
   SqrtBox[
    StyleBox["\[Kappa]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b382f0a1-ecb0-4c94-ae7d-3a51b63f528b"],
 " also admits the root ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95101388-9b42-4acc-9520-a371c6cd20ad"],
 ", which ",
 Cell[BoxData["Solve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62016daa-337c-4ecb-b7a1-d117ce785b1a"],
 " returns first; taking it silently yields ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "280fdae8-d3c5-47c2-baeb-a3ae15b8c214"],
 " and no bound state at all."
}], "Text",ExpressionUUID->"f55f0547-942b-4f63-ad52-2ae77e09a77a"],

Cell[TextData[{
 "The physics is in the counting. There is exactly one root ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "=", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6baec9a5-7a83-4b12-9063-263383105854"],
 " for every ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b3784bb-0e7d-4638-bf8f-45d744d90412"],
 ", so the delta well binds exactly one state however weak the attraction, \
and its energy ",
 Cell[BoxData[
  RowBox[{"-", 
   SuperscriptBox[
    StyleBox["g", "TI"], "2"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "346320cf-1dbb-4431-999a-bcdfa26f73d5"],
 " is ",
 StyleBox["quadratic", "TI"],
 " in the coupling, so a weakly bound state is bound very weakly indeed."
}], "Text",ExpressionUUID->"d8e7539b-6b85-49d9-b187-a53b7d0166a3"],

Cell[TextData[{
 "This is the zero-width limit of a finite square well made exact, and that \
is a quantitative claim, so it should be computed. Shrink the half-width ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71ce2f52-86c3-4f95-8b5d-64340c16456b"],
 " while deepening the well at fixed ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], "=", "2", 
   StyleBox["a", "TI"], 
   SubscriptBox[
    StyleBox["V", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7388f1fc-11a8-4a95-be0e-c6683c0893e4"],
 ", and the finite well's single surviving level must approach ",
 Cell[BoxData[
  RowBox[{"-", 
   SuperscriptBox[
    StyleBox["g", "TI"], "2"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ddba1ac-12e4-45d2-ab0f-f2314f573f6e"],
 "."
}], "Text",ExpressionUUID->"b963ea2f-f33f-43a4-8b93-0c1f8d83f1cb"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u0", " ", "=", " ", 
         RowBox[{"a", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"1", "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", "a"}], ")"}]}], ")"}]}], "]"}]}]}], "}"}], ",",
        " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"u0", "^", "2"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"First", "[", 
             RowBox[{"uAll", "[", "u0", "]"}], "]"}], "^", "2"}]}], ")"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"a", "^", "2"}]}], ")"}]}]}], "]"}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"{", 
    RowBox[{"a", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", " ", "0.1", ",", " ", "0.02", ",", " ", "0.004"}], 
      "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[111]:= ",ExpressionUUID->"b9c4bd8c-ba94-496a-9608-a428fc63231e"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cafe8ef0-e948-4dde-9833-92a8b2284fdc"],
 " fixed the finite well's ground level runs ",
 Cell[BoxData[
  RowBox[{"-", "0.308"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af3ad5d3-1006-41f7-8196-c736fa022d08"],
 ", ",
 Cell[BoxData[
  RowBox[{"-", "0.442"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e48274d-606a-497e-925b-6a07e013ae74"],
 ", ",
 Cell[BoxData[
  RowBox[{"-", "0.487"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0f3724d-d67e-4f46-b4eb-786c7d3b85ad"],
 ", ",
 Cell[BoxData[
  RowBox[{"-", "0.497"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c633b14-df42-4ae9-961f-f5224d109c3d"],
 " as the half-width shrinks ",
 Cell[BoxData[
  RowBox[{"0.5", "\[Rule]", "0.004"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08b720ac-7dda-4e40-b6a6-46c222f9ca8a"],
 ", converging to the delta well's exact ",
 Cell[BoxData[
  RowBox[{"-", 
   SuperscriptBox[
    StyleBox["g", "TI"], "2"], "/", "2", "=", "-", "0.5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2034d8e-83ff-4abd-b520-2778e169b6bb"],
 ". The approach is slow, and visibly linear in ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "897ab4e4-e3a8-4c4d-b433-27f39e047ea0"],
 " rather than quadratic, which is the finite well remembering it has a \
width. So the delta well's cusped bound state is not merely analogous to the \
finite well's last level, it ",
 StyleBox["is", "TI"],
 " its zero-width limit, and two independent routes (a transcendental root \
and a jump condition) agree in the limit where both apply."
}], "Text",ExpressionUUID->"e25ebd7e-ffd5-4430-989f-5b9601816f2d"],

Cell["\<\
3.10 [MSc] How do I solve the linear (triangular) potential in terms of Airy \
functions, the quantum bouncer?\
\>", "Subsection",ExpressionUUID->"6a2a489d-e120-4957-93e3-bba4c9952ae1"],

Cell[TextData[{
 "A particle above a floor in a uniform field, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["F", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e04dcf5c-230c-488a-b6ed-580bcec7dd33"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7484b3f5-ed8d-4478-9472-ad04ecc98bbf"],
 " with a hard wall at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b36dec3-d461-44bc-a5f6-def7812df12f"],
 ", is the quantum bouncer, and it is the cleanest demonstration that ",
 StyleBox["the differential equation quantizes nothing; the boundary \
condition does.",
  FontWeight->"Bold"],
 " Routing it: the class is a second-order linear ODE with a linear \
coefficient, whose exact symbolic solution is a classical special function, \
so ",
 Cell[BoxData["DSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03e6ccff-9ce7-4203-ad4a-d50b65a167dc"],
 " is the primary route and the quantization is imposed afterwards by hand. \
",
 Cell[BoxData["NDEigensystem"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da68f92-0e72-41cf-9882-0db6be61b087"],
 " on a truncated domain is the independent cross-check."
}], "Text",ExpressionUUID->"8660ded2-0b19-4911-8f8e-1243972e98f7"],

Cell[BoxData[
 RowBox[{"DSolveValue", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}], " ", 
      RowBox[{
       RowBox[{"u", "''"}], "[", "x", "]"}]}], " ", "+", " ", 
     RowBox[{"F", " ", "x", " ", 
      RowBox[{"u", "[", "x", "]"}]}]}], " ", "==", " ", 
    RowBox[{"En", " ", 
     RowBox[{"u", "[", "x", "]"}]}]}], ",", " ", 
   RowBox[{"u", "[", "x", "]"}], ",", " ", "x"}], "]"}]], "Input",
 CellLabel->
  "In[112]:= ",ExpressionUUID->"be1f842b-2937-423d-a1c9-0f28024e3066"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], " ", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"AiryAi", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", " ", "F"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "3"}], ")"}]}], " ", 
         RowBox[{"(", 
          RowBox[{"x", " ", "-", " ", 
           RowBox[{"En", "/", "F"}]}], ")"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], "\n", "   ", "+", " ", 
    RowBox[{"F", " ", "x", " ", 
     RowBox[{"AiryAi", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "F"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "3"}], ")"}]}], " ", 
       RowBox[{"(", 
        RowBox[{"x", " ", "-", " ", 
         RowBox[{"En", "/", "F"}]}], ")"}]}], "]"}]}], " ", "-", " ", 
    RowBox[{"En", " ", 
     RowBox[{"AiryAi", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "F"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "3"}], ")"}]}], " ", 
       RowBox[{"(", 
        RowBox[{"x", " ", "-", " ", 
         RowBox[{"En", "/", "F"}]}], ")"}]}], "]"}]}]}], ",", "\n", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"F", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[113]:= ",ExpressionUUID->"e0c5fbcc-2d33-494a-8215-d8813b08dd5d"],

Cell[TextData[{
 Cell[BoxData["DSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6f7c9dd-6176-43e4-a629-30d0ad3c77d6"],
 " returns ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["C", "TI"], "1"], 
   StyleBox["Ai",
    FontSlant->"Plain"], "\[NegativeThinSpace]", "(", 
   FractionBox[
    RowBox[{"2", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["F", "TI"], 
      StyleBox["x", "TI"], "-", 
      StyleBox["E", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"2", 
       StyleBox["F", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{"2", "/", "3"}]]], ")", "+", 
   SubscriptBox[
    StyleBox["C", "TI"], "2"], 
   StyleBox["Bi",
    FontSlant->"Plain"], "\[NegativeThinSpace]", "(", "\[CenterEllipsis]", 
   ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9483b22a-cafa-4ead-bb93-18f98ac5f4d9"],
 ", and the second cell confirms the residual is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19db6953-5c02-464c-a44f-edf1055dc22a"],
 " for ",
 StyleBox["arbitrary",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  StyleBox["E", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae9f2dde-4325-45a3-aeab-9d0315efff7f"],
 " and ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03219b43-6fb4-4722-97be-ca3988b3bf2b"],
 ". That is the whole point: every energy solves the equation. ",
 Cell[BoxData[
  StyleBox["Bi",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33ef72c3-ded3-49a6-b00f-f9be70f4a7cc"],
 " is discarded because it grows without bound as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "\[Rule]", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57f13779-e52a-468f-b0af-f427c66d7787"],
 ", which is normalizability, not the equation, doing the work. What is left \
is the wall at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "804e245c-d380-4131-af17-a8bfde9f6daa"],
 ", and only there does the spectrum appear: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b838c92a-746b-4936-934e-282062ce547e"],
 " forces the argument of ",
 Cell[BoxData[
  StyleBox["Ai",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eef77c3a-ea73-46fe-b656-b8fe8bd08370"],
 " at the wall to be a zero of ",
 Cell[BoxData[
  StyleBox["Ai",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a8a7367-5589-4bd6-abc7-f26adaf12f50"],
 "."
}], "Text",ExpressionUUID->"c4de9fe3-636b-43a4-add0-4c517990a568"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Ebounce", "[", 
    RowBox[{"n_", ",", " ", "F_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"F", "^", "2"}], "/", "2"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "3"}], ")"}]}]}], " ", 
    RowBox[{"AiryAiZero", "[", "n", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eAiry", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"Ebounce", "[", 
       RowBox[{"n", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"eAiry", ",", " ", 
   RowBox[{"Sort", "@", 
    RowBox[{"NDEigenvalues", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}]}], " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"u", "[", "x", "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", " ", 
         RowBox[{"x", " ", 
          RowBox[{"u", "[", "x", "]"}]}]}], ",", " ", 
        RowBox[{"DirichletCondition", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"u", "[", "x", "]"}], " ", "==", " ", "0"}], ",", " ", 
          "True"}], "]"}]}], "}"}], ",", "\n", "   ", 
      RowBox[{"u", "[", "x", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", " ", "25"}], "}"}], ",", " ", "4"}], 
     "]"}]}]}], "}"}]}], "Input",
 CellLabel->
  "In[114]:= ",ExpressionUUID->"bf658361-7ccc-4ade-9f92-021ff0fb43e5"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"box", ",", " ", 
     RowBox[{"Max", "@", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sort", "@", 
           RowBox[{"NDEigenvalues", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"(", 
                   RowBox[{"1", "/", "2"}], ")"}]}], " ", 
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"u", "[", "x", "]"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"x", ",", " ", "2"}], "}"}]}], "]"}]}], " ", "+", 
                " ", 
                RowBox[{"x", " ", 
                 RowBox[{"u", "[", "x", "]"}]}]}], ",", "\n", "        ", 
               RowBox[{"DirichletCondition", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"u", "[", "x", "]"}], " ", "==", " ", "0"}], ",", 
                 " ", "True"}], "]"}]}], "}"}], ",", " ", 
             RowBox[{"u", "[", "x", "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"x", ",", " ", "0", ",", " ", "box"}], "}"}], ",", " ", 
             "4", ",", "\n", "       ", 
             RowBox[{"Method", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<SpatialDiscretization\>\"", " ", "->", " ", 
                RowBox[{"{", 
                 RowBox[{"\"\<FiniteElement\>\"", ",", "\n", "          ", 
                  RowBox[{"{", 
                   RowBox[{"\"\<MeshOptions\>\"", " ", "->", " ", 
                    RowBox[{"{", 
                    RowBox[{"MaxCellMeasure", " ", "->", " ", "0.002"}], 
                    "}"}]}], "}"}]}], "}"}]}], "}"}]}]}], "]"}]}], " ", "-", 
          " ", "eAiry"}], ")"}], "/", "eAiry"}], "]"}]}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"{", 
    RowBox[{"box", ",", " ", 
     RowBox[{"{", 
      RowBox[{"10.", ",", " ", "15.", ",", " ", "20.", ",", " ", "25."}], 
      "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[115]:= ",ExpressionUUID->"a488b8f3-34ac-43f0-9a99-efed149c8763"],

Cell[TextData[{
 "The quantization condition ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Ai",
    FontSlant->"Plain"], "\[NegativeThinSpace]", "(", 
   RowBox[{"-", 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"2", 
       StyleBox["F", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{"1", "/", "3"}]], 
    StyleBox["E", "TI"], "/", 
    StyleBox["F", "TI"]}], ")", "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e768656a-95d9-4d51-a12d-251fa0a5d686"],
 " gives the closed form ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"]], "=", "-", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["F", "TI"], "2"], "/", "2"}], ")"}], 
    RowBox[{"1", "/", "3"}]], 
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d193143-6248-4804-bc8f-d62a8826c2ae"],
 " with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e933cd37-5d17-4a89-912d-e025a4c2766a"],
 " the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95bcd056-1d83-40fc-8c54-1f35227ad723"],
 "-th (negative) zero of ",
 Cell[BoxData[
  StyleBox["Ai",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1beec650-181d-49d6-ae91-64a14d6583e0"],
 ", symbolic in the field strength ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c390a436-267a-4421-a9ee-3380df63536c"],
 ". At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["F", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42f6d5ba-d074-4988-bc12-4af539feaa2e"],
 " the first four levels are ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1.8558"}], ",", "3.2446", ",", "4.3817", ",", 
   RowBox[{"5.3866", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4aa4f2d1-97f2-422c-8bd7-2c656bea4ae6"],
 "."
}], "Text",ExpressionUUID->"fc523b39-7bcd-4c0c-be9d-680541a220bf"],

Cell[TextData[{
 "The comparison cell is worth reading rather than nodding at. ",
 Cell[BoxData["NDEigensystem"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dafea60-0dbc-43cd-b947-059abe2e4fab"],
 " at its ",
 StyleBox["default", "TI"],
 " mesh returns ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1.8601"}], ",", "3.2568", ",", "4.4064", ",", 
   RowBox[{"5.4857", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7413826-4e7c-4b22-8136-0c9eb9f5ff9b"],
 ", which agrees with the closed form only to about two significant figures, \
and the disagreement grows with the level: ",
 Cell[BoxData[
  RowBox[{"0.2", "%"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf2b0b6e-d35a-4722-8e35-b95b12d7e9e6"],
 " on the ground state but ",
 Cell[BoxData[
  RowBox[{"1.8", "%"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90b619a5-8491-427d-9816-23e52443c214"],
 " by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb501a65-22c9-4ee6-b5a0-10c3b7b625ee"],
 ". Reported alone, those numbers would look like confirmation to anyone \
reading them to three digits. They are not; they are an unconverged mesh."
}], "Text",ExpressionUUID->"31e412b7-7d53-4151-9b25-b00d7ad31f7b"],

Cell[TextData[{
 "The sweep is what earns the agreement. With the mesh refined to ",
 Cell[BoxData["0.002"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2537ac14-96ae-4c17-9c4e-5c7b784ddb52"],
 " the relative disagreement drops to ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "10"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f205ab4-1a62-44df-b626-51c60dd0ac99"],
 " at a box of ",
 Cell[BoxData["10"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc26f9a2-f86e-4298-a4fa-64506bf631b3"],
 " and to ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3ee098d-30d4-4beb-acf1-694dda842355"],
 " by a box of ",
 Cell[BoxData["20"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a27be861-3ea2-4a78-9e39-6e5cb981fa3a"],
 ", after which it stops improving. The plateau is physical: the bouncer's \
potential rises forever, so unlike 3.5 there is no continuum to leak into and \
the truncation at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", 
   StyleBox["box",
    FontSlant->"Plain"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f65dc1f7-1036-4956-aa44-d21b7d4c0fcf"],
 " is harmless ",
 StyleBox["provided", "TI"],
 " the box sits well beyond the classical turning point ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["n", "TI"]], "=", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"]], "/", 
   StyleBox["F", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8262725f-a691-432a-ba1f-d7a2301b9aca"],
 " of the highest state wanted. Once every state requested is comfortably \
inside its turning point, the remaining error is the mesh, not the box, and \
growing the box further buys nothing. The ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["F", "TI"], 
   RowBox[{"2", "/", "3"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "784065a6-a6b5-4599-a0cc-edb803c8f441"],
 " scaling of the levels is visible in the closed form and is the signature \
the experiment measures: it is why bouncing ultracold neutrons in the Earth's \
gravitational field have level spacings of order peV."
}], "Text",ExpressionUUID->"abc94725-111c-41a2-bb38-c02329dc3a90"],

Cell["\<\
So far only energies. A spectrum is not a state, and the brief's invariant is \
unit norm on every bound state, so the eigenfunction has to be built and \
normalized too. It closes in closed form.\
\>", "Text",ExpressionUUID->"d48c8ba4-522b-4526-83b0-579aa638ab24"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"AiryAi", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "3"}], ")"}]}], " ", "x"}], " ", "+", " ", 
        RowBox[{"AiryAiZero", "[", "1", "]"}]}], "]"}], "^", "2"}], ",", " ", 
     
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], "]"}], ",",
    "\n", " ", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"AiryAiPrime", "[", 
       RowBox[{"AiryAiZero", "[", "1", "]"}], "]"}], "^", "2"}], "/", 
     RowBox[{"2", "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "3"}], ")"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"AiryAi", "[", 
      RowBox[{"AiryAiZero", "[", "n", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->
  "In[116]:= ",ExpressionUUID->"7987dd80-375d-4a74-b8e9-39cfa81df977"],

Cell[TextData[{
 "The normalization integral ",
 Cell[BoxData[
  RowBox[{
   UnderoverscriptBox["\[Integral]", "0", "\[Infinity]",
    LimitsPositioning->False], 
   SuperscriptBox[
    StyleBox["Ai",
     FontSlant->"Plain"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cd94d30-bb9b-4691-bbb5-8007f140d7be"],
 " evaluates to ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["Ai",
     FontSlant->"Plain"], "\[Prime]"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["a", "TI"], 
      StyleBox["n", "TI"]], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], "/", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"2", 
      StyleBox["F", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{"1", "/", "3"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac4614c5-586e-46c5-87a0-1b7b530dc9a2"],
 ", and quadrature agrees at ",
 Cell[BoxData["0.39026"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d595d44-6846-4fea-a8fd-697d66b6fcec"],
 ": the normalized bouncer state is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["Ai",
    FontSlant->"Plain"], "\[NegativeThinSpace]", "(", 
   RowBox[{
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"2", 
       StyleBox["F", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{"1", "/", "3"}]], 
    StyleBox["x", "TI"], "+", 
    SubscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["n", "TI"]]}], ")", 
   StyleBox["/",
    FontSize->1.2 Inherited], "[", 
   RowBox[{
    SuperscriptBox[
     StyleBox["Ai",
      FontSlant->"Plain"], "\[Prime]"], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["n", "TI"]], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"2", 
       StyleBox["F", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{"1", "/", "6"}]]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "988f9959-4ac6-4b93-84c4-79a029a0c382"],
 ", with no numerical integration needed. The third entry is the wall \
condition itself, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["Ai",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ecb2ff80-b621-4cce-a790-6872d40f510d"],
 " exactly, for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c7e9601-8ce1-4885-bd16-655fc53332c5"],
 " and every ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "327c785c-5c53-4289-bcda-786bd14f88e0"],
 ": the boundary condition that produced the spectrum is satisfied \
identically, which is the check that the quantization was imposed rather than \
assumed."
}], "Text",ExpressionUUID->"a230e5ba-e378-4537-abfb-1481d3bc6e4f"],

Cell[TextData[{
 "Finally the limit that could fail. Restoring units, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"]], "=", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[HBar]", "2"], 
       SuperscriptBox[
        StyleBox["F", "TI"], "2"]}], 
      RowBox[{"2", 
       StyleBox["m", "TI"]}]], ")"}], 
    RowBox[{"1", "/", "3"}]], 
   SuperscriptBox[
    RowBox[{"[", 
     FractionBox[
      RowBox[{"3", "\[Pi]", 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["n", "TI"], "-", 
        FractionBox["1", "4"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"], "]"}], 
    RowBox[{"2", "/", "3"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "929f936b-8f2d-42e2-861e-a56efeaf3e73"],
 ", so ",
 Cell[BoxData["\[HBar]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d383332e-a099-4a0a-b1e8-c9c5677dbb4a"],
 ", ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75ae0dfe-9ff8-43eb-b38b-8efa0b44929e"],
 " and ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "311d6c46-fbda-430e-881f-896d67900611"],
 " enter only through the prefactor and cancel entirely from the ",
 StyleBox["ratio", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"], 
    StyleBox["WKB",
     FontSlant->"Plain"]], "/", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b16363a-654a-4907-9083-c6239403ebb0"],
 ". The semiclassical parameter is the classical action measured in units of ",
 Cell[BoxData["\[HBar]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b186eea-f27b-44bb-8337-f713f5f9f72c"],
 ", so shrinking ",
 Cell[BoxData["\[HBar]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "667d0e3a-24d2-403d-b135-a44e52b4c160"],
 " at fixed ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "adb73b2a-2284-4359-8b74-d69325fa3245"],
 " does not improve the relative WKB error at all; the limit with content is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[Rule]", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a11823c-0b47-4f2f-8ecd-c65301612ed3"],
 ", where the levels crowd and the WKB estimate must become exact. \
Bohr-Sommerfeld for a hard wall plus a linear rise gives ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"], 
    StyleBox["WKB",
     FontSlant->"Plain"]], "=", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{"3", "\[Pi]", 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["n", "TI"], "-", 
        FractionBox["1", "4"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"], ")"}], 
    RowBox[{"2", "/", "3"}]], 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      SuperscriptBox[
       StyleBox["F", "TI"], "2"], "2"], ")"}], 
    RowBox[{"1", "/", "3"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ad05cad-2fa4-4c4e-82d9-fea4ff92a48c"],
 "."
}], "Text",ExpressionUUID->"a31cd85c-fd14-47e4-acdf-58937edcb2ae"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", ",", " ", 
     RowBox[{"N", "@", 
      RowBox[{"Ebounce", "[", 
       RowBox[{"n", ",", " ", "1"}], "]"}]}], ",", " ", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"3", " ", "Pi", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", " ", "-", " ", 
             RowBox[{"1", "/", "4"}]}], ")"}], "/", "2"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"2", "/", "3"}], ")"}]}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "3"}], ")"}]}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"N", "@", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"3", " ", "Pi", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"n", " ", "-", " ", 
               RowBox[{"1", "/", "4"}]}], ")"}], "/", "2"}]}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"2", "/", "3"}], ")"}]}], " ", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"1", "/", "3"}], ")"}]}], "/", 
          RowBox[{"Ebounce", "[", 
           RowBox[{"n", ",", " ", "1"}], "]"}]}]}], " ", "-", " ", "1"}], 
       "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "5", ",", " ", "20", ",", " ", "100"}], "}"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[117]:= ",ExpressionUUID->"130b5a3c-99b4-43e6-9a11-95d574767244"],

Cell[TextData[{
 "The relative error falls ",
 Cell[BoxData[
  RowBox[{"7.6", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "969bf0ea-c85b-4144-9307-8340534c197f"],
 ", ",
 Cell[BoxData[
  RowBox[{"2.1", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "4"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d4a5270-8fdc-4aec-82f4-f05df24beea7"],
 ", ",
 Cell[BoxData[
  RowBox[{"1.2", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "5"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa6df378-3f10-4160-8626-82db43fa616e"],
 ", ",
 Cell[BoxData[
  RowBox[{"4.7", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "7"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1448dd73-77fb-451c-8989-69c2b95adcf8"],
 " at ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["n", "TI"], "=", "1"}], ",", 
   RowBox[{"5", ",", "20", ",", "100"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09d9016f-a059-4822-a5ba-9e3f9cbc834d"],
 ": WKB is already good to a percent on the ",
 StyleBox["ground", "TI"],
 " state and becomes exact as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[Rule]", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "316ac0d9-bc60-4a07-9759-3af662e2b362"],
 ", the correspondence principle with content. The ratio ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"], 
    StyleBox["WKB",
     FontSlant->"Plain"]], "/", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc600f39-8215-4770-a1d4-c6996f1ec50d"],
 " is independent of ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2edb6e2d-cb85-41f0-b63c-9ed015eb7496"],
 " (both sides carry the same ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      StyleBox["F", "TI"], "2"], "/", "2"}], ")"}], 
   RowBox[{"1", "/", "3"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52d242a5-d7e2-4843-b7f4-3d51b1b06e27"],
 "), so this is a statement in ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c39e4556-b5e3-4eee-9485-2ed9a4127520"],
 " alone, and it is why the ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox["1", "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cb85009-0e7b-412d-ab93-52153b9d6618"],
 " in the Maslov index matters: drop it and the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2785ca2-3638-46cf-af53-b12776f07540"],
 " error is an order of magnitude worse."
}], "Text",ExpressionUUID->"a8186c22-d21a-4f86-bc80-efddb24d5602"],

Cell[TextData[{
 "Note that the exact symbolic eigenproblem is not simply unavailable here. \
",
 Cell[BoxData["DEigensystem"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4936fed-e191-4b81-be80-92d443527cff"],
 " on the bouncer in a box does return, as ",
 Cell[BoxData["Root"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ef9afdb-a158-45d3-a036-f9eb60ac997d"],
 " objects built from ",
 Cell[BoxData[
  StyleBox["Ai",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c238d3eb-7066-47a0-b078-8bbe491735c6"],
 " and ",
 Cell[BoxData[
  StyleBox["Bi",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f47836d5-75da-4ff1-a7f4-9b1110f52c29"],
 " that agree with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bbd215c-955d-4908-a6d6-e85c335ba89d"],
 " above, but it emits internal ",
 Cell[BoxData[
  RowBox[{"ReplaceAll", "::", "reps"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8b9111e-24f3-4df9-87f7-10a6a50d7963"],
 " messages while doing so. ",
 Cell[BoxData["DSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37ddb7ee-41a7-4fe2-bf8f-1c308a6d432e"],
 " plus the Airy zero is the same physics obtained cleanly, and it keeps ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b57b9f1-24dc-42a0-a159-533f9ae798a8"],
 " symbolic, which the eigensolver route does not."
}], "Text",ExpressionUUID->"1c4ce958-ee39-4c96-a194-a73a61267a0d"]
},
CreateCellID->True,
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (February 17, 2026)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"1158e001-2112-4f0f-b3e2-6643bb05355a"
]
