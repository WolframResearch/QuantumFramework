{FullSimplify[-(1/2) D[\\[Psi]n[n, x], {x, 2}] - (n^2 Pi^2/(2 L^2)) \\[Psi]n[n, x], asn],
 FullSimplify[Integrate[\\[Psi]n[n, x]^2, {x, 0, L}, asn], asn]}", InputForm], InputForm], "\n"];
WriteString[$Output, "=== 3.3 cell 77 ===\n"];
WriteString[$Output, ToString[ToExpression["FullSimplify[Integrate[\\[Psi]n[m, x] \\[Psi]n[n, x], {x, 0, L},
   Assumptions -> L > 0 && Element[{m, n}, Integers] && m >= 1 && n >= 1 && m != n],
  Assumptions -> Element[{m, n}, Integers] && m != n]", InputForm], InputForm], "\n"];
WriteString[$Output, "=== 3.3 cell 78 ===\n"];
WriteString[$Output, ToString[ToExpression["fC[x_] := x^2 (L - x);
cn = FullSimplify[Integrate[\\[Psi]n[n, x] fC[x], {x, 0, L}, asn], asn]", InputForm], InputForm], "\n"];
WriteString[$Output, "=== 3.3 cell 79 ===\n"];
WriteString[$Output, ToString[ToExpression["res = Sum[cn \\[Psi]n[n, x], {n, 1, Infinity}];
Table[With[{lv = RandomReal[{0.5, 4}]},
   With[{xv = RandomReal[{0.01, 0.99}] lv},
    Chop[N[(res - fC[x]) /. {L -> lv, x -> xv}], 10^-10]]], {8}]", InputForm], InputForm], "\n"];
WriteString[$Output, "=== 3.3 cell 80 ===\n"];
WriteString[$Output, ToString[ToExpression["{FullSimplify[Sum[cn^2, {n, 1, Infinity}], Assumptions -> L > 0],
