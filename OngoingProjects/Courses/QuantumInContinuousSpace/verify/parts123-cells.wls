WriteString[$Output, "=== 3.4 cell 81 ===\n"];
WriteString[$Output, ToString[ToExpression["Head@DEigenvalues[{-(1/2) D[u[x], {x, 2}] + Piecewise[{{-12.5, Abs[x] < 1.}}, 0.] u[x],
   DirichletCondition[u[x] == 0, True]}, u[x], {x, -8., 8.}, 4]", InputForm], InputForm], "\n"];
WriteString[$Output, "=== 3.4 cell 82 ===\n"];
WriteString[$Output, ToString[ToExpression["fEven[u0_][u_?NumericQ] := u Sin[u] - Sqrt[u0^2 - u^2] Cos[u];
fOdd[u0_][u_?NumericQ] := u Cos[u] + Sqrt[u0^2 - u^2] Sin[u];
bracket[f_, u0_] := With[{us = Subdivide[10.^-9, u0 (1 - 10.^-9), 4000]},
   With[{fs = f /@ us}, Pick[Partition[us, 2, 1], Sign[Most[fs] Rest[fs]], -1]]];
rootsOf[f_, u0_] := (u /. FindRoot[f[u], {u, #[[1]], #[[2]]}, Method -> \"Brent\"]) & /@ bracket[f, u0];
uAll[u0_] := Sort[Join[rootsOf[fEven[u0], u0], rootsOf[fOdd[u0], u0]]];
nBound[u0_] := Ceiling[2 u0/Pi];
{uAll[5.], nBound[5.]}", InputForm], InputForm], "\n"];
WriteString[$Output, "=== 3.4 cell 83 ===\n"];
WriteString[$Output, ToString[ToExpression["Table[Length[uAll[u0]] == nBound[u0], {u0, {0.05, 0.5, 1.5, 2.0, 3.2, 7.9, 12.8, 20.1, 50.3}}]", InputForm], InputForm], "\n"];
WriteString[$Output, "=== 3.4 cell 84 ===\n"];
WriteString[$Output, ToString[ToExpression["Esym[u0_, u_, a_] := -(u0^2 - u^2)/(2 a^2);
eFinite = Esym[5., uAll[5.], 1.];
{eFinite,
 Table[With[{u0 = a Sqrt[2 12.5]}, First@Esym[u0, uAll[u0], a]], {a, {1., 2., 4.}}],
 Table[With[{V0 = 12.5/a^2}, a^2 First@Esym[a Sqrt[2 V0], uAll[a Sqrt[2 V0]], a]],
  {a, {1., 2., 4.}}]}", InputForm], InputForm], "\n"];
WriteString[$Output, "=== 3.4 cell 85 ===\n"];
WriteString[$Output, ToString[ToExpression["{With[{us = uAll[200.]}, (us[[1 ;; 4]]^2)/(us[[1]]^2)], Length[uAll[0.01]]}", InputForm], InputForm], "\n"];
WriteString[$Output, "=== 3.5 cell 86 ===\n"];
WriteString[$Output, ToString[ToExpression["well[x_] := Piecewise[{{-12.5, Abs[x] < 1.}}, 0.];
