Table[{n, n^2 Pi^2/2., v /. FindRoot[shootND[v], {v, n^2 Pi^2/2. - 0.4, n^2 Pi^2/2. + 0.4},
    Method -> \"Brent\"]}, {n, 1, 4}]", InputForm], InputForm], "\n"];
WriteString[$Output, "=== 3.6 cell 92 ===\n"];
WriteString[$Output, ToString[ToExpression["shootN[En_?NumericQ, np_Integer] := Last[numerov[En, 0. &, {0., 1.}, np]];
