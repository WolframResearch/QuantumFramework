WriteString[$Output, ToString[ToExpression["Max@Abs[(ndAll[12., 0.005] - eFinite)/eFinite]", InputForm], InputForm], "\n"];
WriteString[$Output, "=== 3.6 cell 90 ===\n"];
WriteString[$Output, ToString[ToExpression["numerov[En_?NumericQ, v_, {x0_, x1_}, npts_Integer] := With[{h = (x1 - x0)/(npts - 1)},
   With[{ks = 2 (En - v[x0 + # h]) & /@ Range[0, npts - 1]},
    With[{w = Partition[Transpose[{ks, 1 + h^2 ks/12}], 3, 1]},
     Prepend[Last /@ FoldList[
        With[{fm = #2[[1, 2]], k0 = #2[[2, 1]], fp = #2[[3, 2]]},
          {#1[[2]], (2 (1 - 5 h^2 k0/12) #1[[2]] - fm #1[[1]])/fp}] &,
        {0., 1.*^-6}, w], 0.]]]];
shoot[En_?NumericQ] := Last[numerov[En, 0. &, {0., 1.}, 2001]];
{Length@numerov[4.9348, 0. &, {0., 1.}, 201],
 Table[{n, n^2 Pi^2/2., u /. FindRoot[shoot[u], {u, n^2 Pi^2/2. - 0.4, n^2 Pi^2/2. + 0.4},
     Method -> \"Brent\"]}, {n, 1, 4}]}", InputForm], InputForm], "\n"];
WriteString[$Output, "=== 3.6 cell 91 ===\n"];
WriteString[$Output, ToString[ToExpression["shootND[En_?NumericQ] := NDSolveValue[{u''[x] == -2 En u[x], u[0] == 0, u'[0] == 1},
