(* Beginning of Notebook Content *)
Notebook[{
Cell["Part 1. Pure states and the Born rule", "Section",ExpressionUUID->"eb3321b1-f9ac-4708-8cd3-8bf36e84674e"],

Cell[TextData[{
 "1.1 [BSc] How do I represent a qubit as a state vector ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["\[Alpha]", "TI"]}], ",", 
   RowBox[{
    StyleBox["\[Beta]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1622a5ba-ec8e-446e-b802-89dcbb2ee624"],
 " in ",
 Cell[BoxData[
  SuperscriptBox["\:2102", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02679f80-0369-4a1b-b10c-37f2f1aa533e"],
 "?"
}], "Subsection",ExpressionUUID->"94b5316c-3c7d-44a6-b301-efd506cb5ded"],

Cell[TextData[{
 "A pure qubit is a two-component complex vector ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["\[Alpha]", "TI"], 
     TemplateBox[{"0"},
      "Ket"]}], "+", 
    RowBox[{
     StyleBox["\[Beta]", "TI"], 
     TemplateBox[{"1"},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9246f7-890f-4bde-9bd1-e28c8e1e69a2"],
 "."
}], "Text",ExpressionUUID->"15acb864-798d-40c1-b2ae-aef16e180e5f"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : a qubit is literally a length-2 complex list, kept fully general."
}], "Text",ExpressionUUID->"aab6a88d-88dd-40b9-864f-513614c91f63"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5687b03c-ace7-4bb1-93d8-f9e4d6c3f048"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : wrap the amplitudes in ",
 Cell[BoxData["QuantumState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b94003f8-33b4-4a28-beb9-f6f3a3d97599"],
 ". Evaluated without a trailing semicolon, the construction displays as its ",
 StyleBox["summary box",
  FontWeight->"Bold"],
 ": a compact panel that ",
 StyleBox["is", "TI"],
 " the live object, showing its type, dimension, and basis, not a printout of \
a matrix. Properties are read off that object on demand."
}], "Text",ExpressionUUID->"f6844703-2592-4e55-948b-3224ccc6247b"],

Cell[BoxData[
 RowBox[{"qs", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f151c46f-8a19-4454-aa10-637c7c5b0243"],

Cell[TextData[{
 "Then ",
 Cell[BoxData["\"\<StateVector\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "699d382a-cd94-4816-a4b8-1f0db9e68e2f"],
 " reads one representation, the amplitudes, back out:"
}], "Text",ExpressionUUID->"39e10dc7-9f69-42d0-80c1-6cbe7b4e331b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qs", "[", "\"\<StateVector\>\"", "]"}], " ", "//", " ", 
  "Normal"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"efe3c020-8460-4310-a3ca-0e69496e85e6"],

Cell[TextData[{
 "Both hold the amplitudes ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["\[Alpha]", "TI"]}], ",", 
   RowBox[{
    StyleBox["\[Beta]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87f701b5-df70-42e4-8597-1c87f30facbf"],
 "; the QF object additionally knows it is a single qubit in the \
computational basis, and the summary box is that object itself, with the \
amplitude vector just one field read from it."
}], "Text",ExpressionUUID->"720dd689-059e-45ab-ad7f-b4ae10839832"],

Cell["\<\
1.2 [BSc] How do I read the Born-rule probabilities of a state?\
\>", "Subsection",ExpressionUUID->"7dd1f9c9-060d-4963-8f48-bc6164fe6085"],

Cell[TextData[{
 "The probability of outcome ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca2c736b-ce99-44f9-ad9d-1488c28899e6"],
 " is ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["i", "TI"], 
        StyleBox["\[Psi]", "TI"]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61307289-08d7-46bf-8004-588226734cf7"],
 ", i.e. the squared modulus of the amplitude (divided by the norm if the \
state is not yet normalized)."
}], "Text",ExpressionUUID->"ec2708e0-8e53-4730-9b3b-ced512a8ef9e"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : square the moduli of the normalized amplitudes, mapping ",
 Cell[BoxData["FullSimplify"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "420107dc-5482-430a-bee1-70b88a550149"],
 " across the two components so each collapses to a single ratio."
}], "Text",ExpressionUUID->"b3485573-8b48-4996-9dc4-9c4ebf5b1075"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", " ", "/@", " ", 
   RowBox[{"Abs", "[", 
    RowBox[{"Normalize", "[", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], "]"}]}], "^", 
  "2"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"a1094519-e934-4eae-9153-e191e32f9a76"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : ask the state for its probabilities; ",
 Cell[BoxData["\"\<ProbabilitiesList\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38540460-ca62-4611-a922-4cc3376525c7"],
 " normalizes internally and returns them in basis order."
}], "Text",ExpressionUUID->"46d19c95-cd5c-45b2-9bb5-c15c713d0448"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], 
  "[", "\"\<ProbabilitiesList\>\"", "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"746f8eab-9872-4679-a676-03e059332f12"],

Cell[TextData[{
 "Both give ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox["{",
       FontSize->1.2 Inherited], 
      SuperscriptBox[GridBox[{
         {
          StyleBox["\[Alpha]", "TI"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], ",", " ", 
     SuperscriptBox[GridBox[{
        {
         StyleBox["\[Beta]", "TI"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
    StyleBox["}",
     FontSize->1.2 Inherited]}], "/", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SuperscriptBox[GridBox[{
        {
         StyleBox["\[Alpha]", "TI"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "+", 
     SuperscriptBox[GridBox[{
        {
         StyleBox["\[Beta]", "TI"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99dba280-cb7c-4615-9c88-96871fedf667"],
 ": the Born rule weights the outcomes by the squared amplitudes, unequally \
in general, and the weights sum to one."
}], "Text",ExpressionUUID->"bbef3a14-b1c8-432e-8435-fff2230c4599"],

Cell["\<\
1.3 [BSc] How do I check that a state is normalized, and normalize one that \
is not?\
\>", "Subsection",ExpressionUUID->"018ebc41-b397-4eac-aeec-c5f11b5a44ea"],

Cell[TextData[{
 "A physical state vector must have unit norm, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"], 
     StyleBox["\[Psi]", "TI"]},
    "BraKet"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a97a20bd-d647-49be-9582-a142ae2cf8c1"],
 "."
}], "Text",ExpressionUUID->"4b92cb9d-5718-4f5d-b535-897a1d5b2098"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : ",
 Cell[BoxData["Norm"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0cdffba-035d-4b51-b2d6-92b1c10c9bed"],
 " measures the length of the raw amplitude vector."
}], "Text",ExpressionUUID->"46d52d63-e707-41c0-b472-2f387e7eb06a"],

Cell[BoxData[
 RowBox[{"Norm", "[", 
  RowBox[{"{", 
   RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"0da1f06a-cde2-4c48-9aef-004c3ab775eb"],

Cell[TextData[{
 Cell[BoxData["Normalize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f518d020-1f65-4203-97e7-a36aba1f1911"],
 " rescales it to unit length, so the norm of the normalized vector is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f96902e-2383-438d-b1c6-0d7dd1e265be"],
 "."
}], "Text",ExpressionUUID->"900d19a0-5ecc-4e87-9459-bed51e2b7329"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"Norm", " ", "@", " ", 
   RowBox[{"Normalize", "[", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"4033dd13-726a-4ecc-9387-96e9fd7ac803"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the ",
 Cell[BoxData["\"\<Norm\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "446e8162-8db8-4bd1-bf77-64213c78ac28"],
 " property reports the same raw length."
}], "Text",ExpressionUUID->"6248be2a-f2c3-4442-b9ac-7ae115837c30"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], 
  "[", "\"\<Norm\>\"", "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"fee81240-4ca1-4778-b825-7f9878921c14"],

Cell[TextData[{
 Cell[BoxData["\"\<Normalize\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "716e104d-f989-4b37-912a-68cbb838f1e3"],
 " returns a new, unit-norm state object, whose ",
 Cell[BoxData["\"\<Norm\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ada515f4-1b67-48a3-ba25-9705693abd59"],
 " is then ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "663abe7c-4ecf-4013-82dc-caca185303b4"],
 "."
}], "Text",ExpressionUUID->"5553b2d0-2645-4925-9cd2-7244d6bac8a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], 
   "[", "\"\<Normalize\>\"", "]"}], "[", "\"\<Norm\>\"", "]"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"026e5b48-f483-490f-b3e1-680d59b4cccb"],

Cell[TextData[{
 "Both report the raw norm ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox[GridBox[{
       {
        StyleBox["\[Alpha]", "TI"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "+", 
    SuperscriptBox[GridBox[{
       {
        StyleBox["\[Beta]", "TI"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c6a03c3-737e-48d0-bece-516cdff2dca3"],
 " and confirm the normalized state has norm ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4db7fe9-0d35-4fdf-84a7-c5761f14a3e8"],
 "."
}], "Text",ExpressionUUID->"833584c9-a447-4864-a550-f86dada6bddd"],

Cell["\<\
1.4 [BSc] How do I show that a global phase is physically unobservable?\
\>", "Subsection",ExpressionUUID->"1486963d-1cf6-4773-b6ee-c3d599e4f3e0"],

Cell[TextData[{
 "Multiplying ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2690758d-c05f-4589-be58-4be7fe3cf4d6"],
 " by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{
    StyleBox["i", "TI"], "\[CurlyPhi]"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddbacf82-6e45-4168-979b-beb0084185c3"],
 " changes no measurable prediction, because every probability depends only \
on ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      SubscriptBox[
       StyleBox["c", "TI"], 
       StyleBox["i", "TI"]]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f657cc2-e6d5-4675-ba34-635684fb71cd"],
 "."
}], "Text",ExpressionUUID->"ba129789-6bfd-4d50-8529-570a6ffa09b2"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : compare the two probability vectors symbolically for all real phases."
}], "Text",ExpressionUUID->"d2813ec5-bdb2-4311-8878-7027aad92151"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", "\n", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], "^", "2"}], 
    " ", "==", " ", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "\[CurlyPhi]"}], "]"}], " ", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}]}], "]"}], "^", 
     "2"}]}], ",", "\n", " ", 
   RowBox[{"\[CurlyPhi]", " ", "\[Element]", " ", "Reals"}]}], "]"}]], "Input",\

 CellLabel->
  "In[10]:= ",ExpressionUUID->"33db7db9-0868-45f6-8129-9165dee974c5"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : compare the two state objects directly. QuantumFramework's ",
 Cell[BoxData["=="], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a7060db-5c4b-4939-8811-9ed35d36475b"],
 " is a ",
 StyleBox["physical", "TI"],
 " comparison: it equates states that differ only by a global phase (it uses \
an inner-product oracle, not the raw amplitudes, so ",
 Cell[BoxData["==="], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c0f943e-7a44-41c7-b356-e4343685ad8d"],
 " would still see them as distinct)."
}], "Text",ExpressionUUID->"64b0b466-bec4-4eb2-a169-acdc78defac6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], " ", "==", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "\[CurlyPhi]"}], "]"}], " ", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"dbd36e51-fd75-4034-9266-40bff0aff494"],

Cell[TextData[{
 "Both return ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a1cd870-4d97-43a1-9fee-731a2e1f5dd0"],
 ", symbolically, for every phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "726adbf7-687c-483c-ac5d-abdfd9a4401c"],
 ": the WL test shows the Born probabilities are phase-independent, and \
QuantumFramework declares the two state objects ",
 StyleBox["equal", "TI"],
 ". The phase labels no physical degree of freedom."
}], "Text",ExpressionUUID->"6ae2df85-6409-4472-8dbf-566ceb13f4fc"],

Cell[TextData[{
 "1.5 [BSc] How do I count the real parameters of a pure qubit and a pure \
qudit in ",
 Cell[BoxData[
  SuperscriptBox["\:2102", 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82acce51-f82e-4130-8bdd-f320b42852b0"],
 "?"
}], "Subsection",ExpressionUUID->"2ccfa1f6-d4fb-4573-a93c-f84ae327c957"],

Cell[TextData[{
 "A pure state in ",
 Cell[BoxData[
  SuperscriptBox["\:2102", 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9345daa3-0792-4204-b499-c9b780e1928e"],
 " has ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "368a0aa7-60f1-4173-9d5a-dc0b9daa7d84"],
 " real amplitude components; normalization removes one and the global phase \
another, so the naive count is ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["d", "TI"], "-", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d311955a-4863-44f3-916e-9a2a0e1bf047"],
 ". But that bookkeeping ",
 StyleBox["assumes", "TI"],
 " each constraint removes exactly one independent direction. To ",
 StyleBox["measure",
  FontWeight->"Bold"],
 " the count instead of assuming it, note what \"degrees of freedom\" means \
geometrically: the states sweep out a surface, and the number of free real \
parameters is the ",
 StyleBox["dimension", "TI"],
 " of that surface. The dimension of a parametrized surface is the generic ",
 StyleBox["rank of its Jacobian",
  FontWeight->"Bold"],
 ", the matrix of derivatives ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[PartialD]", 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}], "/", 
   RowBox[{"\[PartialD]", 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["parameter",
      FontSlant->"Plain"], 
     StyleBox[")",
      SpanMaxSize->1]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cc530b8-4cd7-43c8-bb2c-615ac0ee62e6"],
 ": the rank is how many linearly independent directions the state actually \
moves in as the parameters vary, and a redundant parameter (whose motion \
duplicates another's) does not raise it. That is why the Jacobian rank is the \
rigorous count, and why it exposes the global phase as a genuine redundancy."
}], "Text",ExpressionUUID->"f405cf17-ed29-46d2-8cd8-7ec04d8115c0"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : embed the qubit family (the two Bloch angles plus the global phase ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96190702-b2d0-4276-96d0-a552791d2c7e"],
 ") into ",
 Cell[BoxData[
  SuperscriptBox["\:211d", "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99e2df2c-4d02-416a-b47d-64c2c907c2e6"],
 " as real and imaginary parts, and count its independent tangent directions. \
With the phase kept, the rank is ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1270f9db-2144-445b-b16a-2a3a38edc5b6"],
 ": the normalized states fill a 3-sphere."
}], "Text",ExpressionUUID->"4947f62c-7c57-4b84-9995-7c3bb0956c24"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"psi", " ", "=", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "g"}], "]"}], " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}]}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"MatrixRank", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"ReIm", "[", 
        RowBox[{"ComplexExpand", "[", "psi", "]"}], "]"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", " ", "\[Phi]", ",", " ", "g"}], "}"}], 
       "}"}]}], "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"32246e07-283c-4e6c-8af2-37f8d0dc641b"],

Cell[TextData[{
 "Drop the phase ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6a0004d-7d0f-4084-8cfb-986f5107a7a8"],
 " and the rank falls to ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8624e1c3-6833-428e-8fc9-7573b6a57dd5"],
 ", the physical state space. The drop of exactly one direction is the global \
phase, a single redundancy."
}], "Text",ExpressionUUID->"76fc99b9-9137-4cd5-a15a-77e9ee79602f"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"psi", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}]}], "}"}], ",", "\n",
    " ", 
   RowBox[{"MatrixRank", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"ReIm", "[", 
        RowBox[{"ComplexExpand", "[", "psi", "]"}], "]"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], "}"}]}], "]"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"62607b59-09b5-4cba-aef3-f1a37ec99b63"],

Cell[TextData[{
 "For a general qudit, drop the hand-built chart and differentiate the one \
object that ",
 StyleBox["already", "TI"],
 " has both redundancies removed: the density matrix ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"], 
    RowBox[{
     TemplateBox[{
       StyleBox["\[Psi]", "TI"]},
      "Bra"], "/", 
     TemplateBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["\[Psi]", "TI"]},
      "BraKet"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de5ec9e1-6d63-4c3e-95a3-3aa00211f9fd"],
 ". Build it from a raw, unnormalized vector ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "\[Element]", 
   SuperscriptBox["\:2102", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5416c782-9114-430b-aadf-c54da097069f"],
 " and take the ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f232d39-9bbb-488f-adb9-dd3886992241"],
 " real and imaginary components of ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f858f97-726e-442e-8b85-331311270764"],
 " as the parameters. Because ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9ed1e12-2826-4107-bd61-959d19b42b53"],
 " is unchanged by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "\[Rule]", 
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7852a1d-2a51-4eb3-a7af-c0bfa1932986"],
 " for any complex ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "375cfd6b-aabf-46e3-9191-bcf5c8953dc6"],
 ", it discards the normalization ",
 StyleBox["and", "TI"],
 " the global phase at a single stroke, so its Jacobian rank is the physical \
parameter count for any ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d474f8c6-b0e4-4f2d-9ffa-0250d553a13e"],
 "."
}], "Text",ExpressionUUID->"03449eaf-9432-423f-967c-7792fb4e0781"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : form the projector ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   SuperscriptBox[
    StyleBox["z", "TI"], "\[Dagger]"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["z", "TI"], "\[Dagger]"], 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ef8b8e3-5a6e-444b-b016-2528b2239f66"],
 " by hand and rank its Jacobian for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], "=", "2"}], ",", 
   RowBox[{"3", ",", "4"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa5fd8ba-22d9-4174-8d46-a09b663e1712"],
 "."
}], "Text",ExpressionUUID->"30a24b81-0f38-4ea7-86a2-6a09ffe73122"],

Cell[BoxData[
 RowBox[{"Table", "[", "\n", " ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", " ", "=", " ", 
       RowBox[{
        RowBox[{"Array", "[", 
         RowBox[{"a", ",", " ", "d"}], "]"}], " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"Array", "[", 
          RowBox[{"b", ",", " ", "d"}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"MatrixRank", "[", 
      RowBox[{"D", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"ReIm", "[", 
          RowBox[{"ComplexExpand", "[", "\n", "      ", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"Outer", "[", 
              RowBox[{"Times", ",", " ", "z", ",", " ", 
               RowBox[{"Conjugate", "[", "z", "]"}]}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Conjugate", "[", "z", "]"}], " ", ".", " ", "z"}], 
              ")"}]}], "]"}], "]"}], "]"}], "]"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Array", "[", 
            RowBox[{"a", ",", " ", "d"}], "]"}], ",", " ", 
           RowBox[{"Array", "[", 
            RowBox[{"b", ",", " ", "d"}], "]"}]}], "]"}], "}"}]}], "]"}], 
      "]"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{"d", ",", " ", "2", ",", " ", "4"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"c2c17746-d064-4b13-bd29-3b7140202ea0"],

Cell[TextData[{
 "The ranks ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "2"}], ",", "4", ",", 
   RowBox[{"6", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2dac585-4bf3-4317-ae71-508620ee17f5"],
 " are exactly ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["d", "TI"], "-", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75b82c85-e4de-424a-97e5-505855671a74"],
 ": each added Hilbert-space dimension contributes two new real parameters."
}], "Text",ExpressionUUID->"bf17c2df-84bd-43a8-87bc-cdcde2ab8101"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : a ",
 Cell[BoxData["QuantumState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ddd3fbf-0871-467b-bd3f-1992b76713a3"],
 " carries the same density matrix, so take it from the object instead of \
building it. QF leaves a ",
 StyleBox["symbolic", "TI"],
 " input unnormalized (its ",
 Cell[BoxData["\"\<DensityMatrix\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb3fab13-4c3e-446b-b94d-188ea19199ec"],
 " is the bare ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   SuperscriptBox[
    StyleBox["z", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "472425d2-b636-4d0b-b59a-e6a4478a5db2"],
 ", of trace ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"], 
    StyleBox["\[Psi]", "TI"]},
   "BraKet"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6db91d45-da4a-40f4-87ef-20cf1d08e099"],
 "), so divide by the trace and rank the identical map."
}], "Text",ExpressionUUID->"e9026f6d-0ac5-4b04-b527-8468cb8820a6"],

Cell[BoxData[
 RowBox[{"Table", "[", "\n", " ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dm", " ", "=", " ", 
       RowBox[{
        RowBox[{"QuantumState", "[", 
         RowBox[{
          RowBox[{"Array", "[", 
           RowBox[{"a", ",", " ", "d"}], "]"}], " ", "+", " ", 
          RowBox[{"I", " ", 
           RowBox[{"Array", "[", 
            RowBox[{"b", ",", " ", "d"}], "]"}]}]}], "]"}], 
        "[", "\"\<DensityMatrix\>\"", "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"MatrixRank", "[", 
      RowBox[{"D", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"ReIm", "[", 
          RowBox[{"ComplexExpand", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"dm", "/", 
             RowBox[{"Tr", "[", "dm", "]"}]}], "]"}], "]"}], "]"}], "]"}], ",",
         "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Array", "[", 
            RowBox[{"a", ",", " ", "d"}], "]"}], ",", " ", 
           RowBox[{"Array", "[", 
            RowBox[{"b", ",", " ", "d"}], "]"}]}], "]"}], "}"}]}], "]"}], 
      "]"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{"d", ",", " ", "2", ",", " ", "4"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"a79476fb-0e1f-49b7-b3be-b386dd57501c"],

Cell[TextData[{
 "So a qubit has exactly two real parameters, the two Bloch angles: the rank \
falls from ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "205eff45-26a1-4bfc-ab0f-681a4f128380"],
 " (the normalized vectors, a 3-sphere in ",
 Cell[BoxData[
  SuperscriptBox["\:211d", "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f8da2d9-ef6b-4e94-8f99-4e4c4e450932"],
 ") to ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee550fb6-7eb3-4e77-855e-ca68cc3ff14c"],
 " (the physical states) precisely when the global phase is removed. For any \
qudit the gauge freedom ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "\[Rule]", 
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9bb58910-7e67-419f-bfd3-16406a0c3c3d"],
 " is always two real dimensions, one scale and one phase, so the \
density-matrix rank is ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["d", "TI"], "-", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e6a0eb1-8ef2-4b09-bd22-1ce57834a74f"],
 " for every ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4bb2350-030a-4f3f-b4cb-a5ca10e1b06e"],
 ". The measured ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "2"}], ",", "4", ",", 
   RowBox[{"6", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac5f1866-203a-4607-a3a1-5459f2f84f53"],
 " confirm it, extending to ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "2"}], ",", 
   RowBox[{"4", ",", "6", ",", "8", ",", "10"}], ",", 
   RowBox[{"\[Ellipsis]", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b44ffc0a-7a49-4f96-a5e8-bce2e04cccd4"],
 " for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], "=", "2"}], ",", 
   RowBox[{"3", ",", "4", ",", "5", ",", "6"}], ",", "\[Ellipsis]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f36f77aa-940d-4497-b4bf-c4342fb1e975"],
 "."
}], "Text",ExpressionUUID->"6878bd10-aa1b-40b7-8f5b-3b029c780594"],

Cell[TextData[{
 "1.6 [BSc] How do I compute an inner product ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Phi]", "TI"], 
    StyleBox["\[Psi]", "TI"]},
   "BraKet"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25079c35-61f7-40a2-9102-74d0f985f1ae"],
 ", its modulus, and the transition probability ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["\[Phi]", "TI"], 
        StyleBox["\[Psi]", "TI"]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32e7105d-8131-44c9-b3f6-52e0e4147ae6"],
 "?"
}], "Subsection",ExpressionUUID->"a0eb75cd-bee3-42ce-963c-ee5744174827"],

Cell["\<\
The overlap of two states, its absolute value, and its absolute square give \
the amplitude and the probability to find one state in the other.\
\>", "Text",ExpressionUUID->"f6455e51-4717-4dc3-a3f5-ce99d87c0cc9"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the inner product is the ",
 StyleBox["conjugated", "TI"],
 " dot product; the conjugation acts on the bra ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Phi]", "TI"]},
   "Bra"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "887774df-5195-43f7-9bdf-321195797055"],
 ", which is why ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["\[Beta]", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8152e2-85c1-4732-8d28-a84c88315f46"],
 " appear conjugated. The cell returns the overlap, its modulus, and its \
transition probability as a labeled Association, one inner product read three \
ways."
}], "Text",ExpressionUUID->"12c27ef9-c068-4a2c-b84d-7c1b539851d4"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"phi", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]1", ",", " ", "\[Beta]1"}], "}"}]}], ",", " ", 
     RowBox[{"psi", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]2", ",", " ", "\[Beta]2"}], "}"}]}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ip", " ", "=", " ", 
       RowBox[{
        RowBox[{"Conjugate", "[", "phi", "]"}], " ", ".", " ", "psi"}]}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{"AssociationThread", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<\[LeftAngleBracket]\[Phi]|\[Psi]\[RightAngleBracket]\>\"",
          ",", "\n", 
         "    ", "\"\<|\[LeftAngleBracket]\[Phi]|\[Psi]\[RightAngleBracket]|\>\
\"", ",", "\n", 
         "    ", "\"\<|\[LeftAngleBracket]\[Phi]|\[Psi]\[RightAngleBracket]\!\
\(\*SuperscriptBox[\(|\), \(2\)]\)\>\""}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"ip", ",", " ", 
         RowBox[{"Abs", "[", "ip", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"Abs", "[", "ip", "]"}], "^", "2"}]}], "}"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"72ca228e-8a1e-4a68-ab3d-b5c1f1ae40bd"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : build the bra with ",
 Cell[BoxData["\"\<Dagger\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c7b87a8-f09b-40e7-930b-bf5b94653a02"],
 ", compose with the ket, and read the same three quantities off the scalar, \
under the same labels."
}], "Text",ExpressionUUID->"117d8342-29fe-462b-9c82-d82692ad3134"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"bra", " ", "=", " ", 
      RowBox[{
       RowBox[{"QuantumState", "[", 
        RowBox[{"{", 
         RowBox[{"\[Alpha]1", ",", " ", "\[Beta]1"}], "}"}], "]"}], 
       "[", "\"\<Dagger\>\"", "]"}]}], ",", " ", 
     RowBox[{"ket", " ", "=", " ", 
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]2", ",", " ", "\[Beta]2"}], "}"}], "]"}]}]}], "}"}], 
   ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ip", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"bra", " ", "@", " ", "ket"}], ")"}], "[", "\"\<Scalar\>\"", 
        "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"AssociationThread", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<\[LeftAngleBracket]\[Phi]|\[Psi]\[RightAngleBracket]\>\"",
          ",", "\n", 
         "    ", "\"\<|\[LeftAngleBracket]\[Phi]|\[Psi]\[RightAngleBracket]|\>\
\"", ",", "\n", 
         "    ", "\"\<|\[LeftAngleBracket]\[Phi]|\[Psi]\[RightAngleBracket]\!\
\(\*SuperscriptBox[\(|\), \(2\)]\)\>\""}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"ip", ",", " ", 
         RowBox[{"Abs", "[", "ip", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"Abs", "[", "ip", "]"}], "^", "2"}]}], "}"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"3cf8a315-de60-41e6-b4d2-2028feaba09a"],

Cell[TextData[{
 "Both give ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Phi]", "TI"], 
     StyleBox["\[Psi]", "TI"]},
    "BraKet"], "=", 
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], "2"], 
   SubsuperscriptBox[
    StyleBox["\[Alpha]", "TI"], "1", "*"], "+", 
   SubscriptBox[
    StyleBox["\[Beta]", "TI"], "2"], 
   SubsuperscriptBox[
    StyleBox["\[Beta]", "TI"], "1", "*"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a5977ef-a8fe-4b7d-9e12-f5638ef108ff"],
 ", with its modulus and its square. The conjugation on the bra is what makes \
this a sesquilinear inner product rather than a plain bilinear dot product."
}], "Text",ExpressionUUID->"2fb4bd77-c9f4-4ad5-bcbb-988099cb8b42"],

Cell[TextData[{
 "1.7 [BSc] How do I write a state both as a column vector of amplitudes and \
as a Dirac superposition ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["i", "TI"]], 
    TemplateBox[{
      StyleBox["i", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2516221b-06ce-4ca1-8e88-6b8ed730d15b"],
 "?"
}], "Subsection",ExpressionUUID->"7d2546dc-b4c2-4705-9230-1d9a9701a460"],

Cell["\<\
The amplitude list and the ket-superposition are two views of one object.\
\>", "Text",ExpressionUUID->"1f887d77-89b8-4000-b6f1-3ba9fc4dcba0"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the amplitude vector is the list itself."
}], "Text",ExpressionUUID->"26439edb-49d6-456a-bd1c-27458ca8bccf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}]], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"a4aead52-96fe-4802-a50d-88a70c583ed4"],

Cell["\<\
The Dirac form is the same numbers against the computational basis; the \
identity confirms the expansion.\
\>", "Text",ExpressionUUID->"0350773c-ef5a-433c-bf32-017d05265954"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], " ", "==", " ", 
  RowBox[{
   RowBox[{"\[Alpha]", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "0"}], "}"}]}], " ", "+", " ", 
   RowBox[{"\[Beta]", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}]}]}]}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"38e6aff8-06d7-4114-bd17-3c9825acdf6b"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the state object, shown first as its summary box."
}], "Text",ExpressionUUID->"6d4dbb32-fac1-4d8c-951b-00a8b2eda9f1"],

Cell[BoxData[
 RowBox[{"qs", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}]}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"8b79f011-6bbd-469b-b041-b876151a2279"],

Cell[TextData[{
 Cell[BoxData["\"\<StateVector\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc0cce3c-25bc-4f5c-90de-07137e8e1791"],
 " reads the amplitudes:"
}], "Text",ExpressionUUID->"519e1740-d8e1-4196-a631-24dbaa182b54"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qs", "[", "\"\<StateVector\>\"", "]"}], " ", "//", " ", 
  "Normal"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"3db642f2-85db-44ef-ab52-ccec574fa81c"],

Cell[TextData[{
 Cell[BoxData["\"\<Formula\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c8bcb64-5104-40e1-be3f-62241f2fe96d"],
 " typesets the same object as the Dirac superposition ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["i", "TI"]], 
    TemplateBox[{
      StyleBox["i", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "195e1491-2398-47e2-8243-9e9e84d0e805"],
 ":"
}], "Text",ExpressionUUID->"c893d836-57eb-4ebf-baee-75e69c82e5a8"],

Cell[BoxData[
 RowBox[{"qs", "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"08bcf18f-9774-45ee-8b95-e190511568b2"],

Cell[TextData[{
 "The amplitude vector and the superposition ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Alpha]", "TI"], 
    TemplateBox[{"0"},
     "Ket"]}], "+", 
   RowBox[{
    StyleBox["\[Beta]", "TI"], 
    TemplateBox[{"1"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bcc9c31c-15e6-4159-9a95-9773be7795ec"],
 " carry identical information; both are representations read from the one \
object whose summary box is shown above."
}], "Text",ExpressionUUID->"15de145c-1951-4ae4-8ddf-407f46477968"],

Cell["\<\
1.8 [BSc] How do I get the Bloch vector of a qubit, and the Bloch-sphere \
angles?\
\>", "Subsection",ExpressionUUID->"727c9e6c-ddf0-4968-9fcf-21d10fcb60f0"],

Cell[TextData[{
 "The Bloch vector ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["\[Sigma]", "TI"], 
      StyleBox["x", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["\[Sigma]", "TI"], 
      StyleBox["y", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["\[Sigma]", "TI"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce0a83c6-43d3-44d8-be6f-076b2cf4309d"],
 " places a pure qubit on the unit sphere, with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Theta]", "TI"], ",", 
    StyleBox["\[Phi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bad978d6-33fc-4801-8310-1a25ec6a9c69"],
 " its spherical angles."
}], "Text",ExpressionUUID->"cd8aa149-eead-454d-8905-03cd8010afa3"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the Bloch vector is, ",
 StyleBox["by definition", "TI"],
 ", the triple of Pauli expectation values ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Bra"], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["j", "TI"]], 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd23c601-6e48-46fd-8360-a01de815e6e3"],
 ". Evaluate that definition for a general ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["\[Alpha]", "TI"]}], ",", 
   RowBox[{
    StyleBox["\[Beta]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ff3e4ba-a258-48c4-919c-cf3b40f767bd"],
 " to get the familiar component formula."
}], "Text",ExpressionUUID->"68b9ad28-4a3e-41d1-a03b-1ce9793b84b9"],

Cell[BoxData[
 RowBox[{"FullSimplify", " ", "@", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], " ", ".", " ", 
     RowBox[{"PauliMatrix", "[", "j", "]"}], " ", ".", " ", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"2520f3be-8a81-43fa-bee4-f6a7b5a853e2"],

Cell["\<\
For the angle-parametrized state the same definition gives the geometric \
vector on the sphere.\
\>", "Text",ExpressionUUID->"9ff58233-ff43-485b-a021-2a3fe329024c"],

Cell[BoxData[
 RowBox[{"rvec", " ", "=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Psi]", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}]}], "}"}], ",", 
    "\n", "  ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", "\[Psi]", "]"}], " ", ".", " ", 
         RowBox[{"PauliMatrix", "[", "j", "]"}], " ", ".", " ", "\[Psi]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", 
       " ", "Reals"}]}], "]"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"90c67008-3d54-406e-897d-e464d6bb5c06"],

Cell["\<\
A built-in coordinate transform turns that Cartesian vector into spherical \
angles.\
\>", "Text",ExpressionUUID->"892c3962-efd9-4b1b-9050-9219511c2746"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"ToSphericalCoordinates", "[", "rvec", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "\[Theta]", " ", "<", " ", "Pi"}], " ", "&&", 
    " ", 
    RowBox[{
     RowBox[{"-", "Pi"}], " ", "<", " ", "\[Phi]", " ", "<", " ", "Pi"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"ccf6609d-1d39-49cd-8489-b8d2813c090f"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the state object, shown as its summary box."
}], "Text",ExpressionUUID->"61a69cb7-1291-485f-b378-e7e9df7e319b"],

Cell[BoxData[
 RowBox[{"qs", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], "]"}]}]], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"6942b9d5-a372-44f8-a032-59a962c8d673"],

Cell[TextData[{
 Cell[BoxData["\"\<BlochVector\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "497443e9-bb57-4e3d-b744-760da7ee7334"],
 " computes the same Pauli expectation values internally (as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], " ", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a310a560-3710-49bf-9547-d1baebe8c024"],
 ")."
}], "Text",ExpressionUUID->"5e494e3f-0082-48cb-afdd-c179137ebbd5"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"qs", "[", "\"\<BlochVector\>\"", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "\[Theta]", " ", "<", " ", "Pi"}], " ", "&&", 
    " ", 
    RowBox[{
     RowBox[{"-", "Pi"}], " ", "<", " ", "\[Phi]", " ", "<", " ", "Pi"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[27]:= ",ExpressionUUID->"e8f5c745-2370-423f-9048-33d12fadefde"],

Cell[TextData[{
 Cell[BoxData["\"\<BlochSphericalCoordinates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21aa32e7-ede0-4a16-ba40-e28921ed6bbb"],
 " gives the polar and azimuthal angles."
}], "Text",ExpressionUUID->"5e64a784-3d27-4329-ba23-82d050d6111b"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"qs", "[", "\"\<BlochSphericalCoordinates\>\"", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "\[Theta]", " ", "<", " ", "Pi"}], " ", "&&", 
    " ", 
    RowBox[{
     RowBox[{"-", "Pi"}], " ", "<", " ", "\[Phi]", " ", "<", " ", "Pi"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"482fdd3a-30cd-433d-b2a9-62d3ef953b26"],

Cell[TextData[{
 "Evaluating the definition returns ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "2", " ", 
     StyleBox["Re",
      FontSlant->"Plain"], " ", 
     SuperscriptBox[
      StyleBox["\[Alpha]", "TI"], "*"], 
     StyleBox["\[Beta]", "TI"]}], ",", " ", 
    RowBox[{"2", " ", 
     StyleBox["Im",
      FontSlant->"Plain"], " ", 
     SuperscriptBox[
      StyleBox["\[Alpha]", "TI"], "*"], 
     StyleBox["\[Beta]", "TI"]}], ",", " ", 
    RowBox[{
     SuperscriptBox[GridBox[{
        {
         StyleBox["\[Alpha]", "TI"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "-", 
     SuperscriptBox[GridBox[{
        {
         StyleBox["\[Beta]", "TI"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab564d1a-79c0-4cf4-8e39-32d5458e6990"],
 " for a general state and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"], 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Phi]", "TI"]}], ",", " ", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Phi]", "TI"]}], ",", " ", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87a5fe82-c331-4b8e-bc4a-0e423d61318a"],
 " for the parametrized one, with spherical coordinates ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    StyleBox["\[Theta]", "TI"], ",", 
    StyleBox["\[Phi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11142677-2e64-428a-a12e-fde765e73613"],
 ". So the component formula is a ",
 StyleBox["result", "TI"],
 " of evaluating the Pauli expectation values, not the definition itself, and \
the parametrization angles are exactly the polar and azimuthal angles on the \
Bloch sphere."
}], "Text",ExpressionUUID->"ec298dc8-5d23-4f85-a5a8-505313a492c5"],

Cell[TextData[{
 "1.9a [BSc] How do I prepare a qudit in the computational basis state ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34a7129d-2249-4b5c-8e08-716903584667"],
 "?"
}], "Subsection",ExpressionUUID->"b295d732-a643-4426-8e5a-bc5528f004c6"],

Cell[TextData[{
 "A qudit lives in ",
 Cell[BoxData[
  SuperscriptBox["\:2102", 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be0f3721-4239-4fef-af89-ee0fdc5402d6"],
 "; its simplest preparation is the computational basis state ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "774fa3f8-c65d-493d-9a91-7b045b9ddb9d"],
 ", the unit vector along the first axis."
}], "Text",ExpressionUUID->"14a0c4ce-5f57-4b49-b670-ef85baf10a3f"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d559c90b-52c3-447e-810e-ca66cf578c34"],
 " is a unit vector in ",
 Cell[BoxData[
  SuperscriptBox["\:2102", 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f6ee7af-0ae7-42fb-86e5-20a4dccee7fb"],
 "."
}], "Text",ExpressionUUID->"c8fbbeb2-9361-47e2-b9c1-aa3d799eb94e"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"UnitVector", "[", 
    RowBox[{"d", ",", " ", "1"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[29]:= ",ExpressionUUID->"286243f9-654f-4c6a-b54f-124f58380fa8"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : name the basis state with its dimension."
}], "Text",ExpressionUUID->"506bbef1-4b05-49fd-b530-02add53d5bdc"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", "3"}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<0\>\"", ",", " ", "d"}], "]"}], "[", "\"\<StateVector\>\"",
      "]"}], " ", "//", " ", "Normal"}]}], "]"}]], "Input",
 CellLabel->
  "In[30]:= ",ExpressionUUID->"d358ed8f-d421-4008-930f-4fbdf928d83e"],

Cell[TextData[{
 "Both give ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0"},
    "Ket"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", "0", ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d3c8ad3-7825-47ff-831d-b8b52160ca23"],
 " in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b3cb156-dcd3-4e66-be3d-8ad0c6f258fe"],
 "; written in ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d07dd7b3-406f-47e1-a4b6-b9ba80f2f542"],
 ", the preparation works for any dimension."
}], "Text",ExpressionUUID->"4398a170-5bf4-45f7-b978-1d76a8eabbc8"],

Cell[TextData[{
 "1.9b [BSc] How do I prepare a uniform superposition ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", 
    SqrtBox[
     StyleBox["d", "TI"]]], 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["k", "TI"],
     LimitsPositioning->False], 
    TemplateBox[{
      StyleBox["k", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bb421d6-12ea-42ef-911a-4f392d93e131"],
 " in ",
 Cell[BoxData[
  SuperscriptBox["\:2102", 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e36c5f3b-48f9-4f8d-933d-f05533c30475"],
 "?"
}], "Subsection",ExpressionUUID->"6629d2fd-4353-494f-baf0-2b3bd98b4c0e"],

Cell[TextData[{
 "The equal-weight superposition ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", 
    SqrtBox[
     StyleBox["d", "TI"]]], 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["k", "TI"],
     LimitsPositioning->False], 
    TemplateBox[{
      StyleBox["k", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dfacf03-450b-4729-a6dd-b0151bf9baa9"],
 " puts the same amplitude on every basis state; it is the flat starting \
state of many algorithms."
}], "Text",ExpressionUUID->"e26010e2-33d1-4ead-bac9-a5c38151fe45"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : a constant vector handed to ",
 Cell[BoxData["Normalize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25277f39-f7ac-42ca-93af-bffdf118da3b"],
 " (no hardcoded ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fd17687-f4b1-4b23-be0c-81bae394409d"],
 ")."
}], "Text",ExpressionUUID->"08e82956-5ee4-4632-959d-4497b1624136"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"Normalize", " ", "@", " ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"1", ",", " ", "d"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[31]:= ",ExpressionUUID->"bb8002e8-a852-4ec0-8888-4eef1695197c"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : use the built-in ",
 Cell[BoxData["\"\<UniformSuperposition\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cd0d672-e771-4fd1-8f53-dfb7ea0ed08d"],
 " state rather than building it by hand."
}], "Text",ExpressionUUID->"8d59e19e-89f6-4ab2-af7b-6572d925bd70"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", "3"}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<UniformSuperposition\>\"", ",", " ", "d"}], "]"}], 
     "[", "\"\<StateVector\>\"", "]"}], " ", "//", " ", "Normal"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[32]:= ",ExpressionUUID->"2f0d7ca3-e5be-49d9-8b01-4897a9697377"],

Cell[TextData[{
 "Both give the uniform qutrit ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", 
    SqrtBox["3"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", "1", ",", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16599891-dd05-4613-bda7-3bc8b2fad6e5"],
 "; written in ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
