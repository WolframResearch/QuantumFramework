(* Beginning of Notebook Content *)
Notebook[{
Cell["Part 9. Single-qubit operations and SU(2)", "Section",ExpressionUUID->"405b76ff-cd37-4c58-906e-903c740ea7e4"],

Cell[TextData[{
 "9.1a [BSc] How do I build the standard named single-qubit gates ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], ",", 
   StyleBox["Y", "TI"], ",", 
   StyleBox["Z", "TI"], ",", 
   StyleBox["H", "TI"], ",", 
   StyleBox["S", "TI"], ",", 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1140f7b6-8cb1-437f-9601-fe947e7af178"],
 "?"
}], "Subsection",ExpressionUUID->"ab549ab0-a1e4-4aa1-80a9-ae88c03dc6e8"],

Cell[TextData[{
 "The named single-qubit gates are the workhorses of quantum computing: the \
three Paulis ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], ",", 
   StyleBox["Y", "TI"], ",", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11f9da77-5755-4f06-b086-9db7ffa66e30"],
 ", the Hadamard ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   FractionBox["1", 
    SqrtBox["2"]], "(", GridBox[{
     {"1", "1"},
     {"1", 
      RowBox[{"-", "1"}]}
    }], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68d33bd6-1772-443c-880b-0ce53c6d46bd"],
 ", and the phase gates ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    StyleBox["i", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b542c3c-795f-42c2-9da7-ebf44d90cf01"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "\[Pi]", "/", "4"}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2833550-7dae-4570-8cbd-642cad3f57ad"],
 " (with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], "=", 
   SuperscriptBox[
    StyleBox["T", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3fc404c-14ad-4784-b54d-b76e54d937c2"],
 ")."
}], "Text",ExpressionUUID->"ef461bc9-7b6a-47ec-a20e-693c2e75f433"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : each is a small explicit matrix (the Paulis from ",
 Cell[BoxData["PauliMatrix"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf680ffc-3134-4ee0-ade5-208cf824395e"],
 ", the Hadamard from ",
 Cell[BoxData["HadamardMatrix"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6a3437e-534c-4900-88e6-3bfc2de823d6"],
 ", the phase gates diagonal)."
}], "Text",ExpressionUUID->"4a29b840-328a-4b4b-bd45-30e7ac10ed81"],

Cell[BoxData[
 RowBox[{"MatrixForm", " ", "/@", " ", 
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<X\>\"", " ", "->", " ", 
     RowBox[{"PauliMatrix", "[", "1", "]"}]}], ",", " ", 
    RowBox[{"\"\<Y\>\"", " ", "->", " ", 
     RowBox[{"PauliMatrix", "[", "2", "]"}]}], ",", " ", 
    RowBox[{"\"\<Z\>\"", " ", "->", " ", 
     RowBox[{"PauliMatrix", "[", "3", "]"}]}], ",", " ", 
    RowBox[{"\"\<H\>\"", " ", "->", " ", 
     RowBox[{"HadamardMatrix", "[", "2", "]"}]}], ",", " ", 
    RowBox[{"\"\<S\>\"", " ", "->", " ", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "I"}], "}"}], "]"}]}], ",", " ", 
    RowBox[{"\"\<T\>\"", " ", "->", " ", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"Pi", "/", "4"}]}], "]"}]}], "}"}], "]"}]}]}], 
   "|>"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e779dd1c-038d-43f5-8837-06f6a63bbbe3"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : each is a named ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0d1f0c8-ab8a-49df-8b04-3eca19b41d2f"],
 "; here their matrices, read off the objects."
}], "Text",ExpressionUUID->"f0e87894-04a2-417e-8fa4-ffe1fb49fe23"],

Cell[BoxData[
 RowBox[{"AssociationMap", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"MatrixForm", "[", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", "#", "]"}], "[", "\"\<Matrix\>\"", 
      "]"}], "]"}], " ", "&"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\"", ",", 
     " ", "\"\<H\>\"", ",", " ", "\"\<S\>\"", ",", " ", "\"\<T\>\""}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e8eb0ca7-2149-4145-8a86-495a39456d61"],

Cell[TextData[{
 "Both give the same six matrices. The QF names carry more than a matrix: \
each ",
 Cell[BoxData[
  RowBox[{"QuantumOperator", "[", "\"\<H\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05b298ef-c533-4081-84e4-a66eb6067c92"],
 " knows its arity, its qubit order, that it is unitary and Hermitian (for \
the Paulis and ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "397ce1f1-7340-4bed-94f7-1c906863b4b7"],
 "), and composes with the others by ",
 Cell[BoxData["@"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6862909-b3d3-4d39-88af-c2dc67f06125"],
 ", so the named gate is a reusable building block, not a frozen array."
}], "Text",ExpressionUUID->"d96be02c-1e6f-4a9f-afd1-fe1c0f3bb4ee"],

Cell[TextData[{
 "9.1b [BSc] How do I build the axis-angle rotation gates ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    OverscriptBox[
     StyleBox["n", "TI"], "^"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Theta]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Theta]", "TI"], " ", 
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "\[CenterDot]", 
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "/", "2"}]]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0df841e3-af1c-4670-83b7-765055363be4"],
 "?"
}], "Subsection",ExpressionUUID->"4b94a20d-8581-4c09-b9d5-a10a5737d694"],

Cell[TextData[{
 "A rotation gate turns the qubit by angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea4738c5-fe54-4edd-b7e7-2eb8a11cdbab"],
 " about a Bloch axis ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8cbcbf-2d50-4918-aef7-f6f88a131910"],
 ": ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    OverscriptBox[
     StyleBox["n", "TI"], "^"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Theta]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Theta]", "TI"], " ", 
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "\[CenterDot]", 
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "/", "2"}]]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be0f8207-6ab9-49ba-a6c1-c3aceb938ad5"],
 ". The three coordinate rotations are ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["x", "TI"]], ",", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["y", "TI"]], ",", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48553506-fa67-4a7c-aed7-85d59ec613c0"],
 "; here is the general one and the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["R", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c3a0bc5-f5f9-4d92-90c6-a38697318937"],
 " special case."
}], "Text",ExpressionUUID->"7b520e1c-415d-46cf-aacc-b9758acf3019"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the matrix exponential of ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   FractionBox[
    StyleBox["\[Theta]", "TI"], "2"], " ", 
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "caedaa63-da5c-4b81-8716-2656f84aafa4"],
 " for a general unit axis ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "088dc976-eb56-4de1-a028-98a5a30b781c"],
 " from its spherical angles."
}], "Text",ExpressionUUID->"b37ffdbc-3414-4911-9f70-d856cd04aec3"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"FromSphericalCoordinates", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "\[Alpha]", ",", " ", "\[Beta]"}], "}"}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"MatrixExp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{"(", 
        RowBox[{"\[Theta]", "/", "2"}], ")"}], " ", 
       RowBox[{"n", " ", ".", " ", 
        RowBox[{"PauliMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
      "]"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", " ", "\[Beta]", ",", " ", "\[Theta]"}], "}"}],
       " ", "\[Element]", " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"95bb962f-f07b-4704-ac11-6166b4358027"],

Cell[TextData[{
 "Sending the polar angle to zero points the axis along ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["z", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dac7756-f2bf-4f20-a80b-a3906df22ebc"],
 ", so for ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["R", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9e46e8b-dbca-49d9-b122-4d2a059a3fc1"],
 " we get the substitution below. It is made in the resulting matrix rather \
than in the axis, since at the pole the azimuth ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef0de8dc-b478-4b06-9fd6-23067753e40e"],
 " is degenerate and ",
 Cell[BoxData["FromSphericalCoordinates"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e8e3840-32e1-46d3-9282-56d6825a4983"],
 " rejects it there."
}], "Text",ExpressionUUID->"391914fd-62bf-4126-8486-1224b020969a"],

Cell[BoxData[
 RowBox[{"%", " ", "/.", " ", 
  RowBox[{"{", 
   RowBox[{"\[Alpha]", " ", "->", " ", "0"}], "}"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"faea01c6-4b26-49ae-9031-2ab1c6a483fe"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the named rotation gates ",
 Cell[BoxData["\"\<RX\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad498b42-00e3-4d2d-9372-6017e4744d80"],
 ", ",
 Cell[BoxData["\"\<RY\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fabb2062-4623-4a4b-aca4-e76ef94c7627"],
 ", ",
 Cell[BoxData["\"\<RZ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e9b2f7d-4bc8-467b-90de-147550ea8465"],
 " (call-form with the angle); here ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Theta]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72f6b5d7-14bd-456a-a5a7-cd190bfbde2f"],
 "."
}], "Text",ExpressionUUID->"7e805529-5a49-4e05-8912-f48adb703a22"],

Cell[BoxData[
 RowBox[{"QuantumOperator", "[", 
  RowBox[{"\"\<RZ\>\"", "[", "\[Theta]", "]"}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"ce5e8b5d-def2-4965-a65c-90654ef63260"],

Cell["\<\
The object prints as itself; its matrix is the same diagonal the WL side \
arrived at.\
\>", "Text",ExpressionUUID->"e5349336-cb20-4859-8d11-543ed1ca76f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"%", "[", "\"\<Matrix\>\"", "]"}], " ", "//", " ", 
  "MatrixForm"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"47b2ebac-b524-4a28-82c9-b99b46b16e92"],

Cell[TextData[{
 "Both produce a unit-determinant unitary that rotates the Bloch sphere by ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cbcfb2be-e680-4a9d-8193-7eb45acc66f6"],
 " about ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9bed6e77-1317-4a92-a811-40f85ca9018a"],
 "; for ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "=", 
   OverscriptBox[
    StyleBox["z", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c0c4a2b-3a69-4fcd-8f7f-84ceac232a08"],
 " it is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Theta]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[Theta]", "TI"], "/", "2"}]], ",", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"+", 
      StyleBox["i", "TI"], 
      StyleBox["\[Theta]", "TI"], "/", "2"}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "840771c3-3fd4-45ac-9d9c-9eee54cc5cc6"],
 ". The QF object also carries the angle as a parameter it can substitute or \
compose."
}], "Text",ExpressionUUID->"2fd88db6-5695-4b00-925a-6f1b4a8f8675"],

Cell[TextData[{
 "9.2 [BSc] How do I derive the closed-form axis-angle exponential ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Alpha]", "TI"], " ", 
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "\[CenterDot]", 
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "/", "2"}]], "=", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["I", "TI"], "-", 
   StyleBox["i", "TI"], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a34c9c42-e97c-42c3-8cf1-5c9645336a7a"],
 "?"
}], "Subsection",ExpressionUUID->"6e80705c-f935-4e9e-9c26-f8ff4fd054e6"],

Cell[TextData[{
 "Because ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["n", "TI"], "^"], "\[CenterDot]", 
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "856705a4-0adc-4c2c-a61d-86554af7045c"],
 " for a unit ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29603607-ce25-47cc-9692-8f62370f2541"],
 ", the exponential series splits into even and odd terms and closes in a \
single line: ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Alpha]", "TI"], " ", 
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "\[CenterDot]", 
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "/", "2"}]], "=", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["\[Alpha]", "TI"], "2"], " ", 
   StyleBox["I", "TI"], "-", 
   StyleBox["i", "TI"], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["\[Alpha]", "TI"], "2"], " ", 
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1309ab73-9d6e-46a1-b39f-b7e59f93317a"],
 ". Verify this identity for a general axis and angle."
}], "Text",ExpressionUUID->"21dafad6-8f5a-4abc-8c71-b07cafce1409"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : compare the matrix exponential with the proposed closed form; the \
difference should vanish."
}], "Text",ExpressionUUID->"f97a4549-6417-4df1-b4bc-9c195bacaabd"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"FromSphericalCoordinates", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], "}"}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{"(", 
         RowBox[{"\[Alpha]", "/", "2"}], ")"}], " ", 
        RowBox[{"n", " ", ".", " ", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
       "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[Alpha]", "/", "2"}], "]"}], " ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}], " ", "-", " ", 
       RowBox[{"I", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Alpha]", "/", "2"}], "]"}], " ", 
        RowBox[{"n", " ", ".", " ", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}]}]}], 
     ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", " ", "\[Phi]", ",", " ", "\[Alpha]"}], "}"}], 
      " ", "\[Element]", " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"366b1472-fb3c-42f4-a1e5-76f2fe427e36"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same rotation built as a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7453b347-58fc-4186-bd26-b14ba30959d7"],
 " from the axis, whose matrix equals the closed form."
}], "Text",ExpressionUUID->"42ce5931-0515-4f60-a349-c54358e0f593"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"FromSphericalCoordinates", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], "}"}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{
         RowBox[{"-", "I"}], " ", 
         RowBox[{"(", 
          RowBox[{"\[Alpha]", "/", "2"}], ")"}], " ", 
         RowBox[{"n", " ", ".", " ", 
          RowBox[{"PauliMatrix", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
        "]"}], "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[Alpha]", "/", "2"}], "]"}], " ", 
        RowBox[{"QuantumOperator", "[", "\"\<I\>\"", "]"}]}], " ", "-", " ", 
       RowBox[{"I", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Alpha]", "/", "2"}], "]"}], " ", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"n", " ", ".", " ", 
          RowBox[{"PauliMatrix", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], 
         "]"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", " ", "\[Phi]", ",", " ", "\[Alpha]"}], "}"}], 
      " ", "\[Element]", " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"20ddc28c-8811-46de-b4d9-dd63f3d75a64"],

Cell[TextData[{
 "Both return True: the entire one-parameter rotation is captured by two \
scalars, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["\[Alpha]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12a38b62-9899-4a4e-8cad-2461ab3ffac4"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["\[Alpha]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec7728ad-574a-4454-8824-d05a65431ed1"],
 ", because the generator squares to the identity. This is the single most \
useful identity for single-qubit gates, and it makes ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    OverscriptBox[
     StyleBox["n", "TI"], "^"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", "\[Pi]"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a5a44a0-df05-4088-8808-ae94e3fe121e"],
 " manifest (9.5)."
}], "Text",ExpressionUUID->"cf4aedc9-9b5b-4977-8d37-4caa52352946"],

Cell["\<\
9.3 [BSc] How do I verify the unitarity and unit-determinant conditions that \
define SU(2)?\
\>", "Subsection",ExpressionUUID->"a6810f83-6014-403c-907c-a1b4ae7a7358"],

Cell[TextData[{
 "The single-qubit rotations form the group ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63116505-e105-44c2-85df-6d4e63856c76"],
 ": unitary (",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"], 
   StyleBox["U", "TI"], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6107178e-88e3-4af6-899f-17994f9d0f5e"],
 ", preserving probability) and unit determinant (",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["U", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5164ff78-f021-4d1f-ae6c-63e0d9568351"],
 ", distinguishing ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "846f19e0-5488-4a55-8c49-b63a38159406"],
 " from the larger ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02777366-0047-40b0-a586-b818c15e3d75"],
 "). Check both for a general rotation ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    OverscriptBox[
     StyleBox["n", "TI"], "^"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Theta]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cffdd975-442c-49d0-8e75-490749ec5df5"],
 "."
}], "Text",ExpressionUUID->"d7265a18-994e-4962-9f5e-61f35a2d9f05"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : test ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"], 
   StyleBox["U", "TI"], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6db3a03-c9be-44fd-b488-53753b2980df"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["U", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39239915-f6d1-4286-834e-b72a53aba1bb"],
 " on the general axis-angle matrix."
}], "Text",ExpressionUUID->"6ee7e436-7081-49ea-8961-4030506c8ee7"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"FromSphericalCoordinates", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "\[Alpha]", ",", " ", "\[Beta]"}], "}"}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"\[Theta]", "/", "2"}], "]"}], " ", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}], " ", "-", " ", 
        RowBox[{"I", " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]", "/", "2"}], "]"}], " ", 
         RowBox[{"n", " ", ".", " ", 
          RowBox[{"PauliMatrix", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}]}]}],
       "}"}], ",", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"u", " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], " ", "==", " ", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"Det", "[", "u", "]"}], " ", "==", " ", "1"}]}], "}"}], ",",
        " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Alpha]", ",", " ", "\[Beta]", ",", " ", "\[Theta]"}], 
         "}"}], " ", "\[Element]", " ", "Reals"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"4b1be255-ef83-4283-9464-9e71f7cded29"],

Cell[TextData[{
 StyleBox["WL (numerical)",
  FontWeight->"Bold"],
 " : the same two conditions on a random ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9969369d-9bd2-4472-ac59-fd589740861e"],
 " element, drawn as a Haar-random ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e1c3b66-7a59-4131-8462-ede4c730c225"],
 " matrix and rescaled by ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    RowBox[{
     StyleBox["det",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["U", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "945e010d-59c1-4b81-8089-51a66fee981b"],
 " so its determinant becomes ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd5552a1-3fe3-4896-8ded-c61fa3b840d3"],
 "."
}], "Text",ExpressionUUID->"8e4060e3-33b0-49ff-a939-2ef7532c6637"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"su", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", " ", "=", " ", 
       RowBox[{"RandomVariate", "@", 
        RowBox[{"CircularUnitaryMatrixDistribution", "[", "2", "]"}]}]}], 
      "}"}], ",", " ", 
     RowBox[{"u", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Det", "[", "u", "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"UnitaryMatrixQ", "[", "su", "]"}], "\n", 
 RowBox[{
  RowBox[{"Chop", "@", 
   RowBox[{"Det", "[", "su", "]"}]}], " ", "==", " ", "1"}]}], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"57aa5fdf-2178-4d2b-a442-b33eb007ec13"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : compose the operator with its own ",
 Cell[BoxData["\"\<Dagger\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cb6434e-236f-44fb-a125-dff71e9f802a"],
 " and simplify that product to the identity, then take the determinant of \
its matrix. The ",
 Cell[BoxData["\"\<UnitaryQ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe261541-c88e-4474-af48-d18fbaab9486"],
 " property is no help with a symbolic angle: having no way to know ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a345615-e708-4d14-b67f-63abfd800ff1"],
 " is real, it answers ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1940e0b0-b2fe-4b3b-bfa7-257bbddad5a1"],
 " rather than complaining, so the reality assumption has to be supplied \
explicitly to ",
 Cell[BoxData["FullSimplify"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27257a38-d194-4b5d-8dba-3d52106bd27f"],
 " instead."
}], "Text",ExpressionUUID->"62fa9de5-26b7-425d-a4d0-831908e9744f"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"u", " ", "=", " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<RZ\>\"", "[", "\[Theta]", "]"}], "]"}]}], "}"}], ",", " ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"u", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", "u"}], 
           ")"}], "[", "\"\<Matrix\>\"", "]"}], "]"}], " ", "==", " ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", " ", 
       RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}]}], "]"}], ",", 
     " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Det", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{"u", "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}], " ", "==", 
       " ", "1"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"2fb1e230-e619-482d-98a5-ee3cb9ec3876"],

Cell[TextData[{
 "Both confirm ",
 Cell[BoxData["{"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "482833a3-fb39-4597-b54e-3fc8f4c90f29"],
 "unitary, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "=", "1", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "754e04b6-a07e-4fab-90be-90d5ed4c9181"],
 ": the unit determinant follows because the generator ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "732c24c5-905a-4daf-86ec-861ef688e957"],
 " is traceless, so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Theta]", "TI"], " ", 
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "\[CenterDot]", 
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "/", "2"}]], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Theta]", "TI"], " ", 
     StyleBox["Tr",
      FontSlant->"Plain"], 
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["n", "TI"], "^"], "\[CenterDot]", 
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], 
     StyleBox["]",
      SpanMaxSize->1], "/", "2"}]], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], "0"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca5d13f4-ad49-4558-931c-1c87ff8cad77"],
 ". Every single-qubit rotation lives in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bcfdba0b-c4a7-4cff-b535-0cb804caddb0"],
 "."
}], "Text",ExpressionUUID->"e09df562-7d8e-4c1c-ba42-f96c9aaea0a5"],

Cell[TextData[{
 "9.4 [BSc] How do I decompose an arbitrary single-qubit unitary into Euler (",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d314d758-18dc-44a0-8cea-0b505044d1c8"],
 "-",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e93466e-8f3d-4124-bd46-370c2644539c"],
 "-",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "592e11ae-b548-4594-9f67-e1eadf0ff39e"],
 ") angles?"
}], "Subsection",ExpressionUUID->"50ca43f5-3daf-4c52-91f6-16d119e9e09a"],

Cell[TextData[{
 "Any single-qubit unitary factors into three rotations about alternating \
axes, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "\[Phi]"}], "TI"]], " ", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Alpha]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["y", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Beta]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8388263a-96e8-41ea-b103-583a5f34bebe"],
 " (the ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26ad1396-220e-4ca9-be86-ff39c5bb3e5d"],
 "-",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a905cacb-c819-4572-8a61-e62b2e563237"],
 "-",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce18a57a-88d4-448c-ac85-566694d79689"],
 " Euler decomposition), so three real angles plus a global phase ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4a8a88f-9717-48a4-9aac-aa1dc462d74e"],
 " parametrize all of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9873e47f-0af7-4283-b406-a8d162b1f847"],
 ". The triple ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["\[Alpha]", "TI"]}], ",", 
   StyleBox["\[Beta]", "TI"], ",", 
   RowBox[{
    StyleBox["\[Gamma]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f189dc96-a63d-4ef7-962d-3ef80f7ad52f"],
 " is exactly the set of Euler angles of the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "3", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b6a477f-7b4c-47d0-9aee-6a9d82aa50be"],
 " rotation that ",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94c53004-b92c-48e3-84da-0c0f82b6d9c8"],
 " performs on the Bloch sphere, so it can be read either from that geometric \
rotation or straight from the operator. Take a random ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d53d272f-8d6e-4bb1-9b75-b85815e2e994"],
 " element and extract its ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e3c82f0-d309-47d8-ab47-f92f6b295164"],
 "-",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4590a4d7-49c7-42de-8674-5c44a210811c"],
 "-",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fbf9fc6-ad9c-4d46-90b6-6c4c330ed3be"],
 " angles both ways."
}], "Text",ExpressionUUID->"9bb221bc-5f24-45e5-a046-4a4f2d91ee26"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : send the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bc8a628-99c9-43c9-a404-4e37bd326ad7"],
 " matrix to its ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "3", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a09c781-d5fa-46b6-a060-009b6cc4c56f"],
 " Bloch rotation ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], "=", 
   FractionBox["1", "2"], 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["i", "TI"]], " ", 
    StyleBox["U", "TI"], " ", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["j", "TI"]], " ", 
    SuperscriptBox[
     StyleBox["U", "TI"], "\[Dagger]"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5f7dcb5-bd08-41dd-ae70-a33d5d0eadaa"],
 ", then read that rotation's Euler angles with the built-in ",
 Cell[BoxData["EulerAngles"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "397d3e04-4d60-4211-acda-ca3f48fe0d36"],
 ", whose default axis order is ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca44a768-f0a2-4f02-a6ad-e817d060a4fa"],
 "-",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b777a175-5ffe-44a9-8127-756bb1c3e6b4"],
 "-",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e82e2e8c-2723-465f-a98b-4e4a33f4796c"],
 ". The built-in reports the two outer angles in ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{"-", "\[Pi]"}], ",", "\[Pi]", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84cfe170-16b9-4e7b-aea5-a907b528b082"],
 ", so ",
 Cell[BoxData["Mod"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb49703-f19a-4ae6-9d83-f96d6563fb79"],
 " by ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d66bd09d-a996-4e2b-b2a7-66f8f7000c6a"],
 " brings them into ",
 Cell[BoxData[
  RowBox[{"[", "0", ",", 
   RowBox[{"2", "\[Pi]"}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6ed8fa4-7787-4159-b476-3b4fc586399d"],
 "."
}], "Text",ExpressionUUID->"dfdeb3fe-c92c-457f-914e-68427b8e27e6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"su2so3", "[", "u_", "]"}], " ", ":=", " ", 
   RowBox[{"Chop", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "i", "]"}], " ", ".", " ", "u", " ", ".",
          " ", 
         RowBox[{"PauliMatrix", "[", "j", "]"}], " ", ".", " ", 
         RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], "]"}], "/", "2"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"su2", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", " ", "=", " ", 
       RowBox[{"RandomVariate", "@", 
        RowBox[{"CircularUnitaryMatrixDistribution", "[", "2", "]"}]}]}], 
      "}"}], ",", " ", 
     RowBox[{"u", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Det", "[", "u", "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Mod", "[", 
  RowBox[{
   RowBox[{"EulerAngles", "@", 
    RowBox[{"Chop", "@", 
     RowBox[{"su2so3", "[", "su2", "]"}]}]}], ",", " ", 
   RowBox[{"2", " ", "Pi"}]}], "]"}]}], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"294e0863-7414-473c-8d47-a4b3646ff4d8"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a65bfb50-cba3-4b5a-ab84-9ea208dad798"],
 " answers ",
 Cell[BoxData["\"\<EulerAngles\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bf6ffb2-9b2a-4076-8d32-5830687dae24"],
 " about itself directly, in the same ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f0caebf-eea5-4cce-9669-73fccd82b2cd"],
 "-",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a7db26f-1c33-4964-9e9d-705b704ec5a4"],
 "-",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05444997-1cb0-49d5-b370-09e822851d9d"],
 " convention, but reports the two outer angles already in ",
 Cell[BoxData[
  RowBox[{"[", "0", ",", 
   RowBox[{"2", "\[Pi]"}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "134d1de1-ff79-4975-8a51-43bfd350a5b3"],
 "."
}], "Text",ExpressionUUID->"f6b10a49-8883-4704-ac72-480499d9ec9a"],

Cell[BoxData[
 RowBox[{"Mod", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumOperator", "[", "su2", "]"}], "[", "\"\<EulerAngles\>\"", 
    "]"}], ",", " ", 
   RowBox[{"2", " ", "Pi"}]}], "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"c417db15-2ee0-4ccc-8bed-9cc8c8243203"],

Cell[TextData[{
 "Both routes return the same triple ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["\[Alpha]", "TI"]}], ",", 
   StyleBox["\[Beta]", "TI"], ",", 
   RowBox[{
    StyleBox["\[Gamma]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec8393fc-c61a-4701-9131-ad2c89503494"],
 " for the same random ",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3a53161-5367-4547-a4af-8b459176b0cd"],
 ", with the middle angle ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], "\[Element]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65c0ce8c-a067-48dc-a8bc-c7c2eea46242"],
 " either way. The only difference is bookkeeping of the two outer angles: \
the built-in ",
 Cell[BoxData["EulerAngles"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "628de82d-544a-4f11-a642-f2259aaae1ba"],
 " reports them in ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{"-", "\[Pi]"}], ",", "\[Pi]", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a0ef9c5-f08f-4af5-bef7-af36b4c91d03"],
 " while QF reports them in ",
 Cell[BoxData[
  RowBox[{"[", "0", ",", 
   RowBox[{"2", "\[Pi]"}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f8c4864-ba93-49d4-b791-6c50d21b2fb8"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Mod",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"\[CenterDot]", ",", 
    RowBox[{"2", "\[Pi]"}]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b02e8115-8b4c-4566-8438-40dae803cefe"],
 " folds both into the common window ",
 Cell[BoxData[
  RowBox[{"[", "0", ",", 
   RowBox[{"2", "\[Pi]"}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c0a4452-e00a-443e-9c4e-a012690f2b4d"],
 ", where they coincide to machine precision. The agreement makes the double \
cover concrete: the three angles of the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0bfcc36-8bcc-4624-aa65-2731487c2a92"],
 " operator are precisely the three Euler angles of the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "3", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1553720-12f1-4786-b161-7e628d486652"],
 " rotation it induces, so every one-qubit gate is three turns about the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7770a29b-b3b3-4225-8106-5af5d1f14244"],
 " and ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce8d9aac-4a8b-48a7-94c8-f347dad61e54"],
 " axes, the fact that makes an arbitrary single-qubit gate implementable \
from just ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["R", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73b01f70-2f86-462b-a291-933ee48f2431"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["R", "TI"], 
   StyleBox["y", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9463d034-1e6d-4e98-8b14-d69188dd516a"],
 " hardware."
}], "Text",ExpressionUUID->"5a65a8fe-7e31-4668-8da6-137f0d6d684f"],

Cell[TextData[{
 "9.5 [MSc] How do I show that SU(2) double-covers SO(3) and that a ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62015afb-5bc0-4ad0-97e7-5e1440828499"],
 " rotation is not the identity?"
}], "Subsection",ExpressionUUID->"479f5086-84ee-4ac8-b278-f35e324b5dab"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2403c6ad-80bf-46e8-ad97-2a7e538aea79"],
 " is a ",
 StyleBox["double", "TI"],
 " cover of the rotation group ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "3", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0b6cda4-51fe-4bc8-8d9f-a229c620f0e1"],
 ": the map sending a qubit rotation ",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc6de477-6ffc-4319-98da-eb3a5d09e1b7"],
 " to the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "3", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "599d30a4-5bdd-46f0-b120-b6459afbac11"],
 " rotation of its Bloch vector, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], "=", 
   FractionBox["1", "2"], 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["i", "TI"]], " ", 
    StyleBox["U", "TI"], " ", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["j", "TI"]], " ", 
    SuperscriptBox[
     StyleBox["U", "TI"], "\[Dagger]"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88da12ee-0ca4-4b41-bab9-bd7245a77a4d"],
 ", is two-to-one, because ",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3750c705-f4b2-49e0-8cf3-39448686e3d1"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["U", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57d82b55-20fa-42b5-baf3-d68e4b9b1015"],
 " give the same ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fda47864-debb-4830-9690-d68209a96024"],
 ". The signature is that a full ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77903e92-40d9-4985-b9ef-b24593fe84a2"],
 " qubit rotation is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    OverscriptBox[
     StyleBox["n", "TI"], "^"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", "\[Pi]"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6416256b-0bcd-44e9-ad16-1ed7b2daed24"],
 ", not the identity; only ",
 Cell[BoxData[
  RowBox[{"4", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85a1235e-3e15-4ca7-b75d-4fdad5c35fa3"],
 " returns to ",
 Cell[BoxData[
  StyleBox["I", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1efbe0c2-05be-441f-aee3-256adf6600dd"],
 "."
}], "Text",ExpressionUUID->"09ef0d41-9696-4303-9e74-e95d8370eff2"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the covering map itself, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], "\[Function]", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], "=", 
   FractionBox["1", "2"], 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["i", "TI"]], " ", 
    StyleBox["U", "TI"], " ", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["j", "TI"]], " ", 
    SuperscriptBox[
     StyleBox["U", "TI"], "\[Dagger]"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fac6317-da8b-49ae-b59a-e82412b3beb5"],
 ", which reads off the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "3", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a43ea3d-ed92-475a-b66d-7b2224930b96"],
 " rotation a qubit gate performs on the Bloch vector."
}], "Text",ExpressionUUID->"ee0d2c94-13fb-42e4-9eb1-c6877b455228"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"su2so3", "[", "u_", "]"}], " ", ":=", " ", 
   RowBox[{"Chop", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "i", "]"}], " ", ".", " ", "u", " ", ".",
          " ", 
         RowBox[{"PauliMatrix", "[", "j", "]"}], " ", ".", " ", 
         RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], "]"}], "/", "2"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"473f889b-a638-4a42-8792-07aec5669c93"],

Cell["\<\
A random unit vector for the rotation axis, so nothing below is an accident \
of a privileged direction.\
\>", "Text",ExpressionUUID->"03750b8c-27ff-4eb6-b70b-e06e1fc83be1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"n", " ", "=", " ", 
   RowBox[{"RandomPoint", "@", 
    RowBox[{"Sphere", "[", "]"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"8d894022-cafa-45b4-9ad0-8739409eb81d"],

Cell[TextData[{
 "Turning about that axis: a full ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "131bc163-52d3-4bae-9ff8-112c3fe5b5f2"],
 " rotation returns ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9a5128d-8e6f-4a86-9d0d-11d633ddb67f"],
 " rather than the identity, and only the double turn ",
 Cell[BoxData[
  RowBox[{"4", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9500c603-daa5-4a55-aaaa-853a72828a88"],
 " brings the qubit back to ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a6b82c6-f6df-4fc3-9d4e-0638864b0582"],
 "."
}], "Text",ExpressionUUID->"4a9613b8-dc14-463e-ad3b-61fcca5eccf0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"MatrixExp", "[", 
   RowBox[{
    RowBox[{"-", "I"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", " ", "\[Pi]"}], ")"}], "/", "2"}], " ", 
    RowBox[{"n", " ", ".", " ", 
     RowBox[{"PauliMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], "]"}], 
  " ", "//", " ", "Chop"}], "\n", 
 RowBox[{
  RowBox[{"MatrixExp", "[", 
   RowBox[{
    RowBox[{"-", "I"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"4", " ", "\[Pi]"}], ")"}], "/", "2"}], " ", 
    RowBox[{"n", " ", ".", " ", 
     RowBox[{"PauliMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], "]"}], 
  " ", "//", " ", "Chop"}]}], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"6cd110f6-63d9-4e6b-89c3-7e4b266ad938"],

Cell[TextData[{
 "On the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "3", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9ab617c-2339-4470-a684-fece785218f7"],
 " side the sign is gone: ",
 Cell[BoxData["su2so3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d81bf7a4-aa1a-4b13-85b8-317137cb2f05"],
 " sends the axis operator ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96d40d79-eafb-4b88-8f3c-78c68447ba88"],
 " to its real Bloch-space rotation (eigenvalues ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70c67df8-0ce8-4481-8f38-9c230a26a6b0"],
 "), and exponentiating that rotation over a full ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "950f9e97-5470-4d08-b8c1-b23433912b04"],
 " collapses to the ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31c9279f-5e50-48c8-a39a-35f53e79f90e"],
 " identity."
}], "Text",ExpressionUUID->"ab6fe1b8-cead-4b52-9b37-89cdb2f7ed33"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MatrixExp", "[", 
   RowBox[{
    RowBox[{"-", "I"}], " ", "2", " ", "\[Pi]", " ", 
    RowBox[{"su2so3", "[", 
     RowBox[{"n", " ", ".", " ", 
      RowBox[{"PauliMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], "]"}]}], 
   "]"}], " ", "//", " ", "Chop"}]], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"e696744d-f70e-4064-8267-d1e0415bb9c2"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same, with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", "\[Pi]"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18eb0a65-1113-4f34-a739-138ae236444f"],
 " a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7336796f-cad2-45ee-bdce-3acf8ccdc556"],
 "; its matrix is ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3057b994-cfac-4bf3-843c-16fb27c8f90a"],
 " while its adjoint action on the Paulis is the identity rotation."
}], "Text",ExpressionUUID->"9cdeb93b-b052-4564-9656-89d6f1ba8a37"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"u", " ", "=", " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<RZ\>\"", "[", 
       RowBox[{"2", " ", "Pi"}], "]"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{"u", "[", "\"\<Matrix\>\"", "]"}], "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"PauliMatrix", "[", "i", "]"}], " ", ".", " ", 
          RowBox[{"Normal", "[", 
           RowBox[{"u", "[", "\"\<Matrix\>\"", "]"}], "]"}], " ", ".", " ", 
          RowBox[{"PauliMatrix", "[", "j", "]"}], " ", ".", " ", 
          RowBox[{"ConjugateTranspose", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{"u", "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}]}], "]"}], 
        "/", "2"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"82a4ab32-4f1d-4ac3-8c11-049656007bee"],

Cell[TextData[{
 "Both routes make the same point: a ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dac09844-0724-43aa-8395-226629aac29c"],
 " rotation equals ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7718cb9b-dd06-4b5e-a6a6-416d5db84438"],
 " (a global sign, physically a state ",
 Cell[BoxData[
  RowBox[{"\[Rule]", "-"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ad5c40c-b63e-4960-9bef-77615ff7793b"],
 "state) while the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "3", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fade47be-436f-4f19-a08d-e1cf6b00b959"],
 " rotation it induces on the Bloch vector is the identity, the same ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "3", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41b5daaa-0ddb-46de-90a8-167e21c7c575"],
 " element that ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94b972f6-cf11-483b-8aaf-3666d8c604dc"],
 " induces, and only a ",
 Cell[BoxData[
  RowBox[{"4", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "752e54dd-78c1-4d94-a97c-8dbd643b692e"],
 " turn brings the qubit itself back to ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc7a7c64-8cc6-4153-94e3-9cd9080246b2"],
 ". Two distinct ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2a9179b-84e3-4019-abad-dd471e286bf5"],
 " elements ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23764482-ec26-4026-85f9-fc4e5be4073d"],
 " sit above one ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "3", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de28f847-6f07-4eb0-a117-391d659591d1"],
 " rotation. The unobservable ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f03a12e-2561-44e5-b091-5e32937b04be"],
 " sign is real: it shows up in interference between a rotated and an \
unrotated path (the neutron ",
 Cell[BoxData[
  RowBox[{"4", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3146dd6-35b0-4174-8809-e191b8c59d38"],
 " symmetry)."
}], "Text",ExpressionUUID->"a408014f-4f8e-4a57-af34-e45a19eb6b47"],

Cell[TextData[{
 "9.6 [MSc] How do I realize a single-qubit unitary to within a target error ",
 Cell[BoxData[
  StyleBox["\[CurlyEpsilon]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d78fa46-064c-420b-a17b-5d34be5846cb"],
 " as a sequence of ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["H", "TI"]}], ",", 
   RowBox[{
    StyleBox["T", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "427a02b0-e926-44bf-bba0-4c651907816c"],
 " gates (the Solovay-Kitaev idea)?"
}], "Subsection",ExpressionUUID->"ca83a1c7-5b9e-4194-a18c-2befa6eac577"],

Cell[TextData[{
 "The gates ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["H", "TI"]}], ",", 
   RowBox[{
    StyleBox["T", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "272cc74f-fb68-418f-8d01-dde8d55af438"],
 " generate a dense subgroup of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1059ead0-6f2b-4d0e-8886-2efb66d12859"],
 ", so any single-qubit unitary can be approximated to arbitrary accuracy ",
 Cell[BoxData[
  StyleBox["\[CurlyEpsilon]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de0dbd82-a1b2-4109-902c-5839fd992ae5"],
 " by a finite word in ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70ca46e4-da16-4140-bcfa-b959905159b4"],
 " and ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1360eb82-16e6-467e-8f08-62093c08429b"],
 "; the Solovay-Kitaev theorem says the word length grows only \
polylogarithmically in ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[CurlyEpsilon]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f777923-ff82-411b-87f7-7ecfe3be7c9e"],
 ". Here we demonstrate the ",
 StyleBox["density", "TI"],
 " directly by brute force (not the efficient recursion): search words in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["H", "TI"]}], ",", 
   RowBox[{
    StyleBox["T", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed7597d-2bcc-449c-9699-aa4ec8477b6b"],
 " for the best approximation to a target rotation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], "=", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    OverscriptBox[
     StyleBox["n", "TI"], "^"]], 
   StyleBox["(",
    SpanMaxSize->1], "0.8", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5a2f8f0-edc2-4a6a-90a8-8325b7df2ffe"],
 " about the tilted axis ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "+", 
    OverscriptBox[
     StyleBox["z", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd8a2cbc-365e-4bc5-834a-024056fded31"],
 ", measured by the phase-invariant error ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   FractionBox["1", "2"], GridBox[{
     {
      RowBox[{
       StyleBox["Tr",
        FontSlant->"Plain"], 
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        SuperscriptBox[
         StyleBox["W", "TI"], "\[Dagger]"], 
        StyleBox["U", "TI"]}], 
       StyleBox["]",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "888ed581-1801-4a38-ae0e-fd2e30fea9bb"],
 "."
}], "Text",ExpressionUUID->"69d978ea-9be6-422e-b449-4d825500c69c"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the two generators, kept numeric because the search multiplies out \
thousands of products."
}], "Text",ExpressionUUID->"5c2e018a-4c15-4e8a-a85f-0001e1a391f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gates", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<H\>\"", " ", "->", " ", 
       RowBox[{"HadamardMatrix", "[", "2", "]"}]}], ",", " ", 
      RowBox[{"\"\<T\>\"", " ", "->", " ", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"Pi", "/", "4"}]}], "]"}]}], "}"}], "]"}]}]}], "|>"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"def207e6-2e04-4610-b495-f7cd50c11fa7"],

Cell[TextData[{
 "The target, a rotation by ",
 Cell[BoxData["0.8"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9fe1d901-e17c-4f29-a0fa-9a3f02165517"],
 " about the tilted axis ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "+", 
    OverscriptBox[
     StyleBox["z", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d64cfb4-7d45-4b6e-bcaa-60bef7a62942"],
 ", tilted precisely so that no short word lands on it exactly."
}], "Text",ExpressionUUID->"f1714fc9-82e0-404b-8ab3-cf4dbe67b8fc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"utarget", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"(", "0.4", ")"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "1", "]"}], " ", "+", " ", 
         RowBox[{"PauliMatrix", "[", "3", "]"}]}], ")"}], "/", 
       RowBox[{"Sqrt", "[", "2", "]"}]}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"0d26a262-74c8-4def-b977-8495328cb0e8"],

Cell[TextData[{
 "The cost of a word: multiply its gates out with ",
 Cell[BoxData["Fold"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16333d27-e7fb-4461-9355-88e7b31b2597"],
 " and score it by ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   FractionBox["1", "2"], GridBox[{
     {
      RowBox[{
       StyleBox["Tr",
        FontSlant->"Plain"], 
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        SuperscriptBox[
         StyleBox["W", "TI"], "\[Dagger]"], 
        StyleBox["U", "TI"]}], 
       StyleBox["]",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c45703b0-3e75-410b-b9c1-eb7e98b247a2"],
 ", which is blind to global phase and so measures only the physically \
meaningful distance to the target."
}], "Text",ExpressionUUID->"d8a13ced-9001-466e-9945-18d8e4be0d98"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"err", "[", "w_", "]"}], " ", ":=", " ", 
   RowBox[{"1", " ", "-", " ", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", 
         RowBox[{"Fold", "[", 
          RowBox[{"Dot", ",", " ", 
           RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
           RowBox[{"gates", " ", "/@", " ", "w"}]}], "]"}], "]"}], " ", ".", 
        " ", "utarget"}], "]"}], "]"}], "/", "2"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"2fd374de-68d2-4508-82bd-f9dab960704d"],

Cell[TextData[{
 "Enumerate every word up to length ",
 Cell[BoxData[
  StyleBox["L", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f418add4-0a76-4264-8ace-1bd155985e6e"],
 " and keep the best error, for three increasing length budgets."
}], "Text",ExpressionUUID->"43de710e-1d41-49d7-b8a2-c0593b2e95c4"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Min", "[", 
    RowBox[{"err", " ", "/@", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<H\>\"", ",", " ", "\"\<T\>\""}], "}"}], ",", " ", 
           "len"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"len", ",", " ", "1", ",", " ", "L"}], "}"}]}], "]"}], ",", 
       " ", "1"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"L", ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "8", ",", " ", "12"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"16b1c927-7ed3-4dc8-ab8d-411a89840901"],

Cell["\<\
Take the best word found and confirm it as an explicit gate sequence.\
\>", "Text",ExpressionUUID->"357cea6d-6e55-412e-bcc3-d243d95b8c44"],

Cell[BoxData[
 RowBox[{"best", " ", "=", " ", 
  RowBox[{
   RowBox[{"MinimalBy", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<H\>\"", ",", " ", "\"\<T\>\""}], "}"}], ",", " ", 
           "len"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"len", ",", " ", "1", ",", " ", "12"}], "}"}]}], "]"}], ",",
        " ", "1"}], "]"}], ",", " ", "err", ",", " ", "1"}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"42f17e31-b905-433e-a5f3-19cd00473b25"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : build that winning word as a ",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c41347b1-ec10-49bf-901e-90aec0068234"],
 " of named ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0785f28-9f8f-461b-9070-0019ba3b0799"],
 " and ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4ad7e26-e49d-41b1-9ed5-0ef8f9a7d4b7"],
 " gates; its overall unitary approximates the target to the same error."
}], "Text",ExpressionUUID->"4ab6378b-22f0-4842-84e6-ff64b16d54bf"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qc", " ", "=", " ", 
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{"Thread", "[", 
       RowBox[{"best", " ", "->", " ", "1"}], "]"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"1", " ", "-", " ", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{
           RowBox[{"qc", "[", "\"\<QuantumOperator\>\"", "]"}], 
           "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}], " ", ".", " ", 
        "utarget"}], "]"}], "]"}], "/", "2"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"5e12287e-d180-4205-a0aa-1d68de133fdd"],

Cell[TextData[{
 "The best-approximation error never increases as longer ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["H", "TI"]}], ",", 
   RowBox[{
    StyleBox["T", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b888ba79-d290-4a39-bfd7-6d2f65eab2e6"],
 " words are allowed and drops sharply once enough length is available (here \
from ",
 Cell[BoxData[
  RowBox[{"\[Tilde]", "2", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38010c19-f087-4fc4-9fca-596e9811f978"],
 " to ",
 Cell[BoxData[
  RowBox[{"\[Tilde]", "3", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "5"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc2b7af9-2e0e-4977-bcad-e9d7443c761b"],
 "), and the QF circuit built from the winning word reproduces that error: a \
finite, discrete gate set suffices to reach any single-qubit unitary as \
closely as desired, the theoretical basis for compiling arbitrary rotations \
onto fault-tolerant hardware whose native gates are exactly ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["H", "TI"]}], ",", 
   RowBox[{
    StyleBox["T", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c2742c0-d8eb-465e-90a5-512cc1b62601"],
 " (and the two-qubit CNOT of Part 10)."
}], "Text",ExpressionUUID->"55ed4bcd-40c0-4d95-8150-7e541220c9dd"]
},
CreateCellID->True,
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (February 17, 2026)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"e87e7e57-c2b7-473f-8985-5c8d8593a5f8"
]
