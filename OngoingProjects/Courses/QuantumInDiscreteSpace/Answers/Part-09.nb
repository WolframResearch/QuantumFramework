Notebook[{
Cell[554, 20, 115, 0, 70, "Section",ExpressionUUID->"405b76ff-cd37-4c58-906e-903c740ea7e4"],
Cell[672, 22, 468, 13, 70, "Subsection",ExpressionUUID->"ab549ab0-a1e4-4aa1-80a9-ae88c03dc6e8"],
Cell[1143, 37, 1719, 62, 70, "Text",ExpressionUUID->"ef461bc9-7b6a-47ec-a20e-693c2e75f433"],
