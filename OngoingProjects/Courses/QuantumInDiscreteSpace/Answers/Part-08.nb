Notebook[{
Cell["Part 8. Spin and angular momentum", "Section",ExpressionUUID->"534c6e9e-4628-44e2-a25e-00593748e02c"],

Cell[TextData[{
 "Spin is the cleanest finite-dimensional laboratory for angular momentum: \
every operator is a small matrix and every state a short vector, so the whole \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "481c0896-d362-464b-a81c-7f1f3cd71c8d"],
 " story fits in a few lines. Each answer below is self-contained, building \
the spin operators and states it needs from scratch."
}], "Text",ExpressionUUID->"bb147a50-cd12-4ad9-a3ee-9d33072c5407"],

Cell["\<\
8.1 [BSc] How do I model a spin-1/2 in a magnetic field and reproduce the \
Stern-Gerlach spin-projection outcomes?\
\>", "Subsection",ExpressionUUID->"c49b2ad1-edc9-4710-bafd-0c27a2d96ab5"],

Cell[TextData[{
 "A spin-1/2 in a field along ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "395ad5ed-db4b-46d0-9806-b19a945d65c3"],
 " has ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", "-", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["B", "TI"], " ", 
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df2ad88a-eaaa-4b3a-bc2a-c1c05eb3adc2"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["z", "TI"]], "=", 
   FractionBox["1", "2"], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df8ac353-9ec4-4f5e-bd9a-926629ae6a11"],
 ". A Stern-Gerlach apparatus measures ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe1f6a1f-9d95-45e7-a008-6247a24f7d11"],
 ", whose two eigenvalues ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d076ba2-3c42-475f-80e6-1e14728c5e17"],
 " are the only outcomes: the beam splits in two, never a continuum. Prepare \
a spin along ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "686080e0-71f6-437a-a1ca-f9da78e7d5c2"],
 " and read the outcomes, their Born weights, and the mean."
}], "Text",ExpressionUUID->"4ff8e0fe-a819-4fda-ac32-6c652bd081ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sz", " ", "=", " ", 
   RowBox[{
    RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}]}], ";", " ", 
  RowBox[{"\[Psi]", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a507da4a-7528-4725-977b-87b77ae8fe5a"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the outcomes are the diagonal entries of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7ccd5f7-396b-49be-a3dc-6a4480314d83"],
 " and the weights the squared amplitudes; ",
 Cell[BoxData["Thread"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36fb15ef-8b08-4912-a492-e7f0e63f3f3f"],
 " pairs each outcome with its probability:"
}], "Text",ExpressionUUID->"8b3d522e-5d90-4a4f-9181-c64b7c39cfc6"],

Cell[BoxData[
 RowBox[{"Thread", "[", 
  RowBox[{
   RowBox[{"Diagonal", "[", "sz", "]"}], " ", "->", " ", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{
     RowBox[{"Abs", "[", "\[Psi]", "]"}], "^", "2"}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"e6aa4bed-5d74-4799-a129-d53623a6902f"],

Cell[TextData[{
 "The mean is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Bra"], 
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["z", "TI"]], 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e62588dc-a7ac-4f18-894d-bfa85ef1302b"],
 ":"
}], "Text",ExpressionUUID->"3df2c1bb-9447-4d0b-b537-ffad2d34df99"],

Cell[BoxData[
 RowBox[{"ComplexExpand", "[", 
  RowBox[{
   RowBox[{"Conjugate", "[", "\[Psi]", "]"}], " ", ".", " ", "sz", " ", ".", 
   " ", "\[Psi]"}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"31a8344d-6741-4bc2-ad87-da8caef0effb"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : a ",
 Cell[BoxData["QuantumMeasurementOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b47fbe3-02a5-4464-b4b5-9313faf333be"],
 " measures the state and returns its outcome-keyed ",
 Cell[BoxData["\"\<Probabilities\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f82cff88-27de-4878-8f13-c84c72d82097"],
 " and its ",
 Cell[BoxData["\"\<Mean\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5f7a570-16c3-4194-a649-e559e64a73c9"],
 ":"
}], "Text",ExpressionUUID->"e2f3f1f6-7bcc-40d0-84dc-5d2c1ac41bdc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"meas", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumMeasurementOperator", "[", 
     RowBox[{"QuantumOperator", "[", "sz", "]"}], "]"}], "[", 
    RowBox[{"QuantumState", "[", "\[Psi]", "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"548d2234-1dfd-4215-90d4-9220868e85dd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Simplify", "@*", "ComplexExpand"}], " ", "/@", " ", 
  RowBox[{"meas", "[", "\"\<Probabilities\>\"", "]"}]}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"80e916e2-549f-473d-92b2-ff582f1eee97"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"meas", "[", "\"\<Mean\>\"", "]"}], " ", "//", " ", 
   "ComplexExpand"}], " ", "//", " ", "Simplify"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"f35d7bc4-88c5-48fe-9c8a-c6ea3fda66c6"],

Cell[TextData[{
 "Both give outcomes ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fbb8c2e-9276-4d6e-9ec9-7410f6aef4de"],
 " with probabilities ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["cos",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    FractionBox[
     StyleBox["\[Theta]", "TI"], "2"]}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["sin",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    FractionBox[
     StyleBox["\[Theta]", "TI"], "2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45f7e4c1-6fbb-4108-9937-63e1c0e69c7b"],
 " and mean ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   FractionBox["1", "2"], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98ef92ef-90e2-4437-b9af-8dbb43c336e8"],
 ": the apparatus reveals the discreteness of angular momentum, and a spin \
tilted at ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05ec1746-6577-4198-b85e-06aabb68a6f2"],
 " from the field lands in the upper beam with probability ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["\[Theta]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6428051d-d726-4521-acad-25674334317b"],
 ". The azimuth ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "944bb1e4-c029-46c3-a4b9-b5791f4fbb87"],
 " drops out, because an ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e73e758-99bd-445f-8368-53e6028f6b19"],
 " measurement cannot see it."
}], "Text",ExpressionUUID->"5e7f18e5-ba86-488f-80a6-fe4f9100044e"],

Cell[TextData[{
 "8.2 [BSc] How do I build the spin-",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "609d6f7e-c1a0-48c0-b660-bb61dced1ea2"],
 " angular-momentum operators and verify the full algebra ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["a", "TI"]], ",", 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["b", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], " ", 
   SubscriptBox[
    StyleBox["\[CurlyEpsilon]", "TI"], 
    StyleBox[
     RowBox[{"a", "b", "c"}], "TI"]], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe501f9f-6aa5-43f2-ab6c-b3e56e99b164"],
 " and the Casimir?"
}], "Subsection",ExpressionUUID->"8aff311f-b0fc-4584-a67e-af3505037211"],

Cell[TextData[{
 "The angular-momentum operators are defined by the ladder relation ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], "\[PlusMinus]"], 
    TemplateBox[{
      RowBox[{
        StyleBox["j", "TI"], ",", 
        StyleBox["m", "TI"]}]},
     "Ket"]}], "=", 
   RowBox[{
    SqrtBox[
     RowBox[{
      StyleBox["j", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["j", "TI"], "+", "1"}], 
      StyleBox[")",
       SpanMaxSize->1], "-", 
      StyleBox["m", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["m", "TI"], "\[PlusMinus]", "1"}], 
      StyleBox[")",
       SpanMaxSize->1]}]], 
    TemplateBox[{
      RowBox[{
        StyleBox["j", "TI"], ",", 
        StyleBox["m", "TI"], "\[PlusMinus]", "1"}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c14e79c2-6505-4a4b-886c-28bb78e70019"],
 ", from which ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["x", "TI"]], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], "+"], "+", 
    SubscriptBox[
     StyleBox["J", "TI"], "-"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41f0764a-25ed-44ae-abd5-7d536e468c27"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["y", "TI"]], "=", 
   FractionBox["1", 
    RowBox[{"2", 
     StyleBox["i", "TI"]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], "+"], "-", 
    SubscriptBox[
     StyleBox["J", "TI"], "-"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8acd386-8ba1-4fe0-aaec-1dc88884a582"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["z", "TI"]], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["m", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "294b6191-4f22-435a-ac73-f55f03eed904"],
 ". They must close under the full ",
 Cell[BoxData[
  RowBox[{"\|01d530", "\|01d532", 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "851165cf-b098-4b42-aebc-d97875225786"],
 " algebra ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["a", "TI"]], ",", 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["b", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], 
   UnderscriptBox["\[Sum]", 
    StyleBox["c", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["\[CurlyEpsilon]", "TI"], 
    StyleBox[
     RowBox[{"a", "b", "c"}], "TI"]], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c6129-0115-450c-8451-921a8e52d4ca"],
 " (",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[CurlyEpsilon]", "TI"], 
   StyleBox[
    RowBox[{"a", "b", "c"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fa1f78a-f26c-4f1d-8072-6b4eff02e5b2"],
 " the Levi-Civita structure constants) and give the Casimir ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["J", "TI"], "2"], "=", 
   StyleBox["j", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["j", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55c166e5-c496-40c2-b4ea-ea5c2cab5ea0"],
 ". Build them for spin ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f47383d7-c89e-43a7-a966-cee0da6a5254"],
 "."
}], "Text",ExpressionUUID->"000d520f-387d-4e0d-ab37-038d3707489c"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b36d61a8-16bf-4b2b-ba37-a89d356832b9"],
 " is diagonal and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], "+"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da90b814-14ea-45e9-8d11-3c92d196af20"],
 " carries one super-diagonal; collect ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["J", "TI"], "\[RightVector]"], "=", "{", 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["x", "TI"]]}], ",", 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["y", "TI"]], ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["z", "TI"]], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "056b45a3-9c42-4988-8a39-af61bec8efe2"],
 ":"
}], "Text",ExpressionUUID->"36c471e9-dd39-4591-a864-149931341612"],

Cell[BoxData[
 RowBox[{
  RowBox[{"j", " ", "=", " ", "1"}], ";", " ", 
  RowBox[{"m", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"j", ",", " ", 
     RowBox[{"-", "j"}], ",", " ", 
     RowBox[{"-", "1"}]}], "]"}]}], ";", " ", 
  RowBox[{"jp", " ", "=", " ", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r_", ",", " ", "c_"}], "}"}], " ", "/;", " ", 
       RowBox[{"r", " ", "==", " ", 
        RowBox[{"c", " ", "-", " ", "1"}]}]}], " ", ":>", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"j", " ", 
         RowBox[{"(", 
          RowBox[{"j", " ", "+", " ", "1"}], ")"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"m", "[", 
          RowBox[{"[", "c", "]"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"m", "[", 
            RowBox[{"[", "c", "]"}], "]"}], " ", "+", " ", "1"}], ")"}]}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}], ",", " ", 
       RowBox[{
        RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}]}], "}"}]}], "]"}]}], ";",
   " ", 
  RowBox[{"jvec", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"jp", " ", "+", " ", 
        RowBox[{"Transpose", "[", "jp", "]"}]}], ")"}], "/", "2"}], ",", " ", 
     
     RowBox[{
      RowBox[{"(", 
       RowBox[{"jp", " ", "-", " ", 
        RowBox[{"Transpose", "[", "jp", "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "I"}], ")"}]}], ",", " ", 
     RowBox[{"DiagonalMatrix", "[", "m", "]"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"fa693f83-6bd0-44d1-b69d-fd1cbdbff72a"],

Cell[TextData[{
 "All nine commutators close on the structure constants, checked in one \
tensor contraction against ",
 Cell[BoxData[
  RowBox[{"LeviCivitaTensor", "[", "3", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87e8b08e-c2d1-43a1-bcdc-2b86b64ae2f5"],
 ":"
}], "Text",ExpressionUUID->"de729979-b7be-4e77-92d8-dcfa1cceebfa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"jvec", "[", 
       RowBox[{"[", "a", "]"}], "]"}], " ", ".", " ", 
      RowBox[{"jvec", "[", 
       RowBox[{"[", "b", "]"}], "]"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"jvec", "[", 
       RowBox[{"[", "b", "]"}], "]"}], " ", ".", " ", 
      RowBox[{"jvec", "[", 
       RowBox[{"[", "a", "]"}], "]"}]}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}], " ", "==", " ", 
  RowBox[{"I", " ", 
   RowBox[{
    RowBox[{"LeviCivitaTensor", "[", "3", "]"}], " ", ".", " ", 
    "jvec"}]}]}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"c8ff9e44-eace-4f01-95c2-79eb9d14a14e"],

Cell[TextData[{
 "And the Casimir is the scalar ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["j", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bef5a63-e2de-4b41-ba57-eb9fe3ef2643"],
 ":"
}], "Text",ExpressionUUID->"fb0ddd15-8ccc-4bac-a5de-f23331e55fff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Total", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"#", ".", "#"}], " ", "&"}], " ", "/@", " ", "jvec"}], "]"}], 
  " ", "==", " ", 
  RowBox[{"j", " ", 
   RowBox[{"(", 
    RowBox[{"j", " ", "+", " ", "1"}], ")"}], " ", 
   RowBox[{"IdentityMatrix", "[", 
    RowBox[{
     RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}], "]"}]}]}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"de1f1e60-e104-4522-b2b7-abc25584766f"],

Cell[TextData[{
 "The same operators follow from group theory, because ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["J", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16c3970c-fcc7-46f3-8301-74e5c30a49d0"],
 " is a rank-1 ",
 StyleBox["spherical tensor", "TI"],
 ": its ",
 StyleBox["spherical components",
  FontWeight->"Bold"],
 " are ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["J", "TI"], 
    RowBox[{"+", "1"}], 
    StyleBox["sph",
     FontSlant->"Plain"]], "=", "-", 
   FractionBox["1", 
    SqrtBox["2"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["x", "TI"]], "+", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["y", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66442b4f-3707-47c9-ae25-5e90312ae97d"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["J", "TI"], "0", 
    StyleBox["sph",
     FontSlant->"Plain"]], "=", 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ccaa409-a8c3-45eb-8bd7-d39328d0173a"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["J", "TI"], 
    RowBox[{"-", "1"}], 
    StyleBox["sph",
     FontSlant->"Plain"]], "=", "+", 
   FractionBox["1", 
    SqrtBox["2"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["x", "TI"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["y", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b78be61c-8a60-4f0f-9c53-d3994eaecbef"],
 ", labeled by ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Mu]", "TI"], "=", "+", "1"}], ",", "0", ",", 
   RowBox[{"-", "1"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf536349-fce8-4a64-af1c-619ef3f6d4d6"],
 " and rotating like the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2daed691-0496-4029-909d-903c087da383"],
 " kets ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"1", ",", 
      StyleBox["\[Mu]", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b90eef21-41df-4403-bee8-51bc9841d3ab"],
 ". The Wigner-Eckart theorem fixes each matrix element as one Clebsch-Gordan \
coefficient times a single reduced matrix element, equal to ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["j", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["j", "TI"], "+", "1"}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d495763b-00cf-436c-8a84-e62126bbe44a"],
 " for ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["J", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341687cb-0b06-48b3-b552-3d79bb4b8666"],
 " itself:"
}], "Text",ExpressionUUID->"3052d95a-3a13-41c7-aaad-f11d6bba4060"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       TemplateBox[{
         RowBox[{
           StyleBox["j", "TI"], ",", 
           SuperscriptBox[
            StyleBox["m", "TI"], "\[Prime]"]}]},
        "Bra"], 
       SubsuperscriptBox[
        StyleBox["J", "TI"], 
        StyleBox["\[Mu]", "TI"], 
        StyleBox["sph",
         FontSlant->"Plain"]], 
       TemplateBox[{
         RowBox[{
           StyleBox["j", "TI"], ",", 
           StyleBox["m", "TI"]}]},
        "Ket"]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         SqrtBox[
          RowBox[{
           StyleBox["j", "TI"], 
           StyleBox["(",
            SpanMaxSize->1], 
           RowBox[{
            StyleBox["j", "TI"], "+", "1"}], 
           StyleBox[")",
            SpanMaxSize->1]}]], 
         RowBox[{
          StyleBox["(",
           FontSize->1.2 Inherited], 
          RowBox[{
           TemplateBox[{
             RowBox[{
               StyleBox["j", "TI"], ",", 
               StyleBox["m", "TI"]}]},
            "Bra"], "\[CircleTimes]", 
           TemplateBox[{
             RowBox[{"1", ",", 
               StyleBox["\[Mu]", "TI"]}]},
            "Bra"]}], 
          StyleBox[")",
           FontSize->1.2 Inherited]}]}], 
        StyleBox["|",
         SpanMaxSize->1,
         FontSize->1.2 Inherited], 
        StyleBox["J", "TI"]}], "=", 
       StyleBox["j", "TI"]}]}], ",", 
     RowBox[{
      StyleBox["M", "TI"], "=", 
      SuperscriptBox[
       StyleBox["m", "TI"], "\[Prime]"]}]}], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1,
     FontSize->1.2 Inherited]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"d44be02d-669b-4dd0-\
a9c7-4b817decc9d2"],

Cell[TextData[{
 "The coefficient on the right is built by adding two angular momenta. The \
first is the physical spin: the operator ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["J", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c167017c-baff-4a62-ba34-1802ae0012be"],
 ", with angular momentum quantum number ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b8697a7-d78f-4b2e-8718-e6114d0f8246"],
 ", acting on the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["j", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75cd924c-e2b2-49cb-b6ea-11f0b517f009"],
 "-dimensional space ",
 Cell[BoxData[
  SubscriptBox["\[ScriptCapitalH]", 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ccab525-6271-4d82-ae54-8d4f3cfbe15b"],
 " whose orthonormal basis is ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["j", "TI"], ",", 
      StyleBox["m", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf981c14-6660-4989-ae9f-175371e3f55b"],
 " for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["m", "TI"], "=", 
    StyleBox["j", "TI"]}], ",", 
   RowBox[{
    StyleBox["j", "TI"], "-", "1"}], ",", "\[Ellipsis]", ",", 
   RowBox[{"-", 
    StyleBox["j", "TI"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b57eea1-01f4-45a1-b28d-03b785b5192f"],
 ". The second is a spin-1 angular momentum ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["S", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cbbad99-362a-4950-b4a0-9a473e3ae3b5"],
 " attached to the tensor index, acting on the ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08a6b8d8-1ff0-4775-a1d7-641fc57dea96"],
 "-dimensional space ",
 Cell[BoxData[
  SubscriptBox["\[ScriptCapitalH]", "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8295dbd9-4ef6-4088-83aa-9051b02f2e99"],
 " with basis ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"1", ",", 
      StyleBox["\[Mu]", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00963836-0ac3-4574-a3ad-d0004488850c"],
 "; it enters not as a second physical particle but as the representation \
space in which the operator's three spherical components transform. On the \
product space ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptCapitalH]", 
    StyleBox["j", "TI"]], "\[CircleTimes]", 
   SubscriptBox["\[ScriptCapitalH]", "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97f1005d-31e9-49fb-a07c-e9f0819e47fb"],
 ", of dimension ",
 Cell[BoxData[
  RowBox[{"3", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["j", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d73a214-a710-44d8-8ad4-39117a7a3455"],
 ", the total angular momentum is the operator ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["J", "TI"], "\[RightVector]"], 
    StyleBox["tot",
     FontSlant->"Plain"]], "=", 
   OverscriptBox[
    StyleBox["J", "TI"], "\[RightVector]"], "\[CircleTimes]", 
   StyleBox["I", "TI"], "+", 
   StyleBox["I", "TI"], "\[CircleTimes]", 
   OverscriptBox[
    StyleBox["S", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ed07820-852c-4f5f-86df-3f84c6d83717"],
 ". Its square ",
 Cell[BoxData[
  SubsuperscriptBox[
   OverscriptBox[
    StyleBox["J", "TI"], "\[RightVector]"], 
   StyleBox["tot",
    FontSlant->"Plain"], 
   RowBox[{" ", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd309cfb-1220-4f23-b270-19fd90a7f5a5"],
 " has eigenvalue ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["J", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "346b2b19-5c17-4b3f-8c41-63d7824dce3b"],
 " on three orthogonal subspaces labeled ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["J", "TI"], "=", 
    StyleBox["j", "TI"], "+", "1"}], ",", " ", 
   StyleBox["j", "TI"], ",", " ", 
   RowBox[{
    StyleBox["j", "TI"], "-", "1"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b7d5c047-08ab-4768-8418-c24f7546bb19"],
 " (for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "\[GreaterEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2453036c-c353-42d3-89b2-89d47016fcfb"],
 "; at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3b997aa-4107-43db-afbb-d9989ad88c98"],
 " the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], "=", 
   StyleBox["j", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "994c9ca5-0117-4356-9e9a-fadccf33c8c7"],
 " subspace is absent), so the product space is the direct sum"
}], "Text",ExpressionUUID->"c15131ce-ee4c-4107-a81b-7886c9da3e47"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalH]", 
     StyleBox["j", "TI"]], "\[CircleTimes]", 
    SubscriptBox["\[ScriptCapitalH]", "1"], "=", 
    SubscriptBox["\[ScriptCapitalH]", 
     RowBox[{
      StyleBox["j", "TI"], "+", "1"}]], "\[CirclePlus]", 
    SubscriptBox["\[ScriptCapitalH]", 
     StyleBox["j", "TI"]], "\[CirclePlus]", 
    SubscriptBox["\[ScriptCapitalH]", 
     RowBox[{
      StyleBox["j", "TI"], "-", "1"}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"6282b783-c0e8-4496-\
ab6e-82fd318ad7bb"],

Cell[TextData[{
 "A ",
 StyleBox["coupled state", "TI"],
 " ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["J", "TI"], ",", 
      StyleBox["M", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03f0ce5d-2272-4024-9ee7-eea158997348"],
 " is the simultaneous eigenstate of ",
 Cell[BoxData[
  SubsuperscriptBox[
   OverscriptBox[
    StyleBox["J", "TI"], "\[RightVector]"], 
   StyleBox["tot",
    FontSlant->"Plain"], 
   RowBox[{" ", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ecc86784-88ed-4ba6-8afe-1692432cede7"],
 ", with eigenvalue ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["J", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd8efd9b-9262-477a-8b00-40ff8c35e49b"],
 ", and of the total projection ",
 Cell[BoxData[
  SubscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["tot",
      FontSlant->"Plain"]], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c883e3f-4c49-4360-8d35-38f3bf5ad93a"],
 ", with eigenvalue ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00ef825c-fd80-4f07-b01f-143f41a42ab7"],
 ". Expanded in the product basis it reads"
}], "Text",ExpressionUUID->"c8555c69-100f-4824-a74b-5bf94a21c8fa"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["J", "TI"], ",", 
        StyleBox["M", "TI"]}]},
     "Ket"], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["m", "TI"], "+", 
       StyleBox["\[Mu]", "TI"], "=", 
       StyleBox["M", "TI"]}],
      LimitsPositioning->False], 
     RowBox[{
      RowBox[{
       StyleBox["(",
        FontSize->1.2 Inherited], 
       RowBox[{
        TemplateBox[{
          RowBox[{
            StyleBox["j", "TI"], ",", 
            StyleBox["m", "TI"]}]},
         "Bra"], "\[CircleTimes]", 
        TemplateBox[{
          RowBox[{"1", ",", 
            StyleBox["\[Mu]", "TI"]}]},
         "Bra"]}], 
       StyleBox[")",
        FontSize->1.2 Inherited]}], 
      TemplateBox[{
        RowBox[{
          StyleBox["J", "TI"], ",", 
          StyleBox["M", "TI"]}]},
       "Ket"], 
      RowBox[{
       TemplateBox[{
         RowBox[{
           StyleBox["j", "TI"], ",", 
           StyleBox["m", "TI"]}]},
        "Ket"], "\[CircleTimes]", 
       TemplateBox[{
         RowBox[{"1", ",", 
           StyleBox["\[Mu]", "TI"]}]},
        "Ket"]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"d16b0d3a-dd22-4b7d-\
b6b2-0b046ddd2a89"],

Cell[TextData[{
 "and the numbers ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["(",
     FontSize->1.2 Inherited], 
    RowBox[{
     TemplateBox[{
       RowBox[{
         StyleBox["j", "TI"], ",", 
         StyleBox["m", "TI"]}]},
      "Bra"], "\[CircleTimes]", 
     TemplateBox[{
       RowBox[{"1", ",", 
         StyleBox["\[Mu]", "TI"]}]},
      "Bra"]}], 
    StyleBox[")",
     FontSize->1.2 Inherited]}], 
   TemplateBox[{
     RowBox[{
       StyleBox["J", "TI"], ",", 
       StyleBox["M", "TI"]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b567432e-48b9-4268-b025-c8dec46f8d6f"],
 " weighting each product state are the Clebsch-Gordan coefficients, ordinary \
inner products taken entirely inside ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptCapitalH]", 
    StyleBox["j", "TI"]], "\[CircleTimes]", 
   SubscriptBox["\[ScriptCapitalH]", "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7018750-cc13-46cd-8d2e-56d2ce30aeab"],
 "."
}], "Text",ExpressionUUID->"864e18d8-5f4a-4890-8a68-f5bba4cb1eff"],

Cell[TextData[{
 "The coefficient in the Wigner-Eckart formula is this number for the middle \
subspace ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], "=", 
   StyleBox["j", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d5227a4-1eb8-4569-9d24-dc1dcc800fff"],
 ", at total projection ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], "=", 
   SuperscriptBox[
    StyleBox["m", "TI"], "\[Prime]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c77eec44-725a-43bc-a545-74362889bc91"],
 ". The total quantum number equals ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d9f5902-fa09-43c3-b352-56d834509b8b"],
 ", the same value as the physical spin, because ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["J", "TI"], 
   StyleBox["\[Mu]", "TI"], 
   StyleBox["sph",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "482661c8-f311-46c1-970a-edbb5f82bc93"],
 " carries the spin-",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0117e6d-c6f2-4db2-b071-3f8dfa257561"],
 " multiplet back into itself, so only the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], "=", 
   StyleBox["j", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d529a66-0cdd-4653-ab80-c7dd61bf2e13"],
 " subspace contributes and the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], "=", 
   StyleBox["j", "TI"], "\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "929d2b5d-5736-470a-861b-8f22e0a1a429"],
 " ones drop out. The right-hand ket ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["|",
      SpanMaxSize->1,
      FontSize->1.2 Inherited], " ", 
     StyleBox["J", "TI"], "=", 
     StyleBox["j", "TI"]}], ",", "\[ThickSpace]", 
    RowBox[{
     StyleBox["M", "TI"], "=", 
     SuperscriptBox[
      StyleBox["m", "TI"], "\[Prime]"]}]}], " ", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1,
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5cf366c-af03-49e6-8de1-2980c35de9ab"],
 " is therefore a vector in the ",
 Cell[BoxData[
  RowBox[{"3", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["j", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e48c40c1-b10a-49dc-b525-38b8c8d96b76"],
 "-dimensional product space, a different object from the physical \
single-spin state ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["j", "TI"], ",", 
      SuperscriptBox[
       StyleBox["m", "TI"], "\[Prime]"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "645b54b6-fafd-483f-8c69-4488745610de"],
 " on the left of the matrix element, which lives in the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["j", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0115a74-c54a-46b4-b47b-68cb16fa36ca"],
 "-dimensional space ",
 Cell[BoxData[
  SubscriptBox["\[ScriptCapitalH]", 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f94e9ea3-7c8f-4f2d-b95a-9453444639b0"],
 "; they share the label ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["j", "TI"], ",", 
    SuperscriptBox[
     StyleBox["m", "TI"], "\[Prime]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "939efb31-4e0b-496a-8314-1fc5a952a19f"],
 " only through this coincidence of values. The coefficient is nonzero only \
when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], "=", 
   StyleBox["m", "TI"], "+", 
   StyleBox["\[Mu]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29097a5f-a959-4f55-809f-c850706ca5ee"],
 ", that is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["m", "TI"], "\[Prime]"], "=", 
   StyleBox["m", "TI"], "+", 
   StyleBox["\[Mu]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74da7f29-aea0-420b-8e89-964f84dac91a"],
 ". In ",
 Cell[BoxData["ClebschGordan"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "727a600c-73f9-4652-828a-842e7a9f585a"],
 " the first two arguments ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["j", "TI"]}], ",", 
   RowBox[{
    StyleBox["m", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04c5826b-2355-4538-9ab6-af8adfeb2497"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", 
   RowBox[{
    StyleBox["\[Mu]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54c6784b-8589-40c9-8f8e-d115b5d3985f"],
 " are the two states that are combined, and the third, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["j", "TI"]}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["m", "TI"], "\[Prime]"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6376777e-3e1c-4484-bd61-8616a319c196"],
 ", is the coupled state ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["|",
      SpanMaxSize->1,
      FontSize->1.2 Inherited], " ", 
     StyleBox["J", "TI"], "=", 
     StyleBox["j", "TI"]}], ",", "\[ThickSpace]", 
    RowBox[{
     StyleBox["M", "TI"], "=", 
     SuperscriptBox[
      StyleBox["m", "TI"], "\[Prime]"]}]}], " ", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1,
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9037dec-0ae8-4635-bb76-d7ba58334911"],
 ". Reading the three components straight from ",
 Cell[BoxData["ClebschGordan"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "234dac60-42c3-47eb-a1d8-6cef4be1a60c"],
 ":"
}], "Text",ExpressionUUID->"92c3a467-d844-4c95-bbd2-d6259559fe64"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"lsph", "[", "\[Mu]_", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"m", "[", 
         RowBox[{"[", "r", "]"}], "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"m", "[", 
          RowBox[{"[", "c", "]"}], "]"}], " ", "+", " ", "\[Mu]"}]}], ",", 
       " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"j", " ", 
          RowBox[{"(", 
           RowBox[{"j", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", 
        RowBox[{"ClebschGordan", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"j", ",", " ", 
            RowBox[{"m", "[", 
             RowBox[{"[", "c", "]"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "\[Mu]"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", 
            RowBox[{"m", "[", 
             RowBox[{"[", "r", "]"}], "]"}]}], "}"}]}], "]"}]}], ",", " ", 
       "0"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", 
       RowBox[{
        RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", ",", " ", 
       RowBox[{
        RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"eb861a99-6060-4107-94e2-4b9ffc2a0c92"],

Cell[TextData[{
 "Unpacking ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["x", "TI"]], ",", 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["y", "TI"]], ",", 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12cab262-46f9-46ab-ac50-b696f503777d"],
 " reproduces the ladder operators exactly:"
}], "Text",ExpressionUUID->"b50215ea-b8f8-4e03-955e-8bdf9b695aa4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"lsph", "[", 
         RowBox[{"-", "1"}], "]"}], " ", "-", " ", 
        RowBox[{"lsph", "[", "1", "]"}]}], ")"}], "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
     RowBox[{"I", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"lsph", "[", 
          RowBox[{"-", "1"}], "]"}], " ", "+", " ", 
         RowBox[{"lsph", "[", "1", "]"}]}], ")"}], "/", 
       RowBox[{"Sqrt", "[", "2", "]"}]}]}], ",", " ", 
     RowBox[{"lsph", "[", "0", "]"}]}], "}"}], " ", "==", " ", "jvec"}], " ", 
  "//", " ", "Simplify"}]], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"e5385833-c714-46ac-8c61-c9f1713721c7"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the built-in named operators ",
 Cell[BoxData[
  RowBox[{"\"\<JX\>\"", "[", "j", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a32aa26-3ac0-44d2-8ded-a54b6ea36898"],
 ", ",
 Cell[BoxData[
  RowBox[{"\"\<JY\>\"", "[", "j", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc31279d-8997-4c4c-8bd6-e42d9085f637"],
 ", ",
 Cell[BoxData[
  RowBox[{"\"\<JZ\>\"", "[", "j", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "288ab7be-2b62-4e32-9acd-cb1b41b8e89c"],
 " carry the same algebra; ",
 Cell[BoxData["Commutator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e84dfd1d-4e0b-4739-9a6b-e73ab85c370a"],
 " and the product ",
 Cell[BoxData["@"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0559255d-929d-4759-a3b2-141017e2a273"],
 " reconcile their eigenbases:"
}], "Text",ExpressionUUID->"c7a475ab-b684-4f92-a132-8cf1365b325b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"jq", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"#", "[", "j", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<JX\>\"", ",", " ", "\"\<JY\>\"", ",", " ", "\"\<JZ\>\""}], 
     "}"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"2a3b140c-c42b-49be-b774-96d843466b97"],

Cell[BoxData[
 RowBox[{"And", " ", "@@", " ", 
  RowBox[{"Flatten", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Commutator", "[", 
       RowBox[{
        RowBox[{"jq", "[", 
         RowBox[{"[", "a", "]"}], "]"}], ",", " ", 
        RowBox[{"jq", "[", 
         RowBox[{"[", "b", "]"}], "]"}]}], "]"}], " ", "==", " ", 
      RowBox[{"I", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"LeviCivitaTensor", "[", "3", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], "]"}], " ", 
          RowBox[{"jq", "[", 
           RowBox[{"[", "c", "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"c", ",", " ", "3"}], "}"}]}], "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "3"}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"1ce020e3-0a6f-462c-bba5-4b04ac4298eb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"jq", "[", 
     RowBox[{"[", "1", "]"}], "]"}], " ", "@", " ", 
    RowBox[{"jq", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
   RowBox[{
    RowBox[{"jq", "[", 
     RowBox[{"[", "2", "]"}], "]"}], " ", "@", " ", 
    RowBox[{"jq", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}], " ", "+", " ", 
   RowBox[{
    RowBox[{"jq", "[", 
     RowBox[{"[", "3", "]"}], "]"}], " ", "@", " ", 
    RowBox[{"jq", "[", 
     RowBox[{"[", "3", "]"}], "]"}]}]}], " ", "==", " ", 
  RowBox[{"j", " ", 
   RowBox[{"(", 
    RowBox[{"j", " ", "+", " ", "1"}], ")"}], " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"IdentityMatrix", "[", 
     RowBox[{
      RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}], "]"}], 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"46e379d3-34eb-4be7-9abb-19e13f57f425"],

Cell[TextData[{
 "Every route returns True: the spin-1 operators close under ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["a", "TI"]], ",", 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["b", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], 
   SubscriptBox[
    StyleBox["\[CurlyEpsilon]", "TI"], 
    StyleBox[
     RowBox[{"a", "b", "c"}], "TI"]], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c59fcb11-2098-4011-b9a1-b5bd7fa358a9"],
 " with Casimir ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["j", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1083c0e-4c6a-4a28-a548-638f2b54e587"],
 ", whether built from the ladder recursion, from the Clebsch-Gordan matrix \
elements of the spherical tensor ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["J", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb3ede0d-8ccd-434d-a1fe-bc6056af83ba"],
 ", or as the framework's named operators. Any spin ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0e7c8d2-513b-4408-8027-4bcabebf5298"],
 " follows by changing the one number."
}], "Text",ExpressionUUID->"4dfb2bdf-d83f-4e78-a2d2-3915b5cedc95"],

Cell["\<\
8.3 [BSc] How do I rotate a spin state and read the rotation off the \
expectation values?\
\>", "Subsection",ExpressionUUID->"0301a37e-d179-4a60-9631-d474940782e0"],

Cell[TextData[{
 "A rotation of a spin-",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dab160f8-6877-48f6-82f5-e1caa934d299"],
 " acts by ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    OverscriptBox[
     StyleBox["n", "TI"], "^"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Beta]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Beta]", "TI"], " ", 
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "\[CenterDot]", 
     OverscriptBox[
      StyleBox["J", "TI"], "\[RightVector]"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80027391-2816-4711-8284-e2e4bc49fe7a"],
 ". Rotating the highest-weight state ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["j", "TI"], ",", 
      StyleBox["j", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68ee470b-3396-40a6-8478-6907bc30713b"],
 " (which points along ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "970b7253-8bd1-49a1-9f53-238842195a0e"],
 ") about ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "920f7261-c966-438b-9edb-6b175885d405"],
 " by ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34107be2-8e7a-46c8-af5f-2726f31164f9"],
 " tilts it into the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c113f3cb-ffdf-4707-be30-356899040fcc"],
 "-",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "997a2c3e-9956-4b68-b4c9-282a90e039b5"],
 " plane, so the expectation vector becomes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["J", "TI"], "\[RightVector]"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["j", "TI"], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Beta]", "TI"]}], ",", "0", ",", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Beta]", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f04d37b-2e9d-4a23-91ab-bf428f8e9390"],
 ". Show it for spin ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1d4b5b8-49a4-4cbf-8939-1f53e937ac6a"],
 "."
}], "Text",ExpressionUUID->"8ebff2d2-b587-4a9a-aaf4-a672a08a140a"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : build the spin-1 operators:"
}], "Text",ExpressionUUID->"4eda527b-8cce-4fb4-97f3-636528f6395b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"j", " ", "=", " ", "1"}], ";", " ", 
  RowBox[{"m", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"j", ",", " ", 
     RowBox[{"-", "j"}], ",", " ", 
     RowBox[{"-", "1"}]}], "]"}]}], ";", " ", 
  RowBox[{"jp", " ", "=", " ", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r_", ",", " ", "c_"}], "}"}], " ", "/;", " ", 
       RowBox[{"r", " ", "==", " ", 
        RowBox[{"c", " ", "-", " ", "1"}]}]}], " ", ":>", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"j", " ", 
         RowBox[{"(", 
          RowBox[{"j", " ", "+", " ", "1"}], ")"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"m", "[", 
          RowBox[{"[", "c", "]"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"m", "[", 
            RowBox[{"[", "c", "]"}], "]"}], " ", "+", " ", "1"}], ")"}]}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}], ",", " ", 
       RowBox[{
        RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}]}], "}"}]}], "]"}]}], ";",
   " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"jx", ",", " ", "jy", ",", " ", "jz"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"jp", " ", "+", " ", 
        RowBox[{"Transpose", "[", "jp", "]"}]}], ")"}], "/", "2"}], ",", " ", 
     
     RowBox[{
      RowBox[{"(", 
       RowBox[{"jp", " ", "-", " ", 
        RowBox[{"Transpose", "[", "jp", "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "I"}], ")"}]}], ",", " ", 
     RowBox[{"DiagonalMatrix", "[", "m", "]"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"935ccfa1-39d6-4978-9811-3ffc4af4f024"],

Cell[TextData[{
 "Rotate the top state ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"1,1"},
    "Ket"], "=", "{", "1", ",", "0", ",", "0", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e4f9a17-2dea-4c2d-bc37-87d071974bea"],
 " about ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ab85cec-0552-4e56-8f7c-fc4155f08137"],
 " by ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12348a71-203a-4a33-a90e-6a1850846620"],
 ":"
}], "Text",ExpressionUUID->"dfde6f22-5b85-4fb0-b82a-eeb4ec1b9f9b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]", " ", "=", " ", 
   RowBox[{
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "\[Beta]", " ", "jy"}], "]"}], " ", ".", " ", 
    RowBox[{"UnitVector", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}], ",", " ", "1"}], 
     "]"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"73eba40d-7df3-44ad-9cb4-28d00a5a3867"],

Cell[TextData[{
 "and read the three expectations ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Bra"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["k", "TI"]], 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e22e6f20-a047-4f11-be71-ad3e7b0fa26a"],
 ":"
}], "Text",ExpressionUUID->"e5a1b21a-a79f-42bd-acac-eab22d214d44"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"ComplexExpand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", "\[Psi]", "]"}], " ", ".", " ", "#", " ", ".",
        " ", "\[Psi]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"jx", ",", " ", "jy", ",", " ", "jz"}], "}"}]}], "]"}], ",", 
   " ", 
   RowBox[{"\[Beta]", " ", "\[Element]", " ", "Reals"}]}], "]"}]], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"03be67d1-f5de-4cf1-aa0b-dd78b8759320"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : rotate with the framework's own operator, the exponential of the named \
",
 Cell[BoxData[
  RowBox[{"\"\<JY\>\"", "[", "j", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f0770b1-5577-4803-97b2-b6d953445752"],
 " acting on the top state ",
 Cell[BoxData[
