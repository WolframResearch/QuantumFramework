   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18858b00-fa84-4c70-a4b0-17c43e8abd16"],
 ", then read the expectations from the named operators:"
}], "Text",ExpressionUUID->"db33bfe1-979d-4ea6-a52c-8bdf782857d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]q", " ", "=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "\[Beta]", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"\"\<JY\>\"", "[", "j", "]"}], "]"}]}], "]"}], "[", 
    RowBox[{"QuantumState", "[", 
     RowBox[{"\"\<0\>\"", ",", " ", 
      RowBox[{
       RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"f9cfbe9e-0817-4163-a4a6-ece102470e4a"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Psi]q", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
         RowBox[{
          RowBox[{"QuantumOperator", "[", 
           RowBox[{"op", "[", "j", "]"}], "]"}], " ", "@", " ", "\[Psi]q"}]}],
         ")"}], "[", "\"\<Scalar\>\"", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"op", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<JX\>\"", ",", " ", "\"\<JY\>\"", ",", 
          " ", "\"\<JZ\>\""}], "}"}]}], "}"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"\[Beta]", " ", "\[Element]", " ", "Reals"}]}], "]"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"d0db5531-6b4f-47c9-a913-967a659f0125"],

Cell[TextData[{
 "Both return ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["J", "TI"], "\[RightVector]"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Beta]", "TI"]}], ",", "0", ",", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Beta]", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28497024-0937-4258-97e5-5eec57dfce6a"],
 ": the quantum expectation vector rotates exactly as a classical arrow \
would, the content of the vector (adjoint) representation of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c012c43-055e-4e4b-8c23-efecd33ca3bb"],
 " on angular momentum."
}], "Text",ExpressionUUID->"97069d15-01eb-41f3-a7e0-c6517dacdb37"],

Cell[TextData[{
 "8.4 [MSc] How do I construct the Wigner ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "906c734b-4684-4f00-927d-1210119d8c7e"],
 "-matrix element ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     StyleBox["D", "TI"], 
     RowBox[{
      SuperscriptBox[
       StyleBox["m", "TI"], "\[Prime]"], 
      StyleBox["m", "TI"]}], 
     StyleBox["j", "TI"]], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["\[Alpha]", "TI"], ",", 
      StyleBox["\[Beta]", "TI"], ",", 
      StyleBox["\[Gamma]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["j", "TI"], 
        SuperscriptBox[
         StyleBox["m", "TI"], "\[Prime]"]}]},
     "Bra"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[Alpha]", "TI"], 
      SubscriptBox[
       StyleBox["J", "TI"], 
       StyleBox["z", "TI"]]}]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[Beta]", "TI"], 
      SubscriptBox[
       StyleBox["J", "TI"], 
       StyleBox["y", "TI"]]}]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[Gamma]", "TI"], 
      SubscriptBox[
       StyleBox["J", "TI"], 
       StyleBox["z", "TI"]]}]], 
    TemplateBox[{
      RowBox[{
        StyleBox["j", "TI"], 
        StyleBox["m", "TI"]}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d57a0d0d-f2ff-479a-9e6f-45db8fb06977"],
 " for a spin-",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66d1b83d-868b-4461-bc6c-210f1c02bb61"],
 " rotation?"
}], "Subsection",ExpressionUUID->"36d420d7-fc38-4e3a-b03f-e51038a06189"],

Cell[TextData[{
 "The Wigner ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55dd77b2-6bff-47fd-9980-40b5d421bc43"],
 "-matrix is the spin-",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8c1e185-4045-4fb7-acd9-3b632d99752a"],
 " representation of a rotation parametrized by Euler angles: the matrix of \
the abstract rotation once we choose the ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["j", "TI"], ",", 
      StyleBox["m", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b91fb44-5e32-41a0-b055-d74e2745918a"],
 " basis. Build it for spin ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35212af4-b2c6-4b64-98af-88a7272d5203"],
 " from the ladder operators and match it to the built-in ",
 Cell[BoxData["WignerD"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d5b97410-64f3-4b67-bd0a-614d8e44ae0e"],
 "."
}], "Text",ExpressionUUID->"b4ff8a2e-5621-47d7-a69d-fe5608e184c3"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : build ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["y", "TI"]], ",", 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9c73f98-50ba-40b1-8d1b-08015a5404fe"],
 ":"
}], "Text",ExpressionUUID->"68f07cd1-d805-4597-a577-cf5ba99e403c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"j", " ", "=", " ", "1"}], ";", " ", 
  RowBox[{"m", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"j", ",", " ", 
     RowBox[{"-", "j"}], ",", " ", 
     RowBox[{"-", "1"}]}], "]"}]}], ";", " ", 
  RowBox[{"jp", " ", "=", " ", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r_", ",", " ", "c_"}], "}"}], " ", "/;", " ", 
       RowBox[{"r", " ", "==", " ", 
        RowBox[{"c", " ", "-", " ", "1"}]}]}], " ", ":>", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"j", " ", 
         RowBox[{"(", 
          RowBox[{"j", " ", "+", " ", "1"}], ")"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"m", "[", 
          RowBox[{"[", "c", "]"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"m", "[", 
            RowBox[{"[", "c", "]"}], "]"}], " ", "+", " ", "1"}], ")"}]}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}], ",", " ", 
       RowBox[{
        RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}]}], "}"}]}], "]"}]}], ";",
   " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"jy", ",", " ", "jz"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"jp", " ", "-", " ", 
        RowBox[{"Transpose", "[", "jp", "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "I"}], ")"}]}], ",", " ", 
     RowBox[{"DiagonalMatrix", "[", "m", "]"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"f51ffd2b-3fab-4427-ab9e-f350f46a5266"],

Cell[TextData[{
 "Assemble the Euler rotation ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Alpha]", "TI"], 
     SubscriptBox[
      StyleBox["J", "TI"], 
      StyleBox["z", "TI"]]}]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Beta]", "TI"], 
     SubscriptBox[
      StyleBox["J", "TI"], 
      StyleBox["y", "TI"]]}]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Gamma]", "TI"], 
     SubscriptBox[
      StyleBox["J", "TI"], 
      StyleBox["z", "TI"]]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a11bb0df-1720-4402-a4b7-7f4cbd6196e7"],
 ":"
}], "Text",ExpressionUUID->"8b5d2fcb-dd4d-47ad-80e0-5d00d13c4060"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dmat", " ", "=", " ", 
   RowBox[{
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "\[Alpha]", " ", "jz"}], "]"}], " ", ".", " ", 
    
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "\[Beta]", " ", "jy"}], "]"}], " ", ".", " ", 
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "\[Gamma]", " ", "jz"}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"7737508d-73b3-4f6c-a6b8-269e0f7e2df7"],

Cell[TextData[{
 "Compare it entry by entry to the built-in ",
 Cell[BoxData["WignerD"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6f18ca0-1272-4f41-942f-07048f09e8a6"],
 " (index order ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["j", "TI"]}], ",", 
   SuperscriptBox[
    StyleBox["m", "TI"], "\[Prime]"], ",", 
   RowBox[{
    StyleBox["m", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61631b91-305a-498f-98a5-58de838a4dee"],
 "). The built-in uses the opposite (active, ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"+", 
    StyleBox["i", "TI"], 
    StyleBox["J", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88d9dce1-87da-454c-a81d-77bd8f0ec8cf"],
 ") convention, so its Euler angles are negated relative to the passive ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["J", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7c6b299-adfe-4956-8aa4-d2536097df5f"],
 " formula:"
}], "Text",ExpressionUUID->"23fc6c55-c162-4fb2-97c0-35fec32f7c22"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dmat", " ", "==", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"WignerD", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "mp", ",", " ", "mm"}], "}"}], ",", " ", 
       RowBox[{"-", "\[Alpha]"}], ",", " ", 
       RowBox[{"-", "\[Beta]"}], ",", " ", 
       RowBox[{"-", "\[Gamma]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"mp", ",", " ", "j", ",", " ", 
       RowBox[{"-", "j"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"mm", ",", " ", "j", ",", " ", 
       RowBox[{"-", "j"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], " ", "//", " ", 
  "Simplify"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"2e714ee1-ef5f-482f-8e61-87dfd0ead246"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : assemble the same rotation as a product of ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05be5b41-6e89-4e21-a1fa-04b334f7da04"],
 " exponentials:"
}], "Text",ExpressionUUID->"459896b1-9c16-4c04-8541-1927be8f6705"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dq", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", "\[Alpha]", " ", "jz"}], "]"}], "]"}], " ", "@",
     " ", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "\[Beta]", " ", "jy"}], "]"}], "]"}], " ", "@",
      " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "\[Gamma]", " ", "jz"}], "]"}], "]"}]}]}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"241394d7-639e-47db-9fe3-e3a571dafd15"],

Cell[TextData[{
 "QuantumFramework carries the ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8687c190-c203-4591-bdd7-40c8dbcf589c"],
 "-matrix as the named operator ",
 Cell[BoxData["\"\<WignerD\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f54ee889-d97d-4156-8103-7f45ae46e7f5"],
 ", taking the spin and the three Euler angles as a list, so the check is a \
direct operator equality (the framework reconciles the index orderings \
itself):"
}], "Text",ExpressionUUID->"f8f15474-4e97-4aeb-9ce1-ec2fb1d97cee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dq", " ", "==", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<WignerD\>\"", "[", 
     RowBox[{"j", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", " ", "\[Beta]", ",", " ", "\[Gamma]"}], 
       "}"}]}], "]"}], "]"}]}], " ", "//", " ", "Simplify"}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"110189d1-b63e-4ff2-bad2-060256265318"],

Cell[TextData[{
 "Both confirm the constructed rotation is the Wigner ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9987c9f8-0877-4525-9c2d-19f1d4a53df3"],
 "-matrix: the WL side matches the built-in ",
 Cell[BoxData["WignerD"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff7c35bd-c68b-4c11-88a9-d9ec6a86270b"],
 " table, the QF side equals the framework's named ",
 Cell[BoxData["\"\<WignerD\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0ad9a46-e381-4f4a-9827-14a05d39a6f7"],
 " operator. The ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5e29e9b-e2b7-4567-ac9f-2881661327f9"],
 "-matrix is nothing more than the explicit representation of the abstract \
rotation on the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["j", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f20a5f4-7485-4ae0-b0d7-9f4929fbe5a4"],
 "-dimensional spin space."
}], "Text",ExpressionUUID->"97bfd5a3-9716-4a0d-80e9-38947b0379cb"],

Cell["\<\
8.5 [MSc] How do I add two spin-1/2 and read off the full table of \
Clebsch-Gordan coefficients (the change of basis to the total-spin basis)?\
\>", "Subsection",ExpressionUUID->"3a73a318-f556-41c6-8d2d-0d34a960702f"],

Cell[TextData[{
 "Coupling two spins combines their spaces, ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], "\[CircleTimes]", 
   FractionBox["1", "2"], "=", "0", "\[CirclePlus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff492cfe-01cb-477f-9c1d-6f66b77eb7fa"],
 ": the product basis ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       SubscriptBox[
        StyleBox["j", "TI"], "1"], 
       SubscriptBox[
        StyleBox["m", "TI"], "1"]}]},
    "Ket"], 
   TemplateBox[{
     RowBox[{
       SubscriptBox[
        StyleBox["j", "TI"], "2"], 
       SubscriptBox[
        StyleBox["m", "TI"], "2"]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ede480f-e870-4058-a1c1-7566ede3f623"],
 " recombines into total-spin eigenstates ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["J", "TI"], ",", 
      StyleBox["M", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4e6210b-8cc3-488f-9f02-fc2325dd222a"],
 ", tied together by one closed-form expansion,"
}], "Text",ExpressionUUID->"1c359cd0-5599-45aa-b097-3e2843b070e0"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["J", "TI"], ",", 
        StyleBox["M", "TI"]}]},
     "Ket"], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       SubscriptBox[
        StyleBox["m", "TI"], "1"], "+", 
       SubscriptBox[
        StyleBox["m", "TI"], "2"], "=", 
       StyleBox["M", "TI"]}],
      LimitsPositioning->False], 
     RowBox[{
      TemplateBox[{
        RowBox[{
          SubscriptBox[
           StyleBox["j", "TI"], "1"], 
          SubscriptBox[
           StyleBox["m", "TI"], "1"], ";", 
          SubscriptBox[
           StyleBox["j", "TI"], "2"], 
          SubscriptBox[
           StyleBox["m", "TI"], "2"]}], 
        RowBox[{
          StyleBox["J", "TI"], 
          StyleBox["M", "TI"]}]},
       "BraKet"], 
      TemplateBox[{
        RowBox[{
          SubscriptBox[
           StyleBox["j", "TI"], "1"], 
          SubscriptBox[
           StyleBox["m", "TI"], "1"]}]},
       "Ket"], 
      TemplateBox[{
        RowBox[{
          SubscriptBox[
           StyleBox["j", "TI"], "2"], 
          SubscriptBox[
           StyleBox["m", "TI"], "2"]}]},
       "Ket"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"72014840-e563-4890-\
a132-3a84f1163a50"],

Cell[TextData[{
 "whose coefficients are the Clebsch-Gordan coefficients. The sum runs only \
over ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["m", "TI"], "1"], "+", 
   SubscriptBox[
    StyleBox["m", "TI"], "2"], "=", 
   StyleBox["M", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08bcf999-b62f-4273-8b0d-f23cfa93d933"],
 " (the total ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cf7e7b6-2a40-4340-8017-41b775df4661"],
 " is conserved), and they vanish unless ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      RowBox[{
       SubscriptBox[
        StyleBox["j", "TI"], "1"], "-", 
       SubscriptBox[
        StyleBox["j", "TI"], "2"]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", 
   StyleBox["J", "TI"], "\[LessEqual]", 
   SubscriptBox[
    StyleBox["j", "TI"], "1"], "+", 
   SubscriptBox[
    StyleBox["j", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e222e115-247d-4523-a802-3d6f2bd40091"],
 " (the triangle rule). The full table of overlaps ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      SubscriptBox[
       StyleBox["j", "TI"], "1"], 
      SubscriptBox[
       StyleBox["m", "TI"], "1"], ";", 
      SubscriptBox[
       StyleBox["j", "TI"], "2"], 
      SubscriptBox[
       StyleBox["m", "TI"], "2"]}], 
    RowBox[{
      StyleBox["J", "TI"], ",", 
      StyleBox["M", "TI"]}]},
   "BraKet"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72fc1bbb-9044-423a-8226-dc018fa8cae7"],
 " ",
 StyleBox["is", "TI"],
 " the change-of-basis matrix."
}], "Text",ExpressionUUID->"3f574f32-f41d-4b8b-9bb2-6edb178d4ab5"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the product basis is every pair of single-spin projections ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["i", "TI"]], "\[Element]", "{", "+", 
    FractionBox["1", "2"]}], ",", 
   RowBox[{"-", 
    FractionBox["1", "2"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3733747-2f6d-4af9-be81-83ff15166583"],
 " (descending, matching the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40cb2d50-a3f8-4b26-bbb5-084106979dde"],
 " convention); the coupled states run over ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49c7b0c3-627e-4de9-8642-c96ee6e28104"],
 " from ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["j", "TI"], "1"], "+", 
   SubscriptBox[
    StyleBox["j", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "374658e5-558e-453d-8622-5c5b12448048"],
 " down to ",
 Cell[BoxData[GridBox[{
    {
     RowBox[{
      SubscriptBox[
       StyleBox["j", "TI"], "1"], "-", 
      SubscriptBox[
       StyleBox["j", "TI"], "2"]}]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca05c24a-a308-4eba-a2f9-592d99ff4eb1"],
 " and ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "846b29d2-9a2d-4620-ae94-8935a1a31c08"],
 " from ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17668552-8798-46b4-b1fb-713c8273afa6"],
 " to ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1b1061a-58a6-44cb-9867-a80bd392fe86"],
 ":"
}], "Text",ExpressionUUID->"188d17e9-31a5-4e51-8660-76306dc26a01"],

Cell[BoxData[
 RowBox[{
  RowBox[{"prodBasis", " ", "=", " ", 
   RowBox[{"Tuples", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}], ",", " ", 
       RowBox[{"-", "1"}]}], "]"}], ",", " ", "2"}], "]"}]}], ";", " ", 
  RowBox[{"coupled", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"J", ",", " ", "M"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"J", ",", " ", "1", ",", " ", "0", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"M", ",", " ", "J", ",", " ", 
         RowBox[{"-", "J"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", " ", "1"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"f7453d7f-81c1-43d2-b028-cd719db47ac0"],

Cell[TextData[{
 "Each entry is ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      SubscriptBox[
       StyleBox["j", "TI"], "1"], 
      SubscriptBox[
       StyleBox["m", "TI"], "1"], ";", 
      SubscriptBox[
       StyleBox["j", "TI"], "2"], 
      SubscriptBox[
       StyleBox["m", "TI"], "2"]}], 
    RowBox[{
      StyleBox["J", "TI"], ",", 
      StyleBox["M", "TI"]}]},
   "BraKet"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fa7f4b5-619e-45e9-b09d-7cc1d31af2b0"],
 " from the built-in ",
 Cell[BoxData["ClebschGordan"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81996f64-8b5f-4a2e-a908-afba97b0ce02"],
 ", nonzero only when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], "=", 
   SubscriptBox[
    StyleBox["m", "TI"], "1"], "+", 
   SubscriptBox[
    StyleBox["m", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cde5d172-5d42-42a3-8bb6-8a29f1ebb671"],
 ":"
}], "Text",ExpressionUUID->"4b4457e3-dba3-44ee-ac1f-ee6d88402c03"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cg", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#2", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
          RowBox[{"#2", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], " ", "==", " ", 
         RowBox[{"#1", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
        RowBox[{"ClebschGordan", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "/", "2"}], ",", " ", 
            RowBox[{"#2", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "/", "2"}], ",", " ", 
            RowBox[{"#2", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", "#1"}], "]"}],
         ",", " ", "0"}], "]"}], " ", "&"}], ",", " ", "coupled", ",", " ", 
     "prodBasis", ",", " ", "1"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"f1bd2c7e-63d4-459d-945c-02d866ea1731"],

Cell[TextData[{
 "Read the full table with its ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["J", "TI"], ",", 
    StyleBox["M", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c6fa0f7-2867-42ce-89a3-8a78de9e228e"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["m", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3a99601-db84-4652-b00c-ebf9d97f72e1"],
 " labels:"
}], "Text",ExpressionUUID->"cdca08d0-c810-46e8-89a4-82a1cbcb6fae"],

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{"cg", ",", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"coupled", ",", " ", "prodBasis"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[27]:= ",ExpressionUUID->"ce571145-7327-44e9-b2d5-ff8a68bd8991"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same coupling built genuinely as operators. Each total-spin \
component adds a named Pauli on qubit 1 and qubit 2 (the order argument \
places each), scaled by ",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16166be9-541a-4073-b055-167164dd0a52"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["S", "TI"], "\[RightVector]"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "1"], "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17456dfb-7653-4d9d-a3cb-e0118ded3e63"],
 ":"
}], "Text",ExpressionUUID->"32498e88-3a29-4f21-bf6e-19bfcf6d08ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sq", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"p", ",", " ", 
          RowBox[{"{", "1", "}"}]}], "]"}], " ", "+", " ", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"p", ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\""}], 
        "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"ace5c1fa-e379-4604-90c1-f870348389c9"],

Cell[TextData[{
 "The Casimir ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["S", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27c04acd-cb60-433a-9872-4455135d30a7"],
 " is the sum of their squares (",
 Cell[BoxData["@"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fcbdb21-5df8-4b82-b4da-3edeae7347d2"],
 "):"
}], "Text",ExpressionUUID->"7159dca0-907f-4fb5-8288-2ce5a89d2892"],

Cell[BoxData[
 RowBox[{
  RowBox[{"S2", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sq", "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", "@", " ", 
     RowBox[{"Sq", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"Sq", "[", 
      RowBox[{"[", "2", "]"}], "]"}], " ", "@", " ", 
     RowBox[{"Sq", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"Sq", "[", 
      RowBox[{"[", "3", "]"}], "]"}], " ", "@", " ", 
     RowBox[{"Sq", "[", 
      RowBox[{"[", "3", "]"}], "]"}]}]}]}], ";"}]], "Input",
 CellLabel->
  "In[29]:= ",ExpressionUUID->"5cbcaa5d-63b9-49a4-9136-0cb2481d085a"],

Cell[TextData[{
 "Its spectrum is the coupling ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], "\[CircleTimes]", 
   FractionBox["1", "2"], "=", "0", "\[CirclePlus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe898208-2e7b-418a-9bd3-6856740ff6dd"],
 " directly, one singlet (",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["S", "TI"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21b54533-9523-44bf-9025-eee3b065768d"],
 ") and a threefold triplet (",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["S", "TI"], "2"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f41fc46-4b29-4cf7-bd9f-fcc3cb91b1aa"],
 "):"
}], "Text",ExpressionUUID->"e29bbd65-5420-4ab0-a9e3-539571ec76fc"],

Cell[BoxData[
 RowBox[{"Sort", "[", 
  RowBox[{"S2", "[", "\"\<Eigenvalues\>\"", "]"}], "]"}]], "Input",
 CellLabel->
  "In[30]:= ",ExpressionUUID->"a85c8660-8727-4d8d-b432-80045c5ef73c"],

Cell[TextData[{
 "The Clebsch-Gordan table is exactly the basis that diagonalizes this total \
spin. Take it as a change-of-basis ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c7db8c6-732f-43bf-a219-dbdd237de763"],
 " ",
 Cell[BoxData["w"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27a76caa-845f-4338-90dc-34f2cc28f3fd"],
 " on the two qubits:"
}], "Text",ExpressionUUID->"44e74e2c-5b68-42ea-a376-1a161af34b09"],

Cell[BoxData[
 RowBox[{
  RowBox[{"w", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"cg", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[31]:= ",ExpressionUUID->"d4671835-fbf0-40e8-ae05-17b45a654d9f"],

Cell[TextData[{
 "Conjugating ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["S", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3d891d9-4788-4289-8347-ab8c6e942416"],
 " by ",
 Cell[BoxData["w"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341d2a46-de10-4096-965f-c775db9ca10b"],
 " gives a diagonal reading ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["S", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6545641-518f-44e7-942d-a66dc44685cf"],
 " for each coupled state:"
}], "Text",ExpressionUUID->"e0ad3aff-971e-46b0-b6ad-8d982c70e42d"],

Cell[BoxData[
 RowBox[{"MatrixForm", "[", 
  RowBox[{"Simplify", "@", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"w", " ", "@", " ", 
       RowBox[{"S2", " ", "@", " ", 
        RowBox[{"w", "[", "\"\<Dagger\>\"", "]"}]}]}], ")"}], 
     "[", "\"\<Matrix\>\"", "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[32]:= ",ExpressionUUID->"3b788cae-e7f7-4822-9cc7-dab559e1235a"],

Cell[TextData[{
 "The table is the unitary change of basis from the product basis to the \
total-spin basis, and conjugating ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["S", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb75ca7a-5adc-4835-a4fa-0aa07e7f9ed3"],
 " by it labels every coupled state by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["S", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8782993-8566-4df1-ad68-ec504bd99849"],
 ". The Clebsch-Gordan coefficients are the entries of the matrix that adds \
the two spins."
}], "Text",ExpressionUUID->"0322cc3a-40a8-44c5-a5a1-0c31713283d4"],

Cell["\<\
8.6 [MSc] How do I build the singlet and triplet states and identify them by \
total spin?\
\>", "Subsection",ExpressionUUID->"32b35963-1444-4612-a000-534289ff0a7a"],

Cell[TextData[{
 "Two spin-1/2 combine into one singlet (",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88c7d007-b476-41c1-b02a-eae1ad6aba9e"],
 ", antisymmetric) and three triplet states (",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3deb5313-6fc4-4423-a7ec-b866a75c4e75"],
 ", symmetric), told apart by the total-spin Casimir ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["S", "TI"], "2"], "=", 
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["S", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee1e9361-2add-4a46-84d3-1d2863211136"],
 ": ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52705912-79cc-4a57-9d02-8b993fb64835"],
 " for the singlet, ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2680adb1-a7aa-4714-b3e2-4885115f2fd8"],
 " for the triplet. Build all four from the total-spin operators and identify \
each by its ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["S", "TI"], ",", 
    StyleBox["M", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3f9e19a-b9bc-4251-9c4d-f5b1dfac14a6"],
 "."
}], "Text",ExpressionUUID->"434b304e-5b2f-490e-a6b7-258e9132e32e"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : form the total spin ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["S", "TI"], "\[RightVector]"], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "\[RightVector]"], "1"], "+", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "\[RightVector]"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b3d46ec-245b-42c6-9e35-b322756d6bc3"],
 ", then the triplet is the top state ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"\[UpArrow]", "\[UpArrow]"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83298f10-4e86-457f-84d7-8059409ade6e"],
 " lowered twice by ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["S", "TI"], "-"], "=", 
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["x", "TI"]], "-", 
   StyleBox["i", "TI"], 
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b739850c-c569-4ebd-9403-ac03a260d948"],
 ", and the singlet is the one state the ladder misses, the null space of ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["S", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76bc19d0-9536-420d-b9a6-42a13412898b"],
 ":"
}], "Text",ExpressionUUID->"ca7141d5-e107-47d0-ac11-7ac95509e1f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sk", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"PauliMatrix", "[", "k", "]"}], "/", "2"}], ",", " ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], " ", "+", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "k", "]"}], "/", "2"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"s2", " ", "=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", ".", "#"}], " ", "&"}], " ", "/@", " ", "sk"}], "]"}]}], ";",
   " ", 
  RowBox[{"sMinus", " ", "=", " ", 
   RowBox[{
    RowBox[{"sk", "[", 
     RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
    RowBox[{"I", " ", 
     RowBox[{"sk", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}]}]}], ";"}]], "Input",
 CellLabel->
  "In[33]:= ",ExpressionUUID->"c018c3fc-0cc8-4a58-a17a-d9429efdff69"],

Cell[BoxData[
 RowBox[{"states", " ", "=", " ", 
  RowBox[{"Append", "[", 
   RowBox[{
    RowBox[{"NestList", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Normalize", "[", 
        RowBox[{"sMinus", " ", ".", " ", "#"}], "]"}], " ", "&"}], ",", " ", 
      RowBox[{"UnitVector", "[", 
       RowBox[{"4", ",", " ", "1"}], "]"}], ",", " ", "2"}], "]"}], ",", " ", 
    
    RowBox[{"Normalize", "[", 
     RowBox[{"First", "[", 
      RowBox[{"NullSpace", "[", "s2", "]"}], "]"}], "]"}]}], "]"}]}]], "Input",\

 CellLabel->
  "In[34]:= ",ExpressionUUID->"a0d84d3c-3d6c-40bd-8f13-9c96c79d334c"],

Cell[TextData[{
 "Each state's total-spin quantum numbers are its Casimir and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "168e5037-9aeb-48bf-8875-f6f1ecf41529"],
 " expectations, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SuperscriptBox[
      StyleBox["S", "TI"], "2"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["S", "TI"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["S", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["S", "TI"], "+", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}], ",", 
    StyleBox["M", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1332d737-7544-4ab2-bf09-92fbba92dca1"],
 ":"
}], "Text",ExpressionUUID->"7bf7a621-69c0-4393-949e-dc107ac1e8e3"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "s2", " ", ".", 
       " ", "#"}], ",", " ", 
      RowBox[{
       RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", 
       RowBox[{"sk", "[", 
        RowBox[{"[", "3", "]"}], "]"}], " ", ".", " ", "#"}]}], "}"}], " ", 
    "&"}], " ", "/@", " ", "states"}], "]"}]], "Input",
 CellLabel->
  "In[35]:= ",ExpressionUUID->"865af403-7965-4390-9c16-db89bb15a91b"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : build the total spin genuinely from named Paulis, its components and \
Casimir:"
}], "Text",ExpressionUUID->"785ad7d3-ac83-4a2a-81dd-8e500a609a2b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sq", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"p", ",", " ", 
          RowBox[{"{", "1", "}"}]}], "]"}], " ", "+", " ", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"p", ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\""}], 
        "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[36]:= ",ExpressionUUID->"4708794c-e90e-41ea-b132-2081695b960f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"S2q", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sq", "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", "@", " ", 
     RowBox[{"Sq", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"Sq", "[", 
      RowBox[{"[", "2", "]"}], "]"}], " ", "@", " ", 
     RowBox[{"Sq", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"Sq", "[", 
      RowBox[{"[", "3", "]"}], "]"}], " ", "@", " ", 
     RowBox[{"Sq", "[", 
      RowBox[{"[", "3", "]"}], "]"}]}]}]}], ";"}]], "Input",
 CellLabel->
  "In[37]:= ",ExpressionUUID->"eaaca1ae-c559-4597-b787-7f0d55e09b28"],

Cell[TextData[{
 "Wrap the same four states as ",
 Cell[BoxData["QuantumState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de3e1a4e-fb89-41c7-9e16-87608632c7e1"],
 "s and read each ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SuperscriptBox[
      StyleBox["S", "TI"], "2"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["S", "TI"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f95c4223-dc33-46db-95b3-65e075b827fd"],
 " from the operators:"
}], "Text",ExpressionUUID->"385e7e91-1044-4ba8-8a0d-07422d949880"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
         RowBox[{"S2q", " ", "@", " ", "#"}]}], ")"}], "[", "\"\<Scalar\>\"", 
       "]"}], ",", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
         RowBox[{
          RowBox[{"Sq", "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", "@", " ", "#"}]}], ")"}], 
       "[", "\"\<Scalar\>\"", "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
   RowBox[{"(", 
    RowBox[{"QuantumState", " ", "/@", " ", "states"}], ")"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[38]:= ",ExpressionUUID->"266451d8-7a23-4be0-8cc6-793949361d8a"],

Cell[TextData[{
 "The three ladder states share ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["S", "TI"], "2"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6059c4b0-a824-47e1-9ae2-dec687ddd55b"],
 " (so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f221782-4b55-41e8-b5d4-04d63c272a26"],
 ") with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["M", "TI"], "=", "1"}], ",", "0", ",", 
   RowBox[{"-", "1"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f91b44f-9e4d-422c-bdd4-897a9dcafbff"],
 ", and the null-space state has ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["S", "TI"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb15f746-726f-4566-98ce-6e7ae99752a6"],
 " (so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "157c0236-92b2-4222-a5d1-7cd20607d230"],
 ") with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "299fda16-df4c-4672-a3ea-1d7492268d89"],
 ": singlet and triplet emerge from the construction already sorted by total \
spin, the ",
 Cell[BoxData[
  RowBox[{"1", "\[CirclePlus]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c557431b-f5e6-46ce-b325-cd59e26b99c9"],
 " multiplicity of ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], "\[CircleTimes]", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b73cc9f-9d7d-4260-aa3f-ca1ecc6f9659"],
 ". The singlet is fixed only up to an overall sign, as any state is up to a \
global phase. Total spin is the conserved label that block-diagonalizes any \
rotationally invariant two-spin interaction (Part 7, 7.10)."
}], "Text",ExpressionUUID->"39030071-3cbe-49db-b1f2-2cf54611f464"],

Cell["\<\
8.7 [MSc] How do I construct a spin coherent state and place it on the \
generalized Bloch sphere?\
\>", "Subsection",ExpressionUUID->"9cdbd75d-c8a7-4fed-a0c6-16b390afc1dd"],

Cell[TextData[{
 "A spin coherent state is the most classical state of a spin-",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81b08d5c-e5f7-492b-9b9d-0b33ae87a101"],
 ": the highest-weight state ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["j", "TI"], ",", 
      StyleBox["j", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "477cae35-76ce-4560-85eb-63080bf638b4"],
 " rotated to point along ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d67bf9c-ffc3-417f-8c6c-5d4ba78683f2"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["j", "TI"], ",", 
       OverscriptBox[
        StyleBox["n", "TI"], "^"]}]},
    "Ket"], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], "\[CurlyPhi]", 
      SubscriptBox[
       StyleBox["J", "TI"], 
       StyleBox["z", "TI"]]}]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[Theta]", "TI"], 
      SubscriptBox[
       StyleBox["J", "TI"], 
       StyleBox["y", "TI"]]}]], 
    TemplateBox[{
      RowBox[{
        StyleBox["j", "TI"], ",", 
        StyleBox["j", "TI"]}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77f81a07-eede-4f64-87cc-03a0b9c0b972"],
 ". Its expectation vector is fully polarized, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["J", "TI"], "\[RightVector]"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["j", "TI"], " ", 
   OverscriptBox[
    StyleBox["n", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b565ba7-443c-4c0f-9b0c-eba8ef03b4c2"],
 ", so it sits on the sphere of radius ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffdc89ba-17fb-4f38-a323-0244f670d232"],
 ", the generalized Bloch sphere. Build it for spin ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "598bfda3-d89d-4942-b371-a20a3795e0bd"],
 "."
}], "Text",ExpressionUUID->"823d167e-deec-4126-adf6-4d9da7951841"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : build the spin-1 operators:"
}], "Text",ExpressionUUID->"e6af9a0d-7e7e-4bac-8f3e-ce325e606763"],

Cell[BoxData[
 RowBox[{
  RowBox[{"j", " ", "=", " ", "1"}], ";", " ", 
  RowBox[{"m", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"j", ",", " ", 
     RowBox[{"-", "j"}], ",", " ", 
     RowBox[{"-", "1"}]}], "]"}]}], ";", " ", 
  RowBox[{"jp", " ", "=", " ", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r_", ",", " ", "c_"}], "}"}], " ", "/;", " ", 
       RowBox[{"r", " ", "==", " ", 
        RowBox[{"c", " ", "-", " ", "1"}]}]}], " ", ":>", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"j", " ", 
         RowBox[{"(", 
          RowBox[{"j", " ", "+", " ", "1"}], ")"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"m", "[", 
          RowBox[{"[", "c", "]"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"m", "[", 
            RowBox[{"[", "c", "]"}], "]"}], " ", "+", " ", "1"}], ")"}]}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}], ",", " ", 
       RowBox[{
        RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}]}], "}"}]}], "]"}]}], ";",
   " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"jx", ",", " ", "jy", ",", " ", "jz"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"jp", " ", "+", " ", 
        RowBox[{"Transpose", "[", "jp", "]"}]}], ")"}], "/", "2"}], ",", " ", 
     
     RowBox[{
      RowBox[{"(", 
       RowBox[{"jp", " ", "-", " ", 
        RowBox[{"Transpose", "[", "jp", "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "I"}], ")"}]}], ",", " ", 
     RowBox[{"DiagonalMatrix", "[", "m", "]"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->
  "In[39]:= ",ExpressionUUID->"f871f012-5aa9-4b20-8787-9ebe0d16572d"],

Cell[TextData[{
 "Rotate the highest-weight state to point along ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06121dfa-6c84-496e-b648-a9a747ea193f"],
 ":"
}], "Text",ExpressionUUID->"8c6399eb-798e-4616-88e6-a51ddf2e1e69"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coh", " ", "=", " ", 
   RowBox[{
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "\[Phi]", " ", "jz"}], "]"}], " ", ".", " ", 
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "\[Theta]", " ", "jy"}], "]"}], " ", ".", " ", 
    
    RowBox[{"UnitVector", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}], ",", " ", "1"}], 
     "]"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[40]:= ",ExpressionUUID->"11283f97-231d-425b-8d5a-073eabaa0016"],

Cell["and read its polarization, the three spin expectations:", "Text",ExpressionUUID->"789c65b1-54a9-4cc4-8f97-a85fb326a85c"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"ComplexExpand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", "coh", "]"}], " ", ".", " ", "#", " ", ".", 
       " ", "coh"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"jx", ",", " ", "jy", ",", " ", "jz"}], "}"}]}], "]"}], ",", 
   " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", " ", 
    "Reals"}]}], "]"}]], "Input",
 CellLabel->
  "In[41]:= ",ExpressionUUID->"0d951afd-c1ea-4de4-be63-386ad1d07b99"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : build the same coherent state with the framework's own rotations, \
exponentials of the named ",
 Cell[BoxData[
  RowBox[{"\"\<JZ\>\"", "[", "j", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "323f1903-5913-4198-8b49-71ff1c86db67"],
 " and ",
 Cell[BoxData[
  RowBox[{"\"\<JY\>\"", "[", "j", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d8b1f8b-08ff-42d5-8fb9-8ac818638b43"],
 " on the top state, and read its polarization from the named operators:"
}], "Text",ExpressionUUID->"30203a4c-2205-4cd4-9df6-989b0a3e61d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cohq", " ", "=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "\[Phi]", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"\"\<JZ\>\"", "[", "j", "]"}], "]"}]}], "]"}], "[", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", "\[Theta]", " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<JY\>\"", "[", "j", "]"}], "]"}]}], "]"}], "[", 
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<0\>\"", ",", " ", 
       RowBox[{
        RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}]}], "]"}], "]"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[42]:= ",ExpressionUUID->"575b5ddd-9e2a-4196-bb05-9dba39f19d5b"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"cohq", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
         RowBox[{
          RowBox[{"QuantumOperator", "[", 
           RowBox[{"op", "[", "j", "]"}], "]"}], " ", "@", " ", "cohq"}]}], 
        ")"}], "[", "\"\<Scalar\>\"", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"op", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<JX\>\"", ",", " ", "\"\<JY\>\"", ",", 
          " ", "\"\<JZ\>\""}], "}"}]}], "}"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", " ", 
    "Reals"}]}], "]"}]], "Input",
 CellLabel->
  "In[43]:= ",ExpressionUUID->"06df3000-e5cc-443f-a035-33399b28815e"],

Cell[TextData[{
 "Both give ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["J", "TI"], "\[RightVector]"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"], 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["j", "TI"], " ", 
   OverscriptBox[
    StyleBox["n", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "050a62b7-ab30-423b-8fe8-433423b79589"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03c65e1b-1d27-4503-8a37-2c310aef9466"],
 ": the spin coherent state points as definitely as a spin can along ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5ea7ed4-eb11-42c0-ac25-70e8a87b2cd4"],
 ", saturating the angular-momentum uncertainty and serving as the \
finite-dimensional stand-in for the coherent state of light."
}], "Text",ExpressionUUID->"eca41277-4323-46e7-b944-1bac2614c959"]
},
