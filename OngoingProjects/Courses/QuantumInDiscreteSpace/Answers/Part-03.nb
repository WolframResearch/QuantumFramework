Notebook[{
Cell["Part 3. States as density operators", "Section",ExpressionUUID->"a1afb1c7-88d7-4762-bc94-e39b61f0d234"],

Cell["\<\
3.1a [BSc] How do I build a density matrix from a classical ensemble?\
\>", "Subsection",ExpressionUUID->"f9855c74-7e97-4eb5-bdbd-8f3f0a42a0ec"],

Cell[TextData[{
 "A classical mixture of pure states, each ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox[
     StyleBox["\[Psi]", "TI"], 
     StyleBox["i", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ead9a921-8f8b-45c5-8f8e-2aa98bbb7bcb"],
 " prepared with probability ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a2f30dd-5907-41d8-820d-1f72490f00e7"],
 ", is the density matrix ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["i", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["i", "TI"]], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], 
        StyleBox["i", "TI"]]},
      "Ket"], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], 
        StyleBox["i", "TI"]]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79abc576-ee7e-470a-976c-ec9ff2e206ea"],
 "."
}], "Text",ExpressionUUID->"f1e23bbc-24fd-4184-9a02-e7b649b4e503"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : sum the weighted projectors, each ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["i", "TI"]]},
     "Ket"], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["i", "TI"]]},
     "Bra"]}], "="}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bffed5c-29eb-4367-8def-4d9cdee01422"],
 " ",
 Cell[BoxData[
  RowBox[{"KroneckerProduct", "[", 
   RowBox[{"psi", ",", " ", 
    RowBox[{"Conjugate", "[", "psi", "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86f0ec3e-e634-49b2-a878-a0eb0535a302"],
 "."
}], "Text",ExpressionUUID->"04411780-30bc-4bbf-8437-54f88be143f7"],

Cell[BoxData[
 RowBox[{"rho", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"3", "/", "4"}], " ", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"Conjugate", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], "]"}]}], "]"}]}], " ", "+", "\n",
    "   ", 
   RowBox[{
    RowBox[{"1", "/", "4"}], " ", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], "/", 
       RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
      RowBox[{"Conjugate", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}], "]"}]}]}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ca9a1139-2c73-487e-9faf-f31756ab9fec"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : a classical mixture is the sum of the component density matrices (NOT a \
sum of the state vectors, which would build a coherent superposition); wrap \
that matrix as a state object."
}], "Text",ExpressionUUID->"67ae4dc3-19cd-40fc-8233-ca25ef89cea5"],

Cell[BoxData[
 RowBox[{"rhoQF", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"3", "/", "4"}], " ", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], 
      "[", "\"\<DensityMatrix\>\"", "]"}]}], " ", "+", "\n", "    ", 
    RowBox[{
     RowBox[{"1", "/", "4"}], " ", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], "[", "\"\<DensityMatrix\>\"",
       "]"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f3acc161-ac9f-481a-a622-6bba5ec1013b"],

Cell[TextData[{
 "Both build the same ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7812ebb5-a8d1-4de0-a0fb-d08b8393ba28"],
 ". Summing the ",
 StyleBox["state vectors", "TI"],
 " instead would have built a coherent superposition, a pure state, a \
physically different object from this classical mixture."
}], "Text",ExpressionUUID->"b9196eb4-6005-485c-9166-644599569830"],

Cell[TextData[{
 "3.1b [BSc] How do I compute the purity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "2"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c19e87c-714d-43c0-8a77-3467839f35fb"],
 " of a density matrix?"
}], "Subsection",ExpressionUUID->"50a74649-d17f-4daa-bb6a-be48193fd3b0"],

Cell[TextData[{
 "The purity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "2"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "493f73e9-56cf-4a2f-b5ed-a7cb17110099"],
 " measures how mixed a state is: it runs from ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eea86758-4a21-4d90-a294-f08c9727aafb"],
 " (maximally mixed) up to ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "387649f5-0590-4606-a4ce-6254c83aebae"],
 " (pure), the value ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e166966f-b2e0-4602-8895-457b42a5c2c1"],
 " reached only when ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6d3db35-add8-4375-9f14-79cbc2cdfb0d"],
 " is a single projector."
}], "Text",ExpressionUUID->"ee759095-1949-4089-a8d0-9509c725d113"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : form the ensemble density matrix ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    FractionBox["3", "4"], 
    TemplateBox[{"0"},
     "Ket"], 
    TemplateBox[{"0"},
     "Bra"]}], "+", 
   RowBox[{
    FractionBox["1", "4"], 
    TemplateBox[{"+"},
     "Ket"], 
    TemplateBox[{"+"},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ecaedae-52b9-474d-963f-42a811a06b81"],
 " and read its purity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "2"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae16a4fb-23d7-4f73-8ad2-5cdb7832deae"],
 "."
}], "Text",ExpressionUUID->"3513da73-1cfa-4ef1-bfc2-8d8a26cf28fe"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rho", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"3", "/", "4"}], " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"Conjugate", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "0"}], "}"}], "]"}]}], "]"}]}], " ", "+", 
      " ", 
      RowBox[{
       RowBox[{"1", "/", "4"}], " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}], "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
         RowBox[{"Conjugate", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "1"}], "}"}], "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}], "]"}]}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"Tr", "[", 
    RowBox[{"rho", " ", ".", " ", "rho"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"42ee373e-bc7f-4295-8f4e-ee2027c9cae8"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : ",
 Cell[BoxData["\"\<Purity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "050eec97-0da8-41d4-97ba-e3cbc5528202"],
 " reads ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "2"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7e91c26-7d90-4f0d-9b2a-b5887d2e8120"],
 " off the state object."
}], "Text",ExpressionUUID->"8d200ad8-c54e-41e3-aacb-ac61bf92091e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"3", "/", "4"}], " ", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], 
      "[", "\"\<DensityMatrix\>\"", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"1", "/", "4"}], " ", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], "[", "\"\<DensityMatrix\>\"",
       "]"}]}]}], "]"}], "[", "\"\<Purity\>\"", "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"00896a3a-2f01-4407-b3a4-91aad7cb4c9a"],

Cell[TextData[{
 "Both give ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "2"], 
   StyleBox["]",
    SpanMaxSize->1], "=", "13", "/", "16", "<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e49f8f9d-38c7-49f2-a9c2-448f91fd4a37"],
 ": the ensemble state is mixed, below the pure-state value ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f3a502d-6de5-4974-941f-6643226c9e55"],
 " and above the qubit floor ",
 Cell[BoxData[
  RowBox[{"1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "147dea30-b2bc-444a-baa9-fa1748a05401"],
 "."
}], "Text",ExpressionUUID->"ffdf08f2-82ed-4af1-bb0c-c437e92f37a8"],

Cell["3.2 [BSc] How do I test whether a state is pure or mixed?", "Subsection",ExpressionUUID->"ed2c83a0-441f-449d-b814-76755039acdc"],

Cell[TextData[{
 "A state is pure iff any one of three equivalent conditions holds: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "2"], 
   StyleBox["]",
    SpanMaxSize->1], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9f513cd-e5b3-4b8d-bfaf-e39ffc3f76ca"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eb526ac-8962-492d-b5f2-9259e4d4ef5b"],
 " has rank one, or ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d49b8f1-2298-4851-ac01-621b16883c47"],
 " is idempotent (",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "2"], "=", 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f00ae3b-d4ea-405c-beb7-b685793028a5"],
 ", a projector)."
}], "Text",ExpressionUUID->"b00c57a7-3f12-4167-bd17-84c87a30db85"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : build a mixed state to test, the classical ensemble ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    FractionBox["3", "4"], 
    TemplateBox[{"0"},
     "Ket"], 
    TemplateBox[{"0"},
     "Bra"]}], "+", 
   RowBox[{
    FractionBox["1", "4"], 
    TemplateBox[{"+"},
     "Ket"], 
    TemplateBox[{"+"},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a0790c8-59a0-4bee-b4c5-1a7d4d4c3b4b"],
 "."
}], "Text",ExpressionUUID->"c3af0c9b-7724-4219-9782-1e63836e4fc2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rho", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"3", "/", "4"}], " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"Conjugate", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}], "]"}]}], "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"1", "/", "4"}], " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
       RowBox[{"Conjugate", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}], "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}], "]"}]}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"ec0daade-c132-44ab-b296-d657b8b58a6c"],

Cell["Purity equals one only for a pure state.", "Text",ExpressionUUID->"12da807d-4f2a-4412-a97c-5d7f626b6a4a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Tr", "[", 
   RowBox[{"rho", " ", ".", " ", "rho"}], "]"}], " ", "==", " ", 
  "1"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"46c29388-8b88-4dc7-9165-cc83e59c9002"],

Cell["A pure state's density matrix has rank one.", "Text",ExpressionUUID->"84aa88b2-bae3-476f-8698-43c7d720abbc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MatrixRank", "[", "rho", "]"}], " ", "==", " ", "1"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"726cfc96-bbe1-4cfe-9353-af04145f4af8"],

Cell[TextData[{
 "A pure state is idempotent, a projector ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "2"], "=", 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1bbfd15-ea3f-4002-9d90-2851a4f51f6b"],
 "."
}], "Text",ExpressionUUID->"fac39bf1-724a-4d68-b113-faa041065a13"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rho", " ", ".", " ", "rho"}], " ", "==", " ", "rho"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"1704ee04-b03d-479a-b812-b13d0e232fb2"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : build the same mixture as a state object; it answers directly with ",
 Cell[BoxData["\"\<PureStateQ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "486a3842-aea2-4a06-b957-fd370440fd75"],
 "."
}], "Text",ExpressionUUID->"b75d3cc4-1f6a-473e-b194-1c65dc015480"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rhoQF", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"3", "/", "4"}], " ", 
      RowBox[{
       RowBox[{"QuantumState", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], 
       "[", "\"\<DensityMatrix\>\"", "]"}]}], " ", "+", " ", 
     RowBox[{
      RowBox[{"1", "/", "4"}], " ", 
      RowBox[{
       RowBox[{"QuantumState", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}], "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], 
       "[", "\"\<DensityMatrix\>\"", "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"df6dc323-cd9e-4853-8930-76244ef2eae4"],

Cell["The mixed state is not pure.", "Text",ExpressionUUID->"888d6e6e-31c2-4be5-b458-9a7a9431bfca"],

Cell[BoxData[
 RowBox[{"rhoQF", "[", "\"\<PureStateQ\>\"", "]"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"12690f17-5bbc-4c9d-8819-2b0e2f8bf942"],

Cell[TextData[{
 "Contrast a genuine pure state, which returns ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f45abe23-84e3-4ce5-a800-6275050e73aa"],
 "."
}], "Text",ExpressionUUID->"5f578946-b58b-4738-aad7-29426b5c3bcb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "I"}], "}"}], "/", 
    RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], "[", "\"\<PureStateQ\>\"", 
  "]"}]], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"d9796b5b-75ec-4e24-a9ff-a01d16b5d5ec"],

Cell[TextData[{
 "The mixed state fails all three criteria (each cell returns ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc6685e3-d088-4bdd-9500-61addddb45d9"],
 ", the rank is ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32b02e14-ad6a-41d6-ae62-c1c2de19bff2"],
 "); the pure state passes. The three tests are equivalent characterizations \
of the same rank-one property."
}], "Text",ExpressionUUID->"f410222b-a0cb-4737-8355-ca8e7f492ede"],

Cell[TextData[{
 "3.3 [BSc] How do I build the maximally mixed state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "/", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "509d675c-f351-408e-98ea-237bc03a6ebd"],
 " and read its purity?"
}], "Subsection",ExpressionUUID->"54991f2f-785e-4fab-8d24-c3333db2e160"],

Cell[TextData[{
 "The maximally mixed state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "/", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12e0404a-8872-4964-a3ce-ff91bc269fd0"],
 " is the unique state of maximal entropy; its purity is the floor ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22fa9e01-54e3-469e-9976-347706d24d4d"],
 "."
}], "Text",ExpressionUUID->"3ae40711-f4e8-4f8f-96ae-a0136f0eaade"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the normalized identity, and its purity."
}], "Text",ExpressionUUID->"4a5c6d19-139b-4487-bf8e-d83bf91c6918"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"Tr", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "d", "]"}], "/", "d"}], ")"}], " ", ".",
      " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "d", "]"}], "/", "d"}], ")"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"a592ce9d-5b9c-4bdf-9720-7652193ec9cb"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same state as an object, shown as its summary box."
}], "Text",ExpressionUUID->"7ac41fd3-49c3-433a-8897-a4c3fa6a5e30"],

Cell[BoxData[
 RowBox[{"QuantumState", "[", 
  RowBox[{
   RowBox[{"IdentityMatrix", "[", "3", "]"}], "/", "3"}], "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"980c05c9-2fc2-443c-b464-b4aef7738181"],

Cell[TextData[{
 "Its ",
 Cell[BoxData["\"\<Purity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29076704-d34a-41bb-9726-153806bfd0e7"],
 " is the floor ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f54ce7d-6fc3-49d2-869b-b1d0369a359e"],
 "."
}], "Text",ExpressionUUID->"408a7ada-df0b-412a-b748-7d114509caa3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{"IdentityMatrix", "[", "3", "]"}], "/", "3"}], "]"}], 
  "[", "\"\<Purity\>\"", "]"}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"4af8a6c4-15a8-42b3-b6b7-e4660d7e69bf"],

Cell[TextData[{
 "Both give ",
 Cell[BoxData[
  RowBox[{"1", "/", "3", "=", "1", "/", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a483812-d853-4320-899e-60f33042fea4"],
 ", the minimum purity in dimension ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b5ec2c7-b50f-4cb8-ba2e-03fe4572ede7"],
 ": no state is less pure than ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "/", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80562b7c-0b1e-4b6e-acba-a6625a90611e"],
 "."
}], "Text",ExpressionUUID->"aaa7f4bb-1474-4a76-b6a3-af86089a21b6"],

Cell[TextData[{
 "3.4 [BSc] How do I compute an expectation value and a variance of an \
observable on a general (mixed) state as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["A", "TI"], "^"], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26b4a027-8927-46d7-a997-6bb14e42be8d"],
 "?"
}], "Subsection",ExpressionUUID->"5f3eb4ea-8e55-4574-a92e-6deb1c0c2ba8"],

Cell[TextData[{
 "For any state, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"A", "\[Rho]"}], "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29d6b816-0690-4eea-8e1c-0d39f7d0e8cd"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Var",
    FontSlant->"Plain"], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "2"], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "-", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     StyleBox[
      RowBox[{"A", "\[Rho]"}], "TI"], 
     StyleBox["]",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0cb3504-f6b0-4ae2-a7dd-b21897016c01"],
 ". Writing a general qubit state in Bloch form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8577188-da57-4e34-b2f7-42e94ce13763"],
 " makes the result transparent."
}], "Text",ExpressionUUID->"b3c39974-780f-4840-8919-157b2c153d88"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : build the general Bloch state and bind it (",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "="}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f347e89-44f8-4ed8-8e74-6847f56ff4fe"],
 " ",
 Cell[BoxData[
  RowBox[{"PauliMatrix", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "634f891b-f1e0-44f1-b4cb-cf875cc1c357"],
 ")."
}], "Text",ExpressionUUID->"4424b6e4-0eea-42b0-8c5c-81aa439c1c73"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rhoB", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rx", ",", " ", "ry", ",", " ", "rz"}], "}"}], " ", ".", " ", 
       
       RowBox[{"PauliMatrix", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
     ")"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"2aca048e-cefd-4a5f-96cc-11f79595ba53"],

Cell[TextData[{
 "The mean of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fe8fbe5-bb15-4c29-93b6-c4029e24f494"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0933c436-6bab-4387-bb68-eedacc81f6af"],
 "."
}], "Text",ExpressionUUID->"4b12d65a-cb78-4548-b6bf-c26ac86f6abc"],

Cell[BoxData[
 RowBox[{"Tr", "[", 
  RowBox[{
   RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", "rhoB"}], 
  "]"}]], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"3bb07f16-54a1-4e03-acae-d94a4596ecc2"],

Cell[TextData[{
 "The variance reuses ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"], "2"], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2defde3b-b13c-4cdf-98fe-d9dc7997c9b5"],
 "."
}], "Text",ExpressionUUID->"7c8ddd44-502f-42b8-87df-43df11278e4f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Tr", "[", 
   RowBox[{
    RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", 
    RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", "rhoB"}], "]"}], 
  " ", "-", " ", 
  RowBox[{
   RowBox[{"Tr", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", "rhoB"}], "]"}], "^",
    "2"}]}]], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"9b9d132c-6b35-4f5a-91ad-575d2b346431"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same general state as an object, shown as its summary box."
}], "Text",ExpressionUUID->"6abde42b-30cd-47fa-9cb8-2dbf3ac7e1bf"],

Cell[BoxData[
 RowBox[{"rhoBQF", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rx", ",", " ", "ry", ",", " ", "rz"}], "}"}], " ", ".", " ", 
       
       RowBox[{"PauliMatrix", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
     ")"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"0d3f415b-bd7b-476e-80cf-2dfa255a2ccf"],

Cell[TextData[{
 "The mean, as a measurement-operator expectation on the state. The ",
 Cell[BoxData["\"\<Mean\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "046d8f6d-4f7a-4e93-94f8-d6d8f31300b3"],
 " runs through Born probabilities ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", 
    SubscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["z", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23d8d38e-88f5-45c7-982a-bc71757d0af0"],
 ", so it is simplified under the physicality assumption ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      SubscriptBox[
       StyleBox["r", "TI"], 
       StyleBox["z", "TI"]]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94b61648-64cc-481e-b3fd-e5dd5f289c61"],
 "."
}], "Text",ExpressionUUID->"16acfa4a-63ce-4335-bd48-452069eb91ab"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"QuantumMeasurementOperator", "[", 
      RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "]"}], "[", 
     "rhoBQF", "]"}], "[", "\"\<Mean\>\"", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"-", "1"}], " ", "<=", " ", "rz", " ", "<=", " ", "1"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"ac930052-a043-440c-8fcf-d5e7605ff4a9"],

Cell[TextData[{
 "The variance, from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubsuperscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "-", 
   SuperscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["\[Sigma]", "TI"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4b09985-5719-441d-a3b3-e5b7078ac44d"],
 ", under the same assumption."
}], "Text",ExpressionUUID->"75ea5cac-3f21-427f-909d-e163e4c2492e"],

Cell[BoxData[
 RowBox[{"Simplify", "[", "\n", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"QuantumMeasurementOperator", "[", 
       RowBox[{
        RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], " ", "@", " ", 
        RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], "]"}], "[", 
      "rhoBQF", "]"}], "[", "\"\<Mean\>\"", "]"}], " ", "-", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"QuantumMeasurementOperator", "[", 
        RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "]"}], "[", 
       "rhoBQF", "]"}], "[", "\"\<Mean\>\"", "]"}], "^", "2"}]}], ",", " ", 
   RowBox[{
    RowBox[{"-", "1"}], " ", "<=", " ", "rz", " ", "<=", " ", "1"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"594884e3-656f-4593-bd84-3f88cc464aa8"],

Cell[TextData[{
 "Both give ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "693cd17a-397c-4e3d-9da8-26ca6885f19c"],
 " (the expectation of a Pauli is its Bloch component) and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Var",
    FontSlant->"Plain"], "=", "1", "-", 
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31e58504-abe9-4ec8-ab76-6b7fa56da9ca"],
 ": the spin is sharp (",
 Cell[BoxData[
  RowBox[{
   StyleBox["Var",
    FontSlant->"Plain"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8f45451-dade-4b62-b040-2055d7bf5724"],
 ") only at the poles ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["z", "TI"]], "=", "\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77dba7cd-fa6d-498e-9dbe-4c11f5b8b2ae"],
 ". (The WL trace ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9468343f-2042-4cb7-8ce2-cf27675cdbdc"],
 " holds for any ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab7de5ce-09f9-4d84-881e-84a709450323"],
 "; the QF measurement form needs ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be73b66c-6ae7-4388-8232-d820d38af1be"],
 " to be a physical state, which is the ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      SubscriptBox[
       StyleBox["r", "TI"], 
       StyleBox["z", "TI"]]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afda881c-6e21-41c6-af82-67cdfc7d43b3"],
 " assumption.)"
}], "Text",ExpressionUUID->"48d85767-e290-4a29-8fd9-4811ac1daf3c"],

Cell[TextData[{
 "3.5 [BSc] How do I count the real parameters of a ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93c811d6-33f5-4f2d-8db2-4687ee2cb3c4"],
 "-dimensional mixed state (density matrix)?"
}], "Subsection",ExpressionUUID->"8472ea49-fae1-4b95-aa3f-45f7ddf6ba25"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "\[Times]", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ffa709a-5b46-4608-bccd-50c86e187a8a"],
 " density matrix is Hermitian (",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["d", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "effa08b4-7852-4f8a-8903-ba25fdde8a5b"],
 " real parameters) with unit trace (one constraint), leaving ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["d", "TI"], "2"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1172dd49-cbb6-48c1-aeaf-72a0357ac5a7"],
 ". As in Part 1, 1.5, the rigorous count is a Jacobian rank."
}], "Text",ExpressionUUID->"c43c675e-b017-4397-b549-5073ce7b7cf0"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the general Hermitian unit-trace qubit ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "{", 
    StyleBox["a", "TI"]}], ",", 
   RowBox[{
    StyleBox["b", "TI"], "+", 
    StyleBox["i", "TI"], 
    StyleBox["c", "TI"], "}"}], ",", 
   RowBox[{"{", 
    StyleBox["b", "TI"], "-", 
    StyleBox["i", "TI"], 
    StyleBox["c", "TI"]}], ",", 
   RowBox[{"1", "-", 
    StyleBox["a", "TI"], "}", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f836b2d-a572-4740-adf1-89b6fc0836bf"],
 " has three real parameters; its real-coordinate embedding has Jacobian rank \
",
 Cell[BoxData[
  RowBox[{"3", "=", 
   SuperscriptBox["2", "2"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6f14c3c-7b77-4b7a-a8b0-49c912a9d045"],
 "."
}], "Text",ExpressionUUID->"2ffe7c51-14c9-4f12-94aa-4ae3c1d54b64"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rho", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", 
         RowBox[{"b", " ", "+", " ", 
          RowBox[{"I", " ", "c"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"b", " ", "-", " ", 
          RowBox[{"I", " ", "c"}]}], ",", " ", 
         RowBox[{"1", " ", "-", " ", "a"}]}], "}"}]}], "}"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"MatrixRank", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"ReIm", "[", 
        RowBox[{"Flatten", "[", "rho", "]"}], "]"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], "}"}]}], "]"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"abb00876-73d3-4845-826d-991c205f22a0"],

Cell[TextData[{
 "The general count for dimension ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f90b7dcf-5ac3-4f2e-969a-6ce2b62d77da"],
 " is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["d", "TI"], "2"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09d861ea-cc3e-4c71-95e8-1694a20f1510"],
 "."
}], "Text",ExpressionUUID->"622b9ff7-67cc-40e5-8100-25749d6e79e9"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"d", "^", "2"}], " ", "-", " ", "1"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"d", ",", " ", "2", ",", " ", "4"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"4ef5d076-faea-42a0-a51f-2df56ca5ed47"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : drive the general count from the object's own dimension."
}], "Text",ExpressionUUID->"fcb7ff9f-20d6-4ef8-80be-b27c2df3a4a4"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"\"\<0\>\"", ",", " ", "d"}], "]"}], "[", "\"\<Dimension\>\"", 
      "]"}], "^", "2"}], " ", "-", " ", "1"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"d", ",", " ", "2", ",", " ", "4"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"49a0bd11-e078-4c52-ad24-1210ee5e5aa1"],

Cell[TextData[{
 "The qubit rank is ",
 Cell[BoxData[
  RowBox[{"3", "=", 
   SuperscriptBox["2", "2"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b89a26aa-f102-421a-847e-e7d27569a0c2"],
 "; the general count is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "3"}], ",", "8", ",", 
   RowBox[{"15", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "acb86797-3937-4f30-8730-f2232ceef111"],
 " for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], "=", "2"}], ",", 
   RowBox[{"3", ",", "4"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "429df9fa-a6c6-48e6-bb66-5e91da0a4610"],
 ". (The pure-state count ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["d", "TI"], "-", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d652979-8617-4120-a653-c89ee1f4ac10"],
 " of 1.5 is smaller: a pure state is a measure-zero boundary of the full \
state space.)"
}], "Text",ExpressionUUID->"de20e8cc-3166-48fb-bea6-0012f737cbbb"],

Cell["\<\
3.6 [BSc] How do I map a qubit density matrix to its Bloch vector and read \
positivity and the pure-state boundary?\
\>", "Subsection",ExpressionUUID->"191ca3b7-cfbe-47e8-9886-622a8089f782"],

Cell[TextData[{
 "For a qubit, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bf34824-71c2-4d51-bacb-cbe0b110e08b"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["j", "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["j", "TI"]], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c69c4f5-82b2-42c0-8c7b-46e686415b02"],
 "; positivity forces ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fc375c7-1dec-4613-af14-b3873f8cc864"],
 ", and ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "984d1311-595f-4721-b16e-8c5305e4eaf6"],
 " exactly on the pure states."
}], "Text",ExpressionUUID->"af87aa8b-b8e7-436a-b16a-c2766eef8138"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : build the general qubit state in Bloch form (",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "="}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1942799e-3772-4dd0-8b2e-877ebea5b3f7"],
 " ",
 Cell[BoxData[
  RowBox[{"PauliMatrix", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac538d0a-0356-48c3-b321-e81fafd21fed"],
 ")."
}], "Text",ExpressionUUID->"895d7fe5-3fbd-4a3e-a9e3-23b9c3867ada"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rhoB", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rx", ",", " ", "ry", ",", " ", "rz"}], "}"}], " ", ".", " ", 
       
       RowBox[{"PauliMatrix", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
     ")"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"47297936-e750-4e8c-aab1-673ab51f1ae3"],

Cell[TextData[{
 "Recover the Bloch vector as the Pauli expectations ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["j", "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["j", "TI"]], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5eed5db8-c6c5-43d9-bf77-e87ef15d0ee3"],
 "."
}], "Text",ExpressionUUID->"a64016e7-797b-4762-ae2b-536e519946b9"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Tr", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "j", "]"}], " ", ".", " ", "rhoB"}], "]"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"7653860a-1f22-4909-8fe3-9509e8fef54e"],

Cell[TextData[{
 "Purity and radius are tied by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "2"], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SuperscriptBox[GridBox[{
       {
        OverscriptBox[
         StyleBox["r", "TI"], "\[RightVector]"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05ee3c2a-034a-4a8b-b087-b2714ebde591"],
 ", so ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fae5f167-9eed-4102-a653-846bb556fb08"],
 " iff the state is pure."
}], "Text",ExpressionUUID->"9ef1ae34-4062-48fb-a698-2426fb19a961"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Tr", "[", 
   RowBox[{"rhoB", " ", ".", " ", "rhoB"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"0fdf56e3-18e9-4743-9fd4-5afe1259f233"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the object computes the Bloch vector directly from the same ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd2aed7b-4fdc-4ae4-beda-7d7e1d3f0a34"],
 "."
}], "Text",ExpressionUUID->"3b018f36-9e47-401b-ac96-b857385e7346"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", "rhoB", "]"}], "[", "\"\<BlochVector\>\"", 
  "]"}]], "Input",
 CellLabel->
  "In[27]:= ",ExpressionUUID->"f143c1a5-b05d-421a-bb5e-c812dfbd6bd9"],

Cell[TextData[{
 "Both recover ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["x", "TI"]], ",", 
    SubscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["y", "TI"]], ",", 
    SubscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["z", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1aa64b9f-2bd1-4e64-a7c2-e3f54ac3bd75"],
 ", and the purity is ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["x", "TI"], "2"], "+", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["y", "TI"], "2"], "+", 
    SubsuperscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["z", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea4a3e2a-e38d-4460-bce4-d19d23fe4b64"],
 ": positivity (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "\[SucceedsEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6efc40e1-69ad-4b86-af65-4e47c00b1d26"],
 ") is exactly ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7989614f-9576-4a9e-92b4-9fe3aca1242f"],
 " (the Bloch ball), and the pure states are its surface ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c261d9d7-f096-49fc-81b3-ff068190e705"],
 "."
}], "Text",ExpressionUUID->"eb61be77-941d-44e4-a5e3-a3066cdc5f22"],

Cell["\<\
3.7 [MSc] How do I show that the state space is convex, with pure states as \
its extreme points?\
\>", "Subsection",ExpressionUUID->"75d6573e-be05-45c6-b873-d7ec4b4ef59f"],

Cell[TextData[{
 "The density operators form a convex set: any mixture ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "1"], "+", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1808e33b-b2e4-47af-832d-35104b24367f"],
 " is again a state. The pure states are its extreme points, which for a \
qubit is the surface of the Bloch ball."
}], "Text",ExpressionUUID->"e30fc475-e47b-41b8-bfcb-62965b6ade59"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : every pure qubit sits on the sphere (",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46c352ec-a261-4ead-a9a5-02e0e69e3084"],
 "), so pure states are extreme."
}], "Text",ExpressionUUID->"b846e23a-f206-489d-b9d1-9cce7b9e695f"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", "\n", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"PauliMatrix", "[", "j", "]"}], " ", ".", " ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"Conjugate", "[", "#", "]"}]}], "]"}]}], "]"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], "]"}], " ", "&"}], " ",
     "@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}]}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", " ", 
    "Reals"}]}], "]"}]], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"f2423ae8-299c-4de4-80d5-1e75ecda0032"],

Cell[TextData[{
 "A nontrivial mixture of two distinct pure states (here ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aaee1ff4-7cad-4e3f-bc41-98b0a0a300dc"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["R", "TI"]},
    "Ket"], "=", "{", "1", ",", 
   StyleBox["i", "TI"], "}", "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8e24663-df6f-488c-923e-1dac8acf01e8"],
 ", the same pair used by the QF cells below) lands strictly inside (purity \
",
 Cell[BoxData[
  RowBox[{"<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04e6c25a-95ce-4975-a6e4-1a79ba55d7f4"],
 ")."
}], "Text",ExpressionUUID->"59165c59-fe52-439f-bb7e-3ed1bbeb2d1f"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"1", "/", "3"}]}], "}"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{"#", ".", "#"}], "]"}], " ", "&"}], "[", 
    RowBox[{
     RowBox[{"p", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"Conjugate", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}], "]"}]}], "]"}]}], " ", "+", 
     " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", "p"}], ")"}], " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "I"}], "}"}], "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
        RowBox[{"Conjugate", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "I"}], "}"}], "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[29]:= ",ExpressionUUID->"01e06b33-70e5-4438-934e-7e591734885d"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : build the same mixture as an object."
}], "Text",ExpressionUUID->"c8566e5a-00fe-4199-9f55-315c17fd1b08"],

Cell[BoxData[
 RowBox[{"mix", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "3"}], " ", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], 
      "[", "\"\<DensityMatrix\>\"", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"2", "/", "3"}], " ", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "I"}], "}"}], "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], "[", "\"\<DensityMatrix\>\"",
       "]"}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[30]:= ",ExpressionUUID->"9ddc288e-2551-4c1c-b75c-c0f16be4c62a"],

Cell["Its purity is below one.", "Text",ExpressionUUID->"4301142f-055d-4ca3-86f3-3252663c0c49"],

Cell[BoxData[
 RowBox[{"mix", "[", "\"\<Purity\>\"", "]"}]], "Input",
 CellLabel->
  "In[31]:= ",ExpressionUUID->"664b2600-134d-4cfe-86b1-311d9a38aa0a"],

Cell["\<\
Its Bloch radius is below one, so it lies in the interior of the ball.\
\>", "Text",ExpressionUUID->"8eb4dbe7-8576-468a-8dd3-d56f0fa74fe0"],

Cell[BoxData[
 RowBox[{"Norm", "[", 
  RowBox[{"mix", "[", "\"\<BlochVector\>\"", "]"}], "]"}]], "Input",
 CellLabel->
  "In[32]:= ",ExpressionUUID->"86da534b-20af-46b6-8d77-b2ae28ca9791"],

Cell["\<\
The Bloch map is affine: the mixture's Bloch vector is the convex combination \
of the components'.\
\>", "Text",ExpressionUUID->"58f454b6-eee3-452d-b636-086610bed6f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mix", "[", "\"\<BlochVector\>\"", "]"}], " ", "==", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", "3"}], " ", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], "[", "\"\<BlochVector\>\"",
      "]"}]}], " ", "+", " ", 
   RowBox[{
    RowBox[{"2", "/", "3"}], " ", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "I"}], "}"}], "/", 
       RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], "[", "\"\<BlochVector\>\"", 
     "]"}]}]}]}]], "Input",
 CellLabel->
  "In[33]:= ",ExpressionUUID->"077e44b5-fb7a-4dd5-849d-4421666a0dcb"],

Cell[TextData[{
 "Pure states have radius ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48fe37c2-4f5f-4277-add8-bd1c0e1eb764"],
 " (extreme points, not expressible as a nontrivial mixture); every mixture \
has radius and purity below ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3732c3d9-a1a3-4f46-b0ac-7eaec0149ea4"],
 " and lies in the interior; and because the Bloch map is affine, mixing \
states maps to mixing their Bloch vectors. That is the convex geometry of the \
Bloch ball."
}], "Text",ExpressionUUID->"7550e458-338b-40ed-aa7d-d136bddce58e"],

Cell["\<\
3.8 [BSc] How do I compute the von Neumann entropy of a density matrix?\
\>", "Subsection",ExpressionUUID->"a02e7e83-ad49-4e2e-9f49-bfcbd494dbde"],

Cell[TextData[{
 "The von Neumann entropy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], 
    StyleBox["log",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "-", 
   UnderscriptBox["\[Sum]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["k", "TI"]], 
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dcb9875-7802-49af-9acb-1e35f6b90a55"],
 " is the Shannon entropy of the eigenvalue spectrum: ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a3bbcc2-d0b1-4126-a34b-78641f7ffe06"],
 " for a pure state, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b31f6eb2-782a-41a4-bbe6-a8e836b06738"],
 " for the maximally mixed."
}], "Text",ExpressionUUID->"fcd5ae33-baed-4748-92b7-4c3b19bfd5ab"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the Shannon entropy of the eigenvalues, in bits."
}], "Text",ExpressionUUID->"21b7a956-e913-4005-8e49-99729f0ab24c"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{"Total", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"#", " ", 
      RowBox[{"Log2", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"Eigenvalues", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"3", "/", "4"}], ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"1", "/", "4"}]}], "}"}]}], "}"}], "]"}]}], "]"}]}]], "Input",\

 CellLabel->
  "In[34]:= ",ExpressionUUID->"b3c5cbfc-8cee-474e-ba8f-b8735714563f"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the object reports it directly (as a ",
 Cell[BoxData["Quantity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c7a3363-e467-4bc9-be93-9432ac29c159"],
 " in bits)."
}], "Text",ExpressionUUID->"bd8f2f30-1cee-4944-b048-c077a989343b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"3", "/", "4"}], ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"1", "/", "4"}]}], "}"}]}], "}"}], "]"}], 
  "[", "\"\<VonNeumannEntropy\>\"", "]"}]], "Input",
 CellLabel->
  "In[35]:= ",ExpressionUUID->"de1a0cfa-8ea5-4c69-87be-92fbb2482fa7"],

Cell[TextData[{
 "Both give ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox["3", "4"], 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox["3", "4"], "-", 
   FractionBox["1", "4"], 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox["1", "4"], "\[TildeTilde]", "0.811"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d95ec11a-054f-41e5-afc6-4a745d8e1414"],
 " bits: the entropy is the classical uncertainty of the eigenvalue \
distribution, vanishing on a pure state and reaching ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a0e4875-67e2-4957-86a9-ba8a9335b28f"],
 " on the maximally mixed state."
}], "Text",ExpressionUUID->"2ad038b3-2c9a-44a5-8702-2925f41da0fd"],

Cell["\<\
3.9 [BSc] How do I test whether a matrix is a valid density operator?\
\>", "Subsection",ExpressionUUID->"d442c0fc-9c79-4957-84e2-71b1b0df2fdf"],

Cell[TextData[{
 "A density operator must satisfy three conditions: Hermiticity (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4b00140-3d5a-4b01-aeca-4c51ccc76c20"],
 "), unit trace (",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], " ", 
   StyleBox["\[Rho]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "620bb41b-d7b1-4e75-9d69-240cc20f94ad"],
 "), and positive semidefiniteness (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "\[SucceedsEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2830e65e-0f41-4be5-8481-d08200c05ff5"],
 ", no negative eigenvalue). Together they are exactly what makes ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8a5e486-9142-4c8d-be70-73eb4209c71d"],
 " a legitimate state."
}], "Text",ExpressionUUID->"a7a7d4ee-25cf-4cb2-b5eb-6eb5341679e1"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : check the three conditions on a candidate matrix."
}], "Text",ExpressionUUID->"4af266ac-bdef-4b9c-9f3c-1791368074c0"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rho", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"3", "/", "4"}], ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"1", "/", "4"}]}], "}"}]}], "}"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"HermitianMatrixQ", "[", "rho", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Tr", "[", "rho", "]"}], " ", "==", " ", "1"}], ",", " ", 
     RowBox[{"PositiveSemidefiniteMatrixQ", "[", "rho", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[36]:= ",ExpressionUUID->"fbf90d2f-a158-4d75-aead-7d1d9b42a0e3"],

Cell["\<\
A Hermitian, unit-trace matrix that fails positivity is not a state.\
\>", "Text",ExpressionUUID->"10ddd45f-2c47-4e8f-855a-dcebd9116110"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rho", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"3", "/", "4"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"1", "/", "4"}]}], "}"}]}], "}"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"HermitianMatrixQ", "[", "rho", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Tr", "[", "rho", "]"}], " ", "==", " ", "1"}], ",", " ", 
     RowBox[{"PositiveSemidefiniteMatrixQ", "[", "rho", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[37]:= ",ExpressionUUID->"39a4d6dd-2b22-4b3c-8c2d-ca82c424c5eb"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the object folds all three conditions into the single property ",
 Cell[BoxData["\"\<PhysicalQ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48aa7288-71ff-4a0b-ac1b-e6857dad7aef"],
 "."
}], "Text",ExpressionUUID->"2250003c-c6e0-47d9-9d26-2fc0ee7e40d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"3", "/", "4"}], ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"1", "/", "4"}]}], "}"}]}], "}"}], "]"}], 
  "[", "\"\<PhysicalQ\>\"", "]"}]], "Input",
 CellLabel->
  "In[38]:= ",ExpressionUUID->"e6488b83-fb03-43e7-ae2b-7dd437bd66a8"],

Cell["The invalid matrix fails it.", "Text",ExpressionUUID->"43e8e669-4007-41e9-a38e-f3d03c1d4f40"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"3", "/", "4"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"1", "/", "4"}]}], "}"}]}], "}"}], "]"}], 
  "[", "\"\<PhysicalQ\>\"", "]"}]], "Input",
 CellLabel->
  "In[39]:= ",ExpressionUUID->"34c2f3b0-5823-4601-99d5-7beaf447a3cd"],

Cell[TextData[{
 "Both agree: the first matrix is a valid density operator (the three \
conditions all hold and ",
 Cell[BoxData["\"\<PhysicalQ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ce1573f-99d8-4de3-956c-844f842c1469"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bbb59a3-fb4b-46ce-9de3-754cfbde4838"],
 "); the second is Hermitian and unit-trace but not positive (one eigenvalue \
is negative), so it is not a physical state."
}], "Text",ExpressionUUID->"95d53c90-dd4c-4877-94da-5719d9f0a93c"]
},
CreateCellID->True,
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (February 17, 2026)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"e87e7e57-c2b7-473f-8985-5c8d8593a5f8"
]
