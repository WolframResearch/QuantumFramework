Cell["\<\
The extreme values over the family, the lowest conditional entropy and the \
highest mutual information are reached at the same angle:\
\>", "Text",
 CellChangeTimes->{{3.995739506392992*^9, 
  3.995739522593603*^9}},ExpressionUUID->"75c29f37-a088-404c-9250-\
e7b8c628248c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "@", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Minimize", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"sAB", "-", "sB"}], ",", 
        RowBox[{"0", "<=", "t", "<=", 
         RowBox[{"Pi", "/", "2"}]}]}], "}"}], ",", "t"}], "]"}], ",", 
    RowBox[{"Maximize", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"sA", "+", "sB", "-", "sAB"}], ",", 
        RowBox[{"0", "<=", "t", "<=", 
         RowBox[{"Pi", "/", "2"}]}]}], "}"}], ",", "t"}], "]"}]}], 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.9957369840917263`*^9, 3.995736985098921*^9}},
 CellLabel->
  "In[280]:=",ExpressionUUID->"bdc297d5-373d-0b48-9b58-f547199eb340"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", "\[Rule]", 
       FractionBox["\[Pi]", "4"]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", 
     RowBox[{"{", 
      RowBox[{"t", "\[Rule]", 
       FractionBox["\[Pi]", "4"]}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9957369860870285`*^9},
 CellLabel->
  "Out[280]=",ExpressionUUID->"047db9c5-4e3d-094c-b1dc-3c2f267afb19"]
}, Open  ]],

Cell["\<\
Erasing the one coherence between the two Schmidt terms leaves a state with \
the same populations, correlated but only classically:\
\>", "Text",
 CellChangeTimes->{{3.995739540994488*^9, 
  3.995739544253273*^9}},ExpressionUUID->"403fd7dc-0b54-5c42-b870-\
69a158fee320"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dephased", "=", 
  RowBox[{"DiagonalMatrix", "[", 
   RowBox[{"Diagonal", "[", "rhoAB", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9957370119302483`*^9, 3.995737012455778*^9}},
 CellLabel->
  "In[372]:=",ExpressionUUID->"08f83d1d-2fe8-0b4d-a186-121f80c5b059"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Cos", "[", "t", "]"}], "2"], ",", "0", ",", "0", ",", "0"}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", 
     SuperscriptBox[
      RowBox[{"Sin", "[", "t", "]"}], "2"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9957370143372383`*^9, 3.995739551722389*^9},
 CellLabel->
  "Out[372]=",ExpressionUUID->"65366c33-e485-4e46-891f-e012b769c411"]
}, Open  ]],

Cell[TextData[{
 "Dephasing in the Schmidt basis leaves both marginals untouched, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", 
    RowBox[{"(", "A", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2362b915-15fe-184b-bb4c-f4d1875f403d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", 
    RowBox[{"(", "B", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e6969e4d-a5cc-3e4e-9eaf-d2b0d83c1023"],
 " are the same numbers as before:"
}], "Text",
 CellChangeTimes->{{3.9957395668158207`*^9, 
  3.9957396112127438`*^9}},ExpressionUUID->"2edadf2b-0dad-ad4f-bcf3-\
e78222ae89dc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"reduceA", "[", "dephased", "]"}], ",", 
      RowBox[{"reduceB", "[", "dephased", "]"}]}], "}"}], "==", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"reduceA", "[", "rhoAB", "]"}], ",", 
      RowBox[{"reduceB", "[", "rhoAB", "]"}]}], "}"}]}], ",", 
   RowBox[{"0", "<", "t", "<", 
    RowBox[{"Pi", "/", "2"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.995737023456064*^9, 3.995737023856449*^9}},
 CellLabel->
  "In[282]:=",ExpressionUUID->"582f6e7b-de84-6d4f-b998-67f8c1b4077c"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9957370243231544`*^9},
 CellLabel->
  "Out[282]=",ExpressionUUID->"3d68e277-9f1d-1b49-9fe5-b5d2f3a0c5e2"]
}, Open  ]],

Cell["\<\
The two surviving inequalities are claims about every state, and the pure \
family is too narrow to test them, so draw mixed states at random from a \
Ginibre matrix normalized to unit trace:\
\>", "Text",
 CellChangeTimes->{{3.9957396621772633`*^9, 
  3.9957396668765526`*^9}},ExpressionUUID->"da077a65-1a67-e04c-bca5-\
b97712ad6d7f"],

Cell[BoxData[
 RowBox[{"randomState", ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"#", "/", 
     RowBox[{"Tr", "[", "#", "]"}]}], "&"}], "@", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"#", ".", 
       RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], "&"}], ")"}], "@", 
    RowBox[{"RandomComplex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "-", "I"}], ",", 
        RowBox[{"1", "+", "I"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.995737031207672*^9, 3.9957370316085663`*^9}},
 CellLabel->
  "In[374]:=",ExpressionUUID->"f37cf101-762d-d649-bf58-9c612468f58c"],

Cell["\<\
Subadditivity needs no sampling once the mutual information is recognized as \
the relative entropy against the product of marginals, an identity a single \
generic state already exposes:\
\>", "Text",
 CellChangeTimes->{{3.995739679870676*^9, 
  3.9957396809845276`*^9}},ExpressionUUID->"d3ce13ca-8f4f-5b4b-b6f5-\
9c7e35c5602b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"Re", "[", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", "=", "randomState"}], "}"}], ",", 
     RowBox[{
      FractionBox[
       RowBox[{"Tr", "[", 
        RowBox[{"r", ".", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"MatrixLog", "[", "r", "]"}], "-", 
           RowBox[{"MatrixLog", "[", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{
              RowBox[{"reduceA", "[", "r", "]"}], ",", 
              RowBox[{"reduceB", "[", "r", "]"}]}], "]"}], "]"}]}], ")"}]}], 
        "]"}], 
       RowBox[{"Log", "[", "2", "]"}]], "-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"vonNeumann", "[", 
         RowBox[{"reduceA", "[", "r", "]"}], "]"}], "+", 
        RowBox[{"vonNeumann", "[", 
         RowBox[{"reduceB", "[", "r", "]"}], "]"}], "-", 
        RowBox[{"vonNeumann", "[", "r", "]"}]}], ")"}]}]}], "]"}], "]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9957370421636105`*^9, 3.995737048174217*^9}},
 CellLabel->
  "In[285]:=",ExpressionUUID->"7091572c-917d-9246-a244-9a7523ab7473"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{{3.99573704421422*^9, 3.995737050194769*^9}},
 CellLabel->
  "Out[285]=",ExpressionUUID->"7166ef7e-727a-0648-b891-7d9c0722414e"]
}, Open  ]],

Cell["\<\
The Araki-Lieb bound is the one that limits how negative a conditional \
entropy can get, and its slack over two hundred random mixed states stays on \
one side of zero:\
\>", "Text",
 CellChangeTimes->{{3.995739689324501*^9, 
  3.995739695464813*^9}},ExpressionUUID->"d879657d-2c5d-e342-a690-\
7447302f6aec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Positive", "@", 
  RowBox[{"Chop", "@", 
   RowBox[{"Re", "@", 
    RowBox[{"Min", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", "=", "randomState"}], "}"}], ",", 
         RowBox[{
          RowBox[{"vonNeumann", "[", "r", "]"}], "-", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"vonNeumann", "[", 
             RowBox[{"reduceA", "[", "r", "]"}], "]"}], "-", 
            RowBox[{"vonNeumann", "[", 
             RowBox[{"reduceB", "[", "r", "]"}], "]"}]}], "]"}]}]}], "]"}], ",",
        "200"}], "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.9957370583667336`*^9, 3.9957370590613766`*^9}, {
  3.9957375870588627`*^9, 3.9957375878359623`*^9}},
 CellLabel->
  "In[339]:=",ExpressionUUID->"947803ff-8aed-8e4f-8800-b8133765407d"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.995737060465473*^9, 3.995737116506378*^9}, 
   3.995737588818672*^9},
 CellLabel->
  "Out[339]=",ExpressionUUID->"e85aed86-0e45-3c4f-9bf5-bc5341f13cd7"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9957397102562923`*^9, 
  3.995739713421465*^9}},ExpressionUUID->"7e216199-245e-264c-82f6-\
11a66861f18d"],

Cell["Define the family state:", "Text",
 CellChangeTimes->{{3.9957397499305573`*^9, 
  3.9957397527483673`*^9}},ExpressionUUID->"6aef4301-fde2-4b4b-882a-\
fb372d07db2b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"qs", "=", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", "t", "]"}], ",", "0", ",", "0", ",", 
     RowBox[{"Sin", "[", "t", "]"}]}], "}"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.995737172973633*^9, 3.9957371735914593`*^9}},
 CellLabel->
  "In[322]:=",ExpressionUUID->"87e7c005-1816-274d-a48b-73045d576d05"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   TooltipBox[
    StyleBox[
     RowBox[{
      RowBox[{
       RowBox[{"cos", "(", "t", ")"}], 
       FormBox[
        InterpretationBox[
         StyleBox[
          TemplateBox[{
            RowBox[{
              FormBox["0", TraditionalForm], "\[InvisibleSpace]", 
              FormBox["0", TraditionalForm]}]},
           "Ket"],
          FontWeight->"Plain"],
         Wolfram`QuantumFramework`QuditName[{0, 0}, "Dual" -> False]],
        TraditionalForm]}], "+", 
      RowBox[{
       RowBox[{"sin", "(", "t", ")"}], 
       FormBox[
        InterpretationBox[
         StyleBox[
          TemplateBox[{
            RowBox[{
              FormBox["1", TraditionalForm], "\[InvisibleSpace]", 
              FormBox["1", TraditionalForm]}]},
           "Ket"],
          FontWeight->"Plain"],
         Wolfram`QuantumFramework`QuditName[{1, 1}, "Dual" -> False]],
        TraditionalForm]}]}],
     ShowStringCharacters->False],
    TagBox[
     GridBox[{{"None"}, {
        TemplateBox[{"\"QuantumState: \"", 
          RowBox[{
            RowBox[{"{", "}"}], "\[Rule]", 
            RowBox[{"{", 
              RowBox[{"2", ",", "2"}], "}"}]}]}, "RowDefault"]}}, 
      GridBoxAlignment -> {"Columns" -> {{Center}}}, DefaultBaseStyle -> 
      "Column", 
      GridBoxItemSize -> {
       "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"]],
   Wolfram`QuantumFramework`QuantumState[
   SparseArray[
    Automatic, {4}, 0, {
     1, {{0, 2}, {{1}, {4}}}, {Cos[$CellContext`t], Sin[$CellContext`t]}}], 
    Wolfram`QuantumFramework`QuantumBasis[<|
     "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
           
           Wolfram`QuantumFramework`QuditName[\[FormalCapitalI], "Dual" -> 
            False], 1} -> 1|>], "Output" -> 
      Wolfram`QuantumFramework`QuditBasis[<|{
           Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 1} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 1} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
      "Picture" -> "Schrodinger", "Label" -> None, "ParameterSpec" -> {}|>]]],
   TraditionalForm]], "Output",
 CellChangeTimes->{{3.9957371741856766`*^9, 3.9957371761201*^9}},
 CellLabel->
  "Out[322]=",ExpressionUUID->"41f5d5d2-42f8-7b4d-b3f8-148d491bb5ce"]
}, Open  ]],

Cell["The marginals are partial traces:", "Text",
 CellChangeTimes->{{3.9957397628940754`*^9, 
  3.99573976467708*^9}},ExpressionUUID->"3634809d-3b1b-e942-8ecf-\
3b0b45d279e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qa", ",", "qb"}], "}"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumPartialTrace", "[", 
      RowBox[{"qs", ",", "#"}], "]"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "2", "}"}], ",", 
      RowBox[{"{", "1", "}"}]}], "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.99573720503776*^9, 3.9957372054751453`*^9}, 
   3.995737286865225*^9},
 CellLabel->
  "In[328]:=",ExpressionUUID->"5a7e4d3b-e1ef-9b47-870b-6dba9e38096d"],

Cell["\<\
The same three quantities, each entropy read off its own object with base 2 \
selected by the second argument:\
\>", "Text",
 CellChangeTimes->{{3.995739773257223*^9, 
  3.995739789837412*^9}},ExpressionUUID->"d08a7d84-82fa-2443-a5f5-\
445fb7db59e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"qtriple", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"qs", "[", 
       RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}], ",", 
      RowBox[{
       RowBox[{"qs", "[", 
        RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}], "-", 
       RowBox[{"qb", "[", 
        RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"qa", "[", 
        RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}], "+", 
       RowBox[{"qb", "[", 
        RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}], "-", 
       RowBox[{"qs", "[", 
        RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}]}]}], "}"}], ",", 
    RowBox[{"0", "<", "t", "<", 
     RowBox[{"Pi", "/", "2"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9957371849215107`*^9, 3.995737185620041*^9}},
 CellLabel->
  "In[375]:=",ExpressionUUID->"9b0b055f-2590-154a-ab59-b896aae0c4c7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   FractionBox[
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"Cos", "[", "t", "]"}], "2"], " ", 
        RowBox[{"Log", "[", 
         RowBox[{"Cos", "[", "t", "]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"Sin", "[", "t", "]"}], "]"}], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "t", "]"}], "2"]}]}], ")"}]}], 
    RowBox[{"Log", "[", "2", "]"}]], ",", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"4", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"Cos", "[", "t", "]"}], "2"], " ", 
         RowBox[{"Log", "[", 
          RowBox[{"Cos", "[", "t", "]"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"Sin", "[", "t", "]"}], "]"}], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "t", "]"}], "2"]}]}], ")"}]}], 
     RowBox[{"Log", "[", "2", "]"}]]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9957371862288303`*^9, 3.995737211486334*^9}, 
   3.995739792657814*^9},
 CellLabel->
  "Out[375]=",ExpressionUUID->"a1c11a4c-3ffe-6345-b2a8-60bce8397ad7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"qtriple", "===", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sAB", ",", 
      RowBox[{"sAB", "-", "sB"}], ",", 
      RowBox[{"sA", "+", "sB", "-", "sAB"}]}], "}"}], ",", 
    RowBox[{"0", "<", "t", "<", 
     RowBox[{"Pi", "/", "2"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.995737261501686*^9, 3.9957372619557056`*^9}},
 CellLabel->
  "In[326]:=",ExpressionUUID->"63c2fdc5-6930-4d47-9090-ac300d493dec"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9957372624839134`*^9},
 CellLabel->
  "Out[326]=",ExpressionUUID->"4dcd000b-3a36-a54d-ba04-228231c7fdbb"]
}, Open  ]],

Cell["\<\
Two of the three are named quantities. \
\[OpenCurlyDoubleQuote]MutualInformationI\[CloseCurlyDoubleQuote] assembles  \
I(A:B) from the same three entropies, and \
\[OpenCurlyDoubleQuote]EntanglementEntropy\[CloseCurlyDoubleQuote] is the \
marginal entropy, which on a pure state is minus the conditional entropy; \
both carry a unit, as the entropies of 14.1 do:\
\>", "Text",
 CellChangeTimes->{{3.9957398232988663`*^9, 
  3.995739833158844*^9}},ExpressionUUID->"0ed9cb3b-d9ef-3f43-b45e-\
0a771a1735ee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"QuantumEntanglementMonotone", "[", 
      RowBox[{"qs", ",", "#"}], "]"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{"\"\<MutualInformationI\>\"", 
      ",", "\"\<EntanglementEntropy\>\""}], "}"}]}], ",", 
   RowBox[{"0", "<", "t", "<", 
    RowBox[{"Pi", "/", "2"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9957373033590755`*^9, 3.995737305199293*^9}},
 CellLabel->
  "In[381]:=",ExpressionUUID->"c030eca8-9b6f-3346-883f-0d3fb1416695"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[{
     RowBox[{"-", 
       FractionBox[
        RowBox[{"4", " ", 
          RowBox[{"(", 
            RowBox[{
              RowBox[{
                SuperscriptBox[
                 RowBox[{"Cos", "[", "t", "]"}], "2"], " ", 
                RowBox[{"Log", "[", 
                  RowBox[{"Cos", "[", "t", "]"}], "]"}]}], "+", 
              RowBox[{
                RowBox[{"Log", "[", 
                  RowBox[{"Sin", "[", "t", "]"}], "]"}], " ", 
                SuperscriptBox[
                 RowBox[{"Sin", "[", "t", "]"}], "2"]}]}], ")"}]}], 
        RowBox[{"Log", "[", "2", "]"}]]}], "\"b\"", "bits", "\"Bits\""},
    "Quantity"], ",", 
   TemplateBox[{
     RowBox[{"-", 
       FractionBox[
        RowBox[{"2", " ", 
          RowBox[{"(", 
            RowBox[{
              RowBox[{
                SuperscriptBox[
                 RowBox[{"Cos", "[", "t", "]"}], "2"], " ", 
                RowBox[{"Log", "[", 
                  RowBox[{"Cos", "[", "t", "]"}], "]"}]}], "+", 
              RowBox[{
                RowBox[{"Log", "[", 
                  RowBox[{"Sin", "[", "t", "]"}], "]"}], " ", 
                SuperscriptBox[
                 RowBox[{"Sin", "[", "t", "]"}], "2"]}]}], ")"}]}], 
        RowBox[{"Log", "[", "2", "]"}]]}], "\"b\"", "bits", "\"Bits\""},
    "Quantity"]}], "}"}]], "Output",
 CellChangeTimes->{3.9957373068111496`*^9, 3.9957398359886894`*^9, 
  3.9957399145366554`*^9},
 CellLabel->
  "Out[381]=",ExpressionUUID->"d0c99781-6f51-8b48-868f-07923d2e143a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantityMagnitude", "[", "%", "]"}], "===", 
  RowBox[{"(", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"sA", "+", "sB", "-", "sAB"}], ",", 
     RowBox[{"sB", "-", "sAB"}]}], "}"}], ")"}]}]], "Input",
 CellChangeTimes->{{3.9957373173102684`*^9, 3.9957373177097015`*^9}, {
   3.9957373656939716`*^9, 3.9957373734424553`*^9}, 3.9957398633622627`*^9, {
   3.995739917241543*^9, 3.995739921221094*^9}},
 CellLabel->
  "In[382]:=",ExpressionUUID->"cc97f54b-ae1a-8e42-a302-d08fad7f916d"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.995737318086706*^9, 3.995737373812895*^9, 
