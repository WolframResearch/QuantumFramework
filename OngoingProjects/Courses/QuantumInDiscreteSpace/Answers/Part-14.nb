}, Open  ]],

Cell["\<\
The relative-entropy measure from its definition, as a difference of two \
binary entropies of the two lengths that matter, the tilted projection and \
the full radius:\
\>", "Text",
 CellChangeTimes->{{3.9962471252385826`*^9, 
  3.9962471271432533`*^9}},ExpressionUUID->"fb082207-a1d4-f246-9c3e-\
5893faf61b3f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"vonNeumann", "[", 
      RowBox[{"delta", "[", "rho", "]"}], "]"}], "-", 
     RowBox[{"vonNeumann", "[", "rho", "]"}]}], "==", 
    RowBox[{
     RowBox[{"h2", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"r", " ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "/", "2"}], "]"}],
      "-", 
     RowBox[{"h2", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "r"}], ")"}], "/", "2"}], "]"}]}]}], ",", 
   RowBox[{
    RowBox[{"0", "<", "r", "<", "1"}], "&&", 
    RowBox[{"0", "<", "\[Theta]", "<", "Pi"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.996245622153616*^9, 3.996245641821909*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"2a94da2b-c85a-ae45-887e-4f6b8ac2a060"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9962456424753017`*^9},
 CellLabel->"Out[43]=",ExpressionUUID->"5ebaafdd-1daa-8f48-9172-3f2a309e0c71"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"relativeEntropy", "[", 
   RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Tr", "[", 
    RowBox[{"a", ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"MatrixLog", "[", "a", "]"}], "-", 
       RowBox[{"MatrixLog", "[", "b", "]"}]}], ")"}]}], "]"}], "/", 
   RowBox[{"Log", "[", "2", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.996245662273596*^9, 3.996245662715914*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"61c5f824-a983-984b-957a-7e748ac76024"],

Cell["\<\
That it is the divergence against the diagonal state is an identity, so the \
nonnegativity of 14.2 carries over without a new argument:\
\>", "Text",
 CellChangeTimes->{{3.9962471461032734`*^9, 
  3.9962471489715614`*^9}},ExpressionUUID->"fc7094f2-a589-f346-8983-\
a9e6d2b3308b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"vonNeumann", "[", 
     RowBox[{"delta", "[", "rho", "]"}], "]"}], "-", 
    RowBox[{"vonNeumann", "[", "rho", "]"}], "-", 
    RowBox[{"relativeEntropy", "[", 
     RowBox[{"rho", ",", 
      RowBox[{"delta", "[", "rho", "]"}]}], "]"}]}], ",", 
   RowBox[{
    RowBox[{"0", "<", "r", "<", "1"}], "&&", 
    RowBox[{"0", "<", "\[Theta]", "<", "\[Pi]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9962456673567753`*^9, 3.996245676588276*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"90753488-be3a-1549-bfb5-3ddbd8c212d3"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.9962456796148853`*^9},
 CellLabel->"Out[45]=",ExpressionUUID->"80ca68fa-4e8f-7646-b52d-eba0de728305"]
}, Open  ]],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["l", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b506184f-b8ca-3a47-bc9d-ae7e81ca8fa5"],
 " measure reads off the equator alone, seeing the radius and the tilt only \
through their product:"
}], "Text",
 CellChangeTimes->{{3.9962471754930744`*^9, 
  3.996247190351261*^9}},ExpressionUUID->"d0d981b1-4f97-7a49-9341-\
1c152805a46b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Abs", "/@", 
      RowBox[{"Flatten", "[", 
       RowBox[{"rho", "-", 
        RowBox[{"delta", "[", "rho", "]"}]}], "]"}]}], "]"}], "\[Equal]", 
    RowBox[{"r", " ", 
     RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ",", 
   RowBox[{
    RowBox[{"0", "<", "r", "<", "1"}], "&&", 
    RowBox[{"0", "<", "\[Theta]", "<", "\[Pi]"}]}]}], "]"}]], "Input",
