          RowBox[{"7", "-", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "]"}]}]}], 
    RowBox[{"Log", "[", "16", "]"}]], "\"b\"", "bits", "\"Bits\""},
