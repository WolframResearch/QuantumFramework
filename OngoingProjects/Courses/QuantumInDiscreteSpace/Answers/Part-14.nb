Cell[CellGroupData[{

Cell["\<\
14.7 [MSc] How do I assemble a channel-capacity estimate for a simple \
channel, the classical (Holevo) capacity or the quantum \
(coherent-information) capacity, from the entropic quantities above?\
\>", "Subsection",
 CellChangeTimes->{
  3.996233418972927*^9},ExpressionUUID->"8e985adf-fc65-424a-b227-\
b0755775c8df"],

Cell[TextData[{
 "Neither capacity is a new quantity. A channel is handed a state and returns \
one, so every entropic quantity can be evaluated on its output, and a \
capacity is what remains after the best input has been chosen. Sending each \
member of an ensemble through ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalN]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "74eaafb6-54fd-5643-b1ee-96931d26ad24"],
 " and taking the Holevo quantity of 14.6 on what comes out, then maximizing \
over the encoding, gives the classical quantity. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Chi]", "(", "\[ScriptCapitalN]", ")"}], "=", " ", 
    RowBox[{
     SubscriptBox["max", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["p", "i"], ",", " ", 
        SubscriptBox["\[Rho]", "i"]}], "}"}]], "[", 
     RowBox[{
      RowBox[{"S", "(", 
       RowBox[{"\[ScriptCapitalN]", "(", 
        RowBox[{
         SubscriptBox["\[Sum]", 
          RowBox[{" ", "i"}]], " ", 
         RowBox[{
          SubscriptBox["p", "i"], " ", 
          SubscriptBox["\[Rho]", "i"]}]}], ")"}], ")"}], "-", " ", 
      RowBox[{
       SubscriptBox["\[Sum]", 
        RowBox[{" ", "i"}]], " ", 
       RowBox[{
        SubscriptBox["p", "i"], " ", 
        RowBox[{"S", "(", 
         RowBox[{"\[ScriptCapitalN]", "(", 
          SubscriptBox["\[Rho]", "i"], ")"}], ")"}]}]}]}], "]"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e29df1e4-239b-794d-a41d-4d72a2c3e9ad"]
}], "Text",
 CellChangeTimes->{{3.996247415772232*^9, 3.996247428834944*^9}, {
  3.9962475198172283`*^9, 
  3.996247613989872*^9}},ExpressionUUID->"6945ef0f-f5e0-be44-95e2-\
2aa4b66ea6f1"],

Cell[TextData[{
 "And maximizing the coherent information of 14.4 over inputs gives the \
quantum one, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["Q", 
      RowBox[{"(", "1", ")"}]], "(", "\[ScriptCapitalN]", ")"}], " ", "=", 
    " ", 
    RowBox[{
     SubscriptBox["max", 
      RowBox[{" ", "\[Rho]"}]], " ", 
     RowBox[{
      SubscriptBox["I", "c"], "(", 
      RowBox[{"\[Rho]", ",", " ", "\[ScriptCapitalN]"}], ")"}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "614d9782-7bf3-cb4e-b7f8-4d1536581b74"]
}], "Text",
 CellChangeTimes->{{3.996247442036434*^9, 
  3.9962474904568424`*^9}},ExpressionUUID->"4a6e75ed-9ca5-3842-bf66-\
25b5b9c41a92"],

Cell[TextData[{
 "Take dephasing, which leaves the computational basis alone and randomizes \
the relative phase with probability ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "09f6ffe7-f166-e940-9005-bcaad85f9f6e"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"N", 
     RowBox[{"(", "\[Rho]", ")"}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "\[Minus]", "p"}], ")"}], "\[Rho]"}], "+", 
     "pZ\[Rho]Z"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "29a565be-9fdf-ba4d-873e-3b157c18d491"],
 ". Its classical side needs no search at all. The ceiling of 14.6 is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "\[LessEqual]", 
    RowBox[{
     SubscriptBox["log", "2"], " ", "d"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2aea4428-f525-0249-ba5d-5556559b7bb5"],
 " , one bit for a qubit, so an ensemble that reaches one bit is optimal by \
that bound alone and no optimization is required to certify it. The quantum \
side is a genuine maximization, and the two answers are different functions \
of ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0b3f4b75-466a-cf46-8473-f72b7adebc46"],
 ", which is the point of asking both."
}], "Text",
 CellChangeTimes->{{3.996247671828806*^9, 
  3.996247764374916*^9}},ExpressionUUID->"7369ec23-428c-a848-9d6a-\
1402af0f825d"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.996233626965122*^9, 
  3.9962336297050056`*^9}},ExpressionUUID->"20bd6427-e5fa-4645-a5d0-\
0d9ab16fc125"],

Cell["\<\
The entropy off the spectrum, and the binary entropy the diagonal states will \
reduce to:\
\>", "Text",
 CellChangeTimes->{{3.9962367216023006`*^9, 
  3.9962367269675007`*^9}},ExpressionUUID->"78ab3aaa-f068-d448-aaf1-\
135dda714d4f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vonNeumann", "[", "m_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"#", ".", 
      RowBox[{"Log", "[", 
       RowBox[{"2", ",", "#"}], "]"}]}]}], "&"}], "@", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", "m", "]"}], ",", "0"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.99623503744277*^9, 3.996235038025934*^9}, {
  3.9962357702655506`*^9, 
  3.9962357708853207`*^9}},ExpressionUUID->"13b470c1-17f6-264e-b881-\
e61daa096f22"],

Cell[BoxData[
 RowBox[{
  RowBox[{"h2", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "x"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"2", ",", "x"}], "]"}]}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"2", ",", 
      RowBox[{"1", "-", "x"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.996235042735754*^9, 3.996235043245758*^9}},
 CellLabel->
  "In[103]:=",ExpressionUUID->"6af675c9-9aa7-294c-a42c-7692d6ea0f6b"],

Cell["\<\
The channel as its Kraus pair, which is a channel only if the pair preserves \
the trace:\
\>", "Text",
 CellChangeTimes->{{3.9962367401657143`*^9, 
  3.9962367412155056`*^9}},ExpressionUUID->"ac7fcac9-9761-cd43-8472-\
8d6dc736d192"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kraus", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SqrtBox[
       RowBox[{"1", "-", "p"}]], " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
     RowBox[{
      SqrtBox["p"], " ", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996235048429987*^9, 3.99623505739229*^9}},
 CellLabel->
  "In[164]:=",ExpressionUUID->"5fde5d82-9298-0a40-9f1b-ee63a55d184e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", "#1", "]"}], ".", "#1"}], "&"}], 
       ")"}], "/@", "kraus"}], "]"}], "\[Equal]", 
    RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
   RowBox[{"0", "<", "p", "<", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9962350630858*^9, 3.9962350646461277`*^9}},
 CellLabel->
  "In[163]:=",ExpressionUUID->"34f8d2fa-5d89-c548-9da2-725e1bf2303e"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.996235067161541*^9, 3.996236751513214*^9},
 CellLabel->
  "Out[163]=",ExpressionUUID->"e8fa8efe-e730-ae4f-88ee-22b155443636"]
}, Open  ]],

Cell["Channel and Bloch builders:", "Text",
 CellChangeTimes->{{3.996236766490526*^9, 
  3.9962367725217247`*^9}},ExpressionUUID->"2ec4c517-37cb-c545-95fb-\
cae0e64cbe0f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"chan", "[", "m_", "]"}], ":=", 
  RowBox[{"Total", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"#", ".", "m", ".", 
      RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], "&"}], "/@", "kraus"}],
    "]"}]}]], "Input",
 CellChangeTimes->{{3.9962350754383926`*^9, 3.9962350760528965`*^9}},
 CellLabel->
  "In[107]:=",ExpressionUUID->"2e55b1b4-cdc3-bb40-b5f8-205ea5cbc1d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bloch", "[", "v_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
     RowBox[{"v", ".", 
      RowBox[{"PauliMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], ")"}], "/", 
   "2"}]}]], "Input",
 CellChangeTimes->{{3.996235081056265*^9, 3.996235081463093*^9}},
 CellLabel->
  "In[108]:=",ExpressionUUID->"2686a14e-9646-724f-99ac-25498911c854"],

Cell["Define the Holevo bound:", "Text",
 CellChangeTimes->{{3.9962367947901344`*^9, 
  3.9962367986817703`*^9}},ExpressionUUID->"4da2470f-0868-7c47-83a4-\
ca7c7baadac4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"holevo", "[", 
   RowBox[{"ps_", ",", "rhos_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"vonNeumann", "[", 
    RowBox[{"ps", ".", "rhos"}], "]"}], "-", 
   RowBox[{"ps", ".", 
    RowBox[{"(", 
     RowBox[{"vonNeumann", "/@", "rhos"}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.996235087966955*^9, 3.996235088407116*^9}},
 CellLabel->
  "In[109]:=",ExpressionUUID->"797e2452-1489-6c4a-837f-ea4f4f24cc10"],

Cell["\<\
A code is a choice of ensemble, so the Holevo quantity of the output is a \
function of the basis it is written in:\
\>", "Text",
 CellChangeTimes->{{3.996236790616518*^9, 
  3.99623679259066*^9}},ExpressionUUID->"c2e77215-1ce2-6044-a98d-\
79032afb7deb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wlChi", "[", 
   RowBox[{"ps_", ",", "vs_"}], "]"}], ":=", 
  RowBox[{"holevo", "[", 
   RowBox[{"ps", ",", 
    RowBox[{"chan", "/@", 
     RowBox[{"(", 
      RowBox[{"bloch", "/@", "vs"}], ")"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9962358059960823`*^9, 3.996235806955879*^9}, {
  3.996236888939028*^9, 3.996236889631319*^9}},
 CellLabel->
  "In[165]:=",ExpressionUUID->"2a6fd855-f01a-5748-a0ce-9a6ded981412"],

Cell["For a code written in the basis the channel does not touch:", "Text",
 CellChangeTimes->{{3.9962368106358833`*^9, 
  3.9962368122404385`*^9}},ExpressionUUID->"d4a1b0f7-7272-084e-baf0-\
7dc9b9e24226"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"wlChi", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"0", "<", "p", "<", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.996235823636673*^9, 3.9962358242541122`*^9}, {
  3.9962369027480984`*^9, 3.9962369034542904`*^9}},
 CellLabel->
  "In[166]:=",ExpressionUUID->"a7aa6597-df14-fb4e-86b7-41a3aea55c90"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.9962358247865314`*^9, 3.9962369039318733`*^9},
 CellLabel->
  "Out[166]=",ExpressionUUID->"0b6d10e2-f37c-174b-aa75-709faab56903"]
}, Open  ]],

Cell["\<\
And for one written in the basis the channel randomizes, which is what makes \
the choice of encoding a real one rather than a formality:\
\>", "Text",
 CellChangeTimes->{{3.996236824227564*^9, 
  3.9962368273820877`*^9}},ExpressionUUID->"7f2704a1-740f-074d-8580-\
2d558da03913"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"wlChi", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{"1", "/", "2"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], "}"}]}], "]"}], "==", 
    RowBox[{"1", "-", 
     RowBox[{"h2", "[", "p", "]"}]}]}], ",", 
   RowBox[{"0", "<", "p", "<", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9962358307364635`*^9, 3.9962358322314625`*^9}, {
  3.99623691044812*^9, 3.9962369252121162`*^9}},
 CellLabel->
  "In[168]:=",ExpressionUUID->"fa2fde77-8b96-8d4d-b8e6-7f4283948759"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{
  3.996235833826868*^9, {3.9962369227106686`*^9, 3.996236925709923*^9}},
 CellLabel->
  "Out[168]=",ExpressionUUID->"79e7f559-ed3b-d14d-bf73-6b37a7e54c02"]
}, Open  ]],

Cell["Define the state and compute the entropic quantities:", "Text",
 CellChangeTimes->{{3.996237036557823*^9, 3.9962370372488804`*^9}, {
  3.996237122718855*^9, 
  3.996237136917803*^9}},ExpressionUUID->"a4aa5372-41f8-1845-8c59-\
73ac18d8d046"],

Cell[BoxData[
 RowBox[{
  RowBox[{"psi", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "r"}], ")"}], "/", "2"}], "]"}], ",", "0", ",", "0",
      ",", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "r"}], ")"}], "/", "2"}], "]"}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9962358379767056`*^9, 3.996235842387518*^9}},
 CellLabel->
  "In[142]:=",ExpressionUUID->"d186ac7b-e19d-0543-8e22-8de2a8771833"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rhoRB", "=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k", "=", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"#", ",", 
            RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"k", ".", 
         RowBox[{"Outer", "[", 
          RowBox[{"Times", ",", "psi", ",", 
           RowBox[{"Conjugate", "[", "psi", "]"}]}], "]"}], ".", 
         RowBox[{"ConjugateTranspose", "[", "k", "]"}]}]}], "]"}], "&"}], "/@",
      "kraus"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996235847047165*^9, 3.9962358521197224`*^9}, {
  3.9962369380210934`*^9, 3.9962369457467213`*^9}},
 CellLabel->
  "In[169]:=",ExpressionUUID->"b519f08d-4f52-3743-932c-6aaf8850fb46"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rhoB", "=", 
   RowBox[{"TensorContract", "[", 
    RowBox[{
     RowBox[{"ArrayReshape", "[", 
      RowBox[{"rhoRB", ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9962358562694645`*^9, 3.9962358595893574`*^9}, {
  3.9962369518554935`*^9, 3.9962369523463726`*^9}},
 CellLabel->
  "In[170]:=",ExpressionUUID->"67fea49e-fc8c-c542-b546-30d932d98eb5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ic", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"vonNeumann", "[", "rhoB", "]"}], "-", 
     RowBox[{"vonNeumann", "[", "rhoRB", "]"}]}], ",", 
    RowBox[{
     RowBox[{"0", "<", "p", "<", "1"}], "&&", 
     RowBox[{
      RowBox[{"-", "1"}], "<", "r", "<", "1"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9962358633420773`*^9, 3.9962358636675243`*^9}, {
  3.9962369584423695`*^9, 3.9962369588701706`*^9}},
 CellLabel->
  "In[171]:=",ExpressionUUID->"fe55f14b-42e4-7140-ac1e-b9c48ecc4099"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", "2"}], " ", "r", " ", 
    RowBox[{"ArcTanh", "[", "r", "]"}]}], "+", 
   RowBox[{"2", " ", 
    SqrtBox[
     RowBox[{"1", "-", 
      RowBox[{"4", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "p"}], ")"}], " ", "p", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["r", "2"]}], ")"}]}]}]], " ", 
    RowBox[{"ArcTanh", "[", 
     SqrtBox[
      RowBox[{"1", "-", 
       RowBox[{"4", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "p"}], ")"}], " ", "p", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["r", "2"]}], ")"}]}]}]], "]"}]}], "+", 
   RowBox[{"Log", "[", 
    RowBox[{
     RowBox[{"-", "4"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "p"}], ")"}], " ", "p"}], "]"}]}], 
  RowBox[{"Log", "[", "4", "]"}]]], "Output",
 CellChangeTimes->{3.9962358641413803`*^9, 3.996236959291418*^9},
 CellLabel->
  "Out[171]=",ExpressionUUID->"b7b17a2a-5eed-1845-82c0-110ae6b4dd25"]
}, Open  ]],

Cell["The three numbers the two estimates are made of:", "Text",
 CellChangeTimes->{{3.9962369948944283`*^9, 
  3.996237003758257*^9}},ExpressionUUID->"479bd71e-bd81-5f49-bccf-\
f9fa53358097"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"wlCaps", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"wlChi", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", 
          RowBox[{"1", "/", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", 
            RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"wlChi", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", 
          RowBox[{"1", "/", "2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], "}"}]}], "]"}],
       ",", 
      RowBox[{"Limit", "[", 
       RowBox[{"ic", ",", 
        RowBox[{"r", "->", "0"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"0", "<", "p", "<", "1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.996235877931942*^9, 3.9962358783292236`*^9}, {
  3.996236986083687*^9, 3.996236986525305*^9}},
 CellLabel->
  "In[173]:=",ExpressionUUID->"05654cc7-3325-2b47-9b40-463888eb77ff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", 
   FractionBox[
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"2", "-", 
       RowBox[{"2", " ", "p"}]}], "]"}], "+", 
     RowBox[{"p", " ", 
      RowBox[{"Log", "[", 
       RowBox[{"-", 
        FractionBox["p", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "p"}]]}], "]"}]}]}], 
    RowBox[{"Log", "[", "2", "]"}]], ",", 
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "-", 
        RowBox[{"4", " ", "p"}]}], ")"}], " ", 
      RowBox[{"ArcTanh", "[", 
       RowBox[{"1", "-", 
        RowBox[{"2", " ", "p"}]}], "]"}]}], "+", 
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{"-", "4"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "p"}], ")"}], " ", "p"}], "]"}]}], 
    RowBox[{"Log", "[", "4", "]"}]]}], "}"}]], "Output",
 CellChangeTimes->{3.99623587889254*^9, 3.9962369871605988`*^9},
 CellLabel->
  "Out[173]=",ExpressionUUID->"7171f5cf-69a9-8342-ae3b-997317b7dd6f"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9962336316503906`*^9, 
  3.996233636013336*^9}},ExpressionUUID->"5b11f3d8-54c7-3143-a585-\
06ba5119628d"],

Cell["Bloch vectors:", "Text",
 CellChangeTimes->{{3.9962373339269886`*^9, 
  3.996237355037943*^9}},ExpressionUUID->"3e6418b5-45fe-0942-880e-\
3d0a01ae665c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qens", "[", "vs_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"\"\<BlochVector\>\"", "[", "#", "]"}], "]"}], "&"}], "/@", 
   "vs"}]}]], "Input",
 CellChangeTimes->{{3.9962352347324467`*^9, 3.996235235590679*^9}, {
  3.996237158902807*^9, 3.9962371594045715`*^9}},
 CellLabel->
  "In[185]:=",ExpressionUUID->"1caf7fdc-cd9f-cd48-86c0-66dba1278107"],

Cell["Register states:", "Text",
 CellChangeTimes->{{3.996237357896267*^9, 
  3.9962373607598763`*^9}},ExpressionUUID->"9e1901f4-77f7-b04f-830d-\
bb5847632817"],

Cell[BoxData[
 RowBox[{
  RowBox[{"reg", "[", "n_", "]"}], ":=", 
  RowBox[{
   RowBox[{"QuantumBasis", "[", "n", "]"}], "[", "\"\<BasisStates\>\"", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9962371741983337`*^9, 3.9962371749980927`*^9}, {
  3.996237289506588*^9, 3.99623729747983*^9}},
 CellLabel->
  "In[186]:=",ExpressionUUID->"61d411bf-a7fb-9e4e-8cf3-7ba8569038d2"],

Cell["Classical-quantum state:", "Text",
 CellChangeTimes->{{3.99623736352425*^9, 
  3.996237367098665*^9}},ExpressionUUID->"727b5830-ad99-b547-af92-\
7e3382b9265b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qcq", "[", 
   RowBox[{"ps_", ",", "qs_"}], "]"}], ":=", 
  RowBox[{"ps", ".", 
   RowBox[{"MapThread", "[", 
    RowBox[{"Construct", ",", 
     RowBox[{"{", 
      RowBox[{"qs", ",", 
       RowBox[{"reg", "[", 
        RowBox[{"Length", "[", "ps", "]"}], "]"}]}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.996235261341305*^9, 3.996235300380398*^9}, {
  3.9962371822912064`*^9, 3.9962371837698154`*^9}},
 CellLabel->
  "In[187]:=",ExpressionUUID->"a823c9f0-19ec-b04d-ba99-08ed849169b6"],

Cell["Mutual information after channel application:", "Text",
 CellChangeTimes->{{3.9962373746788425`*^9, 
  3.9962373826404896`*^9}},ExpressionUUID->"2caea1a6-d449-cc42-a8be-\
34964b7a6b88"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qchi", "[", 
   RowBox[{"ps_", ",", "qs_"}], "]"}], ":=", 
  RowBox[{"QuantityMagnitude", "@", 
   RowBox[{"QuantumEntanglementMonotone", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumChannel", "[", 
       RowBox[{
        RowBox[{"\"\<PhaseFlip\>\"", "[", "p", "]"}], ",", 
        RowBox[{"{", "2", "}"}]}], "]"}], "[", 
      RowBox[{"qcq", "[", 
       RowBox[{"ps", ",", "qs"}], "]"}], "]"}], 
     ",", "\"\<MutualInformationI\>\""}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.996235308658869*^9, 3.9962353220073223`*^9}, {
  3.9962359606901836`*^9, 3.996235961530388*^9}, {3.9962371932800484`*^9, 
  3.996237194134428*^9}},
 CellLabel->
  "In[188]:=",ExpressionUUID->"e7f9087b-0814-324e-b611-a878935f201e"],

Cell["\<\
For the quantum estimate the optimal input is the one the maximization above \
lands on, and a state purifies itself(Bell state is the purified form of a \
maximum mixed state):\
\>", "Text",
 CellChangeTimes->{{3.996237401057392*^9, 
  3.9962374447168484`*^9}},ExpressionUUID->"de249a21-bf12-2b4c-91c2-\
0dace6438152"],

Cell[CellGroupData[{

Cell[BoxData[
