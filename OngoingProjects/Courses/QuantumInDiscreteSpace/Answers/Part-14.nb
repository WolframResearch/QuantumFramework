           FractionBox["1", "2"]}], ")"}]}], "]"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      FractionBox[
       RowBox[{"Sin", "[", 
        FractionBox["\[Pi]", "4"], "]"}], 
