        TraditionalForm]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], "-", "p"}], ")"}], 
       FormBox[
        InterpretationBox[
         RowBox[{
          FormBox[
           InterpretationBox[
            StyleBox[
