       RowBox[{"qout", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}], "[", 
      RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}], ",", 
     RowBox[{"qout", "[", 
      RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}]}], "}"}], ",", 
   RowBox[{"0", "<", "p", "<", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.996237216264473*^9, 3.9962372166987534`*^9}},
