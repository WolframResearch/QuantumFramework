Cell["It is non-negative:", "Text",
 CellChangeTimes->{{3.9957289431839905`*^9, 
  3.9957289461396847`*^9}},ExpressionUUID->"c9ea70b9-93ff-7140-bf6b-\
3634621194a2"],

