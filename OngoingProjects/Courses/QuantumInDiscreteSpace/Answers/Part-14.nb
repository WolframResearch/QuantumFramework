1d0219f67513"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"qfCaps", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"qchi", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", 
          RowBox[{"1", "/", "2"}]}], "}"}], ",", 
        RowBox[{"qens", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "}"}], "]"}]}], "]"}], ",", 
      RowBox[{"qchi", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", 
          RowBox[{"1", "/", "2"}]}], "}"}], ",", 
        RowBox[{"qens", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], "}"}], 
         "]"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumPartialTrace", "[", 
         RowBox[{"qout", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "[", 
        RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}], "-", 
       RowBox[{"qout", "[", 
        RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}]}]}], "}"}], ",", 
    RowBox[{"0", "<", "p", "<", "1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9962372242132034`*^9, 3.9962372268237915`*^9}},
 CellLabel->
  "In[179]:=",ExpressionUUID->"02b22deb-02b3-4240-a96e-fa9202c3878c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", 
   FractionBox[
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"2", "-", 
       RowBox[{"2", " ", "p"}]}], "]"}], "+", 
     RowBox[{"p", " ", 
      RowBox[{"Log", "[", 
       RowBox[{"-", 
        FractionBox["p", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "p"}]]}], "]"}]}]}], 
    RowBox[{"Log", "[", "2", "]"}]], ",", 
   FractionBox[
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"2", "-", 
       RowBox[{"2", " ", "p"}]}], "]"}], "+", 
     RowBox[{"p", " ", 
      RowBox[{"Log", "[", 
       RowBox[{"-", 
        FractionBox["p", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "p"}]]}], "]"}]}]}], 
    RowBox[{"Log", "[", "2", "]"}]]}], "}"}]], "Output",
 CellChangeTimes->{3.9962372283495655`*^9},
 CellLabel->
