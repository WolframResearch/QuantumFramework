Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantityMagnitude", "[", 
     RowBox[{"{", 
      RowBox[{"qchi", ",", "qmi"}], "}"}], "]"}], "-", 
    RowBox[{"holevo", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{"1", "/", "2"}]}], "}"}], ",", "ens"}], "]"}]}], ",", 
   RowBox[{"0", "<", "\[Theta]", "<", "Pi"}]}], "]"}]], "Input",
