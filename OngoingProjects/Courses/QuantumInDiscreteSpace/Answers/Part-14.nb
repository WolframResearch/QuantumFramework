Cell[CellGroupData[{

Cell[TextData[{
 "14.8 [MSc] How do I quantify the coherence of a state in a fixed basis by \
the relative-entropy  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["C", "rel"], "(", "\[Rho]", ")"}], "=", 
    RowBox[{
     RowBox[{"S", "(", 
      SubscriptBox["\[Rho]", "diag"], ")"}], "-", 
     RowBox[{"S", "(", "\[Rho]", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "8c0bd140-d70b-fc42-846d-fd152c8e5117"],
 " or ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["l", "1"], TraditionalForm]],ExpressionUUID->
  "3dab2399-a877-cf42-b496-99f0df06b09c"],
 " measure ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["C", 
      SubscriptBox["l", "1"]], "(", "\[Rho]", ")"}], "=", " ", 
    RowBox[{
     SubscriptBox["\[Sum]", 
      RowBox[{" ", 
       RowBox[{"i", "\[NotEqual]", " ", "j"}]}]], 
     RowBox[{Cell["|",ExpressionUUID->"a1483ae6-fd52-1246-90b0-257d44ca940e"], 
      SubscriptBox["\[Rho]", 
       RowBox[{"i", ",", " ", "j"}]], Cell[
      "|",ExpressionUUID->"b2d3c816-802d-054d-af67-5dd0c4d1e6c8"]}]}]}], 
   TraditionalForm]],ExpressionUUID->"4b8ba2e1-d427-7b41-b73a-644e62bc97c0"],
 "?"
}], "Subsection",
 CellChangeTimes->{
  3.9962334315866375`*^9, {3.9962335001674385`*^9, 
   3.99623361533197*^9}},ExpressionUUID->"25d167e4-d277-7b46-8349-\
c130fc3b0102"],

Cell[TextData[{
 "Coherence is not a property of a state alone. Fixing a basis splits the \
states into the diagonal ones, which carry none of it, and the rest, and both \
measures above are ways of asking how far \[Rho] sits from its own diagonal \
part  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", "diag"], "=", 
    RowBox[{"\[CapitalDelta]", "(", "\[Rho]", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "92f4888e-af3b-9e4b-9faf-88c48f650360"],
 ", where ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2d19da75-ff19-654a-9824-b931b925520c"],
 " deletes the off-diagonal entries. That map is a channel, the one that \
measures in the chosen basis and forgets the outcome, so the question is how \
much is lost when it acts."
}], "Text",
 CellChangeTimes->{{3.99624676159301*^9, 
  3.996246814718012*^9}},ExpressionUUID->"2a227f54-2084-ed4e-98db-\
a052d8d4f94b"],

Cell[TextData[{
 "The relative-entropy measure is not a new quantity at all. Since \
\[CapitalDelta](\[Rho]) and \[Rho] share their diagonal, the two terms of S(\
\[CapitalDelta]\[Rho])\[Minus]S(\[Rho]) reassemble into the divergence of \
14.2 against the diagonal state, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["C", "rel"], "(", "\[Rho]", ")"}], "=", 
    RowBox[{"S", "(", 
     RowBox[{"\[Rho]", " ", "||", " ", 
      RowBox[{"\[CapitalDelta]", "(", "\[Rho]", ")"}]}], ")"}], " "}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9a3e0ca5-9178-2445-9182-1e2554e8bf05"],
 "such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", "rel"], ">=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "393d8aef-1ac8-1943-9cc0-34fca7f98157"],
 " with equality only for diagonal states. The ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["l", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8ac89161-4072-144c-8e68-ae899d33b8bb"],
 "measure has no such reading: it is a sum of moduli of matrix entries, fixed \
by the basis rather than derived from an entropy."
}], "Text",
 CellChangeTimes->{{3.996246842322382*^9, 3.9962469384345703`*^9}, {
  3.9962469693716793`*^9, 
  3.9962469823494606`*^9}},ExpressionUUID->"cbb61b65-a818-f146-8169-\
dd1bd82781d8"],

Cell[TextData[{
 "For a qubit write the Bloch vector in polar form, ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["r", "\[RightVector]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "066a755d-ef85-e642-bf59-802c9617a883"],
 " =\[Rho](sin\[Theta],0,cos\[Theta]), so that \[Rho] is the length and \
\[Theta] the tilt away from the axis the basis picks out. The two measures \
then depend on those two numbers differently, which is what makes them \
inequivalent rather than two scales for one thing."
}], "Text",
 CellChangeTimes->{{3.9962469931046524`*^9, 
  3.9962470352281094`*^9}},ExpressionUUID->"c243785f-1b4c-1c40-a0ba-\
4302546ba429"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.996233626965122*^9, 
  3.9962336297050056`*^9}},ExpressionUUID->"d2e6a862-c284-fc4a-9ce7-\
3fcde6905155"],

Cell["Generic mixed qubit state:", "Text",
 CellChangeTimes->{{3.996247048023447*^9, 
  3.9962470544418354`*^9}},ExpressionUUID->"b703f5d4-725e-f94a-b7de-\
9de98ed815a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bloch", "[", "v_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
     RowBox[{"v", ".", 
      RowBox[{"PauliMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], ")"}], "/", 
   "2"}]}]], "Input",
 CellChangeTimes->{{3.9962449735171356`*^9, 3.9962449741872234`*^9}, {
  3.9962452158568726`*^9, 3.996245227315201*^9}, {3.996245264188036*^9, 
  3.996245278624651*^9}},ExpressionUUID->"c3d28d8b-4437-c34f-a7dd-\
b0187acbe1d4"],

Cell["Entropy definition:", "Text",
 CellChangeTimes->{{3.9962470573707314`*^9, 
  3.996247063476774*^9}},ExpressionUUID->"0e4392cf-a0cf-da40-9b35-\
186429b90be0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vonNeumann", "[", "m_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"#", ".", 
      RowBox[{"Log", "[", 
       RowBox[{"2", ",", "#"}], "]"}]}]}], "&"}], "@", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", "m", "]"}], ",", "0"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.996245279876898*^9, 3.9962452803268433`*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"2138029b-e46a-584c-a787-bcf4f9dd4086"],

Cell["Binary entropy  the diagonal state reduces to:", "Text",
 CellChangeTimes->{{3.9962470709680386`*^9, 
  3.9962470793546867`*^9}},ExpressionUUID->"20848981-9359-224c-968e-\
0cb12f9534c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"h2", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "x"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"2", ",", "x"}], "]"}]}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"2", ",", 
      RowBox[{"1", "-", "x"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.996245286794405*^9, 3.996245287378294*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"f688af10-bbb5-ad4a-883c-9224ebc9b5e7"],

Cell["The incoherent projection:", "Text",
 CellChangeTimes->{{3.996247090361204*^9, 
  3.9962470935365124`*^9}},ExpressionUUID->"5e4c0b46-511a-8d45-b84b-\
147752c14792"],

Cell[BoxData[
 RowBox[{
  RowBox[{"delta", "[", "m_", "]"}], ":=", 
  RowBox[{"DiagonalMatrix", "[", 
