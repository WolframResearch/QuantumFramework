  3.995728744080183*^9, 3.9957287518114777`*^9}, {3.995728787460144*^9, 
  3.9957288093339405`*^9}, {3.9957288422151127`*^9, 3.9957288722172623`*^9}, {
  3.9957289187577267`*^9, 3.99572892258963*^9}},
