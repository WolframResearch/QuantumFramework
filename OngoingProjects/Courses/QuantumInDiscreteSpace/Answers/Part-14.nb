}, Open  ]],

Cell["\<\
The incoherent projection is a named channel, full phase damping:\
\>", "Text",
 CellChangeTimes->{{3.99624592990773*^9, 
  3.9962459423634453`*^9}},ExpressionUUID->"65916f61-b301-074b-a4bb-\
c4b20f0191d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qdelta", "=", 
   RowBox[{"QuantumChannel", "[", 
    RowBox[{"\"\<PhaseDamping\>\"", "[", "1", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9962458499637527`*^9, 3.9962458650596046`*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"54355ae7-8fad-b24b-8867-17f1520b2b7b"],

Cell["Verify all the coherences are lost:", "Text",
