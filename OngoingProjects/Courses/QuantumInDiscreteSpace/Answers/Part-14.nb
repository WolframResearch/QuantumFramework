Cell["\<\
Rotating the reference is the freedom in the choice of purification, and it \
moves neither entropy:\
\>", "Text",
 CellChangeTimes->{{3.9960654929441547`*^9, 
  3.996065494149597*^9}},ExpressionUUID->"a52543f7-3560-bc4b-b9a0-\
d76e1203f07f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rotated", "=", 
     RowBox[{"channel", "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<H\>\"", ",", 
         RowBox[{"{", "2", "}"}]}], "]"}], "[", "qpsi", "]"}], "]"}]}], "}"}],
    ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"QuantumPartialTrace", "[", 
          RowBox[{"rotated", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}], "[", 
         RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}], ",", 
        RowBox[{"rotated", "[", 
         RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}]}], "}"}], "\[Equal]",
       "qpair"}], ",", 
     RowBox[{
      RowBox[{"0", "<", "p", "<", "1"}], "&&", 
      RowBox[{"0", "<", "\[Gamma]", "<", "1"}]}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.995993236121063*^9, 3.9959932466233215`*^9}, 
   3.9960654983558025`*^9},
 CellLabel->
  "In[100]:=",ExpressionUUID->"579e2a2c-52a0-8941-8f2b-30a5204fb971"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9959932496967545`*^9, 3.9960655178942585`*^9},
 CellLabel->
  "Out[100]=",ExpressionUUID->"474c49f4-640a-5541-ae5e-5edd484fb6fc"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
14.5 [MSc] How do I verify the data-processing inequality under a channel?\
\>", "Subsection",
 CellChangeTimes->{{3.996070872738119*^9, 3.99607087333823*^9}, 
   3.9961659659170055`*^9},ExpressionUUID->"455144b8-8d26-ca4d-a907-\
a5ec9ce554b8"],

Cell[TextData[{
 "The relative entropy of 14.2 measures how well one state can be told from \
another, so the one thing a noisy process must never do is raise it. For \
every channel \[ScriptCapitalN] and every pair of states, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"S", "(", 
     RowBox[{
      RowBox[{"\[ScriptCapitalN]", "(", "\[Rho]", ")"}], "||", " ", 
      RowBox[{"\[ScriptCapitalN]", "(", "\[Sigma]", ")"}]}], ")"}], "<=", " ", 
    RowBox[{"S", "(", 
     RowBox[{"\[Rho]", " ", "||", " ", "\[Sigma]"}], ")"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5ac27c5f-a9e5-854a-babb-384755440ad1"],
 ". Anything that could be learned about which of \[Rho] or \[Sigma] was \
prepared, by measuring after the channel, could already have been learned by \
measuring before it, since the channel itself is one of the things a \
measurement could have done first. Equality is the exceptional case,  it \
holds exactly when the channel is reversible on that particular pair, in the \
sense that a recovery map returns both states unchanged."
}], "Text",
 CellChangeTimes->{{3.9961659756377583`*^9, 
  3.996166081120964*^9}},ExpressionUUID->"29014da6-d4d1-aa46-ba73-\
38789e6ce0a4"],

Cell[TextData[{
 "The entropy bounds already used are all this statement applied to a chosen \
pair, and the nearest one is the mutual information of 14.3. Reading it as a \
relative entropy,  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"I", "(", 
     RowBox[{"A", ":", "B"}], ")"}], "=", 
    RowBox[{"S", "(", 
     RowBox[{
      SubscriptBox["\[Rho]", "AB"], " ", "||", " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "A"], "\[CircleTimes]", " ", 
       SubscriptBox["\[Rho]", "B"]}]}], ")"}], " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "637d9556-55b4-7e48-a59f-0a6556edeedf"],
 ", a channel  acting on ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "81b390ca-0176-6746-bc1b-08cc7b40160b"],
 " alone  carries ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "AB"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2884937a-caee-e14c-8d88-53f7aa2921b7"],
 " to the processed state and carries ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", "A"], "\[CircleTimes]", " ", 
    SubscriptBox["\[Rho]", "B"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6a01196d-5408-a149-8768-550b54eab905"],
 " to the product of the new marginals, so both arguments move together and \
the inequality applies. "
}], "Text",
 CellChangeTimes->{{3.9961661587193127`*^9, 
  3.996166334176342*^9}},ExpressionUUID->"1812aedc-5de3-9b46-8eae-\
91b3e8d81b92"],

Cell[TextData[{
 "For a channel take depolarizing noise, which mixes a state with the \
maximally mixed one and so shrinks its Bloch vector, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["r", "\[RightVector]"], "->", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "p"}], ")"}], 
     OverscriptBox["r", "\[RightVector]"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e8cba8de-1e1d-0344-a3c5-ac2c4f4d5ee7"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2c8235bd-833b-1841-b17a-01fcb9e08c80"],
 " the identity and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "df80d886-257f-e242-8394-a31f91a09745"],
 " total erasure. The two states are taken non-commuting, so that what is \
being contracted is genuinely quantum distinguishability rather than the \
classical divergence of two diagonal distributions."
}], "Text",
 CellChangeTimes->{
  3.9961663451250286`*^9, {3.9961663938545284`*^9, 
   3.9961664621241207`*^9}},ExpressionUUID->"1c818439-c555-a54f-b160-\
6f4e156b1f10"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9961664641541977`*^9, 
  3.996166466703907*^9}},ExpressionUUID->"074aa2c6-13a3-e142-9244-\
d7043a5a4d97"],

Cell["State builder:", "Text",
 CellChangeTimes->{{3.99616647322789*^9, 
  3.996166474828396*^9}},ExpressionUUID->"021d9e54-53ae-3443-b2ac-\
ea7c84bd0597"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bloch", "[", "v_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
     RowBox[{"v", ".", 
      RowBox[{"PauliMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], ")"}], "/", 
   "2"}]}]], "Input",
 CellChangeTimes->{{3.996166478469063*^9, 3.99616647948518*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"4aa4f158-ee3c-7e40-8597-58a5fd86a8a3"],

Cell["Relative entropy:", "Text",
 CellChangeTimes->{{3.9961664859383144`*^9, 
  3.996166489058769*^9}},ExpressionUUID->"351d26ea-540b-d34e-957d-\
1041a1a7d4e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"relativeEntropy", "[", 
   RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Tr", "[", 
    RowBox[{"a", ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"MatrixLog", "[", "a", "]"}], "-", 
       RowBox[{"MatrixLog", "[", "b", "]"}]}], ")"}]}], "]"}], "/", 
   RowBox[{"Log", "[", "2", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9961664901174583`*^9, 3.996166490683071*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"27714624-d029-6846-98a8-25297d3c3322"],

Cell["Kraus operators for a depolarizing channel:", "Text",
 CellChangeTimes->{{3.9961666342532444`*^9, 
  3.996166641889305*^9}},ExpressionUUID->"bc7a2268-761d-2544-8c5b-\
657ff2702335"],

Cell[BoxData[
 RowBox[{
  RowBox[{"krausOps", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SqrtBox[
       RowBox[{"1", "-", 
        RowBox[{"3", 
         RowBox[{"p", "/", "4"}]}]}]], ",", 
      SqrtBox[
       RowBox[{"p", "/", "4"}]], ",", 
      SqrtBox[
       RowBox[{"p", "/", "4"}]], ",", 
      SqrtBox[
       RowBox[{"p", "/", "4"}]]}], "}"}], 
    RowBox[{"Array", "[", 
     RowBox[{"PauliMatrix", ",", "4", ",", "0"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996166505714281*^9, 3.996166505714281*^9}, {
  3.9961666143848057`*^9, 3.9961666269231434`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"d19382f6-39f4-b441-bffe-e9f0821f74d9"],

Cell["Define the channel:", "Text",
 CellChangeTimes->{{3.9961666642852535`*^9, 
  3.996166667435932*^9}},ExpressionUUID->"93420b67-3c9e-cc4c-8159-\
d06101975df3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"depolarize", "[", "m_", "]"}], ":=", 
  RowBox[{"Total", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"#", ".", "m", ".", 
      RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], "&"}], "/@", 
    "krausOps"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9961666570779076`*^9, 3.9961666574966087`*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"8fab7b60-652a-b34c-8edc-96c4dc85a294"],

Cell["Verify the Bloch vector contraction:", "Text",
 CellChangeTimes->{{3.9961668179895554`*^9, 
  3.9961668284612637`*^9}},ExpressionUUID->"0df659b1-a411-4944-acaf-\
06144a229fd1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"depolarize", "[", 
     RowBox[{"bloch", "[", 
      RowBox[{"{", 
       RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], "]"}], "]"}], "\[Equal]", 
    RowBox[{"bloch", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "p"}], ")"}], " ", 
      RowBox[{"{", 
       RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}]}], "]"}]}], ",", 
   RowBox[{
    RowBox[{"0", "<", "p", "<", "1"}], "&&", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], "\[Element]", 
     TemplateBox[{},
      "Reals"]}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.99616668417922*^9, 3.996166694621584*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"8fa7c77a-a71a-a148-9ee6-8514afcd80d8"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{
  3.9961666857243385`*^9, {3.996166807866825*^9, 3.9961668306964207`*^9}, 
   3.996227216621212*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"7bd4945d-1e99-384f-becf-2424e03ee664"]
}, Open  ]],

Cell["\<\
A pair whose Bloch vectors point in different directions, so the two states \
do not share an eigenbasis:\
\>", "Text",
 CellChangeTimes->{{3.9961668713705635`*^9, 
  3.996166875204588*^9}},ExpressionUUID->"e3101e3d-bf93-f240-bc21-\
3c62beff9406"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"rho", ",", "sigma"}], "}"}], "=", 
  RowBox[{"bloch", "/@", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"3", "/", "5"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"4", "/", "5"}], " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"Pi", "/", "3"}], "]"}], ",", "0", ",", 
        RowBox[{"Cos", "[", 
         RowBox[{"Pi", "/", "3"}], "]"}]}], "}"}]}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.9961668421105976`*^9, 3.996166843182026*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"23f64dbf-b7fd-9848-9db5-5b6a30679a85"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox["4", "5"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox["1", "5"]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox["7", "10"], ",", 
       FractionBox[
        SqrtBox["3"], "5"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        SqrtBox["3"], "5"], ",", 
       FractionBox["3", "10"]}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.996166844758276*^9, 3.996166852754183*^9}, 
   3.9962272183749065`*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"5c5c8a97-fb17-cd4a-bae4-50397316373c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"rho", ".", "sigma"}], "!=", 
   RowBox[{"sigma", ".", "rho"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.996166860633911*^9, 3.9961668610152225`*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"7efc5667-7ec2-114a-911c-9a46f26e8d7d"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.996166861456499*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"a79fc734-4337-2349-9b02-18259f582795"]
}, Open  ]],

Cell["\<\
The quantity before the channel is a number, and after it a function of the \
noise.\
\>", "Text",
 CellChangeTimes->{{3.996166901913805*^9, 
  3.996166906932848*^9}},ExpressionUUID->"75bcb6ec-a30c-1d44-b4cb-\
b5796c4a6be4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"before", "=", 
  RowBox[{"FullSimplify", "@", 
   RowBox[{"relativeEntropy", "[", 
    RowBox[{"rho", ",", "sigma"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9961669126823273`*^9, 3.9961669131052933`*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"2d5951b5-a310-f144-86b3-1d82d5591122"],

Cell[BoxData[
 FractionBox[
  RowBox[{"13", " ", 
   RowBox[{"Log", "[", 
    FractionBox["4", "3"], "]"}]}], 
  RowBox[{"10", " ", 
   RowBox[{"Log", "[", "2", "]"}]}]]], "Output",
 CellChangeTimes->{3.996166913619335*^9, 3.9962272200654106`*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"7bf01e63-ad07-fb42-a6f2-3066d08d9305"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"after", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"relativeEntropy", "[", 
     RowBox[{
      RowBox[{"depolarize", "[", "rho", "]"}], ",", 
      RowBox[{"depolarize", "[", "sigma", "]"}]}], "]"}], ",", 
    RowBox[{"0", "<", "p", "<", "1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9961669182551575`*^9, 3.9961669186010857`*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"8383cc2e-d238-3346-bfa5-4baf298426a1"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"12", " ", "p", " ", 
    RowBox[{"ArcTanh", "[", 
     RowBox[{
      FractionBox["3", "5"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "p"}], ")"}]}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "13"}], "+", 
      RowBox[{"3", " ", "p"}]}], ")"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"9", "-", 
      RowBox[{"4", " ", "p"}]}], "]"}]}], "+", 
   RowBox[{"4", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"4", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"8", "-", 
         RowBox[{"3", " ", "p"}]}], "]"}]}], "+", 
      RowBox[{"Log", "[", 
       RowBox[{"2", "+", 
        RowBox[{"3", " ", "p"}]}], "]"}]}], ")"}]}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"7", "+", 
      RowBox[{"3", " ", "p"}]}], ")"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"1", "+", 
      RowBox[{"4", " ", "p"}]}], "]"}]}]}], 
  RowBox[{"20", " ", 
   RowBox[{"Log", "[", "2", "]"}]}]]], "Output",
 CellChangeTimes->{3.996166921011532*^9, 3.9962272217229557`*^9},
 CellLabel->"Out[23]=",ExpressionUUID->"691636c6-dfa9-e84e-b803-40d3eb6d0d75"]
}, Open  ]],

Cell["\<\
The inequality is then a question with no free parameters left, and the empty \
solution set is the answer:\
\>", "Text",
 CellChangeTimes->{{3.9961670294677753`*^9, 
  3.9961670453981724`*^9}},ExpressionUUID->"9638759f-f4c0-2042-a694-\
5b1df1b89adb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"after", ">", "before"}], "&&", 
    RowBox[{"0", "<=", "p", "<=", "1"}]}], ",", "p", ",", "Reals"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9961669548430004`*^9, 3.9961669745114098`*^9}, 
   3.9961670095952663`*^9},
 CellLabel->"In[28]:=",ExpressionUUID->"7417bac7-570f-5241-b540-e4e94aee239f"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{{3.9961669563834686`*^9, 3.9961669754512672`*^9}, 
   3.996167010865471*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"fd03e26f-030c-c240-8365-fe706b6e1cb3"]
}, Open  ]],

Cell["\<\
Both ends of the noise range are forced: at p=0 nothing has happened, and at \
p=1 both states have become the same maximally mixed state and nothing can \
tell them apart;\
\>", "Text",
 CellChangeTimes->{{3.9961671133958282`*^9, 
  3.996167129510998*^9}},ExpressionUUID->"4eb36b79-64a9-8d4c-82e2-\
61f2870a7cc9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"after", "/.", " ", 
      RowBox[{"p", "->", "0"}]}], "]"}], "==", "before"}], ",", 
   RowBox[{"Limit", "[", 
    RowBox[{"after", ",", 
     RowBox[{"p", "->", "1"}], ",", 
     RowBox[{"Direction", "->", "\"\<FromBelow\>\""}]}], "]"}]}], 
  "}"}]], "Input",
 CellChangeTimes->{{3.9961670560004616`*^9, 3.996167056369505*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"e3924d4d-ace1-6745-8aec-3cdb46ccb5bc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.996167056841408*^9},
 CellLabel->"Out[29]=",ExpressionUUID->"6a8dad52-b8a7-a747-8991-8c6f7888adf8"]
}, Open  ]],

Cell[TextData[{
 "One pair proves nothing about all pairs. Relative entropy is invariant \
under a common unitary and depolarizing noise is unitarily covariant, so a \
single rotation puts the first Bloch vector on z and the second in the ",
 Cell[BoxData[
  FormBox["xz", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0104581e-746e-7840-88c3-c64cc05812f5"],
 " plane, leaving two lengths, one angle and the noise to search over."
}], "Text",
 CellChangeTimes->{{3.996167150845108*^9, 
  3.9961671636125546`*^9}},ExpressionUUID->"329f9f0d-2f5a-b94e-9a40-\
7ce37172e7ce"],

Cell[BoxData[
 RowBox[{
  RowBox[{"slack", "[", 
   RowBox[{
    RowBox[{"al_", "?", "NumericQ"}], ",", 
    RowBox[{"be_", "?", "NumericQ"}], ",", 
    RowBox[{"th_", "?", "NumericQ"}], ",", 
    RowBox[{"q_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{"Re", "[", 
   RowBox[{
    RowBox[{"relativeEntropy", "[", 
     RowBox[{
      RowBox[{"bloch", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "al"}], "}"}], "]"}], ",", 
      RowBox[{"bloch", "[", 
       RowBox[{"be", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sin", "[", "th", "]"}], ",", "0", ",", 
          RowBox[{"Cos", "[", "th", "]"}]}], "}"}]}], "]"}]}], "]"}], "-", 
    RowBox[{"relativeEntropy", "[", 
     RowBox[{
      RowBox[{"bloch", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "q"}], ")"}], " ", "al"}]}], "}"}], "]"}], ",", 
      RowBox[{"bloch", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "q"}], ")"}], " ", "be", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sin", "[", "th", "]"}], ",", "0", ",", 
          RowBox[{"Cos", "[", "th", "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.99616725454101*^9, 3.996167267806984*^9}, 
   3.9961676985638847`*^9},
 CellLabel->"In[41]:=",ExpressionUUID->"3af0b8d2-b923-a247-a438-4ca9a45f3eba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NMinimize", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"slack", "[", 
      RowBox[{"al", ",", "be", ",", "th", ",", "q"}], "]"}], ",", 
     RowBox[{
      RowBox[{"0", "<", "al", "<", "1"}], "&&", 
      RowBox[{"0", "<", "be", "<", "1"}], "&&", 
      RowBox[{"0", "\[LessEqual]", "th", "\[LessEqual]", "\[Pi]"}], "&&", 
      RowBox[{"0", "<", "q", "<", "1"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"al", ",", "be", ",", "th", ",", "q"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9961672634460583`*^9, 3.9961672653100777`*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"3cd57024-4725-3742-88f0-2ff4a9905ba6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "3.820610027411358`*^-16"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"al", "\[Rule]", "1.6712341603680824`*^-6"}], ",", 
     RowBox[{"be", "\[Rule]", "1.4382382191030622`*^-6"}], ",", 
     RowBox[{"th", "\[Rule]", "0.000017564219238200036`"}], ",", 
     RowBox[{"q", "\[Rule]", "0.000016348058560467273`"}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9961672759249783`*^9, 3.9961677120242386`*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"e0d6dbd8-0a9e-b748-acb2-7d4049039578"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"vonNeumann", "[", "m_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"#", ".", 
      RowBox[{"Log", "[", 
       RowBox[{"2", ",", "#"}], "]"}]}]}], "&"}], "@", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", "m", "]"}], ",", "0"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9961672926685658`*^9, 3.9961672932667313`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"668d4696-fcea-034e-bc47-a4aa1b780ea5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"reduceA", "[", "m_", "]"}], ":=", 
  RowBox[{"TensorContract", "[", 
   RowBox[{
    RowBox[{"ArrayReshape", "[", 
     RowBox[{"m", ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"reduceB", "[", "m_", "]"}], ":=", 
  RowBox[{"TensorContract", "[", 
   RowBox[{
    RowBox[{"ArrayReshape", "[", 
     RowBox[{"m", ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.996167297582081*^9, 3.996167298209215*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"7c358413-1101-aa49-a5d5-663f4e47bfb4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mutual", "[", "m_", "]"}], ":=", 
  RowBox[{
   RowBox[{"vonNeumann", "[", 
    RowBox[{"reduceA", "[", "m", "]"}], "]"}], "+", 
   RowBox[{"vonNeumann", "[", 
    RowBox[{"reduceB", "[", "m", "]"}], "]"}], "-", 
   RowBox[{"vonNeumann", "[", "m", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9961673025338955`*^9, 3.996167302980831*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"891129c5-6d4b-da45-9f6d-3f05026e16a8"],

Cell["\<\
An entangled pure pair, with the noise acting on the second qubit only:\
\>", "Text",
 CellChangeTimes->{{3.996167864024767*^9, 
  3.9961678657815037`*^9}},ExpressionUUID->"26563000-06e3-db4a-8109-\
5e7a7554f9c2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rhoAB", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"psi", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"Pi", "/", "5"}], "]"}], ",", "0", ",", "0", ",", 
         RowBox[{"Sin", "[", 
          RowBox[{"Pi", "/", "5"}], "]"}]}], "}"}]}], "}"}], ",", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "psi", ",", 
       RowBox[{"Conjugate", "[", "psi", "]"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996167310472624*^9, 3.996167310907503*^9}, 
   3.996167829262966*^9},
 CellLabel->"In[43]:=",ExpressionUUID->"cc2b5bb4-96ca-5f4e-bbd2-a9d0819ec852"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"localB", "[", "m_", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k", "=", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", "#"}], "]"}]}], 
         "}"}], ",", 
        RowBox[{"k", ".", "m", ".", 
         RowBox[{"ConjugateTranspose", "[", "k", "]"}]}]}], "]"}], "&"}], "/@",
      "krausOps"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996167328402458*^9, 3.996167328916895*^9}, 
   3.996167886060774*^9},
 CellLabel->"In[49]:=",ExpressionUUID->"77ac44d5-a298-bf45-97ed-44c55da403a5"],

Cell["\<\
The correlation the two qubits share, as the noise on one of them is turned \
up:\
\>", "Text",
 CellChangeTimes->{{3.99616858696443*^9, 
  3.9961685978499947`*^9}},ExpressionUUID->"bbc17656-df8a-d946-8583-\
47ae2ba67265"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"mutual", "[", 
     RowBox[{
      RowBox[{"localB", "[", "rhoAB", "]"}], "/.", " ", 
      RowBox[{"p", "->", "pv"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"pv", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"1", "/", "4"}], ",", 
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{"3", "/", "4"}], ",", "1"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9961673378727455`*^9, 3.9961673382072353`*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"3716a347-af5b-1449-9527-f2e0b7be4d2f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1.8599540108863861`", ",", "0.9304866771125672`", ",", 
   "0.4165700175085956`", ",", "0.11060585303997539`", ",", 
   RowBox[{"-", "2.220446049250313`*^-16"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996167338674389*^9},
 CellLabel->"Out[38]=",ExpressionUUID->"240cc006-ce8e-0046-85c6-3a9fe992af82"]
}, Open  ]],

Cell["\<\
That decay needs no separate argument once the mutual information is \
recognized  against the product of the marginals:\
\>", "Text",
 CellChangeTimes->{{3.996168520228239*^9, 
  3.996168532722683*^9}},ExpressionUUID->"d1f5c8ba-74d4-f643-bc3e-\
f5ff0d0c22d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"m", "=", 
     RowBox[{
      RowBox[{"localB", "[", "rhoAB", "]"}], "/.", " ", 
      RowBox[{"p", "->", 
       RowBox[{"2", "/", "5"}]}]}]}], "}"}], ",", 
   RowBox[{"Chop", "@", 
    RowBox[{"N", "@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"relativeEntropy", "[", 
        RowBox[{"m", ",", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{
           RowBox[{"reduceA", "[", "m", "]"}], ",", 
           RowBox[{"reduceB", "[", "m", "]"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"mutual", "[", "m", "]"}]}], "}"}]}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9961673440185547`*^9, 3.9961673443701324`*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"65d2c8ff-f7a7-eb44-a289-c4e3bc77503d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.5939954629796448`", ",", "0.5939954629796446`"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9961673453500767`*^9},
 CellLabel->"Out[39]=",ExpressionUUID->"5643bd7f-b077-644b-8bf8-039994bd9b01"]
}, Open  ]],

Cell["\<\
And once the channel is seen to carry that product to the product of the \
processed marginals, which is what makes the pair move together and the \
corollary immediate:\
\>", "Text",
 CellChangeTimes->{{3.9961685402657375`*^9, 
  3.996168542812948*^9}},ExpressionUUID->"d0acc54e-12b1-c840-9aa5-\
5b7b6439e6d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"localB", "[", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"reduceA", "[", "rhoAB", "]"}], ",", 
       RowBox[{"reduceB", "[", "rhoAB", "]"}]}], "]"}], "]"}], "==", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"reduceA", "[", 
       RowBox[{"localB", "[", "rhoAB", "]"}], "]"}], ",", 
      RowBox[{"reduceB", "[", 
       RowBox[{"localB", "[", "rhoAB", "]"}], "]"}]}], "]"}]}], ",", 
   RowBox[{"0", "<", "p", "<", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9961673507109604`*^9, 3.9961673511289577`*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"f063581a-f75b-5b49-8f51-4469591d8fae"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.996167351752905*^9},
 CellLabel->"Out[40]=",ExpressionUUID->"cecac48f-dc25-3f48-86e7-538918170152"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9961685591142025`*^9, 
  3.9961685613339787`*^9}},ExpressionUUID->"4e4256de-3670-2d40-a64f-\
5149dd38ccf3"],

Cell["Define states by the Bloch vector:", "Text",
 CellChangeTimes->{{3.9962279999521446`*^9, 
  3.996228005268347*^9}},ExpressionUUID->"0aecca52-b2e7-bf40-9893-\
fee4f5ff88a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qrho", ",", "qsigma"}], "}"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"\"\<BlochVector\>\"", "[", "#1", "]"}], "]"}], "&"}], ")"}], "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", 
        FractionBox["3", "5"]}], "}"}], ",", 
      RowBox[{
       FractionBox["4", "5"], " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sin", "[", 
          FractionBox["\[Pi]", "3"], "]"}], ",", "0", ",", 
         RowBox[{"Cos", "[", 
          FractionBox["\[Pi]", "3"], "]"}]}], "}"}]}]}], "}"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996227040679386*^9, 3.9962270534126797`*^9}, {
  3.9962280086122684`*^9, 
  3.9962280199437256`*^9}},ExpressionUUID->"b76f1cd0-77e3-b347-b091-\
949d025f2480"],

Cell["Define the polarizing channel:", "Text",
 CellChangeTimes->{{3.996228021463482*^9, 
  3.9962280302326565`*^9}},ExpressionUUID->"3247b497-0016-fe40-ad88-\
40ebb6fa15d4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"channel", "=", 
   RowBox[{"QuantumChannel", "[", 
    RowBox[{"\"\<Depolarizing\>\"", "[", "p", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996227040679386*^9, 3.9962270534126797`*^9}, {
  3.9962280086122684`*^9, 
  3.9962280199437256`*^9}},ExpressionUUID->"2895e305-b7e4-e64f-bd5c-\
753037ac0b95"],

Cell["Verify the Bloch vector contraction symbolically:", "Text",
 CellChangeTimes->{{3.9962281085431995`*^9, 
  3.9962281242866993`*^9}},ExpressionUUID->"3db49dcf-ad23-5847-b56e-\
f3ee16fc4419"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"channel", "[", 
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<BlochVector\>\"", "[", 
       RowBox[{"{", 
        RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], "]"}], "]"}], "]"}], 
    "[", "\"\<BlochVector\>\"", "]"}], ",", 
   RowBox[{
    RowBox[{"0", "<", "p", "<", "1"}], "&&", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], "\[Element]", 
     TemplateBox[{},
      "Reals"]}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.996227071142992*^9, 3.9962271017223587`*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"a0c4e60a-c211-2e40-b513-6c0bf54f2495"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"rx", "-", 
    RowBox[{"p", " ", "rx"}]}], ",", 
   RowBox[{"ry", "-", 
    RowBox[{"p", " ", "ry"}]}], ",", 
   RowBox[{"rz", "-", 
    RowBox[{"p", " ", "rz"}]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.996227081277628*^9, 3.9962271022295933`*^9}},
 CellLabel->"Out[10]=",ExpressionUUID->"aae40f30-e709-9e47-ae02-d4001ab46f85"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Expand", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "-", "p"}], ")"}], 
   RowBox[{"{", 
    RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9962271048661823`*^9, 3.996227117293806*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"67fbacd8-f616-3241-9876-b9c6809d4292"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"rx", "-", 
    RowBox[{"p", " ", "rx"}]}], ",", 
   RowBox[{"ry", "-", 
    RowBox[{"p", " ", "ry"}]}], ",", 
   RowBox[{"rz", "-", 
    RowBox[{"p", " ", "rz"}]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9962271102282505`*^9, 3.996227117606682*^9}},
 CellLabel->"Out[12]=",ExpressionUUID->"5cbd53df-c357-db4a-9ab7-aae229f3d6f9"]
}, Open  ]],

Cell["Helper for computing relative entropy and simplify:", "Text",
 CellChangeTimes->{{3.99622814864205*^9, 
  3.9962281669511337`*^9}},ExpressionUUID->"6e54ff67-85bd-de4e-9827-\
c59f2fbda290"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rel", "[", 
   RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"QuantityMagnitude", "@", 
     RowBox[{"QuantumDistance", "[", 
      RowBox[{"a", ",", "b", ",", "\"\<RelativeEntropy\>\""}], "]"}]}], ",", 
    RowBox[{"0", "<", "p", "<", "1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.996227168239664*^9, 3.9962271696513615`*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"bd1a5504-29b1-e84a-9da0-7424da122884"],

Cell["Compute the quantities:", "Text",
 CellChangeTimes->{{3.996228182356947*^9, 
  3.9962281859971943`*^9}},ExpressionUUID->"e99afc17-a651-0d4b-bfdc-\
34c13f27b482"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"qbefore", ",", "qafter"}], "}"}], "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"rel", "[", 
     RowBox[{"qrho", ",", "qsigma"}], "]"}], ",", 
    RowBox[{"rel", "[", 
     RowBox[{
      RowBox[{"channel", "[", "qrho", "]"}], ",", 
      RowBox[{"channel", "[", "qsigma", "]"}]}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9962271749298153`*^9, 3.9962271754597683`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"f7df14d6-3323-9a46-ac3c-661273f3cae0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"13", " ", 
     RowBox[{"Log", "[", 
      FractionBox["4", "3"], "]"}]}], 
    RowBox[{"10", " ", 
     RowBox[{"Log", "[", "2", "]"}]}]], ",", 
   FractionBox[
    RowBox[{
     RowBox[{"12", " ", "p", " ", 
      RowBox[{"ArcTanh", "[", 
       RowBox[{
        FractionBox["3", "5"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "p"}], ")"}]}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "13"}], "+", 
        RowBox[{"3", " ", "p"}]}], ")"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"9", "-", 
        RowBox[{"4", " ", "p"}]}], "]"}]}], "+", 
     RowBox[{"4", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", " ", 
         RowBox[{"Log", "[", 
          RowBox[{"8", "-", 
           RowBox[{"3", " ", "p"}]}], "]"}]}], "+", 
        RowBox[{"Log", "[", 
         RowBox[{"2", "+", 
          RowBox[{"3", " ", "p"}]}], "]"}]}], ")"}]}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"7", "+", 
        RowBox[{"3", " ", "p"}]}], ")"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"1", "+", 
        RowBox[{"4", " ", "p"}]}], "]"}]}]}], 
    RowBox[{"20", " ", 
     RowBox[{"Log", "[", "2", "]"}]}]]}], "}"}]], "Output",
 CellChangeTimes->{3.9962271786897163`*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"58775967-f47b-cd4a-9ac9-5bd7549e7a1e"]
}, Open  ]],

Cell["That coincide with the previous result:", "Text",
 CellChangeTimes->{{3.9962282002434597`*^9, 
  3.9962282077706146`*^9}},ExpressionUUID->"97336528-5e88-a847-bcc9-\
c355dbefc972"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"qbefore", "-", "before"}], ",", 
     RowBox[{"qafter", "-", "after"}]}], "}"}], ",", 
   RowBox[{"0", "<", "p", "<", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9962272042633*^9, 3.996227204662695*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"c23f561b-00d4-0848-af28-8175144e575e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{{3.9962272058698635`*^9, 3.996227227757742*^9}},
 CellLabel->"Out[24]=",ExpressionUUID->"df179325-56cd-4944-ac40-dbb4f55bf4e2"]
}, Open  ]],

Cell["\<\
So the inequality is again a question with no free parameters, and the empty \
violating set is again the answer:\
\>", "Text",
 CellChangeTimes->{{3.9962282168604527`*^9, 
  3.996228222717987*^9}},ExpressionUUID->"3960b840-2a5a-a44c-8af4-\
69bcf7d35678"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"qafter", ">", "qbefore"}], "&&", 
    RowBox[{"0", "<", "p", "<", "1"}]}], ",", "p", ",", "Reals"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9962272341661034`*^9, 3.9962272345713615`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"d1230cd0-69ef-604a-b4df-bc445f648011"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.996227235751526*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"6f6c39d8-435b-6e4d-83f9-22d7a3b8063c"]
}, Open  ]],

Cell["\<\
The closed form also settles more than the inequality: both endpoints, and \
that the fall is strict everywhere between them rather than merely \
non-increasing:\
\>", "Text",
 CellChangeTimes->{{3.9962282309930706`*^9, 
  3.9962282324131317`*^9}},ExpressionUUID->"b10a7cf8-eace-884b-be29-\
253b05c80b66"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"qafter", "/.", "\[VeryThinSpace]", 
      RowBox[{"p", "\[Rule]", "0"}]}], "]"}], "\[Equal]", "qbefore"}], ",", 
   RowBox[{
    UnderscriptBox["\[Limit]", 
     TagBox[
      RowBox[{"p", "\[Rule]", 
       SuperscriptBox["1", "-"]}],
      "AlternateLimitDirection"]], "qafter"}], ",", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "p"], "qafter"}], ">", "0"}], "&&", 
      RowBox[{"0", "<", "p", "<", "1"}]}], ",", "p", ",", 
     TemplateBox[{},
      "Reals"]}], "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.9962272426487923`*^9, 3.9962272452171173`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"be332366-34a6-3347-a4d5-a6e1b440e162"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "0", ",", "False"}], "}"}]], "Output",
 CellChangeTimes->{3.99622724767173*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"882a9191-5f47-034f-8865-d4c8762f3ee6"]
}, Open  ]],

Cell["\<\
Check the inequality using the same \[Rho] and \[Sigma] but for all named \
channels:\
\>", "Text",
 CellChangeTimes->{{3.996228246344536*^9, 
  3.9962282633407593`*^9}},ExpressionUUID->"5e801487-b3db-1648-8cc8-\
9f5c679fb803"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", "=", 
       RowBox[{"QuantumChannel", "[", "ch", "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"rel", "[", 
       RowBox[{
        RowBox[{"c", "[", "qrho", "]"}], ",", 
        RowBox[{"c", "[", "qsigma", "]"}]}], "]"}], "<=", 
      RowBox[{"rel", "[", 
       RowBox[{"qrho", ",", "qsigma"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"ch", ",", 
     RowBox[{"Through", "[", 
      RowBox[{
      "Wolfram`QuantumFramework`PackageScope`$QuantumChannelNames", "[", 
       "0.3", "]"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.996227516209179*^9, 3.996227516209179*^9}, {
  3.996227725120886*^9, 3.9962277353867245`*^9}, {3.996227823444975*^9, 
  3.996227847738058*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"e5ab84af-ab95-7d4d-b489-a687d1f49977"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "True", ",", "True", ",", "True", ",", "True", ",", "True", ",", "True", ",",
    "True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{
  3.996227527921076*^9, 3.9962277310735397`*^9, {3.9962278336686287`*^9, 
   3.996227849306343*^9}},
 CellLabel->"Out[32]=",ExpressionUUID->"ceaf8e81-7458-4d4a-a17d-b9fda7c3b2bb"]
}, Open  ]],

Cell["\<\
The noise on the second qubit turned up through the same range as before:\
\>", "Text",
 CellChangeTimes->{{3.996228286583084*^9, 
  3.9962282984200478`*^9}},ExpressionUUID->"74a57cdc-2a3b-fc4f-bd22-\
911290554669"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qpsi", "=", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", 
       FractionBox["\[Pi]", "5"], "]"}], ",", "0", ",", "0", ",", 
      RowBox[{"Sin", "[", 
       FractionBox["\[Pi]", "5"], "]"}]}], "}"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9962279412355328`*^9, 3.996227942921913*^9}, 
   3.9962282799714184`*^9},
 CellLabel->"In[38]:=",ExpressionUUID->"b975225b-40f5-a246-aecb-e248928992c6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"QuantityMagnitude", "@", 
     RowBox[{"QuantumEntanglementMonotone", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumChannel", "[", 
         RowBox[{
          RowBox[{"\"\<Depolarizing\>\"", "[", "pv", "]"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "[", "qpsi", "]"}], 
       ",", "\"\<MutualInformationI\>\""}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"pv", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"1", "/", "4"}], ",", 
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{"3", "/", "4"}], ",", "1"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.996227948700884*^9, 3.996227958640705*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"e531462e-c2a7-b043-9ece-5b7e913ee1e4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1.8599540108863861`", ",", "0.9304866771125674`", ",", 
   "0.41657001750859535`", ",", "0.11060585303997517`", ",", 
   RowBox[{"-", "2.220446049250313`*^-16"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996227954481632*^9, 3.996228284652231*^9},
 CellLabel->"Out[39]=",ExpressionUUID->"361a0d40-d76e-8549-9ac4-b0c1acaea706"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "14.6 [MSc] How do I compute the Holevo bound ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", " ", "=", " ", 
    RowBox[{
     RowBox[{"S", "(", 
      RowBox[{
       SubscriptBox["\[Sum]", 
        RowBox[{" ", "i"}]], " ", 
       RowBox[{
        SubscriptBox["p", "i"], " ", 
        SubscriptBox["\[Rho]", "i"]}]}], ")"}], "-", 
     RowBox[{
      SubscriptBox["\[Sum]", 
       RowBox[{" ", "i"}]], " ", 
      RowBox[{
       SubscriptBox["p", "i"], 
       RowBox[{"S", "(", 
        SubscriptBox["\[Rho]", "i"], ")"}]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c5db1f61-913c-7e42-98e7-348e8180fd1d"],
 " on the accessible information of an ensemble?"
}], "Subsection",
 CellChangeTimes->{{3.996229522367098*^9, 
  3.9962296124145546`*^9}},ExpressionUUID->"4162544e-db0e-4d42-80dd-\
fe6533157b71"],

Cell[TextData[{
 "An ensemble {",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "i"], ",", " ", 
    SubscriptBox["\[Rho]", "i"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8339d6b1-3d7b-7048-9aa2-eee1c4521e80"],
 " } is a way of carrying a classical choice on a quantum system: the sender \
draws ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6ec366da-fd74-c142-b5f3-e8495bf91a49"],
 " with probability ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "76195cad-2b19-9e48-9d54-716f26db6853"],
 " and hands over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a9e3f74f-2aa6-e049-a287-9f95fcd3ef5d"],
 " , and the receiver, holding one copy and free to choose any measurement \
whatsoever,  tries to work out which ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "29ecf8e4-f21e-5b49-9d49-f0693e8ca9a4"],
 " was drawn. Write ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2ded800d-8080-7a4e-b37f-bcf80912aefa"],
 " for the index the sender drew and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Y", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "416d1d16-781e-e14f-83a2-4676707480e4"],
 "for the outcome the measurement returns; then the mutual information ",
 Cell[BoxData[
  FormBox[
   RowBox[{"I", 
    RowBox[{"(", 
     RowBox[{"X", ":", "Y"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7b53818d-500d-a047-b9f7-c508efd4de09"],
 " of 14.3 is how much of the choice survived the trip. The Holevo quantity \
\[Chi] bounds that above for every measurement at once, which is what makes \
it worth computing, it is a property of the encoding alone, fixed before any \
receiver is specified."
}], "Text",
 CellChangeTimes->{{3.9962324642620583`*^9, 3.99623254527166*^9}, 
   3.996232710409401*^9, {3.9962327442693634`*^9, 3.9962327498399734`*^9}, {
   3.996232784937149*^9, 
   3.9962328378331776`*^9}},ExpressionUUID->"968fef40-8e9d-fb48-91f4-\
876a3264cbb4"],

Cell[TextData[{
 "Its form is the failure of the entropy to be linear. The receiver who is \
told nothing holds the average state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Rho]", "\[RightVector]"], "=", 
    RowBox[{
     SubscriptBox["\[Sum]", 
      RowBox[{" ", "i"}]], " ", 
     RowBox[{
      SubscriptBox["p", "i"], 
      SubscriptBox["\[Rho]", "i"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2089bfbe-a7fe-9e46-9e64-365e7682086d"],
 "  and faces ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "(", 
    OverscriptBox["\[Rho]", "\[RightVector]"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2ccb33fe-e07f-b04e-8b1a-3ce1f5778f79"],
 " worth of uncertainty; the receiver who is told ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e04ff7fa-f0cc-bc45-8ab8-b5d61dd61497"],
 " still faces ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "(", 
    SubscriptBox["\[Rho]", "i"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c7b0de8a-5ec7-5040-8b1d-589db245d8bc"],
 " , on average ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sum]", 
     RowBox[{"i", " "}]], 
    RowBox[{
     SubscriptBox["p", "i"], 
     RowBox[{"S", "(", 
      SubscriptBox["\[Rho]", "i"], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "19714896-2889-0a48-b49a-5bee098302e2"],
 ". The difference is what being told the index was worth, and since ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "48f09ddd-534e-a042-b30f-5e6ca496933d"],
 " is concave the difference cannot be negative. So \n\[Chi] is a concavity \
gap, and it collapses to zero exactly when learning ",
 StyleBox["i ",
  FontSlant->"Italic"],
 "tells the receiver nothing about the state, which happens only when every ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f2a0d57a-1d29-8e44-a3cb-1d9d422b4b52"],
 " carrying weight is the same state."
}], "Text",
 CellChangeTimes->{{3.9962330323936634`*^9, 3.996233229064499*^9}, {
  3.9962332639902534`*^9, 
  3.9962332833574085`*^9}},ExpressionUUID->"5f077995-30bb-064e-bbbb-\
1911045dba66"],

Cell[TextData[{
 "Alternatively, recording the index itself in an orthonormal register gives \
the classical-quantum state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", "XB"], "=", 
    RowBox[{
     SubscriptBox["\[Sum]", 
      RowBox[{" ", "i"}]], " ", 
     RowBox[{
      SubscriptBox["p", "i"], " ", Cell[
      "|",ExpressionUUID->"b729781e-486d-5941-9f30-2c9c42964db0"], "i", Cell[
      "\[RightAngleBracket]",ExpressionUUID->
       "b8142c95-0c59-1943-a0be-2723e5943e53"], Cell[
      "\[LeftAngleBracket]",ExpressionUUID->
       "2b9880fc-ecda-2948-8f9b-7163b67496ef"], "i", 
      RowBox[{
      Cell["|",ExpressionUUID->"f2cfa957-6e81-274f-92a2-ed4262df7ef1"], "\[CircleTimes]",
        " ", 
       SubscriptBox["\[Rho]", "i"]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "204d0461-5565-9341-89c3-2a6e327dffcc"],
 " whose mutual information ",
 Cell[BoxData[
  FormBox[
   RowBox[{"I", "(", 
    RowBox[{"X", ":", "B"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a604b0e3-9c6f-6243-a02e-ab7a71f0708d"],
 " is exactly \[Chi]"
}], "Text",
 CellChangeTimes->{{3.9962333002637234`*^9, 
  3.9962333775872383`*^9}},ExpressionUUID->"ee5cd491-5a0f-2e49-8cef-\
4763b92cdf29"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.996230605681471*^9, 
  3.996230608495388*^9}},ExpressionUUID->"9bfa9814-2f34-474f-b1da-\
0b93c9972e8a"],

Cell["\<\
Bloch builder, entropy calculation from the spectrum and Holevo definition:\
\>", "Text",
 CellChangeTimes->{{3.9962296292116604`*^9, 
  3.9962296759944553`*^9}},ExpressionUUID->"3d5ec2b1-7de5-ad47-baac-\
24eeceda495f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bloch", "[", "v_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
     RowBox[{"v", ".", 
      RowBox[{"PauliMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], ")"}], "/", 
   "2"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vonNeumann", "[", "m_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"#", ".", 
      RowBox[{"Log", "[", 
       RowBox[{"2", ",", "#"}], "]"}]}]}], "&"}], "@", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", "m", "]"}], ",", "0"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"holevo", "[", 
   RowBox[{"ps_", ",", "rhos_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"vonNeumann", "[", 
    RowBox[{"ps", ".", "rhos"}], "]"}], "-", 
   RowBox[{"ps", ".", 
    RowBox[{"(", 
     RowBox[{"vonNeumann", "/@", "rhos"}], ")"}]}]}]}]}], "Input",
 CellChangeTimes->{{3.996229643008333*^9, 3.9962296437015743`*^9}, {
  3.996229680037115*^9, 3.99622968575416*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"e80b8fb2-7a80-8741-8dc6-eac26bea49e0"],

Cell["\<\
Two pure states whose Bloch vectors are separated by \[Theta], so the overlap \
is  cos(\[Theta]/2) and the Hilbert-space angle is half the Bloch angle. Each \
member is pure, so the subtracted average costs nothing and what is left is \
the entropy of the mixture alone:\
\>", "Text",
 CellChangeTimes->{{3.9962297415572376`*^9, 
  3.9962297591305523`*^9}},ExpressionUUID->"2f0200ac-10a0-3c45-b61b-\
44318214f604"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"chiPure", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"holevo", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{"1", "/", "2"}]}], "}"}], ",", 
      RowBox[{"bloch", "/@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], ",", "0", ",", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}], "}"}]}]}], "]"}],
     ",", 
    RowBox[{"0", "<", "\[Theta]", "<", "Pi"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9962296972523193`*^9, 3.9962296977822037`*^9}, {
  3.9962297666413803`*^9, 3.9962297705718155`*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"16a9d03c-3c22-e449-a3bf-7e0b53e7f516"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"Log", "[", 
    RowBox[{"4", " ", 
     SuperscriptBox[
      RowBox[{"Csc", "[", 
       FractionBox["\[Theta]", "2"], "]"}], "2"]}], "]"}], "+", 
   RowBox[{"2", " ", 
    RowBox[{"Cos", "[", 
     FractionBox["\[Theta]", "2"], "]"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"Tan", "[", 
      FractionBox["\[Theta]", "4"], "]"}], "]"}]}]}], 
  RowBox[{"Log", "[", "4", "]"}]]], "Output",
 CellChangeTimes->{3.9962297098461*^9, 3.996229771627844*^9},
 CellLabel->"Out[46]=",ExpressionUUID->"fbbd0b4a-0f62-b84b-823e-0ddb23e9b02e"]
}, Open  ]],

Cell["\<\
The two ends of the range are the two extremes , information perfectly \
readable and information not sent at all:\
\>", "Text",
 CellChangeTimes->{{3.9962297971400013`*^9, 
  3.996229820758711*^9}},ExpressionUUID->"09e16dc1-5a20-ba4d-b839-\
3c3f30477019"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"chiPure", "/.", "\[VeryThinSpace]", 
     RowBox[{"\[Theta]", "\[Rule]", "\[Pi]"}]}], "]"}], ",", 
   RowBox[{
    UnderscriptBox["\[Limit]", 
     TagBox[
      RowBox[{"\[Theta]", "\[Rule]", 
       SuperscriptBox["0", "+"]}],
      "AlternateLimitDirection"]], "chiPure"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.9962297223832684`*^9, 3.996229728037081*^9}, {
  3.9962297747973785`*^9, 3.9962297778135986`*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"dc04f2bd-b3d1-5442-9fe5-38e6a68ec1b1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{{3.996229724334244*^9, 3.996229732933176*^9}, 
   3.9962297781672707`*^9},
 CellLabel->"Out[47]=",ExpressionUUID->"1de93861-77a6-d042-8d4e-115406d9a37e"]
}, Open  ]],

Cell["\<\
Mixing the members costs the subtracted term, and the bound drops strictly \
below the entropy of the average that a pure ensemble would have reached:\
\>", "Text",
 CellChangeTimes->{{3.996229884850281*^9, 
  3.996229886608408*^9}},ExpressionUUID->"14a6a7b4-a79e-ae40-be73-\
a3a3a07cb608"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ens", "=", 
   RowBox[{"bloch", "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", 
        RowBox[{"1", "/", "2"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", "0", ",", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "}"}]}], "}"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996229833245388*^9, 3.996229852859621*^9}, {
  3.996229890231285*^9, 3.9962298928716583`*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"90e31c40-b06f-bb4f-a62f-2b210b0b01d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"vonNeumann", "[", 
      RowBox[{
       RowBox[{"Total", "[", "ens", "]"}], "/", "2"}], "]"}], ",", 
     RowBox[{"holevo", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", "ens"}], "]"}]}], "}"}], "/.",
    " ", 
   RowBox[{"\[Theta]", "->", 
    RowBox[{"Pi", "/", "2"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.99622984792898*^9, 3.9962298561850624`*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"904daf53-6807-e349-89e6-d964aac59390"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      SqrtBox["2"], " ", 
      RowBox[{"ArcCoth", "[", 
       RowBox[{"2", " ", 
        SqrtBox["2"]}], "]"}]}], "+", 
     RowBox[{"Log", "[", 
      FractionBox["1048576", "2401"], "]"}]}], 
    RowBox[{"Log", "[", "256", "]"}]], ",", 
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      SqrtBox["2"], " ", 
      RowBox[{"ArcCoth", "[", 
       RowBox[{"2", " ", 
        SqrtBox["2"]}], "]"}]}], "+", 
     RowBox[{"Log", "[", 
      FractionBox["11664", "2401"], "]"}]}], 
    RowBox[{"Log", "[", "256", "]"}]]}], "}"}]], "Output",
 CellChangeTimes->{{3.996229849033764*^9, 3.996229856815159*^9}},
 CellLabel->"Out[51]=",ExpressionUUID->"16dcc8cd-a47c-8944-abd2-cfa608e6670b"]
}, Open  ]],

Cell["Show the equality for symbolic \[Theta]:", "Text",
 CellChangeTimes->{{3.99623052656608*^9, 
  3.996230568527355*^9}},ExpressionUUID->"bebf9b7b-1f75-e34c-8425-\
29483a9c2850"],

Cell[BoxData[
 RowBox[{
  RowBox[{"relativeEntropy", "[", 
   RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Tr", "[", 
    RowBox[{"a", ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"MatrixLog", "[", "a", "]"}], "-", 
       RowBox[{"MatrixLog", "[", "b", "]"}]}], ")"}]}], "]"}], "/", 
   RowBox[{"Log", "[", "2", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.996229906056181*^9, 3.99622990650366*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"30f33216-c5e3-9848-b695-01a0359b7472"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"holevo", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        FractionBox["1", "2"], ",", 
        FractionBox["1", "2"]}], "}"}], ",", "ens"}], "]"}], "-", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"relativeEntropy", "[", 
          RowBox[{"#1", ",", 
           FractionBox[
            RowBox[{"Total", "[", "ens", "]"}], "2"]}], "]"}], "&"}], ")"}], "/@",
        "ens"}], "]"}]}]}], ",", 
   RowBox[{"0", "<", "\[Theta]", "<", "\[Pi]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9962299151054153`*^9, 3.996229932135874*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"99e32ea5-8157-1647-8071-896b1d615a1d"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{{3.9962299200081577`*^9, 3.996229941579838*^9}},
 CellLabel->"Out[57]=",ExpressionUUID->"2cfeacc1-e0ad-f44b-903a-7b1c09dc36ed"]
}, Open  ]],

Cell["\<\
Equality in the concavity is the degenerate ensemble, identically in the \
Bloch radius rather than at a chosen state:\
\>", "Text",
 CellChangeTimes->{{3.996230480610428*^9, 
  3.996230483087721*^9}},ExpressionUUID->"42d9a793-bdb6-2443-938f-\
6d3125d747dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"holevo", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox["1", "2"], ",", 
       FractionBox["1", "2"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"bloch", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "r"}], "}"}], "]"}], ",", 
       RowBox[{"bloch", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "r"}], "}"}], "]"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"0", "<", "r", "<", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9962299345888195`*^9, 3.996229936766556*^9}},
 CellLabel->"In[56]:=",ExpressionUUID->"0bff98ca-776c-2c43-bf1f-a12a9fc7defe"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.9962299387149067`*^9},
 CellLabel->"Out[56]=",ExpressionUUID->"6bf04dd2-c080-c54d-bd72-a083092a121f"]
}, Open  ]],

Cell["\<\
The same quantity for three pure states at equal angles around a great \
circle, maximized over the priors, so the search reports both the best the \
ensemble can do and the weights that reach it:\
\>", "Text",
 CellChangeTimes->{{3.996230437719061*^9, 
  3.9962304393585835`*^9}},ExpressionUUID->"606700ca-04f3-7440-bda3-\
37e0c31fa169"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NMaximize", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"holevo", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p1", ",", "p2", ",", 
         RowBox[{"1", "-", "p1", "-", "p2"}]}], "}"}], ",", 
       RowBox[{"bloch", "/@", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sin", "[", 
             FractionBox[
              RowBox[{"2", " ", "\[Pi]"}], "3"], "]"}], ",", "0", ",", 
            RowBox[{"Cos", "[", 
             FractionBox[
              RowBox[{"2", " ", "\[Pi]"}], "3"], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sin", "[", 
              FractionBox[
               RowBox[{"2", " ", "\[Pi]"}], "3"], "]"}]}], ",", "0", ",", 
            RowBox[{"Cos", "[", 
             FractionBox[
              RowBox[{"2", " ", "\[Pi]"}], "3"], "]"}]}], "}"}]}], "}"}]}]}], 
      "]"}], ",", 
     RowBox[{
      RowBox[{"0", "<", "p1", "<", "1"}], "&&", 
      RowBox[{"0", "<", "p2", "<", "1"}], "&&", 
      RowBox[{
       RowBox[{"p1", "+", "p2"}], "<", "1"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"p1", ",", "p2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9962299502310734`*^9, 3.99622995168198*^9}, {
  3.9962304024584255`*^9, 3.9962304073860435`*^9}},
 CellLabel->"In[60]:=",ExpressionUUID->"5ec4ba4d-08b8-f84f-a917-456d3188c237"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1.`", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"p1", "\[Rule]", "0.33333333333333337`"}], ",", 
     RowBox[{"p2", "\[Rule]", "0.33333333333333337`"}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{
  3.9962299555148983`*^9, {3.996230403195217*^9, 3.9962304080713043`*^9}},
 CellLabel->"Out[60]=",ExpressionUUID->"63a10768-7ad4-3f47-b94f-eaddb86b6499"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9962306134435654`*^9, 
  3.9962306160529633`*^9}},ExpressionUUID->"1df8595c-c462-964a-b8c8-\
d004f60b3ca8"],

Cell["Define states:", "Text",
 CellChangeTimes->{{3.9962322050605545`*^9, 
  3.996232207001316*^9}},ExpressionUUID->"cf423e30-7aff-f744-9e73-\
cb6d3ac2cdf4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qens", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<BlochVector\>\"", "[", "#", "]"}], "]"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", 
        RowBox[{"1", "/", "2"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", "0", ",", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "}"}]}], "}"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996230649805065*^9, 3.9962306593066998`*^9}},
 CellLabel->"In[64]:=",ExpressionUUID->"f56b97ee-1bb1-bd4c-8432-eb63ecdbcf10"],

Cell["\<\
The entropy is a property of the state such that the definition can be \
assembled:\
\>", "Text",
 CellChangeTimes->{{3.996230639170513*^9, 3.996230645199667*^9}, {
  3.996231929495039*^9, 
  3.9962319441891956`*^9}},ExpressionUUID->"ff2a7f8f-5afe-c74a-aecb-\
ec620f9ee0ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qholevo", "[", 
   RowBox[{"ps_", ",", "qs_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"ps", " ", "qs"}], "]"}], "[", "\"\<VonNeumannEntropy\>\"", 
    "]"}], "-", 
   RowBox[{"ps", ".", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"#1", "[", "\"\<VonNeumannEntropy\>\"", "]"}], "&"}], ")"}], "/@",
      "qs"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9962306829221687`*^9, 3.996230683662609*^9}, {
  3.996231812146263*^9, 3.9962318145845833`*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"116e369b-f744-2247-9ffb-66fef5da6614"],

Cell["Compute the Holevo bound:", "Text",
 CellChangeTimes->{{3.9962322253026733`*^9, 
  3.9962322417156296`*^9}},ExpressionUUID->"ff984380-f28e-2846-9d23-\
ccaf3eecd73b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"qchi", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"qholevo", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{"1", "/", "2"}]}], "}"}], ",", "qens"}], "]"}], ",", 
    RowBox[{"0", "<", "\[Theta]", "<", "Pi"}]}], "]"}]}]], "Input",
