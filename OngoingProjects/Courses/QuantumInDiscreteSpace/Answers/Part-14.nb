Cell["\<\
Compute symbolic \[OpenCurlyDoubleQuote]RelativeEntropy\
\[CloseCurlyDoubleQuote] using \[Rho] as a generic mixed Bloch vector state \
and the states |0\[RightAngleBracket] and |1\[RightAngleBracket]\
\>", "Text",
 CellChangeTimes->{{3.99572991129867*^9, 
  3.995729948697916*^9}},ExpressionUUID->"fe28c967-3c0d-4149-841e-\
44aeb8a5eeb8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"QuantumDistance", "[", 
      RowBox[{"#", ",", 
       RowBox[{"QuantumState", "[", 
        RowBox[{"\"\<BlochVector\>\"", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], "]"}], "]"}], 
       ",", "\"\<RelativeEntropy\>\""}], "]"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", 
      RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}]}], "}"}]}], ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     SuperscriptBox["y", "2"], "+", 
     SuperscriptBox["z", "2"]}], "<=", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9957296970261536`*^9, 3.995729797258766*^9}},
 CellLabel->"In[95]:=",ExpressionUUID->"37eb380b-a11a-034e-a281-deae691c485d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[{
     FractionBox[
      RowBox[{
        RowBox[{"-", 
          FractionBox[
           RowBox[{"2", " ", "z", " ", 
             RowBox[{"ArcTanh", "[", 
               SqrtBox[
                RowBox[{
                  SuperscriptBox["x", "2"], "+", 
                  SuperscriptBox["y", "2"], "+", 
                  SuperscriptBox["z", "2"]}]], "]"}]}], 
           SqrtBox[
            RowBox[{
              SuperscriptBox["x", "2"], "+", 
              SuperscriptBox["y", "2"], "+", 
              SuperscriptBox["z", "2"]}]]]}], "+", 
        RowBox[{"Log", "[", 
          RowBox[{"-", 
            FractionBox["4", 
             RowBox[{
               RowBox[{"-", "1"}], "+", 
               SuperscriptBox["x", "2"], "+", 
               SuperscriptBox["y", "2"], "+", 
               SuperscriptBox["z", "2"]}]]}], "]"}]}], 
      RowBox[{"Log", "[", "4", "]"}]], "\"b\"", "bits", "\"Bits\""},
    "Quantity"], ",", 
   TemplateBox[{
     RowBox[{"-", 
       FractionBox[
        RowBox[{
          RowBox[{"(", 
            RowBox[{
              SuperscriptBox["x", "2"], "+", 
              SuperscriptBox["y", "2"]}], ")"}], " ", 
          RowBox[{"(", 
            RowBox[{
              FractionBox[
               RowBox[{"Log", "[", 
                 RowBox[{
                   FractionBox["1", "2"], "-", 
                   RowBox[{
                    FractionBox["1", "2"], " ", 
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"], "+", 
                    SuperscriptBox["z", "2"]}]]}]}], "]"}], 
               RowBox[{
                 SuperscriptBox["x", "2"], "+", 
                 SuperscriptBox["y", "2"], "+", 
                 SuperscriptBox["z", "2"], "-", 
                 RowBox[{"z", " ", 
                   SqrtBox[
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"], "+", 
                    SuperscriptBox["z", "2"]}]]}]}]], "+", 
              FractionBox[
               RowBox[{"Log", "[", 
                 RowBox[{
                   FractionBox["1", "2"], " ", 
                   RowBox[{"(", 
                    RowBox[{"1", "+", 
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"], "+", 
                    SuperscriptBox["z", "2"]}]]}], ")"}]}], "]"}], 
               RowBox[{
                 SuperscriptBox["x", "2"], "+", 
                 SuperscriptBox["y", "2"], "+", 
                 RowBox[{"z", " ", 
                   RowBox[{"(", 
                    RowBox[{"z", "+", 
                    SqrtBox[
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"], "+", 
                    SuperscriptBox["z", "2"]}]]}], ")"}]}]}]]}], ")"}]}], 
        RowBox[{"2", " ", 
          RowBox[{"Log", "[", "2", "]"}]}]]}], "\"b\"", "bits", "\"Bits\""},
    "Quantity"]}], "}"}]], "Output",
 CellChangeTimes->{{3.995729712342663*^9, 3.995729714217695*^9}, {
  3.9957297647919273`*^9, 3.995729800018875*^9}},
 CellLabel->"Out[95]=",ExpressionUUID->"18b09e97-e127-cf47-9212-6875bf6056c3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
14.3 [MSc] How do I compute joint, conditional, and mutual quantum entropies \
(and find a negative conditional entropy)?\
\>", "Subsection",
 CellChangeTimes->{
  3.9957368517601833`*^9},ExpressionUUID->"ec187617-3298-8f45-b6d6-\
5451551f79c7"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9957385127846737`*^9, 
  3.995738515394552*^9}},ExpressionUUID->"9b4e7687-ba86-1a45-ae05-\
d8a00f50d19c"],

Cell[TextData[{
 "The von Neumann entropy read off the spectrum, so that the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"0", "log0"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2a8ee58f-2901-d64f-87ae-5e4dd385d9dc"],
 " convention acts on a state with rank-deficient support:"
}], "Text",
 CellChangeTimes->{{3.995738487873926*^9, 
  3.995738508074339*^9}},ExpressionUUID->"7c228bb4-fcfd-7e42-b96b-\
f7bfa9df40bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vonNeumann", "[", "m_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"#", ".", 
      RowBox[{"Log", "[", 
       RowBox[{"2", ",", "#"}], "]"}]}]}], "&"}], "@", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", "m", "]"}], ",", "0"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9957369008327866`*^9, 3.995736901813404*^9}},
 CellLabel->
  "In[273]:=",ExpressionUUID->"f2870962-d571-9a49-99d4-427824825e8d"],

Cell["\<\
Each marginal is a contraction of the reshaped density matrix over the other \
factor\[CloseCurlyQuote]s pair of indices:\
\>", "Text",
 CellChangeTimes->{{3.9957385276050377`*^9, 
  3.995738528635132*^9}},ExpressionUUID->"c5d3bf59-ff0c-a741-87ac-\
edb5b83b844b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"reduceA", "[", "m_", "]"}], ":=", 
  RowBox[{"TensorContract", "[", 
   RowBox[{
    RowBox[{"ArrayReshape", "[", 
     RowBox[{"m", ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"reduceB", "[", "m_", "]"}], ":=", 
  RowBox[{"TensorContract", "[", 
   RowBox[{
    RowBox[{"ArrayReshape", "[", 
     RowBox[{"m", ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9957369063875523`*^9, 3.9957369076078796`*^9}},
 CellLabel->
  "In[350]:=",ExpressionUUID->"ce376247-9510-604d-b5ad-3efcb9113cbe"],

Cell["The Schmidt family as a density matrix:", "Text",
 CellChangeTimes->{{3.995738549006483*^9, 
  3.9957385518354645`*^9}},ExpressionUUID->"0fc49812-6cc1-a14e-a8f0-\
439537007b8f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixForm", "[", 
  RowBox[{"rhoAB", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"psi", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "t", "]"}], ",", "0", ",", "0", ",", 
           RowBox[{"Sin", "[", "t", "]"}]}], "}"}]}], "}"}], ",", 
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "psi", ",", 
         RowBox[{"Conjugate", "[", "psi", "]"}]}], "]"}]}], "]"}], ",", 
     RowBox[{"t", "\[Element]", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9957369139911575`*^9, 3.995736940470476*^9}, {
  3.99573856022159*^9, 3.9957385649220295`*^9}},
 CellLabel->
  "In[353]:=",ExpressionUUID->"6b7fa23b-52ba-054b-bfa4-e97809b8174a"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      SuperscriptBox[
       RowBox[{"Cos", "[", "t", "]"}], "2"], "0", "0", 
      RowBox[{
       RowBox[{"Cos", "[", "t", "]"}], " ", 
       RowBox[{"Sin", "[", "t", "]"}]}]},
     {"0", "0", "0", "0"},
     {"0", "0", "0", "0"},
     {
      RowBox[{
       RowBox[{"Cos", "[", "t", "]"}], " ", 
       RowBox[{"Sin", "[", "t", "]"}]}], "0", "0", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "t", "]"}], "2"]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{{3.995736916387764*^9, 3.995736940871952*^9}, {
  3.995738554635748*^9, 3.995738565309641*^9}},
 CellLabel->
  "Out[353]//MatrixForm=",ExpressionUUID->"7b29592b-6f42-704e-bc6c-\
3cb2927620ec"]
}, Open  ]],

Cell[" Three arguments, the two parts and the whole:", "Text",
 CellChangeTimes->{{3.9957385904577217`*^9, 3.9957385920371723`*^9}, {
  3.99573925775412*^9, 
  3.995739266926506*^9}},ExpressionUUID->"bd44718d-46dc-f444-9a03-\
8fb9e2451aa0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"sA", ",", "sB", ",", "sAB"}], "}"}], "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"vonNeumann", "/@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"reduceA", "[", "rhoAB", "]"}], ",", 
       RowBox[{"reduceB", "[", "rhoAB", "]"}], ",", "rhoAB"}], "}"}]}], ",", 
    RowBox[{"0", "<", "t", "<", 
     RowBox[{"Pi", "/", "2"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.995736958968231*^9, 3.995736959477091*^9}},
 CellLabel->
  "In[369]:=",ExpressionUUID->"ba079d3c-6ad4-6848-b8ae-894eaf39634c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", 
    FractionBox[
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"Cos", "[", "t", "]"}], "2"], " ", 
         RowBox[{"Log", "[", 
          RowBox[{"Cos", "[", "t", "]"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"Sin", "[", "t", "]"}], "]"}], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "t", "]"}], "2"]}]}], ")"}]}], 
     RowBox[{"Log", "[", "2", "]"}]]}], ",", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"Cos", "[", "t", "]"}], "2"], " ", 
         RowBox[{"Log", "[", 
          RowBox[{"Cos", "[", "t", "]"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"Sin", "[", "t", "]"}], "]"}], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "t", "]"}], "2"]}]}], ")"}]}], 
     RowBox[{"Log", "[", "2", "]"}]]}], ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.995736960250225*^9, 3.9957392696928787`*^9},
 CellLabel->
  "Out[369]=",ExpressionUUID->"8454734e-594c-d445-bffb-1c0425370bde"]
}, Open  ]],

Cell["\<\
The joint, conditional and mutual entropies are assembled from those three by \
the definitions above:\
\>", "Text",
 CellChangeTimes->{{3.9957393198308487`*^9, 3.995739355420849*^9}, {
  3.9957393948003864`*^9, 
  3.9957393958840904`*^9}},ExpressionUUID->"c6a5e76d-8d24-7241-81eb-\
0e314a4d23b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sAB", ",", 
     RowBox[{"sAB", "-", "sB"}], ",", 
     RowBox[{"sA", "+", "sB", "-", "sAB"}]}], "}"}], ",", 
   RowBox[{"0", "<", "t", "<", 
    RowBox[{"Pi", "/", "2"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.995736969936035*^9, 3.995736970362892*^9}, {
  3.995738738372692*^9, 3.995738738894491*^9}, {3.995738775934454*^9, 
  3.995738777363531*^9}, {3.9957393888943977`*^9, 3.995739389479477*^9}},
 CellLabel->
  "In[370]:=",ExpressionUUID->"5a6d7e8a-2ed1-0644-b3a6-9808dd60341c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   FractionBox[
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"Cos", "[", "t", "]"}], "2"], " ", 
        RowBox[{"Log", "[", 
         RowBox[{"Cos", "[", "t", "]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"Sin", "[", "t", "]"}], "]"}], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "t", "]"}], "2"]}]}], ")"}]}], 
    RowBox[{"Log", "[", "2", "]"}]], ",", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"4", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"Cos", "[", "t", "]"}], "2"], " ", 
         RowBox[{"Log", "[", 
          RowBox[{"Cos", "[", "t", "]"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"Sin", "[", "t", "]"}], "]"}], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "t", "]"}], "2"]}]}], ")"}]}], 
     RowBox[{"Log", "[", "2", "]"}]]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9957369711537266`*^9, 3.9957387393991013`*^9, 
  3.9957387777606354`*^9, 3.9957393899193096`*^9},
 CellLabel->
  "Out[370]=",ExpressionUUID->"633cc854-8b71-724b-b782-c4f04e05c421"]
}, Open  ]],

Cell["\<\
Measured in units of the marginal entropy, which is positive across the open \
interval, they collapse to constants: the whole family has one and the same \
entropic structure, only rescaled but we see is possible to get a negative \
value:\
\>", "Text",
 CellChangeTimes->{{3.995739453501583*^9, 
  3.9957394867279778`*^9}},ExpressionUUID->"f844b959-42c2-5d47-ba6b-\
320e06bccaf4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"%", "/", "sA"}]], "Input",
 CellChangeTimes->{{3.9957394368050137`*^9, 3.995739439615883*^9}},
 CellLabel->
  "In[371]:=",ExpressionUUID->"3ff8a897-6ee7-6f4f-8e2e-bb34145ca479"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"-", "1"}], ",", "2"}], "}"}]], "Output",
 CellChangeTimes->{3.9957394399151096`*^9},
 CellLabel->
  "Out[371]=",ExpressionUUID->"3aed6ffe-3653-7b40-b5c7-03fcdfae17b4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{"sA", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.995738836753214*^9, 3.9957388507438183`*^9}},
 CellLabel->
  "In[357]:=",ExpressionUUID->"e6170293-99a4-914a-987d-d5934d04ad65"],

