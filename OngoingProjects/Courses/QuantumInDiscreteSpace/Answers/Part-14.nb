Cell["\<\
The measure is then the difference of two entropies, each read off its own \
propertie:\
\>", "Text",
 CellChangeTimes->{{3.9962462230295296`*^9, 3.9962462251854095`*^9}, {
  3.9962462676459274`*^9, 
  3.996246271277529*^9}},ExpressionUUID->"b9be0d3c-ce87-b444-ac30-\
5588acf69ddb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"qcrel", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"qdelta", "[", "qrho", "]"}], "[", 
      RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}], "-", 
     RowBox[{"qrho", "[", 
      RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}]}], ",", 
    RowBox[{
     RowBox[{"0", "<", "r", "<", "1"}], "&&", 
     RowBox[{"0", "<", "\[Theta]", "<", "\[Pi]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9962461280767975`*^9, 3.9962461363088245`*^9}},
 CellLabel->"In[62]:=",ExpressionUUID->"9ba4c32a-fef0-8d45-91f0-a7bb2384af22"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"2", " ", "r", " ", 
    RowBox[{"ArcTanh", "[", "r", "]"}]}], "+", 
   RowBox[{"Log", "[", 
    FractionBox[
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["r", "2"]}], 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{
       SuperscriptBox["r", "2"], " ", 
       SuperscriptBox[
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]], "]"}], "+", 
   RowBox[{"r", " ", 
    RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      FractionBox["2", 
       RowBox[{"1", "+", 
        RowBox[{"r", " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]]}], "]"}]}]}], 
  RowBox[{"Log", "[", "4", "]"}]]], "Output",
 CellChangeTimes->{3.9962461409699173`*^9},
 CellLabel->"Out[62]=",ExpressionUUID->"2ef1e774-4dd0-d346-b542-5e0d3fe7dacb"]
}, Open  ]],

Cell["Check equality:", "Text",
 CellChangeTimes->{{3.9962472980890102`*^9, 
  3.996247300998514*^9}},ExpressionUUID->"c1047525-9633-6d45-b358-\
31ff02ad0d26"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"qcrel", "-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"vonNeumann", "[", 
       RowBox[{"delta", "[", "rho", "]"}], "]"}], "-", 
      RowBox[{"vonNeumann", "[", "rho", "]"}]}], ")"}]}], ",", 
   RowBox[{
    RowBox[{"0", "<", "r", "<", "1"}], "&&", 
    RowBox[{"0", "<", "\[Theta]", "<", "Pi"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9962461555698185`*^9, 3.996246163338623*^9}},
 CellLabel->"In[64]:=",ExpressionUUID->"69dc48e2-4baf-cf4b-ba2a-a6046815b928"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{{3.9962461581008472`*^9, 3.9962461635961*^9}},
 CellLabel->"Out[64]=",ExpressionUUID->"f848bad2-1408-1347-8f0b-fff280490727"]
}, Open  ]],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["l", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e33837d0-86ff-4a4c-bea9-1135a1eafb88"],
 " measure has no object-level route, since it is a sum over matrix entries \
in the chosen basis, so it is read from the state\[CloseCurlyQuote]s own \
matrix and agrees with the same sum taken by hand:"
}], "Text",
 CellChangeTimes->{{3.9962462973708572`*^9, 
  3.9962463229584084`*^9}},ExpressionUUID->"9e8cbe5a-b13c-6c48-b414-\
44dcc14a1466"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cl1", "[", "qs_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Total", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{"qs", "[", "\"\<AmplitudesList\>\"", "]"}], "]"}], "]"}], "-", 
   RowBox[{"Tr", "[", "qs", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.99624668955031*^9, 3.9962466902322903`*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"b60f4ab8-77ac-f447-a8ac-336f97158e82"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"cl1", "[", "qrho", "]"}], "==", 
    RowBox[{"r", " ", 
     RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ",", 
   RowBox[{
    RowBox[{"0", "<", "r", "<", "1"}], "&&", 
    RowBox[{"0", "<", "\[Theta]", "<", "Pi"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9962466990693684`*^9, 3.9962467141209335`*^9}},
 CellLabel->"In[77]:=",ExpressionUUID->"7c990872-1be3-8447-9507-605eee1a6b2e"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.9962467087597656`*^9, 3.9962467145232105`*^9}},
 CellLabel->"Out[77]=",ExpressionUUID->"5ed84c46-6931-d246-ae01-81eeca93af70"]
}, Open  ]]
}, Open  ]]
