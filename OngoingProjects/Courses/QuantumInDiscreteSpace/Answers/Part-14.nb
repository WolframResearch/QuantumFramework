Cell[BoxData[
 RowBox[{"Min", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumDistance", "[", 
     RowBox[{"#1", ",", "#2", ",", "\"\<RelativeEntropy\>\""}], "]"}], "&"}], 
   "@@@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", "\"\<RandomMixed\>\"", "]"}], ",", "50", ",",
      "2"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.995728674155098*^9, 3.9957288086599197`*^9}, {
  3.9957288397557335`*^9, 3.995728871436905*^9}, {3.995728917174721*^9, 
  3.9957289216763687`*^9}},
