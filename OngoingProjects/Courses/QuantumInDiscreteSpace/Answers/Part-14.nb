 CellLabel->"Out[86]=",ExpressionUUID->"3eab08cc-e420-8f44-ac3b-32c45b0d3a50"]
}, Open  ]],

Cell["\<\
Which of the two binary entropies wins is settled by monotonicity, since the \
binary entropy rises across the lower half of its range:\
\>", "Text",
 CellChangeTimes->{{3.995991623283169*^9, 
  3.9959916243439655`*^9}},ExpressionUUID->"b42df78a-affc-bf4a-9b49-\
a68105b7778c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"h2", "[", "x", "]"}], ",", "x"}], "]"}], ">", "0"}], ",", 
   RowBox[{"0", "<", "x", "<", 
    RowBox[{"1", "/", "2"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9959906472969666`*^9, 3.9959906476969013`*^9}},
 CellLabel->"In[87]:=",ExpressionUUID->"03842edb-c482-244b-ad3c-640a91a0c537"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.995990648220108*^9, 3.9959916272282887`*^9, 
  3.995993076936455*^9, 3.9960651351508045`*^9},
 CellLabel->"Out[87]=",ExpressionUUID->"ae781b1a-a7c2-f642-9181-91d7bbcecd94"]
}, Open  ]],

Cell[TextData[{
 "The best any input can do, below the threshold ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "=", 
    RowBox[{"1", "/", "2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cf8f628b-555c-af48-80e9-43223b521ae4"],
 ", at it and above it. Only the first of the three maximizers means anything \
the other two report a tie when the state is pure:"
}], "Text",
 CellChangeTimes->{
  3.995994160572832*^9, {3.99599422941823*^9, 
   3.995994251435772*^9}},ExpressionUUID->"52511801-12eb-b448-934f-\
3fd5ca91500d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Maximize", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"h2", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Gamma]"}], ")"}], " ", "x"}], "]"}], "-", 
         RowBox[{"h2", "[", 
          RowBox[{"\[Gamma]", " ", "x"}], "]"}]}], ",", 
        RowBox[{"0", "<=", "x", "<=", "1"}]}], "}"}], ",", "x"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Gamma]", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "4"}], ",", 
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{"3", "/", "4"}]}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.995990652855942*^9, 3.9959906534430103`*^9}, {
  3.9959916483899136`*^9, 3.9959916658268833`*^9}},
 CellLabel->"In[88]:=",ExpressionUUID->"138734b3-56bc-e749-a47d-bbc17a26e524"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{"Log", "[", 
       FractionBox["4", "3"], "]"}], 
      RowBox[{"Log", "[", "2", "]"}]], ",", 
     RowBox[{"{", 
      RowBox[{"x", "\[Rule]", 
       FractionBox["4", "9"]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"x", "\[Rule]", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"x", "\[Rule]", "1"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.995990657427023*^9, {3.9959916521278076`*^9, 3.9959916669027576`*^9}, 
   3.9959942550053806`*^9, 3.996065137528982*^9},
 CellLabel->"Out[88]=",ExpressionUUID->"518ca763-41b7-1e48-8d61-0c84cad1fc05"]
}, Open  ]],

