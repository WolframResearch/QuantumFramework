}, Open  ]],

Cell["\<\
Its mutual information is a full bit, while the default entanglement test, \
which uses the realignment criterion, reports the state separable:\
\>", "Text",
 CellChangeTimes->{{3.995739979077669*^9, 
  3.9957399806087284`*^9}},ExpressionUUID->"7bfe76c5-7cac-a348-bc1f-\
70cf9d593bee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"QuantumEntanglementMonotone", "[", 
    RowBox[{"qdephased", ",", "\"\<MutualInformationI\>\""}], "]"}], ",", 
   RowBox[{"QuantumEntangledQ", "[", "qdephased", "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.9957378775757866`*^9, 3.995737879170622*^9}, {
   3.9957383257913666`*^9, 3.9957383368471622`*^9}, 3.9957383817713223`*^9, {
   3.995738419442295*^9, 3.9957384229291363`*^9}},
 CellLabel->
  "In[349]:=",ExpressionUUID->"d6ed78f2-7bab-c84d-91a4-e63c1e4b52af"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[{"1", "\"b\"", "bit", "\"Bits\""},
    "Quantity"], ",", "False"}], "}"}]], "Output",
 CellChangeTimes->{
  3.9957378810697575`*^9, 3.995738327958851*^9, 3.9957383822698402`*^9, {
   3.9957384202993355`*^9, 3.9957384233219547`*^9}},
 CellLabel->
  "Out[349]=",ExpressionUUID->"9c0c0d93-003e-4743-8c34-53dfacc09ab7"]
}, Open  ]],

Cell["\<\
Using QuantumEntangledQ with the \[OpenCurlyDoubleQuote]MutualInformationI\
\[CloseCurlyDoubleQuote] criteria returns Indeterminate for a maximally \
entangled state as readily as for this separable one, so the answer is not \
conclusive about the state:\
\>", "Text",
 CellChangeTimes->{{3.9957401007054424`*^9, 3.995740171630924*^9}, {
  3.995988065388693*^9, 
  3.9959880777702503`*^9}},ExpressionUUID->"d1ea1183-94fb-b949-bd74-\
08697096c23f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumEntangledQ", "[", 
    RowBox[{"#", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", 
       RowBox[{"{", "2", "}"}]}], "}"}], ",", "\"\<MutualInformationI\>\""}], 
    "]"}], "&"}], "/@", 
  RowBox[{"{", 
   RowBox[{"qdephased", ",", 
    RowBox[{"QuantumState", "[", "\"\<PhiPlus\>\"", "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.99573830933222*^9, 3.995738310376198*^9}, {
  3.995738411913252*^9, 3.995738417177395*^9}, {3.9957401796292706`*^9, 
  3.995740184992775*^9}},
 CellLabel->
  "In[384]:=",ExpressionUUID->"b197fefd-09a1-f240-bb6b-21c97eb3265c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"Indeterminate", ",", "Indeterminate"}], "}"}]], "Output",
 CellChangeTimes->{
  3.9957383124711113`*^9, {3.995738413668703*^9, 3.9957384176688976`*^9}, 
   3.995740187801178*^9},
 CellLabel->
  "Out[384]=",ExpressionUUID->"08518b4d-e4e5-f242-8345-529c328c501a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "14.4 [MSc] How do I compute the coherent information ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["I", "c"], "(", 
     RowBox[{"\[Rho]", ",", " ", "\[ScriptCapitalN]"}], ")"}], "=", 
    RowBox[{
     RowBox[{"S", "(", 
      RowBox[{"\[ScriptCapitalN]", "(", "\[Rho]", ")"}], ")"}], "-", 
     RowBox[{"S", "(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[ScriptCapitalN]", "\[CircleTimes]", "id"}], ")"}], Cell[
       "|",ExpressionUUID->"c0a6a412-531b-b04f-b4bb-a2f1189792a2"], 
       SubscriptBox["\[Psi]", "p"], Cell[
       "\[RightAngleBracket]",ExpressionUUID->
        "33a30bae-d018-8140-a077-d71818eca347"], Cell[
       "\[LeftAngleBracket]",ExpressionUUID->
        "4bf4ac4c-7673-754d-bda8-a63c4f320d45"], 
       SubscriptBox["\[Psi]", "p"], Cell[
       "|",ExpressionUUID->"583f4ec7-4514-2b49-91c1-8d1115faf530"]}], 
      ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b7521c25-d82d-8544-84d7-878ce5d49769"],
 " of a state through a channel?"
}], "Subsection",
 CellChangeTimes->{{3.9959900065727367`*^9, 
  3.9959901175568066`*^9}},ExpressionUUID->"bab54e99-987b-4d49-ab97-\
28d7a98d7b6d"],

Cell[TextData[{
 "The entropy of the output alone cannot say how much quantum information \
survived a channel. A channel that discards its input and emits a fixed pure \
state has a zero-entropy output and has destroyed everything, so the quantity \
has to be told what went in. Purify \[Rho] into |",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "p"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d9ac223a-2de0-9f41-9062-00b713bee5aa"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[RightAngleBracket]", "RA"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a9e31a45-389f-654b-a128-44d2f951b051"],
 ", so that an untouched reference ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f8ac1a71-fa0a-454c-b86f-80c368b199b2"],
 " holds a perfect record of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e839ccea-191a-824c-bcc1-087843e2b3ed"],
 ", send ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fc02bae5-9c96-8d45-a393-f25ad33abae6"],
 " alone through ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalN]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e902c991-c0c2-7a40-91ba-4c8639b25aa9"],
 ", and weigh what the output keeps of that record against what the pair \
keeps "
}], "Text",
 CellChangeTimes->{{3.9960656002714806`*^9, 
  3.996065715044157*^9}},ExpressionUUID->"c5056449-582d-134a-afab-\
0d621a0dcd92"],

Cell[TextData[{
 "For a concrete channel take amplitude damping, an excited state decaying to \
the ground state with probability \[Gamma], with Kraus operators \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["K", "0"], "=", 
     RowBox[{"(", GridBox[{
        {"1", "0"},
        {"0", 
         SqrtBox[
          RowBox[{"1", "-", "\[Gamma]"}]]}
       }], ")"}]}], ",", " ", 
    RowBox[{
     SubscriptBox["K", "1"], "=", 
     RowBox[{"(", GridBox[{
        {"0", 
         SqrtBox["\[Gamma]"]},
        {"0", "0"}
       }], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9deaad4d-2701-9340-b27f-12fae5553c58"],
 " on the family of states ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "p"], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}], "|", "0"}]}], 
     "\[RightAngleBracket]"}], " ", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"0", "|", 
      RowBox[{"+", "p"}], " ", "|", "1"}], "\[RightAngleBracket]"}], " ", 
    Cell["\[LeftAngleBracket]",ExpressionUUID->
     "057d4a5c-b031-ff47-8be9-2fad2e519646"], "1", Cell[
    "|",ExpressionUUID->"237893ec-043a-7f45-bdea-2f5f07c8f0b1"]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b6d00725-ce93-3a4c-b6c0-f317f90070fa"],
 ". That family is the one that decides this channel, damping commutes with \
rotations about ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "50c5be41-dbf2-ec4e-b875-dd520ef1c912"],
 ", so a coherence between the two levels contributes nothing the diagonal \
does not already carry, and the last cell below prices what an off-axis state \
costs"
}], "Text",
 CellChangeTimes->{{3.995990887634371*^9, 3.9959909256289673`*^9}, {
  3.9959909688160954`*^9, 3.995991091729519*^9}, {3.995991122544239*^9, 
  3.99599117188183*^9}, {3.9959912084728184`*^9, 
  3.9959912469325943`*^9}},ExpressionUUID->"cf6e625f-d674-9c47-9934-\
730a0aca3b51"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9959901226124077`*^9, 
  3.9959901278547707`*^9}},ExpressionUUID->"71409610-d56c-274a-ac57-\
1d99066131aa"],

Cell[TextData[{
 "The entropy functional, read off the spectrum so the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"0", "log0"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "abc34faa-8701-4347-a77d-21d93ad8f6c0"],
 " convention acts:"
}], "Text",
 CellChangeTimes->{{3.995990699018055*^9, 
  3.995990738871567*^9}},ExpressionUUID->"9cd3ee12-0423-764f-928d-\
0484d9de3caf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vonNeumann", "[", "m_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"#", ".", 
      RowBox[{"Log", "[", 
       RowBox[{"2", ",", "#"}], "]"}]}]}], "&"}], "@", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", "m", "]"}], ",", "0"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9959899918842354`*^9, 3.9959899925903053`*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"be73d9b4-2618-9240-9682-c1312094be0c"],

Cell["\<\
Every state below turns out diagonal, so the binary entropy is the closed \
form to compare against:\
\>", "Text",
 CellChangeTimes->{{3.9959912932997303`*^9, 
  3.9959912960024757`*^9}},ExpressionUUID->"a4085d07-bc61-bf48-8caf-\
1d68c0bb7496"],

Cell[BoxData[
 RowBox[{
  RowBox[{"h2", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "x"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"2", ",", "x"}], "]"}]}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"2", ",", 
      RowBox[{"1", "-", "x"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9959901423852844`*^9, 3.995990143130581*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"7a06d9a4-cca9-0946-a641-414c6773156e"],

Cell["Define the amplitude damping channel by its Kraus operators:", "Text",
 CellChangeTimes->{{3.995991299219721*^9, 
  3.995991310892153*^9}},ExpressionUUID->"42f9cff9-ce94-e548-bd3f-\
78668cba60ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"kraus", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        SqrtBox[
         RowBox[{"1", "-", "\[Gamma]"}]]}], "}"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", 
        SqrtBox["\[Gamma]"]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9959901531033726`*^9, 3.995990155435772*^9}, {
  3.995991097179491*^9, 3.9959910997815495`*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"015e5008-64bf-3149-bb05-85d471c8317c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       SqrtBox[
        RowBox[{"1", "-", "\[Gamma]"}]]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       SqrtBox["\[Gamma]"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.9959901582127743`*^9, {3.995991103747217*^9, 3.9959911100597744`*^9}, 
   3.995991315050791*^9, 3.996065089193556*^9},
 CellLabel->"Out[75]=",ExpressionUUID->"20ccd77e-1878-c04c-a9eb-ebd759450d2a"]
}, Open  ]],

Cell["\<\
A Kraus set is a channel only if it preserves the trace, which is a condition \
on the operators alone:\
\>", "Text",
 CellChangeTimes->{{3.995991323944231*^9, 
  3.995991325749151*^9}},ExpressionUUID->"24b6964f-ce6b-0441-9af1-\
2b53e4aa71ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "#", "]"}], ".", "#"}], "&"}], "/@",
       "kraus"}], "]"}], "==", 
    RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
   RowBox[{"0", "<", "\[Gamma]", "<", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9959901716761703`*^9, 3.995990172211115*^9}, {
  3.996065099186859*^9, 3.9960650997988186`*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"54e5534b-7f0d-bd46-92d7-20ff0252dbe5"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{
  3.9959901727934036`*^9, {3.9960650953115444`*^9, 3.9960651002949886`*^9}},
 CellLabel->"Out[78]=",ExpressionUUID->"1d1c1d1f-efbe-664b-8cea-6e0ac42799e5"]
}, Open  ]],

Cell[TextData[{
 "The purification of  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "p"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d47e77d8-eefb-774b-9a49-aa9f7d0c21e7"],
 " in Schmidt form:"
}], "Text",
 CellChangeTimes->{{3.9959913452745304`*^9, 
  3.9959913624480324`*^9}},ExpressionUUID->"ffcd4bf4-677c-6e4d-9e04-\
5090dda5c53e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"psi", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"1", "-", "p"}], "]"}], ",", "0", ",", "0", ",", 
    RowBox[{"Sqrt", "[", "p", "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9959903087989807`*^9, 3.995990309273699*^9}},
 CellLabel->"In[79]:=",ExpressionUUID->"52a2a765-0e52-3941-99a3-18703476c105"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    SqrtBox[
     RowBox[{"1", "-", "p"}]], ",", "0", ",", "0", ",", 
    SqrtBox["p"]}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{
  3.995990310295719*^9, {3.9960651031792774`*^9, 3.99606511723929*^9}},
 CellLabel->"Out[79]=",ExpressionUUID->"915be4ac-f07e-d74a-bced-0d42c8f5dbf9"]
}, Open  ]],

Cell["\<\
It is a purification because tracing the reference away returns the state it \
was built from:\
\>", "Text",
 CellChangeTimes->{{3.9959914407272625`*^9, 
  3.9959914419215107`*^9}},ExpressionUUID->"064899b7-401c-3f47-b511-\
8939782fc5bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"TensorContract", "[", 
     RowBox[{
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Outer", "[", 
         RowBox[{"Times", ",", "psi", ",", 
          RowBox[{"Conjugate", "[", "psi", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}], "==", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "-", "p"}], ",", "p"}], "}"}], "]"}]}], ",", 
   RowBox[{"0", "<", "p", "<", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9959903161272144`*^9, 3.9959903165871677`*^9}},
 CellLabel->"In[80]:=",ExpressionUUID->"cb94fbb5-d422-fd41-8fbf-84f032681fb8"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9959903171460457`*^9, 3.99599144494713*^9, 
  3.996065108213047*^9},
 CellLabel->"Out[80]=",ExpressionUUID->"64a2cef1-2622-6b46-957b-039a8b530702"]
}, Open  ]],

Cell["\<\
The channel acts on the first factor only, the reference passing through \
untouched:\
\>", "Text",
 CellChangeTimes->{{3.995991469406988*^9, 
  3.995991471340744*^9}},ExpressionUUID->"8de02c50-064f-d24c-b442-\
5850be19a840"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rhoRB", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k", "=", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"#", ",", 
             RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"k", ".", 
          RowBox[{"Outer", "[", 
           RowBox[{"Times", ",", "psi", ",", 
            RowBox[{"Conjugate", "[", "psi", "]"}]}], "]"}], ".", 
          RowBox[{"ConjugateTranspose", "[", "k", "]"}]}]}], "]"}], "&"}], "/@",
       "kraus"}], "]"}], ",", 
    RowBox[{
     RowBox[{"0", "<", "p", "<", "1"}], "&&", 
     RowBox[{"0", "<", "\[Gamma]", "<", "1"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.995990327992054*^9, 3.9959903794624405`*^9}, {
  3.9959914657111835`*^9, 3.9959914663673897`*^9}},
 CellLabel->"In[81]:=",ExpressionUUID->"4ad22110-b522-044c-a48a-56bf4aac96c8"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"1", "-", "p"}], "0", "0", 
      SqrtBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Gamma]", "-", "1"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"p", "-", "1"}], ")"}], " ", "p"}]]},
     {"0", 
      RowBox[{"\[Gamma]", " ", "p"}], "0", "0"},
     {"0", "0", "0", "0"},
     {
      SqrtBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Gamma]", "-", "1"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"p", "-", "1"}], ")"}], " ", "p"}]], "0", "0", 
      RowBox[{"p", "-", 
       RowBox[{"\[Gamma]", " ", "p"}]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{{3.9959903292297153`*^9, 3.9959903822391796`*^9}, {
  3.9959914739015484`*^9, 3.9959914771152344`*^9}, {3.996065110869261*^9, 
  3.9960651132841034`*^9}},
 CellLabel->"Out[81]=",ExpressionUUID->"81756f7d-f774-084b-b69f-fc415832bd75"]
}, Open  ]],

Cell["\<\
The output on its own is that state with the reference traced away:\
\>", "Text",
 CellChangeTimes->{{3.9959914922782707`*^9, 
  3.995991493996996*^9}},ExpressionUUID->"9cebd753-c573-ae46-a300-\
c8192eadc038"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rhoB", "=", 
  RowBox[{"TensorContract", "[", 
   RowBox[{
    RowBox[{"ArrayReshape", "[", 
     RowBox[{"rhoRB", ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9959905852866154`*^9, 3.9959905857850647`*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"132213ea-9ee5-2944-bcb6-106e0c877411"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{
       RowBox[{"\[Gamma]", " ", "p"}], "-", "p", "+", "1"}], "0"},
     {"0", 
      RowBox[{"p", "-", 
       RowBox[{"\[Gamma]", " ", "p"}]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{
  3.9959905863052425`*^9, {3.995991496201418*^9, 3.9959914978635826`*^9}, {
   3.9959930331017914`*^9, 3.995993035535322*^9}, {3.996065121211336*^9, 
   3.996065123331505*^9}},
 CellLabel->"Out[82]=",ExpressionUUID->"8e51d3ae-104e-4b4c-80a1-3e97fb3e96c3"]
}, Open  ]],

Cell["The two entropies the definition asks for:", "Text",
 CellChangeTimes->{{3.995991519244398*^9, 
  3.995991520590412*^9}},ExpressionUUID->"0fe35543-270e-0648-a8ea-\
6216e8848ebb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"entB", ",", "entRB"}], "}"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"vonNeumann", "/@", 
     RowBox[{"{", 
      RowBox[{"rhoB", ",", "rhoRB"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"0", "<", "p", "<", "1"}], "&&", 
     RowBox[{"0", "<", "\[Gamma]", "<", "1"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9959905979673004`*^9, 3.9959905984855995`*^9}, {
  3.995993037906294*^9, 3.9959930384694805`*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"d88a673d-2e69-4c42-8ae9-71c646657603"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "p", "-", 
        RowBox[{"p", " ", "\[Gamma]"}]}], ")"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"1", "+", 
        RowBox[{"p", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "\[Gamma]"}], ")"}]}]}], "]"}]}], "+", 
     RowBox[{"p", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "\[Gamma]"}], ")"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"p", "-", 
        RowBox[{"p", " ", "\[Gamma]"}]}], "]"}]}]}], 
    RowBox[{"Log", "[", "2", "]"}]], ",", 
   FractionBox[
    RowBox[{
     RowBox[{"2", " ", "p", " ", "\[Gamma]", " ", 
      RowBox[{"ArcTanh", "[", 
       RowBox[{"1", "-", 
        RowBox[{"2", " ", "p", " ", "\[Gamma]"}]}], "]"}]}], "-", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "-", 
       RowBox[{"p", " ", "\[Gamma]"}]}], "]"}]}], 
    RowBox[{"Log", "[", "2", "]"}]]}], "}"}]], "Output",
 CellChangeTimes->{3.995990601505419*^9, 3.995991547341406*^9, 
  3.995993039489294*^9, 3.9960651258571568`*^9},
 CellLabel->"Out[83]=",ExpressionUUID->"7a8d79af-ce5b-774f-b467-34602536311e"]
}, Open  ]],

Cell["\<\
Both are binary entropies of a damped population, one of what survives and \
one of what leaks:\
\>", "Text",
 CellChangeTimes->{{3.99599154150906*^9, 
  3.9959915429987545`*^9}},ExpressionUUID->"91d9bdd7-9fab-f54f-a4db-\
85f356844492"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"entB", ",", "entRB"}], "}"}], "==", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"h2", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "\[Gamma]"}], ")"}], " ", "p"}], "]"}], ",", 
      RowBox[{"h2", "[", 
       RowBox[{"\[Gamma]", " ", "p"}], "]"}]}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"0", "<", "p", "<", "1"}], "&&", 
    RowBox[{"0", "<", "\[Gamma]", "<", "1"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.995990615186735*^9, 3.995990615656067*^9}, {
  3.995993043101177*^9, 3.995993053953247*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"b050579a-e3cb-724d-ad94-6d9843f07308"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{
  3.995990618225445*^9, 3.995991553485527*^9, {3.995993045505455*^9, 
   3.9959930558760777`*^9}, 3.9960651286159573`*^9},
 CellLabel->"Out[84]=",ExpressionUUID->"09d47666-500b-0946-92d5-6b91d6c42faf"]
}, Open  ]],

Cell["\<\
The complementary channel sends the input to the environment, its matrix \
elements the overlaps of the Kraus operators in that state:\
\>", "Text",
 CellChangeTimes->{{3.9959915656674995`*^9, 
  3.995991567497465*^9}},ExpressionUUID->"6290981a-8257-074b-b538-\
531669cd3f02"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rhoE", "=", 
  RowBox[{"Outer", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{"#1", ".", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "-", "p"}], ",", "p"}], "}"}], "]"}], ".", 
       RowBox[{"ConjugateTranspose", "[", "#2", "]"}]}], "]"}], "&"}], ",", 
    "kraus", ",", "kraus", ",", "1"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9959906296758404`*^9, 3.9959906301760025`*^9}},
 CellLabel->"In[85]:=",ExpressionUUID->"a58133e6-c3ac-2d4b-b7f2-bbc1a7e387d7"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{"1", "-", "\[Gamma]"}]], " ", "p", " ", 
        TemplateBox[{
          SqrtBox[
           RowBox[{"1", "-", "\[Gamma]"}]]},
         "Conjugate"]}], "-", "p", "+", "1"}], "0"},
     {"0", 
      RowBox[{
       SqrtBox["\[Gamma]"], " ", "p", " ", 
       TemplateBox[{
         SqrtBox["\[Gamma]"]},
        "Conjugate"]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{
  3.995990630737417*^9, 3.995991570432045*^9, {3.995993063628954*^9, 
   3.9959930663604755`*^9}, {3.996065129393215*^9, 3.996065130622183*^9}},
 CellLabel->"Out[85]=",ExpressionUUID->"8992adfe-d5f5-4c41-a400-e6b144a268bd"]
}, Open  ]],

Cell[TextData[{
 "The environment\[CloseCurlyQuote]s entropy is the pair\[CloseCurlyQuote]s, \
which is the Stine-spring identity and the second form of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "c"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "425e0731-9a8b-c34b-a8e8-66a134d3ff91"],
 ":"
}], "Text",
 CellChangeTimes->{{3.995991589087837*^9, 
  3.9959916047757416`*^9}},ExpressionUUID->"62c6b2be-31b6-5e42-8f79-\
1d8ba31ed0d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"vonNeumann", "[", "rhoE", "]"}], "==", "entRB"}], ",", 
   RowBox[{
    RowBox[{"0", "<", "p", "<", "1"}], "&&", 
    RowBox[{"0", "<", "\[Gamma]", "<", "1"}]}]}], "]"}]], "Input",
