Cell[BoxData[
 RowBox[{"QuantumDistance", "[", 
  RowBox[{"\[Rho]", ",", "\[Psi]", ",", "\"\<RelativeEntropy\>\""}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9957282123712845`*^9, 3.995728222833069*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"85656400-b02d-8d47-ad2b-50c278f92c6f"],

