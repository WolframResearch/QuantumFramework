           Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
      "Picture" -> "Schrodinger", "Label" -> None, "ParameterSpec" -> {}|>]]],
   TraditionalForm]], "Output",
 CellChangeTimes->{{3.995992928828102*^9, 3.9959929533649063`*^9}, {
  3.9960652952360935`*^9, 3.9960652969482536`*^9}},
 CellLabel->"Out[94]=",ExpressionUUID->"b30f66f9-5797-7844-a51b-83eaea92435c"]
}, Open  ]],

Cell["The same two entropies, each read off its own object:", "Text",
