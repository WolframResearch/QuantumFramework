  3.996065301506817*^9}},ExpressionUUID->"d0938488-0b7f-2440-9c7a-\
40bf104c2625"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"qpair", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"QuantumPartialTrace", "[", 
        RowBox[{"qout", ",", 
         RowBox[{"{", "2", "}"}]}], "]"}], "[", 
       RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}], ",", 
      RowBox[{"qout", "[", 
       RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"0", "<", "p", "<", "1"}], "&&", 
     RowBox[{"0", "<", "\[Gamma]", "<", "1"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.99599296754801*^9, 3.995992992879547*^9}, {
  3.9960653088589*^9, 3.996065314549614*^9}},
 CellLabel->"In[95]:=",ExpressionUUID->"4d1bedfb-13c9-014a-a55d-47b3cebc7b75"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "p", "-", 
        RowBox[{"p", " ", "\[Gamma]"}]}], ")"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"1", "+", 
        RowBox[{"p", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "\[Gamma]"}], ")"}]}]}], "]"}]}], "+", 
     RowBox[{"p", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "\[Gamma]"}], ")"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"p", "-", 
        RowBox[{"p", " ", "\[Gamma]"}]}], "]"}]}]}], 
    RowBox[{"Log", "[", "2", "]"}]], ",", 
   FractionBox[
    RowBox[{
     RowBox[{"2", " ", "p", " ", "\[Gamma]", " ", 
      RowBox[{"ArcTanh", "[", 
       RowBox[{"1", "-", 
        RowBox[{"2", " ", "p", " ", "\[Gamma]"}]}], "]"}]}], "-", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "-", 
       RowBox[{"p", " ", "\[Gamma]"}]}], "]"}]}], 
    RowBox[{"Log", "[", "2", "]"}]]}], "}"}]], "Output",
 CellChangeTimes->{3.99599297117338*^9, 3.996065315288275*^9},
 CellLabel->"Out[95]=",ExpressionUUID->"1acf886c-3520-db45-a614-c299980502dc"]
}, Open  ]],

