  3.9962471112678356`*^9}},ExpressionUUID->"4c33574d-a01b-1c41-82b8-\
39a7c95a329f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rho", "=", 
  RowBox[{"bloch", "[", 
   RowBox[{"r", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Theta]", "]"}], ",", "0", ",", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9962455837314262`*^9, 3.996245602570801*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"abb4a26e-bba9-2e48-b969-f6b22dcfe8df"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"r", " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", "2"], " ", "r", " ", 
