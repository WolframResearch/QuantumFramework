Cell["Asking that state for the mutual information of 14.3:", "Text",
 CellChangeTimes->{{3.996232326821171*^9, 
  3.996232332559841*^9}},ExpressionUUID->"d4677be8-3a7e-8a41-be14-\
44b47a9ee001"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"qmi", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"QuantumEntanglementMonotone", "[", 
     RowBox[{"qcq", ",", "\"\<MutualInformationI\>\""}], "]"}], ",", 
    RowBox[{"0", "<", "\[Theta]", "<", "Pi"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9962318663811703`*^9, 3.996231870867241*^9}, 
   3.9962320323388424`*^9},
 CellLabel->"In[95]:=",ExpressionUUID->"16be99ab-e5eb-8f4b-a3df-b6cac077f0d9"],

Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      RowBox[{"Log", "[", "108", "]"}], "+", 
