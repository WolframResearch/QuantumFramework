Cell[BoxData[
 FormBox[
  InterpretationBox[
   TooltipBox[
    StyleBox[
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], " ", "r", " ", 
          RowBox[{"cos", "(", "\[Theta]", ")"}]}], "+", 
         FractionBox["1", "2"]}], ")"}], 
       FormBox[
        InterpretationBox[
         RowBox[{
          FormBox[
