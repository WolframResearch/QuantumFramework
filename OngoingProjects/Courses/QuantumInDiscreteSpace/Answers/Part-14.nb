}, Open  ]],

Cell["Both readings agree with the previous calculation:", "Text",
 CellChangeTimes->{{3.9962323947662334`*^9, 
  3.996232407251272*^9}},ExpressionUUID->"83788f38-66a8-f646-a2b1-\
1ef3599ecbb8"],

