(* Beginning of Notebook Content *)
Notebook[{
Cell[BoxData[
 RowBox[{"<<", "Wolfram`QuantumFramework`"}]], "Input",
 CellChangeTimes->{{3.995647993678381*^9, 3.9956479989462585`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"4757436a-3adf-0c45-b819-5d84c8290b94"],

Cell[CellGroupData[{

Cell["\<\
14.1 [MSc] How do I compute and compare the Shannon and von Neumann entropies?\
\>", "Subsection",
 CellChangeTimes->{
  3.995631016142317*^9},ExpressionUUID->"36ca4f9e-f78d-694a-a21f-\
4fce13b79514"],

Cell[TextData[{
 "Regarding quantum state there is only one  basic formula . For a \
probability distribution ",
 Cell[BoxData[
  FormBox[
   FormBox["p",
    TraditionalForm], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "009dc877-f53d-7a42-b9f1-d1d6f8ed5248"],
 " and for a state \[Rho] we can define ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"H", "(", "p", ")"}], "=", " ", 
     RowBox[{"-", " ", 
      RowBox[{
       SubscriptBox["\[Sum]", 
        RowBox[{" ", "i"}]], " ", 
       RowBox[{
        SubscriptBox["p", "i"], 
        SubscriptBox["log", "2"], 
        SubscriptBox["p", "i"]}]}]}]}], ",", "  ", 
    RowBox[{
     RowBox[{"S", "(", "\[Rho]", ")"}], "=", " ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Tr", "(", 
        RowBox[{"\[Rho]", " ", 
         SubscriptBox["log", "2"], "\[Rho]"}], ")"}]}], "=", " ", 
      RowBox[{"H", "(", 
       RowBox[{"spectrum", " ", "\[Rho]"}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40f8b637-8649-7d44-91a1-b90551adf587"],
 ", with the convention ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", " ", "log", " ", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "14c6ee3d-665e-6649-8981-26993196b60c"],
 " so pure states have entropy equal to 0. Reading S as H of the eigenvalue \
list is the whole content of the second equality, since a matrix function \
acts on eigenvalues and leaves eigenvectors alone."
}], "Text",
 CellChangeTimes->{{3.9956390083148136`*^9, 3.995639260847521*^9}, {
  3.9956398528835564`*^9, 
  3.995639858790079*^9}},ExpressionUUID->"ebb6092c-7c4a-3247-b78c-\
b8b9ddfc35ef"],

Cell[TextData[{
 "So \[OpenCurlyDoubleQuote]comparing\[CloseCurlyDoubleQuote] the two is only \
a question once a distribution is named, and the honest comparison is against \
the one an experiment actually produces. Measuring \[Rho] in some orthonormal \
basis {|i\[RightAngleBracket]} gives outcome probabilities ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "i"], "="}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "12371377-b98d-094f-9b09-5fe18179ae7a"],
 " \[LeftAngleBracket]i|\[Rho]|i\[RightAngleBracket] , the diagonal of \[Rho] \
in that basis, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"H", "(", "p", ")"}], "\[GreaterEqual]", 
    RowBox[{"S", "(", "\[Rho]", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fa7a490c-79c4-ef46-9f7e-af8c5c82a34d"],
 " with equality when the basis is exactly the eigenbasis of \[Rho]. For the \
mixed qubit state ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"I", "+", 
       RowBox[{
        OverscriptBox["r", "\[RightVector]"], "\[CenterDot]", " ", 
        OverscriptBox["\[Sigma]", "\[RightVector]"]}]}], ")"}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ce8560fc-ce08-4448-92a0-349c88a3f9d0"],
 "  the two sides become one function of one variable each. The spectrum is (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"1", "\[PlusMinus]", 
      RowBox[{
      Cell["|",ExpressionUUID->"0b650917-c709-0a40-b562-2d5cbcf848dc"], 
       OverscriptBox["r", "\[RightVector]"], Cell[
       "|",ExpressionUUID->"1ed6639c-c7fa-e043-996b-b64407d16107"]}]}], ")"}],
     "/", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a52f409d-b29d-f34f-814f-3680e111f992"],
 " and the ",
 Cell[BoxData[
  FormBox["Z", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2b4db00a-c65f-9e42-80d6-29f1b84871e5"],
 " outcomes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "\[PlusMinus]", 
      SubscriptBox["r", "z"]}], ")"}], "/", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c3d8b9db-230e-df4c-8209-6305cab2391a"],
 ", if we define ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "(", "x", ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "x"}], " ", 
      SubscriptBox["log", "2"], "x"}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "x"}], ")"}], 
      RowBox[{
       SubscriptBox["log", "2"], "(", 
       RowBox[{"1", "-", "x"}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c33289f0-29e4-4248-aa90-6e21121b7e09"],
 " then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"S", "(", "\[Rho]", ")"}], "=", 
     RowBox[{"h", "(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"1", "+"}], "|", 
         OverscriptBox["r", "\[RightVector]"], "|"}], ")"}], "/", "2"}], 
      ")"}]}], ",", " ", 
    RowBox[{
     RowBox[{"H", "(", 
      SubscriptBox["p", "z"], ")"}], "=", 
     RowBox[{"h", "(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SubscriptBox["r", "z"]}], ")"}], "/", "2"}], ")"}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5f84f777-7da8-d643-8793-1087949a7e39"],
 ". And since ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "(", 
    FractionBox[
     RowBox[{"1", "+", "r"}], "2"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ed606826-01a2-2b42-b877-0c5453c9973a"],
 " decreases as the radius ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8a1f680a-d516-204b-b67f-cac7bc465bb0"],
 " grows ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox["r", "z"], "|", 
    RowBox[{"\[LessEqual]", " ", 
     RowBox[{"|", 
      OverscriptBox["r", "\[RightVector]"], "|"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0ab5f319-9f68-844d-90bc-59996895f8e6"],
 "always, the inequality is exactly the statement that the measured radius \
cannot exceed the true one"
}], "Text",
 CellChangeTimes->{{3.9956392649698677`*^9, 3.9956394237742405`*^9}, {
  3.9956395022140007`*^9, 3.995639833448992*^9}, {3.995639863634001*^9, 
  3.995639869338482*^9}, {3.9956401286415386`*^9, 
  3.9956402433446217`*^9}},ExpressionUUID->"aaae019f-67a6-5a4c-ba7d-\
d1eb20512832"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9956379013360176`*^9, 
  3.9956379039114876`*^9}},ExpressionUUID->"64bb9af9-2a41-6b49-9324-\
6a29bc17f92a"],

Cell["Define the mixed qubit density matrix:", "Text",
 CellChangeTimes->{{3.995640254957279*^9, 
  3.995640259704647*^9}},ExpressionUUID->"3ba9401b-2fa1-f240-a56a-\
a1112b3ef71c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rho", "=", 
  RowBox[{
   RowBox[{"1", "/", "2"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], ".", 
      RowBox[{"PauliMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], 
    ")"}]}]}]], "Input",
 CellChangeTimes->{{3.9956379052730675`*^9, 3.995637918739603*^9}, 
   3.995640251764801*^9},
 CellLabel->
  "In[114]:=",ExpressionUUID->"d1f59d6c-2b4a-4c4b-8699-66489ba8dc71"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{"1", "+", "rz"}], "2"], ",", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"rx", "-", 
        RowBox[{"\[ImaginaryI]", " ", "ry"}]}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"rx", "+", 
        RowBox[{"\[ImaginaryI]", " ", "ry"}]}], ")"}]}], ",", 
     FractionBox[
      RowBox[{"1", "-", "rz"}], "2"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.995640252074623*^9, 3.995640266235111*^9}},
 CellLabel->
  "Out[114]=",ExpressionUUID->"88147fc0-e138-ea46-8f42-70b7a0c17f29"]
}, Open  ]],

Cell["Define H(p):", "Text",
 CellChangeTimes->{{3.995640270045086*^9, 
  3.9956402778154545`*^9}},ExpressionUUID->"add18f65-0b7f-cb4c-9fbb-\
48c793fde3f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"shannon", "[", "p_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"#", ".", 
      RowBox[{"Log", "[", 
       RowBox[{"2", ",", "#"}], "]"}]}]}], "&"}], "@", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{"p", ",", "0"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9956379201228313`*^9, 3.9956379211036816`*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"93808bc7-baad-d84f-aa24-2f2ecd56cb71"],

Cell["\<\
The spectrum depends on the Bloch vector only through its length:\
\>", "Text",
 CellChangeTimes->{{3.995640286875721*^9, 
  3.995640288049713*^9}},ExpressionUUID->"dd9f059d-105a-6b41-a6a2-\
0b80d559a098"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Eigenvalues", "[", "rho", "]"}], ",", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], ",", "Reals"}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9956379286982174`*^9, 3.995637929387356*^9}},
 CellLabel->
  "In[115]:=",ExpressionUUID->"5adcbefd-1ff6-1845-a9d8-a29fcd74049a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["rx", "2"], "+", 
        SuperscriptBox["ry", "2"], "+", 
        SuperscriptBox["rz", "2"]}]]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["rx", "2"], "+", 
        SuperscriptBox["ry", "2"], "+", 
        SuperscriptBox["rz", "2"]}]]}], ")"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9956379315506725`*^9, 3.995640290156784*^9},
 CellLabel->
  "Out[115]=",ExpressionUUID->"87d09034-df8e-2247-85ec-698e66149257"]
}, Open  ]],

Cell["\<\
The von Neumann entropy computed from its definition as a matrix function, \
and the claim that it is the Shannon entropy of that spectrum:\
\>", "Text",
 CellChangeTimes->{{3.9956402980959225`*^9, 
  3.9956403002664833`*^9}},ExpressionUUID->"d69a5c64-149b-dc4b-8d47-\
6266c5c41b8d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"Tr", "[", 
         RowBox[{"rho", ".", 
          RowBox[{"MatrixLog", "[", "rho", "]"}]}], "]"}], 
        RowBox[{"Log", "[", "2", "]"}]]}], ",", 
      RowBox[{
       RowBox[{
        SuperscriptBox["rx", "2"], "+", 
        SuperscriptBox["ry", "2"], "+", 
        SuperscriptBox["rz", "2"]}], "\[LessEqual]", "1"}]}], "]"}], "/.", 
    "\[VeryThinSpace]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["rx", "2"], "+", 
      SuperscriptBox["ry", "2"], "+", 
      SuperscriptBox["rz", "2"]}], "\[Rule]", 
     SuperscriptBox["r", "2"]}]}], ",", 
   RowBox[{"r", ">", "0"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.995637942314848*^9, 3.995638087102049*^9}, 
   3.9956381213556194`*^9, 3.995638428301855*^9},
 CellLabel->
  "In[116]:=",ExpressionUUID->"1c7a41d4-129c-d444-9cfd-9bec94e3b23e"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"r", " ", 
    RowBox[{"Log", "[", 
     FractionBox[
      RowBox[{"1", "-", "r"}], 
      RowBox[{"1", "+", "r"}]], "]"}]}], "+", 
   RowBox[{"Log", "[", 
    RowBox[{"-", 
     FractionBox["4", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["r", "2"]}]]}], "]"}]}], 
  RowBox[{"Log", "[", "4", "]"}]]], "Output",
 CellChangeTimes->{
  3.995637943377262*^9, {3.9956379797352734`*^9, 3.9956380337450466`*^9}, {
   3.9956380706598244`*^9, 3.995638087455286*^9}, 3.995638129666033*^9, 
   3.995638431890932*^9, 3.995640303699085*^9},
 CellLabel->
  "Out[116]=",ExpressionUUID->"2b5c370d-9b4b-1843-80c2-683591b0b304"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{"rho", ".", 
        RowBox[{"MatrixLog", "[", "rho", "]"}]}], "]"}], 
      RowBox[{"Log", "[", "2", "]"}]]}], "\[Equal]", 
    RowBox[{"shannon", "[", 
     RowBox[{"Eigenvalues", "[", "rho", "]"}], "]"}]}], ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox["rx", "2"], "+", 
     SuperscriptBox["ry", "2"], "+", 
     SuperscriptBox["rz", "2"]}], "\[LessEqual]", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9956381085056133`*^9, 3.9956381240026417`*^9}, 
   3.995638422640341*^9},
 CellLabel->
  "In[117]:=",ExpressionUUID->"d8bec2dc-9bd7-e842-9bc8-15827b780e94"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.9956381098695087`*^9, 3.9956381273013287`*^9}, 
   3.995638423610985*^9, 3.995640307401146*^9},
 CellLabel->
  "Out[117]=",ExpressionUUID->"0d695a61-00a5-6440-af15-fce34c043b4b"]
}, Open  ]],

Cell["\<\
A measurement in the computational basis reads the diagonal, and its Shannon \
entropy is a different number built from the same formula:\
\>", "Text",
 CellChangeTimes->{{3.9956403170062733`*^9, 
  3.99564031800906*^9}},ExpressionUUID->"f20131e5-0361-0f43-8c40-\
6843a7ca3c11"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Diagonal", "[", "rho", "]"}], ",", 
   RowBox[{"shannon", "[", 
    RowBox[{"Diagonal", "[", "rho", "]"}], "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.995638143477354*^9, 3.9956381439104633`*^9}},
 CellLabel->"In[80]:=",ExpressionUUID->"7511a090-cf66-b647-be6e-b4eeb66ea074"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{"1", "+", "rz"}], "2"], ",", 
     FractionBox[
      RowBox[{"1", "-", "rz"}], "2"]}], "}"}], ",", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "rz"}], ")"}], " ", 
       RowBox[{"Log", "[", 
        FractionBox[
         RowBox[{"1", "-", "rz"}], "2"], "]"}]}], 
      RowBox[{"2", " ", 
       RowBox[{"Log", "[", "2", "]"}]}]]}], "-", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "rz"}], ")"}], " ", 
      RowBox[{"Log", "[", 
       FractionBox[
        RowBox[{"1", "+", "rz"}], "2"], "]"}]}], 
     RowBox[{"2", " ", 
      RowBox[{"Log", "[", "2", "]"}]}]]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9956381442902336`*^9, 3.9956381952613144`*^9},
 CellLabel->"Out[80]=",ExpressionUUID->"bf08048e-81f3-654f-a2f6-0b6f45c8425a"]
}, Open  ]],

Cell[TextData[{
 "The comparison needs no search. The binary entropy falls as the radius \
grows, and the measured radius ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox["r", "z"], "|"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a17dc9ef-64ca-1f46-b4c7-ea8a9d38d1c4"],
 "  never exceeds the true radius |",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["r", "\[RightVector]"], "|"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "080347d1-9ee1-264d-958a-86d2380dd340"],
 "  so the measured distribution is the more spread of the two:"
}], "Text",
 CellChangeTimes->{{3.995640333564968*^9, 
  3.995640377643236*^9}},ExpressionUUID->"72a967bc-4f8f-3149-acbf-\
8fb71b4891cf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "r"], 
       RowBox[{"shannon", "[", 
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{"1", "+", "r"}], "2"], ",", 
          FractionBox[
           RowBox[{"1", "-", "r"}], "2"]}], "}"}], "]"}]}], "\[LessEqual]", 
      "0"}], ",", 
     RowBox[{"0", "\[LessEqual]", "r", "<", "1"}]}], "]"}], ",", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     SubscriptBox["\[ForAll]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], "\[Element]", 
        TemplateBox[{},
         "Reals"]}]}]], 
     RowBox[{
      RowBox[{"Abs", "[", "rz", "]"}], "\[LessEqual]", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["rx", "2"], "+", 
        SuperscriptBox["ry", "2"], "+", 
        SuperscriptBox["rz", "2"]}]]}]}], "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.9956382034549313`*^9, 3.995638207652012*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"b6b15ba5-9de1-8c46-b631-36038b6207ab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{{3.9956382047206535`*^9, 3.995638209581314*^9}},
 CellLabel->"Out[83]=",ExpressionUUID->"bf6fc770-f949-c240-89c7-0ecdad70873e"]
}, Open  ]],

Cell["\<\
Equality holds exactly on the z axis, where the computational basis \
diagonalizes \[Rho]:\
\>", "Text",
 CellChangeTimes->{{3.9956403953386116`*^9, 
  3.9956404098087826`*^9}},ExpressionUUID->"9da7653f-7464-1141-938c-\
5403855032a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"shannon", "[", 
      RowBox[{"Diagonal", "[", "rho", "]"}], "]"}], "-", 
     RowBox[{"shannon", "[", 
      RowBox[{"Eigenvalues", "[", "rho", "]"}], "]"}]}], ")"}], "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rx", "->", 
      RowBox[{"1", "/", "3"}]}], ",", 
     RowBox[{"ry", "->", 
      RowBox[{"1", "/", "4"}]}], ",", 
     RowBox[{"rz", "->", 
      RowBox[{"1", "/", "5"}]}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.995638215736561*^9, 3.99563821621027*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"2878527f-ed45-c64b-8251-471346e9efb9"],

Cell[BoxData["0.1310549837225342`"], "Output",
 CellChangeTimes->{3.9956382175148907`*^9},
 CellLabel->"Out[84]=",ExpressionUUID->"77e3bd83-c46e-8347-a760-4f3f8b966422"]
}, Open  ]],

Cell["\<\
Off that axis the gap is a positive number of bits, the coherence the \
measurement threw away:\
\>", "Text",
 CellChangeTimes->{{3.9956404188894978`*^9, 
  3.9956404204390297`*^9}},ExpressionUUID->"347716eb-1017-4a4c-883a-\
0f8d5b39a0a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"shannon", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", "rho", "]"}], "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rx", "->", "1"}], ",", 
       RowBox[{"ry", "->", "0"}], ",", 
       RowBox[{"rz", "->", "0"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"shannon", "[", 
    RowBox[{
     RowBox[{"Diagonal", "[", "rho", "]"}], "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rx", "->", "1"}], ",", 
       RowBox[{"ry", "->", "0"}], ",", 
       RowBox[{"rz", "->", "0"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"shannon", "[", 
    RowBox[{
     RowBox[{"Diagonal", "[", "rho", "]"}], "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rx", "->", "0"}], ",", 
       RowBox[{"ry", "->", "0"}], ",", 
       RowBox[{"rz", "->", "1"}]}], "}"}]}], "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.995638234099638*^9, 3.99563823456917*^9}},
 CellLabel->"In[85]:=",ExpressionUUID->"2c0f6e15-8737-a645-a28d-45356952faf8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "1", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.99563823505126*^9},
 CellLabel->"Out[85]=",ExpressionUUID->"b9aa5c21-ea0f-3041-b6fd-59f536a08601"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9956310201344986`*^9, 
  3.995631023111532*^9}},ExpressionUUID->"100c6e09-4c33-3144-9d8d-\
be19d1b045df"],

Cell["\<\
Property  \[OpenCurlyDoubleQuote]VonNeumannEntropy\[CloseCurlyDoubleQuote] \
available for quantum states, result in bits:\
\>", "Text",
 CellChangeTimes->{{3.9956404342397747`*^9, 
  3.9956404959613514`*^9}},ExpressionUUID->"c8e7e0f8-85f1-e146-af81-\
173c9a6fb95d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"VNentropy", " ", "=", 
  RowBox[{
   RowBox[{"QuantumState", "[", "rho", "]"}], "[", "\"\<VonNeumannEntropy\>\"",
    "]"}]}]], "Input",
 CellChangeTimes->{
  3.9956383762170086`*^9, {3.9956384644483147`*^9, 3.995638472916744*^9}, {
   3.995640479740774*^9, 3.9956404860214386`*^9}},
 CellLabel->
  "In[121]:=",ExpressionUUID->"5e034dfe-bb1f-4f45-b81a-d5ef738d6cb8"],

Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      RowBox[{"Log", "[", "4", "]"}], "+", 
      RowBox[{
        RowBox[{"(", 
          RowBox[{
            RowBox[{"-", "1"}], "+", 
            SqrtBox[
             RowBox[{
               SuperscriptBox["rx", "2"], "+", 
               SuperscriptBox["ry", "2"], "+", 
               SuperscriptBox["rz", "2"]}]]}], ")"}], " ", 
        RowBox[{"Log", "[", 
          RowBox[{"1", "-", 
            SqrtBox[
             RowBox[{
               SuperscriptBox["rx", "2"], "+", 
               SuperscriptBox["ry", "2"], "+", 
               SuperscriptBox["rz", "2"]}]]}], "]"}]}], "-", 
      RowBox[{
        RowBox[{"(", 
          RowBox[{"1", "+", 
            SqrtBox[
             RowBox[{
               SuperscriptBox["rx", "2"], "+", 
               SuperscriptBox["ry", "2"], "+", 
               SuperscriptBox["rz", "2"]}]]}], ")"}], " ", 
        RowBox[{"Log", "[", 
          RowBox[{"1", "+", 
            SqrtBox[
             RowBox[{
               SuperscriptBox["rx", "2"], "+", 
               SuperscriptBox["ry", "2"], "+", 
               SuperscriptBox["rz", "2"]}]]}], "]"}]}]}], 
    RowBox[{"Log", "[", "4", "]"}]], "\"b\"", "bits", "\"Bits\""},
  "Quantity"]], "Output",
 CellChangeTimes->{
  3.9956384734983425`*^9, {3.9956404803809376`*^9, 3.9956404987714424`*^9}},
 CellLabel->
  "Out[121]=",ExpressionUUID->"63e28891-07a9-0d40-a362-9b28e4e39538"]
}, Open  ]],

Cell["Simplify to recover the previous result:", "Text",
 CellChangeTimes->{{3.9956404683227863`*^9, 
  3.9956405042117863`*^9}},ExpressionUUID->"c9ecd8f6-7a4e-9b45-a0bb-\
2dca2340792f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{"VNentropy", ",", 
      RowBox[{
       RowBox[{
        SuperscriptBox["rx", "2"], "+", 
        SuperscriptBox["ry", "2"], "+", 
        SuperscriptBox["rz", "2"]}], "\[LessEqual]", "1"}]}], "]"}], "/.", 
    "\[VeryThinSpace]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["rx", "2"], "+", 
      SuperscriptBox["ry", "2"], "+", 
      SuperscriptBox["rz", "2"]}], "\[Rule]", 
     SuperscriptBox["r", "2"]}]}], ",", 
   RowBox[{"r", ">", "0"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.99563838459009*^9, 3.995638405950405*^9}, {
  3.995638484174013*^9, 3.9956384852519093`*^9}},
 CellLabel->
  "In[122]:=",ExpressionUUID->"bb417786-3a29-b74d-b1a3-6ed98cf5740f"],

Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      RowBox[{"r", " ", 
        RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{"1", "-", "r"}], 
           RowBox[{"1", "+", "r"}]], "]"}]}], "+", 
      RowBox[{"Log", "[", 
        RowBox[{"-", 
          FractionBox["4", 
           RowBox[{
             RowBox[{"-", "1"}], "+", 
             SuperscriptBox["r", "2"]}]]}], "]"}]}], 
    RowBox[{"Log", "[", "4", "]"}]], "\"b\"", "bits", "\"Bits\""},
  "Quantity"]], "Output",
 CellChangeTimes->{{3.9956383857789764`*^9, 3.995638407001301*^9}, 
   3.9956384444203873`*^9, 3.995638485724455*^9, {3.995640482480831*^9, 
   3.9956405077875175`*^9}},
 CellLabel->
  "Out[122]=",ExpressionUUID->"ffcfa226-5163-2441-bf2a-175278683292"]
}, Open  ]],

Cell["\<\
The Shannon side belongs to the measurement rather than to the state, a \
QuantumMeasurement reports the entropy of its own outcome distribution, which \
is the diagonal the Z observable exposes (second argument directly extracts \
entropy in bits):\
\>", "Text",
 CellChangeTimes->{{3.9956405162020226`*^9, 3.9956405317823086`*^9}, {
  3.995640565693447*^9, 
  3.995640588465027*^9}},ExpressionUUID->"d42909e5-217b-5c4c-b4e2-\
72c947c52193"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"QuantumMeasurementOperator", "[", "\"\<Z\>\"", "]"}], "[", 
      RowBox[{"QuantumState", "[", "rho", "]"}], "]"}], "[", 
     RowBox[{"\"\<Entropy\>\"", ",", "2"}], "]"}], "\[Equal]", 
    RowBox[{"shannon", "[", 
     RowBox[{"Diagonal", "[", "rho", "]"}], "]"}]}], ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox["rx", "2"], "+", 
     SuperscriptBox["ry", "2"], "+", 
     SuperscriptBox["rz", "2"]}], "\[LessEqual]", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.995638508428152*^9, 3.9956385307318153`*^9}},
 CellLabel->
  "In[123]:=",ExpressionUUID->"28fd416e-b678-0940-a45e-7d5c81531aea"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.9956385162930393`*^9, 3.995638533831957*^9}, 
   3.995640534594496*^9},
 CellLabel->
  "Out[123]=",ExpressionUUID->"bce6e7ee-f5b8-d046-846f-132438444ac9"]
}, Open  ]],

Cell["\<\
On the z axis the observable and the state share an eigenbasis, and the two \
entropies coincide as objects, not merely numerically:\
\>", "Text",
 CellChangeTimes->{{3.9956406318060055`*^9, 
  3.9956406379561615`*^9}},ExpressionUUID->"a818bbbe-4172-1a41-86f7-\
5b6144fa3edd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"diagonal", "=", 
     RowBox[{"rho", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"rx", "->", "0"}], ",", 
        RowBox[{"ry", "->", "0"}]}], "}"}]}]}], "}"}], ",", 
   RowBox[{"Simplify", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"QuantumState", "[", "diagonal", "]"}], "[", 
       RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}], "==", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumMeasurementOperator", "[", "\"\<Z\>\"", "]"}], "[", 
        RowBox[{"QuantumState", "[", "diagonal", "]"}], "]"}], "[", 
       RowBox[{"\"\<Entropy\>\"", ",", "2"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"-", "1"}], "<", "rz", "<", "1"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.995638569223133*^9, 3.9956385851682453`*^9}, {
  3.9956386343206043`*^9, 3.9956386472460594`*^9}},
 CellLabel->
  "In[103]:=",ExpressionUUID->"9aba36c2-c37d-a840-91bd-454ae2c3c08a"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{
  3.9956385793152122`*^9, {3.9956386284289894`*^9, 3.9956386486617756`*^9}},
 CellLabel->
  "Out[103]=",ExpressionUUID->"29ba700a-9a6f-9449-9cb1-e2babcea7c52"]
}, Open  ]],

Cell["\<\
The pure equatorial state is the sharpest case , no mixedness at all, one \
full bit of measurement randomness:\
\>", "Text",
 CellChangeTimes->{{3.9956406508565826`*^9, 
  3.9956406612567406`*^9}},ExpressionUUID->"b186b6e8-20da-3e4c-bf16-\
e380613189e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], "[", 
    RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumMeasurementOperator", "[", "\"\<Z\>\"", "]"}], "[", 
     RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], "]"}], "[", 
    RowBox[{"\"\<Entropy\>\"", ",", "2"}], "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.995638659346491*^9, 3.995638691644045*^9}, 
   3.9956387280983543`*^9},
 CellLabel->
  "In[107]:=",ExpressionUUID->"d051f7f5-5ded-a945-b003-03e013122164"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "1"}], "}"}]], "Output",
 CellChangeTimes->{{3.9956386665482273`*^9, 3.9956387286771526`*^9}},
 CellLabel->
  "Out[107]=",ExpressionUUID->"c5d04ed8-1df8-c944-8327-6d9b1d44bb5b"]
}, Open  ]],

Cell[TextData[{
 "The maximum is set by dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", " ", "<=", " ", 
    RowBox[{
     SubscriptBox["log", "2"], "d"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dc54e5c9-b7ca-5044-8e44-647542d1dd6f"],
 ", reached only by the maximally mixed state:"
}], "Text",
 CellChangeTimes->{{3.99564067620829*^9, 
  3.9956407058081017`*^9}},ExpressionUUID->"6c3a86a3-606f-c24a-9b22-\
5d4b37624b7b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", "=", "5"}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<UniformMixture\>\"", ",", "d"}], "]"}], "[", 
     RowBox[{"\"\<VonNeumannEntropy\>\"", ",", "2"}], "]"}], "\[Equal]", 
    RowBox[{"Log", "[", 
     RowBox[{"2", ",", "d"}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.995638730622259*^9, 3.9956387907915573`*^9}, {
  3.995640716172703*^9, 3.995640758399723*^9}},
 CellLabel->
  "In[126]:=",ExpressionUUID->"56c1d272-12cb-f64f-863c-def1f5b28267"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.995638755649639*^9, 3.9956387911450214`*^9}, {
  3.9956407184983845`*^9, 3.9956407588793774`*^9}},
 CellLabel->
  "Out[126]=",ExpressionUUID->"a22a5112-445e-874b-91fa-bcac361d4be8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
14.2 [MSc] How do I compute the quantum relative entropy and check its \
non-negativity?\
\>", "Subsection",
 CellChangeTimes->{{3.9956418339151306`*^9, 
  3.9956418373825245`*^9}},ExpressionUUID->"1c028501-541d-1141-9127-\
d37d0c63b1d2"],

Cell[TextData[{
 "The relative entropy is defined as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"S", "(", 
     RowBox[{"\[Rho]", " ", "||", " ", "\[Sigma]"}], ")"}], "=", 
    RowBox[{
     RowBox[{"Tr", "(", 
      RowBox[{"\[Rho]", "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["log", "2"], "\[Rho]"}], "-", 
        RowBox[{
         SubscriptBox["log", "2"], "\[Sigma]"}]}], ")"}], ")"}], "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"S", "(", "\[Rho]", ")"}]}], "-", 
      RowBox[{"Tr", "(", 
       RowBox[{"\[Rho]", " ", 
        SubscriptBox["log", "2"], "\[Sigma]"}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4397e510-6b02-d846-820c-dccc069ba009"],
 " and Klein\[CloseCurlyQuote]s inequality says the answer is never negative, \
 ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"S", 
     RowBox[{"(", 
      RowBox[{"\[Rho]", "\[DoubleVerticalBar]", "\[Sigma]"}], ")"}]}], "\[GreaterEqual]",
     "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "db42b50f-abdc-ea4e-b144-50298c8305e7"],
 ", with equality only at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "=", "\[Sigma]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e5d7f15f-6ae7-6142-86f7-324c3c72b3e1"],
 ". Two properties keep it from being a distance. It is not symmetric, so S(\
\[Rho]\[DoubleVerticalBar]\[Sigma]) and S(\[Sigma]\[DoubleVerticalBar]\[Rho]) \
are different numbers and one must say which is meant, and is not even finite \
in general.  The infinity is physical rather than pathological. If \[Sigma] \
assigns probability zero to an outcome that \[Rho] allows, then a single \
measurement can rule \[Sigma] out with certainty, so no finite amount of \
evidence is needed to separate them."
}], "Text",
 CellChangeTimes->{{3.995642129680765*^9, 3.9956421470029545`*^9}, {
  3.995644696522991*^9, 3.995644798240055*^9}, {3.995644832394945*^9, 
  3.995644883568655*^9}},ExpressionUUID->"c4a62aaa-b90a-6748-a4c9-\
12b3fc510d5d"],

Cell[TextData[{
 "Two special cases anchor the general statement. Against the maximally mixed \
state the definition collapses to the entropy bound ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"S", "(", 
     RowBox[{"\[Rho]", " ", "||", " ", 
      FractionBox["I", "d"]}], ")"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["log", "2"], "d"}], "-", 
     RowBox[{"S", "(", "\[Rho]", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aaa8c20b-4c24-9348-aece-84abf235ea35"],
 " so non negativity there is exactly the statement  S(\[Rho])\[LessEqual]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["log", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "acb9f4ec-e19c-d44d-856d-5dab4661a823"],
 " d  And when \[Rho] and \[Sigma] commute, both are diagonal in one basis \
and the quantity reduces to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sum]", 
     RowBox[{" ", "i"}]], 
    RowBox[{
     SubscriptBox["p", "i"], 
     RowBox[{
      SubscriptBox["log", "2"], "(", 
      RowBox[{
       SubscriptBox["p", "i"], "/", 
       SubscriptBox["q", "i"]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e5f930ce-ed9b-5341-8b66-02f89ca935cd"],
 "  of their spectra, so the quantum statement contains the classical one \
rather than replacing it."
}], "Text",
 CellChangeTimes->{{3.995644899597746*^9, 3.9956449316573734`*^9}, {
  3.9956477017878494`*^9, 
  3.9956478346654205`*^9}},ExpressionUUID->"2d931fb8-7fd2-1c4e-8989-\
feba70140776"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9956478409768333`*^9, 
  3.995647843536623*^9}},ExpressionUUID->"0d343ff2-3550-044e-a9a2-\
6bace653aee5"],

Cell["Bloch state builder:", "Text",
 CellChangeTimes->{{3.9956478715547447`*^9, 
  3.9956478761079483`*^9}},ExpressionUUID->"0c73dfe0-806c-2e4b-bfcb-\
eab6d36f687c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bloch", "[", "v_", "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", "2"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
     RowBox[{"v", ".", 
      RowBox[{"PauliMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], 
    ")"}]}]}]], "Input",
 CellChangeTimes->{{3.9956478770406876`*^9, 3.9956478778608894`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"b981d2ef-123a-c142-91d3-a9e67711b422"],

Cell["Relative entropy definition:", "Text",
 CellChangeTimes->{{3.995648041143818*^9, 
  3.995648049646553*^9}},ExpressionUUID->"d44c9dc1-c346-ff41-8fa5-\
3df63bd10b35"],

Cell[BoxData[
 RowBox[{
  RowBox[{"relativeEntropy", "[", 
   RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Tr", "[", 
    RowBox[{"a", ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"MatrixLog", "[", "a", "]"}], "-", 
       RowBox[{"MatrixLog", "[", "b", "]"}]}], ")"}]}], "]"}], "/", 
   RowBox[{"Log", "[", "2", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.995648052058361*^9, 3.9956480527258263`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"cd0de05b-f348-4049-9dcc-d7bcbfacfa11"],

Cell["\<\
It vanishes when the two states agree, identically in the Bloch vector rather \
than at sampled points:\
\>", "Text",
 CellChangeTimes->{{3.995648087858389*^9, 
  3.9956480950295963`*^9}},ExpressionUUID->"8e1a3721-cef0-f545-916e-\
344c31c5e297"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"relativeEntropy", "[", 
    RowBox[{
     RowBox[{"bloch", "[", 
      RowBox[{"{", 
       RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], "]"}], ",", 
     RowBox[{"bloch", "[", 
      RowBox[{"{", 
       RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], "]"}]}], "]"}], ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox["rx", "2"], "+", 
     SuperscriptBox["ry", "2"], "+", 
     SuperscriptBox["rz", "2"]}], "\[LessEqual]", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.99564806328417*^9, 3.9956480772142086`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"acfc98ec-8e92-2d4d-ad01-8810560383ca"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{{3.99564806836602*^9, 3.99564807952125*^9}, 
   3.9957279809858017`*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"dea20864-f77a-714c-914b-ea23b563ae63"]
}, Open  ]],

Cell["\<\
Against the maximally mixed state it is the entropy bound in disguise, which \
is the one case where non-negativity is provable in closed form:\
\>", "Text",
 CellChangeTimes->{{3.9956481400993023`*^9, 
  3.995648173786257*^9}},ExpressionUUID->"ecd39201-b4dc-f94a-800b-\
a19d1d3e34a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"relativeEntropy", "[", 
     RowBox[{
      RowBox[{"bloch", "[", 
       RowBox[{"{", 
        RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], "]"}], ",", 
      FractionBox[
       RowBox[{"IdentityMatrix", "[", "2", "]"}], "2"]}], "]"}], "\[Equal]", 
    RowBox[{"1", "+", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"bloch", "[", 
         RowBox[{"{", 
          RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], "]"}], ".", 
        RowBox[{"MatrixLog", "[", 
         RowBox[{"bloch", "[", 
          RowBox[{"{", 
           RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], "]"}], "]"}]}], "]"}], 
      RowBox[{"Log", "[", "2", "]"}]]}]}], ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox["rx", "2"], "+", 
     SuperscriptBox["ry", "2"], "+", 
     SuperscriptBox["rz", "2"]}], "\[LessEqual]", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9956481038027496`*^9, 3.995648113977791*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"0fe63dab-0e2b-0c43-b79c-4cff6df53df2"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{
  3.9956481310393257`*^9, {3.9956481683909607`*^9, 3.995648178930977*^9}, 
   3.9957279839871025`*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"08078a71-f9ce-7142-a0fb-9039af208961"]
}, Open  ]],

Cell["\<\
Written in the Bloch radius, no radius makes it negative, so Reduce returns \
False for the whole search:\
\>", "Text",
 CellChangeTimes->{{3.9956482485713005`*^9, 
  3.9956482505958138`*^9}},ExpressionUUID->"e762f6a5-6eb4-4c4d-aa8f-\
84e19f4622f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"1", "+", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "r"}], ")"}], " ", 
         RowBox[{"Log", "[", 
          RowBox[{"2", ",", 
           FractionBox[
            RowBox[{"1", "+", "r"}], "2"]}], "]"}]}], "+", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", "r"}], ")"}], " ", 
         RowBox[{"Log", "[", 
          RowBox[{"2", ",", 
           FractionBox[
            RowBox[{"1", "-", "r"}], "2"]}], "]"}]}]}], ")"}]}], "<", "0"}], "&&", 
    RowBox[{"0", "\[LessEqual]", "r", "<", "1"}]}], ",", "r", ",", 
   TemplateBox[{},
    "Reals"]}], "]"}]], "Input",
 CellChangeTimes->{{3.9956482054993534`*^9, 3.9956482080927544`*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"0f096b12-df42-7b45-8d92-ce313cdc6cd4"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.995648213126137*^9, 3.9956482538254128`*^9, 
  3.995727986397089*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"8ecff4bd-1280-044d-a9af-08c9fb5f7ce9"]
}, Open  ]],

Cell["\<\
For a general pair the symbolic form is unwieldy, so the check is a sampled \
one: two hundred independent pairs drawn uniformly from the Bloch ball, none \
of them negative:\
\>", "Text",
 CellChangeTimes->{{3.995648283891941*^9, 
  3.9956482860154877`*^9}},ExpressionUUID->"6f145810-80b1-6a45-8e7e-\
2aaa7231aabd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Min", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Re", "[", 
     RowBox[{"relativeEntropy", "@@", 
      RowBox[{"(", 
       RowBox[{"bloch", "/@", 
        RowBox[{"RandomPoint", "[", 
         RowBox[{
          RowBox[{"Ball", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], "]"}], ",", "2"}], 
         "]"}]}], ")"}]}], "]"}], ",", "200"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.995648290540888*^9, 3.995648291241869*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"4d4905a1-2db4-e745-8bf0-7fac9e61bcf7"],

Cell[BoxData["0.025217084237192888`"], "Output",
 CellChangeTimes->{3.995648291886566*^9, 3.995727988132284*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"76330bf3-9488-d044-8282-fdb009afaca0"]
}, Open  ]],

Cell["\<\
Equality is sharp, moving the second state by one part in a hundred already \
costs a positive number of bits:\
\>", "Text",
 CellChangeTimes->{{3.9956483281618156`*^9, 
  3.9956483355557117`*^9}},ExpressionUUID->"32b149d4-f547-7248-81d9-\
0dc2df9b6d44"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "@", 
  RowBox[{"N", "@", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"relativeEntropy", "[", 
      RowBox[{
       RowBox[{"bloch", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "5"}], ",", "0", ",", 
          RowBox[{"1", "/", "2"}]}], "}"}], "]"}], ",", 
       RowBox[{"bloch", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "5"}], ",", "0", ",", 
          RowBox[{"1", "/", "2"}]}], "}"}], "]"}]}], "]"}], ",", 
     RowBox[{"relativeEntropy", "[", 
      RowBox[{
       RowBox[{"bloch", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "5"}], ",", "0", ",", 
          RowBox[{"1", "/", "2"}]}], "}"}], "]"}], ",", 
       RowBox[{"bloch", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "5"}], ",", "0", ",", 
          RowBox[{"51", "/", "100"}]}], "}"}], "]"}]}], "]"}]}], 
    "}"}]}]}]], "Input",
 CellChangeTimes->{{3.995648314158737*^9, 3.995648314895529*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"28f9766e-be1a-7c4b-a6d4-2e4932bdbc44"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0.00009964735678059799`"}], "}"}]], "Output",
 CellChangeTimes->{3.995648315460512*^9, 3.99572799121224*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"3b11debd-5147-9c44-afa4-4b2481566c0b"]
}, Open  ]],

Cell["\<\
Driving \[Sigma] to a pure state closes its support and the quantity \
diverges, which is the limit rather than an error:\
\>", "Text",
 CellChangeTimes->{{3.99564835506468*^9, 
  3.9956483599320564`*^9}},ExpressionUUID->"1bd3de9d-78da-3342-8770-\
5568ef833a0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  UnderscriptBox["\[Limit]", 
   TagBox[
    RowBox[{"eps", "\[Rule]", 
     SuperscriptBox["0", "+"]}],
    "AlternateLimitDirection"]], 
  RowBox[{"relativeEntropy", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"IdentityMatrix", "[", "2", "]"}], "2"], ",", 
    RowBox[{"bloch", "[", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"1", "-", "eps"}]}], "}"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9956483420869446`*^9, 3.99564834388373*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"6f5c02e1-78b7-dc4a-83b8-18c325687f89"],

Cell[BoxData["\[Infinity]"], "Output",
 CellChangeTimes->{{3.9956483461106663`*^9, 3.995648362165552*^9}, 
   3.9957279937878666`*^9},
 CellLabel->"Out[23]=",ExpressionUUID->"275d528a-9bfc-2547-9d02-1ed88a6c436c"]
}, Open  ]],

Cell[TextData[{
 "For commuting states it is the classical divergence, whose minimum over the \
whole square is zero, attained only on the diagonal ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", "q"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c388d61a-7f9e-ee49-b1c6-a659562f3dca"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9956483948887024`*^9, 
  3.99564840401108*^9}},ExpressionUUID->"5cff9713-8743-564f-8c60-\
d1fd9a5ed81c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "@", 
  RowBox[{"NMinimize", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"p", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"2", ",", 
          FractionBox["p", "q"]}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "p"}], ")"}], " ", 
        RowBox[{"Log", "[", 
         RowBox[{"2", ",", 
          FractionBox[
           RowBox[{"1", "-", "p"}], 
           RowBox[{"1", "-", "q"}]]}], "]"}]}]}], ",", 
      RowBox[{"0", "<", "p", "<", "1"}], ",", 
      RowBox[{"0", "<", "q", "<", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"p", ",", "q"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9956483671275806`*^9, 3.995648368589657*^9}, {
  3.9957290563163548`*^9, 3.995729057409157*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"edec5e5d-b09a-fb49-89f2-c4a475e49fb8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"p", "\[Rule]", "0.7488426165935652`"}], ",", 
     RowBox[{"q", "\[Rule]", "0.7488426165871354`"}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9956483733877487`*^9, 3.9957280028095837`*^9, 
  3.9957290594874344`*^9},
 CellLabel->"Out[91]=",ExpressionUUID->"bb2fccd5-f455-c745-96e7-fbd3d68290fc"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.995647844548231*^9, 
  3.995647848524639*^9}},ExpressionUUID->"2b7e4e43-be65-1549-80be-\
7ef96d05f62f"],

Cell["\<\
The framework carries it as a named distance, returning a Quantity in bits \
like the entropies of 14.1. On a pair of well separated mixed states it \
agrees with the definition:\
\>", "Text",
 CellChangeTimes->{{3.9956484611404095`*^9, 
  3.995648473497963*^9}},ExpressionUUID->"deb74945-a0e6-c949-ac11-\
7778878779c6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"vs", "=", 
   RowBox[{"RandomPoint", "[", 
    RowBox[{
     RowBox[{"Ball", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}], "]"}], ",", "2"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumDistance", "[", 
     RowBox[{
      RowBox[{"Apply", "[", 
       RowBox[{"Sequence", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"QuantumState", "[", 
           RowBox[{"\"\<BlochVector\>\"", "[", "#", "]"}], "]"}], "&"}], "/@",
          "vs"}]}], "]"}], ",", "\"\<RelativeEntropy\>\""}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", 
   RowBox[{"Chop", "[", 
    RowBox[{"relativeEntropy", "[", 
     RowBox[{"Apply", "[", 
      RowBox[{"Sequence", ",", 
       RowBox[{"bloch", "/@", "vs"}]}], "]"}], "]"}], "]"}]}], 
  "}"}]}], "Input",
 CellChangeTimes->{{3.995648497503914*^9, 3.9956485543506203`*^9}, {
  3.9956489547701283`*^9, 3.9956489741112766`*^9}, {3.9956491328952503`*^9, 
  3.9956491336991787`*^9}},
 CellLabel->"In[65]:=",ExpressionUUID->"4381727b-4557-814f-81ca-4927f7823ff1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1.3208030881315673`", ",", "1.320803088131566`"}], "}"}]], "Output",
 CellChangeTimes->{{3.995648970389492*^9, 3.9956489934262676`*^9}, {
  3.9956491090639496`*^9, 3.995649135658327*^9}, {3.99572801709779*^9, 
  3.9957280345623207`*^9}},
 CellLabel->"Out[66]=",ExpressionUUID->"d7b87267-8ca0-0b4c-afab-9b7c37fe817d"]
}, Open  ]],

Cell["Define a pure and a mixed state:", "Text",
 CellChangeTimes->{{3.9957285160191193`*^9, 
  3.995728531980213*^9}},ExpressionUUID->"84dc766b-e7c5-6a43-b6c6-\
88a4d7df4623"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]", " ", "=", " ", 
   RowBox[{"QuantumState", "[", "\"\<RandomMixed\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]", " ", "=", " ", 
   RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.995728099751711*^9, 3.995728114779808*^9}, {
  3.9957281491228447`*^9, 3.9957281716014137`*^9}},
 CellLabel->"In[76]:=",ExpressionUUID->"5c61b8f0-007c-7041-a5be-68b646700294"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"S", "(", 
     RowBox[{"\[Rho]", "||", "\[Sigma]"}], ")"}], "!=", 
    RowBox[{"S", "(", 
     RowBox[{"\[Sigma]", "||", "\[Rho]"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f9edce0e-1b23-604c-b557-463f80be1e5f"],
 " and can be infinite when \[Sigma] is pure, unless ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "=", "\[Sigma]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "099e612f-81f1-d44b-9d95-f10ed86c0115"],
 " that is zero:"
}], "Text",
 CellChangeTimes->{{3.995728564645872*^9, 3.9957286059883595`*^9}, {
  3.9957298461259403`*^9, 
  3.995729881758335*^9}},ExpressionUUID->"eed4f42e-98a3-ba4b-914e-\
3c0a1dba8e31"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumDistance", "[", 
  RowBox[{"\[Psi]", ",", "\[Rho]", ",", "\"\<RelativeEntropy\>\""}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9957281728716755`*^9, 3.9957281854540615`*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"f53cc31b-c081-1544-a2b9-14c496bf1dc3"],

Cell[BoxData[
 TemplateBox[{"1.3282631877239737`", "\"b\"", "bits", "\"Bits\""},
  "Quantity"]], "Output",
 CellChangeTimes->{3.9957281860951176`*^9},
 CellLabel->"Out[73]=",ExpressionUUID->"38ddbc9b-6356-9946-bbb8-081bbb1966aa"]
}, Open  ]],

