(* Beginning of Notebook Content *)
Notebook[{
Cell["Part 5. Projective measurement", "Section",ExpressionUUID->"cd1a4669-d9d9-4eed-ae4a-9d4986a583a7"],

Cell["\<\
5.1 [BSc] How do I perform a projective measurement and read outcomes, \
probabilities, and the mean?\
\>", "Subsection",ExpressionUUID->"5257c751-1a0c-417e-b45e-551535b289c7"],

Cell[TextData[{
 "A projective measurement of an observable ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c19f21ff-8d10-4f7e-9d22-19e036f57b22"],
 " returns one of ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5be9389d-4491-40fc-b3a4-75912970c82e"],
 "'s eigenvalues ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "174ad5b5-28cb-451d-9ed4-d79dcdf2db15"],
 " (the outcome) with probability ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["Tr",
     FontSlant->"Plain"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["a", "TI"]], 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1]}], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["a", "TI"]},
     "Bra"], 
    StyleBox["\[Rho]", "TI"], 
    TemplateBox[{
      StyleBox["a", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a49c3a5b-2471-4096-810b-2ff1705f5e76"],
 " (the Born rule, ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["a", "TI"], 
        StyleBox["\[Psi]", "TI"]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f7d9d76-e091-407a-812b-0d60467cb35d"],
 " for a pure state), and the mean is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"A", "\[Rho]"}], "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f7dfa59-1d85-42ea-b0f5-6b7037e4d5c2"],
 ". In short, the eigenvalues are what you can see and ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3722f37-bbca-4a3b-a84d-664ad00f2a92"],
 " weights them. We measure ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "663891ad-53da-4c00-b815-87060dd1b298"],
 " on a general qubit, building the state and the measurement each once and \
reusing them."
}], "Text",ExpressionUUID->"923a2316-320b-4a4b-a589-53c1d70a332b"],

Cell[TextData[{
 "The general mixed qubit is the Bloch state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "938aff99-4af7-43d9-8ef6-7f3745439fc7"],
 " with ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af15a753-01ac-4316-8257-58583fcbd5ad"],
 " (",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "="}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fd0bc30-1bb4-4316-84b8-43c21a4acd58"],
 " ",
 Cell[BoxData[
  RowBox[{"PauliMatrix", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4a1c841-7f16-4a54-a7b0-2b43d4fd1e41"],
 "); define it once:"
}], "Text",ExpressionUUID->"0e379050-1143-4283-bb76-b60e15377aa4"],

Cell[BoxData[
 RowBox[{"rho", " ", "=", " ", 
  RowBox[{
   RowBox[{"1", "/", "2"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rx", ",", " ", "ry", ",", " ", "rz"}], "}"}], " ", ".", " ", 
      RowBox[{"PauliMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
    ")"}]}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"22d11df1-598c-4342-803d-cc8459c0aa5d"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the possible outcomes are the eigenvalues of the observable, here in the \
order ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "-", "1"}], ",", 
   RowBox[{"+", "1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e31cc077-37b8-40b1-880c-7f3093872c2c"],
 ":"
}], "Text",ExpressionUUID->"39d3cd6a-f8ad-4452-b2a3-61dcf045bfe2"],

Cell[BoxData[
 RowBox[{"Eigenvalues", "[", 
  RowBox[{"PauliMatrix", "[", "3", "]"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"e45a362b-cec3-47d8-831f-f60d84a0ad95"],

Cell[TextData[{
 "Each outcome's probability is the corresponding eigenvector sandwiched \
around ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5594421-e7d8-49e9-a89d-981bd0b12344"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["a", "TI"]},
    "Bra"], 
   StyleBox["\[Rho]", "TI"], 
   TemplateBox[{
     StyleBox["a", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac5f9af3-e2b4-4006-b7da-a98f50e31fcd"],
 ", listed in that same eigenvalue order:"
}], "Text",ExpressionUUID->"90ef00d1-cdac-4a23-8bef-ccf1d276eea9"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "rho", " ", ".", 
      " ", "#"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"Eigenvectors", "[", 
     RowBox[{"PauliMatrix", "[", "3", "]"}], "]"}]}], ",", " ", 
   RowBox[{
    RowBox[{"-", "1"}], " ", "<=", " ", "rz", " ", "<=", " ", "1"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"9726168c-53d4-4741-9146-60a276784b37"],

Cell[TextData[{
 "The mean is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"Z", "\[Rho]"}], "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141d9743-9ce9-497e-ad50-45f1adbc89d0"],
 ":"
}], "Text",ExpressionUUID->"324cdebf-eae3-465c-b752-0a8303c5418c"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Tr", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", "rho"}], "]"}], ",",
    " ", 
   RowBox[{
    RowBox[{"-", "1"}], " ", "<=", " ", "rz", " ", "<=", " ", "1"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"a4844bc0-dec8-4dc1-abee-70bdaf8afb86"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : applying the measurement operator to the state returns a ",
 Cell[BoxData["QuantumMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62f9539d-7dc6-4127-af38-cbf85107cbf5"],
 " object, whose summary box lists the outcomes and their probabilities. \
Build it once from the same Bloch state, using the ",
 Cell[BoxData["\"\<BlochVector\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff00923a-b33e-4ef4-8373-7542a22ea1de"],
 " constructor:"
}], "Text",ExpressionUUID->"40e4d208-dd18-45a4-9caf-9d894ecfb494"],

Cell[BoxData[
 RowBox[{"meas", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumMeasurementOperator", "[", 
    RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "]"}], "[", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<BlochVector\>\"", "[", 
     RowBox[{"{", 
      RowBox[{"rx", ",", " ", "ry", ",", " ", "rz"}], "}"}], "]"}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"e623bbc9-6424-46f3-90e8-989abe13505c"],

Cell[TextData[{
 "Its ",
 Cell[BoxData["\"\<Mean\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "caff212b-ed53-452d-bca6-c335921839af"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82a22680-6e9c-42a3-94b9-750db120c7e4"],
 ":"
}], "Text",ExpressionUUID->"11bef98e-134b-4973-9404-07591bebd4de"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"meas", "[", "\"\<Mean\>\"", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"-", "1"}], " ", "<=", " ", "rz", " ", "<=", " ", "1"}]}], 
  "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"bd0d8b97-ba9a-4ed7-9546-85820e2cb0a9"],

Cell[TextData[{
 "Its ",
 Cell[BoxData["\"\<Probabilities\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f33237d5-5d62-4f68-a102-25310eb02bf3"],
 " gives the same two weights as an association keyed by each outcome, so the \
pairing needs no ordering convention:"
}], "Text",ExpressionUUID->"66c7853f-1193-4494-95ef-37a0b3774496"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{
      RowBox[{"-", "1"}], " ", "<=", " ", "rz", " ", "<=", " ", "1"}]}], 
    "]"}], " ", "&"}], " ", "/@", " ", 
  RowBox[{"meas", "[", "\"\<Probabilities\>\"", "]"}]}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"05f06a7e-c420-4bb1-9d1c-aacb3a3ab3de"],

Cell[TextData[{
 "Both assign ",
 Cell[BoxData[
  RowBox[{"+", "1", "\[Function]", 
   FractionBox[
    RowBox[{"1", "+", 
     SubscriptBox[
      StyleBox["r", "TI"], 
      StyleBox["z", "TI"]]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0960385f-476e-497e-b534-161e086b72dd"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "1", "\[Function]", 
   FractionBox[
    RowBox[{"1", "-", 
     SubscriptBox[
      StyleBox["r", "TI"], 
      StyleBox["z", "TI"]]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "abfbff34-8351-4c89-afb9-c0f4e8c34aa4"],
 " (the WL side an ordered list in eigenvalue order, the QF side an \
association keyed by outcome) and give the mean ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53dac26b-a98a-4122-bc76-9344e7a28392"],
 ": a ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c29a775-216e-46e9-a668-247eeec1625c"],
 " measurement reads only the populations (the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["r", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd99434-3e4a-490a-9cbc-f80815512885"],
 " component), so the coherences ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["x", "TI"]], ",", 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46381a82-5287-4b3b-9527-30ec8ed83b5d"],
 " drop out, and the mean is the difference of the two outcome probabilities. \
For a pure state (",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "389952ce-6345-4d39-89d3-7ecc06b43cba"],
 ") these are the familiar ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["cos",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    FractionBox[
     StyleBox["\[Theta]", "TI"], "2"]}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["sin",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    FractionBox[
     StyleBox["\[Theta]", "TI"], "2"]}], ",", 
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a549f21b-cabc-4229-b3a5-827243b9e386"],
 "."
}], "Text",ExpressionUUID->"14c5feb4-952f-4eeb-b0b6-872509640a5c"],

Cell[TextData[{
 "The same three reads carry to any dimension unchanged. For a qutrit, take \
",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["z", "TI"]], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"1", ",", "0"}], ",", 
    RowBox[{"-", "1"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33d8a1fe-1f66-4b14-984f-c75ceb11100e"],
 " and build it together with its eigensystem: the eigenvalues are the \
outcomes, the (normalized) eigenvectors the outcome states."
}], "Text",ExpressionUUID->"cf2d48b1-ae3e-4e80-bc46-b5ac51fbb9c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"jz3", " ", "=", " ", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "0", ",", " ", 
      RowBox[{"-", "1"}]}], "}"}], "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"jzEigenVal", ",", " ", "jzEigenVec"}], "}"}], " ", "=", " ", 
   RowBox[{"MapAt", "[", 
    RowBox[{"Normalize", ",", " ", 
     RowBox[{"Eigensystem", "[", "jz3", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "All"}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"954d6d10-3680-46e0-9843-fed5abff51e6"],

Cell["Measure it on a concrete normalized state:", "Text",ExpressionUUID->"5fafcb26-52af-41c7-8618-7f2bb95e396a"],

Cell[BoxData[
 RowBox[{"psi3", " ", "=", " ", 
  RowBox[{"Normalize", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "I", ",", " ", "2"}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"e1761283-8b35-46a3-ab29-74d3da5be73e"],

Cell[TextData[{
 "The Born rule pairs each eigenvalue with the squared overlap ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["a", "TI"], 
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], "3"]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18ebac30-cd06-4da7-b90e-93cf339d0323"],
 " of its eigenvector; ",
 Cell[BoxData["AssociationThread"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f4022a9-bf73-485d-8849-2a87a51d6ec5"],
 " keys those weights by outcome, so the reading needs no ordering convention:"
}], "Text",ExpressionUUID->"a2bf45b5-aa49-4e6b-a2d2-a8a5a7da9c82"],

Cell[BoxData[
 RowBox[{"AssociationThread", "[", 
  RowBox[{"jzEigenVal", ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "psi3"}], "]"}], 
      "^", "2"}], " ", "&"}], " ", "/@", " ", "jzEigenVec"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"b3ad1f9a-3f3e-4523-98cc-cfd414497493"],

Cell[TextData[{
 "and the mean is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], "=", 
   RowBox[{
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], "3"]},
     "Bra"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["z", "TI"]], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], "3"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "514e77a7-c733-4bf6-b171-27fbc42788e8"],
 ":"
}], "Text",ExpressionUUID->"6a2ae060-bfde-4028-9ab3-3675c89f6d49"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Conjugate", "[", "psi3", "]"}], " ", ".", " ", "jz3", " ", ".", 
  " ", "psi3"}]], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"cc968f28-f9b3-4837-ad5c-36c2f0211256"],

Cell[TextData[{
 "The QF measurement object carries the same reads. Applying it to the state \
returns a ",
 Cell[BoxData["QuantumMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf458b41-fc3c-49bb-8988-dd67aa7a78b7"],
 " whose summary box already lists the three outcomes and their weights:"
}], "Text",ExpressionUUID->"e333e5e2-7733-4651-a41e-d861f79bd4fe"],

Cell[BoxData[
 RowBox[{"meas3", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumMeasurementOperator", "[", 
    RowBox[{"QuantumOperator", "[", "jz3", "]"}], "]"}], "[", 
   RowBox[{"QuantumState", "[", "psi3", "]"}], "]"}]}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"e9b79334-3845-4493-93b8-f5f479ed03eb"],

Cell[TextData[{
 "Its ",
 Cell[BoxData["\"\<Mean\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b3b6962-c4e2-458d-8856-9d8109900571"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36e79749-4e10-445b-94d2-c098aea305f1"],
 ":"
}], "Text",ExpressionUUID->"b0d4bfaf-2f4c-47e0-9b70-a1fcc5326e77"],

Cell[BoxData[
 RowBox[{"meas3", "[", "\"\<Mean\>\"", "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"df84cb7f-4f20-450b-b50f-ecaaf2df2bee"],

Cell[TextData[{
 "and its ",
 Cell[BoxData["\"\<Probabilities\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "795c23b4-e047-4726-88d8-ae7a7cc84521"],
 " are the same outcome-keyed weights as the ",
 Cell[BoxData["AssociationThread"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffa5e85f-2e4c-4972-8e4c-e88ea4855346"],
 " above:"
}], "Text",ExpressionUUID->"4149b1e8-2586-4ca0-a72d-f36e7299cc9b"],

Cell[BoxData[
 RowBox[{"meas3", "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"4d3d624a-65a4-4c22-9f78-4e7784946789"],

Cell[TextData[{
 "Both give outcomes ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", "0", ",", 
   RowBox[{"-", "1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d19fa75c-cb4f-4837-80f8-80e235e1c584"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "1", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "6"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6aa94b3-4aab-4054-88f2-1e60e1c929cf"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["2", "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ef102c9-2058-4c58-b102-08efc191eaa7"],
 " and mean ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "-", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "690bd261-bffd-48cf-afbb-5d9188118379"],
 ", all in exact arithmetic: the qubit machinery is dimension-agnostic, only \
the number of outcomes grows."
}], "Text",ExpressionUUID->"015d8084-d54d-4036-8e8d-4d841102933d"],

Cell["\<\
5.2 [BSc] How do I measure in a non-computational basis and get the \
post-measurement (collapsed) states?\
\>", "Subsection",ExpressionUUID->"21e6a516-888f-4a62-a2dc-504e839b076a"],

Cell[TextData[{
 "Measuring an observable whose eigenbasis is not the computational one is a \
change of basis: express the state in that eigenbasis, and the new amplitudes \
give the outcome probabilities by the Born rule, while the measurement \
collapses the qubit onto one of the eigenstates. We measure ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0a04c8e-e7fb-4fa1-9ece-dea7af6bd67f"],
 ", with eigenstates ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"\[PlusMinus]"},
    "Ket"], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{"0"},
       "Ket"], "\[PlusMinus]", 
      TemplateBox[{"1"},
       "Ket"]}], ")"}], "/", 
    SqrtBox["2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "274d8c81-e050-47b9-b7b7-c8f405be3f1c"],
 ", on a general pure qubit ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eceec56d-f63e-45a8-8c2c-8bd4c3cf5461"],
 ", defined once:"
}], "Text",ExpressionUUID->"bf9f63cb-bcec-481a-890c-e84441d14e05"],

Cell[BoxData[
 RowBox[{
  RowBox[{"psi", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"1a573e00-524b-4582-8045-0f36db71253d"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the outcomes live in the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc58ff67-766d-436f-bdf0-f322e5dd6bb5"],
 " eigenbasis, so build it first (normalized), in eigenvalue order ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "-", "1"}], ",", 
   RowBox[{"+", "1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87540d8d-5dea-4284-9f23-da63c3550170"],
 ":"
}], "Text",ExpressionUUID->"1f4d428e-ba99-4cc1-aa7f-026c07ef019d"],

Cell[BoxData[
 RowBox[{"eigenX", " ", "=", " ", 
  RowBox[{"Normalize", " ", "/@", " ", 
   RowBox[{"Eigenvectors", "[", 
    RowBox[{"PauliMatrix", "[", "1", "]"}], "]"}]}]}]], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"1cd23ca5-ef82-4fca-9ddc-aec325093fac"],

Cell[TextData[{
 "The amplitudes of ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c0632b9-4f49-49cd-b894-f9ac53663f22"],
 " in the new basis are its overlaps with those eigenvectors, ",
 Cell[BoxData[
  TemplateBox[{"\[PlusMinus]", 
    StyleBox["\[Psi]", "TI"]},
   "BraKet"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9cc981f9-2233-4136-9540-3cc22bbced4c"],
 "; name them ",
 Cell[BoxData["amplX"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e65d8f0-451d-4ed4-982d-3926316498ab"],
 ":"
}], "Text",ExpressionUUID->"ff3815fa-60dc-4ad6-9927-77acfb4865bf"],

Cell[BoxData[
 RowBox[{"amplX", " ", "=", " ", 
  RowBox[{"FullSimplify", "@", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "psi"}], " ", 
      "&"}], " ", "/@", " ", "eigenX"}], "]"}]}]}]], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"90afacfc-da9b-4885-b9f7-457a8ff2b1aa"],

Cell[TextData[{
 "Squaring those amplitudes gives the Born probabilities ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{"\[PlusMinus]", 
        StyleBox["\[Psi]", "TI"]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3695976-d3a7-4858-86ff-61c58d3c8ca7"],
 ", the first of two ways to read them here; the QF measurement below is the \
second:"
}], "Text",ExpressionUUID->"8847caff-0369-40c0-b076-161d3e52d616"],

Cell[BoxData[
 RowBox[{"FullSimplify", " ", "/@", " ", 
  RowBox[{"ComplexExpand", "[", 
   RowBox[{
    RowBox[{"Abs", "[", "amplX", "]"}], "^", "2"}], "]"}]}]], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"de253b78-9a8c-4f1b-9de1-975b1cbc30e0"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : applying the ",
 Cell[BoxData["\"\<X\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dc4bdbb-943d-4f7e-9fa1-fc1b3b3e2452"],
 " measurement operator to the state returns a ",
 Cell[BoxData["QuantumMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ca7e271-79d4-448f-bfa0-8a602aa18f99"],
 " object:"
}], "Text",ExpressionUUID->"6b90d0bd-6227-4ffd-9dd0-b78ec7c6fd77"],

Cell[BoxData[
 RowBox[{"measX", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumMeasurementOperator", "[", "\"\<X\>\"", "]"}], "[", 
   RowBox[{"QuantumState", "[", "psi", "]"}], "]"}]}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"62881da4-ac94-46c5-84c8-dd432e1bf893"],

Cell[TextData[{
 "Its ",
 Cell[BoxData["\"\<Probabilities\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd85ff8c-f506-477a-afa6-95f19057fbc9"],
 " are exactly those squared amplitudes, an association keyed by each ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2c51afd-8752-46a1-ab0c-7a221fa98e9a"],
 " outcome ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["x", "TI"], "\[PlusMinus]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe472ad6-b946-43ec-bddf-bed27a6319fd"],
 " so the pairing needs no ordering convention:"
}], "Text",ExpressionUUID->"0c732b7a-c08c-4b4f-993a-0af1df0a5a16"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", 
      " ", "Reals"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
  RowBox[{"measX", "[", "\"\<Probabilities\>\"", "]"}]}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"018195f1-ad43-49ad-95d0-3a3d69aeca15"],

Cell[TextData[{
 "Both give the outcome probabilities ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"], 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["X", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86d24f0c-8429-4822-aa56-edb95f115f4b"],
 " (the WL list in eigenvalue order ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "-", "1"}], ",", 
   RowBox[{"+", "1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c3feb22-ae8a-4286-8ef4-caab8fab7033"],
 ", the QF association labeling each outcome ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["x", "TI"], "\[PlusMinus]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c0f6a55-17c5-4d90-93b5-6ba4cbeeeb72"],
 "), and the measurement leaves the qubit in ",
 Cell[BoxData[
  TemplateBox[{"\[PlusMinus]"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bcb1b34e-f6ac-4367-a76a-872f34b90f49"],
 ". Unlike a ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80ea4f83-b2f1-4c40-9958-19bf863a07f4"],
 " measurement (5.1), the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d9ffbf6-4f79-4913-97d6-38da847c788b"],
 " outcome depends on the relative phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebcb4e32-4483-488d-b9a2-605278555c28"],
 " through ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28559199-c845-485e-87c2-553860a57977"],
 ", so a real state would hide it: the choice of measurement basis decides \
which feature of the state becomes visible."
}], "Text",ExpressionUUID->"f4799557-87c9-4be7-a4e0-d3eac1b1d1ce"],

Cell[TextData[{
 "The change of basis works in any dimension. For a qutrit, measure in the \
Fourier basis, the qudit generalization of the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6f486d9-ca9d-431e-b833-0bcc29c721f9"],
 " basis, whose amplitudes are the discrete Fourier transform of the state:"
}], "Text",ExpressionUUID->"95f2b445-c8c2-469d-a6a0-6a445627d0b7"],

Cell[BoxData[
 RowBox[{"psi3", " ", "=", " ", 
  RowBox[{"Normalize", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", 
     RowBox[{"1", " ", "+", " ", "I"}], ",", " ", "1"}], "}"}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"b1db13a2-9e7c-43e1-b90e-c233a8a34cfd"],

Cell[TextData[{
 "WL: apply the ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fbafa227-e059-4393-afc8-60fbb26f612d"],
 " discrete Fourier transform to get the amplitudes,"
}], "Text",ExpressionUUID->"5a96ceac-084e-406e-97db-030384859586"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FourierMatrix", "[", "3", "]"}], " ", ".", " ", "psi3"}], " ", "//",
   " ", "FullSimplify"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"79145b26-cb27-4ada-b518-e8d400dfc745"],

Cell["and square them for the Born probabilities:", "Text",ExpressionUUID->"1480d47b-8ff0-49b9-9950-f529289640cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"FourierMatrix", "[", "3", "]"}], " ", ".", " ", "psi3"}], "]"}],
    "^", "2"}], " ", "//", " ", "FullSimplify"}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"d7c3a232-199e-433e-9b94-1f933884f919"],

Cell[TextData[{
 "QF: that Fourier basis is exactly the named ",
 Cell[BoxData[
  RowBox[{"\"\<X\>\"", "[", "3", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65cb70da-63b6-440e-9e43-c670b10a4a2d"],
 ", the qudit-",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4677fd3-315c-465f-8bd5-2a85bb0186f2"],
 " generalization of the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "784aa9cf-ff3f-45f0-8b64-6972f7e93a8c"],
 " basis, so re-expressing the qutrit in it needs no explicit matrix; its ",
 Cell[BoxData["\"\<StateVector\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed32c76e-359a-4869-927f-65674a5760eb"],
 " reproduces those amplitudes:"
}], "Text",ExpressionUUID->"f856db2c-0eac-4b10-8b24-5d563efe34ce"],

Cell[BoxData[
 RowBox[{"FullSimplify", " ", "/@", " ", 
  RowBox[{"Normal", "@", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{
      RowBox[{"QuantumState", "[", "psi3", "]"}], ",", " ", 
      RowBox[{"\"\<X\>\"", "[", "3", "]"}]}], "]"}], 
    "[", "\"\<StateVector\>\"", "]"}]}]}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"116a4711-3b0e-47fd-8e3f-3e64bda0d433"],

Cell[TextData[{
 "and its ",
 Cell[BoxData["\"\<Probabilities\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be6eb93e-68a7-4652-bd0b-fbc96eabb137"],
 " are the same weights, keyed by outcome:"
}], "Text",ExpressionUUID->"787252fc-3669-45a1-bc82-a4f555764b41"],

Cell[BoxData[
 RowBox[{"FullSimplify", " ", "/@", " ", 
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", "psi3", "]"}], ",", " ", 
     RowBox[{"\"\<X\>\"", "[", "3", "]"}]}], "]"}], 
   "[", "\"\<Probabilities\>\"", "]"}]}]], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"c41e6298-5ff4-4431-b7e4-1e52425b6d78"],

Cell[TextData[{
 "Both give the Fourier-basis probabilities ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    FractionBox["5", "6"]}], ",", 
   FractionBox["1", "12"], ",", 
   RowBox[{
    FractionBox["1", "12"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bec68171-8274-4353-b8ef-a5be27b4766a"],
 ", now exact: the change-of-basis measurement is the identical construction \
at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f10c14e-d7e3-45fb-9f8b-53afe6359af3"],
 ", with the ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9469ba9b-f3a6-4f75-89e7-e203ef770f0a"],
 " discrete Fourier transform playing the role the ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71892162-11c9-48ee-9309-fd5eb7ff8c3b"],
 " Hadamard played for the qubit."
}], "Text",ExpressionUUID->"800e5fc2-dfde-432b-8711-9f3c385dd710"],

Cell["\<\
5.3 [BSc] How do I simulate finite-shot statistics and watch the empirical \
frequencies approach the Born rule?\
\>", "Subsection",ExpressionUUID->"8b55c353-4521-4a44-a758-3063337dfe69"],

Cell[TextData[{
 "Real measurements return a finite sample of outcomes whose frequencies \
converge to the Born probabilities as the shot count grows. This is the one \
place the two answers do not agree cell-for-cell: each draws its own random \
sample, and what they share is the limit. Measure ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7635278-56ee-41ee-a0bb-27a9c8cb1e01"],
 " on the state ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    FractionBox[
     SqrtBox["3"], "2"]}], ",", 
   RowBox[{
    FractionBox["1", "2"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5a163bc-4c2c-4de4-8f5e-50636994f377"],
 ", whose Born probabilities are the unequal ",
 Cell[BoxData[
  RowBox[{
   FractionBox["3", "4"], ",", 
   FractionBox["1", "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bb1d7db-e31d-4149-bdb9-06ce18154b09"],
 "."
}], "Text",ExpressionUUID->"1a47e87d-6d94-489b-937f-569cb9515284"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : draw ",
 Cell[BoxData["2000"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80a90556-7bcf-4490-9367-c01339fed0f8"],
 " outcomes with the Born weights and tabulate their frequencies."
}], "Text",ExpressionUUID->"c6a1f25e-b2a4-404d-b08d-4932d38893f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{"Counts", "[", 
     RowBox[{"RandomChoice", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"3", "/", "4"}], ",", " ", 
          RowBox[{"1", "/", "4"}]}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}]}], ",", " ", "2000"}], "]"}], "]"}], "/",
     "2000"}], "]"}]}]], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"df504b1c-5332-475c-ba61-71a87e7189e3"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : ",
 Cell[BoxData["\"\<SimulatedMeasurement\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c875d632-53db-4cf0-8ef1-43810d28eae5"],
 " draws the same-size sample of outcomes; ",
 Cell[BoxData["Counts"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f562ceb3-a552-4873-9634-ecd42568ad81"],
 " tabulates it and dividing by the shot count gives the empirical \
frequencies, keyed by outcome."
}], "Text",ExpressionUUID->"971e3e55-ac97-42fa-afd4-3075497f5ddb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Counts", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"QuantumMeasurementOperator", "[", "\"\<Z\>\"", "]"}], "[", 
       RowBox[{"QuantumState", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}], ",", " ", 
          RowBox[{"1", "/", "2"}]}], "}"}], "]"}], "]"}], "[", 
      RowBox[{"\"\<SimulatedMeasurement\>\"", ",", " ", "2000"}], "]"}], 
     "]"}], "/", "2000"}], " ", "//", " ", "N"}]}]], "Input",
 CellLabel->
  "In[27]:= ",ExpressionUUID->"02cb0337-abe4-4a84-86b8-f44043576b70"],

Cell[TextData[{
 "Both cluster near the Born prediction, frequencies ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[TildeTilde]", "{", "0.75"}], ",", 
   RowBox[{"0.25", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f3995e2-0abd-43a5-87fb-bc88ee0b5662"],
 ": the two samples differ in their individual draws but each approaches ",
 Cell[BoxData[
  RowBox[{
   FractionBox["3", "4"], ",", 
   FractionBox["1", "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2ed4718-6b9e-49a3-af1c-5f99e2ef0f36"],
 ", and the gap shrinks like ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1521d5c1-4ee9-4a02-88a3-c0c5de6adf55"],
 ". The unequal weights make the convergence discriminating, the frequencies \
track two distinct probabilities rather than a symmetric coin flip. The Born \
rule is the large-sample limit of the measured frequencies."
}], "Text",ExpressionUUID->"5421c3fe-5046-46fd-92f3-023536b31eeb"],

Cell["\<\
5.4 [BSc] How do I apply a non-selective projective measurement (the L\
\[UDoubleDot]ders channel)?\
\>", "Subsection",ExpressionUUID->"0f6bd84c-afda-443f-8383-76944a953a0e"],

Cell[TextData[{
 "A non-selective measurement records that a measurement happened but not \
which outcome, replacing ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10001caf-a758-4212-94f6-fb27fe96a843"],
 " by ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["k", "TI"]], " ", 
   StyleBox["\[Rho]", "TI"], " ", 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b7c73c2-9714-462e-beb3-c410fa16e9af"],
 " (the L\[UDoubleDot]ders channel). For a ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00a04521-7639-46a0-aeb6-b7fda5586ed0"],
 " measurement this erases the off-diagonal coherences and leaves the \
diagonal: pure dephasing. Apply it to a general qubit state in Bloch form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10e51f3e-2597-479a-b7ea-b0742e20aadf"],
 " (pure or mixed; ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "="}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dea9497-3180-4181-bd3d-f48880d2a8e8"],
 " ",
 Cell[BoxData[
  RowBox[{"PauliMatrix", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53aff0d7-9a7a-4c4f-a0da-0303b722e370"],
 "); define it once:"
}], "Text",ExpressionUUID->"a942a114-083d-4e23-8faf-aff675686453"],

Cell[BoxData[
 RowBox[{"rho", " ", "=", " ", 
  RowBox[{
   RowBox[{"1", "/", "2"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rx", ",", " ", "ry", ",", " ", "rz"}], "}"}], " ", ".", " ", 
      RowBox[{"PauliMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
    ")"}]}]}]], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"872deb41-9d32-4e05-aca9-7eb0d79c9723"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : sandwich ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc59de51-d500-4c4b-b4ca-161d526f7751"],
 " between the two ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6cf730d-5cba-438e-a465-1d3fcc14d491"],
 " projectors and sum."
}], "Text",ExpressionUUID->"4a5649a9-6b2e-4e86-ab2d-0ce7710bc2ef"],

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"p", " ", ".", " ", "rho", " ", ".", " ", "p"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[29]:= ",ExpressionUUID->"b37f51f4-11fd-4f51-aefe-a8995785cf1f"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the measurement's ",
 Cell[BoxData["\"\<PostMeasurementState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9df64f7d-438e-498a-a4b0-cfe59e22fe16"],
 " is that non-selective mixture, as a state object."
}], "Text",ExpressionUUID->"dc84bdc2-8ec4-43b3-8c43-a3ea381ee4ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumMeasurementOperator", "[", "\"\<Z\>\"", "]"}], "[", 
   RowBox[{"QuantumState", "[", "rho", "]"}], "]"}], 
  "[", "\"\<PostMeasurementState\>\"", "]"}]], "Input",
 CellLabel->
  "In[30]:= ",ExpressionUUID->"1ac59ca1-1ac3-4556-b1dc-d1ff11ba2dc1"],

Cell["\<\
Reading its density matrix off that state object gives the same diagonal the \
WL sandwich produced:\
\>", "Text",ExpressionUUID->"802379cf-d540-4b31-aed4-dc555740395e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"%", "[", "\"\<DensityMatrix\>\"", "]"}], " ", "//", " ", 
   "Normal"}], " ", "//", " ", "FullSimplify"}]], "Input",
 CellLabel->
  "In[31]:= ",ExpressionUUID->"680c747a-ce05-4c2a-a84f-bffa6370a328"],

Cell[TextData[{
 "Both give ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["diag",
     FontSlant->"Plain"], 
    StyleBox["(",
     FontSize->1.2 Inherited], 
    FractionBox[
     RowBox[{"1", "+", 
      SubscriptBox[
       StyleBox["r", "TI"], 
       StyleBox["z", "TI"]]}], "2"]}], ",", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      SubscriptBox[
       StyleBox["r", "TI"], 
       StyleBox["z", "TI"]]}], "2"], 
    StyleBox[")",
     FontSize->1.2 Inherited]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "602fc832-2bdc-46db-92fc-aebcb26c7ac6"],
 ": the coherences ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["x", "TI"]], ",", 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2694edc4-b623-4950-80ff-961bc5fc7ad3"],
 " are erased while the populations ",
 Cell[BoxData[
  FractionBox[
   RowBox[{"1", "\[PlusMinus]", 
    SubscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["z", "TI"]]}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee36842b-a9aa-483a-bfbf-ec81b5761b0d"],
 " are untouched, for any state, pure or mixed. This is decoherence in the \
measured basis, the same map a dephasing environment applies, and it is what \
separates a measurement that is ",
 StyleBox["read", "TI"],
 " from one that is merely coupled."
}], "Text",ExpressionUUID->"2c34c884-dd13-46ea-b3d1-8d900175981a"]
},
CreateCellID->True,
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (February 17, 2026)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"e87e7e57-c2b7-473f-8985-5c8d8593a5f8"
]
