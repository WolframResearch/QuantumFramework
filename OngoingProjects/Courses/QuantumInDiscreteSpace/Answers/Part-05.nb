(* Beginning of Notebook Content *)
Notebook[{
Cell["Part 5. Projective measurement", "Section",
 CellID->874461601,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell["\<\
5.1 [BSc] How do I perform a projective measurement and read outcomes, \
probabilities, and the mean?\
\>", "Subsection",
 CellID->36768919,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell[TextData[{
 "A projective measurement of an observable ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 " returns one of ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75d93363-5da6-51a4-23e6-ab4d5453238e"],
 "'s eigenvalues ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a568a6-87a2-527f-535a-810032572145"],
 " (the outcome) with probability ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["Tr",
     FontSlant->"Plain"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["a", "TI"]], 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1]}], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["a", "TI"]},
     "Bra"], 
    StyleBox["\[Rho]", "TI"], 
    TemplateBox[{
      StyleBox["a", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 " (the Born rule, ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["a", "TI"], 
        StyleBox["\[Psi]", "TI"]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 " for a pure state), and the mean is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"A", "\[Rho]"}], "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5902d484-617f-9570-0f31-cdee100bfc5a"],
 ": the eigenvalues are what can be seen and ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e0e12c-de7d-6135-7e9f-f889db08301f"],
 " weights them. Measure ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5708d032-2150-04f2-7d37-ca7c50e56ed8"],
 " on the general mixed qubit, the Bloch state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 " with ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166f8969-5e31-e8e5-3e14-21335bc5bacf"],
 " (",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "="}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "234f1fb7-07c6-bba9-5174-96f1b27009f3"],
 " ",
 Cell[BoxData[
  RowBox[{"PauliMatrix", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
 ")."
}], "Text",
 CellID->1699946459,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : build the state once."
}], "Text",
 CellID->1535504786,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell[BoxData[
 RowBox[{"rho", " ", "=", " ", 
  RowBox[{
   RowBox[{"1", "/", "2"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rx", ",", " ", "ry", ",", " ", "rz"}], "}"}], " ", ".", " ", 
      RowBox[{"PauliMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
    ")"}]}]}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->1208482393,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell[TextData[{
 "The possible outcomes are the eigenvalues of the observable, here in the \
order ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "-", "1"}], ",", 
   RowBox[{"+", "1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e84829b-9667-6594-16bb-1bc523124ffe"],
 "."
}], "Text",
 CellID->28909615,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell[BoxData[
 RowBox[{"Eigenvalues", "[", 
  RowBox[{"PauliMatrix", "[", "3", "]"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->193832008,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

Cell[TextData[{
 "Each outcome's probability is the corresponding eigenvector sandwiched \
around ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "779c57de-bb93-d239-1da4-4e983e27a103"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["a", "TI"]},
    "Bra"], 
   StyleBox["\[Rho]", "TI"], 
   TemplateBox[{
     StyleBox["a", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2867ea9b-6e8d-517b-581c-03c50b382041"],
 ", listed in that same eigenvalue order."
}], "Text",
 CellID->684317082,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell[BoxData[
 RowBox[{"probs", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "rho", " ", ".", 
       " ", "#"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"Eigenvectors", "[", 
      RowBox[{"PauliMatrix", "[", "3", "]"}], "]"}]}], ",", " ", 
    RowBox[{
     RowBox[{"-", "1"}], " ", "<=", " ", "rz", " ", "<=", " ", "1"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->528485616,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[TextData[{
 "The mean is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"Z", "\[Rho]"}], "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 "."
}], "Text",
 CellID->1392207227,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Tr", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", "rho"}], "]"}], ",",
    " ", 
   RowBox[{
    RowBox[{"-", "1"}], " ", "<=", " ", "rz", " ", "<=", " ", "1"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->705466992,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell[TextData[{
 "For a pure state (",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07964fa7-8d1e-ff14-2dae-660124a8c27e"],
 "), substituting the Bloch vector of ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    FractionBox[
     StyleBox["\[Theta]", "TI"], "2"]}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    FractionBox[
     StyleBox["\[Theta]", "TI"], "2"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],
 " returns the familiar half-angle populations and the mean ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbaaaf7-1388-e538-4b59-43b1a622cc02"],
 "."
}], "Text",
 CellID->1350516518,ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"probs", ",", " ", 
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", "rho"}], 
       "]"}]}], "}"}], " ", "/.", " ", 
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rx", ",", " ", "ry", ",", " ", "rz"}], "}"}], " ", "->", " ", 
      
      RowBox[{"FromSphericalCoordinates", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], "}"}], 
       "]"}]}], "]"}]}], ",", " ", 
   RowBox[{"0", " ", "<=", " ", "\[Theta]", " ", "<=", " ", "Pi"}]}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->907546795,ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : applying the measurement operator to the state returns a ",
 Cell[BoxData["QuantumMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbde497-e826-5557-4442-fdd089d33fbd"],
 " object, whose summary box lists the outcomes and their probabilities. \
Build it once from the same Bloch state, using the ",
 Cell[BoxData["\"\<BlochVector\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],
 " constructor."
}], "Text",
 CellID->814772321,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell[BoxData[
 RowBox[{"meas", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumMeasurementOperator", "[", 
    RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "]"}], "[", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<BlochVector\>\"", "[", 
     RowBox[{"{", 
      RowBox[{"rx", ",", " ", "ry", ",", " ", "rz"}], "}"}], "]"}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->1054628905,ExpressionUUID->"1f908cf3-3c70-d55a-45af-25bdb50abfa0"],

Cell[TextData[{
 "Its ",
 Cell[BoxData["\"\<Mean\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 "."
}], "Text",
 CellID->2043779557,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"meas", "[", "\"\<Mean\>\"", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"-", "1"}], " ", "<=", " ", "rz", " ", "<=", " ", "1"}]}], 
  "]"}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->17830494,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell[TextData[{
 "Its ",
 Cell[BoxData["\"\<Probabilities\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35077f55-9291-6519-633d-771f27244c63"],
 " gives the two weights as an association whose keys are the framework's \
outcome labels, each displaying its eigenvalue, so the pairing is carried by \
the key rather than by list position."
}], "Text",
 CellID->1589986527,ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{
      RowBox[{"-", "1"}], " ", "<=", " ", "rz", " ", "<=", " ", "1"}]}], 
    "]"}], " ", "&"}], " ", "/@", " ", 
  RowBox[{"meas", "[", "\"\<Probabilities\>\"", "]"}]}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->943101875,ExpressionUUID->"65de4a87-3471-cd9f-13e6-63e1bd0597e5"],

Cell[TextData[{
 "The two routes agree: the mean matches ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"Z", "\[Rho]"}], "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 ", and pairing each eigenvalue with its probability (",
 Cell[BoxData["\"\<EigenvalueVectors\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 " against ",
 Cell[BoxData["\"\<ProbabilitiesList\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 ") reproduces the WL eigenvalue-to-weight map key for key, not merely as an \
unordered set."
}], "Text",
 CellID->67888809,ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"meas", "[", "\"\<Mean\>\"", "]"}], " ", "==", " ", 
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", "rho"}], 
       "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"-", "1"}], " ", "<=", " ", "rz", " ", "<=", " ", "1"}]}], 
    "]"}], ",", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Values", "[", 
       RowBox[{"KeySort", "[", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"meas", "[", "\"\<EigenvalueVectors\>\"", "]"}], "]"}], ",",
           " ", 
          RowBox[{"meas", "[", "\"\<ProbabilitiesList\>\"", "]"}]}], "]"}], 
        "]"}], "]"}], " ", "==", " ", 
      RowBox[{"Values", "[", 
       RowBox[{"KeySort", "[", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"Eigenvalues", "[", 
           RowBox[{"PauliMatrix", "[", "3", "]"}], "]"}], ",", " ", "probs"}],
          "]"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"-", "1"}], " ", "<=", " ", "rz", " ", "<=", " ", "1"}]}], 
    "]"}]}], "}"}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->1432876021,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],

Cell[TextData[{
 "Both assign ",
 Cell[BoxData[
  RowBox[{"+", "1", "\[Function]", 
   FractionBox[
    RowBox[{"1", "+", 
     SubscriptBox[
      StyleBox["r", "TI"], 
      StyleBox["z", "TI"]]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfe104a-50de-a555-0985-8a1461680fbf"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "1", "\[Function]", 
   FractionBox[
    RowBox[{"1", "-", 
     SubscriptBox[
      StyleBox["r", "TI"], 
      StyleBox["z", "TI"]]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "134534fb-1061-d656-417a-ada5a115bcbc"],
 " and give the mean ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],
 ": a ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1c99a5-dcef-9c28-1623-100ed49be772"],
 " measurement reads only the populations (the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["r", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "608e87cc-8fce-afdf-10b5-1e962a78f525"],
 " component), so the coherences ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["x", "TI"]], ",", 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aa912c6-4938-1bb7-5a56-8ba068cd699d"],
 " drop out, and the mean is the difference of the two outcome probabilities. \
On a pure state the populations collapse to ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["cos",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    FractionBox[
     StyleBox["\[Theta]", "TI"], "2"]}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["sin",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    FractionBox[
     StyleBox["\[Theta]", "TI"], "2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66b4bee0-d247-b105-0e4b-37cde7f3006f"],
 " and the mean to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 "."
}], "Text",
 CellID->876231958,ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],

Cell[TextData[{
 "The same three reads carry to any dimension unchanged. For a qutrit, take \
",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["z", "TI"]], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"1", ",", "0"}], ",", 
    RowBox[{"-", "1"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 " on a concrete normalized state."
}], "Text",
 CellID->1020575516,ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : build ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 " together with its eigensystem: the eigenvalues are the outcomes, the \
(normalized) eigenvectors the outcome states."
}], "Text",
 CellID->1967685850,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell[BoxData[
 RowBox[{
  RowBox[{"jz3", " ", "=", " ", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "0", ",", " ", 
      RowBox[{"-", "1"}]}], "}"}], "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"jzEigenVal", ",", " ", "jzEigenVec"}], "}"}], " ", "=", " ", 
   RowBox[{"MapAt", "[", 
    RowBox[{"Normalize", ",", " ", 
     RowBox[{"Eigensystem", "[", "jz3", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "All"}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->1044562475,ExpressionUUID->"7b6211f5-475c-1194-2911-88bf72e963fe"],

Cell["\<\
The state to measure, chosen with three distinct Born weights so the \
eigenvalue-to-probability pairing has something to test.\
\>", "Text",
 CellID->1653200050,ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

Cell[BoxData[
 RowBox[{"psi3", " ", "=", " ", 
  RowBox[{"Normalize", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", 
     RowBox[{"2", " ", "I"}], ",", " ", "3"}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->1384978530,ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell[TextData[{
 "The Born rule pairs each eigenvalue with the squared overlap ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["a", "TI"], 
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], "3"]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],
 " of its eigenvector; ",
 Cell[BoxData["AssociationThread"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7fe4cc-5889-7f4e-6904-fd96593c4594"],
 " keys those weights by eigenvalue."
}], "Text",
 CellID->519689844,ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

Cell[BoxData[
 RowBox[{"wl3", " ", "=", " ", 
  RowBox[{"AssociationThread", "[", 
   RowBox[{"jzEigenVal", ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "psi3"}], "]"}],
        "^", "2"}], " ", "&"}], " ", "/@", " ", "jzEigenVec"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->1609367578,ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"],

Cell[TextData[{
 "The mean is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], "=", 
   RowBox[{
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], "3"]},
     "Bra"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["z", "TI"]], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], "3"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 "."
}], "Text",
 CellID->1541450781,ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Conjugate", "[", "psi3", "]"}], " ", ".", " ", "jz3", " ", ".", 
  " ", "psi3"}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->1657269721,ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the measurement object carries the same reads; applying it to the state \
returns a ",
 Cell[BoxData["QuantumMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 " whose summary box already lists the three outcomes and their weights."
}], "Text",
 CellID->1140508347,ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],

Cell[BoxData[
 RowBox[{"meas3", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumMeasurementOperator", "[", 
    RowBox[{"QuantumOperator", "[", "jz3", "]"}], "]"}], "[", 
   RowBox[{"QuantumState", "[", "psi3", "]"}], "]"}]}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->496109794,ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

Cell[TextData[{
 "Its ",
 Cell[BoxData["\"\<Mean\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04786d0e-016a-d127-2c07-8568b01ca00d"],
 "."
}], "Text",
 CellID->108435171,ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

Cell[BoxData[
 RowBox[{"meas3", "[", "\"\<Mean\>\"", "]"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->829388421,ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell[TextData[{
 "Its ",
 Cell[BoxData["\"\<Probabilities\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fd1512-f616-8834-3c82-8d5f83a0db1e"],
 ", keyed by outcome label, carry the same weights; the two routes agree on \
the mean and, pairing eigenvalue with probability, on the whole \
eigenvalue-to-weight map."
}], "Text",
 CellID->203008389,ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"meas3", "[", "\"\<Mean\>\"", "]"}], " ", "==", " ", 
    RowBox[{
     RowBox[{"Conjugate", "[", "psi3", "]"}], " ", ".", " ", "jz3", " ", ".", 
     " ", "psi3"}]}], ",", " ", 
   RowBox[{
    RowBox[{"Values", "[", 
     RowBox[{"KeySort", "[", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"meas3", "[", "\"\<EigenvalueVectors\>\"", "]"}], "]"}], ",",
         " ", 
        RowBox[{"meas3", "[", "\"\<ProbabilitiesList\>\"", "]"}]}], "]"}], 
      "]"}], "]"}], " ", "==", " ", 
    RowBox[{"Values", "[", 
     RowBox[{"KeySort", "[", "wl3", "]"}], "]"}]}]}], "}"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->1090263105,ExpressionUUID->"48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],

Cell[TextData[{
 "Both give outcomes ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", "0", ",", 
   RowBox[{"-", "1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58ee7ecb-1370-1005-0896-7795a605636f"],
 " with the three distinct weights ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "14"], ",", 
   FractionBox["2", "7"], ",", 
   FractionBox["9", "14"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],
 " and mean ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "-", 
   FractionBox["4", "7"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],
 ", all in exact arithmetic, and the eigenvalue-to-probability map agrees key \
for key: the qubit machinery is dimension-agnostic, only the number of \
outcomes grows."
}], "Text",
 CellID->1560876240,ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell["\<\
5.2 [BSc] How do I measure in a non-computational basis and get the \
post-measurement (collapsed) states?\
\>", "Subsection",
 CellID->176337227,ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],

Cell[TextData[{
 "Measuring an observable whose eigenbasis is not the computational one is a \
change of basis: express the state in that eigenbasis, and the new amplitudes \
give the outcome probabilities by the Born rule, while the measurement \
collapses the qubit onto the eigenstate of the outcome found. Conditioned on \
outcome ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b45e796-37a7-eecc-197a-fed04253b416"],
 " the update is the L\[UDoubleDot]ders rule, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "\[Function]", 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["a", "TI"]], 
   StyleBox["\[Rho]", "TI"], 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["a", "TI"]], "/", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["a", "TI"]], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["a", "TI"]], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["a", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["a", "TI"]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 "; for a rank-one ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P", "TI"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a9104d-5625-6af3-4356-8a1763d038d9"],
 " the result is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["a", "TI"]},
    "Ket"], 
   TemplateBox[{
     StyleBox["a", "TI"]},
    "Bra"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],
 " itself, whatever the state was, and the rule is undefined only for an \
outcome of probability zero, where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["a", "TI"]], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43821c38-6720-b4f9-71b1-966212da1ec3"],
 ". Measure ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c54d9-3079-6bba-5c24-4d83410c3980"],
 ", with eigenstates ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"\[PlusMinus]"},
    "Ket"], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{"0"},
       "Ket"], "\[PlusMinus]", 
      TemplateBox[{"1"},
       "Ket"]}], ")"}], "/", 
    SqrtBox["2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],
 ", on a general pure qubit ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f449897-1a0e-51e7-357b-11d19fbb23cd"],
 "."
}], "Text",
 CellID->807053435,ExpressionUUID->"6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the state, defined once."
}], "Text",
 CellID->1633675818,ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

Cell[BoxData[
 RowBox[{
  RowBox[{"psi", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[17]:= ",
 CellID->1828793009,ExpressionUUID->"07359582-e823-44a1-2eca-0cef89d62e8b"],

Cell[TextData[{
 "The outcomes live in the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c239bd0-3ff5-3b18-25d0-129ab9818662"],
 " eigenbasis, so build it first (normalized), in eigenvalue order ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "-", "1"}], ",", 
   RowBox[{"+", "1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c76573-72ce-0c1a-18fd-7d3d077b5760"],
 "."
}], "Text",
 CellID->1232986364,ExpressionUUID->"6184d2f2-049e-728e-17bb-cbbcad2b40d4"],

Cell[BoxData[
 RowBox[{"eigenX", " ", "=", " ", 
  RowBox[{"Normalize", " ", "/@", " ", 
   RowBox[{"Eigenvectors", "[", 
    RowBox[{"PauliMatrix", "[", "1", "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[18]:= ",
 CellID->762269937,ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"],

Cell[TextData[{
 "The amplitudes of ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19bb1c5e-57ab-6e36-4f58-9618625e351c"],
 " in the new basis are its overlaps with those eigenvectors, ",
 Cell[BoxData[
  TemplateBox[{"\[PlusMinus]", 
    StyleBox["\[Psi]", "TI"]},
   "BraKet"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],
 "."
}], "Text",
 CellID->405213039,ExpressionUUID->"30baa1c8-66ad-75e0-6059-389213585fca"],

Cell[BoxData[
 RowBox[{"amplX", " ", "=", " ", 
  RowBox[{"FullSimplify", "@", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "psi"}], " ", 
      "&"}], " ", "/@", " ", "eigenX"}], "]"}]}]}]], "Input",
 CellLabel->"In[19]:= ",
 CellID->2118931930,ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"],

Cell[TextData[{
 "Squaring those amplitudes gives the Born probabilities ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{"\[PlusMinus]", 
        StyleBox["\[Psi]", "TI"]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "323a4b1c-b138-a791-63da-6359c0b20dfb"],
 "."
}], "Text",
 CellID->1039057480,ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"],

Cell[BoxData[
 RowBox[{"FullSimplify", " ", "/@", " ", 
  RowBox[{"ComplexExpand", "[", 
   RowBox[{
    RowBox[{"Abs", "[", "amplX", "]"}], "^", "2"}], "]"}]}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->1411198270,ExpressionUUID->"511b3347-8d7d-ab60-0738-ab212409f64a"],

Cell["For the collapse, the state as a density matrix.", "Text",
 CellID->1703453532,ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rhoPsi", " ", "=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{"psi", ",", " ", 
     RowBox[{"Conjugate", "[", "psi", "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->1477609488,ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

Cell["\<\
The L\[UDoubleDot]ders update for each outcome, in the same eigenvalue order, \
returns the two collapsed states as density matrices.\
\>", "Text",
 CellID->1030824397,ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"],

Cell[BoxData[
 RowBox[{"collapsed", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"P", " ", "=", " ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"e", ",", " ", 
            RowBox[{"Conjugate", "[", "e", "]"}]}], "]"}]}], "}"}], ",", " ", 
        
        RowBox[{
         RowBox[{"P", " ", ".", " ", "rhoPsi", " ", ".", " ", "P"}], "/", 
         RowBox[{"Tr", "[", 
          RowBox[{"P", " ", ".", " ", "rhoPsi"}], "]"}]}]}], "]"}], ",", " ", 
      
      RowBox[{"{", 
       RowBox[{"e", ",", " ", "eigenX"}], "}"}]}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", " ",
      "Reals"}]}], "]"}]}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->100031176,ExpressionUUID->"5900aac7-5263-773e-0f3f-43a167165a04"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : applying the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],
 " measurement operator to the state returns a ",
 Cell[BoxData["QuantumMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12d95fcb-3316-2212-42e7-569546a37178"],
 " object."
}], "Text",
 CellID->144223354,ExpressionUUID->"733995c2-f5bf-78ee-22c6-0caffc4a4a34"],

Cell[BoxData[
 RowBox[{"measX", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumMeasurementOperator", "[", 
    RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], "]"}], "[", 
   RowBox[{"QuantumState", "[", "psi", "]"}], "]"}]}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->1443527617,ExpressionUUID->"4f8ab258-7e7f-0723-7589-34027b0a6a09"],

Cell[TextData[{
 "Its ",
 Cell[BoxData["\"\<Probabilities\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b12ee74-9953-131d-1921-003e18e67e67"],
 " are exactly those squared amplitudes, an association keyed by the outcome \
labels, the ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65262d3c-fccc-1dc6-0cdd-c579f579672c"],
 " outcome listed first."
}], "Text",
 CellID->311511756,ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", 
      " ", "Reals"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
  RowBox[{"measX", "[", "\"\<Probabilities\>\"", "]"}]}]], "Input",
 CellLabel->"In[24]:= ",
 CellID->1381425643,ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"],

Cell[TextData[{
 "Its ",
 Cell[BoxData["\"\<StateAssociation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08285353-0e0e-39f8-3828-4b1dabb88bc2"],
 " holds the post-measurement state of each outcome under the same labels, \
here listed with the ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],
 " outcome first; each is sub-normalized, its squared norm being that \
outcome's probability."
}], "Text",
 CellID->377280352,ExpressionUUID->"187adc3d-3961-76c2-4819-d667b8145c28"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"ComplexExpand", "[", 
      RowBox[{
       RowBox[{"#", "[", "\"\<Norm\>\"", "]"}], "^", "2"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", 
      " ", "Reals"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
  RowBox[{"Values", "[", 
   RowBox[{"measX", "[", "\"\<StateAssociation\>\"", "]"}], "]"}]}]], "Input",\

 CellLabel->"In[25]:= ",
 CellID->1717363484,ExpressionUUID->"641c78eb-7f03-7846-0c24-71b57ab64aac"],

Cell["\<\
Normalizing each and reading its density matrix gives the collapsed states.\
\>", "Text",
 CellID->1781880651,ExpressionUUID->"5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],

Cell[BoxData[
 RowBox[{"collapsedQF", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"ComplexExpand", "[", 
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{"#", "[", "\"\<Normalized\>\"", "]"}], 
         "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", 
       " ", "Reals"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
   RowBox[{"Values", "[", 
    RowBox[{"measX", "[", "\"\<StateAssociation\>\"", "]"}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[26]:= ",
 CellID->1536527082,ExpressionUUID->"112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],

Cell[TextData[{
 "Taken in that listed order, ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6121b9de-dddd-aca8-10de-309bd469f6f2"],
 " then ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30209679-023a-ee91-61df-0823b7ccb4fb"],
 ", they are the projectors the L\[UDoubleDot]ders update produced."
}], "Text",
 CellID->1621535814,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell[BoxData[
 RowBox[{"collapsedQF", " ", "==", " ", "collapsed"}]], "Input",
 CellLabel->"In[27]:= ",
 CellID->1193935837,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell[TextData[{
 "At the edge where an outcome is impossible, the update is undefined. \
Measure ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3119d855-3ffd-7401-6726-d21fb9885f6b"],
 " on the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],
 " eigenstate ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],
 ": the ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51fce014-dca1-0630-0783-fa51d5546d1a"],
 " outcome has probability zero, so its L\[UDoubleDot]ders quotient is ",
 Cell[BoxData[
  RowBox[{"0", "/", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657c1c65-980e-511d-1303-964f19bb2067"],
 ", and the framework keeps only the one outcome that can occur."
}], "Text",
 CellID->105329933,ExpressionUUID->"0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumMeasurementOperator", "[", 
    RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], "]"}], "[", 
   RowBox[{"QuantumState", "[", "\"\<Plus\>\"", "]"}], "]"}], 
  "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellLabel->"In[28]:= ",
 CellID->1234416869,ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumMeasurementOperator", "[", 
     RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], "]"}], "[", 
    RowBox[{"QuantumState", "[", "\"\<Plus\>\"", "]"}], "]"}], 
   "[", "\"\<StateAssociation\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[29]:= ",
 CellID->240380995,ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"],

Cell[TextData[{
 "Both give the outcome probabilities ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"], 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["X", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],
 " and, for either outcome, the collapsed state ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"\[PlusMinus]"},
    "Ket"], 
   TemplateBox[{"\[PlusMinus]"},
    "Bra"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370294fd-9e49-2d35-5d31-0da71bfc741f"],
 ", which keeps no memory of ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2845529c-454d-b13b-587b-4bc66cf90001"],
 " or ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7519012f-e657-215b-2326-988893e273a1"],
 " beyond the outcome itself: the pre-measurement state decides only how \
likely each outcome is. On the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "594776df-9e75-d16a-0f7d-6f991b01a3b0"],
 " eigenstate the opposite outcome drops out, one probability going to zero \
and the other to one, which is where the update rule has nothing to \
normalize. Unlike a ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6405505f-4b92-3bd6-0c3b-4a196e24893c"],
 " measurement (5.1), the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6878c7f8-419e-9db5-1807-dea27028e79f"],
 " outcome depends on the relative phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48a3d607-c312-9dd3-7850-c860f6a4e739"],
 " through ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539491e8-328f-8d7b-01ab-08b2473bd441"],
 ", so a real state would hide it: the choice of measurement basis decides \
which feature of the state becomes visible."
}], "Text",
 CellID->1771870337,ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell[TextData[{
 "The change of basis works in any dimension. For a qutrit, measure in the \
Fourier basis, the qudit generalization of the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023f49e2-a747-9723-33c5-60cfd2f3fa09"],
 " basis, whose amplitudes are the discrete Fourier transform of the state. \
Choose a state whose three Fourier weights are all distinct, so the direction \
of the transform is not hidden by a coincidence."
}], "Text",
 CellID->305160771,ExpressionUUID->"21aa1c49-e16c-f406-57a9-9612901edf6c"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the state to measure."
}], "Text",
 CellID->1896945989,ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"],

Cell[BoxData[
 RowBox[{"psi3", " ", "=", " ", 
  RowBox[{"Normalize", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", 
     RowBox[{"2", " ", "+", " ", "I"}], ",", " ", 
     RowBox[{"3", " ", "I"}]}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[30]:= ",
 CellID->653417278,ExpressionUUID->"12f3dbee-abc4-6375-4280-d2cbce714e5f"],

Cell[TextData[{
 "Apply the ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
 " discrete Fourier transform to get the amplitudes in the Fourier basis."
}], "Text",
 CellID->1067269536,ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"],

Cell[BoxData[
 RowBox[{"Simplify", "@", 
  RowBox[{"ComplexExpand", "[", 
   RowBox[{
    RowBox[{"FourierMatrix", "[", "3", "]"}], " ", ".", " ", "psi3"}], 
   "]"}]}]], "Input",
 CellLabel->"In[31]:= ",
 CellID->49659130,ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell["Square them for the Born probabilities.", "Text",
 CellID->464508221,ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"FourierMatrix", "[", "3", "]"}], " ", ".", " ", "psi3"}], "]"}],
    "^", "2"}], "]"}]], "Input",
 CellLabel->"In[32]:= ",
 CellID->1361313038,ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"],

Cell["\<\
The collapse targets are the Fourier basis states, the rank-one projectors \
onto the rows of the transform; the L\[UDoubleDot]ders update sends the \
qutrit onto one of them.\
\>", "Text",
 CellID->1907680634,ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"collapsed3", " ", "=", " ", 
   RowBox[{"RootReduce", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"P", " ", "=", " ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"e", ",", " ", 
            RowBox[{"Conjugate", "[", "e", "]"}]}], "]"}]}], "}"}], ",", " ", 
        
        RowBox[{
         RowBox[{"P", " ", ".", " ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"psi3", ",", " ", 
            RowBox[{"Conjugate", "[", "psi3", "]"}]}], "]"}], " ", ".", " ", 
          "P"}], "/", 
         RowBox[{"Tr", "[", 
          RowBox[{"P", " ", ".", " ", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"psi3", ",", " ", 
             RowBox[{"Conjugate", "[", "psi3", "]"}]}], "]"}]}], "]"}]}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"e", ",", " ", 
        RowBox[{"Conjugate", "[", 
         RowBox[{"FourierMatrix", "[", "3", "]"}], "]"}]}], "}"}]}], "]"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[33]:= ",
 CellID->483148123,ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell["Each is a pure projector: rank one and idempotent.", "Text",
 CellID->1195452142,ExpressionUUID->"2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MatrixRank", "[", "#", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"#", " ", ".", " ", "#"}], " ", "==", " ", "#"}]}], "}"}], " ", 
   "&"}], " ", "/@", " ", "collapsed3"}]], "Input",
 CellLabel->"In[34]:= ",
 CellID->1521685512,ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : that Fourier basis is exactly the named ",
 Cell[BoxData[
  RowBox[{"\"\<X\>\"", "[", "3", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52243646-2fbd-210e-03db-a8204a487054"],
 ", the qudit-",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1acd7f4d-3da3-7753-4af3-7717b4565db9"],
 " generalization of the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "062d91f0-6326-41c0-2fd2-08ba16d3132a"],
 " basis, so re-expressing the qutrit in it needs no explicit matrix; its ",
 Cell[BoxData["\"\<StateVector\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],
 " reproduces those amplitudes."
}], "Text",
 CellID->97201263,ExpressionUUID->"6f6ad260-8ee1-565a-1569-d44a2a943ca0"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"RootReduce", "[", 
    RowBox[{"Normal", "@", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{
        RowBox[{"QuantumState", "[", "psi3", "]"}], ",", " ", 
        RowBox[{"\"\<X\>\"", "[", "3", "]"}]}], "]"}], 
      "[", "\"\<StateVector\>\"", "]"}]}], "]"}], " ", "==", " ", 
   RowBox[{"RootReduce", "[", 
    RowBox[{
     RowBox[{"FourierMatrix", "[", "3", "]"}], " ", ".", " ", "psi3"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[35]:= ",
 CellID->878831761,ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell[TextData[{
 "Measuring the shift operator ",
 Cell[BoxData[
  RowBox[{"\"\<X\>\"", "[", "3", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],
 " (whose eigenbasis is the Fourier basis) returns the measurement object; \
its ",
 Cell[BoxData["\"\<Probabilities\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],
 " are the same weights."
}], "Text",
 CellID->1048559713,ExpressionUUID->"6b853673-18d0-d9fa-19ba-a83d996aabc0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"measF", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumMeasurementOperator", "[", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<X\>\"", "[", "3", "]"}], "]"}], "]"}], "[", 
    RowBox[{"QuantumState", "[", "psi3", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"RootReduce", " ", "/@", " ", 
  RowBox[{"measF", "[", "\"\<Probabilities\>\"", "]"}]}]}], "Input",
 CellLabel->"In[36]:= ",
 CellID->300048012,ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"],

Cell["\<\
Its post-measurement states, normalized, are the Fourier-basis projectors: \
the same set the L\[UDoubleDot]ders update produced.\
\>", "Text",
 CellID->1962937852,ExpressionUUID->"574a2197-51ef-7938-7d49-b8d1679a4802"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"RootReduce", "[", 
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{"#", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "/", 
       RowBox[{
        RowBox[{"#", "[", "\"\<Norm\>\"", "]"}], "^", "2"}]}], "]"}], " ", 
     "&"}], " ", "/@", " ", 
    RowBox[{"Values", "[", 
     RowBox[{"measF", "[", "\"\<StateAssociation\>\"", "]"}], "]"}]}], "]"}], 
  " ", "==", " ", 
  RowBox[{"Sort", "[", "collapsed3", "]"}]}]], "Input",
 CellLabel->"In[37]:= ",
 CellID->588230824,ExpressionUUID->"6e85e9ed-427b-8528-16ba-00b7770fec72"],

Cell[TextData[{
 "Both give the Fourier-basis probabilities ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    FractionBox["5", "9"]}], ",", 
   FractionBox[
    RowBox[{"2", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"5", "-", "2", 
      SqrtBox["3"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "45"], ",", 
   RowBox[{
    FractionBox[
     RowBox[{"2", 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"5", "+", "2", 
       SqrtBox["3"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "45"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73b76025-96bb-3fff-214d-798f234f85c5"],
 ", exact and all distinct, and collapse the qutrit onto a Fourier basis \
state: the change-of-basis measurement is the identical construction at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31f4c073-8ff6-126f-678b-da3d298360b5"],
 ", with the ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ff7667-e560-b2c0-2285-68408c1a002a"],
 " discrete Fourier transform playing the role the ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c9be80e-0554-61c1-24b8-0268ace1332b"],
 " Hadamard played for the qubit. The distinct weights are what make the \
transform's direction testable, since the inverse transform would return the \
last two weights swapped."
}], "Text",
 CellID->2099309037,ExpressionUUID->"106b7ad8-6378-599b-4069-7382160d2be1"],

Cell["\<\
5.3 [BSc] How do I simulate finite-shot statistics and watch the empirical \
frequencies approach the Born rule?\
\>", "Subsection",
 CellID->512383039,ExpressionUUID->"7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],

Cell[TextData[{
 "Real measurements return a finite sample of outcomes whose frequencies \
converge to the Born probabilities as the shot count grows. This is the one \
place the two answers do not agree cell-for-cell: each draws its own random \
sample, and what they share is the limit. Measure ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "304452a4-201b-d64c-607c-4b0e51afbc96"],
 " on the state ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    FractionBox[
     SqrtBox["3"], "2"]}], ",", 
   RowBox[{
    FractionBox["1", "2"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],
 ", whose Born probabilities are the unequal ",
 Cell[BoxData[
  RowBox[{
   FractionBox["3", "4"], ",", 
   FractionBox["1", "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b5b9263-9199-4e16-7978-144d202c157c"],
 " computed from the amplitudes rather than typed in."
}], "Text",
 CellID->273308241,ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : draw ",
 Cell[BoxData["2000"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],
 " outcomes weighted by the Born probabilities ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{
        StyleBox["a", "TI"], 
        StyleBox["\[Psi]", "TI"]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3343f580-98d5-e31c-6170-ecea1961ce66"],
 " and tabulate their frequencies, keyed in sorted order."
}], "Text",
 CellID->1809098798,ExpressionUUID->"20a7420b-376a-b23f-505d-6455421c0105"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{"KeySort", "[", 
     RowBox[{"Counts", "[", 
      RowBox[{"RandomChoice", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}], ",", " ", 
             RowBox[{"1", "/", "2"}]}], "}"}], "]"}], "^", "2"}], " ", "->", 
         " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}]}], ",", " ", "2000"}], "]"}], "]"}], 
     "]"}], "/", "2000"}], "]"}]}]], "Input",
 CellLabel->"In[38]:= ",
 CellID->156430199,ExpressionUUID->"6af863a9-1098-c609-1a98-7af3a112ad53"],

Cell[TextData[{
 "The sampling error shrinks like ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "055bc2ad-6b92-a3be-3378-dbf70e24f184"],
 ": averaged over ",
 Cell[BoxData["100"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0fb60e-2211-365f-5934-286857a59ca5"],
 " runs at each shot count, the mean absolute deviation of the ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "201a2509-bdd9-2fa1-5039-bd53346c758b"],
 " frequency, scaled by ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["N", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 ", holds near the constant ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    RowBox[{
     StyleBox["p", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["p", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   SqrtBox[
    RowBox[{"2", "/", "\[Pi]"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f932952-49a5-d34f-05a0-c11c6851a195"],
 "."
}], "Text",
 CellID->724760089,ExpressionUUID->"160f17c4-d31a-fe19-3e34-8ea1e6acc563"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
  RowBox[{"N", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "n", "]"}], " ", 
        RowBox[{"Mean", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Count", "[", 
               RowBox[{
                RowBox[{"RandomChoice", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}], ",", " ", 
                    RowBox[{"1", "/", "2"}]}], "}"}], "]"}], "^", "2"}], " ", 
                   "->", " ", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", " ", 
                    RowBox[{"-", "1"}]}], "}"}]}], ",", " ", "n"}], "]"}], ",",
                 " ", "1"}], "]"}], "/", "n"}], " ", "-", " ", 
             RowBox[{"First", "[", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}], ",", " ", 
                  RowBox[{"1", "/", "2"}]}], "}"}], "]"}], "^", "2"}], 
              "]"}]}], "]"}], ",", " ", "100"}], "]"}], "]"}]}]}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"{", 
        RowBox[{"100", ",", " ", "1000", ",", " ", "10000"}], "}"}]}], 
      "}"}]}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[39]:= ",
 CellID->168408080,ExpressionUUID->"10beb8bd-bdb6-ee93-4045-31e73440b4f9"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : ",
 Cell[BoxData["\"\<SimulatedCounts\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fdc991b-fead-14b0-65e3-1144fb587e9a"],
 " draws a same-size sample under its own seed and returns the outcome tally \
directly; dividing by the shot count gives the empirical frequencies."
}], "Text",
 CellID->811283638,ExpressionUUID->"3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"QuantumMeasurementOperator", "[", 
       RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "]"}], "[", 
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}], ",", " ", 
         RowBox[{"1", "/", "2"}]}], "}"}], "]"}], "]"}], "[", 
     RowBox[{"\"\<SimulatedCounts\>\"", ",", " ", "2000"}], "]"}], "/", 
    "2000"}], "]"}]}]], "Input",
 CellLabel->"In[40]:= ",
 CellID->207978548,ExpressionUUID->"0642d375-09f3-9942-2e71-cb3faf87eba8"],

Cell[TextData[{
 "Both cluster near the Born prediction, three quarters for ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0651775d-2bad-791b-2e6f-6f074e584861"],
 " and one quarter for ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63b9e3d6-2298-231e-1146-fa9057128e64"],
 ": the two samples differ in their individual draws but each approaches ",
 Cell[BoxData[
  RowBox[{
   FractionBox["3", "4"], ",", 
   FractionBox["1", "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67c13665-f813-2f11-0dfe-a84ef9a6727b"],
 ", and the scaled deviation staying flat across three decades of ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c440104-ea8a-4285-747b-99618f3f10ef"],
 " is the ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c9a615-af45-c085-0ef6-385ecaf192ef"],
 " law. The unequal weights make the convergence discriminating, the \
frequencies track two distinct probabilities rather than a symmetric coin \
flip. The Born rule is the large-sample limit of the measured frequencies."
}], "Text",
 CellID->437474228,ExpressionUUID->"0513e607-0f4c-1e20-3320-f861aaf9650a"],

Cell["\<\
5.4 [BSc] How do I apply a non-selective projective measurement (the L\
\[UDoubleDot]ders channel)?\
\>", "Subsection",
 CellID->874582697,ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"],

Cell[TextData[{
 "A non-selective measurement records that a measurement happened but not \
which outcome, replacing ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6833ae6a-6ac5-a2c8-19c0-40340f71f012"],
 " by ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7f2999-1aee-25a5-0504-c0c39e988f8f"],
 " (the L\[UDoubleDot]ders channel). For a ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "128c7526-c883-085d-42b4-6c83e9365aa7"],
 " measurement this erases the off-diagonal coherences and leaves the \
diagonal: pure dephasing. Apply it to a general qubit state in Bloch form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3279c00f-c9e2-8758-6206-da68ef94eda2"],
 " (pure or mixed; ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "="}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50b12ff8-e606-85f7-004e-c6a593b0efdd"],
 " ",
 Cell[BoxData[
  RowBox[{"PauliMatrix", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640f47a5-4648-c62d-0c35-5e0f73e2ad77"],
 ")."
}], "Text",
 CellID->11631581,ExpressionUUID->"63a48922-0fac-666c-115b-208caa594cb6"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the state, defined once."
}], "Text",
 CellID->1933762060,ExpressionUUID->"387a9e0d-0234-0e73-6819-1057b7c15559"],

Cell[BoxData[
 RowBox[{"rho", " ", "=", " ", 
  RowBox[{
   RowBox[{"1", "/", "2"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rx", ",", " ", "ry", ",", " ", "rz"}], "}"}], " ", ".", " ", 
      RowBox[{"PauliMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
    ")"}]}]}]], "Input",
 CellLabel->"In[41]:= ",
 CellID->1055776787,ExpressionUUID->"3f64ca0d-9927-5f44-651b-ec5718d225ae"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "399d1ff3-4632-be92-6fa2-96bd73c404f8"],
 " projectors are the outer products of the computational basis, so build \
them from the identity rather than typing them out, then sandwich ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1170384d-2f38-2c50-470f-b2174acd76ba"],
 " between each and sum."
}], "Text",
 CellID->1859711813,ExpressionUUID->"6ce33075-6d34-44a7-1490-aa3f04c12e8d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"proj", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"#", ",", " ", 
       RowBox[{"Conjugate", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@", 
    " ", 
    RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ";"}], "\n", 
 RowBox[{"luders", " ", "=", " ", 
  RowBox[{"Total", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"#", " ", ".", " ", "rho", " ", ".", " ", "#"}], " ", "&"}], " ",
     "/@", " ", "proj"}], "]"}]}]}], "Input",
 CellLabel->"In[42]:= ",
 CellID->1348896709,ExpressionUUID->"54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],

Cell[TextData[{
 "The map is a channel and a projection: it preserves the trace, it is \
idempotent (measuring twice is measuring once), and on the Bloch vector it \
keeps ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["r", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6334ac9c-43f1-85c0-12cb-45c67585ef2a"],
 " and kills ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["x", "TI"]], ",", 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74397683-04f4-1d4d-1dc7-6fedac816797"],
 "."
}], "Text",
 CellID->1427211115,ExpressionUUID->"735e49d5-32a1-4a48-2166-609f47541892"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Tr", "[", "luders", "]"}], " ", "==", " ", "1"}], ",", " ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", " ", ".", " ", "luders", " ", ".", " ", "#"}], " ", "&"}],
       " ", "/@", " ", "proj"}], "]"}], " ", "==", " ", "luders"}], ",", " ", 
   
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"luders", " ", ".", " ", "#"}], "]"}], " ", "&"}], " ", "/@", 
     " ", 
     RowBox[{"PauliMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[43]:= ",
 CellID->2099805207,ExpressionUUID->"335d55a2-cf9b-493d-6163-4c0fea2e1807"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the measurement's ",
 Cell[BoxData["\"\<PostMeasurementState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bfbbd45-edb8-1b0b-6998-352e844d6651"],
 " is that non-selective mixture, as a state object."
}], "Text",
 CellID->1402006442,ExpressionUUID->"045023ab-c37d-b770-2c6f-baf4f6091a5a"],

Cell[BoxData[
 RowBox[{"post", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumMeasurementOperator", "[", "\"\<Z\>\"", "]"}], "[", 
    RowBox[{"QuantumState", "[", "rho", "]"}], "]"}], 
   "[", "\"\<PostMeasurementState\>\"", "]"}]}]], "Input",
 CellLabel->"In[44]:= ",
 CellID->1901179466,ExpressionUUID->"73e8aeff-5b91-f8f4-2197-47b95e25cade"],

Cell["\<\
Reading its density matrix off that state object gives the same diagonal the \
WL sandwich produced.\
\>", "Text",
 CellID->210724908,ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"post", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], " ", "==", 
   " ", "luders"}], "]"}]], "Input",
 CellLabel->"In[45]:= ",
 CellID->1992790374,ExpressionUUID->"794a4309-908b-2549-2f4a-5b53213f8f93"],

Cell[TextData[{
 "Both give ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["diag",
     FontSlant->"Plain"], 
    StyleBox["(",
     FontSize->1.2 Inherited], 
    FractionBox[
     RowBox[{"1", "+", 
      SubscriptBox[
       StyleBox["r", "TI"], 
       StyleBox["z", "TI"]]}], "2"]}], ",", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      SubscriptBox[
       StyleBox["r", "TI"], 
       StyleBox["z", "TI"]]}], "2"], 
    StyleBox[")",
     FontSize->1.2 Inherited]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],
 ", with Bloch vector ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"0", ",", "0"}], ",", 
    SubscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["z", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15eb24b6-b946-3a65-43e8-bdf038f0894f"],
 ": the coherences ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["x", "TI"]], ",", 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27d2a24c-1e84-19ee-4de1-44169b316b34"],
 " are erased while the populations ",
 Cell[BoxData[
  FractionBox[
   RowBox[{"1", "\[PlusMinus]", 
    SubscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["z", "TI"]]}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "285985c7-a1c8-13eb-5866-1ca0d07d6131"],
 " are untouched, for any state, pure or mixed, and applying the channel \
again changes nothing. This is decoherence in the measured basis, the same \
map a dephasing environment applies, and it is what separates a measurement \
that is ",
 StyleBox["read", "TI"],
 " from one that is merely coupled."
}], "Text",
 CellID->292747604,ExpressionUUID->"57868ed1-450c-c474-7dbd-279b6cbeaf5e"]
},
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (February 17, 2026)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"0c5e608e-35dc-f74f-3466-79e8bc6edd95"
]
