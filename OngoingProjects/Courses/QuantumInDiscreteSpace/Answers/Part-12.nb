Cell[TextData[{
 "The choice of ancilla basis was free, so a unitary acting on ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ba931ed3-d710-444e-aea9-535d1a49d557"],
 " alone sends one purification to another with the same reduced state:"
}], "Text",
 CellChangeTimes->{{3.9949634303964863`*^9, 
  3.994963441371807*^9}},ExpressionUUID->"42c8203d-293e-a446-a18e-\
83cbcadce29a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"v", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[FormalA]", "/", "2"}], "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "\[FormalB]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"\[FormalA]", "/", "2"}], "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "\[FormalC]"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[FormalA]", "/", "2"}], "]"}]}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "\[FormalC]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[FormalA]", "/", "2"}], "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "\[FormalB]"}], "]"}]}]}], "}"}]}], 
    "}"}]}], ";", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "v", "]"}], ".", "v"}], "==", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
      RowBox[{
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"ArrayReshape", "[", 
         RowBox[{
          RowBox[{"TensorContract", "[", 
           RowBox[{
            RowBox[{"ArrayReshape", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"KroneckerProduct", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"Conjugate", "[", "#", "]"}]}], "]"}], "&"}], "@", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"KroneckerProduct", "[", 
                  RowBox[{
                   RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", "v"}], 
                  "]"}], ".", "psi"}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "2"}], "}"}]}], "]"}], "]"}], "==", "rho"}]}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"0", "<=", "\[FormalR]", "<=", "1"}], "&&", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[FormalTheta]", ",", "\[FormalPhi]", ",", "\[FormalA]", ",", 
         "\[FormalB]", ",", "\[FormalC]"}], "}"}], ",", "Reals"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.994963402922676*^9, 3.994963402922676*^9}},
 CellLabel->
  "In[247]:=",ExpressionUUID->"662707d3-d3e5-de42-9972-92c3506e6b4c"],

