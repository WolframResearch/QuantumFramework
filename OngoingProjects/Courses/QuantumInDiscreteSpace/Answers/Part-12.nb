Cell[BoxData[
 RowBox[{"perrTheoryQF", " ", "=", 
  RowBox[{"Dot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1", ",", 
      RowBox[{"1", "-", "p1"}]}], "}"}], ",", 
    RowBox[{"Extract", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"qmo", "[", "#", "]"}], "[", "\"\<ProbabilitiesList\>\"", 
          "]"}], "&"}], "/@", 
        RowBox[{"{", 
         RowBox[{"qs1", ",", "qs2"}], "}"}]}], ")"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}]}], "}"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9953897618798885`*^9, 3.9953898096152096`*^9}, {
