 CellLabel->
  "Out[146]=",ExpressionUUID->"95c027f4-9b1b-9640-b976-430741588155"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9951282637393894`*^9, 
  3.9951282650916824`*^9}},ExpressionUUID->"d4df49b9-529b-7446-8963-\
fafd4dc485a5"],

Cell["\<\
 Stacking the ensemble members against orthonormal ancilla kets is exactly \
the purification of Part 12.2, so an observer holding the ancilla can choose \
which ensemble the system is in, by choosing what to measure:\
\>", "Text",
 CellChangeTimes->{{3.995129498309883*^9, 
  3.9951295131848965`*^9}},ExpressionUUID->"6948073b-3d5d-5447-94f1-\
530b423209e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"qpsi", "=", 
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{"Flatten", "@", "ens"}], "]"}], "[", "\"\<Reverse\>\"", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9951282812173653`*^9, 3.995128281958433*^9}, 
   3.995129233026928*^9},
 CellLabel->
  "In[160]:=",ExpressionUUID->"c9e7ef09-8b59-2c4c-933a-dc61d63a8bfb"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   TooltipBox[
    StyleBox[
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         SqrtBox[
          RowBox[{"\[FormalR]", "+", "1"}]], " ", 
         RowBox[{"cos", "(", 
          FractionBox["\[FormalTheta]", "2"], ")"}]}], 
        SqrtBox["2"]], 
       FormBox[
        InterpretationBox[
         StyleBox[
          TemplateBox[{
            RowBox[{
              FormBox["0", TraditionalForm], "\[InvisibleSpace]", 
              FormBox["0", TraditionalForm]}]},
           "Ket"],
          FontWeight->"Plain"],
         Wolfram`QuantumFramework`QuditName[{0, 0}, "Dual" -> False]],
        TraditionalForm], 
       RowBox[{"-", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "\[FormalPhi]"}]], " ", 
          SqrtBox[
           RowBox[{"1", "-", "\[FormalR]"}]], " ", 
          RowBox[{"sin", "(", 
           FractionBox["\[FormalTheta]", "2"], ")"}]}], 
         SqrtBox["2"]]}], 
       FormBox[
        InterpretationBox[
         StyleBox[
          TemplateBox[{
            RowBox[{
              FormBox["0", TraditionalForm], "\[InvisibleSpace]", 
              FormBox["1", TraditionalForm]}]},
           "Ket"],
          FontWeight->"Plain"],
         Wolfram`QuantumFramework`QuditName[{0, 1}, "Dual" -> False]],
        TraditionalForm]}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", "\[FormalPhi]"}]], " ", 
         SqrtBox[
          RowBox[{"\[FormalR]", "+", "1"}]], " ", 
         RowBox[{"sin", "(", 
          FractionBox["\[FormalTheta]", "2"], ")"}]}], 
        SqrtBox["2"]], 
       FormBox[
        InterpretationBox[
         StyleBox[
          TemplateBox[{
            RowBox[{
              FormBox["1", TraditionalForm], "\[InvisibleSpace]", 
              FormBox["0", TraditionalForm]}]},
           "Ket"],
          FontWeight->"Plain"],
         Wolfram`QuantumFramework`QuditName[{1, 0}, "Dual" -> False]],
        TraditionalForm]}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{
         SqrtBox[
          RowBox[{"1", "-", "\[FormalR]"}]], " ", 
         RowBox[{"cos", "(", 
          FractionBox["\[FormalTheta]", "2"], ")"}]}], 
        SqrtBox["2"]], 
       FormBox[
        InterpretationBox[
         StyleBox[
          TemplateBox[{
            RowBox[{
              FormBox["1", TraditionalForm], "\[InvisibleSpace]", 
              FormBox["1", TraditionalForm]}]},
           "Ket"],
          FontWeight->"Plain"],
         Wolfram`QuantumFramework`QuditName[{1, 1}, "Dual" -> False]],
        TraditionalForm]}]}],
     ShowStringCharacters->False],
    TagBox[
     GridBox[{{"None"}, {
        TemplateBox[{"\"QuantumState: \"", 
          RowBox[{
            RowBox[{"{", "}"}], "\[Rule]", 
            RowBox[{"{", 
              RowBox[{"2", ",", "2"}], "}"}]}]}, "RowDefault"]}}, 
      GridBoxAlignment -> {"Columns" -> {{Center}}}, DefaultBaseStyle -> 
      "Column", 
      GridBoxItemSize -> {
       "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"]],
   Wolfram`QuantumFramework`QuantumState[
   SparseArray[
    Automatic, {4}, 0, {
     1, {{0, 4}, {{1}, {2}, {3}, {4}}}, {
      2^Rational[-1, 2] (1 + \[FormalR])^Rational[1, 2] 
       Cos[Rational[1, 2] \[FormalTheta]], -2^
        Rational[-1, 2] (1 - \[FormalR])^Rational[1, 2] 
       E^(Complex[0, -1] \[FormalPhi]) Sin[Rational[1, 2] \[FormalTheta]], 
       2^Rational[-1, 2] (1 + \[FormalR])^Rational[1, 2] 
       E^(Complex[0, 1] \[FormalPhi]) Sin[Rational[1, 2] \[FormalTheta]], 
       2^Rational[-1, 2] (1 - \[FormalR])^Rational[1, 2] 
       Cos[Rational[1, 2] \[FormalTheta]]}}], 
    Wolfram`QuantumFramework`QuantumBasis[<|
     "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
           
           Wolfram`QuantumFramework`QuditName[\[FormalCapitalI], "Dual" -> 
            False], 1} -> 1|>], "Output" -> 
      Wolfram`QuantumFramework`QuditBasis[<|{
           Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 1} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 1} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
      "Picture" -> "Schrodinger", "Label" -> None, "ParameterSpec" -> {}|>]]],
   TraditionalForm]], "Output",
 CellChangeTimes->{{3.9951282840240726`*^9, 3.995128285960659*^9}, {
  3.9951292337185497`*^9, 3.9951292354320755`*^9}},
 CellLabel->
  "Out[160]=",ExpressionUUID->"08e9ebdc-741e-3d4d-9825-cabd0ad9ec83"]
}, Open  ]],

Cell["\<\
Measuring the ancilla in the computational basis returns the eigen-ensemble \
weights; measuring it along X returns an unbiased pair instead:\
\>", "Text",
 CellChangeTimes->{{3.995129522233156*^9, 
  3.9951295376676445`*^9}},ExpressionUUID->"637b9180-9960-f649-b05a-\
3130cafcf843"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Values", "@", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumMeasurementOperator", "[", 
         RowBox[{"{", "2", "}"}], "]"}], "[", "qpsi", "]"}], 
       "[", "\"\<Probabilities\>\"", "]"}]}], ",", 
     RowBox[{"Values", "@", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumMeasurementOperator", "[", 
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<X\>\"", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}], "]"}], "[", "qpsi", "]"}], 
       "[", "\"\<Probabilities\>\"", "]"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"0", "<=", "\[FormalR]", "<=", "1"}], "&&", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], ",", "Reals"}],
      "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9951292485786533`*^9, 3.9951292491108646`*^9}},
 CellLabel->
  "In[161]:=",ExpressionUUID->"a6fb4fdd-2680-3a45-8f96-893a833ba942"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{"1", "+", "\[FormalR]"}], "2"], ",", 
     FractionBox[
      RowBox[{"1", "-", "\[FormalR]"}], "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", "2"], ",", 
     FractionBox["1", "2"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.995129251941864*^9},
 CellLabel->
  "Out[161]=",ExpressionUUID->"f5a289d1-1eee-b54a-99d4-77f3c4e7b6bf"]
}, Open  ]],

Cell["\<\
Either way the conditional states of the system, weighted by the outcome \
probabilities they come with, rebuild the same \[Rho], which is what stops \
the choice from being detectable on the system alone:\
\>", "Text",
 CellChangeTimes->{{3.995129546698248*^9, 
  3.9951295567823677`*^9}},ExpressionUUID->"26ba06b9-641a-804c-a464-\
d885621e9ad8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Normal", "[", 
            RowBox[{
             RowBox[{"QuantumPartialTrace", "[", 
              RowBox[{"#1", ",", 
               RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<DensityMatrix\>\"",
              "]"}], "]"}], "&"}], ")"}], "/@", 
         RowBox[{"Values", "[", 
          RowBox[{"#1", "[", "\"\<StateAssociation\>\"", "]"}], "]"}]}], 
        "]"}], "\[Equal]", "rho"}], "&"}], ")"}], "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"QuantumMeasurementOperator", "[", 
        RowBox[{"{", "2", "}"}], "]"}], "[", "qpsi", "]"}], ",", 
      RowBox[{
       RowBox[{"QuantumMeasurementOperator", "[", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<X\>\"", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}], "[", "qpsi", "]"}]}], 
     "}"}]}], ",", 
   RowBox[{
    RowBox[{"0", "\[LessEqual]", "\[FormalR]", "\[LessEqual]", "1"}], "&&", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], "\[Element]", 
     TemplateBox[{},
      "Reals"]}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9951292658159504`*^9, 3.99512926836203*^9}},
 CellLabel->
  "In[162]:=",ExpressionUUID->"e7cc9287-8fa0-a94a-a0d4-f6648e549e35"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.9951292728302307`*^9},
 CellLabel->
  "Out[162]=",ExpressionUUID->"7364a31f-9748-1840-aa26-483d8d5cc6f2"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "12.4 [BSc] How do I build the Gibbs (thermal) state \[Rho] = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[Beta]"}], " ", 
     RowBox[{"H", "/", "Z"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c5ae479c-d059-0e43-a5e5-bda5ff8630a5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Z", "=", 
    RowBox[{"Tr", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[Beta]"}], " ", "H"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8b8ad9aa-eb04-b042-a8d6-bd7342f5cec9"],
 ", and compute thermal averages \:27e8A\:27e9=Tr[A\[Rho]]?"
}], "Subsection",
 CellChangeTimes->{{3.995130177371872*^9, 
  3.995130244671917*^9}},ExpressionUUID->"5a33f3f2-7d39-0044-98bd-\
7b3802dfd2fe"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.995130591418951*^9, 
  3.9951305923543015`*^9}},ExpressionUUID->"50714897-2424-124e-af8a-\
144d6924f804"],

Cell["\<\
The Hamiltonian, written in the same Bloch form the states of 12.2 and 12.3 \
use:\
\>", "Text",
 CellChangeTimes->{{3.995130407069977*^9, 
  3.995130412834915*^9}},ExpressionUUID->"d4f1a7f1-840d-124f-9ff1-\
c846ec0a7f87"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ham", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"nvec", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
         RowBox[{"Cos", "[", "\[FormalPhi]", "]"}]}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[FormalPhi]", "]"}]}], ",", 
        RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}], "}"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"\[FormalW]", "/", "2"}], " ", 
     RowBox[{"nvec", ".", 
      RowBox[{"PauliMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9951302573215485`*^9, 3.99513025834054*^9}},
 CellLabel->
  "In[167]:=",ExpressionUUID->"ccab5955-eef4-4a42-acf1-d39057fde956"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", "\[FormalW]", " ", 
      RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}], ",", 
     RowBox[{
      FractionBox["1", "2"], " ", "\[FormalW]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "\[FormalPhi]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[FormalPhi]", "]"}]}]}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", "\[FormalW]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "\[FormalPhi]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}]}], "+", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[FormalPhi]", "]"}]}]}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], " ", "\[FormalW]", " ", 
      RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9951302588260098`*^9},
 CellLabel->
  "Out[167]=",ExpressionUUID->"1e91ae7a-04a1-d64b-956d-a98ce74d8d8f"]
}, Open  ]],

Cell["\<\
Its two levels sit at  \[PlusMinus]\[Omega]/2, and the partition function is \
the trace of the matrix exponential:\
\>", "Text",
 CellChangeTimes->{{3.995130422897003*^9, 
  3.9951304344531574`*^9}},ExpressionUUID->"aeda9639-cf57-1f41-923c-\
2bc6677ff862"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", "ham", "]"}], ",", 
     RowBox[{
      RowBox[{"\[FormalW]", ">", "0"}], "&&", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], "\[Element]", 
       TemplateBox[{},
        "Reals"]}]}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Simplify", "[", 
    RowBox[{"ExpToTrig", "[", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "\[FormalB]"}], " ", "ham"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"\[FormalW]", ">", "0"}], "&&", 
        RowBox[{"\[FormalB]", ">", "0"}], "&&", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], "\[Element]", 
         TemplateBox[{},
          "Reals"]}]}]}], "]"}], "]"}], "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.995130271172188*^9, 3.9951302716358585`*^9}, {
  3.995130348118353*^9, 3.99513035887154*^9}},
 CellLabel->
  "In[176]:=",ExpressionUUID->"466f9728-c296-af45-9024-5046ccf66360"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["\[FormalW]", "2"]}], ",", 
     FractionBox["\[FormalW]", "2"]}], "}"}], ",", 
   RowBox[{"2", " ", 
    RowBox[{"Cosh", "[", 
     FractionBox[
      RowBox[{"\[FormalB]", " ", "\[FormalW]"}], "2"], "]"}]}]}], 
  "}"}]], "Output",
 CellChangeTimes->{
  3.995130272047785*^9, {3.9951303511099377`*^9, 3.9951303637103558`*^9}, 
   3.995130436811096*^9},
 CellLabel->
  "Out[176]=",ExpressionUUID->"f4830482-3c04-534d-922f-7042de6df204"]
}, Open  ]],

Cell[TextData[{
 "Dividing the exponential by that trace gives the state, and it is again a \
Bloch vector: pointing along -",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "^"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a9961c23-8c79-cf45-844a-229571d77b0b"],
 " , of length set by the temperature alone:"
}], "Text",
 CellChangeTimes->{{3.995130445258009*^9, 
  3.9951304747477818`*^9}},ExpressionUUID->"9eb147ec-254e-4e45-a57f-\
a338b9aef776"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"gibbs", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "\[FormalB]"}], " ", "ham"}], "]"}], "/", 
      RowBox[{"Tr", "@", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{
         RowBox[{"-", "\[FormalB]"}], " ", "ham"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"\[FormalW]", ">", "0"}], "&&", 
      RowBox[{"\[FormalB]", ">", "0"}], "&&", 
      RowBox[{"Element", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], ",", 
        "Reals"}], "]"}]}]}], "]"}]}], ";", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"gibbs", "==", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nvec", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
            RowBox[{"Cos", "[", "\[FormalPhi]", "]"}]}], ",", 
           RowBox[{
            RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
            RowBox[{"Sin", "[", "\[FormalPhi]", "]"}]}], ",", 
           RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}], "}"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "2", "]"}], "-", 
          RowBox[{
           RowBox[{"Tanh", "[", 
            RowBox[{"\[FormalB]", " ", 
             RowBox[{"\[FormalW]", "/", "2"}]}], "]"}], " ", 
           RowBox[{"nvec", ".", 
            RowBox[{"PauliMatrix", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}]}], 
         ")"}]}]}], "]"}]}], ",", 
    RowBox[{
     RowBox[{"\[FormalW]", ">", "0"}], "&&", 
     RowBox[{"\[FormalB]", ">", "0"}], "&&", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], ",", 
       "Reals"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.995130281789545*^9, 3.9951302822381916`*^9}},
 CellLabel->
  "In[177]:=",ExpressionUUID->"b8165d7b-394a-e349-a3fc-afc2aff2420b"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.995130283995882*^9, 3.995130371535383*^9, 
  3.995130479638674*^9},
 CellLabel->
  "Out[177]=",ExpressionUUID->"c7705c2c-fe1a-7845-ab8a-0d93cc9b4d5a"]
}, Open  ]],

Cell[TextData[{
 "A thermal average is a trace against that state. Doing it for ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["H", "^"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "31e7c902-3560-4443-af73-9686c55f5ce3"],
 "  itself, and differentiating  logZ, are two routes to the same number:"
}], "Text",
 CellChangeTimes->{{3.9951304905721436`*^9, 
  3.995130522948183*^9}},ExpressionUUID->"12169f83-5e2d-f54d-86ef-\
0dd5f95f4e96"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "@", 
  RowBox[{"ExpToTrig", "@", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{"ham", ".", "gibbs"}], "]"}], ",", 
       RowBox[{"-", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"Tr", "@", 
            RowBox[{"MatrixExp", "[", 
             RowBox[{
              RowBox[{"-", "\[FormalB]"}], " ", "ham"}], "]"}]}], "]"}], ",", 
          "\[FormalB]"}], "]"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"\[FormalW]", ">", "0"}], "&&", 
      RowBox[{"\[FormalB]", ">", "0"}], "&&", 
      RowBox[{"Element", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], ",", 
        "Reals"}], "]"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.995130290586569*^9, 3.995130291058258*^9}},
 CellLabel->
  "In[170]:=",ExpressionUUID->"eb3ec903-8dcd-5746-820c-2f7e3acea67e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], " ", "\[FormalW]", " ", 
    RowBox[{"Tanh", "[", 
     FractionBox[
      RowBox[{"\[FormalB]", " ", "\[FormalW]"}], "2"], "]"}]}], ",", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], " ", "\[FormalW]", " ", 
    RowBox[{"Tanh", "[", 
     FractionBox[
      RowBox[{"\[FormalB]", " ", "\[FormalW]"}], "2"], "]"}]}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9951302915988026`*^9},
 CellLabel->
  "Out[170]=",ExpressionUUID->"96a1ed74-673e-1749-a90b-0b33e4238212"]
}, Open  ]],

Cell["\<\
The entropy comes from the same spectrum, and the thermodynamic identity \
relating it to the energy and the free energy is an algebraic consequence \
rather than a further assumption:\
\>", "Text",
 CellChangeTimes->{{3.9951305322678127`*^9, 
  3.995130533811329*^9}},ExpressionUUID->"4ab5f0c5-3642-2b4c-af35-\
511960497813"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", " ", 
           RowBox[{"Log", "[", "#", "]"}]}], "&"}], "/@", 
         RowBox[{"Eigenvalues", "[", "gibbs", "]"}]}], "]"}]}], "==", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"2", " ", 
         RowBox[{"Cosh", "[", 
          RowBox[{"\[FormalB]", " ", 
           RowBox[{"\[FormalW]", "/", "2"}]}], "]"}]}], "]"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[FormalB]", " ", 
          RowBox[{"\[FormalW]", "/", "2"}]}], ")"}], " ", 
        RowBox[{"Tanh", "[", 
         RowBox[{"\[FormalB]", " ", 
          RowBox[{"\[FormalW]", "/", "2"}]}], "]"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", " ", 
           RowBox[{"Log", "[", "#", "]"}]}], "&"}], "/@", 
         RowBox[{"Eigenvalues", "[", "gibbs", "]"}]}], "]"}]}], "==", 
      RowBox[{"\[FormalB]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{"ham", ".", "gibbs"}], "]"}], "+", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"Tr", "@", 
            RowBox[{"MatrixExp", "[", 
             RowBox[{
              RowBox[{"-", "\[FormalB]"}], " ", "ham"}], "]"}]}], "]"}], "/", 
          "\[FormalB]"}]}], ")"}]}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"\[FormalW]", ">", "0"}], "&&", 
    RowBox[{"\[FormalB]", ">", "0"}], "&&", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], ",", "Reals"}],
      "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9951302996246014`*^9, 3.995130300433092*^9}},
 CellLabel->
  "In[171]:=",ExpressionUUID->"fcdb0cbd-2fec-6444-a409-f049673feb9b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.995130318353548*^9},
 CellLabel->
  "Out[171]=",ExpressionUUID->"3b0a5a2f-63df-3f47-b2b5-e32df8af5b2a"]
}, Open  ]],

Cell["\<\
Both temperature limits are limits of the single number  \
tanh(\[Beta]\[Omega]/2), and the cold end lands on the eigen-projector for \
the lower level:\
\>", "Text",
 CellChangeTimes->{{3.995130545215143*^9, 
  3.9951305703692055`*^9}},ExpressionUUID->"23938361-dc34-784f-affd-\
d504d6ffcb67"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"nvec", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
        RowBox[{"Cos", "[", "\[FormalPhi]", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
        RowBox[{"Sin", "[", "\[FormalPhi]", "]"}]}], ",", 
       RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{"Tanh", "[", 
        RowBox[{"\[FormalB]", " ", 
         RowBox[{"\[FormalW]", "/", "2"}]}], "]"}], ",", 
       RowBox[{"\[FormalB]", "->", "0"}]}], "]"}], ",", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{"Tanh", "[", 
        RowBox[{"\[FormalB]", " ", 
         RowBox[{"\[FormalW]", "/", "2"}]}], "]"}], ",", 
       RowBox[{"\[FormalB]", "->", "Infinity"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"\[FormalW]", ">", "0"}]}]}], "]"}], ",", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ham", ".", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"1", "/", "2"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", "2", "]"}], "-", 
             RowBox[{"nvec", ".", 
              RowBox[{"PauliMatrix", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], ")"}]}], 
          ")"}]}], "==", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"\[FormalW]", "/", "2"}], ")"}]}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"1", "/", "2"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", "2", "]"}], "-", 
             RowBox[{"nvec", ".", 
              RowBox[{"PauliMatrix", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], ")"}]}], 
          ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"\[FormalW]", ">", "0"}], "&&", 
        RowBox[{"Element", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], ",", 
          "Reals"}], "]"}]}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9951303917201405`*^9, 3.995130392676428*^9}},
 CellLabel->
  "In[178]:=",ExpressionUUID->"928668d8-18cc-af4f-a665-76c24e18e54a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "1", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.9951303932946987`*^9, 3.995130574935217*^9},
 CellLabel->
  "Out[178]=",ExpressionUUID->"158a4124-d0f0-fc45-96c7-c1b4c5c028b0"]
}, Open  ]],

