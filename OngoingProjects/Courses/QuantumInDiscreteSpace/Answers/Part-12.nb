         "\[FormalA]", ",", "\[FormalB]", ",", "\[FormalC]", ",", 
          "\[FormalD]", ",", "\[FormalE]", ",", "\[FormalF]", ",", 
          "\[FormalG]", ",", "\[FormalH]"}], "}"}], ",", "Reals"}], "]"}]}], 
     "]"}], "&"}], "/@", "qsMubs"}]}]], "Input",
