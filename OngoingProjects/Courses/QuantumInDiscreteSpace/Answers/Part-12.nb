}, Open  ]],

Cell["\<\
One family in two coordinates, we can solve for the mapping that relates the \
two conventions:\
\>", "Text",
 CellChangeTimes->{{3.9949550059379044`*^9, 3.994955024111429*^9}, {
  3.9949555411973476`*^9, 
  3.99495555253636*^9}},ExpressionUUID->"87aedad4-3631-364e-90af-\
1b25460dc117"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{
       RowBox[{"QuantumState", "[", 
        RowBox[{"\"\<Werner\>\"", "[", 
         RowBox[{"\[FormalP]", ",", "2"}], "]"}], "]"}], 
       "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "==", "werner"}], ",", 
    "\[FormalLambda]"}], "]"}], "//", "Simplify"}]], "Input",
 CellLabel->
  "In[208]:=",ExpressionUUID->"1f62a10f-1cd7-e54d-b167-3c67ebf26293"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"\[FormalLambda]", "\[Rule]", 
    RowBox[{"1", "-", 
     FractionBox[
      RowBox[{"4", " ", "\[FormalP]"}], "3"]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.994950959073532*^9, 3.9949550267194557`*^9},
 CellLabel->
  "Out[208]=",ExpressionUUID->"f0d42228-e431-f143-a718-8e6c34fe580c"]
}, Open  ]],

Cell["\<\
We can find the entanglement threshold with the \
\[OpenCurlyDoubleQuote]Concurrence\[CloseCurlyDoubleQuote] metric:\
\>", "Text",
 CellChangeTimes->{{3.994955392944643*^9, 
  3.9949554183443146`*^9}},ExpressionUUID->"2e6b3c69-7f32-b94d-aab6-\
c787800a0e3a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"threshold", " ", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"QuantumEntanglementMonotone", "[", 
      RowBox[{"wernerQF", ",", "\"\<Concurrence\>\""}], "]"}], ",", 
     RowBox[{"0", "<=", "\[FormalP]", "<=", "1"}]}], "]"}]}], "\n"}]], "Input",
 CellChangeTimes->{{3.9949550443322735`*^9, 3.9949550663128376`*^9}, {
  3.9949554483866615`*^9, 3.994955452679367*^9}},
 CellLabel->
  "In[210]:=",ExpressionUUID->"8f6c94c6-e558-374d-a53b-ca2d72aedcdc"],

