Cell["Define the Hamiltonian:", "Text",
 CellChangeTimes->{{3.9951325535282955`*^9, 
  3.9951325574191704`*^9}},ExpressionUUID->"1d57080b-9b50-f14c-8e0f-\
d87405a50834"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"hq", "=", 
  RowBox[{"Dot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"\[FormalW]", "/", "2"}], 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
        RowBox[{"Cos", "[", "\[FormalPhi]", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
        RowBox[{"Sin", "[", "\[FormalPhi]", "]"}]}], ",", 
       RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}], "}"}]}], ",", 
    RowBox[{"QuantumOperator", "/@", 
     RowBox[{"{", 
      RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.995130607397772*^9, 3.9951306079934025`*^9}, 
   3.995130725588642*^9},
 CellLabel->
  "In[182]:=",ExpressionUUID->"6929bc22-b98a-5a45-ab0e-6ab575261cc8"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   TooltipBox[
    StyleBox[
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", "\[FormalW]", " ", 
        RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}], 
       InterpretationBox[
        RowBox[{
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"0"}]},
            "Ket"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[0, "Dual" -> False]], 
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"0"}]},
            "Bra"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[0, "Dual" -> True]]}],
        Wolfram`QuantumFramework`QuditName[
         Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 
         Wolfram`QuantumFramework`QuditName[0, "Dual" -> True]]]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], " ", "\[FormalW]", " ", 
          RowBox[{"Cos", "[", "\[FormalPhi]", "]"}], " ", 
          RowBox[{"Sin", "[", "\[FormalTheta]", "]"}]}], "-", 
         RowBox[{
          FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "\[FormalW]", " ", 
          RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
          RowBox[{"Sin", "[", "\[FormalPhi]", "]"}]}]}], ")"}], 
       InterpretationBox[
        RowBox[{
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"0"}]},
            "Ket"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[0, "Dual" -> False]], 
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"1"}]},
            "Bra"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[1, "Dual" -> True]]}],
        Wolfram`QuantumFramework`QuditName[
         Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 
         Wolfram`QuantumFramework`QuditName[1, "Dual" -> True]]]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], " ", "\[FormalW]", " ", 
          RowBox[{"Cos", "[", "\[FormalPhi]", "]"}], " ", 
          RowBox[{"Sin", "[", "\[FormalTheta]", "]"}]}], "+", 
         RowBox[{
          FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "\[FormalW]", " ", 
          RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
          RowBox[{"Sin", "[", "\[FormalPhi]", "]"}]}]}], ")"}], 
       InterpretationBox[
        RowBox[{
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"1"}]},
            "Ket"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[1, "Dual" -> False]], 
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"0"}]},
            "Bra"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[0, "Dual" -> True]]}],
        Wolfram`QuantumFramework`QuditName[
         Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 
         Wolfram`QuantumFramework`QuditName[0, "Dual" -> True]]], 
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "2"]}], " ", "\[FormalW]", " ", 
        RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}], 
       InterpretationBox[
        RowBox[{
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"1"}]},
            "Ket"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[1, "Dual" -> False]], 
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"1"}]},
            "Bra"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[1, "Dual" -> True]]}],
        Wolfram`QuantumFramework`QuditName[
         Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 
         Wolfram`QuantumFramework`QuditName[1, "Dual" -> True]]]}]}],
     ShowStringCharacters->False],
    TagBox[
     GridBox[{{
        RowBox[{
          RowBox[{
            FractionBox["1", "2"], " ", "\"Z\"", " ", "\[FormalW]", " ", 
            RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}], "+", 
          RowBox[{
            FractionBox["1", "2"], " ", "\"X\"", " ", "\[FormalW]", " ", 
            RowBox[{"Cos", "[", "\[FormalPhi]", "]"}], " ", 
            RowBox[{"Sin", "[", "\[FormalTheta]", "]"}]}], "+", 
          RowBox[{
            FractionBox["1", "2"], " ", "\"Y\"", " ", "\[FormalW]", " ", 
            RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
            RowBox[{"Sin", "[", "\[FormalPhi]", "]"}]}]}]}, {
        TemplateBox[{"\"QuantumOperator: \"", 
          RowBox[{
            RowBox[{"{", 
              SubscriptBox["2", "1"], "}"}], "\[Rule]", 
            RowBox[{"{", 
              SubscriptBox["2", "1"], "}"}]}]}, "RowDefault"]}}, 
      GridBoxAlignment -> {"Columns" -> {{Center}}}, DefaultBaseStyle -> 
      "Column", 
      GridBoxItemSize -> {
       "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"]],
   Wolfram`QuantumFramework`QuantumOperator[
    Wolfram`QuantumFramework`QuantumState[
    SparseArray[
     Automatic, {4}, 0, {
      1, {{0, 4}, {{2}, {3}, {1}, {4}}}, {
       Rational[1, 2] \[FormalW] Cos[\[FormalPhi]] Sin[\[FormalTheta]] + 
        Complex[0, Rational[-1, 2]] \[FormalW] Sin[\[FormalTheta]] 
         Sin[\[FormalPhi]], 
        Rational[1, 2] \[FormalW] Cos[\[FormalPhi]] Sin[\[FormalTheta]] + 
        Complex[0, Rational[1, 2]] \[FormalW] Sin[\[FormalTheta]] 
         Sin[\[FormalPhi]], Rational[1, 2] \[FormalW] Cos[\[FormalTheta]], 
        Rational[-1, 2] \[FormalW] Cos[\[FormalTheta]]}}], 
     Wolfram`QuantumFramework`QuantumBasis[<|
      "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
            Wolfram`QuantumFramework`QuditName[0, "Dual" -> True], 1} -> 
          SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
            Wolfram`QuantumFramework`QuditName[1, "Dual" -> True], 1} -> 
          SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
       "Output" -> Wolfram`QuantumFramework`QuditBasis[<|{
            Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 1} -> 
          SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
            Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 1} -> 
          SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
       "Picture" -> "Schrodinger", "Label" -> 
       Rational[1, 2] "Z" \[FormalW] Cos[\[FormalTheta]] + 
        Rational[1, 2] "X" \[FormalW] Cos[\[FormalPhi]] Sin[\[FormalTheta]] + 
        Rational[1, 2] "Y" \[FormalW] Sin[\[FormalTheta]] Sin[\[FormalPhi]], 
       "ParameterSpec" -> {}|>]], {{1}, {1}}]], TraditionalForm]], "Output",
 CellChangeTimes->{{3.995130609650345*^9, 3.995130612754072*^9}, {
  3.9951307265937443`*^9, 3.9951307351565475`*^9}},
 CellLabel->
  "Out[182]=",ExpressionUUID->"f3bd28bb-3345-604c-ab7e-49f8987492f8"]
}, Open  ]],

Cell["\<\
The Gibbs state is its matrix handed to QuantumState and normalized. The \
state reports its own Bloch vector, which is where the temperature shows up:\
\>", "Text",
 CellChangeTimes->{{3.99513258841362*^9, 
  3.9951326007804585`*^9}},ExpressionUUID->"7c17ff7b-6ae7-b04b-b15e-\
16a171619a87"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"gq", "=", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"MatrixExp", "[", 
        RowBox[{
         RowBox[{"-", "\[FormalB]"}], " ", "hq"}], "]"}], 
       "[", "\"\<Matrix\>\"", "]"}], ",", "2"}], "]"}], 
    "[", "\"\<Normalized\>\"", "]"}]}], ";", 
  RowBox[{"Simplify", "@", 
   RowBox[{"ExpToTrig", "@", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"gq", "[", "\"\<BlochVector\>\"", "]"}], ",", 
      RowBox[{
       RowBox[{"\[FormalW]", ">", "0"}], "&&", 
       RowBox[{"\[FormalB]", ">", "0"}], "&&", 
       RowBox[{"Element", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], ",", 
         "Reals"}], "]"}]}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.995130746827469*^9, 3.995130750461344*^9}},
 CellLabel->
  "In[197]:=",ExpressionUUID->"37584025-996d-a344-ae27-044933d123c0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Cos", "[", "\[FormalPhi]", "]"}]}], " ", 
    RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
    RowBox[{"Tanh", "[", 
     FractionBox[
      RowBox[{"\[FormalB]", " ", "\[FormalW]"}], "2"], "]"}]}], ",", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Sin", "[", "\[FormalTheta]", "]"}]}], " ", 
    RowBox[{"Sin", "[", "\[FormalPhi]", "]"}], " ", 
    RowBox[{"Tanh", "[", 
     FractionBox[
      RowBox[{"\[FormalB]", " ", "\[FormalW]"}], "2"], "]"}]}], ",", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}], " ", 
    RowBox[{"Tanh", "[", 
     FractionBox[
      RowBox[{"\[FormalB]", " ", "\[FormalW]"}], "2"], "]"}]}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9951307511037235`*^9, 3.995132604728012*^9},
 CellLabel->
  "Out[197]=",ExpressionUUID->"46b6c6a3-087a-184a-9bb6-8e3521133f62"]
}, Open  ]],

Cell["\<\
The mean energy is the trace of the operator against the state:\
\>", "Text",
 CellChangeTimes->{{3.9951326191457024`*^9, 
  3.9951326204101696`*^9}},ExpressionUUID->"e7541570-00cb-9347-82a9-\
4c4104977ddc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "@", 
  RowBox[{"ExpToTrig", "@", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{"hq", "@", 
       RowBox[{"gq", "[", "\"\<Operator\>\"", "]"}]}], "]"}], ",", 
     RowBox[{
      RowBox[{"\[FormalW]", ">", "0"}], "&&", 
      RowBox[{"\[FormalB]", ">", "0"}], "&&", 
      RowBox[{"Element", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], ",", 
        "Reals"}], "]"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.995130764062908*^9, 3.9951307647448025`*^9}, {
  3.995130796240036*^9, 3.9951308090485897`*^9}, {3.995131359944319*^9, 
  3.995131374785673*^9}},
 CellLabel->
  "In[194]:=",ExpressionUUID->"7a994b88-028c-f74b-af1b-ab926d912da5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["1", "2"]}], " ", "\[FormalW]", " ", 
  RowBox[{"Tanh", "[", 
   FractionBox[
    RowBox[{"\[FormalB]", " ", "\[FormalW]"}], "2"], "]"}]}]], "Output",
 CellChangeTimes->{
  3.9951307659220066`*^9, 3.9951308096794205`*^9, {3.995131364677662*^9, 
   3.995131375253866*^9}},
 CellLabel->
  "Out[194]=",ExpressionUUID->"c30b5b60-e567-eb4d-949e-15e2472d49fb"]
