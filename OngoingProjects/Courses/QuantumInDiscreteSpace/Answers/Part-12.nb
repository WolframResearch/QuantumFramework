Cell["\<\
The two eigenvalues of the product are never needed individually, only their \
sum and their product enter, and those are a trace and a pair of determinants:\
\>", "Text",
 CellChangeTimes->{{3.9953707488632545`*^9, 3.9953707620039806`*^9}, {
  3.995371170298916*^9, 
  3.9953711715844727`*^9}},ExpressionUUID->"2a9a22da-de2b-ab4f-9a50-\
d0121b63a54b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{"rho1", ".", "rho2"}], "]"}], "]"}], "==", 
      RowBox[{"Tr", "[", 
       RowBox[{"rho1", ".", "rho2"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Times", "@@", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{"rho1", ".", "rho2"}], "]"}]}], "==", 
      RowBox[{
       RowBox[{"Det", "[", "rho1", "]"}], " ", 
       RowBox[{"Det", "[", "rho2", "]"}]}]}]}], "}"}], ",", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[FormalX]", ",", "\[FormalY]", ",", "\[FormalZ]", ",", "\[FormalU]", ",",
        "\[FormalV]", ",", "\[FormalW]"}], "}"}], ",", "Reals"}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.995369221516159*^9, 3.995369222051882*^9}},
 CellLabel->"In[66]:=",ExpressionUUID->"00479c30-0fc3-9b47-b0a0-e3533b081a1c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
