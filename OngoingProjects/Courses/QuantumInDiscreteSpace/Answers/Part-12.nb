                "Ket"],
               FontWeight->"Plain"],
              Wolfram`QuantumFramework`QuditName[1, "Dual" -> False]],
             TraditionalForm], 
            FormBox[
             InterpretationBox[
              StyleBox[
               TemplateBox[{
                 RowBox[{
                   FormBox["1", TraditionalForm]}]},
                "Bra"],
               FontWeight->"Plain"],
              Wolfram`QuantumFramework`QuditName[1, "Dual" -> True]],
             TraditionalForm]}],
           Wolfram`QuantumFramework`QuditName[
            Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 
            Wolfram`QuantumFramework`QuditName[1, "Dual" -> True]]],
          TraditionalForm]}]}],
       ShowStringCharacters->False],
      TagBox[
       GridBox[{{"\"I\""}, {
          TemplateBox[{"\"QuantumState: \"", 
            RowBox[{
              RowBox[{"{", "}"}], "\[Rule]", 
              RowBox[{"{", "2", "}"}]}]}, "RowDefault"]}}, 
        GridBoxAlignment -> {"Columns" -> {{Center}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"]],
     Wolfram`QuantumFramework`QuantumState[
     SparseArray[
      Automatic, {2, 2}, 0, {
       1, {{0, 2, 4}, {{1}, {2}, {1}, {2}}}, {
        Rational[1, 2] + Rational[1, 2] \[FormalB] Cos[\[FormalC]], 
         Rational[1, 2] \[FormalB] Sin[\[FormalC]], Rational[1, 2] \[FormalB] 
         Sin[\[FormalC]], Rational[1, 2] + 
         Rational[-1, 2] \[FormalB] Cos[\[FormalC]]}}], 
      Wolfram`QuantumFramework`QuantumBasis[<|
       "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
             
             Wolfram`QuantumFramework`QuditName[\[FormalCapitalI], "Dual" -> 
              False], 1} -> 1|>], "Output" -> 
        Wolfram`QuantumFramework`QuditBasis[<|{
             Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 1} -> 
           SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
             Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 1} -> 
           SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
        "Picture" -> "Schrodinger", "Label" -> "I", 
        "ParameterSpec" -> {}|>]]]}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.995370984371216*^9},
 CellLabel->
  "Out[69]//TraditionalForm=",ExpressionUUID->"a8d0af45-9e1d-9c47-b9c9-\
9d6fd04f7c9b"]
}, Open  ]],

Cell[TextData[{
 "QuantumSimilarity with the \[OpenCurlyDoubleQuote]Fidelity\
\[CloseCurlyDoubleQuote] measure computes ",
 Cell[BoxData[
  FormBox[
   SqrtBox["F"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d2a469fc-dc3e-7d44-bd32-ac28faab3964"],
 " and not ",
 Cell[BoxData[
  FormBox["F", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9a8dbe78-c770-034c-a643-a797d8e15242"],
 "  so squaring it is what matches the definition above:"
}], "Text",
 CellChangeTimes->{{3.99537124750239*^9, 
  3.995371252898451*^9}},ExpressionUUID->"28bd2e8a-0c80-ee4f-bf51-\
9ed3d8821e7e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"QuantumSimilarity", "[", 
     RowBox[{"qs1", ",", "qs2", ",", "\"\<Fidelity\>\""}], "]"}], "2"], ",", 
   RowBox[{
    RowBox[{"0", "\[LessEqual]", "\[FormalA]", "\[LessEqual]", "1"}], "&&", 
    RowBox[{"0", "\[LessEqual]", "\[FormalB]", "\[LessEqual]", "1"}], "&&", 
    RowBox[{"0", "\[LessEqual]", "\[FormalC]", "\[LessEqual]", "\[Pi]"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9953695082609673`*^9, 3.995369533975584*^9}, 
   3.9953879687838535`*^9},
 CellLabel->
  "In[322]:=",ExpressionUUID->"4e00928b-0ff1-4c4b-9b92-9551958a8a75"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{"1", "+", 
    SqrtBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["\[FormalA]", "2"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["\[FormalB]", "2"]}], ")"}]}]], "+", 
    RowBox[{"\[FormalA]", " ", "\[FormalB]", " ", 
     RowBox[{"Cos", "[", "\[FormalC]", "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.995369509484291*^9, 3.9953695345062714`*^9}, 
   3.995370242453783*^9, 3.995370992762947*^9, 3.995387970262865*^9},
 CellLabel->
  "Out[322]=",ExpressionUUID->"0ffaea43-7cdf-4c42-a04a-1b06f272833e"]
}, Open  ]],

Cell[TextData[{
 "Also this property ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"F", "(", 
     RowBox[{"\[Rho]", ",", " ", "\[Sigma]"}], ")"}], "=", " ", 
    RowBox[{"F", "(", 
     RowBox[{"\[Sigma]", ",", " ", "\[Rho]"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f5665f01-e9fc-af4d-8948-31e997ec01b0"],
 " has to hold:"
}], "Text",
 CellChangeTimes->{{3.9953879272382145`*^9, 
  3.9953879558837643`*^9}},ExpressionUUID->"5d6cdd7e-a06c-904b-bdf8-\
be132406d2d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumSimilarity", "[", 
   RowBox[{"qs1", ",", "qs2", ",", "\"\<Fidelity\>\""}], "]"}], "==", 
  RowBox[{"QuantumSimilarity", "[", 
   RowBox[{"qs2", ",", "qs1", ",", "\"\<Fidelity\>\""}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9953879158909016`*^9, 3.995387924396534*^9}},
 CellLabel->
  "In[321]:=",ExpressionUUID->"efa66d69-6240-ec47-bfe4-d52627f09356"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9953879247234383`*^9, 3.9953879602090683`*^9},
 CellLabel->
  "Out[321]=",ExpressionUUID->"7c9c23ad-1960-6c4d-beda-b9fe22a4cf29"]
}, Open  ]],

Cell["Check against the vector definition:", "Text",
 CellChangeTimes->{{3.995371256116947*^9, 
  3.995371267090233*^9}},ExpressionUUID->"e4ffed22-03d6-3b4d-98e2-\
cb77b2ef8d51"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"v1", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "\[FormalA]"}], "}"}]}], ",", 
       RowBox[{"v2", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[FormalB]", " ", 
           RowBox[{"Sin", "[", "\[FormalC]", "]"}]}], ",", "0", ",", 
          RowBox[{"\[FormalB]", " ", 
           RowBox[{"Cos", "[", "\[FormalC]", "]"}]}]}], "}"}]}]}], "}"}], ",", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"v1", ".", "v2"}], "+", 
        SqrtBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            SuperscriptBox[
             RowBox[{"Norm", "[", "v1", "]"}], "2"]}], ")"}], 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            SuperscriptBox[
             RowBox[{"Norm", "[", "v2", "]"}], "2"]}], ")"}]}]]}], ")"}]}]}], 
    "]"}], ",", 
   RowBox[{
    RowBox[{"0", "<=", "\[FormalA]", "<=", "1"}], "&&", 
    RowBox[{"0", "<=", "\[FormalB]", "<=", "1"}], "&&", 
    RowBox[{"0", "<=", "\[FormalC]", "<=", "Pi"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9953709958989677`*^9, 3.9953710840605335`*^9}},
 CellLabel->
  "In[323]:=",ExpressionUUID->"56043a7a-4c8b-744b-9902-a991d31d859a"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{"1", "+", 
    SqrtBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["\[FormalA]", "2"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["\[FormalB]", "2"]}], ")"}]}]], "+", 
    RowBox[{"\[FormalA]", " ", "\[FormalB]", " ", 
     RowBox[{"Cos", "[", "\[FormalC]", "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.995371069058489*^9, 3.995371084413561*^9}, 
   3.9953879736666756`*^9},
 CellLabel->
  "Out[323]=",ExpressionUUID->"b7f98748-b045-fa4b-a4db-4168a94bed4e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "12.7 [MSc] How do I find the optimal state-discrimination measurement and \
the Helstrom error probability \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "err"], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"1", "-"}], "||", 
       RowBox[{
        RowBox[{
         SubscriptBox["p", "1"], 
         SubscriptBox["\[Rho]", "1"]}], "-", 
        RowBox[{
         SubscriptBox["p", "2"], 
         SubscriptBox["\[Rho]", "2"]}]}], 
       SubscriptBox["||", "1"]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "48c8f02b-be35-4141-90b4-14a241473821"]
}], "Subsection",
 CellChangeTimes->{{3.9953737202726707`*^9, 
  3.9953737817256527`*^9}},ExpressionUUID->"31098e94-2a91-e94e-8d21-\
626d12e92358"],

Cell[TextData[{
 "One of two known states arrives, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4858751f-2c9c-9a4b-8be6-041f37fd94d9"],
 "with prior ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c8d3a9a9-6115-db40-ac02-d3ac4a8367ed"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "72ed4915-d254-f740-9a60-bc40712d6b5b"],
 " with prior ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[Minus]", "p"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d84c9894-9503-a34f-b5d3-6116dca1f48f"],
 ", and a single measurement must name which. The apparatus is a two-outcome \
POVM \n",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["E", "1"], ",", 
     SubscriptBox["E", "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a405c0e7-14ec-ab4e-91f1-1bf765b6d8d1"],
 "}, outcome ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ddc01d28-ec4f-7b4f-84f8-d345bf763ae6"],
 " meaning \[OpenCurlyDoubleQuote]it was ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7f8e4f22-e7a7-924c-bfe9-32baef3403b7"],
 "\[CloseCurlyDoubleQuote], so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "err"], "="}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "54d9b139-24df-264d-91fa-8c0e13307654"],
 "\[Rho] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{
       SubscriptBox["\[Rho]", "1"], 
       SubscriptBox["E", "2"]}], "]"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "p"}], ")"}], 
      RowBox[{"Tr", "[", 
       RowBox[{
        SubscriptBox["\[Rho]", "2"], 
        SubscriptBox["E", "1"]}], "]"}]}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "p"}], ")"}], "+", 
     RowBox[{"Tr", "[", 
      RowBox[{"\[CapitalLambda]", " ", 
       SubscriptBox["E", "2"]}], "]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fe742552-0ef5-264e-9d91-e1a46829f078"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalLambda]", "=", 
    RowBox[{
     SubscriptBox["p\[Rho]", "1"], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "p"}], ")"}], 
      SubscriptBox["\[Rho]", "2"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3fafacd3-9da4-3344-87d6-4feb350a890c"],
 ". Only  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Tr", "[", 
    RowBox[{"\[CapitalLambda]", " ", 
     SubscriptBox["E", "2"]}], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "11bfa7f6-34d2-ed4e-bb7e-2737af6402bc"],
 "is free, and over ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", 
    SubscriptBox["E", "2"], "\[LessEqual]", "I"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ddd1efd7-76cd-474c-92ca-4785b064163c"],
 " it is made as negative as possible by putting ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4a715547-76d4-c346-b969-f41fef54d68c"],
 " on the negative eigenspace of the Helstrom matrix  \[CapitalLambda] and \
nowhere else. So the optimal measurement is the pair of spectral projectors \
of  \[CapitalLambda], and what it leaves behind is the sum of  \
\[CapitalLambda]\[CloseCurlyQuote]s negative eigenvalues, which is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1", "-"}], "||", "\[CapitalLambda]", 
      SubscriptBox["||", "1"]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7bbdf5b8-680d-5245-9a98-c94504210f6d"],
 " . For a qubit  \[CapitalLambda] has one eigenvalue of each sign, so the \
measurement is a single projector and the entire answer is one direction in \
the Bloch ball. Let\[CloseCurlyQuote]s try with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", "0.4"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "185b7bab-1c44-6645-9968-53be969d7ad6"],
 " and |0\[RightAngleBracket], |+\[RightAngleBracket] states."
}], "Text",
 CellChangeTimes->{{3.99539243493746*^9, 
  3.9953928988080482`*^9}},ExpressionUUID->"6cdc9857-e9a4-7145-bbe2-\
6446d691e4fc"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9953902825087833`*^9, 
  3.995390283333843*^9}},ExpressionUUID->"ec36392a-6416-7242-b8d1-\
163124753a5f"],

Cell["Define the kets:", "Text",
 CellChangeTimes->{{3.995390310124916*^9, 
  3.99539031247517*^9}},ExpressionUUID->"b7758014-b1a2-a24b-ade9-\
4632bba265b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"p1", "=", "0.4"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ket0", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", "0", "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ketPlus", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      FractionBox["1", 
       SqrtBox["2"]], "}"}], ",", 
     RowBox[{"{", 
      FractionBox["1", 
       SqrtBox["2"]], "}"}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9953902928840523`*^9, 3.995390318025467*^9}, 
   3.9953903552980785`*^9},
 CellLabel->
  "In[479]:=",ExpressionUUID->"c45efbd7-ca50-1044-8a13-fe1cde335fbc"],

Cell["Build the density matrices:", "Text",
 CellChangeTimes->{{3.995390323325739*^9, 
  3.995390327858919*^9}},ExpressionUUID->"1bfbdc7f-0598-e542-9770-\
406137ef0048"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rho1", "=", 
   RowBox[{"ket0", ".", 
    RowBox[{"ConjugateTranspose", "[", "ket0", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rho2", "=", 
   RowBox[{"ketPlus", ".", 
    RowBox[{"ConjugateTranspose", "[", "ketPlus", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9953902928840523`*^9, 3.995390318025467*^9}},
 CellLabel->
  "In[482]:=",ExpressionUUID->"fca07b5b-ed80-0f40-9464-e82786e5792d"],

Cell["Construct Helstrom operator and calculate bound:", "Text",
 CellChangeTimes->{{3.995390379656435*^9, 
  3.995390391266844*^9}},ExpressionUUID->"f5621823-8a5f-8347-bcba-\
ccc539a1cf11"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"lambda", "=", 
   RowBox[{
    RowBox[{"p1", " ", "rho1"}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "p1"}], ")"}], " ", "rho2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"traceNorm", "=", 
   RowBox[{"Total", "[", 
    RowBox[{"SingularValueList", "[", "lambda", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"perrHelstrom", "=", 
  FractionBox[
   RowBox[{"1", "-", "traceNorm"}], "2"]}]}], "Input",
 CellChangeTimes->{{3.995390342598503*^9, 3.995390367646364*^9}},
 CellLabel->
  "In[484]:=",ExpressionUUID->"660ada15-9b03-1b46-ac0e-2cfd12bb070d"],

Cell[BoxData["0.13944487245360104`"], "Output",
 CellChangeTimes->{{3.995390367972986*^9, 3.9953903933382053`*^9}, 
   3.995392905557579*^9},
 CellLabel->
  "Out[486]=",ExpressionUUID->"c0e2c27e-1e32-314c-b1e6-4f0abcd366bc"]
}, Open  ]],

Cell["Construct the Optimal POVM projectors:", "Text",
 CellChangeTimes->{{3.9953904045677223`*^9, 
  3.9953904140742664`*^9}},ExpressionUUID->"9bcd565f-fb1c-be4b-806a-\
7c7b0b11805a"],

Cell[TextData[{
 "Build ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3c68594c-501b-1c4c-b2c5-6c5b65e00844"],
 " from the outer products of the positive eigenvectors:"
}], "Text",
 CellChangeTimes->{{3.9953923759657288`*^9, 
  3.9953923875271606`*^9}},ExpressionUUID->"bb3688d6-4214-df44-82d6-\
c4053281f2ec"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"evals", ",", "evecs"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", "lambda", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pi1", "=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", "#", ",", 
        RowBox[{"Conjugate", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
     RowBox[{"Pick", "[", 
      RowBox[{"evecs", ",", "evals", ",", 
       RowBox[{"_", "?", "Positive"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pi2", " ", "=", " ", 
   RowBox[{
    RowBox[{"IdentityMatrix", "[", "2", "]"}], "-", "pi1"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9953904285379925`*^9, 3.9953904367981873`*^9}, {
  3.995391973050741*^9, 3.9953919837115803`*^9}, {3.9953923942585545`*^9, 
  3.9953923958060455`*^9}},
 CellLabel->
  "In[487]:=",ExpressionUUID->"dbb9d09d-a920-1a4c-9c73-016836830d34"],

Cell["From we can also get an alternative expression:", "Text",
 CellChangeTimes->{{3.995392951493868*^9, 
  3.9953929644583073`*^9}},ExpressionUUID->"8368450f-5718-1a4c-9da6-\
4c8848e91495"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"perrTheory", "=", 
  RowBox[{
   RowBox[{"p1", " ", 
    RowBox[{"Tr", "[", 
     RowBox[{"pi2", ".", "rho1"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "p1"}], ")"}], " ", 
    RowBox[{"Tr", "[", 
     RowBox[{"pi1", ".", "rho2"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.995392000431391*^9, 3.995392011374096*^9}},
 CellLabel->
  "In[490]:=",ExpressionUUID->"cd87b102-4b4b-e041-989a-870e81efb71b"],

Cell[BoxData["0.13944487245360115`"], "Output",
 CellChangeTimes->{{3.995392001135664*^9, 3.9953920117269535`*^9}, 
   3.99539291158675*^9},
 CellLabel->
  "Out[490]=",ExpressionUUID->"8cb75205-0a40-0445-8749-d80804f356da"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
