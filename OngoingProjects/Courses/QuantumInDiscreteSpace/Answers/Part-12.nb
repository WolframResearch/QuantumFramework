(* Beginning of Notebook Content *)
Notebook[{
Cell[BoxData[
 RowBox[{"<<", "Wolfram`QuantumFramework`"}]], "Input",
 CellChangeTimes->{{3.994949275487295*^9, 3.9949492807938347`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"13d3176f-f0ad-9c4f-9769-552e6b5c3992"],

Cell[CellGroupData[{

Cell["\<\
12.1 [BSc] How do I build a Werner state and locate its entanglement \
threshold?\
\>", "Subsection",
 CellChangeTimes->{{3.9949492941508656`*^9, 
  3.9949492959022408`*^9}},ExpressionUUID->"1c416ba4-04ce-6940-b955-\
df6685dff065"],

Cell["\<\
A Werner state is a singlet diluted by white noise, and what picks the family \
out is a symmetry: these are the two-qubit states left unchanged when the \
same unitary acts on both qubits. That invariance leaves exactly one free \
parameter, so every statement below depends on which parameter is meant, and \
the convention has to be fixed before a threshold can be quoted. Take\
\>", "Text",
 CellChangeTimes->{{3.994950579209797*^9, 3.994950633288061*^9}, 
   3.9949532046107006`*^9, {3.994955574817959*^9, 
   3.9949555828771286`*^9}},ExpressionUUID->"aea850cd-9f27-f547-8315-\
a0f67aece3fe"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Rho]", "W"], "(", "\[Lambda]", ")"}], "=", "\[Lambda]", 
    " "}], TraditionalForm]],
  FontSize->16,ExpressionUUID->"bf587f5b-248f-9f43-b13a-906c4a7fc8ad"],
 Cell[BoxData[
  FormBox[
   RowBox[{Cell["|",ExpressionUUID->"c441424c-83c1-264f-92e7-0929769a0d83"], 
    SuperscriptBox["\[CapitalPsi]", "-"], Cell[
    "\[RightAngleBracket]",ExpressionUUID->
     "f3f4356f-ecd3-7944-8d9c-a4ace4f36e37"]}], TraditionalForm]],
  FontSize->16,ExpressionUUID->"9fbaffd4-ec20-8041-b70c-92146b13ae32"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
    Cell["\[LeftAngleBracket]",ExpressionUUID->
      "9a0480b5-d712-be40-9cac-9c61cf609fd1"], 
     SuperscriptBox["\[CapitalPsi]", "-"], Cell[
     "|",ExpressionUUID->"b2ed71c4-8c97-da43-8cbe-95bd864c9a16"]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Lambda]"}], ")"}], 
     FractionBox["I", "4"]}]}], TraditionalForm]],
  FontSize->16,ExpressionUUID->"484fa166-9ee1-8244-9509-c4b73f8becff"],
 StyleBox[" ",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.9949532246546993`*^9, 3.994953305485462*^9}, {
   3.994954855657074*^9, 3.9949549609924927`*^9}, 
   3.994955577361803*^9},ExpressionUUID->"9e80a87b-31be-b14d-ba1a-\
d69a5c2c6ad3"],

Cell[TextData[{
 "so \[Lambda] is the weight on the singlet and 1\[Minus]\[Lambda] the weight \
on the uniform mixture. Read it as a mixing probability where \[Lambda] runs \
over 0\[LessEqual]\[Lambda]\[LessEqual]1, from white noise to a pure singlet, \
but positivity of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "W"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "298393fe-1029-6748-a5ed-f2537f726861"],
 " is the only real constraint which the spectrum below settles. As \[Lambda] \
falls the noise washes the entanglement out, and the value of \[Lambda] where \
that happens is the threshold"
}], "Text",
 CellChangeTimes->{{3.9949533505788345`*^9, 3.9949534183568707`*^9}, {
  3.994953463502636*^9, 3.994953469264471*^9}, {3.994953508667362*^9, 
  3.9949535113425026`*^9}},ExpressionUUID->"674404f4-9ec5-d843-9c87-\
30009ab42f7d"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9949500876340714`*^9, 
  3.9949500891961155`*^9}},ExpressionUUID->"a09f385c-9b89-a946-bcdf-\
1f86f55ca199"],

Cell["\<\
Build the Werner state family for two qubits using the standard definition \
with the \[Lambda] convention:\
\>", "Text",
 CellChangeTimes->{{3.994950735479561*^9, 
  3.994950777790844*^9}},ExpressionUUID->"47a00832-47a8-d444-a88a-\
6fda9fd6fcce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixForm", "[", 
  RowBox[{"werner", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"singlet", "=", 
       RowBox[{"Normalize", "@", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}]}], "]"}], "-", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "0"}], "}"}]}], "]"}]}], "]"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"\[FormalLambda]", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"singlet", ",", "singlet"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[FormalLambda]"}], ")"}], " ", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "4", "]"}], "/", "4"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9949500987162914`*^9, 3.99495012562722*^9}, {
   3.994950534414583*^9, 3.994950538513592*^9}, 3.9949539879863777`*^9},
 CellLabel->
  "In[184]:=",ExpressionUUID->"8cd7c7a0-9cc1-684e-a679-fc1b6c239843"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      FractionBox[
       RowBox[{"1", "-", "\[FormalLambda]"}], "4"], "0", "0", "0"},
     {"0", 
      RowBox[{
       FractionBox[
        RowBox[{"1", "-", "\[FormalLambda]"}], "4"], "+", 
       FractionBox["\[FormalLambda]", "2"]}], 
      RowBox[{"-", 
       FractionBox["\[FormalLambda]", "2"]}], "0"},
     {"0", 
      RowBox[{"-", 
       FractionBox["\[FormalLambda]", "2"]}], 
      RowBox[{
       FractionBox[
        RowBox[{"1", "-", "\[FormalLambda]"}], "4"], "+", 
       FractionBox["\[FormalLambda]", "2"]}], "0"},
     {"0", "0", "0", 
      FractionBox[
       RowBox[{"1", "-", "\[FormalLambda]"}], "4"]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{{3.994950102878208*^9, 3.994950127370022*^9}, {
   3.9949505291946545`*^9, 3.9949505388636208`*^9}, 3.9949539897253475`*^9},
 CellLabel->
  "Out[184]//MatrixForm=",ExpressionUUID->"4c33533a-a43d-8d45-af03-\
a7c00ac24afb"]
}, Open  ]],

Cell["Verify the symmetry:", "Text",
 CellChangeTimes->{{3.9949507889011497`*^9, 
  3.994950793317339*^9}},ExpressionUUID->"052e281b-1991-7f48-9417-\
99710eaba078"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"u", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", 
           FractionBox["\[FormalTheta]", "2"], "]"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", " ", "\[FormalPhi]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", 
           FractionBox["\[FormalTheta]", "2"], "]"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", " ", "\[FormalPsi]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sin", "[", 
            FractionBox["\[FormalTheta]", "2"], "]"}]}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "\[FormalPsi]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"Cos", "[", 
           FractionBox["\[FormalTheta]", "2"], "]"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "\[FormalPhi]"}], "]"}]}]}], 
        "}"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", "u", "]"}], ".", "u"}], "\[Equal]", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"u", ",", "u"}], "]"}], ".", "werner", ".", 
         RowBox[{"ConjugateTranspose", "[", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"u", ",", "u"}], "]"}], "]"}]}], "\[Equal]", "werner"}]}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]", ",", "\[FormalPsi]"}], 
       "}"}], "\[Element]", 
      TemplateBox[{},
       "Reals"]}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9949501173913097`*^9, 3.994950123498871*^9}},
 CellLabel->
  "In[186]:=",ExpressionUUID->"d709c165-adf3-c64e-9186-f64e977f7626"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{{3.9949501202917175`*^9, 3.994950130077444*^9}, 
   3.9949540333349953`*^9},
 CellLabel->
  "Out[186]=",ExpressionUUID->"8ab12785-6127-3e4d-aa68-f5db3956c0d3"]
}, Open  ]],

Cell["Calculate the spectrum:", "Text",
 CellChangeTimes->{{3.994950807461975*^9, 
  3.9949508112315865`*^9}},ExpressionUUID->"1e8d78e7-e19a-6a4b-8ca5-\
aa1d3024acf4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "@", 
    RowBox[{"Eigenvalues", "[", "werner", "]"}]}], ",", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{"And", "@@", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"Eigenvalues", "[", "werner", "]"}], ">=", "0"}], "]"}]}], ",",
      "\[FormalLambda]", ",", "Reals"}], "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.994950140128229*^9, 3.994950140128229*^9}, 
   3.9949540505131035`*^9},
 CellLabel->
  "In[187]:=",ExpressionUUID->"1fc37523-7165-954c-9b92-99afb3cfe56b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{"1", "-", "\[FormalLambda]"}], "4"], ",", 
     FractionBox[
      RowBox[{"1", "-", "\[FormalLambda]"}], "4"], ",", 
     FractionBox[
      RowBox[{"1", "-", "\[FormalLambda]"}], "4"], ",", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"3", " ", "\[FormalLambda]"}]}], ")"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "3"]}], "\[LessEqual]", "\[FormalLambda]", "\[LessEqual]",
     "1"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9949501414095707`*^9, 3.9949540517015057`*^9},
 CellLabel->
  "Out[187]=",ExpressionUUID->"2b8f8191-40e2-f145-a838-a30db06d4e13"]
}, Open  ]],

Cell["\<\
Transposing the second qubit alone moves one eigenvalue against the other \
three:\
\>", "Text",
 CellChangeTimes->{{3.9949508522932835`*^9, 
  3.994950853702795*^9}},ExpressionUUID->"316037c5-412b-3a43-bd5b-\
fd69f62cc267"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "@", 
  RowBox[{"Eigenvalues", "@", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"werner", ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9949501516579037`*^9, 3.9949501521377125`*^9}},
 CellLabel->
  "In[188]:=",ExpressionUUID->"39b75655-80c9-484a-b3f4-3a00209791af"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox["1", "4"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"3", " ", "\[FormalLambda]"}]}], ")"}]}], ",", 
   FractionBox[
    RowBox[{"1", "+", "\[FormalLambda]"}], "4"], ",", 
   FractionBox[
    RowBox[{"1", "+", "\[FormalLambda]"}], "4"], ",", 
   FractionBox[
    RowBox[{"1", "+", "\[FormalLambda]"}], "4"]}], "}"}]], "Output",
 CellChangeTimes->{3.9949501526877804`*^9, 3.9949540586380806`*^9},
 CellLabel->
  "Out[188]=",ExpressionUUID->"ce65e608-d784-864b-938f-1bbb7db826ab"]
}, Open  ]],

Cell["The threshold is where that eigenvalue turns negative:", "Text",
 CellChangeTimes->{{3.994950868656786*^9, 
  3.9949508696387386`*^9}},ExpressionUUID->"847bd8e0-2d3c-7443-9169-\
389d91903111"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Min", "[", 
      RowBox[{"Eigenvalues", "@", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{
           RowBox[{"ArrayReshape", "[", 
            RowBox[{"werner", ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], "]"}], "<", "0"}], "&&", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "/", "3"}], "<=", "\[FormalLambda]", "<=", "1"}]}], 
   ",", "\[FormalLambda]", ",", "Reals"}], "]"}]], "Input",
 CellChangeTimes->{{3.9949501691085567`*^9, 3.9949501696387157`*^9}},
 CellLabel->
  "In[153]:=",ExpressionUUID->"dc679099-eb25-0c4f-8949-668af9014f71"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "3"], "<", "\[FormalLambda]", "\[LessEqual]", 
  "1"}]], "Output",
 CellChangeTimes->{3.994950170498659*^9},
 CellLabel->
  "Out[153]=",ExpressionUUID->"115be26c-a535-334e-9e97-0823748d54c7"]
}, Open  ]],

Cell["\<\
The concurrence is an exact measure rather than a criterion, so it locates \
the same point and also says how much entanglement survives above it:\
\>", "Text",
 CellChangeTimes->{{3.9949508916240196`*^9, 
  3.9949509028849335`*^9}},ExpressionUUID->"aefa7079-6128-0342-bf73-\
c1567706b83f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"y", "=", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"PauliMatrix", "[", "2", "]"}], ",", 
       RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"0", ",", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"Max", "[", "#", "]"}]}], "-", 
          RowBox[{"Total", "[", "#", "]"}]}]}], "]"}], "&"}], "@", 
      RowBox[{"Sqrt", "@", 
       RowBox[{"Simplify", "@", 
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"werner", ".", "y", ".", 
          RowBox[{"Conjugate", "[", "werner", "]"}], ".", "y"}], "]"}]}]}]}], 
     ",", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "/", "3"}], "<=", "\[FormalLambda]", "<=", "1"}]}],
     "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9949501875024567`*^9, 3.994950187962593*^9}},
 CellLabel->
  "In[169]:=",ExpressionUUID->"46e28f1a-b4cd-ca4f-8b71-6fd6b3d06092"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\[Piecewise]", GridBox[{
       {
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{"3", " ", "\[FormalLambda]"}]}], ")"}]}], 
        RowBox[{
         RowBox[{"3", " ", "\[FormalLambda]"}], ">", "1"}]},
       {"0", 
        TagBox["True",
         "PiecewiseDefault",
         AutoDelete->True]}
      },
      AllowedDimensions->{2, Automatic},
      Editable->True,
      GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
      GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.84]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}},
      Selectable->True]}
   },
   GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
   GridBoxSpacings->{"Columns" -> {
       Offset[0.27999999999999997`], {
        Offset[0.35]}, 
       Offset[0.27999999999999997`]}, "Rows" -> {
       Offset[0.2], {
        Offset[0.4]}, 
       Offset[0.2]}}],
  "Piecewise",
  DeleteWithContents->True,
  Editable->False,
  SelectWithContents->True,
  Selectable->False,
  StripWrapperBoxes->True]], "Output",
 CellChangeTimes->{3.994950188490944*^9, 3.994950905084467*^9},
 CellLabel->
  "Out[169]=",ExpressionUUID->"13625853-8437-c94b-84a2-b5c7b64a0e1e"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9949493079637527`*^9, 
  3.994949311212862*^9}},ExpressionUUID->"1f5a1841-1683-ae43-877e-\
0ba4504d1f82"],

Cell[TextData[{
 "QF uses the following convention\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Rho]", "W", "QF"], "(", "p", ")"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}], Cell[
       "|",ExpressionUUID->"7aa4b66c-f9c4-9d4c-9163-25bb681b09ce"], 
       SuperscriptBox["\[Psi]", "-"], Cell[
       "\[RightAngleBracket]",ExpressionUUID->
        "829d3e57-4cad-bd40-9ad3-f60693863625"], Cell[
       "\[LeftAngleBracket]",ExpressionUUID->
        "d6a200a1-e1d9-f141-8500-cdf2b97197dc"], 
       SuperscriptBox["\[Psi]", "-"], Cell[
       "|",ExpressionUUID->"c8a6c0c6-37d1-8b44-bf9f-52b6837dbce9"]}], "+", 
      RowBox[{
       RowBox[{"p", "/", "3"}], 
       RowBox[{"(", 
        RowBox[{"I", "-", 
         RowBox[{
         Cell["|",ExpressionUUID->"903c7da8-afaf-9f44-a071-ed270b96645e"], 
          SuperscriptBox["\[Psi]", "-"], Cell[
          "\[RightAngleBracket]",ExpressionUUID->
           "eb148507-bd0e-c342-ac12-6a617635b963"], Cell[
          "\[LeftAngleBracket]",ExpressionUUID->
           "fdf1ddb7-d452-f449-996e-2843d518d265"], 
          SuperscriptBox["\[Psi]", "-"], Cell[
          "|",ExpressionUUID->"b085a48b-31d0-0c43-80cd-9f222abb6f9e"]}]}], 
        ")"}], "      ", "with", "   ", "0"}]}], "\[LessEqual]", "p", "\[LessEqual]",
      "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a73b8d22-e9c7-2747-b4f3-e72aac9884ff"]
}], "Text",
 CellChangeTimes->{{3.9949542322091866`*^9, 3.994954313663618*^9}, {
  3.9949545312815742`*^9, 3.994954550771641*^9}, {3.994954706085943*^9, 
