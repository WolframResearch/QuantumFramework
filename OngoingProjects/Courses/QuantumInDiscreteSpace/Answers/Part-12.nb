Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"QuantumPartialTrace", "[", 
     RowBox[{"purified", ",", 
      RowBox[{"{", "2", "}"}]}], "]"}], ",", 
    RowBox[{
     RowBox[{"0", "<", "\[FormalR]", "<", "1"}], "&&", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[FormalPhi]", ",", "\[FormalTheta]"}], "}"}], ",", 
       "Reals"}], "]"}]}]}], "]"}], "==", "qs"}]], "Input",
 CellChangeTimes->{{3.9949622189515553`*^9, 3.994962311856285*^9}, {
  3.994962429952585*^9, 3.994962430773573*^9}},
 CellLabel->
  "In[237]:=",ExpressionUUID->"603711a2-9965-e348-aefb-3a3f03b27216"],

