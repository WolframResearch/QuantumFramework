Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"op1", " ", "=", 
  RowBox[{"QuantumOperator", "@", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", "#", ",", 
        RowBox[{"Conjugate", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
     RowBox[{"Pick", "[", 
      RowBox[{
       RowBox[{"Sequence", "@@", 
        RowBox[{"Reverse", "[", 
         RowBox[{"state", "[", "\"\<Eigensystem\>\"", "]"}], "]"}]}], ",", 
       RowBox[{"x_", "/;", 
        RowBox[{"x", ">", "0"}]}]}], "]"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9953891977725735`*^9, 3.995389199596157*^9}, {
