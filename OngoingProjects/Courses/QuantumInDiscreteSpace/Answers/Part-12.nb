Cell[TextData[{
 "The two thresholds ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "=", 
    RowBox[{"1", "/", "3"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8104e8bf-dd8b-624d-9fc5-661ff441012a"],
 "and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", 
    RowBox[{"1", "/", "2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7182a435-8d43-e247-af67-e37f3c92e77e"],
 "  are the same physical point, since the conversion carries one inequality \
onto the other a singlet tolerates white noise up to two thirds of the total \
weight, and no further."
}], "Text",
 CellChangeTimes->{{3.994955299528805*^9, 3.9949553559445114`*^9}, 
   3.9949555215467815`*^9, {3.994955620565424*^9, 
   3.994955620947071*^9}},ExpressionUUID->"c090948e-b498-7c4f-9199-\
f19a6dcfda94"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
12.2 [BSc] How do I purify a mixed state and recover it by partial trace?\
\>", "Subsection",
 CellChangeTimes->{
  3.9949600626135216`*^9},ExpressionUUID->"de51f511-c4ff-644b-ba56-\
98225089e2f8"],

Cell[TextData[{
 "A mixed state is what a pure state looks like when part of the world is out \
of view, and purification makes that literal: adjoin an ancilla ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],ExpressionUUID->
  "725ce12b-62f9-7245-96ec-8b0391e7ad9d"],
 " and produce a pure |",
 Cell[BoxData[
  FormBox["\[Psi]", TraditionalForm]],ExpressionUUID->
  "52b7dabb-1455-064d-9936-f11d431f857b"],
 "\[RightAngleBracket] on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", " ", "B"}], TraditionalForm]],ExpressionUUID->
  "e09dc40f-9aa0-d745-982d-640038f552fa"],
 " whose reduced state on ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "d29e23b6-1890-6a47-a096-52a1c8ba2459"],
 " is the \[Rho] we started with. Writing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "=", 
    RowBox[{
     SubscriptBox["\[Sum]", 
      RowBox[{" ", "i"}]], " ", 
     RowBox[{
      SubscriptBox["p", "i"], Cell[
      "|",ExpressionUUID->"68ad0064-e672-8f4c-b70f-2a3588697b51"], 
      SubscriptBox["e", "i"], Cell[
      "\[RightAngleBracket]",ExpressionUUID->
       "53c134ba-3214-6943-9b0c-a06c15a3db74"], Cell[
      "\[LeftAngleBracket]",ExpressionUUID->
       "e174235c-e4d1-1745-9820-52ba47c3a0a9"], 
      SubscriptBox["e", "i"], Cell[
      "|",ExpressionUUID->"0e59ff00-fd0f-e845-b06d-1c8dbc021525"]}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "74982211-d9c0-b747-9fdd-b3270a1fcaba"],
 " the vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
    Cell["|",ExpressionUUID->"e3832d86-707a-ef47-9f9c-b69e53d44cf2"], 
     "\[Psi]", Cell[
     "\[RightAngleBracket]",ExpressionUUID->
      "69757d50-35e1-7948-a46a-f711d1de9f52"]}], "=", " ", 
    RowBox[{
     SubscriptBox["\[Sum]", 
      RowBox[{" ", "i", "  "}]], 
     RowBox[{
      SqrtBox[
       SubscriptBox["p", "i"]], Cell[
      "|",ExpressionUUID->"0cd2b3cd-697f-ab44-b730-0749a3bccfe0"], 
      SubscriptBox["e", "i"], Cell[TextData[Cell[BoxData[
       FormBox[
        RowBox[{
         RowBox[{
          SubscriptBox["\[RightAngleBracket]", "A"], "\[CircleTimes]", " ", 
          Cell["|",ExpressionUUID->"ee83a14c-a398-c840-8833-7cd11397f6ba"]}], 
         "i", 
         SubscriptBox[Cell[
          "\[RightAngleBracket]",ExpressionUUID->
           "4f3aaf30-e440-ab43-879d-10c1b393f8d3"], "B"]}], TraditionalForm]],
       FormatType->TraditionalForm,ExpressionUUID->
       "298e8ad1-00b9-c24b-b69a-219758b4cba1"]],ExpressionUUID->
       "06ae2ef1-b009-8f42-bc3d-d908bc130394"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "94773764-82ed-2340-bb2b-2f342be308ec"],
 " is pure and tracing out ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cc7e454b-c9e7-a948-b820-bdffe29f912c"],
 " against the orthonormal \n\[Divides]i",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\:27e9", "B"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1dc2c96d-d45e-7c4f-997f-03c704f947a2"],
 "  returns each and nothing else, so the ancilla needs only as many \
dimensions as \[Rho] has nonzero eigenvalues. Take the generic mixed qubit in \
Bloch form,  the unit vector at angles (\[Theta],\[CurlyPhi]) its eigenvalues \
are (1\[PlusMinus]r)/2, so one ancilla qubit is enough."
}], "Text",
 CellChangeTimes->{{3.99496254171056*^9, 3.9949626663915157`*^9}, {
   3.9949627287252846`*^9, 3.994962823893242*^9}, {3.99496286241609*^9, 
   3.994962930884493*^9}, {3.9949629764496574`*^9, 3.9949630345307465`*^9}, {
   3.9949630685017166`*^9, 3.9949631313786583`*^9}, 
   3.99496324683745*^9},ExpressionUUID->"5f12c2f4-13c7-4844-8f3c-\
80987742801d"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9949624597185383`*^9, 
  3.9949624610512943`*^9}},ExpressionUUID->"7ffa7edc-9f38-694f-baee-\
ccdc08ed9adc"],

Cell["\<\
 The state with the Bloch vector split into its length and its direction:\
\>", "Text",
 CellChangeTimes->{{3.9949635447619324`*^9, 
  3.994963552628523*^9}},ExpressionUUID->"35e32898-2cd4-784c-a6a2-\
a37991f2cd10"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rho", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"nvec", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
         RowBox[{"Cos", "[", "\[FormalPhi]", "]"}]}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[FormalPhi]", "]"}]}], ",", 
        RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}], "}"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
       RowBox[{"\[FormalR]", " ", 
        RowBox[{"nvec", ".", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}]}], ")"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.994963276181427*^9, 3.994963276181427*^9}},
 CellLabel->
  "In[249]:=",ExpressionUUID->"1297813f-7626-2644-afda-c085397b3343"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"\[FormalR]", " ", 
         RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}]}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", "2"], " ", "\[FormalR]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "\[FormalPhi]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[FormalPhi]", "]"}]}]}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", "\[FormalR]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "\[FormalPhi]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}]}], "+", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[FormalPhi]", "]"}]}]}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"\[FormalR]", " ", 
         RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}]}], ")"}]}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.994963277903988*^9, 3.994963555761879*^9},
 CellLabel->
  "Out[249]=",ExpressionUUID->"68dd6c2d-7c5c-aa48-b16d-41c9452c322b"]
}, Open  ]],

Cell[TextData[{
 "Its eigenvectors are the spin-up and spin-down states along  ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "^"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e48e4fd5-6c9e-e744-961e-ee115295dc75"],
 ", orthonormal, and weighting their projectors by (1\[PlusMinus]r)/2 \
rebuilds \[Rho]:"
}], "Text",
 CellChangeTimes->{{3.9949634979792976`*^9, 
  3.994963530694065*^9}},ExpressionUUID->"45e87c9e-51bd-044c-9dcb-\
08ead511b79f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"up", ",", "down"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", 
        FractionBox["\[FormalTheta]", "2"], "]"}], ",", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"\[ImaginaryI]", " ", "\[FormalPhi]"}], "]"}], " ", 
        RowBox[{"Sin", "[", 
         FractionBox["\[FormalTheta]", "2"], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "\[FormalPhi]"}], "]"}]}], " ", 
        RowBox[{"Sin", "[", 
         FractionBox["\[FormalTheta]", "2"], "]"}]}], ",", 
       RowBox[{"Cos", "[", 
        FractionBox["\[FormalTheta]", "2"], "]"}]}], "}"}]}], "}"}]}], ";", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", "up", "]"}], ".", "up"}], ",", 
      RowBox[{
       RowBox[{"Conjugate", "[", "down", "]"}], ".", "down"}], ",", 
      RowBox[{
       RowBox[{"Conjugate", "[", "up", "]"}], ".", "down"}], ",", 
      RowBox[{"rho", "\[Equal]", 
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "\[FormalR]"}], ")"}], " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"up", ",", 
           RowBox[{"Conjugate", "[", "up", "]"}]}], "]"}]}], "+", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", "\[FormalR]"}], ")"}], " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"down", ",", 
           RowBox[{"Conjugate", "[", "down", "]"}]}], "]"}]}]}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], "\[Element]", 
     TemplateBox[{},
      "Reals"]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9949632864537716`*^9, 3.9949632864537716`*^9}, {
  3.99496334031238*^9, 3.994963362047533*^9}},
 CellLabel->
  "In[248]:=",ExpressionUUID->"2009b0a5-3a8e-7641-86d1-6fb817de6ccc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "1", ",", "0", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.9949632881609783`*^9, 3.9949633551761703`*^9, 
  3.9949635355044327`*^9},
 CellLabel->
  "Out[248]=",ExpressionUUID->"9914a54c-d7db-e947-929e-7637327699ad"]
}, Open  ]],

Cell["\<\
Pairing each eigenvector with its own ancilla ket, amplitudes the square \
roots of the eigenvalues, gives the purification:\
\>", "Text",
 CellChangeTimes->{{3.994963482180601*^9, 
  3.9949634850235195`*^9}},ExpressionUUID->"b8222c47-8ef5-f94e-8a3b-\
d29225c5bf05"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"psi", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      SqrtBox[
       FractionBox[
        RowBox[{"1", "+", "\[FormalR]"}], "2"]], " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"up", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}]}], "]"}], "]"}]}], "+", 
     RowBox[{
      SqrtBox[
       FractionBox[
        RowBox[{"1", "-", "\[FormalR]"}], "2"]], " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"down", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}], "]"}], "]"}]}]}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], "\[Element]", 
     TemplateBox[{},
      "Reals"]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9949633213472385`*^9, 3.9949633452534733`*^9}},
 CellLabel->
  "In[244]:=",ExpressionUUID->"b1e5782a-e3dc-8644-b6fb-dbf5edda7ba1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{
     SqrtBox[
      RowBox[{"1", "+", "\[FormalR]"}]], " ", 
     RowBox[{"Cos", "[", 
      FractionBox["\[FormalTheta]", "2"], "]"}]}], 
    SqrtBox["2"]], ",", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      SqrtBox[
       RowBox[{"1", "-", "\[FormalR]"}]], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[FormalPhi]"}]], " ", 
      RowBox[{"Sin", "[", 
       FractionBox["\[FormalTheta]", "2"], "]"}]}], 
     SqrtBox["2"]]}], ",", 
   FractionBox[
    RowBox[{
     SqrtBox[
      RowBox[{"1", "+", "\[FormalR]"}]], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "\[FormalPhi]"}]], " ", 
     RowBox[{"Sin", "[", 
      FractionBox["\[FormalTheta]", "2"], "]"}]}], 
    SqrtBox["2"]], ",", 
   FractionBox[
    RowBox[{
     SqrtBox[
      RowBox[{"1", "-", "\[FormalR]"}]], " ", 
     RowBox[{"Cos", "[", 
      FractionBox["\[FormalTheta]", "2"], "]"}]}], 
    SqrtBox["2"]]}], "}"}]], "Output",
 CellChangeTimes->{3.9949633221176357`*^9, 3.994963352882736*^9},
 CellLabel->
  "Out[244]=",ExpressionUUID->"38b3dd1b-ff73-1e43-aa58-596c24f93cb9"]
}, Open  ]],

Cell["\<\
It is a unit vector, and contracting the ancilla index against itself returns \
the original state exactly:\
\>", "Text",
 CellChangeTimes->{{3.994963470857231*^9, 
  3.9949634720491314`*^9}},ExpressionUUID->"a81ec175-0433-1843-93b0-\
3e2a98b78f9d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Conjugate", "[", "psi", "]"}], ".", "psi"}], ",", 
     RowBox[{
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"TensorContract", "[", 
         RowBox[{
          RowBox[{"ArrayReshape", "[", 
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"psi", ",", 
              RowBox[{"Conjugate", "[", "psi", "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "]"}], "\[Equal]", "rho"}]}], 
    "}"}], ",", 
   RowBox[{
    RowBox[{"0", "\[LessEqual]", "\[FormalR]", "\[LessEqual]", "1"}], "&&", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], "\[Element]", 
     TemplateBox[{},
      "Reals"]}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9949633312982025`*^9, 3.9949633485741024`*^9}},
 CellLabel->
  "In[243]:=",ExpressionUUID->"bd4db51c-60d2-b041-814b-43f6c8f4820b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{{3.994963332373646*^9, 3.994963350817728*^9}},
 CellLabel->
  "Out[243]=",ExpressionUUID->"49450b94-72e1-1143-a036-49d01dc50350"]
}, Open  ]],

Cell["\<\
Tracing the other way leaves the ancilla in a state carrying the same \
spectrum, so whatever mixedness \[Rho] has is shared symmetrically across the \
cut:\
\>", "Text",
 CellChangeTimes->{{3.9949634504699783`*^9, 
  3.9949634579864902`*^9}},ExpressionUUID->"4d952f63-be82-974a-9aa4-\
2ba9d4ffeb2a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Eigenvalues", "@", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"TensorContract", "[", 
         RowBox[{
          RowBox[{"ArrayReshape", "[", 
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"psi", ",", 
              RowBox[{"Conjugate", "[", "psi", "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3"}], "}"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"Element", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], ",", 
        "Reals"}], "]"}]}], "]"}]}], ",", 
   RowBox[{"0", "<=", "\[FormalR]", "<=", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.994963392753731*^9, 3.994963392753731*^9}},
 CellLabel->
  "In[246]:=",ExpressionUUID->"7a533b30-cb65-7a45-8ef7-62a426804536"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"1", "-", "\[FormalR]"}], "2"], ",", 
   FractionBox[
    RowBox[{"1", "+", "\[FormalR]"}], "2"]}], "}"}]], "Output",
 CellChangeTimes->{3.994963394720377*^9},
 CellLabel->
