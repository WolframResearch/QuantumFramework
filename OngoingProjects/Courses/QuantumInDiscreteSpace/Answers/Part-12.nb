Cell["\<\
Collecting those twelve values, the framework route reaches the same \
correspondence on its own: full column rank recovers the state from them, and \
against the four basis constraints the counting closes as before:\
\>", "Text",
 CellChangeTimes->{{3.9954578180054455`*^9, 
  3.9954578192836494`*^9}},ExpressionUUID->"1d286655-1e65-9641-a336-\
56842db5c506"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"pars", "=", 
      RowBox[{"{", 
       RowBox[{
       "\[FormalA]", ",", "\[FormalB]", ",", "\[FormalC]", ",", "\[FormalD]", 
        ",", "\[FormalE]", ",", "\[FormalF]", ",", "\[FormalG]", ",", 
        "\[FormalH]"}], "}"}]}], ",", 
     RowBox[{"cons", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Boole", "[", 
         RowBox[{"MemberQ", "[", 
          RowBox[{"b", ",", "v"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "mubs"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"v", ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{"mubs", ",", "1"}], "]"}]}], "}"}]}], "]"}]}]}], "}"}], ",", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"matQF", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Outer", "[", 
          RowBox[{"D", ",", "fvQF", ",", "pars"}], "]"}], ",", 
         RowBox[{"Element", "[", 
          RowBox[{"pars", ",", "Reals"}], "]"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"MatrixRank", "[", "matQF", "]"}], ",", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"LinearSolve", "[", 
           RowBox[{"matQF", ",", 
            RowBox[{
             RowBox[{"Flatten", "[", "diags", "]"}], "-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Flatten", "[", "diags", "]"}], "/.", " ", 
               RowBox[{"Thread", "[", 
                RowBox[{"pars", "->", "0"}], "]"}]}], ")"}]}]}], "]"}], "==", 
          "pars"}], ",", 
         RowBox[{"Element", "[", 
          RowBox[{"pars", ",", "Reals"}], "]"}]}], "]"}], ",", 
       RowBox[{"Length", "@", 
        RowBox[{"NullSpace", "[", "cons", "]"}]}], ",", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"cons", ".", "matQF"}], "==", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "8"}], "}"}]}], "]"}]}], "]"}]}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.99545779636602*^9, 3.9954578051824093`*^9}, {
  3.99545786428911*^9, 3.995457939691208*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"34c6ed3b-7975-714f-9989-fe482b53d53a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"8", ",", "True", ",", "8", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{
  3.9954578061449127`*^9, 3.9954578687675953`*^9, {3.9954579163296604`*^9, 
   3.9954579400561924`*^9}},
 CellLabel->"Out[21]=",ExpressionUUID->"b33cdfe2-ae19-e54a-b0e2-d192ea740920"]
}, Open  ]],

Cell["\<\
The frame condition costs nothing to satisfy from a density operator, the sum \
over a basis equals as an identity in nine arbitrary vector components, so \
once the basis is complete the sum is Tr\[Rho]=1 and orthonormality enters at \
exactly one point. The reverse direction is Gleason\[CloseCurlyQuote]s \
theorem, but its uniqueness half is a finite computation: the four mutually \
unbiased bases come back orthonormal, complete, and pairwise overlapping at \
1/3 , and the twelve frame values they produce are affine in the eight \
parameters with a 12\[Times]8 coefficient matrix of rank 8, so LinearSolve \
inverts it and returns the parameters exactly hence the map from density \
operators to frame functions is injective\
\>", "Text",
 CellChangeTimes->{{3.9954580202225895`*^9, 
  3.9954580650779343`*^9}},ExpressionUUID->"3dc3e001-fb37-634b-9146-\
d0e720511047"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "12.8b [MSc] Why does the qubit ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fc31e42b-32c7-b544-a19a-db22b1b3e106"],
 " fail Gleason and instead need the POVM (Busch) version?"
}], "Subsection",
 CellChangeTimes->{{3.9953957041173935`*^9, 
  3.995395724850275*^9}},ExpressionUUID->"409bca7c-f0c8-8342-9fef-\
bc204ed38c7b"],

Cell[TextData[{
 "Gleason\[CloseCurlyQuote]s rigidity is geometric, and the Bloch picture \
shows where it comes from. A measurement\[CloseCurlyQuote]s outcomes are \
points on the surface of the generalized Bloch ball, and the frame condition \
says the probabilities attached to them sum to one. For a qubit a projective \
measurement is a pair of antipodal points, so a rule depending on the state \
only through the scalar product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["r", "\[RightVector]"], "\[CenterDot]", " ", 
    OverscriptBox["n", "^"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2abab171-cf4d-f04c-a5ea-180d7e079e3b"],
 "  faces one equation relating ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "^"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ccd1fb37-06fe-6d40-a8ea-ea41678c2c84"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    OverscriptBox["n", "^"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "edb21fc3-5011-1942-baca-b5587b636b7f"],
 " and nothing else.  Every odd deviation from linearity survives that, \
continuity included, so there are infinitely many non-Born rules. From  d=3 \
upward the eigenprojectors of a measurement are the vertices of a regular \
simplex inscribed in the ball, N of them at once, and requiring N \
probabilities to sum to one at every simplex is a far stronger functional \
constraint:  it forces linearity in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["r", "\[RightVector]"], "\[CenterDot]", " ", 
    OverscriptBox["n", "^"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c0540df6-20c3-ce45-ae06-ea150a77b523"],
 " , which is the Born rule. Busch\[CloseCurlyQuote]s theorem repairs the \
qubit by admitting POVMs, whose outcomes need not come in antipodal pairs, so \
a qubit inherits the same three-outcome constraint that a qutrit has for \
free. Below, a rule is a function ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8133969c-de6c-4b47-8a34-bb1b6a51f898"],
 " applied to outcome probabilities, and the question is which ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "de8212f8-af9b-d348-a619-257d099c1acc"],
 " survives additivity"
}], "Text",
 CellChangeTimes->{{3.9954513586326637`*^9, 3.995451417766577*^9}, {
  3.995467101049389*^9, 
  3.9954672888534203`*^9}},ExpressionUUID->"46f1c2a6-d46f-e24f-8ffd-\
1093a4ec4c9b"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.995458236816099*^9, 
  3.995458239590145*^9}},ExpressionUUID->"97ce8c7a-f636-6a4a-9024-\
2c4732befef5"],

Cell[TextData[{
 "Take the smoothstep ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "s", ")"}], "=", 
    RowBox[{
     RowBox[{"3", 
      SuperscriptBox["s", "2"]}], "-", 
     RowBox[{"2", 
      SuperscriptBox["s", "3"], " "}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "34ff570c-819a-2b45-9d51-4728a43d9650"],
 ". It respects the two-outcome constraint exactly, and it is a legitimate \
probability assignment inside \n[0,1] and increasing, so nothing pathological \
is being smuggled in:"
}], "Text",
 CellChangeTimes->{{3.9954675089023895`*^9, 
  3.9954675571198406`*^9}},ExpressionUUID->"4bcb0130-df7f-d34b-b781-\
b4d2e29dfd65"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "\[FormalS]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"3", " ", 
     SuperscriptBox["\[FormalS]", "2"]}], "-", 
    RowBox[{"2", " ", 
     SuperscriptBox["\[FormalS]", "3"]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"g", "[", "\[FormalP]", "]"}], "+", 
      RowBox[{"g", "[", 
       RowBox[{"1", "-", "\[FormalP]"}], "]"}]}], "\[Equal]", "1"}], "]"}], ",", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[ForAll]", 
       RowBox[{"\[FormalP]", ",", 
        RowBox[{"0", "\[LessEqual]", "\[FormalP]", "\[LessEqual]", "1"}]}]], 
      RowBox[{"0", "\[LessEqual]", 
       RowBox[{"g", "[", "\[FormalP]", "]"}], "\[LessEqual]", "1"}]}], ",", 
     TemplateBox[{},
      "Reals"]}], "]"}], ",", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[ForAll]", 
       RowBox[{"\[FormalP]", ",", 
        RowBox[{"0", "\[LessEqual]", "\[FormalP]", "\[LessEqual]", "1"}]}]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "\[FormalS]"], 
          RowBox[{"g", "[", "\[FormalS]", "]"}]}], "/.", "\[VeryThinSpace]", 
         RowBox[{"\[FormalS]", "\[Rule]", "\[FormalP]"}]}], ")"}], "\[GreaterEqual]",
        "0"}]}], ",", 
     TemplateBox[{},
      "Reals"]}], "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.995467561485058*^9, 3.995467572747629*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"d55d77cd-d836-0c42-8f3c-b1227731706a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.9954675734060955`*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"43309ca8-e1b0-ca42-b873-ab8076495df5"]
}, Open  ]],

Cell["\<\
It is nevertheless not the Born rule, agreeing with it at three isolated \
points and nowhere else:\
\>", "Text",
 CellChangeTimes->{{3.995467580878395*^9, 
  3.995467582131716*^9}},ExpressionUUID->"85495a33-11ad-204f-bbbd-\
900c83bd41eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", "\[FormalP]", "]"}], "\[Equal]", "\[FormalP]"}], "&&", 
    RowBox[{"0", "\[LessEqual]", "\[FormalP]", "\[LessEqual]", "1"}]}], ",", 
   "\[FormalP]", ",", 
   TemplateBox[{},
    "Reals"]}], "]"}]], "Input",
 CellChangeTimes->{{3.9954675868420906`*^9, 3.995467589822956*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"044ba067-a2ea-1644-a0c1-7a738dc023e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[FormalP]", "\[Equal]", "0"}], "||", 
  RowBox[{"\[FormalP]", "\[Equal]", 
   FractionBox["1", "2"]}], "||", 
  RowBox[{"\[FormalP]", "\[Equal]", "1"}]}]], "Output",
 CellChangeTimes->{{3.9954675880075016`*^9, 3.995467604633505*^9}},
 CellLabel->"Out[28]=",ExpressionUUID->"c4190be6-6117-954c-a787-f754da7f3e12"]
}, Open  ]],

Cell["\<\
Three outcomes destroy it. Additivity over a triple summing to one holds only \
where one of the probabilities vanishes, that is on the boundary, and at the \
centre it returns 7/9 instead of 1:\
\>", "Text",
 CellChangeTimes->{{3.9954676356965637`*^9, 
  3.9954676530415154`*^9}},ExpressionUUID->"49046e3a-bf67-d043-adc7-\
faf7bf95f6e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"g", "[", "\[FormalU]", "]"}], "+", 
      RowBox[{"g", "[", "\[FormalV]", "]"}], "+", 
      RowBox[{"g", "[", 
       RowBox[{"1", "-", "\[FormalU]", "-", "\[FormalV]"}], "]"}]}], "==", 
     "1"}], "]"}], ",", 
   RowBox[{"3", " ", 
    RowBox[{"g", "[", 
     RowBox[{"1", "/", "3"}], "]"}]}]}], "}"}]], "Input",
 CellChangeTimes->{{3.99546760744895*^9, 3.995467608418844*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"3d8eaf38-6ca1-6240-ad4d-0e100dc3d130"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"\[FormalU]", " ", "\[FormalV]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "\[FormalU]", "+", "\[FormalV]"}], ")"}]}], "\[Equal]",
     "0"}], ",", 
   FractionBox["7", "9"]}], "}"}]], "Output",
 CellChangeTimes->{3.995467608830948*^9, 3.9954676557188835`*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"913348b7-6439-3a45-a7c6-144bb171269a"]
}, Open  ]],

Cell["\<\
What three outcomes leave standing is exactly the affine rules, and an \
impossible outcome must be assigned zero, which fixes the remaining freedom \
and returns the Born rule:\
\>", "Text",
 CellChangeTimes->{{3.9954676815497913`*^9, 
  3.99546770851832*^9}},ExpressionUUID->"41f5f37a-da80-3e4e-be7f-\
00dea9d3900d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[ForAll]", 
       RowBox[{"{", 
        RowBox[{"\[FormalU]", ",", "\[FormalV]"}], "}"}]], 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[FormalA]", "+", 
          RowBox[{"\[FormalB]", " ", "\[FormalU]"}]}], ")"}], "+", 
        RowBox[{"(", 
         RowBox[{"\[FormalA]", "+", 
          RowBox[{"\[FormalB]", " ", "\[FormalV]"}]}], ")"}], "+", 
        RowBox[{"(", 
         RowBox[{"\[FormalA]", "+", 
          RowBox[{"\[FormalB]", " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", "\[FormalU]", "-", "\[FormalV]"}], ")"}]}]}], 
         ")"}]}], "\[Equal]", "1"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[FormalA]", ",", "\[FormalB]"}], "}"}], ",", 
     TemplateBox[{},
      "Reals"]}], "]"}], ",", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[FormalB]", "\[Equal]", 
       RowBox[{"1", "-", 
        RowBox[{"3", " ", "\[FormalA]"}]}]}], "&&", 
      RowBox[{"\[FormalA]", "\[Equal]", "0"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[FormalA]", ",", "\[FormalB]"}], "}"}], ",", 
     TemplateBox[{},
      "Reals"]}], "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.9954676714240036`*^9, 3.9954676732475452`*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"2ef89b47-a4ff-b547-84f3-d48e57b57dc1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[FormalB]", "\[Equal]", 
    RowBox[{"1", "-", 
     RowBox[{"3", " ", "\[FormalA]"}]}]}], ",", 
   RowBox[{
    RowBox[{"\[FormalA]", "\[Equal]", "0"}], "&&", 
    RowBox[{"\[FormalB]", "\[Equal]", "1"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.995467674220396*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"66092eff-ee7d-7040-abb0-a4d646ba0ddf"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9954582451843224`*^9, 
  3.995458248035839*^9}},ExpressionUUID->"fd2518c6-63f1-af4b-934d-\
176891103d64"],

Cell["\<\
A qubit can be given three outcomes without leaving dimension two, by \
measuring a POVM instead of a basis. Three coplanar directions at furnish \
one, and the framework recognizes it as such:\
\>", "Text",
 CellChangeTimes->{{3.9954685472490387`*^9, 
  3.9954685613155193`*^9}},ExpressionUUID->"3fdac4df-aa82-5541-9fe3-\
f0f4e21d2027"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"trine", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sin", "[", 
        FractionBox[
         RowBox[{"2", " ", "\[Pi]", " ", "k"}], "3"], "]"}], ",", "0", ",", 
       RowBox[{"Cos", "[", 
        FractionBox[
         RowBox[{"2", " ", "\[Pi]", " ", "k"}], "3"], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eff", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox["2", "3"], " ", 
       RowBox[{
        RowBox[{"QuantumState", "[", 
         RowBox[{"\"\<BlochVector\>\"", "[", "#1", "]"}], "]"}], 
        "[", "\"\<DensityMatrix\>\"", "]"}]}], "&"}], ")"}], "/@", 
    "trine"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qmo", "=", 
     RowBox[{"QuantumMeasurementOperator", "[", "eff", "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"qmo", "[", "\"\<POVMQ\>\"", "]"}], ",", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"qmo", "[", 
         RowBox[{"QuantumState", "[", 
          RowBox[{"\"\<BlochVector\>\"", "[", 
           RowBox[{"{", 
            RowBox[{"\[FormalX]", ",", "\[FormalY]", ",", "\[FormalZ]"}], 
            "}"}], "]"}], "]"}], "]"}], "[", "\"\<ProbabilitiesList\>\"", 
        "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9954677328348503`*^9, 3.9954677552549114`*^9}, {
  3.995468678133438*^9, 3.9954686823338203`*^9}, {3.9954691666917*^9, 
  3.9954691934571095`*^9}},
 CellLabel->"In[92]:=",ExpressionUUID->"b22f6840-0af2-8945-8155-9b31df4a8b6d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "1"}], "}"}]], "Output",
 CellChangeTimes->{3.995468653530905*^9, 3.9954692001120205`*^9},
 CellLabel->"Out[94]=",ExpressionUUID->"5a370dac-08f7-af4e-8ac3-52f0d53de354"]
}, Open  ]],

Cell["\<\
On the maximally mixed qubit its three outcomes are equally likely, the Born \
values sum to one, and the smooth-step rule does not:\
\>", "Text",
 CellChangeTimes->{{3.9954692286718636`*^9, 
  3.9954692396088905`*^9}},ExpressionUUID->"6f059cb0-0fa3-ad43-9813-\
39b78d56eef6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mm", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"QuantumMeasurementOperator", "[", "eff", "]"}], "[", 
       RowBox[{"QuantumState", "[", "\"\<UniformMixture\>\"", "]"}], "]"}], 
      "[", "\"\<ProbabilitiesList\>\"", "]"}]}], "}"}], ",", 
   RowBox[{"Simplify", "@", 
    RowBox[{"{", 
     RowBox[{"mm", ",", 
      RowBox[{"Total", "@", "mm"}], ",", 
      RowBox[{"Total", "[", 
       RowBox[{"g", "/@", "mm"}], "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9954678630144424`*^9, 3.9954678739378586`*^9}, {
  3.9954684955386753`*^9, 3.9954685150401917`*^9}},
 CellLabel->"In[62]:=",ExpressionUUID->"51e9ecd0-0652-7846-bee8-284819b804ac"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", "3"], ",", 
     FractionBox["1", "3"], ",", 
     FractionBox["1", "3"]}], "}"}], ",", "1", ",", 
   FractionBox["7", "9"]}], "}"}]], "Output",
 CellChangeTimes->{3.995467760157398*^9, 3.9954678798821697`*^9, 
  3.9954685160046444`*^9},
 CellLabel->"Out[62]=",ExpressionUUID->"922b851c-884b-da4b-99de-1e55245dc00f"]
}, Open  ]],

Cell["\<\
A qutrit needs no POVM for this: an ordinary basis already gives three \
outcomes, and re-expressing the maximally mixed state in one produces the \
same three probabilities and the same failure:\
\>", "Text",
 CellChangeTimes->{{3.9954692520512905`*^9, 
  3.9954692538550873`*^9}},ExpressionUUID->"13a3dc23-35cd-1f41-bef4-\
51fc3e63a1c8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"qb", " ", "=", 
   RowBox[{"QuantumBasis", "[", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"w", "=", 
        RowBox[{"Exp", "[", 
         FractionBox[
          RowBox[{"2", " ", "\[Pi]", " ", "\[ImaginaryI]"}], "3"], "]"}]}], 
       "}"}], ",", 
      RowBox[{"Array", "[", 
       RowBox[{
        RowBox[{
         FractionBox[
          SuperscriptBox["w", 
           RowBox[{
            SuperscriptBox["#1", "2"], "+", 
            RowBox[{"#2", " ", "#1"}]}]], 
          SqrtBox["3"]], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "3"}], "}"}], ",", "0"}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Comap", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Total", ",", 
     RowBox[{"Total", "@*", "g"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"\"\<UniformMixture\>\"", ",", "qb"}], "]"}], 
    "[", "\"\<ProbabilityList\>\"", "]"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9954681824506416`*^9, 3.9954682051347046`*^9}, {
  3.995468243771343*^9, 3.9954682456177673`*^9}, {3.9954684510215187`*^9, 
  3.995468458923643*^9}},
 CellLabel->"In[95]:=",ExpressionUUID->"395e279d-7b92-204d-8eab-8f688f7c82fc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", 
   FractionBox["7", "9"]}], "}"}]], "Output",
 CellChangeTimes->{3.99546845942091*^9, 3.9954692560858974`*^9},
 CellLabel->"Out[96]=",ExpressionUUID->"f59ef276-d030-1042-9afe-e56250319968"]
}, Open  ]]
}, Open  ]]
},
WindowSize->{1141.2, 568.8},
WindowMargins->{{0, Automatic}, {Automatic, 0}},
