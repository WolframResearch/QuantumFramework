  InterpretationBox[
   TooltipBox[
    StyleBox[
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SqrtBox[
             RowBox[{"\[FormalR]", "+", "1"}]], "-", 
            SqrtBox[
             RowBox[{"1", "-", "\[FormalR]"}]]}], ")"}], " ", 
          RowBox[{"cos", "(", "\[FormalTheta]", ")"}]}], "+", 
         SqrtBox[
          RowBox[{"1", "-", "\[FormalR]"}]], "+", 
         SqrtBox[
          RowBox[{"\[FormalR]", "+", "1"}]]}], 
        RowBox[{"2", " ", 
         SqrtBox["2"]}]], 
       FormBox[
        InterpretationBox[
         StyleBox[
          TemplateBox[{
            RowBox[{
              FormBox["0", TraditionalForm], "\[InvisibleSpace]", 
              FormBox["0", TraditionalForm]}]},
           "Ket"],
          FontWeight->"Plain"],
         Wolfram`QuantumFramework`QuditName[{0, 0}, "Dual" -> False]],
        TraditionalForm]}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "\[FormalPhi]"}]], " ", 
         RowBox[{"(", 
          RowBox[{
           SqrtBox[
            RowBox[{"\[FormalR]", "+", "1"}]], "-", 
           SqrtBox[
            RowBox[{"1", "-", "\[FormalR]"}]]}], ")"}], " ", 
         RowBox[{"sin", "(", "\[FormalTheta]", ")"}]}], 
        RowBox[{"2", " ", 
         SqrtBox["2"]}]], 
       FormBox[
        InterpretationBox[
         StyleBox[
          TemplateBox[{
