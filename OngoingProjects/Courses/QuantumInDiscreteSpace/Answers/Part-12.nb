Cell[CellGroupData[{

Cell["\<\
12.8a [MSc] How do I verify Gleason\[CloseCurlyQuote]s frame-function \
constraint for a qutrit (d\[GreaterEqual]3), that every frame function is 
\:27e8\[Psi]\[Divides]\[Rho]\[Divides]\[Psi]\:27e9 for some density operator \
\[Rho]?\
\>", "Subsection",
 CellChangeTimes->{{3.9953956087895966`*^9, 
  3.9953956309455395`*^9}},ExpressionUUID->"bf65696c-66da-4649-8871-\
c9aa89b7d7ec"],

Cell["\<\
A frame function assigns a number f(\[Psi])\[Element][0,1] to every unit \
vector, subject to one rule, over any orthonormal basis the values sum to 1. \
No linearity is assumed, only that constraint, repeated for every basis at \
once. Gleason\[CloseCurlyQuote]s theorem says that for d\[GreaterEqual]3 this \
forces  f(\[Psi])=\:27e8\[Psi]\[Divides]\[Rho]\[Divides]\[Psi]\:27e9 for a \
unique density operator, so the Born rule is not an extra postulate but the \
only consistent way to put probabilities on subspaces. One direction is a \
short calculation and is done below; the converse is the theorem and is \
quoted. What can be settled here besides the easy direction is that the \
correspondence is one-to-one and already saturated by finitely many bases: in 
d=3 four mutually unbiased bases give twelve numbers, and those pin down all \
nine real parameters of \[Rho].\
\>", "Text",
 CellChangeTimes->{{3.995451787568569*^9, 
  3.9954518388191433`*^9}},ExpressionUUID->"fcce8f32-c399-0e4d-b9f7-\
18f5a0c1ae26"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.995450826122612*^9, 
  3.995450827396839*^9}},ExpressionUUID->"5a6a5160-fb69-0140-9157-\
656e487e3698"],

Cell["\<\
 A generic qutrit density operator, Hermitian with unit trace by construction:\
\>", "Text",
 CellChangeTimes->{{3.995449074862631*^9, 
  3.9954490928625183`*^9}},ExpressionUUID->"69ad33fd-5d71-e449-8b70-\
6c2310410952"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"rho", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[FormalA]", ",", 
       RowBox[{"\[FormalB]", "+", 
        RowBox[{"I", " ", "\[FormalC]"}]}], ",", 
       RowBox[{"\[FormalD]", "+", 
        RowBox[{"I", " ", "\[FormalE]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[FormalB]", "-", 
        RowBox[{"I", " ", "\[FormalC]"}]}], ",", "\[FormalF]", ",", 
       RowBox[{"\[FormalG]", "+", 
        RowBox[{"I", " ", "\[FormalH]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[FormalD]", "-", 
        RowBox[{"I", " ", "\[FormalE]"}]}], ",", 
       RowBox[{"\[FormalG]", "-", 
        RowBox[{"I", " ", "\[FormalH]"}]}], ",", 
       RowBox[{"1", "-", "\[FormalA]", "-", "\[FormalF]"}]}], "}"}]}], 
    "}"}]}], ";", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"rho", "==", 
       RowBox[{"ConjugateTranspose", "[", "rho", "]"}]}], ",", 
      RowBox[{"Tr", "[", "rho", "]"}]}], "}"}], ",", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[FormalA]", ",", "\[FormalB]", ",", "\[FormalC]", ",", "\[FormalD]", 
        ",", "\[FormalE]", ",", "\[FormalF]", ",", "\[FormalG]", ",", 
        "\[FormalH]"}], "}"}], ",", "Reals"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.995449061447098*^9, 3.9954490624924984`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"fd345008-b4cc-6d4f-a66c-6a7c0e993115"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "1"}], "}"}]], "Output",
 CellChangeTimes->{3.995449063621847*^9, 3.99544910454253*^9, 
  3.9954519274449863`*^9, 3.9954555172256413`*^9, 3.995457601154606*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"9f9f51f0-b3ac-6749-b92d-42be37e2a89c"]
}, Open  ]],

Cell[TextData[{
 "The Born values sum over a basis to the trace of \[Rho] against  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sum]", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b67f374c-d816-b94f-a0c9-854c21a5647c"],
 " |",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Epsilon]", "i"], "\[RightAngleBracket]"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7159fcaa-b735-134c-a6a5-609ad26ae711"],
 "\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6df33df6-a1d8-8f4e-81a3-488866ef5915"],
 "|, for any three vectors, orthonormal or not. So the frame condition is \
nothing but completeness of the basis:"
}], "Text",
 CellChangeTimes->{{3.9954491293622894`*^9, 
  3.9954492028645706`*^9}},ExpressionUUID->"090755d2-1906-6140-8fab-\
46e4a49c2fd2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ev", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\[FormalW]", ",", "##"}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", 
          RowBox[{"ev", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], ".", "rho", ".", 
         RowBox[{"ev", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "3"}], "}"}]}], "]"}], "]"}], "==", 
     RowBox[{"Tr", "[", 
      RowBox[{"rho", ".", 
       RowBox[{"Total", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"ev", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"Conjugate", "[", 
             RowBox[{"ev", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "3"}], "}"}]}], "]"}], "]"}]}], "]"}]}], "]"}]}],
   "]"}]], "Input",
 CellChangeTimes->{{3.995449109932663*^9, 3.9954491133727818`*^9}, 
   3.995455513312435*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"7872f89d-ac72-5147-9b92-ae899f812c0b"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.995449116492914*^9, 3.9954492049146748`*^9, 
  3.995455518789652*^9, 3.995457603123184*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"48faf9e2-cd63-454b-9a55-59525ad83399"]
}, Open  ]],

Cell["\<\
Four mutually unbiased bases exist in dimension three, built from powers of a \
cube root of unity alongside the computational basis. Each is orthonormal and \
complete, and vectors drawn from different bases overlap with the same \
modulus, which is what makes the four of them together informationally \
complete.\
\>", "Text",
 CellChangeTimes->{
  3.9954493349533863`*^9},ExpressionUUID->"b88f3a48-de2e-a344-aef2-\
8ec617c47a67"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"mubs", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"w", "=", 
       RowBox[{"Exp", "[", 
        FractionBox[
         RowBox[{"2", " ", "\[Pi]", " ", "\[ImaginaryI]"}], "3"], "]"}]}], 
      "}"}], ",", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          FractionBox[
           SuperscriptBox["w", 
            RowBox[{
             RowBox[{"#1", " ", 
              SuperscriptBox["#3", "2"]}], "+", 
             RowBox[{"#2", " ", "#3"}]}]], 
           SqrtBox["3"]], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "3", ",", "3"}], "}"}], ",", "0"}], "]"}], ",", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}], "]"}]}], ";", 
  RowBox[{"Simplify", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", "b", "]"}], ".", 
         RowBox[{"Transpose", "[", "b", "]"}]}], "\[Equal]", 
        RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", "mubs"}], "}"}]}], "]"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"#1", ",", 
              RowBox[{"Conjugate", "[", "#1", "]"}]}], "]"}], "&"}], ")"}], "/@",
           "b"}], "]"}], "\[Equal]", 
        RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", "mubs"}], "}"}]}], "]"}], ",", 
     RowBox[{"Union", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Conjugate", "[", 
             RowBox[{"mubs", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "r"}], "\[RightDoubleBracket]"}], "]"}], ".", 
            RowBox[{"mubs", "\[LeftDoubleBracket]", 
             RowBox[{"j", ",", "s"}], "\[RightDoubleBracket]"}]}], "]"}], 
          "2"], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"i", "+", "1"}], ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "3"}], "}"}]}], "]"}], "]"}], "]"}]}], "}"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9954492104956074`*^9, 3.995449211344797*^9}, 
   3.9954495293363056`*^9, 3.9954508849056377`*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"32acfe4d-b3bb-4344-a7a2-cf0ae61c07df"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"True", ",", "True", ",", "True", ",", "True"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"True", ",", "True", ",", "True", ",", "True"}], "}"}], ",", 
   RowBox[{"{", 
    FractionBox["1", "3"], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9954492120688457`*^9, 3.9954495356959057`*^9, 
  3.995450893613842*^9, 3.9954576041102486`*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"40dcfcce-7486-8341-a559-769d5e20afb5"]
}, Open  ]],

Cell["\<\
The frame function on those twelve vectors is affine in the eight parameters, \
and the coefficient matrix has full column rank, so the values determine the \
state and no two density operators can share a frame function:\
\>", "Text",
 CellChangeTimes->{{3.995449665628456*^9, 
  3.9954496727006702`*^9}},ExpressionUUID->"04d9a8ee-8e6b-bb43-9cee-\
be37bb717029"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"pars", "=", 
      RowBox[{"{", 
       RowBox[{
       "\[FormalA]", ",", "\[FormalB]", ",", "\[FormalC]", ",", "\[FormalD]", 
        ",", "\[FormalE]", ",", "\[FormalF]", ",", "\[FormalG]", ",", 
        "\[FormalH]"}], "}"}]}], ",", 
     RowBox[{"fv", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", "v", "]"}], ".", "rho", ".", "v"}], ",", 
        RowBox[{"{", 
         RowBox[{"v", ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{"mubs", ",", "1"}], "]"}]}], "}"}]}], "]"}]}]}], "}"}], ",", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mat", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Outer", "[", 
          RowBox[{"D", ",", "fv", ",", "pars"}], "]"}], ",", 
         RowBox[{"pars", "\[Element]", 
          TemplateBox[{},
           "Reals"]}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Dimensions", "[", "mat", "]"}], ",", 
       RowBox[{"MatrixRank", "[", "mat", "]"}], ",", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"fv", "\[Equal]", 
          RowBox[{
           RowBox[{"mat", ".", "pars"}], "+", 
           RowBox[{"(", 
            RowBox[{"fv", "/.", "\[VeryThinSpace]", 
             RowBox[{"Thread", "[", 
              RowBox[{"pars", "\[Rule]", "0"}], "]"}]}], ")"}]}]}], ",", 
         RowBox[{"pars", "\[Element]", 
          TemplateBox[{},
           "Reals"]}]}], "]"}], ",", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"LinearSolve", "[", 
           RowBox[{"mat", ",", 
            RowBox[{"fv", "-", 
             RowBox[{"(", 
              RowBox[{"fv", "/.", "\[VeryThinSpace]", 
               RowBox[{"Thread", "[", 
                RowBox[{"pars", "\[Rule]", "0"}], "]"}]}], ")"}]}]}], "]"}], "\[Equal]",
           "pars"}], ",", 
         RowBox[{"pars", "\[Element]", 
          TemplateBox[{},
           "Reals"]}]}], "]"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.995449574914446*^9, 3.995449574914446*^9}, 
   3.995450800509552*^9, {3.9954508756200867`*^9, 3.995450879571789*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"d0bb535a-375d-4d45-9428-cecba102d217"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"12", ",", "8"}], "}"}], ",", "8", ",", "True", ",", "True"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.995449579632641*^9, 3.9954508012742977`*^9, 
  3.995450880886305*^9, 3.9954519475913486`*^9, 3.9954576060960293`*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"c4757f8c-1193-6141-9122-0c4e79a7212f"]
}, Open  ]],

Cell["\<\
That settles injectivity. The Gleason direction, that nothing but a density \
operator produces a frame function, is a counting statement once the vectors \
are a fixed finite set. On the twelve vectors above the constraint is four \
equations, one per basis, so the assignments satisfying it form an affine \
space of dimension  12\[Minus]4=8. The Born assignments already live in that \
space and their linear part has rank 8, so the two coincide and there is no \
room left for anything else.\
\>", "Text",
 CellChangeTimes->{{3.995455585505131*^9, 
  3.9954555969199104`*^9}},ExpressionUUID->"e5a4bc42-2af3-4043-b761-\
bd80c105af7d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"vecs", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"mubs", ",", "1"}], "]"}]}], ",", 
     RowBox[{"pars", "=", 
      RowBox[{"{", 
       RowBox[{
       "\[FormalA]", ",", "\[FormalB]", ",", "\[FormalC]", ",", "\[FormalD]", 
        ",", "\[FormalE]", ",", "\[FormalF]", ",", "\[FormalG]", ",", 
        "\[FormalH]"}], "}"}]}]}], "}"}], ",", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cons", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Boole", "[", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"b", ",", "v"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"b", ",", "mubs"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "vecs"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"fv", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Conjugate", "[", "v", "]"}], ".", "rho", ".", "v"}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "vecs"}], "}"}]}], "]"}]}]}], "}"}], ",", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mat", "=", 
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{"Outer", "[", 
            RowBox[{"D", ",", "fv", ",", "pars"}], "]"}], ",", 
           RowBox[{"Element", "[", 
            RowBox[{"pars", ",", "Reals"}], "]"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Dimensions", "[", "cons", "]"}], ",", 
