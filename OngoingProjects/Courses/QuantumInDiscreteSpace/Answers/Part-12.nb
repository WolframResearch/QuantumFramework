  "In[207]:=",ExpressionUUID->"81b9ffc9-9ff5-a943-9c25-55ffac12f7ab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "-", "\[FormalP]"}], ",", 
   FractionBox["\[FormalP]", "3"], ",", 
   FractionBox["\[FormalP]", "3"], ",", 
   FractionBox["\[FormalP]", "3"]}], "}"}]], "Output",
