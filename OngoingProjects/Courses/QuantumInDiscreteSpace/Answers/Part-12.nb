Cell["\<\
\[OpenCurlyDoubleQuote]VonNeumannEntropy\[CloseCurlyDoubleQuote] is a \
Quantity carrying its unit, and it counts in bits, so it is the WL entropy \
divided by log2:\
\>", "Text",
 CellChangeTimes->{{3.9951326417529163`*^9, 
  3.995132649072838*^9}},ExpressionUUID->"3ea4733e-15b7-5d47-b94f-\
0fdcb2fd6a0a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gq", "[", "\"\<VonNeumannEntropy\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.995132430445345*^9, 3.9951324314101105`*^9}},
 CellLabel->
  "In[205]:=",ExpressionUUID->"03bba5d3-7016-9041-af96-7fad29921598"],

Cell[BoxData[
 TemplateBox[{
   RowBox[{"-", 
     FractionBox[
      RowBox[{
        RowBox[{"Log", "[", 
          FractionBox["1", 
           RowBox[{"1", "+", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"\[FormalB]", " ", "\[FormalW]"}]]}]], "]"}], "+", 
        RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"\[FormalB]", " ", "\[FormalW]"}]], " ", 
          RowBox[{"Log", "[", 
            FractionBox[
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"\[FormalB]", " ", "\[FormalW]"}]], 
             RowBox[{"1", "+", 
               SuperscriptBox["\[ExponentialE]", 
                RowBox[{"\[FormalB]", " ", "\[FormalW]"}]]}]], "]"}]}]}], 
      RowBox[{
        RowBox[{"Log", "[", "2", "]"}], "+", 
        RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"\[FormalB]", " ", "\[FormalW]"}]], " ", 
          RowBox[{"Log", "[", "2", "]"}]}]}]]}], "\"b\"", "bits", "\"Bits\""},
  "Quantity"]], "Output",
 CellChangeTimes->{
  3.9951324320303917`*^9, {3.9951327386043453`*^9, 3.9951327579002514`*^9}, 
   3.9951331923187656`*^9},
 CellLabel->
  "Out[205]=",ExpressionUUID->"2d9bff5e-b650-7249-b2c4-6d9ec76fd2e4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"QuantityMagnitude", "[", "%", "]"}], "+", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", " ", 
        RowBox[{"Log", "[", "#", "]"}]}], "&"}], "/@", 
      RowBox[{"Eigenvalues", "[", "gibbs", "]"}]}], "]"}], "/", 
    RowBox[{"Log", "[", "2", "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.995132725813946*^9, 3.995132763837839*^9}, {
  3.995133185960432*^9, 3.9951331863543587`*^9}},
 CellLabel->
