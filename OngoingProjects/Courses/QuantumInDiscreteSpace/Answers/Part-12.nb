           "Ket"],
          FontWeight->"Plain"],
         Wolfram`QuantumFramework`QuditName[{0, 1}, "Dual" -> False]],
        TraditionalForm], 
       RowBox[{"-", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"\[ImaginaryI]", " ", "\[FormalPhi]"}]], " ", 
          RowBox[{"(", 
           RowBox[{
            SqrtBox[
             RowBox[{"1", "-", "\[FormalR]"}]], "-", 
            SqrtBox[
             RowBox[{"\[FormalR]", "+", "1"}]]}], ")"}], " ", 
          RowBox[{"sin", "(", "\[FormalTheta]", ")"}]}], 
         RowBox[{"2", " ", 
          SqrtBox["2"]}]]}], 
       FormBox[
        InterpretationBox[
         StyleBox[
          TemplateBox[{
            RowBox[{
              FormBox["1", TraditionalForm], "\[InvisibleSpace]", 
              FormBox["0", TraditionalForm]}]},
           "Ket"],
          FontWeight->"Plain"],
         Wolfram`QuantumFramework`QuditName[{1, 0}, "Dual" -> False]],
        TraditionalForm]}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SqrtBox[
             RowBox[{"1", "-", "\[FormalR]"}]], "-", 
            SqrtBox[
             RowBox[{"\[FormalR]", "+", "1"}]]}], ")"}], " ", 
          RowBox[{"cos", "(", "\[FormalTheta]", ")"}]}], "+", 
         SqrtBox[
          RowBox[{"1", "-", "\[FormalR]"}]], "+", 
         SqrtBox[
          RowBox[{"\[FormalR]", "+", "1"}]]}], 
        RowBox[{"2", " ", 
         SqrtBox["2"]}]], 
       FormBox[
        InterpretationBox[
         StyleBox[
          TemplateBox[{
            RowBox[{
              FormBox["1", TraditionalForm], "\[InvisibleSpace]", 
              FormBox["1", TraditionalForm]}]},
           "Ket"],
          FontWeight->"Plain"],
         Wolfram`QuantumFramework`QuditName[{1, 1}, "Dual" -> False]],
        TraditionalForm]}]}],
     ShowStringCharacters->False],
    TagBox[
     GridBox[{{
        RowBox[{"\"I\"", "\[CircleTimes]", "\"I\""}]}, {
        TemplateBox[{"\"QuantumState: \"", 
          RowBox[{
            RowBox[{"{", "}"}], "\[Rule]", 
            RowBox[{"{", 
              RowBox[{"2", ",", "2"}], "}"}]}]}, "RowDefault"]}}, 
      GridBoxAlignment -> {"Columns" -> {{Center}}}, DefaultBaseStyle -> 
      "Column", 
      GridBoxItemSize -> {
       "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"]],
   Wolfram`QuantumFramework`QuantumState[
   SparseArray[
    Automatic, {4}, 0, {
     1, {{0, 4}, {{1}, {2}, {3}, {4}}}, {
      Rational[1, 2] 
       2^Rational[-1, 2] ((1 - \[FormalR])^Rational[1, 2] + (1 + \[FormalR])^
         Rational[
          1, 2] + (-(1 - \[FormalR])^Rational[1, 2] + (1 + \[FormalR])^
           Rational[1, 2]) Cos[\[FormalTheta]]), Rational[1, 2] 
       2^Rational[-1, 2] (-(1 - \[FormalR])^Rational[1, 2] + (1 + \[FormalR])^
         Rational[1, 2]) E^(Complex[0, -1] \[FormalPhi]) Sin[\[FormalTheta]], 
       Rational[-1, 2] 
       2^Rational[-1, 2] ((1 - \[FormalR])^Rational[1, 2] - (1 + \[FormalR])^
        Rational[1, 2]) E^(Complex[0, 1] \[FormalPhi]) Sin[\[FormalTheta]], 
       Rational[1, 2] 
       2^Rational[-1, 2] ((1 - \[FormalR])^Rational[1, 2] + (1 + \[FormalR])^
         Rational[1, 2] + ((1 - \[FormalR])^Rational[1, 2] - (1 + \[FormalR])^
          Rational[1, 2]) Cos[\[FormalTheta]])}}], 
    Wolfram`QuantumFramework`QuantumBasis[<|
     "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
           
