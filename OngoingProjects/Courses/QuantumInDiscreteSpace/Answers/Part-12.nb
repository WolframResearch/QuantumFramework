Cell[TextData[{
 "The two-level Gibbs state is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "/", "2"}], 
    RowBox[{"(", 
     RowBox[{"I", "-", 
      RowBox[{
       RowBox[{"tanh", "(", 
        RowBox[{"\[Beta]", " ", 
         RowBox[{"\[Omega]", "/", "2"}]}], ")"}], 
       RowBox[{
        OverscriptBox["n", "^"], "\[CenterDot]", " ", 
        OverscriptBox["\[Sigma]", "\[RightVector]"]}]}]}], ")"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9e724576-ebc5-9e42-a4dc-2afe5780fe7f"],
 ", verified as an identity for every axis and temperature, so the whole \
thermal family is the segment of the Bloch line along ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "^"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "35c0bfdb-b0be-6447-b51a-35a6fb0109fa"],
 " of length tanh(\[Beta]\[Omega]/2). The minus sign is Boltzmann weighting,  \
population accumulates on the lower level, opposite the field. The partition \
function is \nZ=2cosh(\[Beta]\[Omega]/2), and the mean energy  \:27e8H\:27e9= \
-\[Omega]/2 tanh(\[Beta]\[Omega]/2) arrives identically from the trace Tr[H\
\[Rho]] and from \[Minus]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[PartialD]", "\[Beta]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "43a2584d-4f34-9c46-a74c-9d179d26ac2c"],
 " logZ"
}], "Text",
 CellChangeTimes->{{3.9951332324692783`*^9, 
  3.9951334667065125`*^9}},ExpressionUUID->"23ba2cf5-d212-9f42-ad47-\
ad6911e8d749"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
12.5 [BSc] How do I compare two states by trace distance and (pure-state) \
fidelity?\
\>", "Subsection",
 CellChangeTimes->{
  3.9951342253156815`*^9},ExpressionUUID->"d663ecae-8be9-2540-99ae-\
963c6ff25fcc"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9953645238411083`*^9, 
  3.995364526176565*^9}},ExpressionUUID->"a81d96f8-97da-cc49-a8e3-\
2b9e9252a3af"],

Cell["\<\
Two generic mixed qubits, each carrying its own Bloch vector:\
\>", "Text",
 CellChangeTimes->{{3.9953643907136345`*^9, 
  3.995364398947733*^9}},ExpressionUUID->"bae9c9b4-8a1a-a54a-963a-\
5eebf0a34f8f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"rho1", ",", "rho2"}], "}"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
       RowBox[{"#", ".", 
        RowBox[{"PauliMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], ")"}]}], "&"}],
    "/@", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[FormalX]", ",", "\[FormalY]", ",", "\[FormalZ]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[FormalU]", ",", "\[FormalV]", ",", "\[FormalW]"}], "}"}]}], 
    "}"}]}]}]], "Input",
 CellChangeTimes->{{3.9953643516735077`*^9, 3.9953643523675575`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"8025b157-b766-b84e-886e-ac0774d1d567"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        RowBox[{"1", "+", "\[FormalZ]"}], "2"], ",", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"\[FormalX]", "-", 
          RowBox[{"\[ImaginaryI]", " ", "\[FormalY]"}]}], ")"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"\[FormalX]", "+", 
          RowBox[{"\[ImaginaryI]", " ", "\[FormalY]"}]}], ")"}]}], ",", 
       FractionBox[
        RowBox[{"1", "-", "\[FormalZ]"}], "2"]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        RowBox[{"1", "+", "\[FormalW]"}], "2"], ",", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"\[FormalU]", "-", 
          RowBox[{"\[ImaginaryI]", " ", "\[FormalV]"}]}], ")"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"\[FormalU]", "+", 
          RowBox[{"\[ImaginaryI]", " ", "\[FormalV]"}]}], ")"}]}], ",", 
       FractionBox[
        RowBox[{"1", "-", "\[FormalW]"}], "2"]}], "}"}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9953643530088882`*^9, 3.9953644017804184`*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"becaab0b-1186-d448-8cd1-11e89fb43f50"]
}, Open  ]],

Cell["\<\
The difference of two states is traceless, so its two eigenvalues are equal \
and opposite and the trace norm collapses to the length of the Bloch \
separation:\
\>", "Text",
 CellChangeTimes->{{3.995364427285446*^9, 
  3.995364428845644*^9}},ExpressionUUID->"28a117a7-67c0-484d-b330-\
13a7c2ffeb18"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{"rho1", "-", "rho2"}], "]"}], "]"}], "]"}], "/", "2"}], "==", 
    RowBox[{
     RowBox[{"EuclideanDistance", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[FormalX]", ",", "\[FormalY]", ",", "\[FormalZ]"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[FormalU]", ",", "\[FormalV]", ",", "\[FormalW]"}], "}"}]}],
       "]"}], "/", "2"}]}], ",", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[FormalX]", ",", "\[FormalY]", ",", "\[FormalZ]", ",", "\[FormalU]", ",",
        "\[FormalV]", ",", "\[FormalW]"}], "}"}], ",", "Reals"}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9953643615640926`*^9, 3.995364362104107*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"a803f721-bf12-5845-b108-abd9607a5bf4"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9953643644292088`*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"a643b043-c90d-424e-8e24-5cb04a30c1d2"]
}, Open  ]],

Cell["\<\
Now to consider pure-state fidelity, we drop to two generic pure qubits. \
Their squared overlap is fixed by the angle between their Bloch vectors \
alone, the phases cancelling:\
\>", "Text",
 CellChangeTimes->{{3.9953644387444344`*^9, 3.9953644413379593`*^9}, {
  3.995364508926214*^9, 
  3.9953645172459736`*^9}},ExpressionUUID->"c0372035-503c-8541-a963-\
dbee4063a618"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ComplexExpand", "[", 
     SuperscriptBox[
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"Conjugate", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", 
            FractionBox["\[FormalT]", "2"], "]"}], ",", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{"\[ImaginaryI]", " ", "\[FormalP]"}], "]"}], " ", 
            RowBox[{"Sin", "[", 
             FractionBox["\[FormalT]", "2"], "]"}]}]}], "}"}], "]"}], ".", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", 
           FractionBox["\[FormalA]", "2"], "]"}], ",", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"\[ImaginaryI]", " ", "\[FormalB]"}], "]"}], " ", 
           RowBox[{"Sin", "[", 
            FractionBox["\[FormalA]", "2"], "]"}]}]}], "}"}]}], "]"}], "2"], 
     "]"}], "\[Equal]", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "\[FormalT]", "]"}], " ", 
           RowBox[{"Cos", "[", "\[FormalP]", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", "\[FormalT]", "]"}], " ", 
           RowBox[{"Sin", "[", "\[FormalP]", "]"}]}], ",", 
          RowBox[{"Cos", "[", "\[FormalT]", "]"}]}], "}"}], ".", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "\[FormalA]", "]"}], " ", 
           RowBox[{"Cos", "[", "\[FormalB]", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", "\[FormalA]", "]"}], " ", 
           RowBox[{"Sin", "[", "\[FormalB]", "]"}]}], ",", 
          RowBox[{"Cos", "[", "\[FormalA]", "]"}]}], "}"}]}]}], ")"}]}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[FormalT]", ",", "\[FormalP]", ",", "\[FormalA]", ",", "\[FormalB]"}], 
     "}"}], "\[Element]", 
    TemplateBox[{},
     "Reals"]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9951353207040215`*^9, 3.9951353211372566`*^9}, {
  3.995364411985033*^9, 3.9953644164058704`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"d2061325-4a31-7845-8bfd-70617a7a5d4b"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.995135321730915*^9, 3.99536441328561*^9, 
  3.9953644437906513`*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"05a6095d-f6dd-5a48-bab9-66b3e43db408"]
}, Open  ]],

Cell["\<\
On the Bloch sphere the two measures are then locked together, since a chord \
and the angle it subtends carry the same information:\
\>", "Text",
 CellChangeTimes->{{3.995364467290123*^9, 
  3.995364469594963*^9}},ExpressionUUID->"ece3f576-d70b-0c4c-8b20-\
5034574a9b39"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"EuclideanDistance", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", "\[FormalT]", "]"}], " ", 
          RowBox[{"Cos", "[", "\[FormalP]", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "\[FormalT]", "]"}], " ", 
          RowBox[{"Sin", "[", "\[FormalP]", "]"}]}], ",", 
         RowBox[{"Cos", "[", "\[FormalT]", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", "\[FormalA]", "]"}], " ", 
          RowBox[{"Cos", "[", "\[FormalB]", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "\[FormalA]", "]"}], " ", 
          RowBox[{"Sin", "[", "\[FormalB]", "]"}]}], ",", 
         RowBox[{"Cos", "[", "\[FormalA]", "]"}]}], "}"}]}], "]"}]}], "\[Equal]", 
    SqrtBox[
     RowBox[{"1", "-", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Sin", "[", "\[FormalT]", "]"}], " ", 
             RowBox[{"Cos", "[", "\[FormalP]", "]"}]}], ",", 
            RowBox[{
             RowBox[{"Sin", "[", "\[FormalT]", "]"}], " ", 
             RowBox[{"Sin", "[", "\[FormalP]", "]"}]}], ",", 
            RowBox[{"Cos", "[", "\[FormalT]", "]"}]}], "}"}], ".", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Sin", "[", "\[FormalA]", "]"}], " ", 
             RowBox[{"Cos", "[", "\[FormalB]", "]"}]}], ",", 
            RowBox[{
             RowBox[{"Sin", "[", "\[FormalA]", "]"}], " ", 
             RowBox[{"Sin", "[", "\[FormalB]", "]"}]}], ",", 
            RowBox[{"Cos", "[", "\[FormalA]", "]"}]}], "}"}]}]}], 
        ")"}]}]}]]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[FormalT]", ",", "\[FormalP]", ",", "\[FormalA]", ",", "\[FormalB]"}], 
     "}"}], "\[Element]", 
    TemplateBox[{},
     "Reals"]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9951353264153557`*^9, 3.995135327796425*^9}, {
  3.9953644532345905`*^9, 3.9953644552746487`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"a66ab441-c332-a14a-998b-b8a15774bc66"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.995135329130039*^9, 3.9953644607783012`*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"2547e85c-2360-404f-acc2-360747c08d4d"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.995364545817009*^9, 
  3.9953645478050785`*^9}},ExpressionUUID->"fbed1ee5-3f7f-2c44-a3d7-\
97c66f92e513"],

Cell["\<\
QuantumDistance takes the measure as a third argument, where the trace \
distance is named \[OpenCurlyDoubleQuote]Trace\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]Bloch\[CloseCurlyDoubleQuote] is the Bloch-vector \
separation. For a qubit those are the same number:\
\>", "Text",
 CellChangeTimes->{{3.995364552930273*^9, 
  3.9953645573525734`*^9}},ExpressionUUID->"45598b12-4937-254e-bfbc-\
99ca172f495d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"q1", ",", "q2"}], "}"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"\"\<BlochVector\>\"", "[", "#1", "]"}], "]"}], "&"}], ")"}], "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[FormalX]", ",", "\[FormalY]", ",", "\[FormalZ]"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[FormalU]", ",", "\[FormalV]", ",", "\[FormalW]"}], "}"}]}], 
     "}"}]}]}], ";", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"QuantumDistance", "[", 
        RowBox[{"q1", ",", "q2", ",", "\"\<Trace\>\""}], "]"}], "\[Equal]", 
       RowBox[{"QuantumDistance", "[", 
        RowBox[{"q1", ",", "q2", ",", "\"\<Bloch\>\""}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"QuantumDistance", "[", 
        RowBox[{"q1", ",", "q2", ",", "\"\<Trace\>\""}], "]"}], "\[Equal]", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"EuclideanDistance", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[FormalX]", ",", "\[FormalY]", ",", "\[FormalZ]"}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[FormalU]", ",", "\[FormalV]", ",", "\[FormalW]"}], 
           "}"}]}], "]"}]}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[FormalX]", ",", "\[FormalY]", ",", "\[FormalZ]", ",", "\[FormalU]", ",",
        "\[FormalV]", ",", "\[FormalW]"}], "}"}], "\[Element]", 
     TemplateBox[{},
      "Reals"]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9951353348608685`*^9, 3.99513533557193*^9}, 
   3.995364577121166*^9},
 CellLabel->"In[9]:=",ExpressionUUID->"b488a40b-dd46-014d-b295-08b707d19679"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.995135340396328*^9, 3.9953645718869057`*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"c0010e0d-41dc-ea40-92a8-ca93dbdaf4f4"]
}, Open  ]],

Cell["\<\
For two pure qubits a common unitary rotates one to the north pole and the \
other into the  x-z plane, so a single angle \[Theta] between the Bloch \
vectors carries everything. Three numbers, three different conventions:\
\>", "Text",
 CellChangeTimes->{{3.995364589741678*^9, 
  3.9953646057348824`*^9}},ExpressionUUID->"1cc9e507-7408-8942-a232-\
5fe3e78649c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p1", ",", "p2"}], "}"}], "=", 
   RowBox[{"QuantumState", "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[FormalT]", "/", "2"}], "]"}], ",", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[FormalT]", "/", "2"}], "]"}]}], "}"}]}], "}"}]}]}], ";", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"QuantumSimilarity", "[", 
       RowBox[{"p1", ",", "p2", ",", "\"\<Fidelity\>\""}], "]"}], ",", 
      RowBox[{"QuantumDistance", "[", 
       RowBox[{"p1", ",", "p2"}], "]"}], ",", 
      RowBox[{"QuantumDistance", "[", 
       RowBox[{"p1", ",", "p2", ",", "\"\<Trace\>\""}], "]"}]}], "}"}], ",", 
    RowBox[{"0", "<=", "\[FormalT]", "<=", "Pi"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9951353486223984`*^9, 3.9951353490366535`*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"d43a436a-36fb-e441-a3b4-dec76ae7d378"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Cos", "[", 
    FractionBox["\[FormalT]", "2"], "]"}], ",", 
   RowBox[{"2", " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", 
      FractionBox["\[FormalT]", "4"], "]"}], "2"]}], ",", 
   RowBox[{"Sin", "[", 
    FractionBox["\[FormalT]", "2"], "]"}]}], "}"}]], "Output",
 CellChangeTimes->{3.995135350394499*^9, 3.9953646087698727`*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"3dfd3732-d719-9345-9bf0-ad141e0f4d7c"]
}, Open  ]],

Cell[TextData[{
 "The first is ",
 Cell[BoxData[
  FormBox[
   SqrtBox["F"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6b411120-c3d5-6b48-b9af-6bbc52bc469e"],
 " and the second is a distance built from it, not the fidelity, so the two \
are complementary rather than equal, and only the third is the ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "28ba75f7-7a54-bd4f-8717-f3d4bfefa4cc"],
 " defined above:"
}], "Text",
 CellChangeTimes->{{3.995364645483141*^9, 
  3.9953646608995247`*^9}},ExpressionUUID->"440c596d-97f6-d84b-9810-\
d685103e462d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"QuantumDistance", "[", 
        RowBox[{"p1", ",", "p2"}], "]"}], "+", 
       RowBox[{"QuantumSimilarity", "[", 
        RowBox[{"p1", ",", "p2", ",", "\"\<Fidelity\>\""}], "]"}]}], "==", 
      "1"}], ",", 
     RowBox[{
      RowBox[{"QuantumDistance", "[", 
       RowBox[{"p1", ",", "p2", ",", "\"\<Trace\>\""}], "]"}], "==", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"QuantumSimilarity", "[", 
          RowBox[{"p1", ",", "p2", ",", "\"\<Fidelity\>\""}], "]"}], "^", 
         "2"}]}], "]"}]}]}], "}"}], ",", 
   RowBox[{"0", "<=", "\[FormalT]", "<=", "Pi"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.995135367395338*^9, 3.9951353678268585`*^9}, {
  3.99536462184828*^9, 3.995364622675913*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"c78f19ec-92d8-bd48-9130-2fe1e8f43077"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.995135368657339*^9, 3.995364626778166*^9, 
  3.9953646729527817`*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"1bcc5dbc-91f8-f042-b21b-f37432929280"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "12.6 [MSc] How do I compute the Uhlmann fidelity F(\[Rho], \[Sigma]) = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"Tr", 
      SqrtBox[
       RowBox[{
        SqrtBox["\[Rho]"], "\[Sigma]", " ", 
        SqrtBox["\[Rho]"]}]]}], ")"}], "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "20cba6b0-e77b-1942-9d8a-6f43b2a85731"],
 "  between two mixed states?"
}], "Subsection",
 CellChangeTimes->{{3.9953647089105797`*^9, 
  3.9953647793893833`*^9}},ExpressionUUID->"2ad424df-415d-5b4b-88cc-\
3fca11589f67"],

Cell["\<\
Two generic mixed qubits again, each with its own Bloch vector:\
\>", "Text",
 CellChangeTimes->{{3.9953704384873257`*^9, 
  3.995370442881693*^9}},ExpressionUUID->"a2bfd93b-973c-7947-b0df-\
44354335f063"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"rho1", ",", "rho2"}], "}"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
       RowBox[{"#", ".", 
        RowBox[{"PauliMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], ")"}]}], "&"}],
    "/@", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[FormalX]", ",", "\[FormalY]", ",", "\[FormalZ]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[FormalU]", ",", "\[FormalV]", ",", "\[FormalW]"}], "}"}]}], 
    "}"}]}]}]], "Input",
 CellChangeTimes->{{3.9953656192563286`*^9, 3.9953656296029797`*^9}, {
