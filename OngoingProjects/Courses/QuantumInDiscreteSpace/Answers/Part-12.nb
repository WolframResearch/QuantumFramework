Cell[CellGroupData[{

Cell["\<\
12.3 [MSc] How do I show that different ensembles can give the same density \
matrix (the ensemble ambiguity / unitary freedom)?\
\>", "Subsubsection",
 CellChangeTimes->{
  3.9951279148960495`*^9},ExpressionUUID->"f4e3f437-6cd5-1b46-9ddd-\
d907bb1bbdb4"],

Cell["\<\
A density matrix records and forgets the list that built it, so the preparer\
\[CloseCurlyQuote]s ensemble is not recoverable from the state. Absorbing \
each weight into its vector, , turns the sum into \[Rho], and in that form \
the freedom is a single line of algebra. \
\>", "Text",
 CellChangeTimes->{{3.9951295986711884`*^9, 3.9951296631010075`*^9}, {
   3.9951297560234947`*^9, 3.9951297566679993`*^9}, 
   3.995130028409628*^9},ExpressionUUID->"93b4079f-aaac-2f4d-b392-\
c1f97f2fdd38"],

Cell[TextData[{
 "The Hughston-Jozsa-Wootters theorem says the converse too: every ensemble \
for \[Rho] arises this way, from the eigen-ensemble, with U an isometry \
rather than a square unitary when the new list is longer. Since U need not be \
square, neither the weights, nor the states, nor even how many of them there \
are is fixed by \n\[Rho]. Take the generic mixed qubit ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"I", "+", 
       RowBox[{"r", " ", 
        RowBox[{
         OverscriptBox["n", "^"], "\[CenterDot]", 
         OverscriptBox["\[Sigma]", "\[RightVector]"]}]}]}], ")"}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9ba97896-3531-cb4b-b977-1a160b8fa8af"],
 " again."
}], "Text",
 CellChangeTimes->{{3.995130072851574*^9, 
  3.995130152297205*^9}},ExpressionUUID->"3d29440e-effb-0642-b374-\
04f4db362c77"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9951281332796345`*^9, 
  3.995128136413542*^9}},ExpressionUUID->"49587327-8c74-f24a-846f-\
6beabbf45fba"],

Cell["\<\
The state, and the ensemble its own spectrum provides, weights folded into \
the vectors:\
\>", "Text",
 CellChangeTimes->{{3.995128130135189*^9, 
  3.9951281466961765`*^9}},ExpressionUUID->"04c726ed-3141-3c49-8de8-\
412dcdb529d7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"rho", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"nvec", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
         RowBox[{"Cos", "[", "\[FormalPhi]", "]"}]}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[FormalPhi]", "]"}]}], ",", 
        RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}], "}"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
       RowBox[{"\[FormalR]", " ", 
        RowBox[{"nvec", ".", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}]}], ")"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"ens", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "\[FormalR]"}], ")"}], "/", "2"}], "]"}], " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"\[FormalTheta]", "/", "2"}], "]"}], ",", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "\[FormalPhi]"}], "]"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[FormalTheta]", "/", "2"}], "]"}]}]}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[FormalR]"}], ")"}], "/", "2"}], "]"}], " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", "\[FormalPhi]"}], "]"}]}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[FormalTheta]", "/", "2"}], "]"}]}], ",", 
       RowBox[{"Cos", "[", 
        RowBox[{"\[FormalTheta]", "/", "2"}], "]"}]}], "}"}]}]}], 
   "}"}]}]}], "Input",
 CellChangeTimes->{{3.9951279869661274`*^9, 3.99512800463373*^9}, {
  3.99512804185684*^9, 3.995128064286417*^9}, {3.995128149841812*^9, 
  3.9951281511642075`*^9}},
 CellLabel->
  "In[142]:=",ExpressionUUID->"8c8cf4d6-c612-b141-acdc-90c9b2c42e8a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"\[FormalR]", " ", 
         RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}]}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", "2"], " ", "\[FormalR]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "\[FormalPhi]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[FormalPhi]", "]"}]}]}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", "\[FormalR]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "\[FormalPhi]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}]}], "+", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"Sin", "[", "\[FormalTheta]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[FormalPhi]", "]"}]}]}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"\[FormalR]", " ", 
         RowBox[{"Cos", "[", "\[FormalTheta]", "]"}]}]}], ")"}]}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9951281516633377`*^9},
 CellLabel->
  "Out[142]=",ExpressionUUID->"17ec8c95-6828-7e49-887c-67f7c5b98e69"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{
       SqrtBox[
        RowBox[{"1", "+", "\[FormalR]"}]], " ", 
       RowBox[{"Cos", "[", 
        FractionBox["\[FormalTheta]", "2"], "]"}]}], 
      SqrtBox["2"]], ",", 
     FractionBox[
      RowBox[{
       SqrtBox[
        RowBox[{"1", "+", "\[FormalR]"}]], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", "\[FormalPhi]"}]], " ", 
       RowBox[{"Sin", "[", 
        FractionBox["\[FormalTheta]", "2"], "]"}]}], 
      SqrtBox["2"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        SqrtBox[
         RowBox[{"1", "-", "\[FormalR]"}]], " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "\[FormalPhi]"}]], " ", 
        RowBox[{"Sin", "[", 
         FractionBox["\[FormalTheta]", "2"], "]"}]}], 
       SqrtBox["2"]]}], ",", 
     FractionBox[
      RowBox[{
       SqrtBox[
        RowBox[{"1", "-", "\[FormalR]"}]], " ", 
       RowBox[{"Cos", "[", 
        FractionBox["\[FormalTheta]", "2"], "]"}]}], 
      SqrtBox["2"]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.995128151667265*^9},
 CellLabel->
  "Out[143]=",ExpressionUUID->"a844c76f-6a22-4c48-8774-8421fa9ca450"]
}, Open  ]],

Cell["\<\
Its members square-sum to \[Rho], and their norms are the eigenvalues, so \
this is the orthogonal ensemble the spectral decomposition names:\
\>", "Text",
 CellChangeTimes->{{3.9951281709783077`*^9, 
  3.9951281807860413`*^9}},ExpressionUUID->"087c6315-fb7c-ba4f-814b-\
bd1befb114d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Conjugate", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
        "ens"}], "]"}], "==", "rho"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Conjugate", "[", "#", "]"}], ".", "#"}], "&"}], "/@", 
      "ens"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"0", "<=", "\[FormalR]", "<=", "1"}], "&&", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], ",", "Reals"}],
      "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9951280722364407`*^9, 3.9951280739090233`*^9}},
 CellLabel->
  "In[144]:=",ExpressionUUID->"5287a3d5-5496-3c4f-b8d7-5ecc88d031dc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{"1", "+", "\[FormalR]"}], "2"], ",", 
     FractionBox[
      RowBox[{"1", "-", "\[FormalR]"}], "2"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.995128074645403*^9, 3.995128184647333*^9},
 CellLabel->
  "Out[144]=",ExpressionUUID->"e0fab761-4d9c-3645-be4e-874c6f7939ad"]
}, Open  ]],

Cell["\<\
Mixing the two members with a generic SU(2) matrix produces another ensemble \
for the same \[Rho], with its own weights and its own mutual overlap:\
\>", "Text",
 CellChangeTimes->{{3.995128220315386*^9, 
  3.9951282314042034`*^9}},ExpressionUUID->"2a9a1651-b643-ae42-9167-\
0b3d83589a69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"u", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[FormalA]", "/", "2"}], "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "\[FormalB]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"\[FormalA]", "/", "2"}], "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "\[FormalC]"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[FormalA]", "/", "2"}], "]"}]}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "\[FormalC]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[FormalA]", "/", "2"}], "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "\[FormalB]"}], "]"}]}]}], "}"}]}], 
    "}"}]}], ";", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"ComplexExpand", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"#", ",", 
             RowBox[{"Conjugate", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{"u", ".", "ens"}], ")"}]}], "]"}], "==", "rho"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Conjugate", "[", "#", "]"}], ".", "#"}], "&"}], "/@", 
        RowBox[{"(", 
         RowBox[{"u", ".", "ens"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"Conjugate", "[", 
         RowBox[{"First", "[", 
          RowBox[{"u", ".", "ens"}], "]"}], "]"}], ".", 
        RowBox[{"Last", "[", 
         RowBox[{"u", ".", "ens"}], "]"}]}]}], "}"}], "]"}], ",", 
    RowBox[{
     RowBox[{"0", "<=", "\[FormalR]", "<=", "1"}], "&&", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[FormalTheta]", ",", "\[FormalPhi]", ",", "\[FormalA]", ",", 
         "\[FormalB]", ",", "\[FormalC]"}], "}"}], ",", "Reals"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9951280823255806`*^9, 3.9951280828426*^9}},
 CellLabel->
  "In[145]:=",ExpressionUUID->"b1dff739-45f4-414d-9560-3d721e4a00d1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"\[FormalR]", " ", 
         RowBox[{"Cos", "[", "\[FormalA]", "]"}]}]}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"\[FormalR]", " ", 
         RowBox[{"Cos", "[", "\[FormalA]", "]"}]}]}], ")"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], " ", "\[FormalR]", " ", 
    RowBox[{"Sin", "[", "\[FormalA]", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"\[FormalB]", "+", "\[FormalC]"}], "]"}], "-", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[FormalB]", "+", "\[FormalC]"}], "]"}]}]}], ")"}]}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.995128084731905*^9, 3.99512823460643*^9},
 CellLabel->
  "Out[145]=",ExpressionUUID->"e1e61fad-abcf-7542-bb99-7358f0142531"]
}, Open  ]],

Cell["\<\
The isometry need not be square, so the member count is not fixed either, \
four columns of length two, orthonormal as columns, turn two states into four:\
\>", "Text",
 CellChangeTimes->{{3.9951282455951977`*^9, 
  3.995128255690399*^9}},ExpressionUUID->"cba7e812-e889-244f-acde-\
8a165e610b9e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"v", "=", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "I"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "I"}]}], "}"}]}], "}"}]}]}], ";", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"ComplexExpand", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", "v", "]"}], ".", "v"}], "==", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"#", ",", 
             RowBox[{"Conjugate", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{"v", ".", "ens"}], ")"}]}], "]"}], "==", "rho"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Conjugate", "[", "#", "]"}], ".", "#"}], "&"}], "/@", 
        RowBox[{"(", 
         RowBox[{"v", ".", "ens"}], ")"}]}]}], "}"}], "]"}], ",", 
    RowBox[{
     RowBox[{"0", "<=", "\[FormalR]", "<=", "1"}], "&&", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[FormalTheta]", ",", "\[FormalPhi]"}], "}"}], ",", 
       "Reals"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9951280905724964`*^9, 3.9951280910037117`*^9}},
 CellLabel->
  "In[146]:=",ExpressionUUID->"24fe3efa-9974-4944-9098-6567acf1ec40"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", "4"], ",", 
     FractionBox["1", "4"], ",", 
     FractionBox["1", "4"], ",", 
     FractionBox["1", "4"]}], "}"}]}], "}"}]], "Output",
