  3.99537076612669*^9},
 CellLabel->"Out[66]=",ExpressionUUID->"71038577-6621-0d47-907d-0906b0484418"]
}, Open  ]],

Cell["\<\
Squaring a sum of two square roots returns the sum plus twice the root of the \
product, which is the step that turns the definition into a formula:\
\>", "Text",
 CellChangeTimes->{{3.99537078586866*^9, 
  3.9953707874169064`*^9}},ExpressionUUID->"0c94b6ea-a33a-c74b-9fec-\
0b92b62512ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{"rho1", ".", "rho2"}], "]"}], "+", 
     RowBox[{"2", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"Det", "[", "rho1", "]"}], " ", 
        RowBox[{"Det", "[", "rho2", "]"}]}], "]"}]}]}], "==", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[FormalX]", ",", "\[FormalY]", ",", "\[FormalZ]"}], "}"}], 
        ".", 
        RowBox[{"{", 
         RowBox[{"\[FormalU]", ",", "\[FormalV]", ",", "\[FormalW]"}], 
         "}"}]}], "+", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[FormalX]", ",", "\[FormalY]", ",", "\[FormalZ]"}], 
             "}"}], ".", 
            RowBox[{"{", 
             RowBox[{"\[FormalX]", ",", "\[FormalY]", ",", "\[FormalZ]"}], 
             "}"}]}]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[FormalU]", ",", "\[FormalV]", ",", "\[FormalW]"}], 
             "}"}], ".", 
            RowBox[{"{", 
             RowBox[{"\[FormalU]", ",", "\[FormalV]", ",", "\[FormalW]"}], 
             "}"}]}]}], ")"}]}], "]"}]}], ")"}], "/", "2"}]}], ",", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[FormalX]", ",", "\[FormalY]", ",", "\[FormalZ]", ",", "\[FormalU]", ",",
        "\[FormalV]", ",", "\[FormalW]"}], "}"}], ",", "Reals"}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.995369243242935*^9, 3.9953692436739063`*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"241d8834-2eb3-e247-a5ac-3bb324479d2e"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.99536924405982*^9, 3.995370790056362*^9},
 CellLabel->"Out[67]=",ExpressionUUID->"1a30ec3e-337f-744e-82f5-cb0d63c4b05f"]
}, Open  ]],

Cell[TextData[{
 "So ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "=", 
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{"\[Rho]", " ", "\[Sigma]"}], "]"}], "+", 
     RowBox[{"2", 
      SqrtBox[
       RowBox[{"det", " ", "\[Rho]", " ", "det", " ", "\[Sigma]"}]]}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3f954390-9aa6-854b-bb3b-d588ea995cba"],
 " , and in Bloch coordinates every piece is elementary: the trace is an \
inner product of Bloch vectors and each determinant measures how far its \
state sits from the surface. And can be expressed as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        OverscriptBox[
         SubscriptBox["r", "1"], "\[RightVector]"], "\[CenterDot]", 
        SubscriptBox[
         OverscriptBox["r", "\[RightVector]"], "2"]}], "+", 
       SqrtBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"1", "-"}], "|", 
           SubscriptBox["r", "1"], 
           SuperscriptBox["|", "2"]}], ")"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"1", "-"}], "|", 
            SubscriptBox["r", "2"], "|"}], ")"}], "2"]}]]}], ")"}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "644386d5-dcaf-ea47-bd69-301f9d64acac"]
}], "Text",
 CellChangeTimes->{{3.995370806392605*^9, 
  3.99537093694878*^9}},ExpressionUUID->"9c145129-9459-a944-8d6f-\
3c2f54b86f89"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sig1", ",", "sig2"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "\[FormalA]"}], "}"}], ".", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[FormalB]", " ", 
            RowBox[{"Sin", "[", "\[FormalC]", "]"}]}], ",", "0", ",", 
           RowBox[{"\[FormalB]", " ", 
            RowBox[{"Cos", "[", "\[FormalC]", "]"}]}]}], "}"}], ".", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], ")"}]}]}], 
    "}"}]}], ";", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"Tr", "[", 
         RowBox[{"MatrixPower", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"MatrixPower", "[", 
             RowBox[{"sig1", ",", 
              FractionBox["1", "2"]}], "]"}], ".", "sig2", ".", 
            RowBox[{"MatrixPower", "[", 
             RowBox[{"sig1", ",", 
              FractionBox["1", "2"]}], "]"}]}], ",", 
           FractionBox["1", "2"]}], "]"}], "]"}], "2"], "\[Equal]", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"\[FormalA]", " ", "\[FormalB]", " ", 
           RowBox[{"Cos", "[", "\[FormalC]", "]"}]}], "+", 
          SqrtBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", 
              SuperscriptBox["\[FormalA]", "2"]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              SuperscriptBox["\[FormalB]", "2"]}], ")"}]}]]}], ")"}]}]}], ",", 
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"MatrixPower", "[", 
            RowBox[{"sig1", ",", 
             FractionBox["1", "2"]}], "]"}], ".", "sig2", ".", 
           RowBox[{"MatrixPower", "[", 
            RowBox[{"sig1", ",", 
             FractionBox["1", "2"]}], "]"}]}], ",", 
          FractionBox["1", "2"]}], "]"}], "]"}], "\[Equal]", 
       RowBox[{"Tr", "[", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{
          RowBox[{"sig1", ".", "sig2"}], ",", 
          FractionBox["1", "2"]}], "]"}], "]"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"0", "\[LessEqual]", "\[FormalA]", "\[LessEqual]", "1"}], "&&", 
     RowBox[{"0", "\[LessEqual]", "\[FormalB]", "\[LessEqual]", "1"}], "&&", 
     RowBox[{"0", "\[LessEqual]", "\[FormalC]", "\[LessEqual]", "\[Pi]"}]}]}],
    "]"}]}]], "Input",
 CellChangeTimes->{{3.995369254818411*^9, 3.9953692646846905`*^9}, 
   3.995371365708603*^9},
 CellLabel->"In[68]:=",ExpressionUUID->"c86057e5-134b-9049-a034-a4edd68f31b2"],

