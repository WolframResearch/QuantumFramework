(* Beginning of Notebook Content *)
Notebook[{
Cell["Part 10. Elementary multi-qubit gates and circuits", "Section",ExpressionUUID->"036b8fff-a48d-4218-9c64-1ce671aef9c4"],

Cell[TextData[{
 "10.1 [BSc] How do I build the standard multi-qubit gates (CNOT, CZ, SWAP, \
Toffoli, controlled-",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa8a02aa-461f-410d-997d-aa3f26f8f3ea"],
 ")?"
}], "Subsection",ExpressionUUID->"8edcd102-40a5-479a-8151-84215be19c27"],

Cell[TextData[{
 "The standard entangling gates are controlled operations: CNOT and CZ apply ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4743b735-8f6c-49e7-8d79-3e80bbe2a83e"],
 " or ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "128d97fe-2f61-410c-aea7-c97afd8da8da"],
 " to a target when the control is ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "815bd922-3eef-480e-8cd4-bbb0898504b3"],
 ", SWAP exchanges two qubits, Toffoli is a doubly-controlled ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a056a82-47c2-4640-95e1-fbe1cee03a3f"],
 ", and the general controlled-",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348c529c-62fa-41a4-b15b-ec11b297144b"],
 " is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{"0"},
     "Ket"], 
    RowBox[{
     TemplateBox[{"0"},
      "Bra"], "\[CircleTimes]", 
     StyleBox["I", "TI"]}]}], "+", 
   RowBox[{
    TemplateBox[{"1"},
     "Ket"], 
    RowBox[{
     TemplateBox[{"1"},
      "Bra"], "\[CircleTimes]", 
     StyleBox["U", "TI"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df353405-d7b6-4ed6-8dc9-19975444cb22"],
 ". Every controlled gate has this projector form, which is its definition."
}], "Text",ExpressionUUID->"0f6a4370-0fdd-478e-94b1-e26f6b92e417"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : each controlled gate is a sum of projector-tensor-target terms. Here is \
the general controlled-",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f75b8712-892d-4a91-bdba-00fa102d73a0"],
 " with an arbitrary single-qubit ",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ee4c03f-3af0-4ccf-9343-737c60ca1928"],
 ", the pattern the controlled gates follow."
}], "Text",ExpressionUUID->"ce4fd521-2698-408a-92b1-649f3fe05d11"],

Cell[BoxData[
 RowBox[{"MatrixForm", "@", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"p0", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], ",", " ", 
      RowBox[{"p1", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", 
      RowBox[{"u", " ", "=", " ", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\[FormalU]", ",", " ", "##"}], "]"}], " ", "&"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}]}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"p0", ",", " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], " ", "+", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"p1", ",", " ", "u"}], "]"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"87df6408-6a08-4183-aa6e-3b10d83d662b"],

Cell[TextData[{
 "The control leaves the ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2782b7a4-7369-4917-ab36-4ce50a534b71"],
 " subspace alone and applies ",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7ea584c-6827-4ee2-bdec-2177cbfec394"],
 " on the ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16fd40f2-ad00-41fd-89b0-22e4414a1953"],
 " subspace, so the matrix is block diagonal, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], ",", 
    StyleBox["U", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d3ac74e-3f11-4b1b-b4f1-bb258493756c"],
 ". One can therefore also assemble it straight from its two diagonal \
blocks."
}], "Text",ExpressionUUID->"0e930a47-8bdd-4771-ac05-21182ae691a1"],

Cell[BoxData[
 RowBox[{"BlockDiagonalMatrix", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
    RowBox[{"Array", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"\[FormalU]", ",", " ", "##"}], "]"}], " ", "&"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"1593da39-177b-4ab4-b0fb-027632b1d148"],

Cell["\<\
This returns a structured array rather than an explicit list of rows, so \
display it to see the entries.\
\>", "Text",ExpressionUUID->"41a07a1f-cfaa-4710-94a2-5040c2fe82df"],

Cell[BoxData[
 RowBox[{"%", " ", "//", " ", "MatrixForm"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e2ed4c0a-628b-483d-a914-2e337d780b53"],

Cell[TextData[{
 "The named gates are this pattern with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], "=", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec49b02c-6b8f-4255-b93d-bdee713225e7"],
 " (CNOT) and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], "=", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "939d1634-b7b2-462e-8214-65b190088db5"],
 " (CZ). Toffoli is the doubly-controlled ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a7acf47-84b9-4ec6-8754-9ad7bea5cc3c"],
 ": with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], "11"], "=", 
   RowBox[{
    TemplateBox[{"11"},
     "Ket"], 
    TemplateBox[{"11"},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88338229-46f6-45f4-be67-c936abd0fe6a"],
 " the projector onto both controls being set, it is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["TOF",
    FontSlant->"Plain"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["I", "TI"], "4"], "-", 
    SubscriptBox[
     StyleBox["P", "TI"], "11"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[CircleTimes]", 
   StyleBox["I", "TI"], "+", 
   SubscriptBox[
    StyleBox["P", "TI"], "11"], "\[CircleTimes]", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dea694e3-681d-47c9-8d83-f551f77ee0dd"],
 ", the controlled-",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77342032-3669-4f0c-b935-c91819a78d54"],
 " pattern carried over to two controls, equivalently ",
 Cell[BoxData[
  RowBox[{
   StyleBox["TOF",
    FontSlant->"Plain"], "=", 
   SubscriptBox[
    StyleBox["I", "TI"], "8"], "+", 
   SubscriptBox[
    StyleBox["P", "TI"], "11"], "\[CircleTimes]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["X", "TI"], "-", 
    StyleBox["I", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d7d0fbf-05ad-409f-86a8-d2b6aeb09578"],
 ", the identity plus a correction acting only on the ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "185019e6-4965-4513-b06a-6345e494f3c6"],
 " control subspace. SWAP is not a controlled gate, so it falls outside the \
projector pattern. It is the exchange operator ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["k", "TI"], "=", "0"}], "3",
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["k", "TI"]], "\[CircleTimes]", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["k", "TI"]], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   StyleBox["I", "TI"], "\[CircleTimes]", 
   StyleBox["I", "TI"], "+", 
   StyleBox["X", "TI"], "\[CircleTimes]", 
   StyleBox["X", "TI"], "+", 
   StyleBox["Y", "TI"], "\[CircleTimes]", 
   StyleBox["Y", "TI"], "+", 
   StyleBox["Z", "TI"], "\[CircleTimes]", 
   StyleBox["Z", "TI"], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6bc682f-b795-41ab-a94d-a33f78d77d06"],
 " (with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], "0"], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3d0b85b-5f2a-48b8-af37-eb92511ffa43"],
 "), equivalently the permutation that swaps the two qubits."
}], "Text",ExpressionUUID->"c6cc31d0-adbd-43f6-85bb-357d361cd22c"],

Cell[TextData[{
 "All four are nevertheless block diagonal, because each fixes some basis \
states outright and acts non-trivially only inside the complementary \
subspace, so each can be assembled from its invariant blocks alone: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["CNOT",
    FontSlant->"Plain"], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["I", "TI"], "2"], ",", 
    StyleBox["X", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64083750-23ba-4e6a-b185-c0cb8602f5dc"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["CZ",
    FontSlant->"Plain"], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["I", "TI"], "2"], ",", 
    StyleBox["Z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74605703-e431-49ba-89e3-9901db8082a3"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["TOF",
    FontSlant->"Plain"], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["I", "TI"], "6"], ",", 
    StyleBox["X", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c48560c-a530-48b4-9432-2bcead72db09"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["SWAP",
    FontSlant->"Plain"], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    StyleBox["X", "TI"], ",", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f25f2fe-2c5c-48b1-877b-6a93895a8213"],
 ", the last because SWAP fixes ",
 Cell[BoxData[
  TemplateBox[{"00"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9a02f55-971f-49f5-a71f-2fee4c1cc919"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d64c965-70b0-4c51-9263-cf400700a944"],
 " and exchanges ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"01"},
    "Ket"], "\[LeftRightArrow]", 
   TemplateBox[{"10"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb4780be-32ef-4fb1-b987-5db97e680251"],
 "."
}], "Text",ExpressionUUID->"99d21c08-2f8c-4e60-8d97-a97c185729b1"],

Cell[BoxData[
 RowBox[{"MatrixForm", " ", "/@", " ", 
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
     RowBox[{"BlockDiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
        RowBox[{"PauliMatrix", "[", "1", "]"}]}], "}"}], "]"}]}], ",", " ", 
    RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
     RowBox[{"BlockDiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
        RowBox[{"PauliMatrix", "[", "3", "]"}]}], "}"}], "]"}]}], ",", " ", 
    RowBox[{"\"\<SWAP\>\"", " ", "->", " ", 
     RowBox[{"BlockDiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "1", "]"}], ",", " ", 
        RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", 
        RowBox[{"IdentityMatrix", "[", "1", "]"}]}], "}"}], "]"}]}], ",", " ", 
    RowBox[{"\"\<Toffoli\>\"", " ", "->", " ", 
     RowBox[{"BlockDiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "6", "]"}], ",", " ", 
        RowBox[{"PauliMatrix", "[", "1", "]"}]}], "}"}], "]"}]}]}], 
   "|>"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"82a6cf32-fbb5-4ff1-9113-412f9d3856ad"],

Cell["\<\
These block forms assume the standard wire ordering, controls before target; \
permuting the wires conjugates the matrix by a permutation and destroys the \
pattern.\
\>", "Text",ExpressionUUID->"6df283c1-9048-46db-bdd7-4052d3e601eb"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : these are named ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b406e94c-2100-45df-83ea-a9aff0b293fb"],
 "s; read their matrices off the objects."
}], "Text",ExpressionUUID->"5bdb4dd2-b274-4cd1-aee4-f198873e70ab"],

Cell[BoxData[
 RowBox[{"AssociationMap", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"MatrixForm", "[", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", "#", "]"}], "[", "\"\<Matrix\>\"", 
      "]"}], "]"}], " ", "&"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<CNOT\>\"", ",", " ", "\"\<CZ\>\"", ",", " ", "\"\<SWAP\>\"", 
     ",", " ", "\"\<Toffoli\>\""}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"b953b3dd-ef7e-4f3d-9cff-7f9538b8b085"],

Cell[TextData[{
 "Both give the same gates: CNOT and CZ flip ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1de253cd-031a-4a19-af5d-d7e236a69606"],
 " or phase ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b06c88b7-8d14-430b-8d9f-3fffa2b1ee4a"],
 " on the target when the control is set, SWAP permutes the two qubits, and \
Toffoli flips its target only when both controls are ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1809c34b-4447-4e6b-bf78-0ddcb1c83223"],
 ". The QF names carry the object's structure (arity, control and target \
wires, unitarity), so they drop straight into a circuit; the projector form \
on the WL side shows ",
 StyleBox["why", "TI"],
 " each is the gate it is."
}], "Text",ExpressionUUID->"1bdd9957-12ea-40e2-96cf-4431a9750a24"],

Cell[TextData[{
 "The main advantage of the QF form is that you decide ",
 StyleBox["where", "TI"],
 " the operator acts by setting its target wires as a second argument, \
something a bare matrix cannot carry. CNOT with qubit 2 as the control and \
qubit 4 as the target:"
}], "Text",ExpressionUUID->"50924630-bcda-4dcd-ab34-3c7725ad65ea"],

Cell[BoxData[
 RowBox[{"MatrixForm", "[", 
  RowBox[{
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<CNOT\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}], "[", "\"\<Matrix\>\"", 
   "]"}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"365d3127-4c1e-4883-a11b-34217ac04f9a"],

Cell[TextData[{
 "The matrix that comes back is still ",
 Cell[BoxData[
  RowBox[{"4", "\[Times]", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d9d65fe-62b9-478e-ad8c-1be2d92976e4"],
 ": the wires ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "2"}], ",", 
   RowBox[{"4", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa81e1da-8300-4e13-af2d-b97c9d32a202"],
 " sit in the operator's order, not in its entries. A bare matrix has nowhere \
to keep that, so in plain WL the placement has to be built by hand, padding \
every spectator wire with an ",
 Cell[BoxData["IdentityMatrix"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d168fbc0-9fcd-4cba-a499-1ab0c949c5de"],
 " factor. On a four-qubit register that means identity on wires 1 and 3, the \
control projectors on wire 2, and the target on wire 4:"
}], "Text",ExpressionUUID->"21a88364-8bc9-45a3-9e99-10c76454fb47"],

Cell[BoxData[
 RowBox[{"MatrixForm", "@", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"p0", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], ",", " ", 
      RowBox[{"p1", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", 
      RowBox[{"id", " ", "=", " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"id", ",", " ", "p0", ",", " ", "id", ",", " ", "id"}], "]"}], 
     " ", "+", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"id", ",", " ", "p1", ",", " ", "id", ",", " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}]}]}], "]"}]}]], "Input",\

 CellLabel->"In[7]:= ",ExpressionUUID->"44ee461b-6675-44de-b334-6b0f1f65dc32"],

Cell[TextData[{
 "That one is ",
 Cell[BoxData[
  RowBox[{"16", "\[Times]", "16"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5596f38-9b9f-4b3b-af78-456e5a936a3a"],
 ": writing the placement down forces a commitment to the width of the \
register, and adding a fifth qubit means another ",
 Cell[BoxData["IdentityMatrix"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76e582e8-1f44-4464-8f4a-56aa6622f583"],
 " factor and a ",
 Cell[BoxData[
  RowBox[{"32", "\[Times]", "32"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "169d1e2e-757e-44ff-ae0f-d04e9ba68a70"],
 " matrix. The QF operator stays two-qubit and carries ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "2"}], ",", 
   RowBox[{"4", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5db10f5e-1aec-4686-a22d-79d099ad84b4"],
 " as structure, so the same object drops into a circuit of any width."
}], "Text",ExpressionUUID->"b8b70513-a382-41a1-8e91-0a006d0c6712"],

Cell["Or SWAP between qubit 1 and qubit 3:", "Text",ExpressionUUID->"3cc09e7a-b7b2-4f68-a4ac-7c7732fcb110"],

Cell[BoxData[
 RowBox[{"MatrixForm", "[", 
  RowBox[{
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<SWAP\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}], "[", "\"\<Matrix\>\"", 
   "]"}], "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"4aa254c1-2fb1-4442-812f-30b81245d6c3"],

Cell[TextData[{
 "The matrix printed is the bare two-wire gate, not padded with identities on \
the wires in between; the wire labels live in the object's ",
 Cell[BoxData["\"\<Order\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dde7050f-56ed-4510-adf1-79e4340cce55"],
 ". So when this CNOT meets a register it flips qubit 4 exactly when qubit 2 \
is set (and the order within the pair fixes which wire is the control), \
padding the intervening wires with the identity automatically. Placing the \
same gate in native WL means tensoring those identities in by hand and \
reordering for the non-adjacent wires."
}], "Text",ExpressionUUID->"138fe311-2b26-44e5-84f5-4190132351de"],

Cell["\<\
10.2a [BSc] How do I compose a circuit from gates and apply it to an input \
state?\
\>", "Subsection",ExpressionUUID->"9250fdc7-ae28-4efe-b3f4-1adbef4c00e4"],

Cell[TextData[{
 "A circuit is an ordered list of gates on named wires; applying it evolves \
an input state through them in order. Compose the two-gate Bell circuit, ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f3ee7f0b-3fb9-4d3a-bb0f-ad17ee802530"],
 " on qubit 1 then CNOT from 1 to 2, and apply it to ",
 Cell[BoxData[
  TemplateBox[{"00"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ab0ff91-6d86-4bca-8e47-54393dc4e943"],
 "."
}], "Text",ExpressionUUID->"e7eafd0b-1ade-4d68-9a45-65ea25d7be99"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the circuit's action is the ordered matrix product acting on the input \
vector, CNOT after ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "\[CircleTimes]", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12eff6ef-0431-4c64-8f70-6c2dadbf173c"],
 "."
}], "Text",ExpressionUUID->"889d773a-dbf1-44c1-a673-48a6f146aaaf"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"cnot", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "1"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "1", ",", " ", "0"}], "}"}]}], 
      "}"}]}], "}"}], ",", " ", 
   RowBox[{"cnot", " ", ".", " ", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"HadamardMatrix", "[", "2", "]"}], ",", " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], " ", ".", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"d51492c1-1902-4ee7-9f7f-b17eb89ab32d"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : a ",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ae3500a-89b1-4989-afb3-2a21896aa867"],
 " built from the gate list applies to the ",
 Cell[BoxData["QuantumState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "216f106d-0de1-4688-866d-8050113cfe6b"],
 " directly."
}], "Text",ExpressionUUID->"327dd9cb-0b8b-4e04-8ce6-44278532730b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}]}]}], "}"}], "]"}], "[", 
  RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}], "]"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"f6c05e86-dc0c-41f6-b6e9-5cdca5df142b"],

Cell[TextData[{
 "Both produce the Bell state ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["\[CapitalPhi]", "+"]},
    "Ket"], "=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox["2"]], 
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{"00"},
       "Ket"], "+", 
      TemplateBox[{"11"},
       "Ket"]}], ")"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "584d85f0-d12a-48a5-97de-a30a59835776"],
 ": the Hadamard makes a superposition on the control, and the CNOT \
correlates the target with it, so a product input comes out entangled. The QF \
circuit is a reusable object that also knows its wires and its overall \
unitary (10.2b)."
}], "Text",ExpressionUUID->"b86fd8ee-f709-46ba-9dc9-07d23b184357"],

Cell["\<\
10.2b [BSc] How do I read off the overall unitary of a composed circuit?\
\>", "Subsection",ExpressionUUID->"f5165cfa-9727-4b81-9432-11fab3beb975"],

Cell["\<\
The whole circuit is itself one unitary, the ordered product of its gate \
matrices; reading it off lets you treat a subcircuit as a single black-box \
gate. Take the same Bell circuit.\
\>", "Text",ExpressionUUID->"d6e8f946-dfec-4d56-9b09-c8f365f4aa3f"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : multiply the gate matrices in circuit order (with each embedded on its \
wires), CNOT after ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "\[CircleTimes]", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f3e8d1e-a3bf-487c-9d7d-7aef0af14cc7"],
 "."
}], "Text",ExpressionUUID->"f9475b43-ee40-4610-a6d1-6fad74213acb"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"cnot", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "1"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "1", ",", " ", "0"}], "}"}]}], 
      "}"}]}], "}"}], ",", " ", 
   RowBox[{"cnot", " ", ".", " ", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"HadamardMatrix", "[", "2", "]"}], ",", " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->
  "In[11]:= ",ExpressionUUID->"2325c651-efc0-4cd4-9457-c5c03d8e388e"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the whole circuit collapses to one operator whose overall unitary you \
read off directly with ",
 Cell[BoxData["\"\<Matrix\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41dcd3b6-c1ff-4aee-acd9-dcc8e8226529"],
 "."
}], "Text",ExpressionUUID->"851ab698-44e7-45d5-bc35-815e464d9564"],

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}]}], "}"}], "]"}], 
   "[", "\"\<Matrix\>\"", "]"}], "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"3c26ed74-70a9-47de-9c8d-40248d032ebd"],

Cell[TextData[{
 "Both give the same ",
 Cell[BoxData[
  RowBox[{"4", "\[Times]", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "950cc218-e42b-419e-9a51-4fbc33751171"],
 " unitary: multiplying the embedded gate matrices in circuit order and \
reading ",
 Cell[BoxData["\"\<Matrix\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dbca210-7a03-4876-b2bc-94093eccbf1e"],
 " off the composed operator are two routes to the one matrix that represents \
the whole circuit."
}], "Text",ExpressionUUID->"27bb9be9-0fa5-459c-b1e9-e62835d65769"],

Cell["\<\
10.3 [BSc] How do I compute the depth and the parallel layers of a circuit?\
\>", "Subsection",ExpressionUUID->"969e7e3d-86fb-4fcb-91f1-901612412812"],

Cell[TextData[{
 "The depth of a circuit is the number of layers when gates are packed as \
early as possible: two gates share a layer only if they act on disjoint \
qubits, so depth measures the longest chain of gates that must run in \
sequence, the circuit's runtime on parallel hardware. Take ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0021a2bb-67b8-4a00-922c-c3dade934491"],
 " on qubits 1 and 2, then CNOT from 1 to 2, CNOT from 2 to 3, and finally ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad655807-ae8f-479f-abc0-a34b7cd43edd"],
 " on qubit 1 (a bare gate name defaults to the first wire): five gates on \
three qubits. Here is that circuit, drawn one column per layer, so the \
packing the rest of the answer computes is visible from the start."
}], "Text",ExpressionUUID->"f726926a-3488-4ff6-9ac9-f88ebd5e17ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"\"\<H\>\"", " ", "->", " ", "2"}], ",", " ", 
     RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
     RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", "\"\<S\>\""}], "}"}], 
   "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"c089c87a-e63f-486b-9f56-8f58cf1cbc47"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : schedule each gate into the earliest layer its qubits allow (one past \
the latest layer any of its qubits is currently busy), tracking a per-qubit \
clock with one entry per wire; the depth is the maximum over qubits."
}], "Text",ExpressionUUID->"80cfb738-7350-4cb2-8662-567e0c63ddbe"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"gates", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", " ", 
       RowBox[{"{", "2", "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", "1", "}"}]}], "}"}]}], "}"}], ",", " ", 
   RowBox[{"Max", "[", 
    RowBox[{"Fold", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"clock", ",", " ", "g"}], "}"}], ",", " ", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{"clock", ",", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"g", " ", "->", " ", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"clock", "[", 
               RowBox[{"[", "g", "]"}], "]"}], "]"}], " ", "+", " ", "1"}]}], 
           "]"}]}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"Max", "[", "gates", "]"}]}], "]"}], ",", " ", "gates"}], 
     "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"ce695a98-e546-46b5-ba03-ac6d90713a77"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : a ",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "345b2123-396b-49d8-a44a-5708ace9193a"],
 " reports its ",
 Cell[BoxData["\"\<Depth\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc5707dc-1aa7-4f57-b116-79cd48d9ed69"],
 " and its ",
 Cell[BoxData["\"\<Layers\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d84110c2-1cf7-4c56-8445-ee0a5c341c84"],
 " (the list of parallel slices) directly."
}], "Text",ExpressionUUID->"2970d689-ef26-4fc4-9ac1-14f159be03d6"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qc", " ", "=", " ", 
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"\"\<H\>\"", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
        RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", "\"\<S\>\""}], 
       "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"qc", "[", "\"\<Depth\>\"", "]"}], ",", " ", 
     RowBox[{"Length", "[", 
      RowBox[{"qc", "[", "\"\<Layers\>\"", "]"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"f3008afd-5e2a-4eab-aca7-53485d53ed6f"],

Cell[TextData[{
 "Both give depth ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86f70ef3-0427-4968-a9de-7979a486da66"],
 ". The two Hadamards share layer 1 (disjoint qubits); the first CNOT waits \
for both of them in layer 2; then in layer 3 the second CNOT (on qubits 2 and \
3) runs alongside the ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bcec98b0-6824-460a-ad9d-04b8998acd55"],
 " on qubit 1, since those touch disjoint wires. So five gates pack into \
three layers: it is the depth, not the gate count of ",
 Cell[BoxData["5"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1df99a45-9953-4d0a-818c-f123d6f1e3b5"],
 ", that sets how long the circuit takes on hardware that fires disjoint \
gates simultaneously, so scheduling into layers is the first step in \
estimating a circuit's real cost."
}], "Text",ExpressionUUID->"03a5ddd3-f97b-41df-89a1-a2a7b6a4b4bb"]
},
CreateCellID->True,
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (February 17, 2026)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"e87e7e57-c2b7-473f-8985-5c8d8593a5f8"
]
