(* Beginning of Notebook Content *)
Notebook[{
Cell["Part 6. Uncertainty and incompatibility", "Section",ExpressionUUID->"36fcf418-33de-42bf-b8e7-ff1217556bdd"],

Cell["\<\
6.1 [MSc] How do I verify the Robertson-Schrodinger uncertainty relation for \
a given state?\
\>", "Subsection",ExpressionUUID->"4d46cc55-e132-4973-86b5-61e862869c51"],

Cell[TextData[{
 "For observables ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], ",", 
   StyleBox["B", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82497fd6-80bb-40ad-a4be-b6349ed455be"],
 " on ",
 StyleBox["any", "TI"],
 " state ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83d6e6cc-32e9-4bd0-8a38-7533571e9d93"],
 " (pure or mixed), with standard deviations ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["A", "TI"]], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SuperscriptBox[
      StyleBox["A", "TI"], "2"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1], "-", 
     SuperscriptBox[
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       StyleBox["A", "TI"], "\[VeryThinSpace]", 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d32c1145-212f-4b81-849a-ad86c69bed27"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["B", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4aaf55e-8574-4ee2-825e-047deb277f72"],
 " likewise, the Robertson-Schrodinger relation bounds the product of \
variances,"
}], "Text",ExpressionUUID->"7ad1786e-1aa1-47f8-bb38-72d8bd916acc"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["A", "TI"], "2"], " ", 
    SubsuperscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["B", "TI"], "2"], "\[ThickSpace]", "\[GreaterEqual]", 
    "\[ThickSpace]", 
    StyleBox["(",
     FontSize->1.8 Inherited], 
    FractionBox["1", "2"], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{"{", 
      StyleBox["A", "TI"]}], ",", 
     RowBox[{
      StyleBox["B", "TI"], "}"}]}], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "-", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["A", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["B", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], 
    SuperscriptBox[
     StyleBox[")",
      FontSize->1.8 Inherited], "2"], "+", 
    StyleBox["(",
     FontSize->1.8 Inherited], 
    FractionBox["1", 
     RowBox[{"2", 
      StyleBox["i", "TI"]}]], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["A", "TI"], ",", 
      StyleBox["B", "TI"]}], 
     StyleBox["]",
      SpanMaxSize->1]}], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], 
    SuperscriptBox[
     StyleBox[")",
      FontSize->1.8 Inherited], "2"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"3ded7b36-0643-4cc0-\
b81c-dfeedaa4ee71"],

Cell[TextData[{
 "the first term a covariance, the second the Robertson (commutator) piece, \
with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], "\[CenterDot]", "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"\[CenterDot]", " ", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46e9edb7-a929-4ddf-96c0-1e356f405c9f"],
 ". Every qubit observable is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a", "TI"], "0"], 
   StyleBox["I", "TI"], "+", 
   StyleBox["a", "TI"], " ", 
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09712f06-65f9-43ba-87da-f843fe6af782"],
 "; the identity shift drops out of every variance, covariance, and \
commutator, and the two scales multiply both sides of the relation equally, \
so the fully general pair is a pair of unit directions, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "576b2caa-1e70-4b0e-9adc-d389945ad7bd"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "2"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2c4fc2a-c45c-4696-b03c-17f2c54aa56c"],
 ", each built from its spherical angles, on the general qubit ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25ce208e-bd97-4bbe-8506-bb4b7e52fdaa"],
 ", ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4bb780b-9ebe-47e6-8d59-531e58591383"],
 ". The telling quantity is the slack, how far the state sits above the bound."
}], "Text",ExpressionUUID->"1cbcdf2b-36c4-44e6-a9f4-c0365c1a0771"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : build the two directions with ",
 Cell[BoxData["FromSphericalCoordinates"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "598c97ca-618f-44b9-a425-5389b23a66b0"],
 ", then, with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], "\[CenterDot]", "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "867d81a6-a2bd-4a6d-b21f-dc46898935c8"],
 " the trace against ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec6d1daa-d773-4859-9245-406414b7fed0"],
 ", compute the left side minus the right side."
}], "Text",ExpressionUUID->"60e01a68-21b4-4e52-b96a-71f15963c624"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n1", ",", " ", "n2"}], "}"}], " ", "=", " ", 
   RowBox[{"FromSphericalCoordinates", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "\[Theta]1", ",", " ", "\[Phi]1"}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "\[Theta]2", ",", " ", "\[Phi]2"}], "}"}]}], 
     "}"}]}]}], ";"}], "\n", 
 RowBox[{"slack", " ", "=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"n1", " ", ".", " ", 
        RowBox[{"PauliMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], ",", 
      " ", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{"n2", " ", ".", " ", 
        RowBox[{"PauliMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], ",", 
      " ", 
      RowBox[{"rho", " ", "=", " ", 
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rx", ",", " ", "ry", ",", " ", "rz"}], "}"}], " ", ".", 
           " ", 
           RowBox[{"PauliMatrix", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
         ")"}]}]}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ev", " ", "=", " ", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{"#", " ", ".", " ", "rho"}], "]"}], " ", "&"}]}], "}"}], ",",
       "\n", "   ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ev", "[", 
            RowBox[{"a", " ", ".", " ", "a"}], "]"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"ev", "[", "a", "]"}], "^", "2"}]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ev", "[", 
            RowBox[{"b", " ", ".", " ", "b"}], "]"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"ev", "[", "b", "]"}], "^", "2"}]}], ")"}]}], " ", "-", 
        "\n", "     ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"ev", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"a", " ", ".", " ", "b"}], " ", "+", " ", 
                 RowBox[{"b", " ", ".", " ", "a"}]}], ")"}], "/", "2"}], 
              "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"ev", "[", "a", "]"}], " ", 
              RowBox[{"ev", "[", "b", "]"}]}]}], ")"}], "^", "2"}], " ", "+", 
          " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"ev", "[", 
              RowBox[{
               RowBox[{"a", " ", ".", " ", "b"}], " ", "-", " ", 
               RowBox[{"b", " ", ".", " ", "a"}]}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{"2", " ", "I"}], ")"}]}], ")"}], "^", "2"}]}], ")"}]}], 
       "]"}]}], "]"}]}], "]"}]}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"55230a73-c7f8-4d24-95b5-d7fe7577adaa"],

Cell[TextData[{
 "The relation itself is the claim that this slack is never negative. So \
confirm the inequality first: ask the kernel for any physical Bloch vector \
(",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "709f4c59-a901-45cb-a5c4-707d808661d1"],
 ") and any pair of directions that violate it."
}], "Text",ExpressionUUID->"24e6c8c3-8961-405d-a66e-7edb3ce0b39c"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"slack", " ", "<", " ", "0"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"rx", "^", "2"}], " ", "+", " ", 
      RowBox[{"ry", "^", "2"}], " ", "+", " ", 
      RowBox[{"rz", "^", "2"}]}], " ", "<=", " ", "1"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
    "rx", ",", " ", "ry", ",", " ", "rz", ",", " ", "\[Theta]1", ",", " ", 
     "\[Phi]1", ",", " ", "\[Theta]2", ",", " ", "\[Phi]2"}], "}"}], ",", " ",
    "Reals"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"327756dc-2100-4690-b61f-83d792a2210c"],

Cell[TextData[{
 "The violating set is empty, so the relation holds for every qubit state and \
every observable pair at once. To see why, look at the slack itself: one \
factor is the mixedness ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[GridBox[{
      {
       OverscriptBox[
        StyleBox["r", "TI"], "\[RightVector]"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1aad01c-ef33-4532-8972-fbdf8ad75ab5"],
 ", the other is trigonometric in the four angles. Since the qubit commutator \
is geometric, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["n", "TI"], "^"], "1"], "\[CenterDot]", 
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], ",", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["n", "TI"], "^"], "2"], "\[CenterDot]", 
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "2", 
   StyleBox["i", "TI"], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "1"], "\[Times]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "647f775e-76e2-4b8c-b89d-21e5c495fb8e"],
 ", test whether that factor is the squared cross product."
}], "Text",ExpressionUUID->"2908d90d-3783-48d8-a56d-8a237f90e2c1"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"slack", " ", "==", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Cross", "[", 
      RowBox[{"n1", ",", " ", "n2"}], "]"}], " ", ".", " ", 
     RowBox[{"Cross", "[", 
      RowBox[{"n1", ",", " ", "n2"}], "]"}]}], " ", 
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rx", ",", " ", "ry", ",", " ", "rz"}], "}"}], " ", ".", " ", 
       
       RowBox[{"{", 
        RowBox[{"rx", ",", " ", "ry", ",", " ", "rz"}], "}"}]}]}], ")"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"b4db3f9e-dc80-473d-89df-7c3dc08caa04"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same slack, the general state as a ",
 Cell[BoxData["QuantumState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "678ba73a-9f6b-405a-b820-9d29addc9fb4"],
 " and its density matrix, the observables as ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "749c05bf-7316-49e6-951d-31ec316e377e"],
 "s built from the same spherical directions, the commutator via ",
 Cell[BoxData["Commutator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b119af3b-56e0-4f14-930c-cb12c8ae70c2"],
 "."
}], "Text",ExpressionUUID->"440cac77-6579-4c8a-81e0-1867a2f43080"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"qs", " ", "=", " ", 
      RowBox[{"QuantumState", "[", 
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rx", ",", " ", "ry", ",", " ", "rz"}], "}"}], " ", ".", 
           " ", 
           RowBox[{"PauliMatrix", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
         ")"}]}], "]"}]}], ",", "\n", "  ", 
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{
        RowBox[{"FromSphericalCoordinates", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "\[Theta]1", ",", " ", "\[Phi]1"}], "}"}], 
         "]"}], " ", ".", " ", 
        RowBox[{"PauliMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], 
       "]"}]}], ",", "\n", "  ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{
        RowBox[{"FromSphericalCoordinates", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "\[Theta]2", ",", " ", "\[Phi]2"}], "}"}], 
         "]"}], " ", ".", " ", 
        RowBox[{"PauliMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], 
       "]"}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ev", " ", "=", " ", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{"#", "[", "\"\<Matrix\>\"", "]"}], "]"}], " ", ".", " ", 
          RowBox[{"Normal", "[", 
           RowBox[{"qs", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], "]"}], 
        " ", "&"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ev", "[", 
           RowBox[{"a", " ", "@", " ", "a"}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"ev", "[", "a", "]"}], "^", "2"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ev", "[", 
           RowBox[{"b", " ", "@", " ", "b"}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"ev", "[", "b", "]"}], "^", "2"}]}], ")"}]}], " ", "-", 
       "\n", "    ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ev", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"a", " ", "@", " ", "b"}], " ", "+", " ", 
                RowBox[{"b", " ", "@", " ", "a"}]}], ")"}], "/", "2"}], "]"}],
             " ", "-", " ", 
            RowBox[{
             RowBox[{"ev", "[", "a", "]"}], " ", 
             RowBox[{"ev", "[", "b", "]"}]}]}], ")"}], "^", "2"}], " ", "+", 
         " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ev", "[", 
             RowBox[{"Commutator", "[", 
              RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "I"}], ")"}]}], ")"}], "^", "2"}]}], ")"}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"e86a93ad-ae8b-45dc-bcd5-29ecff563f83"],

Cell[TextData[{
 "Both compute the identical factored slack; the violation search returns \
False and the equality test returns True: the slack is exactly ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["n", "TI"], "^"], "1"], "\[Times]", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["n", "TI"], "^"], "2"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[GridBox[{
       {
        OverscriptBox[
         StyleBox["r", "TI"], "\[RightVector]"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "104a58ab-03f6-4493-941f-c997678cd44f"],
 ", the observables' incompatibility (",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["n", "TI"], "^"], "1"], "\[Times]", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["n", "TI"], "^"], "2"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6beda118-d38e-4ff6-a14b-7fc6c45a102a"],
 ", with ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aac7a2d-74d4-4ad7-9c46-7a4e565e0125"],
 " the angle between the two directions) times the state's mixedness (",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[GridBox[{
      {
       OverscriptBox[
        StyleBox["r", "TI"], "\[RightVector]"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", "2", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["Tr",
     FontSlant->"Plain"], 
    StyleBox["[",
     SpanMaxSize->1], 
    SuperscriptBox[
     StyleBox["\[Rho]", "TI"], "2"], 
    StyleBox["]",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03853850-bb39-4c3e-9f25-8083251f6d59"],
 "). A product of two non-negative factors, which is the structural reason no \
violation exists, and it saturates exactly when a factor vanishes: a pure \
state (",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c973f04a-290e-4782-a9f2-5453cd17cbd7"],
 ") or a commuting pair (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"], "\[Times]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f879047-f1f7-48a7-847e-c1952d9462ea"],
 ", the directions parallel or antiparallel). The perpendicular choice ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51536548-d7b5-4ee8-a3de-8b373fceafb7"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], "=", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8dbf08af-1ce3-445d-8b7d-f67a19d51339"],
 " has ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      RowBox[{
       SubscriptBox[
        OverscriptBox[
         StyleBox["n", "TI"], "^"], "1"], "\[Times]", 
       SubscriptBox[
        OverscriptBox[
         StyleBox["n", "TI"], "^"], "2"]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59670641-c900-488f-9a82-e9bc4daef254"],
 ", so its slack is the mixedness alone. The commutator term alone is the \
weaker Robertson relation ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["A", "TI"]], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["B", "TI"]], "\[GreaterEqual]", 
   FractionBox["1", "2"], GridBox[{
     {
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       StyleBox["[",
        SpanMaxSize->1], 
       StyleBox["A", "TI"], ",", 
       StyleBox["B", "TI"], 
       StyleBox["]",
        SpanMaxSize->1], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21130628-2ca9-4442-97f5-eda749052271"],
 "; Schrodinger's covariance term is what tightens it."
}], "Text",ExpressionUUID->"41aa1710-dcac-4e1d-8c37-80d136a98c93"],

Cell["\<\
6.2 [MSc] How do I find a minimum-uncertainty state that saturates the \
Robertson bound?\
\>", "Subsection",ExpressionUUID->"986a5d0a-5927-46bc-8094-e16c19c4a597"],

Cell[TextData[{
 "The Robertson bound ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["A", "TI"]], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["B", "TI"]], "\[GreaterEqual]", 
   FractionBox["1", "2"], GridBox[{
     {
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       StyleBox["[",
        SpanMaxSize->1], 
       StyleBox["A", "TI"], ",", 
       StyleBox["B", "TI"], 
       StyleBox["]",
        SpanMaxSize->1], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4720a5e4-02f5-44cc-ba90-1c30307c903f"],
 " is saturated exactly where the ",
 StyleBox["Robertson gap", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], "=", 
   SubsuperscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["A", "TI"], "2"], 
   SubsuperscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["B", "TI"], "2"], "-", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   FractionBox["1", 
    RowBox[{"2", 
     StyleBox["i", "TI"]}]], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["A", "TI"], ",", 
     StyleBox["B", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox[")",
     FontSize->1.2 Inherited], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d93c106c-9f43-4932-b7ea-dbd5603de4d5"],
 " vanishes. Take the generic observable pair of 6.1, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "305714bb-e902-4735-b5b9-6fc5da5b7c6e"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "2"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4bff49f-5484-4b6b-b80b-d6133687b0f0"],
 ", compute ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d45e2fb4-e606-45b2-9d2f-fb4fea085508"],
 " over the whole pure-qubit family ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    FractionBox[
     StyleBox["\[Theta]", "TI"], "2"]}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox[
      RowBox[{"i", "\[Phi]"}], "TI"]], 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    FractionBox[
     StyleBox["\[Theta]", "TI"], "2"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df8c83d3-bae6-4925-8c53-e2262bd712d3"],
 ", and solve ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb22971a-b05d-4352-b378-4d214bd93833"],
 ". Purity is no restriction here: by 6.1 the slack of the full relation is \
",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["n", "TI"], "^"], "1"], "\[Times]", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["n", "TI"], "^"], "2"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[GridBox[{
       {
        OverscriptBox[
         StyleBox["r", "TI"], "\[RightVector]"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32aba894-6cde-44df-914f-2d700d540f3d"],
 ", so for a non-commuting pair a mixed state sits strictly above even the \
stronger Robertson-Schrodinger bound, and every Robertson-saturating state \
must be pure."
}], "Text",ExpressionUUID->"6703a7f4-3ff0-4e90-9866-8ac7e66523c2"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the gap over the whole pure family for the generic pair; the expectation \
is the sandwich ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Bra"], "\[CenterDot]", 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be5e1055-3188-4569-9c34-147835baf475"],
 ", and ",
 Cell[BoxData["ComplexExpand"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cad5c3ab-a493-4374-9099-4e167e0494dd"],
 " keeps it explicitly real (all angles are real)."
}], "Text",ExpressionUUID->"8c914a81-ed2a-4abc-9eb9-9b416103fef4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n1", ",", " ", "n2"}], "}"}], " ", "=", " ", 
   RowBox[{"FromSphericalCoordinates", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "\[Theta]1", ",", " ", "\[Phi]1"}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "\[Theta]2", ",", " ", "\[Phi]2"}], "}"}]}], 
     "}"}]}]}], ";"}], "\n", 
 RowBox[{"gap", " ", "=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"psi", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}]}], ",", " ", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"n1", " ", ".", " ", 
        RowBox[{"PauliMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], ",", 
      " ", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{"n2", " ", ".", " ", 
        RowBox[{"PauliMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}]}], 
     "}"}], ",", "\n", "  ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ev", " ", "=", " ", 
        RowBox[{
         RowBox[{"Simplify", "[", 
          RowBox[{"ComplexExpand", "[", 
           RowBox[{
            RowBox[{"Conjugate", "[", "psi", "]"}], " ", ".", " ", "#", " ", ".",
             " ", "psi"}], "]"}], "]"}], " ", "&"}]}], "}"}], ",", "\n", 
      "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ev", "[", 
           RowBox[{"a", " ", ".", " ", "a"}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"ev", "[", "a", "]"}], "^", "2"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ev", "[", 
           RowBox[{"b", " ", ".", " ", "b"}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"ev", "[", "b", "]"}], "^", "2"}]}], ")"}]}], " ", "-", 
       " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ev", "[", 
           RowBox[{
            RowBox[{"a", " ", ".", " ", "b"}], " ", "-", " ", 
            RowBox[{"b", " ", ".", " ", "a"}]}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "I"}], ")"}]}], ")"}], "^", "2"}]}]}], "]"}]}], 
   "]"}]}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"aa0dd7ca-0195-4a74-b140-c69546917d94"],

Cell[TextData[{
 "The raw gap is a tangle of trigonometry in six angles; identify it. For a \
pure state the Robertson-Schrodinger slack of 6.1 is zero, so the gap should \
be exactly the squared covariance: with ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["m", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2d9f7b2-ed59-4938-aa05-c85051cec460"],
 " the state's Bloch vector, ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"{", 
     StyleBox["A", "TI"]}], ",", 
    RowBox[{
     StyleBox["B", "TI"], "}"}]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "-", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["B", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"], "\[CenterDot]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "2"], "-", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["m", "TI"], "^"], "\[CenterDot]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["m", "TI"], "^"], "\[CenterDot]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8a3b17d8-e34d-4c86-886b-fa21dc0f4351"],
 ". Test the identity: the difference should expand to exactly zero."
}], "Text",ExpressionUUID->"1e7a836e-4bcc-4e54-b40a-12678c66b130"],

Cell[BoxData[
 RowBox[{"Expand", "[", 
  RowBox[{"TrigExpand", "[", 
   RowBox[{"gap", " ", "-", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m", " ", "=", " ", 
        RowBox[{"FromSphericalCoordinates", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], "}"}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"n1", " ", ".", " ", "n2"}], " ", "-", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"m", " ", ".", " ", "n1"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"m", " ", ".", " ", "n2"}], ")"}]}]}], ")"}], "^", "2"}]}],
      "]"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"460c1e41-824c-4784-9d0f-e4da2f4b457b"],

Cell[TextData[{
 "So ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], "=", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"], "\[CenterDot]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "2"], "-", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["m", "TI"], "^"], "\[CenterDot]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["m", "TI"], "^"], "\[CenterDot]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox[")",
     FontSize->1.2 Inherited], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a78d4cf-aad9-4478-a96a-92578a148958"],
 ", and the minimum-uncertainty states are the zero-covariance states, the \
solutions of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["m", "TI"], "^"], "\[CenterDot]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["m", "TI"], "^"], "\[CenterDot]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"], "\[CenterDot]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36bf7c81-c9e3-42ed-97a9-1a6e69533646"],
 ". The eigenstates ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["m", "TI"], "^"], "=", "\[PlusMinus]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "1"]}], ",", 
   RowBox[{"\[PlusMinus]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04b63008-5ea9-4963-b6f4-1b48f3b8fb4a"],
 " always solve it (the two signs cancel and one variance vanishes). For the \
mutually unbiased pair ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f7d1c2c-424f-4e28-b493-cc9d263977f7"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], "=", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f97522b8-8b74-4003-9fec-711b588e7a24"],
 " (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"], "\[CenterDot]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24896510-3fba-4705-baa4-9411245cec9a"],
 "), solve the condition on the sphere."
}], "Text",ExpressionUUID->"38fd43dd-b842-4639-82dd-65ea8d35d14f"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", " ", "=", " ", 
          RowBox[{"FromSphericalCoordinates", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], "}"}], 
           "]"}]}], "}"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"m", " ", ".", " ", "n1"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"m", " ", ".", " ", "n2"}], ")"}]}], " ", "==", " ", 
         RowBox[{"n1", " ", ".", " ", "n2"}]}]}], "]"}], " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]1", " ", "->", " ", 
         RowBox[{"Pi", "/", "2"}]}], ",", " ", 
        RowBox[{"\[Phi]1", " ", "->", " ", "0"}], ",", " ", 
        RowBox[{"\[Theta]2", " ", "->", " ", "0"}]}], "}"}]}], ")"}], " ", "&&",
     " ", 
    RowBox[{"0", " ", "<", " ", "\[Theta]", " ", "<", " ", "Pi"}], " ", "&&", 
    " ", 
    RowBox[{
     RowBox[{"-", "Pi"}], " ", "<", " ", "\[Phi]", " ", "<=", " ", "Pi"}]}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"0496e063-f59e-40f0-8555-39a0c2a1775e"],

Cell[TextData[{
 "One such state sits where the two solution branches cross, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", 
   StyleBox["\[Phi]", "TI"], "=", 
   FractionBox["\[Pi]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "152f87c6-0123-4dc7-8326-56a912e500aa"],
 "."
}], "Text",ExpressionUUID->"8090f704-f262-43c5-80e9-9bdbd9fbe1a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], " ", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]", " ", "->", " ", 
      RowBox[{"Pi", "/", "2"}]}], ",", " ", 
     RowBox[{"\[Phi]", " ", "->", " ", 
      RowBox[{"Pi", "/", "2"}]}]}], "}"}]}], " ", "//", " ", 
  "FullSimplify"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"98362a31-8419-4f28-bcee-989e479a7a0e"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same gap through the paclet's objects (state, operators, ",
 Cell[BoxData["Commutator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8125e582-97d2-497b-820c-cb4955207dba"],
 "); it is the ",
 Cell[BoxData["==="], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36cb1470-59f9-4881-89a8-55206dc6ace3"],
 "-identical expression."
}], "Text",ExpressionUUID->"7ccea0a6-16e4-4214-bbc4-747294e1680d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"psi", " ", "=", " ", 
       RowBox[{"QuantumState", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], "]"}]}], ",", 
      "\n", "  ", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{"FromSphericalCoordinates", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "\[Theta]1", ",", " ", "\[Phi]1"}], "}"}], 
          "]"}], " ", ".", " ", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], 
        "]"}]}], ",", "\n", "  ", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{"FromSphericalCoordinates", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "\[Theta]2", ",", " ", "\[Phi]2"}], "}"}], 
          "]"}], " ", ".", " ", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], 
        "]"}]}]}], "}"}], ",", "\n", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ev", " ", "=", " ", 
        RowBox[{
         RowBox[{"Simplify", "[", 
          RowBox[{"ComplexExpand", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"psi", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
              RowBox[{"#", " ", "@", " ", "psi"}]}], ")"}], 
            "[", "\"\<Scalar\>\"", "]"}], "]"}], "]"}], " ", "&"}]}], "}"}], ",",
       "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ev", "[", 
           RowBox[{"a", " ", "@", " ", "a"}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"ev", "[", "a", "]"}], "^", "2"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ev", "[", 
           RowBox[{"b", " ", "@", " ", "b"}], "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"ev", "[", "b", "]"}], "^", "2"}]}], ")"}]}], " ", "-", 
       " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ev", "[", 
           RowBox[{"Commutator", "[", 
            RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "I"}], ")"}]}], ")"}], "^", "2"}]}]}], "]"}]}], 
   "]"}], " ", "===", " ", "gap"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"0e402747-5c69-4f85-a57e-c93b6896ba30"],

Cell[TextData[{
 "For a qubit, then, ",
 StyleBox["every", "TI"],
 " pure state already saturates the full Robertson-Schrodinger relation, and \
the plain Robertson bound is additionally reached exactly on the \
zero-covariance set. For ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], ",", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6dcde50-d3ff-4153-9b30-57af9d7855d2"],
 " the solve returns that set as the equator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", 
   FractionBox["\[Pi]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbaf695a-71c7-475b-b97e-617d0ec7fca0"],
 " (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4a27010-2c9b-4bbe-95db-95424efb0d9c"],
 ") and the meridians ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Phi]", "TI"], "=", "\[PlusMinus]", 
   FractionBox["\[Pi]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df9f9b45-6fa6-4ef9-b50e-53fd3d42b55a"],
 " (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["X", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e6b6390-71eb-44d0-a60a-16989af5b3e5"],
 "); at their crossing both means vanish and the state is the ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "351f2313-cd26-4221-b00a-6fe749cc2fe4"],
 " eigenstate ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", 
   RowBox[{
    StyleBox["i", "TI"], "}", "/", 
    SqrtBox["2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9e2a710-5d21-42c9-b121-cbe6ee8e168c"],
 ", the most symmetric minimum-uncertainty state."
}], "Text",ExpressionUUID->"877a8093-b513-4767-8abe-273a2aa29ac7"],

Cell[TextData[{
 "6.3 [BSc] How do I compute the classical Shannon entropy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2df48282-39f2-4fe2-82e0-75bfcf560ed7"],
 " of a measurement distribution?"
}], "Subsection",ExpressionUUID->"1e18e20e-1678-4a9b-9f96-caf958930646"],

Cell[TextData[{
 "A measurement yields a probability distribution; its Shannon entropy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdb405ab-9438-441d-bdcd-a9669ec00ca8"],
 " (in bits) measures the outcome uncertainty. Take the ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2609f30f-415f-4cab-b701-c25b22e6050c"],
 " distribution of a state with populations ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    FractionBox["3", "4"]}], ",", 
   RowBox[{
    FractionBox["1", "4"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b1e44aa-891a-4eea-b9e8-11d910e17c8f"],
 "."
}], "Text",ExpressionUUID->"5b739b18-1943-4624-8a0d-9e621a786d8a"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the entropy is the negative weighted sum of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["log",
    FontSlant->"Plain"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98d0c161-60fc-4c88-9627-ad715608a6f8"],
 " probabilities."
}], "Text",ExpressionUUID->"967250d7-00c2-4162-88ea-b2e3aa7c2458"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{"Total", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"#", " ", 
      RowBox[{"Log2", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"3", "/", "4"}], ",", " ", 
      RowBox[{"1", "/", "4"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"64d2b87d-82a9-4df1-9a9d-20484037ec5d"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : a ",
 Cell[BoxData["QuantumMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fb3811f-89cd-4c1d-bf8d-dc4e0c077d0a"],
 " reports its ",
 Cell[BoxData["\"\<Entropy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c45c5af3-96c9-466f-b1af-aaa9382349aa"],
 " directly, as a ",
 Cell[BoxData["Quantity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "490aa918-0346-4d19-92a5-368ebaf6a9da"],
 " in bits."
}], "Text",ExpressionUUID->"63af7da1-950f-4db5-985b-267dbf07964c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumMeasurementOperator", "[", 
    RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "]"}], "[", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}], ",", " ", 
      RowBox[{"1", "/", "2"}]}], "}"}], "]"}], "]"}], "[", "\"\<Entropy\>\"", 
  "]"}]], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"401f9d0f-8695-4289-a369-0800551b8344"],

Cell[TextData[{
 "Both give ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox["3", "4"], 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox["3", "4"], "-", 
   FractionBox["1", "4"], 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox["1", "4"], "\[TildeTilde]", "0.811"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6451e3b8-32f5-43aa-94d7-fec11237bd33"],
 " bits: a biased two-outcome distribution carries less than one bit, \
reaching exactly one bit only for the uniform ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    FractionBox["1", "2"]}], ",", 
   RowBox[{
    FractionBox["1", "2"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c35ee0b6-01e1-454a-8178-0224fe20b9ff"],
 "."
}], "Text",ExpressionUUID->"57c392af-1282-492d-89f0-32f9bedb25d2"],

Cell["\<\
6.4 [MSc] How do I construct a maximal set of mutually unbiased bases for a \
qubit?\
\>", "Subsection",ExpressionUUID->"afd7d197-4be4-4c89-a51c-332264554ee9"],

Cell[TextData[{
 "Two bases are mutually unbiased when every cross-overlap is flat, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{
         StyleBox["e", "TI"], 
         StyleBox["f", "TI"]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", "1", "/", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf9a8f9c-cd5e-4bf8-8911-c174cc9b12cc"],
 ": a definite state in one is maximally uncertain in the other. A set of \
bases is mutually unbiased when every pair in it is, and ",
 StyleBox["maximal", "TI"],
 " when no further basis can be added that stays unbiased to every member. \
The construction has three steps: derive the form of a basis unbiased to the \
computational one, solve for the phase separation that makes two such \
families mutually unbiased, then show the set cannot be extended."
}], "Text",ExpressionUUID->"97a690e9-efbc-4bfa-9772-d40034cd7e0e"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : a second basis ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["u", "TI"]}], ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["u", "TI"], "\[Perpendicular]"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4f9f168-c372-4d05-99d4-df9710c80416"],
 " is unbiased to the computational one when ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{"0", 
         StyleBox["u", "TI"]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{"1", 
         StyleBox["u", "TI"]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1616bba-4663-4938-961d-5ac98827c864"],
 ". Write the candidate amplitudes in polar form, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["u", "TI"], "=", "{", 
    SubscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["a", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubscriptBox[
       StyleBox["\[Delta]", "TI"], 
       StyleBox["a", "TI"]]}]]}], ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["b", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      SubscriptBox[
       StyleBox["\[Delta]", "TI"], 
       StyleBox["b", "TI"]]}]], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230bc1fe-5821-4f0b-8d4e-35a17ccd8f7b"],
 ", and solve the two conditions."
}], "Text",ExpressionUUID->"349e5b51-756a-4912-9367-85c292c437aa"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"ra", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "\[Delta]a"}], "]"}]}], "]"}], "^", "2"}], " ", "==",
      " ", 
     RowBox[{"1", "/", "2"}]}], " ", "&&", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"rb", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "\[Delta]b"}], "]"}]}], "]"}], "^", "2"}], " ", "==",
      " ", 
     RowBox[{"1", "/", "2"}]}], " ", "&&", " ", 
    RowBox[{"ra", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"rb", " ", ">=", " ", "0"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
    "ra", ",", " ", "rb", ",", " ", "\[Delta]a", ",", " ", "\[Delta]b"}], 
    "}"}], ",", " ", "Reals"}], "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"05d73642-aed3-429e-a8d8-f29bc5876c49"],

Cell[TextData[{
 "Both moduli are forced to ",
 Cell[BoxData[
  FractionBox["1", 
   SqrtBox["2"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f0467dc-2076-4b20-9327-5acf74788e9d"],
 " and neither phase is constrained. Discarding the physically irrelevant \
global phase (Part 1) leaves the one-parameter family ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["u", "TI"], "=", "{", "1"}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox[
      RowBox[{"i", "\[Alpha]"}], "TI"]], "}", "/", 
    SqrtBox["2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "956cd9f6-fa0e-4dfd-a277-12e7701f4b0b"],
 ", and orthogonality then fixes its partner to ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["u", "TI"], "\[Perpendicular]"], "=", "{", "1"}], ",", 
   RowBox[{"-", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox[
      RowBox[{"i", "\[Alpha]"}], "TI"]], "}", "/", 
    SqrtBox["2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbc322a-7f05-4e67-84d7-70476e78da6a"],
 " up to phase. Two such families ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb4de904-b937-48ad-9fe7-718a3d69e09d"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd22c25c-8f4a-45b6-bdd8-c2328023b23f"],
 " are themselves mutually unbiased only at a special separation; only the \
difference matters, so fix ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f16f621-086d-450f-b1f4-5b8d44586aab"],
 " and solve for ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afaf0b9a-254e-40ca-91e9-a3ffbe568590"],
 "."
}], "Text",ExpressionUUID->"e316a414-cc83-4e8a-895f-d2ce55ddf274"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ov", " ", "=", " ", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Conjugate", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1"}], "}"}], "/", 
            RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], " ", ".", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"I", " ", "\[Beta]"}], "]"}]}], "}"}], "/", 
            RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}], "]"}], "^", "2"}], ",",
        " ", 
       RowBox[{"\[Beta]", " ", "\[Element]", " ", "Reals"}]}], "]"}]}], "}"}],
    ",", "\n", " ", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ov", " ", "==", " ", 
       RowBox[{"1", "/", "2"}]}], " ", "&&", " ", 
      RowBox[{"0", " ", "<=", " ", "\[Beta]", " ", "<", " ", 
       RowBox[{"2", " ", "Pi"}]}]}], ",", " ", "\[Beta]"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"80dac57f-3188-4843-96fc-8559716cacac"],

Cell[TextData[{
 "The two solutions ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], "=", 
   FractionBox["\[Pi]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de1a5c39-e608-4cbe-94be-154d25326fc7"],
 " and ",
 Cell[BoxData[
  FractionBox[
   RowBox[{"3", "\[Pi]"}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e049a3c-e932-4c92-b197-cc23be51fa78"],
 " are one and the same basis with its two vectors exchanged (",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"3", 
     StyleBox["i", "TI"], "\[Pi]", "/", "2"}]], "=", "-", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "\[Pi]", "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75fa1d89-f46b-485b-a9fb-f643a20a108d"],
 "), so exactly one new basis appears and the set holds three: computational, \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c42c9485-9857-41a0-b548-1f9c9e591a1b"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", 
   FractionBox["\[Pi]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "600b9846-68c1-41c5-801a-f2cb0b32894f"],
 ". Maximality is the claim that no fourth basis can join. A fourth basis \
would again be unbiased to the computational one, hence of the same family \
form at some phase ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "89e5e5a1-5721-4fd3-a45d-494d7abfe562"],
 ", and simultaneously unbiased to both the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0aaddea-b204-46b9-9aa2-3b3d94368b45"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", 
   FractionBox["\[Pi]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dce60ce5-26b4-4be3-9809-8a4c58a2be6e"],
 " families; solve for ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "627487cf-00bb-40bc-8af5-5dad96e279b3"],
 "."
}], "Text",ExpressionUUID->"fb623aa5-36db-44f1-9d15-0c15d3be1d72"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ov", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "#1"}], "]"}]}], "}"}], "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], " ", ".", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "#2"}], "]"}]}], "}"}], "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}], "]"}], "^", "2"}], " ",
       "&"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"ov", "[", 
           RowBox[{"0", ",", " ", "\[Gamma]"}], "]"}], " ", "==", " ", 
          RowBox[{"1", "/", "2"}]}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"ov", "[", 
           RowBox[{
            RowBox[{"Pi", "/", "2"}], ",", " ", "\[Gamma]"}], "]"}], " ", "==",
           " ", 
          RowBox[{"1", "/", "2"}]}]}], ",", " ", 
        RowBox[{"\[Gamma]", " ", "\[Element]", " ", "Reals"}]}], "]"}], " ", "&&",
       " ", 
      RowBox[{"0", " ", "<=", " ", "\[Gamma]", " ", "<", " ", 
       RowBox[{"2", " ", "Pi"}]}]}], ",", " ", "\[Gamma]"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"b057e44f-e2f6-4f4c-8164-e8554f7650da"],

Cell["\<\
No phase survives both conditions: the three bases cannot be extended, and \
the set is maximal. Assemble it.\
\>", "Text",ExpressionUUID->"2d9af2f9-afae-4b3f-ae6a-417be6c96b62"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mub", " ", "=", " ", 
     RowBox[{"Function", "[", 
      RowBox[{"a", ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "a"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"-", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "a"}], "]"}]}]}], "}"}]}], "}"}], "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"mub", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"Pi", "/", "2"}]}], "}"}]}], ",", " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"f4af9d84-a023-4af8-92b7-21ac8a06344d"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : those three constructed bases are (up to phase) the eigenbases of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Z", "TI"], ",", 
   StyleBox["X", "TI"], ",", 
   StyleBox["Y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09ea53e7-6b57-4f10-88d3-0d20ab360f76"],
 "; read them off the operators."
}], "Text",ExpressionUUID->"1284a031-b587-4e1f-bf9d-c058db9fac8a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Function", "[", 
   RowBox[{"A", ",", " ", 
    RowBox[{"Normal", " ", "/@", " ", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", "A", "]"}], "[", "\"\<Eigenvectors\>\"",
       "]"}]}]}], "]"}], " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{"\"\<Z\>\"", ",", " ", "\"\<X\>\"", ",", " ", "\"\<Y\>\""}], 
   "}"}]}]], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"f730efa4-8777-4d29-8db6-a9028e79ef2c"],

Cell[TextData[{
 "Solving the unbiasedness conditions delivers three bases and proves no \
fourth exists: the maximal count for a qubit is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "+", "1", "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6002ecf7-62f9-4ac4-9c1d-58a261bd27e8"],
 " (the qubit case of the general prime-power-dimension result), and the \
bases are the computational (",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8632410a-a34a-41b7-acd1-e79867535102"],
 ") basis and the phase families at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f4be29e-1b64-450f-9e18-41c7c2655648"],
 " and ",
 Cell[BoxData[
  FractionBox["\[Pi]", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e3eb583-7eb8-4dbf-bcda-196ddb14b2d0"],
 ", which are the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f99e289d-de13-4389-b6e1-d84436e05e8c"],
 " and ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "594b3bc1-47b0-46b7-8b17-d05fe513be63"],
 " eigenbases."
}], "Text",ExpressionUUID->"f1f42cd0-c5cb-42d1-8445-ef25cb2c9fb2"],

Cell[TextData[{
 "6.4b [BSc] How do I verify that given bases are pairwise mutually unbiased, \
i.e. every cross-overlap satisfies ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["j", "TI"]]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", "1", "/", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc2fa528-a137-4787-8f2d-fb03ee3f9b0e"],
 "?"
}], "Subsection",ExpressionUUID->"86c3bcb8-d86e-4aa1-9e9a-cac949c47162"],

Cell[TextData[{
 "Given candidate bases ",
 Cell[BoxData[
  RowBox[{"{", 
   TemplateBox[{
     SubscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["i", "TI"]]},
    "Ket"], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a261a1b0-1328-4f22-bd42-af28f406237b"],
 ", ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    TemplateBox[{
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["j", "TI"]]},
     "Ket"], "}"}], ",", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "334f2333-db63-4a94-a1bf-0a1533cf74aa"],
 ", the test is the definition itself: for every pair of ",
 StyleBox["different", "TI"],
 " bases, ",
 StyleBox["every", "TI"],
 " cross-overlap between their members must equal ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["j", "TI"]]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", "1", "/", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5944cf8d-b4bd-499c-a10f-db8545c2cfea"],
 "; a single deviating entry disqualifies the set. Run the test on the three \
bases constructed in 6.4 in their operator form, the eigenbases of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], ",", 
   StyleBox["Y", "TI"], ",", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c48282c3-b3f3-49f2-9902-0fff135baec8"],
 " (here ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f298ee8e-6b77-4734-9958-f3c01d331db3"],
 ", so the target value is ",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b8c5a59-78e1-4d6b-baa5-0b98b02beb66"],
 ")."
}], "Text",ExpressionUUID->"3a3523bf-2744-4f41-9487-7380b799fbb8"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : form the three eigenbases and compute the full overlap matrix for each \
of the three pairs."
}], "Text",ExpressionUUID->"44954478-b2d5-47bc-bbff-dc5e2bd6d4d3"],

Cell[BoxData[
 RowBox[{"ovs", " ", "=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"bx", " ", "=", " ", 
       RowBox[{"Normalize", " ", "/@", " ", 
        RowBox[{"Eigenvectors", "[", 
         RowBox[{"PauliMatrix", "[", "1", "]"}], "]"}]}]}], ",", " ", 
      RowBox[{"by", " ", "=", " ", 
       RowBox[{"Normalize", " ", "/@", " ", 
        RowBox[{"Eigenvectors", "[", 
         RowBox[{"PauliMatrix", "[", "2", "]"}], "]"}]}]}], ",", " ", 
      RowBox[{"bz", " ", "=", " ", 
       RowBox[{"Normalize", " ", "/@", " ", 
        RowBox[{"Eigenvectors", "[", 
         RowBox[{"PauliMatrix", "[", "3", "]"}], "]"}]}]}]}], "}"}], ",", 
    "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Outer", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Conjugate", "[", "#1", "]"}], " ", ".", " ", "#2"}], 
           "]"}], "^", "2"}], " ", "&"}], ",", " ", 
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", "1"}], "]"}], " ", "&"}], 
     " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"bx", ",", " ", "by"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"bx", ",", " ", "bz"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"by", ",", " ", "bz"}], "}"}]}], "}"}]}]}], "]"}]}]], "Input",\

 CellLabel->
  "In[17]:= ",ExpressionUUID->"1eb629f4-bf95-4203-b3ab-e1445332a312"],

Cell[TextData[{
 "The verdict collapses all twelve cross-overlaps to their set of distinct \
values; the test passes exactly when that set is ",
 Cell[BoxData[
  RowBox[{"{", "1", "/", 
   StyleBox["d", "TI"], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04f662bc-51dc-4736-90a0-8f51b2ac82d4"],
 "."
}], "Text",ExpressionUUID->"24f18975-db3e-411a-853e-5c4e6cc52031"],

Cell[BoxData[
 RowBox[{"Union", "[", 
  RowBox[{"Flatten", "[", "ovs", "]"}], "]"}]], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"3fa4bab4-cafa-49a0-9d93-a0dc0ae70800"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same test from the operators' ",
 Cell[BoxData["\"\<Eigenvectors\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "135fb9da-5a59-40de-8b0b-e69b97fb79ef"],
 ", over all pairs at once."
}], "Text",ExpressionUUID->"b6931b53-4aac-4e23-b3b7-504077f44264"],

Cell[BoxData[
 RowBox[{"Union", " ", "@", " ", 
  RowBox[{"Flatten", " ", "@", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"A", ",", " ", 
          RowBox[{"Normal", " ", "/@", " ", 
           RowBox[{
            RowBox[{"QuantumOperator", "[", "A", "]"}], 
            "[", "\"\<Eigenvectors\>\"", "]"}]}]}], "]"}], " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\""}], 
         "}"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Conjugate", "[", "#1", "]"}], " ", ".", " ", "#2"}], 
            "]"}], "^", "2"}], " ", "&"}], ",", " ", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", " ", "1"}], "]"}], " ", "&"}], 
      " ", "/@", " ", 
      RowBox[{"Subsets", "[", 
       RowBox[{"b", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"a469b080-8f5a-4073-88e0-35c18e5a816c"],

Cell[TextData[{
 "Every cross-overlap between different bases collapses to the single value \
",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], "=", "1", "/", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb600f9e-ce1c-4db7-9832-87a260937b94"],
 ": the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], ",", 
   StyleBox["Y", "TI"], ",", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5f6c31c-fb67-4279-852d-069b0be7e4ce"],
 " eigenbases are pairwise mutually unbiased, confirming they are the three \
MUBs of a qubit. The collapse to a one-element set is what gives the test \
teeth: any deviating overlap would survive as a second element."
}], "Text",ExpressionUUID->"43352407-e04e-4389-9901-57b3cc8addbf"],

Cell[TextData[{
 "6.5 [MSc] How do I verify the Maassen-Uffink entropic uncertainty relation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["B", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[GreaterEqual]", "-", 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["c", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88b36295-cc1c-47b1-b236-cb63cf30c097"],
 ", with ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4159f03e-e2fb-4715-9fd1-c6cdc82f1c2a"],
 " the largest overlap between eigenstates of ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7b5d462-9eef-4de7-bf3b-a69faea99420"],
 " and ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d15da7c1-e9ea-4e9d-9278-3981dd26ffc0"],
 "?"
}], "Subsection",ExpressionUUID->"f510b946-ca7d-410e-81ae-612569c604f2"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe03cd80-7b6b-42da-bc18-3e0642742047"],
 " denote the Shannon entropy (6.3) of the outcome distribution of measuring \
the observable ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f148dbc-c71f-43e7-a571-06b7c7b84af9"],
 ", and let ",
 Cell[BoxData[
  RowBox[{"{", 
   TemplateBox[{
     SubscriptBox[
      StyleBox["a", "TI"], 
      StyleBox["j", "TI"]]},
    "Ket"], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8cf0409-357b-4f24-b860-97ff6892357d"],
 " and ",
 Cell[BoxData[
  RowBox[{"{", 
   TemplateBox[{
     SubscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["k", "TI"]]},
    "Ket"], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b25fd38e-3493-441d-a5cb-7466185a17b4"],
 " be the eigenstates of ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f26cc59b-9e8e-4dc2-99fe-b088304d7865"],
 " and of ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ddfc2a0-7910-4bf9-a7ec-6390b9a801d0"],
 ". The Maassen-Uffink relation bounds the summed entropies for ",
 StyleBox["every", "TI"],
 " state, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["B", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[GreaterEqual]", "-", 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["c", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e676ec6-4fb6-4825-b959-8e0175520755"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], "=", 
   UnderscriptBox[
    StyleBox["max",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["j", "TI"], ",", 
     StyleBox["k", "TI"]}],
    LimitsPositioning->False], GridBox[{
     {
      TemplateBox[{
        SubscriptBox[
         StyleBox["a", "TI"], 
         StyleBox["j", "TI"]], 
        SubscriptBox[
         StyleBox["b", "TI"], 
         StyleBox["k", "TI"]]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a76ff6cd-e309-4bcf-920f-9d341da590d6"],
 " is the largest overlap between the two eigenbases; the bound involves only \
the observables, not the state. The pair of observables is itself kept \
general: as in 6.1, identity shifts and scales drop out, and a global \
rotation changes no entropy and no overlap, so a general qubit pair reduces \
to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], "=", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cda2ab16-27b8-4558-af90-c28afaa7bba8"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], 
    StyleBox["\[Gamma]", "TI"]], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fbd2ae62-9670-4f5d-aa55-280fb3683484"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], 
    StyleBox["\[Gamma]", "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Gamma]", "TI"]}], ",", "0", ",", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Gamma]", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dcb0835-1da1-48c4-9234-f0054e755570"],
 "; the one genuine invariant is the angle ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b7210d4-df1f-4405-9bad-fef798f47af2"],
 " between the two Bloch axes, folded into ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    FractionBox["\[Pi]", "2"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b0d6d6d5-a0ea-44b1-9c85-4f7242069196"],
 " since ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "\[Rule]", "-", 
   OverscriptBox[
    StyleBox["n", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b7d3ace-58e5-46c1-b702-2e99621d8d71"],
 " only relabels outcomes. Verify the relation for every pair and every state \
at once: derive ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d83207fa-9721-4893-b29e-8ab31ec76f68"],
 " and the bound, find which ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "712b6fc8-ea17-4f60-8ad2-b2203e117598"],
 " carries the strongest bound, then minimize the entropy sum minus the bound \
over the state and the pair together. The minimum over mixed states lies on \
the pure sphere: scaling a Bloch vector out to the sphere grows the \
projection on both axes at once, lowering both entropies."
}], "Text",ExpressionUUID->"c3a33234-8dfe-4110-b293-641b902d8541"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : every cross-overlap between the two eigenbases at once, from the \
rank-one projector identity ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], 
         SubscriptBox[
          StyleBox["b", "TI"], 
          StyleBox["k", "TI"]]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubsuperscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["j", "TI"], 
     StyleBox["A", "TI"]], 
    SubsuperscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["k", "TI"], 
     StyleBox["B", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a055dc9-afd3-40f5-9237-107f0b6b352a"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], "\[PlusMinus]"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "\[PlusMinus]", 
    StyleBox["A", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f481f15a-b11b-4415-b461-af8ae6be561d"],
 " the spectral projectors of a ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed52873b-2d0c-4854-a77f-40e9692e5185"],
 " observable."
}], "Text",ExpressionUUID->"596c3cda-8d36-4e02-a674-c759579416fe"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
           RowBox[{"s1", " ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Sin", "[", "\[Gamma]", "]"}], ",", " ", "0", ",", " ", 
               RowBox[{"Cos", "[", "\[Gamma]", "]"}]}], "}"}], " ", ".", " ", 
             
             RowBox[{"PauliMatrix", "[", 
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], 
              "]"}]}]}]}], ")"}], "/", "2"}], ")"}], " ", ".", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
           RowBox[{"s2", " ", 
            RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], ")"}], "/", "2"}], 
        ")"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s1", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s2", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"0", " ", "<=", " ", "\[Gamma]", " ", "<=", " ", 
    RowBox[{"Pi", "/", "2"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"1035a62d-a145-429a-bfea-3d889a67d79f"],

Cell[TextData[{
 "The four overlaps are ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["\[Gamma]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d8f95d7-294c-4d7b-82d7-65c2a4f2a22b"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["\[Gamma]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d3eb44e-3af7-4702-bd42-0e56b2eff46d"],
 "; on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    FractionBox["\[Pi]", "2"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23df2c3b-8ad2-4453-9c50-dadd181a1240"],
 " the largest is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["c", "TI"], "2"], "=", 
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["\[Gamma]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "354ae6a5-be8d-41df-a63e-5ee4806ac437"],
 ", so the bound is ",
 Cell[BoxData[
  RowBox[{"-", 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["\[Gamma]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f4a414c-20a5-4e8d-aede-359fd307693a"],
 ". Ask which pair carries the strongest bound."
}], "Text",ExpressionUUID->"01fa48f6-1d14-4c39-ab02-3a672a6591f3"],

Cell[BoxData[
 RowBox[{"Maximize", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Log2", "[", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[Gamma]", "/", "2"}], "]"}], "^", "2"}], "]"}]}], ",", " ", 
     RowBox[{"0", " ", "<=", " ", "\[Gamma]", " ", "<=", " ", 
      RowBox[{"Pi", "/", "2"}]}]}], "}"}], ",", " ", "\[Gamma]"}], 
  "]"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"e73b74c3-3b2b-439b-843a-3dd899729af8"],

Cell[TextData[{
 "The bound is strongest, one full bit, exactly at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   FractionBox["\[Pi]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b865c3e-1fd9-466f-8367-106ca728848c"],
 ": the mutually unbiased pair of 6.4b, which is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], ",", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e690018c-f2be-40dd-84db-7e562b7b7483"],
 " up to rotation. A commuting pair (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c705ef8-1a67-4b9a-9eeb-a95358dc2cc3"],
 ") has ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a075d488-e9ee-43f7-8d6d-854f2b71c78d"],
 " and bound ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0c7a7dc-f65a-4aa6-9975-931e1559fbc4"],
 ", a vacuous statement. Now build the entropy sum for the generic pair over \
the whole pure family: the Born weights of a ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca089ea3-ff95-4860-9b94-d68a3716ec31"],
 " observable are ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], "\[PlusMinus]"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["A", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "909a412a-4d56-4a26-9dba-31da9dc237b6"],
 ", ",
 Cell[BoxData["ComplexExpand"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1965f6a2-8d0d-470b-b528-c1b8743e8127"],
 " renders each mean as a manifestly real function of the angles, and the ",
 Cell[BoxData["If"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7baf77e-b1c1-4851-bf14-d453ae26bd8e"],
 " keeps the convention ",
 Cell[BoxData[
  RowBox[{"0", 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "0", "=", "0"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ad7f306-b692-4cdf-a9ed-7664b249afca"],
 " explicit."
}], "Text",ExpressionUUID->"6dcab1be-8f7c-48da-b279-e0b8e9b6e4e2"],

Cell[BoxData[
 RowBox[{"hsum", " ", "=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"psi", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}]}], ",", " ", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Gamma]", "]"}], ",", " ", "0", ",", " ", 
          RowBox[{"Cos", "[", "\[Gamma]", "]"}]}], "}"}], " ", ".", " ", 
        RowBox[{"PauliMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], ",", 
      " ", 
      RowBox[{"z", " ", "=", " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}], ",", " ", 
      RowBox[{"h", " ", "=", " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"#", " ", "==", " ", "0"}], ",", " ", "0", ",", " ", 
                RowBox[{"#", " ", 
                 RowBox[{"Log2", "[", "#", "]"}]}]}], "]"}], " ", "&"}], "[", 
             "#", "]"}], " ", "&"}], " ", "/@", " ", "#"}], "]"}]}], " ", 
        "&"}]}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ev", " ", "=", " ", 
        RowBox[{
         RowBox[{"Simplify", "[", 
          RowBox[{"ComplexExpand", "[", 
           RowBox[{
            RowBox[{"Conjugate", "[", "psi", "]"}], " ", ".", " ", "#", " ", ".",
             " ", "psi"}], "]"}], "]"}], " ", "&"}]}], "}"}], ",", "\n", 
      "   ", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"ev", "[", "a", "]"}]}], ")"}], "/", "2"}], ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"ev", "[", "a", "]"}]}], ")"}], "/", "2"}]}], "}"}], 
        "]"}], " ", "+", " ", 
       RowBox[{"h", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"ev", "[", "z", "]"}]}], ")"}], "/", "2"}], ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"ev", "[", "z", "]"}]}], ")"}], "/", "2"}]}], "}"}], 
        "]"}]}]}], "]"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"5ef79b17-1fcb-40f5-b034-d2f6314c16c0"],

Cell["\<\
Minimize the slack, the entropy sum minus the bound, over the state and the \
pair together.\
\>", "Text",ExpressionUUID->"97d0f51b-a64f-4d74-a76e-a3ab8f943376"],

Cell[BoxData[
 RowBox[{"NMinimize", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"hsum", " ", "+", " ", 
      RowBox[{"Log2", "[", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[Gamma]", "/", "2"}], "]"}], "^", "2"}], "]"}]}], ",", " ", 
     RowBox[{"0", " ", "<=", " ", "\[Gamma]", " ", "<=", " ", 
      RowBox[{"Pi", "/", "2"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", "\[Phi]", ",", " ", "\[Gamma]"}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"5e7a3f64-17b0-4404-8697-0d64adba3252"],

Cell[TextData[{
 "The slack never drops below zero (the minimum is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c65a673-54ad-47e9-8a8e-3f2c39b43575"],
 " to machine precision, ",
 Cell[BoxData[
  RowBox[{"\[Tilde]", "3", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "16"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08fbfe86-bab9-4420-8b63-3c55d56d9621"],
 "): Maassen-Uffink holds for every qubit pair and every state at once. The \
minimizer sits at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   FractionBox["\[Pi]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "effcabcf-e691-4abb-a305-e507e14c4781"],
 ", so park there, the strongest-bound pair, and minimize the entropy sum \
itself."
}], "Text",ExpressionUUID->"0d13e0fa-0902-40fa-b345-0a87b65af3d2"],

Cell[BoxData[
 RowBox[{"NMinimize", "[", 
  RowBox[{
   RowBox[{"hsum", " ", "/.", " ", 
    RowBox[{"\[Gamma]", " ", "->", " ", 
     RowBox[{"Pi", "/", "2"}]}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"0781e345-9dfc-4889-ac5b-635f271d2dc6"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same objective through the paclet's objects, each mean from the \
object sandwich ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"psi", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
     RowBox[{"op", " ", "@", " ", "psi"}]}], ")"}], "[", "\"\<Scalar\>\"", 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ec6b5f2-9e61-4481-8374-fb4d36968b51"],
 "; it is the ",
 Cell[BoxData["==="], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b61e8666-5fbe-4790-84f1-ad25270b3022"],
 "-identical expression, so both scans above apply to it verbatim."
}], "Text",ExpressionUUID->"56ef5771-de96-42dc-aabe-d7908f74e7fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"psi", " ", "=", " ", 
       RowBox[{"QuantumState", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], "]"}]}], ",", 
      "\n", "  ", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Gamma]", "]"}], ",", " ", "0", ",", " ", 
           RowBox[{"Cos", "[", "\[Gamma]", "]"}]}], "}"}], " ", ".", " ", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], 
        "]"}]}], ",", " ", 
      RowBox[{"z", " ", "=", " ", 
       RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], ",", "\n", "  ", 
      
      RowBox[{"h", " ", "=", " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"#", " ", "==", " ", "0"}], ",", " ", "0", ",", " ", 
                RowBox[{"#", " ", 
                 RowBox[{"Log2", "[", "#", "]"}]}]}], "]"}], " ", "&"}], "[", 
             "#", "]"}], " ", "&"}], " ", "/@", " ", "#"}], "]"}]}], " ", 
        "&"}]}]}], "}"}], ",", "\n", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ev", " ", "=", " ", 
        RowBox[{
         RowBox[{"Simplify", "[", 
          RowBox[{"ComplexExpand", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"psi", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
              RowBox[{"#", " ", "@", " ", "psi"}]}], ")"}], 
            "[", "\"\<Scalar\>\"", "]"}], "]"}], "]"}], " ", "&"}]}], "}"}], ",",
       "\n", "  ", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"ev", "[", "a", "]"}]}], ")"}], "/", "2"}], ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"ev", "[", "a", "]"}]}], ")"}], "/", "2"}]}], "}"}], 
        "]"}], " ", "+", " ", 
       RowBox[{"h", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"ev", "[", "z", "]"}]}], ")"}], "/", "2"}], ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"ev", "[", "z", "]"}]}], ")"}], "/", "2"}]}], "}"}], 
        "]"}]}]}], "]"}]}], "]"}], " ", "===", " ", "hsum"}]], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"9e080d78-0205-45d5-9e91-5e316a481ebb"],

Cell[TextData[{
 "At the maximally incompatible pair the minimum of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["X", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "daee549c-fa4b-42de-ae45-29a190f4c79f"],
 " is exactly the computed bound, ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ab67ebb-058b-492f-a4dc-2654f97b7783"],
 " bit, attained at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "\[TildeTilde]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e918eec-d8bc-491e-a804-047296a6a3be"],
 ", a ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d8447e2-029a-4651-8556-e5edafb62992"],
 " eigenstate: no qubit state is sharp in both ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56b94319-ae1c-4599-9104-029b27f41288"],
 " and ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63827d59-816b-4955-8998-9d075763adc8"],
 ", and the total uncertainty of a mutually unbiased pair can never drop \
below one full bit. The ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], ",", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb22ce62-5232-4d8a-9a3e-58d916977661"],
 " of 6.6 is therefore not a convenience choice but the extremal pair the ",
 Cell[BoxData["Maximize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b841ae61-722d-4a2c-8775-9710565ee12f"],
 " step singled out; which states attain its bound is 6.6's question."
}], "Text",ExpressionUUID->"09b62c4b-899c-49b4-b1fc-f73c15a8fb29"],

Cell[TextData[{
 "6.6 [MSc] How do I find the states that saturate the Maassen-Uffink \
entropic bound ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["X", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[GreaterEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "146bc93e-629d-4a69-8dc2-71fe7a882c5d"],
 " bit for the complementary ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], ",", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "83d51144-0a37-4e4d-96c1-9ffeca864db0"],
 " (maximal complementarity)?"
}], "Subsection",ExpressionUUID->"aca9a414-f566-4231-bfde-ac532a45a9a9"],

Cell[TextData[{
 "The bound of 6.5, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["X", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[GreaterEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a8dddf9-b85b-4478-b291-54e097de5510"],
 " bit for the mutually unbiased ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], ",", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b0cd9c6-6cee-41ab-b855-622fd3c7f769"],
 " (the extremal pair 6.5's ",
 Cell[BoxData["Maximize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08cdef29-642c-4383-aa98-d8c3c10afaee"],
 " singled out), is attained: 6.5's minimization bottomed out exactly there. \
Find ",
 StyleBox["which", "TI"],
 " states attain it. Work on the pure sphere (by 6.5's argument the minimum \
lives there): locate the candidates from the definition of the entropy, then \
check saturation exactly."
}], "Text",ExpressionUUID->"5105610f-2853-4f9f-8a79-6edee2ab020e"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the summed entropy over the whole pure family, the two Born \
distributions read from the eigenbases (6.4b)."
}], "Text",ExpressionUUID->"c2d25a7d-3f12-4047-a80f-622f07a56bd8"],

Cell[BoxData[
 RowBox[{"hsum", " ", "=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"psi", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}]}], ",", " ", 
      RowBox[{"h", " ", "=", " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"#", " ", "==", " ", "0"}], ",", " ", "0", ",", " ", 
                RowBox[{"#", " ", 
                 RowBox[{"Log2", "[", "#", "]"}]}]}], "]"}], " ", "&"}], "[", 
             "#", "]"}], " ", "&"}], " ", "/@", " ", "#"}], "]"}]}], " ", 
        "&"}]}]}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"ComplexExpand", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "psi"}], 
            "]"}], "^", "2"}], "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"(", 
        RowBox[{"Normalize", " ", "/@", " ", 
         RowBox[{"Eigenvectors", "[", 
          RowBox[{"PauliMatrix", "[", "1", "]"}], "]"}]}], ")"}]}], "]"}], 
     " ", "+", "\n", "   ", 
     RowBox[{"h", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"ComplexExpand", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "psi"}], 
            "]"}], "^", "2"}], "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"(", 
        RowBox[{"Normalize", " ", "/@", " ", 
         RowBox[{"Eigenvectors", "[", 
          RowBox[{"PauliMatrix", "[", "3", "]"}], "]"}]}], ")"}]}], "]"}]}]}],
    "]"}]}]], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"16105b58-d747-4c21-a7c1-ee3bd614704c"],

Cell["\<\
The landscape over the sphere shows a floor at one bit, touched only at \
isolated states.\
\>", "Text",ExpressionUUID->"7590a50d-ba5d-475b-a913-6e4f8312e843"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{"hsum", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", "0", ",", " ", "Pi"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Phi]", ",", " ", 
     RowBox[{"-", "Pi"}], ",", " ", "Pi"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]\>\"", ",", " ", "\"\<\[Phi]\>\"", ",", 
      " ", "\"\<H(X)+H(Z)\>\""}], "}"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[27]:= ",ExpressionUUID->"7709879f-83f3-429b-aef2-0355b3c48063"],

Cell[TextData[{
 "Locate those states exactly. A Shannon entropy vanishes only on a \
point-mass distribution (",
 Cell[BoxData[
  RowBox[{"-", 
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b497bc4c-52d5-4770-83ab-50430bcaeefd"],
 " forces every ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["i", "TI"]], "\[Element]", "{", "0"}], ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0eaf0515-0bba-4e72-9e6b-a72d5f26d88e"],
 "), so the candidates are the states ",
 StyleBox["sharp", "TI"],
 " in ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b78eed3-a2c9-427a-b5ed-85e70c2038af"],
 " or in ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5eb7b813-e4a2-4b5b-9cf3-86f0962e60a0"],
 ": for each observable, solve for where the product of its two outcome \
probabilities vanishes."
}], "Text",ExpressionUUID->"46d74f72-5977-4180-af3e-431be77e56f8"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"psi", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}]}], "}"}], ",", "\n",
    " ", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"A", ",", " ", 
      RowBox[{"Reduce", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{"ComplexExpand", "[", 
            RowBox[{"Times", " ", "@@", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", 
                   "psi"}], "]"}], "^", "2"}], " ", "&"}], " ", "/@", " ", 
               RowBox[{"(", 
                RowBox[{"Normalize", " ", "/@", " ", 
                 RowBox[{"Eigenvectors", "[", 
                  RowBox[{"PauliMatrix", "[", "A", "]"}], "]"}]}], ")"}]}], 
              ")"}]}], "]"}], "]"}], " ", "==", " ", "0"}], " ", "&&", "\n", 
         "     ", 
         RowBox[{"0", " ", "<=", " ", "\[Theta]", " ", "<=", " ", "Pi"}], " ",
          "&&", " ", 
         RowBox[{
          RowBox[{"-", "Pi"}], " ", "<", " ", "\[Phi]", " ", "<=", " ", 
          "Pi"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}]}], "]"}]}], "]"}], 
    " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"3", ",", " ", "1"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"38095843-e411-4855-8491-d0b29ed8b40e"],

Cell[TextData[{
 "The sharp states are the ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "331cdfbd-1385-4fe7-ae7b-a111aaa270be"],
 " eigenstates (the poles ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Theta]", "TI"], "=", "0"}], ",", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0afb560-1ecf-4052-9e31-dabe3502998a"],
 ", where ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1620457e-265a-4928-bcbb-afba8dedc7bf"],
 " is a redundant coordinate) and the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb0c11c6-184b-4cb7-9d91-6bb5af7f6e8c"],
 " eigenstates (on the equator at ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Phi]", "TI"], "=", "0"}], ",", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3f52aed-ac87-4476-8d00-aa51dc76190c"],
 "). Check saturation exactly at all of them."
}], "Text",ExpressionUUID->"92c3384a-4fc8-4ab5-88ba-c35023be341c"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"hsum", " ", "/.", " ", 
      RowBox[{"\[Theta]", " ", "->", " ", "0"}]}], ",", " ", 
     RowBox[{"hsum", " ", "/.", " ", 
      RowBox[{"\[Theta]", " ", "->", " ", "Pi"}]}], ",", " ", 
     RowBox[{"hsum", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]", " ", "->", " ", 
         RowBox[{"Pi", "/", "2"}]}], ",", " ", 
        RowBox[{"\[Phi]", " ", "->", " ", "0"}]}], "}"}]}], ",", " ", 
     RowBox[{"hsum", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]", " ", "->", " ", 
         RowBox[{"Pi", "/", "2"}]}], ",", " ", 
        RowBox[{"\[Phi]", " ", "->", " ", "Pi"}]}], "}"}]}]}], "}"}], ",", 
   " ", 
   RowBox[{"\[Phi]", " ", "\[Element]", " ", "Reals"}]}], "]"}]], "Input",
 CellLabel->
  "In[29]:= ",ExpressionUUID->"b59e0f8b-b36d-440e-8cf3-26c0d15acbe2"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same four states by name; each measurement reports its ",
 Cell[BoxData["\"\<Entropy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82675a3c-a9cc-49a0-9a7e-7ea02e79cb8e"],
 " (as in 6.3), and each sum lands exactly on the bound."
}], "Text",ExpressionUUID->"778d6713-a922-42a8-95b4-ad4902b1cc4c"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sum", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"QuantityMagnitude", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"QuantumMeasurementOperator", "[", 
           RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], "]"}], "[", 
          "#", "]"}], "[", "\"\<Entropy\>\"", "]"}], "]"}], " ", "+", "\n", 
       "    ", 
       RowBox[{"QuantityMagnitude", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"QuantumMeasurementOperator", "[", 
           RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "]"}], "[", 
          "#", "]"}], "[", "\"\<Entropy\>\"", "]"}], "]"}]}], " ", "&"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"sum", " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{"QuantumState", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<0\>\"", ",", " ", "\"\<1\>\"", ",", " ", "\"\<Plus\>\"", ",",
         " ", "\"\<Minus\>\""}], "}"}]}], ")"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[30]:= ",ExpressionUUID->"dbbd2f27-3f36-405d-91c6-be5259b95708"],

Cell[TextData[{
 "The saturating states are exactly the eigenstates of one of the two \
observables: sharp in ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80fb55b0-a64b-4f5f-82cc-e964a00d7cb7"],
 " at the cost of total ignorance of ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ec429de-a928-45c3-b990-0b3782a7c820"],
 " (",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c8db7f2-d2db-4790-97d7-06df08264802"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["X", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "456f062d-d12b-4cda-ba11-47243a8624a3"],
 "), or the reverse. Mutually unbiased bases realize maximal complementarity, \
and the entropic bound is met with equality only there; every other state \
pays strictly more total uncertainty, as the landscape shows."
}], "Text",ExpressionUUID->"ced56814-bdda-4469-855e-39a808f69f63"]
},
CreateCellID->True,
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (February 17, 2026)",
