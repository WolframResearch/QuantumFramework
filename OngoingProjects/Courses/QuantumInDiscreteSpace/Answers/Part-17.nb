Cell["\<\
The reconstruction is compared with the channel it came from on states that \
were not probes:\
\>", "Text",
 CellChangeTimes->{{3.9972013044901505`*^9, 
  3.9972013148967094`*^9}},ExpressionUUID->"c4fbf650-da02-1e4c-9152-\
0b248c2de469"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "@", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumSimilarity", "[", 
      RowBox[{
       RowBox[{"chEst", "[", "#", "]"}], ",", 
       RowBox[{"ch", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"\"\<BlochVector\>\"", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "/", "5"}], ",", 
          RowBox[{
           RowBox[{"-", "3"}], "/", "5"}], ",", 
          RowBox[{"1", "/", "2"}]}], "}"}], "]"}], "]"}], ",", 
      RowBox[{"QuantumState", "[", "\"\<Minus\>\"", "]"}]}], "}"}]}], 
   ")"}]}]], "Input",
 CellChangeTimes->{{3.997198989435501*^9, 3.9971989944044914`*^9}, {
  3.997201339253269*^9, 3.9972013395185337`*^9}},
 CellLabel->
  "In[370]:=",ExpressionUUID->"e3d34457-dddb-6144-b1f1-55d6fd050f9f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.999522145281108`", ",", "0.9997219787581892`"}], "}"}]], "Output",
 CellChangeTimes->{3.9971989962229156`*^9, 3.997201341014015*^9},
 CellLabel->
  "Out[370]=",ExpressionUUID->"716e8c64-28d4-ca4d-b298-74f72ae211e2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
17.3 [MSc] How do I compute the quantum Fisher information and the Cramer-Rao \
bound for a phase-estimation problem?\
\>", "Subsection",
 CellChangeTimes->{
  3.9972039812360935`*^9},ExpressionUUID->"f8d33345-46f1-e44c-ac0b-\
231300d526f5"],

Cell[TextData[{
 "Tomography reconstructs an object. Metrology asks a narrower question:,one \
number ",
 Cell[BoxData[
  FormBox["\[Phi]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "18680360-cb00-6847-874f-341ee5729fe2"],
 " is imprinted on a probe by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["U", "\[Phi]"], "=", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", " ", "\[ImaginaryI]"}], " ", "\[Phi]", " ", "G"}]]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "096a1e17-e214-0247-9d85-dbe1040689aa"],
 ", and we want to know how well it can be estimated, and by which \
measurement. Fix a measurement with outcomes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d8635993-fb7f-0b42-9621-bd1d2b2b3eab"],
 "and probabilities ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "k"], "(", "\[Phi]", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "50649d7e-a780-b84e-b65a-0fe91928b64c"],
 ". Its Fisher information is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"F", "(", "\[Phi]", ")"}], "=", 
    RowBox[{
     SubscriptBox["\[Sum]", 
      RowBox[{" ", "k"}]], 
     FractionBox[
      RowBox[{" ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[PartialD]", "\[Phi]"], 
          SubscriptBox["p", "k"]}], ")"}], "2"]}], 
      SubscriptBox["p", "k"]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cefc8ff4-7124-6844-8703-eb4f8f01b83f"],
 " and the Cramer-Rao bound says any unbiased estimator built from ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "92e60d42-ab98-3a4d-947c-c5b5a58c95a2"],
 " repetitions obeys ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Var", "(", "\[Phi]", ")"}], ">=", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"N", " ", "F"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "524074db-69f0-ed45-afb4-6947f8cf6bb6"],
 "."
}], "Text",
 CellChangeTimes->{{3.9972081033662186`*^9, 3.9972081589964085`*^9}, {
  3.997208237903303*^9, 
  3.9972084194899044`*^9}},ExpressionUUID->"d022f9da-5b80-8848-b86d-\
a1a71d6b26fe"],

Cell[TextData[{
 "That much is classical and depends on the measurement chosen. The quantum \
Fisher information is its maximum over every POVM, so it is a property of the \
state family alone. For a pure family it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "Q"], "=", 
    RowBox[{
     RowBox[{"4", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"\[LeftAngleBracket]", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[PartialD]", "\[Phi]"], "\[Psi]"}], "|", 
           RowBox[{
            SubscriptBox["\[PartialD]", "\[Phi]"], "\[Psi]"}]}], 
          "\[RightAngleBracket]"}], " ", "-"}], " ", "|", 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{"\[Psi]", "|", 
          RowBox[{
           SubscriptBox["\[PartialD]", "\[Phi]"], "\[Psi]"}]}], 
         "\[RightAngleBracket]"}], 
        SuperscriptBox["|", "2"]}], ")"}]}], "=", 
     RowBox[{"4", " ", 
      RowBox[{
       SubscriptBox["Var", "\[Psi]"], "(", "G", ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d25b9052-38cb-a645-8a1f-49ac75ec10a9"],
 ".   The bracket is exactly the Fubini-Study metric, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "Q"], "=", 
    RowBox[{"4", " ", "g"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e0906a59-c7b1-a84e-b081-a66c8c3e3642"],
 " and the quantum Cramer-Rao bound reads ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Var", "(", "\[Phi]", ")"}], "\[GreaterEqual]", " ", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"N", " ", 
       SubscriptBox["F", "Q"]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "41212527-e344-3641-89f0-1b637045f448"]
}], "Text",
 CellChangeTimes->{{3.997208421850361*^9, 
  3.9972085823298645`*^9}},ExpressionUUID->"4e3c53da-4846-304d-805e-\
641fa9443821"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9972080665917816`*^9, 
  3.997208067639044*^9}},ExpressionUUID->"1196a0a2-70d9-6542-8be5-\
58516984a48c"],

Cell[TextData[{
 "A qubit probe in \[Divides]+\:27e9 with the phase written on it by a \
rotation about ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c863de2c-62b3-cf49-8d36-d8339cc754b9"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", "=", 
    RowBox[{"Z", "/", "2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7491f171-e7f4-0446-aeea-6c6d04d4e443"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9972053243545685`*^9, 
  3.997205349864176*^9}},ExpressionUUID->"4b35ef6f-e78e-7d4c-b367-\
b95620eba56b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"psi", "=", 
  FractionBox[
   RowBox[{
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", "\[Phi]", " ", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}], ".", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}]}], 
   SqrtBox["2"]]}]], "Input",
 CellChangeTimes->{{3.9972040027066956`*^9, 3.9972040035503616`*^9}, {
   3.997204982649225*^9, 3.997204984234867*^9}, 3.9972053546276455`*^9},
 CellLabel->
  "In[398]:=",ExpressionUUID->"9ed6006e-6d8a-6c40-9b93-e77f4ea0b085"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}], "2"]}]], 
    SqrtBox["2"]], ",", 
   FractionBox[
    SuperscriptBox["\[ExponentialE]", 
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}], "2"]], 
    SqrtBox["2"]]}], "}"}]], "Output",
 CellChangeTimes->{
  3.9972040054259014`*^9, 3.997204984870695*^9, {3.997205356540945*^9, 
   3.997205361759321*^9}},
 CellLabel->
  "Out[398]=",ExpressionUUID->"65f5afe1-8c5f-b94e-9343-7ad7df56b8c8"]
}, Open  ]],

Cell["\<\
Born probabilities of a Pauli measurement, taken from the expectation value:\
\>", "Text",
 CellChangeTimes->{{3.9972054140907116`*^9, 
  3.9972054158917847`*^9}},ExpressionUUID->"2a5c0a2a-d8fb-1543-ace5-\
5e7903af9f53"],

Cell[BoxData[
 RowBox[{
  RowBox[{"born", "[", "m_", "]"}], ":=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ComplexExpand", "[", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "-", "#1"}], ",", 
           RowBox[{"1", "+", "#1"}]}], "}"}]}], "]"}], "&"}], ")"}], "[", 
     RowBox[{
      RowBox[{"Conjugate", "[", "psi", "]"}], ".", "m", ".", "psi"}], "]"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", "\[Alpha]"}], "}"}], "\[Element]", 
     TemplateBox[{},
      "Reals"]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9972040123725433`*^9, 3.9972040149119453`*^9}, {
  3.99720499116432*^9, 3.997204993534397*^9}},
 CellLabel->
  "In[384]:=",ExpressionUUID->"e879f1ce-cc3c-3947-b13d-19a2b8b8c76f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fisher", "[", "p_", "]"}], ":=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"Total", "[", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[PartialD]", "\[Phi]"], "p"}], ")"}], "2"], "p"], 
     "]"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", "\[Alpha]"}], "}"}], "\[Element]", 
     TemplateBox[{},
      "Reals"]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9972040210265884`*^9, 3.997204022870308*^9}, {
  3.997205001263344*^9, 3.9972050024129906`*^9}},
 CellLabel->
  "In[385]:=",ExpressionUUID->"01124580-e31f-1644-a55b-8c893a3fb3ef"],

Cell[TextData[{
 "The three Pauli measurements do not carry the same information about ",
 Cell[BoxData[
  FormBox["\[Phi]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ab143db5-c149-4543-8af6-1294f38fe183"],
 ":"
}], "Text",
 CellChangeTimes->{{3.997205435103861*^9, 
  3.997205443469654*^9}},ExpressionUUID->"eddb6cb5-203c-804d-bd21-\
89759a94f3d7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"born", "[", "#1", "]"}], ",", 
      RowBox[{"fisher", "[", 
       RowBox[{"born", "[", "#1", "]"}], "]"}]}], "}"}], "&"}], ")"}], "/@", 
  RowBox[{"PauliMatrix", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.997204035965645*^9, 3.9972040382884064`*^9}, {
  3.997205011842367*^9, 3.9972050133038273`*^9}},
 CellLabel->
  "In[386]:=",ExpressionUUID->"abaf27c9-ecb5-564b-bc44-546c6d271223"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Sin", "[", 
         FractionBox["\[Phi]", "2"], "]"}], "2"], ",", 
       SuperscriptBox[
        RowBox[{"Cos", "[", 
         FractionBox["\[Phi]", "2"], "]"}], "2"]}], "}"}], ",", "1"}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ")"}]}], ",", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ")"}]}]}], "}"}], ",", "1"}],
     "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox["1", "2"], ",", 
       FractionBox["1", "2"]}], "}"}], ",", "0"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9972040411795864`*^9, 3.997205016074688*^9},
 CellLabel->
  "Out[386]=",ExpressionUUID->"12859aea-3730-5d46-8c56-73d981494d60"]
}, Open  ]],

Cell["\<\
The quantum Fisher information needs no measurement at all, only the \
generator:\
\>", "Text",
 CellChangeTimes->{{3.997205462190508*^9, 
  3.997205466313513*^9}},ExpressionUUID->"1c4158b6-6f29-4444-8a07-\
59ec61569498"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"G", "=", 
     FractionBox[
      RowBox[{"PauliMatrix", "[", "3", "]"}], "2"]}], "}"}], ",", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"4", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", "psi", "]"}], ".", "G", ".", "G", ".", 
         "psi"}], "-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Conjugate", "[", "psi", "]"}], ".", "G", ".", "psi"}], 
          ")"}], "2"]}], ")"}]}], ",", 
     RowBox[{"\[Phi]", "\[Element]", 
      TemplateBox[{},
       "Reals"]}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.997205069350855*^9, 3.9972050709629765`*^9}},
 CellLabel->
  "In[387]:=",ExpressionUUID->"36522318-d824-8045-a863-56daaf5eeb69"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.99720507308535*^9},
 CellLabel->
  "Out[387]=",ExpressionUUID->"160f20e0-e8b6-6d4d-9e7a-c37e9df0d754"]
}, Open  ]],

Cell["\<\
Both numbers came out free of \[Phi], for two different reasons, and only one \
of them is general. Tilting the measurement axis out of the equatorial plane \
by \[Alpha] interpolates between the two Pauli extremes and shows what a \
generic measurement does:\
\>", "Text",
 CellChangeTimes->{{3.9972054846392746`*^9, 
  3.997205498560808*^9}},ExpressionUUID->"41693781-cba7-4f47-8a3e-\
5216dbed9f8a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fisher", "[", 
  RowBox[{"born", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", "\[Alpha]", "]"}], " ", 
     RowBox[{"PauliMatrix", "[", "1", "]"}]}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Alpha]", "]"}], " ", 
     RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.997205083225643*^9, 3.9972050839701366`*^9}, {
  3.9972051480420437`*^9, 3.997205149557104*^9}, {3.9972052577816277`*^9, 
  3.997205257909731*^9}},
 CellLabel->
  "In[392]:=",ExpressionUUID->"83b0be69-25c8-5940-8c3a-7efbc546a2a5"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"Sin", "[", "\[Alpha]", "]"}], "2"], " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}], 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Cos", "[", "\[Phi]", "]"}], "2"], " ", 
     SuperscriptBox[
      RowBox[{"Sin", "[", "\[Alpha]", "]"}], "2"]}]}]]}]], "Output",
 CellChangeTimes->{3.9972050857632008`*^9, 3.997205150117668*^9, 
  3.997205258496622*^9},
 CellLabel->
  "Out[392]=",ExpressionUUID->"dc8eddf4-6275-6544-a06d-036ca4b57776"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"#1", ",", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"fisher", "[", 
         RowBox[{"born", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Sin", "[", "\[Alpha]", "]"}], " ", 
            RowBox[{"PauliMatrix", "[", "1", "]"}]}], "+", 
           RowBox[{
            RowBox[{"Cos", "[", "\[Alpha]", "]"}], " ", 
            RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], "]"}], "]"}], "/.", 
        "\[VeryThinSpace]", 
        RowBox[{"\[Alpha]", "\[Rule]", "#1"}]}], "]"}]}], "}"}], "&"}], ")"}],
   "/@", 
  RowBox[{"{", 
   RowBox[{"0", ",", 
    FractionBox["\[Pi]", "4"], ",", 
    FractionBox["\[Pi]", "2"]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9972051196482525`*^9, 3.997205121633173*^9}},
 CellLabel->
  "In[389]:=",ExpressionUUID->"c26b75ef-a5eb-e842-8e06-011841ddd343"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["\[Pi]", "4"], ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}], 
       RowBox[{
        RowBox[{"-", "3"}], "+", 
        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", "\[Phi]"}], "]"}]}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["\[Pi]", "2"], ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9972051236800594`*^9},
 CellLabel->
  "Out[389]=",ExpressionUUID->"84f48b0a-64a2-d744-bfb2-158a893b9e6c"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.997208043392763*^9, 
  3.997208045933153*^9}},ExpressionUUID->"777ee258-2be5-9d45-b048-\
b54ff08b0a9f"],

Cell["\<\
The same family, with the parameter declared so the framework can \
differentiate it:\
\>", "Text",
 CellChangeTimes->{{3.997205555697132*^9, 
  3.9972055637859135`*^9}},ExpressionUUID->"20752e57-c752-a841-86e4-\
d5d44ef28675"],

Cell[BoxData[
 RowBox[{
  RowBox[{"probe", "[", 
   RowBox[{"n_", ",", "st_"}], "]"}], ":=", 
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\"\<RZ\>\"", "[", "\[Phi]", "]"}], "->", "k"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "n"}], "}"}]}], "]"}], "]"}], "[", "st", "]"}], ",", 
    RowBox[{"\"\<Parameters\>\"", "->", 
     RowBox[{"{", "\[Phi]", "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9972040502583256`*^9, 3.997204060874878*^9}},
 CellLabel->
  "In[377]:=",ExpressionUUID->"817d461b-6dfb-d94c-8f3d-680c580e5878"],

Cell["\<\
FubiniStudyMetricTensor is that bracket, so four times it is the quantum \
Fisher information:\
\>", "Text",
 CellChangeTimes->{{3.99720557841304*^9, 
  3.9972055797294044`*^9}},ExpressionUUID->"90753408-1396-a442-af36-\
1e4755e56fb9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"4", " ", 
    RowBox[{
     RowBox[{"FubiniStudyMetricTensor", "[", 
      RowBox[{
       RowBox[{"probe", "[", 
        RowBox[{"1", ",", 
         RowBox[{"QuantumState", "[", "\"\<Plus\>\"", "]"}]}], "]"}], 
       ",", "\"\<Matrix\>\""}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
   RowBox[{"Element", "[", 
    RowBox[{"\[Phi]", ",", "Reals"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.997204065076294*^9, 3.997204065076294*^9}, 
   3.997204104939974*^9},
 CellLabel->
  "In[381]:=",ExpressionUUID->"88cab9b5-356a-0747-82dd-4d22c38688c5"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{{3.9972041030966415`*^9, 3.99720410542284*^9}},
 CellLabel->
  "Out[381]=",ExpressionUUID->"47f89e56-a90e-8a4d-bad3-ed0b5071766a"]
}, Open  ]],

Cell[TextData[{
 "Spending ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "35723af5-3651-5841-8c1d-5270b35f60e1"],
 " probes independently, against spending them on one entangled probe:"
}], "Text",
 CellChangeTimes->{{3.9972078877394695`*^9, 
  3.9972079103432484`*^9}},ExpressionUUID->"135f5714-6a72-1146-8580-\
261336920e3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Flatten", "/@", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"4", 
      RowBox[{"FubiniStudyMetricTensor", "[", 
       RowBox[{"#", ",", "\"\<Matrix\>\""}], "]"}]}], "&"}], ",", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"probe", "[", 
         RowBox[{"n", ",", 
          RowBox[{"QuantumState", "[", 
           RowBox[{"\"\<UniformSuperposition\>\"", "[", "n", "]"}], "]"}]}], 
         "]"}], ",", 
        RowBox[{"probe", "[", 
         RowBox[{"n", ",", 
          RowBox[{"QuantumState", "[", 
           RowBox[{"\"\<GHZ\>\"", "[", "n", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "4"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", "2", "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9972062680666866`*^9, 3.997206412772312*^9}},
 CellLabel->
  "In[418]:=",ExpressionUUID->"416bca8d-5d55-7546-a961-1db433f42219"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "9"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "16"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.997206316850008*^9, 3.9972064137629833`*^9}},
 CellLabel->
  "Out[418]=",ExpressionUUID->"8ebaa79e-21b7-f640-8b78-ca34f1f2a736"]
}, Open  ]],

Cell[TextData[{
 "Independent probes give ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "Q"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eb56480f-548a-f040-b2be-dfdc9cc9093d"],
 Cell[BoxData[
  FormBox[
   RowBox[{"=", "n"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "758b4cda-4b4b-d443-930c-82429f6cf510"],
 ", so the precision improves as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SqrtBox["n"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bcbc47ab-9f96-334f-af0a-61122ef61966"],
 ", the standard quantum limit, and it is exactly the improvement of \
averaging ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "73aaa1d8-022c-3b47-93d2-66fd17a68d36"],
 " independent trials. A GHZ probe gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "Q"], "=", 
    SuperscriptBox["n", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "128ad39d-dbeb-5646-b301-9704c6f44c10"],
 "and precision  1/n, the Heisenberg limit"
}], "Text",
 CellChangeTimes->{{3.9972079540396557`*^9, 
  3.9972080125266247`*^9}},ExpressionUUID->"0629ac97-20c8-2843-afb4-\
cab443d55d6b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "17.4 [MSc] How do I estimate average gate fidelity by randomized \
benchmarking, fitting the survival probability to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", " ", 
    SuperscriptBox["p", "m"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2df02049-c016-034a-84d6-aad086554267"],
 " + ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "deb9d7bf-b8b5-fc4f-bab5-911cbaf31562"],
 " and reading the depolarizing rate from the decay ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "848fe336-29a4-444b-aa7e-2b1530889764"],
 "?"
}], "Subsection",
 CellChangeTimes->{{3.9972086069614677`*^9, 
  3.9972086326297607`*^9}},ExpressionUUID->"a59672bb-42a9-4e49-b3a6-\
e45ff0a458ee"],

Cell[TextData[{
 "Calibrating a gate set does not need the whole channel, only one number, \
and randomized benchmarking gets that number without caring about preparation \
or measurement. The protocol: apply ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9fdd6aaa-d396-2c45-9cef-90b963353f19"],
 " Clifford gates drawn uniformly at random, then the one Clifford that \
inverts their product, and record whether the system came back to where it \
started. Noiseless gates return survival 1 at every ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "51d4db03-5b6b-9145-af9c-73474b6ff659"],
 ". Real gates decay, and the claim is that the decay is the exponential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["P", "survive"], "(", "m", ")"}], "=", 
    RowBox[{
     RowBox[{"A", " ", 
      SuperscriptBox["p", "m"]}], "+", "B"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "afd62f73-7241-6e41-b9d6-220026db72bc"]
}], "Text",
 CellChangeTimes->{{3.9972191340033035`*^9, 3.997219150287319*^9}, {
  3.9972206223153*^9, 3.9972206370961704`*^9}, {3.997220693567217*^9, 
  3.997220729193424*^9}},ExpressionUUID->"77943f72-2192-0e4c-adcf-\
bc0ccd429fbe"],

Cell[TextData[{
 "A single exponential appears whatever the noise is, because of the Clifford \
twirl. Averaging any channel over the Clifford group,",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[CurlyEpsilon]", "\[LongDash]"], "=", 
    RowBox[{"|", "\[ScriptCapitalC]", 
     SuperscriptBox["|", 
      RowBox[{"-", "1"}]], 
     RowBox[{
      SubscriptBox["\[Sum]", 
       RowBox[{" ", "C"}]], " ", 
      RowBox[{
       SuperscriptBox["C", "\[Dagger]"], " ", "\[CurlyEpsilon]", " ", 
       "C"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c6ae471c-32e9-7049-b63a-1982b3d2c267"],
 " produces a depolarizing channel, and depolarizing shrinks the Bloch vector \
by a fixed factor per step. Randomizing the sequence is what carries out that \
average, so \n",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "266316ff-5038-0c45-a8ba-a32c63348aca"],
 " is the shrink factor of the twirled noise, that is the surviving \
depolarizing parameter is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[Minus]", "p"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fb161b7f-6245-8749-bedc-e763f6b077c0"],
 ". From it the error per Clifford and the average gate fidelity follow for \
dimension ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bc176cda-aff8-4845-9615-8505ff3251bb"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"r", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"d", "-", "1"}], ")"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "p"}], ")"}], "/", "d"}]}], "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}], "/", "2"}]}]}], ",", " ", 
    RowBox[{
     SubscriptBox["F", 
      RowBox[{"avg", " "}]], "=", 
     RowBox[{
      RowBox[{"1", "-", "r"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "p"}], ")"}], "/", "2"}], "   ", "for", " ", Cell[
       TextData[Cell[BoxData[
        FormBox[
         RowBox[{"d", "=", "2"}], TraditionalForm]],
        FormatType->TraditionalForm,ExpressionUUID->
        "7719b13c-d11c-1045-9afe-66743f887f78"]],ExpressionUUID->
        "6ae7046c-22f2-a64c-802a-fc6bc1cda202"]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "63e5a885-938a-0b40-82d7-9c1bdb1e752f"]
}], "Text",
 CellChangeTimes->{
