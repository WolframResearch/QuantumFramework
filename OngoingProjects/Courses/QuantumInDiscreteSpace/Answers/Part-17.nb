(* Beginning of Notebook Content *)
Notebook[{
Cell[BoxData[{
 RowBox[{"<<", "Wolfram`QuantumFramework`"}], "\[IndentingNewLine]", 
 RowBox[{"<<", "Wolfram`QuantumFramework`QuantumOptimization`"}]}], "Input",
 CellChangeTimes->{{3.9962485872668724`*^9, 3.9962485922677765`*^9}, {
  3.9972040794521103`*^9, 3.997204090435934*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"d99a1180-ca4a-0948-91f2-95f5029e89c8"],

Cell[CellGroupData[{

Cell["\<\
17.1 [MSc] How do I reconstruct an unknown density matrix by state tomography?\
\>", "Subsection",
 CellChangeTimes->{
  3.99624858535791*^9},ExpressionUUID->"2a1b5093-d937-9446-a811-9d34b684f623"],

Cell[TextData[{
 "For a qubit state ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "924be1f2-65ed-9740-b6e6-5070b0336ee7"],
 " has three real parameters and a projective measurement returns one bit, so \
a single setting cannot determine \[Rho] no matter how many copies are spent \
on it. Measuring ",
 Cell[BoxData[
  FormBox["Z", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2d0173c4-7c9b-fa49-bf04-034a413a021d"],
 " alone fixes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "z"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9025a924-77b5-644f-9a33-0c96228a2394"],
 " and leaves the other two components untouched, which is why tomography is \
a set of experiments. What is needed is a collection of POVM elements \
spanning the Hermitian operators, so that the map from state to outcome \
probabilities can be inverted,such a set is informationally complete. Three \
Pauli bases supply six projectors for a qubit and are more than enough. For a \
qubit measured in the three Pauli bases that machinery collapses to something \
recognizable, since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     SubscriptBox["\[Sigma]", "k"], "\[RightAngleBracket]"}], " ", "=", " ", 
    RowBox[{
     SubscriptBox["p", "+"], "-", 
     SubscriptBox["p", "-"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "64a6e1d5-2359-9c4b-bc5c-a5c8e73c3f65"],
 "  for each measurement operator and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"I", "+", " ", 
       RowBox[{
        SubscriptBox["\[Sum]", 
         RowBox[{" ", "k"}]], " ", 
        RowBox[{
         RowBox[{"\[LeftAngleBracket]", 
          SubscriptBox["\[Sigma]", "k"], "\[RightAngleBracket]"}], " ", 
         SubscriptBox["\[Sigma]", "k"]}]}]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d621b69e-5f8b-bd49-be80-13ee5594985d"],
 " so the Pauli expansion is the tomographic inversion, with the expectation \
values read off as count differences."
}], "Text",
 CellChangeTimes->{{3.996917107049923*^9, 3.996917163864708*^9}, {
  3.9969172133459606`*^9, 3.9969172616575336`*^9}, {3.996917296734436*^9, 
  3.996917410665804*^9}},ExpressionUUID->"9c3d31a9-3a05-ab40-9bd8-\
4885e3dc5b0b"],

Cell[TextData[{
 "Two things separate that identity from a working protocol. Frequencies are \
not probabilities with ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "da231997-13bc-4f4a-a8ea-e4f6c8869706"],
 " copies per setting each \:27e8",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "k"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "577017f0-0835-fb41-b828-56d49a238844"],
 "\:27e9 carries a statistical error of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SqrtBox["N"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a3b00e04-a83a-2049-92bb-b41c3e7a52c5"],
 ", so the reconstruction improves only as the square root of the effort. And \
nothing in the linear solve knows that \[Rho] must be positive. The estimated \
Bloch vector is built from three independently noisy numbers, and for a state \
near the boundary the fluctuations can push ",
 Cell[BoxData[
  FormBox[
   RowBox[{Cell["|",ExpressionUUID->"dbc2d57f-11f5-8345-8a11-6884e522cd1d"], 
    SubscriptBox[
     OverscriptBox["r", "\[RightVector]"], "est"], Cell[
    "|",ExpressionUUID->"69416214-9c6f-6d43-8f3e-9f9d27f0acda"], " ", Cell[
    "> 1",ExpressionUUID->"b0eddb56-3c0d-ae45-9555-3b90397d8133"]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "55093b6f-6ed4-2845-bd93-a5096e61296f"],
 "which is not a state at all. That is the common case for nearly pure states \
and modest ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4c192c5d-4f46-3548-807e-e9bbb6aa7008"],
 ", and it is why the linear estimate must be followed by a projection back \
onto the state space or replaced by a likelihood maximization over physical \
states."
}], "Text",
 CellChangeTimes->{{3.9969174514222145`*^9, 
  3.996917590758047*^9}},ExpressionUUID->"57eda3ed-3794-f34f-978b-\
17092a00371a"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9968763351512527`*^9, 
  3.9968763387531643`*^9}},ExpressionUUID->"0a572919-5acb-be43-a2f4-\
6c160e9f551a"],

Cell["Bloch state builder:", "Text",
 CellChangeTimes->{{3.9968763485940876`*^9, 
  3.996876352437168*^9}},ExpressionUUID->"ff4f30bd-1bb6-9241-b31b-\
24f38ce8e115"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bloch", "[", "v_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
     RowBox[{"v", ".", 
      RowBox[{"PauliMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], ")"}], "/", 
   "2"}]}]], "Input",
 CellChangeTimes->{{3.9968763443039894`*^9, 3.9968763450834618`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"3dfc3dfe-953d-ef46-b432-a5d05010d3a4"],

Cell["\<\
The three expectation values determine the state identically in the Bloch \
vector, which is the statement that the three Pauli bases are informationally \
complete for a qubit:\
\>", "Text",
 CellChangeTimes->{{3.9968763984132004`*^9, 
  3.9968764086935368`*^9}},ExpressionUUID->"7803e579-4556-fb47-90f7-\
4e1959a74b41"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"bloch", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"bloch", "[", 
          RowBox[{"{", 
           RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], "]"}], ".", 
         RowBox[{"PauliMatrix", "[", "k", "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "3"}], "}"}]}], "]"}], "]"}], "==", 
    RowBox[{"bloch", "[", 
     RowBox[{"{", 
      RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], "]"}]}], ",", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], ",", "Reals"}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9968763647074986`*^9, 3.996876366122587*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"e384e984-c0de-de49-912f-26d388f984a5"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.996876368341961*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"db45ec0f-8dfd-4648-9513-f533bbb1f7ec"]
}, Open  ]],

Cell[TextData[{
 "An unknown to be reconstructed, with |",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["r", "\[RightVector]"], Cell[
     "|",ExpressionUUID->"73003da0-e4ff-3c4a-996b-c646facc95fb"]}], "<", 
    "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ad113321-d493-ea44-8d53-b3fe6b3fd986"],
 ":"
}], "Text",
 CellChangeTimes->{{3.996876491137575*^9, 3.996876499436182*^9}, {
  3.9968765483574696`*^9, 
  3.9968765884289703`*^9}},ExpressionUUID->"fa6be198-d590-0244-8699-\
913f1ddba879"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rTrue", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"2", "/", "5"}], ",", 
     RowBox[{"3", "/", "10"}], ",", 
     RowBox[{"17", "/", "20"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"truth", "=", 
   RowBox[{"bloch", "[", "rTrue", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9968764280642967`*^9, 3.99687645466531*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"5c5ee21a-c39b-ef4a-a348-3cd48b3e1996"],

Cell["\<\
The two projectors of each setting, with the \[Minus]1 outcome first:\
\>", "Text",
 CellChangeTimes->{{3.9968766532321053`*^9, 
  3.9968766726038227`*^9}},ExpressionUUID->"35ffaea5-851a-b447-990f-\
067dfad01503"],

Cell[BoxData[
 RowBox[{
  RowBox[{"proj", "[", "k_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "2", "]"}], "-", 
       RowBox[{"PauliMatrix", "[", "k", "]"}]}], ")"}], "/", "2"}], ",", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
       RowBox[{"PauliMatrix", "[", "k", "]"}]}], ")"}], "/", "2"}]}], 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.9968766002843685`*^9, 3.996876601069172*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"fb536bc9-ee16-4342-a3bd-d6bef2a993d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"probs", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"truth", ".", "#"}], "]"}], "&"}], "/@", 
     RowBox[{"proj", "[", "k", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9968766075038586`*^9, 3.9968766083393345`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"e54e572c-1d9f-ce4e-92aa-3c30e67c299e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox["3", "10"], ",", 
     FractionBox["7", "10"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["7", "20"], ",", 
     FractionBox["13", "20"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["3", "40"], ",", 
     FractionBox["37", "40"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9968766090274353`*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"aa4e0957-50e8-b24e-a531-48893833c90d"]
}, Open  ]],

Cell["20 realizations:", "Text",
 CellChangeTimes->{{3.9968767032221413`*^9, 
  3.9968767204929028`*^9}},ExpressionUUID->"0ed42156-cfdd-7e4d-8303-\
09dd1fb9a970"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{"counts", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"RandomVariate", "[", 
     RowBox[{"MultinomialDistribution", "[", 
      RowBox[{"20", ",", 
       RowBox[{"N", "[", "#", "]"}]}], "]"}], "]"}], "&"}], "/@", 
   "probs"}]}]}], "Input",
 CellChangeTimes->{{3.9968766895064716`*^9, 3.996876694892954*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"46f9c82e-5323-bc44-bc64-be5ccdb7fc7b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"7", ",", "13"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "14"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "19"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9968766911577816`*^9, 3.996876695461523*^9}},
 CellLabel->"Out[16]=",ExpressionUUID->"0b425294-8cf2-d247-a8b2-65f226ddf1ee"]
}, Open  ]],

Cell["\<\
Each expectation value is the count difference in its setting, and the three \
together are the estimated Bloch vector:\
\>", "Text",
 CellChangeTimes->{{3.996877000521679*^9, 
  3.996877002390545*^9}},ExpressionUUID->"6c8904e5-1e9f-864a-ad17-\
3dee136ea07e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rEst", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "-", 
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
     RowBox[{"Total", "[", "#", "]"}]}], "&"}], "/@", "counts"}]}]], "Input",
 CellChangeTimes->{{3.996876730819956*^9, 3.996876731502882*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"370677b3-a986-0e41-8c74-a780315672d2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["3", "10"], ",", 
   FractionBox["2", "5"], ",", 
   FractionBox["9", "10"]}], "}"}]], "Output",
 CellChangeTimes->{3.9968767319927006`*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"65a650be-9273-de43-a104-982394c50f6b"]
}, Open  ]],

Cell["Check the norm:", "Text",
 CellChangeTimes->{{3.9968769096174297`*^9, 
  3.996876912454052*^9}},ExpressionUUID->"2f34b14a-29c7-ac40-9503-\
935bf3b876c4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "@", 
  RowBox[{"Norm", "[", "rEst", "]"}]}]], "Input",
 CellChangeTimes->{{3.996876753016756*^9, 3.9968767544034843`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"ac52f185-5c68-dc42-9264-d838124f999c"],

Cell[BoxData["1.0295630140987002`"], "Output",
 CellChangeTimes->{3.9968767549830036`*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"7be08742-e24d-6a48-8550-aa19a53cc461"]
}, Open  ]],

Cell["\<\
Rescaling to the boundary is the cheapest repair (only if it was necessary \
since our truth state is almost pure):\
\>", "Text",
 CellChangeTimes->{{3.9968769154078884`*^9, 
  3.996876966459572*^9}},ExpressionUUID->"c206fd6f-e3d8-6f48-b87c-\
b86a4ebd6acc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rFix", "=", 
  RowBox[{"rEst", "/", 
   RowBox[{"Max", "[", 
    RowBox[{"1", ",", 
     RowBox[{"Norm", "[", "rEst", "]"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.996876780420227*^9, 3.9968767810440483`*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"77cbff02-171a-234b-a4f1-b33f2627101e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["3", 
    SqrtBox["106"]], ",", 
   RowBox[{"2", " ", 
    SqrtBox[
     FractionBox["2", "53"]]}], ",", 
   FractionBox["9", 
    SqrtBox["106"]]}], "}"}]], "Output",
 CellChangeTimes->{3.996876781984255*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"5e99c9c6-ea55-2d4d-a1cd-3718cc85face"]
}, Open  ]],

Cell["\<\
The statistical error is the distance from the true Bloch vector, and reading \
its trend needs an average over many runs at each number of copies:\
\>", "Text",
 CellChangeTimes->{{3.9968770327113323`*^9, 
  3.9968770364376297`*^9}},ExpressionUUID->"c133ffac-7973-e542-9fa9-\
5e6382dc388c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"error", "[", "n_", "]"}], ":=", 
  RowBox[{"Norm", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "-", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
       RowBox[{"Total", "[", "#", "]"}]}], "&"}], "/@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"RandomVariate", "[", 
         RowBox[{"MultinomialDistribution", "[", 
          RowBox[{"n", ",", 
           RowBox[{"N", "[", "#", "]"}]}], "]"}], "]"}], "&"}], "/@", 
       "probs"}], ")"}]}], "-", "rTrue"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.996876804304655*^9, 3.996876805044901*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"64444d80-38c9-0e49-ae3c-7969c3b751c5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "2", "]"}], ";"}], "\n", 
 RowBox[{"N", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", 
      RowBox[{"Mean", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"error", "[", "n", "]"}], ",", "200"}], "]"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", 
      RowBox[{"{", 
       RowBox[{"20", ",", "200", ",", "2000", ",", "20000"}], "}"}]}], 
     "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9968768123374577`*^9, 3.9968768258152714`*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"f5097f39-af1b-ff47-a57e-13e9ed54418e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"20.`", ",", "0.2777207750524184`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"200.`", ",", "0.08852337126057247`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2000.`", ",", "0.028520823194797804`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"20000.`", ",", "0.008923513714565965`"}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.9968768144150753`*^9, 3.996876826807453*^9}},
 CellLabel->"Out[25]=",ExpressionUUID->"b44a7540-bb96-9c4c-90d5-36401d997cb5"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.996249947389591*^9, 
  3.9962499500040607`*^9}},ExpressionUUID->"a4bd9727-d582-aa44-af63-\
637fdb3925e5"],

Cell["The measurement are named operators:", "Text",
 CellChangeTimes->{{3.996877917381796*^9, 
  3.9968779297795277`*^9}},ExpressionUUID->"b9c43b98-4532-994a-abd9-\
b07fa417d3a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pauli", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumMeasurementOperator", "[", 
      RowBox[{"QuantumOperator", "[", "#", "]"}], "]"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996249953559593*^9, 3.9962499649547424`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"b2835b72-5543-2e42-b300-bfe13d88d879"],

Cell["Truth state:", "Text",
 CellChangeTimes->{{3.9968783197126904`*^9, 
  3.9968783243460445`*^9}},ExpressionUUID->"55d00dcc-b967-e144-b1d8-\
e41209cc24bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qtruth", "=", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<BlochVector\>\"", "[", "rTrue", "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996249972379961*^9, 3.996249978353506*^9}, {
  3.9968779425725574`*^9, 3.996877946886751*^9}, {3.996877984898201*^9, 
  3.9968779960294647`*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"dacfaafc-8272-f046-82f1-c804f5c9985b"],

Cell["Check the probabilities:", "Text",
 CellChangeTimes->{
