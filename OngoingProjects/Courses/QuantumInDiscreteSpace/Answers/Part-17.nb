Cell[TextData[{
 "The average gate fidelity of any channel is fixed by the overlap of its \
Choi state  with the maximally entangled state, the entanglement fidelity ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "pro"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1a93f2b2-c50c-fe44-91a1-7ea561c2374c"],
 " through ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "avg"], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"d", " ", 
        SubscriptBox["F", "pro"]}], " ", "+", "1"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"d", "+", "1"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "92456a28-0f0e-3c42-bd67-abd25176541d"],
 "\t:"
}], "Text",
 CellChangeTimes->{{3.997223364318281*^9, 
  3.997223443463831*^9}},ExpressionUUID->"09cd8325-715d-f149-9f38-\
70d15a333a35"],

Cell[BoxData[
 RowBox[{
  RowBox[{"avgFidelity", "[", "ch_", "]"}], ":=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    FractionBox["1", "3"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       SuperscriptBox[
        RowBox[{"QuantumSimilarity", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"QuantumChannel", "[", 
            RowBox[{"ch", ",", 
             RowBox[{"{", "2", "}"}]}], "]"}], "[", 
           RowBox[{"QuantumState", "[", "\"\<PhiPlus\>\"", "]"}], "]"}], ",", 
          RowBox[{"QuantumState", "[", "\"\<PhiPlus\>\"", "]"}]}], "]"}], 
        "2"]}], "+", "1"}], ")"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.997217364597229*^9, 3.9972173670924606`*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"57b9bfdf-8505-9046-a7fc-afdde79f0df0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"avgFidelity", "[", "noise", "]"}], "//", "N"}]], "Input",
