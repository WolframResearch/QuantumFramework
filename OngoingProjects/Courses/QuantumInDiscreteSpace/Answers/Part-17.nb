Cell[TextData[{
 "The single-qubit Clifford group, obtained by closing the two generators ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e2fccc1d-135f-6d44-99a2-f61225e7d388"],
 " and ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "23d46567-7a77-5d48-8892-0b4c568b6440"],
 ",  with global phases quotiented out so that the group has its 24 elements \
and not more:"
}], "Text",
 CellChangeTimes->{{3.9972227598931065`*^9, 
  3.997222817359503*^9}},ExpressionUUID->"91c59630-cf05-234e-a86d-\
44e18db41e86"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"canonical", "[", "m_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", "=", 
       RowBox[{"First", "@", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", "m", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", "#", "]"}], ">", 
            RowBox[{"10", "^", 
             RowBox[{"-", "9"}]}]}], "&"}]}], "]"}]}]}], "}"}], ",", 
     RowBox[{"Simplify", "[", 
      RowBox[{"m", " ", 
       RowBox[{"z", "^", 
        RowBox[{"-", "1"}]}], " ", 
       RowBox[{"Abs", "[", "z", "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cliff", "=", 
   RowBox[{"FixedPoint", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"canonical", "/@", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"#", ".", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"1", ",", "1"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", 
                    RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "/", 
               RowBox[{"Sqrt", "[", "2", "]"}]}], "&"}], "/@", "#"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", ".", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"1", ",", "0"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "I"}], "}"}]}], "}"}]}], "&"}], "/@", 
             "#"}]}], "}"}], ",", "1"}], "]"}]}], "]"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Length", "[", "cliff", "]"}]}], "Input",
 CellChangeTimes->{{3.9972096211953964`*^9, 3.9972096249413033`*^9}, {
  3.997209697603325*^9, 3.997209698531414*^9}, {3.9972168469865284`*^9, 
  3.997216854749241*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"b327392e-9fbd-d248-b555-c4791eed5fa1"],

