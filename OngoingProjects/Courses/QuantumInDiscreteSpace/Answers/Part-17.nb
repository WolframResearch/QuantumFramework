Cell["\<\
The twirl does not merely resemble a depolarizing channel, it is one: the \
named channel carrying the fitted depolarizing parameter has exactly the \
average fidelity of the damping it replaced.\
\>", "Text",
 CellChangeTimes->{
  3.9972245071167145`*^9},ExpressionUUID->"e3400e64-be9c-1a41-943e-\
2bbe1aefc9e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"avgFidelity", "[", "noise", "]"}], ",", 
   RowBox[{"avgFidelity", "[", 
    RowBox[{"QuantumChannel", "[", 
     RowBox[{"\"\<Depolarizing\>\"", "[", 
      RowBox[{"1", "-", 
       RowBox[{"4", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"Sqrt", "[", "5", "]"}]}], ")"}], "/", "15"}]}]}], "]"}], 
     "]"}], "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.9972174116848774`*^9, 3.9972174469389496`*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"b28bcb8f-52c9-9446-bee3-c6e75c6fefe0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox["1", "30"], " ", 
    RowBox[{"(", 
     RowBox[{"19", "+", 
      RowBox[{"4", " ", 
       SqrtBox["5"]}]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", "30"], " ", 
    RowBox[{"(", 
     RowBox[{"19", "+", 
      RowBox[{"4", " ", 
       SqrtBox["5"]}]}], ")"}]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.997217417697464*^9, 3.9972174477928734`*^9}},
 CellLabel->"Out[44]=",ExpressionUUID->"068f8272-85d7-5247-a8bf-82dc8324ce88"]
}, Open  ]],

