Cell["\<\
Fitting the three-parameter model separates the part that carries the gate \
error from the parts that do not:\
\>", "Text",
 CellChangeTimes->{{3.997223128504301*^9, 
  3.9972231302722206`*^9}},ExpressionUUID->"d5a5df04-5507-1a4b-b5b0-\
6802b660cf45"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rbFit", "=", 
   RowBox[{"NonlinearModelFit", "[", 
    RowBox[{"rbData", ",", 
     RowBox[{
      RowBox[{"a", " ", 
       RowBox[{"p", "^", "m"}]}], "+", "b"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", ".4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", ".86"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", ".6"}], "}"}]}], "}"}], ",", "m"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"a", ",", "p", ",", "b"}], "}"}], "/.", " ", 
  RowBox[{"rbFit", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], "Input",
 CellChangeTimes->{{3.99720981257065*^9, 3.9972098131866684`*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"9a6fd351-2fe7-d040-bb53-bbf9f2665654"],

