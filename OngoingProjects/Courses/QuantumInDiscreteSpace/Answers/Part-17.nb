Cell["\<\
The four matrix units are the ordered pairs of computational kets against \
bras, each pairing with the image of that unit. Read as a matrix state, the \
assembly is the Choi state:\
\>", "Text",
 CellChangeTimes->{{3.997201253206917*^9, 
  3.997201268525711*^9}},ExpressionUUID->"610017ab-350b-d041-a901-\
b5153f5c02a3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rho", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"#", "[", "\"\<MaximumLikelihoodState\>\"", "]"}], 
      "[", "\"\<Operator\>\"", "]"}], "&"}], "/@", "outs"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"q01", "=", 
   RowBox[{
    RowBox[{"rho", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "+", 
    RowBox[{"I", " ", 
     RowBox[{"rho", "[", 
      RowBox[{"[", "4", "]"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "I"}], ")"}], "/", "2"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "+", 
       RowBox[{"rho", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{"choiEst", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Total", "@", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"QuantumTensorProduct", "[", 
          RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"QuantumOperator", "/@", 
           RowBox[{
            RowBox[{
             RowBox[{"QuantumOperator", "[", "\"\<0\>\"", "]"}], 
             "[", "\"\<Basis\>\"", "]"}], "[", "\"\<Elements\>\"", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rho", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "q01", ",", 
            RowBox[{"q01", "[", "\"\<Dagger\>\"", "]"}], ",", 
            RowBox[{"rho", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "}"}]}], "]"}]}], "/",
      "2"}], ")"}], "[", "\"\<MatrixQuantumState\>\"", "]"}]}]}], "Input",
 CellChangeTimes->{
  3.9972006688885784`*^9, {3.9972008310644283`*^9, 3.9972008347472744`*^9}},
