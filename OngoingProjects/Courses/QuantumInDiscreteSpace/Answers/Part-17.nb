Cell["\<\
The noise to be benchmarked, applied after every gate. Amplitude damping is \
chosen because it is neither depolarizing nor even unital, so the twirl has \
something to do:\
\>", "Text",
 CellChangeTimes->{{3.9972228899795856`*^9, 
  3.99722289924016*^9}},ExpressionUUID->"2f6a5aa3-4b3e-af47-b20b-\
ee6493e9af37"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"damping", "=", 
   RowBox[{"1", "/", "5"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"damp", "[", "s_", "]"}], ":=", 
  RowBox[{"Total", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"#", ".", "s", ".", 
      RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", "-", "damping"}], "]"}]}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"Sqrt", "[", "damping", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.997209704689928*^9, 3.9972097065577507`*^9}, {
  3.997216910848421*^9, 3.9972169119401226`*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"9e238330-098f-4c43-b660-6119d54492c5"],

Cell[TextData[{
 "Any qubit channel acts on the Bloch vector as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["r", "\[RightVector]"], "->", 
    RowBox[{
     RowBox[{"M", " ", 
      OverscriptBox["r", "\[RightVector]"]}], "+", "c"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f4ea6d51-0027-1445-8da3-88eec4ded7c5"],
 ". This reads off the pair by sending in the three axis states and the \
centre:"
}], "Text",
 CellChangeTimes->{{3.9972229160034904`*^9, 
  3.997222956341383*^9}},ExpressionUUID->"fc7cc8c4-c78b-9842-bafe-\
e5989dcf79e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"blochOf", "[", "f_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"c", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "2", "]"}], "/", "2"}], "]"}], ".", 
          RowBox[{"PauliMatrix", "[", "k", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Transpose", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Tr", "[", 
             RowBox[{
              RowBox[{"f", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
                  RowBox[{
                   RowBox[{"UnitVector", "[", 
                    RowBox[{"3", ",", "j"}], "]"}], ".", 
                   RowBox[{"PauliMatrix", "[", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], 
                 ")"}], "/", "2"}], "]"}], ".", 
              RowBox[{"PauliMatrix", "[", "k", "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "3"}], "}"}]}], "]"}], "-", "c"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ",", "c"}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9972097154832745`*^9, 3.9972097222000904`*^9}, {
  3.9972169220480003`*^9, 
  3.9972169340631886`*^9}},ExpressionUUID->"4303df22-0a41-e842-bdef-\
aa4a4cb6db57"],

Cell["\<\
For the damping the contraction is unequal along the three axes and the \
centre is pulled toward |0\[RightAngleBracket]:\
\>", "Text",
 CellChangeTimes->{{3.9972229829850273`*^9, 
  3.997222992702259*^9}},ExpressionUUID->"38790026-9e6d-3b46-92f1-\
d2f9bd3a5fde"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"blochOf", "[", "damp", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.9972097154832745`*^9, 3.9972097222000904`*^9}, {
  3.9972169220480003`*^9, 3.9972169340631886`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"f4a91988-ba73-694d-ad7f-bd324d965f0c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox["2", 
        SqrtBox["5"]], ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox["2", 
        SqrtBox["5"]], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       FractionBox["4", "5"]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", 
     FractionBox["1", "5"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.9972097248947277`*^9, {3.99721692461454*^9, 3.9972169424432354`*^9}},
 CellLabel->"Out[17]=",ExpressionUUID->"24a61e81-33e2-8b41-ae74-bcf63c40ce96"]
}, Open  ]],

Cell["\<\
Averaging the same channel over the group is the twirl. What comes back has \
no preferred axis and no shift:\
\>", "Text",
 CellChangeTimes->{{3.9972230230739994`*^9, 
  3.997223026443016*^9}},ExpressionUUID->"19c34d59-e960-ee48-8be3-\
2801e6a86011"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "@", 
  RowBox[{"blochOf", "[", 
   RowBox[{
    RowBox[{"Mean", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "c", "]"}], ".", 
        RowBox[{"damp", "[", 
         RowBox[{"c", ".", "#", ".", 
          RowBox[{"ConjugateTranspose", "[", "c", "]"}]}], "]"}], ".", "c"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", "cliff"}], "}"}]}], "]"}], "]"}], "&"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9972097461413517`*^9, 3.997209747890814*^9}, {
  3.9972169696458397`*^9, 3.997216970474207*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"4e12e6b5-e0c6-f545-bf4b-7d92ccd9c79f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox["4", "15"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SqrtBox["5"]}], ")"}]}], ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{
        FractionBox["4", "15"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SqrtBox["5"]}], ")"}]}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{
        FractionBox["4", "15"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SqrtBox["5"]}], ")"}]}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9972097496832504`*^9, 3.997216971249754*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"5fe09642-a3c2-004f-bad1-46f23272007a"]
}, Open  ]],

Cell[TextData[{
 "Start in \[Divides]0\:27e9, apply ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e824d448-9459-184e-8f3e-5c8cf219ada7"],
 " random Cliffords with the noise after each, then the inverting Clifford \
followed by the noise once more, and report the probability of finding \
\[Divides]0\:27e9 again:"
}], "Text",
 CellChangeTimes->{{3.997223057971098*^9, 
  3.9972230876340847`*^9}},ExpressionUUID->"d0694f8c-d3ea-0c45-8bb8-\
9669edf19382"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"step", "[", 
    RowBox[{"rho_", ",", "c_"}], "]"}], ":=", 
   RowBox[{"damp", "[", 
    RowBox[{"c", ".", "rho", ".", 
     RowBox[{"ConjugateTranspose", "[", "c", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"survival", "[", "m_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"seq", "=", 
      RowBox[{"RandomChoice", "[", 
       RowBox[{
        RowBox[{"N", "[", "cliff", "]"}], ",", "m"}], "]"}]}], "}"}], ",", 
    RowBox[{"Re", "@", 
     RowBox[{
      RowBox[{"step", "[", 
       RowBox[{
        RowBox[{"Fold", "[", 
         RowBox[{"step", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1.", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", "seq"}], "]"}], ",", 
        RowBox[{"ConjugateTranspose", "[", 
         RowBox[{"Dot", "@@", 
          RowBox[{"Reverse", "[", "seq", "]"}]}], "]"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.997209754976282*^9, 3.9972097561534786`*^9}, {
  3.9972169779642925`*^9, 3.997216984924412*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"244dee3d-2a58-ce4e-82df-f00b72f3aa3a"],

Cell["\<\
The decay curve is the survival averaged over many sequences at each length, \
which is what performs the twirl:\
\>", "Text",
 CellChangeTimes->{{3.997223108171772*^9, 
  3.997223109210367*^9}},ExpressionUUID->"3346405e-7254-c544-af82-\
6e0efc3c0fb2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{"rbData", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", ",", 
      RowBox[{"Mean", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"survival", "[", "m", "]"}], ",", "1000"}], "]"}], "]"}]}], 
     "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", 
      RowBox[{"Range", "[", 
       RowBox[{"1", ",", "41", ",", "4"}], "]"}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.997209762455246*^9, 3.997209774068138*^9}, {
  3.997216990796297*^9, 3.997217032335411*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"33af40da-3945-8c42-8d8e-33b868835140"],

