 CellLabel->"Out[31]=",ExpressionUUID->"096a4019-93ab-0b40-b53b-280dbf64f1d8"]
}, Open  ]],

Cell["Computing the required quantities:", "Text",
 CellChangeTimes->{{3.997223142059025*^9, 
  3.997223147200012*^9}},ExpressionUUID->"d1c2689e-425c-2240-b34a-\
d0e5d200ec5a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pFit", "=", 
   RowBox[{"p", "/.", " ", 
    RowBox[{"rbFit", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<decay p\>\"", "->", "pFit"}], ",", 
   RowBox[{"\"\<depolarizing parameter\>\"", "->", 
    RowBox[{"1", "-", "pFit"}]}], ",", 
   RowBox[{"\"\<error per Clifford\>\"", "->", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "pFit"}], ")"}], "/", "2"}]}], ",", 
   RowBox[{"\"\<average gate fidelity\>\"", "->", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", "pFit"}], ")"}], "/", "2"}]}]}], "|>"}]}], "Input",
 CellChangeTimes->{{3.997209827931284*^9, 3.9972098287498856`*^9}, {
  3.997217153399023*^9, 3.9972171541291256`*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"40f5f902-d792-4048-92ac-34e66aeaf2a6"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"decay p\"\>", "\[Rule]", "0.8660086061660653`"}], ",", 
   RowBox[{"\<\"depolarizing parameter\"\>", "\[Rule]", 
    "0.13399139383393466`"}], ",", 
   RowBox[{"\<\"error per Clifford\"\>", "\[Rule]", "0.06699569691696733`"}], 
   ",", 
   RowBox[{"\<\"average gate fidelity\"\>", "\[Rule]", 
