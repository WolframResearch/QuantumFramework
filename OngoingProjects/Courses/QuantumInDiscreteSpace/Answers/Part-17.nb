Cell["\<\
The estimator reports whether the linear solve was invertible and whether \
what it returned was a state:\
\>", "Text",
 CellChangeTimes->{{3.996878430535492*^9, 
  3.996878432939825*^9}},ExpressionUUID->"7593551d-eaf1-d743-b704-\
79f00e411d4a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"est", "[", "\"\<Invertible\>\"", "]"}], ",", 
   RowBox[{"est", "[", "\"\<PhysicalInversion\>\"", "]"}], ",", 
   RowBox[{"est", "[", "\"\<TotalCounts\>\"", "]"}], ",", 
   RowBox[{"est", "[", "\"\<CountsPerMeasurement\>\"", "]"}]}], 
  "}"}]], "Input",
 CellChangeTimes->{{3.9968784144549274`*^9, 3.996878415284876*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"bda10427-aefb-6e4d-9af6-3e9f4b5acfda"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "60", ",", "20"}], "}"}]], "Output",
 CellChangeTimes->{3.9968784158732986`*^9},
 CellLabel->"Out[45]=",ExpressionUUID->"1fc8e85f-01af-ae42-a958-63caba0a5f74"]
}, Open  ]],

Cell["\<\
Two estimates come back: the linear inversion made physical, and the state \
maximizing the likelihood of the observed counts:\
\>", "Text",
 CellChangeTimes->{{3.9968785437191887`*^9, 
  3.996878545358511*^9}},ExpressionUUID->"4f6fffd2-14cd-a542-8d24-\
6a49ee3c1acd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"est", "[", "\"\<InversionState\>\"", "]"}], 
    "[", "\"\<BlochVector\>\"", "]"}], ",", 
   RowBox[{
    RowBox[{"est", "[", "\"\<MaximumLikelihoodState\>\"", "]"}], 
    "[", "\"\<BlochVector\>\"", "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.9968784412379303`*^9, 3.9968784607888813`*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"21f067e8-4edc-7a48-bced-91e63ee8347f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "0.2913857587071793`", ",", "0.38851434494290576`", ",", 
     "0.8741572761215379`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "0.2791786447341845`", ",", "0.37398073215364025`", ",", 
     "0.8844194119881243`"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.996878443069708*^9, 3.996878461686392*^9}},
 CellLabel->"Out[47]=",ExpressionUUID->"1a0a2879-e64c-cc44-b515-cd33107f48cc"]
}, Open  ]],

Cell["\<\
Handing the estimator the counts the WL side drew separates the inversion map \
from the sample it was fed, and that map is the same rescaling:\
\>", "Text",
 CellChangeTimes->{{3.9968786587420826`*^9, 
  3.996878665402466*^9}},ExpressionUUID->"a9721f76-16dd-b542-b302-\
f8c8d4830453"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"rFix", "-", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumStateEstimate", "[", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"pauli", ",", "counts"}], "]"}], "]"}], 
     "[", "\"\<InversionState\>\"", "]"}], "[", "\"\<BlochVector\>\"", 
    "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9968784782329884`*^9, 3.996878485617134*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"b9b832fa-6d3d-c744-ad97-2d8e72416038"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{{3.9968784800704994`*^9, 3.9968784862606583`*^9}},
 CellLabel->"Out[49]=",ExpressionUUID->"4618a2a9-4db1-aa49-8dc7-66959674e702"]
}, Open  ]],

Cell["Compute the fidelity of the states:", "Text",
 CellChangeTimes->{{3.9968786269213753`*^9, 
  3.996878642161625*^9}},ExpressionUUID->"3b846ea5-5b91-704c-9d58-\
fceb8e7f38b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"QuantumSimilarity", "[", 
    RowBox[{"qtruth", ",", 
     RowBox[{"est", "[", "\"\<InversionState\>\"", "]"}]}], "]"}], ",", 
   RowBox[{"QuantumSimilarity", "[", 
    RowBox[{"qtruth", ",", 
     RowBox[{"est", "[", "\"\<MaximumLikelihoodState\>\"", "]"}]}], "]"}]}], 
  "}"}]], "Input",
 CellChangeTimes->{{3.996878565657982*^9, 3.9968785858616886`*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"d3cc60eb-6fad-8145-a610-3e41282e47f5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.9940176788339955`", ",", "0.9938868591871187`"}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.9968785670821266`*^9, 3.996878586414072*^9}},
 CellLabel->"Out[51]=",ExpressionUUID->"7e70fe17-f4c5-8e48-b332-8b4454d8cb69"]
}, Open  ]],

Cell["\<\
Raising the number of copies drives the statistical error down, and on a \
large sample the same pipeline returns the state it started from:\
\>", "Text",
 CellChangeTimes->{{3.9968786885651875`*^9, 
  3.9968786940929394`*^9}},ExpressionUUID->"421fe8de-9e12-d443-91aa-\
67582e5fb5c2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "3", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"big", "=", 
     RowBox[{"QuantumStateEstimate", "[", 
      RowBox[{"QuantumMeasurementSimulation", "[", 
       RowBox[{"qtruth", ",", "pauli", ",", "200000"}], "]"}], "]"}]}], "}"}],
    ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"big", "[", "\"\<InversionState\>\"", "]"}], 
      "[", "\"\<BlochVector\>\"", "]"}], ",", 
     RowBox[{"QuantumSimilarity", "[", 
      RowBox[{"qtruth", ",", 
       RowBox[{"big", "[", "\"\<InversionState\>\"", "]"}]}], "]"}]}], 
    "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.996878595330076*^9, 3.9968786182553463`*^9}},
 CellLabel->"In[56]:=",ExpressionUUID->"d8707497-0263-554f-94b7-59288393d7de"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "0.39721000000000045`", ",", "0.29850999999999994`", ",", 
     "0.8507300000000001`"}], "}"}], ",", "0.99999482065237`"}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.9968785971480026`*^9, 3.9968786188308983`*^9}},
 CellLabel->"Out[57]=",ExpressionUUID->"8c6d0c1b-e02f-674b-a263-bc57e81b12f8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
17.2 [MSc] How do I reconstruct an unknown channel by process tomography?\
\>", "Subsection",
 CellChangeTimes->{
  3.9971780525040646`*^9},ExpressionUUID->"5ab8213a-1947-6047-bd73-\
218f330ed2ab"],

Cell["\<\
A channel is linear, so it is fixed by its action on a spanning set of \
operators, and the Choi matrix packages that action as a single matrix (Part \
13, 13.3). Process tomography therefore reduces to: prepare a spanning set of \
 known inputs, reconstruct each output state by ordinary state tomography, \
and assemble the channel.\
\>", "Text",
 CellChangeTimes->{{3.9971783145946217`*^9, 
  3.997178368112791*^9}},ExpressionUUID->"15ad6958-8d29-b84e-beb2-\
938f4ece17cd"],

Cell[TextData[{
 "For a qubit four inputs suffice, and the four have to span the Hermitian \
operators rather than merely be distinct states. For example, a spanning set \
of states does not contain \[Divides]0\:27e9\:27e81\[Divides], which is not a \
state at all, so its image is never measured directly. Linearity supplies it, \
writing  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
    Cell["|",ExpressionUUID->"ad0e8809-ccfd-ec4c-86b2-8dbdc111d444"], "0", 
     Cell["\[RightAngleBracket]",ExpressionUUID->
      "ae4ffe5b-7967-9b4c-8176-aa46c5201a7a"], Cell[
     "\[LeftAngleBracket]",ExpressionUUID->
      "b68f75dc-b65c-c44a-ae07-4957e24a3816"], "1", Cell[
     "|",ExpressionUUID->"890948d1-c721-ed4b-a6bb-1463f473d4aa"]}], "=", 
    RowBox[{
     SubscriptBox["P", "+"], "+", " ", 
     RowBox[{"\[ImaginaryI]", " ", 
      SubscriptBox["P", "\[ImaginaryI]"]}], "-", 
     RowBox[{
      FractionBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "\[ImaginaryI]"}], ")"}], "2"], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["P", "0"], "+", 
        SubscriptBox["P", "1"]}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "91bd8489-903e-054b-a9e2-5e7568101ebc"],
 " in terms of the four prepared projectors gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[CurlyEpsilon]", "(", 
       RowBox[{"|", "0"}]}], "\[RightAngleBracket]"}], 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"1", "|"}]}]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1ee9068e-0a55-9848-a596-5e4a73fb0c5f"],
 " from the four measured outputs."
}], "Text",
 CellChangeTimes->{
  3.997178401065092*^9, {3.9971785995057144`*^9, 3.9971786670776615`*^9}, {
   3.997178710928583*^9, 
   3.9971788546119423`*^9}},ExpressionUUID->"c8aef3cc-f372-f547-9633-\
6d2c9be4dbe7"],

Cell["\<\
The cost scales badly. A state of a qubit has three parameters, a \
trace-preserving qubit channel has twelve, so four tomographies are the \
minimum and each carries its own statistical error. The obstruction of 17.1 \
returns in a stronger form. There the linear estimate could leave the Bloch \
ball; here the assembled Choi matrix can fail to be positive semidefinite, \
which means the reconstructed map is not completely positive. Trace \
preservation, by contrast, comes for free in this assembly, since each \
reconstructed output is a normalized state.\
\>", "Text",
 CellChangeTimes->{{3.997178863382002*^9, 
  3.9971788756536617`*^9}},ExpressionUUID->"d85eb554-c773-ac4f-bb4e-\
5cddbd517048"],

Cell["\<\
The cost scales badly. A state of a qubit has three parameters; a \
trace-preserving qubit channel has twelve, so four tomographies are the \
minimum and each carries its own statistical error.\
\>", "Text",
 CellChangeTimes->{
  3.9971792787603874`*^9},ExpressionUUID->"23ea39a0-df0f-fe49-acf4-\
f0398d1af828"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9971781333445683`*^9, 
  3.997178134794384*^9}},ExpressionUUID->"6438f279-ad7e-424b-9668-\
284669b68cf8"],

Cell["An channel whose damping is drawn at random:", "Text",
 CellChangeTimes->{{3.9971836117302513`*^9, 
  3.9971836179365845`*^9}},ExpressionUUID->"6c73df0a-9eca-f640-b789-\
61d872a456c9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "11", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gammaTrue", "=", 
   RowBox[{"RandomReal", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kraus", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", "gammaTrue"}], "]"}]}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"Sqrt", "[", "gammaTrue", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"map", "[", "s_", "]"}], ":=", 
  RowBox[{"Total", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"#", ".", "s", ".", 
      RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], "&"}], "/@", "kraus"}],
    "]"}]}]}], "Input",
 CellChangeTimes->{{3.9971821792104645`*^9, 3.9971821865162086`*^9}, {
  3.9971928721968536`*^9, 3.9971928764704933`*^9}, {3.997198208753914*^9, 
  3.997198213700161*^9}, {3.997198535296934*^9, 3.997198542264078*^9}},
 CellLabel->
  "In[253]:=",ExpressionUUID->"fd52088e-5e9c-3c49-bd5a-4caf9a45fa40"],

Cell["The four inputs whose images will be measured:", "Text",
 CellChangeTimes->{{3.997183633236828*^9, 
  3.997183642815834*^9}},ExpressionUUID->"a8476ae8-143e-c449-a20c-\
ed5bd23966c2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p0", ",", "p1", ",", "pplus", ",", "pi"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
        RowBox[{"PauliMatrix", "[", "1", "]"}]}], ")"}], "/", "2"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
        RowBox[{"PauliMatrix", "[", "2", "]"}]}], ")"}], "/", "2"}]}], 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9971821916820107`*^9, 3.9971822035103683`*^9}, {
  3.997198550697668*^9, 3.997198555214861*^9}},
 CellLabel->
  "In[258]:=",ExpressionUUID->"9e0b31b4-4748-8545-a3d6-a14aa729da75"],

Cell["Prove the statement of the mapping of |0\[RightAngleBracket]\
\[LeftAngleBracket]1|:", "Text",
 CellChangeTimes->{{3.9971837208641148`*^9, 
  3.9971837348471355`*^9}},ExpressionUUID->"ee2f61ac-9112-aa4a-b905-\
35b93e3bd194"],

Cell["Measurement projectors:", "Text",
 CellChangeTimes->{{3.9971837522213516`*^9, 
  3.997183762328081*^9}},ExpressionUUID->"eabc5cd7-05fd-7f4d-891d-\
c486429b0d0d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"proj", "[", "k_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], "-", 
        RowBox[{"PauliMatrix", "[", "k", "]"}]}], ")"}], "/", "2"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
        RowBox[{"PauliMatrix", "[", "k", "]"}]}], ")"}], "/", "2"}]}], 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9971822280819607`*^9, 3.9971822304289665`*^9}, 
   3.9971837494137*^9, {3.99719856336792*^9, 3.9971985699600105`*^9}},
 CellLabel->
  "In[259]:=",ExpressionUUID->"38125576-b73d-e741-8cb4-8872268edb09"],

Cell["State tomography: ", "Text",
 CellChangeTimes->{{3.9971822280819607`*^9, 3.9971822304289665`*^9}, {
  3.9971837494137*^9, 
  3.997183786753271*^9}},ExpressionUUID->"fd10fa53-1bbc-5c49-8a2d-\
add050eebc65"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tomo", "[", 
   RowBox[{"s_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"out", "=", 
       RowBox[{"map", "[", "s", "]"}]}], ",", "probs", ",", "counts", ",", 
      "r"}], "}"}], ",", 
    RowBox[{
     RowBox[{"probs", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{"out", ".", "#"}], "]"}], "]"}], "&"}], "/@", 
         RowBox[{"proj", "[", "k", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"counts", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"RandomVariate", "[", 
         RowBox[{"MultinomialDistribution", "[", 
          RowBox[{"n", ",", 
           RowBox[{"N", "[", 
            RowBox[{"probs", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
          RowBox[{"Total", "[", "#", "]"}]}], "&"}], "/@", "counts"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r", "/", 
           RowBox[{"Max", "[", 
            RowBox[{"1", ",", 
             RowBox[{"Norm", "[", "r", "]"}]}], "]"}]}], ")"}], ".", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], ")"}], "/", 
      "2"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9971822280819607`*^9, 3.9971822304289665`*^9}, {
   3.9971837494137*^9, 3.9971837669081993`*^9}, 3.9971985736906223`*^9},
 CellLabel->
  "In[260]:=",ExpressionUUID->"4465a670-23db-544f-b67b-23ca68171a1e"],

Cell["Do it for each of the known input states:", "Text",
 CellChangeTimes->{{3.9971838032983246`*^9, 
  3.997183810373913*^9}},ExpressionUUID->"92c86404-3543-8046-aa4a-\
fdb47ccb2a72"],

Cell[BoxData[
 RowBox[{
  RowBox[{"est", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"tomo", "[", 
      RowBox[{"#", ",", "2000"}], "]"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{"p0", ",", "p1", ",", "pplus", ",", "pi"}], "}"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.997182239381611*^9, 3.9971822445284634`*^9}, {
  3.997198580780504*^9, 3.997198583811638*^9}},
 CellLabel->
  "In[262]:=",ExpressionUUID->"13c87cf6-d2a2-d243-b5da-8b02e15d9cd2"],

Cell["\<\
Each reconstruction is a state in its own right, with unit trace and no \
negative eigenvalue:\
\>", "Text",
 CellChangeTimes->{{3.997183832714695*^9, 
  3.997183833869402*^9}},ExpressionUUID->"8540d358-b1c3-3c4f-8355-\
1c5cca55c694"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "@", 
  RowBox[{"Chop", "@", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Tr", "/@", "est"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{"Re", "[", 
         RowBox[{"Eigenvalues", "[", "#", "]"}], "]"}], "]"}], "&"}], "/@", 
      "est"}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.997182251484333*^9, 3.997182252031231*^9}, {
  3.997192925824316*^9, 3.997192936589388*^9}, {3.9971985992901287`*^9, 
  3.997198601277519*^9}},
 CellLabel->
  "In[264]:=",ExpressionUUID->"7730bb38-011f-5b44-bf58-260f784f67ed"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1.`", ",", "1.`", ",", "1.`", ",", "1.`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "0.`", ",", "0.22547950896153499`", ",", "0.04675089630535395`", ",", 
     "0.038125016914749954`"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.99718225250198*^9, {3.997192927191904*^9, 3.997192936801876*^9}, {
   3.9971985920490437`*^9, 3.9971986016058903`*^9}},
 CellLabel->
  "Out[264]=",ExpressionUUID->"536aa504-7bf4-c74d-8fb6-1844eeb117e3"]
}, Open  ]],

Cell["\<\
Assembling the four blocks gives the Choi matrix of the reconstructed map:\
\>", "Text",
 CellChangeTimes->{{3.9971869905546684`*^9, 
  3.997186991676668*^9}},ExpressionUUID->"77f44219-079b-1043-bfb6-\
3c34b5d53fe4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"e01", "=", 
   RowBox[{
    RowBox[{"est", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "+", 
    RowBox[{"I", " ", 
     RowBox[{"est", "[", 
      RowBox[{"[", "4", "]"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "I"}], ")"}], "/", "2"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"est", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "+", 
       RowBox[{"est", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"J", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"p0", ",", 
        RowBox[{"est", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "+", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", "e01"}], "]"}], "+", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
        RowBox[{"ConjugateTranspose", "[", "e01", "]"}]}], "]"}], "+", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"p1", ",", 
        RowBox[{"est", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ")"}], "/", "2"}]}], 
  ";"}], "\n", 
 RowBox[{"Chop", "@", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Tr", "[", "J", "]"}], ",", 
    RowBox[{"Eigenvalues", "[", "J", "]"}]}], "}"}]}]}], "Input",
 CellChangeTimes->{{3.9971986077130165`*^9, 3.9971986083867702`*^9}},
 CellLabel->
  "In[265]:=",ExpressionUUID->"208d59f5-8434-f34f-aa09-f79b0953c664"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1.`", ",", 
   RowBox[{"{", 
    RowBox[{"0.8903339269378463`", ",", "0.1132885820955739`", ",", 
     RowBox[{"-", "0.0038323561101135323`"}], ",", "0.0002098470766935484`"}],
     "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.997198610386633*^9},
 CellLabel->
  "Out[267]=",ExpressionUUID->"8a259eac-3e61-3c44-a85a-18d4cd995999"]
}, Open  ]],

Cell["\<\
Kraus operators are the eigenvectors of the Choi state, unstacked into \
matrices and weighted by the square root of the eigenvalues. Negative \
eigenvalues are dropped, and the surviving set is renormalized so that it \
closes the completeness relation again:\
\>", "Text",
 CellChangeTimes->{{3.9971986818632126`*^9, 
  3.9971986875159817`*^9}},ExpressionUUID->"ddfebb2e-443d-c745-a0a4-\
3ee1e0682c42"],

Cell[BoxData[
 RowBox[{
  RowBox[{"krausFrom", "[", 
   RowBox[{"lam_", ",", "vec_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"kr", ",", "m"}], "}"}], ",", 
    RowBox[{
     RowBox[{"kr", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"2", " ", 
              RowBox[{"Max", "[", 
               RowBox[{
                RowBox[{"Re", "[", "#1", "]"}], ",", "0"}], "]"}]}], "]"}], " ", 
            RowBox[{"Transpose", "[", 
             RowBox[{"ArrayReshape", "[", 
              RowBox[{
               RowBox[{"Normalize", "[", "#2", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"2", ",", "2"}], "}"}]}], "]"}], "]"}]}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"lam", ",", "vec"}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", "#", "]"}], "]"}], ">", 
          RowBox[{"10", "^", 
           RowBox[{"-", "6"}]}]}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{"MatrixPower", "[", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", "#", "]"}], ".", "#"}], "&"}], 
          "/@", "kr"}], "]"}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"#", ".", "m"}], "&"}], "/@", "kr"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.997198304787895*^9, 3.9971983079104156`*^9}, {
  3.9971986268206024`*^9, 3.997198628607952*^9}},
 CellLabel->
  "In[268]:=",ExpressionUUID->"a3a40c54-8ad6-8c4c-89e3-5d74e98dddd4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kEst", "=", 
   RowBox[{"krausFrom", "@@", 
    RowBox[{"Eigensystem", "[", "J", "]"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "kEst", "]"}], ",", 
   RowBox[{"Chop", "@", 
    RowBox[{"Max", "@", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", "#", "]"}], ".", "#"}], "&"}], "/@",
          "kEst"}], "]"}], "-", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}]}]}], 
  "}"}]}], "Input",
 CellChangeTimes->{{3.99719863589641*^9, 3.997198636867771*^9}},
 CellLabel->
  "In[269]:=",ExpressionUUID->"b849458b-a9de-034f-87a5-494a8d14b731"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.997198637722332*^9},
 CellLabel->
  "Out[270]=",ExpressionUUID->"64e98f87-2924-064d-99ba-a1fcbc55d707"]
}, Open  ]],

Cell["\<\
The reconstruction is now a map, and the test is applied to a state:\
\>", "Text",
 CellChangeTimes->{{3.997198737250313*^9, 
  3.9971987519808006`*^9}},ExpressionUUID->"ca412a37-288b-7744-9106-\
47ac9d3541ec"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mapEst", "[", "s_", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", ".", "s", ".", 
       RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], "&"}], "/@", "kEst"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fresh", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"2", "/", "5"}], ",", 
            RowBox[{
             RowBox[{"-", "3"}], "/", "5"}], ",", 
            RowBox[{"1", "/", "2"}]}], "}"}], "]"}], ".", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], ")"}], "/", 
      "2"}]}], "}"}], ",", 
   RowBox[{"Chop", "@", 
    RowBox[{"Max", "@", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"mapEst", "[", "fresh", "]"}], "-", 
       RowBox[{"map", "[", "fresh", "]"}]}], "]"}]}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9971986996395454`*^9, 3.9971987090212536`*^9}},
 CellLabel->
  "In[272]:=",ExpressionUUID->"8f29a8cd-3e28-f441-aa3b-db0eb55b60c2"],

Cell[BoxData["0.0069438341317904495`"], "Output",
 CellChangeTimes->{3.9971987141761513`*^9},
 CellLabel->
  "Out[273]=",ExpressionUUID->"ad848d7d-2389-ea4a-9bcb-89f280afe05a"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9971781388446693`*^9, 
  3.9971781397844753`*^9}},ExpressionUUID->"00705e99-1fbf-6645-b896-\
215079fbd16a"],

Cell["The same unknown channel as an object:", "Text",
 CellChangeTimes->{{3.99719303246257*^9, 
  3.997193041385067*^9}},ExpressionUUID->"d10ffa62-af33-4040-a16b-\
a4f63bee7e82"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc", "=", 
   RowBox[{"QuantumChannel", "[", 
    RowBox[{
     RowBox[{"\"\<AmplitudeDamping\>\"", "[", "p", "]"}], ",", 
     RowBox[{"\"\<Parameters\>\"", "->", "p"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ch", " ", "=", " ", 
   RowBox[{"qc", "[", "gammaTrue", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9971822894190826`*^9, 3.9971823065272484`*^9}, {
  3.997185741137644*^9, 3.997185743836525*^9}, {3.997193583080288*^9, 
  3.9971936301948223`*^9}},
 CellLabel->
  "In[274]:=",ExpressionUUID->"bfe5de19-ffa9-4145-b4ae-7fb1e0df04e8"],

Cell["The four input states:", "Text",
 CellChangeTimes->{{3.997193043674902*^9, 
  3.997193047999899*^9}},ExpressionUUID->"f4242e05-2a4f-0742-947d-\
4d68ae06dd81"],

Cell[BoxData[
 RowBox[{
  RowBox[{"inputs", "=", 
   RowBox[{"QuantumState", "/@", 
    RowBox[{"{", 
     RowBox[{"\"\<0\>\"", ",", "\"\<1\>\"", ",", "\"\<Plus\>\"", 
      ",", "\"\<Right\>\""}], "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9971823140343895`*^9, 3.997182314458084*^9}, {
  3.9971857505797977`*^9, 3.997185751440439*^9}},
 CellLabel->
  "In[276]:=",ExpressionUUID->"7b846be7-8bae-4e41-aab9-4c6a811c9c3b"],

Cell["\<\
Each output is tomographed by the pipeline of 17.1, which returns a state \
estimation for each:\
\>", "Text",
 CellChangeTimes->{{3.997193058057377*^9, 
  3.9971930775059566`*^9}},ExpressionUUID->"6bdd7bdf-1868-e244-a3bd-\
dd180ae540d5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pauli", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumMeasurementOperator", "[", 
      RowBox[{"QuantumOperator", "[", "#", "]"}], "]"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}]}], 
  ";"}], "\n", 
 RowBox[{"outs", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumStateEstimate", "[", 
     RowBox[{"QuantumMeasurementSimulation", "[", 
      RowBox[{
       RowBox[{"ch", "[", "#", "]"}], ",", "pauli", ",", "1000"}], "]"}], 
     "]"}], "&"}], "/@", "inputs"}]}]}], "Input",
 CellChangeTimes->{{3.997182322025606*^9, 3.9971823228627605`*^9}, {
  3.9971857596883507`*^9, 3.9971857601645565`*^9}, {3.9971931324137516`*^9, 
