Cell["\<\
Measuring that observable on the target gives its expectation value:\
\>", "Text",
 CellChangeTimes->{{3.994784877761736*^9, 
  3.994784878583111*^9}},ExpressionUUID->"3e9621c6-7d1e-9f4d-81c2-\
137c1644d595"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumMeasurementOperator", "[", "witQF", "]"}], "[", 
   RowBox[{"QuantumState", "[", "\"\<PhiPlus\>\"", "]"}], "]"}], 
  "[", "\"\<Mean\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.9947848694475937`*^9, 3.9947848698778667`*^9}},
 CellLabel->
  "In[158]:=",ExpressionUUID->"a2cc92a7-5da6-5547-b3cb-cd848475d364"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox["1", "2"]}]], "Output",
 CellChangeTimes->{{3.9947848707745705`*^9, 3.994784882100918*^9}, 
   3.9948481703396034`*^9, 3.9957321403133736`*^9},
 CellLabel->
  "Out[158]=",ExpressionUUID->"5341a9ad-656d-9340-ae9e-523f9eb8c288"]
}, Open  ]],

Cell["And on a general product state, the same closed form:", "Text",
 CellChangeTimes->{{3.994784923820324*^9, 
  3.9947849364867535`*^9}},ExpressionUUID->"497dfaa7-6e35-f64f-92d9-\
d4a48cd1edce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"QuantumCircuitOperator", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"\"\<U3\>\"", "[", 
           RowBox[{"\[Theta]a", ",", "\[Phi]a", ",", "0"}], "]"}], "->", 
          "1"}], ",", 
         RowBox[{
          RowBox[{"\"\<U3\>\"", "[", 
           RowBox[{"\[Theta]b", ",", "\[Phi]b", ",", "0"}], "]"}], "->", 
          "2"}], ",", 
         RowBox[{"QuantumMeasurementOperator", "[", "witQF", "]"}]}], "}"}], 
       "]"}], "[", "]"}], "[", "\"\<Mean\>\"", "]"}], "\[Equal]", "expW"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Theta]a", ",", "\[Phi]a", ",", "\[Theta]b", ",", "\[Phi]b"}], 
     "}"}], "\[Element]", 
    TemplateBox[{},
     "Reals"]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9947848927358875`*^9, 3.994784895072191*^9}, 
   3.99573217373394*^9, 3.99573286212599*^9, {3.9957329112038364`*^9, 
   3.9957329363516884`*^9}},
 CellLabel->
  "In[172]:=",ExpressionUUID->"2238c7a1-b50f-e54d-8dc8-1e7370680282"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.994784902593546*^9, 3.9948481790427895`*^9, 
  3.9957329080149097`*^9, 3.995732941429878*^9},
 CellLabel->
  "Out[172]=",ExpressionUUID->"1d4ddddd-b766-d849-8988-0cf5138dbd1f"]
}, Open  ]],

Cell[TextData[{
 "Both give the same witness, with expectation value -1/2 on the Bell state, \
and on product states the closed form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{
       SubscriptBox["n", "a"], "\[CenterDot]", 
       SubscriptBox["n", "b"]}]}], ")"}], "/", "4"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "852bb81e-a73f-9a4f-921f-230438b3daa3"],
 ", which is nonnegative because a dot product of unit vectors never exceeds \
one, and vanishes exactly on the aligned product states. So a single \
Hermitian observable, measurable without any tomography, separates this \
entangled state from every separable one; the price is that the witness is \
tailored to the target, and a different entangled state generally needs a \
different one."
}], "Text",
 CellChangeTimes->{{3.994784977712553*^9, 
  3.9947850293633575`*^9}},ExpressionUUID->"0e705668-ccd2-f647-b9ea-\
365c0bc4e4c0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
11.9 [MSc] How do I decide whether a pure state can be converted to another \
by LOCC (Nielsen\[CloseCurlyQuote]s theorem)?\
\>", "Subsection",
 CellChangeTimes->{
  3.994785073579052*^9},ExpressionUUID->"4c751d09-a22d-c441-8f85-\
39ad228320e7"],

Cell["\<\
Nielsen\[CloseCurlyQuote]s theorem: one pure state can be turned into another \
with certainty by local operations and classical communication if and only if \
the first state\[CloseCurlyQuote]s vector of Schmidt weights, the squared \
Schmidt coefficients sorted decreasing, is majorized by the second\
\[CloseCurlyQuote]s. Majorized means every partial sum of the first is at \
most the corresponding partial sum of the second. Flatter weights mean more \
entanglement, and LOCC can only steepen them. Take two states of two qutrits \
with weights
{1/2, 3/10, 1/5} and {3/5,1/5,1/5}\
\>", "Text",
 CellChangeTimes->{{3.994785127141388*^9, 
  3.994785169525503*^9}},ExpressionUUID->"03eb3a75-b72f-2548-aca6-\
7fdf796cb098"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.994785266893244*^9, 
  3.9947852681140633`*^9}},ExpressionUUID->"404682b9-bf13-2a44-b0c8-\
4581a23895c0"],

Cell["\<\
A state with prescribed Schmidt weights is the sum of the matched basis kets \
\[Divides]kk\:27e9 weighted by the square roots:\
\>", "Text",
 CellChangeTimes->{{3.9947852809414673`*^9, 
  3.994785299452671*^9}},ExpressionUUID->"d260f6f5-9b05-7845-b120-\
558695780f02"],

Cell[BoxData[
 RowBox[{
  RowBox[{"psi", "=", 
   RowBox[{"Normalize", "@", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", 
         RowBox[{"3", "/", "10"}], ",", 
         RowBox[{"1", "/", "5"}]}], "}"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"#", ",", "#"}], "]"}], "]"}], "&"}], "/@", 
        RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ")"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.994785188505455*^9, 3.994785189005081*^9}},
 CellLabel->"In[89]:=",ExpressionUUID->"44fb28c2-c349-3641-85f4-4f0c6eee5c61"],

Cell[BoxData[
 RowBox[{
  RowBox[{"phi", "=", 
   RowBox[{"Normalize", "@", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"3", "/", "5"}], ",", 
         RowBox[{"1", "/", "5"}], ",", 
         RowBox[{"1", "/", "5"}]}], "}"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"#", ",", "#"}], "]"}], "]"}], "&"}], "/@", 
        RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ")"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.994785194359476*^9, 3.994785194825556*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"2fdefd49-3349-0940-b2ce-46c108f66182"],

Cell["\<\
Recover the weights from the states themselves, as the squared singular \
values of the reshaped amplitudes (11.3):\
\>", "Text",
 CellChangeTimes->{{3.9947852039046574`*^9, 
  3.994785206081396*^9}},ExpressionUUID->"1d5d19f5-d599-e840-9239-\
c939f0cec410"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"lp", ",", "lq"}], "}"}], "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"SingularValueList", "[", 
         RowBox[{"ArrayReshape", "[", 
          RowBox[{"#1", ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "3"}], "}"}]}], "]"}], "]"}], "2"], ",", 
       "Greater"}], "]"}], "&"}], ")"}], "/@", 
   RowBox[{"{", 
    RowBox[{"psi", ",", "phi"}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.9947852108362427`*^9, 3.994785211252899*^9}, 
   3.994785257706274*^9},
 CellLabel->"In[91]:=",ExpressionUUID->"79ac341f-759d-5b4f-993b-73b7d1a96884"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", "2"], ",", 
     FractionBox["3", "10"], ",", 
     FractionBox["1", "5"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["3", "5"], ",", 
     FractionBox["1", "5"], ",", 
     FractionBox["1", "5"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9947852117838993`*^9, 3.9947852601856213`*^9, 
  3.9948481976531563`*^9},
 CellLabel->"Out[91]=",ExpressionUUID->"ce71a736-bc24-2f4f-b629-d6420b74b578"]
}, Open  ]],

Cell["\<\
Majorization is the comparison of the two partial-sum sequences, checked in \
both directions:\
\>", "Text",
 CellChangeTimes->{{3.994785323446104*^9, 
  3.9947853253956127`*^9}},ExpressionUUID->"7af484be-bf28-3d46-818d-\
67317b1538cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"And", "@@", 
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"Accumulate", "[", "lp", "]"}], "<=", 
      RowBox[{"Accumulate", "[", "lq", "]"}]}], "]"}]}], ",", 
   RowBox[{"And", "@@", 
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"Accumulate", "[", "lq", "]"}], "<=", 
      RowBox[{"Accumulate", "[", "lp", "]"}]}], "]"}]}]}], "}"}]], "Input",
 CellChangeTimes->{{3.9947853085211945`*^9, 3.9947853089901466`*^9}},
 CellLabel->"In[92]:=",ExpressionUUID->"7acb2dce-f71f-8d44-bd8f-e8c261a2f5a3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellChangeTimes->{3.994785309523119*^9, 3.994848199630047*^9},
 CellLabel->"Out[92]=",ExpressionUUID->"8ca79c59-a9f0-3445-b526-9c4d0caf574e"]
}, Open  ]],

Cell["\<\
The entropies order consistently, since the allowed direction can only lose \
entanglement:\
\>", "Text",
 CellChangeTimes->{{3.9947858380963554`*^9, 
  3.994785839226898*^9}},ExpressionUUID->"20840a97-271c-c647-be7e-\
2a0a94358554"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", " ", 
         RowBox[{"Log2", "[", "#", "]"}]}], "&"}], "/@", "#"}], "]"}]}], 
    "&"}], "/@", 
   RowBox[{"{", 
    RowBox[{"lp", ",", "lq"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9947857527162952`*^9, 3.9947857527162952`*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"ace78aba-32b1-2245-b0ff-e08b336fb6cb"],

