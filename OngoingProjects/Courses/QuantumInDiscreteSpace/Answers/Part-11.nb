 CellLabel->
  "Out[118]=",ExpressionUUID->"2b6090f6-043d-c649-bff8-8fbda9bbccd1"]
}, Open  ]],

Cell["\<\
It is nevertheless entangled, try to solve for a normalized product vector \
orthogonal to all five tiles:\
\>", "Text",
 CellChangeTimes->{{3.994787769682247*^9, 3.9947877909605293`*^9}, {
  3.9947879298068714`*^9, 
  3.99478793347266*^9}},ExpressionUUID->"1b0e4d90-7669-be44-9cde-\
8f5d4455f730"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"tiles", ".", 
        RowBox[{"Flatten", "[", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"\[FormalA]", ",", "#"}], "]"}], "&"}], ",", "3"}], 
            "]"}], ",", 
           RowBox[{"Array", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"\[FormalB]", ",", "#"}], "]"}], "&"}], ",", "3"}], 
            "]"}]}], "]"}], "]"}]}], "==", "0"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", ".", "#"}], "==", "1"}], "&"}], "@", 
        RowBox[{"Array", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\[FormalA]", ",", "#"}], "]"}], "&"}], ",", "3"}], 
         "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", ".", "#"}], "==", "1"}], "&"}], "@", 
        RowBox[{"Array", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\[FormalB]", ",", "#"}], "]"}], "&"}], ",", "3"}], 
         "]"}]}]}], "}"}]}], "]"}], ",", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\[FormalA]", ",", "#"}], "]"}], "&"}], ",", "3"}], "]"}], ",", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\[FormalB]", ",", "#"}], "]"}], "&"}], ",", "3"}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9947876439747047`*^9, 3.9947876449118423`*^9}},
 CellLabel->
  "In[119]:=",ExpressionUUID->"65497673-a434-7c46-a9fe-1755f6b5df9f"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",
 CellChangeTimes->{3.994787645531494*^9, 3.994848271325304*^9},
 CellLabel->
  "Out[119]=",ExpressionUUID->"bba03b2a-b4ba-394a-8032-3f9504ad7f04"]
}, Open  ]],

Cell["\<\
An independent numerical certificate is the realignment (computable \
cross-norm) criterion: reshape the density matrix by exchanging its two \
middle legs, then the singular values sum to more than one only for entangled \
states:\
\>", "Text",
 CellChangeTimes->{{3.9947878392718143`*^9, 
  3.994787841336828*^9}},ExpressionUUID->"653bbc13-0cad-0245-9ee9-\
3515bd41f86e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{"Total", "@", 
    RowBox[{"SingularValueList", "@", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{"ArrayReshape", "[", 
          RowBox[{"rho", ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "3", ",", "3", ",", "3"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3", ",", "2", ",", "4"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"9", ",", "9"}], "}"}]}], "]"}]}]}], "-", "1"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.994787656887062*^9, 3.994787657304867*^9}},
 CellLabel->
  "In[120]:=",ExpressionUUID->"234aae87-0f72-d944-ba2b-9f1727585931"],

