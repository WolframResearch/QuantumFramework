        RowBox[{"\[FormalD]", " ", 
         RowBox[{"Conjugate", "[", "\[FormalD]", "]"}]}], "-", 
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[FormalA]", " ", 
              RowBox[{"Conjugate", "[", "\[FormalA]", "]"}]}], "+", 
             RowBox[{"\[FormalB]", " ", 
              RowBox[{"Conjugate", "[", "\[FormalB]", "]"}]}], "+", 
             RowBox[{"\[FormalC]", " ", 
              RowBox[{"Conjugate", "[", "\[FormalC]", "]"}]}], "+", 
             RowBox[{"\[FormalD]", " ", 
              RowBox[{"Conjugate", "[", "\[FormalD]", "]"}]}]}], ")"}], "2"], 
          "-", 
          RowBox[{"4", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[FormalB]", " ", "\[FormalC]"}], "-", 
             RowBox[{"\[FormalA]", " ", "\[FormalD]"}]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Conjugate", "[", "\[FormalB]", "]"}], " ", 
              RowBox[{"Conjugate", "[", "\[FormalC]", "]"}]}], "-", 
             RowBox[{
              RowBox[{"Conjugate", "[", "\[FormalA]", "]"}], " ", 
              RowBox[{"Conjugate", "[", "\[FormalD]", "]"}]}]}], ")"}]}]}]]}],
        ")"}]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", 
     SqrtBox["2"]], 
    RowBox[{"(", 
     RowBox[{"\[Sqrt]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[FormalA]", " ", 
         RowBox[{"Conjugate", "[", "\[FormalA]", "]"}]}], "+", 
        RowBox[{"\[FormalB]", " ", 
         RowBox[{"Conjugate", "[", "\[FormalB]", "]"}]}], "+", 
        RowBox[{"\[FormalC]", " ", 
