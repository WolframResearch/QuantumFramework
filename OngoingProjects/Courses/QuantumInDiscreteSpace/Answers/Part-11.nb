Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", "=", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Tr", "[", "sym", "]"}], ",", 
       RowBox[{"Tr", "[", "anti", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"d", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"d", "+", "1"}], ")"}], "/", "2"}]}], ",", 
       RowBox[{"d", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"d", "-", "1"}], ")"}], "/", "2"}]}]}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
