  RowBox[{"ArrayReshape", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[FormalA]", ",", "\[FormalB]", ",", "\[FormalC]", ",", "\[FormalD]"}], 
     "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}]], "Input",
