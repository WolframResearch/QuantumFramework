     RowBox[{"Subscript", "[", 
      RowBox[{"\[FormalR]", ",", "##"}], "]"}], "&"}], ",", 
    RowBox[{"{", 
     RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}]], "Input",
