Cell["\<\
Now apply an invertible but non-unitary local map, one factor per qubit, and \
renormalize. This moves inside the SLOCC class while leaving the unitary \
orbit:\
\>", "Text",
 CellChangeTimes->{{3.9947873593761826`*^9, 
  3.9947873609505177`*^9}},ExpressionUUID->"ee2c1c31-c3ff-ec4a-81d2-\
486fc1e881c8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"slocc", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Normalize", "[", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], "]"}], ".", "#"}], 
      "]"}], "&"}], "/@", "states"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9947870280128136`*^9, 3.994787028659235*^9}},
 CellLabel->
  "In[109]:=",ExpressionUUID->"a2d0cae2-4b91-cf4c-8e0a-9374c132b7cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"4", " ", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"c", "=", 
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{"Det", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "+", 
               RowBox[{"\[FormalX]", " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ",", "\[FormalX]",
              ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], "-", 
          RowBox[{"4", " ", 
           RowBox[{"c", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", 
           RowBox[{"c", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}]}]}], "]"}], "&"}], "@", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{"#", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], "]"}]}], "]"}]}], "&"}], 
  "/@", "slocc"}]], "Input",
 CellChangeTimes->{{3.9947870357806625`*^9, 3.994787036679741*^9}},
 CellLabel->
  "In[110]:=",ExpressionUUID->"d6b52aa4-9357-cd45-b9d5-a08aab8dd0ec"],

