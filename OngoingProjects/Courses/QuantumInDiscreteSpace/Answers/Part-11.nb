Cell[CellGroupData[{

Cell["\<\
11.2 [BSc] How do I measure a Bell pair jointly and exhibit the perfect \
correlations?\
\>", "Subsection",
 CellChangeTimes->{
  3.9947661344138317`*^9},ExpressionUUID->"c162cf24-932c-7548-868e-\
9ff3139bb6d1"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.994774136872265*^9, 
  3.994774140234869*^9}},ExpressionUUID->"8bd661c6-9223-6345-bf58-\
cbbfa0effe48"],

Cell["Define the PhiPlus state:", "Text",
 CellChangeTimes->{{3.9947744569275627`*^9, 
  3.994774462985916*^9}},ExpressionUUID->"11a7017c-a43a-ee4b-8f36-\
18542f612f71"],

Cell[BoxData[
 RowBox[{
  RowBox[{"phiPlus", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"zero", "=", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], ",", 
       RowBox[{"one", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}]}], "}"}], ",", 
     RowBox[{"Normalize", "@", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"zero", ",", "zero"}], "]"}], "+", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"one", ",", "one"}], "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.994769177262514*^9, 3.9947691853785496`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"bcc12718-fb6c-2b44-b058-af365c345263"],

Cell["Joint Born probabilities:", "Text",
 CellChangeTimes->{{3.994774471854395*^9, 
  3.994774478674343*^9}},ExpressionUUID->"dc03bf73-9c2b-f74a-ba5c-\
223c211053f3"],

