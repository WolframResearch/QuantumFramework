Cell[BoxData[
 SuperscriptBox[
  RowBox[{"Abs", "[", "phiPlus", "]"}], "2"]], "Input",
 CellChangeTimes->{{3.9947692062418976`*^9, 3.9947692062418976`*^9}, 
   3.9947743761618023`*^9},
 CellLabel->"In[16]:=",ExpressionUUID->"6fab6dda-5713-944f-a5e1-a5588d174e87"],

