 CellChangeTimes->{3.994769207116974*^9, 3.9947743784915543`*^9, 
  3.9948477369634304`*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"3f1ad690-1bd7-0043-abe6-4a7af868ef21"]
}, Open  ]],

Cell["\<\
Each qubit on its own is unbiased, summing the joint distribution over the \
second label leaves the marginal of the first:\
\>", "Text",
 CellChangeTimes->{{3.99477443889324*^9, 
  3.9947744497034645`*^9}},ExpressionUUID->"9cf32b89-9d1d-9349-848d-\
472bd1fd7dda"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{"Partition", "[", 
   RowBox[{
