Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tau3QF", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"QuantumEntanglementMonotone", "[", 
        RowBox[{"#1", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", "1", "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}]}], "}"}], 
         ",", "\"\<Concurrence\>\""}], "]"}], "2"], "-", 
      RowBox[{"Total", "[", 
       SuperscriptBox[
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"QuantumEntanglementMonotone", "[", 
           RowBox[{
            RowBox[{"QuantumPartialTrace", "[", 
             RowBox[{"#1", ",", 
              RowBox[{"{", "k", "}"}]}], "]"}], ",", "\"\<Concurrence\>\""}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"{", 
             RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}], "2"], "]"}]}], 
     "&"}], ")"}], "/@", "qstates"}]}]], "Input",
 CellChangeTimes->{{3.994787058660902*^9, 3.9947870603391304`*^9}, 
   3.9948482544808064`*^9},
 CellLabel->
  "In[112]:=",ExpressionUUID->"1b0c1aab-8156-f94a-9eab-6e6c7bc405d6"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"W\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"GHZ\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.994787062070181*^9, 3.9948482564044075`*^9},
 CellLabel->
  "Out[112]=",ExpressionUUID->"3662cd07-8115-194d-9002-9c271b7d2aca"]
}, Open  ]],

