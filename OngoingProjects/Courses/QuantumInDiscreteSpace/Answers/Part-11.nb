Cell[TextData[{
 "A general single-qubit unitary is the  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Z", " ", "Y", " ", "Z"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c066b0ac-f9fd-c04e-93e9-c085afbf5b5a"],
 " Euler product, with three free angles:"
}], "Text",
 CellChangeTimes->{{3.9947780748175774`*^9, 
  3.994778115638176*^9}},ExpressionUUID->"04054b4b-f294-3c44-8b27-\
3c60b32c1622"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"u", "=", 
  RowBox[{
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", "\[Phi]", " ", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}]}], "]"}], ".", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", "\[Theta]", " ", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "2", "]"}], "/", "2"}]}], "]"}], ".", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", "\[Lambda]", " ", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9947779562476463`*^9, 3.9947779692179527`*^9}},
 CellLabel->
  "In[102]:=",ExpressionUUID->"d29f83c6-4ef1-374e-8cff-6de84303e6a7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[ImaginaryI]", " ", "\[Lambda]"}], "2"]}], "-", 
        FractionBox[
         RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}], "2"]}]], " ", 
      RowBox[{"Cos", "[", 
       FractionBox["\[Theta]", "2"], "]"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         FractionBox[
          RowBox[{"\[ImaginaryI]", " ", "\[Lambda]"}], "2"], "-", 
         FractionBox[
          RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}], "2"]}]]}], " ", 
      RowBox[{"Sin", "[", 
       FractionBox["\[Theta]", "2"], "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[ImaginaryI]", " ", "\[Lambda]"}], "2"]}], "+", 
        FractionBox[
         RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}], "2"]}]], " ", 
      RowBox[{"Sin", "[", 
       FractionBox["\[Theta]", "2"], "]"}]}], ",", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        FractionBox[
         RowBox[{"\[ImaginaryI]", " ", "\[Lambda]"}], "2"], "+", 
        FractionBox[
         RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}], "2"]}]], " ", 
      RowBox[{"Cos", "[", 
       FractionBox["\[Theta]", "2"], "]"}]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9947779705179863`*^9, 3.994778118338209*^9, 
  3.994778815115143*^9, 3.9947793421847897`*^9, 3.9948478403555946`*^9, 
  3.9957304027965317`*^9},
 CellLabel->
  "Out[102]=",ExpressionUUID->"64fee169-96b0-a847-ab1e-436f69c7c974"]
}, Open  ]],

Cell[TextData[{
 "Act with it on qubit  ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d3a1fc34-fb75-9047-90dc-2b3ee2299bfa"],
 " only and reduce again, compare it with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "A"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a649acd8-ef04-ea44-b956-4f19c5019fd0"],
 ":"
}], "Text",
 CellChangeTimes->{{3.994778020245428*^9, 3.994778031586237*^9}, {
  3.994778408437084*^9, 
  3.9947784153927975`*^9}},ExpressionUUID->"90c7a69c-131f-3b4e-b024-\
140f18a3315d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"TensorContract", "[", 
     RowBox[{
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", "u"}], "]"}], ".", 
         "r", ".", 
         RowBox[{"ConjugateTranspose", "[", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", "u"}], "]"}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}], "\[Equal]", "rhoA"}], 
   ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", "\[Phi]", ",", "\[Lambda]"}], "}"}], "\[Element]", 
    TemplateBox[{},
     "Reals"]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.994778004301178*^9, 3.9947780112053375`*^9}, 
   3.9957304056755486`*^9},
 CellLabel->
  "In[103]:=",ExpressionUUID->"016ec1ac-5d64-e247-975c-86bd836c8096"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.9947780074402065`*^9, 3.99477804007794*^9}, 
   3.9947788172376156`*^9, 3.9947793448779488`*^9, 3.9948478425364*^9, 
   3.9957304075580845`*^9},
 CellLabel->
  "Out[103]=",ExpressionUUID->"67c0d741-a444-e240-8e12-6124806a646b"]
}, Open  ]],

Cell[TextData[{
 "Now let Bob measure along an arbitrary axis, using the two projectors (",
 Cell[BoxData[
  FormBox[
   RowBox[{"I", "\[PlusMinus]", " ", 
    RowBox[{
     OverscriptBox["n", "^"], " ", ".", " ", 
     OverscriptBox["\[Sigma]", "\[RightVector]"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e5a9d678-e272-6e4c-8e4d-3f30546be1b3"],
 ") and reduce the mixture:"
}], "Text",
 CellChangeTimes->{{3.9947782029810734`*^9, 3.994778208632412*^9}, {
  3.9947782925795097`*^9, 
  3.9947783568450623`*^9}},ExpressionUUID->"8ab3d711-470f-8a41-958a-\
90da5413647a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lueders", "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", "proj"}], "]"}], ".", 
      "r", ".", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", "proj"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"proj", ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
            RowBox[{"#", " ", 
             RowBox[{
              RowBox[{"FromSphericalCoordinates", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "\[Theta]1", ",", "\[Phi]1"}], "}"}], "]"}],
               ".", 
              RowBox[{"PauliMatrix", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}]}], ")"}], 
          "/", "2"}], "&"}], "/@", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.99477814040217*^9, 3.9947781504495792`*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"c03e402c-9fc7-af40-828d-68ec80aac55c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"TensorContract", "[", 
     RowBox[{
      RowBox[{"ArrayReshape", "[", 
       RowBox[{"lueders", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}], "==", "rhoA"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Theta]1", ",", "\[Phi]1"}], "}"}], "\[Element]", "Reals"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9947781568499527`*^9, 3.9947781575381775`*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"a3b96ec7-cf37-9c49-bf16-8bddbff07a6d"],

