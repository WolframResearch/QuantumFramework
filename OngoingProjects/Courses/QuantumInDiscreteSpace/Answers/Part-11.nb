     RowBox[{"sym", ".", "#"}], ",", 
     RowBox[{"anti", ".", "#"}]}], "}"}], "&"}], "@", 
  RowBox[{"Flatten", "@", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"UnitVector", "[", 
      RowBox[{"3", ",", "1"}], "]"}], ",", 
     RowBox[{"UnitVector", "[", 
      RowBox[{"3", ",", "2"}], "]"}]}], "]"}]}]}]], "Input",
