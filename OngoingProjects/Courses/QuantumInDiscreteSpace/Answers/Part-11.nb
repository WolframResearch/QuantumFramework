         SparseArray[
          Automatic, {2}, 0, {
           1, {{0, 2}, {{1}, {
             2}}}, {(3^Rational[-1, 2] + 
              Rational[1, 2] 3^Rational[-1, 2] (1 + 5^Rational[1, 2])) (
               Rational[1, 12] (1 + 5^Rational[1, 2])^2 + (3^Rational[-1, 2] + 
                 Rational[1, 2] 3^Rational[-1, 2] (1 + 5^Rational[1, 2]))^2)^
              Rational[-1, 2], 
             Rational[1, 2] (1 + 
              5^Rational[1, 2]) (
               3 (Rational[1, 12] (1 + 5^Rational[1, 2])^2 + (
