 CellLabel->"Out[26]=",ExpressionUUID->"7ff7973c-f7a7-2e4f-9245-78775eafb7ce"]
}, Open  ]],

Cell["\<\
The determinant sits under the inner square root, so the smaller coefficient \
vanishes exactly when the determinant does. The Schmidt rank is therefore the \
rank of the coefficient matrix:\
\>", "Text",
 CellChangeTimes->{{3.9947754472266407`*^9, 
  3.9947754578742313`*^9}},ExpressionUUID->"d860c157-f0cb-0a41-b0e9-\
c2c4dc74db66"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"MatrixRank", "[", "c", "]"}], ",", 
   RowBox[{"Det", "[", "c", "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.9947748909090595`*^9, 3.994774892065256*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"9ed41ce4-5f39-fb4e-9c0a-c20d6a51f90e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[FormalB]"}], " ", "\[FormalC]"}], "+", 
    RowBox[{"\[FormalA]", " ", "\[FormalD]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.994774894585697*^9, 3.994847773093979*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"63d51082-58a7-9349-903b-a62116ceae69"]
}, Open  ]],

Cell["\<\
Imposing a vanishing determinant collapses the rank to one, the product case:\
\>", "Text",
 CellChangeTimes->{{3.994775520192747*^9, 
  3.9947755214184647`*^9}},ExpressionUUID->"861e4814-e335-cd41-8e09-\
b41b1b2fe07a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixRank", "[", 
  RowBox[{"c", "/.", " ", 
   RowBox[{"\[FormalD]", "->", 
    RowBox[{"\[FormalB]", " ", 
     RowBox[{"\[FormalC]", "/", "\[FormalA]"}]}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9947749089559536`*^9, 3.9947749089559536`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"aead334d-c723-1c4d-ad79-aadbda56b443"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.9947749097425766`*^9, 3.9948477745762577`*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"89031382-7eaf-1246-bb34-6c8a56250a02"]
}, Open  ]],

Cell["\<\
For a worked instance take the state whose three terms are |00\
\[RightAngleBracket], |01\[RightAngleBracket] and |10\[RightAngleBracket] ; \
whose two Schmidt coefficients come out unequal:\
\>", "Text",
 CellChangeTimes->{{3.9947755354114265`*^9, 
  3.994775576130169*^9}},ExpressionUUID->"1fa78bcc-5212-3f40-a59b-\
c10ad79dc8f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"psi", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"zero", "=", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], ",", 
      RowBox[{"one", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}]}], "}"}], ",", 
    RowBox[{"Normalize", "@", 
     RowBox[{"Total", "[", 
      RowBox[{"Flatten", "/@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"zero", ",", "zero"}], "]"}], ",", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"zero", ",", "one"}], "]"}], ",", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"one", ",", "zero"}], "]"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9947749182359734`*^9, 3.994774928713072*^9}, 
   3.9947755878106155`*^9},
 CellLabel->"In[29]:=",ExpressionUUID->"604581f4-c9a8-4042-9ac5-7a97220deb20"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", 
    SqrtBox["3"]], ",", 
   FractionBox["1", 
    SqrtBox["3"]], ",", 
   FractionBox["1", 
    SqrtBox["3"]], ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.9947755883804836`*^9, 3.9948477776832714`*^9},
 CellLabel->"Out[29]=",ExpressionUUID->"2990334b-789d-aa48-ba60-af3fc9057fc6"]
}, Open  ]],

