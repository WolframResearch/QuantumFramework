Cell["\<\
 The tangle across a cut is the square of the concurrence for that \
bipartition, which the framework computes when the bipartition is given \
explicitly:\
\>", "Text",
 CellChangeTimes->{{3.9947866504866066`*^9, 
  3.9947866558363495`*^9}},ExpressionUUID->"9a3337da-95fd-f04c-9207-\
d7a19746891e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tangleQF", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"QuantumEntanglementMonotone", "[", 
       RowBox[{"#1", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "1", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "}"}], 
        ",", "\"\<Concurrence\>\""}], "]"}], "2"], "&"}], ")"}], "/@", 
   "qstates"}]}]], "Input",
 CellChangeTimes->{{3.994786493399311*^9, 3.9947865027680073`*^9}},
 CellLabel->
  "In[104]:=",ExpressionUUID->"d2bcc44f-bb2c-fb40-ae5a-7defc8b40ddc"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"W\"\>", "\[Rule]", 
    FractionBox["8", "9"]}], ",", 
   RowBox[{"\<\"GHZ\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{{3.9947864945938168`*^9, 3.9947865037718277`*^9}, 
   3.994786659511614*^9, 3.9948482344682083`*^9},
 CellLabel->
  "Out[104]=",ExpressionUUID->"1287cf08-d4d3-5f45-8e6e-6a1e817a15be"]
}, Open  ]],

Cell["\<\
The pairwise concurrences are the same monotone on the traced-down two-qubit \
states:\
\>", "Text",
 CellChangeTimes->{{3.994786667246668*^9, 
  3.994786668187193*^9}},ExpressionUUID->"6e8b108e-004c-9144-8c66-\
584d99e267ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"concQF", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"QuantumEntanglementMonotone", "[", 
       RowBox[{
        RowBox[{"QuantumPartialTrace", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", "k", "}"}]}], "]"}], ",", "\"\<Concurrence\>\""}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}], "&"}], "/@", 
   "qstates"}]}]], "Input",
 CellChangeTimes->{{3.99478650906209*^9, 3.9947865095446224`*^9}},
 CellLabel->
  "In[105]:=",ExpressionUUID->"bc6e307e-6a60-8945-af57-2c5aa8f09afd"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"W\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["2", "3"], ",", 
      FractionBox["2", "3"]}], "}"}]}], ",", 
   RowBox[{"\<\"GHZ\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.994786510404793*^9, 3.9948482371052876`*^9},
 CellLabel->
  "Out[105]=",ExpressionUUID->"f5833004-4451-6349-887c-370e03ac0a2b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"tangleQF", "==", "tangle"}], ",", 
   RowBox[{"concQF", "==", "concurrences"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.9947865202444267`*^9, 3.9947865202444267`*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"115e5e9a-ea50-7c4c-91fe-c3af78021d46"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.9947865209723225`*^9, 3.994848238106802*^9},
 CellLabel->
  "Out[106]=",ExpressionUUID->"c6b1e016-3e94-0d4c-9dac-5178bc02ca0e"]
}, Open  ]],

Cell["\<\
For the W state the tangle is  8/9 and both pairwise concurrences are  2/3, \
so the two squares add to exactly 8/9: the inequality is saturated, and W \
distributes all of qubit A\[CloseCurlyQuote]s entanglement into pairwise \
sharing. For GHZ the tangle is  1 while both pairwise concurrences vanish, so \
the slack is a full 1: every pair of GHZ qubits is separable once the third \
is traced out, and all the entanglement is irreducibly three-way.\
\>", "Text",
 CellChangeTimes->{{3.994786700089628*^9, 
  3.9947867494305935`*^9}},ExpressionUUID->"ed29b94a-821b-8c44-93a9-\
206d262d01bf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
11.11 [MSc] How do I distinguish the GHZ and W classes of tripartite \
entanglement under SLOCC?\
\>", "Subsection",
 CellChangeTimes->{
  3.994786780210499*^9},ExpressionUUID->"4971b0e5-f7e8-9f45-ba2c-\
59dddd6209c1"],

Cell[TextData[{
 "Three qubits have two inequivalent kinds of genuine entanglement, and the \
residual of the monogamy inequality separates them: the three-tangle is \
positive on the GHZ class and zero on the W class. It equals four times the \
modulus of Cayley\[CloseCurlyQuote]s hyperdeterminant of the amplitude \
tensor, and for a \n2\[Times]2\[Times]2 tensor that hyperdeterminant has a \
short form: writing the tensor as two square slices ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8c122037-43e7-b146-8cc5-3f6f73f50929"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b9081469-f4e9-5c4a-a187-dd267009f6ef"],
 ", can be computed as discriminant in ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4e854d67-c6a5-d545-b811-fc3deea3ead1"],
 " of the quadratic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"det", "(", 
    RowBox[{
     SubscriptBox["M", "0"], "+", 
     RowBox[{"x", " ", 
      SubscriptBox["M", "1"]}]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6219c36d-229d-774c-925b-1f893d18a6a2"],
 ". Being a degree-four invariant, it can only be rescaled by an invertible \
local map, so its vanishing is a property of the whole SLOCC class."
}], "Text",
 CellChangeTimes->{{3.994786861108921*^9, 3.9947868784468822`*^9}, {
  3.9947871246284637`*^9, 
  3.994787288134289*^9}},ExpressionUUID->"a634abab-487e-d640-8269-\
1d67f6050ce5"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.994787295840481*^9, 
  3.9947872987532597`*^9}},ExpressionUUID->"7d405c54-9262-7a41-a658-\
87c75aefd2c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"states", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"zero", "=", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], ",", 
      RowBox[{"one", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}]}], "}"}], ",", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<W\>\"", "->", 
       RowBox[{"Normalize", "@", 
        RowBox[{"Total", "[", 
         RowBox[{"Flatten", "/@", 
          RowBox[{"(", 
           RowBox[{"KroneckerProduct", "@@@", 
            RowBox[{"Permutations", "[", 
             RowBox[{"{", 
              RowBox[{"zero", ",", "zero", ",", "one"}], "}"}], "]"}]}], 
           ")"}]}], "]"}]}]}], ",", 
      RowBox[{"\"\<GHZ\>\"", "->", 
       RowBox[{"Normalize", "@", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"zero", ",", "zero", ",", "zero"}], "]"}], "+", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"one", ",", "one", ",", "one"}], "]"}]}], "]"}]}]}]}], 
     "|>"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9947870058926964`*^9, 3.9947870067860966`*^9}},
 CellLabel->
  "In[107]:=",ExpressionUUID->"b01ac118-5b00-a845-83fc-367694c5f2f2"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"W\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      FractionBox["1", 
       SqrtBox["3"]], ",", 
      FractionBox["1", 
       SqrtBox["3"]], ",", "0", ",", 
      FractionBox["1", 
       SqrtBox["3"]], ",", "0", ",", "0", ",", "0"}], "}"}]}], ",", 
   RowBox[{"\<\"GHZ\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["1", 
       SqrtBox["2"]], ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
      "0", ",", 
      FractionBox["1", 
       SqrtBox["2"]]}], "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.9947870089006023`*^9, 3.9948482416814346`*^9},
 CellLabel->
  "Out[107]=",ExpressionUUID->"0a948b68-e005-7e43-8e61-97af1a1b1b83"]
}, Open  ]],

Cell["\<\
The determinant of the slice combination is a quadratic in x, its \
discriminant is the hyperdeterminant:\
\>", "Text",
 CellChangeTimes->{{3.9947873264888363`*^9, 
  3.994787338112852*^9}},ExpressionUUID->"d235e69a-bb8d-7b45-abcc-\
9e7cbc103cb2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tau3", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"4", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"c", "=", 
            RowBox[{"Coefficient", "[", 
             RowBox[{
              RowBox[{"Det", "[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "+", 
                RowBox[{"\[FormalX]", " ", 
                 RowBox[{"#", "[", 
