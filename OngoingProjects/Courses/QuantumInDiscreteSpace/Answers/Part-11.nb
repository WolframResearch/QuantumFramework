 RowBox[{
  RowBox[{"{", 
   RowBox[{"wp", ",", "wq"}], "}"}], "==", 
  RowBox[{"{", 
   RowBox[{"lp", ",", "lq"}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9947858196405888`*^9, 3.9947858196405888`*^9}},
 CellLabel->"In[97]:=",ExpressionUUID->"041467c2-d696-584e-a715-d30933db9641"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9947858204168224`*^9, 3.99484821251713*^9},
 CellLabel->"Out[97]=",ExpressionUUID->"1326ff1f-27fb-614a-86eb-a0785f0e122f"]
}, Open  ]],

Cell["\<\
Both directions come back true then false: the partial sums 1/2,4/5,1 of the \
first state never exceed 3/5,4/5,1 of the second , so the first can be \
converted into the second with certainty, while the reverse fails at the very \
first sum, since 3/5 exceeds 1/2. The conversion is one-way. The entropies, \
about 1.485 and 1.371 bits order the same way as they must. Majorization is a \
whole chain of inequalities, and two states can be ordered by entropy while \
neither majorizes the other, in which case no certain conversion exists in \
either direction.\
\>", "Text",
 CellChangeTimes->{{3.994785937396227*^9, 
  3.9947860508169823`*^9}},ExpressionUUID->"dd26a326-6542-6047-bfba-\
e1a3b105c082"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
11.10 [MSc] How do I verify monogamy of entanglement (the CKW inequality) \
using the three-qubit tangle?\
\>", "Subsection",
 CellChangeTimes->{
  3.994786069113983*^9},ExpressionUUID->"3b9f6f0a-4acf-064b-9c02-\
898dc89c2646"],

Cell[TextData[{
 "Entanglement cannot be freely shared, if ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "006114a0-af89-a341-be11-eb881990bc63"],
 " is strongly entangled with ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "db6ad6e5-1bb2-4e45-922b-a717fd073c42"],
 " it has little left for ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "75bb241a-4ccd-a94b-bebf-f4008c61a61e"],
 ". The Coffman-Kundu-Wootters inequality makes this quantitative. The tangle \
across the ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6b111f33-61e0-4843-9669-5cc4238675a6"],
 " versus ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", " ", "C", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ccc11f12-65de-4545-a324-6d63767a8d9a"],
 " cut is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Tau]", 
     RowBox[{"A", " ", "|", 
      RowBox[{"B", " ", "C"}]}]], "=", 
    RowBox[{"4", 
     RowBox[{"det", "(", 
      SubscriptBox["\[Rho]", "a"], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "72e18745-3e73-e147-af6d-9defdf99feaf"],
 " which for a qubit is the same as 2(1 - Tr ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Rho]", "a", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d9b1d6d7-57da-e649-8e46-c2a497b4318f"],
 ") and it is at least the sum of the squared Wootters concurrences of the \
two pairs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["C", "AB", "2"], "+", 
    SubsuperscriptBox["C", "AC", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9bbbd2d1-bf1b-0947-84e3-c8fadf834081"],
 " . The W and GHZ states sit at the two extremes."
}], "Text",
 CellChangeTimes->{{3.9947861156445312`*^9, 
  3.9947863073163586`*^9}},ExpressionUUID->"298799af-7910-6f44-a539-\
ee1ca96bda5d"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.994786315428652*^9, 
  3.9947863162656727`*^9}},ExpressionUUID->"b1463cf9-3dc5-fc46-b1df-\
de47e8e87d50"],

Cell["\<\
Both states at once, so the contrast is carried through every step:\
\>", "Text",
 CellChangeTimes->{{3.994786320178177*^9, 
  3.9947863283813534`*^9}},ExpressionUUID->"362c6413-6b2e-7548-947d-\
f84239f736b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"states", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"zero", "=", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], ",", 
      RowBox[{"one", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}]}], "}"}], ",", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<W\>\"", "->", 
       RowBox[{"Normalize", "@", 
        RowBox[{"Total", "[", 
         RowBox[{"Flatten", "/@", 
          RowBox[{"(", 
           RowBox[{"KroneckerProduct", "@@@", 
            RowBox[{"Permutations", "[", 
             RowBox[{"{", 
              RowBox[{"zero", ",", "zero", ",", "one"}], "}"}], "]"}]}], 
           ")"}]}], "]"}]}]}], ",", 
      RowBox[{"\"\<GHZ\>\"", "->", 
       RowBox[{"Normalize", "@", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"zero", ",", "zero", ",", "zero"}], "]"}], "+", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"one", ",", "one", ",", "one"}], "]"}]}], "]"}]}]}]}], 
     "|>"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9947863407863216`*^9, 3.9947863407863216`*^9}},
 CellLabel->"In[98]:=",ExpressionUUID->"d5e2945b-c7fe-cd42-920b-98007ff35502"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"W\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      FractionBox["1", 
       SqrtBox["3"]], ",", 
      FractionBox["1", 
       SqrtBox["3"]], ",", "0", ",", 
      FractionBox["1", 
       SqrtBox["3"]], ",", "0", ",", "0", ",", "0"}], "}"}]}], ",", 
   RowBox[{"\<\"GHZ\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["1", 
       SqrtBox["2"]], ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
      "0", ",", 
      FractionBox["1", 
       SqrtBox["2"]]}], "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.994786343400646*^9, 3.994848217636572*^9},
 CellLabel->"Out[98]=",ExpressionUUID->"d491a0db-dac7-ca40-acb0-d9a2dc2b2af4"]
}, Open  ]],

Cell["\<\
The tangle across the cut needs the single-qubit reduction, obtained by \
contracting the ket-bra leg pairs of qubits 2 and 3:\
\>", "Text",
 CellChangeTimes->{{3.9947863538640823`*^9, 
  3.994786361770996*^9}},ExpressionUUID->"aad34c72-aad3-0d4d-90ad-\
cbbb2f8760c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tangle", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"4", " ", 
     RowBox[{"Det", "@", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"TensorContract", "[", 
         RowBox[{
          RowBox[{"ArrayReshape", "[", 
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"#", ",", 
              RowBox[{"Conjugate", "[", "#", "]"}]}], "]"}], ",", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"2", ",", "6"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"2", ",", "5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"3", ",", "6"}], "}"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}]}], "&"}], "/@", 
   "states"}]}]], "Input",
 CellChangeTimes->{{3.994786368617161*^9, 3.9947863690972195`*^9}},
 CellLabel->"In[99]:=",ExpressionUUID->"75c0d678-6777-9f42-94b0-91069f787b38"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"W\"\>", "\[Rule]", 
    FractionBox["8", "9"]}], ",", 
   RowBox[{"\<\"GHZ\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.9947863697027206`*^9, 3.994848220477787*^9},
 CellLabel->"Out[99]=",ExpressionUUID->"8544c844-cf3a-cc46-90c7-6d9c49f18331"]
}, Open  ]],

Cell["\<\
The pairwise concurrences come from the two-qubit reductions: dropping qubit  \
3 leaves the pair AB, dropping qubit 2 leaves AC, and each is fed to Wootters\
\[CloseCurlyQuote] formula:\
\>", "Text",
 CellChangeTimes->{{3.9947865480036793`*^9, 
  3.9947865920247383`*^9}},ExpressionUUID->"bd02517f-f126-2847-87ba-\
173fb522a207"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"concurrences", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"r", "=", 
            RowBox[{"ArrayReshape", "[", 
             RowBox[{
              RowBox[{"TensorContract", "[", 
               RowBox[{
                RowBox[{"ArrayReshape", "[", 
                 RowBox[{
                  RowBox[{"KroneckerProduct", "[", 
                   RowBox[{"#1", ",", 
                    RowBox[{"Conjugate", "[", "#1", "]"}]}], "]"}], ",", 
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{"2", ",", "6"}], "]"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", 
                   RowBox[{"k", "+", "3"}]}], "}"}], "}"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ",", 
           RowBox[{"y", "=", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{
              RowBox[{"PauliMatrix", "[", "2", "]"}], ",", 
              RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}]}]}], "}"}], ",", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", "=", 
             RowBox[{"ReverseSort", "[", 
              SqrtBox[
               RowBox[{"Chop", "[", 
                RowBox[{"Re", "[", 
                 RowBox[{"Eigenvalues", "[", 
                  RowBox[{"r", ".", "y", ".", 
                   RowBox[{"Conjugate", "[", "r", "]"}], ".", "y"}], "]"}], 
                 "]"}], "]"}]], "]"}]}], "}"}], ",", 
           RowBox[{"Max", "[", 
            RowBox[{"0", ",", 
             RowBox[{
              RowBox[{"First", "[", "l", "]"}], "-", 
              RowBox[{"Total", "[", 
               RowBox[{"Rest", "[", "l", "]"}], "]"}]}]}], "]"}]}], "]"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}], "&"}], ")"}], "/@",
    "states"}]}]], "Input",
 CellChangeTimes->{{3.9947863853949795`*^9, 3.9947864080569897`*^9}},
 CellLabel->
  "In[100]:=",ExpressionUUID->"f5e70069-f0d6-a14f-9731-230eb19a33a2"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"W\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["2", "3"], ",", 
      FractionBox["2", "3"]}], "}"}]}], ",", 
   RowBox[{"\<\"GHZ\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.994786389479658*^9, 3.9947864452554226`*^9, 
  3.994786595326502*^9, 3.994848224195471*^9},
 CellLabel->
  "Out[100]=",ExpressionUUID->"aeb2cf3c-3d90-7749-99c1-9be1d53338a9"]
}, Open  ]],

Cell["\<\
The slack in the inequality is the tangle minus what the two pairs account \
for:\
\>", "Text",
 CellChangeTimes->{{3.9947866096851273`*^9, 
  3.9947866157352104`*^9}},ExpressionUUID->"1759d411-6a35-0546-ae1d-\
c33409a137b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"residual", "=", 
  RowBox[{"tangle", "-", 
   RowBox[{"Total", "/@", 
    SuperscriptBox["concurrences", "2"]}]}]}]], "Input",
 CellChangeTimes->{{3.9947864464037685`*^9, 3.9947864469246807`*^9}, 
   3.9948482272388134`*^9},
 CellLabel->
  "In[101]:=",ExpressionUUID->"fbca25af-1e73-be46-a8e8-f4516c17da6c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"W\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"GHZ\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.9947864473465233`*^9, 3.9948482284808407`*^9},
 CellLabel->
  "Out[101]=",ExpressionUUID->"3346786b-af7f-3a47-91c5-b6013838f613"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NonNegative", "/@", "residual"}]], "Input",
 CellChangeTimes->{{3.9947864571014996`*^9, 3.9947864575587044`*^9}},
 CellLabel->
  "In[102]:=",ExpressionUUID->"21bb9ced-6d23-5a43-b246-510913e39304"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"W\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"GHZ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.9947864579894295`*^9, 3.994848230118084*^9},
 CellLabel->
  "Out[102]=",ExpressionUUID->"49f0cefe-9cf6-ab42-91b8-c8c82b705e99"]
}, Open  ]],

