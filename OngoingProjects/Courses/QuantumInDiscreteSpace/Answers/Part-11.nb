Cell[BoxData[
 RowBox[{"tau3QF", "==", "tau3"}]], "Input",
 CellChangeTimes->{{3.994787078468172*^9, 3.994787078919016*^9}},
 CellLabel->
  "In[113]:=",ExpressionUUID->"a7337206-87b6-4c49-94bc-8b91b341c56d"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.994787079343731*^9, 3.9948482576102505`*^9},
 CellLabel->
  "Out[113]=",ExpressionUUID->"d1ebb482-5db8-b74a-81a4-5b9860384c27"]
