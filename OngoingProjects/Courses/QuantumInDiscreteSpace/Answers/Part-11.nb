     SubscriptBox["\[FormalR]", 
      RowBox[{"1", ",", "2"}]], ",", 
     SubscriptBox["\[FormalR]", 
      RowBox[{"1", ",", "3"}]], ",", 
     SubscriptBox["\[FormalR]", 
      RowBox[{"1", ",", "4"}]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[FormalR]", 
      RowBox[{"2", ",", "1"}]], ",", 
     SubscriptBox["\[FormalR]", 
      RowBox[{"2", ",", "2"}]], ",", 
     SubscriptBox["\[FormalR]", 
      RowBox[{"2", ",", "3"}]], ",", 
     SubscriptBox["\[FormalR]", 
      RowBox[{"2", ",", "4"}]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[FormalR]", 
      RowBox[{"3", ",", "1"}]], ",", 
     SubscriptBox["\[FormalR]", 
      RowBox[{"3", ",", "2"}]], ",", 
     SubscriptBox["\[FormalR]", 
      RowBox[{"3", ",", "3"}]], ",", 
     SubscriptBox["\[FormalR]", 
      RowBox[{"3", ",", "4"}]]}], "}"}], ",", 
   RowBox[{"{", 
