   3.994775329432913*^9, 3.9947753300728226`*^9}, 3.9947753665739384`*^9},
 CellLabel->"In[26]:=",ExpressionUUID->"d4ff4ea2-48a3-3241-8983-fafbe2a6320f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox["1", 
     SqrtBox["2"]], 
    RowBox[{"(", 
     RowBox[{"\[Sqrt]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[FormalA]", " ", 
         RowBox[{"Conjugate", "[", "\[FormalA]", "]"}]}], "+", 
        RowBox[{"\[FormalB]", " ", 
         RowBox[{"Conjugate", "[", "\[FormalB]", "]"}]}], "+", 
        RowBox[{"\[FormalC]", " ", 
