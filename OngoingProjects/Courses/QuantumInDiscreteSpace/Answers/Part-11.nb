               FractionBox["1", "4"], " ", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  SqrtBox["5"]}], ")"}], "2"]}]}]]]},
          {"0", "0"}
         },
         GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
         GridBoxSpacings->{"Columns" -> {
             Offset[0.27999999999999997`], {
              Offset[0.7]}, 
             Offset[0.27999999999999997`]}, "Rows" -> {
             Offset[0.2], {
              Offset[0.4]}, 
             Offset[0.2]}}], "\[NoBreak]", ")"}],
       Function[BoxForm`e$, 
        MatrixForm[
        SparseArray[
         Automatic, {2, 2}, 0, {
          1, {{0, 2, 2}, {{1}, {2}}}, {
           Rational[1, 2] (1 + 
             5^Rational[1, 2]) (1 + Rational[1, 4] (1 + 5^Rational[1, 2])^2)^
             Rational[-1, 2], (1 + Rational[1, 4] (1 + 5^Rational[1, 2])^2)^
            Rational[-1, 2]}}]]]]}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.9947750041614075`*^9, 3.994775015650074*^9}, 
   3.9947750997932644`*^9, 3.9947757292342987`*^9, {3.9947759344176216`*^9, 
   3.9947759378874626`*^9}, 3.994847798497257*^9},
 CellLabel->"Out[36]=",ExpressionUUID->"bba3952c-e169-704c-97b1-fa2ede745ec3"]
}, Open  ]],

Cell["\<\
A product input collapses to a single term, the rank-one case:\
\>", "Text",
 CellChangeTimes->{
  3.9947757582930984`*^9},ExpressionUUID->"7c1db0cb-e03b-e84a-9c57-\
e340ac27cd5a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sb2", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}], "+", 
      RowBox[{"QuantumState", "[", "\"\<10\>\"", "]"}]}], ")"}], 
    "[", "\"\<Normalize\>\"", "]"}], "[", "\"\<SchmidtBasis\>\"", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9947760170697308`*^9, 3.9947760181742744`*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"163b3112-c62d-ef49-8187-324fc04ae5c6"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   TooltipBox[
    StyleBox[
     FormBox[
      InterpretationBox[
       StyleBox[
        TemplateBox[{
          RowBox[{
            FormBox[
             SubscriptBox["\"u\"", "1"], TraditionalForm], 
            "\[InvisibleSpace]", 
            FormBox[
             SubscriptBox["\"v\"", "1"], TraditionalForm]}]},
         "Ket"],
        FontWeight->"Plain"],
       Wolfram`QuantumFramework`QuditName[{
         Subscript["u", 1], 
         Subscript["v", 1]}, "Dual" -> False]],
      TraditionalForm],
     ShowStringCharacters->False],
    TagBox[
     GridBox[{{
        TemplateBox[{"\"00\"", 
          RowBox[{"\[CircleTimes]", "2"}]}, "Superscript", SyntaxForm -> 
         SuperscriptBox]}, {
        TemplateBox[{"\"QuantumState: \"", 
          RowBox[{
            RowBox[{"{", "}"}], "\[Rule]", 
            RowBox[{"{", 
              RowBox[{"2", ",", "2"}], "}"}]}]}, "RowDefault"]}}, 
      GridBoxAlignment -> {"Columns" -> {{Center}}}, DefaultBaseStyle -> 
      "Column", 
      GridBoxItemSize -> {
       "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"]],
   Wolfram`QuantumFramework`QuantumState[
   SparseArray[Automatic, {4}, 0, {1, {{0, 1}, {{1}}}, {1}}], 
    Wolfram`QuantumFramework`QuantumBasis[<|
     "Output" -> Wolfram`QuantumFramework`QuditBasis[<|{
           Wolfram`QuantumFramework`QuditName[
            Subscript["u", 1], "Dual" -> False], 1} -> 
         SparseArray[
          Automatic, {2}, 0, {
           1, {{0, 2}, {{1}, {2}}}, {2^Rational[-1, 2], 2^Rational[-1, 2]}}], {
           Wolfram`QuantumFramework`QuditName[
            Subscript["u", 2], "Dual" -> False], 1} -> 
         SparseArray[
          Automatic, {2}, 0, {
           1, {{0, 2}, {{1}, {2}}}, {-2^Rational[-1, 2], 2^
             Rational[-1, 2]}}], {
           Wolfram`QuantumFramework`QuditName[
            Subscript["v", 1], "Dual" -> False], 2} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[
            Subscript["v", 2], "Dual" -> False], 2} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
      "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
           
           Wolfram`QuantumFramework`QuditName[\[FormalCapitalI], "Dual" -> 
            False], 1} -> 1, {
           
           Wolfram`QuantumFramework`QuditName[\[FormalCapitalI], "Dual" -> 
            False], 2} -> 1|>], "Picture" -> "Schrodinger", "Label" -> 
      Superscript["00", 
        CircleTimes[2]], "ParameterSpec" -> {}|>]]], 
  TraditionalForm]], "Output",
 CellChangeTimes->{{3.9947760041844025`*^9, 3.9947760205397415`*^9}, {
  3.9948478018556194`*^9, 3.9948478033565063`*^9}},
 CellLabel->"Out[37]=",ExpressionUUID->"0dfff3ae-f431-114c-8c1e-371f6c6cddc7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Count", "[", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"sb2", "[", "\"\<StateVector\>\"", "]"}], "]"}], ",", 
   RowBox[{"Except", "[", "0", "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9947750324682064`*^9, 3.9947750333395996`*^9}, 
   3.9947752745212955`*^9, 3.9947760004694195`*^9, {3.994776043700899*^9, 
   3.9947760591344795`*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"126d616b-0ef8-dc44-a2f3-01fcb6344c39"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{
  3.994775035679447*^9, 3.994775275851713*^9, 3.9947757647324905`*^9, {
   3.9947760482439804`*^9, 3.994776059633404*^9}, 3.994847804679165*^9},
 CellLabel->"Out[38]=",ExpressionUUID->"05de1f23-d750-9642-8786-b5b69fcf5e75"]
}, Open  ]],

Cell["\<\
Both give the coefficients and rank dropping to rank 1 on a product state. \
Reshape-plus-SVD returns bare numbers, while the framework returns the state \
itself in its Schmidt bases, so the local bases that realize the \
decomposition come along with the coefficients:\
\>", "Text",
 CellChangeTimes->{{3.994775788787718*^9, 
  3.9947758452786274`*^9}},ExpressionUUID->"4d3fb8ef-18b6-d44a-9290-\
f9f2e33c9835"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"sb", "[", "\"\<StateVector\>\"", "]"}], "]"}], ",", "0"}], 
   "]"}], "==", 
  RowBox[{"SingularValueList", "[", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{"psi", ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9947750413996696`*^9, 3.9947750418898373`*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"33f685fd-97fd-3e4c-bba4-bd8f1287018e"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9947750423960457`*^9, 3.994775313679228*^9, 
  3.994776073523779*^9, 3.9948478067309723`*^9},
 CellLabel->"Out[39]=",ExpressionUUID->"bf9dd3ef-74b5-944a-a914-ca41fa6c06c3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
11.4 [BSc] How do I quantify pure-state entanglement by the entropy of \
entanglement (the von Neumann entropy of a reduced state)?\
\>", "Subsection",
 CellChangeTimes->{{3.9947761454002075`*^9, 
  3.994776156169647*^9}},ExpressionUUID->"5ee29844-8af8-254a-af1a-\
c3396c1d8327"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9947764069996243`*^9, 
  3.994776407918127*^9}},ExpressionUUID->"c26a5cda-41a8-fa4b-b0ac-\
7e8b56506bd0"],

Cell[TextData[{
 "For a pure bipartite state the entanglement is measured by the von Neumann \
entropy of either reduced state, which in terms of the Schmidt coefficients \
is the Shannon entropy of their squares. It is zero for a product state and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["log", "2"], "d"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cedc249b-8ded-4e40-bd24-8810fc1763aa"],
 " for a maximally entangled one. Every two-qubit pure state is, up to local \
unitaries, \n",
 Cell[BoxData[
  FormBox["cos\[Theta]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b121b70a-e717-fc44-9472-b8a6f4418dd2"],
 " \[Divides]00\:27e9 + ",
 Cell[BoxData[
  FormBox["sin\[Theta]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f9706b7-210e-3b4d-8cce-7e29a6be483a"],
 "\[Divides]11\:27e9, so that one-parameter family carries the whole answer."
}], "Text",
 CellChangeTimes->{{3.9947761833381157`*^9, 
  3.9947762893125324`*^9}},ExpressionUUID->"4d7a42a1-cc54-2549-8ccc-\
f63f2e0381b8"],

Cell["Build the family of density matrices from the ket:", "Text",
 CellChangeTimes->{{3.9947772101584187`*^9, 
  3.9947772224561424`*^9}},ExpressionUUID->"10eb734f-973f-4842-834d-\
06f3510fbf13"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ket", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"zero", "=", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], ",", 
      RowBox[{"one", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"zero", ",", "zero"}], "]"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"one", ",", "one"}], "]"}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.994776331547865*^9, 3.994776331547865*^9}, 
   3.9948478121700535`*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"154eb582-26e3-1c49-9161-e3338837f3cb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", "0", ",", "0", ",", 
   RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9947763336498337`*^9, 3.994777529452656*^9, 
  3.9948478139771557`*^9, 3.994931959703142*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"ad1a4377-12b0-9744-8e68-096ee9dd9468"]
}, Open  ]],

Cell[TextData[{
 "Compute ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "A"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "72be1872-3f0c-c34c-af77-4db5f08b9f5c"],
 " the reduced density matrix, contracting the reshaped density matrix:"
}], "Text",
 CellChangeTimes->{{3.994777153005417*^9, 
  3.994777189527378*^9}},ExpressionUUID->"7ed619f4-bb6f-b348-ad8b-\
56bca883437a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rhoA", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"TensorContract", "[", 
     RowBox[{
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"ket", ",", 
          RowBox[{"Conjugate", "[", "ket", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}], ",", 
    RowBox[{"\[Theta]", "\[Element]", "Reals"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.994776341426033*^9, 3.994776341426033*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"0ab937a2-a09c-214b-b349-0b6c734efb9d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     SuperscriptBox[
      RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9947763423961487`*^9, 3.994777531447548*^9, 
  3.99484781560594*^9, 3.9949319615926075`*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"4a13ccf7-f525-7144-9204-c724af848b27"]
}, Open  ]],

Cell["\<\
Its two eigenvalues are the Schmidt weights,  feed them to the entropy sum:\
\>", "Text",
 CellChangeTimes->{{3.994777236754801*^9, 
  3.994777240833105*^9}},ExpressionUUID->"556baa11-4b88-f949-a4b4-\
550ebdb9bc18"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"s", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", " ", 
         RowBox[{"Log2", "[", "#", "]"}]}], "&"}], "/@", 
       RowBox[{"Eigenvalues", "[", "rhoA", "]"}]}], "]"}]}], ",", 
    RowBox[{"0", "<", "\[Theta]", "<", 
     RowBox[{"Pi", "/", "2"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9947763540044003`*^9, 3.9947763540044003`*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"26181fd1-b100-fb4f-bfdd-553e95b0850d"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}], "]"}], " ", 
       SuperscriptBox[
        RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], ")"}]}], 
   RowBox[{"Log", "[", "2", "]"}]]}]], "Output",
 CellChangeTimes->{3.9947763551803436`*^9, 3.994777532762596*^9, 
  3.99484781856616*^9, 3.994931963811817*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"70b90265-8ca4-3043-b97a-87b030f2e9a5"]
}, Open  ]],

Cell["\<\
Maximizing over the family locates the maximally entangled point:\
\>", "Text",
 CellChangeTimes->{{3.9947772483708878`*^9, 
  3.994777249384245*^9}},ExpressionUUID->"9ddfcee5-31bf-0f42-913a-\
389b77546cfe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "@", 
  RowBox[{"Maximize", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", ",", 
      RowBox[{"0", "<", "\[Theta]", "<", 
       RowBox[{"Pi", "/", "2"}]}]}], "}"}], ",", "\[Theta]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9947763662317886`*^9, 3.994776367353054*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"e999a5fc-3858-6646-a8fc-966d2e21ab40"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", "\[Rule]", 
     FractionBox["\[Pi]", "4"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.994776368598875*^9, 3.994777534843115*^9, 
  3.9948478208619137`*^9, 3.9949319662182293`*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"f1f1e629-c7b7-444a-8d42-9d37deebfd55"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9947772699456215`*^9, 
  3.994777272575552*^9}},ExpressionUUID->"5cd89c95-e0ba-514f-be7c-\
0d5dd74fb64d"],

Cell["\<\
Trace out qubit  and ask the reduced state for its \
\[OpenCurlyDoubleQuote]VonNeumannEntropy\[CloseCurlyDoubleQuote], which comes \
back as a Quantity in bits:\
\>", "Text",
 CellChangeTimes->{{3.994777298851391*^9, 
  3.9947773123671875`*^9}},ExpressionUUID->"ea91348c-d1c9-c94b-b3f9-\
bd4767df97d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"redA", " ", "=", " ", 
    RowBox[{"QuantumPartialTrace", "[", 
     RowBox[{
      RowBox[{"QuantumState", "[", "ket", "]"}], ",", " ", 
      RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n"}]], "Input",
 CellChangeTimes->{{3.9947773188009243`*^9, 3.994777329062971*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"212f85c1-f72c-3743-9fbf-16be26c67879"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"redA", "[", "\"\<VonNeumannEntropy\>\"", "]"}], ",", 
   RowBox[{"0", "<", "\[Theta]", "<", 
    RowBox[{"Pi", "/", "2"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.994777335832428*^9, 3.9947773363475647`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"d0543227-75c4-8b4f-a8be-6dd5d3d9e2df"],

Cell[BoxData[
 TemplateBox[{
   RowBox[{"-", 
     FractionBox[
      RowBox[{"2", " ", 
        RowBox[{"(", 
          RowBox[{
            RowBox[{
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
              RowBox[{"Log", "[", 
                RowBox[{"Cos", "[", "\[Theta]", "]"}], "]"}]}], "+", 
            RowBox[{
              RowBox[{"Log", "[", 
                RowBox[{"Sin", "[", "\[Theta]", "]"}], "]"}], " ", 
              SuperscriptBox[
               RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], ")"}]}], 
      RowBox[{"Log", "[", "2", "]"}]]}], "\"b\"", "bits", "\"Bits\""},
  "Quantity"]], "Output",
 CellChangeTimes->{3.994777336959152*^9, 3.994777539601288*^9, 
  3.9948478248119373`*^9, 3.994931970388544*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"489b6fb3-541a-3b49-a1e7-d0dcb8371284"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"redA", "[", "\"\<VonNeumannEntropy\>\"", "]"}], "==", 
    RowBox[{"Quantity", "[", 
     RowBox[{"s", ",", "\"\<Bits\>\""}], "]"}]}], ",", 
   RowBox[{"0", "<", "\[Theta]", "<", 
    RowBox[{"Pi", "/", "2"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.99477756243836*^9, 3.99477756243836*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"58caab6a-ee02-7748-8ec0-63620f8e5fea"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.994777563373535*^9, 3.994847826982687*^9, 
  3.9949319732195625`*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"7f8a70bb-4339-d144-898e-c4097da2fe8f"]
}, Open  ]],

Cell["\<\
The packaged monotone reads the same number off the state directly:\
\>", "Text",
 CellChangeTimes->{
  3.994777588019106*^9, {3.994932031542364*^9, 
   3.994932032116783*^9}},ExpressionUUID->"9e8e5031-bb92-a841-9853-\
cb4149956e9d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"entangEntrop", " ", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"QuantumEntanglementMonotone", "[", 
     RowBox[{
      RowBox[{"QuantumState", "[", "ket", "]"}], 
      ",", "\"\<EntanglementEntropy\>\""}], "]"}], ",", 
    RowBox[{"0", "<", "\[Theta]", "<", 
     RowBox[{"\[Pi]", "/", "2"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9947775988896904`*^9, 3.994777671251955*^9}, {
  3.994931980335026*^9, 3.9949320085069466`*^9}, {3.9949320533876705`*^9, 
  3.9949320575828953`*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"d409d2a9-a7a2-3a4c-ada3-d108309e82d7"],

Cell[BoxData[
 TemplateBox[{
   RowBox[{"-", 
     FractionBox[
      RowBox[{"2", " ", 
        RowBox[{"(", 
          RowBox[{
            RowBox[{
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
              RowBox[{"Log", "[", 
                RowBox[{"Cos", "[", "\[Theta]", "]"}], "]"}]}], "+", 
            RowBox[{
              RowBox[{"Log", "[", 
                RowBox[{"Sin", "[", "\[Theta]", "]"}], "]"}], " ", 
              SuperscriptBox[
               RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], ")"}]}], 
      RowBox[{"Log", "[", "2", "]"}]]}], "\"b\"", "bits", "\"Bits\""},
  "Quantity"]], "Output",
 CellChangeTimes->{{3.994777601009428*^9, 3.994777640955126*^9}, 
