Cell["The two projectors:", "Text",
 CellChangeTimes->{
  3.994855245988079*^9},ExpressionUUID->"fbce39b7-a6bb-cc4a-b0b5-\
c4ddd0643f8d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sym", ",", "anti"}], "}"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "9", "]"}], "+", 
        RowBox[{"#", " ", "swap"}]}], ")"}], "/", "2"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"-", "1"}]}], "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9948546639874268`*^9, 3.994854665414177*^9}},
 CellLabel->
  "In[149]:=",ExpressionUUID->"77f77aec-d612-044c-a727-94935f6c5699"],

Cell["\<\
They are idempotent, mutually orthogonal, and complete, which is what makes \
them a splitting of the space.\
\>", "Text",
 CellChangeTimes->{
  3.994855261480713*^9},ExpressionUUID->"75cc13ef-7bc1-3a4d-9e11-\
f8d0dcb0fa3f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"sym", ".", "sym"}], "==", "sym"}], ",", 
   RowBox[{
    RowBox[{"anti", ".", "anti"}], "==", "anti"}], ",", 
   RowBox[{
    RowBox[{"sym", ".", "anti"}], "==", 
    RowBox[{"0", " ", "anti"}]}], ",", 
   RowBox[{
    RowBox[{"sym", "+", "anti"}], "==", 
    RowBox[{"IdentityMatrix", "[", "9", "]"}]}]}], "}"}]], "Input",
 CellChangeTimes->{{3.9948546759953575`*^9, 3.9948546759953575`*^9}},
 CellLabel->
  "In[150]:=",ExpressionUUID->"893ff1e4-be87-7a40-9624-35affc1459ce"],

