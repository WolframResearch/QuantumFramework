Cell["\<\
Both give a three-tangle of 1 for GHZ and exactly 0 for W. Under the \
invertible local map the GHZ value drops to 36/5041, rescaled but still \
nonzero, while the W value stays exactly 0: no invertible local map takes one \
to the other, in either direction, so the two states head genuinely different \
classes. The hyperdeterminant and the monogamy residual are two readings of \
the same invariant, one from the amplitudes and one from the pairwise \
entanglement they leave behind.\
\>", "Text",
 CellChangeTimes->{{3.9947874327286263`*^9, 
  3.994787454597471*^9}},ExpressionUUID->"63433af1-506e-604f-8038-\
6a04831f2b75"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
11.12a [MSc] How do I construct a 3\[Times]3 PPT-entangled (bound) state?\
\>", "Subsection",
 CellChangeTimes->{{3.9947874750677547`*^9, 
  3.9947874858657856`*^9}},ExpressionUUID->"667562cc-ee42-2949-b183-\
9646be166b50"],

Cell["\<\
Beyond the smallest dimensions a positive partial transpose no longer implies \
separability: there are entangled states whose partial transpose stays \
positive, and because distillation is local and cannot turn a positive \
partial transpose negative, no amount of processing extracts a single Bell \
pair from them. They are bound entangled. The standard construction uses an \
inextensible product basis, a set of orthonormal product vectors whose \
orthogonal complement contains no product vector at all. The Tiles basis in 3\
\[Times]3 has five members, and the normalized projector onto its complement \
is bound entangled.\
\>", "Text",
 CellChangeTimes->{{3.9947874961302814`*^9, 
  3.994787519300804*^9}},ExpressionUUID->"13fccd97-4a7b-8a4d-ac5e-\
c08d3eaf2d9e"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9947882649481354`*^9, 
  3.994788266140274*^9}},ExpressionUUID->"2ec03720-3261-3642-b896-\
5eca3061cf91"],

Cell["\<\
 The five Tiles vectors, each a Kronecker product of two qutrit combinations \
built from the qutrit kets:\
\>", "Text",
 CellChangeTimes->{{3.9947875919413548`*^9, 
  3.994787598428961*^9}},ExpressionUUID->"2594934e-02b1-4445-84d1-\
76236e4c2074"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tiles", "=", 
  RowBox[{"Normalize", "/@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"KroneckerProduct", "@@", "#"}], "]"}], "&"}], "/@", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", "=", 
         RowBox[{
          RowBox[{"UnitVector", "[", 
           RowBox[{"3", ",", 
            RowBox[{"#", "+", "1"}]}], "]"}], "&"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"u", "[", "0", "]"}], ",", 
           RowBox[{
            RowBox[{"u", "[", "0", "]"}], "-", 
            RowBox[{"u", "[", "1", "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"u", "[", "2", "]"}], ",", 
           RowBox[{
            RowBox[{"u", "[", "1", "]"}], "-", 
            RowBox[{"u", "[", "2", "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "0", "]"}], "-", 
            RowBox[{"u", "[", "1", "]"}]}], ",", 
           RowBox[{"u", "[", "2", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "1", "]"}], "-", 
            RowBox[{"u", "[", "2", "]"}]}], ",", 
           RowBox[{"u", "[", "0", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "0", "]"}], "+", 
            RowBox[{"u", "[", "1", "]"}], "+", 
            RowBox[{"u", "[", "2", "]"}]}], ",", 
           RowBox[{
            RowBox[{"u", "[", "0", "]"}], "+", 
            RowBox[{"u", "[", "1", "]"}], "+", 
            RowBox[{"u", "[", "2", "]"}]}]}], "}"}]}], "}"}]}], "]"}]}], 
    ")"}]}]}]], "Input",
 CellChangeTimes->{{3.9947875581323166`*^9, 3.9947875587613316`*^9}},
 CellLabel->
  "In[114]:=",ExpressionUUID->"04ab54b1-1116-f947-b060-26f8720901fc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["2"]], ",", 
     RowBox[{"-", 
      FractionBox["1", 
       SqrtBox["2"]]}], ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",",
      "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
     FractionBox["1", 
      SqrtBox["2"]], ",", 
     RowBox[{"-", 
      FractionBox["1", 
       SqrtBox["2"]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", 
     FractionBox["1", 
      SqrtBox["2"]], ",", "0", ",", "0", ",", 
     RowBox[{"-", 
      FractionBox["1", 
       SqrtBox["2"]]}], ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", 
     FractionBox["1", 
      SqrtBox["2"]], ",", "0", ",", "0", ",", 
     RowBox[{"-", 
      FractionBox["1", 
       SqrtBox["2"]]}], ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", "3"], ",", 
     FractionBox["1", "3"], ",", 
     FractionBox["1", "3"], ",", 
     FractionBox["1", "3"], ",", 
     FractionBox["1", "3"], ",", 
     FractionBox["1", "3"], ",", 
     FractionBox["1", "3"], ",", 
     FractionBox["1", "3"], ",", 
     FractionBox["1", "3"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.994787560371578*^9, 3.9948482623537903`*^9},
 CellLabel->
  "Out[114]=",ExpressionUUID->"ef055e96-ef58-674f-a905-0c10b44d5e94"]
}, Open  ]],

Cell["\<\
They are orthonormal, so their projector has rank five and the complement has \
rank four:\
\>", "Text",
 CellChangeTimes->{{3.9947875778033733`*^9, 
  3.9947875810059433`*^9}},ExpressionUUID->"e234ed69-3c47-e541-9318-\
9f5025310584"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Outer", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"#1", ".", "#2"}], "&"}], ",", "tiles", ",", "tiles", ",", "1"}],
    "]"}], "==", 
  RowBox[{"IdentityMatrix", "[", "5", "]"}]}]], "Input",
 CellChangeTimes->{{3.9947875711626167`*^9, 3.9947875716588135`*^9}},
 CellLabel->
  "In[115]:=",ExpressionUUID->"1b5686f3-dc90-c041-b3b3-1274eae55ae9"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.994787572109724*^9, 3.9948482644990044`*^9},
 CellLabel->
  "Out[115]=",ExpressionUUID->"a8e033ad-5574-fc41-b6b6-fdb7bcfc746c"]
}, Open  ]],

Cell["\<\
Normalizing the projector onto that four-dimensional complement gives the \
candidate state:\
\>", "Text",
 CellChangeTimes->{{3.994787818286705*^9, 
  3.9947878199774437`*^9}},ExpressionUUID->"05b5ba39-d74d-8343-886a-\
83a99683683d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rho", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "9", "]"}], "-", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"#", ",", "#"}], "]"}], "&"}], "/@", "tiles"}], "]"}]}], 
     ")"}], "/", "4"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.994787610209606*^9, 3.994787615740158*^9}},
 CellLabel->
  "In[116]:=",ExpressionUUID->"05a7e1ae-97a0-6146-9e9d-6cf13154703c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Tr", "[", "rho", "]"}], ",", 
   RowBox[{"HermitianMatrixQ", "[", "rho", "]"}], ",", 
   RowBox[{"PositiveSemidefiniteMatrixQ", "[", "rho", "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.9947876277616806`*^9, 3.9947876277616806`*^9}},
 CellLabel->
  "In[117]:=",ExpressionUUID->"6d31cd51-0739-9e48-b445-c5bfa8da0b71"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.994787628921816*^9, 3.994848267779665*^9},
 CellLabel->
  "Out[117]=",ExpressionUUID->"9c7051c5-8b17-a64b-86c9-7714af02b174"]
}, Open  ]],

Cell["\<\
Its partial transpose on the second qutrit has no negative eigenvalue, so the \
criterion of 11.6 says nothing:\
\>", "Text",
 CellChangeTimes->{{3.994787804468294*^9, 
  3.9947878057075596`*^9}},ExpressionUUID->"7a24b789-6381-e645-821b-\
ad41cbe91d81"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Eigenvalues", "@", 
  RowBox[{"ArrayReshape", "[", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{
      RowBox[{"ArrayReshape", "[", 
       RowBox[{"rho", ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "3", ",", "3", ",", "3"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"9", ",", "9"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9947876357062283`*^9, 3.994787636205305*^9}},
 CellLabel->
  "In[118]:=",ExpressionUUID->"a5210795-4896-d345-be46-f8023a740c24"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", "4"], ",", 
   FractionBox["1", "4"], ",", 
   FractionBox["1", "4"], ",", 
   FractionBox["1", "4"], ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
  "}"}]], "Output",
