Cell[TextData[{
 "Both give concurrence exactly ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]],ExpressionUUID->
  "87dcdbd8-02d7-4843-84eb-7471d1906c05"],
 " linear in the Bell admixture reaching 1 on the Bell state, and negativity ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "q", "+", 
     SqrtBox[
      RowBox[{"1", "-", 
       RowBox[{"2", " ", "q"}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["q", "2"]}]}]]}], ")"}]}]],
  CellChangeTimes->{3.9947806630586376`*^9},ExpressionUUID->
  "32a724ca-4ae1-0342-b42b-336aa959cb4e"],
 " which is likewise positive for every ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "370ea31d-8f1c-8049-8c1f-00d45fe1e9bd"],
 " but smaller than concurrence reaching one half at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "3b7ae380-5970-d542-bbe9-313a648cbd10"],
 ". The two measures vanish together and order the family the same way, yet \
they are different functions: neither is a rescaling of the other, and only \
the concurrence reaches  1 on a maximally entangled state."
}], "Text",
 CellChangeTimes->{{3.9947843215072174`*^9, 3.9947844036515236`*^9}, {
  3.994848019789818*^9, 
  3.994848044645191*^9}},ExpressionUUID->"b2e7f4c9-d2b7-8f4f-8dda-\
31aba6f3eb48"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
11.8 [MSc] How do I construct an entanglement witness for a given entangled \
state?\
\>", "Subsection",
 CellChangeTimes->{{3.994784417419779*^9, 
  3.994784420686741*^9}},ExpressionUUID->"42ff3f35-51af-6642-b551-\
b346e0d0e05f"],

Cell[TextData[{
 "A witness is a Hermitian operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"W", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e06f402a-6522-a843-85ed-ce7e19519ec4"],
 "whose expectation value is nonnegative on every separable state and \
negative on the target, so one measured number certifies entanglement. When \
the partial transpose of the target has a negative eigenvalue with \
eigenvector |e\[RightAngleBracket], the choice ",
 Cell[BoxData[
  FormBox[
   RowBox[{"W", "="}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aae62774-d245-ad4c-ada2-550dd3255927"],
 "(|e\[RightAngleBracket]\[LeftAngleBracket]e|",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[")", 
    SubscriptBox["T", "B"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "766af93d-bf99-5e49-a3bd-bf22341d1c2d"],
 " works, transposing back inside the trace turns ",
 Cell[BoxData[
  FormBox["Tr", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c5281624-5ed7-2347-99b0-b6a9d46ec665"],
 "[",
 Cell[BoxData[
  FormBox["W", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6ef9908c-08a9-7f47-aca0-b6494aa1558b"],
 " \[Rho]] into \[LeftAngleBracket]e|",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Rho]", 
    SubscriptBox["T", "B"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "06db9f08-a87f-e44f-8ed9-b8674fd819ee"],
 "|e\[RightAngleBracket] which is that negative eigenvalue, while on a \
product state ",
 Cell[BoxData[
  FormBox["W", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "05985fbe-ce53-3942-90ea-efaa03b0a257"],
 " cannot go negative. Build it for the Bell state |",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "+"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "31f9ca7a-e45d-b946-a4d2-aa25285b06e7"],
 "\[RightAngleBracket]"
}], "Text",
 CellChangeTimes->{{3.9947844361658344`*^9, 
  3.994784630923456*^9}},ExpressionUUID->"b0ee73a0-f4a4-2b40-a0ad-\
f951cc58a431"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.99478463563505*^9, 
  3.994784638351467*^9}},ExpressionUUID->"36335650-d8eb-854a-87e3-\
0954dd83d4fd"],

Cell["Target state:", "Text",
 CellChangeTimes->{{3.9947846596329193`*^9, 
  3.994784661380226*^9}},ExpressionUUID->"5789861c-05bf-9247-8303-\
39da4082e9f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rho", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"zero", "=", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], ",", 
       RowBox[{"one", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"#", ",", "#"}], "]"}], "&"}], "@", 
      RowBox[{"Normalize", "@", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"zero", ",", "zero"}], "]"}], "+", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"one", ",", "one"}], "]"}]}], "]"}]}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.994784651483433*^9, 3.994784651483433*^9}},
 CellLabel->
  "In[149]:=",ExpressionUUID->"0cbd1928-2680-6d48-b493-cee6827afff7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"es", "=", 
   RowBox[{"Eigensystem", "[", 
    RowBox[{"ArrayReshape", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{
        RowBox[{"ArrayReshape", "[", 
         RowBox[{"rho", ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"4", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9947846679676437`*^9, 3.994784688566601*^9}},
 CellLabel->
  "In[150]:=",ExpressionUUID->"30ebece5-cc71-4249-9ea5-b9484960bdb3"],

Cell["Pick the eigenvector belonging to the negative eigenvalue:", "Text",
 CellChangeTimes->{{3.994784677906101*^9, 
  3.99478467936957*^9}},ExpressionUUID->"cbbbdc93-3344-3a46-bba7-\
a1862bdec403"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"e", "=", 
  RowBox[{"Normalize", "@", 
   RowBox[{"First", "@", 
    RowBox[{"Pick", "[", 
     RowBox[{
      RowBox[{"es", "[", 
       RowBox[{"[", "2", "]"}], "]"}], ",", 
      RowBox[{"Negative", "/@", 
       RowBox[{"es", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9947846844293003`*^9, 3.9947846848800087`*^9}},
 CellLabel->
  "In[151]:=",ExpressionUUID->"562b0996-ce4f-2f4f-9496-16e5c87d5fde"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"-", 
    FractionBox["1", 
     SqrtBox["2"]]}], ",", 
   FractionBox["1", 
    SqrtBox["2"]], ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.9947846853120556`*^9, 3.994848154151781*^9, 
  3.995732113062557*^9},
 CellLabel->
  "Out[151]=",ExpressionUUID->"5b757075-c91f-c341-bb3c-872b90a14da0"]
}, Open  ]],

Cell[TextData[{
 "Transposing its projector back on the ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eaf39684-2c88-e642-b65b-cf865cf9316f"],
 " factor gives the witness:"
}], "Text",
 CellChangeTimes->{{3.994784722153097*^9, 
  3.9947847310950775`*^9}},ExpressionUUID->"4b4e3b57-7dc1-3f49-beb6-\
1afe0a44977c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wit", "=", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"e", ",", 
           RowBox[{"Conjugate", "[", "e", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9947847009319305`*^9, 3.994784713460556*^9}, 
   3.9947847527476788`*^9, 3.995732117148815*^9},
 CellLabel->
  "In[152]:=",ExpressionUUID->"b6163ec4-d80d-454c-9d8d-0e9891e76541"],

Cell["On the target it returns the negative eigenvalue itself:", "Text",
 CellChangeTimes->{{3.9947847485862007`*^9, 
  3.9947847507796135`*^9}},ExpressionUUID->"5a795fbe-d45b-4549-87a9-\
c49a0d84db8c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Tr", "[", 
  RowBox[{"wit", ".", "rho"}], "]"}]], "Input",
 CellChangeTimes->{{3.9947847399990654`*^9, 3.9947847404341927`*^9}},
 CellLabel->
  "In[153]:=",ExpressionUUID->"c3957b28-d864-824a-bc22-45c57401d95e"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox["1", "2"]}]], "Output",
 CellChangeTimes->{3.9947847408368893`*^9, 3.9948481586277847`*^9, 
  3.995732121027178*^9},
 CellLabel->
  "Out[153]=",ExpressionUUID->"d9197dac-4acc-0740-8da2-931de6ea9609"]
}, Open  ]],

Cell["\<\
On a general product state, each factor carried by its own pair of Bloch \
angles, the expectation value has a closed form:\
\>", "Text",
 CellChangeTimes->{{3.9947847721649837`*^9, 
  3.9947847751238937`*^9}},ExpressionUUID->"33bf60bb-a51e-cb48-a644-\
4fb1cb5a1dcb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"expW", "=", 
  RowBox[{"FullSimplify", "@", 
   RowBox[{"ComplexExpand", "@", 
    RowBox[{"Re", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Conjugate", "[", "#", "]"}], ".", "wit", ".", "#"}], "&"}], "@", 
      RowBox[{"Flatten", "@", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"\[Theta]a", "/", "2"}], "]"}], ",", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "\[Phi]a"}], "]"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Theta]a", "/", "2"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"\[Theta]b", "/", "2"}], "]"}], ",", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "\[Phi]b"}], "]"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Theta]b", "/", "2"}], "]"}]}]}], "}"}]}], "]"}]}]}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9947847633501987`*^9, 3.994784764187727*^9}},
 CellLabel->
  "In[154]:=",ExpressionUUID->"7e6a807a-1d9f-5f4e-ae5e-6411b703a871"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "4"], " ", 
  RowBox[{"(", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Theta]a", "]"}], " ", 
     RowBox[{"Cos", "[", "\[Theta]b", "]"}]}], "-", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"\[Phi]a", "+", "\[Phi]b"}], "]"}], " ", 
     RowBox[{"Sin", "[", "\[Theta]a", "]"}], " ", 
     RowBox[{"Sin", "[", "\[Theta]b", "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.9947847654675274`*^9, 3.994848160977989*^9, 
  3.9957321234826183`*^9},
 CellLabel->
  "Out[154]=",ExpressionUUID->"49a990ef-a380-b14f-b57e-c07ebcd318f7"]
}, Open  ]],

Cell["\<\
Searching that expression for a negative value over the whole product-state \
manifold comes up empty, so no product state, and by convexity no separable \
state, is flagged:\
\>", "Text",
 CellChangeTimes->{{3.994784795722616*^9, 
  3.9947847996211815`*^9}},ExpressionUUID->"2af6d258-b721-d84b-9232-\
56d3c133d0e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"expW", "<", "0"}], "&&", 
    RowBox[{"0", "<=", "\[Theta]a", "<=", "Pi"}], "&&", 
    RowBox[{"0", "<=", "\[Theta]b", "<=", "Pi"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]a", ",", "\[Phi]a", ",", "\[Theta]b", ",", "\[Phi]b"}], 
    "}"}], ",", "Reals"}], "]"}]], "Input",
 CellChangeTimes->{{3.994784783283743*^9, 3.9947847837030067`*^9}},
 CellLabel->
  "In[155]:=",ExpressionUUID->"6cc7ac51-1ba1-7248-b7a5-6be0d92dad82"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{{3.9947847844136715`*^9, 3.994784804484028*^9}, 
   3.9948481641106453`*^9, 3.9957321252632446`*^9},
 CellLabel->
  "Out[155]=",ExpressionUUID->"813f30bc-2969-ed47-8b59-ea878f1ea8e8"]
}, Open  ]],

