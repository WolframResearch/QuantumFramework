Cell[TextData[{
 "Both give the same spectrum ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    FractionBox["q", "2"], ",", 
    FractionBox["q", "2"], ",", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "q", "-", 
       SqrtBox[
        RowBox[{"1", "+", 
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "q"}], ")"}], " ", "q"}]}]]}], ")"}]}], ",", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "q", "+", 
       SqrtBox[
        RowBox[{"1", "+", 
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "q"}], ")"}], " ", "q"}]}]]}], ")"}]}]}],
    "}"}]],
  CellChangeTimes->{{3.9947798500251484`*^9, 3.9947798838820553`*^9}, 
    3.99478007227882*^9},ExpressionUUID->
  "f966de40-6deb-ce4c-a954-f740aa0ce0ed"],
 ", whose third entry is negative for every ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", ">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6ff9605a-c50a-984d-9ad2-4b3c38130dc8"],
 " the only member of the family with a positive partial transpose is the \
separable endpoint ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3a589e29-5e8f-3a4e-a47d-fd37ed7099b9"]
}], "Text",
 CellChangeTimes->{{3.994780211062813*^9, 
  3.994780268254242*^9}},ExpressionUUID->"b74cbdd3-1ceb-4843-ac3c-\
4ebdabe1e96c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
11.7 [MSc] How do I compute the concurrence and the negativity of a mixed \
two-qubit state?\
\>", "Subsection",
 CellChangeTimes->{
  3.9947803157602615`*^9},ExpressionUUID->"d1cbd8bb-51ba-b240-ba65-\
b4a989877162"],

Cell[TextData[{
 "Both turn the criterion of 11.6 into a number. The negativity is half the \
amount by which the trace norm of the partial transpose exceeds one, that is \
the total weight of the negative part of its spectrum. The concurrence is \
Wootters\[CloseCurlyQuote] formula: with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "1"], ">=", 
    SubscriptBox["\[Lambda]", "2"], ">=", 
    SubscriptBox["\[Lambda]", "3"], ">=", 
    SubscriptBox["\[Lambda]", "4"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c8a091ed-b9b5-7e43-a86a-5fb8950a4d44"],
 " the square roots of the eigenvalues of \[Rho] times its spin flip\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Sigma]", "y"], "\[CircleTimes]", " ", 
      SubscriptBox["\[Sigma]", "y"]}], ")"}], 
    RowBox[{"\[Rho]", "\[Conjugate]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "73a321ec-11ed-b84c-852f-dfe51ca72e6e"],
 "(",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "y"], "\[CircleTimes]", " ", 
    SubscriptBox["\[Sigma]", "y"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "42443f26-67d8-e94c-bc43-2178a1787d97"],
 "),  the concurrence is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"max", "(", 
    RowBox[{"0", ",", " ", 
     RowBox[{
      SubscriptBox["\[Lambda]", "1"], "-", 
      SubscriptBox["\[Lambda]", "2"], "-", 
      SubscriptBox["\[Lambda]", "3"], "-", 
      SubscriptBox["\[Lambda]", "4"]}]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c614e8c9-1b88-ad47-a874-0a2ca6544131"],
 ". Use the same family as in 11.6."
}], "Text",
 CellChangeTimes->{
  3.994780328610979*^9, {3.9947804176000347`*^9, 
   3.994780583399912*^9}},ExpressionUUID->"3908f208-340d-054c-bcc4-\
ee1f66b37c38"],

Cell[TextData[StyleBox["WL:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.9947806036651077`*^9, 
  3.9947806052488823`*^9}},ExpressionUUID->"727e3857-f26a-ed4e-84d9-\
2b8d32fd703d"],

Cell["Define the family:", "Text",
 CellChangeTimes->{{3.9947806097943573`*^9, 
  3.994780611996687*^9}},ExpressionUUID->"86d69095-b0df-d642-becc-\
3d81fb4a10cf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rho", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"zero", "=", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], ",", 
      RowBox[{"one", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}]}], "}"}], ",", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"bell", "=", 
         RowBox[{"Normalize", "@", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"zero", ",", "zero"}], "]"}], "+", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"one", ",", "one"}], "]"}]}], "]"}]}]}], ",", 
        RowBox[{"ket01", "=", 
         RowBox[{"Flatten", "@", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"zero", ",", "one"}], "]"}]}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"q", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"bell", ",", "bell"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "q"}], ")"}], " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"ket01", ",", "ket01"}], "]"}]}]}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.994780594090597*^9, 3.9947805963932953`*^9}},
 CellLabel->"In[65]:=",ExpressionUUID->"3cd6d860-64f1-124a-8ab3-ddd0fb1a1ce2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox["q", "2"], ",", "0", ",", "0", ",", 
     FractionBox["q", "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"1", "-", "q"}], ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["q", "2"], ",", "0", ",", "0", ",", 
     FractionBox["q", "2"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9947805967717705`*^9, 3.994847900987564*^9},
 CellLabel->"Out[65]=",ExpressionUUID->"fd5a584e-f0a0-ef44-9586-1bc7f1c54f72"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"flipped", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "2", "]"}], ",", 
      RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}], ".", 
    RowBox[{"Conjugate", "[", "rho", "]"}], ".", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "2", "]"}], ",", 
      RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.994780618297861*^9, 3.994780625905569*^9}},
 CellLabel->"In[66]:=",ExpressionUUID->"e2ac8188-4a6d-d345-a4a8-674b15b5a237"],

Cell[TextData[{
 "The four ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1483afae-9b4a-a040-a686-051c28ac54d8"],
 " are the square roots of the spectrum of the product:"
}], "Text",
 CellChangeTimes->{{3.994780688109955*^9, 
  3.9947807054012775`*^9}},ExpressionUUID->"9a4a9d7f-9567-e741-b5a2-\
2e7757568355"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lambdas", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Sqrt", "@", 
      RowBox[{"Eigenvalues", "[", 
       RowBox[{"rho", ".", "flipped"}], "]"}]}], ",", 
     RowBox[{"0", "<", "q", "<", "1"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.994782632211067*^9, 3.99478263900671*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"2ca166c5-b75b-cc41-aad9-817dcdf353f9"],

Cell["Compute concurrence:", "Text",
 CellChangeTimes->{{3.9947842624066696`*^9, 
  3.994784267713978*^9}},ExpressionUUID->"fd1f5dd7-fcb3-7049-9bf8-\
3fa349b7d5e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"concurrence", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"Max", "[", 
     RowBox[{"0", ",", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"Max", "[", "lambdas", "]"}]}], "-", 
       RowBox[{"Total", "[", "lambdas", "]"}]}]}], "]"}], ",", 
    RowBox[{"0", "<", "q", "<", "1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.994782647956423*^9, 3.9947826490289745`*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"c06ada59-86b3-9245-92db-4edad56c2005"],

Cell[BoxData["q"], "Output",
 CellChangeTimes->{3.994782649641514*^9, 3.9948479081851673`*^9},
 CellLabel->"Out[68]=",ExpressionUUID->"e8779aa5-f2f7-964b-9dd6-2bc8b2fc8ee7"]
}, Open  ]],

Cell["Compute negativity:", "Text",
 CellChangeTimes->{{3.9947842733842335`*^9, 
  3.9947842760957527`*^9}},ExpressionUUID->"48cf2cc0-2a7c-0f49-b64f-\
3b0904eda905"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"negativity", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"Eigenvalues", "@", 
          RowBox[{"ArrayReshape", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{
              RowBox[{"ArrayReshape", "[", 
               RowBox[{"rho", ",", 
                RowBox[{"{", 
                 RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], 
              ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], "]"}], "]"}], "-", 
       "1"}], ")"}], "/", "2"}], ",", 
    RowBox[{"0", "<", "q", "<", "1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.994780661768036*^9, 3.994780662363062*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"dc505a22-78cb-c54f-a1e5-291b4d925b7e"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "q", "+", 
    SqrtBox[
     RowBox[{"1", "-", 
      RowBox[{"2", " ", "q"}], "+", 
      RowBox[{"2", " ", 
       SuperscriptBox["q", "2"]}]}]]}], ")"}]}]], "Output",
 CellChangeTimes->{3.9947806630586376`*^9, 3.994847911156481*^9},
 CellLabel->"Out[69]=",ExpressionUUID->"5df5132b-5601-914e-83b2-d6fc03b857b2"]
}, Open  ]],

