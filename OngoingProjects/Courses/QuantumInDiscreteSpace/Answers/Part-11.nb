Cell["\<\
Every check returns True(or 0), for an arbitrary joint state, an arbitrary \
local unitary, and an arbitrary measurement axis. Entanglement therefore \
correlates outcomes without transmitting anything: Alice sees exactly the \
same statistics whether Bob acts, measures, or does nothing, and the \
correlations only appear when the two records are later compared.\
\>", "Text",
 CellChangeTimes->{{3.994779507345312*^9, 3.9947795171181355`*^9}, {
  3.994779573120943*^9, 
  3.994779573788479*^9}},ExpressionUUID->"d7a2f866-cbf4-8b49-a5b7-\
cc267f616f05"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
11.6 [MSc] How do I test a mixed state for entanglement by the \
positive-partial-transpose (Peres-Horodecki) criterion?\
\>", "Subsection",
 CellChangeTimes->{
  3.994779642129221*^9},ExpressionUUID->"8f2361d0-8479-0d40-904f-\
5047cff39405"],

Cell[TextData[{
 "Transposing only Bob\[CloseCurlyQuote]s factor of a separable state sends \
each of its product terms to another product term, so the result is still a \
legitimate state and its spectrum stays nonnegative. A negative eigenvalue of \
the partial transpose therefore certifies entanglement. Take the family ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", "q", ")"}], "=", "q"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bd5fa54c-e11e-3d42-8ca1-52fdb4c276a2"],
 " |",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "+"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "69b877f2-3612-d146-a8cd-5bdc24e19981"],
 "\[RightAngleBracket]\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalPhi]", "+"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9c70ebc7-d6fb-d549-970c-91bcd0db8b7f"],
 "| + (",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", "q"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1ae8cbc4-ae9d-9446-8b8d-8b66cb163267"],
 ") |01\[RightAngleBracket]\[LeftAngleBracket]01| separable at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "21b7efa4-7741-664c-969c-3f873d7fca3c"],
 " and a Bell state at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0d6bceb9-c841-544d-8b23-8c5082bf5bcd"],
 "  "
}], "Text",
 CellChangeTimes->{{3.994779663389702*^9, 
  3.9947797982157288`*^9}},ExpressionUUID->"be771463-bd33-0e42-8c14-\
f557a568d7de"],

Cell[TextData[{
 Cell[BoxData[
  FormBox["WL", TraditionalForm]],
  FormatType->TraditionalForm,
  FontWeight->"Bold",ExpressionUUID->"c2894858-c4c0-814e-a6e2-acaf895942ec"],
 StyleBox[":",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.9947798044570084`*^9, 
  3.9947798085753593`*^9}},ExpressionUUID->"84b5dfd0-6e00-cc44-9978-\
1960b00abea1"],

Cell["Build the family:", "Text",
 CellChangeTimes->{{3.9947798171892967`*^9, 
  3.994779819964695*^9}},ExpressionUUID->"d4f77733-23ad-5e4d-beff-\
160ecc151e28"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rho", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"zero", "=", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], ",", 
      RowBox[{"one", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}]}], "}"}], ",", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"bell", "=", 
         RowBox[{"Normalize", "@", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"zero", ",", "zero"}], "]"}], "+", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"one", ",", "one"}], "]"}]}], "]"}]}]}], ",", 
        RowBox[{"ket01", "=", 
         RowBox[{"Flatten", "@", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"zero", ",", "one"}], "]"}]}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"q", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"bell", ",", "bell"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "q"}], ")"}], " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"ket01", ",", "ket01"}], "]"}]}]}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.994779824796732*^9, 3.9947798253347645`*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"31c32b5b-3a10-0544-8211-8817866345c7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox["q", "2"], ",", "0", ",", "0", ",", 
     FractionBox["q", "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"1", "-", "q"}], ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["q", "2"], ",", "0", ",", "0", ",", 
     FractionBox["q", "2"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9947798258845825`*^9, 3.9948478714045887`*^9},
 CellLabel->"Out[58]=",ExpressionUUID->"36be5ea0-9c56-a940-abf1-2632e008fe1a"]
}, Open  ]],

Cell[TextData[{
 "The partial transpose on ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5a761eb5-a125-0849-a901-2d1c0c39abc3"],
 "  reshapes the matrix into its four legs and exchanges the two belonging to \
",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1033df70-d061-c443-91b7-70adee63c822"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9947800236872215`*^9, 
  3.9947800645355606`*^9}},ExpressionUUID->"f63ab400-04df-2341-9442-\
43ba16e9d763"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pt", "=", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"rho", ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9947798415060005`*^9, 3.99477984202479*^9}, 
   3.994779892615265*^9},
 CellLabel->"In[59]:=",ExpressionUUID->"1de0913a-5bcb-a145-82c5-85da5afbcd93"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"eigs", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Eigenvalues", "[", "pt", "]"}], ",", 
    RowBox[{"0", "<=", "q", "<=", "1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9947798488251762`*^9, 3.994779883191084*^9}},
 CellLabel->"In[60]:=",ExpressionUUID->"1972f866-b5c3-fb4e-8525-00ec44b41224"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["q", "2"], ",", 
   FractionBox["q", "2"], ",", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", "q", "-", 
      SqrtBox[
       RowBox[{"1", "+", 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "q"}], ")"}], " ", "q"}]}]]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", "q", "+", 
      SqrtBox[
       RowBox[{"1", "+", 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "q"}], ")"}], " ", "q"}]}]]}], ")"}]}]}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.9947798500251484`*^9, 3.9947798838820553`*^9}, 
   3.99478007227882*^9, 3.994847879498314*^9},
 CellLabel->"Out[60]=",ExpressionUUID->"e6f8a1ff-649e-254e-8791-28fc2bd8830b"]
}, Open  ]],

Cell["\<\
Demanding that all four be nonnegative locates the entire \
positive-partial-transpose region of the family:\
\>", "Text",
 CellChangeTimes->{{3.994780005317169*^9, 
  3.9947800081070786`*^9}},ExpressionUUID->"6b8cf8fc-55a1-2d41-bc8c-\
5348617345fb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"And", "@@", 
     RowBox[{"Thread", "[", 
      RowBox[{"eigs", ">=", "0"}], "]"}]}], "&&", 
    RowBox[{"0", "<=", "q", "<=", "1"}]}], ",", "q", ",", "Reals"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9947799006135063`*^9, 3.9947799010536194`*^9}},
 CellLabel->"In[61]:=",ExpressionUUID->"ee3e3aae-dba4-b744-b715-94304da33ae8"],

Cell[BoxData[
 RowBox[{"q", "\[Equal]", "0"}]], "Output",
 CellChangeTimes->{3.9947799015552235`*^9, 3.994780076010908*^9, 
  3.99484788184391*^9},
 CellLabel->"Out[61]=",ExpressionUUID->"6ea95897-0388-6b41-afde-10d92b2247bf"]
}, Open  ]],

Cell[TextData[StyleBox["QF:",
 FontWeight->"Bold"]], "Text",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9947800871991997`*^9, 
  3.9947800885452824`*^9}},ExpressionUUID->"c76813fd-8978-604a-8afe-\
6d813f2195de"],

Cell["\<\
QuantumPartialTranspose transposes the listed qudits and hands back a state \
object, whose spectrum reads off directly:\
\>", "Text",
 CellChangeTimes->{{3.994780123933975*^9, 
  3.994780125520233*^9}},ExpressionUUID->"f640ecc3-2bdd-5e45-8228-\
5b414bfdd1bd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ptQF", "=", 
  RowBox[{"QuantumPartialTranspose", "[", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"rho", ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", "2", "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.994780103458153*^9, 3.9947801040801144`*^9}},
 CellLabel->"In[62]:=",ExpressionUUID->"d4620bc6-fca4-514b-b118-19cdb5bb628a"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   TooltipBox[
    StyleBox[
     RowBox[{
      RowBox[{
       FractionBox["q", "2"], 
