    RowBox[{"Normalize", "@", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"zero", ",", "zero"}], "]"}], "+", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"one", ",", "one"}], "]"}]}], "]"}]}]}], "]"}]}]], "Input",
