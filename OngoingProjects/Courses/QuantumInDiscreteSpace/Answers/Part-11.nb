Cell[TextData[{
 "The Schmidt coefficients are the singular values, that is the square roots \
of the eigenvalues of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", " ", 
    SuperscriptBox["C", "\[Dagger]"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0e2c6d0d-bf6c-e84a-a7e5-2c662c6326e5"],
 ":"
}], "Text",
 CellChangeTimes->{{3.994775423635805*^9, 
  3.994775431615919*^9}},ExpressionUUID->"19b8661f-5b48-314f-8c32-\
8a5e1383f0e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "@", 
  RowBox[{"Sqrt", "@", 
   RowBox[{"Eigenvalues", "[", 
    RowBox[{"c", ".", 
     RowBox[{"ConjugateTranspose", "[", "c", "]"}]}], "]"}]}]}]], "Input",
