Cell["Calculate the concurrence:", "Text",
 CellChangeTimes->{{3.994784231110403*^9, 3.994784247307066*^9}, {
  3.9948480015915546`*^9, 
  3.994848004943777*^9}},ExpressionUUID->"c54e9f6d-2db3-e346-9380-\
80d943bd00be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"concu", " ", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"QuantumEntanglementMonotone", "[", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"rho", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "]"}], 
      ",", "\"\<Concurrence\>\""}], "]"}], ",", 
    RowBox[{"0", "<", "q", "<", "1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9948479251211205`*^9, 3.9948479403570232`*^9}, {
  3.9948480554774036`*^9, 3.9948480569805145`*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"67b16f1e-b76b-b74c-9a1b-ae6ac31d9d99"],

