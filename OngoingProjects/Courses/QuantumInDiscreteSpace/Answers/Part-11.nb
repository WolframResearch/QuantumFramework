Cell["\<\
For the unreported measurement, build the two projectors as operators on wire \
2 and sum their action on the state:\
\>", "Text",
 CellChangeTimes->{{3.994778551275957*^9, 
  3.9947785598775864`*^9}},ExpressionUUID->"79be47cc-0902-8a45-ba26-\
daf29db56429"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lu", "=", 
   RowBox[{"Total", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"QuantumOperator", "[", 
          RowBox[{
           RowBox[{"\"\<I\>\"", "+", " ", 
            RowBox[{"s", " ", 
             RowBox[{"\"\<U3\>\"", "[", 
              RowBox[{
               RowBox[{"2", " ", "\[Theta]1"}], ",", "\[Phi]1", ",", 
               RowBox[{"\[Pi]", "-", "\[Phi]1"}]}], "]"}]}]}], ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}], "[", "qr", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.994778564391062*^9, 3.994778564391062*^9}, 
   3.9947786343085194`*^9, 3.994779361757309*^9, 3.9957313530153427`*^9, 
   3.9957317355581512`*^9, 3.9957317999600754`*^9, 3.995732000545637*^9},
