Cell[47746, 1532, 503, 12, 70, "Text",ExpressionUUID->"1227db42-8bd6-4d93-9f31-e5537a050531"],
Cell[48252, 1546, 1242, 34, 70, "Input",ExpressionUUID->"d12a3014-f25f-44de-9183-c646c1afce92"],
Cell[49497, 1582, 853, 24, 70, "Text",ExpressionUUID->"94474fd6-74dd-4e4a-9ebc-057f747bc0c4"],
Cell[50353, 1608, 800, 29, 70, "Subsection",ExpressionUUID->"536bb041-064d-4abd-81b7-0f69acf788cd"],
