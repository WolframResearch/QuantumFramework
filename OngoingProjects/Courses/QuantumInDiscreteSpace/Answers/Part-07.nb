Notebook[{
Cell["Part 7. Unitary dynamics and pictures", "Section",ExpressionUUID->"a52af26d-63ba-4dc3-8a38-17acb17587c4"],

Cell[TextData[{
 "7.1a [BSc] How do I build the time-evolution operator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     OverscriptBox[
      StyleBox["H", "TI"], "^"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "609284bb-0460-407a-bc55-ecc5e70e581d"],
 " (working in units where ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f08edef-5af5-4fd0-bb3b-84bc47bec8db"],
 ")?"
}], "Subsection",ExpressionUUID->"2be55238-cd8f-4866-9389-d84a409e9e78"],

Cell[TextData[{
 "Dynamics is generated by a Hermitian Hamiltonian ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f927c188-5ae2-4e1b-8f1e-8d0f0872ecbe"],
 ": the state at time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df0ff0e1-fbda-41a2-a474-7ac6e7bd37be"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], "0"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60ac2307-6fab-48f8-a1c9-b0042ff3fb4b"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     OverscriptBox[
      StyleBox["H", "TI"], "^"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ee72884-9147-4156-8206-ff0d0d040ee2"],
 ", the matrix exponential of ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b468f6d-0e66-4111-acf9-64d19fd7e84e"],
 ". Because ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d11971ca-30df-4a98-a9ae-a1ae80b20ecb"],
 " is Hermitian, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a51e4c93-831b-4557-9078-82e84f1bae2c"],
 " is unitary at every time, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"], 
   StyleBox["U", "TI"], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5daa5da7-d387-4534-8b8f-bfb35a8527a9"],
 ", so probability is conserved. Take the generic single-qubit Hamiltonian, a \
spin in a magnetic field along an arbitrary Bloch axis ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "=", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["\[Theta]", "TI"], 
      StyleBox["cos",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["\[Phi]", "TI"]}], ",", " ", 
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["\[Theta]", "TI"], 
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["\[Phi]", "TI"]}], ",", " ", 
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["\[Theta]", "TI"]}]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab97a79a-1551-4c5b-a79e-eb22de1c99d2"],
 ": the energy splitting ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   FractionBox[
    StyleBox["\[Omega]", "TI"], "2"], " ", 
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ca32e0d-991e-4fc4-a897-e32d649028a1"],
 ", of which a field along ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "142d4137-09f6-4e78-9304-5b1edf3ffa75"],
 " (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "115726b5-227b-425e-9f64-c0ee23831049"],
 ") is the special case ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b37a1e7-a926-4990-bbba-59102f277150"],
 "."
}], "Text",ExpressionUUID->"21440d74-a452-41e9-a6e3-ee8e13aee2f8"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the propagator is ",
 Cell[BoxData["MatrixExp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bc65ce0-2d38-4fb6-9942-ac6b2317dadb"],
 " of ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aaf3a07e-83ea-4889-a9e9-a66381faa767"],
 "."
}], "Text",ExpressionUUID->"7e6ad671-9744-4939-9dd5-0604c805d9de"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MatrixExp", "[", 
   RowBox[{
    RowBox[{"-", "I"}], " ", 
    RowBox[{"(", 
     RowBox[{"\[Omega]", "/", "2"}], ")"}], " ", 
    RowBox[{
     RowBox[{"FromSphericalCoordinates", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], "}"}], "]"}], 
     " ", ".", " ", 
     RowBox[{"PauliMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], " ", 
    "t"}], "]"}], " ", "//", " ", "FullSimplify"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b87ccc6b-0c01-4bc5-a720-ce0caccd551f"],

Cell[TextData[{
 "Unitarity is the statement ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67617a93-e3f7-46e9-a2b5-8f215ffa5b8b"],
 "; check it (declare the parameters real)."
}], "Text",ExpressionUUID->"30990003-5ae2-4713-b23c-ab119f2a3e34"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"u", " ", "=", " ", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{"(", 
        RowBox[{"\[Omega]", "/", "2"}], ")"}], " ", 
       RowBox[{
        RowBox[{"FromSphericalCoordinates", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], "}"}], 
         "]"}], " ", ".", " ", 
        RowBox[{"PauliMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], " ", 
       "t"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"u", " ", ".", " ", 
       RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], " ", "==", " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Omega]", ",", " ", "t", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], 
       "}"}], " ", "\[Element]", " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f1401709-eab3-422a-8a11-7e03b71bb3bb"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same propagator kept as a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61782643-3c23-4822-8e25-7a66ddc59e89"],
 ", an object that acts on states and composes, not a bare matrix."
}], "Text",ExpressionUUID->"1c414181-1805-4f25-930c-5942e86217b0"],

Cell[BoxData[
 RowBox[{"QuantumOperator", "[", 
  RowBox[{"MatrixExp", "[", 
   RowBox[{
    RowBox[{"-", "I"}], " ", 
    RowBox[{"(", 
     RowBox[{"\[Omega]", "/", "2"}], ")"}], " ", 
    RowBox[{
     RowBox[{"FromSphericalCoordinates", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], "}"}], "]"}], 
     " ", ".", " ", 
     RowBox[{"PauliMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], " ", 
    "t"}], "]"}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f106ec52-f802-49f9-af92-ccd17add4955"],

Cell[TextData[{
 "Its unitarity reads back at the operator level: ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"], 
   StyleBox["U", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9b85032-290a-47be-a6bb-66c737a689e2"],
 " reduces to the identity operator."
}], "Text",ExpressionUUID->"d973291d-b8b2-4219-9a4b-9d6684b61ea9"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"u", " ", "=", " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{"(", 
         RowBox[{"\[Omega]", "/", "2"}], ")"}], " ", 
        RowBox[{
         RowBox[{"FromSphericalCoordinates", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], "}"}], 
          "]"}], " ", ".", " ", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], " ", 
        "t"}], "]"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"u", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", "u"}], 
         ")"}], "[", "\"\<Matrix\>\"", "]"}], "]"}], " ", "==", " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Omega]", ",", " ", "t", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], 
       "}"}], " ", "\[Element]", " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"9e35cba8-47dd-4b35-9baa-68eb6d9a2e2b"],

Cell[TextData[{
 "Both build the same propagator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   FractionBox[
    StyleBox[
     RowBox[{"\[Omega]", "t"}], "TI"], "2"], " ", 
   StyleBox["I", "TI"], "-", 
   StyleBox["i", "TI"], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   FractionBox[
    StyleBox[
     RowBox[{"\[Omega]", "t"}], "TI"], "2"], " ", 
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60beb311-318f-4d0e-bee8-69299c06f5a6"],
 ", the rotation by angle ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\[Omega]", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c6bb7d1-f0a4-4086-8cf8-414c8826a2a3"],
 " about the axis ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6acb332f-86f4-4b4a-bfb5-d1f8c14e4a4c"],
 ", and both confirm it is unitary: the two eigenstates of ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "612ef65c-250a-4593-b6e4-3d63cfbdde56"],
 " accumulate opposite phases ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"\[MinusPlus]", 
    StyleBox["i", "TI"], 
    StyleBox["\[Omega]", "TI"], 
    StyleBox["t", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eede494a-bef4-41c1-afe0-fb731b7b91c8"],
 " set by their energies ",
 Cell[BoxData[
  RowBox[{"\[MinusPlus]", 
   FractionBox[
    StyleBox["\[Omega]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b223d33-2485-4024-9dbc-ba8a67ff9574"],
 ", which along ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40f0dd2b-b0d8-4ef0-92e2-8b7d2fc9f2d8"],
 " (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de6ec99f-13e2-4504-9809-04512cfb5c90"],
 ") collapses to the diagonal ",
 Cell[BoxData[
  RowBox[{
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[Omega]", "TI"], 
      StyleBox["t", "TI"], "/", "2"}]], ",", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"+", 
      StyleBox["i", "TI"], 
      StyleBox["\[Omega]", "TI"], 
      StyleBox["t", "TI"], "/", "2"}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c818180-8c4c-4889-a427-bf5f82868e09"],
 "."
}], "Text",ExpressionUUID->"ba7c2ee2-fff4-4f08-b62f-393e68fb3799"],

Cell[TextData[{
 "7.1b [BSc] How do I solve the Schrodinger equation for a time-independent \
Hamiltonian, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["t", "TI"], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Ket"], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      OverscriptBox[
       StyleBox["H", "TI"], "^"], 
      StyleBox["t", "TI"]}]], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], "0"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c8625a1-8255-4023-8aeb-3de5e5f893be"],
 "?"
}], "Subsection",ExpressionUUID->"ec03b4ca-fc0a-46d4-bdfb-9bdc0708c1b6"],

Cell[TextData[{
 "For a ",
 StyleBox["time-independent",
  FontWeight->"Bold"],
 " Hamiltonian ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bf36003-7053-41ae-810a-da905294d6c2"],
 " (no explicit dependence on ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2c31298-fb22-4a9a-8f11-46e0f4d88630"],
 "), the Schrodinger equation ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["i", "TI"], 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["t", "TI"]], 
     TemplateBox[{
       RowBox[{
         StyleBox["\[Psi]", "TI"], 
         StyleBox["(", SpanMaxSize -> 1], 
         StyleBox["t", "TI"], 
         StyleBox[")", SpanMaxSize -> 1]}]},
      "Ket"]}]}], "=", 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], 
    TemplateBox[{
      RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["t", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86f41119-6ef0-4ba6-a6ab-bc869f9730a6"],
 " with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(", SpanMaxSize -> 1], "0", 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Ket"], "=", 
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], "0"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a6aeeb5-7bc0-4cb6-b17a-593337535406"],
 " is solved by the constant-",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88d45437-d071-4d44-8393-b546aef5666f"],
 " propagator of 7.1a, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["t", "TI"], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Ket"], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      OverscriptBox[
       StyleBox["H", "TI"], "^"], 
      StyleBox["t", "TI"]}]], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], "0"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "750e5b1c-665b-480f-acb6-8e89037fed75"],
 "; a time-dependent ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4b1140e-9cb7-47bd-8bfa-c050e029f0e8"],
 " would instead require the time-ordered exponential. Take the generic ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   FractionBox[
    StyleBox["\[Omega]", "TI"], "2"], " ", 
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6593238a-18b8-4a4b-b3ae-58d5a47f3b7e"],
 " along the fixed axis ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "=", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["\[Theta]", "TI"], 
       StyleBox["H", "TI"]], 
      StyleBox["cos",
       FontSlant->"Plain"], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["\[Phi]", "TI"], 
       StyleBox["H", "TI"]]}], ",", " ", 
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["\[Theta]", "TI"], 
       StyleBox["H", "TI"]], 
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["\[Phi]", "TI"], 
       StyleBox["H", "TI"]]}], ",", " ", 
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["\[Theta]", "TI"], 
       StyleBox["H", "TI"]]}]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9e5f9dc-c397-4c80-a79d-737c6b350432"],
 " and a general pure initial qubit ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], "0"]},
    "Ket"], "=", "{", 
   StyleBox["cos",
    FontSlant->"Plain"], 
   FractionBox[
    StyleBox["\[Theta]", "TI"], "2"], ",", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
   StyleBox["sin",
    FontSlant->"Plain"], 
   FractionBox[
    StyleBox["\[Theta]", "TI"], "2"], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b42f3d51-bd13-492d-b3cf-2a0c2b50604d"],
 "."
}], "Text",ExpressionUUID->"cc47c4e9-e3cd-47db-a857-3e3cbd13ba11"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the solution is the propagator of 7.1a acting on ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox[
     StyleBox["\[Psi]", "TI"], "0"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "201a8bfb-76fe-4153-a853-49675bcb1d28"],
 "; ",
 Cell[BoxData["MatrixExp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0836c4ee-96de-4d70-96a5-e58720283ca4"],
 " applies ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    OverscriptBox[
     StyleBox["H", "TI"], "^"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6de4eb8-c61b-4fde-a64e-cdc08b059502"],
 " straight to the initial vector through its two-argument form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["MatrixExp",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["m", "TI"]], 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7713075f-ead4-46ed-bb0e-53f13a98dd23"],
 "."
}], "Text",ExpressionUUID->"17bd5e43-15c8-4de5-942b-ad44da1d7bdc"],

Cell[BoxData[
 RowBox[{"psit", " ", "=", " ", 
  RowBox[{
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"(", 
       RowBox[{"\[Omega]", "/", "2"}], ")"}], " ", 
      RowBox[{
       RowBox[{"FromSphericalCoordinates", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "\[Theta]H", ",", " ", "\[Phi]H"}], "}"}], 
        "]"}], " ", ".", " ", 
       RowBox[{"PauliMatrix", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], " ", 
      "t"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}]}], "]"}], " ", "//",
    " ", "FullSimplify"}]}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"4eaf9081-ba8e-43ac-833f-1510c8d8f90f"],

Cell[TextData[{
 "The same state also follows from integrating the Schrodinger ODE from \
scratch with ",
 Cell[BoxData["DSolveValue"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88c7d803-04f7-4310-9406-87901976e3cc"],
 ", taking the unknown as a 2-vector ",
 Cell[BoxData[
  RowBox[{"vec", "[", "t", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86abf30c-bdee-4fe1-83da-54c4c65bf237"],
 "."
}], "Text",ExpressionUUID->"ff170a73-afc3-4386-84b9-2201eebd909f"],

Cell[BoxData[
 RowBox[{"sch", " ", "=", " ", 
  RowBox[{
   RowBox[{"DSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"I", " ", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"vec", "[", "t", "]"}], ",", " ", "t"}], "]"}]}], " ", "==",
         " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Omega]", "/", "2"}], ")"}], " ", 
         RowBox[{
          RowBox[{"FromSphericalCoordinates", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "\[Theta]H", ",", " ", "\[Phi]H"}], "}"}], 
           "]"}], " ", ".", " ", 
          RowBox[{"PauliMatrix", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}], " ", ".",
           " ", 
          RowBox[{"vec", "[", "t", "]"}]}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"vec", "[", "0", "]"}], " ", "==", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}]}]}], "}"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"vec", "[", "t", "]"}], " ", "\[Element]", " ", 
      RowBox[{"Vectors", "[", "2", "]"}]}], ",", " ", "t"}], "]"}], " ", "//",
    " ", "FullSimplify"}]}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"a0da0a67-1ffe-4696-b05f-a1d55fef32e2"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : ",
 Cell[BoxData["QuantumEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "531dc872-be35-46d4-8f0d-a881964846c7"],
 " integrates the Schrodinger equation for the state object and returns the \
evolved ",
 Cell[BoxData["QuantumState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "403f26b6-c120-4281-a15b-a533612a1e14"],
 " as a function of ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a750f9db-333d-49c7-a617-2ae14f4fcc5a"],
 "; read its amplitudes."
}], "Text",ExpressionUUID->"d32163db-d2c5-425a-bf28-eb47a3b0c502"],

Cell[BoxData[
 RowBox[{"psitQF", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Omega]", "/", "2"}], ")"}], " ", 
         RowBox[{
          RowBox[{"FromSphericalCoordinates", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "\[Theta]H", ",", " ", "\[Phi]H"}], "}"}], 
           "]"}], " ", ".", " ", 
          RowBox[{"PauliMatrix", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
        "]"}], ",", " ", 
       RowBox[{"QuantumState", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], "]"}], ",", " ",
        "t"}], "]"}], "[", "\"\<StateVector\>\"", "]"}], " ", "//", " ", 
    "Normal"}], " ", "//", " ", "FullSimplify"}]}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"f17c268a-7b0a-4bb1-835e-cfc1473c679f"],

Cell["\<\
The direct propagator, the ODE integration, and the QF evolution are the same \
state; confirm all three agree.\
\>", "Text",ExpressionUUID->"ac39fe9f-9b5b-414b-96e1-9d207fa2907e"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"psit", " ", "==", " ", "sch", " ", "==", " ", "psitQF"}], 
  "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"d7b2283a-decc-480f-8fc7-612d68a6a7b7"],

Cell[TextData[{
 "All three return the same evolved state ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["t", "TI"], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Ket"], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      OverscriptBox[
       StyleBox["H", "TI"], "^"], 
      StyleBox["t", "TI"]}]], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], "0"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1cc27e3-e8cb-4994-98d8-204b8e0248de"],
 ", which precesses the Bloch vector of ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox[
     StyleBox["\[Psi]", "TI"], "0"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20394e66-a2ae-41da-9a47-49aa074d0470"],
 " about the field axis ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20564617-2ebc-4db5-bad6-c3b48841f463"],
 " at the Bohr frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64618641-1eaf-461a-af05-6fda0105a284"],
 ". The computational-basis populations stay frozen only when the field is \
along ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4e4f95f-4e31-45b9-b022-85aba322f9c8"],
 " (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox["H", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be073eb6-0b1b-442d-ad80-d764677b320e"],
 "), where ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["t", "TI"], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Ket"], "=", "{", 
   StyleBox["cos",
    FontSlant->"Plain"], 
   FractionBox[
    StyleBox["\[Theta]", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Omega]", "TI"], 
     StyleBox["t", "TI"], "/", "2"}]], ",", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
   StyleBox["sin",
    FontSlant->"Plain"], 
   FractionBox[
    StyleBox["\[Theta]", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"+", 
     StyleBox["i", "TI"], 
     StyleBox["\[Omega]", "TI"], 
     StyleBox["t", "TI"], "/", "2"}]], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b15ace72-7939-42c0-8d95-86f3921abb2b"],
 " and only the ",
 StyleBox["relative", "TI"],
 " phase advances at ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9281bfc9-f7da-4d5c-a432-2b3cfde8a5e5"],
 "; off that axis the populations oscillate."
}], "Text",ExpressionUUID->"c2dee08b-7ca9-4ea3-bec2-ede1ac50b231"],

Cell["\<\
7.2 [BSc] How do I find stationary states and show they evolve only by a \
phase?\
\>", "Subsection",ExpressionUUID->"50b24551-25b6-4d86-b26c-b609b6ec50ba"],

Cell[TextData[{
 "A stationary state is an eigenstate of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7b1d000-17cb-4e9b-aa6b-c4ba1fe15c30"],
 ": if ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], 
    TemplateBox[{
      StyleBox["E", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    StyleBox["E", "TI"], 
    TemplateBox[{
      StyleBox["E", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62d54be5-397a-4572-a0fd-c54f957e5387"],
 " then ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["U", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{
      StyleBox["E", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["E", "TI"], 
      StyleBox["t", "TI"]}]], 
    TemplateBox[{
      StyleBox["E", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "894569ac-15a1-4f52-9557-b772300339be"],
 ", a pure global phase, so every measurable prediction is time-independent. \
Take a generic single-qubit Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   StyleBox["a", "TI"], " ", 
   StyleBox["Z", "TI"], "+", 
   StyleBox["b", "TI"], " ", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "242a2baa-8256-4a42-9976-d97aea6e382f"],
 " (energies ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["a", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["b", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f6eff0c-1511-423d-9694-54e80a3db622"],
 "), find an eigenstate, and evolve it."
}], "Text",ExpressionUUID->"779ea54e-aa01-4f32-8047-e1b3d417a968"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : diagonalize ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0441ea05-73e0-4f7e-889e-327b6b6bab5a"],
 ", then evolve its lower eigenstate; the amplitudes carry one common, \
time-dependent phase factor."
}], "Text",ExpressionUUID->"c2e03b1f-1dcd-400a-9f29-e0fb9e6d8ce2"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"es", " ", "=", " ", 
     RowBox[{"Eigensystem", "[", 
      RowBox[{
       RowBox[{"a", " ", 
        RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "+", " ", 
       RowBox[{"b", " ", 
        RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], "]"}]}], "}"}], ",", " ", 
   
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"en", " ", "=", " ", 
        RowBox[{"es", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"v", " ", "=", " ", 
        RowBox[{"Normalize", "[", 
         RowBox[{"es", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "]"}]}]}], "}"}], ",", 
     " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"a", " ", 
             RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "+", " ", 
            RowBox[{"b", " ", 
             RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], ")"}], " ", "t"}], 
         "]"}], " ", ".", " ", "v"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "b", ",", " ", "t"}], "}"}], " ", "\[Element]",
         " ", "Reals"}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"e1b03564-a907-4b51-bf90-6d00321508f0"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : ",
 Cell[BoxData["QuantumEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78f9dcaa-c7da-4bb1-a322-e8097eb4eccb"],
 " on each of the two eigenstates returns that same eigenvector times a \
single phase ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["E", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "636c2dff-8533-438e-9068-3bba397f5a71"],
 ", one phase per energy level."
}], "Text",ExpressionUUID->"44bdf1a7-57f3-4a47-8db9-fcaf3514309d"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"es", " ", "=", " ", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", 
       RowBox[{
        RowBox[{"a", " ", 
         RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "+", " ", 
        RowBox[{"b", " ", 
         RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], "]"}], 
      "[", "\"\<Eigensystem\>\"", "]"}]}], "}"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Normal", "@", 
        RowBox[{
         RowBox[{"QuantumEvolve", "[", 
          RowBox[{
           RowBox[{"QuantumOperator", "[", 
            RowBox[{
             RowBox[{"a", " ", 
              RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "+", " ", 
             RowBox[{"b", " ", 
              RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], "]"}], ",", " ", 
           RowBox[{"QuantumState", "[", 
            RowBox[{"Normalize", "[", 
             RowBox[{"es", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "j"}], "]"}], "]"}], "]"}], "]"}], ",", 
           " ", "t"}], "]"}], "[", "\"\<StateVector\>\"", "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b", ",", " ", "t"}], "}"}], " ", "\[Element]", 
      " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"56d95428-5005-4cdf-bc17-ee6d659c3941"],

Cell[TextData[{
 "Each evolution multiplies the eigenvector by a single overall phase ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["E", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a9fa028-cb65-423e-bcd0-dc5d562c6cdd"],
 " fixed by its energy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", "\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["a", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["b", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b73f1a7-26cd-41db-a91d-d9d8771b5a77"],
 ", so the amplitudes' moduli, and hence every outcome probability, never \
move: a stationary state is stationary precisely because the only thing that \
changes, a global phase, is the one thing no measurement can see (Part 1, \
1.4)."
}], "Text",ExpressionUUID->"5910c509-60c4-45e7-9df2-3245ae7d73cc"],

Cell["\<\
7.3 [BSc] How do I compute Rabi oscillations of a two-level system under a \
resonant classical drive?\
\>", "Subsection",ExpressionUUID->"5a59370b-c874-426c-b6b4-79549799d087"],

Cell[TextData[{
 "A resonant classical drive of Rabi frequency ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c6bed39-465f-4c85-a023-fade6c23eb35"],
 " reduces, in the frame rotating with the drive, to the static transverse \
Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   FractionBox["\[CapitalOmega]", "2"], 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb3ef8f2-b5be-44d5-ab56-2e55a4b51022"],
 "; we take that static form as given here and evolve under it, leaving its \
rotating-frame derivation to the later MSc treatment of the driven problem. \
Starting in ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80554d62-1219-4728-aeab-e658931f1d0d"],
 ", the population sloshes completely to ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "977df85e-d5b9-42ca-8838-cfa30f9405e2"],
 " and back: ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], "1"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{"\[CapitalOmega]", 
     StyleBox["t", "TI"]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc06fa2e-f9e0-466d-8791-daf637b9ea9d"],
 ". Evolve ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "487f820f-40ae-4c62-9d7b-c2cbc5a0010e"],
 " and read the probabilities."
}], "Text",ExpressionUUID->"fc149092-3f4c-4ba1-9e59-3002a61596c7"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the evolved amplitudes are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98cfeea5-b6d1-43f6-8b90-7ff89990870f"],
 "; the excited population is the modulus-squared of the lower amplitude."
}], "Text",ExpressionUUID->"0f4a7623-1a1f-4f09-8dfd-ff8ca9813abf"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Psi]", " ", "=", " ", 
     RowBox[{
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{"(", 
         RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", 
        RowBox[{"PauliMatrix", "[", "1", "]"}], " ", "t"}], "]"}], " ", ".", 
      " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0"}], "}"}]}]}], "}"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", "\[Psi]", "]"}], "^", "2"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[CapitalOmega]", ",", " ", "t"}], "}"}], " ", "\[Element]", 
      " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"99cd88e9-5fbc-4e15-af62-3fe9166b8e0f"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : ",
 Cell[BoxData["QuantumEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0ba8ac9-4569-4a31-91bf-52261102f58e"],
 " gives the evolved state object; its ",
 Cell[BoxData["\"\<ProbabilitiesList\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "228f3930-2961-4ff6-bfcf-4f873336f771"],
 " is the pair ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    SubscriptBox[
     StyleBox["P", "TI"], "0"]}], ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], "1"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57b184dc-a379-4c82-a095-52aa48f1ee68"],
 "."
}], "Text",ExpressionUUID->"3871c538-24fb-4a84-975a-e7baef38a6ff"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumEvolve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", 
       RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], ",", " ", 
      RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", "t"}], "]"}],
     "[", "\"\<ProbabilitiesList\>\"", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[CapitalOmega]", ",", " ", "t"}], "}"}], " ", "\[Element]", 
    " ", "Reals"}]}], "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"a5c88a45-fae2-454c-8ab9-61c0f3b9c889"],

Cell[TextData[{
 "Both give ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    SuperscriptBox[
     StyleBox["cos",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    FractionBox[
     RowBox[{"\[CapitalOmega]", 
      StyleBox["t", "TI"]}], "2"]}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["sin",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    FractionBox[
     RowBox[{"\[CapitalOmega]", 
      StyleBox["t", "TI"]}], "2"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d51d32e-7416-442b-bb1b-5ccd98a80b2c"],
 ": the qubit oscillates fully between the two levels at the Rabi frequency \
",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fed37ef7-6996-47fa-827e-b77f6f56adc0"],
 ", reaching the excited state at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "\[Pi]", "/", "\[CapitalOmega]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9da1213a-8c54-4a05-ac0f-d1d0a53e7e4a"],
 " (a ",
 Cell[BoxData["\[Pi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9802a274-0b71-49ed-8a04-ff2f93edf5a1"],
 "-pulse)."
}], "Text",ExpressionUUID->"c63e6ea9-8d0d-4a06-9488-b86c71669fab"],

Cell["\<\
7.4 [BSc] How do I compute the Larmor precession of a spin in a static \
magnetic field?\
\>", "Subsection",ExpressionUUID->"cfc71657-674e-4452-a308-bd8a81b1b2d4"],

Cell[TextData[{
 "A spin in a field along ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05f8e4dc-e50b-414d-b255-8f6491d28eb6"],
 " has ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   FractionBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f7317c0-70b8-4f7e-8483-7cee3bbcbb6b"],
 ". A spin prepared in the equatorial state ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ba96403-be5c-4d93-bc9d-00f2dbd91fd5"],
 " keeps ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41551b9e-61fc-4681-aa73-eae12edc0a41"],
 " while its transverse Bloch components rotate: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["X", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Omega]", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "551e5d00-ba0b-4f01-87be-abd1eb75033c"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Y", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Omega]", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "990dfe32-8e5a-4531-ad67-643098d849f9"],
 ". The Bloch vector precesses about the field at the Larmor frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c79191f4-9b40-4d5c-83ec-e6604c442fdf"],
 "."
}], "Text",ExpressionUUID->"5896de65-7bc9-427c-8a27-9f0d4279f38d"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : evolve ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f2d2deb-7a55-4dcd-b071-49ef263a3b6a"],
 ", form the density matrix, and read the three Pauli expectation values ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["X", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["Y", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["Z", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f434501-bad7-43d8-b5ce-42d9ec8f5437"],
 ", the Cartesian components of the Bloch vector."
}], "Text",ExpressionUUID->"8b29b1bb-1732-4774-9510-848d75444d7a"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Psi]", " ", "=", " ", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{"(", 
         RowBox[{"\[Omega]", "/", "2"}], ")"}], " ", 
        RowBox[{"PauliMatrix", "[", "3", "]"}], " ", "t"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}]}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"ComplexExpand", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", "\[Psi]", "]"}], " ", ".", " ", 
         RowBox[{"PauliMatrix", "[", "k", "]"}], " ", ".", " ", "\[Psi]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Omega]", ",", " ", "t"}], "}"}], " ", "\[Element]", " ", 
      "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"1559988c-3894-44ef-9d90-dd37d12dcd16"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : evolve the named ",
 Cell[BoxData["\"\<Plus\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d6981b6-dd73-49f8-b697-8828797705b4"],
 " state and take the expectation of each Pauli operator through a ",
 Cell[BoxData["QuantumMeasurementOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "acfd21c6-24e0-4ced-9ad2-59f209106d58"],
 "."
}], "Text",ExpressionUUID->"1227db42-8bd6-4d93-9f31-e5537a050531"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qs", " ", "=", " ", 
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Omega]", "/", "2"}], ")"}], " ", 
         RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}], ",", " ", 
       RowBox[{"QuantumState", "[", "\"\<Plus\>\"", "]"}], ",", " ", "t"}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"ExpToTrig", "[", 
      RowBox[{"ComplexExpand", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"QuantumMeasurementOperator", "[", 
            RowBox[{"QuantumOperator", "[", 
             RowBox[{"PauliMatrix", "[", "k", "]"}], "]"}], "]"}], "[", "qs", 
           "]"}], "[", "\"\<Mean\>\"", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Omega]", ",", " ", "t"}], "}"}], " ", "\[Element]", " ", 
      "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"d12a3014-f25f-44de-9183-c646c1afce92"],

Cell[TextData[{
 "Both return the Bloch vector ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Omega]", "TI"], 
    StyleBox["t", "TI"]}], ",", 
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Omega]", "TI"], 
    StyleBox["t", "TI"]}], ",", 
   RowBox[{"0", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b2c5fcf-cbb5-4d7d-b7bc-e0443f1f781b"],
 ": a unit vector sweeping the equator at angular velocity ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "acf156f0-b3ae-41dd-8688-d325790d7fe0"],
 ", the quantum image of a classical magnetic moment precessing about the \
field."
}], "Text",ExpressionUUID->"94474fd6-74dd-4e4a-9ebc-057f747bc0c4"],

Cell[TextData[{
 "7.5a [BSc] How do I evolve an observable in the Heisenberg picture, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["H", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["A", "TI"], " ", 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04568697-4428-4e12-8b0c-8de35a24d730"],
 "?"
}], "Subsection",ExpressionUUID->"536bb041-064d-4abd-81b7-0f69acf788cd"],

Cell[TextData[{
 "In the Heisenberg picture the state is frozen and the operators carry the \
time dependence, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["H", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["A", "TI"], " ", 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "187128b8-eb72-431d-b93a-eabc61a13909"],
 ". For ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   FractionBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07772b65-4309-4f60-bc2b-c09f995d8774"],
 " the observable ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db8e3b1d-0714-4ff6-a042-30e3f09e723c"],
 " rotates into a combination of ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b73cedb7-45e6-4b88-85ea-4444bc8e029d"],
 " and ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "742e5b75-6396-4178-a033-e9a3f452be1f"],
 ": ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["X", "TI"], 
    StyleBox["H", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"\[Omega]", "t"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["X", "TI"], "-", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"\[Omega]", "t"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["Y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "397c65f8-071a-4243-ba21-34f1375437bd"],
 "."
}], "Text",ExpressionUUID->"2fa85be3-0734-4a7a-bd89-011475f678b7"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : conjugate the matrix of ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d6ec92e-e991-433b-92ab-2afb0a09d5fe"],
 " by the propagator."
}], "Text",ExpressionUUID->"2b4091a6-0999-429b-a3b5-13a555fc3c34"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"u", " ", "=", " ", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{"(", 
        RowBox[{"\[Omega]", "/", "2"}], ")"}], " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}], " ", "t"}], "]"}]}], "}"}], ",",
    " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ConjugateTranspose", "[", "u", "]"}], " ", ".", " ", 
      RowBox[{"PauliMatrix", "[", "1", "]"}], " ", ".", " ", "u"}], ",", " ", 
     
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Omega]", ",", " ", "t"}], "}"}], " ", "\[Element]", " ", 
      "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"bd2fb77a-4923-4bf1-8e65-3b617cd3407a"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : ",
 Cell[BoxData["QuantumEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c54d0f6d-4f98-4974-90d5-9afe6d7586dc"],
 " evolves the ",
 StyleBox["observable", "TI"],
 " directly in the Heisenberg picture: give it the Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2894212-8701-42ed-a1ef-80c557b39077"],
 " and the operator ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bb33986-3394-4701-b320-8cf0bb6ea008"],
 ", and it returns the Heisenberg operator ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["H", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"], 
   StyleBox["X", "TI"], 
   StyleBox["U", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63364e24-d22a-4501-8874-17c208656ef2"],
 ", whose matrix we read off."
}], "Text",ExpressionUUID->"cad32bff-4548-44af-9e3b-d98478cc721a"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Normal", "@", 
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Omega]", "/", "2"}], ")"}], " ", 
        RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], ",", " ", 
       RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], ",", " ", "t"}], 
      "]"}], "[", "\"\<Matrix\>\"", "]"}]}], ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "\[Omega]"}], "}"}], " ", "\[Element]", " ", 
    "Reals"}]}], "]"}]], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"0a92a176-cbad-4d82-b5e9-d37b9191d0f3"],

Cell[TextData[{
 "Both return the matrix of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"\[Omega]", "t"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["X", "TI"], "-", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"\[Omega]", "t"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["Y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9dea934a-3d5e-405a-8182-2fdb14dcbdb4"],
 ": the Heisenberg observable precesses in the opposite sense to the Larmor \
state (7.4), which is why the Schrodinger and Heisenberg pictures agree on \
every expectation value."
}], "Text",ExpressionUUID->"9646c1e0-2b67-4dd0-9222-4f92a29416d9"],

Cell[TextData[{
 "7.5b [BSc] How do I verify Ehrenfest's theorem ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    StyleBox["d", "TI"], 
    StyleBox[
     RowBox[{"d", "t"}], "TI"]], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   FractionBox[
    StyleBox["i", "TI"], "\[HBar]"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      OverscriptBox[
       StyleBox["H", "TI"], "^"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", 
     StyleBox["A", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e07872e-7140-4135-8f72-1a099191a37f"],
 " for a general time-dependent ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2decbaa9-e015-4ff4-9f3f-274e8eae6484"],
 " Hamiltonian, without solving the dynamics?"
}], "Subsection",ExpressionUUID->"99642097-01ec-4cd5-861f-0870e98ab1bc"],

Cell[TextData[{
 "Ehrenfest's theorem is the equation of motion for expectation values: for \
an observable ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a27e232d-67d3-46af-a20c-bc55c33a8b1b"],
 " with no explicit time dependence, ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    StyleBox["d", "TI"], 
    StyleBox[
     RowBox[{"d", "t"}], "TI"]], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   FractionBox[
    StyleBox["i", "TI"], "\[HBar]"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      OverscriptBox[
       StyleBox["H", "TI"], "^"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", 
     StyleBox["A", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d0de389-b5ce-4bc1-9011-72a69c5a5200"],
 ". It follows directly from the Schrodinger equation, not from any \
particular solution, so it holds for a ",
 StyleBox["fully time-dependent", "TI"],
 " Hamiltonian, where no closed-form propagator exists, and can be checked \
without ever integrating the dynamics. Take the general driven qubit ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    RowBox[{"\[HBar]", " ", "\[CapitalOmega]", 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], " ", 
   OverscriptBox[
    StyleBox["n", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1700172f-f14f-4788-a191-21c16f15abe6"],
 " whose Bloch axis ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["n", "TI"], "^"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["\[Theta]", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1], 
      StyleBox["cos",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["\[Phi]", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", " ", 
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["\[Theta]", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["\[Phi]", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}], ",", " ", 
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["\[Theta]", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "743c71f4-5732-4119-91e3-f9ac084b1cbf"],
 " swings in time, together with a fixed observable ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   FractionBox[
    StyleBox["a", "TI"], "2"], " ", 
   OverscriptBox[
    StyleBox["m", "TI"], "^"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cabe7e75-47b8-40ec-9bfb-4fc12d04e8a0"],
 " along the constant axis ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["m", "TI"], "^"], "=", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["\[Theta]", "TI"], 
       StyleBox["A", "TI"]], 
      StyleBox["cos",
       FontSlant->"Plain"], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["\[Phi]", "TI"], 
       StyleBox["A", "TI"]]}], ",", " ", 
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["\[Theta]", "TI"], 
       StyleBox["A", "TI"]], 
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["\[Phi]", "TI"], 
       StyleBox["A", "TI"]]}], ",", " ", 
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["\[Theta]", "TI"], 
       StyleBox["A", "TI"]]}]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8957348-43f7-440e-ae00-ce849db79f5e"],
 "."
}], "Text",ExpressionUUID->"0a7b7169-3578-46cc-8f41-5e3fc0d88910"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : leave the state ",
 StyleBox["unsolved", "TI"],
 ". Write ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "=", "{", 
   SubscriptBox[
    StyleBox["c", "TI"], "1"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], ",", 
   SubscriptBox[
    StyleBox["c", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05932462-8519-4e8c-9b17-9481a6a3a91c"],
 " as abstract amplitudes and ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Bra"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a92e23e0-ef9c-4e66-a295-fba8e90cf547"],
 " as their conjugate ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "_"], "1"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "_"], "2"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eaef7e8a-a360-4a86-bfff-a48303921259"],
 ", and feed in the Schrodinger equation and its Hermitian conjugate only as \
the first derivatives ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Psi]", "TI"], "."], "=", "-", 
   FractionBox[
    StyleBox["i", "TI"], "\[HBar]"], 
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be78b1cd-8a2a-4b7f-9f21-7ff982e0b50d"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    OverscriptBox[
     StyleBox["\[Psi]", "TI"], "_"], "."], "=", "+", 
   FractionBox[
    StyleBox["i", "TI"], "\[HBar]"], 
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "\[UpTee]"], 
   OverscriptBox[
    StyleBox["\[Psi]", "TI"], "_"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d201a0c-7c3c-4fde-89ee-5a050cf13bf2"],
 " (with ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "*"], "=", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "\[UpTee]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ac39176-fcfb-439f-93ab-fc2df2e76b56"],
 " because ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00735fce-5a39-42a3-b5ed-5a6b2859a0a9"],
 " is Hermitian). The residual ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    StyleBox["d", "TI"], 
    StyleBox[
     RowBox[{"d", "t"}], "TI"]], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "-", 
   FractionBox[
    StyleBox["i", "TI"], "\[HBar]"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      OverscriptBox[
       StyleBox["H", "TI"], "^"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", 
     StyleBox["A", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ed085c3-6aa3-4222-99d4-4882b7d28489"],
 " then collapses to zero."
}], "Text",ExpressionUUID->"4218f243-cb20-451d-b39b-69f50c7d71e2"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"H", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[HBar]", " ", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "[", "t", "]"}], "/", "2"}]}], ")"}], " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"\[Theta]", "[", "t", "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", 
              RowBox[{"\[Phi]", "[", "t", "]"}]}], "]"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}], "}"}], ",", " ", 
         
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", 
              RowBox[{"\[Phi]", "[", "t", "]"}]}], "]"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}], ",", " ", 
           RowBox[{"-", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}], "}"}]}], 
        "}"}]}]}], ",", " ", 
     RowBox[{"A", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", "/", "2"}], ")"}], " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "\[Theta]A", "]"}], ",", " ", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", "\[Phi]A"}], "]"}], " ", 
            RowBox[{"Sin", "[", "\[Theta]A", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "\[Phi]A"}], "]"}], " ", 
            RowBox[{"Sin", "[", "\[Theta]A", "]"}]}], ",", " ", 
           RowBox[{"-", 
            RowBox[{"Cos", "[", "\[Theta]A", "]"}]}]}], "}"}]}], "}"}]}]}], ",",
      " ", 
     RowBox[{"\[Psi]", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"c1", "[", "t", "]"}], ",", " ", 
        RowBox[{"c2", "[", "t", "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"\[Psi]c", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"cc1", "[", "t", "]"}], ",", " ", 
        RowBox[{"cc2", "[", "t", "]"}]}], "}"}]}]}], "}"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"I", "/", "\[HBar]"}], " ", 
         RowBox[{
          RowBox[{"Transpose", "[", "H", "]"}], " ", ".", " ", "\[Psi]c"}]}], 
        ")"}], " ", ".", " ", "A", " ", ".", " ", "\[Psi]"}], " ", "+", " ", 
      RowBox[{"\[Psi]c", " ", ".", " ", "A", " ", ".", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "I"}], "/", "\[HBar]"}], " ", 
         RowBox[{"H", " ", ".", " ", "\[Psi]"}]}], ")"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"I", "/", "\[HBar]"}], " ", 
       RowBox[{"\[Psi]c", " ", ".", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"H", " ", ".", " ", "A"}], " ", "-", " ", 
          RowBox[{"A", " ", ".", " ", "H"}]}], ")"}], " ", ".", " ", 
        "\[Psi]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[CapitalOmega]", "[", "t", "]"}], ",", " ", 
        RowBox[{"\[Theta]", "[", "t", "]"}], ",", " ", 
        RowBox[{"\[Phi]", "[", "t", "]"}], ",", " ", "a", ",", " ", 
        "\[Theta]A", ",", " ", "\[Phi]A", ",", " ", "\[HBar]"}], "}"}], " ", "\[Element]",
       " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"1b6a2882-70a7-44e5-8a2b-267012959a7d"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same identity, with the commutator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], ",", 
    StyleBox["A", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f19660a9-5646-4fa0-850f-7ddbf494c50a"],
 " formed by the paclet's ",
 Cell[BoxData["Commutator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12df1888-0898-4bda-8e6d-5bbc82846d3e"],
 " acting on the two time-dependent ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "960724a0-ffac-4705-8047-f2b76d3e8066"],
 "s; the residual again vanishes."
}], "Text",ExpressionUUID->"f4819b0b-5cea-4c9c-9637-2250f8827f9d"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"H", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[HBar]", " ", 
          RowBox[{
           RowBox[{"\[CapitalOmega]", "[", "t", "]"}], "/", "2"}]}], ")"}], " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", 
             RowBox[{"\[Theta]", "[", "t", "]"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", 
               RowBox[{"\[Phi]", "[", "t", "]"}]}], "]"}], " ", 
             RowBox[{"Sin", "[", 
              RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", 
               RowBox[{"\[Phi]", "[", "t", "]"}]}], "]"}], " ", 
             RowBox[{"Sin", "[", 
              RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}], ",", " ", 
            RowBox[{"-", 
             RowBox[{"Cos", "[", 
              RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}], "}"}]}], 
         "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"A", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"a", "/", "2"}], ")"}], " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", "\[Theta]A", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", "\[Phi]A"}], "]"}], " ", 
             RowBox[{"Sin", "[", "\[Theta]A", "]"}]}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "\[Phi]A"}], "]"}], " ", 
             RowBox[{"Sin", "[", "\[Theta]A", "]"}]}], ",", " ", 
            RowBox[{"-", 
             RowBox[{"Cos", "[", "\[Theta]A", "]"}]}]}], "}"}]}], "}"}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"\[Psi]", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"c1", "[", "t", "]"}], ",", " ", 
        RowBox[{"c2", "[", "t", "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"\[Psi]c", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"cc1", "[", "t", "]"}], ",", " ", 
        RowBox[{"cc2", "[", "t", "]"}]}], "}"}]}]}], "}"}], ",", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", " ", "=", " ", 
        RowBox[{"Normal", "[", 
         RowBox[{"H", "[", "\"\<Matrix\>\"", "]"}], "]"}]}], ",", " ", 
       RowBox[{"amat", " ", "=", " ", 
        RowBox[{"Normal", "[", 
         RowBox[{"A", "[", "\"\<Matrix\>\"", "]"}], "]"}]}], ",", " ", 
       RowBox[{"comm", " ", "=", " ", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{"Commutator", "[", 
           RowBox[{"H", ",", " ", "A"}], "]"}], "[", "\"\<Matrix\>\"", "]"}], 
         "]"}]}]}], "}"}], ",", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"I", "/", "\[HBar]"}], " ", 
           RowBox[{
            RowBox[{"Transpose", "[", "h", "]"}], " ", ".", " ", 
            "\[Psi]c"}]}], ")"}], " ", ".", " ", "amat", " ", ".", " ", 
         "\[Psi]"}], " ", "+", " ", 
        RowBox[{"\[Psi]c", " ", ".", " ", "amat", " ", ".", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "I"}], "/", "\[HBar]"}], " ", 
           RowBox[{"h", " ", ".", " ", "\[Psi]"}]}], ")"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"I", "/", "\[HBar]"}], " ", 
         RowBox[{
         "\[Psi]c", " ", ".", " ", "comm", " ", ".", " ", "\[Psi]"}]}]}], ",",
        " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "[", "t", "]"}], ",", " ", 
          RowBox[{"\[Theta]", "[", "t", "]"}], ",", " ", 
          RowBox[{"\[Phi]", "[", "t", "]"}], ",", " ", "a", ",", " ", 
          "\[Theta]A", ",", " ", "\[Phi]A", ",", " ", "\[HBar]"}], "}"}], " ",
         "\[Element]", " ", "Reals"}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"584f6626-41f7-4bc8-a2cc-1e0ecf07f3a5"],

Cell[TextData[{
 "Both return ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d050650e-162e-4076-a46a-84ceec214134"],
 ": the gap between ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    StyleBox["d", "TI"], 
    StyleBox[
     RowBox[{"d", "t"}], "TI"]], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53dd9eff-7854-41f2-8713-97aed9059a31"],
 " and ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    StyleBox["i", "TI"], "\[HBar]"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      OverscriptBox[
       StyleBox["H", "TI"], "^"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", 
     StyleBox["A", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e82dba1-3888-4db4-8145-46d682ac110e"],
 " is identically zero for ",
 StyleBox["any", "TI"],
 " time-dependent axis ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "171ac192-1797-43b1-b54c-0d02cc4cbb31"],
 ", drive ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92f2542a-0cc3-49e4-aaaa-f550f7dcae5e"],
 ", and fixed observable ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74c202b3-36d9-42a3-9c13-cf086b8256b2"],
 ", with the state never solved for. Ehrenfest's theorem is an operator \
identity forced by the Schrodinger equation alone, not a property of a \
particular trajectory, which is why it survives the time-ordered-exponential \
dynamics of a driven qubit that has no closed-form propagator. The one term \
that could spoil it, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[PartialD]", 
     StyleBox["t", "TI"]], 
    StyleBox["A", "TI"]}], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce01845c-2fff-4361-a40f-08a6d87d6aab"],
 ", is absent precisely because ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79e7a89a-75d7-4d51-afe6-5fdf62d503d6"],
 " carries no explicit time dependence."
}], "Text",ExpressionUUID->"e345d369-5dcb-44cf-a158-c75884029dc5"],

Cell["\<\
7.6 [MSc] How do I transform between the Schrodinger, Heisenberg, and \
interaction pictures and show they agree on expectation values?\
\>", "Subsection",ExpressionUUID->"48adac4d-80e0-43bf-a5da-828730c31bd2"],

Cell[TextData[{
 "The three pictures move the time dependence between state and operator but \
leave every expectation value invariant. Schrodinger evolves the state, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["t", "TI"], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Bra"], 
   StyleBox["A", "TI"], 
   TemplateBox[{
     RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["t", "TI"], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70f62836-e945-4ec5-93cf-75f8ae94ccf0"],
 "; Heisenberg evolves the operator, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], "0"]},
    "Bra"], 
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["H", "TI"]], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], "0"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "299217b0-d5a5-4cb4-b801-acbeeb66aa47"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["H", "TI"]], "=", 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"], 
   StyleBox["A", "TI"], 
   StyleBox["U", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c3fd843-dad6-434c-b261-1f955c4e2198"],
 "; the interaction picture splits ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "0"], "+", 
   OverscriptBox[
    StyleBox["V", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66810874-97e8-4328-908d-66098913599b"],
 " and evolves the state by ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["V", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1c80561-22b6-4736-9ce8-64ca43304566"],
 " and the operator by ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d58d16a4-b209-442a-969d-8bec205e4771"],
 ". Take ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "0"], "=", 
   FractionBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34325b78-b7c2-4bc1-ae66-91c58b9db1a8"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["V", "TI"], "^"], "=", 
   FractionBox[
    StyleBox["g", "TI"], "2"], 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc7c9402-1411-41b3-8138-cf0e2881145b"],
 ", observable ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63e2326a-51bf-4357-aec5-154861a4b478"],
 ", initial state ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6f5131b-74f0-4f00-b6da-d333e69c7869"],
 ", and compute ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99354075-b2ec-4f4e-974f-933c32c6ffde"],
 " three ways."
}], "Text",ExpressionUUID->"f61d9775-3dc5-4cfc-b5bd-8305044282de"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : all three expectation values from the one propagator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["H", "TI"], "^"], "0"], "+", 
      OverscriptBox[
       StyleBox["V", "TI"], "^"]}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24377e9c-aead-4f4d-b90c-c14fd5ac0abf"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["U", "TI"], "0"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["H", "TI"], "^"], "0"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00ed84dc-91ff-4f6a-9b43-99578b042666"],
 " the free part."
}], "Text",ExpressionUUID->"3d5fccea-84a7-4601-ab39-11c3b43d6a7b"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"h0", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Omega]", "/", "2"}], ")"}], " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], ",", " ", 
     RowBox[{"v", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"g", "/", "2"}], ")"}], " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], ",", " ", 
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}], ",", " ", 
     RowBox[{"\[Psi]0", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0"}], "}"}]}]}], "}"}], ",", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u", " ", "=", " ", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{"h0", " ", "+", " ", "v"}], ")"}], " ", "t"}], "]"}]}], ",",
        " ", 
       RowBox[{"u0", " ", "=", " ", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "h0", " ", "t"}], "]"}]}]}], "}"}], ",", 
     " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Psi]S", " ", "=", " ", 
          RowBox[{"u", " ", ".", " ", "\[Psi]0"}]}], ",", " ", 
         RowBox[{"\[Psi]I", " ", "=", " ", 
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", "u0", "]"}], " ", ".", " ", 
           RowBox[{"(", 
            RowBox[{"u", " ", ".", " ", "\[Psi]0"}], ")"}]}]}]}], "}"}], ",", 
       " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"ComplexExpand", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Conjugate", "[", "\[Psi]S", "]"}], " ", ".", " ", "a", 
             " ", ".", " ", "\[Psi]S"}], ",", " ", 
            RowBox[{
             RowBox[{"Conjugate", "[", "\[Psi]0", "]"}], " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "u", "]"}], " ", ".", " ", 
               "a", " ", ".", " ", "u"}], ")"}], " ", ".", " ", "\[Psi]0"}], ",",
             " ", 
            RowBox[{
             RowBox[{"Conjugate", "[", "\[Psi]I", "]"}], " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "u0", "]"}], " ", ".", " ", 
               "a", " ", ".", " ", "u0"}], ")"}], " ", ".", " ", 
             "\[Psi]I"}]}], "}"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Omega]", ",", " ", "g", ",", " ", "t"}], "}"}], " ", "\[Element]",
           " ", "Reals"}]}], "]"}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"4b86bee3-8175-4ac7-806e-5a79598c9403"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the Schrodinger value through ",
 Cell[BoxData["QuantumEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2641f91e-b39b-44e0-947c-2d07c5661d29"],
 " and a ",
 Cell[BoxData["QuantumMeasurementOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1574dba-4d63-4129-a149-f58f4b645fef"],
 ", to be compared against those three."
}], "Text",ExpressionUUID->"e7dadd3a-5e1d-47bf-a45f-86a9ca01cebe"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qs", " ", "=", " ", 
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Omega]", "/", "2"}], ")"}], " ", 
          RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"g", "/", "2"}], ")"}], " ", 
          RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], "]"}], ",", " ", 
       RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", "t"}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"ComplexExpand", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumMeasurementOperator", "[", 
         RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "]"}], "[", "qs",
         "]"}], "[", "\"\<Mean\>\"", "]"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Omega]", ",", " ", "g", ",", " ", "t"}], "}"}], " ", "\[Element]",
       " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"2563ebc8-8a22-44c6-9042-5807ec792f5a"],

Cell[TextData[{
 "The WL cell returns the ",
 StyleBox["same", "TI"],
 " number three times, and the QF Schrodinger expectation equals it: the \
picture is a bookkeeping choice for where the clock sits, never a physical \
one, because ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], "0"]},
    "Bra"], 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"], 
   StyleBox["A", "TI"], 
   StyleBox["U", "TI"], 
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], "0"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d531569a-8880-40e7-85a6-4b87a6b1fe56"],
 " is one expression however you group the factors."
}], "Text",ExpressionUUID->"64fe2da3-4c01-4a85-b7d4-2b70b23b3df1"],

Cell[TextData[{
 "7.7 [MSc] How do I verify the Mandelstam-Tamm speed limit for a general \
time-dependent ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8df5b642-1ab2-4080-99b9-81d5bd5648e1"],
 " Hamiltonian, whose local rate is ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["s", "TI"], 
      StyleBox[
       RowBox[{"F", "S"}], "TI"]]}], 
    StyleBox[
     RowBox[{"d", "t"}], "TI"]], "=", 
   FractionBox[
    RowBox[{"\[CapitalDelta]", 
     StyleBox["E", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "\[HBar]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "baa6cd6d-e378-4c98-a27e-09b627e1b88b"],
 ", without solving the dynamics?"
}], "Subsection",ExpressionUUID->"636b7712-49ae-4c22-a8d5-fd436ef7e292"],

Cell[TextData[{
 "The Mandelstam-Tamm bound sets a minimum time for a state to move a given \
distance in Hilbert space: the Bures angle ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arccos",
    FontSlant->"Plain"], GridBox[{
     {
      TemplateBox[{
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], "0"], 
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], 
         StyleBox["t", "TI"]]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18ed4db6-909f-465d-bdb9-702b46ae21b1"],
 " (the Fubini-Study geodesic distance from the start) cannot exceed the \
length of the path actually traced, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arccos",
    FontSlant->"Plain"], GridBox[{
     {
      TemplateBox[{
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], "0"], 
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], 
         StyleBox["t", "TI"]]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", 
   FractionBox["1", "\[HBar]"], 
   UnderoverscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"],
    LimitsPositioning->False], "\[CapitalDelta]", 
   StyleBox["E", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["t", "TI"], "\[Prime]"], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["t", "TI"], "\[Prime]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9561c221-35f9-46ae-9d9d-8b763f544418"],
 " with ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["E", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["t", "TI"], "\[Prime]"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["H", "TI"], "^"], 
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        SuperscriptBox[
         StyleBox["t", "TI"], "\[Prime]"], 
        StyleBox[")",
         SpanMaxSize->1]}], "2"]}], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1], "-", 
     SuperscriptBox[
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       RowBox[{
        OverscriptBox[
         StyleBox["H", "TI"], "^"], 
        StyleBox["(",
         SpanMaxSize->1], 
        SuperscriptBox[
         StyleBox["t", "TI"], "\[Prime]"], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "996bf930-0264-4880-951b-07e11e4fc3fe"],
 ". This ",
 StyleBox["integral", "TI"],
 " form is the general statement, valid for a fully time-dependent ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "793962be-d5cc-4800-a1b7-8629550f20f6"],
 ". Only when ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffd45788-f3ec-40c3-a6e6-48444ef13b88"],
 " is time-independent is ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["E", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5746d50c-c065-4e07-a1ba-31618c4be14d"],
 " a conserved constant, and the integral collapses to ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["E", "TI"], " ", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bdc65a82-c1ab-4b50-a252-da043110bef5"],
 ", giving the familiar ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "\[GreaterEqual]", "\[HBar]", 
   StyleBox["arccos",
    FontSlant->"Plain"], GridBox[{
     {
      TemplateBox[{
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], "0"], 
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], 
         StyleBox["t", "TI"]]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "/", "\[CapitalDelta]", 
   StyleBox["E", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c78dc66-a47e-4c28-ba08-73db78eeecae"],
 ". The engine underneath is a local ",
 StyleBox["equality", "TI"],
 ": the speed at which the state sweeps through projective Hilbert space, in \
the Fubini-Study metric, equals the instantaneous energy uncertainty, ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["s", "TI"], 
      StyleBox[
       RowBox[{"F", "S"}], "TI"]]}], 
    StyleBox[
     RowBox[{"d", "t"}], "TI"]], "=", 
   FractionBox[
    RowBox[{"\[CapitalDelta]", 
     StyleBox["E", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "\[HBar]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d5c6c8f-a488-4ef8-a7b9-27a63946180b"],
 " (Anandan-Aharonov). Like Ehrenfest (7.5b) it follows from the Schrodinger \
equation alone, so for a general driven qubit ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    RowBox[{"\[HBar]", " ", "\[CapitalOmega]", 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], " ", 
   OverscriptBox[
    StyleBox["n", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14cbed41-4de7-446b-901f-d2e822f8198f"],
 " it can be checked without ever solving for the state."
}], "Text",ExpressionUUID->"ec48414b-d987-42a2-8642-2a7b2433b334"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : leave the state ",
 StyleBox["unsolved", "TI"],
 " as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "=", "{", 
   SubscriptBox[
    StyleBox["c", "TI"], "1"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], ",", 
   SubscriptBox[
    StyleBox["c", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64182ef1-c464-4785-9f03-aebd548968dc"],
 " with conjugate ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Bra"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62b1002c-7ce2-406d-829b-3f3900b60647"],
 ", substitute ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Psi]", "TI"], "."], "=", "-", 
   FractionBox[
    StyleBox["i", "TI"], "\[HBar]"], 
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6c06048-3c43-433e-a3cd-4a5a58bc69d7"],
 " and its Hermitian conjugate, and compare the squared Fubini-Study speed ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     OverscriptBox[
      StyleBox["\[Psi]", "TI"], "."], 
     OverscriptBox[
      StyleBox["\[Psi]", "TI"], "."]},
    "BraKet"], "-", 
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{
         StyleBox["\[Psi]", "TI"], 
         OverscriptBox[
          StyleBox["\[Psi]", "TI"], "."]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77fdac44-4532-4c7c-8f40-030a0c61c426"],
 " with ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["E", "TI"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], "/", 
   SuperscriptBox["\[HBar]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b434845-7f58-4210-9438-5e841a1b15f3"],
 "; the difference collapses to zero."
}], "Text",ExpressionUUID->"cc0c5f35-d0f2-4413-a15c-94b89a79c2ca"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"H", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[HBar]", " ", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "[", "t", "]"}], "/", "2"}]}], ")"}], " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"\[Theta]", "[", "t", "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", 
              RowBox[{"\[Phi]", "[", "t", "]"}]}], "]"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}], "}"}], ",", " ", 
         
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", 
              RowBox[{"\[Phi]", "[", "t", "]"}]}], "]"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}], ",", " ", 
           RowBox[{"-", 
            RowBox[{"Cos", "[", 
             RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}], "}"}]}], 
        "}"}]}]}], ",", " ", 
     RowBox[{"\[Psi]", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"c1", "[", "t", "]"}], ",", " ", 
        RowBox[{"c2", "[", "t", "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"\[Psi]c", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"cc1", "[", "t", "]"}], ",", " ", 
        RowBox[{"cc2", "[", "t", "]"}]}], "}"}]}]}], "}"}], ",", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Psi]d", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "I"}], "/", "\[HBar]"}], " ", 
         RowBox[{"H", " ", ".", " ", "\[Psi]"}]}]}], ",", " ", 
       RowBox[{"\[Psi]cd", " ", "=", " ", 
        RowBox[{
         RowBox[{"I", "/", "\[HBar]"}], " ", 
         RowBox[{
          RowBox[{"Transpose", "[", "H", "]"}], " ", ".", " ", 
          "\[Psi]c"}]}]}]}], "}"}], ",", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Psi]cd", " ", ".", " ", "\[Psi]d"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Psi]c", " ", ".", " ", "\[Psi]d"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"\[Psi]cd", " ", ".", " ", "\[Psi]"}], ")"}]}]}], ")"}], 
        " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
           "\[Psi]c", " ", ".", " ", "H", " ", ".", " ", "H", " ", ".", " ", 
            "\[Psi]"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[Psi]c", " ", ".", " ", "H", " ", ".", " ", "\[Psi]"}],
              ")"}], "^", "2"}]}], ")"}], "/", 
         RowBox[{"\[HBar]", "^", "2"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "[", "t", "]"}], ",", " ", 
          RowBox[{"\[Theta]", "[", "t", "]"}], ",", " ", 
          RowBox[{"\[Phi]", "[", "t", "]"}], ",", " ", "\[HBar]"}], "}"}], 
        " ", "\[Element]", " ", "Reals"}]}], "]"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->
  "In[21]:= ",ExpressionUUID->"c724d79f-5f62-412c-8a56-6c0b160c4767"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same identity, with the energy square ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4187a038-d814-40df-944b-d94ffb8bbcb3"],
 " taken from the operator product ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fd0f9ce-51d4-4f0d-a70d-e038757d670a"],
 " formed by composing the time-dependent ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f50fca01-95e2-4963-8fe1-54e6216fcd80"],
 " with itself (",
 Cell[BoxData[
  RowBox[{"H", " ", "@", " ", "H"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bb7ed5b-e675-4076-a288-f2daa692d8db"],
 "); the residual again vanishes."
}], "Text",ExpressionUUID->"223612b3-9c86-4d3d-81df-9dc1d23365d0"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"H", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[HBar]", " ", 
          RowBox[{
           RowBox[{"\[CapitalOmega]", "[", "t", "]"}], "/", "2"}]}], ")"}], " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", 
             RowBox[{"\[Theta]", "[", "t", "]"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", 
               RowBox[{"\[Phi]", "[", "t", "]"}]}], "]"}], " ", 
             RowBox[{"Sin", "[", 
              RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", 
               RowBox[{"\[Phi]", "[", "t", "]"}]}], "]"}], " ", 
             RowBox[{"Sin", "[", 
              RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}], ",", " ", 
            RowBox[{"-", 
             RowBox[{"Cos", "[", 
              RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}], "}"}]}], 
         "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"\[Psi]", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"c1", "[", "t", "]"}], ",", " ", 
        RowBox[{"c2", "[", "t", "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"\[Psi]c", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"cc1", "[", "t", "]"}], ",", " ", 
        RowBox[{"cc2", "[", "t", "]"}]}], "}"}]}]}], "}"}], ",", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", " ", "=", " ", 
        RowBox[{"Normal", "[", 
         RowBox[{"H", "[", "\"\<Matrix\>\"", "]"}], "]"}]}], ",", " ", 
       RowBox[{"h2", " ", "=", " ", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"H", " ", "@", " ", "H"}], ")"}], "[", "\"\<Matrix\>\"", 
          "]"}], "]"}]}]}], "}"}], ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Psi]d", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "I"}], "/", "\[HBar]"}], " ", 
           RowBox[{"h", " ", ".", " ", "\[Psi]"}]}]}], ",", " ", 
         RowBox[{"\[Psi]cd", " ", "=", " ", 
          RowBox[{
           RowBox[{"I", "/", "\[HBar]"}], " ", 
           RowBox[{
            RowBox[{"Transpose", "[", "h", "]"}], " ", ".", " ", 
            "\[Psi]c"}]}]}]}], "}"}], ",", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Psi]cd", " ", ".", " ", "\[Psi]d"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\[Psi]c", " ", ".", " ", "\[Psi]d"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"\[Psi]cd", " ", ".", " ", "\[Psi]"}], ")"}]}]}], ")"}],
           " ", "-", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
             "\[Psi]c", " ", ".", " ", "h2", " ", ".", " ", "\[Psi]"}], " ", "-",
              " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
               "\[Psi]c", " ", ".", " ", "h", " ", ".", " ", "\[Psi]"}], 
               ")"}], "^", "2"}]}], ")"}], "/", 
           RowBox[{"\[HBar]", "^", "2"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[CapitalOmega]", "[", "t", "]"}], ",", " ", 
            RowBox[{"\[Theta]", "[", "t", "]"}], ",", " ", 
            RowBox[{"\[Phi]", "[", "t", "]"}], ",", " ", "\[HBar]"}], "}"}], 
          " ", "\[Element]", " ", "Reals"}]}], "]"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"84c23aba-6559-42e9-b702-aa3c5d9d1e59"],

Cell[TextData[{
 "Both return ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cedf6cc9-fbad-4f7a-a234-c8a6e5c9cfc1"],
 ": the state's rate of travel through Hilbert space is exactly ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["E", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "/", "\[HBar]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b940593b-1c98-4062-ab37-04875c87ba3a"],
 " at every instant, for any drive ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf53baf9-058c-498b-9acd-ff5fc4ede3e3"],
 " and any swinging axis ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e60127c-4ecf-486f-b14c-59e88d8ea0b0"],
 ", with the state never solved for. The Mandelstam-Tamm bound is then pure \
geometry, geodesic ",
 Cell[BoxData["\[LessEqual]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc211866-09ff-4c10-b003-c5c783d93bbe"],
 " path length: no evolution can reach a Bures angle larger than the \
accumulated ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "\[HBar]"], 
   UnderoverscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"],
    LimitsPositioning->False], "\[CapitalDelta]", 
   StyleBox["E", "TI"], " ", 
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["t", "TI"], "\[Prime]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55c70da9-5761-44c7-9e6e-5409a8ef3ba4"],
 ". A state saturates it (moves at the speed limit) when its trajectory is a \
Fubini-Study geodesic, as the time-independent ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "419b3e62-d465-4727-ba43-41006af19491"],
 " evolution of ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bd84497-334a-41df-a616-1ea1b9d478fb"],
 " does on its first quarter-period; a general time-dependent drive respects \
the bound but need not saturate it."
}], "Text",ExpressionUUID->"6d2d0edc-26a9-40cb-bbbe-d0952896628e"],

Cell["\<\
7.8 [MSc] How do I solve a classically driven two-level system in the \
rotating frame (the Rabi problem)?\
\>", "Subsection",ExpressionUUID->"2c869327-d904-4904-8b70-a05dc7246ab7"],

Cell[TextData[{
 "A two-level atom driven by a classical field has ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], "0"], "2"], 
   StyleBox["Z", "TI"], "+", "\[CapitalOmega]", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox["d", "TI"]], 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f49776ab-8a4e-4e51-9320-56b9d21088cd"],
 ". Moving to the frame rotating at the drive frequency, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox["d", "TI"]], 
     StyleBox["t", "TI"], " ", 
     StyleBox["Z", "TI"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22fcbf7a-e12e-4ba5-ab51-c21346f44894"],
 ", and dropping the fast counter-rotating terms (the rotating-wave \
approximation) turns this into the ",
 StyleBox["static", "TI"],
 " Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["H", "TI"], "^"], 
    StyleBox["rot",
     FontSlant->"Plain"]], "=", 
   FractionBox["\[CapitalDelta]", "2"], 
   StyleBox["Z", "TI"], "+", 
   FractionBox["\[CapitalOmega]", "2"], 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2edcfd61-d062-4b0c-ba85-4b250d5b93cb"],
 " with detuning ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], "0"], "-", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d00f38a9-7d8a-4739-bfe9-b3baa26cd5b1"],
 ". On resonance (",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8dd6e20f-e714-4d49-9410-695a2715b6b4"],
 ") it is the Rabi drive of 7.3."
}], "Text",ExpressionUUID->"0b3a7463-e1b6-4aba-9da9-c86d197bf250"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : form the rotating-frame Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], 
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   SuperscriptBox[
    StyleBox["R", "TI"], "\[Dagger]"], "-", 
   FractionBox[
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox["d", "TI"]], "2"], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5622dcbe-aaab-4cde-a932-81c26f417f2a"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox["d", "TI"]], 
     StyleBox["t", "TI"], " ", 
     StyleBox["Z", "TI"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc2d2f2f-7c29-471c-91b6-309dac956a66"],
 ", and expand the trigonometry with ",
 Cell[BoxData["TrigReduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7552ae9b-835a-46e0-9f67-abe3d14c9688"],
 ". The result is a ",
 StyleBox["static", "TI"],
 " part ",
 Cell[BoxData[
  RowBox[{
   FractionBox["\[CapitalDelta]", "2"], 
   StyleBox["Z", "TI"], "+", 
   FractionBox["\[CapitalOmega]", "2"], 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e303260-5efb-41e0-9493-176b4597ce30"],
 " (detuning ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], "0"], "-", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa380282-a48f-42c2-954d-8a5f915c6030"],
 ") plus ",
 StyleBox["counter-rotating", "TI"],
 " terms carrying ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox["d", "TI"]], 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ff81d4b-c3f7-4f17-822b-429d3a546adc"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox["d", "TI"]], 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e799ce17-831f-47ae-b327-7b05a13b8b89"],
 ", which oscillate at twice the drive frequency."
}], "Text",ExpressionUUID->"301c6f5d-0e45-41b5-b430-56fbd18a5e77"],

Cell[BoxData[
 RowBox[{"hrot", " ", "=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{"I", " ", "\[Omega]d", " ", "t", " ", 
         RowBox[{
          RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}]}], "]"}]}], ",", 
      " ", 
      RowBox[{"hdrive", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Omega]0", "/", "2"}], ")"}], " ", 
         RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "+", " ", 
        RowBox[{"\[CapitalOmega]", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"\[Omega]d", " ", "t"}], "]"}], " ", 
         RowBox[{"PauliMatrix", "[", "1", "]"}]}]}]}]}], "}"}], ",", " ", 
    RowBox[{"TrigReduce", "[", 
     RowBox[{"ComplexExpand", "[", 
      RowBox[{
       RowBox[{"r", " ", ".", " ", "hdrive", " ", ".", " ", 
        RowBox[{"ConjugateTranspose", "[", "r", "]"}]}], " ", "-", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Omega]d", "/", "2"}], ")"}], " ", 
        RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], "]"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"c2f31c15-b953-4018-ba72-06118f65eb9f"],

Cell[TextData[{
 "Those two oscillating pieces swing at ",
 Cell[BoxData[
  RowBox[{"2", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eea30ca-5699-44fb-a793-47d08af329ce"],
 ", far faster than the slow Rabi dynamics set by ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "\[LessLess]", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b533a3f6-3cc7-47cd-bb75-8038808d253a"],
 ", so over any timescale on which the qubit actually evolves they average to \
zero. The rotating-wave approximation discards them: the replacement rule ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"2", 
      SubscriptBox[
       StyleBox["\[Omega]", "TI"], 
       StyleBox["d", "TI"]], 
      StyleBox["t", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "\[Rule]", "0"}], ",", " ", 
    RowBox[{
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"2", 
        SubscriptBox[
         StyleBox["\[Omega]", "TI"], 
         StyleBox["d", "TI"]], 
        StyleBox["t", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}]}], "\[Rule]", "0"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b7bd69c-cbcf-4bab-ae5d-643841ffb8ea"],
 " sets exactly those two fast oscillations to zero, collapsing the \
counter-rotating terms and leaving the static Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   FractionBox["\[CapitalDelta]", "2"], 
   StyleBox["Z", "TI"], "+", 
   FractionBox["\[CapitalOmega]", "2"], 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8fdfbf6-586b-42bf-a951-8314249a3485"],
 "."
}], "Text",ExpressionUUID->"932e165a-5999-4e25-aab3-4cef3b18ab69"],

Cell[BoxData[
 RowBox[{"hrot", " ", "/.", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"2", " ", "t", " ", "\[Omega]d"}], "]"}], " ", "->", " ", "0"}],
     ",", " ", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"2", " ", "t", " ", "\[Omega]d"}], "]"}], " ", "->", " ", 
     "0"}]}], "}"}]}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"f1a5d609-4f73-47b3-881f-47a1021452d5"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the resonant (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["d", "TI"]], "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdc6df22-2f6a-47a3-a87a-b10e4db54dae"],
 ", so ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14346424-519e-424a-8e4b-2ad0c9346d37"],
 ") rotating-frame problem is the static drive ",
 Cell[BoxData[
  RowBox[{
   FractionBox["\[CapitalOmega]", "2"], 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da4b7eac-ce43-4a19-acd8-23031a692450"],
 "; evolve ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bdf797ce-5c1e-4244-a023-334c7efaa0b6"],
 " under it and recover the Rabi population."
}], "Text",ExpressionUUID->"263f0548-8627-46fc-abbd-8ddb4cf71e9b"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumEvolve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", 
       RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], ",", " ", "t"}], 
     "]"}], "[", "\"\<ProbabilitiesList\>\"", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[CapitalOmega]", ",", " ", "t"}], "}"}], " ", "\[Element]", 
    " ", "Reals"}]}], "]"}]], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"899419f7-d850-4681-845e-12226633ef15"],

Cell[TextData[{
 "Averaging away the ",
 Cell[BoxData[
  RowBox[{"2", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f3bdd54-f190-41bb-a13f-e5c1aac94265"],
 " terms leaves ",
 Cell[BoxData[
  RowBox[{
   FractionBox["\[CapitalDelta]", "2"], 
   StyleBox["Z", "TI"], "+", 
   FractionBox["\[CapitalOmega]", "2"], 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8105f92-8de5-4a91-8828-498b6122713a"],
 ": the drive dresses the qubit with an effective static field whose ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aadded11-932e-4392-9d69-7532e5b46fa8"],
 "-component is the detuning and whose ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36d2c811-48c4-4a3e-b27e-43ffaf3a6fad"],
 "-component is half the drive amplitude. On resonance the field is purely \
transverse and the qubit Rabi-flops completely, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], "1"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{"\[CapitalOmega]", 
     StyleBox["t", "TI"]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7490911-e42d-4fe2-ac65-7748be289648"],
 "; off resonance the flopping is faster but incomplete."
}], "Text",ExpressionUUID->"d9cb806f-0f66-4ae2-a42a-a888d7359af0"],

Cell[TextData[{
 "7.9a [MSc] How do I compute the first-order transition probability under a \
periodic perturbation ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["H", "TI"], "\[Prime]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["V", "TI"], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"\[Omega]", "t"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "005af5a9-5969-4d3e-8a88-28ca0b7e2acf"],
 "?"
}], "Subsection",ExpressionUUID->"aacfc67b-77b1-4850-91ed-486195fbc97d"],

Cell[TextData[{
 "First-order time-dependent perturbation theory gives the amplitude to hop \
from ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["i", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41feaaac-3f44-4f15-8f55-5238322771d3"],
 " to ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["f", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79ca163e-a774-4f7c-a18a-dd9548dbe688"],
 " under ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["H", "TI"], "\[Prime]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["V", "TI"], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"\[Omega]", "t"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ad67dc2-f2b2-4107-8182-81079c91900b"],
 " as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["f", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   StyleBox["i", "TI"], 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox[
     RowBox[{"f", "i"}], "TI"]], 
   UnderoverscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"],
    LimitsPositioning->False], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Omega]", "TI"], 
    SuperscriptBox[
     StyleBox["t", "TI"], "\[Prime]"]}], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox[
       RowBox[{"f", "i"}], "TI"]], 
     SuperscriptBox[
      StyleBox["t", "TI"], "\[Prime]"]}]], 
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["t", "TI"], "\[Prime]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1afc86f5-1eb9-4427-b691-9aa39e8d608f"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox[
     RowBox[{"f", "i"}], "TI"]], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["f", "TI"]},
     "Bra"], 
    StyleBox["V", "TI"], 
    TemplateBox[{
      StyleBox["i", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96fa2a3d-10d3-4272-b675-82e4e548aa65"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox[
     RowBox[{"f", "i"}], "TI"]], "=", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["f", "TI"]], "-", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d607693-5b46-44f4-aca7-9c549d6212d7"],
 ". The near-resonant term gives ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "\[Rule]", 
     StyleBox["f", "TI"]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        SubscriptBox[
         StyleBox["c", "TI"], 
         StyleBox["f", "TI"]], 
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["t", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "\[TildeTilde]", 
   SuperscriptBox[GridBox[{
      {
       SubscriptBox[
        StyleBox["V", "TI"], 
        StyleBox[
         RowBox[{"f", "i"}], "TI"]]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   FractionBox[
    SuperscriptBox[
     StyleBox["t", "TI"], "2"], "4"], " ", 
   SuperscriptBox[
    StyleBox["sinc",
     FontSlant->"Plain"], "2"], 
   FractionBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Omega]", "TI"], 
       StyleBox[
        RowBox[{"f", "i"}], "TI"]], "-", 
      StyleBox["\[Omega]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["t", "TI"]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17ef34d3-7569-45ab-847c-01142f2d973e"],
 ", sharply peaked at the resonance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox[
     RowBox[{"f", "i"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59aa8897-b649-4477-b1aa-c29805ee784f"],
 "."
}], "Text",ExpressionUUID->"25935079-aa9c-4304-9bf8-8c820754c470"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : do the amplitude integral, keep the resonant (",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{
    StyleBox["i", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox[
       RowBox[{"f", "i"}], "TI"]], "-", 
     StyleBox["\[Omega]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    SuperscriptBox[
     StyleBox["t", "TI"], "\[Prime]"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc41b223-416f-41c5-9b5b-8f75a5af6d96"],
 ") term, and read the probability near resonance."
}], "Text",ExpressionUUID->"2d130283-ecf4-431f-9823-55e9acafbd61"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalDelta]", " ", "=", " ", 
      RowBox[{"\[Omega]fi", " ", "-", " ", "\[Omega]"}]}], ",", " ", 
     RowBox[{"amp", " ", "=", " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", 
           RowBox[{"(", 
            RowBox[{"\[Omega]fi", " ", "-", " ", "\[Omega]"}], ")"}], " ", 
           "t2"}], "]"}], "/", "2"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t2", ",", " ", "0", ",", " ", "t"}], "}"}]}], "]"}]}]}], 
    "}"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", "Vfi", "]"}], "^", "2"}], " ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"ComplexExpand", "[", 
       RowBox[{"amp", " ", 
        RowBox[{"Conjugate", "[", "amp", "]"}]}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", " ", "t"}], "}"}], " ", "\[Element]", 
       " ", "Reals"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"ee1260a7-d649-459a-808d-3eb8c70e7050"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the matrix element ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox[
     RowBox[{"f", "i"}], "TI"]], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["f", "TI"]},
     "Bra"], 
    StyleBox["V", "TI"], 
    TemplateBox[{
      StyleBox["i", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d68c27bb-cc98-4897-aa33-710258bc28bd"],
 " that sets the strength, here for a ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["V", "TI"], "^"], "=", 
   StyleBox["v", "TI"], " ", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63bbd290-a482-43e3-b9ea-03c18f8f3285"],
 " coupling between the two levels ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0"},
    "Ket"], ",", 
   TemplateBox[{"1"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e984ee42-e599-47f9-b5c9-0f53bfe7903e"],
 ", via the object sandwich."
}], "Text",ExpressionUUID->"cd483f2c-efb7-4220-aeec-a7ccbdb0fedf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}], "[", "\"\<Dagger\>\"", 
     "]"}], " ", "@", " ", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"v", " ", "\"\<X\>\""}], "]"}], " ", "@", " ", 
     RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}]}]}], ")"}], 
  "[", "\"\<Scalar\>\"", "]"}]], "Input",
 CellLabel->
  "In[27]:= ",ExpressionUUID->"3fa2dc14-cb4a-4f81-8f48-b33d8ca1b18b"],

Cell[TextData[{
 "The probability grows as ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       SubscriptBox[
        StyleBox["V", "TI"], 
        StyleBox[
         RowBox[{"f", "i"}], "TI"]]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   FractionBox[
    SuperscriptBox[
     StyleBox["t", "TI"], "2"], "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5c72bd4-d699-4533-8a97-9f0cb956342c"],
 " exactly on resonance and is throttled off it by the ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["sinc",
    FontSlant->"Plain"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47e1ba33-6123-482f-a32d-7510e6e6116f"],
 " factor whose central lobe narrows as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7aa4f53-44b5-4d4e-b14e-6caa91410e12"],
 ": as time passes the response concentrates ever more sharply on states with \
",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["f", "TI"]], "-", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["i", "TI"]], "=", 
   StyleBox["\[Omega]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ea8cb4a-c647-400b-8745-86e78c506a2c"],
 ", the seed of energy conservation."
}], "Text",ExpressionUUID->"bd45c9dd-643b-480c-a101-53235d2c7c94"],

Cell[TextData[{
 "7.9b [MSc] How do I recover Fermi's golden rule rate ",
 Cell[BoxData[
  RowBox[{"\[CapitalGamma]", "=", "2", "\[Pi]", 
   SuperscriptBox[GridBox[{
      {
       SubscriptBox[
        StyleBox["V", "TI"], 
        StyleBox[
         RowBox[{"f", "i"}], "TI"]]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["f", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4973dfe-7b16-4412-9dc2-183ceabdf09d"],
 " from a finite dense band of final states in the dense-band limit?"
}], "Subsection",ExpressionUUID->"2f77719e-d62a-4208-9843-1e113b1147db"],

Cell[TextData[{
 "Fermi's golden rule is the golden-rule ",
 StyleBox["rate", "TI"],
 ": for a coupling of strength ",
 Cell[BoxData[GridBox[{
    {
     SubscriptBox[
      StyleBox["V", "TI"], 
      StyleBox[
       RowBox[{"f", "i"}], "TI"]]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7ddd711-c34d-4ac4-97a0-34439adfc00b"],
 " switched on at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87182828-a0af-4637-9c21-9fcc4ab2977b"],
 ", each final state at detuning ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", "=", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["f", "TI"]], "-", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d858f202-b9e4-4180-b57c-717cbc7f8b5f"],
 " receives probability ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       SubscriptBox[
        StyleBox["V", "TI"], 
        StyleBox[
         RowBox[{"f", "i"}], "TI"]]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"], " ", 
   SuperscriptBox[
    StyleBox["sinc",
     FontSlant->"Plain"], "2"], 
   FractionBox[
    RowBox[{"\[CapitalDelta]", 
     StyleBox["t", "TI"]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42018974-1a36-4a6b-a76a-79ad5bd59912"],
 " (the constant-coupling companion of 7.9a's periodic line shape). When the \
single final state is replaced by a dense band with density of states ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["f", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d85a1a9-f432-48b0-83f4-b7d0b7928a9b"],
 ", the summed probability grows ",
 StyleBox["linearly", "TI"],
 " in time, its slope the golden-rule rate ",
 Cell[BoxData[
  RowBox[{"\[CapitalGamma]", "=", "2", "\[Pi]", 
   SuperscriptBox[GridBox[{
      {
       SubscriptBox[
        StyleBox["V", "TI"], 
        StyleBox[
         RowBox[{"f", "i"}], "TI"]]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["f", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d90af4c-e296-4cf9-b37d-55a7ddebf5e8"],
 ". This is a continuum limit, so it is shown here on a finite but dense \
band, watching ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["tot",
     FontSlant->"Plain"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e225d5d-aaf5-49ea-82e3-2016ce44e6bc"],
 " approach the golden-rule value as the band is refined."
}], "Text",ExpressionUUID->"e6d2dcbd-48c5-4963-800f-de7774811a64"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : lay a dense band of final energies around resonance, sum the ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["sinc",
    FontSlant->"Plain"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c5973b5-eba2-475f-8f83-bc44a846f4d4"],
 " probabilities, and compare ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["tot",
     FontSlant->"Plain"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e57f8dc-b4a8-4a21-85ad-e415feb8cb82"],
 " to ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]", 
   SuperscriptBox[GridBox[{
      {
       SubscriptBox[
        StyleBox["V", "TI"], 
        StyleBox[
         RowBox[{"f", "i"}], "TI"]]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d9371001-8027-43cd-99db-11248e98a9d0"],
 "."
}], "Text",ExpressionUUID->"a9fe6b3c-b280-48e0-81cb-ec00d4a1eda0"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Vfi", " ", "=", " ", "0.1"}], ",", " ", 
     RowBox[{"\[Rho]", " ", "=", " ", "40"}], ",", " ", 
     RowBox[{"tval", " ", "=", " ", "30"}], ",", " ", 
     RowBox[{"halfwidth", " ", "=", " ", "2."}]}], "}"}], ",", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"levels", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "halfwidth"}], ",", " ", "halfwidth", ",", " ", 
         RowBox[{"1", "/", "\[Rho]"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Ptot", " ", "=", " ", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Vfi", "^", "2"}], " ", 
               RowBox[{"tval", "^", "2"}]}], ")"}], " ", 
             RowBox[{
              RowBox[{"Sinc", "[", 
               RowBox[{"#", " ", 
                RowBox[{"tval", "/", "2"}]}], "]"}], "^", "2"}]}], " ", "&"}],
            " ", "/@", " ", "levels"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Ptot", "/", "tval"}], ",", " ", 
         RowBox[{"2", " ", "Pi", " ", 
          RowBox[{"Vfi", "^", "2"}], " ", "\[Rho]"}]}], "}"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"71ed71d2-aef8-4395-a8ea-5b610a0475da"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the coupling strength ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      SubscriptBox[
       StyleBox["V", "TI"], 
       StyleBox[
        RowBox[{"f", "i"}], "TI"]]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e125da3f-a862-4b28-887e-f414e7847279"],
 " that scales the rate, read from the same matrix element as an object \
sandwich for a ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["V", "TI"], "^"], "=", 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox[
     RowBox[{"f", "i"}], "TI"]], " ", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c6631f8-db9b-4a48-9d30-882f4428cd4f"],
 " coupling."
}], "Text",ExpressionUUID->"80a0523f-6e80-4eb4-a10d-6b10a27b92e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}], "[", "\"\<Dagger\>\"",
        "]"}], " ", "@", " ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"0.1", " ", 
         RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}], " ", "@", " ", 
       RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}]}]}], ")"}], 
    "[", "\"\<Scalar\>\"", "]"}], "]"}], "^", "2"}]], "Input",
 CellLabel->
  "In[29]:= ",ExpressionUUID->"15eb6504-1bc7-41be-a26a-deadae577643"],

Cell[TextData[{
 "The summed probability per unit time lands within a few percent of ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]", 
   SuperscriptBox[GridBox[{
      {
       SubscriptBox[
        StyleBox["V", "TI"], 
        StyleBox[
         RowBox[{"f", "i"}], "TI"]]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c4184f6-a737-4bd7-b2f3-77b9ddced018"],
 ", and the match tightens as the band is made denser and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a954671-c174-4a7c-919f-8cce16157483"],
 " longer: a discrete spectrum of closely spaced levels mimics a continuum, \
and the interference of many near-resonant channels produces the \
irreversible, constant-rate decay that a single level (7.9a) could never show."
}], "Text",ExpressionUUID->"5ee7825e-4f53-48ef-8e2a-e34c12dd20a4"],

Cell[TextData[{
 "7.10a [MSc] How do I find a symmetry operator ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7962e58a-8037-4109-a61d-5f0b5250c48e"],
 " that commutes with ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f988858-39a8-4fdd-9694-3aa3a921dff1"],
 " and use its eigenvalue as a conserved quantum number?"
}], "Subsection",ExpressionUUID->"7725aebf-84a9-4fee-ac35-deb8fb0a9cc4"],

Cell[TextData[{
 "A symmetry is a unitary ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66dd7338-b554-4afd-ad01-93a89f768ac4"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["S", "TI"], ",", 
    OverscriptBox[
     StyleBox["H", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b333cc16-c6b9-4465-995c-f61919e5ec9f"],
 ". Then ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf695e9c-2310-4d9e-87db-b1d19e958382"],
 " and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0ce8dd8-389d-449e-850f-9f0b884d6917"],
 " share eigenstates, ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bbe78ed-e615-4a66-8006-63c84fc1f7a5"],
 " is a constant of the motion (",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    StyleBox["d", "TI"], 
    StyleBox[
     RowBox[{"d", "t"}], "TI"]], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["S", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], ",", 
     StyleBox["S", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b1ed553-8bbe-4e80-b277-a3d333de5615"],
 "), and its eigenvalue labels states by a conserved quantum number. To ",
 StyleBox["find", "TI"],
 " the symmetries of a given ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64964dd1-56a4-437a-8515-7c082d68498b"],
 ", solve the linear condition ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], ",", 
    StyleBox["S", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4699682-1577-4923-919a-5c684c575cf8"],
 " for the unknown operator ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c276e9b0-7499-4511-91d0-7181dbb2a146"],
 ": the commuting operators are exactly the null space of the linear map ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], "\[Function]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b937f6d3-a899-4f07-84e2-bfe54554336f"],
 ", the ",
 StyleBox["commutant", "TI"],
 " of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7ef993d-3513-4cc2-b151-0bc4a4b8b1bf"],
 ". Take the two-spin Heisenberg exchange ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["X", "TI"], "\[CircleTimes]", 
    StyleBox["X", "TI"], "+", 
    StyleBox["Y", "TI"], "\[CircleTimes]", 
    StyleBox["Y", "TI"], "+", 
    StyleBox["Z", "TI"], "\[CircleTimes]", 
    StyleBox["Z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2de6328-c715-41a3-9802-5500162eb44d"],
 "."
}], "Text",ExpressionUUID->"a9e8a1d2-5177-4743-9eff-9a946c67ff01"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : vectorize the commutator map as the matrix ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "\[CircleTimes]", 
   StyleBox["I", "TI"], "-", 
   StyleBox["I", "TI"], "\[CircleTimes]", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "\[UpTee]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d497ad9-96ed-448f-a65f-b7acef60d16b"],
 " and take its null space; each null vector, reshaped to ",
 Cell[BoxData[
  RowBox[{"4", "\[Times]", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e218aa3e-beed-4b62-abf8-3ca5ace1cdad"],
 ", is an operator commuting with ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "649cf0fd-73ab-4e22-bd31-afe0e798f9b9"],
 ". Count the independent symmetries found and confirm they all commute."
}], "Text",ExpressionUUID->"8d7d3c07-22ea-4f38-b4f5-7976f32f680e"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"j", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", 
          RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}], " ", "+", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliMatrix", "[", "2", "]"}], ",", " ", 
          RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}], " ", "+", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", 
          RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}], ")"}]}]}], "}"}],
    ",", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"comm", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"ArrayReshape", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "4"}], "}"}]}], "]"}], " ", "&"}], " ", "/@",
         " ", 
        RowBox[{"NullSpace", "[", 
         RowBox[{
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"h", ",", " ", 
            RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}], " ", "-", " ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "4", "]"}], ",", " ", 
            RowBox[{"Transpose", "[", "h", "]"}]}], "]"}]}], "]"}]}]}], "}"}],
      ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "comm", "]"}], ",", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"comm", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"h", " ", ".", " ", "#"}], " ", "==", " ", 
           RowBox[{"#", " ", ".", " ", "h"}]}], " ", "&"}]}], "]"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[30]:= ",ExpressionUUID->"59987303-9e56-45d9-83a7-befddda27449"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the commutant always contains functions of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb5cb358-277c-474b-b5a3-4299f740cd90"],
 "; the natural ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a4ac381-1ed8-47e5-a5d8-0b3d94e420d2"],
 "-valued one, got by rescaling ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ad5abe7-13aa-4a89-a0f1-615ea6975235"],
 "'s two energy levels ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "+", 
    StyleBox["J", "TI"]}], ",", 
   RowBox[{"-", "3", 
    StyleBox["J", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ae96401-7f1a-476f-96b1-ad996e331c53"],
 " to ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "+", "1"}], ",", 
   RowBox[{"-", "1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a5f4a84-dbd6-4dfb-8cae-36e6ba747e6a"],
 ", is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], "=", 
   FractionBox["1", 
    RowBox[{"2", 
     StyleBox["J", "TI"]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "+", 
    StyleBox["J", "TI"], " ", 
    StyleBox["I", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62680f88-4cd8-4e13-b9b3-4e3f99bacfa1"],
 ". Build it from ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74c975b8-f5e9-42a2-a517-5e3ef9fc76fd"],
 " as a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1d59ff5-3aca-4d3a-b3f6-9309ee3008f0"],
 ": it turns out to be exactly the exchange gate ",
 Cell[BoxData["\"\<SWAP\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c64fcb8-373b-4cfd-b15c-45969f32fcd0"],
 ", and its eigenvalues are the conserved parity."
}], "Text",ExpressionUUID->"ea4a8d2f-0ed0-4e21-bd93-4481a4c0a226"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{
      RowBox[{"j", " ", 
       RowBox[{"QuantumTensorProduct", "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], ",", " ", 
         RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], "]"}]}], " ", "+",
       " ", 
      RowBox[{"j", " ", 
       RowBox[{"QuantumTensorProduct", "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", "\"\<Y\>\"", "]"}], ",", " ", 
         RowBox[{"QuantumOperator", "[", "\"\<Y\>\"", "]"}]}], "]"}]}], " ", "+",
       " ", 
      RowBox[{"j", " ", 
       RowBox[{"QuantumTensorProduct", "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], ",", " ", 
         RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], "]"}]}]}]}], 
    "}"}], ",", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"h", " ", "+", " ", 
          RowBox[{"j", " ", 
           RowBox[{"QuantumOperator", "[", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", "4", "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "j"}], ")"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"s", " ", "==", " ", 
        RowBox[{"QuantumOperator", "[", "\"\<SWAP\>\"", "]"}]}], ",", " ", 
       RowBox[{"s", "[", "\"\<Eigenvalues\>\"", "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[31]:= ",ExpressionUUID->"a96580c9-13d7-477f-9686-590b57d9c489"],

Cell[TextData[{
 "The null space is 10-dimensional: the isotropic Heisenberg coupling has a \
large symmetry algebra, because its ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81da14ee-ccb4-44f8-a374-82bb23805472"],
 " level is threefold degenerate (the triplet) and ",
 StyleBox["any", "TI"],
 " operator acting within that degenerate space commutes with ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6c902da-cd3d-46b0-a54a-bb1fc25ef0d5"],
 ". The physically distinguished member is the exchange operator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], "=", 
   FractionBox["1", 
    RowBox[{"2", 
     StyleBox["J", "TI"]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "+", 
    StyleBox["J", "TI"], " ", 
    StyleBox["I", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["SWAP",
    FontSlant->"Plain"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "065107f2-06d3-40f9-92bd-a26d0ce3e4ac"],
 ", found here as a function of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c832577-80ce-4f83-9b92-bee333f239f4"],
 " rather than guessed; its eigenvalue ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "142fb325-c4ed-4f0d-ae60-6cb6d0d50eca"],
 " (symmetric triplet versus antisymmetric singlet) is the conserved exchange \
parity, exactly what block-diagonalizes ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "565e2bd1-a992-440f-be82-5e3c83dbad44"],
 " into symmetry sectors (7.10b)."
}], "Text",ExpressionUUID->"34e4c670-b635-494c-a3b8-a65b4faee062"],

Cell[TextData[{
 "7.10b [MSc] How do I block-diagonalize ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd098edc-498f-4026-b4b8-8825d196afa6"],
 " into symmetry sectors using the eigenspaces of a commuting symmetry ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c302666-c2c2-4ed3-b598-0f60f01c1b68"],
 "?"
}], "Subsection",ExpressionUUID->"cc0c3b10-9548-4871-8b1e-fdea3e5d8710"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["S", "TI"], ",", 
    OverscriptBox[
     StyleBox["H", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b22f3f66-ea2b-45ed-9c40-9de67231a5a3"],
 ", the eigenspaces of ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b530c52-152c-4f76-a323-5590f58a4baa"],
 " are invariant under ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aac81a2b-911e-4313-b6b7-b7f0cca1c04b"],
 ": in a basis that diagonalizes ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705f8abd-c77b-4654-bdd3-1560cfaf3bfa"],
 ", ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e0cdb38-734f-4234-86f6-6cf412160fd8"],
 " is block-diagonal, one block per eigenvalue of ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dffdd205-4651-42d3-8343-c722eaf47d46"],
 ". Two matrix decompositions produce that basis from ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ad12850-150b-4ab5-9976-a518466039be"],
 ". ",
 Cell[BoxData[
  RowBox[{"EigenvalueDecomposition", "[", "S", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc6a8e2d-8916-4636-9f56-3378937f1962"],
 " gives it ",
 StyleBox["exactly", "TI"],
 " and symbolically (the similarity matrix whose columns are ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a152758-5c21-487a-a5cd-a0f4ba694e02"],
 "'s eigenvectors, grouped by eigenvalue), keeping ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aafc9d69-2515-45fe-95ee-d5d2a68f75c7"],
 " a symbol; ",
 Cell[BoxData[
  RowBox[{"OrderedSchurDecomposition", "[", "S", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4b98fe2-228f-4947-b2a1-e00d9a81f288"],
 " (new in 15.0) gives it ",
 StyleBox["numerically", "TI"],
 " but as a genuine unitary ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a7059ec-4f63-426b-b496-0134021ca625"],
 ", and sorts the basis by the eigenvalue of ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b038ffe-2f70-45a1-bca0-5978a4606b1c"],
 " so the sectors come out grouped. Either way, changing ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbddfa73-3dc4-440f-b6bb-c88457008e22"],
 " into that basis block-diagonalizes it. Continue with the Heisenberg dimer \
and its exchange symmetry ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], "=", 
   FractionBox["1", 
    RowBox[{"2", 
     StyleBox["J", "TI"]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "+", 
    StyleBox["J", "TI"], 
    StyleBox["I", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["SWAP",
    FontSlant->"Plain"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a97e869-361e-497a-9671-37faa92ea769"],
 " from 7.10a (eigenvalue ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb9cd0f6-d993-45fc-b224-538f2d669d35"],
 " for the antisymmetric singlet, ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c484eb53-7107-41ba-a33e-bf78a1803add"],
 " for the symmetric triplet)."
}], "Text",ExpressionUUID->"995995f5-5303-485f-8f5d-1f0b215fb3bc"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the ",
 StyleBox["exact", "TI"],
 " route. Derive ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6e8c2f4-c7b9-4ac9-8c10-d7c28ca459b1"],
 " from ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e49210b8-5de6-492e-b4d7-179eb41c2619"],
 " as in 7.10a, take the eigenbasis similarity matrix from ",
 Cell[BoxData[
  RowBox[{"EigenvalueDecomposition", "[", "S", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aaaabe12-ab52-4d02-9072-f3f6c023ccb6"],
 ", and change ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c48de74-06dd-4f93-b0cd-aad5a5101863"],
 " into it; the block-diagonal form stays symbolic in ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "361be876-26f6-43ea-abc2-34feb0d26776"],
 "."
}], "Text",ExpressionUUID->"52084b89-ce02-4537-b8d1-5839d979f230"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"j", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", 
          RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}], " ", "+", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliMatrix", "[", "2", "]"}], ",", " ", 
          RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}], " ", "+", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", 
          RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}], ")"}]}]}], "}"}],
    ",", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"h", " ", "+", " ", 
           RowBox[{"j", " ", 
            RowBox[{"IdentityMatrix", "[", "4", "]"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "j"}], ")"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sm", " ", "=", " ", 
         RowBox[{"First", "[", 
          RowBox[{"EigenvalueDecomposition", "[", "s", "]"}], "]"}]}], "}"}], 
       ",", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Inverse", "[", "sm", "]"}], " ", ".", " ", "h", " ", ".", 
         " ", "sm"}], "]"}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[32]:= ",ExpressionUUID->"e0e78b83-b15f-4331-a563-629d92432d8c"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the ",
 StyleBox["numeric", "TI"],
 " route at the operator level. Take the ordered Schur basis ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32878688-9701-4723-bae1-0c080c31b898"],
 " of ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e928e87b-c6cb-42dc-a0f5-a0dda8d73aed"],
 " (sorted by increasing eigenvalue, singlet first), wrap it as a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5275c60b-6bbe-499d-a421-d57cfe150301"],
 " ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32474c7c-3d46-4c09-be5d-1ed57e8fd58a"],
 ", and conjugate; ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   SuperscriptBox[
    StyleBox["W", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e636fcce-6c11-4618-a822-ac44dbadc790"],
 " reproduces the exact block-diagonal to machine precision."
}], "Text",ExpressionUUID->"7962e14d-809b-4e95-b8c2-a60f35fea4a3"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{
      RowBox[{"j", " ", 
       RowBox[{"QuantumTensorProduct", "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], ",", " ", 
         RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], "]"}]}], " ", "+",
       " ", 
      RowBox[{"j", " ", 
       RowBox[{"QuantumTensorProduct", "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", "\"\<Y\>\"", "]"}], ",", " ", 
         RowBox[{"QuantumOperator", "[", "\"\<Y\>\"", "]"}]}], "]"}]}], " ", "+",
       " ", 
      RowBox[{"j", " ", 
       RowBox[{"QuantumTensorProduct", "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], ",", " ", 
         RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], "]"}]}]}]}], 
    "}"}], ",", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"h", " ", "+", " ", 
           RowBox[{"j", " ", 
            RowBox[{"QuantumOperator", "[", 
             RowBox[{
              RowBox[{"IdentityMatrix", "[", "4", "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "j"}], ")"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"w", " ", "=", " ", 
         RowBox[{"QuantumOperator", "[", 
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", 
            RowBox[{"First", "[", 
             RowBox[{"OrderedSchurDecomposition", "[", 
              RowBox[{
               RowBox[{"N", "[", 
                RowBox[{"Normal", "[", 
                 RowBox[{"s", "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}], ",",
                " ", "\"\<IncreasingRe\>\"", ",", " ", 
               RowBox[{"TargetStructure", " ", "->", " ", "\"\<Dense\>\""}]}],
               "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"Chop", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"w", " ", "@", " ", 
            RowBox[{"h", " ", "@", " ", 
             RowBox[{"w", "[", "\"\<Dagger\>\"", "]"}]}]}], ")"}], 
          "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[33]:= ",ExpressionUUID->"15b85e08-b04a-485d-9786-a90c7ba5fcc6"],

Cell[TextData[{
 "Both give the same block-diagonal ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aa31b41-f719-482c-aaab-9506f01d132a"],
 ": a ",
 Cell[BoxData[
  RowBox[{"1", "\[Times]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a0f58bb-be2b-45bb-b011-e5802de19ee4"],
 " singlet block at energy ",
 Cell[BoxData[
  RowBox[{"-", "3", 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed2362c7-7195-4581-a14a-d0b104f2e19a"],
 " and a ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3bda197-e8cb-4f3a-942e-aab047d41677"],
 " triplet block at ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aaf73283-6186-4974-80b7-b1f98d56ed0f"],
 ", so a ",
 Cell[BoxData[
  RowBox[{"4", "\[Times]", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed80083e-de63-4a9b-bd03-256277c2ed98"],
 " diagonalization has become two independent, smaller ones. The exact ",
 Cell[BoxData["EigenvalueDecomposition"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7044166-f40b-4ba1-9ed3-6e99f3490fcd"],
 " keeps ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bc7ce5e-ebbc-4036-9920-7f3757172c78"],
 " symbolic; the numeric ",
 Cell[BoxData["OrderedSchurDecomposition"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb3f2eb-a0a9-4fb9-adde-35db14bb4e2f"],
 " reproduces it to machine precision but adds the guarantees of a ",
 StyleBox["unitary", "TI"],
 " basis and a built-in sector sort. Either way the sector-grouped basis \
comes straight from the symmetry, with no by-hand eigenvector bookkeeping, \
which is why exploiting symmetry is the first move in any serious many-body \
calculation."
}], "Text",ExpressionUUID->"f2a0c439-75f4-4690-a913-4c60cf3487e4"],

Cell[TextData[{
 "7.11 [MSc] How do I implement a Trotter-Suzuki decomposition to simulate ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    OverscriptBox[
     StyleBox["H", "TI"], "^"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc04c788-ff98-414a-ae9d-8dab03313345"],
 " for a sum of noncommuting terms?"
}], "Subsection",ExpressionUUID->"ff8ee885-618c-4560-a791-980c2dfbd21c"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   StyleBox["A", "TI"], "+", 
   StyleBox["B", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c3eec7d-9709-48fa-ae53-1c08712f64b4"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["A", "TI"], ",", 
    StyleBox["B", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "\[NotEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b622353-5f3b-47bd-b934-9eb0ea91d81c"],
 ", the exponential does not factor, but the first-order Trotter-Suzuki \
formula approximates it by many small alternating steps, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["A", "TI"], "+", 
      StyleBox["B", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["t", "TI"]}]], "\[TildeTilde]", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["A", "TI"], 
     StyleBox["t", "TI"], "/", 
     StyleBox["n", "TI"]}]], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["B", "TI"], 
     StyleBox["t", "TI"], "/", 
     StyleBox["n", "TI"]}]], 
   SuperscriptBox[
    StyleBox[")",
     FontSize->1.2 Inherited], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5de8ee1-e98e-457b-ae3d-f15920465ba3"],
 ", with an error that falls as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88594a76-7b53-4d82-aae5-10f1b27dfe95"],
 ". Take the noncommuting pair ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24beffc6-f8c6-4b65-a9a1-4759d4b6eeee"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], "=", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4bf2de5-913f-45ca-b622-75b998478140"],
 "."
}], "Text",ExpressionUUID->"b59bcba2-6d1a-4337-800d-66d6d5dad231"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : compare the exact propagator with the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75f2653e-fafe-4cdc-a0c8-6948c751e32c"],
 "-step Trotter product and measure the error as ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66d7ab5a-467d-4e83-8029-92e394524aae"],
 " grows."
}], "Text",ExpressionUUID->"db4bab04-3811-4de0-84d6-38ee41e7ec04"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"PauliMatrix", "[", "1", "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}], ",", " ", 
     RowBox[{"tval", " ", "=", " ", "1."}]}], "}"}], ",", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{"a", " ", "+", " ", "b"}], ")"}], " ", "tval"}], "]"}], 
        " ", "-", " ", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"MatrixExp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", "a", " ", 
             RowBox[{"tval", "/", "n"}]}], "]"}], " ", ".", " ", 
           RowBox[{"MatrixExp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", "b", " ", 
             RowBox[{"tval", "/", "n"}]}], "]"}]}], ",", " ", "n"}], "]"}]}], 
       ",", " ", "\"\<Frobenius\>\""}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "2", ",", " ", "5", ",", " ", "20", ",", " ", "100"}], 
        "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[34]:= ",ExpressionUUID->"c44a6806-9c18-4086-98be-c34c9c5794d0"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the paclet's named ",
 Cell[BoxData["\"\<Trotterization\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d165091-968d-4533-984b-d5e9c9e3fd30"],
 " circuit builds the same alternating sequence directly from the term list; \
its overall operator approaches the exact propagator."
}], "Text",ExpressionUUID->"c86a3dc2-fd92-461a-9bbe-feffe7c276b6"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tval", " ", "=", " ", "1."}], "}"}], ",", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"PauliMatrix", "[", "1", "]"}], " ", "+", " ", 
            RowBox[{"PauliMatrix", "[", "3", "]"}]}], ")"}], " ", "tval"}], 
         "]"}], " ", "-", " ", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"QuantumCircuitOperator", "[", 
            RowBox[{"\"\<Trotterization\>\"", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], ",", " ", 
                
                RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], "}"}], ",",
               " ", "1", ",", " ", "n", ",", " ", "tval"}], "]"}], "]"}], 
           "[", "\"\<QuantumOperator\>\"", "]"}], "[", "\"\<Matrix\>\"", 
          "]"}], "]"}]}], ",", " ", "\"\<Frobenius\>\""}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "2", ",", " ", "5", ",", " ", "20", ",", " ", "100"}], 
        "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[35]:= ",ExpressionUUID->"d8cb0944-bc75-498a-ae42-1ae78919f2cc"],

Cell[TextData[{
 "Both error sequences decrease toward zero as ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a63560ba-2b83-4058-bec0-074e17bc7b22"],
 " increases, and the WL product and the QF circuit track each other: \
splitting the evolution into fine slices lets a quantum simulator build ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    OverscriptBox[
     StyleBox["H", "TI"], "^"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebc643b3-12a9-4112-8329-256736398a6f"],
 " from elementary gates for each term, the workhorse of digital Hamiltonian \
simulation, at the cost of a controllable Trotter error set by the terms' \
noncommutativity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["A", "TI"], ",", 
    StyleBox["B", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6145ce94-3e08-4f14-b7b6-5b2a17b26fec"],
 "."
}], "Text",ExpressionUUID->"612c0217-b1d6-4862-9c1b-8d7574a9818a"],

Cell["\<\
7.12 [MSc] How do I verify the adiabatic theorem's gap and rate condition \
(the transition probability vanishing when the sweep is slow compared to the \
inverse gap squared)?\
\>", "Subsection",ExpressionUUID->"85cb219f-258b-4358-8032-bd65c307b03c"],

Cell[TextData[{
 "The adiabatic theorem says a system stays in an instantaneous eigenstate if \
the Hamiltonian changes slowly compared to the square of its spectral gap. \
The clean finite-dimensional test is a Landau-Zener sweep, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "\[CapitalDelta]", " ", 
   StyleBox["X", "TI"], "+", 
   StyleBox["v", "TI"], 
   StyleBox["t", "TI"], " ", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4c5753e-0315-4c91-a53b-c5c5cdd895ee"],
 ": start in the ground state at large negative ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9882ce1f-fe0e-4cec-a83f-8724afddebfd"],
 " and measure the excited-state population at large positive ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "299f7a68-f29f-4472-9f86-ab6599ae7b47"],
 "; the Landau-Zener formula predicts ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["exc",
     FontSlant->"Plain"]], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "\[Pi]", 
     SuperscriptBox["\[CapitalDelta]", "2"], "/", 
     StyleBox["v", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c3a93b8-5de8-43cc-b986-2925b41dfdf6"],
 ", which vanishes as the sweep rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3e240a8-a059-43f7-915e-b02e7869d3d6"],
 " (slow) and the gap ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8b2d52c-d27e-4ef0-a74d-9b92d5a45a6e"],
 " grows."
}], "Text",ExpressionUUID->"552bafe9-cb47-43ce-9aa0-369fffda81cd"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : integrate the time-dependent Schrodinger equation across the crossing \
with ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "271628fe-3980-4a49-9832-c94ae512f82b"],
 " for a few sweep rates, and compare the final excited population with the \
Landau-Zener prediction."
}], "Text",ExpressionUUID->"0bbe4b4a-96bb-4719-9ccb-27be06fd94ad"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalDelta]", " ", "=", " ", "1."}], ",", " ", 
     RowBox[{"T", " ", "=", " ", "40."}]}], "}"}], ",", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ground", " ", "=", " ", 
          RowBox[{"Normalize", "[", 
           RowBox[{
            RowBox[{"First", "[", 
             RowBox[{"SortBy", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", 
                RowBox[{"Eigensystem", "[", 
                 RowBox[{
                  RowBox[{"\[CapitalDelta]", " ", 
                   RowBox[{"PauliMatrix", "[", "1", "]"}]}], " ", "-", " ", 
                  RowBox[{"v", " ", "T", " ", 
                   RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], "]"}], "]"}], ",",
                " ", "First"}], "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", " ", 
         RowBox[{"excited", " ", "=", " ", 
          RowBox[{"Normalize", "[", 
           RowBox[{
            RowBox[{"Last", "[", 
             RowBox[{"SortBy", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", 
                RowBox[{"Eigensystem", "[", 
                 RowBox[{
                  RowBox[{"\[CapitalDelta]", " ", 
                   RowBox[{"PauliMatrix", "[", "1", "]"}]}], " ", "+", " ", 
                  RowBox[{"v", " ", "T", " ", 
                   RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], "]"}], "]"}], ",",
                " ", "First"}], "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sol", " ", "=", " ", 
           RowBox[{"NDSolveValue", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"I", " ", 
                 RowBox[{
                  RowBox[{"\[Psi]", "'"}], "[", "t", "]"}]}], " ", "==", " ", 
                
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"\[CapitalDelta]", " ", 
                    RowBox[{"PauliMatrix", "[", "1", "]"}]}], " ", "+", " ", 
                   RowBox[{"v", " ", "t", " ", 
                    RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], ")"}], " ", ".",
                  " ", 
                 RowBox[{"\[Psi]", "[", "t", "]"}]}]}], ",", " ", 
               RowBox[{
                RowBox[{"\[Psi]", "[", 
                 RowBox[{"-", "T"}], "]"}], " ", "==", " ", "ground"}]}], 
              "}"}], ",", " ", "\[Psi]", ",", " ", 
             RowBox[{"{", 
              RowBox[{"t", ",", " ", 
               RowBox[{"-", "T"}], ",", " ", "T"}], "}"}]}], "]"}]}], "}"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Conjugate", "[", "excited", "]"}], " ", ".", " ", 
              RowBox[{"sol", "[", "T", "]"}]}], "]"}], "^", "2"}], ",", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "Pi"}], " ", 
             RowBox[{
              RowBox[{"\[CapitalDelta]", "^", "2"}], "/", "v"}]}], "]"}]}], 
          "}"}]}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"v", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2.", ",", " ", "1.", ",", " ", "0.5"}], "}"}]}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[36]:= ",ExpressionUUID->"dd3d0f46-618b-4a40-a0ec-a55c858a6f89"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the instantaneous gap that controls the sweep, the difference of the two \
eigenvalues of ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ce0e07e-e5b4-45e1-8e46-2d89f41d7e60"],
 ", read from a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aaae27a-3986-417e-b58d-2191ce74d275"],
 " at the crossing ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14d0b6fb-bf0f-4710-8850-01922367cf4f"],
 " where it is smallest."
}], "Text",ExpressionUUID->"d66d2270-4cdc-40bd-9378-fcaa2d757387"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[CapitalDelta]", " ", "=", " ", "1."}], "}"}], ",", " ", 
   RowBox[{"Differences", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\[CapitalDelta]", " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}], 
     "[", "\"\<Eigenvalues\>\"", "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[37]:= ",ExpressionUUID->"53c28429-4d3c-4405-92ba-c8d3edfe345a"],

Cell[TextData[{
 "As the sweep slows the measured excited population drops toward zero and \
tracks ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "\[Pi]", 
    SuperscriptBox["\[CapitalDelta]", "2"], "/", 
    StyleBox["v", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3347f8a-e9b8-472f-99e6-696400c967b9"],
 ": the crossing is traversed adiabatically when the time spent near the \
minimum gap ",
 Cell[BoxData[
  RowBox[{"2", "\[CapitalDelta]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "202eb65a-bc30-4e3f-9a2e-7e6372b48e8f"],
 " is long compared to ",
 Cell[BoxData[
  RowBox[{"1", "/", "\[CapitalDelta]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "851b71bb-c3ec-419a-8131-90e41c3e69bf"],
 ", so a larger gap or a slower sweep both protect the ground state, the \
principle behind adiabatic quantum computation."
}], "Text",ExpressionUUID->"feaa4d7d-111f-4233-b225-968fc0638ec8"],

Cell[TextData[{
 "7.13 [MSc] How do I compute Berry's geometric phase around a closed loop as \
the discrete Bargmann invariant ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   RowBox[{
    RowBox[{"-", 
     StyleBox["arg",
      FontSlant->"Plain"]}], 
    RowBox[{
     UnderscriptBox["\[Product]", 
      StyleBox["k", "TI"],
      LimitsPositioning->False], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], 
        StyleBox["k", "TI"]], 
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], 
        RowBox[{
          StyleBox["k", "TI"], "+", "1"}]]},
      "BraKet"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1c19be0-0ede-425f-93bf-6305cc0b00d5"],
 "?"
}], "Subsection",ExpressionUUID->"e0205cf1-3623-448a-a11d-833b9db2e9f7"],

Cell[TextData[{
 "Berry's phase is the geometric (basis- and gauge-independent) phase a state \
acquires around a closed loop in parameter space, over and above the \
dynamical phase. Discretized, it is the Bargmann invariant ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   RowBox[{
    RowBox[{"-", 
     StyleBox["arg",
      FontSlant->"Plain"]}], 
    RowBox[{
     UnderscriptBox["\[Product]", 
      StyleBox["k", "TI"],
      LimitsPositioning->False], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], 
        StyleBox["k", "TI"]], 
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], 
        RowBox[{
          StyleBox["k", "TI"], "+", "1"}]]},
      "BraKet"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37893d6d-0589-47e0-9f06-c219ba55bfe1"],
 " over a closed chain ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], 
      StyleBox["N", "TI"]]},
    "Ket"], "\[Congruent]", 
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], "0"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8259d085-3c43-4493-84af-8283c2d3a660"],
 ", which needs no derivative or gauge choice. For a spin-1/2 following the \
ground state of ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["s", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87b7a647-611b-46ca-a65c-6e5077261edd"],
 " as ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41dffa79-a363-41c8-bb8d-a33ac9bad2e6"],
 " traces a cone of half-angle ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2eafc13-499c-4790-9a96-fe2d203aae6e"],
 ", the Berry phase is minus half the enclosed solid angle, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "-", "\[Pi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Chi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ba35b7c2-22fb-43fb-a5da-db4007cd0f2b"],
 "."
}], "Text",ExpressionUUID->"95fefaa1-e27b-41f9-bfef-90405a3cc8cf"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : place ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc22f473-6f82-4f39-a16e-034fdef8152c"],
 " spin-down states around the cone, form the ordered product of \
nearest-neighbour overlaps, and take minus its argument; compare with ",
 Cell[BoxData[
  RowBox[{"-", "\[Pi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Chi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b9752728-d522-42f9-b912-31085b087c41"],
 "."
}], "Text",ExpressionUUID->"fcb25c95-022e-4adb-96a3-47cf01aa5514"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Chi]", " ", "=", " ", 
      RowBox[{"Pi", "/", "3"}]}], ",", " ", 
     RowBox[{"n", " ", "=", " ", "200"}]}], "}"}], ",", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"states", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"\[Chi]", "/", "2"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "2", " ", "Pi", " ", 
              RowBox[{"k", "/", "n"}]}], "]"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Chi]", "/", "2"}], "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Total", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Arg", "[", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"Conjugate", "[", 
               RowBox[{"states", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "]"}], " ", ".", " ", 
              RowBox[{"states", "[", 
               RowBox[{"[", 
                RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}]}], "]"}], 
            "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "n"}], "}"}]}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"-", "Pi"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"Cos", "[", "\[Chi]", "]"}]}], ")"}]}], "]"}]}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[38]:= ",ExpressionUUID->"ee550771-2c45-4cfe-9407-8711106b2d6f"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same loop with the overlaps taken as object inner products ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox[
     StyleBox["\[Psi]", "TI"], 
     StyleBox["k", "TI"]], 
    SubscriptBox[
     StyleBox["\[Psi]", "TI"], 
     RowBox[{
       StyleBox["k", "TI"], "+", "1"}]]},
   "BraKet"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc9f432c-cd25-461a-9959-858db1061e9c"],
 " through ",
 Cell[BoxData["QuantumState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c8f31b6-7bde-4145-b3e4-3f4da2009e57"],
 ", ",
 Cell[BoxData["\"\<Dagger\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efa99d6c-3bf6-416e-bb08-9c407e8b875f"],
 ", and ",
 Cell[BoxData["\"\<Scalar\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee0d7efa-da09-4f2a-a0ff-1ed6a91b7aca"],
 "."
}], "Text",ExpressionUUID->"d238e21d-6036-49e5-9c87-8af203cc29f2"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Chi]", " ", "=", " ", 
      RowBox[{"Pi", "/", "3"}]}], ",", " ", 
     RowBox[{"n", " ", "=", " ", "200"}]}], "}"}], ",", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"states", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"QuantumState", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", 
             RowBox[{"\[Chi]", "/", "2"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "2", " ", "Pi", " ", 
               RowBox[{"k", "/", "n"}]}], "]"}], " ", 
             RowBox[{"Sin", "[", 
              RowBox[{"\[Chi]", "/", "2"}], "]"}]}]}], "}"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"-", 
      RowBox[{"Total", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Arg", "[", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"states", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<Dagger\>\"", "]"}], 
              " ", "@", " ", 
              RowBox[{"states", "[", 
               RowBox[{"[", 
                RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}]}], ")"}], 
            "[", "\"\<Scalar\>\"", "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "n"}], "}"}]}], "]"}], "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[39]:= ",ExpressionUUID->"8b34b8c1-54ca-4c7e-935a-4f602374c35f"],

Cell[TextData[{
 "Both return ",
 Cell[BoxData[
  RowBox[{"-", "\[Pi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    FractionBox["\[Pi]", "3"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   FractionBox["\[Pi]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65b787cf-d400-43ff-9f1f-c7c6e96bf9aa"],
 ": the accumulated phase depends only on the ",
 StyleBox["geometry", "TI"],
 " of the loop (the solid angle it subtends), not on how fast or by what \
schedule it is traversed, which is what makes Berry's phase observable and \
robust."
}], "Text",ExpressionUUID->"bc5449f3-dec7-4872-b892-2bbb77cce342"],

Cell["\<\
7.14 [MSc] How do I simulate a quantum quench and compute the Loschmidt echo?\
\
\>", "Subsection",ExpressionUUID->"8798c6b0-3827-446d-9eb3-3c6ae9091689"],

Cell[TextData[{
 "A quench prepares the ground state of one Hamiltonian and then suddenly \
evolves it under a different one. The Loschmidt echo ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["L", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        TemplateBox[{
          SubscriptBox[
           StyleBox["\[Psi]", "TI"], "0"]},
         "Bra"], 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"-", 
          StyleBox["i", "TI"], 
          SubscriptBox[
           OverscriptBox[
            StyleBox["H", "TI"], "^"], "1"], 
          StyleBox["t", "TI"]}]], 
        TemplateBox[{
          SubscriptBox[
           StyleBox["\[Psi]", "TI"], "0"]},
         "Ket"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d00825e-a58d-4874-9622-b68163356da4"],
 " measures how fast the state runs away from its start, a diagnostic of the \
quench strength. Prepare the ground state ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fc3e9bc-3090-4cc8-af11-363c47fbb283"],
 " of ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "0"], "=", 
   FractionBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4cfc53a-11d6-41bd-97a0-08dd33846ae9"],
 " (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d35c089e-79b6-4ce2-9d59-9acc82ebfb4f"],
 ") and quench to ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "1"], "=", 
   FractionBox["\[CapitalOmega]", "2"], 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62297076-2836-4293-a787-6590a3b6bbd2"],
 "."
}], "Text",ExpressionUUID->"fa6c1b1b-e575-46ba-8516-bec33f1d23e0"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : evolve ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2976b8b6-5668-4fc9-9967-f8da9705983a"],
 " under ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9643c718-40ad-480d-9818-ced89b978fd2"],
 " and take the modulus-squared overlap with ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f43823e3-4699-41d7-b542-ded0d83d429d"],
 "."
}], "Text",ExpressionUUID->"5c1d980a-9a80-4160-91d0-50d8616ced31"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Psi]0", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"Conjugate", "[", "\[Psi]0", "]"}], " ", ".", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"MatrixExp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{"(", 
             RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", 
            RowBox[{"PauliMatrix", "[", "1", "]"}], " ", "t"}], "]"}], " ", ".",
           " ", "\[Psi]0"}], ")"}]}], "]"}], "^", "2"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[CapitalOmega]", ",", " ", "t"}], "}"}], " ", "\[Element]", 
      " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[40]:= ",ExpressionUUID->"8ac02a0a-b8c4-4704-ab92-07c14ca07443"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : evolve the named ",
 Cell[BoxData["\"\<1\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8dcaa0e0-e889-46d1-96cf-e869f078729a"],
 " state under ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4300f2fe-871e-4232-b187-18d1e7c25c74"],
 " with ",
 Cell[BoxData["QuantumEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f9501c2-b83a-4726-b1d6-b784165b8ace"],
 " and take its overlap with the start through the object sandwich."
}], "Text",ExpressionUUID->"69c2df0d-5baf-4a2f-bff3-3694cbe2eda7"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qs0", " ", "=", " ", 
     RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}]}], "}"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"qs0", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
          RowBox[{"QuantumEvolve", "[", 
           RowBox[{
            RowBox[{"QuantumOperator", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", 
              RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}], ",", " ", 
            RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}], ",", " ", "t"}], 
           "]"}]}], ")"}], "[", "\"\<Scalar\>\"", "]"}], "]"}], "^", "2"}], ",",
      " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[CapitalOmega]", ",", " ", "t"}], "}"}], " ", "\[Element]", 
      " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[41]:= ",ExpressionUUID->"5aa8e989-f06b-4d7f-852c-ba45f632c0d5"],

Cell[TextData[{
 "Both give ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{"\[CapitalOmega]", 
     StyleBox["t", "TI"]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9514c3e-d08b-4895-b4a8-3ed0b2f2df50"],
 ": the echo dips from ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55798195-f5e8-41e4-99c8-0d051d81981d"],
 " as the state explores the new Hamiltonian and revives fully at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "2", "\[Pi]", "/", "\[CapitalOmega]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107a1cb0-358f-4d2a-95cb-5f19683a8928"],
 " because a single qubit has only one Bohr frequency; in a many-body system \
the many incommensurate frequencies would make the echo decay and \
(generically) never fully revive."
}], "Text",ExpressionUUID->"ae27dbba-cf3f-4be4-bce5-3c04060813c8"],

Cell["\<\
7.15 [MSc] How do I exhibit the quantum Zeno effect, freezing evolution under \
a Hamiltonian by frequent projective measurement?\
\>", "Subsection",ExpressionUUID->"ef648b62-8093-477b-b13d-763a36e2fe9b"],

Cell[TextData[{
 "The quantum Zeno effect freezes a state by watching it: under ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e232775f-dc94-4627-837b-49b0eab7579a"],
 ", the survival probability after a short time ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f97c56c-63e5-4632-b8cd-6e7f7fa48d84"],
 " is ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Tau]", "TI"], "2"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dfb90b7d-393d-4b95-b95b-4e141be7a152"],
 ", so ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b2aaebf-7010-4c12-b364-6fd8aaf7e56b"],
 " measurements spaced ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Tau]", "TI"], "=", 
   StyleBox["t", "TI"], "/", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e32a5ae-e0e0-4e45-98b3-9abed2c521d9"],
 " apart give a total survival ",
 Cell[BoxData[
  RowBox[{"\[TildeTilde]", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["O", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SuperscriptBox[
        StyleBox["t", "TI"], "2"], "/", 
       SuperscriptBox[
        StyleBox["n", "TI"], "2"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["n", "TI"]], "\[Rule]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f9eb214-5bfb-4d1b-8a43-9ff6ce6dd0a7"],
 " as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[Rule]", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4be5d419-5969-42b9-9934-db5976d073ec"],
 ". Take ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   FractionBox["\[CapitalOmega]", "2"], 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e556dd55-1ed8-4bfb-9b8c-688ed2efc8ec"],
 " evolving ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24d50c48-9c04-4e82-b70f-2ac23c0ae36d"],
 " (which without measurement Rabi-flops to ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d566ae4c-1032-4ff5-add7-9d35be2ee14b"],
 "), and interleave projective ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a77d760-4c0a-40a3-bd00-d408f4581045"],
 " measurements."
}], "Text",ExpressionUUID->"e3b2f591-467d-4f93-8880-ded9e190e793"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : after each short evolution project back with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], "0"], "=", 
   RowBox[{
    TemplateBox[{"0"},
     "Ket"], 
    TemplateBox[{"0"},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a40c1a0-e168-4857-a520-661627ff61be"],
 "; the surviving amplitude is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["P", "TI"], "0"], 
      StyleBox["U", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Tau]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["n", "TI"]], 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf8da558-e423-445c-a50e-75b88aeb58d2"],
 ", and its norm-squared is the survival probability. Watch it rise toward ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae7793ba-11d7-4784-bf7c-e5b6253011b4"],
 "."
}], "Text",ExpressionUUID->"5c47638d-31c3-4c0b-adc4-f39672e47113"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalOmega]", " ", "=", " ", "1."}], ",", " ", 
     RowBox[{"ttot", " ", "=", " ", "Pi"}], ",", " ", 
     RowBox[{"p0", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}]}], "}"}], ",", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{"MatrixPower", "[", 
         RowBox[{
          RowBox[{"p0", " ", ".", " ", 
           RowBox[{"MatrixExp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", 
             RowBox[{"(", 
              RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", 
             RowBox[{"PauliMatrix", "[", "1", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"ttot", "/", "n"}], ")"}]}], "]"}]}], ",", " ", "n"}], 
         "]"}], " ", ".", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}], "^", "2"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "2", ",", " ", "5", ",", " ", "20", ",", " ", "100"}], 
        "}"}]}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[42]:= ",ExpressionUUID->"b1f54110-305b-4f27-b6c5-5b952ab13697"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the single-step survival probability ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{"\[CapitalOmega]", 
     StyleBox["\[Tau]", "TI"]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95dfbdbc-ec88-4f27-97fb-f09899378f41"],
 " read from the evolved state's ",
 Cell[BoxData["\"\<ProbabilitiesList\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a84e04f7-1c08-4101-b221-03aba9e8086a"],
 ", the ground-state weight after one interval ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97eb0d56-8775-47bd-af29-27789b32b6cc"],
 "."
}], "Text",ExpressionUUID->"d8de5c4b-2fc8-4f9f-bf8e-ae9bd5b68e9b"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"First", "[", 
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", 
         RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}], ",", " ", 
       RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", "\[Tau]"}], 
      "]"}], "[", "\"\<ProbabilitiesList\>\"", "]"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[CapitalOmega]", ",", " ", "\[Tau]"}], "}"}], " ", "\[Element]",
     " ", "Reals"}]}], "]"}]], "Input",
 CellLabel->
  "In[43]:= ",ExpressionUUID->"0dfdd481-69c5-45d9-b198-75f848dcaa2d"],

Cell[TextData[{
 "Without measurement (",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e1e8471-b221-4d4a-8744-43d858725f71"],
 ") the ",
 Cell[BoxData["\[Pi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9a73978-650e-45e0-b320-b6431d76709a"],
 "-pulse fully flips the qubit and the survival is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88eebde8-07d2-4561-a6c6-84f933ae1088"],
 "; with increasingly frequent measurement the survival climbs toward ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "654a614f-95a9-4d2d-9a4c-4fb15b4ace9b"],
 ", because each single-step survival ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{"\[CapitalOmega]", 
     StyleBox["\[Tau]", "TI"]}], "2"], "=", "1", "-", 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Tau]", "TI"], "2"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2fb737e-6e4d-4ba3-8668-61e237d7ec2d"],
 " and ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b935d958-20cb-459d-b598-3df209a83ae4"],
 " such factors with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Tau]", "TI"], "=", 
   StyleBox["t", "TI"], "/", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2af2e150-3364-469a-a6e2-85d9a2662586"],
 " tend to ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e2b542a-02f3-4c10-85f6-0e2c35303a34"],
 ": continuous observation pins the state in place."
}], "Text",ExpressionUUID->"dd2bbdc9-262c-4d80-9ed9-a56fb73022c4"],

Cell["\<\
7.16 [BSc] How do I encode each quantum postulate as a one-line operation \
(state, observable, evolution, measurement, composite)?\
\>", "Subsection",ExpressionUUID->"dcca34c7-3ca9-4c2e-bafb-7342ae85050a"],

Cell[TextData[{
 "The five postulates of quantum mechanics each have a compact \
finite-dimensional realization. Each is stated precisely below and then \
paired with its computational counterpart: a two-element list ",
 Cell[BoxData["{"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dde96504-5676-41be-a1d2-325b1f52df4c"],
 "bare Wolfram Language, matching QuantumFramework object",
 Cell[BoxData["}"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49f2e8e4-e3b7-44fc-9a6f-2aaead8f7f25"],
 ", whose entries return the same content."
}], "Text",ExpressionUUID->"6b0dbc00-f95e-4643-b12a-798a4f518829"],

Cell[TextData[{
 StyleBox["1. States.",
  FontWeight->"Bold"],
 " The state of an isolated system is a unit vector ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "\[Element]", "\[ScriptCapitalH]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7871cfe6-af83-415b-9ec9-d2af6dfed4da"],
 " in a complex Hilbert space, fixed only up to a global phase (equivalently \
a density operator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "\[GreaterEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ef133fa-7af4-442a-aaf5-cbe08769fc45"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["\[Rho]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4df5b4c1-bd51-4cfd-9e19-db242aa7da01"],
 "). Normalize a raw amplitude vector."
}], "Text",ExpressionUUID->"a688b8e7-680f-46ef-8977-500d339dfe85"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Normalize", "[", 
    RowBox[{"{", 
     RowBox[{"3", ",", " ", 
      RowBox[{"4", " ", "I"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", 
         RowBox[{"4", " ", "I"}]}], "}"}], "]"}], "[", "\"\<Normalized\>\"", 
      "]"}], "[", "\"\<StateVector\>\"", "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[44]:= ",ExpressionUUID->"696bdbb6-2464-4862-acdf-7f09bd6168f7"],

Cell[TextData[{
 StyleBox["2. Observables.",
  FontWeight->"Bold"],
 " Every observable is a self-adjoint operator ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["A", "TI"], "^"], "=", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["A", "TI"], "^"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "195cc1db-22bf-44f5-8cb7-37afc014cc54"],
 " on ",
 Cell[BoxData["\[ScriptCapitalH]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edb5c398-e232-444c-b2c8-563a4d4976ad"],
 "; its real eigenvalues are the possible outcomes and its eigenvectors the \
states of definite value. Test self-adjointness."
}], "Text",ExpressionUUID->"04ca09c8-a43d-4956-aa21-74115f109e7c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HermitianMatrixQ", "[", 
    RowBox[{"PauliMatrix", "[", "2", "]"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", "\"\<Y\>\"", "]"}], 
    "[", "\"\<HermitianQ\>\"", "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[45]:= ",ExpressionUUID->"2b6dfb5e-b084-4d79-8299-04a1a1a3d9ce"],

Cell[TextData[{
 StyleBox["3. Evolution.",
  FontWeight->"Bold"],
 " Between measurements a closed system evolves unitarily, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["t", "TI"], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Ket"], "=", 
   RowBox[{
    StyleBox["U", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], "0"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a313ef56-9417-4e41-ac11-d713d4cc9dc1"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     OverscriptBox[
      StyleBox["H", "TI"], "^"], 
     StyleBox["t", "TI"], "/", "\[HBar]"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc0d95e5-d0f5-44f6-b101-9d6e10926088"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"], 
   StyleBox["U", "TI"], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7be89944-c254-4d9f-9885-ca79b9f04e09"],
 ", the integrated form of the Schrodinger equation ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["i", "TI"], "\[HBar]", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      StyleBox["t", "TI"]], 
     TemplateBox[{
       StyleBox["\[Psi]", "TI"]},
      "Ket"]}]}], "=", 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c43b7134-3568-4cd2-a62f-553bdeea00d5"],
 ". Test that the propagator is unitary."
}], "Text",ExpressionUUID->"a24e5a7e-4979-4093-9f81-f24935672d87"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"UnitaryMatrixQ", "[", 
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "0.7", " ", 
      RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", "0.7", " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}], "]"}], 
    "[", "\"\<UnitaryQ\>\"", "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[46]:= ",ExpressionUUID->"4fcc3463-d490-4fc9-a5a2-e1ee6be02932"],

Cell[TextData[{
 StyleBox["4. Measurement (Born rule).",
  FontWeight->"Bold"],
 " Measuring ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["A", "TI"], "^"], "=", 
   UnderscriptBox["\[Sum]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["k", "TI"]], 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b474a97-1535-48f7-9f5a-674ae755af75"],
 " in state ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df7551fb-6c7c-4229-bb17-973d680d84bc"],
 " returns outcome ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a", "TI"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "818d4da3-883a-439b-9d00-4b1fe4497016"],
 " with probability ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["k", "TI"]], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Bra"], 
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["k", "TI"]], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7272d171-ff80-4e63-bc96-8d21c597fbcd"],
 ", whereupon the state collapses to ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["k", "TI"]], 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"], "/", 
    SqrtBox[
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["k", "TI"]]]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e911940b-4cc0-46ca-8ef6-24f857235f0c"],
 ". Read the Born probability of outcome ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0973eb35-a724-471a-bc6b-bc08f5875de1"],
 "."
}], "Text",ExpressionUUID->"68bd34e3-bd29-483b-ae3e-2e8b21254c4e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Psi]", " ", "=", " ", 
       RowBox[{"Normalize", "[", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", 
          RowBox[{"4", " ", "I"}]}], "}"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"Conjugate", "[", "\[Psi]", "]"}], " ", ".", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], " ", ".", " ", 
      "\[Psi]"}]}], "]"}], ",", " ", 
   RowBox[{"First", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
      "QuantumMeasurementOperator", "[", "\"\<Computational\>\"", "]"}], "[", 
      
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", 
         RowBox[{"4", " ", "I"}]}], "}"}], "]"}], "]"}], 
     "[", "\"\<ProbabilitiesList\>\"", "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[47]:= ",ExpressionUUID->"5ca619ca-344a-4106-ae25-8604baad4b97"],

Cell[TextData[{
 StyleBox["5. Composite systems.",
  FontWeight->"Bold"],
 " The state space of a composite system is the tensor product ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptCapitalH]", "1"], "\[CircleTimes]", "\[CenterDot]", 
   StyleBox["s", "TI"], "\[CircleTimes]", 
   SubscriptBox["\[ScriptCapitalH]", 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2df273d-fb92-49e4-abf0-b2fdf258d948"],
 " of its parts' spaces; independently prepared parts form the product state ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], "1"]},
     "Ket"], "\[CircleTimes]"}], "\[CenterDot]", 
   RowBox[{
    StyleBox["s", "TI"], "\[CircleTimes]", 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["n", "TI"]]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75be4eb3-e775-4b6f-b44d-53abdbd180be"],
 ". Build ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0"},
    "Ket"], "\[CircleTimes]", 
   TemplateBox[{"1"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ddb8c8d-7837-4278-8574-ffd6b3a13078"],
 "."
}], "Text",ExpressionUUID->"5e9a8fee-6ff1-450a-a0d7-cc08ad8199dc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Flatten", "[", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumTensorProduct", "[", 
      RowBox[{
       RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", 
       RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}]}], "]"}], 
     "[", "\"\<StateVector\>\"", "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[48]:= ",ExpressionUUID->"828208ad-100c-42c9-bf02-740f85ae371e"],

Cell["\<\
Each postulate is a single constructor or property, and the two entries of \
every pair agree: a unit vector, a self-adjointness test, a unitarity test, a \
Born probability, a tensor product. The bare-WL entry shows the raw linear \
algebra; the QuantumFramework entry reads the same fact off an object that \
also carries its own dimension, basis, and subsystem order, so the one-liners \
lift unchanged from qubits to qudits and many-body systems, the throughline \
of this whole manual.\
\>", "Text",ExpressionUUID->"c86c4cb8-a037-496a-9ddc-53640f2ad5f1"]
},
CreateCellID->True,
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (February 17, 2026)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"e87e7e57-c2b7-473f-8985-5c8d8593a5f8"
]
