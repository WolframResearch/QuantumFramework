Cell[53832, 1738, 789, 23, 70, "Input",ExpressionUUID->"bd2fb77a-4923-4bf1-8e65-3b617cd3407a"],
Cell[54624, 1763, 1250, 40, 70, "Text",ExpressionUUID->"cad32bff-4548-44af-9e3b-d98478cc721a"],
