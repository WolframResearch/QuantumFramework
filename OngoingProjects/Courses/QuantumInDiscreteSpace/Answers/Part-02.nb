Notebook[{
Cell["Part 2. Observables, spectra, and approximation", "Section",ExpressionUUID->"78f992b5-0c89-4018-ba4b-cd2a1186fe2c"],

Cell["\<\
2.1 [BSc] How do I compute a commutator and an anticommutator of two \
operators?\
\>", "Subsection",ExpressionUUID->"3577e191-ce9e-4343-94b7-e899920cd869"],

Cell[TextData[{
 "The commutator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["A", "TI"], ",", 
    StyleBox["B", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["A", "TI"], 
   StyleBox["B", "TI"], "-", 
   StyleBox["B", "TI"], 
   StyleBox["A", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f3ded08-5e7d-4301-9078-3e129a325ed3"],
 " measures the failure to commute; the anticommutator ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["A", "TI"]}], ",", 
   RowBox[{
    StyleBox["B", "TI"], "}", "=", 
    StyleBox["A", "TI"], 
    StyleBox["B", "TI"], "+", 
    StyleBox["B", "TI"], 
    StyleBox["A", "TI"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1be3f8e7-b077-491b-946d-fdfaa867912e"],
 ". Together they split the product, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], 
   StyleBox["B", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"{", 
     StyleBox["A", "TI"]}], ",", 
    RowBox[{
     StyleBox["B", "TI"], "}", "+", 
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["A", "TI"], ",", 
      StyleBox["B", "TI"]}], 
     StyleBox["]",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ad468ca-ec0d-4803-95ce-2e1da64d1d5d"],
 "."
}], "Text",ExpressionUUID->"2b84e9b6-ed59-49b6-b17f-18df15b52062"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the commutator is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], 
   StyleBox["B", "TI"], "-", 
   StyleBox["B", "TI"], 
   StyleBox["A", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44ec9f60-8d83-4afe-9a8e-b18b4d5fe742"],
 " on two general operators."
}], "Text",ExpressionUUID->"33c88091-e7ab-4baf-8128-026b747ee725"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"Array", "[", 
       RowBox[{"\[FormalA]", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"Array", "[", 
       RowBox[{"\[FormalB]", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}]}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{"a", " ", ".", " ", "b"}], " ", "-", " ", 
    RowBox[{"b", " ", ".", " ", "a"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"21124751-e55b-41c7-8b56-e5517c67991b"],

Cell[TextData[{
 "The anticommutator is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], 
   StyleBox["B", "TI"], "+", 
   StyleBox["B", "TI"], 
   StyleBox["A", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c00e6142-79d0-4b72-9bc4-5c9597617666"],
 "."
}], "Text",ExpressionUUID->"764ac841-5b20-4287-a010-d87d960bbcd7"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"Array", "[", 
       RowBox[{"\[FormalA]", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"Array", "[", 
       RowBox[{"\[FormalB]", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}]}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{"a", " ", ".", " ", "b"}], " ", "+", " ", 
    RowBox[{"b", " ", ".", " ", "a"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"f9aff367-adb5-4819-9804-20d56d059729"],

Cell[TextData[{
 "The Wolfram Language also provides them as built-ins (passing ",
 Cell[BoxData["Dot"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7f5d4ee-d4e7-48de-8a44-67f082ab0b45"],
 " as the product). The commutator:"
}], "Text",ExpressionUUID->"81261fb7-250c-4de9-8ccf-fbaee649da9f"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"Array", "[", 
       RowBox[{"\[FormalA]", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"Array", "[", 
       RowBox[{"\[FormalB]", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"Commutator", "[", 
    RowBox[{"a", ",", " ", "b", ",", " ", "Dot"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"eef13305-bed9-4c3f-ba26-fadd1c7820e4"],

Cell["and the anticommutator:", "Text",ExpressionUUID->"098a19e1-95a6-4975-b545-5fb6f866b371"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"Array", "[", 
       RowBox[{"\[FormalA]", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"Array", "[", 
       RowBox[{"\[FormalB]", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"Anticommutator", "[", 
    RowBox[{"a", ",", " ", "b", ",", " ", "Dot"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"c201b77f-9681-41aa-9d50-b411e8ac94bc"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : here the operands are ",
 StyleBox["operators", "TI"],
 ", so the results are again operators, not arrays. The built-in ",
 Cell[BoxData["Commutator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "438d95d4-c4f3-4598-bbdb-7b6b9de88ab5"],
 " reduces directly on QuantumOperators (QF teaches it the operator product), \
and returns a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b900aa9-045c-406d-a380-9073cbff0eb6"],
 "."
}], "Text",ExpressionUUID->"677f73b1-ee5d-4230-a9bb-5c222298aece"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"Array", "[", 
        RowBox[{"\[FormalA]", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"Array", "[", 
        RowBox[{"\[FormalB]", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], "]"}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"Commutator", "[", 
    RowBox[{"a", ",", " ", "b"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"a1511e1c-1301-42e0-b818-c617e2725c73"],

Cell[TextData[{
 "The built-in ",
 Cell[BoxData["Anticommutator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eba905d6-ab62-4cb1-af92-66155c37b321"],
 " does ",
 StyleBox["not", "TI"],
 " reduce on operators, so write it as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"a", " ", "@", " ", "b"}], " ", "+", " ", 
   RowBox[{"b", " ", "@", " ", "a"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5a4c8c6-363b-4685-bc60-e846cf1460da"],
 ", with ",
 Cell[BoxData["@"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "571ca49c-6ba7-4895-ac39-f69d2da8badc"],
 " the operator product."
}], "Text",ExpressionUUID->"086d116e-776b-4b9b-8f96-118372267520"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"Array", "[", 
        RowBox[{"\[FormalA]", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"Array", "[", 
        RowBox[{"\[FormalB]", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], "]"}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{
    RowBox[{"a", " ", "@", " ", "b"}], " ", "+", " ", 
    RowBox[{"b", " ", "@", " ", "a"}]}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"019eb25d-e97b-48e2-86eb-125d463f4d11"],

Cell[TextData[{
 "An operator does far more than carry a matrix. Take the concrete Pauli case \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["X", "TI"], ",", 
    StyleBox["Y", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "2", 
   StyleBox["i", "TI"], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff0e8c29-01d3-46d9-b63e-9b5a4c36ffab"],
 ": the commutator is itself an operator object, shown here as its summary \
box."
}], "Text",ExpressionUUID->"f6baa6fd-568d-452f-811a-8f3627d52319"],

Cell[BoxData[
 RowBox[{"c", " ", "=", " ", 
  RowBox[{"Commutator", "[", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], ",", " ", 
    RowBox[{"QuantumOperator", "[", "\"\<Y\>\"", "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"43f28f51-049e-4d49-826d-853515897a9d"],

Cell[TextData[{
 "It acts on a state, sending ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bda2b59-772d-405c-a7e4-0d8b20d233a6"],
 " to ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["i", "TI"], 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d399e62-e9bb-4ebe-b6bc-c83578d5eadc"],
 "."
}], "Text",ExpressionUUID->"32a85bed-2236-4009-9ba0-f41cb4bc659d"],

Cell[BoxData[
 RowBox[{"c", "[", 
  RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"826ef8a9-5d16-4295-9451-a6977bb15dbe"],

Cell[TextData[{
 "It answers whether it is Hermitian (a commutator of Hermitian operators is \
anti-Hermitian, so ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8122232d-1e34-49a4-af87-822f83efbc60"],
 ")."
}], "Text",ExpressionUUID->"fc706301-e459-492d-9dea-819e737baa33"],

Cell[BoxData[
 RowBox[{"c", "[", "\"\<HermitianQ\>\"", "]"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"2cfe877d-1e46-4c8f-92f6-e16e36a083b9"],

Cell[TextData[{
 "Its eigenvalues are imaginary, ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "2", 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2822b9b4-4a98-4c67-b89b-47fc2267065c"],
 "."
}], "Text",ExpressionUUID->"a81eab48-b5ab-467d-8d64-f056cd01ab48"],

Cell[BoxData[
 RowBox[{"c", "[", "\"\<Eigenvalues\>\"", "]"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"ec8e4c9a-ebce-4158-ac89-1ef003bf6a32"],

Cell[TextData[{
 "And only last of all does it hand back its matrix, ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["i", "TI"], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3370b917-d3fe-46ca-994c-429c89757189"],
 "."
}], "Text",ExpressionUUID->"99385176-1444-4e0e-a414-b91a64fa895b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c", "[", "\"\<Matrix\>\"", "]"}], " ", "//", " ", 
  "Normal"}]], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"bb168db6-dfe4-4db3-bcb3-0196d21eda71"],

Cell["\<\
The matrix is one view of a much richer object; that is the difference \
between QuantumFramework and bare linear algebra.\
\>", "Text",ExpressionUUID->"d6b67cec-bbf2-4648-b23a-5bf04892e5c7"],

Cell["\<\
2.2 [BSc] How do I build the Pauli operators and verify their algebra \
(Levi-Civita product rule)?\
\>", "Subsection",ExpressionUUID->"e7032177-2fc8-45de-961c-c71047b80cfb"],

Cell[TextData[{
 "The Pauli operators close under commutation, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["i", "TI"]], ",", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "2", 
   StyleBox["i", "TI"], " ", 
   SubscriptBox[
    StyleBox["\[CurlyEpsilon]", "TI"], 
    StyleBox[
     RowBox[{"i", "j", "k"}], "TI"]], " ", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "627c4547-5549-4aeb-a577-df2849478e26"],
 "."
}], "Text",ExpressionUUID->"1eb3a638-96ae-47fa-9ea3-4d3b60d70d3a"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : assemble the Pauli vector and check all nine commutators at once against \
the Levi-Civita tensor."
}], "Text",ExpressionUUID->"5fda8cea-1970-4766-b858-82cba9a3714b"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Sigma]", " ", "=", " ", 
     RowBox[{"PauliMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{
    RowBox[{"Outer", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#1", " ", ".", " ", "#2"}], " ", "-", " ", 
        RowBox[{"#2", " ", ".", " ", "#1"}]}], " ", "&"}], ",", " ", 
      "\[Sigma]", ",", " ", "\[Sigma]", ",", " ", "1"}], "]"}], " ", "==", 
    "\n", "  ", 
    RowBox[{"2", " ", "I", " ", 
     RowBox[{"TensorContract", "[", 
      RowBox[{
       RowBox[{"TensorProduct", "[", 
        RowBox[{
         RowBox[{"LeviCivitaTensor", "[", "3", "]"}], ",", " ", "\[Sigma]"}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}]}]}], "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"e0e8feb1-e9f2-401a-a5fc-cce3ce305fbb"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same check staying at the ",
 StyleBox["operator", "TI"],
 " level. Each ",
 Cell[BoxData[
  RowBox[{"Commutator", "[", 
   RowBox[{"#1", ",", " ", "#2"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26dc45ae-13d5-4757-9fd3-239552a9f038"],
 " is an operator, and every entry is compared directly to the operator ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["i", "TI"], " ", 
   SubscriptBox[
    StyleBox["\[CurlyEpsilon]", "TI"], 
    StyleBox[
     RowBox[{"i", "j", "k"}], "TI"]], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "518e747a-96d7-466e-98ee-06f62de65153"],
 ", with no matrices extracted."
}], "Text",ExpressionUUID->"ee492a3b-7bb8-401e-9935-b978cadccdec"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Sigma]", " ", "=", " ", 
     RowBox[{"QuantumOperator", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\""}], 
       "}"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"com", " ", "=", "\n", "   ", 
     RowBox[{"Outer", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Commutator", "[", 
         RowBox[{"#1", ",", " ", "#2"}], "]"}], " ", "&"}], ",", " ", 
       "\[Sigma]", ",", " ", "\[Sigma]", ",", " ", "1"}], "]"}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"com", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "==", " ", 
      RowBox[{"2", " ", "I", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"LeviCivitaTensor", "[", "3", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j", ",", " ", "k"}], "]"}], "]"}], " ", 
          RowBox[{"\[Sigma]", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"f390647f-ac75-4a70-9067-1ed951623145"],

Cell[TextData[{
 "The WL line returns ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e490db5-f122-442c-937c-db3f99071e06"],
 " and the QF line returns a ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b9093b8-d94f-4dd3-a603-3a58e0e8693b"],
 " table of ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0595845-cd7a-41a0-8b81-62ebe45d91bf"],
 ": every commutator operator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["i", "TI"]], ",", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f49faf5c-994e-4168-9353-e3a89b30cda3"],
 " equals the operator ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["i", "TI"], " ", 
   SubscriptBox[
    StyleBox["\[CurlyEpsilon]", "TI"], 
    StyleBox[
     RowBox[{"i", "j", "k"}], "TI"]], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4f54a91-2cd8-4f77-be49-d077fc554ac2"],
 " (the diagonal ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["i", "TI"]], ",", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["i", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "009ae877-027c-42f9-9c58-eea4e18c0926"],
 " vanishing), so the whole ",
 Cell[BoxData[
  RowBox[{"\|01d530", "\|01d532", 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e366a5d9-0c98-40c3-bbb7-f555aefb9da7"],
 " algebra is verified through operator equality, never touching a matrix."
}], "Text",ExpressionUUID->"71dc1c8a-d918-4dbe-83d7-d9068255c00e"],

Cell["2.3a [BSc] How do I test that an operator is Hermitian?", "Subsection",ExpressionUUID->"348f5023-38fd-4cf9-b8f5-fa788217ccd8"],

Cell[TextData[{
 "An operator is Hermitian when it equals its own conjugate transpose, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   SuperscriptBox[
    StyleBox["A", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a0223cc-03fb-460b-87b8-eb878b49139a"],
 "."
}], "Text",ExpressionUUID->"17f29e47-fb6f-4df9-8ea5-e609e148b922"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : test Hermiticity directly."
}], "Text",ExpressionUUID->"52179937-c3f4-437b-a50d-de9badf2cd59"],

Cell[BoxData[
 RowBox[{"HermitianMatrixQ", "[", 
  RowBox[{"PauliMatrix", "[", "1", "]"}], "]"}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"1af90b95-0c09-4e38-87f7-550afe397af2"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the operator answers ",
 Cell[BoxData["\"\<HermitianQ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a88ed1d-c3f3-4c6b-9b98-0c872e85b47b"],
 "."
}], "Text",ExpressionUUID->"6b84992e-559f-4b3c-ab71-8ac7d60a8ac7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], 
  "[", "\"\<HermitianQ\>\"", "]"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"12a19902-3e89-48ee-98f5-9fc33775eee0"],

Cell[TextData[{
 "Both return ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e8066a4-4298-4b63-b9aa-bc8ad0969cfd"],
 ": ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "433b9137-c290-4ecd-a27e-96873b62ab0e"],
 " is Hermitian."
}], "Text",ExpressionUUID->"f338070f-8c86-406e-97e2-686305870a54"],

Cell["2.3b [BSc] Why must an observable be Hermitian?", "Subsection",ExpressionUUID->"f87fc988-e791-4a3b-94db-1b823ae5feef"],

Cell["\<\
Measurement outcomes are real numbers, and the possible outcomes of an \
observable are its eigenvalues. Hermiticity is exactly the condition that \
forces those eigenvalues to be real, which is why every observable is \
represented by a Hermitian operator.\
\>", "Text",ExpressionUUID->"e7a6a5de-f2e9-4cd6-9ab2-f198635bcddd"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : a generic Hermitian matrix has real eigenvalues."
}], "Text",ExpressionUUID->"d3f910d3-e5b6-4053-a391-29f6a932bf20"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Eigenvalues", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a1", ",", " ", 
         RowBox[{"a2", " ", "+", " ", 
          RowBox[{"I", " ", "a3"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a2", " ", "-", " ", 
          RowBox[{"I", " ", "a3"}]}], ",", " ", "a4"}], "}"}]}], "}"}], "]"}],
     " ", "\[Element]", " ", "Reals"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
     "a1", " ", "|", " ", "a2", " ", "|", " ", "a3", " ", "|", " ", "a4"}], 
     ")"}], " ", "\[Element]", " ", "Reals"}]}], "]"}]], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"18f48888-271c-4703-86c7-28ec785a309d"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same, read off the operator's ",
 Cell[BoxData["\"\<Eigenvalues\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "982a7b3a-a399-4837-9196-6ecef903451d"],
 "."
}], "Text",ExpressionUUID->"77e87ba9-961e-47cb-9537-5b2e12d11889"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a1", ",", " ", 
          RowBox[{"a2", " ", "+", " ", 
           RowBox[{"I", " ", "a3"}]}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a2", " ", "-", " ", 
           RowBox[{"I", " ", "a3"}]}], ",", " ", "a4"}], "}"}]}], "}"}], 
      "]"}], "[", "\"\<Eigenvalues\>\"", "]"}], " ", "\[Element]", " ", 
    "Reals"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
     "a1", " ", "|", " ", "a2", " ", "|", " ", "a3", " ", "|", " ", "a4"}], 
     ")"}], " ", "\[Element]", " ", "Reals"}]}], "]"}]], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"5b0c7752-dfc6-4f74-a261-8abbdf15842b"],

Cell[TextData[{
 "Both return ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c246ae3-6ef6-4a41-92e0-32b2429780ed"],
 ": every Hermitian operator has a real spectrum, so its measurement outcomes \
are real. That real-spectrum guarantee is the physical reason observables \
must be Hermitian."
}], "Text",ExpressionUUID->"66fac4db-4560-4e68-bb3a-3ccf482367c4"],

Cell["\<\
2.4 [BSc] How do I compute eigenvalues and eigenvectors and form the spectral \
decomposition?\
\>", "Subsection",ExpressionUUID->"a9d522c2-4b4f-41ee-a49f-9362bd9eccd0"],

Cell[TextData[{
 "Every observable is its own spectral sum, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["a", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     StyleBox["a", "TI"], 
     TemplateBox[{
       StyleBox["a", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["a", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "186f575f-0d13-4e8d-b74d-001c30d78411"],
 ". The built-in ",
 Cell[BoxData["EigenvalueDecomposition"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eb9cbee-1e4f-4e75-8074-744a51adb492"],
 " packages exactly this: it returns ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["S", "TI"]}], ",", 
   RowBox[{
    StyleBox["D", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93f7af43-9a01-4320-a62c-075fe1f9e579"],
 " with the eigenvectors as the columns of ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf2cb2e2-90a4-414f-8387-6b95aeacd984"],
 ", the eigenvalues on the diagonal of ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8060bdef-ee51-442e-8cb0-e151bca5cea2"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   StyleBox["S", "TI"], " ", 
   StyleBox["D", "TI"], " ", 
   SuperscriptBox[
    StyleBox["S", "TI"], 
    RowBox[{"-", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25c1d962-5c84-4117-b50c-db4cb2fb1c6c"],
 "."
}], "Text",ExpressionUUID->"ed21fec6-5667-4533-8f2c-6b6bed54053c"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : compute the decomposition once and bind it."
}], "Text",ExpressionUUID->"bb3f8c88-7ac3-4d4c-b4cc-59bf44856cfd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evd", " ", "=", " ", 
   RowBox[{"EigenvalueDecomposition", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a1", ",", " ", 
        RowBox[{"a2", " ", "+", " ", 
         RowBox[{"I", " ", "a3"}]}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a2", " ", "-", " ", 
         RowBox[{"I", " ", "a3"}]}], ",", " ", "a4"}], "}"}]}], "}"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"62884a0d-36d8-4a43-bc89-5ddba274bc9d"],

Cell[TextData[{
 "The eigenvalues are the diagonal of ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "393aaa9e-4f99-49d3-9f62-965e9862a9d4"],
 "."
}], "Text",ExpressionUUID->"e580b7cd-d89d-4019-ad7f-c168274030eb"],

Cell[BoxData[
 RowBox[{"Diagonal", "[", 
  RowBox[{"evd", "[", 
   RowBox[{"[", "2", "]"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"c8d152b1-129b-4ecc-8186-9d92b4d71ee0"],

Cell[TextData[{
 "The eigenvectors are the columns of ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c97b3d7e-f46c-493f-aa83-0353f91e0e79"],
 " (rows of its transpose)."
}], "Text",ExpressionUUID->"b9fdf369-bd7e-4150-88d0-29b15bc60e43"],

Cell[BoxData[
 RowBox[{"Transpose", "[", 
  RowBox[{"evd", "[", 
   RowBox[{"[", "1", "]"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"5a7668fb-0bc8-4608-9588-fd495ce2b2f1"],

Cell[TextData[{
 "And the reconstruction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   StyleBox["S", "TI"], " ", 
   StyleBox["D", "TI"], " ", 
   SuperscriptBox[
    StyleBox["S", "TI"], 
    RowBox[{"-", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d27f7e29-e57f-460e-9e11-ea47810add7a"],
 " holds."
}], "Text",ExpressionUUID->"e65f9e4c-b968-4325-a71e-3fa2fb0a6c2f"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a1", ",", " ", 
        RowBox[{"a2", " ", "+", " ", 
         RowBox[{"I", " ", "a3"}]}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a2", " ", "-", " ", 
         RowBox[{"I", " ", "a3"}]}], ",", " ", "a4"}], "}"}]}], "}"}], " ", "==",
     " ", 
    RowBox[{
     RowBox[{"evd", "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", 
     RowBox[{"evd", "[", 
      RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", 
     RowBox[{"Inverse", "[", 
      RowBox[{"evd", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
     "a1", " ", "|", " ", "a2", " ", "|", " ", "a3", " ", "|", " ", "a4"}], 
     ")"}], " ", "\[Element]", " ", "Reals"}]}], "]"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"ef1325de-6bff-423b-8d1f-d29a8d9c98a1"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : keep it in the object model. The operator, shown as its summary box."
}], "Text",ExpressionUUID->"133da02a-1037-404d-8afa-bf0110fb9210"],

Cell[BoxData[
 RowBox[{"qo", " ", "=", " ", 
  RowBox[{"QuantumOperator", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a1", ",", " ", 
       RowBox[{"a2", " ", "+", " ", 
        RowBox[{"I", " ", "a3"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a2", " ", "-", " ", 
        RowBox[{"I", " ", "a3"}]}], ",", " ", "a4"}], "}"}]}], "}"}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"412cea36-2cc9-4376-835e-1bd044f64fd5"],

Cell["It hands back its eigenvalues,", "Text",ExpressionUUID->"83b16c9b-577a-48e9-8f41-077fedf99316"],

Cell[BoxData[
 RowBox[{"qo", "[", "\"\<Eigenvalues\>\"", "]"}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"32babe87-ada7-48ec-bd47-48a2df6a4b8c"],

Cell["its eigenvectors,", "Text",ExpressionUUID->"d71bf702-bdb8-4111-bfb7-dedd5d938308"],

Cell[BoxData[
 RowBox[{"qo", "[", "\"\<Eigenvectors\>\"", "]"}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"a4ee08aa-e90f-44a2-8394-9d2779f8600a"],

Cell[TextData[{
 "and ",
 Cell[BoxData["\"\<Diagonalize\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657e8604-8b43-4ed2-8f79-b0cc3e58c9ff"],
 " returns the ",
 StyleBox["operator", "TI"],
 " expressed in its own eigenbasis, a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cbc81202-4bf4-4ec8-bf91-8b3bbcb41d31"],
 " whose matrix is diagonal with the eigenvalues on it."
}], "Text",ExpressionUUID->"c5e2868f-398b-40fe-9203-7d2c1424eef3"],

Cell[BoxData[
 RowBox[{"qo", "[", "\"\<Diagonalize\>\"", "]"}]], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"50803ab7-307f-4b92-b1ad-41c50c626df4"],

Cell[TextData[{
 "Both report the same two real eigenvalues ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   SubscriptBox[
    StyleBox["a", "TI"], "1"], "+", 
   SubscriptBox[
    StyleBox["a", "TI"], "4"], "\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         StyleBox["a", "TI"], "1"], "-", 
        SubscriptBox[
         StyleBox["a", "TI"], "4"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"], "+", "4", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["a", "TI"], "2", "2"], "+", 
      SubsuperscriptBox[
       StyleBox["a", "TI"], "3", "2"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "899e88a2-22eb-45c2-895c-f046861e02e1"],
 ". On the WL side ",
 Cell[BoxData["EigenvalueDecomposition"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00b0d982-f194-4f01-b653-e8de07e8c756"],
 " reconstructs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   StyleBox["S", "TI"], 
   StyleBox["D", "TI"], 
   SuperscriptBox[
    StyleBox["S", "TI"], 
    RowBox[{"-", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cfd85ded-9b41-4c82-9ae6-8f0376b2e941"],
 " (for a Hermitian operator the eigenvectors are orthogonal, so normalizing ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed7bb44-3bc4-45ea-8791-3f74a9ea1a5d"],
 " to a unitary ",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77716bd8-58e9-423a-a13b-5f0b819f5d7a"],
 " turns this into the spectral form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["U", "TI"], 
     StyleBox["D", "TI"], 
     SuperscriptBox[
      StyleBox["U", "TI"], "\[Dagger]"]}], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["a", "TI"],
      LimitsPositioning->False], 
     RowBox[{
      StyleBox["a", "TI"], 
      TemplateBox[{
        StyleBox["a", "TI"]},
       "Ket"], 
      TemplateBox[{
        StyleBox["a", "TI"]},
       "Bra"]}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d20909d7-c3c8-4fd5-ba09-971227a97da3"],
 "). On the QF side ",
 Cell[BoxData["\"\<Diagonalize\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffe12045-238f-448e-816f-a7261466418f"],
 " ",
 StyleBox["is", "TI"],
 " that spectral form, the operator already diagonal in its eigenbasis, still \
an object rather than a bare array."
}], "Text",ExpressionUUID->"b28bd3ea-db60-4522-890e-84a71b6f244c"],

Cell[TextData[{
 "2.5 [BSc] How do I evaluate a function of an operator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["A", "TI"], "^"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b239d37-a486-4ed4-a948-d78d9d036a5d"],
 " by functional calculus?"
}], "Subsection",ExpressionUUID->"9af0be91-19d3-4b54-9373-5b5fce8618eb"],

Cell[TextData[{
 "Functional calculus defines ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["A", "TI"], "^"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07c83433-9a2e-4274-8081-2d2274877d6e"],
 " by letting ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11696d98-2f8c-4c83-af83-6eabb4c70b60"],
 " act on the eigenvalues in the eigenbasis, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["A", "TI"], "^"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["a", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     StyleBox["f", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["a", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     TemplateBox[{
       StyleBox["a", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["a", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c32f906b-4359-4870-aca0-dc5d1e28bca8"],
 ". In WL the one-call tool that does exactly this is ",
 Cell[BoxData["MatrixFunction"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c5e9491-e7c5-4b1b-841c-d725008b4ec5"],
 "."
}], "Text",ExpressionUUID->"0c43966a-6d8f-4905-accd-7d69b43b770c"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : apply a symbolic ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2400a8a-4638-43b0-8347-a7704fc7d674"],
 " to ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f321857b-b3e1-47e0-a1a9-1ae93571023b"],
 " directly."
}], "Text",ExpressionUUID->"fa0d0e87-b546-4110-a90c-ff93c13963aa"],

Cell[BoxData[
 RowBox[{"MatrixFunction", "[", 
  RowBox[{"f", ",", " ", 
   RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"35ae9c29-7a91-48e8-9714-93108649ccc5"],

Cell[TextData[{
 "The result ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["x", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "2"], "(", GridBox[{
     {
      RowBox[{
       StyleBox["f", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], "1", 
       StyleBox[")",
        SpanMaxSize->1], "+", 
       StyleBox["f", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"-", "1"}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      RowBox[{
       StyleBox["f", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], "1", 
       StyleBox[")",
        SpanMaxSize->1], "-", 
       StyleBox["f", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"-", "1"}], 
       StyleBox[")",
        SpanMaxSize->1]}]},
     {
      RowBox[{
       StyleBox["f", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], "1", 
       StyleBox[")",
        SpanMaxSize->1], "-", 
       StyleBox["f", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"-", "1"}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      RowBox[{
       StyleBox["f", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], "1", 
       StyleBox[")",
        SpanMaxSize->1], "+", 
       StyleBox["f", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"-", "1"}], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    }], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ced27ebd-d14a-458e-913f-c8b6324ab88c"],
 " is ",
 StyleBox["not", "TI"],
 " ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dfaa7fc-9967-495a-8223-dffe1c6b5e7f"],
 " taken entry by entry: the naive entrywise map would send the diagonal ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24b21dea-8025-4793-b9af-8fb4f7f23677"],
 "s of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d2fd75a-dfcd-404d-9153-63d6ca3f06bd"],
 " to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0feff65-4df0-4fd9-8cad-5ec2ca34eab9"],
 ", whereas functional calculus gives ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "1", 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd4c162d-1074-4a15-b30a-8166a355f2cb"],
 " there. The reason is the spectral definition, ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd0216da-57a7-4432-ba7a-c285fd95701f"],
 " acts on the eigenvalues ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70307c12-24c4-4f86-a9a6-a5ed5f0b0e1c"],
 " and the eigenprojectors of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee36f5b0-d883-48a4-bcd9-37b55dd77dda"],
 " spread that action across the whole matrix."
}], "Text",ExpressionUUID->"7090711b-e9cf-4403-bb6c-c464376360ad"],

Cell[TextData[{
 "To make that explicit, build the spectral sum ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["a", "TI"],
    LimitsPositioning->False], 
   RowBox[{
    StyleBox["f", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["a", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{
      StyleBox["a", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["a", "TI"]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c8c0276-25c2-4144-9776-c17dfdcf88e0"],
 " from the eigensystem."
}], "Text",ExpressionUUID->"3dd6aa18-5cb8-4ddb-82e4-62b6d7f06878"],

Cell[BoxData[
 RowBox[{"spec", " ", "=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sys", " ", "=", " ", 
      RowBox[{"Eigensystem", "[", 
       RowBox[{"PauliMatrix", "[", "1", "]"}], "]"}]}], "}"}], ",", "\n", 
    "  ", 
    RowBox[{"Total", "[", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"f", "[", "#1", "]"}], " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"#2", ",", " ", 
           RowBox[{"Conjugate", "[", "#2", "]"}]}], "]"}]}], " ", "&"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sys", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"Normalize", " ", "/@", " ", 
          RowBox[{"sys", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], "]"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[27]:= ",ExpressionUUID->"3bd2257c-f224-47c4-80fc-95fe397a740f"],

Cell["It reproduces the built-in to the last entry.", "Text",ExpressionUUID->"0e779eb5-939c-4c73-a686-cfec6909f8d3"],

Cell[BoxData[
 RowBox[{"spec", " ", "==", " ", 
  RowBox[{"MatrixFunction", "[", 
   RowBox[{"f", ",", " ", 
    RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"758dfc8b-59d3-488f-ae78-0009e6721f37"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same spectral definition driven by the operator's own ",
 Cell[BoxData["\"\<Eigensystem\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09039882-445b-441f-98fc-a5cf18f2faa7"],
 "."
}], "Text",ExpressionUUID->"a7beca48-8dfe-4fd6-ba51-9423e76f84d7"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sys", " ", "=", " ", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], 
      "[", "\"\<Eigensystem\>\"", "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Total", "[", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", "#1", "]"}], " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"#2", ",", " ", 
          RowBox[{"Conjugate", "[", "#2", "]"}]}], "]"}]}], " ", "&"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"sys", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"Normalize", " ", "/@", " ", 
         RowBox[{"sys", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], "]"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[29]:= ",ExpressionUUID->"387cc77b-cb90-40b2-9aae-de4a20404d83"],

Cell[TextData[{
 "So ",
 Cell[BoxData["MatrixFunction"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "219e9a48-0657-472e-8162-08e664320921"],
 " is the direct answer and the spectral sum is what it evaluates: ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2737080c-6a2c-439c-a9a3-ed15540fa501"],
 " acts through the eigenbasis, and the two agree exactly."
}], "Text",ExpressionUUID->"fee8942b-87fa-41fc-9295-0c7f9c5ee380"],

Cell[TextData[{
 "2.6 [BSc] How do I compute an expectation value and a variance on a pure \
state as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Bra"], 
   OverscriptBox[
    StyleBox["A", "TI"], "^"], 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1d26240-f624-4c71-9187-30f3bf7b758b"],
 "?"
}], "Subsection",ExpressionUUID->"257f49e1-20f4-45d4-8068-8007ab13afae"],

Cell[TextData[{
 "The mean is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["A", "TI"], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Bra"], 
    StyleBox["A", "TI"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f524d0ad-0a12-4072-b323-b476bfda6904"],
 " and the variance is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["A", "TI"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "-", 
   SuperscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     StyleBox["A", "TI"], "\[VeryThinSpace]", 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13602279-6141-4737-a874-3aea5be535fd"],
 "."
}], "Text",ExpressionUUID->"363e800b-c1dd-4056-b849-ecd8a2cefb15"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : contract the bra, operator, and ket for the mean."
}], "Text",ExpressionUUID->"b26902a5-3b3a-4222-849c-e09c7b1ebc19"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}], ",", " ", 
     RowBox[{"psi", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}]}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Conjugate", "[", "psi", "]"}], " ", ".", " ", "a", " ", ".", 
      " ", "psi"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", 
      " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[30]:= ",ExpressionUUID->"3d77b798-795b-4861-bcb3-1569dc746f47"],

Cell[TextData[{
 "The variance reuses ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["A", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "89d15376-6ad9-4935-98b0-9e17d16aa07a"],
 "."
}], "Text",ExpressionUUID->"74c7970a-c9db-4e09-80f7-2036eea9627f"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}], ",", " ", 
     RowBox[{"psi", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}]}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", "psi", "]"}], " ", ".", " ", "a", " ", ".", 
       " ", "a", " ", ".", " ", "psi"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Conjugate", "[", "psi", "]"}], " ", ".", " ", "a", " ", ".",
          " ", "psi"}], ")"}], "^", "2"}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", 
      " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[31]:= ",ExpressionUUID->"e3d52b32-d018-4042-b149-b021efc1882f"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the mean as a bra-operator-ket scalar."
}], "Text",ExpressionUUID->"ed8b8ade-09be-491f-9d33-b07651322747"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], ",", " ", 
     RowBox[{"ps", " ", "=", " ", 
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], "]"}]}]}], "}"}],
    ",", "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"ps", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
        RowBox[{"a", " ", "@", " ", "ps"}]}], ")"}], "[", "\"\<Scalar\>\"", 
      "]"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", 
      " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[32]:= ",ExpressionUUID->"2735131c-835f-43b9-b950-202298e5db29"],

Cell["The variance, again as scalars.", "Text",ExpressionUUID->"a5c578f3-890b-4b4b-a73e-e055e39bd5f6"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], ",", " ", 
     RowBox[{"ps", " ", "=", " ", 
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], "]"}]}]}], "}"}],
    ",", "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"ps", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
         RowBox[{"a", " ", "@", " ", 
          RowBox[{"a", " ", "@", " ", "ps"}]}]}], ")"}], "[", "\"\<Scalar\>\"",
        "]"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ps", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
           RowBox[{"a", " ", "@", " ", "ps"}]}], ")"}], "[", "\"\<Scalar\>\"",
          "]"}], ")"}], "^", "2"}]}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", 
      " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[33]:= ",ExpressionUUID->"3f556517-81dd-4a60-ad9d-aca861bac46b"],

Cell[TextData[{
 "Both give ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07093176-7542-45e0-a9ac-71ed8863c608"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Var",
    FontSlant->"Plain"], "=", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbf046ea-9f6d-4533-ad34-48c95b97d847"],
 ": the spin points along ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e479252a-2dd3-4501-aa01-5807d2342ac4"],
 " with certainty at the poles and is maximally uncertain on the equator. The \
mixed-state generalization, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"A", "\[Rho]"}], "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "207e8bd6-9edf-4755-b92f-010b4c9077b2"],
 " on any ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c706252e-a57c-410d-bf61-588d32bdec30"],
 " (giving ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44829a87-85b6-45b7-b371-6ad512c58c29"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Var",
    FontSlant->"Plain"], "=", "1", "-", 
   SubsuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b99f7381-aa6a-45c4-a032-52e57e21a149"],
 "), is Part 3, 3.4."
}], "Text",ExpressionUUID->"31a5eb71-cab7-475f-a3a9-d6aec89ee2ef"],

Cell["\<\
2.7 [BSc] How do I write the resolution of the identity in an orthonormal \
basis?\
\>", "Subsection",ExpressionUUID->"6f33d623-ac37-4070-bdb4-236158f21540"],

Cell[TextData[{
 "Any orthonormal basis is complete, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["i", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     TemplateBox[{
       StyleBox["i", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["i", "TI"]},
      "Bra"]}]}], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "747f429d-ad23-4cdb-8e20-758c3597a61a"],
 "."
}], "Text",ExpressionUUID->"c30536bd-45f8-435c-b098-f3aedbdd1468"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : sum the eigenprojectors of a generic Hermitian operator."
}], "Text",ExpressionUUID->"79631d27-85ef-4783-be73-3a60918e2709"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"vecs", " ", "=", " ", 
     RowBox[{"Normalize", " ", "/@", " ", 
      RowBox[{"Eigenvectors", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a1", ",", " ", 
           RowBox[{"a2", " ", "+", " ", 
            RowBox[{"I", " ", "a3"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"a2", " ", "-", " ", 
            RowBox[{"I", " ", "a3"}]}], ",", " ", "a4"}], "}"}]}], "}"}], 
       "]"}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{"Conjugate", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
         " ", "vecs"}], "]"}], " ", "==", " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
       "a1", " ", "|", " ", "a2", " ", "|", " ", "a3", " ", "|", " ", "a4"}], 
       ")"}], " ", "\[Element]", " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[34]:= ",ExpressionUUID->"d95c81f6-65d5-44fc-930a-f24cd070e09a"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same with the operator's ",
 Cell[BoxData["\"\<Eigenvectors\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d94ee5ef-5df8-4f5f-b4b6-43cbd2bdd688"],
 "."
}], "Text",ExpressionUUID->"3eccaaf9-1c0d-44c9-afff-e1efacb79e63"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"vecs", " ", "=", " ", 
     RowBox[{"Normalize", " ", "/@", " ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a1", ",", " ", 
            RowBox[{"a2", " ", "+", " ", 
             RowBox[{"I", " ", "a3"}]}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a2", " ", "-", " ", 
             RowBox[{"I", " ", "a3"}]}], ",", " ", "a4"}], "}"}]}], "}"}], 
        "]"}], "[", "\"\<Eigenvectors\>\"", "]"}]}]}], "}"}], ",", "\n", " ", 
   
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{"Conjugate", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
         " ", "vecs"}], "]"}], " ", "==", " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
       "a1", " ", "|", " ", "a2", " ", "|", " ", "a3", " ", "|", " ", "a4"}], 
       ")"}], " ", "\[Element]", " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[35]:= ",ExpressionUUID->"932bb321-89e4-4c07-8e01-d2761fc36f63"],

Cell[TextData[{
 "Both return ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ceac2c84-3b46-4528-85eb-90644e1a6b9b"],
 ": the eigenprojectors of any observable sum to the identity."
}], "Text",ExpressionUUID->"89c677ad-cfb6-491f-ae4a-7da313d46250"],

Cell["\<\
2.8 [BSc] How do I decide whether two observables are compatible (commute) \
and find a simultaneous eigenbasis?\
\>", "Subsection",ExpressionUUID->"e59afe24-04af-4b00-a53d-4ebce99761cf"],

Cell[TextData[{
 "Two observables are ",
 StyleBox["compatible", "TI"],
 ", meaning they can hold definite values at the same time, exactly when they \
commute, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["A", "TI"], ",", 
    StyleBox["B", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "045ebb53-0b81-4f0d-8b05-e2a0ad3ab6c4"],
 ". The reason commuting gives a shared eigenbasis is one line: if ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["A", "TI"], 
    TemplateBox[{
      StyleBox["a", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    StyleBox["a", "TI"], 
    TemplateBox[{
      StyleBox["a", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b04de922-1f94-45df-9a46-951bcfb5ea94"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], 
   StyleBox["B", "TI"], "=", 
   StyleBox["B", "TI"], 
   StyleBox["A", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b15340c5-e7b3-4a52-9160-1297f6f5a22a"],
 ", then ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["A", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["B", "TI"], 
      TemplateBox[{
        StyleBox["a", "TI"]},
       "Ket"]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     StyleBox["B", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["A", "TI"], 
       TemplateBox[{
         StyleBox["a", "TI"]},
        "Ket"]}], ")"}]}], "=", 
    RowBox[{
     StyleBox["a", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["B", "TI"], 
       TemplateBox[{
         StyleBox["a", "TI"]},
        "Ket"]}], ")"}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da6f4eb0-cab0-46ed-801d-2ef9eb510385"],
 ", so ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7cf1598-c528-4bde-abe9-ff3ffa684db8"],
 " keeps each eigenspace of ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f51bdcb-311f-45ba-a192-88e1499735b9"],
 " inside itself. When the eigenvalue ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "006552b9-c6ba-4433-8b8f-1fffeaffb6c3"],
 " is ",
 StyleBox["non-degenerate",
  FontWeight->"Bold"],
 " (a one-dimensional eigenspace), ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], 
   TemplateBox[{
     StyleBox["a", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c267888b-9ac9-4d00-b914-e21a04b178b9"],
 " can only be a multiple of ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["a", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1761282d-37bd-4d5d-bb8c-5b9e93cd609d"],
 ", so ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["a", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5948ae04-2f2d-4d43-8206-6ff53a683c7d"],
 " is automatically an eigenvector of ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f4adc77-c33e-4c3b-9c9c-ad0a593de309"],
 " too. That is the whole job in the ordinary case: diagonalize one \
non-degenerate observable, and its eigenvectors are already the simultaneous \
eigenbasis."
}], "Text",ExpressionUUID->"dc8fd54b-c6a0-48d8-a011-1d6468bd2a9b"],

Cell[TextData[{
 StyleBox["Normal case.",
  FontWeight->"Bold"],
 " Take a non-degenerate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   StyleBox["X", "TI"], "\[CircleTimes]", 
   StyleBox["I", "TI"], "+", "2", " ", 
   StyleBox["I", "TI"], "\[CircleTimes]", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eadd2d65-00d8-42dd-8bd0-e4a23bd49cf7"],
 " and a compatible partner ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], "=", 
   StyleBox["X", "TI"], "\[CircleTimes]", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2744cde-ebd9-4dd3-92b6-e637778714da"],
 "."
}], "Text",ExpressionUUID->"7d34728d-c1e9-437a-9aae-c4b135b04a9a"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : compatibility is the vanishing commutator."
}], "Text",ExpressionUUID->"a0f8ad85-a917-43f2-8f08-0d73faabb41a"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], " ", "+", " ", 
       RowBox[{"2", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
          RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}]}]}], ",", "\n", 
     "   ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", 
        RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}]}], "}"}], ",", "\n",
    " ", 
   RowBox[{
    RowBox[{"a", " ", ".", " ", "b"}], " ", "==", " ", 
    RowBox[{"b", " ", ".", " ", "a"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[36]:= ",ExpressionUUID->"51d1d23f-4bab-4d67-9561-9d73469c6098"],

Cell[TextData[{
 "What makes this the easy case is that ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7930407d-8ff1-4328-a735-453335aa2656"],
 " is non-degenerate: its four eigenvalues are distinct, so every eigenspace \
is one-dimensional and the eigenbasis is unique."
}], "Text",ExpressionUUID->"f482885b-34fc-49c6-9638-15b6908f4f1a"],

Cell[BoxData[
 RowBox[{"Eigenvalues", "[", "\n", " ", 
  RowBox[{
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], " ", "+", " ", 
   RowBox[{"2", " ", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[37]:= ",ExpressionUUID->"457353cb-be96-4368-ad41-123cd8a88321"],

Cell[TextData[{
 "Diagonalize ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "347baf8d-e062-4b73-912a-bc4e40953a19"],
 " once: its eigenvectors also diagonalize ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82a1b359-b0b9-47de-997c-278458f07305"],
 ", so they ",
 StyleBox["are", "TI"],
 " the simultaneous eigenbasis. The check conjugates each operator into the \
candidate basis (",
 Cell[BoxData[
  StyleBox["u", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b485c6e2-f23b-4f6c-be9d-4f2c9eea3f83"],
 " holding the eigenvectors as rows) and tests that the result is diagonal; \
the pair ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd50c5d9-04d2-4b62-b559-4e11f9b2d3c2"],
 " says both are."
}], "Text",ExpressionUUID->"878cc020-a108-465b-bc32-4e2d270f4b09"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], " ", "+", " ", 
       RowBox[{"2", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
          RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}]}]}], ",", "\n", 
     "   ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", 
        RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}]}], "}"}], ",", "\n",
    " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", " ", "=", " ", 
       RowBox[{"Normalize", " ", "/@", " ", 
        RowBox[{"Eigenvectors", "[", "a", "]"}]}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"DiagonalMatrixQ", " ", "/@", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Chop", "[", 
          RowBox[{
           RowBox[{"Conjugate", "[", "u", "]"}], " ", ".", " ", "#", " ", ".",
            " ", 
           RowBox[{"Transpose", "[", "u", "]"}]}], "]"}], " ", "&"}], " ", "/@",
         " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "b"}], "}"}]}], ")"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[38]:= ",ExpressionUUID->"10545741-9147-433b-a5b7-b20016797f02"],

Cell[TextData[{
 StyleBox["Special case: when neither observable is enough by itself.",
  FontWeight->"Bold"],
 " The shortcut breaks when the observables are degenerate, because then \
\"diagonalize ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "577048e6-dab4-4740-9565-e5c478f0c934"],
 "\" no longer names a unique basis. Take ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   StyleBox["X", "TI"], "\[CircleTimes]", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3f78432-b506-469b-be12-93f1976d7765"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], "=", 
   StyleBox["Z", "TI"], "\[CircleTimes]", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf5f4223-6c6a-430b-be16-fa9785de885f"],
 ": they commute, but each has ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23e4e3fb-2b0a-47a9-bdc1-3463149b8059"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6274c6e-9954-4949-a3e1-292560d8bc59"],
 " ",
 StyleBox["doubled", "TI"],
 "."
}], "Text",ExpressionUUID->"aadaca83-008b-483a-a455-1b6752735dbb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Eigenvalues", "[", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", 
      RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}], "]"}], ",", "\n", " ", 
   
   RowBox[{"Eigenvalues", "[", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->
  "In[39]:= ",ExpressionUUID->"fb0fc3f8-5c6e-41a7-9d65-27c93794de0b"],

Cell[TextData[{
 "A doubled eigenvalue is a two-dimensional eigenspace, and ",
 StyleBox["any", "TI"],
 " orthonormal pair inside it is an equally valid eigenbasis, so a choice \
that diagonalizes one operator need not diagonalize the other. Concretely, \
the obvious eigenbasis of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], "\[CircleTimes]", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36c011c8-3860-4d05-bf5d-1f58255913b6"],
 ", each qubit in an ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af26fb84-0350-4fc4-bd71-61ceded3a1a3"],
 "-eigenstate ",
 Cell[BoxData[
  TemplateBox[{"\[PlusMinus]"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dd7af0a-cfc3-4689-8bd7-1fe0ad01ace6"],
 " (the rows of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "\[CircleTimes]", 
   StyleBox["H", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0792b18f-b3fe-4e39-b9e4-414abf2b7f2f"],
 "), diagonalizes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], "\[CircleTimes]", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c334bb9-9ec1-476f-abcb-38cc9ebee1bc"],
 " but not ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Z", "TI"], "\[CircleTimes]", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25b2d5ca-37f6-4469-af6d-0b365c5b918a"],
 ": the pair comes back ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "False"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d85dbb1-f26a-448c-8ffe-2784d3adedec"],
 "."
}], "Text",ExpressionUUID->"fb16ccae-a341-4fee-a55b-b7a811f25176"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"u", " ", "=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"HadamardMatrix", "[", "2", "]"}], ",", " ", 
       RowBox[{"HadamardMatrix", "[", "2", "]"}]}], "]"}]}], "}"}], ",", "\n",
    " ", 
   RowBox[{"DiagonalMatrixQ", " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "u", "]"}], " ", ".", " ", "#", " ", ".", 
         " ", 
         RowBox[{"Transpose", "[", "u", "]"}]}], "]"}], " ", "&"}], " ", "/@",
       "\n", "   ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", 
          RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}], ",", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", 
          RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}], "}"}]}], 
     ")"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[40]:= ",ExpressionUUID->"666cdf44-339e-4cd2-8bf7-5b8567f00591"],

Cell[TextData[{
 "The fix is to diagonalize a single ",
 StyleBox["non-degenerate", "TI"],
 " combination ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "+", 
   StyleBox["c", "TI"], 
   StyleBox["B", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43846f4f-c75b-4769-a961-8468bd5a598b"],
 " for a generic constant ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2803304d-ee94-405b-9d8c-becc286ccdad"],
 ". Its eigenvalues are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "+", 
   StyleBox["c", "TI"], " ", 
   StyleBox["b", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "342b4979-ac72-4e41-bd19-4d7fa92a5178"],
 " over the joint values ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "050c8888-a058-4b75-af9f-e05a5204db29"],
 ", which a generic ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14998a97-4e2f-43eb-ac2c-765565e78268"],
 " keeps distinct, so its eigenbasis is unique; and because ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "+", 
   StyleBox["c", "TI"], 
   StyleBox["B", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "486bb9b2-5d7b-4413-9a13-97ec07c262b4"],
 " commutes with both ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f603583-fd64-46eb-aea6-ad10edf52bf6"],
 " and ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6c15c1c-49bb-4780-a007-71eaa8239298"],
 ", that one basis diagonalizes both. Take ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], "=", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b9595d-4f99-4769-b8f9-24783ff673df"],
 ", and the pair is ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90ef3e74-7797-4855-b33a-a876268d7c3d"],
 "."
}], "Text",ExpressionUUID->"46c68f39-4e67-4147-8b2c-e5012b9ce0e8"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", 
        RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", 
        RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}]}], "}"}], ",", "\n",
    " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", " ", "=", " ", 
       RowBox[{"Normalize", " ", "/@", " ", 
        RowBox[{"Eigenvectors", "[", 
         RowBox[{"a", " ", "+", " ", 
          RowBox[{"\[Pi]", " ", "b"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"DiagonalMatrixQ", " ", "/@", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Chop", "[", 
          RowBox[{
           RowBox[{"Conjugate", "[", "u", "]"}], " ", ".", " ", "#", " ", ".",
            " ", 
           RowBox[{"Transpose", "[", "u", "]"}]}], "]"}], " ", "&"}], " ", "/@",
         " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "b"}], "}"}]}], ")"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[41]:= ",ExpressionUUID->"53e2a6f7-cdd4-426e-9210-250cac9da3e1"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : compatibility is the ",
 StyleBox["operator", "TI"],
 " equality ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], 
   StyleBox["B", "TI"], "=", 
   StyleBox["B", "TI"], 
   StyleBox["A", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c20eab4-c803-43e8-8663-a76bb89582cc"],
 ", written ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"a", " ", "@", " ", "b"}], " ", "==", " ", 
   RowBox[{"b", " ", "@", " ", "a"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddc17535-0ee4-4b98-a45b-e1e698acdd16"],
 "."
}], "Text",ExpressionUUID->"bb9b5cf0-9278-4c0a-b5ab-08e3636d35dd"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", "\"\<XX\>\"", "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", "\"\<ZZ\>\"", "]"}]}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{
    RowBox[{"a", " ", "@", " ", "b"}], " ", "==", " ", 
    RowBox[{"b", " ", "@", " ", "a"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[42]:= ",ExpressionUUID->"0e5d1a43-719b-4928-ad4a-677f714fde1b"],

Cell[TextData[{
 "The simultaneous eigenbasis is the eigenstates of ",
 Cell[BoxData[
  RowBox[{"a", " ", "+", " ", 
   RowBox[{"Pi", " ", "b"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43d604b3-7ec3-483d-b931-39f563447045"],
 ". Each one holds a definite value of both ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23c9cc70-d1c8-48b4-920a-bc03a0945e56"],
 " and ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "363fcb05-c2c9-4c71-a6c7-b0de0b10f4f0"],
 ", so each operator returns it to itself up to a phase, leaving its density \
matrix unchanged."
}], "Text",ExpressionUUID->"a6bbd56c-d8e4-4c94-8752-be801192872a"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", "\"\<XX\>\"", "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", "\"\<ZZ\>\"", "]"}]}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"basis", " ", "=", " ", 
       RowBox[{"QuantumState", " ", "/@", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"a", " ", "+", " ", 
           RowBox[{"\[Pi]", " ", "b"}]}], ")"}], "[", "\"\<Eigenvectors\>\"", 
         "]"}]}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"basis", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a", "[", "#", "]"}], ")"}], "[", "\"\<DensityMatrix\>\"",
            "]"}], " ", "==", " ", 
          RowBox[{"#", "[", "\"\<DensityMatrix\>\"", "]"}]}], " ", "&&", " ", 
         
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"b", "[", "#", "]"}], ")"}], "[", "\"\<DensityMatrix\>\"",
            "]"}], " ", "==", " ", 
          RowBox[{"#", "[", "\"\<DensityMatrix\>\"", "]"}]}]}], " ", "&"}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[43]:= ",ExpressionUUID->"2d64ffef-b3ae-4f5c-9c73-f0d7de5d7b49"],

Cell[TextData[{
 "So: compatible means commuting; in the ordinary case one non-degenerate \
observable already fixes the shared eigenbasis, and when both observables are \
degenerate you restore uniqueness by diagonalizing a generic combination ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "+", 
   StyleBox["c", "TI"], 
   StyleBox["B", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "893e8431-1919-4170-b88a-1fdd96f29a91"],
 " just once. The basis that ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "+", "\[Pi]", 
   StyleBox["B", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc189e2c-1e05-46a2-8523-67303efdcc0d"],
 " returns is the Bell basis; ",
 Cell[BoxData["\[Pi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b66e3387-e0c2-4633-8fd8-ba98ca47e2d1"],
 " only serves to break the degeneracy, and any value that does so yields the \
same simultaneous eigenbasis."
}], "Text",ExpressionUUID->"f055dd20-b9ee-485d-9ce2-4a9a99eec0eb"],

Cell["\<\
2.9a [MSc] How do I construct a complete set of commuting observables (CSCO)?\
\
\>", "Subsection",ExpressionUUID->"9f1f6357-78c1-4311-b478-468e6c9a59b8"],

Cell[TextData[{
 "A complete set of commuting observables (CSCO) is a set of mutually \
commuting Hermitian operators whose simultaneous eigenvalues label every \
basis state ",
 StyleBox["uniquely", "TI"],
 ". Commuting is the easy half (handled in 2.8); ",
 StyleBox["complete", "TI"],
 " is the real content. A single observable is a CSCO only when it is \
non-degenerate: a degenerate eigenvalue is a multi-dimensional eigenspace in \
which no basis is singled out, so the observable cannot distinguish the \
states it contains. The construction is to adjoin further commuting \
observables, each lifting some remaining degeneracy, until every simultaneous \
eigenspace is one-dimensional. Completeness is then a computable test: once \
the observables commute, the number of ",
 StyleBox["distinct", "TI"],
 " joint-eigenvalue tuples must equal the Hilbert-space dimension, since only \
then does the label pin down a unique state."
}], "Text",ExpressionUUID->"a99bd839-2e7f-44f2-b999-9d318cb3c1cc"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : one observable is not enough. ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Z", "TI"], "\[CircleTimes]", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bd4aac0-7780-4689-9986-00614dd9a090"],
 " reads only the first qubit, so it is blind to the second; its spectrum is \
doubly degenerate (two distinct eigenvalues for a four-dimensional space), \
and its eigenbasis is not unique."
}], "Text",ExpressionUUID->"1e4d5727-3edf-4212-9b7e-2b58362e4a23"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], "}"}], ",", "\n",
    " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", "a", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Length", "@", 
       RowBox[{"DeleteDuplicates", "@", 
        RowBox[{"Eigenvalues", "[", "a", "]"}]}]}], " ", "<", " ", 
      RowBox[{"Length", "[", "a", "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[44]:= ",ExpressionUUID->"e764b205-8ec3-4bc9-9d77-5a41aa867166"],

Cell[TextData[{
 "Adjoin the commuting observable ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "\[CircleTimes]", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d85ae418-20bd-4c4f-8f5c-1358a3d64ebb"],
 ", which reads the second qubit. The joint-eigenvalue tuples are now all \
distinct (four of them, equal to the dimension), so every state is uniquely \
labeled and the pair is a CSCO."
}], "Text",ExpressionUUID->"e0813605-4142-4a34-82a5-d2b9e2edf246"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
        RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}]}], "}"}], ",", "\n",
    " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"joint", " ", "=", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Diagonal", "[", "a", "]"}], ",", " ", 
          RowBox[{"Diagonal", "[", "b", "]"}]}], "}"}], "]"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"a", " ", ".", " ", "b"}], " ", "==", " ", 
        RowBox[{"b", " ", ".", " ", "a"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Length", "@", 
         RowBox[{"DeleteDuplicates", "@", "joint"}]}], " ", "==", " ", 
        RowBox[{"Length", "@", "joint"}]}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[45]:= ",ExpressionUUID->"1e01a094-f7f1-4cde-b803-2fb7ca454992"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same construction, with the operators named as strings. ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Z", "TI"], "\[CircleTimes]", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7e7edb3-633f-411a-9de7-7359665b9ab1"],
 " alone is degenerate,"
}], "Text",ExpressionUUID->"2c5188e5-17ae-48fd-91db-93e100d4e5f0"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"QuantumOperator", "[", "\"\<ZI\>\"", "]"}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", "\"\<Eigenvalues\>\"", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Length", "@", 
       RowBox[{"DeleteDuplicates", "@", 
        RowBox[{"a", "[", "\"\<Eigenvalues\>\"", "]"}]}]}], " ", "<", " ", 
      RowBox[{"Length", "@", 
       RowBox[{"a", "[", "\"\<Eigenvalues\>\"", "]"}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[46]:= ",ExpressionUUID->"4d1f82b9-6bb7-4813-9947-ac0976a8eb9d"],

Cell[TextData[{
 "and adjoining ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "\[CircleTimes]", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50d78bd0-3cb6-4e20-9130-0d43da925a05"],
 " completes the set."
}], "Text",ExpressionUUID->"54429b01-8f51-4e58-87a5-10354c610782"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", "\"\<ZI\>\"", "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", "\"\<IZ\>\"", "]"}]}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"joint", " ", "=", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Diagonal", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{"a", "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}], ",", " ", 
          RowBox[{"Diagonal", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{"b", "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}]}], "}"}], 
        "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"a", " ", "@", " ", "b"}], " ", "==", " ", 
        RowBox[{"b", " ", "@", " ", "a"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Length", "@", 
         RowBox[{"DeleteDuplicates", "@", "joint"}]}], " ", "==", " ", 
        RowBox[{"Length", "@", "joint"}]}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[47]:= ",ExpressionUUID->"ba8e6ed4-3436-441b-ac47-345e72a1eda2"],

Cell[TextData[{
 "The single observable returns two distinct eigenvalues for a \
four-dimensional space (",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8f0b3d7-fb29-48f1-8bb3-4a06bd35e546"],
 ": degenerate, hence incomplete); the pair returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"True", ",", " ", "True"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95e9c215-1fa8-465a-9c1a-1579f913b974"],
 " (commuting, and its four joint tuples are distinct, so complete). Here the \
joint eigenvalues are read straight off the diagonals because ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Z", "TI"], "\[CircleTimes]", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1f67bdc-1b99-43e1-9cf0-3ab91df5ac5c"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "\[CircleTimes]", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eed75fd-0926-4865-8a59-1d3248fa857a"],
 " are already simultaneously diagonal; in general one first diagonalizes a \
non-degenerate combination ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "+", 
   StyleBox["c", "TI"], 
   StyleBox["B", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4f54ea8-e3e8-47e5-a09a-255968657909"],
 " (as in 2.8) and reads the tuples in that common eigenbasis. The unique \
labels this CSCO assigns are the subject of 2.9b."
}], "Text",ExpressionUUID->"c43854f2-338b-474a-b371-1ef8df56f28f"],

Cell["\<\
2.9b [MSc] How do I label basis states by the joint spectrum of a CSCO?\
\>", "Subsection",ExpressionUUID->"e33fd821-611f-4496-b47f-42304b84d059"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["Z", "TI"], "\[CircleTimes]", 
    StyleBox["I", "TI"]}], ",", 
   RowBox[{
    StyleBox["I", "TI"], "\[CircleTimes]", 
    StyleBox["Z", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d23799d-6694-4437-b336-1709491305c8"],
 " established as a CSCO (2.9a), its joint eigenvalues are the ",
 StyleBox["quantum numbers", "TI"],
 " that name the basis: each state carries a tuple ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["z", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["z", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b5ad102-8fa1-4c0a-9de9-ba896eea9652"],
 ", and because the set is complete those tuples are all distinct. Reading \
them off (the operators are simultaneously diagonal) pairs every \
computational basis state with its label."
}], "Text",ExpressionUUID->"2e05c879-65e5-4c97-ad27-9480d251d870"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : pair each basis state ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      SubscriptBox[
       StyleBox["z", "TI"], "1"], 
      SubscriptBox[
       StyleBox["z", "TI"], "2"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be376ee5-3b6d-412c-802c-5c6d89e960f8"],
 " with its joint eigenvalues."
}], "Text",ExpressionUUID->"5b8c9169-ff66-4403-adb5-895aeb907650"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
        RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}]}], "}"}], ",", "\n",
    " ", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Diagonal", "[", "a", "]"}], ",", " ", 
        RowBox[{"Diagonal", "[", "b", "]"}]}], "}"}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[48]:= ",ExpressionUUID->"fa5c322e-e064-4aec-91a5-a1f077a8c57a"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same labels, with the operators named as strings."
}], "Text",ExpressionUUID->"1f5cc668-d5d9-4837-97e9-3e564d5faa28"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", "\"\<ZI\>\"", "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", "\"\<IZ\>\"", "]"}]}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Diagonal", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{"a", "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}], ",", " ", 
        RowBox[{"Diagonal", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{"b", "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}]}], "}"}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[49]:= ",ExpressionUUID->"2938e38c-6989-4b3b-b57e-8ca17d736b57"],

Cell[TextData[{
 "Both pair ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"00"},
    "Ket"], "\[Rule]", 
   StyleBox["(",
    SpanMaxSize->1], "+", ",", "+", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e750369a-b099-44e1-9b34-9bee461db586"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"01"},
    "Ket"], "\[Rule]", 
   StyleBox["(",
    SpanMaxSize->1], "+", ",", "-", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14a46fab-133b-4691-b268-9f52d0be9d71"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"10"},
    "Ket"], "\[Rule]", 
   StyleBox["(",
    SpanMaxSize->1], "-", ",", "+", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09b74aeb-931e-4d4e-b852-6b22203aaec0"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"11"},
    "Ket"], "\[Rule]", 
   StyleBox["(",
    SpanMaxSize->1], "-", ",", "-", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4af4d0f4-e4e9-42a0-96f2-3a8c1a3da4c2"],
 ": the four eigenvalue tuples are distinct, so the joint spectrum is a \
complete, unambiguous label for the basis. These tuples are the \
finite-dimensional analogue of the good quantum numbers (like ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], ",", "\[ScriptL]", ",", 
   StyleBox["m", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e8bd666-38af-43af-b78e-bfafc24fa7b7"],
 ") that index states in continuous problems."
}], "Text",ExpressionUUID->"1e4473b1-f258-4529-9532-149bfd044a53"],

Cell[TextData[{
 "2.10a [MSc] How do I define the Hilbert-Schmidt operator inner product ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["A", "TI"], ",", 
    StyleBox["B", "TI"]}], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[Dagger]"], 
    StyleBox["B", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44828640-ee2a-4725-808d-a70545198441"],
 " and show the Pauli operators are orthogonal?"
}], "Subsection",ExpressionUUID->"c35610f3-d6d1-411f-b39e-a67620845ad0"],

Cell[TextData[{
 "Operators form a Hilbert space under their own inner product, the \
Hilbert-Schmidt product ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["A", "TI"], ",", 
    StyleBox["B", "TI"]}], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[Dagger]"], 
    StyleBox["B", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a6e437f-5c48-473f-ae4a-b5f9da607bfb"],
 ". Under it the four operators ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["I", "TI"]}], ",", 
   StyleBox["X", "TI"], ",", 
   StyleBox["Y", "TI"], ",", 
   RowBox[{
    StyleBox["Z", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59512fc7-1a15-4605-a437-c6a407f98d50"],
 " are mutually orthogonal, each of squared norm ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["j", "TI"]], ",", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01d5fc6d-daf2-4ac3-bd2b-f0cbcfb76c0a"],
 "."
}], "Text",ExpressionUUID->"083a9a47-9db4-49c4-87cc-1ed3b6e41721"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the Gram matrix ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["i", "TI"]], ",", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3739a6bb-63cd-46d0-b687-930d2aaab938"],
 " over ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["I", "TI"]}], ",", 
   StyleBox["X", "TI"], ",", 
   StyleBox["Y", "TI"], ",", 
   RowBox[{
    StyleBox["Z", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51916210-6b09-48de-9873-ade5474951b2"],
 "."
}], "Text",ExpressionUUID->"599b8c09-632c-4573-bab7-4f85aee20583"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Tr", "[", 
    RowBox[{
     RowBox[{"ConjugateTranspose", "[", 
      RowBox[{"PauliMatrix", "[", "i", "]"}], "]"}], " ", ".", " ", 
     RowBox[{"PauliMatrix", "[", "j", "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"i", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"j", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[50]:= ",ExpressionUUID->"16c5e888-fe47-4443-95fa-2e8f32cbce9b"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the same inner product on ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03437d54-3714-46f5-bce0-d93869f0dcb5"],
 "s, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["A", "TI"], "\[Dagger]"], 
    StyleBox["B", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9583f2e6-6b38-4bdc-a30f-42b4382ea526"],
 " being the trace of the composed operator ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["A", "TI"], "\[Dagger]"], 
   StyleBox["B", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77f0b36a-808e-42e1-9619-8e5bd550c6f7"],
 "."
}], "Text",ExpressionUUID->"28e5bebd-647f-49a3-a479-dc5dff51b502"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"paulis", " ", "=", " ", 
     RowBox[{"QuantumOperator", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<I\>\"", ",", " ", "\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",",
         " ", "\"\<Z\>\""}], "}"}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#1", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", "#2"}], 
          ")"}], "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}], " ", "&"}], ",", 
     " ", "paulis", ",", " ", "paulis", ",", " ", "1"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[51]:= ",ExpressionUUID->"2208325d-7fc1-4bfd-8c6e-1c9234c9418c"],

Cell[TextData[{
 "Both return ",
 Cell[BoxData[
  RowBox[{"2", " ", 
   SubscriptBox["\|01d7d9", "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4f4c93b-2fc8-4e7f-9fb5-6f71bbf462af"],
 ": the operators are mutually orthogonal (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["i", "TI"]], ",", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08eb9fe9-bdc6-47a1-b654-8cacf919b9d0"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], "\[NotEqual]", 
   StyleBox["j", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa41c34b-1351-470d-9ced-984103f2586c"],
 ") and each has squared norm ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4db19c6-cfa3-4441-b95b-6242446f494a"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["I", "TI"]}], ",", 
   StyleBox["X", "TI"], ",", 
   StyleBox["Y", "TI"], ",", 
   RowBox[{
    StyleBox["Z", "TI"], "}", "/", 
    SqrtBox["2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efbf0e8a-473a-4984-a191-551723f56f28"],
 " is an orthonormal basis of the ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76bba7c3-e78f-4171-a905-8c190246bf02"],
 " operator space."
}], "Text",ExpressionUUID->"b9c3b19c-e50f-4949-960c-437949070d39"],

Cell["2.10b [MSc] How do I expand an operator in the Pauli basis?", \
"Subsection",ExpressionUUID->"e5c75471-5d3c-4f13-ab96-029b68fe15f0"],

Cell[TextData[{
 "Because ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["I", "TI"]}], ",", 
   StyleBox["X", "TI"], ",", 
   StyleBox["Y", "TI"], ",", 
   RowBox[{
    StyleBox["Z", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "294c3d42-a4be-46dc-b2d8-8c753b3a1760"],
 " is orthogonal under the Hilbert-Schmidt product, any ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1224beaa-33d4-4be8-aa91-154ce6e8b367"],
 " operator ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28583ddc-7e3b-485e-bcba-f91598e6d795"],
 " has a unique Pauli expansion ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   UnderscriptBox["\[Sum]", 
    StyleBox["j", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["j", "TI"]], " ", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08d6ae44-adf6-436e-8043-b5f3eedbcb80"],
 " with coefficients ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["j", "TI"]], "=", 
   FractionBox["1", "2"], 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["j", "TI"]], 
    StyleBox["A", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59c80a42-9124-4d15-b2ab-fbfaa2f812ce"],
 " (the ",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1bf9fa4-a58a-468e-91b6-fb6cf1bf2192"],
 " is ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["j", "TI"]], ",", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d76f027-d449-4171-b504-12c81dbb8e2f"],
 ")."
}], "Text",ExpressionUUID->"aff36777-e06e-4f02-907a-36fb51b83445"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : compute the four coefficients directly from the definition."
}], "Text",ExpressionUUID->"dd88fe10-05e9-45fe-9a1c-b6d5613c4b11"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"aa", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a1", ",", " ", 
         RowBox[{"a2", " ", "+", " ", 
          RowBox[{"I", " ", "a3"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a2", " ", "-", " ", 
          RowBox[{"I", " ", "a3"}]}], ",", " ", "a4"}], "}"}]}], "}"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<I\>\"", ",", " ", "\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", 
       " ", "\"\<Z\>\""}], "}"}], ",", " ", 
     RowBox[{"FullSimplify", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", 
            RowBox[{"PauliMatrix", "[", "j", "]"}], "]"}], " ", ".", " ", 
           "aa"}], "]"}], "/", "2"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[52]:= ",ExpressionUUID->"5eecd503-2821-4146-9714-616e1d13741d"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the operator decomposes itself."
}], "Text",ExpressionUUID->"a2ff92e5-28bb-4cd2-9927-856574255f1d"],

Cell[BoxData[
 RowBox[{"FullSimplify", " ", "/@", " ", 
  RowBox[{
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a1", ",", " ", 
        RowBox[{"a2", " ", "+", " ", 
         RowBox[{"I", " ", "a3"}]}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a2", " ", "-", " ", 
         RowBox[{"I", " ", "a3"}]}], ",", " ", "a4"}], "}"}]}], "}"}], "]"}], 
   "[", "\"\<PauliDecompose\>\"", "]"}]}]], "Input",
 CellLabel->
  "In[53]:= ",ExpressionUUID->"9d9298c1-57a2-4752-9d16-e7ddb62715de"],

Cell[TextData[{
 "Both return the coefficients ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     StyleBox["I", "TI"]}], ":", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["a", "TI"], "1"], "+", 
      SubscriptBox[
       StyleBox["a", "TI"], "4"]}], "2"]}], ",", " ", 
   RowBox[{
    StyleBox["X", "TI"], ":", 
    SubscriptBox[
     StyleBox["a", "TI"], "2"]}], ",", " ", 
   RowBox[{
    StyleBox["Y", "TI"], ":", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["a", "TI"], "3"]}]}], ",", " ", 
   RowBox[{
    StyleBox["Z", "TI"], ":", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox[
        StyleBox["a", "TI"], "1"], "-", 
       SubscriptBox[
        StyleBox["a", "TI"], "4"]}], "2"], "}"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "acf5debd-86de-45a9-97ba-b2b1eec7a6c6"],
 ": the generic Hermitian operator is exactly ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    RowBox[{
     SubscriptBox[
      StyleBox["a", "TI"], "1"], "+", 
     SubscriptBox[
      StyleBox["a", "TI"], "4"]}], "2"], 
   StyleBox["I", "TI"], "+", 
   SubscriptBox[
    StyleBox["a", "TI"], "2"], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["x", "TI"]], "-", 
   SubscriptBox[
    StyleBox["a", "TI"], "3"], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["y", "TI"]], "+", 
   FractionBox[
    RowBox[{
     SubscriptBox[
      StyleBox["a", "TI"], "1"], "-", 
     SubscriptBox[
      StyleBox["a", "TI"], "4"]}], "2"], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90ad57f5-a678-4865-80e8-b095a1c262cf"],
 "."
}], "Text",ExpressionUUID->"707182f8-d238-4344-883c-7ccfa7e35813"],

Cell["\<\
2.11 [BSc] How do I bound the ground-state energy from above using a trial \
state (the Rayleigh-Ritz variational method)?\
\>", "Subsection",ExpressionUUID->"ae17efd7-8ba1-49e5-82ed-875e5fa25c5b"],

Cell[TextData[{
 "The variational method estimates the ground-state energy ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eea66f8a-934d-4e8b-81f1-f84818894b23"],
 " from above using a guessed ",
 StyleBox["trial state", "TI"],
 " ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b961759e-9fc1-43b9-93bf-29db77a9c859"],
 ", without solving the eigenproblem. The key fact is that the ",
 StyleBox["Rayleigh quotient",
  FontWeight->"Bold"],
 " is an upper bound on ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "048db35d-a5bc-4432-8414-29329ff3f6a7"],
 ","
}], "Text",ExpressionUUID->"1e3721c9-dbee-4478-bf57-47a97766f380"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["E", "TI"], 
     StyleBox["[",
      SpanMaxSize->1], 
     StyleBox["\[Psi]", "TI"], 
     StyleBox["]",
      SpanMaxSize->1]}], "\[ThickSpace]", "=", "\[ThickSpace]", 
    RowBox[{
     FractionBox[
      RowBox[{
       TemplateBox[{
         StyleBox["\[Psi]", "TI"]},
        "Bra"], 
       StyleBox["H", "TI"], 
       TemplateBox[{
         StyleBox["\[Psi]", "TI"]},
        "Ket"]}], 
      TemplateBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["\[Psi]", "TI"]},
       "BraKet"]], "\[ThickSpace]", "\[GreaterEqual]", "\[ThickSpace]", 
     SubscriptBox[
      StyleBox["E", "TI"], "0"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"1b3a0436-d7ca-4e4f-\
af56-3c3f580a24db"],

Cell[TextData[{
 "with equality only when ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2053175-372b-4e11-8204-e9bb194840b5"],
 " is the ground state. (Expanding ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["n", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     SubscriptBox[
      StyleBox["c", "TI"], 
      StyleBox["n", "TI"]], 
     TemplateBox[{
       StyleBox["n", "TI"]},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1b1e171-bdee-4b04-a292-08831b65ca60"],
 " in the energy eigenbasis, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["H", "TI"], 
    TemplateBox[{
      StyleBox["n", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"]], 
    TemplateBox[{
      StyleBox["n", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd04ca2d-6533-48ce-9b83-8b09fe18c294"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "0"], "\[LessEqual]", 
   SubscriptBox[
    StyleBox["E", "TI"], "1"], "\[LessEqual]", "\[CenterDot]", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "995b53d0-111c-4791-9a38-092d451bbc01"],
 ", makes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["\[Psi]", "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166a11cf-eb11-4f98-b23f-afc8b4cdec80"],
 " a weighted average of the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c945c3f-3253-4e17-aecf-6bb9702c0050"],
 ", which cannot fall below the smallest.) ",
 StyleBox["Rayleigh-Ritz", "TI"],
 " is the recipe that turns the bound into an estimate: take a parametrized \
family of trial states and ",
 StyleBox["minimize",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["\[Psi]", "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f31b2048-986b-4e5e-a6b2-7be03215ff14"],
 " over the parameters; the minimum is the lowest, hence best, upper bound \
that family can give. Below the trial state is normalized, so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"], 
     StyleBox["\[Psi]", "TI"]},
    "BraKet"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0544e53e-5722-449f-b5da-5c733af2f6ee"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["E", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    StyleBox["\[Psi]", "TI"], 
    StyleBox["]",
     SpanMaxSize->1]}], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Bra"], 
    StyleBox["H", "TI"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34c7d5f1-c5c3-4fc0-9284-552b974f5b31"],
 "."
}], "Text",ExpressionUUID->"418b77f1-9a75-4618-bb4d-c20de09c4f9c"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the trial energy over a one-parameter family."
}], "Text",ExpressionUUID->"cd70a380-8cf2-44db-bb1a-bcea2eced658"],

Cell[BoxData[
 RowBox[{"exp", " ", "=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"h", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", " ", 
      RowBox[{"psi", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "t", "]"}], ",", " ", 
         RowBox[{"Sin", "[", "t", "]"}]}], "}"}]}]}], "}"}], ",", "\n", "  ", 
    
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", "psi", "]"}], " ", ".", " ", "h", " ", ".", 
       " ", "psi"}], ",", " ", 
      RowBox[{"t", " ", "\[Element]", " ", "Reals"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[54]:= ",ExpressionUUID->"f9abd62b-fca0-4c4f-98b8-7398de14570c"],

Cell["The true ground energy is the lowest eigenvalue.", "Text",ExpressionUUID->"7c349b67-54b8-421c-9c6e-714cc07c1c32"],

Cell[BoxData[
 RowBox[{"e0", " ", "=", " ", 
  RowBox[{"Min", "[", 
   RowBox[{"Eigenvalues", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}]}], "}"}], "]"}], "]"}]}]], "Input",
 CellLabel->
  "In[55]:= ",ExpressionUUID->"040e6d81-f493-4422-bdf1-9414f99547d1"],

Cell["Minimizing the trial energy reaches that bound.", "Text",ExpressionUUID->"80bded2e-46f2-44bc-88e3-c7dee666c7c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Minimize", "[", 
    RowBox[{"exp", ",", " ", "t"}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", "e0"}]], "Input",
 CellLabel->
  "In[56]:= ",ExpressionUUID->"39d7bc4d-93cb-4b8c-beb4-eaed0edb07bc"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the Hamiltonian as a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4685df2e-a990-4603-8370-74fb74a913f7"],
 ", the trial energy as a bra-operator-ket scalar."
}], "Text",ExpressionUUID->"03dab29e-5ece-4ab1-84b9-a8c595441a74"],

Cell[BoxData[
 RowBox[{"expQF", " ", "=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"h", " ", "=", " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"-", "1"}]}], "}"}]}], "}"}], "]"}]}], ",", " ", 
      RowBox[{"ps", " ", "=", " ", 
       RowBox[{"QuantumState", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "t", "]"}], ",", " ", 
          RowBox[{"Sin", "[", "t", "]"}]}], "}"}], "]"}]}]}], "}"}], ",", 
    "\n", "  ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"ps", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
         RowBox[{"h", " ", "@", " ", "ps"}]}], ")"}], "[", "\"\<Scalar\>\"", 
       "]"}], ",", " ", 
      RowBox[{"t", " ", "\[Element]", " ", "Reals"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[57]:= ",ExpressionUUID->"cd0c4347-f297-4295-8972-5b34fbe2a3f7"],

Cell["The ground energy from the operator's eigenvalues.", "Text",ExpressionUUID->"b82742a3-1855-4f11-a78a-88cbdc014662"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}]}], "}"}], "]"}], 
   "[", "\"\<Eigenvalues\>\"", "]"}], " ", "//", " ", "Min"}]], "Input",
 CellLabel->
  "In[58]:= ",ExpressionUUID->"0b0d45d3-1a2f-4cad-abbc-1445cd1ab1ae"],

Cell["And the variational minimum reaches it.", "Text",ExpressionUUID->"fa5a4252-5c6e-47bb-9a8f-dc12f5921094"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Minimize", "[", 
    RowBox[{"expQF", ",", " ", "t"}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", 
  RowBox[{"Min", "[", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}], "]"}], 
    "[", "\"\<Eigenvalues\>\"", "]"}], "]"}]}]], "Input",
 CellLabel->
  "In[59]:= ",ExpressionUUID->"274fd26e-7955-48e9-a21d-4270dec989f3"],

Cell[TextData[{
 "Both give the trial energy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", "2", 
   StyleBox["t", "TI"], "+", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "2", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5544a351-6e9b-401e-8877-b4d43d07cddb"],
 ", the true ground energy ",
 Cell[BoxData[
  RowBox[{"-", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d69c10fb-940c-47cd-a7c3-bc22dbe4d46f"],
 ", and ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9521c15-e39f-43ac-af3d-ed3d9f0177b9"],
 ": the minimum over the trial family reaches ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7b42dcc-c2d5-4d38-a652-4073ca9d19e3"],
 ", so the variational estimate is an upper bound that is tight here."
}], "Text",ExpressionUUID->"317bee17-fcdf-49d9-ba50-8773581b4199"],

Cell["\<\
2.12 [MSc] How do I compute first- and second-order energy shifts by \
non-degenerate time-independent perturbation theory?\
\>", "Subsection",ExpressionUUID->"12142c24-4574-420e-9408-31e0e621c099"],

Cell[TextData[{
 "Perturbation theory finds the spectrum of a Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   SubscriptBox[
    StyleBox["H", "TI"], "0"], "+", 
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["V", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06302b08-a108-4206-aad0-c92567854b04"],
 " that sits a small perturbation ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\[Lambda]", "V"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a3afb3c-3027-43ca-8440-54627cd14914"],
 " away from a solvable one ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["H", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26a18a03-72b3-4921-a3c4-a71d41488d44"],
 ", whose eigenstates ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["n", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f64a262-a62b-4f37-9998-a05c25f46c6b"],
 " and energies ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "527ad50f-a277-401c-819e-babac0cc0856"],
 " are already known. Turning on ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6766af01-bf57-4d49-bc4f-36b6bbe93431"],
 " shifts each energy, and the shift is expanded in powers of ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c0e53a8-3a80-48b3-823f-ab8b40c01871"],
 ","
}], "Text",ExpressionUUID->"342b2754-bcf8-47a0-96cf-c682e9595ad9"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Lambda]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThickSpace]", "=", "\[ThickSpace]", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"]], "+", 
    StyleBox["\[Lambda]", "TI"], " ", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "1", 
      StyleBox[")",
       SpanMaxSize->1]}]], "+", 
    SuperscriptBox[
     StyleBox["\[Lambda]", "TI"], "2"], 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "2", 
      StyleBox[")",
       SpanMaxSize->1]}]], "+", "\[CenterEllipsis]"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"46e0fdeb-c86e-4ae9-\
82e6-f74fb447ad89"],

Cell["\<\
with the first- and second-order coefficients (the Rayleigh-Schrodinger \
shifts)\
\>", "Text",ExpressionUUID->"73f3f2a3-81db-47d3-804b-84f7a4046cfe"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "1", 
      StyleBox[")",
       SpanMaxSize->1]}]], "=", 
    RowBox[{
     TemplateBox[{
       StyleBox["n", "TI"]},
      "Bra"], 
     StyleBox["V", "TI"], 
     TemplateBox[{
       StyleBox["n", "TI"]},
      "Ket"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["n", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "2", 
      StyleBox[")",
       SpanMaxSize->1]}]], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["m", "TI"], "\[NotEqual]", 
       StyleBox["n", "TI"]}],
      LimitsPositioning->False], 
     RowBox[{
      FractionBox[
       SuperscriptBox[GridBox[{
          {
           RowBox[{
            TemplateBox[{
              StyleBox["m", "TI"]},
             "Bra"], 
            StyleBox["V", "TI"], 
            TemplateBox[{
              StyleBox["n", "TI"]},
             "Ket"]}]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
       RowBox[{
        SubscriptBox[
         StyleBox["E", "TI"], 
         StyleBox["n", "TI"]], "-", 
        SubscriptBox[
         StyleBox["E", "TI"], 
         StyleBox["m", "TI"]]}]], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"53778ce0-2c75-4ef2-\
80b6-fee6f825c4b9"],

Cell[TextData[{
 "The first order is just the diagonal matrix element of ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "101ccb31-88f5-4d9a-88d3-18851b1b2242"],
 " in the unperturbed state ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["n", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087ee337-e713-4515-a5dd-0b71927544eb"],
 "; the second order sums the squared off-diagonal couplings ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      RowBox[{
       TemplateBox[{
         StyleBox["m", "TI"]},
        "Bra"], 
       StyleBox["V", "TI"], 
       TemplateBox[{
         StyleBox["n", "TI"]},
        "Ket"]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd09f5d3-2ea4-4c55-aea4-6b63c2302a54"],
 " over the other states, each divided by the energy gap ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["n", "TI"]], "-", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["m", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24f47440-fb1f-4a97-bc60-6b3e96b6cb13"],
 ". ",
 StyleBox["Non-degenerate", "TI"],
 " means the unperturbed energies ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a42fa48-9ac1-43fc-ba76-e3aa93173343"],
 " are distinct, so those gaps never vanish; degenerate levels require the \
separate treatment of 2.13."
}], "Text",ExpressionUUID->"92290d52-5e05-475e-b35c-530bfe706029"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the first-order shifts are the diagonal matrix elements."
}], "Text",ExpressionUUID->"bef4d4e5-d2e4-4f2f-842f-276c20be408c"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"V", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"w", ",", " ", "v"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Conjugate", "[", "v", "]"}], ",", " ", 
          RowBox[{"-", "w"}]}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"basis", " ", "=", " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Conjugate", "[", 
       RowBox[{"basis", "[", 
        RowBox[{"[", "n", "]"}], "]"}], "]"}], " ", ".", " ", "V", " ", ".", 
      " ", 
      RowBox[{"basis", "[", 
       RowBox[{"[", "n", "]"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[60]:= ",ExpressionUUID->"f131e3bf-7542-4349-a501-37d7071d25fa"],

Cell["\<\
The second-order shifts sum the off-diagonal couplings over the spectrum.\
\>", "Text",ExpressionUUID->"d9e92767-ac3b-4986-bd6d-29852fadfc3c"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"en", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"e1", ",", " ", "e2"}], "}"}]}], ",", " ", 
     RowBox[{"V", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"w", ",", " ", "v"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Conjugate", "[", "v", "]"}], ",", " ", 
          RowBox[{"-", "w"}]}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"basis", " ", "=", " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"m", " ", "==", " ", "n"}], ",", " ", "0", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Conjugate", "[", 
              RowBox[{"basis", "[", 
               RowBox[{"[", "m", "]"}], "]"}], "]"}], " ", ".", " ", "V", " ",
              ".", " ", 
             RowBox[{"basis", "[", 
              RowBox[{"[", "n", "]"}], "]"}]}], "]"}], "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"en", "[", 
             RowBox[{"[", "n", "]"}], "]"}], " ", "-", " ", 
            RowBox[{"en", "[", 
             RowBox[{"[", "m", "]"}], "]"}]}], ")"}]}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[61]:= ",ExpressionUUID->"194f6411-6ac2-48a3-9c9b-74259934ed40"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the first-order shifts as bra-operator-ket scalars on the basis states."
}], "Text",ExpressionUUID->"9a62de48-8d30-4e77-a920-413b04271861"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"V", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"w", ",", " ", "v"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Conjugate", "[", "v", "]"}], ",", " ", 
           RowBox[{"-", "w"}]}], "}"}]}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"basis", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", 
        RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}]}], "}"}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"basis", "[", 
          RowBox[{"[", "n", "]"}], "]"}], "[", "\"\<Dagger\>\"", "]"}], " ", "@",
         " ", 
        RowBox[{"V", " ", "@", " ", 
         RowBox[{"basis", "[", 
          RowBox[{"[", "n", "]"}], "]"}]}]}], ")"}], "[", "\"\<Scalar\>\"", 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[62]:= ",ExpressionUUID->"f14e29c0-54db-438a-b3e3-cad9b5d1278a"],

Cell["The second-order shifts, same matrix elements summed.", "Text",ExpressionUUID->"9bbf2d4b-4526-4d70-ba32-e4397cc1c8ce"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"en", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"e1", ",", " ", "e2"}], "}"}]}], ",", " ", 
     RowBox[{"V", " ", "=", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"w", ",", " ", "v"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Conjugate", "[", "v", "]"}], ",", " ", 
           RowBox[{"-", "w"}]}], "}"}]}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"basis", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", 
        RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}]}], "}"}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"m", " ", "==", " ", "n"}], ",", " ", "0", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"basis", "[", 
                 RowBox[{"[", "m", "]"}], "]"}], "[", "\"\<Dagger\>\"", "]"}],
                " ", "@", " ", 
               RowBox[{"V", " ", "@", " ", 
                RowBox[{"basis", "[", 
                 RowBox[{"[", "n", "]"}], "]"}]}]}], ")"}], 
             "[", "\"\<Scalar\>\"", "]"}], "]"}], "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"en", "[", 
             RowBox[{"[", "n", "]"}], "]"}], " ", "-", " ", 
            RowBox[{"en", "[", 
             RowBox[{"[", "m", "]"}], "]"}]}], ")"}]}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[63]:= ",ExpressionUUID->"f8ac6ac9-95d6-4174-ae5f-1ec95a2028d9"],

Cell[TextData[{
 "Both give first-order shifts ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["w", "TI"]}], ",", 
   RowBox[{"-", 
    StyleBox["w", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1648bc0-16bf-493c-8d4f-59071d1750a0"],
 " (the diagonal of ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd5940dc-9c84-4a60-9323-fe569b17a19b"],
 ") and second-order shifts ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    FractionBox[
     SuperscriptBox[GridBox[{
        {
         StyleBox["v", "TI"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "1"], "-", 
      SubscriptBox[
       StyleBox["e", "TI"], "2"]}]], ",", " ", 
    FractionBox[
     SuperscriptBox[GridBox[{
        {
         StyleBox["v", "TI"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
     RowBox[{
      SubscriptBox[
       StyleBox["e", "TI"], "2"], "-", 
      SubscriptBox[
       StyleBox["e", "TI"], "1"]}]]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0d198f4-6aa6-4846-a7f6-db5054fd42ee"],
 ": the off-diagonal coupling pushes the levels apart, the lower one down and \
the upper one up."
}], "Text",ExpressionUUID->"ce7d52f9-d8ec-4270-913f-46e303fda83f"],

Cell["\<\
2.13 [MSc] How do I resolve an avoided crossing by degenerate perturbation \
theory (level repulsion)?\
\>", "Subsection",ExpressionUUID->"513a8be1-d530-4984-9e46-e580a4f32f5f"],

Cell[TextData[{
 "Where two diagonal levels would cross, an off-diagonal coupling ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "387e6ba0-c8be-4f7b-93e5-a729d7ae6d2c"],
 " opens a gap: the eigenvalues of ",
 Cell[BoxData[
  RowBox[{"(", GridBox[{
     {
      StyleBox["\[Lambda]", "TI"], "\[CapitalDelta]"},
     {"\[CapitalDelta]", 
      RowBox[{"-", 
       StyleBox["\[Lambda]", "TI"]}]}
    }], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76738ff0-d901-4e03-a3f3-d94fd9f8ef53"],
 " are ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalDelta]", "2"], "+", 
     SuperscriptBox[
      StyleBox["\[Lambda]", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f742aba0-0e85-4b98-aaf4-be2e16130f3d"],
 ". At the would-be crossing ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61f3e488-4203-450f-b5f4-d2caa1fdd882"],
 " the two levels are degenerate, and diagonalizing the coupling ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5abcb4fa-57ea-4343-9833-37fc57997e60"],
 " within that degenerate subspace is exactly first-order degenerate \
perturbation theory; in this ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f9439ed-1af8-4303-85a6-71af96c0d0e3"],
 " case the degenerate-subspace diagonalization and the exact diagonalization \
coincide, giving the split ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalDelta]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b2da917-fd9b-4d7f-8082-b8f4b734f9df"],
 " at the crossing."
}], "Text",ExpressionUUID->"c62e6340-afbe-44e4-8784-4efd30e2c42f"],

Cell[TextData[{
 StyleBox["WL",
  FontWeight->"Bold"],
 " : the two eigenvalues of the two-level Hamiltonian."
}], "Text",ExpressionUUID->"292d5d29-730e-42dd-ab06-6cd13e20ab68"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Lambda]", ",", " ", "\[CapitalDelta]"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", " ", 
         RowBox[{"-", "\[Lambda]"}]}], "}"}]}], "}"}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", "h", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Lambda]", " ", "|", " ", "\[CapitalDelta]"}], ")"}], " ", "\[Element]",
       " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[64]:= ",ExpressionUUID->"a03df987-00b2-4404-bb67-1521fdd0011e"],

Cell["Their difference is the gap.", "Text",ExpressionUUID->"17ebdb10-67e4-4fee-ab9d-0b008ba546ea"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Lambda]", ",", " ", "\[CapitalDelta]"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", " ", 
         RowBox[{"-", "\[Lambda]"}]}], "}"}]}], "}"}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Subtract", " ", "@@", " ", 
       RowBox[{"Eigenvalues", "[", "h", "]"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Lambda]", " ", "|", " ", "\[CapitalDelta]"}], ")"}], " ", "\[Element]",
       " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[65]:= ",ExpressionUUID->"62a819ec-c5ae-4167-afcd-4376b2c261bc"],

Cell[TextData[{
 StyleBox["QF",
  FontWeight->"Bold"],
 " : the eigenvalues through the operator."
}], "Text",ExpressionUUID->"df99db63-13b8-49ab-8414-36547517b256"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Lambda]", ",", " ", "\[CapitalDelta]"}], "}"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{"\[CapitalDelta]", ",", " ", 
          RowBox[{"-", "\[Lambda]"}]}], "}"}]}], "}"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"h", "[", "\"\<Eigenvalues\>\"", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Lambda]", " ", "|", " ", "\[CapitalDelta]"}], ")"}], " ", "\[Element]",
       " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[66]:= ",ExpressionUUID->"37b05a49-1374-4f9a-a638-4702ef59fe18"],

Cell["And the gap.", "Text",ExpressionUUID->"830e5a9e-8332-4490-8e27-b0ba47795680"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Lambda]", ",", " ", "\[CapitalDelta]"}], "}"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{"\[CapitalDelta]", ",", " ", 
          RowBox[{"-", "\[Lambda]"}]}], "}"}]}], "}"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Subtract", " ", "@@", " ", 
       RowBox[{"h", "[", "\"\<Eigenvalues\>\"", "]"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Lambda]", " ", "|", " ", "\[CapitalDelta]"}], ")"}], " ", "\[Element]",
       " ", "Reals"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[67]:= ",ExpressionUUID->"8d0bccab-abe3-4bb0-b7b8-03cf6957a6ee"],

Cell[TextData[{
 "Both give eigenvalues ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalDelta]", "2"], "+", 
     SuperscriptBox[
      StyleBox["\[Lambda]", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fdc066e6-495d-48e2-b0ca-b869757894db"],
 " and a gap ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalDelta]", "2"], "+", 
     SuperscriptBox[
      StyleBox["\[Lambda]", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6706de23-4037-4e25-b979-3983460d9d4e"],
 ". As ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "becd770e-9ab1-4467-9010-560a84b011af"],
 " sweeps through the would-be crossing at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80f0fe80-1b65-4aac-a4ee-dac7ea6166cf"],
 ", the gap shrinks only to ",
 Cell[BoxData[
  RowBox[{"2", "\[CapitalDelta]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d151d619-9225-4e50-92f8-8c74fe15dec2"],
 ", never to zero: the coupling turns the crossing into an avoided crossing."
}], "Text",ExpressionUUID->"02a20ba5-2d9a-4115-b1ef-0f7ac19a72cc"]
},
CreateCellID->True,
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (February 17, 2026)",
