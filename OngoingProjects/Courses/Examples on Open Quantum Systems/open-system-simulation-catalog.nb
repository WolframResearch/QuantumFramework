Cell[TextData[{
 "The ",
 StyleBox["trace distance",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["Tr",
    FontSlant->"Plain"], GridBox[{
     {
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "1"], "-", 
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "2"]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35466be2-b7a8-26dc-637d-82cfc2428c26"],
 " will measure how far a field sits from a classical mixture:"
}], "Text",
 CellID->2064137570,ExpressionUUID->"58bdea72-0ba3-5f4c-0842-0c3cae562596"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"traceDistance", "[", 
    RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"SingularValueList", "[", 
      RowBox[{"a", " ", "-", " ", "b"}], "]"}], "]"}], "/", "2"}]}], 
  ";"}]], "Input",
 CellLabel->"In[83]:= ",
 CellID->1265784226,ExpressionUUID->"6e8cef58-e908-949c-16b3-070588a2fee6"],

Cell[TextData[{
 "Because the singular values of any matrix sum to its trace norm, this is \
exactly ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["Tr",
    FontSlant->"Plain"], GridBox[{
     {
      RowBox[{
       StyleBox["a", "TI"], "-", 
       StyleBox["b", "TI"]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0abc4047-6c7b-4886-3a44-5a21050e1aec"],
 "; for the Hermitian difference of two states those singular values are the \
magnitudes of its eigenvalues."
}], "Text",
 CellID->872599864,ExpressionUUID->"24e21d63-fe6b-5877-4c91-954cfb1e2b5d"],

Cell[TextData[{
 "Now the machinery that makes the cat with an atom, three pieces on the \
joint atom-cavity space (atom first, cavity second). A ",
 StyleBox["Ramsey ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{"\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"348d2737-4aeb-e3cb-5cb2-bf716e9fb111"],
 StyleBox[" pulse",
  FontWeight->"Bold"],
 " rotates the atom by ",
 Cell[BoxData[
  RowBox[{"\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2161c865-0900-0907-571e-e24fa8b5586d"],
 " about ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["y", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cadbe4b-a339-c651-6452-3014d6cdacbb"],
 ", turning ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["g", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31169419-f57b-983b-672d-0e42fc0feb01"],
 " into an equal superposition:"
}], "Text",
 CellID->2056057710,ExpressionUUID->"40aa99e8-53bd-499c-70a9-10b266481be6"],

