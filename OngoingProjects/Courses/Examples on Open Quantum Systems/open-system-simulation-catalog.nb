     SuperscriptBox[GridBox[{
        {
         StyleBox["z", "TI"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
     RowBox[{"4", 
      RowBox[{
       SuperscriptBox[GridBox[{
          {
           StyleBox["\[Alpha]", "TI"]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->768596373,ExpressionUUID->"60d4995f-bb7f-b80c-10eb-11193e0b0b56"],

Cell[TextData[{
 "For the ",
 Cell[BoxData["\[ScriptL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64608bbe-760c-8af3-0c1f-22f803bed8d9"],
 "th superdiagonal of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09661063-a2cf-675e-3f1d-8a4cd77a4da4"],
 ", define the radial Laguerre sum"
}], "Text",
 CellID->1985169054,ExpressionUUID->"5561d787-26b0-8d0a-031e-cee1534ad450"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["F", "TI"], "\[ScriptL]"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["b", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["m", "TI"], "=", "0"}], 
      RowBox[{
       StyleBox["n", "TI"], "-", "\[ScriptL]", "-", "1"}],
      LimitsPositioning->False], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], 
       RowBox[{
        StyleBox["m", "TI"], ",", 
        RowBox[{
         StyleBox["m", "TI"], "+", "\[ScriptL]"}]}]], 
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"-", "1"}], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       StyleBox["m", "TI"]], 
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{
          StyleBox["m", "TI"], "!"}], "\[ThinSpace]", 
         RowBox[{"\[ScriptL]", "!"}]}], 
        RowBox[{
         RowBox[{
          StyleBox["(",
           SpanMaxSize->1], 
          RowBox[{
           StyleBox["m", "TI"], "+", "\[ScriptL]"}], 
          StyleBox[")",
           SpanMaxSize->1]}], "!"}]]], "\[ThinSpace]", 
      SubsuperscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["m", "TI"], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], "\[ScriptL]", 
        StyleBox[")",
         SpanMaxSize->1]}]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["b", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->770675313,ExpressionUUID->"0fea91e8-e80e-a1ed-35e9-08b589b8f337"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["L", "TI"], 
   StyleBox["m", "TI"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], "\[ScriptL]", 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37725419-c8bf-c4cd-5d02-4e42e94bae17"],
 " is a generalized Laguerre polynomial. The complete Wigner function is \
then"
}], "Text",
 CellID->846554368,ExpressionUUID->"6eee5857-8f9d-bf63-1696-52112a290249"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["W", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox["1", "\[Pi]"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["b", "TI"], "/", "2"}]], "\[ThinSpace]", 
    StyleBox["Re",
     FontSlant->"Plain"], "[", 
    RowBox[{
     SubscriptBox[
      StyleBox["F", "TI"], "0"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["b", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], "+", "2", 
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"\[ScriptL]", "=", "1"}], 
      RowBox[{
       StyleBox["n", "TI"], "-", "1"}],
      LimitsPositioning->False], 
     FractionBox[
      SuperscriptBox[
       StyleBox["z", "TI"], "\[ScriptL]"], 
      SqrtBox[
       RowBox[{"\[ScriptL]", "!"}]]], 
     SubscriptBox[
      StyleBox["F", "TI"], "\[ScriptL]"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["b", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "]"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1952818843,ExpressionUUID->"2635f536-2fc9-ab3c-4fca-ed704a7df606"],

Cell[TextData[{
 "In other words, the recurrence computes the radial function ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], "\[ScriptL]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3760e9-4a32-92b2-4acd-79b36fc4e098"],
 " for one diagonal of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fe93a8-4ee9-5b9e-3c85-0af26a9c29e4"],
 "; the powers ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["z", "TI"], "\[ScriptL]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11cf5d11-52cc-ddbb-47f5-555b677ea781"],
 " supply the angular dependence, and the Gaussian ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["b", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ba8138a-66ce-478c-2957-8ad4137b2dd6"],
 " supplies the envelope. Build the whole evaluation as one function: the \
Laguerre recurrence lives inside as a local helper, the input may be a state \
vector or a density matrix (a vector becomes its density matrix first), and \
the cutoff is read off the input's size. Each grid value evaluates the \
finite-cutoff expression; the returned interpolating function is a numerical \
approximation between those grid points, with a wide enough frame that its \
far corners stay clean:"
}], "Text",
 CellID->599175116,ExpressionUUID->"35c9e6d4-f3c4-84c1-63f6-ff918676ee2b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"wignerRepresentation", "[", 
    RowBox[{
     RowBox[{"psi_", "?", "VectorQ"}], ",", " ", "reach_", ",", " ", "pts_"}],
     "]"}], " ", ":=", " ", 
   RowBox[{"wignerRepresentation", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "psi", "]"}], ",", " ", "reach", ",", " ", 
     "pts"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wignerRepresentation", "[", 
    RowBox[{
     RowBox[{"rho_", "?", "MatrixQ"}], ",", " ", "reach_", ",", " ", "pts_"}],
     "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Length", "[", "rho", "]"}]}], ",", " ", "grid", ",", " ", 
       "a2", ",", " ", "b", ",", " ", "lag", ",", " ", "w"}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"grid", " ", "=", " ", 
       RowBox[{"N", "@", 
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"-", "reach"}], ",", " ", "reach", ",", " ", 
          RowBox[{"pts", " ", "-", " ", "1"}]}], "]"}]}]}], ";", "\n", "   ", 
      
      RowBox[{"a2", " ", "=", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "2.", "]"}], " ", 
        RowBox[{"Outer", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#2", " ", "+", " ", 
            RowBox[{"I", " ", "#1"}]}], " ", "&"}], ",", " ", "grid", ",", 
          " ", "grid"}], "]"}]}]}], ";", " ", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{
        RowBox[{"Abs", "[", "a2", "]"}], "^", "2"}]}], ";", "\n", "   ", 
      RowBox[{
       RowBox[{"lag", "[", 
        RowBox[{"L_", ",", " ", "c_"}], "]"}], " ", ":=", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", " ", "=", " ", 
           RowBox[{"Length", "[", "c", "]"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"Which", "[", "\n", "      ", 
          RowBox[{
           RowBox[{"m", " ", "==", " ", "1"}], ",", " ", 
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
            RowBox[{"0.", " ", "b"}]}], ",", "\n", "      ", 
           RowBox[{"m", " ", "==", " ", "2"}], ",", " ", 
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"c", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"1.", "/", 
               RowBox[{"(", 
                RowBox[{"L", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"L", " ", "+", " ", "1.", " ", "-", " ", "b"}], 
              ")"}]}]}], ",", "\n", "      ", "True", ",", " ", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"yy", " ", "=", " ", 
               RowBox[{"Fold", "[", 
                RowBox[{
                 RowBox[{"Function", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"y", ",", " ", "cj"}], "}"}], ",", " ", 
                   RowBox[{"With", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"j", " ", "=", " ", 
                    RowBox[{"cj", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\n", 
                    "           ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"cj", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
                    RowBox[{
                    RowBox[{"y", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"j", " ", "-", " ", "1."}], ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"L", " ", "+", " ", "j", " ", "-", " ", "1."}], 
                    ")"}]}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"L", " ", "+", " ", "j"}], ")"}], " ", "j"}], 
                    ")"}]}], "]"}]}]}], ",", "\n", "            ", 
                    RowBox[{
                    RowBox[{"y", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
                    RowBox[{
                    RowBox[{"y", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"L", " ", "+", " ", 
                    RowBox[{"2.", " ", "j"}], " ", "-", " ", "1", " ", "-", 
                    " ", "b"}], ")"}], " ", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"1.", "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"L", " ", "+", " ", "j"}], ")"}], " ", "j"}], 
                    ")"}]}], "]"}]}]}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", 
                 "         ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "2"}], "]"}], "]"}], " ", "+", " ", 
                    RowBox[{"0.", " ", "b"}]}], ",", " ", 
                   RowBox[{
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "1"}], "]"}], "]"}], " ", "+", " ", 
                    RowBox[{"0.", " ", "b"}]}]}], "}"}], ",", " ", 
                 RowBox[{"Transpose", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Reverse", "[", 
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", " ", 
                    RowBox[{"-", "3"}]}], "]"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"N", "@", 
                    RowBox[{"Range", "[", 
                    RowBox[{
                    RowBox[{"m", " ", "-", " ", "1"}], ",", " ", "2", ",", 
                    " ", 
                    RowBox[{"-", "1"}]}], "]"}]}]}], "}"}], "]"}]}], "]"}]}], 
              "}"}], ",", "\n", "        ", 
             RowBox[{
              RowBox[{"yy", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"yy", "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"1.", "/", 
                 RowBox[{"(", 
                  RowBox[{"L", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", 
               RowBox[{"(", 
                RowBox[{"L", " ", "+", " ", "1.", " ", "-", " ", "b"}], 
                ")"}]}]}]}], "]"}]}], "]"}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"w", " ", "=", " ", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"Fold", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"lag", "[", 
              RowBox[{
               RowBox[{"#2", " ", "-", " ", "1"}], ",", " ", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"#2", " ", "==", " ", "1"}], ",", " ", "1", ",", 
                  " ", "2"}], "]"}], " ", 
                RowBox[{"Diagonal", "[", 
                 RowBox[{"rho", ",", " ", 
                  RowBox[{"#2", " ", "-", " ", "1"}]}], "]"}]}]}], "]"}], " ",
              "+", " ", 
             RowBox[{"#1", " ", 
              RowBox[{"a2", "/", 
               RowBox[{"Sqrt", "[", "#2", "]"}]}]}]}], " ", "&"}], ",", "\n", 
           "       ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"2.", " ", 
              RowBox[{"rho", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", " ", 
                 RowBox[{"-", "1"}]}], "]"}], "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"pts", ",", " ", "pts"}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{"n", " ", "-", " ", "1"}], ",", " ", "1", ",", " ", 
             RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "b"}], "/", "2"}], "]"}], "/", "Pi"}]}]}], ";", "\n", 
      "   ", 
      RowBox[{"ListInterpolation", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", "w", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}]}], "}"}]}], 
       "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[70]:= ",
 CellID->1234886004,ExpressionUUID->"6fd66644-13e4-6fa7-15ee-782ea591358d"],

Cell[TextData[{
 "Check it on the vacuum, whose Wigner function is the closed form ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "\[Pi]"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["x", "TI"], "2"], "-", 
     SuperscriptBox[
      StyleBox["p", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00abf1cf-696b-3507-30a8-e8a9081f9c6d"],
 ", feeding the state vector directly:"
}], "Text",
 CellID->1955603644,ExpressionUUID->"03d898fe-d35a-9eef-31e7-11bbe6ece435"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"w", " ", "=", " ", 
     RowBox[{"wignerRepresentation", "[", 
      RowBox[{
       RowBox[{"coherentState", "[", 
        RowBox[{"8", ",", " ", "0"}], "]"}], ",", " ", "3.", ",", " ", "25"}],
       "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Max", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"w", "[", 
         RowBox[{"xx", ",", " ", "pp"}], "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "Pi"}], ")"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"xx", "^", "2"}]}], " ", "-", " ", 
           RowBox[{"pp", "^", "2"}]}], "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"xx", ",", " ", 
        RowBox[{"-", "2"}], ",", " ", "2", ",", " ", "0.5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"pp", ",", " ", 
        RowBox[{"-", "2"}], ",", " ", "2", ",", " ", "0.5"}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[71]:= ",
 CellID->529524776,ExpressionUUID->"03dda600-4b0b-c3af-31e2-386a6ebf91f5"],

Cell["\<\
The sampled discrepancy is at floating-point precision on the grid's own \
points; between grid nodes, accuracy is limited by the interpolation \
resolution.\
\>", "Text",
 CellID->186212144,ExpressionUUID->"4de38b79-ee67-8bee-7b90-23228b13d934"],

Cell[TextData[{
 "Wigner pictures are compared, across times or across states, and the \
comparison is only honest on one shared color scale. The plotter takes a list \
of Wigner interpolating functions and a label per member, finds the largest \
",
 Cell[BoxData[GridBox[{
    {
     StyleBox["W", "TI"]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "347cf1ed-0cc4-b4dc-5c03-e8b7a5761e26"],
 " over the whole list, and draws every panel and the bar legend with the \
same diverging map: a light neutral at zero so empty phase space reads as \
empty, warm (orange) for positive, cold (blue) for negative, with the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d81b9ce-3a4c-aa2a-2bbe-30a8bffef970"],
 " contour drawn as a thin gray line so the sign change is unmistakable. An \
optional color map replaces the default; it receives the signed fraction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], "/", 
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", GridBox[{
     {
      StyleBox["W", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bb9b374-9caf-337d-1946-2b3e155b9e47"],
 " in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", "1"}], ",", "1"}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c340229-13f4-0181-15cb-a473a58153eb"],
 ":"
}], "Text",
 CellID->284725946,ExpressionUUID->"25dfa134-0866-9bb5-53e4-397ea910e99f"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "wignerPlot", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wignerPlot", "[", 
    RowBox[{
     RowBox[{"ws", " ", ":", " ", 
      RowBox[{"{", "__InterpolatingFunction", "}"}]}], ",", " ", 
     "labels_List", ",", " ", 
     RowBox[{"color_", " ", ":", " ", "Automatic"}]}], "]"}], " ", ":=", "\n",
    "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#", "[", "\"\<ValuesOnGrid\>\"", "]"}], "]"}], " ", 
           "&"}], " ", "/@", " ", "ws"}], "]"}]}], ",", " ", 
       RowBox[{"reach", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"ws", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<Domain\>\"", "]"}], 
          "]"}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"cf", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"color", " ", "===", " ", "Automatic"}], ",", "\n", 
          "      ", 
          RowBox[{
           RowBox[{"Blend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", " ", 
                 RowBox[{"RGBColor", "[", 
                  RowBox[{"0.15", ",", " ", "0.4", ",", " ", "0.8"}], "]"}]}],
                 "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"0", ",", " ", 
                 RowBox[{"GrayLevel", "[", "0.97", "]"}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"1", ",", " ", 
                 RowBox[{"RGBColor", "[", 
                  RowBox[{"0.9", ",", " ", "0.45", ",", " ", "0.1"}], "]"}]}],
                 "}"}]}], "}"}], ",", " ", "#"}], "]"}], " ", "&"}], ",", " ",
           "color"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"raw", " ", "=", " ", 
         RowBox[{
          RowBox[{"cf", "[", 
           RowBox[{"#", "/", "m"}], "]"}], " ", "&"}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"Legended", "[", 
        RowBox[{
         RowBox[{"GraphicsRow", "[", 
          RowBox[{"MapThread", "[", "\n", "       ", 
           RowBox[{
            RowBox[{
             RowBox[{"Show", "[", 
              RowBox[{
               RowBox[{"DensityPlot", "[", 
                RowBox[{
                 RowBox[{"#1", "[", 
                  RowBox[{"xx", ",", " ", "pp"}], "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"xx", ",", " ", 
                   RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{"pp", ",", " ", 
                   RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}], ",", 
                 " ", 
                 RowBox[{"PlotPoints", " ", "->", " ", "55"}], ",", "\n", 
                 "          ", 
                 RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
                 RowBox[{"ColorFunction", " ", "->", " ", "raw"}], ",", " ", 
                 RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",",
                  "\n", "          ", 
                 RowBox[{"FrameLabel", " ", "->", " ", 
                  RowBox[{"{", 
                   RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",",
                  " ", 
                 RowBox[{"PlotLabel", " ", "->", " ", "#2"}]}], "]"}], ",", 
               "\n", "         ", 
               RowBox[{"ContourPlot", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#1", "[", 
                   RowBox[{"xx", ",", " ", "pp"}], "]"}], " ", "==", " ", 
                  "0"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"xx", ",", " ", 
                   RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{"pp", ",", " ", 
                   RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}], ",", 
                 "\n", "          ", 
                 RowBox[{"ContourStyle", " ", "->", " ", 
                  RowBox[{"Directive", "[", 
                   RowBox[{"Thin", ",", " ", "Gray"}], "]"}]}], ",", " ", 
                 RowBox[{"PlotPoints", " ", "->", " ", "40"}]}], "]"}]}], 
              "]"}], " ", "&"}], ",", "\n", "       ", 
            RowBox[{"{", 
             RowBox[{"ws", ",", " ", "labels"}], "}"}]}], "]"}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"BarLegend", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"raw", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "m"}], ",", " ", "m"}], "}"}]}], "}"}], ",", " ", 
           
           RowBox[{"LegendMarkerSize", " ", "->", " ", "130"}]}], "]"}]}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wignerPlot", "[", 
    RowBox[{"w_InterpolatingFunction", ",", " ", "label_", ",", " ", 
     RowBox[{"color_", " ", ":", " ", "Automatic"}]}], "]"}], " ", ":=", " ", 
   
   RowBox[{"wignerPlot", "[", 
    RowBox[{
     RowBox[{"{", "w", "}"}], ",", " ", 
     RowBox[{"{", "label", "}"}], ",", " ", "color"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[72]:= ",
 CellID->1006536905,ExpressionUUID->"425139cc-45a5-cefb-726e-b0966c5194c1"],

Cell["A Cavity Cat, and Why It Decoheres Almost at Once", "Subsection",
 CellID->207506748,ExpressionUUID->"4d922994-f334-45bb-7ba1-c0d186c12f81"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A single leaky mode of light (a cavity dribbling photons), with no drive:"
}], "Text",
 CellID->1146295856,ExpressionUUID->"06c25578-1780-b25e-2ef2-4d22a23a00a4"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", 
    StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->438365529,ExpressionUUID->"5f70617e-b140-9f95-0500-793bc0fae5ff"],

Cell[TextData[{
 "A lone coherent state only shrinks, staying pure, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Alpha]", "TI"]},
    "Ket"], "\[Rule]", 
   TemplateBox[{
     RowBox[{
       StyleBox["\[Alpha]", "TI"], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
          StyleBox["\[Gamma]", "TI"], 
          StyleBox["t", "TI"], "/", "2"}]]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79d0371a-30a6-04e5-2fef-af4441536ecf"],
 ", but a ",
 StyleBox["cat", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Alpha]", "TI"]},
    "Ket"], "+", 
   TemplateBox[{
     StyleBox["\[Beta]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d950d76-dd18-2b24-2baa-a533d4ad760e"],
 " of two well-separated amplitudes keeps its cross-term only through a \
coherence factor"
}], "Text",
 CellID->174000849,ExpressionUUID->"7234a9f4-3232-6781-23cb-40be47c74deb"],

Cell[BoxData[
 PaneBox[
  RowBox[{GridBox[{
     {
      RowBox[{
       StyleBox["C", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", 
   StyleBox["exp",
    FontSlant->"Plain"], "\[ThinSpace]", "(", 
   RowBox[{"-", 
    FractionBox["1", "2"], "\[ThinSpace]", 
    SuperscriptBox[GridBox[{
       {
        RowBox[{
         StyleBox["\[Alpha]", "TI"], "-", 
         StyleBox["\[Beta]", "TI"]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["t", "TI"]}]]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ")", "\[ThickSpace]", "\[TildeTilde]", 
   "\[ThickSpace]", 
   StyleBox["exp",
    FontSlant->"Plain"], "\[ThinSpace]", "(", 
   RowBox[{"-", 
    FractionBox["1", "2"], "\[ThinSpace]", 
    SuperscriptBox[GridBox[{
       {
        RowBox[{
         StyleBox["\[Alpha]", "TI"], "-", 
         StyleBox["\[Beta]", "TI"]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "\[ThinSpace]", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["t", "TI"]}], ")", " ", 
   StyleBox[
    RowBox[{
     RowBox[{
     "at", "\[NonBreakingSpace]", "short", "\[NonBreakingSpace]", "time"}], ",",
      "\[ThinSpace]"}],
    FontSlant->"Plain"]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->766726627,ExpressionUUID->"42668d78-f434-72a4-721d-2525fdc1408e"],

Cell[TextData[{
 "so the coherence decays at a rate ",
 Cell[BoxData[
  RowBox[{"\[Proportional]", 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        StyleBox["\[Alpha]", "TI"], "-", 
        StyleBox["\[Beta]", "TI"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c7cc198-0ad8-2426-3403-d8c2af528f0c"],
 ", quadratic in the phase-space separation. Build it in a truncated Fock \
basis and watch the fringes vanish."
}], "Text",
 CellID->1506609767,ExpressionUUID->"69698b1d-3dc2-3628-1f16-2347b4749d72"],

Cell["Set a high cutoff and a cavity decay rate:", "Text",
 CellID->281363281,ExpressionUUID->"701e1eb7-eeba-61c8-2025-97f08b4f3312"],

Cell[BoxData[
 RowBox[{
  RowBox[{"topCat", " ", "=", " ", "30"}], ";", " ", 
  RowBox[{"blankCat", " ", "=", " ", 
   RowBox[{"IdentityMatrix", "[", "topCat", "]"}]}], ";", " ", 
  RowBox[{"downCat", " ", "=", " ", 
   RowBox[{"annihilation", "[", "topCat", "]"}]}], ";", " ", 
  RowBox[{"\[Gamma]cat", " ", "=", " ", "0.7"}], ";"}]], "Input",
 CellLabel->"In[73]:= ",
 CellID->1615544595,ExpressionUUID->"0e322415-281a-3695-37c1-be5f49ac9cff"],

Cell[TextData[{
 "First a single coherent state: under damping it stays coherent, its \
amplitude decaying as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[Rule]", 
   StyleBox["\[Alpha]", "TI"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61beb272-ef15-9663-1745-343f8aa1fd49"],
 ". Check that the damped state equals a fresh, smaller coherent state:"
}], "Text",
 CellID->1805673747,ExpressionUUID->"5e8a6a96-06b4-6465-0689-83d0b3414f4f"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"later", " ", "=", " ", 
     RowBox[{"evolve", "[", 
      RowBox[{
       RowBox[{"0", " ", "blankCat"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], "}"}], ",",
        " ", 
       RowBox[{"densityMatrix", "[", 
        RowBox[{"coherentState", "[", 
         RowBox[{"topCat", ",", " ", "2."}], "]"}], "]"}], ",", " ", "1.0"}], 
      "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"Conjugate", "[", 
      RowBox[{"coherentState", "[", 
       RowBox[{"topCat", ",", " ", 
        RowBox[{"2.", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Gamma]cat"}], "/", "2"}], "]"}]}]}], "]"}], "]"}], 
     " ", ".", " ", "later", " ", ".", " ", 
     RowBox[{"coherentState", "[", 
      RowBox[{"topCat", ",", " ", 
       RowBox[{"2.", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[Gamma]cat"}], "/", "2"}], "]"}]}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[74]:= ",
 CellID->1547520620,ExpressionUUID->"55951090-ef25-ccfd-03aa-89dd8ad196c7"],

Cell["Overlap one: a coherent state stays coherent.", "Text",
 CellID->858350929,ExpressionUUID->"53a2ca13-da2c-324e-0151-ec5cdfde8094"],

Cell[TextData[{
 "Now the interesting state, a ",
 StyleBox["cat",
  FontWeight->"Bold"],
 ", the superposition of two coherent states ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Alpha]", "TI"]},
    "Ket"], "+", 
   TemplateBox[{
     RowBox[{"-", 
       StyleBox["\[Alpha]", "TI"]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5930221d-821b-4026-08cf-c44737ae130c"],
 ":"
}], "Text",
 CellID->2138894257,ExpressionUUID->"76ba63e9-5df8-c241-1e5a-7ab3547290ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Alpha]", " ", "=", " ", "2."}], ";", " ", 
  RowBox[{"cat", " ", "=", " ", 
   RowBox[{"Normalize", "[", 
    RowBox[{
     RowBox[{"coherentState", "[", 
      RowBox[{"topCat", ",", " ", "\[Alpha]"}], "]"}], " ", "+", " ", 
     RowBox[{"coherentState", "[", 
      RowBox[{"topCat", ",", " ", 
       RowBox[{"-", "\[Alpha]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[75]:= ",
 CellID->1941039383,ExpressionUUID->"319e51f9-a9ce-1d21-67a6-48a2c87b640b"],

Cell[TextData[{
 "First a rigorous check on the solver. Amplitude damping has an exact \
operator-sum (Kraus) solution, summed over the number of photons lost ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f4962c-805e-a216-4e8b-087631e8f17c"],
 ","
}], "Text",
 CellID->1670620029,ExpressionUUID->"313d5a7b-7caf-7acc-60c3-5c25755a4816"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["\[Rho]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["m", "TI"], "\[GreaterEqual]", "0"}],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["m", "TI"]], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], "0"], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["m", "TI"], "\[Dagger]"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["m", "TI"]], "=", 
    RowBox[{
     SqrtBox[
      FractionBox[
       SuperscriptBox[
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{"1", "-", 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           RowBox[{"-", 
            StyleBox["\[Gamma]", "TI"], 
            StyleBox["t", "TI"]}]]}], 
         StyleBox[")",
          SpanMaxSize->1]}], 
        StyleBox["m", "TI"]], 
       RowBox[{
        StyleBox["m", "TI"], "!"}]]], "\[ThickSpace]", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["t", "TI"], "\[ThinSpace]", 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "\[Dagger]"], 
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "/", "2"}]], "\[ThinSpace]", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], 
      StyleBox["m", "TI"]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->588214459,ExpressionUUID->"2da78195-91be-94f0-5b5c-18df2048feda"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39c6b7ab-78e0-e73c-6ffd-2ef5789aca06"],
 " removing ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f7d0c35-7157-44bf-6502-a67f00e22e85"],
 " photons and ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["t", "TI"], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47b49f91-c3c7-4deb-6d4b-16daf6721731"],
 " shrinking the survivors; the set is trace-preserving, so it needs no \
renormalization. Write it:"
}], "Text",
 CellID->1759496502,ExpressionUUID->"064e3005-d89e-7c03-2e75-aa6ed92b4769"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"photonLoss", "[", 
    RowBox[{"rho0_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"shrink", " ", "=", " ", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Gamma]cat"}], " ", "t", " ", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"topCat", " ", "-", " ", "1"}]}], "]"}], "/", "2"}]}], 
          "]"}], "]"}]}], ",", " ", 
       RowBox[{"keep", " ", "=", " ", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Gamma]cat"}], " ", "t"}], "]"}]}]}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"M", " ", "=", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"keep", "^", 
              RowBox[{"(", 
               RowBox[{"m", "/", "2"}], ")"}]}], "/", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"m", "!"}], "]"}]}], " ", 
            RowBox[{"shrink", " ", ".", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"m", " ", "==", " ", "0"}], ",", " ", "blankCat", ",", 
               " ", 
               RowBox[{"MatrixPower", "[", 
                RowBox[{"downCat", ",", " ", "m"}], "]"}]}], "]"}]}]}]}], 
          "}"}], ",", "\n", "      ", 
         RowBox[{"M", " ", ".", " ", "rho0", " ", ".", " ", 
          RowBox[{"ConjugateTranspose", "[", "M", "]"}]}]}], "]"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", 
         RowBox[{"topCat", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[76]:= ",
 CellID->1641757231,ExpressionUUID->"76c2caed-aea0-13a2-1ef1-e3b6cb556188"],

Cell["\<\
Confirm the master equation and this Kraus sum agree on the cat:\
\>", "Text",
 CellID->896279625,ExpressionUUID->"260c3025-1fa9-9acd-4e33-a98f9a5de817"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "@", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"evolve", "[", 
      RowBox[{
       RowBox[{"0", " ", "blankCat"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], "}"}], ",",
        " ", 
       RowBox[{"densityMatrix", "[", "cat", "]"}], ",", " ", "0.6"}], "]"}], 
     " ", "-", " ", 
     RowBox[{"photonLoss", "[", 
      RowBox[{
       RowBox[{"densityMatrix", "[", "cat", "]"}], ",", " ", "0.6"}], "]"}]}],
     "]"}]}]}]], "Input",
 CellLabel->"In[77]:= ",
 CellID->1264190945,ExpressionUUID->"4b1e6c2c-0452-4134-7925-8676ade7101e"],

Cell["The discrepancy is at the numerical integration tolerance.", "Text",
 CellID->1806910998,ExpressionUUID->"2982aea8-af87-65d7-5fb1-47f5ca324f3d"],

