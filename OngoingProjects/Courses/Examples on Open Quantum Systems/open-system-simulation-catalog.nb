        " ", "4.2", ",", " ", "55"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "catTimes"}], "}"}]}], "]"}]}], ";"}]}], "Input",\

 CellLabel->"In[78]:= ",
 CellID->1660212291,ExpressionUUID->"6e8690e9-968f-68b3-16bd-09b3233a3a99"],

Cell["Draw it on one shared color scale:", "Text",
 CellID->1553450743,ExpressionUUID->"2b6bc1ec-c569-bd9f-5968-d8c9ec1d07e5"],

