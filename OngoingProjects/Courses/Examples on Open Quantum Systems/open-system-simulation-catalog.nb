        RowBox[{"-", "2", 
         StyleBox["\[Gamma]", "TI"]}]}
      }], ")"}]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["D", "TI"], "=", 
