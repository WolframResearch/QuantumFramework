       SubscriptBox[
        StyleBox["\[Rho]", "TI"], 
        StyleBox["N", "TI"]], ",", 
       SubscriptBox[
        StyleBox["\[Phi]", "TI"], 
        StyleBox["N", "TI"]]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], 
    StyleBox[")",
     FontSize->1.2 Inherited]}], ","}],
