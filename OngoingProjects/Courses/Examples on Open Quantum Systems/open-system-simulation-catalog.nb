  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1781880651,ExpressionUUID->"7c239bd0-3ff5-3b18-25d0-129ab9818662"],

Cell[TextData[{
 StyleBox["Markovian measurement feedback.",
  FontWeight->"Bold"],
 " For the feedback Hamiltonian ",
 Cell[BoxData[
