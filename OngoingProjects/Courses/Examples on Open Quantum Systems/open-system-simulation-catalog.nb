Cell[TextData[{
 StyleBox["Quantum Kalman filter.",
  FontWeight->"Bold"],
 " With ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["r", "TI"], "^"], "=", 
   SuperscriptBox[
