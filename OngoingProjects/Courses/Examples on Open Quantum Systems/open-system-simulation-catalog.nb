    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62752e4e-571f-d961-120a-c02862aba84b"],
 ", which spiral in to the steady state"
}], "Text",
 CellID->1525364821,ExpressionUUID->"34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]], "=", "0"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["y", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]], "=", 
    FractionBox[
     RowBox[{"2", "\[CapitalOmega]", 
      StyleBox["\[Gamma]", "TI"]}], 
     RowBox[{
      SuperscriptBox[
       StyleBox["\[Gamma]", "TI"], "2"], "+", "2", 
      SuperscriptBox["\[CapitalOmega]", "2"]}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["z", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]], "=", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox[
       StyleBox["\[Gamma]", "TI"], "2"], 
      RowBox[{
       SuperscriptBox[
        StyleBox["\[Gamma]", "TI"], "2"], "+", "2", 
       SuperscriptBox["\[CapitalOmega]", "2"]}]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1535108406,ExpressionUUID->"166277e1-e8de-815f-3e12-6eca8968d3a5"],

Cell[TextData[{
 "at the rate set by the eigenvalues ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "\[PlusMinus]"], "=", "-", 
   FractionBox[
    RowBox[{"3", 
     StyleBox["\[Gamma]", "TI"]}], "4"], "\[PlusMinus]", 
   StyleBox["i", "TI"], 
   OverscriptBox["\[CapitalOmega]", "~"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ae7a534-7379-468c-3a9c-3d7e060c2cd6"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox["\[CapitalOmega]", "~"], "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "-", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["\[Gamma]", "TI"], "/", "4"}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34baef30-7963-b757-5c59-077a78171dbd"],
 " (a damped oscillation once ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", ">", 
   StyleBox["\[Gamma]", "TI"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15ce0314-20ee-2b64-43f5-9b5e509b764e"],
 "). Solve it and watch the spiral."
}], "Text",
 CellID->1528788962,ExpressionUUID->"38a9ac88-4644-6c0e-6856-45d273f13754"],

Cell[TextData[{
 "Now both terms at once: a laser drive about ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64802aa2-b136-451c-0cbf-c30fc0c32c66"],
 " and spontaneous emission through ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], "-"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"],
 ". Read the Bloch equations:"
}], "Text",
 CellID->1505774531,ExpressionUUID->"233ecb8e-17f3-8d32-52c5-e2e8a187d418"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"\[Gamma]", ",", " ", "\[CapitalOmega]"}], "]"}], ";", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"rates", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}], "}"}]}], 
     "]"}], ",", " ", 
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]}]], "Input",
 CellLabel->"In[49]:= ",
 CellID->535490749,ExpressionUUID->"7dd949a9-d8cf-50b3-2be7-60f2d97a2299"],

Cell[TextData[{
 "The component ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],
 " decays; the drive couples ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "598f41e5-f1df-a461-0fb5-58ce806b0f4b"],
 " and ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e0f0df5-2071-c96f-4634-a4bf51059bb5"],
 " while emission pulls ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f6e12d5-e3b9-0bb9-2515-8b9e964c5983"],
 " toward the ground state. This has a unique steady state. Find it by \
setting all three rates to zero:"
}], "Text",
 CellID->1238905205,ExpressionUUID->"41ecc127-3c02-05fa-7793-d881b5b76fc0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"steady", " ", "=", " ", 
   RowBox[{"First", "@", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"rates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}], "}"}]}], 
         "]"}], " ", "==", " ", "0"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[50]:= ",
 CellID->2125008310,ExpressionUUID->"1190ff72-a9fe-60f8-47af-f73fcf8b32c2"],

Cell["Read the steady state in closed form:", "Text",
 CellID->1684656716,ExpressionUUID->"19c80315-d7de-7125-4ff7-9b5ee26b400f"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "/.", " ", 
    "steady"}], ",", " ", 
   RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[51]:= ",
 CellID->2057792111,ExpressionUUID->"6fdf78a7-59a9-97d9-15e5-7101585dfd23"],

Cell["\<\
The steady state in closed form: no transverse lean, and a tilt set by the \
ratio of drive to emission.\
\>", "Text",
 CellID->408837332,ExpressionUUID->"7a87483f-bfa4-2eb6-2abd-62793a51749c"],

Cell["\<\
How is it approached? The Bloch equations are linear, so the approach is set \
by the eigenvalues of their drift matrix:\
\>", "Text",
 CellID->1068510841,ExpressionUUID->"09b26917-59e6-8729-3f41-81515f90ea73"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Eigenvalues", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"rates", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}], "}"}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], "}"}]}], "]"}], 
    "]"}], ",", " ", 
   RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[52]:= ",
 CellID->1027032549,ExpressionUUID->"521ad179-838d-ce9b-0239-c923363994e1"],

Cell[TextData[{
 "Two are complex conjugates: a ",
 StyleBox["spiral",
  FontWeight->"Bold"],
 ", a ringing approach, whenever the drive exceeds a quarter of the emission \
rate. Confirm the closed-form steady state against the toolkit's steady-state \
finder:"
}], "Text",
 CellID->171792661,ExpressionUUID->"136d7364-bcfb-8461-4113-6b4e348fef4b"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"gg", " ", "=", " ", "1."}], ",", " ", 
     RowBox[{"om", " ", "=", " ", "3."}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Norm", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "/.", " ", 
         "steady"}], "]"}], " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
         RowBox[{"\[CapitalOmega]", " ", "->", " ", "om"}]}], "}"}]}], ")"}], 
     " ", "-", "\n", "   ", 
     RowBox[{"blochVector", "[", 
      RowBox[{"First", "@", 
       RowBox[{"steadyState", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"om", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "gg", "]"}], " ", "lower"}], "}"}]}], "]"}]}],
       "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[53]:= ",
 CellID->574949478,ExpressionUUID->"2b78534b-7a52-d624-5918-4b157fe4bd0e"],

Cell["\<\
They match to rounding. From the excited state the Bloch vector will spiral \
in (the complex eigenvalue pair guarantees the ringing).\
\>", "Text",
 CellID->1664775781,ExpressionUUID->"30c454b2-bdb8-e427-60fc-4dfc3432cf0d"],

Cell[TextData[{
 "But a special pair of initial states skips the spiral entirely and slides \
straight in, and the reason sits in the drift matrix itself. Check that ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", "0", ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6879dfe8-0276-0c7b-1806-d6b2b7035741"],
 " is one of its eigenvectors, with eigenvalue ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["\[Gamma]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cc522fa-6a93-e579-24fa-bba40f27cc43"],
 ":"
}], "Text",
 CellID->884697794,ExpressionUUID->"5b82e386-6ff5-c0ee-09b1-fae009819234"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"rates", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}], "}"}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], "}"}]}], "]"}], 
    " ", ".", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}]}], ",", " ", 
   RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[54]:= ",
 CellID->784201795,ExpressionUUID->"34a39a2f-b372-ffce-5c50-1388c604c514"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox[
    StyleBox["\[Gamma]", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", "0", ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66ca9132-7812-8248-0ec9-097c79a4d092"],
 ": a deviation from the steady state leaning purely along ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023b1c4a-5b09-a8c9-33d8-96145ebdfa13"],
 " never rotates into ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29a4f364-fd74-7ca4-5f5b-eb41f401468e"],
 " or ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47740231-7fc8-4299-6d0b-a47b7a7d10e3"],
 "; it only shrinks, at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1af52337-5e42-c8c3-4a8a-bb715bf49a29"],
 ". In other words, the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fdb82dc-2353-e9b3-55f8-1b8656e7bb99"],
 "-line through the steady state is invariant, and motion along it is a \
straight slide. The pure states on that line are where it pierces the unit \
sphere; since ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5782d92f-a790-094a-7db1-d088d2255b90"],
 ", attach ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "\[PlusMinus]", 
   SqrtBox[
    RowBox[{"1", "-", 
     SubsuperscriptBox[
      StyleBox["y", "TI"], 
      StyleBox["ss",
       FontSlant->"Plain"], "2"], "-", 
     SubsuperscriptBox[
      StyleBox["z", "TI"], 
      StyleBox["ss",
       FontSlant->"Plain"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05d48452-325d-a277-33eb-1e1c47e9f15d"],
 " to the steady components:"
}], "Text",
 CellID->1193259712,ExpressionUUID->"087ffcf6-194e-431e-3804-f5b098fb2e64"],

Cell[BoxData[
 RowBox[{"flatPair", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ss", " ", "=", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "/.", " ", 
         "steady"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{
              RowBox[{"ss", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"ss", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "^", "2"}]}], "]"}]}], ",", 
          " ", 
          RowBox[{"ss", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
          RowBox[{"ss", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", 
       " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[55]:= ",
 CellID->1084903799,ExpressionUUID->"615fadf7-df9a-5675-1764-44b0da2f3d5f"],

Cell[TextData[{
 "The square root collapses to a rational form: the pair is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox["(",
       FontSize->1.2 Inherited], "\[PlusMinus]", "2", 
      SuperscriptBox["\[CapitalOmega]", "2"]}], ",", " ", 
     RowBox[{"2", "\[CapitalOmega]", 
      StyleBox["\[Gamma]", "TI"]}], ",", " ", 
     RowBox[{"-", 
      SuperscriptBox[
       StyleBox["\[Gamma]", "TI"], "2"]}]}], 
    StyleBox[")",
     FontSize->1.2 Inherited]}], "/", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SuperscriptBox[
      StyleBox["\[Gamma]", "TI"], "2"], "+", "2", 
     SuperscriptBox["\[CapitalOmega]", "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"],
 ". Check that both have unit Bloch length, so both are pure:"
}], "Text",
 CellID->964492758,ExpressionUUID->"2d0df906-1ebb-1081-5b32-f1609b4e62eb"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"#", ".", "#"}], " ", "&"}], " ", "/@", " ", "flatPair"}], ",", 
   " ", 
   RowBox[{
    RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[56]:= ",
 CellID->242210635,ExpressionUUID->"519a4e0d-3467-bfb9-07ba-6057bd130583"],

Cell["Both give one exactly.", "Text",
 CellID->360816480,ExpressionUUID->"3a891815-8c00-cf41-6ab6-925f25ba95ab"],

Cell[TextData[{
 "This two-state family is the ",
 StyleBox["physically realizable (PR) pair",
  FontWeight->"Bold"],
 " of the driven atom: a two-state ensemble a monitored trajectory can stay \
inside. The contrast is with the eigenstates of the mixed steady state (the \
",
 StyleBox["orthogonal", "TI"],
 " ensemble), which are not realizable here, and the difference is visible in \
the drift. Read the Lindblad velocity ",
 Cell[BoxData[
  OverscriptBox[
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "."]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dbacffa-31b0-43f6-3b59-e6a4404511dc"],
 " at one endpoint of each pair, the PR endpoint against the orthogonal \
endpoint:"
}], "Text",
 CellID->1505759259,ExpressionUUID->"196a859c-b643-c1b3-4f69-1cd9c3f79399"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"driftAt", "[", 
    RowBox[{"r_", ",", " ", "om_", ",", " ", "gg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Re", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"d", " ", ".", " ", 
        RowBox[{"lindbladian", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"om", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "gg", "]"}], " ", "lower"}], "}"}], ",", " ", 
          RowBox[{"blochState", " ", "@@", " ", "r"}]}], "]"}]}], "]"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"d", ",", " ", 
        RowBox[{"{", 
         RowBox[{"X", ",", " ", "Y", ",", " ", "Z"}], "}"}]}], "}"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"prPair", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"flatPair", " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalOmega]", " ", "->", " ", "3."}], ",", " ", 
       RowBox[{"\[Gamma]", " ", "->", " ", "1."}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"orthPair", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"#", ",", " ", 
       RowBox[{"-", "#"}]}], "}"}], " ", "&"}], "@", 
    RowBox[{"Normalize", "@", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "/.", " ", 
        "steady"}], " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[CapitalOmega]", " ", "->", " ", "3."}], ",", " ", 
         RowBox[{"\[Gamma]", " ", "->", " ", "1."}]}], "}"}]}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"driftAt", "[", 
    RowBox[{
     RowBox[{"prPair", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", " ", "3.", ",", " ", "1."}], "]"}],
    ",", " ", 
   RowBox[{"driftAt", "[", 
    RowBox[{
     RowBox[{"orthPair", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", " ", "3.", ",", " ", "1."}], 
    "]"}]}], "}"}]}], "Input",
 CellLabel->"In[57]:= ",
 CellID->1384053022,ExpressionUUID->"48c8a383-1e42-ef31-78f7-3aed9bf4b21b"],

Cell[TextData[{
 "The PR endpoint's drift points purely along the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50735439-04fd-dee7-0001-4e63ac89a4cd"],
 "-axis, the direction of its own chord (the two PR states differ only in ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3597ba8d-914b-928f-63ac-33d720ffe0d5"],
 "), so the state slides along the line joining the pair and never leaves it. \
The orthogonal endpoint's drift points along the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "056fda38-a5bc-2884-3314-dc65cc497aee"],
 "-axis, across its chord (which lies in the ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "383c4a9f-130c-f8c1-69c4-63d9a6beca2b"],
 "-",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b649e79-a2e1-7610-291b-1022d6945d7a"],
 " plane), so the drive immediately rotates that state out of its own pair: \
no continuous measurement can keep the system perpetually in the orthogonal \
eigenbasis. That is exactly why the orthogonal ensemble is not physically \
realizable while the PR pair is."
}], "Text",
 CellID->1395659232,ExpressionUUID->"09cb884c-5fc8-b209-3fc8-22165a620153"],

Cell[TextData[{
 "Now visualize all three paths, the spiral from the excited state and the \
two flat slides from the derived pair, with the steady state marked. This is \
the ",
 StyleBox["unconditional", "TI"],
 " picture, the record averaged away, so every start relaxes into the mixed \
steady state:"
}], "Text",
 CellID->874592789,ExpressionUUID->"376c6589-bcca-29e8-5d14-7cd3357f7b32"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"gg", " ", "=", " ", "1."}], ",", " ", 
     RowBox[{"om", " ", "=", " ", "3."}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ss", ",", " ", "starts", ",", " ", "path"}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{
      RowBox[{"ss", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "/.", " ",
           "steady"}], " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
           RowBox[{"\[CapitalOmega]", " ", "->", " ", "om"}]}], "}"}]}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"starts", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"flatPair", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
           RowBox[{"\[CapitalOmega]", " ", "->", " ", "om"}]}], "}"}]}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"path", "[", "r0_", "]"}], " ", ":=", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"run", " ", "=", " ", 
           RowBox[{"evolveODE", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"om", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Sqrt", "[", "gg", "]"}], " ", "lower"}], "}"}], ",", 
             " ", "r0", ",", " ", "6."}], "]"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"blochVector", "[", 
            RowBox[{"run", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", "6", ",", " ", "0.02"}], "]"}]}]}], "]"}]}],
       ";", "\n", "  ", 
      RowBox[{"blochPlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"path", "[", 
           RowBox[{"densityMatrix", "[", "excited", "]"}], "]"}], ",", " ", 
          RowBox[{"path", "[", 
           RowBox[{"blochState", " ", "@@", " ", 
            RowBox[{"starts", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", "\n", "    ", 
          RowBox[{"path", "[", 
           RowBox[{"blochState", " ", "@@", " ", 
            RowBox[{"starts", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
        "   ", "\"\<every start lands on the steady state (black dot)\>\"", ",",
         "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"\"\<from the excited state\>\"", ",", 
          " ", "\"\<robust start +\>\"", ",", " ", "\"\<robust start -\>\""}],
          "}"}], ",", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"Black", ",", " ", 
          RowBox[{"PointSize", "[", "0.035", "]"}], ",", " ", 
          RowBox[{"Point", "[", "ss", "]"}]}], "}"}]}], "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[58]:= ",
 CellID->1596157938,ExpressionUUID->"667bb688-7420-22c7-0e18-2fd27dd5702d"],

Cell[TextData[{
 "The excited start rings down to the steady state; the two special starts \
glide straight in; all three diamonds land on the same Bloch vector (the \
black dot), inside the ball. A driven, damped atom's ",
 StyleBox["unconditional", "TI"],
 " steady state is mixed, set by the balance of drive and emission."
}], "Text",
 CellID->1496122589,ExpressionUUID->"72002252-da4c-5210-223f-c41fdff9217a"],

Cell["Part Two: Light in a Box, and States That Live in Two Places", "Section",
 CellID->1956327387,ExpressionUUID->"084561a7-5440-aaee-387b-78015dfaf834"],

Cell[TextData[{
 "The next systems are a single mode of light in a cavity. Its states span \
the Fock ladder ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0"},
    "Ket"], ",", 
   TemplateBox[{"1"},
    "Ket"], ",", 
   TemplateBox[{"2"},
    "Ket"], ",", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "721e71e5-9ca7-ded5-2226-68cf1553a43f"],
 ", so the density matrix is larger, one row and column per Fock state. We \
truncate at a cutoff high enough that the state never reaches it, and check \
by raising the cutoff."
}], "Text",
 CellID->1131177628,ExpressionUUID->"0a84e7eb-55e0-1894-3abb-feb563956afe"],

Cell[TextData[{
 "The ",
 StyleBox["annihilation",
  FontWeight->"Bold"],
 " and ",
 StyleBox["creation",
  FontWeight->"Bold"],
 " operators step down and up the ladder, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    TemplateBox[{
      StyleBox["n", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    SqrtBox[
     StyleBox["n", "TI"]], 
    TemplateBox[{
      RowBox[{
        StyleBox["n", "TI"], "-", "1"}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3261920b-7b77-02d6-621e-14557e02503c"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    TemplateBox[{
      StyleBox["n", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    SqrtBox[
     RowBox[{
      StyleBox["n", "TI"], "+", "1"}]], 
    TemplateBox[{
      RowBox[{
        StyleBox["n", "TI"], "+", "1"}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebe3b2c-9c8f-bd2d-7645-b376153b0477"],
 ", so ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6a0058-fb4a-caff-2b69-9a05fefc98c5"],
 " carries ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41d92934-9aba-8299-77e6-c17e1f4cd0e3"],
 " on its superdiagonal:"
}], "Text",
 CellID->611195905,ExpressionUUID->"5cc23ff5-bf0f-f019-04f1-b6bf3abbc363"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"annihilation", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"N", "@", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"Range", "[", 
        RowBox[{"n", " ", "-", " ", "1"}], "]"}], "]"}], ",", " ", "1"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"creation", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"ConjugateTranspose", "[", 
    RowBox[{"annihilation", "[", "n", "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[59]:= ",
 CellID->1202919897,ExpressionUUID->"29880975-91f0-008f-5fb7-a13f278552d5"],

Cell[TextData[{
 "The ",
 StyleBox["coherent state",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Alpha]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "551c00cf-fc58-99c4-0323-99a8f5d2eb2e"],
 " (the most classical state, an eigenstate of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22235db8-54be-42b7-53d1-54e25d4b109d"],
 ") is the Fock-space sum"
}], "Text",
 CellID->1334651244,ExpressionUUID->"0976d5ae-737d-f257-3f0d-cc080609c0bd"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Alpha]", "TI"]},
    "Ket"], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SuperscriptBox[GridBox[{
         {
          StyleBox["\[Alpha]", "TI"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "/", "2"}]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["n", "TI"], "=", "0"}], "\[Infinity]",
      LimitsPositioning->False], 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["n", "TI"]], 
       SqrtBox[
        RowBox[{
         StyleBox["n", "TI"], "!"}]]], 
      RowBox[{
       TemplateBox[{
         StyleBox["n", "TI"]},
        "Ket"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->185339758,ExpressionUUID->"13e711b4-4d78-4d68-419c-88fe640d17b2"],

Cell[TextData[{
 "Build it on the coefficients ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["n", "TI"]], "/", 
   SqrtBox[
    RowBox[{
     StyleBox["n", "TI"], "!"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fd09d86-aea1-a602-65ef-14e3cb550d68"],
 " up to the cutoff, normalized in the truncated basis (the numerical \
normalization stands in for the ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    SuperscriptBox[GridBox[{
       {
        StyleBox["\[Alpha]", "TI"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "/", "2"}]]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f6c0922-6605-ed68-5513-a08c13b1b7b2"],
 " prefactor):"
}], "Text",
 CellID->1677030473,ExpressionUUID->"2caab86a-2af9-b1b1-54a9-32344e8d039b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"coherentState", "[", 
    RowBox[{"n_", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"k", " ", "==", " ", "0"}], " ", "&&", " ", 
             RowBox[{"a", " ", "==", " ", "0"}]}], ",", " ", "1", ",", " ", 
            RowBox[{"a", "^", "k"}]}], "]"}], "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"k", "!"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "0", ",", " ", 
           RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], "}"}], ",", 
     " ", 
     RowBox[{"N", "[", 
      RowBox[{"v", "/", 
       RowBox[{"Norm", "[", "v", "]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[60]:= ",
 CellID->134345938,ExpressionUUID->"7f56169e-4783-4dbb-256d-8fd872361781"],

Cell[TextData[{
 "The ",
 StyleBox["displacement operator",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["D", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Alpha]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["\[Alpha]", "TI"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], "-", 
     SuperscriptBox[
      StyleBox["\[Alpha]", "TI"], "*"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b84d4d6-858d-5842-09bb-cd902c382aa8"],
 ", which shifts the vacuum to ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Alpha]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67558936-e5eb-8680-0d6a-2173939fecea"],
 ":"
}], "Text",
 CellID->350820043,ExpressionUUID->"1072dc7c-f7d5-c74e-4001-d6398261ad94"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"displacement", "[", 
    RowBox[{"n_", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"a", " ", 
      RowBox[{"creation", "[", "n", "]"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"Conjugate", "[", "a", "]"}], " ", 
      RowBox[{"annihilation", "[", "n", "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[61]:= ",
 CellID->456450236,ExpressionUUID->"3462f0a3-098c-f6b3-5c11-e90da83edc99"],

Cell[TextData[{
 "The ",
 StyleBox["Wigner function",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04cac1af-436c-9192-2cc9-d809761ee3f8"],
 " pictures a state on the phase-space plane: positive where the state is \
concentrated and, for a nonclassical state, negative in places. In the \
canonical ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63be94f2-239e-9b81-1145-0dbc5628e9eb"],
 " normalization its displaced-parity definition is"
}], "Text",
 CellID->1767337052,ExpressionUUID->"5a3d7a71-218e-1995-0bc3-7c3b503b6bff"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["W", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox["1", "\[Pi]"], " ", 
    StyleBox["Tr",
     FontSlant->"Plain"], "\[NegativeThinSpace]", "[", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox[
       StyleBox["D", "TI"], "^"], "\[Dagger]"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Alpha]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"], 
     OverscriptBox[
      StyleBox["D", "TI"], "^"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Alpha]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["\[CapitalPi]", "TI"], "^"]}], "]"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       StyleBox["x", "TI"], "+", 
       StyleBox["i", "TI"], 
       StyleBox["p", "TI"]}], 
      SqrtBox["2"]], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1422053341,ExpressionUUID->"3a0f2024-2f71-09ca-6a34-b98e4a045b10"],

Cell[TextData[{
 "A word on the coordinate convention, kept fixed for every phase-space \
picture below. The axes ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "277956ac-4c9d-d338-4d07-4ff66529be02"],
 " and ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "178a6a52-23e4-1142-3d89-8c1c559163a8"],
 " are the dimensionless quadratures ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ddf811-e480-8137-02e2-f25a8d3ad01d"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "-", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], 
    SqrtBox["2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "719ae17a-c654-ed44-27b9-f927f3e6b7ae"],
 " (so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62c8f42b-c628-388a-12f7-ee74f3c28ad0"],
 " and the vacuum has ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"x", "x"}], "TI"]], "=", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"p", "p"}], "TI"]], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36e5ffeb-8179-694d-5e9a-f6b5300c3b97"],
 "), and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], "+", 
    StyleBox["i", "TI"], 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7af061c8-c44a-ae8e-2a80-7895edfcf4d4"],
 " is the complex amplitude. The prefactor ",
 Cell[BoxData[
  RowBox[{"1", "/", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d437dad-8290-de9a-3b71-74f7372aa4e0"],
 " is the textbook normalization on these axes, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   StyleBox["W", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["p", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aafc905-908a-67da-2a54-e16f213f4d20"],
 ", so the vacuum is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "\[Pi]"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["x", "TI"], "2"], "-", 
     SuperscriptBox[
      StyleBox["p", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62016b94-8ad8-fb56-123e-82de2f52c9bc"],
 "."
}], "Text",
 CellID->603286833,ExpressionUUID->"0e7c794a-82c2-56e7-3604-711437773ccd"],

Cell["\<\
Rather than exponentiate the displacement operator at every grid point, \
evaluate this trace directly in the Fock basis. Define\
\>", "Text",
 CellID->1349832744,ExpressionUUID->"30f601cf-5001-fb68-608d-98a961b5c9b2"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["z", "TI"], "=", "2", 
    StyleBox["\[Alpha]", "TI"], "=", 
    SqrtBox["2"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], "+", 
     StyleBox["i", "TI"], 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["b", "TI"], "=", 
    RowBox[{
     SuperscriptBox[GridBox[{
        {
         StyleBox["z", "TI"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
     RowBox[{"4", 
      RowBox[{
       SuperscriptBox[GridBox[{
          {
           StyleBox["\[Alpha]", "TI"]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->16034565,ExpressionUUID->"04bc0f0b-f02f-243d-2c43-a75481db8f07"],

Cell[TextData[{
 "For the ",
 Cell[BoxData["\[ScriptL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],
 "th superdiagonal of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705e212e-f5a4-7717-2065-b88bfc515a7d"],
 ", define the radial Laguerre sum"
}], "Text",
 CellID->344152329,ExpressionUUID->"5c2f5325-a3f6-c048-05d5-4a8ed5809292"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["F", "TI"], "\[ScriptL]"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["b", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["m", "TI"], "=", "0"}], 
      RowBox[{
       StyleBox["n", "TI"], "-", "\[ScriptL]", "-", "1"}],
      LimitsPositioning->False], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], 
       RowBox[{
        StyleBox["m", "TI"], ",", 
        RowBox[{
         StyleBox["m", "TI"], "+", "\[ScriptL]"}]}]], 
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"-", "1"}], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       StyleBox["m", "TI"]], 
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{
          StyleBox["m", "TI"], "!"}], " ", 
         RowBox[{"\[ScriptL]", "!"}]}], 
        RowBox[{
         RowBox[{
          StyleBox["(",
           SpanMaxSize->1], 
          RowBox[{
           StyleBox["m", "TI"], "+", "\[ScriptL]"}], 
          StyleBox[")",
           SpanMaxSize->1]}], "!"}]]], " ", 
      SubsuperscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["m", "TI"], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], "\[ScriptL]", 
        StyleBox[")",
         SpanMaxSize->1]}]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["b", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->622383932,ExpressionUUID->"211ecaf2-61ee-418f-5725-e3bc179b13d5"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["L", "TI"], 
   StyleBox["m", "TI"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], "\[ScriptL]", 
    StyleBox[")",
