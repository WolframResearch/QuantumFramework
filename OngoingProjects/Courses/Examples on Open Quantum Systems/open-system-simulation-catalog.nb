        "}"}]}], "]"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thin", ",", " ", "Gray"}], "]"}]}]}], "]"}]}], ";"}]], "Input",\

