     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["x", "TI"], "^"], ",", 
      OverscriptBox[
       StyleBox["p", "TI"], "^"]}], 
     StyleBox[")",
