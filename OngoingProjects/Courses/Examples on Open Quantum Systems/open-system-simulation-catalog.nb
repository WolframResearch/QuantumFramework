     "\n", "  ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"kalGrid", ",", " ", 
            RowBox[{"kalTrue", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "}"}], "]"}], ",",
          " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"kalGrid", ",", " ", 
            RowBox[{"kalFilt", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "}"}], "]"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{"Thick", ",", " ", 
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Thick", ",", " ", 
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", " ", "1"}], "]"}]}], "]"}]}], "}"}]}]}], 
      "]"}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
