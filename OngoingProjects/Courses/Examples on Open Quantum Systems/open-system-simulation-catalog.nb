        StyleBox["F", "TI"], "^"], 
       OverscriptBox[
        StyleBox["c", "TI"], "^"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", 
     StyleBox["\[Rho]", "TI"]}], "]", "+", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "-", 
