   StyleBox["J", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b44e14-0404-e868-3e4c-605eadb6bab2"],
 ","
}], "ItemNumbered",
 CellID->739917449,ExpressionUUID->"70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],

Cell[BoxData[
