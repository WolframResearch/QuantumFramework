Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     FontSize->1.2 Inherited], 
    StyleBox["\[CurlyEpsilon]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "+", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
    StyleBox[")",
     SpanMaxSize->1], "+", 
    StyleBox["\[Chi]", "TI"], " ", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], " ", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]]}], ",", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], 
    StyleBox["]",
     FontSize->1.2 Inherited], "+", 
    StyleBox["\[Gamma]", "TI"], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
