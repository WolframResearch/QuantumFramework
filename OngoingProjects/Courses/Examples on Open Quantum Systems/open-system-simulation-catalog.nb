Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"wignerGaussian", "[", 
    RowBox[{"t_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r0", " ", "=", " ", 
        RowBox[{"center", "[", "t", "]"}]}], ",", " ", 
       RowBox[{"iS", " ", "=", " ", 
        RowBox[{"Inverse", "[", 
         RowBox[{"spread", "[", "t", "]"}], "]"}]}], ",", " ", 
       RowBox[{"nrm", " ", "=", " ", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "Pi", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"Det", "[", 
             RowBox[{"spread", "[", "t", "]"}], "]"}], "]"}]}], ")"}]}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "p"}], "}"}], ",", " ", 
       RowBox[{"nrm", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x", ",", " ", "p"}], "}"}], " ", "-", " ", "r0"}], 
              ")"}], " ", ".", " ", "iS", " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x", ",", " ", "p"}], "}"}], " ", "-", " ", "r0"}], 
              ")"}]}], ")"}]}], "/", "2"}], "]"}]}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[110]:= ",
 CellID->1015299810,ExpressionUUID->"7a437910-f355-55ba-2a71-715d86e03f80"],

Cell["\<\
Trace the mean's whole path once, a faint guide to lay under the moving blob:\
\
\>", "Text",
 CellID->320909480,ExpressionUUID->"49429438-4a3e-974e-7f71-0e626fc8fd94"],

Cell[BoxData[
 RowBox[{
  RowBox[{"centerLine", " ", "=", " ", 
   RowBox[{"ListLinePlot", "[", 
