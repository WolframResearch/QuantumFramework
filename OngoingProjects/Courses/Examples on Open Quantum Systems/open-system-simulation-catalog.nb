           RowBox[{"Last", "@", "timesCool"}], ",", " ", "condFloorCool"}], 
          "}"}]}], "}"}], "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[245]:= ",
 CellID->15750989,ExpressionUUID->"77a399cd-5599-60ee-1d50-10975c2c3234"],

Cell["\<\
The open loop climbs above the thermal line (green); the closed loop drains \
fast and settles well below it, above the conditional floor (red).\
\>", "Text",
 CellID->20337601,ExpressionUUID->"225dc93e-a235-4cfc-5262-e17bd7c016c6"],

Cell["\<\
To see the loop acting, take one record and plot the estimated position with \
