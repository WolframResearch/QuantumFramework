    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     SubscriptBox[
      StyleBox["e", "TI"], "1"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Tau]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["probe",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     SubscriptBox[
      StyleBox["g", "TI"], "1"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Tau]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["p", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], "2"], 
    StyleBox["|",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["e", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["p", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], "2"], 
    StyleBox["|",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["g", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c057904-8649-af2b-743b-716e33fdf271"],
 ":"
}], "Text",
 CellID->300459616,ExpressionUUID->"2baf9433-2e90-ebaf-5954-0e7d4b2ab9f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"correlation", "[", 
    RowBox[{"\[Phi]_", ",", " ", "delays_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"runE", " ", "=", " ", 
        RowBox[{"evolveODE", "[", 
         RowBox[{
          RowBox[{"0", " ", "blankHar"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[Gamma]har", "]"}], " ", "downHar"}], 
           "}"}], ",", " ", 
          RowBox[{"conditionalCat", "[", 
           RowBox[{"\[Phi]", ",", " ", "1"}], "]"}], ",", " ", 
          RowBox[{"Max", "[", "delays", "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"runG", " ", "=", " ", 
        RowBox[{"evolveODE", "[", 
         RowBox[{
          RowBox[{"0", " ", "blankHar"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[Gamma]har", "]"}], " ", "downHar"}], 
           "}"}], ",", " ", 
          RowBox[{"conditionalCat", "[", 
           RowBox[{"\[Phi]", ",", " ", "2"}], "]"}], ",", " ", 
          RowBox[{"Max", "[", "delays", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"probe", "[", 
         RowBox[{"\[Phi]", ",", " ", 
          RowBox[{"runE", "[", "t", "]"}]}], "]"}], " ", "-", " ", 
        RowBox[{"probe", "[", 
         RowBox[{"\[Phi]", ",", " ", 
          RowBox[{"runG", "[", "t", "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "delays"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[117]:=",
 CellID->1400905077,ExpressionUUID->"340e6ec8-e38f-b030-5c35-8795963b031a"],

Cell["\<\
For the well-separated cat, plot the two-atom correlation against the \
trace-distance coherence, each normalized to its start:\
\>", "Text",
 CellID->900992407,ExpressionUUID->"64bff79f-1679-3ebc-0c44-eed9a30d8486"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"etaFar", " ", "=", " ", 
   RowBox[{"correlation", "[", 
    RowBox[{"1.3", ",", " ", "delays"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"delays", ",", " ", 
        RowBox[{"far", "/", 
         RowBox[{"First", "@", "far"}]}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"delays", ",", " ", 
        RowBox[{"etaFar", "/", 
         RowBox[{"First", "@", "etaFar"}]}]}], "}"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<coherence (trace distance)\>\"", ",", 
      " ", "\"\<two-atom correlation \[Eta]\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<delay before the second atom reads\>\"", ",", 
      " ", "\"\<normalized signal\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the two-atom correlation traces the coherence\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[118]:=",
 CellID->1909490419,ExpressionUUID->"126dc52b-3dd5-bd31-4212-dd75b461041b"],

Cell[TextData[{
 "The two curves fall together: the two-atom correlation, the thing a \
laboratory actually records, is a faithful readout of the field coherence the \
trace distance measures, and it dies as the cat blurs into the mixture. (At \
small phase the raw ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28023c0b-10a3-7000-5831-b655a156436a"],
 " additionally carries a slow Ramsey fringe, since the shrinking pointers \
keep rotating as they fade; for the well-separated cat here the coherence is \
gone before that fringe turns, so ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f1b960d-0301-b7cd-7538-0857b6b51d17"],
 " traces it cleanly.) This is the Haroche experiment: the cat is written on \
the field by one atom and read by the next, and its life is the coherence \
between two places."
}], "Text",
 CellID->809304935,ExpressionUUID->"268b8fe7-2cf2-fa64-4e88-26c14484c94e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Dispersive Readout: A Qubit Measured by a Cavity", "Subsection",
 CellID->1060035609,ExpressionUUID->"41763b34-5a53-ec31-770d-b37e5fe7b71b"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A qubit read out by a driven, damped cavity whose frequency it shifts. The \
coupling is dispersive, so the qubit's ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d61c4f4-c0fb-847a-0b1e-ddb1f08fef40"],
 " pushes the cavity resonance one way or the other, turning the cavity into \
a meter for it:"
}], "Text",
 CellID->960351252,ExpressionUUID->"72fe9a0c-0c49-239f-2285-1c56a5fc71e5"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["\[CurlyEpsilon]", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "+", 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["\[Chi]", "TI"], "\[ThinSpace]", 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "\[Dagger]"], 
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[ThinSpace]", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"]]}], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1269096941,ExpressionUUID->"14bcbead-0cb8-f132-3c43-37f7a532c018"],

Cell[TextData[{
 "Two idealizations are folded into that compactness. It is written in the \
frame rotating at the drive frequency for the cavity and the qubit frequency \
for the qubit, with the cavity driven on resonance (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalDelta]", 
    StyleBox["c", "TI"]], "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["c", "TI"]], "-", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["d", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a015340-38cc-91ca-7a3f-4b2ab97ee310"],
 "), so the bare ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["c", "TI"]], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44807b7f-366d-41a7-6cb0-73394318138d"],
 " and ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox["q", "TI"]], "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56b5d630-2397-dc8b-7e4a-c87a5623a6d1"],
 " are rotated away and ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "066e8396-42fa-b64f-2e15-1ad0768c1c95"],
 " survives only as a static label that shifts the cavity resonance by ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   StyleBox["\[Chi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fee4e15-659c-ade9-3596-605f0c2ef733"],
 ". And the only bath is the cavity's own leak: the qubit is given no \
intrinsic relaxation or dephasing, so all of its decoherence is the leak it \
induces on the cavity. The drive ",
 Cell[BoxData[
  StyleBox["\[CurlyEpsilon]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f99faa1-7599-adaa-15a6-f30b7c2df7f0"],
 " and damping ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c80f068-193e-1d5a-14bf-ea3298cb67a0"],
 " settle the cavity into one of two qubit-conditioned coherent states, the \
meter's two readings, while the cavity's own leak decoheres any superposition \
of the two qubit states. Build the joint qubit-plus-cavity system and watch \
the two readings pull apart as the qubit's coherence blurs."
}], "Text",
 CellID->2008479665,ExpressionUUID->"77601adb-bf25-4789-1d1f-93853ad02dd3"],

Cell[TextData[{
 "A qubit is read out by a driven, damped cavity whose frequency it shifts \
(dispersive coupling). The cavity settles into one of two qubit-conditioned \
coherent states, each a dot sitting in one of two places in the phase plane: \
the cavity is the meter, and these two settled amplitudes are its two ",
 StyleBox["pointer states",
  FontWeight->"Bold"],
 " (Zurek's name for the apparatus states that record a measurement outcome). \
Set the drive, coupling, and decay:"
}], "Text",
 CellID->29625565,ExpressionUUID->"48b830c7-d270-6a57-7847-a9a0e70538bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Epsilon]", " ", "=", " ", "1.2"}], ";", " ", 
  RowBox[{"\[Chi]", " ", "=", " ", "0.6"}], ";", " ", 
  RowBox[{"\[Gamma]disp", " ", "=", " ", "1.0"}], ";"}]], "Input",
 CellLabel->"In[120]:=",
 CellID->9883570,ExpressionUUID->"62f1d7f5-6807-0c72-128e-cebf09b25758"],

Cell[TextData[{
 "Conditional on the qubit in a ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e2af966-75ba-f15e-4629-f1407c4cc3a4"],
 " eigenstate ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fcb302b-9e92-9019-25c8-aa751b24e363"],
 ", the cavity sees ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["s", "TI"]], "=", 
   StyleBox["\[CurlyEpsilon]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["s", "TI"], 
   StyleBox["\[Chi]", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "361ba0ac-b25b-03c3-5e38-3909c7ee5129"],
 " and leaks through ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36c5768f-9366-0c29-5efb-6fe926135773"],
 ", a linear harmonic problem that keeps a coherent state coherent; its mean ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["s", "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["s", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43fcd6d4-594a-1482-7183-cf9e58ff7ee8"],
 " therefore closes on itself, and a single amplitude carries the whole \
conditional cavity (confirmed against the full master equation below)."
}], "Text",
 CellID->940978275,ExpressionUUID->"4719bc21-ede2-73f0-6d26-358a8b9741da"],

Cell[TextData[{
 "The equation that amplitude obeys is the generator's own action on ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71a147e0-ad25-39c0-275f-5ecdc4d18b2a"],
 ", not a coefficient put in by hand. The adjoint (Heisenberg) generator ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["\[ScriptCapitalL]", 
    StyleBox["s", "TI"], "\[Dagger]"], 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["s", "TI"]], ",", 
    OverscriptBox[
     StyleBox["a", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", 
   SuperscriptBox["\|01d49f", "\[Dagger]"], 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d94734f-f5fd-5b1e-3bac-6b2883882664"],
 " is, in the Fock basis, a constant plus a multiple of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a66d044-93ea-cfa5-7a1d-ca2e259c958f"],
 ", and for each qubit state the pair is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", "-", 
     StyleBox["i", "TI"], 
     StyleBox["\[CurlyEpsilon]", "TI"]}], ",", "\[ThinSpace]", 
    RowBox[{"-", 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       FractionBox[
        StyleBox["\[Gamma]", "TI"], "2"], "+", 
       StyleBox["i", "TI"], 
       StyleBox["s", "TI"], 
       StyleBox["\[Chi]", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08e3a6ae-198b-2f89-3890-3f08983e75d3"],
 ": the adjoint dissipator ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\|01d49f", "\[Dagger]"], 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   FractionBox["1", "2"], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07ff9e3d-196e-b566-2d84-106798181c4c"],
 " supplies the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7611561e-6aa4-cbf1-1e2f-48580f5699db"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"]}], ",", 
    OverscriptBox[
     StyleBox["a", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "-", 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d91ad73-9dce-768e-1bae-453d147b5cd4"],
 " the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"i", "s", "\[Chi]"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bff65fb-5d0a-196c-1985-7ca554bf6bb6"],
 ". So the amplitude obeys ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Alpha]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["\[CurlyEpsilon]", "TI"], "-", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], 
    StyleBox["s", "TI"], 
    StyleBox["\[Chi]", "TI"], "+", 
    FractionBox[
     StyleBox["\[Gamma]", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e58ca76-8595-5ac4-0667-ec302c20282e"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08a91809-3406-7705-3856-9253bdb35a6f"],
 ", one per qubit state (",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47ee4125-d524-d464-6d96-588edcd6bf4e"],
 " for ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a0bea5a-c3ff-c671-4a08-0c07f58bad5b"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d2ec88d-5e53-28f6-54d5-e1d75be67adc"],
 " for ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230fc3bf-d3e5-5aa5-5134-daf8e590288f"],
 "), giving in closed form"
}], "Text",
 CellID->173258875,ExpressionUUID->"0c6e076f-8b93-3c10-3415-9f492e27877a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["s", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox[
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[CurlyEpsilon]", "TI"]}], 
     RowBox[{
      StyleBox["i", "TI"], 
      StyleBox["s", "TI"], 
      StyleBox["\[Chi]", "TI"], "+", 
      StyleBox["\[Gamma]", "TI"], "/", "2"}]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["i", "TI"], 
        StyleBox["s", "TI"], 
        StyleBox["\[Chi]", "TI"], "+", 
        StyleBox["\[Gamma]", "TI"], "/", "2"}], 
       StyleBox[")",
        SpanMaxSize->1], "\[ThinSpace]", 
       StyleBox["t", "TI"]}]]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->792860948,ExpressionUUID->"29094997-c9cb-f733-5f37-60d0e87fda19"],

Cell[TextData[{
 "settling to the mirror-image steady amplitudes ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["s", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["\[CurlyEpsilon]", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], 
    StyleBox["s", "TI"], 
    StyleBox["\[Chi]", "TI"], "+", 
    StyleBox["\[Gamma]", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "284fc6fb-b6ce-6422-5874-dfa4c37b4f08"],
 ". Solve it:"
}], "Text",
 CellID->124530881,ExpressionUUID->"0cad16aa-0a89-b805-3452-8ff4af3d0b6f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"pointer", "[", "which_", "]"}], " ", ":=", " ", 
   RowBox[{"First", "[", 
    RowBox[{"amp", " ", "/.", " ", 
     RowBox[{"DSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"amp", "'"}], "[", "t", "]"}], " ", "==", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "I"}], " ", "\[Epsilon]"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"I", " ", "which", " ", "\[Chi]"}], " ", "+", " ", 
              RowBox[{"\[Gamma]disp", "/", "2"}]}], ")"}], " ", 
            RowBox[{"amp", "[", "t", "]"}]}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"amp", "[", "0", "]"}], " ", "==", " ", "0"}]}], "}"}], ",",
        " ", "amp", ",", " ", "t"}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[121]:=",
 CellID->1312473818,ExpressionUUID->"5640583a-c911-1fe8-7e70-5267e8a46532"],

Cell["Evaluate the two pointers, one per qubit state:", "Text",
 CellID->1627779716,ExpressionUUID->"6944803a-8297-e066-1f7b-1a643723b34c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Alpha]e", ",", " ", "\[Alpha]g"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"pointer", "[", "1", "]"}], ",", " ", 
     RowBox[{"pointer", "[", 
      RowBox[{"-", "1"}], "]"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[122]:=",
 CellID->294107029,ExpressionUUID->"7e9e495e-a796-7cd0-26a6-611bd223463a"],

Cell["Read the two late-time amplitudes:", "Text",
 CellID->736271930,ExpressionUUID->"534f7e63-03c8-ee33-0175-704db662b519"],

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Alpha]e", "[", "9.", "]"}], ",", " ", 
    RowBox[{"\[Alpha]g", "[", "9.", "]"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[123]:=",
 CellID->406066173,ExpressionUUID->"3b07ad27-9e6a-154b-693c-44811b1f7f91"],

Cell["\<\
The two steady amplitudes are mirror images, one per qubit state.\
\>", "Text",
 CellID->783505316,ExpressionUUID->"1c7a415c-3e53-b7cb-441a-5906bbe71d11"],

