       RowBox[{"{", 
        RowBox[{"\"\<time\>\"", ",", 
         " ", "\"\<\[LeftAngleBracket]\[Sigma]x\[RightAngleBracket]\>\""}], 
        "}"}]}], ",", "\n", "   ", 
      RowBox[{
      "PlotLabel", " ", "->", " ", "\"\<the response it produces\>\""}]}], 
     "]"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[226]:= ",
 CellID->491451350,ExpressionUUID->"3e9a3b8c-0d9b-39c6-66b9-b2d6a42f8b2c"],

Cell["\<\
Command to response, left to right: the loop reads the noisy record as a \
rotation, a noise band, and the rotations walk the state smoothly to the \
target.\
\>", "Text",
 CellID->1571111005,ExpressionUUID->"57c094f8-e1f7-16c3-7dff-0da597827c29"],

Cell[TextData[{
 "But a real loop never has a perfect detector, and inefficiency caps how \
pure the steered state can get. The Wiseman-Milburn feedback master equation \
carries an efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53c10e17-89f4-5846-01fe-a0512f812aac"],
 " that adds an irreducible feedback-noise term ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    RowBox[{"1", "-", 
     StyleBox["\[Eta]", "TI"]}], 
    StyleBox["\[Eta]", "TI"]], "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["F", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f08220d-2a73-b203-7537-c4574f070169"],
 "; solve its steady state against ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "111d4832-3a0a-d5b2-4723-627cbfbcbf98"],
 ":"
}], "Text",
 CellID->132272857,ExpressionUUID->"1845e666-64b6-1241-487a-f8400d4360ab"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"steadyXeff", "[", "\[Eta]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"blochVector", "[", 
     RowBox[{"First", "@", 
      RowBox[{"steadyState", "[", 
       RowBox[{
        RowBox[{"0", " ", "id2"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"Z", " ", "-", " ", 
             RowBox[{"I", " ", "Y"}]}], ")"}]}], ",", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", " ", "-", " ", "\[Eta]"}], ")"}], "/", "\[Eta]"}], 
            "]"}], " ", 
           RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", "Y"}]}], "}"}]}], "]"}]}], 
     "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"etasFb", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0.3", ",", " ", "1", ",", " ", "0.05"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"etasFb", ",", " ", 
      RowBox[{"steadyXeff", " ", "/@", " ", "etasFb"}]}], "}"}], "]"}], ",", 
   " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"ColorData", "[", 
     RowBox[{"97", ",", " ", "2"}], "]"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "460"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<detection efficiency \[Eta]\>\"", ",", 
      " ", "\"\<steady \
\[LeftAngleBracket]\[Sigma]x\[RightAngleBracket]\>\""}], "}"}]}], ",", "\n", 
   " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<a leaky detector cannot fully purify: feedback noise sets the \
floor\>\""}]}], "]"}]}], "Input",
 CellLabel->"In[227]:= ",
 CellID->1230643425,ExpressionUUID->"1968941f-a9d2-0fb7-4f17-0e58c867559d"],

Cell[TextData[{
 "Steady ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1aac0bc6-af4d-b58b-4a53-a2a3caf91fd1"],
 " climbs to one only as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "\[Rule]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a712f16-d19b-4a25-1a0e-c753e02e190f"],
 "; a lossy detector leaves the loop feeding its own missing information back \
as noise, and the target is reached only in part. Perfect stabilization needs \
a perfect record, the same efficiency limit that capped the feedback \
cooling."
}], "Text",
 CellID->1862623319,ExpressionUUID->"53fb696e-29db-c2cc-0198-8148486f9016"],

Cell["Part Six: Settling Warm, Purifying Fast, Cooling Cold", "Section",
 CellID->187926588,ExpressionUUID->"37c87ba4-2338-bc26-5dc8-720e56b2070c"],

Cell["Thermalization to a Bath", "Subsection",
 CellID->835753090,ExpressionUUID->"038c2d24-7693-7bfc-31b3-c48e032649c6"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A warm bath both takes and gives energy, settling a system at its own \
temperature. For an oscillator,"
}], "Text",
 CellID->820508465,ExpressionUUID->"5b3c81a1-c373-b6e1-0ac3-180af6071ccb"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["\[Omega]", "TI"], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "\[Dagger]"], 
      OverscriptBox[
       StyleBox["a", "TI"], "^"]}], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["n", "TI"], 
      StyleBox["T", "TI"]], "+", "1"}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "+", 
    StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "=", 
    FractionBox["1", 
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       StyleBox[
        RowBox[{"\[Beta]", "\[Omega]"}], "TI"]], "-", "1"}]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->218374495,ExpressionUUID->"0ffd377e-a04d-810f-3582-af3bd1f9d055"],

Cell[TextData[{
 "where the down-rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78b094ae-e1b9-bff8-284f-0d0b904d05c2"],
 " beats the up-rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34420a65-0085-ff13-5c71-ac4fb131c279"],
 " by exactly the Boltzmann factor ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"\[Beta]", "\[Omega]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33d8432c-7aae-24d4-61f8-5b767f588e3e"],
 ". This ",
 StyleBox["detailed balance", "TI"],
 " forces the steady state to the thermal distribution ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]], "\[Proportional]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Beta]", "TI"], 
     StyleBox["\[Omega]", "TI"], "\[ThinSpace]", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7102de1b-2c49-6276-2731-d04545fc315c"],
 " with mean occupation ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f3745d9-f640-89cf-66cd-5c8283fadb15"],
 ". Settle a cold and a hot start and confirm both land on the thermal \
distribution."
}], "Text",
 CellID->106949524,ExpressionUUID->"2af3e211-783e-5495-5a80-045b79cb3eff"],

Cell[TextData[{
 "A warm bath both absorbs and emits, settling a system at its temperature. \
Model it as two dissipators: decay ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "526c503f-6148-6cb6-0214-4a7910fd369c"],
 " at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a901ca6-02d7-1d1b-6aaf-9500b7626461"],
 " and excitation ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0decacba-7d10-76c3-3b93-45e474a55c29"],
 " at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "256534ec-e492-cc88-531a-adc98d2496d2"],
 ". Set the cutoff, the ladder, the bath occupation and its rate:"
}], "Text",
 CellID->384663498,ExpressionUUID->"106dd93e-13c5-b1cf-4012-d178a6710315"],

Cell[BoxData[
 RowBox[{
  RowBox[{"topTh", " ", "=", " ", "24"}], ";", " ", 
  RowBox[{"a", " ", "=", " ", 
   RowBox[{"annihilation", "[", "topTh", "]"}]}], ";", " ", 
  RowBox[{"count", " ", "=", " ", 
   RowBox[{
    RowBox[{"creation", "[", "topTh", "]"}], " ", ".", " ", "a"}]}], ";", " ", 
  RowBox[{"nT", " ", "=", " ", "1.2"}], ";", " ", 
  RowBox[{"\[Gamma]th", " ", "=", " ", "0.5"}], ";"}]], "Input",
 CellLabel->"In[228]:= ",
 CellID->457973463,ExpressionUUID->"510b310d-dc97-d591-0708-a956d523bffb"],

Cell["\<\
The two channels, decay and excitation, with their thermal weights:\
\>", "Text",
 CellID->103057839,ExpressionUUID->"3a88f114-48ba-1446-6ab7-e95e694f7eac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fall", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Gamma]th", " ", 
      RowBox[{"(", 
       RowBox[{"nT", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", "a"}]}], ";", 
  " ", 
  RowBox[{"climb", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Gamma]th", " ", "nT"}], "]"}], " ", 
    RowBox[{"creation", "[", "topTh", "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[229]:= ",
 CellID->1143862680,ExpressionUUID->"14b48af2-5d27-861c-3c4b-23bc54d3ed66"],

Cell["A reader for the mean occupation:", "Text",
 CellID->870857223,ExpressionUUID->"72f98829-a4e0-9e42-2286-2272cc9ae4a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"units", "[", "rho_", "]"}], " ", ":=", " ", 
   RowBox[{"Re", "@", 
    RowBox[{"expectation", "[", 
     RowBox[{"count", ",", " ", "rho"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[230]:= ",
 CellID->229984321,ExpressionUUID->"1350650b-6691-6e3e-4160-7d5513243504"],

Cell["Settle a cold (vacuum) and a hot start:", "Text",
 CellID->2065932053,ExpressionUUID->"532d51c4-b79b-7573-02d3-48a1c22e5c59"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fromCold", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{"0", " ", 
      RowBox[{"IdentityMatrix", "[", "topTh", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"fall", ",", " ", "climb"}], "}"}], ",", " ", 
     RowBox[{"densityMatrix", "[", 
      RowBox[{"coherentState", "[", 
       RowBox[{"topTh", ",", " ", "0"}], "]"}], "]"}], ",", " ", "16."}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fromHot", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{"0", " ", 
      RowBox[{"IdentityMatrix", "[", "topTh", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"fall", ",", " ", "climb"}], "}"}], ",", " ", 
     RowBox[{"densityMatrix", "[", 
      RowBox[{"UnitVector", "[", 
       RowBox[{"topTh", ",", " ", "9"}], "]"}], "]"}], ",", " ", "16."}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[231]:= ",
 CellID->7922854,ExpressionUUID->"02713c5f-c8e5-0f11-320e-b618e890527b"],

Cell["\<\
Read as a dynamical law, this equation has three consequences worth drawing \
out one at a time, each sharper than the one before.\
\>", "Text",
 CellID->1900525282,ExpressionUUID->"00749321-443e-2ca3-300b-0a8b6dcb7689"],

Cell[TextData[{
 "The first is a ",
 StyleBox["single attractor",
  FontWeight->"Bold"],
 ": the evolution forgets the initial state, so every start relaxes to the \
same steady state. Test that from opposite extremes, the cold vacuum and the \
hot ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "639faa00-a42a-3ba8-11a4-4c6dcddc89f2"],
 " state, by reading their late mean occupations against ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "157f93fd-228f-3ab7-4304-0aa7573b889d"],
 ":"
}], "Text",
 CellID->865264521,ExpressionUUID->"671b21e8-1ced-259b-0d38-b8b294998fe1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"units", "[", 
    RowBox[{"fromCold", "[", "16.", "]"}], "]"}], ",", " ", 
   RowBox[{"units", "[", 
    RowBox[{"fromHot", "[", "16.", "]"}], "]"}], ",", " ", "nT"}], 
  "}"}]], "Input",
 CellLabel->"In[232]:= ",
 CellID->1876999321,ExpressionUUID->"0804b894-7cc5-dcd3-383b-31de7571a639"],

Cell[TextData[{
 "Both land on ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30585328-1edb-3b29-6078-4b729b6f8673"],
 ". Watch them get there, the cold climbing and the hot relaxing until they \
meet:"
}], "Text",
 CellID->402499516,ExpressionUUID->"028df322-620d-9ccb-32b2-ea8c17b9e611"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", "16", ",", " ", "0.05"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"units", "[", 
           RowBox[{"fromCold", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
         " ", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", "16", ",", " ", "0.05"}], "]"}]}]}], "}"}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", "16", ",", " ", "0.05"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"units", "[", 
           RowBox[{"fromHot", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
         " ", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", "16", ",", " ", "0.05"}], "]"}]}]}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "nT"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"16", ",", " ", "nT"}], "}"}]}], "}"}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<from cold\>\"", ",", " ", "\"\<from hot\>\"", ",", 
      " ", "\"\<warm equilibrium\>\""}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<mean occupation\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<both starts reach the thermal mean\>\""}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]], "Input",
 CellLabel->"In[233]:= ",
 CellID->622903162,ExpressionUUID->"11eedd29-5af3-1cdc-4795-d5735e866626"],

Cell[TextData[{
 "They settle on the same ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "553e565f-4fcb-4d17-7cc6-48196a7e147d"],
 " from opposite sides: the bath drains the hot oscillator and feeds the cold \
one, so wherever the state began, it ends where decay and excitation balance. \
This two-way traffic is what makes the attractor unique; the pure-dephasing \
bath of Part One, which only froze populations, left a whole line of steady \
states instead."
}], "Text",
 CellID->649785500,ExpressionUUID->"7f6c6217-8665-62c8-2513-845133103012"],

Cell[TextData[{
 "In the infinite oscillator model, the mean occupation follows an exact \
closed path. Tracing the master equation against ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f4879b1-2b62-b5b2-6548-70fb4e141f98"],
 " gives ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     StyleBox["n", "TI"], "\[VeryThinSpace]", 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], "."], "=", "-", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["n", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "-", 
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d218d48-f517-61a3-24de-2515fca23389"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["n", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]], "+", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["n", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], "0", 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "-", 
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68418108-62e2-e866-187e-19521694bb4c"],
 ". The finite-cutoff simulation should approach that law; check the cold \
start (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["n", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], "0", 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01703913-adda-f952-370f-b15cc46ccbb8"],
 "):"
}], "Text",
 CellID->1698847202,ExpressionUUID->"6126f6d0-c79c-20ba-10dd-ef9df2297280"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"units", "[", 
       RowBox[{"fromCold", "[", "t", "]"}], "]"}], " ", "-", " ", 
      RowBox[{"nT", " ", 
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Gamma]th"}], " ", "t"}], "]"}]}], ")"}]}]}], "]"}],
     ",", " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "0", ",", " ", "16", ",", " ", "1"}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[234]:= ",
 CellID->696242602,ExpressionUUID->"1e4879c1-44de-859e-4648-70ab6d68efe4"],

Cell[TextData[{
 "The reported nonzero residual is the combined cutoff and ODE error; \
increasing the dimension and tightening solver tolerances reduce it. In the \
untruncated law one relaxation rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d2a80d4-ca9b-9dca-1b29-1991ef2fe710"],
 " carries the mean from its start to the bath value. The first field moment \
obeys the same kind of law but half as fast and while rotating, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], "."], "=", "-", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], 
    StyleBox["\[Omega]", "TI"], "+", 
    StyleBox["\[Gamma]", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56de89fa-72f1-8b5c-7ee5-20a40685d9a6"],
 "; the code sets ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "081b024f-dee7-bb3c-3838-a428da930606"],
 ", so no rotation is drawn here: the frequency appears in coherence rather \
than number populations."
}], "Text",
 CellID->437857044,ExpressionUUID->"3068938a-aea6-7f4c-6017-0ad7cb534596"],

Cell[TextData[{
 "The second consequence is stronger: the equation fixes ",
 StyleBox["the whole state",
  FontWeight->"Bold"],
 ", not just its mean. A mean is weak evidence, since a coherent, a squeezed, \
and a thermal state can all share the occupation ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59143b51-5090-fe62-0f2b-b31b612ac548"],
 ". So build the settled populations and the geometric thermal shape ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["n", "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b8a926c-2b03-23e8-7989-14364eb67132"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Beta]", "TI"], 
     StyleBox["\[Omega]", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0eb42765-6752-c125-364b-bf4f12e4900f"],
 ":"
}], "Text",
 CellID->1959355771,ExpressionUUID->"3dda19df-f0ae-deb2-6bf9-90988158a498"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pops", " ", "=", " ", 
   RowBox[{"Re", "@", 
    RowBox[{
     RowBox[{"Diagonal", "[", 
      RowBox[{"fromCold", "[", "16.", "]"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{";;", " ", "8"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"warmShape", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ratio", " ", "=", " ", 
       RowBox[{"nT", "/", 
        RowBox[{"(", 
         RowBox[{"nT", " ", "+", " ", "1"}], ")"}]}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", "ratio"}], ")"}], " ", 
      RowBox[{"ratio", "^", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "7"}], "]"}]}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[235]:= ",
 CellID->11075551,ExpressionUUID->"40683ad5-3e3c-3dc9-7017-b39fbbce8713"],

Cell["Read the largest gap between them:", "Text",
 CellID->826226521,ExpressionUUID->"1b8f60bd-75aa-c5dc-49b5-79e77c5caf26"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "[", 
   RowBox[{"pops", " ", "-", " ", "warmShape"}], "]"}]}]], "Input",
 CellLabel->"In[236]:= ",
 CellID->2011372776,ExpressionUUID->"5fc740cd-cbf6-6955-05fd-5996ed833bbf"],

Cell["\<\
They agree to a fraction of a percent. Level by level, the settled \
populations sit on the thermal bars rung for rung:\
\>", "Text",
 CellID->85539763,ExpressionUUID->"003aef4b-20aa-e832-31d9-0715515cbb18"],

Cell[BoxData[
 RowBox[{"BarChart", "[", 
  RowBox[{
   RowBox[{"Transpose", "@", 
    RowBox[{"{", 
     RowBox[{"pops", ",", " ", "warmShape"}], "}"}]}], ",", " ", 
   RowBox[{"ChartLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<settled\>\"", ",", " ", "\"\<thermal\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"ChartLabels", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", "7"}], "]"}], ",", " ", "None"}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Fock level\>\"", ",", " ", "\"\<probability\>\""}], "}"}]}],
    ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the settled distribution is thermal\>\""}]}], "]"}]], "Input",
 CellLabel->"In[237]:= ",
 CellID->247751216,ExpressionUUID->"28e0bad7-cafc-1653-589f-3390ee897cb9"],

Cell["\<\
The attractor is a complete density matrix; reaching the thermal mean was \
only its shadow.\
\>", "Text",
 CellID->375124362,ExpressionUUID->"2580c3d6-5855-812a-53bf-da9059e1d070"],

Cell[TextData[{
 "The third consequence is the deepest, the point where a dynamical equation \
reproduces equilibrium statistical mechanics. Stationarity alone forces the \
population ratio on adjacent rungs to equal the ratio of the two rates, \
excitation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56436948-eb78-7da0-7e70-81158e0d478a"],
 " over decay ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d2fa041-c708-9d58-44d4-3a2af2a2e7a2"],
 ", and that flux balance is mere bookkeeping. The physics is that the ratio \
is not free: through ",
 StyleBox["detailed balance",
  FontWeight->"Bold"],
 " the bath locks the downward rate above the upward one by exactly ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"\[Beta]", "\[Omega]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77a399cd-5599-60ee-1d50-10975c2c3234"],
 ", its own thermal signature, so an oscillator with no temperature of its \
own is driven into the Boltzmann distribution at the bath's temperature. The \
canonical ensemble is derived here, not assumed:"
}], "Text",
 CellID->898261846,ExpressionUUID->"225dc93e-a235-4cfc-5262-e17bd7c016c6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[Gamma]th", " ", "nT"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"\[Gamma]th", " ", 
      RowBox[{"(", 
       RowBox[{"nT", " ", "+", " ", "1"}], ")"}]}], ")"}]}], ",", " ", 
   RowBox[{"nT", "/", 
    RowBox[{"(", 
     RowBox[{"nT", " ", "+", " ", "1"}], ")"}]}]}], "}"}]], "Input",
 CellLabel->"In[238]:= ",
 CellID->2123245851,ExpressionUUID->"6f2e1950-aca6-616f-16d5-911dc55333b5"],

Cell[TextData[{
 "The two are equal, both ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["\[Beta]", "TI"], 
    StyleBox["\[Omega]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "716ae4bc-5935-f42e-2769-fde658c1df74"],
 ". The settled state shows the same thing directly: a geometric distribution \
is a straight line on a log axis, its constant slope the Boltzmann factor. \
Plot the settled populations against the thermal shape:"
}], "Text",
 CellID->1888499658,ExpressionUUID->"59aa617b-186b-0315-0faa-7925991e6e7f"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fock", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", "6"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"ListLogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"fock", ",", " ", 
          RowBox[{"pops", "[", 
           RowBox[{"[", 
            RowBox[{";;", " ", 
             RowBox[{"Length", "@", "fock"}]}], "]"}], "]"}]}], "}"}], "]"}], 
       ",", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"fock", ",", " ", 
          RowBox[{"warmShape", "[", 
           RowBox[{"[", 
            RowBox[{";;", " ", 
             RowBox[{"Length", "@", "fock"}]}], "]"}], "]"}]}], "}"}], 
        "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "Dashed"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<settled\>\"", ",", " ", "\"\<thermal\>\""}], "}"}]}], ",",
      " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameTicks", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"fock", ",", " ", "Automatic"}], "}"}]}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"fock", ",", " ", "Automatic"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Fock level n\>\"", ",", " ", "\"\<population (log)\>\""}],
        "}"}]}], ",", "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<geometric tail: a straight line on a log axis\>\""}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[239]:= ",
 CellID->237269248,ExpressionUUID->"008b4284-ba53-483f-3089-5bee3fe61b05"],

Cell[TextData[{
 "The settled populations fall on a straight line, parallel to the thermal \
one and with the same constant slope: every rung is less likely than the one \
below by the bath's Boltzmann factor ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["\[Beta]", "TI"], 
    StyleBox["\[Omega]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c0a4c18-9cc5-5190-640a-6642157023fa"],
 ", the visible fingerprint of detailed balance. The ratio of rates in the \
equation has become the slope of the ladder in the state. Damping and \
thermalization are then one process: decay ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ec90d37-5b76-64dd-46f6-a5715e034e27"],
 " and excitation ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f4a94b8-2093-0aa7-3549-0de25126588d"],
 " are the same bath, and the ground-state relaxation of the earlier examples \
is its ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "746ef244-02b1-295f-1c15-f42eb7447ba5"],
 " corner, an oscillator settling to its bath temperature with its whole \
distribution fixed by two rates."
}], "Text",
 CellID->1574480490,ExpressionUUID->"16a579b4-853c-ad3d-3e5b-70fe2ccef407"],

Cell["Rapid Purification by Feedback", "Subsection",
 CellID->1044501402,ExpressionUUID->"3d0d0eda-2f65-a967-6b32-a7844a11f84d"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Continuously watching an observable extracts information and sharpens the \
state toward one of its eigenstates, so a monitored qubit purifies with time. \
Measure ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["M", "TI"], "^"], "=", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], "+", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25424d11-215d-69ec-5372-655b50e83b36"],
 " at strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38b2585b-f0b8-eb1e-6842-52048132b664"],
 " with no drive (the leak is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["M", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "310aba1e-c173-53a6-6709-3c5bf006218c"],
 "); the conditioned state obeys the same measurement equation as the \
localization example, now along a tilted axis,"
}], "Text",
 CellID->1803296954,ExpressionUUID->"6d663f9d-52b3-ad35-1b1d-b6c76747f41f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "=", 
    StyleBox["k", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["M", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["M", "TI"], "^"], 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["c", "TI"]], "+", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["c", "TI"]], 
     OverscriptBox[
      StyleBox["M", "TI"], "^"], "-", "2", 
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["M", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["c", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1178089277,ExpressionUUID->"0ae604be-6e2a-038b-3a9d-9df80bdf51d1"],

Cell[TextData[{
 "How fast it purifies depends on where the state sits relative to that axis. \
Writing the impurity as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[GridBox[{
       {
        OverscriptBox[
         StyleBox["a", "TI"], "\[RightVector]"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a3bb7fa-395b-d8d2-0bd8-2ea4b8efaa38"],
 ", with ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77106238-91db-a6eb-1d2f-8462206f0c31"],
 " the Bloch vector at angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01a00532-4a0e-3544-375f-9d7c6fb89fae"],
 " to ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["M", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f5de8ef-4b2e-05e8-4562-01c96edb6f32"],
 ", It\[OHat]'s rule turns the continuous-time equation above into a \
stochastic increment ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "L"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39671b4e-a434-cf2d-6f1c-932bcdc69277"],
 " that fluctuates run to run but, averaged over the noise, drifts as"
}], "Text",
 CellID->499442545,ExpressionUUID->"1fdf432e-aa6d-b711-45e5-5a8bcf191a7b"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["dL",
      FontSlant->"Plain"], "_"], "=", "-", "4", 
    StyleBox["k", "TI"], "\[ThinSpace]", 
    StyleBox["L", "TI"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SuperscriptBox[
      StyleBox["sin",
       FontSlant->"Plain"], "2"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"], "+", "2", 
     StyleBox["L", "TI"], 
     SuperscriptBox[
      StyleBox["cos",
       FontSlant->"Plain"], "2"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1977375848,ExpressionUUID->"6d59f3c2-2879-5f97-1b66-eaac490c25fd"],

Cell[TextData[{
 "the bar the noise average, the ",
 Cell[BoxData[
  StyleBox["L", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2630e3fa-641e-82e1-4fcf-faa40da8d0cb"],
 " on the right the current impurity. Measuring ",
 StyleBox["crosswise", "TI"],
 " to the Bloch vector, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "448695d4-2f33-b50a-6cbd-0c9e4ac71c50"],
 ", is the fast case: in the ideal continuous-time feedback limit the noise \
in ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "L"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29c39546-676c-16ec-5ff0-0d2012197c36"],
 " drops out, so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "4", 
     StyleBox["k", "TI"], 
     StyleBox["t", "TI"]}]], 
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f46310b-a697-198a-757d-a954d3226bd0"],
 " pathwise; measuring ",
 StyleBox["along", "TI"],
 " it, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "216d5a5a-69e9-2e30-5713-5c040f9c751a"],
 ", is slowest, its rate dragged down by the extra factor ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["L", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c61f6d7-23c3-7683-441e-ef9156765ce9"],
 ". A fixed measurement axis lets the state drift into alignment, where it \
learns slowly, while instantaneous feedback that keeps the axis crosswise \
holds the fast rate. A finite-step implementation only approximates that \
limit and retains step-size-dependent path spread. This is ",
 ButtonBox["Jacobs' rapid-purification protocol",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/quant-ph/0301056"], None}],
 "."
}], "Text",
 CellID->1792186819,ExpressionUUID->"307817dd-a48d-ada0-6007-8e86cd39f78a"],

Cell[TextData[{
 "There is a catch in what \"fast\" means. Keeping the measurement crosswise \
maximizes the ",
 StyleBox["mean purity at a fixed time", "TI"],
 ", yet it ",
 StyleBox["lengthens", "TI"],
 " the mean time to reach a chosen purity, because its determinism forbids \
the lucky fast runs an aligned measurement occasionally enjoys; the two \
figures of merit disagree by a factor of two (",
 ButtonBox["Wiseman and Ralph, 2006",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/quant-ph/0603062"], None}],
 "). We build both strategies and let the distributions settle it."
}], "Text",
 CellID->883014421,ExpressionUUID->"4a8241cb-623a-869a-7ab2-589517ccece0"],

Cell[TextData[{
 "Both strategies start from the maximally mixed state and are scored by the \
same impurity, the linear entropy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[GridBox[{
       {
        OverscriptBox[
         StyleBox["a", "TI"], "\[RightVector]"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "367e3c7d-819a-afca-5e05-b627302cf510"],
 ", which is ",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78d621b8-eaa7-e995-28ed-b8e58f53bbff"],
 " when mixed and ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c3eb8ce-9873-62c7-05c5-31a81906302d"],
 " when pure. A reader for it:"
}], "Text",
 CellID->1335019792,ExpressionUUID->"73390226-095c-13d5-22c6-9b80a8e9613f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"linearEntropy", "[", "rho_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"blochVector", "[", "rho", "]"}], "]"}], "^", "2"}]}], ")"}], 
    "/", "2"}]}], ";"}]], "Input",
 CellLabel->"In[240]:= ",
 CellID->162990234,ExpressionUUID->"242c2995-be92-4813-4dd3-c0df3b271b79"],

Cell["Set the measurement strength and the time grid:", "Text",
 CellID->1864261496,ExpressionUUID->"6cf9f011-b091-ff11-1486-ea5ac125c27b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kPur", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"tickPur", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"span", " ", "=", " ", 
   RowBox[{"tickPur", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "120"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[241]:= ",
 CellID->875071895,ExpressionUUID->"03763f09-e75f-2a04-310d-b75292ea796e"],

Cell[TextData[{
 "The ",
 StyleBox["fixed",
  FontWeight->"Bold"],
 " strategy measures one axis, ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d2ce3de-bdcd-8de8-14d3-fa983479d732"],
 ", for the whole run. Each step feeds the record ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "=", "2", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "037e6481-2025-8b3e-3106-7deb51d1d604"],
 " into the positivity-preserving update, and the conditioned state diffuses \
and lengthens; but as its Bloch vector swings toward the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ff4878c-0720-c57b-758b-1ed6b2daac41"],
 "-axis the measurement falls into alignment and the purification slows. One \
such run, returning its impurity history:"
}], "Text",
 CellID->1252034050,ExpressionUUID->"3d786225-2032-4147-6b18-7b8f51c713ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fixedBlur", "[", 
    RowBox[{"seed_", ",", " ", "nSteps_", ",", " ", 
     RowBox[{"h_", ":", " ", "tickPur"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"linearEntropy", " ", "/@", "\n", "   ", 
    RowBox[{
     RowBox[{"trajectory", "[", 
      RowBox[{
       RowBox[{"id2", "/", "2"}], ",", " ", 
       RowBox[{"0", " ", "id2"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "kPur", "]"}], " ", "Z"}], "}"}], ",", " ", 
       RowBox[{"{", "1.", "}"}], ",", " ", 
       RowBox[{"{", "}"}], ",", " ", "h", ",", " ", 
       RowBox[{"nSteps", " ", "h"}], ",", " ", "seed"}], "]"}], 
     "[", "\"\<states\>\"", "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[242]:= ",
 CellID->41937841,ExpressionUUID->"775c6681-2d8b-f484-1d64-7feb443fdeee"],

Cell[TextData[{
 "The ",
 StyleBox["steered",
  FontWeight->"Bold"],
 " strategy uses the record differently. Instead of a fixed axis it reads the \
current Bloch vector off the conditioned state and measures along an axis ",
 StyleBox["crosswise", "TI"],
 " to it, holding the fast ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75bb4ea4-bbde-cef1-2359-670e3e6894db"],
 " angle at every step. That is the feedback here: the record sets not a \
rotation of the state but the choice of which observable to measure next. A \
crosswise direction to a given Bloch vector:"
}], "Text",
 CellID->1124512868,ExpressionUUID->"6f77f163-25db-f065-150c-e94d4c6fc34f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"crosswise", "[", "lean_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"Cross", "[", 
        RowBox[{"lean", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "1."}], "}"}]}], "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Norm", "[", "c", "]"}], " ", "<", " ", "1.*^-6"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"1.", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", " ", 
       RowBox[{"Normalize", "[", "c", "]"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[243]:= ",
 CellID->225942279,ExpressionUUID->"1c3c3f10-7538-8927-45c3-b75a7cb2d80d"],

Cell["\<\
One steered step measures the Pauli operator along that crosswise axis and \
advances the conditioned state by the same positivity-preserving update:\
\>", "Text",
 CellID->15750989,ExpressionUUID->"51549184-e5a4-8496-076b-08e18c56eefc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"steerStep", "[", 
    RowBox[{"rho_", ",", " ", "dw_", ",", " ", "h_"}], "]"}], " ", ":=", " ", 
   
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"leak", " ", "=", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "kPur", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"crosswise", "[", 
           RowBox[{"blochVector", "[", "rho", "]"}], "]"}], " ", ".", " ", 
          RowBox[{"{", 
           RowBox[{"X", ",", " ", "Y", ",", " ", "Z"}], "}"}]}], ")"}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"measurementStep", "[", 
       RowBox[{
        RowBox[{"0", " ", "id2"}], ",", " ", 
        RowBox[{"{", "leak", "}"}], ",", " ", 
        RowBox[{"{", "1.", "}"}], ",", " ", 
        RowBox[{"{", "}"}], ",", " ", "h"}], "]"}], "[", 
      RowBox[{"rho", ",", " ", 
       RowBox[{"measurementRecord", "[", 
        RowBox[{"rho", ",", " ", 
         RowBox[{"{", "leak", "}"}], ",", " ", 
         RowBox[{"{", "1.", "}"}], ",", " ", "h", ",", " ", 
         RowBox[{"{", "dw", "}"}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[244]:= ",
 CellID->20337601,ExpressionUUID->"39696f27-c9aa-0144-6f16-8680e85f53ae"],

Cell["One steered run:", "Text",
 CellID->127439427,ExpressionUUID->"45dcfd53-12c9-ed0c-73e3-f51da77db456"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"steeredBlur", "[", 
    RowBox[{"seed_", ",", " ", "nSteps_", ",", " ", 
     RowBox[{"h_", ":", " ", "tickPur"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"linearEntropy", " ", "/@", " ", 
    RowBox[{"BlockRandom", "[", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "    ", 
      RowBox[{"FoldList", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rho", ",", " ", "dw"}], "}"}], ",", " ", 
          RowBox[{"steerStep", "[", 
           RowBox[{"rho", ",", " ", "dw", ",", " ", "h"}], "]"}]}], "]"}], ",",
         " ", 
        RowBox[{"id2", "/", "2"}], ",", "\n", "     ", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"Sqrt", "[", "h", "]"}]}], "]"}], ",", " ", "nSteps"}], 
         "]"}]}], "]"}]}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[245]:= ",
 CellID->1378080400,ExpressionUUID->"43afbe7d-b702-93ca-7154-3026c2b4e110"],

Cell[TextData[{
 "In formulas: with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], "=", 
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["\[Rho]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "143db07b-777b-32d6-3dc2-2a25020f803c"],
 " the current Bloch vector, ",
 Cell[BoxData["steerStep"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78b7e50c-4773-01ae-284c-fd56720653f4"],
 " measures the leak ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "\[CenterDot]", 
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68443c72-a4f0-9c3e-187b-b63fcc8ae704"],
 " along a crosswise axis ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "445c0952-f215-e20d-6c63-a11f87a1b157"],
 ", perpendicular to ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a680f33-ae9a-dfdd-6a17-a77ccb2ca527"],
 " at the start of the step. Because that axis is perpendicular to the state \
the signal vanishes and the record is pure noise,"
}], "Text",
 CellID->880029775,ExpressionUUID->"3043dcf6-9c3e-c649-6070-d5b015c8ac93"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["J", "TI"], "=", "2", 
    SqrtBox[
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "\[CenterDot]", 
     OverscriptBox[
      StyleBox["a", "TI"], "\[RightVector]"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"], "=", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1216675886,ExpressionUUID->"32a697fb-66fd-3c96-625d-0ea5128986fc"],

Cell[TextData[{
 "which is nonetheless the fast case: a crosswise state is an equal \
superposition of the measured operator's eigenstates, where the back-action \
is strongest. The step is then the positivity-preserving measurement update \
of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e733b29-d0f2-c400-1600-b372e084af6a"],
 " under ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["c", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0249f5b1-f79b-eab1-3276-ecfa822fb89b"],
 " with that record, and nothing else, with no feedback unitary; the steering \
is the re-choice of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d8d8362-02d3-9c7f-2bb2-1b4cb767e745"],
 " at the next node. In continuous time this holds ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16d64695-ef97-7390-3eee-5fde8a2241fa"],
 " pathwise. At finite ",
 Cell[BoxData[
  StyleBox["h", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "492272d1-18a5-64bf-78d2-6b9b99504e85"],
 ", the state moves during a step before the axis is updated, creating the \
numerical spread measured below. Folding from ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "0"], "=", 
   FractionBox["1", "2"], "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f8fc6a3-d6eb-41c0-45b4-df0ce29e132a"],
 " over ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "740a6ce3-9f6e-a7ea-1c09-85cd1a180d30"],
 " Wiener increments gives states ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "0"], ",", "\[Ellipsis]", ",", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "355eb3db-64ad-28a6-6365-2a850d587a8c"],
 ", and ",
 Cell[BoxData["steeredBlur"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "224bec90-94dc-e798-5248-05da1d6ecde2"],
 " returns their impurities."
}], "Text",
 CellID->764992932,ExpressionUUID->"19da10ea-d928-9e66-4ff9-89b7d8c2e54c"],

Cell["Average eighty runs of each strategy:", "Text",
 CellID->746121340,ExpressionUUID->"6cf78db7-632c-d0e2-148c-24f116dea2c8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fixedAvg", " ", "=", " ", 
   RowBox[{"Mean", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"fixedBlur", "[", 
       RowBox[{"#", ",", " ", "120"}], "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"Range", "[", "80", "]"}]}], "]"}]}], ";", " ", 
  RowBox[{"steeredAvg", " ", "=", " ", 
   RowBox[{"Mean", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"steeredBlur", "[", 
       RowBox[{"#", ",", " ", "120"}], "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"Range", "[", "80", "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[246]:= ",
 CellID->1139255012,ExpressionUUID->"634058bc-0e0e-c957-1170-51e6abb89bbd"],

Cell["Compare the two at the same instant:", "Text",
 CellID->965302876,ExpressionUUID->"187ea1f6-0b66-2b61-4805-38b0ae13764b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"fixedAvg", "[", 
    RowBox[{"[", "61", "]"}], "]"}], ",", " ", 
   RowBox[{"steeredAvg", "[", 
    RowBox[{"[", "61", "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[247]:= ",
 CellID->1302650277,ExpressionUUID->"6a5920d9-eb16-a7a4-1a66-b9828ea00d8e"],

Cell["\<\
At the same time the steered strategy has reached a lower linear entropy.\
\>", "Text",
 CellID->1688685886,ExpressionUUID->"09f2771d-8da8-86b6-3f82-6f472442ec9c"],

Cell["\<\
Now visualize both purification strategies on a log scale, where a straight \
line represents exponential decay:\
\>", "Text",
 CellID->632063892,ExpressionUUID->"2eae7486-c77b-107a-5656-6de3f20e6340"],

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"span", ",", " ", "fixedAvg"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"span", ",", " ", "steeredAvg"}], "}"}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<fixed measurement\>\"", ",", 
      " ", "\"\<steered measurement\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<linear entropy (log scale)\>\""}],
      "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<steering purifies faster; finite steps approach the \
deterministic limit\>\""}]}], "]"}]], "Input",
 CellLabel->"In[248]:= ",
 CellID->1331054704,ExpressionUUID->"58a71232-b93f-0bc4-085c-947c38ca592e"],

Cell[TextData[{
 "The steered mean is steeper and smoother, tracking the continuous-time \
exponential more closely than the fixed-axis mean. The remaining discrepancy \
and run-to-run spread are numerical, so test them under step refinement at \
the common physical time ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "0.6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0590db7a-de3c-d1b6-33af-d327dbcea39c"],
 ":"
}], "Text",
 CellID->1024214867,ExpressionUUID->"2f6adbb8-aab7-c223-5569-d2e5cf439109"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"purificationConvergence", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", " ", "=", " ", 
         RowBox[{"Round", "[", 
          RowBox[{"0.6", "/", "h"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"finals", " ", "=", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Last", "[", 
               RowBox[{"steeredBlur", "[", 
                RowBox[{"#", ",", " ", "n", ",", " ", "h"}], "]"}], "]"}], 
              " ", "&"}], " ", "/@", " ", 
             RowBox[{"Range", "[", "80", "]"}]}]}], ",", " ", 
           RowBox[{"target", " ", "=", " ", 
            RowBox[{"0.5", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "4"}], " ", "kPur", " ", "0.6"}], "]"}]}]}]}], 
          "}"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{"h", ",", " ", 
           RowBox[{"Mean", "[", "finals", "]"}], ",", " ", 
           RowBox[{"StandardDeviation", "[", "finals", "]"}], ",", " ", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Mean", "[", "finals", "]"}], " ", "-", " ", "target"}], 
            "]"}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"h", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.02", ",", " ", "0.01", ",", " ", "0.005"}], "}"}]}], 
      "}"}]}], "]"}]}], ";"}], "\n", "purificationConvergence"}], "Input",
 CellLabel->"In[249]:= ",
 CellID->509901081,ExpressionUUID->"360b7cf2-7095-e6b8-5e09-75bc0121cc82"],

Cell[TextData[{
 "The path spread and bias contract as ",
 Cell[BoxData[
  StyleBox["h", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "571ae662-c9c7-b1ca-7d39-f84fe8730310"],
 " is refined. Determinism is therefore a verified continuum-limit claim, not \
a property assigned to the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "=", "0.01"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45b5dbb0-b576-45eb-734a-d2fa3c032f31"],
 " discretization."
}], "Text",
 CellID->1957271700,ExpressionUUID->"4ce9c8c0-fe52-3cd7-7496-e1adfbe4863d"],

Cell["\<\
But the mean hides the caveat, so look at the distributions. Use a four-unit \
window long enough that every one of the fixed seeded runs below reaches the \
target, as the explicit censor check will confirm:\
\>", "Text",
 CellID->935291515,ExpressionUUID->"4c678cac-5cc4-b18e-741c-25f6557603d4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"purGrid", " ", "=", " ", 
   RowBox[{"tickPur", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "400"}], "]"}]}]}], ";", " ", 
  RowBox[{"purN", " ", "=", " ", "200"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fixedRunsPur", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"fixedBlur", "[", 
      RowBox[{"#", ",", " ", "400"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"Range", "[", "purN", "]"}]}]}], ";", " ", 
  RowBox[{"steeredRunsPur", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"steeredBlur", "[", 
      RowBox[{"#", ",", " ", "400"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"Range", "[", "purN", "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[250]:= ",
 CellID->2045201311,ExpressionUUID->"0528a095-4bdb-63f8-2cd7-39df6e6e31c2"],

Cell[TextData[{
 "First, compare the finite-step steered runs with the continuous-time law ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "4", 
     StyleBox["k", "TI"], 
     StyleBox["t", "TI"]}]], 
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a78d2a2-b26e-4f45-4a07-cb0fc71b15af"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "316f19e5-f7db-2937-6714-90ce826e781d"],
 ". Overlay thirty paths on the analytic exponential, on a log scale:"
}], "Text",
 CellID->129431700,ExpressionUUID->"3daec99f-8291-5f2c-6b55-e0d937242276"],

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"purGrid", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"steeredRunsPur", "[", 
       RowBox[{"[", 
        RowBox[{";;", " ", "30"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"purGrid", ",", " ", 
        RowBox[{"0.5", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "4"}], " ", "kPur", " ", "purGrid"}], "]"}]}]}], 
       "}"}], "]"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"10", "^", 
         RowBox[{"-", "4"}]}], ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "480"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"Append", "[", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
          RowBox[{"Opacity", "[", "0.2", "]"}]}], "]"}], ",", " ", "30"}], 
       "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", "Dashed"}], "]"}]}], 
     "]"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"LineLegend", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<continuous-time law\>\"", ",", 
        " ", "\"\<finite-step steered runs\>\""}], "}"}]}], "]"}]}], ",", 
   "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<linear entropy (log)\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<finite-step paths fluctuate around the continuum exponential \
(dashed)\>\""}]}], "]"}]], "Input",
 CellLabel->"In[251]:= ",
 CellID->359040978,ExpressionUUID->"5dea9ab6-68b8-c529-0be9-13f00932ac73"],

Cell["\<\
The paths cluster around, but do not coincide with, the dashed line at this \
step size. The refinement table above is the evidence that this cluster \
collapses onto the pathwise deterministic continuum law.\
\>", "Text",
 CellID->1429785775,ExpressionUUID->"030af18e-b5e5-d347-3109-e8ebc391a1ad"],

Cell[TextData[{
 "Now the objective-dependence. At a ",
 StyleBox["fixed time", "TI"],
 " the steered strategy wins, its impurity distribution sitting lower and \
tighter than the fixed one:"
}], "Text",
 CellID->1008132517,ExpressionUUID->"405f2726-590a-86f0-7064-be8058bcecda"],

Cell[BoxData[
 RowBox[{"Histogram", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fixedRunsPur", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "61"}], "]"}], "]"}], ",", " ", 
     RowBox[{"steeredRunsPur", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "61"}], "]"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0.35", ",", " ", "0.01"}], "}"}], ",", 
   " ", "\"\<PDF\>\"", ",", "\n", " ", 
   RowBox[{"ChartLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<fixed\>\"", ",", " ", "\"\<steered\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "3"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<linear entropy at t = 0.6\>\"", ",", 
      " ", "\"\<density\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<at fixed time, steered is lower and tighter\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[252]:= ",
 CellID->764580650,ExpressionUUID->"385fe069-90bd-43ce-6864-fa3321481114"],

Cell[TextData[{
 "But the ",
 StyleBox["first-passage time", "TI"],
 " to a chosen purity tells the opposite story. For each run, record the time \
it first drops below ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "=", "0.05"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "709f1246-ab2e-00b9-20a4-9423cedb5283"],
 "; a run that does not cross within the window remains explicitly \
right-censored rather than being assigned the endpoint:"
}], "Text",
 CellID->302184118,ExpressionUUID->"50a39cef-8bd0-9934-0050-15c92e6ae81e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fptPur", "[", "run_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pos", " ", "=", " ", 
       RowBox[{"FirstPosition", "[", 
        RowBox[{"run", ",", " ", 
         RowBox[{"l_", " ", "/;", " ", 
          RowBox[{"l", " ", "<", " ", "0.05"}]}]}], "]"}]}], "}"}], ",", "\n",
      "   ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MissingQ", "[", "pos", "]"}], ",", " ", 
       RowBox[{"Missing", "[", 
        RowBox[{"\"\<RightCensored\>\"", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Length", "[", "run", "]"}], " ", "-", " ", "1"}], ")"}], 
          " ", "tickPur"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"First", "[", "pos", "]"}], " ", "-", " ", "1"}], ")"}], " ",
         "tickPur"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[253]:= ",
 CellID->1619716671,ExpressionUUID->"6eea4472-a755-a6aa-16ea-5e3fd2e10cf0"],

Cell["Collect that time for every run of each strategy:", "Text",
 CellID->1797210921,ExpressionUUID->"1d344668-2780-d87f-44cc-5832523aab45"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fptFixed", ",", " ", "fptSteer"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fptPur", " ", "/@", " ", "fixedRunsPur"}], ",", " ", 
     RowBox[{"fptPur", " ", "/@", " ", "steeredRunsPur"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[254]:= ",
 CellID->454532135,ExpressionUUID->"7ae7ede6-d60d-06a2-2a9c-04c3e3b86c88"],

Cell["\<\
Check the censor counts before computing a histogram or mean:\
\>", "Text",
 CellID->960455850,ExpressionUUID->"71444f73-786e-4642-277c-673d791b2ca8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Count", "[", 
    RowBox[{"fptFixed", ",", " ", "_Missing"}], "]"}], ",", " ", 
   RowBox[{"Count", "[", 
    RowBox[{"fptSteer", ",", " ", "_Missing"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[255]:= ",
 CellID->588212915,ExpressionUUID->"74f6de95-8032-4c15-1c8d-d7df31c7177f"],

Cell["\<\
The extended four-unit window gives zero censored runs for these fixed seeds. \
If either count were nonzero, an uncensored mean would be inappropriate and \
the window would need extension or a survival-analysis estimate.\
\>", "Text",
 CellID->1438862008,ExpressionUUID->"389004b5-9a2c-3ef3-68af-9dff1fde84d9"],

Cell["Histogram the two distributions:", "Text",
 CellID->1022895307,ExpressionUUID->"2d697f6b-3d93-338c-5b17-7735b42781d6"],

Cell[BoxData[
 RowBox[{"Histogram", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DeleteMissing", "[", "fptFixed", "]"}], ",", " ", 
     RowBox[{"DeleteMissing", "[", "fptSteer", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1.2", ",", " ", "0.06"}], "}"}], ",", 
   " ", "\"\<PDF\>\"", ",", " ", 
   RowBox[{"ChartLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<fixed\>\"", ",", " ", "\"\<steered\>\""}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "3"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<first-passage time to linear entropy < 0.05\>\"", ",", 
      " ", "\"\<density\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<yet the fixed measurement often reaches the target \
sooner\>\""}]}], "]"}]], "Input",
 CellLabel->"In[256]:= ",
 CellID->424225543,ExpressionUUID->"20a70809-2e49-b141-505c-a2534bfd03ab"],

Cell["\<\
The fixed strategy reaches down to shorter times: its runs vary, and the \
lucky ones cross the target before the steered runs. At finite step the \
steered crossing times still have a narrow distribution; under refinement \
that distribution collapses toward the continuum strategy's single \
deterministic hitting time.\
\>", "Text",
 CellID->1694748468,ExpressionUUID->"7723626c-4939-a85b-1ed0-843668cdfaa1"],

Cell["\<\
Compare the two means directly, fixed-time impurity against mean hitting time:\
\>", "Text",
 CellID->377500653,ExpressionUUID->"6663ba53-1d85-6946-0e10-3c1d94303bac"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<\>\"", ",", " ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<fixed\>\"", ",", " ", "Bold"}], "]"}], ",", " ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<steered\>\"", ",", " ", "Bold"}], "]"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<linear entropy at t = 0.6\>\"", ",", " ", "Bold"}], 
        "]"}], ",", " ", 
       RowBox[{"Mean", "[", 
        RowBox[{"fixedRunsPur", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "61"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"Mean", "[", 
        RowBox[{"steeredRunsPur", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "61"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<first-passage time to linear entropy < 0.05\>\"", ",", 
         " ", "Bold"}], "]"}], ",", " ", 
       RowBox[{"Mean", "@", 
        RowBox[{"DeleteMissing", "[", "fptFixed", "]"}]}], ",", " ", 
       RowBox[{"Mean", "@", 
        RowBox[{"DeleteMissing", "[", "fptSteer", "]"}]}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "1"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[257]:= ",
 CellID->827200276,ExpressionUUID->"2a52a343-e04e-4391-5a61-3b2c91fb11fb"],

Cell[TextData[{
 "The steered strategy has the lower fixed-time impurity but the ",
 StyleBox["longer", "TI"],
 " mean first-passage: its determinism forbids the lucky fast records that \
let a fixed measurement occasionally reach the target early. Which protocol \
is \"optimal\" depends on the question, sharp average purity by a deadline or \
shortest typical time to a goal, and no single curve can answer both. This is \
the ",
 ButtonBox["Wiseman-Ralph",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/quant-ph/0603062"], None}],
 " point, made by the distributions rather than asserted."
}], "Text",
 CellID->19958409,ExpressionUUID->"48a3001a-e719-cbe1-7850-9a4792ad99cb"],

Cell["Feedback Cooling of a Mechanical Oscillator", "Subsection",
 CellID->2075932104,ExpressionUUID->"31ebe54c-d1b5-c56d-67e8-fd29e041afb7"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Continuously measure a mechanical oscillator's position (its annihilation \
operator is ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dddb0f1-9068-854b-4be2-29bb2102ef91"],
 ") through a cavity and push against its estimated motion to cool it, \
against a thermal bath:"
}], "Text",
 CellID->467824327,ExpressionUUID->"4eea920a-da78-9b5c-76e9-1457dff2e9a6"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   StyleBox[
    RowBox[{"d", "\[Rho]"}], "TI"], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       StyleBox["i", "TI"], 
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        RowBox[{
         StyleBox["\[Omega]", "TI"], 
         SuperscriptBox[
          OverscriptBox[
           StyleBox["b", "TI"], "^"], "\[Dagger]"], 
         OverscriptBox[
          StyleBox["b", "TI"], "^"], "-", 
         StyleBox["f", "TI"], 
         StyleBox["(",
          SpanMaxSize->1], 
         StyleBox["t", "TI"], 
         StyleBox[")",
          SpanMaxSize->1], 
         OverscriptBox[
          StyleBox["x", "TI"], "^"]}], ",", " ", 
        StyleBox["\[Rho]", "TI"]}], 
       StyleBox["]",
        SpanMaxSize->1]}]}], "\[ThinSpace]", 
     StyleBox["d", "TI"], 
     StyleBox["t", "TI"]}], "+", 
    RowBox[{
     StyleBox["k", "TI"], "\[ThinSpace]", 
     RowBox[{"\|01d49f", 
      StyleBox["[",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["x", "TI"], "^"], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
     StyleBox["d", "TI"], 
     StyleBox["t", "TI"]}], "+", 
    RowBox[{
     SqrtBox[
      StyleBox[
       RowBox[{"\[Eta]", "k"}], "TI"]], "\[ThinSpace]", 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       OverscriptBox[
        StyleBox["x", "TI"], "^"], 
       StyleBox["\[Rho]", "TI"], "+", 
       StyleBox["\[Rho]", "TI"], 
       OverscriptBox[
        StyleBox["x", "TI"], "^"], "-", "2", 
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["x", "TI"], "^"], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1], 
       StyleBox["\[Rho]", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "\[ThinSpace]", 
     StyleBox["d", "TI"], 
     StyleBox["W", "TI"]}], "+", 
    RowBox[{
     StyleBox["\[Gamma]", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["T", "TI"]], "+", "1"}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{"\|01d49f", 
      StyleBox["[",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["b", "TI"], "^"], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
     StyleBox["d", "TI"], 
     StyleBox["t", "TI"]}], "+", 
    RowBox[{
     StyleBox["\[Gamma]", "TI"], 
     SubscriptBox[
      StyleBox["n", "TI"], 
      StyleBox["T", "TI"]], 
     RowBox[{"\|01d49f", 
      StyleBox["[",
       SpanMaxSize->1], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["b", "TI"], "^"], "\[Dagger]"], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
     StyleBox["d", "TI"], 
     RowBox[{
      StyleBox["t", "TI"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1012559019,ExpressionUUID->"7f55f164-a56a-0bbf-256a-e941cc1f5985"],

Cell[TextData[{
 "Watching sharpens the estimate, the feedback force ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], "\[Proportional]", "-", 
   StyleBox["G", "TI"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["p", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66a2faf2-58b3-40d9-0e51-f3bc59461223"],
 " drains the energy, and the leftover is a balance of measurement rate, \
efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1685e188-3be3-a90f-3eba-f8d2bd97f855"],
 ", gain ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a321877-2c7f-2cce-4bc1-9231450a7614"],
 ", and heating ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4421f40f-2283-9b1b-6dde-ee695737e661"],
 ". Watching alone only heats; feedback cools, but only up to an optimal gain \
beyond which it feeds the detector's noise back onto the oscillator. Cool a \
warm start, find the best gain, and sweep the detector quality."
}], "Text",
 CellID->1427622929,ExpressionUUID->"612520b5-066b-562d-10da-b9ffb31e3d77"],

Cell[TextData[{
 "The same measure-and-feedback loop cools a mechanical oscillator, but \
cooling takes more than watching: the loop must act. Three pieces enter now \
that the Kalman tracker did not have. A thermal bath (damping ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b20a0de-bf05-fd95-7adf-39983ab1c7ff"],
 ", occupation ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a88aa2f-b14b-d52b-7ab7-4388c0ffbc71"],
 ") keeps trying to warm the oscillator; the continuous position measurement \
(strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57b69005-8bc5-b0fd-7d4d-0a6f2e7102c7"],
 ", efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72f2455d-c49b-2bf1-2282-5d06ed2e79db"],
 ") tracks it; and a feedback force pushes back against the ",
 StyleBox["estimated", "TI"],
 " velocity, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], "=", "-", 
   StyleBox["G", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["p", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77416ebe-6e08-cf7c-1d7e-87f80ba29246"],
 " (the conditional mean), draining energy. The state is Gaussian throughout, \
so, as in the Kalman filter, the conditional covariance is deterministic and \
the conditional mean is stochastic. This example stands alone, so fix its own \
constants:"
}], "Text",
 CellID->115085158,ExpressionUUID->"18599260-685f-792c-4866-144a09ea4876"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kCool", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"etaCool", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"gammaCool", " ", "=", " ", "0.1"}], ";", " ", 
  RowBox[{"nCool", " ", "=", " ", "10."}], ";"}]], "Input",
 CellLabel->"In[258]:= ",
 CellID->2053577179,ExpressionUUID->"32a0fa91-0c97-025a-625f-f3dba52250a0"],

Cell[TextData[{
 "The conditional covariance is the tracking Riccati of Part Five again, now \
carrying the bath (a drift toward the thermal spread ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]], "+", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d4f6d29-8280-add7-4b74-8573373af73d"],
 " at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d1d4b7f-00e8-6ae3-2b23-6339b09d38c9"],
 ") and the efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b093cc2-afd1-7ed1-6936-b5afca64443b"],
 " on the information-gain terms, while the back-action term ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023dde7a-8e23-336a-33c2-d0242bd781b0"],
 " stays full. In the three entries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xx",
      FontSlant->"Plain"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xp",
      FontSlant->"Plain"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["pp",
      FontSlant->"Plain"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40fb5a43-fbb5-27db-7099-5c2cfe418d21"],
 ","
}], "Text",
 CellID->248898466,ExpressionUUID->"2425f502-e1b1-2adc-4dda-ed6f90447826"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    FractionBox[
     StyleBox["d", "TI"], 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]], "(", GridBox[{
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["xx",
         FontSlant->"Plain"]]},
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["xp",
         FontSlant->"Plain"]]},
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["pp",
         FontSlant->"Plain"]]}
     }], ")", "=", "(", GridBox[{
      {
       RowBox[{"2", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xp",
          FontSlant->"Plain"]], "-", "4", 
        StyleBox["\[Eta]", "TI"], 
        StyleBox["k", "TI"], "\[ThinSpace]", 
        SubsuperscriptBox["\[CapitalSigma]", 
         StyleBox["xx",
          FontSlant->"Plain"], "2"], "-", 
        StyleBox["\[Gamma]", "TI"], 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xx",
          FontSlant->"Plain"]], "+", 
        StyleBox["\[Gamma]", "TI"], 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         SubscriptBox[
          StyleBox["n", "TI"], 
          StyleBox["T", "TI"]], "+", 
         FractionBox["1", "2"]}], 
        StyleBox[")",
         SpanMaxSize->1]}]},
      {
       RowBox[{
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["pp",
          FontSlant->"Plain"]], "-", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xx",
          FontSlant->"Plain"]], "-", "4", 
        StyleBox["\[Eta]", "TI"], 
        StyleBox["k", "TI"], "\[ThinSpace]", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xx",
          FontSlant->"Plain"]], 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xp",
          FontSlant->"Plain"]], "-", 
        StyleBox["\[Gamma]", "TI"], 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xp",
          FontSlant->"Plain"]]}]},
      {
       RowBox[{
        StyleBox["k", "TI"], "-", "2", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xp",
          FontSlant->"Plain"]], "-", "4", 
        StyleBox["\[Eta]", "TI"], 
        StyleBox["k", "TI"], "\[ThinSpace]", 
        SubsuperscriptBox["\[CapitalSigma]", 
         StyleBox["xp",
          FontSlant->"Plain"], "2"], "-", 
        StyleBox["\[Gamma]", "TI"], 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["pp",
          FontSlant->"Plain"]], "+", 
        StyleBox["\[Gamma]", "TI"], 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         SubscriptBox[
          StyleBox["n", "TI"], 
          StyleBox["T", "TI"]], "+", 
         FractionBox["1", "2"]}], 
        StyleBox[")",
         SpanMaxSize->1]}]}
     }], ")"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->538674263,ExpressionUUID->"212476b8-b137-7f4a-50dc-6fe5c0c24590"],

Cell[TextData[{
 "integrated from the thermal start ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["xx",
     FontSlant->"Plain"]], "=", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["pp",
     FontSlant->"Plain"]], "=", 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]], "+", 
   FractionBox["1", "2"]}]], "InlineFormula",
