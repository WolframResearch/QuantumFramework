       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{"I", " ", "\[Phi]", " ", "numHar"}], "]"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[85]:= ",
 CellID->1428640414,ExpressionUUID->"09e13884-5cc5-f650-3f9e-b1ee5571dcba"],

Cell[TextData[{
 "And a reader for the cavity conditioned on finding the atom in ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["e", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29829495-262a-abaa-5fb1-0ddf53dcf9f0"],
 " (block 1) or ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["g", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "136212ad-a4c2-b9f3-4111-8bf6cd740bd9"],
 " (block 2), the atom's own diagonal block of the joint state:"
}], "Text",
 CellID->1143649234,ExpressionUUID->"67f6b273-a0bf-ee61-0d8d-343cd14bb54b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cavityGiven", "[", 
    RowBox[{"joint_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"joint", ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "2", ",", " ", "topHar", ",", " ", "2", ",", " ", "topHar"}], 
          "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"r", "[", 
      RowBox[{"[", 
       RowBox[{"s", ",", " ", "All", ",", " ", "s", ",", " ", "All"}], "]"}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[86]:= ",
 CellID->1571962290,ExpressionUUID->"07a2a6c0-d7ac-3784-2d51-3fade25e9dee"],

Cell[TextData[{
 "Start the atom in ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["g", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d29df82-54ab-6c21-24d6-d6ec5d5e370b"],
 " and the cavity in the coherent state of amplitude ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2673b224-f5d9-a24c-4e00-2b81fc6df096"],
 ", Ramsey the atom into a superposition, and let the dispersive interaction \
entangle them at phase ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27388ee6-22a7-f122-4ec7-27c05753c008"],
 ":"
}], "Text",
 CellID->2091585593,ExpressionUUID->"51cd4bfd-d3fa-9dcf-07f3-62a6e58ce715"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"jointStart", " ", "=", " ", 
   RowBox[{"densityMatrix", "[", 
    RowBox[{"Flatten", "@", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"ground", ",", " ", 
       RowBox[{"coherentState", "[", 
        RowBox[{"topHar", ",", " ", "2."}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"entangle", "[", "\[Phi]_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"U", " ", "=", " ", 
       RowBox[{"disperse", "[", "\[Phi]", "]"}]}], "}"}], ",", " ", 
     RowBox[{"U", " ", ".", " ", 
      RowBox[{"(", 
       RowBox[{"ramsey", " ", ".", " ", "jointStart", " ", ".", " ", 
        RowBox[{"ConjugateTranspose", "[", "ramsey", "]"}]}], ")"}], " ", ".",
       " ", 
      RowBox[{"ConjugateTranspose", "[", "U", "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[87]:= ",
 CellID->30157833,ExpressionUUID->"06a776cb-b9d0-3c58-2e5d-6f95386a86a2"],

Cell[TextData[{
 "Here is the step that is easy to skip. If we now ",
 StyleBox["ignore", "TI"],
 " the atom and trace it out, the cavity is not a cat. Sum the atom's two \
diagonal blocks and read the purity, against the pure cat the naive picture \
would insert by hand:"
}], "Text",
 CellID->1715653387,ExpressionUUID->"7641b941-63e8-8619-1e7e-312b1582ed63"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"reducedCavity", "[", "\[Phi]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"cavityGiven", "[", 
     RowBox[{
      RowBox[{"entangle", "[", "\[Phi]", "]"}], ",", " ", "1"}], "]"}], " ", "+",
     " ", 
    RowBox[{"cavityGiven", "[", 
     RowBox[{
      RowBox[{"entangle", "[", "\[Phi]", "]"}], ",", " ", "2"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"purity", "[", 
    RowBox[{"reducedCavity", "[", "1.3", "]"}], "]"}], ",", " ", 
   RowBox[{"purity", "[", 
    RowBox[{"densityMatrix", "@", 
     RowBox[{"Normalize", "[", 
      RowBox[{
       RowBox[{"coherentState", "[", 
        RowBox[{"topHar", ",", " ", 
         RowBox[{"2.", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", "1.3"}], "]"}]}]}], "]"}], " ", "+", " ", 
       RowBox[{"coherentState", "[", 
        RowBox[{"topHar", ",", " ", 
         RowBox[{"2.", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "1.3"}], "]"}]}]}], "]"}]}], "]"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[88]:= ",
 CellID->1904268993,ExpressionUUID->"42b8cf72-fa81-ffe6-7247-e73fff35c5cc"],

Cell[TextData[{
 "A half against a one: the unread atom leaves the cavity a ",
 StyleBox["mixture",
  FontWeight->"Bold"],
 " of the two phase-rotated coherent states, not a pure cat. Its Wigner \
function says the same, two lobes with nothing between them:"
}], "Text",
 CellID->1610510011,ExpressionUUID->"1c8db7a0-3aa3-299f-44b2-2e0abf567be5"],

Cell[BoxData[
 RowBox[{"wignerPlot", "[", 
  RowBox[{
   RowBox[{"wignerRepresentation", "[", 
    RowBox[{
     RowBox[{"reducedCavity", "[", "1.3", "]"}], ",", " ", "4.0", ",", " ", 
     "55"}], "]"}], ",", " ", "\"\<atom ignored: a fringeless mixture\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[89]:= ",
 CellID->1363210520,ExpressionUUID->"473593be-64fb-e664-6eca-0af80c8fcd4e"],

Cell["\<\
Two clean lobes, no fringes: the which-phase information has leaked into the \
atom, and averaging over it erases the coherence, exactly as tracing out any \
unwatched detector does.\
\>", "Text",
 CellID->751311520,ExpressionUUID->"79a8e286-b760-8808-2f57-fbe3c21adb52"],

Cell[TextData[{
 "The cat appears only when the atom is ",
 StyleBox["read", "TI"],
 ". Send the atom through a second Ramsey pulse, the analysis pulse, and keep \
the runs where it comes out ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["e", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "766f3dde-6e6e-8ae3-1e14-b4980b18d8c9"],
 ": that measurement projects the cavity into a superposition of the two \
pointers. Condition on the atom after the analysis pulse, and read the purity:"
}], "Text",
 CellID->1811324800,ExpressionUUID->"7acff19c-f8f8-c05b-2af4-e8d9f97292a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"conditionalCat", "[", 
    RowBox[{"\[Phi]_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"ramsey", " ", ".", " ", 
        RowBox[{"entangle", "[", "\[Phi]", "]"}], " ", ".", " ", 
        RowBox[{"ConjugateTranspose", "[", "ramsey", "]"}]}]}], "}"}], ",", 
     " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"blk", " ", "=", " ", 
         RowBox[{"cavityGiven", "[", 
          RowBox[{"r", ",", " ", "s"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"blk", "/", 
        RowBox[{"Tr", "[", "blk", "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"purity", "[", 
  RowBox[{"conditionalCat", "[", 
   RowBox[{"1.3", ",", " ", "1"}], "]"}], "]"}]}], "Input",
 CellLabel->"In[90]:= ",
 CellID->1255352889,ExpressionUUID->"36bb0aa4-099e-3511-5e58-a30ea8289c7b"],

Cell["\<\
Purity one: reading the atom has turned the mixture into a pure cat. Its \
Wigner function carries the fringes the mixture lacked:\
\>", "Text",
 CellID->1056550259,ExpressionUUID->"6fab4322-7f5b-c123-15a9-5a8c7aef9009"],

Cell[BoxData[
 RowBox[{"wignerPlot", "[", 
  RowBox[{
   RowBox[{"wignerRepresentation", "[", 
    RowBox[{
     RowBox[{"conditionalCat", "[", 
      RowBox[{"1.3", ",", " ", "1"}], "]"}], ",", " ", "4.0", ",", " ", 
     "55"}], "]"}], ",", 
   " ", "\"\<atom read as |e\[RightAngleBracket]: a cat, fringes and \
all\>\""}], "]"}]], "Input",
 CellLabel->"In[91]:= ",
 CellID->1554899303,ExpressionUUID->"559c0528-76f1-864e-03a3-9d720285ec94"],

Cell[TextData[{
 "The interference fringes are back. Making the cat and reading the atom are \
one act: no cat is inserted, it is conditioned into being by the atomic \
measurement. The phase ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c3b3e9a-7f95-6e09-75d8-b7c47a203553"],
 " still sets the separation: small ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b834648-1855-f17e-29b1-581299e1c044"],
 " leaves the two pointers close, large ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aa15cf4-f328-f435-1a5f-55b186c2df1f"],
 " far apart."
}], "Text",
 CellID->1285549060,ExpressionUUID->"1fa3178e-7287-38be-4550-8ee807338a84"],

Cell["\<\
Now watch the conditional cat decohere under the leak. Evolve the two phases \
across the delays and build a Wigner film of each:\
\>", "Text",
 CellID->1616846310,ExpressionUUID->"33c53063-afff-c489-61fa-aa4cc98baed3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"harTimes", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.", ",", " ", "0.5", ",", " ", "1.0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"harSmall", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{"0", " ", "blankHar"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "\[Gamma]har", "]"}], " ", "downHar"}], "}"}], ",",
      " ", 
     RowBox[{"conditionalCat", "[", 
      RowBox[{"0.5", ",", " ", "1"}], "]"}], ",", " ", 
     RowBox[{"Max", "[", "harTimes", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"harLarge", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{"0", " ", "blankHar"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "\[Gamma]har", "]"}], " ", "downHar"}], "}"}], ",",
      " ", 
     RowBox[{"conditionalCat", "[", 
      RowBox[{"1.3", ",", " ", "1"}], "]"}], ",", " ", 
     RowBox[{"Max", "[", "harTimes", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"harFilmSmall", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"wignerRepresentation", "[", 
      RowBox[{
       RowBox[{"harSmall", "[", "t", "]"}], ",", " ", "4.0", ",", " ", "45"}],
       "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "harTimes"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"harFilmLarge", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"wignerRepresentation", "[", 
      RowBox[{
       RowBox[{"harLarge", "[", "t", "]"}], ",", " ", "4.0", ",", " ", "45"}],
       "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "harTimes"}], "}"}]}], "]"}]}], ";"}]}], "Input",\

 CellLabel->"In[92]:= ",
 CellID->1706199142,ExpressionUUID->"08d8bcb3-70a4-55b3-38e7-35fd01513f99"],

Cell["\<\
Draw both films on one shared color scale so the two separations compare \
directly, the small-phase triple then the large-phase triple:\
\>", "Text",
 CellID->848974671,ExpressionUUID->"20e38226-5aed-155d-5090-1b805e987fa7"],

Cell[BoxData[
 RowBox[{"wignerPlot", "[", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{"harFilmSmall", ",", " ", "harFilmLarge"}], "]"}], ",", "\n", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\"\<small \[Phi], \[Tau]=\>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
      "harTimes"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<large \[Phi], \[Tau]=\>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
      "harTimes"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[93]:= ",
 CellID->1375299215,ExpressionUUID->"160727ef-d1b8-0069-3e3c-bec8e04d52b3"],

Cell["\<\
Read the two triples against each other: the small-phase cat keeps its \
fringes across the window, while the large-phase cat, its two states farther \
apart, has collapsed to a fringeless mixture by the end. Same cavity, same \
leak, same clock; only the separation differs, and the fringes die at a rate \
set by its square.\
\>", "Text",
 CellID->1656178105,ExpressionUUID->"261df1b1-b81e-57af-4e22-e8fb39ab3df5"],

Cell["\<\
Turn that into a number. The mixture the cat decays toward is the equal blend \
of its two pointer states, each amplitude shrinking with the cavity,\
\>", "Text",
 CellID->2128368636,ExpressionUUID->"00ba9d2f-c328-50fc-3059-1488f6dd22c6"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["mix",
      FontSlant->"Plain"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["\[Phi]", "TI"], ",", 
     StyleBox["t", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox["1", "2"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{"\[LeftBracketingBar]", 
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], "+"], "\[RightAngleBracket]", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"\[LeftBracketingBar]", 
        SubscriptBox[
         StyleBox["\[Alpha]", "TI"], "+"], "\[RightAngleBracket]"}], 
       StyleBox[")",
        SpanMaxSize->1]}], "\[Dagger]"], "+", "\[LeftBracketingBar]", 
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], "-"], "\[RightAngleBracket]", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"\[LeftBracketingBar]", 
        SubscriptBox[
         StyleBox["\[Alpha]", "TI"], "-"], "\[RightAngleBracket]"}], 
       StyleBox[")",
        SpanMaxSize->1]}], "\[Dagger]"]}], 
    StyleBox["]",
     SpanMaxSize->1]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], "\[PlusMinus]"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{"2", "\[ThinSpace]", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["t", "TI"], "/", "2"}]], "\[ThinSpace]", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"\[PlusMinus]", 
       StyleBox["i", "TI"], 
       StyleBox["\[Phi]", "TI"]}]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->471452856,ExpressionUUID->"02964792-f196-8b6e-32ae-5edf8020d9b4"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["har",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166d4e5f-4333-9385-3e13-601976c7e1ef"],
 ":"
}], "Text",
 CellID->1993504316,ExpressionUUID->"1c99ee20-d785-d362-44a6-078de231be48"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mixture", "[", 
    RowBox[{"\[Phi]_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sh", " ", "=", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Gamma]har"}], " ", 
         RowBox[{"t", "/", "2"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"densityMatrix", "[", 
         RowBox[{"coherentState", "[", 
          RowBox[{"topHar", ",", " ", 
           RowBox[{"2.", " ", "sh", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", "\[Phi]"}], "]"}]}]}], "]"}], "]"}], 
        " ", "+", " ", 
        RowBox[{"densityMatrix", "[", 
         RowBox[{"coherentState", "[", 
          RowBox[{"topHar", ",", " ", 
           RowBox[{"2.", " ", "sh", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "\[Phi]"}], "]"}]}]}], "]"}], "]"}]}], ")"}], "/",
       "2"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[94]:= ",
 CellID->1944276818,ExpressionUUID->"60858f89-56d8-6615-10ba-26d3636d4d7f"],

Cell["\<\
The surviving coherence is the trace distance between the leak-evolved \
conditional cat and that mixture, over a list of delays, one master-equation \
run per phase:\
\>", "Text",
 CellID->524220529,ExpressionUUID->"2e45545e-c429-efe4-567b-4e1bedddb5ce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"coherenceLeft", "[", 
    RowBox[{"\[Phi]_", ",", " ", "delays_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"run", " ", "=", " ", 
       RowBox[{"evolveODE", "[", 
        RowBox[{
         RowBox[{"0", " ", "blankHar"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[Gamma]har", "]"}], " ", "downHar"}], "}"}],
          ",", " ", 
         RowBox[{"conditionalCat", "[", 
          RowBox[{"\[Phi]", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"Max", "[", "delays", "]"}]}], "]"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"traceDistance", "[", 
        RowBox[{
         RowBox[{"run", "[", "t", "]"}], ",", " ", 
         RowBox[{"mixture", "[", 
          RowBox[{"\[Phi]", ",", " ", "t"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "delays"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"delays", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", "3", ",", " ", "0.25"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"close", ",", " ", "far"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"coherenceLeft", "[", 
      RowBox[{"0.5", ",", " ", "delays"}], "]"}], ",", " ", 
     RowBox[{"coherenceLeft", "[", 
      RowBox[{"1.3", ",", " ", "delays"}], "]"}]}], "}"}]}], ";"}]}], "Input",\

 CellLabel->"In[95]:= ",
 CellID->950216136,ExpressionUUID->"24564246-a2b2-7a9b-4c6e-6423d74748e1"],

Cell["Visualize the two normalized coherences against the delay:", "Text",
 CellID->338647958,ExpressionUUID->"273d1382-afb1-09c0-4ec2-8aefca445b2a"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"delays", ",", " ", 
        RowBox[{"close", "/", 
         RowBox[{"First", "@", "close"}]}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"delays", ",", " ", 
        RowBox[{"far", "/", 
         RowBox[{"First", "@", "far"}]}]}], "}"}], "]"}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<small phase shift\>\"", ",", 
      " ", "\"\<large phase shift\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<delay before the second atom reads\>\"", ",", 
      " ", "\"\<surviving coherence\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<cat coherence decays faster for a larger phase shift\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[96]:= ",
 CellID->961910044,ExpressionUUID->"39c9e52f-ed06-87fb-6ff6-fc8884b0edc1"],

Cell[TextData[{
 "Both fall, but the large-",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46be6341-4be3-06d9-6e46-7b2b6d966c23"],
 " curve plunges: the separation-squared decoherence law, the separation now \
set by the atom's phase shift."
}], "Text",
 CellID->1465513701,ExpressionUUID->"352b8971-1d3f-d4c9-6328-213b94cbbe13"],

Cell[TextData[{
 "That trace distance is the theorist's coherence. The experiment reads it \
out with a ",
 StyleBox["second atom", "TI"],
 ", and that two-atom correlation is what the section is named for. Send a \
second probe (in ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["g", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "227c7e4b-1c68-aac8-5204-70159502f812"],
 ", Ramsey'd) through the decohered field, close its Ramsey, and read its \
excited chance; the correlation is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", 
   StyleBox["p", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], "2"], " ", 
    StyleBox["given",
     FontSlant->"Plain"], " ", 
    SubscriptBox[
     StyleBox["e", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["p", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], "2"], " ", 
    StyleBox["given",
     FontSlant->"Plain"], " ", 
    SubscriptBox[
     StyleBox["g", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cd9b5a9-dbed-51da-14e6-2cf2dd982320"],
 ", the second atom's excited probability conditioned on the first atom's two \
outcomes. The probe's excited chance on a given field:"
}], "Text",
 CellID->1779278278,ExpressionUUID->"4becebe3-5bfe-fac0-7993-02cd5d88c82a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"probe", "[", 
    RowBox[{"\[Phi]_", ",", " ", "cav_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"U", " ", "=", " ", 
        RowBox[{"disperse", "[", "\[Phi]", "]"}]}], ",", " ", 
       RowBox[{"sig", " ", "=", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "cav"}], 
         "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s3", " ", "=", " ", 
         RowBox[{"ramsey", " ", ".", " ", 
          RowBox[{"(", 
           RowBox[{"U", " ", ".", " ", 
            RowBox[{"(", 
             RowBox[{"ramsey", " ", ".", " ", "sig", " ", ".", " ", 
              RowBox[{"ConjugateTranspose", "[", "ramsey", "]"}]}], ")"}], 
            " ", ".", " ", 
            RowBox[{"ConjugateTranspose", "[", "U", "]"}]}], ")"}], " ", ".", 
          " ", 
          RowBox[{"ConjugateTranspose", "[", "ramsey", "]"}]}]}], "}"}], ",", 
       "\n", "    ", 
       RowBox[{"Re", "@", 
        RowBox[{"Tr", "[", 
         RowBox[{"cavityGiven", "[", 
          RowBox[{"s3", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[97]:= ",
 CellID->332869652,ExpressionUUID->"312d182f-c6c7-5e1e-60d2-9188f3722564"],

Cell["\<\
The correlation is that probe on the two conditioned fields, each decohered \
for the delay, differenced:\
\>", "Text",
 CellID->870462011,ExpressionUUID->"1449d45f-8382-90b9-3c76-ce193634e283"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"correlation", "[", 
    RowBox[{"\[Phi]_", ",", " ", "delays_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"runE", " ", "=", " ", 
        RowBox[{"evolveODE", "[", 
         RowBox[{
          RowBox[{"0", " ", "blankHar"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[Gamma]har", "]"}], " ", "downHar"}], 
           "}"}], ",", " ", 
          RowBox[{"conditionalCat", "[", 
           RowBox[{"\[Phi]", ",", " ", "1"}], "]"}], ",", " ", 
          RowBox[{"Max", "[", "delays", "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"runG", " ", "=", " ", 
        RowBox[{"evolveODE", "[", 
         RowBox[{
          RowBox[{"0", " ", "blankHar"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[Gamma]har", "]"}], " ", "downHar"}], 
           "}"}], ",", " ", 
          RowBox[{"conditionalCat", "[", 
           RowBox[{"\[Phi]", ",", " ", "2"}], "]"}], ",", " ", 
          RowBox[{"Max", "[", "delays", "]"}]}], "]"}]}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"probe", "[", 
         RowBox[{"\[Phi]", ",", " ", 
          RowBox[{"runE", "[", "t", "]"}]}], "]"}], " ", "-", " ", 
        RowBox[{"probe", "[", 
         RowBox[{"\[Phi]", ",", " ", 
          RowBox[{"runG", "[", "t", "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "delays"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[98]:= ",
 CellID->770594293,ExpressionUUID->"444f09dd-766a-dba7-6c74-a087031ca98d"],

Cell["\<\
For the well-separated cat, plot the two-atom correlation against the \
trace-distance coherence, each normalized to its start:\
\>", "Text",
 CellID->416617480,ExpressionUUID->"79e9b65a-67eb-1624-2f96-2804119e7d0e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"etaFar", " ", "=", " ", 
   RowBox[{"correlation", "[", 
    RowBox[{"1.3", ",", " ", "delays"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"delays", ",", " ", 
        RowBox[{"far", "/", 
         RowBox[{"First", "@", "far"}]}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"delays", ",", " ", 
        RowBox[{"etaFar", "/", 
         RowBox[{"First", "@", "etaFar"}]}]}], "}"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<coherence (trace distance)\>\"", ",", 
      " ", "\"\<two-atom correlation \[Eta]\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<delay before the second atom reads\>\"", ",", 
      " ", "\"\<normalized signal\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the two-atom correlation traces the coherence\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[99]:= ",
 CellID->468951994,ExpressionUUID->"394df0e2-3b3f-7a44-6f72-e9ccbeca48ae"],

Cell[TextData[{
 "The two curves fall together: the two-atom correlation, the thing a \
laboratory actually records, is a faithful readout of the field coherence the \
trace distance measures, and it dies as the cat blurs into the mixture. (At \
small phase the raw ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d3de1d4-e864-19c9-04c2-f89189116b13"],
 " additionally carries a slow Ramsey fringe, since the shrinking pointers \
keep rotating as they fade; for the well-separated cat here the coherence is \
gone before that fringe turns, so ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1adc8861-0296-99d3-4ae3-224bb720eb39"],
 " traces it cleanly.) This is the Haroche experiment: the cat is written on \
the field by one atom and read by the next, and its life is the coherence \
between two places."
}], "Text",
 CellID->1802328397,ExpressionUUID->"47f3727e-1788-b883-6d81-7438a2220ae9"],

Cell["Dispersive Readout: A Qubit Measured by a Cavity", "Subsection",
 CellID->328865975,ExpressionUUID->"02bfa0ec-e0fe-2fa7-3244-39c9908b758d"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A qubit read out by a driven, damped cavity whose frequency it shifts. The \
coupling is dispersive, so the qubit's ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cc1833e-1ead-5711-24fe-1b789b583a7b"],
 " pushes the cavity resonance one way or the other, turning the cavity into \
a meter for it:"
}], "Text",
 CellID->1270006433,ExpressionUUID->"3cb4236e-91b2-9328-644b-bb482044fe72"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["\[CurlyEpsilon]", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "+", 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["\[Chi]", "TI"], "\[ThinSpace]", 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "\[Dagger]"], 
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[ThinSpace]", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"]]}], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->34003199,ExpressionUUID->"631da35c-735e-7e3b-1122-3b0606eb4501"],

Cell[TextData[{
 "The drive ",
 Cell[BoxData[
  StyleBox["\[CurlyEpsilon]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44b7daea-ed84-b50e-6c4c-d3b784361c54"],
 " and damping ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39f2334d-24de-3dcb-6f81-ab174d688711"],
 " settle the cavity into one of two qubit-conditioned coherent states, the \
meter's two readings, while the cavity's own leak decoheres any superposition \
of the two qubit states. Build the joint qubit-plus-cavity system and watch \
the two readings pull apart as the qubit's coherence blurs."
}], "Text",
 CellID->1596250240,ExpressionUUID->"1ec600b7-0050-8550-46fd-99f1b1eaefba"],

Cell[TextData[{
 "A qubit is read out by a driven, damped cavity whose frequency it shifts \
(dispersive coupling). The cavity settles into one of two qubit-conditioned \
coherent states, each a dot sitting in one of two places in the phase plane: \
the cavity is the meter, and these two settled amplitudes are its two ",
 StyleBox["pointer states",
  FontWeight->"Bold"],
 " (Zurek's name for the apparatus states that record a measurement outcome). \
Set the drive, coupling, and decay:"
}], "Text",
 CellID->1572158672,ExpressionUUID->"33bfe66e-cd59-d601-6144-f84be4edbd6b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Epsilon]", " ", "=", " ", "1.2"}], ";", " ", 
  RowBox[{"\[Chi]", " ", "=", " ", "0.6"}], ";", " ", 
  RowBox[{"\[Gamma]disp", " ", "=", " ", "1.0"}], ";"}]], "Input",
 CellLabel->"In[100]:= ",
 CellID->1137775047,ExpressionUUID->"6a3ee8c1-8740-e1ad-1bc5-01ab32fab3f7"],

Cell[TextData[{
 "The pointer amplitude obeys a linear driven-damped equation, one per qubit \
state (",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33885b0f-111a-0c54-6188-5369a0af56be"],
 " for ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["e", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c9080a8-67dd-9047-04af-19f21269e2ad"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2abc9d06-0494-496b-5a43-1560ad211bb1"],
 " for ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["g", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43e301a0-76bb-1057-7190-980a034e62bd"],
 "), namely ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Alpha]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["\[CurlyEpsilon]", "TI"], "-", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], 
    StyleBox["s", "TI"], 
    StyleBox["\[Chi]", "TI"], "+", 
    FractionBox[
     StyleBox["\[Gamma]", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ae06f2b-7109-3ba5-4a9f-877500bd898f"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0856a555-3f58-6085-386d-3d1fbaed32ef"],
 ", so in closed form"
}], "Text",
 CellID->573363004,ExpressionUUID->"71eecbe3-9be0-9ba6-2795-e2cd1d9ae98c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["s", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox[
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[CurlyEpsilon]", "TI"]}], 
     RowBox[{
      StyleBox["i", "TI"], 
      StyleBox["s", "TI"], 
      StyleBox["\[Chi]", "TI"], "+", 
      StyleBox["\[Gamma]", "TI"], "/", "2"}]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["i", "TI"], 
        StyleBox["s", "TI"], 
        StyleBox["\[Chi]", "TI"], "+", 
        StyleBox["\[Gamma]", "TI"], "/", "2"}], 
       StyleBox[")",
        SpanMaxSize->1], "\[ThinSpace]", 
       StyleBox["t", "TI"]}]]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1565937439,ExpressionUUID->"59070895-187c-42ea-0f3c-a1df99091030"],

Cell[TextData[{
 "settling to the mirror-image steady amplitudes ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["s", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["\[CurlyEpsilon]", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], 
    StyleBox["s", "TI"], 
    StyleBox["\[Chi]", "TI"], "+", 
    StyleBox["\[Gamma]", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "189fe470-6cd8-7cf4-48a4-fe3a056d46de"],
 ". Solve it:"
}], "Text",
 CellID->1825661031,ExpressionUUID->"04ed2843-d86c-272a-2c92-c22cd91e8a70"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"pointer", "[", "which_", "]"}], " ", ":=", " ", 
   RowBox[{"First", "[", 
    RowBox[{"amp", " ", "/.", " ", 
     RowBox[{"DSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"amp", "'"}], "[", "t", "]"}], " ", "==", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "I"}], " ", "\[Epsilon]"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"I", " ", "which", " ", "\[Chi]"}], " ", "+", " ", 
              RowBox[{"\[Gamma]disp", "/", "2"}]}], ")"}], " ", 
            RowBox[{"amp", "[", "t", "]"}]}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"amp", "[", "0", "]"}], " ", "==", " ", "0"}]}], "}"}], ",",
        " ", "amp", ",", " ", "t"}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[101]:= ",
 CellID->1952919625,ExpressionUUID->"70d9e217-b7c7-416b-20e6-0450c27213b1"],

Cell["Evaluate the two pointers, one per qubit state:", "Text",
 CellID->162062935,ExpressionUUID->"29221b72-bc55-8ef4-58d1-933c35e1d4de"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Alpha]e", ",", " ", "\[Alpha]g"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"pointer", "[", "1", "]"}], ",", " ", 
     RowBox[{"pointer", "[", 
      RowBox[{"-", "1"}], "]"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[102]:= ",
 CellID->1483832353,ExpressionUUID->"41172bde-c012-830e-772c-c29bf1a4ee54"],

Cell["Read the two late-time amplitudes:", "Text",
 CellID->421271511,ExpressionUUID->"3dd84232-0c35-660d-6bf8-647ca5c04d57"],

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Alpha]e", "[", "9.", "]"}], ",", " ", 
    RowBox[{"\[Alpha]g", "[", "9.", "]"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[103]:= ",
 CellID->971430162,ExpressionUUID->"5558c8fc-3d33-9e90-0367-e1a6b4c7e4fa"],

Cell["\<\
The two steady amplitudes are mirror images, one per qubit state.\
\>", "Text",
 CellID->411794565,ExpressionUUID->"53291d47-a111-bd44-02d6-9520d0a507ae"],

Cell["\<\
Now visualize the pointer-state separation by drawing both trajectories from \
the origin to their steady points:\
\>", "Text",
 CellID->211393631,ExpressionUUID->"14460f59-6b0f-818e-3c7d-a7030ebbd3d4"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", "2", "]"}], " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", 
           RowBox[{"\[Alpha]e", "[", "t", "]"}]}], ",", " ", 
          RowBox[{"Im", "@", 
           RowBox[{"\[Alpha]e", "[", "t", "]"}]}]}], "}"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "9", ",", " ", "0.03"}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", "2", "]"}], " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "@", 
           RowBox[{"\[Alpha]g", "[", "t", "]"}]}], ",", " ", 
          RowBox[{"Im", "@", 
           RowBox[{"\[Alpha]g", "[", "t", "]"}]}]}], "}"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "9", ",", " ", "0.03"}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<pointer if qubit |e\[RightAngleBracket]\>\"", ",", 
      " ", "\"\<pointer if qubit |g\[RightAngleBracket]\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the meter pointer settles to two places, one per qubit \
state\>\""}]}], "]"}]], "Input",
 CellLabel->"In[104]:= ",
 CellID->485898233,ExpressionUUID->"6afe19ed-5a5e-331e-1a85-90b75fe89e64"],

Cell["\<\
What a real readout does with those two pointers is discriminate them in the \
IQ plane. Detecting the cavity output (heterodyne) turns each \
qubit-conditioned coherent pointer into a Gaussian blob of measurement \
outcomes, centered at its amplitude with the shot-noise width of a coherent \
state. As the pointers separate the two blobs pull apart and the assignment \
becomes reliable. Sample the two outcome clouds at three readout times:\
\>", "Text",
 CellID->300459616,ExpressionUUID->"142f588d-e120-bc70-3dd5-51d690da075a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"iqCloud", "[", 
    RowBox[{"ptr_", ",", " ", "t_", ",", " ", "seed_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", "2", "]"}], " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Re", "@", 
            RowBox[{"ptr", "[", "t", "]"}]}], ",", " ", 
           RowBox[{"Im", "@", 
            RowBox[{"ptr", "[", "t", "]"}]}]}], "}"}]}], " ", "+", " ", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", "2"}], "]"}]}], ",",
        " ", "250"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"iqTimes", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.5", ",", " ", "1.5", ",", " ", "4."}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[105]:= ",
 CellID->1400905077,ExpressionUUID->"029948d8-232c-2201-32a7-618256d9716b"],

Cell[TextData[{
 "Now visualize the readout separating in time, the two clouds (qubit ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["e", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b1b5b6f-b43d-594b-7939-53493dc82b91"],
 " in blue, ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["g", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32f703b9-71e1-95eb-628c-9ae30795ff31"],
 " in orange) drifting apart across the IQ plane:"
}], "Text",
 CellID->900992407,ExpressionUUID->"0c860bbc-8d1f-f590-34bd-a2e624abdffa"],

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"iqCloud", "[", 
          RowBox[{"\[Alpha]e", ",", " ", "t", ",", " ", "1"}], "]"}], ",", 
         " ", 
         RowBox[{"iqCloud", "[", 
          RowBox[{"\[Alpha]g", ",", " ", "t", ",", " ", "2"}], "]"}]}], "}"}],
        ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"Opacity", "[", "0.5", "]"}], ",", " ", 
            RowBox[{"PointSize", "[", "0.015", "]"}]}], "]"}], ",", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"Opacity", "[", "0.5", "]"}], ",", " ", 
            RowBox[{"PointSize", "[", "0.015", "]"}]}], "]"}]}], "}"}]}], ",",
        "\n", "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "6"}], ",", " ", "6"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "260"}], ",", "\n", "    ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<I\>\"", ",", " ", "\"\<Q\>\""}], "}"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"\"\<t = \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "t", "]"}]}]}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "iqTimes"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "800"}]}], "]"}]], "Input",
 CellLabel->"In[106]:= ",
 CellID->1909490419,ExpressionUUID->"1bab88a0-6539-d521-49a8-210a0ccdbc0b"],

Cell[TextData[{
 "Early the clouds overlap and the qubit state is ambiguous; by the last \
frame they are cleanly resolved. Turn that into numbers: discriminating the \
two pointer states from a single snapshot of the cavity, at one instant, has \
error ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["erfc",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{GridBox[{
      {
       RowBox[{
        SubscriptBox[
         StyleBox["\[Alpha]", "TI"], 
         StyleBox["e", "TI"]], "-", 
        SubscriptBox[
         StyleBox["\[Alpha]", "TI"], 
         StyleBox["g", "TI"]]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74b37722-3fdc-1a4f-1c41-6e8cba696895"],
 ", the overlap of the two Gaussians. Define the pointer separation, the \
distance between the two coherent amplitudes:"
}], "Text",
 CellID->809304935,ExpressionUUID->"31781dc2-1028-33d4-6707-94aca1c2813e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sepDisp", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"\[Alpha]e", "[", "t", "]"}], " ", "-", " ", 
     RowBox[{"\[Alpha]g", "[", "t", "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[107]:= ",
 CellID->1060035609,ExpressionUUID->"2148b02c-d62e-5336-5777-2989e3db3e1c"],

Cell["\<\
The wider that separation, the smaller the overlap error the discrimination \
leaves. Plot both against readout time:\
\>", "Text",
 CellID->960351252,ExpressionUUID->"183293a6-0d60-7813-49c1-0a00a4154b79"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Transpose", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", ",", " ", 
          RowBox[{"sepDisp", "[", "t", "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", 
          RowBox[{"0.5", " ", 
           RowBox[{"Erfc", "[", 
            RowBox[{
             RowBox[{"sepDisp", "[", "t", "]"}], "/", "2"}], "]"}]}]}], 
         "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "0", ",", " ", "6", ",", " ", "0.05"}], "}"}]}],
      "]"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<pointer separation |alpha_e - alpha_g|\>\"", ",", 
        " ", "\"\<assignment error 0.5 erfc(sep/2)\>\""}], "}"}], ",", " ", 
      "Right"}], "]"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<readout time\>\"", ",", " ", "\"\<separation / error\>\""}],
      "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<instantaneous discrimination: \\nseparation and error saturate \
once the cavity settles\>\""}]}], "]"}]], "Input",
 CellLabel->"In[108]:= ",
 CellID->1269096941,ExpressionUUID->"61e1f3c1-eae0-3799-179e-eaaa8e9a9de3"],

Cell[TextData[{
 "The separation rises to its steady value and the instantaneous error falls \
with it, then both flatten: once the cavity has settled, a snapshot of it \
says the same thing at every later instant. But that snapshot is not what a \
real readout uses. The cavity leaks the whole time, and a homodyne receiver \
integrates that output record, so its information keeps accumulating even \
after the cavity is stationary: the integrated signal-to-noise grows as ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["SNR",
     FontSlant->"Plain"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[Proportional]", 
   StyleBox["\[Gamma]", "TI"], 
   SubsuperscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"]], 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        SubscriptBox[
         StyleBox["\[Alpha]", "TI"], 
         StyleBox["e", "TI"]], 
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["s", "TI"], 
        StyleBox[")",
         SpanMaxSize->1], "-", 
        SubscriptBox[
         StyleBox["\[Alpha]", "TI"], 
         StyleBox["g", "TI"]], 
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["s", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20bddc2d-650e-8031-5042-d6770cb8d31b"],
 ". Plot the saturating snapshot separation-squared against this integrated \
accumulation:"
}], "Text",
 CellID->2008479665,ExpressionUUID->"7a437910-f355-55ba-2a71-715d86e03f80"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"snrAccum", "[", 
    RowBox[{"t_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"\[Gamma]disp", " ", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"\[Alpha]e", "[", "s", "]"}], " ", "-", " ", 
         RowBox[{"\[Alpha]g", "[", "s", "]"}]}], "]"}], "^", "2"}], ",", " ", 
      
      RowBox[{"{", 
       RowBox[{"s", ",", " ", "0", ",", " ", "t"}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", " ", 
         RowBox[{
          RowBox[{"sepDisp", "[", "t", "]"}], "^", "2"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "6", ",", " ", "0.05"}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", " ", 
         RowBox[{"snrAccum", "[", "t", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "6", ",", " ", "0.1"}], "}"}]}],
       "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<pointer separation squared |alpha_e - alpha_g|^2 \
(saturates)\>\"", ",", " ", "\"\<integrated SNR^2 (grows)\>\""}], "}"}], ",", 
      " ", "Right"}], "]"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<readout time\>\"", ",", " ", "\"\<distinguishability\>\""}],
      "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the pointer separation saturates;\n the integrated output \
record keeps accumulating\>\""}]}], "]"}]}], "Input",
 CellLabel->"In[109]:= ",
 CellID->29625565,ExpressionUUID->"49429438-4a3e-974e-7f71-0e626fc8fd94"],

Cell[TextData[{
 "The snapshot separation-squared levels off as the pointers reach their \
steady amplitudes, but the integrated ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["SNR",
    FontSlant->"Plain"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07e2168c-1726-1a27-2d91-8fd6a2d3690d"],
 " climbs without bound, linearly once the cavity is stationary. That growing \
line, not the saturating one, is the single-shot readout a circuit-QED \
experiment optimizes, and it is the flip side of the qubit coherence the same \
measurement destroys. See ",
 ButtonBox["Gambetta et al.",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/cond-mat/0602322"], None}],
 "."
}], "Text",
 CellID->9883570,ExpressionUUID->"3540c51c-f580-c338-637f-dd59fc3aae02"],

Cell["\<\
Measurement has a cost: as the pointer separates and reveals the qubit state, \
the qubit's coherence is destroyed. To see it we need the joint qubit-cavity \
density matrix and two helpers. First, embed a cavity operator on the joint \
space:\
\>", "Text",
 CellID->940978275,ExpressionUUID->"684f0173-fe99-1571-1874-993cfb2c7c5b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"onCavity", "[", "metering_", "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "metering"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[110]:= ",
 CellID->173258875,ExpressionUUID->"6e32c5a8-aee9-5273-17c1-dcf5ca9c2159"],

Cell[TextData[{
 "Second, the partial trace over the cavity, recovering the qubit's reduced \
state ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["qubit",
     FontSlant->"Plain"]], "=", 
   SubscriptBox[
    StyleBox["Tr",
     FontSlant->"Plain"], 
    StyleBox["cavity",
     FontSlant->"Plain"]], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "607492e2-157b-ba0c-100b-0bcc9c0f0956"],
 ":"
}], "Text",
 CellID->792860948,ExpressionUUID->"7781757c-388d-abb9-1dbf-6d26b939f983"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"reducedQubit", "[", 
    RowBox[{"joint_", ",", " ", "rungs_"}], "]"}], " ", ":=", " ", 
   RowBox[{"TensorContract", "[", 
    RowBox[{
     RowBox[{"ArrayReshape", "[", 
      RowBox[{"joint", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "rungs", ",", " ", "2", ",", " ", "rungs"}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4"}], "}"}], "}"}]}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[111]:= ",
 CellID->124530881,ExpressionUUID->"566e7348-207a-dc95-7e16-6b12510ca6ff"],

Cell[TextData[{
 "Build a reader for the qubit coherence ",
 Cell[BoxData[GridBox[{
    {
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["eg",
       FontSlant->"Plain"]]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39672ae7-82f4-b353-6f1c-c3c1368601b9"],
 " as the pointer resolves the qubit:"
}], "Text",
 CellID->1312473818,ExpressionUUID->"0c48aba4-6f27-6a39-3477-420e0ad23903"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qubitCoherence", "[", "rungs_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"count", " ", "=", " ", 
        RowBox[{
         RowBox[{"creation", "[", "rungs", "]"}], " ", ".", " ", 
         RowBox[{"annihilation", "[", "rungs", "]"}]}]}], ",", " ", "H", ",", 
       " ", "run"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"H", " ", "=", " ", 
       RowBox[{
        RowBox[{"\[Epsilon]", " ", 
         RowBox[{"onCavity", "[", 
          RowBox[{
           RowBox[{"annihilation", "[", "rungs", "]"}], " ", "+", " ", 
           RowBox[{"creation", "[", "rungs", "]"}]}], "]"}]}], " ", "+", " ", 
        
        RowBox[{"\[Chi]", " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"Z", ",", " ", "count"}], "]"}]}]}]}], ";", "\n", "   ", 
      RowBox[{"run", " ", "=", " ", 
       RowBox[{"evolveODE", "[", 
        RowBox[{"H", ",", " ", 
         RowBox[{"{", 
          RowBox[{"onCavity", "[", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[Gamma]disp", "]"}], " ", 
            RowBox[{"annihilation", "[", "rungs", "]"}]}], "]"}], "}"}], ",", 
         "\n", "     ", 
         RowBox[{"densityMatrix", "[", 
          RowBox[{"Flatten", "@", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"plus", ",", " ", 
             RowBox[{"coherentState", "[", 
              RowBox[{"rungs", ",", " ", "0"}], "]"}]}], "]"}]}], "]"}], ",", 
         " ", "4."}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"Function", "[", 
       RowBox[{"t", ",", " ", 
        RowBox[{"2", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"reducedQubit", "[", 
            RowBox[{
             RowBox[{"run", "[", "t", "]"}], ",", " ", "rungs"}], "]"}], "[", 
           
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], "]"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[112]:= ",
 CellID->1627779716,ExpressionUUID->"2f62374d-f3df-131c-5511-af16866a7e66"],

Cell[TextData[{
 "Confirm the cutoff by comparing two truncations (cutoff at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "455ea632-3d4d-f0d3-7365-387cb4f9c239"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "12"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f0fb95c-030e-c889-4534-3106b6b89ad3"],
 ") at the same time:"
}], "Text",
 CellID->294107029,ExpressionUUID->"16268eae-a572-7912-3fdd-270bcc074878"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"reading", " ", "=", " ", 
   RowBox[{"qubitCoherence", "[", "9", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"reading", "[", "2.", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"qubitCoherence", "[", "12", "]"}], "[", "2.", "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[113]:= ",
 CellID->736271930,ExpressionUUID->"346a0e1a-2221-987e-5c69-a04457d5eb44"],

Cell["The two cutoffs agree, so 9 is enough.", "Text",
 CellID->406066173,ExpressionUUID->"366be24c-537a-43bb-5e68-0416660f1181"],

Cell["\<\
Now visualize the qubit coherence draining as the pointer states separate:\
\>", "Text",
 CellID->783505316,ExpressionUUID->"501b1457-1a1d-907b-0038-8e119fa9e341"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"reading", "[", "t", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "3"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<qubit coherence\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the pointer measures away the qubit coherence\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[114]:= ",
 CellID->1838581182,ExpressionUUID->"291c68e0-f532-6cdd-5f23-81cdfcc73627"],

Cell["\<\
The coherence falls to near zero as the pointer states separate: a \
measurement that distinguishes the qubit states must destroy their \
superposition.\
\>", "Text",
 CellID->1015299810,ExpressionUUID->"5c29c458-c353-7b98-05d6-de05f6e649e2"],

Cell[TextData[{
 "The cavity, the meter itself, tells the same story, and what it shows \
depends on how you read the qubit. Trace the qubit out, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["cavity",
     FontSlant->"Plain"]], "=", 
   SubscriptBox[
    StyleBox["Tr",
     FontSlant->"Plain"], 
    StyleBox["qubit",
     FontSlant->"Plain"]], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1a2d6a-d2ad-c32a-1639-c537e759ae70"],
 ", and the cavity is a fringeless mixture of the two pointer states as soon \
as they separate, since the which-way record now lives in the qubit. But keep \
only the records where the qubit is found in ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", "+", "\[RightAngleBracket]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6eb5612b-2266-f0f1-164b-79755710c2db"],
 " (the basis where its coherence lives), and the conditional cavity is a cat \
of the two pointers, its off-diagonal coherence carrying the qubit's. A \
helper for the cavity conditioned on finding the qubit in a state ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["q", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f4b4965-e043-b514-4549-614e91f71c7e"],
 " takes the qubit matrix element and renormalizes it, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    RowBox[{
     StyleBox["cavity",
      FontSlant->"Plain"], ";", 
     StyleBox["q", "TI"]}]], "=", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["q", "TI"], ",", 
    StyleBox[
     RowBox[{"\[Rho]", "q"}], "TI"]}], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "/", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["q", "TI"], ",", 
    StyleBox[
     RowBox[{"\[Rho]", "q"}], "TI"]}], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf36e21-2d79-2b6f-0980-878b440c79b5"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["q", "TI"], ",", 
    StyleBox[
     RowBox[{"\[Rho]", "q"}], "TI"]}], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fe9f85b-1ce6-27f0-1596-f20594908dda"],
 " leaves a cavity operator and its trace is the probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["q", "TI"], ",", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["qubit",
       FontSlant->"Plain"]], 
     StyleBox["q", "TI"]}]}], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3eadea9f-7d43-757d-6652-03d974f65c47"],
 " of that outcome:"
}], "Text",
 CellID->320909480,ExpressionUUID->"68be2dd2-eea3-f2cb-1845-c49f8b57c011"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cavityGiven", "[", 
    RowBox[{"joint_", ",", " ", "rungs_", ",", " ", "q_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"joint", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "rungs", ",", " ", "2", ",", " ", "rungs"}], 
          "}"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", " ", "=", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Conjugate", "[", 
             RowBox[{"q", "[", 
              RowBox[{"[", "a", "]"}], "]"}], "]"}], " ", 
            RowBox[{"q", "[", 
             RowBox[{"[", "b", "]"}], "]"}], " ", 
            RowBox[{"r", "[", 
             RowBox[{"[", 
              RowBox[{"a", ",", " ", "All", ",", " ", "b", ",", " ", "All"}], 
              "]"}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"b", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"m", "/", 
        RowBox[{"Tr", "[", "m", "]"}]}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[115]:= ",
 CellID->1950243504,ExpressionUUID->"1279eb8d-ef8a-5dbb-4206-02d68a3f2781"],

Cell["\<\
Run the joint master equation once, at a cutoff wide enough for the pointer \
blobs:\
\>", "Text",
 CellID->1158471628,ExpressionUUID->"6afb4307-9f81-9d1b-1a99-5b611a35e461"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dispRungs", " ", "=", " ", "16"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dispRun", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Epsilon]", " ", 
       RowBox[{"onCavity", "[", 
        RowBox[{
         RowBox[{"annihilation", "[", "dispRungs", "]"}], " ", "+", " ", 
         RowBox[{"creation", "[", "dispRungs", "]"}]}], "]"}]}], " ", "+", 
      " ", 
      RowBox[{"\[Chi]", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"Z", ",", " ", 
         RowBox[{
          RowBox[{"creation", "[", "dispRungs", "]"}], " ", ".", " ", 
          RowBox[{"annihilation", "[", "dispRungs", "]"}]}]}], "]"}]}]}], ",",
      "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"onCavity", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Gamma]disp", "]"}], " ", 
        RowBox[{"annihilation", "[", "dispRungs", "]"}]}], "]"}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"densityMatrix", "[", 
      RowBox[{"Flatten", "@", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"plus", ",", " ", 
         RowBox[{"coherentState", "[", 
          RowBox[{"dispRungs", ",", " ", "0"}], "]"}]}], "]"}]}], "]"}], ",", 
     " ", "3."}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[116]:= ",
 CellID->600867794,ExpressionUUID->"2e902be9-4fb4-3e90-56af-c2b36a4684fa"],

Cell[TextData[{
 "In the untruncated driven-damped model, the conditional cavity has a closed \
two-coherent-state form. Its two diagonal blocks are the pointer coherent \
states ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["e", "TI"]], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46e8ad28-93a4-355d-6e97-457226569fa7"],
 " and ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["g", "TI"]], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43090fa7-5002-8b65-7136-a60161b4d64f"],
 "; the qubit coherence carried into the cavity as the off-diagonal weight \
is"
}], "Text",
 CellID->570648126,ExpressionUUID->"0d6689b0-bbf9-a698-3b1d-20fa3d8d0ce2"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["T", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox["1", "2"], 
    StyleBox["exp",
     FontSlant->"Plain"], "\[ThinSpace]", "(", 
    RowBox[{"-", "2", 
     StyleBox["i", "TI"], 
     StyleBox["\[Chi]", "TI"], 
     SubsuperscriptBox["\[Integral]", "0", 
      StyleBox["t", "TI"]], 
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], 
      StyleBox["e", "TI"]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["\[Alpha]", "TI"], 
      StyleBox["g", "TI"], "*"], "\[ThinSpace]", 
     StyleBox["d", "TI"], 
     SuperscriptBox[
      StyleBox["t", "TI"], "\[Prime]"]}], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], 
      StyleBox["e", "TI"]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["\[Alpha]", "TI"], 
      StyleBox["g", "TI"], "*"]}], "=", 
    RowBox[{
     FractionBox[
      SuperscriptBox[
       StyleBox["\[CurlyEpsilon]", "TI"], "2"], 
      SuperscriptBox["\[CapitalLambda]", "2"]], 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "-", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"-", "\[CapitalLambda]", 
          SuperscriptBox[
           StyleBox["t", "TI"], "\[Prime]"]}]]}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{"\[CapitalLambda]", "=", 
    RowBox[{
     StyleBox[
      RowBox[{"i", "\[Chi]"}], "TI"], "+", 
     FractionBox[
      StyleBox["\[Gamma]", "TI"], "2"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1943045306,ExpressionUUID->"4ac87485-b214-a6e0-7ac8-6deec7a60cca"],

Cell[TextData[{
 "an elementary integral. Dividing ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e1d4b5-6b25-2976-7e9e-cdff0ed0785c"],
 " by the pointers' overlap gives the coherence coefficient ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], "=", 
   StyleBox["T", "TI"], "/", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["g", "TI"]], ",", 
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["e", "TI"]]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e41722a-1026-02f0-567f-7474a1d350da"],
 ", so"
}], "Text",
 CellID->1695469705,ExpressionUUID->"6aacec8a-85e6-bbaa-1a53-05d4339009f0"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     RowBox[{
      StyleBox["cavity",
       FontSlant->"Plain"], ";", "+"}]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThickSpace]", "\[Proportional]", "\[ThickSpace]", 
    FractionBox["1", "2"], "\[LeftBracketingBar]", 
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["e", "TI"]], "\[RightAngleBracket]", 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"\[LeftBracketingBar]", 
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["e", "TI"]], "\[RightAngleBracket]"}], 
      StyleBox[")",
       SpanMaxSize->1]}], "\[Dagger]"], "+", 
    FractionBox["1", "2"], "\[LeftBracketingBar]", 
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["g", "TI"]], "\[RightAngleBracket]", 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"\[LeftBracketingBar]", 
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["g", "TI"]], "\[RightAngleBracket]"}], 
      StyleBox[")",
       SpanMaxSize->1]}], "\[Dagger]"], "+", 
    StyleBox["c", "TI"], "\[LeftBracketingBar]", 
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["e", "TI"]], "\[RightAngleBracket]", 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"\[LeftBracketingBar]", 
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["g", "TI"]], "\[RightAngleBracket]"}], 
      StyleBox[")",
       SpanMaxSize->1]}], "\[Dagger]"], "+", 
    SuperscriptBox[
     StyleBox["c", "TI"], "*"], "\[LeftBracketingBar]", 
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["g", "TI"]], "\[RightAngleBracket]", 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"\[LeftBracketingBar]", 
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["e", "TI"]], "\[RightAngleBracket]"}], 
      StyleBox[")",
       SpanMaxSize->1]}], "\[Dagger]"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->808446663,ExpressionUUID->"1c51a735-fee5-6802-446e-3f7efa903b68"],

Cell["Build it directly:", "Text",
 CellID->843355028,ExpressionUUID->"5e54a15d-ecde-9aa9-066b-39068568e8f3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalLambda]", " ", "=", " ", 
   RowBox[{
    RowBox[{"I", " ", "\[Chi]"}], " ", "+", " ", 
    RowBox[{"\[Gamma]disp", "/", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cohT", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", "2"}], ")"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "I", " ", "\[Chi]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Epsilon]", "^", "2"}], "/", 
        RowBox[{"\[CapitalLambda]", "^", "2"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"t", " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "/", "\[CapitalLambda]"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "\[CapitalLambda]"}], " ", "t"}], "]"}], " ", "-", 
           " ", "1"}], ")"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "\[CapitalLambda]"}], ")"}]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "2"}], " ", "\[CapitalLambda]", " ", "t"}], "]"}], 
           " ", "-", " ", "1"}], ")"}]}]}], ")"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cavityCat", "[", 
    RowBox[{"t_", ",", " ", "rungs_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ke", " ", "=", " ", 
        RowBox[{"coherentState", "[", 
         RowBox[{"rungs", ",", " ", 
          RowBox[{"\[Alpha]e", "[", "t", "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"kg", " ", "=", " ", 
        RowBox[{"coherentState", "[", 
         RowBox[{"rungs", ",", " ", 
          RowBox[{"\[Alpha]g", "[", "t", "]"}]}], "]"}]}]}], "}"}], ",", "\n",
      "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"cc", " ", "=", " ", 
         RowBox[{
          RowBox[{"cohT", "[", "t", "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Conjugate", "[", "kg", "]"}], " ", ".", " ", "ke"}], 
           ")"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", " ", "=", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"densityMatrix", "[", "ke", "]"}], "/", "2"}], " ", "+", 
            " ", 
            RowBox[{
             RowBox[{"densityMatrix", "[", "kg", "]"}], "/", "2"}], " ", "+", 
            " ", 
            RowBox[{"cc", " ", 
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"ke", ",", " ", 
               RowBox[{"Conjugate", "[", "kg", "]"}]}], "]"}]}], " ", "+", 
            " ", 
            RowBox[{
             RowBox[{"Conjugate", "[", "cc", "]"}], " ", 
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"kg", ",", " ", 
               RowBox[{"Conjugate", "[", "ke", "]"}]}], "]"}]}]}]}], "}"}], ",",
          "\n", "     ", 
         RowBox[{"m", "/", 
          RowBox[{"Tr", "[", "m", "]"}]}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[117]:= ",
 CellID->2123001010,ExpressionUUID->"27fb6428-ecec-27d4-4d99-7e75849e8d3e"],

Cell["\<\
Confirm the closed form against the simulated conditional cavity across the \
whole readout:\
\>", "Text",
 CellID->1415208481,ExpressionUUID->"51f5ca74-88a2-9d2c-078a-ec3e2954e476"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"traceDistance", "[", 
     RowBox[{
      RowBox[{"cavityCat", "[", 
       RowBox[{"t", ",", " ", "dispRungs"}], "]"}], ",", " ", 
      RowBox[{"cavityGiven", "[", 
       RowBox[{
        RowBox[{"dispRun", "[", "t", "]"}], ",", " ", "dispRungs", ",", " ", 
        "plus"}], "]"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "0.1", ",", " ", "3", ",", " ", "0.1"}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[118]:= ",
 CellID->80082845,ExpressionUUID->"1154648e-ef0b-aa2b-476c-7deb8abff971"],

Cell[TextData[{
 "The maximum trace-distance discrepancy is small but nonzero because the ODE \
integration and Fock truncation are numerical; decreasing the solver \
tolerance and increasing the cutoff reduce it. Within that controlled error, \
the two-coherent-state formula reproduces the simulated conditional cavity. \
Now the question a phase-space picture cannot answer cleanly: cat or mixture? \
Measure the conditional cavity against both references, the pure cat of the \
current pointers ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[LeftBracketingBar]", 
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["e", "TI"]], "\[RightAngleBracket]", "+", "\[LeftBracketingBar]", 
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["g", "TI"]], "\[RightAngleBracket]"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c057904-8649-af2b-743b-716e33fdf271"],
 " and their even mixture, as the readout runs:"
}], "Text",
 CellID->730828669,ExpressionUUID->"2baf9433-2e90-ebaf-5954-0e7d4b2ab9f5"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", "\n", "   ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", " ", 
         RowBox[{"traceDistance", "[", 
          RowBox[{
           RowBox[{"cavityGiven", "[", 
            RowBox[{
             RowBox[{"dispRun", "[", "t", "]"}], ",", " ", "dispRungs", ",", 
             " ", "plus"}], "]"}], ",", " ", 
           RowBox[{"densityMatrix", "@", 
            RowBox[{"Normalize", "[", 
             RowBox[{
              RowBox[{"coherentState", "[", 
               RowBox[{"dispRungs", ",", " ", 
                RowBox[{"\[Alpha]e", "[", "t", "]"}]}], "]"}], " ", "+", " ", 
              
              RowBox[{"coherentState", "[", 
               RowBox[{"dispRungs", ",", " ", 
                RowBox[{"\[Alpha]g", "[", "t", "]"}]}], "]"}]}], "]"}]}]}], 
          "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0.1", ",", " ", "3", ",", " ", "0.05"}], 
        "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", " ", 
         RowBox[{"traceDistance", "[", 
          RowBox[{
           RowBox[{"cavityGiven", "[", 
            RowBox[{
             RowBox[{"dispRun", "[", "t", "]"}], ",", " ", "dispRungs", ",", 
             " ", "plus"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"densityMatrix", "[", 
              RowBox[{"coherentState", "[", 
               RowBox[{"dispRungs", ",", " ", 
                RowBox[{"\[Alpha]e", "[", "t", "]"}]}], "]"}], "]"}], "/", 
             "2"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"densityMatrix", "[", 
              RowBox[{"coherentState", "[", 
               RowBox[{"dispRungs", ",", " ", 
                RowBox[{"\[Alpha]g", "[", "t", "]"}]}], "]"}], "]"}], "/", 
             "2"}]}]}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0.1", ",", " ", "3", ",", " ", "0.05"}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<distance to the pure cat\>\"", ",", 
      " ", "\"\<distance to the classical mixture\>\""}], "}"}]}], ",", "\n", 
   " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<readout time\>\"", ",", " ", "\"\<trace distance\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the conditional cavity starts a cat and decoheres into the \
mixture\>\""}]}], "]"}]], "Input",
 CellLabel->"In[119]:= ",
 CellID->20229285,ExpressionUUID->"340e6ec8-e38f-b030-5c35-8795963b031a"],

Cell[TextData[{
 "Early the conditional cavity hugs the pure cat: the two pointers still \
coincide, so there is little to tell apart and little coherence to lose. As \
they separate its distance to the cat climbs while its distance to the \
mixture falls, the two crossing near ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "\[TildeTilde]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64bff79f-1679-3ebc-0c44-eed9a30d8486"],
 " for these parameters; past there the state is closer to the classical \
mixture, and by the time the pointers are cleanly resolved it is close to \
that mixture. The cat is fleeting because distinguishability and dephasing \
grow together. Contrast the Haroche cat of the earlier section: there the \
dispersive atom imprinted the two phases ",
 StyleBox["before", "TI"],
 " the cavity leaked, so separation came first and decoherence after; here \
they arise from the same readout process. This is dispersive qubit readout in \
circuit QED, where the pointer is a microwave tone reflected off a \
resonator."
}], "Text",
 CellID->865532999,ExpressionUUID->"126dc52b-3dd5-bd31-4212-dd75b461041b"],

Cell["\<\
Part Three: A Heavy Particle, and the Two Faces of a Warm Bath\
\>", "Section",
 CellID->1719354248,ExpressionUUID->"28023c0b-10a3-7000-5831-b655a156436a"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A particle of mass ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f1b960d-0301-b7cd-7538-0857b6b51d17"],
 " in a gentle trap ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["M", "TI"], 
   SuperscriptBox["\[CapitalOmega]", "2"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "268b8fe7-2cf2-fa64-4e88-26c14484c94e"],
 ", coupled to a warm bath (the Caldeira-Leggett model). In the \
high-temperature limit,"
}], "Text",
 CellID->803807756,ExpressionUUID->"41763b34-5a53-ec31-770d-b37e5fe7b71b"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      StyleBox["i", "TI"], 
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       RowBox[{
        FractionBox[
         SuperscriptBox[
          OverscriptBox[
           StyleBox["p", "TI"], "^"], "2"], 
         RowBox[{"2", 
          StyleBox["M", "TI"]}]], "+", 
        FractionBox["1", "2"], 
        StyleBox["M", "TI"], 
        SuperscriptBox["\[CapitalOmega]", "2"], 
        SuperscriptBox[
         OverscriptBox[
          StyleBox["x", "TI"], "^"], "2"]}], ",", " ", 
       StyleBox["\[Rho]", "TI"]}], 
      StyleBox["]",
       SpanMaxSize->1]}]}], "-", 
    StyleBox[
     RowBox[{"i", "\[Gamma]"}], "TI"], "-", 
    RowBox[{"2", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["M", "TI"], 
     SubscriptBox[
      StyleBox["k", "TI"], 
      StyleBox["B", "TI"]], 
     RowBox[{
      StyleBox["T", "TI"], "\[ThinSpace]", "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->601042471,ExpressionUUID->"5d61c4f4-c0fb-847a-0b1e-ddb1f08fef40"],

Cell[TextData[{
 "Friction damps the momentum at rate ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72fe9a0c-0c49-239f-2285-1c56a5fc71e5"],
 "; the double commutator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["x", "TI"], "^"], ",", 
      StyleBox["\[Rho]", "TI"]}], 
     StyleBox["]",
      SpanMaxSize->1]}]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14bcbead-0cb8-f132-3c43-37f7a532c018"],
 " decoheres a superposition of two positions a distance ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a015340-38cc-91ca-7a3f-4b2ab97ee310"],
 " apart at a rate ",
 Cell[BoxData[
  RowBox[{"\[Proportional]", 
   StyleBox["M", "TI"], 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"], "\[ThinSpace]", "\[CapitalDelta]", 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44807b7f-366d-41a7-6cb0-73394318138d"],
 ", quadratic in the separation, the same law as the light-cat. For a smooth \
(Gaussian) blob the first and second moments of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56b5d630-2397-dc8b-7e4a-c87a5623a6d1"],
 " close into a small set of rate equations, exactly the five below."
}], "Text",
 CellID->2038927162,ExpressionUUID->"066e8396-42fa-b64f-2e15-1ad0768c1c95"],

Cell[TextData[{
 "A heavy particle in a harmonic trap ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["M", "TI"], 
   SuperscriptBox["\[CapitalOmega]", "2"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fee4e15-659c-ade9-3596-605f0c2ef733"],
 ", coupled to a warm bath (Caldeira-Leggett). Friction damps the momentum; \
the bath's fluctuations grow the position variance to thermal equilibrium. \
For a Gaussian state the first and second moments of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f99faa1-7599-adaa-15a6-f30b7c2df7f0"],
 " close into five equations: the mean ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["x", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["p", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c80f068-193e-1d5a-14bf-ea3298cb67a0"],
 " and the covariance matrix ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77601adb-bf25-4789-1d1f-93853ad02dd3"],
 " with entries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xx",
      FontSlant->"Plain"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xp",
      FontSlant->"Plain"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["pp",
      FontSlant->"Plain"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48b830c7-d270-6a57-7847-a9a0e70538bd"],
 ". The high-temperature master equation above holds only when ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"], ">", "\[HBar]", "\[CapitalOmega]"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "62f1d7f5-6807-0c72-128e-cebf09b25758"],
 ", so fix the mass, trap frequency, friction, and a temperature well above \
the level spacing ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "\[CapitalOmega]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e2af966-75ba-f15e-4629-f1407c4cc3a4"],
 ":"
}], "Text",
 CellID->1188205371,ExpressionUUID->"7fcb302b-9e92-9019-25c8-aa751b24e363"],

Cell[BoxData[
 RowBox[{
  RowBox[{"M", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"\[CapitalOmega]qbm", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"\[Gamma]qbm", " ", "=", " ", "0.15"}], ";", " ", 
  RowBox[{"kT", " ", "=", " ", "5."}], ";", " ", 
  RowBox[{"Ddiff", " ", "=", " ", 
   RowBox[{"4", " ", "\[Gamma]qbm", " ", "M", " ", "kT"}]}], ";"}]], "Input",
 CellLabel->"In[120]:= ",
 CellID->1003860385,ExpressionUUID->"361ba0ac-b25b-03c3-5e38-3909c7ee5129"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"], "=", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36c5768f-9366-0c29-5efb-6fe926135773"],
 " against a level spacing of ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43fcd6d4-594a-1482-7183-cf9e58ff7ee8"],
 ", the bath is genuinely warm. Written out, those five equations are"
}], "Text",
 CellID->952137231,ExpressionUUID->"4719bc21-ede2-73f0-6d26-358a8b9741da"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["x", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], "."], "=", 
    FractionBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["p", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox["M", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    OverscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["p", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], "."], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       StyleBox["M", "TI"]}], 
      SuperscriptBox["\[CapitalOmega]", "2"], 
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["x", "TI"], "^"], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]}], "-", 
     RowBox[{"2", 
      StyleBox["\[Gamma]", "TI"], 
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["p", "TI"], "^"], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1052272830,ExpressionUUID->"71a147e0-ad25-39c0-275f-5ecdc4d18b2a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalSigma]", "."], 
     StyleBox["xx",
      FontSlant->"Plain"]], "=", 
    FractionBox[
     RowBox[{"2", 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["xp",
        FontSlant->"Plain"]]}], 
     StyleBox["M", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalSigma]", "."], 
     StyleBox["xp",
      FontSlant->"Plain"]], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["pp",
        FontSlant->"Plain"]], 
      StyleBox["M", "TI"]], "-", 
     RowBox[{
      StyleBox["M", "TI"], 
      SuperscriptBox["\[CapitalOmega]", "2"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["xx",
        FontSlant->"Plain"]]}], "-", 
     RowBox[{"2", 
      StyleBox["\[Gamma]", "TI"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["xp",
        FontSlant->"Plain"]]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalSigma]", "."], 
     StyleBox["pp",
      FontSlant->"Plain"]], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], 
      StyleBox["M", "TI"], 
      SuperscriptBox["\[CapitalOmega]", "2"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["xp",
        FontSlant->"Plain"]]}], "-", 
     RowBox[{"4", 
      StyleBox["\[Gamma]", "TI"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["pp",
        FontSlant->"Plain"]]}], "+", 
     StyleBox["D", "TI"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->775731387,ExpressionUUID->"0d94734f-f5fd-5b1e-3bac-6b2883882664"],

Cell[TextData[{
 "with diffusion coefficient ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], "=", "4", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["M", "TI"], 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a66d044-93ea-cfa5-7a1d-ca2e259c958f"],
 ". The initial covariance must itself be a valid quantum state, so start \
from the trap's ground state, the minimum-uncertainty blob with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["xx",
     FontSlant->"Plain"]], "=", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["pp",
     FontSlant->"Plain"]], "=", "\[HBar]", "/", "2", "=", "1", "/", "2"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08e3a6ae-198b-2f89-3890-3f08983e75d3"],
 " (so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalSigma]", "=", 
   SuperscriptBox["\[HBar]", "2"], "/", "4", "=", "1", "/", "4"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07ff9e3d-196e-b566-2d84-106798181c4c"],
 "), displaced off the origin. Integrate them from there:"
}], "Text",
 CellID->975612517,ExpressionUUID->"7611561e-6aa4-cbf1-1e2f-48580f5699db"],

Cell[BoxData[
 RowBox[{
  RowBox[{"particle", " ", "=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"cx", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"cp", "[", "t", "]"}], "/", "M"}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"cp", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "M"}], " ", 
          RowBox[{"\[CapitalOmega]qbm", "^", "2"}], " ", 
          RowBox[{"cx", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"2", " ", "\[Gamma]qbm", " ", 
          RowBox[{"cp", "[", "t", "]"}]}]}]}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"vx", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{"2", " ", 
         RowBox[{
          RowBox[{"vc", "[", "t", "]"}], "/", "M"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"vc", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"vp", "[", "t", "]"}], "/", "M"}], " ", "-", " ", 
         RowBox[{"M", " ", 
          RowBox[{"\[CapitalOmega]qbm", "^", "2"}], " ", 
          RowBox[{"vx", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"2", " ", "\[Gamma]qbm", " ", 
          RowBox[{"vc", "[", "t", "]"}]}]}]}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"vp", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "M", " ", 
          RowBox[{"\[CapitalOmega]qbm", "^", "2"}], " ", 
          RowBox[{"vc", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"4", " ", "\[Gamma]qbm", " ", 
          RowBox[{"vp", "[", "t", "]"}]}], " ", "+", " ", "Ddiff"}]}], ",", 
       "\n", "   ", 
       RowBox[{
        RowBox[{"cx", "[", "0", "]"}], " ", "==", " ", "2."}], ",", " ", 
       RowBox[{
        RowBox[{"cp", "[", "0", "]"}], " ", "==", " ", "0."}], ",", " ", 
       RowBox[{
        RowBox[{"vx", "[", "0", "]"}], " ", "==", " ", "0.5"}], ",", " ", 
       RowBox[{
        RowBox[{"vc", "[", "0", "]"}], " ", "==", " ", "0."}], ",", " ", 
       RowBox[{
        RowBox[{"vp", "[", "0", "]"}], " ", "==", " ", "0.5"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
      "cx", ",", " ", "cp", ",", " ", "vx", ",", " ", "vc", ",", " ", "vp"}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "30"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[121]:= ",
 CellID->105335494,ExpressionUUID->"6d91ad73-9dce-768e-1bae-453d147b5cd4"],

Cell["Two readers, the mean and the covariance matrix:", "Text",
 CellID->1276006902,ExpressionUUID->"6bff65fb-5d0a-196c-1985-7ca554bf6bb6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"center", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"particle", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"particle", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "[", "t", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"spread", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"particle", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"particle", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "[", "t", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"particle", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"particle", "[", 
         RowBox[{"[", "5", "]"}], "]"}], "[", "t", "]"}]}], "}"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[122]:= ",
 CellID->429330924,ExpressionUUID->"5e58ca76-8595-5ac4-0667-ec302c20282e"],

Cell["\<\
Two checks. First, the mean spirals in from its displaced start to rest:\
\>", "Text",
 CellID->699653744,ExpressionUUID->"08a91809-3406-7705-3856-9253bdb35a6f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"center", "[", "0", "]"}], ",", " ", 
   RowBox[{"center", "[", "25", "]"}]}], "}"}]], "Input",
 CellLabel->"In[123]:= ",
 CellID->2118070064,ExpressionUUID->"47ee4125-d524-d464-6d96-588edcd6bf4e"],

Cell[TextData[{
 "It starts displaced and ends near the origin. Second, the position variance \
",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["xx",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a0bea5a-c3ff-c671-4a08-0c07f58bad5b"],
 " grows from its ground-state value ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "/", "2", "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d2ec88d-5e53-28f6-54d5-e1d75be67adc"],
 " to the thermal value ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["M", "TI"], 
    SuperscriptBox["\[CapitalOmega]", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230fc3bf-d3e5-5aa5-5134-daf8e590288f"],
 ", equipartition for a harmonic trap:"
}], "Text",
 CellID->1744932242,ExpressionUUID->"0c6e076f-8b93-3c10-3415-9f492e27877a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"particle", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "[", "0", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"particle", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "[", "25", "]"}], ",", " ", 
   RowBox[{"kT", "/", 
    RowBox[{"(", 
     RowBox[{"M", " ", 
      RowBox[{"\[CapitalOmega]qbm", "^", "2"}]}], ")"}]}]}], "}"}]], "Input",
 CellLabel->"In[124]:= ",
 CellID->551334296,ExpressionUUID->"29094997-c9cb-f733-5f37-60d0e87fda19"],

Cell["\<\
It lands on the thermal value, ten times the ground-state spread. Check it a \
second way: the steady covariance solves the Lyapunov equation, where \
diffusion balances friction:\
\>", "Text",
 CellID->682025647,ExpressionUUID->"284fc6fb-b6ce-6422-5874-dfa4c37b4f08"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"drift", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"1", "/", "M"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "M"}], " ", 
        RowBox[{"\[CapitalOmega]qbm", "^", "2"}]}], ",", " ", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[Gamma]qbm"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"LyapunovSolve", "[", 
  RowBox[{"drift", ",", " ", 
   RowBox[{"-", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "Ddiff"}], "}"}]}], "}"}]}]}], "]"}]}], "Input",\

 CellLabel->"In[125]:= ",
 CellID->1646424406,ExpressionUUID->"0cad16aa-0a89-b805-3452-8ff4af3d0b6f"],

Cell["The Lyapunov steady state matches the integrated one.", "Text",
 CellID->2053055694,ExpressionUUID->"5640583a-c911-1fe8-7e70-5267e8a46532"],

Cell[TextData[{
 "The same covariance bookkeeping returns under monitoring in Part Five. The \
Kalman filter's watched oscillator obeys ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox["\[CapitalSigma]", "."], "=", 
   StyleBox["A", "TI"], "\[CapitalSigma]", "+", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["T", "TI"]], "+", 
   StyleBox["D", "TI"], "-", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["T", "TI"]], 
   StyleBox["C", "TI"], "\[CapitalSigma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6944803a-8297-e066-1f7b-1a643723b34c"],
 ", the Lyapunov form above plus one term the bath cannot supply, the \
measurement's information gain ",
 Cell[BoxData[
  RowBox[{"-", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["T", "TI"]], 
   StyleBox["C", "TI"], "\[CapitalSigma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9e495e-a796-7cd0-26a6-611bd223463a"],
 ": diffusion widens the blob to thermal here, watching narrows it below the \
ground-state spread there."
}], "Text",
 CellID->2132198261,ExpressionUUID->"534f7e63-03c8-ee33-0175-704db662b519"],

Cell[TextData[{
 "One more check the model must pass to be believed: a real quantum state \
obeys the Robertson-Schrodinger uncertainty relation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalSigma]", "=", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["xx",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["pp",
     FontSlant->"Plain"]], "-", 
   SubsuperscriptBox["\[CapitalSigma]", 
    StyleBox["xp",
     FontSlant->"Plain"], "2"], "\[GreaterEqual]", 
   SuperscriptBox["\[HBar]", "2"], "/", "4", "=", "1", "/", "4"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b07ad27-9e6a-154b-693c-44811b1f7f91"],
 ", so the margin ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalSigma]", "-", "1", "/", 
   "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c7a415c-3e53-b7cb-441a-5906bbe71d11"],
 " must stay non-negative for the whole run. The high-temperature \
Caldeira-Leggett generator is not of Lindblad form, so this is not automatic; \
watch it directly:"
}], "Text",
 CellID->1954495564,ExpressionUUID->"417aec05-2fbb-8238-7719-066f4a4fd102"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Det", "@", 
     RowBox[{"spread", "[", "t", "]"}]}], " ", "-", " ", 
    RowBox[{"1", "/", "4"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "25"}], "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<uncertainty margin  det \[CapitalSigma] - 1/4\>\""}], "}"}]}],
    ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the state stays above the uncertainty floor\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[126]:= ",
 CellID->1504758964,ExpressionUUID->"4705486f-1ac0-4964-6d3b-62499f75184e"],

Cell[TextData[{
 "The margin starts at zero, where the ground state saturates the bound, and \
only grows for this valid high-temperature run: the blob swells above the \
Heisenberg floor and never dips below it. Starting instead from ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["xx",
     FontSlant->"Plain"]], "=", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["pp",
     FontSlant->"Plain"]], "=", "0.1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3af5a034-7641-6879-6a8a-3a7e03f43b43"],
 " would already violate the bound at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68379bed-79e9-22be-19cc-12b77f9c7084"],
 "; the moment equations can later carry that covariance into the valid \
region, but doing so does not retroactively make the initial state physical. \
Conversely, at temperatures outside the model's high-temperature regime this \
non-Lindblad generator can drive an initially valid covariance below the \
floor. The point of the plotted check is therefore local and explicit: the \
chosen parameters and initial state remain physical throughout the displayed \
interval."
}], "Text",
 CellID->885403737,ExpressionUUID->"460eb9f9-c41e-8ef4-6e35-30a2eda8d4de"],

Cell[TextData[{
 "Those checks read the mean and the variance as numbers; the phase-space \
picture puts them in one object. That object is the state's ",
 StyleBox["Wigner function",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "258251be-7c16-7495-53b2-48f875a35eff"],
 ", the quasiprobability the cat used in Part Two, except that for a Gaussian \
state no Fock-basis sum is needed: ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35c1f832-722b-ca69-63fe-f27c07df98b3"],
 " is exactly the bivariate normal set by the five moments, centered at the \
mean ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["r", "TI"], "_"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["x", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["p", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6a50da-eb07-3910-296a-49878eb3887a"],
 " and shaped by the covariance ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23591dbb-79d4-ec10-5166-94e57866b77a"],
 ","
}], "Text",
 CellID->299015440,ExpressionUUID->"114fd905-c79d-9420-4774-d16ef229ff0a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["W", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox["1", 
     RowBox[{"2", "\[Pi]", 
      SqrtBox[
       RowBox[{
        StyleBox["det",
         FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalSigma]"}]]}]], "\[ThinSpace]", 
    StyleBox["exp",
     FontSlant->"Plain"], "\[ThinSpace]", "(", 
    RowBox[{"-", 
     FractionBox["1", "2"], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["r", "TI"], "-", 
        OverscriptBox[
         StyleBox["r", "TI"], "_"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      StyleBox["T", "TI"]], "\[ThinSpace]", 
     SuperscriptBox["\[CapitalSigma]", 
      RowBox[{"-", "1"}]], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["r", "TI"], "-", 
      OverscriptBox[
       StyleBox["r", "TI"], "_"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["r", "TI"], "=", 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->59570862,ExpressionUUID->"0047a90f-9cb0-808d-307c-4169154ad2d7"],

Cell[TextData[{
 "normalized so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   StyleBox["W", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["p", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42e32fd7-26e6-6b71-7290-c6915293365b"],
 ". Transcribe it as a function of time, reading ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["r", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a2652ed-88d4-efb2-7bde-4bb72966b598"],
 " and ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0962d9db-7466-8598-3f11-d0857d10efe2"],
 " off the solution at each ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b3d557b-19e1-b503-0ac3-4d259f951c69"],
 ":"
}], "Text",
 CellID->1364978316,ExpressionUUID->"529c5c95-0588-d8f1-02a4-55dfac22aadb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"wignerGaussian", "[", 
    RowBox[{"t_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r0", " ", "=", " ", 
        RowBox[{"center", "[", "t", "]"}]}], ",", " ", 
       RowBox[{"iS", " ", "=", " ", 
        RowBox[{"Inverse", "[", 
         RowBox[{"spread", "[", "t", "]"}], "]"}]}], ",", " ", 
       RowBox[{"nrm", " ", "=", " ", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "Pi", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"Det", "[", 
             RowBox[{"spread", "[", "t", "]"}], "]"}], "]"}]}], ")"}]}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "p"}], "}"}], ",", " ", 
       RowBox[{"nrm", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x", ",", " ", "p"}], "}"}], " ", "-", " ", "r0"}], 
              ")"}], " ", ".", " ", "iS", " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x", ",", " ", "p"}], "}"}], " ", "-", " ", "r0"}], 
              ")"}]}], ")"}]}], "/", "2"}], "]"}]}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[127]:= ",
 CellID->565097818,ExpressionUUID->"18bedc4a-f6ca-97e0-4845-d617837cfdca"],

Cell["\<\
Trace the mean's whole path once, a faint guide to lay under the moving blob:\
\
\>", "Text",
 CellID->1520041768,ExpressionUUID->"5f18273e-5cf5-00f5-0527-bf78548052df"],

Cell[BoxData[
 RowBox[{
  RowBox[{"centerLine", " ", "=", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"center", "[", "t", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "25", ",", " ", "0.05"}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thin", ",", " ", "Gray"}], "]"}]}]}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[128]:= ",
 CellID->862412655,ExpressionUUID->"1890d11b-851d-d227-48af-c9452ca9a10d"],

Cell["\<\
Now set it in motion from the displaced start: the Wigner bump rides the gray \
path in toward the origin as friction drains the mean, and fills out to the \
thermal size as diffusion widens it, the red dot marking where the mean sits \
at each instant. Press play:\
\>", "Text",
 CellID->426217663,ExpressionUUID->"5b8be800-baff-aedd-0988-026a3e8bf427"],

Cell[BoxData[
 RowBox[{"Animate", "[", 
  RowBox[{
   RowBox[{"Show", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"DensityPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"wignerGaussian", "[", "t", "]"}], "[", 
        RowBox[{"x", ",", " ", "p"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", 
         RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"PlotPoints", " ", "->", " ", "60"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "    ", 
       RowBox[{"ColorFunction", " ", "->", " ", "\"\<SunsetColors\>\""}], ",",
        " ", 
       RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "400"}], ",", "\n", "    ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"\"\<Wigner W(x,p) at t = \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "t", "]"}]}]}], ",", "\n", "    ", 
       RowBox[{"Epilog", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Red", ",", " ", 
          RowBox[{"Point", "[", 
           RowBox[{"center", "[", "t", "]"}], "]"}]}], "}"}]}]}], "]"}], ",", 
     " ", "centerLine"}], "]"}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "25", ",", " ", ".1"}], "}"}], ",", 
   " ", 
   RowBox[{"AnimationRunning", " ", "->", " ", "False"}]}], "]"}]], "Input",
 CellLabel->"In[129]:= ",
 CellID->128954499,ExpressionUUID->"224fae0e-4768-b263-5274-406872020149"],

Cell[TextData[{
 "It stays a single Gaussian bump the whole way, never developing finer \
structure: the state never leaves the five-number family, the closure that \
let five equations describe it in the first place. Friction and diffusion are \
the same bath's two effects, tied by the fluctuation-dissipation relation: \
the friction rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d32ba1d-71ed-60b8-64c1-3c4707983282"],
 " is set by the coupling, while the diffusion (and so the thermal spread the \
blob swells to) grows with temperature."
}], "Text",
 CellID->731716873,ExpressionUUID->"3ccd4f42-4869-4b08-64f3-672c691c1652"],

Cell[TextData[{
 "The sharper effect, and why this sits beside the cavity cat: a \
superposition of two positions decoheres, and a warm bath does it faster than \
a cold one. Here the model changes from the Caldeira-Leggett moment equations \
above to the thermal-oscillator Lindblad master equation (a decay channel ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cf63df4-f608-7ba6-348d-b4b183bd498c"],
 " at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60948258-d69f-7f2c-10ab-2405e32a4276"],
 " and an excitation channel ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf5c13c-8c81-f0bf-098a-d9662535c285"],
 " at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27ebc314-3813-af61-4de8-db5eb9a7f24b"],
 ", the same warm-bath form used later for thermalization), integrated in a \
truncated Fock basis. Build the same coherent-state cat and evolve it under \
that bath. Set the oscillator cutoff and the bath's rate:"
}], "Text",
 CellID->263464368,ExpressionUUID->"59cd495b-92f8-de82-0ff3-61052772a4e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"twoRung", " ", "=", " ", "22"}], ";", " ", 
  RowBox[{"\[Gamma]warm", " ", "=", " ", "0.5"}], ";"}]], "Input",
 CellLabel->"In[130]:= ",
 CellID->519276129,ExpressionUUID->"1597811c-d04f-58d0-43ac-1959e1fa2a3a"],

Cell[TextData[{
 "The surviving coherence is the trace distance between the coherently \
evolved cat and the classical mixture its two lobes would form, both carried \
through the same thermal bath ",
 Cell[BoxData[
  RowBox[{"\[ScriptCapitalL]", 
   StyleBox["\[Rho]", "TI"], "=", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"], "+", 
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d69ae9d-d0a3-a5e3-3b16-47c6e1570fc9"],
 ":"
}], "Text",
 CellID->1441306302,ExpressionUUID->"1e10fbdd-fcac-b923-462f-f286f55e0809"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["warmCoherence",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["T", "TI"]], ",", 
       StyleBox["\[Alpha]", "TI"], ",", 
       StyleBox["t", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     FractionBox["1", "2"], "\[ThinSpace]", 
     StyleBox["Tr",
      FontSlant->"Plain"], GridBox[{
       {
        RowBox[{"\[ThinSpace]", 
         RowBox[{
          RowBox[{
           SubscriptBox[
            StyleBox["\[Rho]", "TI"], 
            StyleBox["cat",
             FontSlant->"Plain"]], 
           RowBox[{
            StyleBox["(",
             SpanMaxSize->1], 
            StyleBox["t", "TI"], 
            StyleBox[")",
             SpanMaxSize->1]}]}], "-", 
          RowBox[{
           FractionBox["1", "2"], 
           StyleBox["[",
            SpanMaxSize->1], 
           RowBox[{
            SubscriptBox[
             StyleBox["\[Rho]", "TI"], 
             RowBox[{"+", 
              StyleBox["\[Alpha]", "TI"]}]], 
            StyleBox["(",
             SpanMaxSize->1], 
            StyleBox["t", "TI"], 
            StyleBox[")",
             SpanMaxSize->1], "+", 
            SubscriptBox[
             StyleBox["\[Rho]", "TI"], 
             RowBox[{"-", 
              StyleBox["\[Alpha]", "TI"]}]], 
            StyleBox["(",
             SpanMaxSize->1], 
            StyleBox["t", "TI"], 
            StyleBox[")",
             SpanMaxSize->1]}], 
           StyleBox["]",
            SpanMaxSize->1]}], "\[ThinSpace]"}]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["cat",
       FontSlant->"Plain"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"\[ScriptCapitalL]", 
       StyleBox["t", "TI"]}]], 
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{"\[LeftBracketingBar]", 
      StyleBox["cat",
       FontSlant->"Plain"], "\[RightAngleBracket]", 
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"\[LeftBracketingBar]", 
         StyleBox["cat",
          FontSlant->"Plain"], "\[RightAngleBracket]"}], 
        StyleBox[")",
         SpanMaxSize->1]}], "\[Dagger]"]}], 
     StyleBox["]",
      SpanMaxSize->1]}]}], ",", " ", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      RowBox[{"\[PlusMinus]", 
       StyleBox["\[Alpha]", "TI"]}]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"\[ScriptCapitalL]", 
       StyleBox["t", "TI"]}]], 
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{"\[PlusMinus]", 
       StyleBox["\[Alpha]", "TI"]}], "\[RightAngleBracket]", 
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"\[LeftBracketingBar]", 
         RowBox[{"\[PlusMinus]", 
          StyleBox["\[Alpha]", "TI"]}], "\[RightAngleBracket]"}], 
        StyleBox[")",
         SpanMaxSize->1]}], "\[Dagger]"]}], 
     StyleBox["]",
      SpanMaxSize->1]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->370920483,ExpressionUUID->"68c26b95-e958-d351-18f1-82de88d2a1bb"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["gap",
    FontSlant->"Plain"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56b7d10b-4c3b-5ee0-7e4c-c95565ce24ca"],
 ". Here ",
 Cell[BoxData["gap"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40ed67f4-ffa0-5cce-7093-7eb1fa552614"],
 " is the coherent amplitude of either lobe and therefore half their \
phase-space amplitude separation ",
 Cell[BoxData[
  RowBox[{"2", GridBox[{
     {
      StyleBox["\[Alpha]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dc0df98-8a2c-0889-7bff-d6c22fd95ad3"],
 ". It is largest while the cat is still distinct from that mixture and falls \
to zero as the cross-terms decohere (both thermalize to the same steady \
state). The bath's ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2226f602-e60c-c55a-53dd-e86f93beafa0"],
 " channel heats a coherent state, so the two lobes will not stay coherent \
and are evolved rather than written down; compute it over a list of delays, \
one run each for the cat and its lobes:"
}], "Text",
 CellID->1675734937,ExpressionUUID->"4ed808ee-885a-0ea1-76e7-a1c829ef548b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"warmCoherence", "[", 
    RowBox[{"nT_", ",", " ", "gap_", ",", " ", "delays_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fall", " ", "=", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"\[Gamma]warm", " ", 
           RowBox[{"(", 
            RowBox[{"nT", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", 
         RowBox[{"annihilation", "[", "twoRung", "]"}]}]}], ",", " ", 
       RowBox[{"climb", " ", "=", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"\[Gamma]warm", " ", "nT"}], "]"}], " ", 
         RowBox[{"creation", "[", "twoRung", "]"}]}]}], ",", "\n", "    ", 
       RowBox[{"pair", " ", "=", " ", 
        RowBox[{"densityMatrix", "@", 
         RowBox[{"Normalize", "[", 
          RowBox[{
           RowBox[{"coherentState", "[", 
            RowBox[{"twoRung", ",", " ", "gap"}], "]"}], " ", "+", " ", 
           RowBox[{"coherentState", "[", 
            RowBox[{"twoRung", ",", " ", 
             RowBox[{"-", "gap"}]}], "]"}]}], "]"}]}]}], ",", "\n", "    ", 
       RowBox[{"blobA", " ", "=", " ", 
        RowBox[{"densityMatrix", "[", 
         RowBox[{"coherentState", "[", 
          RowBox[{"twoRung", ",", " ", "gap"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"blobB", " ", "=", " ", 
        RowBox[{"densityMatrix", "[", 
         RowBox[{"coherentState", "[", 
          RowBox[{"twoRung", ",", " ", 
           RowBox[{"-", "gap"}]}], "]"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"runs", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"evolveODE", "[", 
            RowBox[{
             RowBox[{"0", " ", 
              RowBox[{"IdentityMatrix", "[", "twoRung", "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"fall", ",", " ", "climb"}], "}"}], ",", " ", "#", ",", 
             " ", 
             RowBox[{"Max", "[", "delays", "]"}]}], "]"}], " ", "&"}], " ", "/@",
           " ", 
          RowBox[{"{", 
           RowBox[{"pair", ",", " ", "blobA", ",", " ", "blobB"}], "}"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "@", 
           RowBox[{"SingularValueList", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"runs", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", "t", "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"runs", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "[", "t", "]"}], " ", "+", 
                " ", 
                RowBox[{
                 RowBox[{"runs", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}]}], ")"}], "/",
               "2"}]}], "]"}]}], "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "delays"}], "}"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[131]:= ",
 CellID->1811399761,ExpressionUUID->"1627cdbb-2852-50d0-3fdc-e4e549e7223a"],

Cell["\<\
Now visualize the temperature dependence by comparing a cold and a warm bath \
at the same separation:\
\>", "Text",
 CellID->417262126,ExpressionUUID->"6801141d-c5dc-e96b-183e-8e46ec6ebbb1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"warmTimes", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", "1.5", ",", " ", "0.06"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"warmTimes", ",", " ", 
        RowBox[{"warmCoherence", "[", 
         RowBox[{"0.15", ",", " ", "1.5", ",", " ", "warmTimes"}], "]"}]}], 
       "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"warmTimes", ",", " ", 
        RowBox[{"warmCoherence", "[", 
         RowBox[{"1.5", ",", " ", "1.5", ",", " ", "warmTimes"}], "]"}]}], 
       "}"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<cold bath\>\"", ",", " ", "\"\<warm bath\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<surviving coherence\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<a warm bath decoheres the cat faster than a cold one\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[132]:= ",
 CellID->1077936938,ExpressionUUID->"2fb5e010-3b47-28f4-554a-fa5abef27ade"],

Cell[TextData[{
 "The warm bath decoheres the cat far faster: the rate grows with \
temperature. As with the cavity cat, the rate also grows with the separation: \
together the decoherence rate scales as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    OverscriptBox[
     StyleBox["n", "TI"], "_"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69461d9a-9714-a717-1f7d-94c422a60a7d"],
 " times the ",
 StyleBox["square", "TI"],
 " of the separation. The ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3cd9b2-b2f5-0832-4ac3-d0ffc6805b18"],
 " is the zero-point (vacuum) term that decoheres even a cold cavity cat; \
temperature adds to it, so heating speeds decoherence but is not what starts \
it. For macroscopic separations the rate is enormous at any temperature: the \
fuller answer to why superpositions of large objects become so difficult to \
preserve as their separation grows. Sweep the cat size continuously at the \
fixed short delay, and the two effects trade off:"
}], "Text",
 CellID->181325614,ExpressionUUID->"17254721-59fc-dba5-3edb-5e8b5f8ea98f"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sep", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "3", ",", " ", "0.05"}], "]"}]}], "}"}], ",", 
     " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", " ", 
         RowBox[{
          RowBox[{"warmCoherence", "[", 
           RowBox[{"1.5", ",", " ", "#", ",", " ", 
            RowBox[{"{", "0.15", "}"}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", " ",
       "sep"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<coherent amplitude |\[Alpha]| (half-separation)\>\"", ",", 
      " ", "\"\<surviving coherence at fixed short delay\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<surviving coherence peaks at a modest cat size, then \
falls\>\""}]}], "]"}]], "Input",
 CellLabel->"In[133]:= ",
 CellID->2020910698,ExpressionUUID->"52d6b4d2-7b23-95d3-02ed-2d9c7ed7ff39"],

Cell["\<\
The curve is not monotonic: a bigger cat starts with more coherence but \
decoheres faster, at a rate set by the separation squared, so at a fixed \
short delay the two trade off and the coherence peaks at a modest size before \
the quadratic decoherence overruns it. (Stop at separation 3: past there the \
Fock cutoff clips the coherent states.)\
\>", "Text",
 CellID->661155756,ExpressionUUID->"133f88c9-4e43-c7a8-42c4-21936bf7adf2"],

Cell["Part Four: One Leak, Three Ways to Watch It", "Section",
 CellID->1040242161,ExpressionUUID->"525bf512-066b-f79b-0278-ed5cb31fdde1"],

Cell[TextData[{
 "So far we mostly averaged over the record. Now we keep it. The key fact: \
the same master equation can be ",
 StyleBox["unravelled",
  FontWeight->"Bold"],
 " into trajectories in genuinely different ways, each giving different \
single histories that all average to the same master equation. We watch one \
driven, emitting atom three ways. Fix the atom, its drive, its decay channel, \
and the time grid:"
}], "Text",
 CellID->758481243,ExpressionUUID->"7020b0a8-e1ec-de26-21df-29f5979ea50c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalOmega]atom", " ", "=", " ", "3.0"}], ";", " ", 
  RowBox[{"\[Gamma]atom", " ", "=", " ", "1.0"}], ";", " ", 
  RowBox[{"Hdrive", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[CapitalOmega]atom", "/", "2"}], ")"}], " ", "X"}]}], ";", " ", 
  RowBox[{"cAtom", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "\[Gamma]atom", "]"}], " ", "lower"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dtAtom", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"when", " ", "=", " ", 
   RowBox[{"dtAtom", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "600"}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[134]:= ",
 CellID->607101385,ExpressionUUID->"6f4e56ea-c348-0e14-1576-4fb7f6fd557e"],

Cell["A reader for the excited-state population:", "Text",
 CellID->718676885,ExpressionUUID->"2c7820da-3afe-8c15-5407-b984be88d77f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"excitedPop", "[", "rho_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{
       RowBox[{"blochVector", "[", "rho", "]"}], "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "/", "2"}]}], ";"}]], "Input",\

 CellLabel->"In[135]:= ",
 CellID->1099629263,ExpressionUUID->"491026a6-dd30-329c-7f2f-bf03d4ca80e6"],

Cell["\<\
Integrate the master equation for the population every unravelling must \
average back to:\
\>", "Text",
 CellID->2120979663,ExpressionUUID->"78f9e5c0-5bc5-e73b-2886-fcaa5e71ca01"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"smoothAtom", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{"Hdrive", ",", " ", 
     RowBox[{"{", "cAtom", "}"}], ",", " ", 
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "6.0"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"averageChance", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"excitedPop", "[", 
      RowBox[{"smoothAtom", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
    " ", "when"}]}], ";"}]}], "Input",
 CellLabel->"In[136]:= ",
 CellID->123468129,ExpressionUUID->"295a1104-8f0a-9295-5f79-896e2abce0ff"],

Cell["Counting the Flashes, One at a Time", "Subsection",
 CellID->513893082,ExpressionUUID->"34e49fcf-314b-942d-5c9b-16a940ffff77"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Any leak ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28081ee1-9923-6846-5837-97cb18d63aac"],
 " can be ",
 StyleBox["unravelled", "TI"],
 " by watching its output, each way of detecting the emitted light giving one \
unravelling into pure-state histories. Counting photons one click at a time \
gives the jump trajectory"
}], "Text",
 CellID->1710240506,ExpressionUUID->"35d104ab-d16d-b332-63ee-9df4e0191e18"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], "\[LeftBracketingBar]", 
    StyleBox["\[Psi]", "TI"], "\[RightAngleBracket]", "=", "[", 
    RowBox[{
     StyleBox["d", "TI"], 
     StyleBox["N", "TI"], "(", 
     RowBox[{
      FractionBox[
       OverscriptBox[
        StyleBox["c", "TI"], "^"], 
       SqrtBox[
        RowBox[{
         StyleBox["\[LeftAngleBracket]",
          SpanMaxSize->1], 
         RowBox[{
          SuperscriptBox[
           OverscriptBox[
            StyleBox["c", "TI"], "^"], "\[Dagger]"], 
          OverscriptBox[
           StyleBox["c", "TI"], "^"]}], 
         StyleBox["\[RightAngleBracket]",
          SpanMaxSize->1]}]]], "-", "\|01d7d9"}], ")", "+", 
     StyleBox["d", "TI"], 
     StyleBox["t", "TI"], "(", 
     RowBox[{
      FractionBox[
       RowBox[{
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        RowBox[{
         SuperscriptBox[
          OverscriptBox[
           StyleBox["c", "TI"], "^"], "\[Dagger]"], 
         OverscriptBox[
          StyleBox["c", "TI"], "^"]}], 
        StyleBox["\[RightAngleBracket]",
         SpanMaxSize->1]}], "2"], "-", 
      FractionBox[
       RowBox[{
        SuperscriptBox[
         OverscriptBox[
          StyleBox["c", "TI"], "^"], "\[Dagger]"], 
        OverscriptBox[
         StyleBox["c", "TI"], "^"]}], "2"], "-", 
      StyleBox["i", "TI"], 
      OverscriptBox[
       StyleBox["H", "TI"], "^"]}], ")"}], "]", "\[LeftBracketingBar]", 
    StyleBox["\[Psi]", "TI"], "\[RightAngleBracket]"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1971880122,ExpressionUUID->"4f8fdcfc-c987-8804-75b4-d5b9e833db6e"],

Cell[TextData[{
 "where the click ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["N", "TI"], "\[Element]", "{", "0"}], ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bb02784-750c-cc73-794f-beee7cbe9759"],
 " arrives at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6368bf1a-89ab-f709-1117-3744285fda53"],
 ": between clicks the norm decays under the non-Hermitian ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "-", 
   FractionBox[
    StyleBox["i", "TI"], "2"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18aa8291-c565-6e81-48a9-1bdaec1034eb"],
 ", and at a click the state jumps by ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["c", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fb37437-3ad9-e813-3541-6e71bf6dbb79"],
 ". In continuous time, averaging ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["\[Psi]", "TI"], "\[RightAngleBracket]", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[LeftBracketingBar]", 
      StyleBox["\[Psi]", "TI"], "\[RightAngleBracket]"}], 
     StyleBox[")",
      SpanMaxSize->1]}], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29c235d7-86a4-1a63-5ff1-ac9133516949"],
 " over histories returns the master equation. The finite-step simulation \
below also carries Bernoulli time-discretization error, so its comparison \
contains both that bias and ensemble scatter."
}], "Text",
 CellID->482876923,ExpressionUUID->"7c4bd199-468e-1df0-2448-c8c3733b67da"],

Cell[TextData[{
 "The first way, ",
 StyleBox["photon counting",
  FontWeight->"Bold"],
 ": detect each emitted photon. Between clicks the state evolves under the \
non-Hermitian ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "-", 
   FractionBox[
    StyleBox["i", "TI"], "2"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5faac466-18c1-c293-05a9-de40997590f9"],
 "; at each click it jumps by ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["c", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b2a52a2-44e1-aebb-392a-4b0c6c95f481"],
 " to the ground state. A single run is one sweep that does both jobs at \
once: ",
 Cell[BoxData["FoldList"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "146756d1-ea39-ec02-3c1d-4f9a8fcdb768"],
 " advances and keeps the conditioned state at every step (a jump with \
probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a7ee52b-d767-0389-4a05-fd74e21251d3"],
 ", else the no-click drift), while ",
 Cell[BoxData["Sow"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "419fd7e1-c297-cbe2-77a4-cecaf72399c8"],
 " writes down the time whenever the jump fires. It returns the inferred \
state history and the raw click record together, because in a real experiment \
they are one run, not two. Everything that follows, one trajectory, the \
ensemble average, and the waiting-time statistic, reads off realizations of \
this single generator:"
}], "Text",
 CellID->257955902,ExpressionUUID->"7a33ac2f-4fb5-380e-2bc0-45896a418b54"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"countingRun", "[", 
    RowBox[{"seed_", ",", " ", "steps_"}], "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"noClick", " ", "=", " ", 
         RowBox[{"MatrixExp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", 
           RowBox[{"(", 
            RowBox[{"Hdrive", " ", "-", " ", 
             RowBox[{
              RowBox[{"I", "/", "2"}], " ", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "cAtom", "]"}], " ", ".", 
               " ", "cAtom"}]}]}], ")"}], " ", "dtAtom"}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", " ", "=", " ", 
           RowBox[{"Reap", "@", 
            RowBox[{"FoldList", "[", "\n", "         ", 
             RowBox[{
              RowBox[{"Function", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"psi", ",", " ", "n"}], "}"}], ",", "\n", 
                "          ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"RandomReal", "[", "]"}], " ", "<", " ", 
                   RowBox[{"dtAtom", " ", 
                    RowBox[{"Re", "[", 
                    RowBox[{
                    RowBox[{"Conjugate", "[", 
                    RowBox[{"cAtom", " ", ".", " ", "psi"}], "]"}], " ", ".", 
                    " ", 
                    RowBox[{"(", 
                    RowBox[{"cAtom", " ", ".", " ", "psi"}], ")"}]}], 
                    "]"}]}]}], ",", "\n", "            ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Sow", "[", 
                    RowBox[{"n", " ", "dtAtom"}], "]"}], ";", " ", 
                    RowBox[{"Normalize", "[", 
                    RowBox[{"cAtom", " ", ".", " ", "psi"}], "]"}]}], ")"}], ",",
                   "\n", "            ", 
                  RowBox[{"Normalize", "[", 
                   RowBox[{"noClick", " ", ".", " ", "psi"}], "]"}]}], 
                 "]"}]}], "]"}], ",", "\n", "         ", "excited", ",", " ", 
              
              RowBox[{"Range", "[", "steps", "]"}]}], "]"}]}]}], "}"}], ",", 
         "\n", "     ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<states\>\"", " ", "->", " ", 
            RowBox[{"First", "[", "r", "]"}]}], ",", " ", 
           RowBox[{"\"\<clicks\>\"", " ", "->", " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Last", "[", "r", "]"}], "]"}]}]}], "|>"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[137]:= ",
 CellID->1595709984,ExpressionUUID->"3b56b9eb-04f6-5b17-696d-30b5ac83267d"],

Cell["The same population, read from a state vector:", "Text",
 CellID->1806165637,ExpressionUUID->"6e9dc2e4-4753-bfbd-16a2-dbce72e70587"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"excitedPopK", "[", "psi_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{"Re", "[", 
       RowBox[{
        RowBox[{"Conjugate", "[", "psi", "]"}], " ", ".", " ", "Z", " ", ".", 
        " ", "psi"}], "]"}]}], ")"}], "/", "2"}]}], ";"}]], "Input",
 CellLabel->"In[138]:= ",
 CellID->1730622717,ExpressionUUID->"7db41629-8d3d-b9f9-2b4b-887324c90bc3"],

Cell["\<\
Record one counted history over the displayed window, and read its two parts, \
the conditioned states and the click times, straight off the one run:\
\>", "Text",
 CellID->694790404,ExpressionUUID->"3f51d24b-32fb-3155-656e-d415468f83bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"oneRun", " ", "=", " ", 
   RowBox[{"countingRun", "[", 
    RowBox[{"3", ",", " ", "600"}], "]"}]}], ";", " ", 
  RowBox[{"oneCount", " ", "=", " ", 
   RowBox[{"oneRun", "[", "\"\<states\>\"", "]"}]}], ";", " ", 
  RowBox[{"oneClicks", " ", "=", " ", 
   RowBox[{"oneRun", "[", "\"\<clicks\>\"", "]"}]}], ";"}]], "Input",
 CellLabel->"In[139]:= ",
 CellID->1833306836,ExpressionUUID->"32e9efb5-7328-71d0-6296-06ff06dd433a"],

Cell["\<\
Now visualize one counted trajectory's excited-state population against the \
master equation: the trajectory drives up and down and plunges at each \
emission, while the average remains smooth:\
\>", "Text",
 CellID->1703418593,ExpressionUUID->"0aa19f46-928a-afd4-3a5e-1720273cf53e"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{"excitedPopK", " ", "/@", " ", "oneCount"}]}], "}"}], "]"}], ",",
      " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", "averageChance"}], "}"}], "]"}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "Red", ",", " ", "Dashed"}], "]"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<one trajectory (jumps)\>\"", ",", 
      " ", "\"\<master equation\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<excited-state population\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<photon counting: one trajectory jumps, the average is \
smooth\>\""}]}], "]"}]], "Input",
 CellLabel->"In[140]:= ",
 CellID->1263998950,ExpressionUUID->"31860dcc-84f8-941b-67bd-a4962d72ff61"],

Cell["\<\
The plunges are the emitted photons, one at a time. No single run is smooth; \
smoothness is in the average.\
\>", "Text",
 CellID->1096868287,ExpressionUUID->"08371d00-4cf7-24ac-39cc-956a64838ef6"],

Cell[TextData[{
 "The plot shows the inferred ",
 StyleBox["state", "TI"],
 "; the same run also carries the ",
 StyleBox["record", "TI"],
 ", the list of click times a photon counter actually writes down, already \
returned as ",
 Cell[BoxData[
  RowBox[{"oneRun", "[", "\"\<clicks\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e555e8f-0ad0-492d-166b-57e9af651877"],
 " and bound to ",
 Cell[BoxData["oneClicks"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348b0551-d20e-4e96-5c88-9d1ae7bb14fc"],
 " above. Every plunge is one entry in it, because the jump that plunges the \
state is the very step that sowed the time. Count the clicks in this record:"
}], "Text",
 CellID->152289512,ExpressionUUID->"5c065349-950a-8738-043e-4b131cbcea02"],

Cell[BoxData[
 RowBox[{"Length", "[", "oneClicks", "]"}]], "Input",
 CellLabel->"In[141]:= ",
 CellID->2048354789,ExpressionUUID->"4ff276a9-5e86-52e3-7582-6ff35b3320c9"],

Cell[TextData[{
 "A handful of photons over the run. Now put the record and the state on one \
time axis with two vertical scales: the conditioned population on the left, \
each click marked by a red line, and the cumulative count ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24b6e2ad-c501-b7fc-4c4d-fbf6ecb51dc6"],
 " on the right, a staircase that rises by one at every click:"
}], "Text",
 CellID->1927064331,ExpressionUUID->"230cad6b-7900-e120-5133-453578bab00a"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{"excitedPopK", " ", "/@", " ", "oneCount"}]}], "}"}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Riffle", "[", 
         RowBox[{"oneClicks", ",", " ", "oneClicks"}], "]"}], ",", " ", 
        RowBox[{"Riffle", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Range", "@", 
            RowBox[{"Length", "@", "oneClicks"}]}], " ", "-", " ", "1"}], ",",
           " ", 
          RowBox[{"Range", "@", 
           RowBox[{"Length", "@", "oneClicks"}]}]}], "]"}]}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"MultiaxisArrangement", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", " ", "Red"}], "}"}], " ", "&"}], " ", "/@", " ", 
       "oneClicks"}], ",", " ", "None"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<excited population\>\"", ",", 
        " ", "\"\<cumulative count N(t)\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", " ", "None"}], "}"}]}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<clicks (red lines) fall at the population plunges; the \
staircase counts them\>\""}]}], "]"}]], "Input",
 CellLabel->"In[142]:= ",
 CellID->177111739,ExpressionUUID->"086f7f71-a7b7-bd3e-3815-773ad2430404"],

Cell["\<\
Every red line sits on a plunge: the click is the emission, and the plunge is \
the state collapsing to the ground state the instant the photon is \
registered. The staircase (right scale) is the raw experimental data; the \
population trajectory (left scale) is what the theorist infers from it.\
\>", "Text",
 CellID->115596948,ExpressionUUID->"0cdf8892-1d3f-31f6-34e4-21dc94cb83dc"],

Cell["\<\
Now run an ensemble of these same trajectories, carried well past the display \
window so each click record is long enough for the timing statistic below; \
our single run above is seed 3 of this same generator, the ensemble's third \
member seen over just the plotted window:\
\>", "Text",
 CellID->1114128274,ExpressionUUID->"7e0217c2-6a7a-d359-2631-8eac0f0ca1a3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nCount", " ", "=", " ", "200"}], ";", " ", 
  RowBox[{"nWaitSteps", " ", "=", " ", "4000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"countRuns", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"countingRun", "[", 
      RowBox[{"#", ",", " ", "nWaitSteps"}], "]"}], " ", "&"}], " ", "/@", 
    " ", 
    RowBox[{"Range", "[", "nCount", "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[143]:= ",
 CellID->1895094918,ExpressionUUID->"4104c6da-03d7-a765-773b-df84b6630a4f"],

Cell["\<\
Averaging the conditioned states across the ensemble must recover the master \
equation. Compare the ensemble-mean excited population, over the displayed \
window, against the integrated reference:\
\>", "Text",
 CellID->532797841,ExpressionUUID->"731f4b84-5335-8b87-2125-62ee66c1d9ed"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"excitedPop", " ", "/@", " ", 
      RowBox[{"Mean", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"densityMatrix", " ", "/@", " ", 
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"countRuns", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<states\>\"", "]"}], ",",
             " ", 
            RowBox[{"Length", "[", "when", "]"}]}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "nCount"}], "}"}]}], "]"}], "]"}]}], ")"}], 
    " ", "-", " ", "averageChance"}], "]"}]}]], "Input",
 CellLabel->"In[144]:= ",
 CellID->827514810,ExpressionUUID->"315717aa-70ab-e706-676c-8ef4015fca6c"],

Cell[TextData[{
 "At fixed ",
 Cell[BoxData["dtAtom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c1b1617-f81f-7a45-2438-8850f9aa48af"],
 ", the sampling component of the gap shrinks as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70b05f1a-470c-9c9d-2040-574472bee6e7"],
 "; the residual time-step bias requires refinement of ",
 Cell[BoxData["dtAtom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a8c5b06-7c6a-07f5-7ab4-5360751f6ddf"],
 ". Together those limits recover the master equation."
}], "Text",
 CellID->1310126569,ExpressionUUID->"4fa3f928-0446-c8dd-7550-f172adf09a27"],

Cell[TextData[{
 "The click record carries a statistic no smooth curve can: the distribution \
of ",
 StyleBox["waiting times", "TI"],
 " between clicks. A click leaves the atom in ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["g", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3727240c-f62b-7b8f-5edc-be6983de49d5"],
 ", so the time ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50637aef-2122-41f7-0011-73c950d713dd"],
 " to the next click has the density"
}], "Text",
 CellID->1253347759,ExpressionUUID->"63773809-2d44-01f7-110c-b25344f153dd"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        StyleBox["w", "TI"], 
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["\[Tau]", "TI"], 
        StyleBox[")",
         SpanMaxSize->1], "=", 
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        RowBox[{
         RowBox[{
          StyleBox["\[Psi]", "TI"], 
          StyleBox["(",
           SpanMaxSize->1], 
          StyleBox["\[Tau]", "TI"], 
          StyleBox[")",
           SpanMaxSize->1]}], ",", 
         RowBox[{
          SuperscriptBox[
           OverscriptBox[
            StyleBox["c", "TI"], "^"], "\[Dagger]"], 
          OverscriptBox[
           StyleBox["c", "TI"], "^"], "\[ThinSpace]", 
          StyleBox["\[Psi]", "TI"], 
          StyleBox["(",
           SpanMaxSize->1], 
          StyleBox["\[Tau]", "TI"], 
          StyleBox[")",
           SpanMaxSize->1]}]}], 
        StyleBox["\[RightAngleBracket]",
         SpanMaxSize->1]}], ",", 
       "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         StyleBox["\[Psi]", "TI"], 
         StyleBox["(",
          SpanMaxSize->1], 
         StyleBox["\[Tau]", "TI"], 
         StyleBox[")",
          SpanMaxSize->1]}]}]}], "\[RightAngleBracket]"}], "=", 
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"-", 
        StyleBox["i", "TI"], 
        SubscriptBox[
         OverscriptBox[
          StyleBox["H", "TI"], "^"], 
         StyleBox["eff",
          FontSlant->"Plain"]], 
        StyleBox["\[Tau]", "TI"]}]], 
      RowBox[{"\[LeftBracketingBar]", 
       StyleBox["g", "TI"]}]}]}], "\[RightAngleBracket]"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["H", "TI"], "^"], 
     StyleBox["eff",
      FontSlant->"Plain"]], "=", 
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], "-", 
     RowBox[{
      FractionBox[
       StyleBox["i", "TI"], "2"], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["c", "TI"], "^"], "\[Dagger]"], 
      OverscriptBox[
       StyleBox["c", "TI"], "^"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1721654809,ExpressionUUID->"7ede8b7e-b317-5b7c-26e5-233bc6a22646"],

Cell[TextData[{
 "the unnormalized no-click state evolved from the ground state. Since it \
starts in ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["g", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75c8f24b-f46e-7672-23f7-f414fd1b5d58"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Gamma]", "TI"], 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        StyleBox["e", "TI"], ",", 
        StyleBox["g", "TI"], 
        StyleBox["\[RightAngleBracket]",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", "0"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d149507-d3df-875e-5b2b-0d60e66beda4"],
 ": the atom cannot emit twice at once, it must be re-driven to the excited \
state first, so very short gaps are forbidden. This is antibunching. Read the \
density directly off the no-click evolution:"
}], "Text",
 CellID->1835967532,ExpressionUUID->"772d62ae-4bf9-dab0-1ed3-7b086d8da89a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"waitDensity", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"psi", " ", "=", " ", 
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{"Hdrive", " ", "-", " ", 
            RowBox[{
             RowBox[{"I", "/", "2"}], " ", 
             RowBox[{
              RowBox[{"ConjugateTranspose", "[", "cAtom", "]"}], " ", ".", 
              " ", "cAtom"}]}]}], ")"}], " ", "t"}], "]"}], " ", ".", " ", 
        "ground"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Re", "[", 
      RowBox[{
       RowBox[{"Conjugate", "[", "psi", "]"}], " ", ".", " ", 
       RowBox[{"ConjugateTranspose", "[", "cAtom", "]"}], " ", ".", " ", 
       "cAtom", " ", ".", " ", "psi"}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[145]:= ",
 CellID->965277466,ExpressionUUID->"7a8c9a4d-0caa-515e-2ab3-1c17a55f23a4"],

Cell[TextData[{
 "No separate simulation is needed. Because every click resets the atom \
exactly to ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["g", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a4c6a75-6554-e0e6-1a73-8c3f0ce6b2cc"],
 ", the gap between two consecutive clicks in any trajectory is already a \
draw from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29c3108e-8c9d-f317-5ff0-89e82529de7d"],
 ": it begins where ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b90d741-2df1-4c37-09af-cf2b4b84171d"],
 " begins. Pool those gaps straight from the ensemble's click records, one \
set of differences per run (the leading interval, which starts from the \
excited state rather than from ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["g", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a353f88-1ea4-a3d5-0bca-b6d29b56f13f"],
 ", drops out on its own, since a difference needs two clicks):"
}], "Text",
 CellID->1405388586,ExpressionUUID->"3c3a5085-d835-7232-65da-49eed9c04118"],

Cell[BoxData[
 RowBox[{
  RowBox[{"waitTimes", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Differences", "[", 
       RowBox[{"#", "[", "\"\<clicks\>\"", "]"}], "]"}], " ", "&"}], " ", "/@",
      " ", "countRuns"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[146]:= ",
 CellID->1630589325,ExpressionUUID->"2f71b61d-3801-a1b0-550e-2847b9b5f39a"],

Cell["Overlay their histogram on the closed form:", "Text",
 CellID->446366569,ExpressionUUID->"3c7c9f19-7bfc-9bea-6403-17437d8ee930"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Histogram", "[", 
    RowBox[{"waitTimes", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "6", ",", " ", "0.2"}], "}"}], ",", 
     " ", "\"\<PDF\>\"", ",", " ", 
     RowBox[{"ChartStyle", " ", "->", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"waitDensity", "[", "t", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "6"}], "}"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "Red"}], "]"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<waiting time between clicks\>\"", ",", 
      " ", "\"\<density\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the trajectory's own inter-click gaps land on the closed-form \
density\>\""}]}], "]"}]], "Input",
 CellLabel->"In[147]:= ",
 CellID->1994518302,ExpressionUUID->"4bcd3c0f-0044-41be-79f2-b669b1f11384"],

Cell["\<\
The bars land on the closed-form density: it vanishes at zero (no two clicks \
at once), rises to a first hump near half a Rabi period, then oscillates and \
decays, the re-driven atom's Rabi cycle written into the timing of the \
clicks. This antibunching is the hallmark of single-photon (nonclassical) \
light, and it lives entirely in the click timing, invisible in the smooth \
population.\
\>", "Text",
 CellID->1562654637,ExpressionUUID->"250574e2-7568-dee6-533b-6dcc7c02a4cc"],

Cell["Homodyne: Reading One Quadrature", "Subsection",
 CellID->1372112522,ExpressionUUID->"570dea5b-028b-2dc3-7d32-0c05b73e7729"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Mixing the output with a strong reference beam before detecting it \
(homodyne) turns the clicks into a continuous noisy current and gives a ",
 StyleBox["diffusive", "TI"],
 " stochastic master equation"
}], "Text",
 CellID->638348404,ExpressionUUID->"559114f0-95cd-3728-03ae-8dba1c799a72"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->907289993,ExpressionUUID->"499d2cc9-9173-f7c8-7fa2-c5932007dd12"],

Cell[TextData[{
 "with a real Wiener increment ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3687b6-15a3-de20-4acd-1ef09c57a50a"],
 " (",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["W", "TI"], "2"], "=", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "073f26db-34e5-c8c2-2ec4-bf85bc919a28"],
 "). The conditioned state now diffuses continuously instead of jumping: \
starting pure in the ideal example here it stays pure, and a mixed initial \
state would purify. The point of this section is the bookkeeping: what a \
single run gives us, which quantities are ",
 StyleBox["observed", "TI"],
 " and which are ",
 StyleBox["inferred", "TI"],
 ", and how every homodyne object is one of those two or is built from them."
}], "Text",
 CellID->1480220716,ExpressionUUID->"27056d96-6b3e-545a-4d3a-84d00ecb3ea0"],

Cell[TextData[{
 "The second way, ",
 StyleBox["homodyne",
  FontWeight->"Bold"],
 " detection: mix the output with a strong reference beam and measure one \
quadrature as a continuous noisy current. Run one homodyne trajectory of the \
same atom:"
}], "Text",
 CellID->1004075994,ExpressionUUID->"031df9cf-6b45-d275-3122-f0a90ef1a15f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"smoothHistory", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "Hdrive", ",", 
     " ", 
     RowBox[{"{", "cAtom", "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "dtAtom", ",", " ", "6.0", ",", " ", "3"}],
     "]"}]}], ";"}]], "Input",
 CellLabel->"In[148]:= ",
 CellID->592936352,ExpressionUUID->"79902eb9-9fc4-d4aa-2faf-c7e31a76bef0"],

Cell[TextData[{
 Cell[BoxData["trajectory"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e90dac8-e749-9c1a-16af-d39592fde760"],
 " hands back exactly two things, and everything else on this page is one of \
them or is computed from them. The ",
 StyleBox["conditional state",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["c", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f026f1c-d8c2-1814-5531-8759d9776b7e"],
 " at each time node (",
 Cell[BoxData[
  RowBox[{"smoothHistory", "[", "\"\<states\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c65fa9b-46f3-ebf0-041a-f3c57287b9da"],
 ") is the observer's running estimate of the atom given the record so far. \
The ",
 StyleBox["record increment",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583cd303-9cb1-03ae-09c3-cb6d154451f4"],
 " at each step (",
 Cell[BoxData[
  RowBox[{"smoothHistory", "[", "\"\<record\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18f1bad1-a8d9-f26a-488e-339ac96dc0b0"],
 ") is the raw output of the detector. The model tying them is"
}], "Text",
 CellID->792862978,ExpressionUUID->"6cd8e50a-7117-62ea-14e7-fd5400a23030"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["J", "TI"], "=", 
    SqrtBox[
     StyleBox["\[Gamma]", "TI"]], "\[ThinSpace]", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["x", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->573477382,ExpressionUUID->"7b9c4f1f-9707-8ca1-29a4-675922b3d68b"],

Cell[TextData[{
 "the signal read from ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0839f778-d15e-09ff-39c6-ef25e0eb5bc5"],
 ", the noise ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7962e333-0c57-77b8-2f11-fb7da5e25d82"],
 " a Wiener increment. Hold the two apart: ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e58b71a-bb3b-e382-3667-2f443ecfb1e8"],
 " is ",
 StyleBox["observed",
  FontWeight->"Bold"],
 ", and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7517e465-645e-477c-232c-fe4f0deb2a46"],
 " is ",
 StyleBox["inferred",
  FontWeight->"Bold"],
 ", reconstructed from ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "560e68d9-da1a-2272-7e35-8182dfaf7158"],
 " by the filter (the positivity step from the toolkit)."
}], "Text",
 CellID->2124988169,ExpressionUUID->"46aa8ea3-37c3-4040-6ea9-270d427612aa"],

Cell["\<\
Take the conditional state first. Its excited population is one smooth \
diffusing history, no jumps:\
\>", "Text",
 CellID->534961831,ExpressionUUID->"6acb7fb5-f6da-6094-1ac9-76fe836f32fe"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{"excitedPop", " ", "/@", " ", 
         RowBox[{"smoothHistory", "[", "\"\<states\>\"", "]"}]}]}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", "averageChance"}], "}"}], "]"}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "Red", ",", " ", "Dashed"}], "]"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<one conditional history\>\"", ",", 
      " ", "\"\<master equation\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<excited-state population\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the conditional state diffuses smoothly, no jumps\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[149]:= ",
 CellID->998016997,ExpressionUUID->"7a5ec95d-e220-f105-2a65-e10697dac06f"],

Cell["\<\
Smooth diffusion, not the plunges of a counted trajectory, yet averaging many \
conditional states recovers the same master equation:\
\>", "Text",
 CellID->1107607024,ExpressionUUID->"05590d03-2064-1772-3366-a56d51117a58"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"excitedPop", " ", "/@", " ", 
      RowBox[{"Mean", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"trajectory", "[", 
           RowBox[{
            RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", 
            "Hdrive", ",", " ", 
            RowBox[{"{", "cAtom", "}"}], ",", " ", 
            RowBox[{"{", "1.", "}"}], ",", " ", 
            RowBox[{"{", "}"}], ",", " ", "dtAtom", ",", " ", "6.0", ",", " ",
             "k"}], "]"}], "[", "\"\<states\>\"", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "150"}], "}"}]}], "]"}], "]"}]}], ")"}], " ",
     "-", " ", "averageChance"}], "]"}]}]], "Input",
 CellLabel->"In[150]:= ",
 CellID->1668318198,ExpressionUUID->"3b9b9f37-eb8f-88a6-69b8-17708e3bda8c"],

Cell["\<\
The gap combines Monte-Carlo scatter with the finite-step bias quantified in \
the toolkit. In the joint limits of large ensemble and small time step, the \
record-conditioned states average to the unconditioned master equation.\
\>", "Text",
 CellID->1044073123,ExpressionUUID->"7ef0eca9-2ea7-fc5e-268f-05f34b53c6a4"],

Cell["\<\
Now the record itself, and the four quantities read from it, each labeled by \
how it is obtained and whether it is observed or inferred.\
\>", "Text",
 CellID->1281286378,ExpressionUUID->"53b0040e-15e9-970f-014f-9e68a39dfa55"],

Cell[TextData[{
 StyleBox["The record increment ",
  FontWeight->"Bold"],
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"49c5479d-c9fe-ab26-7ffb-5ec6ef88f60c"],
 " (observed). ",
 StyleBox["How obtained:", "TI"],
 " the detector's output each step, here generated together with the state. \
",
 StyleBox["Status:", "TI"],
 " observed, the one thing that enters from the world; everything else is \
downstream of it. Plot it:"
}], "Text",
 CellID->2002157654,ExpressionUUID->"73b5640c-4acf-57ea-214b-7e566f7a3d30"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dJ", " ", "=", " ", 
   RowBox[{"Flatten", "@", 
    RowBox[{"smoothHistory", "[", "\"\<record\>\"", "]"}]}]}], ";"}]], "Input",\

 CellLabel->"In[151]:= ",
 CellID->822148062,ExpressionUUID->"12e31b8a-6cd9-3185-4290-92d4056d83ef"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Most", "@", "when"}], ",", " ", "dJ"}], "}"}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<record increment  dJ\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<dJ, the observed record: almost pure noise per step\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[152]:= ",
 CellID->837975234,ExpressionUUID->"1c8dfb5f-95aa-8549-44b2-f3191c5cef93"],

Cell[TextData[{
 "It looks like noise because it is almost all noise: per step the signal ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "\[TildeTilde]", "0.005"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77ba1ed5-dc9c-5ed1-1d59-979ed529243b"],
 " sits under a ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "122b6086-f39f-774a-4229-79e3862a5d90"],
 " of size ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox[
     RowBox[{"d", "t"}], "TI"]], "=", "0.1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "562fd52b-4ccb-95a8-7fd4-cd75657ffff2"],
 ", twenty times larger. A single increment carries almost no information \
about the atom."
}], "Text",
 CellID->2104272152,ExpressionUUID->"6a176158-c8f1-b5ca-1a2d-7905e8851f10"],

Cell[TextData[{
 StyleBox["The integrated record ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubsuperscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"]], 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"59294b9d-2c6b-0af3-08d7-62c7451e58d9"],
 " (observed). ",
 StyleBox["How obtained:", "TI"],
 " sum the observed increments. ",
 StyleBox["Status:", "TI"],
 " observed, the same data accumulated. Plot it against its drift, the \
inferred signal integrated:"
}], "Text",
 CellID->39229099,ExpressionUUID->"4c93342e-976f-2690-74a0-ad88221b8cfa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"signal", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "\[Gamma]atom", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"blochVector", "[", "#", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"Most", "[", 
       RowBox[{"smoothHistory", "[", "\"\<states\>\"", "]"}], "]"}]}], 
     ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Jt", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", "dJ", "]"}], ",", " ", "0."}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"driftJ", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", 
      RowBox[{"signal", " ", "dtAtom"}], "]"}], ",", " ", "0."}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[153]:= ",
 CellID->538455469,ExpressionUUID->"0c05a0c6-8ada-cee6-343a-39a02f6c94cc"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", "Jt"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", "driftJ"}], "}"}], "]"}]}], "}"}], ",", "\n",
    " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<integrated record  J(t)\>\"", ",", 
      " ", "\"\<inferred drift  \[Integral]signal dt\>\""}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<integrated record  J(t)\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the observed record integrates to a drifting path; its drift is \
the signal\>\""}]}], "]"}]], "Input",
 CellLabel->"In[154]:= ",
 CellID->266517012,ExpressionUUID->"386c40c3-2c7c-2bd7-6814-59ad4509793d"],

Cell[TextData[{
 "Integrating is itself a filter: the signal accumulates coherently into a \
drift while the noise only grows as ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38a5d185-6c33-4099-685a-c8ef05c612e3"],
 ", so in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705b2160-d6f6-9bc7-2078-b94de280e92d"],
 " the signal is comparable to the noise instead of twenty times below it. \
This is the honest, window-free picture of the data. (The ",
 Cell[BoxData["signal"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ad5a48d-d13d-ee7b-6aea-3dd6e0c9b541"],
 " used for the drift is inferred, and gets its own panel below.)"
}], "Text",
 CellID->1190814367,ExpressionUUID->"3e286ad4-f19d-13f8-67d7-8391802861c2"],

Cell[TextData[{
 StyleBox["The current ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"40ae3c14-0aab-252d-7055-b65eaf5f8c77"],
 " (observed, singular). ",
 StyleBox["How obtained:", "TI"],
 " divide the observed increment by ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3710829e-7f3a-eae8-5d2f-1bd87accb832"],
 ". ",
 StyleBox["Status:", "TI"],
 " observed but not a proper quantity: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "=", 
   StyleBox["signal",
    FontSlant->"Plain"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "514f46f4-7214-5441-0775-5fbe07a13eab"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a8341fe-fd5d-b2cd-0ab1-58bbf4e90017"],
 " is white noise of variance ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cf942e0-12f7-a17b-7487-5bcaa683f041"],
 ", which diverges as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4db09b50-0334-b760-7b4f-131ab6c61a4a"],
 ". On the grid it is a ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1", "/", 
   SqrtBox[
    StyleBox[
     RowBox[{"d", "t"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cb56032-9c81-172f-244b-7a7c15347a75"],
 " band around a ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f15dca-bfed-9606-038f-54943999fd6c"],
 " signal:"
}], "Text",
 CellID->1899183568,ExpressionUUID->"5589ad74-704a-26e9-03b6-453e01fc8c33"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Most", "@", "when"}], ",", " ", 
      RowBox[{"dJ", "/", "dtAtom"}]}], "}"}], "]"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<current  dJ/dt\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the current dJ/dt: a white-noise band with no dt\[Rule]0 \
limit\>\""}]}], "]"}]], "Input",
 CellLabel->"In[155]:= ",
 CellID->839992789,ExpressionUUID->"37fda5d4-10fa-7e26-5d82-3c9ea08f450c"],

Cell[TextData[{
 "There is no current ",
 StyleBox["curve", "TI"],
 ". The instantaneous homodyne current is a distribution, not a function, \
which is why any smooth current needs an arbitrary averaging window and why \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cc64ef1-7b65-373d-14fe-67bb7e119a07"],
 " above is the cleaner observed object."
}], "Text",
 CellID->1909137676,ExpressionUUID->"542582fc-1c6f-cfd5-7dda-1ba6951b953f"],

Cell[TextData[{
 StyleBox["The signal ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"7ad84463-32de-d6a2-2af8-5e4d4768bc88"],
 " (inferred). ",
 StyleBox["How obtained:", "TI"],
 " read off the conditional state. ",
 StyleBox["Status:", "TI"],
 " inferred, the conditional mean of the current, never measured directly. \
This is the clean thing buried in the record:"
}], "Text",
 CellID->2000873505,ExpressionUUID->"3261459d-f728-27c9-621f-5cc682c28d13"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Most", "@", "when"}], ",", " ", "signal"}], "}"}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<signal  Sqrt[gamma] <sigma_x>\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the signal, inferred from the conditional state, not measured\>\
\""}]}], "]"}]], "Input",
 CellLabel->"In[156]:= ",
 CellID->1091748765,ExpressionUUID->"331c7f17-1677-2611-6124-7751a3038d7b"],

Cell[TextData[{
 "No detector emits this curve. It is what the filter reconstructs, smooth \
because the conditional state is smooth, and it is the conditional drift \
about which the observed ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14cbe893-f079-1a7f-3cc8-01dc810c6945"],
 " fluctuates."
}], "Text",
 CellID->232863170,ExpressionUUID->"3a1d5a8b-943b-deab-6a23-53d51dcfa4f1"],

Cell[TextData[{
 StyleBox["The innovation ",
  FontWeight->"Bold"],
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"355f53e5-dafb-cebc-6365-4acede8f9486"],
 " (inferred). ",
 StyleBox["How obtained:", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"], "=", 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "-", 
   StyleBox["signal",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "492c649c-8337-646c-78d4-7dc636c24eb6"],
 ", the observed increment minus the inferred prediction. ",
 StyleBox["Status:", "TI"],
 " inferred, a residual, not a second measurement:"
}], "Text",
 CellID->1876092091,ExpressionUUID->"1678747f-7a6a-a1d6-3e18-6e397f1cf33c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dW", " ", "=", " ", 
   RowBox[{"dJ", " ", "-", " ", 
    RowBox[{"signal", " ", "dtAtom"}]}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Most", "@", "when"}], ",", " ", "dW"}], "}"}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<innovation  dW\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the innovation dW = dJ - signal dt: the residual\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[157]:= ",
 CellID->652142632,ExpressionUUID->"5c54ceec-a669-4ede-046b-e7c9d31c1424"],

Cell[TextData[{
 "If the filter is optimal, the residual is zero-mean white noise. Check its \
autocorrelation, with the ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "2", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "336f4c4f-cb14-5955-6115-6628eea12bbf"],
 " band white noise would sit inside:"
}], "Text",
 CellID->330963574,ExpressionUUID->"192b8c2c-1b0f-3631-4f28-26769ebb9d1b"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"innov", " ", "=", " ", 
      RowBox[{"dW", "/", 
       RowBox[{"Sqrt", "[", "dtAtom", "]"}]}]}], ",", " ", 
     RowBox[{"ci", " ", "=", " ", 
      RowBox[{"2", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Length", "[", "dW", "]"}], "]"}]}]}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"CorrelationFunction", "[", 
      RowBox[{"innov", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "10"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Filling", " ", "->", " ", "Axis"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.2"}], ",", " ", "0.2"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ci", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "ci"}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}]}], "}"}]}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<lag\>\"", ",", 
        " ", "\"\<innovation autocorrelation\>\""}], "}"}]}], ",", " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<the innovation is white within confidence limits\>\""}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[158]:= ",
 CellID->1389046362,ExpressionUUID->"2580083d-358c-3435-53bf-a267bc3e9f1f"],

Cell["\<\
Every nonzero lag sits in the band: the filter has extracted every \
predictable part of the record, and what remains is irreducible measurement \
noise. This whiteness is the diffusive counterpart of the counting record's \
antibunched clicks, and the same optimal-filter signature the Kalman tracker \
will show.\
\>", "Text",
 CellID->1332526183,ExpressionUUID->"477fde83-a5ae-c17e-6d04-d7eccc589044"],

Cell[TextData[{
 "So the section is one ledger. A single observed record ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0782fdeb-454d-5eca-2db1-f4b56cf82410"],
 " (equivalently its integral ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69a01936-08b2-60cf-1f5f-9170a9473215"],
 ") enters from the world; from it the conditional state, the signal, and the \
innovation ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "553ebd3d-d82b-159a-7cc5-3566d9de7fe0"],
 " are all computed. Only ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c0b44c7-b7b3-5c45-1409-5da0c24626af"],
 " is data. Everything that looks like the atom, the smooth population, the \
signal curve, is inferred from it."
}], "Text",
 CellID->197217751,ExpressionUUID->"4dba914e-52ed-e087-7b59-09286699b2ed"],

Cell["Heterodyne: Reading Both Quadratures", "Subsection",
 CellID->880034747,ExpressionUUID->"497e5609-e734-e246-7f06-485292c6b0ac"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Reading ",
 StyleBox["both", "TI"],
 " shadows at once (heterodyne) splits the one monitored leak into two \
half-strength homodyne channels a quarter-turn apart, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["I", "TI"]], "=", 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08c79fc2-e932-c645-38fc-16af88c4acaf"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["Q", "TI"]], "=", 
   StyleBox["i", "TI"], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2184153d-b162-7859-57bb-8d66c0174aa3"],
 ", each read as its own real current:"
}], "Text",
 CellID->1800574979,ExpressionUUID->"2402dcb3-2cfa-7570-4c31-d5fd448f5c5a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     StyleBox["I", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["I", "TI"]], "+", "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     StyleBox["Q", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["Q", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     SubsuperscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["I", "TI"], "2"]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["d", "TI"], 
      SubsuperscriptBox[
       StyleBox["W", "TI"], 
       StyleBox["Q", "TI"], "2"]}], "=", 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["I", "TI"]], "\[ThinSpace]", 
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["Q", "TI"]]}], "=", 
    RowBox[{"0", "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1078219960,ExpressionUUID->"554ef748-00c8-cf17-0375-ef12b162927d"],

Cell[TextData[{
 "It is one point in a whole ",
 StyleBox["general-dyne", "TI"],
 " family running from one sharp shadow (homodyne) to two blurry ones, every \
member averaging to the identical master equation while giving genuinely \
different single histories. Show that the two channels reproduce the one \
leak, then watch."
}], "Text",
 CellID->2033801793,ExpressionUUID->"40bb2fe5-4c06-79cb-7058-c6cf65b34b11"],

Cell[TextData[{
 "The third way, ",
 StyleBox["heterodyne",
  FontWeight->"Bold"],
 ": measure both quadratures at once. It is equivalent to two half-strength \
homodyne channels a quarter-turn apart, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ee2421b-c68a-4a96-2692-6444f33f18fc"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79971006-243c-6fe2-2fac-8a604dc935c8"],
 ". First prove those two dissipators sum to the original, for any ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["c", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61109047-93e0-1377-172f-0a2125957e5d"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c784b-10c0-0bab-5c24-7215a17559f1"],
 ":"
}], "Text",
 CellID->1670899349,ExpressionUUID->"4125a490-d89a-105a-70da-3dddd92f62a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\[FormalC]", ",", " ", "##"}], "]"}], " ", "&"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], ",", "\n", "   ", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\[FormalR]", ",", " ", "##"}], "]"}], " ", "&"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
    "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"dissipator", "[", 
       RowBox[{
        RowBox[{"c", "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", "r"}], "]"}], " ", "+", 
      " ", 
      RowBox[{"dissipator", "[", 
       RowBox[{
        RowBox[{"I", " ", 
         RowBox[{"c", "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}]}], ",", " ", "r"}], "]"}]}], " ", 
     "==", "\n", "   ", 
     RowBox[{"dissipator", "[", 
      RowBox[{"c", ",", " ", "r"}], "]"}]}]}], "]"}], " ", "//", " ", 
  "FullSimplify"}]], "Input",
 CellLabel->"In[159]:= ",
 CellID->975439503,ExpressionUUID->"0b67f461-4283-7871-391c-ee4b77364b5b"],

Cell["\<\
It returns True, with no assumptions: the two channels reproduce the same \
dissipator, so the master equation is unchanged, and as in the counting and \
homodyne runs an ensemble of these trajectories averages back to it.\
\>", "Text",
 CellID->351741581,ExpressionUUID->"79999c45-ea42-0b46-2fa6-162e8ff759ac"],

Cell[TextData[{
 "The trajectory explores differently, so hold apart what heterodyne ",
 StyleBox["observes", "TI"],
 " from what it ",
 StyleBox["infers", "TI"],
 ", exactly as with homodyne. ",
 Cell[BoxData["trajectory"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fae9c0a-8a55-fd6e-0555-16542fe1c7b4"],
 " still returns two objects, the conditional state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ae1fb24-4e58-6c4d-4a9e-f28e6bed3697"],
 " (inferred) and the record (observed), but the record now has ",
 StyleBox["two", "TI"],
 " columns, one real current per quadrature:"
}], "Text",
 CellID->984679481,ExpressionUUID->"0a4afb14-05e6-4298-3a49-f35eb39310e2"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["I", "TI"]], "=", 
    SqrtBox[
     RowBox[{
      StyleBox["\[Gamma]", "TI"], "/", "2"}]], "\[ThinSpace]", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["x", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["I", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["J", "TI"], 
      StyleBox["Q", "TI"]]}], "=", 
    RowBox[{
     RowBox[{
      SqrtBox[
       RowBox[{
        StyleBox["\[Gamma]", "TI"], "/", "2"}]], "\[ThinSpace]", 
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], 
        StyleBox["y", "TI"]], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{
      StyleBox["d", "TI"], 
      RowBox[{
       SubscriptBox[
        StyleBox["W", "TI"], 
        StyleBox["Q", "TI"]], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->412548195,ExpressionUUID->"1a681de3-120d-8f0a-4a17-94cda7b9d250"],

Cell[TextData[{
 "Equivalently the two real records are the real and imaginary parts of a \
single ",
 StyleBox["complex", "TI"],
 " record ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "=", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["I", "TI"]], "+", 
   StyleBox["i", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["Q", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fe8910c-2477-6bad-2597-09564d0239f7"],
 ", whose increment satisfies ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["J", "TI"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4724aa69-80a2-605c-6edb-4c33315732a6"],
 " (the two shot noises are independent) and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["J", "TI"], "*"], "=", "2", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7db6e0a3-5ee4-0113-2b4d-f90d5a915079"],
 " (each quadrature contributes its own variance ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64959d98-6722-362c-0caa-14c212d49d76"],
 "): two independent real noises carried in one complex number. The single \
new fact over homodyne is that both field quadratures are recorded at once, \
so the two records carry the two transverse signals ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f8c04ec-8c47-4bdf-05b3-9db625f21925"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023e8ab0-46e5-584b-33c5-23fa72902a91"],
 " directly, each at half the power an optimally phased homodyne puts in its \
one. Run one history and keep its record:"
}], "Text",
 CellID->167190678,ExpressionUUID->"5a0eac86-50d0-15df-0a35-45e061657f25"],

Cell[BoxData[
 RowBox[{
  RowBox[{"hetOne", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "Hdrive", ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cAtom", "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
       RowBox[{"I", " ", 
        RowBox[{"cAtom", "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1.", ",", " ", "1."}], "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "dtAtom", ",", " ", "6.0", ",", " ", "3"}],
     "]"}]}], ";"}]], "Input",
 CellLabel->"In[160]:= ",
 CellID->132154406,ExpressionUUID->"58394c25-48c8-3ecd-09c7-658f69628417"],

Cell[TextData[{
 StyleBox["The conditional state ",
  FontWeight->"Bold"],
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"1424a2b0-695c-dfcb-3ddb-3bfa08eea511"],
 " (inferred). ",
 StyleBox["How obtained:", "TI"],
 " the filter's running estimate of the atom given the record so far. ",
 StyleBox["Status:", "TI"],
 " inferred. Where homodyne resolved one transverse coordinate, heterodyne \
resolves both; plot the run's ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05101942-3b9c-ad10-332f-912cbe2ef47a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35394d45-77a0-03f4-5cc7-652f025551de"],
 " together:"
}], "Text",
 CellID->1448639745,ExpressionUUID->"3f9454e1-244e-40e6-65ac-4dcb4dfb12cc"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"blochVector", "[", "#", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"hetOne", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}], ",",
      " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"blochVector", "[", "#", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"hetOne", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[LeftAngleBracket]\[Sigma]x\[RightAngleBracket]\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]\[Sigma]y\[RightAngleBracket]\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<conditional transverse Bloch vector\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<one heterodyne run resolves both quadratures\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[161]:= ",
 CellID->1881657070,ExpressionUUID->"530b93a6-4244-79d7-0108-0a0077f14b3d"],

Cell["\<\
Both components diffuse smoothly, no jumps. The conditional state is a full \
Bloch vector under homodyne too, tracked by the filter from its one record; \
what heterodyne adds is a record that measures both transverse signals \
directly, where homodyne's single record measured one and left the other to \
the conditional dynamics.\
\>", "Text",
 CellID->1506900826,ExpressionUUID->"4c785ed8-c9e5-405c-7418-5785ef9012a6"],

Cell[TextData[{
 StyleBox["The record increments ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["I", "TI"]]}], ",", 
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["Q", "TI"]]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"0a66b72e-8103-1d0f-3a1d-2e8830b66455"],
 " (observed). ",
 StyleBox["How obtained:", "TI"],
 " the detector's two outputs each step. ",
 StyleBox["Status:", "TI"],
 " observed, the only data that enters from the world; everything else is \
downstream. Read the two columns:"
}], "Text",
 CellID->637363640,ExpressionUUID->"6206b938-b2f8-72db-123d-3165c68d4021"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dJI", " ", "=", " ", 
   RowBox[{
    RowBox[{"hetOne", "[", "\"\<record\>\"", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dJQ", " ", "=", " ", 
   RowBox[{
    RowBox[{"hetOne", "[", "\"\<record\>\"", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[162]:= ",
 CellID->658697144,ExpressionUUID->"7a01a055-721a-3362-2a3e-3a1f07ac9e48"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Most", "@", "when"}], ",", " ", "dJI"}], "}"}], "]"}], ",", 
     " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Most", "@", "when"}], ",", " ", "dJQ"}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<I record\>\"", ",", " ", "\"\<Q record\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<record increments\>\""}], "}"}]}],
    ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<both quadrature records: almost pure noise per step\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[163]:= ",
 CellID->462592558,ExpressionUUID->"425e231b-d90e-d650-7265-bb44d8b8bcba"],

Cell[TextData[{
 "Each is nearly pure noise, and for a sharper reason than homodyne's: each \
channel carries only ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["\[Gamma]", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f4b19d7-d2e6-1d55-1548-9090e69367bf"],
 " of signal, half the power homodyne put into its one quadrature, against \
the same shot noise."
}], "Text",
 CellID->621689956,ExpressionUUID->"266a3a12-a29b-0b72-4e69-bc5fd72e5658"],

Cell[TextData[{
 StyleBox["The integrated record ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubsuperscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"]], 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"1b97aeb9-f3a3-063a-49ac-47e286566d00"],
 " (observed). ",
 StyleBox["How obtained:", "TI"],
 " accumulate each column. ",
 StyleBox["Status:", "TI"],
 " observed, the same data summed. A complex record integrates to a path in \
the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"I", "Q"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "670ec096-5157-8cf5-0d35-d9d060e3d6df"],
 " plane, an observed walk that drifts along the inferred signal."
}], "Text",
 CellID->912512294,ExpressionUUID->"4a46f8a5-a076-b8c1-7a7d-f10ed1000a2b"],

Cell[TextData[{
 "That signal is the per-channel coupling ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["\[Gamma]", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b9d6462-a0fd-67c7-29a3-7e4fd0884d2d"],
 " times each conditional quadrature, read off ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c567373-a618-e547-046e-6b3cd392cfad"],
 " rather than measured, one channel for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5028993e-6f44-360e-01d7-11780af69d54"],
 " and one for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05297336-3344-a7f5-2cd7-6b7046f60ddf"],
 ":"
}], "Text",
 CellID->159314101,ExpressionUUID->"75fa11b5-921a-0030-2399-88ff27af531a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hetSigI", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Gamma]atom", "/", "2"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"blochVector", "[", "#", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"Most", "[", 
       RowBox[{"hetOne", "[", "\"\<states\>\"", "]"}], "]"}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"hetSigQ", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Gamma]atom", "/", "2"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"blochVector", "[", "#", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"Most", "[", 
       RowBox[{"hetOne", "[", "\"\<states\>\"", "]"}], "]"}]}], ")"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[164]:= ",
 CellID->2072053663,ExpressionUUID->"2d27580a-3980-0923-54dd-5254b8355809"],

Cell["\<\
The observed walk is the running sum of the two record columns, each starting \
from the origin:\
\>", "Text",
 CellID->1700462496,ExpressionUUID->"077289f0-6175-2cad-2d01-20ba100076f7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"JI", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", "dJI", "]"}], ",", " ", "0."}], "]"}]}], ";", 
  " ", 
  RowBox[{"JQ", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", "dJQ", "]"}], ",", " ", "0."}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[165]:= ",
 CellID->758245071,ExpressionUUID->"133b68ba-8b92-4fbc-42d8-81e42e271586"],

Cell["\<\
The drift is that same running sum on the inferred signal, the smooth curve \
the walk fluctuates around:\
\>", "Text",
 CellID->645457834,ExpressionUUID->"6db49e4d-4459-39d0-1b4b-10176ded8b3a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"driftI", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", 
      RowBox[{"hetSigI", " ", "dtAtom"}], "]"}], ",", " ", "0."}], "]"}]}], ";",
   " ", 
  RowBox[{"driftQ", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", 
      RowBox[{"hetSigQ", " ", "dtAtom"}], "]"}], ",", " ", "0."}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[166]:= ",
 CellID->1053805191,ExpressionUUID->"01e45bb6-31a6-d4bb-379c-52f04050be81"],

Cell["Now trace the observed walk against that inferred drift:", "Text",
 CellID->1335228883,ExpressionUUID->"638a875f-059e-01af-1189-1f19ac2b53f5"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"JI", ",", " ", "JQ"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"driftI", ",", " ", "driftQ"}], "}"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<integrated record\>\"", ",", 
      " ", "\"\<inferred drift\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<I\>\"", ",", " ", "\"\<Q\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the observed record is a drifting walk in the IQ plane\>\""}]}],
   "]"}]], "Input",
 CellLabel->"In[167]:= ",
 CellID->17162129,ExpressionUUID->"3b1c9c05-9360-5fc6-6923-166f2615252c"],

Cell[TextData[{
 "The jagged path is the raw data; the smooth curve it drifts along is \
inferred. Integrating both quadratures at once is a 2D filter: each signal \
accumulates coherently into the drift while its noise only spreads as ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d8f8704-dbc1-ad9f-5bb4-1f61de75f7e5"],
 ", so the walk's net displacement carries the record's information where a \
single increment held almost none."
}], "Text",
 CellID->745178489,ExpressionUUID->"7bacb1bf-0091-7884-2953-28f9b1244aee"],

Cell[TextData[{
 StyleBox["The innovations ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["I", "TI"]]}], ",", 
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["Q", "TI"]]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"6e949b39-c960-dcff-16ab-1362e81aa6c5"],
 " (inferred). ",
 StyleBox["How obtained:", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["I", "TI"]], "=", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["I", "TI"]], "-", 
   SubscriptBox[
    StyleBox["signal",
     FontSlant->"Plain"], 
    StyleBox["I", "TI"]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52d3365b-85bc-1911-02e0-a8052c49687b"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["Q", "TI"]], "=", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["Q", "TI"]], "-", 
   SubscriptBox[
    StyleBox["signal",
     FontSlant->"Plain"], 
    StyleBox["Q", "TI"]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "058c1579-2127-d4ed-33b3-8d2350d3be37"],
 ", each observed increment minus its inferred prediction. ",
 StyleBox["Status:", "TI"],
 " inferred residuals. If the filter is optimal each is zero-mean white \
noise, and because ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["J", "TI"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f55ae27-0b76-e8ec-756a-4781ae00ba36"],
 " the two are mutually independent. Check the whiteness of each channel \
first, against the ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "2", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62fbf51e-f93c-ccd0-1298-ed5bf8ce963a"],
 " band:"
}], "Text",
 CellID->64377810,ExpressionUUID->"011d018b-0453-500f-3722-98d5ade62355"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dWI", " ", "=", " ", 
   RowBox[{"dJI", " ", "-", " ", 
    RowBox[{"hetSigI", " ", "dtAtom"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dWQ", " ", "=", " ", 
   RowBox[{"dJQ", " ", "-", " ", 
    RowBox[{"hetSigQ", " ", "dtAtom"}]}]}], ";"}]}], "Input",
 CellLabel->"In[168]:= ",
 CellID->1276099438,ExpressionUUID->"1b868176-6936-78c0-49bd-193008c34a2a"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ci", " ", "=", " ", 
     RowBox[{"2", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Length", "[", "dWI", "]"}], "]"}]}]}], "}"}], ",", "\n", " ", 
   
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"CorrelationFunction", "[", 
        RowBox[{
         RowBox[{"dWI", "/", 
          RowBox[{"Sqrt", "[", "dtAtom", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "10"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"CorrelationFunction", "[", 
        RowBox[{
         RowBox[{"dWQ", "/", 
          RowBox[{"Sqrt", "[", "dtAtom", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "10"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.2"}], ",", " ", "0.2"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<I channel\>\"", ",", " ", "\"\<Q channel\>\""}], "}"}]}], 
     ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ci", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "ci"}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}]}], "}"}]}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<lag\>\"", ",", 
        " ", "\"\<innovation autocorrelation\>\""}], "}"}]}], ",", " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<each innovation channel is white\>\""}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[169]:= ",
 CellID->1651008988,ExpressionUUID->"317554d9-f61a-a01f-670b-4d8283acf365"],

Cell["\<\
Both correlograms hug zero within the band, the signature of white residuals: \
the filter has extracted every predictable part of each record.\
\>", "Text",
 CellID->807143410,ExpressionUUID->"581509a3-40d5-fdc4-082a-a00d7161c72e"],

Cell["\<\
Now the heterodyne-specific check with no homodyne counterpart, whether the \
two residuals are independent of each other. Read off the 2-by-2 correlation \
matrix of the innovation channels:\
\>", "Text",
 CellID->2004841178,ExpressionUUID->"27a46d13-c303-51d0-4d5b-855cf6b6233a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Correlation", "[", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"dWI", ",", " ", "dWQ"}], "}"}], "]"}], "]"}], " ", "//", " ", 
  "MatrixForm"}]], "Input",
 CellLabel->"In[170]:= ",
 CellID->680262370,ExpressionUUID->"17c64253-a2be-52b9-3dfe-641cd74b2083"],

Cell[TextData[{
 "The off-diagonal sits near zero, within the same ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "2", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a34ce21-af18-53d3-0bcb-e78acaad2139"],
 " band: the two residuals are not just each white but mutually independent, \
the simulation realizing the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["I", "TI"]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["Q", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1308debe-b866-1363-4137-d7f839137e49"],
 " half of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["J", "TI"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "339fc10a-19b9-5d82-61a4-d954984c27e8"],
 ". Reading both conjugate quadratures buys two independent white \
innovations, one per shadow."
}], "Text",
 CellID->2074260939,ExpressionUUID->"442b12f5-789a-53e1-6c28-8bbf792f21cb"],

Cell["\<\
Keeping the record splits purity into two quantities that need not agree: the \
purity of each conditioned state, and the purity of the state you get by \
averaging them. Run ninety homodyne histories of the same atom:\
\>", "Text",
 CellID->1484886568,ExpressionUUID->"39387274-e40a-435c-68d8-74318dbf11a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"homRuns", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"trajectory", "[", 
       RowBox[{
        RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "Hdrive", ",",
         " ", 
        RowBox[{"{", "cAtom", "}"}], ",", " ", 
        RowBox[{"{", "1.", "}"}], ",", " ", 
        RowBox[{"{", "}"}], ",", " ", "dtAtom", ",", " ", "6.0", ",", " ", 
        "s"}], "]"}], "[", "\"\<states\>\"", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "90"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[171]:= ",
 CellID->1547996435,ExpressionUUID->"70ecc98e-c53f-f68b-2093-e0ebeccbdcd1"],

Cell["Follow both purities in time:", "Text",
 CellID->1622616291,ExpressionUUID->"53e7ddcf-0b8d-05e4-019c-d4a9ae386fce"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Mean", "[", 
           RowBox[{"purity", " ", "/@", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
          " ", 
         RowBox[{"Transpose", "[", "homRuns", "]"}]}]}], "}"}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"purity", "[", 
           RowBox[{"Mean", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"Transpose", "[", "homRuns", "]"}]}]}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<mean purity of conditioned states\>\"", ",", 
      " ", "\"\<purity of the mean state\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<purity\>\""}], "}"}]}], ",", "\n",
    " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<every run stays pure; only the record-blind average \
mixes\>\""}]}], "]"}]], "Input",
 CellLabel->"In[172]:= ",
 CellID->1371263066,ExpressionUUID->"1a830965-7851-22cf-4ab0-a14f79e47015"],

Cell["\<\
The conditioned purity holds at one for the whole run; the averaged state's \
purity falls and settles at the mixed steady value. Decoherence sits entirely \
in the second curve: it is not an event in any watched atom's history but the \
cost of discarding the record.\
\>", "Text",
 CellID->1067912469,ExpressionUUID->"47763c58-6b8c-f19b-6d0d-b6020e3ec3e1"],

Cell["\<\
Counting, homodyne, heterodyne: three different measurements of one atom, \
three different trajectory ensembles, one shared master equation. The \
measurement you choose sets what you learn moment to moment; the \
unconditioned dynamics is the same. Between homodyne and heterodyne lies the \
continuous general-dyne family, all on this same average.\
\>", "Text",
 CellID->943837838,ExpressionUUID->"2411395d-4500-dc0b-4c2e-b1076cbaa751"],

Cell["Part Five: What Watching Does, and How to Act on It", "Section",
 CellID->1450235700,ExpressionUUID->"51798d79-74e7-e8a1-0706-25237c93ba8b"],

Cell[TextData[{
 "Keeping the record does more than reveal the state: measurement reshapes \
the dynamics, and the record can be fed back to control the system. Five \
examples follow: a watched-frozen qubit, a charge qubit read by a detector, \
measurement-induced collapse, a Kalman filter tracking an oscillator, and \
measurement feedback (all qubits except the oscillator). First a helper to \
read the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e7478e0-34bc-b2ae-360c-71cabd4e00f4"],
 " and ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa139-5ae3-ed74-4004-39635e97b45e"],
 " components:"
}], "Text",
 CellID->257312343,ExpressionUUID->"0084d900-0120-94d6-30bb-d16ab0dafe3c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"zOf", "[", "states_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"blochVector", "[", "#", "]"}], "[", 
      RowBox[{"[", "3", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "states"}]}], ";", " ", 
  RowBox[{
   RowBox[{"xOf", "[", "states_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"blochVector", "[", "#", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "states"}]}], ";"}]], "Input",
 CellLabel->"In[173]:= ",
 CellID->1811882128,ExpressionUUID->"45e3bdb3-b7b8-8152-7390-34fcc232d3b8"],

Cell["Watching Harder Freezes It", "Subsection",
 CellID->33577298,ExpressionUUID->"5e5e1e6c-8075-0eb3-0665-903631005499"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A driven qubit continuously measured along ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b122816-0897-a47c-6921-c250a9230f46"],
 ", the quantum Zeno setup. The conditioned state obeys the stochastic master \
equation"
}], "Text",
 CellID->240192060,ExpressionUUID->"12228eb7-81d1-9f6b-43d1-27f13065e5b1"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    FractionBox["\[CapitalOmega]", "2"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["x", "TI"]], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "-", 
    FractionBox[
     StyleBox["k", "TI"], "2"], "\[ThinSpace]", "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[Rho]", "TI"], "+", 
     StyleBox["\[Rho]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], "-", "2", 
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1178070921,ExpressionUUID->"0c4e3d89-d3d8-0dbe-3475-b4d2e66d5784"],

Cell[TextData[{
 "with drive ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44dcab5a-698d-607d-6ce3-430408383347"],
 " and measurement strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "268a9802-0d7f-2bfd-4e89-126ca40a79c7"],
 ". When ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "<", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79bc5755-bb31-5780-2f44-4f1f3ec43dea"],
 " the qubit swings almost freely; when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], ">", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ff00406-ec89-251c-358f-9e63853d8c66"],
 " the watching pins it near a pole and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6791a5-5599-4f2a-2b1c-080f5c2c1270"],
 " becomes a random telegraph, the \"watched pot\" that never boils. Watch a \
gently-watched and a hard-watched history."
}], "Text",
 CellID->1900683911,ExpressionUUID->"7c7441be-5925-9c2b-240c-58f858d1e771"],

Cell[TextData[{
 "A driven qubit measured along ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ff4eb8a-8686-c1c6-058b-02d43330932c"],
 ". Measure weakly (",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "<", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "049abcb6-c083-4b47-2cb9-35f3f13619ad"],
 ") and it swings almost freely; measure strongly (",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], ">", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00908b6d-9173-71f0-30af-2337200643da"],
 ") and it is pinned near a ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c438d61-2567-fb5f-3470-254b4c13c9a5"],
 " eigenstate with occasional jumps, the quantum Zeno effect. Set the drive \
and the fine time grid:"
}], "Text",
 CellID->760242175,ExpressionUUID->"3129044e-2557-7c3e-60d6-9e284ce24704"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalOmega]zeno", " ", "=", " ", "2.0"}], ";", " ", 
  RowBox[{"fastZeno", " ", "=", " ", "0.004"}], ";", " ", 
  RowBox[{"clockZeno", " ", "=", " ", 
   RowBox[{"fastZeno", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "3000"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[174]:= ",
 CellID->828244791,ExpressionUUID->"185e1b20-c9fe-9997-4865-928def88ebfd"],

Cell["\<\
Run a weakly and a strongly measured trajectory from the same start and seed:\
\
\>", "Text",
 CellID->338384234,ExpressionUUID->"79986dc0-6b5a-b4b1-2fa7-84aa0eec1e9b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gentle", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\[CapitalOmega]zeno", "/", "2"}], " ", "X"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "0.15", "]"}], " ", "Z"}], "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "fastZeno", ",", " ", "12.", ",", " ", 
     "7"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hard", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\[CapitalOmega]zeno", "/", "2"}], " ", "X"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "6.", "]"}], " ", "Z"}], "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "fastZeno", ",", " ", "12.", ",", " ", 
     "7"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[175]:= ",
 CellID->455054057,ExpressionUUID->"66994d41-411f-db5d-0ea7-652b70aba9a7"],

Cell[TextData[{
 "Compare the magnitude of the time-averaged ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ba5d17e-cdbf-5380-095a-c93be44a21ea"],
 ":"
}], "Text",
 CellID->1632384583,ExpressionUUID->"4459b86e-fafc-12f5-6c66-324bfe8960df"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Abs", "@", 
    RowBox[{"Mean", "[", 
     RowBox[{"zOf", "@", 
      RowBox[{"gentle", "[", "\"\<states\>\"", "]"}]}], "]"}]}], ",", " ", 
   RowBox[{"Abs", "@", 
    RowBox[{"Mean", "[", 
     RowBox[{"zOf", "@", 
      RowBox[{"hard", "[", "\"\<states\>\"", "]"}]}], "]"}]}]}], 
  "}"}]], "Input",
 CellLabel->"In[176]:= ",
 CellID->1806839179,ExpressionUUID->"0bcb2561-df35-3b41-39c8-bd4adac189ab"],

Cell[TextData[{
 "The weakly measured ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cdc7c52-f996-171f-54e4-761ff8237a65"],
 " averages to near zero (it swings freely); the strongly measured one keeps \
a large mean (pinned)."
}], "Text",
 CellID->1374498314,ExpressionUUID->"6a04a347-6624-93dc-1a3b-3b2113d6e126"],

Cell["\<\
Now visualize the weakly and strongly measured trajectories together:\
\>", "Text",
 CellID->1735539757,ExpressionUUID->"1fa3b0bf-db30-02a1-4550-29f8dec5508b"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"clockZeno", ",", " ", 
        RowBox[{"zOf", "@", 
         RowBox[{"gentle", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}], ",",
      " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"clockZeno", ",", " ", 
        RowBox[{"zOf", "@", 
         RowBox[{"hard", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"Opacity", "[", "0.8", "]"}]}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<weak measurement (free)\>\"", ",", 
      " ", "\"\<strong measurement (pinned)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]\[Sigma]z\[RightAngleBracket]\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<strong measurement freezes the qubit (Zeno)\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[177]:= ",
 CellID->913947365,ExpressionUUID->"11dd9886-a103-697c-47e2-11e3d0b63846"],

Cell["\<\
The strongly measured qubit clings to an eigenstate for long stretches, then \
jumps. Strong measurement freezes the dynamics, the Zeno effect: the more \
often you measure, the less the state can evolve. The jumps are the drive \
occasionally winning.\
\>", "Text",
 CellID->33048482,ExpressionUUID->"5d16072b-4094-e7d7-0b2d-9f757126cd3d"],

Cell[TextData[{
 "The single trace shows the freezing but cannot pin its rate. That rate is \
exact and sits in the master equation's own spectrum, and following it across \
the measurement strength tells a two-stage story: watching harder first kills \
the coherent Rabi oscillation, then freezes the relaxation left behind. Both \
stages are eigenvalues of the Liouvillian. Build it at a chosen fraction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   StyleBox["k", "TI"], "/", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e71c00a-9fc6-07cd-160e-da541a736d17"],
 " of the drive and keep the nonzero ones, so the whole crossover reads \
against that one ratio and the exceptional point falls at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59da3beb-dbdf-0123-0ff9-b2b4de6a5009"],
 ":"
}], "Text",
 CellID->1913442451,ExpressionUUID->"28f3c6b4-96e3-425b-5880-dffe229610a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"zenoEigs", "[", "ratio_", "]"}], " ", ":=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", 
      RowBox[{"liouvillian", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalOmega]zeno", "/", "2"}], ")"}], " ", "X"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"ratio", " ", "\[CapitalOmega]zeno"}], "]"}], " ", "Z"}], 
         "}"}], ",", " ", "2"}], "]"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "#", "]"}], " ", ">", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "9"}]}]}], " ", "&"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[178]:= ",
 CellID->1066460469,ExpressionUUID->"50dcf632-b06e-d3ec-00e3-e87fc118a136"],

Cell[TextData[{
 "Below the exceptional point, at half the critical strength (",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0192d3b7-44a5-149f-37a1-caf16d507ee5"],
 "), the three of them are a complex-conjugate pair and one lone real \
number:"
}], "Text",
 CellID->1552927865,ExpressionUUID->"0300f609-8c78-c232-313f-e85325f29118"],

Cell[BoxData[
 RowBox[{"zenoEigs", "[", 
  RowBox[{"1", "/", "2"}], "]"}]], "Input",
 CellLabel->"In[179]:= ",
 CellID->262489656,ExpressionUUID->"366efd8d-b3b0-5f87-5e15-f4d6c64525ed"],

Cell[TextData[{
 "The pair is ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["k", "TI"], "\[PlusMinus]", 
   StyleBox["i", "TI"], 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "-", 
     SuperscriptBox[
      StyleBox["k", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3db21443-28a2-09d2-6b41-8e2d49575b38"],
 " (here ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bbb6266-506e-8b43-5958-84406118d9a9"],
 "), a Rabi oscillation the measurement only damps; the lone real number is \
the transverse dephasing at ",
 Cell[BoxData[
  RowBox[{"-", "2", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e86e78b-e825-43de-16bd-fed489d01124"],
 ", off to the side and taking no part in the freezing."
}], "Text",
 CellID->409171113,ExpressionUUID->"00acb0de-f92e-37b6-3053-299bf8d89d9c"],

Cell["\<\
The oscillation lives in the pair's imaginary part and the relaxation in the \
least-negative real part, so read one frequency and one rate off the spectrum \
at each ratio:\
\>", "Text",
 CellID->189753264,ExpressionUUID->"688c2685-a509-dc5c-18b3-bfeeccbda6a6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"zenoFreq", "[", "ratio_", "]"}], " ", ":=", " ", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{"Im", "[", 
      RowBox[{"zenoEigs", "[", "ratio", "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zenoRate", "[", "ratio_", "]"}], " ", ":=", " ", 
   RowBox[{"-", 
    RowBox[{"Max", "[", 
     RowBox[{"Re", "[", 
      RowBox[{"zenoEigs", "[", "ratio", "]"}], "]"}], "]"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[180]:= ",
 CellID->1113565082,ExpressionUUID->"2ceaa2e1-4528-9e89-54e9-3bcb6cc2e4d3"],

Cell[TextData[{
 "Follow both across the sweep, the oscillation frequency and the slowest \
relaxation rate against the ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1303f7c9-9cc9-b37e-4130-ee93157d1e44"],
 ":"
}], "Text",
 CellID->474827638,ExpressionUUID->"2ec53290-e027-d466-56fa-abdd91d3bf4c"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", " ", 
         RowBox[{"zenoFreq", "[", "r", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0.01", ",", " ", "3.", ",", " ", "0.01"}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", " ", 
         RowBox[{"zenoRate", "[", "r", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0.01", ",", " ", "3.", ",", " ", "0.01"}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"Directive", "[", 
          RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], "}"}], ",", 
      " ", "Automatic"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Rabi oscillation  |Im \[Lambda]|\>\"", ",", 
        " ", "\"\<relaxation rate  |Re \[Lambda]|\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<k/\[CapitalOmega] ratio\>\"", ",", 
      " ", "\"\<Liouvillian eigenvalue  (1/time)\>\""}], "}"}]}], ",", "\n", 
   " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<watching harder: the oscillation dies at k = \[CapitalOmega], \
the relaxation rate peaks there\>\""}]}], "]"}]], "Input",
 CellLabel->"In[181]:= ",
 CellID->480943277,ExpressionUUID->"18ec055d-da13-7d9a-4893-9d06dfa647e0"],

Cell[TextData[{
 "The oscillation frequency slides to zero at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "210c0b92-bdf5-0dca-5733-a2dc3b805710"],
 " and stays there, the coherent swinging gone; at that same strength the \
relaxation rate reaches its peak and turns over, so watching harder past ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08a8ae1a-48d1-1e8c-3857-4044696464d6"],
 " slows the decay rather than quickening it. The pair has met on the real \
axis at an exceptional point, where the eigenvalues and their eigenvectors \
coincide and the oscillation can no longer be told apart from the decay."
}], "Text",
 CellID->19659169,ExpressionUUID->"5a42a6f1-18c8-51d7-0a71-3fbb997d233d"],

Cell[TextData[{
 "Past that peak the surviving rate falls as one over the strength. Read it \
across a wide range on log-log, with the ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "151d482b-bd7d-21e9-4323-627534087333"],
 " law drawn on the strong side:"
}], "Text",
 CellID->1122889797,ExpressionUUID->"5613a8b7-1620-2919-7e20-41f1a3d57863"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zenoKs", " ", "=", " ", 
   RowBox[{"\[CapitalOmega]zeno", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"2.", "^", "e"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"e", ",", " ", 
        RowBox[{"-", "3"}], ",", " ", "4", ",", " ", "0.08"}], "}"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{"ListLogLogPlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"zenoRate", "[", 
          RowBox[{"k", "/", "\[CapitalOmega]zeno"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "zenoKs"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{
          RowBox[{"\[CapitalOmega]zeno", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "k"}], ")"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"zenoKs", ",", " ", 
           RowBox[{
            RowBox[{"#", " ", ">=", " ", "\[CapitalOmega]zeno"}], " ", 
            "&"}]}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Joined", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"False", ",", " ", "True"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<measured rate  |Re \[Lambda]|\>\"", ",", 
        " ", "\"\<Omega^2/(2 k)  (the Zeno freeze)\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"\[CapitalOmega]zeno", ",", " ", 
         RowBox[{"Directive", "[", 
          RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], "}"}], ",", 
      " ", "None"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<measurement strength k\>\"", ",", 
      " ", "\"\<slowest relaxation rate  |Re \[Lambda]|\>\""}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the rate follows k up to k = \[CapitalOmega], then freezes as \
Omega^2/(2 k)\>\""}]}], "]"}]}], "Input",
 CellLabel->"In[182]:= ",
 CellID->1606600295,ExpressionUUID->"5ae8fe52-8d2a-0d13-0a97-f01c24df5479"],

Cell[TextData[{
 "Below ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9a61ac-db6f-0823-69ba-7809de1a5b09"],
 " the rate climbs along ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ebbb135-9363-cdcb-4658-297f26179711"],
 "; above it the points settle onto the ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fac2774-ed95-ff32-6553-bf318421c218"],
 " line, the leftover relaxation frozen as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e0bfcd9-47ee-c5d1-2608-f5837198af3b"],
 ", the small gap near the peak closing as the watching strengthens. Watching \
past the optimal strength does not pin the qubit harder, it slows what motion \
is left, the quantum Zeno suppression."
}], "Text",
 CellID->215661095,ExpressionUUID->"7bce04d4-edb5-1ec8-29f5-9d9184406412"],

Cell[TextData[{
 "The whole crossover is exact, read straight off the deterministic \
Liouvillian with no gate, no time step, and no ensemble. Its slowest \
eigenvalue returns at once in the next section as the width of the central \
peak the quantum point contact reads off its own current, so the Zeno rate \
here and that spectrum there are one number seen twice. Coherent Rabi giving \
way to overdamped freezing through a Liouvillian exceptional point is the \
modern reading of when watching stops helping and starts freezing (",
 ButtonBox["Snizhko, Kumar, and Romito, 2020",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2003.10476"], None}],
 "), seen on a driven transmon by ",
 ButtonBox["Slichter and Siddiqi, 2016",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/1512.04006"], None}],
 "."
}], "Text",
 CellID->1518204824,ExpressionUUID->"04eac529-5321-5efa-2ce9-dd7366d424c0"],

Cell["A Charge Qubit Read by a Quantum Point Contact", "Subsection",
 CellID->1890580947,ExpressionUUID->"121d8e7a-a943-ef24-4222-2027c8f7b20e"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " The last two examples watched an abstract qubit; here is the same watching \
realized in a solid-state device. A charge qubit (one electron shared between \
two quantum dots, \"dot 1\" or \"dot 2\") is monitored by a nearby quantum \
point contact (QPC) whose current depends on which dot holds the electron. \
With interdot tunnelling ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f53e49d-d2a9-b4ee-6560-fdc6e75d1e34"],
 " and no detuning, the unconditional master equation is"
}], "Text",
 CellID->1680570408,ExpressionUUID->"672c7908-ff3c-85a7-0ed4-7155faceef8d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      FractionBox["\[CapitalOmega]", "2"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["x", "TI"]]}], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Kappa]", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "1"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "1"], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"\|01d7d9", "-", 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], 
        StyleBox["z", "TI"]]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->475458560,ExpressionUUID->"4f36945c-6fe2-68e0-76cd-0e0609973aca"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "2"], "-", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250c2a2d-8da6-5f9d-5333-cc77245325e7"],
 " the which-dot operator. Here ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67928f76-a8f6-4c39-0da1-2733c8831703"],
 " is the coefficient of ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["n", "TI"], "1"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f8d9e4d-778e-395a-15b2-101702388ba0"],
 "; because ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4897ab63-07fe-7036-78ac-434db18b431c"],
 " is a projector, the off-diagonal density-matrix element decays at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3afe1774-f6b9-1a20-6a85-8f31834c690a"],
 ". The QPC current is a continuous weak measurement of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cb96547-3d6c-b437-3447-7d21b41e1f1d"],
 ": when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "<", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2231aed9-983c-87b7-53ce-478319ceed9d"],
 " the electron tunnels coherently and the current carries an oscillation at \
the Rabi frequency; when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], ">", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d324fdb-2677-e56b-74c2-66855303cfb1"],
 " the qubit is pinned and the current is a random telegraph. Build the \
conditioned dynamics, the detector current, and the current's power \
spectrum."
}], "Text",
 CellID->823056013,ExpressionUUID->"5da8286f-a7a3-9cec-0b57-c248d257e636"],

Cell[TextData[{
 "The dephasing ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d602230-5f26-2f06-2b1f-c47a5ad3726c"],
 " is a projector, and ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   FractionBox["1", "4"], "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77db54cc-ee9f-ec5f-1df9-4da98b2bb6a5"],
 " (the identity part drops from any dissipator), so watching the QPC is \
exactly watching ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a072e47-9a01-f132-1a3c-c0211fb5c018"],
 " at strength ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03b41a97-fa59-5a01-314b-93d0ffec296b"],
 ": the machinery of the last two examples applies unchanged. Fix the \
tunnelling and the two regimes:"
}], "Text",
 CellID->1392600812,ExpressionUUID->"425dab48-397f-3702-7262-4312b80b9a68"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OmQpc", " ", "=", " ", "2.0"}], ";", " ", 
  RowBox[{"kSlow", " ", "=", " ", "0.6"}], ";", " ", 
  RowBox[{"kFast", " ", "=", " ", "12.0"}], ";", " ", 
  RowBox[{
   RowBox[{"qpcLeak", "[", "\[Kappa]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Kappa]", "/", "4"}], "]"}], " ", "Z"}]}], ";"}]], "Input",
 CellLabel->"In[183]:= ",
 CellID->1250002485,ExpressionUUID->"0b03a0e0-ac2b-54e8-3930-39cdc5de3e32"],

Cell[TextData[{
 "The conditioned trajectory uses the toolkit's positivity-preserving step. \
After subtracting the state-independent mean QPC current and choosing the \
sign convention ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Z", "TI"], "=", 
   SubscriptBox[
    StyleBox["n", "TI"], "2"], "-", 
   SubscriptBox[
    StyleBox["n", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23998a05-7963-184f-51a6-2c6f78166a95"],
 ", the rescaled record is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["J", "TI"], "."], "=", 
   SqrtBox[
    StyleBox["\[Kappa]", "TI"]], "\[ThinSpace]", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "+", 
   StyleBox[
    RowBox[{"shot", "\[NonBreakingSpace]", "noise"}],
    FontSlant->"Plain"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "422628af-426c-374e-73dd-c109771e9d94"],
 ". An experimental current can differ by an overall gain and sign; neither \
changes the conditioned dynamics. Run one weakly-measured (coherent) history \
and one strongly-measured (Zeno) history:"
}], "Text",
 CellID->1196503608,ExpressionUUID->"26e7e4d8-634d-0d10-4e9c-fd8216f8547a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dtQpc", " ", "=", " ", "0.004"}], ";", " ", 
  RowBox[{"tfQpc", " ", "=", " ", "10."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qpcSlow", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "ground", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"qpcLeak", "[", "kSlow", "]"}], "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "dtQpc", ",", " ", "tfQpc", ",", " ", 
     "4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qpcFast", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "ground", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"qpcLeak", "[", "kFast", "]"}], "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "dtQpc", ",", " ", "tfQpc", ",", " ", 
     "4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"whenQpc", " ", "=", " ", 
   RowBox[{"qpcSlow", "[", "\"\<times\>\"", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[184]:= ",
 CellID->35509309,ExpressionUUID->"027e254c-1480-02c1-3205-bd169d35502b"],

Cell[TextData[{
 "The QPC hands back a single real record, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "=", 
   SqrtBox[
    StyleBox["\[Kappa]", "TI"]], "\[ThinSpace]", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6456a901-44b8-c553-0c6d-416b6d32afb9"],
 ", one continuous measurement of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5de3bc1f-ff0d-b0a4-0b90-3658fab9028e"],
 ": it is the homodyne ledger again in a solid-state skin, the record the \
only data and the coherent which-dot swing inferred from it, buried per step \
under shot noise many times larger."
}], "Text",
 CellID->133207102,ExpressionUUID->"05b0da98-ac84-313a-334f-d3c5c5368000"],

Cell["\<\
Contrast the two regimes directly, the coherent swing against the \
strongly-watched telegraph:\
\>", "Text",
 CellID->1619111818,ExpressionUUID->"1895dfb3-965d-1c83-48aa-d6fd23e866e9"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"whenQpc", ",", " ", 
        RowBox[{"zOf", "@", 
         RowBox[{"qpcSlow", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}], ",",
      " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"whenQpc", ",", " ", 
        RowBox[{"zOf", "@", 
         RowBox[{"qpcFast", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"Opacity", "[", "0.85", "]"}]}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<weak (coherent tunnelling)\>\"", ",", 
      " ", "\"\<strong (Zeno telegraph)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]\[Sigma]z\[RightAngleBracket]\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<measurement strength selects coherent oscillation or \
telegraph\>\""}]}], "]"}]], "Input",
 CellLabel->"In[185]:= ",
 CellID->1609727223,ExpressionUUID->"2deed3b4-be8d-db40-5b95-cafe3b39a9aa"],

Cell["\<\
Weak measurement leaves the electron tunnelling freely; strong measurement \
pins it in one dot with rare jumps.\
\>", "Text",
 CellID->550162028,ExpressionUUID->"78e6b17c-c991-15ef-289d-2939e8247f35"],

Cell[TextData[{
 "The distinctive QPC signature is not in any single record but in the ",
 StyleBox["spectrum", "TI"],
 ", because a coherent oscillation is a ",
 StyleBox["frequency", "TI"],
 ": it cancels in the time-integral of the record and shows itself only in \
the spectrum, painting a peak at the Rabi frequency in the fluctuations of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24acbe62-bdf4-ffe2-4c53-304c3b86c5c8"],
 " that the detector current inherits. The power spectrum is the Fourier \
transform of the steady-state autocorrelation ",
 Cell[BoxData[
  SubscriptBox[
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["\[Delta]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Tau]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], "\[ThinSpace]", 
     StyleBox["\[Delta]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["(",
      SpanMaxSize->1], "0", 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], 
   StyleBox["ss",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38f0085c-4734-4722-688f-a20672c12a08"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "-", 
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["ss",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b9216eb-8f9f-eb69-19a1-8fb52a2bb9b3"],
 " is the fluctuation about the steady mean. Quantum regression is the \
statement that this correlation runs on the ",
 StyleBox["same", "TI"],
 " Liouvillian as the state: plant the seed ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59f120da-5631-2eb2-0f8e-b98463c47498"],
 ", propagate it by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"\[ScriptCapitalL]", 
    StyleBox["\[Tau]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fa7ad17-3a9c-8e6e-055c-4551bf2ed4b4"],
 ", and read ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c844eb4-1a55-00c1-54bc-67fe9fe0522b"],
 " back off it, so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Delta]", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"\[ScriptCapitalL]", 
      StyleBox["\[Tau]", "TI"]}]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["\[Delta]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["ss",
       FontSlant->"Plain"]]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cf619f4-16c8-91d6-148d-90bea362e33c"],
 "."
}], "Text",
 CellID->1908615943,ExpressionUUID->"66b1d308-016b-0c10-0e4e-cb52b01e577a"],

Cell[TextData[{
 "With the convention ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubsuperscriptBox["\[Integral]", 
    RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Omega]", "TI"], 
     StyleBox["\[Tau]", "TI"]}]], 
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["\[Tau]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0764fd02-d65e-847f-2d1b-f56fe3e8ef45"],
 ", Fourier-transforming in ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c98820f-8b6f-75b8-34a7-24692e1a5f82"],
 " replaces the propagator ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"\[ScriptCapitalL]", 
    StyleBox["\[Tau]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6abb7d62-34cd-b03b-1a59-754cbd790301"],
 " by a single matrix inverse, the resolvent ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["\[Omega]", "TI"], "-", "\[ScriptCapitalL]"}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   RowBox[{"-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d7b53f1-7ae1-3c16-5b19-4abb7e95877c"],
 ". If the Liouvillian is diagonalizable, the inverse splits into simple \
poles, one per eigenvalue ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "342ac02e-94b9-9375-5c29-d9881d4dfe5f"],
 ". An eigenvalue ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["j", "TI"]], "=", "-", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["j", "TI"]], "+", 
   StyleBox["i", "TI"], 
   SubscriptBox[
    StyleBox["\[Nu]", "TI"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e47f25d-3ed8-a4c4-267c-f407bb520e2e"],
 " supplies a pole at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Nu]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "420d2e93-75d1-66df-7232-c7dd7c644c25"],
 " with width ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0eb3603b-0e30-9ef6-3641-7a65abcae4dc"],
 ", but a complex residue can mix absorptive (Lorentzian) and dispersive line \
shapes; it is not generally a positive Lorentzian by itself. The coefficient ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da293aa-5e01-ac71-3b51-0af45bb5f75b"],
 " is the seed's coordinate along mode ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32c08ae5-f3ed-cbfa-62ff-23ce859999c0"],
 ", and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["r", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cfb14f9-38ed-478b-4498-8da3b8982dd1"],
 " is the readout overlap. Summing the poles, with the steady mode ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["j", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "683f5ed1-9434-8a9e-19c5-579b1dc6d8e4"],
 " dropped because ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07cd5cb3-9399-0155-2df3-55fd262c53bf"],
 " has zero steady mean,"
}], "Text",
 CellID->1143006314,ExpressionUUID->"4f9e6b1d-931e-a284-75a5-834726a8f0ee"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["S", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Omega]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", "2", "\[ThinSpace]", 
    StyleBox["Re",
     FontSlant->"Plain"], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Lambda]", "TI"], 
       StyleBox["j", "TI"]], "\[NotEqual]", "0"}],
     LimitsPositioning->False], 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["c", "TI"], 
       StyleBox["j", "TI"]], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["r", "TI"], 
       StyleBox["j", "TI"]]}], 
     RowBox[{
      StyleBox["i", "TI"], 
      StyleBox["\[Omega]", "TI"], "-", 
      SubscriptBox[
       StyleBox["\[Lambda]", "TI"], 
       StyleBox["j", "TI"]]}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1196348210,ExpressionUUID->"7129e602-6ec3-689c-20d6-f86c0b763ae6"],

Cell["\<\
This is where the slowest eigenvalue of the Zeno crossover returns: it is the \
pole nearest the imaginary axis and controls the narrowest long-time spectral \
scale. When its residue is real and it dominates the other modes, that scale \
appears as a Lorentzian half-width equal to the relaxation rate.\
\>", "Text",
 CellID->742714341,ExpressionUUID->"24548d70-e349-6090-4c6b-253d96fc32fa"],

Cell[TextData[{
 "Build the general spectrum for any Liouvillian, seed, and readout: \
eigendecompose the Liouvillian, find the seed's coordinates ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24053d10-b77f-7f73-4c3a-b55dc20a4259"],
 " by solving for them in the eigenbasis, read each mode's overlap ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["r", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16592835-d9b8-94b1-3e66-c27ed832fe9b"],
 " with the readout, and sum the poles at every requested frequency:"
}], "Text",
 CellID->1675247856,ExpressionUUID->"141ca810-4c49-bb60-3c23-425a65fd064a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"regressionSpectrum", "[", 
    RowBox[{
    "big_", ",", " ", "seedMat_", ",", " ", "readout_", ",", " ", "tones_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"Length", "[", "readout", "]"}]}], ",", " ", 
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Length", "[", "big", "]"}]}], ",", " ", "vals", ",", " ", 
       "vecs", ",", " ", "basis", ",", " ", "singular", ",", " ", "coeffs", ",",
        " ", "resu"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vals", ",", " ", "vecs"}], "}"}], " ", "=", " ", 
       RowBox[{"Eigensystem", "[", "big", "]"}]}], ";", "\n", "   ", 
      RowBox[{"basis", " ", "=", " ", 
       RowBox[{"Transpose", "[", "vecs", "]"}]}], ";", " ", 
      RowBox[{"singular", " ", "=", " ", 
       RowBox[{"SingularValueList", "[", 
        RowBox[{"N", "@", "basis"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"MatrixRank", "[", "basis", "]"}], " ", "<", " ", "n"}], 
         " ", "||", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Last", "[", "singular", "]"}], "/", 
           RowBox[{"First", "[", "singular", "]"}]}], " ", "<", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "7"}]}]}]}], ",", "\n", "    ", 
        RowBox[{"Return", "@", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<DefectiveEigenbasis\>\"", ",", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<NumericalRank\>\"", " ", "->", " ", 
              RowBox[{"MatrixRank", "[", 
               RowBox[{"N", "@", "basis"}], "]"}]}], ",", " ", 
             RowBox[{"\"\<ConditionNumber\>\"", " ", "->", " ", 
              RowBox[{
               RowBox[{"First", "[", "singular", "]"}], "/", 
               RowBox[{"Last", "[", "singular", "]"}]}]}]}], "|>"}]}], 
          "]"}]}]}], "]"}], ";", "\n", "   ", 
      RowBox[{"coeffs", " ", "=", " ", 
       RowBox[{"LinearSolve", "[", 
        RowBox[{"basis", ",", " ", 
         RowBox[{"Flatten", "[", "seedMat", "]"}]}], "]"}]}], ";", "\n", 
      "   ", 
      RowBox[{"resu", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{"readout", " ", ".", " ", 
           RowBox[{"ArrayReshape", "[", 
            RowBox[{
             RowBox[{"vecs", "[", 
              RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", 
           RowBox[{"d", "^", "2"}]}], "}"}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"Re", "@", 
          RowBox[{"Total", "@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"vals", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "<", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "9"}]}]}], ",", " ", "0", ",", " ", 
               RowBox[{
                RowBox[{"coeffs", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", 
                RowBox[{
                 RowBox[{"resu", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"I", " ", "w"}], " ", "-", " ", 
                   RowBox[{"vals", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}]}]}], "]"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", 
               RowBox[{"d", "^", "2"}]}], "}"}]}], "]"}]}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"w", ",", " ", "tones"}], "}"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[186]:= ",
 CellID->288968408,ExpressionUUID->"68e9730c-176f-ed31-1897-6b56a21bb41b"],

Cell[TextData[{
 Cell[BoxData["vals"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "045a1c11-48b2-feff-2c79-965b6944c4c5"],
 " are the eigenvalues ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5000470d-6ead-2730-0030-5f570b598a1a"],
 "; ",
 Cell[BoxData["coeffs"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b36215d-7c1e-6467-0acd-b90775ab4f4d"],
 " are the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "648fe92d-3764-e6d2-0cb4-01774216cc38"],
 ", produced by ",
 Cell[BoxData["LinearSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51ab5adf-11d7-a41b-07a9-5399a0630f61"],
 " writing the seed as a combination of the eigenmodes; ",
 Cell[BoxData["resu"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea1ee02-7e80-589f-165e-006c7b352ae5"],
 " are the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["r", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "481e4aee-9cf5-9d73-7826-63c81481e459"],
 ", each mode's trace against the readout; the last line sums ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["j", "TI"]], 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["j", "TI"]], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], 
    StyleBox["\[Omega]", "TI"], "-", 
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3565e36d-8dcc-1be9-631a-fb3724796933"],
 " over the nonzero eigenvalues."
}], "Text",
 CellID->1029027830,ExpressionUUID->"235d73f5-0285-a3fd-5163-6abfb731f1c7"],

Cell[TextData[{
 "The eigenmode sum is one way to the spectrum. There is a second that never \
diagonalizes at all: Fourier-transforming ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a726cbd-ee36-06ea-5a01-85e68bc36c30"],
 " turns ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"\[ScriptCapitalL]", 
    StyleBox["\[Tau]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "545cfe61-129d-c9b2-7c63-f04ba7299b98"],
 " straight into the resolvent ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["\[Omega]", "TI"], "-", "\[ScriptCapitalL]"}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   RowBox[{"-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a738979-6fd1-4d91-5a00-21230a6417fb"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "2", "\[ThinSpace]", 
   StyleBox["Re",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["R", "TI"], "^"], "\[ThinSpace]", 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["i", "TI"], 
       StyleBox["\[Omega]", "TI"], "-", "\[ScriptCapitalL]"}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{"-", "1"}]], "\[ThinSpace]", 
    OverscriptBox[
     StyleBox["S", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cda659f-caad-1800-44fa-7cd8ef586b6a"],
 " for readout ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["R", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bd8f04d-1eeb-cc47-19e7-ea179a9f96ad"],
 " and seed ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["S", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4131a38c-3cb1-61e0-70ce-3ad6b54433ca"],
 ". In other words, solve one linear system per frequency instead of \
splitting the inverse into poles. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66dd1d78-a26e-793a-0ee2-9525d71b4800"],
 " the propagated seed stays traceless, so we pin the physical branch by \
appending the trace condition and solving in the least-squares sense:"
}], "Text",
 CellID->128002051,ExpressionUUID->"497210fc-93c1-a1bc-7f01-89a62675f386"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"resolventSpectrum", "[", 
    RowBox[{
    "big_", ",", " ", "seedMat_", ",", " ", "readout_", ",", " ", "tones_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Length", "[", "big", "]"}]}], ",", " ", 
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"Length", "[", "readout", "]"}]}]}], "}"}], ",", "\n", "   ", 
     
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"Re", "@", 
         RowBox[{"Tr", "[", 
          RowBox[{"readout", " ", ".", " ", 
           RowBox[{"ArrayReshape", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", "w", "]"}], " ", "<", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "9"}]}]}], ",", "\n", "       ", 
               RowBox[{"LeastSquares", "[", 
                RowBox[{
                 RowBox[{"Join", "[", 
                  RowBox[{
                   RowBox[{"N", "[", 
                    RowBox[{"-", "big"}], "]"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"1.", " ", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"IdentityMatrix", "[", "d", "]"}], "]"}]}], 
                    "}"}]}], "]"}], ",", " ", 
                 RowBox[{"Join", "[", 
                  RowBox[{
                   RowBox[{"Flatten", "[", "seedMat", "]"}], ",", " ", 
                   RowBox[{"{", "0.", "}"}]}], "]"}]}], "]"}], ",", "\n", 
               "       ", 
               RowBox[{"LinearSolve", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"I", " ", "w", " ", 
                   RowBox[{"IdentityMatrix", "[", "n", "]"}]}], " ", "-", " ",
                   "big"}], ",", " ", 
                 RowBox[{"Flatten", "[", "seedMat", "]"}]}], "]"}]}], "]"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], "]"}]}]}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"w", ",", " ", "tones"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[187]:= ",
 CellID->1571712410,ExpressionUUID->"2d97aad1-2ffc-78e2-5bac-439b49894ac8"],

Cell[TextData[{
 "Now specialize to the QPC. Build its Liouvillian and steady state, center \
",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45812a49-00f9-159c-73be-cc13b08c7fe6"],
 " on its steady value to form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e72335e-d71b-483f-5601-ab1be2ae1b05"],
 ", and hand the symmetrized seed ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Delta]", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]], "+", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    StyleBox["\[Delta]", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00379a47-1bf1-fdbf-31cc-1c219d85c785"],
 " together with that same ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19c466c6-94fb-625d-4ffc-7fa01c8e30a7"],
 " as the readout to the resolvent form:"
}], "Text",
 CellID->890139439,ExpressionUUID->"20cc8908-a147-10ca-50f3-2155d0f26210"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qpcSpectrum", "[", 
    RowBox[{"\[Kappa]_", ",", " ", "tones_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"big", " ", "=", " ", 
        RowBox[{"liouvillian", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"qpcLeak", "[", "\[Kappa]", "]"}], "}"}], ",", " ", "2"}], 
         "]"}]}], ",", " ", 
       RowBox[{"rss", " ", "=", " ", 
        RowBox[{"First", "@", 
         RowBox[{"steadyState", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"qpcLeak", "[", "\[Kappa]", "]"}], "}"}]}], "]"}]}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dz", " ", "=", " ", 
         RowBox[{"Z", " ", "-", " ", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{"Z", " ", ".", " ", "rss"}], "]"}], "]"}], " ", 
           "id2"}]}]}], "}"}], ",", " ", 
       RowBox[{"resolventSpectrum", "[", 
        RowBox[{"big", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"dz", " ", ".", " ", "rss"}], " ", "+", " ", 
            RowBox[{"rss", " ", ".", " ", "dz"}]}], ")"}], "/", "2"}], ",", 
         " ", "dz", ",", " ", "tones"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[188]:= ",
 CellID->999332945,ExpressionUUID->"13bcd130-62a3-8c70-4143-c97a1757d75a"],

Cell[TextData[{
 "Here ",
 Cell[BoxData["dz"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6565394a-c196-6bdd-131a-b117f0233927"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "654f987a-f98e-d016-1374-1227f838a37c"],
 ", and symmetrizing the seed selects the real, even correlation measured by \
the detector. ",
 Cell[BoxData["qpcSpectrum"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "631c7298-8e73-d34d-1124-6bc22b07a197"],
 " deliberately uses the mode-free resolvent, so the parameter sweep remains \
defined at the exceptional point; the modal representation is used only as a \
cross-check away from coalescence."
}], "Text",
 CellID->662631669,ExpressionUUID->"2e9b4f74-ee28-5e2b-56b9-67318bdd2571"],

Cell[TextData[{
 "Confirm the normalization is right: the spectrum integrates to the steady \
variance of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ff84a3f-8ea3-8415-2598-6c792b57ef7f"],
 ", which is one for the maximally mixed steady state:"
}], "Text",
 CellID->798789937,ExpressionUUID->"4d7fc3a7-f4ac-747e-7b04-da00fd595f44"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"wide", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "40"}], ",", " ", "40", ",", " ", "0.02"}], "]"}]}], 
    "}"}], ",", " ", 
   RowBox[{"0.02", " ", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"qpcSpectrum", "[", 
       RowBox[{"1.", ",", " ", "wide"}], "]"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "Pi"}], ")"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[189]:= ",
 CellID->647724388,ExpressionUUID->"6b0a0ef4-2602-73b0-1909-a7be53b7419a"],

Cell["It returns one, so the spectral weight is accounted for.", "Text",
 CellID->1693391218,ExpressionUUID->"7324c1ff-ae1d-8266-22db-d8b8cba9d14c"],

Cell["\<\
Confirm the two ways give the same QPC spectrum, at a ratio far from any \
coalescence:\
\>", "Text",
 CellID->819462336,ExpressionUUID->"0a19e89c-6899-3c78-3a26-01c6092d8742"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"big", " ", "=", " ", 
      RowBox[{"liouvillian", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"qpcLeak", "[", "4.", "]"}], "}"}], ",", " ", "2"}], "]"}]}],
      ",", " ", 
     RowBox[{"rss", " ", "=", " ", 
      RowBox[{"First", "@", 
       RowBox[{"steadyState", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"qpcLeak", "[", "4.", "]"}], "}"}]}], "]"}]}]}], ",", " ", 
     RowBox[{"grid", " ", "=", " ", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"-", "6"}], ",", " ", "6", ",", " ", "0.1"}], "]"}]}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dz", " ", "=", " ", 
       RowBox[{"Z", " ", "-", " ", 
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"Z", " ", ".", " ", "rss"}], "]"}], "]"}], " ", 
         "id2"}]}]}], "}"}], ",", " ", 
     RowBox[{"Max", "@", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"regressionSpectrum", "[", 
         RowBox[{"big", ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"dz", " ", ".", " ", "rss"}], " ", "+", " ", 
             RowBox[{"rss", " ", ".", " ", "dz"}]}], ")"}], "/", "2"}], ",", 
          " ", "dz", ",", " ", "grid"}], "]"}], " ", "-", " ", 
        RowBox[{"resolventSpectrum", "[", 
         RowBox[{"big", ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"dz", " ", ".", " ", "rss"}], " ", "+", " ", 
             RowBox[{"rss", " ", ".", " ", "dz"}]}], ")"}], "/", "2"}], ",", 
          " ", "dz", ",", " ", "grid"}], "]"}]}], "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[190]:= ",
 CellID->1116629832,ExpressionUUID->"39663cc9-297d-9b4a-6f1d-b5934809e990"],

Cell[TextData[{
 "Away from coalescence, the maximum difference is at numerical precision: \
two representations of one spectrum. They part company at one place only. \
Where two Liouvillian eigenvalues and their eigenvectors coalesce, an ",
 StyleBox["exceptional point",
  FontWeight->"Bold"],
 " (met in the Zeno crossover above, and reached again in the squeezing \
spectrum of the last section), the eigenbasis the mode sum needs turns \
singular while the resolvent never forms it. The QPC sweep therefore uses the \
resolvent for every ratio, including the exact exceptional point."
}], "Text",
 CellID->871366443,ExpressionUUID->"7331868a-f3de-6799-22ce-1fd7866b4de3"],

Cell[TextData[{
 "Now sweep the ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   StyleBox["k", "TI"], "/", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e54b5d3-3a50-bfef-566b-2c9dbfea0535"],
 " of the effective measurement strength ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   StyleBox["\[Kappa]", "TI"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "290d3a44-5bc8-0dba-5f32-bc2e5e7d5780"],
 " to the drive, from weak, past the point where the two spectral peaks \
merge, into the Zeno regime. Take five ratios along that path:"
}], "Text",
 CellID->1498962183,ExpressionUUID->"24441621-d1c3-83e7-4c7b-8f8ae077d1cd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ratioSweep", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0.25", ",", " ", "0.5", ",", " ", "0.75", ",", " ", "1.", ",", " ", 
     "1.5"}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[191]:= ",
 CellID->914693011,ExpressionUUID->"40c04446-bf75-68d5-70f0-5e203a003a3f"],

Cell[TextData[{
 "Resolve each spectrum on a fine frequency grid wide enough to hold both \
Rabi peaks near ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337e031d-61ac-97b3-6105-9b47105efd99"],
 ":"
}], "Text",
 CellID->2145390693,ExpressionUUID->"6c1a2f33-e4c4-62b1-1439-c77c8d71309b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tonesQpc", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "6"}], ",", " ", "6", ",", " ", "0.04"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[192]:= ",
 CellID->272231904,ExpressionUUID->"617ac38b-bfe7-c8e3-1719-dad539939ac9"],

Cell["\<\
Colour the curves warm to cool across the sweep, so the peaks' inward march \
reads at a glance:\
\>", "Text",
 CellID->183385376,ExpressionUUID->"0820ecb4-5495-9c54-39df-05fe5d21e6be"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sweepCols", " ", "=", " ", 
   RowBox[{
    RowBox[{"ColorData", "[", "\"\<TemperatureMap\>\"", "]"}], " ", "/@", " ", 
    RowBox[{"Subdivide", "[", 
     RowBox[{
      RowBox[{"Length", "[", "ratioSweep", "]"}], " ", "-", " ", "1"}], 
     "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[193]:= ",
 CellID->1323839713,ExpressionUUID->"5e80e7d7-2c44-8e80-06bf-fe9145f6d4ea"],

Cell[TextData[{
 "Overlay the five power spectra, one per ratio (recovering ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "=", "4", "\[CapitalOmega]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f5fcf3-bda8-2342-4e8a-f5bd345d71a8"],
 " for each), with gridlines at ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15b39007-6d36-072c-4340-0a6104c36a76"],
 ":"
}], "Text",
 CellID->1299720858,ExpressionUUID->"24baaecf-7f93-f980-4c59-47a97a27cbea"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tonesQpc", ",", " ", 
        RowBox[{"qpcSpectrum", "[", 
         RowBox[{
          RowBox[{"4", " ", "OmQpc", " ", "r"}], ",", " ", "tonesQpc"}], 
         "]"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "ratioSweep"}], "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Directive", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"Thickness", "[", "0.006", "]"}]}], "]"}], " ", "&"}], " ", "/@",
       " ", "sweepCols"}], ")"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"LineLegend", "[", 
     RowBox[{"sweepCols", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<k/\[CapitalOmega] = 0.25  (weak)\>\"", ",", 
        " ", "\"\<k/\[CapitalOmega] = 0.5\>\"", ",", 
        " ", "\"\<k/\[CapitalOmega] = 0.75\>\"", ",", 
        " ", "\"\<k/\[CapitalOmega] = 1  (exceptional point)\>\"", ",", 
        " ", "\"\<k/\[CapitalOmega] = 1.5  (Zeno)\>\""}], "}"}]}], "]"}]}], ",",
    "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "OmQpc"}], ",", " ", "0", ",", " ", "OmQpc"}], "}"}], ",",
       " ", "None"}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency\>\"", ",", " ", "\"\<S_zz(omega)\>\""}], "}"}]}], 
   ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<watching harder marches the spectral peaks inward,\n merging \
them before the exceptional point\>\""}]}], "]"}]], "Input",
 CellLabel->"In[194]:= ",
 CellID->513341225,ExpressionUUID->"76f70144-dc0f-2312-1e8c-9921d5bb8e78"],

Cell[TextData[{
 "At weak watching the spectrum is split, twin peaks near ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fe7a9e0-94ce-d707-459c-40ca1d78ba6d"],
 ", the coherent Rabi oscillation written into the fluctuations of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d41bad8-5432-fbcd-6b7e-33825dc4c917"],
 ", the solid-state echo of the Mollow triplet's sidebands. Watching harder \
marches those peaks inward, but not to the pole frequency: the damping pushes \
each maximum below it, to ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "-", "2", 
     SuperscriptBox[
      StyleBox["k", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dba7410-c818-dfcb-3b5a-6e5de992a511"],
 ", so the peaks reach zero and merge already at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]", "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30c9b337-f958-fd8c-60f6-2b70f8d2c7d6"],
 " (ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[TildeTilde]", "0.71"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ef4fbe9-42ce-bb3a-268b-f2b377780600"],
 "). That merger is one event; the exceptional point is another. The \
Liouvillian poles sit at ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["k", "TI"], "\[PlusMinus]", 
   StyleBox["i", "TI"], 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "-", 
     SuperscriptBox[
      StyleBox["k", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b93c9b6-6d32-b3d4-19a0-e0f004c4013e"],
 " and keep oscillating until ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78b94e11-c6dd-a6bf-2847-605af3690c85"],
 " (ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b080b4d-7396-a957-4937-a3170620fbbd"],
 ", that is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "=", "4", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "343c9421-c983-3b23-5dc3-0d8ae8378609"],
 "), where the two eigenvalues ",
 StyleBox["and their eigenvectors", "TI"],
 " coalesce and the Liouvillian turns defective. Spectral merger comes first, \
eigenvector coalescence later: at the plotted ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "0.75"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "205770a9-e847-de3f-506d-69f289f3a505"],
 " the spectrum already shows a single central maximum even though the poles \
are still a damped-oscillating pair. Deep in the Zeno regime the narrow slow \
pole dominates the central feature and its width scales as ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78b78126-006e-7c03-284c-1880b11b4769"],
 ", so the rate tracked in the previous section reappears spectrally."
}], "Text",
 CellID->2063978445,ExpressionUUID->"5e949e5e-c771-e653-06ab-101bf205ccb9"],

Cell[TextData[{
 "The two thresholds are easiest to see if we track the peak location itself. \
Plot the spectral maximum ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox["\[CapitalOmega]", "2"], "-", "2", 
    SuperscriptBox[
     StyleBox["k", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "359bcca5-e220-9ec0-63b8-e50e97dae42a"],
 " and, beside it, the pole frequency ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox["\[CapitalOmega]", "2"], "-", 
    SuperscriptBox[
     StyleBox["k", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d973432-f49b-24e6-6bac-ae7ffd2f8ecc"],
 " against the ratio, marking where each reaches zero:"
}], "Text",
 CellID->124947567,ExpressionUUID->"2740d0b2-6fee-93c4-4d7f-c9fc0998e12e"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Om", " ", "=", " ", "OmQpc"}], "}"}], ",", "\n", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", ",", " ", 
           RowBox[{"Re", "@", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"Om", "^", "2"}], " ", "-", " ", 
              RowBox[{"2", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"r", " ", "Om"}], ")"}], "^", "2"}]}]}], "]"}]}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "0", ",", " ", "1.5", ",", " ", "0.005"}], 
          "}"}]}], "]"}], ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", ",", " ", 
           RowBox[{"Re", "@", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"Om", "^", "2"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"r", " ", "Om"}], ")"}], "^", "2"}]}], "]"}]}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "0", ",", " ", "1.5", ",", " ", "0.005"}], 
          "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", "Dashed"}], 
         "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<spectral maximum\>\"", ",", 
        " ", "\"\<pole frequency\>\""}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "/", 
             RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}]}], "}"}], ",",
         " ", "Automatic"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<k/\[CapitalOmega] ratio\>\"", ",", 
        " ", "\"\<frequency\>\""}], "}"}]}], ",", "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<spectral peak reaches zero at k/\[CapitalOmega] \[TildeEqual] \
0.71, poles only at k/\[CapitalOmega] = 1\>\""}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[195]:= ",
 CellID->307500845,ExpressionUUID->"28899a3f-5003-79db-58b6-1c7961b64b21"],

Cell[TextData[{
 "The solid curve, the spectral maximum, hits zero first at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]", "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "091a51ee-65fb-201c-3f3a-48c8138e7366"],
 "; the dashed curve, the pole frequency, survives to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60c488fa-b38d-2f14-10fb-21a7c638727e"],
 ". Between the two gray markers the spectrum is already single-peaked while \
the trajectory still rings, so the five-ratio sweep above steps over both \
thresholds without landing on either."
}], "Text",
 CellID->971031069,ExpressionUUID->"3dab8a61-8541-a5e8-6ba8-2c4b2cf50f32"],

Cell[TextData[{
 "What a lab actually records is the detector ",
 StyleBox["current", "TI"],
 " spectrum, the flat shot-noise floor with this ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["zz",
     FontSlant->"Plain"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cd9d50f-b32b-5aae-14e6-cd68c6de28f4"],
 " riding on it (scaled by the measurement coupling); a fundamental result, \
the Korotkov-Averin bound, caps that current peak at four times the \
shot-noise background for a quantum-limited detector, the solid-state \
statement of the measurement limit that runs through this whole catalog."
}], "Text",
 CellID->959838422,ExpressionUUID->"25697345-b0fc-afe2-5317-6b2ec08ef5c8"],

Cell[TextData[{
 "Two different knobs move two different crossovers, and they should not be \
confused: the ",
 StyleBox["measurement strength", "TI"],
 " ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b535da6-b53b-b46b-2961-54003ccf1eb1"],
 " sets coherent-oscillation versus Zeno-telegraph behaviour (shown above), \
while the detector ",
 StyleBox["transparency", "TI"],
 " sets whether the record is read as discrete electron jumps (a counting \
unravelling like the photon counter) or as this diffusive current. Both \
unravellings average to the one master equation above."
}], "Text",
 CellID->1887610507,ExpressionUUID->"44232014-649d-d43d-6dd0-ba5e0d29bf07"],

Cell["Measurement-Induced Localization", "Subsection",
 CellID->1384833740,ExpressionUUID->"7586ae08-7861-bb88-23bd-4052791509d2"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " The general continuous measurement of an observable (here ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e345b1-bc57-c084-7c91-5cfb35e392ee"],
 ") on an ",
 StyleBox["undriven", "TI"],
 " qubit, written in the catalog's measurement-strength convention:"
}], "Text",
 CellID->1880473289,ExpressionUUID->"5c2b12ae-6045-71e4-0428-8b0811f043ce"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", 
    StyleBox["k", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[Rho]", "TI"], "+", 
     StyleBox["\[Rho]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], "-", "2", 
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox[
     RowBox[{"d", "y"}], "TI"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], 
        StyleBox["z", "TI"]], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{
      FractionBox[
       StyleBox[
        RowBox[{"d", "W"}], "TI"], 
       RowBox[{"2", 
        SqrtBox[
         StyleBox["k", "TI"]]}]], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->117881571,ExpressionUUID->"180e6a9a-5611-2942-4835-83c463a47ba8"],

Cell[TextData[{
 "With nothing pushing, the state's knowledge sharpens toward an eigenstate \
of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dd95d70-b540-f840-1be7-553a3cfacaaa"],
 " at the rate set by ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29eb0418-0bd1-ce19-5fe8-9e42ae659563"],
 ": each history collapses to one pole, the choice fixed only by the noise, \
while the average over histories stays balanced. Watch many histories make \
their choice."
}], "Text",
 CellID->372521314,ExpressionUUID->"2fcc496e-9c46-13ea-55f4-614815f36130"],

Cell[TextData[{
 "Turn off the drive and measure ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "191acd8d-6e98-c427-4f39-e4d70b12af0d"],
 " on a state leaning toward ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2305a976-3107-1e82-513a-413040b264e8"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["z", "TI"], "0"], "=", "0.5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7db30b64-26ac-b1af-2b40-a34e535e03f5"],
 ". With no Hamiltonian, measurement alone drives each run to a ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7eeaae22-94f7-017f-26e9-478c1c825045"],
 " eigenstate, ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09646c1c-8840-439e-3f1b-864629f511e4"],
 " or ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63ab22ce-56be-71a3-11a8-bba8634b4389"],
 ", and the record that drives the collapse is also what reads out which pole \
it chose. Fix the biased start, the measured operator, and a fine grid:"
}], "Text",
 CellID->1020330751,ExpressionUUID->"1cf7fb29-0d40-1e28-448c-f373a4f56572"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"z0Loc", " ", "=", " ", "0.5"}], ";", " ", 
  RowBox[{"x0Loc", " ", "=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"1", " ", "-", " ", 
     RowBox[{"z0Loc", "^", "2"}]}], "]"}]}], ";", " ", 
  RowBox[{"measZ", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "1.5", "]"}], " ", "Z"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dtLoc", " ", "=", " ", "0.002"}], ";", " ", 
  RowBox[{"tfLoc", " ", "=", " ", "2."}], ";", " ", 
  RowBox[{"gridLoc", " ", "=", " ", 
   RowBox[{"dtLoc", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", 
      RowBox[{"Round", "[", 
       RowBox[{"tfLoc", "/", "dtLoc"}], "]"}]}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[196]:= ",
 CellID->339737350,ExpressionUUID->"2d412947-9e62-7904-5b7e-c1211b17486e"],

Cell[TextData[{
 "One run reads the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fd69df2-7b02-a961-15ed-14bc7eb4f84b"],
 " component throughout; run a fan of them, and beside them solve the master \
equation for the record-blind mean:"
}], "Text",
 CellID->967879197,ExpressionUUID->"768fd558-59bf-0a63-1eb4-cd02584a5949"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"locZ", "[", "seed_", "]"}], " ", ":=", " ", 
   RowBox[{"zOf", "@", 
    RowBox[{
     RowBox[{"trajectory", "[", 
      RowBox[{
       RowBox[{"blochState", "[", 
        RowBox[{"x0Loc", ",", " ", "0", ",", " ", "z0Loc"}], "]"}], ",", " ", 
       
       RowBox[{"0", " ", "id2"}], ",", " ", 
       RowBox[{"{", "measZ", "}"}], ",", " ", 
       RowBox[{"{", "1.", "}"}], ",", " ", 
       RowBox[{"{", "}"}], ",", " ", "dtLoc", ",", " ", "tfLoc", ",", " ", 
       "seed"}], "]"}], "[", "\"\<states\>\"", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fanLoc", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"locZ", "[", "s", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "60"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"locMeanRun", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{"0", " ", "id2"}], ",", " ", 
     RowBox[{"{", "measZ", "}"}], ",", " ", 
     RowBox[{"blochState", "[", 
      RowBox[{"x0Loc", ",", " ", "0", ",", " ", "z0Loc"}], "]"}], ",", " ", 
     "tfLoc"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"meanLoc", " ", "=", " ", 
   RowBox[{"zOf", "[", 
    RowBox[{"locMeanRun", " ", "/@", " ", "gridLoc"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[197]:= ",
 CellID->2045221242,ExpressionUUID->"26b5396e-c871-0359-4e4a-b14be90451a3"],

Cell[TextData[{
 "Now visualize the fan against that conserved mean: every displayed path \
approaches a pole while the thick master-equation curve holds flat at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["z", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f77ebf2-aec9-563c-450c-02bfcb7c3d06"],
 ":"
}], "Text",
 CellID->2119433676,ExpressionUUID->"5317ee41-6066-3577-012c-002b11109c5d"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"gridLoc", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], " ", "/@",
       " ", "fanLoc"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"Opacity", "[", "0.12", "]"}]}], "]"}]}]}], "]"}], ",", "\n", 
   " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"gridLoc", ",", " ", "meanLoc"}], "}"}], "]"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}]}], "]"}]}]}], "]"}], ",", "\n", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]\[Sigma]z\[RightAngleBracket]\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<each run approaches a pole; the master-equation mean holds at \
z0\>\""}]}], "]"}]], "Input",
 CellLabel->"In[198]:= ",
 CellID->1666150564,ExpressionUUID->"0454080f-5b74-5a26-2c6b-a2695e01290c"],

Cell[TextData[{
 "By the finite endpoint every displayed run is numerically close to a pole, \
while the thick curve never leaves ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["z", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "200c839f-1e44-fe5c-5033-1ad99bf6c4a6"],
 ": the dephasing ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "573cfa27-29ff-38cf-7ec3-f3814f8b8a15"],
 " leaves the populations untouched, so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bb83578-78e8-07f4-2947-ad22789d6dde"],
 " is conserved on average. In continuous time, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48fc1f1f-3652-ba13-7883-975943e40979"],
 " is a bounded martingale and converges asymptotically to ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3cf3ec-7071-038e-3bc3-eab6010451d4"],
 "; it does not hit a pole at a generic finite time. The limiting split \
follows from martingale convergence (equivalently, optional-stopping \
arguments applied to bounded approximating stopping times): ",
 Cell[BoxData[
  RowBox[{"\|01d53c", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["z", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], "\[Infinity]", 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["z", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44b6a437-3794-76b8-6c4d-3e7142215c82"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], "+"], "-", 
   SubscriptBox[
    StyleBox["p", "TI"], "-"], "=", 
   SubscriptBox[
    StyleBox["z", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e37a26f-afb3-2e6c-67cc-4448ca4674b6"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], "+"], "+", 
   SubscriptBox[
    StyleBox["p", "TI"], "-"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "576120e7-4357-336c-7d1e-b9c176e381b6"],
 " give ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], "\[PlusMinus]"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", 
    SubscriptBox[
     StyleBox["z", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "375ed7c0-a5a4-d638-5d65-ceadcc56bd02"],
 ". Born is a theorem about the limiting martingale, not a fraction the \
finite run count has to fit. The symmetric ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["z", "TI"], "0"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1106a12f-2723-9187-473d-388952d7e3ed"],
 " start, the state the earlier examples called ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", "+", "\[RightAngleBracket]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0df9f048-7a44-7b96-3b86-ea127ff149fc"],
 ", is the equal-weight special case."
}], "Text",
 CellID->664696531,ExpressionUUID->"11feb189-ad07-7b90-4785-28d2c4b249fa"],

Cell[TextData[{
 "The record is what a detector actually delivers, and it both drives the \
collapse and reads it out. Accumulate each run's record into the integrated \
readout ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubsuperscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"]], 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74f078bc-d989-92d9-1c80-71f9d83de023"],
 " and keep the pole it lands on:"
}], "Text",
 CellID->79098559,ExpressionUUID->"587682b0-1dd8-f3c6-080d-1bfa9452c12c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"readOut", "[", "seed_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"run", " ", "=", " ", 
       RowBox[{"trajectory", "[", 
        RowBox[{
         RowBox[{"blochState", "[", 
          RowBox[{"x0Loc", ",", " ", "0", ",", " ", "z0Loc"}], "]"}], ",", 
         " ", 
         RowBox[{"0", " ", "id2"}], ",", " ", 
         RowBox[{"{", "measZ", "}"}], ",", " ", 
         RowBox[{"{", "1.", "}"}], ",", " ", 
         RowBox[{"{", "}"}], ",", " ", "dtLoc", ",", " ", "tfLoc", ",", " ", 
         "seed"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Accumulate", "[", 
          RowBox[{"Flatten", "@", 
           RowBox[{"run", "[", "\"\<record\>\"", "]"}]}], "]"}], ",", " ", 
         "0."}], "]"}], ",", " ", 
       RowBox[{"Sign", "[", 
        RowBox[{"Last", "@", 
         RowBox[{"zOf", "@", 
          RowBox[{"run", "[", "\"\<states\>\"", "]"}]}]}], "]"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"readData", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"readOut", "[", "s", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "400"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[199]:= ",
 CellID->923612531,ExpressionUUID->"252e0451-1a36-40ed-4cd5-9e1b9fc31237"],

Cell["\<\
Now visualize the integrated record, one path per run, colored by the pole \
the run reached: each single increment is almost pure noise, but the \
accumulated record fans into two well-separated groups:\
\>", "Text",
 CellID->725718587,ExpressionUUID->"6b506e1e-f100-9568-196f-805b80baffb2"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"show", " ", "=", " ", 
     RowBox[{"readData", "[", 
      RowBox[{"[", 
       RowBox[{";;", " ", "50"}], "]"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"gridLoc", ",", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "]"}], " ", "&"}], " ", "/@",
       " ", "show"}], ",", "\n", "  ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", ">", " ", "0"}], ",", " ", 
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"ColorData", "[", 
              RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
             RowBox[{"Opacity", "[", "0.45", "]"}]}], "]"}], ",", " ", 
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"ColorData", "[", 
              RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
             RowBox[{"Opacity", "[", "0.45", "]"}]}], "]"}]}], "]"}], " ", 
         "&"}], " ", "/@", " ", "show"}], ")"}]}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", " ", "\"\<integrated record  J(t)\>\""}], 
       "}"}]}], ",", " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<the integrated record splits by the pole each run \
chose\>\""}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[200]:= ",
 CellID->868291647,ExpressionUUID->"45e6cda3-0332-8806-739d-e40db6c4db6c"],

Cell[TextData[{
 "The sign of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10a6fcee-2410-cb5f-405d-f5c84daa99a5"],
 " is the readout's verdict on the eigenstate; measure how often it is right \
as the integration window grows:"
}], "Text",
 CellID->986753062,ExpressionUUID->"20b3c3fd-ce47-45e5-5040-daa6ebf22fcf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fidLoc", "[", "T_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"iT", " ", "=", " ", 
       RowBox[{
        RowBox[{"Round", "[", 
         RowBox[{"T", "/", "dtLoc"}], "]"}], " ", "+", " ", "1"}]}], "}"}], ",",
      " ", 
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Boole", "[", 
         RowBox[{
          RowBox[{"Sign", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", "iT"}], "]"}], "]"}], "]"}], " ", "==", 
          " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "&"}], " ", "/@", 
       " ", "readData"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"T", ",", " ", 
       RowBox[{"fidLoc", "[", "T", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"T", ",", " ", "0.05", ",", " ", "tfLoc", ",", " ", "0.05"}], 
      "}"}]}], "]"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0.45", ",", " ", "1.02"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "500"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<integration time T\>\"", ",", 
      " ", "\"\<assignment fidelity\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<longer integration reads the eigenstate out with \
certainty\>\""}]}], "]"}]}], "Input",
 CellLabel->"In[201]:= ",
 CellID->1712489022,ExpressionUUID->"0dd5773b-5215-a52c-3beb-6f6567a10c76"],

Cell[TextData[{
 "For these 400 seeded runs the empirical fidelity reaches one by the \
displayed endpoint. That is a finite-sample observation, not a finite-time \
certainty: at any fixed duration a Gaussian-noise record retains a nonzero \
error probability, while the assignment error tends to zero asymptotically as \
more record accumulates. Two things keep this honest rather than a lookup. \
The limiting eigenstate is not fixed in advance; it is selected by the same \
record used to infer it. And the flat-weight integral ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7da02f1b-35d4-9174-2b5f-c745bc66e05e"],
 " is not the sharpest estimator: the conditional ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1be4ea81-18b8-2b05-499b-03eb994d766f"],
 " of the fan above is the Bayesian-optimal filter, which a uniform integral \
only approximates. This trajectory-read-from-its-own-record is what ",
 ButtonBox["Murch, Weber, Macklin, and Siddiqi",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/1305.7270"], None}],
 " tracked on a superconducting qubit, reconstructing the conditioned state \
from the readout and confirming it by tomography."
}], "Text",
 CellID->1130883020,ExpressionUUID->"2bec375e-30ea-24bd-5993-af18409c8e87"],

Cell["Quantum Kalman Filter: Tracking an Oscillator", "Subsection",
 CellID->826918846,ExpressionUUID->"7dcf5242-c9ff-a686-2bf5-542fef8b0cec"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Continuously measure the position of a harmonic oscillator; a Gaussian \
state stays Gaussian and the stochastic master equation collapses to a \
quantum Kalman-Bucy filter. The conditional covariance ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52da685f-2498-05f2-02f9-82194d2d6fd8"],
 " obeys a ",
 StyleBox["deterministic", "TI"],
 " matrix Riccati equation, independent of the record,"
}], "Text",
 CellID->1119720649,ExpressionUUID->"12aa8adb-4d50-9545-42a9-238564eaffaf"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox["\[CapitalSigma]", "."], "=", 
    StyleBox["A", "TI"], "\[CapitalSigma]", "+", "\[CapitalSigma]", 
    SuperscriptBox[
     StyleBox["A", "TI"], 
     StyleBox["T", "TI"]], "+", 
    StyleBox["D", "TI"], "-", "\[CapitalSigma]", "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["T", "TI"]], 
    StyleBox["C", "TI"], "\[ThinSpace]", "\[CapitalSigma]"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->747338226,ExpressionUUID->"6bddd79b-6823-400d-19e2-cec509d61357"],

Cell["\<\
with the free-rotation drift, the position readout, and the measurement \
back-action\
\>", "Text",
 CellID->1214057513,ExpressionUUID->"0292d5cf-fba4-5fb5-32a1-cca8fe51259f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["A", "TI"], "=", "(", GridBox[{
      {"0", "1"},
      {
       RowBox[{"-", "1"}], "0"}
     }], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["C", "TI"], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"2", 
         SqrtBox[
          StyleBox["k", "TI"]]}], "0"}
      }], ")"}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["D", "TI"], "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {"0", "0"},
        {"0", 
         StyleBox["k", "TI"]}
       }], ")"}], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1068045466,ExpressionUUID->"315a5c02-c518-37e9-677a-566fec929d33"],

Cell[TextData[{
 "In the three independent entries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xx",
      FontSlant->"Plain"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xp",
      FontSlant->"Plain"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["pp",
      FontSlant->"Plain"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "601c6277-b8fa-6d82-1023-8431388f37e8"],
 " of ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "056e5c3e-0591-d839-3316-5678ac25ab03"],
 " this reads"
}], "Text",
 CellID->207361811,ExpressionUUID->"7362f573-955d-4629-2111-ed3d1ce82d73"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    FractionBox[
     StyleBox["d", "TI"], 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]], "(", GridBox[{
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["xx",
         FontSlant->"Plain"]]},
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["xp",
         FontSlant->"Plain"]]},
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["pp",
         FontSlant->"Plain"]]}
     }], ")", "=", "(", GridBox[{
      {
       RowBox[{"2", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xp",
          FontSlant->"Plain"]], "-", "4", 
        StyleBox["k", "TI"], "\[ThinSpace]", 
        SubsuperscriptBox["\[CapitalSigma]", 
         StyleBox["xx",
          FontSlant->"Plain"], "2"]}]},
      {
       RowBox[{
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["pp",
          FontSlant->"Plain"]], "-", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xx",
          FontSlant->"Plain"]], "-", "4", 
        StyleBox["k", "TI"], "\[ThinSpace]", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xx",
          FontSlant->"Plain"]], 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xp",
          FontSlant->"Plain"]]}]},
      {
       RowBox[{
        StyleBox["k", "TI"], "-", "2", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xp",
          FontSlant->"Plain"]], "-", "4", 
        StyleBox["k", "TI"], "\[ThinSpace]", 
        SubsuperscriptBox["\[CapitalSigma]", 
         StyleBox["xp",
          FontSlant->"Plain"], "2"]}]}
     }], ")"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->483818264,ExpressionUUID->"1d4a449b-9aea-2b01-4b4a-5dc51e9f766b"],

Cell[TextData[{
 "the quadratic ",
 Cell[BoxData[
  RowBox[{"-", "4", 
   StyleBox["k", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "\[CenterEllipsis]", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "693f6746-f6ea-213d-18c5-7f23829f7007"],
 " terms being the information gain ",
 Cell[BoxData[
  RowBox[{"-", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["T", "TI"]], 
   StyleBox["C", "TI"], "\[CapitalSigma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58bbc0e4-f422-75b6-0858-d9c1fdd75f9c"],
 ", which is what makes this a Riccati and not a linear Lyapunov equation. \
Balanced against the back-action (",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["D", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "512ebd8c-9517-4b4e-00d5-34d61ca21994"],
 "), that gain relaxes the uncertainty to a steady value fixed only by how \
hard you watch, squeezing it below the oscillator's own quietest spread; the \
running best-guess then follows a linear equation driven by the record. Track \
the shrinking uncertainty and check its standstill."
}], "Text",
 CellID->625240499,ExpressionUUID->"38255ff6-675c-bc9f-69db-56b012ee06e5"],

Cell[TextData[{
 "Continuously measure the position of a harmonic oscillator and you can \
track it with a Gaussian estimate: a conditional mean and covariance. The \
covariance obeys a ",
 StyleBox["deterministic", "TI"],
 " Riccati equation, independent of the record, set only by the measurement \
strength. It is the warm particle's covariance law from Part Three, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox["\[CapitalSigma]", "."], "=", 
   StyleBox["A", "TI"], "\[CapitalSigma]", "+", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["T", "TI"]], "+", 
   StyleBox["D", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0868aa04-f8be-0db7-3817-4c61f94b579d"],
 ", now carrying the measurement's information gain ",
 Cell[BoxData[
  RowBox[{"-", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["T", "TI"]], 
   StyleBox["C", "TI"], "\[CapitalSigma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0889c062-717f-f29f-38b6-da4c000bc0e5"],
 ": diffusion widened that blob to thermal, watching squeezes this one below \
the ground state. Set the strength and integrate the Riccati equations from a \
broad start:"
}], "Text",
 CellID->1892872133,ExpressionUUID->"5f19c016-97c3-092d-0526-da5022765877"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kKal", " ", "=", " ", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"riccati", " ", "=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"vx", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"vc", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"4", " ", "kKal", " ", 
          RowBox[{
           RowBox[{"vx", "[", "t", "]"}], "^", "2"}]}]}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"vc", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"vp", "[", "t", "]"}], " ", "-", " ", 
         RowBox[{"vx", "[", "t", "]"}], " ", "-", " ", 
         RowBox[{"4", " ", "kKal", " ", 
          RowBox[{"vx", "[", "t", "]"}], " ", 
          RowBox[{"vc", "[", "t", "]"}]}]}]}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"vp", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{"vc", "[", "t", "]"}]}], " ", "+", " ", "kKal", " ", "-", 
         " ", 
         RowBox[{"4", " ", "kKal", " ", 
          RowBox[{
           RowBox[{"vc", "[", "t", "]"}], "^", "2"}]}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"vx", "[", "0", "]"}], " ", "==", " ", "3."}], ",", " ", 
       RowBox[{
        RowBox[{"vc", "[", "0", "]"}], " ", "==", " ", "0."}], ",", " ", 
       RowBox[{
        RowBox[{"vp", "[", "0", "]"}], " ", "==", " ", "3."}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"vx", ",", " ", "vc", ",", " ", "vp"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "12"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[202]:= ",
 CellID->84806595,ExpressionUUID->"1c809b18-7d36-d224-44bf-134274c0a10e"],

Cell["A reader for the covariance matrix:", "Text",
 CellID->921906943,ExpressionUUID->"7167cc0d-03c8-d238-271c-e657b662a102"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"covariance", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"riccati", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"riccati", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", "t", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"riccati", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"riccati", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}]}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[203]:= ",
 CellID->1795442623,ExpressionUUID->"324c55d1-ee3a-374b-6274-4c9a8bcc9d91"],

Cell["Compare the position variance at the start and at the end:", "Text",
 CellID->1276871254,ExpressionUUID->"4495e7b4-eb19-1195-6caa-fef18eac63ff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"riccati", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "0", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"riccati", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "12", "]"}]}], "}"}]], "Input",
 CellLabel->"In[204]:= ",
 CellID->649937590,ExpressionUUID->"561855fc-8d4a-f767-7e38-4ca624fcda4d"],

Cell["\<\
The position variance has shrunk from its broad start below the ground-state \
variance of one half: continuous measurement conditionally squeezes it below \
the zero-point level. Two checks. First, the conditional state is pure, its \
uncertainty product at the Heisenberg floor:\
\>", "Text",
 CellID->1170948616,ExpressionUUID->"6cc16cd1-dd21-1c76-14fe-859ad4d4675c"],

Cell[BoxData[
 RowBox[{"Det", "@", 
  RowBox[{"covariance", "[", "12.", "]"}]}]], "Input",
 CellLabel->"In[205]:= ",
 CellID->1271585103,ExpressionUUID->"30881872-2ed2-344c-60b7-923c4b649e96"],

Cell["\<\
The determinant is within the ODE tolerance of the Heisenberg floor; the \
continuum conditional state is pure, and the numerical solution converges \
toward that value. Second, the steady covariance is independently the fixed \
point of the Riccati equation:\
\>", "Text",
 CellID->1586088935,ExpressionUUID->"06a6bc82-b4ed-9511-2e5d-35ec3c99fc7b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"N", "[", 
    RowBox[{"vx", " ", "/.", " ", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"2", " ", "vc"}], " ", "-", " ", 
            RowBox[{"4", " ", "kKal", " ", 
             RowBox[{"vx", "^", "2"}]}]}], " ", "==", " ", "0"}], ",", " ", 
          RowBox[{
           RowBox[{"vp", " ", "-", " ", "vx", " ", "-", " ", 
            RowBox[{"4", " ", "kKal", " ", "vx", " ", "vc"}]}], " ", "==", 
           " ", "0"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"-", "2"}], " ", "vc"}], " ", "+", " ", "kKal", " ", "-",
             " ", 
            RowBox[{"4", " ", "kKal", " ", 
             RowBox[{"vc", "^", "2"}]}]}], " ", "==", " ", "0"}], ",", " ", 
          RowBox[{"vx", " ", ">", " ", "0"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"vx", ",", " ", "vc", ",", " ", "vp"}], "}"}], ",", " ", 
        "Reals"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"riccati", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "12.", "]"}]}], "}"}]], "Input",
 CellLabel->"In[206]:= ",
 CellID->2147327530,ExpressionUUID->"15240c0a-58c5-65f1-3cdb-a65459704fdb"],

Cell["The fixed point matches the late value.", "Text",
 CellID->1186224664,ExpressionUUID->"6874cd6b-f967-cd5b-180b-e534f81397a1"],

Cell[TextData[{
 "That fixed point has a clean closed form. With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", 
   SqrtBox[
    RowBox[{"1", "+", "4", 
     SuperscriptBox[
      StyleBox["k", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16aea7ca-f02c-8fa8-3e55-3e9781ded5f2"],
 ","
}], "Text",
 CellID->618395345,ExpressionUUID->"68bcb404-3168-9397-1843-2e6e4002e1fd"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xx",
      FontSlant->"Plain"]], "=", 
    FractionBox["1", 
     SqrtBox[
      RowBox[{"2", 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "+", 
        StyleBox["s", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}]]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xp",
      FontSlant->"Plain"]], "=", 
    FractionBox[
     RowBox[{
      StyleBox["s", "TI"], "-", "1"}], 
     RowBox[{"4", 
      StyleBox["k", "TI"]}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["pp",
      FontSlant->"Plain"]], "=", 
    RowBox[{
     StyleBox["s", "TI"], "\[ThinSpace]", 
     SubscriptBox["\[CapitalSigma]", 
      StyleBox["xx",
       FontSlant->"Plain"]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->309927853,ExpressionUUID->"3074fef3-0190-9aee-600b-f7bdb02ae834"],

Cell[TextData[{
 "and it sits exactly on the Heisenberg floor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalSigma]", "=", "1", "/", 
   "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5132409c-0c71-a3d8-00c2-59c6a505f122"],
 " for every measurement strength. Put the closed form beside the numerical \
fixed point:"
}], "Text",
 CellID->918875187,ExpressionUUID->"65312e6e-5674-5434-0cce-c04863013f1e"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"4", " ", 
        RowBox[{"kKal", "^", "2"}]}]}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "+", " ", "s"}], ")"}]}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"s", " ", "-", " ", "1"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"4", " ", "kKal"}], ")"}]}], ",", " ", 
       RowBox[{"s", "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "+", " ", "s"}], ")"}]}], "]"}]}]}], "}"}], ",", 
     " ", 
     RowBox[{"Through", "[", 
      RowBox[{"riccati", "[", "12.", "]"}], "]"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[207]:= ",
 CellID->39213332,ExpressionUUID->"0235daed-fad3-6b5f-33ca-d3b6ff6639a5"],

Cell[TextData[{
 "The two rows agree: position is conditionally squeezed below one half, \
momentum broadens to hold the product at the floor, and the tilt ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["xp",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c9f7e12-83c1-89ed-64a5-705c3675db37"],
 " carries the correlation the measurement builds. The conditional state is \
pure at any watching strength, not only the one plotted."
}], "Text",
 CellID->2105127725,ExpressionUUID->"505aa7d0-1afc-86f2-0079-3e9a9e8eecd8"],

Cell[TextData[{
 "The conditional state is Gaussian, so picture it as a one-sigma ellipse: \
the covariance ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5143f96d-83a3-6ed2-0770-f13736563438"],
 " around a center ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e0ac860-85ff-08e4-2609-e24a338a5ace"],
 " traces ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["c", "TI"], "+", 
    SuperscriptBox["\[CapitalSigma]", 
     RowBox[{"1", "/", "2"}]], "{", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["s", "TI"]}], ",", 
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["s", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c4a7891-0723-3e0d-544a-71dbb2d78557"],
 " as ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "567bfdcc-56c6-5358-7e18-f496637321a2"],
 " runs the circle. Define it:"
}], "Text",
 CellID->237912175,ExpressionUUID->"0b371d01-a041-5dbe-3acc-956ad1f42784"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"covarianceEllipse", "[", 
    RowBox[{"c_", ",", " ", "\[CapitalSigma]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"c", " ", "+", " ", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{"\[CapitalSigma]", ",", " ", 
          RowBox[{"1", "/", "2"}]}], "]"}], "]"}], " ", ".", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "s", "]"}], ",", " ", 
         RowBox[{"Sin", "[", "s", "]"}]}], "}"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "0", ",", " ", 
       RowBox[{"2", " ", "Pi"}], ",", " ", "0.12"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[208]:= ",
 CellID->1518115677,ExpressionUUID->"09dcd030-ee58-59fb-3fe3-ca7d8bed2bc1"],

Cell["\<\
Now visualize the covariance ellipse over time, broad at first and then \
tightening and tilting to a small steady one:\
\>", "Text",
 CellID->625578070,ExpressionUUID->"3eb66b53-0a81-4482-664d-831daf342ee8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"trackTimes", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0", ",", " ", "0.1", ",", " ", "0.25", ",", " ", "0.5", ",", " ", "1", ",",
      " ", "2", ",", " ", "4", ",", " ", "8", ",", " ", "12"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Thick", ",", " ", 
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"ColorData", "[", "\"\<SunsetColors\>\"", "]"}], "[", 
             RowBox[{
              RowBox[{"First", "[", "#2", "]"}], "/", 
              RowBox[{"Length", "[", "trackTimes", "]"}]}], "]"}], ",", " ", 
            RowBox[{"Line", "@", 
             RowBox[{"covarianceEllipse", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
               RowBox[{"covariance", "[", "#1", "]"}]}], "]"}]}]}], "}"}], 
          " ", "&"}], ",", " ", "trackTimes"}], "]"}]}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "400"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<position\>\"", ",", " ", "\"\<momentum\>\""}], "}"}]}], ",",
      "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<measurement shrinks the covariance to a tight, tilted, steady \
one\>\""}]}], "]"}], ",", "\n", " ", 
   RowBox[{"SwatchLegend", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ColorData", "[", "\"\<SunsetColors\>\"", "]"}], "[", 
        RowBox[{"#", "/", 
         RowBox[{"Length", "[", "trackTimes", "]"}]}], "]"}], " ", "&"}], " ",
       "/@", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "trackTimes", "]"}], "]"}]}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<t = \>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
      "trackTimes"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[209]:= ",
 CellID->1195176726,ExpressionUUID->"4513a2b6-5679-71cc-7320-3bf0630c4316"],

Cell["\<\
This conditional estimate is exactly what a lab computes in real time to \
track a trapped particle or membrane, more precisely than its own zero-point \
spread.\
\>", "Text",
 CellID->394282870,ExpressionUUID->"0a5000e8-62c3-6dca-3a6f-99b217763710"],

Cell[TextData[{
 "The covariance is only half the filter. It says how sharp the estimate is; \
the other half is the estimate itself, the conditional ",
 StyleBox["mean", "TI"],
 ", threading through the noisy record in real time. Watch the filter track. \
Set a fine grid and draw one record's worth of Wiener increments:"
}], "Text",
 CellID->1396453116,ExpressionUUID->"72376a19-67f8-2d8a-23cc-8c43118d77d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kalDt", " ", "=", " ", "0.004"}], ";", " ", 
  RowBox[{"kalN", " ", "=", " ", "1500"}], ";", " ", 
  RowBox[{"kalGrid", " ", "=", " ", 
   RowBox[{"kalDt", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "kalN"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kalDW", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"Sqrt", "[", "kalDt", "]"}]}], "]"}], ",", " ", "kalN"}], 
      "]"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[210]:= ",
 CellID->882685893,ExpressionUUID->"6261e651-652e-b57b-121e-f81b0cd81c41"],

Cell[TextData[{
 "A note on the constant ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02289828-dcb6-ed3d-33d7-1275d540b407"],
 ". In the catalog's measurement-strength convention the monitored leak is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["x", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e4925e4-2eb0-6ad8-2676-bcce4b453822"],
 ", so the informative terms carry ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f48fd62-d18c-e56b-6577-f54fe03ecfb1"],
 " and the mean gain is ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   StyleBox["V", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09732abd-5fe3-4802-3f00-c3e759961b68"],
 "; the record noise and the gain must then be consistent, which pins the \
record normalization below. What the code calls a \"reference conditional \
mean\" is the physical conditional mean of one simulated record, driven by \
its own innovation ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ab4141e-cc6c-4672-1a4b-8e5be5192d58"],
 " with that gain. Roll it out from a displaced start:"
}], "Text",
 CellID->1562244888,ExpressionUUID->"0f1d8418-8fb4-2aea-3522-1e422a417830"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kalTrue", " ", "=", " ", 
   RowBox[{"FoldList", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xp", ",", " ", "jw"}], "}"}], ",", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"j", " ", "=", " ", 
            RowBox[{"jw", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
           RowBox[{"dw", " ", "=", " ", 
            RowBox[{"jw", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"xp", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"xp", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", "kalDt"}], " ", "+", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
             RowBox[{
              RowBox[{"riccati", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"kalGrid", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "dw"}]}], ",", 
           "\n", "      ", 
           RowBox[{
            RowBox[{"xp", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"xp", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "kalDt"}], " ", "+", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
             RowBox[{
              RowBox[{"riccati", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "[", 
              RowBox[{"kalGrid", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "dw"}]}]}], 
          "}"}]}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"3.", ",", " ", "0."}], "}"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", "kalN", "]"}], ",", " ", "kalDW"}], "}"}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[211]:= ",
 CellID->2118942829,ExpressionUUID->"7b1b0b32-6c87-d322-2938-a37c0533be08"],

Cell[TextData[{
 "All the observer ever sees is the record, the signal ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b382293-4179-aaf9-3ac7-bbdd700df8c3"],
 " buried in white noise. Consistency with the ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e8da17c-ff26-3788-56b2-3939fad09dd2"],
 "-Riccati and the ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3669af04-3982-74bb-5e16-476eb8375e81"],
 " gain fixes its noise level at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["y", "TI"], "=", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SqrtBox[
     StyleBox["k", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28fe05af-1890-3d45-5885-9c09992a87af"],
 ":"
}], "Text",
 CellID->1388287869,ExpressionUUID->"01001107-76e3-9dfc-373f-89610297e7c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kalRec", " ", "=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#1", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "kalDt"}], " ", "+", " ", 
       RowBox[{"#2", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"Sqrt", "[", "kKal", "]"}]}], ")"}]}]}], " ", "&"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Most", "@", "kalTrue"}], ",", " ", "kalDW"}], "}"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[212]:= ",
 CellID->1303133385,ExpressionUUID->"524d5b64-939d-9e2e-0273-534e2629e574"],

Cell[TextData[{
 "Now the filter. Start it from a deliberately ",
 StyleBox["wrong", "TI"],
 " guess for the position and feed it only the record: at each step it forms \
its own innovation, the record minus its own prediction, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   OverscriptBox[
    StyleBox["W", "TI"], "^"], "=", "2", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["y", "TI"], "-", 
    OverscriptBox[
     StyleBox["x", "TI"], "_"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bbb36c0-925a-ccd2-6958-afaa27ec9638"],
 ", and corrects the estimate with the Riccati gain,"
}], "Text",
 CellID->1083493527,ExpressionUUID->"1a695b16-67b9-69b9-4a17-5350124c3b83"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    OverscriptBox[
     StyleBox["x", "TI"], "_"], "=", 
    OverscriptBox[
     StyleBox["p", "TI"], "_"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "2", 
    SqrtBox[
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xx",
      FontSlant->"Plain"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    OverscriptBox[
     StyleBox["W", "TI"], "^"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     OverscriptBox[
      StyleBox["p", "TI"], "_"]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       OverscriptBox[
        StyleBox["x", "TI"], "_"]}], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{"2", 
      SqrtBox[
       StyleBox["k", "TI"]], "\[ThinSpace]", 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["xp",
        FontSlant->"Plain"]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      OverscriptBox[
       StyleBox["W", "TI"], "^"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->43887772,ExpressionUUID->"0deaf6de-bcac-37fa-3be9-ef98355e9dc0"],

Cell[TextData[{
 "the deterministic Riccati covariance ",
 Cell[BoxData[
  RowBox[{"\[CapitalSigma]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a9276f6-63cd-444b-2aa2-6fb016782e91"],
 " setting the gain:"
}], "Text",
 CellID->2123394380,ExpressionUUID->"286ae68d-79c0-1125-5869-ffd77875600f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kalFilt", " ", "=", " ", 
   RowBox[{"FoldList", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xp", ",", " ", "jdy"}], "}"}], ",", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"j", " ", "=", " ", 
            RowBox[{"jdy", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
           RowBox[{"dwf", " ", "=", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"jdy", "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
               RowBox[{
                RowBox[{"xp", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "kalDt"}]}], 
              ")"}]}]}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"xp", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"xp", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", "kalDt"}], " ", "+", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
             RowBox[{
              RowBox[{"riccati", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"kalGrid", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "dwf"}]}], ",", 
           "\n", "      ", 
           RowBox[{
            RowBox[{"xp", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"xp", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "kalDt"}], " ", "+", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
             RowBox[{
              RowBox[{"riccati", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "[", 
              RowBox[{"kalGrid", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "dwf"}]}]}], 
          "}"}]}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "3."}], ",", " ", "0."}], "}"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", "kalN", "]"}], ",", " ", "kalRec"}], "}"}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[213]:= ",
 CellID->705610480,ExpressionUUID->"0e79da95-910a-a6b5-3606-d3df20bc0c9f"],

Cell[TextData[{
 "Read the ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1", 
   StyleBox["\[Sigma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09d777b6-b63f-ed25-3fed-6ef3c3cbb40f"],
 " band off the covariance:"
}], "Text",
 CellID->1139416472,ExpressionUUID->"2768433a-cec7-30dc-4d68-5b67eb738226"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kalBand", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"riccati", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", "#", "]"}], "]"}], " ", "&"}], 
    " ", "/@", " ", "kalGrid"}]}], ";"}]], "Input",
 CellLabel->"In[214]:= ",
 CellID->432212328,ExpressionUUID->"6f776597-6eed-bc41-150d-7cd10a9906ab"],

Cell[TextData[{
 "Now visualize the tracking: the reference conditional mean and the estimate \
from the incorrect prior. The deliberately wrong initial estimate is outside \
its own ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1", 
   StyleBox["\[Sigma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37f31662-30b3-53e3-5d80-884c414621c9"],
 " band; the band quantifies conditional covariance under the assumed filter \
model, not uncertainty over an arbitrarily misspecified initial mean. The \
record then pulls the estimate toward the reference path:"
}], "Text",
 CellID->1877047781,ExpressionUUID->"0465595f-3759-9855-2c1b-511942edeabf"],

Cell[BoxData[
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Show", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
