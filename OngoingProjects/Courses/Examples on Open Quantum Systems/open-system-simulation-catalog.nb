       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Delta]", "TI"], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], "+"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1], 
       StyleBox["\[Delta]", "TI"], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], "-"], 
       StyleBox["(",
        SpanMaxSize->1], "0", 
       StyleBox[")",
        SpanMaxSize->1]}], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox[
      RowBox[{"s", "s"}], "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->623836386,ExpressionUUID->"3e73fafe-05d0-7203-6600-f3b8ac654169"],

Cell["Part One: Systems We Can Solve Symbolically", "Section",
 CellID->564394165,ExpressionUUID->"7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],

Cell[TextData[{
 "The first two systems have exact closed-form answers we can check against \
the code. Both are qubits, so first a convenience: read the master equation \
as three ",
 StyleBox["Bloch equations",
  FontWeight->"Bold"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "."], ",", 
    OverscriptBox[
     StyleBox["y", "TI"], "."], ",", 
    OverscriptBox[
     StyleBox["z", "TI"], "."]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c044c4-b778-74e1-42f0-5da1c20d5ecb"],
 ". Write the general Bloch state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\|01d7d9", "+", 
    StyleBox["x", "TI"], 
    StyleBox["X", "TI"], "+", 
    StyleBox["y", "TI"], 
    StyleBox["Y", "TI"], "+", 
    StyleBox["z", "TI"], 
    StyleBox["Z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d9aa029-60a8-273a-6bb9-3a7311428a00"],
 ":"
}], "Text",
 CellID->2048244887,ExpressionUUID->"64adc082-4122-deff-0c52-d9ec70d4a4c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"blochState", "[", 
    RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"id2", " ", "+", " ", 
      RowBox[{"x", " ", "X"}], " ", "+", " ", 
      RowBox[{"y", " ", "Y"}], " ", "+", " ", 
      RowBox[{"z", " ", "Z"}]}], ")"}], "/", "2"}]}], ";"}]], "Input",
 CellLabel->"In[43]:= ",
 CellID->1432457359,ExpressionUUID->"7e451771-8a55-ceec-267a-8f3b2fe19436"],

Cell["\<\
Feed it to the Lindbladian and extract each component's rate:\
\>", "Text",
 CellID->200346680,ExpressionUUID->"4670f053-f537-0b3f-6e0f-ea1cfcc25605"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rates", "[", 
    RowBox[{"H_", ",", " ", "leaks_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"ComplexExpand", "@", 
    RowBox[{"Table", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"d", " ", ".", " ", 
        RowBox[{"lindbladian", "[", 
         RowBox[{"H", ",", " ", "leaks", ",", " ", 
          RowBox[{"blochState", "[", 
           RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}]}], "]"}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"d", ",", " ", 
        RowBox[{"{", 
         RowBox[{"X", ",", " ", "Y", ",", " ", "Z"}], "}"}]}], "}"}]}], 
     "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[44]:= ",
 CellID->447384324,ExpressionUUID->"330aabc0-bdd5-22a3-6109-42aa34607089"],

Cell["Pure Dephasing", "Subsection",
 CellID->1438124241,ExpressionUUID->"38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A two-level system dephased along ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d705b8-410a-1477-20ec-9ce270bf7f5d"],
 ", with no Hamiltonian:"
}], "Text",
 CellID->2000382747,ExpressionUUID->"737c509e-bc52-eefb-2104-49d835e4b4c1"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", 
    StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->902867877,ExpressionUUID->"01a44b6b-c85f-9e0e-375c-6334e9ebe554"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"], "\[Dagger]"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],
 " this is pure dephasing, so in Bloch components ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "."], "=", "-", "2", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25120901-cfbc-a8e6-5321-a16aea4efacc"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["y", "TI"], "."], "=", "-", "2", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ee7491f-72c3-8814-669d-61590777db7e"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["z", "TI"], "."], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67860241-8011-89c8-0dbd-a42b31a5db12"],
 ", giving ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["x", "TI"], "0"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "2", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1318f44b-7a0d-b86f-4127-ee157fb90ab5"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["y", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["y", "TI"], "0"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "2", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "221ecbfd-1ed7-d323-5225-e2a79b63be09"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["z", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f067a83-888f-4db3-653e-73ed293a1799"],
 ". Both poles ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "=", "\[PlusMinus]", "1"}], 
   "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "287fc527-5526-9e30-5804-dc815cd0e51a"],
 " (the ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2207e002-80f7-0285-523c-fa6c308250ef"],
 " eigenstates ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["e", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "440467ae-8db5-79b4-6c3c-7e0824404b9e"],
 " and ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["g", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141585f4-d1c1-5bbd-3c2a-1cb1e0742987"],
 ", not to be confused with the ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d27d006-86b8-9131-64dc-ca603332e01b"],
 " eigenstate the code calls ",
 Cell[BoxData["plus"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e44340b-ef5c-51d5-667b-ae548ae9233f"],
 ") are fixed points, so there is no unique steady state: any mixture ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]], "=", 
   SubscriptBox[
    StyleBox["p", "TI"], "+"], "\[LeftBracketingBar]", 
   StyleBox["e", "TI"], "\[RightAngleBracket]", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[LeftBracketingBar]", 
      StyleBox["e", "TI"], "\[RightAngleBracket]"}], 
     StyleBox[")",
      SpanMaxSize->1]}], "\[Dagger]"], "+", 
   SubscriptBox[
    StyleBox["p", "TI"], "-"], "\[LeftBracketingBar]", 
   StyleBox["g", "TI"], "\[RightAngleBracket]", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[LeftBracketingBar]", 
      StyleBox["g", "TI"], "\[RightAngleBracket]"}], 
     StyleBox[")",
      SpanMaxSize->1]}], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "321034f4-436e-dcec-622f-adbe7618a636"],
 " sits still forever."
}], "Text",
 CellID->1315202099,ExpressionUUID->"1287d3f9-6500-de4e-42bc-caa30cbaa494"],

Cell[TextData[{
 "Pure dephasing continuously measures ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],
 ": it damps the transverse coherences and leaves the populations fixed. \
Turning off the Hamiltonian and with one dissipator, then the Bloch equations \
read as:"
}], "Text",
 CellID->376763343,ExpressionUUID->"087f5f2f-6486-1b59-3805-56890d3369a3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "\[Gamma]", "]"}], ";", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"rates", "[", 
     RowBox[{
      RowBox[{"0", " ", "id2"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "Z"}], "}"}]}], "]"}], ",",
     " ", 
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]}]], "Input",
 CellLabel->"In[45]:= ",
 CellID->126027414,ExpressionUUID->"7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],

Cell[TextData[{
 "The transverse components ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], ",", 
   StyleBox["y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],
 " decay at rate ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13ecd9ee-6506-67bb-4193-d0c80cb34d81"],
 "; ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6724c974-bdf1-27a5-0edb-e13e3b858d8f"],
 " is fixed. Hand those rates, exactly as the Lindbladian produced them, to \
the differential-equation solver as the Bloch equations, and solve from any \
initial Bloch vector:"
}], "Text",
 CellID->570920987,ExpressionUUID->"2b52875c-0948-9ae8-5961-1f06a8e2e832"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "x", ",", " ", "y", ",", " ", "z", ",", " ", "t", ",", " ", "x0", ",", " ",
     "y0", ",", " ", "z0"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"closedDephasing", "[", "t_", "]"}], " ", "=", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], ",", " ", 
     RowBox[{"y", "[", "t", "]"}], ",", " ", 
     RowBox[{"z", "[", "t", "]"}]}], "}"}], " ", "/.", " ", 
   RowBox[{"First", "@", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"Join", "[", "\n", "     ", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"x", "'"}], "[", "t", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"y", "'"}], "[", "t", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"z", "'"}], "[", "t", "]"}]}], "}"}], " ", "==", "\n", 
          "       ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Simplify", "[", 
             RowBox[{
              RowBox[{"rates", "[", 
               RowBox[{
                RowBox[{"0", " ", "id2"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "Z"}], "}"}]}],
                "]"}], ",", " ", 
              RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}], " ", "/.", 
            " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x", " ", "->", " ", 
               RowBox[{"x", "[", "t", "]"}]}], ",", " ", 
              RowBox[{"y", " ", "->", " ", 
               RowBox[{"y", "[", "t", "]"}]}], ",", " ", 
              RowBox[{"z", " ", "->", " ", 
               RowBox[{"z", "[", "t", "]"}]}]}], "}"}]}], ")"}]}], "]"}], ",",
         "\n", "     ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", "0", "]"}], " ", "==", " ", "x0"}], ",", " ", 
          RowBox[{
           RowBox[{"y", "[", "0", "]"}], " ", "==", " ", "y0"}], ",", " ", 
          RowBox[{
           RowBox[{"z", "[", "0", "]"}], " ", "==", " ", "z0"}]}], "}"}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", "t"}], 
     "]"}]}]}]}]}], "Input",
 CellLabel->"In[46]:= ",
 CellID->378517449,ExpressionUUID->"53412643-5a68-df00-017e-b82d5f02a26a"],

Cell[TextData[{
 "The transverse components decay exponentially, ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "696f5b1d-d56b-3a26-1f15-5346dc1f890c"],
 " is frozen. Check the closed form against numerical results from the master \
equation over time:"
}], "Text",
 CellID->1671903560,ExpressionUUID->"0eb02373-2484-618c-364f-bb3d4d3133d6"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"gg", " ", "=", " ", "0.5"}], ",", " ", 
     RowBox[{"a0", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"0.8", ",", " ", "0.4", ",", " ", "0.3"}], "}"}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"Max", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"closedDephasing", "[", "tt", "]"}], " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
            RowBox[{"x0", " ", "->", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
            RowBox[{"y0", " ", "->", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
            RowBox[{"z0", " ", "->", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], ")"}], " ", "-", 
        "\n", "    ", 
        RowBox[{"blochVector", "[", 
         RowBox[{"evolve", "[", 
          RowBox[{
           RowBox[{"0", " ", "id2"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sqrt", "[", "gg", "]"}], " ", "Z"}], "}"}], ",", " ", 
           RowBox[{"blochState", " ", "@@", " ", "a0"}], ",", " ", "tt"}], 
          "]"}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"tt", ",", " ", "0", ",", " ", "3", ",", " ", "0.3"}], "}"}]}],
      "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[47]:= ",
 CellID->1307059254,ExpressionUUID->"640353f1-ff8e-e9b3-0c31-4abafa38bb99"],

Cell["The maximum discrepancy is at numerical solver precision.", "Text",
 CellID->538512558,ExpressionUUID->"37161f66-4600-a3a8-5d2d-974073baf1f2"],

Cell[TextData[{
 "Because ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e44757e-c407-f813-567c-6d3bedb3cb79"],
 " never changes, there is no unique steady state: any mixture of ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["e", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"],
 " and ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["g", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539b0e4e-9e5a-5525-01b8-a0281bef3c0f"],
 " is stationary. The Hermitian stationary-operator basis is \
two-dimensional:"
}], "Text",
 CellID->824717693,ExpressionUUID->"1cd82739-42e3-b7ed-44e7-bf6376971d37"],

Cell[BoxData[
 RowBox[{"stationaryHermitianBasis", "[", 
  RowBox[{
   RowBox[{"0", " ", "id2"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sqrt", "[", "0.5", "]"}], " ", "Z"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[48]:= ",
 CellID->496527141,ExpressionUUID->"0971a20b-7913-467e-3f0e-445578a62d44"],

Cell[TextData[{
 "The returned basis spans the identity and ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09df342d-d743-5809-3fe4-ae76e2f62b53"],
 " directions. It is an operator basis, not a list of physical states: every \
physical member of the stationary family is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\|01d7d9", "+", 
    StyleBox["z", "TI"], 
    StyleBox["Z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"],
 " with ",
 Cell[BoxData[
  RowBox[{"-", "1", "\[LessEqual]", 
   StyleBox["z", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21fdaace-430e-f3f9-5782-43a876b8c1c3"],
 ". Verify the whole family directly:"
}], "Text",
 CellID->2009363188,ExpressionUUID->"1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"lindbladian", "[", 
   RowBox[{
    RowBox[{"0", " ", "id2"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "/", "2"}], "]"}], " ", "Z"}], "}"}], ",", " ", 
    RowBox[{"blochState", "[", 
     RowBox[{"0", ",", " ", "0", ",", " ", "z"}], "]"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[49]:= ",
 CellID->55669068,ExpressionUUID->"10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],

Cell[TextData[{
 "It vanishes identically. The endpoints ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c6bfc6-0792-5005-77fd-36a0b227236f"],
 " are the two poles, and every convex mixture between them is stationary. \
Correspondingly, the unique-state helper reports ",
 Cell[BoxData[
  RowBox[{"Failure", "[", 
   RowBox[{"\"\<NonUniqueSteadyState\>\"", ",", " ", "..."}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62752e4e-571f-d961-120a-c02862aba84b"],
 " for this generator instead of pretending that arbitrary null-space \
directions are density matrices."
}], "Text",
 CellID->1753574084,ExpressionUUID->"34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],

Cell[TextData[{
 "Now visualize the dephasing behavior above: start two Bloch vectors \
off-axis and watch each slide straight toward the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166277e1-e8de-815f-3e12-6eca8968d3a5"],
 "-axis (ball to diamond), keeping its height:"
}], "Text",
 CellID->2038359728,ExpressionUUID->"0ae7a534-7379-468c-3a9c-3d7e060c2cd6"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"gg", " ", "=", " ", "0.6"}], ",", " ", 
     RowBox[{"starts", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.85", ",", " ", "0.25", ",", " ", "0.4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.6"}], ",", " ", 
          RowBox[{"-", "0.55"}], ",", " ", 
          RowBox[{"-", "0.35"}]}], "}"}]}], "}"}]}]}], "}"}], ",", "\n", " ", 
   
   RowBox[{"blochPlot", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"closedDephasing", "[", "tt", "]"}], " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
            RowBox[{"x0", " ", "->", " ", 
             RowBox[{"s", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
            RowBox[{"y0", " ", "->", " ", 
             RowBox[{"s", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
            RowBox[{"z0", " ", "->", " ", 
             RowBox[{"s", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"tt", ",", " ", "0", ",", " ", "2.5", ",", " ", "0.05"}], 
          "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "starts"}], "}"}]}], "]"}], ",", "\n", 
     "  ", "\"\<dephasing slides each state to the z-axis\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<start (0.85, 0.25, 0.4)\>\"", ",", 
       " ", "\"\<start (-0.6, -0.55, -0.35)\>\""}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[50]:= ",
 CellID->1525364821,ExpressionUUID->"34baef30-7963-b757-5c59-077a78171dbd"],

Cell[TextData[{
 "Each tip drifts to the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15ce0314-20ee-2b64-43f5-9b5e509b764e"],
 "-axis and stops at its own height: the transverse coherence is gone, the \
populations untouched. This is dephasing in its purest form, decoherence with \
nothing else attached."
}], "Text",
 CellID->1535108406,ExpressionUUID->"38a9ac88-4644-6c0e-6856-45d273f13754"],

Cell[TextData[{
 "Two quantities summarize the dephasing. The transverse components decay at \
rate ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64802aa2-b136-451c-0cbf-c30fc0c32c66"],
 ", so the coherence time is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "=", "1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["\[Gamma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"],
 ", while the populations never move, so there is no energy relaxation, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "1"], "=", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "233ecb8e-17f3-8d32-52c5-e2e8a187d418"],
 ". The purity follows from the closed-form Bloch vector, since a state with \
Bloch vector ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["r", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dd949a9-d8cf-50b3-2be7-60f2d97a2299"],
 " has purity ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SuperscriptBox[GridBox[{
       {
        OverscriptBox[
         StyleBox["r", "TI"], "\[RightVector]"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],
 ":"
}], "Text",
 CellID->1528788962,ExpressionUUID->"598f41e5-f1df-a461-0fb5-58ce806b0f4b"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{
       RowBox[{"closedDephasing", "[", "t", "]"}], " ", ".", " ", 
       RowBox[{"closedDephasing", "[", "t", "]"}]}]}], ")"}], "/", "2"}], ",",
    " ", 
   RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[51]:= ",
 CellID->1505774531,ExpressionUUID->"1e0f0df5-2071-c96f-4634-a4bf51059bb5"],

Cell[TextData[{
 "The purity is ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubsuperscriptBox[
     StyleBox["z", "TI"], "0", "2"], "+", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", "4", 
      StyleBox["\[Gamma]", "TI"], 
      StyleBox["t", "TI"]}]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["x", "TI"], "0", "2"], "+", 
     SubsuperscriptBox[
      StyleBox["y", "TI"], "0", "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f6e12d5-e3b9-0bb9-2515-8b9e964c5983"],
 ": it relaxes from its start to ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubsuperscriptBox[
     StyleBox["z", "TI"], "0", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41ecc127-3c02-05fa-7793-d881b5b76fc0"],
 ", the purity of the leftover diagonal state, at twice the coherence rate. \
The environment has learned which ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1190ff72-a9fe-60f8-47af-f73fcf8b32c2"],
 " eigenstate the atom is in and taken none of its energy."
}], "Text",
 CellID->535490749,ExpressionUUID->"19c80315-d7de-7125-4ff7-9b5ee26b400f"],

Cell["A Driven, Damped Atom Relaxing to Steady State", "Subsection",
 CellID->1238905205,ExpressionUUID->"6fdf78a7-59a9-97d9-15e5-7101585dfd23"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A two-level atom driven by a laser (a drive about ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a87483f-bfa4-2eb6-2abd-62793a51749c"],
 ") while it decays to its ground state:"
}], "Text",
 CellID->2125008310,ExpressionUUID->"09b26917-59e6-8729-3f41-81515f90ea73"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"\[ScriptCapitalL]", 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    FractionBox["\[CapitalOmega]", "2"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["x", "TI"]], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1684656716,ExpressionUUID->"521ad179-838d-ce9b-0239-c923363994e1"],

Cell[TextData[{
 "In Bloch components ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "."], "=", "-", 
   FractionBox[
    StyleBox["\[Gamma]", "TI"], "2"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "136d7364-bcfb-8461-4113-6b4e348fef4b"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["y", "TI"], "."], "=", "-", "\[CapitalOmega]", 
   StyleBox["z", "TI"], "-", 
   FractionBox[
    StyleBox["\[Gamma]", "TI"], "2"], 
   StyleBox["y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b78534b-7a52-d624-5918-4b157fe4bd0e"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["z", "TI"], "."], "=", "\[CapitalOmega]", 
   StyleBox["y", "TI"], "-", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["z", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30c454b2-bdb8-e427-60fc-4dfc3432cf0d"],
 ", which spiral in to the steady state"
}], "Text",
 CellID->2057792111,ExpressionUUID->"6879dfe8-0276-0c7b-1806-d6b2b7035741"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]], "=", "0"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["y", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]], "=", 
    FractionBox[
     RowBox[{"2", "\[CapitalOmega]", 
      StyleBox["\[Gamma]", "TI"]}], 
     RowBox[{
      SuperscriptBox[
       StyleBox["\[Gamma]", "TI"], "2"], "+", "2", 
      SuperscriptBox["\[CapitalOmega]", "2"]}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["z", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]], "=", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox[
       StyleBox["\[Gamma]", "TI"], "2"], 
      RowBox[{
       SuperscriptBox[
        StyleBox["\[Gamma]", "TI"], "2"], "+", "2", 
       SuperscriptBox["\[CapitalOmega]", "2"]}]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->408837332,ExpressionUUID->"7cc522fa-6a93-e579-24fa-bba40f27cc43"],

Cell[TextData[{
 "at the rate set by the eigenvalues ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "\[PlusMinus]"], "=", "-", 
   FractionBox[
    RowBox[{"3", 
     StyleBox["\[Gamma]", "TI"]}], "4"], "\[PlusMinus]", 
   StyleBox["i", "TI"], 
   OverscriptBox["\[CapitalOmega]", "~"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b82e386-6ff5-c0ee-09b1-fae009819234"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox["\[CapitalOmega]", "~"], "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "-", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["\[Gamma]", "TI"], "/", "4"}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34a39a2f-b372-ffce-5c50-1388c604c514"],
 " (a damped oscillation once ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", ">", 
   StyleBox["\[Gamma]", "TI"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66ca9132-7812-8248-0ec9-097c79a4d092"],
 "). Solve it and watch the spiral."
}], "Text",
 CellID->1068510841,ExpressionUUID->"023b1c4a-5b09-a8c9-33d8-96145ebdfa13"],

Cell[TextData[{
 "Given a laser drive about ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29a4f364-fd74-7ca4-5f5b-eb41f401468e"],
 " and spontaneous emission through ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], "-"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47740231-7fc8-4299-6d0b-a47b7a7d10e3"],
 ", read the Bloch equations:"
}], "Text",
 CellID->1027032549,ExpressionUUID->"1af52337-5e42-c8c3-4a8a-bb715bf49a29"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"\[Gamma]", ",", " ", "\[CapitalOmega]"}], "]"}], ";", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"rates", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}], "}"}]}], 
     "]"}], ",", " ", 
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]}]], "Input",
 CellLabel->"In[52]:= ",
 CellID->171792661,ExpressionUUID->"2fdb82dc-2353-e9b3-55f8-1b8656e7bb99"],

Cell[TextData[{
 "The component ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5782d92f-a790-094a-7db1-d088d2255b90"],
 " decays; the drive couples ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05d48452-325d-a277-33eb-1e1c47e9f15d"],
 " and ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087ffcf6-194e-431e-3804-f5b098fb2e64"],
 " while emission pulls ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "615fadf7-df9a-5675-1764-44b0da2f3d5f"],
 " toward the ground state. This has a unique steady state. Find it by \
setting all three rates to zero:"
}], "Text",
 CellID->574949478,ExpressionUUID->"5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"steady", " ", "=", " ", 
   RowBox[{"First", "@", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"rates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}], "}"}]}], 
         "]"}], " ", "==", " ", "0"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[53]:= ",
 CellID->1664775781,ExpressionUUID->"2d0df906-1ebb-1081-5b32-f1609b4e62eb"],

Cell["Read the steady state in closed form:", "Text",
 CellID->884697794,ExpressionUUID->"519a4e0d-3467-bfb9-07ba-6057bd130583"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "/.", " ", 
    "steady"}], ",", " ", 
   RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[54]:= ",
 CellID->784201795,ExpressionUUID->"3a891815-8c00-cf41-6ab6-925f25ba95ab"],

Cell["\<\
The steady state in closed form: no transverse lean, and a tilt set by the \
ratio of drive to emission.\
\>", "Text",
 CellID->1193259712,ExpressionUUID->"0dbacffa-31b0-43f6-3b59-e6a4404511dc"],

Cell[TextData[{
 "Three physical numbers fall straight out of it. The excited population is \
the saturation curve ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["ee",
     FontSlant->"Plain"], 
    StyleBox["ss",
     FontSlant->"Plain"]], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["z", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Gamma]", "TI"], "2"], "+", "2", 
    SuperscriptBox["\[CapitalOmega]", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "196a859c-b643-c1b3-4f69-1cd9c3f79399"],
 ", which rises as ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   SuperscriptBox[
    StyleBox["\[Gamma]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c8a383-1e42-ef31-78f7-3aed9bf4b21b"],
 " for weak drive and saturates at one half for strong drive, never inverting \
the atom, and the steady fluorescence flux is ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50735439-04fd-dee7-0001-4e63ac89a4cd"],
 " times it. Read both off the closed form:"
}], "Text",
 CellID->1084903799,ExpressionUUID->"3597ba8d-914b-928f-63ac-33d720ffe0d5"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"zss", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"z", " ", "/.", " ", "steady"}], ",", " ", 
       RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", "zss"}], ")"}], "/", "2"}], ",", " ", 
     RowBox[{"\[Gamma]", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "zss"}], ")"}], "/", "2"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[55]:= ",
 CellID->964492758,ExpressionUUID->"056fda38-a5bc-2884-3314-dc65cc497aee"],

Cell[TextData[{
 "The pair is the saturation and the photons per unit time the atom scatters. \
The approach to this state, worked out next from the drift eigenvalues, rings \
whenever ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", ">", 
   StyleBox["\[Gamma]", "TI"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "383c4a9f-130c-f8c1-69c4-63d9a6beca2b"],
 " and creeps in below that. The invariant line and physically realizable \
pair that follow are the fine structure on top of these."
}], "Text",
 CellID->242210635,ExpressionUUID->"7b649e79-a2e1-7610-291b-1022d6945d7a"],

Cell["\<\
How is it approached? The Bloch equations are linear, so the approach is set \
by the eigenvalues of their drift matrix:\
\>", "Text",
 CellID->360816480,ExpressionUUID->"09cb884c-5fc8-b209-3fc8-22165a620153"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Eigenvalues", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"rates", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}], "}"}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], "}"}]}], "]"}], 
    "]"}], ",", " ", 
   RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[56]:= ",
 CellID->1505759259,ExpressionUUID->"376c6589-bcca-29e8-5d14-7cd3357f7b32"],

Cell[TextData[{
 "Two are complex conjugates: a ",
 StyleBox["spiral",
  FontWeight->"Bold"],
 ", a ringing approach, whenever the drive exceeds a quarter of the emission \
rate. Confirm the closed-form steady state against the toolkit's steady-state \
finder:"
}], "Text",
 CellID->1384053022,ExpressionUUID->"667bb688-7420-22c7-0e18-2fd27dd5702d"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"gg", " ", "=", " ", "1."}], ",", " ", 
     RowBox[{"om", " ", "=", " ", "3."}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Norm", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "/.", " ", 
         "steady"}], "]"}], " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
         RowBox[{"\[CapitalOmega]", " ", "->", " ", "om"}]}], "}"}]}], ")"}], 
     " ", "-", "\n", "   ", 
     RowBox[{"blochVector", "[", 
      RowBox[{"First", "@", 
       RowBox[{"steadyState", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"om", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "gg", "]"}], " ", "lower"}], "}"}]}], "]"}]}],
       "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[57]:= ",
 CellID->1395659232,ExpressionUUID->"72002252-da4c-5210-223f-c41fdff9217a"],

Cell["\<\
The discrepancy is at numerical precision. From the excited state the Bloch \
vector will spiral in (the complex eigenvalue pair guarantees the ringing).\
\>", "Text",
 CellID->874592789,ExpressionUUID->"084561a7-5440-aaee-387b-78015dfaf834"],

Cell[TextData[{
 "But a special pair of initial states skips the spiral entirely and slides \
straight in, and the reason sits in the drift matrix itself. Check that ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", "0", ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "721e71e5-9ca7-ded5-2226-68cf1553a43f"],
 " is one of its eigenvectors, with eigenvalue ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["\[Gamma]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a84e7eb-55e0-1894-3abb-feb563956afe"],
 ":"
}], "Text",
 CellID->1596157938,ExpressionUUID->"3261920b-7b77-02d6-621e-14557e02503c"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"rates", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}], "}"}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], "}"}]}], "]"}], 
    " ", ".", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}]}], ",", " ", 
   RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[58]:= ",
 CellID->1496122589,ExpressionUUID->"4ebe3b2c-9c8f-bd2d-7645-b376153b0477"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox[
    StyleBox["\[Gamma]", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", "0", ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6a0058-fb4a-caff-2b69-9a05fefc98c5"],
 ": a deviation from the steady state leaning purely along ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41d92934-9aba-8299-77e6-c17e1f4cd0e3"],
 " never rotates into ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cc23ff5-bf0f-f019-04f1-b6bf3abbc363"],
 " or ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29880975-91f0-008f-5fb7-a13f278552d5"],
 "; it only shrinks, at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "551c00cf-fc58-99c4-0323-99a8f5d2eb2e"],
 ". In other words, the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22235db8-54be-42b7-53d1-54e25d4b109d"],
 "-line through the steady state is invariant, and motion along it is a \
straight slide. The pure states on that line are where it pierces the unit \
sphere; since ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0976d5ae-737d-f257-3f0d-cc080609c0bd"],
 ", attach ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "\[PlusMinus]", 
   SqrtBox[
    RowBox[{"1", "-", 
     SubsuperscriptBox[
      StyleBox["y", "TI"], 
      StyleBox["ss",
       FontSlant->"Plain"], "2"], "-", 
     SubsuperscriptBox[
      StyleBox["z", "TI"], 
      StyleBox["ss",
       FontSlant->"Plain"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13e711b4-4d78-4d68-419c-88fe640d17b2"],
 " to the steady components:"
}], "Text",
 CellID->1956327387,ExpressionUUID->"3fd09d86-aea1-a602-65ef-14e3cb550d68"],

Cell[BoxData[
 RowBox[{"flatPair", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ss", " ", "=", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "/.", " ", 
         "steady"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{
              RowBox[{"ss", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"ss", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "^", "2"}]}], "]"}]}], ",", 
          " ", 
          RowBox[{"ss", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
          RowBox[{"ss", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", 
       " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[59]:= ",
 CellID->1131177628,ExpressionUUID->"2f6c0922-6605-ed68-5513-a08c13b1b7b2"],

Cell[TextData[{
 "The square root collapses to a rational form: the pair is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{"\[PlusMinus]", "2", 
      SuperscriptBox["\[CapitalOmega]", "2"]}], ",", " ", 
     RowBox[{"2", "\[CapitalOmega]", 
      StyleBox["\[Gamma]", "TI"]}], ",", " ", 
     RowBox[{"-", 
      SuperscriptBox[
       StyleBox["\[Gamma]", "TI"], "2"]}]}], 
    StyleBox[")",
     SpanMaxSize->1]}], "/", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SuperscriptBox[
      StyleBox["\[Gamma]", "TI"], "2"], "+", "2", 
     SuperscriptBox["\[CapitalOmega]", "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2caab86a-2af9-b1b1-54a9-32344e8d039b"],
 ". Check that both have unit Bloch length, so both are pure:"
}], "Text",
 CellID->611195905,ExpressionUUID->"7f56169e-4783-4dbb-256d-8fd872361781"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"#", ".", "#"}], " ", "&"}], " ", "/@", " ", "flatPair"}], ",", 
   " ", 
   RowBox[{
    RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[60]:= ",
 CellID->1202919897,ExpressionUUID->"5b84d4d6-858d-5842-09bb-cd902c382aa8"],

Cell["Both give one exactly.", "Text",
 CellID->1334651244,ExpressionUUID->"67558936-e5eb-8680-0d6a-2173939fecea"],

Cell[TextData[{
 "This two-state family is the ",
 StyleBox["physically realizable (PR) pair",
  FontWeight->"Bold"],
 " of the driven atom: a two-state ensemble a monitored trajectory can stay \
inside. The contrast is with the eigenstates of the mixed steady state (the \
",
 StyleBox["orthogonal", "TI"],
 " ensemble), which are not realizable here, and the difference is visible in \
the drift. Read the Lindblad velocity ",
 Cell[BoxData[
  OverscriptBox[
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "."]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1072dc7c-f7d5-c74e-4001-d6398261ad94"],
 " at one endpoint of each pair, the PR endpoint against the orthogonal \
endpoint:"
}], "Text",
 CellID->185339758,ExpressionUUID->"3462f0a3-098c-f6b3-5c11-e90da83edc99"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"driftAt", "[", 
    RowBox[{"r_", ",", " ", "om_", ",", " ", "gg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"blochVector", "@", 
    RowBox[{"lindbladian", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"om", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sqrt", "[", "gg", "]"}], " ", "lower"}], "}"}], ",", " ", 
      RowBox[{"blochState", " ", "@@", " ", "r"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"prPair", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"flatPair", " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalOmega]", " ", "->", " ", "3."}], ",", " ", 
       RowBox[{"\[Gamma]", " ", "->", " ", "1."}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"orthPair", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"#", ",", " ", 
       RowBox[{"-", "#"}]}], "}"}], " ", "&"}], "@", 
    RowBox[{"Normalize", "@", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "/.", " ", 
        "steady"}], " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[CapitalOmega]", " ", "->", " ", "3."}], ",", " ", 
         RowBox[{"\[Gamma]", " ", "->", " ", "1."}]}], "}"}]}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"driftAt", "[", 
     RowBox[{
      RowBox[{"prPair", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", " ", "3.", ",", " ", "1."}], 
     "]"}], ",", " ", 
    RowBox[{"driftAt", "[", 
     RowBox[{
      RowBox[{"orthPair", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", " ", "3.", ",", " ", "1."}], 
     "]"}]}], "}"}], " ", "//", " ", "Chop"}]}], "Input",
 CellLabel->"In[61]:= ",
 CellID->1677030473,ExpressionUUID->"04cac1af-436c-9192-2cc9-d809761ee3f8"],

Cell[TextData[{
 "The PR endpoint's drift points purely along the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63be94f2-239e-9b81-1145-0dbc5628e9eb"],
 "-axis, the direction of its own chord (the two PR states differ only in ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a3d7a71-218e-1995-0bc3-7c3b503b6bff"],
 "), so the state slides along the line joining the pair and never leaves it. \
The orthogonal endpoint's drift points along the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a0f2024-2f71-09ca-6a34-b98e4a045b10"],
 "-axis, across its chord (which lies in the ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "277956ac-4c9d-d338-4d07-4ff66529be02"],
 "-",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "178a6a52-23e4-1142-3d89-8c1c559163a8"],
 " plane), so the drive immediately rotates that state out of its own pair: \
no continuous measurement can keep the system perpetually in the orthogonal \
eigenbasis. That is exactly why the orthogonal ensemble is not physically \
realizable while the PR pair is."
}], "Text",
 CellID->134345938,ExpressionUUID->"52ddf811-e480-8137-02e2-f25a8d3ad01d"],

Cell[TextData[{
 "Now visualize all three paths, the spiral from the excited state and the \
two flat slides from the derived pair, with the steady state marked. This is \
the ",
 StyleBox["unconditional", "TI"],
 " picture, the record averaged away, so every start relaxes into the mixed \
steady state:"
}], "Text",
 CellID->350820043,ExpressionUUID->"719ae17a-c654-ed44-27b9-f927f3e6b7ae"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"gg", " ", "=", " ", "1."}], ",", " ", 
     RowBox[{"om", " ", "=", " ", "3."}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ss", ",", " ", "starts", ",", " ", "path"}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{
      RowBox[{"ss", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "/.", " ",
           "steady"}], " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
           RowBox[{"\[CapitalOmega]", " ", "->", " ", "om"}]}], "}"}]}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"starts", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"flatPair", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
           RowBox[{"\[CapitalOmega]", " ", "->", " ", "om"}]}], "}"}]}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"path", "[", "r0_", "]"}], " ", ":=", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"run", " ", "=", " ", 
           RowBox[{"evolveODE", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"om", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Sqrt", "[", "gg", "]"}], " ", "lower"}], "}"}], ",", 
             " ", "r0", ",", " ", "6."}], "]"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"blochVector", "[", 
            RowBox[{"run", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", "6", ",", " ", "0.02"}], "]"}]}]}], "]"}]}],
       ";", "\n", "  ", 
      RowBox[{"blochPlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"path", "[", 
           RowBox[{"densityMatrix", "[", "excited", "]"}], "]"}], ",", " ", 
          RowBox[{"path", "[", 
           RowBox[{"blochState", " ", "@@", " ", 
            RowBox[{"starts", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", "\n", "    ", 
          RowBox[{"path", "[", 
           RowBox[{"blochState", " ", "@@", " ", 
            RowBox[{"starts", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
        "   ", "\"\<every start lands on the steady state (black dot)\>\"", ",",
         "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"\"\<from the excited state\>\"", ",", 
          " ", "\"\<physically realizable start +\>\"", ",", 
          " ", "\"\<physically realizable start -\>\""}], "}"}], ",", "\n", 
        "   ", 
        RowBox[{"{", 
         RowBox[{"Black", ",", " ", 
          RowBox[{"PointSize", "[", "0.035", "]"}], ",", " ", 
          RowBox[{"Point", "[", "ss", "]"}]}], "}"}]}], "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[62]:= ",
 CellID->456450236,ExpressionUUID->"62c8f42b-c628-388a-12f7-ee74f3c28ad0"],

Cell[TextData[{
 "The excited start rings down to the steady state; the two special starts \
glide straight in; all three diamonds land on the same Bloch vector (the \
black dot), inside the ball. A driven, damped atom's ",
 StyleBox["unconditional", "TI"],
 " steady state is mixed, set by the balance of drive and emission."
}], "Text",
 CellID->1767337052,ExpressionUUID->"36e5ffeb-8179-694d-5e9a-f6b5300c3b97"],

Cell["Part Two: Light in a Box, and States That Live in Two Places", "Section",
 CellID->1422053341,ExpressionUUID->"7af061c8-c44a-ae8e-2a80-7895edfcf4d4"],

Cell[TextData[{
 "The next systems are a single mode of light in a cavity. Its states span \
the Fock ladder ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[LeftBracketingBar]", "0", "\[RightAngleBracket]"}], ",", 
   RowBox[{"\[LeftBracketingBar]", "1", "\[RightAngleBracket]"}], ",", 
   RowBox[{"\[LeftBracketingBar]", "2", "\[RightAngleBracket]"}], ",", 
   "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d437dad-8290-de9a-3b71-74f7372aa4e0"],
 ", an infinite-dimensional space. A matrix of dimension ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aafc905-908a-67da-2a54-e16f213f4d20"],
 " retains ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", "0", "\[RightAngleBracket]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62016b94-8ad8-fb56-123e-82de2f52c9bc"],
 " through ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   RowBox[{
    StyleBox["n", "TI"], "-", "1"}], "\[RightAngleBracket]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e7c794a-82c2-56e7-3604-711437773ccd"],
 " and discards ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["n", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30f601cf-5001-fb68-608d-98a961b5c9b2"],
 " upward. We choose ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04bc0f0b-f02f-243d-2c43-a75481db8f07"],
 " high enough that the retained top level has negligible population, then \
check by raising ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],
 "."
}], "Text",
 CellID->603286833,ExpressionUUID->"705e212e-f5a4-7717-2065-b88bfc515a7d"],

Cell[TextData[{
 "The ",
 StyleBox["annihilation",
  FontWeight->"Bold"],
 " and ",
 StyleBox["creation",
  FontWeight->"Bold"],
 " operators step down and up the ladder, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "\[LeftBracketingBar]", 
   StyleBox["n", "TI"], "\[RightAngleBracket]", "=", 
   SqrtBox[
    StyleBox["n", "TI"]], "\[LeftBracketingBar]", 
   RowBox[{
    StyleBox["n", "TI"], "-", "1"}], "\[RightAngleBracket]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c2f5325-a3f6-c048-05d5-4a8ed5809292"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], "\[LeftBracketingBar]", 
   StyleBox["n", "TI"], "\[RightAngleBracket]", "=", 
   SqrtBox[
    RowBox[{
     StyleBox["n", "TI"], "+", "1"}]], "\[LeftBracketingBar]", 
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], "\[RightAngleBracket]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "211ecaf2-61ee-418f-5725-e3bc179b13d5"],
 ", so ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51e4dffc-d38f-5703-079b-d6b9e63a3a69"],
 " carries ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30e43b5d-74af-d0fb-609b-b3077d5ba2c1"],
 " on its superdiagonal:"
}], "Text",
 CellID->1349832744,ExpressionUUID->"44d9380c-2e05-8f35-6ce6-b2564bb1d21f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"annihilation", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Band", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Range", "[", 
        RowBox[{"n", " ", "-", " ", "1"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"creation", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"ConjugateTranspose", "[", 
    RowBox[{"annihilation", "[", "n", "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[63]:= ",
 CellID->16034565,ExpressionUUID->"36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"],

Cell["\<\
Finite truncation changes the canonical commutator only at the top retained \
level:\
\>", "Text",
 CellID->344152329,ExpressionUUID->"138e1639-4d05-8b97-41b5-886364b1d9fd"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"n", " ", "=", " ", "7"}], ",", " ", 
     RowBox[{"aa", " ", "=", " ", 
      RowBox[{"annihilation", "[", "7", "]"}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"aa", " ", ".", " ", 
      RowBox[{"ConjugateTranspose", "[", "aa", "]"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"ConjugateTranspose", "[", "aa", "]"}], " ", ".", " ", "aa"}]}],
     " ", "==", "\n", "  ", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "n", "]"}], " ", "-", " ", 
     RowBox[{"n", " ", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"n", ",", " ", "n"}], "}"}], " ", "->", " ", "1"}], "}"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}]}]}]}]}], "]"}]], "Input",\

 CellLabel->"In[64]:= ",
 CellID->622383932,ExpressionUUID->"156728ce-0023-e03b-431c-c1a8b1d7b301"],

Cell[TextData[{
 "It returns ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"],
 ". Thus ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    SuperscriptBox[
     StyleBox["a", "TI"], "\[Dagger]"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26ff5c08-e081-ff27-4e85-56559135c20d"],
 " on all states below the boundary, with the required finite-dimensional \
correction on ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   RowBox[{
    StyleBox["n", "TI"], "-", "1"}], "\[RightAngleBracket]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07c988c4-3ef2-8066-2df6-21aeba84d34c"],
 "; cutoff checks ensure that correction is dynamically irrelevant."
}], "Text",
 CellID->2102744249,ExpressionUUID->"4bc0a2f3-6150-447f-79ff-3bbd10e52f45"],

Cell[TextData[{
 "The ",
 StyleBox["coherent state",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["\[Alpha]", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ac66077-3bfa-1f18-2afe-7a31bd8f6262"],
 " (the most classical state, an eigenstate of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d863d84-94ab-5643-6bbd-b4ee1d5e3ca9"],
 ") is the Fock-space sum"
}], "Text",
 CellID->565659401,ExpressionUUID->"7ab8b877-e011-189c-2a47-323091a46ae6"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"\[LeftBracketingBar]", 
    StyleBox["\[Alpha]", "TI"], "\[RightAngleBracket]", "=", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SuperscriptBox[GridBox[{
         {
          StyleBox["\[Alpha]", "TI"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "/", "2"}]], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["n", "TI"], "=", "0"}], "\[Infinity]",
     LimitsPositioning->False], 
    FractionBox[
     SuperscriptBox[
      StyleBox["\[Alpha]", "TI"], 
      StyleBox["n", "TI"]], 
     SqrtBox[
      RowBox[{
       StyleBox["n", "TI"], "!"}]]], "\[LeftBracketingBar]", 
    StyleBox["n", "TI"], "\[RightAngleBracket]"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->561487989,ExpressionUUID->"35eb0178-2238-e094-63e8-992257b2b2fe"],

Cell[TextData[{
 "Build it on the coefficients ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["n", "TI"]], "/", 
   SqrtBox[
    RowBox[{
     StyleBox["n", "TI"], "!"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da6433d-a7a4-ba24-3b5e-5b66d256090e"],
 " through the highest retained level, normalized in the truncated basis \
(that finite-sum normalization replaces the infinite-series prefactor ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    SuperscriptBox[GridBox[{
       {
        StyleBox["\[Alpha]", "TI"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "/", "2"}]]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "462f64f6-435d-c7dd-6fd5-7db076e9ad27"],
 "):"
}], "Text",
 CellID->2021628840,ExpressionUUID->"4b06bf63-5f43-ed7c-793d-374d5af7b446"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"coherentState", "[", 
    RowBox[{"n_", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", " ", "=", " ", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"a", "^", "k"}], "/", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"k", "!"}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", 
             RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ",", " ", 
         "1"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"v", "/", 
      RowBox[{"Norm", "[", "v", "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[65]:= ",
 CellID->41425461,ExpressionUUID->"0fd1c247-21a4-d962-35ee-e4215056a848"],

Cell[TextData[{
 "The ",
 StyleBox["displacement operator",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["D", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Alpha]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["\[Alpha]", "TI"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], "-", 
     SuperscriptBox[
      StyleBox["\[Alpha]", "TI"], "*"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09347675-9fce-c17b-38cc-683f1a789041"],
 ", which shifts the vacuum to ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["\[Alpha]", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c597ed5-00d9-d535-5467-779fb16dbc1f"],
 ":"
}], "Text",
 CellID->1208764476,ExpressionUUID->"66c4d8d6-27c8-a0db-0efb-d1905262f221"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"displacement", "[", 
    RowBox[{"n_", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"a", " ", 
      RowBox[{"creation", "[", "n", "]"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"Conjugate", "[", "a", "]"}], " ", 
      RowBox[{"annihilation", "[", "n", "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[66]:= ",
 CellID->1584634344,ExpressionUUID->"4d3801b6-8b23-0df3-74c7-98f02ed657d9"],

Cell[TextData[{
 "The ",
 StyleBox["Wigner function",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09816d05-11e9-fb6e-3fbe-856fa79dc9b4"],
 " pictures a state on the phase-space plane: positive where the state is \
concentrated and, for a nonclassical state, negative in places. In the \
canonical ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35ec423d-cde2-7917-6394-6466eb97487d"],
 " normalization its displaced-parity definition, with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox[
     RowBox[{"\\", "Pi"}],
     AutoSpacing->False], "^"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "\[Pi]", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05e0e9bc-56b1-1bf2-339f-00e6634469d8"],
 " the photon-number parity operator, is"
}], "Text",
 CellID->35679398,ExpressionUUID->"46408f14-a324-388b-6e7f-2751d6d68ad1"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["W", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox["1", "\[Pi]"], "\[ThinSpace]", 
    StyleBox["Tr",
     FontSlant->"Plain"], "[", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox[
       StyleBox["D", "TI"], "^"], "\[Dagger]"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Alpha]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"], 
     OverscriptBox[
      StyleBox["D", "TI"], "^"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Alpha]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox[
       RowBox[{"\\", "Pi"}],
       AutoSpacing->False], "^"]}], "]"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       StyleBox["x", "TI"], "+", 
       StyleBox["i", "TI"], 
       StyleBox["p", "TI"]}], 
      SqrtBox["2"]], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1113372800,ExpressionUUID->"40213c85-9219-7c2b-71de-b5ef27ac4771"],

Cell[TextData[{
 "A word on the coordinate convention, kept fixed for every phase-space \
picture below. The axes ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "678faed4-2cca-f411-0db4-479e457cdf7b"],
 " and ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b3cac94-919f-f08d-6ac3-45de202bc2d7"],
 " are the dimensionless quadratures ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "634a1270-2707-566e-1149-943a52b23cb4"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "-", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], 
    SqrtBox["2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "571f0194-b08e-3ab4-7d24-98d1c138889e"],
 " (so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79764466-e076-5945-2f0e-5e4391032baf"],
 " and the vacuum ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", "0", "\[RightAngleBracket]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e8dec7-14b1-519a-7c97-d7a19d4423e0"],
 " has variances ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["xx",
     FontSlant->"Plain"]], "=", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["pp",
     FontSlant->"Plain"]], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25f5c72f-3423-741a-538a-de89bdd65f60"],
 "), and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], "+", 
    StyleBox["i", "TI"], 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dbbd446-5835-e39a-1b58-ce2059c1b1e0"],
 " is the complex amplitude. The prefactor ",
 Cell[BoxData[
  RowBox[{"1", "/", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d34e655-b983-17e8-14cb-f81f38367d32"],
 " is the textbook normalization on these axes, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   StyleBox["W", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["p", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c435daa-0d1c-c5df-0471-54f4a4aeaf25"],
 ", so the vacuum is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "\[Pi]"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["x", "TI"], "2"], "-", 
     SuperscriptBox[
      StyleBox["p", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21714cd0-c04e-e57a-570f-659df1f8cc40"],
 "."
}], "Text",
 CellID->969867355,ExpressionUUID->"74ff421b-073b-c6d4-1c85-6445b2cfac3e"],

Cell[TextData[{
 "Rather than exponentiate the displacement operator at every grid point, \
evaluate this trace directly in the truncated Fock basis, writing ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ebc3a74-dd7c-3fa6-6643-bc31d40e858c"],
 " for the cutoff: ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d5c93fe-a057-3a16-2b63-0abbd1e3897c"],
 " is then the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[Times]", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "487dadd0-5ed6-7873-7802-449a5b634b59"],
 " matrix on the states ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[LeftBracketingBar]", "0", "\[RightAngleBracket]"}], ",", 
   "\[Ellipsis]", ",", 
   RowBox[{"\[LeftBracketingBar]", 
    RowBox[{
     StyleBox["n", "TI"], "-", "1"}], "\[RightAngleBracket]"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5219761b-8a64-c9ff-0227-68452f169bc5"],
 ", and every sum below runs over its ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69346765-6d1c-e9c9-18cc-7f4f04aebb13"],
 " superdiagonals ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[ScriptL]", "=", "0"}], ",", "\[Ellipsis]", ",", 
   RowBox[{
    StyleBox["n", "TI"], "-", "1"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c22b8c2-70f4-0562-25d1-31ac00816c48"],
 ". Define"
}], "Text",
 CellID->1210037699,ExpressionUUID->"04fec585-b88c-469b-2c85-dcef39392ce1"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["z", "TI"], "=", "2", 
    StyleBox["\[Alpha]", "TI"], "=", 
    SqrtBox["2"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], "+", 
     StyleBox["i", "TI"], 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["b", "TI"], "=", 
    RowBox[{
     SuperscriptBox[GridBox[{
        {
         StyleBox["z", "TI"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
     RowBox[{"4", 
      RowBox[{
       SuperscriptBox[GridBox[{
          {
           StyleBox["\[Alpha]", "TI"]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1239892393,ExpressionUUID->"7aa617d4-4041-969d-2a5d-8e9e71f5fce7"],

Cell[TextData[{
 "For the ",
 Cell[BoxData["\[ScriptL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e86e5c8-d785-1389-06bd-fc95e23061d3"],
 "th superdiagonal of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3582ea65-851b-2569-63b1-0c4f2caf8fb3"],
 ", define the radial Laguerre sum"
}], "Text",
 CellID->1498748757,ExpressionUUID->"5e81d752-d9a7-cf7a-06be-cf1fd8539240"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["F", "TI"], "\[ScriptL]"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["b", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["m", "TI"], "=", "0"}], 
      RowBox[{
       StyleBox["n", "TI"], "-", "\[ScriptL]", "-", "1"}],
      LimitsPositioning->False], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], 
       RowBox[{
        StyleBox["m", "TI"], ",", 
        RowBox[{
         StyleBox["m", "TI"], "+", "\[ScriptL]"}]}]], 
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"-", "1"}], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       StyleBox["m", "TI"]], 
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{
          StyleBox["m", "TI"], "!"}], "\[ThinSpace]", 
         RowBox[{"\[ScriptL]", "!"}]}], 
        RowBox[{
         RowBox[{
          StyleBox["(",
           SpanMaxSize->1], 
          RowBox[{
           StyleBox["m", "TI"], "+", "\[ScriptL]"}], 
          StyleBox[")",
           SpanMaxSize->1]}], "!"}]]], "\[ThinSpace]", 
      SubsuperscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["m", "TI"], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], "\[ScriptL]", 
        StyleBox[")",
         SpanMaxSize->1]}]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["b", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1701544389,ExpressionUUID->"6dc17641-57cc-3497-1bff-682b627e9efd"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["L", "TI"], 
   StyleBox["m", "TI"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], "\[ScriptL]", 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "647a9320-5a37-336f-0c19-0a8a5fc381b5"],
 " is a generalized Laguerre polynomial. The complete Wigner function is \
then"
}], "Text",
 CellID->1682415361,ExpressionUUID->"57b40e76-1aa6-da65-7d4b-a0309f50a94f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["W", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox["1", "\[Pi]"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["b", "TI"], "/", "2"}]], "\[ThinSpace]", 
    StyleBox["Re",
     FontSlant->"Plain"], "[", 
    RowBox[{
     SubscriptBox[
      StyleBox["F", "TI"], "0"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["b", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], "+", "2", 
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"\[ScriptL]", "=", "1"}], 
      RowBox[{
       StyleBox["n", "TI"], "-", "1"}],
      LimitsPositioning->False], 
     FractionBox[
      SuperscriptBox[
       StyleBox["z", "TI"], "\[ScriptL]"], 
      SqrtBox[
       RowBox[{"\[ScriptL]", "!"}]]], 
     SubscriptBox[
      StyleBox["F", "TI"], "\[ScriptL]"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["b", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "]"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1697357464,ExpressionUUID->"575b10e3-003a-b957-7d78-89cdb1cc0bbd"],

Cell[TextData[{
 "In other words, the recurrence computes the radial function ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], "\[ScriptL]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c7345dd-208f-a284-2401-5c87513bf0ee"],
 " for one diagonal of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0121a537-2575-8479-30de-3d714c01ef43"],
 "; the powers ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["z", "TI"], "\[ScriptL]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f325126-465a-e19d-26c2-488073ecb3e7"],
 " supply the angular dependence, and the Gaussian ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["b", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "739af998-c5c1-31b3-21b9-f0c5ec758399"],
 " supplies the envelope. Build the whole evaluation as one function: the \
Laguerre recurrence lives inside as a local helper, the input may be a state \
vector or a density matrix (a vector becomes its density matrix first), and \
the cutoff is read off the input's size. Each grid value evaluates the \
finite-cutoff expression; the returned interpolating function is a numerical \
approximation between those grid points, with a wide enough frame that its \
far corners stay clean:"
}], "Text",
 CellID->1540797058,ExpressionUUID->"003becda-d908-4451-31d8-0587d8bd2ebb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"wignerRepresentation", "[", 
    RowBox[{
     RowBox[{"psi_", "?", "VectorQ"}], ",", " ", "reach_", ",", " ", "pts_"}],
     "]"}], " ", ":=", " ", 
   RowBox[{"wignerRepresentation", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "psi", "]"}], ",", " ", "reach", ",", " ", 
     "pts"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wignerRepresentation", "[", 
    RowBox[{
     RowBox[{"rho_", "?", "MatrixQ"}], ",", " ", "reach_", ",", " ", "pts_"}],
     "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Length", "[", "rho", "]"}]}], ",", " ", "grid", ",", " ", 
       "a2", ",", " ", "b", ",", " ", "lag", ",", " ", "w"}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"grid", " ", "=", " ", 
       RowBox[{"N", "@", 
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"-", "reach"}], ",", " ", "reach", ",", " ", 
          RowBox[{"pts", " ", "-", " ", "1"}]}], "]"}]}]}], ";", "\n", "   ", 
      
      RowBox[{"a2", " ", "=", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "2.", "]"}], " ", 
        RowBox[{"Outer", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#2", " ", "+", " ", 
            RowBox[{"I", " ", "#1"}]}], " ", "&"}], ",", " ", "grid", ",", 
          " ", "grid"}], "]"}]}]}], ";", " ", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{
        RowBox[{"Abs", "[", "a2", "]"}], "^", "2"}]}], ";", "\n", "   ", 
      RowBox[{
       RowBox[{"lag", "[", 
        RowBox[{"L_", ",", " ", "c_"}], "]"}], " ", ":=", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", " ", "=", " ", 
           RowBox[{"Length", "[", "c", "]"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"Which", "[", "\n", "      ", 
          RowBox[{
           RowBox[{"m", " ", "==", " ", "1"}], ",", " ", 
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
            RowBox[{"0.", " ", "b"}]}], ",", "\n", "      ", 
           RowBox[{"m", " ", "==", " ", "2"}], ",", " ", 
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"c", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"1.", "/", 
               RowBox[{"(", 
                RowBox[{"L", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"L", " ", "+", " ", "1.", " ", "-", " ", "b"}], 
              ")"}]}]}], ",", "\n", "      ", "True", ",", " ", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"yy", " ", "=", " ", 
               RowBox[{"Fold", "[", 
                RowBox[{
                 RowBox[{"Function", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"y", ",", " ", "cj"}], "}"}], ",", " ", 
                   RowBox[{"With", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"j", " ", "=", " ", 
                    RowBox[{"cj", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\n", 
                    "           ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"cj", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
                    RowBox[{
                    RowBox[{"y", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"j", " ", "-", " ", "1."}], ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"L", " ", "+", " ", "j", " ", "-", " ", "1."}], 
                    ")"}]}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"L", " ", "+", " ", "j"}], ")"}], " ", "j"}], 
                    ")"}]}], "]"}]}]}], ",", "\n", "            ", 
                    RowBox[{
                    RowBox[{"y", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
                    RowBox[{
                    RowBox[{"y", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"L", " ", "+", " ", 
                    RowBox[{"2.", " ", "j"}], " ", "-", " ", "1", " ", "-", 
                    " ", "b"}], ")"}], " ", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"1.", "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"L", " ", "+", " ", "j"}], ")"}], " ", "j"}], 
                    ")"}]}], "]"}]}]}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", 
                 "         ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "2"}], "]"}], "]"}], " ", "+", " ", 
                    RowBox[{"0.", " ", "b"}]}], ",", " ", 
                   RowBox[{
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "1"}], "]"}], "]"}], " ", "+", " ", 
                    RowBox[{"0.", " ", "b"}]}]}], "}"}], ",", " ", 
                 RowBox[{"Transpose", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Reverse", "[", 
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", " ", 
                    RowBox[{"-", "3"}]}], "]"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"N", "@", 
                    RowBox[{"Range", "[", 
                    RowBox[{
                    RowBox[{"m", " ", "-", " ", "1"}], ",", " ", "2", ",", 
                    " ", 
                    RowBox[{"-", "1"}]}], "]"}]}]}], "}"}], "]"}]}], "]"}]}], 
              "}"}], ",", "\n", "        ", 
             RowBox[{
              RowBox[{"yy", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"yy", "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"1.", "/", 
                 RowBox[{"(", 
                  RowBox[{"L", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", 
               RowBox[{"(", 
                RowBox[{"L", " ", "+", " ", "1.", " ", "-", " ", "b"}], 
                ")"}]}]}]}], "]"}]}], "]"}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"w", " ", "=", " ", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"Fold", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"lag", "[", 
              RowBox[{
               RowBox[{"#2", " ", "-", " ", "1"}], ",", " ", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"#2", " ", "==", " ", "1"}], ",", " ", "1", ",", 
                  " ", "2"}], "]"}], " ", 
                RowBox[{"Diagonal", "[", 
                 RowBox[{"rho", ",", " ", 
                  RowBox[{"#2", " ", "-", " ", "1"}]}], "]"}]}]}], "]"}], " ",
              "+", " ", 
             RowBox[{"#1", " ", 
              RowBox[{"a2", "/", 
               RowBox[{"Sqrt", "[", "#2", "]"}]}]}]}], " ", "&"}], ",", "\n", 
           "       ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"2.", " ", 
              RowBox[{"rho", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", " ", 
                 RowBox[{"-", "1"}]}], "]"}], "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"pts", ",", " ", "pts"}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{"n", " ", "-", " ", "1"}], ",", " ", "1", ",", " ", 
             RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "b"}], "/", "2"}], "]"}], "/", "Pi"}]}]}], ";", "\n", 
      "   ", 
      RowBox[{"ListInterpolation", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", "w", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}]}], "}"}]}], 
       "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[67]:= ",
 CellID->768596373,ExpressionUUID->"7aeb468a-2cc6-59e2-2ae9-5fd445732bc8"],

Cell[TextData[{
 "Check it on the vacuum, whose Wigner function is the closed form ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "\[Pi]"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["x", "TI"], "2"], "-", 
     SuperscriptBox[
      StyleBox["p", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3873a668-04d7-31ac-6800-3832ad6383f6"],
 ", feeding the state vector directly:"
}], "Text",
 CellID->1985169054,ExpressionUUID->"4156c81a-8a68-59d7-776d-e2442f1d2b3d"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"w", " ", "=", " ", 
     RowBox[{"wignerRepresentation", "[", 
      RowBox[{
       RowBox[{"coherentState", "[", 
        RowBox[{"8", ",", " ", "0"}], "]"}], ",", " ", "3.", ",", " ", "25"}],
       "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Max", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"w", "[", 
         RowBox[{"xx", ",", " ", "pp"}], "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "Pi"}], ")"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"xx", "^", "2"}]}], " ", "-", " ", 
           RowBox[{"pp", "^", "2"}]}], "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"xx", ",", " ", 
        RowBox[{"-", "2"}], ",", " ", "2", ",", " ", "0.5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"pp", ",", " ", 
        RowBox[{"-", "2"}], ",", " ", "2", ",", " ", "0.5"}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[68]:= ",
 CellID->770675313,ExpressionUUID->"569e7ab4-00f8-e339-7ea6-73feb172ce03"],

Cell["\<\
The sampled discrepancy is at floating-point precision on the grid's own \
points; between grid nodes, accuracy is limited by the interpolation \
resolution.\
\>", "Text",
 CellID->846554368,ExpressionUUID->"0b3ec616-de69-0141-3ac5-d853db1c53ab"],

Cell[TextData[{
 "Wigner pictures are compared, across times or across states, and the \
comparison is only honest on one shared color scale. The plotter takes a list \
of Wigner interpolating functions and a label per member, finds the largest \
",
 Cell[BoxData[GridBox[{
    {
     StyleBox["W", "TI"]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c0d57bf-7ae8-3253-2433-4ef97e8280b9"],
 " over the whole list, and draws every panel and the bar legend with the \
same diverging map: a light neutral at zero so empty phase space reads as \
empty, warm (orange) for positive, cold (blue) for negative, with the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aaecb0d-dff0-cd78-3a55-e356d98a9442"],
 " contour drawn as a thin gray line so the sign change is unmistakable. An \
optional color map replaces the default; it receives the signed fraction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], "/", 
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", GridBox[{
     {
      StyleBox["W", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fe4a286-576e-fd11-759b-3be06218c47b"],
 " in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", "1"}], ",", "1"}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07179650-9fbb-2bc1-2d2c-081a1a4e792b"],
 ":"
}], "Text",
 CellID->1952818843,ExpressionUUID->"7aecd320-e31f-2936-2a93-ca8d96aa781c"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "wignerPlot", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wignerPlot", "[", 
    RowBox[{
     RowBox[{"ws", " ", ":", " ", 
      RowBox[{"{", "__InterpolatingFunction", "}"}]}], ",", " ", 
     "labels_List", ",", " ", 
     RowBox[{"color_", " ", ":", " ", "Automatic"}]}], "]"}], " ", ":=", "\n",
    "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#", "[", "\"\<ValuesOnGrid\>\"", "]"}], "]"}], " ", 
           "&"}], " ", "/@", " ", "ws"}], "]"}]}], ",", " ", 
       RowBox[{"reach", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"ws", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<Domain\>\"", "]"}], 
          "]"}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"cf", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"color", " ", "===", " ", "Automatic"}], ",", "\n", 
          "      ", 
          RowBox[{
           RowBox[{"Blend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", " ", 
                 RowBox[{"RGBColor", "[", 
                  RowBox[{"0.15", ",", " ", "0.4", ",", " ", "0.8"}], "]"}]}],
                 "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"0", ",", " ", 
                 RowBox[{"GrayLevel", "[", "0.97", "]"}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"1", ",", " ", 
                 RowBox[{"RGBColor", "[", 
                  RowBox[{"0.9", ",", " ", "0.45", ",", " ", "0.1"}], "]"}]}],
                 "}"}]}], "}"}], ",", " ", "#"}], "]"}], " ", "&"}], ",", " ",
           "color"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"raw", " ", "=", " ", 
         RowBox[{
          RowBox[{"cf", "[", 
           RowBox[{"#", "/", "m"}], "]"}], " ", "&"}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"Legended", "[", 
        RowBox[{
         RowBox[{"GraphicsRow", "[", 
          RowBox[{"MapThread", "[", "\n", "       ", 
           RowBox[{
            RowBox[{
             RowBox[{"Show", "[", 
              RowBox[{
               RowBox[{"DensityPlot", "[", 
                RowBox[{
                 RowBox[{"#1", "[", 
                  RowBox[{"xx", ",", " ", "pp"}], "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"xx", ",", " ", 
                   RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{"pp", ",", " ", 
                   RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}], ",", 
                 " ", 
                 RowBox[{"PlotPoints", " ", "->", " ", "55"}], ",", "\n", 
                 "          ", 
                 RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
                 RowBox[{"ColorFunction", " ", "->", " ", "raw"}], ",", " ", 
                 RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",",
                  "\n", "          ", 
                 RowBox[{"FrameLabel", " ", "->", " ", 
                  RowBox[{"{", 
                   RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",",
                  " ", 
                 RowBox[{"PlotLabel", " ", "->", " ", "#2"}]}], "]"}], ",", 
               "\n", "         ", 
               RowBox[{"ContourPlot", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#1", "[", 
                   RowBox[{"xx", ",", " ", "pp"}], "]"}], " ", "==", " ", 
                  "0"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"xx", ",", " ", 
                   RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{"pp", ",", " ", 
                   RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}], ",", 
                 "\n", "          ", 
                 RowBox[{"ContourStyle", " ", "->", " ", 
                  RowBox[{"Directive", "[", 
                   RowBox[{"Thin", ",", " ", "Gray"}], "]"}]}], ",", " ", 
                 RowBox[{"PlotPoints", " ", "->", " ", "40"}]}], "]"}]}], 
              "]"}], " ", "&"}], ",", "\n", "       ", 
            RowBox[{"{", 
             RowBox[{"ws", ",", " ", "labels"}], "}"}]}], "]"}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"BarLegend", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"raw", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "m"}], ",", " ", "m"}], "}"}]}], "}"}], ",", " ", 
           
           RowBox[{"LegendMarkerSize", " ", "->", " ", "130"}]}], "]"}]}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wignerPlot", "[", 
    RowBox[{"w_InterpolatingFunction", ",", " ", "label_", ",", " ", 
     RowBox[{"color_", " ", ":", " ", "Automatic"}]}], "]"}], " ", ":=", " ", 
   
   RowBox[{"wignerPlot", "[", 
    RowBox[{
     RowBox[{"{", "w", "}"}], ",", " ", 
     RowBox[{"{", "label", "}"}], ",", " ", "color"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[69]:= ",
 CellID->599175116,ExpressionUUID->"326b0854-5043-0b63-6268-a21e61f65649"],

Cell["A Cavity Cat, and Why It Decoheres Almost at Once", "Subsection",
 CellID->1234886004,ExpressionUUID->"1d6edc53-4ce5-e0f2-4b15-d61d6491b2d8"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A single leaky mode of light (a cavity dribbling photons), with no drive:"
}], "Text",
 CellID->1955603644,ExpressionUUID->"45f7e4e6-4e1c-a184-738c-fdc06baef3ee"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", 
    StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->529524776,ExpressionUUID->"70e98525-204e-6ba4-2096-1c8f51fb398e"],

Cell[TextData[{
 "A lone coherent state only shrinks, staying pure, ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["\[Alpha]", "TI"], "\[RightAngleBracket]", "\[Rule]", "\[LeftBracketingBar]", 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["\[Gamma]", "TI"], 
      StyleBox["t", "TI"], "/", "2"}]]}], "\[RightAngleBracket]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "704169dd-a4db-5005-207e-8086cd6e236f"],
 ", but a ",
 StyleBox["cat", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["\[Alpha]", "TI"], "\[RightAngleBracket]", "+", "\[LeftBracketingBar]", 
   StyleBox["\[Beta]", "TI"], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b2d1c14-5aff-cd5f-2ad2-965e5e8b97a5"],
 " of two well-separated amplitudes keeps its cross-term only through a \
coherence factor"
}], "Text",
 CellID->186212144,ExpressionUUID->"62ac11c1-6d0b-a8c0-1253-88ab04bffa2a"],

Cell[BoxData[
 PaneBox[
  RowBox[{GridBox[{
     {
      RowBox[{
       StyleBox["C", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", 
   StyleBox["exp",
    FontSlant->"Plain"], "\[ThinSpace]", "(", 
   RowBox[{"-", 
    FractionBox["1", "2"], "\[ThinSpace]", 
    SuperscriptBox[GridBox[{
       {
        RowBox[{
         StyleBox["\[Alpha]", "TI"], "-", 
         StyleBox["\[Beta]", "TI"]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["t", "TI"]}]]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ")", "\[ThickSpace]", "\[TildeTilde]", 
   "\[ThickSpace]", 
   StyleBox["exp",
    FontSlant->"Plain"], "\[ThinSpace]", "(", 
   RowBox[{"-", 
    FractionBox["1", "2"], "\[ThinSpace]", 
    SuperscriptBox[GridBox[{
       {
        RowBox[{
         StyleBox["\[Alpha]", "TI"], "-", 
         StyleBox["\[Beta]", "TI"]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "\[ThinSpace]", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["t", "TI"]}], ")", " ", 
   StyleBox[
    RowBox[{
     RowBox[{
     "at", "\[NonBreakingSpace]", "short", "\[NonBreakingSpace]", "time"}], ",",
      "\[ThinSpace]"}],
    FontSlant->"Plain"]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->284725946,ExpressionUUID->"2e7621e1-2fba-a33a-560d-b8cb4a4c0e00"],

Cell[TextData[{
 "so the coherence decays at a rate ",
 Cell[BoxData[
  RowBox[{"\[Proportional]", 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        StyleBox["\[Alpha]", "TI"], "-", 
        StyleBox["\[Beta]", "TI"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15938457-0322-a4d9-43a0-1e11b6d40e23"],
 ", quadratic in the phase-space separation. Build it in a truncated Fock \
basis and watch the fringes vanish."
}], "Text",
 CellID->1006536905,ExpressionUUID->"7f1ed2e3-b722-4b37-2525-cbccc2d7161d"],

Cell["Set a high cutoff and a cavity decay rate:", "Text",
 CellID->207506748,ExpressionUUID->"52e63e44-9d5c-26a1-029d-b02e14ee8c8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"topCat", " ", "=", " ", "30"}], ";", " ", 
  RowBox[{"blankCat", " ", "=", " ", 
   RowBox[{"IdentityMatrix", "[", "topCat", "]"}]}], ";", " ", 
  RowBox[{"downCat", " ", "=", " ", 
   RowBox[{"annihilation", "[", "topCat", "]"}]}], ";", " ", 
  RowBox[{"\[Gamma]cat", " ", "=", " ", "0.7"}], ";"}]], "Input",
 CellLabel->"In[70]:= ",
 CellID->1146295856,ExpressionUUID->"6e766a94-5ec6-6187-160d-83de5b7333ed"],

Cell[TextData[{
 "First a single coherent state: under damping it stays coherent, its \
amplitude decaying as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[Rule]", 
   StyleBox["\[Alpha]", "TI"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eead67c-41e5-1519-56e9-c82677907c63"],
 ". Check that the damped state equals a fresh, smaller coherent state:"
}], "Text",
 CellID->438365529,ExpressionUUID->"23a655ec-dad2-e192-515e-4cc9df64b3f8"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"later", " ", "=", " ", 
     RowBox[{"evolve", "[", 
      RowBox[{
       RowBox[{"0", " ", "blankCat"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], "}"}], ",",
        " ", 
       RowBox[{"densityMatrix", "[", 
        RowBox[{"coherentState", "[", 
         RowBox[{"topCat", ",", " ", "2."}], "]"}], "]"}], ",", " ", "1.0"}], 
      "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"Conjugate", "[", 
      RowBox[{"coherentState", "[", 
       RowBox[{"topCat", ",", " ", 
        RowBox[{"2.", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Gamma]cat"}], "/", "2"}], "]"}]}]}], "]"}], "]"}], 
     " ", ".", " ", "later", " ", ".", " ", 
     RowBox[{"coherentState", "[", 
      RowBox[{"topCat", ",", " ", 
       RowBox[{"2.", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[Gamma]cat"}], "/", "2"}], "]"}]}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[71]:= ",
 CellID->174000849,ExpressionUUID->"62ef85cc-c62f-39ac-1294-1ca9f3db8bf6"],

Cell["Overlap one: a coherent state stays coherent.", "Text",
 CellID->766726627,ExpressionUUID->"7d6c313b-6800-4a9b-2b13-a96509b518e1"],

Cell[TextData[{
 "Now the interesting state, a ",
 StyleBox["cat",
  FontWeight->"Bold"],
 ", the superposition of two coherent states ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   StyleBox["\[Alpha]", "TI"], "\[RightAngleBracket]", "+", "\[LeftBracketingBar]", 
   RowBox[{"-", 
    StyleBox["\[Alpha]", "TI"]}], "\[RightAngleBracket]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75dfb56b-bb47-a02b-23e4-2d353ef3f371"],
 ":"
}], "Text",
 CellID->1506609767,ExpressionUUID->"57533ce7-69d6-be0e-7d60-b5c108600554"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Alpha]", " ", "=", " ", "2."}], ";", " ", 
  RowBox[{"cat", " ", "=", " ", 
   RowBox[{"Normalize", "[", 
    RowBox[{
     RowBox[{"coherentState", "[", 
      RowBox[{"topCat", ",", " ", "\[Alpha]"}], "]"}], " ", "+", " ", 
     RowBox[{"coherentState", "[", 
      RowBox[{"topCat", ",", " ", 
       RowBox[{"-", "\[Alpha]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[72]:= ",
 CellID->281363281,ExpressionUUID->"27c3fefb-2ee6-8038-4df0-f7a54a90d302"],

Cell[TextData[{
 "First a rigorous check on the solver. Amplitude damping has an exact \
operator-sum (Kraus) solution, summed over the number of photons lost ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60d4995f-bb7f-b80c-10eb-11193e0b0b56"],
 ","
}], "Text",
 CellID->1615544595,ExpressionUUID->"64608bbe-760c-8af3-0c1f-22f803bed8d9"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["\[Rho]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["m", "TI"], "\[GreaterEqual]", "0"}],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["m", "TI"]], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], "0"], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["m", "TI"], "\[Dagger]"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["m", "TI"]], "=", 
    RowBox[{
     SqrtBox[
      FractionBox[
       SuperscriptBox[
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{"1", "-", 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           RowBox[{"-", 
            StyleBox["\[Gamma]", "TI"], 
            StyleBox["t", "TI"]}]]}], 
         StyleBox[")",
          SpanMaxSize->1]}], 
        StyleBox["m", "TI"]], 
       RowBox[{
        StyleBox["m", "TI"], "!"}]]], "\[ThickSpace]", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["t", "TI"], "\[ThinSpace]", 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "\[Dagger]"], 
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "/", "2"}]], "\[ThinSpace]", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], 
      StyleBox["m", "TI"]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1805673747,ExpressionUUID->"09661063-a2cf-675e-3f1d-8a4cd77a4da4"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5561d787-26b0-8d0a-031e-cee1534ad450"],
 " removing ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fea91e8-e80e-a1ed-35e9-08b589b8f337"],
 " photons and ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["t", "TI"], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37725419-c8bf-c4cd-5d02-4e42e94bae17"],
 " shrinking the survivors; the set is trace-preserving, so it needs no \
renormalization. Write it:"
}], "Text",
 CellID->1547520620,ExpressionUUID->"6eee5857-8f9d-bf63-1696-52112a290249"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"photonLoss", "[", 
    RowBox[{"rho0_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"shrink", " ", "=", " ", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Gamma]cat"}], " ", "t", " ", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"topCat", " ", "-", " ", "1"}]}], "]"}], "/", "2"}]}], 
          "]"}], "]"}]}], ",", " ", 
       RowBox[{"keep", " ", "=", " ", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Gamma]cat"}], " ", "t"}], "]"}]}]}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"M", " ", "=", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"keep", "^", 
              RowBox[{"(", 
               RowBox[{"m", "/", "2"}], ")"}]}], "/", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"m", "!"}], "]"}]}], " ", 
            RowBox[{"shrink", " ", ".", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"m", " ", "==", " ", "0"}], ",", " ", "blankCat", ",", 
               " ", 
               RowBox[{"MatrixPower", "[", 
                RowBox[{"downCat", ",", " ", "m"}], "]"}]}], "]"}]}]}]}], 
          "}"}], ",", "\n", "      ", 
         RowBox[{"M", " ", ".", " ", "rho0", " ", ".", " ", 
          RowBox[{"ConjugateTranspose", "[", "M", "]"}]}]}], "]"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", 
         RowBox[{"topCat", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[73]:= ",
 CellID->858350929,ExpressionUUID->"2635f536-2fc9-ab3c-4fca-ed704a7df606"],

Cell["\<\
Confirm the master equation and this Kraus sum agree on the cat:\
\>", "Text",
 CellID->2138894257,ExpressionUUID->"1b3760e9-4a32-92b2-4acd-79b36fc4e098"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "@", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"evolve", "[", 
      RowBox[{
       RowBox[{"0", " ", "blankCat"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], "}"}], ",",
        " ", 
       RowBox[{"densityMatrix", "[", "cat", "]"}], ",", " ", "0.6"}], "]"}], 
     " ", "-", " ", 
     RowBox[{"photonLoss", "[", 
      RowBox[{
       RowBox[{"densityMatrix", "[", "cat", "]"}], ",", " ", "0.6"}], "]"}]}],
     "]"}]}]}]], "Input",
 CellLabel->"In[74]:= ",
 CellID->1941039383,ExpressionUUID->"14fe93a8-4ee9-5b9e-3c85-0af26a9c29e4"],

Cell["The discrepancy is at the numerical integration tolerance.", "Text",
 CellID->1670620029,ExpressionUUID->"11cf5d11-52cc-ddbb-47f5-555b677ea781"],

Cell["\<\
Now visualize the cat's decoherence. Build the Wigner film over a short \
window:\
\>", "Text",
 CellID->588214459,ExpressionUUID->"7ba8138a-66ce-478c-2957-8ad4137b2dd6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"catTimes", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", ".4", ",", " ", ".1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"catFilm", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"wignerRepresentation", "[", 
      RowBox[{
       RowBox[{"evolve", "[", 
        RowBox[{
         RowBox[{"0", " ", "blankCat"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], "}"}],
          ",", " ", 
         RowBox[{"densityMatrix", "[", "cat", "]"}], ",", " ", "t"}], "]"}], ",",
        " ", "4.2", ",", " ", "55"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "catTimes"}], "}"}]}], "]"}]}], ";"}]}], "Input",\

 CellLabel->"In[75]:= ",
 CellID->1759496502,ExpressionUUID->"35c9e6d4-f3c4-84c1-63f6-ff918676ee2b"],

Cell["Draw it on one shared color scale:", "Text",
 CellID->1641757231,ExpressionUUID->"6fd66644-13e4-6fa7-15ee-782ea591358d"],

Cell[BoxData[
 RowBox[{"wignerPlot", "[", 
  RowBox[{"catFilm", ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\"\<time \>\"", " ", "<>", " ", 
      RowBox[{"ToString", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
    "catTimes"}]}], "]"}]], "Input",
 CellLabel->"In[76]:= ",
 CellID->896279625,ExpressionUUID->"00abf1cf-696b-3507-30a8-e8a9081f9c6d"],

Cell[TextData[{
 "The thin gray lines in each panel are the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03d898fe-d35a-9eef-31e7-11bbe6ece435"],
 " contour, where the Wigner function changes sign: the negative (blue) \
patches of quantum interference lie inside them."
}], "Text",
 CellID->1264190945,ExpressionUUID->"03dda600-4b0b-c3af-31e2-386a6ebf91f5"],

Cell["\<\
At first there are two Gaussian lobes (the two coherent states) with \
interference fringes between them: the fringes are the coherence, the \
off-diagonal cross-term. Across this short window the fringes fade fast while \
the lobes barely shrink: the cat is collapsing toward a classical mixture of \
the two coherent states while both are still nearly full size. Decoherence is \
far faster than energy loss.\
\>", "Text",
 CellID->1806910998,ExpressionUUID->"4de38b79-ee67-8bee-7b90-23228b13d934"],

Cell[TextData[{
 "How fast? The coherence ",
 Cell[BoxData[GridBox[{
    {
     RowBox[{
      StyleBox["C", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "347cf1ed-0cc4-b4dc-5c03-e8b7a5761e26"],
 " is the closed-form envelope from the problem statement, and the master \
equation can be made to report the same quantity on its own. Evolve the cat \
once over the plotted span:"
}], "Text",
 CellID->962064851,ExpressionUUID->"7d81b9ce-3a4c-aa2a-2bbe-30a8bffef970"],

Cell[BoxData[
 RowBox[{
  RowBox[{"catRun", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{"0", " ", "blankCat"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], "}"}], ",",
      " ", 
     RowBox[{"densityMatrix", "[", "cat", "]"}], ",", " ", "2."}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[77]:= ",
 CellID->1660212291,ExpressionUUID->"6bb9b374-9caf-337d-1946-2b3e155b9e47"],

Cell[TextData[{
 "Under amplitude damping the state stays in the span of its two shrinking \
lobes. Write the rank-one operator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["u", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "\[LeftBracketingBar]", 
   StyleBox["u", "TI"], "\[RightAngleBracket]", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[LeftBracketingBar]", 
      StyleBox["v", "TI"], "\[RightAngleBracket]"}], 
     StyleBox[")",
      SpanMaxSize->1]}], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c340229-13f4-0181-15cb-a473a58153eb"],
 "; then"
}], "Text",
 CellID->1553450743,ExpressionUUID->"25dfa134-0866-9bb5-53e4-397ea910e99f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["\[Rho]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["p", "TI"], "(", 
    RowBox[{
     StyleBox["P", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], 
       StyleBox["t", "TI"]], ",", 
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], 
       StyleBox["t", "TI"]]}], 
     StyleBox[")",
      SpanMaxSize->1], "+", 
     StyleBox["P", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      RowBox[{"-", 
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["t", "TI"]]}], ",", 
      RowBox[{"-", 
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["t", "TI"]]}]}], 
     StyleBox[")",
      SpanMaxSize->1]}], ")", "+", 
    StyleBox["c", "TI"], "(", 
    RowBox[{
     StyleBox["P", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], 
       StyleBox["t", "TI"]], ",", 
      RowBox[{"-", 
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["t", "TI"]]}]}], 
     StyleBox[")",
      SpanMaxSize->1], "+", 
     StyleBox["P", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      RowBox[{"-", 
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["t", "TI"]]}], ",", 
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], 
       StyleBox["t", "TI"]]}], 
     StyleBox[")",
      SpanMaxSize->1]}], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["t", "TI"]], "=", 
    RowBox[{
     StyleBox["\[Alpha]", "TI"], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["t", "TI"], "/", "2"}]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->376345483,ExpressionUUID->"425139cc-45a5-cefb-726e-b0966c5194c1"],

Cell[TextData[{
 "and the coherence is the weight ratio ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      RowBox[{
       StyleBox["C", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", 
   StyleBox["c", "TI"], "/", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d922994-f334-45bb-7ba1-c0d186c12f81"],
 ". The two lobes are not orthogonal (they overlap by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["o", "TI"], "=", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["t", "TI"]], ",", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], 
      StyleBox["t", "TI"]]}]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06c25578-1780-b25e-2ef2-4d22a23a00a4"],
 "), so read ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f70617e-b140-9f95-0500-793bc0fae5ff"],
 " and ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79d0371a-30a6-04e5-2fef-af4441536ecf"],
 " off two matrix elements of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d950d76-dd18-2b24-2baa-a533d4ad760e"],
 " by undoing that overlap with a two-by-two linear solve:"
}], "Text",
 CellID->1917523023,ExpressionUUID->"7234a9f4-3232-6781-23cb-40be47c74deb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"catCoherence", "[", 
    RowBox[{"t_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "va", ",", " ", "vb", ",", " ", "o", ",", " ", "m1", ",", " ", "m2", ",",
        " ", "p", ",", " ", "cc"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"va", " ", "=", " ", 
       RowBox[{"coherentState", "[", 
        RowBox[{"topCat", ",", " ", 
         RowBox[{"\[Alpha]", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Gamma]cat"}], " ", 
            RowBox[{"t", "/", "2"}]}], "]"}]}]}], "]"}]}], ";", " ", 
      RowBox[{"vb", " ", "=", " ", 
       RowBox[{"coherentState", "[", 
        RowBox[{"topCat", ",", " ", 
         RowBox[{
          RowBox[{"-", "\[Alpha]"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Gamma]cat"}], " ", 
            RowBox[{"t", "/", "2"}]}], "]"}]}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"o", " ", "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "va", "]"}], " ", ".", " ", "vb"}], 
        "]"}]}], ";", "\n", "   ", 
      RowBox[{"m1", " ", "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "va", "]"}], " ", ".", " ", 
         RowBox[{"catRun", "[", "t", "]"}], " ", ".", " ", "va"}], "]"}]}], ";",
       " ", 
      RowBox[{"m2", " ", "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "va", "]"}], " ", ".", " ", 
         RowBox[{"catRun", "[", "t", "]"}], " ", ".", " ", "vb"}], "]"}]}], ";",
       "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "cc"}], "}"}], " ", "=", " ", 
       RowBox[{"LinearSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", " ", "+", " ", 
              RowBox[{"o", "^", "2"}]}], ",", " ", 
             RowBox[{"2", " ", "o"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", " ", "o"}], ",", " ", 
             RowBox[{"1", " ", "+", " ", 
              RowBox[{"o", "^", "2"}]}]}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m1", ",", " ", "m2"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
      
      RowBox[{"cc", "/", "p"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[78]:= ",
 CellID->225924774,ExpressionUUID->"42668d78-f434-72a4-721d-2525fdc1408e"],

Cell["\<\
Now visualize both, the closed-form envelope and the master-equation \
extraction, for our chosen separation:\
\>", "Text",
 CellID->1508526016,ExpressionUUID->"0c7cc198-0ad8-2426-3403-d8c2af528f0c"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "2"}], " ", 
       RowBox[{"\[Alpha]", "^", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Gamma]cat"}], " ", "t"}], "]"}]}], ")"}]}], "]"}], 
     ",", " ", 
     RowBox[{"catCoherence", "[", "t", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "2"}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", "Dashed"}], "]"}]}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<closed form\>\"", ",", " ", "\"\<master equation\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<coherence |C(t)|\>\""}], "}"}]}], 
   ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<master-equation coherence lies on the closed-form \
envelope\>\""}]}], "]"}]], "Input",
 CellLabel->"In[79]:= ",
 CellID->1653333794,ExpressionUUID->"69698b1d-3dc2-3628-1f16-2347b4749d72"],

Cell[TextData[{
 "The dashed master-equation extraction lies on the closed form within the \
displayed numerical tolerance. The envelope is the exact infinite-dimensional \
amplitude-damping law; the finite Fock simulation approaches it as its cutoff \
and solver accuracy are increased. The decoherence rate grows as the ",
 StyleBox["square", "TI"],
 " of the separation, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        StyleBox["\[Alpha]", "TI"], "-", 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"-", 
         StyleBox["\[Alpha]", "TI"]}], 
        StyleBox[")",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", "4", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Alpha]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "701e1eb7-eeba-61c8-2025-97f08b4f3312"],
 "."
}], "Text",
 CellID->2117504204,ExpressionUUID->"0e322415-281a-3695-37c1-be5f49ac9cff"],

Cell["\<\
Every Fock-space example truncates the infinite number-state ladder at a \
finite cutoff, so each needs a check that the cutoff is high enough not to \
change the answer. Recompute the mean photon number of a decaying coherent \
state at cutoffs 20, 30, and 40:\
\>", "Text",
 CellID->201091240,ExpressionUUID->"61beb272-ef15-9663-1745-343f8aa1fd49"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"observable", " ", "=", " ", 
     RowBox[{"Function", "[", 
      RowBox[{"nn", ",", " ", 
       RowBox[{"expectation", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"creation", "[", "nn", "]"}], " ", ".", " ", 
          RowBox[{"annihilation", "[", "nn", "]"}]}], ",", " ", 
         RowBox[{"evolve", "[", 
          RowBox[{
           RowBox[{"0", " ", 
            RowBox[{"IdentityMatrix", "[", "nn", "]"}]}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", 
             RowBox[{"annihilation", "[", "nn", "]"}]}], "}"}], ",", " ", 
           RowBox[{"densityMatrix", "[", 
            RowBox[{"coherentState", "[", 
             RowBox[{"nn", ",", " ", "2."}], "]"}], "]"}], ",", " ", "0.5"}], 
          "]"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"observable", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"20", ",", " ", "30", ",", " ", "40"}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[80]:= ",
 CellID->667003370,ExpressionUUID->"5e8a6a96-06b4-6465-0689-83d0b3414f4f"],

Cell["\<\
The three values are numerically indistinguishable at the shown precision. \
This bounds, rather than eliminates, the truncation error: for this \
observable and state, raising the dimension beyond 20 changes the result by \
less than the displayed tolerance.\
\>", "Text",
 CellID->526043023,ExpressionUUID->"55951090-ef25-ccfd-03aa-89dd8ad196c7"],

Cell["Making a Cat With an Atom, and Reading Its Decoherence", "Subsection",
 CellID->1120596176,ExpressionUUID->"53a2ca13-da2c-324e-0151-ec5cdfde8094"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A ",
 StyleBox["far-detuned", "TI"],
 " atom, its transition frequency sitting far from the cavity's so it can \
trade no energy with the light and only turns its phase, imprints a \
state-dependent phase shift under"
}], "Text",
 CellID->64105026,ExpressionUUID->"5930221d-821b-4026-08cf-c44737ae130c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["H", "TI"], "^"], 
         StyleBox["C", "TI"]], "=", 
        StyleBox["\[Chi]", "TI"], "\[ThinSpace]", 
        SuperscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "^"], "\[Dagger]"], 
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "\[ThinSpace]", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["\[Sigma]", "TI"], "^"], 
         StyleBox["z", "TI"]]}], ",", 
       "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
       RowBox[{"\[LeftBracketingBar]", 
        StyleBox["\[Alpha]", "TI"]}]}], "\[RightAngleBracket]"}], "\[Rule]", 
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{
       StyleBox["\[Alpha]", "TI"], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"\[PlusMinus]", 
         StyleBox["i", "TI"], 
         StyleBox["\[Phi]", "TI"]}]]}]}]}], "\[RightAngleBracket]"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["\[Phi]", "TI"], "=", 
    RowBox[{
     StyleBox["\[Chi]", "TI"], 
     RowBox[{
      StyleBox["\[Tau]", "TI"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1373525465,ExpressionUUID->"76ba63e9-5df8-c241-1e5a-7ab3547290ab"],

Cell[TextData[{
 "An atom prepared in the equal superposition ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[LeftBracketingBar]", 
    StyleBox["e", "TI"], "\[RightAngleBracket]", "+", "\[LeftBracketingBar]", 
    
    StyleBox["g", "TI"], "\[RightAngleBracket]"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "319e51f9-a9ce-1d21-67a6-48a2c87b640b"],
 " therefore leaves the field in a two-phase ",
 StyleBox["cat",
  FontWeight->"Bold"],
 ", ",
 Cell[BoxData[
  RowBox[{"\[LeftBracketingBar]", 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[Phi]", "TI"]}]]}], "\[RightAngleBracket]", "+", "\[LeftBracketingBar]", 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"+", 
      StyleBox["i", "TI"], 
      StyleBox["\[Phi]", "TI"]}]]}], "\[RightAngleBracket]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f4962c-805e-a216-4e8b-087631e8f17c"],
 ", entangled with the atom. After the cat decoheres for a delay (the leak of \
the last example), a second atom probes the same field, and the two-atom \
correlation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", 
   StyleBox["p", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], "2"], " ", 
    StyleBox["given",
     FontSlant->"Plain"], " ", 
    SubscriptBox[
     StyleBox["e", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["p", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], "2"], " ", 
    StyleBox["given",
     FontSlant->"Plain"], " ", 
    SubscriptBox[
     StyleBox["g", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "313d5a7b-7caf-7acc-60c3-5c25755a4816"],
 " (the second atom's chance of coming out excited when the first did, minus \
when the first came out in the ground state) is nonzero only while the field \
keeps its coherence, so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2da78195-91be-94f0-5b5c-18df2048feda"],
 " tracks the surviving coherence ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39c6b7ab-78e0-e73c-6ffd-2ef5789aca06"],
 " and falls to zero as the cat blurs into a mixture. This is the ",
 ButtonBox["Haroche experiment",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://link.aps.org/doi/10.1103/PhysRevLett.77.4887"], None}],
 "; build the atom-made cat and measure how fast the correlation dies."
}], "Text",
 CellID->1964307623,ExpressionUUID->"3f7d0c35-7157-44bf-6502-a67f00e22e85"],

Cell[TextData[{
 "In plainer terms, the atom is a phase stamp, not an absorber: far off \
resonance it takes no photon from the field, it only rotates the field's \
phase by ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["\[Phi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47b49f91-c3c7-4deb-6d4b-16daf6721731"],
 " or ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["\[Phi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "064e3005-d89e-7c03-2e75-aa6ed92b4769"],
 " according to its state, so an atom in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[LeftBracketingBar]", 
    StyleBox["e", "TI"], "\[RightAngleBracket]", "+", "\[LeftBracketingBar]", 
    
    StyleBox["g", "TI"], "\[RightAngleBracket]"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76c2caed-aea0-13a2-1ef1-e3b6cb556188"],
 " leaves the two phase-rotated fields superposed and entangled with it. One \
probe atom cannot reveal this coherence, since its own outcome averages over \
the two phases; only the correlation ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "260c3025-1fa9-9acd-4e33-a98f9a5de817"],
 " between two atoms reading the same field exposes it, and only while it \
survives."
}], "Text",
 CellID->39040159,ExpressionUUID->"4b1e6c2c-0452-4134-7925-8676ade7101e"],

Cell["\<\
The protocol runs a fixed sequence, one atom writing the cat onto the field \
and the next reading it back; here is the whole arc before we build each step:\
\>", "Text",
 CellID->1242473813,ExpressionUUID->"2982aea8-af87-65d7-5fb1-47f5ca324f3d"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"w", " ", "=", " ", "3.9"}], ",", " ", 
     RowBox[{"h", " ", "=", " ", "0.62"}], ",", " ", 
     RowBox[{"dy", " ", "=", " ", "1.35"}], ",", " ", 
     RowBox[{"cS", " ", "=", " ", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.88", ",", " ", "0.94", ",", " ", "1."}], "]"}]}], ",", " ", 
     
     RowBox[{"cC", " ", "=", " ", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"1.", ",", " ", "0.91", ",", " ", "0.82"}], "]"}]}], ",", " ", 
     
     RowBox[{"cM", " ", "=", " ", 
      RowBox[{"GrayLevel", "[", "0.9", "]"}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
