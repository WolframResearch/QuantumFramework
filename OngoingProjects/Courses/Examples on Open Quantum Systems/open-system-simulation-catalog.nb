Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mixture", "[", 
    RowBox[{"\[Phi]_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sh", " ", "=", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Gamma]har"}], " ", 
         RowBox[{"t", "/", "2"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"densityMatrix", "[", 
         RowBox[{"coherentState", "[", 
          RowBox[{"topHar", ",", " ", 
           RowBox[{"2.", " ", "sh", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", "\[Phi]"}], "]"}]}]}], "]"}], "]"}], 
        " ", "+", " ", 
        RowBox[{"densityMatrix", "[", 
         RowBox[{"coherentState", "[", 
          RowBox[{"topHar", ",", " ", 
           RowBox[{"2.", " ", "sh", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "\[Phi]"}], "]"}]}]}], "]"}], "]"}]}], ")"}], "/",
       "2"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[111]:=",
 CellID->1952919625,ExpressionUUID->"1279eb8d-ef8a-5dbb-4206-02d68a3f2781"],

Cell["\<\
The surviving coherence is the trace distance between the leak-evolved \
conditional cat and that mixture, over a list of delays, one master-equation \
run per phase:\
\>", "Text",
 CellID->162062935,ExpressionUUID->"6afb4307-9f81-9d1b-1a99-5b611a35e461"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"coherenceLeft", "[", 
    RowBox[{"\[Phi]_", ",", " ", "delays_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"run", " ", "=", " ", 
       RowBox[{"evolveODE", "[", 
        RowBox[{
         RowBox[{"0", " ", "blankHar"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[Gamma]har", "]"}], " ", "downHar"}], "}"}],
          ",", " ", 
         RowBox[{"conditionalCat", "[", 
          RowBox[{"\[Phi]", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"Max", "[", "delays", "]"}]}], "]"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"traceDistance", "[", 
        RowBox[{
         RowBox[{"run", "[", "t", "]"}], ",", " ", 
         RowBox[{"mixture", "[", 
          RowBox[{"\[Phi]", ",", " ", "t"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "delays"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"delays", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", "3", ",", " ", "0.25"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"close", ",", " ", "far"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"coherenceLeft", "[", 
      RowBox[{"0.5", ",", " ", "delays"}], "]"}], ",", " ", 
     RowBox[{"coherenceLeft", "[", 
      RowBox[{"1.3", ",", " ", "delays"}], "]"}]}], "}"}]}], ";"}]}], "Input",\

 CellLabel->"In[112]:=",
 CellID->1483832353,ExpressionUUID->"2e902be9-4fb4-3e90-56af-c2b36a4684fa"],

Cell["Visualize the two normalized coherences against the delay:", "Text",
 CellID->421271511,ExpressionUUID->"46e8ad28-93a4-355d-6e97-457226569fa7"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"delays", ",", " ", 
        RowBox[{"close", "/", 
         RowBox[{"First", "@", "close"}]}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"delays", ",", " ", 
        RowBox[{"far", "/", 
         RowBox[{"First", "@", "far"}]}]}], "}"}], "]"}]}], "}"}], ",", "\n", 
   " ", 
