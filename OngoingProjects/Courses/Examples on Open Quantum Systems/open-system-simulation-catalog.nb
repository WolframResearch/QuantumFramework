     RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the meter pointer settles to two places, one per qubit \
state\>\""}]}], "]"}]], "Input",
 CellLabel->"In[114]:= ",
 CellID->320909480,ExpressionUUID->"3af5a034-7641-6879-6a8a-3a7e03f43b43"],

Cell[TextData[{
 "What a real readout does with those two pointers is discriminate them in \
the IQ plane. Detecting the cavity output (heterodyne) turns each \
qubit-conditioned coherent pointer into a Gaussian blob of measurement \
outcomes, centered at its amplitude with the shot-noise width of a coherent \
state. A snapshot draws ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["I", "TI"], ",", 
     StyleBox["Q", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], "=", 
   RowBox[{
    RowBox[{
     SqrtBox["2"], "\[ThinSpace]", 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       RowBox[{
        StyleBox["Re",
         FontSlant->"Plain"], "\[ThinSpace]", 
        SubscriptBox[
         StyleBox["\[Alpha]", "TI"], 
         StyleBox["s", "TI"]], 
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["t", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}], ",", "\[ThinSpace]", 
       RowBox[{
        StyleBox["Im",
         FontSlant->"Plain"], "\[ThinSpace]", 
        SubscriptBox[
         StyleBox["\[Alpha]", "TI"], 
         StyleBox["s", "TI"]], 
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         StyleBox["t", "TI"], 
         StyleBox[")",
          SpanMaxSize->1]}]}]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "+", 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Xi]", "TI"], 
       StyleBox["I", "TI"]], ",", 
      SubscriptBox[
       StyleBox["\[Xi]", "TI"], 
       StyleBox["Q", "TI"]]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68379bed-79e9-22be-19cc-12b77f9c7084"],
 " with independent ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Xi]", "TI"], 
    StyleBox["I", "TI"]], ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Xi]", "TI"], 
     StyleBox["Q", "TI"]], "\[Tilde]", "\|01d4a9", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"0", ",", "1"}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "460eb9f9-c41e-8ef4-6e35-30a2eda8d4de"],
 ", Gaussian shot noise added to the pointer amplitude; because the \
conditional cavity is the coherent state ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], 
       StyleBox["s", "TI"]], 
      StyleBox["(", SpanMaxSize -> 1], 
      StyleBox["t", "TI"], 
      StyleBox[")", SpanMaxSize -> 1]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "258251be-7c16-7495-53b2-48f875a35eff"],
 ", that draw is precisely its Husimi-",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35c1f832-722b-ca69-63fe-f27c07df98b3"],
 " distribution. As the pointers separate the two blobs pull apart and the \
assignment becomes reliable. Sample the two outcome clouds at three readout \
times:"
}], "Text",
 CellID->1950243504,ExpressionUUID->"7b6a50da-eb07-3910-296a-49878eb3887a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"iqCloud", "[", 
    RowBox[{"ptr_", ",", " ", "t_", ",", " ", "seed_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", "2", "]"}], " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Re", "@", 
            RowBox[{"ptr", "[", "t", "]"}]}], ",", " ", 
           RowBox[{"Im", "@", 
            RowBox[{"ptr", "[", "t", "]"}]}]}], "}"}]}], " ", "+", " ", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", "2"}], "]"}]}], ",",
        " ", "250"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"iqTimes", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.5", ",", " ", "1.5", ",", " ", "4."}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[115]:= ",
 CellID->1158471628,ExpressionUUID->"23591dbb-79d4-ec10-5166-94e57866b77a"],

Cell[TextData[{
 "Now visualize the readout separating in time, the two clouds (qubit ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "114fd905-c79d-9420-4774-d16ef229ff0a"],
 " in blue, ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0047a90f-9cb0-808d-307c-4169154ad2d7"],
 " in orange) drifting apart across the IQ plane:"
}], "Text",
 CellID->600867794,ExpressionUUID->"42e32fd7-26e6-6b71-7290-c6915293365b"],

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
