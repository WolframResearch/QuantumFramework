Cell[TextData[{
 "the continuous Lyapunov equation, with the rank-one Kalman-gain noise ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["K", "TI"], "\[RightVector]"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["K", "TI"], "\[RightVector]"], 
    StyleBox["T", "TI"]], "=", "(", GridBox[{
     {
      SubsuperscriptBox[
       StyleBox["k", "TI"], 
       StyleBox["x", "TI"], "2"], 
      RowBox[{
       SubscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["x", "TI"]], 
       SubscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["p", "TI"]]}]},
     {
      RowBox[{
       SubscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["x", "TI"]], 
       SubscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["p", "TI"]]}], 
      SubsuperscriptBox[
       StyleBox["k", "TI"], 
       StyleBox["p", "TI"], "2"]}
    }], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "156af067-c7e0-b0e6-4369-ea40f19a02cc"],
 ", solved by:"
}], "Text",
 CellID->1974583224,ExpressionUUID->"4bf44795-0096-4fae-798c-5edfb12315f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nUncCool", "[", "gg_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"LyapunovSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "gammaCool"}], "/", "2"}], ",", " ", "1"}], "}"}], 
           ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "gammaCool"}], "/", "2"}], " ", "-", " ", 
              "gg"}]}], "}"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"-", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"kxCool", "^", "2"}], ",", " ", 
              RowBox[{"kxCool", " ", "kpCool"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"kxCool", " ", "kpCool"}], ",", " ", 
              RowBox[{"kpCool", "^", "2"}]}], "}"}]}], "}"}]}]}], "]"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"s", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
         "vxCool", " ", "+", " ", 
         RowBox[{"s", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "+", " ", 
         "vpCool"}], ")"}], "/", "2"}], " ", "-", " ", "0.5"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[284]:= ",
 CellID->761010835,ExpressionUUID->"6df0ebcc-3ebb-64ea-1b8f-0296bb4e4e30"],

Cell[TextData[{
 "With no feedback, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["G", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b24542a-2937-2c7d-6adc-4e7448c27747"],
 ", watching does not cool at all: it ",
 StyleBox["heats", "TI"],
 ", because measurement back-action kicks the momentum and nothing removes \
the energy. Confirm this two ways, the conditional-plus-spread bookkeeping \
against the plain unconditional master equation (back-action on ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["pp",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b2c6ce5-e2d3-dbc3-5ad3-85ce9767a929"],
 ", bath, no information gain):"
}], "Text",
 CellID->1273215491,ExpressionUUID->"47b8b786-9b5d-56d3-6d47-2ee01ee83c39"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nUncCool", "[", "0.", "]"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", " ", "=", " ", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"vx", "'"}], "[", "t", "]"}], " ", "==", " ", 
            RowBox[{
             RowBox[{"2", " ", 
              RowBox[{"vc", "[", "t", "]"}]}], " ", "-", " ", 
             RowBox[{"gammaCool", " ", 
              RowBox[{"vx", "[", "t", "]"}]}], " ", "+", " ", 
             RowBox[{"gammaCool", " ", 
              RowBox[{"(", 
               RowBox[{"nCool", " ", "+", " ", 
                RowBox[{"1", "/", "2"}]}], ")"}]}]}]}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"vc", "'"}], "[", "t", "]"}], " ", "==", " ", 
            RowBox[{
             RowBox[{"vp", "[", "t", "]"}], " ", "-", " ", 
             RowBox[{"vx", "[", "t", "]"}], " ", "-", " ", 
             RowBox[{"gammaCool", " ", 
              RowBox[{"vc", "[", "t", "]"}]}]}]}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"vp", "'"}], "[", "t", "]"}], " ", "==", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              RowBox[{"vc", "[", "t", "]"}]}], " ", "+", " ", "kCool", " ", "-",
              " ", 
             RowBox[{"gammaCool", " ", 
              RowBox[{"vp", "[", "t", "]"}]}], " ", "+", " ", 
             RowBox[{"gammaCool", " ", 
              RowBox[{"(", 
               RowBox[{"nCool", " ", "+", " ", 
                RowBox[{"1", "/", "2"}]}], ")"}]}]}]}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"vx", "[", "0", "]"}], " ", "==", " ", 
            RowBox[{"nCool", " ", "+", " ", "0.5"}]}], ",", " ", 
           RowBox[{
            RowBox[{"vc", "[", "0", "]"}], " ", "==", " ", "0."}], ",", " ", 
           RowBox[{
            RowBox[{"vp", "[", "0", "]"}], " ", "==", " ", 
            RowBox[{"nCool", " ", "+", " ", "0.5"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"vx", ",", " ", "vp"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "200"}], "}"}]}], "]"}]}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "[", "200.", "]"}], " ", "+", " ", 
         
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "[", "200.", "]"}]}], ")"}], "/", 
       "2"}], " ", "-", " ", "0.5"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[285]:= ",
 CellID->1918360181,ExpressionUUID->"39ca63f1-5b29-ac93-6fca-7abb5eddf6f9"],

Cell[TextData[{
 "Both give the same number, above the bath's ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]], "=", "10"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ddb3fe8-f924-fde1-7bf8-b6b5f8d6c7cb"],
 ": the meter alone leaves the oscillator hotter than it found it."
}], "Text",
 CellID->905478106,ExpressionUUID->"1a3c3edd-6533-5c23-4bc3-b7870cc62709"],

Cell["\<\
Now close the loop. The conditional mean is a stochastic trajectory driven by \
the innovation, with the feedback force damping the momentum estimate:\
\>", "Text",
 CellID->1698065530,ExpressionUUID->"6e06e0ed-b7e1-fe10-163d-f9b6c195c57a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Gcool", " ", "=", " ", "2."}], ";", " ", 
  RowBox[{"dtCool", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"nStepCool", " ", "=", " ", "2500"}], ";", " ", 
  RowBox[{"timesCool", " ", "=", " ", 
   RowBox[{"dtCool", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "nStepCool"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[286]:= ",
 CellID->149360148,ExpressionUUID->"092132f0-8112-8068-38de-abba30a4d2b2"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47a7abaa-7c0e-d713-6d5c-42f475b8ba79"],
 " the oscillator is thermal, so the total covariance is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1", "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6059b901-cdf2-bf42-1066-316aeb8405a8"],
 ". That total splits into the conditional floor the filter always carries \
plus the spread of the estimate about it, so the means must be drawn with the \
full ",
 StyleBox["difference", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", 
    FractionBox["1", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\|01d7d9", "-", "\[CapitalSigma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64b436e8-4ec1-9688-0c4b-afb26b75fcd2"],
 ", including its off-diagonal ",
 Cell[BoxData[
  RowBox[{"-", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["xp",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e284bac-efa5-b7a3-6628-62098a511d89"],
 ", to avoid double-counting the initial uncertainty and to make the initial \
unconditional state exactly thermal (the conditional covariance ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "223ac921-909b-296a-53d9-e08b212e7bb0"],
 " is held at its steady value throughout, the filter assumed already settled \
at its steady covariance, so the cooling transient sits entirely in the \
mean-spread ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64f5a232-c990-b984-0c8a-447fe82a0bee"],
 "):"
}], "Text",
 CellID->990508151,ExpressionUUID->"4b797f7f-c7ba-1604-7907-7738f24f7d6e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"meanRunCool", "[", 
    RowBox[{"gg_", ",", " ", "seed_"}], "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"init", " ", "=", " ", 
          RowBox[{"RandomVariate", "[", 
           RowBox[{"MultinormalDistribution", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0.", ",", " ", "0."}], "}"}], ",", "\n", "        ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                 "nCool", " ", "+", " ", "0.5", " ", "-", " ", "vxCool"}], ",",
                  " ", 
                 RowBox[{"-", "vcCool"}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "vcCool"}], ",", " ", 
                 RowBox[{
                 "nCool", " ", "+", " ", "0.5", " ", "-", " ", "vpCool"}]}], 
                "}"}]}], "}"}]}], "]"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{"kicks", " ", "=", " ", 
          RowBox[{"RandomVariate", "[", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"Sqrt", "[", "dtCool", "]"}]}], "]"}], ",", " ", 
            "nStepCool"}], "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"FoldList", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"xp", ",", " ", "dw"}], "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"xp", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"xp", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
                 RowBox[{
                  RowBox[{"gammaCool", "/", "2"}], " ", 
                  RowBox[{"xp", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], " ", "dtCool"}],
               " ", "+", " ", 
              RowBox[{"kxCool", " ", "dw"}]}], ",", "\n", "       ", 
             RowBox[{
              RowBox[{"xp", "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", "+", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"xp", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], " ", "-", " ", 
                 RowBox[{
                  RowBox[{"gammaCool", "/", "2"}], " ", 
                  RowBox[{"xp", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], " ", "-", " ", 
                 RowBox[{"gg", " ", 
                  RowBox[{"xp", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}], " ", "dtCool"}],
               " ", "+", " ", 
              RowBox[{"kpCool", " ", "dw"}]}]}], "}"}]}], "]"}], ",", "\n", 
         "     ", "init", ",", " ", "kicks"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[287]:= ",
 CellID->472375463,ExpressionUUID->"45ea52ef-3554-0907-73ea-4bc9bce1586d"],

Cell["\<\
The unconditional occupation in time is the ensemble spread of these means \
plus the conditional floor. Average over an ensemble of runs:\
\>", "Text",
 CellID->1352706751,ExpressionUUID->"5aa94cfa-2f23-80a7-0a57-65a44ad7d28d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"nEnsCool", " ", "=", " ", "120"}], ";"}]], "Input",
 CellLabel->"In[288]:= ",
 CellID->890986319,ExpressionUUID->"080683ca-9499-65d9-383d-1a941d2c4f23"],

Cell[TextData[{
 "For a feedback gain, ",
 Cell[BoxData["nDrainCool"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f690331-eebc-872f-3516-9b7a8b4eea75"],
 " runs that ensemble and returns the occupation at each sampled time, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "2"], 
   StyleBox["[",
    FontSize->1.2 Inherited], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["xx",
      FontSlant->"Plain"]], "+", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xx",
      FontSlant->"Plain"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["pp",
      FontSlant->"Plain"]], "+", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["pp",
      FontSlant->"Plain"]]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["]",
    FontSize->1.2 Inherited], "-", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65e95d55-a99f-bfd5-1397-551ec82b053f"],
 ", the mean-spread ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e95e83b-0d9e-83fb-06aa-0265a428d1c1"],
 " (read off as the ensemble variance of each conditional mean) added to the \
conditional floor ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f578f4c-339a-d4b8-056c-2716462cbe82"],
 ":"
}], "Text",
 CellID->1572592159,ExpressionUUID->"1d7a39f5-2f84-924e-4b19-b0bf4a36e094"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nDrainCool", "[", "gg_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ens", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"meanRunCool", "[", 
          RowBox[{"gg", ",", " ", "s"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"s", ",", " ", "nEnsCool"}], "}"}]}], "]"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Variance", "[", 
            RowBox[{"ens", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "j", ",", " ", "1"}], "]"}], "]"}], 
            "]"}], " ", "+", " ", "vxCool", " ", "+", " ", 
           RowBox[{"Variance", "[", 
            RowBox[{"ens", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "j", ",", " ", "2"}], "]"}], "]"}], 
            "]"}], " ", "+", " ", "vpCool"}], ")"}], "/", "2"}], " ", "-", 
        " ", "0.5"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "1", ",", " ", 
         RowBox[{"nStepCool", " ", "+", " ", "1"}], ",", " ", "25"}], "}"}]}],
       "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[289]:= ",
 CellID->523613550,ExpressionUUID->"59677bcb-6d95-6f1d-0f1d-729504203267"],

Cell[TextData[{
 "Track it with the loop open (gain ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56ec6282-f98a-b15f-7e94-7beff83c03a5"],
 ") and closed (gain ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40fbad85-d3f9-d70d-7098-44eee58dba57"],
 "):"
}], "Text",
 CellID->506908930,ExpressionUUID->"47eae38a-28ac-69e2-6de9-fad449593bc8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"coolOff", ",", " ", "coolOn"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"nDrainCool", "[", "0.", "]"}], ",", " ", 
     RowBox[{"nDrainCool", "[", "Gcool", "]"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[290]:= ",
 CellID->783859841,ExpressionUUID->"3d21e4c2-12f3-8786-64de-fdaca687edec"],

Cell["\<\
Now visualize the cooling: the occupation with the loop off (heating above \
the bath) and on (draining toward, but not reaching, the conditional floor):\
\>", "Text",
 CellID->836234808,ExpressionUUID->"72da8a28-c018-2074-22f9-2c75f1ad735e"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"timesCool", "[", 
         RowBox[{"[", 
          RowBox[{"1", " ", ";;", " ", ";;", " ", "25"}], "]"}], "]"}], ",", 
        " ", "coolOff"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"timesCool", "[", 
         RowBox[{"[", 
          RowBox[{"1", " ", ";;", " ", ";;", " ", "25"}], "]"}], "]"}], ",", 
        " ", "coolOn"}], "}"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<loop open (watching only)\>\"", ",", 
      " ", "\"\<loop closed (feedback)\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<phonon number\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<feedback cools; watching alone heats\>\""}], ",", "\n", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ColorData", "[", "97", "]"}], "[", "3", "]"}], ",", " ", 
        "Dashed"}], "]"}], ",", " ", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "nCool"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Last", "@", "timesCool"}], ",", " ", "nCool"}], "}"}]}], 
        "}"}], "]"}], ",", "\n", "   ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ColorData", "[", "97", "]"}], "[", "4", "]"}], ",", " ", 
        "Dashed"}], "]"}], ",", " ", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "condFloorCool"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Last", "@", "timesCool"}], ",", " ", "condFloorCool"}], 
          "}"}]}], "}"}], "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[291]:= ",
 CellID->410625993,ExpressionUUID->"57df3a4c-b574-c457-7de4-bc163c06aebd"],

Cell[TextData[{
 "The mean phonon number ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["b", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["b", "TI"], "^"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56b731d2-b1dc-5164-7e4c-a89fc069204e"],
 " is the oscillator's stored energy in quanta of ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0758e084-cdd2-0fbb-2d67-f9e1e4675581"],
 ", so a higher curve is a hotter oscillator and a lower one colder; cooling \
drives ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53f282fc-d9f3-c4a2-0181-1bb9df87ae88"],
 " down toward the ground state. The open loop climbs above the thermal line \
(green); the closed loop drains fast and settles well below it, above the \
conditional floor (red)."
}], "Text",
 CellID->230379626,ExpressionUUID->"065deb70-832e-a04f-2e62-033a36d8f295"],

Cell["\<\
The occupation plot shows that the loop cools, but not how. Take it apart, \
from a single record to the whole ensemble.\
\>", "Text",
 CellID->26532680,ExpressionUUID->"023a3ab5-9b7c-3e4c-33d9-b3ff1e0e8496"],

Cell[TextData[{
 "Start with one record seen twice. A fixed seed draws the same starting \
point and the same noise kicks at any gain, so running it with the loop open \
and then closed holds the disturbance fixed and leaves the feedback as the \
only difference. Track the energy of the estimate's center, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["center",
     FontSlant->"Plain"]], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["x", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], "2"], "+", 
    SuperscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["p", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0950ae2c-fd95-e5a5-3f6f-4789f421cf8f"],
 ":"
}], "Text",
 CellID->1009717036,ExpressionUUID->"63d73e3d-5e6d-9b2c-11ec-b0675b19e676"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"centerEnergy", "[", "run_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], ")"}], "/", "2"}], 
      " ", "&"}], ")"}], " ", "/@", " ", "run"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"recOff", ",", " ", "recOn"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"meanRunCool", "[", 
      RowBox[{"0.", ",", " ", "4"}], "]"}], ",", " ", 
     RowBox[{"meanRunCool", "[", 
      RowBox[{"Gcool", ",", " ", "4"}], "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"timesCool", ",", " ", 
        RowBox[{"centerEnergy", "[", "recOff", "]"}]}], "}"}], "]"}], ",", 
     " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"timesCool", ",", " ", 
        RowBox[{"centerEnergy", "[", "recOn", "]"}]}], "}"}], "]"}]}], "}"}], 
   ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<loop open (same noise)\>\"", ",", 
      " ", "\"\<loop closed (same noise)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "520"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<center energy\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<same record: feedback drains the estimate's energy\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[292]:= ",
 CellID->151019001,ExpressionUUID->"19261c33-408d-2b93-48dd-967d713879f9"],

Cell[TextData[{
 "Both traces start together. The open one wanders and stays high, since the \
bath damps the mean only at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61f29a52-27f6-2d9f-1781-1c1c518377e5"],
 ", far too slowly to remove the energy the noise pours in; the closed one, \
under the identical noise, is pulled down within a couple of periods and \
holds low. Same disturbance, opposite fate: the loop turns the record into a \
force that carries energy out."
}], "Text",
 CellID->1656643860,ExpressionUUID->"39b8808a-080a-fb1f-6f47-19d4a9bcc665"],

Cell[TextData[{
 "How much energy? The feedback force ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["G", "TI"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["p", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01c3b6b5-4696-f194-37f0-2fff7320c3fe"],
 " opposes the velocity, so it does work at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["G", "TI"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["p", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41915581-04ed-47bc-77af-4cebac982d86"],
 "; accumulate it along the closed record, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["removed",
     FontSlant->"Plain"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["G", "TI"], 
   SubsuperscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"]], 
   SuperscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["p", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], "2"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3329119b-60db-b2d6-62d6-88c5116f003c"],
 ":"
}], "Text",
 CellID->24370237,ExpressionUUID->"1615cf65-d1a2-5497-3e2a-e74ee0573efd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"extractedWork", "[", 
    RowBox[{"run_", ",", " ", "gg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"gg", " ", "dtCool", " ", 
      RowBox[{"Accumulate", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "&"}], ")"}], 
        " ", "/@", " ", 
        RowBox[{"Most", "[", "run", "]"}]}], "]"}]}], ",", " ", "0."}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"timesCool", ",", " ", 
      RowBox[{"extractedWork", "[", 
       RowBox[{"recOn", ",", " ", "Gcool"}], "]"}]}], "}"}], "]"}], ",", "\n",
    " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"ColorData", "[", 
     RowBox[{"97", ",", " ", "2"}], "]"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "520"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<energy removed by feedback\>\""}],
      "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<cooling is a steady drain, not a one-time act\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[293]:= ",
 CellID->730383262,ExpressionUUID->"1cd77268-421f-8518-44ed-743277abec62"],

Cell["\<\
The curve climbs and never flattens, and the work it reports far outruns the \
few units the estimate's energy actually fell. That gap is the mechanism: \
measurement back-action and the bath keep pouring energy in, and the feedback \
keeps taking it back out. Once the oscillator is cold the loop does not stop; \
it runs on to hold it there, the shock absorber built from a measurement, \
doing work forever against the noise.\
\>", "Text",
 CellID->304869518,ExpressionUUID->"47ae9621-0454-0efb-6d55-0f8bade154c1"],

Cell[TextData[{
 "One record is one draw; cooling is a statement about the whole ensemble. \
Scatter the endpoint of the estimate's center, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["x", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["p", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "750c318a-354e-3de3-2333-a8d4bcf887c9"],
 ", across many records, loop open against closed:"
}], "Text",
 CellID->1481638679,ExpressionUUID->"31301a4b-de00-df4c-60cf-9c14dbbaa596"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cloudCool", "[", "gg_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"meanRunCool", "[", 
        RowBox[{"gg", ",", " ", "#"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}], " ", "&"}], ")"}], " ", "/@", " ", 
    RowBox[{"Range", "[", "nEnsCool", "]"}]}]}], ";"}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cloudCool", "[", "0.", "]"}], ",", " ", 
     RowBox[{"cloudCool", "[", "Gcool", "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"Opacity", "[", "0.5", "]"}], ",", " ", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"Opacity", "[", "0.6", "]"}], ",", " ", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}]}], "]"}]}], "}"}]}], ",", "\n", 
   " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<loop open\>\"", ",", " ", "\"\<loop closed\>\""}], "}"}]}], 
   ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "14"}], ",", " ", "14"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "14"}], ",", " ", "14"}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<feedback pulls the cloud of estimates in\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[294]:= ",
 CellID->1624629187,ExpressionUUID->"7bf891b7-a846-9636-2987-08f0c9f0fd1c"],

Cell[TextData[{
 "The open-loop centers sprawl across phase space, still spreading because \
nothing damps them; the closed-loop centers collapse into a tight knot at the \
origin. That knot is the mean-spread ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "470c2033-8417-1ad4-6d33-ba7d2da2683e"],
 ", the covariance of where the estimate sits across records, and feedback is \
what pulls it in."
}], "Text",
 CellID->251976942,ExpressionUUID->"5ad9af22-3fdb-49f9-0ae6-468cba6e1bc3"],

Cell[TextData[{
 "The knot is only part of the uncertainty. What an outside observer sees is \
that spread ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cf910a9-0c85-fbc1-7486-89f3a531c92b"],
 " blurred by the conditional floor ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "452c77a0-bd62-5a53-6cd4-6e0a341728b9"],
 ", how sharply the filter knows each single history, the two adding to the \
total covariance ",
 Cell[BoxData[
  RowBox[{"\[CapitalSigma]", "+", 
   StyleBox["S", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "433c54f0-eae1-518a-72c4-4dbd8e9423d0"],
 ". Draw the one-sigma ellipses of the floor ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60391242-a9f1-d17d-11c6-942fcf85a047"],
 " and of the total ",
 Cell[BoxData[
  RowBox[{"\[CapitalSigma]", "+", 
   StyleBox["S", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c69146-bf62-c611-77fd-09203a14ad7b"],
 ", open and closed. The spread solves the Lyapunov balance of the previous \
block, so these are exact, with no sampling:"
}], "Text",
 CellID->1001631779,ExpressionUUID->"5c6c9045-c767-8f66-0413-0a2ef213d24c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"condCovCool", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vxCool", ",", " ", "vcCool"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"vcCool", ",", " ", "vpCool"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"spreadCool", "[", "gg_", "]"}], " ", ":=", " ", 
   RowBox[{"LyapunovSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "gammaCool"}], "/", "2"}], ",", " ", "1"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "gammaCool"}], "/", "2"}], " ", "-", " ", "gg"}]}], 
        "}"}]}], "}"}], ",", " ", 
     RowBox[{"-", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"kxCool", "^", "2"}], ",", " ", 
          RowBox[{"kxCool", " ", "kpCool"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"kxCool", " ", "kpCool"}], ",", " ", 
          RowBox[{"kpCool", "^", "2"}]}], "}"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"{", "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ColorData", "[", 
          RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", "Thick", ",", " ", 
         RowBox[{"Line", "[", 
          RowBox[{"covarianceEllipse", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"condCovCool", " ", "+", " ", 
             RowBox[{"spreadCool", "[", "0.", "]"}]}]}], "]"}], "]"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ColorData", "[", 
          RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", "Thick", ",", " ", 
         RowBox[{"Line", "[", 
          RowBox[{"covarianceEllipse", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"condCovCool", " ", "+", " ", 
             RowBox[{"spreadCool", "[", "Gcool", "]"}]}]}], "]"}], "]"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"Black", ",", " ", "Thick", ",", " ", "Dashed", ",", " ", 
         RowBox[{"Line", "[", 
          RowBox[{"covarianceEllipse", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "condCovCool"}], 
           "]"}], "]"}]}], "}"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "5"}], ",", " ", "5"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "400"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",", " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<feedback shrinks the total toward the fixed floor\>\""}]}], 
    "]"}], ",", "\n", " ", 
   RowBox[{"LineLegend", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ColorData", "[", 
        RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
       RowBox[{"ColorData", "[", 
        RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", " ", "Dashed"}], "]"}]}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<total \[CapitalSigma]+S, open\>\"", ",", 
       " ", "\"\<total \[CapitalSigma]+S, closed\>\"", ",", 
       " ", "\"\<conditional floor \[CapitalSigma]\>\""}], "}"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[295]:= ",
 CellID->131866538,ExpressionUUID->"54c0d9f6-8cd5-48f4-7cff-d0b025601ade"],

Cell[TextData[{
 "The two solid ellipses are the whole state the world sees; the dashed one \
is the floor the measurement sets. Feedback pulls the wide open ellipse down \
almost onto the closed one, but it halts at the dashed floor and cannot cross \
it. And the floor is identical open and closed: feedback is a Hamiltonian, so \
it moves where the estimate sits, never how sharply the filter knows it, \
shrinking ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10c2afdf-1c4a-6aca-40f1-469995ff3810"],
 " alone and leaving ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e6400ee-92df-7263-561b-99c8276a4149"],
 " fixed. The gap left between the closed ellipse and the floor is the \
residual the next plot minimizes over the gain; the dashed floor is the cold \
that no gain can beat."
}], "Text",
 CellID->2120574329,ExpressionUUID->"6a2c3e4c-43bd-aee6-1bd3-b0167649f4cc"],

Cell["\<\
How hard should the loop push? Sweep the gain and read the steady occupation \
off the exact Lyapunov balance:\
\>", "Text",
 CellID->905900721,ExpressionUUID->"2da42c23-5972-22c8-5b5b-c58d58077012"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gainsCool", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", "12", ",", " ", "0.1"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"gainsCool", ",", " ", 
      RowBox[{"nUncCool", " ", "/@", " ", "gainsCool"}]}], "}"}], "]"}], ",", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<feedback gain G\>\"", ",", 
      " ", "\"\<steady phonon number\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<an optimal gain: too little leaves it warm, too much feeds \
noise back\>\""}], ",", "\n", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ColorData", "[", "97", "]"}], "[", "3", "]"}], ",", " ", 
        "Dashed"}], "]"}], ",", " ", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "nCool"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Last", "@", "gainsCool"}], ",", " ", "nCool"}], "}"}]}], 
        "}"}], "]"}], ",", "\n", "   ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ColorData", "[", "97", "]"}], "[", "4", "]"}], ",", " ", 
        "Dashed"}], "]"}], ",", " ", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "condFloorCool"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Last", "@", "gainsCool"}], ",", " ", "condFloorCool"}], 
          "}"}]}], "}"}], "]"}]}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[296]:= ",
 CellID->30454613,ExpressionUUID->"1c8af9dd-094d-d766-4489-f087a8f9ba4c"],

Cell[TextData[{
 "The occupation falls steeply from the heated open-loop value, reaches a \
minimum near the gain chosen above, then rises again. Beyond the optimum the \
loop feeds the estimate's own measurement noise back onto the oscillator: \
this is the imprecision-back-action tradeoff, between the shot-noise blur on \
the record (the ",
 StyleBox["imprecision", "TI"],
 ") and the momentum kick that reading the position costs (the back-action), \
and it caps every real feedback-cooling experiment. It never reaches the \
conditional floor (red): that would need a noiseless actuator, the element \
that applies the feedback force, acting on a perfectly known state."
}], "Text",
 CellID->936073442,ExpressionUUID->"7cc0f9d1-2fd7-9dda-24ff-f09b4a63e720"],

Cell[TextData[{
 "Finally, a better detector lowers both the floor and the achievable cold. \
Repeat the floor-plus-spread Lyapunov balance at efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6090c20f-1226-92f3-10af-e469a7d0e0d9"],
 ", where the conditional covariance sharpens and the gain becomes ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    StyleBox[
     RowBox[{"\[Eta]", "k"}], "TI"]], "\[ThinSpace]", "\[CapitalSigma]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05991ec7-58a0-3f5d-33a6-97a1595a85a7"],
 ", holding ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d6d1e2a-2e52-ea78-3b12-90744be4b942"],
 " fixed at its ideal-detector value (not re-optimized per ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "514c4c6c-8022-d8b7-0774-663631d4aa9d"],
 ", so the cooled curve is conservative at low ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68df41a8-6354-4794-18e5-58f216e12dfe"],
 "):"
}], "Text",
 CellID->2004769691,ExpressionUUID->"6341ee00-46aa-0ad7-117e-006a735f583d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nUncCoolEta", "[", 
    RowBox[{"\[Eta]_", ",", " ", "gg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"steadyCovCool", "[", "\[Eta]", "]"}]}], ",", " ", "kx", ",", 
       " ", "kp", ",", " ", "s"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"kx", " ", "=", " ", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"\[Eta]", " ", "kCool"}], "]"}], " ", 
        RowBox[{"c", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", " ", 
      RowBox[{"kp", " ", "=", " ", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"\[Eta]", " ", "kCool"}], "]"}], " ", 
        RowBox[{"c", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\n", "   ", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"LyapunovSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "gammaCool"}], "/", "2"}], ",", " ", "1"}], "}"}], 
           ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "gammaCool"}], "/", "2"}], " ", "-", " ", 
              "gg"}]}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"-", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"kx", "^", "2"}], ",", " ", 
              RowBox[{"kx", " ", "kp"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"kx", " ", "kp"}], ",", " ", 
              RowBox[{"kp", "^", "2"}]}], "}"}]}], "}"}]}]}], "]"}]}], ";", 
      "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"s", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
          RowBox[{"c", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
          RowBox[{"s", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "+", " ", 
          RowBox[{"c", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "/", "2"}], " ", "-", " ",
        "0.5"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[297]:= ",
 CellID->1569231351,ExpressionUUID->"51765390-551f-8be6-070e-4ada5cabd9cc"],

Cell[TextData[{
 "Sweep the efficiency from a poor detector, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "0.2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "651ec994-b5cc-7852-1325-e0de3c794ab8"],
 ", to a perfect one:"
}], "Text",
 CellID->1612045584,ExpressionUUID->"04ab5aad-5ed8-49aa-2ca9-53f75b6d1bf0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"etasCool", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0.2", ",", " ", "1", ",", " ", "0.01"}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[298]:= ",
 CellID->1224848414,ExpressionUUID->"3f9eb20d-625d-c280-65a5-345717e990ea"],

Cell["\<\
Plot the conditional floor and the fixed-gain cooled occupation against \
efficiency:\
\>", "Text",
 CellID->152101747,ExpressionUUID->"62e46a02-3a5b-686c-129b-8c6cbfee3ab6"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"etasCool", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "/", "2"}], " ", "-", 
           " ", "0.5"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"(", 
          RowBox[{"steadyCovCool", " ", "/@", " ", "etasCool"}], ")"}]}]}], 
       "}"}], "]"}], ",", "\n", "   ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"etasCool", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"nUncCoolEta", "[", 
           RowBox[{"#", ",", " ", "Gcool"}], "]"}], " ", "&"}], " ", "/@", 
         " ", "etasCool"}]}], "}"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<conditional floor\>\"", ",", 
      " ", "\"\<cooled occupation (fixed gain)\>\""}], "}"}]}], ",", "\n", 
   " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<detector efficiency\>\"", ",", 
      " ", "\"\<phonon number\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", " ", "\"\<a better detector cools colder\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[299]:= ",
 CellID->1101372283,ExpressionUUID->"5622c27e-fa64-d20c-7fd1-e43bff16a156"],

Cell["\<\
Both curves fall as the detector improves, and the gap between them is the \
price of noisy actuation. This is measurement-based cooling of a \
nanomechanical drum or a levitated nanoparticle toward its ground state, not \
by contact with something colder but by watching precisely and pushing back: \
the same conditional covariance that told the Kalman filter how well it could \
track now sets how cold the feedback can pull.\
\>", "Text",
 CellID->137398679,ExpressionUUID->"71a9abed-5fb9-62e0-2756-42b75a4c30ca"],

Cell["Part Seven: Two Bookkeepings, and the Colour of the Light", "Section",
 CellID->1953556957,ExpressionUUID->"61558bcf-8725-3a67-176a-22a932d1894d"],

Cell["Linear vs Nonlinear: One Trajectory, Two Descriptions", "Subsection",
 CellID->943903693,ExpressionUUID->"5da858a5-47c1-808d-0ba8-510f7275d2d7"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " One diffusive history, written under two probability measures. Under a \
reference Wiener measure ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f9bb61a-aee2-f350-65b8-2847ca94c1ba"],
 ", the ",
 StyleBox["linear", "TI"],
 " stochastic Schrodinger equation runs an unnormalized state under plain \
noise,"
}], "Text",
 CellID->292818558,ExpressionUUID->"4e748159-8484-6d12-760b-19032d313478"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    OverscriptBox[
     StyleBox["\[Psi]", "TI"], "~"], "=", 
    StyleBox["K", "TI"], "\[ThinSpace]", 
    OverscriptBox[
     StyleBox["\[Psi]", "TI"], "~"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->False], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["R", "TI"], "^"], 
     StyleBox["j", "TI"]], "\[ThinSpace]", 
    OverscriptBox[
     StyleBox["\[Psi]", "TI"], "~"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["j", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "0", 
      StyleBox[")",
       SpanMaxSize->1]}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["K", "TI"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       StyleBox["i", "TI"]}], 
      OverscriptBox[
       StyleBox["H", "TI"], "^"]}], "-", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        StyleBox["j", "TI"],
        LimitsPositioning->False], 
       RowBox[{
        SubsuperscriptBox[
         OverscriptBox[
          StyleBox["R", "TI"], "^"], 
         StyleBox["j", "TI"], "\[Dagger]"], 
        RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["R", "TI"], "^"], 
          StyleBox["j", "TI"]], "."}]}]}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->264739147,ExpressionUUID->"7930e290-b167-c2f9-28cf-fbddc01390c3"],

Cell[TextData[{
 "Its squared norm is the Radon-Nikodym likelihood density ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["P", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fb17bb4-4674-882a-654f-72fe7306db70"],
 " of the physical record measure relative to ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28bf2227-b714-1237-5844-bb80c2a1611d"],
 " up to that time, not an absolute probability for one continuous record. \
Under the physical measure ",
 Cell[BoxData[
  StyleBox["P", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b8c3639-ce66-7d16-69b3-a862eb13447c"],
 ", the normalized master equation is driven by the innovation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["W", "TI"], "^"], 
    StyleBox["j", "TI"]], "=", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["j", "TI"]], "-", 
   SubscriptBox[
    StyleBox["v", "TI"], 
    StyleBox["j", "TI"]], 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a55be4f-f4c1-c728-6a6a-3028fd75aa72"],
 " of the observed increment ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "408944f1-25be-34c3-70b7-5dbb4c489e29"],
 ","
}], "Text",
 CellID->1237098126,ExpressionUUID->"6769d722-bdd2-9791-0d16-ce8c3464fdfb"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", "\[ScriptCapitalL]", 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->False], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["R", "TI"], "^"], 
      StyleBox["j", "TI"]], 
     StyleBox["\[Rho]", "TI"], "+", 
     StyleBox["\[Rho]", "TI"], 
     SubsuperscriptBox[
      OverscriptBox[
       StyleBox["R", "TI"], "^"], 
      StyleBox["j", "TI"], "\[Dagger]"], "-", 
     SubscriptBox[
      StyleBox["v", "TI"], 
      StyleBox["j", "TI"]], 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["W", "TI"], "^"], 
     StyleBox["j", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["j", "TI"]], "=", 
    RowBox[{"2", "\[ThinSpace]", 
     StyleBox["Re",
      FontSlant->"Plain"], "\[ThinSpace]", 
     RowBox[{
      RowBox[{
       StyleBox["Tr",
        FontSlant->"Plain"], 
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["R", "TI"], "^"], 
         StyleBox["j", "TI"]], 
        StyleBox["\[Rho]", "TI"]}], 
       StyleBox["]",
        SpanMaxSize->1]}], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->294194286,ExpressionUUID->"0930076b-5510-ea29-38cf-9f355caab973"],

Cell["\<\
The useful fact is that the reference-measure average of the unnormalized \
projectors is the master-equation state. Build the linear version and check.\
\>", "Text",
 CellID->757102330,ExpressionUUID->"66fe4c41-b67c-2d6f-0e86-662ac30977b5"],

Cell[TextData[{
 "One diffusive trajectory has two equivalent descriptions. The ",
 StyleBox["nonlinear",
  FontWeight->"Bold"],
 " SME (used so far) carries the normalized state and renormalizes each step. \
The ",
 StyleBox["linear",
  FontWeight->"Bold"],
 " SSE carries an unnormalized state under the zero-drift reference noise ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["W", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "0", 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08adeec7-f156-e6d0-3852-07a080e0cc3a"],
 ", the noise of a reference measure ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64d088ea-03f9-e45d-0cef-21b4b58dcea7"],
 " that reads every record as signal-free noise, and never renormalizes,"
}], "Text",
 CellID->296089063,ExpressionUUID->"6f15138c-0e8c-8125-152a-8ad6ab3ed00f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     TemplateBox[{
       OverscriptBox[
        StyleBox["\[Psi]", "TI"], "~"]},
      "Ket"]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"-", 
        StyleBox["i", "TI"], 
        OverscriptBox[
         StyleBox["H", "TI"], "^"], "-", 
        FractionBox["1", "2"], 
        SuperscriptBox[
         OverscriptBox[
          StyleBox["c", "TI"], "^"], "\[Dagger]"], 
        OverscriptBox[
         StyleBox["c", "TI"], "^"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      TemplateBox[{
        OverscriptBox[
         StyleBox["\[Psi]", "TI"], "~"]},
       "Ket"], 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{
      OverscriptBox[
       StyleBox["c", "TI"], "^"], 
      TemplateBox[{
        OverscriptBox[
         StyleBox["\[Psi]", "TI"], "~"]},
       "Ket"], 
      StyleBox["d", "TI"], 
      StyleBox["J", "TI"]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox[
     RowBox[{"d", "J"}], "TI"], "=", 
    RowBox[{
     StyleBox["d", "TI"], 
     SuperscriptBox[
      StyleBox["W", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], "0", 
       StyleBox[")",
        SpanMaxSize->1]}]], " ", 
     StyleBox["under",
      FontSlant->"Plain"], " ", 
     RowBox[{
      StyleBox["Q", "TI"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1606580443,ExpressionUUID->"405f258f-ff79-d7cb-7064-bce8fa0dbd11"],

Cell[TextData[{
 "Two facts turn this single equation into the section. Its squared norm ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], "=", 
   TemplateBox[{
     OverscriptBox[
      StyleBox["\[Psi]", "TI"], "~"], 
     OverscriptBox[
      StyleBox["\[Psi]", "TI"], "~"]},
    "BraKet"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03e55ba9-fe94-2332-319b-52f2fb268e18"],
 " is the likelihood ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["P", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a76882c-12fa-ddf2-5a0d-2276a68ca7d8"],
 " that reweights ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d3ef6c8-e314-d687-74c5-ef9596a6bced"],
 " into the physical measure ",
 Cell[BoxData[
  StyleBox["P", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "743a182c-0f06-6831-1dd9-9276aab33b1b"],
 "; and the plain ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42c100d4-e672-0739-72fe-999193076a03"],
 "-average of the unnormalized projectors ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     OverscriptBox[
      StyleBox["\[Psi]", "TI"], "~"]},
    "Ket"], 
   TemplateBox[{
     OverscriptBox[
      StyleBox["\[Psi]", "TI"], "~"]},
    "Bra"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06047db6-ee6f-8c38-2e3c-74f38b1bd702"],
 " is the master-equation state ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["\[Rho]", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11613fd8-84a9-9cd5-471e-b6822d5de63f"],
 ", carried with no reweighting. Take the average first, the weight second."
}], "Text",
 CellID->2086732509,ExpressionUUID->"42148f44-8d63-ba11-722b-272e2417097b"],

Cell[TextData[{
 "The average is two lines of Ito calculus. With ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "~"], "=", 
   RowBox[{
    TemplateBox[{
      OverscriptBox[
       StyleBox["\[Psi]", "TI"], "~"]},
     "Ket"], 
    TemplateBox[{
      OverscriptBox[
       StyleBox["\[Psi]", "TI"], "~"]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15b08668-721a-3691-434f-183207ac9cfb"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["J", "TI"], "2"], "=", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29a1e51d-1380-e9cf-5f5e-fd47a63abb15"],
 ", the drift terms collect into the Lindbladian and the noise into one \
trace-free term,"
}], "Text",
 CellID->1259953946,ExpressionUUID->"21898f1f-7ce2-17d9-57b6-275974977d23"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "~"], "=", "\[ScriptCapitalL]", 
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "~"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     OverscriptBox[
      StyleBox["\[Rho]", "TI"], "~"], "+", 
     OverscriptBox[
      StyleBox["\[Rho]", "TI"], "~"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["c", "TI"], "^"], "\[Dagger]"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "0", 
      StyleBox[")",
       SpanMaxSize->1]}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->544170496,ExpressionUUID->"4692cd91-7435-14b3-6ea1-e4db7dc07e99"],

Cell[TextData[{
 "Under ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "000a09f6-5b3f-ef45-3009-a0b05ecbb5af"],
 " the increment ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["W", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "0", 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29133634-70e6-2af3-5f20-a87e009378d9"],
 " has zero mean, so averaging erases the stochastic term and the mean \
unnormalized state obeys the master equation on its own, ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    StyleBox["d", "TI"], 
    StyleBox[
     RowBox[{"d", "t"}], "TI"]], 
   SubscriptBox["\|01d53c", 
    StyleBox["Q", "TI"]], 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "~"], 
   StyleBox["]",
    SpanMaxSize->1], "=", "\[ScriptCapitalL]", "\[ThinSpace]", 
   SubscriptBox["\|01d53c", 
    StyleBox["Q", "TI"]], 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "~"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59a11c54-6c5b-70c2-0f5e-961e05ee4228"],
 ", hence ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\|01d53c", 
    StyleBox["Q", "TI"]], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "~"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "_"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2480a9a0-11fa-1869-4cbf-400aa78f6ab3"],
 ". Fix the atom and the non-Hermitian drift ",
 Cell[BoxData[
  RowBox[{
   StyleBox["K", "TI"], "=", "-", 
   StyleBox["i", "TI"], 
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "-", 
   FractionBox["1", "2"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bc2c5e6-2df7-f0b4-79f1-dcc04b83c29e"],
 ":"
}], "Text",
 CellID->186431800,ExpressionUUID->"2d4459f2-9267-9bdb-5b7c-50bc2713e921"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalOmega]lin", " ", "=", " ", "2."}], ";", " ", 
  RowBox[{"cLin", " ", "=", " ", "lower"}], ";", " ", 
  RowBox[{"Knh", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{"(", 
      RowBox[{"\[CapitalOmega]lin", "/", "2"}], ")"}], " ", "X"}], " ", "-", 
    " ", 
    RowBox[{
     RowBox[{
      RowBox[{"ConjugateTranspose", "[", "cLin", "]"}], " ", ".", " ", 
      "cLin"}], "/", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"step", " ", "=", " ", "0.005"}], ";", " ", 
  RowBox[{"steps", " ", "=", " ", "600"}], ";"}]}], "Input",
 CellLabel->"In[300]:= ",
 CellID->480122852,ExpressionUUID->"2830cc4d-ff27-6d9e-59cf-e616fad237e4"],

Cell["One unnormalized run under plain noise, never renormalizing:", "Text",
 CellID->1734463933,ExpressionUUID->"28a95ddb-d98e-e41c-5857-5484d838cf66"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"linearRun", "[", "seed_", "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "    ", 
     RowBox[{"Fold", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#1", " ", "+", " ", 
         RowBox[{
          RowBox[{"Knh", " ", ".", " ", "#1"}], " ", "step"}], " ", "+", " ", 
         
         RowBox[{
          RowBox[{"cLin", " ", ".", " ", "#1"}], " ", "#2"}]}], " ", "&"}], ",",
        " ", "excited", ",", " ", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"Sqrt", "[", "step", "]"}]}], "]"}], ",", " ", "steps"}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[301]:= ",
 CellID->1234622209,ExpressionUUID->"0df78371-259d-4014-3b8c-1b3b4c28137e"],

Cell["Run four hundred of them:", "Text",
 CellID->231537097,ExpressionUUID->"2757147d-ed01-5031-4d6c-8e2684b4231b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"linearStates", " ", "=", " ", 
   RowBox[{"linearRun", " ", "/@", " ", 
    RowBox[{"Range", "[", "400", "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[302]:= ",
 CellID->98463751,ExpressionUUID->"0d7703a7-7e82-d2bb-3b0c-9a017b34a081"],

Cell[TextData[{
 "Average the unnormalized projectors, each already carrying its weight ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], "=", "\[DoubleVerticalBar]", 
   OverscriptBox[
    StyleBox["\[Psi]", "TI"], "~"], 
   SuperscriptBox["\[DoubleVerticalBar]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "313bd3d6-a81b-5e6e-60d8-ca93c9ae24b4"],
 " in its trace, so no separate reweighting is applied:"
}], "Text",
 CellID->753959217,ExpressionUUID->"25416759-7698-4697-537f-7f03032d2cfd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"linearAverage", " ", "=", " ", 
   RowBox[{"Mean", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", " ", "#", ",", " ", 
        RowBox[{"Conjugate", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@", 
     " ", "linearStates"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[303]:= ",
 CellID->294573205,ExpressionUUID->"0a04e1f2-9872-3cce-3a3b-f8bc19048614"],

Cell["Measure the gap to the master equation:", "Text",
 CellID->1849429623,ExpressionUUID->"55e5145d-e893-2f9b-039a-8e06892675e1"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "@", 
   RowBox[{"Flatten", "[", 
    RowBox[{"linearAverage", " ", "-", " ", 
     RowBox[{"evolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[CapitalOmega]lin", "/", "2"}], ")"}], " ", "X"}], ",", 
       " ", 
       RowBox[{"{", "cLin", "}"}], ",", " ", 
       RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", 
       RowBox[{"steps", " ", "step"}]}], "]"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[304]:= ",
 CellID->2063060035,ExpressionUUID->"6ed6f41e-2589-ab78-16ed-ee584c3df642"],

Cell[TextData[{
 "The unweighted reference-measure average lands on the master equation \
within Monte-Carlo scatter and Euler time-step error, the numerical face of \
",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\|01d53c", 
    StyleBox["Q", "TI"]], 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "~"], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "_"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3da09602-cd29-7167-6b5f-086fe4dc404d"],
 ", reached with no pathwise renormalization."
}], "Text",
 CellID->1518183935,ExpressionUUID->"513edd1a-c798-2d92-00c5-d547f22d77f8"],

Cell[TextData[{
 "Now the weight. The squared norm ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], "=", 
   TemplateBox[{
     OverscriptBox[
      StyleBox["\[Psi]", "TI"], "~"], 
     OverscriptBox[
      StyleBox["\[Psi]", "TI"], "~"]},
    "BraKet"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "785f55ac-af04-4296-2865-4c09cab110fc"],
 " is not conserved, and its own increment is where the likelihood sits. The \
non-Hermitian drift is built so that ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["K", "TI"], "\[Dagger]"], "+", 
   StyleBox["K", "TI"], "+", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "052128e6-0c43-261a-2cde-c1c0a5f78d60"],
 ", which cancels every ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e2f36be-77c2-3eec-27d4-aff802748436"],
 " term in ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "w"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "599300c3-8067-324a-0fa0-99ad31138090"],
 " and leaves the norm driven purely by the record,"
}], "Text",
 CellID->18082725,ExpressionUUID->"499316cf-6a51-b537-7fa0-8fa90fe51c1d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["w", "TI"], "=", 
    StyleBox["w", "TI"], "\[ThinSpace]", 
    StyleBox["v", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["J", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["v", "TI"], "=", 
    RowBox[{
     SubscriptBox[
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       RowBox[{
        OverscriptBox[
         StyleBox["c", "TI"], "^"], "+", 
        SuperscriptBox[
         OverscriptBox[
          StyleBox["c", "TI"], "^"], "\[Dagger]"]}], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], 
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], 
       StyleBox["c", "TI"]]], "=", 
     RowBox[{"2", "\[ThinSpace]", 
      StyleBox["Re",
       FontSlant->"Plain"], "\[ThinSpace]", 
      RowBox[{
       StyleBox["Tr",
        FontSlant->"Plain"], 
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        OverscriptBox[
         StyleBox["c", "TI"], "^"], 
        SubscriptBox[
         StyleBox["\[Rho]", "TI"], 
         StyleBox["c", "TI"]]}], 
       StyleBox["]",
        SpanMaxSize->1]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->594665356,ExpressionUUID->"2ee16f17-0b65-9d18-569e-8751ae11e462"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["c", "TI"]], "=", 
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "~"], "/", 
   StyleBox["w", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37a44649-1fc9-173d-5d5c-58139a7c7a07"],
 " the normalized state. Under ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7727b6f7-2c3c-391d-1edc-2fb145ce8867"],
 " this drift-free increment makes ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a1eaa68-7ffb-b035-2a25-4c32798f031f"],
 " a mean-one martingale, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\|01d53c", 
    StyleBox["Q", "TI"]], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["w", "TI"], 
   StyleBox["]",
    SpanMaxSize->1], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b1e6369-8b0d-e6b2-2926-7b332eb9cc98"],
 ": exactly the statement that ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], "=", 
   StyleBox["d", "TI"], 
   StyleBox["P", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75aad74d-bf75-38f5-23a9-cf173a018adf"],
 " is a probability reweighting. Its logarithm accumulates the running \
log-likelihood,"
}], "Text",
 CellID->1466535282,ExpressionUUID->"1c40da22-9bf5-6106-447f-d38c1d80306c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["log",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["w", "TI"], "=", 
    StyleBox["v", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["J", "TI"], "-", 
    FractionBox["1", "2"], 
    SuperscriptBox[
     StyleBox["v", "TI"], "2"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->5140989,ExpressionUUID->"03b56da4-ec92-94f9-314a-84018524fec3"],

Cell[TextData[{
 "climbing when a record increment aligns with the state's predicted signal \
",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dcedae6-c63c-0fd1-0bf5-d3c3f3c9553b"],
 " and falling when it contradicts it. The finite seeded Euler sample of ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "027aacd9-8b9b-ca0d-3219-45832e2f9957"],
 " should sit near one:"
}], "Text",
 CellID->1694956232,ExpressionUUID->"018fad51-cc5f-c6f3-37b4-451ae5ebacd9"],

Cell[BoxData[
 RowBox[{"Mean", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Re", "[", 
     RowBox[{
      RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "#"}], "]"}], " ", 
    "&"}], " ", "/@", " ", "linearStates"}], "]"}]], "Input",
 CellLabel->"In[305]:= ",
 CellID->1547387255,ExpressionUUID->"792601a7-7c2e-1618-28dd-980175db7d62"],

Cell["\<\
Different reference-noise histories carry different likelihood-ratio weights.\
\
\>", "Text",
 CellID->1779178186,ExpressionUUID->"422fa001-3abb-a233-73d4-3a6bbf4ff119"],

Cell["Now visualize the distribution of their likelihood weights:", "Text",
 CellID->1879667817,ExpressionUUID->"5d968898-757e-5b71-0bad-21c27c0b265b"],

Cell[BoxData[
 RowBox[{"Histogram", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{
       RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "#"}], "]"}], " ",
      "&"}], " ", "/@", " ", "linearStates"}], ",", " ", "30", ",", 
   " ", "\"\<PDF\>\"", ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<likelihood-ratio weight dP/dQ\>\"", ",", 
      " ", "\"\<density\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<reference histories carry likelihood-ratio weights\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[306]:= ",
 CellID->1098063480,ExpressionUUID->"5c787eaa-3916-aaa9-0418-77f4b8a0f8f3"],

Cell[TextData[{
 "These weights organize the section into a single identity. The unnormalized \
projector is the weighted normalized state, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "~"], "=", 
   StyleBox["w", "TI"], 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "321c9a0a-53e4-3b3a-6223-1c5465968600"],
 ", so the unweighted ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4556754e-32f3-38f6-736e-6d2846878adc"],
 "-average of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["\[Rho]", "TI"], "~"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21d5e407-72d6-097c-57ea-fe6107635846"],
 ", the weighted ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3df2759c-2159-6077-6b82-6cc650ec335d"],
 "-average of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1353847d-73f3-4ff8-4160-1e27058615c2"],
 ", and the physical ",
 Cell[BoxData[
  StyleBox["P", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023adce6-f477-0954-33d9-d5c3fd025bbe"],
 "-average of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76eb59fc-b473-b7c5-1ee9-50a63d071d2f"],
 " are one and the same master-equation state,"
}], "Text",
 CellID->125264178,ExpressionUUID->"7dd80473-c718-e3dd-2be7-9e3cf292b127"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\|01d53c", 
     StyleBox["Q", "TI"]], 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "~"], 
    StyleBox["]",
     SpanMaxSize->1], "\[ThickSpace]", "=", "\[ThickSpace]", 
    SubscriptBox["\|01d53c", 
     StyleBox["Q", "TI"]], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["w", "TI"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["c", "TI"]]}], 
    StyleBox["]",
     SpanMaxSize->1], "\[ThickSpace]", "=", "\[ThickSpace]", 
    SubscriptBox["\|01d53c", 
     StyleBox["P", "TI"]], 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], "\[ThickSpace]", "=", "\[ThickSpace]", 
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "_"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->812677712,ExpressionUUID->"0073a097-0f1d-653d-3000-39d1aaa84c07"],

Cell[TextData[{
 "The middle equality is the change of measure, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\|01d53c", 
    StyleBox["Q", "TI"]], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["w", "TI"], "\[ThinSpace]", 
    StyleBox["X", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   SubscriptBox["\|01d53c", 
    StyleBox["P", "TI"]], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["X", "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "265272e3-db49-f23d-4e62-6bccdefdc107"],
 " when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], "=", 
   StyleBox["d", "TI"], 
   StyleBox["P", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4172bb43-7495-39b2-7701-332d7d218b98"],
 ", and it is where the weight earns its keep. Drop it, average the same \
normalized states under ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230bdc3d-d065-76ac-5108-d666e1105cf6"],
 " with equal weight, and the result is not ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["\[Rho]", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7083369b-c5f9-1da2-20b0-afc4f38c6788"],
 ", because ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "600ff364-211e-db59-1034-eb4e50a8a9a3"],
 " draws records at the wrong physical frequencies. Put the three averages \
side by side at the final time:"
}], "Text",
 CellID->93844439,ExpressionUUID->"540b5a94-14ca-6d57-7c09-53de9d7f37bd"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ws", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "#"}], "]"}], 
        " ", "&"}], " ", "/@", " ", "linearStates"}]}], ",", "\n", "   ", 
     RowBox[{"tildes", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Outer", "[", 
         RowBox[{"Times", ",", " ", "#", ",", " ", 
          RowBox[{"Conjugate", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
        " ", "linearStates"}]}], ",", "\n", "   ", 
     RowBox[{"ref", " ", "=", " ", 
      RowBox[{"evolve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalOmega]lin", "/", "2"}], ")"}], " ", "X"}], ",", 
        " ", 
        RowBox[{"{", "cLin", "}"}], ",", " ", 
        RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", 
        RowBox[{"steps", " ", "step"}]}], "]"}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rows", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<unnormalized projectors (Q)\>\"", ",", " ", 
           RowBox[{"Mean", "[", "tildes", "]"}]}], "}"}], ",", "\n", "     ", 
         
         RowBox[{"{", 
          RowBox[{"\"\<likelihood-weighted (Q)\>\"", ",", " ", 
           RowBox[{
            RowBox[{"Total", "[", "tildes", "]"}], "/", 
            RowBox[{"Total", "[", "ws", "]"}]}]}], "}"}], ",", "\n", "     ", 
         
         RowBox[{"{", 
          RowBox[{"\"\<equal-weight normalized (Q)\>\"", ",", " ", 
           RowBox[{"Mean", "[", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#1", "/", "#2"}], " ", "&"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"tildes", ",", " ", "ws"}], "}"}]}], "]"}], "]"}]}], 
          "}"}]}], "}"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
             RowBox[{"Re", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", " ", "1", ",", " ", "1"}], "]"}], "]"}], 
              "]"}], ",", " ", 
             RowBox[{"Norm", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", "ref"}], ",", 
               " ", "\"\<Frobenius\>\""}], "]"}]}], "}"}], " ", "&"}], " ", "/@",
           " ", "rows"}], ",", "\n", "    ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<reference-measure average\>\"", ",", 
           " ", "\"\<excited population\>\"", ",", 
           " ", "\"\<gap to master equation\>\""}], "}"}]}], "]"}], ",", "\n",
        "   ", 
       RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[307]:= ",
 CellID->243244218,ExpressionUUID->"0db8d008-2b7e-6047-3b47-ca524e0b32ad"],

Cell[TextData[{
 "The two weighted rows sit on the master equation; the equal-weight row \
misses it, and by a bias no larger ensemble will close, since the error is in \
the sampling law and not the sample count. That gap is the whole content of \
the weight: it is what makes the reference measure physical. Two readings of \
one diffusive process follow from it: normalize the linear state and drive it \
with the physical innovation for the nonlinear state an experimenter tracks, \
or carry the unnormalized state under reference noise and keep its norm as \
the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["P", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b5f3c3c-a0bd-b40a-4964-b679d1491f50"],
 " factor."
}], "Text",
 CellID->736003942,ExpressionUUID->"50e3ced9-efa3-8fb9-0090-e7828a57d583"],

Cell["\<\
One record carries both bookkeepings at once. Roll out a single linear run \
keeping its whole history:\
\>", "Text",
 CellID->30476683,ExpressionUUID->"51e2478e-a4b0-4c7f-0792-5eebcd451745"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"linPathA5", "[", "seed_", "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "    ", 
     RowBox[{"FoldList", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#1", " ", "+", " ", 
         RowBox[{
          RowBox[{"Knh", " ", ".", " ", "#1"}], " ", "step"}], " ", "+", " ", 
         
         RowBox[{
          RowBox[{"cLin", " ", ".", " ", "#1"}], " ", "#2"}]}], " ", "&"}], ",",
        " ", "excited", ",", " ", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"Sqrt", "[", "step", "]"}]}], "]"}], ",", " ", "steps"}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[308]:= ",
 CellID->57790923,ExpressionUUID->"7464e148-f188-b1ce-1c1b-f91580220314"],

Cell["Take one such run for a fixed seed:", "Text",
 CellID->1064275823,ExpressionUUID->"3f8db726-7604-9df5-65b2-2e8003b6e7df"],

Cell[BoxData[
 RowBox[{
  RowBox[{"oneA5", " ", "=", " ", 
   RowBox[{"linPathA5", "[", "7", "]"}]}], ";"}]], "Input",
 CellLabel->"In[309]:= ",
 CellID->590249403,ExpressionUUID->"22a876b6-5c8c-915d-52a8-6ff0553ee3a7"],

Cell["and its time grid:", "Text",
 CellID->547939121,ExpressionUUID->"38f0db08-93d0-aa19-688f-d352266af963"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gridA5", " ", "=", " ", 
   RowBox[{"step", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "steps"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[310]:= ",
 CellID->171228285,ExpressionUUID->"76285bca-be73-b625-1e28-52943b071d0f"],

Cell["\<\
Read the two descriptions off that one run: the normalized state (the state \
direction the physical trajectory takes for this record) and the log-weight \
it accumulates (its running log-likelihood), side by side:\
\>", "Text",
 CellID->1578243061,ExpressionUUID->"1e0bf47a-29b2-5087-4608-ee24484722ed"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"{", "\n", "  ", 
   RowBox[{
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"gridA5", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", " ", "+", " ", 
                RowBox[{"Re", "[", 
                 RowBox[{
                  RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "Z", 
                  " ", ".", " ", "#"}], "]"}]}], ")"}], "/", "2"}], " ", 
             "&"}], "[", 
            RowBox[{"Normalize", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@",
           " ", "oneA5"}]}], "}"}], "]"}], ",", "\n", "   ", 
      RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
      RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
      RowBox[{"PlotRange", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"steps", " ", "step"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1.05"}], "}"}]}], "}"}]}], ",", " ", 
      RowBox[{"ImageSize", " ", "->", " ", "Medium"}], ",", "\n", "   ", 
      RowBox[{"FrameLabel", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<time\>\"", ",", 
         " ", "\"\<excited population (normalized)\>\""}], "}"}]}], ",", " ", 
      
      RowBox[{"PlotLabel", " ", "->", " ", "\"\<the state you track\>\""}]}], 
     "]"}], ",", " ", "\"\<  \>\"", ",", "\n", "  ", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"gridA5", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Log", "[", 
            RowBox[{"Re", "[", 
             RowBox[{
              RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "#"}], 
             "]"}], "]"}], " ", "&"}], " ", "/@", " ", "oneA5"}]}], "}"}], 
       "]"}], ",", "\n", "   ", 
      RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
      RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
      RowBox[{"PlotRange", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"steps", " ", "step"}]}], "}"}], ",", " ", "All"}], 
        "}"}]}], ",", " ", 
      RowBox[{"ImageSize", " ", "->", " ", "Medium"}], ",", "\n", "   ", 
      RowBox[{"FrameLabel", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<time\>\"", ",", 
         " ", "\"\<log weight  log ||psi||^2\>\""}], "}"}]}], ",", " ", 
      RowBox[{
      "PlotLabel", " ", "->", " ", "\"\<the likelihood it carries\>\""}]}], 
     "]"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[311]:= ",
 CellID->1223164385,ExpressionUUID->"2b405c0d-64a5-b9f0-5970-56570d510bda"],

Cell[TextData[{
 "The same record has a normalized-state reading and a running weight. The \
normalized state is the physical trajectory an experimenter tracks; the \
weight is the extra likelihood factor, needed only to turn averages taken \
under the reference measure ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ec9f25f-522a-b03f-26f6-f41967dc0305"],
 " into physical ones."
}], "Text",
 CellID->495355002,ExpressionUUID->"6cabbcd0-b036-db9b-14a8-359dc1c0a9e1"],

Cell[TextData[{
 "The catch of the linear method is that the weights spread, so a handful of \
records come to dominate the average, the importance-sampling degeneracy. \
Measure it with the effective sample size ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["N", "TI"], 
    StyleBox["eff",
     FontSlant->"Plain"]], "=", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["\[Sum]",
       FontSize->1.15 Inherited], 
      StyleBox["w", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], "/", 
   StyleBox["\[Sum]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["w", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7549b383-d3bb-dea8-2376-2aece64fa4f2"],
 ". Run an ensemble of linear paths:"
}], "Text",
 CellID->1429172334,ExpressionUUID->"78c95527-fb77-4896-28f7-4c80fe021afc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"essPathsA5", " ", "=", " ", 
   RowBox[{"linPathA5", " ", "/@", " ", 
    RowBox[{"Range", "[", "400", "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[312]:= ",
 CellID->1982316360,ExpressionUUID->"0e291a73-26c2-03ce-37d6-9c3d53775114"],

Cell[TextData[{
 "Read ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["N", "TI"], 
    StyleBox["eff",
     FontSlant->"Plain"]], "/", 
   StyleBox["N", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e50714f-9f2e-83ec-5660-69291ad8d136"],
 " from the squared-norm weights at sampled times:"
}], "Text",
 CellID->1636237575,ExpressionUUID->"7fc38cd6-2f94-7c0b-25f0-25904a214751"],

Cell[BoxData[
 RowBox[{
  RowBox[{"essA5", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"w", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", 
               RowBox[{
                RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "#"}], 
               "]"}], " ", "&"}], "@", 
             RowBox[{"#", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], ")"}], " ", "&"}], " ", "/@", 
          " ", "essPathsA5"}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Total", "[", "w", "]"}], "^", "2"}], "/", 
          RowBox[{"Total", "[", 
           RowBox[{"w", "^", "2"}], "]"}]}], ")"}], "/", "400."}]}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "1", ",", " ", 
       RowBox[{"steps", " ", "+", " ", "1"}], ",", " ", "20"}], "}"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[313]:= ",
 CellID->1547648475,ExpressionUUID->"52bd9bab-8a7f-520d-0242-12f52f0a2157"],

Cell["and plot its decay over time:", "Text",
 CellID->535623541,ExpressionUUID->"7fe6d50a-3e08-7026-259d-cd54bbbd430c"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"gridA5", "[", 
       RowBox[{"[", 
        RowBox[{"1", " ", ";;", " ", ";;", " ", "20"}], "]"}], "]"}], ",", 
      " ", "essA5"}], "}"}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<effective sample size / N\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the linear weights degenerate: fewer records carry the \
average\>\""}]}], "]"}]], "Input",
 CellLabel->"In[314]:= ",
 CellID->464083887,ExpressionUUID->"106f3a57-ec37-4f09-4014-bc1085c21253"],

Cell["\<\
The effective fraction falls from one toward a fraction of the ensemble: as \
time goes on, the unweighted linear average is carried by ever fewer \
high-weight records, and its Monte-Carlo error grows even though it remains \
unbiased. That is the price of the linear picture's convenience, and the \
reason the nonlinear (renormalized) equation, which keeps every trajectory \
equally weighted, is what a long real-time filter uses.\
\>", "Text",
 CellID->1427425626,ExpressionUUID->"5ce368aa-9e32-7f93-0490-81f41bc745f9"],

Cell["The Driven Atom, Averaged and Watched", "Subsection",
 CellID->689122476,ExpressionUUID->"2409835b-76a2-7cb9-4c36-1b0503574683"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " One driven, damped, emitting atom, carried in full generality and then \
watched three ways. Its unconditional master equation keeps detuning, a \
thermal drive, and pure dephasing together,"
}], "Text",
 CellID->1284583753,ExpressionUUID->"55de0b04-0549-b416-03e5-a36eacfd1f7c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"\[ScriptCapitalL]", 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["n", "TI"], 
      StyleBox["T", "TI"]], "+", "1"}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "+", 
    StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "+"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "+", 
    StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["d", "TI"]], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"\[CapitalDelta]", 
        StyleBox["\[Omega]", "TI"]}], "2"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"]]}], "+", 
     RowBox[{
      FractionBox["\[CapitalOmega]", "2"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["x", "TI"]]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1229478228,ExpressionUUID->"12eebfc3-70f7-f40e-4295-36ad0083df54"],

Cell[TextData[{
 "and relaxes to a mixed steady state inside the ball. Three separate \
environmental channels carry information away, one dissipator each: the \
downward channel ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["R", "TI"], "^"], "\[DownArrow]"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["T", "TI"]], "+", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "-"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5725d6ca-0b7f-1acb-7eda-cf94ae0a6811"],
 " is excited-to-ground emission, the upward channel ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["R", "TI"], "^"], "\[UpArrow]"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["\[Gamma]", "TI"], 
     SubscriptBox[
      StyleBox["n", "TI"], 
      StyleBox["T", "TI"]]}]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "+"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70ead02b-38d1-354c-20e9-ca75b9659f96"],
 " is thermal absorption from the bath, and the dephasing channel ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["R", "TI"], "^"], 
    StyleBox["\[Phi]", "TI"]], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["\[Gamma]", "TI"], 
     SubscriptBox[
      StyleBox["k", "TI"], 
      StyleBox["d", "TI"]]}]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09d7f5ce-7f21-c26a-3fec-eca87ad590b0"],
 " scrambles the phase while moving no population. Detuning is different in \
kind: ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    RowBox[{"\[CapitalDelta]", 
     StyleBox["\[Omega]", "TI"]}], "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "229972e4-7d0e-897c-52a7-6bce74b8d846"],
 " is Hamiltonian, so it turns the state without opening a fourth channel and \
without mixing it. We hold all three channels active throughout and vary only \
how much of their output the observer keeps: nothing, the fluorescence alone, \
or all three ideally. These are three levels of knowledge about one atom, not \
three physical models, running from the mixed interior point (no record) \
through mixed conditioned states (partial record) to pure conditioned states \
(complete record), every one sharing the single unconditional average ",
 Cell[BoxData[
  RowBox[{"\|01d53c", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21fb93d6-8bae-9e34-5798-0a902e58e51e"],
 ". Heterodyne split one emitted field into two quadratures; here three \
distinct mechanisms carry three independent records, and the question is how \
many of them the observer keeps."
}], "Text",
 CellID->1956186523,ExpressionUUID->"239269fa-bed2-0e72-51a1-80a43b675558"],

Cell[TextData[{
 "Start with the level we never record, the unconditional steady state, the \
mixed point every watched trajectory below will circle. Two rates organize \
it: the longitudinal rate ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", "1"], "=", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141dc450-8fbb-3551-3c22-de1a2a4f9fbb"],
 " at which populations relax, and the transverse rate ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", "2"], "=", 
   FractionBox["1", "2"], 
   SubscriptBox["\[CapitalGamma]", "1"], "+", "2", 
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33f465a2-c944-5788-618c-7c0fe8f13dd2"],
 " at which coherences decay, faster than ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", "1"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ae608ed-420f-d8e0-1a9d-a1b777bbaaca"],
 " by the extra dephasing. Define the steady Bloch vector in closed form:"
}], "Text",
 CellID->1104760091,ExpressionUUID->"7456dc60-8a8d-205f-1c6d-d64a2f3872a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"steadyGeneral", "[", 
    RowBox[{
    "\[CapitalDelta]_", ",", " ", "\[CapitalOmega]_", ",", " ", "\[Gamma]_", ",",
      " ", "nT_", ",", " ", "kd_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"G1", " ", "=", " ", 
        RowBox[{"\[Gamma]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "nT"}], " ", "+", " ", "1"}], ")"}]}]}], ",", 
       " ", 
       RowBox[{"G2", " ", "=", " ", 
        RowBox[{
         RowBox[{"\[Gamma]", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "nT"}], " ", "+", " ", "1"}], ")"}], "/", 
           "2"}]}], " ", "+", " ", 
         RowBox[{"2", " ", "\[Gamma]", " ", "kd"}]}]}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"den", " ", "=", " ", 
         RowBox[{
          RowBox[{"G1", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"G2", "^", "2"}], " ", "+", " ", 
             RowBox[{"\[CapitalDelta]", "^", "2"}]}], ")"}]}], " ", "+", " ", 
          
          RowBox[{
           RowBox[{"\[CapitalOmega]", "^", "2"}], " ", "G2"}]}]}], "}"}], ",",
        " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "\[Gamma]"}], " ", "\[CapitalOmega]", " ", 
           "\[CapitalDelta]"}], ",", " ", 
          RowBox[{"\[Gamma]", " ", "\[CapitalOmega]", " ", "G2"}], ",", " ", 
          RowBox[{
           RowBox[{"-", "\[Gamma]"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"G2", "^", "2"}], " ", "+", " ", 
             RowBox[{"\[CapitalDelta]", "^", "2"}]}], ")"}]}]}], "}"}], "/", 
        "den"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[315]:= ",
 CellID->283765075,ExpressionUUID->"7cf7943f-295e-114d-248c-0e7948eb6397"],

Cell["\<\
Check it against the toolkit's steady-state finder with detuning, \
temperature, and dephasing all switched on:\
\>", "Text",
 CellID->1844722010,ExpressionUUID->"186d7224-6ee6-971a-4813-6b8e0a90fa60"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"steadyGeneral", "[", 
     RowBox[{
     "1.3", ",", " ", "3.", ",", " ", "1.", ",", " ", "0.4", ",", " ", 
      "0.25"}], "]"}], " ", "-", " ", 
    RowBox[{"blochVector", "[", 
     RowBox[{"First", "@", 
      RowBox[{"stationary", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1.3", "/", "2"}], ")"}], " ", "Z"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"3.", "/", "2"}], ")"}], " ", "X"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"1.", " ", 
             RowBox[{"(", 
              RowBox[{"0.4", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", 
           "lower"}], ",", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"1.", " ", "0.4"}], "]"}], " ", 
           RowBox[{"ConjugateTranspose", "[", "lower", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"1.", " ", "0.25"}], "]"}], " ", "Z"}]}], "}"}]}], 
       "]"}]}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[316]:= ",
 CellID->1051270324,ExpressionUUID->"28783f79-c8ba-30ce-5807-b722e94c8214"],

Cell[TextData[{
 "The discrepancy is at numerical precision: the closed form is exact for the \
stated finite-dimensional Bloch equations. The detuning enters through ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["\[CapitalGamma]", "2", "2"], "+", "\[CapitalDelta]", 
   SuperscriptBox[
    StyleBox["\[Omega]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6369cf55-7e98-45e5-1116-e71f7b2d2fcf"],
 " in the denominator, so the resonance has a Lorentzian denominator of width \
",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "695e18f7-9077-7daa-1f65-91b1210247f0"],
 " that the drive power-broadens through the ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], 
   SubscriptBox["\[CapitalGamma]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01025a43-78b1-6e71-3732-5c2d7944355b"],
 " term; temperature lifts the ground-state bias, since at ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45a2a882-eb03-e595-7351-41ef8eb7cfff"],
 " the state rests at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["z", "TI"], 
    StyleBox["eq",
     FontSlant->"Plain"]], "=", "-", "1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bf7f187-9eae-ffe3-498c-e8e11b58c5c9"],
 " rather than the south pole. Plot the steady excited population ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10512a4e-e651-dddd-406e-cc2b93e5a727"],
 " against detuning, weak drive against strong:"
}], "Text",
 CellID->152418458,ExpressionUUID->"5176ba42-8596-944f-070d-3c2c2c20fe95"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "+", " ", 
            RowBox[{
             RowBox[{"steadyGeneral", "[", 
              RowBox[{
              "d", ",", " ", "om", ",", " ", "1.", ",", " ", "0.", ",", " ", 
               "0."}], "]"}], "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "/", "2"}]}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"d", ",", " ", 
         RowBox[{"-", "8"}], ",", " ", "8", ",", " ", "0.05"}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"om", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1.", ",", " ", "4."}], "}"}]}], "}"}]}], "]"}], ",", "\n", 
   " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[CapitalOmega] = 1\>\"", ",", 
      " ", "\"\<\[CapitalOmega] = 4\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<detuning \[CapitalDelta]\[Omega]\>\"", ",", 
      " ", "\"\<steady excited population\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<resonance is a power-broadened Lorentzian in detuning\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[317]:= ",
 CellID->1026990147,ExpressionUUID->"6ab79099-cfc9-41ff-1a4c-09c2ea7c13c5"],

Cell["\<\
The excited population peaks on resonance and falls off as a Lorentzian to \
either side; the stronger drive both lifts the peak toward saturation at one \
half and widens it, the power broadening. That is the general averaged atom, \
the no-record level: with the detector ignored, the state relaxes \
deterministically to one mixed interior point. To watch it we must say what a \
detector does with each of the three outputs, and that choice, not the \
Liouvillian, is what picks a trajectory out of the average.\
\>", "Text",
 CellID->1165560109,ExpressionUUID->"1cff0d2a-0962-39b9-4484-a574a8148b83"],

Cell[TextData[{
 "Now the same atom, watched. Fix the drive, the decay rate, and the three \
environmental rates, and build the Hamiltonian and the three channel \
operators from the toolkit's ",
 Cell[BoxData["lower"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ecbc277-6fbb-da5a-06c8-e4310a4fa8a0"],
 ":"
}], "Text",
 CellID->866904439,ExpressionUUID->"457cd362-8cff-9a44-7303-cb4c248be8ae"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalOmega]dr", " ", "=", " ", "3."}], ";", " ", 
  RowBox[{"\[Gamma]dr", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"\[CapitalDelta]dr", " ", "=", " ", "0.8"}], ";", " ", 
  RowBox[{"nTdr", " ", "=", " ", "0.3"}], ";", " ", 
  RowBox[{"kdDr", " ", "=", " ", "0.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Hdr", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[CapitalDelta]dr", "/", "2"}], ")"}], " ", "Z"}], " ", "+", 
    " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[CapitalOmega]dr", "/", "2"}], ")"}], " ", "X"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Rdown", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Gamma]dr", " ", 
      RowBox[{"(", 
       RowBox[{"nTdr", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", "lower"}]}],
   ";", " ", 
  RowBox[{"Rup", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Gamma]dr", " ", "nTdr"}], "]"}], " ", 
    RowBox[{"ConjugateTranspose", "[", "lower", "]"}]}]}], ";", " ", 
  RowBox[{"Rphi", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Gamma]dr", " ", "kdDr"}], "]"}], " ", "Z"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"drLeaks", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"Rdown", ",", " ", "Rup", ",", " ", "Rphi"}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[318]:= ",
 CellID->1332589990,ExpressionUUID->"1130cedf-2841-d5f7-40cf-e79949f5bfdd"],

Cell[TextData[{
 "With the detector ignored, the state relaxes to the mixed interior point ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], 
   StyleBox["ss",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3468d219-8f65-5d49-5c17-d4432a102793"],
 " of the closed form above; read its length, which a pure state would carry \
as one:"
}], "Text",
 CellID->1878932146,ExpressionUUID->"07018e41-afaf-9e12-2d3e-202aca5be578"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"settled", " ", "=", " ", 
   RowBox[{"steadyGeneral", "[", 
    RowBox[{
    "\[CapitalDelta]dr", ",", " ", "\[CapitalOmega]dr", ",", " ", 
     "\[Gamma]dr", ",", " ", "nTdr", ",", " ", "kdDr"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Norm", "[", "settled", "]"}]}], "Input",
 CellLabel->"In[319]:= ",
 CellID->81974322,ExpressionUUID->"429ca171-278a-9358-72a3-393b523ce1a2"],

Cell["\<\
Well short of one: with no record kept, the atom is mixed, sitting inside the \
ball where drive, emission, thermal absorption, and dephasing balance.\
\>", "Text",
 CellID->101329809,ExpressionUUID->"2265709e-c6e2-934c-521b-69dbf294e196"],

Cell[TextData[{
 "To watch it, we must put a detector on each output, and that choice, not ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c2451d3-5dad-cf90-05dc-489d545995fa"],
 ", is what selects a trajectory. Read all three channels by phase-zero \
homodyne, each carrying its own independent noise ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["\[Alpha]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb71b50-5b0e-8f73-254c-931a5eb8d259"],
 " (with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["\[Alpha]", "TI"]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["\[Beta]", "TI"]], "=", 
   SubscriptBox[
    StyleBox["\[Delta]", "TI"], 
    StyleBox[
     RowBox[{"\[Alpha]", "\[Beta]"}], "TI"]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "389fd111-b284-1b04-68a4-c95ac731666e"],
 "), so each record is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["\[Alpha]", "TI"]], "=", 
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["R", "TI"], "^"], 
       StyleBox["\[Alpha]", "TI"]], "+", 
      SubsuperscriptBox[
       OverscriptBox[
        StyleBox["R", "TI"], "^"], 
       StyleBox["\[Alpha]", "TI"], "\[Dagger]"]}], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["c", "TI"]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["\[Alpha]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a68dc76-92bd-40cf-2a17-d63027481215"],
 ". Which system observable does each carry? Since ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "-"], "+", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "+"], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1373306a-3754-8710-4100-aa3442e6ea7a"],
 ", both emission records track ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f521ae3-0d3c-4250-5561-93cda4c910ba"],
 ", differing only by their thermal weights, while the dephasing operator is \
Hermitian, so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["R", "TI"], "^"], 
    StyleBox["\[Phi]", "TI"]], "+", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["R", "TI"], "^"], 
    StyleBox["\[Phi]", "TI"], "\[Dagger]"], "=", "2", 
   SqrtBox[
    RowBox[{
     StyleBox["\[Gamma]", "TI"], 
     SubscriptBox[
      StyleBox["k", "TI"], 
      StyleBox["d", "TI"]]}]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fdf34a4-4672-e0d0-55e4-ad0e7304b23a"],
 " and its record tracks ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4de787d6-2024-7dd3-7b9c-1e9051d14739"],
 ". Confirm the three record drifts are exactly those combinations:"
}], "Text",
 CellID->122926644,ExpressionUUID->"55fa1cea-4458-dcd2-0399-95b46dd2a638"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"probe", " ", "=", " ", 
     RowBox[{"densityMatrix", "[", 
      RowBox[{"Normalize", "[", 
       RowBox[{"{", 
        RowBox[{"1.", ",", " ", 
         RowBox[{"0.5", " ", "+", " ", 
          RowBox[{"0.5", " ", "I"}]}]}], "}"}], "]"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"blochVector", "[", "probe", "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"Chop", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Re", "@", 
           RowBox[{"Tr", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", " ", "+", " ", 
               RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], ")"}], " ", ".",
              " ", "probe"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"Rdown", ",", " ", "Rup", ",", " ", "Rphi"}], "}"}]}], 
        ")"}], " ", "-", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"\[Gamma]dr", " ", 
            RowBox[{"(", 
             RowBox[{"nTdr", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", 
          RowBox[{"a", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"\[Gamma]dr", " ", "nTdr"}], "]"}], " ", 
          RowBox[{"a", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{"2", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"\[Gamma]dr", " ", "kdDr"}], "]"}], " ", 
          RowBox[{"a", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[320]:= ",
 CellID->827648486,ExpressionUUID->"5117b661-6297-dae6-072c-284b1723a8cc"],

Cell[TextData[{
 "Zero in every slot: three independent records collapse onto two system \
observables. Two different baths both report ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4874a11a-0b78-4cc4-780b-3944ae0d162e"],
 ", one reports ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e1748f8-0734-d73c-262d-61a2b2c6ba06"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e2b9108-d4ae-d6a1-4628-0955dd58bc8b"],
 ", generally nonzero, appears in no record at all; it reaches the \
conditioned state only through the Hamiltonian rotation. Channel identity and \
measured observable are not the same thing."
}], "Text",
 CellID->785423779,ExpressionUUID->"59b55f82-b518-72dd-0f4b-56ec3cad4027"],

Cell[TextData[{
 "Integrate the record-blind master equation once as the baseline every \
ensemble must return to, and run two conditioned histories from the excited \
state: one keeping only the fluorescence (watch ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["R", "TI"], "^"], "\[DownArrow]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1410ebbc-cc48-afc5-3c2f-02f9e5e2f52f"],
 ", let the thermal-absorption and dephasing outputs escape), one keeping all \
three ideally:"
}], "Text",
 CellID->1525499759,ExpressionUUID->"0b4a9728-6877-44ef-3949-0f7209022e35"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"refRun", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{"Hdr", ",", " ", "drLeaks", ",", " ", 
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "8."}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"watchedOne", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "Hdr", ",", 
     " ", 
     RowBox[{"{", "Rdown", "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"Rup", ",", " ", "Rphi"}], "}"}], ",", " ", "0.01", ",", " ", 
     "8.", ",", " ", "5"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"watchedAll", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "Hdr", ",", 
     " ", "drLeaks", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1.", ",", " ", "1.", ",", " ", "1."}], "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "0.01", ",", " ", "8.", ",", " ", "5"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"whenDr", " ", "=", " ", 
   RowBox[{"watchedAll", "[", "\"\<times\>\"", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[321]:= ",
 CellID->1068945273,ExpressionUUID->"3d9cae35-b3ea-e9a2-6ba3-407ec59cbb88"],

Cell[TextData[{
 "The fluorescence-only history obeys ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["c", "TI"]], "=", "\[ScriptCapitalL]", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["c", "TI"]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", "\[ScriptCapitalH]", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["R", "TI"], "^"], "\[DownArrow]"], 
   StyleBox["]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["c", "TI"]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], "\[DownArrow]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47ae793e-1388-a017-6d56-7178a622f37d"],
 ": the unwatched channels stay in ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0718ed2d-1535-5ad4-2d27-05779cc0283e"],
 " but condition nothing. Read the smallest purity each run reaches:"
}], "Text",
 CellID->753001716,ExpressionUUID->"372f13ab-79ee-7986-5ed4-8af57f9b4bec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Min", "[", 
    RowBox[{"purity", " ", "/@", " ", 
     RowBox[{"watchedOne", "[", "\"\<states\>\"", "]"}]}], "]"}], ",", " ", 
   RowBox[{"Min", "[", 
    RowBox[{"purity", " ", "/@", " ", 
     RowBox[{"watchedAll", "[", "\"\<states\>\"", "]"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[322]:= ",
 CellID->233751987,ExpressionUUID->"6c367b34-bfe1-5d6f-15ce-737e399427b5"],

Cell[TextData[{
 "The fluorescence-only run drops well below one, genuinely mixed; the fully \
watched run holds at one. Temperature and dephasing are equally present in \
both, active in the same ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75911979-a02e-ddea-23ae-9122d1d8a730"],
 "; the only difference is whether their information is collected. Missing \
two of the three channels mixes the conditioned state; catching all three \
keeps it pure, thermal drive and dephasing notwithstanding. That is the \
sharper form of \"watching keeps purity\": not watching anything, but holding \
a complete ideal record of every channel that carries information away."
}], "Text",
 CellID->688983072,ExpressionUUID->"0dec446f-046e-4336-3b94-5e49ad1b2e1c"],

Cell["\<\
See it as three curves in time, the record-blind purity against the two \
conditioned runs:\
\>", "Text",
 CellID->1379778257,ExpressionUUID->"75dc925b-5bf3-f22e-23e3-14055d87c174"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"whenDr", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"purity", "[", 
           RowBox[{"refRun", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
         " ", "whenDr"}]}], "}"}], "]"}], ",", "\n", "   ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"whenDr", ",", " ", 
        RowBox[{"purity", " ", "/@", " ", 
         RowBox[{"watchedOne", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}],
      ",", "\n", "   ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"whenDr", ",", " ", 
        RowBox[{"purity", " ", "/@", " ", 
         RowBox[{"watchedAll", "[", "\"\<states\>\"", "]"}]}]}], "}"}], 
      "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "Red", ",", " ", "Dashed"}], "]"}], ",", 
      " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<no record (unconditional)\>\"", ",", 
      " ", "\"\<fluorescence only\>\"", ",", 
      " ", "\"\<all three channels\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0.45", ",", " ", "1.02"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<purity\>\""}], "}"}]}], ",", " ", 
   
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<only the complete record keeps a conditioned run pure\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[323]:= ",
 CellID->1425464440,ExpressionUUID->"03e98152-a240-0eaa-3196-191fd7f554f0"],

Cell["\<\
The unconditional purity slides smoothly from one to its mixed steady value; \
the fluorescence-only run jitters below it, genuinely mixed; the fully \
watched run rides the top at one. Purity is a property of the record kept, \
not of the atom. The same three levels read on the Bloch sphere, the pure \
surface path and the mixed interior path circling the one record-blind steady \
point:\
\>", "Text",
 CellID->939350965,ExpressionUUID->"7a00be71-6857-3e36-2a3f-303b09e3851c"],

Cell[BoxData[
 RowBox[{"blochPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"blochVector", " ", "/@", " ", 
      RowBox[{"watchedAll", "[", "\"\<states\>\"", "]"}]}], ",", " ", 
     RowBox[{"blochVector", " ", "/@", " ", 
      RowBox[{"watchedOne", "[", "\"\<states\>\"", "]"}]}]}], "}"}], ",", 
   "\n", " ", "\"\<complete record stays on the surface; fluorescence only \
wanders inside\>\"", ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<all three channels (pure)\>\"", ",", 
     " ", "\"\<fluorescence only (mixed)\>\""}], "}"}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{"Black", ",", " ", 
     RowBox[{"PointSize", "[", "0.035", "]"}], ",", " ", 
     RowBox[{"Point", "[", "settled", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[324]:= ",
 CellID->619140003,ExpressionUUID->"1b61afbf-df52-1398-491e-46f8dae761e2"],

Cell["\<\
The fully watched trajectory stays on the surface, pure, circling the black \
interior point; the fluorescence-only trajectory wanders through the \
interior, mixed. Both must average back to that same black point, the atom \
with no record at all. Check it: build an ensemble of each monitoring and \
compare its mean to the unconditional reference:\
\>", "Text",
 CellID->266834637,ExpressionUUID->"54cfcfa8-25f2-71dd-7cf4-e6f253874327"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"crowdOne", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"trajectory", "[", 
       RowBox[{
        RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "Hdr", ",", 
        " ", 
        RowBox[{"{", "Rdown", "}"}], ",", " ", 
        RowBox[{"{", "1.", "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"Rup", ",", " ", "Rphi"}], "}"}], ",", " ", "0.01", ",", " ",
         "8.", ",", " ", "k"}], "]"}], "[", "\"\<states\>\"", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "100"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"crowdAll", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"trajectory", "[", 
       RowBox[{
        RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "Hdr", ",", 
        " ", "drLeaks", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1.", ",", " ", "1.", ",", " ", "1."}], "}"}], ",", " ", 
        RowBox[{"{", "}"}], ",", " ", "0.01", ",", " ", "8.", ",", " ", "k"}],
        "]"}], "[", "\"\<states\>\"", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "100"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ref", " ", "=", " ", 
     RowBox[{"refRun", " ", "/@", " ", "whenDr"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Max", "@", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"#1", " ", "-", " ", "#2"}], ",", 
           " ", "\"\<Frobenius\>\""}], "]"}], " ", "&"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Mean", "[", "crowdOne", "]"}], ",", " ", "ref"}], "}"}]}], 
       "]"}]}], ",", "\n", "  ", 
     RowBox[{"Max", "@", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"#1", " ", "-", " ", "#2"}], ",", 
           " ", "\"\<Frobenius\>\""}], "]"}], " ", "&"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Mean", "[", "crowdAll", "]"}], ",", " ", "ref"}], "}"}]}], 
       "]"}]}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[325]:= ",
 CellID->1001517655,ExpressionUUID->"4c7b9ae5-550e-b845-7418-13cf5cb80aaf"],

Cell[TextData[{
 "Both gaps sit at the hundred-trajectory sampling level: averaging the \
record away returns the same ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e2106e-13a9-e35f-2791-8a48a65db1a5"],
 " whether the conditioned states were mixed or pure. The two knobs from the \
toolkit still set the residue, more trajectories against the scatter and a \
finer step against the bias."
}], "Text",
 CellID->39808583,ExpressionUUID->"5fb5a314-14a9-f5fc-054a-3b5e9d5ddfc6"],

Cell[TextData[{
 "One honest caveat on the pure fully watched run. Writing the thermal bath \
as the two operators ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    RowBox[{
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["T", "TI"]], "+", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "-"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4caa88fa-f24e-a9d3-74a9-21a787f8fb39"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    RowBox[{
     StyleBox["\[Gamma]", "TI"], 
     SubscriptBox[
      StyleBox["n", "TI"], 
      StyleBox["T", "TI"]]}]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "+"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "781e04d5-949b-4939-2825-9d9f1d2e1803"],
 " dilates it into two effective vacuum channels, and monitoring both of \
those is what keeps the trajectory pure. A real thermal reservoir is itself \
mixed, and ordinary access to its physical output need not deliver the two \
clean records this idealization assumes. Complete monitoring of all three \
effective channels is an information-complete unravelling: it shows what full \
environmental knowledge would imply, not necessarily what a laboratory \
detector on a warm bath can reach."
}], "Text",
 CellID->81581324,ExpressionUUID->"030eefb9-536c-2ae9-3135-06e366197833"],

Cell["\<\
So one Liouvillian carries three answers. The black interior point is the \
atom with the record thrown away; the interior stochastic path is the same \
atom watched incompletely; the surface stochastic path is the atom watched in \
full. None is more true than the others, and all three average to the first: \
they answer three different questions about one open system.\
\>", "Text",
 CellID->671164176,ExpressionUUID->"13b93a61-4b06-9a06-4146-bc4b6eb0e96c"],

Cell["The Mollow Triplet: Resonance-Fluorescence Spectrum", "Subsection",
 CellID->374148378,ExpressionUUID->"700a2ccf-4fe7-b0c9-2009-c5a969930213"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " The spectrum (power spectrum) of the light a driven atom emits, computed \
by quantum regression from the two-time correlations of the master equation. \
The atom is the resonant emitter of the previous section,"
}], "Text",
 CellID->2126328594,ExpressionUUID->"140d84d1-9e60-51c0-3c32-1d9b1b15232a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      FractionBox["\[CapitalOmega]", "2"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["x", "TI"]]}], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1152367211,ExpressionUUID->"4f0947a0-1196-40ba-7537-5e0aa0231280"],

Cell[TextData[{
 "Its light divides into two parts: an ",
 StyleBox["elastic", "TI"],
 " (coherent) line at the drive frequency, a delta function carrying the \
weight ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      SubscriptBox[
       RowBox[{
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        SubscriptBox[
         OverscriptBox[
          StyleBox["\[Sigma]", "TI"], "^"], "-"], 
        StyleBox["\[RightAngleBracket]",
         SpanMaxSize->1]}], 
       StyleBox["ss",
        FontSlant->"Plain"]]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "248a8160-2ca3-5e04-4c89-194a4556256e"],
 ", and the ",
 StyleBox["inelastic", "TI"],
 " (fluorescence) spectrum of the fluctuations ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "-"], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "-"], "-", 
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], "-"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["ss",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26ed9998-8884-b223-4e92-10c229360109"],
 ", given by quantum regression as the steady-state correlation"
}], "Text",
 CellID->599499195,ExpressionUUID->"5ac06e6b-f116-7b59-0aff-803480a349a3"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["inel",
      FontSlant->"Plain"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Mu]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[Proportional]", 
    StyleBox["Re",
     FontSlant->"Plain"], 
    SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[Mu]", "TI"], 
      StyleBox["t", "TI"]}]], "\[ThinSpace]", 
    SubscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Delta]", "TI"], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], "+"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1], "\[ThinSpace]", 
       StyleBox["\[Delta]", "TI"], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], "-"], 
       StyleBox["(",
        SpanMaxSize->1], "0", 
       StyleBox[")",
        SpanMaxSize->1]}], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox["ss",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->477283400,ExpressionUUID->"65a717e6-c8c5-b5f7-135c-8ec3e9711fdd"],

Cell[TextData[{
 "Regression runs this correlation on the same Liouvillian ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ab59720-208d-140d-6a4a-0e8a51387f57"],
 " that evolves the state, so Fourier transform turns the propagator ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"\[ScriptCapitalL]", 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75579e92-42ca-6d62-236c-17dc777f3448"],
 " into the resolvent ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["\[Mu]", "TI"], "-", "\[ScriptCapitalL]"}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   RowBox[{"-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e55f28b-4749-0e5a-566a-ebd572fc54a0"],
 ". For weak driving the inelastic part is a single line; for strong driving ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", ">", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "396a2699-bf3c-f954-6f69-bfc33acecbbe"],
 " it splits into the three-peaked ",
 StyleBox["Mollow triplet", "TI"],
 ", a central line and two sidebands at ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bb23a02-0434-56a9-4941-bc6cadc13cf3"],
 ", the dynamical Stark effect."
}], "Text",
 CellID->449610334,ExpressionUUID->"0443f7da-681a-ff36-2c70-ee8409acc21c"],

Cell[TextData[{
 "Homodyne detection instead reads a chosen quadrature, and its spectrum can \
dip ",
 StyleBox["below", "TI"],
 " the shot-noise floor: squeezed, nonclassical light. Build both from the \
same big matrix."
}], "Text",
 CellID->1143962738,ExpressionUUID->"4e7b0eee-1e32-42cf-7618-a7c89bc71015"],

Cell[TextData[{
 "One last set of quantities from the master equation, all through the \
eigen-based spectrum tool built for the quantum point contact (",
 Cell[BoxData["regressionSpectrum"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0029b61e-e057-a799-31d6-285b91e30de3"],
 "). It needs no shifted frequency grid, because the steady mode is dropped \
explicitly. The inelastic fluorescence spectrum is its correlation of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "-"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d6d3611-50e6-56f1-7b12-a85b60933cdb"],
 ":"
}], "Text",
 CellID->1043470919,ExpressionUUID->"29e2b788-3fef-f960-5f91-2ed2b99bc84a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mollowInelastic", "[", 
    RowBox[{"\[CapitalOmega]_", ",", " ", "\[Gamma]_", ",", " ", "tones_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"big", " ", "=", " ", 
        RowBox[{"liouvillian", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}], "}"}], ",",
           " ", "2"}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"rss", " ", "=", " ", 
        RowBox[{"First", "@", 
         RowBox[{"stationary", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}], "}"}]}], 
          "]"}]}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dm", " ", "=", " ", 
         RowBox[{"lower", " ", "-", " ", 
          RowBox[{
           RowBox[{"Tr", "[", 
            RowBox[{"lower", " ", ".", " ", "rss"}], "]"}], " ", "id2"}]}]}], 
        "}"}], ",", " ", 
       RowBox[{"regressionSpectrum", "[", 
        RowBox[{"big", ",", " ", 
         RowBox[{"dm", " ", ".", " ", "rss"}], ",", " ", 
         RowBox[{"ConjugateTranspose", "[", "dm", "]"}], ",", " ", "tones"}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[326]:= ",
 CellID->505712527,ExpressionUUID->"03070159-0ba8-dd63-313c-9903ae42a449"],

Cell["\<\
Sweep frequencies (centered on zero, no offset needed) for a weak and a \
strong drive:\
\>", "Text",
 CellID->1677321332,ExpressionUUID->"21ec52ec-14ad-8ff7-5794-4bb69d59d5dd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tones", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "9"}], ",", " ", "9", ",", " ", "0.05"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"weak", ",", " ", "strong"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mollowInelastic", "[", 
      RowBox[{"0.6", ",", " ", "1.", ",", " ", "tones"}], "]"}], ",", " ", 
     RowBox[{"mollowInelastic", "[", 
      RowBox[{"6.", ",", " ", "1.", ",", " ", "tones"}], "]"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[327]:= ",
 CellID->1181455231,ExpressionUUID->"10dc93f3-40fa-a76c-40e3-0abd708c0db6"],

Cell[TextData[{
 "Weakly driven, the inelastic spectrum is a single line at the drive \
frequency. Strongly driven, it splits into the ",
 StyleBox["Mollow triplet",
  FontWeight->"Bold"],
 ": a central line and two sidebands at ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c8eb1fd-23df-bcec-34b5-28a7566b0636"],
 "."
}], "Text",
 CellID->805377406,ExpressionUUID->"15af50f1-da00-725d-4355-49badfb540a7"],

Cell[TextData[{
 "Now visualize the weak- and strong-drive inelastic spectra together. Their \
absolute scales differ by orders of magnitude (the weak line would vanish on \
the strong axis), so plot each normalized to its own peak to compare the ",
 StyleBox["shapes", "TI"],
 ", a single line against the triplet:"
}], "Text",
 CellID->728305703,ExpressionUUID->"0fd09d21-d637-448f-35ef-148ae3c22ed5"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tones", ",", " ", 
        RowBox[{"weak", "/", 
         RowBox[{"Max", "[", "weak", "]"}]}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tones", ",", " ", 
        RowBox[{"strong", "/", 
         RowBox[{"Max", "[", "strong", "]"}]}]}], "}"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "6"}], ",", " ", "0", ",", " ", "6"}], "}"}], ",", " ", 
      "None"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<weak drive\>\"", ",", " ", "\"\<strong drive\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency (relative to drive)\>\"", ",", 
      " ", "\"\<inelastic spectrum (each / its peak)\>\""}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<strong driving splits the inelastic spectrum into the Mollow \
triplet\>\""}]}], "]"}]], "Input",
 CellLabel->"In[328]:= ",
 CellID->2004076868,ExpressionUUID->"2d58e4db-fdb8-3fff-5b67-fd84f43285c5"],

Cell[TextData[{
 "The sidebands sit near ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5331d2da-71bb-e99d-02ce-cb84004fbbe7"],
 ": under strong driving the atom's levels are dressed into a four-level \
ladder, whose transitions produce the three lines. Confirm the sidebands land \
at the drive strength:"
}], "Text",
 CellID->893892827,ExpressionUUID->"43630a3a-ab57-6174-7110-ac67cee2305e"],

Cell[BoxData[
 RowBox[{"Select", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"tones", "[", 
      RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{
     RowBox[{"FindPeaks", "[", "strong", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Abs", "[", "#", "]"}], " ", "-", " ", "6"}], "]"}], " ", "<", 
     " ", "0.6"}], " ", "&"}]}], "]"}]], "Input",
 CellLabel->"In[329]:= ",
 CellID->430036832,ExpressionUUID->"1026404a-81cf-d4cd-41de-5a14307bbe17"],

Cell[TextData[{
 "The peaks sit at ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74202e85-faa6-6568-1ddf-c7eeff534fb2"],
 ". Confirm too that the inelastic spectrum is nowhere negative, as a genuine \
power spectrum must be:"
}], "Text",
 CellID->114465421,ExpressionUUID->"2d7e3b6d-b319-8b08-5b05-b336c6add652"],

Cell[BoxData[
 RowBox[{"Min", "[", "strong", "]"}]], "Input",
 CellLabel->"In[330]:= ",
 CellID->609955738,ExpressionUUID->"5a40a2e0-989c-e39d-0a7f-3bca192eb1e7"],

Cell["Nonnegative within numerical precision.", "Text",
 CellID->465296703,ExpressionUUID->"70f38dee-376a-4447-2080-24c8421f2ead"],

Cell["\<\
The elastic line lives separately, a delta at zero frequency whose weight is \
the coherent dipole; it dominates at weak drive and all but vanishes at \
strong drive as the light turns fully inelastic:\
\>", "Text",
 CellID->340301607,ExpressionUUID->"2824dbec-c043-5d14-59db-d2c9f1f6247e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"elasticWeight", "[", "\[CapitalOmega]_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rss", " ", "=", " ", 
       RowBox[{"First", "@", 
        RowBox[{"stationary", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "1.", "]"}], " ", "lower"}], "}"}]}], 
         "]"}]}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"Tr", "[", 
        RowBox[{"lower", " ", ".", " ", "rss"}], "]"}], "]"}], "^", "2"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[331]:= ",
 CellID->730813709,ExpressionUUID->"23171ab6-4dff-4f28-512c-93f06b8a1272"],

Cell["At weak drive the coherent weight is substantial:", "Text",
 CellID->939888283,ExpressionUUID->"285991ce-1a51-dc0e-5866-08a89fe5a754"],

Cell[BoxData[
 RowBox[{"elasticWeight", "[", "0.6", "]"}]], "Input",
 CellLabel->"In[332]:= ",
 CellID->504741409,ExpressionUUID->"1447630d-e4f1-bc17-3c7d-7b568c85077d"],

Cell["and at strong drive it all but vanishes:", "Text",
 CellID->1085488748,ExpressionUUID->"2eb894ff-d8e2-f9b5-5647-0db8d894cb9f"],

Cell[BoxData[
 RowBox[{"elasticWeight", "[", "6.", "]"}]], "Input",
 CellLabel->"In[333]:= ",
 CellID->2053363947,ExpressionUUID->"6e0b0981-7bde-7e15-1608-a0eb7e6b457f"],

Cell["\<\
The coherent weight falls by more than an order of magnitude from weak to \
strong drive. To watch the triplet being born, sweep the drive continuously:\
\>", "Text",
 CellID->865306486,ExpressionUUID->"7d43776d-a0a0-3956-2b71-6f36d15a8bbc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mollowDrives", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0.3", ",", " ", "8", ",", " ", "0.25"}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[334]:= ",
 CellID->480044997,ExpressionUUID->"215fa697-6eb8-710a-5764-3fd10b4d4050"],

Cell["\<\
Stack the inelastic spectra into a heatmap, each row scaled to its own peak \
so the sidebands stay visible against the central peak that dwarfs them:\
\>", "Text",
 CellID->829253909,ExpressionUUID->"0c8b361a-878c-2404-3488-a844323e8f6e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mollowHeat", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"#", "/", 
       RowBox[{"Max", "[", "#", "]"}]}], ")"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"mollowInelastic", "[", 
        RowBox[{"#", ",", " ", "1.", ",", " ", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "11"}], ",", " ", "11", ",", " ", "0.1"}], "]"}]}], 
        "]"}], " ", "&"}], " ", "/@", " ", "mollowDrives"}], ")"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[335]:= ",
 CellID->1633538843,ExpressionUUID->"4bb231e2-5836-31a9-7941-a8cc59c083f3"],

Cell[TextData[{
 "Plot it, the dressed-transition lines ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "=", "\[PlusMinus]", "\[CapitalOmega]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e392069-461f-3828-17c6-ba3373ab8b72"],
 " overlaid as guides:"
}], "Text",
 CellID->1582554316,ExpressionUUID->"43052563-9173-3450-713a-bd4d20079eba"],

Cell[BoxData[
 RowBox[{"ArrayPlot", "[", 
  RowBox[{"mollowHeat", ",", " ", 
   RowBox[{"DataRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "11"}], ",", " ", "11"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"First", "@", "mollowDrives"}], ",", " ", 
        RowBox[{"Last", "@", "mollowDrives"}]}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"DataReversed", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"ColorFunction", " ", "->", " ", "\"\<SunsetColors\>\""}], ",", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", "1.1"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "460"}], ",", "\n", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{"White", ",", " ", "Dashed", ",", " ", 
        RowBox[{"Opacity", "[", "0.7", "]"}]}], "]"}], ",", " ", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.3", ",", " ", "0.3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"8", ",", " ", "8"}], "}"}]}], "}"}], "]"}], ",", " ", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "0.3"}], ",", " ", "0.3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "8"}], ",", " ", "8"}], "}"}]}], "}"}], "]"}]}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency\>\"", ",", " ", "\"\<drive \[CapitalOmega]\>\""}],
      "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the Mollow triplet is born as the drive grows (rows scaled to \
peak; \[Mu]=\[PlusMinus]\[CapitalOmega] dashed)\>\""}]}], "]"}]], "Input",
 CellLabel->"In[336]:= ",
 CellID->1433588095,ExpressionUUID->"44a4da74-fa22-10cf-6c5b-dc31ffd76215"],

Cell[TextData[{
 "The bright ridge splits into three, the outer two fanning apart along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "=", "\[PlusMinus]", "\[CapitalOmega]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b3641f4-0f52-42c0-0ace-58beaae7102a"],
 ": the dressed-state sidebands. The triplet is what an ordinary spectrometer \
sees."
}], "Text",
 CellID->659120451,ExpressionUUID->"4be4e521-e77f-ec2d-799b-fc8a920bb777"],

Cell[TextData[{
 "A homodyne detector sees something an intensity spectrometer cannot: it \
measures one quadrature ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "-"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Theta]", "TI"]}]], "+", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "+"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "\[Theta]"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20bfa7a2-79b2-80c7-5044-3e0c7844d22d"],
 ", and its spectrum, normalized so the shot-noise floor is one, can fall \
below that floor. The weak drive we examine, ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "=", 
   StyleBox["\[Gamma]", "TI"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f244d6-d311-02bf-0382-5d93e6a45085"],
 ", is exactly an exceptional point of this Liouvillian, the same coalescence \
the quantum point contact met: its two dressed modes merge there, so we read \
this spectrum with the mode-free ",
 Cell[BoxData["resolventSpectrum"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b67ca56-f022-f422-291c-ec1381d4df08"],
 " rather than the eigenmode sum, which would divide by a singular \
eigenbasis. Build it from the measurement current fluctuations:"
}], "Text",
 CellID->1530466570,ExpressionUUID->"2d812222-80c8-810b-5bbe-bb8c3162d051"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mollowHom", "[", 
    RowBox[{
    "\[CapitalOmega]_", ",", " ", "\[Gamma]_", ",", " ", "\[Theta]_", ",", 
     " ", "tones_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", " ", "=", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}]}], ",", " ", 
       "big", ",", " ", "rss", ",", " ", "cth", ",", " ", "mq", ",", " ", 
       "mean"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"big", " ", "=", " ", 
       RowBox[{"liouvillian", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
         RowBox[{"{", "c", "}"}], ",", " ", "2"}], "]"}]}], ";", " ", 
      RowBox[{"rss", " ", "=", " ", 
       RowBox[{"First", "@", 
        RowBox[{"stationary", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", 
          " ", 
          RowBox[{"{", "c", "}"}]}], "]"}]}]}], ";", "\n", "   ", 
      RowBox[{"cth", " ", "=", " ", 
       RowBox[{"c", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "\[Theta]"}], "]"}]}]}], ";", " ", 
      RowBox[{"mq", " ", "=", " ", 
       RowBox[{"cth", " ", "+", " ", 
        RowBox[{"ConjugateTranspose", "[", "cth", "]"}]}]}], ";", " ", 
      RowBox[{"mean", " ", "=", " ", 
       RowBox[{"Re", "@", 
        RowBox[{"Tr", "[", 
         RowBox[{"mq", " ", ".", " ", "rss"}], "]"}]}]}], ";", "\n", "   ", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"resolventSpectrum", "[", 
        RowBox[{"big", ",", " ", 
         RowBox[{
          RowBox[{"cth", " ", ".", " ", "rss"}], " ", "+", " ", 
          RowBox[{"rss", " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "cth", "]"}]}], " ", "-", " ", 
          RowBox[{"mean", " ", "rss"}]}], ",", " ", 
         RowBox[{"mq", " ", "-", " ", 
          RowBox[{"mean", " ", "id2"}]}], ",", " ", "tones"}], "]"}]}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[337]:= ",
 CellID->1148538709,ExpressionUUID->"3ce1a32f-562f-710d-649e-3a8963da4057"],

Cell[TextData[{
 "At weak drive, one quadrature is squeezed and the perpendicular one is not. \
Compare the two at ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "=", "0.25", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "300dd36f-3764-9e2b-6032-cb494216e571"],
 ":"
}], "Text",
 CellID->1755752829,ExpressionUUID->"4c3da1d2-94cd-5311-75c2-389c1d783e7b"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tones", ",", " ", 
        RowBox[{"mollowHom", "[", 
         RowBox[{"0.25", ",", " ", "1.", ",", " ", 
          RowBox[{"Pi", "/", "2"}], ",", " ", "tones"}], "]"}]}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tones", ",", " ", 
        RowBox[{"mollowHom", "[", 
         RowBox[{"0.25", ",", " ", "1.", ",", " ", "0.", ",", " ", "tones"}], 
         "]"}]}], "}"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"Directive", "[", 
          RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], "}"}]}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<squeezed quadrature (\[Theta] = \[Pi]/2)\>\"", ",", 
      " ", "\"\<anti-squeezed (\[Theta] = 0)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0.7", ",", " ", "All"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency\>\"", ",", 
      " ", "\"\<homodyne spectrum / shot noise\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<resonance fluorescence dips below the shot-noise floor\>\""}]}],
   "]"}]], "Input",
 CellLabel->"In[338]:= ",
 CellID->1464413666,ExpressionUUID->"6725d2c7-83c3-a466-0eda-cba136770f4c"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30f7e14b-6bce-fb20-608c-f9150e78c60a"],
 " quadrature dips below the dashed shot-noise line while its partner rises \
above it: the atom's fluorescence is squeezed, its noise pushed below the \
vacuum in one quadrature at the cost of excess in the other. Confirm the dip \
is real:"
}], "Text",
 CellID->477976485,ExpressionUUID->"36b60ac5-0872-487b-5e4d-a3afa9071b41"],

Cell[BoxData[
 RowBox[{"Min", "[", 
  RowBox[{"mollowHom", "[", 
   RowBox[{"0.25", ",", " ", "1.", ",", " ", 
    RowBox[{"Pi", "/", "2"}], ",", " ", "tones"}], "]"}], "]"}]], "Input",
 CellLabel->"In[339]:= ",
 CellID->1079844684,ExpressionUUID->"42a6af43-9231-5484-725d-472d27c43eee"],

Cell["\<\
Below one: sub-shot-noise, a signature of nonclassical light that only \
phase-sensitive (homodyne) detection can reveal, and that the \
necessarily-nonnegative intensity spectrum of the triplet can never show.\
\>", "Text",
 CellID->681181479,ExpressionUUID->"2cbe9beb-23d5-e081-5445-12b55661b2eb"],

Cell[TextData[{
 "How far the squeezing reaches, and where it is deepest, is a question about \
the drive, and it is cleanest at zero frequency, the bottom of the dip we \
just drew. There the homodyne spectrum has the closed form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "1", "+", "8", 
   SuperscriptBox["\[CapitalOmega]", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"4", 
    SuperscriptBox["\[CapitalOmega]", "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", "2", 
      SuperscriptBox["\[CapitalOmega]", "2"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e2217e0-2499-112c-37d1-8eca4d2c6076"],
 " in units of ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ff6f087-faf0-a568-158d-e9e0fe8a0fb2"],
 ", which drops below one exactly when ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "<", 
   StyleBox["\[Gamma]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16ade48a-ef31-1f64-3e52-fdd78ac4624e"],
 ". Read ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00277703-eb91-13ac-31dd-6f6c8e2461f6"],
 " off the same machinery:"
}], "Text",
 CellID->1509583139,ExpressionUUID->"733a2e46-5515-03a9-22d9-c0205ca051f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"zeroFreqSqueeze", "[", "\[CapitalOmega]_", "]"}], " ", ":=", " ", 
   
   RowBox[{
    RowBox[{"mollowHom", "[", 
     RowBox[{"\[CapitalOmega]", ",", " ", "1.", ",", " ", 
      RowBox[{"Pi", "/", "2"}], ",", " ", 
      RowBox[{"{", "0.", "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[340]:= ",
 CellID->1635716693,ExpressionUUID->"3a85de0d-f49a-8910-6aba-d056fd2cd87a"],

Cell["and sweep it across the drive:", "Text",
 CellID->677984635,ExpressionUUID->"51a44dbe-e8d5-ad1e-075c-64fb8961f464"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"om", ",", " ", 
       RowBox[{"zeroFreqSqueeze", "[", "om", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"om", ",", " ", "0.05", ",", " ", "1.2", ",", " ", "0.02"}], 
      "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "0.5", "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"Directive", "[", 
          RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], "}"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<drive \[CapitalOmega]/\[Gamma]\>\"", ",", 
      " ", "\"\<zero-frequency spectrum S(0)\>\""}], "}"}]}], ",", "\n", " ", 
   
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the in-phase quadrature is squeezed only for \[CapitalOmega] < \
\[Gamma]/2\>\""}]}], "]"}]], "Input",
 CellLabel->"In[341]:= ",
 CellID->328233113,ExpressionUUID->"48fac1ee-cedf-3fa9-7899-d8cbeb6b85f3"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57d65f39-cbd6-cc34-7dee-5762ee60971e"],
 " dips below the shot-noise line on ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "<", 
   StyleBox["\[Gamma]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f9472dd-9541-0a0e-55ac-6b871cf45954"],
 " (the vertical gridline) and rises above it past that drive, deepest at ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "=", 
   FractionBox["1", "2"], 
   SqrtBox[
    RowBox[{"3", "-", 
     SqrtBox["7"]}]], "\[ThinSpace]", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d3a3c62-0210-a9d6-64d9-b64cb7aafb3c"],
 ", where it reaches ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"323", "-", "56", 
    SqrtBox["7"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "243"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "357989b9-a09f-e5cf-6306-20e2d12bcf15"],
 ". Push harder and the anti-squeezed quadrature's excess noise floods over \
the floor: the in-phase squeezing is a weak-drive effect, and the shallow \
spectral squeezing that lingers to higher drive has slid off zero frequency. \
Confirm the plotted curve is that closed form and not an artifact of the \
resolvent:"
}], "Text",
 CellID->1783463389,ExpressionUUID->"0fae0884-bf9b-3b68-3555-a1ee3a2f89b2"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"zeroFreqSqueeze", "[", "om", "]"}], " ", "-", " ", 
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"8", " ", 
         RowBox[{"om", "^", "2"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"4", " ", 
             RowBox[{"om", "^", "2"}]}], " ", "-", " ", "1"}], ")"}], "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"2", " ", 
              RowBox[{"om", "^", "2"}]}]}], ")"}], "^", "3"}]}]}]}], ")"}]}], 
     "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"om", ",", " ", "0.05", ",", " ", "1.2", ",", " ", "0.05"}], 
     "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[342]:= ",
 CellID->345427966,ExpressionUUID->"33445fcf-b4d7-bfdc-617c-56a93d630526"],

Cell["\<\
The maximum discrepancy is at numerical precision. The whole spectroscopy, \
elastic line, inelastic triplet, and squeezing dip, comes from the two-time \
correlations of the same master equation built on the first page.\
\>", "Text",
 CellID->438183996,ExpressionUUID->"7ca36f6b-0429-ee44-2450-8735adddb4ae"],

Cell["Where This Leaves Us", "Section",
 CellID->1914081905,ExpressionUUID->"18db0f17-f9d7-aea7-48f8-a750f863f48d"],

Cell["\<\
From plain matrices and a few rules, we built a small laboratory for open \
quantum systems: the master equation for the unconditioned average, a \
positivity-preserving finite-step filter for a kept record, and plotters for \
the Bloch sphere, phase space, covariance ellipses, and spectra. On that \
base, twenty systems: pure dephasing, a driven damped atom, a cavity cat \
decohering at a rate set by the square of its separation, the Haroche \
experiment, dispersive qubit readout, quantum Brownian motion, the \
jump/homodyne/heterodyne unravellings, the quantum Zeno effect, a charge \
qubit read by a quantum point contact, measurement-induced collapse, a \
quantum Kalman filter, measurement feedback, thermalization, rapid \
purification, feedback cooling, the linear-vs-nonlinear trajectory, and the \
Mollow triplet. The recurring theme is conditionality: a complete ideal \
record can keep an initially pure state on a pure stochastic trajectory, \
whereas missed channels, inefficiency, or mixed initial data produce mixed \
conditional states. In every unravelling, ensemble recovery of the master \
equation is a joint large-sample and small-step limit. Change a number, rerun \
the convergence checks, and watch the physics move.\
\>", "Text",
 CellID->2065968196,ExpressionUUID->"73df1c92-0fac-0f76-21e4-95dcaa59525c"]
},
