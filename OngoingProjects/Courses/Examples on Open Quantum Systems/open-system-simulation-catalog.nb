       RowBox[{"\"\<time\>\"", ",", " ", "\"\<position\>\""}], "}"}]}], ",", 
     " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<the filter locks onto the reference conditional mean from the \
record alone\>\""}]}], "]"}], ",", "\n", " ", 
   RowBox[{"LineLegend", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ColorData", "[", 
        RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"ColorData", "[", 
        RowBox[{"97", ",", " ", "1"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<reference conditional mean\>\"", ",", 
       " ", "\"\<estimate from wrong prior \[PlusMinus]\[Sigma]\>\""}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[215]:= ",
 CellID->1901365905,ExpressionUUID->"4b103241-69e7-988c-792f-b42b0f93ead6"],

Cell["\<\
The estimate begins wildly wrong (opposite sign and outside its stated band), \
then the record pulls it close to the reference conditional mean while the \
band approaches the steady conditional width: this observable model forgets \
the deliberately wrong mean. The reference mean is not a hidden classical \
position; it is the conditional mean generated by the simulated innovation.\
\>", "Text",
 CellID->1056348074,ExpressionUUID->"423e0d65-9e44-f34a-73c5-a54f1bf6c190"],

Cell["\<\
Confirm the lock, comparing the two once the filter has settled:\
\>", "Text",
 CellID->5121024,ExpressionUUID->"1bc261b5-654b-a677-49f2-78ff0cff0d5d"],

Cell[BoxData[
 RowBox[{"Abs", "[", 
  RowBox[{
   RowBox[{"Last", "@", 
    RowBox[{"kalTrue", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], " ", "-", " ", 
   RowBox[{"Last", "@", 
    RowBox[{"kalFilt", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[216]:= ",
 CellID->1201452384,ExpressionUUID->"34f1caf0-755d-71af-5c8e-e3ba7ce843f5"],

Cell[TextData[{
 "The endpoint difference is about ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14d4f14a-07e3-3752-3ceb-e914b1979db8"],
 " for this seeded Euler discretization. It is small on the unit position \
scale but not zero; refining ",
 Cell[BoxData["kalDt"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b5a0245-2820-625f-2979-a42f49d530a5"],
 " is the relevant convergence check."
}], "Text",
 CellID->1321205547,ExpressionUUID->"45aa5bc0-73da-807d-73aa-52aa066cd347"],

Cell[TextData[{
 "The engine of the filter is its own innovation, the record minus the ",
 StyleBox["filter's", "TI"],
 " prediction (not the reference mean's). For an optimal filter this must be \
white noise, zero-mean and uncorrelated; measure its autocorrelation past the \
transient, with the ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "2", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "688d67fd-2a77-4fd5-18b3-7ea74f02153f"],
 " band that white noise would sit inside:"
}], "Text",
 CellID->1168360678,ExpressionUUID->"206ab830-fe85-388c-5069-327dfb318ad6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kalInnov", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"#2", " ", "-", " ", 
           RowBox[{
            RowBox[{"#1", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "kalDt"}]}], ")"}]}], " ", 
        "&"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Most", "@", "kalFilt"}], ",", " ", "kalRec"}], "}"}]}], 
      "]"}], "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"Round", "[", 
        RowBox[{"kalN", "/", "3"}], "]"}], " ", ";;"}], "]"}], "]"}], "/", 
    RowBox[{"Sqrt", "[", "kalDt", "]"}]}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ci", " ", "=", " ", 
     RowBox[{"2", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Length", "[", "kalInnov", "]"}], "]"}]}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"CorrelationFunction", "[", 
      RowBox[{"kalInnov", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "10"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Filling", " ", "->", " ", "Axis"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.2"}], ",", " ", "0.2"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ci", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "ci"}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}]}], "}"}]}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{"ImageSize", " ", "->", " ", "440"}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<lag\>\"", ",", 
        " ", "\"\<innovation autocorrelation\>\""}], "}"}]}], ",", " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<the filter's innovation is white within confidence \
limits\>\""}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[217]:= ",
 CellID->1790612322,ExpressionUUID->"6259337f-42f1-dd99-1266-ab397685a7e3"],

Cell["\<\
For this finite record the displayed nonzero-lag correlations lie within the \
approximate white-noise bands. Innovation whiteness is a necessary and useful \
model diagnostic, not by itself a proof of optimality: a wrong model can pass \
a short autocorrelation check, and a correct one can show excursions in \
finite data.\
\>", "Text",
 CellID->26037494,ExpressionUUID->"36c57d9d-81e8-42ea-5efb-74c7379d1030"],

Cell["Measurement Feedback: Steering With the Record", "Subsection",
 CellID->87820654,ExpressionUUID->"45788596-5db6-3a96-7307-1cd0544088fc"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Feed the homodyne record back as a Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["H", "TI"], "^"], 
    StyleBox["fb",
     FontSlant->"Plain"]], "=", 
   OverscriptBox[
    StyleBox["J", "TI"], "."], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["F", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c54ae11-ac51-e949-146b-405ac5e5bb93"],
 ", the feedback signal being the homodyne current ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["J", "TI"], "."], "=", 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d4030e4-6c2c-f7e9-0b7f-a9ce05dedd33"],
 " read off the record ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "=", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503b1edc-b945-4d24-01d8-978638f0140e"],
 ", so over a step the loop applies ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["F", "TI"], "^"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f836107-b46e-407e-35b1-79613d1b1344"],
 "; averaged over the noise, the conditioned-plus-feedback evolution becomes \
the Wiseman-Milburn feedback master equation"
}], "Text",
 CellID->668477954,ExpressionUUID->"267182e5-332f-0e8d-4e0e-1bcf46da54d7"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       StyleBox["i", "TI"], 
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        OverscriptBox[
         StyleBox["H", "TI"], "^"], ",", 
        StyleBox["\[Rho]", "TI"]}], 
       StyleBox["]",
        SpanMaxSize->1]}]}], "+", 
     RowBox[{
      RowBox[{"\|01d49f", 
       StyleBox["[",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["c", "TI"], "^"], 
       StyleBox["]",
        SpanMaxSize->1]}], 
      StyleBox["\[Rho]", "TI"]}], "-", 
     RowBox[{
      StyleBox["i", "TI"], 
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       OverscriptBox[
        StyleBox["F", "TI"], "^"], ",", " ", 
       RowBox[{
        RowBox[{
         OverscriptBox[
          StyleBox["c", "TI"], "^"], 
         StyleBox["\[Rho]", "TI"]}], "+", 
        RowBox[{
         StyleBox["\[Rho]", "TI"], 
         SuperscriptBox[
          OverscriptBox[
           StyleBox["c", "TI"], "^"], "\[Dagger]"]}]}]}], 
      StyleBox["]",
       SpanMaxSize->1]}], "+", 
     RowBox[{
      FractionBox["1", 
       StyleBox["\[Eta]", "TI"]], "\[ThinSpace]", 
      RowBox[{"\|01d49f", 
       StyleBox["[",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["F", "TI"], "^"], 
       StyleBox["]",
        SpanMaxSize->1]}], 
      StyleBox["\[Rho]", "TI"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->658691238,ExpressionUUID->"154e4ea8-041b-018f-4376-67f2adae53d5"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16f6496c-6c93-397b-3e8e-613605278841"],
 " the detection efficiency, this is just a plain leak with a shifted \
operator, ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "-", 
    StyleBox["i", "TI"], 
    OverscriptBox[
     StyleBox["F", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e61f31d-599e-ef91-561e-eb475828b5fb"],
 ", plus a Hamiltonian correction. The feedback engineers the effective \
damping, here steering the maximally mixed qubit onto a chosen state. Drive \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "591a22e5-07a0-ff20-0f39-bbcfb25ac20a"],
 " to one with the record itself and check it against this equation."
}], "Text",
 CellID->1593411516,ExpressionUUID->"352cfa2a-2f90-a2db-5cd3-fc744a2af021"],

Cell[TextData[{
 "Close the loop: feed the measurement record back as a Hamiltonian in \
proportion, so the record steers the state. Concretely the measured operator \
is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76eee8f9-1f6f-e745-1e95-01a39a1bcdaf"],
 " and the feedback generator is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["F", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d128122-8bef-720a-0b21-188c2d9a4150"],
 ", so the loop measures ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04c061a2-1318-56b6-2cf0-780ca6ad3c9c"],
 " and rotates about ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4605043a-8429-851b-6e3a-9e642dddec61"],
 " by an amount set by the record. The one constant ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17a8a95e-16a9-5185-3d57-4118a35c23ef"],
 " does two jobs here: it is the measurement rate, ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["G", "TI"], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6164d6ec-2035-6999-171b-cfb651c03be3"],
 ", and it is the feedback gain, entering through ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["F", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ca33e02-c939-75ea-1450-b06fe8cc5f30"],
 "; the two are matched on purpose, which is exactly what makes the target a \
dark state of the shifted leak below. The shifted operator is then ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "-", 
   StyleBox["i", "TI"], 
   OverscriptBox[
    StyleBox["F", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["y", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22ebf147-b876-3430-52e8-e92139009f1a"],
 ", and the Hamiltonian correction ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["F", "TI"], "^"], "+", 
    OverscriptBox[
     StyleBox["F", "TI"], "^"], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cfbc0fa-05b7-6e65-1498-d9a4ac42354f"],
 " vanishes because ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5726608a-327b-32d7-7ede-79d4470f803d"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["y", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1988f3c5-ff1f-c744-4fb7-eaaefaabadae"],
 " anticommute, so the ideal loop is the single leak ",
 Cell[BoxData[
  RowBox[{
   StyleBox["G", "TI"], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["y", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f1f17bc-e58b-5e92-0524-8ef98c3e24f8"],
 ". Set the gain and the time grid:"
}], "Text",
 CellID->472705648,ExpressionUUID->"5792d973-b7d4-8b8a-7da1-d13cc266d9d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Gfb", " ", "=", " ", "0.8"}], ";", " ", 
  RowBox[{"tickFb", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"track", " ", "=", " ", 
   RowBox[{"tickFb", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "200"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[218]:= ",
 CellID->651685264,ExpressionUUID->"5edc8535-c3b1-a7f4-06e3-1d7ef6450dde"],

Cell[TextData[{
 "A rotation about ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6224b0f8-da78-eb38-13db-29a5dff2b602"],
 " has a closed form, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["y", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Phi]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Phi]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["y", "TI"]]}]], "=", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Phi]", "TI"], "\[ThinSpace]", "\|01d7d9", "-", 
   StyleBox["i", "TI"], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Phi]", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c93b30-61da-1cc4-77f6-b37a106f662e"],
 ", and it is what the generator ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["F", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50e14eb3-b435-065f-009f-67fd3dc06ca5"],
 " produces: the feedback unitary applied each step is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     OverscriptBox[
      StyleBox["F", "TI"], "^"], "\[ThinSpace]", 
     StyleBox["d", "TI"], 
     StyleBox["J", "TI"]}]], "=", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["y", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SqrtBox[
     StyleBox["G", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["J", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e168156-9322-bc9f-762d-191026d406e5"],
 ", so ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["F", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c24659b-7133-dc8c-65dc-7cc500c7a6d6"],
 " is the generator and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["R", "TI"], 
   StyleBox["y", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c508251-7fc9-b51c-546f-241b7a7d1c66"],
 " the finite rotation, not one and the same. The step is light:"
}], "Text",
 CellID->767085021,ExpressionUUID->"1eef6872-bce7-1e04-4694-823c3492656e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rotateY", "[", "\[Phi]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", "id2"}], " ", "-", " ", 
    RowBox[{"I", " ", 
     RowBox[{"Sin", "[", "\[Phi]", "]"}], " ", "Y"}]}]}], ";"}]], "Input",
 CellLabel->"In[219]:= ",
 CellID->624501814,ExpressionUUID->"30befcd9-b2cd-4711-6045-f582c7782a7b"],

Cell[TextData[{
 "One steered run, one step at a time. Write ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["meas",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75516dcf-8dc3-fc25-236e-84a92477c70f"],
 " for the positivity-preserving measurement update of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0310a516-2392-3bde-312f-3d5056248924"],
 " under ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f6c7faf-a6fa-97ca-4514-7608d28cfd10"],
 ", given the record ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "=", "2", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["\[Rho]", "TI"]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2573a629-b9de-50ac-5300-3873386b22f6"],
 ". One step measures, then rotates by the commanded angle ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Phi]", "TI"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59197c34-7185-90b0-0f27-767e0031e29a"],
 ":"
}], "Text",
 CellID->1504331274,ExpressionUUID->"2c633381-a2a9-ed02-5410-aaead75db468"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Rho]", "TI"], "\[Prime]"], "=", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["y", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Phi]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["meas",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["y", "TI"]], 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Phi]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], "\[Dagger]"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["\[Phi]", "TI"], "=", 
    RowBox[{
     SqrtBox[
      StyleBox["G", "TI"]], "\[ThinSpace]", 
     StyleBox["d", "TI"], 
     StyleBox["J", "TI"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1994044242,ExpressionUUID->"60c43628-0d8b-12d9-10fb-a872a43e6023"],

Cell[TextData[{
 "run ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", "200"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f555f5b-d3f6-518f-056b-5704e58323d5"],
 " times from ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "0"], "=", 
   FractionBox["1", "2"], "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3145b7cb-6bdc-88b3-677a-2e950e6eda99"],
 ". Keeping the pair ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], ",", 
    StyleBox["\[Phi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b7074b7-b7c4-ad31-1900-6df0c276f41b"],
 " at each step, the run is the whole causal chain at once,"
}], "Text",
 CellID->1520445855,ExpressionUUID->"6b848cdb-7c95-016b-19bb-2585752053b1"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "0"], ",", "\[ThinSpace]", "0"}], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", " ", 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "1"], ",", 
       SubscriptBox[
        StyleBox["\[Phi]", "TI"], "1"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", " ", "\[Ellipsis]", ",", " ", 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], 
        StyleBox["N", "TI"]], ",", 
       SubscriptBox[
        StyleBox["\[Phi]", "TI"], 
        StyleBox["N", "TI"]]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1470891495,ExpressionUUID->"479e0012-80c3-e229-6da5-9a5c3177b173"],

Cell[TextData[{
 "each state beside the command that produced it, the seed angle a \
placeholder ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d6e3eb6-fa93-dc86-6b15-b7f3ff27a6ec"],
 ". One function then feeds every plot below, the response curves from its \
states and the command panel from its angles:"
}], "Text",
 CellID->1799794391,ExpressionUUID->"43bbad2d-592e-7807-7158-457758db4b6d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"steer", "[", "seed_", "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"measure", " ", "=", " ", 
         RowBox[{"measurementStep", "[", 
          RowBox[{
           RowBox[{"0", " ", "id2"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", "Z"}], "}"}], ",", " ", 
           RowBox[{"{", "1.", "}"}], ",", " ", 
           RowBox[{"{", "}"}], ",", " ", "tickFb"}], "]"}]}], "}"}], ",", 
       "\n", "    ", 
       RowBox[{"FoldList", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"prev", ",", " ", "dw"}], "}"}], ",", "\n", "      ", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"rho", " ", "=", " ", 
               RowBox[{"prev", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", "\n", "       ", 
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"dJ", " ", "=", " ", 
                 RowBox[{"measurementRecord", "[", 
                  RowBox[{"rho", ",", " ", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", "Z"}], "}"}], ",",
                    " ", 
                   RowBox[{"{", "1.", "}"}], ",", " ", "tickFb", ",", " ", 
                   RowBox[{"{", "dw", "}"}]}], "]"}]}], "}"}], ",", "\n", 
               "        ", 
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"u", " ", "=", " ", 
                   RowBox[{"rotateY", "[", 
                    RowBox[{
                    RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", 
                    RowBox[{"dJ", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"u", " ", ".", " ", 
                    RowBox[{"measure", "[", 
                    RowBox[{"rho", ",", " ", "dJ"}], "]"}], " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], ",", " ", 
                   RowBox[{
                    RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", 
                    RowBox[{"dJ", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}]}], "]"}]}], 
              "]"}]}], "]"}]}], "]"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"id2", "/", "2"}], ",", " ", "0."}], "}"}], ",", "\n", 
         "     ", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"Sqrt", "[", "tickFb", "]"}]}], "]"}], ",", " ", "200"}],
           "]"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[220]:= ",
 CellID->1171173153,ExpressionUUID->"6945d0ce-c536-08cf-1f7a-c9abecc35a15"],

Cell[TextData[{
 "This feedback has a target: the ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fccf01f-c27b-aa81-65f3-ea58f70ff8eb"],
 " state is a fixed point the loop leaves alone, so from the maximally mixed \
state the loop should build it. Confirm ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "580a63e8-e8bd-fc69-080a-7ab58949c6b3"],
 " is the dark state (the shifted operator annihilates it):"
}], "Text",
 CellID->900360919,ExpressionUUID->"1e444979-635e-5aae-467c-612316eb28f4"],

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{"Z", " ", "-", " ", 
       RowBox[{"I", " ", "Y"}]}], ")"}]}], ")"}], " ", ".", " ", "plus"}], 
  "]"}]], "Input",
 CellLabel->"In[221]:= ",
 CellID->1309857001,ExpressionUUID->"5291a49d-a239-bb17-02ae-3dc6d7cd067d"],

Cell[TextData[{
 "The zero vector confirms it. Integrate the feedback master equation for the \
predicted ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ed3e0f7-5290-ff26-56e0-f9b1672ac20c"],
 ":"
}], "Text",
 CellID->2058064877,ExpressionUUID->"5e38d601-1464-7519-07c7-c86b9d115c63"],

Cell[BoxData[
 RowBox[{
  RowBox[{"predicted", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"blochVector", "[", 
       RowBox[{
        RowBox[{"evolveODE", "[", 
         RowBox[{
          RowBox[{"0", " ", "id2"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{"Z", " ", "-", " ", 
              RowBox[{"I", " ", "Y"}]}], ")"}]}], "}"}], ",", " ", 
          RowBox[{"id2", "/", "2"}], ",", " ", "2."}], "]"}], "[", "#", "]"}],
        "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", "track"}]}],
   ";"}]], "Input",
 CellLabel->"In[222]:= ",
 CellID->1911790330,ExpressionUUID->"0fc3dc78-1302-6f10-35f0-d622a6b7327a"],

