    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"track", "[", 
          RowBox[{"[", 
           RowBox[{"2", " ", ";;"}], "]"}], "]"}], ",", " ", 
