Cell[BoxData[
 RowBox[{
  RowBox[{"kalFilt", " ", "=", " ", 
   RowBox[{"FoldList", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xp", ",", " ", "jdy"}], "}"}], ",", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"j", " ", "=", " ", 
            RowBox[{"jdy", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
           RowBox[{"dwf", " ", "=", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"jdy", "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
               RowBox[{
                RowBox[{"xp", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "kalDt"}]}], 
              ")"}]}]}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"xp", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"xp", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", "kalDt"}], " ", "+", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
             RowBox[{
              RowBox[{"riccati", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"kalGrid", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "dwf"}]}], ",", 
           "\n", "      ", 
           RowBox[{
            RowBox[{"xp", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"xp", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "kalDt"}], " ", "+", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
             RowBox[{
              RowBox[{"riccati", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "[", 
              RowBox[{"kalGrid", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "dwf"}]}]}], 
          "}"}]}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "3."}], ",", " ", "0."}], "}"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", "kalN", "]"}], ",", " ", "kalRec"}], "}"}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[192]:= ",
 CellID->1384833740,ExpressionUUID->"24441621-d1c3-83e7-4c7b-8f8ae077d1cd"],

Cell[TextData[{
 "Read the ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1", 
   StyleBox["\[Sigma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40c04446-bf75-68d5-70f0-5e203a003a3f"],
 " band off the covariance:"
}], "Text",
 CellID->1880473289,ExpressionUUID->"337e031d-61ac-97b3-6105-9b47105efd99"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kalBand", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"riccati", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", "#", "]"}], "]"}], " ", "&"}], 
    " ", "/@", " ", "kalGrid"}]}], ";"}]], "Input",
 CellLabel->"In[193]:= ",
 CellID->117881571,ExpressionUUID->"6c1a2f33-e4c4-62b1-1439-c77c8d71309b"],

Cell[TextData[{
 "Now visualize the tracking: the reference conditional mean, and the \
estimate from the incorrect prior rising out of its wrong start into a \
shrinking ",
 Cell[BoxData[
