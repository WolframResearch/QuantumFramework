         RowBox[{
          SubsuperscriptBox[
           OverscriptBox[
            StyleBox["R", "TI"], "^"], 
           StyleBox["j", "TI"], "\[Dagger]"], 
          SubscriptBox[
           OverscriptBox[
            StyleBox["R", "TI"], "^"], 
           StyleBox["j", "TI"]]}]}]}]}], ")"}], 
     TemplateBox[{
       OverscriptBox[
        StyleBox["\[Psi]", "TI"], "~"]},
      "Ket"], 
     StyleBox["d", "TI"], 
     StyleBox["t", "TI"]}], "+", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["j", "TI"],
      LimitsPositioning->False], 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["R", "TI"], "^"], 
       StyleBox["j", "TI"]], 
      TemplateBox[{
        OverscriptBox[
         StyleBox["\[Psi]", "TI"], "~"]},
       "Ket"], 
      StyleBox["d", "TI"], 
      RowBox[{
       SubscriptBox[
        StyleBox["W", "TI"], 
        StyleBox["j", "TI"]], "."}]}]}]}]}],
