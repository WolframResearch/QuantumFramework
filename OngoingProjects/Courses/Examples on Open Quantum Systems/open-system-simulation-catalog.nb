  FontSize->0.9 Inherited,ExpressionUUID->
  "41c6bfc6-0792-5005-77fd-36a0b227236f"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["z", "TI"], "."], "=", "\[CapitalOmega]", 
   StyleBox["y", "TI"], "-", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["z", "TI"], "+", "1"}], 
