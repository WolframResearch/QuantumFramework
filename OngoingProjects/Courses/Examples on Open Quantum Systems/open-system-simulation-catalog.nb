Cell["\<\
Read the two triples against each other: the small-phase cat keeps its \
fringes across the window, while the large-phase cat, its two states farther \
apart, has collapsed to a fringeless mixture by the end. Same cavity, same \
leak, same clock; only the separation differs, and the fringes die at a rate \
set by its square.\
\>", "Text",
 CellID->573363004,ExpressionUUID->"5bf36e21-2d79-2b6f-0980-878b440c79b5"],

Cell["\<\
Turn that into a number. The mixture the cat decays toward is the equal blend \
of its two pointer states, each amplitude shrinking with the cavity,\
\>", "Text",
 CellID->1565937439,ExpressionUUID->"6fe9f85b-1ce6-27f0-1596-f20594908dda"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["mix",
       FontSlant->"Plain"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Phi]", "TI"], ",", 
       StyleBox["t", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     FractionBox["1", "2"], "[", 
     RowBox[{
      RowBox[{
       TemplateBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["\[Alpha]", "TI"], "+"], 
           StyleBox["(", SpanMaxSize -> 1], 
           StyleBox["t", "TI"], 
           StyleBox[")", SpanMaxSize -> 1]}]},
        "Ket"], 
       TemplateBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["\[Alpha]", "TI"], "+"], 
           StyleBox["(", SpanMaxSize -> 1], 
           StyleBox["t", "TI"], 
           StyleBox[")", SpanMaxSize -> 1]}]},
        "Bra"]}], "+", 
      RowBox[{
       TemplateBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["\[Alpha]", "TI"], "-"], 
           StyleBox["(", SpanMaxSize -> 1], 
           StyleBox["t", "TI"], 
           StyleBox[")", SpanMaxSize -> 1]}]},
        "Ket"], 
       TemplateBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["\[Alpha]", "TI"], "-"], 
           StyleBox["(", SpanMaxSize -> 1], 
           StyleBox["t", "TI"], 
           StyleBox[")", SpanMaxSize -> 1]}]},
        "Bra"]}]}], "]"}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], "\[PlusMinus]"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{"2", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["t", "TI"], "/", "2"}]], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"\[PlusMinus]", 
       StyleBox["i", "TI"], 
       StyleBox["\[Phi]", "TI"]}]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1825661031,ExpressionUUID->"3eadea9f-7d43-757d-6652-03d974f65c47"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["har",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68be2dd2-eea3-f2cb-1845-c49f8b57c011"],
 ":"
}], "Text",
 CellID->1952919625,ExpressionUUID->"1279eb8d-ef8a-5dbb-4206-02d68a3f2781"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mixture", "[", 
    RowBox[{"\[Phi]_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sh", " ", "=", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Gamma]har"}], " ", 
         RowBox[{"t", "/", "2"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"densityMatrix", "[", 
         RowBox[{"coherentState", "[", 
          RowBox[{"topHar", ",", " ", 
           RowBox[{"2.", " ", "sh", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", "\[Phi]"}], "]"}]}]}], "]"}], "]"}], 
        " ", "+", " ", 
        RowBox[{"densityMatrix", "[", 
         RowBox[{"coherentState", "[", 
          RowBox[{"topHar", ",", " ", 
           RowBox[{"2.", " ", "sh", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "\[Phi]"}], "]"}]}]}], "]"}], "]"}]}], ")"}], "/",
       "2"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[104]:= ",
 CellID->162062935,ExpressionUUID->"6afb4307-9f81-9d1b-1a99-5b611a35e461"],

Cell["\<\
The surviving coherence is the trace distance between the leak-evolved \
conditional cat and that mixture, over a list of delays, one master-equation \
run per phase:\
\>", "Text",
 CellID->1483832353,ExpressionUUID->"2e902be9-4fb4-3e90-56af-c2b36a4684fa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"coherenceLeft", "[", 
    RowBox[{"\[Phi]_", ",", " ", "delays_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"run", " ", "=", " ", 
       RowBox[{"evolveODE", "[", 
        RowBox[{
         RowBox[{"0", " ", "blankHar"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[Gamma]har", "]"}], " ", "downHar"}], "}"}],
          ",", " ", 
         RowBox[{"conditionalCat", "[", 
          RowBox[{"\[Phi]", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"Max", "[", "delays", "]"}]}], "]"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"traceDistance", "[", 
        RowBox[{
         RowBox[{"run", "[", "t", "]"}], ",", " ", 
         RowBox[{"mixture", "[", 
          RowBox[{"\[Phi]", ",", " ", "t"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "delays"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"delays", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", "3", ",", " ", "0.25"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"close", ",", " ", "far"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"coherenceLeft", "[", 
      RowBox[{"0.5", ",", " ", "delays"}], "]"}], ",", " ", 
     RowBox[{"coherenceLeft", "[", 
      RowBox[{"1.3", ",", " ", "delays"}], "]"}]}], "}"}]}], ";"}]}], "Input",\

 CellLabel->"In[105]:= ",
 CellID->421271511,ExpressionUUID->"46e8ad28-93a4-355d-6e97-457226569fa7"],

Cell["Visualize the two normalized coherences against the delay:", "Text",
 CellID->971430162,ExpressionUUID->"43090fa7-5002-8b65-7136-a60161b4d64f"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"delays", ",", " ", 
        RowBox[{"close", "/", 
         RowBox[{"First", "@", "close"}]}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"delays", ",", " ", 
        RowBox[{"far", "/", 
         RowBox[{"First", "@", "far"}]}]}], "}"}], "]"}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
