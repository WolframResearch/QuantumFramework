    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["I", "TI"]], "+", "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     StyleBox["Q", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["Q", "TI"]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1331866192,ExpressionUUID->"2dc22b63-32d1-862f-5bf1-c34d4765ed75"],

Cell[TextData[{
 "   with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["I", "TI"], "2"], "=", 
   StyleBox["d", "TI"], 
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["Q", "TI"], "2"], "=", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36ea7e2c-072a-2221-5eea-7076b2df710b"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["I", "TI"]], 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["Q", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b23761c-2477-64e8-0ad1-68464d024e32"],
 "; the two records are"
}], "Text",
 CellID->1391655620,ExpressionUUID->"73216bcf-7cf1-61ac-22de-82a9748433f6"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["j", "TI"]], "=", 
    SubscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        OverscriptBox[
         StyleBox["c", "TI"], "^"], 
        StyleBox["j", "TI"]], "+", 
       SubsuperscriptBox[
        OverscriptBox[
         StyleBox["c", "TI"], "^"], 
        StyleBox["j", "TI"], "\[Dagger]"]}], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["j", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["j", "TI"], "\[Element]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["I", "TI"], ",", 
      RowBox[{
       RowBox[{
        StyleBox["Q", "TI"], "}"}], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->861714746,ExpressionUUID->"69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],

Cell[TextData[{
 StyleBox["Quantum Zeno dynamics.",
  FontWeight->"Bold"],
 " For the code's monitored operator ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "409bca18-cbd6-e54d-70b8-ec45ee60cf97"],
 ","
}], "ItemNumbered",
 CellID->1192942815,ExpressionUUID->"10b62b5f-1d3f-f012-404d-c31994cbc378"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "=", "-", 
    StyleBox["i", "TI"], 
    FractionBox["\[CapitalOmega]", "2"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["x", "TI"]], ",", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["c", "TI"]]}], 
    StyleBox["]",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["k", "TI"], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox["k", "TI"]], "\[ThinSpace]", "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->556077107,ExpressionUUID->"79984792-c453-565a-2fb8-5edfede63ca0"],

Cell[TextData[{
 "    Equivalently, the deterministic measurement term is ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox[
    StyleBox["k", "TI"], "2"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], ",", 
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"]], ",", 
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], 
       StyleBox["c", "TI"]]}], 
     StyleBox["]",
      SpanMaxSize->1]}]}], 
   StyleBox["]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d45428e-8fa1-6801-4b7b-5be82a543b6b"],
 ". This convention gives the Liouvillian pair ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["k", "TI"], "\[PlusMinus]", 
   StyleBox["i", "TI"], 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "-", 
     SuperscriptBox[
      StyleBox["k", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "604bb87d-3174-a116-1048-32274006f07c"],
 " and the exceptional point ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "763191a2-6f8b-197a-1fce-080c0a3e6840"],
 " used below."
}], "Text",
 CellID->15883883,ExpressionUUID->"635fdfdb-2856-deda-1164-d68549e0a420"],

Cell[TextData[{
 StyleBox["Charge qubit monitored by a QPC.",
  FontWeight->"Bold"],
 " Since ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\|01d7d9", "-", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],
 ","
}], "ItemNumbered",
 CellID->308842859,ExpressionUUID->"5c8469dd-bfc7-2a7a-04bb-80873a727940"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "=", "-", 
    StyleBox["i", "TI"], "[", 
    RowBox[{
     RowBox[{
      FractionBox["\[CapitalOmega]", "2"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["x", "TI"]]}], ",", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["c", "TI"]]}], "]", "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    FractionBox[
     StyleBox["\[Kappa]", "TI"], "4"], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    FractionBox[
     SqrtBox[
      StyleBox["\[Kappa]", "TI"]], "2"], "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox[
     RowBox[{"d", "J"}], "TI"], "=", 
    RowBox[{
     RowBox[{
      SqrtBox[
       StyleBox["\[Kappa]", "TI"]], "\[ThinSpace]", 
      SubscriptBox[
       RowBox[{
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        SubscriptBox[
         OverscriptBox[
          StyleBox["\[Sigma]", "TI"], "^"], 
         StyleBox["z", "TI"]], 
        StyleBox["\[RightAngleBracket]",
         SpanMaxSize->1]}], 
       StyleBox["c", "TI"]], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{
      StyleBox["d", "TI"], 
      RowBox[{
       StyleBox["W", "TI"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1108042358,ExpressionUUID->"182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],

Cell[TextData[{
 "    Dropping the innovation term gives the unconditional equation ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CapitalOmega]", "/", "2"}], 
     StyleBox[")",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["x", "TI"]]}], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   StyleBox["\[Kappa]", "TI"], "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3921e4bb-f5e4-3596-68de-fde483969ffc"],
 "."
}], "Text",
 CellID->1009200201,ExpressionUUID->"13db9173-5387-1c16-41f8-093d6632677c"],

