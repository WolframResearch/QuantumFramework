\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["C", "TI"], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"2", 
         SqrtBox[
          StyleBox["k", "TI"]]}], "0"}
      }], ")"}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox[
     RowBox[{"d", "J"}], "TI"], "=", 
    RowBox[{
     RowBox[{
      StyleBox["C", "TI"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["r", "TI"], "_"], 
       StyleBox["c", "TI"]], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{
      StyleBox["d", "TI"], 
      RowBox[{
       StyleBox["W", "TI"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->533832725,ExpressionUUID->"4140e475-1e41-1f16-777f-fe3f9bf4627c"],

Cell[TextData[{
 StyleBox["Markovian measurement feedback.",
  FontWeight->"Bold"],
 " For the feedback Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["H", "TI"], "^"], 
    StyleBox[
     RowBox[{"f", "b"}], "TI"]], "=", 
   OverscriptBox[
    StyleBox["J", "TI"], "."], "\[ThinSpace]", 
   OverscriptBox[
