Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox["\[CapitalSigma]", "."], "=", 
    StyleBox["A", "TI"], "\[CapitalSigma]", "+", "\[CapitalSigma]", 
    SuperscriptBox[
     StyleBox["A", "TI"], 
     StyleBox["T", "TI"]], "+", 
    StyleBox["D", "TI"], "-", "\[CapitalSigma]", 
    SuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["T", "TI"]], 
    StyleBox["C", "TI"], "\[CapitalSigma]"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["r", "TI"], "_"], 
      StyleBox["c", "TI"]]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["A", "TI"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["r", "TI"], "_"], 
       StyleBox["c", "TI"]], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{"\[CapitalSigma]", 
      SuperscriptBox[
       StyleBox["C", "TI"], 
       StyleBox["T", "TI"]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["d", "TI"], 
        StyleBox["J", "TI"], "-", 
        StyleBox["C", "TI"], 
        SubscriptBox[
         OverscriptBox[
          StyleBox["r", "TI"], "_"], 
         StyleBox["c", "TI"]], "\[ThinSpace]", 
        StyleBox["d", "TI"], 
        StyleBox["t", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->377280352,ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

Cell[BoxData[
