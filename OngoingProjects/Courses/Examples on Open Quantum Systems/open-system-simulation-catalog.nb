 ","
}], "ItemNumbered",
 CellID->1626918454,ExpressionUUID->"60049622-f570-0e0e-103b-0f8ffc055554"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "=", "-", 
    StyleBox["i", "TI"], 
    FractionBox["\[CapitalOmega]", "2"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["x", "TI"]], ",", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["c", "TI"]]}], 
    StyleBox["]",
     SpanMaxSize->1], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["k", "TI"], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox["k", "TI"]], " ", "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
