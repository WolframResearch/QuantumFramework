Cell["\<\
What a real readout does with those two pointers is discriminate them in the \
IQ plane. Detecting the cavity output (heterodyne) turns each \
qubit-conditioned coherent pointer into a Gaussian blob of measurement \
outcomes, centered at its amplitude with the shot-noise width of a coherent \
state. As the pointers separate the two blobs pull apart and the assignment \
becomes reliable. Sample the two outcome clouds at three readout times:\
\>", "Text",
 CellID->1375299215,ExpressionUUID->"2161c865-0900-0907-571e-e24fa8b5586d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"iqCloud", "[", 
    RowBox[{"ptr_", ",", " ", "t_", ",", " ", "seed_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", "2", "]"}], " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Re", "@", 
            RowBox[{"ptr", "[", "t", "]"}]}], ",", " ", 
           RowBox[{"Im", "@", 
            RowBox[{"ptr", "[", "t", "]"}]}]}], "}"}]}], " ", "+", " ", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", "2"}], "]"}]}], ",",
        " ", "250"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"iqTimes", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.5", ",", " ", "1.5", ",", " ", "4."}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[91]:= ",
 CellID->1656178105,ExpressionUUID->"3cadbe4b-a339-c651-6452-3014d6cdacbb"],

Cell["\<\
Now visualize the readout separating in time, the two clouds (up in blue, \
down in orange) drifting apart across the IQ plane:\
\>", "Text",
 CellID->2128368636,ExpressionUUID->"31169419-f57b-983b-672d-0e42fc0feb01"],

