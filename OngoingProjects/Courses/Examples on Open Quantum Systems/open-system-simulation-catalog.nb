 CellLabel->"In[224]:= ",
 CellID->1903477021,ExpressionUUID->"14f1cae1-901f-fe6e-3c8e-e3cb21abc4b4"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20e5bc00-ef5d-9182-509a-366d8ae9e3e8"],
 " climbs from zero to one: the maximally mixed state is driven to a pure \
state by its own record. This is measurement-based feedback control, the \
basis of feedback cooling and qubit stabilization."
}], "Text",
 CellID->1244942650,ExpressionUUID->"0eb778b1-5bb9-ca6f-364d-71fb5e4d98b5"],

Cell["\<\
The loop has a causal chain worth seeing whole: the noisy record drives a \
control command, which drives the state's response. That same run already \
carries both, so take seed 2 and read its per-step command against its \
response:\
\>", "Text",
 CellID->1429544953,ExpressionUUID->"60fa5ffe-638f-3fb5-109a-56b8163b859f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"feedRun", " ", "=", " ", 
   RowBox[{"steer", "[", "2", "]"}]}], ";"}]], "Input",
 CellLabel->"In[225]:= ",
 CellID->114240660,ExpressionUUID->"730b2763-752d-95c0-2108-bf4d7cd9ff2a"],

Cell[TextData[{
 "Now visualize the loop in time, two panels side by side: the feedback \
rotation the raw record commands at each step, a noise band, and the state's \
response ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fb8ba9f-9118-d887-4547-33d92092aaed"],
 " climbing to the target:"
}], "Text",
 CellID->406013316,ExpressionUUID->"04257d5a-c533-40c1-2ddb-7507ecc6122b"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"{", "\n", "  ", 
   RowBox[{
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
