 CellID->1193935837,ExpressionUUID->"5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], "[", 
    RowBox[{
     RowBox[{
      OverscriptBox[
       StyleBox["H", "TI"], "^"], "+", 
      FractionBox["1", "2"], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SuperscriptBox[
        OverscriptBox[
         StyleBox["c", "TI"], "^"], "\[Dagger]"], 
       OverscriptBox[
        StyleBox["F", "TI"], "^"], "+", 
       OverscriptBox[
        StyleBox["F", "TI"], "^"], 
       OverscriptBox[
        StyleBox["c", "TI"], "^"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", 
     StyleBox["\[Rho]", "TI"]}], "]", "+", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "-", 
     StyleBox["i", "TI"], 
     OverscriptBox[
      StyleBox["F", "TI"], "^"]}], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "+", 
    FractionBox[
     RowBox[{"1", "-", 
      StyleBox["\[Eta]", "TI"]}], 
     StyleBox["\[Eta]", "TI"]], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["F", "TI"], "^"], 
    StyleBox["]",
