         StyleBox["k", "TI"]]}]], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->15883883,ExpressionUUID->"1d45428e-8fa1-6801-4b7b-5be82a543b6b"],

Cell[TextData[{
 StyleBox["Quantum Kalman filter.",
  FontWeight->"Bold"],
 " With ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["r", "TI"], "^"], "=", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["x", "TI"], "^"], ",", 
      OverscriptBox[
       StyleBox["p", "TI"], "^"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["T", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "604bb87d-3174-a116-1048-32274006f07c"],
 ","
}], "ItemNumbered",
 CellID->308842859,ExpressionUUID->"763191a2-6f8b-197a-1fce-080c0a3e6840"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox["\[CapitalSigma]", "."], "=", 
    StyleBox["A", "TI"], "\[CapitalSigma]", "+", "\[CapitalSigma]", 
    SuperscriptBox[
     StyleBox["A", "TI"], 
     StyleBox["T", "TI"]], "+", 
    StyleBox["D", "TI"], "-", "\[CapitalSigma]", 
    SuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["T", "TI"]], 
    StyleBox["C", "TI"], "\[CapitalSigma]"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["r", "TI"], "_"], 
      StyleBox["c", "TI"]]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["A", "TI"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["r", "TI"], "_"], 
       StyleBox["c", "TI"]], " ", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{"\[CapitalSigma]", 
      SuperscriptBox[
       StyleBox["C", "TI"], 
       StyleBox["T", "TI"]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["d", "TI"], 
        StyleBox["J", "TI"], "-", 
        StyleBox["C", "TI"], 
        SubscriptBox[
         OverscriptBox[
          StyleBox["r", "TI"], "_"], 
         StyleBox["c", "TI"]], " ", 
        StyleBox["d", "TI"], 
        StyleBox["t", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1108042358,ExpressionUUID->"635fdfdb-2856-deda-1164-d68549e0a420"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["A", "TI"], "=", "(", GridBox[{
      {"0", "1"},
