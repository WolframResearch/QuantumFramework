     RowBox[{"{", 
      RowBox[{"t", ",", " ", "iqTimes"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "800"}]}], "]"}]], "Input",
 CellLabel->"In[92]:= ",
 CellID->471452856,ExpressionUUID->"40aa99e8-53bd-499c-70a9-10b266481be6"],

Cell[TextData[{
 "Early the clouds overlap and the qubit state is ambiguous; by the last \
frame they are cleanly resolved. Turn that into numbers: the separation ",
 Cell[BoxData[GridBox[{
    {
     RowBox[{
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], "\[UpArrow]"], "-", 
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], "\[DownArrow]"]}]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d165407-aaf3-867b-0b2e-4e60ce87ed41"],
 " sets the single-shot assignment error ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["erfc",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{GridBox[{
      {
       RowBox[{
        SubscriptBox[
         StyleBox["\[Alpha]", "TI"], "\[UpArrow]"], "-", 
        SubscriptBox[
         StyleBox["\[Alpha]", "TI"], "\[DownArrow]"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75cb8946-a0dc-0da7-23c8-2123d169578d"],
 ", the overlap of the two Gaussians. Track both against readout time:"
}], "Text",
 CellID->1993504316,ExpressionUUID->"63688a50-35e7-99e6-1117-2c1a4393ebcc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sepDisp", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"up", "[", "t", "]"}], " ", "-", " ", 
     RowBox[{"dn", "[", "t", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", " ", 
         RowBox[{"sepDisp", "[", "t", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "6", ",", " ", "0.05"}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", " ", 
         RowBox[{"0.5", " ", 
          RowBox[{"Erfc", "[", 
           RowBox[{
            RowBox[{"sepDisp", "[", "t", "]"}], "/", "2"}], "]"}]}]}], "}"}], 
       ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "6", ",", " ", "0.05"}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "3"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "460"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<pointer separation \
|\[Alpha]\[UpArrow]-\[Alpha]\[DownArrow]|\>\"", ",", 
      " ", "\"\<assignment error 0.5 erfc(sep/2)\>\""}], "}"}]}], ",", "\n", 
   " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<readout time\>\"", ",", " ", "\"\<separation / error\>\""}],
      "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<longer readout separates the pointers and lowers the \
error\>\""}]}], "]"}]}], "Input",
 CellLabel->"In[93]:= ",
 CellID->1944276818,ExpressionUUID->"12187c95-2034-8b29-4238-75df51c6d673"],

Cell["\<\
The separation rises to its steady value while the assignment error falls \
toward a few percent: longer integration buys distinguishability. This is \
exactly the single-shot readout curve a circuit-QED experiment optimizes, the \
flip side of the coherence the same measurement destroys.\
\>", "Text",
 CellID->524220529,ExpressionUUID->"34b193bd-0a67-a7a6-5c4e-0ae7af130d8c"],

Cell["\<\
Measurement has a cost: as the pointer separates and reveals the qubit state, \
the qubit's coherence is destroyed. To see it we need the joint qubit-cavity \
density matrix and two helpers. First, embed a cavity operator on the joint \
space:\
\>", "Text",
 CellID->950216136,ExpressionUUID->"4fca8ec2-4b73-3b52-75c9-27ac6e0789b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"onAtom", "[", "metering_", "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "metering"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[94]:= ",
 CellID->338647958,ExpressionUUID->"656925a1-dac3-d209-1316-bc0adf77a153"],

Cell["\<\
Second, the partial trace over the cavity, recovering the qubit's reduced \
state:\
\>", "Text",
 CellID->961910044,ExpressionUUID->"09e13884-5cc5-f650-3f9e-b1ee5571dcba"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"traceMode", "[", 
    RowBox[{"joint_", ",", " ", "rungs_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"joint", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "rungs", ",", " ", "2", ",", " ", "rungs"}], 
          "}"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"r", "[", 
          RowBox[{"[", 
           RowBox[{"a", ",", " ", "k", ",", " ", "b", ",", " ", "k"}], "]"}], 
          "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "rungs"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[95]:= ",
 CellID->1465513701,ExpressionUUID->"29829495-262a-abaa-5fb1-0ddf53dcf9f0"],

Cell[TextData[{
 "Build a reader for the qubit coherence ",
 Cell[BoxData[GridBox[{
    {
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox[
       RowBox[{"e", "g"}], "TI"]]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "136212ad-a4c2-b9f3-4111-8bf6cd740bd9"],
 " as the pointer resolves the qubit:"
}], "Text",
 CellID->1779278278,ExpressionUUID->"67f6b273-a0bf-ee61-0d8d-343cd14bb54b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qubitCoherence", "[", "rungs_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"count", " ", "=", " ", 
        RowBox[{
         RowBox[{"creation", "[", "rungs", "]"}], " ", ".", " ", 
         RowBox[{"annihilation", "[", "rungs", "]"}]}]}], ",", " ", "H", ",", 
       " ", "run"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"H", " ", "=", " ", 
       RowBox[{
        RowBox[{"\[Epsilon]", " ", 
         RowBox[{"onAtom", "[", 
          RowBox[{
           RowBox[{"annihilation", "[", "rungs", "]"}], " ", "+", " ", 
           RowBox[{"creation", "[", "rungs", "]"}]}], "]"}]}], " ", "+", " ", 
        
        RowBox[{"\[Chi]", " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"Z", ",", " ", "count"}], "]"}]}]}]}], ";", "\n", "   ", 
      RowBox[{"run", " ", "=", " ", 
       RowBox[{"evolveODE", "[", 
        RowBox[{"H", ",", " ", 
         RowBox[{"{", 
          RowBox[{"onAtom", "[", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[Gamma]disp", "]"}], " ", 
            RowBox[{"annihilation", "[", "rungs", "]"}]}], "]"}], "}"}], ",", 
         "\n", "     ", 
         RowBox[{"densityMatrix", "[", 
          RowBox[{"Flatten", "@", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"plus", ",", " ", 
             RowBox[{"coherentState", "[", 
              RowBox[{"rungs", ",", " ", "0"}], "]"}]}], "]"}]}], "]"}], ",", 
         " ", "4."}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"Function", "[", 
       RowBox[{"t", ",", " ", 
        RowBox[{"2", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"traceMode", "[", 
            RowBox[{
             RowBox[{"run", "[", "t", "]"}], ",", " ", "rungs"}], "]"}], "[", 
           
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], "]"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[96]:= ",
 CellID->332869652,ExpressionUUID->"07a2a6c0-d7ac-3784-2d51-3fade25e9dee"],

Cell["\<\
Confirm the cutoff by comparing two truncations at the same time:\
\>", "Text",
 CellID->870462011,ExpressionUUID->"7d29df82-54ab-6c21-24d6-d6ec5d5e370b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"reading", " ", "=", " ", 
   RowBox[{"qubitCoherence", "[", "9", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"reading", "[", "2.", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"qubitCoherence", "[", "12", "]"}], "[", "2.", "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[97]:= ",
 CellID->770594293,ExpressionUUID->"2673b224-f5d9-a24c-4e00-2b81fc6df096"],

Cell["The two cutoffs agree, so 9 is enough.", "Text",
 CellID->416617480,ExpressionUUID->"27388ee6-22a7-f122-4ec7-27c05753c008"],

Cell["\<\
Now visualize the qubit coherence draining as the pointer states separate:\
\>", "Text",
 CellID->468951994,ExpressionUUID->"51cd4bfd-d3fa-9dcf-07f3-62a6e58ce715"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"reading", "[", "t", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<qubit coherence\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the pointer measures away the qubit coherence\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[98]:= ",
 CellID->1802328397,ExpressionUUID->"06a776cb-b9d0-3c58-2e5d-6f95386a86a2"],

Cell["\<\
The coherence falls to near zero as the pointer states separate: a \
measurement that distinguishes the qubit states must destroy their \
superposition.\
\>", "Text",
 CellID->328865975,ExpressionUUID->"7641b941-63e8-8619-1e7e-312b1582ed63"],

Cell[TextData[{
 "The cavity field, the meter itself, tells the same story in its Wigner \
picture, and what it shows depends on how you read the qubit. Trace the qubit \
out and the field is a fringeless mixture of the two pointer states as soon \
as they separate, since the which-way record now lives in the qubit. But keep \
only the records where the qubit is found in ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42b8cf72-fa81-ffe6-7247-e73fff35c5cc"],
 " (the basis where its coherence lives), and the conditional field is a cat \
of the two pointers, its fringes carrying exactly the qubit's surviving \
coherence. A helper for the field conditioned on finding the qubit in a given \
state ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["q", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c8db7a0-3aa3-299f-44b2-2e0abf567be5"],
 ", the qubit sandwiched off and the result renormalized,"
}], "Text",
 CellID->1270006433,ExpressionUUID->"473593be-64fb-e664-6eca-0af80c8fcd4e"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     RowBox[{
      StyleBox["field",
       FontSlant->"Plain"], " ", 
      StyleBox["|",
       SpanMaxSize->1], " ", 
      StyleBox["q", "TI"]}]], "=", 
    FractionBox[
     RowBox[{
      TemplateBox[{
        StyleBox["q", "TI"]},
       "Bra"], 
      StyleBox["\[Rho]", "TI"], 
      TemplateBox[{
        StyleBox["q", "TI"]},
       "Ket"]}], 
     RowBox[{
      StyleBox["Tr",
       FontSlant->"Plain"], 
      TemplateBox[{
        StyleBox["q", "TI"]},
       "Bra"], 
      StyleBox["\[Rho]", "TI"], 
      TemplateBox[{
        StyleBox["q", "TI"]},
       "Ket"]}]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->34003199,ExpressionUUID->"79a8e286-b760-8808-2f57-fbe3c21adb52"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["q", "TI"]},
    "Bra"], 
   StyleBox["\[Rho]", "TI"], 
   TemplateBox[{
     StyleBox["q", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "766f3dde-6e6e-8ae3-1e14-b4980b18d8c9"],
 " leaves a field operator and its trace is the probability ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["q", "TI"]},
    "Bra"], 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["qubit",
     FontSlant->"Plain"]], 
   TemplateBox[{
     StyleBox["q", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7acff19c-f8f8-c05b-2af4-e8d9f97292a1"],
 " of that outcome:"
}], "Text",
 CellID->1596250240,ExpressionUUID->"36bb0aa4-099e-3511-5e58-a30ea8289c7b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fieldGiven", "[", 
    RowBox[{"joint_", ",", " ", "rungs_", ",", " ", "q_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"joint", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "rungs", ",", " ", "2", ",", " ", "rungs"}], 
          "}"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", " ", "=", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Conjugate", "[", 
             RowBox[{"q", "[", 
              RowBox[{"[", "a", "]"}], "]"}], "]"}], " ", 
            RowBox[{"q", "[", 
             RowBox[{"[", "b", "]"}], "]"}], " ", 
            RowBox[{"r", "[", 
             RowBox[{"[", 
              RowBox[{"a", ",", " ", "All", ",", " ", "b", ",", " ", "All"}], 
              "]"}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"b", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"m", "/", 
        RowBox[{"Tr", "[", "m", "]"}]}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[99]:= ",
 CellID->1572158672,ExpressionUUID->"6fab4322-7f5b-c123-15a9-5a8c7aef9009"],

Cell["\<\
Run the joint master equation once, at a cutoff wide enough for the pointer \
blobs:\
\>", "Text",
 CellID->1137775047,ExpressionUUID->"559c0528-76f1-864e-03a3-9d720285ec94"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dispRungs", " ", "=", " ", "12"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dispRun", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Epsilon]", " ", 
       RowBox[{"onAtom", "[", 
        RowBox[{
         RowBox[{"annihilation", "[", "dispRungs", "]"}], " ", "+", " ", 
         RowBox[{"creation", "[", "dispRungs", "]"}]}], "]"}]}], " ", "+", 
      " ", 
      RowBox[{"\[Chi]", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"Z", ",", " ", 
         RowBox[{
          RowBox[{"creation", "[", "dispRungs", "]"}], " ", ".", " ", 
          RowBox[{"annihilation", "[", "dispRungs", "]"}]}]}], "]"}]}]}], ",",
      "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"onAtom", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Gamma]disp", "]"}], " ", 
        RowBox[{"annihilation", "[", "dispRungs", "]"}]}], "]"}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"densityMatrix", "[", 
      RowBox[{"Flatten", "@", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"plus", ",", " ", 
         RowBox[{"coherentState", "[", 
          RowBox[{"dispRungs", ",", " ", "0"}], "]"}]}], "]"}]}], "]"}], ",", 
     " ", "3."}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[100]:= ",
 CellID->573363004,ExpressionUUID->"4c3b3e9a-7f95-6e09-75d8-b7c47a203553"],

Cell[TextData[{
 "Build the Wigner film of the ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b834648-1855-f17e-29b1-581299e1c044"],
 "-conditioned field as the measurement proceeds:"
}], "Text",
 CellID->1565937439,ExpressionUUID->"6aa15cf4-f328-f435-1a5f-55b186c2df1f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dispTimes", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.", ",", " ", "1.", ",", " ", "2.", ",", " ", "3."}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dispFilm", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"wignerRepresentation", "[", 
      RowBox[{
       RowBox[{"fieldGiven", "[", 
        RowBox[{
         RowBox[{"dispRun", "[", "t", "]"}], ",", " ", "dispRungs", ",", " ", 
         "plus"}], "]"}], ",", " ", "3.8", ",", " ", "45"}], "]"}], ",", " ", 
     
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "dispTimes"}], "}"}]}], "]"}]}], ";"}]}], "Input",\

 CellLabel->"In[101]:= ",
 CellID->1825661031,ExpressionUUID->"1fa3178e-7287-38be-4550-8ee807338a84"],

Cell["Draw it on one shared color scale:", "Text",
 CellID->1952919625,ExpressionUUID->"33c53063-afff-c489-61fa-aa4cc98baed3"],

Cell[BoxData[
 RowBox[{"wignerPlot", "[", 
  RowBox[{"dispFilm", ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\"\<time \>\"", " ", "<>", " ", 
      RowBox[{"ToString", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
    "dispTimes"}]}], "]"}]], "Input",
 CellLabel->"In[102]:= ",
 CellID->162062935,ExpressionUUID->"08d8bcb3-70a4-55b3-38e7-35fd01513f99"],

Cell[TextData[{
 "The field starts as the vacuum, one blob at the origin, and drifts as the \
drive builds the pointer amplitude. As the two pointer components begin to \
separate, the conditional field passes through a faint cat: an elongated blob \
with a patch of genuine negativity beneath it, the fringe that the qubit's \
surviving coherence can still paint. It never becomes a bright cat, and that \
is the physics: the meter resolves its two readings exactly by carrying the \
which-way information away, so by the time the pointers are distinct (last \
panel) the coherence that would fringe them is spent, and the field is a \
classical mixture of two readings. Contrast the Haroche cat of the earlier \
section: there the dispersive atom imprinted the two phases ",
 StyleBox["before", "TI"],
 " the cavity leaked, so the separation came first and the decoherence after; \
here they are one and the same process. This is dispersive qubit readout in \
circuit QED, where the pointer is a microwave tone reflected off a \
resonator."
}], "Text",
 CellID->1483832353,ExpressionUUID->"20e38226-5aed-155d-5090-1b805e987fa7"],

Cell["\<\
Part Three: A Heavy Particle, and the Two Faces of a Warm Bath\
\>", "Section",
 CellID->421271511,ExpressionUUID->"160727ef-d1b8-0069-3e3c-bec8e04d52b3"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A particle of mass ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "261df1b1-b81e-57af-4e22-e8fb39ab3df5"],
 " in a gentle trap ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["M", "TI"], 
   SuperscriptBox["\[CapitalOmega]", "2"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00ba9d2f-c328-50fc-3059-1488f6dd22c6"],
 ", coupled to a warm bath (the Caldeira-Leggett model). In the \
high-temperature limit,"
}], "Text",
 CellID->971430162,ExpressionUUID->"02964792-f196-8b6e-32ae-5edf8020d9b4"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      OverscriptBox[
       StyleBox["\[Rho]", "TI"], "."], "=", "-", 
      StyleBox["i", "TI"], 
      StyleBox["[",
       FontSize->1.8 Inherited], 
      FractionBox[
       SuperscriptBox[
        OverscriptBox[
         StyleBox["p", "TI"], "^"], "2"], 
       RowBox[{"2", 
        StyleBox["M", "TI"]}]], "+", 
      FractionBox["1", "2"], 
      StyleBox["M", "TI"], 
      SuperscriptBox["\[CapitalOmega]", "2"], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["x", "TI"], "^"], "2"]}], ",", " ", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     FontSize->1.8 Inherited]}], "-", 
   RowBox[{
    StyleBox["i", "TI"], 
    RowBox[{
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["[",
      FontSize->1.2 Inherited], 
     RowBox[{
      OverscriptBox[
       StyleBox["x", "TI"], "^"], ",", 
      RowBox[{"{", 
       OverscriptBox[
        StyleBox["p", "TI"], "^"]}], ",", 
      RowBox[{
       StyleBox["\[Rho]", "TI"], "}", 
       StyleBox["]",
        FontSize->1.2 Inherited], "-", "2", 
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["M", "TI"], 
       SubscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["B", "TI"]], 
       StyleBox["T", "TI"], " ", 
       StyleBox["[",
        FontSize->1.2 Inherited], 
       OverscriptBox[
        StyleBox["x", "TI"], "^"]}], ",", 
      RowBox[{
       RowBox[{
        StyleBox["[",
         SpanMaxSize->1], 
        RowBox[{
         OverscriptBox[
          StyleBox["x", "TI"], "^"], ",", 
         StyleBox["\[Rho]", "TI"]}], 
        StyleBox["]",
         SpanMaxSize->1], 
        StyleBox["]",
         FontSize->1.2 Inherited]}], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->411794565,ExpressionUUID->"166d4e5f-4333-9385-3e13-601976c7e1ef"],

Cell[TextData[{
 "Friction damps the momentum at rate ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c99ee20-d785-d362-44a6-078de231be48"],
 "; the double commutator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["x", "TI"], "^"], ",", 
      StyleBox["\[Rho]", "TI"]}], 
     StyleBox["]",
      SpanMaxSize->1]}]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60858f89-56d8-6615-10ba-26d3636d4d7f"],
 " decoheres a superposition of two positions a distance ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e45545e-c429-efe4-567b-4e1bedddb5ce"],
 " apart at a rate ",
 Cell[BoxData[
  RowBox[{"\[Proportional]", 
   StyleBox["M", "TI"], 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"], " ", "\[CapitalDelta]", 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24564246-a2b2-7a9b-4c6e-6423d74748e1"],
 ", quadratic in the separation, the same law as the light-cat. For a smooth \
(Gaussian) blob the first and second moments of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "273d1382-afb1-09c0-4ec2-8aefca445b2a"],
 " close into a small set of rate equations, exactly the five below."
}], "Text",
 CellID->211393631,ExpressionUUID->"39c9e52f-ed06-87fb-6ff6-fc8884b0edc1"],

Cell[TextData[{
 "A heavy particle in a harmonic trap ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["M", "TI"], 
   SuperscriptBox["\[CapitalOmega]", "2"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46be6341-4be3-06d9-6e46-7b2b6d966c23"],
 ", coupled to a warm bath (Caldeira-Leggett). Friction damps the momentum; \
the bath's fluctuations grow the position variance to thermal equilibrium. \
For a Gaussian state the first and second moments of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "352b8971-1d3f-d4c9-6328-213b94cbbe13"],
 " close into five equations: the mean ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["x", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["p", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "227c7e4b-1c68-aac8-5204-70159502f812"],
 " and the covariance matrix ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cd9b5a9-dbed-51da-14e6-2cf2dd982320"],
 " with entries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     StyleBox[
      RowBox[{"x", "x"}], "TI"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox[
      RowBox[{"x", "p"}], "TI"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox[
      RowBox[{"p", "p"}], "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4becebe3-5bfe-fac0-7993-02cd5d88c82a"],
 ". The high-temperature master equation above holds only when ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"], "\[GreaterGreater]", "\[HBar]", "\[CapitalOmega]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "312d182f-c6c7-5e1e-60d2-9188f3722564"],
 ", so fix the mass, trap frequency, friction, and a temperature well above \
the level spacing ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "\[CapitalOmega]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1449d45f-8382-90b9-3c76-ce193634e283"],
 ":"
}], "Text",
 CellID->485898233,ExpressionUUID->"444f09dd-766a-dba7-6c74-a087031ca98d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"M", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"\[CapitalOmega]qbm", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"\[Gamma]qbm", " ", "=", " ", "0.15"}], ";", " ", 
  RowBox[{"kT", " ", "=", " ", "5."}], ";", " ", 
  RowBox[{"Ddiff", " ", "=", " ", 
   RowBox[{"4", " ", "\[Gamma]qbm", " ", "M", " ", "kT"}]}], ";"}]], "Input",
 CellLabel->"In[103]:= ",
 CellID->300459616,ExpressionUUID->"79e9b65a-67eb-1624-2f96-2804119e7d0e"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"], "=", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "394df0e2-3b3f-7a44-6f72-e9ccbeca48ae"],
 " against a level spacing of ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d3de1d4-e864-19c9-04c2-f89189116b13"],
 ", the bath is genuinely warm. Written out, those five equations are"
}], "Text",
 CellID->1400905077,ExpressionUUID->"1adc8861-0296-99d3-4ae3-224bb720eb39"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["x", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], "."], "=", 
    FractionBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["p", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox["M", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    OverscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["p", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], "."], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       StyleBox["M", "TI"]}], 
      SuperscriptBox["\[CapitalOmega]", "2"], 
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["x", "TI"], "^"], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]}], "-", 
     RowBox[{"2", 
      StyleBox["\[Gamma]", "TI"], 
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["p", "TI"], "^"], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->900992407,ExpressionUUID->"47f3727e-1788-b883-6d81-7438a2220ae9"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalSigma]", "."], 
     StyleBox[
      RowBox[{"x", "x"}], "TI"]], "=", 
    FractionBox[
     RowBox[{"2", 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox[
        RowBox[{"x", "p"}], "TI"]]}], 
     StyleBox["M", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalSigma]", "."], 
     StyleBox[
      RowBox[{"x", "p"}], "TI"]], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["\[CapitalSigma]", 
       StyleBox[
        RowBox[{"p", "p"}], "TI"]], 
      StyleBox["M", "TI"]], "-", 
     RowBox[{
      StyleBox["M", "TI"], 
      SuperscriptBox["\[CapitalOmega]", "2"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox[
        RowBox[{"x", "x"}], "TI"]]}], "-", 
     RowBox[{"2", 
      StyleBox["\[Gamma]", "TI"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox[
        RowBox[{"x", "p"}], "TI"]]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalSigma]", "."], 
     StyleBox[
      RowBox[{"p", "p"}], "TI"]], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], 
      StyleBox["M", "TI"], 
      SuperscriptBox["\[CapitalOmega]", "2"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox[
        RowBox[{"x", "p"}], "TI"]]}], "-", 
     RowBox[{"4", 
      StyleBox["\[Gamma]", "TI"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox[
        RowBox[{"p", "p"}], "TI"]]}], "+", 
     StyleBox["D", "TI"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1909490419,ExpressionUUID->"02bfa0ec-e0fe-2fa7-3244-39c9908b758d"],

Cell[TextData[{
 "with diffusion coefficient ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], "=", "4", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["M", "TI"], 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cc1833e-1ead-5711-24fe-1b789b583a7b"],
 ". The initial covariance must itself be a valid quantum state, so start \
from the trap's ground state, the minimum-uncertainty blob with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"x", "x"}], "TI"]], "=", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"p", "p"}], "TI"]], "=", "\[HBar]", "/", "2", "=", "1", "/", 
   "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cb4236e-91b2-9328-644b-bb482044fe72"],
 " (so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalSigma]", "=", 
   SuperscriptBox["\[HBar]", "2"], "/", "4", "=", "1", "/", "4"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "631da35c-735e-7e3b-1122-3b0606eb4501"],
 "), displaced off the origin. Integrate them from there:"
}], "Text",
 CellID->809304935,ExpressionUUID->"44b7daea-ed84-b50e-6c4c-d3b784361c54"],

Cell[BoxData[
 RowBox[{
  RowBox[{"particle", " ", "=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"cx", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"cp", "[", "t", "]"}], "/", "M"}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"cp", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "M"}], " ", 
          RowBox[{"\[CapitalOmega]qbm", "^", "2"}], " ", 
          RowBox[{"cx", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"2", " ", "\[Gamma]qbm", " ", 
          RowBox[{"cp", "[", "t", "]"}]}]}]}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"vx", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{"2", " ", 
         RowBox[{
          RowBox[{"vc", "[", "t", "]"}], "/", "M"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"vc", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"vp", "[", "t", "]"}], "/", "M"}], " ", "-", " ", 
         RowBox[{"M", " ", 
          RowBox[{"\[CapitalOmega]qbm", "^", "2"}], " ", 
          RowBox[{"vx", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"2", " ", "\[Gamma]qbm", " ", 
          RowBox[{"vc", "[", "t", "]"}]}]}]}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"vp", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "M", " ", 
          RowBox[{"\[CapitalOmega]qbm", "^", "2"}], " ", 
          RowBox[{"vc", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"4", " ", "\[Gamma]qbm", " ", 
          RowBox[{"vp", "[", "t", "]"}]}], " ", "+", " ", "Ddiff"}]}], ",", 
       "\n", "   ", 
       RowBox[{
        RowBox[{"cx", "[", "0", "]"}], " ", "==", " ", "2."}], ",", " ", 
       RowBox[{
        RowBox[{"cp", "[", "0", "]"}], " ", "==", " ", "0."}], ",", " ", 
       RowBox[{
        RowBox[{"vx", "[", "0", "]"}], " ", "==", " ", "0.5"}], ",", " ", 
       RowBox[{
        RowBox[{"vc", "[", "0", "]"}], " ", "==", " ", "0."}], ",", " ", 
       RowBox[{
        RowBox[{"vp", "[", "0", "]"}], " ", "==", " ", "0.5"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
      "cx", ",", " ", "cp", ",", " ", "vx", ",", " ", "vc", ",", " ", "vp"}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "30"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[104]:= ",
 CellID->1060035609,ExpressionUUID->"39f2334d-24de-3dcb-6f81-ab174d688711"],

Cell["Two readers, the mean and the covariance matrix:", "Text",
 CellID->960351252,ExpressionUUID->"1ec600b7-0050-8550-46fd-99f1b1eaefba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"center", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"particle", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"particle", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "[", "t", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"spread", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"particle", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"particle", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "[", "t", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"particle", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"particle", "[", 
         RowBox[{"[", "5", "]"}], "]"}], "[", "t", "]"}]}], "}"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[105]:= ",
 CellID->1269096941,ExpressionUUID->"33bfe66e-cd59-d601-6144-f84be4edbd6b"],

Cell["\<\
Two checks. First, the mean spirals in from its displaced start to rest:\
\>", "Text",
 CellID->2008479665,ExpressionUUID->"6a3ee8c1-8740-e1ad-1bc5-01ab32fab3f7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"center", "[", "0", "]"}], ",", " ", 
   RowBox[{"center", "[", "25", "]"}]}], "}"}]], "Input",
 CellLabel->"In[106]:= ",
 CellID->29625565,ExpressionUUID->"33885b0f-111a-0c54-6188-5369a0af56be"],

Cell[TextData[{
 "It starts displaced and ends near the origin. Second, the position variance \
",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox[
    RowBox[{"x", "x"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c9080a8-67dd-9047-04af-19f21269e2ad"],
 " grows from its ground-state value ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "/", "2", "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2abc9d06-0494-496b-5a43-1560ad211bb1"],
 " to the thermal value ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["M", "TI"], 
    SuperscriptBox["\[CapitalOmega]", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43e301a0-76bb-1057-7190-980a034e62bd"],
 ", equipartition for a harmonic trap:"
}], "Text",
 CellID->9883570,ExpressionUUID->"1ae06f2b-7109-3ba5-4a9f-877500bd898f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"particle", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "[", "0", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"particle", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "[", "25", "]"}], ",", " ", 
   RowBox[{"kT", "/", 
    RowBox[{"(", 
     RowBox[{"M", " ", 
      RowBox[{"\[CapitalOmega]qbm", "^", "2"}]}], ")"}]}]}], "}"}]], "Input",
 CellLabel->"In[107]:= ",
 CellID->940978275,ExpressionUUID->"0856a555-3f58-6085-386d-3d1fbaed32ef"],

Cell["\<\
It lands on the thermal value, ten times the ground-state spread. Check it a \
second way: the steady covariance solves the Lyapunov equation, where \
diffusion balances friction:\
\>", "Text",
 CellID->173258875,ExpressionUUID->"71eecbe3-9be0-9ba6-2795-e2cd1d9ae98c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"drift", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"1", "/", "M"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "M"}], " ", 
        RowBox[{"\[CapitalOmega]qbm", "^", "2"}]}], ",", " ", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[Gamma]qbm"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"LyapunovSolve", "[", 
  RowBox[{"drift", ",", " ", 
   RowBox[{"-", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "Ddiff"}], "}"}]}], "}"}]}]}], "]"}]}], "Input",\

 CellLabel->"In[108]:= ",
 CellID->792860948,ExpressionUUID->"59070895-187c-42ea-0f3c-a1df99091030"],

Cell["The Lyapunov steady state matches the integrated one.", "Text",
 CellID->124530881,ExpressionUUID->"189fe470-6cd8-7cf4-48a4-fe3a056d46de"],

Cell[TextData[{
 "The same covariance bookkeeping returns under monitoring in Part Five. The \
Kalman filter's watched oscillator obeys ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox["\[CapitalSigma]", "."], "=", 
   StyleBox["A", "TI"], "\[CapitalSigma]", "+", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["T", "TI"]], "+", 
   StyleBox["D", "TI"], "-", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["T", "TI"]], 
   StyleBox["C", "TI"], "\[CapitalSigma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04ed2843-d86c-272a-2c92-c22cd91e8a70"],
 ", the Lyapunov form above plus one term the bath cannot supply, the \
measurement's information gain ",
 Cell[BoxData[
  RowBox[{"-", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["T", "TI"]], 
   StyleBox["C", "TI"], "\[CapitalSigma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d9e217-b7c7-416b-20e6-0450c27213b1"],
 ": diffusion widens the blob to thermal here, watching narrows it below the \
ground-state spread there."
}], "Text",
 CellID->1312473818,ExpressionUUID->"29221b72-bc55-8ef4-58d1-933c35e1d4de"],

Cell[TextData[{
 "One more check the model must pass to be believed: a real quantum state \
obeys the Robertson-Schrodinger uncertainty relation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalSigma]", "=", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"x", "x"}], "TI"]], 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"p", "p"}], "TI"]], "-", 
   SubsuperscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"x", "p"}], "TI"], "2"], "\[GreaterEqual]", 
   SuperscriptBox["\[HBar]", "2"], "/", "4", "=", "1", "/", "4"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41172bde-c012-830e-772c-c29bf1a4ee54"],
 ", so the margin ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalSigma]", "-", "1", "/", 
   "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dd84232-0c35-660d-6bf8-647ca5c04d57"],
 " must stay non-negative for the whole run. The high-temperature \
Caldeira-Leggett generator is not of Lindblad form, so this is not automatic; \
watch it directly:"
}], "Text",
 CellID->1627779716,ExpressionUUID->"5558c8fc-3d33-9e90-0367-e1a6b4c7e4fa"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Det", "@", 
     RowBox[{"spread", "[", "t", "]"}]}], " ", "-", " ", 
    RowBox[{"1", "/", "4"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "25"}], "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<uncertainty margin  det \[CapitalSigma] - 1/4\>\""}], "}"}]}],
    ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the state stays above the uncertainty floor\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[109]:= ",
 CellID->294107029,ExpressionUUID->"53291d47-a111-bd44-02d6-9520d0a507ae"],

Cell[TextData[{
 "The margin starts at zero, where the ground state saturates the bound, and \
only grows: the blob swells above the Heisenberg floor and never dips below \
it. Had we started from the old sub-ground blob ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"x", "x"}], "TI"]], "=", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"p", "p"}], "TI"]], "=", "0.1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14460f59-6b0f-818e-3c7d-a7030ebbd3d4"],
 ", the margin would have opened at ",
 Cell[BoxData[
  RowBox[{"0.01", "-", "0.25", "<", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6afe19ed-5a5e-331e-1a85-90b75fe89e64"],
 ", an invalid state the evolution could never repair; and pushed to low \
temperature, this same generator can drive an initially valid state below the \
floor, the known price of its non-Lindblad form."
}], "Text",
 CellID->736271930,ExpressionUUID->"142f588d-e120-bc70-3dd5-51d690da075a"],

Cell[TextData[{
 "Those checks read the mean and the variance as numbers; the phase-space \
picture puts them in one object. That object is the state's ",
 StyleBox["Wigner function",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "029948d8-232c-2201-32a7-618256d9716b"],
 ", the quasiprobability the cat used in Part Two, except that for a Gaussian \
state no Fock-basis sum is needed: ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b1b5b6f-b43d-594b-7939-53493dc82b91"],
 " is exactly the bivariate normal set by the five moments, centered at the \
mean ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["r", "TI"], "_"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["x", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["p", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32f703b9-71e1-95eb-628c-9ae30795ff31"],
 " and shaped by the covariance ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c860bbc-8d1f-f590-34bd-a2e624abdffa"],
 ","
}], "Text",
 CellID->406066173,ExpressionUUID->"1bab88a0-6539-d521-49a8-210a0ccdbc0b"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["W", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox["1", 
     RowBox[{"2", "\[Pi]", 
      SqrtBox[
       RowBox[{
        StyleBox["det",
         FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalSigma]"}]]}]], " ", 
    StyleBox["exp",
     FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", "[", 
    RowBox[{"-", 
     FractionBox["1", "2"], " ", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["r", "TI"], "-", 
        OverscriptBox[
         StyleBox["r", "TI"], "_"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      StyleBox["T", "TI"]], " ", 
     SuperscriptBox["\[CapitalSigma]", 
      RowBox[{"-", "1"}]], " ", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["r", "TI"], "-", 
      OverscriptBox[
       StyleBox["r", "TI"], "_"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "]"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["r", "TI"], "=", 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], ","}],
  Alignment->Center,
