     RowBox[{"\"\<time\>\"", ",", " ", "\"\<phonon number\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<feedback cools; watching alone heats\>\""}], ",", "\n", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
