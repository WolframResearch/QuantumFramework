   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "114fd905-c79d-9420-4774-d16ef229ff0a"],
 " in orange) drifting apart across the IQ plane:"
}], "Text",
 CellID->1158471628,ExpressionUUID->"0047a90f-9cb0-808d-307c-4169154ad2d7"],

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"iqCloud", "[", 
          RowBox[{"\[Alpha]e", ",", " ", "t", ",", " ", "1"}], "]"}], ",", 
