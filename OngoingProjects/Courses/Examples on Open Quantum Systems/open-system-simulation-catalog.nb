          RowBox[{
           RowBox[{
            RowBox[{"blochVector", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
