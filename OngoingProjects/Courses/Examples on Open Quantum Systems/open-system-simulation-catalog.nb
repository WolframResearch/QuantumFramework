          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"Opacity", "[", "0.5", "]"}], ",", " ", 
            RowBox[{"PointSize", "[", "0.015", "]"}]}], "]"}]}], "}"}]}], ",",
        "\n", "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "6"}], ",", " ", "6"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "260"}], ",", "\n", "    ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<I\>\"", ",", " ", "\"\<Q\>\""}], "}"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"\"\<t = \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "t", "]"}]}]}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "iqTimes"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "800"}]}], "]"}]], "Input",
 CellLabel->"In[116]:= ",
 CellID->570648126,ExpressionUUID->"4a2652ed-88d4-efb2-7bde-4bb72966b598"],

Cell[TextData[{
 "Early the clouds overlap and the qubit state is ambiguous; by the last \
frame they are cleanly resolved. Turn that into numbers: discriminating the \
two pointer states from a single snapshot of the cavity, at one instant, has \
error ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["erfc",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{GridBox[{
      {
       RowBox[{
        SubscriptBox[
         StyleBox["\[Alpha]", "TI"], 
         StyleBox["e", "TI"]], "-", 
        SubscriptBox[
         StyleBox["\[Alpha]", "TI"], 
         StyleBox["g", "TI"]]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0962d9db-7466-8598-3f11-d0857d10efe2"],
 ", the overlap of the two Gaussians: the nearest-centroid error of the two \
heterodyne clouds, not the ultimate quantum limit over all measurements. \
Define the pointer separation, the distance between the two coherent \
amplitudes:"
}], "Text",
 CellID->1943045306,ExpressionUUID->"5b3d557b-19e1-b503-0ac3-4d259f951c69"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sepDisp", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"\[Alpha]e", "[", "t", "]"}], " ", "-", " ", 
     RowBox[{"\[Alpha]g", "[", "t", "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[117]:= ",
 CellID->1695469705,ExpressionUUID->"529c5c95-0588-d8f1-02a4-55dfac22aadb"],

Cell["\<\
The wider that separation, the smaller the overlap error the discrimination \
leaves. Plot both against readout time:\
\>", "Text",
 CellID->808446663,ExpressionUUID->"18bedc4a-f6ca-97e0-4845-d617837cfdca"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Transpose", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", ",", " ", 
          RowBox[{"sepDisp", "[", "t", "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", 
          RowBox[{"0.5", " ", 
           RowBox[{"Erfc", "[", 
            RowBox[{
             RowBox[{"sepDisp", "[", "t", "]"}], "/", "2"}], "]"}]}]}], 
         "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "0", ",", " ", "6", ",", " ", "0.05"}], "}"}]}],
      "]"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<pointer separation |\!\(\*SubscriptBox[\(\[Alpha]\), \
\(e\)]\) - \!\(\*SubscriptBox[\(\[Alpha]\), \(g\)]\)|\>\"", ",", 
        " ", "\"\<assignment error \!\(\*FractionBox[\(1\), \(2\)]\) erfc(|\!\
\(\*SubscriptBox[\(\[Alpha]\), \(e\)]\) - \!\(\*SubscriptBox[\(\[Alpha]\), \
\(g\)]\)|/2)\>\""}], "}"}], ",", " ", "Right"}], "]"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<readout time\>\"", ",", " ", "\"\<separation / error\>\""}],
      "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<instantaneous discrimination: \nseparation and error saturate \
once the cavity settles\>\""}]}], "]"}]], "Input",
 CellLabel->"In[118]:= ",
 CellID->843355028,ExpressionUUID->"5f18273e-5cf5-00f5-0527-bf78548052df"],

Cell[TextData[{
 "The separation rises to its steady value and the instantaneous error falls \
with it, then both flatten: once the cavity has settled, a snapshot of it \
says the same thing at every later instant. But that snapshot is not what a \
real readout uses. The cavity leaks the whole time, and a heterodyne receiver \
integrates that output record, so its information keeps accumulating even \
after the cavity is stationary: the integrated signal-to-noise grows as ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["SNR",
     FontSlant->"Plain"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[Proportional]", 
   StyleBox["\[Gamma]", "TI"], 
   SubsuperscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"]], 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        SubscriptBox[
         StyleBox["\[Alpha]", "TI"], 
         StyleBox["e", "TI"]], 
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["s", "TI"], 
        StyleBox[")",
         SpanMaxSize->1], "-", 
        SubscriptBox[
         StyleBox["\[Alpha]", "TI"], 
         StyleBox["g", "TI"]], 
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["s", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1890d11b-851d-d227-48af-c9452ca9a10d"],
 ". Code that running integral of the squared pointer separation:"
}], "Text",
 CellID->2123001010,ExpressionUUID->"5b8be800-baff-aedd-0988-026a3e8bf427"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"snrAccum", "[", 
    RowBox[{"t_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"\[Gamma]disp", " ", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"\[Alpha]e", "[", "s", "]"}], " ", "-", " ", 
         RowBox[{"\[Alpha]g", "[", "s", "]"}]}], "]"}], "^", "2"}], ",", " ", 
      
      RowBox[{"{", 
       RowBox[{"s", ",", " ", "0", ",", " ", "t"}], "}"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[119]:= ",
 CellID->1415208481,ExpressionUUID->"224fae0e-4768-b263-5274-406872020149"],

Cell["\<\
Plot the saturating snapshot separation-squared against this accumulating \
integral:\
\>", "Text",
 CellID->80082845,ExpressionUUID->"3d32ba1d-71ed-60b8-64c1-3c4707983282"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", " ", 
         RowBox[{
          RowBox[{"sepDisp", "[", "t", "]"}], "^", "2"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "6", ",", " ", "0.05"}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", " ", 
         RowBox[{"snrAccum", "[", "t", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "6", ",", " ", "0.1"}], "}"}]}],
       "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<pointer separation squared |alpha_e - alpha_g|^2 \
(saturates)\>\"", ",", " ", "\"\<integrated SNR^2 (grows)\>\""}], "}"}], ",", 
      " ", "Right"}], "]"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<readout time\>\"", ",", " ", "\"\<distinguishability\>\""}],
      "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the pointer separation saturates;\n the integrated output \
record keeps accumulating\>\""}]}], "]"}]], "Input",
 CellLabel->"In[120]:= ",
 CellID->730828669,ExpressionUUID->"3ccd4f42-4869-4b08-64f3-672c691c1652"],

Cell[TextData[{
 "The snapshot separation-squared levels off as the pointers reach their \
steady amplitudes, but the integrated ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["SNR",
    FontSlant->"Plain"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cf63df4-f608-7ba6-348d-b4b183bd498c"],
 " climbs without bound, linearly once the cavity is stationary. That growing \
line, not the saturating one, is the single-shot readout a circuit-QED \
experiment optimizes, and it is the flip side of the qubit coherence the same \
measurement destroys. See ",
 ButtonBox["Gambetta et al.",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/cond-mat/0602322"], None}],
 "."
}], "Text",
 CellID->20229285,ExpressionUUID->"60948258-d69f-7f2c-10ab-2405e32a4276"],

Cell[TextData[{
 "Measurement has a cost: as the pointer separates and reveals the qubit \
state, the qubit's coherence is destroyed. To see it we need the joint \
qubit-cavity density matrix and two functions. First, embed a cavity operator \
on the joint space as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\|01d7d9", 
    StyleBox["qubit",
     FontSlant->"Plain"]], "\[CircleTimes]", 
   StyleBox["M", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf5c13c-8c81-f0bf-098a-d9662535c285"],
 ", identity on the qubit:"
}], "Text",
 CellID->865532999,ExpressionUUID->"27ebc314-3813-af61-4de8-db5eb9a7f24b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"onCavity", "[", "metering_", "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "metering"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[121]:= ",
 CellID->1719354248,ExpressionUUID->"59cd495b-92f8-de82-0ff3-61052772a4e8"],

Cell[TextData[{
 "Second, the partial trace over the cavity, recovering the qubit's reduced \
state ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["qubit",
     FontSlant->"Plain"]], "=", 
   SubscriptBox[
    StyleBox["Tr",
     FontSlant->"Plain"], 
    StyleBox["cavity",
     FontSlant->"Plain"]], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1597811c-d04f-58d0-43ac-1959e1fa2a3a"],
 ":"
}], "Text",
 CellID->803807756,ExpressionUUID->"0d69ae9d-d0a3-a5e3-3b16-47c6e1570fc9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"reducedQubit", "[", 
    RowBox[{"joint_", ",", " ", "rungs_"}], "]"}], " ", ":=", " ", 
   RowBox[{"TensorContract", "[", 
    RowBox[{
     RowBox[{"ArrayReshape", "[", 
      RowBox[{"joint", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "rungs", ",", " ", "2", ",", " ", "rungs"}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4"}], "}"}], "}"}]}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[122]:= ",
 CellID->601042471,ExpressionUUID->"1e10fbdd-fcac-b923-462f-f286f55e0809"],

Cell[TextData[{
 "Build a function for the qubit coherence as the pointer resolves the qubit: \
it returns ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"2", GridBox[{
      {
       RowBox[{
        SubscriptBox[
         StyleBox["\[Rho]", "TI"], 
         StyleBox["eg",
          FontSlant->"Plain"]], 
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["t", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}]}], "=", 
   RowBox[{"2", GridBox[{
      {
       RowBox[{
        TemplateBox[{
          StyleBox["e", "TI"]},
         "Bra"], 
        SubscriptBox[
         StyleBox["\[Rho]", "TI"], 
         StyleBox["qubit",
          FontSlant->"Plain"]], 
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         StyleBox["t", "TI"], 
         StyleBox[")",
          SpanMaxSize->1]}], 
        TemplateBox[{
          StyleBox["g", "TI"]},
         "Ket"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c26b95-e958-d351-18f1-82de88d2a1bb"],
 ", the length of the transverse Bloch vector:"
}], "Text",
 CellID->2038927162,ExpressionUUID->"56b7d10b-4c3b-5ee0-7e4c-c95565ce24ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qubitCoherence", "[", "rungs_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"count", " ", "=", " ", 
        RowBox[{
         RowBox[{"creation", "[", "rungs", "]"}], " ", ".", " ", 
         RowBox[{"annihilation", "[", "rungs", "]"}]}]}], ",", " ", "H", ",", 
       " ", "run"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"H", " ", "=", " ", 
       RowBox[{
        RowBox[{"\[Epsilon]", " ", 
         RowBox[{"onCavity", "[", 
          RowBox[{
           RowBox[{"annihilation", "[", "rungs", "]"}], " ", "+", " ", 
           RowBox[{"creation", "[", "rungs", "]"}]}], "]"}]}], " ", "+", " ", 
        
        RowBox[{"\[Chi]", " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"Z", ",", " ", "count"}], "]"}]}]}]}], ";", "\n", "   ", 
      RowBox[{"run", " ", "=", " ", 
       RowBox[{"evolveODE", "[", 
        RowBox[{"H", ",", " ", 
         RowBox[{"{", 
          RowBox[{"onCavity", "[", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[Gamma]disp", "]"}], " ", 
            RowBox[{"annihilation", "[", "rungs", "]"}]}], "]"}], "}"}], ",", 
         "\n", "     ", 
         RowBox[{"densityMatrix", "[", 
          RowBox[{"Flatten", "@", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"plus", ",", " ", 
             RowBox[{"coherentState", "[", 
              RowBox[{"rungs", ",", " ", "0"}], "]"}]}], "]"}]}], "]"}], ",", 
         " ", "4."}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"Function", "[", 
       RowBox[{"t", ",", " ", 
        RowBox[{"2", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"reducedQubit", "[", 
            RowBox[{
             RowBox[{"run", "[", "t", "]"}], ",", " ", "rungs"}], "]"}], "[", 
           
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], "]"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[123]:= ",
 CellID->1188205371,ExpressionUUID->"40ed67f4-ffa0-5cce-7093-7eb1fa552614"],

Cell[TextData[{
 "Confirm the cutoff by comparing two truncations (cutoff at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dc0df98-8a2c-0889-7bff-d6c22fd95ad3"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "12"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2226f602-e60c-c55a-53dd-e86f93beafa0"],
 ") at the same time:"
}], "Text",
 CellID->1003860385,ExpressionUUID->"4ed808ee-885a-0ea1-76e7-a1c829ef548b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"reading", " ", "=", " ", 
   RowBox[{"qubitCoherence", "[", "9", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"reading", "[", "2.", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"qubitCoherence", "[", "12", "]"}], "[", "2.", "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[124]:= ",
 CellID->952137231,ExpressionUUID->"1627cdbb-2852-50d0-3fdc-e4e549e7223a"],

Cell["The two cutoffs agree, so 9 is enough.", "Text",
 CellID->1052272830,ExpressionUUID->"6801141d-c5dc-e96b-183e-8e46ec6ebbb1"],

Cell["\<\
Now visualize the qubit coherence draining as the pointer states separate:\
\>", "Text",
 CellID->775731387,ExpressionUUID->"2fb5e010-3b47-28f4-554a-fa5abef27ade"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"reading", "[", "t", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "3"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<qubit coherence\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the pointer measures away the qubit coherence\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[125]:= ",
 CellID->975612517,ExpressionUUID->"69461d9a-9714-a717-1f7d-94c422a60a7d"],

Cell["\<\
The coherence falls to near zero as the pointer states separate: a \
measurement that distinguishes the qubit states must destroy their \
superposition.\
\>", "Text",
 CellID->105335494,ExpressionUUID->"1b3cd9b2-b2f5-0832-4ac3-d0ffc6805b18"],

Cell[TextData[{
 "The cavity, the meter itself, tells the same story, and what it shows \
depends on how you read the qubit. Trace the qubit out, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["cavity",
     FontSlant->"Plain"]], "=", 
   SubscriptBox[
    StyleBox["Tr",
     FontSlant->"Plain"], 
    StyleBox["qubit",
     FontSlant->"Plain"]], 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17254721-59fc-dba5-3edb-5e8b5f8ea98f"],
 ", and the cavity is a fringeless mixture of the two pointer states as soon \
as they separate, since the which-way record now lives in the qubit. But keep \
only the records where the qubit is found in ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52d6b4d2-7b23-95d3-02ed-2d9c7ed7ff39"],
 " (the basis where its coherence lives), and the conditional cavity is a cat \
of the two pointers, its off-diagonal coherence carrying the qubit's. A \
function for the cavity conditioned on finding the qubit in a state ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["q", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "133f88c9-4e43-c7a8-42c4-21936bf7adf2"],
 " takes the qubit matrix element and renormalizes it, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    RowBox[{
     StyleBox["cavity",
      FontSlant->"Plain"], ";", 
     StyleBox["q", "TI"]}]], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["q", "TI"]},
     "Bra"], 
    StyleBox["\[Rho]", "TI"], 
    RowBox[{
     TemplateBox[{
       StyleBox["q", "TI"]},
      "Ket"], "/", 
     StyleBox["Tr",
      FontSlant->"Plain"]}], 
    TemplateBox[{
      StyleBox["q", "TI"]},
     "Bra"], 
    StyleBox["\[Rho]", "TI"], 
    TemplateBox[{
      StyleBox["q", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "525bf512-066b-f79b-0278-ed5cb31fdde1"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["q", "TI"]},
    "Bra"], 
   StyleBox["\[Rho]", "TI"], 
   TemplateBox[{
     StyleBox["q", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7020b0a8-e1ec-de26-21df-29f5979ea50c"],
 " leaves a cavity operator and its trace is the probability ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["q", "TI"]},
    "Bra"], 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["qubit",
     FontSlant->"Plain"]], 
   TemplateBox[{
     StyleBox["q", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f4e56ea-c348-0e14-1576-4fb7f6fd557e"],
 " of that outcome:"
}], "Text",
 CellID->1276006902,ExpressionUUID->"2c7820da-3afe-8c15-5407-b984be88d77f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cavityGiven", "[", 
    RowBox[{"joint_", ",", " ", "rungs_", ",", " ", "q_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"joint", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "rungs", ",", " ", "2", ",", " ", "rungs"}], 
          "}"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", " ", "=", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Conjugate", "[", 
             RowBox[{"q", "[", 
              RowBox[{"[", "a", "]"}], "]"}], "]"}], " ", 
            RowBox[{"q", "[", 
             RowBox[{"[", "b", "]"}], "]"}], " ", 
            RowBox[{"r", "[", 
             RowBox[{"[", 
              RowBox[{"a", ",", " ", "All", ",", " ", "b", ",", " ", "All"}], 
              "]"}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"b", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"m", "/", 
        RowBox[{"Tr", "[", "m", "]"}]}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[126]:= ",
 CellID->429330924,ExpressionUUID->"491026a6-dd30-329c-7f2f-bf03d4ca80e6"],

Cell["\<\
Run the joint master equation once, at a cutoff wide enough for the pointer \
blobs:\
\>", "Text",
 CellID->699653744,ExpressionUUID->"78f9e5c0-5bc5-e73b-2886-fcaa5e71ca01"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dispRungs", " ", "=", " ", "16"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dispRun", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Epsilon]", " ", 
       RowBox[{"onCavity", "[", 
        RowBox[{
         RowBox[{"annihilation", "[", "dispRungs", "]"}], " ", "+", " ", 
         RowBox[{"creation", "[", "dispRungs", "]"}]}], "]"}]}], " ", "+", 
      " ", 
      RowBox[{"\[Chi]", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"Z", ",", " ", 
         RowBox[{
          RowBox[{"creation", "[", "dispRungs", "]"}], " ", ".", " ", 
          RowBox[{"annihilation", "[", "dispRungs", "]"}]}]}], "]"}]}]}], ",",
      "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"onCavity", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Gamma]disp", "]"}], " ", 
        RowBox[{"annihilation", "[", "dispRungs", "]"}]}], "]"}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"densityMatrix", "[", 
      RowBox[{"Flatten", "@", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"plus", ",", " ", 
         RowBox[{"coherentState", "[", 
          RowBox[{"dispRungs", ",", " ", "0"}], "]"}]}], "]"}]}], "]"}], ",", 
     " ", "3."}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[127]:= ",
 CellID->2118070064,ExpressionUUID->"295a1104-8f0a-9295-5f79-896e2abce0ff"],

Cell[TextData[{
 "In the untruncated driven-damped model, the conditional cavity has a closed \
two-coherent-state form. Its two diagonal blocks are the pointer coherent \
states ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["e", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34e49fcf-314b-942d-5c9b-16a940ffff77"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["g", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28081ee1-9923-6846-5837-97cb18d63aac"],
 "; the qubit coherence carried into the cavity as the off-diagonal weight \
is"
}], "Text",
 CellID->1744932242,ExpressionUUID->"35d104ab-d16d-b332-63ee-9df4e0191e18"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["T", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox["1", "2"], 
    StyleBox["exp",
     FontSlant->"Plain"], "\[ThinSpace]", "(", 
    RowBox[{"-", "2", 
     StyleBox["i", "TI"], 
     StyleBox["\[Chi]", "TI"], 
     SubsuperscriptBox["\[Integral]", "0", 
      StyleBox["t", "TI"]], 
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], 
      StyleBox["e", "TI"]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["\[Alpha]", "TI"], 
      StyleBox["g", "TI"], "*"], "\[ThinSpace]", 
     StyleBox["d", "TI"], 
     SuperscriptBox[
      StyleBox["t", "TI"], "\[Prime]"]}], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], 
      StyleBox["e", "TI"]], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["\[Alpha]", "TI"], 
      StyleBox["g", "TI"], "*"]}], "=", 
    RowBox[{
     FractionBox[
      SuperscriptBox[
       StyleBox["\[CurlyEpsilon]", "TI"], "2"], 
      SuperscriptBox["\[CapitalLambda]", "2"]], 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "-", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"-", "\[CapitalLambda]", 
          SuperscriptBox[
           StyleBox["t", "TI"], "\[Prime]"]}]]}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{"\[CapitalLambda]", "=", 
    RowBox[{
     StyleBox[
      RowBox[{"i", "\[Chi]"}], "TI"], "+", 
     FractionBox[
      StyleBox["\[Gamma]", "TI"], "2"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->551334296,ExpressionUUID->"4f8fdcfc-c987-8804-75b4-d5b9e833db6e"],

Cell[TextData[{
 "an elementary integral. Dividing ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bb02784-750c-cc73-794f-beee7cbe9759"],
 " by the pointers' overlap gives the coherence coefficient ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], "=", 
   RowBox[{
    StyleBox["T", "TI"], "/", 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], 
       StyleBox["g", "TI"]], 
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], 
       StyleBox["e", "TI"]]},
     "BraKet"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6368bf1a-89ab-f709-1117-3744285fda53"],
 ", so"
}], "Text",
 CellID->682025647,ExpressionUUID->"18aa8291-c565-6e81-48a9-1bdaec1034eb"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     RowBox[{
      StyleBox["cavity",
       FontSlant->"Plain"], ";", "+"}]], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "\[Proportional]", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["e", "TI"]]},
      "Ket"], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["e", "TI"]]},
      "Bra"]}], "+", 
    RowBox[{
     FractionBox["1", "2"], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["g", "TI"]]},
      "Ket"], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["g", "TI"]]},
      "Bra"]}], "+", 
    RowBox[{
     StyleBox["c", "TI"], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["e", "TI"]]},
      "Ket"], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["g", "TI"]]},
      "Bra"]}], "+", 
    RowBox[{
     SuperscriptBox[
      StyleBox["c", "TI"], "*"], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["g", "TI"]]},
      "Ket"], 
     RowBox[{
      TemplateBox[{
        SubscriptBox[
         StyleBox["\[Alpha]", "TI"], 
         StyleBox["e", "TI"]]},
       "Bra"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1646424406,ExpressionUUID->"0fb37437-3ad9-e813-3541-6e71bf6dbb79"],

Cell["Build it directly:", "Text",
 CellID->2053055694,ExpressionUUID->"29c235d7-86a4-1a63-5ff1-ac9133516949"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalLambda]", " ", "=", " ", 
   RowBox[{
    RowBox[{"I", " ", "\[Chi]"}], " ", "+", " ", 
    RowBox[{"\[Gamma]disp", "/", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cohT", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", "2"}], ")"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "I", " ", "\[Chi]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Epsilon]", "^", "2"}], "/", 
        RowBox[{"\[CapitalLambda]", "^", "2"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"t", " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "/", "\[CapitalLambda]"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "\[CapitalLambda]"}], " ", "t"}], "]"}], " ", "-", 
           " ", "1"}], ")"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "\[CapitalLambda]"}], ")"}]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "2"}], " ", "\[CapitalLambda]", " ", "t"}], "]"}], 
           " ", "-", " ", "1"}], ")"}]}]}], ")"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cavityCat", "[", 
    RowBox[{"t_", ",", " ", "rungs_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ke", " ", "=", " ", 
        RowBox[{"coherentState", "[", 
         RowBox[{"rungs", ",", " ", 
          RowBox[{"\[Alpha]e", "[", "t", "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"kg", " ", "=", " ", 
        RowBox[{"coherentState", "[", 
         RowBox[{"rungs", ",", " ", 
          RowBox[{"\[Alpha]g", "[", "t", "]"}]}], "]"}]}]}], "}"}], ",", "\n",
      "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"cc", " ", "=", " ", 
         RowBox[{
          RowBox[{"cohT", "[", "t", "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Conjugate", "[", "kg", "]"}], " ", ".", " ", "ke"}], 
           ")"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", " ", "=", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"densityMatrix", "[", "ke", "]"}], "/", "2"}], " ", "+", 
            " ", 
            RowBox[{
             RowBox[{"densityMatrix", "[", "kg", "]"}], "/", "2"}], " ", "+", 
            " ", 
            RowBox[{"cc", " ", 
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"ke", ",", " ", 
               RowBox[{"Conjugate", "[", "kg", "]"}]}], "]"}]}], " ", "+", 
            " ", 
            RowBox[{
             RowBox[{"Conjugate", "[", "cc", "]"}], " ", 
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"kg", ",", " ", 
               RowBox[{"Conjugate", "[", "ke", "]"}]}], "]"}]}]}]}], "}"}], ",",
          "\n", "     ", 
         RowBox[{"m", "/", 
          RowBox[{"Tr", "[", "m", "]"}]}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[128]:= ",
 CellID->2132198261,ExpressionUUID->"7c4bd199-468e-1df0-2448-c8c3733b67da"],

Cell["\<\
Confirm the closed form against the simulated conditional cavity across the \
whole readout:\
\>", "Text",
 CellID->1954495564,ExpressionUUID->"5faac466-18c1-c293-05a9-de40997590f9"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"traceDistance", "[", 
     RowBox[{
      RowBox[{"cavityCat", "[", 
       RowBox[{"t", ",", " ", "dispRungs"}], "]"}], ",", " ", 
      RowBox[{"cavityGiven", "[", 
       RowBox[{
        RowBox[{"dispRun", "[", "t", "]"}], ",", " ", "dispRungs", ",", " ", 
        "plus"}], "]"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "0.1", ",", " ", "3", ",", " ", "0.1"}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[129]:= ",
 CellID->1504758964,ExpressionUUID->"0b2a52a2-44e1-aebb-392a-4b0c6c95f481"],

Cell[TextData[{
 "The maximum trace-distance discrepancy is small but nonzero because the ODE \
integration and Fock truncation are numerical; decreasing the solver \
tolerance and increasing the cutoff reduce it. Within that controlled error, \
the two-coherent-state formula reproduces the simulated conditional cavity. \
Now the question a phase-space picture cannot answer cleanly: cat or mixture? \
Measure the conditional cavity against both references, the pure cat of the \
current pointers ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], 
       StyleBox["e", "TI"]]},
     "Ket"], "+", 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], 
       StyleBox["g", "TI"]]},
     "Ket"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "146756d1-ea39-ec02-3c1d-4f9a8fcdb768"],
 " and their even mixture, as the readout runs:"
}], "Text",
 CellID->885403737,ExpressionUUID->"1a7ee52b-d767-0389-4a05-fd74e21251d3"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", "\n", "   ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", " ", 
         RowBox[{"traceDistance", "[", 
          RowBox[{
           RowBox[{"cavityGiven", "[", 
            RowBox[{
             RowBox[{"dispRun", "[", "t", "]"}], ",", " ", "dispRungs", ",", 
             " ", "plus"}], "]"}], ",", " ", 
           RowBox[{"densityMatrix", "@", 
            RowBox[{"Normalize", "[", 
             RowBox[{
              RowBox[{"coherentState", "[", 
               RowBox[{"dispRungs", ",", " ", 
                RowBox[{"\[Alpha]e", "[", "t", "]"}]}], "]"}], " ", "+", " ", 
              
              RowBox[{"coherentState", "[", 
               RowBox[{"dispRungs", ",", " ", 
                RowBox[{"\[Alpha]g", "[", "t", "]"}]}], "]"}]}], "]"}]}]}], 
          "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0.1", ",", " ", "3", ",", " ", "0.05"}], 
        "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", " ", 
         RowBox[{"traceDistance", "[", 
          RowBox[{
           RowBox[{"cavityGiven", "[", 
            RowBox[{
             RowBox[{"dispRun", "[", "t", "]"}], ",", " ", "dispRungs", ",", 
             " ", "plus"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"densityMatrix", "[", 
              RowBox[{"coherentState", "[", 
               RowBox[{"dispRungs", ",", " ", 
                RowBox[{"\[Alpha]e", "[", "t", "]"}]}], "]"}], "]"}], "/", 
             "2"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"densityMatrix", "[", 
              RowBox[{"coherentState", "[", 
               RowBox[{"dispRungs", ",", " ", 
                RowBox[{"\[Alpha]g", "[", "t", "]"}]}], "]"}], "]"}], "/", 
             "2"}]}]}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0.1", ",", " ", "3", ",", " ", "0.05"}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<distance to the pure cat\>\"", ",", 
      " ", "\"\<distance to the classical mixture\>\""}], "}"}]}], ",", "\n", 
   " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<readout time\>\"", ",", " ", "\"\<trace distance\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the conditional cavity starts a cat and decoheres into the \
mixture\>\""}]}], "]"}]], "Input",
 CellLabel->"In[130]:= ",
 CellID->299015440,ExpressionUUID->"419fd7e1-c297-cbe2-77a4-cecaf72399c8"],

Cell[TextData[{
 "Early the conditional cavity hugs the pure cat: the two pointers still \
coincide, so there is little to tell apart and little coherence to lose. As \
they separate its distance to the cat climbs while its distance to the \
mixture falls, the two crossing near ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "\[TildeTilde]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a33ac2f-4fb5-380e-2bc0-45896a418b54"],
 " for these parameters; past there the state is closer to the classical \
mixture, and by the time the pointers are cleanly resolved it is close to \
that mixture. The cat is fleeting because distinguishability and dephasing \
grow together. Contrast the Haroche cat of the earlier section: there the \
dispersive atom imprinted the two phases ",
 StyleBox["before", "TI"],
 " the cavity leaked, so separation came first and decoherence after; here \
they arise from the same readout process. This is dispersive qubit readout in \
circuit QED, where the pointer is a microwave tone reflected off a \
resonator."
}], "Text",
 CellID->59570862,ExpressionUUID->"3b56b9eb-04f6-5b17-696d-30b5ac83267d"],

Cell["\<\
Part Three: A Heavy Particle, and the Two Faces of a Warm Bath\
\>", "Section",
 CellID->1364978316,ExpressionUUID->"6e9dc2e4-4753-bfbd-16a2-dbce72e70587"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A particle of mass ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7db41629-8d3d-b9f9-2b4b-887324c90bc3"],
 " in a gentle trap ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["M", "TI"], 
   SuperscriptBox["\[CapitalOmega]", "2"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f51d24b-32fb-3155-656e-d415468f83bf"],
 ", coupled to a warm bath (the Caldeira-Leggett model). In the \
high-temperature limit,"
}], "Text",
 CellID->565097818,ExpressionUUID->"32e9efb5-7328-71d0-6296-06ff06dd433a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      StyleBox["i", "TI"], 
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       RowBox[{
        FractionBox[
         SuperscriptBox[
          OverscriptBox[
           StyleBox["p", "TI"], "^"], "2"], 
         RowBox[{"2", 
          StyleBox["M", "TI"]}]], "+", 
        FractionBox["1", "2"], 
        StyleBox["M", "TI"], 
        SuperscriptBox["\[CapitalOmega]", "2"], 
        SuperscriptBox[
         OverscriptBox[
          StyleBox["x", "TI"], "^"], "2"]}], ",", " ", 
       StyleBox["\[Rho]", "TI"]}], 
      StyleBox["]",
       SpanMaxSize->1]}]}], "-", 
    StyleBox[
     RowBox[{"i", "\[Gamma]"}], "TI"], "-", 
    RowBox[{"2", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["M", "TI"], 
     SubscriptBox[
      StyleBox["k", "TI"], 
      StyleBox["B", "TI"]], 
     RowBox[{
      StyleBox["T", "TI"], "\[ThinSpace]", "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1520041768,ExpressionUUID->"0aa19f46-928a-afd4-3a5e-1720273cf53e"],

Cell[TextData[{
 "Friction damps the momentum at rate ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31860dcc-84f8-941b-67bd-a4962d72ff61"],
 "; the double commutator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["x", "TI"], "^"], ",", 
      StyleBox["\[Rho]", "TI"]}], 
     StyleBox["]",
      SpanMaxSize->1]}]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08371d00-4cf7-24ac-39cc-956a64838ef6"],
 " decoheres a superposition of two positions a distance ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e555e8f-0ad0-492d-166b-57e9af651877"],
 " apart at a rate ",
 Cell[BoxData[
  RowBox[{"\[Proportional]", 
   StyleBox["M", "TI"], 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"], "\[ThinSpace]", "\[CapitalDelta]", 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348b0551-d20e-4e96-5c88-9d1ae7bb14fc"],
 ", quadratic in the separation, the same law as the light-cat. For a smooth \
(Gaussian) blob the first and second moments of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c065349-950a-8738-043e-4b131cbcea02"],
 " close into a small set of rate equations, exactly the five below."
}], "Text",
 CellID->862412655,ExpressionUUID->"4ff276a9-5e86-52e3-7582-6ff35b3320c9"],

Cell[TextData[{
 "A heavy particle in a harmonic trap ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["M", "TI"], 
   SuperscriptBox["\[CapitalOmega]", "2"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24b6e2ad-c501-b7fc-4c4d-fbf6ecb51dc6"],
 ", coupled to a warm bath (Caldeira-Leggett). Friction damps the momentum; \
the bath's fluctuations grow the position variance to thermal equilibrium. \
For a Gaussian state the first and second moments of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230cad6b-7900-e120-5133-453578bab00a"],
 " close into five equations: the mean ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["x", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["p", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "086f7f71-a7b7-bd3e-3815-773ad2430404"],
 " and the covariance matrix ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cdf8892-1d3f-31f6-34e4-21dc94cb83dc"],
 " with entries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xx",
      FontSlant->"Plain"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xp",
      FontSlant->"Plain"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["pp",
      FontSlant->"Plain"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e0217c2-6a7a-d359-2631-8eac0f0ca1a3"],
 ". The high-temperature master equation above holds only when ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"], ">", "\[HBar]", "\[CapitalOmega]"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "4104c6da-03d7-a765-773b-df84b6630a4f"],
 ", so fix the mass, trap frequency, friction, and a temperature well above \
the level spacing ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "\[CapitalOmega]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "731f4b84-5335-8b87-2125-62ee66c1d9ed"],
 ":"
}], "Text",
 CellID->426217663,ExpressionUUID->"315717aa-70ab-e706-676c-8ef4015fca6c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"M", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"\[CapitalOmega]qbm", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"\[Gamma]qbm", " ", "=", " ", "0.15"}], ";", " ", 
  RowBox[{"kT", " ", "=", " ", "5."}], ";", " ", 
  RowBox[{"Ddiff", " ", "=", " ", 
   RowBox[{"4", " ", "\[Gamma]qbm", " ", "M", " ", "kT"}]}], ";"}]], "Input",
 CellLabel->"In[131]:= ",
 CellID->128954499,ExpressionUUID->"7c1b1617-f81f-7a45-2438-8850f9aa48af"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"], "=", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70b05f1a-470c-9c9d-2040-574472bee6e7"],
 " against a level spacing of ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a8c5b06-7c6a-07f5-7ab4-5360751f6ddf"],
 ", the bath is genuinely warm. Written out, those five equations are"
}], "Text",
 CellID->731716873,ExpressionUUID->"4fa3f928-0446-c8dd-7550-f172adf09a27"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["x", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], "."], "=", 
    FractionBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["p", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox["M", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    OverscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["p", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], "."], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       StyleBox["M", "TI"]}], 
      SuperscriptBox["\[CapitalOmega]", "2"], 
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["x", "TI"], "^"], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]}], "-", 
     RowBox[{"2", 
      StyleBox["\[Gamma]", "TI"], 
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["p", "TI"], "^"], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->263464368,ExpressionUUID->"3727240c-f62b-7b8f-5edc-be6983de49d5"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalSigma]", "."], 
     StyleBox["xx",
      FontSlant->"Plain"]], "=", 
    FractionBox[
     RowBox[{"2", 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["xp",
        FontSlant->"Plain"]]}], 
     StyleBox["M", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalSigma]", "."], 
     StyleBox["xp",
      FontSlant->"Plain"]], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["pp",
        FontSlant->"Plain"]], 
      StyleBox["M", "TI"]], "-", 
     RowBox[{
      StyleBox["M", "TI"], 
      SuperscriptBox["\[CapitalOmega]", "2"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["xx",
        FontSlant->"Plain"]]}], "-", 
     RowBox[{"2", 
      StyleBox["\[Gamma]", "TI"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["xp",
        FontSlant->"Plain"]]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalSigma]", "."], 
     StyleBox["pp",
      FontSlant->"Plain"]], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], 
      StyleBox["M", "TI"], 
      SuperscriptBox["\[CapitalOmega]", "2"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["xp",
        FontSlant->"Plain"]]}], "-", 
     RowBox[{"4", 
      StyleBox["\[Gamma]", "TI"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["pp",
        FontSlant->"Plain"]]}], "+", 
     StyleBox["D", "TI"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->519276129,ExpressionUUID->"50637aef-2122-41f7-0011-73c950d713dd"],

Cell[TextData[{
 "with diffusion coefficient ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], "=", "4", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["M", "TI"], 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63773809-2d44-01f7-110c-b25344f153dd"],
 ". The initial covariance must itself be a valid quantum state, so start \
from the trap's ground state, the minimum-uncertainty blob with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["xx",
     FontSlant->"Plain"]], "=", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["pp",
     FontSlant->"Plain"]], "=", "\[HBar]", "/", "2", "=", "1", "/", "2"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ede8b7e-b317-5b7c-26e5-233bc6a22646"],
 " (so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalSigma]", "=", 
   SuperscriptBox["\[HBar]", "2"], "/", "4", "=", "1", "/", "4"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75c8f24b-f46e-7672-23f7-f414fd1b5d58"],
 "), displaced off the origin. Integrate them from there:"
}], "Text",
 CellID->1441306302,ExpressionUUID->"2d149507-d3df-875e-5b2b-0d60e66beda4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"particle", " ", "=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"cx", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"cp", "[", "t", "]"}], "/", "M"}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"cp", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "M"}], " ", 
          RowBox[{"\[CapitalOmega]qbm", "^", "2"}], " ", 
          RowBox[{"cx", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"2", " ", "\[Gamma]qbm", " ", 
          RowBox[{"cp", "[", "t", "]"}]}]}]}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"vx", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{"2", " ", 
         RowBox[{
          RowBox[{"vc", "[", "t", "]"}], "/", "M"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"vc", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"vp", "[", "t", "]"}], "/", "M"}], " ", "-", " ", 
         RowBox[{"M", " ", 
          RowBox[{"\[CapitalOmega]qbm", "^", "2"}], " ", 
          RowBox[{"vx", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"2", " ", "\[Gamma]qbm", " ", 
          RowBox[{"vc", "[", "t", "]"}]}]}]}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"vp", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "M", " ", 
          RowBox[{"\[CapitalOmega]qbm", "^", "2"}], " ", 
          RowBox[{"vc", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"4", " ", "\[Gamma]qbm", " ", 
          RowBox[{"vp", "[", "t", "]"}]}], " ", "+", " ", "Ddiff"}]}], ",", 
       "\n", "   ", 
       RowBox[{
        RowBox[{"cx", "[", "0", "]"}], " ", "==", " ", "2."}], ",", " ", 
       RowBox[{
        RowBox[{"cp", "[", "0", "]"}], " ", "==", " ", "0."}], ",", " ", 
       RowBox[{
        RowBox[{"vx", "[", "0", "]"}], " ", "==", " ", "0.5"}], ",", " ", 
       RowBox[{
        RowBox[{"vc", "[", "0", "]"}], " ", "==", " ", "0."}], ",", " ", 
       RowBox[{
        RowBox[{"vp", "[", "0", "]"}], " ", "==", " ", "0.5"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
      "cx", ",", " ", "cp", ",", " ", "vx", ",", " ", "vc", ",", " ", "vp"}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "30"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[132]:= ",
 CellID->370920483,ExpressionUUID->"772d62ae-4bf9-dab0-1ed3-7b086d8da89a"],

Cell["Two functions returning the mean and the covariance matrix:", "Text",
 CellID->1675734937,ExpressionUUID->"7a8c9a4d-0caa-515e-2ab3-1c17a55f23a4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"center", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"particle", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"particle", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "[", "t", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"spread", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"particle", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"particle", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "[", "t", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"particle", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"particle", "[", 
         RowBox[{"[", "5", "]"}], "]"}], "[", "t", "]"}]}], "}"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[133]:= ",
 CellID->1811399761,ExpressionUUID->"6a4c6a75-6554-e0e6-1a73-8c3f0ce6b2cc"],

Cell["\<\
Two checks. First, the mean spirals in from its displaced start to rest:\
\>", "Text",
 CellID->417262126,ExpressionUUID->"29c3108e-8c9d-f317-5ff0-89e82529de7d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"center", "[", "0", "]"}], ",", " ", 
   RowBox[{"center", "[", "25", "]"}]}], "}"}]], "Input",
 CellLabel->"In[134]:= ",
 CellID->1077936938,ExpressionUUID->"5b90d741-2df1-4c37-09af-cf2b4b84171d"],

Cell[TextData[{
 "It starts displaced and ends near the origin. Second, the position variance \
",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["xx",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a353f88-1ea4-a3d5-0bca-b6d29b56f13f"],
 " grows from its ground-state value ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "/", "2", "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c3a5085-d835-7232-65da-49eed9c04118"],
 " to the thermal value ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["M", "TI"], 
    SuperscriptBox["\[CapitalOmega]", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f71b61d-3801-a1b0-550e-2847b9b5f39a"],
 ", equipartition for a harmonic trap:"
}], "Text",
 CellID->181325614,ExpressionUUID->"3c7c9f19-7bfc-9bea-6403-17437d8ee930"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"particle", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "[", "0", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"particle", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "[", "25", "]"}], ",", " ", 
   RowBox[{"kT", "/", 
    RowBox[{"(", 
     RowBox[{"M", " ", 
      RowBox[{"\[CapitalOmega]qbm", "^", "2"}]}], ")"}]}]}], "}"}]], "Input",
 CellLabel->"In[135]:= ",
 CellID->2020910698,ExpressionUUID->"4bcd3c0f-0044-41be-79f2-b669b1f11384"],

Cell["\<\
It lands on the thermal value, ten times the ground-state spread. Check it a \
second way: the steady covariance solves the Lyapunov equation, where \
diffusion balances friction:\
\>", "Text",
 CellID->661155756,ExpressionUUID->"250574e2-7568-dee6-533b-6dcc7c02a4cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"drift", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"1", "/", "M"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "M"}], " ", 
        RowBox[{"\[CapitalOmega]qbm", "^", "2"}]}], ",", " ", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[Gamma]qbm"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"LyapunovSolve", "[", 
  RowBox[{"drift", ",", " ", 
   RowBox[{"-", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "Ddiff"}], "}"}]}], "}"}]}]}], "]"}]}], "Input",\

 CellLabel->"In[136]:= ",
 CellID->1040242161,ExpressionUUID->"570dea5b-028b-2dc3-7d32-0c05b73e7729"],

Cell["The Lyapunov steady state matches the integrated one.", "Text",
 CellID->758481243,ExpressionUUID->"559114f0-95cd-3728-03ae-8dba1c799a72"],

Cell[TextData[{
 "The same covariance bookkeeping returns under monitoring in Part Five. The \
Kalman filter's watched oscillator obeys ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox["\[CapitalSigma]", "."], "=", 
   StyleBox["A", "TI"], "\[CapitalSigma]", "+", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["T", "TI"]], "+", 
   StyleBox["D", "TI"], "-", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["T", "TI"]], 
   StyleBox["C", "TI"], "\[CapitalSigma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "499d2cc9-9173-f7c8-7fa2-c5932007dd12"],
 ", the Lyapunov form above plus one term the bath cannot supply, the \
measurement's information gain ",
 Cell[BoxData[
  RowBox[{"-", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["T", "TI"]], 
   StyleBox["C", "TI"], "\[CapitalSigma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3687b6-15a3-de20-4acd-1ef09c57a50a"],
 ": diffusion widens the blob to thermal here, watching narrows it below the \
ground-state spread there."
}], "Text",
 CellID->607101385,ExpressionUUID->"073f26db-34e5-c8c2-2ec4-bf85bc919a28"],

Cell[TextData[{
 "One more check the model must pass to be believed: a real quantum state \
obeys the Robertson-Schrodinger uncertainty relation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalSigma]", "=", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["xx",
     FontSlant->"Plain"]], 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["pp",
     FontSlant->"Plain"]], "-", 
   SubsuperscriptBox["\[CapitalSigma]", 
    StyleBox["xp",
     FontSlant->"Plain"], "2"], "\[GreaterEqual]", 
   SuperscriptBox["\[HBar]", "2"], "/", "4", "=", "1", "/", "4"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27056d96-6b3e-545a-4d3a-84d00ecb3ea0"],
 ", so the margin ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalSigma]", "-", "1", "/", 
   "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "031df9cf-6b45-d275-3122-f0a90ef1a15f"],
 " must stay non-negative for the whole run. The high-temperature \
Caldeira-Leggett generator is not of Lindblad form, so this is not automatic; \
watch it directly:"
}], "Text",
 CellID->718676885,ExpressionUUID->"79902eb9-9fc4-d4aa-2faf-c7e31a76bef0"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Det", "@", 
     RowBox[{"spread", "[", "t", "]"}]}], " ", "-", " ", 
    RowBox[{"1", "/", "4"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "25"}], "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<uncertainty margin  det \[CapitalSigma] - 1/4\>\""}], "}"}]}],
    ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the state stays above the uncertainty floor\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[137]:= ",
 CellID->1099629263,ExpressionUUID->"6e90dac8-e749-9c1a-16af-d39592fde760"],

Cell[TextData[{
 "The margin starts at zero, where the ground state saturates the bound, and \
only grows for this valid high-temperature run: the blob swells above the \
Heisenberg floor and never dips below it. Starting instead from ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["xx",
     FontSlant->"Plain"]], "=", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["pp",
     FontSlant->"Plain"]], "=", "0.1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f026f1c-d8c2-1814-5531-8759d9776b7e"],
 " would already violate the bound at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c65fa9b-46f3-ebf0-041a-f3c57287b9da"],
 "; the moment equations can later carry that covariance into the valid \
region, but doing so does not retroactively make the initial state physical. \
Conversely, at temperatures outside the model's high-temperature regime this \
non-Lindblad generator can drive an initially valid covariance below the \
floor. The point of the plotted check is therefore local and explicit: the \
chosen parameters and initial state remain physical throughout the displayed \
interval."
}], "Text",
 CellID->2120979663,ExpressionUUID->"583cd303-9cb1-03ae-09c3-cb6d154451f4"],

Cell[TextData[{
 "Those checks read the mean and the variance as numbers; the phase-space \
picture puts them in one object. That object is the state's ",
 StyleBox["Wigner function",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18f1bad1-a8d9-f26a-488e-339ac96dc0b0"],
 ", the quasiprobability the cat used in Part Two, except that for a Gaussian \
state no Fock-basis sum is needed: ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cd8e50a-7117-62ea-14e7-fd5400a23030"],
 " is exactly the bivariate normal set by the five moments, centered at the \
mean ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["r", "TI"], "_"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["x", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["p", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b9c4f1f-9707-8ca1-29a4-675922b3d68b"],
 " and shaped by the covariance ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0839f778-d15e-09ff-39c6-ef25e0eb5bc5"],
 ","
}], "Text",
 CellID->123468129,ExpressionUUID->"7962e333-0c57-77b8-2f11-fb7da5e25d82"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["W", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox["1", 
     RowBox[{"2", "\[Pi]", 
      SqrtBox[
       RowBox[{
        StyleBox["det",
         FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalSigma]"}]]}]], "\[ThinSpace]", 
    StyleBox["exp",
     FontSlant->"Plain"], "\[ThinSpace]", "(", 
    RowBox[{"-", 
     FractionBox["1", "2"], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["r", "TI"], "-", 
        OverscriptBox[
         StyleBox["r", "TI"], "_"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      StyleBox["T", "TI"]], "\[ThinSpace]", 
     SuperscriptBox["\[CapitalSigma]", 
      RowBox[{"-", "1"}]], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["r", "TI"], "-", 
      OverscriptBox[
       StyleBox["r", "TI"], "_"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["r", "TI"], "=", 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->513893082,ExpressionUUID->"0e58b71a-bb3b-e382-3667-2f443ecfb1e8"],

Cell[TextData[{
 "normalized so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   StyleBox["W", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["p", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7517e465-645e-477c-232c-fe4f0deb2a46"],
 ". Transcribe it as a function of time, reading ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["r", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "560e68d9-da1a-2272-7e35-8182dfaf7158"],
 " and ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46aa8ea3-37c3-4040-6ea9-270d427612aa"],
 " off the solution at each ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6acb7fb5-f6da-6094-1ac9-76fe836f32fe"],
 ":"
}], "Text",
 CellID->1710240506,ExpressionUUID->"7a5ec95d-e220-f105-2a65-e10697dac06f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"wignerGaussian", "[", 
    RowBox[{"t_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r0", " ", "=", " ", 
        RowBox[{"center", "[", "t", "]"}]}], ",", " ", 
       RowBox[{"iS", " ", "=", " ", 
        RowBox[{"Inverse", "[", 
         RowBox[{"spread", "[", "t", "]"}], "]"}]}], ",", " ", 
       RowBox[{"nrm", " ", "=", " ", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "Pi", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"Det", "[", 
             RowBox[{"spread", "[", "t", "]"}], "]"}], "]"}]}], ")"}]}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "p"}], "}"}], ",", " ", 
       RowBox[{"nrm", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x", ",", " ", "p"}], "}"}], " ", "-", " ", "r0"}], 
              ")"}], " ", ".", " ", "iS", " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x", ",", " ", "p"}], "}"}], " ", "-", " ", "r0"}], 
              ")"}]}], ")"}]}], "/", "2"}], "]"}]}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[138]:= ",
 CellID->1971880122,ExpressionUUID->"05590d03-2064-1772-3366-a56d51117a58"],

Cell["\<\
Trace the mean's whole path once, a faint guide to lay under the moving blob:\
\
\>", "Text",
 CellID->482876923,ExpressionUUID->"3b9b9f37-eb8f-88a6-69b8-17708e3bda8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"centerLine", " ", "=", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"center", "[", "t", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "25", ",", " ", "0.05"}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thin", ",", " ", "Gray"}], "]"}]}]}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[139]:= ",
 CellID->257955902,ExpressionUUID->"7ef0eca9-2ea7-fc5e-268f-05f34b53c6a4"],

Cell["\<\
Now set it in motion from the displaced start: the Wigner bump rides the gray \
path in toward the origin as friction drains the mean, and fills out to the \
thermal size as diffusion widens it, the red dot marking where the mean sits \
at each instant. Press play:\
\>", "Text",
 CellID->1595709984,ExpressionUUID->"53b0040e-15e9-970f-014f-9e68a39dfa55"],

Cell[BoxData[
 RowBox[{"Animate", "[", 
  RowBox[{
   RowBox[{"Show", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"DensityPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"wignerGaussian", "[", "t", "]"}], "[", 
        RowBox[{"x", ",", " ", "p"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", 
         RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"PlotPoints", " ", "->", " ", "60"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "    ", 
       RowBox[{"ColorFunction", " ", "->", " ", "\"\<SunsetColors\>\""}], ",",
        " ", 
       RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "400"}], ",", "\n", "    ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"\"\<Wigner W(x,p) at t = \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "t", "]"}]}]}], ",", "\n", "    ", 
       RowBox[{"Epilog", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Red", ",", " ", 
          RowBox[{"Point", "[", 
           RowBox[{"center", "[", "t", "]"}], "]"}]}], "}"}]}]}], "]"}], ",", 
     " ", "centerLine"}], "]"}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "25", ",", " ", ".1"}], "}"}], ",", 
   " ", 
   RowBox[{"AnimationRunning", " ", "->", " ", "False"}]}], "]"}]], "Input",
 CellLabel->"In[140]:= ",
 CellID->1806165637,ExpressionUUID->"49c5479d-c9fe-ab26-7ffb-5ec6ef88f60c"],

Cell[TextData[{
 "It stays a single Gaussian bump the whole way, never developing finer \
structure: the state never leaves the five-number family, the closure that \
let five equations describe it in the first place. Friction and diffusion are \
the same bath's two effects, tied by the fluctuation-dissipation relation: \
the friction rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73b5640c-4acf-57ea-214b-7e566f7a3d30"],
 " is set by the coupling, while the diffusion (and so the thermal spread the \
blob swells to) grows with temperature."
}], "Text",
 CellID->1730622717,ExpressionUUID->"12e31b8a-6cd9-3185-4290-92d4056d83ef"],

Cell[TextData[{
 "The sharper effect, and why this sits beside the cavity cat: a \
superposition of two positions decoheres, and a warm bath does it faster than \
a cold one. Here the model changes from the Caldeira-Leggett moment equations \
above to the thermal-oscillator Lindblad master equation (a decay channel ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c8dfb5f-95aa-8549-44b2-f3191c5cef93"],
 " at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77ba1ed5-dc9c-5ed1-1d59-979ed529243b"],
 " and an excitation channel ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "122b6086-f39f-774a-4229-79e3862a5d90"],
 " at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "562fd52b-4ccb-95a8-7fd4-cd75657ffff2"],
 ", the same warm-bath form used later for thermalization), integrated in a \
truncated Fock basis. Build the same coherent-state cat and evolve it under \
that bath. Set the oscillator cutoff and the bath's rate:"
}], "Text",
 CellID->694790404,ExpressionUUID->"6a176158-c8f1-b5ca-1a2d-7905e8851f10"],

Cell[BoxData[
 RowBox[{
  RowBox[{"twoRung", " ", "=", " ", "22"}], ";", " ", 
  RowBox[{"\[Gamma]warm", " ", "=", " ", "0.5"}], ";"}]], "Input",
 CellLabel->"In[141]:= ",
 CellID->1833306836,ExpressionUUID->"59294b9d-2c6b-0af3-08d7-62c7451e58d9"],

Cell[TextData[{
 "The surviving coherence is the trace distance between the coherently \
evolved cat and the classical mixture its two lobes would form, both carried \
through the same thermal bath ",
 Cell[BoxData[
  RowBox[{"\[ScriptCapitalL]", 
   StyleBox["\[Rho]", "TI"], "=", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"], "+", 
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c93342e-976f-2690-74a0-ad88221b8cfa"],
 ":"
}], "Text",
 CellID->1703418593,ExpressionUUID->"0c05a0c6-8ada-cee6-343a-39a02f6c94cc"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["warmCoherence",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["T", "TI"]], ",", 
       StyleBox["\[Alpha]", "TI"], ",", 
       StyleBox["t", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     StyleBox["Tr",
      FontSlant->"Plain"], GridBox[{
       {
        RowBox[{
         SubscriptBox[
          StyleBox["\[Rho]", "TI"], 
          StyleBox["cat",
           FontSlant->"Plain"]], 
         StyleBox["(",
          SpanMaxSize->1], 
         StyleBox["t", "TI"], 
         StyleBox[")",
          SpanMaxSize->1], "-", 
         FractionBox["1", "2"], 
         StyleBox["[",
          SpanMaxSize->1], 
         SubscriptBox[
          StyleBox["\[Rho]", "TI"], 
          RowBox[{"+", 
           StyleBox["\[Alpha]", "TI"]}]], 
         StyleBox["(",
          SpanMaxSize->1], 
         StyleBox["t", "TI"], 
         StyleBox[")",
          SpanMaxSize->1], "+", 
         SubscriptBox[
          StyleBox["\[Rho]", "TI"], 
          RowBox[{"-", 
           StyleBox["\[Alpha]", "TI"]}]], 
         StyleBox["(",
          SpanMaxSize->1], 
         StyleBox["t", "TI"], 
         StyleBox[")",
          SpanMaxSize->1], 
         StyleBox["]",
          SpanMaxSize->1]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["cat",
       FontSlant->"Plain"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"\[ScriptCapitalL]", 
       StyleBox["t", "TI"]}]], "[", 
     RowBox[{
      TemplateBox[{
        StyleBox["cat", FontSlant -> "Plain"]},
       "Ket"], 
      TemplateBox[{
        StyleBox["cat", FontSlant -> "Plain"]},
       "Bra"]}], "]"}]}], ",", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      RowBox[{"\[PlusMinus]", 
       StyleBox["\[Alpha]", "TI"]}]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"\[ScriptCapitalL]", 
       StyleBox["t", "TI"]}]], "[", 
     RowBox[{
      TemplateBox[{
        RowBox[{"\[PlusMinus]", 
          StyleBox["\[Alpha]", "TI"]}]},
       "Ket"], 
      TemplateBox[{
        RowBox[{"\[PlusMinus]", 
          StyleBox["\[Alpha]", "TI"]}]},
       "Bra"]}], "]"}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1263998950,ExpressionUUID->"386c40c3-2c7c-2bd7-6814-59ad4509793d"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["gap",
    FontSlant->"Plain"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38a5d185-6c33-4099-685a-c8ef05c612e3"],
 ". Here ",
 Cell[BoxData["gap"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705b2160-d6f6-9bc7-2078-b94de280e92d"],
 " is the coherent amplitude of either lobe and therefore half their \
phase-space amplitude separation ",
 Cell[BoxData[
  RowBox[{"2", GridBox[{
     {
      StyleBox["\[Alpha]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ad5a48d-d13d-ee7b-6aea-3dd6e0c9b541"],
 ". It is largest while the cat is still distinct from that mixture and falls \
to zero as the cross-terms decohere (both thermalize to the same steady \
state). The bath's ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e286ad4-f19d-13f8-67d7-8391802861c2"],
 " channel heats a coherent state, so the two lobes will not stay coherent \
and are evolved rather than written down; compute it over a list of delays, \
one run each for the cat and its lobes:"
}], "Text",
 CellID->1096868287,ExpressionUUID->"40ae3c14-0aab-252d-7055-b65eaf5f8c77"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"warmCoherence", "[", 
    RowBox[{"nT_", ",", " ", "gap_", ",", " ", "delays_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fall", " ", "=", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"\[Gamma]warm", " ", 
           RowBox[{"(", 
            RowBox[{"nT", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", 
         RowBox[{"annihilation", "[", "twoRung", "]"}]}]}], ",", " ", 
       RowBox[{"climb", " ", "=", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"\[Gamma]warm", " ", "nT"}], "]"}], " ", 
         RowBox[{"creation", "[", "twoRung", "]"}]}]}], ",", "\n", "    ", 
       RowBox[{"pair", " ", "=", " ", 
        RowBox[{"densityMatrix", "@", 
         RowBox[{"Normalize", "[", 
          RowBox[{
           RowBox[{"coherentState", "[", 
            RowBox[{"twoRung", ",", " ", "gap"}], "]"}], " ", "+", " ", 
           RowBox[{"coherentState", "[", 
            RowBox[{"twoRung", ",", " ", 
             RowBox[{"-", "gap"}]}], "]"}]}], "]"}]}]}], ",", "\n", "    ", 
       RowBox[{"blobA", " ", "=", " ", 
        RowBox[{"densityMatrix", "[", 
         RowBox[{"coherentState", "[", 
          RowBox[{"twoRung", ",", " ", "gap"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"blobB", " ", "=", " ", 
        RowBox[{"densityMatrix", "[", 
         RowBox[{"coherentState", "[", 
          RowBox[{"twoRung", ",", " ", 
           RowBox[{"-", "gap"}]}], "]"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"runs", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"evolveODE", "[", 
            RowBox[{
             RowBox[{"0", " ", 
              RowBox[{"IdentityMatrix", "[", "twoRung", "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"fall", ",", " ", "climb"}], "}"}], ",", " ", "#", ",", 
             " ", 
             RowBox[{"Max", "[", "delays", "]"}]}], "]"}], " ", "&"}], " ", "/@",
           " ", 
          RowBox[{"{", 
           RowBox[{"pair", ",", " ", "blobA", ",", " ", "blobB"}], "}"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "@", 
           RowBox[{"SingularValueList", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"runs", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", "t", "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"runs", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "[", "t", "]"}], " ", "+", 
                " ", 
                RowBox[{
                 RowBox[{"runs", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}]}], ")"}], "/",
               "2"}]}], "]"}]}], "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "delays"}], "}"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[142]:= ",
 CellID->152289512,ExpressionUUID->"3710829e-7f3a-eae8-5d2f-1bd87accb832"],

Cell["\<\
Now visualize the temperature dependence by comparing a cold and a warm bath \
at the same separation:\
\>", "Text",
 CellID->2048354789,ExpressionUUID->"514f46f4-7214-5441-0775-5fbe07a13eab"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"warmTimes", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", "1.5", ",", " ", "0.06"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"warmTimes", ",", " ", 
        RowBox[{"warmCoherence", "[", 
         RowBox[{"0.15", ",", " ", "1.5", ",", " ", "warmTimes"}], "]"}]}], 
       "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"warmTimes", ",", " ", 
        RowBox[{"warmCoherence", "[", 
         RowBox[{"1.5", ",", " ", "1.5", ",", " ", "warmTimes"}], "]"}]}], 
       "}"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<cold bath\>\"", ",", " ", "\"\<warm bath\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<surviving coherence\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<a warm bath decoheres the cat faster than a cold one\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[143]:= ",
 CellID->1927064331,ExpressionUUID->"5a8341fe-fd5d-b2cd-0ab1-58bbf4e90017"],

Cell[TextData[{
 "The warm bath decoheres the cat far faster: the rate grows with \
temperature. As with the cavity cat, the rate also grows with the separation: \
together the decoherence rate scales as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    OverscriptBox[
     StyleBox["n", "TI"], "_"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cf942e0-12f7-a17b-7487-5bcaa683f041"],
 " times the ",
 StyleBox["square", "TI"],
 " of the separation. The ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4db09b50-0334-b760-7b4f-131ab6c61a4a"],
 " is the zero-point (vacuum) term that decoheres even a cold cavity cat; \
temperature adds to it, so heating speeds decoherence but is not what starts \
it. For macroscopic separations the rate is enormous at any temperature: the \
fuller answer to why superpositions of large objects become so difficult to \
preserve as their separation grows. Sweep the cat size continuously at the \
fixed short delay, and the two effects trade off:"
}], "Text",
 CellID->177111739,ExpressionUUID->"7cb56032-9c81-172f-244b-7a7c15347a75"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sep", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "3", ",", " ", "0.05"}], "]"}]}], "}"}], ",", 
     " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", " ", 
         RowBox[{
          RowBox[{"warmCoherence", "[", 
           RowBox[{"1.5", ",", " ", "#", ",", " ", 
            RowBox[{"{", "0.15", "}"}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", " ",
       "sep"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<coherent amplitude |\[Alpha]| (half-separation)\>\"", ",", 
      " ", "\"\<surviving coherence at fixed short delay\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<surviving coherence peaks at a modest cat size, then \
falls\>\""}]}], "]"}]], "Input",
 CellLabel->"In[144]:= ",
 CellID->115596948,ExpressionUUID->"55f15dca-bfed-9606-038f-54943999fd6c"],

Cell["\<\
The curve is not monotonic: a bigger cat starts with more coherence but \
decoheres faster, at a rate set by the separation squared, so at a fixed \
short delay the two trade off and the coherence peaks at a modest size before \
the quadratic decoherence overruns it. (Stop at separation 3: past there the \
Fock cutoff clips the coherent states.)\
\>", "Text",
 CellID->1114128274,ExpressionUUID->"5589ad74-704a-26e9-03b6-453e01fc8c33"],

Cell["Part Four: One Leak, Three Ways to Watch It", "Section",
 CellID->1895094918,ExpressionUUID->"37fda5d4-10fa-7e26-5d82-3c9ea08f450c"],

Cell[TextData[{
 "So far we mostly averaged over the record. Now we keep it. The key fact: \
the same master equation can be ",
 StyleBox["unravelled",
  FontWeight->"Bold"],
 " into trajectories in genuinely different ways, each giving different \
single histories that all average to the same master equation. We watch one \
driven, emitting atom three ways. Fix the atom, its drive, its decay channel, \
and the time grid:"
}], "Text",
 CellID->532797841,ExpressionUUID->"6cc64ef1-7b65-373d-14fe-67bb7e119a07"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalOmega]atom", " ", "=", " ", "3.0"}], ";", " ", 
  RowBox[{"\[Gamma]atom", " ", "=", " ", "1.0"}], ";", " ", 
  RowBox[{"Hdrive", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[CapitalOmega]atom", "/", "2"}], ")"}], " ", "X"}]}], ";", " ", 
  RowBox[{"cAtom", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "\[Gamma]atom", "]"}], " ", "lower"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dtAtom", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"when", " ", "=", " ", 
   RowBox[{"dtAtom", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "600"}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[145]:= ",
 CellID->827514810,ExpressionUUID->"542582fc-1c6f-cfd5-7dda-1ba6951b953f"],

Cell["\<\
Given a density matrix, define a function returning the excited-state \
population:\
\>", "Text",
 CellID->1310126569,ExpressionUUID->"7ad84463-32de-d6a2-2af8-5e4d4768bc88"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"excitedPop", "[", "rho_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{
       RowBox[{"blochVector", "[", "rho", "]"}], "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "/", "2"}]}], ";"}]], "Input",\

 CellLabel->"In[146]:= ",
 CellID->1253347759,ExpressionUUID->"3261459d-f728-27c9-621f-5cc682c28d13"],

Cell["\<\
Integrate the master equation for the population every unravelling must \
average back to:\
\>", "Text",
 CellID->1721654809,ExpressionUUID->"331c7f17-1677-2611-6124-7751a3038d7b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"smoothAtom", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{"Hdrive", ",", " ", 
     RowBox[{"{", "cAtom", "}"}], ",", " ", 
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "6.0"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"averageChance", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"excitedPop", "[", 
      RowBox[{"smoothAtom", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
    " ", "when"}]}], ";"}]}], "Input",
 CellLabel->"In[147]:= ",
 CellID->1835967532,ExpressionUUID->"14cbe893-f079-1a7f-3cc8-01dc810c6945"],

Cell["Counting the Flashes, One at a Time", "Subsection",
 CellID->965277466,ExpressionUUID->"3a1d5a8b-943b-deab-6a23-53d51dcfa4f1"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Any leak ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "355f53e5-dafb-cebc-6365-4acede8f9486"],
 " can be ",
 StyleBox["unravelled", "TI"],
 " by watching its output, each way of detecting the emitted light giving one \
unravelling into pure-state histories. Counting photons one click at a time \
gives the jump trajectory"
}], "Text",
 CellID->1405388586,ExpressionUUID->"492c649c-8337-646c-78d4-7dc636c24eb6"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     TemplateBox[{
       StyleBox["\[Psi]", "TI"]},
      "Ket"]}], "=", 
    RowBox[{
     RowBox[{"[", 
      RowBox[{
       StyleBox["d", "TI"], 
       StyleBox["N", "TI"], "(", 
       RowBox[{
        FractionBox[
         OverscriptBox[
          StyleBox["c", "TI"], "^"], 
         SqrtBox[
          RowBox[{
           StyleBox["\[LeftAngleBracket]",
            SpanMaxSize->1], 
           RowBox[{
            SuperscriptBox[
             OverscriptBox[
              StyleBox["c", "TI"], "^"], "\[Dagger]"], 
            OverscriptBox[
             StyleBox["c", "TI"], "^"]}], 
           StyleBox["\[RightAngleBracket]",
            SpanMaxSize->1]}]]], "-", "\|01d7d9"}], ")", "+", 
       StyleBox["d", "TI"], 
       StyleBox["t", "TI"], "(", 
       RowBox[{
        FractionBox[
         RowBox[{
          StyleBox["\[LeftAngleBracket]",
           SpanMaxSize->1], 
          RowBox[{
           SuperscriptBox[
            OverscriptBox[
             StyleBox["c", "TI"], "^"], "\[Dagger]"], 
           OverscriptBox[
            StyleBox["c", "TI"], "^"]}], 
          StyleBox["\[RightAngleBracket]",
           SpanMaxSize->1]}], "2"], "-", 
        FractionBox[
         RowBox[{
          SuperscriptBox[
           OverscriptBox[
            StyleBox["c", "TI"], "^"], "\[Dagger]"], 
          OverscriptBox[
           StyleBox["c", "TI"], "^"]}], "2"], "-", 
        StyleBox["i", "TI"], 
        OverscriptBox[
         StyleBox["H", "TI"], "^"]}], ")"}], "]"}], 
     TemplateBox[{
       StyleBox["\[Psi]", "TI"]},
      "Ket"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1630589325,ExpressionUUID->"1678747f-7a6a-a1d6-3e18-6e397f1cf33c"],

Cell[TextData[{
 "where the click ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["N", "TI"], "\[Element]", "{", "0"}], ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c54ceec-a669-4ede-046b-e7c9d31c1424"],
 " arrives at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "336f4c4f-cb14-5955-6115-6628eea12bbf"],
 ": between clicks the norm decays under the non-Hermitian ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "-", 
   FractionBox[
    StyleBox["i", "TI"], "2"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "192b8c2c-1b0f-3631-4f28-26769ebb9d1b"],
 ", and at a click the state jumps by ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["c", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2580083d-358c-3435-53bf-a267bc3e9f1f"],
 ". In continuous time, averaging ",
 Cell[BoxData[GridBox[{
    {
     RowBox[{
      StyleBox["\[Psi]", "TI"], "\[RightAngleBracket]", "\[LeftAngleBracket]", 
      StyleBox["\[Psi]", "TI"]}]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "477fde83-a5ae-c17e-6d04-d7eccc589044"],
 " over histories returns the master equation. The finite-step simulation \
below also carries Bernoulli time-discretization error, so its comparison \
contains both that bias and ensemble scatter."
}], "Text",
 CellID->446366569,ExpressionUUID->"0782fdeb-454d-5eca-2db1-f4b56cf82410"],

Cell[TextData[{
 "The first way, ",
 StyleBox["photon counting",
  FontWeight->"Bold"],
 ": detect each emitted photon. Between clicks the state evolves under the \
non-Hermitian ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "-", 
   FractionBox[
    StyleBox["i", "TI"], "2"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69a01936-08b2-60cf-1f5f-9170a9473215"],
 "; at each click it jumps by ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["c", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "553ebd3d-d82b-159a-7cc5-3566d9de7fe0"],
 " to the ground state. A single run is one sweep that does both jobs at \
once: ",
 Cell[BoxData["FoldList"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c0b44c7-b7b3-5c45-1409-5da0c24626af"],
 " advances and keeps the conditioned state at every step (a jump with \
probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dba914e-52ed-e087-7b59-09286699b2ed"],
 ", else the no-click drift), while ",
 Cell[BoxData["Sow"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "497e5609-e734-e246-7f06-485292c6b0ac"],
 " writes down the time whenever the jump fires. It returns the inferred \
state history and the raw click record together, because in a real experiment \
they are one run, not two. Everything that follows, one trajectory, the \
ensemble average, and the waiting-time statistic, reads off realizations of \
this single generator:"
}], "Text",
 CellID->1994518302,ExpressionUUID->"08c79fc2-e932-c645-38fc-16af88c4acaf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"countingRun", "[", 
    RowBox[{"seed_", ",", " ", "steps_"}], "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"noClick", " ", "=", " ", 
         RowBox[{"MatrixExp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", 
           RowBox[{"(", 
            RowBox[{"Hdrive", " ", "-", " ", 
             RowBox[{
              RowBox[{"I", "/", "2"}], " ", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "cAtom", "]"}], " ", ".", 
               " ", "cAtom"}]}]}], ")"}], " ", "dtAtom"}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", " ", "=", " ", 
           RowBox[{"Reap", "@", 
            RowBox[{"FoldList", "[", "\n", "         ", 
             RowBox[{
              RowBox[{"Function", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"psi", ",", " ", "n"}], "}"}], ",", "\n", 
                "          ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"RandomReal", "[", "]"}], " ", "<", " ", 
                   RowBox[{"dtAtom", " ", 
                    RowBox[{"Re", "[", 
                    RowBox[{
                    RowBox[{"Conjugate", "[", 
                    RowBox[{"cAtom", " ", ".", " ", "psi"}], "]"}], " ", ".", 
                    " ", 
                    RowBox[{"(", 
                    RowBox[{"cAtom", " ", ".", " ", "psi"}], ")"}]}], 
                    "]"}]}]}], ",", "\n", "            ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Sow", "[", 
                    RowBox[{"n", " ", "dtAtom"}], "]"}], ";", " ", 
                    RowBox[{"Normalize", "[", 
                    RowBox[{"cAtom", " ", ".", " ", "psi"}], "]"}]}], ")"}], ",",
                   "\n", "            ", 
                  RowBox[{"Normalize", "[", 
                   RowBox[{"noClick", " ", ".", " ", "psi"}], "]"}]}], 
                 "]"}]}], "]"}], ",", "\n", "         ", "excited", ",", " ", 
              
              RowBox[{"Range", "[", "steps", "]"}]}], "]"}]}]}], "}"}], ",", 
         "\n", "     ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<states\>\"", " ", "->", " ", 
            RowBox[{"First", "[", "r", "]"}]}], ",", " ", 
           RowBox[{"\"\<clicks\>\"", " ", "->", " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Last", "[", "r", "]"}], "]"}]}]}], "|>"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[148]:= ",
 CellID->1562654637,ExpressionUUID->"2184153d-b162-7859-57bb-8d66c0174aa3"],

Cell["The same population, read from a state vector:", "Text",
 CellID->1372112522,ExpressionUUID->"2402dcb3-2cfa-7570-4c31-d5fd448f5c5a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"excitedPopK", "[", "psi_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{"Re", "[", 
       RowBox[{
        RowBox[{"Conjugate", "[", "psi", "]"}], " ", ".", " ", "Z", " ", ".", 
        " ", "psi"}], "]"}]}], ")"}], "/", "2"}]}], ";"}]], "Input",
 CellLabel->"In[149]:= ",
 CellID->638348404,ExpressionUUID->"554ef748-00c8-cf17-0375-ef12b162927d"],

Cell["\<\
Record one counted history over the displayed window, and read its two parts, \
the conditioned states and the click times, straight off the one run:\
\>", "Text",
 CellID->907289993,ExpressionUUID->"40bb2fe5-4c06-79cb-7058-c6cf65b34b11"],

Cell[BoxData[
 RowBox[{
  RowBox[{"oneRun", " ", "=", " ", 
   RowBox[{"countingRun", "[", 
    RowBox[{"3", ",", " ", "600"}], "]"}]}], ";", " ", 
  RowBox[{"oneCount", " ", "=", " ", 
   RowBox[{"oneRun", "[", "\"\<states\>\"", "]"}]}], ";", " ", 
  RowBox[{"oneClicks", " ", "=", " ", 
   RowBox[{"oneRun", "[", "\"\<clicks\>\"", "]"}]}], ";"}]], "Input",
 CellLabel->"In[150]:= ",
 CellID->1480220716,ExpressionUUID->"7ee2421b-c68a-4a96-2692-6444f33f18fc"],

Cell["\<\
Now visualize one counted trajectory's excited-state population against the \
master equation: the trajectory drives up and down and plunges at each \
emission, while the average remains smooth:\
\>", "Text",
 CellID->1004075994,ExpressionUUID->"79971006-243c-6fe2-2fac-8a604dc935c8"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{"excitedPopK", " ", "/@", " ", "oneCount"}]}], "}"}], "]"}], ",",
      " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", "averageChance"}], "}"}], "]"}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "Red", ",", " ", "Dashed"}], "]"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<one trajectory (jumps)\>\"", ",", 
      " ", "\"\<master equation\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<excited-state population\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<photon counting: one trajectory jumps, the average is \
smooth\>\""}]}], "]"}]], "Input",
 CellLabel->"In[151]:= ",
 CellID->592936352,ExpressionUUID->"61109047-93e0-1377-172f-0a2125957e5d"],

Cell["\<\
The plunges are the emitted photons, one at a time. No single run is smooth; \
smoothness is in the average.\
\>", "Text",
 CellID->792862978,ExpressionUUID->"341c784b-10c0-0bab-5c24-7215a17559f1"],

Cell[TextData[{
 "The plot shows the inferred ",
 StyleBox["state", "TI"],
 "; the same run also carries the ",
 StyleBox["record", "TI"],
 ", the list of click times a photon counter actually writes down, already \
returned as ",
 Cell[BoxData[
  RowBox[{"oneRun", "[", "\"\<clicks\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4125a490-d89a-105a-70da-3dddd92f62a0"],
 " and bound to ",
 Cell[BoxData["oneClicks"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b67f461-4283-7871-391c-ee4b77364b5b"],
 " above. Every plunge is one entry in it, because the jump that plunges the \
state is the very step that sowed the time. Count the clicks in this record:"
}], "Text",
 CellID->573477382,ExpressionUUID->"79999c45-ea42-0b46-2fa6-162e8ff759ac"],

Cell[BoxData[
 RowBox[{"Length", "[", "oneClicks", "]"}]], "Input",
 CellLabel->"In[152]:= ",
 CellID->2124988169,ExpressionUUID->"5fae9c0a-8a55-fd6e-0555-16542fe1c7b4"],

Cell[TextData[{
 "A handful of photons over the run. Now put the record and the state on one \
time axis with two vertical scales: the conditioned population on the left, \
each click marked by a red line, and the cumulative count ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ae1fb24-4e58-6c4d-4a9e-f28e6bed3697"],
 " on the right, a staircase that rises by one at every click:"
}], "Text",
 CellID->534961831,ExpressionUUID->"0a4afb14-05e6-4298-3a49-f35eb39310e2"],

Cell[BoxData[
 RowBox[{"Legended", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Labeled", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"when", ",", " ", 
            RowBox[{"excitedPopK", " ", "/@", " ", "oneCount"}]}], "}"}], 
          "]"}], ",", "\n", "     ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Riffle", "[", 
             RowBox[{"oneClicks", ",", " ", "oneClicks"}], "]"}], ",", " ", 
            RowBox[{"Riffle", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Range", "@", 
                RowBox[{"Length", "@", "oneClicks"}]}], " ", "-", " ", "1"}], 
              ",", " ", 
              RowBox[{"Range", "@", 
               RowBox[{"Length", "@", "oneClicks"}]}]}], "]"}]}], "}"}], 
          "]"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"MultiaxisArrangement", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "   ", 
       RowBox[{"GridLines", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", " ", "Red"}], "}"}], " ", "&"}], " ", "/@", 
           " ", "oneClicks"}], ",", " ", "None"}], "}"}]}]}], "]"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Rotate", "[", 
        RowBox[{"\"\<excited population\>\"", ",", " ", 
         RowBox[{"90", " ", "Degree"}]}], "]"}], ",", " ", 
       RowBox[{"Rotate", "[", 
        RowBox[{"\"\<cumulative count N(t)\>\"", ",", " ", 
         RowBox[{"270", " ", "Degree"}]}], "]"}], ",", " ", "\"\<time\>\"", ",",
        "\n", "   ", "\"\<clicks (red lines) fall at the population plunges; \
the staircase counts them\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "Left", ",", " ", "Right", ",", " ", "Bottom", ",", " ", "Top"}], 
      "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"LineLegend", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ColorData", "[", 
        RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
       RowBox[{"ColorData", "[", 
        RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<excited population\>\"", ",", 
       " ", "\"\<cumulative count N(t)\>\""}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[153]:= ",
 CellID->998016997,ExpressionUUID->"1a681de3-120d-8f0a-4a17-94cda7b9d250"],

Cell["\<\
Every red line sits on a plunge: the click is the emission, and the plunge is \
the state collapsing to the ground state the instant the photon is \
registered. The staircase (right scale) is the raw experimental data; the \
population trajectory (left scale) is what the theorist infers from it.\
\>", "Text",
 CellID->1107607024,ExpressionUUID->"7fe8910c-2477-6bad-2597-09564d0239f7"],

Cell["\<\
Now run an ensemble of these same trajectories, carried well past the display \
window so each click record is long enough for the timing statistic below; \
our single run above is seed 3 of this same generator, the ensemble's third \
member seen over just the plotted window:\
\>", "Text",
 CellID->1668318198,ExpressionUUID->"4724aa69-80a2-605c-6edb-4c33315732a6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nCount", " ", "=", " ", "200"}], ";", " ", 
  RowBox[{"nWaitSteps", " ", "=", " ", "4000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"countRuns", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"countingRun", "[", 
      RowBox[{"#", ",", " ", "nWaitSteps"}], "]"}], " ", "&"}], " ", "/@", 
    " ", 
    RowBox[{"Range", "[", "nCount", "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[154]:= ",
 CellID->1044073123,ExpressionUUID->"7db6e0a3-5ee4-0113-2b4d-f90d5a915079"],

Cell["\<\
Averaging the conditioned states across the ensemble must recover the master \
equation. Compare the ensemble-mean excited population, over the displayed \
window, against the integrated reference:\
\>", "Text",
 CellID->1281286378,ExpressionUUID->"64959d98-6722-362c-0caa-14c212d49d76"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"excitedPop", " ", "/@", " ", 
      RowBox[{"Mean", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"densityMatrix", " ", "/@", " ", 
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"countRuns", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<states\>\"", "]"}], ",",
             " ", 
            RowBox[{"Length", "[", "when", "]"}]}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "nCount"}], "}"}]}], "]"}], "]"}]}], ")"}], 
    " ", "-", " ", "averageChance"}], "]"}]}]], "Input",
 CellLabel->"In[155]:= ",
 CellID->2002157654,ExpressionUUID->"5f8c04ec-8c47-4bdf-05b3-9db625f21925"],

Cell[TextData[{
 "At fixed ",
 Cell[BoxData["dtAtom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023e8ab0-46e5-584b-33c5-23fa72902a91"],
 ", the sampling component of the gap shrinks as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a0eac86-50d0-15df-0a35-45e061657f25"],
 "; the residual time-step bias requires refinement of ",
 Cell[BoxData["dtAtom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58394c25-48c8-3ecd-09c7-658f69628417"],
 ". Together those limits recover the master equation."
}], "Text",
 CellID->822148062,ExpressionUUID->"1424a2b0-695c-dfcb-3ddb-3bfa08eea511"],

Cell[TextData[{
 "The click record carries a statistic no smooth curve can: the distribution \
of ",
 StyleBox["waiting times", "TI"],
 " between clicks. A click leaves the atom in ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05101942-3b9c-ad10-332f-912cbe2ef47a"],
 ", so the time ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35394d45-77a0-03f4-5cc7-652f025551de"],
 " to the next click has the density"
}], "Text",
 CellID->837975234,ExpressionUUID->"3f9454e1-244e-40e6-65ac-4dcb4dfb12cc"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["w", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Tau]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["\[Psi]", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Tau]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", 
     RowBox[{
      SuperscriptBox[
       OverscriptBox[
        StyleBox["c", "TI"], "^"], "\[Dagger]"], 
      OverscriptBox[
       StyleBox["c", "TI"], "^"], "\[ThinSpace]", 
      StyleBox["\[Psi]", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Tau]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["\[Tau]", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Ket"], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["H", "TI"], "^"], 
        StyleBox["eff",
         FontSlant->"Plain"]], 
       StyleBox["\[Tau]", "TI"]}]], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"]}]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["H", "TI"], "^"], 
     StyleBox["eff",
      FontSlant->"Plain"]], "=", 
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], "-", 
     RowBox[{
      FractionBox[
       StyleBox["i", "TI"], "2"], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["c", "TI"], "^"], "\[Dagger]"], 
      OverscriptBox[
       StyleBox["c", "TI"], "^"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2104272152,ExpressionUUID->"530b93a6-4244-79d7-0108-0a0077f14b3d"],

Cell[TextData[{
 "the unnormalized no-click state evolved from the ground state. Since it \
starts in ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c785ed8-c9e5-405c-7418-5785ef9012a6"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Gamma]", "TI"], 
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{
         StyleBox["e", "TI"], 
         StyleBox["g", "TI"]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", "0"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a66b72e-8103-1d0f-3a1d-2e8830b66455"],
 ": the atom cannot emit twice at once, it must be re-driven to the excited \
state first, so very short gaps are forbidden. This is antibunching. Read the \
density directly off the no-click evolution:"
}], "Text",
 CellID->39229099,ExpressionUUID->"6206b938-b2f8-72db-123d-3165c68d4021"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"waitDensity", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"psi", " ", "=", " ", 
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{"Hdrive", " ", "-", " ", 
            RowBox[{
             RowBox[{"I", "/", "2"}], " ", 
             RowBox[{
              RowBox[{"ConjugateTranspose", "[", "cAtom", "]"}], " ", ".", 
              " ", "cAtom"}]}]}], ")"}], " ", "t"}], "]"}], " ", ".", " ", 
        "ground"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Re", "[", 
      RowBox[{
       RowBox[{"Conjugate", "[", "psi", "]"}], " ", ".", " ", 
       RowBox[{"ConjugateTranspose", "[", "cAtom", "]"}], " ", ".", " ", 
       "cAtom", " ", ".", " ", "psi"}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[156]:= ",
 CellID->538455469,ExpressionUUID->"7a01a055-721a-3362-2a3e-3a1f07ac9e48"],

Cell[TextData[{
 "No separate simulation is needed. Because every click resets the atom \
exactly to ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "425e231b-d90e-d650-7265-bb44d8b8bcba"],
 ", the gap between two consecutive clicks in any trajectory is already a \
draw from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f4b19d7-d2e6-1d55-1548-9090e69367bf"],
 ": it begins where ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "266a3a12-a29b-0b72-4e69-bc5fd72e5658"],
 " begins. Pool those gaps straight from the ensemble's click records, one \
set of differences per run (the leading interval, which starts from the \
excited state rather than from ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b97aeb9-f3a3-063a-49ac-47e286566d00"],
 ", drops out on its own, since a difference needs two clicks):"
}], "Text",
 CellID->266517012,ExpressionUUID->"670ec096-5157-8cf5-0d35-d9d060e3d6df"],

Cell[BoxData[
 RowBox[{
  RowBox[{"waitTimes", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Differences", "[", 
       RowBox[{"#", "[", "\"\<clicks\>\"", "]"}], "]"}], " ", "&"}], " ", "/@",
      " ", "countRuns"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[157]:= ",
 CellID->1190814367,ExpressionUUID->"4a46f8a5-a076-b8c1-7a7d-f10ed1000a2b"],

Cell["Overlay their histogram on the closed form:", "Text",
 CellID->1899183568,ExpressionUUID->"7b9d6462-a0fd-67c7-29a3-7e4fd0884d2d"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Histogram", "[", 
    RowBox[{"waitTimes", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "6", ",", " ", "0.2"}], "}"}], ",", 
     " ", "\"\<PDF\>\"", ",", " ", 
     RowBox[{"ChartStyle", " ", "->", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"waitDensity", "[", "t", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "6"}], "}"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "Red"}], "]"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<waiting time between clicks\>\"", ",", 
      " ", "\"\<density\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the trajectory's own inter-click gaps land on the closed-form \
density\>\""}]}], "]"}]], "Input",
 CellLabel->"In[158]:= ",
 CellID->839992789,ExpressionUUID->"5c567373-a618-e547-046e-6b3cd392cfad"],

Cell["\<\
The bars land on the closed-form density: it vanishes at zero (no two clicks \
at once), rises to a first hump near half a Rabi period, then oscillates and \
decays, the re-driven atom's Rabi cycle written into the timing of the \
clicks. This antibunching is the hallmark of single-photon (nonclassical) \
light, and it lives entirely in the click timing, invisible in the smooth \
population.\
\>", "Text",
 CellID->1909137676,ExpressionUUID->"5028993e-6f44-360e-01d7-11780af69d54"],

Cell["Homodyne: Reading One Quadrature", "Subsection",
 CellID->2000873505,ExpressionUUID->"05297336-3344-a7f5-2cd7-6b7046f60ddf"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Mixing the output with a strong reference beam before detecting it \
(homodyne) turns the clicks into a continuous noisy current and gives a ",
 StyleBox["diffusive", "TI"],
 " stochastic master equation"
}], "Text",
 CellID->1091748765,ExpressionUUID->"75fa11b5-921a-0030-2399-88ff27af531a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->232863170,ExpressionUUID->"2d27580a-3980-0923-54dd-5254b8355809"],

Cell[TextData[{
 "with a real Wiener increment ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "077289f0-6175-2cad-2d01-20ba100076f7"],
 " (",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["W", "TI"], "2"], "=", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "133b68ba-8b92-4fbc-42d8-81e42e271586"],
 "). The conditioned state now diffuses continuously instead of jumping: \
starting pure in the ideal example here it stays pure, and a mixed initial \
state would purify. The point of this section is the bookkeeping: what a \
single run gives us, which quantities are ",
 StyleBox["observed", "TI"],
 " and which are ",
 StyleBox["inferred", "TI"],
 ", and how every homodyne object is one of those two or is built from them."
}], "Text",
 CellID->1876092091,ExpressionUUID->"6db49e4d-4459-39d0-1b4b-10176ded8b3a"],

Cell[TextData[{
 "The second way, ",
 StyleBox["homodyne",
  FontWeight->"Bold"],
 " detection: mix the output with a strong reference beam and measure one \
quadrature as a continuous noisy current. Run one homodyne trajectory of the \
same atom:"
}], "Text",
 CellID->652142632,ExpressionUUID->"01e45bb6-31a6-d4bb-379c-52f04050be81"],

Cell[BoxData[
 RowBox[{
  RowBox[{"smoothHistory", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "Hdrive", ",", 
     " ", 
     RowBox[{"{", "cAtom", "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "dtAtom", ",", " ", "6.0", ",", " ", "3"}],
     "]"}]}], ";"}]], "Input",
 CellLabel->"In[159]:= ",
 CellID->330963574,ExpressionUUID->"638a875f-059e-01af-1189-1f19ac2b53f5"],

Cell[TextData[{
 Cell[BoxData["trajectory"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b1c9c05-9360-5fc6-6923-166f2615252c"],
 " hands back exactly two things, and everything else on this page is one of \
them or is computed from them. The ",
 StyleBox["conditional state",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["c", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d8f8704-dbc1-ad9f-5bb4-1f61de75f7e5"],
 " at each time node (",
 Cell[BoxData[
  RowBox[{"smoothHistory", "[", "\"\<states\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bacb1bf-0091-7884-2953-28f9b1244aee"],
 ") is the observer's running estimate of the atom given the record so far. \
The ",
 StyleBox["record increment",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e949b39-c960-dcff-16ab-1362e81aa6c5"],
 " at each step (",
 Cell[BoxData[
  RowBox[{"smoothHistory", "[", "\"\<record\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52d3365b-85bc-1911-02e0-a8052c49687b"],
 ") is the raw output of the detector. The model tying them is"
}], "Text",
 CellID->1389046362,ExpressionUUID->"058c1579-2127-d4ed-33b3-8d2350d3be37"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["J", "TI"], "=", 
    SqrtBox[
     StyleBox["\[Gamma]", "TI"]], "\[ThinSpace]", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["x", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1332526183,ExpressionUUID->"4f55ae27-0b76-e8ec-756a-4781ae00ba36"],

Cell[TextData[{
 "the signal read from ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62fbf51e-f93c-ccd0-1298-ed5bf8ce963a"],
 ", the noise ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "011d018b-0453-500f-3722-98d5ade62355"],
 " a Wiener increment. Hold the two apart: ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b868176-6936-78c0-49bd-193008c34a2a"],
 " is ",
 StyleBox["observed",
  FontWeight->"Bold"],
 ", and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "317554d9-f61a-a01f-670b-4d8283acf365"],
 " is ",
 StyleBox["inferred",
  FontWeight->"Bold"],
 ", reconstructed from ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "581509a3-40d5-fdc4-082a-a00d7161c72e"],
 " by the filter (the positivity step from the toolkit)."
}], "Text",
 CellID->197217751,ExpressionUUID->"27a46d13-c303-51d0-4d5b-855cf6b6233a"],

Cell["\<\
Take the conditional state first. Its excited population is one smooth \
diffusing history, no jumps:\
\>", "Text",
 CellID->880034747,ExpressionUUID->"17c64253-a2be-52b9-3dfe-641cd74b2083"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{"excitedPop", " ", "/@", " ", 
         RowBox[{"smoothHistory", "[", "\"\<states\>\"", "]"}]}]}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", "averageChance"}], "}"}], "]"}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "Red", ",", " ", "Dashed"}], "]"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<one conditional history\>\"", ",", 
      " ", "\"\<master equation\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<excited-state population\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the conditional state diffuses smoothly, no jumps\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[160]:= ",
 CellID->1800574979,ExpressionUUID->"5a34ce21-af18-53d3-0bcb-e78acaad2139"],

Cell[TextData[{
 "Smooth diffusion, not the plunges of a counted trajectory, yet averaging \
many conditional states recovers the same master equation. Hand the ensemble \
to the toolkit's ",
 Cell[BoxData["gapDiagnosis"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1308debe-b866-1363-4137-d7f839137e49"],
 ", which averages the trajectories, compares the mean to the master \
equation, and splits sampling scatter from step bias in one call:"
}], "Text",
 CellID->1078219960,ExpressionUUID->"339fc10a-19b9-5d82-61a4-d954984c27e8"],

Cell[BoxData[
 RowBox[{"gapDiagnosis", "[", 
  RowBox[{
   RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "Hdrive", ",", 
   " ", 
   RowBox[{"{", "cAtom", "}"}], ",", " ", 
   RowBox[{"{", "1.", "}"}], ",", " ", 
   RowBox[{"{", "}"}], ",", " ", "dtAtom", ",", " ", "6.0", ",", " ", "150"}],
   "]"}]], "Input",
 CellLabel->"In[161]:= ",
 CellID->2033801793,ExpressionUUID->"442b12f5-789a-53e1-6c28-8bbf792f21cb"],

Cell["\<\
The ensemble gap sits inside the sampling scatter it reports, so the \
systematic remainder is zero and the per-step bias beside it is negligible: \
at this step and this many trajectories the record-conditioned states average \
to the unconditioned master equation within Monte-Carlo noise, and the \
verdict says it is more trajectories, not a finer step, that would tighten \
the agreement.\
\>", "Text",
 CellID->1670899349,ExpressionUUID->"39387274-e40a-435c-68d8-74318dbf11a6"],

Cell["\<\
Now the record itself, and the four quantities read from it, each labeled by \
how it is obtained and whether it is observed or inferred.\
\>", "Text",
 CellID->975439503,ExpressionUUID->"70ecc98e-c53f-f68b-2093-e0ebeccbdcd1"],

Cell[TextData[{
 StyleBox["The record increment ",
  FontWeight->"Bold"],
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"53e7ddcf-0b8d-05e4-019c-d4a9ae386fce"],
 " (observed). ",
 StyleBox["How obtained:", "TI"],
 " the detector's output each step, here generated together with the state. \
",
 StyleBox["Status:", "TI"],
 " observed, the one thing that enters from the world; everything else is \
downstream of it. Plot it:"
}], "Text",
 CellID->351741581,ExpressionUUID->"1a830965-7851-22cf-4ab0-a14f79e47015"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dJ", " ", "=", " ", 
   RowBox[{"Flatten", "@", 
    RowBox[{"smoothHistory", "[", "\"\<record\>\"", "]"}]}]}], ";"}]], "Input",\

 CellLabel->"In[162]:= ",
 CellID->984679481,ExpressionUUID->"47763c58-6b8c-f19b-6d0d-b6020e3ec3e1"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Most", "@", "when"}], ",", " ", "dJ"}], "}"}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<record increment  dJ\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<dJ, the observed record: almost pure noise per step\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[163]:= ",
 CellID->412548195,ExpressionUUID->"2411395d-4500-dc0b-4c2e-b1076cbaa751"],

Cell[TextData[{
 "It looks like noise because it is almost all noise: per step the signal ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "\[TildeTilde]", "0.005"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51798d79-74e7-e8a1-0706-25237c93ba8b"],
 " sits under a ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e7478e0-34bc-b2ae-360c-71cabd4e00f4"],
 " of size ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox[
     RowBox[{"d", "t"}], "TI"]], "=", "0.1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa139-5ae3-ed74-4004-39635e97b45e"],
 ", twenty times larger. A single increment carries almost no information \
about the atom."
}], "Text",
 CellID->167190678,ExpressionUUID->"0084d900-0120-94d6-30bb-d16ab0dafe3c"],

Cell[TextData[{
 StyleBox["The integrated record ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubsuperscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"]], 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"45e3bdb3-b7b8-8152-7390-34fcc232d3b8"],
 " (observed). ",
 StyleBox["How obtained:", "TI"],
 " sum the observed increments. ",
 StyleBox["Status:", "TI"],
 " observed, the same data accumulated. It is built from three running \
arrays. First the inferred signal ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e5e1e6c-8075-0eb3-0665-903631005499"],
 ", read off each conditional state (it gets its own panel below):"
}], "Text",
 CellID->132154406,ExpressionUUID->"3b122816-0897-a47c-6921-c250a9230f46"],

Cell[BoxData[
 RowBox[{
  RowBox[{"signal", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "\[Gamma]atom", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"blochVector", "[", "#", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"Most", "[", 
       RowBox[{"smoothHistory", "[", "\"\<states\>\"", "]"}], "]"}]}], 
     ")"}]}]}], ";"}]], "Input",
 CellLabel->"In[164]:= ",
 CellID->1448639745,ExpressionUUID->"12228eb7-81d1-9f6b-43d1-27f13065e5b1"],

Cell["\<\
The integrated record itself, the running sum of the observed increments:\
\>", "Text",
 CellID->1881657070,ExpressionUUID->"0c4e3d89-d3d8-0dbe-3475-b4d2e66d5784"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Jt", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", "dJ", "]"}], ",", " ", "0."}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[165]:= ",
 CellID->1506900826,ExpressionUUID->"44dcab5a-698d-607d-6ce3-430408383347"],

Cell["and its drift, the inferred signal accumulated the same way:", "Text",
 CellID->637363640,ExpressionUUID->"268a9802-0d7f-2bfd-4e89-126ca40a79c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"driftJ", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", 
      RowBox[{"signal", " ", "dtAtom"}], "]"}], ",", " ", "0."}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[166]:= ",
 CellID->658697144,ExpressionUUID->"79bc5755-bb31-5780-2f44-4f1f3ec43dea"],

Cell["Plot the record against its drift:", "Text",
 CellID->462592558,ExpressionUUID->"0ff00406-ec89-251c-358f-9e63853d8c66"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", "Jt"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", "driftJ"}], "}"}], "]"}]}], "}"}], ",", "\n",
    " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<integrated record  J(t)\>\"", ",", 
      " ", "\"\<inferred drift  \[Integral]signal dt\>\""}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<integrated record  J(t)\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the observed record integrates to a drifting path; its drift is \
the signal\>\""}]}], "]"}]], "Input",
 CellLabel->"In[167]:= ",
 CellID->621689956,ExpressionUUID->"7d6791a5-5599-4f2a-2b1c-080f5c2c1270"],

Cell[TextData[{
 "Integrating is itself a filter: the signal accumulates coherently into a \
drift while the noise only grows as ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c7441be-5925-9c2b-240c-58f858d1e771"],
 ", so in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ff4eb8a-8686-c1c6-058b-02d43330932c"],
 " the signal is comparable to the noise instead of twenty times below it. \
This is the honest, window-free picture of the data. (The ",
 Cell[BoxData["signal"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "049abcb6-c083-4b47-2cb9-35f3f13619ad"],
 " used for the drift is inferred, and gets its own panel below.)"
}], "Text",
 CellID->912512294,ExpressionUUID->"00908b6d-9173-71f0-30af-2337200643da"],

Cell[TextData[{
 StyleBox["The current ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"0c438d61-2567-fb5f-3470-254b4c13c9a5"],
 " (observed, singular). ",
 StyleBox["How obtained:", "TI"],
 " divide the observed increment by ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3129044e-2557-7c3e-60d6-9e284ce24704"],
 ". ",
 StyleBox["Status:", "TI"],
 " observed but not a proper quantity: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "=", 
   StyleBox["signal",
    FontSlant->"Plain"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "185e1b20-c9fe-9997-4865-928def88ebfd"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79986dc0-6b5a-b4b1-2fa7-84aa0eec1e9b"],
 " is white noise of variance ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66994d41-411f-db5d-0ea7-652b70aba9a7"],
 ", which diverges as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ba5d17e-cdbf-5380-095a-c93be44a21ea"],
 ". On the grid it is a ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1", "/", 
   SqrtBox[
    StyleBox[
     RowBox[{"d", "t"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4459b86e-fafc-12f5-6c66-324bfe8960df"],
 " band around a ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bcb2561-df35-3b41-39c8-bd4adac189ab"],
 " signal:"
}], "Text",
 CellID->159314101,ExpressionUUID->"2cdc7c52-f996-171f-54e4-761ff8237a65"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Most", "@", "when"}], ",", " ", 
      RowBox[{"dJ", "/", "dtAtom"}]}], "}"}], "]"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<current  dJ/dt\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the current dJ/dt: a white-noise band with no dt\[Rule]0 \
limit\>\""}]}], "]"}]], "Input",
 CellLabel->"In[168]:= ",
 CellID->2072053663,ExpressionUUID->"6a04a347-6624-93dc-1a3b-3b2113d6e126"],

Cell[TextData[{
 "There is no current ",
 StyleBox["curve", "TI"],
 ". The instantaneous homodyne current is a distribution, not a function, \
which is why any smooth current needs an arbitrary averaging window and why \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fa3b0bf-db30-02a1-4550-29f8dec5508b"],
 " above is the cleaner observed object."
}], "Text",
 CellID->1700462496,ExpressionUUID->"11dd9886-a103-697c-47e2-11e3d0b63846"],

Cell[TextData[{
 StyleBox["The signal ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"5d16072b-4094-e7d7-0b2d-9f757126cd3d"],
 " (inferred). ",
 StyleBox["How obtained:", "TI"],
 " read off the conditional state. ",
 StyleBox["Status:", "TI"],
 " inferred, the conditional mean of the current, never measured directly. \
This is the clean thing buried in the record:"
}], "Text",
 CellID->758245071,ExpressionUUID->"6e71c00a-9fc6-07cd-160e-da541a736d17"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Most", "@", "when"}], ",", " ", "signal"}], "}"}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<signal  Sqrt[gamma] <sigma_x>\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the signal, inferred from the conditional state, not measured\>\
\""}]}], "]"}]], "Input",
 CellLabel->"In[169]:= ",
 CellID->645457834,ExpressionUUID->"59da3beb-dbdf-0123-0ff9-b2b4de6a5009"],

Cell[TextData[{
 "No detector emits this curve. It is what the filter reconstructs, smooth \
because the conditional state is smooth, and it is the conditional drift \
about which the observed ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28f3c6b4-96e3-425b-5880-dffe229610a1"],
 " fluctuates."
}], "Text",
 CellID->1053805191,ExpressionUUID->"50dcf632-b06e-d3ec-00e3-e87fc118a136"],

Cell[TextData[{
 StyleBox["The innovation ",
  FontWeight->"Bold"],
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"0192d3b7-44a5-149f-37a1-caf16d507ee5"],
 " (inferred). ",
 StyleBox["How obtained:", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"], "=", 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "-", 
   StyleBox["signal",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0300f609-8c78-c232-313f-e85325f29118"],
 ", the observed increment minus the inferred prediction. ",
 StyleBox["Status:", "TI"],
 " inferred, a residual, not a second measurement. Form the residual:"
}], "Text",
 CellID->1335228883,ExpressionUUID->"366efd8d-b3b0-5f87-5e15-f4d6c64525ed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dW", " ", "=", " ", 
   RowBox[{"dJ", " ", "-", " ", 
    RowBox[{"signal", " ", "dtAtom"}]}]}], ";"}]], "Input",
 CellLabel->"In[170]:= ",
 CellID->17162129,ExpressionUUID->"3db21443-28a2-09d2-6b41-8e2d49575b38"],

Cell["and plot it:", "Text",
 CellID->745178489,ExpressionUUID->"2bbb6266-506e-8b43-5958-84406118d9a9"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Most", "@", "when"}], ",", " ", "dW"}], "}"}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<innovation  dW\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the innovation dW = dJ - signal dt: the residual\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[171]:= ",
 CellID->64377810,ExpressionUUID->"6e86e78b-e825-43de-16bd-fed489d01124"],

Cell[TextData[{
 "If the filter is optimal, the residual is zero-mean white noise. Check its \
autocorrelation, with the ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "2", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00acb0de-f92e-37b6-3053-299bf8d89d9c"],
 " band white noise would sit inside:"
}], "Text",
 CellID->1276099438,ExpressionUUID->"688c2685-a509-dc5c-18b3-bfeeccbda6a6"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"innov", " ", "=", " ", 
      RowBox[{"dW", "/", 
       RowBox[{"Sqrt", "[", "dtAtom", "]"}]}]}], ",", " ", 
     RowBox[{"ci", " ", "=", " ", 
      RowBox[{"2", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Length", "[", "dW", "]"}], "]"}]}]}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"CorrelationFunction", "[", 
      RowBox[{"innov", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "10"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Filling", " ", "->", " ", "Axis"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.2"}], ",", " ", "0.2"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ci", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "ci"}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}]}], "}"}]}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<lag\>\"", ",", 
        " ", "\"\<innovation autocorrelation\>\""}], "}"}]}], ",", " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<the innovation is white within confidence limits\>\""}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[172]:= ",
 CellID->1651008988,ExpressionUUID->"2ceaa2e1-4528-9e89-54e9-3bcb6cc2e4d3"],

Cell["\<\
Every nonzero lag sits in the band: the filter has extracted every \
predictable part of the record, and what remains is irreducible measurement \
noise. This whiteness is the diffusive counterpart of the counting record's \
antibunched clicks, and the same optimal-filter signature the Kalman tracker \
will show.\
\>", "Text",
 CellID->807143410,ExpressionUUID->"1303f7c9-9cc9-b37e-4130-ee93157d1e44"],

Cell[TextData[{
 "So the section is one ledger. A single observed record ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ec53290-e027-d466-56fa-abdd91d3bf4c"],
 " (equivalently its integral ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18ec055d-da13-7d9a-4893-9d06dfa647e0"],
 ") enters from the world; from it the conditional state, the signal, and the \
innovation ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "210c0b92-bdf5-0dca-5733-a2dc3b805710"],
 " are all computed. Only ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08a8ae1a-48d1-1e8c-3857-4044696464d6"],
 " is data. Everything that looks like the atom, the smooth population, the \
signal curve, is inferred from it."
}], "Text",
 CellID->2004841178,ExpressionUUID->"5a42a6f1-18c8-51d7-0a71-3fbb997d233d"],

Cell["Heterodyne: Reading Both Quadratures", "Subsection",
 CellID->680262370,ExpressionUUID->"151d482b-bd7d-21e9-4323-627534087333"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Reading ",
 StyleBox["both", "TI"],
 " shadows at once (heterodyne) splits the one monitored leak into two \
half-strength homodyne channels a quarter-turn apart, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["I", "TI"]], "=", 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5613a8b7-1620-2919-7e20-41f1a3d57863"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["Q", "TI"]], "=", 
   StyleBox["i", "TI"], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ae8fe52-8d2a-0d13-0a97-f01c24df5479"],
 ", each read as its own real current:"
}], "Text",
 CellID->2074260939,ExpressionUUID->"3b9a61ac-db6f-0823-69ba-7809de1a5b09"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     StyleBox["I", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["I", "TI"]], "+", "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     StyleBox["Q", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["Q", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     SubsuperscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["I", "TI"], "2"]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["d", "TI"], 
      SubsuperscriptBox[
       StyleBox["W", "TI"], 
       StyleBox["Q", "TI"], "2"]}], "=", 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["I", "TI"]], "\[ThinSpace]", 
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["Q", "TI"]]}], "=", 
    RowBox[{"0", "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1484886568,ExpressionUUID->"1ebbb135-9363-cdcb-4658-297f26179711"],

Cell[TextData[{
 "It is one point in a whole ",
 StyleBox["general-dyne", "TI"],
 " family running from one sharp shadow (homodyne) to two blurry ones, every \
member averaging to the identical master equation while giving genuinely \
different single histories. Show that the two channels reproduce the one \
leak, then watch."
}], "Text",
 CellID->1547996435,ExpressionUUID->"3fac2774-ed95-ff32-6553-bf318421c218"],

Cell[TextData[{
 "The third way, ",
 StyleBox["heterodyne",
  FontWeight->"Bold"],
 ": measure both quadratures at once. It is equivalent to two half-strength \
homodyne channels a quarter-turn apart, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e0bfcd9-47ee-c5d1-2608-f5837198af3b"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bce04d4-edb5-1ec8-29f5-9d9184406412"],
 ". First prove those two dissipators sum to the original, for any ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["c", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04eac529-5321-5efa-2ce9-dd7366d424c0"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "121d8e7a-a943-ef24-4222-2027c8f7b20e"],
 ":"
}], "Text",
 CellID->1622616291,ExpressionUUID->"3f53e49d-d2a9-b4ee-6560-fdc6e75d1e34"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\[FormalC]", ",", " ", "##"}], "]"}], " ", "&"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], ",", "\n", "   ", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\[FormalR]", ",", " ", "##"}], "]"}], " ", "&"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
    "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"dissipator", "[", 
       RowBox[{
        RowBox[{"c", "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", "r"}], "]"}], " ", "+", 
      " ", 
      RowBox[{"dissipator", "[", 
       RowBox[{
        RowBox[{"I", " ", 
         RowBox[{"c", "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}]}], ",", " ", "r"}], "]"}]}], " ", 
     "==", "\n", "   ", 
     RowBox[{"dissipator", "[", 
      RowBox[{"c", ",", " ", "r"}], "]"}]}]}], "]"}], " ", "//", " ", 
  "FullSimplify"}]], "Input",
 CellLabel->"In[173]:= ",
 CellID->1371263066,ExpressionUUID->"672c7908-ff3c-85a7-0ed4-7155faceef8d"],

Cell["\<\
It returns True, with no assumptions: the two channels reproduce the same \
dissipator, so the master equation is unchanged, and as in the counting and \
homodyne runs an ensemble of these trajectories averages back to it.\
\>", "Text",
 CellID->1067912469,ExpressionUUID->"4f36945c-6fe2-68e0-76cd-0e0609973aca"],

Cell[TextData[{
 "The trajectory explores differently, so hold apart what heterodyne ",
 StyleBox["observes", "TI"],
 " from what it ",
 StyleBox["infers", "TI"],
 ", exactly as with homodyne. ",
 Cell[BoxData["trajectory"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250c2a2d-8da6-5f9d-5333-cc77245325e7"],
 " still returns two objects, the conditional state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67928f76-a8f6-4c39-0da1-2733c8831703"],
 " (inferred) and the record (observed), but the record now has ",
 StyleBox["two", "TI"],
 " columns, one real current per quadrature:"
}], "Text",
 CellID->943837838,ExpressionUUID->"6f8d9e4d-778e-395a-15b2-101702388ba0"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["I", "TI"]], "=", 
    SqrtBox[
     RowBox[{
      StyleBox["\[Gamma]", "TI"], "/", "2"}]], "\[ThinSpace]", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["x", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["I", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["J", "TI"], 
      StyleBox["Q", "TI"]]}], "=", 
    RowBox[{
     RowBox[{
      SqrtBox[
       RowBox[{
        StyleBox["\[Gamma]", "TI"], "/", "2"}]], "\[ThinSpace]", 
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], 
        StyleBox["y", "TI"]], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{
      StyleBox["d", "TI"], 
      RowBox[{
       SubscriptBox[
        StyleBox["W", "TI"], 
        StyleBox["Q", "TI"]], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1450235700,ExpressionUUID->"4897ab63-07fe-7036-78ac-434db18b431c"],

Cell[TextData[{
 "Equivalently the two real records are the real and imaginary parts of a \
single ",
 StyleBox["complex", "TI"],
 " record ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "=", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["I", "TI"]], "+", 
   StyleBox["i", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["Q", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3afe1774-f6b9-1a20-6a85-8f31834c690a"],
 ", whose increment satisfies ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["J", "TI"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cb96547-3d6c-b437-3447-7d21b41e1f1d"],
 " (the two shot noises are independent) and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["J", "TI"], "*"], "=", "2", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2231aed9-983c-87b7-53ce-478319ceed9d"],
 " (each quadrature contributes its own variance ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d324fdb-2677-e56b-74c2-66855303cfb1"],
 "): two independent real noises carried in one complex number. The single \
new fact over homodyne is that both field quadratures are recorded at once, \
so the two records carry the two transverse signals ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5da8286f-a7a3-9cec-0b57-c248d257e636"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d602230-5f26-2f06-2b1f-c47a5ad3726c"],
 " directly, each at half the power an optimally phased homodyne puts in its \
one. Run one history and keep its record:"
}], "Text",
 CellID->257312343,ExpressionUUID->"77db54cc-ee9f-ec5f-1df9-4da98b2bb6a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"hetOne", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "Hdrive", ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cAtom", "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
       RowBox[{"I", " ", 
        RowBox[{"cAtom", "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1.", ",", " ", "1."}], "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "dtAtom", ",", " ", "6.0", ",", " ", "3"}],
     "]"}]}], ";"}]], "Input",
 CellLabel->"In[174]:= ",
 CellID->1811882128,ExpressionUUID->"6a072e47-9a01-f132-1a3c-c0211fb5c018"],

Cell[TextData[{
 StyleBox["The conditional state ",
  FontWeight->"Bold"],
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"03b41a97-fa59-5a01-314b-93d0ffec296b"],
 " (inferred). ",
 StyleBox["How obtained:", "TI"],
 " the filter's running estimate of the atom given the record so far. ",
 StyleBox["Status:", "TI"],
 " inferred. Where homodyne resolved one transverse coordinate, heterodyne \
resolves both; plot the run's ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "425dab48-397f-3702-7262-4312b80b9a68"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b03a0e0-ac2b-54e8-3930-39cdc5de3e32"],
 " together:"
}], "Text",
 CellID->33577298,ExpressionUUID->"23998a05-7963-184f-51a6-2c6f78166a95"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"blochVector", "[", "#", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"hetOne", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}], ",",
      " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"blochVector", "[", "#", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"hetOne", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[LeftAngleBracket]\[Sigma]x\[RightAngleBracket]\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]\[Sigma]y\[RightAngleBracket]\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<conditional transverse Bloch vector\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<one heterodyne run resolves both quadratures\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[175]:= ",
 CellID->240192060,ExpressionUUID->"422628af-426c-374e-73dd-c109771e9d94"],

Cell["\<\
Both components diffuse smoothly, no jumps. The conditional state is a full \
Bloch vector under homodyne too, tracked by the filter from its one record; \
what heterodyne adds is a record that measures both transverse signals \
directly, where homodyne's single record measured one and left the other to \
the conditional dynamics.\
\>", "Text",
 CellID->1178070921,ExpressionUUID->"26e7e4d8-634d-0d10-4e9c-fd8216f8547a"],

Cell[TextData[{
 StyleBox["The record increments ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["I", "TI"]]}], ",", 
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["Q", "TI"]]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"027e254c-1480-02c1-3205-bd169d35502b"],
 " (observed). ",
 StyleBox["How obtained:", "TI"],
 " the detector's two outputs each step. ",
 StyleBox["Status:", "TI"],
 " observed, the only data that enters from the world; everything else is \
downstream. Read the two columns:"
}], "Text",
 CellID->1900683911,ExpressionUUID->"6456a901-44b8-c553-0c6d-416b6d32afb9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dJI", " ", "=", " ", 
   RowBox[{
    RowBox[{"hetOne", "[", "\"\<record\>\"", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dJQ", " ", "=", " ", 
   RowBox[{
    RowBox[{"hetOne", "[", "\"\<record\>\"", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[176]:= ",
 CellID->760242175,ExpressionUUID->"5de3bc1f-ff0d-b0a4-0b90-3658fab9028e"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Most", "@", "when"}], ",", " ", "dJI"}], "}"}], "]"}], ",", 
     " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Most", "@", "when"}], ",", " ", "dJQ"}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<I record\>\"", ",", " ", "\"\<Q record\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<record increments\>\""}], "}"}]}],
    ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<both quadrature records: almost pure noise per step\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[177]:= ",
 CellID->828244791,ExpressionUUID->"05b0da98-ac84-313a-334f-d3c5c5368000"],

Cell[TextData[{
 "Each is nearly pure noise, and for a sharper reason than homodyne's: each \
channel carries only ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["\[Gamma]", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1895dfb3-965d-1c83-48aa-d6fd23e866e9"],
 " of signal, half the power homodyne put into its one quadrature, against \
the same shot noise."
}], "Text",
 CellID->338384234,ExpressionUUID->"2deed3b4-be8d-db40-5b95-cafe3b39a9aa"],

Cell[TextData[{
 StyleBox["The integrated record ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubsuperscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"]], 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"78e6b17c-c991-15ef-289d-2939e8247f35"],
 " (observed). ",
 StyleBox["How obtained:", "TI"],
 " accumulate each column. ",
 StyleBox["Status:", "TI"],
 " observed, the same data summed. A complex record integrates to a path in \
the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"I", "Q"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24acbe62-bdf4-ffe2-4c53-304c3b86c5c8"],
 " plane, an observed walk that drifts along the inferred signal."
}], "Text",
 CellID->455054057,ExpressionUUID->"38f0085c-4734-4722-688f-a20672c12a08"],

Cell[TextData[{
 "That signal is the per-channel coupling ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["\[Gamma]", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b9216eb-8f9f-eb69-19a1-8fb52a2bb9b3"],
 " times each conditional quadrature, read off ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59f120da-5631-2eb2-0f8e-b98463c47498"],
 " rather than measured, one channel for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fa7ad17-3a9c-8e6e-055c-4551bf2ed4b4"],
 " and one for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c844eb4-1a55-00c1-54bc-67fe9fe0522b"],
 ":"
}], "Text",
 CellID->1632384583,ExpressionUUID->"6cf619f4-16c8-91d6-148d-90bea362e33c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hetSigI", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Gamma]atom", "/", "2"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"blochVector", "[", "#", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"Most", "[", 
       RowBox[{"hetOne", "[", "\"\<states\>\"", "]"}], "]"}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"hetSigQ", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Gamma]atom", "/", "2"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"blochVector", "[", "#", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"Most", "[", 
       RowBox[{"hetOne", "[", "\"\<states\>\"", "]"}], "]"}]}], ")"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[178]:= ",
 CellID->1806839179,ExpressionUUID->"66b1d308-016b-0c10-0e4e-cb52b01e577a"],

Cell["\<\
The observed walk is the running sum of the two record columns, each starting \
from the origin:\
\>", "Text",
 CellID->1374498314,ExpressionUUID->"0764fd02-d65e-847f-2d1b-f56fe3e8ef45"],

Cell[BoxData[
 RowBox[{
  RowBox[{"JI", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", "dJI", "]"}], ",", " ", "0."}], "]"}]}], ";", 
  " ", 
  RowBox[{"JQ", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", "dJQ", "]"}], ",", " ", "0."}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[179]:= ",
 CellID->1735539757,ExpressionUUID->"0c98820f-8b6f-75b8-34a7-24692e1a5f82"],

Cell["\<\
The drift is that same running sum on the inferred signal, the smooth curve \
the walk fluctuates around:\
\>", "Text",
 CellID->913947365,ExpressionUUID->"6abb7d62-34cd-b03b-1a59-754cbd790301"],

Cell[BoxData[
 RowBox[{
  RowBox[{"driftI", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", 
      RowBox[{"hetSigI", " ", "dtAtom"}], "]"}], ",", " ", "0."}], "]"}]}], ";",
   " ", 
  RowBox[{"driftQ", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", 
      RowBox[{"hetSigQ", " ", "dtAtom"}], "]"}], ",", " ", "0."}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[180]:= ",
 CellID->33048482,ExpressionUUID->"2d7b53f1-7ae1-3c16-5b19-4abb7e95877c"],

Cell["Now trace the observed walk against that inferred drift:", "Text",
 CellID->1913442451,ExpressionUUID->"342ac02e-94b9-9375-5c29-d9881d4dfe5f"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"JI", ",", " ", "JQ"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"driftI", ",", " ", "driftQ"}], "}"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<integrated record\>\"", ",", 
      " ", "\"\<inferred drift\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<I\>\"", ",", " ", "\"\<Q\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the observed record is a drifting walk in the IQ plane\>\""}]}],
   "]"}]], "Input",
 CellLabel->"In[181]:= ",
 CellID->1066460469,ExpressionUUID->"7e47f25d-3ed8-a4c4-267c-f407bb520e2e"],

Cell[TextData[{
 "The jagged path is the raw data; the smooth curve it drifts along is \
inferred. Integrating both quadratures at once is a 2D filter: each signal \
accumulates coherently into the drift while its noise only spreads as ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "420d2e93-75d1-66df-7232-c7dd7c644c25"],
 ", so the walk's net displacement carries the record's information where a \
single increment held almost none."
}], "Text",
 CellID->1552927865,ExpressionUUID->"0eb3603b-0e30-9ef6-3641-7a65abcae4dc"],

Cell[TextData[{
 StyleBox["The innovations ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["I", "TI"]]}], ",", 
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["Q", "TI"]]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"0da293aa-5e01-ac71-3b51-0af45bb5f75b"],
 " (inferred). ",
 StyleBox["How obtained:", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["I", "TI"]], "=", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["I", "TI"]], "-", 
   SubscriptBox[
    StyleBox["signal",
     FontSlant->"Plain"], 
    StyleBox["I", "TI"]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32c08ae5-f3ed-cbfa-62ff-23ce859999c0"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["Q", "TI"]], "=", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["Q", "TI"]], "-", 
   SubscriptBox[
    StyleBox["signal",
     FontSlant->"Plain"], 
    StyleBox["Q", "TI"]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cfb14f9-38ed-478b-4498-8da3b8982dd1"],
 ", each observed increment minus its inferred prediction. ",
 StyleBox["Status:", "TI"],
 " inferred residuals. If the filter is optimal each is zero-mean white \
noise, and because ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["J", "TI"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "683f5ed1-9434-8a9e-19c5-579b1dc6d8e4"],
 " the two are mutually independent. Check the whiteness of each channel \
first, against the ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "2", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07cd5cb3-9399-0155-2df3-55fd262c53bf"],
 " band:"
}], "Text",
 CellID->262489656,ExpressionUUID->"4f9e6b1d-931e-a284-75a5-834726a8f0ee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dWI", " ", "=", " ", 
   RowBox[{"dJI", " ", "-", " ", 
    RowBox[{"hetSigI", " ", "dtAtom"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dWQ", " ", "=", " ", 
   RowBox[{"dJQ", " ", "-", " ", 
    RowBox[{"hetSigQ", " ", "dtAtom"}]}]}], ";"}]}], "Input",
 CellLabel->"In[182]:= ",
 CellID->409171113,ExpressionUUID->"7129e602-6ec3-689c-20d6-f86c0b763ae6"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ci", " ", "=", " ", 
     RowBox[{"2", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Length", "[", "dWI", "]"}], "]"}]}]}], "}"}], ",", "\n", " ", 
   
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"CorrelationFunction", "[", 
        RowBox[{
         RowBox[{"dWI", "/", 
          RowBox[{"Sqrt", "[", "dtAtom", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "10"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"CorrelationFunction", "[", 
        RowBox[{
         RowBox[{"dWQ", "/", 
          RowBox[{"Sqrt", "[", "dtAtom", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "10"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.2"}], ",", " ", "0.2"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<I channel\>\"", ",", " ", "\"\<Q channel\>\""}], "}"}]}], 
     ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ci", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "ci"}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}]}], "}"}]}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<lag\>\"", ",", 
        " ", "\"\<innovation autocorrelation\>\""}], "}"}]}], ",", " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<each innovation channel is white\>\""}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[183]:= ",
 CellID->189753264,ExpressionUUID->"24548d70-e349-6090-4c6b-253d96fc32fa"],

Cell["\<\
Both correlograms hug zero within the band, the signature of white residuals: \
the filter has extracted every predictable part of each record.\
\>", "Text",
 CellID->1113565082,ExpressionUUID->"24053d10-b77f-7f73-4c3a-b55dc20a4259"],

Cell["\<\
Now the heterodyne-specific check with no homodyne counterpart, whether the \
two residuals are independent of each other. Read off the 2-by-2 correlation \
matrix of the innovation channels:\
\>", "Text",
 CellID->474827638,ExpressionUUID->"16592835-d9b8-94b1-3e66-c27ed832fe9b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Correlation", "[", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"dWI", ",", " ", "dWQ"}], "}"}], "]"}], "]"}], " ", "//", " ", 
  "MatrixForm"}]], "Input",
 CellLabel->"In[184]:= ",
 CellID->480943277,ExpressionUUID->"141ca810-4c49-bb60-3c23-425a65fd064a"],

Cell[TextData[{
 "The off-diagonal sits near zero, within the same ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "2", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68e9730c-176f-ed31-1897-6b56a21bb41b"],
 " band: the two residuals are not just each white but mutually independent, \
the simulation realizing the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["I", "TI"]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["Q", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "045a1c11-48b2-feff-2c79-965b6944c4c5"],
 " half of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["J", "TI"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5000470d-6ead-2730-0030-5f570b598a1a"],
 ". Reading both conjugate quadratures buys two independent white \
innovations, one per shadow."
}], "Text",
 CellID->19659169,ExpressionUUID->"5b36215d-7c1e-6467-0acd-b90775ab4f4d"],

Cell["\<\
Keeping the record splits purity into two quantities that need not agree: the \
purity of each conditioned state, and the purity of the state you get by \
averaging them. Run ninety homodyne histories of the same atom:\
\>", "Text",
 CellID->1122889797,ExpressionUUID->"648fe92d-3764-e6d2-0cb4-01774216cc38"],

Cell[BoxData[
 RowBox[{
  RowBox[{"homRuns", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"trajectory", "[", 
       RowBox[{
        RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "Hdrive", ",",
         " ", 
        RowBox[{"{", "cAtom", "}"}], ",", " ", 
        RowBox[{"{", "1.", "}"}], ",", " ", 
        RowBox[{"{", "}"}], ",", " ", "dtAtom", ",", " ", "6.0", ",", " ", 
        "s"}], "]"}], "[", "\"\<states\>\"", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "90"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[185]:= ",
 CellID->1606600295,ExpressionUUID->"51ab5adf-11d7-a41b-07a9-5399a0630f61"],

Cell["Follow both purities in time:", "Text",
 CellID->215661095,ExpressionUUID->"6ea1ee02-7e80-589f-165e-006c7b352ae5"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Mean", "[", 
           RowBox[{"purity", " ", "/@", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
          " ", 
         RowBox[{"Transpose", "[", "homRuns", "]"}]}]}], "}"}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"purity", "[", 
           RowBox[{"Mean", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"Transpose", "[", "homRuns", "]"}]}]}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<mean purity of conditioned states\>\"", ",", 
      " ", "\"\<purity of the mean state\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<purity\>\""}], "}"}]}], ",", "\n",
    " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<every run stays pure; only the record-blind average \
mixes\>\""}]}], "]"}]], "Input",
 CellLabel->"In[186]:= ",
 CellID->1518204824,ExpressionUUID->"481e4aee-9cf5-9d73-7826-63c81481e459"],

Cell["\<\
The conditioned purity holds at one for the whole run; the averaged state's \
purity falls and settles at the mixed steady value. Decoherence sits entirely \
in the second curve: it is not an event in any watched atom's history but the \
cost of discarding the record.\
\>", "Text",
 CellID->1890580947,ExpressionUUID->"3565e36d-8dcc-1be9-631a-fb3724796933"],

Cell[TextData[{
 "The two watched channels average to the same master equation the rest of \
the catalog shares. Hand the heterodyne ensemble to ",
 Cell[BoxData["gapDiagnosis"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "235d73f5-0285-a3fd-5163-6abfb731f1c7"],
 ", its two integration axes the pair the diagnostic was built to handle, \
splitting sampling scatter from step bias in one call:"
}], "Text",
 CellID->1680570408,ExpressionUUID->"2a726cbd-ee36-06ea-5a01-85e68bc36c30"],

Cell[BoxData[
 RowBox[{"gapDiagnosis", "[", 
  RowBox[{
   RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "Hdrive", ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cAtom", "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
     RowBox[{"I", " ", 
      RowBox[{"cAtom", "/", 
       RowBox[{"Sqrt", "[", "2", "]"}]}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"1.", ",", " ", "1."}], "}"}], ",", " ", 
   RowBox[{"{", "}"}], ",", " ", "dtAtom", ",", " ", "6.0", ",", " ", "150"}],
   "]"}]], "Input",
 CellLabel->"In[187]:= ",
 CellID->475458560,ExpressionUUID->"545cfe61-129d-c9b2-7c63-f04ba7299b98"],

Cell["\<\
Counting, homodyne, heterodyne: three different measurements of one atom, \
three different trajectory ensembles, one shared master equation. The \
measurement you choose sets what you learn moment to moment; the \
unconditioned dynamics is the same. Between homodyne and heterodyne lies the \
continuous general-dyne family, all on this same average.\
\>", "Text",
 CellID->823056013,ExpressionUUID->"2a738979-6fd1-4d91-5a00-21230a6417fb"],

Cell["Part Five: What Watching Does, and How to Act on It", "Section",
 CellID->1392600812,ExpressionUUID->"1cda659f-caad-1800-44fa-7cd8ef586b6a"],

Cell[TextData[{
 "Keeping the record does more than reveal the state: measurement reshapes \
the dynamics, and the record can be fed back to control the system. Five \
examples follow: a watched-frozen qubit, a charge qubit read by a detector, \
measurement-induced collapse, a Kalman filter tracking an oscillator, and \
measurement feedback (all qubits except the oscillator). First, two functions \
returning the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bd8f04d-1eeb-cc47-19e7-ea179a9f96ad"],
 " and ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4131a38c-3cb1-61e0-70ce-3ad6b54433ca"],
 " components of a list of states:"
}], "Text",
 CellID->1250002485,ExpressionUUID->"66dd1d78-a26e-793a-0ee2-9525d71b4800"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"zOf", "[", "states_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"blochVector", "[", "#", "]"}], "[", 
      RowBox[{"[", "3", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "states"}]}], ";", " ", 
  RowBox[{
   RowBox[{"xOf", "[", "states_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"blochVector", "[", "#", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "states"}]}], ";"}]], "Input",
 CellLabel->"In[188]:= ",
 CellID->1196503608,ExpressionUUID->"497210fc-93c1-a1bc-7f01-89a62675f386"],

Cell["Watching Harder Freezes It", "Subsection",
 CellID->35509309,ExpressionUUID->"2d97aad1-2ffc-78e2-5bac-439b49894ac8"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A driven qubit continuously measured along ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45812a49-00f9-159c-73be-cc13b08c7fe6"],
 ", the quantum Zeno setup. The conditioned state obeys the stochastic master \
equation"
}], "Text",
 CellID->133207102,ExpressionUUID->"2e72335e-d71b-483f-5601-ab1be2ae1b05"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    FractionBox["\[CapitalOmega]", "2"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["x", "TI"]], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "-", 
    FractionBox[
     StyleBox["k", "TI"], "2"], "\[ThinSpace]", "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[Rho]", "TI"], "+", 
     StyleBox["\[Rho]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], "-", "2", 
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1619111818,ExpressionUUID->"00379a47-1bf1-fdbf-31cc-1c219d85c785"],

Cell[TextData[{
 "with drive ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19c466c6-94fb-625d-4ffc-7fa01c8e30a7"],
 " and measurement strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20cc8908-a147-10ca-50f3-2155d0f26210"],
 ". When ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "<", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13bcd130-62a3-8c70-4143-c97a1757d75a"],
 " the qubit swings almost freely; when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], ">", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6565394a-c196-6bdd-131a-b117f0233927"],
 " the watching pins it near a pole and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "654f987a-f98e-d016-1374-1227f838a37c"],
 " becomes a random telegraph, the \"watched pot\" that never boils. Watch a \
gently-watched and a hard-watched history."
}], "Text",
 CellID->1609727223,ExpressionUUID->"631c7298-8e73-d34d-1124-6bc22b07a197"],

Cell[TextData[{
 "A driven qubit measured along ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e9b4f74-ee28-5e2b-56b9-67318bdd2571"],
 ". Measure weakly (",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "<", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ff84a3f-8ea3-8415-2598-6c792b57ef7f"],
 ") and it swings almost freely; measure strongly (",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], ">", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d7fc3a7-f4ac-747e-7b04-da00fd595f44"],
 ") and it is pinned near a ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b0a0ef4-2602-73b0-1909-a7be53b7419a"],
 " eigenstate with occasional jumps, the quantum Zeno effect. Set the drive \
and the fine time grid:"
}], "Text",
 CellID->550162028,ExpressionUUID->"7324c1ff-ae1d-8266-22db-d8b8cba9d14c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalOmega]zeno", " ", "=", " ", "2.0"}], ";", " ", 
  RowBox[{"fastZeno", " ", "=", " ", "0.004"}], ";", " ", 
  RowBox[{"clockZeno", " ", "=", " ", 
   RowBox[{"fastZeno", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "3000"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[189]:= ",
 CellID->1908615943,ExpressionUUID->"0a19e89c-6899-3c78-3a26-01c6092d8742"],

Cell[TextData[{
 "Run one weakly and one strongly measured trajectory, same start and seed. \
The gently watched history takes measurement strength ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "0.15"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39663cc9-297d-9b4a-6f1d-b5934809e990"],
 ", well below the drive ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7331868a-f3de-6799-22ce-1fd7866b4de3"],
 ":"
}], "Text",
 CellID->1143006314,ExpressionUUID->"2e54b5d3-3a50-bfef-566b-2c9dbfea0535"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gentle", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\[CapitalOmega]zeno", "/", "2"}], " ", "X"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "0.15", "]"}], " ", "Z"}], "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "fastZeno", ",", " ", "12.", ",", " ", 
     "7"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[190]:= ",
 CellID->1196348210,ExpressionUUID->"290d3a44-5bc8-0dba-5f32-bc2e5e7d5780"],

Cell[TextData[{
 "and the hard-watched one takes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24441621-d1c3-83e7-4c7b-8f8ae077d1cd"],
 ", well above it:"
}], "Text",
 CellID->742714341,ExpressionUUID->"40c04446-bf75-68d5-70f0-5e203a003a3f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"hard", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\[CapitalOmega]zeno", "/", "2"}], " ", "X"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "6.", "]"}], " ", "Z"}], "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "fastZeno", ",", " ", "12.", ",", " ", 
     "7"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[191]:= ",
 CellID->1675247856,ExpressionUUID->"337e031d-61ac-97b3-6105-9b47105efd99"],

Cell[TextData[{
 "Compare the magnitude of the time-averaged ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c1a2f33-e4c4-62b1-1439-c77c8d71309b"],
 ":"
}], "Text",
 CellID->288968408,ExpressionUUID->"617ac38b-bfe7-c8e3-1719-dad539939ac9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Abs", "@", 
    RowBox[{"Mean", "[", 
     RowBox[{"zOf", "@", 
      RowBox[{"gentle", "[", "\"\<states\>\"", "]"}]}], "]"}]}], ",", " ", 
   RowBox[{"Abs", "@", 
    RowBox[{"Mean", "[", 
     RowBox[{"zOf", "@", 
      RowBox[{"hard", "[", "\"\<states\>\"", "]"}]}], "]"}]}]}], 
  "}"}]], "Input",
 CellLabel->"In[192]:= ",
 CellID->1029027830,ExpressionUUID->"0820ecb4-5495-9c54-39df-05fe5d21e6be"],

Cell[TextData[{
 "The weakly measured ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e80e7d7-2c44-8e80-06bf-fe9145f6d4ea"],
 " averages to near zero (it swings freely); the strongly measured one keeps \
a large mean (pinned)."
}], "Text",
 CellID->128002051,ExpressionUUID->"26f5fcf3-bda8-2342-4e8a-f5bd345d71a8"],

Cell["\<\
Now visualize the weakly and strongly measured trajectories together:\
\>", "Text",
 CellID->1571712410,ExpressionUUID->"15b39007-6d36-072c-4340-0a6104c36a76"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"clockZeno", ",", " ", 
        RowBox[{"zOf", "@", 
         RowBox[{"gentle", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}], ",",
      " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"clockZeno", ",", " ", 
        RowBox[{"zOf", "@", 
         RowBox[{"hard", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"Opacity", "[", "0.8", "]"}]}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<weak measurement (free)\>\"", ",", 
      " ", "\"\<strong measurement (pinned)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]\[Sigma]z\[RightAngleBracket]\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<strong measurement freezes the qubit (Zeno)\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[193]:= ",
 CellID->890139439,ExpressionUUID->"24baaecf-7f93-f980-4c59-47a97a27cbea"],

Cell["\<\
The strongly measured qubit clings to an eigenstate for long stretches, then \
jumps. Strong measurement freezes the dynamics, the Zeno effect: the more \
often you measure, the less the state can evolve. The jumps are the drive \
occasionally winning.\
\>", "Text",
 CellID->999332945,ExpressionUUID->"76f70144-dc0f-2312-1e8c-9921d5bb8e78"],

Cell[TextData[{
 "The single trace shows the freezing but cannot pin its rate. That rate is \
exact and sits in the master equation's own spectrum, and following it across \
the measurement strength tells a two-stage story: watching harder first kills \
the coherent Rabi oscillation, then freezes the relaxation left behind. Both \
stages are eigenvalues of the Liouvillian, and at measurement strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fe7a9e0-94ce-d707-459c-40ca1d78ba6d"],
 " against drive ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d41bad8-5432-fbcd-6b7e-33825dc4c917"],
 " they come out in closed form:"
}], "Text",
 CellID->662631669,ExpressionUUID->"0dba7410-c818-dfcb-3b5a-6e5de992a511"],

Cell[BoxData[
 RowBox[{"Eigenvalues", "@", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"liouvillian", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sqrt", "[", "k", "]"}], " ", "Z"}], "}"}], ",", " ", "2"}], 
     "]"}], ",", " ", 
    RowBox[{
     RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"k", " ", ">", " ", "0"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[194]:= ",
 CellID->798789937,ExpressionUUID->"30c9b337-f958-fd8c-60f6-2b70f8d2c7d6"],

Cell[TextData[{
 "Four eigenvalues: ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ef4fbe9-42ce-bb3a-268b-f2b377780600"],
 ", the steady state; ",
 Cell[BoxData[
  RowBox[{"-", "2", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b93c9b6-6d32-b3d4-19a0-e0f004c4013e"],
 ", the transverse dephasing, off to the side and taking no part in the \
freezing; and the Rabi pair ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["k", "TI"], "\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["k", "TI"], "2"], "-", 
     SuperscriptBox["\[CapitalOmega]", "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78b94e11-c6dd-a6bf-2847-605af3690c85"],
 ". Below the critical strength ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "<", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b080b4d-7396-a957-4937-a3170620fbbd"],
 " the radical is imaginary, ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["k", "TI"], "\[PlusMinus]", 
   StyleBox["i", "TI"], 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "-", 
     SuperscriptBox[
      StyleBox["k", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "343c9421-c983-3b23-5dc3-0d8ae8378609"],
 ", a damped oscillation the measurement only slows; above it, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], ">", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "205770a9-e847-de3f-506d-69f289f3a505"],
 ", the radical turns real, two overdamped rates; the two meet and coalesce \
at the exceptional point ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78b78126-006e-7c03-284c-1880b11b4769"],
 "."
}], "Text",
 CellID->647724388,ExpressionUUID->"5e949e5e-c771-e653-06ab-101bf205ccb9"],

Cell[TextData[{
 "For the sweep, build them numerically at a chosen fraction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   StyleBox["k", "TI"], "/", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "359bcca5-e220-9ec0-63b8-e50e97dae42a"],
 " of the drive, keeping the three that carry a rate: the steady-state ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d973432-f49b-24e6-6bac-ae7ffd2f8ecc"],
 " is dropped, so the slowest decay reads as a genuine rate rather than that \
zero, and the exceptional point falls at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2740d0b2-6fee-93c4-4d7f-c9fc0998e12e"],
 ":"
}], "Text",
 CellID->1693391218,ExpressionUUID->"28899a3f-5003-79db-58b6-1c7961b64b21"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"zenoEigs", "[", "ratio_", "]"}], " ", ":=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", 
      RowBox[{"liouvillian", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalOmega]zeno", "/", "2"}], ")"}], " ", "X"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"ratio", " ", "\[CapitalOmega]zeno"}], "]"}], " ", "Z"}], 
         "}"}], ",", " ", "2"}], "]"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "#", "]"}], " ", ">", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "9"}]}]}], " ", "&"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[195]:= ",
 CellID->819462336,ExpressionUUID->"091a51ee-65fb-201c-3f3a-48c8138e7366"],

Cell["\<\
The oscillation lives in the pair's imaginary part and the relaxation in the \
least-negative real part, so read one frequency and one rate off the spectrum \
at each ratio:\
\>", "Text",
 CellID->1116629832,ExpressionUUID->"60c488fa-b38d-2f14-10fb-21a7c638727e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"zenoFreq", "[", "ratio_", "]"}], " ", ":=", " ", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{"Im", "[", 
      RowBox[{"zenoEigs", "[", "ratio", "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zenoRate", "[", "ratio_", "]"}], " ", ":=", " ", 
   RowBox[{"-", 
    RowBox[{"Max", "[", 
     RowBox[{"Re", "[", 
      RowBox[{"zenoEigs", "[", "ratio", "]"}], "]"}], "]"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[196]:= ",
 CellID->871366443,ExpressionUUID->"3dab8a61-8541-a5e8-6ba8-2c4b2cf50f32"],

Cell[TextData[{
 "Follow both across the sweep, the oscillation frequency and the slowest \
relaxation rate against the ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cd9d50f-b32b-5aae-14e6-cd68c6de28f4"],
 ":"
}], "Text",
 CellID->1498962183,ExpressionUUID->"25697345-b0fc-afe2-5317-6b2ec08ef5c8"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", " ", 
         RowBox[{"zenoFreq", "[", "r", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0.01", ",", " ", "3.", ",", " ", "0.01"}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", " ", 
         RowBox[{"zenoRate", "[", "r", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0.01", ",", " ", "3.", ",", " ", "0.01"}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"Directive", "[", 
          RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], "}"}], ",", 
      " ", "Automatic"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Rabi oscillation  |Im \[Lambda]|\>\"", ",", 
        " ", "\"\<relaxation rate  |Re \[Lambda]|\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<k/\[CapitalOmega] ratio\>\"", ",", 
      " ", "\"\<Liouvillian eigenvalue  (1/time)\>\""}], "}"}]}], ",", "\n", 
   " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<watching harder: the oscillation dies at k = \[CapitalOmega], \
the relaxation rate peaks there\>\""}]}], "]"}]], "Input",
 CellLabel->"In[197]:= ",
 CellID->914693011,ExpressionUUID->"7b535da6-b53b-b46b-2961-54003ccf1eb1"],

Cell[TextData[{
 "The oscillation frequency slides to zero at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44232014-649d-d43d-6dd0-ba5e0d29bf07"],
 " and stays there, the coherent swinging gone; at that same strength the \
relaxation rate reaches its peak and turns over, so watching harder past ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7586ae08-7861-bb88-23bd-4052791509d2"],
 " slows the decay rather than quickening it. The pair has met on the real \
axis at an exceptional point, where the eigenvalues and their eigenvectors \
coincide and the oscillation can no longer be told apart from the decay."
}], "Text",
 CellID->2145390693,ExpressionUUID->"54e345b1-bc57-c084-7c91-5cfb35e392ee"],

Cell[TextData[{
 "Past that peak the surviving rate falls as one over the strength. Read it \
across a wide range on log-log, with the ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c2b12ae-6045-71e4-0428-8b0811f043ce"],
 " law drawn on the strong side:"
}], "Text",
 CellID->272231904,ExpressionUUID->"180e6a9a-5611-2942-4835-83c463a47ba8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zenoKs", " ", "=", " ", 
   RowBox[{"\[CapitalOmega]zeno", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"2.", "^", "e"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"e", ",", " ", 
        RowBox[{"-", "3"}], ",", " ", "4", ",", " ", "0.08"}], "}"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{"ListLogLogPlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"zenoRate", "[", 
          RowBox[{"k", "/", "\[CapitalOmega]zeno"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "zenoKs"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{
          RowBox[{"\[CapitalOmega]zeno", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "k"}], ")"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"zenoKs", ",", " ", 
           RowBox[{
            RowBox[{"#", " ", ">=", " ", "\[CapitalOmega]zeno"}], " ", 
            "&"}]}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Joined", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"False", ",", " ", "True"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<measured rate  |Re \[Lambda]|\>\"", ",", 
      " ", "\"\<\!\(\*FractionBox[SuperscriptBox[\(\[CapitalOmega]\), \(2\)], \
\(2  k\)]\)  (the Zeno freeze)\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"\[CapitalOmega]zeno", ",", " ", 
         RowBox[{"Directive", "[", 
          RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], "}"}], ",", 
      " ", "None"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<measurement strength k\>\"", ",", 
      " ", "\"\<slowest relaxation rate  |Re \[Lambda]|\>\""}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the rate follows k up to k = \[CapitalOmega], then freezes as \
\!\(\*FractionBox[SuperscriptBox[\(\[CapitalOmega]\), \(2\)], \(2  \
k\)]\)\>\""}]}], "]"}]}], "Input",
 CellLabel->"In[198]:= ",
 CellID->183385376,ExpressionUUID->"6dd95d70-b540-f840-1be7-553a3cfacaaa"],

Cell[TextData[{
 "Below ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29eb0418-0bd1-ce19-5fe8-9e42ae659563"],
 " the rate climbs along ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fcc496e-9c46-13ea-55f4-614815f36130"],
 "; above it the points settle onto the ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "191acd8d-6e98-c427-4f39-e4d70b12af0d"],
 " line, the leftover relaxation frozen as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2305a976-3107-1e82-513a-413040b264e8"],
 ", the small gap near the peak closing as the watching strengthens. Watching \
past the optimal strength does not pin the qubit harder, it slows what motion \
is left, the quantum Zeno suppression."
}], "Text",
 CellID->1323839713,ExpressionUUID->"7db30b64-26ac-b1af-2b40-a34e535e03f5"],

Cell[TextData[{
 "The whole crossover is exact, read straight off the deterministic \
Liouvillian with no gate, no time step, and no ensemble. Its slowest \
eigenvalue returns at once in the next section as the width of the central \
peak the quantum point contact reads off its own current, so the Zeno rate \
here and that spectrum there are one number seen twice. Coherent Rabi giving \
way to overdamped freezing through a Liouvillian exceptional point is the \
modern reading of when watching stops helping and starts freezing (",
 ButtonBox["Snizhko, Kumar, and Romito, 2020",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2003.10476"], None}],
 "), seen on a driven transmon by ",
 ButtonBox["Slichter and Siddiqi, 2016",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/1512.04006"], None}],
 "."
}], "Text",
 CellID->1299720858,ExpressionUUID->"7eeaae22-94f7-017f-26e9-478c1c825045"],

Cell["A Charge Qubit Read by a Quantum Point Contact", "Subsection",
 CellID->513341225,ExpressionUUID->"09646c1c-8840-439e-3f1b-864629f511e4"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " The last two examples watched an abstract qubit; here is the same watching \
realized in a solid-state device. A charge qubit (one electron shared between \
two quantum dots, \"dot 1\" or \"dot 2\") is monitored by a nearby quantum \
point contact (QPC) whose current depends on which dot holds the electron. \
With interdot tunnelling ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63ab22ce-56be-71a3-11a8-bba8634b4389"],
 " and no detuning, the unconditional master equation is"
}], "Text",
 CellID->2063978445,ExpressionUUID->"1cf7fb29-0d40-1e28-448c-f373a4f56572"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      FractionBox["\[CapitalOmega]", "2"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["x", "TI"]]}], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Kappa]", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "\[RightVector]"], "1"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "\[RightVector]"], "1"], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"\|01d7d9", "-", 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], 
        StyleBox["z", "TI"]]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->124947567,ExpressionUUID->"2d412947-9e62-7904-5b7e-c1211b17486e"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "\[RightVector]"], "2"], "-", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "\[RightVector]"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fd69df2-7b02-a961-15ed-14bc7eb4f84b"],
 " the which-dot operator. Here ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "768fd558-59bf-0a63-1eb4-cd02584a5949"],
 " is the coefficient of ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["n", "TI"], "1"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26b5396e-c871-0359-4e4a-b14be90451a3"],
 "; because ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f77ebf2-aec9-563c-450c-02bfcb7c3d06"],
 " is a projector, the off-diagonal density-matrix element decays at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5317ee41-6066-3577-012c-002b11109c5d"],
 ". The QPC current is a continuous weak measurement of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0454080f-5b74-5a26-2c6b-a2695e01290c"],
 ": when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "<", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "200c839f-1e44-fe5c-5033-1ad99bf6c4a6"],
 " the electron tunnels coherently and the current carries an oscillation at \
the Rabi frequency; when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], ">", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "573cfa27-29ff-38cf-7ec3-f3814f8b8a15"],
 " the qubit is pinned and the current is a random telegraph. Build the \
conditioned dynamics, the detector current, and the current's power \
spectrum."
}], "Text",
 CellID->307500845,ExpressionUUID->"7bb83578-78e8-07f4-2947-ad22789d6dde"],

Cell[TextData[{
 "The dephasing ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["n", "TI"], "\[RightVector]"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48fc1f1f-3652-ba13-7883-975943e40979"],
 " is a projector, and ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "\[RightVector]"], "1"], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   FractionBox["1", "4"], "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3cf3ec-7071-038e-3bc3-eab6010451d4"],
 " (the identity part drops from any dissipator), so watching the QPC is \
exactly watching ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44b6a437-3794-76b8-6c4d-3e7142215c82"],
 " at strength ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e37a26f-afb3-2e6c-67cc-4448ca4674b6"],
 ": the machinery of the last two examples applies unchanged. Fix the \
tunnelling and the two regimes:"
}], "Text",
 CellID->971031069,ExpressionUUID->"576120e7-4357-336c-7d1e-b9c176e381b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OmQpc", " ", "=", " ", "2.0"}], ";", " ", 
  RowBox[{"kSlow", " ", "=", " ", "0.6"}], ";", " ", 
  RowBox[{"kFast", " ", "=", " ", "12.0"}], ";", " ", 
  RowBox[{
   RowBox[{"qpcLeak", "[", "\[Kappa]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Kappa]", "/", "4"}], "]"}], " ", "Z"}]}], ";"}]], "Input",
 CellLabel->"In[199]:= ",
 CellID->959838422,ExpressionUUID->"375ed7c0-a5a4-d638-5d65-ceadcc56bd02"],

Cell[TextData[{
 "The conditioned trajectory uses the toolkit's positivity-preserving step. \
After subtracting the state-independent mean QPC current and choosing the \
sign convention ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Z", "TI"], "=", 
   SubscriptBox[
    StyleBox["n", "TI"], "2"], "-", 
   SubscriptBox[
    StyleBox["n", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1106a12f-2723-9187-473d-388952d7e3ed"],
 ", the rescaled record is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["J", "TI"], "."], "=", 
   SqrtBox[
    StyleBox["\[Kappa]", "TI"]], "\[ThinSpace]", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "+", 
   StyleBox[
    RowBox[{"shot", "\[NonBreakingSpace]", "noise"}],
    FontSlant->"Plain"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0df9f048-7a44-7b96-3b86-ea127ff149fc"],
 ". An experimental current can differ by an overall gain and sign; neither \
changes the conditioned dynamics. Fix the step and horizon:"
}], "Text",
 CellID->1887610507,ExpressionUUID->"11feb189-ad07-7b90-4785-28d2c4b249fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dtQpc", " ", "=", " ", "0.004"}], ";", " ", 
  RowBox[{"tfQpc", " ", "=", " ", "10."}], ";"}]], "Input",
 CellLabel->"In[200]:= ",
 CellID->1384833740,ExpressionUUID->"74f078bc-d989-92d9-1c80-71f9d83de023"],

Cell[TextData[{
 "the weakly measured, coherent history (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "=", "0.6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "587682b0-1dd8-f3c6-080d-1bfa9452c12c"],
 "):"
}], "Text",
 CellID->1880473289,ExpressionUUID->"252e0451-1a36-40ed-4cd5-9e1b9fc31237"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qpcSlow", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "ground", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"qpcLeak", "[", "kSlow", "]"}], "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "dtQpc", ",", " ", "tfQpc", ",", " ", 
     "4"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[201]:= ",
 CellID->117881571,ExpressionUUID->"6b506e1e-f100-9568-196f-805b80baffb2"],

Cell[TextData[{
 "the strongly measured, Zeno history (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "=", "12"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45e6cda3-0332-8806-739d-e40db6c4db6c"],
 "):"
}], "Text",
 CellID->372521314,ExpressionUUID->"10a6fcee-2410-cb5f-405d-f5c84daa99a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qpcFast", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "ground", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"qpcLeak", "[", "kFast", "]"}], "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "dtQpc", ",", " ", "tfQpc", ",", " ", 
     "4"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[202]:= ",
 CellID->1020330751,ExpressionUUID->"20b3c3fd-ce47-45e5-5040-daa6ebf22fcf"],

Cell["and their shared time axis:", "Text",
 CellID->339737350,ExpressionUUID->"0dd5773b-5215-a52c-3beb-6f6567a10c76"],

Cell[BoxData[
 RowBox[{
  RowBox[{"whenQpc", " ", "=", " ", 
   RowBox[{"qpcSlow", "[", "\"\<times\>\"", "]"}]}], ";"}]], "Input",
 CellLabel->"In[203]:= ",
 CellID->967879197,ExpressionUUID->"7da02f1b-35d4-9174-2b5f-c745bc66e05e"],

Cell[TextData[{
 "The QPC hands back a single real record, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "=", 
   SqrtBox[
    StyleBox["\[Kappa]", "TI"]], "\[ThinSpace]", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1be4ea81-18b8-2b05-499b-03eb994d766f"],
 ", one continuous measurement of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bec375e-30ea-24bd-5993-af18409c8e87"],
 ": it is the homodyne ledger again in a solid-state skin, the record the \
only data and the coherent which-dot swing inferred from it, buried per step \
under shot noise many times larger."
}], "Text",
 CellID->2045221242,ExpressionUUID->"7dcf5242-c9ff-a686-2bf5-542fef8b0cec"],

Cell["\<\
Contrast the two regimes directly, the coherent swing against the \
strongly-watched telegraph:\
\>", "Text",
 CellID->2119433676,ExpressionUUID->"52da685f-2498-05f2-02f9-82194d2d6fd8"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"whenQpc", ",", " ", 
        RowBox[{"zOf", "@", 
         RowBox[{"qpcSlow", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}], ",",
      " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"whenQpc", ",", " ", 
        RowBox[{"zOf", "@", 
         RowBox[{"qpcFast", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"Opacity", "[", "0.85", "]"}]}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<weak (coherent tunnelling)\>\"", ",", 
      " ", "\"\<strong (Zeno telegraph)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]\[Sigma]z\[RightAngleBracket]\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<measurement strength selects coherent oscillation or \
telegraph\>\""}]}], "]"}]], "Input",
 CellLabel->"In[204]:= ",
 CellID->1666150564,ExpressionUUID->"12aa8adb-4d50-9545-42a9-238564eaffaf"],

Cell["\<\
Weak measurement leaves the electron tunnelling freely; strong measurement \
pins it in one dot with rare jumps.\
\>", "Text",
 CellID->664696531,ExpressionUUID->"6bddd79b-6823-400d-19e2-cec509d61357"],

Cell[TextData[{
 "The distinctive QPC signature is not in any single record but in the ",
 StyleBox["spectrum", "TI"],
 ", because a coherent oscillation is a ",
 StyleBox["frequency", "TI"],
 ": it cancels in the time-integral of the record and shows itself only in \
the spectrum, painting a peak at the Rabi frequency in the fluctuations of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0292d5cf-fba4-5fb5-32a1-cca8fe51259f"],
 " that the detector current inherits. The power spectrum is the Fourier \
transform of the steady-state autocorrelation ",
 Cell[BoxData[
  SubscriptBox[
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["\[Delta]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Tau]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], "\[ThinSpace]", 
     StyleBox["\[Delta]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["(",
      SpanMaxSize->1], "0", 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], 
   StyleBox["ss",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "315a5c02-c518-37e9-677a-566fec929d33"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "-", 
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["ss",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "601c6277-b8fa-6d82-1023-8431388f37e8"],
 " is the fluctuation about the steady mean. Quantum regression is the \
statement that this correlation runs on the ",
 StyleBox["same", "TI"],
 " Liouvillian as the state: plant the seed ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "056e5c3e-0591-d839-3316-5678ac25ab03"],
 ", propagate it by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"\[ScriptCapitalL]", 
    StyleBox["\[Tau]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7362f573-955d-4629-2111-ed3d1ce82d73"],
 ", and read ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d4a449b-9aea-2b01-4b4a-5dc51e9f766b"],
 " back off it, so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Delta]", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"\[ScriptCapitalL]", 
      StyleBox["\[Tau]", "TI"]}]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["\[Delta]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["ss",
       FontSlant->"Plain"]]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "693f6746-f6ea-213d-18c5-7f23829f7007"],
 "."
}], "Text",
 CellID->79098559,ExpressionUUID->"58bbc0e4-f422-75b6-0858-d9c1fdd75f9c"],

Cell[TextData[{
 "With the convention ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubsuperscriptBox["\[Integral]", 
    RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Omega]", "TI"], 
     StyleBox["\[Tau]", "TI"]}]], 
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["\[Tau]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "512ebd8c-9517-4b4e-00d5-34d61ca21994"],
 ", Fourier-transforming in ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38255ff6-675c-bc9f-69db-56b012ee06e5"],
 " replaces the propagator ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"\[ScriptCapitalL]", 
    StyleBox["\[Tau]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0868aa04-f8be-0db7-3817-4c61f94b579d"],
 " by a single matrix inverse, the resolvent ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["\[Omega]", "TI"], "-", "\[ScriptCapitalL]"}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   RowBox[{"-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0889c062-717f-f29f-38b6-da4c000bc0e5"],
 ". If the Liouvillian is diagonalizable, the inverse splits into simple \
poles, one per eigenvalue ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f19c016-97c3-092d-0526-da5022765877"],
 ". An eigenvalue ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["j", "TI"]], "=", "-", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["j", "TI"]], "+", 
   StyleBox["i", "TI"], 
   SubscriptBox[
    StyleBox["\[Nu]", "TI"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c809b18-7d36-d224-44bf-134274c0a10e"],
 " supplies a pole at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Nu]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7167cc0d-03c8-d238-271c-e657b662a102"],
 " with width ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "324c55d1-ee3a-374b-6274-4c9a8bcc9d91"],
 ", but a complex residue can mix absorptive (Lorentzian) and dispersive line \
shapes; it is not generally a positive Lorentzian by itself. The coefficient ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4495e7b4-eb19-1195-6caa-fef18eac63ff"],
 " is the seed's coordinate along mode ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "561855fc-8d4a-f767-7e38-4ca624fcda4d"],
 ", and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["r", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cc16cd1-dd21-1c76-14fe-859ad4d4675c"],
 " is the readout overlap. Summing the poles, with the steady mode ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["j", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30881872-2ed2-344c-60b7-923c4b649e96"],
 " dropped because ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06a6bc82-b4ed-9511-2e5d-35ec3c99fc7b"],
 " has zero steady mean,"
}], "Text",
 CellID->923612531,ExpressionUUID->"15240c0a-58c5-65f1-3cdb-a65459704fdb"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["S", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Omega]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", "2", "\[ThinSpace]", 
    StyleBox["Re",
     FontSlant->"Plain"], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Lambda]", "TI"], 
       StyleBox["j", "TI"]], "\[NotEqual]", "0"}],
     LimitsPositioning->False], 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["c", "TI"], 
       StyleBox["j", "TI"]], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["r", "TI"], 
       StyleBox["j", "TI"]]}], 
     RowBox[{
      StyleBox["i", "TI"], 
      StyleBox["\[Omega]", "TI"], "-", 
      SubscriptBox[
       StyleBox["\[Lambda]", "TI"], 
       StyleBox["j", "TI"]]}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->725718587,ExpressionUUID->"6874cd6b-f967-cd5b-180b-e534f81397a1"],

Cell["\<\
This is where the slowest eigenvalue of the Zeno crossover returns: it is the \
pole nearest the imaginary axis and controls the narrowest long-time spectral \
scale. When its residue is real and it dominates the other modes, that scale \
appears as a Lorentzian half-width equal to the relaxation rate.\
\>", "Text",
 CellID->868291647,ExpressionUUID->"16aea7ca-f02c-8fa8-3e55-3e9781ded5f2"],

Cell[TextData[{
 "Build the general spectrum for any Liouvillian, seed, and readout: \
eigendecompose the Liouvillian, find the seed's coordinates ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68bcb404-3168-9397-1843-2e6e4002e1fd"],
 " by solving for them in the eigenbasis, read each mode's overlap ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["r", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3074fef3-0190-9aee-600b-f7bdb02ae834"],
 " with the readout, and sum the poles at every requested frequency:"
}], "Text",
 CellID->986753062,ExpressionUUID->"5132409c-0c71-a3d8-00c2-59c6a505f122"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"regressionSpectrum", "[", 
    RowBox[{
    "big_", ",", " ", "seedMat_", ",", " ", "readout_", ",", " ", "tones_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"Length", "[", "readout", "]"}]}], ",", " ", 
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Length", "[", "big", "]"}]}], ",", " ", "vals", ",", " ", 
       "vecs", ",", " ", "basis", ",", " ", "singular", ",", " ", "coeffs", ",",
        " ", "resu"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vals", ",", " ", "vecs"}], "}"}], " ", "=", " ", 
       RowBox[{"Eigensystem", "[", "big", "]"}]}], ";", "\n", "   ", 
      RowBox[{"basis", " ", "=", " ", 
       RowBox[{"Transpose", "[", "vecs", "]"}]}], ";", " ", 
      RowBox[{"singular", " ", "=", " ", 
       RowBox[{"SingularValueList", "[", 
        RowBox[{"N", "@", "basis"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"MatrixRank", "[", "basis", "]"}], " ", "<", " ", "n"}], 
         " ", "||", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Last", "[", "singular", "]"}], "/", 
           RowBox[{"First", "[", "singular", "]"}]}], " ", "<", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "7"}]}]}]}], ",", "\n", "    ", 
        RowBox[{"Return", "@", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<DefectiveEigenbasis\>\"", ",", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<NumericalRank\>\"", " ", "->", " ", 
              RowBox[{"MatrixRank", "[", 
               RowBox[{"N", "@", "basis"}], "]"}]}], ",", " ", 
             RowBox[{"\"\<ConditionNumber\>\"", " ", "->", " ", 
              RowBox[{
               RowBox[{"First", "[", "singular", "]"}], "/", 
               RowBox[{"Last", "[", "singular", "]"}]}]}]}], "|>"}]}], 
          "]"}]}]}], "]"}], ";", "\n", "   ", 
      RowBox[{"coeffs", " ", "=", " ", 
       RowBox[{"LinearSolve", "[", 
        RowBox[{"basis", ",", " ", 
         RowBox[{"Flatten", "[", "seedMat", "]"}]}], "]"}]}], ";", "\n", 
      "   ", 
      RowBox[{"resu", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{"readout", " ", ".", " ", 
           RowBox[{"ArrayReshape", "[", 
            RowBox[{
             RowBox[{"vecs", "[", 
              RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", 
           RowBox[{"d", "^", "2"}]}], "}"}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"Re", "@", 
          RowBox[{"Total", "@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"vals", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "<", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "9"}]}]}], ",", " ", "0", ",", " ", 
               RowBox[{
                RowBox[{"coeffs", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", 
                RowBox[{
                 RowBox[{"resu", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"I", " ", "w"}], " ", "-", " ", 
                   RowBox[{"vals", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}]}]}], "]"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", 
               RowBox[{"d", "^", "2"}]}], "}"}]}], "]"}]}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"w", ",", " ", "tones"}], "}"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[205]:= ",
 CellID->1712489022,ExpressionUUID->"65312e6e-5674-5434-0cce-c04863013f1e"],

Cell[TextData[{
 Cell[BoxData["vals"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0235daed-fad3-6b5f-33ca-d3b6ff6639a5"],
 " are the eigenvalues ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c9f7e12-83c1-89ed-64a5-705c3675db37"],
 "; ",
 Cell[BoxData["coeffs"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "505aa7d0-1afc-86f2-0079-3e9a9e8eecd8"],
 " are the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5143f96d-83a3-6ed2-0770-f13736563438"],
 ", produced by ",
 Cell[BoxData["LinearSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e0ac860-85ff-08e4-2609-e24a338a5ace"],
 " writing the seed as a combination of the eigenmodes; ",
 Cell[BoxData["resu"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c4a7891-0723-3e0d-544a-71dbb2d78557"],
 " are the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["r", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "567bfdcc-56c6-5358-7e18-f496637321a2"],
 ", each mode's trace against the readout; the last line sums ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["j", "TI"]], 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["j", "TI"]], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], 
    StyleBox["\[Omega]", "TI"], "-", 
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b371d01-a041-5dbe-3acc-956ad1f42784"],
 " over the nonzero eigenvalues."
}], "Text",
 CellID->1130883020,ExpressionUUID->"09dcd030-ee58-59fb-3fe3-ca7d8bed2bc1"],

Cell[TextData[{
 "The eigenmode sum is one way to the spectrum. There is a second that never \
diagonalizes at all: Fourier-transforming ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3eb66b53-0a81-4482-664d-831daf342ee8"],
 " turns ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"\[ScriptCapitalL]", 
    StyleBox["\[Tau]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4513a2b6-5679-71cc-7320-3bf0630c4316"],
 " straight into the resolvent ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["\[Omega]", "TI"], "-", "\[ScriptCapitalL]"}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   RowBox[{"-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a5000e8-62c3-6dca-3a6f-99b217763710"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "2", "\[ThinSpace]", 
   StyleBox["Re",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["R", "TI"], "^"], "\[ThinSpace]", 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["i", "TI"], 
       StyleBox["\[Omega]", "TI"], "-", "\[ScriptCapitalL]"}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{"-", "1"}]], "\[ThinSpace]", 
    OverscriptBox[
     StyleBox["S", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72376a19-67f8-2d8a-23cc-8c43118d77d0"],
 " for readout ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["R", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6261e651-652e-b57b-121e-f81b0cd81c41"],
 " and seed ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["S", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02289828-dcb6-ed3d-33d7-1275d540b407"],
 ". In other words, solve one linear system per frequency instead of \
splitting the inverse into poles. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e4925e4-2eb0-6ad8-2676-bcce4b453822"],
 " the propagated seed stays traceless, so we pin the physical branch by \
appending the trace condition and solving in the least-squares sense:"
}], "Text",
 CellID->826918846,ExpressionUUID->"3f48fd62-d18c-e56b-6577-f54fe03ecfb1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"resolventSpectrum", "[", 
    RowBox[{
    "big_", ",", " ", "seedMat_", ",", " ", "readout_", ",", " ", "tones_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Length", "[", "big", "]"}]}], ",", " ", 
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"Length", "[", "readout", "]"}]}]}], "}"}], ",", "\n", "   ", 
     
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"Re", "@", 
         RowBox[{"Tr", "[", 
          RowBox[{"readout", " ", ".", " ", 
           RowBox[{"ArrayReshape", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", "w", "]"}], " ", "<", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "9"}]}]}], ",", "\n", "       ", 
               RowBox[{"LeastSquares", "[", 
                RowBox[{
                 RowBox[{"Join", "[", 
                  RowBox[{
                   RowBox[{"N", "[", 
                    RowBox[{"-", "big"}], "]"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"1.", " ", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"IdentityMatrix", "[", "d", "]"}], "]"}]}], 
                    "}"}]}], "]"}], ",", " ", 
                 RowBox[{"Join", "[", 
                  RowBox[{
                   RowBox[{"Flatten", "[", "seedMat", "]"}], ",", " ", 
                   RowBox[{"{", "0.", "}"}]}], "]"}]}], "]"}], ",", "\n", 
               "       ", 
               RowBox[{"LinearSolve", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"I", " ", "w", " ", 
                   RowBox[{"IdentityMatrix", "[", "n", "]"}]}], " ", "-", " ",
                   "big"}], ",", " ", 
                 RowBox[{"Flatten", "[", "seedMat", "]"}]}], "]"}]}], "]"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], "]"}]}]}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"w", ",", " ", "tones"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[206]:= ",
 CellID->1119720649,ExpressionUUID->"09732abd-5fe3-4802-3f00-c3e759961b68"],

Cell[TextData[{
 "Now specialize to the QPC. Build its Liouvillian and steady state, center \
",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ab4141e-cc6c-4672-1a4b-8e5be5192d58"],
 " on its steady value to form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1d8418-8fb4-2aea-3522-1e422a417830"],
 ", and hand the symmetrized seed ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Delta]", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]], "+", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    StyleBox["\[Delta]", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b1b0b32-6c87-d322-2938-a37c0533be08"],
 " together with that same ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b382293-4179-aaf9-3ac7-bbdd700df8c3"],
 " as the readout to the resolvent form:"
}], "Text",
 CellID->747338226,ExpressionUUID->"2e8da17c-ff26-3788-56b2-3939fad09dd2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qpcSpectrum", "[", 
    RowBox[{"\[Kappa]_", ",", " ", "tones_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"big", " ", "=", " ", 
        RowBox[{"liouvillian", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"qpcLeak", "[", "\[Kappa]", "]"}], "}"}], ",", " ", "2"}], 
         "]"}]}], ",", " ", 
       RowBox[{"rss", " ", "=", " ", 
        RowBox[{"First", "@", 
         RowBox[{"stationary", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"qpcLeak", "[", "\[Kappa]", "]"}], "}"}]}], "]"}]}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dz", " ", "=", " ", 
         RowBox[{"Z", " ", "-", " ", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{"Z", " ", ".", " ", "rss"}], "]"}], "]"}], " ", 
           "id2"}]}]}], "}"}], ",", " ", 
       RowBox[{"resolventSpectrum", "[", 
        RowBox[{"big", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"dz", " ", ".", " ", "rss"}], " ", "+", " ", 
            RowBox[{"rss", " ", ".", " ", "dz"}]}], ")"}], "/", "2"}], ",", 
         " ", "dz", ",", " ", "tones"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[207]:= ",
 CellID->1214057513,ExpressionUUID->"3669af04-3982-74bb-5e16-476eb8375e81"],

Cell[TextData[{
 "Here ",
 Cell[BoxData["dz"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28fe05af-1890-3d45-5885-9c09992a87af"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01001107-76e3-9dfc-373f-89610297e7c6"],
 ", and symmetrizing the seed selects the real, even correlation measured by \
the detector. ",
 Cell[BoxData["qpcSpectrum"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "524d5b64-939d-9e2e-0273-534e2629e574"],
 " deliberately uses the mode-free resolvent, so the parameter sweep remains \
defined at the exceptional point; the modal representation is used only as a \
cross-check away from coalescence."
}], "Text",
 CellID->1068045466,ExpressionUUID->"3bbb36c0-925a-ccd2-6958-afaa27ec9638"],

Cell[TextData[{
 "Confirm the normalization is right: the spectrum integrates to the steady \
variance of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a695b16-67b9-69b9-4a17-5350124c3b83"],
 ", which is one for the maximally mixed steady state:"
}], "Text",
 CellID->207361811,ExpressionUUID->"0deaf6de-bcac-37fa-3be9-ef98355e9dc0"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"wide", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "40"}], ",", " ", "40", ",", " ", "0.02"}], "]"}]}], 
    "}"}], ",", " ", 
   RowBox[{"0.02", " ", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"qpcSpectrum", "[", 
       RowBox[{"1.", ",", " ", "wide"}], "]"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "Pi"}], ")"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[208]:= ",
 CellID->483818264,ExpressionUUID->"7a9276f6-63cd-444b-2aa2-6fb016782e91"],

Cell["It returns one, so the spectral weight is accounted for.", "Text",
 CellID->625240499,ExpressionUUID->"286ae68d-79c0-1125-5869-ffd77875600f"],

Cell["\<\
Confirm the two ways give the same QPC spectrum, at a ratio far from any \
coalescence:\
\>", "Text",
 CellID->1892872133,ExpressionUUID->"0e79da95-910a-a6b5-3606-d3df20bc0c9f"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"big", " ", "=", " ", 
      RowBox[{"liouvillian", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"qpcLeak", "[", "4.", "]"}], "}"}], ",", " ", "2"}], "]"}]}],
      ",", " ", 
     RowBox[{"rss", " ", "=", " ", 
      RowBox[{"First", "@", 
       RowBox[{"stationary", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"qpcLeak", "[", "4.", "]"}], "}"}]}], "]"}]}]}], ",", " ", 
     RowBox[{"grid", " ", "=", " ", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"-", "6"}], ",", " ", "6", ",", " ", "0.1"}], "]"}]}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dz", " ", "=", " ", 
       RowBox[{"Z", " ", "-", " ", 
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"Z", " ", ".", " ", "rss"}], "]"}], "]"}], " ", 
         "id2"}]}]}], "}"}], ",", " ", 
     RowBox[{"Max", "@", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"regressionSpectrum", "[", 
         RowBox[{"big", ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"dz", " ", ".", " ", "rss"}], " ", "+", " ", 
             RowBox[{"rss", " ", ".", " ", "dz"}]}], ")"}], "/", "2"}], ",", 
          " ", "dz", ",", " ", "grid"}], "]"}], " ", "-", " ", 
        RowBox[{"resolventSpectrum", "[", 
         RowBox[{"big", ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"dz", " ", ".", " ", "rss"}], " ", "+", " ", 
             RowBox[{"rss", " ", ".", " ", "dz"}]}], ")"}], "/", "2"}], ",", 
          " ", "dz", ",", " ", "grid"}], "]"}]}], "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[209]:= ",
 CellID->84806595,ExpressionUUID->"09d777b6-b63f-ed25-3fed-6ef3c3cbb40f"],

Cell[TextData[{
 "Away from coalescence, the maximum difference is at numerical precision: \
two representations of one spectrum. They part company at one place only. \
Where two Liouvillian eigenvalues and their eigenvectors coalesce, an ",
 StyleBox["exceptional point",
  FontWeight->"Bold"],
 " (met in the Zeno crossover above, and reached again in the squeezing \
spectrum of the last section), the eigenbasis the mode sum needs turns \
singular while the resolvent never forms it. The QPC sweep therefore uses the \
resolvent for every ratio, including the exact exceptional point."
}], "Text",
 CellID->921906943,ExpressionUUID->"2768433a-cec7-30dc-4d68-5b67eb738226"],

Cell[TextData[{
 "Now sweep the ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   StyleBox["k", "TI"], "/", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f776597-6eed-bc41-150d-7cd10a9906ab"],
 " of the effective measurement strength ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   StyleBox["\[Kappa]", "TI"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37f31662-30b3-53e3-5d80-884c414621c9"],
 " to the drive, from weak, past the point where the two spectral peaks \
merge, into the Zeno regime. Take five ratios along that path:"
}], "Text",
 CellID->1795442623,ExpressionUUID->"0465595f-3759-9855-2c1b-511942edeabf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ratioSweep", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0.25", ",", " ", "0.5", ",", " ", "0.75", ",", " ", "1.", ",", " ", 
     "1.5"}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[210]:= ",
 CellID->1276871254,ExpressionUUID->"4b103241-69e7-988c-792f-b42b0f93ead6"],

Cell[TextData[{
 "Resolve each spectrum on a fine frequency grid wide enough to hold both \
Rabi peaks near ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "423e0d65-9e44-f34a-73c5-a54f1bf6c190"],
 ":"
}], "Text",
 CellID->649937590,ExpressionUUID->"1bc261b5-654b-a677-49f2-78ff0cff0d5d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tonesQpc", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "6"}], ",", " ", "6", ",", " ", "0.04"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[211]:= ",
 CellID->1170948616,ExpressionUUID->"34f1caf0-755d-71af-5c8e-e3ba7ce843f5"],

Cell["\<\
Colour the curves warm to cool across the sweep, so the peaks' inward march \
reads at a glance:\
\>", "Text",
 CellID->1271585103,ExpressionUUID->"14d4f14a-07e3-3752-3ceb-e914b1979db8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sweepCols", " ", "=", " ", 
   RowBox[{
    RowBox[{"ColorData", "[", "\"\<TemperatureMap\>\"", "]"}], " ", "/@", " ", 
    RowBox[{"Subdivide", "[", 
     RowBox[{
      RowBox[{"Length", "[", "ratioSweep", "]"}], " ", "-", " ", "1"}], 
     "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[212]:= ",
 CellID->1586088935,ExpressionUUID->"7b5a0245-2820-625f-2979-a42f49d530a5"],

Cell[TextData[{
 "Overlay the five power spectra, one per ratio (recovering ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "=", "4", "\[CapitalOmega]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45aa5bc0-73da-807d-73aa-52aa066cd347"],
 " for each), with gridlines at ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "688d67fd-2a77-4fd5-18b3-7ea74f02153f"],
 ":"
}], "Text",
 CellID->2147327530,ExpressionUUID->"206ab830-fe85-388c-5069-327dfb318ad6"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tonesQpc", ",", " ", 
        RowBox[{"qpcSpectrum", "[", 
         RowBox[{
          RowBox[{"4", " ", "OmQpc", " ", "r"}], ",", " ", "tonesQpc"}], 
         "]"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "ratioSweep"}], "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Directive", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"Thickness", "[", "0.006", "]"}]}], "]"}], " ", "&"}], " ", "/@",
       " ", "sweepCols"}], ")"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"LineLegend", "[", 
     RowBox[{"sweepCols", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<k/\[CapitalOmega] = 0.25  (weak)\>\"", ",", 
        " ", "\"\<k/\[CapitalOmega] = 0.5\>\"", ",", 
        " ", "\"\<k/\[CapitalOmega] = 0.75\>\"", ",", 
        " ", "\"\<k/\[CapitalOmega] = 1  (exceptional point)\>\"", ",", 
        " ", "\"\<k/\[CapitalOmega] = 1.5  (Zeno)\>\""}], "}"}]}], "]"}]}], ",",
    "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "OmQpc"}], ",", " ", "0", ",", " ", "OmQpc"}], "}"}], ",",
       " ", "None"}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency\>\"", ",", " ", "\"\<S_zz(omega)\>\""}], "}"}]}], 
   ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<watching harder marches the spectral peaks inward,\n merging \
them before the exceptional point\>\""}]}], "]"}]], "Input",
 CellLabel->"In[213]:= ",
 CellID->1186224664,ExpressionUUID->"6259337f-42f1-dd99-1266-ab397685a7e3"],

Cell[TextData[{
 "At weak watching the spectrum is split, twin peaks near ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36c57d9d-81e8-42ea-5efb-74c7379d1030"],
 ", the coherent Rabi oscillation written into the fluctuations of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45788596-5db6-3a96-7307-1cd0544088fc"],
 ", the solid-state echo of the Mollow triplet's sidebands. Watching harder \
marches those peaks inward, but not to the pole frequency: the damping pushes \
each maximum below it, to ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "-", "2", 
     SuperscriptBox[
      StyleBox["k", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c54ae11-ac51-e949-146b-405ac5e5bb93"],
 ", so the peaks reach zero and merge already at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]", "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d4030e4-6c2c-f7e9-0b7f-a9ce05dedd33"],
 " (ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[TildeTilde]", "0.71"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503b1edc-b945-4d24-01d8-978638f0140e"],
 "). That merger is one event; the exceptional point is another. The \
Liouvillian poles sit at ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["k", "TI"], "\[PlusMinus]", 
   StyleBox["i", "TI"], 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "-", 
     SuperscriptBox[
      StyleBox["k", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f836107-b46e-407e-35b1-79613d1b1344"],
 " and keep oscillating until ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "267182e5-332f-0e8d-4e0e-1bcf46da54d7"],
 " (ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "154e4ea8-041b-018f-4376-67f2adae53d5"],
 ", that is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "=", "4", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16f6496c-6c93-397b-3e8e-613605278841"],
 "), where the two eigenvalues ",
 StyleBox["and their eigenvectors", "TI"],
 " coalesce and the Liouvillian turns defective. Spectral merger comes first, \
eigenvector coalescence later: at the plotted ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "0.75"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e61f31d-599e-ef91-561e-eb475828b5fb"],
 " the spectrum already shows a single central maximum even though the poles \
are still a damped-oscillating pair. Deep in the Zeno regime the narrow slow \
pole dominates the central feature and its width scales as ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "591a22e5-07a0-ff20-0f39-bbcfb25ac20a"],
 ", so the rate tracked in the previous section reappears spectrally."
}], "Text",
 CellID->618395345,ExpressionUUID->"352cfa2a-2f90-a2db-5cd3-fc744a2af021"],

Cell[TextData[{
 "The two thresholds are easiest to see if we track the peak location itself. \
Plot the spectral maximum ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox["\[CapitalOmega]", "2"], "-", "2", 
    SuperscriptBox[
     StyleBox["k", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76eee8f9-1f6f-e745-1e95-01a39a1bcdaf"],
 " and, beside it, the pole frequency ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox["\[CapitalOmega]", "2"], "-", 
    SuperscriptBox[
     StyleBox["k", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d128122-8bef-720a-0b21-188c2d9a4150"],
 " against the ratio, marking where each reaches zero:"
}], "Text",
 CellID->309927853,ExpressionUUID->"04c061a2-1318-56b6-2cf0-780ca6ad3c9c"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Om", " ", "=", " ", "OmQpc"}], "}"}], ",", "\n", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", ",", " ", 
           RowBox[{"Re", "@", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"Om", "^", "2"}], " ", "-", " ", 
              RowBox[{"2", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"r", " ", "Om"}], ")"}], "^", "2"}]}]}], "]"}]}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "0", ",", " ", "1.5", ",", " ", "0.005"}], 
          "}"}]}], "]"}], ",", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", ",", " ", 
           RowBox[{"Re", "@", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"Om", "^", "2"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"r", " ", "Om"}], ")"}], "^", "2"}]}], "]"}]}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "0", ",", " ", "1.5", ",", " ", "0.005"}], 
          "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", "Dashed"}], 
         "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<spectral maximum\>\"", ",", 
        " ", "\"\<pole frequency\>\""}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "/", 
             RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}]}], "}"}], ",",
         " ", "Automatic"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<k/\[CapitalOmega] ratio\>\"", ",", 
        " ", "\"\<frequency\>\""}], "}"}]}], ",", "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<spectral peak reaches zero at k/\[CapitalOmega] = \
\!\(\*FractionBox[\(1\), SqrtBox[\(2\)]]\), poles only at k/\[CapitalOmega] = \
1\>\""}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[214]:= ",
 CellID->918875187,ExpressionUUID->"4605043a-8429-851b-6e3a-9e642dddec61"],

Cell[TextData[{
 "The solid curve, the spectral maximum, hits zero first at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]", "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17a8a95e-16a9-5185-3d57-4118a35c23ef"],
 "; the dashed curve, the pole frequency, survives to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6164d6ec-2035-6999-171b-cfb651c03be3"],
 ". Between the two gray markers the spectrum is already single-peaked while \
the trajectory still rings, so the five-ratio sweep above steps over both \
thresholds without landing on either."
}], "Text",
 CellID->39213332,ExpressionUUID->"6ca33e02-c939-75ea-1450-b06fe8cc5f30"],

Cell[TextData[{
 "What a lab actually records is the detector ",
 StyleBox["current", "TI"],
 " spectrum, the flat shot-noise floor with this ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["zz",
     FontSlant->"Plain"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22ebf147-b876-3430-52e8-e92139009f1a"],
 " riding on it (scaled by the measurement coupling); a fundamental result, \
the Korotkov-Averin bound, caps that current peak at four times the \
shot-noise background for a quantum-limited detector, the solid-state \
statement of the measurement limit that runs through this whole catalog."
}], "Text",
 CellID->2105127725,ExpressionUUID->"6cfbc0fa-05b7-6e65-1498-d9a4ac42354f"],

Cell[TextData[{
 "Two different knobs move two different crossovers, and they should not be \
confused: the ",
 StyleBox["measurement strength", "TI"],
 " ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5726608a-327b-32d7-7ede-79d4470f803d"],
 " sets coherent-oscillation versus Zeno-telegraph behaviour (shown above), \
while the detector ",
 StyleBox["transparency", "TI"],
 " sets whether the record is read as discrete electron jumps (a counting \
unravelling like the photon counter) or as this diffusive current. Both \
unravellings average to the one master equation above."
}], "Text",
 CellID->237912175,ExpressionUUID->"1988f3c5-ff1f-c744-4fb7-eaaefaabadae"],

Cell["Measurement-Induced Localization", "Subsection",
 CellID->1518115677,ExpressionUUID->"5f1f17bc-e58b-5e92-0524-8ef98c3e24f8"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " The general continuous measurement of an observable (here ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5792d973-b7d4-8b8a-7da1-d13cc266d9d0"],
 ") on an ",
 StyleBox["undriven", "TI"],
 " qubit, written in the catalog's measurement-strength convention:"
}], "Text",
 CellID->625578070,ExpressionUUID->"5edc8535-c3b1-a7f4-06e3-1d7ef6450dde"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", 
    StyleBox["k", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[Rho]", "TI"], "+", 
     StyleBox["\[Rho]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], "-", "2", 
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox[
     RowBox[{"d", "y"}], "TI"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], 
        StyleBox["z", "TI"]], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{
      FractionBox[
       StyleBox[
        RowBox[{"d", "W"}], "TI"], 
       RowBox[{"2", 
        SqrtBox[
         StyleBox["k", "TI"]]}]], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1195176726,ExpressionUUID->"6224b0f8-da78-eb38-13db-29a5dff2b602"],

Cell[TextData[{
 "With nothing pushing, the state's knowledge sharpens toward an eigenstate \
of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c93b30-61da-1cc4-77f6-b37a106f662e"],
 " at the rate set by ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50e14eb3-b435-065f-009f-67fd3dc06ca5"],
 ": each history collapses to one pole, the choice fixed only by the noise, \
while the average over histories stays balanced. Watch many histories make \
their choice."
}], "Text",
 CellID->394282870,ExpressionUUID->"4e168156-9322-bc9f-762d-191026d406e5"],

Cell[TextData[{
 "Turn off the drive and measure ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c24659b-7133-dc8c-65dc-7cc500c7a6d6"],
 " on a state leaning toward ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c508251-7fc9-b51c-546f-241b7a7d1c66"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["z", "TI"], "0"], "=", "0.5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1eef6872-bce7-1e04-4694-823c3492656e"],
 ". With no Hamiltonian, measurement alone drives each run to a ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30befcd9-b2cd-4711-6045-f582c7782a7b"],
 " eigenstate, ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75516dcf-8dc3-fc25-236e-84a92477c70f"],
 " or ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0310a516-2392-3bde-312f-3d5056248924"],
 ", and the record that drives the collapse is also what reads out which pole \
it chose. Fix the biased start, the measured operator, and a fine grid:"
}], "Text",
 CellID->1396453116,ExpressionUUID->"1f6c7faf-a6fa-97ca-4514-7608d28cfd10"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"z0Loc", " ", "=", " ", "0.5"}], ";", " ", 
  RowBox[{"x0Loc", " ", "=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"1", " ", "-", " ", 
     RowBox[{"z0Loc", "^", "2"}]}], "]"}]}], ";", " ", 
  RowBox[{"measZ", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "1.5", "]"}], " ", "Z"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dtLoc", " ", "=", " ", "0.002"}], ";", " ", 
  RowBox[{"tfLoc", " ", "=", " ", "2."}], ";", " ", 
  RowBox[{"gridLoc", " ", "=", " ", 
   RowBox[{"dtLoc", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", 
      RowBox[{"Round", "[", 
       RowBox[{"tfLoc", "/", "dtLoc"}], "]"}]}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[215]:= ",
 CellID->882685893,ExpressionUUID->"2573a629-b9de-50ac-5300-3873386b22f6"],

Cell[TextData[{
 "One run reads the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59197c34-7185-90b0-0f27-767e0031e29a"],
 " component throughout; run a fan of them, and beside them solve the master \
equation for the record-blind mean:"
}], "Text",
 CellID->1562244888,ExpressionUUID->"2c633381-a2a9-ed02-5410-aaead75db468"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"locZ", "[", "seed_", "]"}], " ", ":=", " ", 
   RowBox[{"zOf", "@", 
    RowBox[{
     RowBox[{"trajectory", "[", 
      RowBox[{
       RowBox[{"blochState", "[", 
        RowBox[{"x0Loc", ",", " ", "0", ",", " ", "z0Loc"}], "]"}], ",", " ", 
       
       RowBox[{"0", " ", "id2"}], ",", " ", 
       RowBox[{"{", "measZ", "}"}], ",", " ", 
       RowBox[{"{", "1.", "}"}], ",", " ", 
       RowBox[{"{", "}"}], ",", " ", "dtLoc", ",", " ", "tfLoc", ",", " ", 
       "seed"}], "]"}], "[", "\"\<states\>\"", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fanLoc", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"locZ", "[", "s", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "60"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"locMeanRun", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{"0", " ", "id2"}], ",", " ", 
     RowBox[{"{", "measZ", "}"}], ",", " ", 
     RowBox[{"blochState", "[", 
      RowBox[{"x0Loc", ",", " ", "0", ",", " ", "z0Loc"}], "]"}], ",", " ", 
     "tfLoc"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"meanLoc", " ", "=", " ", 
   RowBox[{"zOf", "[", 
    RowBox[{"locMeanRun", " ", "/@", " ", "gridLoc"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[216]:= ",
 CellID->2118942829,ExpressionUUID->"60c43628-0d8b-12d9-10fb-a872a43e6023"],

Cell[TextData[{
 "Now visualize the fan against that conserved mean: every displayed path \
approaches a pole while the thick master-equation curve holds flat at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["z", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f555f5b-d3f6-518f-056b-5704e58323d5"],
 ":"
}], "Text",
 CellID->1388287869,ExpressionUUID->"3145b7cb-6bdc-88b3-677a-2e950e6eda99"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"gridLoc", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], " ", "/@",
       " ", "fanLoc"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"Opacity", "[", "0.12", "]"}]}], "]"}]}]}], "]"}], ",", "\n", 
   " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"gridLoc", ",", " ", "meanLoc"}], "}"}], "]"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}]}], "]"}]}]}], "]"}], ",", "\n", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]\[Sigma]z\[RightAngleBracket]\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<each run approaches a pole; the master-equation mean holds at \
z0\>\""}]}], "]"}]], "Input",
 CellLabel->"In[217]:= ",
 CellID->1303133385,ExpressionUUID->"6b7074b7-b7c4-ad31-1900-6df0c276f41b"],

Cell[TextData[{
 "By the finite endpoint every displayed run is numerically close to a pole, \
while the thick curve never leaves ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["z", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b848cdb-7c95-016b-19bb-2585752053b1"],
 ": the dephasing ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "479e0012-80c3-e229-6da5-9a5c3177b173"],
 " leaves the populations untouched, so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d6e3eb6-fa93-dc86-6b15-b7f3ff27a6ec"],
 " is conserved on average. In continuous time, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43bbad2d-592e-7807-7158-457758db4b6d"],
 " is a bounded martingale and converges asymptotically to ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6945d0ce-c536-08cf-1f7a-c9abecc35a15"],
 "; it does not hit a pole at a generic finite time. The limiting split \
follows from martingale convergence (equivalently, optional-stopping \
arguments applied to bounded approximating stopping times): ",
 Cell[BoxData[
  RowBox[{"\|01d53c", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["z", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], "\[Infinity]", 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["z", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fccf01f-c27b-aa81-65f3-ea58f70ff8eb"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], "+"], "-", 
   SubscriptBox[
    StyleBox["p", "TI"], "-"], "=", 
   SubscriptBox[
    StyleBox["z", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "580a63e8-e8bd-fc69-080a-7ab58949c6b3"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], "+"], "+", 
   SubscriptBox[
    StyleBox["p", "TI"], "-"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e444979-635e-5aae-467c-612316eb28f4"],
 " give ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], "\[PlusMinus]"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", 
    SubscriptBox[
     StyleBox["z", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5291a49d-a239-bb17-02ae-3dc6d7cd067d"],
 ". Born is a theorem about the limiting martingale, not a fraction the \
finite run count has to fit. The symmetric ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["z", "TI"], "0"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ed3e0f7-5290-ff26-56e0-f9b1672ac20c"],
 " start, the state the earlier examples called ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e38d601-1464-7519-07c7-c86b9d115c63"],
 ", is the equal-weight special case."
}], "Text",
 CellID->1083493527,ExpressionUUID->"0fc3dc78-1302-6f10-35f0-d622a6b7327a"],

Cell[TextData[{
 "The record is what a detector actually delivers, and it both drives the \
collapse and reads it out. Accumulate each run's record into the integrated \
readout ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubsuperscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"]], 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a61f55e-757a-9228-7a1e-ed187c0ce172"],
 " and keep the pole it lands on:"
}], "Text",
 CellID->43887772,ExpressionUUID->"792e178f-59c5-2aa3-28d5-8ee958707889"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"readOut", "[", "seed_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"run", " ", "=", " ", 
       RowBox[{"trajectory", "[", 
        RowBox[{
         RowBox[{"blochState", "[", 
          RowBox[{"x0Loc", ",", " ", "0", ",", " ", "z0Loc"}], "]"}], ",", 
         " ", 
         RowBox[{"0", " ", "id2"}], ",", " ", 
         RowBox[{"{", "measZ", "}"}], ",", " ", 
         RowBox[{"{", "1.", "}"}], ",", " ", 
         RowBox[{"{", "}"}], ",", " ", "dtLoc", ",", " ", "tfLoc", ",", " ", 
         "seed"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Accumulate", "[", 
          RowBox[{"Flatten", "@", 
           RowBox[{"run", "[", "\"\<record\>\"", "]"}]}], "]"}], ",", " ", 
         "0."}], "]"}], ",", " ", 
       RowBox[{"Sign", "[", 
        RowBox[{"Last", "@", 
         RowBox[{"zOf", "@", 
          RowBox[{"run", "[", "\"\<states\>\"", "]"}]}]}], "]"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"readData", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"readOut", "[", "s", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "400"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[218]:= ",
 CellID->2123394380,ExpressionUUID->"106526ab-6ace-99f4-401a-bff50f78ebde"],

Cell["\<\
Now visualize the integrated record, one path per run, colored by the pole \
the run reached: each single increment is almost pure noise, but the \
accumulated record fans into two well-separated groups:\
\>", "Text",
 CellID->705610480,ExpressionUUID->"14f1cae1-901f-fe6e-3c8e-e3cb21abc4b4"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"show", " ", "=", " ", 
     RowBox[{"readData", "[", 
      RowBox[{"[", 
       RowBox[{";;", " ", "50"}], "]"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"gridLoc", ",", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "]"}], " ", "&"}], " ", "/@",
       " ", "show"}], ",", "\n", "  ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", ">", " ", "0"}], ",", " ", 
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"ColorData", "[", 
              RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
             RowBox[{"Opacity", "[", "0.45", "]"}]}], "]"}], ",", " ", 
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"ColorData", "[", 
              RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
             RowBox[{"Opacity", "[", "0.45", "]"}]}], "]"}]}], "]"}], " ", 
         "&"}], " ", "/@", " ", "show"}], ")"}]}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", " ", "\"\<integrated record  J(t)\>\""}], 
       "}"}]}], ",", " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<the integrated record splits by the pole each run \
chose\>\""}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[219]:= ",
 CellID->1139416472,ExpressionUUID->"20e5bc00-ef5d-9182-509a-366d8ae9e3e8"],

Cell[TextData[{
 "The sign of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0eb778b1-5bb9-ca6f-364d-71fb5e4d98b5"],
 " is the readout's verdict on the eigenstate; measure how often it is right \
as the integration window grows:"
}], "Text",
 CellID->432212328,ExpressionUUID->"60fa5ffe-638f-3fb5-109a-56b8163b859f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fidLoc", "[", "T_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"iT", " ", "=", " ", 
       RowBox[{
        RowBox[{"Round", "[", 
         RowBox[{"T", "/", "dtLoc"}], "]"}], " ", "+", " ", "1"}]}], "}"}], ",",
      " ", 
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Boole", "[", 
         RowBox[{
          RowBox[{"Sign", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", "iT"}], "]"}], "]"}], "]"}], " ", "==", 
          " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "&"}], " ", "/@", 
       " ", "readData"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"T", ",", " ", 
       RowBox[{"fidLoc", "[", "T", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"T", ",", " ", "0.05", ",", " ", "tfLoc", ",", " ", "0.05"}], 
      "}"}]}], "]"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0.45", ",", " ", "1.02"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "500"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<integration time T\>\"", ",", 
      " ", "\"\<assignment fidelity\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<longer integration reads the eigenstate out with \
certainty\>\""}]}], "]"}]}], "Input",
 CellLabel->"In[220]:= ",
 CellID->1877047781,ExpressionUUID->"730b2763-752d-95c0-2108-bf4d7cd9ff2a"],

Cell[TextData[{
 "For these 400 seeded runs the empirical fidelity reaches one by the \
displayed endpoint. That is a finite-sample observation, not a finite-time \
certainty: at any fixed duration a Gaussian-noise record retains a nonzero \
error probability, while the assignment error tends to zero asymptotically as \
more record accumulates. Two things keep this honest rather than a lookup. \
The limiting eigenstate is not fixed in advance; it is selected by the same \
record used to infer it. And the flat-weight integral ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fb8ba9f-9118-d887-4547-33d92092aaed"],
 " is not the sharpest estimator: the conditional ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04257d5a-c533-40c1-2ddb-7507ecc6122b"],
 " of the fan above is the Bayesian-optimal filter, which a uniform integral \
only approximates. This trajectory-read-from-its-own-record is what ",
 ButtonBox["Murch, Weber, Macklin, and Siddiqi",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/1305.7270"], None}],
 " tracked on a superconducting qubit, reconstructing the conditioned state \
from the readout and confirming it by tomography."
}], "Text",
 CellID->1901365905,ExpressionUUID->"3e9a3b8c-0d9b-39c6-66b9-b2d6a42f8b2c"],

Cell["Quantum Kalman Filter: Tracking an Oscillator", "Subsection",
 CellID->1056348074,ExpressionUUID->"57c094f8-e1f7-16c3-7dff-0da597827c29"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Continuously measure the position of a harmonic oscillator; a Gaussian \
state stays Gaussian and the stochastic master equation collapses to a \
quantum Kalman-Bucy filter. The conditional covariance ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53c10e17-89f4-5846-01fe-a0512f812aac"],
 " obeys a ",
 StyleBox["deterministic", "TI"],
 " matrix Riccati equation, independent of the record,"
}], "Text",
 CellID->5121024,ExpressionUUID->"4f08220d-2a73-b203-7537-c4574f070169"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox["\[CapitalSigma]", "."], "=", 
    StyleBox["A", "TI"], "\[CapitalSigma]", "+", "\[CapitalSigma]", 
    SuperscriptBox[
     StyleBox["A", "TI"], 
     StyleBox["T", "TI"]], "+", 
    StyleBox["D", "TI"], "-", "\[CapitalSigma]", "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["T", "TI"]], 
    StyleBox["C", "TI"], "\[ThinSpace]", "\[CapitalSigma]"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1201452384,ExpressionUUID->"111d4832-3a0a-d5b2-4723-627cbfbcbf98"],

Cell["\<\
with the free-rotation drift, the position readout, and the measurement \
back-action\
\>", "Text",
 CellID->1321205547,ExpressionUUID->"1845e666-64b6-1241-487a-f8400d4360ab"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["A", "TI"], "=", "(", GridBox[{
      {"0", "1"},
      {
       RowBox[{"-", "1"}], "0"}
     }], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["C", "TI"], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"2", 
         SqrtBox[
          StyleBox["k", "TI"]]}], "0"}
      }], ")"}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["D", "TI"], "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {"0", "0"},
        {"0", 
         StyleBox["k", "TI"]}
       }], ")"}], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1168360678,ExpressionUUID->"1968941f-a9d2-0fb7-4f17-0e58c867559d"],

Cell[TextData[{
 "In the three independent entries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xx",
      FontSlant->"Plain"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xp",
      FontSlant->"Plain"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["pp",
      FontSlant->"Plain"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1aac0bc6-af4d-b58b-4a53-a2a3caf91fd1"],
 " of ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a712f16-d19b-4a25-1a0e-c753e02e190f"],
 " this reads"
}], "Text",
 CellID->1790612322,ExpressionUUID->"53fb696e-29db-c2cc-0198-8148486f9016"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    FractionBox[
     StyleBox["d", "TI"], 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]], "(", GridBox[{
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["xx",
         FontSlant->"Plain"]]},
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["xp",
         FontSlant->"Plain"]]},
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["pp",
         FontSlant->"Plain"]]}
     }], ")", "=", "(", GridBox[{
      {
       RowBox[{"2", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xp",
          FontSlant->"Plain"]], "-", "4", 
        StyleBox["k", "TI"], "\[ThinSpace]", 
        SubsuperscriptBox["\[CapitalSigma]", 
         StyleBox["xx",
          FontSlant->"Plain"], "2"]}]},
      {
       RowBox[{
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["pp",
          FontSlant->"Plain"]], "-", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xx",
          FontSlant->"Plain"]], "-", "4", 
        StyleBox["k", "TI"], "\[ThinSpace]", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xx",
          FontSlant->"Plain"]], 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xp",
          FontSlant->"Plain"]]}]},
      {
       RowBox[{
        StyleBox["k", "TI"], "-", "2", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox["xp",
          FontSlant->"Plain"]], "-", "4", 
        StyleBox["k", "TI"], "\[ThinSpace]", 
        SubsuperscriptBox["\[CapitalSigma]", 
         StyleBox["xp",
          FontSlant->"Plain"], "2"]}]}
     }], ")"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->26037494,ExpressionUUID->"37c87ba4-2338-bc26-5dc8-720e56b2070c"],

Cell[TextData[{
 "the quadratic ",
 Cell[BoxData[
  RowBox[{"-", "4", 
   StyleBox["k", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "\[CenterEllipsis]", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "038c2d24-7693-7bfc-31b3-c48e032649c6"],
 " terms being the information gain ",
 Cell[BoxData[
  RowBox[{"-", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["T", "TI"]], 
   StyleBox["C", "TI"], "\[CapitalSigma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b3c81a1-c373-b6e1-0ac3-180af6071ccb"],
 ", which is what makes this a Riccati and not a linear Lyapunov equation. \
Balanced against the back-action (",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["D", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ffd377e-a04d-810f-3582-af3bd1f9d055"],
 "), that gain relaxes the uncertainty to a steady value fixed only by how \
hard you watch, squeezing it below the oscillator's own quietest spread; the \
running best-guess then follows a linear equation driven by the record. Track \
the shrinking uncertainty and check its standstill."
}], "Text",
 CellID->87820654,ExpressionUUID->"78b094ae-e1b9-bff8-284f-0d0b904d05c2"],

Cell[TextData[{
 "Continuously measure the position of a harmonic oscillator and you can \
track it with a Gaussian estimate: a conditional mean and covariance. The \
covariance obeys a ",
 StyleBox["deterministic", "TI"],
 " Riccati equation, independent of the record, set only by the measurement \
strength. It is the warm particle's covariance law from Part Three, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox["\[CapitalSigma]", "."], "=", 
   StyleBox["A", "TI"], "\[CapitalSigma]", "+", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["T", "TI"]], "+", 
   StyleBox["D", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34420a65-0085-ff13-5c71-ac4fb131c279"],
 ", now carrying the measurement's information gain ",
 Cell[BoxData[
  RowBox[{"-", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["T", "TI"]], 
   StyleBox["C", "TI"], "\[CapitalSigma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33d8432c-7aae-24d4-61f8-5b767f588e3e"],
 ": diffusion widened that blob to thermal, watching squeezes this one below \
the ground state. Set the strength and integrate the Riccati equations from a \
broad start:"
}], "Text",
 CellID->668477954,ExpressionUUID->"7102de1b-2c49-6276-2731-d04545fc315c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kKal", " ", "=", " ", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"riccati", " ", "=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"vx", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"vc", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"4", " ", "kKal", " ", 
          RowBox[{
           RowBox[{"vx", "[", "t", "]"}], "^", "2"}]}]}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"vc", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"vp", "[", "t", "]"}], " ", "-", " ", 
         RowBox[{"vx", "[", "t", "]"}], " ", "-", " ", 
         RowBox[{"4", " ", "kKal", " ", 
          RowBox[{"vx", "[", "t", "]"}], " ", 
          RowBox[{"vc", "[", "t", "]"}]}]}]}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"vp", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{"vc", "[", "t", "]"}]}], " ", "+", " ", "kKal", " ", "-", 
         " ", 
         RowBox[{"4", " ", "kKal", " ", 
          RowBox[{
           RowBox[{"vc", "[", "t", "]"}], "^", "2"}]}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"vx", "[", "0", "]"}], " ", "==", " ", "3."}], ",", " ", 
       RowBox[{
        RowBox[{"vc", "[", "0", "]"}], " ", "==", " ", "0."}], ",", " ", 
       RowBox[{
        RowBox[{"vp", "[", "0", "]"}], " ", "==", " ", "3."}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"vx", ",", " ", "vc", ",", " ", "vp"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "12"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[221]:= ",
 CellID->658691238,ExpressionUUID->"3f3745d9-f640-89cf-66cd-5c8283fadb15"],

Cell[TextData[{
 "Assemble the covariance matrix at time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2af3e211-783e-5495-5a80-045b79cb3eff"],
 " from the Riccati solution:"
}], "Text",
 CellID->1593411516,ExpressionUUID->"526c503f-6148-6cb6-0214-4a7910fd369c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"covariance", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"riccati", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"riccati", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", "t", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"riccati", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"riccati", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}]}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[222]:= ",
 CellID->472705648,ExpressionUUID->"3a901ca6-02d7-1d1b-6aaf-9500b7626461"],

Cell["Compare the position variance at the start and at the end:", "Text",
 CellID->651685264,ExpressionUUID->"0decacba-7d10-76c3-3b93-45e474a55c29"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"riccati", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "0", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"riccati", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "12", "]"}]}], "}"}]], "Input",
 CellLabel->"In[223]:= ",
 CellID->767085021,ExpressionUUID->"256534ec-e492-cc88-531a-adc98d2496d2"],

Cell["\<\
The position variance has shrunk from its broad start below the ground-state \
variance of one half: continuous measurement conditionally squeezes it below \
the zero-point level. Two checks. First, the conditional state is pure, its \
uncertainty product at the Heisenberg floor:\
\>", "Text",
 CellID->624501814,ExpressionUUID->"106dd93e-13c5-b1cf-4012-d178a6710315"],

Cell[BoxData[
 RowBox[{"Det", "@", 
  RowBox[{"covariance", "[", "12.", "]"}]}]], "Input",
 CellLabel->"In[224]:= ",
 CellID->1504331274,ExpressionUUID->"510b310d-dc97-d591-0708-a956d523bffb"],

Cell["\<\
The determinant is within the ODE tolerance of the Heisenberg floor; the \
continuum conditional state is pure, and the numerical solution converges \
toward that value. Second, the steady covariance is independently the fixed \
point of the Riccati equation:\
\>", "Text",
 CellID->1994044242,ExpressionUUID->"3a88f114-48ba-1446-6ab7-e95e694f7eac"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"N", "[", 
    RowBox[{"vx", " ", "/.", " ", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"2", " ", "vc"}], " ", "-", " ", 
            RowBox[{"4", " ", "kKal", " ", 
             RowBox[{"vx", "^", "2"}]}]}], " ", "==", " ", "0"}], ",", " ", 
          RowBox[{
           RowBox[{"vp", " ", "-", " ", "vx", " ", "-", " ", 
            RowBox[{"4", " ", "kKal", " ", "vx", " ", "vc"}]}], " ", "==", 
           " ", "0"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"-", "2"}], " ", "vc"}], " ", "+", " ", "kKal", " ", "-",
             " ", 
            RowBox[{"4", " ", "kKal", " ", 
             RowBox[{"vc", "^", "2"}]}]}], " ", "==", " ", "0"}], ",", " ", 
          RowBox[{"vx", " ", ">", " ", "0"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"vx", ",", " ", "vc", ",", " ", "vp"}], "}"}], ",", " ", 
        "Reals"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"riccati", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "12.", "]"}]}], "}"}]], "Input",
 CellLabel->"In[225]:= ",
 CellID->1520445855,ExpressionUUID->"14b48af2-5d27-861c-3c4b-23bc54d3ed66"],

Cell["The fixed point matches the late value.", "Text",
 CellID->1470891495,ExpressionUUID->"72f98829-a4e0-9e42-2286-2272cc9ae4a8"],

Cell[TextData[{
 "That fixed point has a clean closed form. With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", 
   SqrtBox[
    RowBox[{"1", "+", "4", 
     SuperscriptBox[
      StyleBox["k", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1350650b-6691-6e3e-4160-7d5513243504"],
 ","
}], "Text",
 CellID->1799794391,ExpressionUUID->"532d51c4-b79b-7573-02d3-48a1c22e5c59"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xx",
      FontSlant->"Plain"]], "=", 
    FractionBox["1", 
     SqrtBox[
      RowBox[{"2", 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "+", 
        StyleBox["s", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}]]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xp",
      FontSlant->"Plain"]], "=", 
    FractionBox[
     RowBox[{
      StyleBox["s", "TI"], "-", "1"}], 
     RowBox[{"4", 
      StyleBox["k", "TI"]}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["pp",
      FontSlant->"Plain"]], "=", 
    RowBox[{
     StyleBox["s", "TI"], "\[ThinSpace]", 
     SubscriptBox["\[CapitalSigma]", 
      StyleBox["xx",
       FontSlant->"Plain"]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1171173153,ExpressionUUID->"02713c5f-c8e5-0f11-320e-b618e890527b"],

Cell[TextData[{
 "and it sits exactly on the Heisenberg floor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalSigma]", "=", "1", "/", 
   "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00749321-443e-2ca3-300b-0a8b6dcb7689"],
 " for every measurement strength. Put the closed form beside the numerical \
fixed point:"
}], "Text",
 CellID->900360919,ExpressionUUID->"639faa00-a42a-3ba8-11a4-4c6dcddc89f2"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"4", " ", 
        RowBox[{"kKal", "^", "2"}]}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"TableForm", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"1", " ", "+", " ", "s"}], ")"}]}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"s", " ", "-", " ", "1"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"4", " ", "kKal"}], ")"}]}], ",", " ", 
         RowBox[{"s", "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"1", " ", "+", " ", "s"}], ")"}]}], "]"}]}]}], "}"}], ",",
        " ", 
       RowBox[{"Through", "[", 
        RowBox[{"riccati", "[", "12.", "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"TableHeadings", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<closed form\>\"", ",", 
          " ", "\"\<Riccati at t = 12\>\""}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(\[CapitalSigma]\), \(xx\)]\)\>\"", 
          ",", " ", "\"\<\!\(\*SubscriptBox[\(\[CapitalSigma]\), \
\(xp\)]\)\>\"", ",", 
          " ", "\"\<\!\(\*SubscriptBox[\(\[CapitalSigma]\), \(pp\)]\)\>\""}], 
         "}"}]}], "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[226]:= ",
 CellID->1309857001,ExpressionUUID->"157f93fd-228f-3ab7-4304-0aa7573b889d"],

Cell[TextData[{
 "The two rows agree: position is conditionally squeezed below one half, \
momentum broadens to hold the product at the floor, and the tilt ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["xp",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "671b21e8-1ced-259b-0d38-b8b294998fe1"],
 " carries the correlation the measurement builds. The conditional state is \
pure at any watching strength, not only the one plotted."
}], "Text",
 CellID->2058064877,ExpressionUUID->"0804b894-7cc5-dcd3-383b-31de7571a639"],

Cell[TextData[{
 "The conditional state is Gaussian, so picture it as a one-sigma ellipse: \
the covariance ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30585328-1edb-3b29-6078-4b729b6f8673"],
 " around a center ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "028df322-620d-9ccb-32b2-ea8c17b9e611"],
 " traces ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["c", "TI"], "+", 
    SuperscriptBox["\[CapitalSigma]", 
     RowBox[{"1", "/", "2"}]], "{", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["s", "TI"]}], ",", 
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["s", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11eedd29-5af3-1cdc-4795-d5735e866626"],
 " as ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "553e565f-4fcb-4d17-7cc6-48196a7e147d"],
 " runs the circle. Define it:"
}], "Text",
 CellID->1911790330,ExpressionUUID->"7f6c6217-8665-62c8-2513-845133103012"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"covarianceEllipse", "[", 
    RowBox[{"c_", ",", " ", "\[CapitalSigma]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pts", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"c", " ", "+", " ", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"MatrixPower", "[", 
             RowBox[{"\[CapitalSigma]", ",", " ", 
              RowBox[{"1", "/", "2"}]}], "]"}], "]"}], " ", ".", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", "s", "]"}], ",", " ", 
             RowBox[{"Sin", "[", "s", "]"}]}], "}"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"s", ",", " ", "0", ",", " ", 
           RowBox[{"2", " ", "Pi"}], ",", " ", "0.12"}], "}"}]}], "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"Append", "[", 
      RowBox[{"pts", ",", " ", 
       RowBox[{"First", "[", "pts", "]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[227]:= ",
 CellID->1010700267,ExpressionUUID->"3f4879b1-2b62-b5b2-6548-70fb4e141f98"],

Cell["\<\
Now visualize the covariance ellipse over time, broad at first and then \
tightening and tilting to a small steady one:\
\>", "Text",
 CellID->1433985495,ExpressionUUID->"7d218d48-f517-61a3-24de-2515fca23389"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"trackTimes", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0", ",", " ", "0.1", ",", " ", "0.25", ",", " ", "0.5", ",", " ", "1", ",",
      " ", "2", ",", " ", "4", ",", " ", "8", ",", " ", "12"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Thick", ",", " ", 
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"ColorData", "[", "\"\<SunsetColors\>\"", "]"}], "[", 
             RowBox[{
              RowBox[{"First", "[", "#2", "]"}], "/", 
              RowBox[{"Length", "[", "trackTimes", "]"}]}], "]"}], ",", " ", 
            RowBox[{"Line", "@", 
             RowBox[{"covarianceEllipse", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
               RowBox[{"covariance", "[", "#1", "]"}]}], "]"}]}]}], "}"}], 
          " ", "&"}], ",", " ", "trackTimes"}], "]"}]}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "400"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<position\>\"", ",", " ", "\"\<momentum\>\""}], "}"}]}], ",",
      "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<measurement shrinks the covariance to a tight, tilted, steady \
one\>\""}]}], "]"}], ",", "\n", " ", 
   RowBox[{"SwatchLegend", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ColorData", "[", "\"\<SunsetColors\>\"", "]"}], "[", 
        RowBox[{"#", "/", 
         RowBox[{"Length", "[", "trackTimes", "]"}]}], "]"}], " ", "&"}], " ",
       "/@", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "trackTimes", "]"}], "]"}]}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<t = \>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
      "trackTimes"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[228]:= ",
 CellID->308737233,ExpressionUUID->"68418108-62e2-e866-187e-19521694bb4c"],

Cell["\<\
This conditional estimate is exactly what a lab computes in real time to \
track a trapped particle or membrane, more precisely than its own zero-point \
spread.\
\>", "Text",
 CellID->1903477021,ExpressionUUID->"01703913-adda-f952-370f-b15cc46ccbb8"],

Cell[TextData[{
 "The covariance is only half the filter. It says how sharp the estimate is; \
the other half is the estimate itself, the conditional ",
 StyleBox["mean", "TI"],
 ", threading through the noisy record in real time. Watch the filter track. \
Set a fine grid and draw one record's worth of Wiener increments:"
}], "Text",
 CellID->1244942650,ExpressionUUID->"6126f6d0-c79c-20ba-10dd-ef9df2297280"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kalDt", " ", "=", " ", "0.004"}], ";", " ", 
  RowBox[{"kalN", " ", "=", " ", "1500"}], ";", " ", 
  RowBox[{"kalGrid", " ", "=", " ", 
   RowBox[{"kalDt", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "kalN"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kalDW", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"Sqrt", "[", "kalDt", "]"}]}], "]"}], ",", " ", "kalN"}], 
      "]"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[229]:= ",
 CellID->1429544953,ExpressionUUID->"1e4879c1-44de-859e-4648-70ab6d68efe4"],

Cell[TextData[{
 "A note on the constant ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d2a80d4-ca9b-9dca-1b29-1991ef2fe710"],
 ". In the catalog's measurement-strength convention the monitored leak is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["x", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56de89fa-72f1-8b5c-7ee5-20a40685d9a6"],
 ", so the informative terms carry ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "081b024f-dee7-bb3c-3838-a428da930606"],
 " and the mean gain is ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   StyleBox["V", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3068938a-aea6-7f4c-6017-0ad7cb534596"],
 "; the record noise and the gain must then be consistent, which pins the \
record normalization below. What the code calls a \"reference conditional \
mean\" is the physical conditional mean of one simulated record, driven by \
its own innovation ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59143b51-5090-fe62-0f2b-b31b612ac548"],
 " with that gain. Roll it out from a displaced start:"
}], "Text",
 CellID->114240660,ExpressionUUID->"4b8a926c-2b03-23e8-7989-14364eb67132"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kalTrue", " ", "=", " ", 
   RowBox[{"FoldList", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xp", ",", " ", "jw"}], "}"}], ",", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"j", " ", "=", " ", 
            RowBox[{"jw", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
           RowBox[{"dw", " ", "=", " ", 
            RowBox[{"jw", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"xp", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"xp", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", "kalDt"}], " ", "+", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
             RowBox[{
              RowBox[{"riccati", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"kalGrid", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "dw"}]}], ",", 
           "\n", "      ", 
           RowBox[{
            RowBox[{"xp", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"xp", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "kalDt"}], " ", "+", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
             RowBox[{
              RowBox[{"riccati", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "[", 
              RowBox[{"kalGrid", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "dw"}]}]}], 
          "}"}]}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"3.", ",", " ", "0."}], "}"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", "kalN", "]"}], ",", " ", "kalDW"}], "}"}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[230]:= ",
 CellID->406013316,ExpressionUUID->"0eb42765-6752-c125-364b-bf4f12e4900f"],

Cell[TextData[{
 "All the observer ever sees is the record, the signal ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dda19df-f0ae-deb2-6bf9-90988158a498"],
 " buried in white noise. Consistency with the ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40683ad5-3e3c-3dc9-7017-b39fbbce8713"],
 "-Riccati and the ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b8f60bd-75aa-c5dc-49b5-79e77c5caf26"],
 " gain fixes its noise level at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["y", "TI"], "=", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SqrtBox[
     StyleBox["k", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fc740cd-cbf6-6955-05fd-5996ed833bbf"],
 ":"
}], "Text",
 CellID->491451350,ExpressionUUID->"003aef4b-20aa-e832-31d9-0715515cbb18"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kalRec", " ", "=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#1", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "kalDt"}], " ", "+", " ", 
       RowBox[{"#2", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"Sqrt", "[", "kKal", "]"}]}], ")"}]}]}], " ", "&"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Most", "@", "kalTrue"}], ",", " ", "kalDW"}], "}"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[231]:= ",
 CellID->1571111005,ExpressionUUID->"28e0bad7-cafc-1653-589f-3390ee897cb9"],

Cell[TextData[{
 "Now the filter. Write its running estimates of the conditional means as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2580c3d6-5855-812a-53bf-da9059e1d070"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56436948-eb78-7da0-7e70-81158e0d478a"],
 ", without the operator hat that marks the true expectations ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["x", "TI"], "^"], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["p", "TI"], "^"], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d2fa041-c708-9d58-44d4-3a2af2a2e7a2"],
 " the record carries, so the innovation below is exactly their difference. \
Start it from a deliberately ",
 StyleBox["wrong", "TI"],
 " guess for the position and feed it only the record: at each step it forms \
its own innovation, the record minus its own prediction, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   OverscriptBox[
    StyleBox["W", "TI"], "^"], "=", "2", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["y", "TI"], "-", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77a399cd-5599-60ee-1d50-10975c2c3234"],
 ", and corrects the estimate with the Riccati gain,"
}], "Text",
 CellID->132272857,ExpressionUUID->"225dc93e-a235-4cfc-5262-e17bd7c016c6"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "=", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["p", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "2", 
    SqrtBox[
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["xx",
      FontSlant->"Plain"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    OverscriptBox[
     StyleBox["W", "TI"], "^"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      StyleBox["p", "TI"], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        StyleBox["x", "TI"], "\[VeryThinSpace]", 
        StyleBox["\[RightAngleBracket]",
         SpanMaxSize->1]}]}], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{"2", 
      SqrtBox[
       StyleBox["k", "TI"]], "\[ThinSpace]", 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["xp",
        FontSlant->"Plain"]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      OverscriptBox[
       StyleBox["W", "TI"], "^"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1230643425,ExpressionUUID->"6f2e1950-aca6-616f-16d5-911dc55333b5"],

Cell[TextData[{
 "the deterministic Riccati covariance ",
 Cell[BoxData[
  RowBox[{"\[CapitalSigma]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "716ae4bc-5935-f42e-2769-fde658c1df74"],
 " setting the gain:"
}], "Text",
 CellID->1862623319,ExpressionUUID->"59aa617b-186b-0315-0faa-7925991e6e7f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kalFilt", " ", "=", " ", 
   RowBox[{"FoldList", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xp", ",", " ", "jdy"}], "}"}], ",", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"j", " ", "=", " ", 
            RowBox[{"jdy", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
           RowBox[{"dwf", " ", "=", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"jdy", "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
               RowBox[{
                RowBox[{"xp", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "kalDt"}]}], 
              ")"}]}]}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"xp", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"xp", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", "kalDt"}], " ", "+", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
             RowBox[{
              RowBox[{"riccati", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"kalGrid", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "dwf"}]}], ",", 
           "\n", "      ", 
           RowBox[{
            RowBox[{"xp", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"xp", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "kalDt"}], " ", "+", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
             RowBox[{
              RowBox[{"riccati", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "[", 
              RowBox[{"kalGrid", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "dwf"}]}]}], 
          "}"}]}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "3."}], ",", " ", "0."}], "}"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", "kalN", "]"}], ",", " ", "kalRec"}], "}"}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[232]:= ",
 CellID->187926588,ExpressionUUID->"008b4284-ba53-483f-3089-5bee3fe61b05"],

Cell[TextData[{
 "Read the ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1", 
   StyleBox["\[Sigma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c0a4c18-9cc5-5190-640a-6642157023fa"],
 " band off the covariance:"
}], "Text",
 CellID->835753090,ExpressionUUID->"1ec90d37-5b76-64dd-46f6-a5715e034e27"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kalBand", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"riccati", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", "#", "]"}], "]"}], " ", "&"}], 
    " ", "/@", " ", "kalGrid"}]}], ";"}]], "Input",
 CellLabel->"In[233]:= ",
 CellID->820508465,ExpressionUUID->"0f4a94b8-2093-0aa7-3549-0de25126588d"],

Cell[TextData[{
 "Now visualize the tracking: the reference conditional mean and the estimate \
from the incorrect prior. The deliberately wrong initial estimate is outside \
its own ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1", 
   StyleBox["\[Sigma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "746ef244-02b1-295f-1c15-f42eb7447ba5"],
 " band; the band quantifies conditional covariance under the assumed filter \
model, not uncertainty over an arbitrarily misspecified initial mean. The \
record then pulls the estimate toward the reference path:"
}], "Text",
 CellID->218374495,ExpressionUUID->"16a579b4-853c-ad3d-3e5b-70fe2ccef407"],

Cell[BoxData[
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Show", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"kalGrid", ",", " ", 
            RowBox[{
             RowBox[{"kalFilt", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
             "kalBand"}]}], "}"}], "]"}], ",", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"kalGrid", ",", " ", 
            RowBox[{
             RowBox[{"kalFilt", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
             "kalBand"}]}], "}"}], "]"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"Filling", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", " ", "->", " ", 
          RowBox[{"{", "2", "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
          RowBox[{"Opacity", "[", "0.15", "]"}]}], "]"}]}]}], "]"}], ",", 
     "\n", "  ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"kalGrid", ",", " ", 
            RowBox[{"kalTrue", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "}"}], "]"}], ",",
          " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"kalGrid", ",", " ", 
            RowBox[{"kalFilt", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "}"}], "]"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{"Thick", ",", " ", 
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Thick", ",", " ", 
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", " ", "1"}], "]"}]}], "]"}]}], "}"}]}]}], 
      "]"}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", " ", "\"\<position\>\""}], "}"}]}], ",", 
     " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<the filter locks onto the reference conditional mean from the \
record alone\>\""}]}], "]"}], ",", "\n", " ", 
   RowBox[{"LineLegend", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ColorData", "[", 
        RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"ColorData", "[", 
        RowBox[{"97", ",", " ", "1"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<reference conditional mean\>\"", ",", 
       " ", "\"\<estimate from wrong prior \[PlusMinus]\[Sigma]\>\""}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[234]:= ",
 CellID->106949524,ExpressionUUID->"3d0d0eda-2f65-a967-6b32-a7844a11f84d"],

Cell["\<\
The estimate begins wildly wrong (opposite sign and outside its stated band), \
then the record pulls it close to the reference conditional mean while the \
band approaches the steady conditional width: this observable model forgets \
the deliberately wrong mean. The reference mean is not a hidden classical \
position; it is the conditional mean generated by the simulated innovation.\
\>", "Text",
 CellID->384663498,ExpressionUUID->"25424d11-215d-69ec-5372-655b50e83b36"],

Cell["\<\
Confirm the lock, comparing the two once the filter has settled:\
\>", "Text",
 CellID->457973463,ExpressionUUID->"38b2585b-f0b8-eb1e-6842-52048132b664"],

Cell[BoxData[
 RowBox[{"Abs", "[", 
  RowBox[{
   RowBox[{"Last", "@", 
    RowBox[{"kalTrue", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], " ", "-", " ", 
   RowBox[{"Last", "@", 
    RowBox[{"kalFilt", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[235]:= ",
 CellID->103057839,ExpressionUUID->"310aba1e-c173-53a6-6709-3c5bf006218c"],

Cell[TextData[{
 "The endpoint difference is about ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d663f9d-52b3-ad35-1b1d-b6c76747f41f"],
 " for this seeded Euler discretization. It is small on the unit position \
scale but not zero; refining ",
 Cell[BoxData["kalDt"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ae604be-6e2a-038b-3a9d-9df80bdf51d1"],
 " is the relevant convergence check."
}], "Text",
 CellID->1143862680,ExpressionUUID->"5a3bb7fa-395b-d8d2-0bd8-2ea4b8efaa38"],

Cell[TextData[{
 "The engine of the filter is its own innovation, the record minus the ",
 StyleBox["filter's", "TI"],
 " prediction (not the reference mean's). For an optimal filter this must be \
white noise, zero-mean and uncorrelated; measure its autocorrelation past the \
transient, with the ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "2", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77106238-91db-a6eb-1d2f-8462206f0c31"],
 " band that white noise would sit inside:"
}], "Text",
 CellID->870857223,ExpressionUUID->"01a00532-4a0e-3544-375f-9d7c6fb89fae"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kalInnov", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"#2", " ", "-", " ", 
           RowBox[{
            RowBox[{"#1", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "kalDt"}]}], ")"}]}], " ", 
        "&"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Most", "@", "kalFilt"}], ",", " ", "kalRec"}], "}"}]}], 
      "]"}], "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"Round", "[", 
        RowBox[{"kalN", "/", "3"}], "]"}], " ", ";;"}], "]"}], "]"}], "/", 
    RowBox[{"Sqrt", "[", "kalDt", "]"}]}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ci", " ", "=", " ", 
     RowBox[{"2", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Length", "[", "kalInnov", "]"}], "]"}]}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"CorrelationFunction", "[", 
      RowBox[{"kalInnov", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "10"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Filling", " ", "->", " ", "Axis"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.2"}], ",", " ", "0.2"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ci", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "ci"}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}]}], "}"}]}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{"ImageSize", " ", "->", " ", "440"}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<lag\>\"", ",", 
        " ", "\"\<innovation autocorrelation\>\""}], "}"}]}], ",", " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<the filter's innovation is white within confidence \
limits\>\""}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[236]:= ",
 CellID->229984321,ExpressionUUID->"1f5de8ef-4b2e-05e8-4562-01c96edb6f32"],

Cell["\<\
For this finite record the displayed nonzero-lag correlations lie within the \
approximate white-noise bands. Innovation whiteness is a necessary and useful \
model diagnostic, not by itself a proof of optimality: a wrong model can pass \
a short autocorrelation check, and a correct one can show excursions in \
finite data.\
\>", "Text",
 CellID->2065932053,ExpressionUUID->"39671b4e-a434-cf2d-6f1c-932bcdc69277"],

Cell["Measurement Feedback: Steering With the Record", "Subsection",
 CellID->7922854,ExpressionUUID->"1fdf432e-aa6d-b711-45e5-5a8bcf191a7b"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Feed the homodyne record back as a Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["H", "TI"], "^"], 
    StyleBox["fb",
     FontSlant->"Plain"]], "=", 
   OverscriptBox[
    StyleBox["J", "TI"], "."], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["F", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d59f3c2-2879-5f97-1b66-eaac490c25fd"],
 ", the feedback signal being the homodyne current ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["J", "TI"], "."], "=", 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2630e3fa-641e-82e1-4fcf-faa40da8d0cb"],
 " read off the record ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "=", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "448695d4-2f33-b50a-6cbd-0c9e4ac71c50"],
 ", so over a step the loop applies ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["F", "TI"], "^"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29c39546-676c-16ec-5ff0-0d2012197c36"],
 "; averaged over the noise, the conditioned-plus-feedback evolution becomes \
the Wiseman-Milburn feedback master equation"
}], "Text",
 CellID->1900525282,ExpressionUUID->"4f46310b-a697-198a-757d-a954d3226bd0"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       StyleBox["i", "TI"], 
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        OverscriptBox[
         StyleBox["H", "TI"], "^"], ",", 
        StyleBox["\[Rho]", "TI"]}], 
       StyleBox["]",
        SpanMaxSize->1]}]}], "+", 
     RowBox[{
      RowBox[{"\|01d49f", 
       StyleBox["[",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["c", "TI"], "^"], 
       StyleBox["]",
        SpanMaxSize->1]}], 
      StyleBox["\[Rho]", "TI"]}], "-", 
     RowBox[{
      StyleBox["i", "TI"], 
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       OverscriptBox[
        StyleBox["F", "TI"], "^"], ",", " ", 
       RowBox[{
        RowBox[{
         OverscriptBox[
          StyleBox["c", "TI"], "^"], 
         StyleBox["\[Rho]", "TI"]}], "+", 
        RowBox[{
         StyleBox["\[Rho]", "TI"], 
         SuperscriptBox[
          OverscriptBox[
           StyleBox["c", "TI"], "^"], "\[Dagger]"]}]}]}], 
      StyleBox["]",
       SpanMaxSize->1]}], "+", 
     RowBox[{
      FractionBox["1", 
       StyleBox["\[Eta]", "TI"]], "\[ThinSpace]", 
      RowBox[{"\|01d49f", 
       StyleBox["[",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["F", "TI"], "^"], 
       StyleBox["]",
        SpanMaxSize->1]}], 
      StyleBox["\[Rho]", "TI"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->865264521,ExpressionUUID->"216d5a5a-69e9-2e30-5713-5c040f9c751a"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c61f6d7-23c3-7683-441e-ef9156765ce9"],
 " the detection efficiency, this is just a plain leak with a shifted \
operator, ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "-", 
    StyleBox["i", "TI"], 
    OverscriptBox[
     StyleBox["F", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "307817dd-a48d-ada0-6007-8e86cd39f78a"],
 ", plus a Hamiltonian correction. The feedback engineers the effective \
damping, here steering the maximally mixed qubit onto a chosen state. Drive \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a8241cb-623a-869a-7ab2-589517ccece0"],
 " to one with the record itself and check it against this equation."
}], "Text",
 CellID->1876999321,ExpressionUUID->"367e3c7d-819a-afca-5e05-b627302cf510"],

Cell[TextData[{
 "Close the loop: feed the measurement record back as a Hamiltonian in \
proportion, so the record steers the state. Concretely the measured operator \
is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78d621b8-eaa7-e995-28ed-b8e58f53bbff"],
 " and the feedback generator is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["F", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c3eb8ce-9873-62c7-05c5-31a81906302d"],
 ", so the loop measures ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73390226-095c-13d5-22c6-9b80a8e9613f"],
 " and rotates about ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "242c2995-be92-4813-4dd3-c0df3b271b79"],
 " by an amount set by the record. The one constant ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cf9f011-b091-ff11-1486-ea5ac125c27b"],
 " does two jobs here: it is the measurement rate, ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["G", "TI"], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03763f09-e75f-2a04-310d-b75292ea796e"],
 ", and it is the feedback gain, entering through ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["F", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d2ce3de-bdcd-8de8-14d3-fa983479d732"],
 "; the two are matched on purpose, which is exactly what makes the target a \
dark state of the shifted leak below. The shifted operator is then ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "-", 
   StyleBox["i", "TI"], 
   OverscriptBox[
    StyleBox["F", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["y", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "037e6481-2025-8b3e-3106-7deb51d1d604"],
 ", and the Hamiltonian correction ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["F", "TI"], "^"], "+", 
    OverscriptBox[
     StyleBox["F", "TI"], "^"], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ff4878c-0720-c57b-758b-1ed6b2daac41"],
 " vanishes because ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d786225-2032-4147-6b18-7b8f51c713ad"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["y", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "775c6681-2d8b-f484-1d64-7feb443fdeee"],
 " anticommute, so the ideal loop is the single leak ",
 Cell[BoxData[
  RowBox[{
   StyleBox["G", "TI"], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["y", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75bb4ea4-bbde-cef1-2359-670e3e6894db"],
 ". Set the gain and the time grid:"
}], "Text",
 CellID->402499516,ExpressionUUID->"6f77f163-25db-f065-150c-e94d4c6fc34f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Gfb", " ", "=", " ", "0.8"}], ";", " ", 
  RowBox[{"tickFb", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"track", " ", "=", " ", 
   RowBox[{"tickFb", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "200"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[237]:= ",
 CellID->622903162,ExpressionUUID->"1c3c3f10-7538-8927-45c3-b75a7cb2d80d"],

Cell[TextData[{
 "A rotation about ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51549184-e5a4-8496-076b-08e18c56eefc"],
 " has a closed form, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["y", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Phi]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Phi]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["y", "TI"]]}]], "=", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Phi]", "TI"], "\[ThinSpace]", "\|01d7d9", "-", 
   StyleBox["i", "TI"], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Phi]", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39696f27-c9aa-0144-6f16-8680e85f53ae"],
 ", and it is what the generator ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["F", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45dcfd53-12c9-ed0c-73e3-f51da77db456"],
 " produces: the feedback unitary applied each step is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     OverscriptBox[
      StyleBox["F", "TI"], "^"], "\[ThinSpace]", 
     StyleBox["d", "TI"], 
     StyleBox["J", "TI"]}]], "=", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["y", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SqrtBox[
     StyleBox["G", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["J", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43afbe7d-b702-93ca-7154-3026c2b4e110"],
 ", so ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["F", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "143db07b-777b-32d6-3dc2-2a25020f803c"],
 " is the generator and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["R", "TI"], 
   StyleBox["y", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78b7e50c-4773-01ae-284c-fd56720653f4"],
 " the finite rotation, not one and the same. The step is light:"
}], "Text",
 CellID->649785500,ExpressionUUID->"68443c72-a4f0-9c3e-187b-b63fcc8ae704"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rotateY", "[", "\[Phi]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", "id2"}], " ", "-", " ", 
    RowBox[{"I", " ", 
     RowBox[{"Sin", "[", "\[Phi]", "]"}], " ", "Y"}]}]}], ";"}]], "Input",
 CellLabel->"In[238]:= ",
 CellID->1698847202,ExpressionUUID->"445c0952-f215-e20d-6c63-a11f87a1b157"],

Cell[TextData[{
 "One steered run, one step at a time. Write ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["meas",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a680f33-ae9a-dfdd-6a17-a77ccb2ca527"],
 " for the positivity-preserving measurement update of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3043dcf6-9c3e-c649-6070-d5b015c8ac93"],
 " under ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32a697fb-66fd-3c96-625d-0ea5128986fc"],
 ", given the record ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "=", "2", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["\[Rho]", "TI"]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e733b29-d0f2-c400-1600-b372e084af6a"],
 ". One step measures, then rotates by the commanded angle ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Phi]", "TI"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0249f5b1-f79b-eab1-3276-ecfa822fb89b"],
 ":"
}], "Text",
 CellID->696242602,ExpressionUUID->"7d8d8362-02d3-9c7f-2bb2-1b4cb767e745"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Rho]", "TI"], "\[Prime]"], "=", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["y", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Phi]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["meas",
      FontSlant->"Plain"]], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["y", "TI"]], 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Phi]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], "\[Dagger]"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["\[Phi]", "TI"], "=", 
    RowBox[{
     SqrtBox[
      StyleBox["G", "TI"]], "\[ThinSpace]", 
     StyleBox["d", "TI"], 
     StyleBox["J", "TI"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->437857044,ExpressionUUID->"16d64695-ef97-7390-3eee-5fde8a2241fa"],

Cell[TextData[{
 "run ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", "200"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "492272d1-18a5-64bf-78d2-6b9b99504e85"],
 " times from ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "0"], "=", 
   FractionBox["1", "2"], "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f8fc6a3-d6eb-41c0-45b4-df0ce29e132a"],
 ". Keeping the pair ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], ",", 
    StyleBox["\[Phi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "740a6ce3-9f6e-a7ea-1c09-85cd1a180d30"],
 " at each step, the run is the whole causal chain at once,"
}], "Text",
 CellID->1959355771,ExpressionUUID->"355eb3db-64ad-28a6-6365-2a850d587a8c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "0"], ",", "\[ThinSpace]", "0"}], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", " ", 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "1"], ",", 
       SubscriptBox[
        StyleBox["\[Phi]", "TI"], "1"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", " ", "\[Ellipsis]", ",", " ", 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], 
        StyleBox["N", "TI"]], ",", 
       SubscriptBox[
        StyleBox["\[Phi]", "TI"], 
        StyleBox["N", "TI"]]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->11075551,ExpressionUUID->"224bec90-94dc-e798-5248-05da1d6ecde2"],

Cell[TextData[{
 "each state beside the command that produced it, the seed angle a \
placeholder ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19da10ea-d928-9e66-4ff9-89b7d8c2e54c"],
 ". One function then feeds every plot below, the response curves from its \
states and the command panel from its angles:"
}], "Text",
 CellID->826226521,ExpressionUUID->"6cf78db7-632c-d0e2-148c-24f116dea2c8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"steer", "[", "seed_", "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"measure", " ", "=", " ", 
         RowBox[{"measurementStep", "[", 
          RowBox[{
           RowBox[{"0", " ", "id2"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", "Z"}], "}"}], ",", " ", 
           RowBox[{"{", "1.", "}"}], ",", " ", 
           RowBox[{"{", "}"}], ",", " ", "tickFb"}], "]"}]}], "}"}], ",", 
       "\n", "    ", 
       RowBox[{"FoldList", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"prev", ",", " ", "dw"}], "}"}], ",", "\n", "      ", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"rho", " ", "=", " ", 
               RowBox[{"prev", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", "\n", "       ", 
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"dJ", " ", "=", " ", 
                 RowBox[{"measurementRecord", "[", 
                  RowBox[{"rho", ",", " ", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", "Z"}], "}"}], ",",
                    " ", 
                   RowBox[{"{", "1.", "}"}], ",", " ", "tickFb", ",", " ", 
                   RowBox[{"{", "dw", "}"}]}], "]"}]}], "}"}], ",", "\n", 
               "        ", 
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"u", " ", "=", " ", 
                   RowBox[{"rotateY", "[", 
                    RowBox[{
                    RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", 
                    RowBox[{"dJ", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"u", " ", ".", " ", 
                    RowBox[{"measure", "[", 
                    RowBox[{"rho", ",", " ", "dJ"}], "]"}], " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], ",", " ", 
                   RowBox[{
                    RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", 
                    RowBox[{"dJ", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}]}], "]"}]}], 
              "]"}]}], "]"}]}], "]"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"id2", "/", "2"}], ",", " ", "0."}], "}"}], ",", "\n", 
         "     ", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"Sqrt", "[", "tickFb", "]"}]}], "]"}], ",", " ", "200"}],
           "]"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[239]:= ",
 CellID->2011372776,ExpressionUUID->"634058bc-0e0e-c957-1170-51e6abb89bbd"],

Cell[TextData[{
 "This feedback has a target: the ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "187ea1f6-0b66-2b61-4805-38b0ae13764b"],
 " state is a fixed point the loop leaves alone, so from the maximally mixed \
state the loop should build it. Confirm ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a5920d9-eb16-a7a4-1a66-b9828ea00d8e"],
 " is the dark state (the shifted operator annihilates it):"
}], "Text",
 CellID->85539763,ExpressionUUID->"09f2771d-8da8-86b6-3f82-6f472442ec9c"],

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{"Z", " ", "-", " ", 
       RowBox[{"I", " ", "Y"}]}], ")"}]}], ")"}], " ", ".", " ", "plus"}], 
  "]"}]], "Input",
 CellLabel->"In[240]:= ",
 CellID->247751216,ExpressionUUID->"2eae7486-c77b-107a-5656-6de3f20e6340"],

Cell[TextData[{
 "The zero vector confirms it. Integrate the feedback master equation for the \
predicted ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58a71232-b93f-0bc4-085c-947c38ca592e"],
 ":"
}], "Text",
 CellID->375124362,ExpressionUUID->"0590db7a-de3c-d1b6-33af-d327dbcea39c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"predicted", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"blochVector", "[", 
       RowBox[{
        RowBox[{"evolveODE", "[", 
         RowBox[{
          RowBox[{"0", " ", "id2"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{"Z", " ", "-", " ", 
              RowBox[{"I", " ", "Y"}]}], ")"}]}], "}"}], ",", " ", 
          RowBox[{"id2", "/", "2"}], ",", " ", "2."}], "]"}], "[", "#", "]"}],
        "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", "track"}]}],
   ";"}]], "Input",
 CellLabel->"In[241]:= ",
 CellID->898261846,ExpressionUUID->"2f6adbb8-aab7-c223-5569-d2e5cf439109"],

Cell["Average sixty steered runs:", "Text",
 CellID->2123245851,ExpressionUUID->"360b7cf2-7095-e6b8-5e09-75bc0121cc82"],

Cell[BoxData[
 RowBox[{
  RowBox[{"steeredMean", " ", "=", " ", 
   RowBox[{"Mean", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"xOf", "[", 
       RowBox[{
        RowBox[{"steer", "[", "s", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"s", ",", " ", "60"}], "}"}]}], "]"}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[242]:= ",
 CellID->1888499658,ExpressionUUID->"571ae662-c9c7-b1ca-7d39-f84fe8730310"],

Cell["\<\
Now visualize one run, the ensemble mean, and the master-equation prediction \
climbing together:\
\>", "Text",
 CellID->237269248,ExpressionUUID->"45b5dbb0-b576-45eb-734a-d2fa3c032f31"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
