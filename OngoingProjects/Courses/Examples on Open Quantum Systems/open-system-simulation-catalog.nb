  FontSize->0.9 Inherited,ExpressionUUID->
  "05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],
 "; the two records are"
}], "Text",
 CellID->617350884,ExpressionUUID->"583a98af-415b-100e-09d9-110970ee6354"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["j", "TI"]], "=", 
