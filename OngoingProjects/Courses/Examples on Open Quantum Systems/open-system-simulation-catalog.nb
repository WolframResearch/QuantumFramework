  ImageSize->Full]], "DisplayFormula",
 CellID->207361811,ExpressionUUID->"0a3cf3ec-7071-038e-3bc3-eab6010451d4"],

Cell[TextData[{
 "each state beside the command that produced it, the seed angle a \
placeholder ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44b6a437-3794-76b8-6c4d-3e7142215c82"],
 ". One function then feeds every plot below, the response curves from its \
states and the command panel from its angles:"
}], "Text",
 CellID->483818264,ExpressionUUID->"3e37a26f-afb3-2e6c-67cc-4448ca4674b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"steer", "[", "seed_", "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"measure", " ", "=", " ", 
         RowBox[{"measurementStep", "[", 
          RowBox[{
           RowBox[{"0", " ", "id2"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", "Z"}], "}"}], ",", " ", 
           RowBox[{"{", "1.", "}"}], ",", " ", 
           RowBox[{"{", "}"}], ",", " ", "tickFb"}], "]"}]}], "}"}], ",", 
       "\n", "    ", 
       RowBox[{"FoldList", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"prev", ",", " ", "dw"}], "}"}], ",", "\n", "      ", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"rho", " ", "=", " ", 
               RowBox[{"prev", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", "\n", "       ", 
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"dJ", " ", "=", " ", 
                 RowBox[{"measurementRecord", "[", 
                  RowBox[{"rho", ",", " ", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", "Z"}], "}"}], ",",
                    " ", 
                   RowBox[{"{", "1.", "}"}], ",", " ", "tickFb", ",", " ", 
                   RowBox[{"{", "dw", "}"}]}], "]"}]}], "}"}], ",", "\n", 
               "        ", 
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"u", " ", "=", " ", 
                   RowBox[{"rotateY", "[", 
                    RowBox[{
                    RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", 
                    RowBox[{"dJ", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"u", " ", ".", " ", 
                    RowBox[{"measure", "[", 
                    RowBox[{"rho", ",", " ", "dJ"}], "]"}], " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], ",", " ", 
                   RowBox[{
                    RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", 
                    RowBox[{"dJ", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}]}], "]"}]}], 
              "]"}]}], "]"}]}], "]"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"id2", "/", "2"}], ",", " ", "0."}], "}"}], ",", "\n", 
         "     ", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"Sqrt", "[", "tickFb", "]"}]}], "]"}], ",", " ", "200"}],
           "]"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[199]:= ",
 CellID->625240499,ExpressionUUID->"576120e7-4357-336c-7d1e-b9c176e381b6"],

Cell[TextData[{
 "This feedback has a target: the ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "375ed7c0-a5a4-d638-5d65-ceadcc56bd02"],
 " state is a fixed point the loop leaves alone, so from the maximally mixed \
state the loop should build it. Confirm ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1106a12f-2723-9187-473d-388952d7e3ed"],
 " is the dark state (the shifted operator annihilates it):"
}], "Text",
 CellID->1892872133,ExpressionUUID->"0df9f048-7a44-7b96-3b86-ea127ff149fc"],

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{"Z", " ", "-", " ", 
       RowBox[{"I", " ", "Y"}]}], ")"}]}], ")"}], " ", ".", " ", "plus"}], 
  "]"}]], "Input",
 CellLabel->"In[200]:= ",
 CellID->84806595,ExpressionUUID->"11feb189-ad07-7b90-4785-28d2c4b249fa"],

Cell[TextData[{
 "The zero vector confirms it. Integrate the feedback master equation for the \
predicted ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74f078bc-d989-92d9-1c80-71f9d83de023"],
 ":"
}], "Text",
 CellID->921906943,ExpressionUUID->"587682b0-1dd8-f3c6-080d-1bfa9452c12c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"predicted", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"blochVector", "[", 
       RowBox[{
        RowBox[{"evolveODE", "[", 
         RowBox[{
          RowBox[{"0", " ", "id2"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{"Z", " ", "-", " ", 
              RowBox[{"I", " ", "Y"}]}], ")"}]}], "}"}], ",", " ", 
          RowBox[{"id2", "/", "2"}], ",", " ", "2."}], "]"}], "[", "#", "]"}],
        "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", "track"}]}],
   ";"}]], "Input",
 CellLabel->"In[201]:= ",
 CellID->1795442623,ExpressionUUID->"252e0451-1a36-40ed-4cd5-9e1b9fc31237"],

Cell["Average sixty steered runs:", "Text",
 CellID->1276871254,ExpressionUUID->"6b506e1e-f100-9568-196f-805b80baffb2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"steeredMean", " ", "=", " ", 
   RowBox[{"Mean", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"xOf", "[", 
       RowBox[{
        RowBox[{"steer", "[", "s", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"s", ",", " ", "60"}], "}"}]}], "]"}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[202]:= ",
 CellID->649937590,ExpressionUUID->"45e6cda3-0332-8806-739d-e40db6c4db6c"],

Cell["\<\
Now visualize one run, the ensemble mean, and the master-equation prediction \
climbing together:\
\>", "Text",
 CellID->1170948616,ExpressionUUID->"10a6fcee-2410-cb5f-405d-f5c84daa99a5"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"track", ",", " ", 
        RowBox[{"xOf", "[", 
         RowBox[{
          RowBox[{"steer", "[", "2", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}]}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"track", ",", " ", "steeredMean"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"track", ",", " ", "predicted"}], "}"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"Opacity", "[", "0.45", "]"}]}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Dashed", ",", " ", "Red"}], "]"}]}], "}"}]}], ",", "\n", " ", 
   
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<one steered run\>\"", ",", " ", "\"\<average of many\>\"", ",",
       " ", "\"\<predicted\>\""}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "0.35"}], ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "520"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]\[Sigma]x\[RightAngleBracket]\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<feedback drives the maximally mixed state to a pure \
state\>\""}]}], "]"}]], "Input",
 CellLabel->"In[203]:= ",
 CellID->1271585103,ExpressionUUID->"20b3c3fd-ce47-45e5-5040-daa6ebf22fcf"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dd5773b-5215-a52c-3beb-6f6567a10c76"],
 " climbs from zero to one: the maximally mixed state is driven to a pure \
state by its own record. This is measurement-based feedback control, the \
basis of feedback cooling and qubit stabilization."
}], "Text",
 CellID->1586088935,ExpressionUUID->"7da02f1b-35d4-9174-2b5f-c745bc66e05e"],

Cell["\<\
The loop has a causal chain worth seeing whole: the noisy record drives a \
control command, which drives the state's response. That same run already \
carries both, so take seed 2 and read its per-step command against its \
response:\
\>", "Text",
 CellID->2147327530,ExpressionUUID->"1be4ea81-18b8-2b05-499b-03eb994d766f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"feedRun", " ", "=", " ", 
   RowBox[{"steer", "[", "2", "]"}]}], ";"}]], "Input",
 CellLabel->"In[204]:= ",
 CellID->1186224664,ExpressionUUID->"2bec375e-30ea-24bd-5993-af18409c8e87"],

Cell[TextData[{
 "Now visualize the loop in time, two panels side by side: the feedback \
rotation the raw record commands at each step, a noise band, and the state's \
response ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dcf5242-c9ff-a686-2bf5-542fef8b0cec"],
 " climbing to the target:"
}], "Text",
 CellID->618395345,ExpressionUUID->"52da685f-2498-05f2-02f9-82194d2d6fd8"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"{", "\n", "  ", 
   RowBox[{
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"track", "[", 
          RowBox[{"[", 
           RowBox[{"2", " ", ";;"}], "]"}], "]"}], ",", " ", 
         RowBox[{"feedRun", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"2", " ", ";;"}], ",", " ", "2"}], "]"}], "]"}]}], "}"}], 
       "]"}], ",", " ", 
      RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
      RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", "   ", 
      RowBox[{"ImageSize", " ", "->", " ", "Medium"}], ",", " ", 
      RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
      RowBox[{"FrameLabel", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<time\>\"", ",", " ", "\"\<feedback rotation\>\""}], 
        "}"}]}], ",", "\n", "   ", 
      RowBox[{
      "PlotLabel", " ", "->", 
       " ", "\"\<the command the raw record drives\>\""}]}], "]"}], ",", 
    " ", "\"\<  \>\"", ",", "\n", "  ", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"track", "[", 
          RowBox[{"[", 
           RowBox[{"2", " ", ";;"}], "]"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"blochVector", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"feedRun", "[", 
           RowBox[{"[", 
            RowBox[{"2", " ", ";;"}], "]"}], "]"}]}]}], "}"}], "]"}], ",", 
      " ", 
      RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
      RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", "   ", 
      RowBox[{"ImageSize", " ", "->", " ", "Medium"}], ",", " ", 
      RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
      RowBox[{"FrameLabel", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<time\>\"", ",", 
         " ", "\"\<\[LeftAngleBracket]\[Sigma]x\[RightAngleBracket]\>\""}], 
        "}"}]}], ",", "\n", "   ", 
      RowBox[{
      "PlotLabel", " ", "->", " ", "\"\<the response it produces\>\""}]}], 
     "]"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[205]:= ",
 CellID->309927853,ExpressionUUID->"12aa8adb-4d50-9545-42a9-238564eaffaf"],

Cell["\<\
Command to response, left to right: the loop reads the noisy record as a \
rotation, a noise band, and the rotations walk the state smoothly to the \
target.\
\>", "Text",
 CellID->918875187,ExpressionUUID->"6bddd79b-6823-400d-19e2-cec509d61357"],

Cell[TextData[{
 "But a real loop never has a perfect detector, and inefficiency caps how \
pure the steered state can get. The Wiseman-Milburn feedback master equation \
carries an efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0292d5cf-fba4-5fb5-32a1-cca8fe51259f"],
 " that adds an irreducible feedback-noise term ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    RowBox[{"1", "-", 
     StyleBox["\[Eta]", "TI"]}], 
    StyleBox["\[Eta]", "TI"]], "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["F", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "315a5c02-c518-37e9-677a-566fec929d33"],
 "; solve its steady state against ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "601c6277-b8fa-6d82-1023-8431388f37e8"],
 ":"
}], "Text",
 CellID->39213332,ExpressionUUID->"056e5c3e-0591-d839-3316-5678ac25ab03"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"steadyXeff", "[", "\[Eta]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"blochVector", "[", 
     RowBox[{"First", "@", 
      RowBox[{"steadyState", "[", 
       RowBox[{
        RowBox[{"0", " ", "id2"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"Z", " ", "-", " ", 
             RowBox[{"I", " ", "Y"}]}], ")"}]}], ",", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", " ", "-", " ", "\[Eta]"}], ")"}], "/", "\[Eta]"}], 
            "]"}], " ", 
           RowBox[{"Sqrt", "[", "Gfb", "]"}], " ", "Y"}]}], "}"}]}], "]"}]}], 
     "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"etasFb", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0.3", ",", " ", "1", ",", " ", "0.05"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"etasFb", ",", " ", 
      RowBox[{"steadyXeff", " ", "/@", " ", "etasFb"}]}], "}"}], "]"}], ",", 
   " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"ColorData", "[", 
     RowBox[{"97", ",", " ", "2"}], "]"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "460"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<detection efficiency \[Eta]\>\"", ",", 
      " ", "\"\<steady \
\[LeftAngleBracket]\[Sigma]x\[RightAngleBracket]\>\""}], "}"}]}], ",", "\n", 
   " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<a leaky detector cannot fully purify: feedback noise sets the \
floor\>\""}]}], "]"}]}], "Input",
 CellLabel->"In[206]:= ",
 CellID->2105127725,ExpressionUUID->"7362f573-955d-4629-2111-ed3d1ce82d73"],

Cell[TextData[{
 "Steady ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d4a449b-9aea-2b01-4b4a-5dc51e9f766b"],
 " climbs to one only as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "\[Rule]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "693f6746-f6ea-213d-18c5-7f23829f7007"],
 "; a lossy detector leaves the loop feeding its own missing information back \
as noise, and the target is reached only in part. Perfect stabilization needs \
a perfect record, the same efficiency limit that capped the feedback \
cooling."
}], "Text",
 CellID->237912175,ExpressionUUID->"58bbc0e4-f422-75b6-0858-d9c1fdd75f9c"],

Cell["Part Six: Settling Warm, Purifying Fast, Cooling Cold", "Section",
 CellID->1518115677,ExpressionUUID->"512ebd8c-9517-4b4e-00d5-34d61ca21994"],

Cell["Thermalization to a Bath", "Subsection",
 CellID->625578070,ExpressionUUID->"38255ff6-675c-bc9f-69db-56b012ee06e5"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A warm bath both takes and gives energy, settling a system at its own \
temperature. For an oscillator,"
}], "Text",
 CellID->1195176726,ExpressionUUID->"0868aa04-f8be-0db7-3817-4c61f94b579d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["\[Omega]", "TI"], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "\[Dagger]"], 
      OverscriptBox[
       StyleBox["a", "TI"], "^"]}], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["n", "TI"], 
      StyleBox["T", "TI"]], "+", "1"}], 
    StyleBox[")",
     SpanMaxSize->1], " ", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "+", 
    StyleBox["\[Gamma]", "TI"], " ", 
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], " ", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "=", 
    FractionBox["1", 
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       StyleBox[
        RowBox[{"\[Beta]", "\[Omega]"}], "TI"]], "-", "1"}]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->394282870,ExpressionUUID->"0889c062-717f-f29f-38b6-da4c000bc0e5"],

Cell[TextData[{
 "where the down-rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f19c016-97c3-092d-0526-da5022765877"],
 " beats the up-rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c809b18-7d36-d224-44bf-134274c0a10e"],
 " by exactly the Boltzmann factor ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"\[Beta]", "\[Omega]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7167cc0d-03c8-d238-271c-e657b662a102"],
 ". This ",
 StyleBox["detailed balance", "TI"],
 " forces the steady state to the thermal distribution ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]], "\[Proportional]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Beta]", "TI"], 
     StyleBox["\[Omega]", "TI"], " ", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "324c55d1-ee3a-374b-6274-4c9a8bcc9d91"],
 " with mean occupation ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4495e7b4-eb19-1195-6caa-fef18eac63ff"],
 ". Settle a cold and a hot start and confirm both land on the thermal \
distribution."
}], "Text",
 CellID->1396453116,ExpressionUUID->"561855fc-8d4a-f767-7e38-4ca624fcda4d"],

Cell[TextData[{
 "A warm bath both absorbs and emits, settling a system at its temperature. \
Model it as two dissipators: decay ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cc16cd1-dd21-1c76-14fe-859ad4d4675c"],
 " at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30881872-2ed2-344c-60b7-923c4b649e96"],
 " and excitation ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06a6bc82-b4ed-9511-2e5d-35ec3c99fc7b"],
 " at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15240c0a-58c5-65f1-3cdb-a65459704fdb"],
 ". Set the cutoff, the ladder, the bath occupation and its rate:"
}], "Text",
 CellID->882685893,ExpressionUUID->"6874cd6b-f967-cd5b-180b-e534f81397a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"topTh", " ", "=", " ", "24"}], ";", " ", 
  RowBox[{"a", " ", "=", " ", 
   RowBox[{"annihilation", "[", "topTh", "]"}]}], ";", " ", 
  RowBox[{"count", " ", "=", " ", 
   RowBox[{
    RowBox[{"creation", "[", "topTh", "]"}], " ", ".", " ", "a"}]}], ";", " ", 
  RowBox[{"nT", " ", "=", " ", "1.2"}], ";", " ", 
  RowBox[{"\[Gamma]th", " ", "=", " ", "0.5"}], ";"}]], "Input",
 CellLabel->"In[207]:= ",
 CellID->1562244888,ExpressionUUID->"16aea7ca-f02c-8fa8-3e55-3e9781ded5f2"],

Cell["\<\
The two channels, decay and excitation, with their thermal weights:\
\>", "Text",
 CellID->2118942829,ExpressionUUID->"68bcb404-3168-9397-1843-2e6e4002e1fd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fall", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Gamma]th", " ", 
      RowBox[{"(", 
       RowBox[{"nT", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", "a"}]}], ";", 
  " ", 
  RowBox[{"climb", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Gamma]th", " ", "nT"}], "]"}], " ", 
    RowBox[{"creation", "[", "topTh", "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[208]:= ",
 CellID->1388287869,ExpressionUUID->"3074fef3-0190-9aee-600b-f7bdb02ae834"],

Cell["A reader for the mean occupation:", "Text",
 CellID->1303133385,ExpressionUUID->"5132409c-0c71-a3d8-00c2-59c6a505f122"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"units", "[", "rho_", "]"}], " ", ":=", " ", 
   RowBox[{"expectation", "[", 
    RowBox[{"count", ",", " ", "rho"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[209]:= ",
 CellID->1083493527,ExpressionUUID->"65312e6e-5674-5434-0cce-c04863013f1e"],

Cell["Settle a cold (vacuum) and a hot start:", "Text",
 CellID->43887772,ExpressionUUID->"0235daed-fad3-6b5f-33ca-d3b6ff6639a5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fromCold", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{"0", " ", 
      RowBox[{"IdentityMatrix", "[", "topTh", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"fall", ",", " ", "climb"}], "}"}], ",", " ", 
     RowBox[{"densityMatrix", "[", 
      RowBox[{"coherentState", "[", 
       RowBox[{"topTh", ",", " ", "0"}], "]"}], "]"}], ",", " ", "16."}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fromHot", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{"0", " ", 
      RowBox[{"IdentityMatrix", "[", "topTh", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"fall", ",", " ", "climb"}], "}"}], ",", " ", 
     RowBox[{"densityMatrix", "[", 
      RowBox[{"UnitVector", "[", 
       RowBox[{"topTh", ",", " ", "9"}], "]"}], "]"}], ",", " ", "16."}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[210]:= ",
 CellID->2123394380,ExpressionUUID->"3c9f7e12-83c1-89ed-64a5-705c3675db37"],

Cell["\<\
Read as a dynamical law, this equation has three consequences worth drawing \
out one at a time, each sharper than the one before.\
\>", "Text",
 CellID->705610480,ExpressionUUID->"505aa7d0-1afc-86f2-0079-3e9a9e8eecd8"],

Cell[TextData[{
 "The first is a ",
 StyleBox["single attractor",
  FontWeight->"Bold"],
 ": the evolution forgets the initial state, so every start relaxes to the \
same steady state. Test that from opposite extremes, the cold vacuum and the \
hot ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5143f96d-83a3-6ed2-0770-f13736563438"],
 " state, by reading their late mean occupations against ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e0ac860-85ff-08e4-2609-e24a338a5ace"],
 ":"
}], "Text",
 CellID->1139416472,ExpressionUUID->"2c4a7891-0723-3e0d-544a-71dbb2d78557"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"units", "[", 
    RowBox[{"fromCold", "[", "16.", "]"}], "]"}], ",", " ", 
   RowBox[{"units", "[", 
    RowBox[{"fromHot", "[", "16.", "]"}], "]"}], ",", " ", "nT"}], 
  "}"}]], "Input",
 CellLabel->"In[211]:= ",
 CellID->432212328,ExpressionUUID->"567bfdcc-56c6-5358-7e18-f496637321a2"],

Cell[TextData[{
 "Both land on ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b371d01-a041-5dbe-3acc-956ad1f42784"],
 ". Watch them get there, the cold climbing and the hot relaxing until they \
meet:"
}], "Text",
 CellID->1877047781,ExpressionUUID->"09dcd030-ee58-59fb-3fe3-ca7d8bed2bc1"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", "16", ",", " ", "0.05"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"units", "[", 
           RowBox[{"fromCold", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
         " ", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", "16", ",", " ", "0.05"}], "]"}]}]}], "}"}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", "16", ",", " ", "0.05"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"units", "[", 
           RowBox[{"fromHot", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
         " ", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", "16", ",", " ", "0.05"}], "]"}]}]}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "nT"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"16", ",", " ", "nT"}], "}"}]}], "}"}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<from cold\>\"", ",", " ", "\"\<from hot\>\"", ",", 
      " ", "\"\<warm equilibrium\>\""}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<mean occupation\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<both starts reach the thermal mean\>\""}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}]], "Input",
 CellLabel->"In[212]:= ",
 CellID->1901365905,ExpressionUUID->"3eb66b53-0a81-4482-664d-831daf342ee8"],

Cell[TextData[{
 "They settle on the same ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4513a2b6-5679-71cc-7320-3bf0630c4316"],
 " from opposite sides: the bath drains the hot oscillator and feeds the cold \
one, so wherever the state began, it ends where decay and excitation balance. \
This two-way traffic is what makes the attractor unique; the pure-dephasing \
bath of Part One, which only froze populations, left a whole line of steady \
states instead."
}], "Text",
 CellID->1056348074,ExpressionUUID->"0a5000e8-62c3-6dca-3a6f-99b217763710"],

Cell[TextData[{
 "The second consequence is stronger: the equation fixes ",
 StyleBox["the whole state",
  FontWeight->"Bold"],
 ", not just its mean. A mean is weak evidence, since a coherent, a squeezed, \
and a thermal state can all share the occupation ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72376a19-67f8-2d8a-23cc-8c43118d77d0"],
 ". So build the settled populations and the geometric thermal shape ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["n", "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SuperscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6261e651-652e-b57b-121e-f81b0cd81c41"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Beta]", "TI"], 
     StyleBox["\[Omega]", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02289828-dcb6-ed3d-33d7-1275d540b407"],
 ", and read the largest gap between them:"
}], "Text",
 CellID->5121024,ExpressionUUID->"7e4925e4-2eb0-6ad8-2676-bcce4b453822"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pops", " ", "=", " ", 
   RowBox[{"Re", "@", 
    RowBox[{
     RowBox[{"Diagonal", "[", 
      RowBox[{"fromCold", "[", "16.", "]"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{";;", " ", "8"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"warmShape", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ratio", " ", "=", " ", 
       RowBox[{"nT", "/", 
        RowBox[{"(", 
         RowBox[{"nT", " ", "+", " ", "1"}], ")"}]}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", "ratio"}], ")"}], " ", 
      RowBox[{"ratio", "^", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "7"}], "]"}]}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[213]:= ",
 CellID->1201452384,ExpressionUUID->"3f48fd62-d18c-e56b-6577-f54fe03ecfb1"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "[", 
   RowBox[{"pops", " ", "-", " ", "warmShape"}], "]"}]}]], "Input",
 CellLabel->"In[214]:= ",
 CellID->1321205547,ExpressionUUID->"09732abd-5fe3-4802-3f00-c3e759961b68"],

Cell["\<\
They agree to a fraction of a percent. Level by level, the settled \
populations sit on the thermal bars rung for rung:\
\>", "Text",
 CellID->1168360678,ExpressionUUID->"6ab4141e-cc6c-4672-1a4b-8e5be5192d58"],

Cell[BoxData[
 RowBox[{"BarChart", "[", 
  RowBox[{
   RowBox[{"Transpose", "@", 
    RowBox[{"{", 
     RowBox[{"pops", ",", " ", "warmShape"}], "}"}]}], ",", " ", 
   RowBox[{"ChartLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<settled\>\"", ",", " ", "\"\<thermal\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"ChartLabels", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", "7"}], "]"}], ",", " ", "None"}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Fock level\>\"", ",", " ", "\"\<probability\>\""}], "}"}]}],
    ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the settled distribution is thermal\>\""}]}], "]"}]], "Input",
 CellLabel->"In[215]:= ",
 CellID->1790612322,ExpressionUUID->"0f1d8418-8fb4-2aea-3522-1e422a417830"],

Cell["\<\
The attractor is a complete density matrix; reaching the thermal mean was \
only its shadow.\
\>", "Text",
 CellID->26037494,ExpressionUUID->"7b1b0b32-6c87-d322-2938-a37c0533be08"],

Cell[TextData[{
 "The third consequence is the deepest, the point where a dynamical equation \
reproduces equilibrium statistical mechanics. Stationarity alone forces the \
population ratio on adjacent rungs to equal the ratio of the two rates, \
excitation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b382293-4179-aaf9-3ac7-bbdd700df8c3"],
 " over decay ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e8da17c-ff26-3788-56b2-3939fad09dd2"],
 ", and that flux balance is mere bookkeeping. The physics is that the ratio \
is not free: through ",
 StyleBox["detailed balance",
  FontWeight->"Bold"],
 " the bath locks the downward rate above the upward one by exactly ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"\[Beta]", "\[Omega]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3669af04-3982-74bb-5e16-476eb8375e81"],
 ", its own thermal signature, so an oscillator with no temperature of its \
own is driven into the Boltzmann distribution at the bath's temperature. The \
canonical ensemble is derived here, not assumed:"
}], "Text",
 CellID->87820654,ExpressionUUID->"28fe05af-1890-3d45-5885-9c09992a87af"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[Gamma]th", " ", "nT"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"\[Gamma]th", " ", 
      RowBox[{"(", 
       RowBox[{"nT", " ", "+", " ", "1"}], ")"}]}], ")"}]}], ",", " ", 
   RowBox[{"nT", "/", 
    RowBox[{"(", 
     RowBox[{"nT", " ", "+", " ", "1"}], ")"}]}]}], "}"}]], "Input",
 CellLabel->"In[216]:= ",
 CellID->668477954,ExpressionUUID->"01001107-76e3-9dfc-373f-89610297e7c6"],

Cell[TextData[{
 "The two are equal, both ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["\[Beta]", "TI"], 
    StyleBox["\[Omega]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "524d5b64-939d-9e2e-0273-534e2629e574"],
 ". The settled state shows the same thing directly: a geometric distribution \
is a straight line on a log axis, its constant slope the Boltzmann factor. \
Plot the settled populations against the thermal shape:"
}], "Text",
 CellID->658691238,ExpressionUUID->"3bbb36c0-925a-ccd2-6958-afaa27ec9638"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fock", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", "6"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"ListLogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"fock", ",", " ", 
          RowBox[{"pops", "[", 
           RowBox[{"[", 
            RowBox[{";;", " ", 
             RowBox[{"Length", "@", "fock"}]}], "]"}], "]"}]}], "}"}], "]"}], 
       ",", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"fock", ",", " ", 
          RowBox[{"warmShape", "[", 
           RowBox[{"[", 
            RowBox[{";;", " ", 
             RowBox[{"Length", "@", "fock"}]}], "]"}], "]"}]}], "}"}], 
        "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "Dashed"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<settled\>\"", ",", " ", "\"\<thermal\>\""}], "}"}]}], ",",
      " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameTicks", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"fock", ",", " ", "Automatic"}], "}"}]}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"fock", ",", " ", "Automatic"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"ImageSize", " ", "->", " ", "Medium"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Fock level n\>\"", ",", " ", "\"\<population (log)\>\""}],
        "}"}]}], ",", "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<geometric tail: a straight line on a log axis\>\""}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[217]:= ",
 CellID->1593411516,ExpressionUUID->"1a695b16-67b9-69b9-4a17-5350124c3b83"],

Cell[TextData[{
 "The settled populations fall on a straight line, parallel to the thermal \
one and with the same constant slope: every rung is less likely than the one \
below by the bath's Boltzmann factor ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["\[Beta]", "TI"], 
    StyleBox["\[Omega]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0deaf6de-bcac-37fa-3be9-ef98355e9dc0"],
 ", the visible fingerprint of detailed balance. The ratio of rates in the \
equation has become the slope of the ladder in the state. Damping and \
thermalization are then one process: decay ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a9276f6-63cd-444b-2aa2-6fb016782e91"],
 " and excitation ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "286ae68d-79c0-1125-5869-ffd77875600f"],
 " are the same bath, and the ground-state relaxation of the earlier examples \
is its ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e79da95-910a-a6b5-3606-d3df20bc0c9f"],
 " corner, an oscillator settling to its bath temperature with its whole \
distribution fixed by two rates."
}], "Text",
 CellID->472705648,ExpressionUUID->"09d777b6-b63f-ed25-3fed-6ef3c3cbb40f"],

Cell["Rapid Purification by Feedback", "Subsection",
 CellID->651685264,ExpressionUUID->"2768433a-cec7-30dc-4d68-5b67eb738226"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Continuously watching an observable extracts information and sharpens the \
state toward one of its eigenstates, so a monitored qubit purifies with time. \
How ",
 StyleBox["fast", "TI"],
 " it purifies depends on where the state sits relative to the measured axis. \
For a qubit measured along ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["M", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f776597-6eed-bc41-150d-7cd10a9906ab"],
 " at angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37f31662-30b3-53e3-5d80-884c414621c9"],
 " to its Bloch vector ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0465595f-3759-9855-2c1b-511942edeabf"],
 ", the impurity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[GridBox[{
       {
        OverscriptBox[
         StyleBox["a", "TI"], "\[RightVector]"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b103241-69e7-988c-792f-b42b0f93ead6"],
 " has a stochastic increment ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "L"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "423e0d65-9e44-f34a-73c5-a54f1bf6c190"],
 " along each run; averaged over the measurement noise it drifts as"
}], "Text",
 CellID->767085021,ExpressionUUID->"1bc261b5-654b-a677-49f2-78ff0cff0d5d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox[
      StyleBox[
       RowBox[{"d", "L"}], "TI"],
      AutoSpacing->False], "_"], "=", "-", "4", 
    StyleBox["k", "TI"], " ", 
    StyleBox["L", "TI"], " ", 
    StyleBox["(",
     FontSize->1.2 Inherited], 
    SuperscriptBox[
     StyleBox["sin",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"], "+", "2", 
    StyleBox["L", "TI"], 
    SuperscriptBox[
     StyleBox["cos",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"], 
    StyleBox[")",
     FontSize->1.2 Inherited], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->624501814,ExpressionUUID->"34f1caf0-755d-71af-5c8e-e3ba7ce843f5"],

Cell[TextData[{
 "where the bar is that noise average and the ",
 Cell[BoxData[
  StyleBox["L", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14d4f14a-07e3-3752-3ceb-e914b1979db8"],
 " on the right is the current impurity, with ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b5a0245-2820-625f-2979-a42f49d530a5"],
 " the measurement strength (the monitored leak is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["k", "TI"]], " ", 
   OverscriptBox[
    StyleBox["M", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45aa5bc0-73da-807d-73aa-52aa066cd347"],
 "). Measuring ",
 StyleBox["crosswise", "TI"],
 " to the Bloch vector, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "688d67fd-2a77-4fd5-18b3-7ea74f02153f"],
 ", is the fast case: there the noise in ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "L"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "206ab830-fe85-388c-5069-327dfb318ad6"],
 " drops out, so each run purifies deterministically with one clean rate, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "4", 
     StyleBox["k", "TI"], 
     StyleBox["t", "TI"]}]], 
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6259337f-42f1-dd99-1266-ab397685a7e3"],
 "; measuring ",
 StyleBox["along", "TI"],
 " it, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36c57d9d-81e8-42ea-5efb-74c7379d1030"],
 ", is slowest, its rate dragged down by the extra factor ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["L", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45788596-5db6-3a96-7307-1cd0544088fc"],
 ". A fixed measurement axis lets the state drift into alignment, where it \
learns slowly, so reading the record back to keep the axis crosswise holds \
the fast rate and makes the purification deterministic. This is ",
 ButtonBox["Jacobs' rapid-purification protocol",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/quant-ph/0301056"], None}],
 "."
}], "Text",
 CellID->1504331274,ExpressionUUID->"6c54ae11-ac51-e949-146b-405ac5e5bb93"],

Cell[TextData[{
 "There is a catch in what \"fast\" means. Keeping the measurement crosswise \
maximizes the ",
 StyleBox["mean purity at a fixed time", "TI"],
 ", yet it ",
 StyleBox["lengthens", "TI"],
 " the mean time to reach a chosen purity, because its determinism forbids \
the lucky fast runs an aligned measurement occasionally enjoys; the two \
figures of merit disagree by a factor of two (",
 ButtonBox["Wiseman and Ralph, 2006",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/quant-ph/0603062"], None}],
 "). We build both strategies and let the distributions settle it."
}], "Text",
 CellID->1994044242,ExpressionUUID->"5d4030e4-6c2c-f7e9-0b7f-a9ce05dedd33"],

Cell[TextData[{
 "Both strategies start from the maximally mixed state and are scored by the \
same impurity, the linear entropy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[GridBox[{
       {
        OverscriptBox[
         StyleBox["a", "TI"], "\[RightVector]"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503b1edc-b945-4d24-01d8-978638f0140e"],
 ", which is ",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f836107-b46e-407e-35b1-79613d1b1344"],
 " when mixed and ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "267182e5-332f-0e8d-4e0e-1bcf46da54d7"],
 " when pure. A reader for it:"
}], "Text",
 CellID->1520445855,ExpressionUUID->"154e4ea8-041b-018f-4376-67f2adae53d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"linearEntropy", "[", "rho_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"blochVector", "[", "rho", "]"}], "]"}], "^", "2"}]}], ")"}], 
    "/", "2"}]}], ";"}]], "Input",
 CellLabel->"In[218]:= ",
 CellID->1470891495,ExpressionUUID->"16f6496c-6c93-397b-3e8e-613605278841"],

Cell["Set the measurement strength and the time grid:", "Text",
 CellID->1799794391,ExpressionUUID->"2e61f31d-599e-ef91-561e-eb475828b5fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kPur", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"tickPur", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"span", " ", "=", " ", 
   RowBox[{"tickPur", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "120"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[219]:= ",
 CellID->1171173153,ExpressionUUID->"591a22e5-07a0-ff20-0f39-bbcfb25ac20a"],

Cell[TextData[{
 "The ",
 StyleBox["fixed",
  FontWeight->"Bold"],
 " strategy measures one axis, ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "352cfa2a-2f90-a2db-5cd3-fc744a2af021"],
 ", for the whole run. Each step feeds the record ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "=", "2", 
   SqrtBox[
    StyleBox["k", "TI"]], " ", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76eee8f9-1f6f-e745-1e95-01a39a1bcdaf"],
 " into the positivity-preserving update, and the conditioned state diffuses \
and lengthens; but as its Bloch vector swings toward the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d128122-8bef-720a-0b21-188c2d9a4150"],
 "-axis the measurement falls into alignment and the purification slows. One \
such run, returning its impurity history:"
}], "Text",
 CellID->900360919,ExpressionUUID->"04c061a2-1318-56b6-2cf0-780ca6ad3c9c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fixedBlur", "[", 
    RowBox[{"seed_", ",", " ", "nSteps_"}], "]"}], " ", ":=", " ", 
   RowBox[{"linearEntropy", " ", "/@", " ", 
    RowBox[{
     RowBox[{"trajectory", "[", 
      RowBox[{
       RowBox[{"id2", "/", "2"}], ",", " ", 
       RowBox[{"0", " ", "id2"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "kPur", "]"}], " ", "Z"}], "}"}], ",", " ", 
       RowBox[{"{", "1.", "}"}], ",", " ", 
       RowBox[{"{", "}"}], ",", " ", "tickPur", ",", " ", 
       RowBox[{"nSteps", " ", "tickPur"}], ",", " ", "seed"}], "]"}], 
     "[", "\"\<states\>\"", "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[220]:= ",
 CellID->1309857001,ExpressionUUID->"4605043a-8429-851b-6e3a-9e642dddec61"],

Cell[TextData[{
 "The ",
 StyleBox["steered",
  FontWeight->"Bold"],
 " strategy uses the record differently. Instead of a fixed axis it reads the \
current Bloch vector off the conditioned state and measures along an axis ",
 StyleBox["crosswise", "TI"],
 " to it, holding the fast ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17a8a95e-16a9-5185-3d57-4118a35c23ef"],
 " angle at every step. That is the feedback here: the record sets not a \
rotation of the state but the choice of which observable to measure next. A \
crosswise direction to a given Bloch vector:"
}], "Text",
 CellID->2058064877,ExpressionUUID->"6164d6ec-2035-6999-171b-cfb651c03be3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"crosswise", "[", "lean_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"Cross", "[", 
        RowBox[{"lean", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "1."}], "}"}]}], "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Norm", "[", "c", "]"}], " ", "<", " ", "1.*^-6"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"1.", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", " ", 
       RowBox[{"Normalize", "[", "c", "]"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[221]:= ",
 CellID->1911790330,ExpressionUUID->"6ca33e02-c939-75ea-1450-b06fe8cc5f30"],

Cell["\<\
One steered step measures the Pauli operator along that crosswise axis and \
advances the conditioned state by the same positivity-preserving update:\
\>", "Text",
 CellID->1010700267,ExpressionUUID->"22ebf147-b876-3430-52e8-e92139009f1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"steerStep", "[", 
    RowBox[{"rho_", ",", " ", "dw_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"leak", " ", "=", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "kPur", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"crosswise", "[", 
           RowBox[{"blochVector", "[", "rho", "]"}], "]"}], " ", ".", " ", 
          RowBox[{"{", 
           RowBox[{"X", ",", " ", "Y", ",", " ", "Z"}], "}"}]}], ")"}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"measurementStep", "[", 
       RowBox[{
        RowBox[{"0", " ", "id2"}], ",", " ", 
        RowBox[{"{", "leak", "}"}], ",", " ", 
        RowBox[{"{", "1.", "}"}], ",", " ", 
        RowBox[{"{", "}"}], ",", " ", "tickPur"}], "]"}], "[", 
      RowBox[{"rho", ",", " ", 
       RowBox[{"measurementRecord", "[", 
        RowBox[{"rho", ",", " ", 
         RowBox[{"{", "leak", "}"}], ",", " ", 
         RowBox[{"{", "1.", "}"}], ",", " ", "tickPur", ",", " ", 
         RowBox[{"{", "dw", "}"}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[222]:= ",
 CellID->1433985495,ExpressionUUID->"6cfbc0fa-05b7-6e65-1498-d9a4ac42354f"],

Cell["One steered run:", "Text",
 CellID->308737233,ExpressionUUID->"5726608a-327b-32d7-7ede-79d4470f803d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"steeredBlur", "[", 
    RowBox[{"seed_", ",", " ", "nSteps_"}], "]"}], " ", ":=", " ", 
   RowBox[{"linearEntropy", " ", "/@", " ", 
    RowBox[{"BlockRandom", "[", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "    ", 
      RowBox[{"FoldList", "[", 
       RowBox[{"steerStep", ",", " ", 
        RowBox[{"id2", "/", "2"}], ",", " ", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"Sqrt", "[", "tickPur", "]"}]}], "]"}], ",", " ", 
          "nSteps"}], "]"}]}], "]"}]}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[223]:= ",
 CellID->1903477021,ExpressionUUID->"1988f3c5-ff1f-c744-4fb7-eaaefaabadae"],

Cell[TextData[{
 "In formulas: with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], "=", 
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["\[Rho]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f1f17bc-e58b-5e92-0524-8ef98c3e24f8"],
 " the current Bloch vector, ",
 Cell[BoxData["steerStep"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5792d973-b7d4-8b8a-7da1-d13cc266d9d0"],
 " measures the leak ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["k", "TI"]], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "\[CenterDot]", 
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5edc8535-c3b1-a7f4-06e3-1d7ef6450dde"],
 " along a crosswise axis ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6224b0f8-da78-eb38-13db-29a5dff2b602"],
 ", perpendicular to ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c93b30-61da-1cc4-77f6-b37a106f662e"],
 ". Because that axis is perpendicular to the state the signal vanishes and \
the record is pure noise,"
}], "Text",
 CellID->1244942650,ExpressionUUID->"50e14eb3-b435-065f-009f-67fd3dc06ca5"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["J", "TI"], "=", "2", 
    SqrtBox[
     StyleBox["k", "TI"]], " ", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "\[CenterDot]", 
     OverscriptBox[
      StyleBox["a", "TI"], "\[RightVector]"]}], 
    StyleBox[")",
     SpanMaxSize->1], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"], "=", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1429544953,ExpressionUUID->"4e168156-9322-bc9f-762d-191026d406e5"],

Cell[TextData[{
 "which is nonetheless the fast case: a crosswise state is an equal \
superposition of the measured operator's eigenstates, where the back-action \
is strongest. The step is then the positivity-preserving measurement update \
of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c24659b-7133-dc8c-65dc-7cc500c7a6d6"],
 " under ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["c", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c508251-7fc9-b51c-546f-241b7a7d1c66"],
 " with that record, and nothing else, with no feedback unitary; the steering \
is only the re-choice of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1eef6872-bce7-1e04-4694-823c3492656e"],
 " at the next step, which holds ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30befcd9-b2cd-4711-6045-f582c7782a7b"],
 " throughout. Folding this from ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "0"], "=", 
   FractionBox["1", "2"], "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75516dcf-8dc3-fc25-236e-84a92477c70f"],
 " over ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0310a516-2392-3bde-312f-3d5056248924"],
 " Wiener increments ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f6c7faf-a6fa-97ca-4514-7608d28cfd10"],
 " (each of variance ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2573a629-b9de-50ac-5300-3873386b22f6"],
 ") gives one run's states ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "0"], ",", "\[Ellipsis]", ",", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59197c34-7185-90b0-0f27-767e0031e29a"],
 ", and ",
 Cell[BoxData["steeredBlur"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c633381-a2a9-ed02-5410-aaead75db468"],
 " returns their impurities ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["L", "TI"], 
    StyleBox["j", "TI"]], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[GridBox[{
       {
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], 
         StyleBox["j", "TI"]]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60c43628-0d8b-12d9-10fb-a872a43e6023"],
 "."
}], "Text",
 CellID->114240660,ExpressionUUID->"5f555f5b-d3f6-518f-056b-5704e58323d5"],

Cell["Average eighty runs of each strategy:", "Text",
 CellID->406013316,ExpressionUUID->"3145b7cb-6bdc-88b3-677a-2e950e6eda99"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fixedAvg", " ", "=", " ", 
   RowBox[{"Mean", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"fixedBlur", "[", 
       RowBox[{"#", ",", " ", "120"}], "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"Range", "[", "80", "]"}]}], "]"}]}], ";", " ", 
  RowBox[{"steeredAvg", " ", "=", " ", 
   RowBox[{"Mean", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"steeredBlur", "[", 
       RowBox[{"#", ",", " ", "120"}], "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"Range", "[", "80", "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[224]:= ",
 CellID->491451350,ExpressionUUID->"6b7074b7-b7c4-ad31-1900-6df0c276f41b"],

Cell["Compare the two at the same instant:", "Text",
 CellID->1571111005,ExpressionUUID->"6b848cdb-7c95-016b-19bb-2585752053b1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"fixedAvg", "[", 
    RowBox[{"[", "61", "]"}], "]"}], ",", " ", 
   RowBox[{"steeredAvg", "[", 
    RowBox[{"[", "61", "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[225]:= ",
 CellID->132272857,ExpressionUUID->"479e0012-80c3-e229-6da5-9a5c3177b173"],

Cell["\<\
At the same time the steered strategy has reached a lower linear entropy.\
\>", "Text",
 CellID->1230643425,ExpressionUUID->"3d6e3eb6-fa93-dc86-6b15-b7f3ff27a6ec"],

Cell["\<\
Now visualize both purification strategies on a log scale, where a straight \
line represents exponential decay:\
\>", "Text",
 CellID->1862623319,ExpressionUUID->"43bbad2d-592e-7807-7158-457758db4b6d"],

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"span", ",", " ", "fixedAvg"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"span", ",", " ", "steeredAvg"}], "}"}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<fixed measurement\>\"", ",", 
      " ", "\"\<steered measurement\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<linear entropy (log scale)\>\""}],
      "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<feedback purifies faster, and deterministically\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[226]:= ",
 CellID->187926588,ExpressionUUID->"6945d0ce-c536-08cf-1f7a-c9abecc35a15"],

Cell["\<\
The steered curve is steeper and smoother (a straight line tracking its \
deterministic exponential, while the fixed one is ragged, with no single \
rate): feedback makes the mean purification faster and deterministic.\
\>", "Text",
 CellID->835753090,ExpressionUUID->"3fccf01f-c27b-aa81-65f3-ea58f70ff8eb"],

Cell["\<\
But the mean hides the caveat, so look at the distributions. Run longer \
ensembles of each strategy so nearly every run reaches a target purity:\
\>", "Text",
 CellID->820508465,ExpressionUUID->"580a63e8-e8bd-fc69-080a-7ab58949c6b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"purGrid", " ", "=", " ", 
   RowBox[{"tickPur", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "200"}], "]"}]}]}], ";", " ", 
  RowBox[{"purN", " ", "=", " ", "200"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fixedRunsPur", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"fixedBlur", "[", 
      RowBox[{"#", ",", " ", "200"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"Range", "[", "purN", "]"}]}]}], ";", " ", 
  RowBox[{"steeredRunsPur", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"steeredBlur", "[", 
      RowBox[{"#", ",", " ", "200"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"Range", "[", "purN", "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[227]:= ",
 CellID->218374495,ExpressionUUID->"1e444979-635e-5aae-467c-612316eb28f4"],

Cell[TextData[{
 "First, that \"deterministic\" claim: the steered runs should each hug the \
exact law ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "4", 
     StyleBox["k", "TI"], 
     StyleBox["t", "TI"]}]], 
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5291a49d-a239-bb17-02ae-3dc6d7cd067d"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ed3e0f7-5290-ff26-56e0-f9b1672ac20c"],
 ", while a fixed run wanders. Overlay thirty steered paths on the analytic \
exponential, on a log scale:"
}], "Text",
 CellID->106949524,ExpressionUUID->"5e38d601-1464-7519-07c7-c86b9d115c63"],

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"purGrid", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"steeredRunsPur", "[", 
       RowBox[{"[", 
        RowBox[{";;", " ", "30"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"purGrid", ",", " ", 
        RowBox[{"0.5", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "4"}], " ", "kPur", " ", "purGrid"}], "]"}]}]}], 
       "}"}], "]"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"10", "^", 
         RowBox[{"-", "4"}]}], ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "480"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"Append", "[", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
          RowBox[{"Opacity", "[", "0.2", "]"}]}], "]"}], ",", " ", "30"}], 
       "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", "Dashed"}], "]"}]}], 
     "]"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"LineLegend", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<deterministic law\>\"", ",", 
        " ", "\"\<steered runs\>\""}], "}"}]}], "]"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<linear entropy (log)\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<steered runs hug the deterministic exponential \
(dashed)\>\""}]}], "]"}]], "Input",
 CellLabel->"In[228]:= ",
 CellID->384663498,ExpressionUUID->"0fc3dc78-1302-6f10-35f0-d622a6b7327a"],

Cell["\<\
Each steered path clings to the dashed line: the feedback really does make \
the purification deterministic run by run, not just on average.\
\>", "Text",
 CellID->457973463,ExpressionUUID->"4a61f55e-757a-9228-7a1e-ed187c0ce172"],

Cell[TextData[{
 "Now the objective-dependence. At a ",
 StyleBox["fixed time", "TI"],
 " the steered strategy wins, its impurity distribution sitting lower and \
tighter than the fixed one:"
}], "Text",
 CellID->103057839,ExpressionUUID->"792e178f-59c5-2aa3-28d5-8ee958707889"],

Cell[BoxData[
 RowBox[{"Histogram", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fixedRunsPur", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "61"}], "]"}], "]"}], ",", " ", 
     RowBox[{"steeredRunsPur", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "61"}], "]"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0.35", ",", " ", "0.01"}], "}"}], ",", 
   " ", "\"\<PDF\>\"", ",", "\n", " ", 
   RowBox[{"ChartLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<fixed\>\"", ",", " ", "\"\<steered\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "3"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<linear entropy at t = 0.6\>\"", ",", 
      " ", "\"\<density\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<at fixed time, steered is lower and tighter\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[229]:= ",
 CellID->1143862680,ExpressionUUID->"106526ab-6ace-99f4-401a-bff50f78ebde"],

Cell[TextData[{
 "But the ",
 StyleBox["first-passage time", "TI"],
 " to a chosen purity tells the opposite story. For each run, record the time \
it first drops below ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "=", "0.05"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14f1cae1-901f-fe6e-3c8e-e3cb21abc4b4"],
 ", or the window length if it never does:"
}], "Text",
 CellID->870857223,ExpressionUUID->"20e5bc00-ef5d-9182-509a-366d8ae9e3e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fptPur", "[", "run_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pos", " ", "=", " ", 
       RowBox[{"FirstPosition", "[", 
        RowBox[{"run", ",", " ", 
         RowBox[{"l_", " ", "/;", " ", 
          RowBox[{"l", " ", "<", " ", "0.05"}]}]}], "]"}]}], "}"}], ",", " ", 
     
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MissingQ", "[", "pos", "]"}], ",", " ", "2.", ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"First", "[", "pos", "]"}], " ", "-", " ", "1"}], ")"}], " ",
         "tickPur"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[230]:= ",
 CellID->229984321,ExpressionUUID->"0eb778b1-5bb9-ca6f-364d-71fb5e4d98b5"],

Cell["Collect that time for every run of each strategy:", "Text",
 CellID->2065932053,ExpressionUUID->"60fa5ffe-638f-3fb5-109a-56b8163b859f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fptFixed", ",", " ", "fptSteer"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fptPur", " ", "/@", " ", "fixedRunsPur"}], ",", " ", 
     RowBox[{"fptPur", " ", "/@", " ", "steeredRunsPur"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[231]:= ",
 CellID->7922854,ExpressionUUID->"730b2763-752d-95c0-2108-bf4d7cd9ff2a"],

Cell["Histogram the two distributions:", "Text",
 CellID->1900525282,ExpressionUUID->"1fb8ba9f-9118-d887-4547-33d92092aaed"],

Cell[BoxData[
 RowBox[{"Histogram", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fptFixed", ",", " ", "fptSteer"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1.2", ",", " ", "0.06"}], "}"}], ",", 
   " ", "\"\<PDF\>\"", ",", " ", 
   RowBox[{"ChartLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<fixed\>\"", ",", " ", "\"\<steered\>\""}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "3"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<first-passage time to linear entropy < 0.05\>\"", ",", 
      " ", "\"\<density\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<yet the fixed measurement often reaches the target \
sooner\>\""}]}], "]"}]], "Input",
 CellLabel->"In[232]:= ",
 CellID->865264521,ExpressionUUID->"04257d5a-c533-40c1-2ddb-7507ecc6122b"],

Cell["\<\
The fixed strategy reaches down to shorter times: its runs vary, and the \
lucky ones cross the target before the steered runs, which cluster tightly at \
their single deterministic hitting time.\
\>", "Text",
 CellID->1876999321,ExpressionUUID->"3e9a3b8c-0d9b-39c6-66b9-b2d6a42f8b2c"],

Cell["\<\
Compare the two means directly, fixed-time impurity against mean hitting time:\
\>", "Text",
 CellID->402499516,ExpressionUUID->"57c094f8-e1f7-16c3-7dff-0da597827c29"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<\>\"", ",", " ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<fixed\>\"", ",", " ", "Bold"}], "]"}], ",", " ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<steered\>\"", ",", " ", "Bold"}], "]"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<linear entropy at t = 0.6\>\"", ",", " ", "Bold"}], 
        "]"}], ",", " ", 
       RowBox[{"Mean", "[", 
        RowBox[{"fixedRunsPur", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "61"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"Mean", "[", 
        RowBox[{"steeredRunsPur", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "61"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<first-passage time to linear entropy < 0.05\>\"", ",", 
         " ", "Bold"}], "]"}], ",", " ", 
       RowBox[{"Mean", "[", "fptFixed", "]"}], ",", " ", 
       RowBox[{"Mean", "[", "fptSteer", "]"}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "1"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[233]:= ",
 CellID->622903162,ExpressionUUID->"53c10e17-89f4-5846-01fe-a0512f812aac"],

Cell[TextData[{
 "The steered strategy has the lower fixed-time impurity but the ",
 StyleBox["longer", "TI"],
 " mean first-passage: its determinism forbids the lucky fast records that \
let a fixed measurement occasionally reach the target early. Which protocol \
is \"optimal\" depends on the question, sharp average purity by a deadline or \
shortest typical time to a goal, and no single curve can answer both. This is \
the ",
 ButtonBox["Wiseman-Ralph",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/quant-ph/0603062"], None}],
 " point, made by the distributions rather than asserted."
}], "Text",
 CellID->649785500,ExpressionUUID->"4f08220d-2a73-b203-7537-c4574f070169"],

Cell["Feedback Cooling of a Mechanical Oscillator", "Subsection",
 CellID->1698847202,ExpressionUUID->"111d4832-3a0a-d5b2-4723-627cbfbcbf98"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Continuously measure a mechanical oscillator's position (its annihilation \
operator is ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1845e666-64b6-1241-487a-f8400d4360ab"],
 ") through a cavity and push against its estimated motion to cool it, \
against a thermal bath:"
}], "Text",
 CellID->696242602,ExpressionUUID->"1968941f-a9d2-0fb7-4f17-0e58c867559d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   StyleBox[
    RowBox[{"d", "\[Rho]"}], "TI"], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       StyleBox["i", "TI"], 
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        RowBox[{
         StyleBox["\[Omega]", "TI"], 
         SuperscriptBox[
          OverscriptBox[
           StyleBox["b", "TI"], "^"], "\[Dagger]"], 
         OverscriptBox[
          StyleBox["b", "TI"], "^"], "-", 
         StyleBox["f", "TI"], 
         StyleBox["(",
          SpanMaxSize->1], 
         StyleBox["t", "TI"], 
         StyleBox[")",
          SpanMaxSize->1], 
         OverscriptBox[
          StyleBox["x", "TI"], "^"]}], ",", " ", 
        StyleBox["\[Rho]", "TI"]}], 
       StyleBox["]",
        SpanMaxSize->1]}]}], " ", 
     StyleBox["d", "TI"], 
     StyleBox["t", "TI"]}], "+", 
    RowBox[{
     StyleBox["k", "TI"], " ", 
     RowBox[{"\|01d49f", 
      StyleBox["[",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["x", "TI"], "^"], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     StyleBox["\[Rho]", "TI"], " ", 
     StyleBox["d", "TI"], 
     StyleBox["t", "TI"]}], "+", 
    RowBox[{
     SqrtBox[
      StyleBox[
       RowBox[{"\[Eta]", "k"}], "TI"]], " ", 
     RowBox[{
      StyleBox["(",
       FontSize->1.2 Inherited], 
      RowBox[{
       RowBox[{
        OverscriptBox[
         StyleBox["x", "TI"], "^"], 
        StyleBox["\[Rho]", "TI"]}], "+", 
       RowBox[{
        StyleBox["\[Rho]", "TI"], 
        OverscriptBox[
         StyleBox["x", "TI"], "^"]}], "-", 
       RowBox[{"2", 
        RowBox[{
         StyleBox["\[LeftAngleBracket]",
          SpanMaxSize->1], 
         OverscriptBox[
          StyleBox["x", "TI"], "^"], 
         StyleBox["\[RightAngleBracket]",
          SpanMaxSize->1]}], 
        StyleBox["\[Rho]", "TI"]}]}], 
      StyleBox[")",
       FontSize->1.2 Inherited]}], " ", 
     StyleBox["d", "TI"], 
     StyleBox["W", "TI"]}], "+", 
    RowBox[{
     StyleBox["\[Gamma]", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["T", "TI"]], "+", "1"}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{"\|01d49f", 
      StyleBox["[",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["b", "TI"], "^"], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     StyleBox["\[Rho]", "TI"], " ", 
     StyleBox["d", "TI"], 
     StyleBox["t", "TI"]}], "+", 
    RowBox[{
     StyleBox["\[Gamma]", "TI"], 
     SubscriptBox[
      StyleBox["n", "TI"], 
      StyleBox["T", "TI"]], 
     RowBox[{"\|01d49f", 
      StyleBox["[",
       SpanMaxSize->1], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["b", "TI"], "^"], "\[Dagger]"], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     StyleBox["\[Rho]", "TI"], " ", 
     StyleBox["d", "TI"], 
     RowBox[{
      StyleBox["t", "TI"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->437857044,ExpressionUUID->"1aac0bc6-af4d-b58b-4a53-a2a3caf91fd1"],

Cell[TextData[{
 "Watching sharpens the estimate, the feedback force ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], "\[Proportional]", "-", 
   StyleBox["G", "TI"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["p", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a712f16-d19b-4a25-1a0e-c753e02e190f"],
 " drains the energy, and the leftover is a balance of measurement rate, \
efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53fb696e-29db-c2cc-0198-8148486f9016"],
 ", gain ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37c87ba4-2338-bc26-5dc8-720e56b2070c"],
 ", and heating ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "038c2d24-7693-7bfc-31b3-c48e032649c6"],
 ". Watching alone only heats; feedback cools, but only up to an optimal gain \
beyond which it feeds the detector's noise back onto the oscillator. Cool a \
warm start, find the best gain, and sweep the detector quality."
}], "Text",
 CellID->1959355771,ExpressionUUID->"5b3c81a1-c373-b6e1-0ac3-180af6071ccb"],

Cell[TextData[{
 "The same measure-and-feedback loop cools a mechanical oscillator, but \
cooling takes more than watching: the loop must act. Three pieces enter now \
that the Kalman tracker did not have. A thermal bath (damping ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ffd377e-a04d-810f-3582-af3bd1f9d055"],
 ", occupation ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78b094ae-e1b9-bff8-284f-0d0b904d05c2"],
 ") keeps trying to warm the oscillator; the continuous position measurement \
(strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34420a65-0085-ff13-5c71-ac4fb131c279"],
 ", efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33d8432c-7aae-24d4-61f8-5b767f588e3e"],
 ") tracks it; and a feedback force pushes back against the ",
 StyleBox["estimated", "TI"],
 " velocity, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], "=", "-", 
   StyleBox["G", "TI"], " ", 
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["p", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7102de1b-2c49-6276-2731-d04545fc315c"],
 " (the conditional mean), draining energy. The state is Gaussian throughout, \
so, as in the Kalman filter, the conditional covariance is deterministic and \
the conditional mean is stochastic. This example stands alone, so fix its own \
constants:"
}], "Text",
 CellID->11075551,ExpressionUUID->"3f3745d9-f640-89cf-66cd-5c8283fadb15"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kCool", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"etaCool", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"gammaCool", " ", "=", " ", "0.1"}], ";", " ", 
  RowBox[{"nCool", " ", "=", " ", "10."}], ";"}]], "Input",
 CellLabel->"In[234]:= ",
 CellID->826226521,ExpressionUUID->"2af3e211-783e-5495-5a80-045b79cb3eff"],

Cell[TextData[{
 "The conditional covariance is the tracking Riccati of Part Five again, now \
carrying the bath (a drift toward the thermal spread ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]], "+", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "526c503f-6148-6cb6-0214-4a7910fd369c"],
 " at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a901ca6-02d7-1d1b-6aaf-9500b7626461"],
 ") and the efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0decacba-7d10-76c3-3b93-45e474a55c29"],
 " on the information-gain terms, while the back-action term ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "256534ec-e492-cc88-531a-adc98d2496d2"],
 " stays full. In the three entries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     StyleBox[
      RowBox[{"x", "x"}], "TI"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox[
      RowBox[{"x", "p"}], "TI"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox[
      RowBox[{"p", "p"}], "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "106dd93e-13c5-b1cf-4012-d178a6710315"],
 ","
}], "Text",
 CellID->2011372776,ExpressionUUID->"510b310d-dc97-d591-0708-a956d523bffb"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    FractionBox[
     StyleBox["d", "TI"], 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]], "(", GridBox[{
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox[
         RowBox[{"x", "x"}], "TI"]]},
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox[
         RowBox[{"x", "p"}], "TI"]]},
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox[
         RowBox[{"p", "p"}], "TI"]]}
     }], ")", "=", "(", GridBox[{
      {
       RowBox[{"2", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "p"}], "TI"]], "-", "4", 
        StyleBox["\[Eta]", "TI"], 
        StyleBox["k", "TI"], " ", 
        SubsuperscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "x"}], "TI"], "2"], "-", 
        StyleBox["\[Gamma]", "TI"], 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "x"}], "TI"]], "+", 
        StyleBox["\[Gamma]", "TI"], 
        StyleBox["(",
         FontSize->1.2 Inherited], 
        SubscriptBox[
         StyleBox["n", "TI"], 
         StyleBox["T", "TI"]], "+", 
        FractionBox["1", "2"], 
        StyleBox[")",
         FontSize->1.2 Inherited]}]},
      {
       RowBox[{
        SubscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"p", "p"}], "TI"]], "-", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "x"}], "TI"]], "-", "4", 
        StyleBox["\[Eta]", "TI"], 
        StyleBox["k", "TI"], " ", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "x"}], "TI"]], 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "p"}], "TI"]], "-", 
        StyleBox["\[Gamma]", "TI"], 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "p"}], "TI"]]}]},
      {
       RowBox[{
        StyleBox["k", "TI"], "-", "2", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "p"}], "TI"]], "-", "4", 
        StyleBox["\[Eta]", "TI"], 
        StyleBox["k", "TI"], " ", 
        SubsuperscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "p"}], "TI"], "2"], "-", 
        StyleBox["\[Gamma]", "TI"], 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"p", "p"}], "TI"]], "+", 
        StyleBox["\[Gamma]", "TI"], 
        StyleBox["(",
         FontSize->1.2 Inherited], 
        SubscriptBox[
         StyleBox["n", "TI"], 
         StyleBox["T", "TI"]], "+", 
        FractionBox["1", "2"], 
        StyleBox[")",
         FontSize->1.2 Inherited]}]}
     }], ")"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->85539763,ExpressionUUID->"3a88f114-48ba-1446-6ab7-e95e694f7eac"],

Cell[TextData[{
 "integrated from the thermal start ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"x", "x"}], "TI"]], "=", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"p", "p"}], "TI"]], "=", 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]], "+", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14b48af2-5d27-861c-3c4b-23bc54d3ed66"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"x", "p"}], "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72f98829-a4e0-9e42-2286-2272cc9ae4a8"],
 ":"
}], "Text",
 CellID->247751216,ExpressionUUID->"1350650b-6691-6e3e-4160-7d5513243504"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"riccatiCool", "[", "\[Eta]_", "]"}], " ", ":=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"vx", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"vc", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"4", " ", "\[Eta]", " ", "kCool", " ", 
          RowBox[{
           RowBox[{"vx", "[", "t", "]"}], "^", "2"}]}], " ", "-", " ", 
         RowBox[{"gammaCool", " ", 
          RowBox[{"vx", "[", "t", "]"}]}], " ", "+", " ", 
         RowBox[{"gammaCool", " ", 
          RowBox[{"(", 
           RowBox[{"nCool", " ", "+", " ", 
            RowBox[{"1", "/", "2"}]}], ")"}]}]}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"vc", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"vp", "[", "t", "]"}], " ", "-", " ", 
         RowBox[{"vx", "[", "t", "]"}], " ", "-", " ", 
         RowBox[{"4", " ", "\[Eta]", " ", "kCool", " ", 
          RowBox[{"vx", "[", "t", "]"}], " ", 
          RowBox[{"vc", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"gammaCool", " ", 
          RowBox[{"vc", "[", "t", "]"}]}]}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"vp", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{"vc", "[", "t", "]"}]}], " ", "+", " ", "kCool", " ", "-", 
         " ", 
         RowBox[{"4", " ", "\[Eta]", " ", "kCool", " ", 
          RowBox[{
           RowBox[{"vc", "[", "t", "]"}], "^", "2"}]}], " ", "-", " ", 
         RowBox[{"gammaCool", " ", 
          RowBox[{"vp", "[", "t", "]"}]}], " ", "+", " ", 
         RowBox[{"gammaCool", " ", 
          RowBox[{"(", 
           RowBox[{"nCool", " ", "+", " ", 
            RowBox[{"1", "/", "2"}]}], ")"}]}]}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"vx", "[", "0", "]"}], " ", "==", " ", 
        RowBox[{"nCool", " ", "+", " ", 
         RowBox[{"1", "/", "2"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"vc", "[", "0", "]"}], " ", "==", " ", "0."}], ",", " ", 
       RowBox[{
        RowBox[{"vp", "[", "0", "]"}], " ", "==", " ", 
        RowBox[{"nCool", " ", "+", " ", 
         RowBox[{"1", "/", "2"}]}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"vx", ",", " ", "vc", ",", " ", "vp"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "80"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[235]:= ",
 CellID->375124362,ExpressionUUID->"532d51c4-b79b-7573-02d3-48a1c22e5c59"],

Cell["\<\
The steady covariance, read off the late-time solution, is the sharpest the \
observer can ever know the oscillator:\
\>", "Text",
 CellID->898261846,ExpressionUUID->"02713c5f-c8e5-0f11-320e-b618e890527b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"steadyCovCool", "[", "\[Eta]_", "]"}], " ", ":=", " ", 
   RowBox[{"Through", "[", 
    RowBox[{
     RowBox[{"riccatiCool", "[", "\[Eta]", "]"}], "[", "80.", "]"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[236]:= ",
 CellID->2123245851,ExpressionUUID->"00749321-443e-2ca3-300b-0a8b6dcb7689"],

Cell[TextData[{
 "Take its three entries at perfect efficiency, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "639faa00-a42a-3ba8-11a4-4c6dcddc89f2"],
 ":"
}], "Text",
 CellID->1888499658,ExpressionUUID->"157f93fd-228f-3ab7-4304-0aa7573b889d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"vxCool", ",", " ", "vcCool", ",", " ", "vpCool"}], "}"}], " ", "=",
    " ", 
   RowBox[{"steadyCovCool", "[", "1.", "]"}]}], ";"}]], "Input",
 CellLabel->"In[237]:= ",
 CellID->237269248,ExpressionUUID->"671b21e8-1ced-259b-0d38-b8b294998fe1"],

Cell[TextData[{
 "Its mean phonon number is the ",
 StyleBox["conditional floor", "TI"],
 ", the lowest occupation the record can pin down:"
}], "Text",
 CellID->1574480490,ExpressionUUID->"0804b894-7cc5-dcd3-383b-31de7571a639"],

Cell[BoxData[
 RowBox[{
  RowBox[{"condFloorCool", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"vxCool", " ", "+", " ", "vpCool"}], ")"}], "/", "2"}], " ", "-",
     " ", "0.5"}]}], ";"}]], "Input",
 CellLabel->"In[238]:= ",
 CellID->1044501402,ExpressionUUID->"30585328-1edb-3b29-6078-4b729b6f8673"],

Cell[TextData[{
 "The Kalman gains ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    StyleBox["k", "TI"]], " ", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"x", "x"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "028df322-620d-9ccb-32b2-ea8c17b9e611"],
 " and ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    StyleBox["k", "TI"]], " ", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"x", "p"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11eedd29-5af3-1cdc-4795-d5735e866626"],
 " set how hard each record increment steers the estimate:"
}], "Text",
 CellID->1803296954,ExpressionUUID->"553e565f-4fcb-4d17-7cc6-48196a7e147d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kxCool", " ", "=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Sqrt", "[", "kCool", "]"}], " ", "vxCool"}]}], ";", " ", 
  RowBox[{"kpCool", " ", "=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Sqrt", "[", "kCool", "]"}], " ", "vcCool"}]}], ";"}]], "Input",
 CellLabel->"In[239]:= ",
 CellID->1178089277,ExpressionUUID->"7f6c6217-8665-62c8-2513-845133103012"],

Cell[TextData[{
 "Here is the key point, and the reason watching alone is not cooling: \
averaged over all records, the unconditional occupation is the conditional \
floor plus the spread of the estimate about it, and that spread solves a \
Lyapunov equation with the closed-loop drift ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["A", "TI"], 
   StyleBox["G", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f4879b1-2b62-b5b2-6548-70fb4e141f98"],
 " (free rotation, bath damping, and the feedback ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["G", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d218d48-f517-61a3-24de-2515fca23389"],
 " on ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["p", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68418108-62e2-e866-187e-19521694bb4c"],
 ") fed by the Kalman-gain noise:"
}], "Text",
 CellID->499442545,ExpressionUUID->"01703913-adda-f952-370f-b15cc46ccbb8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nUncCool", "[", "gg_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"LyapunovSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "gammaCool"}], "/", "2"}], ",", " ", "1"}], "}"}], 
           ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "gammaCool"}], "/", "2"}], " ", "-", " ", 
              "gg"}]}], "}"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"-", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"kxCool", "^", "2"}], ",", " ", 
              RowBox[{"kxCool", " ", "kpCool"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"kxCool", " ", "kpCool"}], ",", " ", 
              RowBox[{"kpCool", "^", "2"}]}], "}"}]}], "}"}]}]}], "]"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"s", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
         "vxCool", " ", "+", " ", 
         RowBox[{"s", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "+", " ", 
         "vpCool"}], ")"}], "/", "2"}], " ", "-", " ", "0.5"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[240]:= ",
 CellID->1977375848,ExpressionUUID->"6126f6d0-c79c-20ba-10dd-ef9df2297280"],

Cell[TextData[{
 "With no feedback, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["G", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e4879c1-44de-859e-4648-70ab6d68efe4"],
 ", watching does not cool at all: it ",
 StyleBox["heats", "TI"],
 ", because measurement back-action kicks the momentum and nothing removes \
the energy. Confirm this two ways, the conditional-plus-spread bookkeeping \
against the plain unconditional master equation (back-action on ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox[
    RowBox[{"p", "p"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d2a80d4-ca9b-9dca-1b29-1991ef2fe710"],
 ", bath, no information gain):"
}], "Text",
 CellID->1792186819,ExpressionUUID->"56de89fa-72f1-8b5c-7ee5-20a40685d9a6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nUncCool", "[", "0.", "]"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", " ", "=", " ", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"vx", "'"}], "[", "t", "]"}], " ", "==", " ", 
            RowBox[{
             RowBox[{"2", " ", 
              RowBox[{"vc", "[", "t", "]"}]}], " ", "-", " ", 
             RowBox[{"gammaCool", " ", 
              RowBox[{"vx", "[", "t", "]"}]}], " ", "+", " ", 
             RowBox[{"gammaCool", " ", 
              RowBox[{"(", 
               RowBox[{"nCool", " ", "+", " ", 
                RowBox[{"1", "/", "2"}]}], ")"}]}]}]}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"vc", "'"}], "[", "t", "]"}], " ", "==", " ", 
            RowBox[{
             RowBox[{"vp", "[", "t", "]"}], " ", "-", " ", 
             RowBox[{"vx", "[", "t", "]"}], " ", "-", " ", 
             RowBox[{"gammaCool", " ", 
              RowBox[{"vc", "[", "t", "]"}]}]}]}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"vp", "'"}], "[", "t", "]"}], " ", "==", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              RowBox[{"vc", "[", "t", "]"}]}], " ", "+", " ", "kCool", " ", "-",
              " ", 
             RowBox[{"gammaCool", " ", 
              RowBox[{"vp", "[", "t", "]"}]}], " ", "+", " ", 
             RowBox[{"gammaCool", " ", 
              RowBox[{"(", 
               RowBox[{"nCool", " ", "+", " ", 
                RowBox[{"1", "/", "2"}]}], ")"}]}]}]}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"vx", "[", "0", "]"}], " ", "==", " ", 
            RowBox[{"nCool", " ", "+", " ", "0.5"}]}], ",", " ", 
           RowBox[{
            RowBox[{"vc", "[", "0", "]"}], " ", "==", " ", "0."}], ",", " ", 
           RowBox[{
            RowBox[{"vp", "[", "0", "]"}], " ", "==", " ", 
            RowBox[{"nCool", " ", "+", " ", "0.5"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"vx", ",", " ", "vp"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "200"}], "}"}]}], "]"}]}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "[", "200.", "]"}], " ", "+", " ", 
         
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "[", "200.", "]"}]}], ")"}], "/", 
       "2"}], " ", "-", " ", "0.5"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[241]:= ",
 CellID->883014421,ExpressionUUID->"081b024f-dee7-bb3c-3838-a428da930606"],

Cell[TextData[{
 "Both give the same number, above the bath's ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]], "=", "10"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3068938a-aea6-7f4c-6017-0ad7cb534596"],
 ": the meter alone leaves the oscillator hotter than it found it."
}], "Text",
 CellID->1335019792,ExpressionUUID->"59143b51-5090-fe62-0f2b-b31b612ac548"],

Cell["\<\
Now close the loop. The conditional mean is a stochastic trajectory driven by \
the innovation, with the feedback force damping the momentum estimate:\
\>", "Text",
 CellID->162990234,ExpressionUUID->"4b8a926c-2b03-23e8-7989-14364eb67132"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Gcool", " ", "=", " ", "2."}], ";", " ", 
  RowBox[{"dtCool", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"nStepCool", " ", "=", " ", "2500"}], ";", " ", 
  RowBox[{"timesCool", " ", "=", " ", 
   RowBox[{"dtCool", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "nStepCool"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[242]:= ",
 CellID->1864261496,ExpressionUUID->"0eb42765-6752-c125-364b-bf4f12e4900f"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dda19df-f0ae-deb2-6bf9-90988158a498"],
 " the oscillator is thermal, so the total covariance is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1", "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40683ad5-3e3c-3dc9-7017-b39fbbce8713"],
 ". That total splits into the conditional floor the filter always carries \
plus the spread of the estimate about it, so the means must be drawn with the \
full ",
 StyleBox["difference", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", 
    FractionBox["1", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\|01d7d9", "-", 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b8f60bd-75aa-c5dc-49b5-79e77c5caf26"],
 ", including its off-diagonal ",
 Cell[BoxData[
  RowBox[{"-", 
   SubscriptBox[
    StyleBox["v", "TI"], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fc740cd-cbf6-6955-05fd-5996ed833bbf"],
 ", to avoid double-counting the initial uncertainty and to make the initial \
unconditional state exactly thermal:"
}], "Text",
 CellID->875071895,ExpressionUUID->"003aef4b-20aa-e832-31d9-0715515cbb18"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"meanRunCool", "[", 
    RowBox[{"gg_", ",", " ", "seed_"}], "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"init", " ", "=", " ", 
          RowBox[{"RandomVariate", "[", 
           RowBox[{"MultinormalDistribution", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0.", ",", " ", "0."}], "}"}], ",", "\n", "        ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                 "nCool", " ", "+", " ", "0.5", " ", "-", " ", "vxCool"}], ",",
                  " ", 
                 RowBox[{"-", "vcCool"}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "vcCool"}], ",", " ", 
                 RowBox[{
                 "nCool", " ", "+", " ", "0.5", " ", "-", " ", "vpCool"}]}], 
                "}"}]}], "}"}]}], "]"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{"kicks", " ", "=", " ", 
          RowBox[{"RandomVariate", "[", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"Sqrt", "[", "dtCool", "]"}]}], "]"}], ",", " ", 
            "nStepCool"}], "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"FoldList", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"xp", ",", " ", "dw"}], "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"xp", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"xp", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
                 RowBox[{
                  RowBox[{"gammaCool", "/", "2"}], " ", 
                  RowBox[{"xp", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], " ", "dtCool"}],
               " ", "+", " ", 
              RowBox[{"kxCool", " ", "dw"}]}], ",", "\n", "       ", 
             RowBox[{
              RowBox[{"xp", "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", "+", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"xp", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], " ", "-", " ", 
                 RowBox[{
                  RowBox[{"gammaCool", "/", "2"}], " ", 
                  RowBox[{"xp", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], " ", "-", " ", 
                 RowBox[{"gg", " ", 
                  RowBox[{"xp", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}], " ", "dtCool"}],
               " ", "+", " ", 
              RowBox[{"kpCool", " ", "dw"}]}]}], "}"}]}], "]"}], ",", "\n", 
         "     ", "init", ",", " ", "kicks"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[243]:= ",
 CellID->1252034050,ExpressionUUID->"28e0bad7-cafc-1653-589f-3390ee897cb9"],

Cell["\<\
The unconditional occupation in time is the ensemble spread of these means \
plus the conditional floor. Track it with the loop open and closed:\
\>", "Text",
 CellID->41937841,ExpressionUUID->"2580c3d6-5855-812a-53bf-da9059e1d070"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nEnsCool", " ", "=", " ", "120"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nDrainCool", "[", "gg_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ens", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"meanRunCool", "[", 
          RowBox[{"gg", ",", " ", "s"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"s", ",", " ", "nEnsCool"}], "}"}]}], "]"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Variance", "[", 
            RowBox[{"ens", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "j", ",", " ", "1"}], "]"}], "]"}], 
            "]"}], " ", "+", " ", "vxCool", " ", "+", " ", 
           RowBox[{"Variance", "[", 
            RowBox[{"ens", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "j", ",", " ", "2"}], "]"}], "]"}], 
            "]"}], " ", "+", " ", "vpCool"}], ")"}], "/", "2"}], " ", "-", 
        " ", "0.5"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "1", ",", " ", 
         RowBox[{"nStepCool", " ", "+", " ", "1"}], ",", " ", "25"}], "}"}]}],
       "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"coolOff", ",", " ", "coolOn"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"nDrainCool", "[", "0.", "]"}], ",", " ", 
     RowBox[{"nDrainCool", "[", "Gcool", "]"}]}], "}"}]}], ";"}]}], "Input",
 CellLabel->"In[244]:= ",
 CellID->1124512868,ExpressionUUID->"56436948-eb78-7da0-7e70-81158e0d478a"],

Cell["\<\
Now visualize the cooling: the occupation with the loop off (heating above \
the bath) and on (draining toward, but not reaching, the conditional floor):\
\>", "Text",
 CellID->225942279,ExpressionUUID->"1d2fa041-c708-9d58-44d4-3a2af2a2e7a2"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"timesCool", "[", 
         RowBox[{"[", 
          RowBox[{"1", " ", ";;", " ", ";;", " ", "25"}], "]"}], "]"}], ",", 
        " ", "coolOff"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"timesCool", "[", 
         RowBox[{"[", 
          RowBox[{"1", " ", ";;", " ", ";;", " ", "25"}], "]"}], "]"}], ",", 
        " ", "coolOn"}], "}"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
