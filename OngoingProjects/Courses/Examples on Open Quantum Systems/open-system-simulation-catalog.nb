     SpanMaxSize->1], "\[Proportional]", 
    StyleBox["Re",
     FontSlant->"Plain"], 
    SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[Mu]", "TI"], 
      StyleBox["t", "TI"]}]], "\[ThinSpace]", 
    SubscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Delta]", "TI"], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], "+"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1], 
       StyleBox["\[Delta]", "TI"], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], "-"], 
       StyleBox["(",
        SpanMaxSize->1], "0", 
       StyleBox[")",
        SpanMaxSize->1]}], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox[
      RowBox[{"s", "s"}], "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->512383039,ExpressionUUID->"657c1c65-980e-511d-1303-964f19bb2067"],

Cell["The Toolkit: Everything the Twenty Examples Share", "Section",
 CellID->273308241,ExpressionUUID->"0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],

Cell["\<\
Before any specific system, we build the small set of tools every example \
reuses. There are about ten of them, each a few lines. Once they are in hand, \
each of the twenty systems is just a short setup, a run, a picture, and a \
check.\
\>", "Text",
 CellID->1809098798,ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell["The density matrix, and quantities read from it", "Subsection",
 CellID->156430199,ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"],

Cell[TextData[{
 "The smallest system is a qubit. Everything is built from the three Pauli \
matrices ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],
 ", ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370294fd-9e49-2d35-5d31-0da71bfc741f"],
 ", ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2845529c-454d-b13b-587b-4bc66cf90001"],
 " and the 2-by-2 identity:"
}], "Text",
 CellID->724760089,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"id2", ",", " ", "X", ",", " ", "Y", ",", " ", "Z"}], "}"}], " ", 
   "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "j", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->168408080,ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell[TextData[{
 "The basis states are the excited state ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      StyleBox["e", "TI"]},
     "Ket"], "=", "{", "1"}], ",", 
   RowBox[{"0", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6405505f-4b92-3bd6-0c3b-4a196e24893c"],
 " and the ground state ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      StyleBox["g", "TI"]},
     "Ket"], "=", "{", "0"}], ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6878c7f8-419e-9db5-1807-dea27028e79f"],
 "; their equal superposition is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"+"},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      TemplateBox[{
        StyleBox["e", "TI"]},
       "Ket"], "+", 
      TemplateBox[{
        StyleBox["g", "TI"]},
       "Ket"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "/", 
    SqrtBox["2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48a3d607-c312-9dd3-7850-c860f6a4e739"],
 ":"
}], "Text",
 CellID->811283638,ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"],

Cell[BoxData[
 RowBox[{
  RowBox[{"excited", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "0"}], "}"}]}], ";", " ", 
  RowBox[{"ground", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1"}], "}"}]}], ";", " ", 
  RowBox[{"plus", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}], "/", 
    RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->207978548,ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell[TextData[{
 "The lowering operator ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "-"], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["g", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["e", "TI"]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023f49e2-a747-9723-33c5-60cfd2f3fa09"],
 " takes the excited state to the ground state (an atom emitting a photon). \
Build it from the Pauli matrices:"
}], "Text",
 CellID->437474228,ExpressionUUID->"21aa1c49-e16c-f406-57a9-9612901edf6c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lower", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"X", " ", "-", " ", 
      RowBox[{"I", " ", "Y"}]}], ")"}], "/", "2"}]}], ";"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->874582697,ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"],

Cell[TextData[{
 "Check that it sends ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f3dbee-abc4-6375-4280-d2cbce714e5f"],
 " to ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
 ":"
}], "Text",
 CellID->11631581,ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"],

Cell[BoxData[
 RowBox[{"lower", " ", ".", " ", "excited"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->1933762060,ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell[TextData[{
 "It lands on the ground state. Its conjugate transpose is the raising \
operator ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], "+"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01ed6b92-5a5f-fa78-3792-82dc5febc942"],
 ", written inline when needed."
}], "Text",
 CellID->1055776787,ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"],

Cell[TextData[{
 "A state vector describes only a pure state. The general state, pure or \
mixed, is the density matrix; for a pure state it is the outer product ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6798df62-4cc7-e4e1-0da7-d74c6573cecb"],
 ":"
}], "Text",
 CellID->1859711813,ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"densityMatrix", "[", "v_", "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{"v", ",", " ", 
     RowBox[{"Conjugate", "[", "v", "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->1348896709,ExpressionUUID->"2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],

Cell["Form the density matrix of the excited state:", "Text",
 CellID->1427211115,ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c"],

Cell[BoxData[
 RowBox[{"densityMatrix", "[", "excited", "]"}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->2099805207,ExpressionUUID->"52243646-2fbd-210e-03db-a8204a487054"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1acd7f4d-3da3-7753-4af3-7717b4565db9"],
 " this is a single 1 in the top corner."
}], "Text",
 CellID->1402006442,ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a"],

Cell[TextData[{
 "Two quantities summarize any qubit state. The first is the ",
 StyleBox["Bloch vector",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["x", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["y", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],
 ": it has length 1 for a pure state and shrinks as the state mixes. Define \
it:"
}], "Text",
 CellID->1901179466,ExpressionUUID->"6f6ad260-8ee1-565a-1569-d44a2a943ca0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"blochVector", "[", "rho_", "]"}], " ", ":=", " ", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"rho", " ", ".", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"X", ",", " ", "Y", ",", " ", "Z"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->210724908,ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell[TextData[{
 "Check that ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],
 " points along the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],
 "-axis:"
}], "Text",
 CellID->1992790374,ExpressionUUID->"6b853673-18d0-d9fa-19ba-a83d996aabc0"],

Cell[BoxData[
 RowBox[{"blochVector", "[", 
  RowBox[{"densityMatrix", "[", "plus", "]"}], "]"}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->292747604,ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"],

Cell[TextData[{
 "It points along the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "574a2197-51ef-7938-7d49-b8d1679a4802"],
 "-axis, length one."
}], "Text",
 CellID->1553818268,ExpressionUUID->"6e85e9ed-427b-8528-16ba-00b7770fec72"],

Cell[TextData[{
 "The second quantity is the ",
 StyleBox["purity",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "2"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73b76025-96bb-3fff-214d-798f234f85c5"],
 ": 1 for a pure state, one half for the maximally mixed qubit. Define it:"
}], "Text",
 CellID->1870754514,ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"purity", "[", "rho_", "]"}], " ", ":=", " ", 
   RowBox[{"Re", "@", 
    RowBox[{"Tr", "[", 
     RowBox[{"rho", " ", ".", " ", "rho"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->1358728755,ExpressionUUID->"72ff7667-e560-b2c0-2285-68408c1a002a"],

Cell["Read it for a pure state and for the maximally mixed one:", "Text",
 CellID->935019337,ExpressionUUID->"7c9be80e-0554-61c1-24b8-0268ace1332b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"purity", "[", 
    RowBox[{"densityMatrix", "[", "plus", "]"}], "]"}], ",", " ", 
   RowBox[{"purity", "[", 
    RowBox[{"id2", "/", "2"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->642744358,ExpressionUUID->"106b7ad8-6378-599b-4069-7382160d2be1"],

Cell["\<\
The pure state gives one, the maximally mixed state one half.\
\>", "Text",
 CellID->1478372881,ExpressionUUID->"7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],

Cell[TextData[{
 "Last, the ",
 StyleBox["expectation value",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"A", "\[Rho]"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "304452a4-201b-d64c-607c-4b0e51afbc96"],
 " of any operator. It is real when ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],
 " is Hermitian, as a physical meter observable must be, but it can be \
complex for a general operator:"
}], "Text",
 CellID->124263719,ExpressionUUID->"4b5b9263-9199-4e16-7978-144d202c157c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"expectation", "[", 
    RowBox[{"op_", ",", " ", "rho_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Tr", "[", 
    RowBox[{"op", " ", ".", " ", "rho"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->1310926461,ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"],

Cell["The two terms of the master equation", "Subsection",
 CellID->1124211690,ExpressionUUID->"2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],

Cell[TextData[{
 "A state changes for two reasons. The first is unitary evolution under the \
Hamiltonian ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3343f580-98d5-e31c-6170-ecea1961ce66"],
 ": the commutator term ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a7420b-376a-b23f-505d-6455421c0105"],
 ". Define it:"
}], "Text",
 CellID->1335749844,ExpressionUUID->"6af863a9-1098-c609-1a98-7af3a112ad53"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"commutatorTerm", "[", 
    RowBox[{"H_", ",", " ", "rho_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"-", "I"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"H", " ", ".", " ", "rho"}], " ", "-", " ", 
      RowBox[{"rho", " ", ".", " ", "H"}]}], ")"}]}]}], ";"}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->793802945,ExpressionUUID->"055bc2ad-6b92-a3be-3378-dbf70e24f184"],

Cell[TextData[{
 "The second is a leak to the environment, one Lindblad (jump) operator ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["c", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0fb60e-2211-365f-5934-286857a59ca5"],
 " per channel (for a decaying atom, ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], "-"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "201a2509-bdd9-2fa1-5039-bd53346c758b"],
 "). Its ",
 StyleBox["dissipator",
  FontWeight->"Bold"],
 " transfers population along the channel and damps coherences, ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"], "=", 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], 
   StyleBox["\[Rho]", "TI"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "\[Dagger]"], "-", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["\[Rho]", "TI"], "+", 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 ":"
}], "Text",
 CellID->631769182,ExpressionUUID->"5f932952-49a5-d34f-05a0-c11c6851a195"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dissipator", "[", 
    RowBox[{"c_", ",", " ", "rho_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"c", " ", ".", " ", "rho", " ", ".", " ", 
     RowBox[{"ConjugateTranspose", "[", "c", "]"}]}], " ", "-", "\n", "   ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "c", "]"}], " ", ".", " ", "c", 
        " ", ".", " ", "rho"}], " ", "+", " ", 
       RowBox[{"rho", " ", ".", " ", 
        RowBox[{"ConjugateTranspose", "[", "c", "]"}], " ", ".", " ", "c"}]}],
       ")"}], "/", "2"}]}]}], ";"}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->1873681340,ExpressionUUID->"160f17c4-d31a-fe19-3e34-8ea1e6acc563"],

Cell[TextData[{
 "A dissipator is trace-preserving, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10beb8bd-bdb6-ee93-4045-31e73440b4f9"],
 ", so the total probability stays one. Confirm it for a general ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["c", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fdc991b-fead-14b0-65e3-1144fb587e9a"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],
 ":"
}], "Text",
 CellID->1468251080,ExpressionUUID->"0642d375-09f3-9942-2e71-cb3faf87eba8"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Tr", "[", 
   RowBox[{"dissipator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c11", ",", " ", "c12"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c21", ",", " ", "c22"}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r11", ",", " ", "r12"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r21", ",", " ", "r22"}], "}"}]}], "}"}]}], "]"}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->1989234463,ExpressionUUID->"0651775d-2bad-791b-2e6f-6f074e584861"],

Cell["Zero with no assumptions.", "Text",
 CellID->1607696641,ExpressionUUID->"63b9e3d6-2298-231e-1146-fa9057128e64"],

Cell[TextData[{
 "Together the two terms give the ",
 StyleBox["Lindblad master equation",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", "\[ScriptCapitalL]", 
   StyleBox["\[Rho]", "TI"], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   UnderscriptBox["\[Sum]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["k", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67c13665-f813-2f11-0dfe-a84ef9a6727b"],
 ", the evolution of an open system averaged over all measurement outcomes:"
}], "Text",
 CellID->1817342824,ExpressionUUID->"4c440104-ea8a-4285-747b-99618f3f10ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"lindbladian", "[", 
    RowBox[{"H_", ",", " ", "leaks_List", ",", " ", "rho_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{
    RowBox[{"commutatorTerm", "[", 
     RowBox[{"H", ",", " ", "rho"}], "]"}], " ", "+", " ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"dissipator", "[", 
        RowBox[{"#", ",", " ", "rho"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "leaks"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->530774412,ExpressionUUID->"66c9a615-af45-c085-0ef6-385ecaf192ef"],

Cell[TextData[{
 "This is a system leaking to an environment whose record we set aside, \
whether no detector is present at all or a detector is present and we average \
over what it reports: smooth and deterministic, because averaging over every \
outcome removes the randomness. The first several examples are this equation \
with different ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0513e607-0f4c-1e20-3320-f861aaf9650a"],
 " and leaks."
}], "Text",
 CellID->599957810,ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"],

Cell["The master equation, solved two independent ways", "Subsection",
 CellID->1899946997,ExpressionUUID->"6833ae6a-6ac5-a2c8-19c0-40340f71f012"],

Cell[TextData[{
 "We solve the master equation two independent ways and check they agree. The \
first vectorizes ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7f2999-1aee-25a5-0504-c0c39e988f8f"],
 " (stack its rows) and applies the ",
 StyleBox["Liouvillian",
  FontWeight->"Bold"],
 ", the matrix whose action is ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "128c7526-c883-085d-42b4-6c83e9365aa7"],
 ". In this row-stacking convention (matching WL's ",
 Cell[BoxData["Flatten"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3279c00f-c9e2-8758-6206-da68ef94eda2"],
 "; an overbar denotes entrywise conjugation) it is the Kronecker form"
}], "Text",
 CellID->1051619128,ExpressionUUID->"50b12ff8-e606-85f7-004e-c6a593b0efdd"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"\[ScriptCapitalL]", "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], "\[CircleTimes]", "\|01d7d9", "-", 
     "\|01d7d9", "\[CircleTimes]", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["H", "TI"], "^"], 
      StyleBox["T", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["k", "TI"],
     LimitsPositioning->False], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["c", "TI"], "^"], 
      StyleBox["k", "TI"]], "\[CircleTimes]", 
     OverscriptBox[
      SubscriptBox[
       OverscriptBox[
        StyleBox["c", "TI"], "^"], 
       StyleBox["k", "TI"]], "_"], "-", 
     FractionBox["1", "2"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubsuperscriptBox[
       OverscriptBox[
        StyleBox["c", "TI"], "^"], 
       StyleBox["k", "TI"], "\[Dagger]"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["c", "TI"], "^"], 
       StyleBox["k", "TI"]], "\[CircleTimes]", "\|01d7d9", "+", "\|01d7d9", "\[CircleTimes]", 
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["c", "TI"], "^"], 
          StyleBox["k", "TI"], "\[Dagger]"], 
         SubscriptBox[
          OverscriptBox[
           StyleBox["c", "TI"], "^"], 
          StyleBox["k", "TI"]]}], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       StyleBox["T", "TI"]]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["]",
     SpanMaxSize->1]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1921351195,ExpressionUUID->"640f47a5-4648-c62d-0c35-5e0f73e2ad77"],

Cell[TextData[{
 "which the code assembles directly, ",
 Cell[BoxData["\|01d7d9"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63a48922-0fac-666c-115b-208caa594cb6"],
 " the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "\[Times]", 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "387a9e0d-0234-0e73-6819-1057b7c15559"],
 " identity (equivalently, the matrix whose columns are ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f64ca0d-9927-5f44-651b-ec5718d225ae"],
 " applied to each basis matrix):"
}], "Text",
 CellID->1207491739,ExpressionUUID->"399d1ff3-4632-be92-6fa2-96bd73c404f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"liouvillian", "[", 
    RowBox[{"H_", ",", " ", "leaks_List", ",", " ", "d_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"id", " ", "=", " ", 
       RowBox[{"IdentityMatrix", "[", "d", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"H", ",", " ", "id"}], "]"}], " ", "-", " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"id", ",", " ", 
           RowBox[{"Transpose", "[", "H", "]"}]}], "]"}]}], ")"}]}], " ", "+",
       "\n", "    ", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"Conjugate", "[", "c", "]"}]}], "]"}], " ", "-", "\n", 
           "        ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ConjugateTranspose", "[", "c", "]"}], " ", ".", " ",
                  "c"}], ",", " ", "id"}], "]"}], " ", "+", "\n", 
              "           ", 
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{"id", ",", " ", 
                RowBox[{"Transpose", "[", 
                 RowBox[{
                  RowBox[{"ConjugateTranspose", "[", "c", "]"}], " ", ".", 
                  " ", "c"}], "]"}]}], "]"}]}], ")"}], "/", "2"}]}]}], "]"}], 
        " ", "/@", " ", "leaks"}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->216741342,ExpressionUUID->"1170384d-2f38-2c50-470f-b2174acd76ba"],

Cell[TextData[{
 "The state at time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ce33075-6d34-44a7-1490-aa3f04c12e8d"],
 " is then a matrix exponential of the Liouvillian applied to the vectorized \
initial state, reshaped back to a matrix, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["vec",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"\[ScriptCapitalL]", 
     StyleBox["t", "TI"]}]], "\[ThinSpace]", 
   StyleBox["vec",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],
 ":"
}], "Text",
 CellID->2096934290,ExpressionUUID->"6334ac9c-43f1-85c0-12cb-45c67585ef2a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"evolve", "[", 
    RowBox[{"H_", ",", " ", "leaks_List", ",", " ", "rho0_", ",", " ", "t_"}],
     "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"Length", "[", "rho0", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"liouvillian", "[", 
           RowBox[{"H", ",", " ", "leaks", ",", " ", "d"}], "]"}], " ", "t"}],
          "]"}], " ", ".", " ", 
        RowBox[{"Flatten", "[", "rho0", "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[17]:= ",
 CellID->1367217003,ExpressionUUID->"74397683-04f4-1d4d-1dc7-6fedac816797"],

Cell[TextData[{
 "The Liouvillian also gives a ",
 StyleBox["steady state",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["ss",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "735e49d5-32a1-4a48-2166-609f47541892"],
 ", satisfying ",
 Cell[BoxData[
  RowBox[{"\[ScriptCapitalL]", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "335d55a2-cf9b-493d-6163-4c0fea2e1807"],
 ". A degenerate null space needs care: its arbitrary complex basis vectors \
are not themselves density matrices. ",
 Cell[BoxData["stationary"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bfbbd45-edb8-1b0b-6998-352e844d6651"],
 " converts the complex null space into a complete real basis of Hermitian \
stationary operators, orthonormal in the Frobenius sense. When that basis is \
one-dimensional (the usual case, a single steady direction) it rescales the \
sole operator to a unit-trace Hermitian density matrix, so ",
 Cell[BoxData[
  RowBox[{"First", "@", 
   RowBox[{"stationary", "[", "...", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "045023ab-c37d-b770-2c6f-baf4f6091a5a"],
 " is the physical steady state. When the null space is degenerate, or the \
lone direction is traceless (a steady coherence, not a state), it returns the \
operator basis unchanged; the physical steady states are then the unit-trace, \
positive combinations of that basis, not the basis vectors separately."
}], "Text",
 CellID->1372538143,ExpressionUUID->"73e8aeff-5b91-f8f4-2197-47b95e25cade"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"stationary", "[", 
    RowBox[{"H_", ",", " ", "leaks_List", ",", " ", 
     RowBox[{"tol_", ":", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"Length", "[", "H", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"candidates", " ", "=", "\n", "       ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"raw", " ", "=", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"ArrayReshape", "[", 
                RowBox[{"#", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}], " ", "&"}], 
              " ", "/@", " ", 
              RowBox[{"NullSpace", "[", 
               RowBox[{"liouvillian", "[", 
                RowBox[{"H", ",", " ", "leaks", ",", " ", "d"}], "]"}], 
               "]"}]}]}], "}"}], ",", "\n", "        ", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"#", " ", "+", " ", 
                  RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], ")"}], "/",
                 "2"}], " ", "&"}], " ", "/@", " ", "raw"}], ",", "\n", 
             "         ", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"#", " ", "-", " ", 
                  RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{"2", " ", "I"}], ")"}]}], " ", "&"}], " ", "/@", " ",
               "raw"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"basis", " ", "=", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"ArrayReshape", "[", 
              RowBox[{"#", ",", " ", 
               RowBox[{"{", 
                RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}], " ", "&"}], " ",
             "/@", "\n", "        ", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"Orthogonalize", "[", 
               RowBox[{"Flatten", " ", "/@", " ", "candidates"}], "]"}], ",", 
              " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Norm", "[", 
                 RowBox[{"N", "@", "#"}], "]"}], " ", ">", " ", "tol"}], " ", 
               "&"}]}], "]"}]}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "basis", "]"}], " ", "=!=", " ", "1"}], ",",
            " ", "basis", ",", "\n", "      ", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"weight", " ", "=", " ", 
               RowBox[{"Tr", "[", 
                RowBox[{"First", "@", "basis"}], "]"}]}], "}"}], ",", "\n", 
             "       ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"N", "@", "weight"}], "]"}], " ", "<=", " ", "tol"}],
                ",", " ", "basis", ",", "\n", "        ", 
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"rho", " ", "=", " ", 
                   RowBox[{
                    RowBox[{"First", "@", "basis"}], "/", "weight"}]}], "}"}],
                  ",", " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"rho", " ", "+", " ", 
                    RowBox[{"ConjugateTranspose", "[", "rho", "]"}]}], ")"}], 
                   "/", "2"}], "}"}]}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[18]:= ",
 CellID->485911656,ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"],

Cell["\<\
The second way integrates the master equation directly with an ODE solver, \
sharing no code with the Liouvillian route:\
\>", "Text",
 CellID->181917407,ExpressionUUID->"794a4309-908b-2549-2f4a-5b53213f8f93"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"evolveODE", "[", 
    RowBox[{
    "H_", ",", " ", "leaks_List", ",", " ", "rho0_", ",", " ", "t1_"}], "]"}],
    " ", ":=", "\n", "  ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"s", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{"lindbladian", "[", 
         RowBox[{"H", ",", " ", "leaks", ",", " ", 
          RowBox[{"s", "[", "t", "]"}]}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"s", "[", "0", "]"}], " ", "==", " ", 
        RowBox[{"N", "@", "rho0"}]}]}], "}"}], ",", " ", "s", ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "t1"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[19]:= ",
 CellID->1906087345,ExpressionUUID->"167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],

Cell[TextData[{
 "Now the cross-check. Fix a test system: a qubit driven by ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15eb24b6-b946-3a65-43e8-bdf038f0894f"],
 ", dephased through ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27d2a24c-1e84-19ee-4de1-44169b316b34"],
 ", starting in the ground state:"
}], "Text",
 CellID->354048744,ExpressionUUID->"285985c7-a1c8-13eb-5866-1ca0d07d6131"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Hx", " ", "=", " ", 
   RowBox[{"1.0", " ", "X"}]}], ";", " ", 
  RowBox[{"oneLeak", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sqrt", "[", "0.4", "]"}], " ", "Z"}], "}"}]}], ";", " ", 
  RowBox[{"start", " ", "=", " ", 
   RowBox[{"densityMatrix", "[", "ground", "]"}]}], ";"}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->786710823,ExpressionUUID->"57868ed1-450c-c474-7dbd-279b6cbeaf5e"],

Cell["Integrate its master equation once with the ODE route:", "Text",
 CellID->1859374462,ExpressionUUID->"0c5e608e-35dc-f74f-3466-79e8bc6edd95"],

Cell[BoxData[
 RowBox[{
  RowBox[{"solved", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{"Hx", ",", " ", "oneLeak", ",", " ", "start", ",", " ", "10.0"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->544914423,ExpressionUUID->"1a1e4090-3303-05ed-4a26-59da46b66f37"],

Cell["\<\
Measure the largest disagreement between the two solvers over the whole span:\
\
\>", "Text",
 CellID->1088734259,ExpressionUUID->"10256af3-3972-af7a-41da-83bdb804f240"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"evolve", "[", 
        RowBox[{
        "Hx", ",", " ", "oneLeak", ",", " ", "start", ",", " ", "tt"}], "]"}],
        " ", "-", " ", 
       RowBox[{"solved", "[", "tt", "]"}]}], ",", " ", "\"\<Frobenius\>\""}], 
     "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"tt", ",", " ", "0", ",", " ", "10", ",", " ", "0.5"}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->476175344,ExpressionUUID->"457602f1-d86e-ac86-730d-9bbad918f6ec"],

Cell["\<\
The largest disagreement is at the ODE solver's tolerance: the matrix \
exponential and the ODE march give the same state. Either is a trustworthy \
reference.\
\>", "Text",
 CellID->201272189,ExpressionUUID->"499f95c1-a958-6c18-7fa4-0caac8ed3762"],

Cell["The positivity-preserving measurement step", "Subsection",
 CellID->320292756,ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

Cell[TextData[{
 "Now put a detector on a leak and condition the state on its output. The \
naive update, nudging ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c02104f-9807-e6c4-3431-8a2919b3cc2e"],
 " by the record, can push ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f909018-5ea1-6a32-15af-0a425b543918"],
 " off the set of valid states and give a negative eigenvalue, a negative \
probability. See it break: take ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f4595f3-090a-1216-557a-0cbda8bf617c"],
 ", measure ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06385f5e-e9d4-4e6c-2fd8-571b886114b6"],
 " with no Hamiltonian, and feed one large noise kick into the naive update:"
}], "Text",
 CellID->1146801282,ExpressionUUID->"25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"naiveStep", " ", "=", " ", 
   RowBox[{
    RowBox[{"densityMatrix", "[", "plus", "]"}], " ", "+", " ", 
    RowBox[{
     RowBox[{"dissipator", "[", 
      RowBox[{"Z", ",", " ", 
       RowBox[{"densityMatrix", "[", "plus", "]"}]}], "]"}], " ", "0.1"}], 
    " ", "+", "\n", "   ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Z", " ", ".", " ", 
        RowBox[{"densityMatrix", "[", "plus", "]"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"densityMatrix", "[", "plus", "]"}], " ", ".", " ", "Z"}], 
       " ", "-", "\n", "      ", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", " ", "Z"}], ")"}], " ", ".", " ", 
          RowBox[{"densityMatrix", "[", "plus", "]"}]}], "]"}], " ", 
        RowBox[{"densityMatrix", "[", "plus", "]"}]}]}], ")"}], " ", 
     "0.5"}]}]}], ";"}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->41202278,ExpressionUUID->"3b9a140e-d97a-4136-69b9-8e6bd80f101c"],

Cell["Read the smallest eigenvalue of the updated state:", "Text",
 CellID->1124146653,ExpressionUUID->"4f9438da-b80f-a114-75ab-b18439bbf07e"],

Cell[BoxData[
 RowBox[{"Min", "@", 
  RowBox[{"Eigenvalues", "[", "naiveStep", "]"}]}]], "Input",
 CellLabel->"In[24]:= ",
 CellID->1232284935,ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell[TextData[{
 "A negative eigenvalue: the naive update has left the set of valid states. \
Shrinking ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8746fc-db76-c487-64bd-5fb9de00aeed"],
 " makes it rarer but never impossible."
}], "Text",
 CellID->2082395230,ExpressionUUID->"11f0f87a-e6f0-91cd-478f-f227928ae317"],

Cell[TextData[{
 "The fix is the structure-preserving filter of ",
 ButtonBox["Rouchon and Ralph (2015)",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/1410.5345"], None}],
 ": write the update as a sum of Kraus terms ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], 
   StyleBox["\[Rho]", "TI"], 
   SuperscriptBox[
    StyleBox["A", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "473164ce-b547-c1f4-6ecf-7da83cf393de"],
 ", an operator times ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c4fc3b-e00c-2bba-42fb-f66491b97980"],
 " times its conjugate transpose, so the unnormalized result is manifestly \
positive whenever the supplied efficiencies satisfy ",
 Cell[BoxData[
  RowBox[{"0", "\[LessEqual]", 
   SubscriptBox[
    StyleBox["\[Eta]", "TI"], 
    StyleBox["k", "TI"]], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7e6892-18cd-6f45-4b05-81dc997835af"],
 ". With monitored operators ",
 Cell[BoxData[
  RowBox[{"{", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["k", "TI"]], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "325c8f47-cd85-89da-6263-2720e431db20"],
 " at detection efficiencies ",
 Cell[BoxData[
  RowBox[{"{", 
   SubscriptBox[
    StyleBox["\[Eta]", "TI"], 
    StyleBox["k", "TI"]], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43fcea2e-12ab-c026-7183-0388a75f930c"],
 ", unmonitored leaks ",
 Cell[BoxData[
  RowBox[{"{", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["l", "TI"], "^"], 
    StyleBox["j", "TI"]], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b416c07-c3d3-bf4f-097e-8660f6670595"],
 ", record increments ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5add4728-e92e-eff1-0ae3-5f7588d8b5db"],
 ", the no-jump generator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["K", "TI"], "=", 
   StyleBox["i", "TI"], 
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "+", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["k", "TI"],
     LimitsPositioning->False], 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     StyleBox["k", "TI"], "\[Dagger]"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     StyleBox["k", "TI"]], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->False], 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["l", "TI"], "^"], 
     StyleBox["j", "TI"], "\[Dagger]"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["l", "TI"], "^"], 
     StyleBox["j", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "621761a3-d300-b412-122d-780ce6ba1f78"],
 ", and the measurement kick ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", 
   UnderscriptBox["\[Sum]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   SqrtBox[
    SubscriptBox[
     StyleBox["\[Eta]", "TI"], 
     StyleBox["k", "TI"]]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],
 ", the corrected Kraus operator is"
}], "Text",
 CellID->2045146513,ExpressionUUID->"7d3ffb2e-09a8-fc78-24c4-f288a842c742"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["M", "TI"], "=", "\|01d7d9", "-", 
    StyleBox["K", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["s", "TI"], "+", 
    FractionBox["1", "2"], 
    SuperscriptBox[
     StyleBox["s", "TI"], "2"], "-", 
    FractionBox[
     StyleBox[
      RowBox[{"d", "t"}], "TI"], "2"], 
    UnderscriptBox["\[Sum]", 
     StyleBox["k", "TI"],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["\[Eta]", "TI"], 
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     StyleBox["k", "TI"], "2"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->25123057,ExpressionUUID->"4139b36b-52b1-2977-70c6-2b356744785d"],

Cell["and the stepped state is the renormalized sum", "Text",
 CellID->371825621,ExpressionUUID->"494d6e39-7750-b6eb-7f72-806302ea1c31"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "~"], "=", 
    StyleBox["M", "TI"], 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     StyleBox["M", "TI"], "\[Dagger]"], "+", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->False], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["l", "TI"], "^"], 
     StyleBox["j", "TI"]], "\[ThinSpace]", 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["l", "TI"], "^"], 
     StyleBox["j", "TI"], "\[Dagger]"], "+", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], 
    UnderscriptBox["\[Sum]", 
     StyleBox["k", "TI"],
     LimitsPositioning->False], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     SubscriptBox[
      StyleBox["\[Eta]", "TI"], 
      StyleBox["k", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     StyleBox["k", "TI"], "\[Dagger]"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Rho]", "TI"], "\[Prime]"], "=", 
    RowBox[{
     FractionBox[
      OverscriptBox[
       StyleBox["\[Rho]", "TI"], "~"], 
      RowBox[{
       StyleBox["Tr",
        FontSlant->"Plain"], "\[ThinSpace]", 
       OverscriptBox[
        StyleBox["\[Rho]", "TI"], "~"]}]], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1439628390,ExpressionUUID->"39b01e29-d171-5c92-6f4f-9072e00426f8"],

Cell[TextData[{
 "The three terms of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["\[Rho]", "TI"], "~"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f6d713e-2461-11c8-7513-69784d146312"],
 " are the measured record, the unmonitored leaks, and the unrecorded \
fraction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SubscriptBox[
     StyleBox["\[Eta]", "TI"], 
     StyleBox["k", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14ad582f-66ff-93eb-3c53-5189128be131"],
 " of each watched channel. Each has Kraus form, so a positive input gives a \
positive numerator; the normalized update is defined when that numerator has \
positive trace. This structural positivity is distinct from \
time-discretization accuracy: at finite ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f7ea056-2d28-85ec-7505-3a1044c2ef36"],
 " the update is an approximation to the continuous stochastic master \
equation, and its ensemble average has a systematic step-size bias in \
addition to Monte-Carlo scatter. Only one precondition matters physically: \
every detection efficiency must lie in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"0", ",", "1"}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b00368-b832-202d-3e4f-9b3239c77377"],
 ", since the upper bound ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Eta]", "TI"], 
    StyleBox["k", "TI"]], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06d00634-a672-f252-2eef-9871d304c0b8"],
 " is exactly what keeps the Kraus-form update positive. The code asserts \
that and a positive time step once, up front; the returned stepper then \
preserves Hermiticity, positivity, and trace by construction, so it trusts \
its input and guards only the final normalization against a non-positive \
trace:"
}], "Text",
 CellID->497245720,ExpressionUUID->"05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"measurementStep", "[", 
    RowBox[{
    "H_", ",", " ", "watched_", ",", " ", "effs_", ",", " ", "unwatched_", ",",
      " ", "dt_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Enclose", "[", "\n", "  ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"d", " ", "=", " ", 
         RowBox[{"Length", "[", "H", "]"}]}], ",", " ", 
        RowBox[{"id", " ", "=", " ", 
         RowBox[{"IdentityMatrix", "[", 
          RowBox[{"Length", "[", "H", "]"}], "]"}]}], ",", " ", 
        RowBox[{"channels", " ", "=", " ", 
         RowBox[{"Join", "[", 
          RowBox[{"watched", ",", " ", "unwatched"}], "]"}]}], ",", " ", 
        "drift", ",", " ", "corr"}], "}"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{"ConfirmAssert", "[", 
        RowBox[{
         RowBox[{"VectorQ", "[", 
          RowBox[{"effs", ",", " ", 
           RowBox[{
            RowBox[{"0", " ", "<=", " ", "#", " ", "<=", " ", "1"}], " ", 
            "&"}]}], "]"}], ",", 
         " ", "\"\<efficiencies must lie in [0,1]\>\""}], "]"}], ";", "\n", 
       "   ", 
       RowBox[{"ConfirmAssert", "[", 
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{"dt", " ", ">", " ", "0"}], "]"}], ",", 
         " ", "\"\<time step must be positive\>\""}], "]"}], ";", "\n", "   ", 
       RowBox[{"drift", " ", "=", " ", 
        RowBox[{
         RowBox[{"I", " ", "H"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"Fold", "[", 
           RowBox[{"Plus", ",", " ", 
            RowBox[{"0", " ", "H"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "#", "]"}], " ", ".", " ", 
               "#"}], " ", "&"}], " ", "/@", " ", "channels"}]}], "]"}], "/", 
          "2"}]}]}], ";", "\n", "   ", 
       RowBox[{"corr", " ", "=", " ", 
        RowBox[{
         RowBox[{"Fold", "[", 
          RowBox[{"Plus", ",", " ", 
           RowBox[{"0", " ", "H"}], ",", " ", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"#1", " ", 
               RowBox[{"(", 
                RowBox[{"#2", " ", ".", " ", "#2"}], ")"}]}], " ", "&"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"effs", ",", " ", "watched"}], "}"}]}], "]"}]}], "]"}], 
         "/", "2"}]}], ";", "\n", "   ", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rho", ",", " ", "dJ"}], "}"}], ",", " ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"sig", ",", " ", "M", ",", " ", "top", ",", " ", "nrm"}], 
            "}"}], ",", "\n", "     ", 
           RowBox[{
            RowBox[{"sig", " ", "=", " ", 
             RowBox[{"Fold", "[", 
              RowBox[{"Plus", ",", " ", 
               RowBox[{"0", " ", "H"}], ",", " ", 
               RowBox[{"MapThread", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Sqrt", "[", "#2", "]"}], " ", "#1", " ", "#3"}], 
                  " ", "&"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"dJ", ",", " ", "effs", ",", " ", "watched"}], 
                  "}"}]}], "]"}]}], "]"}]}], ";", "\n", "     ", 
            RowBox[{"M", " ", "=", " ", 
             RowBox[{"id", " ", "-", " ", 
              RowBox[{"drift", " ", "dt"}], " ", "+", " ", "sig", " ", "+", 
              " ", 
              RowBox[{
               RowBox[{"sig", " ", ".", " ", "sig"}], "/", "2"}], " ", "-", 
              " ", 
              RowBox[{"corr", " ", "dt"}]}]}], ";", "\n", "     ", 
            RowBox[{"top", " ", "=", " ", 
             RowBox[{
              RowBox[{"M", " ", ".", " ", "rho", " ", ".", " ", 
               RowBox[{"ConjugateTranspose", "[", "M", "]"}]}], " ", "+", 
              "\n", "       ", 
              RowBox[{"dt", " ", 
               RowBox[{"Fold", "[", 
                RowBox[{"Plus", ",", " ", 
                 RowBox[{"0", " ", "H"}], ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"#", " ", ".", " ", "rho", " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], " ", 
                   "&"}], " ", "/@", " ", "unwatched"}]}], "]"}]}], " ", "+", 
              "\n", "       ", 
              RowBox[{"dt", " ", 
               RowBox[{"Fold", "[", 
                RowBox[{"Plus", ",", " ", 
                 RowBox[{"0", " ", "H"}], ",", " ", 
                 RowBox[{"MapThread", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", " ", "-", " ", "#2"}], ")"}], " ", 
                    RowBox[{"#1", " ", ".", " ", "rho", " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "#1", "]"}]}]}], " ", 
                    "&"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"watched", ",", " ", "effs"}], "}"}]}], "]"}]}], 
                "]"}]}]}]}], ";", "\n", "     ", 
            RowBox[{"nrm", " ", "=", " ", 
             RowBox[{"Re", "@", 
              RowBox[{"Tr", "[", "top", "]"}]}]}], ";", "\n", "     ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"TrueQ", "[", 
               RowBox[{"nrm", " ", ">", " ", "0"}], "]"}], ",", " ", 
              RowBox[{"top", "/", "nrm"}], ",", "\n", "       ", 
              RowBox[{"Failure", "[", 
               RowBox[{"\"\<NonPositiveNormalization\>\"", ",", " ", 
                RowBox[{"<|", 
                 RowBox[{"\"\<Normalization\>\"", " ", "->", " ", "nrm"}], 
                 "|>"}]}], "]"}]}], "]"}]}]}], "]"}]}], "]"}]}]}], "]"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[25]:= ",
 CellID->1090726268,ExpressionUUID->"583a98af-415b-100e-09d9-110970ee6354"],

Cell[TextData[{
 "Here ",
 Cell[BoxData["watched"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07beae85-a317-6bf9-2d45-47eed6a239c3"],
 " are the monitored channels, ",
 Cell[BoxData["effs"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],
 " their detection efficiencies (1 for perfect, less if the detector misses \
some output), and ",
 Cell[BoxData["unwatched"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60049622-f570-0e0e-103b-0f8ffc055554"],
 " the undetected leaks. Revisit the kick that broke the naive step, now \
through the positivity-preserving step:"
}], "Text",
 CellID->2124519200,ExpressionUUID->"40ea559d-da93-7842-70ea-4cc6df264aa8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fixedStep", " ", "=", " ", 
   RowBox[{
    RowBox[{"measurementStep", "[", 
     RowBox[{
      RowBox[{"0", " ", "id2"}], ",", " ", 
      RowBox[{"{", "Z", "}"}], ",", " ", 
      RowBox[{"{", "1.", "}"}], ",", " ", 
      RowBox[{"{", "}"}], ",", " ", "0.1"}], "]"}], "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "plus", "]"}], ",", " ", 
     RowBox[{"{", "0.5", "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[26]:= ",
 CellID->617350884,ExpressionUUID->"23ccc6ee-92c0-e596-51f3-dfc8277acffc"],

Cell["\<\
Read the smallest eigenvalue and the trace of the stepped state:\
\>", "Text",
 CellID->1357963930,ExpressionUUID->"114d8d02-b276-9c05-4772-256fc700e76f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Min", "@", 
    RowBox[{"Re", "@", 
     RowBox[{"Eigenvalues", "[", "fixedStep", "]"}]}]}], ",", " ", 
   RowBox[{"Re", "@", 
    RowBox[{"Tr", "[", "fixedStep", "]"}]}]}], "}"}]], "Input",
 CellLabel->"In[27]:= ",
 CellID->1626918454,ExpressionUUID->"2dc22b63-32d1-862f-5bf1-c34d4765ed75"],

Cell["\<\
The smallest eigenvalue is now zero to numerical precision and the trace is \
one: the step lands on the boundary of the state space instead of leaving it. \
Positivity of the normalized Kraus-form update no longer depends on taking an \
infinitesimal step, although agreement with the continuous-time filter still \
does.\
\>", "Text",
 CellID->675379980,ExpressionUUID->"36ea7e2c-072a-2221-5eea-7076b2df710b"],

Cell["The measurement record, and one trajectory", "Subsection",
 CellID->1331866192,ExpressionUUID->"5b23761c-2477-64e8-0ad1-68464d024e32"],

Cell[TextData[{
 "The homodyne record at each step is the signal ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73216bcf-7cf1-61ac-22de-82a9748433f6"],
 " plus fresh Gaussian noise. Write it:"
}], "Text",
 CellID->1391655620,ExpressionUUID->"69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"measurementRecord", "[", 
    RowBox[{
    "rho_", ",", " ", "watched_List", ",", " ", "effs_List", ",", " ", "dt_", 
     ",", " ", "kick_List"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", "#3", "]"}], " ", 
        RowBox[{"Re", "@", 
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#1", " ", "+", " ", 
             RowBox[{"ConjugateTranspose", "[", "#1", "]"}]}], ")"}], " ", ".",
            " ", "rho"}], "]"}]}], " ", "dt"}], " ", "+", " ", "#2"}], " ", 
      "&"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"watched", ",", " ", "kick", ",", " ", "effs"}], "}"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[28]:= ",
 CellID->861714746,ExpressionUUID->"409bca18-cbd6-e54d-70b8-ec45ee60cf97"],

Cell[TextData[{
 Cell[BoxData["kick"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b62b5f-1d3f-f012-404d-c31994cbc378"],
 " is the Wiener increment ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79984792-c453-565a-2fb8-5edfede63ca0"],
 ", drawn fresh each step. One ",
 StyleBox["quantum trajectory",
  FontWeight->"Bold"],
 " is: draw ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d45428e-8fa1-6801-4b7b-5be82a543b6b"],
 ", form the record, advance with the positivity step. This is the only place \
randomness enters. It returns the times, the states, and the record:"
}], "Text",
 CellID->1192942815,ExpressionUUID->"604bb87d-3174-a116-1048-32274006f07c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"trajectory", "[", 
    RowBox[{
    "rho0_", ",", " ", "H_", ",", " ", "watched_List", ",", " ", "effs_List", 
     ",", " ", "unwatched_List", ",", " ", "dt_", ",", " ", "tf_", ",", " ", 
     "seed_"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", " ", "=", " ", 
          RowBox[{"Round", "[", 
           RowBox[{"tf", "/", "dt"}], "]"}]}], ",", " ", "step", ",", " ", 
         "kicks", ",", " ", "states", ",", " ", "record"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"step", " ", "=", " ", 
         RowBox[{"measurementStep", "[", 
          RowBox[{
          "H", ",", " ", "watched", ",", " ", "effs", ",", " ", "unwatched", ",",
            " ", "dt"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"kicks", " ", "=", " ", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"Sqrt", "[", "dt", "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", 
             RowBox[{"Length", "[", "watched", "]"}]}], "}"}]}], "]"}]}], ";",
         "\n", "    ", 
        RowBox[{"states", " ", "=", " ", 
         RowBox[{"FoldList", "[", "\n", "      ", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"r", ",", " ", "dw"}], "}"}], ",", " ", 
             RowBox[{"step", "[", 
              RowBox[{"r", ",", " ", 
               RowBox[{"measurementRecord", "[", 
                RowBox[{
                "r", ",", " ", "watched", ",", " ", "effs", ",", " ", "dt", ",",
                  " ", "dw"}], "]"}]}], "]"}]}], "]"}], ",", " ", "rho0", ",",
            " ", "kicks"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"record", " ", "=", " ", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"measurementRecord", "[", 
             RowBox[{
             "#1", ",", " ", "watched", ",", " ", "effs", ",", " ", "dt", ",",
               " ", "#2"}], "]"}], " ", "&"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Most", "[", "states", "]"}], ",", " ", "kicks"}], 
            "}"}]}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<times\>\"", " ", "->", " ", 
           RowBox[{"dt", " ", 
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", "n"}], "]"}]}]}], ",", " ", 
          RowBox[{"\"\<states\>\"", " ", "->", " ", "states"}], ",", " ", 
          RowBox[{"\"\<record\>\"", " ", "->", " ", "record"}]}], "|>"}]}]}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[29]:= ",
 CellID->556077107,ExpressionUUID->"763191a2-6f8b-197a-1fce-080c0a3e6840"],

Cell["\<\
The check that ties the catalog together: trajectories average to the master \
equation\
\>", "Subsection",
 CellID->15883883,ExpressionUUID->"635fdfdb-2856-deda-1164-d68549e0a420"],

Cell["\<\
The central fact, used as a check almost everywhere: averaging many \
trajectories recovers the master-equation solution. Averaging over the record \
is what tracing out the detector means. Fix the step and the horizon:\
\>", "Text",
 CellID->308842859,ExpressionUUID->"0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dt", " ", "=", " ", "0.005"}], ";", " ", 
  RowBox[{"tf", " ", "=", " ", "8.0"}], ";"}]], "Input",
 CellLabel->"In[30]:= ",
 CellID->1108042358,ExpressionUUID->"5c8469dd-bfc7-2a7a-04bb-80873a727940"],

Cell["Run 200 trajectories of the test qubit:", "Text",
 CellID->1009200201,ExpressionUUID->"182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"crowd", " ", "=", " ", 
   RowBox[{"Table", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"trajectory", "[", 
       RowBox[{"start", ",", " ", "Hx", ",", " ", "oneLeak", ",", " ", 
        RowBox[{"{", "1.", "}"}], ",", " ", 
        RowBox[{"{", "}"}], ",", " ", "dt", ",", " ", "tf", ",", " ", "k"}], 
       "]"}], "[", "\"\<states\>\"", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "1", ",", " ", "200"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[31]:= ",
 CellID->752465254,ExpressionUUID->"3921e4bb-f5e4-3596-68de-fde483969ffc"],

Cell["Integrate the master equation as the reference:", "Text",
 CellID->891183881,ExpressionUUID->"13db9173-5387-1c16-41f8-093d6632677c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"smoothRef", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{"Hx", ",", " ", "oneLeak", ",", " ", "start", ",", " ", "tf"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[32]:= ",
 CellID->741634648,ExpressionUUID->"6804c0ab-fd16-b7db-183b-d9f4f4a01d21"],

Cell["\<\
Measure the largest gap between the ensemble mean and that reference:\
\>", "Text",
 CellID->359589406,ExpressionUUID->"77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"MapThread", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{"#1", " ", "-", " ", "#2"}], ",", " ", "\"\<Frobenius\>\""}], 
      "]"}], " ", "&"}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Mean", "[", "crowd", "]"}], ",", " ", 
      RowBox[{"smoothRef", " ", "/@", " ", 
       RowBox[{"(", 
        RowBox[{"dt", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"Round", "[", 
            RowBox[{"tf", "/", "dt"}], "]"}]}], "]"}]}], ")"}]}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[33]:= ",
 CellID->533832725,ExpressionUUID->"4289b0c6-8043-1b93-72b6-29a031f669f9"],

Cell[TextData[{
 "The gap contains two errors: Monte-Carlo scatter, which shrinks as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070f3e08-556d-9d60-2d34-b0525c19e44a"],
 ", and the finite-",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],
 " bias of the discrete trajectory update, which shrinks only when the time \
step is refined. The trajectory ensemble and the master equation share no \
evolution code; agreement under both ensemble enlargement and time-step \
refinement is the numerical validation repeated throughout."
}], "Text",
 CellID->739917449,ExpressionUUID->"4140e475-1e41-1f16-777f-fe3f9bf4627c"],

Cell[TextData[{
 "Two independent errors keep the ensemble mean from the master equation: too \
few trajectories, which leaves sampling scatter, and too coarse a step, which \
leaves discretization bias. ",
 Cell[BoxData["gapDiagnosis"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67f13035-938c-831a-0d8e-aa7f263eee60"],
 " separates them in a single run. It averages an ensemble built from the \
same ",
 Cell[BoxData["trajectory"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b44e14-0404-e868-3e4c-605eadb6bab2"],
 " used above, measures the gap between the mean and the master equation, and \
reads the ensemble's own scatter for how large a gap sampling alone would \
leave at this many trajectories; gap and scatter add in quadrature, so ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["gap",
      FontSlant->"Plain"], "2"], "-", 
    SuperscriptBox[
     StyleBox["scatter",
      FontSlant->"Plain"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],
 " is the systematic remainder. Beside it sits the per-step bias computed \
with no sampling at all: a quadrature over one full Gaussian record increment \
that averages one discrete ",
 Cell[BoxData["measurementStep"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e10bd94-ae42-3b4d-262f-34d1cbf48997"],
 " against the exact Lindblad step, one integration axis per watched channel, \
cheap for one channel or the two of a heterodyne pair and impractical past \
three. The gap is read at one instant, the final time by default, a chosen \
time, or over the whole grid with ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"],
 ":"
}], "Text",
 CellID->473762610,ExpressionUUID->"013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gapDiagnosis", "[", 
    RowBox[{
    "rho0_", ",", " ", "H_", ",", " ", "watched_List", ",", " ", "effs_List", 
     ",", " ", "unwatched_List", ",", " ", "dt_", ",", " ", "tf_", ",", " ", 
     "nTraj_", ",", " ", 
     RowBox[{"atTime_", " ", ":", " ", "Automatic"}]}], "]"}], " ", ":=", 
   "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"steps", " ", "=", " ", 
        RowBox[{"Round", "[", 
         RowBox[{"tf", "/", "dt"}], "]"}]}], ",", " ", 
       RowBox[{"leaks", " ", "=", " ", 
        RowBox[{"Join", "[", 
         RowBox[{"watched", ",", " ", "unwatched"}], "]"}]}], ",", " ", 
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"Length", "[", "rho0", "]"}]}], ",", "\n", "     ", "grid", ",",
        " ", "runs", ",", " ", "means", ",", " ", "gaps", ",", " ", "it", ",",
        " ", "gap", ",", " ", "sem", ",", " ", "sysGap", ",", " ", "bias", ",",
        " ", "stepper", ",", " ", "entry"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"stepper", " ", "=", " ", 
       RowBox[{"measurementStep", "[", 
        RowBox[{
        "H", ",", " ", "watched", ",", " ", "effs", ",", " ", "unwatched", ",",
          " ", "dt"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{
       RowBox[{"entry", "[", 
        RowBox[{
         RowBox[{"dw_", "?", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"VectorQ", "[", 
             RowBox[{"#", ",", " ", "NumericQ"}], "]"}], " ", "&"}], ")"}]}], 
         ",", " ", "j_", ",", " ", "k_"}], "]"}], " ", ":=", "\n", "     ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Times", " ", "@@", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"PDF", "[", 
              RowBox[{
               RowBox[{"NormalDistribution", "[", 
                RowBox[{"0", ",", " ", 
                 RowBox[{"Sqrt", "[", "dt", "]"}]}], "]"}], ",", " ", "#"}], 
              "]"}], " ", "&"}], " ", "/@", " ", "dw"}], ")"}]}], ")"}], "\n",
         "       ", 
        RowBox[{
         RowBox[{"stepper", "[", 
          RowBox[{"rho0", ",", " ", 
           RowBox[{"measurementRecord", "[", 
            RowBox[{
            "rho0", ",", " ", "watched", ",", " ", "effs", ",", " ", "dt", ",",
              " ", "dw"}], "]"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"j", ",", " ", "k"}], "]"}], "]"}]}]}], ";", "\n", "   ", 
      RowBox[{"bias", " ", "=", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"vars", " ", "=", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Unique", "[", "\"\<dw\>\"", "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"Length", "[", "watched", "]"}], "}"}]}], "]"}]}], 
          "}"}], ",", "\n", "     ", 
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"NIntegrate", "[", 
               RowBox[{
                RowBox[{"entry", "[", 
                 RowBox[{"vars", ",", " ", "j", ",", " ", "k"}], "]"}], ",", 
                "\n", "        ", 
                RowBox[{"Evaluate", "[", 
                 RowBox[{"Sequence", " ", "@@", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"#", ",", " ", 
                    RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], 
                    " ", "&"}], " ", "/@", " ", "vars"}], ")"}]}], "]"}], ",",
                 " ", 
                RowBox[{
                "Method", " ", "->", " ", "\"\<GlobalAdaptive\>\""}]}], "]"}],
               ",", "\n", "       ", 
              RowBox[{"{", 
               RowBox[{"j", ",", " ", "d"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"k", ",", " ", "d"}], "}"}]}], "]"}], " ", "-", " ", 
            RowBox[{"evolve", "[", 
             RowBox[{
             "H", ",", " ", "leaks", ",", " ", "rho0", ",", " ", "dt"}], 
             "]"}]}], ",", " ", "\"\<Frobenius\>\""}], "]"}]}], "]"}]}], ";", 
      "\n", "   ", 
      RowBox[{"runs", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"trajectory", "[", 
           RowBox[{
           "rho0", ",", " ", "H", ",", " ", "watched", ",", " ", "effs", ",", 
            " ", "unwatched", ",", " ", "dt", ",", " ", "tf", ",", " ", "k"}],
            "]"}], "[", "\"\<states\>\"", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "nTraj"}], "}"}]}], "]"}]}], ";", "\n", 
      "   ", 
      RowBox[{"grid", " ", "=", " ", 
       RowBox[{"dt", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", "steps"}], "]"}]}]}], ";", "\n", "   ", 
      RowBox[{"means", " ", "=", " ", 
       RowBox[{"Mean", "[", "runs", "]"}]}], ";", "\n", "   ", 
      RowBox[{"gaps", " ", "=", " ", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{
            RowBox[{"#1", " ", "-", " ", "#2"}], ",", 
            " ", "\"\<Frobenius\>\""}], "]"}], " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"means", ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"evolve", "[", 
              RowBox[{
              "H", ",", " ", "leaks", ",", " ", "rho0", ",", " ", "#"}], 
              "]"}], " ", "&"}], " ", "/@", " ", "grid"}]}], "}"}]}], "]"}]}],
       ";", "\n", "   ", 
      RowBox[{"it", " ", "=", " ", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"atTime", " ", "===", " ", "All"}], ",", " ", 
         RowBox[{"First", "@", 
          RowBox[{"Ordering", "[", 
           RowBox[{"gaps", ",", " ", 
            RowBox[{"-", "1"}]}], "]"}]}], ",", " ", 
         RowBox[{"atTime", " ", "===", " ", "Automatic"}], ",", " ", 
         RowBox[{"steps", " ", "+", " ", "1"}], ",", "\n", "      ", "True", ",",
          " ", 
         RowBox[{"Clip", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Round", "[", 
             RowBox[{"atTime", "/", "dt"}], "]"}], " ", "+", " ", "1"}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", 
             RowBox[{"steps", " ", "+", " ", "1"}]}], "}"}]}], "]"}]}], 
        "]"}]}], ";", "\n", "   ", 
      RowBox[{"gap", " ", "=", " ", 
       RowBox[{"gaps", "[", 
        RowBox[{"[", "it", "]"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"sem", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"Variance", "[", 
            RowBox[{"runs", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "it"}], "]"}], "]"}], "]"}], ",", " ", 
           "2"}], "]"}], "/", "nTraj"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"sysGap", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"gap", "^", "2"}], " ", "-", " ", 
           RowBox[{"sem", "^", "2"}]}], ",", " ", "0"}], "]"}], "]"}]}], ";", 
      "\n", "   ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Time\>\"", " ", "->", " ", 
         RowBox[{"grid", "[", 
          RowBox[{"[", "it", "]"}], "]"}]}], ",", " ", 
        RowBox[{"\"\<EnsembleGap\>\"", " ", "->", " ", "gap"}], ",", " ", 
        RowBox[{"\"\<SamplingError\>\"", " ", "->", " ", "sem"}], ",", "\n", 
        "     ", 
        RowBox[{"\"\<SystematicGap\>\"", " ", "->", " ", "sysGap"}], ",", " ", 
        RowBox[{"\"\<StepBias\>\"", " ", "->", " ", "bias"}], ",", "\n", 
        "     ", 
        RowBox[{"\"\<Verdict\>\"", " ", "->", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"gap", " ", "<=", " ", 
            RowBox[{"2", " ", "sem"}]}], ",", 
           " ", "\"\<within sampling noise: add trajectories to tighten\>\"", 
           ",", "\n", 
           "        ", "\"\<discretization bias dominates: refine dt\>\""}], 
          "]"}]}]}], "|>"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[34]:= ",
 CellID->1751712322,ExpressionUUID->"4b734859-75e7-efa6-7901-62030393b58c"],

Cell["\<\
At a fine step the gap sits inside the sampling scatter, the systematic \
remainder is zero, and only more trajectories would tighten it:\
\>", "Text",
 CellID->1390140890,ExpressionUUID->"4ae31c17-eefa-a706-7a90-96508a8c0a6c"],

Cell[BoxData[
 RowBox[{"gapDiagnosis", "[", 
  RowBox[{"start", ",", " ", "Hx", ",", " ", "oneLeak", ",", " ", 
   RowBox[{"{", "1.", "}"}], ",", " ", 
   RowBox[{"{", "}"}], ",", " ", "0.005", ",", " ", "8.0", ",", " ", "200"}], 
  "]"}]], "Input",
 CellLabel->"In[35]:= ",
 CellID->1031105928,ExpressionUUID->"00844d77-2817-3ec6-30bc-653149a3842c"],

Cell["\<\
At a coarse step the same run splits the other way: the gap outgrows the \
scatter, a systematic remainder survives, and the per-step bias, carrying no \
sampling, points to the step itself as the cause:\
\>", "Text",
 CellID->1410588720,ExpressionUUID->"20b97f64-b973-0c8a-5047-774e380656d0"],

Cell[BoxData[
 RowBox[{"gapDiagnosis", "[", 
  RowBox[{"start", ",", " ", "Hx", ",", " ", "oneLeak", ",", " ", 
   RowBox[{"{", "1.", "}"}], ",", " ", 
   RowBox[{"{", "}"}], ",", " ", "0.1", ",", " ", "8.0", ",", " ", "2000"}], 
  "]"}]], "Input",
 CellLabel->"In[36]:= ",
 CellID->1051974278,ExpressionUUID->"04469009-6b02-dcc3-2c7d-0a530eb4a629"],

Cell[TextData[{
 "The first run is sampling-limited, the second step-limited. These are the \
two knobs behind every convergence check that follows: raise the trajectory \
count until the scatter is small, refine the step until the systematic \
remainder is small, and the ensemble mean meets the master equation. The \
homodyne and heterodyne examples apply ",
 Cell[BoxData["gapDiagnosis"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],
 " directly to their diffusive ensembles; the jump unravellings, which this \
diffusive diagnostic does not cover, run the same two-knob check in their own \
idiom. The surviving gap is read from the ensemble rather than from the \
per-step bias times the step count, because the master equation is \
contractive: each step's error decays over the steps that follow, so what \
remains at a given time is smaller than the running sum of per-step biases."
}], "Text",
 CellID->1989924844,ExpressionUUID->"5547dfb6-0e84-e145-037c-d6f0ab36b3af"],

Cell[TextData[{
 "One more fact from the 200-trajectory ensemble: each ",
 StyleBox["conditional",
  FontWeight->"Bold"],
 " trajectory stays pure, while the ensemble average is mixed. Compare the \
purity of one trajectory's final state with that of the ensemble mean:"
}], "Text",
 CellID->695529426,ExpressionUUID->"12b61bfc-9cd7-eca9-424d-92a61563b6f3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"purity", "[", 
    RowBox[{"Last", "@", 
     RowBox[{
      RowBox[{"trajectory", "[", 
       RowBox[{"start", ",", " ", "Hx", ",", " ", "oneLeak", ",", " ", 
        RowBox[{"{", "1.", "}"}], ",", " ", 
        RowBox[{"{", "}"}], ",", " ", "dt", ",", " ", "tf", ",", " ", "1"}], 
       "]"}], "[", "\"\<states\>\"", "]"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"purity", "[", 
    RowBox[{"Last", "@", 
     RowBox[{"Mean", "[", "crowd", "]"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[37]:= ",
 CellID->767788723,ExpressionUUID->"451364b5-819d-fb99-7321-7dff3029c9e3"],

Cell["\<\
The single trajectory ends pure; the average ends mixed. This is the heart of \
the subject: under ideal monitoring (a pure initial state, every output \
channel watched, unit detector efficiency, no extra unrecorded noise) \
decoherence does not happen to any one conditioned state, which stays pure, \
and mixing is entirely the result of averaging over the unrecorded outcomes. \
Relax any of those conditions, add inefficiency, an unmonitored channel, \
thermal drive, or dephasing, and the conditioned state itself becomes mixed; \
the pure-trajectory picture is the ideal limit, and where the examples below \
invoke it they are in that limit.\
\>", "Text",
 CellID->494419947,ExpressionUUID->"13b49e24-0fb7-4441-414b-178eaa422eab"],

Cell["The Bloch-sphere plot", "Subsection",
 CellID->1581507689,ExpressionUUID->"445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],

Cell[TextData[{
 "For a qubit the natural picture is the Bloch sphere: the Bloch vector's tip \
lies on the surface for a pure state, inside for a mixed one. Draw it with \
the ",
 Cell[BoxData["BlochSpherePlot"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "089aa42d-ce49-3603-38b9-3e76ebfd9d69"],
 " resource function, whose empty call returns the shaded ball with its axes \
and labels as a ",
 Cell[BoxData["Graphics3D"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48fccab3-b886-a0f7-7883-e3fd3930f2dd"],
 " ready to overlay each trajectory on:"
}], "Text",
 CellID->2120100675,ExpressionUUID->"0cdaad60-2181-5e26-34f9-454a5034250c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bloch", "[", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"ResourceFunction", "[", "\"\<BlochSpherePlot\>\"", "]"}], "[", 
   "]"}]}]], "Input",
 CellLabel->"In[38]:= ",
 CellID->950326543,ExpressionUUID->"542cff75-84e0-b601-7dd3-f73f2c9a1d6b"],

Cell["\<\
A small octahedron will mark where a trajectory ends; build it from its six \
vertices:\
\>", "Text",
 CellID->1689126594,ExpressionUUID->"00dd9d4d-f7ec-565f-30e2-151681993ca5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"diamond", "[", 
    RowBox[{"p_", ",", " ", "r_"}], "]"}], " ", ":=", " ", 
   RowBox[{"GraphicsComplex", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"p", " ", "+", " ", "#"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"(", 
       RowBox[{"r", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "0", ",", " ", "0"}], "}"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", 
            RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ")"}]}], ",", "\n", "   ", 
     RowBox[{"Polygon", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "2", ",", " ", "5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "4", ",", " ", "5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "1", ",", " ", "5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "1", ",", " ", "6"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "6"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "2", ",", " ", "6"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "4", ",", " ", "6"}], "}"}]}], "}"}], "]"}]}],
     "]"}]}], ";"}]], "Input",
 CellLabel->"In[39]:= ",
 CellID->1490757098,ExpressionUUID->"0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],

Cell["\<\
The plotter uses one visual grammar for every trajectory: the path is a \
curve, a small ball marks where it starts, a diamond marks where it ends, and \
all three share one color per trajectory. A label names the picture, a legend \
names the trajectories when they mean different things, and extra marks \
(fixed points, targets) ride along as plain graphics primitives:\
\>", "Text",
 CellID->148290444,ExpressionUUID->"3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"blochPlot", "[", 
    RowBox[{"paths_", ",", " ", 
     RowBox[{"lbl_", " ", ":", " ", "None"}], ",", " ", 
     RowBox[{"names_", " ", ":", " ", "None"}], ",", " ", 
     RowBox[{"extras_", " ", ":", " ", 
      RowBox[{"{", "}"}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"Show", "[", 
        RowBox[{
         RowBox[{"bloch", "[", "]"}], ",", "\n", "     ", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{"MapIndexed", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ColorData", "[", 
                RowBox[{"97", ",", " ", 
                 RowBox[{"First", "@", "#2"}]}], "]"}], ",", " ", "Thick", ",",
                " ", 
               RowBox[{"Line", "[", "#1", "]"}], ",", "\n", "         ", 
               RowBox[{"Sphere", "[", 
                RowBox[{
                 RowBox[{"First", "[", "#1", "]"}], ",", " ", "0.035"}], 
                "]"}], ",", " ", 
               RowBox[{"diamond", "[", 
                RowBox[{
                 RowBox[{"Last", "[", "#1", "]"}], ",", " ", "0.06"}], 
                "]"}]}], "}"}], " ", "&"}], ",", " ", "paths"}], "]"}], "]"}],
          ",", "\n", "     ", 
         RowBox[{"Graphics3D", "[", "extras", "]"}], ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", "lbl"}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"names", " ", "===", " ", "None"}], ",", " ", "g", ",", " ", 
       RowBox[{"Legended", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"LineLegend", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"ColorData", "[", 
              RowBox[{"97", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", 
            " ", 
            RowBox[{"Range", "[", 
             RowBox[{"Length", "[", "names", "]"}], "]"}]}], ",", " ", 
           "names"}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[40]:= ",
 CellID->1707667820,ExpressionUUID->"333832e2-8bec-4128-62c7-abcc2d991072"],

Cell["Run one monitored trajectory of the test qubit:", "Text",
 CellID->933399197,ExpressionUUID->"78cf51d6-d7cd-4672-28f5-4893e2782d58"],

Cell[BoxData[
 RowBox[{
  RowBox[{"demoRun", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", " ", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", " ", 
         RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], ",", " ", "Hx", ",", " ", 
     "oneLeak", ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "0.01", ",", " ", "3.0", ",", " ", "4"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[41]:= ",
 CellID->955179929,ExpressionUUID->"1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],

Cell["\<\
Now visualize the monitored trajectory on the Bloch sphere, from its starting \
ball to its final diamond:\
\>", "Text",
 CellID->775067320,ExpressionUUID->"710db4a8-d877-0db2-2732-2df5d9025798"],

Cell[BoxData[
 RowBox[{"blochPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"blochVector", " ", "/@", " ", 
     RowBox[{"demoRun", "[", "\"\<states\>\"", "]"}]}], "}"}], ",", 
   " ", "\"\<one monitored trajectory, ball to diamond\>\""}], "]"}]], "Input",\

 CellLabel->"In[42]:= ",
 CellID->72268088,ExpressionUUID->"71e12f72-3ad4-a92f-279e-c73cbf66f875"],

Cell["\<\
The Bloch vector wanders as the record comes in; one seed is one run. Change \
the seed and it wanders differently; averaging many recovers the smooth \
relaxation checked above.\
\>", "Text",
 CellID->546416532,ExpressionUUID->"06ea8612-dd18-b4f0-2ee9-185fd4921eda"],

Cell["\<\
The sphere shows the shape of the path; the same run also reads as three \
numbers in time, one curve for each Bloch component:\
\>", "Text",
 CellID->2117784656,ExpressionUUID->"0b02f270-2101-5c3d-3931-f43a50b42707"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"blochVector", " ", "/@", " ", 
     RowBox[{"demoRun", "[", "\"\<states\>\"", "]"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "3"}], "]"}]}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[LeftAngleBracket]\[Sigma]x\[RightAngleBracket]\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]\[Sigma]y\[RightAngleBracket]\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]\[Sigma]z\[RightAngleBracket]\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "520"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<Bloch component\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{"DataRange", " ", "->", " ", 
    RowBox[{"MinMax", "@", 
     RowBox[{"demoRun", "[", "\"\<times\>\"", "]"}]}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the same run, component by component\>\""}]}], "]"}]], "Input",
 CellLabel->"In[43]:= ",
 CellID->853117843,ExpressionUUID->"2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],

Cell[TextData[{
 "All three components move. ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],
 " starts at one and decays toward zero, since the drive turns the state \
about the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],
 "-axis and cannot rebuild what watching ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],
 " erases; meanwhile ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e73fafe-05d0-7203-6600-f3b8ac654169"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],
 " wander as that same drive rotates them and the record tips the state \
toward a pole. The sphere and the curves are one trajectory seen two ways: \
the sphere gives the shape of the path, the curves give each direction \
changing in time. This component-by-component reading is how a watched qubit \
is usually plotted, and most later examples show just the one component the \
measurement makes interesting, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c044c4-b778-74e1-42f0-5da1c20d5ecb"],
 " for a ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d9aa029-60a8-273a-6bb9-3a7311428a00"],
 " measurement. With the qubit toolkit in hand, on to the first systems."
}], "Text",
 CellID->623836386,ExpressionUUID->"64adc082-4122-deff-0c52-d9ec70d4a4c5"],

Cell["Part One: Systems We Can Solve Symbolically", "Section",
 CellID->564394165,ExpressionUUID->"7e451771-8a55-ceec-267a-8f3b2fe19436"],

Cell[TextData[{
 "The first two systems have exact closed-form answers we can check against \
the code. Both are qubits, so first a convenience: read the master equation \
as three ",
 StyleBox["Bloch equations",
  FontWeight->"Bold"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "."], ",", 
    OverscriptBox[
     StyleBox["y", "TI"], "."], ",", 
    OverscriptBox[
     StyleBox["z", "TI"], "."]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4670f053-f537-0b3f-6e0f-ea1cfcc25605"],
 ". Write the general Bloch state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\|01d7d9", "+", 
    StyleBox["x", "TI"], 
    StyleBox["X", "TI"], "+", 
    StyleBox["y", "TI"], 
    StyleBox["Y", "TI"], "+", 
    StyleBox["z", "TI"], 
    StyleBox["Z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "330aabc0-bdd5-22a3-6109-42aa34607089"],
 ":"
}], "Text",
 CellID->2048244887,ExpressionUUID->"38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"blochState", "[", 
    RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"id2", " ", "+", " ", 
      RowBox[{"x", " ", "X"}], " ", "+", " ", 
      RowBox[{"y", " ", "Y"}], " ", "+", " ", 
      RowBox[{"z", " ", "Z"}]}], ")"}], "/", "2"}]}], ";"}]], "Input",
 CellLabel->"In[44]:= ",
 CellID->1432457359,ExpressionUUID->"70d705b8-410a-1477-20ec-9ce270bf7f5d"],

Cell["\<\
Feed it to the Lindbladian and extract each component's rate:\
\>", "Text",
 CellID->200346680,ExpressionUUID->"737c509e-bc52-eefb-2104-49d835e4b4c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rates", "[", 
    RowBox[{"H_", ",", " ", "leaks_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"ComplexExpand", "@", 
    RowBox[{"Table", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"d", " ", ".", " ", 
        RowBox[{"lindbladian", "[", 
         RowBox[{"H", ",", " ", "leaks", ",", " ", 
          RowBox[{"blochState", "[", 
           RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}]}], "]"}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"d", ",", " ", 
        RowBox[{"{", 
         RowBox[{"X", ",", " ", "Y", ",", " ", "Z"}], "}"}]}], "}"}]}], 
     "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[45]:= ",
 CellID->447384324,ExpressionUUID->"01a44b6b-c85f-9e0e-375c-6334e9ebe554"],

Cell["Pure Dephasing", "Subsection",
 CellID->1438124241,ExpressionUUID->"10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A two-level system dephased along ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25120901-cfbc-a8e6-5321-a16aea4efacc"],
 ", with no Hamiltonian:"
}], "Text",
 CellID->2000382747,ExpressionUUID->"3ee7491f-72c3-8814-669d-61590777db7e"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", 
    StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->902867877,ExpressionUUID->"67860241-8011-89c8-0dbd-a42b31a5db12"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"], "\[Dagger]"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1318f44b-7a0d-b86f-4127-ee157fb90ab5"],
 " this is pure dephasing, so in Bloch components ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "."], "=", "-", "2", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "221ecbfd-1ed7-d323-5225-e2a79b63be09"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["y", "TI"], "."], "=", "-", "2", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f067a83-888f-4db3-653e-73ed293a1799"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["z", "TI"], "."], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "287fc527-5526-9e30-5804-dc815cd0e51a"],
 ", giving ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["x", "TI"], "0"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "2", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2207e002-80f7-0285-523c-fa6c308250ef"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["y", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["y", "TI"], "0"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "2", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "440467ae-8db5-79b4-6c3c-7e0824404b9e"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["z", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141585f4-d1c1-5bbd-3c2a-1cb1e0742987"],
 ". Both poles ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"]], "=", "\[PlusMinus]", "1"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d27d006-86b8-9131-64dc-ca603332e01b"],
 " (the ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e44340b-ef5c-51d5-667b-ae548ae9233f"],
 " eigenstates ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "321034f4-436e-dcec-622f-adbe7618a636"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1287d3f9-6500-de4e-42bc-caa30cbaa494"],
 ", not to be confused with the ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],
 " eigenstate the code calls ",
 Cell[BoxData["plus"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087f5f2f-6486-1b59-3805-56890d3369a3"],
 ") are fixed points, so there is no unique steady state: any mixture ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "+"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Bra"]}], "+", 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "-"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],
 " sits still forever."
}], "Text",
 CellID->1315202099,ExpressionUUID->"2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],

Cell[TextData[{
 "Pure dephasing continuously measures ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13ecd9ee-6506-67bb-4193-d0c80cb34d81"],
 ": it damps the off-diagonal coherences ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox[
     RowBox[{"e", "g"}], "TI"]], "=", 
   SubsuperscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox[
     RowBox[{"g", "e"}], "TI"], "*"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6724c974-bdf1-27a5-0edb-e13e3b858d8f"],
 " (the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b52875c-0948-9ae8-5961-1f06a8e2e832"],
 " and ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53412643-5a68-df00-017e-b82d5f02a26a"],
 " Bloch components, perpendicular to the measured ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "696f5b1d-d56b-3a26-1f15-5346dc1f890c"],
 " axis) and leaves the diagonal populations, set by ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0eb02373-2484-618c-364f-bb3d4d3133d6"],
 ", unchanged. Turning off the Hamiltonian and with one dissipator, then the \
Bloch equations read as:"
}], "Text",
 CellID->376763343,ExpressionUUID->"640353f1-ff8e-e9b3-0c31-4abafa38bb99"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "\[Gamma]", "]"}], ";", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"rates", "[", 
     RowBox[{
      RowBox[{"0", " ", "id2"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "Z"}], "}"}]}], "]"}], ",",
     " ", 
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]}]], "Input",
 CellLabel->"In[46]:= ",
 CellID->126027414,ExpressionUUID->"37161f66-4600-a3a8-5d2d-974073baf1f2"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e44757e-c407-f813-567c-6d3bedb3cb79"],
 " and ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"],
 " components decay at rate ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539b0e4e-9e5a-5525-01b8-a0281bef3c0f"],
 "; ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd82739-42e3-b7ed-44e7-bf6376971d37"],
 " is fixed. Hand those rates, exactly as the Lindbladian produced them, to \
the differential-equation solver as the Bloch equations, and solve from any \
initial Bloch vector:"
}], "Text",
 CellID->570920987,ExpressionUUID->"0971a20b-7913-467e-3f0e-445578a62d44"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "x", ",", " ", "y", ",", " ", "z", ",", " ", "t", ",", " ", "x0", ",", " ",
     "y0", ",", " ", "z0"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"closedDephasing", "[", "t_", "]"}], " ", "=", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], ",", " ", 
     RowBox[{"y", "[", "t", "]"}], ",", " ", 
     RowBox[{"z", "[", "t", "]"}]}], "}"}], " ", "/.", " ", 
   RowBox[{"First", "@", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"Join", "[", "\n", "     ", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"x", "'"}], "[", "t", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"y", "'"}], "[", "t", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"z", "'"}], "[", "t", "]"}]}], "}"}], " ", "==", "\n", 
          "       ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Simplify", "[", 
             RowBox[{
              RowBox[{"rates", "[", 
               RowBox[{
                RowBox[{"0", " ", "id2"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "Z"}], "}"}]}],
                "]"}], ",", " ", 
              RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}], " ", "/.", 
            " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x", " ", "->", " ", 
               RowBox[{"x", "[", "t", "]"}]}], ",", " ", 
              RowBox[{"y", " ", "->", " ", 
               RowBox[{"y", "[", "t", "]"}]}], ",", " ", 
              RowBox[{"z", " ", "->", " ", 
               RowBox[{"z", "[", "t", "]"}]}]}], "}"}]}], ")"}]}], "]"}], ",",
         "\n", "     ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", "0", "]"}], " ", "==", " ", "x0"}], ",", " ", 
          RowBox[{
           RowBox[{"y", "[", "0", "]"}], " ", "==", " ", "y0"}], ",", " ", 
          RowBox[{
           RowBox[{"z", "[", "0", "]"}], " ", "==", " ", "z0"}]}], "}"}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", "t"}], 
     "]"}]}]}]}]}], "Input",
 CellLabel->"In[47]:= ",
 CellID->378517449,ExpressionUUID->"09df342d-d743-5809-3fe4-ae76e2f62b53"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"],
 " and ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21fdaace-430e-f3f9-5782-43a876b8c1c3"],
 " components decay exponentially, ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"],
 " is frozen. Check the closed form against numerical results from the master \
equation over time:"
}], "Text",
 CellID->1671903560,ExpressionUUID->"10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"gg", " ", "=", " ", "0.5"}], ",", " ", 
     RowBox[{"a0", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"0.8", ",", " ", "0.4", ",", " ", "0.3"}], "}"}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"Max", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"closedDephasing", "[", "tt", "]"}], " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
            RowBox[{"x0", " ", "->", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
            RowBox[{"y0", " ", "->", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
            RowBox[{"z0", " ", "->", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], ")"}], " ", "-", 
        "\n", "    ", 
        RowBox[{"blochVector", "[", 
         RowBox[{"evolve", "[", 
          RowBox[{
           RowBox[{"0", " ", "id2"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sqrt", "[", "gg", "]"}], " ", "Z"}], "}"}], ",", " ", 
           RowBox[{"blochState", " ", "@@", " ", "a0"}], ",", " ", "tt"}], 
          "]"}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"tt", ",", " ", "0", ",", " ", "3", ",", " ", "0.3"}], "}"}]}],
      "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[48]:= ",
 CellID->1307059254,ExpressionUUID->"41c6bfc6-0792-5005-77fd-36a0b227236f"],

Cell["The maximum discrepancy is at numerical solver precision.", "Text",
 CellID->538512558,ExpressionUUID->"62752e4e-571f-d961-120a-c02862aba84b"],

Cell[TextData[{
 "Because ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],
 " never changes, there is no unique steady state: any mixture of ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166277e1-e8de-815f-3e12-6eca8968d3a5"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ae7a534-7379-468c-3a9c-3d7e060c2cd6"],
 " is stationary. The Hermitian stationary-operator basis is \
two-dimensional:"
}], "Text",
 CellID->824717693,ExpressionUUID->"34baef30-7963-b757-5c59-077a78171dbd"],

Cell[BoxData[
 RowBox[{"Chop", "@", 
  RowBox[{"stationary", "[", 
   RowBox[{
    RowBox[{"0", " ", "id2"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sqrt", "[", "0.5", "]"}], " ", "Z"}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[49]:= ",
 CellID->496527141,ExpressionUUID->"15ce0314-20ee-2b64-43f5-9b5e509b764e"],

Cell[TextData[{
 "The returned basis spans the identity and ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38a9ac88-4644-6c0e-6856-45d273f13754"],
 " directions. It is an operator basis, not a list of physical states: every \
physical member of the stationary family is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\|01d7d9", "+", 
    StyleBox["z", "TI"], 
    StyleBox["Z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64802aa2-b136-451c-0cbf-c30fc0c32c66"],
 " with ",
 Cell[BoxData[
  RowBox[{"-", "1", "\[LessEqual]", 
   StyleBox["z", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"],
 ". Verify the whole family directly:"
}], "Text",
 CellID->2009363188,ExpressionUUID->"233ecb8e-17f3-8d32-52c5-e2e8a187d418"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"lindbladian", "[", 
   RowBox[{
    RowBox[{"0", " ", "id2"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "/", "2"}], "]"}], " ", "Z"}], "}"}], ",", " ", 
    RowBox[{"blochState", "[", 
     RowBox[{"0", ",", " ", "0", ",", " ", "z"}], "]"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[50]:= ",
 CellID->55669068,ExpressionUUID->"7dd949a9-d8cf-50b3-2be7-60f2d97a2299"],

Cell[TextData[{
 "It vanishes identically. The endpoints ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],
 " are the two poles, and every convex mixture between them is stationary."
}], "Text",
 CellID->1753574084,ExpressionUUID->"598f41e5-f1df-a461-0fb5-58ce806b0f4b"],

Cell[TextData[{
 "Now visualize the dephasing behavior above: start two Bloch vectors \
off-axis and watch each slide straight toward the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e0f0df5-2071-c96f-4634-a4bf51059bb5"],
 "-axis (ball to diamond), keeping its height:"
}], "Text",
 CellID->2038359728,ExpressionUUID->"7f6e12d5-e3b9-0bb9-2515-8b9e964c5983"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"gg", " ", "=", " ", "0.6"}], ",", " ", 
     RowBox[{"starts", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.85", ",", " ", "0.25", ",", " ", "0.4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.6"}], ",", " ", 
          RowBox[{"-", "0.55"}], ",", " ", 
          RowBox[{"-", "0.35"}]}], "}"}]}], "}"}]}]}], "}"}], ",", "\n", " ", 
   
   RowBox[{"blochPlot", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"closedDephasing", "[", "tt", "]"}], " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
            RowBox[{"x0", " ", "->", " ", 
             RowBox[{"s", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
            RowBox[{"y0", " ", "->", " ", 
             RowBox[{"s", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
            RowBox[{"z0", " ", "->", " ", 
             RowBox[{"s", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"tt", ",", " ", "0", ",", " ", "2.5", ",", " ", "0.05"}], 
          "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "starts"}], "}"}]}], "]"}], ",", "\n", 
     "  ", "\"\<dephasing slides each state to the z-axis\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<start (0.85, 0.25, 0.4)\>\"", ",", 
       " ", "\"\<start (-0.6, -0.55, -0.35)\>\""}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[51]:= ",
 CellID->1525364821,ExpressionUUID->"41ecc127-3c02-05fa-7793-d881b5b76fc0"],

Cell[TextData[{
 "Each tip drifts to the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1190ff72-a9fe-60f8-47af-f73fcf8b32c2"],
 "-axis and stops at its own height: the off-diagonal coherence is gone, the \
populations untouched. This is dephasing in its purest form, decoherence with \
nothing else attached."
}], "Text",
 CellID->1535108406,ExpressionUUID->"19c80315-d7de-7125-4ff7-9b5ee26b400f"],

Cell[TextData[{
 "Two quantities summarize the dephasing. The ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fdf78a7-59a9-97d9-15e5-7101585dfd23"],
 " and ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a87483f-bfa4-2eb6-2abd-62793a51749c"],
 " components decay at rate ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09b26917-59e6-8729-3f41-81515f90ea73"],
 ", so the coherence time is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "=", "1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["\[Gamma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "521ad179-838d-ce9b-0239-c923363994e1"],
 ", while the populations never move, so there is no energy relaxation, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "1"], "=", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "136d7364-bcfb-8461-4113-6b4e348fef4b"],
 ". The purity follows from the closed-form Bloch vector, since a state with \
Bloch vector ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["r", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b78534b-7a52-d624-5918-4b157fe4bd0e"],
 " has purity ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SuperscriptBox[GridBox[{
       {
        OverscriptBox[
         StyleBox["r", "TI"], "\[RightVector]"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30c454b2-bdb8-e427-60fc-4dfc3432cf0d"],
 ":"
}], "Text",
 CellID->1528788962,ExpressionUUID->"6879dfe8-0276-0c7b-1806-d6b2b7035741"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{
       RowBox[{"closedDephasing", "[", "t", "]"}], " ", ".", " ", 
       RowBox[{"closedDephasing", "[", "t", "]"}]}]}], ")"}], "/", "2"}], ",",
    " ", 
   RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[52]:= ",
 CellID->1505774531,ExpressionUUID->"7cc522fa-6a93-e579-24fa-bba40f27cc43"],

Cell[TextData[{
 "The purity is ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubsuperscriptBox[
     StyleBox["z", "TI"], "0", "2"], "+", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", "4", 
      StyleBox["\[Gamma]", "TI"], 
      StyleBox["t", "TI"]}]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["x", "TI"], "0", "2"], "+", 
     SubsuperscriptBox[
      StyleBox["y", "TI"], "0", "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b82e386-6ff5-c0ee-09b1-fae009819234"],
 ": it relaxes from its start to ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubsuperscriptBox[
     StyleBox["z", "TI"], "0", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34a39a2f-b372-ffce-5c50-1388c604c514"],
 ", the purity of the leftover diagonal state, at twice the coherence rate. \
The environment has learned which ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66ca9132-7812-8248-0ec9-097c79a4d092"],
 " eigenstate the atom is in and taken none of its energy."
}], "Text",
 CellID->535490749,ExpressionUUID->"023b1c4a-5b09-a8c9-33d8-96145ebdfa13"],

Cell["A Driven, Damped Atom Relaxing to Steady State", "Subsection",
 CellID->1238905205,ExpressionUUID->"29a4f364-fd74-7ca4-5f5b-eb41f401468e"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A two-level atom driven by a laser (a drive about ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47740231-7fc8-4299-6d0b-a47b7a7d10e3"],
 ") while it decays to its ground state:"
}], "Text",
 CellID->2125008310,ExpressionUUID->"1af52337-5e42-c8c3-4a8a-bb715bf49a29"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"\[ScriptCapitalL]", 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], "\[ThinSpace]", 
    FractionBox["\[CapitalOmega]", "2"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["x", "TI"]], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1684656716,ExpressionUUID->"2fdb82dc-2353-e9b3-55f8-1b8656e7bb99"],

Cell[TextData[{
 "In Bloch components the drift is affine, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "."], "=", 
   StyleBox["A", "TI"], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "+", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5782d92f-a790-094a-7db1-d088d2255b90"],
 " with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05d48452-325d-a277-33eb-1e1c47e9f15d"],
 ","
}], "Text",
 CellID->2057792111,ExpressionUUID->"087ffcf6-194e-431e-3804-f5b098fb2e64"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    FractionBox[
     StyleBox["d", "TI"], 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]], "(", GridBox[{
      {
       StyleBox["x", "TI"]},
      {
       StyleBox["y", "TI"]},
      {
       StyleBox["z", "TI"]}
     }], ")", "=", "(", GridBox[{
      {
       RowBox[{"-", 
        StyleBox["\[Gamma]", "TI"], "/", "2"}], "0", "0"},
      {"0", 
       RowBox[{"-", 
        StyleBox["\[Gamma]", "TI"], "/", "2"}], 
       RowBox[{"-", "\[CapitalOmega]"}]},
      {"0", "\[CapitalOmega]", 
       RowBox[{"-", 
        StyleBox["\[Gamma]", "TI"]}]}
     }], ")", "(", GridBox[{
      {
       StyleBox["x", "TI"]},
      {
       StyleBox["y", "TI"]},
      {
       StyleBox["z", "TI"]}
     }], ")", "+", "(", GridBox[{
      {"0"},
      {"0"},
      {
       RowBox[{"-", 
        StyleBox["\[Gamma]", "TI"]}]}
     }], ")"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->408837332,ExpressionUUID->"615fadf7-df9a-5675-1764-44b0da2f3d5f"],

Cell["which spirals in to the steady state", "Text",
 CellID->1068510841,ExpressionUUID->"5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]], "=", "0"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["y", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]], "=", 
    FractionBox[
     RowBox[{"2", "\[CapitalOmega]", 
      StyleBox["\[Gamma]", "TI"]}], 
     RowBox[{
      SuperscriptBox[
       StyleBox["\[Gamma]", "TI"], "2"], "+", "2", 
      SuperscriptBox["\[CapitalOmega]", "2"]}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["z", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]], "=", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox[
       StyleBox["\[Gamma]", "TI"], "2"], 
      RowBox[{
       SuperscriptBox[
        StyleBox["\[Gamma]", "TI"], "2"], "+", "2", 
       SuperscriptBox["\[CapitalOmega]", "2"]}]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1027032549,ExpressionUUID->"2d0df906-1ebb-1081-5b32-f1609b4e62eb"],

Cell[TextData[{
 "at the rate set by the eigenvalues ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "\[PlusMinus]"], "=", "-", 
   FractionBox[
    RowBox[{"3", 
     StyleBox["\[Gamma]", "TI"]}], "4"], "\[PlusMinus]", 
   StyleBox["i", "TI"], 
   OverscriptBox["\[CapitalOmega]", "~"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519a4e0d-3467-bfb9-07ba-6057bd130583"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox["\[CapitalOmega]", "~"], "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "-", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["\[Gamma]", "TI"], "/", "4"}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a891815-8c00-cf41-6ab6-925f25ba95ab"],
 " (a damped oscillation once ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", ">", 
   StyleBox["\[Gamma]", "TI"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dbacffa-31b0-43f6-3b59-e6a4404511dc"],
 "). Solve it and watch the spiral."
}], "Text",
 CellID->171792661,ExpressionUUID->"196a859c-b643-c1b3-4f69-1cd9c3f79399"],

Cell[TextData[{
 "Given a laser drive about ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c8a383-1e42-ef31-78f7-3aed9bf4b21b"],
 " and spontaneous emission through ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], "-"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50735439-04fd-dee7-0001-4e63ac89a4cd"],
 ", read the Bloch equations:"
}], "Text",
 CellID->574949478,ExpressionUUID->"3597ba8d-914b-928f-63ac-33d720ffe0d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"\[Gamma]", ",", " ", "\[CapitalOmega]"}], "]"}], ";", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"rates", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}], "}"}]}], 
     "]"}], ",", " ", 
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]}]], "Input",
 CellLabel->"In[53]:= ",
 CellID->1664775781,ExpressionUUID->"056fda38-a5bc-2884-3314-dc65cc497aee"],

Cell[TextData[{
 "The component ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "383c4a9f-130c-f8c1-69c4-63d9a6beca2b"],
 " decays; the drive couples ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b649e79-a2e1-7610-291b-1022d6945d7a"],
 " and ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09cb884c-5fc8-b209-3fc8-22165a620153"],
 " while emission pulls ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "376c6589-bcca-29e8-5d14-7cd3357f7b32"],
 " toward the ground state. This has a unique steady state. Find it by \
setting all three rates to zero:"
}], "Text",
 CellID->884697794,ExpressionUUID->"667bb688-7420-22c7-0e18-2fd27dd5702d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"steady", " ", "=", " ", 
   RowBox[{"First", "@", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"rates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}], "}"}]}], 
         "]"}], " ", "==", " ", "0"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[54]:= ",
 CellID->784201795,ExpressionUUID->"72002252-da4c-5210-223f-c41fdff9217a"],

Cell["Read the steady state in closed form:", "Text",
 CellID->1193259712,ExpressionUUID->"084561a7-5440-aaee-387b-78015dfaf834"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "/.", " ", 
    "steady"}], ",", " ", 
   RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[55]:= ",
 CellID->1084903799,ExpressionUUID->"721e71e5-9ca7-ded5-2226-68cf1553a43f"],

Cell[TextData[{
 "The steady state in closed form: the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a84e7eb-55e0-1894-3abb-feb563956afe"],
 "-component vanishes, so the Bloch vector lies in the ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3261920b-7b77-02d6-621e-14557e02503c"],
 "-",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebe3b2c-9c8f-bd2d-7645-b376153b0477"],
 " plane, pulled up out of the ground state (",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6a0058-fb4a-caff-2b69-9a05fefc98c5"],
 ") toward the equator by an amount set by the drive-to-emission ratio ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41d92934-9aba-8299-77e6-c17e1f4cd0e3"],
 "."
}], "Text",
 CellID->964492758,ExpressionUUID->"5cc23ff5-bf0f-f019-04f1-b6bf3abbc363"],

Cell[TextData[{
 "Two physical numbers fall straight out of this steady state. The first is \
the excited-state population ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["ee",
     FontSlant->"Plain"], 
    StyleBox["ss",
     FontSlant->"Plain"]], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["z", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Gamma]", "TI"], "2"], "+", "2", 
    SuperscriptBox["\[CapitalOmega]", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29880975-91f0-008f-5fb7-a13f278552d5"],
 ": it grows as ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   SuperscriptBox[
    StyleBox["\[Gamma]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "551c00cf-fc58-99c4-0323-99a8f5d2eb2e"],
 " when the drive is weak and saturates at one half when the drive is strong, \
so the excited population never passes one half, and no drive can invert the \
atom (make it more likely excited than in its ground state). The second is \
the steady rate at which the atom scatters photons, the fluorescence flux ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["ee",
     FontSlant->"Plain"], 
    StyleBox["ss",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22235db8-54be-42b7-53d1-54e25d4b109d"],
 ": the spontaneous-emission rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0976d5ae-737d-f257-3f0d-cc080609c0bd"],
 " times that population. Read both off the closed form:"
}], "Text",
 CellID->242210635,ExpressionUUID->"13e711b4-4d78-4d68-419c-88fe640d17b2"],

Cell[BoxData[
 RowBox[{"Grid", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Transpose", "@", 
    RowBox[{"{", "\n", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<the excited-state population\>\"", ",", 
        " ", "\"\<the fluorescence flux\>\""}], "}"}], ",", "\n", "   ", 
      RowBox[{"FullSimplify", " ", "/@", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"zss", " ", "=", " ", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"z", " ", "/.", " ", "steady"}], ",", " ", 
             RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]}], "}"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", " ", "+", " ", "zss"}], ")"}], "/", "2"}], ",", " ", 
           RowBox[{"\[Gamma]", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", " ", "+", " ", "zss"}], ")"}], "/", "2"}]}]}], 
          "}"}]}], "]"}]}]}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]], "Input",
 CellLabel->"In[56]:= ",
 CellID->360816480,ExpressionUUID->"3fd09d86-aea1-a602-65ef-14e3cb550d68"],

Cell[TextData[{
 "How does the atom approach the stationary state? Consider the affine drift ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "."], "=", 
   StyleBox["A", "TI"], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "+", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f6c0922-6605-ed68-5513-a08c13b1b7b2"],
 " and subtract the steady state. Since ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], 
    StyleBox["ss",
     FontSlant->"Plain"]], "+", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2caab86a-2af9-b1b1-54a9-32344e8d039b"],
 ", the constant term cancels and the displacement ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "=", 
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "-", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], 
    StyleBox["ss",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f56169e-4783-4dbb-256d-8fd872361781"],
 " obeys a purely linear law,"
}], "Text",
 CellID->1505759259,ExpressionUUID->"5b84d4d6-858d-5842-09bb-cd902c382aa8"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    FractionBox[
     StyleBox["d", "TI"], 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]], "\[ThinSpace]", 
    StyleBox["\[Delta]", "TI"], 
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "=", 
    StyleBox["A", "TI"], "\[ThinSpace]", 
    StyleBox["\[Delta]", "TI"], 
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1384053022,ExpressionUUID->"67558936-e5eb-8680-0d6a-2173939fecea"],

Cell[TextData[{
 "so the motion is a sum of eigenmodes of ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1072dc7c-f7d5-c74e-4001-d6398261ad94"],
 ", each of the form ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"\[Lambda]", "t"}], "TI"]], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3462f0a3-098c-f6b3-5c11-e90da83edc99"],
 ": the real part of ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04cac1af-436c-9192-2cc9-d809761ee3f8"],
 " shrinks a mode, the imaginary part rotates it. The eigenvalues of ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63be94f2-239e-9b81-1145-0dbc5628e9eb"],
 " (the Jacobian of the rates) therefore set the entire approach:"
}], "Text",
 CellID->1395659232,ExpressionUUID->"5a3d7a71-218e-1995-0bc3-7c3b503b6bff"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Eigenvalues", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"rates", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}], "}"}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], "}"}]}], "]"}], 
    "]"}], ",", " ", 
   RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[57]:= ",
 CellID->874592789,ExpressionUUID->"3a0f2024-2f71-09ca-6a34-b98e4a045b10"],

Cell[TextData[{
 "Two of the three are a complex-conjugate pair, so that mode is a ",
 StyleBox["damped spiral",
  FontWeight->"Bold"],
 ", a ring-down whenever the drive exceeds a quarter of the emission rate, ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", ">", 
   StyleBox["\[Gamma]", "TI"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "277956ac-4c9d-d338-4d07-4ff66529be02"],
 "; the third is real and belongs to the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "178a6a52-23e4-1142-3d89-8c1c559163a8"],
 "-direction, a mode that only shrinks. The eigenvalues fix these rates, but \
which of them a given trajectory excites depends on where it starts, which is \
the opening for the straight-line approach just below."
}], "Text",
 CellID->1596157938,ExpressionUUID->"52ddf811-e480-8137-02e2-f25a8d3ad01d"],

Cell[TextData[{
 "But a special pair of initial states skips the spiral entirely and slides \
straight in, and the reason sits in the drift matrix itself. Check that ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", "0", ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "719ae17a-c654-ed44-27b9-f927f3e6b7ae"],
 " is one of its eigenvectors, with eigenvalue ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["\[Gamma]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62c8f42b-c628-388a-12f7-ee74f3c28ad0"],
 ":"
}], "Text",
 CellID->1496122589,ExpressionUUID->"36e5ffeb-8179-694d-5e9a-f6b5300c3b97"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"rates", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}], "}"}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], "}"}]}], "]"}], 
    " ", ".", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}]}], ",", " ", 
   RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[58]:= ",
 CellID->1956327387,ExpressionUUID->"7af061c8-c44a-ae8e-2a80-7895edfcf4d4"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox[
    StyleBox["\[Gamma]", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", "0", ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d437dad-8290-de9a-3b71-74f7372aa4e0"],
 ": a state displaced from the steady state purely along ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aafc905-908a-67da-2a54-e16f213f4d20"],
 " stays purely ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62016b94-8ad8-fb56-123e-82de2f52c9bc"],
 "-displaced as it evolves (the drift never turns that displacement into ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e7c794a-82c2-56e7-3604-711437773ccd"],
 " or ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30f601cf-5001-fb68-608d-98a961b5c9b2"],
 ") and simply shrinks at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04bc0f0b-f02f-243d-2c43-a75481db8f07"],
 ". So the line through the steady state parallel to the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],
 "-axis is invariant: a state starting on it slides straight down it into the \
steady state, with no spiral. That line meets the Bloch sphere at two pure \
states, and since ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705e212e-f5a4-7717-2065-b88bfc515a7d"],
 " they sit at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "\[PlusMinus]", 
   SqrtBox[
    RowBox[{"1", "-", 
     SubsuperscriptBox[
      StyleBox["y", "TI"], 
      StyleBox["ss",
       FontSlant->"Plain"], "2"], "-", 
     SubsuperscriptBox[
      StyleBox["z", "TI"], 
      StyleBox["ss",
       FontSlant->"Plain"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c2f5325-a3f6-c048-05d5-4a8ed5809292"],
 " with the steady ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["y", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]], ",", 
   SubscriptBox[
    StyleBox["z", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "211ecaf2-61ee-418f-5725-e3bc179b13d5"],
 ":"
}], "Text",
 CellID->1131177628,ExpressionUUID->"51e4dffc-d38f-5703-079b-d6b9e63a3a69"],

Cell[BoxData[
 RowBox[{"flatPair", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ss", " ", "=", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "/.", " ", 
         "steady"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{
              RowBox[{"ss", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"ss", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "^", "2"}]}], "]"}]}], ",", 
          " ", 
          RowBox[{"ss", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
          RowBox[{"ss", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", 
       " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[59]:= ",
 CellID->611195905,ExpressionUUID->"30e43b5d-74af-d0fb-609b-b3077d5ba2c1"],

Cell[TextData[{
 "These two states are one way to write the mixed steady state as a blend of \
two pure states, and a mixed state has infinitely many such blends. This one \
is special for a reason about measurement. If the atom's emitted light is \
continuously monitored, its conditioned state stays pure and wanders as the \
record arrives, and averaging over the record returns ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["ss",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44d9380c-2e05-8f35-6ce6-b2564bb1d21f"],
 "; for certain blends a real detector can keep that wandering confined to \
the blend's own states, and such a blend is a ",
 StyleBox["physically realizable ensemble",
  FontWeight->"Bold"],
 " (Wiseman and Vaccaro). This two-state one is the simplest kind, a ",
 StyleBox["physically realizable (PR) pair",
  FontWeight->"Bold"],
 ". Not every blend qualifies, and the averaged, unmonitored drift ",
 Cell[BoxData[
  OverscriptBox[
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "."]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"],
 " already tells the two apart. Read it at a point off the same ",
 Cell[BoxData["rates"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "138e1639-4d05-8b97-41b5-886364b1d9fd"],
 ", kept symbolic in ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", ",", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "156728ce-0023-e03b-431c-c1a8b1d7b301"],
 ":"
}], "Text",
 CellID->1202919897,ExpressionUUID->"7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"],

Cell[BoxData[
 RowBox[{
  RowBox[{"driftAt", "[", "r_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"rates", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "lower"}], "}"}]}], "]"}],
    " ", "/.", " ", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "->", " ", 
     "r"}], "]"}]}]}]], "Input",
 CellLabel->"In[60]:= ",
 CellID->1334651244,ExpressionUUID->"26ff5c08-e081-ff27-4e85-56559135c20d"],

Cell[TextData[{
 "The PR pair is ",
 Cell[BoxData["flatPair"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07c988c4-3ef2-8066-2df6-21aeba84d34c"],
 ", the two states where the invariant line pierces the sphere. Its rival is \
the ",
 StyleBox["orthogonal", "TI"],
 " ensemble, the steady-state density matrix's own two eigenstates, the \
antipodal pure states in the ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], 
    StyleBox["ss",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bc0a2f3-6150-447f-79ff-3bbd10e52f45"],
 " directions:"
}], "Text",
 CellID->185339758,ExpressionUUID->"7ac66077-3bfa-1f18-2afe-7a31bd8f6262"],

Cell[BoxData[
 RowBox[{"orthPair", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"#", ",", " ", 
        RowBox[{"-", "#"}]}], "}"}], " ", "&"}], "@", 
     RowBox[{"Normalize", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "/.", " ", 
       "steady"}], "]"}]}], ",", " ", 
    RowBox[{
     RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[61]:= ",
 CellID->1677030473,ExpressionUUID->"3d863d84-94ab-5643-6bbd-b4ee1d5e3ca9"],

Cell[TextData[{
 "With both pairs in hand, watch how they sit on the sphere as the \
drive-to-emission ratio varies. Drag ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ab8b877-e011-189c-2a47-323091a46ae6"],
 " (at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35eb0178-2238-e094-63e8-992257b2b2fe"],
 "): the steady state is green, the PR pair blue joined by its dashed chord, \
the orthogonal pair orange. The PR chord stays parallel to the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da6433d-a7a4-ba24-3b5e-5b66d256090e"],
 "-axis at every setting, while the orthogonal chord runs through the origin \
along the steady direction, the geometric split the drifts below make precise."
}], "Text",
 CellID->134345938,ExpressionUUID->"462f64f6-435d-c7dd-6fd5-7db076e9ad27"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\n", " ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ss", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", "/.", " ",
           "steady"}], " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Gamma]", " ", "->", " ", "1"}], ",", " ", 
           RowBox[{"\[CapitalOmega]", " ", "->", " ", "OO"}]}], "}"}]}]}], ",",
        "\n", "   ", 
       RowBox[{"flat", " ", "=", " ", 
        RowBox[{"flatPair", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Gamma]", " ", "->", " ", "1"}], ",", " ", 
           RowBox[{"\[CapitalOmega]", " ", "->", " ", "OO"}]}], "}"}]}]}], ",",
        "\n", "   ", 
       RowBox[{"orth", " ", "=", " ", 
        RowBox[{"orthPair", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Gamma]", " ", "->", " ", "1"}], ",", " ", 
           RowBox[{"\[CapitalOmega]", " ", "->", " ", "OO"}]}], "}"}]}]}]}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{"Legended", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"Show", "[", 
        RowBox[{
         RowBox[{"bloch", "[", "]"}], ",", "\n", "    ", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"PointSize", "[", ".02", "]"}], ",", " ", "Green", ",", 
              " ", 
              RowBox[{"Point", "@", "ss"}]}], "}"}], ",", "\n", "      ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"PointSize", "[", ".02", "]"}], ",", " ", 
              RowBox[{
               RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], ",", 
              " ", 
              RowBox[{"Point", "@", "flat"}]}], "}"}], ",", "\n", "      ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"PointSize", "[", ".02", "]"}], ",", " ", 
              RowBox[{
               RowBox[{"ColorData", "[", "97", "]"}], "[", "2", "]"}], ",", 
              " ", 
              RowBox[{"Point", "@", "orth"}]}], "}"}], ",", "\n", "      ", 
            RowBox[{"{", 
             RowBox[{"Dashed", ",", " ", 
              RowBox[{"Line", "[", "flat", "]"}], ",", " ", 
              RowBox[{"Line", "[", "orth", "]"}]}], "}"}]}], "}"}], "]"}]}], 
        "]"}], ",", "\n", "   ", 
       RowBox[{"SwatchLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Green", ",", " ", 
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], ",", " ", 
           
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], "[", "2", "]"}]}], "}"}], ",",
          " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Steady state\>\"", ",", " ", "\"\<PR pair\>\"", ",", 
           " ", "\"\<Ortho pair\>\""}], "}"}]}], "]"}]}], "]"}]}], "]"}], ",",
    "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "OO", ",", " ", "1", ",", " ", "\"\<\[CapitalOmega]/\[Gamma]\>\""}], 
      "}"}], ",", " ", "0", ",", " ", "10", ",", " ", 
     RowBox[{"AppearanceElements", " ", "->", " ", "All"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[62]:= ",
 CellID->350820043,ExpressionUUID->"4b06bf63-5f43-ed7c-793d-374d5af7b446"],

Cell["The drift at a PR state, in closed form:", "Text",
 CellID->456450236,ExpressionUUID->"0fd1c247-21a4-d962-35ee-e4215056a848"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"driftAt", "[", 
    RowBox[{"flatPair", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[63]:= ",
 CellID->1767337052,ExpressionUUID->"09347675-9fce-c17b-38cc-683f1a789041"],

Cell["and at an eigenstate:", "Text",
 CellID->1422053341,ExpressionUUID->"2c597ed5-00d9-d535-5467-779fb16dbc1f"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"driftAt", "[", 
    RowBox[{"orthPair", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[64]:= ",
 CellID->603286833,ExpressionUUID->"66c4d8d6-27c8-a0db-0efb-d1905262f221"],

Cell[TextData[{
 "For every ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d3801b6-8b23-0df3-74c7-98f02ed657d9"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09816d05-11e9-fb6e-3fbe-856fa79dc9b4"],
 " the PR drift is purely along ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35ec423d-cde2-7917-6394-6466eb97487d"],
 ", exactly along the segment joining the two PR states (they differ only in ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05e0e9bc-56b1-1bf2-339f-00e6634469d8"],
 "), while the eigenstate drift is purely along ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46408f14-a324-388b-6e7f-2751d6d68ad1"],
 ", which cuts across the segment joining the two eigenstates (tilted in the ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40213c85-9219-7c2b-71de-b5ef27ac4771"],
 "-",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "678faed4-2cca-f411-0db4-479e457cdf7b"],
 " plane). The PR pair sits on a line the averaged flow leaves invariant, the \
eigenstate pair does not, and that is the intuition for why one blend is \
physically realizable and the other is not. The drift is only that intuition, \
though: it describes the averaged, unmonitored dynamics, and it neither \
constructs the measurement that realizes the PR pair nor shows the \
conditional state hopping between its two ends. That waits for the trajectory \
examples below, where the stochastic machinery is actually run."
}], "Text",
 CellID->1349832744,ExpressionUUID->"3b3cac94-919f-f08d-6ac3-45de202bc2d7"],

Cell[TextData[{
 "Now visualize all five paths: the spiral from a generic pure state, the two \
flat slides from the PR pair, and the two spirals from the orthogonal pair. \
This is the ",
 StyleBox["unconditional", "TI"],
 " picture, the record averaged away, so every start relaxes into the mixed \
steady state:"
}], "Text",
 CellID->16034565,ExpressionUUID->"634a1270-2707-566e-1149-943a52b23cb4"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"gg", " ", "=", " ", "1."}], ",", " ", 
     RowBox[{"om", " ", "=", " ", "3."}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"startsFlat", ",", " ", "startsOrtho", ",", " ", "path"}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"startsFlat", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"flatPair", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
           RowBox[{"\[CapitalOmega]", " ", "->", " ", "om"}]}], "}"}]}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"startsOrtho", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"orthPair", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
           RowBox[{"\[CapitalOmega]", " ", "->", " ", "om"}]}], "}"}]}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"path", "[", "r0_", "]"}], " ", ":=", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"run", " ", "=", " ", 
           RowBox[{"evolveODE", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"om", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Sqrt", "[", "gg", "]"}], " ", "lower"}], "}"}], ",", 
             " ", "r0", ",", " ", "14."}], "]"}]}], "}"}], ",", "\n", "    ", 
         
         RowBox[{
          RowBox[{
           RowBox[{"blochVector", "[", 
            RowBox[{"run", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", "14", ",", " ", "0.02"}], "]"}]}]}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"blochPlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"path", "[", 
           RowBox[{"densityMatrix", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Cos", "[", 
               RowBox[{"\[Pi]", "/", "8"}], "]"}], ",", " ", 
              RowBox[{
               RowBox[{"E", "^", 
                RowBox[{"(", 
                 RowBox[{"I", " ", 
                  RowBox[{"\[Pi]", "/", "4"}]}], ")"}]}], " ", 
               RowBox[{"Sin", "[", 
                RowBox[{"\[Pi]", "/", "8"}], "]"}]}]}], "}"}], "]"}], "]"}], ",",
           " ", 
          RowBox[{"path", "[", 
           RowBox[{"blochState", " ", "@@", " ", 
            RowBox[{"startsFlat", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", "\n", "    ", 
          RowBox[{"path", "[", 
           RowBox[{"blochState", " ", "@@", " ", 
            RowBox[{"startsFlat", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"path", "[", 
           RowBox[{"blochState", " ", "@@", " ", 
            RowBox[{"startsOrtho", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", "\n", "    ", 
          RowBox[{"path", "[", 
           RowBox[{"blochState", " ", "@@", " ", 
            RowBox[{"startsOrtho", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
        "   ", "\"\<every start lands on the steady state\>\"", ",", "\n", 
        "   ", 
        RowBox[{"{", 
         RowBox[{"\"\<from a generic pure state\>\"", ",", 
          " ", "\"\<physically realizable start +\>\"", ",", 
          " ", "\"\<physically realizable start -\>\"", ",", "\n", 
          "    ", "\"\<orthogonal (eigenstate) start +\>\"", ",", 
          " ", "\"\<orthogonal (eigenstate) start -\>\""}], "}"}]}], 
       "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[65]:= ",
 CellID->344152329,ExpressionUUID->"571f0194-b08e-3ab4-7d24-98d1c138889e"],

Cell[TextData[{
 "The two physically realizable starts slide straight in along the invariant \
line, while the generic start and the two orthogonal starts, all off that \
line, ring down in a damped spiral. This is the drift geometry of the \
previous cells made visible: the averaged flow keeps the PR pair on its own \
chord, so those starts slide, and carries the orthogonal pair off theirs, so \
those must spiral. All five diamonds land on the same Bloch vector inside the \
ball, a driven, damped atom's ",
 StyleBox["unconditional", "TI"],
 " steady state: one mixed point set by the balance of drive and emission, \
whichever pure state you start from."
}], "Text",
 CellID->622383932,ExpressionUUID->"79764466-e076-5945-2f0e-5e4391032baf"],

Cell["Part Two: Light in a Box, and States That Live in Two Places", "Section",
 CellID->2102744249,ExpressionUUID->"54e8dec7-14b1-519a-7c97-d7a19d4423e0"],

Cell[TextData[{
 "The next systems are a single mode of light in a cavity. Its states span \
the Fock ladder ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0"},
    "Ket"], ",", 
   TemplateBox[{"1"},
    "Ket"], ",", 
   TemplateBox[{"2"},
    "Ket"], ",", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25f5c72f-3423-741a-538a-de89bdd65f60"],
 ", an infinite-dimensional space, so we ",
 StyleBox["truncate",
  FontWeight->"Bold"],
 " it: a matrix of dimension ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dbbd446-5835-e39a-1b58-ce2059c1b1e0"],
 " keeps ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d34e655-b983-17e8-14cb-f81f38367d32"],
 " through ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["n", "TI"], "-", "1"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c435daa-0d1c-c5df-0471-54f4a4aeaf25"],
 " and discards ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["n", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21714cd0-c04e-e57a-570f-659df1f8cc40"],
 " upward, and that ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74ff421b-073b-c6d4-1c85-6445b2cfac3e"],
 " is the ",
 StyleBox["cutoff",
  FontWeight->"Bold"],
 ". We choose the cutoff high enough that the retained top level has \
negligible population, then check by raising it."
}], "Text",
 CellID->565659401,ExpressionUUID->"3ebc3a74-dd7c-3fa6-6643-bc31d40e858c"],

Cell[TextData[{
 "The ",
 StyleBox["annihilation",
  FontWeight->"Bold"],
 " and ",
 StyleBox["creation",
  FontWeight->"Bold"],
 " operators step down and up the ladder, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    TemplateBox[{
      StyleBox["n", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    SqrtBox[
     StyleBox["n", "TI"]], 
    TemplateBox[{
      RowBox[{
        StyleBox["n", "TI"], "-", "1"}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d5c93fe-a057-3a16-2b63-0abbd1e3897c"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    TemplateBox[{
      StyleBox["n", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    SqrtBox[
     RowBox[{
      StyleBox["n", "TI"], "+", "1"}]], 
    TemplateBox[{
      RowBox[{
        StyleBox["n", "TI"], "+", "1"}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "487dadd0-5ed6-7873-7802-449a5b634b59"],
 ", so ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5219761b-8a64-c9ff-0227-68452f169bc5"],
 " carries ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69346765-6d1c-e9c9-18cc-7f4f04aebb13"],
 " on its superdiagonal:"
}], "Text",
 CellID->561487989,ExpressionUUID->"7c22b8c2-70f4-0562-25d1-31ac00816c48"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"annihilation", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Band", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Range", "[", 
        RowBox[{"n", " ", "-", " ", "1"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"creation", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"ConjugateTranspose", "[", 
    RowBox[{"annihilation", "[", "n", "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[66]:= ",
 CellID->2021628840,ExpressionUUID->"04fec585-b88c-469b-2c85-dcef39392ce1"],

Cell["\<\
Finite truncation changes the canonical commutator only at the top retained \
level:\
\>", "Text",
 CellID->41425461,ExpressionUUID->"7aa617d4-4041-969d-2a5d-8e9e71f5fce7"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"n", " ", "=", " ", "7"}], ",", " ", 
     RowBox[{"aa", " ", "=", " ", 
      RowBox[{"annihilation", "[", "7", "]"}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"aa", " ", ".", " ", 
      RowBox[{"ConjugateTranspose", "[", "aa", "]"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"ConjugateTranspose", "[", "aa", "]"}], " ", ".", " ", "aa"}]}],
     " ", "==", "\n", "  ", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "n", "]"}], " ", "-", " ", 
     RowBox[{"n", " ", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"n", ",", " ", "n"}], "}"}], " ", "->", " ", "1"}], "}"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}]}]}]}]}], "]"}]], "Input",\

 CellLabel->"In[67]:= ",
 CellID->1208764476,ExpressionUUID->"5e86e5c8-d785-1389-06bd-fc95e23061d3"],

Cell[TextData[{
 "It returns ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3582ea65-851b-2569-63b1-0c4f2caf8fb3"],
 ". Thus ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    SuperscriptBox[
     StyleBox["a", "TI"], "\[Dagger]"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e81d752-d9a7-cf7a-06be-cf1fd8539240"],
 " on all states below the boundary, with the required finite-dimensional \
correction on ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["n", "TI"], "-", "1"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dc17641-57cc-3497-1bff-682b627e9efd"],
 "; cutoff checks ensure that correction is dynamically irrelevant."
}], "Text",
 CellID->1584634344,ExpressionUUID->"647a9320-5a37-336f-0c19-0a8a5fc381b5"],

Cell[TextData[{
 "The ",
 StyleBox["coherent state",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Alpha]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57b40e76-1aa6-da65-7d4b-a0309f50a94f"],
 " (the most classical state, an eigenstate of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "575b10e3-003a-b957-7d78-89cdb1cc0bbd"],
 ") is the Fock-space sum"
}], "Text",
 CellID->35679398,ExpressionUUID->"7c7345dd-208f-a284-2401-5c87513bf0ee"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Alpha]", "TI"]},
    "Ket"], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SuperscriptBox[GridBox[{
         {
          StyleBox["\[Alpha]", "TI"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "/", "2"}]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["n", "TI"], "=", "0"}], "\[Infinity]",
      LimitsPositioning->False], 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["n", "TI"]], 
       SqrtBox[
        RowBox[{
         StyleBox["n", "TI"], "!"}]]], 
      RowBox[{
       TemplateBox[{
         StyleBox["n", "TI"]},
        "Ket"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1113372800,ExpressionUUID->"0121a537-2575-8479-30de-3d714c01ef43"],

Cell[TextData[{
 "Build it on the coefficients ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["n", "TI"]], "/", 
   SqrtBox[
    RowBox[{
     StyleBox["n", "TI"], "!"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f325126-465a-e19d-26c2-488073ecb3e7"],
 " through the highest retained level, normalized in the truncated basis \
(that finite-sum normalization replaces the infinite-series prefactor ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    SuperscriptBox[GridBox[{
       {
        StyleBox["\[Alpha]", "TI"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "/", "2"}]]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "739af998-c5c1-31b3-21b9-f0c5ec758399"],
 "):"
}], "Text",
 CellID->969867355,ExpressionUUID->"003becda-d908-4451-31d8-0587d8bd2ebb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"coherentState", "[", 
    RowBox[{"n_", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", " ", "=", " ", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"a", "^", "k"}], "/", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"k", "!"}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", 
             RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ",", " ", 
         "1"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"v", "/", 
      RowBox[{"Norm", "[", "v", "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[68]:= ",
 CellID->1210037699,ExpressionUUID->"7aeb468a-2cc6-59e2-2ae9-5fd445732bc8"],

Cell[TextData[{
 "The ",
 StyleBox["displacement operator",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["D", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Alpha]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["\[Alpha]", "TI"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], "-", 
     SuperscriptBox[
      StyleBox["\[Alpha]", "TI"], "*"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3873a668-04d7-31ac-6800-3832ad6383f6"],
 ", which shifts the vacuum to ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Alpha]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4156c81a-8a68-59d7-776d-e2442f1d2b3d"],
 ":"
}], "Text",
 CellID->1239892393,ExpressionUUID->"569e7ab4-00f8-e339-7ea6-73feb172ce03"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"displacement", "[", 
    RowBox[{"n_", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"a", " ", 
      RowBox[{"creation", "[", "n", "]"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"Conjugate", "[", "a", "]"}], " ", 
      RowBox[{"annihilation", "[", "n", "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[69]:= ",
 CellID->1498748757,ExpressionUUID->"0b3ec616-de69-0141-3ac5-d853db1c53ab"],

Cell[TextData[{
 "The ",
 StyleBox["Wigner function",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c0d57bf-7ae8-3253-2433-4ef97e8280b9"],
 " pictures a state on the phase-space plane: positive where the state is \
concentrated and, for a nonclassical state, negative in places. In the \
canonical ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aaecb0d-dff0-cd78-3a55-e356d98a9442"],
 " normalization its displaced-parity definition, with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[CapitalPi]", "TI"], "^"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "\[Pi]", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fe4a286-576e-fd11-759b-3be06218c47b"],
 " the photon-number parity operator, is"
}], "Text",
 CellID->1701544389,ExpressionUUID->"07179650-9fbb-2bc1-2d2c-081a1a4e792b"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["W", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox["1", "\[Pi]"], "\[ThinSpace]", 
    StyleBox["Tr",
     FontSlant->"Plain"], "[", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox[
       StyleBox["D", "TI"], "^"], "\[Dagger]"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Alpha]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"], 
     OverscriptBox[
      StyleBox["D", "TI"], "^"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Alpha]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["\[CapitalPi]", "TI"], "^"]}], "]"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       StyleBox["x", "TI"], "+", 
       StyleBox["i", "TI"], 
       StyleBox["p", "TI"]}], 
      SqrtBox["2"]], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1682415361,ExpressionUUID->"7aecd320-e31f-2936-2a93-ca8d96aa781c"],

Cell[TextData[{
 "A word on the coordinate convention, kept fixed for every phase-space \
picture below. The axes ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "326b0854-5043-0b63-6268-a21e61f65649"],
 " and ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d6edc53-4ce5-e0f2-4b15-d61d6491b2d8"],
 " are the dimensionless quadratures ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45f7e4e6-4e1c-a184-738c-fdc06baef3ee"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "-", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], 
    SqrtBox["2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70e98525-204e-6ba4-2096-1c8f51fb398e"],
 " (so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "704169dd-a4db-5005-207e-8086cd6e236f"],
 " and the vacuum ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b2d1c14-5aff-cd5f-2ad2-965e5e8b97a5"],
 " has variances ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["xx",
     FontSlant->"Plain"]], "=", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["pp",
     FontSlant->"Plain"]], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62ac11c1-6d0b-a8c0-1253-88ab04bffa2a"],
 "), and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], "+", 
    StyleBox["i", "TI"], 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e7621e1-2fba-a33a-560d-b8cb4a4c0e00"],
 " is the complex amplitude. The prefactor ",
 Cell[BoxData[
  RowBox[{"1", "/", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15938457-0322-a4d9-43a0-1e11b6d40e23"],
 " is the textbook normalization on these axes, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   StyleBox["W", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["p", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f1ed2e3-b722-4b37-2525-cbccc2d7161d"],
 ", so the vacuum is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "\[Pi]"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["x", "TI"], "2"], "-", 
     SuperscriptBox[
      StyleBox["p", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52e63e44-9d5c-26a1-029d-b02e14ee8c8b"],
 "."
}], "Text",
 CellID->1697357464,ExpressionUUID->"6e766a94-5ec6-6187-160d-83de5b7333ed"],

Cell[TextData[{
 "Rather than exponentiate the displacement operator at every grid point, \
evaluate this trace directly in the truncated Fock basis, writing ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eead67c-41e5-1519-56e9-c82677907c63"],
 " for the cutoff: ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23a655ec-dad2-e192-515e-4cc9df64b3f8"],
 " is then the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[Times]", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62ef85cc-c62f-39ac-1294-1ca9f3db8bf6"],
 " matrix on the states ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0"},
    "Ket"], ",", "\[Ellipsis]", ",", 
   TemplateBox[{
     RowBox[{
       StyleBox["n", "TI"], "-", "1"}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6c313b-6800-4a9b-2b13-a96509b518e1"],
 ", and every sum below runs over its ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75dfb56b-bb47-a02b-23e4-2d353ef3f371"],
 " superdiagonals ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[ScriptL]", "=", "0"}], ",", "\[Ellipsis]", ",", 
   RowBox[{
    StyleBox["n", "TI"], "-", "1"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57533ce7-69d6-be0e-7d60-b5c108600554"],
 ". Define"
}], "Text",
 CellID->1540797058,ExpressionUUID->"27c3fefb-2ee6-8038-4df0-f7a54a90d302"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["z", "TI"], "=", "2", 
    StyleBox["\[Alpha]", "TI"], "=", 
    SqrtBox["2"], 
    StyleBox["(",
     SpanMaxSize->1], 
