   RowBox[{
    StyleBox["d", "TI"], 
    TemplateBox[{
      OverscriptBox[
       StyleBox["\[Psi]", "TI"], "~"]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
