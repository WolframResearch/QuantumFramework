       RowBox[{"timesCool", ",", " ", 
        RowBox[{"coolRec", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
     " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"timesCool", ",", " ", 
