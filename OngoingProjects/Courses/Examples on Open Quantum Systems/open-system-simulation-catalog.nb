   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<small phase shift\>\"", ",", 
      " ", "\"\<large phase shift\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<delay before the second atom reads\>\"", ",", 
      " ", "\"\<surviving coherence\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<cat coherence decays faster for a larger phase shift\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[115]:=",
 CellID->971430162,ExpressionUUID->"43090fa7-5002-8b65-7136-a60161b4d64f"],

Cell[TextData[{
 "Both fall, but the large-",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d6689b0-bbf9-a698-3b1d-20fa3d8d0ce2"],
 " curve plunges: the separation-squared decoherence law, the separation now \
set by the atom's phase shift."
}], "Text",
 CellID->411794565,ExpressionUUID->"4ac87485-b214-a6e0-7ac8-6deec7a60cca"],

Cell[TextData[{
 "That trace distance is the theorist's coherence. The experiment reads it \
out with a ",
 StyleBox["second atom", "TI"],
 ", and that two-atom correlation is what the section is named for. Send a \
second probe (in ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e1d4b5-6b25-2976-7e9e-cdff0ed0785c"],
 ", Ramsey'd) through the decohered field, close its Ramsey, and read its \
excited chance; the correlation is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", 
   StyleBox["p", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], "2"], 
    StyleBox["|",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["e", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["p", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["e", "TI"], "2"], 
    StyleBox["|",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["g", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e41722a-1026-02f0-567f-7474a1d350da"],
 ", the second atom's excited probability conditioned on the first atom's two \
outcomes. The probe's excited chance on a given field ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aacec8a-85e6-bbaa-1a53-05d4339009f0"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   TemplateBox[{
     StyleBox["e", "TI"]},
    "Bra"], 
   StyleBox["V", "TI"], 
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     RowBox[{
      TemplateBox[{
        StyleBox["g", "TI"]},
       "Bra"], "\[CircleTimes]", 
      StyleBox["\[Rho]", "TI"]}]}], ")"}], 
   SuperscriptBox[
    StyleBox["V", "TI"], "\[Dagger]"], 
   TemplateBox[{
     StyleBox["e", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c51a735-fee5-6802-446e-3f7efa903b68"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], "=", 
   StyleBox["R", "TI"], "\[ThinSpace]", 
   StyleBox["D", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Phi]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e54a15d-ecde-9aa9-066b-39068568e8f3"],
 " the probe's own Ramsey-stamp-Ramsey, the ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27fb6428-ecec-27d4-4d99-7e75849e8d3e"],
 "-block trace reading its excited probability:"
}], "Text",
 CellID->211393631,ExpressionUUID->"51f5ca74-88a2-9d2c-078a-ec3e2954e476"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"probe", "[", 
    RowBox[{"\[Phi]_", ",", " ", "cav_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"U", " ", "=", " ", 
        RowBox[{"disperse", "[", "\[Phi]", "]"}]}], ",", " ", 
       RowBox[{"sig", " ", "=", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "cav"}], 
         "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s3", " ", "=", " ", 
         RowBox[{"ramsey", " ", ".", " ", 
          RowBox[{"(", 
           RowBox[{"U", " ", ".", " ", 
            RowBox[{"(", 
             RowBox[{"ramsey", " ", ".", " ", "sig", " ", ".", " ", 
              RowBox[{"ConjugateTranspose", "[", "ramsey", "]"}]}], ")"}], 
            " ", ".", " ", 
            RowBox[{"ConjugateTranspose", "[", "U", "]"}]}], ")"}], " ", ".", 
          " ", 
          RowBox[{"ConjugateTranspose", "[", "ramsey", "]"}]}]}], "}"}], ",", 
       "\n", "    ", 
       RowBox[{"Re", "@", 
        RowBox[{"Tr", "[", 
         RowBox[{"cavityGiven", "[", 
          RowBox[{"s3", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[116]:=",
 CellID->485898233,ExpressionUUID->"1154648e-ef0b-aa2b-476c-7deb8abff971"],

Cell[TextData[{
 "The correlation differences that probe on the two conditioned fields, each \
decohered for the delay, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["probe",
    FontSlant->"Plain"], 
