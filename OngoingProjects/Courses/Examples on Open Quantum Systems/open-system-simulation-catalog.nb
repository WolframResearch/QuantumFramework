Cell[TextData[{
 StyleBox["Quantum Kalman filter.",
  FontWeight->"Bold"],
 " With ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["r", "TI"], "^"], "=", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["x", "TI"], "^"], ",", 
      OverscriptBox[
       StyleBox["p", "TI"], "^"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["T", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4289b0c6-8043-1b93-72b6-29a031f669f9"],
 ","
}], "ItemNumbered",
 CellID->741634648,ExpressionUUID->"070f3e08-556d-9d60-2d34-b0525c19e44a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox["\[CapitalSigma]", "."], "=", 
    StyleBox["A", "TI"], "\[CapitalSigma]", "+", "\[CapitalSigma]", 
    SuperscriptBox[
     StyleBox["A", "TI"], 
     StyleBox["T", "TI"]], "+", 
    StyleBox["D", "TI"], "-", "\[CapitalSigma]", 
    SuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["T", "TI"]], 
    StyleBox["C", "TI"], "\[CapitalSigma]"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["r", "TI"], "_"], 
      StyleBox["c", "TI"]]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["A", "TI"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["r", "TI"], "_"], 
       StyleBox["c", "TI"]], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{"\[CapitalSigma]", 
      SuperscriptBox[
       StyleBox["C", "TI"], 
       StyleBox["T", "TI"]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["d", "TI"], 
        StyleBox["J", "TI"], "-", 
        StyleBox["C", "TI"], 
        SubscriptBox[
         OverscriptBox[
          StyleBox["r", "TI"], "_"], 
         StyleBox["c", "TI"]], "\[ThinSpace]", 
        StyleBox["d", "TI"], 
        StyleBox["t", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->359589406,ExpressionUUID->"6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["A", "TI"], "=", "(", GridBox[{
      {"0", "1"},
      {
       RowBox[{"-", "1"}], "0"}
     }], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["D", "TI"], "=", 
