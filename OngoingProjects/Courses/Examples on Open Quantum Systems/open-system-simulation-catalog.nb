Cell[TextData[{
 "    Equivalently, the deterministic measurement term is ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox[
    StyleBox["k", "TI"], "2"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], ",", 
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"]], ",", 
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], 
       StyleBox["c", "TI"]]}], 
     StyleBox["]",
      SpanMaxSize->1]}]}], 
   StyleBox["]",
    SpanMaxSize->1], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23ccc6ee-92c0-e596-51f3-dfc8277acffc"],
 ". This convention gives the Liouvillian pair ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["k", "TI"], "\[PlusMinus]", 
   StyleBox["i", "TI"], 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "-", 
     SuperscriptBox[
      StyleBox["k", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "114d8d02-b276-9c05-4772-256fc700e76f"],
 " and the exceptional point ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dc22b63-32d1-862f-5bf1-c34d4765ed75"],
 " used below."
}], "Text",
 CellID->1331866192,ExpressionUUID->"36ea7e2c-072a-2221-5eea-7076b2df710b"],

Cell[TextData[{
 StyleBox["Charge qubit monitored by a QPC.",
  FontWeight->"Bold"],
 " Since ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\|01d7d9", "-", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b23761c-2477-64e8-0ad1-68464d024e32"],
 ","
}], "ItemNumbered",
 CellID->1391655620,ExpressionUUID->"73216bcf-7cf1-61ac-22de-82a9748433f6"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "=", "-", 
    StyleBox["i", "TI"], "[", 
    RowBox[{
     RowBox[{
      FractionBox["\[CapitalOmega]", "2"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["x", "TI"]]}], ",", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["c", "TI"]]}], "]", " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    FractionBox[
     StyleBox["\[Kappa]", "TI"], "4"], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    FractionBox[
     SqrtBox[
      StyleBox["\[Kappa]", "TI"]], "2"], "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], " ", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox[
     RowBox[{"d", "J"}], "TI"], "=", 
    RowBox[{
     RowBox[{
      SqrtBox[
       StyleBox["\[Kappa]", "TI"]], " ", 
      SubscriptBox[
       RowBox[{
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        SubscriptBox[
         OverscriptBox[
          StyleBox["\[Sigma]", "TI"], "^"], 
         StyleBox["z", "TI"]], 
        StyleBox["\[RightAngleBracket]",
         SpanMaxSize->1]}], 
       StyleBox["c", "TI"]], " ", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{
      StyleBox["d", "TI"], 
      RowBox[{
       StyleBox["W", "TI"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->861714746,ExpressionUUID->"69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],

Cell[TextData[{
 "    Dropping the innovation term gives the unconditional equation ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CapitalOmega]", "/", "2"}], 
     StyleBox[")",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["x", "TI"]]}], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   StyleBox["\[Kappa]", "TI"], "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "409bca18-cbd6-e54d-70b8-ec45ee60cf97"],
 "."
}], "Text",
 CellID->1192942815,ExpressionUUID->"10b62b5f-1d3f-f012-404d-c31994cbc378"],

