Cell[TextData[{
 "In other words, the recurrence computes the radial function ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], "\[ScriptL]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"],
 " for one diagonal of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "138e1639-4d05-8b97-41b5-886364b1d9fd"],
 "; the powers ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["z", "TI"], "\[ScriptL]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "156728ce-0023-e03b-431c-c1a8b1d7b301"],
 " supply the angular dependence, and the Gaussian ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["b", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"],
 " supplies the envelope. Build the whole evaluation as one function: the \
Laguerre recurrence lives inside as a local helper, the input may be a state \
vector or a density matrix (a vector becomes its density matrix first), the \
cutoff is read off the input's size, and the grid, exact for the truncated \
state so the frame's far corners stay clean, is returned as an interpolating \
function of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26ff5c08-e081-ff27-4e85-56559135c20d"],
 ":"
}], "Text",
 CellID->561487989,ExpressionUUID->"07c988c4-3ef2-8066-2df6-21aeba84d34c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"wignerRepresentation", "[", 
    RowBox[{
     RowBox[{"psi_", "?", "VectorQ"}], ",", " ", "reach_", ",", " ", "pts_"}],
     "]"}], " ", ":=", " ", 
   RowBox[{"wignerRepresentation", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "psi", "]"}], ",", " ", "reach", ",", " ", 
     "pts"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wignerRepresentation", "[", 
    RowBox[{
     RowBox[{"rho_", "?", "MatrixQ"}], ",", " ", "reach_", ",", " ", "pts_"}],
     "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Length", "[", "rho", "]"}]}], ",", " ", "grid", ",", " ", 
       "a2", ",", " ", "b", ",", " ", "lag", ",", " ", "w"}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"grid", " ", "=", " ", 
       RowBox[{"N", "@", 
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"-", "reach"}], ",", " ", "reach", ",", " ", 
          RowBox[{"pts", " ", "-", " ", "1"}]}], "]"}]}]}], ";", "\n", "   ", 
      
      RowBox[{"a2", " ", "=", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "2.", "]"}], " ", 
        RowBox[{"Outer", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#2", " ", "+", " ", 
            RowBox[{"I", " ", "#1"}]}], " ", "&"}], ",", " ", "grid", ",", 
          " ", "grid"}], "]"}]}]}], ";", " ", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{
        RowBox[{"Abs", "[", "a2", "]"}], "^", "2"}]}], ";", "\n", "   ", 
      RowBox[{
       RowBox[{"lag", "[", 
        RowBox[{"L_", ",", " ", "c_"}], "]"}], " ", ":=", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", " ", "=", " ", 
           RowBox[{"Length", "[", "c", "]"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"Which", "[", "\n", "      ", 
          RowBox[{
           RowBox[{"m", " ", "==", " ", "1"}], ",", " ", 
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
            RowBox[{"0.", " ", "b"}]}], ",", "\n", "      ", 
           RowBox[{"m", " ", "==", " ", "2"}], ",", " ", 
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"c", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"1.", "/", 
               RowBox[{"(", 
                RowBox[{"L", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"L", " ", "+", " ", "1.", " ", "-", " ", "b"}], 
              ")"}]}]}], ",", "\n", "      ", "True", ",", " ", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"yy", " ", "=", " ", 
               RowBox[{"Fold", "[", 
                RowBox[{
                 RowBox[{"Function", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"y", ",", " ", "cj"}], "}"}], ",", " ", 
                   RowBox[{"With", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"j", " ", "=", " ", 
                    RowBox[{"cj", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "\n", 
                    "           ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"cj", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
                    RowBox[{
                    RowBox[{"y", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"j", " ", "-", " ", "1."}], ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"L", " ", "+", " ", "j", " ", "-", " ", "1."}], 
                    ")"}]}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"L", " ", "+", " ", "j"}], ")"}], " ", "j"}], 
                    ")"}]}], "]"}]}]}], ",", "\n", "            ", 
                    RowBox[{
                    RowBox[{"y", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
                    RowBox[{
                    RowBox[{"y", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"L", " ", "+", " ", 
                    RowBox[{"2.", " ", "j"}], " ", "-", " ", "1", " ", "-", 
                    " ", "b"}], ")"}], " ", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"1.", "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"L", " ", "+", " ", "j"}], ")"}], " ", "j"}], 
                    ")"}]}], "]"}]}]}]}], "}"}]}], "]"}]}], "]"}], ",", "\n", 
                 "         ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "2"}], "]"}], "]"}], " ", "+", " ", 
                    RowBox[{"0.", " ", "b"}]}], ",", " ", 
                   RowBox[{
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "1"}], "]"}], "]"}], " ", "+", " ", 
                    RowBox[{"0.", " ", "b"}]}]}], "}"}], ",", " ", 
                 RowBox[{"Transpose", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Reverse", "[", 
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", " ", 
                    RowBox[{"-", "3"}]}], "]"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"N", "@", 
                    RowBox[{"Range", "[", 
                    RowBox[{
                    RowBox[{"m", " ", "-", " ", "1"}], ",", " ", "2", ",", 
                    " ", 
                    RowBox[{"-", "1"}]}], "]"}]}]}], "}"}], "]"}]}], "]"}]}], 
              "}"}], ",", "\n", "        ", 
             RowBox[{
              RowBox[{"yy", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"yy", "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"1.", "/", 
                 RowBox[{"(", 
                  RowBox[{"L", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", 
               RowBox[{"(", 
                RowBox[{"L", " ", "+", " ", "1.", " ", "-", " ", "b"}], 
                ")"}]}]}]}], "]"}]}], "]"}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"w", " ", "=", " ", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"Fold", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"lag", "[", 
              RowBox[{
               RowBox[{"#2", " ", "-", " ", "1"}], ",", " ", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"#2", " ", "==", " ", "1"}], ",", " ", "1", ",", 
                  " ", "2"}], "]"}], " ", 
                RowBox[{"Diagonal", "[", 
                 RowBox[{"rho", ",", " ", 
                  RowBox[{"#2", " ", "-", " ", "1"}]}], "]"}]}]}], "]"}], " ",
              "+", " ", 
             RowBox[{"#1", " ", 
              RowBox[{"a2", "/", 
               RowBox[{"Sqrt", "[", "#2", "]"}]}]}]}], " ", "&"}], ",", "\n", 
           "       ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"2.", " ", 
              RowBox[{"rho", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", " ", 
                 RowBox[{"-", "1"}]}], "]"}], "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"pts", ",", " ", "pts"}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{"n", " ", "-", " ", "1"}], ",", " ", "1", ",", " ", 
             RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "b"}], "/", "2"}], "]"}], "/", "Pi"}]}]}], ";", "\n", 
      "   ", 
      RowBox[{"ListInterpolation", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", "w", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}]}], "}"}]}], 
       "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[62]:= ",
 CellID->2021628840,ExpressionUUID->"4bc0a2f3-6150-447f-79ff-3bbd10e52f45"],

Cell[TextData[{
 "Check it on the vacuum, whose Wigner function is the closed form ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "\[Pi]"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["x", "TI"], "2"], "-", 
     SuperscriptBox[
      StyleBox["p", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ac66077-3bfa-1f18-2afe-7a31bd8f6262"],
 ", feeding the state vector directly:"
}], "Text",
 CellID->41425461,ExpressionUUID->"3d863d84-94ab-5643-6bbd-b4ee1d5e3ca9"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"w", " ", "=", " ", 
     RowBox[{"wignerRepresentation", "[", 
      RowBox[{
       RowBox[{"coherentState", "[", 
        RowBox[{"8", ",", " ", "0"}], "]"}], ",", " ", "3.", ",", " ", "25"}],
       "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Max", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"w", "[", 
         RowBox[{"xx", ",", " ", "pp"}], "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "Pi"}], ")"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"xx", "^", "2"}]}], " ", "-", " ", 
           RowBox[{"pp", "^", "2"}]}], "]"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"xx", ",", " ", 
        RowBox[{"-", "2"}], ",", " ", "2", ",", " ", "0.5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"pp", ",", " ", 
        RowBox[{"-", "2"}], ",", " ", "2", ",", " ", "0.5"}], "}"}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[63]:= ",
 CellID->1208764476,ExpressionUUID->"7ab8b877-e011-189c-2a47-323091a46ae6"],

Cell["\<\
They agree to rounding on the grid's own points; between points the \
interpolation is accurate to the grid's resolution.\
\>", "Text",
 CellID->1584634344,ExpressionUUID->"35eb0178-2238-e094-63e8-992257b2b2fe"],

Cell[TextData[{
 "Wigner pictures are compared, across times or across states, and the \
comparison is only honest on one shared color scale. The plotter takes a list \
of Wigner interpolating functions and a label per member, finds the largest \
",
 Cell[BoxData[GridBox[{
    {
     StyleBox["W", "TI"]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da6433d-a7a4-ba24-3b5e-5b66d256090e"],
 " over the whole list, and draws every panel and the bar legend with the \
same diverging map: a light neutral at zero so empty phase space reads as \
empty, warm (orange) for positive, cold (blue) for negative, with the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "462f64f6-435d-c7dd-6fd5-7db076e9ad27"],
 " contour drawn as a thin gray line so the sign change is unmistakable. An \
optional color map replaces the default; it receives the signed fraction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], "/", 
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", GridBox[{
     {
      StyleBox["W", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b06bf63-5f43-ed7c-793d-374d5af7b446"],
 " in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", "1"}], ",", "1"}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fd1c247-21a4-d962-35ee-e4215056a848"],
 ":"
}], "Text",
 CellID->35679398,ExpressionUUID->"09347675-9fce-c17b-38cc-683f1a789041"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "wignerPlot", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wignerPlot", "[", 
    RowBox[{
     RowBox[{"ws", " ", ":", " ", 
      RowBox[{"{", "__InterpolatingFunction", "}"}]}], ",", " ", 
     "labels_List", ",", " ", 
     RowBox[{"color_", " ", ":", " ", "Automatic"}]}], "]"}], " ", ":=", "\n",
    "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#", "[", "\"\<ValuesOnGrid\>\"", "]"}], "]"}], " ", 
           "&"}], " ", "/@", " ", "ws"}], "]"}]}], ",", " ", 
       RowBox[{"reach", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"ws", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<Domain\>\"", "]"}], 
          "]"}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"cf", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"color", " ", "===", " ", "Automatic"}], ",", "\n", 
          "      ", 
          RowBox[{
           RowBox[{"Blend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", " ", 
                 RowBox[{"RGBColor", "[", 
                  RowBox[{"0.15", ",", " ", "0.4", ",", " ", "0.8"}], "]"}]}],
                 "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"0", ",", " ", 
                 RowBox[{"GrayLevel", "[", "0.97", "]"}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"1", ",", " ", 
                 RowBox[{"RGBColor", "[", 
                  RowBox[{"0.9", ",", " ", "0.45", ",", " ", "0.1"}], "]"}]}],
                 "}"}]}], "}"}], ",", " ", "#"}], "]"}], " ", "&"}], ",", " ",
           "color"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"raw", " ", "=", " ", 
         RowBox[{
          RowBox[{"cf", "[", 
           RowBox[{"#", "/", "m"}], "]"}], " ", "&"}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"Legended", "[", 
        RowBox[{
         RowBox[{"GraphicsRow", "[", 
          RowBox[{"MapThread", "[", "\n", "       ", 
           RowBox[{
            RowBox[{
             RowBox[{"Show", "[", 
              RowBox[{
               RowBox[{"DensityPlot", "[", 
                RowBox[{
                 RowBox[{"#1", "[", 
                  RowBox[{"xx", ",", " ", "pp"}], "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"xx", ",", " ", 
                   RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{"pp", ",", " ", 
                   RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}], ",", 
                 " ", 
                 RowBox[{"PlotPoints", " ", "->", " ", "55"}], ",", "\n", 
                 "          ", 
                 RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
                 RowBox[{"ColorFunction", " ", "->", " ", "raw"}], ",", " ", 
                 RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",",
                  "\n", "          ", 
                 RowBox[{"FrameLabel", " ", "->", " ", 
                  RowBox[{"{", 
                   RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",",
                  " ", 
                 RowBox[{"PlotLabel", " ", "->", " ", "#2"}]}], "]"}], ",", 
               "\n", "         ", 
               RowBox[{"ContourPlot", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#1", "[", 
                   RowBox[{"xx", ",", " ", "pp"}], "]"}], " ", "==", " ", 
                  "0"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"xx", ",", " ", 
                   RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{"pp", ",", " ", 
                   RowBox[{"-", "reach"}], ",", " ", "reach"}], "}"}], ",", 
                 "\n", "          ", 
                 RowBox[{"ContourStyle", " ", "->", " ", 
                  RowBox[{"Directive", "[", 
                   RowBox[{"Thin", ",", " ", "Gray"}], "]"}]}], ",", " ", 
                 RowBox[{"PlotPoints", " ", "->", " ", "40"}]}], "]"}]}], 
              "]"}], " ", "&"}], ",", "\n", "       ", 
            RowBox[{"{", 
             RowBox[{"ws", ",", " ", "labels"}], "}"}]}], "]"}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"BarLegend", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"raw", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "m"}], ",", " ", "m"}], "}"}]}], "}"}], ",", " ", 
           
           RowBox[{"LegendMarkerSize", " ", "->", " ", "130"}]}], "]"}]}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wignerPlot", "[", 
    RowBox[{"w_InterpolatingFunction", ",", " ", "label_", ",", " ", 
     RowBox[{"color_", " ", ":", " ", "Automatic"}]}], "]"}], " ", ":=", " ", 
   
   RowBox[{"wignerPlot", "[", 
    RowBox[{
     RowBox[{"{", "w", "}"}], ",", " ", 
     RowBox[{"{", "label", "}"}], ",", " ", "color"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[64]:= ",
 CellID->1113372800,ExpressionUUID->"2c597ed5-00d9-d535-5467-779fb16dbc1f"],

Cell["A Cavity Cat, and Why It Decoheres Almost at Once", "Subsection",
 CellID->969867355,ExpressionUUID->"66c4d8d6-27c8-a0db-0efb-d1905262f221"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A single leaky mode of light (a cavity dribbling photons), with no drive:"
}], "Text",
 CellID->1210037699,ExpressionUUID->"4d3801b6-8b23-0df3-74c7-98f02ed657d9"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", 
    StyleBox["\[Gamma]", "TI"], " ", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1239892393,ExpressionUUID->"09816d05-11e9-fb6e-3fbe-856fa79dc9b4"],

Cell[TextData[{
 "A lone coherent state only shrinks, staying pure, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Alpha]", "TI"]},
    "Ket"], "\[Rule]", 
   TemplateBox[{
     RowBox[{
       StyleBox["\[Alpha]", "TI"], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
          StyleBox["\[Gamma]", "TI"], 
          StyleBox["t", "TI"], "/", "2"}]]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35ec423d-cde2-7917-6394-6466eb97487d"],
 ", but a ",
 StyleBox["cat", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Alpha]", "TI"]},
    "Ket"], "+", 
   TemplateBox[{
     StyleBox["\[Beta]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05e0e9bc-56b1-1bf2-339f-00e6634469d8"],
 " of two well-separated amplitudes keeps its cross-term only through a \
coherence factor"
}], "Text",
 CellID->1498748757,ExpressionUUID->"46408f14-a324-388b-6e7f-2751d6d68ad1"],

Cell[BoxData[
 PaneBox[
  RowBox[{GridBox[{
     {
      RowBox[{
       StyleBox["C", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", 
   StyleBox["exp",
    FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", 
   StyleBox["[",
    FontSize->1.2 Inherited], "-", 
   FractionBox["1", "2"], " ", 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        StyleBox["\[Alpha]", "TI"], "-", 
        StyleBox["\[Beta]", "TI"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["\[Gamma]", "TI"], 
      StyleBox["t", "TI"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["]",
    FontSize->1.2 Inherited], "\[ThickSpace]", "\[TildeTilde]", 
   "\[ThickSpace]", 
   StyleBox["exp",
    FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", 
   StyleBox["(",
    FontSize->1.2 Inherited], "-", 
   FractionBox["1", "2"], " ", 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        StyleBox["\[Alpha]", "TI"], "-", 
        StyleBox["\[Beta]", "TI"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], " ", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    FontSize->1.2 Inherited], " ", 
   StyleBox[
    RowBox[{
     RowBox[{
     "at", "\[NonBreakingSpace]", "short", "\[NonBreakingSpace]", "time"}], ",",
      "\[ThinSpace]"}],
    FontSlant->"Plain"]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1701544389,ExpressionUUID->"40213c85-9219-7c2b-71de-b5ef27ac4771"],

Cell[TextData[{
 "so the coherence decays at a rate ",
 Cell[BoxData[
  RowBox[{"\[Proportional]", 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        StyleBox["\[Alpha]", "TI"], "-", 
        StyleBox["\[Beta]", "TI"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "678faed4-2cca-f411-0db4-479e457cdf7b"],
 ", quadratic in the phase-space separation. Build it in a truncated Fock \
basis and watch the fringes vanish."
}], "Text",
 CellID->1682415361,ExpressionUUID->"3b3cac94-919f-f08d-6ac3-45de202bc2d7"],

Cell["Set a high cutoff and a cavity decay rate:", "Text",
 CellID->1697357464,ExpressionUUID->"634a1270-2707-566e-1149-943a52b23cb4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"topCat", " ", "=", " ", "30"}], ";", " ", 
  RowBox[{"blankCat", " ", "=", " ", 
   RowBox[{"IdentityMatrix", "[", "topCat", "]"}]}], ";", " ", 
  RowBox[{"downCat", " ", "=", " ", 
   RowBox[{"annihilation", "[", "topCat", "]"}]}], ";", " ", 
  RowBox[{"\[Gamma]cat", " ", "=", " ", "0.7"}], ";"}]], "Input",
 CellLabel->"In[65]:= ",
 CellID->1540797058,ExpressionUUID->"571f0194-b08e-3ab4-7d24-98d1c138889e"],

Cell[TextData[{
 "First a single coherent state: under damping it stays coherent, its \
amplitude decaying as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[Rule]", 
   StyleBox["\[Alpha]", "TI"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79764466-e076-5945-2f0e-5e4391032baf"],
 ". Check that the damped state equals a fresh, smaller coherent state:"
}], "Text",
 CellID->768596373,ExpressionUUID->"54e8dec7-14b1-519a-7c97-d7a19d4423e0"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"later", " ", "=", " ", 
     RowBox[{"evolve", "[", 
      RowBox[{
       RowBox[{"0", " ", "blankCat"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], "}"}], ",",
        " ", 
       RowBox[{"densityMatrix", "[", 
        RowBox[{"coherentState", "[", 
         RowBox[{"topCat", ",", " ", "2."}], "]"}], "]"}], ",", " ", "1.0"}], 
      "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"Conjugate", "[", 
      RowBox[{"coherentState", "[", 
       RowBox[{"topCat", ",", " ", 
        RowBox[{"2.", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Gamma]cat"}], "/", "2"}], "]"}]}]}], "]"}], "]"}], 
     " ", ".", " ", "later", " ", ".", " ", 
     RowBox[{"coherentState", "[", 
      RowBox[{"topCat", ",", " ", 
       RowBox[{"2.", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[Gamma]cat"}], "/", "2"}], "]"}]}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[66]:= ",
 CellID->1985169054,ExpressionUUID->"25f5c72f-3423-741a-538a-de89bdd65f60"],

Cell["Overlap one: a coherent state stays coherent.", "Text",
 CellID->770675313,ExpressionUUID->"6dbbd446-5835-e39a-1b58-ce2059c1b1e0"],

Cell[TextData[{
 "Now the interesting state, a ",
 StyleBox["cat",
  FontWeight->"Bold"],
 ", the superposition of two coherent states ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Alpha]", "TI"]},
    "Ket"], "+", 
   TemplateBox[{
     RowBox[{"-", 
       StyleBox["\[Alpha]", "TI"]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d34e655-b983-17e8-14cb-f81f38367d32"],
 ":"
}], "Text",
 CellID->846554368,ExpressionUUID->"5c435daa-0d1c-c5df-0471-54f4a4aeaf25"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Alpha]", " ", "=", " ", "2."}], ";", " ", 
  RowBox[{"cat", " ", "=", " ", 
   RowBox[{"Normalize", "[", 
    RowBox[{
     RowBox[{"coherentState", "[", 
      RowBox[{"topCat", ",", " ", "\[Alpha]"}], "]"}], " ", "+", " ", 
     RowBox[{"coherentState", "[", 
      RowBox[{"topCat", ",", " ", 
       RowBox[{"-", "\[Alpha]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[67]:= ",
 CellID->1952818843,ExpressionUUID->"21714cd0-c04e-e57a-570f-659df1f8cc40"],

Cell[TextData[{
 "First a rigorous check on the solver. Amplitude damping has an exact \
operator-sum (Kraus) solution, summed over the number of photons lost ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74ff421b-073b-c6d4-1c85-6445b2cfac3e"],
 ","
}], "Text",
 CellID->599175116,ExpressionUUID->"3ebc3a74-dd7c-3fa6-6643-bc31d40e858c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["\[Rho]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["m", "TI"], "\[GreaterEqual]", "0"}],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["m", "TI"]], " ", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], "0"], " ", 
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["m", "TI"], "\[Dagger]"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["m", "TI"]], "=", 
    RowBox[{
     SqrtBox[
      FractionBox[
       SuperscriptBox[
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{"1", "-", 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           RowBox[{"-", 
            StyleBox["\[Gamma]", "TI"], 
            StyleBox["t", "TI"]}]]}], 
         StyleBox[")",
          SpanMaxSize->1]}], 
        StyleBox["m", "TI"]], 
       RowBox[{
        StyleBox["m", "TI"], "!"}]]], "\[ThickSpace]", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["t", "TI"], " ", 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "\[Dagger]"], 
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "/", "2"}]], " ", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], 
      StyleBox["m", "TI"]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1234886004,ExpressionUUID->"7d5c93fe-a057-3a16-2b63-0abbd1e3897c"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "487dadd0-5ed6-7873-7802-449a5b634b59"],
 " removing ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5219761b-8a64-c9ff-0227-68452f169bc5"],
 " photons and ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["t", "TI"], " ", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69346765-6d1c-e9c9-18cc-7f4f04aebb13"],
 " shrinking the survivors; the set is trace-preserving, so it needs no \
renormalization. Write it:"
}], "Text",
 CellID->1955603644,ExpressionUUID->"7c22b8c2-70f4-0562-25d1-31ac00816c48"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"photonLoss", "[", 
    RowBox[{"rho0_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"shrink", " ", "=", " ", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Gamma]cat"}], " ", "t", " ", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"topCat", " ", "-", " ", "1"}]}], "]"}], "/", "2"}]}], 
          "]"}], "]"}]}], ",", " ", 
       RowBox[{"keep", " ", "=", " ", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Gamma]cat"}], " ", "t"}], "]"}]}]}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"M", " ", "=", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"keep", "^", 
              RowBox[{"(", 
               RowBox[{"m", "/", "2"}], ")"}]}], "/", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"m", "!"}], "]"}]}], " ", 
            RowBox[{"shrink", " ", ".", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"m", " ", "==", " ", "0"}], ",", " ", "blankCat", ",", 
               " ", 
               RowBox[{"MatrixPower", "[", 
                RowBox[{"downCat", ",", " ", "m"}], "]"}]}], "]"}]}]}]}], 
          "}"}], ",", "\n", "      ", 
         RowBox[{"M", " ", ".", " ", "rho0", " ", ".", " ", 
          RowBox[{"ConjugateTranspose", "[", "M", "]"}]}]}], "]"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", 
         RowBox[{"topCat", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[68]:= ",
 CellID->529524776,ExpressionUUID->"04fec585-b88c-469b-2c85-dcef39392ce1"],

Cell["\<\
Confirm the master equation and this Kraus sum agree on the cat:\
\>", "Text",
 CellID->186212144,ExpressionUUID->"7aa617d4-4041-969d-2a5d-8e9e71f5fce7"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "@", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"evolve", "[", 
      RowBox[{
       RowBox[{"0", " ", "blankCat"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], "}"}], ",",
        " ", 
       RowBox[{"densityMatrix", "[", "cat", "]"}], ",", " ", "0.6"}], "]"}], 
     " ", "-", " ", 
     RowBox[{"photonLoss", "[", 
      RowBox[{
       RowBox[{"densityMatrix", "[", "cat", "]"}], ",", " ", "0.6"}], "]"}]}],
     "]"}]}]}]], "Input",
 CellLabel->"In[69]:= ",
 CellID->284725946,ExpressionUUID->"5e86e5c8-d785-1389-06bd-fc95e23061d3"],

Cell["They agree to rounding.", "Text",
 CellID->1006536905,ExpressionUUID->"3582ea65-851b-2569-63b1-0c4f2caf8fb3"],

Cell["\<\
Now visualize the cat's decoherence. Build the Wigner film over a short \
window:\
\>", "Text",
 CellID->207506748,ExpressionUUID->"5e81d752-d9a7-cf7a-06be-cf1fd8539240"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"catTimes", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", ".4", ",", " ", ".1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"catFilm", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"wignerRepresentation", "[", 
      RowBox[{
       RowBox[{"evolve", "[", 
        RowBox[{
         RowBox[{"0", " ", "blankCat"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], "}"}],
          ",", " ", 
         RowBox[{"densityMatrix", "[", "cat", "]"}], ",", " ", "t"}], "]"}], ",",
        " ", "4.2", ",", " ", "55"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "catTimes"}], "}"}]}], "]"}]}], ";"}]}], "Input",\

 CellLabel->"In[70]:= ",
 CellID->1146295856,ExpressionUUID->"6dc17641-57cc-3497-1bff-682b627e9efd"],

Cell["Draw it on one shared color scale:", "Text",
 CellID->438365529,ExpressionUUID->"647a9320-5a37-336f-0c19-0a8a5fc381b5"],

Cell[BoxData[
 RowBox[{"wignerPlot", "[", 
  RowBox[{"catFilm", ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\"\<time \>\"", " ", "<>", " ", 
      RowBox[{"ToString", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
    "catTimes"}]}], "]"}]], "Input",
 CellLabel->"In[71]:= ",
 CellID->174000849,ExpressionUUID->"57b40e76-1aa6-da65-7d4b-a0309f50a94f"],

Cell["\<\
At first there are two Gaussian lobes (the two coherent states) with \
interference fringes between them: the fringes are the coherence, the \
off-diagonal cross-term. Across this short window the fringes fade fast while \
the lobes barely shrink: the cat is collapsing toward a classical mixture of \
the two coherent states while both are still nearly full size. Decoherence is \
far faster than energy loss.\
\>", "Text",
 CellID->766726627,ExpressionUUID->"575b10e3-003a-b957-7d78-89cdb1cc0bbd"],

Cell[TextData[{
 "How fast? The coherence ",
 Cell[BoxData[GridBox[{
    {
     RowBox[{
      StyleBox["C", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c7345dd-208f-a284-2401-5c87513bf0ee"],
 " is the closed-form envelope from the problem statement, and the master \
equation can be made to report the same quantity on its own. Evolve the cat \
once over the plotted span:"
}], "Text",
 CellID->1506609767,ExpressionUUID->"0121a537-2575-8479-30de-3d714c01ef43"],

Cell[BoxData[
 RowBox[{
  RowBox[{"catRun", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{"0", " ", "blankCat"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], "}"}], ",",
      " ", 
     RowBox[{"densityMatrix", "[", "cat", "]"}], ",", " ", "2."}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[72]:= ",
 CellID->281363281,ExpressionUUID->"7f325126-465a-e19d-26c2-488073ecb3e7"],

Cell["\<\
Under amplitude damping the state stays in the span of its two shrinking \
lobes,\
\>", "Text",
 CellID->1615544595,ExpressionUUID->"739af998-c5c1-31b3-21b9-f0c5ec758399"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["\[Rho]", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["p", "TI"], 
      RowBox[{
       StyleBox["(",
        FontSize->1.2 Inherited], 
       RowBox[{
        RowBox[{
         TemplateBox[{
           SubscriptBox[
            StyleBox["\[Alpha]", "TI"], 
            StyleBox["t", "TI"]]},
          "Ket"], 
         TemplateBox[{
           SubscriptBox[
            StyleBox["\[Alpha]", "TI"], 
            StyleBox["t", "TI"]]},
          "Bra"]}], "+", 
        RowBox[{
         TemplateBox[{
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["\[Alpha]", "TI"], 
              StyleBox["t", "TI"]]}]},
          "Ket"], 
         TemplateBox[{
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["\[Alpha]", "TI"], 
              StyleBox["t", "TI"]]}]},
          "Bra"]}]}], 
       StyleBox[")",
        FontSize->1.2 Inherited]}]}], "+", 
     RowBox[{
      StyleBox["c", "TI"], 
      RowBox[{
       StyleBox["(",
        FontSize->1.2 Inherited], 
       RowBox[{
        RowBox[{
         TemplateBox[{
           SubscriptBox[
            StyleBox["\[Alpha]", "TI"], 
            StyleBox["t", "TI"]]},
          "Ket"], 
         TemplateBox[{
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["\[Alpha]", "TI"], 
              StyleBox["t", "TI"]]}]},
          "Bra"]}], "+", 
        RowBox[{
         TemplateBox[{
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["\[Alpha]", "TI"], 
              StyleBox["t", "TI"]]}]},
          "Ket"], 
         TemplateBox[{
           SubscriptBox[
            StyleBox["\[Alpha]", "TI"], 
            StyleBox["t", "TI"]]},
          "Bra"]}]}], 
       StyleBox[")",
        FontSize->1.2 Inherited]}]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["t", "TI"]], "=", 
    RowBox[{
     StyleBox["\[Alpha]", "TI"], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["t", "TI"], "/", "2"}]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1805673747,ExpressionUUID->"003becda-d908-4451-31d8-0587d8bd2ebb"],

Cell[TextData[{
 "and the coherence is the weight ratio ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      RowBox[{
       StyleBox["C", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", 
   StyleBox["c", "TI"], "/", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aeb468a-2cc6-59e2-2ae9-5fd445732bc8"],
 ". The two lobes are not orthogonal (they overlap by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["o", "TI"], "=", 
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], 
      StyleBox["t", "TI"]], 
     RowBox[{"-", 
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["t", "TI"]]}]},
    "BraKet"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3873a668-04d7-31ac-6800-3832ad6383f6"],
 "), so read ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4156c81a-8a68-59d7-776d-e2442f1d2b3d"],
 " and ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e7ab4-00f8-e339-7ea6-73feb172ce03"],
 " off two matrix elements of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b3ec616-de69-0141-3ac5-d853db1c53ab"],
 " by undoing that overlap with a two-by-two linear solve:"
}], "Text",
 CellID->1547520620,ExpressionUUID->"7c0d57bf-7ae8-3253-2433-4ef97e8280b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"catCoherence", "[", 
    RowBox[{"t_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "va", ",", " ", "vb", ",", " ", "o", ",", " ", "m1", ",", " ", "m2", ",",
        " ", "p", ",", " ", "cc"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"va", " ", "=", " ", 
       RowBox[{"coherentState", "[", 
        RowBox[{"topCat", ",", " ", 
         RowBox[{"\[Alpha]", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Gamma]cat"}], " ", 
            RowBox[{"t", "/", "2"}]}], "]"}]}]}], "]"}]}], ";", " ", 
      RowBox[{"vb", " ", "=", " ", 
       RowBox[{"coherentState", "[", 
        RowBox[{"topCat", ",", " ", 
         RowBox[{
          RowBox[{"-", "\[Alpha]"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Gamma]cat"}], " ", 
            RowBox[{"t", "/", "2"}]}], "]"}]}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"o", " ", "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "va", "]"}], " ", ".", " ", "vb"}], 
        "]"}]}], ";", "\n", "   ", 
      RowBox[{"m1", " ", "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "va", "]"}], " ", ".", " ", 
         RowBox[{"catRun", "[", "t", "]"}], " ", ".", " ", "va"}], "]"}]}], ";",
       " ", 
      RowBox[{"m2", " ", "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "va", "]"}], " ", ".", " ", 
         RowBox[{"catRun", "[", "t", "]"}], " ", ".", " ", "vb"}], "]"}]}], ";",
       "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "cc"}], "}"}], " ", "=", " ", 
       RowBox[{"LinearSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", " ", "+", " ", 
              RowBox[{"o", "^", "2"}]}], ",", " ", 
             RowBox[{"2", " ", "o"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", " ", "o"}], ",", " ", 
             RowBox[{"1", " ", "+", " ", 
              RowBox[{"o", "^", "2"}]}]}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m1", ",", " ", "m2"}], "}"}]}], "]"}]}], ";", "\n", "   ", 
      
      RowBox[{"cc", "/", "p"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[73]:= ",
 CellID->858350929,ExpressionUUID->"0aaecb0d-dff0-cd78-3a55-e356d98a9442"],

Cell["\<\
Now visualize both, the closed-form envelope and the master-equation \
extraction, for our chosen separation:\
\>", "Text",
 CellID->2138894257,ExpressionUUID->"4fe4a286-576e-fd11-759b-3be06218c47b"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "2"}], " ", 
       RowBox[{"\[Alpha]", "^", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Gamma]cat"}], " ", "t"}], "]"}]}], ")"}]}], "]"}], 
     ",", " ", 
     RowBox[{"catCoherence", "[", "t", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "2"}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", "Dashed"}], "]"}]}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<closed form\>\"", ",", " ", "\"\<master equation\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<coherence |C(t)|\>\""}], "}"}]}], 
   ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "460"}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<master-equation coherence lies on the closed-form \
envelope\>\""}]}], "]"}]], "Input",
 CellLabel->"In[74]:= ",
 CellID->1941039383,ExpressionUUID->"07179650-9fbb-2bc1-2d2c-081a1a4e792b"],

Cell[TextData[{
 "The dashed master-equation extraction lies on the closed form: the envelope \
is not an approximation but the exact law of the simulated dynamics. The \
decoherence rate grows as the ",
 StyleBox["square", "TI"],
 " of the separation, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        StyleBox["\[Alpha]", "TI"], "-", 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"-", 
         StyleBox["\[Alpha]", "TI"]}], 
        StyleBox[")",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", "4", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Alpha]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aecd320-e31f-2936-2a93-ca8d96aa781c"],
 "."
}], "Text",
 CellID->1670620029,ExpressionUUID->"326b0854-5043-0b63-6268-a21e61f65649"],

Cell["\<\
Every Fock-space example truncates the infinite number-state ladder at a \
finite cutoff, so each needs a check that the cutoff is high enough not to \
change the answer. Recompute the mean photon number of a decaying coherent \
state at cutoffs 20, 30, and 40:\
\>", "Text",
 CellID->588214459,ExpressionUUID->"1d6edc53-4ce5-e0f2-4b15-d61d6491b2d8"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"observable", " ", "=", " ", 
     RowBox[{"Function", "[", 
      RowBox[{"nn", ",", " ", 
       RowBox[{"expectation", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"creation", "[", "nn", "]"}], " ", ".", " ", 
          RowBox[{"annihilation", "[", "nn", "]"}]}], ",", " ", 
         RowBox[{"evolve", "[", 
          RowBox[{
           RowBox[{"0", " ", 
            RowBox[{"IdentityMatrix", "[", "nn", "]"}]}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", 
             RowBox[{"annihilation", "[", "nn", "]"}]}], "}"}], ",", " ", 
           RowBox[{"densityMatrix", "[", 
            RowBox[{"coherentState", "[", 
             RowBox[{"nn", ",", " ", "2."}], "]"}], "]"}], ",", " ", "0.5"}], 
          "]"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"observable", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"20", ",", " ", "30", ",", " ", "40"}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[75]:= ",
 CellID->1759496502,ExpressionUUID->"45f7e4e6-4e1c-a184-738c-fdc06baef3ee"],

Cell["\<\
The three cutoffs give the same mean photon number, so the truncation is fine \
enough not to affect the answer: 20 already holds the whole state, and \
raising it changes nothing.\
\>", "Text",
 CellID->1641757231,ExpressionUUID->"70e98525-204e-6ba4-2096-1c8f51fb398e"],

Cell["Making a Cat With an Atom, and Reading Its Decoherence", "Subsection",
 CellID->896279625,ExpressionUUID->"704169dd-a4db-5005-207e-8086cd6e236f"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A ",
 StyleBox["far-detuned", "TI"],
 " atom, its transition frequency sitting far from the cavity's so it can \
trade no energy with the light and only turns its phase, imprints a \
state-dependent phase shift under"
}], "Text",
 CellID->1264190945,ExpressionUUID->"7b2d1c14-5aff-cd5f-2ad2-965e5e8b97a5"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["H", "TI"], "^"], 
     StyleBox["C", "TI"]], "=", 
    RowBox[{
     StyleBox["\[Chi]", "TI"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Ket"], "\[Rule]", 
    TemplateBox[{
      RowBox[{
        StyleBox["\[Alpha]", "TI"], 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"\[PlusMinus]", 
           StyleBox["i", "TI"], 
           StyleBox["\[Phi]", "TI"]}]]}]},
     "Ket"]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["\[Phi]", "TI"], "=", 
    RowBox[{
     StyleBox["\[Chi]", "TI"], 
     RowBox[{
      StyleBox["\[Tau]", "TI"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1806910998,ExpressionUUID->"62ac11c1-6d0b-a8c0-1253-88ab04bffa2a"],

Cell[TextData[{
 "An atom prepared in the equal superposition ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], "+", 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e7621e1-2fba-a33a-560d-b8cb4a4c0e00"],
 " therefore leaves the field in a two-phase ",
 StyleBox["cat",
  FontWeight->"Bold"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Alpha]", "TI"], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
          StyleBox["i", "TI"], 
          StyleBox["\[Phi]", "TI"]}]]}]},
    "Ket"], "+", 
   TemplateBox[{
     RowBox[{
       StyleBox["\[Alpha]", "TI"], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"+", 
          StyleBox["i", "TI"], 
          StyleBox["\[Phi]", "TI"]}]]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15938457-0322-a4d9-43a0-1e11b6d40e23"],
 ", entangled with the atom. After the cat decoheres for a delay (the leak of \
the last example), a second atom probes the same field, and the two-atom \
correlation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["p", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["e", "TI"], " ", 
       StyleBox["|",
        SpanMaxSize->1], " ", 
       StyleBox["e", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "-", 
    RowBox[{
     StyleBox["p", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["e", "TI"], " ", 
       StyleBox["|",
        SpanMaxSize->1], " ", 
       StyleBox["g", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f1ed2e3-b722-4b37-2525-cbccc2d7161d"],
 " (the second atom's chance of coming out excited when the first did, minus \
when the first came out in the ground state) is nonzero only while the field \
keeps its coherence, so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52e63e44-9d5c-26a1-029d-b02e14ee8c8b"],
 " tracks the surviving coherence ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e766a94-5ec6-6187-160d-83de5b7333ed"],
 " and falls to zero as the cat blurs into a mixture. This is the Haroche \
experiment; build the atom-made cat and measure how fast the correlation dies."
}], "Text",
 CellID->962064851,ExpressionUUID->"2eead67c-41e5-1519-56e9-c82677907c63"],

Cell[TextData[{
 "In plainer terms, the atom is a phase stamp, not an absorber: far off \
resonance it takes no photon from the field, it only rotates the field's \
phase by ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["\[Phi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23a655ec-dad2-e192-515e-4cc9df64b3f8"],
 " or ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["\[Phi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62ef85cc-c62f-39ac-1294-1ca9f3db8bf6"],
 " according to its state, so an atom in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], "+", 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6c313b-6800-4a9b-2b13-a96509b518e1"],
 " leaves the two phase-rotated fields superposed and entangled with it. One \
probe atom cannot reveal this coherence, since its own outcome averages over \
the two phases; only the correlation ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75dfb56b-bb47-a02b-23e4-2d353ef3f371"],
 " between two atoms reading the same field exposes it, and only while it \
survives. Set the cutoff and the cavity's decay rate:"
}], "Text",
 CellID->1660212291,ExpressionUUID->"57533ce7-69d6-be0e-7d60-b5c108600554"],

Cell[BoxData[
 RowBox[{
  RowBox[{"topHar", " ", "=", " ", "28"}], ";", " ", 
  RowBox[{"blankHar", " ", "=", " ", 
   RowBox[{"IdentityMatrix", "[", "topHar", "]"}]}], ";", " ", 
  RowBox[{"downHar", " ", "=", " ", 
   RowBox[{"annihilation", "[", "topHar", "]"}]}], ";", " ", 
  RowBox[{"\[Gamma]har", " ", "=", " ", "0.5"}], ";"}]], "Input",
 CellLabel->"In[76]:= ",
 CellID->1553450743,ExpressionUUID->"27c3fefb-2ee6-8038-4df0-f7a54a90d302"],

Cell[TextData[{
 "The ",
 StyleBox["trace distance",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["Tr",
    FontSlant->"Plain"], GridBox[{
     {
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "1"], "-", 
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "2"]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60d4995f-bb7f-b80c-10eb-11193e0b0b56"],
 " will measure how far the cat sits from a classical mixture:"
}], "Text",
 CellID->376345483,ExpressionUUID->"64608bbe-760c-8af3-0c1f-22f803bed8d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"traceDistance", "[", 
    RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"SingularValueList", "[", 
      RowBox[{"a", " ", "-", " ", "b"}], "]"}], "]"}], "/", "2"}]}], 
  ";"}]], "Input",
 CellLabel->"In[77]:= ",
 CellID->1917523023,ExpressionUUID->"09661063-a2cf-675e-3f1d-8a4cd77a4da4"],

Cell[TextData[{
 "Because the singular values of any matrix sum to its trace norm, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Total", "[", 
    RowBox[{"SingularValueList", "[", 
     RowBox[{"a", " ", "-", " ", "b"}], "]"}], "]"}], "/", "2"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5561d787-26b0-8d0a-031e-cee1534ad450"],
 " is exactly ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["Tr",
    FontSlant->"Plain"], GridBox[{
     {
      RowBox[{
       StyleBox["a", "TI"], "-", 
       StyleBox["b", "TI"]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fea91e8-e80e-a1ed-35e9-08b589b8f337"],
 "; for the Hermitian difference of two states those singular values are just \
the magnitudes of its eigenvalues."
}], "Text",
 CellID->225924774,ExpressionUUID->"37725419-c8bf-c4cd-5d02-4e42e94bae17"],

Cell[TextData[{
 "The two-phase cat, the equal superposition of the two rotated coherent \
states ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"\[PlusMinus]", 
     StyleBox["i", "TI"], 
     StyleBox["\[Phi]", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6eee5857-8f9d-bf63-1696-52112a290249"],
 ":"
}], "Text",
 CellID->1508526016,ExpressionUUID->"2635f536-2fc9-ab3c-4fca-ed704a7df606"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"catRho", "[", "\[Phi]_", "]"}], " ", ":=", " ", 
   RowBox[{"densityMatrix", "@", 
    RowBox[{"Normalize", "[", 
     RowBox[{
      RowBox[{"coherentState", "[", 
       RowBox[{"topHar", ",", " ", 
        RowBox[{"2.", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", "\[Phi]"}], "]"}]}]}], "]"}], " ", "+", 
      " ", 
      RowBox[{"coherentState", "[", 
       RowBox[{"topHar", ",", " ", 
        RowBox[{"2.", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "\[Phi]"}], "]"}]}]}], "]"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[78]:= ",
 CellID->1653333794,ExpressionUUID->"1b3760e9-4a32-92b2-4acd-79b36fc4e098"],

Cell[TextData[{
 "The phase ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fe93a8-4ee9-5b9e-3c85-0af26a9c29e4"],
 " sets the separation: small ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11cf5d11-52cc-ddbb-47f5-555b677ea781"],
 " leaves the two coherent states close, large ",
 Cell[BoxData[
