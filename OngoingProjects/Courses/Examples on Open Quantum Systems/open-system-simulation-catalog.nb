   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23591dbb-79d4-ec10-5166-94e57866b77a"],
 " in blue, ",
 Cell[BoxData[
  TemplateBox[{
