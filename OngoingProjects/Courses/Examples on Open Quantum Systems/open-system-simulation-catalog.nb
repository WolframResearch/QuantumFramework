          StyleBox["\[Gamma]", "TI"], 
          StyleBox["M", "TI"], 
          SubscriptBox[
           StyleBox["k", "TI"], 
           StyleBox["B", "TI"]], 
          StyleBox["T", "TI"]}]}
       }], ")"}], "."}]}]}],
