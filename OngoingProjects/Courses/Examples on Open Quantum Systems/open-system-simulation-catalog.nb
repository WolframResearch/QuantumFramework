  FontSize->0.9 Inherited,ExpressionUUID->
  "6184d2f2-049e-728e-17bb-cbbcad2b40d4"],
 ","
}], "ItemNumbered",
 CellID->1536527082,ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"],

Cell[BoxData[
