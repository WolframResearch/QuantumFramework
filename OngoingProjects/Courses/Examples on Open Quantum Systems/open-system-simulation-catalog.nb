Cell["\<\
Read the two triples against each other: the small-phase cat keeps its \
fringes across the window, while the large-phase cat, its two states farther \
apart, has collapsed to a fringeless mixture by the end. Same cavity, same \
leak, same clock; only the separation differs, and the fringes die at a rate \
set by its square.\
\>", "Text",
 CellID->1137775047,ExpressionUUID->"1f4b4965-e043-b514-4549-614e91f71c7e"],

Cell["\<\
Turn that into a number. The mixture the cat decays toward is the equal blend \
of its two pointer states, each amplitude shrinking with the cavity,\
\>", "Text",
 CellID->573363004,ExpressionUUID->"5bf36e21-2d79-2b6f-0980-878b440c79b5"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["mix",
       FontSlant->"Plain"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Phi]", "TI"], ",", 
       StyleBox["t", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     FractionBox["1", "2"], "[", 
     RowBox[{
      RowBox[{
       TemplateBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["\[Alpha]", "TI"], "+"], 
           StyleBox["(", SpanMaxSize -> 1], 
           StyleBox["t", "TI"], 
           StyleBox[")", SpanMaxSize -> 1]}]},
        "Ket"], 
       TemplateBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["\[Alpha]", "TI"], "+"], 
           StyleBox["(", SpanMaxSize -> 1], 
           StyleBox["t", "TI"], 
           StyleBox[")", SpanMaxSize -> 1]}]},
        "Bra"]}], "+", 
      RowBox[{
       TemplateBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["\[Alpha]", "TI"], "-"], 
           StyleBox["(", SpanMaxSize -> 1], 
           StyleBox["t", "TI"], 
           StyleBox[")", SpanMaxSize -> 1]}]},
        "Ket"], 
       TemplateBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["\[Alpha]", "TI"], "-"], 
           StyleBox["(", SpanMaxSize -> 1], 
           StyleBox["t", "TI"], 
           StyleBox[")", SpanMaxSize -> 1]}]},
        "Bra"]}]}], "]"}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], "\[PlusMinus]"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{"2", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["t", "TI"], "/", "2"}]], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"\[PlusMinus]", 
       StyleBox["i", "TI"], 
       StyleBox["\[Phi]", "TI"]}]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1565937439,ExpressionUUID->"6fe9f85b-1ce6-27f0-1596-f20594908dda"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
