 CellID->1978684664,ExpressionUUID->"79d0371a-30a6-04e5-2fef-af4441536ecf"],

Cell["\<\
computed over a list of delays, one master-equation run per phase:\
\>", "Text",
 CellID->2064137570,ExpressionUUID->"7d950d76-dd18-2b24-2baa-a533d4ad760e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"coherenceLeft", "[", 
    RowBox[{"\[Phi]_", ",", " ", "delays_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"run", " ", "=", " ", 
       RowBox[{"evolveODE", "[", 
        RowBox[{
         RowBox[{"0", " ", "blankHar"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[Gamma]har", "]"}], " ", "downHar"}], "}"}],
          ",", " ", 
         RowBox[{"catRho", "[", "\[Phi]", "]"}], ",", " ", 
         RowBox[{"Max", "[", "delays", "]"}]}], "]"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"traceDistance", "[", 
        RowBox[{
         RowBox[{"run", "[", "t", "]"}], ",", " ", 
         RowBox[{"mixture", "[", 
          RowBox[{"\[Phi]", ",", " ", "t"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "delays"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[83]:= ",
 CellID->1265784226,ExpressionUUID->"7234a9f4-3232-6781-23cb-40be47c74deb"],

Cell["Track it for the small and the large phase:", "Text",
 CellID->872599864,ExpressionUUID->"42668d78-f434-72a4-721d-2525fdc1408e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"delays", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", "3", ",", " ", "0.25"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"close", ",", " ", "far"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"coherenceLeft", "[", 
      RowBox[{"0.5", ",", " ", "delays"}], "]"}], ",", " ", 
     RowBox[{"coherenceLeft", "[", 
      RowBox[{"1.3", ",", " ", "delays"}], "]"}]}], "}"}]}], ";"}]}], "Input",\

 CellLabel->"In[84]:= ",
 CellID->2056057710,ExpressionUUID->"0c7cc198-0ad8-2426-3403-d8c2af528f0c"],

Cell["\<\
Now visualize the two normalized coherences against the delay:\
\>", "Text",
 CellID->1360523735,ExpressionUUID->"69698b1d-3dc2-3628-1f16-2347b4749d72"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"delays", ",", " ", 
        RowBox[{"close", "/", 
         RowBox[{"First", "@", "close"}]}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"delays", ",", " ", 
        RowBox[{"far", "/", 
         RowBox[{"First", "@", "far"}]}]}], "}"}], "]"}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<small phase shift\>\"", ",", 
      " ", "\"\<large phase shift\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<delay before the second atom reads\>\"", ",", 
      " ", "\"\<surviving coherence\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<cat coherence decays faster for a larger phase shift\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[85]:= ",
 CellID->676766013,ExpressionUUID->"701e1eb7-eeba-61c8-2025-97f08b4f3312"],

Cell[TextData[{
 "Both fall, but the large-",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e322415-281a-3695-37c1-be5f49ac9cff"],
 " curve plunges: the same separation-squared decoherence law as before, now \
with the separation set by the atom's phase shift. The trace distance plotted \
here is a theoretical proxy for what the experiment actually reads out, the \
two-atom correlation ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61beb272-ef15-9663-1745-343f8aa1fd49"],
 " above; both track the surviving coherence ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e8a6a96-06b4-6465-0689-83d0b3414f4f"],
 " and fall to zero together, and the faster collapse at larger ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55951090-ef25-ccfd-03aa-89dd8ad196c7"],
 " is the experimental signature of the scaling."
}], "Text",
 CellID->1428640414,ExpressionUUID->"53a2ca13-da2c-324e-0151-ec5cdfde8094"],

Cell["Dispersive Readout: A Qubit Measured by a Cavity", "Subsection",
 CellID->1143649234,ExpressionUUID->"5930221d-821b-4026-08cf-c44737ae130c"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A switch ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76ba63e9-5df8-c241-1e5a-7ab3547290ab"],
 " read out by a driven, damped oscillator whose frequency it shifts, a \
solid-state meter:"
}], "Text",
 CellID->1571962290,ExpressionUUID->"319e51f9-a9ce-1d21-67a6-48a2c87b640b"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["\[CurlyEpsilon]", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "+", 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["\[Chi]", "TI"], " ", 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "\[Dagger]"], 
      OverscriptBox[
       StyleBox["a", "TI"], "^"], " ", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"]]}], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Gamma]", "TI"], " ", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2091585593,ExpressionUUID->"26f4962c-805e-a216-4e8b-087631e8f17c"],

Cell[TextData[{
 "The drive ",
 Cell[BoxData[
  StyleBox["\[CurlyEpsilon]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "313d5a7b-7caf-7acc-60c3-5c25755a4816"],
 " and damping ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2da78195-91be-94f0-5b5c-18df2048feda"],
 " settle the oscillator into one of two switch-conditioned coherent states, \
a pointer pointing one way or the other, while the oscillator's own leak \
decoheres any which-way superposition of the switch. Build the joint \
switch-plus-light system and watch the pointer split in two and the switch \
blur."
}], "Text",
 CellID->30157833,ExpressionUUID->"39c6b7ab-78e0-e73c-6ffd-2ef5789aca06"],

Cell[TextData[{
 "A qubit is read out by a driven, damped cavity whose frequency it shifts \
(dispersive coupling). The cavity settles into one of two qubit-conditioned \
coherent states, the ",
 StyleBox["pointer states",
  FontWeight->"Bold"],
 "; the cavity field is the meter, its amplitude the pointer. Set the drive, \
coupling, and decay:"
}], "Text",
 CellID->1715653387,ExpressionUUID->"3f7d0c35-7157-44bf-6502-a67f00e22e85"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Epsilon]", " ", "=", " ", "1.2"}], ";", " ", 
  RowBox[{"\[Chi]", " ", "=", " ", "0.6"}], ";", " ", 
  RowBox[{"\[Gamma]disp", " ", "=", " ", "1.0"}], ";"}]], "Input",
 CellLabel->"In[86]:= ",
 CellID->1904268993,ExpressionUUID->"47b49f91-c3c7-4deb-6d4b-16daf6721731"],

Cell[TextData[{
 "The pointer amplitude obeys a linear driven-damped equation, one per qubit \
state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", "\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "064e3005-d89e-7c03-2e75-aa6ed92b4769"],
 ", namely ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Alpha]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["\[CurlyEpsilon]", "TI"], "-", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], 
    StyleBox["s", "TI"], 
    StyleBox["\[Chi]", "TI"], "+", 
    FractionBox[
     StyleBox["\[Gamma]", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76c2caed-aea0-13a2-1ef1-e3b6cb556188"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "260c3025-1fa9-9acd-4e33-a98f9a5de817"],
 ", so in closed form"
}], "Text",
 CellID->1610510011,ExpressionUUID->"4b1e6c2c-0452-4134-7925-8676ade7101e"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["s", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox[
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[CurlyEpsilon]", "TI"]}], 
     RowBox[{
      StyleBox["i", "TI"], 
      StyleBox["s", "TI"], 
      StyleBox["\[Chi]", "TI"], "+", 
      StyleBox["\[Gamma]", "TI"], "/", "2"}]], 
    StyleBox["(",
     FontSize->1.8 Inherited], "1", "-", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["i", "TI"], 
       StyleBox["s", "TI"], 
       StyleBox["\[Chi]", "TI"], "+", 
       StyleBox["\[Gamma]", "TI"], "/", "2"}], 
      StyleBox[")",
       SpanMaxSize->1], " ", 
      StyleBox["t", "TI"]}]], 
    StyleBox[")",
     FontSize->1.8 Inherited]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1363210520,ExpressionUUID->"2982aea8-af87-65d7-5fb1-47f5ca324f3d"],

Cell[TextData[{
 "settling to the mirror-image steady amplitudes ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["s", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["\[CurlyEpsilon]", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], 
    StyleBox["s", "TI"], 
    StyleBox["\[Chi]", "TI"], "+", 
    StyleBox["\[Gamma]", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19ac3a5e-0cd6-873c-4f53-bc18a560ea06"],
 ". Solve it:"
}], "Text",
 CellID->751311520,ExpressionUUID->"6e8690e9-968f-68b3-16bd-09b3233a3a99"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"pointer", "[", "which_", "]"}], " ", ":=", " ", 
   RowBox[{"First", "[", 
    RowBox[{"amp", " ", "/.", " ", 
     RowBox[{"DSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"amp", "'"}], "[", "t", "]"}], " ", "==", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "I"}], " ", "\[Epsilon]"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"I", " ", "which", " ", "\[Chi]"}], " ", "+", " ", 
              RowBox[{"\[Gamma]disp", "/", "2"}]}], ")"}], " ", 
            RowBox[{"amp", "[", "t", "]"}]}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"amp", "[", "0", "]"}], " ", "==", " ", "0"}]}], "}"}], ",",
        " ", "amp", ",", " ", "t"}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[87]:= ",
 CellID->1811324800,ExpressionUUID->"2b6bc1ec-c569-bd9f-5968-d8c9ec1d07e5"],

