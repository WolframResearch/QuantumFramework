     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     StyleBox["I", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["I", "TI"]], "+", "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     StyleBox["Q", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["Q", "TI"]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->405213039,ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell[TextData[{
 "   with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["I", "TI"], "2"], "=", 
   StyleBox["d", "TI"], 
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["Q", "TI"], "2"], "=", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["I", "TI"]], 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["Q", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1ff276-b82a-c3ca-5b24-f43039dc9110"],
 "; the two records are"
}], "Text",
 CellID->2118931930,ExpressionUUID->"14fd1512-f616-8834-3c82-8d5f83a0db1e"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["j", "TI"]], "=", 
    SubscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        OverscriptBox[
         StyleBox["c", "TI"], "^"], 
        StyleBox["j", "TI"]], "+", 
       SubsuperscriptBox[
        OverscriptBox[
         StyleBox["c", "TI"], "^"], 
        StyleBox["j", "TI"], "\[Dagger]"]}], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["j", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["j", "TI"], "\[Element]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["I", "TI"], ",", 
      RowBox[{
       RowBox[{
        StyleBox["Q", "TI"], "}"}], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1039057480,ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"],

Cell[TextData[{
 StyleBox["Quantum Zeno dynamics.",
  FontWeight->"Bold"],
 " For the catalog's monitored operator ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
 ","
}], "ItemNumbered",
 CellID->1411198270,ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "=", "-", 
    StyleBox["i", "TI"], 
    FractionBox["\[CapitalOmega]", "2"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["x", "TI"]], ",", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["c", "TI"]]}], 
    StyleBox["]",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["k", "TI"], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox["k", "TI"]], "\[ThinSpace]", "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1703453532,ExpressionUUID->"11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],

Cell[TextData[{
 "    Equivalently, the deterministic measurement term is ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox[
    StyleBox["k", "TI"], "2"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], ",", 
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"]], ",", 
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], 
       StyleBox["c", "TI"]]}], 
     StyleBox["]",
      SpanMaxSize->1]}]}], 
   StyleBox["]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],
 ". This convention gives the Liouvillian pair ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["k", "TI"], "\[PlusMinus]", 
   StyleBox["i", "TI"], 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "-", 
     SuperscriptBox[
      StyleBox["k", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3181a460-bc62-f1ee-67be-3e4a3514c334"],
 " and the exceptional point ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],
 " used below."
}], "Text",
 CellID->1477609488,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell[TextData[{
 StyleBox["Charge qubit monitored by a QPC.",
  FontWeight->"Bold"],
 " Since ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "\[RightVector]"], "1"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\|01d7d9", "-", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 ","
}], "ItemNumbered",
 CellID->1030824397,ExpressionUUID->"250a2d7c-9b81-05b0-5309-c5261e346f9a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "=", "-", 
    StyleBox["i", "TI"], "[", 
    RowBox[{
     RowBox[{
      FractionBox["\[CapitalOmega]", "2"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["x", "TI"]]}], ",", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["c", "TI"]]}], "]", "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    FractionBox[
     StyleBox["\[Kappa]", "TI"], "4"], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    FractionBox[
     SqrtBox[
      StyleBox["\[Kappa]", "TI"]], "2"], "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox[
     RowBox[{"d", "J"}], "TI"], "=", 
    RowBox[{
     RowBox[{
      SqrtBox[
       StyleBox["\[Kappa]", "TI"]], "\[ThinSpace]", 
      SubscriptBox[
       RowBox[{
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        SubscriptBox[
         OverscriptBox[
          StyleBox["\[Sigma]", "TI"], "^"], 
         StyleBox["z", "TI"]], 
        StyleBox["\[RightAngleBracket]",
         SpanMaxSize->1]}], 
       StyleBox["c", "TI"]], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{
      StyleBox["d", "TI"], 
      RowBox[{
       StyleBox["W", "TI"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->100031176,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell[TextData[{
 "    Dropping the innovation term gives the unconditional equation ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CapitalOmega]", "/", "2"}], 
     StyleBox[")",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["x", "TI"]]}], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   StyleBox["\[Kappa]", "TI"], "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "\[RightVector]"], "1"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],
 "."
}], "Text",
 CellID->144223354,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

