   SubscriptBox[
    OverscriptBox[
     StyleBox["H", "TI"], "^"], 
    StyleBox[
     RowBox[{"f", "b"}], "TI"]], "=", 
   OverscriptBox[
    StyleBox["J", "TI"], "."], "\[ThinSpace]", 
