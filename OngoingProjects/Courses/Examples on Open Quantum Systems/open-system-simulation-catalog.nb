       {"0", 
        RowBox[{"1", "/", 
         StyleBox["M", "TI"]}]},
       {
        RowBox[{"-", 
         StyleBox["M", "TI"], 
         SuperscriptBox["\[CapitalOmega]", "2"]}], 
        RowBox[{"-", "2", 
