 CellID->1621535814,ExpressionUUID->"19bb1c5e-57ab-6e36-4f58-9618625e351c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], "[", 
    RowBox[{
     RowBox[{
      OverscriptBox[
       StyleBox["H", "TI"], "^"], "+", 
      FractionBox["1", "2"], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SuperscriptBox[
        OverscriptBox[
         StyleBox["c", "TI"], "^"], "\[Dagger]"], 
       OverscriptBox[
        StyleBox["F", "TI"], "^"], "+", 
       OverscriptBox[
        StyleBox["F", "TI"], "^"], 
       OverscriptBox[
        StyleBox["c", "TI"], "^"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", 
     StyleBox["\[Rho]", "TI"]}], "]", "+", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "-", 
     StyleBox["i", "TI"], 
     OverscriptBox[
      StyleBox["F", "TI"], "^"]}], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "+", 
    FractionBox[
     RowBox[{"1", "-", 
      StyleBox["\[Eta]", "TI"]}], 
     StyleBox["\[Eta]", "TI"]], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
