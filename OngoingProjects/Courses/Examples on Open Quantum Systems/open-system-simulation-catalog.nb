   StyleBox["\[Sigma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "617ac38b-bfe7-c8e3-1719-dad539939ac9"],
 " band:"
}], "Text",
 CellID->372521314,ExpressionUUID->"0820ecb4-5495-9c54-39df-05fe5d21e6be"],

Cell[BoxData[
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Show", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"kalGrid", ",", " ", 
            RowBox[{
             RowBox[{"kalFilt", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
             "kalBand"}]}], "}"}], "]"}], ",", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"kalGrid", ",", " ", 
            RowBox[{
             RowBox[{"kalFilt", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
             "kalBand"}]}], "}"}], "]"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"Filling", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", " ", "->", " ", 
          RowBox[{"{", "2", "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
          RowBox[{"Opacity", "[", "0.15", "]"}]}], "]"}]}]}], "]"}], ",", 
     "\n", "  ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"kalGrid", ",", " ", 
            RowBox[{"kalTrue", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "}"}], "]"}], ",",
          " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"kalGrid", ",", " ", 
            RowBox[{"kalFilt", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "}"}], "]"}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{"Thick", ",", " ", 
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Thick", ",", " ", 
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", " ", "1"}], "]"}]}], "]"}]}], "}"}]}]}], 
      "]"}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", " ", "\"\<position\>\""}], "}"}]}], ",", 
     " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<the filter locks onto the reference conditional mean from the \
record alone\>\""}]}], "]"}], ",", "\n", " ", 
   RowBox[{"LineLegend", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ColorData", "[", 
        RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"ColorData", "[", 
        RowBox[{"97", ",", " ", "1"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<reference conditional mean\>\"", ",", 
       " ", "\"\<estimate from wrong prior \[PlusMinus]\[Sigma]\>\""}], 
      "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[194]:= ",
 CellID->1020330751,ExpressionUUID->"5e80e7d7-2c44-8e80-06bf-fe9145f6d4ea"],

Cell["\<\
The estimate begins wildly wrong (opposite sign) inside a wide band, then the \
record pulls it onto the reference conditional mean and the band tightens to \
the steady conditional width: a wrong prior is forgotten, because the record \
carries the same information whatever the observer first believed. (The \
reference mean is not a hidden classical position; it is the conditional mean \
of the simulated record, the best anyone could know.)\
\>", "Text",
 CellID->339737350,ExpressionUUID->"26f5fcf3-bda8-2342-4e8a-f5bd345d71a8"],

Cell["\<\
Confirm the lock, comparing the two once the filter has settled:\
\>", "Text",
 CellID->967879197,ExpressionUUID->"15b39007-6d36-072c-4340-0a6104c36a76"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Last", "@", 
    RowBox[{"kalTrue", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
   RowBox[{"Last", "@", 
    RowBox[{"kalFilt", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}]}], "}"}]], "Input",
 CellLabel->"In[195]:= ",
 CellID->2045221242,ExpressionUUID->"24baaecf-7f93-f980-4c59-47a97a27cbea"],

Cell["The two agree to several digits.", "Text",
 CellID->2119433676,ExpressionUUID->"76f70144-dc0f-2312-1e8c-9921d5bb8e78"],

Cell[TextData[{
 "The engine of the filter is its own innovation, the record minus the ",
 StyleBox["filter's", "TI"],
 " prediction (not the reference mean's). For an optimal filter this must be \
white noise, zero-mean and uncorrelated; measure its autocorrelation past the \
transient, with the ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "2", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fe7a9e0-94ce-d707-459c-40ca1d78ba6d"],
 " band that white noise would sit inside:"
}], "Text",
 CellID->1666150564,ExpressionUUID->"3d41bad8-5432-fbcd-6b7e-33825dc4c917"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kalInnov", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"#2", " ", "-", " ", 
           RowBox[{
            RowBox[{"#1", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "kalDt"}]}], ")"}]}], " ", 
        "&"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Most", "@", "kalFilt"}], ",", " ", "kalRec"}], "}"}]}], 
      "]"}], "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"Round", "[", 
        RowBox[{"kalN", "/", "3"}], "]"}], " ", ";;"}], "]"}], "]"}], "/", 
    RowBox[{"Sqrt", "[", "kalDt", "]"}]}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ci", " ", "=", " ", 
     RowBox[{"2", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Length", "[", "kalInnov", "]"}], "]"}]}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"CorrelationFunction", "[", 
      RowBox[{"kalInnov", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "10"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Filling", " ", "->", " ", "Axis"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.2"}], ",", " ", "0.2"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ci", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "ci"}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}]}], "}"}]}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{"ImageSize", " ", "->", " ", "440"}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<lag\>\"", ",", 
        " ", "\"\<innovation autocorrelation\>\""}], "}"}]}], ",", " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<the filter's innovation is white within confidence \
limits\>\""}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[196]:= ",
 CellID->664696531,ExpressionUUID->"0dba7410-c818-dfcb-3b5a-6e5de992a511"],

Cell["\<\
The autocorrelation is flat at zero for every nonzero lag: the filter has \
wrung all the structure out of the record, leaving pure noise. A whitened \
innovation is the working definition of an optimal filter, and it is the \
real-time diagnostic a lab watches to know its tracking model is right.\
\>", "Text",
 CellID->79098559,ExpressionUUID->"30c9b337-f958-fd8c-60f6-2b70f8d2c7d6"],

Cell["Measurement Feedback: Steering With the Record", "Subsection",
 CellID->923612531,ExpressionUUID->"7ef4fbe9-42ce-bb3a-268b-f2b377780600"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Feed the homodyne record back as a Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["H", "TI"], "^"], 
    StyleBox["fb",
     FontSlant->"Plain"]], "=", 
   OverscriptBox[
    StyleBox["J", "TI"], "."], " ", 
   OverscriptBox[
    StyleBox["F", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b93c9b6-6d32-b3d4-19a0-e0f004c4013e"],
 ", the feedback signal being the homodyne current ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["J", "TI"], "."], "=", 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78b94e11-c6dd-a6bf-2847-605af3690c85"],
 " read off the record ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "=", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b080b4d-7396-a957-4937-a3170620fbbd"],
 ", so over a step the loop applies ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["F", "TI"], "^"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "343c9421-c983-3b23-5dc3-0d8ae8378609"],
 "; averaged over the noise, the conditioned-plus-feedback evolution becomes \
the Wiseman-Milburn feedback master equation"
}], "Text",
 CellID->725718587,ExpressionUUID->"205770a9-e847-de3f-506d-69f289f3a505"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       StyleBox["i", "TI"], 
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        OverscriptBox[
         StyleBox["H", "TI"], "^"], ",", 
        StyleBox["\[Rho]", "TI"]}], 
       StyleBox["]",
        SpanMaxSize->1]}]}], "+", 
     RowBox[{
      RowBox[{"\|01d49f", 
       StyleBox["[",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["c", "TI"], "^"], 
       StyleBox["]",
        SpanMaxSize->1]}], 
      StyleBox["\[Rho]", "TI"]}], "-", 
     RowBox[{
      StyleBox["i", "TI"], 
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       OverscriptBox[
        StyleBox["F", "TI"], "^"], ",", " ", 
       RowBox[{
        RowBox[{
         OverscriptBox[
          StyleBox["c", "TI"], "^"], 
         StyleBox["\[Rho]", "TI"]}], "+", 
        RowBox[{
         StyleBox["\[Rho]", "TI"], 
         SuperscriptBox[
          OverscriptBox[
           StyleBox["c", "TI"], "^"], "\[Dagger]"]}]}]}], 
      StyleBox["]",
       SpanMaxSize->1]}], "+", 
     RowBox[{
      FractionBox["1", 
       StyleBox["\[Eta]", "TI"]], " ", 
      RowBox[{"\|01d49f", 
       StyleBox["[",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["F", "TI"], "^"], 
       StyleBox["]",
        SpanMaxSize->1]}], 
      StyleBox["\[Rho]", "TI"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->868291647,ExpressionUUID->"78b78126-006e-7c03-284c-1880b11b4769"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e949e5e-c771-e653-06ab-101bf205ccb9"],
 " the detection efficiency, this is just a plain leak with a shifted \
operator, ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "-", 
    StyleBox["i", "TI"], 
    OverscriptBox[
     StyleBox["F", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "359bcca5-e220-9ec0-63b8-e50e97dae42a"],
 ", plus a Hamiltonian correction. The feedback engineers the effective \
damping, here steering a shapeless switch onto a chosen state. Drive ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d973432-f49b-24e6-6bac-ae7ffd2f8ecc"],
 " to one with the record itself and check it against this equation."
}], "Text",
 CellID->986753062,ExpressionUUID->"2740d0b2-6fee-93c4-4d7f-c9fc0998e12e"],

Cell[TextData[{
 "Close the loop: feed the measurement record back as a Hamiltonian in \
proportion, so the record steers the state. Concretely the measured operator \
is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], " ", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28899a3f-5003-79db-58b6-1c7961b64b21"],
 " and the feedback generator is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["F", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], " ", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "091a51ee-65fb-201c-3f3a-48c8138e7366"],
 ", so the loop measures ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60c488fa-b38d-2f14-10fb-21a7c638727e"],
 " and rotates about ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dab8a61-8541-a5e8-6ba8-2c4b2cf50f32"],
 " by an amount set by the record. The one constant ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cd9d50f-b32b-5aae-14e6-cd68c6de28f4"],
 " does two jobs here: it is the measurement rate, ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["G", "TI"], " ", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25697345-b0fc-afe2-5317-6b2ec08ef5c8"],
 ", and it is the feedback gain, entering through ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["F", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], " ", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b535da6-b53b-b46b-2961-54003ccf1eb1"],
 "; the two are matched on purpose, which is exactly what makes the target a \
dark state of the shifted leak below. The shifted operator is then ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "-", 
   StyleBox["i", "TI"], 
   OverscriptBox[
    StyleBox["F", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["y", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44232014-649d-d43d-6dd0-ba5e0d29bf07"],
 ", and the Hamiltonian correction ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["F", "TI"], "^"], "+", 
    OverscriptBox[
     StyleBox["F", "TI"], "^"], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7586ae08-7861-bb88-23bd-4052791509d2"],
 " vanishes because ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e345b1-bc57-c084-7c91-5cfb35e392ee"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["y", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c2b12ae-6045-71e4-0428-8b0811f043ce"],
 " anticommute, so the ideal loop is the single leak ",
 Cell[BoxData[
  RowBox[{
   StyleBox["G", "TI"], " ", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["y", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "180e6a9a-5611-2942-4835-83c463a47ba8"],
 ". Set the gain and the time grid:"
}], "Text",
 CellID->1712489022,ExpressionUUID->"6dd95d70-b540-f840-1be7-553a3cfacaaa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Gfb", " ", "=", " ", "0.8"}], ";", " ", 
  RowBox[{"tickFb", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"track", " ", "=", " ", 
   RowBox[{"tickFb", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "200"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[197]:= ",
 CellID->1130883020,ExpressionUUID->"29eb0418-0bd1-ce19-5fe8-9e42ae659563"],

Cell[TextData[{
 "A rotation about ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fcc496e-9c46-13ea-55f4-614815f36130"],
 " has a closed form, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["y", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Phi]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Phi]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["y", "TI"]]}]], "=", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Phi]", "TI"], " ", "\|01d7d9", "-", 
   StyleBox["i", "TI"], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Phi]", "TI"], " ", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "191acd8d-6e98-c427-4f39-e4d70b12af0d"],
 ", and it is what the generator ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["F", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2305a976-3107-1e82-513a-413040b264e8"],
 " produces: the feedback unitary applied each step is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     OverscriptBox[
      StyleBox["F", "TI"], "^"], " ", 
     StyleBox["d", "TI"], 
     StyleBox["J", "TI"]}]], "=", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["y", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SqrtBox[
     StyleBox["G", "TI"]], " ", 
    StyleBox["d", "TI"], 
    StyleBox["J", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7db30b64-26ac-b1af-2b40-a34e535e03f5"],
 ", so ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["F", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7eeaae22-94f7-017f-26e9-478c1c825045"],
 " is the generator and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["R", "TI"], 
   StyleBox["y", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09646c1c-8840-439e-3f1b-864629f511e4"],
 " the finite rotation, not one and the same. The step is light:"
}], "Text",
 CellID->826918846,ExpressionUUID->"63ab22ce-56be-71a3-11a8-bba8634b4389"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rotateY", "[", "\[Phi]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", "id2"}], " ", "-", " ", 
    RowBox[{"I", " ", 
     RowBox[{"Sin", "[", "\[Phi]", "]"}], " ", "Y"}]}]}], ";"}]], "Input",
 CellLabel->"In[198]:= ",
 CellID->1119720649,ExpressionUUID->"1cf7fb29-0d40-1e28-448c-f373a4f56572"],

Cell[TextData[{
 "One steered run, one step at a time. Write ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["meas",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d412947-9e62-7904-5b7e-c1211b17486e"],
 " for the positivity-preserving measurement update of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fd69df2-7b02-a961-15ed-14bc7eb4f84b"],
 " under ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], " ", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "768fd558-59bf-0a63-1eb4-cd02584a5949"],
 ", given the record ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "=", "2", 
   SqrtBox[
    StyleBox["G", "TI"]], " ", 
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["\[Rho]", "TI"]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26b5396e-c871-0359-4e4a-b14be90451a3"],
 ". One step measures, then rotates by the commanded angle ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Phi]", "TI"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f77ebf2-aec9-563c-450c-02bfcb7c3d06"],
 ":"
}], "Text",
 CellID->747338226,ExpressionUUID->"5317ee41-6066-3577-012c-002b11109c5d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Rho]", "TI"], "\[Prime]"], "=", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["y", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Phi]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], " ", 
    SuperscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["meas",
      FontSlant->"Plain"]], " ", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["y", "TI"]], 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Phi]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], "\[Dagger]"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["\[Phi]", "TI"], "=", 
    RowBox[{
     SqrtBox[
      StyleBox["G", "TI"]], " ", 
     StyleBox["d", "TI"], 
     StyleBox["J", "TI"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1214057513,ExpressionUUID->"0454080f-5b74-5a26-2c6b-a2695e01290c"],

Cell[TextData[{
 "run ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", "200"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "200c839f-1e44-fe5c-5033-1ad99bf6c4a6"],
 " times from ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "0"], "=", 
   FractionBox["1", "2"], "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "573cfa27-29ff-38cf-7ec3-f3814f8b8a15"],
 ". Keeping the pair ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], ",", 
    StyleBox["\[Phi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bb83578-78e8-07f4-2947-ad22789d6dde"],
 " at each step, the run is the whole causal chain at once,"
}], "Text",
 CellID->1068045466,ExpressionUUID->"48fc1f1f-3652-ba13-7883-975943e40979"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["(",
     FontSize->1.2 Inherited], 
    RowBox[{
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "0"], ",", " ", "0"}], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", " ", 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "1"], ",", 
       SubscriptBox[
        StyleBox["\[Phi]", "TI"], "1"]}], 
