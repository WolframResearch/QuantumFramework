 CellLabel->"In[80]:= ",
 CellID->1120596176,ExpressionUUID->"03dda600-4b0b-c3af-31e2-386a6ebf91f5"],

Cell["\<\
Draw both films on one shared color scale so the two separations are directly \
comparable, the small-phase triple then the large-phase triple:\
\>", "Text",
 CellID->64105026,ExpressionUUID->"4de38b79-ee67-8bee-7b90-23228b13d934"],

Cell[BoxData[
 RowBox[{"wignerPlot", "[", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{"harFilmSmall", ",", " ", "harFilmLarge"}], "]"}], ",", "\n", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\"\<small \[Phi], \[Tau]=\>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
      "harTimes"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<large \[Phi], \[Tau]=\>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
      "harTimes"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[81]:= ",
 CellID->1373525465,ExpressionUUID->"347cf1ed-0cc4-b4dc-5c03-e8b7a5761e26"],

Cell["\<\
Read the two triples against each other: the small-phase cat keeps its \
fringes across the whole window, while the large-phase cat, its two states \
farther apart, has collapsed to a fringeless mixture by the end. Same cavity, \
same leak, same clock, one color scale; only the separation differs, and the \
fringes die at a rate set by its square.\
\>", "Text",
 CellID->1964307623,ExpressionUUID->"7d81b9ce-3a4c-aa2a-2bbe-30a8bffef970"],

Cell["\<\
The second atom reads this decay as a number. Measure the surviving coherence \
as the trace distance between the decohering cat and the classical mixture of \
its two coherent states: full coherence when the cat is intact, zero once it \
has decohered. The mixture the cat decays toward is the equal blend of the \
two pointer states, each amplitude shrinking with the cavity,\
\>", "Text",
 CellID->39040159,ExpressionUUID->"6bb9b374-9caf-337d-1946-2b3e155b9e47"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["mix",
       FontSlant->"Plain"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Phi]", "TI"], ",", 
       StyleBox["t", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      StyleBox["(",
       FontSize->1.2 Inherited], 
      RowBox[{
       RowBox[{
        TemplateBox[{
          SubscriptBox[
           StyleBox["\[Alpha]", "TI"], "+"]},
         "Ket"], 
        TemplateBox[{
          SubscriptBox[
           StyleBox["\[Alpha]", "TI"], "+"]},
         "Bra"]}], "+", 
       RowBox[{
        TemplateBox[{
          SubscriptBox[
           StyleBox["\[Alpha]", "TI"], "-"]},
         "Ket"], 
        TemplateBox[{
          SubscriptBox[
           StyleBox["\[Alpha]", "TI"], "-"]},
         "Bra"]}]}], 
      StyleBox[")",
       FontSize->1.2 Inherited]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], "\[PlusMinus]"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{"2", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["t", "TI"], "/", "2"}]], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"\[PlusMinus]", 
       StyleBox["i", "TI"], 
       StyleBox["\[Phi]", "TI"]}]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1242473813,ExpressionUUID->"6c340229-13f4-0181-15cb-a473a58153eb"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["har",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25dfa134-0866-9bb5-53e4-397ea910e99f"],
 ":"
}], "Text",
 CellID->290269587,ExpressionUUID->"425139cc-45a5-cefb-726e-b0966c5194c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mixture", "[", 
    RowBox[{"\[Phi]_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sh", " ", "=", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Gamma]har"}], " ", 
         RowBox[{"t", "/", "2"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"densityMatrix", "[", 
         RowBox[{"coherentState", "[", 
          RowBox[{"topHar", ",", " ", 
           RowBox[{"2.", " ", "sh", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", "\[Phi]"}], "]"}]}]}], "]"}], "]"}], 
        " ", "+", " ", 
        RowBox[{"densityMatrix", "[", 
         RowBox[{"coherentState", "[", 
          RowBox[{"topHar", ",", " ", 
           RowBox[{"2.", " ", "sh", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", "\[Phi]"}], "]"}]}]}], "]"}], "]"}]}], ")"}], "/",
       "2"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[82]:= ",
 CellID->471335900,ExpressionUUID->"4d922994-f334-45bb-7ba1-c0d186c12f81"],

Cell[TextData[{
 "The surviving coherence is the trace distance between the leak-evolved cat ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["cat",
     FontSlant->"Plain"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"], " ", "\|01d49f", 
     StyleBox["[",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     StyleBox["]",
      SpanMaxSize->1]}]], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["cat",
      FontSlant->"Plain"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Phi]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06c25578-1780-b25e-2ef2-4d22a23a00a4"],
 " and that mixture,"
}], "Text",
 CellID->1843091513,ExpressionUUID->"5f70617e-b140-9f95-0500-793bc0fae5ff"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["coherenceLeft",
     FontSlant->"Plain"], 
    StyleBox["(",
