     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          TemplateBox[{
            StyleBox["\[Alpha]", "TI"]},
           "Ket"], "+", 
          TemplateBox[{
            RowBox[{"-", 
              StyleBox["\[Alpha]", "TI"]}]},
           "Ket"]}], ")"}], 
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{
          StyleBox["\[LeftAngleBracket]",
           SpanMaxSize->1], 
          RowBox[{
           StyleBox["\[Alpha]", "TI"], GridBox[{
             {
              RowBox[{"+", 
               StyleBox["\[LeftAngleBracket]",
                SpanMaxSize->1], "-", 
