Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", 
    StyleBox["\[Gamma]", "TI"], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["\[Rho]", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "0", 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"\[LeftBracketingBar]", 
        StyleBox["\[Alpha]", "TI"], "\[RightAngleBracket]", "+", "\[LeftBracketingBar]", 
        RowBox[{"-", 
         StyleBox["\[Alpha]", "TI"]}], "\[RightAngleBracket]"}], 
       StyleBox[")",
        SpanMaxSize->1], 
       SuperscriptBox[
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{"\[LeftBracketingBar]", 
          StyleBox["\[Alpha]", "TI"], "\[RightAngleBracket]", "+", "\[LeftBracketingBar]", 
          RowBox[{"-", 
           StyleBox["\[Alpha]", "TI"]}], "\[RightAngleBracket]"}], 
         StyleBox[")",
          SpanMaxSize->1]}], "\[Dagger]"]}], 
      RowBox[{"2", 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "+", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"-", "2", 
          SuperscriptBox[GridBox[{
             {
              StyleBox["\[Alpha]", "TI"]}
            },
            GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
            GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]]}], 
       StyleBox[")",
        SpanMaxSize->1]}]], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->476175344,ExpressionUUID->"12c4fc3b-e00c-2bba-42fb-f66491b97980"],

