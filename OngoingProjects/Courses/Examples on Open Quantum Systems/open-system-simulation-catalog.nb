Cell["Part One: Systems We Can Solve Symbolically", "Section",
 CellID->72268088,ExpressionUUID->"1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],

Cell[TextData[{
 "The first two systems have exact closed-form answers we can check against \
the code. Both are qubits, so first a convenience: read the master equation \
as three ",
 StyleBox["Bloch equations",
  FontWeight->"Bold"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "."], ",", 
    OverscriptBox[
     StyleBox["y", "TI"], "."], ",", 
    OverscriptBox[
     StyleBox["z", "TI"], "."]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "710db4a8-d877-0db2-2732-2df5d9025798"],
 ". Write the general Bloch state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\|01d7d9", "+", 
    StyleBox["x", "TI"], 
    StyleBox["X", "TI"], "+", 
    StyleBox["y", "TI"], 
    StyleBox["Y", "TI"], "+", 
    StyleBox["z", "TI"], 
    StyleBox["Z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e12f72-3ad4-a92f-279e-c73cbf66f875"],
 ":"
}], "Text",
 CellID->546416532,ExpressionUUID->"06ea8612-dd18-b4f0-2ee9-185fd4921eda"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"blochState", "[", 
    RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"id2", " ", "+", " ", 
      RowBox[{"x", " ", "X"}], " ", "+", " ", 
      RowBox[{"y", " ", "Y"}], " ", "+", " ", 
      RowBox[{"z", " ", "Z"}]}], ")"}], "/", "2"}]}], ";"}]], "Input",
 CellLabel->"In[41]:= ",
 CellID->2117784656,ExpressionUUID->"0b02f270-2101-5c3d-3931-f43a50b42707"],

Cell["\<\
Feed it to the Lindbladian and extract each component's rate:\
\>", "Text",
 CellID->853117843,ExpressionUUID->"2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rates", "[", 
    RowBox[{"H_", ",", " ", "leaks_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"ComplexExpand", "@", 
    RowBox[{"Table", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"d", " ", ".", " ", 
        RowBox[{"lindbladian", "[", 
         RowBox[{"H", ",", " ", "leaks", ",", " ", 
          RowBox[{"blochState", "[", 
           RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}]}], "]"}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"d", ",", " ", 
        RowBox[{"{", 
         RowBox[{"X", ",", " ", "Y", ",", " ", "Z"}], "}"}]}], "}"}]}], 
     "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[42]:= ",
 CellID->623836386,ExpressionUUID->"669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],

Cell["Pure Dephasing", "Subsection",
 CellID->564394165,ExpressionUUID->"5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A two-level system dephased along ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],
 ", with no Hamiltonian:"
}], "Text",
 CellID->2048244887,ExpressionUUID->"3e73fafe-05d0-7203-6600-f3b8ac654169"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", 
    StyleBox["\[Gamma]", "TI"], " ", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1432457359,ExpressionUUID->"7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"], "\[Dagger]"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c044c4-b778-74e1-42f0-5da1c20d5ecb"],
 " this is pure dephasing, so in Bloch components ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "."], "=", "-", "2", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d9aa029-60a8-273a-6bb9-3a7311428a00"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["y", "TI"], "."], "=", "-", "2", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64adc082-4122-deff-0c52-d9ec70d4a4c5"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["z", "TI"], "."], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e451771-8a55-ceec-267a-8f3b2fe19436"],
 ", giving ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["x", "TI"], "0"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "2", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4670f053-f537-0b3f-6e0f-ea1cfcc25605"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["y", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["y", "TI"], "0"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "2", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "330aabc0-bdd5-22a3-6109-42aa34607089"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["z", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],
 ". Both poles ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"]], "=", "\[PlusMinus]", "1"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d705b8-410a-1477-20ec-9ce270bf7f5d"],
 " (the ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "737c509e-bc52-eefb-2104-49d835e4b4c1"],
 " eigenstates ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01a44b6b-c85f-9e0e-375c-6334e9ebe554"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],
 ", not to be confused with the ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25120901-cfbc-a8e6-5321-a16aea4efacc"],
 " eigenstate the code calls ",
 Cell[BoxData["plus"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ee7491f-72c3-8814-669d-61590777db7e"],
 ") are fixed points, so there is no unique steady state: any mixture ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "+"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Bra"]}], "+", 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "-"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67860241-8011-89c8-0dbd-a42b31a5db12"],
 " sits still forever. Here is the same problem in plain words, solved from \
scratch and checked against the machine."
}], "Text",
 CellID->200346680,ExpressionUUID->"1318f44b-7a0d-b86f-4127-ee157fb90ab5"],

Cell[TextData[{
 "Pure dephasing continuously measures ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "221ecbfd-1ed7-d323-5225-e2a79b63be09"],
 ": it damps the transverse coherences and leaves the populations fixed. No \
Hamiltonian, one dissipator. Read the Bloch equations:"
}], "Text",
 CellID->447384324,ExpressionUUID->"3f067a83-888f-4db3-653e-73ed293a1799"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "\[Gamma]", "]"}], ";", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"rates", "[", 
     RowBox[{
      RowBox[{"0", " ", "id2"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "Z"}], "}"}]}], "]"}], ",",
     " ", 
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]}]], "Input",
 CellLabel->"In[43]:= ",
 CellID->1438124241,ExpressionUUID->"287fc527-5526-9e30-5804-dc815cd0e51a"],

Cell[TextData[{
 "The transverse components ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], ",", 
   StyleBox["y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2207e002-80f7-0285-523c-fa6c308250ef"],
 " decay at rate ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "440467ae-8db5-79b4-6c3c-7e0824404b9e"],
 "; ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141585f4-d1c1-5bbd-3c2a-1cb1e0742987"],
 " is fixed. Hand those rates, exactly as the Lindbladian produced them, to \
the differential-equation solver as the Bloch equations, and solve from any \
initial Bloch vector:"
}], "Text",
 CellID->2000382747,ExpressionUUID->"3d27d006-86b8-9131-64dc-ca603332e01b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "x", ",", " ", "y", ",", " ", "z", ",", " ", "t", ",", " ", "x0", ",", " ",
     "y0", ",", " ", "z0"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"closedDephasing", "[", "t_", "]"}], " ", "=", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], ",", " ", 
     RowBox[{"y", "[", "t", "]"}], ",", " ", 
     RowBox[{"z", "[", "t", "]"}]}], "}"}], " ", "/.", " ", 
   RowBox[{"First", "@", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"Join", "[", "\n", "     ", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"x", "'"}], "[", "t", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"y", "'"}], "[", "t", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"z", "'"}], "[", "t", "]"}]}], "}"}], " ", "==", "\n", 
          "       ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Simplify", "[", 
             RowBox[{
              RowBox[{"rates", "[", 
               RowBox[{
                RowBox[{"0", " ", "id2"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", "Z"}], "}"}]}],
                "]"}], ",", " ", 
              RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}], " ", "/.", 
            " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x", " ", "->", " ", 
               RowBox[{"x", "[", "t", "]"}]}], ",", " ", 
              RowBox[{"y", " ", "->", " ", 
               RowBox[{"y", "[", "t", "]"}]}], ",", " ", 
              RowBox[{"z", " ", "->", " ", 
               RowBox[{"z", "[", "t", "]"}]}]}], "}"}]}], ")"}]}], "]"}], ",",
         "\n", "     ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", "0", "]"}], " ", "==", " ", "x0"}], ",", " ", 
          RowBox[{
           RowBox[{"y", "[", "0", "]"}], " ", "==", " ", "y0"}], ",", " ", 
          RowBox[{
           RowBox[{"z", "[", "0", "]"}], " ", "==", " ", "z0"}]}], "}"}]}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", "t"}], 
     "]"}]}]}]}]}], "Input",
 CellLabel->"In[44]:= ",
 CellID->902867877,ExpressionUUID->"3e44340b-ef5c-51d5-667b-ae548ae9233f"],

Cell[TextData[{
 "The transverse components decay exponentially, ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "321034f4-436e-dcec-622f-adbe7618a636"],
 " is frozen. Check the closed form against the master equation over time:"
}], "Text",
 CellID->1315202099,ExpressionUUID->"1287d3f9-6500-de4e-42bc-caa30cbaa494"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"gg", " ", "=", " ", "0.5"}], ",", " ", 
     RowBox[{"a0", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"0.8", ",", " ", "0.4", ",", " ", "0.3"}], "}"}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"Max", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"closedDephasing", "[", "tt", "]"}], " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
            RowBox[{"x0", " ", "->", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
            RowBox[{"y0", " ", "->", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
            RowBox[{"z0", " ", "->", " ", 
             RowBox[{"a0", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], ")"}], " ", "-", 
        "\n", "    ", 
        RowBox[{"blochVector", "[", 
         RowBox[{"evolve", "[", 
          RowBox[{
           RowBox[{"0", " ", "id2"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sqrt", "[", "gg", "]"}], " ", "Z"}], "}"}], ",", " ", 
           RowBox[{"blochState", " ", "@@", " ", "a0"}], ",", " ", "tt"}], 
          "]"}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"tt", ",", " ", "0", ",", " ", "3", ",", " ", "0.3"}], "}"}]}],
      "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[45]:= ",
 CellID->376763343,ExpressionUUID->"3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],

Cell["They agree to rounding.", "Text",
 CellID->126027414,ExpressionUUID->"087f5f2f-6486-1b59-3805-56890d3369a3"],

Cell[TextData[{
 "Because ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],
 " never changes, there is no unique steady state: any mixture of ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13ecd9ee-6506-67bb-4193-d0c80cb34d81"],
 " is stationary. Ask the toolkit for all the steady states of the dephasing \
generator:"
}], "Text",
 CellID->570920987,ExpressionUUID->"6724c974-bdf1-27a5-0edb-e13e3b858d8f"],

Cell[BoxData[
 RowBox[{"steadyState", "[", 
  RowBox[{
   RowBox[{"0", " ", "id2"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sqrt", "[", "0.5", "]"}], " ", "Z"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[46]:= ",
 CellID->378517449,ExpressionUUID->"2b52875c-0948-9ae8-5961-1f06a8e2e832"],

Cell[TextData[{
 "The two poles return, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["e", "TI"]},
    "Ket"], 
   TemplateBox[{
     StyleBox["e", "TI"]},
    "Bra"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53412643-5a68-df00-017e-b82d5f02a26a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["g", "TI"]},
    "Ket"], 
   TemplateBox[{
     StyleBox["g", "TI"]},
    "Bra"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "696f5b1d-d56b-3a26-1f15-5346dc1f890c"],
 ", each a stationary density matrix on its own. Count them:"
}], "Text",
 CellID->1671903560,ExpressionUUID->"0eb02373-2484-618c-364f-bb3d4d3133d6"],

Cell[BoxData[
 RowBox[{"Length", "@", "%"}]], "Input",
 CellLabel->"In[47]:= ",
 CellID->1307059254,ExpressionUUID->"640353f1-ff8e-e9b3-0c31-4abafa38bb99"],

Cell[TextData[{
 "Two, so a whole line of mixtures between them: a degenerate steady state. \
Every ",
 StyleBox["driven", "TI"],
 " system in the catalog has a unique steady state; the degeneracy returns \
only where the drive is off and the dynamics is again pure dephasing, as in \
the undriven measurement-induced localization of Part Five."
}], "Text",
 CellID->538512558,ExpressionUUID->"37161f66-4600-a3a8-5d2d-974073baf1f2"],

Cell[TextData[{
 "Now visualize the dephasing behavior above: start two Bloch vectors \
off-axis and watch each slide straight toward the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e44757e-c407-f813-567c-6d3bedb3cb79"],
 "-axis (ball to diamond), keeping its height, while the poles (black dots) \
stay fixed:"
}], "Text",
 CellID->824717693,ExpressionUUID->"07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"gg", " ", "=", " ", "0.6"}], ",", " ", 
     RowBox[{"starts", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.85", ",", " ", "0.25", ",", " ", "0.4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.6"}], ",", " ", 
          RowBox[{"-", "0.55"}], ",", " ", 
          RowBox[{"-", "0.35"}]}], "}"}]}], "}"}]}]}], "}"}], ",", "\n", " ", 
   
   RowBox[{"blochPlot", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"closedDephasing", "[", "tt", "]"}], " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
            RowBox[{"x0", " ", "->", " ", 
             RowBox[{"s", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
            RowBox[{"y0", " ", "->", " ", 
             RowBox[{"s", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
            RowBox[{"z0", " ", "->", " ", 
             RowBox[{"s", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"tt", ",", " ", "0", ",", " ", "2.5", ",", " ", "0.05"}], 
          "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "starts"}], "}"}]}], "]"}], ",", "\n", 
     "  ", "\"\<dephasing slides each state to the z-axis\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<start (0.85, 0.25, 0.4)\>\"", ",", 
       " ", "\"\<start (-0.6, -0.55, -0.35)\>\""}], "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"Black", ",", " ", 
       RowBox[{"PointSize", "[", "0.03", "]"}], ",", " ", 
       RowBox[{"Point", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], "]"}], ",", " ", 
       
       RowBox[{"Point", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[48]:= ",
 CellID->496527141,ExpressionUUID->"539b0e4e-9e5a-5525-01b8-a0281bef3c0f"],

Cell[TextData[{
 "Each tip drifts to the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd82739-42e3-b7ed-44e7-bf6376971d37"],
 "-axis and stops at its own height: the transverse coherence is gone, the \
populations untouched. This is dephasing in its purest form, decoherence with \
nothing else attached."
}], "Text",
 CellID->2009363188,ExpressionUUID->"0971a20b-7913-467e-3f0e-445578a62d44"],

Cell["A Driven, Damped Atom Relaxing to Steady State", "Subsection",
 CellID->55669068,ExpressionUUID->"09df342d-d743-5809-3fe4-ae76e2f62b53"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A two-level atom driven by a laser (a drive about ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"],
 ") while it decays to its ground state:"
}], "Text",
 CellID->1753574084,ExpressionUUID->"21fdaace-430e-f3f9-5782-43a876b8c1c3"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"\[ScriptCapitalL]", 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], " ", 
    FractionBox["\[CapitalOmega]", "2"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["x", "TI"]], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Gamma]", "TI"], " ", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2038359728,ExpressionUUID->"1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"],

Cell[TextData[{
 "In Bloch components ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "."], "=", "-", 
   FractionBox[
    StyleBox["\[Gamma]", "TI"], "2"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["y", "TI"], "."], "=", "-", "\[CapitalOmega]", 
   StyleBox["z", "TI"], "-", 
   FractionBox[
    StyleBox["\[Gamma]", "TI"], "2"], 
