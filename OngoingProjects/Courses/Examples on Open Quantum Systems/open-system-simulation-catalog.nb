   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["j", "TI"], "\[Element]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["I", "TI"], ",", 
      RowBox[{
       RowBox[{
        StyleBox["Q", "TI"], "}"}], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1357963930,ExpressionUUID->"07beae85-a317-6bf9-2d45-47eed6a239c3"],

Cell[TextData[{
 StyleBox["Quantum Zeno dynamics.",
  FontWeight->"Bold"],
 " For the code's monitored operator ",
