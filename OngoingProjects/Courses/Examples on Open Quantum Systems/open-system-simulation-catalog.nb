  "3db10d53-0e34-1357-6b4e-a51dabc161bd"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["xp",
     FontSlant->"Plain"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e4bd926-69e3-4ee0-6648-d0800f9614ca"],
 ":"
}], "Text",
 CellID->1089240833,ExpressionUUID->"57d10123-a1d4-e454-7dee-988cd066cebe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"riccatiCool", "[", "\[Eta]_", "]"}], " ", ":=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"vx", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"vc", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"4", " ", "\[Eta]", " ", "kCool", " ", 
          RowBox[{
           RowBox[{"vx", "[", "t", "]"}], "^", "2"}]}], " ", "-", " ", 
         RowBox[{"gammaCool", " ", 
          RowBox[{"vx", "[", "t", "]"}]}], " ", "+", " ", 
         RowBox[{"gammaCool", " ", 
          RowBox[{"(", 
           RowBox[{"nCool", " ", "+", " ", 
            RowBox[{"1", "/", "2"}]}], ")"}]}]}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"vc", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"vp", "[", "t", "]"}], " ", "-", " ", 
         RowBox[{"vx", "[", "t", "]"}], " ", "-", " ", 
         RowBox[{"4", " ", "\[Eta]", " ", "kCool", " ", 
          RowBox[{"vx", "[", "t", "]"}], " ", 
          RowBox[{"vc", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"gammaCool", " ", 
          RowBox[{"vc", "[", "t", "]"}]}]}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"vp", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{"vc", "[", "t", "]"}]}], " ", "+", " ", "kCool", " ", "-", 
         " ", 
         RowBox[{"4", " ", "\[Eta]", " ", "kCool", " ", 
          RowBox[{
           RowBox[{"vc", "[", "t", "]"}], "^", "2"}]}], " ", "-", " ", 
         RowBox[{"gammaCool", " ", 
          RowBox[{"vp", "[", "t", "]"}]}], " ", "+", " ", 
         RowBox[{"gammaCool", " ", 
          RowBox[{"(", 
           RowBox[{"nCool", " ", "+", " ", 
            RowBox[{"1", "/", "2"}]}], ")"}]}]}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"vx", "[", "0", "]"}], " ", "==", " ", 
        RowBox[{"nCool", " ", "+", " ", 
         RowBox[{"1", "/", "2"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"vc", "[", "0", "]"}], " ", "==", " ", "0."}], ",", " ", 
       RowBox[{
        RowBox[{"vp", "[", "0", "]"}], " ", "==", " ", 
        RowBox[{"nCool", " ", "+", " ", 
         RowBox[{"1", "/", "2"}]}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"vx", ",", " ", "vc", ",", " ", "vp"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "80"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[259]:= ",
 CellID->1426757747,ExpressionUUID->"27645c90-4345-b83d-4d1c-55da76f10b07"],

Cell["\<\
The steady covariance, read off the late-time solution, is the sharpest the \
observer can ever know the oscillator:\
\>", "Text",
 CellID->892816339,ExpressionUUID->"245848e5-b774-8ea9-4c78-61cec206d4f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"steadyCovCool", "[", "\[Eta]_", "]"}], " ", ":=", " ", 
   RowBox[{"Through", "[", 
    RowBox[{
     RowBox[{"riccatiCool", "[", "\[Eta]", "]"}], "[", "80.", "]"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[260]:= ",
 CellID->1017845166,ExpressionUUID->"0581f938-6b6a-81e3-33be-f1620e1cd3c9"],

Cell[TextData[{
 "Take its three entries at perfect efficiency, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e58b706-7f01-9af1-2667-2f607ab5e8db"],
 ":"
}], "Text",
 CellID->649399840,ExpressionUUID->"0b1945ac-ce61-156f-3927-5c09eb147fb5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"vxCool", ",", " ", "vcCool", ",", " ", "vpCool"}], "}"}], " ", "=",
    " ", 
   RowBox[{"steadyCovCool", "[", "1.", "]"}]}], ";"}]], "Input",
 CellLabel->"In[261]:= ",
 CellID->95053520,ExpressionUUID->"3d8aaa59-0983-f6a5-6b89-4c03a837dc8f"],

Cell[TextData[{
 "Its mean phonon number is the ",
 StyleBox["conditional floor", "TI"],
 ", the lowest occupation the record can pin down:"
}], "Text",
 CellID->823893091,ExpressionUUID->"6f61b3a8-54be-2aae-151e-2af25d4b78f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"condFloorCool", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"vxCool", " ", "+", " ", "vpCool"}], ")"}], "/", "2"}], " ", "-",
     " ", "0.5"}]}], ";"}]], "Input",
 CellLabel->"In[262]:= ",
 CellID->973753736,ExpressionUUID->"334edda2-111d-1275-6175-d40ca0a8615f"],

Cell[TextData[{
 "The Kalman gains ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["xx",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705f43d3-b8fa-6681-2065-5a9d388f4ceb"],
 " and ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["xp",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e6e22f7-e70d-ed4b-3615-bbb092b9b791"],
 " set how hard each record increment steers the estimate:"
}], "Text",
 CellID->308061613,ExpressionUUID->"2f79e66b-a47f-c7f6-5506-f834cd0baddc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kxCool", " ", "=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Sqrt", "[", "kCool", "]"}], " ", "vxCool"}]}], ";", " ", 
  RowBox[{"kpCool", " ", "=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Sqrt", "[", "kCool", "]"}], " ", "vcCool"}]}], ";"}]], "Input",
 CellLabel->"In[263]:= ",
 CellID->218833087,ExpressionUUID->"26eacd00-7450-3870-4ee9-e56a7dea8b5a"],

Cell[TextData[{
 "Here is the key point, and the reason watching alone is not cooling: \
averaged over all records, the unconditional occupation is the conditional \
floor plus the spread of the estimate about it, and that spread solves a \
Lyapunov equation with the closed-loop drift ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["A", "TI"], 
   StyleBox["G", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a9819e1-44ec-6fcb-3aa7-90cb6c993511"],
 " (free rotation, bath damping, and the feedback ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["G", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2241f5e7-2cd3-435b-527e-ecc1456611a1"],
 " on ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["p", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d2e5055-b89d-3ae5-54d6-4a1f392988cf"],
 ") fed by the Kalman-gain noise:"
}], "Text",
 CellID->1362785884,ExpressionUUID->"60242f61-d35b-0cea-11db-c74ae6ee5630"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nUncCool", "[", "gg_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"LyapunovSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "gammaCool"}], "/", "2"}], ",", " ", "1"}], "}"}], 
           ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "gammaCool"}], "/", "2"}], " ", "-", " ", 
              "gg"}]}], "}"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"-", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"kxCool", "^", "2"}], ",", " ", 
              RowBox[{"kxCool", " ", "kpCool"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"kxCool", " ", "kpCool"}], ",", " ", 
              RowBox[{"kpCool", "^", "2"}]}], "}"}]}], "}"}]}]}], "]"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"s", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
         "vxCool", " ", "+", " ", 
         RowBox[{"s", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "+", " ", 
         "vpCool"}], ")"}], "/", "2"}], " ", "-", " ", "0.5"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[264]:= ",
 CellID->800074720,ExpressionUUID->"6b2a7c99-762e-0564-192a-75c303db6c4e"],

Cell[TextData[{
 "With no feedback, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["G", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15f5c2c8-4d3f-e85b-438a-db9264cbbaa1"],
 ", watching does not cool at all: it ",
 StyleBox["heats", "TI"],
 ", because measurement back-action kicks the momentum and nothing removes \
the energy. Confirm this two ways, the conditional-plus-spread bookkeeping \
against the plain unconditional master equation (back-action on ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["pp",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14c9f408-7194-4cc4-3cf6-ee520021162e"],
 ", bath, no information gain):"
}], "Text",
 CellID->154434508,ExpressionUUID->"38fb8547-75f1-44dc-6898-1d2103842e26"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nUncCool", "[", "0.", "]"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", " ", "=", " ", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"vx", "'"}], "[", "t", "]"}], " ", "==", " ", 
            RowBox[{
             RowBox[{"2", " ", 
              RowBox[{"vc", "[", "t", "]"}]}], " ", "-", " ", 
             RowBox[{"gammaCool", " ", 
              RowBox[{"vx", "[", "t", "]"}]}], " ", "+", " ", 
             RowBox[{"gammaCool", " ", 
              RowBox[{"(", 
               RowBox[{"nCool", " ", "+", " ", 
                RowBox[{"1", "/", "2"}]}], ")"}]}]}]}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"vc", "'"}], "[", "t", "]"}], " ", "==", " ", 
            RowBox[{
             RowBox[{"vp", "[", "t", "]"}], " ", "-", " ", 
             RowBox[{"vx", "[", "t", "]"}], " ", "-", " ", 
             RowBox[{"gammaCool", " ", 
              RowBox[{"vc", "[", "t", "]"}]}]}]}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"vp", "'"}], "[", "t", "]"}], " ", "==", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              RowBox[{"vc", "[", "t", "]"}]}], " ", "+", " ", "kCool", " ", "-",
              " ", 
             RowBox[{"gammaCool", " ", 
              RowBox[{"vp", "[", "t", "]"}]}], " ", "+", " ", 
             RowBox[{"gammaCool", " ", 
              RowBox[{"(", 
               RowBox[{"nCool", " ", "+", " ", 
                RowBox[{"1", "/", "2"}]}], ")"}]}]}]}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"vx", "[", "0", "]"}], " ", "==", " ", 
            RowBox[{"nCool", " ", "+", " ", "0.5"}]}], ",", " ", 
           RowBox[{
            RowBox[{"vc", "[", "0", "]"}], " ", "==", " ", "0."}], ",", " ", 
           RowBox[{
            RowBox[{"vp", "[", "0", "]"}], " ", "==", " ", 
            RowBox[{"nCool", " ", "+", " ", "0.5"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"vx", ",", " ", "vp"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "200"}], "}"}]}], "]"}]}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "[", "200.", "]"}], " ", "+", " ", 
         
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "[", "200.", "]"}]}], ")"}], "/", 
       "2"}], " ", "-", " ", "0.5"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[265]:= ",
 CellID->1025583273,ExpressionUUID->"71ac5ef3-5fe8-d867-2754-57bd5982ab4d"],

Cell[TextData[{
 "Both give the same number, above the bath's ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]], "=", "10"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29854b4c-a654-c8a2-5fbb-6329d3e69a88"],
 ": the meter alone leaves the oscillator hotter than it found it."
}], "Text",
 CellID->194843868,ExpressionUUID->"59c17136-c551-666f-0fff-6973ece44cb5"],

Cell["\<\
Now close the loop. The conditional mean is a stochastic trajectory driven by \
the innovation, with the feedback force damping the momentum estimate:\
\>", "Text",
 CellID->763032948,ExpressionUUID->"345db6df-ede1-7415-5c62-2f988b945f7f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Gcool", " ", "=", " ", "2."}], ";", " ", 
  RowBox[{"dtCool", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"nStepCool", " ", "=", " ", "2500"}], ";", " ", 
  RowBox[{"timesCool", " ", "=", " ", 
   RowBox[{"dtCool", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "nStepCool"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[266]:= ",
 CellID->1903978139,ExpressionUUID->"23d8e320-2d42-669a-51e7-fa8a44f74ce0"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "296ab46d-a3f4-f13b-5f69-2e36d586c001"],
 " the oscillator is thermal, so the total covariance is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1", "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cac3d4d-2028-a76d-1453-b51751c20db7"],
 ". That total splits into the conditional floor the filter always carries \
plus the spread of the estimate about it, so the means must be drawn with the \
full ",
 StyleBox["difference", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", 
    FractionBox["1", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\|01d7d9", "-", 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f515ffd-22dc-f8c8-256f-56a7576eca12"],
 ", including its off-diagonal ",
 Cell[BoxData[
  RowBox[{"-", 
   SubscriptBox[
    StyleBox["v", "TI"], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36fe791f-fced-9eb8-5e86-7158f499e482"],
 ", to avoid double-counting the initial uncertainty and to make the initial \
unconditional state exactly thermal:"
}], "Text",
 CellID->1178571435,ExpressionUUID->"76a256fd-37ed-da8a-1e52-4fa74199a8d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"meanRunCool", "[", 
    RowBox[{"gg_", ",", " ", "seed_"}], "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"init", " ", "=", " ", 
          RowBox[{"RandomVariate", "[", 
           RowBox[{"MultinormalDistribution", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0.", ",", " ", "0."}], "}"}], ",", "\n", "        ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                 "nCool", " ", "+", " ", "0.5", " ", "-", " ", "vxCool"}], ",",
                  " ", 
                 RowBox[{"-", "vcCool"}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "vcCool"}], ",", " ", 
                 RowBox[{
                 "nCool", " ", "+", " ", "0.5", " ", "-", " ", "vpCool"}]}], 
                "}"}]}], "}"}]}], "]"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{"kicks", " ", "=", " ", 
          RowBox[{"RandomVariate", "[", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"Sqrt", "[", "dtCool", "]"}]}], "]"}], ",", " ", 
            "nStepCool"}], "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"FoldList", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"xp", ",", " ", "dw"}], "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"xp", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"xp", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
                 RowBox[{
                  RowBox[{"gammaCool", "/", "2"}], " ", 
                  RowBox[{"xp", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], " ", "dtCool"}],
               " ", "+", " ", 
              RowBox[{"kxCool", " ", "dw"}]}], ",", "\n", "       ", 
             RowBox[{
              RowBox[{"xp", "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", "+", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"xp", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], " ", "-", " ", 
                 RowBox[{
                  RowBox[{"gammaCool", "/", "2"}], " ", 
                  RowBox[{"xp", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], " ", "-", " ", 
                 RowBox[{"gg", " ", 
                  RowBox[{"xp", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}], " ", "dtCool"}],
               " ", "+", " ", 
              RowBox[{"kpCool", " ", "dw"}]}]}], "}"}]}], "]"}], ",", "\n", 
         "     ", "init", ",", " ", "kicks"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[267]:= ",
 CellID->324779341,ExpressionUUID->"6deb6a83-c2a1-684f-1be8-83ecf7543a95"],

Cell["\<\
The unconditional occupation in time is the ensemble spread of these means \
plus the conditional floor. Track it with the loop open and closed:\
\>", "Text",
 CellID->1319522016,ExpressionUUID->"789236d2-9f43-12ba-28a1-af9c1af66080"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nEnsCool", " ", "=", " ", "120"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nDrainCool", "[", "gg_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ens", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"meanRunCool", "[", 
          RowBox[{"gg", ",", " ", "s"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"s", ",", " ", "nEnsCool"}], "}"}]}], "]"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Variance", "[", 
            RowBox[{"ens", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "j", ",", " ", "1"}], "]"}], "]"}], 
            "]"}], " ", "+", " ", "vxCool", " ", "+", " ", 
           RowBox[{"Variance", "[", 
            RowBox[{"ens", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "j", ",", " ", "2"}], "]"}], "]"}], 
            "]"}], " ", "+", " ", "vpCool"}], ")"}], "/", "2"}], " ", "-", 
        " ", "0.5"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "1", ",", " ", 
         RowBox[{"nStepCool", " ", "+", " ", "1"}], ",", " ", "25"}], "}"}]}],
       "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"coolOff", ",", " ", "coolOn"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"nDrainCool", "[", "0.", "]"}], ",", " ", 
     RowBox[{"nDrainCool", "[", "Gcool", "]"}]}], "}"}]}], ";"}]}], "Input",
 CellLabel->"In[268]:= ",
 CellID->536221529,ExpressionUUID->"383adb7b-ef12-e6f5-69d9-d3248aa4ccdf"],

Cell["\<\
Now visualize the cooling: the occupation with the loop off (heating above \
the bath) and on (draining toward, but not reaching, the conditional floor):\
\>", "Text",
 CellID->327893574,ExpressionUUID->"4d2f2d89-c57c-c791-74d4-c4d2ec0eadfb"],

