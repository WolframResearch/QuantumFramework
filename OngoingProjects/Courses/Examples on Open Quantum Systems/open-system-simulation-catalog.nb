  "7ba8138a-66ce-478c-2957-8ad4137b2dd6"],
 " far apart."
}], "Text",
 CellID->2117504204,ExpressionUUID->"35c9e6d4-f3c4-84c1-63f6-ff918676ee2b"],

Cell["\<\
Now watch the two cats decohere under the same leak. Evolve each under the \
cavity's master equation across the delays:\
\>", "Text",
 CellID->201091240,ExpressionUUID->"6fd66644-13e4-6fa7-15ee-782ea591358d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"harTimes", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.", ",", " ", "0.5", ",", " ", "1.0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"harSmall", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{"0", " ", "blankHar"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "\[Gamma]har", "]"}], " ", "downHar"}], "}"}], ",",
      " ", 
     RowBox[{"catRho", "[", "0.5", "]"}], ",", " ", 
     RowBox[{"Max", "[", "harTimes", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"harLarge", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{"0", " ", "blankHar"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "\[Gamma]har", "]"}], " ", "downHar"}], "}"}], ",",
      " ", 
     RowBox[{"catRho", "[", "1.3", "]"}], ",", " ", 
     RowBox[{"Max", "[", "harTimes", "]"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[79]:= ",
 CellID->667003370,ExpressionUUID->"00abf1cf-696b-3507-30a8-e8a9081f9c6d"],

Cell["Build one Wigner film per phase:", "Text",
 CellID->526043023,ExpressionUUID->"03d898fe-d35a-9eef-31e7-11bbe6ece435"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"harFilmSmall", " ", "=", " ", 
   RowBox[{"Table", "[", 
