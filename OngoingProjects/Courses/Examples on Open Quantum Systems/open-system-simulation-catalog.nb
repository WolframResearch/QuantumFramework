Cell["\<\
Now set it in motion from the displaced start: the Wigner bump rides the gray \
path in toward the origin as friction drains the mean, and fills out to the \
thermal size as diffusion widens it, the red dot marking where the mean sits \
at each instant. Press play:\
\>", "Text",
 CellID->1158471628,ExpressionUUID->"3540c51c-f580-c338-637f-dd59fc3aae02"],

Cell[BoxData[
 RowBox[{"Animate", "[", 
  RowBox[{
   RowBox[{"Show", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"DensityPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"wignerGaussian", "[", "t", "]"}], "[", 
        RowBox[{"x", ",", " ", "p"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", 
         RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"PlotPoints", " ", "->", " ", "60"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "    ", 
       RowBox[{"ColorFunction", " ", "->", " ", "\"\<SunsetColors\>\""}], ",",
        " ", 
       RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "400"}], ",", "\n", "    ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"\"\<Wigner W(x,p) at t = \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "t", "]"}]}]}], ",", "\n", "    ", 
       RowBox[{"Epilog", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Red", ",", " ", 
          RowBox[{"Point", "[", 
           RowBox[{"center", "[", "t", "]"}], "]"}]}], "}"}]}]}], "]"}], ",", 
     " ", "centerLine"}], "]"}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "25", ",", " ", ".1"}], "}"}], ",", 
   " ", 
   RowBox[{"AnimationRunning", " ", "->", " ", "False"}]}], "]"}]], "Input",
 CellLabel->"In[112]:= ",
 CellID->600867794,ExpressionUUID->"684f0173-fe99-1571-1874-993cfb2c7c5b"],

Cell[TextData[{
 "It stays a single Gaussian bump the whole way, never developing finer \
structure: the state never leaves the five-number family, the closure that \
let five equations describe it in the first place. Friction and diffusion are \
the same bath's two effects, tied by the fluctuation-dissipation relation: \
the friction rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e32c5a8-aee9-5273-17c1-dcf5ca9c2159"],
 " is set by the coupling, while the diffusion (and so the thermal spread the \
blob swells to) grows with temperature."
}], "Text",
 CellID->570648126,ExpressionUUID->"607492e2-157b-ba0c-100b-0bcc9c0f0956"],

Cell[TextData[{
 "The sharper effect, and why this sits beside the cavity cat: a \
superposition of two positions decoheres, and a warm bath does it faster than \
a cold one. Here the model changes from the Caldeira-Leggett moment equations \
above to the thermal-oscillator Lindblad master equation (a decay channel ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7781757c-388d-abb9-1dbf-6d26b939f983"],
 " at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "566e7348-207a-dc95-7e16-6b12510ca6ff"],
 " and an excitation channel ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39672ae7-82f4-b353-6f1c-c3c1368601b9"],
 " at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c48aba4-6f27-6a39-3477-420e0ad23903"],
 ", the same warm-bath form used later for thermalization), integrated in a \
truncated Fock basis. Build the same coherent-state cat and evolve it under \
that bath. Set the oscillator cutoff and the bath's rate:"
}], "Text",
 CellID->1943045306,ExpressionUUID->"2f62374d-f3df-131c-5511-af16866a7e66"],

Cell[BoxData[
 RowBox[{
  RowBox[{"twoRung", " ", "=", " ", "22"}], ";", " ", 
  RowBox[{"\[Gamma]warm", " ", "=", " ", "0.5"}], ";"}]], "Input",
 CellLabel->"In[113]:= ",
 CellID->1695469705,ExpressionUUID->"455ea632-3d4d-f0d3-7365-387cb4f9c239"],

Cell[TextData[{
 "The surviving coherence is the trace distance between the coherently \
evolved cat and the classical mixture its two lobes would form, both carried \
through the same thermal bath ",
 Cell[BoxData[
  RowBox[{"\[ScriptCapitalL]", 
   StyleBox["\[Rho]", "TI"], "=", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["T", "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], " ", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"], "+", 
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["T", "TI"]], " ", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f0fb95c-030e-c889-4534-3106b6b89ad3"],
 ":"
}], "Text",
 CellID->808446663,ExpressionUUID->"16268eae-a572-7912-3fdd-270bcc074878"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["warmCoherence",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["T", "TI"]], ",", 
       StyleBox["\[Alpha]", "TI"], ",", 
       StyleBox["t", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      StyleBox["Tr",
       FontSlant->"Plain"]}], 
     StyleBox["|",
      SpanMaxSize->1,
      FontSize->1.2 Inherited], 
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], 
        StyleBox["cat",
         FontSlant->"Plain"]], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["t", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}]}], "-", 
      RowBox[{
       FractionBox["1", "2"], 
       StyleBox["[",
        FontSize->1.2 Inherited], 
       RowBox[{
        RowBox[{
         SubscriptBox[
          StyleBox["\[Rho]", "TI"], 
          RowBox[{"+", 
           StyleBox["\[Alpha]", "TI"]}]], 
         RowBox[{
          StyleBox["(",
           SpanMaxSize->1], 
          StyleBox["t", "TI"], 
          StyleBox[")",
           SpanMaxSize->1]}]}], "+", 
        RowBox[{
         SubscriptBox[
          StyleBox["\[Rho]", "TI"], 
          RowBox[{"-", 
           StyleBox["\[Alpha]", "TI"]}]], 
         RowBox[{
          StyleBox["(",
           SpanMaxSize->1], 
          StyleBox["t", "TI"], 
          StyleBox[")",
           SpanMaxSize->1]}]}]}], 
       StyleBox["]",
        FontSize->1.2 Inherited]}]}], 
     StyleBox["|",
      SpanMaxSize->1,
      FontSize->1.2 Inherited]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["cat",
       FontSlant->"Plain"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"\[ScriptCapitalL]", 
       StyleBox["t", "TI"]}]], 
     StyleBox["[",
      FontSize->1.2 Inherited], 
     RowBox[{
      TemplateBox[{
        StyleBox["cat", FontSlant -> "Plain"]},
       "Ket"], 
      TemplateBox[{
        StyleBox["cat", FontSlant -> "Plain"]},
       "Bra"]}], 
     StyleBox["]",
      FontSize->1.2 Inherited]}]}], ",", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      RowBox[{"\[PlusMinus]", 
       StyleBox["\[Alpha]", "TI"]}]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"\[ScriptCapitalL]", 
       StyleBox["t", "TI"]}]], 
     StyleBox["[",
      FontSize->1.2 Inherited], 
     RowBox[{
      TemplateBox[{
        RowBox[{"\[PlusMinus]", 
          StyleBox["\[Alpha]", "TI"]}]},
       "Ket"], 
      TemplateBox[{
        RowBox[{"\[PlusMinus]", 
          StyleBox["\[Alpha]", "TI"]}]},
       "Bra"]}], 
     StyleBox["]",
      FontSize->1.2 Inherited]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->843355028,ExpressionUUID->"346a0e1a-2221-987e-5c69-a04457d5eb44"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["gap",
    FontSlant->"Plain"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "366be24c-537a-43bb-5e68-0416660f1181"],
 ". It is largest while the cat is still distinct from that mixture and falls \
to zero as the cross-terms decohere (both thermalize to the same steady \
state, so the distance can only shrink). The bath's ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "501b1457-1a1d-907b-0038-8e119fa9e341"],
 " channel heats a coherent state, so the two lobes will not stay coherent \
and are evolved rather than written down; compute it over a list of delays, \
one run each for the cat and its lobes:"
}], "Text",
 CellID->2123001010,ExpressionUUID->"291c68e0-f532-6cdd-5f23-81cdfcc73627"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"warmCoherence", "[", 
    RowBox[{"nT_", ",", " ", "gap_", ",", " ", "delays_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fall", " ", "=", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"\[Gamma]warm", " ", 
           RowBox[{"(", 
            RowBox[{"nT", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", 
         RowBox[{"annihilation", "[", "twoRung", "]"}]}]}], ",", " ", 
       RowBox[{"climb", " ", "=", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"\[Gamma]warm", " ", "nT"}], "]"}], " ", 
         RowBox[{"creation", "[", "twoRung", "]"}]}]}], ",", "\n", "    ", 
       RowBox[{"pair", " ", "=", " ", 
        RowBox[{"densityMatrix", "@", 
         RowBox[{"Normalize", "[", 
          RowBox[{
           RowBox[{"coherentState", "[", 
            RowBox[{"twoRung", ",", " ", "gap"}], "]"}], " ", "+", " ", 
           RowBox[{"coherentState", "[", 
            RowBox[{"twoRung", ",", " ", 
             RowBox[{"-", "gap"}]}], "]"}]}], "]"}]}]}], ",", "\n", "    ", 
       RowBox[{"blobA", " ", "=", " ", 
        RowBox[{"densityMatrix", "[", 
         RowBox[{"coherentState", "[", 
          RowBox[{"twoRung", ",", " ", "gap"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"blobB", " ", "=", " ", 
        RowBox[{"densityMatrix", "[", 
         RowBox[{"coherentState", "[", 
          RowBox[{"twoRung", ",", " ", 
           RowBox[{"-", "gap"}]}], "]"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"runs", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"evolveODE", "[", 
            RowBox[{
             RowBox[{"0", " ", 
              RowBox[{"IdentityMatrix", "[", "twoRung", "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"fall", ",", " ", "climb"}], "}"}], ",", " ", "#", ",", 
             " ", 
             RowBox[{"Max", "[", "delays", "]"}]}], "]"}], " ", "&"}], " ", "/@",
           " ", 
          RowBox[{"{", 
           RowBox[{"pair", ",", " ", "blobA", ",", " ", "blobB"}], "}"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "@", 
           RowBox[{"SingularValueList", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"runs", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", "t", "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"runs", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "[", "t", "]"}], " ", "+", 
                " ", 
                RowBox[{
                 RowBox[{"runs", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}]}], ")"}], "/",
               "2"}]}], "]"}]}], "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "delays"}], "}"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[114]:= ",
 CellID->1415208481,ExpressionUUID->"5c29c458-c353-7b98-05d6-de05f6e649e2"],

Cell["\<\
Now visualize the temperature dependence by comparing a cold and a warm bath \
at the same separation:\
\>", "Text",
 CellID->80082845,ExpressionUUID->"6e1a2d6a-d2ad-c32a-1639-c537e759ae70"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"warmTimes", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", "1.5", ",", " ", "0.06"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"warmTimes", ",", " ", 
        RowBox[{"warmCoherence", "[", 
         RowBox[{"0.15", ",", " ", "1.5", ",", " ", "warmTimes"}], "]"}]}], 
       "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"warmTimes", ",", " ", 
        RowBox[{"warmCoherence", "[", 
         RowBox[{"1.5", ",", " ", "1.5", ",", " ", "warmTimes"}], "]"}]}], 
       "}"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<cold bath\>\"", ",", " ", "\"\<warm bath\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<surviving coherence\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<a warm bath decoheres the cat faster than a cold one\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[115]:= ",
 CellID->730828669,ExpressionUUID->"6eb5612b-2266-f0f1-164b-79755710c2db"],

Cell[TextData[{
 "The warm bath decoheres the cat far faster: the rate grows with \
temperature. As with the cavity cat, the rate also grows with the separation: \
together the decoherence rate scales as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    OverscriptBox[
     StyleBox["n", "TI"], "_"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f4b4965-e043-b514-4549-614e91f71c7e"],
 " times the ",
 StyleBox["square", "TI"],
 " of the separation. The ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf36e21-2d79-2b6f-0980-878b440c79b5"],
 " is the zero-point (vacuum) term that decoheres even a cold cavity cat; \
temperature adds to it, so heating speeds decoherence but is not what starts \
it. For macroscopic separations the rate is enormous at any temperature: the \
fuller answer to why superpositions of large objects become so difficult to \
preserve as their separation grows. Sweep the cat size continuously at the \
fixed short delay, and the two effects trade off:"
}], "Text",
 CellID->20229285,ExpressionUUID->"6fe9f85b-1ce6-27f0-1596-f20594908dda"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sep", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "3", ",", " ", "0.05"}], "]"}]}], "}"}], ",", 
     " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", " ", 
         RowBox[{
          RowBox[{"warmCoherence", "[", 
           RowBox[{"1.5", ",", " ", "#", ",", " ", 
            RowBox[{"{", "0.15", "}"}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", " ",
       "sep"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "460"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<cat separation\>\"", ",", 
      " ", "\"\<surviving coherence at fixed short delay\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<surviving coherence peaks at a modest cat size, then \
falls\>\""}]}], "]"}]], "Input",
 CellLabel->"In[116]:= ",
 CellID->865532999,ExpressionUUID->"3eadea9f-7d43-757d-6652-03d974f65c47"],

Cell["\<\
The curve is not monotonic: a bigger cat starts with more coherence but \
decoheres faster, at a rate set by the separation squared, so at a fixed \
short delay the two trade off and the coherence peaks at a modest size before \
the quadratic decoherence overruns it. (Stop at separation 3: past there the \
Fock cutoff clips the coherent states.)\
\>", "Text",
 CellID->1719354248,ExpressionUUID->"68be2dd2-eea3-f2cb-1845-c49f8b57c011"],

Cell["Part Four: One Leak, Three Ways to Watch It", "Section",
 CellID->803807756,ExpressionUUID->"1279eb8d-ef8a-5dbb-4206-02d68a3f2781"],

Cell[TextData[{
 "So far we mostly averaged over the record. Now we keep it. The key fact: \
the same master equation can be ",
 StyleBox["unravelled",
  FontWeight->"Bold"],
 " into trajectories in genuinely different ways, each giving different \
single histories that all average to the same master equation. We watch one \
driven, emitting atom three ways. Fix the atom, its drive, its decay channel, \
and the time grid:"
}], "Text",
 CellID->601042471,ExpressionUUID->"6afb4307-9f81-9d1b-1a99-5b611a35e461"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalOmega]atom", " ", "=", " ", "3.0"}], ";", " ", 
  RowBox[{"\[Gamma]atom", " ", "=", " ", "1.0"}], ";", " ", 
  RowBox[{"Hdrive", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[CapitalOmega]atom", "/", "2"}], ")"}], " ", "X"}]}], ";", " ", 
  RowBox[{"cAtom", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "\[Gamma]atom", "]"}], " ", "lower"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dtAtom", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"when", " ", "=", " ", 
   RowBox[{"dtAtom", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "600"}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[117]:= ",
 CellID->2038927162,ExpressionUUID->"2e902be9-4fb4-3e90-56af-c2b36a4684fa"],

Cell["A reader for the excited-state population:", "Text",
 CellID->1188205371,ExpressionUUID->"46e8ad28-93a4-355d-6e97-457226569fa7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"excitedPop", "[", "rho_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{
       RowBox[{"blochVector", "[", "rho", "]"}], "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "/", "2"}]}], ";"}]], "Input",\

 CellLabel->"In[118]:= ",
 CellID->1003860385,ExpressionUUID->"43090fa7-5002-8b65-7136-a60161b4d64f"],

Cell["\<\
Integrate the master equation for the population every unravelling must \
average back to:\
\>", "Text",
 CellID->952137231,ExpressionUUID->"0d6689b0-bbf9-a698-3b1d-20fa3d8d0ce2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"smoothAtom", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{"Hdrive", ",", " ", 
     RowBox[{"{", "cAtom", "}"}], ",", " ", 
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "6.0"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"averageChance", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"excitedPop", "[", 
      RowBox[{"smoothAtom", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
    " ", "when"}]}], ";"}]}], "Input",
 CellLabel->"In[119]:= ",
 CellID->1052272830,ExpressionUUID->"4ac87485-b214-a6e0-7ac8-6deec7a60cca"],

Cell["Counting the Flashes, One at a Time", "Subsection",
 CellID->775731387,ExpressionUUID->"56e1d4b5-6b25-2976-7e9e-cdff0ed0785c"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Any leak ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e41722a-1026-02f0-567f-7474a1d350da"],
 " can be ",
 StyleBox["unravelled", "TI"],
 " by watching its output, each way of detecting the emitted light giving one \
unravelling into pure-state histories. Counting photons one click at a time \
gives the jump trajectory"
}], "Text",
 CellID->975612517,ExpressionUUID->"6aacec8a-85e6-bbaa-1a53-05d4339009f0"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     TemplateBox[{
       StyleBox["\[Psi]", "TI"]},
      "Ket"]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["[",
       FontSize->1.8 Inherited], 
      RowBox[{
       RowBox[{
        StyleBox["d", "TI"], 
        StyleBox["N", "TI"], 
        RowBox[{
         StyleBox["(",
          FontSize->1.8 Inherited], 
         RowBox[{
          FractionBox[
           OverscriptBox[
            StyleBox["c", "TI"], "^"], 
           SqrtBox[
            RowBox[{
             StyleBox["\[LeftAngleBracket]",
              SpanMaxSize->1], 
             RowBox[{
              SuperscriptBox[
               OverscriptBox[
                StyleBox["c", "TI"], "^"], "\[Dagger]"], 
              OverscriptBox[
               StyleBox["c", "TI"], "^"]}], 
             StyleBox["\[RightAngleBracket]",
              SpanMaxSize->1]}]]], "-", "\|01d7d9"}], 
         StyleBox[")",
          FontSize->1.8 Inherited]}]}], "+", 
       RowBox[{
        StyleBox["d", "TI"], 
        StyleBox["t", "TI"], 
        RowBox[{
         StyleBox["(",
          FontSize->1.8 Inherited], 
         RowBox[{
          FractionBox[
           RowBox[{
            StyleBox["\[LeftAngleBracket]",
             SpanMaxSize->1], 
            RowBox[{
             SuperscriptBox[
              OverscriptBox[
               StyleBox["c", "TI"], "^"], "\[Dagger]"], 
             OverscriptBox[
              StyleBox["c", "TI"], "^"]}], 
            StyleBox["\[RightAngleBracket]",
             SpanMaxSize->1]}], "2"], "-", 
          FractionBox[
           RowBox[{
            SuperscriptBox[
             OverscriptBox[
              StyleBox["c", "TI"], "^"], "\[Dagger]"], 
            OverscriptBox[
             StyleBox["c", "TI"], "^"]}], "2"], "-", 
          RowBox[{
           StyleBox["i", "TI"], 
           OverscriptBox[
            StyleBox["H", "TI"], "^"]}]}], 
         StyleBox[")",
          FontSize->1.8 Inherited]}]}]}], 
      StyleBox["]",
       FontSize->1.8 Inherited]}], 
     TemplateBox[{
       StyleBox["\[Psi]", "TI"]},
      "Ket"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->105335494,ExpressionUUID->"1c51a735-fee5-6802-446e-3f7efa903b68"],

Cell[TextData[{
 "where the click ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["N", "TI"], "\[Element]", "{", "0"}], ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e54a15d-ecde-9aa9-066b-39068568e8f3"],
 " arrives at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27fb6428-ecec-27d4-4d99-7e75849e8d3e"],
 ": between clicks the norm decays under the non-Hermitian ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "-", 
   FractionBox[
    StyleBox["i", "TI"], "2"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51f5ca74-88a2-9d2c-078a-ec3e2954e476"],
 ", and at a click the state jumps by ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["c", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1154648e-ef0b-aa2b-476c-7deb8abff971"],
 ". Averaging ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Bra"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c057904-8649-af2b-743b-716e33fdf271"],
 " over histories returns the master equation exactly. Watch one counted \
history and check the average."
}], "Text",
 CellID->1276006902,ExpressionUUID->"2baf9433-2e90-ebaf-5954-0e7d4b2ab9f5"],

Cell[TextData[{
 "The first way, ",
 StyleBox["photon counting",
  FontWeight->"Bold"],
 ": detect each emitted photon. Between clicks the state evolves under the \
non-Hermitian ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "-", 
   FractionBox[
    StyleBox["i", "TI"], "2"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "340e6ec8-e38f-b030-5c35-8795963b031a"],
 "; at each click it jumps by ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["c", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64bff79f-1679-3ebc-0c44-eed9a30d8486"],
 " to the ground state. A single run is one sweep that does both jobs at \
once: ",
 Cell[BoxData["FoldList"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "126dc52b-3dd5-bd31-4212-dd75b461041b"],
 " advances and keeps the conditioned state at every step (a jump with \
probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28023c0b-10a3-7000-5831-b655a156436a"],
 ", else the no-click drift), while ",
 Cell[BoxData["Sow"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f1b960d-0301-b7cd-7538-0857b6b51d17"],
 " writes down the time whenever the jump fires. It returns the inferred \
state history and the raw click record together, because in a real experiment \
they are one run, not two. Everything that follows, one trajectory, the \
ensemble average, and the waiting-time statistic, reads off realizations of \
this single generator:"
}], "Text",
 CellID->429330924,ExpressionUUID->"268b8fe7-2cf2-fa64-4e88-26c14484c94e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"countingRun", "[", 
    RowBox[{"seed_", ",", " ", "steps_"}], "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"noClick", " ", "=", " ", 
         RowBox[{"MatrixExp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", 
           RowBox[{"(", 
            RowBox[{"Hdrive", " ", "-", " ", 
             RowBox[{
              RowBox[{"I", "/", "2"}], " ", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "cAtom", "]"}], " ", ".", 
               " ", "cAtom"}]}]}], ")"}], " ", "dtAtom"}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", " ", "=", " ", 
           RowBox[{"Reap", "@", 
            RowBox[{"FoldList", "[", "\n", "         ", 
             RowBox[{
              RowBox[{"Function", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"psi", ",", " ", "n"}], "}"}], ",", "\n", 
                "          ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"RandomReal", "[", "]"}], " ", "<", " ", 
                   RowBox[{"dtAtom", " ", 
                    RowBox[{"Re", "[", 
                    RowBox[{
                    RowBox[{"Conjugate", "[", 
                    RowBox[{"cAtom", " ", ".", " ", "psi"}], "]"}], " ", ".", 
                    " ", 
                    RowBox[{"(", 
                    RowBox[{"cAtom", " ", ".", " ", "psi"}], ")"}]}], 
                    "]"}]}]}], ",", "\n", "            ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Sow", "[", 
                    RowBox[{"n", " ", "dtAtom"}], "]"}], ";", " ", 
                    RowBox[{"Normalize", "[", 
                    RowBox[{"cAtom", " ", ".", " ", "psi"}], "]"}]}], ")"}], ",",
                   "\n", "            ", 
                  RowBox[{"Normalize", "[", 
                   RowBox[{"noClick", " ", ".", " ", "psi"}], "]"}]}], 
                 "]"}]}], "]"}], ",", "\n", "         ", "excited", ",", " ", 
              
              RowBox[{"Range", "[", "steps", "]"}]}], "]"}]}]}], "}"}], ",", 
         "\n", "     ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<states\>\"", " ", "->", " ", 
            RowBox[{"First", "[", "r", "]"}]}], ",", " ", 
           RowBox[{"\"\<clicks\>\"", " ", "->", " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Last", "[", "r", "]"}], "]"}]}]}], "|>"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[120]:= ",
 CellID->699653744,ExpressionUUID->"41763b34-5a53-ec31-770d-b37e5fe7b71b"],

Cell["The same population, read from a state vector:", "Text",
 CellID->2118070064,ExpressionUUID->"5d61c4f4-c0fb-847a-0b1e-ddb1f08fef40"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"excitedPopK", "[", "psi_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{"Re", "[", 
       RowBox[{
        RowBox[{"Conjugate", "[", "psi", "]"}], " ", ".", " ", "Z", " ", ".", 
        " ", "psi"}], "]"}]}], ")"}], "/", "2"}]}], ";"}]], "Input",
 CellLabel->"In[121]:= ",
 CellID->1744932242,ExpressionUUID->"72fe9a0c-0c49-239f-2285-1c56a5fc71e5"],

Cell["\<\
Record one counted history over the displayed window, and read its two parts, \
the conditioned states and the click times, straight off the one run:\
\>", "Text",
 CellID->551334296,ExpressionUUID->"14bcbead-0cb8-f132-3c43-37f7a532c018"],

Cell[BoxData[
 RowBox[{
  RowBox[{"oneRun", " ", "=", " ", 
   RowBox[{"countingRun", "[", 
    RowBox[{"3", ",", " ", "600"}], "]"}]}], ";", " ", 
  RowBox[{"oneCount", " ", "=", " ", 
   RowBox[{"oneRun", "[", "\"\<states\>\"", "]"}]}], ";", " ", 
  RowBox[{"oneClicks", " ", "=", " ", 
   RowBox[{"oneRun", "[", "\"\<clicks\>\"", "]"}]}], ";"}]], "Input",
 CellLabel->"In[122]:= ",
 CellID->682025647,ExpressionUUID->"4a015340-38cc-91ca-7a3f-4b2ab97ee310"],

Cell["\<\
Now visualize one counted trajectory's excited-state population against the \
master equation: the trajectory drives up and down and plunges at each \
emission, while the average remains smooth:\
\>", "Text",
 CellID->1646424406,ExpressionUUID->"44807b7f-366d-41a7-6cb0-73394318138d"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{"excitedPopK", " ", "/@", " ", "oneCount"}]}], "}"}], "]"}], ",",
      " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", "averageChance"}], "}"}], "]"}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "Red", ",", " ", "Dashed"}], "]"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<one trajectory (jumps)\>\"", ",", 
      " ", "\"\<master equation\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "500"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<excited-state population\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<photon counting: one trajectory jumps, the average is \
smooth\>\""}]}], "]"}]], "Input",
 CellLabel->"In[123]:= ",
 CellID->2053055694,ExpressionUUID->"56b5d630-2397-dc8b-7e4a-c87a5623a6d1"],

Cell["\<\
The plunges are the emitted photons, one at a time. No single run is smooth; \
smoothness is in the average.\
\>", "Text",
 CellID->2132198261,ExpressionUUID->"066e8396-42fa-b64f-2e15-1ad0768c1c95"],

Cell[TextData[{
 "The plot shows the inferred ",
 StyleBox["state", "TI"],
 "; the same run also carries the ",
 StyleBox["record", "TI"],
 ", the list of click times a photon counter actually writes down, already \
returned as ",
 Cell[BoxData[
  RowBox[{"oneRun", "[", "\"\<clicks\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fee4e15-659c-ade9-3596-605f0c2ef733"],
 " and bound to ",
 Cell[BoxData["oneClicks"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f99faa1-7599-adaa-15a6-f30b7c2df7f0"],
 " above. Every plunge is one entry in it, because the jump that plunges the \
state is the very step that sowed the time. Count the clicks in this record:"
}], "Text",
 CellID->1954495564,ExpressionUUID->"6c80f068-193e-1d5a-14bf-ea3298cb67a0"],

Cell[BoxData[
 RowBox[{"Length", "[", "oneClicks", "]"}]], "Input",
 CellLabel->"In[124]:= ",
 CellID->1504758964,ExpressionUUID->"77601adb-bf25-4789-1d1f-93853ad02dd3"],

Cell[TextData[{
 "A handful of photons over the run. Now put the record and the state on one \
time axis with two vertical scales: the conditioned population on the left, \
each click marked by a red line, and the cumulative count ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48b830c7-d270-6a57-7847-a9a0e70538bd"],
 " on the right, a staircase that rises by one at every click:"
}], "Text",
 CellID->885403737,ExpressionUUID->"62f1d7f5-6807-0c72-128e-cebf09b25758"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{"excitedPopK", " ", "/@", " ", "oneCount"}]}], "}"}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Riffle", "[", 
         RowBox[{"oneClicks", ",", " ", "oneClicks"}], "]"}], ",", " ", 
        RowBox[{"Riffle", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Range", "@", 
            RowBox[{"Length", "@", "oneClicks"}]}], " ", "-", " ", "1"}], ",",
           " ", 
          RowBox[{"Range", "@", 
           RowBox[{"Length", "@", "oneClicks"}]}]}], "]"}]}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"MultiaxisArrangement", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", "\n", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", " ", "Red"}], "}"}], " ", "&"}], " ", "/@", " ", 
       "oneClicks"}], ",", " ", "None"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<excited population\>\"", ",", 
        " ", "\"\<cumulative count N(t)\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", " ", "None"}], "}"}]}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<clicks (red lines) fall at the population plunges; the \
staircase counts them\>\""}]}], "]"}]], "Input",
 CellLabel->"In[125]:= ",
 CellID->299015440,ExpressionUUID->"1e2af966-75ba-f15e-4629-f1407c4cc3a4"],

Cell["\<\
Every red line sits on a plunge: the click is the emission, and the plunge is \
the state collapsing to the ground state the instant the photon is \
registered. The staircase (right scale) is the raw experimental data; the \
population trajectory (left scale) is what the theorist infers from it.\
\>", "Text",
 CellID->59570862,ExpressionUUID->"7fcb302b-9e92-9019-25c8-aa751b24e363"],

Cell["\<\
Now run an ensemble of these same trajectories, carried well past the display \
window so each click record is long enough for the timing statistic below; \
our single run above is seed 3 of this same generator, the ensemble's third \
member seen over just the plotted window:\
\>", "Text",
 CellID->1364978316,ExpressionUUID->"361ba0ac-b25b-03c3-5e38-3909c7ee5129"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nCount", " ", "=", " ", "200"}], ";", " ", 
  RowBox[{"nWaitSteps", " ", "=", " ", "4000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"countRuns", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"countingRun", "[", 
      RowBox[{"#", ",", " ", "nWaitSteps"}], "]"}], " ", "&"}], " ", "/@", 
    " ", 
    RowBox[{"Range", "[", "nCount", "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[126]:= ",
 CellID->565097818,ExpressionUUID->"36c5768f-9366-0c29-5efb-6fe926135773"],

Cell["\<\
Averaging the conditioned states across the ensemble must recover the master \
equation. Compare the ensemble-mean excited population, over the displayed \
window, against the integrated reference:\
\>", "Text",
 CellID->1520041768,ExpressionUUID->"43fcd6d4-594a-1482-7183-cf9e58ff7ee8"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"excitedPop", " ", "/@", " ", 
      RowBox[{"Mean", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"densityMatrix", " ", "/@", " ", 
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"countRuns", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<states\>\"", "]"}], ",",
             " ", 
            RowBox[{"Length", "[", "when", "]"}]}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "nCount"}], "}"}]}], "]"}], "]"}]}], ")"}], 
    " ", "-", " ", "averageChance"}], "]"}]}]], "Input",
 CellLabel->"In[127]:= ",
 CellID->862412655,ExpressionUUID->"4719bc21-ede2-73f0-6d26-358a8b9741da"],

Cell[TextData[{
 "The gap shrinks as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71a147e0-ad25-39c0-275f-5ecdc4d18b2a"],
 ": the jump trajectories average back to the master equation."
}], "Text",
 CellID->426217663,ExpressionUUID->"0d94734f-f5fd-5b1e-3bac-6b2883882664"],

Cell[TextData[{
 "The click record carries a statistic no smooth curve can: the distribution \
of ",
 StyleBox["waiting times", "TI"],
 " between clicks. A click leaves the atom in ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a66d044-93ea-cfa5-7a1d-ca2e259c958f"],
 ", so the time ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08e3a6ae-198b-2f89-3890-3f08983e75d3"],
 " to the next click has the density"
}], "Text",
 CellID->128954499,ExpressionUUID->"07ff9e3d-196e-b566-2d84-106798181c4c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["w", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Tau]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     TemplateBox[{
       RowBox[{
         StyleBox["\[Psi]", "TI"], 
         StyleBox["(", SpanMaxSize -> 1], 
         StyleBox["\[Tau]", "TI"], 
         StyleBox[")", SpanMaxSize -> 1]}]},
      "Bra"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["c", "TI"], "^"], "\[Dagger]"], 
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     TemplateBox[{
       RowBox[{
         StyleBox["\[Psi]", "TI"], 
         StyleBox["(", SpanMaxSize -> 1], 
         StyleBox["\[Tau]", "TI"], 
         StyleBox[")", SpanMaxSize -> 1]}]},
      "Ket"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["\[Tau]", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Ket"], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["H", "TI"], "^"], 
        StyleBox["eff",
         FontSlant->"Plain"]], 
       StyleBox["\[Tau]", "TI"]}]], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"]}]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["H", "TI"], "^"], 
     StyleBox["eff",
      FontSlant->"Plain"]], "=", 
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], "-", 
     RowBox[{
      FractionBox[
       StyleBox["i", "TI"], "2"], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["c", "TI"], "^"], "\[Dagger]"], 
      OverscriptBox[
       StyleBox["c", "TI"], "^"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->731716873,ExpressionUUID->"7611561e-6aa4-cbf1-1e2f-48580f5699db"],

Cell[TextData[{
 "the unnormalized no-click state evolved from the ground state. Since it \
starts in ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d91ad73-9dce-768e-1bae-453d147b5cd4"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Gamma]", "TI"], " ", 
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{
         StyleBox["e", "TI"], 
         StyleBox["g", "TI"]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", "0"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bff65fb-5d0a-196c-1985-7ca554bf6bb6"],
 ": the atom cannot emit twice at once, it must be re-driven to the excited \
state first, so very short gaps are forbidden. This is antibunching. Read the \
density directly off the no-click evolution:"
}], "Text",
 CellID->263464368,ExpressionUUID->"5e58ca76-8595-5ac4-0667-ec302c20282e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"waitDensity", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"psi", " ", "=", " ", 
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{"Hdrive", " ", "-", " ", 
            RowBox[{
             RowBox[{"I", "/", "2"}], " ", 
             RowBox[{
              RowBox[{"ConjugateTranspose", "[", "cAtom", "]"}], " ", ".", 
              " ", "cAtom"}]}]}], ")"}], " ", "t"}], "]"}], " ", ".", " ", 
        "ground"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Re", "[", 
      RowBox[{
       RowBox[{"Conjugate", "[", "psi", "]"}], " ", ".", " ", 
       RowBox[{"ConjugateTranspose", "[", "cAtom", "]"}], " ", ".", " ", 
       "cAtom", " ", ".", " ", "psi"}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[128]:= ",
 CellID->519276129,ExpressionUUID->"08a91809-3406-7705-3856-9253bdb35a6f"],

Cell[TextData[{
 "No separate simulation is needed. Because every click resets the atom \
exactly to ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47ee4125-d524-d464-6d96-588edcd6bf4e"],
 ", the gap between two consecutive clicks in any trajectory is already a \
draw from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a0bea5a-c3ff-c671-4a08-0c07f58bad5b"],
 ": it begins where ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d2ec88d-5e53-28f6-54d5-e1d75be67adc"],
 " begins. Pool those gaps straight from the ensemble's click records, one \
set of differences per run (the leading interval, which starts from the \
excited state rather than from ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230fc3bf-d3e5-5aa5-5134-daf8e590288f"],
 ", drops out on its own, since a difference needs two clicks):"
}], "Text",
 CellID->1441306302,ExpressionUUID->"0c6e076f-8b93-3c10-3415-9f492e27877a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"waitTimes", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Differences", "[", 
       RowBox[{"#", "[", "\"\<clicks\>\"", "]"}], "]"}], " ", "&"}], " ", "/@",
      " ", "countRuns"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[129]:= ",
 CellID->370920483,ExpressionUUID->"29094997-c9cb-f733-5f37-60d0e87fda19"],

Cell["Overlay their histogram on the closed form:", "Text",
 CellID->1675734937,ExpressionUUID->"284fc6fb-b6ce-6422-5874-dfa4c37b4f08"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Histogram", "[", 
    RowBox[{"waitTimes", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "6", ",", " ", "0.2"}], "}"}], ",", 
     " ", "\"\<PDF\>\"", ",", " ", 
     RowBox[{"ChartStyle", " ", "->", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"waitDensity", "[", "t", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "6"}], "}"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "Red"}], "]"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "480"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<waiting time between clicks\>\"", ",", 
      " ", "\"\<density\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the trajectory's own inter-click gaps land on the closed-form \
density\>\""}]}], "]"}]], "Input",
 CellLabel->"In[130]:= ",
 CellID->1811399761,ExpressionUUID->"0cad16aa-0a89-b805-3452-8ff4af3d0b6f"],

Cell["\<\
The bars land on the closed-form density: it vanishes at zero (no two clicks \
at once), rises to a first hump near half a Rabi period, then oscillates and \
decays, the re-driven atom's Rabi cycle written into the timing of the \
clicks. This antibunching is the hallmark of single-photon (nonclassical) \
light, and it lives entirely in the click timing, invisible in the smooth \
population.\
\>", "Text",
 CellID->417262126,ExpressionUUID->"5640583a-c911-1fe8-7e70-5267e8a46532"],

Cell["Homodyne: Reading One Quadrature", "Subsection",
 CellID->1077936938,ExpressionUUID->"6944803a-8297-e066-1f7b-1a643723b34c"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Mixing the output with a strong reference beam before detecting it \
(homodyne) turns the clicks into a continuous noisy current and gives a ",
 StyleBox["diffusive", "TI"],
 " stochastic master equation"
}], "Text",
 CellID->181325614,ExpressionUUID->"7e9e495e-a796-7cd0-26a6-611bd223463a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], " ", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2020910698,ExpressionUUID->"534f7e63-03c8-ee33-0175-704db662b519"],

Cell[TextData[{
 "with a real Wiener increment ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b07ad27-9e6a-154b-693c-44811b1f7f91"],
 " (",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["W", "TI"], "2"], "=", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c7a415c-3e53-b7cb-441a-5906bbe71d11"],
 "). The conditioned state now purifies smoothly instead of by jumps. The \
point of this section is the bookkeeping: what a single run gives us, which \
quantities are ",
 StyleBox["observed", "TI"],
 " and which are ",
 StyleBox["inferred", "TI"],
 ", and how every homodyne object is one of those two or is built from them."
}], "Text",
 CellID->661155756,ExpressionUUID->"417aec05-2fbb-8238-7719-066f4a4fd102"],

Cell[TextData[{
 "The second way, ",
 StyleBox["homodyne",
  FontWeight->"Bold"],
 " detection: mix the output with a strong reference beam and measure one \
quadrature as a continuous noisy current. Run one homodyne trajectory of the \
same atom:"
}], "Text",
 CellID->1040242161,ExpressionUUID->"4705486f-1ac0-4964-6d3b-62499f75184e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"smoothHistory", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "Hdrive", ",", 
     " ", 
     RowBox[{"{", "cAtom", "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "dtAtom", ",", " ", "6.0", ",", " ", "3"}],
     "]"}]}], ";"}]], "Input",
 CellLabel->"In[131]:= ",
 CellID->758481243,ExpressionUUID->"3af5a034-7641-6879-6a8a-3a7e03f43b43"],

Cell[TextData[{
 Cell[BoxData["trajectory"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68379bed-79e9-22be-19cc-12b77f9c7084"],
 " hands back exactly two things, and everything else on this page is one of \
them or is computed from them. The ",
 StyleBox["conditional state",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["c", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "460eb9f9-c41e-8ef4-6e35-30a2eda8d4de"],
 " at each time node (",
 Cell[BoxData[
  RowBox[{"smoothHistory", "[", "\"\<states\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "258251be-7c16-7495-53b2-48f875a35eff"],
 ") is the observer's running estimate of the atom given the record so far. \
The ",
 StyleBox["record increment",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35c1f832-722b-ca69-63fe-f27c07df98b3"],
 " at each step (",
 Cell[BoxData[
  RowBox[{"smoothHistory", "[", "\"\<record\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6a50da-eb07-3910-296a-49878eb3887a"],
 ") is the raw output of the detector. The model tying them is"
}], "Text",
 CellID->607101385,ExpressionUUID->"23591dbb-79d4-ec10-5166-94e57866b77a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["J", "TI"], "=", 
    UnderscriptBox[
     UnderscriptBox[
      RowBox[{
       SqrtBox[
        StyleBox["\[Gamma]", "TI"]], " ", 
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], 
        StyleBox["x", "TI"]], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], "\[UnderBrace]"], 
     StyleBox["signal",
      FontSlant->"Plain"]], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->718676885,ExpressionUUID->"114fd905-c79d-9420-4774-d16ef229ff0a"],

Cell[TextData[{
 "the signal read from ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0047a90f-9cb0-808d-307c-4169154ad2d7"],
 ", the noise ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42e32fd7-26e6-6b71-7290-c6915293365b"],
 " a Wiener increment. Hold the two apart: ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a2652ed-88d4-efb2-7bde-4bb72966b598"],
 " is ",
 StyleBox["observed",
  FontWeight->"Bold"],
 ", and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0962d9db-7466-8598-3f11-d0857d10efe2"],
 " is ",
 StyleBox["inferred",
  FontWeight->"Bold"],
 ", reconstructed from ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b3d557b-19e1-b503-0ac3-4d259f951c69"],
 " by the filter (the positivity step from the toolkit)."
}], "Text",
 CellID->1099629263,ExpressionUUID->"529c5c95-0588-d8f1-02a4-55dfac22aadb"],

Cell["\<\
Take the conditional state first. Its excited population is one smooth \
diffusing history, no jumps:\
\>", "Text",
 CellID->2120979663,ExpressionUUID->"18bedc4a-f6ca-97e0-4845-d617837cfdca"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{"excitedPop", " ", "/@", " ", 
         RowBox[{"smoothHistory", "[", "\"\<states\>\"", "]"}]}]}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", "averageChance"}], "}"}], "]"}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "Red", ",", " ", "Dashed"}], "]"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<one conditional history\>\"", ",", 
      " ", "\"\<master equation\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "500"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<excited-state population\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the conditional state diffuses smoothly, no jumps\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[132]:= ",
 CellID->123468129,ExpressionUUID->"5f18273e-5cf5-00f5-0527-bf78548052df"],

Cell["\<\
Smooth diffusion, not the plunges of a counted trajectory, yet averaging many \
conditional states recovers the same master equation:\
\>", "Text",
 CellID->513893082,ExpressionUUID->"1890d11b-851d-d227-48af-c9452ca9a10d"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"excitedPop", " ", "/@", " ", 
      RowBox[{"Mean", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"trajectory", "[", 
           RowBox[{
            RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", 
            "Hdrive", ",", " ", 
            RowBox[{"{", "cAtom", "}"}], ",", " ", 
            RowBox[{"{", "1.", "}"}], ",", " ", 
            RowBox[{"{", "}"}], ",", " ", "dtAtom", ",", " ", "6.0", ",", " ",
             "k"}], "]"}], "[", "\"\<states\>\"", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "150"}], "}"}]}], "]"}], "]"}]}], ")"}], " ",
     "-", " ", "averageChance"}], "]"}]}]], "Input",
 CellLabel->"In[133]:= ",
 CellID->1710240506,ExpressionUUID->"5b8be800-baff-aedd-0988-026a3e8bf427"],

Cell["\<\
The gap is Monte-Carlo scatter: the conditional state is inferred from a \
record, and its average over all records is exactly the unconditioned master \
equation.\
\>", "Text",
 CellID->1971880122,ExpressionUUID->"224fae0e-4768-b263-5274-406872020149"],

Cell["\<\
Now the record itself, and the four quantities read from it, each labeled by \
how it is obtained and whether it is observed or inferred.\
\>", "Text",
 CellID->482876923,ExpressionUUID->"3d32ba1d-71ed-60b8-64c1-3c4707983282"],

Cell[TextData[{
 StyleBox["The record increment ",
  FontWeight->"Bold"],
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"3ccd4f42-4869-4b08-64f3-672c691c1652"],
 " (observed). ",
 StyleBox["How obtained:", "TI"],
 " the detector's output each step, here generated together with the state. \
",
 StyleBox["Status:", "TI"],
 " observed, the one thing that enters from the world; everything else is \
downstream of it. Plot it:"
}], "Text",
 CellID->257955902,ExpressionUUID->"0cf63df4-f608-7ba6-348d-b4b183bd498c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dJ", " ", "=", " ", 
   RowBox[{"Flatten", "@", 
    RowBox[{"smoothHistory", "[", "\"\<record\>\"", "]"}]}]}], ";"}]], "Input",\

 CellLabel->"In[134]:= ",
 CellID->1595709984,ExpressionUUID->"60948258-d69f-7f2c-10ab-2405e32a4276"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Most", "@", "when"}], ",", " ", "dJ"}], "}"}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<record increment  dJ\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<dJ, the observed record: almost pure noise per step\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[135]:= ",
 CellID->1806165637,ExpressionUUID->"5bf5c13c-8c81-f0bf-098a-d9662535c285"],

Cell[TextData[{
 "It looks like noise because it is almost all noise: per step the signal ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "\[TildeTilde]", "0.005"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27ebc314-3813-af61-4de8-db5eb9a7f24b"],
 " sits under a ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59cd495b-92f8-de82-0ff3-61052772a4e8"],
 " of size ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox[
     RowBox[{"d", "t"}], "TI"]], "=", "0.1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1597811c-d04f-58d0-43ac-1959e1fa2a3a"],
 ", twenty times larger. A single increment carries almost no information \
about the atom."
}], "Text",
 CellID->1730622717,ExpressionUUID->"0d69ae9d-d0a3-a5e3-3b16-47c6e1570fc9"],

Cell[TextData[{
 StyleBox["The integrated record ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubsuperscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"]], 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"1e10fbdd-fcac-b923-462f-f286f55e0809"],
 " (observed). ",
 StyleBox["How obtained:", "TI"],
 " sum the observed increments. ",
 StyleBox["Status:", "TI"],
 " observed, the same data accumulated. Plot it against its drift, the \
inferred signal integrated:"
}], "Text",
 CellID->694790404,ExpressionUUID->"68c26b95-e958-d351-18f1-82de88d2a1bb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"signal", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "\[Gamma]atom", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"blochVector", "[", "#", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"Most", "[", 
       RowBox[{"smoothHistory", "[", "\"\<states\>\"", "]"}], "]"}]}], 
     ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Jt", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", "dJ", "]"}], ",", " ", "0."}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"driftJ", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", 
      RowBox[{"signal", " ", "dtAtom"}], "]"}], ",", " ", "0."}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[136]:= ",
 CellID->1833306836,ExpressionUUID->"56b7d10b-4c3b-5ee0-7e4c-c95565ce24ca"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", "Jt"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", "driftJ"}], "}"}], "]"}]}], "}"}], ",", "\n",
    " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<integrated record  J(t)\>\"", ",", 
      " ", "\"\<inferred drift  \[Integral]signal dt\>\""}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<integrated record  J(t)\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the observed record integrates to a drifting path; its drift is \
the signal\>\""}]}], "]"}]], "Input",
 CellLabel->"In[137]:= ",
 CellID->1703418593,ExpressionUUID->"40ed67f4-ffa0-5cce-7093-7eb1fa552614"],

Cell[TextData[{
 "Integrating is itself a filter: the signal accumulates coherently into a \
drift while the noise only grows as ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dc0df98-8a2c-0889-7bff-d6c22fd95ad3"],
 ", so in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2226f602-e60c-c55a-53dd-e86f93beafa0"],
 " the signal is comparable to the noise instead of twenty times below it. \
This is the honest, window-free picture of the data. (The ",
 Cell[BoxData["signal"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ed808ee-885a-0ea1-76e7-a1c829ef548b"],
 " used for the drift is inferred, and gets its own panel below.)"
}], "Text",
 CellID->1263998950,ExpressionUUID->"1627cdbb-2852-50d0-3fdc-e4e549e7223a"],

Cell[TextData[{
 StyleBox["The current ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"6801141d-c5dc-e96b-183e-8e46ec6ebbb1"],
 " (observed, singular). ",
 StyleBox["How obtained:", "TI"],
 " divide the observed increment by ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fb5e010-3b47-28f4-554a-fa5abef27ade"],
 ". ",
 StyleBox["Status:", "TI"],
 " observed but not a proper quantity: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "=", 
   StyleBox["signal",
    FontSlant->"Plain"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69461d9a-9714-a717-1f7d-94c422a60a7d"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3cd9b2-b2f5-0832-4ac3-d0ffc6805b18"],
 " is white noise of variance ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17254721-59fc-dba5-3edb-5e8b5f8ea98f"],
 ", which diverges as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52d6b4d2-7b23-95d3-02ed-2d9c7ed7ff39"],
 ". On the grid it is a ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1", "/", 
   SqrtBox[
    StyleBox[
     RowBox[{"d", "t"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "133f88c9-4e43-c7a8-42c4-21936bf7adf2"],
 " band around a ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "525bf512-066b-f79b-0278-ed5cb31fdde1"],
 " signal:"
}], "Text",
 CellID->1096868287,ExpressionUUID->"7020b0a8-e1ec-de26-21df-29f5979ea50c"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Most", "@", "when"}], ",", " ", 
      RowBox[{"dJ", "/", "dtAtom"}]}], "}"}], "]"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<current  dJ/dt\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the current dJ/dt: a white-noise band with no dt\[Rule]0 \
limit\>\""}]}], "]"}]], "Input",
 CellLabel->"In[138]:= ",
 CellID->152289512,ExpressionUUID->"6f4e56ea-c348-0e14-1576-4fb7f6fd557e"],

Cell[TextData[{
 "There is no current ",
 StyleBox["curve", "TI"],
 ". The instantaneous homodyne current is a distribution, not a function, \
which is why any smooth current needs an arbitrary averaging window and why \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c7820da-3afe-8c15-5407-b984be88d77f"],
 " above is the cleaner observed object."
}], "Text",
 CellID->2048354789,ExpressionUUID->"491026a6-dd30-329c-7f2f-bf03d4ca80e6"],

Cell[TextData[{
 StyleBox["The signal ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"78f9e5c0-5bc5-e73b-2886-fcaa5e71ca01"],
 " (inferred). ",
 StyleBox["How obtained:", "TI"],
 " read off the conditional state. ",
 StyleBox["Status:", "TI"],
 " inferred, the conditional mean of the current, never measured directly. \
This is the clean thing buried in the record:"
}], "Text",
 CellID->1927064331,ExpressionUUID->"295a1104-8f0a-9295-5f79-896e2abce0ff"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Most", "@", "when"}], ",", " ", "signal"}], "}"}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<signal  \!\(\*SqrtBox[\(\[Gamma]\)]\) \[LeftAngleBracket]\
\[Sigma]x\[RightAngleBracket]\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the signal, inferred from the conditional state, not measured\>\
\""}]}], "]"}]], "Input",
 CellLabel->"In[139]:= ",
 CellID->177111739,ExpressionUUID->"34e49fcf-314b-942d-5c9b-16a940ffff77"],

Cell[TextData[{
 "No detector emits this curve. It is what the filter reconstructs, smooth \
because the conditional state is smooth, and it is exactly the drift the \
observed ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28081ee1-9923-6846-5837-97cb18d63aac"],
 " climbed along."
}], "Text",
 CellID->115596948,ExpressionUUID->"35d104ab-d16d-b332-63ee-9df4e0191e18"],

Cell[TextData[{
 StyleBox["The innovation ",
  FontWeight->"Bold"],
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"4f8fdcfc-c987-8804-75b4-d5b9e833db6e"],
 " (inferred). ",
 StyleBox["How obtained:", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"], "=", 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "-", 
   StyleBox["signal",
    FontSlant->"Plain"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bb02784-750c-cc73-794f-beee7cbe9759"],
 ", the observed increment minus the inferred prediction. ",
 StyleBox["Status:", "TI"],
 " inferred, a residual, not a second measurement:"
}], "Text",
 CellID->1114128274,ExpressionUUID->"6368bf1a-89ab-f709-1117-3744285fda53"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dW", " ", "=", " ", 
   RowBox[{"dJ", " ", "-", " ", 
    RowBox[{"signal", " ", "dtAtom"}]}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Most", "@", "when"}], ",", " ", "dW"}], "}"}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<innovation  dW\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the innovation dW = dJ - signal dt: the residual\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[140]:= ",
 CellID->1895094918,ExpressionUUID->"18aa8291-c565-6e81-48a9-1bdaec1034eb"],

Cell[TextData[{
 "If the filter is optimal, the residual is zero-mean white noise. Check its \
autocorrelation, with the ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "2", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fb37437-3ad9-e813-3541-6e71bf6dbb79"],
 " band white noise would sit inside:"
}], "Text",
 CellID->532797841,ExpressionUUID->"29c235d7-86a4-1a63-5ff1-ac9133516949"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"innov", " ", "=", " ", 
      RowBox[{"dW", "/", 
       RowBox[{"Sqrt", "[", "dtAtom", "]"}]}]}], ",", " ", 
     RowBox[{"ci", " ", "=", " ", 
      RowBox[{"2", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Length", "[", "dW", "]"}], "]"}]}]}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"CorrelationFunction", "[", 
      RowBox[{"innov", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "10"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Filling", " ", "->", " ", "Axis"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.2"}], ",", " ", "0.2"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ci", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "ci"}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}]}], "}"}]}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<lag\>\"", ",", 
        " ", "\"\<innovation autocorrelation\>\""}], "}"}]}], ",", " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<the innovation is white within confidence limits\>\""}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[141]:= ",
 CellID->827514810,ExpressionUUID->"7c4bd199-468e-1df0-2448-c8c3733b67da"],

Cell["\<\
Every nonzero lag sits in the band: the filter has extracted every \
predictable part of the record, and what remains is irreducible measurement \
noise. This whiteness is the diffusive counterpart of the counting record's \
antibunched clicks, and the same optimal-filter signature the Kalman tracker \
will show.\
\>", "Text",
 CellID->1310126569,ExpressionUUID->"5faac466-18c1-c293-05a9-de40997590f9"],

Cell[TextData[{
 "So the section is one ledger. A single observed record ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b2a52a2-44e1-aebb-392a-4b0c6c95f481"],
 " (equivalently its integral ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "146756d1-ea39-ec02-3c1d-4f9a8fcdb768"],
 ") enters from the world; from it the conditional state, the signal, and the \
innovation ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a7ee52b-d767-0389-4a05-fd74e21251d3"],
 " are all computed. Only ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "J"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "419fd7e1-c297-cbe2-77a4-cecaf72399c8"],
 " is data. Everything that looks like the atom, the smooth population, the \
signal curve, is inferred from it."
}], "Text",
 CellID->1253347759,ExpressionUUID->"7a33ac2f-4fb5-380e-2bc0-45896a418b54"],

Cell["Heterodyne: Reading Both Quadratures", "Subsection",
 CellID->1721654809,ExpressionUUID->"3b56b9eb-04f6-5b17-696d-30b5ac83267d"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Reading ",
 StyleBox["both", "TI"],
 " shadows at once (heterodyne) splits the one monitored leak into two \
half-strength homodyne channels a quarter-turn apart, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["I", "TI"]], "=", 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e9dc2e4-4753-bfbd-16a2-dbce72e70587"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["Q", "TI"]], "=", 
   StyleBox["i", "TI"], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7db41629-8d3d-b9f9-2b4b-887324c90bc3"],
 ", each read as its own real current:"
}], "Text",
 CellID->1835967532,ExpressionUUID->"3f51d24b-32fb-3155-656e-d415468f83bf"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     StyleBox["I", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], " ", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["I", "TI"]], "+", "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     StyleBox["Q", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], " ", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["Q", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     SubsuperscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["I", "TI"], "2"]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["d", "TI"], 
      SubsuperscriptBox[
       StyleBox["W", "TI"], 
       StyleBox["Q", "TI"], "2"]}], "=", 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["I", "TI"]], " ", 
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["Q", "TI"]]}], "=", 
    RowBox[{"0", "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->965277466,ExpressionUUID->"32e9efb5-7328-71d0-6296-06ff06dd433a"],

Cell[TextData[{
 "It is one point in a whole ",
 StyleBox["general-dyne", "TI"],
 " family running from one sharp shadow (homodyne) to two blurry ones, every \
member averaging to the identical master equation while giving genuinely \
different single histories. Show that the two channels reproduce the one \
leak, then watch."
}], "Text",
 CellID->1405388586,ExpressionUUID->"0aa19f46-928a-afd4-3a5e-1720273cf53e"],

Cell[TextData[{
 "The third way, ",
 StyleBox["heterodyne",
  FontWeight->"Bold"],
 ": measure both quadratures at once. It is equivalent to two half-strength \
homodyne channels a quarter-turn apart, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31860dcc-84f8-941b-67bd-a4962d72ff61"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08371d00-4cf7-24ac-39cc-956a64838ef6"],
 ". First prove those two dissipators sum to the original, for any ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["c", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e555e8f-0ad0-492d-166b-57e9af651877"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348b0551-d20e-4e96-5c88-9d1ae7bb14fc"],
 ":"
}], "Text",
 CellID->1630589325,ExpressionUUID->"5c065349-950a-8738-043e-4b131cbcea02"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\[FormalC]", ",", " ", "##"}], "]"}], " ", "&"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", "\n", 
      "   ", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\[FormalR]", ",", " ", "##"}], "]"}], " ", "&"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}]}], "}"}], ",", " ", 
    "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"dissipator", "[", 
       RowBox[{
        RowBox[{"c", "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", "r"}], "]"}], " ", "+", 
      " ", 
      RowBox[{"dissipator", "[", 
       RowBox[{
        RowBox[{"I", " ", 
         RowBox[{"c", "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}]}], ",", " ", "r"}], "]"}]}], " ", 
     "==", " ", "\n", "   ", 
     RowBox[{"dissipator", "[", 
      RowBox[{"c", ",", " ", "r"}], "]"}]}]}], "]"}], " ", "//", " ", 
  "FullSimplify"}]], "Input",
 CellLabel->"In[142]:= ",
 CellID->446366569,ExpressionUUID->"4ff276a9-5e86-52e3-7582-6ff35b3320c9"],

Cell["\<\
It returns True, with no assumptions: the two channels reproduce the same \
dissipator, so the master equation is unchanged, and as in the counting and \
homodyne runs an ensemble of these trajectories averages back to it.\
\>", "Text",
 CellID->1994518302,ExpressionUUID->"24b6e2ad-c501-b7fc-4c4d-fbf6ecb51dc6"],

Cell[TextData[{
 "The trajectory explores differently, so hold apart what heterodyne ",
 StyleBox["observes", "TI"],
 " from what it ",
 StyleBox["infers", "TI"],
 ", exactly as with homodyne. ",
 Cell[BoxData["trajectory"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230cad6b-7900-e120-5133-453578bab00a"],
 " still returns two objects, the conditional state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "086f7f71-a7b7-bd3e-3815-773ad2430404"],
 " (inferred) and the record (observed), but the record now has ",
 StyleBox["two", "TI"],
 " columns, one real current per quadrature:"
}], "Text",
 CellID->1562654637,ExpressionUUID->"0cdf8892-1d3f-31f6-34e4-21dc94cb83dc"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["I", "TI"]], "=", 
    UnderscriptBox[
     UnderscriptBox[
      RowBox[{
       SqrtBox[
        RowBox[{
         StyleBox["\[Gamma]", "TI"], "/", "2"}]], " ", 
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], 
        StyleBox["x", "TI"]], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], "\[UnderBrace]"], 
     StyleBox["signal",
      FontSlant->"Plain"]], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["I", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["J", "TI"], 
      StyleBox["Q", "TI"]]}], "=", 
    RowBox[{
     RowBox[{
      UnderscriptBox[
       UnderscriptBox[
        RowBox[{
         SqrtBox[
          RowBox[{
           StyleBox["\[Gamma]", "TI"], "/", "2"}]], " ", 
         StyleBox["\[LeftAngleBracket]",
          SpanMaxSize->1], 
         SubscriptBox[
          OverscriptBox[
           StyleBox["\[Sigma]", "TI"], "^"], 
          StyleBox["y", "TI"]], 
         StyleBox["\[RightAngleBracket]",
          SpanMaxSize->1]}], "\[UnderBrace]"], 
       StyleBox["signal",
        FontSlant->"Plain"]], " ", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{
      StyleBox["d", "TI"], 
      RowBox[{
       SubscriptBox[
        StyleBox["W", "TI"], 
        StyleBox["Q", "TI"]], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1372112522,ExpressionUUID->"7e0217c2-6a7a-d359-2631-8eac0f0ca1a3"],

Cell[TextData[{
 "Equivalently the two real records are the real and imaginary parts of a \
single ",
 StyleBox["complex", "TI"],
 " record ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "=", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["I", "TI"]], "+", 
   StyleBox["i", "TI"], " ", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["Q", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4104c6da-03d7-a765-773b-df84b6630a4f"],
 ", whose increment satisfies ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["J", "TI"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "731f4b84-5335-8b87-2125-62ee66c1d9ed"],
 " (the two shot noises are independent) and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], " ", 
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["J", "TI"], "*"], "=", "2", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "315717aa-70ab-e706-676c-8ef4015fca6c"],
 " (each quadrature contributes its own variance ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c1b1617-f81f-7a45-2438-8850f9aa48af"],
 "): two independent real noises carried in one complex number. The single \
new fact over homodyne is that two conjugate quadratures, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70b05f1a-470c-9c9d-2040-574472bee6e7"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a8c5b06-7c6a-07f5-7ab4-5360751f6ddf"],
 ", are read at once. Run one history and keep its record:"
}], "Text",
 CellID->638348404,ExpressionUUID->"4fa3f928-0446-c8dd-7550-f172adf09a27"],

Cell[BoxData[
 RowBox[{
  RowBox[{"hetOne", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "Hdrive", ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cAtom", "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
       RowBox[{"I", " ", 
        RowBox[{"cAtom", "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1.", ",", " ", "1."}], "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "dtAtom", ",", " ", "6.0", ",", " ", "3"}],
     "]"}]}], ";"}]], "Input",
 CellLabel->"In[143]:= ",
 CellID->907289993,ExpressionUUID->"3727240c-f62b-7b8f-5edc-be6983de49d5"],

Cell[TextData[{
 StyleBox["The conditional state ",
  FontWeight->"Bold"],
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"50637aef-2122-41f7-0011-73c950d713dd"],
 " (inferred). ",
 StyleBox["How obtained:", "TI"],
 " the filter's running estimate of the atom given the record so far. ",
 StyleBox["Status:", "TI"],
 " inferred. Where homodyne resolved one transverse coordinate, heterodyne \
resolves both; plot the run's ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63773809-2d44-01f7-110c-b25344f153dd"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ede8b7e-b317-5b7c-26e5-233bc6a22646"],
 " together:"
}], "Text",
 CellID->1480220716,ExpressionUUID->"75c8f24b-f46e-7672-23f7-f414fd1b5d58"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"blochVector", "[", "#", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"hetOne", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}], ",",
      " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"blochVector", "[", "#", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"hetOne", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[LeftAngleBracket]\[Sigma]x\[RightAngleBracket]\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]\[Sigma]y\[RightAngleBracket]\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<conditional transverse Bloch vector\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<one heterodyne run resolves both quadratures\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[144]:= ",
 CellID->1004075994,ExpressionUUID->"2d149507-d3df-875e-5b2b-0d60e66beda4"],

Cell["\<\
Both components diffuse smoothly, no jumps, and both are live: the run \
carries a full transverse Bloch vector where the homodyne run knew only one \
coordinate.\
\>", "Text",
 CellID->592936352,ExpressionUUID->"772d62ae-4bf9-dab0-1ed3-7b086d8da89a"],

Cell[TextData[{
 StyleBox["The record increments ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["I", "TI"]]}], ",", 
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["Q", "TI"]]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"7a8c9a4d-0caa-515e-2ab3-1c17a55f23a4"],
 " (observed). ",
 StyleBox["How obtained:", "TI"],
 " the detector's two outputs each step. ",
 StyleBox["Status:", "TI"],
 " observed, the only data that enters from the world; everything else is \
downstream. Read the two columns:"
}], "Text",
 CellID->792862978,ExpressionUUID->"6a4c6a75-6554-e0e6-1a73-8c3f0ce6b2cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dJI", " ", "=", " ", 
   RowBox[{
    RowBox[{"hetOne", "[", "\"\<record\>\"", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dJQ", " ", "=", " ", 
   RowBox[{
    RowBox[{"hetOne", "[", "\"\<record\>\"", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[145]:= ",
 CellID->573477382,ExpressionUUID->"29c3108e-8c9d-f317-5ff0-89e82529de7d"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Most", "@", "when"}], ",", " ", "dJI"}], "}"}], "]"}], ",", 
     " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Most", "@", "when"}], ",", " ", "dJQ"}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<I record\>\"", ",", " ", "\"\<Q record\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<record increments\>\""}], "}"}]}],
    ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<both quadrature records: almost pure noise per step\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[146]:= ",
 CellID->2124988169,ExpressionUUID->"5b90d741-2df1-4c37-09af-cf2b4b84171d"],

Cell[TextData[{
 "Each is nearly pure noise, and for a sharper reason than homodyne's: each \
channel carries only ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["\[Gamma]", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a353f88-1ea4-a3d5-0bca-b6d29b56f13f"],
 " of signal, half the power homodyne put into its one quadrature, against \
the same shot noise."
}], "Text",
 CellID->534961831,ExpressionUUID->"3c3a5085-d835-7232-65da-49eed9c04118"],

Cell[TextData[{
 StyleBox["The integrated record ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubsuperscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"]], 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"2f71b61d-3801-a1b0-550e-2847b9b5f39a"],
 " (observed). ",
 StyleBox["How obtained:", "TI"],
 " accumulate each column. ",
 StyleBox["Status:", "TI"],
 " observed, the same data summed. A complex record integrates to a path in \
the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"I", "Q"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c7c9f19-7bfc-9bea-6403-17437d8ee930"],
 " plane, an observed walk that drifts along the inferred signal."
}], "Text",
 CellID->998016997,ExpressionUUID->"4bcd3c0f-0044-41be-79f2-b669b1f11384"],

Cell[TextData[{
 "That signal is the per-channel coupling ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["\[Gamma]", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250574e2-7568-dee6-533b-6dcc7c02a4cc"],
 " times each conditional quadrature, read off ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "570dea5b-028b-2dc3-7d32-0c05b73e7729"],
 " rather than measured, one channel for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "559114f0-95cd-3728-03ae-8dba1c799a72"],
 " and one for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "499d2cc9-9173-f7c8-7fa2-c5932007dd12"],
 ":"
}], "Text",
 CellID->1107607024,ExpressionUUID->"1b3687b6-15a3-de20-4acd-1ef09c57a50a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hetSigI", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Gamma]atom", "/", "2"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"blochVector", "[", "#", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"Most", "[", 
       RowBox[{"hetOne", "[", "\"\<states\>\"", "]"}], "]"}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"hetSigQ", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Gamma]atom", "/", "2"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"blochVector", "[", "#", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"Most", "[", 
       RowBox[{"hetOne", "[", "\"\<states\>\"", "]"}], "]"}]}], ")"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[147]:= ",
 CellID->1668318198,ExpressionUUID->"073f26db-34e5-c8c2-2ec4-bf85bc919a28"],

Cell["\<\
The observed walk is the running sum of the two record columns, each starting \
from the origin:\
\>", "Text",
 CellID->1044073123,ExpressionUUID->"27056d96-6b3e-545a-4d3a-84d00ecb3ea0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"JI", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", "dJI", "]"}], ",", " ", "0."}], "]"}]}], ";", 
  " ", 
  RowBox[{"JQ", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", "dJQ", "]"}], ",", " ", "0."}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[148]:= ",
 CellID->1281286378,ExpressionUUID->"031df9cf-6b45-d275-3122-f0a90ef1a15f"],

Cell["\<\
The drift is that same running sum on the inferred signal, the smooth curve \
the walk fluctuates around:\
\>", "Text",
 CellID->2002157654,ExpressionUUID->"79902eb9-9fc4-d4aa-2faf-c7e31a76bef0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"driftI", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", 
      RowBox[{"hetSigI", " ", "dtAtom"}], "]"}], ",", " ", "0."}], "]"}]}], ";",
   " ", 
  RowBox[{"driftQ", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Accumulate", "[", 
      RowBox[{"hetSigQ", " ", "dtAtom"}], "]"}], ",", " ", "0."}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[149]:= ",
 CellID->822148062,ExpressionUUID->"6e90dac8-e749-9c1a-16af-d39592fde760"],

Cell["Now trace the observed walk against that inferred drift:", "Text",
 CellID->837975234,ExpressionUUID->"2f026f1c-d8c2-1814-5531-8759d9776b7e"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"JI", ",", " ", "JQ"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"driftI", ",", " ", "driftQ"}], "}"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<integrated record\>\"", ",", 
      " ", "\"\<inferred drift\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<I\>\"", ",", " ", "\"\<Q\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the observed record is a drifting walk in the IQ plane\>\""}]}],
   "]"}]], "Input",
 CellLabel->"In[150]:= ",
 CellID->2104272152,ExpressionUUID->"5c65fa9b-46f3-ebf0-041a-f3c57287b9da"],

Cell[TextData[{
 "The jagged path is the raw data; the smooth curve it drifts along is \
inferred. Integrating both quadratures at once is a 2D filter: each signal \
accumulates coherently into the drift while its noise only spreads as ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583cd303-9cb1-03ae-09c3-cb6d154451f4"],
 ", so the walk's net displacement carries the record's information where a \
single increment held almost none."
}], "Text",
 CellID->39229099,ExpressionUUID->"18f1bad1-a8d9-f26a-488e-339ac96dc0b0"],

Cell[TextData[{
 StyleBox["The innovations ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["I", "TI"]]}], ",", 
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["Q", "TI"]]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"6cd8e50a-7117-62ea-14e7-fd5400a23030"],
 " (inferred). ",
 StyleBox["How obtained:", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["I", "TI"]], "=", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["I", "TI"]], "-", 
   SubscriptBox[
    StyleBox["signal",
     FontSlant->"Plain"], 
    StyleBox["I", "TI"]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b9c4f1f-9707-8ca1-29a4-675922b3d68b"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["Q", "TI"]], "=", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["Q", "TI"]], "-", 
   SubscriptBox[
    StyleBox["signal",
     FontSlant->"Plain"], 
    StyleBox["Q", "TI"]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0839f778-d15e-09ff-39c6-ef25e0eb5bc5"],
 ", each observed increment minus its inferred prediction. ",
 StyleBox["Status:", "TI"],
 " inferred residuals. If the filter is optimal each is zero-mean white \
noise, and because ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["J", "TI"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7962e333-0c57-77b8-2f11-fb7da5e25d82"],
 " the two are mutually independent. Check the whiteness of each channel \
first, against the ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "2", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e58b71a-bb3b-e382-3667-2f443ecfb1e8"],
 " band:"
}], "Text",
 CellID->538455469,ExpressionUUID->"7517e465-645e-477c-232c-fe4f0deb2a46"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dWI", " ", "=", " ", 
   RowBox[{"dJI", " ", "-", " ", 
    RowBox[{"hetSigI", " ", "dtAtom"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dWQ", " ", "=", " ", 
   RowBox[{"dJQ", " ", "-", " ", 
    RowBox[{"hetSigQ", " ", "dtAtom"}]}]}], ";"}]}], "Input",
 CellLabel->"In[151]:= ",
 CellID->266517012,ExpressionUUID->"560e68d9-da1a-2272-7e35-8182dfaf7158"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ci", " ", "=", " ", 
     RowBox[{"2", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Length", "[", "dWI", "]"}], "]"}]}]}], "}"}], ",", "\n", " ", 
   
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"CorrelationFunction", "[", 
        RowBox[{
         RowBox[{"dWI", "/", 
          RowBox[{"Sqrt", "[", "dtAtom", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "10"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"CorrelationFunction", "[", 
        RowBox[{
         RowBox[{"dWQ", "/", 
          RowBox[{"Sqrt", "[", "dtAtom", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "10"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.2"}], ",", " ", "0.2"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<I channel\>\"", ",", " ", "\"\<Q channel\>\""}], "}"}]}], 
     ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ci", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "ci"}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}]}], "}"}]}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<lag\>\"", ",", 
        " ", "\"\<innovation autocorrelation\>\""}], "}"}]}], ",", " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<each innovation channel is white\>\""}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[152]:= ",
 CellID->1190814367,ExpressionUUID->"46aa8ea3-37c3-4040-6ea9-270d427612aa"],

Cell["\<\
Both correlograms hug zero within the band, the signature of white residuals: \
the filter has extracted every predictable part of each record.\
\>", "Text",
 CellID->1899183568,ExpressionUUID->"6acb7fb5-f6da-6094-1ac9-76fe836f32fe"],

Cell[TextData[{
 "Now the heterodyne-specific check with no homodyne counterpart, whether the \
two residuals are independent of each other. Read off the ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a5ec95d-e220-f105-2a65-e10697dac06f"],
 " correlation matrix of the innovation channels:"
}], "Text",
 CellID->839992789,ExpressionUUID->"05590d03-2064-1772-3366-a56d51117a58"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Correlation", "[", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"dWI", ",", " ", "dWQ"}], "}"}], "]"}], "]"}], " ", "//", " ", 
  "MatrixForm"}]], "Input",
 CellLabel->"In[153]:= ",
 CellID->1909137676,ExpressionUUID->"3b9b9f37-eb8f-88a6-69b8-17708e3bda8c"],

Cell[TextData[{
 "The off-diagonal sits near zero, within the same ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "2", "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ef0eca9-2ea7-fc5e-268f-05f34b53c6a4"],
 " band: the two residuals are not just each white but mutually independent, \
the simulation realizing the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["I", "TI"]], " ", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["Q", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53b0040e-15e9-970f-014f-9e68a39dfa55"],
 " half of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["J", "TI"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49c5479d-c9fe-ab26-7ffb-5ec6ef88f60c"],
 ". Reading both conjugate quadratures buys two independent white \
innovations, one per shadow."
}], "Text",
 CellID->2000873505,ExpressionUUID->"73b5640c-4acf-57ea-214b-7e566f7a3d30"],

Cell["\<\
Keeping the record splits purity into two quantities that need not agree: the \
purity of each conditioned state, and the purity of the state you get by \
averaging them. Run ninety homodyne histories of the same atom:\
\>", "Text",
 CellID->1091748765,ExpressionUUID->"12e31b8a-6cd9-3185-4290-92d4056d83ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"homRuns", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"trajectory", "[", 
       RowBox[{
        RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", "Hdrive", ",",
         " ", 
        RowBox[{"{", "cAtom", "}"}], ",", " ", 
        RowBox[{"{", "1.", "}"}], ",", " ", 
        RowBox[{"{", "}"}], ",", " ", "dtAtom", ",", " ", "6.0", ",", " ", 
        "s"}], "]"}], "[", "\"\<states\>\"", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "90"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[154]:= ",
 CellID->232863170,ExpressionUUID->"1c8dfb5f-95aa-8549-44b2-f3191c5cef93"],

Cell["Follow both purities in time:", "Text",
 CellID->1876092091,ExpressionUUID->"77ba1ed5-dc9c-5ed1-1d59-979ed529243b"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Mean", "[", 
           RowBox[{"purity", " ", "/@", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
          " ", 
         RowBox[{"Transpose", "[", "homRuns", "]"}]}]}], "}"}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"when", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"purity", "[", 
           RowBox[{"Mean", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"Transpose", "[", "homRuns", "]"}]}]}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<mean purity of conditioned states\>\"", ",", 
      " ", "\"\<purity of the mean state\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "520"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<purity\>\""}], "}"}]}], ",", "\n",
    " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<every run stays pure; only the record-blind average \
mixes\>\""}]}], "]"}]], "Input",
 CellLabel->"In[155]:= ",
 CellID->652142632,ExpressionUUID->"122b6086-f39f-774a-4229-79e3862a5d90"],

Cell["\<\
The conditioned purity holds at one for the whole run; the averaged state's \
purity falls and settles at the mixed steady value. Decoherence sits entirely \
in the second curve: it is not an event in any watched atom's history but the \
cost of discarding the record.\
\>", "Text",
 CellID->330963574,ExpressionUUID->"562fd52b-4ccb-95a8-7fd4-cd75657ffff2"],

Cell["\<\
Counting, homodyne, heterodyne: three different measurements of one atom, \
three different trajectory ensembles, one shared master equation. The \
measurement you choose sets what you learn moment to moment; the \
unconditioned dynamics is the same. Between homodyne and heterodyne lies the \
continuous general-dyne family, all on this same average.\
\>", "Text",
 CellID->1389046362,ExpressionUUID->"6a176158-c8f1-b5ca-1a2d-7905e8851f10"],

Cell["Part Five: What Watching Does, and How to Act on It", "Section",
 CellID->1332526183,ExpressionUUID->"59294b9d-2c6b-0af3-08d7-62c7451e58d9"],

Cell[TextData[{
 "Keeping the record does more than reveal the state: measurement reshapes \
the dynamics, and the record can be fed back to control the system. Five \
examples follow: a watched-frozen qubit, a charge qubit read by a detector, \
measurement-induced collapse, a Kalman filter tracking an oscillator, and \
measurement feedback (all qubits except the oscillator). First a helper to \
read the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c93342e-976f-2690-74a0-ad88221b8cfa"],
 " and ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c05a0c6-8ada-cee6-343a-39a02f6c94cc"],
 " components:"
}], "Text",
 CellID->197217751,ExpressionUUID->"386c40c3-2c7c-2bd7-6814-59ad4509793d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"zOf", "[", "states_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"blochVector", "[", "#", "]"}], "[", 
      RowBox[{"[", "3", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "states"}]}], ";", " ", 
  RowBox[{
   RowBox[{"xOf", "[", "states_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"blochVector", "[", "#", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "states"}]}], ";"}]], "Input",
 CellLabel->"In[156]:= ",
 CellID->880034747,ExpressionUUID->"38a5d185-6c33-4099-685a-c8ef05c612e3"],

Cell["Watching Harder Freezes It", "Subsection",
 CellID->1800574979,ExpressionUUID->"705b2160-d6f6-9bc7-2078-b94de280e92d"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " A driven switch continuously measured along ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ad5a48d-d13d-ee7b-6aea-3dd6e0c9b541"],
 ", the quantum Zeno setup. The conditioned state obeys the stochastic master \
equation"
}], "Text",
 CellID->1078219960,ExpressionUUID->"3e286ad4-f19d-13f8-67d7-8391802861c2"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], " ", 
    FractionBox["\[CapitalOmega]", "2"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["x", "TI"]], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "-", 
    FractionBox[
     StyleBox["k", "TI"], "2"], " ", 
    StyleBox["[",
     FontSize->1.2 Inherited], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]]}], ",", 
   RowBox[{
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["]",
     FontSize->1.2 Inherited], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox["k", "TI"]], " ", 
    StyleBox["(",
     FontSize->1.2 Inherited], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[Rho]", "TI"], "+", 
    StyleBox["\[Rho]", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "-", "2", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox[")",
     FontSize->1.2 Inherited], " ", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2033801793,ExpressionUUID->"40ae3c14-0aab-252d-7055-b65eaf5f8c77"],

Cell[TextData[{
 "with drive ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3710829e-7f3a-eae8-5d2f-1bd87accb832"],
 " and measurement strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "514f46f4-7214-5441-0775-5fbe07a13eab"],
 ". When ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[LessLess]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a8341fe-fd5d-b2cd-0ab1-58bbf4e90017"],
 " the switch swings almost freely; when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[GreaterGreater]", "\[CapitalOmega]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cf942e0-12f7-a17b-7487-5bcaa683f041"],
 " the watching pins it near a pole and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4db09b50-0334-b760-7b4f-131ab6c61a4a"],
 " becomes a random telegraph, the \"watched pot\" that never boils. Watch a \
gently-watched and a hard-watched history."
}], "Text",
 CellID->1670899349,ExpressionUUID->"7cb56032-9c81-172f-244b-7a7c15347a75"],

Cell[TextData[{
 "A driven qubit measured along ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f15dca-bfed-9606-038f-54943999fd6c"],
 ". Measure weakly (",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[LessLess]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5589ad74-704a-26e9-03b6-453e01fc8c33"],
 ") and it swings almost freely; measure strongly (",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[GreaterGreater]", "\[CapitalOmega]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37fda5d4-10fa-7e26-5d82-3c9ea08f450c"],
 ") and it is pinned near a ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cc64ef1-7b65-373d-14fe-67bb7e119a07"],
 " eigenstate with occasional jumps, the quantum Zeno effect. Set the drive \
and the fine time grid:"
}], "Text",
 CellID->975439503,ExpressionUUID->"542582fc-1c6f-cfd5-7dda-1ba6951b953f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalOmega]zeno", " ", "=", " ", "2.0"}], ";", " ", 
  RowBox[{"fastZeno", " ", "=", " ", "0.004"}], ";", " ", 
  RowBox[{"clockZeno", " ", "=", " ", 
   RowBox[{"fastZeno", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "3000"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[157]:= ",
 CellID->351741581,ExpressionUUID->"7ad84463-32de-d6a2-2af8-5e4d4768bc88"],

Cell["\<\
Run a weakly and a strongly measured trajectory from the same start and seed:\
\
\>", "Text",
 CellID->984679481,ExpressionUUID->"3261459d-f728-27c9-621f-5cc682c28d13"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gentle", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\[CapitalOmega]zeno", "/", "2"}], " ", "X"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "0.15", "]"}], " ", "Z"}], "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "fastZeno", ",", " ", "12.", ",", " ", 
     "7"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hard", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "excited", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\[CapitalOmega]zeno", "/", "2"}], " ", "X"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "6.", "]"}], " ", "Z"}], "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "fastZeno", ",", " ", "12.", ",", " ", 
     "7"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[158]:= ",
 CellID->412548195,ExpressionUUID->"331c7f17-1677-2611-6124-7751a3038d7b"],

Cell[TextData[{
 "Compare the magnitude of the time-averaged ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14cbe893-f079-1a7f-3cc8-01dc810c6945"],
 ":"
}], "Text",
 CellID->167190678,ExpressionUUID->"3a1d5a8b-943b-deab-6a23-53d51dcfa4f1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Abs", "@", 
    RowBox[{"Mean", "[", 
     RowBox[{"zOf", "@", 
      RowBox[{"gentle", "[", "\"\<states\>\"", "]"}]}], "]"}]}], ",", " ", 
   RowBox[{"Abs", "@", 
    RowBox[{"Mean", "[", 
     RowBox[{"zOf", "@", 
      RowBox[{"hard", "[", "\"\<states\>\"", "]"}]}], "]"}]}]}], 
  "}"}]], "Input",
 CellLabel->"In[159]:= ",
 CellID->132154406,ExpressionUUID->"355f53e5-dafb-cebc-6365-4acede8f9486"],

Cell[TextData[{
 "The weakly measured ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "492c649c-8337-646c-78d4-7dc636c24eb6"],
 " averages to near zero (it swings freely); the strongly measured one keeps \
a large mean (pinned)."
}], "Text",
 CellID->1448639745,ExpressionUUID->"1678747f-7a6a-a1d6-3e18-6e397f1cf33c"],

Cell["\<\
Now visualize the weakly and strongly measured trajectories together:\
\>", "Text",
 CellID->1881657070,ExpressionUUID->"5c54ceec-a669-4ede-046b-e7c9d31c1424"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"clockZeno", ",", " ", 
        RowBox[{"zOf", "@", 
         RowBox[{"gentle", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}], ",",
      " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"clockZeno", ",", " ", 
        RowBox[{"zOf", "@", 
         RowBox[{"hard", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"Opacity", "[", "0.8", "]"}]}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<weak measurement (free)\>\"", ",", 
      " ", "\"\<strong measurement (pinned)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]\[Sigma]z\[RightAngleBracket]\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<strong measurement freezes the qubit (Zeno)\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[160]:= ",
 CellID->1506900826,ExpressionUUID->"336f4c4f-cb14-5955-6115-6628eea12bbf"],

Cell["\<\
The strongly measured qubit clings to an eigenstate for long stretches, then \
jumps. Strong measurement freezes the dynamics, the Zeno effect: the more \
often you measure, the less the state can evolve. The jumps are the drive \
occasionally winning.\
\>", "Text",
 CellID->637363640,ExpressionUUID->"192b8c2c-1b0f-3631-4f28-26769ebb9d1b"],

Cell[TextData[{
 "The single trace shows the freezing but cannot pin its rate. That rate is \
exact and sits in the master equation's own spectrum, and following it across \
the measurement strength tells a two-stage story: watching harder first kills \
the coherent Rabi oscillation, then freezes the relaxation left behind. Both \
stages are eigenvalues of the Liouvillian. Build it at a chosen fraction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   StyleBox["k", "TI"], "/", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2580083d-358c-3435-53bf-a267bc3e9f1f"],
 " of the drive and keep the nonzero ones, so the whole crossover reads \
against that one ratio and the exceptional point falls at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "477fde83-a5ae-c17e-6d04-d7eccc589044"],
 ":"
}], "Text",
 CellID->658697144,ExpressionUUID->"0782fdeb-454d-5eca-2db1-f4b56cf82410"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"zenoEigs", "[", "ratio_", "]"}], " ", ":=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", 
      RowBox[{"liouvillian", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalOmega]zeno", "/", "2"}], ")"}], " ", "X"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"ratio", " ", "\[CapitalOmega]zeno"}], "]"}], " ", "Z"}], 
         "}"}], ",", " ", "2"}], "]"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "#", "]"}], " ", ">", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "9"}]}]}], " ", "&"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[161]:= ",
 CellID->462592558,ExpressionUUID->"69a01936-08b2-60cf-1f5f-9170a9473215"],

Cell[TextData[{
 "Below the exceptional point, at half the critical strength (",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "553ebd3d-d82b-159a-7cc5-3566d9de7fe0"],
 "), the three of them are a complex-conjugate pair and one lone real \
number:"
}], "Text",
 CellID->621689956,ExpressionUUID->"6c0b44c7-b7b3-5c45-1409-5da0c24626af"],

Cell[BoxData[
 RowBox[{"zenoEigs", "[", 
  RowBox[{"1", "/", "2"}], "]"}]], "Input",
 CellLabel->"In[162]:= ",
 CellID->912512294,ExpressionUUID->"4dba914e-52ed-e087-7b59-09286699b2ed"],

Cell[TextData[{
 "The pair is ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["k", "TI"], "\[PlusMinus]", 
   StyleBox["i", "TI"], 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "-", 
     SuperscriptBox[
      StyleBox["k", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "497e5609-e734-e246-7f06-485292c6b0ac"],
 " (here ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08c79fc2-e932-c645-38fc-16af88c4acaf"],
 "), a Rabi oscillation the measurement only damps; the lone real number is \
the transverse dephasing at ",
 Cell[BoxData[
  RowBox[{"-", "2", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2184153d-b162-7859-57bb-8d66c0174aa3"],
 ", off to the side and taking no part in the freezing."
}], "Text",
 CellID->159314101,ExpressionUUID->"2402dcb3-2cfa-7570-4c31-d5fd448f5c5a"],

Cell["\<\
The oscillation lives in the pair's imaginary part and the relaxation in the \
least-negative real part, so read one frequency and one rate off the spectrum \
at each ratio:\
\>", "Text",
 CellID->2072053663,ExpressionUUID->"554ef748-00c8-cf17-0375-ef12b162927d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"zenoFreq", "[", "ratio_", "]"}], " ", ":=", " ", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{"Im", "[", 
      RowBox[{"zenoEigs", "[", "ratio", "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zenoRate", "[", "ratio_", "]"}], " ", ":=", " ", 
   RowBox[{"-", 
    RowBox[{"Max", "[", 
     RowBox[{"Re", "[", 
      RowBox[{"zenoEigs", "[", "ratio", "]"}], "]"}], "]"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[163]:= ",
 CellID->1700462496,ExpressionUUID->"40bb2fe5-4c06-79cb-7058-c6cf65b34b11"],

Cell[TextData[{
 "Follow both across the sweep, the oscillation frequency and the slowest \
relaxation rate against the ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ee2421b-c68a-4a96-2692-6444f33f18fc"],
 ":"
}], "Text",
 CellID->758245071,ExpressionUUID->"79971006-243c-6fe2-2fac-8a604dc935c8"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", " ", 
         RowBox[{"zenoFreq", "[", "r", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0.01", ",", " ", "3.", ",", " ", "0.01"}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", " ", 
         RowBox[{"zenoRate", "[", "r", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0.01", ",", " ", "3.", ",", " ", "0.01"}], 
        "}"}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"Directive", "[", 
          RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], "}"}], ",", 
      " ", "Automatic"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Rabi oscillation  |Im \[Lambda]|\>\"", ",", 
        " ", "\"\<relaxation rate  |Re \[Lambda]|\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<k/\[CapitalOmega] ratio\>\"", ",", 
      " ", "\"\<Liouvillian eigenvalue  (1/time)\>\""}], "}"}]}], ",", "\n", 
   " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<watching harder: the oscillation dies at k = \[CapitalOmega], \
the relaxation rate peaks there\>\""}]}], "]"}]], "Input",
 CellLabel->"In[164]:= ",
 CellID->645457834,ExpressionUUID->"61109047-93e0-1377-172f-0a2125957e5d"],

Cell[TextData[{
 "The oscillation frequency slides to zero at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c784b-10c0-0bab-5c24-7215a17559f1"],
 " and stays there, the coherent swinging gone; at that same strength the \
relaxation rate reaches its peak and turns over, so watching harder past ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4125a490-d89a-105a-70da-3dddd92f62a0"],
 " slows the decay rather than quickening it. The pair has met on the real \
axis at an exceptional point, where the eigenvalues and their eigenvectors \
coincide and the oscillation can no longer be told apart from the decay."
}], "Text",
 CellID->1053805191,ExpressionUUID->"0b67f461-4283-7871-391c-ee4b77364b5b"],

Cell[TextData[{
 "Past that peak the surviving rate falls as one over the strength. Read it \
across a wide range on log-log, with the ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79999c45-ea42-0b46-2fa6-162e8ff759ac"],
 " law drawn on the strong side:"
}], "Text",
 CellID->1335228883,ExpressionUUID->"5fae9c0a-8a55-fd6e-0555-16542fe1c7b4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zenoKs", " ", "=", " ", 
   RowBox[{"\[CapitalOmega]zeno", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"2.", "^", "e"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"e", ",", " ", 
        RowBox[{"-", "3"}], ",", " ", "4", ",", " ", "0.08"}], "}"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{"ListLogLogPlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"zenoRate", "[", 
          RowBox[{"k", "/", "\[CapitalOmega]zeno"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "zenoKs"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{
          RowBox[{"\[CapitalOmega]zeno", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "k"}], ")"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"zenoKs", ",", " ", 
           RowBox[{
            RowBox[{"#", " ", ">=", " ", "\[CapitalOmega]zeno"}], " ", 
            "&"}]}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Joined", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"False", ",", " ", "True"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<measured rate  |Re \[Lambda]|\>\"", ",", 
        " ", "\"\<\!\(\*SuperscriptBox[\(\[CapitalOmega]\), \(2\)]\)/2k  (the \
Zeno freeze)\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"\[CapitalOmega]zeno", ",", " ", 
         RowBox[{"Directive", "[", 
          RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}], "}"}], ",", 
      " ", "None"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<measurement strength k\>\"", ",", 
      " ", "\"\<slowest relaxation rate  |Re \[Lambda]|\>\""}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<the rate follows k up to k = \[CapitalOmega], then freezes as \
\!\(\*SuperscriptBox[\(\[CapitalOmega]\), \(2\)]\)/2k\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[165]:= ",
 CellID->17162129,ExpressionUUID->"1ae1fb24-4e58-6c4d-4a9e-f28e6bed3697"],

Cell[TextData[{
 "Below ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a4afb14-05e6-4298-3a49-f35eb39310e2"],
 " the rate climbs along ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a681de3-120d-8f0a-4a17-94cda7b9d250"],
 "; above it the points settle onto the ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fe8910c-2477-6bad-2597-09564d0239f7"],
 " line, the leftover relaxation frozen as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4724aa69-80a2-605c-6edb-4c33315732a6"],
 ", the small gap near the peak closing as the watching strengthens. Watching \
past the optimal strength does not pin the switch harder, it slows what \
motion is left, the quantum Zeno suppression."
}], "Text",
 CellID->745178489,ExpressionUUID->"7db6e0a3-5ee4-0113-2b4d-f90d5a915079"],

Cell[TextData[{
 "The whole crossover is exact, read straight off the deterministic \
Liouvillian with no gate, no time step, and no ensemble. Its slowest \
eigenvalue returns at once in the next section as the width of the central \
peak the quantum point contact reads off its own current, so the Zeno rate \
here and that spectrum there are one number seen twice. Coherent Rabi giving \
way to overdamped freezing through a Liouvillian exceptional point is the \
modern reading of when watching stops helping and starts freezing (",
 ButtonBox["Snizhko, Kumar, and Romito, 2020",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2003.10476"], None}],
 "), seen on a driven transmon by ",
 ButtonBox["Slichter and Siddiqi, 2016",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/1512.04006"], None}],
 "."
}], "Text",
 CellID->64377810,ExpressionUUID->"64959d98-6722-362c-0caa-14c212d49d76"],

Cell["A Charge Qubit Read by a Quantum Point Contact", "Subsection",
 CellID->1276099438,ExpressionUUID->"5f8c04ec-8c47-4bdf-05b3-9db625f21925"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " The last two examples watched an abstract qubit; here is the same watching \
realized in a solid-state device. A charge qubit (one electron shared between \
two quantum dots, \"dot 1\" or \"dot 2\") is monitored by a nearby quantum \
point contact (QPC) whose current depends on which dot holds the electron. \
With interdot tunnelling ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023e8ab0-46e5-584b-33c5-23fa72902a91"],
 " and no detuning, the unconditional master equation is"
}], "Text",
 CellID->1651008988,ExpressionUUID->"5a0eac86-50d0-15df-0a35-45e061657f25"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     FontSize->1.8 Inherited], 
    FractionBox["\[CapitalOmega]", "2"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["x", "TI"]]}], ",", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], 
    StyleBox["]",
     FontSize->1.8 Inherited], "+", 
    StyleBox["\[Kappa]", "TI"], " ", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "1"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "1"], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"\|01d7d9", "-", 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], 
        StyleBox["z", "TI"]]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->807143410,ExpressionUUID->"58394c25-48c8-3ecd-09c7-658f69628417"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "2"], "-", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1424a2b0-695c-dfcb-3ddb-3bfa08eea511"],
 " the which-dot operator and ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05101942-3b9c-ad10-332f-912cbe2ef47a"],
 " the measurement-induced dephasing rate. The QPC current is a continuous \
weak measurement of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35394d45-77a0-03f4-5cc7-652f025551de"],
 ": when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "\[LessLess]", "\[CapitalOmega]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f9454e1-244e-40e6-65ac-4dcb4dfb12cc"],
 " the electron tunnels coherently and the current carries an oscillation at \
the Rabi frequency; when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "\[GreaterGreater]", "\[CapitalOmega]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "530b93a6-4244-79d7-0108-0a0077f14b3d"],
 " the qubit is pinned and the current is a random telegraph. Build the \
conditioned dynamics, the detector current, and the current's power \
spectrum."
}], "Text",
 CellID->2004841178,ExpressionUUID->"4c785ed8-c9e5-405c-7418-5785ef9012a6"],

Cell[TextData[{
 "The dephasing ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a66b72e-8103-1d0f-3a1d-2e8830b66455"],
 " is a projector, and ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   FractionBox["1", "4"], "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6206b938-b2f8-72db-123d-3165c68d4021"],
 " (the identity part drops from any dissipator), so watching the QPC is \
exactly watching ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a01a055-721a-3362-2a3e-3a1f07ac9e48"],
 " at strength ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "425e231b-d90e-d650-7265-bb44d8b8bcba"],
 ": the machinery of the last two examples applies unchanged. Fix the \
tunnelling and the two regimes:"
}], "Text",
 CellID->680262370,ExpressionUUID->"6f4b19d7-d2e6-1d55-1548-9090e69367bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"OmQpc", " ", "=", " ", "2.0"}], ";", " ", 
  RowBox[{"kSlow", " ", "=", " ", "0.6"}], ";", " ", 
  RowBox[{"kFast", " ", "=", " ", "12.0"}], ";", " ", 
  RowBox[{
   RowBox[{"qpcLeak", "[", "\[Kappa]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Kappa]", "/", "4"}], "]"}], " ", "Z"}]}], ";"}]], "Input",
 CellLabel->"In[166]:= ",
 CellID->2074260939,ExpressionUUID->"266a3a12-a29b-0b72-4e69-bc5fd72e5658"],

Cell[TextData[{
 "The conditioned trajectory uses the toolkit's positivity-preserving step; \
the recorded current is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["J", "TI"], "."], "=", 
   SqrtBox[
    StyleBox["\[Kappa]", "TI"]], " ", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "+", 
   StyleBox[
    RowBox[{"shot", "\[NonBreakingSpace]", "noise"}],
    FontSlant->"Plain"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b97aeb9-f3a3-063a-49ac-47e286566d00"],
 ", the QPC output. Run one weakly-measured (coherent) history and one \
strongly-measured (Zeno) history:"
}], "Text",
 CellID->1484886568,ExpressionUUID->"670ec096-5157-8cf5-0d35-d9d060e3d6df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dtQpc", " ", "=", " ", "0.004"}], ";", " ", 
  RowBox[{"tfQpc", " ", "=", " ", "10."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qpcSlow", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "ground", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"qpcLeak", "[", "kSlow", "]"}], "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "dtQpc", ",", " ", "tfQpc", ",", " ", 
     "4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qpcFast", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "ground", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"qpcLeak", "[", "kFast", "]"}], "}"}], ",", " ", 
     RowBox[{"{", "1.", "}"}], ",", " ", 
     RowBox[{"{", "}"}], ",", " ", "dtQpc", ",", " ", "tfQpc", ",", " ", 
     "4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"whenQpc", " ", "=", " ", 
   RowBox[{"qpcSlow", "[", "\"\<times\>\"", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[167]:= ",
 CellID->1547996435,ExpressionUUID->"4a46f8a5-a076-b8c1-7a7d-f10ed1000a2b"],

Cell[TextData[{
 "The QPC hands back a single real record, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "=", 
   SqrtBox[
    StyleBox["\[Kappa]", "TI"]], " ", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b9d6462-a0fd-67c7-29a3-7e4fd0884d2d"],
 ", one continuous measurement of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c567373-a618-e547-046e-6b3cd392cfad"],
 ": it is the homodyne ledger again in a solid-state skin, the record the \
only data and the coherent which-dot swing inferred from it, buried per step \
under shot noise many times larger."
}], "Text",
 CellID->1622616291,ExpressionUUID->"5028993e-6f44-360e-01d7-11780af69d54"],

Cell["\<\
Contrast the two regimes directly, the coherent swing against the \
strongly-watched telegraph:\
\>", "Text",
 CellID->1371263066,ExpressionUUID->"05297336-3344-a7f5-2cd7-6b7046f60ddf"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"whenQpc", ",", " ", 
        RowBox[{"zOf", "@", 
         RowBox[{"qpcSlow", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}], ",",
      " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"whenQpc", ",", " ", 
        RowBox[{"zOf", "@", 
         RowBox[{"qpcFast", "[", "\"\<states\>\"", "]"}]}]}], "}"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"Opacity", "[", "0.85", "]"}]}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<weak (coherent tunnelling)\>\"", ",", 
      " ", "\"\<strong (Zeno telegraph)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]\[Sigma]z\[RightAngleBracket]\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<measurement strength selects coherent oscillation or \
telegraph\>\""}]}], "]"}]], "Input",
 CellLabel->"In[168]:= ",
 CellID->1067912469,ExpressionUUID->"75fa11b5-921a-0030-2399-88ff27af531a"],

Cell["\<\
Weak measurement leaves the electron tunnelling freely; strong measurement \
pins it in one dot with rare jumps.\
\>", "Text",
 CellID->943837838,ExpressionUUID->"2d27580a-3980-0923-54dd-5254b8355809"],

Cell[TextData[{
 "The distinctive QPC signature is not in any single record but in the ",
 StyleBox["spectrum", "TI"],
 ", because a coherent oscillation is a ",
 StyleBox["frequency", "TI"],
 ": it cancels in the time-integral of the record and shows itself only in \
the spectrum, painting a peak at the Rabi frequency in the fluctuations of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "077289f0-6175-2cad-2d01-20ba100076f7"],
 " that the detector current inherits. The power spectrum is the Fourier \
transform of the steady-state autocorrelation ",
 Cell[BoxData[
  SubscriptBox[
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["\[Delta]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Tau]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], " ", 
     StyleBox["\[Delta]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["(",
      SpanMaxSize->1], "0", 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], 
   StyleBox["ss",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "133b68ba-8b92-4fbc-42d8-81e42e271586"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "-", 
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["ss",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6db49e4d-4459-39d0-1b4b-10176ded8b3a"],
 " is the fluctuation about the steady mean. Quantum regression is the \
statement that this correlation runs on the ",
 StyleBox["same", "TI"],
 " Liouvillian as the state: plant the seed ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], " ", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["ss",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01e45bb6-31a6-d4bb-379c-52f04050be81"],
 ", propagate it by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"\[ScriptCapitalL]", 
    StyleBox["\[Tau]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "638a875f-059e-01af-1189-1f19ac2b53f5"],
 ", and read ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b1c9c05-9360-5fc6-6923-166f2615252c"],
 " back off it, so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], "\[NegativeThinSpace]", 
   StyleBox["[",
    FontSize->1.2 Inherited], 
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"\[ScriptCapitalL]", 
     StyleBox["\[Tau]", "TI"]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Delta]", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], " ", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["]",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d8f8704-dbc1-ad9f-5bb4-1f61de75f7e5"],
 "."
}], "Text",
 CellID->1450235700,ExpressionUUID->"7bacb1bf-0091-7884-2953-28f9b1244aee"],

Cell[TextData[{
 "Fourier-transforming in ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e949b39-c960-dcff-16ab-1362e81aa6c5"],
 " replaces the propagator ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"\[ScriptCapitalL]", 
    StyleBox["\[Tau]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52d3365b-85bc-1911-02e0-a8052c49687b"],
 " by a single matrix inverse, the resolvent ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["\[Omega]", "TI"], "-", "\[ScriptCapitalL]"}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   RowBox[{"-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "058c1579-2127-d4ed-33b3-8d2350d3be37"],
 ", and diagonalizing the Liouvillian breaks that inverse into one simple \
pole per eigenvalue ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f55ae27-0b76-e8ec-756a-4781ae00ba36"],
 ". An eigenvalue ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["j", "TI"]], "=", "-", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["j", "TI"]], "+", 
   StyleBox["i", "TI"], 
   SubscriptBox[
    StyleBox["\[Nu]", "TI"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62fbf51e-f93c-ccd0-1298-ed5bf8ce963a"],
 " is one decaying, oscillating mode, and its pole is a Lorentzian centered \
at the frequency ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Nu]", "TI"], 
    StyleBox["j", "TI"]], "=", 
   StyleBox["Im",
    FontSlant->"Plain"], " ", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "011d018b-0453-500f-3722-98d5ade62355"],
 " with half-width the decay rate ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["j", "TI"]], "=", GridBox[{
     {
      RowBox[{
       StyleBox["Re",
        FontSlant->"Plain"], " ", 
       SubscriptBox[
        StyleBox["\[Lambda]", "TI"], 
        StyleBox["j", "TI"]]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b868176-6936-78c0-49bd-193008c34a2a"],
 ". Each Lorentzian is weighted by ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["j", "TI"]], " ", 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "317554d9-f61a-a01f-670b-4d8283acf365"],
 ": the coefficient ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "581509a3-40d5-fdc4-082a-a00d7161c72e"],
 " is how much of the seed lies along mode ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27a46d13-c303-51d0-4d5b-855cf6b6233a"],
 ", its coordinate when the seed is written in the eigenbasis, and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["r", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17c64253-a2be-52b9-3dfe-641cd74b2083"],
 " is how strongly the readout ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a34ce21-af18-53d3-0bcb-e78acaad2139"],
 " sees that mode, its overlap with it. Summing the poles, with the steady \
mode ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["j", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1308debe-b866-1363-4137-d7f839137e49"],
 " dropped because ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "339fc10a-19b9-5d82-61a4-d954984c27e8"],
 " has zero steady mean,"
}], "Text",
 CellID->257312343,ExpressionUUID->"442b12f5-789a-53e1-6c28-8bbf792f21cb"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["S", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Omega]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", "2", " ", 
    StyleBox["Re",
     FontSlant->"Plain"], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Lambda]", "TI"], 
       StyleBox["j", "TI"]], "\[NotEqual]", "0"}],
     LimitsPositioning->False], 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["c", "TI"], 
       StyleBox["j", "TI"]], " ", 
      SubscriptBox[
       StyleBox["r", "TI"], 
       StyleBox["j", "TI"]]}], 
     RowBox[{
      StyleBox["i", "TI"], 
      StyleBox["\[Omega]", "TI"], "-", 
      SubscriptBox[
       StyleBox["\[Lambda]", "TI"], 
       StyleBox["j", "TI"]]}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1811882128,ExpressionUUID->"39387274-e40a-435c-68d8-74318dbf11a6"],

Cell["\<\
This is where the slowest eigenvalue of the Zeno crossover returns: it is the \
pole nearest the imaginary axis, so it is the narrowest Lorentzian, and its \
half-width is that same relaxation rate.\
\>", "Text",
 CellID->33577298,ExpressionUUID->"70ecc98e-c53f-f68b-2093-e0ebeccbdcd1"],

Cell[TextData[{
 "Build the general spectrum for any Liouvillian, seed, and readout: \
eigendecompose the Liouvillian, find the seed's coordinates ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53e7ddcf-0b8d-05e4-019c-d4a9ae386fce"],
 " by solving for them in the eigenbasis, read each mode's overlap ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["r", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a830965-7851-22cf-4ab0-a14f79e47015"],
 " with the readout, and sum the poles at every requested frequency:"
}], "Text",
 CellID->240192060,ExpressionUUID->"47763c58-6b8c-f19b-6d0d-b6020e3ec3e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"regressionSpectrum", "[", 
    RowBox[{
    "big_", ",", " ", "seedMat_", ",", " ", "readout_", ",", " ", "tones_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"Length", "[", "readout", "]"}]}], ",", " ", "vals", ",", " ",
        "vecs", ",", " ", "coeffs", ",", " ", "resu"}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vals", ",", " ", "vecs"}], "}"}], " ", "=", " ", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"Transpose", "[", "big", "]"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"coeffs", " ", "=", " ", 
       RowBox[{"LinearSolve", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", "vecs", "]"}], ",", " ", 
         RowBox[{"Flatten", "[", "seedMat", "]"}]}], "]"}]}], ";", "\n", 
      "   ", 
      RowBox[{"resu", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{"readout", " ", ".", " ", 
           RowBox[{"ArrayReshape", "[", 
            RowBox[{
             RowBox[{"vecs", "[", 
              RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", 
           RowBox[{"d", "^", "2"}]}], "}"}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"Re", "@", 
          RowBox[{"Total", "@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"vals", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "<", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "9"}]}]}], ",", " ", "0", ",", " ", 
               RowBox[{
                RowBox[{"coeffs", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], " ", 
                RowBox[{
                 RowBox[{"resu", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"I", " ", "w"}], " ", "-", " ", 
                   RowBox[{"vals", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}]}]}], "]"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", 
               RowBox[{"d", "^", "2"}]}], "}"}]}], "]"}]}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"w", ",", " ", "tones"}], "}"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[169]:= ",
 CellID->1178070921,ExpressionUUID->"2411395d-4500-dc0b-4c2e-b1076cbaa751"],

Cell[TextData[{
 Cell[BoxData["vals"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51798d79-74e7-e8a1-0706-25237c93ba8b"],
 " are the eigenvalues ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e7478e0-34bc-b2ae-360c-71cabd4e00f4"],
 "; ",
 Cell[BoxData["coeffs"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa139-5ae3-ed74-4004-39635e97b45e"],
 " are the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0084d900-0120-94d6-30bb-d16ab0dafe3c"],
 ", produced by ",
 Cell[BoxData["LinearSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45e3bdb3-b7b8-8152-7390-34fcc232d3b8"],
 " writing the seed as a combination of the eigenmodes; ",
 Cell[BoxData["resu"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e5e1e6c-8075-0eb3-0665-903631005499"],
 " are the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["r", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b122816-0897-a47c-6921-c250a9230f46"],
 ", each mode's trace against the readout; the last line sums ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["j", "TI"]], 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox["j", "TI"]], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], 
    StyleBox["\[Omega]", "TI"], "-", 
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12228eb7-81d1-9f6b-43d1-27f13065e5b1"],
 " over the nonzero eigenvalues."
}], "Text",
 CellID->1900683911,ExpressionUUID->"0c4e3d89-d3d8-0dbe-3475-b4d2e66d5784"],

Cell[TextData[{
 "Now specialize to the QPC. Build its Liouvillian and steady state, center \
",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44dcab5a-698d-607d-6ce3-430408383347"],
 " on its steady value to form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "268a9802-0d7f-2bfd-4e89-126ca40a79c7"],
 ", and hand the symmetrized seed ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Delta]", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], " ", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]], "+", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["ss",
      FontSlant->"Plain"]], " ", 
    StyleBox["\[Delta]", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79bc5755-bb31-5780-2f44-4f1f3ec43dea"],
 " together with that same ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ff00406-ec89-251c-358f-9e63853d8c66"],
 " as the readout to the general function:"
}], "Text",
 CellID->760242175,ExpressionUUID->"7d6791a5-5599-4f2a-2b1c-080f5c2c1270"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qpcSpectrum", "[", 
    RowBox[{"\[Kappa]_", ",", " ", "tones_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"big", " ", "=", " ", 
        RowBox[{"liouvillian", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"qpcLeak", "[", "\[Kappa]", "]"}], "}"}], ",", " ", "2"}], 
         "]"}]}], ",", " ", 
       RowBox[{"rss", " ", "=", " ", 
        RowBox[{"First", "@", 
         RowBox[{"steadyState", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"OmQpc", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"qpcLeak", "[", "\[Kappa]", "]"}], "}"}]}], "]"}]}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dz", " ", "=", " ", 
         RowBox[{"Z", " ", "-", " ", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{"Z", " ", ".", " ", "rss"}], "]"}], "]"}], " ", 
           "id2"}]}]}], "}"}], ",", " ", 
       RowBox[{"regressionSpectrum", "[", 
        RowBox[{"big", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"dz", " ", ".", " ", "rss"}], " ", "+", " ", 
            RowBox[{"rss", " ", ".", " ", "dz"}]}], ")"}], "/", "2"}], ",", 
         " ", "dz", ",", " ", "tones"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[170]:= ",
 CellID->828244791,ExpressionUUID->"7c7441be-5925-9c2b-240c-58f858d1e771"],

Cell[TextData[{
 "Here ",
 Cell[BoxData["dz"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ff4eb8a-8686-c1c6-058b-02d43330932c"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "049abcb6-c083-4b47-2cb9-35f3f13619ad"],
 ", and symmetrizing the seed keeps the correlation real and even in ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00908b6d-9173-71f0-30af-2337200643da"],
 ", which is the physical spectrum a detector measures."
}], "Text",
 CellID->338384234,ExpressionUUID->"0c438d61-2567-fb5f-3470-254b4c13c9a5"],

Cell[TextData[{
 "Confirm the normalization is right: the spectrum integrates to the steady \
variance of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3129044e-2557-7c3e-60d6-9e284ce24704"],
 ", which is one for the maximally mixed steady state:"
}], "Text",
 CellID->455054057,ExpressionUUID->"185e1b20-c9fe-9997-4865-928def88ebfd"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"wide", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "40"}], ",", " ", "40", ",", " ", "0.02"}], "]"}]}], 
    "}"}], ",", " ", 
   RowBox[{"0.02", " ", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"qpcSpectrum", "[", 
       RowBox[{"1.", ",", " ", "wide"}], "]"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "Pi"}], ")"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[171]:= ",
 CellID->1632384583,ExpressionUUID->"79986dc0-6b5a-b4b1-2fa7-84aa0eec1e9b"],

Cell["It returns one, so the spectral weight is accounted for.", "Text",
 CellID->1806839179,ExpressionUUID->"66994d41-411f-db5d-0ea7-652b70aba9a7"],

Cell[TextData[{
 "Now sweep the ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   StyleBox["k", "TI"], "/", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ba5d17e-cdbf-5380-095a-c93be44a21ea"],
 " of the effective measurement strength ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   StyleBox["\[Kappa]", "TI"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4459b86e-fafc-12f5-6c66-324bfe8960df"],
 " to the drive, from weak, through the exceptional point at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bcb2561-df35-3b41-39c8-bd4adac189ab"],
 ", to deep in the Zeno regime. Take five ratios along that path:"
}], "Text",
 CellID->1374498314,ExpressionUUID->"2cdc7c52-f996-171f-54e4-761ff8237a65"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ratioSweep", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0.25", ",", " ", "0.5", ",", " ", "0.75", ",", " ", "1.", ",", " ", 
     "1.5"}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[172]:= ",
 CellID->1735539757,ExpressionUUID->"6a04a347-6624-93dc-1a3b-3b2113d6e126"],

Cell[TextData[{
 "Resolve each spectrum on a fine frequency grid wide enough to hold both \
Rabi peaks near ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fa3b0bf-db30-02a1-4550-29f8dec5508b"],
 ":"
}], "Text",
 CellID->913947365,ExpressionUUID->"11dd9886-a103-697c-47e2-11e3d0b63846"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tonesQpc", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "6"}], ",", " ", "6", ",", " ", "0.04"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[173]:= ",
 CellID->33048482,ExpressionUUID->"5d16072b-4094-e7d7-0b2d-9f757126cd3d"],

Cell["\<\
Colour the curves warm to cool across the sweep, so the peaks' inward march \
reads at a glance:\
\>", "Text",
 CellID->1913442451,ExpressionUUID->"6e71c00a-9fc6-07cd-160e-da541a736d17"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sweepCols", " ", "=", " ", 
   RowBox[{
    RowBox[{"ColorData", "[", "\"\<TemperatureMap\>\"", "]"}], " ", "/@", " ", 
    RowBox[{"Subdivide", "[", 
     RowBox[{
      RowBox[{"Length", "[", "ratioSweep", "]"}], " ", "-", " ", "1"}], 
     "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[174]:= ",
 CellID->1066460469,ExpressionUUID->"59da3beb-dbdf-0123-0ff9-b2b4de6a5009"],

Cell[TextData[{
 "Overlay the five power spectra, one per ratio (recovering ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "=", "4", "\[CapitalOmega]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28f3c6b4-96e3-425b-5880-dffe229610a1"],
 " for each), with gridlines at ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50dcf632-b06e-d3ec-00e3-e87fc118a136"],
 ":"
}], "Text",
 CellID->1552927865,ExpressionUUID->"0192d3b7-44a5-149f-37a1-caf16d507ee5"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tonesQpc", ",", " ", 
        RowBox[{"qpcSpectrum", "[", 
         RowBox[{
          RowBox[{"4", " ", "OmQpc", " ", "r"}], ",", " ", "tonesQpc"}], 
         "]"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "ratioSweep"}], "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Directive", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"Thickness", "[", "0.006", "]"}]}], "]"}], " ", "&"}], " ", "/@",
       " ", "sweepCols"}], ")"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"LineLegend", "[", 
     RowBox[{"sweepCols", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<k/\[CapitalOmega] = 0.25  (weak)\>\"", ",", 
        " ", "\"\<k/\[CapitalOmega] = 0.5\>\"", ",", 
        " ", "\"\<k/\[CapitalOmega] = 0.75\>\"", ",", 
        " ", "\"\<k/\[CapitalOmega] = 1  (exceptional point)\>\"", ",", 
        " ", "\"\<k/\[CapitalOmega] = 1.5  (Zeno)\>\""}], "}"}]}], "]"}]}], ",",
    "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "OmQpc"}], ",", " ", "0", ",", " ", "OmQpc"}], "}"}], ",",
       " ", "None"}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Medium"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency\>\"", ",", 
      " ", "\"\<\!\(\*SubscriptBox[\(S\), \(zz\)]\)(\[Omega])\>\""}], "}"}]}],
    ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<watching harder marches the Rabi peaks inward,\n merging them \
at the exceptional point\>\""}]}], "]"}]], "Input",
 CellLabel->"In[175]:= ",
 CellID->262489656,ExpressionUUID->"0300f609-8c78-c232-313f-e85325f29118"],

Cell[TextData[{
 "At weak watching the spectrum is split, twin peaks near ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "366efd8d-b3b0-5f87-5e15-f4d6c64525ed"],
 ", the coherent Rabi oscillation written into the fluctuations of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3db21443-28a2-09d2-6b41-8e2d49575b38"],
 ", the solid-state echo of the Mollow triplet's sidebands. Watching harder \
marches those peaks inward to the damped Rabi frequency ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "-", 
     SuperscriptBox[
      StyleBox["k", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bbb6266-506e-8b43-5958-84406118d9a9"],
 " and broadens them, until at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e86e78b-e825-43de-16bd-fed489d01124"],
 " (ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", "\[CapitalOmega]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00acb0de-f92e-37b6-3053-299bf8d89d9c"],
 ", that is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "=", "4", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "688c2685-a509-dc5c-18b3-bfeeccbda6a6"],
 ") they collide and merge at zero. That coalescence is the ",
 StyleBox["exceptional point",
  FontWeight->"Bold"],
 " of the Zeno crossover read in frequency: the two Liouvillian eigenvalues \
and their eigenvectors merge together at once, leaving the Liouvillian \
defective, so the oscillation can no longer be told apart from the decay and \
the two spectral peaks become one. Past it a single central Lorentzian \
remains, narrowing as the Zeno rate ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ceaa2e1-4528-9e89-54e9-3bcb6cc2e4d3"],
 ", its half-width the same slowest eigenvalue that section tracked, so the \
whole crossover, not just that one rate, is seen twice."
}], "Text",
 CellID->409171113,ExpressionUUID->"1303f7c9-9cc9-b37e-4130-ee93157d1e44"],

Cell[TextData[{
 "What a lab actually records is the detector ",
 StyleBox["current", "TI"],
 " spectrum, the flat shot-noise floor with this ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox[
     RowBox[{"z", "z"}], "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ec53290-e027-d466-56fa-abdd91d3bf4c"],
 " riding on it (scaled by the measurement coupling); a fundamental result, \
the Korotkov-Averin bound, caps that current peak at four times the \
shot-noise background for a quantum-limited detector, the solid-state \
statement of the measurement limit that runs through this whole catalog."
}], "Text",
 CellID->189753264,ExpressionUUID->"18ec055d-da13-7d9a-4893-9d06dfa647e0"],

Cell[TextData[{
 "Two different knobs move two different crossovers, and they should not be \
confused: the ",
 StyleBox["measurement strength", "TI"],
 " ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "210c0b92-bdf5-0dca-5733-a2dc3b805710"],
 " sets coherent-oscillation versus Zeno-telegraph behaviour (shown above), \
while the detector ",
 StyleBox["transparency", "TI"],
 " sets whether the record is read as discrete electron jumps (a counting \
unravelling like the photon counter) or as this diffusive current. Both \
unravellings average to the one master equation above."
}], "Text",
 CellID->1113565082,ExpressionUUID->"08a8ae1a-48d1-1e8c-3857-4044696464d6"],

Cell["Measurement-Induced Localization", "Subsection",
 CellID->474827638,ExpressionUUID->"5a42a6f1-18c8-51d7-0a71-3fbb997d233d"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " The general continuous measurement of an observable (here ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "151d482b-bd7d-21e9-4323-627534087333"],
 ") on an ",
 StyleBox["undriven", "TI"],
 " switch, written in the catalog's measurement-strength convention:"
}], "Text",
 CellID->480943277,ExpressionUUID->"5613a8b7-1620-2919-7e20-41f1a3d57863"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", 
    StyleBox["k", "TI"], " ", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox["k", "TI"]], " ", 
    StyleBox["(",
     FontSize->1.2 Inherited], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[Rho]", "TI"], "+", 
    StyleBox["\[Rho]", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "-", "2", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox[")",
     FontSize->1.2 Inherited], " ", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox[
     RowBox[{"d", "y"}], "TI"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], 
        StyleBox["z", "TI"]], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], " ", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{
      FractionBox[
       StyleBox[
        RowBox[{"d", "W"}], "TI"], 
       RowBox[{"2", 
        SqrtBox[
         StyleBox["k", "TI"]]}]], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->19659169,ExpressionUUID->"5ae8fe52-8d2a-0d13-0a97-f01c24df5479"],

Cell[TextData[{
 "With nothing pushing, the state's knowledge sharpens toward an eigenstate \
of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9a61ac-db6f-0823-69ba-7809de1a5b09"],
 " at the rate set by ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ebbb135-9363-cdcb-4658-297f26179711"],
 ": each history collapses to one pole, the choice fixed only by the noise, \
while the average over histories stays balanced. Watch many histories make \
their choice."
}], "Text",
 CellID->1122889797,ExpressionUUID->"3fac2774-ed95-ff32-6553-bf318421c218"],

Cell[TextData[{
 "Turn off the drive and measure ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e0bfcd9-47ee-c5d1-2608-f5837198af3b"],
 " on a state leaning toward ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bce04d4-edb5-1ec8-29f5-9d9184406412"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["z", "TI"], "0"], "=", "0.5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04eac529-5321-5efa-2ce9-dd7366d424c0"],
 ". With no Hamiltonian, measurement alone drives each run to a ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "121d8e7a-a943-ef24-4222-2027c8f7b20e"],
 " eigenstate, ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f53e49d-d2a9-b4ee-6560-fdc6e75d1e34"],
 " or ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "672c7908-ff3c-85a7-0ed4-7155faceef8d"],
 ", and the record that drives the collapse is also what reads out which pole \
it chose. Fix the biased start, the measured operator, and a fine grid:"
}], "Text",
 CellID->1606600295,ExpressionUUID->"4f36945c-6fe2-68e0-76cd-0e0609973aca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"z0Loc", " ", "=", " ", "0.5"}], ";", " ", 
  RowBox[{"x0Loc", " ", "=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"1", " ", "-", " ", 
     RowBox[{"z0Loc", "^", "2"}]}], "]"}]}], ";", " ", 
  RowBox[{"measZ", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "1.5", "]"}], " ", "Z"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dtLoc", " ", "=", " ", "0.002"}], ";", " ", 
  RowBox[{"tfLoc", " ", "=", " ", "2."}], ";", " ", 
  RowBox[{"gridLoc", " ", "=", " ", 
   RowBox[{"dtLoc", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", 
      RowBox[{"Round", "[", 
       RowBox[{"tfLoc", "/", "dtLoc"}], "]"}]}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[176]:= ",
 CellID->215661095,ExpressionUUID->"250c2a2d-8da6-5f9d-5333-cc77245325e7"],

Cell[TextData[{
 "One run reads the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67928f76-a8f6-4c39-0da1-2733c8831703"],
 " component throughout; run a fan of them, and beside them solve the master \
equation for the record-blind mean:"
}], "Text",
 CellID->1518204824,ExpressionUUID->"6f8d9e4d-778e-395a-15b2-101702388ba0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"locZ", "[", "seed_", "]"}], " ", ":=", " ", 
   RowBox[{"zOf", "@", 
    RowBox[{
     RowBox[{"trajectory", "[", 
      RowBox[{
       RowBox[{"blochState", "[", 
        RowBox[{"x0Loc", ",", " ", "0", ",", " ", "z0Loc"}], "]"}], ",", " ", 
       
       RowBox[{"0", " ", "id2"}], ",", " ", 
       RowBox[{"{", "measZ", "}"}], ",", " ", 
       RowBox[{"{", "1.", "}"}], ",", " ", 
       RowBox[{"{", "}"}], ",", " ", "dtLoc", ",", " ", "tfLoc", ",", " ", 
       "seed"}], "]"}], "[", "\"\<states\>\"", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fanLoc", " ", "=", " ", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"locZ", "[", "s", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "60"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"meanLoc", " ", "=", " ", 
   RowBox[{"zOf", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"evolveODE", "[", 
        RowBox[{
         RowBox[{"0", " ", "id2"}], ",", " ", 
         RowBox[{"{", "measZ", "}"}], ",", " ", 
         RowBox[{"blochState", "[", 
          RowBox[{"x0Loc", ",", " ", "0", ",", " ", "z0Loc"}], "]"}], ",", 
         " ", "tfLoc"}], "]"}], "[", "#", "]"}], " ", "&"}], " ", "/@", " ", 
     "gridLoc"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[177]:= ",
 CellID->1890580947,ExpressionUUID->"4897ab63-07fe-7036-78ac-434db18b431c"],

Cell[TextData[{
 "Now visualize the fan against that conserved mean: every path is absorbed \
at a pole while the thick master-equation curve holds flat at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["z", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3afe1774-f6b9-1a20-6a85-8f31834c690a"],
 ":"
}], "Text",
 CellID->1680570408,ExpressionUUID->"0cb96547-3d6c-b437-3447-7d21b41e1f1d"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"gridLoc", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], " ", "/@",
       " ", "fanLoc"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"Opacity", "[", "0.12", "]"}]}], "]"}]}]}], "]"}], ",", "\n", 
   " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"gridLoc", ",", " ", "meanLoc"}], "}"}], "]"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}]}], "]"}]}]}], "]"}], ",", "\n", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]\[Sigma]z\[RightAngleBracket]\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<each run is absorbed at a pole; the master-equation mean holds \
at z0\>\""}]}], "]"}]], "Input",
 CellLabel->"In[178]:= ",
 CellID->475458560,ExpressionUUID->"2231aed9-983c-87b7-53ce-478319ceed9d"],

Cell[TextData[{
 "Every run ends at a pole, yet the thick curve never leaves ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["z", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d324fdb-2677-e56b-74c2-66855303cfb1"],
 ": the dephasing ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5da8286f-a7a3-9cec-0b57-c248d257e636"],
 " leaves the populations untouched, so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d602230-5f26-2f06-2b1f-c47a5ad3726c"],
 " is conserved on average. That makes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77db54cc-ee9f-ec5f-1df9-4da98b2bb6a5"],
 " a bounded martingale trapped in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", "1"}], ",", "1"}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a072e47-9a01-f132-1a3c-c0211fb5c018"],
 ", and since every run is absorbed at ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03b41a97-fa59-5a01-314b-93d0ffec296b"],
 ", the split follows from the optional stopping theorem with nothing to fit: \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], "\[Infinity]", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "425dab48-397f-3702-7262-4312b80b9a68"],
 " averages back to ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["z", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b03a0e0-ac2b-54e8-3930-39cdc5de3e32"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], "+"], "-", 
   SubscriptBox[
    StyleBox["p", "TI"], "-"], "=", 
   SubscriptBox[
    StyleBox["z", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23998a05-7963-184f-51a6-2c6f78166a95"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], "+"], "+", 
   SubscriptBox[
    StyleBox["p", "TI"], "-"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "422628af-426c-374e-73dd-c109771e9d94"],
 " give ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], "\[PlusMinus]"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", 
    SubscriptBox[
     StyleBox["z", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26e7e4d8-634d-0d10-4e9c-fd8216f8547a"],
 ". Born is a theorem about the martingale, not a fraction the run count has \
to chase. The symmetric ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["z", "TI"], "0"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "027e254c-1480-02c1-3205-bd169d35502b"],
 " start, the state the earlier examples called ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6456a901-44b8-c553-0c6d-416b6d32afb9"],
 ", is the equal-weight special case."
}], "Text",
 CellID->823056013,ExpressionUUID->"5de3bc1f-ff0d-b0a4-0b90-3658fab9028e"],

Cell[TextData[{
 "The record is what a detector actually delivers, and it both drives the \
collapse and reads it out. Accumulate each run's record into the integrated \
readout ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubsuperscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"]], 
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05b0da98-ac84-313a-334f-d3c5c5368000"],
 " and keep the pole it lands on:"
}], "Text",
 CellID->1392600812,ExpressionUUID->"1895dfb3-965d-1c83-48aa-d6fd23e866e9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"readOut", "[", "seed_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"run", " ", "=", " ", 
       RowBox[{"trajectory", "[", 
        RowBox[{
         RowBox[{"blochState", "[", 
          RowBox[{"x0Loc", ",", " ", "0", ",", " ", "z0Loc"}], "]"}], ",", 
         " ", 
         RowBox[{"0", " ", "id2"}], ",", " ", 
         RowBox[{"{", "measZ", "}"}], ",", " ", 
         RowBox[{"{", "1.", "}"}], ",", " ", 
         RowBox[{"{", "}"}], ",", " ", "dtLoc", ",", " ", "tfLoc", ",", " ", 
         "seed"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Accumulate", "[", 
          RowBox[{"Flatten", "@", 
           RowBox[{"run", "[", "\"\<record\>\"", "]"}]}], "]"}], ",", " ", 
         "0."}], "]"}], ",", " ", 
       RowBox[{"Sign", "[", 
        RowBox[{"Last", "@", 
         RowBox[{"zOf", "@", 
          RowBox[{"run", "[", "\"\<states\>\"", "]"}]}]}], "]"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"readData", " ", "=", " ", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"readOut", "[", "s", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "400"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[179]:= ",
 CellID->1250002485,ExpressionUUID->"2deed3b4-be8d-db40-5b95-cafe3b39a9aa"],

Cell["\<\
Now visualize the integrated record, one path per run, colored by the pole \
the run reached: each single increment is almost pure noise, but the \
accumulated record fans into two well-separated groups:\
\>", "Text",
 CellID->1196503608,ExpressionUUID->"78e6b17c-c991-15ef-289d-2939e8247f35"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"show", " ", "=", " ", 
     RowBox[{"readData", "[", 
      RowBox[{"[", 
       RowBox[{";;", " ", "50"}], "]"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"gridLoc", ",", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "]"}], " ", "&"}], " ", "/@",
       " ", "show"}], ",", "\n", "  ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", ">", " ", "0"}], ",", " ", 
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"ColorData", "[", 
              RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
             RowBox[{"Opacity", "[", "0.45", "]"}]}], "]"}], ",", " ", 
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"ColorData", "[", 
              RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
             RowBox[{"Opacity", "[", "0.45", "]"}]}], "]"}]}], "]"}], " ", 
         "&"}], " ", "/@", " ", "show"}], ")"}]}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", " ", "\"\<integrated record  J(t)\>\""}], 
       "}"}]}], ",", " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<the integrated record splits by the pole each run \
chose\>\""}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[180]:= ",
 CellID->35509309,ExpressionUUID->"24acbe62-bdf4-ffe2-4c53-304c3b86c5c8"],

Cell[TextData[{
 "The sign of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["T", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38f0085c-4734-4722-688f-a20672c12a08"],
 " is the readout's verdict on the eigenstate; measure how often it is right \
as the integration window grows:"
}], "Text",
 CellID->133207102,ExpressionUUID->"6b9216eb-8f9f-eb69-19a1-8fb52a2bb9b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fidLoc", "[", "T_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"iT", " ", "=", " ", 
       RowBox[{
        RowBox[{"Round", "[", 
         RowBox[{"T", "/", "dtLoc"}], "]"}], " ", "+", " ", "1"}]}], "}"}], ",",
      " ", 
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Boole", "[", 
         RowBox[{
          RowBox[{"Sign", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", "iT"}], "]"}], "]"}], "]"}], " ", "==", 
          " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "&"}], " ", "/@", 
       " ", "readData"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"T", ",", " ", 
       RowBox[{"fidLoc", "[", "T", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"T", ",", " ", "0.05", ",", " ", "tfLoc", ",", " ", "0.05"}], 
      "}"}]}], "]"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0.45", ",", " ", "1.02"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "500"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<integration time T\>\"", ",", 
      " ", "\"\<assignment fidelity\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<longer integration reads the eigenstate out with \
certainty\>\""}]}], "]"}]}], "Input",
 CellLabel->"In[181]:= ",
 CellID->1619111818,ExpressionUUID->"59f120da-5631-2eb2-0f8e-b98463c47498"],

Cell[TextData[{
 "The fidelity climbs to one: given enough record, the sign of its integral \
names the eigenstate for sure, a continuous measurement gone projective in \
the long-time limit. Two things keep this honest rather than a lookup. The \
eigenstate is not fixed in advance, it is chosen by the very record that \
reads it out, so the two groups form only as the collapse completes. And the \
flat-weight integral ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fa7ad17-3a9c-8e6e-055c-4551bf2ed4b4"],
 " is not the sharpest estimator: the conditional ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c844eb4-1a55-00c1-54bc-67fe9fe0522b"],
 " of the fan above is the Bayesian-optimal filter, which a uniform integral \
only approximates. This trajectory-read-from-its-own-record is what ",
 ButtonBox["Murch, Weber, Macklin, and Siddiqi",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/1305.7270"], None}],
 " tracked on a superconducting qubit, reconstructing the conditioned state \
from the readout and confirming it by tomography."
}], "Text",
 CellID->1609727223,ExpressionUUID->"6cf619f4-16c8-91d6-148d-90bea362e33c"],

Cell["Quantum Kalman Filter: Tracking an Oscillator", "Subsection",
 CellID->550162028,ExpressionUUID->"66b1d308-016b-0c10-0e4e-cb52b01e577a"],

Cell[TextData[{
 StyleBox["The problem.",
  FontWeight->"Bold"],
 " Continuously measure the position of a harmonic oscillator; a Gaussian \
state stays Gaussian and the stochastic master equation collapses to a \
quantum Kalman-Bucy filter. The conditional covariance ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0764fd02-d65e-847f-2d1b-f56fe3e8ef45"],
 " obeys a ",
 StyleBox["deterministic", "TI"],
 " matrix Riccati equation, independent of the record,"
}], "Text",
 CellID->1908615943,ExpressionUUID->"0c98820f-8b6f-75b8-34a7-24692e1a5f82"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox["\[CapitalSigma]", "."], "=", 
    StyleBox["A", "TI"], "\[CapitalSigma]", "+", "\[CapitalSigma]", 
    SuperscriptBox[
     StyleBox["A", "TI"], 
     StyleBox["T", "TI"]], "+", 
    StyleBox["D", "TI"], "-", "\[CapitalSigma]", " ", 
    SuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["T", "TI"]], 
    StyleBox["C", "TI"], " ", "\[CapitalSigma]"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1143006314,ExpressionUUID->"6abb7d62-34cd-b03b-1a59-754cbd790301"],

Cell["\<\
with the free-rotation drift, the position readout, and the measurement \
back-action\
\>", "Text",
 CellID->1196348210,ExpressionUUID->"2d7b53f1-7ae1-3c16-5b19-4abb7e95877c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["A", "TI"], "=", "(", GridBox[{
      {"0", "1"},
      {
       RowBox[{"-", "1"}], "0"}
     }], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["C", "TI"], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"2", 
         SqrtBox[
          StyleBox["k", "TI"]]}], "0"}
      }], ")"}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["D", "TI"], "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {"0", "0"},
        {"0", 
         StyleBox["k", "TI"]}
       }], ")"}], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->742714341,ExpressionUUID->"342ac02e-94b9-9375-5c29-d9881d4dfe5f"],

Cell[TextData[{
 "In the three independent entries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     StyleBox[
      RowBox[{"x", "x"}], "TI"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox[
      RowBox[{"x", "p"}], "TI"]], ",", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox[
      RowBox[{"p", "p"}], "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e47f25d-3ed8-a4c4-267c-f407bb520e2e"],
 " of ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "420d2e93-75d1-66df-7232-c7dd7c644c25"],
 " this reads"
}], "Text",
 CellID->1675247856,ExpressionUUID->"0eb3603b-0e30-9ef6-3641-7a65abcae4dc"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    FractionBox[
     StyleBox["d", "TI"], 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]], "(", GridBox[{
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox[
         RowBox[{"x", "x"}], "TI"]]},
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox[
         RowBox[{"x", "p"}], "TI"]]},
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox[
         RowBox[{"p", "p"}], "TI"]]}
     }], ")", "=", "(", GridBox[{
      {
       RowBox[{"2", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "p"}], "TI"]], "-", "4", 
        StyleBox["k", "TI"], " ", 
        SubsuperscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "x"}], "TI"], "2"]}]},
      {
       RowBox[{
        SubscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"p", "p"}], "TI"]], "-", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "x"}], "TI"]], "-", "4", 
        StyleBox["k", "TI"], " ", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "x"}], "TI"]], 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "p"}], "TI"]]}]},
      {
       RowBox[{
        StyleBox["k", "TI"], "-", "2", 
        SubscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "p"}], "TI"]], "-", "4", 
        StyleBox["k", "TI"], " ", 
        SubsuperscriptBox["\[CapitalSigma]", 
         StyleBox[
          RowBox[{"x", "p"}], "TI"], "2"]}]}
     }], ")"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->288968408,ExpressionUUID->"0da293aa-5e01-ac71-3b51-0af45bb5f75b"],

Cell[TextData[{
 "the quadratic ",
 Cell[BoxData[
  RowBox[{"-", "4", 
   StyleBox["k", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "\[CenterEllipsis]", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32c08ae5-f3ed-cbfa-62ff-23ce859999c0"],
 " terms being the information gain ",
 Cell[BoxData[
  RowBox[{"-", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["T", "TI"]], 
   StyleBox["C", "TI"], "\[CapitalSigma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cfb14f9-38ed-478b-4498-8da3b8982dd1"],
 ", which is what makes this a Riccati and not a linear Lyapunov equation. \
Balanced against the back-action (",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["D", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "683f5ed1-9434-8a9e-19c5-579b1dc6d8e4"],
 "), that gain relaxes the uncertainty to a steady value fixed only by how \
hard you watch, squeezing it below the oscillator's own quietest spread; the \
running best-guess then follows a linear equation driven by the record. Track \
the shrinking uncertainty and check its standstill."
}], "Text",
 CellID->1029027830,ExpressionUUID->"07cd5cb3-9399-0155-2df3-55fd262c53bf"],

Cell[TextData[{
 "Continuously measure the position of a harmonic oscillator and you can \
track it with a Gaussian estimate: a conditional mean and covariance. The \
covariance obeys a ",
 StyleBox["deterministic", "TI"],
 " Riccati equation, independent of the record, set only by the measurement \
strength. It is the warm particle's covariance law from Part Three, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox["\[CapitalSigma]", "."], "=", 
   StyleBox["A", "TI"], "\[CapitalSigma]", "+", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["A", "TI"], 
    StyleBox["T", "TI"]], "+", 
   StyleBox["D", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f9e6b1d-931e-a284-75a5-834726a8f0ee"],
 ", now carrying the measurement's information gain ",
 Cell[BoxData[
  RowBox[{"-", "\[CapitalSigma]", 
   SuperscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["T", "TI"]], 
   StyleBox["C", "TI"], "\[CapitalSigma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7129e602-6ec3-689c-20d6-f86c0b763ae6"],
 ": diffusion widened that blob to thermal, watching squeezes this one below \
the ground state. Set the strength and integrate the Riccati equations from a \
broad start:"
}], "Text",
 CellID->128002051,ExpressionUUID->"24548d70-e349-6090-4c6b-253d96fc32fa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kKal", " ", "=", " ", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"riccati", " ", "=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"vx", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"vc", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{"4", " ", "kKal", " ", 
          RowBox[{
           RowBox[{"vx", "[", "t", "]"}], "^", "2"}]}]}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"vc", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"vp", "[", "t", "]"}], " ", "-", " ", 
         RowBox[{"vx", "[", "t", "]"}], " ", "-", " ", 
         RowBox[{"4", " ", "kKal", " ", 
          RowBox[{"vx", "[", "t", "]"}], " ", 
          RowBox[{"vc", "[", "t", "]"}]}]}]}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"vp", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{"vc", "[", "t", "]"}]}], " ", "+", " ", "kKal", " ", "-", 
         " ", 
         RowBox[{"4", " ", "kKal", " ", 
          RowBox[{
           RowBox[{"vc", "[", "t", "]"}], "^", "2"}]}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"vx", "[", "0", "]"}], " ", "==", " ", "3."}], ",", " ", 
       RowBox[{
        RowBox[{"vc", "[", "0", "]"}], " ", "==", " ", "0."}], ",", " ", 
       RowBox[{
        RowBox[{"vp", "[", "0", "]"}], " ", "==", " ", "3."}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"vx", ",", " ", "vc", ",", " ", "vp"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[182]:= ",
 CellID->1571712410,ExpressionUUID->"24053d10-b77f-7f73-4c3a-b55dc20a4259"],

Cell["A reader for the covariance matrix:", "Text",
 CellID->890139439,ExpressionUUID->"16592835-d9b8-94b1-3e66-c27ed832fe9b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"covariance", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"riccati", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"riccati", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", "t", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"riccati", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"riccati", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}]}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[183]:= ",
 CellID->999332945,ExpressionUUID->"141ca810-4c49-bb60-3c23-425a65fd064a"],

Cell["Compare the position variance at the start and at the end:", "Text",
 CellID->662631669,ExpressionUUID->"68e9730c-176f-ed31-1897-6b56a21bb41b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"riccati", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "0", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"riccati", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "6", "]"}]}], "}"}]], "Input",
 CellLabel->"In[184]:= ",
 CellID->798789937,ExpressionUUID->"045a1c11-48b2-feff-2c79-965b6944c4c5"],

Cell[TextData[{
 "The position variance has shrunk from its broad start below the \
ground-state variance ",
 Cell[BoxData[
  RowBox[{"1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5000470d-6ead-2730-0030-5f570b598a1a"],
 ": continuous measurement conditionally squeezes it below the zero-point \
level. Two checks. First, the conditional state is pure, its uncertainty \
product at the Heisenberg floor:"
}], "Text",
 CellID->647724388,ExpressionUUID->"5b36215d-7c1e-6467-0acd-b90775ab4f4d"],

Cell[BoxData[
 RowBox[{"Det", "@", 
  RowBox[{"covariance", "[", "6.", "]"}]}]], "Input",
 CellLabel->"In[185]:= ",
 CellID->1693391218,ExpressionUUID->"648fe92d-3764-e6d2-0cb4-01774216cc38"],

Cell[TextData[{
 "The uncertainty product is ",
 Cell[BoxData[
  RowBox[{"1", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51ab5adf-11d7-a41b-07a9-5399a0630f61"],
 ": the conditional state is pure. Second, the steady covariance is \
independently the fixed point of the Riccati equation:"
}], "Text",
 CellID->819462336,ExpressionUUID->"6ea1ee02-7e80-589f-165e-006c7b352ae5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"N", "[", 
    RowBox[{"vx", " ", "/.", " ", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"2", " ", "vc"}], " ", "-", " ", 
            RowBox[{"4", " ", "kKal", " ", 
             RowBox[{"vx", "^", "2"}]}]}], " ", "==", " ", "0"}], ",", " ", 
          RowBox[{
           RowBox[{"vp", " ", "-", " ", "vx", " ", "-", " ", 
            RowBox[{"4", " ", "kKal", " ", "vx", " ", "vc"}]}], " ", "==", 
           " ", "0"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"-", "2"}], " ", "vc"}], " ", "+", " ", "kKal", " ", "-",
             " ", 
            RowBox[{"4", " ", "kKal", " ", 
             RowBox[{"vc", "^", "2"}]}]}], " ", "==", " ", "0"}], ",", " ", 
          RowBox[{"vx", " ", ">", " ", "0"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"vx", ",", " ", "vc", ",", " ", "vp"}], "}"}], ",", " ", 
        "Reals"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"riccati", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "6.", "]"}]}], "}"}]], "Input",
 CellLabel->"In[186]:= ",
 CellID->1116629832,ExpressionUUID->"481e4aee-9cf5-9d73-7826-63c81481e459"],

Cell["The fixed point matches the late value.", "Text",
 CellID->871366443,ExpressionUUID->"3565e36d-8dcc-1be9-631a-fb3724796933"],

Cell[TextData[{
 "The conditional state is Gaussian, so picture it as a one-sigma ellipse: \
the covariance ",
 Cell[BoxData["\[CapitalSigma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "235d73f5-0285-a3fd-5163-6abfb731f1c7"],
 " around a center ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a726cbd-ee36-06ea-5a01-85e68bc36c30"],
 " traces ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["c", "TI"], "+", 
    SuperscriptBox["\[CapitalSigma]", 
     RowBox[{"1", "/", "2"}]], "{", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["s", "TI"]}], ",", 
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["s", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "545cfe61-129d-c9b2-7c63-f04ba7299b98"],
 " as ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a738979-6fd1-4d91-5a00-21230a6417fb"],
 " runs the circle. Define it:"
}], "Text",
 CellID->1498962183,ExpressionUUID->"1cda659f-caad-1800-44fa-7cd8ef586b6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"covarianceEllipse", "[", 
    RowBox[{"c_", ",", " ", "\[CapitalSigma]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"c", " ", "+", " ", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{"\[CapitalSigma]", ",", " ", 
          RowBox[{"1", "/", "2"}]}], "]"}], "]"}], " ", ".", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "s", "]"}], ",", " ", 
         RowBox[{"Sin", "[", "s", "]"}]}], "}"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "0", ",", " ", 
       RowBox[{"2", " ", "Pi"}], ",", " ", "0.12"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[187]:= ",
 CellID->914693011,ExpressionUUID->"6bd8f04d-1eeb-cc47-19e7-ea179a9f96ad"],

Cell["\<\
Now visualize the covariance ellipse over time, broad at first and then \
tightening and tilting to a small steady one:\
\>", "Text",
 CellID->2145390693,ExpressionUUID->"4131a38c-3cb1-61e0-70ce-3ad6b54433ca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"trackTimes", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0", ",", " ", "0.1", ",", " ", "0.25", ",", " ", "0.5", ",", " ", "1", ",",
      " ", "2", ",", " ", "4"}], "}"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Thick", ",", " ", 
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"ColorData", "[", "\"\<SunsetColors\>\"", "]"}], "[", 
             RowBox[{
              RowBox[{"First", "[", "#2", "]"}], "/", 
              RowBox[{"Length", "[", "trackTimes", "]"}]}], "]"}], ",", " ", 
            RowBox[{"Line", "@", 
             RowBox[{"covarianceEllipse", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
               RowBox[{"covariance", "[", "#1", "]"}]}], "]"}]}]}], "}"}], 
          " ", "&"}], ",", " ", "trackTimes"}], "]"}]}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "400"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<position\>\"", ",", " ", "\"\<momentum\>\""}], "}"}]}], ",",
      "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<measurement shrinks the covariance to a tight, tilted, steady \
one\>\""}]}], "]"}], ",", "\n", " ", 
   RowBox[{"SwatchLegend", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ColorData", "[", "\"\<SunsetColors\>\"", "]"}], "[", 
        RowBox[{"#", "/", 
         RowBox[{"Length", "[", "trackTimes", "]"}]}], "]"}], " ", "&"}], " ",
       "/@", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "trackTimes", "]"}], "]"}]}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<t = \>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
      "trackTimes"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[188]:= ",
 CellID->272231904,ExpressionUUID->"66dd1d78-a26e-793a-0ee2-9525d71b4800"],

Cell["\<\
This conditional estimate is exactly what a lab computes in real time to \
track a trapped particle or membrane, more precisely than its own zero-point \
spread.\
\>", "Text",
 CellID->183385376,ExpressionUUID->"497210fc-93c1-a1bc-7f01-89a62675f386"],

Cell[TextData[{
 "The covariance is only half the filter. It says how sharp the estimate is; \
the other half is the estimate itself, the conditional ",
 StyleBox["mean", "TI"],
 ", threading through the noisy record in real time. Watch the filter track. \
Set a fine grid and draw one record's worth of Wiener increments:"
}], "Text",
 CellID->1323839713,ExpressionUUID->"2d97aad1-2ffc-78e2-5bac-439b49894ac8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kalDt", " ", "=", " ", "0.004"}], ";", " ", 
  RowBox[{"kalN", " ", "=", " ", "1500"}], ";", " ", 
  RowBox[{"kalGrid", " ", "=", " ", 
   RowBox[{"kalDt", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "kalN"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kalDW", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"Sqrt", "[", "kalDt", "]"}]}], "]"}], ",", " ", "kalN"}], 
      "]"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[189]:= ",
 CellID->1299720858,ExpressionUUID->"45812a49-00f9-159c-73be-cc13b08c7fe6"],

Cell[TextData[{
 "A note on the constant ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e72335e-d71b-483f-5601-ab1be2ae1b05"],
 ". In the catalog's measurement-strength convention the monitored leak is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["k", "TI"]], " ", 
   OverscriptBox[
    StyleBox["x", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00379a47-1bf1-fdbf-31cc-1c219d85c785"],
 ", so the informative terms carry ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19c466c6-94fb-625d-4ffc-7fa01c8e30a7"],
 " and the mean gain is ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    StyleBox["k", "TI"]], " ", 
   StyleBox["V", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20cc8908-a147-10ca-50f3-2155d0f26210"],
 "; the record noise and the gain must then be consistent, which pins the \
record normalization below. What the code calls a \"reference conditional \
mean\" is the physical conditional mean of one simulated record, driven by \
its own innovation ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13bcd130-62a3-8c70-4143-c97a1757d75a"],
 " with that gain. Roll it out from a displaced start:"
}], "Text",
 CellID->513341225,ExpressionUUID->"6565394a-c196-6bdd-131a-b117f0233927"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kalTrue", " ", "=", " ", 
   RowBox[{"FoldList", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xp", ",", " ", "jw"}], "}"}], ",", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"j", " ", "=", " ", 
            RowBox[{"jw", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
           RowBox[{"dw", " ", "=", " ", 
            RowBox[{"jw", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"xp", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"xp", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", "kalDt"}], " ", "+", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
             RowBox[{
              RowBox[{"riccati", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"kalGrid", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "dw"}]}], ",", 
           "\n", "      ", 
           RowBox[{
            RowBox[{"xp", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"xp", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "kalDt"}], " ", "+", " ", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "kKal", "]"}], " ", 
             RowBox[{
              RowBox[{"riccati", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "[", 
              RowBox[{"kalGrid", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "dw"}]}]}], 
          "}"}]}], "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"3.", ",", " ", "0."}], "}"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", "kalN", "]"}], ",", " ", "kalDW"}], "}"}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[190]:= ",
 CellID->2063978445,ExpressionUUID->"654f987a-f98e-d016-1374-1227f838a37c"],

Cell[TextData[{
 "All the observer ever sees is the record, the signal ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "631c7298-8e73-d34d-1124-6bc22b07a197"],
 " buried in white noise. Consistency with the ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e9b4f74-ee28-5e2b-56b9-67318bdd2571"],
 "-Riccati and the ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ff84a3f-8ea3-8415-2598-6c792b57ef7f"],
 " gain fixes its noise level at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["y", "TI"], "=", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SqrtBox[
     StyleBox["k", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d7fc3a7-f4ac-747e-7b04-da00fd595f44"],
 ":"
}], "Text",
 CellID->124947567,ExpressionUUID->"6b0a0ef4-2602-73b0-1909-a7be53b7419a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kalRec", " ", "=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#1", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "kalDt"}], " ", "+", " ", 
       RowBox[{"#2", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"Sqrt", "[", "kKal", "]"}]}], ")"}]}]}], " ", "&"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Most", "@", "kalTrue"}], ",", " ", "kalDW"}], "}"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[191]:= ",
 CellID->307500845,ExpressionUUID->"7324c1ff-ae1d-8266-22db-d8b8cba9d14c"],

Cell[TextData[{
 "Now the filter. Start it from a deliberately ",
 StyleBox["wrong", "TI"],
 " guess for the position and feed it only the record: at each step it forms \
its own innovation, the record minus its own prediction, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   OverscriptBox[
    StyleBox["W", "TI"], "^"], "=", "2", 
   SqrtBox[
    StyleBox["k", "TI"]], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["y", "TI"], "-", 
    OverscriptBox[
     StyleBox["x", "TI"], "_"], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a19e89c-6899-3c78-3a26-01c6092d8742"],
 ", and corrects the estimate with the Riccati gain,"
}], "Text",
 CellID->971031069,ExpressionUUID->"39663cc9-297d-9b4a-6f1d-b5934809e990"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    OverscriptBox[
     StyleBox["x", "TI"], "_"], "=", 
    OverscriptBox[
     StyleBox["p", "TI"], "_"], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "2", 
    SqrtBox[
     StyleBox["k", "TI"]], " ", 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox[
      RowBox[{"x", "x"}], "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], " ", 
    StyleBox["d", "TI"], 
    OverscriptBox[
     StyleBox["W", "TI"], "^"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     OverscriptBox[
      StyleBox["p", "TI"], "_"]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       OverscriptBox[
        StyleBox["x", "TI"], "_"]}], " ", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{"2", 
      SqrtBox[
       StyleBox["k", "TI"]], " ", 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox[
        RowBox[{"x", "p"}], "TI"]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}], " ", 
      StyleBox["d", "TI"], 
      OverscriptBox[
       StyleBox["W", "TI"], "^"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->959838422,ExpressionUUID->"7331868a-f3de-6799-22ce-1fd7866b4de3"],

Cell[TextData[{
 "the deterministic Riccati covariance ",
 Cell[BoxData[
  RowBox[{"\[CapitalSigma]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
