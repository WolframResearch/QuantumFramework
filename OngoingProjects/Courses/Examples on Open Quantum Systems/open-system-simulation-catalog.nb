     RowBox[{
      StyleBox["d", "TI"], 
      RowBox[{
       StyleBox["W", "TI"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1009200201,ExpressionUUID->"0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],

Cell[TextData[{
 StyleBox["Markovian measurement feedback.",
  FontWeight->"Bold"],
