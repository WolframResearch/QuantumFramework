          RowBox[{
           RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], "}"}],
          ",", " ", 
         RowBox[{"densityMatrix", "[", "cat", "]"}], ",", " ", "t"}], "]"}], ",",
        " ", "4.2", ",", " ", "55"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "catTimes"}], "}"}]}], "]"}]}], ";"}]}], "Input",\

 CellLabel->"In[84]:=",
 CellID->962064851,ExpressionUUID->"19ac3a5e-0cd6-873c-4f53-bc18a560ea06"],

Cell["Draw it on one shared color scale:", "Text",
 CellID->1660212291,ExpressionUUID->"6e8690e9-968f-68b3-16bd-09b3233a3a99"],

