Cell[TextData[{
 "    The simulated ideal loop has ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52535901-cb26-8b9c-0261-516aeed0d9e6"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["F", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["G", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "323a4b1c-b138-a791-63da-6359c0b20dfb"],
 ", and therefore ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", 
   StyleBox["G", "TI"], "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["y", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7421cf44-a1ac-4319-1dde-e721d0592e63"],
 "."
}], "Text",
 CellID->1234416869,ExpressionUUID->"511b3347-8d7d-ab60-0738-ab212409f64a"],

