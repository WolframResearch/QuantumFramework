       SuperscriptBox[GridBox[{
          {
           StyleBox["\[Alpha]", "TI"]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1540797058,ExpressionUUID->"27c3fefb-2ee6-8038-4df0-f7a54a90d302"],

Cell[TextData[{
 "For the ",
 Cell[BoxData["\[ScriptL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60d4995f-bb7f-b80c-10eb-11193e0b0b56"],
 "th superdiagonal of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64608bbe-760c-8af3-0c1f-22f803bed8d9"],
 ", define the radial Laguerre sum"
}], "Text",
 CellID->768596373,ExpressionUUID->"09661063-a2cf-675e-3f1d-8a4cd77a4da4"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["F", "TI"], "\[ScriptL]"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["b", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["m", "TI"], "=", "0"}], 
      RowBox[{
       StyleBox["n", "TI"], "-", "\[ScriptL]", "-", "1"}],
      LimitsPositioning->False], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], 
       RowBox[{
        StyleBox["m", "TI"], ",", 
        RowBox[{
         StyleBox["m", "TI"], "+", "\[ScriptL]"}]}]], 
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"-", "1"}], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       StyleBox["m", "TI"]], 
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{
          StyleBox["m", "TI"], "!"}], "\[ThinSpace]", 
         RowBox[{"\[ScriptL]", "!"}]}], 
        RowBox[{
         RowBox[{
          StyleBox["(",
           SpanMaxSize->1], 
          RowBox[{
           StyleBox["m", "TI"], "+", "\[ScriptL]"}], 
          StyleBox[")",
           SpanMaxSize->1]}], "!"}]]], "\[ThinSpace]", 
      SubsuperscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["m", "TI"], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], "\[ScriptL]", 
        StyleBox[")",
         SpanMaxSize->1]}]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["b", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1985169054,ExpressionUUID->"5561d787-26b0-8d0a-031e-cee1534ad450"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["L", "TI"], 
   StyleBox["m", "TI"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], "\[ScriptL]", 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fea91e8-e80e-a1ed-35e9-08b589b8f337"],
 " is a generalized Laguerre polynomial. The complete Wigner function is \
then"
}], "Text",
 CellID->770675313,ExpressionUUID->"37725419-c8bf-c4cd-5d02-4e42e94bae17"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["W", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox["1", "\[Pi]"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["b", "TI"], "/", "2"}]], "\[ThinSpace]", 
    StyleBox["Re",
     FontSlant->"Plain"], "[", 
