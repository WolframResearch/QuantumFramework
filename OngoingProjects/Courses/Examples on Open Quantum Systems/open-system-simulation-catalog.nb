Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", 
    StyleBox["\[Gamma]", "TI"], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["\[Rho]", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "0", 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{
        TemplateBox[{
          StyleBox["\[Alpha]", "TI"]},
         "Ket"], 
        TemplateBox[{
          StyleBox["\[Alpha]", "TI"]},
         "Bra"]}], "+", 
       RowBox[{
        TemplateBox[{
          StyleBox["\[Alpha]", "TI"]},
         "Ket"], 
        TemplateBox[{
          RowBox[{"-", 
            StyleBox["\[Alpha]", "TI"]}]},
         "Bra"]}], "+", 
       RowBox[{
        TemplateBox[{
          RowBox[{"-", 
            StyleBox["\[Alpha]", "TI"]}]},
         "Ket"], 
        TemplateBox[{
          StyleBox["\[Alpha]", "TI"]},
         "Bra"]}], "+", 
       RowBox[{
        TemplateBox[{
          RowBox[{"-", 
            StyleBox["\[Alpha]", "TI"]}]},
         "Ket"], 
        TemplateBox[{
          RowBox[{"-", 
            StyleBox["\[Alpha]", "TI"]}]},
         "Bra"]}]}], 
      RowBox[{"2", 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "+", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"-", "2", 
          SuperscriptBox[GridBox[{
             {
              StyleBox["\[Alpha]", "TI"]}
            },
            GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
            GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]]}], 
       StyleBox[")",
        SpanMaxSize->1]}]], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1384978530,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

