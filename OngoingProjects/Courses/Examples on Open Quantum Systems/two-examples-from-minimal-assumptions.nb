Cell["\<\
The driven fixed axis falls between the two: the rotation keeps pulling the \
state off the measured axis, undoing part of the alignment trap, though far \
from all of it. Now the steered protocol with the same drive, its ensemble \
mean at a fixed time beside the undriven ensemble at the same step and the \
continuum law:\
\>", "Text",
 CellID->359589406,ExpressionUUID->"4f6d713e-2461-11c8-7513-69784d146312"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"finDriven", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Last", "[", 
         RowBox[{"impurity", " ", "/@", " ", 
          RowBox[{"steered", "[", 
           RowBox[{
            RowBox[{"id2", "/", "2"}], ",", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1.5", "/", "2"}], ")"}], " ", "X"}], ",", " ", "kPur", 
            ",", " ", "1.", ",", " ", "hPur", ",", " ", "0.6", ",", " ", 
            "s"}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "60"}], "}"}]}], "]"}]}], ",", "\n", "  ", 
     RowBox[{"finFree", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Last", "[", 
         RowBox[{"impurity", " ", "/@", " ", 
          RowBox[{"steered", "[", 
           RowBox[{
            RowBox[{"id2", "/", "2"}], ",", " ", 
            RowBox[{"0", " ", "id2"}], ",", " ", "kPur", ",", " ", "1.", ",", 
            " ", "hPur", ",", " ", "0.6", ",", " ", "s"}], "]"}]}], "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "60"}], "}"}]}], "]"}]}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Mean", "[", "finDriven", "]"}], ",", " ", 
     RowBox[{"Mean", "[", "finFree", "]"}], ",", " ", 
     RowBox[{"0.5", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "4"}], " ", "kPur", " ", "0.6"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[50]:= ",
 CellID->458004688,ExpressionUUID->"14ad582f-66ff-93eb-3c53-5189128be131"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.053346111800105754`", ",", "0.05332764753810482`", ",", 
   "0.045358976644706256`"}], "}"}]], "Output",
 CellLabel->"Out[50]= ",
 CellID->1564605132,ExpressionUUID->"4f7ea056-2d28-85ec-7505-3a1044c2ef36"]
}, Open  ]],

Cell[TextData[{
 "The driven and undriven means coincide, and both carry the same small \
finite-step offset from the law, the offset the refinement table already \
charged to the step: the drive contributed nothing, so the steered claim \
never needed B1. ",
 StyleBox["B1 is demoted, with a scope split:",
  FontWeight->"Bold"],
 " for the steered headline it was no assumption at all, while for the \
fixed-axis baseline it was load-bearing, since its characteristic slowness \
was the alignment trap that a drive partly unmakes. The strong-drive, \
strong-measurement competition in its own right is the catalog's quantum Zeno \
section; this cell is the link to it."
}], "Text",
 CellID->739917449,ExpressionUUID->"16b00368-b832-202d-3e4f-9b3239c77377"],

Cell[TextData[{
 StyleBox["A detector that misses (B2 off).",
  FontWeight->"Bold"],
 " Let the detector keep a fraction ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06d00634-a672-f252-2eef-9871d304c0b8"],
 " of the record. The steered protocol holds the state perpendicular to the \
measured axis, which is exactly where the ",
 StyleBox["unrecorded", "TI"],
 " fraction of the measurement, acting as dephasing about that axis, bites \
hardest; at the held angle the deterministic part of the increment becomes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "\[ScriptL]", "=", "2", 
   StyleBox["k", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", "2", "\[ScriptL]"}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "-", "2", 
   StyleBox["\[Eta]", "TI"], 
   StyleBox["k", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],
 ", back-action heating against recorded information, which balances at the \
floor"
}], "Text",
 CellID->473762610,ExpressionUUID->"583a98af-415b-100e-09d9-110970ee6354"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptL]", "\[Star]"], "=", 
    FractionBox[
     RowBox[{"1", "-", 
      StyleBox["\[Eta]", "TI"]}], "2"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1751712322,ExpressionUUID->"07beae85-a317-6bf9-2d45-47eed6a239c3"],

Cell[TextData[{
 "and at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],
 " collapses back to the pure-state law. The fixed axis has no such floor: \
its destinations are the measured observable's eigenstates, which the \
unrecorded dephasing cannot touch, so every run still ends pure, only later. \
Run both at the same imperfect efficiency:"
}], "Text",
 CellID->1390140890,ExpressionUUID->"60049622-f570-0e0e-103b-0f8ffc055554"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"etaPur", " ", "=", " ", "0.7"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"steeredEta", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"impurity", " ", "/@", " ", 
      RowBox[{"steered", "[", 
       RowBox[{
        RowBox[{"id2", "/", "2"}], ",", " ", 
        RowBox[{"0", " ", "id2"}], ",", " ", "kPur", ",", " ", "etaPur", ",", 
        " ", "hPur", ",", " ", "4.", ",", " ", "s"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "80"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"unsteeredEta", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"impurity", " ", "/@", " ", 
      RowBox[{
       RowBox[{"trajectory", "[", 
        RowBox[{
         RowBox[{"id2", "/", "2"}], ",", " ", 
         RowBox[{"0", " ", "id2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "kPur", "]"}], " ", "Z"}], "}"}], ",", " ", 
         RowBox[{"{", "etaPur", "}"}], ",", " ", 
         RowBox[{"{", "}"}], ",", " ", "hPur", ",", " ", "4.", ",", " ", 
         "s"}], "]"}], "[", "\"\<states\>\"", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "80"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"grid", " ", "=", " ", 
     RowBox[{"hPur", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", "400"}], "]"}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{"ListLogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"grid", ",", " ", 
          RowBox[{"Mean", "[", "steeredEta", "]"}]}], "}"}], "]"}], ",", " ", 
       
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"grid", ",", " ", 
          RowBox[{"Mean", "[", "unsteeredEta", "]"}]}], "}"}], "]"}], ",", 
       "\n", "   ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"grid", ",", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", " ", "-", " ", "etaPur"}], ")"}], "/", "2"}], ",", 
            " ", 
            RowBox[{"Length", "[", "grid", "]"}]}], "]"}]}], "}"}], "]"}]}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}]}], ",", "\n", 
     "  ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<steered\>\"", ",", " ", "\"\<fixed axis\>\"", ",", 
        " ", "\"\<predicted steered floor\>\""}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", " ", "\"\<mean impurity (log)\>\""}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<with a leaky detector the fixed axis passes below the steered \
floor\>\""}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[51]:= ",
 CellID->1516866442,ExpressionUUID->"40ea559d-da93-7842-70ea-4cc6df264aa8"],

