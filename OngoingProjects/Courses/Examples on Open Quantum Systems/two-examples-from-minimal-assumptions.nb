}, Open  ]],

Cell["\<\
Both columns shrink with the step: the determinism is a property of the \
continuous limit, and the finite-step residue converges to it. B4 is \
exercised and behaves.\
\>", "Text",
 CellID->675379980,ExpressionUUID->"3b9a140e-d97a-4136-69b9-8e6bd80f101c"],

Cell[TextData[{
 StyleBox["Q3.",
  FontWeight->"Bold"],
 " Now the word \"faster,\" split into its two scores on the same two \
ensembles, a fixed-axis one and a steered one, over a window long enough for \
every run to reach the target:"
}], "Text",
 CellID->1331866192,ExpressionUUID->"4f9438da-b80f-a114-75ab-b18439bbf07e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"unsteeredEns", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"impurity", " ", "/@", " ", 
      RowBox[{
       RowBox[{"trajectory", "[", 
        RowBox[{
         RowBox[{"id2", "/", "2"}], ",", " ", 
         RowBox[{"0", " ", "id2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "kPur", "]"}], " ", "Z"}], "}"}], ",", " ", 
         RowBox[{"{", "1.", "}"}], ",", " ", 
         RowBox[{"{", "}"}], ",", " ", "hPur", ",", " ", "4.", ",", " ", 
         "s"}], "]"}], "[", "\"\<states\>\"", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "150"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"steeredEns", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"impurity", " ", "/@", " ", 
      RowBox[{"steered", "[", 
       RowBox[{
        RowBox[{"id2", "/", "2"}], ",", " ", 
        RowBox[{"0", " ", "id2"}], ",", " ", "kPur", ",", " ", "1.", ",", " ",
         "hPur", ",", " ", "4.", ",", " ", "s"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "150"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[45]:= ",
 CellID->1391655620,ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell["\<\
For the passage score, record each run's first time below a target impurity, \
leaving a run that never crosses explicitly marked rather than silently \
scored at the window's end, and count the marks before averaging anything:\
\>", "Text",
 CellID->861714746,ExpressionUUID->"3c8746fc-db76-c487-64bd-5fb9de00aeed"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"firstPassage", "[", "run_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pos", " ", "=", " ", 
       RowBox[{"FirstPosition", "[", 
        RowBox[{"run", ",", " ", 
         RowBox[{"l_", " ", "/;", " ", 
          RowBox[{"l", " ", "<", " ", "0.05"}]}]}], "]"}]}], "}"}], ",", "\n",
      "   ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MissingQ", "[", "pos", "]"}], ",", " ", 
       RowBox[{"Missing", "[", "\"\<RightCensored\>\"", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"First", "[", "pos", "]"}], " ", "-", " ", "1"}], ")"}], " ",
         "hPur"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fptU", ",", " ", "fptS"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"firstPassage", " ", "/@", " ", "unsteeredEns"}], ",", " ", 
     RowBox[{"firstPassage", " ", "/@", " ", "steeredEns"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Count", "[", 
    RowBox[{"fptU", ",", " ", "_Missing"}], "]"}], ",", " ", 
   RowBox[{"Count", "[", 
    RowBox[{"fptS", ",", " ", "_Missing"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[46]:= ",
 CellID->1052884318,ExpressionUUID->"11f0f87a-e6f0-91cd-478f-f227928ae317"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0"}], "}"}]], "Output",
 CellLabel->"Out[46]= ",
 CellID->146092893,ExpressionUUID->"473164ce-b547-c1f4-6ecf-7da83cf393de"]
}, Open  ]],

Cell["\<\
The pair of counts, fixed-axis then steered, comes back zero: every run \
crossed, so the plain means below are unbiased. Compare the two scores head \
to head:\
\>", "Text",
 CellID->556077107,ExpressionUUID->"12c4fc3b-e00c-2bba-42fb-f66491b97980"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<\>\"", ",", " ", "\"\<fixed axis\>\"", ",", 
       " ", "\"\<steered\>\""}], "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<mean impurity at t = 0.6\>\"", ",", " ", 
       RowBox[{"Mean", "[", 
        RowBox[{"unsteeredEns", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "61"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"Mean", "[", 
        RowBox[{"steeredEns", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "61"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<mean first-passage time to impurity 0.05\>\"", ",", " ", 
       RowBox[{"Mean", "[", "fptU", "]"}], ",", " ", 
       RowBox[{"Mean", "[", "fptS", "]"}]}], "}"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 CellLabel->"In[47]:= ",
 CellID->1590294859,ExpressionUUID->"1d7e6892-18cd-6f45-4b05-81dc997835af"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"\"\>", "\<\"fixed axis\"\>", "\<\"steered\"\>"},
    {"\<\"mean impurity at t = 0.6\"\>", "0.08694882106503934`", 
     "0.05301618820148096`"},
    {"\<\"mean first-passage time to impurity 0.05\"\>", 
     "0.47646666666666676`", "0.6046`"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellLabel->"Out[47]= ",
 CellID->225985609,ExpressionUUID->"325c8f47-cd85-89da-6263-2720e431db20"]
}, Open  ]],

Cell["\<\
The two rows disagree about the winner: steering gives the lower impurity at \
the deadline, and the fixed axis gives the shorter mean time to the target. \
The distributions say why:\
\>", "Text",
 CellID->308842859,ExpressionUUID->"43fcea2e-12ab-c026-7183-0388a75f930c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Histogram", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fptU", ",", " ", "fptS"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "2.", ",", " ", "0.1"}], "}"}], ",", 
   " ", "\"\<PDF\>\"", ",", "\n", " ", 
   RowBox[{"ChartLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<fixed axis\>\"", ",", " ", "\"\<steered\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "3"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<first-passage time to impurity 0.05\>\"", ",", 
      " ", "\"\<density\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<lucky fixed-axis runs cross early; steered runs cross \
together\>\""}]}], "]"}]], "Input",
