Cell["\<\
Confirm the floor quantitatively, late steered mean against the prediction:\
\>", "Text",
 CellID->1410588720,ExpressionUUID->"114d8d02-b276-9c05-4772-256fc700e76f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Mean", "[", 
    RowBox[{"Last", " ", "/@", " ", "steeredEta"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", "etaPur"}], ")"}], "/", "2"}]}], 
  "}"}]], "Input",
 CellLabel->"In[52]:= ",
 CellID->1228527068,ExpressionUUID->"2dc22b63-32d1-862f-5bf1-c34d4765ed75"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.15257273820707415`", ",", "0.15000000000000002`"}], 
  "}"}]], "Output",
 CellLabel->"Out[52]= ",
 CellID->323509965,ExpressionUUID->"36ea7e2c-072a-2221-5eea-7076b2df710b"]
}, Open  ]],

Cell[TextData[{
 "The pair agrees. ",
 StyleBox["B2 is load-bearing, and turning it off reverses the verdict at \
long times:",
  FontWeight->"Bold"],
 " the steered protocol, unbeatable at early deadlines, saturates at a floor \
set by the missing record, while the fixed axis crosses below that floor and \
keeps going, because it drives the state to destinations immune to the noise \
the lost record leaves behind. A protocol optimized for the ideal assumption \
pays rent on it forever."
}], "Text",
 CellID->1989924844,ExpressionUUID->"5b23761c-2477-64e8-0ad1-68464d024e32"],

Cell[TextData[{
 StyleBox["A second channel, unwatched (B3 off).",
  FontWeight->"Bold"],
 " The channel to open matters, and choosing it is itself an exercise in \
reading attractors: an unwatched ",
 StyleBox["decay", "TI"],
 " would not do, because its own destination is the pure ground state, so \
every run would still end pure, only later and for a different reason. To cap \
purity the unwatched door must lead somewhere mixed. Open the warm pair from \
part one's A2, downward at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["n", "TI"], "_"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73216bcf-7cf1-61ac-22de-82a9748433f6"],
 " and upward at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   OverscriptBox[
    StyleBox["n", "TI"], "_"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],
 ", here with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "0.4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "409bca18-cbd6-e54d-70b8-ec45ee60cf97"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "_"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b62b5f-1d3f-f012-404d-c31994cbc378"],
 ", beside the watched axis:"
}], "Text",
 CellID->695529426,ExpressionUUID->"79984792-c453-565a-2fb8-5edfede63ca0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"grid", " ", "=", " ", 
      RowBox[{"hPur", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "400"}], "]"}]}]}], ",", "\n", "  ", 
     RowBox[{"lossy", " ", "=", " ", 
      RowBox[{"Mean", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"impurity", " ", "/@", " ", 
          RowBox[{
           RowBox[{"trajectory", "[", 
            RowBox[{
             RowBox[{"id2", "/", "2"}], ",", " ", 
             RowBox[{"0", " ", "id2"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Sqrt", "[", "kPur", "]"}], " ", "Z"}], "}"}], ",", 
             " ", 
             RowBox[{"{", "1.", "}"}], ",", "\n", "       ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"Sqrt", "[", "0.8", "]"}], " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"X", " ", "-", " ", 
                   RowBox[{"I", " ", "Y"}]}], ")"}], "/", "2"}]}], ",", " ", 
               RowBox[{
                RowBox[{"Sqrt", "[", "0.4", "]"}], " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"X", " ", "+", " ", 
                   RowBox[{"I", " ", "Y"}]}], ")"}], "/", "2"}]}]}], "}"}], ",",
              " ", "hPur", ",", " ", "4.", ",", " ", "s"}], "]"}], 
           "[", "\"\<states\>\"", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"s", ",", " ", "80"}], "}"}]}], "]"}], "]"}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"ListLogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"grid", ",", " ", 
          RowBox[{"Mean", "[", "unsteeredEns", "]"}]}], "}"}], "]"}], ",", 
       " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"grid", ",", " ", "lossy"}], "}"}], "]"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<only the watched channel\>\"", ",", 
        " ", "\"\<plus an unwatched warm pair\>\""}], "}"}]}], ",", "\n", 
     "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", " ", "\"\<mean impurity (log)\>\""}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<an unwatched warm bath puts a stop to purification\>\""}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[53]:= ",
 CellID->1007795863,ExpressionUUID->"1d45428e-8fa1-6801-4b7b-5be82a543b6b"],

