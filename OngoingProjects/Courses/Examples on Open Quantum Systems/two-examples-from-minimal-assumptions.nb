Cell[TextData[{
 "Every run falls toward zero: watching purifies in the pathwise sense. In \
the mean sense the ",
 StyleBox["unconditioned", "TI"],
 " qubit does not purify at all, since averaging the conditioned states over \
records returns the maximally mixed steady state; purification is a property \
of runs, not of the average, the first place the meanings of \"purifies\" \
separate. This uses B2 and B3; the rate it happens at is the next question."
}], "Text",
 CellID->25123057,ExpressionUUID->"167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],

Cell[TextData[{
 StyleBox["Q2.",
  FontWeight->"Bold"],
 " Write the impurity's increment under monitoring of an axis at angle ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Theta]", "TI"], 
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15eb24b6-b946-3a65-43e8-bdf038f0894f"],
 " to the Bloch vector,"
}], "Text",
 CellID->371825621,ExpressionUUID->"27d2a24c-1e84-19ee-4de1-44169b316b34"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox["\[ScriptL]", 
     StyleBox["t", "TI"]], "=", "-", "4", 
    StyleBox["k", "TI"], "\[ThinSpace]", 
    SubscriptBox["\[ScriptL]", 
     StyleBox["t", "TI"]], "(", 
    RowBox[{
     SuperscriptBox[
      StyleBox["sin",
       FontSlant->"Plain"], "2"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["\[Theta]", "TI"], 
      StyleBox["t", "TI"]], "+", "2", 
     SubscriptBox["\[ScriptL]", 
      StyleBox["t", "TI"]], 
     SuperscriptBox[
      StyleBox["cos",
       FontSlant->"Plain"], "2"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["\[Theta]", "TI"], 
      StyleBox["t", "TI"]]}], ")", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "-", "4", 
    SqrtBox[
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    SubscriptBox["\[ScriptL]", 
     StyleBox["t", "TI"]], 
    SqrtBox[
     RowBox[{"1", "-", "2", 
      SubscriptBox["\[ScriptL]", 
       StyleBox["t", "TI"]]}]], "\[ThinSpace]", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["\[Theta]", "TI"], 
     StyleBox["t", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["t", "TI"]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1439628390,ExpressionUUID->"285985c7-a1c8-13eb-5866-1ca0d07d6131"],

Cell[TextData[{
 "The noise rides on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox["t", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57868ed1-450c-c474-7dbd-279b6cbeaf5e"],
 ". A fixed axis lets the sharpening state drift into alignment, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox["t", "TI"]], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c5e608e-35dc-f74f-3466-79e8bc6edd95"],
 ", where the drift is weakest and the noise largest; holding ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox["t", "TI"]], "=", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a1e4090-3303-05ed-4a26-59da46b66f37"],
 " kills the noise term outright and leaves the deterministic law ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptL]", 
    StyleBox["t", "TI"]], "=", 
   SubscriptBox["\[ScriptL]", "0"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "4", 
     StyleBox["k", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10256af3-3972-af7a-41da-83bdb804f240"],
 " on ",
 StyleBox["every", "TI"],
 " record. Holding the angle takes re-aiming, and the re-aiming is the \
steering: read the state, measure perpendicular to it, repeat. The step is \
the same measurement update; only the axis moves, and an efficiency argument \
is carried for later:"
}], "Text",
 CellID->497245720,ExpressionUUID->"457602f1-d86e-ac86-730d-9bbad918f6ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"steered", "[", 
    RowBox[{
    "rho0_", ",", " ", "H_", ",", " ", "k_", ",", " ", "eta_", ",", " ", "h_",
      ",", " ", "tf_", ",", " ", "seed_"}], "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", " ", "=", " ", 
          RowBox[{"Round", "[", 
           RowBox[{"tf", "/", "h"}], "]"}]}], ",", " ", "perp"}], "}"}], ",", 
       "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"perp", "[", "a_", "]"}], " ", ":=", " ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"c", " ", "=", " ", 
             RowBox[{"Cross", "[", 
              RowBox[{"a", ",", " ", 
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "0", ",", " ", "1."}], "}"}]}], 
              "]"}]}], "}"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Norm", "[", "c", "]"}], " ", "<", " ", "1.*^-6"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"1.", ",", " ", "0.", ",", " ", "0."}], "}"}], ",", " ", 
             RowBox[{"Normalize", "[", "c", "]"}]}], "]"}]}], "]"}]}], ";", 
        "\n", "    ", 
        RowBox[{"FoldList", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rho", ",", " ", "dw"}], "}"}], ",", "\n", "      ", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"leak", " ", "=", " ", 
                RowBox[{
                 RowBox[{"Sqrt", "[", "k", "]"}], " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"perp", "[", 
                    RowBox[{"blochVector", "[", "rho", "]"}], "]"}], " ", ".",
                    " ", 
                   RowBox[{"{", 
                    RowBox[{"X", ",", " ", "Y", ",", " ", "Z"}], "}"}]}], 
                  ")"}]}]}], "}"}], ",", "\n", "       ", 
              RowBox[{
               RowBox[{"measurementStep", "[", 
                RowBox[{"H", ",", " ", 
                 RowBox[{"{", "leak", "}"}], ",", " ", 
                 RowBox[{"{", "eta", "}"}], ",", " ", 
                 RowBox[{"{", "}"}], ",", " ", "h"}], "]"}], "[", 
               RowBox[{"rho", ",", " ", 
                RowBox[{"measurementRecord", "[", 
                 RowBox[{"rho", ",", " ", 
                  RowBox[{"{", "leak", "}"}], ",", " ", 
                  RowBox[{"{", "eta", "}"}], ",", " ", "h", ",", " ", 
                  RowBox[{"{", "dw", "}"}]}], "]"}]}], "]"}]}], "]"}]}], 
           "]"}], ",", "\n", "     ", "rho0", ",", " ", 
          RowBox[{"RandomVariate", "[", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"Sqrt", "[", "h", "]"}]}], "]"}], ",", " ", "n"}], 
           "]"}]}], "]"}]}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[42]:= ",
 CellID->1090726268,ExpressionUUID->"499f95c1-a958-6c18-7fa4-0caac8ed3762"],

Cell["\<\
Overlay thirty steered runs on the closed law, on a log scale where the law \
is a straight line:\
\>", "Text",
 CellID->2124519200,ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"runs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"impurity", " ", "/@", " ", 
         RowBox[{"steered", "[", 
          RowBox[{
           RowBox[{"id2", "/", "2"}], ",", " ", 
           RowBox[{"0", " ", "id2"}], ",", " ", "kPur", ",", " ", "1.", ",", 
           " ", "hPur", ",", " ", "1.2", ",", " ", "s"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "30"}], "}"}]}], "]"}]}], ",", "\n", "  ", 
     RowBox[{"grid", " ", "=", " ", 
      RowBox[{"hPur", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "120"}], "]"}]}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{"ListLogPlot", "[", 
    RowBox[{
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"grid", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], " ", "/@",
         " ", "runs"}], ",", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"grid", ",", " ", 
          RowBox[{"0.5", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "4"}], " ", "kPur", " ", "grid"}], "]"}]}]}], "}"}],
         "]"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", "  ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
            RowBox[{"Opacity", "[", "0.25", "]"}]}], "]"}], ",", " ", "30"}], 
         "]"}], ",", "\n", "    ", 
        RowBox[{"Directive", "[", 
         RowBox[{"Thick", ",", " ", 
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", "Dashed"}], 
         "]"}]}], "]"}]}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", " ", "\"\<impurity (log)\>\""}], "}"}]}], 
     ",", "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<steered runs cluster on the deterministic law\>\""}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[43]:= ",
 CellID->1426488749,ExpressionUUID->"0c02104f-9807-e6c4-3431-8a2919b3cc2e"],

