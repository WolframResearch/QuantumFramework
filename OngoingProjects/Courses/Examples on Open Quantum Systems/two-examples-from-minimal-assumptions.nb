Cell[TextData[{
 "The warm curve plunges. The claimed factor is ",
 Cell[BoxData[
  RowBox[{"2", 
   OverscriptBox[
    StyleBox["n", "TI"], "_"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],
 "; read the ratio of the early losses across a shrinking window:"
}], "Text",
 CellID->1859711813,ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{
       RowBox[{"warmC", "[", "t1", "]"}], "/", 
       RowBox[{"warmC", "[", "0.", "]"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{
       RowBox[{"coldC", "[", "t1", "]"}], "/", 
       RowBox[{"coldC", "[", "0.", "]"}]}]}], ")"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t1", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.04", ",", " ", "0.02", ",", " ", "0.01"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[27]:= ",
 CellID->1981123129,ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"],

Cell[BoxData[
 RowBox[{"{", 
