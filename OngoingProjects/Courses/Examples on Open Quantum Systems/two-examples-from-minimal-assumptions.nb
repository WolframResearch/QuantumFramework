}, Open  ]],

Cell[TextData[{
 "Monotone, confirmed. ",
 StyleBox["Purifies",
  FontWeight->"Bold"],
 ", though, is the word that genuinely needs pinning, because it has at least \
three inequivalent meanings: (i) ",
 StyleBox["pathwise", "TI"],
 ", every single run's impurity goes to zero; (ii) ",
 StyleBox["in the mean", "TI"],
 ", the ensemble-averaged impurity falls; (iii) ",
 StyleBox["in passage", "TI"],
 ", the time to first reach a chosen impurity is short. The development below \
computes all three and shows they come apart: (i) and (ii) disagree about \
whether an unmonitored qubit purifies at all, and (ii) and (iii) reverse the \
ranking of two protocols. ",
 StyleBox["Faster",
  FontWeight->"Bold"],
 " inherits the same ambiguity, and Q3 is the demonstration."
}], "Text",
 CellID->181917407,ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"],

Cell[TextData[{
 StyleBox["Measurement strength",
  FontWeight->"Bold"],
 " is a convention to declare, not discover: the monitored observable ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["M", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6833ae6a-6ac5-a2c8-19c0-40340f71f012"],
 " enters as the channel ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["M", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7f2999-1aee-25a5-0504-c0c39e988f8f"],
 ", and the record increment in this convention is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["J", "TI"], "=", "2", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["M", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "128c7526-c883-085d-42b4-6c83e9365aa7"],
 " with a Wiener increment ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3279c00f-c9e2-8758-6206-da68ef94eda2"],
 " of variance ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50b12ff8-e606-85f7-004e-c6a593b0efdd"],
 "."
}], "Text",
 CellID->1906087345,ExpressionUUID->"640f47a5-4648-c62d-0c35-5e0f73e2ad77"],

Cell[TextData[{
 StyleBox["Steered",
  FontWeight->"Bold"],
 " means one thing only: the record chooses the ",
 StyleBox["next measured axis", "TI"],
 ". No Hamiltonian is ever applied to the qubit; the feedback loop closes \
through the choice of observable, and the step function below shows it, one \
measurement update per step and nothing else."
}], "Text",
 CellID->354048744,ExpressionUUID->"63a48922-0fac-666c-115b-208caa594cb6"],

Cell["The assumptions", "Subsection",
 CellID->786710823,ExpressionUUID->"387a9e0d-0234-0e73-6819-1057b7c15559"],

Cell[TextData[{
 StyleBox["B1, a fact, held provisionally: nothing drives the qubit.",
  FontWeight->"Bold"],
 " No Hamiltonian between measurements. Turned off under ",
 StyleBox["Switch the drive on", "TI"],
 ", and partially demoted there."
}], "Text",
 CellID->1859374462,ExpressionUUID->"3f64ca0d-9927-5f44-651b-ec5718d225ae"],

Cell[TextData[{
 StyleBox["B2, a fact: the detector is perfect.",
  FontWeight->"Bold"],
 " Every bit of the record is kept, efficiency ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "399d1ff3-4632-be92-6fa2-96bd73c404f8"],
 ". Turned off under ",
 StyleBox["A detector that misses", "TI"],
 ", where the verdict between the two protocols reverses."
}], "Text",
 CellID->544914423,ExpressionUUID->"1170384d-2f38-2c50-470f-b2174acd76ba"],

Cell[TextData[{
 StyleBox["B3, a fact: the measured channel is the only channel.",
  FontWeight->"Bold"],
 " Nothing else couples to the qubit. Turned off under ",
 StyleBox["A second channel, unwatched", "TI"],
 "."
}], "Text",
 CellID->1088734259,ExpressionUUID->"6ce33075-6d34-44a7-1490-aa3f04c12e8d"],

Cell[TextData[{
 StyleBox["B4, numerical: a finite step stands in for continuous monitoring.",
  
  FontWeight->"Bold"],
 " Refined inside the development, where the deterministic claim is tested \
against the step size."
}], "Text",
 CellID->476175344,ExpressionUUID->"54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],

Cell[TextData[{
 StyleBox["C2, a choice: the score is impurity.",
  FontWeight->"Bold"],
 " Proven equivalent to entropy above. ",
 StyleBox["C3, a choice: the strength convention",
  FontWeight->"Bold"],
 " stated above."
}], "Text",
 CellID->201272189,ExpressionUUID->"6334ac9c-43f1-85c0-12cb-45c67585ef2a"],

Cell["From watching to steering, and what faster means", "Subsection",
 CellID->320292756,ExpressionUUID->"74397683-04f4-1d4d-1dc7-6fedac816797"],

Cell["\<\
The conditioned state under a monitored channel needs a positivity-preserving \
update; this is the structure-preserving step of Rouchon and Ralph, exactly \
as the catalog builds it:\
\>", "Text",
 CellID->1146801282,ExpressionUUID->"735e49d5-32a1-4a48-2166-609f47541892"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"measurementStep", "[", 
    RowBox[{
    "H_", ",", " ", "watched_", ",", " ", "effs_", ",", " ", "unwatched_", ",",
      " ", "dt_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Enclose", "[", "\n", "  ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"d", " ", "=", " ", 
         RowBox[{"Length", "[", "H", "]"}]}], ",", " ", 
        RowBox[{"id", " ", "=", " ", 
         RowBox[{"IdentityMatrix", "[", 
          RowBox[{"Length", "[", "H", "]"}], "]"}]}], ",", " ", 
        RowBox[{"channels", " ", "=", " ", 
         RowBox[{"Join", "[", 
          RowBox[{"watched", ",", " ", "unwatched"}], "]"}]}], ",", " ", 
        "drift", ",", " ", "corr"}], "}"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{"ConfirmAssert", "[", 
        RowBox[{
         RowBox[{"VectorQ", "[", 
          RowBox[{"effs", ",", " ", 
           RowBox[{
            RowBox[{"0", " ", "<=", " ", "#", " ", "<=", " ", "1"}], " ", 
            "&"}]}], "]"}], ",", 
         " ", "\"\<efficiencies must lie in [0,1]\>\""}], "]"}], ";", "\n", 
       "   ", 
       RowBox[{"ConfirmAssert", "[", 
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{"dt", " ", ">", " ", "0"}], "]"}], ",", 
         " ", "\"\<time step must be positive\>\""}], "]"}], ";", "\n", "   ", 
       RowBox[{"drift", " ", "=", " ", 
        RowBox[{
         RowBox[{"I", " ", "H"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"Fold", "[", 
           RowBox[{"Plus", ",", " ", 
            RowBox[{"0", " ", "H"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "#", "]"}], " ", ".", " ", 
               "#"}], " ", "&"}], " ", "/@", " ", "channels"}]}], "]"}], "/", 
          "2"}]}]}], ";", "\n", "   ", 
       RowBox[{"corr", " ", "=", " ", 
        RowBox[{
         RowBox[{"Fold", "[", 
          RowBox[{"Plus", ",", " ", 
           RowBox[{"0", " ", "H"}], ",", " ", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"#1", " ", 
               RowBox[{"(", 
                RowBox[{"#2", " ", ".", " ", "#2"}], ")"}]}], " ", "&"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"effs", ",", " ", "watched"}], "}"}]}], "]"}]}], "]"}], 
         "/", "2"}]}], ";", "\n", "   ", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rho", ",", " ", "dJ"}], "}"}], ",", " ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"sig", ",", " ", "M", ",", " ", "top", ",", " ", "nrm"}], 
            "}"}], ",", "\n", "     ", 
           RowBox[{
            RowBox[{"sig", " ", "=", " ", 
             RowBox[{"Fold", "[", 
              RowBox[{"Plus", ",", " ", 
               RowBox[{"0", " ", "H"}], ",", " ", 
               RowBox[{"MapThread", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Sqrt", "[", "#2", "]"}], " ", "#1", " ", "#3"}], 
                  " ", "&"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"dJ", ",", " ", "effs", ",", " ", "watched"}], 
                  "}"}]}], "]"}]}], "]"}]}], ";", "\n", "     ", 
            RowBox[{"M", " ", "=", " ", 
             RowBox[{"id", " ", "-", " ", 
              RowBox[{"drift", " ", "dt"}], " ", "+", " ", "sig", " ", "+", 
              " ", 
              RowBox[{
               RowBox[{"sig", " ", ".", " ", "sig"}], "/", "2"}], " ", "-", 
              " ", 
              RowBox[{"corr", " ", "dt"}]}]}], ";", "\n", "     ", 
            RowBox[{"top", " ", "=", " ", 
             RowBox[{
              RowBox[{"M", " ", ".", " ", "rho", " ", ".", " ", 
               RowBox[{"ConjugateTranspose", "[", "M", "]"}]}], " ", "+", 
              "\n", "       ", 
              RowBox[{"dt", " ", 
               RowBox[{"Fold", "[", 
                RowBox[{"Plus", ",", " ", 
                 RowBox[{"0", " ", "H"}], ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"#", " ", ".", " ", "rho", " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], " ", 
                   "&"}], " ", "/@", " ", "unwatched"}]}], "]"}]}], " ", "+", 
              "\n", "       ", 
              RowBox[{"dt", " ", 
               RowBox[{"Fold", "[", 
                RowBox[{"Plus", ",", " ", 
                 RowBox[{"0", " ", "H"}], ",", " ", 
                 RowBox[{"MapThread", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", " ", "-", " ", "#2"}], ")"}], " ", 
                    RowBox[{"#1", " ", ".", " ", "rho", " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "#1", "]"}]}]}], " ", 
                    "&"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"watched", ",", " ", "effs"}], "}"}]}], "]"}]}], 
                "]"}]}]}]}], ";", "\n", "     ", 
            RowBox[{"nrm", " ", "=", " ", 
             RowBox[{"Re", "@", 
              RowBox[{"Tr", "[", "top", "]"}]}]}], ";", "\n", "     ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"TrueQ", "[", 
               RowBox[{"nrm", " ", ">", " ", "0"}], "]"}], ",", " ", 
              RowBox[{"top", "/", "nrm"}], ",", "\n", "       ", 
              RowBox[{"Failure", "[", 
               RowBox[{"\"\<NonPositiveNormalization\>\"", ",", " ", 
                RowBox[{"<|", 
                 RowBox[{"\"\<Normalization\>\"", " ", "->", " ", "nrm"}], 
                 "|>"}]}], "]"}]}], "]"}]}]}], "]"}]}], "]"}]}]}], "]"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[39]:= ",
 CellID->41202278,ExpressionUUID->"335d55a2-cf9b-493d-6163-4c0fea2e1807"],

Cell["\<\
The record model and one full monitored trajectory, states and record \
together:\
\>", "Text",
 CellID->1124146653,ExpressionUUID->"3bfbbd45-edb8-1b0b-6998-352e844d6651"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"measurementRecord", "[", 
    RowBox[{
    "rho_", ",", " ", "watched_List", ",", " ", "effs_List", ",", " ", "dt_", 
     ",", " ", "kick_List"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", "#3", "]"}], " ", 
        RowBox[{"Re", "@", 
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#1", " ", "+", " ", 
             RowBox[{"ConjugateTranspose", "[", "#1", "]"}]}], ")"}], " ", ".",
            " ", "rho"}], "]"}]}], " ", "dt"}], " ", "+", " ", "#2"}], " ", 
      "&"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"watched", ",", " ", "kick", ",", " ", "effs"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"trajectory", "[", 
    RowBox[{
    "rho0_", ",", " ", "H_", ",", " ", "watched_List", ",", " ", "effs_List", 
     ",", " ", "unwatched_List", ",", " ", "dt_", ",", " ", "tf_", ",", " ", 
     "seed_"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", " ", "=", " ", 
          RowBox[{"Round", "[", 
           RowBox[{"tf", "/", "dt"}], "]"}]}], ",", " ", "step", ",", " ", 
         "kicks", ",", " ", "states", ",", " ", "record"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"step", " ", "=", " ", 
         RowBox[{"measurementStep", "[", 
          RowBox[{
          "H", ",", " ", "watched", ",", " ", "effs", ",", " ", "unwatched", ",",
            " ", "dt"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"kicks", " ", "=", " ", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"Sqrt", "[", "dt", "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", 
             RowBox[{"Length", "[", "watched", "]"}]}], "}"}]}], "]"}]}], ";",
         "\n", "    ", 
        RowBox[{"states", " ", "=", " ", 
         RowBox[{"FoldList", "[", "\n", "      ", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"r", ",", " ", "dw"}], "}"}], ",", " ", 
             RowBox[{"step", "[", 
              RowBox[{"r", ",", " ", 
               RowBox[{"measurementRecord", "[", 
                RowBox[{
                "r", ",", " ", "watched", ",", " ", "effs", ",", " ", "dt", ",",
                  " ", "dw"}], "]"}]}], "]"}]}], "]"}], ",", " ", "rho0", ",",
            " ", "kicks"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"record", " ", "=", " ", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"measurementRecord", "[", 
             RowBox[{
             "#1", ",", " ", "watched", ",", " ", "effs", ",", " ", "dt", ",",
               " ", "#2"}], "]"}], " ", "&"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Most", "[", "states", "]"}], ",", " ", "kicks"}], 
            "}"}]}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<times\>\"", " ", "->", " ", 
           RowBox[{"dt", " ", 
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", "n"}], "]"}]}]}], ",", " ", 
          RowBox[{"\"\<states\>\"", " ", "->", " ", "states"}], ",", " ", 
          RowBox[{"\"\<record\>\"", " ", "->", " ", "record"}]}], "|>"}]}]}], 
      "]"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[40]:= ",
 CellID->1232284935,ExpressionUUID->"045023ab-c37d-b770-2c6f-baf4f6091a5a"],

Cell[TextData[{
 StyleBox["Q1.",
  FontWeight->"Bold"],
 " Fix the strength and the step, start maximally mixed, watch a fixed axis, \
and follow the impurity of five runs:"
}], "Text",
 CellID->2082395230,ExpressionUUID->"73e8aeff-5b91-f8f4-2197-47b95e25cade"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kPur", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"hPur", " ", "=", " ", "0.01"}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"runs", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"impurity", " ", "/@", " ", 
        RowBox[{
         RowBox[{"trajectory", "[", 
          RowBox[{
           RowBox[{"id2", "/", "2"}], ",", " ", 
           RowBox[{"0", " ", "id2"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sqrt", "[", "kPur", "]"}], " ", "Z"}], "}"}], ",", " ", 
           
           RowBox[{"{", "1.", "}"}], ",", " ", 
           RowBox[{"{", "}"}], ",", " ", "hPur", ",", " ", "3.", ",", " ", 
           "s"}], "]"}], "[", "\"\<states\>\"", "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"hPur", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", "300"}], "]"}]}], ",", " ", "#"}], "}"}], 
        "]"}], " ", "&"}], " ", "/@", " ", "runs"}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", "Thick"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0.52"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", " ", "\"\<impurity\>\""}], "}"}]}], ",", 
     " ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<watching alone purifies every kept run\>\""}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[41]:= ",
 CellID->1057670838,ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"],

