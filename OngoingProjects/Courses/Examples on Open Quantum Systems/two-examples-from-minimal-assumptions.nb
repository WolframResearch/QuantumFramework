Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"vals", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"vnEntropy", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"id2", " ", "+", " ", 
           RowBox[{"r", " ", "Z"}]}], ")"}], "/", "2"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0.999", ",", " ", "0.001", ",", " ", 
         RowBox[{"-", "0.002"}]}], "}"}]}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{
