Cell["\<\
The runs hug the dashed line with a small scatter. The law is route one; the \
simulation is route two; and B4 says the scatter should be the step's fault, \
not physics. Test that: at a fixed physical time, refine the step and watch \
both the spread across runs and the distance to the law contract:\
\>", "Text",
 CellID->1357963930,ExpressionUUID->"2f4595f3-090a-1216-557a-0cbda8bf617c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableForm", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"fin", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Last", "[", 
             RowBox[{"impurity", " ", "/@", " ", 
              RowBox[{"steered", "[", 
               RowBox[{
                RowBox[{"id2", "/", "2"}], ",", " ", 
                RowBox[{"0", " ", "id2"}], ",", " ", "kPur", ",", " ", "1.", ",",
                 " ", "h", ",", " ", "0.6", ",", " ", "s"}], "]"}]}], "]"}], ",",
             " ", 
            RowBox[{"{", 
             RowBox[{"s", ",", " ", "60"}], "}"}]}], "]"}]}], ",", "\n", 
         "    ", 
         RowBox[{"target", " ", "=", " ", 
          RowBox[{"0.5", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "4"}], " ", "kPur", " ", "0.6"}], "]"}]}]}]}], 
        "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"h", ",", " ", 
         RowBox[{"Mean", "[", "fin", "]"}], ",", " ", 
         RowBox[{"StandardDeviation", "[", "fin", "]"}], ",", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Mean", "[", "fin", "]"}], " ", "-", " ", "target"}], 
          "]"}]}], "}"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"h", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.02", ",", " ", "0.01", ",", " ", "0.005"}], "}"}]}], 
      "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<step h\>\"", ",", " ", "\"\<mean impurity\>\"", ",", 
        " ", "\"\<spread\>\"", ",", " ", "\"\<gap to the law\>\""}], "}"}]}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[44]:= ",
 CellID->393574636,ExpressionUUID->"06385f5e-e9d4-4e6c-2fd8-571b886114b6"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      TagBox["\<\"step h\"\>",
       HoldForm], 
      TagBox["\<\"mean impurity\"\>",
       HoldForm], 
      TagBox["\<\"spread\"\>",
       HoldForm], 
      TagBox["\<\"gap to the law\"\>",
       HoldForm]},
     {"0.02`", "0.055160129262037186`", "0.029906644971582224`", 
      "0.00980115261733093`"},
     {"0.01`", "0.05332764753810482`", "0.021326706954712477`", 
      "0.007968670893398568`"},
