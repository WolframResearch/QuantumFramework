Cell["\<\
They lie on each other, and there is a mechanism, not luck, behind it: under \
this leak the evolved cat minus the evolved mixture is exactly the cross \
term, whose trace norm is twice its weight up to corrections of the order of \
the lobe overlap. So the two numbers must agree to that order while the lobes \
are well separated, and the agreement should degrade as they close. Measure \
the largest normalized gap at the working size and at the small size:\
\>", "Text",
 CellID->1962937852,ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"coherenceGap", "[", 
    RowBox[{"al_", ",", " ", "tmax_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"runC", ",", " ", "runA", ",", " ", "runB", ",", " ", "ts"}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"runC", " ", "=", " ", 
       RowBox[{"evolveODE", "[", 
        RowBox[{
         RowBox[{"0", " ", "blankCat"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], "}"}],
          ",", "\n", "     ", 
         RowBox[{"densityMatrix", "[", 
          RowBox[{"Normalize", "[", 
           RowBox[{
            RowBox[{"coherentState", "[", 
             RowBox[{"topCat", ",", " ", "al"}], "]"}], " ", "+", " ", 
            RowBox[{"coherentState", "[", 
             RowBox[{"topCat", ",", " ", 
              RowBox[{"-", "al"}]}], "]"}]}], "]"}], "]"}], ",", " ", 
         "tmax"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"runA", ",", " ", "runB"}], "}"}], " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"evolveODE", "[", 
          RowBox[{
           RowBox[{"0", " ", "blankCat"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], 
            "}"}], ",", "\n", "      ", 
           RowBox[{"densityMatrix", "[", 
            RowBox[{"coherentState", "[", 
             RowBox[{"topCat", ",", " ", "#"}], "]"}], "]"}], ",", " ", 
           "tmax"}], "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{"al", ",", " ", 
          RowBox[{"-", "al"}]}], "}"}]}]}], ";", "\n", "   ", 
      RowBox[{"ts", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0.", ",", " ", "tmax", ",", " ", 
         RowBox[{"tmax", "/", "15"}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"wr", " ", "=", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"catCoherence", "[", 
              RowBox[{
               RowBox[{"runC", "[", "#", "]"}], ",", " ", 
               RowBox[{"al", " ", 
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"-", "\[Gamma]cat"}], " ", 
                  RowBox[{"#", "/", "2"}]}], "]"}]}]}], "]"}], " ", "&"}], 
            " ", "/@", " ", "ts"}]}], ",", "\n", "     ", 
          RowBox[{"td", " ", "=", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"traceDistance", "[", 
              RowBox[{
               RowBox[{"runC", "[", "#", "]"}], ",", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"runA", "[", "#", "]"}], " ", "+", " ", 
                  RowBox[{"runB", "[", "#", "]"}]}], ")"}], "/", "2"}]}], 
              "]"}], " ", "&"}], " ", "/@", " ", "ts"}]}]}], "}"}], ",", "\n",
         "    ", 
        RowBox[{"Max", "@", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"wr", "/", 
            RowBox[{"First", "[", "wr", "]"}]}], " ", "-", " ", 
           RowBox[{"td", "/", 
            RowBox[{"First", "[", "td", "]"}]}]}], "]"}]}]}], "]"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"coherenceGap", "[", 
    RowBox[{"\[Alpha]0", ",", " ", "2.5"}], "]"}], ",", " ", 
   RowBox[{"coherenceGap", "[", 
    RowBox[{"0.6", ",", " ", "1.5"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[20]:= ",
 CellID->1818488019,ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.005079665440511694`", ",", "0.3013775449752454`"}], 
  "}"}]], "Output",
 CellLabel->"Out[20]= ",
 CellID->1752175041,ExpressionUUID->"5900aac7-5263-773e-0f3f-43a167165a04"]
}, Open  ]],

Cell["\<\
The first number, the well-separated gap, sits at the overlap scale; the \
second, the close-lobe gap, is far larger. The verdict on C1: a harmless \
choice inside A4's scope, a real choice outside it. A choice can inherit its \
innocence from an assumption, and the pairing is now on record.\
\>", "Text",
 CellID->2099309037,ExpressionUUID->"06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],

Cell[TextData[{
 StyleBox["A drive that rotates the lobes (A3 off).",
  FontWeight->"Bold"],
 " Switch on a free Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12d95fcb-3316-2212-42e7-569546a37178"],
 ". Phase rotation commutes with the loss dissipator, so the driven solution \
should be exactly the undriven one rotated in phase space, lobes at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], "0"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Omega]", "TI"], 
     StyleBox["t", "TI"]}]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "733995c2-f5bf-78ee-22c6-0caffc4a4a34"],
 ", with the same coherence factor. Evolve with the drive:"
}], "Text",
 CellID->512383039,ExpressionUUID->"4f8ab258-7e7f-0723-7589-34027b0a6a09"],

Cell[BoxData[
 RowBox[{
  RowBox[{"withDrive", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{"1.3", " ", 
      RowBox[{"numberOp", "[", "topCat", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], "}"}], ",",
      " ", "cat0", ",", " ", "2.5"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->273308241,ExpressionUUID->"6b12ee74-9953-131d-1921-003e18e67e67"],

Cell["\<\
Rotate each snapshot back and measure the distance to the undriven run, the \
whole-state form of the claim:\
\>", "Text",
 CellID->1809098798,ExpressionUUID->"65262d3c-fccc-1dc6-0cdd-c579f579672c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"R", " ", "=", " ", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "1.3", " ", "t", " ", 
          RowBox[{"numberOp", "[", "topCat", "]"}]}], "]"}]}], "}"}], ",", 
      "\n", "   ", 
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "R", "]"}], " ", ".", " ", 
          RowBox[{"withDrive", "[", "t", "]"}], " ", ".", " ", "R"}], " ", "-",
          " ", 
         RowBox[{"catRun", "[", "t", "]"}]}], ",", " ", "\"\<Frobenius\>\""}],
        "]"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "0.25", ",", " ", "2.5", ",", " ", "0.25"}], 
     "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->308320186,ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"],

Cell[BoxData["8.942632467528244`*^-7"], "Output",
 CellLabel->"Out[22]= ",
 CellID->845252322,ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"]
}, Open  ]],

Cell["\<\
At the solver tolerance: the drive is a rigid rotation of the whole picture. \
The coherence, extracted on the rotated lobes, must then land on the same \
closed form:\
\>", "Text",
 CellID->724760089,ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"catCoherence", "[", 
       RowBox[{
        RowBox[{"withDrive", "[", "t", "]"}], ",", " ", 
        RowBox[{"\[Alpha]0", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "I"}], " ", "1.3", " ", "t"}], " ", "-", " ", 
           RowBox[{"\[Gamma]cat", " ", 
            RowBox[{"t", "/", "2"}]}]}], "]"}]}]}], "]"}], " ", "-", "\n", 
      "    ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"\[Alpha]0", "^", "2"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[Gamma]cat"}], " ", "t"}], "]"}]}], ")"}]}], 
       "]"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "0.25", ",", " ", "2.5", ",", " ", "0.25"}], 
     "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->310708056,ExpressionUUID->"1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],

Cell[BoxData["1.491112552320928`*^-7"], "Output",
 CellLabel->"Out[23]= ",
 CellID->653431539,ExpressionUUID->"187adc3d-3961-76c2-4819-d667b8145c28"]
}, Open  ]],

Cell[TextData[{
 "It does. ",
 StyleBox["A3 is hereby deleted from the list.",
  FontWeight->"Bold"],
 " It was a simplification, not a load-bearing assumption: every claim above \
survives the drive untouched. Rule 5 cuts both ways, and this is the \
direction that shortens the list. The scope of the deletion is worth one \
sentence: what saved the claims is that a free rotation keeps coherent states \
coherent; a Hamiltonian that does not, a Kerr term for instance, is a \
genuinely different problem, and the list after the computations records the \
boundary that way."
}], "Text",
 CellID->811283638,ExpressionUUID->"641c78eb-7f03-7846-0c24-71b57ab64aac"],

Cell[TextData[{
 StyleBox["A warm bath (A2 off).",
  FontWeight->"Bold"],
 " Give the environment a temperature: a downward channel at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["n", "TI"], "_"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],
 " and an upward one at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   OverscriptBox[
    StyleBox["n", "TI"], "_"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],
 ". Two things should happen: the answer to Q1 breaks, because a heated lobe \
does not stay a coherent state, and the cross term should die faster by the \
factor ",
 Cell[BoxData[
  RowBox[{"2", 
   OverscriptBox[
    StyleBox["n", "TI"], "_"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6121b9de-dddd-aca8-10de-309bd469f6f2"],
 ". First Q1's fate, the purity of a single evolved lobe under the warm \
pair:"
}], "Text",
 CellID->207978548,ExpressionUUID->"30209679-023a-ee91-61df-0823b7ccb4fb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"purity", "[", 
  RowBox[{
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{"0", " ", "blankCat"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"\[Gamma]cat", " ", "2."}], "]"}], " ", "downCat"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"\[Gamma]cat", " ", "1."}], "]"}], " ", 
        RowBox[{"ConjugateTranspose", "[", "downCat", "]"}]}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"densityMatrix", "[", 
      RowBox[{"coherentState", "[", 
       RowBox[{"topCat", ",", " ", "\[Alpha]0"}], "]"}], "]"}], ",", " ", 
     "0.6"}], "]"}], "[", "0.6", "]"}], "]"}]], "Input",
 CellLabel->"In[24]:= ",
 CellID->1653357925,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell[BoxData["0.5931527523312546`"], "Output",
 CellLabel->"Out[24]= ",
 CellID->715244046,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"]
}, Open  ]],

Cell["\<\
Below one: the pointer states of the cold leak are no longer preserved, so \
the lobes must be evolved rather than written down. That is why the coherence \
here is measured by the trace distance to the evolved mixture, the C1 rival, \
whose innocence inside A4 was just established:\
\>", "Text",
 CellID->874582697,ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"warmCoherence", "[", "nT_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fall", " ", "=", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"\[Gamma]cat", " ", 
           RowBox[{"(", 
            RowBox[{"nT", " ", "+", " ", "1"}], ")"}]}], "]"}], " ", 
         "downCat"}]}], ",", "\n", "    ", 
       RowBox[{"climb", " ", "=", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"\[Gamma]cat", " ", "nT"}], "]"}], " ", 
         RowBox[{"ConjugateTranspose", "[", "downCat", "]"}]}]}], ",", " ", 
       "runs"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"runs", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"evolveODE", "[", 
          RowBox[{
           RowBox[{"0", " ", "blankCat"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"fall", ",", " ", "climb"}], "}"}], ",", " ", "#", ",", 
           " ", "0.6"}], "]"}], " ", "&"}], " ", "/@", "\n", "     ", 
        RowBox[{"{", 
         RowBox[{"cat0", ",", " ", 
          RowBox[{"densityMatrix", "[", 
           RowBox[{"coherentState", "[", 
            RowBox[{"topCat", ",", " ", "\[Alpha]0"}], "]"}], "]"}], ",", " ", 
          RowBox[{"densityMatrix", "[", 
           RowBox[{"coherentState", "[", 
            RowBox[{"topCat", ",", " ", 
             RowBox[{"-", "\[Alpha]0"}]}], "]"}], "]"}]}], "}"}]}]}], ";", 
      "\n", "   ", 
      RowBox[{"Function", "[", 
       RowBox[{"t", ",", " ", 
        RowBox[{"traceDistance", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"runs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"runs", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "[", "t", "]"}], " ", "+", " ", 
             RowBox[{
              RowBox[{"runs", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}]}], ")"}], "/", 
           "2"}]}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"coldC", ",", " ", "warmC"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"warmCoherence", "[", "0.", "]"}], ",", " ", 
     RowBox[{"warmCoherence", "[", "1.", "]"}]}], "}"}]}], ";"}]}], "Input",
 CellLabel->"In[25]:= ",
 CellID->11631581,ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],

Cell["Compare the two decays, each normalized to its start:", "Text",
 CellID->1933762060,ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ts", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", " ", "0.6", ",", " ", "0.02"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"ts", ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"coldC", " ", "/@", " ", "ts"}], ")"}], "/", 
           RowBox[{"coldC", "[", "0.", "]"}]}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"ts", ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"warmC", " ", "/@", " ", "ts"}], ")"}], "/", 
           RowBox[{"warmC", "[", "0.", "]"}]}]}], "}"}], "]"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<cold bath\>\"", ",", " ", "\"\<warm bath\>\""}], "}"}]}], 
     ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", " ", "\"\<surviving coherence\>\""}], 
       "}"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<temperature multiplies the decay rate\>\""}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[26]:= ",
 CellID->1576143752,ExpressionUUID->"51fce014-dca1-0630-0783-fa51d5546d1a"],

