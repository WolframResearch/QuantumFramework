Cell[TextData[{
 "The cross term is gone while the lobes are still nearly full size: the \
ratio of the two rates is ",
 Cell[BoxData[
  RowBox[{"2", 
   SubsuperscriptBox[
    StyleBox["\[Alpha]", "TI"], "0", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f449897-1a0e-51e7-357b-11d19fbb23cd"],
 ", and it grows with the square of the cat's size. That is the whole reason \
mesoscopic superpositions are fragile and macroscopic ones are hopeless."
}], "Text",
 CellID->49659130,ExpressionUUID->"6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],

Cell["Turning the assumptions off", "Subsection",
 CellID->464508221,ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

Cell[TextData[{
 StyleBox["Bringing the lobes close (A4 off).",
  FontWeight->"Bold"],
 " The closed form never used the separation being large, so shrink it and \
see what actually fails. Draw the same two curves at the working size and at \
a small one:"
}], "Text",
 CellID->1361313038,ExpressionUUID->"07359582-e823-44a1-2eca-0cef89d62e8b"],

