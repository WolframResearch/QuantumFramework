Cell["\<\
At the small size the coherence outlives a fair share of the energy: the \
phenomenon named in the title, decoherence far faster than dissipation, is \
gone. The law itself survives; confirm it by rerunning the two-route check on \
a small cat:\
\>", "Text",
 CellID->483148123,ExpressionUUID->"6184d2f2-049e-728e-17bb-cbbcad2b40d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"al", " ", "=", " ", "0.6"}], "}"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"run", " ", "=", " ", 
       RowBox[{"evolveODE", "[", 
        RowBox[{
         RowBox[{"0", " ", "blankCat"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], "}"}],
          ",", "\n", "     ", 
         RowBox[{"densityMatrix", "[", 
          RowBox[{"Normalize", "[", 
           RowBox[{
            RowBox[{"coherentState", "[", 
             RowBox[{"topCat", ",", " ", "al"}], "]"}], " ", "+", " ", 
            RowBox[{"coherentState", "[", 
             RowBox[{"topCat", ",", " ", 
              RowBox[{"-", "al"}]}], "]"}]}], "]"}], "]"}], ",", " ", "1.5"}],
         "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"Max", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"catCoherence", "[", 
           RowBox[{
            RowBox[{"run", "[", "t", "]"}], ",", " ", 
            RowBox[{"al", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "\[Gamma]cat"}], " ", 
               RowBox[{"t", "/", "2"}]}], "]"}]}]}], "]"}], " ", "-", "\n", 
          "      ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "2"}], " ", 
            RowBox[{"al", "^", "2"}], " ", 
            RowBox[{"(", 
             RowBox[{"1", " ", "-", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "\[Gamma]cat"}], " ", "t"}], "]"}]}], ")"}]}], 
           "]"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0.", ",", " ", "1.5", ",", " ", "0.25"}], 
         "}"}]}], "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[17]:= ",
 CellID->668869836,ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"],

Cell[BoxData["1.0846067507452872`*^-6"], "Output",
 CellLabel->"Out[17]= ",
 CellID->1510519072,ExpressionUUID->"19bb1c5e-57ab-6e36-4f58-9618625e351c"]
}, Open  ]],

Cell[TextData[{
 "Still at the solver tolerance. So A4 splits cleanly by claim: the formula \
for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],
 " does not need it, the headline (fast decoherence) is nothing but it, and \
the extraction machinery degrades as the overlap grows. One assumption, three \
different scopes, and only the computation separates them."
}], "Text",
 CellID->1521685512,ExpressionUUID->"30baa1c8-66ad-75e0-6059-389213585fca"],

Cell[TextData[{
 StyleBox["Two numbers for one coherence (C1 compared).",
  FontWeight->"Bold"],
 " Evolve the two lobes separately, so the rival number, the trace distance \
between the evolved cat and the evolved even mixture of its lobes, can be \
computed on the same run:"
}], "Text",
 CellID->97201263,ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lobeRunA", ",", " ", "lobeRunB"}], "}"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"evolveODE", "[", 
      RowBox[{
       RowBox[{"0", " ", "blankCat"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "\[Gamma]cat", "]"}], " ", "downCat"}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"densityMatrix", "[", 
        RowBox[{"coherentState", "[", 
         RowBox[{"topCat", ",", " ", "#"}], "]"}], "]"}], ",", " ", "2.5"}], 
      "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]0", ",", " ", 
      RowBox[{"-", "\[Alpha]0"}]}], "}"}]}]}], ";"}]], "Input",
 CellLabel->"In[18]:= ",
 CellID->878831761,ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell["Plot both numbers, each normalized to its own start:", "Text",
 CellID->1048559713,ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ts", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", " ", "2.5", ",", " ", "0.1"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"wr", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"catCoherence", "[", 
           RowBox[{
            RowBox[{"catRun", "[", "#", "]"}], ",", " ", 
            RowBox[{"\[Alpha]0", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "\[Gamma]cat"}], " ", 
               RowBox[{"#", "/", "2"}]}], "]"}]}]}], "]"}], " ", "&"}], " ", "/@",
          " ", "ts"}]}], ",", "\n", "   ", 
       RowBox[{"td", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"traceDistance", "[", 
           RowBox[{
            RowBox[{"catRun", "[", "#", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"lobeRunA", "[", "#", "]"}], " ", "+", " ", 
               RowBox[{"lobeRunB", "[", "#", "]"}]}], ")"}], "/", "2"}]}], 
           "]"}], " ", "&"}], " ", "/@", " ", "ts"}]}]}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"ts", ",", " ", 
            RowBox[{"wr", "/", 
             RowBox[{"First", "[", "wr", "]"}]}]}], "}"}], "]"}], ",", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"ts", ",", " ", 
            RowBox[{"td", "/", 
             RowBox[{"First", "[", "td", "]"}]}]}], "}"}], "]"}]}], "}"}], ",",
        "\n", "   ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", "Dashed"}], 
           "]"}]}], "}"}]}], ",", "\n", "   ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<weight ratio\>\"", ",", " ", "\"\<trace distance\>\""}],
          "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", "   ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<time\>\"", ",", 
          " ", "\"\<coherence, each normalized to its start\>\""}], "}"}]}], ",",
        " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "   ", 
       RowBox[{
       "PlotLabel", " ", "->", " ", "\"\<two definitions, one decay\>\""}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[19]:= ",
 CellID->879243051,ExpressionUUID->"511b3347-8d7d-ab60-0738-ab212409f64a"],

