  "2.5478880418384957`", ",", "2.7525815228534736`", ",", 
   "2.870201832483378`"}], "}"}]], "Output",
 CellLabel->"Out[27]= ",
 CellID->571141560,ExpressionUUID->"1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"]
}, Open  ]],

Cell[TextData[{
 "The sequence climbs toward ",
 Cell[BoxData[
  RowBox[{"2", 
   OverscriptBox[
    StyleBox["n", "TI"], "_"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370294fd-9e49-2d35-5d31-0da71bfc741f"],
 ", which is three for this bath, as the window shrinks; the residue at \
finite window is the curvature of the exponential. So A2 owns the prefactor \
of the decoherence rate and the identity of the pointer states, while the \
separation-squared structure stands untouched: the catalog's Part Three works \
this warm case in full, and this cell is the link to it."
}], "Text",
 CellID->1427211115,ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

Cell[TextData[{
 StyleBox["A bath that hands the amplitude back (A1 off).",
  FontWeight->"Bold"],
 " Replace the featureless environment with the smallest one that has memory: \
a single auxiliary mode ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7519012f-e657-215b-2326-988893e273a1"],
 ", coupled by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["b", "TI"], "^"], "\[Dagger]"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["b", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "594776df-9e75-d16a-0f7d-6f991b01a3b0"],
 ", which leaks at rate ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6405505f-4b92-3bd6-0c3b-4a196e24893c"],
 ". The cavity amplitude then obeys a two-step chain, ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6878c7f8-419e-9db5-1807-dea27028e79f"],
 " feeds ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48a3d607-c312-9dd3-7850-c860f6a4e739"],
 " and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539491e8-328f-8d7b-01ab-08b2473bd441"],
 " feeds the void, and the transmitted amplitude ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],
 " obeys"
}], "Text",
 CellID->2099805207,ExpressionUUID->"023f49e2-a747-9723-33c5-60cfd2f3fa09"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["u", "TI"], "\[DoublePrime]"], "+", 
    FractionBox[
     StyleBox["\[Kappa]", "TI"], "2"], 
    SuperscriptBox[
     StyleBox["u", "TI"], "\[Prime]"], "+", 
    SuperscriptBox[
     StyleBox["g", "TI"], "2"], 
    StyleBox["u", "TI"], "=", "0"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["u", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "0", 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", "1"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["u", "TI"], "\[Prime]"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "0", 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", "0"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1402006442,ExpressionUUID->"21aa1c49-e16c-f406-57a9-9612901edf6c"],

Cell[TextData[{
 "so the cavity sees a loss channel of transmissivity ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      RowBox[{
       StyleBox["u", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "289b85cd-827f-9a9c-58b8-1c97370be8e6"],
 " and the cat's coherence is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["exp",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", "2", 
    SuperscriptBox[
     StyleBox["\[Alpha]", "TI"], "2"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     SuperscriptBox[GridBox[{
        {
         RowBox[{
          StyleBox["u", "TI"], 
          StyleBox["(",
           SpanMaxSize->1], 
          StyleBox["t", "TI"], 
          StyleBox[")",
           SpanMaxSize->1]}]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f3dbee-abc4-6375-4280-d2cbce714e5f"],
 ". When ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "\[GreaterGreater]", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
 " the auxiliary mode empties as fast as it fills, the chain forgets, and the \
constant rate ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["eff",
     FontSlant->"Plain"]], "=", "4", 
   SuperscriptBox[
    StyleBox["g", "TI"], "2"], "/", 
   StyleBox["\[Kappa]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cfa2c34-ef50-7d46-5499-c6718ae547ac"],
 " returns: the assumption A1 is the statement that the bath lives in that \
corner. Write the amplitude and confirm it solves its equation:"
}], "Text",
 CellID->1901179466,ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"uMode", "[", 
     RowBox[{"g_", ",", " ", "\[Kappa]_"}], "]"}], "[", "t_", "]"}], " ", ":=",
    " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"om", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"g", "^", "2"}], " ", "-", " ", 
         RowBox[{
          RowBox[{"\[Kappa]", "^", "2"}], "/", "16"}]}], "]"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Kappa]"}], " ", 
        RowBox[{"t", "/", "4"}]}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"om", " ", "t"}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"\[Kappa]", "/", 
          RowBox[{"(", 
           RowBox[{"4", " ", "om"}], ")"}]}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"om", " ", "t"}], "]"}]}]}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"uMode", "[", 
       RowBox[{"g", ",", " ", "\[Kappa]"}], "]"}], "[", "t", "]"}], ",", " ", 
     
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "2"}], "}"}]}], "]"}], " ", "+", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[Kappa]", "/", "2"}], ")"}], " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"uMode", "[", 
        RowBox[{"g", ",", " ", "\[Kappa]"}], "]"}], "[", "t", "]"}], ",", " ",
       "t"}], "]"}]}], " ", "+", "\n", "  ", 
   RowBox[{
    RowBox[{"g", "^", "2"}], " ", 
    RowBox[{
     RowBox[{"uMode", "[", 
      RowBox[{"g", ",", " ", "\[Kappa]"}], "]"}], "[", "t", "]"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[28]:= ",
 CellID->1498641165,ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[28]= ",
 CellID->1229542382,ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"]
}, Open  ]],

Cell["Zero identically. The memory-bath coherence in closed form:", "Text",
 CellID->1992790374,ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"memCoherence", "[", 
     RowBox[{"g_", ",", " ", "\[Kappa]_", ",", " ", "al_"}], "]"}], "[", "t_",
     "]"}], " ", ":=", " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "2"}], " ", 
     RowBox[{"al", "^", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{"uMode", "[", 
           RowBox[{"g", ",", " ", "\[Kappa]"}], "]"}], "[", "t", "]"}], "]"}],
         "^", "2"}]}], ")"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[29]:= ",
 CellID->292747604,ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell[TextData[{
 "Two fingerprints separate memory from no memory. The onset: with memory the \
early loss is quadratic in time, ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[
    StyleBox["u", "TI"], "2"], "\[TildeTilde]", 
   SuperscriptBox[
    StyleBox["g", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],
 ", where the constant-rate bath loses linearly. Compare the early coherence \
loss of the two, same effective rate:"
}], "Text",
 CellID->1553818268,ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", " ", "-", " ", 
    RowBox[{
     RowBox[{"memCoherence", "[", 
      RowBox[{"1.", ",", " ", "0.5", ",", " ", "1."}], "]"}], "[", "0.05", 
     "]"}]}], ",", " ", 
   RowBox[{"1", " ", "-", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"4", "/", "0.5"}], ")"}]}], " ", "0.05"}], "]"}]}], 
       ")"}]}], "]"}]}]}], "}"}]], "Input",
 CellLabel->"In[30]:= ",
 CellID->2054282711,ExpressionUUID->"52243646-2fbd-210e-03db-a8204a487054"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.004962742117666896`", ",", "0.48281772716285665`"}], 
  "}"}]], "Output",
 CellLabel->"Out[30]= ",
 CellID->1550053719,ExpressionUUID->"1acd7f4d-3da3-7753-4af3-7717b4565db9"]
}, Open  ]],

Cell[TextData[{
 "The first number, the memory bath's early loss, is a small fraction of the \
second: the memoried decay starts flat. And the revival: when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "<", "4", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "062d91f0-6326-41c0-2fd2-08ba16d3132a"],
 " the amplitude swings back from the auxiliary mode before leaking, so the \
coherence partially returns, which no equation with a nonnegative constant \
rate can do. Check the closed form against the full two-mode master equation, \
run at a slightly smaller cat so the joint simulation stays light:"
}], "Text",
 CellID->1358728755,ExpressionUUID->"1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"naMem", " ", "=", " ", "9"}], ";", " ", 
  RowBox[{"nbMem", " ", "=", " ", "9"}], ";", " ", 
  RowBox[{"gMem", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"\[Kappa]Mem", " ", "=", " ", "0.5"}], ";", " ", 
  RowBox[{"\[Alpha]Mem", " ", "=", " ", "1."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"aJoint", " ", "=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"annihilation", "[", "naMem", "]"}], ",", " ", 
     RowBox[{"IdentityMatrix", "[", "nbMem", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bJoint", " ", "=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "naMem", "]"}], ",", " ", 
     RowBox[{"annihilation", "[", "nbMem", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"memRun", " ", "=", " ", 
   RowBox[{"evolveODE", "[", 
    RowBox[{
     RowBox[{"gMem", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"aJoint", " ", ".", " ", 
         RowBox[{"ConjugateTranspose", "[", "bJoint", "]"}]}], " ", "+", " ", 
        
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", "aJoint", "]"}], " ", ".", " ", 
         "bJoint"}]}], ")"}]}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "\[Kappa]Mem", "]"}], " ", "bJoint"}], "}"}], ",",
      "\n", "   ", 
     RowBox[{"densityMatrix", "[", 
      RowBox[{"Flatten", "@", 
       RowBox[{"KroneckerProduct", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"Normalize", "[", 
          RowBox[{
           RowBox[{"coherentState", "[", 
            RowBox[{"naMem", ",", " ", "\[Alpha]Mem"}], "]"}], " ", "+", " ", 
           
           RowBox[{"coherentState", "[", 
            RowBox[{"naMem", ",", " ", 
             RowBox[{"-", "\[Alpha]Mem"}]}], "]"}]}], "]"}], ",", "\n", 
         "      ", 
         RowBox[{"coherentState", "[", 
          RowBox[{"nbMem", ",", " ", "0."}], "]"}]}], "]"}]}], "]"}], ",", 
     " ", "6."}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[31]:= ",
 CellID->935019337,ExpressionUUID->"6f6ad260-8ee1-565a-1569-d44a2a943ca0"],

Cell["\<\
Trace out the auxiliary mode and extract the cavity coherence on the \
transmitted lobes, sampling away from the amplitude's zero crossings where \
the two lobes coincide and the extraction has nothing to grip:\
\>", "Text",
 CellID->642744358,ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cavityOf", "[", "joint_", "]"}], " ", ":=", " ", 
   RowBox[{"TensorContract", "[", 
    RowBox[{
     RowBox[{"ArrayReshape", "[", 
      RowBox[{"joint", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "naMem", ",", " ", "nbMem", ",", " ", "naMem", ",", " ", "nbMem"}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4"}], "}"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"memSample", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"0.5", ",", " ", "5.75", ",", " ", "0.375"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"uMode", "[", 
          RowBox[{"gMem", ",", " ", "\[Kappa]Mem"}], "]"}], "[", "#", "]"}], 
        "]"}], " ", ">", " ", "0.2"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"memDots", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", " ", 
       RowBox[{"catCoherence", "[", 
        RowBox[{
         RowBox[{"cavityOf", "[", 
          RowBox[{"memRun", "[", "t", "]"}], "]"}], ",", " ", 
         RowBox[{"\[Alpha]Mem", " ", 
          RowBox[{
           RowBox[{"uMode", "[", 
            RowBox[{"gMem", ",", " ", "\[Kappa]Mem"}], "]"}], "[", "t", 
           "]"}]}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "memSample"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Max", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"catCoherence", "[", 
       RowBox[{
        RowBox[{"cavityOf", "[", 
         RowBox[{"memRun", "[", "t", "]"}], "]"}], ",", " ", 
        RowBox[{"\[Alpha]Mem", " ", 
         RowBox[{
          RowBox[{"uMode", "[", 
           RowBox[{"gMem", ",", " ", "\[Kappa]Mem"}], "]"}], "[", "t", 
          "]"}]}]}], "]"}], " ", "-", "\n", "    ", 
      RowBox[{
       RowBox[{"memCoherence", "[", 
        RowBox[{"gMem", ",", " ", "\[Kappa]Mem", ",", " ", "\[Alpha]Mem"}], 
        "]"}], "[", "t", "]"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "memSample"}], "}"}]}], "]"}]}]}], "Input",
 CellLabel->"In[32]:= ",
 CellID->2049074839,ExpressionUUID->"26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],

Cell[BoxData["0.0000315359655078673`"], "Output",
 CellLabel->"Out[32]= ",
 CellID->679464590,ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"]
}, Open  ]],

Cell[TextData[{
 "The largest gap between the two-mode simulation and the closed form is \
small: two routes again, one solved by hand through ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b853673-18d0-d9fa-19ba-a83d996aabc0"],
 ", one a full joint master equation that never heard of ",
 Cell[BoxData[
  StyleBox["u", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25b5b884-ef74-61b3-534a-31e18a013399"],
 ". Now draw the whole story, slow bath and fast bath, each beside the \
constant-rate stand-in with the same effective rate:"
}], "Text",
 CellID->124263719,ExpressionUUID->"574a2197-51ef-7938-7d49-b8d1679a4802"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ts", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", " ", "6.", ",", " ", "0.04"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"ListLogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"ts", ",", " ", 
          RowBox[{
           RowBox[{"memCoherence", "[", 
            RowBox[{
            "gMem", ",", " ", "\[Kappa]Mem", ",", " ", "\[Alpha]Mem"}], "]"}],
            " ", "/@", " ", "ts"}]}], "}"}], "]"}], ",", "\n", "   ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"ts", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              RowBox[{"\[Alpha]Mem", "^", "2"}], " ", 
              RowBox[{"(", 
               RowBox[{"1", " ", "-", " ", 
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"(", 
                    RowBox[{"4", " ", 
                    RowBox[{
                    RowBox[{"gMem", "^", "2"}], "/", "\[Kappa]Mem"}]}], 
                    ")"}]}], " ", "#"}], "]"}]}], ")"}]}], "]"}], " ", "&"}], 
           " ", "/@", " ", "ts"}]}], "}"}], "]"}], ",", "\n", "   ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"ts", ",", " ", 
          RowBox[{
           RowBox[{"memCoherence", "[", 
            RowBox[{"gMem", ",", " ", "30.", ",", " ", "\[Alpha]Mem"}], "]"}],
            " ", "/@", " ", "ts"}]}], "}"}], "]"}], ",", "\n", "   ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"ts", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              RowBox[{"\[Alpha]Mem", "^", "2"}], " ", 
              RowBox[{"(", 
               RowBox[{"1", " ", "-", " ", 
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"(", 
                    RowBox[{"4", " ", 
                    RowBox[{
                    RowBox[{"gMem", "^", "2"}], "/", "30."}]}], ")"}]}], " ", 
                  "#"}], "]"}]}], ")"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
           "ts"}]}], "}"}], "]"}], ",", "\n", "   ", "memDots"}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"Joined", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "True", ",", " ", "True", ",", " ", "True", ",", " ", "True", ",", " ",
         "False"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "None", ",", " ", "None", ",", " ", "None", ",", " ", "None", ",", " ",
         "Automatic"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", "Dashed"}], "]"}], 
        ",", "\n", "    ", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", "Dashed"}], "]"}], 
        ",", " ", "Black"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<memory, slow bath\>\"", ",", 
        " ", "\"\<its no-memory stand-in\>\"", ",", "\n", 
        "    ", "\"\<memory, fast bath\>\"", ",", 
        " ", "\"\<its no-memory stand-in\>\"", ",", 
        " ", "\"\<two-mode simulation\>\""}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", " ", "\"\<coherence |C(t)| (log)\>\""}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<a bath with memory: flat onset, a revival, and the fast-bath \
limit\>\""}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[33]:= ",
 CellID->769232474,ExpressionUUID->"6e85e9ed-427b-8528-16ba-00b7770fec72"],

