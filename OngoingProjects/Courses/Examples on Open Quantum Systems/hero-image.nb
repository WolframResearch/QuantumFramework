Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"im6", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"gg", " ", "=", " ", "1."}], ",", " ", 
      RowBox[{"om", " ", "=", " ", "3."}]}], "}"}], ",", "\n", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"startsFlat", ",", " ", "startsOrtho", ",", " ", "path"}], 
       "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"startsFlat", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{"flatPair", " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
            RowBox[{"\[CapitalOmega]", " ", "->", " ", "om"}]}], "}"}]}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"startsOrtho", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{"orthPair", " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Gamma]", " ", "->", " ", "gg"}], ",", " ", 
            RowBox[{"\[CapitalOmega]", " ", "->", " ", "om"}]}], "}"}]}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{
        RowBox[{"path", "[", "r0_", "]"}], " ", ":=", " ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"run", " ", "=", " ", 
            RowBox[{"evolveODE", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"om", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Sqrt", "[", "gg", "]"}], " ", "lower"}], "}"}], ",", 
              " ", "r0", ",", " ", "14."}], "]"}]}], "}"}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{
            RowBox[{"blochVector", "[", 
             RowBox[{"run", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
           " ", 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", "14", ",", " ", "0.02"}], "]"}]}]}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"blochPlot", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"path", "[", 
           RowBox[{"densityMatrix", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Cos", "[", 
               RowBox[{"\[Pi]", "/", "8"}], "]"}], ",", " ", 
              RowBox[{
               RowBox[{"E", "^", 
                RowBox[{"(", 
                 RowBox[{"I", " ", 
                  RowBox[{"\[Pi]", "/", "4"}]}], ")"}]}], " ", 
               RowBox[{"Sin", "[", 
                RowBox[{"\[Pi]", "/", "8"}], "]"}]}]}], "}"}], "]"}], "]"}], ",",
           " ", 
          RowBox[{"path", "[", 
           RowBox[{"blochState", " ", "@@", " ", 
            RowBox[{"startsFlat", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", "\n", "    ", 
          RowBox[{"path", "[", 
           RowBox[{"blochState", " ", "@@", " ", 
            RowBox[{"startsFlat", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"path", "[", 
           RowBox[{"blochState", " ", "@@", " ", 
            RowBox[{"startsOrtho", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", "\n", "    ", 
          RowBox[{"path", "[", 
           RowBox[{"blochState", " ", "@@", " ", 
            RowBox[{"startsOrtho", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], "   ", 
        "]"}]}]}], "]"}]}], "]"}]}]], "Input",
