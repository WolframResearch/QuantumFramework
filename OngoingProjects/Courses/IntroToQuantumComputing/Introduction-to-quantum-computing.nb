   RowBox[{"\[ScriptCapitalU]a", "[", 
    RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}], "//", 
   "Eigenvalues"}], "//", "Counts"}]], "Input",
 CellChangeTimes->{{3.9556391027162704`*^9, 3.955639110350794*^9}, {
  3.969311888723947*^9, 3.969311889456221*^9}, {3.969366786651762*^9, 
