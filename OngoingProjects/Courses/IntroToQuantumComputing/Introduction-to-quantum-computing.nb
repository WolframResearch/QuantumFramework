   RowBox[{"ImageSize", "->", "200"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.968768871798225*^9, 3.968768889285179*^9}, 
   3.968770429021459*^9},
 CellLabel->
  "In[362]:=",ExpressionUUID->"4dc3ee9f-9b80-44ce-a5c8-1487c013b53c"],

Cell["\<\
The final step is measurements. Note we only measure n-qubits.\
\>", "Text",
 CellChangeTimes->{{3.9445282484976215`*^9, 3.944528250458273*^9}, {
  3.9445283260740414`*^9, 3.944528334202038*^9}, {3.944528369810005*^9, 
  3.944528372032753*^9}, {3.9687704935758743`*^9, 3.968770497661565*^9}, {
  3.968771175031186*^9, 
  3.968771195081604*^9}},ExpressionUUID->"95464b94-afdd-4766-8580-\
3cdf21b5863c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<BernsteinVazirani\>\"", "[", "secret", "]"}], "]"}], "[", 
   "]"}], "[", 
  RowBox[{"\"\<ProbabilitiesPlot\>\"", ",", 
   RowBox[{"AspectRatio", "->", 
    RowBox[{"1", "/", "3"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9445283381621227`*^9, 3.9445283533869762`*^9}, {
  3.969305241623108*^9, 3.969305251148616*^9}},
 CellLabel->
  "In[363]:=",ExpressionUUID->"ff2687c6-1696-45d8-b579-9bb716ca8b55"],

Cell["\<\
Therefore, the algorithm gives the secret code in only a single query. \
\>", "Text",
 CellChangeTimes->{{3.9687705500642*^9, 3.96877063390655*^9}, {
  3.968770745237624*^9, 3.968770752149634*^9}, {3.9687711968542557`*^9, 
  3.96877120022365*^9}},ExpressionUUID->"e3481f58-1425-462e-9393-\
69bf17c71bd7"],

Cell["\<\
The key feature of the BV algorithm is that the final measurement yields a \
single, definite result, the secret string. While this is elegant in theory, \
in practice, noise can interfere with the algorithm\[CloseCurlyQuote]s \
performance. In the next section, we will briefly discuss the impact of noise.\
\>", "Text",
 CellChangeTimes->{{3.9687705500642*^9, 3.96877063390655*^9}, {
  3.968770745237624*^9, 3.968770752149634*^9}, {3.9687711968542557`*^9, 
  3.968771198272984*^9}},ExpressionUUID->"4ac2f3b5-3b07-4372-a251-\
cce6425d6ff4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Effects of Noise", "Section",
 CellChangeTimes->{{3.9445286499856815`*^9, 
  3.9445286543053513`*^9}},ExpressionUUID->"529c2d5b-881d-4f72-84dd-\
1ea6acf36690"],

Cell["\<\
While solving the problem in only a single query to the quantum oracle is \
possible theoretically, real quantum circuits involve some errors caused by \
various effects. All of the previous circuits you have considered did not \
take this phenomena into account.\
\>", "Text",
 CellChangeTimes->{{3.944529446889372*^9, 3.9445294542113533`*^9}, {
  3.94452949478438*^9, 3.9445295789533825`*^9}, {3.944530811878044*^9, 
  3.9445308289441624`*^9}, {3.9446673639041996`*^9, 
  3.944667422361124*^9}},ExpressionUUID->"16cd7d25-c2d0-4a99-bbfe-\
95a0af8ffc18"],

Cell["\<\
The following circuit defines the BV algorithm but introduces a noise channel \
just before the measurements can be performed. You might imagine this noise \
is from imperfect measurement or from the cumulative effect of previous \
errors in the circuit.\
\>", "Text",
 CellChangeTimes->{{3.944530762392723*^9, 3.944530800480015*^9}, {
  3.944530850727001*^9, 3.9445309026091137`*^9}, {3.944532437877491*^9, 
  3.9445324672937336`*^9}},ExpressionUUID->"ec300622-514c-4cde-bce7-\
edd496356789"],

Cell[BoxData[
 RowBox[{
  RowBox[{"noisyBV", "[", "s_List", "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "s", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<H\>\"", "->", 
         RowBox[{"Range", "[", 
          RowBox[{"n", "+", "1"}], "]"}]}], ",", 
        RowBox[{"\"\<Z\>\"", "->", 
         RowBox[{"n", "+", "1"}]}], ",", 
        RowBox[{"QuantumCircuitOperator", "[", 
         RowBox[{
          RowBox[{"\"\<BernsteinVaziraniOracle\>\"", "[", "s", "]"}], 
          ",", "\"\<BV Oracle\>\""}], "]"}], ",", 
        RowBox[{"\"\<H\>\"", "->", 
         RowBox[{"Range", "[", 
          RowBox[{"n", "+", "1"}], "]"}]}], ",", 
        RowBox[{"Splice", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"QuantumChannel", "[", 
            RowBox[{
             RowBox[{"\"\<Depolarizing\>\"", "[", "p", "]"}], ",", 
             RowBox[{"{", "k", "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}]}], ",", 
        RowBox[{"\"\<M\>\"", "->", 
         RowBox[{"Range", "[", "n", "]"}]}]}], "}"}], ",", 
      RowBox[{"\"\<Parameters\>\"", "->", "p"}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{3.944579707855482*^9, 3.944579954039501*^9},
 CellLabel->
  "In[364]:=",ExpressionUUID->"c351541a-377c-45fc-af4f-bae386d4e7e5"],

Cell["\<\
A noisy version of the previous circuit might look like this:\
\>", "Text",
 CellChangeTimes->{{3.944532509581152*^9, 
  3.944532523897156*^9}},ExpressionUUID->"7690668e-efd5-41bd-ba7f-\
e6861222605c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"noisyBV", "[", "secret", "]"}], "[", "\"\<Diagram\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{3.944528942854639*^9, 3.944528956891041*^9}, {
  3.9445290769775047`*^9, 3.9445290936972027`*^9}, {3.9445291753540096`*^9, 
  3.9445291780247383`*^9}, {3.944531505564335*^9, 3.9445315069127903`*^9}},
 CellLabel->
  "In[365]:=",ExpressionUUID->"043f2db8-59d6-4c07-b3b3-dfbece22b65b"],

Cell["\<\
Notice that the measurement distribution now depends on the probability of \
the noise channels affecting each qubit:\
\>", "Text",
 CellChangeTimes->{{3.9445325279574375`*^9, 
  3.9445325651900444`*^9}},ExpressionUUID->"ca1fb9a3-4c22-4f33-adf2-\
b6fcc9025314"],

Cell[BoxData[
 RowBox[{"noisymeasurement", "=", 
  RowBox[{
   RowBox[{"noisyBV", "[", "secret", "]"}], "[", "]"}]}]], "Input",
 CellChangeTimes->{{3.9445291154997635`*^9, 3.9445291165832615`*^9}, {
   3.9445292298807735`*^9, 3.944529251472847*^9}, 3.944531540609661*^9, {
   3.9445316905161266`*^9, 3.944531720726225*^9}},
 CellLabel->
  "In[366]:=",ExpressionUUID->"33e17d9d-2ace-4de3-89f8-450a3b7a8aaa"],

Cell["\<\
If the so-called depolarizing noise channels affect the qubits with \
probability under 5%, the chance of returning the secret code is still quite \
high:\
\>", "Text",
 CellChangeTimes->{{3.944532588077875*^9, 3.944532648493618*^9}, {
  3.9445329417170105`*^9, 
  3.944532945532709*^9}},ExpressionUUID->"41ecebae-1182-4f8f-a266-\
7337c81487c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"noisymeasurement", "[", 
   RowBox[{"<|", 
    RowBox[{"p", "->", "0.3"}], "|>"}], "]"}], "[", 
  RowBox[{"\"\<ProbabilitiesPlot\>\"", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["3", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["552", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    AspectRatio -> 1/4, PlotRange -> {All, 1}, PlotLabel -> 
     "BV algorithm, with 30% chance of single-qubit depolarization"],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellChangeTimes->{{3.9445292733435745`*^9, 3.9445292840167465`*^9}, {
   3.944531603623705*^9, 3.9445316157575912`*^9}, 3.9445326090150833`*^9, 
   3.944532906974825*^9, 3.9445329376084538`*^9, {3.9693053268055887`*^9, 
   3.9693053435204782`*^9}, {3.969542941255986*^9, 3.969542945490291*^9}, {
   3.969542979168777*^9, 3.969543046764255*^9}},
 CellLabel->
  "In[367]:=",ExpressionUUID->"1b063edf-8d5a-4bb5-94f7-ce5001e19ca0"],

Cell["\<\
The following animation shows the effect of increasing the depolarizing \
probability:\
\>", "Text",
 CellChangeTimes->{{3.9445329680132732`*^9, 
  3.9445329821738377`*^9}},ExpressionUUID->"373fc92b-d3b4-4ffb-92c2-\
e5ba88fd84ba"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fps", "=", "20.0"}], ",", 
     RowBox[{"dur", "=", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ListAnimate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Rasterize", "@", 
        RowBox[{
         RowBox[{"noisymeasurement", "[", "prob", "]"}], "[", 
         RowBox[{"\"\<ProbabilitiesPlot\>\"", ",", 
          RowBox[{"AspectRatio", "->", 
           RowBox[{"1", "/", "4"}]}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{"All", ",", "1"}], "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"\"\<Error rate is \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"PercentForm", "@", "prob"}], "]"}]}]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"prob", ",", "0", ",", "1", ",", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"dur", "*", "fps"}], ")"}]}]}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "fps", ",", 
     RowBox[{"ControlPlacement", "->", "Top"}], ",", 
     RowBox[{"AnimationRunning", "->", "False"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9445317492844296`*^9, 3.9445318483845043`*^9}, {
   3.944531880037861*^9, 3.944531880214655*^9}, {3.9445319126588707`*^9, 
   3.944531968662033*^9}, {3.944532039136362*^9, 3.944532070296236*^9}, {
   3.9445321007670536`*^9, 3.944532142846676*^9}, {3.9445321731193085`*^9, 
   3.944532280287384*^9}, {3.9445323553930073`*^9, 3.944532356408119*^9}, {
   3.94453239680072*^9, 3.9445323970230217`*^9}, {3.944533022871561*^9, 
   3.9445330647502747`*^9}, 3.969305375818469*^9, {3.969305582755542*^9, 
   3.969305658767503*^9}, {3.969543066579129*^9, 3.969543069426396*^9}},
 CellLabel->
  "In[368]:=",ExpressionUUID->"7bc07650-cad5-4ae5-bfcd-1d7a20107ca9"],

Cell["\<\
As the noise rate increases, the probability of the intended outcome \
decreases. When noise reaches its maximum level, all outcomes occur with \
equal probability, meaning the noise effectively randomizes or smears the \
distribution of results.\
\>", "Text",
 CellChangeTimes->{{3.969542851270503*^9, 
  3.969542925380229*^9}},ExpressionUUID->"f63b1ebd-65af-4049-9025-\
b6b904596471"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Grover Search Algorithm", "Chapter",
 CellChangeTimes->{{3.9458857100891*^9, 3.9458857172175865`*^9}, 
   3.946920764551115*^9},ExpressionUUID->"9b231667-6f25-4fe1-a855-\
c769fb6d7bbf"],

Cell[TextData[{
 "Grover\[CloseCurlyQuote]s algorithm provides a quadratic speedup for \
unstructured search, locating a marked item in a database of size \
\[ScriptCapitalN] with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalO]", "(", 
    SqrtBox["\[ScriptCapitalN]"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "adf3859d-a3a4-4d8c-8b59-98e88b273f24"],
 " queries. Starting from a uniform superposition, it iteratively applies an \
oracle that flips the phase of solutions and a diffusion operator, amplifying \
the target amplitude. After ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[TildeTilde]", 
    RowBox[{
     FractionBox["\[Pi]", "4"], 
     SqrtBox[
      RowBox[{"\[ScriptCapitalN]", "/", "\[ScriptCapitalM]"}]]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "78230af6-4120-4437-8814-a5b0ee14c79e"],
 " iterations for \[ScriptCapitalM] solutions, measurement yields a correct \
answer with high probability. We outline the Grover algorithm in a \
step-by-step manner, and explain its details."
}], "Text",
 CellChangeTimes->{{3.9688463210913486`*^9, 3.9688463245505047`*^9}, {
  3.969218203388969*^9, 3.9692182051137114`*^9}, {3.969310592926993*^9, 
  3.9693107816500607`*^9}},ExpressionUUID->"412bbcbb-b122-4339-9e8f-\
b36273dd417b"],

Cell[CellGroupData[{

Cell["Key Concepts", "Section",
 CellChangeTimes->{{3.9458857262477703`*^9, 
  3.945885728184759*^9}},ExpressionUUID->"4ae8ae27-e0a6-43f5-a0ce-\
ea0488d9cd9b"],

Cell["Boolean function", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, {
  3.9459508180356083`*^9, 
  3.9459508219695263`*^9}},ExpressionUUID->"83e7cdb4-7ebb-4f8a-9ef1-\
3ca9dac9bc1a"],

Cell["Grover Boolean oracle", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, 
   3.945966437091715*^9, {3.968857663991075*^9, 
   3.96885766898508*^9}},ExpressionUUID->"3263aac9-8fe8-47de-b21f-\
5912ee0fb265"],

Cell["Grover Phase oracle", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, 
   3.945966437091715*^9, {3.968857663991075*^9, 
   3.9688576746643963`*^9}},ExpressionUUID->"72750549-171d-40dc-b686-\
b03b7747f333"],

Cell["Grover diffusion", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, 
   3.945966437091715*^9, {3.968857663991075*^9, 
   3.968857682076584*^9}},ExpressionUUID->"cd1bec4a-27e0-485c-adeb-\
ddccf7c648e6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Statement of the Grover Search Problem", "Section",
 CellChangeTimes->{{3.945885737320423*^9, 
  3.9458857635147285`*^9}},ExpressionUUID->"e9ea6671-c2a4-4489-bb02-\
760ef813b920"],

Cell["\<\
Grover\[CloseCurlyQuote]s search is a core quantum algorithm. The task: given \
a Boolean function on n-bit inputs with one or more marked inputs (where the \
function returns True), find a marked input using as few oracle queries as \
possible. \
\>", "Text",
 CellChangeTimes->{{3.9458954141286793`*^9, 3.9458954729607143`*^9}, {
   3.945895577434923*^9, 3.9458955775205803`*^9}, {3.968846336998407*^9, 
   3.9688463812303753`*^9}, {3.968853386201831*^9, 3.968853388686425*^9}, {
   3.968853457558463*^9, 3.9688534636095*^9}, 3.969309641628729*^9, {
   3.969309672179229*^9, 
   3.96930968572434*^9}},ExpressionUUID->"12887aa0-4e59-4536-9dfd-\
480bcff9e334"],

Cell["Define a Boolean function", "Text",
 CellChangeTimes->{{3.8624476895976*^9, 3.862447711656227*^9}, {
   3.9688472659255943`*^9, 3.9688472661836243`*^9}, 
   3.969309644082445*^9},ExpressionUUID->"cf206e2f-85e3-40e6-8347-\
b35fc2d839b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"boo", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"q1", "&&", "q2", "&&", "q3", "&&", 
      RowBox[{"!", "q4"}], "&&", 
      RowBox[{"!", "q5"}]}], ")"}], "||", 
    RowBox[{"(", 
     RowBox[{"q1", "&&", "q3", "&&", "q4", "&&", "q5"}], ")"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.862447660514966*^9, 3.862447668176383*^9}, {
   3.968847270946198*^9, 3.968847284843588*^9}, {3.9688520520678177`*^9, 
   3.968852052250772*^9}, {3.968852297204131*^9, 3.9688522973562937`*^9}, {
   3.968852689273678*^9, 3.968852733357477*^9}, {3.968852784219697*^9, 
   3.968852785152432*^9}, {3.968852902134931*^9, 3.968852930829356*^9}, {
   3.968853307966941*^9, 3.9688533364413757`*^9}, {3.968853401922246*^9, 
   3.968853432396339*^9}, {3.968853727630328*^9, 3.96885374172904*^9}, 
   3.968853843114307*^9},
 CellLabel->
  "In[369]:=",ExpressionUUID->"6c67c1bf-36a7-4948-bc53-f9cf6b0f253c"],

Cell["Now let\[CloseCurlyQuote]s examine its truth table:", "Text",
 CellChangeTimes->{{3.862447725147872*^9, 3.8624477306550493`*^9}, {
  3.968855036758091*^9, 3.968855056088522*^9}, {3.969309662039298*^9, 
  3.969309667096121*^9}},ExpressionUUID->"d52d3456-b05a-4886-94a5-\
cdeccee76a05"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ResourceFunction", "[", "\"\<TruthTable\>\"", "]"}], "[", 
  RowBox[{"boo", ",", 
   RowBox[{"{", 
    RowBox[{"q1", ",", "q2", ",", "q3", ",", "q4", ",", "q5"}], "}"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.862447671317814*^9, 3.8624476844044533`*^9}, {
  3.968847381408586*^9, 3.968847382253477*^9}, {3.968852718265239*^9, 
  3.968852719261693*^9}, {3.9688529160553303`*^9, 3.968852916564205*^9}, {
  3.9688533165347853`*^9, 3.968853341067621*^9}, {3.968853407771256*^9, 
  3.9688534092965*^9}},
 CellLabel->
  "In[370]:=",ExpressionUUID->"1fc84354-0d00-4035-9166-7512b382afe9"],

Cell["\<\
Let\[CloseCurlyQuote]s count the number of possible combinations of variable \
values that yield True when supplied as arguments to the Boolean function\
\>", "Text",
 CellChangeTimes->{{3.9688535160680637`*^9, 
  3.9688535354861107`*^9}},ExpressionUUID->"43b6b0da-9d04-42c4-a785-\
a4b6b76c1f35"],

Cell[BoxData[
 RowBox[{"\[ScriptCapitalM]", "=", 
  RowBox[{"SatisfiabilityCount", "[", "boo", "]"}]}]], "Input",
 CellChangeTimes->{{3.968853473980296*^9, 3.968853494215549*^9}, {
  3.968853612115259*^9, 3.968853627726604*^9}},
 CellLabel->
  "In[371]:=",ExpressionUUID->"7f6fc476-729b-4c31-ab90-54d1429ba0e1"],

Cell[TextData[{
 "The total number of combinations is ",
 Cell[BoxData[
  FormBox["32", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f1daa1ee-f95c-4772-9dea-366a8a9bd1dd"],
 " (since 5 binary variables yield ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "5"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dfbf9d57-6833-4809-9f1c-1eec855d05c2"],
 "). In general, n binary variables give ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "n"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a8901bc1-7966-4fb2-ac3d-cfcaef2e01b2"],
 " combinations."
}], "Text",
 CellChangeTimes->{{3.968853542114811*^9, 3.968853593675501*^9}, {
   3.9688536344481153`*^9, 3.968853684403501*^9}, {3.9688544302563334`*^9, 
   3.9688544340196657`*^9}, 3.9688552319518213`*^9, {3.969309730895514*^9, 
   3.96930975911409*^9}},ExpressionUUID->"197253cf-231b-4405-a8db-\
4028c2bfc688"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalN]", "=", 
   SuperscriptBox["2", "5"]}], ";"}]], "Input",
 CellLabel->
  "In[372]:=",ExpressionUUID->"14a5fdf2-cbce-4783-808a-2e9723d2afdf"],

Cell[TextData[{
 "Therefore, if you try to guess the solution, your first guess will only be \
correct with the probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalM]", "/", "\[ScriptCapitalN]"}], TraditionalForm]],
  ExpressionUUID->"9a02fa52-1b2e-4689-ad13-9800db69c6e6"],
 " which is around 9%:"
}], "Text",
 CellChangeTimes->{{3.968853542114811*^9, 3.968853593675501*^9}, {
  3.9688536344481153`*^9, 3.968853684403501*^9}, {3.9688544302563334`*^9, 
  3.9688544340196657`*^9}},ExpressionUUID->"b681600f-87f5-46f7-a556-\
22bbf9706617"],

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{"\[ScriptCapitalM]", "/", "\[ScriptCapitalN]"}], "]"}]], "Input",
 CellChangeTimes->{{3.968853699805052*^9, 3.96885371536064*^9}, {
  3.968853859402267*^9, 3.9688538598249693`*^9}, {3.9688544067851133`*^9, 
  3.9688544212406883`*^9}, {3.968855229437393*^9, 3.9688552349109497`*^9}},
 CellLabel->
  "In[373]:=",ExpressionUUID->"92651d1a-7874-4533-9e92-19b7d55cc8be"],

Cell[TextData[{
 "However, if your first guess was incorrect, on your second guess, you \
should not repeat the first one (since you will already know the status of \
your first guess). Thus, the probability to guess correctly will be ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[ScriptCapitalM]", 
    RowBox[{"\[ScriptCapitalN]", "-", "1"}]], TraditionalForm]],
  ExpressionUUID->"32b942fd-4e41-42a2-81e3-bf0f89a12425"],
 " on the second guess. After you guess ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalN]", "-", "\[ScriptCapitalM]"}], TraditionalForm]],
  ExpressionUUID->"64f43f21-ba39-4744-8c36-672a14f89669"],
 " times, you are certain to know one of solutions. You could summarize the \
probability of at least one success within ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "c1e7f1c6-c84a-4562-b5cc-43f85fbd7c7d"],
 " tries as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["P", "success"], "(", "k", ")"}], "=", 
    RowBox[{"1", "-", 
     RowBox[{
      RowBox[{"(", GridBox[{
         {
          RowBox[{"\[ScriptCapitalN]", "-", "\[ScriptCapitalM]"}]},
         {"k"}
        }], ")"}], "/", 
      RowBox[{"(", GridBox[{
         {"\[ScriptCapitalN]"},
         {"k"}
        }], ")"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "21e77474-4124-479d-a806-31bfc8d9b007"],
 ". Note that ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "1e4e4d26-3553-4575-8d3a-fce0ba1913e2"],
 " is the number of times you tested the Boolean function, and by the time \
that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", 
    RowBox[{"\[ScriptCapitalN]", "-", "\[ScriptCapitalM]", "-", "1"}]}], 
   TraditionalForm]],ExpressionUUID->"db518a0a-7fa9-4c06-9a8b-03d03c09c32e"],
 ",  either you will have guessed the correct number or you will have \
eliminated all incorrect options."
}], "Text",
 CellChangeTimes->{{3.945896844991522*^9, 3.945896882824234*^9}, {
  3.9458969388564796`*^9, 3.9458969661679077`*^9}, {3.945897075032751*^9, 
  3.945897139744007*^9}, {3.945897187432377*^9, 3.9458973586320705`*^9}, {
  3.9459497600393047`*^9, 3.9459497748313065`*^9}, {3.9688538711661863`*^9, 
  3.968853939237831*^9}, {3.96885510742458*^9, 3.9688551358894863`*^9}, {
  3.969309774079401*^9, 
  3.969309818236915*^9}},ExpressionUUID->"150d7f9b-620a-4a20-9534-\
e30101a05ee7"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"Binomial", "[", 
           RowBox[{
            RowBox[{"\[ScriptCapitalN]", "-", "\[ScriptCapitalM]"}], ",", 
            "k"}], "]"}], 
          RowBox[{"Binomial", "[", 
           RowBox[{"\[ScriptCapitalN]", ",", "k"}], "]"}]]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", 
        RowBox[{"\[ScriptCapitalN]", "-", "\[ScriptCapitalM]", "-", "1"}]}], 
       "}"}]}], "]"}], "}"}], ",", 
   RowBox[{"Joined", "->", "True"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Oracle Queries\>\"", ",", "\"\<Success Chance\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", "\"\<Classical\>\"", "}"}]}], ",", 
   RowBox[{"GridLines", "->", "Automatic"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9458979219631786`*^9, 3.945897933647394*^9}, {
  3.945949499841463*^9, 3.9459495941214466`*^9}, {3.968854380751045*^9, 
  3.968854394558873*^9}, {3.968854524201117*^9, 3.968854547405861*^9}, {
  3.968854700316372*^9, 3.968854719023164*^9}, {3.9688549458833513`*^9, 
  3.96885501891262*^9}, {3.968855150926318*^9, 3.968855153057708*^9}},
 CellLabel->
  "In[374]:=",ExpressionUUID->"44c9be1d-bf1b-4eb6-8c10-d45cdc68d6ee"],

Cell["\<\
Grover\[CloseCurlyQuote]s key advantage can be illustrated as follows: by \
repeating the Grover circuit twice, the success probability can reach 100%, \
whereas a comparable classical strategy is about 20%.\
\>", "Text",
 CellChangeTimes->{{3.968855286142404*^9, 3.9688552995523443`*^9}, {
  3.968855331466374*^9, 
  3.968855387691145*^9}},ExpressionUUID->"82f06c79-cbbd-4eb3-b7fa-\
aabbd53ff7a4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "groverSuccess", "]"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"groverSuccess", "[", 
    RowBox[{"N_", ",", "M_", ",", "k_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "k"}], "+", "1"}], ")"}], 
      RowBox[{"ArcCos", "[", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", "-", 
         RowBox[{"M", "/", "N"}]}], "]"}], "]"}]}], "]"}], "^", "2"}]}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"Binomial", "[", 
            RowBox[{
             RowBox[{"\[ScriptCapitalN]", "-", "\[ScriptCapitalM]"}], ",", 
             "k"}], "]"}], 
           RowBox[{"Binomial", "[", 
            RowBox[{"\[ScriptCapitalN]", ",", "k"}], "]"}]]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "2"}], "}"}]}], "]"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"groverSuccess", "[", 
          RowBox[{"\[ScriptCapitalN]", ",", "\[ScriptCapitalM]", ",", "k"}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"Joined", "->", "True"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Oracle Queries\>\"", ",", "\"\<Success Chance\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Classical\>\"", ",", "\"\<Grover\>\""}], "}"}]}], ",", 
   RowBox[{"GridLines", "->", "Automatic"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9458979219631786`*^9, 3.945897933647394*^9}, {
  3.945949499841463*^9, 3.9459495941214466`*^9}, {3.968854380751045*^9, 
  3.968854394558873*^9}, {3.968854524201117*^9, 3.968854547405861*^9}, {
  3.968854700316372*^9, 3.968854719023164*^9}, {3.9688549458833513`*^9, 
  3.96885501891262*^9}, {3.968855281565393*^9, 3.9688552834816008`*^9}, {
  3.968855315123797*^9, 3.9688553162917852`*^9}, {3.9693101273798323`*^9, 
  3.969310129816413*^9}},
 CellLabel->
  "In[375]:=",ExpressionUUID->"ae5fa70b-80ae-491d-b089-525f024d1d61"],

Cell["\<\
Another subtlety of Grover\[CloseCurlyQuote]s algorithm is that there is an \
optimal number of Grover iterations to maximize the success probability. As \
the illustration shows, the classical success probability increases \
monotonically with more queries, while Grover\[CloseCurlyQuote]s success \
oscillates and can decrease if you go past the optimum.\
\>", "Text",
 CellChangeTimes->{{3.968855424107283*^9, 
  3.968855501630913*^9}},ExpressionUUID->"16a420f1-9ffa-46bf-a1aa-\
cdbdf0e2ea30"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"1", "-", 
           FractionBox[
            RowBox[{"Binomial", "[", 
             RowBox[{
              RowBox[{"\[ScriptCapitalN]", "-", "\[ScriptCapitalM]"}], ",", 
              "k"}], "]"}], 
            RowBox[{"Binomial", "[", 
             RowBox[{"\[ScriptCapitalN]", ",", "k"}], "]"}]]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "10"}], "}"}]}], "]"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"groverSuccess", "[", 
           RowBox[{"\[ScriptCapitalN]", ",", "\[ScriptCapitalM]", ",", "k"}], 
           "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "10"}], "}"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"Joined", "->", "True"}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Oracle Queries\>\"", ",", "\"\<Success Chance\>\""}], 
      "}"}]}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Classical\>\"", ",", "\"\<Grover\>\""}], "}"}]}], ",", 
    RowBox[{"GridLines", "->", "Automatic"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9458979219631786`*^9, 3.945897933647394*^9}, {
  3.945949499841463*^9, 3.9459495941214466`*^9}, {3.968854380751045*^9, 
  3.968854394558873*^9}, {3.968854524201117*^9, 3.968854547405861*^9}, {
  3.968854700316372*^9, 3.968854719023164*^9}, {3.9688549458833513`*^9, 
  3.96885501891262*^9}, {3.968855281565393*^9, 3.9688552834816008`*^9}, {
  3.968855315123797*^9, 3.9688553162917852`*^9}, {3.968855401853656*^9, 
  3.96885541758648*^9}},
 CellLabel->
  "In[378]:=",ExpressionUUID->"caa49ef3-19bb-41b8-8235-236ef67871c1"],

Cell["\<\
Let\[CloseCurlyQuote]s dive in and examine the details of Grover\
\[CloseCurlyQuote]s algorithm. We will set up the register, define the \
oracle, apply the Grover iterate (oracle plus diffusion), and analyze how \
repeated iterations amplify the marked states to enable high-probability \
retrieval of the solution.\
\>", "Text",
 CellChangeTimes->{{3.968855521647751*^9, 
  3.968855546714697*^9}},ExpressionUUID->"b94f065c-9bf6-467d-9b05-\
64c8b7c3d904"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Grover oracle", "Section",
 CellChangeTimes->{{3.968846834338876*^9, 
  3.968846836764799*^9}},ExpressionUUID->"4ecd83dc-d430-4e63-9497-\
ec16ed239e83"],

Cell["\<\
Grover\[CloseCurlyQuote]s algorithm commonly uses two oracle types: the \
Boolean oracle and the phase oracle. Both encode information about the \
solution to a Boolean function. In the Boolean oracle, the solution is \
written to an ancillary (target) qubit. In the phase oracle, there is no \
ancilla; the solution is encoded in the phase. Let\[CloseCurlyQuote]s examine \
them in more details.\
\>", "Text",
 CellChangeTimes->{{3.968849422779771*^9, 3.968849439359926*^9}, {
  3.96885049804207*^9, 
  3.9688505776184187`*^9}},ExpressionUUID->"fb19ed5c-e0e0-4aef-87f6-\
20e1e1ff2e45"],

Cell[CellGroupData[{

Cell["Boolean oracle", "Subsection",
 CellChangeTimes->{{3.862446621602524*^9, 3.86244664184589*^9}, 
   3.96884685079358*^9, 3.968846968853753*^9, 
   3.968849447429528*^9},ExpressionUUID->"c58d8f36-bdf7-400d-9801-\
030af107ff49"],

Cell[TextData[{
 "The action of a Boolean oracle can be described as follows: it maps the \
state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"x"},
     "Ket"], 
    TemplateBox[{"q"},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "f7ba15bb-672a-41f1-85f8-8fec9eb3db3b"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"x"},
     "Ket"], 
    TemplateBox[{
      RowBox[{"q", "\[CirclePlus]", 
        RowBox[{"f", 
          RowBox[{"(", "x", ")"}]}]}]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "bf1b81b1-5e1a-4263-aed8-95c96732f655"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"x"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "bfe38ec4-322a-4a7c-b41d-8912a8fae1c5"],
 " represents the n-qubit index register and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"q"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "e3efeedd-b6ca-403d-a0fc-3ef8c5fde88b"],
 " is an ancillary qubit holding the result of the Boolean function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "6afb9bab-6f72-4ec0-ad8f-35d48ee40394"],
 ". In this setup, if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"q"},
     "Ket"], "=", 
    TemplateBox[{"0"},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "29c70c40-f225-4848-9970-afe4a74b55db"],
 ", it flips to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"1"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "aee6315e-7eaa-4443-af5e-567eb27a9d79"],
 " when ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "f64420d7-2c00-4c60-8c01-f4657c5f2c49"],
 " satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "e5e0427f-f8f0-4945-9b11-77b36d398e8c"],
 "; otherwise, it remains unchanged. In other words, this oracle writes the \
value ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "9f5ad5be-c319-4685-9b1d-6aa7fb1d8bc0"],
 " into a target qubit by XORing it into ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"q"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "e89b19b4-cf66-459b-a8f6-ea8ed9fb8a20"],
 "."
}], "Text",
 CellChangeTimes->{{3.968847063757197*^9, 
  3.968847183786602*^9}},ExpressionUUID->"cd3203a5-d699-43f6-b0ef-\
9fcc62a37f90"],

Cell["\<\
Using the previous truth table, we can reproduce it with a quantum Boolean \
oracle. The oracle leaves the index register unchanged and flips the \
ancillary qubit exactly for inputs that satisfy the Boolean function, \
matching the table.\
\>", "Text",
 CellChangeTimes->{{3.968847490272461*^9, 3.9688475154335623`*^9}, {
  3.968855568640821*^9, 
  3.96885559776525*^9}},ExpressionUUID->"355258ef-d77e-484f-b0b4-\
ceab48d1193a"],

Cell["\<\
First, generate the corresponding Boolean oracle\[CloseCurlyQuote]s quantum \
circuit:\
\>", "Text",
 CellChangeTimes->{{3.8624477490954523`*^9, 3.862447765493132*^9}, {
  3.90587739906973*^9, 3.9058774000251427`*^9}, {3.968847394709103*^9, 
  3.968847399814518*^9}, {3.9688474947243547`*^9, 
  3.968847496792995*^9}},ExpressionUUID->"35702cb7-fc4b-4b86-bb33-\
ffd38e58b1ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"oracle", "=", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<BooleanOracle\>\"", "[", "boo", "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.86244664607685*^9, 3.86244667132006*^9}, {
  3.862447734121641*^9, 3.862447741230069*^9}, {3.968847413412463*^9, 
  3.968847420289173*^9}},
 CellLabel->
  "In[379]:=",ExpressionUUID->"4056659c-07e8-4c05-942f-8879f8dbc113"],

Cell["The diagram of the Boolean oracle:", "Text",
 CellChangeTimes->{{3.862447767987982*^9, 3.862447771754998*^9}, {
  3.968847407835539*^9, 
  3.968847410138857*^9}},ExpressionUUID->"4481cc40-cc4b-4a38-8598-\
ef886d9267fd"],

Cell[BoxData[
 RowBox[{"oracle", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "->", "100"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.862447742864951*^9, 3.8624477457837667`*^9}, {
  3.86244779557655*^9, 3.862447829784195*^9}, {3.9688474265535793`*^9, 
  3.968847431364656*^9}, {3.968848438348633*^9, 3.968848485984436*^9}},
 CellLabel->
  "In[380]:=",ExpressionUUID->"4c1a0204-021b-452c-bf86-2f9ee1efe999"],

Cell[TextData[{
 "We initialize qubit 6 in the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"0"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "f1339e2c-4cf1-4310-94b0-3f67f429c46c"],
 " state, and will use qubits 1-5 as the index register. To match the \
truth table, we will generate the index states ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"x"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "153ecd04-fdc2-480c-9d38-a0acee39a04c"],
 " in descending order, from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       SuperscriptBox["2", "n"], "-", "1"}]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "b9fb6de0-083f-4ef1-8dff-b18ef687a140"],
 " down to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"0"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "0bce5358-557f-48a9-8139-29172091e464"],
 "."
}], "Text",
 CellChangeTimes->{{3.86244786827796*^9, 3.8624479030329523`*^9}, {
  3.862448150303897*^9, 3.862448201268702*^9}, {3.905877486232189*^9, 
  3.905877497669455*^9}, {3.9688474492227983`*^9, 3.968847471807226*^9}, {
  3.96884753538031*^9, 3.968847550045609*^9}, {3.968847599424932*^9, 
  3.968847652412031*^9}, {3.968857728676306*^9, 
  3.9688577317610817`*^9}},ExpressionUUID->"69dfe188-54c4-4942-9a35-\
2e8738fced7e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{
    RowBox[{"oracle", "[", "\"\<Width\>\"", "]"}], "-", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"states", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumTensorProduct", "[", 
      RowBox[{"#", ",", 
       RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}]}], "]"}], "&"}], "/@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"\"\<Register\>\"", "[", 
        RowBox[{"n", ",", "i"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{
         RowBox[{"2", "^", "n"}], "-", "1"}], ",", "0", ",", 
        RowBox[{"-", "1"}]}], "}"}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.8624478636287603`*^9, 3.8624478654616623`*^9}, {
  3.862447909338949*^9, 3.8624479443255663`*^9}, {3.862448140616975*^9, 
  3.862448144927473*^9}, {3.968847654389969*^9, 3.9688476579378033`*^9}, {
  3.96885564349572*^9, 3.968855667303933*^9}},
 CellLabel->
  "In[381]:=",ExpressionUUID->"42e39929-5cc4-4b2b-a44f-e52b0446af51"],

Cell["Show how the oracle transforms states:", "Text",
 CellChangeTimes->{{3.862447949672694*^9, 3.862447973845368*^9}, {
  3.905877463471225*^9, 3.905877475535537*^9}, {3.968847699775013*^9, 
  3.968847718738027*^9}, {3.968848272012999*^9, 3.968848276065769*^9}, {
  3.9688485262946177`*^9, 3.968848528024392*^9}, {3.968849831299201*^9, 
  3.968849844093071*^9}, {3.9688500456244583`*^9, 
  3.968850054837479*^9}},ExpressionUUID->"7986a6f7-7dd0-4009-a6da-\
c8d62f7b80b8"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Riffle", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"oracle", "[", 
       RowBox[{"\"\<Diagram\>\"", ",", 
        RowBox[{"ImageSize", "->", "120"}], ",", 
        RowBox[{"\"\<WireLabels\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"n", "+", "1"}], 
           "->", "\"\<\!\(\*TemplateBox[{\"0\"},\"Ket\"]\)\>\""}], "}"}]}]}], 
       "]"}], ",", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"TableForm", "[", 
           RowBox[{"#", ",", 
            RowBox[{"TableHeadings", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"None", ",", " ", 
               RowBox[{"{", 
                RowBox[{"\"\<\!\(\*Cell[TextData[Cell[BoxData[FormBox[
TemplateBox[{
RowBox[{\"x\", \",\", \"0\"}]},\"Ket\"], \
TraditionalForm]],ExpressionUUID->\"f695eb25-ab37-48ae-a120-fbb4fcc9ec6f\"]],\
ExpressionUUID->\"37994f2c-6a11-44ab-84eb-8aa7b5ca5f4f\"]\)\>\"", 
                 ",", "\"\<\!\(\*Cell[TextData[Cell[BoxData[FormBox[RowBox[{
SubscriptBox[\"U\", \"oracle\"], 
TemplateBox[{
RowBox[{\"x\", \",\", \"0\"}]},\"Ket\"]}], TraditionalForm]],ExpressionUUID->\
\"d4d75258-effa-4e21-8d04-422ae6d6d0f1\"]],ExpressionUUID->\"9f75260a-1c9a-\
4ede-b464-c8551788c496\"]\)\>\""}], "}"}]}], "}"}]}]}], "]"}], "&"}], "/@", 
         RowBox[{"Partition", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"TraditionalForm", "/@", "states"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"TraditionalForm", "[", 
                 RowBox[{"oracle", "[", "#", "]"}], "]"}], "&"}], "/@", 
               "states"}]}], "}"}], "]"}], ",", "10"}], "]"}]}], ")"}]}]}], 
     "}"}], ",", "\"\<   \>\""}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.968848178648801*^9, 3.968848230116467*^9}, {
  3.968848283036941*^9, 3.9688483281356697`*^9}, {3.968848358856203*^9, 
  3.96884842139848*^9}, {3.968848490243825*^9, 3.96884851912607*^9}, {
  3.968848592123972*^9, 3.96884859227697*^9}, {3.968849610378169*^9, 
  3.9688496238431997`*^9}, {3.968849765506486*^9, 3.9688498096553173`*^9}, {
  3.968855616070301*^9, 3.968855617274542*^9}, {3.9688556727731123`*^9, 
  3.968855684978424*^9}, {3.968855720685892*^9, 3.968855812006974*^9}},
 CellLabel->
  "In[383]:=",ExpressionUUID->"43392934-1337-4ed9-8162-1b5aed8d614b"],

Cell["\<\
As one can see, the Boolean oracle circuit reproduce the same result as the \
classical ones.\
\>", "Text",
 CellChangeTimes->{{3.8624482120525723`*^9, 3.862448241410914*^9}, {
  3.90587744066495*^9, 
  3.9058774416096277`*^9}},ExpressionUUID->"a3877841-5ae2-486b-a4f9-\
598a149949fb"],

Cell[TextData[{
 "If the initial state of the ancillary qubit is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"-"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "fe1edb8f-c1d8-4357-999f-4c8862800f0a"],
 ", the overall effect of the oracle will be adding - sign in front of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"x"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "c43e471d-047b-4dde-83b7-4c94e66d592a"],
 " with ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "84ef95bd-6c33-45ec-93f7-28add1863d5a"],
 " the solution of Boolean function. Let\[CloseCurlyQuote]s check that. First \
prepare qubit 1-5 in the register states and the target ancillary qubit in \
the minus state. This can be done by applying NOT gate and then Hadamard gate \
on the target qubit (qubit 6), using the states we had previously:"
}], "Text",
 CellChangeTimes->{{3.86251457924642*^9, 3.862514614051524*^9}, 
   3.862570763712565*^9, {3.905877449466477*^9, 3.905877455636704*^9}, {
   3.905877515544176*^9, 3.905877516463683*^9}, {3.9688477472574987`*^9, 
   3.9688477784588842`*^9}, {3.9688478259045057`*^9, 3.968847859242495*^9}, {
   3.9688485455175962`*^9, 3.9688485477532377`*^9}, {3.968849862170988*^9, 
   3.968849907633396*^9}, {3.9688577404763412`*^9, 3.96885774198212*^9}, {
   3.971797293184272*^9, 
   3.971797293453258*^9}},ExpressionUUID->"ecbed042-e96f-46a8-a426-\
a0e7b4286bea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"statesMinus", "=", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<X\>\"", "->", 
        RowBox[{"n", "+", "1"}]}], ",", 
       RowBox[{"\"\<H\>\"", "->", 
        RowBox[{"n", "+", "1"}]}]}], "}"}], "]"}], "/@", "states"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.862514629248292*^9, 3.862514631993812*^9}, {
   3.9058776009037046`*^9, 3.905877651114575*^9}, 3.96884879539939*^9, {
   3.968849656362331*^9, 3.968849693481676*^9}, 3.968849734426087*^9, 
   3.9688498531972113`*^9, {3.968855822344137*^9, 3.968855825591298*^9}},
 CellLabel->
  "In[384]:=",ExpressionUUID->"82d71c37-b901-4091-8012-51da75739e46"],

Cell["\<\
Show the effect of the Boolean oracle on the new initial states:\
\>", "Text",
 CellChangeTimes->{{3.9688490568930283`*^9, 3.968849080534265*^9}, {
  3.968849934762171*^9, 
  3.9688499351210747`*^9}},ExpressionUUID->"afdfa4f8-0e14-495b-9ae8-\
958ab672f0b1"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Riffle", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"oracle", "[", 
       RowBox[{"\"\<Diagram\>\"", ",", 
        RowBox[{"ImageSize", "->", "120"}], ",", 
        RowBox[{"\"\<WireLabels\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"n", "+", "1"}], 
           "->", "\"\<\!\(\*TemplateBox[{\"-\"},\"Ket\"]\)\>\""}], "}"}]}]}], 
       "]"}], ",", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"TableForm", "[", 
           RowBox[{"#", ",", 
            RowBox[{"TableHeadings", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"None", ",", " ", 
               RowBox[{"{", 
                RowBox[{"\"\<\!\(\*Cell[TextData[Cell[BoxData[FormBox[
TemplateBox[{
RowBox[{\"x\", \",\", \"-\"}]},\"Ket\"], \
TraditionalForm]],ExpressionUUID->\"4957a9fc-f5a7-4302-baf3-231aca898dbd\"]],\
ExpressionUUID->\"61893d3c-4af0-48ca-871a-159ddc595aea\"]\)\>\"", 
                 ",", "\"\<\!\(\*SubscriptBox[\(U\), \
\(oracle\)]\)\!\(\*Cell[TextData[Cell[BoxData[FormBox[
TemplateBox[{
RowBox[{\"x\", \",\", \"-\"}]},\"Ket\"], \
TraditionalForm]],ExpressionUUID->\"c8c904bc-0542-4dcd-b22a-b205fa73e058\"]],\
ExpressionUUID->\"964d28a3-3210-43d8-948c-dd109befa6e5\"]\)\>\""}], "}"}]}], 
              "}"}]}]}], "]"}], "&"}], "/@", 
         RowBox[{"Partition", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"TraditionalForm", "[", 
                 RowBox[{"QuantumState", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Sequence", "@@", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"2", ",", "n"}], "]"}]}], ",", "\"\<X\>\""}], 
                    "}"}]}], "]"}], "]"}], "&"}], "/@", "statesMinus"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"TraditionalForm", "[", 
                 RowBox[{"QuantumState", "[", 
                  RowBox[{
                   RowBox[{"oracle", "[", "#", "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Sequence", "@@", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"2", ",", "n"}], "]"}]}], ",", "\"\<X\>\""}], 
                    "}"}]}], "]"}], "]"}], "&"}], "/@", "statesMinus"}]}], 
             "}"}], "]"}], ",", "10"}], "]"}]}], ")"}]}]}], "}"}], 
    ",", "\"\<   \>\""}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.968849170727046*^9, 3.968849188085738*^9}, {
  3.96884971070439*^9, 3.9688497132335443`*^9}, {3.968855624306966*^9, 
  3.96885562460395*^9}, {3.9688558611311083`*^9, 3.968855923264058*^9}},
 CellLabel->
  "In[385]:=",ExpressionUUID->"41a5e427-1105-4033-85fd-4a6717545e59"],

Cell["\<\
One can see that the oracle introduces a relative phase only on the terms \
that are solutions of the Boolean function.\
\>", "Text",
 CellChangeTimes->{{3.968849942022437*^9, 
  3.968849986907874*^9}},ExpressionUUID->"5740e154-7508-4d0c-b0d3-\
2091f0d90b79"],

Cell["\<\
Let\[CloseCurlyQuote]s verify that the final states are physically identical \
to the initial ones, since the oracle introduced only a global phase (which \
has no observable effect).\
\>", "Text",
 CellChangeTimes->{{3.968849098764903*^9, 3.968849148526366*^9}, {
  3.968849998912434*^9, 
  3.9688499996609783`*^9}},ExpressionUUID->"8d77fb50-f848-422b-99fd-\
548edad0972d"],

Cell[TextData[{
 "Create a list with elements as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{
       RowBox[{"x", ",", "-"}]},
      "Ket"], ",", 
     RowBox[{
      SubscriptBox["U", "oracle"], 
      TemplateBox[{
        RowBox[{"x", ",", "-"}]},
       "Ket"]}]}], "}"}], TraditionalForm]],ExpressionUUID->
  "7ff09be5-f67c-4366-9390-968dc7e3c1ef"],
 ":"
}], "Text",
 CellChangeTimes->{{3.8625152849559*^9, 3.862515304062367*^9}, {
  3.8625708324696283`*^9, 3.862570835740099*^9}, {3.905877527031748*^9, 
  3.905877538442017*^9}, {3.968847869109981*^9, 
  3.9688478993733997`*^9}},ExpressionUUID->"fb3c7194-ee64-40b4-bc6e-\
153d135b7d6d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"results", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"statesMinus", ",", 
      RowBox[{"oracle", "/@", "statesMinus"}]}], "}"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.862515213859318*^9, 3.862515218065579*^9}, {
  3.862515271096929*^9, 3.862515281430093*^9}, {3.968849701153469*^9, 
  3.968849703049899*^9}},
 CellLabel->
  "In[386]:=",ExpressionUUID->"bd8a1c1d-0d76-46e9-a0e8-bf371fd97b9d"],

Cell[TextData[{
 "Test ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{
       RowBox[{"x", ",", "-"}]},
      "Ket"], ",", 
     RowBox[{
      SubscriptBox["U", "oracle"], Cell[TextData[Cell[BoxData[
       FormBox[
        TemplateBox[{
          RowBox[{"x", ",", "-"}]},
         "Ket"], TraditionalForm]],ExpressionUUID->
       "72bf2457-123b-4149-951a-31be045018ad"]],ExpressionUUID->
       "302ad150-cc90-4375-a951-5793a485657b"]}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"1989f026-372d-4da0-bae2-84468f3ad87a"],
 " are physically the same:"
}], "Text",
 CellChangeTimes->{{3.862515316947784*^9, 3.862515333104786*^9}, {
  3.905877553646356*^9, 3.905877561607738*^9}, {3.905877669199727*^9, 
  3.905877673149866*^9}, {3.968848980024397*^9, 
  3.9688489858851957`*^9}},ExpressionUUID->"6f91d368-0990-448a-b6a0-\
8c6e7a25debd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Apply", "[", "And", "]"}], "[", 
  RowBox[{"Equal", "@@@", "results"}], "]"}]], "Input",
 CellChangeTimes->{{3.862515309664097*^9, 3.862515313267769*^9}, {
  3.968855955134305*^9, 3.968855961063672*^9}},
 CellLabel->
  "In[387]:=",ExpressionUUID->"714be3a8-a194-48fb-85cc-d902839faba1"],

Cell["\<\
As expected, only the solutions get a different phase shift. Note we have \
calculated that shift quantum mechanically.\
\>", "Text",
 CellChangeTimes->{{3.8625153829267406`*^9, 3.862515384156962*^9}, {
  3.86251547399654*^9, 3.862515486371285*^9}, {3.86251632141265*^9, 
  3.862516344216147*^9}, {3.968849216899082*^9, 
  3.968849227080875*^9}},ExpressionUUID->"9d4c8a5f-09cb-4e41-b0eb-\
2ef75d65fdc5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Phase oracle", "Subsection",
 CellChangeTimes->{{3.862446621602524*^9, 3.86244664184589*^9}, {
   3.862491294297934*^9, 3.862491294941008*^9}, 
   3.96885024949551*^9},ExpressionUUID->"c668566a-a2e0-4999-b149-\
e3db3e2dabd1"],

Cell["\<\
Another common Grover oracle is the phase oracle. The key difference from the \
Boolean oracle is this: with a Boolean oracle, the solution is written to an \
ancillary (target) qubit; with a phase oracle, there is no ancilla and the \
solution is encoded as a phase. Let\[CloseCurlyQuote]s examine the phase \
oracle in more detail.\
\>", "Text",
 CellChangeTimes->{{3.968850233531577*^9, 
  3.968850329001532*^9}},ExpressionUUID->"1aedeb19-fc6e-41f5-80d3-\
ed15f52cd814"],

Cell["\<\
Create the corresponding phase oracle of the Boolean function:\
\>", "Text",
 CellChangeTimes->{{3.8624477490954523`*^9, 3.862447765493132*^9}, {
  3.9688503338239727`*^9, 
  3.9688503482975082`*^9}},ExpressionUUID->"1013c662-12a8-47d1-8ee8-\
c6bcf9eb45ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"phaseOracle", "=", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<PhaseOracle\>\"", "[", "boo", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.86244664607685*^9, 3.86244667132006*^9}, {
  3.862447734121641*^9, 3.862447741230069*^9}, {3.862495586553309*^9, 
  3.8624955953752813`*^9}, {3.968850114083202*^9, 3.9688501144116163`*^9}, {
  3.968850350020873*^9, 3.968850353314279*^9}},
 CellLabel->
  "In[388]:=",ExpressionUUID->"e1dc8b6b-6464-4aa8-87c4-f11a1ad8c7eb"],

Cell["The diagram of oracle:", "Text",
 CellChangeTimes->{{3.862447767987982*^9, 
  3.862447771754998*^9}},ExpressionUUID->"3b968a1e-affc-4504-b32a-\
19516ae09227"],

Cell[BoxData[
 RowBox[{"phaseOracle", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "->", "120"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.862447742864951*^9, 3.8624477457837667`*^9}, {
   3.86244779557655*^9, 3.862447829784195*^9}, 3.8624955998573112`*^9, {
   3.968850357481853*^9, 3.968850367323803*^9}},
 CellLabel->
  "In[389]:=",ExpressionUUID->"e8e9e47a-1907-4f5c-9ef0-52a1b4f65680"],

Cell[TextData[{
 "We initialize qubits 1-3 in the index register. As before to match \
the truth table, we will generate the index states ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"x"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "e3f700e9-bf01-45b6-b767-0c461023138a"],
 " in descending order, from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{
       SuperscriptBox["2", "n"], "-", "1"}]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "43c463ef-da27-4f01-92c0-6339bf7e5442"],
 " down to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"0"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "c5ca1c80-9457-44cc-b787-64f96889bbb5"],
 "."
}], "Text",
 CellChangeTimes->{{3.86244786827796*^9, 3.8624479030329523`*^9}, {
  3.862448150303897*^9, 3.862448201268702*^9}, {3.905877486232189*^9, 
  3.905877497669455*^9}, {3.9688474492227983`*^9, 3.968847471807226*^9}, {
  3.96884753538031*^9, 3.968847550045609*^9}, {3.968847599424932*^9, 
  3.968847652412031*^9}, {3.968850396705426*^9, 
  3.968850406256954*^9}},ExpressionUUID->"d977c339-cf73-4de3-a9c5-\
3397120ed658"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"states", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"QuantumState", "[", 
        RowBox[{"\"\<Register\>\"", "[", 
         RowBox[{"n", ",", "i"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{
          RowBox[{"2", "^", "n"}], "-", "1"}], ",", "0", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Row", "[", 
    RowBox[{"Riffle", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"phaseOracle", "[", 
         RowBox[{"\"\<Diagram\>\"", ",", 
          RowBox[{"ImageSize", "->", "120"}], ",", 
          RowBox[{"\"\<WireLabels\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"n", "+", "1"}], 
             "->", "\"\<\!\(\*TemplateBox[{\"0\"},\"Ket\"]\)\>\""}], 
            "}"}]}]}], "]"}], ",", 
        RowBox[{"Sequence", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"TableForm", "[", 
             RowBox[{"#", ",", 
              RowBox[{"TableHeadings", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"None", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"\"\<\!\(\*Cell[TextData[Cell[BoxData[FormBox[
TemplateBox[{\"x\"},\"Ket\"], \
TraditionalForm]],ExpressionUUID->\"a3d39d94-ff92-4fa7-bc30-6f7f680b4ef9\"]],\
ExpressionUUID->\"3bb1794b-aded-40df-adb4-39b5e3bca2c6\"]\)\>\"", 
                   ",", "\"\<\!\(\*Cell[TextData[Cell[BoxData[FormBox[RowBox[{
SubscriptBox[\"U\", \"phase\"], 
TemplateBox[{\"x\"},\"Ket\"]}], \
TraditionalForm]],ExpressionUUID->\"4d5db089-0f9f-4b9d-a11a-b46e113b9ad9\"]],\
ExpressionUUID->\"cbbbada7-c976-4462-8247-472278693ac1\"]\)\>\""}], "}"}]}], 
                "}"}]}]}], "]"}], "&"}], "/@", 
           RowBox[{"Partition", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"TraditionalForm", "/@", "states"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"TraditionalForm", "[", 
                   RowBox[{"phaseOracle", "[", "#", "]"}], "]"}], "&"}], "/@",
                  "states"}]}], "}"}], "]"}], ",", "8"}], "]"}]}], ")"}]}]}], 
       "}"}], ",", "\"\<   \>\""}], "]"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.968848178648801*^9, 3.968848230116467*^9}, {
  3.968848283036941*^9, 3.9688483281356697`*^9}, {3.968848358856203*^9, 
  3.96884842139848*^9}, {3.968848490243825*^9, 3.96884851912607*^9}, {
  3.968848592123972*^9, 3.96884859227697*^9}, {3.968849610378169*^9, 
  3.9688496238431997`*^9}, {3.968849765506486*^9, 3.9688498096553173`*^9}, {
  3.968850155382063*^9, 3.9688502120540733`*^9}, {3.968850430890945*^9, 
  3.968850461256295*^9}, {3.968855972639799*^9, 3.968856049119533*^9}},
 CellLabel->
  "In[390]:=",ExpressionUUID->"245fca54-7960-4825-8879-9174c185df53"],

Cell["\<\
As one can see, the oracle circuit reproduce the same result as the classical \
ones, but this time the solution information is in the phase.\
\>", "Text",
 CellChangeTimes->{{3.8624482120525723`*^9, 3.862448241410914*^9}, {
  3.968850469653201*^9, 
  3.968850476788619*^9}},ExpressionUUID->"ec15f9b8-cc16-4795-9812-\
9552ec26ac21"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Grover\[CloseCurlyQuote]s Algorithm", "Section",
 CellChangeTimes->{{3.9458858060811787`*^9, 
  3.9458858125204983`*^9}},ExpressionUUID->"2db9bf88-73ce-4006-914e-\
7a2f591575c0"],

Cell["The full Grover search operation looks like this:", "Text",
 CellChangeTimes->{{3.9459520369173546`*^9, 3.9459521004918404`*^9}, {
  3.96885187473216*^9, 
  3.9688518761653957`*^9}},ExpressionUUID->"f0352ef0-aa1b-479d-b39f-\
fcbfc91ea93c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gs", "=", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<Grover\>\"", "[", "boo", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"gs", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.9459521043117657`*^9, 3.9459521413236713`*^9}, {
  3.9688506857047787`*^9, 3.968850686072865*^9}, {3.9688507196288424`*^9, 
  3.968850759327964*^9}, {3.968851863850094*^9, 3.96885186689044*^9}},
 CellLabel->
  "In[391]:=",ExpressionUUID->"49ca60fb-5b17-46df-a113-db58f7d9291e"],

Cell["\<\
The second block of gates is known as the Grover diffusion operator. The \
combination of the Boolean oracle and Grover diffusion operator are applied \
together in one iteration of the algorithm. To take advantage of the phase \
kickback introduced by the controlled gates, the circuit will need an initial \
set of gates and finally a measurement of the first three qubits.\
\>", "Text",
 CellChangeTimes->{{3.9459521694515343`*^9, 3.94595220549798*^9}, {
  3.9459627982304916`*^9, 3.9459629251897984`*^9}, {3.945962979686512*^9, 
  3.945962982246126*^9}},ExpressionUUID->"cf3f3ec9-86ef-4be8-9979-\
428a37c0ffd2"],

Cell["\<\
One iteration of the Grover algorithm for the current example would look like \
this:\
\>", "Text",
 CellChangeTimes->{{3.9459629880396767`*^9, 
  3.9459630184077625`*^9}},ExpressionUUID->"25ae29e0-cd38-473e-887f-\
26ea877a2dfe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"oneIteration", "=", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<H\>\"", "->", 
       RowBox[{"Range", "[", 
        RowBox[{"n", "+", "1"}], "]"}]}], ",", 
      RowBox[{"\"\<Z\>\"", "->", 
       RowBox[{"n", "+", "1"}]}], ",", "gs", ",", 
      RowBox[{"Range", "[", "n", "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"oneIteration", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.9459629546556168`*^9, 3.94596295621533*^9}, {
  3.946920290474064*^9, 3.946920350187399*^9}, {3.9688519083463697`*^9, 
  3.9688519098430023`*^9}, {3.9688561150940933`*^9, 3.9688561186353903`*^9}, {
  3.968856307360392*^9, 3.968856321191676*^9}, {3.968856355679689*^9, 
  3.968856355826022*^9}},
 CellLabel->
  "In[393]:=",ExpressionUUID->"e71078f9-abb1-4764-979c-64436e69e40b"],

Cell["\<\
The measurement distribution for this circuit is shown below:\
\>", "Text",
 CellChangeTimes->{{3.9459631313823986`*^9, 
  3.945963176175829*^9}},ExpressionUUID->"ef7209ad-6885-4a01-a634-\
d3f57b84dca9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"oneIteration", "[", "]"}], "[", 
  RowBox[{"\"\<ProbabilitiesPlot\>\"", ",", 
   RowBox[{"\"\<LabelsAngle\>\"", "->", 
    RowBox[{"90", "Degree"}]}], ",", 
   RowBox[{"AspectRatio", "->", 
    RowBox[{"1", "/", "4"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9458906396658974`*^9, 3.945890653548151*^9}, {
  3.968851916153276*^9, 3.968851916722863*^9}, {3.968856397311783*^9, 
  3.96885640038524*^9}, {3.968856491204088*^9, 3.9688565303835783`*^9}},
 CellLabel->
  "In[395]:=",ExpressionUUID->"5d5b0961-fab8-4085-b382-34de2f78d3c6"],

Cell["\<\
Recall that, for the states above, the Boolean function outputs are:\
\>", "Text",
 CellChangeTimes->{{3.968857246396406*^9, 3.968857285853842*^9}, {
  3.9688573603258533`*^9, 
  3.968857361301111*^9}},ExpressionUUID->"092b5714-fee2-4c74-8820-\
314016b61c5a"],

Cell[BoxData[
 RowBox[{"Thread", "[", 
  RowBox[{
   RowBox[{"Tuples", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", "n"}], "]"}], "->", 
   RowBox[{"Boole", "@", 
    RowBox[{"Reverse", "[", 
     RowBox[{"BooleanTable", "[", "boo", "]"}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.968857411912526*^9, 3.9688574212443523`*^9}, {
  3.969310354190464*^9, 3.969310358838498*^9}},
 CellLabel->
  "In[396]:=",ExpressionUUID->"fafa1358-ee2c-4576-abb3-dd9443a7bb67"],

Cell["\<\
From the full measurement distribution, sum only the probabilities of inputs \
labeled True (1 in the above list).\
\>", "Text",
 CellChangeTimes->{
  3.96885724213662*^9, 3.968857290520466*^9, {3.96885732091249*^9, 
   3.9688573343015547`*^9}, {3.9688574520978107`*^9, 3.968857452981365*^9}, {
   3.969310383226728*^9, 
   3.969310387490758*^9}},ExpressionUUID->"c32fa336-cb3a-4ef0-8c61-\
74e0f118a333"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"oneIteration", "[", "]"}], "[", "\"\<ProbabilitiesList\>\"", 
    "]"}], ".", 
   RowBox[{"Boole", "[", 
    RowBox[{"Reverse", "[", 
     RowBox[{"BooleanTable", "[", "boo", "]"}], "]"}], "]"}]}], "//", 
  "N"}]], "Input",
 CellChangeTimes->{{3.968856563454051*^9, 3.968856573674268*^9}, {
  3.968856675639738*^9, 3.96885668308086*^9}, {3.969310398635426*^9, 
  3.969310399855937*^9}},
 CellLabel->
  "In[397]:=",ExpressionUUID->"305f3f71-703a-45b1-a59c-28a16ed2f309"],

Cell["\<\
As one can see, with the chance of around 65%, we can get the correct \
solution of the Boolean function by only one iteration of Grover.\
\>", "Text",
 CellChangeTimes->{{3.9688574711904297`*^9, 
  3.968857506996799*^9}},ExpressionUUID->"947e962f-29aa-4ba9-924e-\
1e6816a4cda6"],

Cell["Now what happens if two iterations are used instead of one?", "Text",
 CellChangeTimes->{{3.9459632432546425`*^9, 3.9459633102386913`*^9}, {
  3.968857465362191*^9, 
  3.9688574664025297`*^9}},ExpressionUUID->"60ed9e05-6cfb-4e16-b8fc-\
7cc7b7714ad7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"twoIteration", "=", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<H\>\"", "\[Rule]", 
       RowBox[{"Range", "[", 
        RowBox[{"n", "+", "1"}], "]"}]}], ",", 
      RowBox[{"\"\<Z\>\"", "\[Rule]", 
       RowBox[{"n", "+", "1"}]}], ",", "gs", ",", "gs", ",", 
      RowBox[{"Range", "[", "n", "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"twoIteration", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "->", "450"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.94589068459659*^9, 3.9458906948667603`*^9}, {
   3.9459630941368484`*^9, 3.9459631158056965`*^9}, 3.9469203890086155`*^9, {
   3.9688519519620113`*^9, 3.968851961462637*^9}, 3.968852367773205*^9, {
   3.968856099980439*^9, 3.968856108296417*^9}, {3.9688563594084806`*^9, 
   3.968856359558531*^9}},
 CellLabel->
  "In[398]:=",ExpressionUUID->"2775717d-8623-41ff-8029-929e2f1f2ec1"],

Cell["\<\
The circuit is longer, but now the probability for obtaining the desired \
outcome is increased:\
\>", "Text",
 CellChangeTimes->{{3.9459633216065254`*^9, 
  3.9459633499921303`*^9}},ExpressionUUID->"4ddf25bc-a5b9-4031-8a28-\
787ef5072592"],

Cell[BoxData[
 RowBox[{
  RowBox[{"twoIteration", "[", "]"}], "[", 
  RowBox[{"\"\<ProbabilitiesPlot\>\"", ",", 
   RowBox[{"\"\<LabelsAngle\>\"", "->", 
    RowBox[{"90", "Degree"}]}], ",", 
   RowBox[{"AspectRatio", "->", 
    RowBox[{"1", "/", "4"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.945890839828003*^9, 3.9458908400020275`*^9}, {
  3.968857526982872*^9, 3.968857529107935*^9}},
 CellLabel->
  "In[400]:=",ExpressionUUID->"0e3a2741-8266-403a-ab53-d5e9adc44683"],

Cell["\<\
In this case, with the chance of most 100%, we can get the correct solution \
of the Boolean function by only two iterations of Grover. \
\>", "Text",
 CellChangeTimes->{{3.968857574729135*^9, 
  3.968857609597309*^9}},ExpressionUUID->"86462b87-8395-4c09-954e-\
df13975786c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"twoIteration", "[", "]"}], "[", "\"\<ProbabilitiesList\>\"", 
    "]"}], ".", 
   RowBox[{"Boole", "[", 
    RowBox[{"Reverse", "[", 
     RowBox[{"BooleanTable", "[", "boo", "]"}], "]"}], "]"}]}], "//", 
  "N"}]], "Input",
 CellChangeTimes->{
  3.968856705331389*^9, {3.969310411705491*^9, 3.9693104186531477`*^9}},
 CellLabel->
  "In[401]:=",ExpressionUUID->"3a4fdbc0-774e-4386-a47b-308fc597488f"],

Cell["\<\
We can also calculate the success probability given the number of Grover \
iteration:\
\>", "Text",
 CellChangeTimes->{{3.9688576170220747`*^9, 
  3.968857640183651*^9}},ExpressionUUID->"cb03820b-ad92-446d-9736-\
6be29a0157c9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"successProabGrover", "=", 
   RowBox[{"MapIndexed", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"#2", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", 
        RowBox[{
         RowBox[{"#1", "[", "\"\<ProbabilitiesList\>\"", "]"}], ".", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Reverse", "[", 
            RowBox[{"BooleanTable", "[", "boo", "]"}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"False", "->", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}]}], ",", 
             RowBox[{"True", "->", 
              RowBox[{"{", 
               RowBox[{"1", ",", "1"}], "}"}]}]}], "}"}]}], "]"}]}]}], "}"}], 
      "&"}], ",", 
     RowBox[{"NestList", "[", 
      RowBox[{
       RowBox[{"N", "[", "gs", "]"}], ",", 
       RowBox[{"QuantumState", "[", "\"\<+++++-\>\"", "]"}], ",", "10"}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.968856750725651*^9, 3.968856775904293*^9}, {
  3.968856881219709*^9, 3.9688568813864603`*^9}, {3.968857044706846*^9, 
  3.96885705778235*^9}, {3.968857089480267*^9, 3.9688571866285267`*^9}},
 CellLabel->
  "In[402]:=",ExpressionUUID->"a5b734b9-01c2-42d0-aada-cc267d3521ef"],

Cell["\<\
As you can see, the probability rises then falls and rises again as more and \
more Grover iterations are applied.\
\>", "Text",
 CellChangeTimes->{{3.9459642321880665`*^9, 3.9459642337741833`*^9}, {
  3.9459642639982452`*^9, 
  3.945964290573374*^9}},ExpressionUUID->"b7e67587-f276-42c0-ba79-\
5a18618c8217"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"ListPlot", "[", 
   RowBox[{"successProabGrover", ",", 
    InterpretationBox[
     DynamicModuleBox[{Typeset`open = False}, 
      TemplateBox[{"Expression", "SequenceIcon", 
        GridBox[{{
           RowBox[{
             TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["Sequence", "IconizedItem"]}]}, {
           RowBox[{
             TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["4", "IconizedItem"]}]}, {
           RowBox[{
             TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["512", "IconizedItem"]}]}}, 
         GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
         "Column", 
         GridBoxItemSize -> {
          "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
        Dynamic[Typeset`open]},
       "IconizedObject"]],
     Sequence[
     Joined -> True, AxesLabel -> {"Oracle Queries", "Success Chance"}, 
      PlotLegends -> {"Grover"}, GridLines -> Automatic],
     SelectWithContents->True,
     Selectable->False]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9458979219631786`*^9, 3.945897933647394*^9}, {
   3.945949499841463*^9, 3.9459495941214466`*^9}, {3.968854380751045*^9, 
   3.968854394558873*^9}, {3.968854524201117*^9, 3.968854547405861*^9}, {
   3.968854700316372*^9, 3.968854719023164*^9}, {3.9688549458833513`*^9, 
   3.96885501891262*^9}, {3.968855281565393*^9, 3.9688552834816008`*^9}, {
   3.968855315123797*^9, 3.9688553162917852`*^9}, {3.968855401853656*^9, 
   3.96885541758648*^9}, {3.9688569159890547`*^9, 3.968856920482132*^9}, 
   3.9693104500580883`*^9},
 CellLabel->
  "In[403]:=",ExpressionUUID->"de0ddfc0-aacb-46f2-b4d1-52d54af5afd2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Quantum Arithmetic", "Chapter",
 CellChangeTimes->{{3.9458857100891*^9, 3.9458857172175865`*^9}, {
  3.9465031062482376`*^9, 
  3.9465031093830967`*^9}},ExpressionUUID->"7cfbc4d6-618d-4db9-be97-\
09917b744716"],

Cell["\<\
We will cover quantum arithmetic circuits centered on the Quantum Fourier \
Transform, showing how QFT enables addition and multiplication, how these \
operations are implemented in the Fourier basis, and how to transform to and \
from that basis.\
\>", "Text",
 CellChangeTimes->{{3.9690356841875267`*^9, 3.969035726148397*^9}, {
  3.969035777898386*^9, 3.969035780165082*^9}, {3.969100333878642*^9, 
  3.9691003748942747`*^9}},ExpressionUUID->"09a953a1-3033-4f3e-945f-\
41160a179e1f"],

Cell[CellGroupData[{

Cell["Key Concepts", "Section",
 CellChangeTimes->{{3.9458857262477703`*^9, 
  3.945885728184759*^9}},ExpressionUUID->"0cd7ae43-c700-4a6e-84ce-\
1315ea027aad"],

Cell["Discrete Fourier Transform", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, {
  3.9459508180356083`*^9, 3.9459508219695263`*^9}, {3.9465031788793373`*^9, 
  3.9465031894301834`*^9}, {3.969283651669311*^9, 
  3.969283659395224*^9}},ExpressionUUID->"256a9ea3-a6bf-4e70-b8a5-\
27d168cb3730"],

Cell["Quantum Fourier Transform (QFT)", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, {
  3.9459508180356083`*^9, 3.9459508219695263`*^9}, {3.9465031788793373`*^9, 
  3.9465031894301834`*^9}, {3.969283651669311*^9, 
  3.969283652982691*^9}},ExpressionUUID->"cf7a654f-9584-4ba9-8081-\
a3ff72691eeb"],

Cell["Fourier (phase) Basis", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, 
   3.945966437091715*^9, {3.94650320037673*^9, 3.9465032026390457`*^9}, {
   3.9465034302710743`*^9, 3.9465034355196266`*^9}, {3.9465079620495815`*^9, 
   3.94650798489847*^9}, {3.946921626805523*^9, 3.9469216289980717`*^9}, {
   3.9692831062430773`*^9, 
   3.9692831157796803`*^9}},ExpressionUUID->"a970a9ae-8496-41b6-981c-\
60c5643eb024"],

Cell["Phase adder", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, 
   3.945966437091715*^9, {3.94650320037673*^9, 3.9465032026390457`*^9}, {
   3.9465034302710743`*^9, 3.9465034355196266`*^9}, {3.9465079620495815`*^9, 
   3.94650798489847*^9}, {3.946921626805523*^9, 3.9469216289980717`*^9}, {
   3.9692831062430773`*^9, 
   3.969283120176812*^9}},ExpressionUUID->"c3e9ccec-bac8-444a-b86c-\
f2000b1966b9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Discrete Fourier Transform and QFT", "Section",
 CellChangeTimes->{{3.9469220892941666`*^9, 3.9469220977784348`*^9}, {
  3.96928364297145*^9, 
  3.9692836498420143`*^9}},ExpressionUUID->"88c30d73-1572-4d75-b44c-\
bee09353b702"],

Cell[TextData[{
 "The ",
 ButtonBox["discrete Fourier transform",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://mathworld.wolfram.com/DiscreteFourierTransform.html"], None},
  ButtonNote->"https://mathworld.wolfram.com/DiscreteFourierTransform.html"],
 " is a mathematical transformation that is very useful in processing data. \
It has many applications and is often employed when one wants to analyze \
signals over time."
}], "Text",
 CellChangeTimes->{{3.9469222698188267`*^9, 3.946922322272913*^9}, {
  3.9469224480355053`*^9, 
  3.9469225104774933`*^9}},ExpressionUUID->"4b9b181d-6b6d-4dd3-86cd-\
cbcf63ecab2d"],

Cell[TextData[{
 "Fourier transformation on a list of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "1e5ed8be-6ecc-426a-9025-6fe09335fa87"],
 " numbers is given by the so-called Fourier matrix of size ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "a1c6cde8-f552-4b79-b233-3f27e1cd3d40"],
 ". For example, the Fourier matrix of size 4 looks like:"
}], "Text",
 CellChangeTimes->{{3.9469225164422646`*^9, 3.9469225902443104`*^9}, {
  3.969026005131309*^9, 3.969026009474523*^9}, {3.969283143155044*^9, 
  3.969283143919734*^9}},ExpressionUUID->"7a6a691f-14d3-475e-8549-\
a9d2a1163a71"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FourierMatrix", "[", "4", "]"}], "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.9469225927014236`*^9, 3.9469226143398743`*^9}, {
   3.96902610428195*^9, 3.9690261044665833`*^9}, 3.969026253878665*^9},
 CellLabel->
  "In[404]:=",ExpressionUUID->"5c33912b-02d2-40fe-a485-e578ae5736b7"],

Cell[TextData[{
 "Recall that quantum states of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "da070656-2f77-4a73-bcde-91bd06ac5432"],
 " qubits can be represented by a list of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "n"], TraditionalForm]],ExpressionUUID->
  "298a651a-621c-4443-8ebd-e7214e64c6cc"],
 " complex amplitudes. The most naive way to implement the classical discrete \
fourier transform on a list of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "n"], TraditionalForm]],ExpressionUUID->
  "d8a4535a-ad5a-473c-a696-443c61778593"],
 " complex data points requires ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["2", 
     RowBox[{"2", "n"}]], ")"}], TraditionalForm]],ExpressionUUID->
  "1713182e-c0ed-41b9-8f79-66b557f38397"],
 " operations. However, there are other methods known as ",
 ButtonBox["Fast Fourier Transforms",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://mathworld.wolfram.com/FastFourierTransform.html"], None},
  ButtonNote->"https://mathworld.wolfram.com/FastFourierTransform.html"],
 ". These faster methods only require ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    RowBox[{"n", " ", 
     SuperscriptBox["2", "n"]}]}], TraditionalForm]],ExpressionUUID->
  "9ddad789-0678-4035-b059-090a7ef7ba1c"],
 ") classical operations. Because ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "n"], TraditionalForm]],ExpressionUUID->
  "34931e33-f896-4af3-b2ec-34fd8efee6d9"],
 " complex data points can be encoded in only ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "a8c9a6fb-73a7-4119-83b2-d630d2b836a0"],
 " qubits, the ",
 StyleBox["quantum Fourier transform",
  FontWeight->"Bold"],
 " requires only ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["n", "2"], ")"}], TraditionalForm]],ExpressionUUID->
  "1b93c289-7582-49a5-a8cd-594f0d9dac06"],
 " quantum gates to be applied to these ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "e2957ad9-3c1b-4cc5-891c-f80eb9af0779"],
 " qubits."
}], "Text",
 CellChangeTimes->{{3.946922634666115*^9, 3.9469226457310066`*^9}, {
  3.94692271840353*^9, 3.946922761849951*^9}, {3.946924659080759*^9, 
  3.946924659928465*^9}, {3.9469247022162266`*^9, 3.9469247248246403`*^9}, {
  3.969283570517952*^9, 
  3.969283578899331*^9}},ExpressionUUID->"ed026843-4de3-4ba1-a012-\
634c8d6daab4"],

Cell["\<\
The Quantum Fourier Transform maps an n-qubit computational-basis state to a \
uniform superposition whose phases encode the original index in Fourier order:\
\>", "Text",
 CellChangeTimes->{{3.9690274148312387`*^9, 3.9690274343329077`*^9}, {
  3.969027484771826*^9, 3.969027485988872*^9}, {3.9690275180871363`*^9, 
  3.9690275338712053`*^9}},ExpressionUUID->"3a430f79-4659-4b58-9ea9-\
ce3ea4fc0330"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"QFT", 
     TemplateBox[{"x"},
      "Ket"]}], "=", 
    RowBox[{
     FractionBox["1", 
      SqrtBox[
       SuperscriptBox["2", "n"]]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"y", "=", "0"}], 
       RowBox[{
        SuperscriptBox["2", "n"], "-", "1"}]], 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", " ", 
         RowBox[{"xy", "/", 
          SuperscriptBox["2", "n"]}]}]], 
       TemplateBox[{"y"},
        "Ket"]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "27028dd5-8ae2-4a58-90ba-07a27899fce0"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<=", "x", "<=", 
    RowBox[{
     SuperscriptBox["2", "n"], "-", "1"}]}], TraditionalForm]],ExpressionUUID->
  "9c041ce5-ef33-4cd7-8b6b-497d60f5fd6d"]
}], "Text",
 CellChangeTimes->{{3.96902727590854*^9, 3.969027363861939*^9}, {
  3.969027437208044*^9, 
  3.96902747942525*^9}},ExpressionUUID->"b3d164cc-9a80-4ce6-8c01-\
cd4045076699"],

Cell["\<\
In fact, QFT is a basis change. For a general 2-qubit state with four \
amplitudes (ordered as 00, 01, 10, 11), the 2-qubit QFT applies a 4-point \
discrete Fourier transform to those amplitudes. Each basis component spreads \
over all four outputs with specific relative phases; the new four amplitudes \
are the Discrete Fourier Transform of the original four. \
\>", "Text",
 CellChangeTimes->{{3.969027542731736*^9, 3.969027552744421*^9}, {
   3.969029823252863*^9, 3.969029825857737*^9}, {3.969099134101367*^9, 
   3.969099137564363*^9}, 3.969099180366364*^9, {3.969099211577523*^9, 
   3.9690992326841583`*^9}, {3.969283211274893*^9, 
   3.969283232286644*^9}},ExpressionUUID->"b4801e34-a797-4106-b696-\
09ae0434d870"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MatrixForm", "[", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[FormalC]", "##"], "&"}], ",", 
     SuperscriptBox["2", "2"]}], "]"}], "]"}], "->", 
  RowBox[{"MatrixForm", "@", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"FourierMatrix", "[", "4", "]"}], ".", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[FormalC]", "##"], "&"}], ",", 
       SuperscriptBox["2", "2"]}], "]"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{3.969283276417473*^9},
 CellLabel->
  "In[405]:=",ExpressionUUID->"c2f100c4-2143-4c53-b1d1-288d0a8501ee"],

Cell[TextData[{
 "The above transformation is exactly what happens when applying QFT on a \
state described by the state vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[FormalC]", "1"], ",", 
     SubscriptBox["\[FormalC]", "2"], ",", 
     SubscriptBox["\[FormalC]", "3"], ",", 
     SubscriptBox["\[FormalC]", "4"]}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bea1551a-e801-4a88-a6ba-afac4e9f893b"],
 ":"
}], "Text",
 CellChangeTimes->{{3.969283495716271*^9, 
  3.9692835332062693`*^9}},ExpressionUUID->"77e482ce-9575-4cfe-adfe-\
5888c4bebe88"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qc", "=", 
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"QuantumState", "[", 
         RowBox[{"Array", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[FormalC]", "##"], "&"}], ",", 
           SuperscriptBox["2", "2"]}], "]"}], "]"}], ",", 
        RowBox[{"\"\<Fourier\>\"", "[", "2", "]"}]}], "}"}], "]"}]}], "}"}], ",", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"qc", "[", "\"\<Diagram\>\"", "]"}], ",", "\"\<  \>\"", ",", 
      RowBox[{"MatrixForm", "@", 
       RowBox[{"FullSimplify", "@", 
        RowBox[{"Normal", "@", 
         RowBox[{
          RowBox[{"qc", "[", "]"}], "[", "\"\<StateVector\>\"", "]"}]}]}]}]}],
      "}"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.969029851729249*^9, 3.969029879844861*^9}, {
  3.969283272212326*^9, 3.969283485451502*^9}},
 CellLabel->
  "In[406]:=",ExpressionUUID->"c223ea37-42a2-4ffa-ba32-e7ea544839c8"],

Cell["The circuit to implement a 3-qubit QFT is given below:", "Text",
 CellChangeTimes->{{3.9469235373595734`*^9, 3.946923552872793*^9}, {
  3.9469247688083744`*^9, 3.9469247693685646`*^9}, {3.9690299474150543`*^9, 
  3.96902996707355*^9}},ExpressionUUID->"fa71e30a-8c86-4901-a8d9-\
4901004ad078"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<Fourier\>\"", "[", "3", "]"}], "]"}], "[", "\"\<Diagram\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{3.946923478533615*^9, 3.946923521609535*^9}, 
   3.969027182790409*^9},
 CellLabel->
  "In[407]:=",ExpressionUUID->"17bd9dbc-8a6b-4bef-865b-dbfcbbc65046"],

Cell["\<\
One can show that the overall effect of QFT (i.e. its matrix) is exactly the \
same as usual Fourier matrix:\
\>", "Text",
 CellChangeTimes->{{3.9469235568248463`*^9, 3.9469235731695137`*^9}, {
  3.946923638976753*^9, 3.946923680120661*^9}, {3.946924777905035*^9, 
  3.9469247960081596`*^9}, {3.969283605139493*^9, 
  3.969283631587329*^9}},ExpressionUUID->"3ff358fa-e833-4073-804f-\
61a265a1ffa0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<Fourier\>\"", "[", "3", "]"}], "]"}], "[", "\"\<Matrix\>\"", 
   "]"}], "==", 
  RowBox[{"FourierMatrix", "[", 
   RowBox[{"2", "^", "3"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9469235850328083`*^9, 3.946923613233532*^9}, 
   3.96902718621966*^9},
 CellLabel->
  "In[408]:=",ExpressionUUID->"3f77dbe0-a745-4e4c-a2da-8d5c0f689391"],

Cell["\<\
Transforming a quantum state into the Fourier basis is exactly the action of \
the QFT on that state. Think of the QFT as the basis change to the Fourier \
basis.\
\>", "Text",
 CellChangeTimes->{{3.969026953179206*^9, 3.9690269816628923`*^9}, {
  3.969104455673809*^9, 3.969104459195108*^9}, {3.9691126288850946`*^9, 
  3.969112657522119*^9}, {3.969112738349923*^9, 
  3.9691127413463163`*^9}},ExpressionUUID->"4c5cb3eb-61ca-4bf2-8fbc-\
df36f6535427"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Phase Basis Encoding", "Section",
 CellChangeTimes->{{3.9469239173865833`*^9, 
  3.9469239202323856`*^9}},ExpressionUUID->"241915a4-adfe-436f-a8d9-\
b4c7a035bd79"],

Cell["\<\
As we discussed before, the computational basis is not the only way to encode \
classical information in a quantum state. Recall that the relative phase \
between two states can be experimentally distinguished. Thus, even if two \
states have the same probability to obtain outcomes in the computational \
basis, they are not the same state and will give different probabilities for \
outcomes in some other basis.\
\>", "Text",
 CellChangeTimes->{{3.9469356026670685`*^9, 3.946935658856249*^9}, {
  3.946936428403904*^9, 3.9469364957408905`*^9}, {3.9469369312771816`*^9, 
  3.9469369658542824`*^9}, {3.969026315344817*^9, 3.9690263169363403`*^9}, {
  3.969030014041603*^9, 3.969030036717396*^9}, {3.9692839578363867`*^9, 
  3.969283959420533*^9}},ExpressionUUID->"954bfbe0-d69e-444a-9cba-\
2c3dd7649cdf"],

Cell[TextData[{
 "Look at the following examples, where the phase ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"\[ImaginaryI]\[Pi]", "/", "3"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "71a3a75f-906d-497b-94b1-b09f9dc8ee86"],
 " in front of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"1"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ada90be9-caaf-41e8-b498-c862d3a50b3a"],
 " is not observable in the computational basis, but detectable in the \
Pauli-X basis:"
}], "Text",
 CellChangeTimes->{{3.9692839651085167`*^9, 3.9692840058484364`*^9}, {
  3.969284582352517*^9, 
  3.96928458992768*^9}},ExpressionUUID->"d34b18a4-f08b-4bd3-8bee-\
48f4f5267fbf"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"qc", "=", 
        RowBox[{"QuantumCircuitOperator", "[", 
         RowBox[{"{", "\"\<H\>\"", "}"}], "]"}]}], "}"}], ",", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"qc", "[", 
          RowBox[{"\"\<Diagram\>\"", ",", 
           RowBox[{"ImageSize", "->", "120"}], ",", 
           RowBox[{"\"\<WireLabels\>\"", "->", "None"}]}], "]"}], ",", 
         RowBox[{"Column", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"qc", "[", "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"qc", "[", "]"}], "[", "\"\<Probabilities\>\"", "]"}], ",", 
             RowBox[{
              RowBox[{"QuantumState", "[", 
               RowBox[{
                RowBox[{"qc", "[", "]"}], ",", "\"\<X\>\""}], "]"}], 
              "[", "\"\<Probabilities\>\"", "]"}]}], "}"}], ",", 
           RowBox[{"Frame", "->", "All"}]}], "]"}]}], "}"}], "]"}]}], "]"}], 
    ",", "\"\<    \>\"", ",", "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"qc", "=", 
        RowBox[{"QuantumCircuitOperator", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<H\>\"", ",", 
           RowBox[{"\"\<P\>\"", "[", 
            RowBox[{"\[Pi]", "/", "3"}], "]"}]}], "}"}], "]"}]}], "}"}], ",", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"qc", "[", 
          RowBox[{"\"\<Diagram\>\"", ",", 
           RowBox[{"ImageSize", "->", "220"}], ",", 
           RowBox[{"\"\<WireLabels\>\"", "->", "None"}]}], "]"}], ",", 
         RowBox[{"Column", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"qc", "[", "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"qc", "[", "]"}], "[", "\"\<Probabilities\>\"", "]"}], ",", 
             RowBox[{
              RowBox[{"QuantumState", "[", 
               RowBox[{
                RowBox[{"qc", "[", "]"}], ",", "\"\<X\>\""}], "]"}], 
              "[", "\"\<Probabilities\>\"", "]"}]}], "}"}], ",", 
           RowBox[{"Frame", "->", "All"}]}], "]"}]}], "}"}], "]"}]}], "]"}]}],
    "}"}], "]"}]], "Input",
 CellChangeTimes->{{3.969283693729995*^9, 3.9692839410840263`*^9}, {
  3.969284722380732*^9, 3.96928478075943*^9}},
 CellLabel->
  "In[409]:=",ExpressionUUID->"2c7b63dc-b170-4a51-962d-e9f97ae01a23"],

Cell["With this in mind, consider the following circuit:", "Text",
 CellChangeTimes->{{3.969030434993354*^9, 
  3.969030439885414*^9}},ExpressionUUID->"1dd77f00-8782-41eb-8626-\
ec6ad4e4bb98"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<PhaseNumber\>\"", "[", 
    RowBox[{"1", ",", "3"}], "]"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "->", "100"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.969030394877645*^9, 3.969030395822077*^9}, {
   3.969043035193584*^9, 3.9690430405967407`*^9}, 3.9692846914837008`*^9},
 CellLabel->
  "In[410]:=",ExpressionUUID->"cbaa15fc-3fde-48a6-899f-ca88de97dabc"],

Cell[TextData[{
 "Recall that green circles represent \[OpenCurlyDoubleQuote]PhaseShift\
\[CloseCurlyDoubleQuote] gate, which is a phase gate with the angle ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[Pi]", 
    SuperscriptBox["2", 
     RowBox[{"n", "-", "1"}]]], TraditionalForm]],ExpressionUUID->
  "ea070b56-5fc2-4f93-891e-53db6999911e"],
 ". The corresponding label is ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SuperscriptBox["2", 
     RowBox[{"n", "-", "1"}]]], TraditionalForm]],ExpressionUUID->
  "2cb519f7-20d1-4d80-94b6-5b0c9609f90a"],
 ". It means the label ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "4"], TraditionalForm]],ExpressionUUID->
  "73061382-fb14-4eee-b169-e280720e9277"],
 " means a phase of ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[Pi]", "4"], TraditionalForm]],ExpressionUUID->
  "2baa6511-6d7e-46c5-9360-0fdc08f05e5a"],
 "."
}], "Text",
 CellChangeTimes->{{3.969112817709519*^9, 3.969112924785226*^9}, {
  3.9691129893570747`*^9, 3.969113010172455*^9}, {3.969284612792433*^9, 
  3.96928461609671*^9}},ExpressionUUID->"b6d7de9a-c1ab-4f6e-83f3-\
2cb14e93efd3"],

Cell["\<\
The above circuit encodes an integer in n qubits. Here, the integer 1 is \
encoded in three qubits. In 3-bit binary, 1 is 001.\
\>", "Text",
 CellChangeTimes->{{3.969030704618726*^9, 3.969030716186696*^9}, {
  3.9690307597984467`*^9, 3.969030770548811*^9}, {3.9690308185849524`*^9, 
  3.969030832921316*^9}, {3.969101549842793*^9, 3.969101584756497*^9}, {
  3.969101619367138*^9, 3.9691016265726643`*^9}, {3.9691130165207148`*^9, 
  3.969113017745734*^9}},ExpressionUUID->"3dc4b7a7-8560-400e-b578-\
d4953b372872"],

Cell[BoxData[
 RowBox[{"IntegerDigits", "[", 
  RowBox[{"1", ",", "2", ",", "3"}], "]"}]], "Input",
 CellChangeTimes->{{3.9690307748984327`*^9, 3.9690307811465187`*^9}},
 CellLabel->
  "In[411]:=",ExpressionUUID->"ac8373a2-afc5-4eb8-99e6-0eaf35f4ca34"],

Cell["\<\
But how do you \"read out\" this phase information if all the measurements \
are performed in the computational basis? If you simply try to measure, the \
information encoded in the qubit phases is lost.\
\>", "Text",
 CellChangeTimes->{{3.969030903336637*^9, 
  3.969030912866029*^9}},ExpressionUUID->"a0612192-597e-48aa-b754-\
f70fe74d5667"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<PhaseNumber\>\"", "[", 
     RowBox[{"1", ",", "3"}], "]"}], "]"}], "[", "]"}], "[", 
  RowBox[{"\"\<AmplitudesChart\>\"", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["7", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["760", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    ChartLegends -> Automatic, PlotLabel -> "Amplitude plot", ImageSize -> 
     Medium, AspectRatio -> 1/3, PlotRange -> {All, 1}, Frame -> True, 
     GridLines -> Automatic],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellChangeTimes->{{3.9469347061542645`*^9, 3.9469347498399067`*^9}, {
   3.946938034562729*^9, 3.946938113203863*^9}, {3.9469381772685127`*^9, 
   3.946938189531088*^9}, {3.9469382846775055`*^9, 3.9469382858601646`*^9}, {
   3.946938358764494*^9, 3.9469384181205482`*^9}, {3.946938496237236*^9, 
   3.946938511844206*^9}, {3.9469385518714085`*^9, 3.9469385585404797`*^9}, {
   3.9469390477288914`*^9, 3.946939050766596*^9}, {3.969031022385693*^9, 
   3.969031059371743*^9}, {3.969031118703463*^9, 3.9690311204665318`*^9}, {
   3.969031220103628*^9, 3.969031220285739*^9}, {3.969043045819294*^9, 
   3.969043075520563*^9}, {3.969043110833336*^9, 3.969043173594431*^9}, 
   3.9690432501253157`*^9},
 CellLabel->
  "In[412]:=",ExpressionUUID->"d1dff1fe-579c-4f33-a692-ae250f526a80"],

Cell["\<\
As you can see from the changing colors in the above plot, the information of \
the input state is transferred to information about the relative phases of \
each qubit (with respect to a uniform superposition in the computational \
basis). But that information is not accessible if measuring in the \
computational basis:\
\>", "Text",
 CellChangeTimes->{{3.946938750323263*^9, 3.9469388390519314`*^9}, {
  3.946939398405958*^9, 3.9469394076703835`*^9}, {3.9469486936332436`*^9, 
  3.946948695833582*^9}, {3.96903108343548*^9, 
  3.969031110621056*^9}},ExpressionUUID->"91e6b7a9-7de2-4ab3-946d-\
72c43e79eb2a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<PhaseNumber\>\"", "[", 
     RowBox[{"1", ",", "3"}], "]"}], "]"}], "[", "]"}], "[", 
  RowBox[{"\"\<ProbabilitiesPlot\>\"", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["6", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["704", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    PlotLabel -> "Probability plot", ImageSize -> Medium, AspectRatio -> 1/3, 
     PlotRange -> {All, 1}, Frame -> True, GridLines -> Automatic],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellChangeTimes->{{3.946939960562481*^9, 3.9469399746725082`*^9}, {
   3.969030938179693*^9, 3.969030942673218*^9}, {3.969031065618313*^9, 
   3.9690310721314783`*^9}, {3.969043085375639*^9, 3.96904312213302*^9}, {
   3.9690431831211576`*^9, 3.969043183337406*^9}, 3.969043240911463*^9},
 CellLabel->
  "In[413]:=",ExpressionUUID->"84a4748e-fce7-499a-b1e4-b2d5ce211462"],

Cell["\<\
As you can see from the plot, the phase information is not immediately \
accessible in the computational basis. Instead, you must perform the inverse \
of the quantum fourier transform, and then measure.\
\>", "Text",
 CellChangeTimes->{{3.946939988600132*^9, 
  3.9469400263924713`*^9}},ExpressionUUID->"982eada3-3397-47c4-b3d9-\
3b1475665ed8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<PhaseNumber\>\"", "[", 
      RowBox[{"1", ",", "3"}], "]"}], ",", 
     RowBox[{"\"\<InverseFourier\>\"", "[", "3", "]"}], ",", 
     RowBox[{"\"\<M\>\"", "->", 
      RowBox[{"Range", "[", "3", "]"}]}]}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.9469400603855133`*^9, 3.9469400731136265`*^9}, {
  3.969031136195657*^9, 3.969031138199327*^9}, {3.9692849334759903`*^9, 
  3.969284933727908*^9}},
 CellLabel->
  "In[414]:=",ExpressionUUID->"45598ebe-1bec-4af4-84fc-63c3f59ff93e"],

Cell["\<\
By performing the inverse quantum Fourier transform, all of the phase \
information is now encoded in the computational basis. The measurement \
outcome is now the same as the number which was encoded in the phase basis:\
\>", "Text",
 CellChangeTimes->{{3.9469401011995716`*^9, 
  3.946940190904087*^9}},ExpressionUUID->"b6d8ceb8-34dc-4c63-a8f0-\
e980c6e3db92"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<PhaseNumber\>\"", "[", 
       RowBox[{"1", ",", "3"}], "]"}], ",", 
      RowBox[{"\"\<InverseFourier\>\"", "[", "3", "]"}], ",", 
      RowBox[{"\"\<M\>\"", "->", 
       RowBox[{"Range", "[", "3", "]"}]}]}], "}"}], "]"}], "[", "]"}], "[", 
  RowBox[{"\"\<ProbabilitiesPlot\>\"", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["5", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["592", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    ImageSize -> Medium, AspectRatio -> 1/3, PlotRange -> {All, 1}, Frame -> 
     True, GridLines -> Automatic],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellChangeTimes->{{3.946940085917652*^9, 3.946940092642618*^9}, 
   3.969031150103991*^9, {3.9690432171479883`*^9, 3.969043229873662*^9}},
 CellLabel->
  "In[415]:=",ExpressionUUID->"3ea37293-6073-4036-9221-147567013651"],

Cell["\<\
With the phase basis and QFT in hand, you can implement quantum arithmetic \
circuits. The final state 001 matches the 3-qubit binary encoding of the \
integer 1.\
\>", "Text",
 CellChangeTimes->{{3.9469402080479774`*^9, 3.9469402395210648`*^9}, {
  3.9690311667197742`*^9, 3.969031193194667*^9}, {3.9691017053891582`*^9, 
  3.969101713411975*^9}},ExpressionUUID->"74f346e7-7c0f-4ffc-8fa3-\
3ffacdc12269"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Quantum Phase Adders", "Section",
 CellChangeTimes->{{3.946940258337263*^9, 
  3.9469402773052425`*^9}},ExpressionUUID->"861abf13-8478-42ac-a1de-\
29eaf2d46c83"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s say you want to build a circuit which adds three to \
your input. The input state is a bit-string state such as 1100 for 12. As \
with any digital computation, the arithmetic is performed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"mod", " ", 
    SuperscriptBox["2", "n"]}], TraditionalForm]],ExpressionUUID->
  "bba97f70-787a-4550-9041-a580af5a9643"],
 ", where n is the number of qubits used."
}], "Text",
 CellChangeTimes->{{3.946940831147005*^9, 3.946941077870779*^9}, {
  3.9691027832540903`*^9, 3.969102792787533*^9}, {3.969103333292296*^9, 
  3.969103405302003*^9}, {3.969284967257497*^9, 
  3.969284967993246*^9}},ExpressionUUID->"3ef6baa0-1210-448f-8f67-\
186cc04084d0"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s use this to compute ",
 Cell[BoxData[
  FormBox[
   RowBox[{"12", "+", "3"}], TraditionalForm]],ExpressionUUID->
  "7487c399-242a-4e3b-89f0-08783d388376"],
 " using four qubits. Find the integer string of 12 in base 2:"
}], "Text",
 CellChangeTimes->{{3.946941253140644*^9, 3.946941320498884*^9}, {
   3.9469414845453205`*^9, 3.946941492196535*^9}, {3.9469419185195007`*^9, 
   3.946941923111164*^9}, {3.969097762828223*^9, 3.9690977705635357`*^9}, 
   3.971797320141736*^9},ExpressionUUID->"2f121377-9426-40d8-8a67-\
08cfcd6f6f32"],

Cell[BoxData[
 RowBox[{"IntegerString", "[", 
  RowBox[{"12", ",", "2", ",", "4"}], "]"}]], "Input",
 CellLabel->
  "In[416]:=",ExpressionUUID->"c46439df-569d-460e-986c-46ceb903108d"],

Cell[TextData[{
 "Build the circuit as follows: prepare the 4-qubit register in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"12"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "104e157b-b232-4097-8e1f-2fc097bb25b1"],
 ", apply the QFT to transform it into the Fourier basis, perform addition of \
3 in the Fourier basis using PhaseNumber circuit but without Hadamard, then \
apply the inverse QFT to return to the computational basis. The final state \
is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"15"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "46f582fa-773f-4b7d-823b-514b94b6871a"],
 " (mod ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "4"], TraditionalForm]],ExpressionUUID->
  "d7fd7fe9-1f3b-42fe-8402-de01b3289bf2"],
 ")."
}], "Text",
 CellChangeTimes->{{3.969097773806122*^9, 3.969097813250307*^9}, {
  3.969097846451054*^9, 3.9690979495533123`*^9}, {3.969103514041733*^9, 
  3.9691035465564003`*^9}, {3.969284996759877*^9, 
  3.9692850178548813`*^9}},ExpressionUUID->"f3d84fbe-f405-4042-afb6-\
aaed1aedea27"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<1100\>\"", ",", 
     RowBox[{"\"\<Fourier\>\"", "[", "4", "]"}], ",", 
     RowBox[{"\"\<PhaseNumber\>\"", "[", 
      RowBox[{"3", ",", "4", ",", "False"}], "]"}], ",", 
     RowBox[{"\"\<InverseFourier\>\"", "[", "4", "]"}]}], "}"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "->", "700"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.946941326457287*^9, 3.9469414107742233`*^9}, {
   3.946942060855921*^9, 3.9469420633357334`*^9}, 3.96903138617669*^9, {
   3.969031429794859*^9, 3.969031531420556*^9}, 3.969036242058971*^9, {
   3.969043293003512*^9, 3.969043347932887*^9}, {3.969043456878212*^9, 
   3.9690434571219997`*^9}, 3.969103544065387*^9},
 CellLabel->
  "In[417]:=",ExpressionUUID->"76d03945-909c-44a6-922a-8f2833a4197c"],

Cell["\<\
This circuit first performs a quantum Fourier transform to get the input \
information into the phase basis, then applies an operation to add 3 in the \
phase basis, then performs an inverse quantum Fourier transform, and finally \
measures the results:\
\>", "Text",
 CellChangeTimes->{{3.9469419292941685`*^9, 
  3.946941977375057*^9}},ExpressionUUID->"dad3daa0-917b-4550-ae38-\
9e656685f62c"],

Cell["Find the measurement probabilities:", "Text",
 CellChangeTimes->{{3.969031832315976*^9, 
  3.969031846662683*^9}},ExpressionUUID->"d7fd7804-a2e6-4d8d-a2a4-\
10656b7d3909"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<1100\>\"", ",", 
      RowBox[{"\"\<Fourier\>\"", "[", "4", "]"}], ",", 
      RowBox[{"\"\<PhaseNumber\>\"", "[", 
       RowBox[{"3", ",", "4", ",", "False"}], "]"}], ",", 
      RowBox[{"\"\<InverseFourier\>\"", "[", "4", "]"}]}], "}"}], "]"}], "[", 
   "]"}], "[", 
  RowBox[{"\"\<ProbabilitiesPlot\>\"", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["2", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["440", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence["LabelsAngle" -> 90 Degree, AspectRatio -> 1/4],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellChangeTimes->{{3.946941496456135*^9, 3.9469415076374836`*^9}, {
  3.969031629029142*^9, 3.969031670321067*^9}, {3.9690433586576023`*^9, 
  3.9690433822211723`*^9}, {3.9691035752746964`*^9, 3.9691035759606524`*^9}},
 CellLabel->
  "In[418]:=",ExpressionUUID->"3ea5f510-cdf4-4eac-b011-677479aff810"],

Cell["\<\
Given the outcome with maximum probability, determine the corresponding \
integer (using the bitstring-to-integer mapping):\
\>", "Text",
 CellChangeTimes->{{3.969031799293211*^9, 3.969031820690991*^9}, {
  3.969031851200226*^9, 
  3.969031855252858*^9}},ExpressionUUID->"4970cc76-a952-4fec-9156-\
f9bd60a9467e"],

Cell[BoxData[
 RowBox[{"FromDigits", "[", 
  RowBox[{"\"\<1111\>\"", ",", "2"}], "]"}]], "Input",
 CellChangeTimes->{{3.969031578007012*^9, 3.969031620145357*^9}, {
  3.969031726754547*^9, 3.969031732080534*^9}, {3.969031788484213*^9, 
  3.969031794037652*^9}, {3.969043404008367*^9, 3.96904340702956*^9}},
 CellLabel->
  "In[419]:=",ExpressionUUID->"4b7bd6e5-3781-4ce1-89b3-7bdcf9a30277"],

Cell[TextData[{
 "With probability 1, this circuit gives the state corresponding to 15, the \
correct result for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"12", "+", "3"}], TraditionalForm]],ExpressionUUID->
  "0be4502b-244b-467b-a0e0-0b2503b68341"],
 "."
}], "Text",
 CellChangeTimes->{{3.946941517261345*^9, 
  3.9469415757897625`*^9}},ExpressionUUID->"8c2fc601-d05f-4ca1-b885-\
e89bca15ca6b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Generic Addition", "Section",
 CellChangeTimes->{{3.9545936969391975`*^9, 3.9545937018182106`*^9}, {
  3.969310811511731*^9, 
  3.969310813820869*^9}},ExpressionUUID->"44500545-e5f2-440e-940e-\
e5cfdd463003"],

Cell[TextData[{
 "Construct a circuit with fixed gates which can add any numbers between 0 \
and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "n"], TraditionalForm]],ExpressionUUID->
  "dc738947-63f4-48ff-ab15-e719c7648c33"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9469440760142117`*^9, 3.9469440779075165`*^9}, {
  3.946944110302931*^9, 3.9469441256868*^9}, {3.946944164006033*^9, 
  3.9469441718239536`*^9}, {3.94694421260721*^9, 3.946944327270851*^9}, {
  3.946946673688139*^9, 3.946946678900839*^9}, {3.9545937115499096`*^9, 
  3.9545937480202274`*^9}, {3.9692851106803703`*^9, 
  3.969285119711678*^9}},ExpressionUUID->"da24db9a-ce51-4295-b19e-\
87148f0428b6"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "adderBlock", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"adderBlock", "[", 
   RowBox[{"n_Integer", "/;", 
    RowBox[{"n", ">", "0"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"QuantumCircuitOperator", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"\"\<C\>\"", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\"\<PhaseShift\>\"", "[", 
            RowBox[{"1", "+", "a", "-", "b"}], "]"}], "->", 
           RowBox[{
            RowBox[{"2", "n"}], "+", "1", "-", "b"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"b", ",", "a"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", "a", "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "n"}], "}"}]}], "]"}], ",", 
    "\[IndentingNewLine]", "\"\<\[CapitalSigma]\>\""}], "\[IndentingNewLine]",
    "]"}]}]}], "Input",
 CellChangeTimes->{{3.946946259523815*^9, 3.946946308671871*^9}, {
   3.946946414481022*^9, 3.946946462681204*^9}, {3.9469465113539543`*^9, 
   3.9469465160878105`*^9}, {3.946946569409157*^9, 3.946946603390753*^9}, {
   3.969034327300858*^9, 3.9690343314797153`*^9}, 3.9690972958098917`*^9},
 CellLabel->
  "In[420]:=",ExpressionUUID->"b3b407e6-0a90-4939-908c-2766cb1019c6"],

Cell[TextData[{
 "For example, show the adder block for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "3"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40e81665-f6ac-4b7f-9417-211ba1ce76b3"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9692851489354143`*^9, 
  3.969285158475404*^9}},ExpressionUUID->"db2207eb-c218-4668-b40d-\
c3351acccd95"],

Cell[BoxData[
 RowBox[{
  RowBox[{"adderBlock", "[", "3", "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "->", "100"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.969285130588318*^9, 3.969285143569482*^9}, {
  3.969285285127851*^9, 3.969285288213979*^9}, {3.9692856168845243`*^9, 
  3.969285639131711*^9}},
 CellLabel->
  "In[422]:=",ExpressionUUID->"4e92ebdf-ac95-45ec-9d7b-200f54eafd8d"],

Cell[TextData[{
 "The effect of adderBlock[n] is as follows: given two n-qubit registers (2n \
wires), it applies a cascade of controlled phase rotations from the addend \
register onto the accumulator, assuming the accumulator is in the Fourier \
basis. In that basis, the block adds the addend into the accumulator modulo ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "n"], TraditionalForm]],ExpressionUUID->
  "7c74babb-1030-4ed1-8d59-598ded490013"],
 " while leaving the addend unchanged: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     TemplateBox[{"a"},
      "Ket"], 
     TemplateBox[{
       OverscriptBox["b", "~"]},
      "Ket"]}], "->", 
    RowBox[{
     TemplateBox[{"a"},
      "Ket"], 
     TemplateBox[{
       OverscriptBox[
        RowBox[{
          RowBox[{"(", 
            RowBox[{"a", "+", "b"}], ")"}], " ", "mod", " ", "2"}], "~"]},
      "Ket"]}]}], TraditionalForm]],ExpressionUUID->
  "382ce3d0-78ac-4bb8-9424-513abca5135c"],
 " with \[Tilde] denoting \[OpenCurlyDoubleQuote]QFT of\
\[CloseCurlyDoubleQuote] . Let\[CloseCurlyQuote]s consider a concrete example:"
}], "Text",
 CellChangeTimes->{{3.969099337454741*^9, 3.969099436817519*^9}, {
  3.969099472715623*^9, 
  3.96909962326343*^9}},ExpressionUUID->"5e454ce7-f6a1-4d87-804b-\
36ad37394e85"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc1", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", "=", "3"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\"\<101\>\"", "->", 
         RowBox[{"Range", "[", "n", "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<001\>\"", "->", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"n", "+", "1"}], ",", 
           RowBox[{"2", " ", "n"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\"\<Fourier\>\"", "[", "3", "]"}], "->", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"n", "+", "1"}], ",", 
           RowBox[{"2", " ", "n"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"adderBlock", "[", "3", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\"\<InverseFourier\>\"", "[", "n", "]"}], "\[Rule]", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"n", "+", "1"}], ",", 
           RowBox[{"2", " ", "n"}]}], "]"}]}]}], "\[IndentingNewLine]", "}"}],
       "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"qc1", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["2", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["200", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[ImageSize -> 600, Expand -> 2],
    SelectWithContents->True,
    Selectable->False]}], "]"}]}], "Input",
 CellChangeTimes->{{3.94694703218968*^9, 3.9469471154563046`*^9}, {
   3.9469471628089447`*^9, 3.9469471828168507`*^9}, {3.946947232912678*^9, 
   3.946947279056492*^9}, {3.9469473550902023`*^9, 3.9469473847779007`*^9}, {
   3.9469474181489716`*^9, 3.946947450896431*^9}, {3.96903483372674*^9, 
   3.969034835821212*^9}, {3.969034947634267*^9, 3.969034953324403*^9}, {
   3.969036322286393*^9, 3.96903635638404*^9}, {3.969036449313637*^9, 
   3.969036449525955*^9}, {3.9690368037535763`*^9, 3.9690368307237463`*^9}, 
   3.9690427402822533`*^9, {3.969042802619014*^9, 3.969042803394004*^9}, {
   3.969042837764518*^9, 3.969042847924904*^9}, {3.969043670292328*^9, 
   3.9690437886447153`*^9}, {3.9691037454663067`*^9, 3.969103746722299*^9}, {
   3.9691045119186153`*^9, 3.969104513144064*^9}, 3.96928571193731*^9},
 CellLabel->
  "In[423]:=",ExpressionUUID->"3ba7f068-f8a4-49e3-84fa-1272c960dc3b"],

Cell["\<\
Let\[CloseCurlyQuote]s walk through the above circuit step-by-step: \
Initialize the first three wires in 101 (which is 5) and the last three in \
001 (which is 1). Apply QFT to the last three (to move them to the Fourier \
basis), use the phase adder to add in the Fourier basis, then apply the \
inverse QFT to return them to the computational basis. Recall the final \
result is encoded in the last three qubits.\
\>", "Text",
 CellChangeTimes->{{3.9690996392038507`*^9, 3.9690996873263197`*^9}, {
  3.9690997233849154`*^9, 3.969099810831316*^9}, {3.969103719384541*^9, 
  3.969103725282655*^9}, {3.9692857292789507`*^9, 
  3.969285788632946*^9}},ExpressionUUID->"8a7f8632-3b5f-469f-8f83-\
bb713fa8e7f2"],

Cell["\<\
With probability 1, the measured outcome of this circuit gives the state \
corresponding to 4 when the input states both correspond to 2.\
\>", "Text",
 CellChangeTimes->{{3.9469474931565075`*^9, 
  3.946947541964596*^9}},ExpressionUUID->"9ab26b8d-97d5-4d62-a82b-\
fa78807074a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qc1", "[", "]"}], "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.946947468851383*^9, 3.9469474825825176`*^9}, 
   3.969043811577427*^9, {3.969103756173976*^9, 3.9691037596722317`*^9}, 
   3.969104515181715*^9},
 CellLabel->
  "In[425]:=",ExpressionUUID->"4b26fc7b-9522-4996-9030-daa3946fa37c"],

Cell[TextData[{
 "Read the above result as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"101"},
     "Ket"], 
    TemplateBox[{"110"},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "6f4359f2-6aeb-4c6d-a64d-27b01eb40d62"],
 ", where the first three bits, 101, are the original input, and then last \
three bits, 110, are the outcome of addition. Of course the result is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"5", "+", "1"}], "=", "6"}], TraditionalForm]],ExpressionUUID->
  "1d847968-3491-4923-8a82-bc03f4fd66dc"],
 ", which is 110 in base 2:"
}], "Text",
 CellChangeTimes->{{3.9691037780834846`*^9, 3.969103808807743*^9}, {
   3.969285808118822*^9, 3.969285872722822*^9}, 
   3.9717973328722982`*^9},ExpressionUUID->"bf6152a9-2e1f-4fd8-82a1-\
c68c39f0be65"],

Cell[BoxData[
 RowBox[{"FromDigits", "[", 
  RowBox[{"\"\<110\>\"", ",", "2"}], "]"}]], "Input",
 CellChangeTimes->{{3.969285839237276*^9, 3.969285844294962*^9}},
 CellLabel->
  "In[426]:=",ExpressionUUID->"22233eb9-8c0f-4417-b088-2505dd0f6969"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Multiplication", "Section",
 CellChangeTimes->{{3.9470083872655106`*^9, 3.947008400363922*^9}, {
  3.9693108180450573`*^9, 
  3.969310819956957*^9}},ExpressionUUID->"267f984e-571b-4514-93ea-\
0a836bbc2376"],

Cell[TextData[{
 "Multiplication can be achieved through repeated addition. When multiplying \
two numbers representable with ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "9fdfb223-e88b-491b-a4b6-0ad29696a4fc"],
 " bits, the result can always be represented with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "n"}], TraditionalForm]],ExpressionUUID->
  "682ed00c-99e7-494f-89e4-28e59fc59035"],
 " bits. A possible implementation of the multiplication circuit looks like \
this:"
}], "Text",
 CellChangeTimes->{{3.947008625589319*^9, 3.9470086478997517`*^9}, {
  3.947009097856386*^9, 3.9470091506767254`*^9}, {3.9470092288809032`*^9, 
  3.9470092606621704`*^9}, {3.947009313383621*^9, 3.9470093681277065`*^9}, {
  3.969296563870422*^9, 
  3.969296572428174*^9}},ExpressionUUID->"4a23cd48-d6f5-4384-914e-\
2e0c2b44a78a"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "multipicationCircuit", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"multipicationCircuit", "[", "n_Integer", "]"}], "/;", 
   RowBox[{"n", ">", "0"}]}], ":=", "\[IndentingNewLine]", 
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"\"\<Fourier\>\"", "[", 
       RowBox[{"2", "n"}], "]"}], "->", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "n"}], "+", "1"}], ",", 
        RowBox[{"4", "n"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"QuantumCircuitOperator", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Flatten", "@", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\"\<C\>\"", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"\"\<PhaseShift\>\"", "[", 
                RowBox[{"1", "+", "i1", "+", "i2", "-", "r"}], "]"}], "->", 
               RowBox[{
                RowBox[{"4", "n"}], "+", "1", "-", "r"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"r", ",", 
                RowBox[{"i1", "+", "i2"}]}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i1", ",", 
              RowBox[{"i2", "+", "n"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i1", ",", "n"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i2", ",", "n"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", "\"\<\[CapitalPi]\>\""}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\"\<InverseFourier\>\"", "[", 
       RowBox[{"2", "n"}], "]"}], "->", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "n"}], "+", "1"}], ",", 
        RowBox[{"4", "n"}]}], "]"}]}]}], "\[IndentingNewLine]", "}"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.954602513426506*^9, 3.954602518638592*^9}, {
  3.969103959633733*^9, 3.969103964108029*^9}, {3.969111264162722*^9, 
  3.9691112645498457`*^9}, {3.969296367785048*^9, 3.969296387985244*^9}},
 CellLabel->
  "In[427]:=",ExpressionUUID->"47eb44be-dfb0-4d7f-b2f0-c0c78c896a8c"],

Cell["\<\
The above circuit combines QFT and inverse QFT blocks with the multiplication \
subroutine in the Fourier basis.\
\>", "Text",
 CellChangeTimes->{{3.969104001465363*^9, 3.969104052493993*^9}, {
  3.969104318420476*^9, 3.969104319816135*^9}, {3.969111256945553*^9, 
  3.969111257683386*^9}},ExpressionUUID->"25eedfbb-8e68-4fef-9787-\
11db7a29b624"],

Cell[TextData[{
 "As a specific example, let\[CloseCurlyQuote]s consider a circuit that \
multiplies ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Cross]", "4"}], TraditionalForm]],ExpressionUUID->
  "ccabf65c-e955-48f8-8a06-4635027f6088"],
 ". Since 4 needs at least 3-qubit, we shall encode both 3 and 4 in 3-qubit."
}], "Text",
 CellChangeTimes->{{3.9546029033976345`*^9, 3.9546029589921284`*^9}, {
  3.969104323517049*^9, 3.969104333693638*^9}, {3.969108213335927*^9, 
  3.9691082133360043`*^9}, {3.96911129254307*^9, 3.9691112925431147`*^9}, {
  3.969111457252933*^9, 
  3.9691114884506083`*^9}},ExpressionUUID->"9840ff94-2c53-4117-902d-\
5457b5e26ec6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"3", "->", 
    RowBox[{"IntegerString", "[", 
     RowBox[{"3", ",", "2", ",", "3"}], "]"}]}], ",", 
   RowBox[{"4", "->", 
    RowBox[{"IntegerString", "[", 
     RowBox[{"4", ",", "2", ",", "3"}], "]"}]}]}], "}"}]], "Input",
 CellChangeTimes->{{3.96911130061849*^9, 3.969111348444296*^9}, {
  3.9691114928294907`*^9, 3.969111499508024*^9}},
 CellLabel->
  "In[429]:=",ExpressionUUID->"e28bb51d-073a-47c6-bd07-bf6ae33d10cb"],

Cell["Create the multiplication circuit:", "Text",
 CellChangeTimes->{{3.969111502996867*^9, 
  3.969111516237463*^9}},ExpressionUUID->"07ced19c-1d66-4685-b707-\
13b056aef1d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qc2", "=", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\"\<011\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\"\<100\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"4", ",", "5", ",", "6"}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"QuantumCircuitOperator", "[", 
       RowBox[{
        RowBox[{"multipicationCircuit", "[", "3", "]"}], ",", 
        RowBox[{"\"\<ShowLabel\>\"", "->", "False"}]}], "]"}]}], 
     "\[IndentingNewLine]", "}"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9546021626655884`*^9, 3.954602218998871*^9}, {
   3.9546023128349075`*^9, 3.9546023129674034`*^9}, {3.9546027105775223`*^9, 
   3.95460271603973*^9}, {3.954602793073126*^9, 3.954602819924217*^9}, {
   3.9691045578550262`*^9, 3.969104571228449*^9}, 3.969108216583103*^9, {
   3.969111353993371*^9, 3.969111420773519*^9}, {3.969296477564371*^9, 
   3.9692964826307173`*^9}},
 CellLabel->
  "In[430]:=",ExpressionUUID->"8b44ac22-1492-43bd-a59c-8f071c7ca403"],

Cell["Show the circuit diagram:", "Text",
 CellChangeTimes->{{3.969111520527937*^9, 
  3.969111531663522*^9}},ExpressionUUID->"1bae454c-e783-4956-bcef-\
6e41285508eb"],

Cell[BoxData[
 RowBox[{"qc2", "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.9546021626655884`*^9, 3.954602218998871*^9}, {
   3.9546023128349075`*^9, 3.9546023129674034`*^9}, {3.9546027105775223`*^9, 
   3.95460271603973*^9}, {3.954602793073126*^9, 3.954602819924217*^9}, {
   3.9691045578550262`*^9, 3.969104571228449*^9}, 3.969108216583103*^9, {
   3.969111353993371*^9, 3.969111438654361*^9}, 3.9692964906525583`*^9},
 CellLabel->
  "In[431]:=",ExpressionUUID->"b07c145c-1cef-495c-a82d-035304baae98"],

Cell["Show the expanded diagram up to the level 2:", "Text",
 CellChangeTimes->{{3.96911154333331*^9, 
  3.9691115516457157`*^9}},ExpressionUUID->"ece5fb1e-6ad4-4556-87ac-\
7feaf4e4234f"],

Cell[BoxData[
 RowBox[{"qc2", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"\"\<Expand\>\"", "->", "2"}], ",", 
   RowBox[{"ImageSize", "->", "1000"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9691115376956377`*^9, 3.969111541531024*^9}, {
  3.96929649321739*^9, 3.969296513626067*^9}},
 CellLabel->
  "In[432]:=",ExpressionUUID->"ced90790-4abd-44bc-8f2f-4fed3405353b"],

Cell["\<\
As expected, you get 9 with 100% probability when running this circuit:\
\>", "Text",
 CellChangeTimes->{{3.9546029696155186`*^9, 3.95460299268272*^9}, {
  3.969104608675994*^9, 
  3.9691046204724894`*^9}},ExpressionUUID->"79441a7f-d180-458d-b05c-\
221b33060b65"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Chop", "[", 
   RowBox[{
    RowBox[{"N", "[", "qc2", "]"}], "[", "]"}], "]"}], "[", "\"\<Formula\>\"",
   "]"}]], "Input",
 CellChangeTimes->{{3.9546022758165474`*^9, 3.9546022970720215`*^9}, {
   3.969104562914838*^9, 3.969104602082067*^9}, 3.9692965212265987`*^9},
 CellLabel->
  "In[433]:=",ExpressionUUID->"3a2d13dc-3641-4159-a2e2-f8eb1317f693"],

Cell[TextData[{
 "Read the above result as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"011"},
     "Ket"], 
    TemplateBox[{"100"},
     "Ket"], 
    TemplateBox[{
      RowBox[{"\[InvisibleSpace]", 
        RowBox[{
         "0", "\[InvisibleSpace]", "0", "\[InvisibleSpace]", "1", 
          "\[InvisibleSpace]", "1", "\[InvisibleSpace]", "0", 
          "\[InvisibleSpace]", "0"}]}]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "b746110e-61c9-4125-bd94-c3b131616aab"]
}], "Text",
 CellChangeTimes->{{3.969104642350093*^9, 3.969104646183654*^9}, {
  3.969108155159341*^9, 3.96910815538767*^9}, {3.9691082234087667`*^9, 
  3.969108234628961*^9}, {3.969111590402226*^9, 
  3.969111605455426*^9}},ExpressionUUID->"67f680c5-0b3c-4f31-b55f-\
8b8ac7fdf2ee"],

Cell["001100 bit-string corresponds to 12:", "Text",
 CellChangeTimes->{{3.969100008138946*^9, 3.96910001375028*^9}, {
  3.969104630786178*^9, 3.969104633795672*^9}, {3.969111610535614*^9, 
  3.9691116348534718`*^9}},ExpressionUUID->"f542e652-5c56-4356-a47c-\
28e436b5b90e"],

Cell[BoxData[
 RowBox[{"FromDigits", "[", 
  RowBox[{"\"\<001100\>\"", ",", "2"}], "]"}]], "Input",
 CellChangeTimes->{{3.969099975102889*^9, 3.9691000049366302`*^9}, {
  3.969111612581725*^9, 3.969111629681003*^9}},
 CellLabel->
  "In[434]:=",ExpressionUUID->"6c7245e1-ed24-437d-9cf3-60f31b95e44d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Quantum Phase Estimation Algorithm", "Chapter",
 CellChangeTimes->{{3.9458857100891*^9, 3.9458857172175865`*^9}, {
  3.9465031062482376`*^9, 3.9465031093830967`*^9}, {3.9548600165236435`*^9, 
  3.9548600183114033`*^9}, {3.954865230987444*^9, 
  3.9548652449129086`*^9}},ExpressionUUID->"9b757fa1-85c8-49f7-9118-\
9e3342f0bba7"],

Cell["\<\
We will discuss the Quantum Phase Estimation (QPE) algorithm. This algorithm \
estimates the eigenvlaues of a unitary by applying controlled powers of it to \
an eigenstate, imprinting the phase on ancilla qubits, then using the inverse \
quantum Fourier transform to read out a binary approximation; precision \
scales with the number of ancillas, enabling applications like factoring and \
eigenvalue estimation.\
\>", "Text",
 CellChangeTimes->{{3.96885788589627*^9, 3.9688578869934187`*^9}, {
  3.968862841679327*^9, 
  3.9688628825637007`*^9}},ExpressionUUID->"3bfab491-6119-4185-abd0-\
0444b537d973"],

Cell[CellGroupData[{

Cell["Key Concepts", "Section",
 CellChangeTimes->{{3.9458857262477703`*^9, 
  3.945885728184759*^9}},ExpressionUUID->"b57399f7-56e8-4263-8e22-\
a2b891bd582f"],

Cell["Eigenvalue", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, {
  3.9459508180356083`*^9, 3.9459508219695263`*^9}, {3.9465031788793373`*^9, 
  3.9465031894301834`*^9}, {3.9548600289721966`*^9, 
  3.954860032093584*^9}},ExpressionUUID->"c2d3a2b6-3159-49d1-85bc-\
d8d2821806fd"],

Cell["Eigenvector", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, 
   3.945966437091715*^9, {3.94650320037673*^9, 3.9465032026390457`*^9}, {
   3.9465034302710743`*^9, 3.9465034355196266`*^9}, {3.9465079620495815`*^9, 
   3.94650798489847*^9}, {3.946921626805523*^9, 3.9469216289980717`*^9}, {
   3.954860034753294*^9, 3.9548600366745224`*^9}, {3.968858353586076*^9, 
   3.968858353589572*^9}},ExpressionUUID->"cd782773-2faa-47c6-8543-\
251fc6ce77c7"],

Cell["Quantum Fourier Transform", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, 
   3.945966437091715*^9, {3.94650320037673*^9, 3.9465032026390457`*^9}, {
   3.9465034302710743`*^9, 3.9465034355196266`*^9}, {3.9465079620495815`*^9, 
   3.94650798489847*^9}, {3.946921626805523*^9, 3.9469216289980717`*^9}, {
   3.954860034753294*^9, 3.9548600366745224`*^9}, {3.9688583541316547`*^9, 
   3.968858362676573*^9}, {3.96921429548876*^9, 
   3.969214295492465*^9}},ExpressionUUID->"b4f452b5-913c-40eb-8969-\
4c3697cca45d"],

Cell["Quantum Phase Estimation (QPE)", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, 
   3.945966437091715*^9, {3.94650320037673*^9, 3.9465032026390457`*^9}, {
   3.9465034302710743`*^9, 3.9465034355196266`*^9}, {3.9465079620495815`*^9, 
   3.94650798489847*^9}, {3.946921626805523*^9, 3.9469216289980717`*^9}, {
   3.954860034753294*^9, 3.9548600366745224`*^9}, {3.9688583541316547`*^9, 
   3.968858362676573*^9}, 3.9692142957142057`*^9, {3.969537705081559*^9, 
   3.969537705352316*^9}},ExpressionUUID->"a5cadfe9-8915-41b3-a9aa-\
f16fe5330120"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Eigenvectors and Eigenvalues", "Section",
 CellChangeTimes->{{3.954861042637863*^9, 3.9548610444211025`*^9}, {
  3.9548611026948166`*^9, 
  3.954861115208996*^9}},ExpressionUUID->"9cc8e770-b37d-45d4-b41c-\
79e2590f8b61"],

Cell["\<\
Eigenvectors and eigenvalues are concepts from the theory of linear algebra, \
and they are frequently used in analyzing the solutions of all sorts of \
mathematical models.\
\>", "Text",
 CellChangeTimes->{{3.9549304840647354`*^9, 
  3.9549305276990128`*^9}},ExpressionUUID->"887ba938-c2ce-4f1d-92cb-\
87dddb6cdda9"],

Cell[TextData[{
 "From linear algebra and the theory of matrices, you should recall that an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[Cross]", "n"}], TraditionalForm]],ExpressionUUID->
  "fe3d046a-3cb7-4c84-84c9-f3e0ec0dedb0"],
 " matrix acting on an ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "e6b45710-e8a7-4e59-a7a1-66d10ac0cb9f"],
 " dimensional vector will give another ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "cf65ecf0-efe9-4d35-a82a-3b5e4fb2f634"],
 " dimensional vector. In the case of real numbers, it is only the case that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", " ", "x"}], "=", 
    RowBox[{"b", " ", "x"}]}], TraditionalForm]],ExpressionUUID->
  "ee9dc819-a16a-4e59-94e7-0e0b30550e2b"],
 " if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", "b"}], TraditionalForm]],ExpressionUUID->
  "d69d3316-0132-425a-90d6-dea3fb3dbcf7"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "77b216fd-ac59-4ac2-a213-63517ef56a00"],
 ". For square matrices, it is possible to have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", " ", 
     OverscriptBox["x", "\[RightVector]"]}], "=", 
    RowBox[{"\[Lambda]", " ", 
     OverscriptBox["x", "\[RightVector]"]}]}], TraditionalForm]],
  ExpressionUUID->"1cef773c-9a2d-423d-901e-fbd578ac8fc1"],
 " for a real number, \[Lambda]. When this happens ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "654a7615-d891-4d32-b84e-31f17e855546"],
 " is called an eigenvector of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "5915cdad-8bf2-42b0-9ecd-843047ebb6bc"],
 " and \[Lambda] is the corresponding eigenvalue of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "49e08c36-5569-4390-b656-262159ddb4d4"],
 "."
}], "Text",
 CellChangeTimes->{{3.9548612201113224`*^9, 3.9548612465416985`*^9}, {
  3.954861287646799*^9, 3.954861314733639*^9}, {3.954861350647892*^9, 
  3.954861362524599*^9}, {3.95486145526947*^9, 3.95486157107498*^9}, {
  3.9548616853326263`*^9, 
  3.954861854928505*^9}},ExpressionUUID->"c58b3238-77c9-41d6-9b83-\
4c3c356880e0"],

Cell["\<\
As an example, consider the matrix corresponding to the Pauli Z operator in \
the computational basis:\
\>", "Text",
 CellChangeTimes->{{3.954861858435446*^9, 
  3.9548619490837*^9}},ExpressionUUID->"377289b3-81ab-4c93-9053-81556716315d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PauliMatrix", "[", "3", "]"}], "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.9548619186338196`*^9, 3.954861963435734*^9}, {
  3.9688580534927187`*^9, 3.9688580614205637`*^9}},
 CellLabel->
  "In[435]:=",ExpressionUUID->"8cefbe59-2d97-45d1-889d-4c15429be537"],

Cell[TextData[{
 "You can compute the eigenvalues and eigenvectors of this matrix using the ",
 Cell[BoxData[
 "Eigensystem"], "InlineCode",ExpressionUUID->
  "4988900e-f127-4ebc-a6aa-b3650e4faa38"],
 " function:"
}], "Text",
 CellChangeTimes->{{3.9548620042832127`*^9, 
  3.954862032044487*^9}},ExpressionUUID->"2a4d1642-f133-4011-87f3-\
ad4b65257f40"],

Cell[BoxData[
 RowBox[{"Eigensystem", "[", 
  RowBox[{"PauliMatrix", "[", "3", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.9548620353846855`*^9, 3.9548620734900494`*^9}, 
   3.968858075776746*^9},
 CellLabel->
  "In[436]:=",ExpressionUUID->"2bf068f5-66a6-4241-96e7-9032264bd435"],

Cell[TextData[{
 "These are the lists of eigenvalues followed by the eigenvectors. Let\
\[CloseCurlyQuote]s look at them in the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "i"], "->", 
    SubscriptBox[
     OverscriptBox["x", "\[RightVector]"], "i"]}], TraditionalForm]],
  ExpressionUUID->"5e9132fa-d35c-479b-a2fc-70327c7245a9"],
 ":"
}], "Text",
 CellChangeTimes->{{3.954862114047312*^9, 3.954862127510866*^9}, {
  3.9548621804708424`*^9, 
  3.9548622368194103`*^9}},ExpressionUUID->"114ec6e4-598c-4e30-9171-\
14127a5b864c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], 
   "[", "\"\<Eigensystem\>\"", "]"}], "//", 
  RowBox[{"MapThread", "[", "Rule", "]"}]}]], "Input",
 CellChangeTimes->{{3.9548621320737267`*^9, 3.9548621897072105`*^9}, {
  3.9548624287497654`*^9, 3.9548624394925003`*^9}, {3.954864726315386*^9, 
  3.954864738565136*^9}},
 CellLabel->
  "In[437]:=",ExpressionUUID->"6514309a-584e-43ee-9e6f-313a95e3a86f"],

Cell[TextData[{
 "You can see from the eigenvectors that the state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"0"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "7fa91299-231c-4b3e-84b8-ed20bef4cc93"],
 " corresponds to the positive eigenvalue of the Pauli Z operator. Similarly, \
the state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"1"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "8500b47a-1841-490d-9bbe-12d33e95639d"],
 " corresponds to the negative eigenvalue of the Pauli Z operator. That\
\[CloseCurlyQuote]s the conventional we also use to define the computational \
basis:"
}], "Text",
 CellChangeTimes->{{3.954862450398628*^9, 3.9548626097978516`*^9}, 
   3.9552068033096905`*^9, {3.9688606261022263`*^9, 
   3.968860646180036*^9}},ExpressionUUID->"c994c7d2-c0db-43bf-b008-\
89eca74c60ce"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", "\"\<Computational\>\"", "]"}], 
  "[", "\"\<ElementAssociation\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.9548622665848713`*^9, 3.9548623013527374`*^9}},
 CellLabel->
  "In[438]:=",ExpressionUUID->"6329080c-7b63-4808-a83e-3fc9591645ba"],

Cell[TextData[{
 "If a matrix is Hermitian (i.e., ",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", "=", 
    SuperscriptBox["H", "\[Dagger]"]}], TraditionalForm]],ExpressionUUID->
  "0818ed24-cf12-4130-a6c1-1bdb221bb61f"],
 ") then its eigenvalues are always real. For example, matrices drawn from ",
 Cell["GaussianUnitaryMatrixDistribution",ExpressionUUID->
  "e65ae18c-73fe-460c-a861-1cd858ccf572"],
 " are Hermitian:"
}], "Text",
 CellChangeTimes->{{3.9688620115085173`*^9, 3.968862037778253*^9}, {
  3.968862082059696*^9, 
  3.968862101215003*^9}},ExpressionUUID->"160bbf42-8544-46d8-929b-\
0cf1beb46b0e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"h", "=", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{"GaussianUnitaryMatrixDistribution", "[", "9", "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.96886204508012*^9, 3.968862073615726*^9}},
 CellLabel->
  "In[439]:=",ExpressionUUID->"bd30ed52-509f-4090-8f56-6e06e3df12ab"],

Cell["Check the matrix is Hermitian:", "Text",
 CellChangeTimes->{{3.96886210583854*^9, 
  3.96886211844646*^9}},ExpressionUUID->"f3669c19-767a-4d47-9c73-\
b32c70059bcb"],

Cell[BoxData[
 RowBox[{"HermitianMatrixQ", "[", "h", "]"}]], "Input",
 CellChangeTimes->{{3.968862077756769*^9, 3.968862080095607*^9}},
 CellLabel->
  "In[440]:=",ExpressionUUID->"26be47a7-c88e-46de-91d4-2ac5c4637dbc"],

Cell["Check all eigenvalues are Real:", "Text",
 CellChangeTimes->{{3.96886213270751*^9, 
  3.968862142386786*^9}},ExpressionUUID->"887846ee-b013-4521-9102-\
d457873f240f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Eigenvalues", "[", "h", "]"}], "\[Element]", "Reals"}]], "Input",
 CellChangeTimes->{{3.968862039315548*^9, 3.968862041790798*^9}, {
  3.96886212165195*^9, 3.96886212851987*^9}},
 CellLabel->
  "In[441]:=",ExpressionUUID->"c9365a1c-f8ec-4caa-9066-8ef3383f71ff"],

Cell[TextData[{
 "Gate operators in a quantum circuit are unitary. \
\[OpenCurlyDoubleQuote]Unitary\[CloseCurlyDoubleQuote] means the matrix\
\[CloseCurlyQuote]s conjugate transpose equals its inverse: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["U", "\[Dagger]"], "=", 
    SuperscriptBox["U", 
     RowBox[{"-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "1dd36b55-42d7-4cc7-ba7a-2a234066b2c7"],
 ". "
}], "Text",
 CellChangeTimes->{{3.954863635654684*^9, 3.9548636426317406`*^9}, {
  3.954863921759409*^9, 3.95486394083078*^9}, {3.9548641226390324`*^9, 
  3.9548641432056828`*^9}, {3.9548641838942432`*^9, 3.954864201221367*^9}, {
  3.9688581071163*^9, 3.968858112433444*^9}, {3.9688607163144827`*^9, 
  3.968860717352737*^9}, {3.969311118466106*^9, 
  3.969311135926724*^9}},ExpressionUUID->"530384dd-fd8b-4a8d-b0ed-\
d0c587ac7e8a"],

Cell[TextData[{
 "For example, let\[CloseCurlyQuote]s check that Pauli operators are unitary ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Sigma]", "j", "\[Dagger]"], "=", 
    SubsuperscriptBox["\[Sigma]", "j", 
     RowBox[{"-", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "daa3918b-aaee-441e-abd1-5e1c9abd92f8"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"j", "=", "x"}], ",", "y", ",", "z"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bd7ca91d-c72a-4cb1-b799-86ce828f9811"],
 ":"
}], "Text",
 CellChangeTimes->{{3.968860747487945*^9, 3.968860759517974*^9}, {
  3.969390689454917*^9, 
  3.969390719601182*^9}},ExpressionUUID->"b8b46aaa-de28-4909-bb5e-\
197abfcd756e"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", 
     RowBox[{"PauliMatrix", "[", "j", "]"}], "]"}], "==", 
    RowBox[{"Inverse", "[", 
     RowBox[{"PauliMatrix", "[", "j", "]"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"j", ",", "3"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.968860726284998*^9, 3.9688607451344347`*^9}},
 CellLabel->
  "In[442]:=",ExpressionUUID->"b2834b68-ff7a-4ddc-b0d7-be5d0f6d76cc"],

Cell["\<\
Of course, there is also a direct way of checking unitarity in the Wolfram \
Language:\
\>", "Text",
 CellChangeTimes->{{3.968860775113905*^9, 
  3.96886079230995*^9}},ExpressionUUID->"dbed5e2c-335f-416c-9593-\
9d0f0feb32da"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"UnitaryMatrixQ", "[", 
    RowBox[{"PauliMatrix", "[", "j", "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"j", ",", "3"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.968860766424971*^9, 3.968860772818594*^9}},
 CellLabel->
  "In[443]:=",ExpressionUUID->"0a68b491-45dc-4c52-b931-cd5f48ad0eab"],

Cell[TextData[{
 "For a unitary matrix, its eigenvalues are of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"U", 
     TemplateBox[{"\[Lambda]"},
      "Ket"]}], "=", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", " ", "\[Theta]"}]], 
     TemplateBox[{"\[Lambda]"},
      "Ket"]}]}], TraditionalForm]],ExpressionUUID->
  "6663e17d-b652-49e6-abb0-b364fa0be9e7"],
 " for a real number ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "4c7fc5ac-98a2-4331-8e01-8442aa5fca8b"],
 " which is usually called as ",
 StyleBox["eigenphase (",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<=", "\[Theta]", "<", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0c3ef7fd-83e3-4810-91aa-494c7d35102d"],
 StyleBox[")",
  FontSlant->"Italic"],
 ". Let\[CloseCurlyQuote]s explore this feature explicitly ."
}], "Text",
 CellChangeTimes->{{3.954864226844986*^9, 3.954864243169237*^9}, {
   3.9548643436407833`*^9, 3.9548645030144825`*^9}, {3.954865015947836*^9, 
   3.9548650184528713`*^9}, {3.968860938973349*^9, 3.968860948568408*^9}, {
   3.969390741884358*^9, 3.9693907452264214`*^9}, 3.969390855927434*^9, {
   3.969453994814495*^9, 
   3.969454033162387*^9}},ExpressionUUID->"92e35011-f310-402e-a14a-\
dbfd73868aa4"],

Cell[TextData[{
 "Find eigenvalues of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[ImaginaryI]", 
     FractionBox[
      RowBox[{" ", "\[Pi]"}], "3"], 
     SubscriptBox["\[Sigma]", "z"]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3d0fb3ac-1143-4845-bf19-9780a7faf005"],
 ":"
}], "Text",
 CellChangeTimes->{{3.969390988787932*^9, 3.969390995966223*^9}, {
  3.969391094218548*^9, 
  3.969391118591659*^9}},ExpressionUUID->"a00054a2-5e6a-4c6a-8344-\
c7a3bef8de7d"],

Cell[BoxData[
 RowBox[{"\[Lambda]3", "=", 
  RowBox[{"Eigenvalues", "[", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{"\[ImaginaryI]", " ", 
     FractionBox["\[Pi]", "3"], 
     RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9693907473081923`*^9, 3.969390793028776*^9}, {
  3.96939085886091*^9, 3.969390978327401*^9}, {3.969391123507597*^9, 
  3.96939120245465*^9}},
 CellLabel->
  "In[444]:=",ExpressionUUID->"34d701e0-cd45-4280-bef3-0c442f957563"],

Cell["Find the corresponding eigenphases:", "Text",
 CellChangeTimes->{{3.969390997933477*^9, 3.9693910021069*^9}, {
  3.969453966405232*^9, 
  3.969453981868321*^9}},ExpressionUUID->"9a24ddaf-d26f-4909-a34d-\
36a5a1d187e7"],

Cell[BoxData[
 RowBox[{"\[Theta]3", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Mod", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"Arg", "[", "#", "]"}], 
       RowBox[{"2", "\[Pi]"}]], ",", "1"}], "]"}], "&"}], "/@", 
   "\[Lambda]3"}]}]], "Input",
 CellChangeTimes->{{3.9693907473081923`*^9, 3.969390793028776*^9}, {
  3.96939085886091*^9, 3.9693909545566673`*^9}, {3.969391186783392*^9, 
  3.969391205952601*^9}},
 CellLabel->
  "In[445]:=",ExpressionUUID->"b097e834-6668-41d6-9193-980e1c4a570e"],

Cell[TextData[{
 "Verify ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "=", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", " ", "\[Theta]"}]]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "667858cf-fe68-4d3b-85d9-7a49b01657df"],
 ":"
}], "Text",
 CellChangeTimes->{{3.969391004706669*^9, 
  3.969391025872382*^9}},ExpressionUUID->"982bcc7e-1809-4e43-95de-\
4bbded595af6"],

Cell[BoxData[
 RowBox[{"\[Lambda]3", "==", 
  RowBox[{"Exp", "[", 
   RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", " ", "\[Theta]3"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9693909254624767`*^9, 3.969390957663207*^9}},
 CellLabel->
  "In[446]:=",ExpressionUUID->"0f841a03-ab44-4dc5-aded-5ab4e04aeeaf"],

Cell["Let\[CloseCurlyQuote]s consider a random unitary matrix:", "Text",
 CellChangeTimes->{{3.9548649295548706`*^9, 3.9548649443064957`*^9}, {
  3.9688608017237177`*^9, 3.968860804133922*^9}, {3.969391029864987*^9, 
  3.969391030450795*^9}},ExpressionUUID->"17629251-9395-4eaa-9a58-\
e324608a87ed"],

Cell[BoxData[
 RowBox[{"randomU", "=", 
  RowBox[{"QuantumOperator", "[", 
   RowBox[{"\"\<RandomUnitary\>\"", ",", 
    RowBox[{"\"\<Label\>\"", "->", "\"\<U\>\""}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9548647610815506`*^9, 3.9548647753252087`*^9}, {
  3.9548649501168365`*^9, 3.954864954106409*^9}, {3.9548689354550495`*^9, 
  3.9548689709019527`*^9}, {3.9693111711978807`*^9, 3.969311173200425*^9}, {
  3.969391033301751*^9, 3.969391033997099*^9}, {3.96944531493034*^9, 
  3.969445321249427*^9}},
 CellLabel->
  "In[447]:=",ExpressionUUID->"f2c7fd17-cd3d-4c9a-8a37-c660715a9812"],

Cell["\<\
Remember that any random generation follows a specific distribution. Here, \
the random unitaries are sampled uniformly from the unitary group (the Haar \
measure over n-dimensional unitary matrices).\
\>", "Text",
 CellChangeTimes->{{3.968860808588066*^9, 3.968860839580051*^9}, {
  3.968860871487986*^9, 
  3.968860905936142*^9}},ExpressionUUID->"956b0849-673d-42de-bbca-\
f73ebaac2cf3"],

Cell["\<\
Given above random unitary operator, let\[CloseCurlyQuote]s obtain its \
eigenvalues:\
\>", "Text",
 CellChangeTimes->{{3.9548649714208546`*^9, 3.954864975379925*^9}, {
  3.9688609084024754`*^9, 
  3.9688609229110527`*^9}},ExpressionUUID->"e460be5f-7c45-458d-830b-\
eaf1e4114623"],

Cell[BoxData[
 RowBox[{"\[Lambda]s", "=", 
  RowBox[{"randomU", "[", "\"\<Eigenvalues\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.9548649591498337`*^9, 3.9548649676135197`*^9}, {
   3.9548650547611294`*^9, 3.9548650582002583`*^9}, 3.969311176491523*^9},
 CellLabel->
  "In[448]:=",ExpressionUUID->"7cbb4fc2-19a8-4383-8e9b-da585395e559"],

Cell[TextData[{
 "Find eigenphases \[Theta] such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "=", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", " ", "\[Theta]"}]]}], 
   TraditionalForm]],ExpressionUUID->"ba6d403d-90dc-4a18-96e7-05d581f362e5"],
 ":"
}], "Text",
 CellChangeTimes->{{3.954864986149494*^9, 3.9548650520232716`*^9}, {
  3.9694540519650593`*^9, 
  3.969454053949356*^9}},ExpressionUUID->"ead08100-e1fb-4b99-b65b-\
d2597407aca0"],

Cell[BoxData[
 RowBox[{"\[Theta]s", "=", 
  RowBox[{"Mod", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"Arg", "[", "\[Lambda]s", "]"}], 
     RowBox[{"2", "\[Pi]"}]], ",", "1"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9548647927825623`*^9, 3.9548648311123257`*^9}, {
  3.954865066315548*^9, 3.9548650743985634`*^9}, {3.954865109012377*^9, 
  3.9548651120550766`*^9}, {3.969391062649694*^9, 3.96939107208025*^9}},
 CellLabel->
  "In[449]:=",ExpressionUUID->"9cb70ee5-e33a-4c21-be2a-e636c363aa5f"],

Cell[TextData[{
 "Verify the relation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "=", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", " ", "\[Theta]"}]]}], 
   TraditionalForm]],ExpressionUUID->"2f20e6b9-9841-4881-a2a5-e117c0158877"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9548650987602577`*^9, 3.9548651048051357`*^9}, {
  3.969391239767123*^9, 
  3.969391245322297*^9}},ExpressionUUID->"5037a50e-6d80-439e-b675-\
e60289aa9b0c"],

Cell[BoxData[
 RowBox[{"\[Lambda]s", "==", 
  RowBox[{"Exp", "[", 
   RowBox[{"2", " ", "\[Pi]", " ", "I", " ", "\[Theta]s"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9548651202185593`*^9, 3.9548651523192425`*^9}, {
  3.9693910744246807`*^9, 3.969391074700077*^9}},
 CellLabel->
  "In[450]:=",ExpressionUUID->"6a547b8b-6a79-4ffc-bd0f-65336ad77933"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Quantum Phase Estimation: Simple Example", "Section",
 CellChangeTimes->{{3.954863611171112*^9, 3.954863614809635*^9}, {
  3.969542694209902*^9, 3.96954269587603*^9}, {3.969977108153409*^9, 
  3.969977109849436*^9}},ExpressionUUID->"a4433131-7d5b-442f-aa80-\
cac320b08f98"],

Cell["\<\
So far we computed eigenvalues classically. Quantum Phase Estimation uses \
phase kickback to extract an eigenstate\[CloseCurlyQuote]s phase, providing \
the information needed to recover the eigenvalues. For pedagogical purposes, \
consider the following unitary operator; we will use QPE to estimate its \
eigenphases.\
\>", "Text",
 CellChangeTimes->{{3.954865175098461*^9, 3.9548652238434696`*^9}, {
   3.9548652564879208`*^9, 3.954865272598831*^9}, {3.96886098979128*^9, 
   3.968861082112136*^9}, 3.969453944753478*^9, {3.9694714368435507`*^9, 
   3.969471511046392*^9}, 3.969471642422386*^9, {3.969537668058505*^9, 
   3.96953770290582*^9}, {3.9695377343200827`*^9, 
   3.969537736436184*^9}},ExpressionUUID->"3b922228-0e27-438c-8100-\
f43b9ad7246a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u", "=", 
   RowBox[{"QuantumOperator", "@", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"Exp", "[", 
      RowBox[{"\[ImaginaryI]", " ", "2", "\[Pi]", " ", 
       RowBox[{"{", 
        RowBox[{".17", ",", 
         RowBox[{".17", "+", 
          SuperscriptBox["2", 
           RowBox[{"-", "n"}]]}]}], "}"}]}], "]"}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9694720062384663`*^9, 3.969472111501473*^9}, {
  3.969474024980217*^9, 3.9694740271108427`*^9}, {3.969474276304865*^9, 
  3.969474339984292*^9}, {3.969474373125049*^9, 3.969474373768779*^9}, {
  3.9695377858221893`*^9, 3.969537789353842*^9}},
 CellLabel->
  "In[451]:=",ExpressionUUID->"f7e7a790-68a6-4c85-8b46-9906bf8ceaa0"],

Cell["Calculate the eigenvalues:", "Text",
 CellChangeTimes->{{3.969537739751091*^9, 3.969537746801622*^9}, {
  3.969542647201721*^9, 
  3.969542650776886*^9}},ExpressionUUID->"b0bc3b13-5080-4eae-a156-\
01337c966d56"],

Cell[BoxData[
 RowBox[{"\[Lambda]s", "=", 
  RowBox[{"u", "[", "\"\<Eigenvalues\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.9694743437806063`*^9, 3.96947437081608*^9}, {
  3.9695377517636223`*^9, 3.969537757639905*^9}},
 CellLabel->
  "In[453]:=",ExpressionUUID->"85fa8123-8fd5-4207-9374-0bd93cf8737a"],

Cell["Calculate the eigenphases:", "Text",
 CellChangeTimes->{{3.96954264146095*^9, 
  3.9695426532109222`*^9}},ExpressionUUID->"3eb43590-7cb6-495f-9f66-\
3d426c3d5527"],

Cell[BoxData[
 RowBox[{"\[Theta]s", "=", 
  RowBox[{"Mod", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"Arg", "[", "\[Lambda]s", "]"}], 
     RowBox[{"2", "\[Pi]"}]], ",", "1"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9694743437806063`*^9, 3.96947437081608*^9}, {
  3.9695377517636223`*^9, 3.969537761651679*^9}},
 CellLabel->
  "In[454]:=",ExpressionUUID->"a0a8c9f4-74bc-447d-9e72-52320b911e7c"],

Cell[TextData[{
 "Consider a sequence of controlled gates that use the power a unitary \
operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox["U", 
      SuperscriptBox["2", "0"]], ",", 
     SuperscriptBox["U", 
      SuperscriptBox["2", "1"]], ",", "\[Ellipsis]", ",", 
     SuperscriptBox["U", 
      SuperscriptBox["2", 
       RowBox[{"n", "-", "1"}]]]}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bc3818d7-6c9c-4243-8154-bf95b76543b0"],
 " where the target qubit is always qubit ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "649ea8c0-78db-4c3f-82c5-869e80a417f4"],
 " while the control qubit for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["U", 
    SuperscriptBox["2", "j"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8d54fce3-8169-4454-9a07-990ec346760b"],
 " is qubit ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "j"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c3b22b14-e051-4f80-b582-cb48eabc92d2"],
 ". For example, for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "3"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "23265ce5-0c28-4504-8003-e38961fb08bd"],
 ", the sequence looks like this:"
}], "Text",
 CellChangeTimes->{{3.969408188874102*^9, 3.969408192807785*^9}, {
  3.969446000883184*^9, 3.969446056350354*^9}, {3.969446137784437*^9, 
  3.9694462427533417`*^9}},ExpressionUUID->"4cd05656-f14c-4fee-8e50-\
3828067e97c2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "qpeControl", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"qpeControl", "[", "n_", "]"}], ":=", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"\"\<C\>\"", "[", 
       RowBox[{
        RowBox[{"QuantumOperator", "[", 
         RowBox[{
          SuperscriptBox["u", 
           SuperscriptBox["2", "j"]], ",", 
          RowBox[{"{", 
           RowBox[{"n", "+", "1"}], "}"}], ",", 
          RowBox[{"\"\<Label\>\"", "->", 
           RowBox[{"Superscript", "[", 
            RowBox[{"\"\<U\>\"", ",", 
             RowBox[{"Superscript", "[", 
              RowBox[{"\"\<2\>\"", ",", 
               RowBox[{"ToString", "[", "j", "]"}]}], "]"}]}], "]"}]}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", "-", "j"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "0", ",", 
        RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"qpeControl", "[", "n", "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "->", "150"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.969445466826335*^9, 3.969445471723672*^9}, {
   3.969445589563652*^9, 3.9694456549056892`*^9}, {3.96944577117599*^9, 
   3.969445821273035*^9}, {3.9694458556682787`*^9, 3.969445964034445*^9}, {
   3.969446086536875*^9, 3.969446123075639*^9}, {3.969446348523099*^9, 
   3.969446354137989*^9}, {3.9694464016693363`*^9, 3.969446402475421*^9}, {
   3.9694531521513147`*^9, 3.96945319213307*^9}, 3.9694740307731037`*^9, {
   3.969534593482445*^9, 3.969534594172984*^9}},
 CellLabel->
  "In[455]:=",ExpressionUUID->"b1ad0e2e-cfc3-4eed-b096-50cea5ef38f7"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s see how the above circuit transforms the state of an \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "75203011-c6f4-46d0-9cef-0fa56dc46cde"],
 "-qubit system. Consider a system of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "511eaf7c-ea3d-43ee-991b-f5e658c702bd"],
 " qubits prepared in an initial separable state as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"\[Psi]"},
     "Ket"], 
    TemplateBox[{"\[Theta]"},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "5de6a04b-f8b3-4e24-9392-0b97a22a2dba"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"\[Psi]"},
     "Ket"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"x", "=", "0"}], 
      RowBox[{
       SuperscriptBox["2", "n"], "-", "1"}]], 
     RowBox[{
      SubscriptBox["c", "x"], 
      TemplateBox[{"x"},
       "Ket"]}]}]}], TraditionalForm]],ExpressionUUID->
  "89930f30-2877-4ae1-9238-21d3919c9a85"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"\[Theta]"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "bbbbb6fe-f7db-4069-af63-f9a3fa203440"],
 " any one qubit state for the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", " ", "+", " ", 
    SuperscriptBox["1", "th"]}], TraditionalForm]],ExpressionUUID->
  "ef2d4abf-9ad2-46a3-a341-ba69904fbfd7"],
 " qubit. The circuit above transforms the state of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "761938dd-e86e-446b-b9ca-3951df8661a9"],
 " qubits as follows: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     TemplateBox[{"\[Psi]"},
      "Ket"], 
     TemplateBox[{"\[Theta]"},
      "Ket"]}], "->", " ", 
    FormBox[
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"x", "=", "0"}], 
       RowBox[{
        SuperscriptBox["2", "n"], "-", "1"}]], 
      RowBox[{
       SubscriptBox["c", "x"], 
       RowBox[{
        TemplateBox[{"x"},
         "Ket"], "(", 
        RowBox[{
         SuperscriptBox["U", "x"], 
         TemplateBox[{"\[Theta]"},
          "Ket"]}], ")"}]}]}],
     TraditionalForm]}], TraditionalForm]],ExpressionUUID->
  "6b201ece-61d5-461d-acce-037faabb2170"],
 ".\nFor example, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "3"}], TraditionalForm]],ExpressionUUID->
  "46f7a67c-a029-467e-a859-9efae0246a6f"],
 ", you get:"
}], "Text",
 CellChangeTimes->{{3.969446255407744*^9, 3.969446282010429*^9}, {
   3.96944755461033*^9, 3.969447804081181*^9}, {3.969447930351205*^9, 
   3.969448006872656*^9}, {3.9694482038947983`*^9, 3.9694482304971848`*^9}, {
   3.969448364373282*^9, 3.969448373279476*^9}, {3.969448427073989*^9, 
   3.969448434485362*^9}, 3.969448507758583*^9, 
   3.9717973546476803`*^9},ExpressionUUID->"6ab6494c-2819-49fb-9d75-\
b999264dbd57"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Partition", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "power", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"power", "=", 
           RowBox[{"Total", "@", 
            RowBox[{"MapIndexed", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#1", " ", 
                SuperscriptBox["2", 
                 RowBox[{"n", "-", 
                  RowBox[{"#2", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}]]}], "&"}], ",", "bits"}], 
             "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"qpeControl", "[", "n", "]"}], "[", 
           RowBox[{"\"\<Diagram\>\"", ",", 
            RowBox[{"ImageSize", "->", "150"}], ",", 
            RowBox[{"\"\<WireLabels\>\"", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Sequence", "@@", 
                RowBox[{"Thread", "[", 
                 RowBox[{
                  RowBox[{"Table", "[", 
                   RowBox[{"j", ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "n"}], "}"}]}], "]"}], "->", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Placed", "[", 
                    RowBox[{"#", ",", "Right"}], "]"}], ",", 
                    RowBox[{"Placed", "[", 
                    RowBox[{"#", ",", "Left"}], "]"}]}], "}"}], "&"}], "/@", 
                    "bits"}], ")"}]}], "]"}]}], ",", 
               RowBox[{
                RowBox[{"n", "+", "1"}], "->", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Placed", "[", 
                   RowBox[{
                    TagBox[
                    StyleBox[
                    RowBox[{"\"\<\\!\\(\\*SuperscriptBox[\\(U\\), \\(\>\"", "<>", 
                    RowBox[{"ToString", "[", "power", "]"}], 
                    "<>", "\"\<\\)]\\)\\!\\(\\*TemplateBox[{\\\"\\[Theta]\\\"}\
,\\\"Ket\\\"]\\)\>\""}],
                    ShowSpecialCharacters->False,
                    ShowStringCharacters->True,
                    NumberMarks->True],
                    FullForm], ",", "Right"}], "]"}], ",", 
                  RowBox[{"Placed", "[", 
                   
                   RowBox[{"\"\<\!\(\*TemplateBox[{\"\[Theta]\"},\"Ket\"]\)\>\
\"", ",", "Left"}], "]"}]}], "}"}]}]}], "}"}]}]}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"bits", ",", 
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", "n"}], "]"}]}], "}"}]}], 
      "]"}], ",", "4"}], "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.969446287099223*^9, 3.969446290516185*^9}, {
  3.9694463229916*^9, 3.96944639428239*^9}, {3.969446951763912*^9, 
  3.969446952208406*^9}, {3.9694469903310337`*^9, 3.969447003050304*^9}, {
  3.969447045854967*^9, 3.969447141930414*^9}, {3.9694471918329983`*^9, 
  3.9694472421563797`*^9}, {3.96944730720271*^9, 3.9694473535806847`*^9}, {
  3.969448045403569*^9, 3.969448060594616*^9}, {3.969448304291533*^9, 
  3.969448328255542*^9}, {3.969448409409174*^9, 3.9694484127683372`*^9}, {
  3.9699228463020277`*^9, 3.969922846671988*^9}},
 CellLabel->
  "In[458]:=",ExpressionUUID->"d305ffb2-3152-4677-b9dd-97af80680aa2"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s assume that the initial state of qubit ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "7b41496c-8986-413f-a1c4-21fb2c496aaa"],
 " is an eigenstate of the unitary operator: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"U", 
     TemplateBox[{"\[Theta]"},
      "Ket"]}], "=", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", " ", "\[Theta]"}]], 
     TemplateBox[{"\[Theta]"},
      "Ket"]}]}], TraditionalForm]],ExpressionUUID->
  "b7436f20-73b6-434f-a18c-a76a78240d49"],
 " and ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "7c26d6d3-a7dd-4726-b11a-29d15b21e658"],
 " qubits are prepared in a uniform superposition  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"\[Psi]"},
     "Ket"], "=", 
    RowBox[{
     FractionBox["1", 
      SqrtBox[
       SuperscriptBox["2", "n"]]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"x", "=", "0"}], 
       RowBox[{
        SuperscriptBox["2", "n"], "-", "1"}]], 
      TemplateBox[{"x"},
       "Ket"]}]}]}], TraditionalForm]],ExpressionUUID->
  "649cf46e-c318-4173-a4c1-92c521cfb43f"],
 " . Therefore, the above transformation can be written as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      TemplateBox[{"\[Psi]"},
       "Ket"], 
      TemplateBox[{"\[Theta]"},
       "Ket"]}], "->", 
     RowBox[{
      FractionBox["1", 
       SqrtBox[
        SuperscriptBox["2", "n"]]], " ", 
      FormBox[
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"x", "=", "0"}], 
         RowBox[{
          SuperscriptBox["2", "n"], "-", "1"}]], 
        RowBox[{
         TemplateBox[{"x"},
          "Ket"], "(", 
         RowBox[{
          SuperscriptBox["U", "x"], 
          TemplateBox[{"\[Theta]"},
           "Ket"]}], ")"}]}],
       TraditionalForm]}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", 
        SqrtBox[
         SuperscriptBox["2", "n"]]], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"x", "=", "0"}], 
         RowBox[{
          SuperscriptBox["2", "n"], "-", "1"}]], 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
          "2", "\[Pi]", " ", "\[ImaginaryI]", " ", "\[Theta]", " ", "x"}]], 
         TemplateBox[{"x"},
          "Ket"]}]}]}], ")"}], 
     TemplateBox[{"\[Theta]"},
      "Ket"]}]}], TraditionalForm]],ExpressionUUID->
  "6f2e0873-1c24-47ef-bc70-7f30384a2849"],
 ". If you recall QFT, then you might be able to have guessed our next step. \
To extract the information about \[Theta], we can apply inverse QFT on ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "a739b196-d8d0-4c0f-b2b7-bf324c110706"],
 " qubit. Therefore, the n-qubit state becomes: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["1", 
      SqrtBox[
       SuperscriptBox["2", "n"]]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"x", "=", "0"}], 
       RowBox[{
        SuperscriptBox["2", "n"], "-", "1"}]], 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
        "2", "\[Pi]", " ", "\[ImaginaryI]", " ", "\[Theta]", " ", "x"}]], 
       TemplateBox[{"x"},
        "Ket"]}]}]}], "->", 
    RowBox[{
     FractionBox["1", 
      SuperscriptBox["2", "n"]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"x", ",", 
        RowBox[{"y", "=", "0"}]}], 
       RowBox[{
        SuperscriptBox["2", "n"], "-", "1"}]], 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", "  ", "x", " ", 
         RowBox[{"(", 
          RowBox[{"\[Theta]", "-", 
           FractionBox["y", 
            SuperscriptBox["2", "n"]]}], ")"}]}]], 
       TemplateBox[{"x"},
        "Ket"]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "34f3bcd9-9dc2-416a-bb0a-4e9f4a47dafc"],
 ". Accordingly, the probability of getting ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"x"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "1d9e1e7e-1c54-48ec-aa1f-f7307376d2c4"],
 " is given by  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"|", 
       RowBox[{
        FractionBox["1", 
         SuperscriptBox["2", "n"]], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"y", "=", "0"}], 
          RowBox[{
           SuperscriptBox["2", "n"], "-", "1"}]], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", "  ", "x", " ", 
           RowBox[{"(", 
            RowBox[{"\[Theta]", "-", 
             FractionBox["y", 
              SuperscriptBox["2", "n"]]}], ")"}]}]]}]}], "|"}], ")"}], "2"], "=", 
    RowBox[{
     FractionBox["1", 
      SuperscriptBox["2", 
       RowBox[{"2", "n"}]]], 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"sin", "(", 
         RowBox[{"\[Pi]", " ", 
          SuperscriptBox["2", "n"], 
          RowBox[{"(", 
           RowBox[{"\[Theta]", "-", 
            RowBox[{"y", "/", 
             SuperscriptBox["2", "n"]}]}], ")"}]}], ")"}], 
        RowBox[{"sin", "(", 
         RowBox[{"\[Pi]", " ", 
          RowBox[{"(", 
           RowBox[{"\[Theta]", "-", 
            RowBox[{"y", "/", 
             SuperscriptBox["2", "n"]}]}], ")"}]}], ")"}]], ")"}], "2"]}]}], 
   TraditionalForm]],ExpressionUUID->"52095589-6e84-4e8b-8a33-a2028602d4c2"],
 ". That is the squared Dirichlet kernel with the main lobe centered at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "\[TildeTilde]", 
    RowBox[{
     SuperscriptBox["2", "m"], "\[Theta]"}]}], TraditionalForm]],
  ExpressionUUID->"4ea699e2-b6b6-44e4-9554-26e443ba2a01"],
 ". You see a distribution because a finite DFT can\[CloseCurlyQuote]t \
represent an arbitrary eigenphase with infinite resolution (the basis \
resolution is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tilde]", 
    SuperscriptBox["2", 
     RowBox[{"-", "n"}]]}], TraditionalForm]],ExpressionUUID->
  "7eec74ed-88a6-4a0a-a0fa-a3400556978e"],
 ").  Below is the Dirichlet kernel for varying numbers of qubits, evaluated \
at eigenphases of the random unitary generated in the previous section. Note \
that the measurement results will be discrete points ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "\[Ellipsis]", ",", 
     RowBox[{
      SuperscriptBox["2", "n"], "-", "1"}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"2fe50dd9-43b5-4abe-9574-a20a52f43242"],
 "."
}], "Text",
 CellChangeTimes->{{3.969448452604485*^9, 3.969448552541287*^9}, {
  3.969448602215189*^9, 3.9694487048858957`*^9}, {3.969449925579632*^9, 
  3.9694499600359163`*^9}, {3.969450537394772*^9, 3.9694506134774513`*^9}, {
  3.9694506655081253`*^9, 3.969450672983445*^9}, {3.969457952814478*^9, 
  3.969458031834618*^9}, {3.969458069165963*^9, 3.969458354250772*^9}, {
  3.969458524845302*^9, 3.96945853156098*^9}, {3.969458790827198*^9, 
  3.969458833825935*^9}, {3.9694589423297586`*^9, 3.9694590749057837`*^9}, {
  3.969471707848673*^9, 3.969471776849595*^9}, {3.969471868963195*^9, 
  3.9694719131145*^9}, {3.971797366370957*^9, 
  3.971797366936707*^9}},ExpressionUUID->"c1b01ab1-dfb0-4f40-91dc-\
a944c543fa2e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"DirichletKernel", "[", 
   RowBox[{"\[Theta]_", ",", "y_", ",", "n_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", 
    SuperscriptBox["2", 
     RowBox[{"2", "n"}]]], 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{"Sin", "[", 
       RowBox[{"\[Pi]", " ", 
        SuperscriptBox["2", "n"], 
        RowBox[{"(", 
         RowBox[{"\[Theta]", "-", 
          RowBox[{"y", "/", 
           SuperscriptBox["2", "n"]}]}], ")"}]}], "]"}], 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Pi]", " ", 
        RowBox[{"(", 
         RowBox[{"\[Theta]", "-", 
          RowBox[{"y", "/", 
           SuperscriptBox["2", "n"]}]}], ")"}]}], "]"}]], ")"}], "2"]}]}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"n", "->", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"DirichletKernel", "[", 
          RowBox[{
           RowBox[{"\[Theta]s", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", "y", ",", "n"}], "]"}], ",", 
         RowBox[{"DirichletKernel", "[", 
          RowBox[{
           RowBox[{"\[Theta]s", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "y", ",", "n"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", 
         RowBox[{
          SuperscriptBox["2", "n"], "-", "1"}]}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"GridLines", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{
             SuperscriptBox["2", "n"], "-", "1"}]}], "]"}], ",", 
          "Automatic"}], "}"}]}], ",", 
       RowBox[{"Ticks", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{
             SuperscriptBox["2", "n"], "-", "1"}]}], "]"}], ",", 
          "Automatic"}], "}"}]}], ",", 
       RowBox[{"AspectRatio", "->", 
        RowBox[{"1", "/", "2"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Dirichlet kernel for \!\(\*SubscriptBox[\(\[Theta]\), \
\(1\)]\)\>\"", 
          ",", "\"\<Dirichlet kernel for \!\(\*SubscriptBox[\(\[Theta]\), \(2\
\)]\)\>\""}], "}"}]}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "2", ",", "4"}], "}"}]}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.969458361113316*^9, 3.9694585490997553`*^9}, {
   3.9694586051345053`*^9, 3.969458683447146*^9}, {3.969459018442169*^9, 
   3.969459022420217*^9}, {3.969459082960443*^9, 3.969459085173473*^9}, {
   3.969467450318103*^9, 3.969467462532292*^9}, {3.969471931230514*^9, 
   3.9694719870526657`*^9}, {3.969474074787229*^9, 3.969474092001395*^9}, 
   3.9694741453354483`*^9, {3.969494158885254*^9, 3.969494185965537*^9}},
 CellLabel->
  "In[459]:=",ExpressionUUID->"7145a365-1921-496b-bd46-6c394ea93a0f"],

Cell["\<\
Let\[CloseCurlyQuote]s explore QFE for the unitary operator we generate \
above. Let\[CloseCurlyQuote]s consider the first eigenvector:\
\>", "Text",
 CellChangeTimes->{{3.969448452604485*^9, 3.969448552541287*^9}, {
  3.969448602215189*^9, 3.9694487048858957`*^9}, {3.969449925579632*^9, 
  3.9694499600359163`*^9}, {3.969450537394772*^9, 3.9694506134774513`*^9}, {
  3.9694506655081253`*^9, 3.969450672983445*^9}, {3.969457952814478*^9, 
  3.969458031834618*^9}, {3.969458069165963*^9, 3.969458349645782*^9}, {
  3.9694587503170357`*^9, 3.9694587792870417`*^9}, {3.969458930640216*^9, 
  3.969458931128985*^9}, {3.969474884566784*^9, 
  3.969474885207549*^9}},ExpressionUUID->"f1c08dcc-b589-41d1-a099-\
e402f8a37f18"],

Cell[BoxData[
 RowBox[{"\[Theta]State", "=", 
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"u", "[", "\"\<Eigenvectors\>\"", "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], ",", 
    RowBox[{"\"\<Label\>\"", "->", "\"\<\!\(\*TemplateBox[{
SubscriptBox[\"\[Theta]\", \"1\"]},\"Ket\"]\)\>\""}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.969449133913529*^9, 3.969449168111705*^9}, 
   3.969449307215807*^9, {3.969453609302603*^9, 3.969453620686768*^9}, {
   3.969456733169478*^9, 3.9694567384050293`*^9}, {3.969456776732094*^9, 
   3.9694568020881157`*^9}, 3.96947418480763*^9},
 CellLabel->
  "In[461]:=",ExpressionUUID->"abe2f91e-71ad-4824-9a19-fe14a9853397"],

Cell["\<\
Prepare the target in the unitary\[CloseCurlyQuote]s first eigenstate. \
Initialize the control qubits in uniform superposition with Hadamards. Apply \
the sequence of controlled powers, then the inverse QFT, and measure the \
control register.\
\>", "Text",
 CellChangeTimes->{{3.969474892695633*^9, 3.969474960452333*^9}, {
  3.969475029434958*^9, 
  3.969475059092896*^9}},ExpressionUUID->"df7a80f7-a51c-4add-8897-\
7c8b6389a263"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc", "=", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<H\>\"", "->", 
        RowBox[{"Range", "[", "n", "]"}]}], ",", 
       RowBox[{"\[Theta]State", "->", 
        RowBox[{"n", "+", "1"}]}], ",", 
       RowBox[{"qpeControl", "[", "n", "]"}], ",", 
       RowBox[{"\"\<InverseFourier\>\"", "[", "n", "]"}], ",", 
       RowBox[{"Range", "[", "n", "]"}]}], "}"}], "]"}], 
    "[", "\"\<Flatten\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"qc", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.969448706562106*^9, 3.9694488406218224`*^9}, {
  3.969450072601816*^9, 3.969450072883572*^9}, {3.969452640071253*^9, 
  3.9694526423586617`*^9}, {3.969453242454446*^9, 3.9694532428165207`*^9}, {
  3.969474406766309*^9, 3.969474426662882*^9}},
 CellLabel->
  "In[462]:=",ExpressionUUID->"3399933a-bbff-4129-8f16-1d5ecd5f5764"],

Cell["Execute the circuit and plot the measurement probabilities.", "Text",
 CellChangeTimes->{{3.969475097155352*^9, 3.969475102980151*^9}, 
   3.969475312077683*^9},ExpressionUUID->"031d00d1-5d5b-4c3e-908d-\
1774c048bbff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"meas", "=", 
   RowBox[{
    RowBox[{"N", "[", "qc", "]"}], "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"meas", "[", 
  RowBox[{"\"\<ProbabilityPlot\>\"", ",", 
   RowBox[{"AspectRatio", "->", 
    RowBox[{"1", "/", "3"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.969448871890036*^9, 3.969448915689116*^9}, {
  3.969456811991212*^9, 3.969456813940372*^9}},
 CellLabel->
  "In[464]:=",ExpressionUUID->"d1bd97a0-e9ce-44b5-91eb-3c5ede8a5cb9"],

Cell[TextData[{
 "Select the most likely outcome (here 010). Read its bitstring as the \
integer ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8df08358-6ec9-4fcb-827c-f688f8a0a282"],
 ", then estimate the eigenphase using ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["2", "n"], "\[Theta]"}], "\[TildeTilde]", "j"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2d1f1830-09d1-4128-bb27-4e75c937fa72"],
 "."
}], "Text",
 CellChangeTimes->{{3.9694753167663107`*^9, 3.969475476735442*^9}, {
  3.969475632941175*^9, 
  3.969475636317686*^9}},ExpressionUUID->"e8393904-5803-46ad-814d-\
82eeb1a22e7a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FromDigits", "[", 
   RowBox[{"\"\<010\>\"", ",", "2"}], "]"}], "/", 
  RowBox[{"2", "^", "n"}]}]], "Input",
 CellChangeTimes->{{3.969448986046804*^9, 3.969448997032549*^9}, {
   3.969450378857307*^9, 3.9694503792317963`*^9}, {3.969451591636615*^9, 
   3.969451705581998*^9}, {3.969451844667797*^9, 3.9694518495433283`*^9}, 
   3.9694754806813173`*^9, {3.96947559168489*^9, 3.969475602665214*^9}, {
   3.96947564120856*^9, 3.969475651153182*^9}},
 CellLabel->
  "In[466]:=",ExpressionUUID->"f48189d0-3a82-4fb0-b880-87eb21f51ad0"],

Cell["\<\
Compute the percentage error in the estimated phase (argument) of the first \
eigenvalue:\
\>", "Text",
 CellChangeTimes->{{3.9694521951641073`*^9, 3.969452214940957*^9}, {
  3.969452245610878*^9, 
  3.96945224691608*^9}},ExpressionUUID->"0892fb43-c471-4dea-b683-\
1f1cb91f227a"],

Cell[BoxData[
 RowBox[{"PercentForm", "[", 
  RowBox[{"1", "-", 
   RowBox[{"%", "/", 
    RowBox[{"\[Theta]s", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.969452675099366*^9, 3.9694526923871613`*^9}, 
   3.969453656684317*^9, 3.969456835060932*^9, 3.969475659598778*^9},
 CellLabel->
  "In[467]:=",ExpressionUUID->"6b7e8d4f-c295-4e7e-a034-40de409c2be8"],

Cell[TextData[{
 "If you look at the Dirichlet kernels above, for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "3"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5a904494-a9e4-41e0-9a85-d4aeb12dae29"],
 " (three control qubits) there is still some overlap between kernels for \
different eigenphases. Adding more control qubits makes kernels \
better-separated, thus the estimated bitstring converge to the true phase, \
improving precision."
}], "Text",
 CellChangeTimes->{{3.9694571406786747`*^9, 3.969457198731941*^9}, {
  3.9694756862973146`*^9, 3.969475744687304*^9}, {3.969537908786689*^9, 
  3.969538032459319*^9}},ExpressionUUID->"ad29141e-ece0-4631-946b-\
ce6c9c951f81"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"est", ",", "qc", ",", "bits"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"qc", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"\"\<H\>\"", "->", 
                RowBox[{"Range", "[", "n", "]"}]}], ",", 
               RowBox[{"\[Theta]State", "->", 
                RowBox[{"n", "+", "1"}]}], ",", 
               RowBox[{"qpeControl", "[", "n", "]"}], ",", 
               RowBox[{"\"\<InverseFourier\>\"", "[", "n", "]"}], ",", 
               RowBox[{"Range", "[", "n", "]"}]}], "}"}], "//", 
             "QuantumCircuitOperator"}], "//", "N"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"bits", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Keys", "[", 
              RowBox[{"TakeLargest", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"qc", "[", "]"}], "[", "\"\<Probabilities\>\"", 
                 "]"}], ",", "1"}], "]"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<Name\>\"", "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"est", "=", 
           FractionBox[
            RowBox[{"FromDigits", "[", 
             RowBox[{"bits", ",", "2"}], "]"}], 
            RowBox[{"2", "^", 
             RowBox[{"Length", "[", "bits", "]"}]}]]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"n", ",", "bits", ",", 
            RowBox[{"N", "@", "est"}], ",", 
            RowBox[{"PercentForm", "[", 
             RowBox[{"1", "-", 
              RowBox[{"est", "/", 
               RowBox[{"\[Theta]s", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], "}"}]}]}], "]"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "3", ",", "6"}], "}"}]}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
      RowBox[{"{", 
       RowBox[{"\"\<Number qubits\>\"", ",", "\"\<Bit-form of eigenphase\>\"",
         ",", "\"\<Estimated value of eigenphase\>\"", 
        ",", "\"\<%Error in estimation\>\""}], "}"}]}]}], "]"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", "Left"}]}], "]"}]], "Input",
 CellChangeTimes->{
  3.9694571174944763`*^9, {3.969457744212915*^9, 3.9694577473908987`*^9}, {
   3.969474461714465*^9, 3.969474504855291*^9}, {3.969475735733974*^9, 
   3.969475738377206*^9}},
 CellLabel->
  "In[468]:=",ExpressionUUID->"4c2dbd64-cf6e-42ab-8c85-0bfd3f725293"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Quantum Phase Estimation: Complicated Example", "Section",
 CellChangeTimes->{{3.969459333032186*^9, 3.969459361943356*^9}, {
  3.969542704717483*^9, 3.969542707644889*^9}, {3.9699771112253532`*^9, 
  3.969977112612163*^9}},ExpressionUUID->"9e3615a8-3080-4338-aad7-\
ebb567aea465"],

Cell[TextData[{
 "We can drop the assumption that the target qudit is prepared in an \
eigenstate. By linearity, the probability of obtaining outcome ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"x"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b2b19106-1b9a-47bb-98e2-c100446df6b6"],
 " is the weighted sum of contributions from the linear combination in \
eigenstate components for the target qudit. Accordingly, the probability of \
getting ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"x"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f437472f-4e9b-4748-9181-622462744a90"],
 " is given by  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", "j"], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"|", 
        SubscriptBox["c", "j"], "|"}], ")"}], "2"], 
     FractionBox["1", 
      SuperscriptBox["2", 
       RowBox[{"2", "n"}]]], 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"sin", "(", 
         RowBox[{"\[Pi]", " ", 
          SuperscriptBox["2", "n"], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Theta]", "j"], "-", 
            RowBox[{"x", "/", 
             SuperscriptBox["2", "n"]}]}], ")"}]}], ")"}], 
        RowBox[{"sin", "(", 
         RowBox[{"\[Pi]", " ", 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Theta]", "j"], "-", 
            RowBox[{"x", "/", 
             SuperscriptBox["2", "n"]}]}], ")"}]}], ")"}]], ")"}], "2"]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "717b6668-2ca4-4715-bce0-8da6c97e2d70"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "j"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "29588a76-e27e-4860-b778-1e189b687887"],
 " is the coefficient in the initial superposition of the target qubit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sum]", "j"], 
    RowBox[{
     SubscriptBox["c", "j"], 
     TemplateBox[{
       SubscriptBox["\[Theta]", "j"]},
      "Ket"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "709bdebe-fc0c-41ee-b1fa-010f0888d3a7"],
 "."
}], "Text",
 CellChangeTimes->{{3.9694593752466173`*^9, 3.969459397368084*^9}, {
   3.969459463422917*^9, 3.969459471369645*^9}, {3.969459504709272*^9, 
   3.96945951018473*^9}, {3.969459552984392*^9, 3.969459600505331*^9}, {
   3.969459655509829*^9, 3.9694597347320004`*^9}, {3.96946073631537*^9, 
   3.9694607465633297`*^9}, {3.969462770237165*^9, 3.9694628111617117`*^9}, 
   3.969475781047875*^9},ExpressionUUID->"fa4c8cc7-c90b-4e95-971a-\
71673e2c14c3"],

Cell["\<\
Visualize the overall Dirichlet kernel, and the individual kernels, for \
different linear combinations of eigenstates.\
\>", "Text",
 CellChangeTimes->{{3.969475782940667*^9, 
  3.969475861781144*^9}},ExpressionUUID->"55218042-f2f4-491f-9fcb-\
cc69a86bd790"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"coeff", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"theta", "/", "2"}], "]"}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"theta", "/", "2"}], "]"}], 
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "phi"}], "]"}]}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"points", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             SuperscriptBox[
              RowBox[{"Abs", "[", 
               RowBox[{"coeff", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "]"}], "2"], 
             FormBox[
              RowBox[{"dirichletKernel", "[", 
               RowBox[{
                RowBox[{"\[Theta]S", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], ",", "#", ",", "nN"}], "]"}],
              TraditionalForm]}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], "}"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{
          SuperscriptBox["2", "nN"], "-", "1"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            SuperscriptBox[
             RowBox[{"Abs", "[", 
              RowBox[{"coeff", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], "2"], 
            FormBox[
             RowBox[{"dirichletKernel", "[", 
              RowBox[{
               RowBox[{"\[Theta]S", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ",", "y", ",", "nN"}], "]"}],
             TraditionalForm]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "2"}], "}"}]}], "]"}], ",", 
         RowBox[{"dirichletKernel", "[", 
          RowBox[{
           RowBox[{"\[Theta]S", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", "y", ",", "nN"}], "]"}], ",", 
         RowBox[{"dirichletKernel", "[", 
          RowBox[{
           RowBox[{"\[Theta]S", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "y", ",", "nN"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", 
         RowBox[{
          SuperscriptBox["2", "nN"], "-", "1"}]}], "}"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], ",", 
       RowBox[{"GridLines", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{
             SuperscriptBox["2", "nN"], "-", "1"}]}], "]"}], ",", 
          "Automatic"}], "}"}]}], ",", 
       RowBox[{"Epilog", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"PointSize", "[", "Medium", "]"}], ",", 
          RowBox[{"Point", "[", "points", "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", "Dashed", ",", "Dashed"}], "}"}]}], ",", 
       RowBox[{"AspectRatio", "->", 
        RowBox[{"1", "/", "2"}]}], ",", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{"Column", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<Initial state of target qubit: \
cos(\[Alpha]/2)\!\(\*TemplateBox[{
SubscriptBox[\"\[Theta]\", \"1\"]},\"Ket\"]\) + \
sin(\[Alpha]/2)\!\(\*SuperscriptBox[\(\[ExponentialE]\), \(\[ImaginaryI]\\\ \
\[Beta]\)]\)\!\(\*TemplateBox[{
SubscriptBox[\"\[Theta]\", \"2\"]},\"Ket\"]\)\>\"", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Chop", "[", 
               RowBox[{"coeff", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], 
              TemplateBox[{"\"\!\(\*SubscriptBox[\(\[Theta]\), \(1\)]\)\""},
               "Ket"]}], "+", 
             RowBox[{
              RowBox[{"Chop", "[", 
               RowBox[{"coeff", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], 
              TemplateBox[{"\"\!\(\*SubscriptBox[\(\[Theta]\), \(2\)]\)\""},
               "Ket"]}]}]}], "}"}], ",", 
          RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], ",", 
       RowBox[{"Ticks", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{
             SuperscriptBox["2", "nN"], "-", "1"}]}], "]"}], ",", 
          "Automatic"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Dirichlet kernel for \!\(\*SubscriptBox[\(c\), \(1\)]\)\
\!\(\*TemplateBox[{
SubscriptBox[\"\[Theta]\", \"1\"]},\"Ket\"]\)+\!\(\*SubscriptBox[\(c\), \
\(2\)]\)\!\(\*TemplateBox[{
SubscriptBox[\"\[Theta]\", \"2\"]},\"Ket\"]\)\>\"", 
          ",", "\"\<Dirichlet kernel for \!\(\*TemplateBox[{
SubscriptBox[\"\[Theta]\", \"1\"]},\"Ket\"]\)\>\"", 
          ",", "\"\<Dirichlet kernel for \!\(\*TemplateBox[{
SubscriptBox[\"\[Theta]\", \"2\"]},\"Ket\"]\)\>\""}], "}"}]}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"theta", ",", 
        RowBox[{"\[Pi]", "/", "3"}], ",", "\"\<\[Alpha]\>\""}], "}"}], ",", 
      "0", ",", "\[Pi]"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"phi", ",", 
        RowBox[{"\[Pi]", "/", "4"}], ",", "\"\<\[Beta]\>\""}], "}"}], ",", 
      "0", ",", 
      RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nN", ",", "2", ",", "\"\<n\>\""}], "}"}], ",", 
      RowBox[{"Range", "[", 
       RowBox[{"2", ",", "4"}], "]"}], ",", "Setter"}], "}"}], ",", 
    RowBox[{"Initialization", ":>", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Theta]S", "=", 
        RowBox[{"{", 
         RowBox[{"0.295", ",", "0.17"}], "}"}]}], ",", 
       RowBox[{
        RowBox[{"dirichletKernel", "[", 
         RowBox[{"\[Theta]_", ",", "y_", ",", "n_"}], "]"}], ":=", 
        RowBox[{
         FractionBox["1", 
          SuperscriptBox["2", 
           RowBox[{"2", "n"}]]], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{"Sin", "[", 
             RowBox[{"\[Pi]", " ", 
              SuperscriptBox["2", "n"], 
              RowBox[{"(", 
               RowBox[{"\[Theta]", "-", 
                RowBox[{"y", "/", 
                 SuperscriptBox["2", "n"]}]}], ")"}]}], "]"}], 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Pi]", " ", 
              RowBox[{"(", 
               RowBox[{"\[Theta]", "-", 
                RowBox[{"y", "/", 
                 SuperscriptBox["2", "n"]}]}], ")"}]}], "]"}]], ")"}], 
          "2"]}]}]}], "}"}]}], ",", 
    RowBox[{"SaveDefinitions", ":>", "True"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.969458361113316*^9, 3.9694585490997553`*^9}, {
   3.9694586051345053`*^9, 3.969458683447146*^9}, {3.969459018442169*^9, 
   3.969459022420217*^9}, {3.969459082960443*^9, 3.969459085173473*^9}, 
   3.96946075640178*^9, {3.969460791274839*^9, 3.969460801821002*^9}, {
   3.969463267823041*^9, 3.969463306597924*^9}, 3.969463409791193*^9, {
   3.9694635056056013`*^9, 3.969463552627595*^9}, {3.969464225086513*^9, 
   3.969464267840136*^9}, {3.9694643320644703`*^9, 3.969464397454076*^9}, 
   3.96946447929121*^9, {3.969465791575604*^9, 3.9694657949710703`*^9}, {
   3.969465968376711*^9, 3.969465976849833*^9}, {3.969466012981583*^9, 
   3.9694660657941017`*^9}, {3.969466100207292*^9, 3.9694661298406277`*^9}, {
   3.9694661686323423`*^9, 3.969466168807556*^9}, {3.969466199812067*^9, 
   3.969466200409779*^9}, {3.969466870008581*^9, 3.9694669121969547`*^9}, {
   3.969466942886486*^9, 3.969467105489572*^9}, {3.969467138196535*^9, 
   3.969467188203656*^9}, {3.969467233174307*^9, 3.969467259566063*^9}, {
   3.969467351847158*^9, 3.969467375607718*^9}, 3.969475879636579*^9, 
   3.969494246419114*^9, {3.96992274725401*^9, 3.96992276076884*^9}, {
   3.96992291706846*^9, 3.96992293063669*^9}, {3.9699233561659517`*^9, 
   3.969923383187031*^9}, {3.96992562297655*^9, 3.969925630401807*^9}, {
   3.972993681273984*^9, 3.972993717986066*^9}, {3.972993823131661*^9, 
   3.972993823435313*^9}, {3.972993864174109*^9, 3.97299398292153*^9}, 
   3.973004347224091*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"f38aaada-30f6-4330-9c84-768c7f051894"],

Cell["\<\
Consider the same circuit, but prepare the target qubit in a fixed \
(pedagogical) pure state chosen to mimic a random state, so we can illustrate \
the key effects clearly.\
\>", "Text",
 CellChangeTimes->{{3.9694759181467533`*^9, 3.96947594011069*^9}, {
  3.96953539385509*^9, 3.969535432580688*^9}, {3.969535647018735*^9, 
  3.969535655229404*^9}},ExpressionUUID->"f0cfae1e-3a55-426e-bd81-\
d32c2e73efda"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "qc2", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"targetState", "=", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"{", 
      RowBox[{"0.5464", "\[VeryThinSpace]", ",", 
       RowBox[{"0.3281", "\[VeryThinSpace]", "+", 
        RowBox[{"0.7706", " ", "\[ImaginaryI]"}]}]}], "}"}], "]"}], 
    "[", "\"\<Normalize\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"qc2", "=", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<H\>\"", "->", 
        RowBox[{"Range", "[", "n", "]"}]}], ",", 
       RowBox[{"targetState", "->", 
        RowBox[{"n", "+", "1"}]}], ",", 
       RowBox[{"qpeControl", "[", "n", "]"}], ",", 
       RowBox[{"\"\<InverseFourier\>\"", "[", "n", "]"}]}], "}"}], "]"}], 
    "[", "\"\<Flatten\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"qc2", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.9694649560316553`*^9, 3.969465035039011*^9}, {
  3.969465091898897*^9, 3.969465109100087*^9}, {3.969465365490912*^9, 
  3.969465386714116*^9}, {3.969474620639575*^9, 3.969474641578237*^9}, {
  3.969474804407989*^9, 3.9694748063766193`*^9}, {3.969475910783375*^9, 
  3.969475914830472*^9}, {3.969496648552451*^9, 3.969496653645049*^9}, {
  3.969496684795265*^9, 3.969496686877261*^9}, {3.969530595041827*^9, 
  3.969530597313839*^9}, {3.969533959396446*^9, 3.96953398956567*^9}, {
  3.969535122870988*^9, 3.969535129572904*^9}, {3.969535438263735*^9, 
  3.969535477770525*^9}},
 CellLabel->
  "In[470]:=",ExpressionUUID->"7a0fa0e2-98ef-4bd4-97d3-ef6fedc33845"],

Cell["Plot the measurement probabilities for the control qubits.", "Text",
 CellChangeTimes->{{3.969475960082837*^9, 3.969475970639303*^9}, 
   3.969476088781704*^9},ExpressionUUID->"aa978612-4957-4413-ab9d-\
21672b61177b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"finalState", "=", 
   RowBox[{"N", "@", 
    RowBox[{"qc2", "[", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"QuantumPartialTrace", "[", 
   RowBox[{"finalState", ",", 
    RowBox[{"{", 
     RowBox[{"n", "+", "1"}], "}"}]}], "]"}], "[", 
  RowBox[{"\"\<ProbabilityPlot\>\"", ",", 
   RowBox[{"AspectRatio", "->", 
    RowBox[{"1", "/", "4"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.969496526829073*^9, 3.969496546081894*^9}, {
  3.969496585029766*^9, 3.969496599444994*^9}, {3.9695345453094263`*^9, 
  3.969534550199584*^9}},
 CellLabel->
  "In[474]:=",ExpressionUUID->"a2daa917-3321-44ca-9813-ac0e0105becd"],

Cell["\<\
We simulated the circuit without explicit measurement. After the unitary \
evolution, we traced out the target qubit to obtain the reduced state of the \
control register, then read off the computational-basis probabilities from \
that reduced state.\
\>", "Text",
 CellChangeTimes->{{3.969476095585696*^9, 3.969476152608577*^9}, {
  3.969476200478142*^9, 
  3.96947620163172*^9}},ExpressionUUID->"702e7f0b-ad95-4aee-a2fe-\
3cef4c4feaa0"],

Cell["\<\
Now let\[CloseCurlyQuote]s obtain the overall Dirichlet kernel from \
simulations without assuming any knowledge of the unitary\[CloseCurlyQuote]s \
eigenstates or eigenphases. First, implement code that mimics experimental \
outcomes: a variable (randomResult) samples control-register measurement \
results according to the predicted probabilities each time the it is executed.\
\>", "Text",
 CellChangeTimes->{{3.969534681505456*^9, 3.969534744078433*^9}, {
  3.9695347765571012`*^9, 3.9695348505606747`*^9}, {3.9695349124619513`*^9, 
  3.969534931428899*^9}},ExpressionUUID->"cfe09b49-d342-4608-ac83-\
c90ddaa14090"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "finalState", ",", "prob", ",", "randomResult", ",", "realizations", ",", 
    "dist", ",", "pnts"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"finalState", "=", 
   RowBox[{"N", "@", 
    RowBox[{"qc2", "[", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"prob", "=", 
   RowBox[{
    RowBox[{"QuantumPartialTrace", "[", 
     RowBox[{"finalState", ",", 
      RowBox[{"{", 
       RowBox[{"n", "+", "1"}], "}"}]}], "]"}], 
    "[", "\"\<ProbabilitiesList\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"randomResult", ":=", 
   RowBox[{"RandomChoice", "[", 
    RowBox[{"prob", "->", 
     RowBox[{"StringJoin", "@@@", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<0\>\"", ",", "\"\<1\>\""}], "}"}], ",", "n"}], 
       "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9695344720987864`*^9, 3.969534488513318*^9}, {
  3.969541889022097*^9, 3.9695418892237253`*^9}},
 CellLabel->
  "In[476]:=",ExpressionUUID->"1d93cc40-f6dd-42f2-80fc-855024c03861"],

Cell[TextData[{
 "Generate ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "10"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e0d52574-f1ae-4f9b-a3bd-bdc0e357aa98"],
 " results (i.e. realizations) of the experimental results:"
}], "Text",
 CellChangeTimes->{{3.969534937828561*^9, 
  3.969534973597165*^9}},ExpressionUUID->"90c9c00d-cb0e-4ace-9e9f-\
33afe31462ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"realizations", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"randomResult", ",", "1024"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9695308489700413`*^9, 3.969530886325027*^9}, {
  3.969531677546648*^9, 3.969531686235158*^9}, {3.969533935547638*^9, 
  3.969533937927957*^9}},
 CellLabel->
  "In[480]:=",ExpressionUUID->"9a59113b-a6c4-40be-a189-902a63ea79dd"],

Cell["\<\
Calculate a smooth kernel distribution based on the data obtained above \
(after transforming it into the corresponding integers):\
\>", "Text",
 CellChangeTimes->{{3.9695350338002768`*^9, 3.9695350745146*^9}, 
   3.9695352048083267`*^9, 
   3.971797381273758*^9},ExpressionUUID->"5c3c1f70-ff01-4517-b8f7-\
a27b2710f0a7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dist", "=", 
   RowBox[{"SmoothKernelDistribution", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"FromDigits", "[", 
       RowBox[{"#", ",", "2"}], "]"}], "&"}], "/@", "realizations"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pnts", "=", 
   RowBox[{"SortBy", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FromDigits", "[", 
           RowBox[{"#1", ",", "2"}], "]"}], ",", "#2"}], "}"}], "&"}], "]"}], 
      "@", 
      RowBox[{"Normalize", "[", 
       RowBox[{
        RowBox[{"Counts", "@", "realizations"}], ",", "Total"}], "]"}]}], ",",
      "First"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"PDF", "[", 
    RowBox[{"dist", ",", "x"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{
      SuperscriptBox["2", "n"], "-", "1"}]}], "}"}], ",", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{"Red", ",", 
      RowBox[{"PointSize", "[", "Medium", "]"}], ",", 
      RowBox[{"Point", "[", "pnts", "]"}]}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", ".6"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9695316240256147`*^9, 3.969531633634853*^9}, {
  3.969533944266149*^9, 3.969533945630962*^9}, {3.96954188483665*^9, 
  3.969541901689966*^9}},
 CellLabel->
  "In[481]:=",ExpressionUUID->"74f30a8a-b43a-4204-901b-c62fce5de01e"],

Cell["\<\
Note that the smooth distribution we obtained is the overall Dirichlet kernel.\
\>", "Text",
 CellChangeTimes->{{3.969535207825156*^9, 3.969535221259851*^9}, {
  3.969535273357119*^9, 
  3.9695352748524637`*^9}},ExpressionUUID->"7bf1e43e-51a1-4934-bcf8-\
4c1b77084d3f"],

Cell["\<\
As you can see, it has only one peak. Let\[CloseCurlyQuote]s increase our \
resolution by adding more control qubits, while preparing the target qubit in \
the same state:\
\>", "Text",
 CellChangeTimes->{{3.969535088402348*^9, 3.9695351076486797`*^9}, {
   3.969535155924121*^9, 3.969535165273542*^9}, 
   3.9717973886336107`*^9},ExpressionUUID->"cb9f7f75-bebe-4eff-b87c-\
4ef0b0d43e1b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"n", "+", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"qc2", "=", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<H\>\"", "->", 
        RowBox[{"Range", "[", "n", "]"}]}], ",", 
       RowBox[{"targetState", "->", 
        RowBox[{"n", "+", "1"}]}], ",", 
       RowBox[{"qpeControl", "[", "n", "]"}], ",", 
       RowBox[{"\"\<InverseFourier\>\"", "[", "n", "]"}]}], "}"}], "]"}], 
    "[", "\"\<Flatten\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"qc2", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "->", "500"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.969534005979458*^9, 3.9695340084561234`*^9}, {
  3.9695351507837*^9, 3.9695351516322823`*^9}, {3.969925679913723*^9, 
  3.96992570303209*^9}},
 CellLabel->
  "In[484]:=",ExpressionUUID->"9de825b1-754d-494d-a2a4-82dc711b7931"],

Cell["\<\
Repeat the same steps to obtain the corresponding overall Dirichlet kernel.\
\>", "Text",
 CellChangeTimes->{{3.969535184955099*^9, 3.9695351948819523`*^9}, 
   3.969541736899927*^9, 
   3.9695418201012383`*^9},ExpressionUUID->"4bca6242-38be-4511-b123-\
0842eb31a22d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "finalState", ",", "prob", ",", "randomResult", ",", "realizations", ",", 
    " ", "dist"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"finalState", "=", 
   RowBox[{"N", "@", 
    RowBox[{"qc2", "[", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"prob", "=", 
   RowBox[{
    RowBox[{"QuantumPartialTrace", "[", 
     RowBox[{"finalState", ",", 
      RowBox[{"{", 
       RowBox[{"n", "+", "1"}], "}"}]}], "]"}], 
    "[", "\"\<ProbabilitiesList\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"randomResult", ":=", 
   RowBox[{"RandomChoice", "[", 
    RowBox[{"prob", "->", 
     RowBox[{"StringJoin", "@@@", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<0\>\"", ",", "\"\<1\>\""}], "}"}], ",", "n"}], 
       "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"realizations", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"randomResult", ",", "1024"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.969534494421958*^9, 3.9695345046576233`*^9}, {
   3.969535174276463*^9, 3.9695351780392447`*^9}, {3.9695361143130617`*^9, 
   3.969536121951182*^9}, 3.9695361865787983`*^9, {3.969536693940208*^9, 
   3.969536696174259*^9}},
 CellLabel->
  "In[487]:=",ExpressionUUID->"580643e9-6d03-48cd-b5ed-ac5a708d5926"],

Cell["Given new data, find the overall Dirichlet kernel", "Text",
 CellChangeTimes->{{3.969541835476694*^9, 3.96954183601066*^9}, {
  3.969541919107028*^9, 
  3.969541930287242*^9}},ExpressionUUID->"b6dd3b28-2127-4017-a256-\
89630e3491c2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dist", "=", 
   RowBox[{"SmoothKernelDistribution", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"FromDigits", "[", 
       RowBox[{"#", ",", "2"}], "]"}], "&"}], "/@", "realizations"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pnts", "=", 
   RowBox[{"SortBy", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FromDigits", "[", 
           RowBox[{"#1", ",", "2"}], "]"}], ",", "#2"}], "}"}], "&"}], "]"}], 
      "@", 
      RowBox[{"Normalize", "[", 
       RowBox[{
        RowBox[{"Counts", "@", "realizations"}], ",", "Total"}], "]"}]}], ",",
      "First"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"PDF", "[", 
    RowBox[{"dist", ",", "x"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{
      SuperscriptBox["2", "n"], "-", "1"}]}], "}"}], ",", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{"Red", ",", 
      RowBox[{"PointSize", "[", "Medium", "]"}], ",", 
      RowBox[{"Point", "[", "pnts", "]"}]}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", ".4"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.969534494421958*^9, 3.9695345046576233`*^9}, {
   3.969535174276463*^9, 3.9695351780392447`*^9}, {3.9695361143130617`*^9, 
   3.969536121951182*^9}, 3.9695361865787983`*^9, {3.969536316182787*^9, 
   3.969536426797412*^9}},
 CellLabel->
  "In[492]:=",ExpressionUUID->"cf92ce39-1e10-4856-a6b3-4f52b2755203"],

Cell["Now we can see two peaks clearly. ", "Text",
 CellChangeTimes->{{3.969541936547248*^9, 
  3.969541947175268*^9}},ExpressionUUID->"4f4fc4e8-b19d-4cce-bc1e-\
be3952eadc5d"],

Cell["\<\
Let\[CloseCurlyQuote]s get two measurement results corresponding to the two \
peak we obtained:\
\>", "Text",
 CellChangeTimes->{{3.96953580499701*^9, 
  3.969535820934802*^9}},ExpressionUUID->"e7d66af9-c13d-411e-bad5-\
d4e08c8c10f3"],

Cell[BoxData[
 RowBox[{"peakResults", "=", 
  RowBox[{"IntegerDigits", "[", 
   RowBox[{
    RowBox[{"First", "/@", 
     RowBox[{"Select", "[", 
      RowBox[{"pnts", ",", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"TakeLargest", "[", 
           RowBox[{
            RowBox[{"Last", "/@", 
             RowBox[{"FindPeaks", "[", 
              RowBox[{"Last", "/@", "pnts"}], "]"}]}], ",", "2"}], "]"}], ",", 
          RowBox[{"Last", "[", "#", "]"}]}], "]"}], "&"}]}], "]"}]}], ",", 
    "2", ",", "n"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.969535701776084*^9, 3.969535718251523*^9}, {
   3.969535769118451*^9, 3.9695357890099583`*^9}, {3.969535827409506*^9, 
   3.9695358297489*^9}, 3.9695358714845457`*^9, {3.9695366104915113`*^9, 
   3.96953663919016*^9}, {3.969536881452512*^9, 3.9695368846705017`*^9}},
 CellLabel->
  "In[495]:=",ExpressionUUID->"70dd8a3b-17ca-4ecf-8830-b33c1aac269c"],

Cell["Calculate the estimated eigenphases for the two peaks:", "Text",
 CellChangeTimes->{{3.969541960703425*^9, 
  3.969541985034334*^9}},ExpressionUUID->"b58f2b40-6ad8-4245-931d-\
924ee8d9a8a4"],

Cell[BoxData[
 RowBox[{"estimated\[Theta]", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"FromDigits", "[", 
        RowBox[{"#", ",", "2"}], "]"}], 
       RowBox[{"2", "^", "n"}]], "&"}], "/@", "peakResults"}], "//", "Sort"}],
    "//", "N"}]}]], "Input",
 CellChangeTimes->{{3.969535880536499*^9, 3.9695358988975697`*^9}, {
  3.969535956427958*^9, 3.9695359583911877`*^9}, {3.969536601100717*^9, 
  3.969536616129242*^9}, {3.969536648505858*^9, 3.969536664957613*^9}},
 CellLabel->
  "In[496]:=",ExpressionUUID->"2c364455-c901-4da1-a38c-9d92359ef9f5"],

Cell["Compare the estimated values with the true values:", "Text",
 CellChangeTimes->{{3.969541990296329*^9, 
  3.96954199684487*^9}},ExpressionUUID->"7c3f1a68-c6c8-4a14-913f-\
aed18352f94b"],

Cell[BoxData[
 RowBox[{"MapThread", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"PercentForm", "[", 
     RowBox[{"1", "-", 
      RowBox[{"#1", "/", "#2"}]}], "]"}], "&"}], ",", 
   RowBox[{"{", 
    RowBox[{"estimated\[Theta]", ",", 
     RowBox[{"Sort", "[", "\[Theta]s", "]"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.969535904783081*^9, 3.969535945057897*^9}},
 CellLabel->
  "In[497]:=",ExpressionUUID->"d9982e8a-08bb-4677-ba8d-b8c205d177e3"],

Cell["\<\
In practice, the situation can be more complex. If increasing the number of \
control qubits still yields no clear multiple peaks, the target\
\[CloseCurlyQuote]s initial state likely needs adjustment. With suitable \
state-preparation strategies, you can obtain informative outcomes. These \
techniques are beyond this course, but are worth exploring. The \
computational machinery is exactly what we\[CloseCurlyQuote]ve used above.\
\>", "Text",
 CellChangeTimes->{{3.9695420224543667`*^9, 3.969542116418294*^9}, 
   3.969542476451618*^9},ExpressionUUID->"b6b03d2e-d1df-4828-996e-\
7bcebf6cda16"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Shor\[CloseCurlyQuote]s Algorithm for Factorization", "Chapter",
 CellChangeTimes->{{3.9552068592185345`*^9, 
  3.9552068657504444`*^9}},ExpressionUUID->"cfeda639-f816-4496-b4fb-\
d0e83e47df03"],

Cell["\<\
We will present a concise overview of Shor\[CloseCurlyQuote]s algorithm as a \
hybrid quantum\[Dash]classical method for integer factorization. The \
classical stages reduce factoring to order finding and later convert the \
quantum output into nontrivial factors via greatest common divisors. The \
quantum core uses phase estimation on a modular multiplication unitary to \
extract periodicity, from which the order is inferred and factors are \
recovered with high probability. An illustrative example and operator \
construction clarify how the circuit is built and why it yields an efficient \
factoring procedure compared to known classical algorithms.\
\>", "Text",
 CellChangeTimes->{{3.969214303237823*^9, 3.969214303899136*^9}, 
   3.969218336126132*^9, {3.969542596096669*^9, 
   3.9695426038599033`*^9}},ExpressionUUID->"54431d51-f4db-41e0-9048-\
3f2212b7b65c"],

Cell[CellGroupData[{

Cell["Key Concepts", "Section",
 CellChangeTimes->{{3.9458857262477703`*^9, 
  3.945885728184759*^9}},ExpressionUUID->"75c121f1-6820-49f9-ac22-\
06e7d9e82b55"],

Cell["Hybrid algorithm", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, {
  3.9459508180356083`*^9, 3.9459508219695263`*^9}, {3.9465031788793373`*^9, 
  3.9465031894301834`*^9}, {3.9548600289721966`*^9, 3.954860032093584*^9}, {
  3.9552069118913784`*^9, 3.955206918579336*^9}, {3.955207387443159*^9, 
  3.955207387443159*^9}},ExpressionUUID->"f4520f96-5c37-4376-bb27-\
88eafaf6adc4"],

Cell["Shor\[CloseCurlyQuote]s algorithm", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, {
   3.9459508180356083`*^9, 3.9459508219695263`*^9}, {3.9465031788793373`*^9, 
   3.9465031894301834`*^9}, {3.9548600289721966`*^9, 3.954860032093584*^9}, {
   3.9552069118913784`*^9, 3.955206918579336*^9}, {3.9552073885294533`*^9, 
   3.9552073915492764`*^9}, 
   3.955207428906706*^9},ExpressionUUID->"b9658f5a-35dc-45e7-87f7-\
6dd37f557d5c"],

Cell["Order finding problem", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, 
   3.945966437091715*^9, {3.94650320037673*^9, 3.9465032026390457`*^9}, {
   3.9465034302710743`*^9, 3.9465034355196266`*^9}, {3.9465079620495815`*^9, 
   3.94650798489847*^9}, {3.946921626805523*^9, 3.9469216289980717`*^9}, {
   3.954860034753294*^9, 3.9548600366745224`*^9}, {3.9552069230513515`*^9, 
   3.95520692616238*^9}},ExpressionUUID->"07c41fe1-90f3-475d-9b4f-\
e55f31c4bc33"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Factorization Through Order Finding", "Section",
 CellChangeTimes->{{3.955468510008278*^9, 
  3.9554685192157173`*^9}},ExpressionUUID->"2dab6500-0aca-4335-a870-\
c5331d7b5c79"],

Cell["\<\
Efficient integer factoring matters in many applications (e.g., \
cryptography). For some special integers, fast classical methods exist. More \
generally, factoring can be reduced to an order-finding problem, for which \
there is an efficient quantum algorithm: Shor\[CloseCurlyQuote]s \
order-finding. In a hybrid approach, classical pre-processing reformulates \
factoring as order finding, the quantum routine solves that subproblem, and \
classical post-processing converts its output back to the factors. If both \
classical stages are efficient, this hybrid yields a faster overall factoring \
method than known classical algorithms.\
\>", "Text",
 CellChangeTimes->{{3.969311412412715*^9, 3.9693114150620537`*^9}, {
  3.969320597192021*^9, 
  3.969320626261426*^9}},ExpressionUUID->"9a267692-9258-45d0-8f20-\
93ef2e70798a"],

Cell[CellGroupData[{

Cell["Full algorithm", "Subsection",
 CellChangeTimes->{{3.969355987623088*^9, 
  3.9693559908065977`*^9}},ExpressionUUID->"f3a2b273-6f46-46da-9bee-\
f243a5262b3b"],

Cell["\<\
The steps for Shor\[CloseCurlyQuote]s probabilistic algorithm to factor \
\[ScriptN] are as follows:\
\>", "Text",
 CellChangeTimes->{{3.9554766668991623`*^9, 3.9554766761342564`*^9}, {
   3.9554767108423424`*^9, 3.9554767295143986`*^9}, 3.969114043087391*^9, {
   3.96932088682226*^9, 
   3.969320890229919*^9}},ExpressionUUID->"8e3d1d65-1efb-4037-92a2-\
64b9a4d93a71"],

Cell[TextData[{
 "Randomly select \[ScriptA] between 2 and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptN]", "-", "2"}], TraditionalForm]],ExpressionUUID->
  "fdc6e482-3e49-4685-be43-4be9253add41"],
 ", inclusive."
}], "ItemNumbered",
 CellChangeTimes->{{3.955476738332821*^9, 3.955476787015999*^9}, {
  3.9691140447584953`*^9, 3.969114044758523*^9}, {3.969320614582492*^9, 
  3.9693206145825357`*^9}},ExpressionUUID->"802d1d66-34ff-4cfe-984b-\
9c8e96de62a9"],

Cell[CellGroupData[{

Cell[TextData[{
 "Calculate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"GCD", "(", 
    RowBox[{"\[ScriptA]", ",", "\[ScriptN]"}], ")"}], TraditionalForm]],
  ExpressionUUID->"b3921b95-e455-4dcc-8158-695f6784e188"],
 "."
}], "ItemNumbered",
 CellChangeTimes->{{3.955476738332821*^9, 3.95547677039456*^9}, {
  3.955476812581249*^9, 3.9554768827231865`*^9}, {3.96911404618404*^9, 
  3.969114046184105*^9}, {3.9693207214747334`*^9, 3.969320727410483*^9}, {
  3.9693209735835876`*^9, 
  3.969320992941825*^9}},ExpressionUUID->"5f6a0690-0824-4750-bf50-\
18166a8b02bd"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"GCD", "(", 
     RowBox[{"\[ScriptA]", ",", "\[ScriptN]"}], ")"}], "=", "1"}], 
   TraditionalForm]],ExpressionUUID->"a7981e88-69d7-4c21-af1c-1969d9a8e7f2"],
 ", continue."
}], "SubitemNumbered",
 CellChangeTimes->{{3.955476738332821*^9, 3.95547677039456*^9}, {
   3.955476812581249*^9, 3.955476893307787*^9}, {3.969114053916462*^9, 
   3.9691140574304533`*^9}, {3.9693207295385227`*^9, 3.969320746942071*^9}, {
   3.96932098239285*^9, 3.9693209887665873`*^9}, 
   3.971797408857534*^9},ExpressionUUID->"6ac61b3a-c4a4-4059-b020-\
0924666e041d"],

Cell["Otherwise, you have already found a nontrivial factor.", \
"SubitemNumbered",
 CellChangeTimes->{{3.955476738332821*^9, 3.95547677039456*^9}, {
  3.955476812581249*^9, 3.955476893307787*^9}, {3.969114053916462*^9, 
  3.9691140574304533`*^9}, {3.9693207295385227`*^9, 3.969320746942071*^9}, {
  3.9693210457878942`*^9, 
  3.969321047835908*^9}},ExpressionUUID->"77b1674b-5a9a-40ac-be65-\
9c0085113765"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Compute the multiplicative order of \[ScriptA] modulo \[ScriptCapitalN]. \
This is the smallest whole number, \[ScriptR], such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[ScriptA]", "\[ScriptR]"], " ", "mod", " ", 
      "\[ScriptCapitalN]"}], ")"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"b8da41d1-2c74-4968-9133-12fce2d13d8f"],
 "."
}], "ItemNumbered",
 CellChangeTimes->{{3.955476738332821*^9, 3.95547677039456*^9}, {
   3.955476812581249*^9, 3.955476991068123*^9}, {3.955477036262512*^9, 
   3.955477098993767*^9}, {3.955477140701668*^9, 3.955477140717308*^9}, {
   3.969114052375248*^9, 3.9691140625085287`*^9}, 
   3.9693837085150003`*^9},ExpressionUUID->"b42b1a2d-4d08-4d44-8dca-\
093564a7a054"],

Cell["If \[ScriptR] is even, continue.", "SubitemNumbered",
 CellChangeTimes->{{3.955476738332821*^9, 3.95547677039456*^9}, {
  3.955476812581249*^9, 3.955476991068123*^9}, {3.955477036262512*^9, 
  3.955477098993767*^9}, {3.9554771889206314`*^9, 
  3.9554772024955006`*^9}},ExpressionUUID->"ae389307-2ada-4abf-aa5c-\
abd5f5233c72"],

Cell["\<\
If \[ScriptR] is odd, the algorithm failed, and you must try with a new \
\[ScriptA].\
\>", "SubitemNumbered",
 CellChangeTimes->{{3.955476738332821*^9, 3.95547677039456*^9}, {
  3.955476812581249*^9, 3.955476991068123*^9}, {3.955477036262512*^9, 
  3.955477098993767*^9}, {3.9554771889206314`*^9, 
  3.9554772237136135`*^9}},ExpressionUUID->"004158f7-3443-4333-8dac-\
d9b2d03a6517"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Calculate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[ScriptA]", 
     RowBox[{"r", "/", "2"}]], " ", "mod", " ", "\[ScriptN]"}], 
   TraditionalForm]],ExpressionUUID->"19ba4236-dd3a-4bfd-a0b9-8c8226e61622"]
}], "ItemNumbered",
 CellChangeTimes->{{3.955476738332821*^9, 3.95547677039456*^9}, {
  3.955476812581249*^9, 3.9554768827231865`*^9}, {3.955477251912998*^9, 
  3.955477268403919*^9}, {3.9691140484382067`*^9, 3.969114049903337*^9}, {
  3.969320787519623*^9, 3.969320841266589*^9}, {3.9693209243123827`*^9, 
  3.9693209243215523`*^9}, {3.969320965877767*^9, 
  3.969321003807543*^9}},ExpressionUUID->"5790ae0f-d9bd-4ae4-9fdb-\
3b3e7273e44d"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[ScriptA]", 
      RowBox[{"r", "/", "2"}]], " ", "mod", " ", "\[ScriptN]"}], "!=", 
    RowBox[{"\[PlusMinus]", "1"}]}], TraditionalForm]],ExpressionUUID->
  "0b3b090f-ee93-4f22-a75c-a84a6f562d8e"],
 ", continue."
}], "SubitemNumbered",
 CellChangeTimes->{{3.955476738332821*^9, 3.95547677039456*^9}, {
  3.955476812581249*^9, 3.9554768827231865`*^9}, {3.955477251912998*^9, 
  3.955477268403919*^9}, {3.9691140484382067`*^9, 3.969114049903337*^9}, {
  3.969320787519623*^9, 3.969320841266589*^9}, {3.969320942064927*^9, 
  3.969320952367241*^9}, {3.969321005303533*^9, 
  3.969321033802554*^9}},ExpressionUUID->"03d834d2-0f68-46aa-8e10-\
b423610c6c9c"],

Cell["Otherwise, you must try with a new \[ScriptA].", "SubitemNumbered",
 CellChangeTimes->{{3.955476738332821*^9, 3.95547677039456*^9}, {
  3.955476812581249*^9, 3.9554768827231865`*^9}, {3.955477251912998*^9, 
  3.955477268403919*^9}, {3.9691140484382067`*^9, 3.969114049903337*^9}, {
  3.969320787519623*^9, 3.969320841266589*^9}, {3.969320942064927*^9, 
  3.969320961111843*^9}, {3.9693210069692183`*^9, 
  3.9693210071945763`*^9}},ExpressionUUID->"244f96ba-09f7-45ec-a2d6-\
ce1b24106b41"]
}, Open  ]],

Cell[TextData[{
 "Compute ",
 Cell[BoxData[
  FormBox[
   RowBox[{"GCD", "(", 
    RowBox[{"\[ScriptN]", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[ScriptA]", 
         RowBox[{"\[ScriptR]", "/", "2"}]], "-", "1"}], ")"}], " ", "mod", " ",
       "\[ScriptN]"}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "6925ca5e-85fa-4f64-8482-22b6250ac5c9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"GCD", "(", 
    RowBox[{"\[ScriptN]", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[ScriptA]", 
         RowBox[{"\[ScriptR]", "/", "2"}]], "+", "1"}], ")"}], " ", "mod", " ",
       "\[ScriptN]"}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "87d4766f-e43f-492d-9293-231d73874037"],
 "."
}], "ItemNumbered",
 CellChangeTimes->{{3.955476738332821*^9, 3.95547677039456*^9}, {
  3.955476812581249*^9, 3.9554768827231865`*^9}, {3.955477251912998*^9, 
  3.955477268403919*^9}, {3.9691140484382067`*^9, 3.969114049903337*^9}, {
  3.969320787519623*^9, 3.969320788458346*^9}, {3.969321059239183*^9, 
  3.969321059239307*^9}},ExpressionUUID->"b3a816ac-f9d0-4479-86ec-\
53ad7e5caa68"],

Cell[TextData[{
 "Shor\[CloseCurlyQuote]s key reduction is: if you can find the order ",
 Cell[BoxData[
  FormBox["\|01d45f", TraditionalForm]],ExpressionUUID->
  "ed7ab75c-03c3-4e60-8f00-3033f92cdc28"],
 " of a random \[ScriptA] coprime to ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalN]", TraditionalForm]],ExpressionUUID->
  "727a05d2-9346-44cc-8b6f-34cff9873eb5"],
 ", you can factor ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalN]", TraditionalForm]],ExpressionUUID->
  "621d2ccf-64b8-40a4-9118-dab72a420168"],
 " with good probability. The core of Shor is quantum ",
 StyleBox["order ",
  FontSlant->"Italic"],
 "finding."
}], "Text",
 CellChangeTimes->{{3.969329451806102*^9, 3.969329475743897*^9}, {
   3.96935581984365*^9, 3.969355833264358*^9}, {3.969355892587105*^9, 
   3.96935593227391*^9}, {3.969383671000759*^9, 3.969383672582204*^9}, {
   3.969383708526318*^9, 3.969383708532949*^9}, 
   3.971797402504017*^9},ExpressionUUID->"a6769633-b4ea-42e4-9b23-\
36549610c1c1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example: Step-by-Step Factorization", "Subsection",
 CellChangeTimes->{{3.969355966324898*^9, 3.969355972219495*^9}, {
  3.969356450846724*^9, 
  3.969356452753243*^9}},ExpressionUUID->"5e98f817-bff3-476f-8b8d-\
d804ce2e5f7d"],

Cell[TextData[{
 "Suppose you want to factor an integer \[ScriptCapitalN]. If \
\[ScriptCapitalN] is even or a prime power, there are fast tests and \
efficient factorizations. So assume \[ScriptCapitalN] is neither even nor a \
prime power. As an example, let\[CloseCurlyQuote]s take the number ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalN]", TraditionalForm]],ExpressionUUID->
  "06388e00-421b-4dd0-b973-ca364465023f"],
 " to be 15."
}], "Text",
 CellChangeTimes->{{3.9554704067219753`*^9, 3.9554704259687157`*^9}, {
  3.969113740731646*^9, 3.96911374073166*^9}, {3.96931941324219*^9, 
  3.969319413341433*^9}, {3.969321355586541*^9, 3.969321356049529*^9}, {
  3.969355951862397*^9, 3.9693559530319242`*^9}, {3.969383700299065*^9, 
  3.969383708542701*^9}},ExpressionUUID->"93d21adc-3de6-4691-ad5c-\
14f7c8103796"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalN]", "=", "15"}], ";"}]], "Input",
 CellChangeTimes->{{3.955470529154497*^9, 3.9554705390285645`*^9}, {
   3.9554706070706024`*^9, 3.955470633637272*^9}, 3.969113710199418*^9, {
   3.9693194108045*^9, 3.9693194109100943`*^9}, {3.969321353425219*^9, 
   3.96932135387154*^9}},
 CellLabel->
  "In[498]:=",ExpressionUUID->"5f70612b-3fa3-4cb8-a4ce-a592f3a3eee3"],

Cell["Verify that \[ScriptCapitalN] is neither even nor a prime number:", \
"Text",
 CellChangeTimes->{{3.969113747328638*^9, 3.969113754281785*^9}, {
   3.969319088509118*^9, 3.9693191055965967`*^9}, 3.969319373582423*^9, 
   3.9693837085474167`*^9},ExpressionUUID->"9f29134f-b86a-443f-8f66-\
027a6884032b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"EvenQ", "[", "\[ScriptCapitalN]", "]"}], ",", 
   RowBox[{"PrimeQ", "[", "\[ScriptCapitalN]", "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.9691137137878942`*^9, 3.969113718356483*^9}, {
  3.969319111222666*^9, 3.969319116236968*^9}},
 CellLabel->
  "In[499]:=",ExpressionUUID->"247f7509-3bb2-4f35-b731-0de147a9d563"],

Cell[TextData[{
 "Pick a number at random between 2 and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptN]", "-", "2"}], TraditionalForm]],ExpressionUUID->
  "407d6044-6a24-455f-b542-8859a9d832db"],
 " (the actual code would be ",
 Cell[BoxData[
  FormBox[
   RowBox[{"RandomInteger", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", 
      RowBox[{"\[ScriptN]", "-", "2"}]}], "}"}], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "90bfc01a-056e-4373-925c-46278afd54e7"],
 "). For clarity, we\[CloseCurlyQuote]ll fix a specific value here to walk \
through the steps."
}], "Text",
 CellChangeTimes->{{3.955470276754757*^9, 3.9554702775096607`*^9}, {
   3.955470379409012*^9, 3.9554704024106655`*^9}, {3.955470453087286*^9, 
   3.9554704591381283`*^9}, {3.955470663710596*^9, 3.955470671782797*^9}, {
   3.9554760378035126`*^9, 3.955476049226965*^9}, {3.969113986592945*^9, 
   3.9691139883128033`*^9}, {3.9693181992005777`*^9, 3.969318199200708*^9}, 
   3.96931912376036*^9, {3.96931920396391*^9, 3.969319220165702*^9}, {
   3.969319443875751*^9, 3.969319457102042*^9}, {3.969319495552443*^9, 
   3.969319497868945*^9}},ExpressionUUID->"1537b783-9a87-4720-af57-\
ab0ebfc160b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptA]", "=", "13"}], ";"}]], "Input",
 CellChangeTimes->{{3.9554706779962425`*^9, 3.9554707065262337`*^9}, {
   3.9693181931836863`*^9, 3.969318197444016*^9}, {3.969319200081169*^9, 
   3.969319200456764*^9}, 3.969320317021885*^9},
 CellLabel->
  "In[500]:=",ExpressionUUID->"ee180afd-581c-4afc-9277-0a7709169855"],

Cell["Check that \[ScriptA] and \[ScriptCapitalN] are coprime:", "Text",
 CellChangeTimes->{{3.969311622781149*^9, 3.969311628479567*^9}, {
   3.969320330825266*^9, 3.969320379948247*^9}, 
   3.9693671077994413`*^9},ExpressionUUID->"a7f83747-6b04-4cf0-b16e-\
c43346a3cf00"],

Cell[BoxData[
 RowBox[{"CoprimeQ", "[", 
  RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}]], "Input",
 CellChangeTimes->{{3.969311593931925*^9, 3.969311607150002*^9}},
 CellLabel->
  "In[501]:=",ExpressionUUID->"bd573418-85ec-4a08-9e3b-ebfe44d14acc"],

Cell[TextData[{
 "If they are not coprime (i.e., ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"GCD", "[", 
     RowBox[{"\[ScriptA]", ",", "\[ScriptN]"}], "]"}], ">", "1"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f69fd48e-c3e2-473c-9e31-2e832beac62e"],
 "), we have already found a nontrivial factor. Otherwise, we continue to the \
order-finding step."
}], "Text",
 CellChangeTimes->{{3.969318296194757*^9, 3.96931835783526*^9}, {
  3.969318927800096*^9, 
  3.9693189374564333`*^9}},ExpressionUUID->"a5adc095-6125-402e-8e9d-\
7cb53464653b"],

Cell["Compute the multiplicative order of \[ScriptA] modulo \
\[ScriptCapitalN]:", "Text",
 CellChangeTimes->{{3.955476063039406*^9, 3.9554760774026833`*^9}, 
   3.969114032599053*^9, 
   3.969367107808036*^9},ExpressionUUID->"532e506b-4509-49e8-bd24-\
ad06dc1eb7a7"],

Cell[BoxData[
 RowBox[{"r", "=", 
  RowBox[{"MultiplicativeOrder", "[", 
   RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9554760799548473`*^9, 3.955476088811352*^9}, {
  3.9693183952258043`*^9, 3.969318395358266*^9}},
 CellLabel->
  "In[502]:=",ExpressionUUID->"0d71651e-a7be-474e-ac8f-72ffd9c2f4b5"],

Cell["\<\
Note that above step is the one that has a quantum subroutine. We will \
discuss it later.\
\>", "Text",
 CellChangeTimes->{{3.969356466949686*^9, 
  3.969356496703951*^9}},ExpressionUUID->"a688e0a2-4b98-424d-a75c-\
2e294f483256"],

Cell[TextData[{
 "Given the definition of \[ScriptR], verify that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[ScriptA]", "r"], " ", "mod", " ", "\[ScriptN]"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d700b6c2-62e8-4d8b-b746-24100cf06af1"],
 " is 1"
}], "Text",
 CellChangeTimes->{{3.969318442680879*^9, 3.969318473116591*^9}, 
   3.9693204050793867`*^9, {3.969356513371209*^9, 
   3.969356526149415*^9}},ExpressionUUID->"15adea5e-03c2-4def-9cd8-\
c6ae9e24ff75"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Mod", "[", 
   RowBox[{
    SuperscriptBox["\[ScriptA]", "r"], ",", "\[ScriptCapitalN]"}], "]"}], "==",
   "1"}]], "Input",
 CellChangeTimes->{{3.969318422485918*^9, 3.969318440046184*^9}},
 CellLabel->
  "In[503]:=",ExpressionUUID->"588b4b70-229e-413f-ad09-a7f1fbc3b5f4"],

Cell[TextData[{
 "If the order ",
 Cell[BoxData[
  FormBox["\[ScriptR]", TraditionalForm]],ExpressionUUID->
  "defaa686-ead1-4fd3-8c0c-c1ee4e08c974"],
 " is odd, pick another ",
 Cell[BoxData[
  FormBox["\[ScriptA]", TraditionalForm]],ExpressionUUID->
  "2751d069-a1f8-4a83-9795-4833ac65f640"],
 "; otherwise check  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[ScriptA]", 
      RowBox[{"r", "/", "2"}]], " ", "mod", " ", "\[ScriptN]"}], "!=", 
    RowBox[{"\[PlusMinus]", "1"}]}], TraditionalForm]],ExpressionUUID->
  "79b42d55-c6c7-477b-b2e5-ae66abf8d8ed"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9693185200376368`*^9, 3.9693185605359497`*^9}, {
   3.969320415907422*^9, 3.969320454922534*^9}, 
   3.971797420412731*^9},ExpressionUUID->"2631c72a-e72c-4825-a7f5-\
2373629d7380"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Mod", "[", 
    RowBox[{
     SuperscriptBox["\[ScriptA]", 
      RowBox[{"r", "/", "2"}]], ",", "\[ScriptCapitalN]"}], "]"}], "!=", 
   RowBox[{"-", "1"}]}], "&&", 
  RowBox[{
   RowBox[{"Mod", "[", 
    RowBox[{
     SuperscriptBox["\[ScriptA]", 
      RowBox[{"r", "/", "2"}]], ",", "\[ScriptCapitalN]"}], "]"}], "!=", 
   "1"}]}]], "Input",
 CellChangeTimes->{{3.9693185119775257`*^9, 3.969318512141467*^9}, {
  3.9693195573272953`*^9, 3.969319559709043*^9}, {3.969320458696694*^9, 
  3.9693204627409782`*^9}},
 CellLabel->
  "In[504]:=",ExpressionUUID->"8fa4df43-41fa-4e9b-afaa-59c023f5f60b"],

Cell[TextData[{
 "If the above relation is not satisfied, pick another ",
 Cell[BoxData[
  FormBox["\[ScriptA]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "395e9dc9-d2ee-45f9-aa59-b0b87e29275d"],
 "."
}], "Text",
 CellChangeTimes->{{3.969320512510845*^9, 
  3.969320531633286*^9}},ExpressionUUID->"1436facd-b406-4298-85d3-\
d6c32f412cd9"],

Cell[TextData[{
 "Compute ",
 Cell[BoxData[
  FormBox[
   RowBox[{"GCD", "(", 
    RowBox[{"\[ScriptN]", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[ScriptA]", 
         RowBox[{"\[ScriptR]", "/", "2"}]], "-", "1"}], ")"}], " ", "mod", " ",
       "\[ScriptN]"}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "78d50207-1319-42a1-9a52-3a2b5bbf0454"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"GCD", "(", 
    RowBox[{"\[ScriptN]", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[ScriptA]", 
         RowBox[{"\[ScriptR]", "/", "2"}]], "+", "1"}], ")"}], " ", "mod", " ",
       "\[ScriptN]"}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "1e23f3d0-9e4a-4da0-8365-b592b85f3192"],
 ":"
}], "Text",
 CellChangeTimes->{{3.95547609555274*^9, 3.9554761270095634`*^9}, {
   3.96911402950578*^9, 3.969114031071739*^9}, {3.969318565656328*^9, 
   3.969318590069869*^9}, 
   3.9693205371708117`*^9},ExpressionUUID->"6bdbdc9e-eb86-45b1-8685-\
204e2bf0b053"],

Cell[BoxData[{
 RowBox[{"GCD", "[", 
  RowBox[{"\[ScriptCapitalN]", ",", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ScriptA]", 
       RowBox[{"r", "/", "2"}]], "-", "1"}], ",", "\[ScriptCapitalN]"}], 
    "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"GCD", "[", 
  RowBox[{"\[ScriptCapitalN]", ",", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ScriptA]", 
       RowBox[{"r", "/", "2"}]], "+", "1"}], ",", "\[ScriptCapitalN]"}], 
    "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9554761287811623`*^9, 3.955476216640478*^9}, 
   3.969318404099263*^9, {3.96931859281264*^9, 3.969318594752905*^9}},
 CellLabel->
  "In[505]:=",ExpressionUUID->"551d7c46-22ba-4d27-848a-31c58ab5609b"],

Cell[TextData[{
 "These are nontrivial factors of \[ScriptCapitalN] (as expected, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"15", "=", 
    RowBox[{"3", "\[Cross]", "5"}]}], TraditionalForm]],ExpressionUUID->
  "e73bc324-46b0-4b52-8af3-14061341feb1"],
 ")."
}], "Text",
 CellChangeTimes->{{3.9554762518909283`*^9, 3.9554762615627995`*^9}, {
   3.9693186016195097`*^9, 3.9693186320576982`*^9}, {3.969319568932876*^9, 
   3.9693195710244637`*^9}, {3.969321362860218*^9, 3.969321364934655*^9}, 
   3.969367107819192*^9},ExpressionUUID->"66707996-1484-4979-a6fb-\
a2fdae37a01f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Order Finding with a Quantum Circuit", "Section",
 CellChangeTimes->{{3.955477920658659*^9, 
  3.955477928652073*^9}},ExpressionUUID->"14194c69-1b50-4e39-a132-\
ac76db640dd5"],

Cell[TextData[{
 "We need a unitary that maps ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     TemplateBox[{"x"},
      "Ket"], 
     TemplateBox[{"1"},
      "Ket"]}], "->", 
    RowBox[{
     TemplateBox[{"x"},
      "Ket"], 
     TemplateBox[{
       RowBox[{
         SuperscriptBox["\[ScriptA]", "x"], " ", "mod", " ", 
         "\[ScriptCapitalN]"}]},
      "Ket"]}]}], TraditionalForm]],ExpressionUUID->
  "08ed1258-7ff3-4586-8d67-edad8ec9cf1d"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[Element]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "\[Ellipsis]", ",", 
      RowBox[{
       SuperscriptBox["2", "n"], "-", "1"}]}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"fbb000cb-18bf-483f-943e-14684b505cee"],
 ", where typically ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[ScriptCapitalN]", "2"], "<=", 
    SuperscriptBox["2", "n"], "<", 
    RowBox[{"2", 
     SuperscriptBox["\[ScriptCapitalN]", "2"]}]}], TraditionalForm]],
  ExpressionUUID->"3524931c-54bd-4056-82de-985549b001ab"],
 ". This is built from controlled powers of a base unitary ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "\[ScriptA]"], TraditionalForm]],ExpressionUUID->
  "56c4b715-a314-45c9-8aa9-8f538e3dfa21"],
 " acting on the work register: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["U", "\[ScriptA]"], " ", 
     TemplateBox[{"y"},
      "Ket"]}], "=", 
    TemplateBox[{
      RowBox[{"\[ScriptA]", " ", "y", " ", "mod", " ", "\[ScriptCapitalN]"}]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "17936179-f359-40c1-b638-53803249c5b2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["U", "\[ScriptA]", 
      SuperscriptBox["2", "k"]], " ", 
     TemplateBox[{"y"},
      "Ket"]}], "=", 
    TemplateBox[{
      RowBox[{
        SuperscriptBox["\[ScriptA]", 
         SuperscriptBox["2", "k"]], " ", "y", " ", "mod", " ", 
        "\[ScriptCapitalN]"}]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "17d364d3-0176-4f82-af15-927baf05bddc"],
 "  with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "\[Element]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "\[Ellipsis]", ",", 
      RowBox[{"\[ScriptCapitalN]", "-", "1"}]}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"afb6bf59-1ae1-431e-b653-185a113cfd16"],
 ". If the control register holds ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "0"}], 
      RowBox[{"\[ScriptCapitalN]", "-", "1"}]], 
     RowBox[{
      SubscriptBox["x", "k"], 
      SuperscriptBox["2", "k"]}]}]}], TraditionalForm]],ExpressionUUID->
  "d9c3a18f-a1df-4235-aef5-c3c508f59457"],
 " in binary, then: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Product]", 
      RowBox[{"k", "=", "0"}], 
      RowBox[{"\[ScriptCapitalN]", "-", "1"}]], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        SubsuperscriptBox["U", "\[ScriptA]", 
         SuperscriptBox["2", "k"]], ")"}], 
       SubscriptBox["x", "k"]], 
      TemplateBox[{"1"},
       "Ket"]}]}], "=", 
    RowBox[{
     TemplateBox[{
       RowBox[{
         SuperscriptBox["\[ScriptA]", 
          RowBox[{
            SubscriptBox["\[Sum]", "k"], 
            RowBox[{
              SubscriptBox["x", "k"], 
              SuperscriptBox["2", "k"]}]}]], " ", "mod", " ", 
         "\[ScriptCapitalN]"}]},
      "Ket"], "=", 
     TemplateBox[{
       RowBox[{
         SuperscriptBox["\[ScriptA]", "x"], " ", "mod", " ", 
         "\[ScriptCapitalN]"}]},
      "Ket"]}]}], TraditionalForm]],ExpressionUUID->
  "b0cdcf00-1b94-4688-8d7d-3b3dea0151c2"],
 ". So operationally: for each control bit ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "k"], TraditionalForm]],ExpressionUUID->
  "909c72b7-4024-4381-93ed-b1e3730a5db3"],
 ", apply a controlled-",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["U", "\[ScriptA]", 
    SuperscriptBox["2", "k"]], TraditionalForm]],ExpressionUUID->
  "ffcbfeac-9b58-4492-93a5-7ef7380efd21"],
 " to the work register. For this aim, the number of control registers is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", 
    TemplateBox[{
      RowBox[{"log2", " ", "Q"}]},
     "Ceiling"]}], TraditionalForm]],ExpressionUUID->
  "94b93ac2-6bf7-4c46-aa67-8be36ba8c62e"],
 " (with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[ScriptCapitalN]", "2"], "<=", "Q", "<", 
    RowBox[{"2", 
     SuperscriptBox["\[ScriptCapitalN]", "2"]}]}], TraditionalForm]],
  ExpressionUUID->"3fcefa39-b2b6-48c8-85dd-a27ffdf87ad1"],
 ") and the number of work registers is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", 
    TemplateBox[{
      RowBox[{"log2", " ", "\[ScriptCapitalN]"}]},
     "Ceiling"]}], TraditionalForm]],ExpressionUUID->
  "41200f45-b305-4ae6-9008-53f6ca8ff985"],
 ", with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"\[Ellipsis]"},
    "Ceiling"], TraditionalForm]],ExpressionUUID->
  "ffa02642-1a71-4500-836f-b2d983374544"],
 " the smallest integer greater than or equal to."
}], "Text",
 CellChangeTimes->{{3.9693565725330544`*^9, 3.9693566467443743`*^9}, {
   3.969356696231229*^9, 3.96935682528616*^9}, {3.9693568640253353`*^9, 
   3.969356993735683*^9}, {3.969357049828656*^9, 3.969357123171132*^9}, {
   3.9693576003032303`*^9, 3.969357615164267*^9}, {3.969357682535009*^9, 
   3.9693576896982727`*^9}, {3.9693577301232357`*^9, 
   3.9693577412888803`*^9}, {3.9693674150428963`*^9, 3.969367467975769*^9}, {
   3.969368391065933*^9, 3.9693684109725122`*^9}, {3.969369879065118*^9, 
   3.969369900681913*^9}, 
   3.9717974312506247`*^9},ExpressionUUID->"938acaa3-a3d3-4c7c-942f-\
097869e053ad"],

Cell[CellGroupData[{

Cell[TextData[{
 "Constructing the Operator ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "\[ScriptA]"], TraditionalForm]],ExpressionUUID->
  "6cd5a7c8-5a66-4476-9fce-9cf5aaa2b091"]
}], "Subsection",
 CellChangeTimes->{{3.9554781824040565`*^9, 3.9554782066962147`*^9}, {
  3.969357207236709*^9, 
  3.9693572079214363`*^9}},ExpressionUUID->"d795d9c0-92bc-451b-b981-\
aec56bb9cca5"],

Cell["\<\
Remember that a quantum operator can be specified as a matrix that defines \
its action on states. What happens if you try to define a multiplication \
operator using the most straightforward approach? Is such an operator unitary?\
\>", "Text",
 CellChangeTimes->{{3.9554783507295895`*^9, 3.9554783929828243`*^9}, {
  3.955638993315136*^9, 3.9556389962713127`*^9}, {3.9557354580295086`*^9, 
  3.9557354623053894`*^9}},ExpressionUUID->"848f5ff7-6768-454c-a6c2-\
62185e96fee3"],

Cell[TextData[{
 "Show, with a concrete example, that the multiplication operator defined as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", 
    RowBox[{"i", ",", 
     RowBox[{"(", 
      RowBox[{"a", " ", "j", " ", "mod", " ", "\[ScriptCapitalN]"}], ")"}]}]],
    TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eb860e44-439a-4b63-a193-c9f5a314b2c1"],
 " is not unitary."
}], "Text",
 CellChangeTimes->{{3.969311741606552*^9, 3.9693117940682297`*^9}, {
  3.969357258875152*^9, 
  3.969357309231203*^9}},ExpressionUUID->"7062eabf-73ba-4a0b-9154-\
5aec620e4410"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"m", "=", 
   RowBox[{"Ceiling", "[", 
    RowBox[{"Log2", "[", "\[ScriptCapitalN]", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SparseArray", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i_", ",", "j_"}], "}"}], ":>", 
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{
        RowBox[{"i", "-", "1"}], ",", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"\[ScriptA]", 
            RowBox[{"(", 
             RowBox[{"j", "-", "1"}], ")"}]}], ",", "\[ScriptCapitalN]"}], 
          "]"}], "+", "1"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      SuperscriptBox["2", "m"], ",", 
      SuperscriptBox["2", "m"]}], "}"}]}], "]"}], "//", 
  "UnitaryMatrixQ"}]}], "Input",
 CellChangeTimes->{{3.9554782180570583`*^9, 3.9554782985218163`*^9}, {
  3.955478394938055*^9, 3.9554783982612724`*^9}, {3.955478541199234*^9, 
  3.955478545408945*^9}, {3.955548248991295*^9, 3.9555483253084583`*^9}, {
  3.955548426289196*^9, 3.955548483201456*^9}, {3.955551181643942*^9, 
  3.9555511827101974`*^9}, {3.9693117989587173`*^9, 3.9693118140626497`*^9}, {
  3.9693580738684263`*^9, 3.9693581491497507`*^9}, {3.969367891947495*^9, 
  3.9693679452057962`*^9}, {3.969368479893136*^9, 3.96936850367231*^9}, {
  3.969369269521103*^9, 3.969369269722172*^9}},
 CellLabel->
  "In[507]:=",ExpressionUUID->"372a0035-9cd2-4be2-8c87-72353d70a5ec"],

Cell["\<\
You can mathematically specify such a matrix without difficultly; however, \
the resulting matrix is not unitary. This is mathematically fine, but you \
cannot implement such an operation using any rules consistent with quantum \
mechanics. Thus, the simplest approach to define a quantum operator for this \
problem is ruled out.\
\>", "Text",
 CellChangeTimes->{{3.955478403889904*^9, 3.9554784812894764`*^9}, {
  3.9555512144980392`*^9, 
  3.955551237185484*^9}},ExpressionUUID->"c23a36ef-7834-45b3-9122-\
36fedc3314d1"],

Cell["\<\
Instead, specify an operator such that it has the expected action on elements \
which are less than \[ScriptCapitalN], and leaves elements \[ScriptCapitalN] \
through the maximum size of the Hilbert space unchanged.\
\>", "Text",
 CellChangeTimes->{{3.955478484949314*^9, 3.9554785232738514`*^9}, {
   3.955478555549494*^9, 3.9554785855877495`*^9}, 3.9555508479085865`*^9, {
   3.969114085534017*^9, 3.969114103566886*^9}, {3.9693568482786407`*^9, 
   3.9693568482869883`*^9}},ExpressionUUID->"9b5090c2-1fb7-4d82-9b80-\
a364042e97d2"],

Cell[TextData[{
 "The we can define an operator such that if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", "<=", "\[ScriptCapitalN]"}], TraditionalForm]],ExpressionUUID->
  "ef51f943-bdc3-4b52-9cf3-2977eea0a25f"],
 ", then  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalU]", 
     RowBox[{"i", ",", "j"}]], "=", 
    SubscriptBox["\[Delta]", 
     RowBox[{"i", ",", 
      RowBox[{"(", 
       RowBox[{"a", " ", "j", " ", "mod", " ", "\[ScriptCapitalN]"}], 
       ")"}]}]]}], TraditionalForm]],ExpressionUUID->
  "9493eb4d-8e9a-4299-ae5e-da499f33fe1c"],
 ", otherwise ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalU]", 
     RowBox[{"i", ",", "j"}]], "=", 
    SubscriptBox["\[Delta]", 
     RowBox[{"i", ",", "j"}]]}], TraditionalForm]],ExpressionUUID->
  "0a9ed1d2-4138-4eb7-a8fd-6fe854de7500"],
 ". It\[CloseCurlyQuote]s the standard embedding of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["U", "\[ScriptA]"], ":", " ", 
     TemplateBox[{"y"},
      "Ket"]}], "->", 
    TemplateBox[{
      RowBox[{"\[ScriptA]", " ", "y", " ", "mod", " ", "\[ScriptCapitalN]"}]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "fd20681a-df06-417e-98fb-de4581ae77de"],
 "\n into a ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "m"], TraditionalForm]],ExpressionUUID->
  "17c0876c-dee1-4e2c-b839-d728373c0318"],
 "-dimensional space, provided ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalN]", "<=", 
    SuperscriptBox["2", "m"]}], TraditionalForm]],ExpressionUUID->
  "e0783f96-d1f3-4e0e-87b7-5915a5a9071c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"GCD", "(", 
     RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], ")"}], "=", "1"}], 
   TraditionalForm]],ExpressionUUID->"1d78d50b-b42e-4fe0-a674-e579f46ff8ff"],
 " (otherwise it\[CloseCurlyQuote]s not unitary)."
}], "Text",
 CellChangeTimes->{{3.9555510390676994`*^9, 3.955551047626951*^9}, {
  3.969358774489997*^9, 3.969358808403439*^9}, {3.96936860900136*^9, 
  3.9693686127634087`*^9}},ExpressionUUID->"b2e41bf5-6121-4cd4-8638-\
c7f527d1f1f1"],

Cell["\<\
Therefore, the desired unitary operator can be implemented as follows:\
\>", "Text",
 CellChangeTimes->{{3.9555510528710938`*^9, 3.9555510762875023`*^9}, {
  3.9693573460505753`*^9, 3.969357428702009*^9}, {3.9693588197456913`*^9, 
  3.969358821844946*^9}},ExpressionUUID->"71ceeafb-50d0-412b-a01d-\
3c377891a3e8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\[ScriptCapitalU]a", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalU]a", "[", 
   RowBox[{"\[ScriptA]_", ",", "\[ScriptCapitalN]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", "=", 
      RowBox[{"Ceiling", "[", 
       RowBox[{"Log2", "[", "\[ScriptCapitalN]", "]"}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"SparseArray", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i_", ",", "j_"}], "}"}], ":>", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"j", "-", "1"}], "<", "\[ScriptCapitalN]"}], ",", 
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{
           RowBox[{"i", "-", "1"}], ",", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"\[ScriptA]", " ", 
              RowBox[{"(", 
               RowBox[{"j", "-", "1"}], ")"}]}], ",", "\[ScriptCapitalN]"}], 
            "]"}]}], "]"}], ",", 
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{
           RowBox[{"i", "-", "1"}], ",", 
           RowBox[{"j", "-", "1"}]}], "]"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        SuperscriptBox["2", "m"], ",", 
        SuperscriptBox["2", "m"]}], "}"}]}], "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9555480533153667`*^9, 3.955548085693012*^9}, {
   3.955548124078022*^9, 3.955548153967518*^9}, {3.9555485084298954`*^9, 
   3.9555486804025135`*^9}, {3.955548944923586*^9, 3.955548966968498*^9}, {
   3.95554907631238*^9, 3.955549078853012*^9}, {3.9555492785261593`*^9, 
   3.9555493194722824`*^9}, {3.9555493849231396`*^9, 
   3.9555493917577343`*^9}, {3.955549474323307*^9, 3.9555494815718346`*^9}, {
   3.955549754554487*^9, 3.9555497575621624`*^9}, {3.955549885126772*^9, 
   3.9555498984349976`*^9}, {3.9555500171837406`*^9, 
   3.9555500277849083`*^9}, {3.9555501695296345`*^9, 3.955550177192194*^9}, 
   3.9555502212266426`*^9, {3.955550303715128*^9, 3.9555503182806206`*^9}, {
   3.955550457911312*^9, 3.9555505176851463`*^9}, {3.955639036960661*^9, 
   3.9556390453155766`*^9}, {3.969358155371155*^9, 3.969358224503964*^9}, 
   3.969358264858323*^9, {3.9693679533181562`*^9, 3.9693679621588993`*^9}, {
