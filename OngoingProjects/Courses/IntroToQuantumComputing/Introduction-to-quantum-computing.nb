  3.9442231634016247`*^9},ExpressionUUID->"4179e7fa-5ec5-443b-97f7-\
f1705ddd7fd7"],

Cell[TextData[{
 "The Dirac notation offers a compact, clear way to write states, operators, \
and measurements. In general ket, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"\[Ellipsis]"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "c716481e-4458-4286-b30c-0d25ee90cba0"],
 ", is a shorthand representation for a vector, and bra, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"\[Ellipsis]"},
    "Bra"], TraditionalForm]],ExpressionUUID->
  "0acdeba0-f4be-4c0c-8cb6-da50f060c9e4"],
 ", is the conjugate transpose of a ket. For a qubit, we have:"
}], "Text",
 CellChangeTimes->{{3.969207116808269*^9, 3.96920717284519*^9}, {
   3.969207329925498*^9, 3.969207336034563*^9}, 3.969219014456818*^9, {
   3.9695462109296618`*^9, 
   3.9695462180433607`*^9}},ExpressionUUID->"95820f30-fc88-4e86-8a7a-\
0bbd61775e36"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     TemplateBox[{"\[Psi]"},
      "Ket"], "->", 
     RowBox[{"MatrixForm", "[", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}]}], ",", "\"\<  \>\"",
     ",", 
    RowBox[{Cell[TextData[Cell[BoxData[
      TemplateBox[{"\[Psi]"},
       "Bra"]],ExpressionUUID->"32bea20d-61b2-471a-a2e7-a48c639098f5"]],
      ExpressionUUID->"8e39987f-de24-415e-87e1-1a0060c8c190"], "->", 
     RowBox[{"MatrixForm", "[", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         SuperscriptBox["\[Alpha]", "*"], ",", 
         SuperscriptBox["\[Beta]", "*"]}], "}"}], "}"}], "]"}]}]}], "}"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.969207194505948*^9, 3.969207310231982*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"ca992a5a-b215-43b3-8838-7efeabe5d34b"],

Cell[TextData[{
 "From these definitions, a ket-bra as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"\[Ellipsis]"},
     "Ket"], 
    TemplateBox[{"\[Ellipsis]"},
     "Bra"]}], TraditionalForm]],ExpressionUUID->
  "4e3d184d-0db8-4e61-bce6-8b99a2a0da14"],
 " represents a matrix:"
}], "Text",
 CellChangeTimes->{{3.969207406498747*^9, 3.969207442205429*^9}, {
  3.96920765518563*^9, 3.9692076799330263`*^9}, {3.96920828569678*^9, 
  3.969208289348905*^9}},ExpressionUUID->"1908c700-fb83-4f59-9d81-\
32005805a5ec"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{"a", ",", "b", ",", "\[Alpha]", ",", "\[Beta]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\"\<\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\>\"", "->", 
     RowBox[{"MatrixForm", "[", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], "]"}]}], ",", "\"\<  \>\"", ",", 
    RowBox[{"\"\<\!\(\*TemplateBox[{\"\[Phi]\"},\"Ket\"]\)\>\"", "->", 
     RowBox[{"MatrixForm", "[", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}]}], 
    ",", "\"\< => \>\"", ",", 
    RowBox[{"\"\<\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\!\(\*TemplateBox[{\
\"\[Phi]\"},\"Bra\"]\)\>\"", "->", 
     RowBox[{"MatrixForm", "[", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          SuperscriptBox["\[Alpha]", "*"], ",", 
          SuperscriptBox["\[Beta]", "*"]}], "}"}]}], "]"}], "]"}]}]}], "}"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.969207378207634*^9, 3.969207388221539*^9}, {
  3.969207452979024*^9, 3.969207591378083*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"11373d8f-b333-4034-bac7-bb750e96c77c"],

Cell["Show the matrix form and also Dirac notation of NOT gate:", "Text",
 CellChangeTimes->{{3.9692076907989492`*^9, 
  3.969207700633704*^9}},ExpressionUUID->"0ed8ba64-f6ff-4ce0-bb80-\
62f12bc59a1d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MatrixForm", "[", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", "\"\<NOT\>\"", "]"}], 
    "[", "\"\<Matrix\>\"", "]"}], "]"}], "->", 
  RowBox[{"TraditionalForm", "[", 
   RowBox[{"QuantumOperator", "[", "\"\<NOT\>\"", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9683214348751163`*^9, 3.968321438023473*^9}, {
  3.968369046300867*^9, 3.9683690482500553`*^9}, {3.969207633871855*^9, 
  3.969207647035267*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"c05fe108-887e-43da-b8ee-58a407c5dfd5"],

Cell[TextData[{
 "Show the elements in the Dirac notation of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "Y"], TraditionalForm]],ExpressionUUID->
  "79a72615-4cb3-4b04-b1ea-676f3e6a3fa8"],
 " rotation with the angle ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[Pi]", "3"], TraditionalForm]],ExpressionUUID->
  "1a53388f-7bf4-4cd0-8580-5c056adbc748"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9692077060915537`*^9, 
  3.969207727867331*^9}},ExpressionUUID->"ffc2742c-bc72-4588-88b9-\
a00835f7bece"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumOperator", "[", 
   RowBox[{"\"\<RY\>\"", "[", 
    RowBox[{"\[Pi]", "/", "3"}], "]"}], "]"}], "[", "\"\<Table\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{3.968321441177882*^9, 3.968321442267581*^9}, {
  3.968369051576581*^9, 3.968369056617805*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"6f95ad95-9cfd-4e12-9ab7-c8bfb12610dc"],

Cell["Show the Dirac notation of controlled-Hadamard gate:", "Text",
 CellChangeTimes->{{3.9692077385111837`*^9, 
  3.9692077535773373`*^9}},ExpressionUUID->"154d3004-b7cd-4677-a18f-\
a95cb3cbfa0e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumOperator", "[", "\"\<CH\>\"", "]"}], "//", 
  "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.9442230038088093`*^9, 3.9442230130551205`*^9}, {
  3.968321413505206*^9, 3.968321415576756*^9}, {3.968369064701477*^9, 
  3.968369071815526*^9}, {3.9692108882576838`*^9, 3.969210891532836*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"75433663-3b40-4240-8158-9dc822a2e4a6"],

Cell["\<\
Show the matrix of controlled-Hadamard gate in the computational basis:\
\>", "Text",
 CellChangeTimes->{{3.969210912053134*^9, 
  3.969210925074291*^9}},ExpressionUUID->"3d7a5d57-9f51-4963-a23d-\
11ca67243d05"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", "\"\<CH\>\"", "]"}], "[", "\"\<Matrix\>\"",
    "]"}], "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.96921085104212*^9, 3.969210855129499*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"ac0c2948-7421-4a6a-b918-a77ed8fe8d4f"],

Cell[TextData[{
 "In summary, the ket notation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"\[Ellipsis]"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "95575676-3e95-45a8-8c8c-ef1df65f0df8"],
 " represents a complex-valued vector, and the bra notation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"\[Ellipsis]"},
    "Bra"], TraditionalForm]],ExpressionUUID->
  "8e7ccc14-6182-4200-b1de-f5dce05b88f0"],
 " can be understood as the conjugate transpose of a ket. When we have a \
composite state such as ",
 Cell[BoxData[
  TemplateBox[{"00"},
   "Ket"]],ExpressionUUID->"0b24fa0f-8a44-45c2-aadb-ae5ad5b8fc61"],
 ", it is shorthand for the tensor product ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0"},
    "Ket"], "\[CircleTimes]", 
   TemplateBox[{"0"},
    "Ket"]}]],ExpressionUUID->"0bf4416f-0c97-4660-86de-75a93bdc6bb1"],
 ". We will discuss these details further in future chapters"
}], "Text",
 CellChangeTimes->{{3.9683690788424473`*^9, 3.9683691746492567`*^9}, {
   3.968369213267118*^9, 3.968369330815715*^9}, {3.969207768894059*^9, 
   3.969207771142357*^9}, 
   3.96921908201289*^9},ExpressionUUID->"23b11c64-f0d0-4972-ad0b-\
30ba8c1cee7c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["State Vectors, Amplitudes and Density Matrices", "Section",
 CellChangeTimes->{{3.9443023420134583`*^9, 3.944302345372238*^9}, {
  3.944302453293232*^9, 3.9443024588115406`*^9}, {3.973006238550194*^9, 
  3.973006246649355*^9}},ExpressionUUID->"a8641a37-4981-48e6-a77b-\
3eab8bb2966c"],

Cell[TextData[{
 "You have already seen bra-ket notation for quantum states like ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]],ExpressionUUID->"0d8c5861-31e3-42fe-a5c3-4fd755f598a1"],
 " or ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]],ExpressionUUID->"5c66b91a-b0cf-47f3-a663-e7ddb9ed54c7"],
 ". As discussed, the Dirac ket notation is in fact a shorthand \
representation of a vector, which is usually called state vector. Keep in \
mind: vectors, matrices, and tensors are always expressed in a chosen basis, \
by default, the computational basis. Unless noted otherwise, single systems \
are qubits, described in the complex two-dimensional vector space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalC]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b88c712a-1931-4d4b-93be-5edb56eb2b87"],
 "."
}], "Text",
 CellChangeTimes->{{3.9443024301080933`*^9, 3.9443025253968678`*^9}, {
   3.944302593038843*^9, 3.9443026136295433`*^9}, 3.9443254350235844`*^9, {
   3.968335158388571*^9, 3.968335207832213*^9}, 3.968349557478278*^9, {
   3.9695463192051277`*^9, 3.9695464308758698`*^9}, {3.9695464717676363`*^9, 
   3.969546490322605*^9}},ExpressionUUID->"94387375-117a-47a2-9df5-\
e6e94528c135"],

Cell[TextData[{
 "Show the state vector of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"0"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "875daa4f-4a2b-49f4-a87f-7cb9cb7c67ec"],
 ":"
}], "Text",
 CellChangeTimes->{{3.968335240167317*^9, 3.9683352495498247`*^9}, {
   3.969190000276224*^9, 3.9691900017749577`*^9}, 
   3.969546536192051*^9},ExpressionUUID->"2e947a68-540c-46c4-acea-\
0bc95df7992b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], "[", "\"\<StateVector\>\"",
    "]"}], "//", "Normal"}]], "Input",
 CellChangeTimes->{{3.9683352086563*^9, 3.9683352207031717`*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"d6c6e212-a4e2-45b3-928d-7c18c9b4b861"],

Cell[TextData[{
 "Show the state vector of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"1"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2c0913f0-e3c5-482f-96d1-a263af212f2a"],
 ":"
}], "Text",
 CellChangeTimes->{{3.968335240167317*^9, 3.96833525360917*^9}, {
  3.969190002922619*^9, 3.969190004349407*^9}, {3.969546533087263*^9, 
  3.969546534354319*^9}},ExpressionUUID->"23132ef0-a00e-4325-928e-\
64826bb40c8a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}], "[", "\"\<StateVector\>\"",
    "]"}], "//", "Normal"}]], "Input",
 CellChangeTimes->{{3.9683352338422117`*^9, 3.968335233996786*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"8ec50efb-5a54-473a-9e9b-024318387dc6"],

Cell[TextData[{
 "Show the state vector of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"0"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "308f385b-8a4c-4bfc-bb99-cffab05425c9"],
 " for a 3D system:"
}], "Text",
 CellChangeTimes->{{3.969546507274766*^9, 
  3.9695465225518103`*^9}},ExpressionUUID->"b504514d-aeb8-4a4a-9e6d-\
de4226cb682f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<0\>\"", ",", "3"}], "]"}], "[", "\"\<StateVector\>\"", "]"}],
   "//", "Normal"}]], "Input",
 CellChangeTimes->{{3.969546525459153*^9, 3.969546525821452*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"0ee8005c-6d08-4c2f-bf81-17f7a196c7bf"],

Cell["\<\
Now consider the result of applying a Hadamard gate to the register state of \
a qubit:\
\>", "Text",
 CellChangeTimes->{{3.9443024301080933`*^9, 3.9443025253968678`*^9}, {
   3.944302593038843*^9, 3.9443026136295433`*^9}, 3.9443254350235844`*^9, {
   3.9683352787357607`*^9, 3.9683352825033693`*^9}, {3.9695465431351843`*^9, 
   3.969546545371689*^9}},ExpressionUUID->"29d58548-ca3c-4d11-af22-\
2c524caccb50"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"QuantumOperator", "[", "\"\<H\>\"", "]"}], "[", "]"}], 
   "[", "\"\<StateVector\>\"", "]"}], "//", "Normal"}]], "Input",
 CellChangeTimes->{{3.944302618096527*^9, 3.9443026479081936`*^9}, {
  3.968335289295257*^9, 3.968335289351121*^9}, {3.969146416567813*^9, 
  3.969146418992568*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"25e714a2-d74d-43e4-b127-bf1e72534960"],

Cell["\<\
If the initial state isn\[CloseCurlyQuote]t specified, Wolfram\
\[CloseCurlyQuote]s Quantum framework initializes the n-qubit register to the \
all-zeros state.\
\>", "Text",
 CellChangeTimes->{{3.969219229572303*^9, 
  3.969219278075595*^9}},ExpressionUUID->"a1576bfd-1bb0-4f7a-92ec-\
1495c521add7"],

Cell[TextData[{
 "Given the vector definitions for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"0"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a95b54f4-6e4d-463a-93ef-e32b163bdb08"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"1"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7051c444-78e0-4195-8fd6-f2c2ed890dad"],
 ", the above vector can be rewritten as:"
}], "Text",
 CellChangeTimes->{{3.9683353770773897`*^9, 3.968335401727746*^9}, {
  3.9695465549578657`*^9, 
  3.969546558090579*^9}},ExpressionUUID->"4ee2f958-4cbb-448c-8809-\
1458bd4d4a5b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", "\"\<H\>\"", "]"}], "[", "]"}], 
  "[", "\"\<Formula\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.9443029364129543`*^9, 3.9443029751090946`*^9}, 
   3.9691464333033457`*^9},
 CellLabel->"In[46]:=",ExpressionUUID->"34f94da1-63ec-4b29-a228-a2483f2c00d3"],

Cell[TextData[{
 "In the representation above, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"0"},
     "Ket"], "->", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0"}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "93bb4b37-bae7-467b-b7c9-1638b66fc3d4"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"1"},
     "Ket"], "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "9c40f5cd-f480-4c75-aa52-ee8637373f01"],
 " serve as the basis of the complex vector space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    TemplateBox[{},
     "Complexes"], "2"], TraditionalForm]],ExpressionUUID->
  "b2d66ee5-34e9-489b-b824-21f10fd16398"],
 ", and each term in the linear combination (the familiar quantum \
superposition) is the corresponding coefficient in that basis. For a single \
qubit, we write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"\[Psi]"},
     "Ket"], "=", 
    RowBox[{
     RowBox[{"\[Alpha]", 
      TemplateBox[{"0"},
       "Ket"]}], "+", 
     RowBox[{"\[Beta]", 
      TemplateBox[{"1"},
       "Ket"]}]}]}], TraditionalForm]],ExpressionUUID->
  "a2ab4e69-e435-4026-8b5a-9c9defe36731"],
 ", where \[Alpha] and \[Beta] are complex amplitudes."
}], "Text",
 CellChangeTimes->{{3.9683355549709253`*^9, 3.9683356401375723`*^9}, {
  3.968335739232832*^9, 3.968335879086423*^9}, {3.96833592211493*^9, 
  3.9683359224670773`*^9}, {3.9691464487268353`*^9, 
  3.96914646835847*^9}},ExpressionUUID->"78abac7d-23a8-43c6-b8de-\
159376818f9f"],

Cell[TextData[{
 "The coefficients of each basis element are known as the ",
 StyleBox["quantum amplitudes",
  FontWeight->"Bold"],
 ". A quantum state can be defined by giving its amplitudes:"
}], "Text",
 CellChangeTimes->{{3.944303483676037*^9, 3.9443034924516735`*^9}, {
  3.9443037272183228`*^9, 3.9443037420282383`*^9}, {3.9443038412674026`*^9, 
  3.9443038533794327`*^9}},ExpressionUUID->"56bfd07b-0b54-48ee-a0bc-\
8d7907c24c25"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}], 
  "[", "\"\<Amplitudes\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.944303825766159*^9, 3.944303836236042*^9}, {
  3.968335984961833*^9, 3.968335988463498*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"6c20485f-caa4-4d4d-97c1-967718416fb2"],

Cell["The above state can be written in Dirac notation:", "Text",
 CellChangeTimes->{{3.9443038715003204`*^9, 3.9443038831480103`*^9}, {
  3.969546602702723*^9, 
  3.969546608247999*^9}},ExpressionUUID->"eecff010-e7dd-4177-80e5-\
47a477cec311"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}], "//", 
  "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.944303885581053*^9, 3.9443038969140263`*^9}, 
   3.968336001201817*^9},
 CellLabel->"In[48]:=",ExpressionUUID->"83cbd73b-0774-4ab1-ae41-80abb53c90b4"],

Cell["\<\
Notice the relationship between the vector coefficients and the probabilities \
according to the Born\[CloseCurlyQuote]s rule:\
\>", "Text",
 CellChangeTimes->{{3.944303181835659*^9, 3.944303202995468*^9}, {
  3.968335910634716*^9, 
  3.9683359189366817`*^9}},ExpressionUUID->"011f97ac-763e-452e-8e7b-\
4384a914642e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}], 
  "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.944303206656555*^9, 3.9443032125008545`*^9}, {
  3.968335926244134*^9, 3.9683359321212263`*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"c6018721-f0a4-437e-9df3-18c0eba21852"],

Cell["\<\
Probabilities are also basis-dependent; unless specified otherwise, they are \
computed in the computational basis. For example, transform the same state \
into Pauli-Y basis and calculate the probabilities:\
\>", "Text",
 CellChangeTimes->{{3.9695466205419617`*^9, 3.969546691131958*^9}, {
  3.96954672428277*^9, 
  3.969546755900517*^9}},ExpressionUUID->"f1a38085-b52a-4fdf-9f9b-\
5c3d2c62b384"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}], ",", "\"\<Y\>\""}], 
   "]"}], "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.9695466976068974`*^9, 3.969546719982524*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"45c9fd25-8bae-4006-9772-ff21adf2721f"],

Cell["We will discuss the basis transformation later.", "Text",
 CellChangeTimes->{{3.9695467584967823`*^9, 
  3.969546768410522*^9}},ExpressionUUID->"2ba7e679-bfba-47ff-9814-\
ecadb90586a7"],

Cell["\<\
Calculate probabilities in the computational basis for a quantum state:\
\>", "Text",
 CellChangeTimes->{{3.968337213504939*^9, 3.968337239030253*^9}, {
  3.968337400409906*^9, 3.968337406832714*^9}, {3.969190060616641*^9, 
  3.969190067235787*^9}},ExpressionUUID->"447075d2-6ff6-47fd-9fc9-\
eb5c5b2b9f7f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"\[ImaginaryI]", " ", 
      SqrtBox[
       RowBox[{"3", "/", "4"}]]}]}], "}"}], "]"}], 
  "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.968337241584879*^9, 3.968337335371232*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"d42e395e-f1e4-4092-bc6f-876b4bf37492"],

Cell["\<\
Calculate probabilities in the computational basis for another quantum state:\
\>", "Text",
 CellChangeTimes->{{3.968337213504939*^9, 3.968337239030253*^9}, {
  3.968337400409906*^9, 3.968337406832714*^9}, {3.969146503281966*^9, 
  3.969146503937272*^9}, {3.9691900714608727`*^9, 
  3.969190071974512*^9}},ExpressionUUID->"386da718-84bc-420e-ada2-\
cbd0a27ed35b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     SqrtBox[
      RowBox[{"3", "/", "4"}]]}], "}"}], "]"}], "[", "\"\<Probabilities\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{3.968337241584879*^9, 3.968337335371232*^9}, {
  3.969146497923214*^9, 3.969146508204629*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"070752e3-e6b4-45ed-8b3a-ec0e1fb49439"],

Cell["\<\
Although the state vectors above are different, their computational-basis \
outcome probabilities are identical. This highlights a key point: measurement \
probabilities are basis-dependent. Next, compute the probabilities of these \
two states in the Pauli-X basis.\
\>", "Text",
 CellChangeTimes->{{3.969146506247182*^9, 3.969146568899713*^9}, {
  3.969146611860484*^9, 3.969146630722083*^9}, {3.969146676716981*^9, 
  3.969146678215303*^9}},ExpressionUUID->"c5274d13-758d-4d5b-a7a3-\
d403f195ea2d"],

Cell[BoxData[
 RowBox[{"FullSimplify", "/@", 
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        SqrtBox[
         RowBox[{"3", "/", "4"}]]}], "}"}], "]"}], ",", "\"\<X\>\""}], "]"}], 
   "[", "\"\<Probabilities\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.969146577151578*^9, 3.969146592539*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"324c8252-5b7b-486c-b0ad-35f7b0fc8b43"],

Cell[BoxData[
 RowBox[{"FullSimplify", "/@", 
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"\[ImaginaryI]", 
         SqrtBox[
          RowBox[{"3", "/", "4"}]]}]}], "}"}], "]"}], ",", "\"\<X\>\""}], 
    "]"}], "[", "\"\<Probabilities\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.969146600294614*^9, 3.969146600772964*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"473bc083-b4cc-48a2-8d4f-3e1b5ea0103b"],

Cell["\<\
This is a subtle but important point: measurement probabilities are \
basis-dependent. In the Pauli-X basis, the distinction between the two states \
is clear, because their outcome probabilities differ.\
\>", "Text",
 CellChangeTimes->{{3.969146635598328*^9, 3.969146657790094*^9}, 
   3.9691467000529947`*^9, 
   3.96919011197462*^9},ExpressionUUID->"0003c421-4b85-4f21-9eaf-\
1e0a80a690b6"],

Cell["\<\
Given a state vector, one can calculate probabilities manually too:\
\>", "Text",
 CellChangeTimes->{{3.9683374099309072`*^9, 3.9683374224327183`*^9}, {
  3.969146708900927*^9, 
  3.9691467184902287`*^9}},ExpressionUUID->"f8e5566c-2084-4712-b390-\
5355ebf60f37"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Abs", "[", 
   RowBox[{"Normalize", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"\[ImaginaryI]", " ", 
       SqrtBox[
        RowBox[{"3", "/", "4"}]]}]}], "}"}], "]"}], "]"}], "^", 
  "2"}]], "Input",
 CellChangeTimes->{{3.968337427000656*^9, 3.968337433739461*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"fab4c2f1-eae5-434e-b66c-8ed80cc86244"],

Cell["\<\
For probability calculations, always use a normalized state (or normalize the \
probabilities at the end).\
\>", "Text",
 CellChangeTimes->{{3.968337344118498*^9, 3.968337358035513*^9}, {
   3.969146742996806*^9, 3.969146801350492*^9}, 
   3.969190103746942*^9},ExpressionUUID->"b698f96c-5a57-4e6c-94f8-\
dbbb9cf8db2c"],

Cell[BoxData[
 RowBox[{"Normalize", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"\[ImaginaryI]", " ", 
        SqrtBox[
         RowBox[{"3", "/", "4"}]]}]}], "}"}], "]"}], "^", "2"}], ",", 
   "Total"}], "]"}]], "Input",
 CellChangeTimes->{{3.968337330144043*^9, 3.968337366444853*^9}, {
  3.969146735482678*^9, 3.969146738192721*^9}, {3.969146774878231*^9, 
  3.969146779698862*^9}},
 CellLabel->"In[56]:=",ExpressionUUID->"9c15747a-fd0f-4f8e-8050-f2f71e0cd867"],

Cell["\<\
However, there are situations where describing a qubit by a 2-vector is not \
enough. For example, in the famous Stern\[Dash]Gerlach \
experiment\[LongDash]where a beam of silver atoms is sent through an \
inhomogeneous magnetic gradient\[LongDash]the initial state of the atoms, \
even if approximated by their electron spin only, may be an ensemble rather \
than a single pure state. \
\>", "Text",
 CellChangeTimes->{{3.968336180816654*^9, 3.968336333105896*^9}, {
   3.96833641651585*^9, 3.968336426887816*^9}, 
   3.96919020281304*^9},ExpressionUUID->"f500cd56-1003-4386-9803-\
ec821bf08942"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Graphics3D", "[", 
    RowBox[{
     InterpretationBox[
      DynamicModuleBox[{Typeset`open = False}, 
       TemplateBox[{"List", "ListIcon", 
         GridBox[{{
            RowBox[{
              TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["List", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["3", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Byte count: \"", "IconizedLabel"], 
              "\[InvisibleSpace]", 
              TagBox["15504", "IconizedItem"]}]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
          "Column", 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
         Dynamic[Typeset`open]},
        "IconizedObject"]],
      {
       GeometricTransformation[{Yellow, 
         Point[
          RandomSample[
           
           Table[{$CellContext`x, 1.1, (1/8) Exp[-(2.5 $CellContext`x)^2] - 
             0.75}, {$CellContext`x, -0.3, 0.3, 0.01}], 
           IntegerPart[60 $CellContext`t]]], 
         Point[
          RandomSample[
           
           Table[{$CellContext`x, 1.1, (-(1/8)) Exp[-(2.5 $CellContext`x)^2] - 
             0.75}, {$CellContext`x, -0.3, 0.3, 0.01}], 
           IntegerPart[60 $CellContext`t]]], 
         Polygon[{{-0.5, 0, 0}, {-0.5, 0, 1}, {0.5, 0, 1}, {0.5, 0., 0.}, {
           0, 0, -0.5}}], 
         Polygon[{{-0.5, -3, 0}, {-0.5, -3, 1}, {0.5, -3, 1}, {0.5, -3, 0.}, {
           0, -3, -0.5}}], 
         Polygon[{{-0.5, 0, 0}, {-0.5, 0, 1}, {-0.5, -3, 1}, {-0.5, -3, 0.}}], 
         Polygon[{{0.5, 0, 0}, {0.5, 0, 1}, {0.5, -3, 1}, {0.5, -3, 0.}}], 
         Polygon[{{0.5, 0, 1}, {0.5, -3, 1}, {-0.5, -3, 1}, {-0.5, 0, 1}}], 
         Polygon[{{0.5, 0, 0}, {0.5, -3, 0}, {0, -3, -0.5}, {0, 0, -0.5}}], 
         Polygon[{{-0.5, 0, 0}, {-0.5, -3, 0}, {0, -3, -0.5}, {0, 0, -0.5}}], 
         Cuboid[{-0.5, 0, -1}, {0.5, -3, -2}], Red, 
         PointSize[0.01], 
         Point[
          Transpose[{
            RandomReal[{-0.1, 0.1}, 20], 
            RandomReal[{-4.5, 0}, 20], 
            RandomReal[{-0.7, -0.8}, 20]}]], 
         Point[
          Transpose[
           ({
            RandomReal[{-0.2, 0.2}, 5], #, #/5 - 0.75}& )[
            RandomReal[{0, 1}, 5]]]], 
         Point[
          Transpose[
           ({
            RandomReal[{-0.1, 0.1}, 5], #, -(#/5) - 0.75}& )[
            RandomReal[{0, 1}, 5]]]], LightGray, 
         Thickness[0.02], 
         Line[{{0, -4.5, -0.75}, {0, 0, -0.75}}], 
         Line[{{0, 1, -0.6}, {0, 0, -0.75}}], 
         Line[{{0, 1, -0.9}, {0, 0, -0.75}}], Orange, 
         Cylinder[{{0, -4.5, -0.75}, {0, -5, -0.75}}, 0.2], 
         Opacity[0.5]}, 
        RotationTransform[$CellContext`\[Theta], {0, -5, -0.75} - {
         0, -4.5, -0.75}, {0, -4.5, -0.75}]], {
        Opacity[0.4], Blue, 
        Polygon[{{-1, 1.1, -1.75}, {-1, 1.1, 0.25}, {1, 1.1, 0.25}, {
          1, 1.1, -1.75}}], Green, 
        Polygon[{{-1, -3.5, -0.6}, {-1, -3.5, 0.25}, {1, -3.5, 0.25}, {
          1, -3.5, -0.6}}], 
        Polygon[{{-1, -4, -1.75}, {-1, -4, -0.9}, {1, -4, -0.9}, {
          1, -4, -1.75}}], 
        Polygon[{{-1, -3.5, -1.75}, {-1, -3.5, -0.9}, {1, -3.5, -0.9}, {
          1, -3.5, -1.75}}], 
        Polygon[{{-1, -4, -0.6}, {-1, -4, 0.25}, {1, -4, 0.25}, {
          1, -4, -0.6}}]}, {
        Text["Source", {0, -5, 0}], 
        Text["Collimators", {0, -4, 1}], 
        Text["Detector", {0, 1, 1}], 
        Text["External magnetic field", {0, -2, 2}]}},
      SelectWithContents->True,
      Selectable->False], ",", 
     RowBox[{"Boxed", "\[Rule]", "False"}], ",", 
     RowBox[{"ViewPoint", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", 
        RowBox[{"-", "1.5"}], ",", "1"}], "}"}]}], ",", " ", "\n", "  ", 
     RowBox[{"ImageSize", "\[Rule]", "300"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", ".35", ",", "\"\<Number of particles\>\""}], "}"}], ",",
      "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Theta]", ",", "0", ",", "\"\<Angle of external field gradient\>\""}],
       "}"}], ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}]], "Input",
 TaggingRules->{},
