 CellChangeTimes->{{3.968502087825808*^9, 3.968502090248536*^9}},
 CellLabel->
  "In[267]:=",ExpressionUUID->"ff93f71d-2557-480a-ac65-db2bcfd473ac"],

Cell["\<\
Apply CNOT gate on the state and check if it is entangled or not:\
\>", "Text",
 CellChangeTimes->{{3.968752875633503*^9, 
  3.968752892298188*^9}},ExpressionUUID->"394ee85b-bf9d-4fe0-b940-\
abefadbca491"],

