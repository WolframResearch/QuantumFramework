Cell[CellGroupData[{

Cell["Deutsch-Jozsa Algorithm", "Chapter",
 CellChangeTimes->{{3.944662887397749*^9, 3.944662891885006*^9}, 
   3.9446629743009224`*^9, 3.968337128953205*^9, {3.9683495172391033`*^9, 
   3.968349528261919*^9}, {3.968349689865692*^9, 3.968349690463126*^9}, {
   3.9690219385024147`*^9, 
   3.969021949423478*^9}},ExpressionUUID->"c8a7e564-ce75-4412-93b4-\
73c769fb6494"],

Cell["\<\
We will discuss the Deutsch-Jozsa algorithm. It decides whether a promised \
function on n-bit inputs is constant or balanced using a single oracle call. \
The Deutsch-Jozsa circuit is designed in a way that if the function is \
constant, all amplitude concentrates on the all-zeros output; if balanced, \
that outcome vanishes and some nonzero string appears. A bit-flip oracle and \
a phase oracle are equivalent here because initializing the target in the \
minus state turns the bit flip into an input-dependent phase.\
\>", "Text",
 CellChangeTimes->{{3.9683351418507547`*^9, 3.968335145248692*^9}, {
  3.968337132871228*^9, 3.968337135575295*^9}, {3.968349674120285*^9, 
  3.9683496759193697`*^9}, {3.969025777171067*^9, 
  3.9690258443622723`*^9}},ExpressionUUID->"2933a4ff-38ad-43af-991e-\
4ad1e0e8aacd"],

Cell[CellGroupData[{

Cell["Key Concepts", "Section",
 CellChangeTimes->{{3.9442479373933716`*^9, 
  3.944247939017521*^9}},ExpressionUUID->"0a19c311-b63d-4061-8770-\
c723fbc2c61c"],

Cell["Boolean function", "Item",
 CellChangeTimes->{{3.944247943963133*^9, 3.9442479547025547`*^9}, 
   3.968349671754785*^9, {3.969025683529069*^9, 
   3.969025685675763*^9}},ExpressionUUID->"67e31526-fcd7-4563-ae8b-\
b7d34f600179"],

Cell["Constant Boolean function", "Item",
 CellChangeTimes->{{3.944247943963133*^9, 3.944247958262329*^9}, 
   3.968349677939341*^9, {3.969025688837101*^9, 
   3.969025696110753*^9}},ExpressionUUID->"570fb8b8-87d4-453d-a08e-\
71e61766ff97"],

Cell["Balanced Boolean function", "Item",
 CellChangeTimes->{{3.944247943963133*^9, 3.944247958262329*^9}, 
   3.968349677939341*^9, {3.969025688837101*^9, 
   3.969025700813636*^9}},ExpressionUUID->"86b04463-c4be-4a1d-810a-\
daaf0d05c7eb"],

Cell["Deutsch-Jozsa", "Item",
 CellChangeTimes->{{3.944247943963133*^9, 3.944247960345806*^9}, 
   3.9683496791701117`*^9, {3.9690256868207417`*^9, 
   3.969025686992097*^9}},ExpressionUUID->"8e95c027-b49d-437d-ba55-\
5555b10fbc3f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Statement of the Deutsch-Jozsa Problem", "Section",
 CellChangeTimes->{{3.9683496865121317`*^9, 3.968349687336903*^9}, {
   3.9688644190640783`*^9, 3.968864424207428*^9}, 
   3.969021953573022*^9},ExpressionUUID->"47563814-29c1-4bc4-9c54-\
c2c39dbbbf4a"],

Cell["Define the deterministic classical Deutsch-Jozsa algorithm:", \
"Text",
 CellChangeTimes->{{3.9690188132876263`*^9, 3.969018825148118*^9}, {
  3.969018871024744*^9, 3.969018873550907*^9}},
 CellID->199828093,ExpressionUUID->"56f56e75-ded2-454c-b55f-2ac4b4694979"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "classicalDJ", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"classicalDJ", "[", 
   RowBox[{"boo_", ",", "allX_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"decision", "=", "False"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Xor", "@@", 
           RowBox[{"allX", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "!=", 
          RowBox[{"Xor", "@@", 
           RowBox[{"allX", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"decision", "=", "True"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<After \>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}], 
             "<>", "\"\< queries, it is determined that the function is \
balanced\>\""}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<The result of \>\"", "<>", 
           RowBox[{"IntegerName", "[", 
            RowBox[{"i", ",", "\"\<Ordinal\>\""}], "]"}], 
           "<>", "\"\< query is the same as previous one, so still cannot \
determined if the function is balanced or constant.\>\""}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", 
         RowBox[{
          RowBox[{"Length", "[", "allX", "]"}], "/", "2"}]}], "}"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "allX", "]"}], "/", "2"}], "+", "1"}]}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", "decision"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Xor", "@@", 
             RowBox[{"allX", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "==", 
            RowBox[{"Xor", "@@", 
             RowBox[{"allX", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], ",", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<After \>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}], 
             "<>", "\"\< queries, it is determined that the function is \
constant\>\""}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<After \>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}], 
             "<>", "\"\< queries, it is determined that the function is \
balanced\>\""}], "]"}]}], "]"}]}], "]"}]}], "]"}]}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.969014796679982*^9, 3.969014911101803*^9}, {
  3.96901494449472*^9, 3.969015020444878*^9}, {3.969015056266469*^9, 
  3.969015110610084*^9}, {3.96901515173831*^9, 3.96901538900664*^9}, {
  3.969015432044929*^9, 3.9690156350852747`*^9}, {3.969015691422822*^9, 
  3.969015695543*^9}, {3.969015735138949*^9, 3.969015743991377*^9}, {
  3.96901581770953*^9, 3.969015820579103*^9}, {3.9690158757005043`*^9, 
  3.969016103496934*^9}, {3.969303401799502*^9, 3.9693034137488947`*^9}, {
  3.969303478955949*^9, 3.969303489500472*^9}, {3.9693035705566263`*^9, 
  3.969303577406439*^9}},
 CellLabel->"In[340]:=",
 CellID->1993818790,ExpressionUUID->"a700ecb2-655b-4aa8-833c-5e746c009b4a"],

Cell[TextData[{
 "You\[CloseCurlyQuote]re given ",
 StyleBox["black-box access",
  FontSlant->"Italic"],
 " to a Boolean function, ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "4874badb-f475-4600-bd7d-34236e8ec658"],
 ", with the promise that ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "79f2e9f6-d02b-4c27-88b5-01cb7ff4d8ea"],
 " is either constant, i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "a2205f93-76b4-4f0a-8feb-8077a536bd8a"],
 " is the same for every ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "9755d701-5078-421d-8af0-1ef3e1aa29a1"],
 " (either all 0s or all 1s), or balanced, i.e, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", "x", ")"}]}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "6026b4b7-d15b-471b-8e3d-e6ed833c63e1"],
 " for exactly half of all inputs and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", "x", ")"}]}], "=", "1"}], TraditionalForm]],ExpressionUUID->
  "26282d4c-f9a0-413c-91ed-d88c46b3d2d4"],
 " for the other half."
}], "Text",
 CellChangeTimes->{{3.96886454554275*^9, 3.9688646164100237`*^9}, {
  3.969012197501815*^9, 3.9690123341760406`*^9}, {3.969012695487042*^9, 
  3.969012726386405*^9}, {3.969279894098271*^9, 
  3.969279900297936*^9}},ExpressionUUID->"3480c0eb-b21c-41a9-a25d-\
e31250b1bedf"],

Cell["\<\
Let\[CloseCurlyQuote]s consider Xor in 3 variables, as a specific case, which \
is a balanced function. Keep in mind that you have a black-box access to it, \
and being told that it is either constant or balanced.\
\>", "Text",
 CellChangeTimes->{{3.96886454554275*^9, 3.9688646164100237`*^9}, {
  3.969012197501815*^9, 3.969012207777109*^9}, {3.969014514228786*^9, 
  3.969014587426367*^9}, {3.969279911165935*^9, 
  3.9692799195453663`*^9}},ExpressionUUID->"4c0e3c32-7a81-4126-a825-\
f7cbbf726232"],

Cell["\<\
Count the number of False and True outputs over all 8 inputs for the 3-bit \
XOR (parity) function:\
\>", "Text",
 CellChangeTimes->{{3.969279925241963*^9, 
  3.969279966748309*^9}},ExpressionUUID->"2253516b-707d-407e-b463-\
521ebe75d3ee"],

Cell[BoxData[
 RowBox[{"Counts", "@", 
  RowBox[{"BooleanTable", "[", 
   RowBox[{
    RowBox[{"Xor", "[", 
     RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.968864465830268*^9, 3.968864467191184*^9}, {
   3.968864519051086*^9, 3.968864525017168*^9}, 3.968864613663006*^9, {
   3.969014461013886*^9, 3.969014467282442*^9}, 3.969014526912697*^9, {
   3.969015209136219*^9, 3.9690152109457893`*^9}},
 CellLabel->
  "In[315]:=",ExpressionUUID->"20b53b4d-4229-485f-83db-7497b85ec542"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s adopt a deterministic (always correct) classical \
algorithm. You query inputs one by one, observing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "f782bf69-5687-45c0-8a7f-2bb4068353e2"],
 ". If you ever see both outputs 0 and 1, you can confidently say \
\[OpenCurlyDoubleQuote]balanced.\[CloseCurlyDoubleQuote] If all outputs seen \
so far are identical, you still don\[CloseCurlyQuote]t know: the function \
might be truly constant, or it might be balanced but you\[CloseCurlyQuote]ve \
only hit inputs from the \[OpenCurlyDoubleQuote]same half\
\[CloseCurlyDoubleQuote] so far. Therefore, any deterministic classical \
algorithm that is always correct needs, in the worst case, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["2", 
     RowBox[{"n", "-", "1"}]], "+", "1"}], TraditionalForm]],ExpressionUUID->
  "43b88244-ab2b-4799-b591-7cd71191c2f7"],
 " queries (that\[CloseCurlyQuote]s exponential in ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "c0a2a498-e23f-45ec-b1f3-3cb4fb3045d9"],
 ".)"
}], "Text",
 CellChangeTimes->{{3.969014607553967*^9, 3.9690146474176893`*^9}, {
  3.9690184057728987`*^9, 3.9690184105384617`*^9}, {3.969018445676188*^9, 
  3.969018471023086*^9}},ExpressionUUID->"22de3cf1-ab9f-4484-a703-\
4ff477767472"],

Cell[TextData[{
 "Consider Xor in 3 variables as a specific example (",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "3"}], TraditionalForm]],ExpressionUUID->
  "7c845152-52bc-4b1d-a9fc-a53416c4710b"],
 "). An adversary can keep you uncertain for a long time. For example, the \
inputs order can be like this:"
}], "Text",
 CellChangeTimes->{{3.9690184811114073`*^9, 3.969018501275964*^9}, {
  3.969018548177537*^9, 
  3.969018585930891*^9}},ExpressionUUID->"3273ef52-8275-44f5-8c93-\
bf5092221d0c"],

Cell[BoxData[
 RowBox[{"allInputs", "=", 
  RowBox[{"SortBy", "[", 
   RowBox[{
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"True", ",", "False"}], "}"}], ",", "3"}], "]"}], ",", 
    RowBox[{"Apply", "[", "Xor", "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.969015373544598*^9, 3.969015401330686*^9}, 
   3.9690185702020397`*^9, {3.969018604277042*^9, 3.969018607221106*^9}},
 CellLabel->
  "In[316]:=",ExpressionUUID->"05cb9983-1e33-4c42-a46a-db694f04abe1"],

Cell[TextData[{
 "The outcome of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "c015be6b-cde1-4f66-a1b0-6911b0ed6500"],
 " queries on the list of inputs:"
}], "Text",
 CellChangeTimes->{{3.9690186794907227`*^9, 
  3.96901869235559*^9}},ExpressionUUID->"26b7fba2-347c-4dea-a83b-\
489b5c2d0306"],

Cell[BoxData[
 RowBox[{"Xor", "@@@", "allInputs"}]], "Input",
 CellChangeTimes->{{3.9690186558063993`*^9, 3.96901865698387*^9}},
 CellLabel->
  "In[317]:=",ExpressionUUID->"56026389-cb5c-49ae-a67f-f08cd89763dd"],

Cell["\<\
Up to the fourth query, all outcomes are identical, so you cannot decide yet. \
The fifth query produces a different outcome, confirming the function is \
balanced. Let\[CloseCurlyQuote]s walk through the procedure step by step.\
\>", "Text",
 CellChangeTimes->{{3.9690186955955*^9, 3.969018757039027*^9}, {
  3.969018793681036*^9, 
  3.9690187946701517`*^9}},ExpressionUUID->"ab1f3c9c-1721-4ae0-8f5e-\
3d6bc38d52cd"],

Cell[BoxData[
 RowBox[{"classicalDJ", "[", 
  RowBox[{"Xor", ",", "allInputs"}], "]"}]], "Input",
 CellChangeTimes->{{3.969014796679982*^9, 3.969014911101803*^9}, {
  3.96901494449472*^9, 3.969015020444878*^9}, {3.969015056266469*^9, 
  3.969015110610084*^9}, {3.96901515173831*^9, 3.96901538900664*^9}, {
  3.969015432044929*^9, 3.9690156350852747`*^9}, {3.969015691422822*^9, 
  3.969015695543*^9}, {3.969015735138949*^9, 3.969015743991377*^9}, {
  3.96901581770953*^9, 3.969015820579103*^9}, {3.9690158757005043`*^9, 
  3.969016099233881*^9}, {3.969018612349147*^9, 3.969018618640196*^9}},
 CellLabel->
  "In[318]:=",ExpressionUUID->"29842d95-c828-43c6-aa07-1c4f54096eae"],

Cell["\<\
Now consider a different input ordering, for example, swap the 3rd and 5th \
entries from the previous list.\
\>", "Text",
 CellChangeTimes->{{3.969018917140065*^9, 3.969018918390914*^9}, {
  3.9690191802292213`*^9, 3.9690192128194304`*^9}, {3.9692800631045227`*^9, 
  3.96928008413828*^9}},ExpressionUUID->"f3e6b830-711a-4281-8b97-\
3f3e749f5be3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"allInputs", "[", 
      RowBox[{"[", "3", "]"}], "]"}], ",", 
     RowBox[{"allInputs", "[", 
      RowBox[{"[", "5", "]"}], "]"}]}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"allInputs", "[", 
      RowBox[{"[", "5", "]"}], "]"}], ",", 
     RowBox[{"allInputs", "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Xor", "@@@", "allInputs"}]}], "Input",
 CellChangeTimes->{{3.969019148673217*^9, 3.96901917737388*^9}, 
   3.9690192171247387`*^9},
 CellLabel->
  "In[319]:=",ExpressionUUID->"4d420970-39b4-40d1-bb7a-957e00643185"],

Cell["\<\
This time, after the third query, you can conclude the function is balanced. \
Let\[CloseCurlyQuote]s walk through the steps.\
\>", "Text",
 CellChangeTimes->{{3.96901922642983*^9, 3.969019257447096*^9}, {
  3.9690193553533363`*^9, 
  3.9690193614456778`*^9}},ExpressionUUID->"3d1fc651-8f8f-4da4-b967-\
960eb22f360e"],

Cell[BoxData[
 RowBox[{"classicalDJ", "[", 
  RowBox[{"Xor", ",", "allInputs"}], "]"}]], "Input",
 CellLabel->
  "In[321]:=",ExpressionUUID->"9be77fc9-627f-442d-818d-f991fb001488"]
}, Closed]],

Cell[CellGroupData[{

Cell["Deutsch-Jozsa Oracles", "Section",
 CellChangeTimes->{{3.969019387715212*^9, 3.969019392353657*^9}, 
   3.9690219612790213`*^9, {3.96902316868758*^9, 3.969023172150825*^9}, 
   3.9699770942983303`*^9},ExpressionUUID->"bc85f879-bc6d-48be-a090-\
7ded3b2427e3"],

Cell["\<\
Consider the following balanced Boolean function on three input bits:\
\>", "Text",
 CellChangeTimes->{{3.969020202090987*^9, 3.969020220217107*^9}, {
  3.969020251775257*^9, 3.969020258250865*^9}, {3.96902030875401*^9, 
  3.969020309771755*^9}},
 CellID->1381859717,ExpressionUUID->"25b79ca9-1fcd-4192-bace-87ae020cd8b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"boo", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x", "&&", 
      RowBox[{"!", "y"}]}], ")"}], "||", 
    RowBox[{"(", 
     RowBox[{"x", "&&", 
      RowBox[{"!", "z"}]}], ")"}], "||", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"!", "y"}], "&&", 
      RowBox[{"!", "z"}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.969020016797469*^9, 3.969020186682563*^9}, {
   3.969020230536409*^9, 3.969020244627036*^9}, 3.969020312680873*^9},
 CellLabel->
  "In[322]:=",ExpressionUUID->"2bc259db-adaa-4ddc-ab52-c29eb0abc083"],

Cell["Show its truth table:", "Text",
 CellChangeTimes->{{3.969020730075197*^9, 
  3.9690207381772013`*^9}},ExpressionUUID->"ea1e6baf-c217-40b1-a950-\
80cfa099b766"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ResourceFunction", "[", "\"\<TruthTable\>\"", "]"}], "[", 
  RowBox[{"boo", ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9690205526838617`*^9, 3.969020577680442*^9}, {
  3.969020625254182*^9, 3.969020711332851*^9}},
 CellLabel->
  "In[323]:=",ExpressionUUID->"d0b86453-238e-453e-9b9c-95dec6a4164a"],

Cell["\<\
Show explicitly that this function is balanced by listing all eight inputs \
and verifying that four outputs are 1 and four are 0.\
\>", "Text",
 CellChangeTimes->{{3.969020281466345*^9, 3.969020290762097*^9}, {
  3.969020327844205*^9, 
  3.9690203315344973`*^9}},ExpressionUUID->"8da269ed-ff43-4beb-971c-\
75c20a6d2333"],

Cell[BoxData[
 RowBox[{"Counts", "@", 
  RowBox[{"BooleanTable", "[", "boo", "]"}]}]], "Input",
 CellChangeTimes->{{3.969020262204735*^9, 3.9690202792375917`*^9}},
 CellLabel->
  "In[324]:=",ExpressionUUID->"f59e4e09-2e59-4e16-928b-e177d02c49e7"],

Cell[TextData[{
 "The quantum Deutsch-Jozsa algorithm can use two oracle types. The ",
 StyleBox["Boolean",
  FontSlant->"Italic"],
 " oracle acts on an n-qubit input register plus one ancilla qubit: it leaves \
the input unchanged and flips the ancilla exactly when the function evaluates \
to 1."
}], "Text",
 CellChangeTimes->{{3.969020350968472*^9, 3.96902036711898*^9}, {
  3.969020420709981*^9, 
  3.969020463342209*^9}},ExpressionUUID->"3e0e011d-d11b-4aef-b73e-\
645bf0105add"],

Cell[TextData[{
 "The above bit oracle acts as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["U", "f"], 
     TemplateBox[{"x"},
      "Ket"], 
     TemplateBox[{"y"},
      "Ket"]}], "=", 
    RowBox[{
     TemplateBox[{"x"},
      "Ket"], 
     TemplateBox[{
       RowBox[{"y", "\[CirclePlus]", 
         RowBox[{"f", "(", "x", ")"}]}]},
      "Ket"]}]}], TraditionalForm]],ExpressionUUID->
  "490a628a-b318-4f23-93ca-20db40b832e0"],
 " where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"x"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "508d8621-73cf-4b0e-8dc0-8e615256f432"],
 " represents n-qubit case and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"y"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "1d3faa16-c396-4363-b5d0-600b4e397c3d"],
 " the ancillary one (the last qubit)"
}], "Text",
 CellChangeTimes->{{3.968752716749547*^9, 3.968752733263032*^9}, {
  3.968765408531855*^9, 3.968765499470747*^9}, {3.969021053475059*^9, 
  3.969021070650076*^9}},ExpressionUUID->"8021fb1e-d077-459a-aacb-\
f03d298f01ba"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"op", "=", 
       RowBox[{"QuantumCircuitOperator", "[", 
        RowBox[{"\"\<DeutschJozsaBooleanOracle\>\"", "[", "boo", "]"}], 
        "]"}]}], ",", 
      RowBox[{"sol", "=", 
       RowBox[{"Boole", "[", 
        RowBox[{"SatisfiabilityInstances", "[", 
         RowBox[{"boo", ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", "All"}], "]"}], 
        "]"}]}]}], "}"}], ",", 
    RowBox[{"Row", "[", 
     RowBox[{"Riffle", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"op", "[", 
          RowBox[{"\"\<Diagram\>\"", ",", 
           RowBox[{"\"\<WireLabels\>\"", "->", "None"}], ",", 
           RowBox[{"ImageSize", "->", "200"}], ",", 
           RowBox[{"PlotLabel", "->", "\"\<DJ Boolean oracle\>\""}]}], "]"}], 
         ",", 
         RowBox[{"Sequence", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"TableForm", "[", 
              RowBox[{"#", ",", 
               RowBox[{"TableHeadings", "->", 
                RowBox[{"{", 
                 RowBox[{"None", ",", " ", 
                  RowBox[{"{", 
                   
                   RowBox[{"\"\<\!\(\*TemplateBox[{\"x\"},\"Ket\"]\)\!\(\*\
TemplateBox[{\"y\"},\"Ket\"]\)\>\"", 
                    ",", "\"\<DJ\!\(\*TemplateBox[{\"x\"},\"Ket\"]\)\!\(\*\
TemplateBox[{\"y\"},\"Ket\"]\)\>\"", 
                    ",", "\"\<\!\(\*TemplateBox[{\"x\"},\"Ket\"]\)\!\(\*\
TemplateBox[{
RowBox[{\"y\", \"\[CirclePlus]\", 
RowBox[{\"f\", 
RowBox[{\"(\", \"x\", \")\"}]}]}]},\"Ket\"]\)\>\""}], "}"}]}], "}"}]}], ",", 
               RowBox[{"TableDepth", "->", "2"}]}], "]"}], "&"}], "/@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Partition", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"Append", "[", 
                  RowBox[{
                   RowBox[{"Transpose", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"TraditionalForm", "[", "#", "]"}], ",", 
                    RowBox[{"TraditionalForm", "[", 
                    RowBox[{"op", "[", "#", "]"}], "]"}]}], "}"}], "&"}], "/@", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"QuantumState", "[", 
                    RowBox[{"\"\<Register\>\"", "[", 
                    RowBox[{"4", ",", "i"}], "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", 
                    RowBox[{
                    SuperscriptBox["2", "4"], "-", "1"}], ",", "0", ",", 
                    RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "]"}], ",", 
                   RowBox[{"Riffle", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Boole", "@", 
                    RowBox[{"Append", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"Xor", "[", 
                    RowBox[{
                    RowBox[{"boo", "/.", 
                    RowBox[{"Thread", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y", ",", "z"}], "}"}], "->", "#"}], 
                    "]"}]}], ",", "True"}], "]"}]}], "]"}]}], "&"}], "/@", 
                    RowBox[{"Tuples", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"True", ",", "False"}], "}"}], ",", "3"}], 
                    "]"}]}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Boole", "@", 
                    RowBox[{"Append", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"Xor", "[", 
                    RowBox[{
                    RowBox[{"boo", "/.", 
                    RowBox[{"Thread", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y", ",", "z"}], "}"}], "->", "#"}], 
                    "]"}]}], ",", "False"}], "]"}]}], "]"}]}], "&"}], "/@", 
                    RowBox[{"Tuples", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"True", ",", "False"}], "}"}], ",", "3"}], 
                    "]"}]}]}], "]"}]}], "]"}], "]"}], ",", 
                RowBox[{"UpTo", "@", "8"}]}], "]"}], "/.", 
              RowBox[{
               RowBox[{
                RowBox[{"{", "x__", "}"}], "/;", 
                RowBox[{
                 RowBox[{"ContainsOnly", "[", 
                  RowBox[{
                   RowBox[{"{", "x", "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", "1"}], "}"}]}], "]"}], "&&", 
                 RowBox[{"MemberQ", "[", 
                  RowBox[{"sol", ",", 
                   RowBox[{"Most", "[", 
                    RowBox[{"{", "x", "}"}], "]"}]}], "]"}]}]}], "->", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"{", "x", "}"}], ",", 
                 RowBox[{"Background", "->", "LightBlue"}]}], "]"}]}]}], 
             ")"}]}], ")"}]}]}], "}"}], ",", "\"\<  \>\""}], "]"}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.968501623464031*^9, {3.968502000039297*^9, 3.9685020284941273`*^9}, {
   3.9685023283535833`*^9, 3.968502331817149*^9}, {3.968762289868658*^9, 
   3.968762301226012*^9}, {3.968764801316526*^9, 3.968764801536784*^9}, {
   3.9687652720337353`*^9, 3.968765371957715*^9}, 3.9687708471166077`*^9, {
   3.9687709136055317`*^9, 3.968770926505014*^9}, {3.96902089170341*^9, 
   3.969020913958467*^9}, {3.969020945434108*^9, 3.9690209492914886`*^9}, {
   3.969021136280863*^9, 3.969021172259692*^9}, {3.969021387445278*^9, 
   3.969021420852378*^9}, {3.969021462289921*^9, 3.969021498459434*^9}, {
   3.969021534659793*^9, 3.9690216832978497`*^9}, {3.969021737224319*^9, 
   3.9690217515195713`*^9}, {3.969021837333647*^9, 3.969021883276197*^9}, {
   3.9690219263547497`*^9, 3.969021929739976*^9}, {3.969280808287257*^9, 
   3.9692809123458652`*^9}, {3.969280947809606*^9, 3.969280951477624*^9}, {
   3.969280989215349*^9, 3.969281014340584*^9}},
 CellLabel->
  "In[325]:=",ExpressionUUID->"9b87d4af-dcd2-4976-ae8c-18c5a350d16c"],

Cell[TextData[{
 "We have highlighted all instances ",
 Cell[BoxData[Cell[TextData[Cell[BoxData[
   FormBox[
    TemplateBox[{"x"},
     "Ket"], TraditionalForm]],
   FormatType->TraditionalForm,ExpressionUUID->
   "377f06ae-692e-40db-847f-bbb5b11a80c7"]],ExpressionUUID->
   "de977a20-754c-4437-adb5-66630fbcf6e3"]],ExpressionUUID->
  "54ed2fe0-d47d-47b1-ae49-09c5b487a0d8"],
 " where the Boolean expression ",
 Cell[BoxData[
  FormBox["boo", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c6d3be14-4b26-4fc7-87a3-e10ad9c04aba"],
 " is true:"
}], "Text",
 CellChangeTimes->{{3.969281156982851*^9, 3.969281159919098*^9}, {
  3.969281191187488*^9, 
  3.9692812426229877`*^9}},ExpressionUUID->"c43a7dce-be62-4415-a265-\
1c8911fa1fb6"],

Cell[BoxData[
 RowBox[{"Boole", "[", 
  RowBox[{"SatisfiabilityInstances", "[", 
   RowBox[{"boo", ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", "All"}], "]"}], 
  "]"}]], "Input",
 CellLabel->
  "In[326]:=",ExpressionUUID->"677b09f6-6ea6-4214-8130-0b4b9c8d3f71"],

Cell["\<\
An important feature: if the ancilla is initialized in the minus state, the \
Boolean oracle leaves it unchanged and instead tags solutions by a negative \
phase on the corresponding n-qubit terms.\
\>", "Text",
 CellChangeTimes->{{3.969022418006321*^9, 
  3.969022501269607*^9}},ExpressionUUID->"57d253f7-e440-4838-a663-\
9409567f418f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"op", "=", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<DeutschJozsaBooleanOracle\>\"", "[", "boo", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"op", "[", 
     RowBox[{"\"\<Diagram\>\"", ",", 
      RowBox[{"\"\<WireLabels\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<\>\"", ",", "\"\<\>\"", ",", "\"\<\>\"", 
         ",", "\"\<\!\(\*TemplateBox[{\"-\"},\"Ket\"]\)\>\""}], "}"}]}], ",", 
      RowBox[{"ImageSize", "->", "200"}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<DJ Boolean oracle\>\""}]}], "]"}], ",", 
    ",", "\"\<  \>\"", ",", 
    RowBox[{"TableForm", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"TraditionalForm", "[", 
           RowBox[{"QuantumState", "[", 
            RowBox[{"#", ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "2", ",", "2", ",", "\"\<X\>\""}], "}"}]}], 
            "]"}], "]"}], ",", 
          RowBox[{"TraditionalForm", "[", 
           RowBox[{"QuantumState", "[", 
            RowBox[{
             RowBox[{"op", "[", "#", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "2", ",", "2", ",", "\"\<X\>\""}], "}"}]}], 
            "]"}], "]"}]}], "}"}], "&"}], "/@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"QuantumTensorProduct", "[", 
          RowBox[{
           RowBox[{"QuantumState", "[", 
            RowBox[{"\"\<Register\>\"", "[", 
             RowBox[{"3", ",", "i"}], "]"}], "]"}], ",", 
           RowBox[{"QuantumState", "[", "\"\<-\>\"", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{
            SuperscriptBox["2", "3"], "-", "1"}], ",", "0", ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ",", 
      RowBox[{"TableHeadings", "->", 
       RowBox[{"{", 
        RowBox[{"None", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\!\(\*TemplateBox[{\"x\"},\"Ket\"]\)\!\(\*TemplateBox[{\
\"y\"},\"Ket\"]\)\>\"", 
           ",", "\"\<DJ\!\(\*TemplateBox[{\"x\"},\"Ket\"]\)\!\(\*TemplateBox[{\
\"y\"},\"Ket\"]\)\>\""}], "}"}]}], "}"}]}], ",", 
      RowBox[{"TableDepth", "->", "2"}]}], "]"}]}], "}"}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.969022044952692*^9, 3.9690220451549664`*^9}, {
   3.969022079232051*^9, 3.9690221062310543`*^9}, {3.969022138692359*^9, 
   3.9690222627534122`*^9}, {3.969022299547374*^9, 3.969022327809965*^9}, {
   3.969022359080018*^9, 3.9690224052967033`*^9}, 3.9690226051044703`*^9},
 CellLabel->
  "In[327]:=",ExpressionUUID->"425aaa8d-454c-4f9f-9eb9-ba644907cea2"],

Cell["\<\
The Deutsch-Jozsa phase oracle uses no ancilla and applies a negative \
phase to input states that satisfy the function.\
\>", "Text",
 CellChangeTimes->{{3.9690226316357718`*^9, 
  3.969022682871791*^9}},ExpressionUUID->"164da6d9-8ca0-4ec6-934c-\
881aeab5785b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"op", "=", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<DeutschJozsaPhaseOracle\>\"", "[", "boo", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"op", "[", 
     RowBox[{"\"\<Diagram\>\"", ",", 
      RowBox[{"\"\<WireLabels\>\"", "->", "None"}], ",", 
      RowBox[{"ImageSize", "->", "250"}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<DJ Phase oracle\>\""}]}], "]"}], ",", 
    ",", "\"\<  \>\"", ",", 
    RowBox[{"TableForm", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"TraditionalForm", "[", "#", "]"}], ",", 
          RowBox[{"TraditionalForm", "[", 
           RowBox[{"op", "[", "#", "]"}], "]"}]}], "}"}], "&"}], "/@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"QuantumState", "[", 
          RowBox[{"\"\<Register\>\"", "[", 
           RowBox[{"3", ",", "i"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{
            SuperscriptBox["2", "3"], "-", "1"}], ",", "0", ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ",", 
      RowBox[{"TableHeadings", "->", 
       RowBox[{"{", 
        RowBox[{"None", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\!\(\*TemplateBox[{\"x\"},\"Ket\"]\)\!\(\*TemplateBox[{\
\"y\"},\"Ket\"]\)\>\"", 
           ",", "\"\<DJ\!\(\*TemplateBox[{\"x\"},\"Ket\"]\)\!\(\*TemplateBox[{\
\"y\"},\"Ket\"]\)\>\""}], "}"}]}], "}"}]}], ",", 
      RowBox[{"TableDepth", "->", "2"}]}], "]"}]}], "}"}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.96902254004335*^9, 3.9690226217372093`*^9}},
 CellLabel->
  "In[329]:=",ExpressionUUID->"273b6923-4d63-49fc-9a68-e05a90d44c1c"]
}, Closed]],

Cell[CellGroupData[{

Cell["Deutsch-Jozsa Algorithm", "Section",
 CellChangeTimes->{{3.9690231865081263`*^9, 3.969023198302148*^9}, 
   3.9690233084810467`*^9, {3.969025336742032*^9, 3.969025338957468*^9}, 
   3.969977096186226*^9},ExpressionUUID->"5bab7fe0-5fde-4082-bfdf-\
f19df7d30ff6"],

Cell[TextData[{
 "Putting it all together, the Deutsch-Jozsa circuit with the Boolean oracle \
is: prepare the input register in equal superposition and the ancilla in the \
minus state, apply the Boolean oracle, then measure the input register in the \
Pauli-X basis. If the outcome of measurements is only ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SuperscriptBox["+", 
      RowBox[{"\[CircleTimes]", "n"}]]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "e3cb6d46-101d-4a01-979a-98ed81f5f5a7"],
 ", declare ",
 StyleBox["constant",
  FontSlant->"Italic"],
 "; otherwise, declare ",
 StyleBox["balanced",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.9690227492827587`*^9, 3.969022784708469*^9}, {
   3.9690234443845797`*^9, 3.969023469443605*^9}, {3.9690256009071693`*^9, 
   3.96902561594836*^9}, 3.969025649048972*^9},
 CellID->1029943986,ExpressionUUID->"ad262c0e-a655-4b86-95aa-a73ac3f08512"],

Cell["\<\
Show the Deutsch-Jozsa circuit for the previously discussed Boolean \
function:\
\>", "Text",
 CellChangeTimes->{{3.969025624534889*^9, 
  3.969025664279234*^9}},ExpressionUUID->"fbc321d8-5c03-4ed2-bed3-\
67b1077621bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<DeutschJozsa\>\"", "[", "boo", "]"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellProlog:>Needs["Wolfram`QuantumFramework`"],
 CellChangeTimes->{{3.969022708261636*^9, 3.9690227218359823`*^9}, {
  3.9690227890148563`*^9, 3.969022816099374*^9}, {3.9690234743448973`*^9, 
  3.969023476558949*^9}},
 CellLabel->"In[331]:=",
 CellID->1969783609,ExpressionUUID->"de9235a7-6b9d-4d12-a123-04285c8bcbb5"],

Cell["\<\
Pay close attention to the measurements. In Deutsch-Jozsa, the \
measurements are in the Pauli-X basis. The same circuit can also be presented \
in an equivalent form as follows.\
\>", "Text",
 CellChangeTimes->{{3.969023323927017*^9, 3.969023363387722*^9}, {
  3.9690235056017303`*^9, 
  3.9690235065781107`*^9}},ExpressionUUID->"1bdd37e3-f178-4e2f-9743-\
38c09723980c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<H\>\"", "->", 
       RowBox[{"Range", "[", "4", "]"}]}], ",", 
      RowBox[{"\"\<Z\>\"", "->", "4"}]}], "}"}], "/*", 
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"\"\<DeutschJozsaBooleanOracle\>\"", "[", "boo", "]"}], "]"}], "/*", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<H\>\"", "->", 
       RowBox[{"Range", "[", "3", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "}"}]}], ")"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.969023379791174*^9, 3.969023418937574*^9}, {
  3.969023481275941*^9, 3.969023486144023*^9}, {3.969024603738461*^9, 
  3.9690246075004683`*^9}},
 CellLabel->
  "In[332]:=",ExpressionUUID->"c4568325-046d-47b4-b8e1-8e1bc6b4bd5b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<DeutschJozsa\>\"", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "&&", 
        RowBox[{"!", "y"}]}], ")"}], "||", 
      RowBox[{"(", 
       RowBox[{"x", "&&", 
        RowBox[{"!", "z"}]}], ")"}], "||", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"!", "y"}], "&&", 
        RowBox[{"!", "z"}]}], ")"}]}], "]"}], "]"}], "[", "]"}], 
  "[", "\"\<ProbabilitiesPlot\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.969022797776165*^9, 3.9690228078986197`*^9}, {
  3.969022868018057*^9, 3.9690228685462503`*^9}, {3.969022922427759*^9, 
  3.9690229289022217`*^9}, {3.9690246161861486`*^9, 3.9690246176080017`*^9}, {
  3.969923595455364*^9, 3.969923632965619*^9}},
 CellLabel->
  "In[333]:=",ExpressionUUID->"0f56ecb2-6ef5-4323-a68b-530ee6e75d07"],

Cell[BoxData[
 RowBox[{
  RowBox[{RowBox[{"QuantumCircuitOperator", "[", RowBox[{"\"\<DeutschJozsa\>\"", "[", "boo", "]"}], "]"}], "[", "]"}], "[", 
  RowBox[{"\"\<ProbabilitiesPlot\>\"", ",", 
   RowBox[{"AspectRatio", "->", 
    RowBox[{"1", "/", "4"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.969022797776165*^9, 3.9690228078986197`*^9}, {
   3.969022868018057*^9, 3.9690228685462503`*^9}, {3.969022922427759*^9, 
   3.9690229289022217`*^9}, {3.9690246161861486`*^9, 3.9690246176080017`*^9}, 
   3.969923595455364*^9},
 CellLabel->
  "In[334]:=",ExpressionUUID->"fd89277d-88a2-4731-83db-bf3288b7d9c9"],

Cell[TextData[{
 "As one can see, the probability of getting ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{"++", "+"}]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "acbc8f1f-3f9b-415e-a7f9-0d92d8be3d28"],
 " (equivalently, in the computational basis, it\[CloseCurlyQuote]d be ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"000"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "09dac86e-62a8-42c2-8e8f-48c18f27c59b"],
 ") is zero. This implies that the function is a balanced one."
}], "Text",
 CellChangeTimes->{{3.969024624142585*^9, 
  3.969024679276267*^9}},ExpressionUUID->"8bbd507b-6e41-48c3-91c0-\
612a35f98ddc"],

Cell["\<\
For the Deutsch-Jozsa phase oracle, as noted, there is no ancillary \
qubit. The overall circuit is:\
\>", "Text",
 CellChangeTimes->{{3.969025385466927*^9, 3.969025411488893*^9}, {
  3.9690254468688707`*^9, 
  3.9690254485139523`*^9}},ExpressionUUID->"68191045-d7a2-4039-95a4-\
d2f83964658e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<DeutschJozsaPhase\>\"", "[", "boo", "]"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.969025375661202*^9, 3.9690253772797823`*^9}},
 CellLabel->
  "In[334]:=",ExpressionUUID->"5872edb3-d966-418d-aaca-f74c814c8e3d"],

Cell[TextData[{
 "As in the Boolean case, with the Deutsch-Jozsa phase oracle the \
probability of measuring ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{"++", "+"}]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "928e8466-abf1-4b11-bf40-82bcc4d83e9c"],
 "  is also zero."
}], "Text",
 CellChangeTimes->{{3.969025413719746*^9, 3.9690254309244328`*^9}, {
  3.969025463729327*^9, 
  3.969025483090694*^9}},ExpressionUUID->"989fe9d1-9a0c-47ce-bd0a-\
8071fd2c2dbe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<DeutschJozsaPhase\>\"", "[", "boo", "]"}], "]"}], "[", "]"}],
   "[", 
  RowBox[{"\"\<ProbabilitiesPlot\>\"", ",", 
   RowBox[{"AspectRatio", "->", 
    RowBox[{"1", "/", "4"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.96902535319588*^9, 3.9690253554092817`*^9}},
 CellLabel->
  "In[335]:=",ExpressionUUID->"4f215a41-185b-4af3-98cc-6635bd6251d3"],

Cell["\<\
Find all constant and balanced Boolean functions on three input bits. \
(Constant: all 0s or all 1s; Balanced: four 1s and four 0s across the eight \
inputs.)\
\>", "Text",
 CellChangeTimes->{{3.969024484289798*^9, 3.969024501836091*^9}, {
  3.9690245339661427`*^9, 
  3.969024535015561*^9}},ExpressionUUID->"86745afe-0143-42e1-b895-\
17ea20ed5a07"],

Cell[BoxData[
 RowBox[{
  RowBox[{"threeVariableBooleans", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"allBoo", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"BooleanFunction", "[", 
          RowBox[{"#", ",", "3"}], "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", 
          RowBox[{
           SuperscriptBox["2", 
            SuperscriptBox["2", "3"]], "-", "1"}]}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Balanced\>\"", "->", 
        RowBox[{"Select", "[", 
         RowBox[{"allBoo", ",", "\[IndentingNewLine]", "  ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Count", "[", "True", "]"}], "[", 
             RowBox[{"BooleanTable", "[", "#", "]"}], "]"}], "==", 
            RowBox[{
             RowBox[{"Count", "[", "False", "]"}], "[", 
             RowBox[{"BooleanTable", "[", "#", "]"}], "]"}]}], " ", "&"}]}], 
         "]"}]}], ",", 
       RowBox[{"\"\<Constant\>\"", "->", 
        RowBox[{"Select", "[", 
         RowBox[{"allBoo", ",", "\[IndentingNewLine]", "  ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Count", "[", "True", "]"}], "[", 
              RowBox[{"BooleanTable", "[", "#", "]"}], "]"}], "==", "0"}], "||", 
            RowBox[{
             RowBox[{
              RowBox[{"Count", "[", "False", "]"}], "[", 
              RowBox[{"BooleanTable", "[", "#", "]"}], "]"}], "==", "0"}]}], 
           " ", "&"}]}], "]"}]}]}], "|>"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.969024155608314*^9, 3.9690241597075977`*^9}, {
  3.969024349282524*^9, 3.969024464584673*^9}, {3.969024561690855*^9, 
  3.969024561904105*^9}},
 CellLabel->
  "In[336]:=",ExpressionUUID->"9f327eee-3a7a-45fa-a685-cb192e1b63a9"],

Cell["\<\
For three input bits (eight inputs): 70 balanced functions and 2 constant \
functions.\
\>", "Text",
 CellChangeTimes->{{3.9690245037425756`*^9, 3.969024511292891*^9}, 
   3.969024569242367*^9},ExpressionUUID->"d018e5b0-1865-4d01-9ac9-\
9526c4fd5dea"],

Cell[BoxData[
 RowBox[{"Length", "/@", "threeVariableBooleans"}]], "Input",
 CellChangeTimes->{{3.969024479294354*^9, 3.969024480715682*^9}},
 CellLabel->
  "In[337]:=",ExpressionUUID->"6a73ada8-2277-43f0-b992-c29887155a40"],

Cell[TextData[{
 "Consider the Deutsch-Jozsa outcome probabilities for 10 balanced \
Boolean functions on three input bits. In every case, the probability of \
measuring ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{"++", "+"}]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "0e299b64-2202-4e33-8842-2283ba9466b2"],
 " is zero"
}], "Text",
 CellChangeTimes->{{3.96902491596338*^9, 3.969024947268505*^9}, {
  3.969025309968541*^9, 
  3.969025325567217*^9}},ExpressionUUID->"3c5316f1-f52c-451c-b6af-\
1917ba593b1d"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"mea", "=", 
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{"QuantumCircuitOperator", "[", 
              RowBox[{"\"\<DeutschJozsa\>\"", "[", "bf", "]"}], "]"}], "]"}], 
            "[", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"BooleanConvert", "[", "bf", "]"}], "[", 
            RowBox[{"\[FormalX]", ",", "\[FormalY]", ",", "\[FormalZ]"}], 
            "]"}], ",", 
           RowBox[{"mea", "[", 
            RowBox[{"\"\<ProbabilitiesPlot\>\"", ",", 
             RowBox[{"AspectRatio", "->", 
              RowBox[{"1", "/", "3"}]}], ",", 
             RowBox[{"ImageSize", "->", "Small"}], ",", 
             RowBox[{"\"\<LabelsAngle\>\"", "->", 
              RowBox[{"90", "Degree"}]}]}], "]"}], ",", 
           RowBox[{"Chop", "/@", 
            RowBox[{
             RowBox[{"mea", "[", "\"\<Probabilities\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{";;", "1"}], "]"}], "]"}]}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"bf", ",", 
         RowBox[{
          RowBox[{"threeVariableBooleans", "[", "\"\<Balanced\>\"", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{";;", "10"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
      RowBox[{"{", 
       RowBox[{"\"\<Balanced Boolean function\>\"", 
        ",", "\"\<Probability plot\>\"", 
        ",", "\"\<Probability of \!\(\*Cell[TextData[Cell[BoxData[
TemplateBox[{
RowBox[{
SubscriptBox[\"x\", \"+\"], 
SubscriptBox[\"x\", \"+\"], 
SubscriptBox[\"x\", \
\"+\"]}]},\"Ket\"]],ExpressionUUID->\"d5bde031-4e93-4113-966b-319ded94615d\"]]\
,ExpressionUUID->\"bc288c62-6c90-4c7b-ab3f-80911cc5f56c\"]\)\>\""}], 
       "}"}]}]}], "]"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"Left", ",", "Center"}], "}"}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.96902471084727*^9, 3.969024766037881*^9}, {
   3.969024796559525*^9, 3.969024889550722*^9}, {3.9692813051353083`*^9, 
   3.969281331226534*^9}, {3.96928146375139*^9, 3.9692814894428988`*^9}, 
   3.969281554975657*^9, {3.969281596001766*^9, 3.969281598170959*^9}},
 CellLabel->
  "In[338]:=",ExpressionUUID->"cc17cb3d-ff52-44c4-812b-ef47ac4c2a39"],

Cell[TextData[{
 "Consider the Deutsch-Jozsa outcome probabilities for the constant \
Boolean functions on three input bits. In every case, the probability of \
measuring ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{"++", "+"}]},
    "Ket"], TraditionalForm]],ExpressionUUID->
