TemplateBox[{\"1\"},\"Ket\"]],ExpressionUUID->\"b0b13ada-c6b3-4776-b660-\
d6ef6d506146\"]],ExpressionUUID->\"a422c372-44bb-4229-9123-dc3475d689dc\"]\)\>\
\"", ",", "Right"}], "]"}]}], "}"}]}], ",", 
