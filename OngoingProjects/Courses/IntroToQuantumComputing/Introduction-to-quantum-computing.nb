Cell["\<\
A special case of the U3 gate is the U2 gate, specified by two angles.\
\>", "Text",
 CellChangeTimes->{{3.968431645065433*^9, 3.9684316742502117`*^9}},
 CellID->1724704123,ExpressionUUID->"32d29927-5718-4654-93ef-3473f46cf17f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", " ", 
   RowBox[{"\[Phi]", " ", ",", "\[Lambda]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<U2\>\"", "[", 
    RowBox[{"\[Phi]", " ", ",", "\[Lambda]"}], "]"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"\"\<WireLabels\>\"", "->", "None"}], ",", 
   RowBox[{"ImageSize", "->", "100"}]}], "]"}]}], "Input",
