}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Quantum Phase Estimation for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "\[ScriptA]"], TraditionalForm]],ExpressionUUID->
  "9b7e8801-2a24-4fb4-96e9-b44f106b40ae"]
}], "Subsection",
 CellChangeTimes->{{3.955639173623947*^9, 3.95563918081682*^9}, {
  3.9693669963550987`*^9, 
  3.969366996355193*^9}},ExpressionUUID->"25a8d0ec-b4bd-430f-a860-\
8d4cb8e745dd"],

Cell["\<\
Consider the following phase estimation circuit for the unitary operator that \
implements multiplication by \[ScriptA] modulo \[ScriptCapitalN] (in this \
case 13 modulo 15): \
\>", "Text",
 CellChangeTimes->{{3.9556392311777*^9, 3.9556392808801975`*^9}, 
   3.969114103440193*^9, 3.969356848298208*^9, {3.969373850695323*^9, 
   3.969373850888722*^9}},ExpressionUUID->"440dc588-6716-49a1-822c-\
ca6f687f111f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc1", "=", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"\"\<PhaseEstimation\>\"", "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\[ScriptCapitalU]a", "[", 
         RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}], "]"}], ",", 
       RowBox[{"2", "m"}]}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"m", ";;"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"qc1", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "->", "800"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9555512883573513`*^9, 3.955551325995556*^9}, {
   3.9555513839688053`*^9, 3.955551422546316*^9}, {3.955551487789877*^9, 
   3.9555514934524517`*^9}, {3.9555531590008144`*^9, 3.955553183159317*^9}, 
   3.9555533353535843`*^9, {3.955554608384327*^9, 3.9555546301788807`*^9}, {
   3.9556391953165913`*^9, 3.9556392120537586`*^9}, {3.9556392928904552`*^9, 
   3.9556392998883705`*^9}, {3.9556402084565544`*^9, 3.955640235710249*^9}, 
   3.9693119244493504`*^9, {3.969312038317268*^9, 3.9693120406193943`*^9}, {
   3.969367043874445*^9, 3.969367078122698*^9}, {3.9693671690589457`*^9, 
   3.969367182215427*^9}, {3.969368029932394*^9, 3.969368062042007*^9}, 
   3.969368675639076*^9, {3.9693723783620996`*^9, 3.969372399629529*^9}, {
   3.96937265832155*^9, 3.969372666692034*^9}, 3.969923402617488*^9, {
   3.969925578617736*^9, 3.969925579743906*^9}, {3.969925767071948*^9, 
   3.969925796456813*^9}},
 CellLabel->
  "In[521]:=",ExpressionUUID->"a8960595-d9b1-44c6-aa47-32b7968945ac"],

Cell["Compute the measurement distribution:", "Text",
 CellChangeTimes->{{3.955639523666092*^9, 
  3.9556395620615025`*^9}},ExpressionUUID->"f8d71006-09e4-43da-94e2-\
5bedb634658e"],

Cell[BoxData[
 RowBox[{"measurement1", "=", 
  RowBox[{
   RowBox[{"N", "[", "qc1", "]"}], "[", "]"}]}]], "Input",
