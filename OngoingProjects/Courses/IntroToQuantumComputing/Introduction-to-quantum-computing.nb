  FormBox[
   RowBox[{
    RowBox[{"U2", "[", 
     RowBox[{"\[Phi]", " ", ",", "\[Lambda]"}], "]"}], "=", 
    RowBox[{"U3", "[", 
     RowBox[{
      RowBox[{"\[Pi]", "/", "2"}], ",", "\[Phi]", " ", ",", "\[Lambda]"}], 
