Cell[TextData[{
 "For a specific example, verify ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "a"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "62e0443a-d7a9-447b-a903-40cf6a8cca11"],
 " is unitary:"
}], "Text",
 CellChangeTimes->{{3.955551089158922*^9, 3.955551109609476*^9}, 
   3.9555512735428295`*^9, {3.969358840793229*^9, 
   3.969358872949294*^9}},ExpressionUUID->"f388df87-9763-4e2b-bdca-\
df6225f71a94"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalU]a", "[", 
   RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}], "//", 
  "UnitaryMatrixQ"}]], "Input",
 CellChangeTimes->{{3.955550821126333*^9, 3.955550826325617*^9}, {
  3.969358230312458*^9, 3.969358237429204*^9}, {3.969358272094133*^9, 
  3.9693582759057817`*^9}, {3.969369712823577*^9, 3.969369722495577*^9}},
 CellLabel->
  "In[511]:=",ExpressionUUID->"34d40ad9-d074-4690-be27-1b45be379708"],

Cell[TextData[{
 "Verify ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["U", "\[ScriptA]", "\[Dagger]"], "=", 
    RowBox[{
     SubsuperscriptBox["U", "\[ScriptA]", "T"], "=", 
     SubsuperscriptBox["U", "\[ScriptA]", 
      RowBox[{"-", "1"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b8de6df0-80c9-4324-8df6-9858352d5441"],
 " for a specific example:"
}], "Text",
 CellChangeTimes->{{3.9693583370452633`*^9, 3.969358401768239*^9}, {
  3.9693585076725693`*^9, 3.9693585238293467`*^9}, {3.9693670095863743`*^9, 
  3.9693670131642714`*^9}},ExpressionUUID->"389f82e9-8014-4ca3-b6ce-\
355de287cbc5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Transpose", "[", 
   RowBox[{"\[ScriptCapitalU]a", "[", 
    RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}], "]"}], "==", 
  RowBox[{"Inverse", "[", 
   RowBox[{"\[ScriptCapitalU]a", "[", 
    RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}], "]"}], "==", 
  RowBox[{"ConjugateTranspose", "[", 
   RowBox[{"\[ScriptCapitalU]a", "[", 
    RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.969358492045026*^9, 3.9693585038122263`*^9}, {
  3.969358884085986*^9, 3.9693588873598423`*^9}, {3.969367124153783*^9, 
  3.969367133110229*^9}},
 CellLabel->
  "In[512]:=",ExpressionUUID->"1b92edac-c6b5-412f-b1c5-d9a6a1bb6996"],

Cell[TextData[{
 "Verify ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["U", "\[ScriptA]", "T"], ".", 
     SubscriptBox["U", "\[ScriptA]"]}], "=", 
    SubscriptBox["\[DoubleStruckCapitalI]", 
     SuperscriptBox["2", "m"]]}], TraditionalForm]],ExpressionUUID->
  "2d22a65e-61a9-41f9-9fd9-694908e66e5c"],
 " for a specific example:"
}], "Text",
 CellChangeTimes->{{3.969358525863613*^9, 3.9693585369945087`*^9}, {
  3.969358870563281*^9, 3.969358870876055*^9}, {3.96936700288209*^9, 
  3.969367004618525*^9}, {3.9693686522623367`*^9, 
  3.9693686522624693`*^9}},ExpressionUUID->"7b197990-6172-47de-98bb-\
63e24219a4d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalU]a", "[", 
     RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}], ".", 
    RowBox[{"Transpose", "[", 
     RowBox[{"\[ScriptCapitalU]a", "[", 
      RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}], "]"}]}], "==", 
   RowBox[{"IdentityMatrix", "[", 
    SuperscriptBox["2", "m"], "]"}]}], "//", "Chop"}]], "Input",
 CellChangeTimes->{{3.969358251889163*^9, 3.969358327236164*^9}, {
   3.969358409769884*^9, 3.9693584784902277`*^9}, {3.969367136445573*^9, 
   3.969367144832111*^9}, {3.969367973593212*^9, 3.9693679743596077`*^9}, 
   3.969368646895624*^9},
 CellLabel->
  "In[513]:=",ExpressionUUID->"d451d542-fd36-4659-9178-3a3f93dfa569"],

Cell["\<\
Notice that this operator raised to the multiplicative order of \[ScriptA] \
modulo \[ScriptCapitalN] gives the identity operator:\
\>", "Text",
 CellChangeTimes->{{3.955555983404316*^9, 3.9555559852570457`*^9}, {
   3.955556016758217*^9, 3.9555560421310577`*^9}, 3.9691141034364233`*^9, 
   3.969356848292944*^9},ExpressionUUID->"06096f01-83ca-48d2-a007-\
058e9dbee0a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MatrixPower", "[", 
    RowBox[{
     RowBox[{"\[ScriptCapitalU]a", "[", 
      RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}], ",", "m"}], 
    "]"}], "==", 
   RowBox[{"IdentityMatrix", "[", 
    SuperscriptBox["2", "m"], "]"}]}], "//", "Chop"}]], "Input",
 CellChangeTimes->{{3.9693667354481153`*^9, 3.969366748829033*^9}, {
   3.9693668905118217`*^9, 3.969366894935072*^9}, 3.969366936169701*^9, {
   3.969367148741053*^9, 3.969367155093485*^9}, {3.969368659163043*^9, 
   3.969368661991733*^9}},
 CellLabel->
  "In[514]:=",ExpressionUUID->"1faaa1ed-7881-4f5d-83f1-875fa6409517"],

Cell[TextData[{
 "Verify ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["U", "\[ScriptA]"], 
     TemplateBox[{"y"},
      "Ket"]}], "=", 
    TemplateBox[{
      RowBox[{"\[ScriptA]", " ", "y", " ", "mod", " ", "\[ScriptCapitalN]"}]},
     "Ket"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e436eb74-5b0a-4136-89a0-91b27ff2f5f5"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "\[Element]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "\[Ellipsis]", ",", "\[ScriptCapitalN]"}], "}"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "71edcaba-4721-4041-a492-a298be3ccb62"],
 "."
}], "Text",
 CellChangeTimes->{{3.96936950122901*^9, 
  3.969369546968555*^9}},ExpressionUUID->"afb2b56e-1974-463b-be20-\
25ed19392dd5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[ScriptCapitalU]a", "[", 
       RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}], ".", 
      RowBox[{"UnitVector", "[", 
       RowBox[{
        SuperscriptBox["2", "m"], ",", 
        RowBox[{"y", "+", "1"}]}], "]"}]}], "==", 
     RowBox[{"UnitVector", "[", 
      RowBox[{
       SuperscriptBox["2", "m"], ",", 
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"\[ScriptA]", " ", "y"}], ",", "\[ScriptCapitalN]"}], "]"}],
         "+", "1"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", "0", ",", 
      RowBox[{"\[ScriptCapitalN]", "-", "1"}]}], "}"}]}], "]"}], "//", 
  RowBox[{"Apply", "[", "And", "]"}]}]], "Input",
 CellChangeTimes->{{3.969368711344933*^9, 3.9693688074554853`*^9}, {
  3.969369466244953*^9, 3.969369495395899*^9}, {3.969369759074888*^9, 
  3.969369762329973*^9}},
 CellLabel->
  "In[515]:=",ExpressionUUID->"910f966c-a9be-482f-bfb2-14d4a370aae5"],

Cell[TextData[{
 "Verify ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["U", "\[ScriptA]", 
      SuperscriptBox["2", "k"]], 
     TemplateBox[{"y"},
      "Ket"]}], "=", 
    TemplateBox[{
      RowBox[{
        SuperscriptBox["\[ScriptA]", 
         SuperscriptBox["2", "k"]], " ", "y", " ", "mod", " ", 
        "\[ScriptCapitalN]"}]},
     "Ket"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "70113122-8f48-4124-9c72-24125c88fa91"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "\[Element]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "\[Ellipsis]", ",", "\[ScriptCapitalN]"}], "}"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "32ba97d3-aaae-476c-aead-c40cc70bd042"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "\[Element]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "\[Ellipsis]", ",", "\[ScriptCapitalN]"}], "}"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "283c1788-ccb5-4349-9974-b970f0e1b06e"],
 "."
}], "Text",
 CellChangeTimes->{{3.96936950122901*^9, 3.969369546968555*^9}, {
  3.969369957393423*^9, 
  3.969369990924452*^9}},ExpressionUUID->"96858062-58f0-4617-9420-\
f5083c74d57a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"MatrixPower", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalU]a", "[", 
          RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}], ",", 
         SuperscriptBox["2", "k"]}], "]"}], ".", 
       RowBox[{"UnitVector", "[", 
        RowBox[{
         SuperscriptBox["2", "m"], ",", 
         RowBox[{"y", "+", "1"}]}], "]"}]}], "==", 
      RowBox[{"UnitVector", "[", 
       RowBox[{
        SuperscriptBox["2", "m"], ",", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            SuperscriptBox["\[ScriptA]", 
             SuperscriptBox["2", "k"]], " ", "y"}], ",", 
           "\[ScriptCapitalN]"}], "]"}], "+", "1"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "0", ",", 
       RowBox[{"\[ScriptCapitalN]", "-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", 
       RowBox[{"\[ScriptCapitalN]", "-", "1"}]}], "}"}]}], "]"}], "//", 
   "Flatten"}], "//", 
  RowBox[{"Apply", "[", "And", "]"}]}]], "Input",
 CellChangeTimes->{{3.9693698379763613`*^9, 3.969369855752902*^9}, {
  3.969369917787509*^9, 3.969369946749748*^9}},
 CellLabel->
  "In[516]:=",ExpressionUUID->"841d56e6-8ba6-4650-82b1-4de3b099047d"],

Cell[TextData[{
 "Verify ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "\[ScriptA]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ba3bdb81-4e78-4fba-9754-58700ca430ee"],
 " has four distinct eigenvalues (each with some multiplicity):"
}], "Text",
