Cell[CellGroupData[{

Cell["3-qubit gates and more", "Subsection",
 CellChangeTimes->{{3.9693005828017817`*^9, 
  3.969300589976585*^9}},ExpressionUUID->"74b4c0eb-c531-4a46-a92d-\
6c45fb0508b0"],

Cell[TextData[{
 "An important 3-qubit conditional gate is Toffoli gate. It is CCX gate, with \
qubit 1 and 2 as control qubits and qubit 3 as the target one. Toffili gate \
is the backbone for adders, comparators, and many error-correction routines. \
Its effect can be written as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      RowBox[{"a", ",", "b", ",", "c"}]},
     "Ket"], "->", 
    TemplateBox[{
      RowBox[{"a", ",", "b", ",", 
        RowBox[{"c", "\[CirclePlus]", 
          RowBox[{"(", 
            RowBox[{"a", "\[And]", "b"}], ")"}]}]}]},
     "Ket"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b5e63a53-7d84-4f3f-8c37-92fde92866b7"],
 "."
}], "Text",
 CellChangeTimes->{{3.969300759302642*^9, 
  3.9693008914544363`*^9}},ExpressionUUID->"f9fba526-b64b-409a-866a-\
5667992d0da5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumOperator", "[", "\"\<Toffoli\>\"", "]"}], "[", 
  RowBox[{"\"\<CircuitDiagram\>\"", ",", 
   RowBox[{"ImageSize", "->", "80"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.969300591188663*^9, 3.9693006210381193`*^9}},
 CellLabel->
  "In[305]:=",ExpressionUUID->"663d1e5c-714c-40a7-aa31-ccaf51e3449b"],

