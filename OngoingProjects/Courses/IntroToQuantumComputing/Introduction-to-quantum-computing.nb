        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence["WireLabels" -> None, ImageSize -> 100],
    SelectWithContents->True,
    Selectable->False]}], "]"}]}], "Input",
 CellChangeTimes->{{3.968427961498467*^9, 3.9684279643639727`*^9}, 
   3.968445766576235*^9, 3.969276070127034*^9},
 CellLabel->
  "In[225]:=",ExpressionUUID->"62663f00-d085-4e99-8f85-73c54b794d84"],

Cell["The label for the gate is obtained as follows: ", "Text",
