Cell[TextData[{
 "In this approach, a quantum state is represented by a point in 3D space \
inside a sphere of radius 1 (the Bloch sphere). The point may lie on the \
surface, in which case we call it a ",
 StyleBox["pure",
  FontSlant->"Italic"],
 " state, or inside the sphere, in which case we call it a ",
 StyleBox["mixed",
  FontSlant->"Italic"],
 " state."
}], "Text",
 CellChangeTimes->{{3.9683686613284187`*^9, 
  3.968368758874648*^9}},ExpressionUUID->"5479f798-a0bd-4052-958a-\
cd0a2a8afb11"],

Cell[TextData[{
 "Show the Bloch vector of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"0"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "4e2dbd63-fef8-4f59-9bbd-9bfcf78c87b5"],
 ":"
}], "Text",
 CellChangeTimes->{{3.969206966983881*^9, 3.969206976141059*^9}, {
  3.969213033870406*^9, 
  3.969213034260421*^9}},ExpressionUUID->"96b339c6-cf3d-4972-99b2-\
2abf48a95662"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], "[", "\"\<BlochVector\>\"",
   "]"}]], "Input",
 CellChangeTimes->{{3.96920695352765*^9, 3.969206955272273*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"7728bafe-8f29-4a22-8ad3-5c2a4917f811"],

Cell[TextData[{
 "Show the Bloch vector of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"1"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "e0432091-57c9-47ef-8785-745b2930273c"],
 ":"
}], "Text",
 CellChangeTimes->{{3.969206966983881*^9, 3.969206992832829*^9}, {
  3.9692130489612837`*^9, 
  3.9692130494213057`*^9}},ExpressionUUID->"1cde376a-3687-463f-a653-\
6043bb86ccb2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}], "[", "\"\<BlochVector\>\"",
   "]"}]], "Input",
 CellChangeTimes->{3.969207000341176*^9},
 CellLabel->"In[33]:=",ExpressionUUID->"da9296a9-c2bf-430c-829a-91473ea20269"],

Cell[TextData[{
 "The Bloch vector is represented as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["r", "x"], ",", 
     SubscriptBox["r", "y"], ",", 
     SubscriptBox["r", "z"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "c36abb26-9a2e-48d0-939c-1efc042f216a"],
 " such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["r", "x", "2"], "+", 
     SubsuperscriptBox["r", "y", "2"], "+", 
     SubsuperscriptBox["r", "z", "2"]}], "<=", "1"}], TraditionalForm]],
  ExpressionUUID->"3920b835-c800-4c1f-9835-3fb0cfe3d17d"],
 ". In the spherical coordinates, it is described by three variables ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], TraditionalForm]],
  ExpressionUUID->"6f3e2b4e-7ef3-4834-8450-e2a59f5d0eb7"],
 " and its Cartesian coordinates are given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"82bfe200-1640-43ea-b9e5-89e6cbb187c1"],
 ". All points in the Bloch sphere are accessible, given different values of ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "72564091-8656-4577-93e6-db6b247a9c84"],
 ", ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "a7e67cc4-c17d-4ce6-a392-8cf35d61353b"],
 ", and ",
 Cell[BoxData[
  FormBox["\[Phi]", TraditionalForm]],ExpressionUUID->
  "60433cef-5ba3-4958-833b-4dfc59d52d7f"],
 ":"
}], "Text",
 CellChangeTimes->{{3.969211063484614*^9, 3.96921111578876*^9}, {
  3.969212732538136*^9, 3.969212752420117*^9}, {3.969212819059189*^9, 
  3.969212845635459*^9}},ExpressionUUID->"7085e367-be08-4ccb-8853-\
58002a403111"],

