\"", ",", "Left"}], "]"}], ",", 
         RowBox[{"Placed", "[", 
          RowBox[{"\"\<\!\(\*Cell[TextData[Cell[BoxData[
TemplateBox[{\"0\"},\"Ket\"]],ExpressionUUID->\"2b0ed297-3731-4d88-bb48-\
80603407e68a\"]],ExpressionUUID->\"a28ead47-2120-40c8-a7f0-7269c5d9c394\"]\)\>\
\"", ",", "Right"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"3", "->", 
       RowBox[{"{", 
