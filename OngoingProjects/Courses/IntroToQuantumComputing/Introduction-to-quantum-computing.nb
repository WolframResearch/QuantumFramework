a7768515cea1"],

Cell["Quantum computation", "Item",
 CellChangeTimes->{{3.943970200281273*^9, 3.943970202137924*^9}, {
  3.943971815059799*^9, 3.943971816383873*^9}, {3.969215617075123*^9, 
  3.96921562310877*^9}},ExpressionUUID->"962152d2-7b05-a146-a71a-\
9d08a17ffcbf"],

Cell["Quantum bit (qubit)", "Item",
 CellChangeTimes->{{3.943970200281273*^9, 3.943970202137924*^9}, {
  3.943971815059799*^9, 3.943971819824402*^9}, {3.969215624678026*^9, 
  3.969215631234713*^9}},ExpressionUUID->"8eafce4a-6e03-f649-b2cc-\
969e0fa7db16"],

Cell["Quantum circuit", "Item",
 CellChangeTimes->{{3.943970200281273*^9, 3.943970202137924*^9}, {
  3.943971815059799*^9, 3.943971819824402*^9}, {3.969215624678026*^9, 
  3.969215637370666*^9}},ExpressionUUID->"2fb79789-1d18-460b-849a-\
6ff8cf6f6f09"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Classical Computation", "Section",
 CellChangeTimes->{{3.9439726754595337`*^9, 3.943972676007984*^9}, {
  3.943975856114975*^9, 
  3.9439758589275208`*^9}},ExpressionUUID->"9efc59f2-0028-2b47-a0a6-\
fcd0d6ee13fa"],

Cell["\<\
In order to understand quantum computation, it helps to compare it to \
classical computation. To compute something, you have to be able to use rules \
to determine what should be the output from a list of inputs. You can think \
of computing as starting with the inputs and following the rules to reach an \
output.\
\>", "Text",
 CellChangeTimes->{{3.943973517653755*^9, 3.943973579045574*^9}, {
   3.943973667454586*^9, 3.9439736996257668`*^9}, 
   3.969145663366331*^9},ExpressionUUID->"4f6ef3bb-5b66-f94d-93b0-\
3d81ae080382"],

Cell["\<\
Consider two binary numbers \[OpenCurlyDoubleQuote]01\[CloseCurlyDoubleQuote] \
and \[OpenCurlyDoubleQuote]10\[CloseCurlyDoubleQuote] and let\
\[CloseCurlyQuote]s see how we can add them. First, each bit-string is \
interpreted as a base-2 number rather than ordinary decimal, so \
\[OpenCurlyDoubleQuote]01\[CloseCurlyDoubleQuote] becomes one and \
\[OpenCurlyDoubleQuote]10\[CloseCurlyDoubleQuote] becomes two. \
\>", "Text",
 CellChangeTimes->{{3.943973644117935*^9, 3.943973644709938*^9}, {
  3.943973731445715*^9, 3.943973765023449*^9}, {3.9439748152312126`*^9, 
  3.9439748186146374`*^9}, {3.9439751128406887`*^9, 3.9439751243759556`*^9}, {
  3.969144504581246*^9, 3.96914457063491*^9}, {3.9691446244028397`*^9, 
  3.9691446503791723`*^9}},ExpressionUUID->"c8f52a08-048e-b14a-9346-\
8f75bcdbb48a"],

Cell["Define binary strings:", "Text",
 CellChangeTimes->{{3.96914465685312*^9, 
  3.9691446659184217`*^9}},ExpressionUUID->"a3fe653d-3a16-4d17-8f68-\
7d2e24177704"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", "=", "\"\<01\>\""}], ";", 
  RowBox[{"b", "=", "\"\<10\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.9439751389630413`*^9, 3.943975141321228*^9}, 
   3.968248723352311*^9, {3.969144367383288*^9, 3.969144376324502*^9}, {
   3.9691445482341747`*^9, 3.969144591976397*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"cfbed90f-aae1-6e43-9ca8-92adc69a3128"],

Cell[TextData[{
 "Construct the number from the base-2 digits of ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2f0a7009-80e5-4bf4-9718-2b51119dedc3"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9691446752398167`*^9, 3.969144719524901*^9}, 
   3.969382126484251*^9},ExpressionUUID->"bcc164d0-7192-4b70-9231-\
7c7cee0f2c87"],

Cell[BoxData[
 RowBox[{"FromDigits", "[", 
  RowBox[{"a", ",", "2"}], "]"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"73e52067-0aa1-4f82-84de-7859e06df938"],

Cell[TextData[{
 "Construct the number from the base-2 digits of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f84cea9d-3309-4675-aba1-6b301340d2f8"],
 ":"
}], "Text",
 CellChangeTimes->{{3.969144689697773*^9, 3.9691446915527763`*^9}, {
   3.969144721982987*^9, 3.969144723119032*^9}, 
   3.969382128505361*^9},ExpressionUUID->"75302281-4e85-4cba-bc39-\
99aa51e81223"],

Cell[BoxData[
 RowBox[{"FromDigits", "[", 
  RowBox[{"b", ",", "2"}], "]"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"2291c198-e6b3-44b0-8a4b-1ccdb75dd3a2"],

Cell["Add the numbers using normal addition:", "Text",
 CellChangeTimes->{{3.969144693276149*^9, 3.9691446941007557`*^9}, {
  3.969144725648521*^9, 
  3.969144758615995*^9}},ExpressionUUID->"1ffc9a82-b1d1-4cd5-bcb9-\
5cb7e664559b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FromDigits", "[", 
   RowBox[{"a", ",", "2"}], "]"}], "+", 
  RowBox[{"FromDigits", "[", 
   RowBox[{"b", ",", "2"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.969144602655939*^9, 3.969144606045418*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"556c57e7-612c-417b-a08b-90dff42faae5"],

Cell["Convert the total back into bit-string:", "Text",
 CellChangeTimes->{{3.9691447298090897`*^9, 
  3.969144765466543*^9}},ExpressionUUID->"927d5a9f-86b0-465e-9fac-\
4621c3c3f275"],

Cell[BoxData[
 RowBox[{"IntegerString", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"FromDigits", "[", 
     RowBox[{"a", ",", "2"}], "]"}], "+", 
    RowBox[{"FromDigits", "[", 
     RowBox[{"b", ",", "2"}], "]"}]}], ",", "2"}], "]"}]], "Input",
 CellChangeTimes->{{3.9439751389630413`*^9, 3.943975141321228*^9}, 
   3.968248723352311*^9, {3.969144367383288*^9, 3.969144376324502*^9}, {
   3.9691445482341747`*^9, 3.969144591976397*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"68837cda-81a2-4deb-b01b-aae06ac8aa7a"],

Cell[TextData[{
 "To get a better sense of constructs of numbers in a base ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "45cb7e2e-abc8-430c-aa9f-5f6ce5c02c33"],
 ", let\[CloseCurlyQuote]s consider symbolic digits and base:"
}], "Text",
 CellChangeTimes->{{3.96992154707978*^9, 3.969921585944337*^9}, {
  3.969921661580719*^9, 3.969921666689562*^9}, {3.9699217115974092`*^9, 
  3.969921713767457*^9}, {3.969921835237812*^9, 
  3.96992184461087*^9}},ExpressionUUID->"e20c855c-0b23-452e-9e68-\
695834c12421"],

Cell[BoxData[
 RowBox[{"Expand", "[", 
  RowBox[{"FromDigits", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[FormalC]4", ",", "\[FormalC]3", ",", "\[FormalC]2", ",", 
      "\[FormalC]1", ",", "\[FormalC]0"}], "}"}], ",", "\[FormalB]"}], "]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.969921591129137*^9, 3.969921657096219*^9}, {
  3.9699763870913153`*^9, 3.969976411262271*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"2f7483b8-1b9c-48e8-b03f-ed5f628583ab"],

Cell[TextData[{
 "Donating the length of digits by ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "b24d89cb-e92f-40d0-95fe-f125be70f5d7"],
 ", the maximum power of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "061b4d8e-3838-4388-9aa7-a14f212fa1ab"],
 " will be ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["b", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "8ea8543b-f0a4-469c-be17-c18e27ab3484"],
 " (in the above example, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["b", 
    RowBox[{"5", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "6038c83f-d1be-48b4-bb18-0b17d2f26632"],
 ")."
}], "Text",
 CellChangeTimes->{{3.96992179811954*^9, 3.969921805435987*^9}, {
  3.9699218480766973`*^9, 
  3.969921889049645*^9}},ExpressionUUID->"4df5e61c-145a-422f-a0ad-\
f757fd50f96c"],

Cell["\<\
Let\[CloseCurlyQuote]s consider another example. Add two binary strings 100 \
and 011:\
\>", "Text",
 CellChangeTimes->{{3.957529225695665*^9, 3.957529246814452*^9}, {
  3.969144777531629*^9, 
  3.969144792404016*^9}},ExpressionUUID->"8b5cc1fc-c676-4bc1-8578-\
71831ce7aa72"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", "\"\<101\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "\"\<011\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"IntegerString", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"FromDigits", "[", 
     RowBox[{"a", ",", "2"}], "]"}], "+", 
    RowBox[{"FromDigits", "[", 
     RowBox[{"b", ",", "2"}], "]"}]}], ",", "2"}], "]"}]}], "Input",
 CellChangeTimes->{{3.943973148153572*^9, 3.943973163344902*^9}, 
   3.968248724384761*^9, {3.96914439781164*^9, 3.969144402152009*^9}, {
   3.969144822287341*^9, 3.96914482246059*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"5d940f7b-1282-c048-98f3-b1a198023e8e"],

Cell["\<\
Note that something interesting happened in above calculation. Pay attention \
to the string length of initial numbers and final total. The original \
bit-strings had the string length of 3 while the final answer is a four-bit \
string. Let\[CloseCurlyQuote]s dive in a bit more.\
\>", "Text",
 CellChangeTimes->{{3.96914483448178*^9, 3.969144954319531*^9}, {
  3.969382151134162*^9, 
  3.969382151939642*^9}},ExpressionUUID->"e136b1c6-cd3a-4941-8ec6-\
82303affa7cf"],

Cell["\<\
What are all the states of a sequence of three classical bits?\
\>", "Text",
 CellChangeTimes->{{3.969144955635748*^9, 
  3.96914495689016*^9}},ExpressionUUID->"e46c4e9f-b481-4515-829f-\
4cc9f9711b6a"],

Cell[BoxData[
 RowBox[{"threeBits", "=", 
  RowBox[{"Tuples", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}], ",", "3"}], "]"}]}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"8b62c238-f3af-44a6-9bae-8877574dac14"],

Cell["What are the corresponding numbers from above base-2 digits?", "Text",
 CellChangeTimes->{{3.9691449816663637`*^9, 
  3.969145011085713*^9}},ExpressionUUID->"bea08419-4d5e-4320-81a1-\
f5c161f60455"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FromDigits", "[", 
    RowBox[{"#", ",", "2"}], "]"}], "&"}], "/@", "threeBits"}]], "Input",
 CellChangeTimes->{{3.969144968059084*^9, 3.969144979777162*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"b7cc7dd1-5873-4572-9d2e-ab5d7966e305"],

Cell[TextData[{
 "With a 3-bit string you can represent 0\[Dash]7; in general, n bits \
represent 0 to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["2", "n"], "-", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "25baa1df-6198-49af-b27e-2a659358bd7b"],
 ". Returning to the example, adding 101 and 011 gives 8, which exceeds the \
3-bit range. This means in-place addition is modulo ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "n"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8d83f0c0-8151-4c25-8319-5513f4a74cd0"],
 ", so the sum wraps to 000 unless you provide an extra bit to capture the \
carry."
}], "Text",
 CellChangeTimes->{{3.969145013956876*^9, 3.969145105641533*^9}, {
  3.9691452231743402`*^9, 
  3.969145276269998*^9}},ExpressionUUID->"8f618903-72ac-4ab7-8004-\
935dfaa154cb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FromDigits", "[", 
   RowBox[{"a", ",", "2"}], "]"}], "+", 
  RowBox[{"FromDigits", "[", 
   RowBox[{"b", ",", "2"}], "]"}]}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"6e6d0d2d-5981-4b92-a174-1edf0e653e48"],

Cell["\<\
To encode that result as a bitstring, we need at least 4 bits (since 8 \
requires 4-bit representation).\
\>", "Text",
 CellChangeTimes->{{3.969145107588945*^9, 3.969145116205862*^9}, 
   3.96914529038514*^9},ExpressionUUID->"669121fe-6a47-4f88-afa5-\
c3a0914cd8b3"],

Cell[BoxData[
 RowBox[{"IntegerString", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"FromDigits", "[", 
     RowBox[{"a", ",", "2"}], "]"}], "+", 
    RowBox[{"FromDigits", "[", 
     RowBox[{"b", ",", "2"}], "]"}]}], ",", "2"}], "]"}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"14a987b7-c25e-4653-9f96-50799b4c7f16"],

Cell["\<\
If you insist on staying within 3 bits, perform all operations modulo 8 \
(wrap-around arithmetic).\
\>", "Text",
 CellChangeTimes->{{3.969145123974463*^9, 3.969145155211459*^9}, 
   3.969145318808189*^9},ExpressionUUID->"aa2f65bc-8e1e-4faf-b021-\
6d88cf5d0f9b"],

Cell[BoxData[
 RowBox[{"Mod", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"FromDigits", "[", 
     RowBox[{"a", ",", "2"}], "]"}], "+", 
    RowBox[{"FromDigits", "[", 
     RowBox[{"b", ",", "2"}], "]"}]}], ",", 
   SuperscriptBox["2", "3"]}], "]"}]], "Input",
 CellChangeTimes->{{3.9691451656294537`*^9, 3.969145169717841*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"91096470-7fe0-4c47-9414-8fe220f884a1"],

Cell["Then the 3-bit string of the above result is:", "Text",
 CellChangeTimes->{{3.9691451832817383`*^9, 3.9691451983994637`*^9}, 
   3.969145345055253*^9},ExpressionUUID->"7167b7d1-dda7-452d-97dd-\
24043f12fa07"],

Cell[BoxData[
 RowBox[{"IntegerString", "[", 
  RowBox[{"0", ",", "2", ",", "3"}], "]"}]], "Input",
 CellChangeTimes->{{3.969145179830686*^9, 3.969145181279402*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"d3d6c9a4-8e7a-4d57-a7e2-7de8c08175d5"],

Cell["Now let\[CloseCurlyQuote]s try another encoding scheme. ", "Text",
 CellChangeTimes->{{3.943975877791519*^9, 3.943975980361656*^9}, {
  3.9439796965473022`*^9, 3.943979698933319*^9}, {3.968248972255479*^9, 
  3.968248972712698*^9}, {3.968320667956229*^9, 3.968320668883841*^9}, {
  3.969145752063458*^9, 3.9691457588821774`*^9}, {3.969382656049217*^9, 
  3.969382673376566*^9}},ExpressionUUID->"1d77b50e-a3db-304f-aa85-\
2ab3763a0fd8"],

Cell["\<\
It is also possible to encode information in such sequences of classical bits \
to represent problems of interest. For example, each of those bit sequences \
could also encode letter characters with a different encoding scheme:\
\>", "Text",
 CellChangeTimes->{{3.943975877791519*^9, 3.943975980361656*^9}, {
  3.9439796965473022`*^9, 3.943979698933319*^9}, {3.968248972255479*^9, 
  3.968248972712698*^9}, {3.968320667956229*^9, 3.968320668883841*^9}, {
  3.969145752063458*^9, 3.9691457588821774`*^9}, {3.969382656049217*^9, 
  3.969382665021945*^9}},ExpressionUUID->"f566c8c9-b06c-4988-8d95-\
b4a9a64e12b4"],

Cell[BoxData[
 RowBox[{"AssociationMap", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"FromLetterNumber", "[", 
     RowBox[{"FromDigits", "[", 
      RowBox[{"#", ",", "2"}], "]"}], "]"}], "&"}], ",", "threeBits"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.943976090511446*^9, 3.943976099041807*^9}, {
   3.9439761596109524`*^9, 3.9439761931531334`*^9}, {3.9439765603870125`*^9, 
   3.9439765731799965`*^9}, {3.96832071531772*^9, 3.968320723391488*^9}, 
   3.969145375035074*^9, {3.969382684710661*^9, 3.969382690515366*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"0510e08d-d2b2-b54d-9b03-7e5a122d98fb"],

Cell["\<\
With yet another encoding scheme, those same bit sequences could represent \
colors with opacity:\
\>", "Text",
 CellChangeTimes->{{3.9439764319406433`*^9, 3.943976435914694*^9}, {
  3.9439765147070065`*^9, 
  3.943976535529358*^9}},ExpressionUUID->"3967a24a-5cf8-494b-9962-\
bb6af708d695"],

Cell[BoxData[
 RowBox[{"AssociationMap", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Apply", "[", 
     RowBox[{"RGBColor", ",", "#"}], "]"}], "&"}], ",", "threeBits"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.943976267816435*^9, 3.9439763247065144`*^9}, {
   3.943976364028818*^9, 3.9439764940098667`*^9}, {3.968321013478739*^9, 
   3.968321018923381*^9}, {3.968350897168367*^9, 3.968350900866498*^9}, 
   3.9691453765923843`*^9, {3.969382695879224*^9, 3.969382700760293*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"b627cfec-e965-3640-b6c5-5f8098f21bd4"],

Cell["\<\
Having seen how a 3-bit register cleanly enumerates eight distinct states and \
how different encodings map those states to numbers, letters, or colors, we \
now move to the quantum setting. There the same eight basis strings exist, \
but a 3-qubit register can also occupy complex superpositions of them, and \
even entangled combinations that have no classical analogue. The rules for \
storing and extracting information therefore change: measurement reveals a \
single basis outcome, while computation exploits interference among \
amplitudes.\
\>", "Text",
 CellChangeTimes->{
  3.9683563449566803`*^9, {3.9683572557095957`*^9, 
   3.968357255859674*^9}},ExpressionUUID->"884e0086-532e-488a-9c0e-\
e28ececf2723"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Quantum Circuits and Qubits", "Section",
 CellChangeTimes->{{3.943972361413595*^9, 3.943972362289095*^9}, {
  3.943980004210676*^9, 3.9439800142218227`*^9}, {3.943981958954647*^9, 
  3.943981960210518*^9}},ExpressionUUID->"61652aa0-0c19-814f-9640-\
c2fca502c7ec"],

Cell["\<\
Now we\[CloseCurlyQuote]ll dive directly into quantum computation. We\
\[CloseCurlyQuote]ll introduce common terms and concepts widely used in \
quantum information. Some details will be only briefly mentioned in this \
chapter. For each topic, we\[CloseCurlyQuote]ll highlight what to focus on \
for a first exposure, and later we\[CloseCurlyQuote]ll return to expand on \
each concept in more depth.\
\>", "Text",
 CellChangeTimes->{{3.969145406593862*^9, 3.969145492413508*^9}, 
   3.969145668650529*^9, {3.9693827740541697`*^9, 
   3.9693827781179857`*^9}},ExpressionUUID->"d6c26bd7-06bc-47d4-a913-\
ac2dd9b24390"],

Cell["\<\
In quantum computing, information is encoded in quantum states, which we \
transform into new states through some operations (i.e., quantum gates) \
tailored to a computational goal. Both states and transformations (i.e. their \
gates) have useful visual representations. In this chapter, we will emphasize \
visual intuition first and introduce the detailed mathematics later.\
\>", "Text",
 CellChangeTimes->{{3.969382790274846*^9, 3.9693828708538733`*^9}, {
  3.96938298551721*^9, 3.969382999509926*^9}, {3.969383035175404*^9, 
  3.9693830513688517`*^9}},ExpressionUUID->"e91d27aa-843c-41c4-8273-\
6e6616d328eb"],

Cell["\<\
Since we will use the Wolfram Quantum Framework, we first need to install it.\
\>", "Text",
 CellChangeTimes->{{3.968331681657031*^9, 3.968331687131729*^9}, {
  3.9729928202109547`*^9, 3.9729928607221193`*^9}},
 CellID->197945798,ExpressionUUID->"92e21df1-d3dd-4611-b04f-822cf492a928"],

Cell[BoxData[{
 RowBox[{"PacletInstall", "[", 
  RowBox[{"\"\<https://www.wolfr.am/DevWQCF\>\"", ",", 
   RowBox[{"ForceVersionInstall", "->", "True"}]}], "]"}], "\n", 
 RowBox[{"<<", "Wolfram`QuantumFramework`"}]}], "Code",
 CellChangeTimes->{{3.9388016656063175`*^9, 3.9388016757122*^9}, {
  3.957529117446884*^9, 3.957529117764634*^9}, {3.9575291526382093`*^9, 
  3.95752915355468*^9}, {3.9579616792800007`*^9, 3.9579616795817413`*^9}},
 CellLabel->"In[22]:=",
 CellID->422857783,ExpressionUUID->"92cd6bd0-dc89-4c6e-8293-6a7c40ed8fa8"],

Cell["\<\
The diagram below represents an example of a quantum circuit:\
\>", "Text",
 CellChangeTimes->{{3.943972614868759*^9, 3.943972633851406*^9}, {
   3.943982144505064*^9, 3.9439821513940983`*^9}, {3.9439824129920673`*^9, 
   3.9439824143859787`*^9}, 
   3.9691453853141613`*^9},ExpressionUUID->"c8458038-b957-2b4e-afe4-\
44d6adc6b38e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qc", "=", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<H\>\"", ",", 
      RowBox[{"\"\<Z\>\"", "->", "2"}], ",", 
      RowBox[{"\"\<Y\>\"", "->", "3"}], ",", 
      RowBox[{"\"\<P\>\"", "[", 
       RowBox[{"\[Pi]", "/", "4"}], "]"}], ",", 
      RowBox[{"\"\<CNOT\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"\"\<RY\>\"", "[", 
        RowBox[{"\[Pi]", "/", "3"}], "]"}], "->", "2"}], ",", 
      RowBox[{"\"\<CH\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}], ",", 
      RowBox[{"Range", "[", "3", "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"qc", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.957529524196439*^9, 3.95752954835086*^9}, {
  3.968357298367548*^9, 3.968357400145733*^9}, {3.968357477473527*^9, 
  3.968357573614952*^9}, {3.968358159494294*^9, 3.9683581620483227`*^9}, {
  3.968366972668634*^9, 3.968366983011613*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"84866aea-a420-44e5-ac3c-e50033ab61d3"],

Cell[TextData[{
 "A quantum circuit is read from left to right. Looking into a quantum \
circuit, pay attention to wires, boxes, and how they are connected. The first \
operation, represented by the blue box labeled H, acts only on the first \
wire, while some operations act on more than one wire; they are multi-qubit \
gates. The boxes that look like gauges on the right hand side of the diagram \
represent measurement and point to the wire labeled ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"866f10b1-6ad9-4407-b9dd-a2ca20aea295"],
 ". The wire labeled ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"06377a0e-5874-407b-b493-6d2692135c0f"],
 " represents a classical system (such as part of a regular computer) where \
the results of the measurements on qubits are stored.  All operations shown \
except for measurements are unitary and reversible, a key feature we\
\[CloseCurlyQuote]ll explore in more detail later. You can think of each box \
as performing a transformation on the quantum state of one or more wires. \
These transformations must obey fundamental principles dictated by quantum \
theory."
}], "Text",
 CellChangeTimes->{{3.9439821694494057`*^9, 3.9439823337859077`*^9}, {
  3.9439823746823597`*^9, 3.9439823906973305`*^9}, {3.943982442409975*^9, 
  3.9439824573144035`*^9}, {3.957530015143813*^9, 3.957530063927341*^9}, {
  3.957530412772526*^9, 3.957530556442133*^9}, {3.968357712780937*^9, 
  3.968357715515399*^9}, {3.9683580880848217`*^9, 3.968358129362668*^9}, {
  3.96836695810038*^9, 3.968366964045289*^9}, {3.9692148029915953`*^9, 
  3.969214803157734*^9}, {3.969218400001773*^9, 3.969218401913651*^9}, {
  3.9695434539905767`*^9, 
  3.969543467523396*^9}},ExpressionUUID->"c2cc0877-33de-415a-819c-\
bdf9a39aa442"],

Cell[TextData[{
 "Notice how the circuit diagram has several wires, labeled ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "a22d4b7c-dcff-4f24-95cf-aafad255230e"],
 ", 1, 2 and 3. Wires 1, 2 and 3 represent ",
 StyleBox["qubits",
  FontSlant->"Italic"],
 " (quantum bits) instead of classical bits. They carry quantum data. The \
above circuit is a 3-qubit system, meaning that the state can be described in \
the complex vector space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalC]", "8"], TraditionalForm]],
  ExpressionUUID->"d4311513-0eb0-4233-bf76-d568aa9b9a34"],
 ". There are 8 possible bitstrings for 3 classical bits."
}], "Text",
 CellChangeTimes->{{3.9439821694494057`*^9, 3.9439823337859077`*^9}, {
  3.9439823746823597`*^9, 3.9439823906973305`*^9}, {3.943982442409975*^9, 
  3.9439824573144035`*^9}, {3.957530015143813*^9, 3.957530063927341*^9}, {
  3.957530412772526*^9, 3.957530556442133*^9}, {3.968357712780937*^9, 
  3.9683578496356707`*^9}, {3.9683580608999653`*^9, 3.9683580699043922`*^9}, {
  3.968366827574884*^9, 3.968366829659004*^9}, {3.968366883609589*^9, 
  3.968366941986843*^9}, {3.969145520772183*^9, 3.969145610982215*^9}, {
  3.9692184790187483`*^9, 3.96921851918047*^9}, {3.969543553036929*^9, 
  3.969543566638479*^9}},ExpressionUUID->"4a031169-5249-2544-9b9f-\
613b92e183b8"],

Cell[BoxData[
 RowBox[{"StringJoin", "/@", 
  RowBox[{"Tuples", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<0\>\"", ",", "\"\<1\>\""}], "}"}], ",", "3"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.969218495261661*^9, 3.969218499780254*^9}, {
  3.969218532404332*^9, 3.969218538124001*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"9d44faf4-647a-406c-912f-910e252633ef"],

Cell[TextData[{
 "These eight classical bits can form a convenient basis (usually called as \
the computational basis) for the complex vector space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalC]", "8"], TraditionalForm]],
  ExpressionUUID->"83f40328-d9b1-4677-8288-135046017d09"],
 ". Although the notation looks very similar to the classical one, but those \
3-bits in quantum are represented by wrapping them around a notation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"\[Ellipsis]"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "6d27e4a7-0cec-4ab9-8ce7-bc709606c445"],
 " which is called a ket. In general, a ket is a shorthand representation of \
a complex-valued vector, although a ket with n-bitstring represents a ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bbd2ad06-400f-4826-8c45-064844a0237e"],
 "-dimensional unit vector. A general 3-qubit state is a complex linear \
combination of those eight basis states. "
}], "Text",
 CellChangeTimes->{{3.9439821694494057`*^9, 3.9439823337859077`*^9}, {
  3.9439823746823597`*^9, 3.9439823906973305`*^9}, {3.943982442409975*^9, 
  3.9439824573144035`*^9}, {3.957530015143813*^9, 3.957530063927341*^9}, {
  3.957530412772526*^9, 3.957530556442133*^9}, {3.968357712780937*^9, 
  3.9683578496356707`*^9}, {3.9683580608999653`*^9, 3.9683580699043922`*^9}, {
  3.968366827574884*^9, 3.968366829659004*^9}, {3.968366883609589*^9, 
  3.968366941986843*^9}, {3.969145520772183*^9, 3.969145610982215*^9}, {
  3.9692185484095984`*^9, 3.96921856616612*^9}, {3.969383211093018*^9, 
  3.969383216343801*^9}, {3.969543596416368*^9, 3.9695436001291*^9}, {
  3.969543637037407*^9, 
  3.96954370339006*^9}},ExpressionUUID->"a63fecf1-7ced-4d34-bcad-\
b5510707fd17"],

Cell["\<\
Show the vectors corresponding to computational basis of 3-qubits:\
\>", "Text",
 CellChangeTimes->{{3.9695437084291267`*^9, 
  3.969543726785412*^9}},ExpressionUUID->"3f1f4a9b-0b46-4e17-880b-\
3725a209b865"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TraditionalForm", "[", "#", "]"}], "->", 
    RowBox[{"MatrixForm", "[", 
     RowBox[{"#", "[", "\"\<StateVector\>\"", "]"}], "]"}]}], "&"}], "/@", 
  RowBox[{
   RowBox[{"QuantumBasis", "[", 
    RowBox[{"2", ",", "3"}], "]"}], "[", "\"\<BasisStates\>\"", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.968366836645527*^9, 3.9683668701610527`*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"5722b9af-0d92-4c9e-9162-344160140c42"],

Cell["\<\
The quantum state of the above circuit, just before measurement, is:\
\>", "Text",
 CellChangeTimes->{{3.969218621252866*^9, 
  3.969218650357937*^9}},ExpressionUUID->"7dc90885-7542-4bbb-afc1-\
57b808818fa0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<H\>\"", ",", 
      RowBox[{"\"\<Z\>\"", "->", "2"}], ",", 
      RowBox[{"\"\<Y\>\"", "->", "3"}], ",", 
      RowBox[{"\"\<P\>\"", "[", 
       RowBox[{"\[Pi]", "/", "4"}], "]"}], ",", 
      RowBox[{"\"\<CNOT\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}]}], ",", 
      RowBox[{
       RowBox[{"\"\<RY\>\"", "[", 
        RowBox[{"\[Pi]", "/", "3"}], "]"}], "->", "2"}], ",", 
      RowBox[{"\"\<CH\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}]}], "}"}], "]"}], "[", "]"}], "//", 
  "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.969218605289895*^9, 3.969218614368864*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"94405d0a-e03d-4d0a-b69f-30877e87b360"],

Cell["\<\
The above representation illustrates quantum superposition, which is a linear \
combination of multiple states with coefficients that, in general, can be \
complex numbers.\
\>", "Text",
 CellChangeTimes->{{3.9695437430874653`*^9, 
  3.969543788336948*^9}},ExpressionUUID->"20e92dac-106a-4621-8b2b-\
743db98cd856"],

Cell["\<\
What are the results of running this circuit? Since measurements are included \
at the end, executing the circuit returns a quantum measurement object in the \
Wolfram Quantum Framework. This object contains the probability distribution \
over possible bitstrings and can be sampled to generate measurement outcomes:\
\>", "Text",
 CellChangeTimes->{{3.943982689513254*^9, 3.943982706497854*^9}, {
  3.968366996151743*^9, 3.9683670329389753`*^9}, {3.968367096294526*^9, 
  3.968367098183414*^9}},ExpressionUUID->"076fa3e9-781f-ed4e-ac2c-\
c86058287362"],

Cell[BoxData[
 RowBox[{"measurements", "=", 
  RowBox[{"qc", "[", "]"}]}]], "Input",
 CellChangeTimes->{{3.943982708587412*^9, 3.9439827219942207`*^9}, {
  3.9683669900956297`*^9, 3.968366990406784*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"2403026f-cc65-bd45-92f1-6201b92fb7b9"],

Cell["\<\
Note that by executing the code above, we simulated a quantum computation on \
a classical computer. This is exactly what a quantum simulator does: it \
numerically emulates quantum state evolution and measurement according to the \
rules of quantum mechanics, all while running on classical hardware. \
\>", "Text",
 CellChangeTimes->{{3.957530120778124*^9, 3.9575301959084473`*^9}, {
   3.968367043786579*^9, 3.968367060459832*^9}, 3.9683671313753767`*^9, {
   3.96921867846275*^9, 3.969218678574842*^9}, {3.969922080299129*^9, 
   3.969922121648093*^9}},ExpressionUUID->"45438745-2779-4d5b-94ba-\
641907daaeca"],

Cell[TextData[{
 StyleBox["Alarm",
  FontSlant->"Italic"],
 ": saying we \[OpenCurlyDoubleQuote]performed a quantum computation\
\[CloseCurlyDoubleQuote] can be misleading, simulators do not provide quantum \
speedups, are limited by exponential memory growth with qubit count, and only \
capture noise or device effects if those are explicitly modeled."
}], "Text",
 CellChangeTimes->{{3.957530120778124*^9, 3.9575301959084473`*^9}, {
   3.968367043786579*^9, 3.968367060459832*^9}, 3.9683671313753767`*^9, {
   3.96921867846275*^9, 3.969218678574842*^9}, {3.969922080299129*^9, 
   3.9699221007471743`*^9}},ExpressionUUID->"d8c1c40d-a6b9-4ab2-b020-\
6cc1c9b5244b"],

Cell["What are the results of the measurement in this circuit?", "Text",
 CellChangeTimes->{{3.943982730186865*^9, 3.9439827606076984`*^9}, {
   3.9439828060370903`*^9, 3.943982827393881*^9}, 
   3.968367114340959*^9},ExpressionUUID->"62b8348d-7579-fb47-9b2e-\
10e0f005ee4c"],

Cell[BoxData[
 RowBox[{"measurements", "[", 
  RowBox[{"\"\<ProbabilitiesPlot\>\"", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["3", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["464", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    AspectRatio -> 1/4, PlotRange -> {All, 1}, GridLines -> Automatic],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellChangeTimes->{{3.943982829725235*^9, 3.9439828494901466`*^9}, {
  3.968367680437643*^9, 3.968367684091146*^9}, {3.969145802403194*^9, 
  3.9691458522093554`*^9}, {3.9699220123623133`*^9, 3.969922025806185*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"b8b6bcb5-d587-0247-9c68-43b503e3cbb3"],

Cell["\<\
Notice that the possible outcomes of a quantum measurement are simply \
classical bit sequences. In the earlier classical computation examples, the \
rules were deterministic: each input led to a definite output. In contrast, \
quantum computation typically yields a range of possible outcomes, each with \
a certain probability. This is because quantum theory provides a \
probabilistic description of measurement results, with the distribution \
determined by the state just before measurement (and the chosen measurement \
basis).\
\>", "Text",
 CellChangeTimes->{{3.943982872601225*^9, 3.943982890834156*^9}, {
   3.943982923745205*^9, 3.9439829311691704`*^9}, {3.943982982178404*^9, 
   3.9439829840484314`*^9}, {3.943983020865259*^9, 3.943983065609167*^9}, {
   3.9439861923440266`*^9, 3.9439861943526573`*^9}, {3.9439863312318363`*^9, 
   3.943986331237522*^9}, {3.943986377049164*^9, 3.9439864451587048`*^9}, {
   3.9439865692097073`*^9, 3.943986601111809*^9}, {3.957530229080387*^9, 
   3.957530284346143*^9}, 
   3.968367165750613*^9},ExpressionUUID->"7577e0b1-3068-134f-8979-\
591641495302"],

Cell["\<\
Additionally, you can compute how the quantum state evolves as gates are \
applied. Although we have not yet discussed the state in full detail, for now \
focus on the linear combination of computational-basis bitstrings and examine \
the coefficient (amplitude) of each term. These amplitudes update linearly \
under gates, and their  squared magnitudes determine the probabilities of the \
corresponding bitstrings upon measurement.\
\>", "Text",
 CellChangeTimes->{{3.968367550245884*^9, 3.9683676538850393`*^9}, {
  3.9695457285005503`*^9, 
  3.969545761145649*^9}},ExpressionUUID->"4aca6045-4224-47fb-a8f5-\
b5986439f644"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<Initial\>\"", ",", "\"\<H\>\"", ",", "\"\<Z\>\"", 
          ",", "\"\<Y\>\"", ",", "\"\<P[\[Pi]/4]\>\"", ",", "\"\<CNOT\>\"", 
          ",", "\"\<RY[\[Pi]/3]\>\"", ",", "\"\<CH\>\"", 
          ",", "\"\<Measurements\>\""}], "}"}], ",", 
        RowBox[{"TraditionalForm", "/@", 
         RowBox[{"FoldList", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#2", "[", "#1", "]"}], "&"}], ",", 
           RowBox[{"QuantumState", "[", "\"\<000\>\"", "]"}], ",", 
           RowBox[{"qc", "[", "\"\<Operators\>\"", "]"}]}], "]"}]}]}], "}"}], 
      "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
      RowBox[{"{", 
       RowBox[{"\"\<Step\>\"", ",", "\"\<State\>\""}], "}"}]}]}], "]"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", "Left"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.968367262852467*^9, 3.9683673485066643`*^9}, {
  3.968367378550024*^9, 3.968367387128139*^9}, {3.968367443796925*^9, 
  3.9683675140760813`*^9}, {3.969145876702632*^9, 3.969145900262471*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"1e55fff4-3ef6-45b2-9b70-48716a08cb92"],

Cell["\<\
Keep in mind that, in the end, the most important information we extract from \
a quantum system is its measurement results (and their statistics). We will \
discuss this in more detail in future chapters.\
\>", "Text",
 CellChangeTimes->{{3.968367709448031*^9, 
  3.9683677587698517`*^9}},ExpressionUUID->"3db49073-0d39-48cf-bd61-\
dd38882d248f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Quantum States: Single Particle Case", "Chapter",
 CellChangeTimes->{{3.944662887397749*^9, 3.944662891885006*^9}, 
   3.9446629743009224`*^9, 3.968337128953205*^9, {3.9683495172391033`*^9, 
   3.968349528261919*^9}, {3.968350690875737*^9, 
   3.968350696600904*^9}},ExpressionUUID->"71e038ee-1a8c-45f4-94da-\
965b81565035"],

Cell["\<\
We review quantum states for a single system: state vectors, amplitudes, and \
measurement probabilities. We then contrast pure and mixed states and \
describe both with the density matrix. Finally, we extend these ideas to \
higher-dimensional systems.\
\>", "Text",
 CellChangeTimes->{{3.9683351418507547`*^9, 3.968335145248692*^9}, {
  3.968337132871228*^9, 3.968337135575295*^9}, {3.969191518099367*^9, 
  3.969191524885049*^9}, {3.969194016920123*^9, 
  3.969194070910001*^9}},ExpressionUUID->"78c5b244-142b-4169-9c60-\
5707d626bad1"],

Cell[CellGroupData[{

Cell["Key Concepts", "Section",
 CellChangeTimes->{{3.9442479373933716`*^9, 
  3.944247939017521*^9}},ExpressionUUID->"63e58b8a-9763-4af7-aae1-\
8d50adede157"],

Cell["Quantum State", "Item",
 CellChangeTimes->{{3.944247943963133*^9, 3.9442479547025547`*^9}, {
  3.9692096129861*^9, 3.969209613959612*^9}, {3.969215665384672*^9, 
  3.969215665814069*^9}},ExpressionUUID->"9e1d1465-79e9-4775-aa3c-\
f967e28cd5b8"],

Cell["Amplitudes", "Item",
 CellChangeTimes->{{3.944247943963133*^9, 3.9442479547025547`*^9}, {
  3.9692096129861*^9, 
  3.969209616062599*^9}},ExpressionUUID->"1b7e2317-f059-4883-9293-\
f26c5e18fc5d"],

Cell["State Vector", "Item",
 CellChangeTimes->{{3.944247943963133*^9, 3.944247958262329*^9}, {
  3.969209617549993*^9, 
  3.969209617553173*^9}},ExpressionUUID->"3b052d06-3174-4003-a385-\
4fb0159a4ad9"],

Cell["Dirac Notation", "Item",
 CellChangeTimes->{{3.944247943963133*^9, 3.944247958262329*^9}, {
  3.9692096178934317`*^9, 3.96920962072692*^9}, {3.9692156673008947`*^9, 
  3.9692156681387444`*^9}},ExpressionUUID->"e3593dcb-bfad-42a2-9d53-\
0f30aa24a694"],

Cell["Bloch Sphere", "Item",
 CellChangeTimes->{{3.944247943963133*^9, 3.944247958262329*^9}, {
   3.9692096178934317`*^9, 3.969209623802299*^9}, 
   3.969215669871564*^9},ExpressionUUID->"bd9136ce-f495-4e1b-a686-\
0032cf6c958b"],

Cell["Density Matrix", "Item",
 CellChangeTimes->{{3.944247943963133*^9, 3.944247960345806*^9}, {
  3.969215655334257*^9, 
  3.9692156553402576`*^9}},ExpressionUUID->"125f22f1-7b6a-488c-9294-\
aa5598d59bf8"],

Cell["Pure vs Mixed States", "Item",
 CellChangeTimes->{{3.944247943963133*^9, 3.944247960345806*^9}, {
  3.9692156559278173`*^9, 
  3.969215661122088*^9}},ExpressionUUID->"6743e129-174b-4237-a05c-\
64a196a7741c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bloch Sphere", "Section",
 CellChangeTimes->{{3.9440475021974297`*^9, 3.944047505718235*^9}, {
  3.969146225774037*^9, 
  3.9691462276387568`*^9}},ExpressionUUID->"08b90d02-2b7d-46f3-995c-\
882ebc641df0"],

Cell[TextData[{
 "Qubits are not classical bits, so listing classical bitstrings does not \
capture all possible qubit states. How are quantum states represented \
instead? Let\[CloseCurlyQuote]s begin with some visual intuition. There is a \
very useful graphical representation of 1-qubit states called the ",
 StyleBox["Bloch sphere",
  FontWeight->"Bold"],
 ". The Bloch sphere is named after physicist Felix Bloch:"
}], "Text",
 CellChangeTimes->{{3.9440496212436543`*^9, 3.9440497194843063`*^9}, {
