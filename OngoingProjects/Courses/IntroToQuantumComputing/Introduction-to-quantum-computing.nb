   3.9727457397867002`*^9}, {3.972745784187604*^9, 3.9727461652489643`*^9}, 
   3.9727587948902493`*^9, {3.9727588331764393`*^9, 3.972758886233058*^9}, 
   3.97275895087918*^9, 3.972759016885765*^9, {3.972759097204844*^9, 
   3.972759101626071*^9}, {3.9727591647865353`*^9, 3.972759180946187*^9}, {
   3.972759224871635*^9, 3.972759292786913*^9}, {3.972864693679776*^9, 
   3.972864694483699*^9}, 3.972864757904031*^9, {3.972864875324576*^9, 
   3.972864938460663*^9}},
 CellLabel->"In[57]:=",
 CellID->485338474,ExpressionUUID->"8b1bd39a-6503-4911-8fca-9f0f364cc870"],

Cell[TextData[{
 "In such cases, a state vector cannot fully describe the system. Instead, we \
use a density matrix (or density operator). The demonstration above is \
modified from ",
 ButtonBox["an example",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://demonstrations.wolfram.com/SternGerlachExperiment/"], None},
  ButtonNote->"https://demonstrations.wolfram.com/SternGerlachExperiment/"],
 " in the Wolfram Demonstration Project."
}], "Text",
 CellChangeTimes->{{3.968336180816654*^9, 3.968336333105896*^9}, {
  3.96833641651585*^9, 3.968336426887816*^9}, {3.9699222981726007`*^9, 
  3.969922348205235*^9}},ExpressionUUID->"5d868c0f-c8ac-46fa-bf54-\
86e0daa8d3a4"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s explore why a state vector description fails for the \
Stern-Gerlach experiment above. Let\[CloseCurlyQuote]s assume that there is a \
state vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]], 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"c7e4074e-8849-4282-a80a-10890e2a84d4"],
 " that can generate probabilities ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "/", "2"}], ",", 
     RowBox[{"1", "/", "2"}]}], "}"}], TraditionalForm]],ExpressionUUID->
  "11910832-9ac1-4998-85c0-5acb90863025"],
 " for any measurement in any basis. Note that our state vector is the most \
generic one."
}], "Text",
 CellChangeTimes->{{3.969146835141946*^9, 3.9691468869870462`*^9}, {
  3.969146968195284*^9, 3.9691469908295*^9}, {3.969147290821661*^9, 
  3.969147308827001*^9}, {3.969190404489246*^9, 3.9691904272221737`*^9}, {
  3.969190995879527*^9, 3.96919100922052*^9}, {3.969219431577764*^9, 
  3.96921944236138*^9}, {3.9695468723599443`*^9, 
  3.969546872849813*^9}},ExpressionUUID->"d950993a-10bf-4a36-92aa-\
31026d92d99b"],

Cell["Generate a state using above state vector:", "Text",
 CellChangeTimes->{{3.969147310211038*^9, 3.969147317148527*^9}, {
  3.969191016835989*^9, 
  3.969191022441889*^9}},ExpressionUUID->"f11f1614-3e15-4ba6-9bae-\
1feb5813e9f4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", "\[Phi]"}], "}"}], "\[Element]", "Reals"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"state", "=", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]], 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9691468897534323`*^9, 3.9691469227252903`*^9}, {
  3.969147002001458*^9, 3.9691470724258127`*^9}, {3.969147134131955*^9, 
  3.969147143204081*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"a3e42d5a-f743-46d7-a8b0-b4957bf4faea"],

Cell["\<\
Compute the measurement probabilities in the computational basis:\
\>", "Text",
 CellChangeTimes->{{3.9691473193842697`*^9, 3.96914732680081*^9}, {
  3.96914736125454*^9, 
  3.9691473630301857`*^9}},ExpressionUUID->"cc64ef34-085e-4b3b-a43f-\
0ed4d63e8c8f"],

Cell[BoxData[
 RowBox[{"FullSimplify", "/@", 
  RowBox[{"state", "[", "\"\<ProbabilitiesList\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.9691468897534323`*^9, 3.9691469227252903`*^9}, {
  3.969147002001458*^9, 3.9691470724258127`*^9}},
 CellLabel->"In[60]:=",ExpressionUUID->"d37cd83a-7e52-47db-9063-2fceb71899d9"],

Cell[TextData[{
 "Imposing the condition that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"Cos", "[", 
      FractionBox["\[Theta]", "2"], "]"}], "2"], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Sin", "[", 
       FractionBox["\[Theta]", "2"], "]"}], "2"], "=", 
     RowBox[{"1", "/", "2"}]}]}], TraditionalForm]],ExpressionUUID->
  "c1371768-9e3d-4ef8-9784-c316cf3b7bb2"],
 " implies that \[Theta] can be ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", "\[Pi]"}], "/", "2"}], TraditionalForm]],
  ExpressionUUID->"b7f1b6b7-eb5a-43ce-91b6-916fce86fa58"]
}], "Text",
 CellChangeTimes->{{3.9691472113390417`*^9, 3.969147212314166*^9}, {
  3.969147366938719*^9, 
  3.9691474169935007`*^9}},ExpressionUUID->"b3e80f6c-2043-4ee3-9a35-\
eaafc7499055"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"Cos", "[", 
        FractionBox["\[Theta]", "2"], "]"}], "2"], "==", 
      RowBox[{"1", "/", "2"}]}], "&&", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Sin", "[", 
        FractionBox["\[Theta]", "2"], "]"}], "2"], "==", 
      RowBox[{"1", "/", "2"}]}], "&&", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], "<=", "\[Theta]", "<=", "\[Pi]"}]}], ",", 
    "\[Theta]"}], "]"}], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.9695469048756742`*^9, 3.969547027548047*^9}},
 CellLabel->"In[61]:=",ExpressionUUID->"fae4e3c5-af4b-46a0-8b8a-ef72bf627458"],

Cell["\<\
Using this result, now compute the measurement probabilities in the Pauli-X \
basis:\
\>", "Text",
 CellChangeTimes->{{3.9691474293453503`*^9, 
  3.96914744314709*^9}},ExpressionUUID->"038c4ac1-8009-4425-b1d7-\
ff6254e0cab4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"state", ",", "\"\<X\>\""}], "]"}], 
    "[", "\"\<ProbabilitiesList\>\"", "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", "->", 
     RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], "//", "FullSimplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"state", ",", "\"\<X\>\""}], "]"}], 
    "[", "\"\<ProbabilitiesList\>\"", "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", "->", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], "/", "2"}]}], "}"}]}], "//", 
  "FullSimplify"}]}], "Input",
 CellChangeTimes->{{3.9691469284870243`*^9, 3.969146933101437*^9}, {
  3.969147057180847*^9, 3.96914707929736*^9}, {3.969147214194784*^9, 
  3.969147236242988*^9}, {3.969147487913949*^9, 3.9691474958666763`*^9}, {
  3.969189437604562*^9, 3.96918944216164*^9}},
 CellLabel->"In[62]:=",ExpressionUUID->"214b2144-3008-41b9-a658-da3afebba104"],

Cell[TextData[{
 "Imposing the condition that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"Cos", "[", 
      FractionBox["\[Phi]", "2"], "]"}], "2"], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Sin", "[", 
       FractionBox["\[Phi]", "2"], "]"}], "2"], "=", 
     RowBox[{"1", "/", "2"}]}]}], TraditionalForm]],ExpressionUUID->
  "685b4798-971e-4019-afe3-c8eea6e62c49"],
 " implies that \[Phi] can be ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", "\[Pi]"}], "/", "2"}], TraditionalForm]],
  ExpressionUUID->"bf863c8a-ee25-478e-bc3e-f66d4a849ee8"],
 ". If we impose this condition into the measurement probabilities in the \
Pauli-Y basis, one finds:"
}], "Text",
 CellChangeTimes->{{3.9691474576192904`*^9, 3.969147475737254*^9}, {
  3.969147509363175*^9, 
  3.9691475310792313`*^9}},ExpressionUUID->"67bb5e75-c500-467a-940b-\
f3809c2fc273"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{"state", ",", "\"\<Y\>\""}], "]"}], 
   "[", "\"\<ProbabilitiesList\>\"", "]"}], "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Theta]", "->", 
     RowBox[{"\[Pi]", "/", "2"}]}], ",", 
    RowBox[{"\[Phi]", "->", 
     RowBox[{"\[Pi]", "/", "2"}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{
  3.969147086719059*^9, {3.969147254434245*^9, 3.969147268686232*^9}, 
   3.969189429337595*^9},
 CellLabel->"In[64]:=",ExpressionUUID->"da59fee5-1223-4c16-b987-bafb3878fc74"],

Cell["\<\
The result shows that this pure state cannot yield 1/2 measurement \
probabilities in every basis. This motivates the more general description of \
quantum states using a density matrix. For example, let\[CloseCurlyQuote]s \
define a state by half of identify matrix:\
\>", "Text",
 CellChangeTimes->{{3.969147534488616*^9, 3.969147624281261*^9}, {
  3.9691476886871243`*^9, 3.969147689958804*^9}, {3.96918946425395*^9, 
  3.969189482119322*^9}},ExpressionUUID->"de184868-d85a-4ebb-a758-\
fb798a7f912d"],

Cell[BoxData[
 RowBox[{"\[Rho]", "=", 
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{"IdentityMatrix", "[", "2", "]"}], "/", "2"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.968336335000621*^9, 3.9683363478709717`*^9}, {
   3.9691477339293127`*^9, 3.969147737935574*^9}, 3.969147788026552*^9, {
   3.969191058991027*^9, 3.969191061066463*^9}},
 CellLabel->"In[65]:=",ExpressionUUID->"bcf99794-e751-4ca8-aa15-8b64988ae8ae"],

Cell["\<\
Notice the tag \[OpenCurlyDoubleQuote]Mixed state\[CloseCurlyDoubleQuote] in \
the summary box of quantum state above.\
\>", "Text",
 CellChangeTimes->{{3.968336352760755*^9, 
  3.9683363666319723`*^9}},ExpressionUUID->"c6eb0fa4-e89f-4647-a913-\
5a94b1879489"],

Cell["\<\
The Dirac notation of the state is simply the density matrix written in the \
computational basis.\
\>", "Text",
 CellChangeTimes->{{3.969189510016486*^9, 3.9691895341507673`*^9}, {
  3.969189573267332*^9, 
  3.969189581708716*^9}},ExpressionUUID->"3564ef47-323f-409a-9002-\
4d430f028318"],

Cell[BoxData[
 RowBox[{"\[Rho]", "//", "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.969189487963122*^9, 3.969189490663292*^9}},
 CellLabel->"In[66]:=",ExpressionUUID->"60f2d691-b5d2-404a-a02c-48e51c316ece"],

Cell["\<\
Now we can show that the measurement probabilities are the same in every \
basis and equal to 1/2.\
\>", "Text",
 CellChangeTimes->{{3.969189587261064*^9, 
  3.9691896378677473`*^9}},ExpressionUUID->"0beb001f-e401-4dfa-8b33-\
f2fa5bf857ba"],

Cell[BoxData[{
 RowBox[{"\[Rho]", "[", "\"\<Probabilities\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"\[Rho]", ",", "\"\<X\>\""}], "]"}], "[", "\"\<Probabilities\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"\[Rho]", ",", "\"\<Y\>\""}], "]"}], "[", "\"\<Probabilities\>\"", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9691477458685904`*^9, 3.969147803140994*^9}, {
  3.969189560032839*^9, 3.9691895607604*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"3bb94c4d-1950-40f5-ac85-d3f889346b93"],

Cell["\<\
An interesting feature of mixed states is that they lie inside the Bloch \
sphere, whereas pure states (those describable by a single 2-vector) lie only \
on the surface.\
\>", "Text",
 CellChangeTimes->{{3.968336479932291*^9, 
  3.968336533679487*^9}},ExpressionUUID->"66043a51-b335-4ac9-812c-\
dbc2f11e11d3"],

Cell["Show the Bloch vector of a mixed state:", "Text",
 CellChangeTimes->{{3.969191086224368*^9, 
  3.969191097970159*^9}},ExpressionUUID->"243b82a1-3c93-4110-8feb-\
4efe7db6ce70"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{".3", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", ".7"}], "}"}]}], "}"}], "]"}], "[", 
  RowBox[{"\"\<BlochPlot\>\"", ",", 
   RowBox[{"ImageSize", "->", "200"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.968336473047328*^9, 3.968336476223527*^9}, {
  3.969147643578557*^9, 3.9691476518593483`*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"25654cc5-3a46-4896-a597-13e66c88c187"],

Cell[TextData[{
 "For pure states, the Bloch vector lies on the unit sphere (",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "7adfedfa-650d-478b-a927-9c090abe1329"],
 "); for mixed states, it lies inside the sphere (",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<=", "r", "<", "1"}], TraditionalForm]],ExpressionUUID->
  "9766b6a0-e5bb-4203-a4ec-8ed1916dd8e1"],
 "). "
}], "Text",
 CellChangeTimes->{
  3.969209494257339*^9},ExpressionUUID->"c0bbe9b1-e62e-4ddb-b963-\
6099646cbe56"],

Cell[TextData[{
 "One can quantify if a state in pure or mixed. One measure is ",
 StyleBox["purity",
  FontSlant->"Italic"],
 " which is defined as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Tr", "[", 
    SuperscriptBox["\[Rho]", "2"], "]"}], TraditionalForm]],ExpressionUUID->
  "d2394dc7-847c-4c57-9764-659c804182c6"],
 ". For a pure state, purity will be 1, while mixed states have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Tr", "[", 
     SuperscriptBox["\[Rho]", "2"], "]"}], "<", "1"}], TraditionalForm]],
  ExpressionUUID->"540cebc8-577d-456c-9901-ade0784c4158"],
 ". In the Wolfram quantum framework, \[OpenCurlyDoubleQuote]Purity\
\[CloseCurlyDoubleQuote] is a another property of a quantum state object:"
}], "Text",
 CellChangeTimes->{{3.968336665718457*^9, 3.9683367466978483`*^9}, {
  3.969189660346922*^9, 3.969189666122622*^9}, {3.969219543936561*^9, 
  3.9692195592252398`*^9}, {3.971796735242351*^9, 
  3.97179673679226*^9}},ExpressionUUID->"d6caaefb-9687-47ea-91fb-\
7849ee18d5bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{".3", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", ".7"}], "}"}]}], "}"}], "]"}], "[", "\"\<Purity\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{3.9683366598153048`*^9, 3.968336661636284*^9}},
 CellLabel->"In[71]:=",ExpressionUUID->"a76d72f0-7f28-41a3-aab5-1973ab4e16f2"],

Cell["Calculate purity for a pure state:", "Text",
 CellChangeTimes->{{3.9683367598739977`*^9, 
  3.968336772838354*^9}},ExpressionUUID->"f52b839e-3f92-47c9-a608-\
6113263b2cfc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{".3", ",", ".7"}], "}"}], "]"}], "[", "\"\<Purity\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{3.96833675260566*^9, 3.968336757240897*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"8f92d97b-4152-4084-81c1-f9f3a9a56ee1"],

Cell["\<\
In summary, when thinking about the state of a qubit, you can view it in \
several equivalent ways:\
\>", "Text",
 CellChangeTimes->{{3.968252243579061*^9, 3.968252249263452*^9}, {
  3.968368805890511*^9, 3.968368925357162*^9}, {3.969208717016086*^9, 
  3.969208720243174*^9}},ExpressionUUID->"5810f1eb-e229-470f-8ae1-\
ae7994e5a40e"],

Cell["\<\
As a linear combination (a complex-valued 2-vector) in a given basis.\
\>", "Item",
 CellChangeTimes->{{3.968252243579061*^9, 3.968252249263452*^9}, {
  3.968368805890511*^9, 3.968368933290875*^9}, {3.969219581341344*^9, 
  3.969219583669271*^9}},ExpressionUUID->"3881396c-edf5-45a1-975d-\
89a05962a78d"],

Cell["\<\
As a real-valued 3-vector representing Cartesian coordinates of the Bloch \
vector {x,y,z}.\
\>", "Item",
 CellChangeTimes->{{3.968252243579061*^9, 3.968252249263452*^9}, {
  3.968368805890511*^9, 3.96836893692949*^9}, {3.96921959085008*^9, 
  3.9692195933975487`*^9}},ExpressionUUID->"f88b0cb2-225e-4cd6-bb08-\
fa6ac1779f2a"],

Cell["As the same point in spherical coordinates {r,\[Phi],\[Theta]}.", "Item",
 CellChangeTimes->{{3.968252243579061*^9, 3.968252249263452*^9}, {
  3.968368805890511*^9, 
  3.968368974687212*^9}},ExpressionUUID->"2e13d496-e2ec-4480-9495-\
07ca8322dd7a"],

Cell["Generate different representations of a random state:", "Text",
 CellChangeTimes->{{3.969208240002331*^9, 
  3.96920825520531*^9}},ExpressionUUID->"3cf50e24-6ba3-4efa-9322-\
9e6956fcaa2c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"state", "=", 
   RowBox[{"QuantumState", "[", "\"\<RandomPure\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Dirac notation\>\"", ",", "\"\<State vector\>\"", 
        ",", "\"\<Bloch vector\>\"", 
        ",", "\"\<Bloch spherical coordinates\>\"", 
        ",", "\"\<Bloch plot\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"TraditionalForm", "[", "state", "]"}], ",", 
        RowBox[{"state", "[", "\"\<AmplitudesList\>\"", "]"}], ",", 
        RowBox[{"state", "[", "\"\<BlochVector\>\"", "]"}], ",", 
        RowBox[{"state", "[", "\"\<BlochSphericalCoordinates\>\"", "]"}], ",", 
        RowBox[{"state", "[", "\"\<BlochPlot\>\"", "]"}]}], "}"}]}], "}"}], 
    "]"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", "Left"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9682521468500633`*^9, 3.968252211843398*^9}, {
  3.9682522549792337`*^9, 3.968252363188429*^9}, {3.968252394906034*^9, 
  3.9682525631200523`*^9}, {3.968252594549803*^9, 3.968252607281949*^9}, {
  3.969208176557393*^9, 3.969208208771456*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"bcd8ce7f-2624-4d8f-bcbb-778963910124"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Pauli operators and Bloch sphere", "Section",
 CellChangeTimes->{{3.9442451048009415`*^9, 3.944245107049162*^9}, {
  3.968350708512014*^9, 3.968350718366518*^9}, {3.969547180411371*^9, 
  3.969547187408568*^9}, {3.969977058673444*^9, 
  3.969977059091486*^9}},ExpressionUUID->"e8aa0d04-c3d8-4f07-82b2-\
9f517bb3ffe9"],

Cell["\<\
Pauli operators provide a natural choice for representation of the density \
matrix:\
\>", "Text",
 CellChangeTimes->{{3.968369882563518*^9, 
  3.968369908930602*^9}},ExpressionUUID->"c9ec8db5-3763-4f4b-930d-\
5da0affb5fc9"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<X or \!\(\*SubscriptBox[\(\[Sigma]\), \(x\)]\) or \
\!\(\*SubscriptBox[\(\[Sigma]\), \(1\)]\)\>\"", 
          ",", "\"\<Y or \!\(\*SubscriptBox[\(\[Sigma]\), \(y\)]\) or \
\!\(\*SubscriptBox[\(\[Sigma]\), \(2\)]\)\>\"", 
          ",", "\"\<Z or \!\(\*SubscriptBox[\(\[Sigma]\), \(z\)]\) or \
\!\(\*SubscriptBox[\(\[Sigma]\), \(3\)]\)\>\""}], "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"MatrixForm", "@", 
           RowBox[{"PauliMatrix", "[", "k", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
      RowBox[{"{", 
       RowBox[{"\"\<Notation\>\"", ",", "\"\<Matrix\>\""}], "}"}]}]}], "]"}], 
   ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.968369917814907*^9, 3.96837000804033*^9}, {
  3.969189689093987*^9, 3.969189711967547*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"2f0cf858-fd7e-40d9-ac90-ae8eb7fa97e0"],

Cell[TextData[{
 "For a given matrix A, if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", " ", "x"}], "=", 
    RowBox[{"a", " ", "x"}]}], TraditionalForm]],ExpressionUUID->
  "10b66031-adfd-4d95-bcea-7f673f63a073"],
 ", then ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "e14d49b1-78eb-46a9-84a1-f3094b6fd5d2"],
 " is called an eigenstate (eigenvector) corresponding to the eigenvalue ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "67d816e3-65d7-47dc-b24a-e7d8d3a96f9a"],
 ". If ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "92e39387-7cbe-40c8-95f8-ab47bbb091f0"],
 " is Hermitian, its eigenvalues are real and its eigenstates can be chosen \
orthonormal."
}], "Text",
 CellChangeTimes->{{3.9683700210508966`*^9, 3.968370189365374*^9}, {
  3.96919112599401*^9, 
  3.9691911286867113`*^9}},ExpressionUUID->"21c1d6ff-4056-4d6c-a040-\
d05959f91e08"],

Cell["Check that Pauli matrices are Hermitian:", "Text",
 CellChangeTimes->{{3.9691911450558643`*^9, 
  3.969191152995555*^9}},ExpressionUUID->"4c8f30b1-473f-4ad5-b910-\
aa0ebc675c9e"],

Cell[BoxData[
 RowBox[{"HermitianMatrixQ", "/@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"PauliMatrix", "[", "j", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.969191132082774*^9, 3.969191142568153*^9}},
 CellLabel->"In[76]:=",ExpressionUUID->"f92b8d20-606d-4b4d-a863-882943a8b310"],

Cell["Find the eigensystem of Pauli-Z:", "Text",
 CellChangeTimes->{{3.9683703136585827`*^9, 3.968370339890833*^9}, {
  3.969191159733292*^9, 
  3.969191163604724*^9}},ExpressionUUID->"f8a70336-606d-4711-8764-\
decdbc6ce226"],

Cell[BoxData[
 RowBox[{"Eigensystem", "@", 
  RowBox[{"PauliMatrix", "[", "3", "]"}]}]], "Input",
 CellChangeTimes->{{3.968370191781348*^9, 3.968370214247726*^9}, {
  3.968370256448801*^9, 3.968370308798967*^9}},
 CellLabel->"In[77]:=",ExpressionUUID->"6b5e344b-98cf-4147-b8af-2c7cd7681d18"],

Cell["\<\
Verify the \[Minus]1 eigenvalue by applying the operator to the candidate \
state and confirming the result is exactly the original state multiplied by \
\[Minus]1 (same amplitudes, same relative phases, overall sign flip only):\
\>", "Text",
 CellChangeTimes->{{3.96918973204147*^9, 3.9691897463661203`*^9}, {
  3.9691898675184317`*^9, 
  3.969189870334407*^9}},ExpressionUUID->"02ba7174-6fac-497c-a4bd-\
786d3df02846"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PauliMatrix", "[", "3", "]"}], ".", 
  RowBox[{"{", 
   RowBox[{"0", ",", "1"}], "}"}]}]], "Input",
 CellChangeTimes->{{3.969147852375987*^9, 3.9691478601682673`*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"77bd8c5c-aef8-491f-8dcc-11204789d3e5"],

Cell["\<\
Verify the +1 eigenvalue by applying the operator to the candidate state and \
confirming the output equals the input (no change in amplitudes or relative \
phases).\
\>", "Text",
 CellChangeTimes->{{3.969189894186726*^9, 
  3.969189907596243*^9}},ExpressionUUID->"3aca3169-dc32-45ca-b1ef-\
82e89527b1b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PauliMatrix", "[", "3", "]"}], ".", 
  RowBox[{"{", 
   RowBox[{"1", ",", "0"}], "}"}]}]], "Input",
 CellChangeTimes->{{3.969147863924438*^9, 3.969147865751317*^9}},
 CellLabel->"In[79]:=",ExpressionUUID->"31fd16a8-d37d-49eb-b354-b8532843da6f"],

Cell[TextData[{
 "Check the eigenvectors of Pauli matrices are orthogonal (i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["v", "+", "*"], ".", 
     SubscriptBox["v", "-"]}], "=", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["v", "-", "*"], ".", 
      SubscriptBox["v", "+"]}], "=", "0"}]}], TraditionalForm]],
  ExpressionUUID->"90f1ed50-05e0-4905-9404-f34c30e36a60"],
 " where * means conjugate, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "\[PlusMinus]"], TraditionalForm]],ExpressionUUID->
  "a624aa95-fd08-4954-8d6b-dc94d40d5d28"],
 " are eigenvectors of \[PlusMinus] eigenvalues):"
}], "Text",
 CellChangeTimes->{{3.969191238408215*^9, 3.9691913481179028`*^9}, {
  3.969209521685831*^9, 
  3.9692095221288767`*^9}},ExpressionUUID->"39a9b766-ee55-421a-adcb-\
a6711f5d3db6"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Conjugate", "[", "#1", "]"}], ".", "#2"}], "&"}], "@@", 
    RowBox[{"Eigenvectors", "[", 
     RowBox[{"PauliMatrix", "[", "j", "]"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"j", ",", "3"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9691911861098223`*^9, 3.969191234866549*^9}},
 CellLabel->"In[80]:=",ExpressionUUID->"64767171-3921-498e-bf1a-479f36966468"],

Cell["\<\
From now on, unless stated otherwise, we will choose eigenvectors to be \
normalized. The eigenvectors then form an orthonormal basis for the vector \
space.\
\>", "Text",
 CellChangeTimes->{{3.969191363927129*^9, 
  3.9691914272203407`*^9}},ExpressionUUID->"605027b7-cf8d-4357-83c1-\
f841b2a0f9df"],

Cell["\<\
We will call the eigenvector with the positive eigenvalue as by + subscript \
and the negative one by - subscript. Putting this together, we can represent \
the Bloch-sphere positions of the eigenvectors of the Pauli operators as \
follows:\
\>", "Text",
 CellChangeTimes->{{3.968370342253517*^9, 3.968370411431415*^9}, {
  3.9683704652361937`*^9, 3.968370465470343*^9}, {3.969189932818768*^9, 
  3.969189942647955*^9}, {3.969191440747867*^9, 
  3.969191466428013*^9}},ExpressionUUID->"ef66901a-47e1-4498-8598-\
531cbc39531c"],

Cell[BoxData[
 RowBox[{"TabView", "[", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"TraditionalForm", "[", "#", "]"}], "->", 
      RowBox[{"#", "[", "\"\<BlochPlot\>\"", "]"}]}], "&"}], "]"}], "@", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"QuantumBasis", "[", "#", "]"}], "[", "\"\<BasisStates\>\"", 
       "]"}], "&"}], "/@", 
     RowBox[{"{", 
      RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.969227084359685*^9, 3.9692273213254623`*^9}, {
  3.969227354225751*^9, 3.969227364745391*^9}},
 CellLabel->"In[81]:=",ExpressionUUID->"7abfa490-47b2-4005-9471-b0570a7b25d5"],

Cell["\<\
Each of the six states shown above lie along the Cartesian axes of the \
sphere. For various historical reasons, these states have alternate names in \
the context of quantum computing. \
\>", "Text",
 CellChangeTimes->{{3.9442466395054417`*^9, 3.944246698927992*^9}, {
   3.944246776705061*^9, 3.944246807473341*^9}, {3.9442469044892616`*^9, 
   3.9442469577452374`*^9}, {3.9442472364977856`*^9, 3.944247237865135*^9}, 
   3.969189964342243*^9},ExpressionUUID->"f8deade1-617b-48e3-9e92-\
a9820a27e0e1"],

Cell["\<\
Note that Pauli-Z eigenvectors are the same as the computational basis:\
\>", "Text",
 CellChangeTimes->{{3.969191493686143*^9, 
  3.969191508625931*^9}},ExpressionUUID->"de1dc363-6524-4a68-9d60-\
ecfe0704f740"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", "\"\<Z\>\"", "]"}], "[", "\"\<Association\>\"",
   "]"}]], "Input",
 CellChangeTimes->{{3.969191482042799*^9, 3.969191486967144*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"1418e2c6-cb32-443d-8509-e473b90b8938"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", "2", "]"}], "[", "\"\<Association\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{3.969191491309429*^9},
 CellLabel->"In[83]:=",ExpressionUUID->"56b4dc83-f321-4003-8e37-a8e020a06e49"],

Cell[TextData[{
 "Given a state, the x-component of Bloch vector is the same as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Tr", "[", 
    RowBox[{"\[Rho]", ".", 
     SubscriptBox["\[Sigma]", "x"]}], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3852130d-dce2-4f65-9ff1-af38ebdfad16"],
 "; Likewise for other components and their Pauli operators, i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["r", "x"], ",", 
      SubscriptBox["r", "y"], ",", 
      SubscriptBox["r", "z"]}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"\[Rho]", ".", 
        SubscriptBox["\[Sigma]", "x"]}], "]"}], ",", 
      RowBox[{"Tr", "[", 
       RowBox[{"\[Rho]", ".", 
        SubscriptBox["\[Sigma]", "y"]}], "]"}], ",", 
      RowBox[{"Tr", "[", 
       RowBox[{"\[Rho]", ".", 
        SubscriptBox["\[Sigma]", "z"]}], "]"}]}], "}"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a79823fc-a190-4a9b-86f4-34fbd8fbb347"],
 ". Let\[CloseCurlyQuote]s check that:"
}], "Text",
 CellChangeTimes->{{3.969219630871582*^9, 3.96921978284763*^9}, {
  3.969219822269112*^9, 3.969219911173521*^9}, {3.969226778748818*^9, 
  3.969226821502911*^9}},ExpressionUUID->"a7c3992e-2fd9-49ca-87a5-\
0b52a56355a0"],

Cell[TextData[{
 "Define a state with the Bloch vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["r", "x"], ",", 
     SubscriptBox["r", "y"], ",", 
     SubscriptBox["r", "z"]}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "44046577-446f-478a-adb6-a8800f9d4255"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9692199991951847`*^9, 3.969220005861682*^9}, {
  3.96922682413052*^9, 
  3.969226855970717*^9}},ExpressionUUID->"5ee6fc76-e739-48cd-b29a-\
fca9069c3af1"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{"rx", ",", "ry", ",", "rz"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"state", "=", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<BlochVector\>\"", "[", 
     RowBox[{"{", 
      RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.969220008910523*^9, 3.969220022273239*^9}, 
   3.969226836965302*^9, {3.969924619813862*^9, 3.969924628594014*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"ba56f915-385c-4fc3-9a43-4c6f100491bb"],

Cell[TextData[{
 "Calculate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{"\[Rho]", ".", 
       SubscriptBox["\[Sigma]", "x"]}], "]"}], ",", 
     RowBox[{"Tr", "[", 
      RowBox[{"\[Rho]", ".", 
       SubscriptBox["\[Sigma]", "y"]}], "]"}], ",", 
     RowBox[{"Tr", "[", 
      RowBox[{"\[Rho]", ".", 
       SubscriptBox["\[Sigma]", "z"]}], "]"}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"dce5026d-1b47-4eac-9c67-b90ae6c70182"]
}], "Text",
 CellChangeTimes->{{3.9692268724050007`*^9, 
  3.9692268857087917`*^9}},ExpressionUUID->"a05db0b5-dbe9-42fb-833f-\
5bdb303f05fa"],

Cell[BoxData[
 RowBox[{"FullSimplify", "/@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Tr", "[", 
     RowBox[{
      RowBox[{"state", "[", "\"\<DensityMatrix\>\"", "]"}], ".", 
      RowBox[{"PauliMatrix", "[", "j", "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.969220025226763*^9, 3.969220070895925*^9}, {
  3.969226867338134*^9, 3.969226869287313*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"58c05be6-811b-4f01-addf-e2ef074b3332"],

Cell[TextData[{
 "As expected, the result is the original Bloch vector. The immediate \
consequence of this result is that the density matrix can be written as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"\[DoubleStruckCapitalI]", "+", 
       RowBox[{
        SubscriptBox["r", "x"], 
        SubscriptBox["\[Sigma]", "x"]}], "+", 
       RowBox[{
        SubscriptBox["r", "y"], 
        SubscriptBox["\[Sigma]", "y"]}], "+", 
       RowBox[{
        SubscriptBox["r", "z"], 
        SubscriptBox["\[Sigma]", "z"]}]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "29a73c61-45d4-4c9b-bfe0-04536f61ec8e"],
 ". Let\[CloseCurlyQuote]s verify that:"
}], "Text",
 CellChangeTimes->{
  3.9692268156858797`*^9, {3.969226890364233*^9, 
   3.969226925317581*^9}},ExpressionUUID->"034b1cfe-b7c5-4c2f-a4e8-\
4d59e2869720"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rx", ",", "ry", ",", "rz"}], "}"}], ".", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "j", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}]}], ")"}]}], "==", 
   RowBox[{"Normal", "[", 
    RowBox[{"state", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.969220093518094*^9, 3.96922011667673*^9}, {
   3.969226931372672*^9, 3.969226949043352*^9}, 3.9699246474939528`*^9},
 CellLabel->"In[87]:=",ExpressionUUID->"b93e21b0-f33c-4515-82ab-ea684f5a4d4c"],

Cell[TextData[{
 "These results imply that the density matrix \[Rho] is positive \
semidefinite, every state has a nonnegative expectation value i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     TemplateBox[{"\[Psi]"},
      "Bra"], "\[Rho]", 
     TemplateBox[{"\[Psi]"},
      "Ket"]}], ">=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a0804c8f-aace-4192-bd92-a61fccafa628"],
 " for any ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"\[Psi]"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "15d9d0cb-d29c-49bb-9e68-d976453e82e0"],
 ". This holds for all density matrices, from qubits to higher-dimensional \
qudits."
}], "Text",
 CellChangeTimes->{{3.969219630871582*^9, 3.96921978284763*^9}, {
  3.969219822269112*^9, 3.969219985993054*^9}, {3.9692269567661448`*^9, 
  3.9692270250781717`*^9}},ExpressionUUID->"b5dc25d2-bc28-4f8d-a301-\
1386651ef61e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Higher Dimensions", "Section",
 CellChangeTimes->{{3.969191678465391*^9, 3.9691916881323*^9}, {
  3.9699770572659407`*^9, 
  3.96997705761058*^9}},ExpressionUUID->"d8c7206b-37e9-4182-99c1-\
20b7e99932ba"],

Cell["\<\
The simplest quantum system is a qubit, represented by a two-dimensional \
complex vector space. For example, show the T-type magic state\
\[CloseCurlyQuote]s amplitudes in the computational basis:\
\>", "Text",
 CellChangeTimes->{{3.96919156411445*^9, 3.969191617786681*^9}, 
   3.969191676540999*^9, {3.969215698173616*^9, 3.969215702855351*^9}, {
   3.9692158253338013`*^9, 3.9692158426684113`*^9}, {3.969215918208321*^9, 
   3.969215928074753*^9}, {3.969300326530879*^9, 
   3.9693003293668833`*^9}},ExpressionUUID->"384d25ab-ebcc-4689-8bb6-\
f3b03552b08d"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qc", "=", 
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<H\>\"", ",", "\"\<T\>\""}], "}"}], "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", "\t", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"qc", "[", 
       RowBox[{"\"\<Diagram\>\"", ",", 
        InterpretationBox[
         DynamicModuleBox[{Typeset`open = False}, 
          TemplateBox[{"Expression", "SequenceIcon", 
            GridBox[{{
               RowBox[{
                 TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                 TagBox["Sequence", "IconizedItem"]}]}, {
               RowBox[{
                 TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                 TagBox["2", "IconizedItem"]}]}, {
               RowBox[{
                 TagBox["\"Byte count: \"", "IconizedLabel"], 
                 "\[InvisibleSpace]", 
                 TagBox["720", "IconizedItem"]}]}}, 
             GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
             "Column", 
             GridBoxItemSize -> {
              "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
            Dynamic[Typeset`open]},
           "IconizedObject"]],
         Sequence[ImageSize -> 200, "WireLabels" -> {1 -> {
              Placed[
               Ket[{0}], Left], 
              Placed[
               Ket[{$CellContext`MagicState}], Right]}}],
         SelectWithContents->True,
         Selectable->False]}], "]"}], ",", ",", "\"\<  \>\"", ",", " ", 
      RowBox[{
       RowBox[{"qc", "[", "]"}], "[", "\"\<AmplitudesList\>\"", "]"}]}], 
     "}"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.969215742000086*^9, 3.969215775971574*^9}, {
  3.96921581364786*^9, 3.96921581477204*^9}, {3.969215848684424*^9, 
  3.969215894028166*^9}, {3.969215938191606*^9, 3.9692159498300323`*^9}, {
  3.969215996145097*^9, 3.969216012858089*^9}, {3.9692160543891487`*^9, 
  3.969216193735677*^9}, {3.969216604803204*^9, 3.969216606202572*^9}},
 CellLabel->"In[88]:=",ExpressionUUID->"d0161df7-2fad-4cbf-83af-dceddac96c6a"],

Cell["\<\
Quantum systems can also be higher-dimensional; a three-level system is \
called a qutrit, such as a spin-1 system. \
\>", "Text",
 CellChangeTimes->{{3.96919156411445*^9, 3.969191617786681*^9}, 
   3.969191676540999*^9, {3.969216272248207*^9, 3.969216273516864*^9}, {
   3.969216391272114*^9, 3.969216411003768*^9}, {3.9692166283569183`*^9, 
   3.969216681156457*^9}},ExpressionUUID->"f7517020-84ca-46fb-9878-\
9188fcdf2751"],

Cell["\<\
Applying the qutrit (3D) Hadamard to the 0 state yields an equal \
superposition of all three basis states, each with the same magnitude and \
evenly spaced relative phases:\
\>", "Text",
 CellChangeTimes->{{3.96919156411445*^9, 3.969191617786681*^9}, 
   3.969191676540999*^9, {3.969216272248207*^9, 3.969216273516864*^9}, {
   3.969216391272114*^9, 3.969216411003768*^9}, {3.9692166283569183`*^9, 
   3.969216690453882*^9}},ExpressionUUID->"dba1cc18-0689-4b91-be09-\
4b5efc4fabd1"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qc", "=", 
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<H\>\"", "[", "3", "]"}], "}"}], "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", "\t", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"qc", "[", 
       RowBox[{"\"\<Diagram\>\"", ",", 
        InterpretationBox[
         DynamicModuleBox[{Typeset`open = False}, 
          TemplateBox[{"Expression", "SequenceIcon", 
            GridBox[{{
               RowBox[{
                 TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                 TagBox["Sequence", "IconizedItem"]}]}, {
               RowBox[{
                 TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                 TagBox["3", "IconizedItem"]}]}, {
               RowBox[{
                 TagBox["\"Byte count: \"", "IconizedLabel"], 
                 "\[InvisibleSpace]", 
                 TagBox["336", "IconizedItem"]}]}}, 
             GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
             "Column", 
             GridBoxItemSize -> {
              "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
            Dynamic[Typeset`open]},
           "IconizedObject"]],
         Sequence[
         ImageSize -> 80, "WireLabels" -> None, "ShowWireDimensions" -> True],
         SelectWithContents->True,
         Selectable->False]}], "]"}], ",", ",", "\"\<  \>\"", ",", " ", 
      RowBox[{"TraditionalForm", "[", 
       RowBox[{"qc", "[", "]"}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.969227534464794*^9, 3.9692275983207293`*^9}, {
  3.969300340029159*^9, 3.969300355116308*^9}},
 CellLabel->"In[89]:=",ExpressionUUID->"8ecb3d99-ef0c-443f-8e59-f7d28640998f"],

Cell["\<\
For the 3D Hadamard we use the same \[OpenCurlyDoubleQuote]H\
\[CloseCurlyDoubleQuote] symbol; the difference is that it acts on qutrit \
(3-level) wires rather than qubit wires.\
\>", "Text",
 CellChangeTimes->{{3.9691916256301737`*^9, 3.969191636949995*^9}, {
  3.969227695837858*^9, 3.969227698895142*^9}, {3.969300371869285*^9, 
  3.969300403067877*^9}},ExpressionUUID->"aae7e838-256d-49c2-ab73-\
becfd3906e68"],

Cell["Pay attention to the notation for the corresponding basis:", "Text",
 CellChangeTimes->{{3.9691916256301737`*^9, 3.969191636949995*^9}, {
  3.969227695837858*^9, 
  3.969227697944006*^9}},ExpressionUUID->"942f1cea-7b81-4d95-b294-\
666e7a5cf54c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", "3", "]"}], "[", "\"\<Association\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{3.969191639048891*^9, 3.969191646005054*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"4186981d-c41a-4327-aba0-c142a56b0bd7"],

Cell[TextData[{
 "The numbering for the basis goes from 0 to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "-", "1"}], TraditionalForm]],ExpressionUUID->
  "70d6f58a-ec88-4ea4-b791-0c9079a35c09"],
 " with ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],ExpressionUUID->
  "d31fcf39-69e7-403b-904a-2de571fb0a7a"],
 " the corresponding dimension."
}], "Text",
 CellChangeTimes->{{3.969191652451274*^9, 
  3.969191670605754*^9}},ExpressionUUID->"3d41039d-d4d2-4a50-8f50-\
27deb4f200b9"],

Cell["Show the matrix form of the 3D Hadamard:", "Text",
 CellChangeTimes->{{3.969216709198955*^9, 3.969216751089245*^9}, {
  3.96921684292087*^9, 3.9692168692488623`*^9}, {3.9692276745817337`*^9, 
  3.9692276804529343`*^9}, {3.9693004251323223`*^9, 
  3.9693004456337833`*^9}},ExpressionUUID->"239b480d-079e-4ef9-a88f-\
097e9d6dbfac"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<H\>\"", "[", "3", "]"}], "]"}], "[", "\"\<Matrix\>\"", "]"}],
   "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.9692167004944572`*^9, 3.969216704989485*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"f81510db-077d-4bee-9840-851928e9a35f"],

Cell["\<\
Let\[CloseCurlyQuote]s focus on a special qutrit. A three-level lambda system \
(\[CapitalLambda] system) is an atom or qutrit. Think of the levels forming \
the shape of the Greek letter \[CapitalLambda]: the two lower \
\[OpenCurlyDoubleQuote]arms\[CloseCurlyDoubleQuote] meet at the upper \
\[OpenCurlyDoubleQuote]node.\[CloseCurlyDoubleQuote] Two lasers are used, one \
drives the left lower state to the excited state (pump), the other drives the \
right lower state to the excited state (Stokes).\
\>", "Text",
 CellChangeTimes->{{3.969193543775017*^9, 3.969193632329097*^9}, {
  3.969216894577553*^9, 
  3.969216916069022*^9}},ExpressionUUID->"8509a4fd-de96-4faa-a139-\
81315645b9a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Graph", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"0", "<->", "1"}], ",", 
      RowBox[{"2", "<->", "1"}]}], "}"}], ",", 
    RowBox[{"VertexCoordinates", "->", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"0", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0"}], "}"}]}], ",", 
       RowBox[{"1", "->", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1.5"}], "}"}]}], ",", 
       RowBox[{"2", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", ".5"}], "}"}]}]}], "|>"}]}], ",", 
    RowBox[{"VertexLabels", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0", "->", "\"\<\!\(\*Cell[TextData[Cell[BoxData[
TemplateBox[{\"0\"},\"Ket\"]],ExpressionUUID->\"3c2dc1cc-3489-474d-b998-\
234b904504c2\"]],ExpressionUUID->\"15e5bcbb-75d3-4722-ba46-80b93b0d5594\"]\)\>\
\""}], ",", 
       RowBox[{"1", "->", "\"\<\!\(\*Cell[TextData[Cell[BoxData[
TemplateBox[{\"1\"},\"Ket\"]],ExpressionUUID->\"d4882662-203d-48ce-89d6-\
b8f4661c558f\"]],ExpressionUUID->\"62001e01-1234-4205-b1d1-cd88624f3ce0\"]\)\>\
\""}], ",", 
       RowBox[{"2", "->", "\"\<\!\(\*Cell[TextData[Cell[BoxData[
TemplateBox[{\"2\"},\"Ket\"]],ExpressionUUID->\"6f8ea232-e198-437c-8e45-\
01c14dce8cad\"]],ExpressionUUID->\"0fe45784-3bd3-4120-a0e3-4437d40b3c63\"]\)\>\
\""}]}], "}"}]}], ",", 
    RowBox[{"EdgeLabels", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"0", "<->", "1"}], 
        "->", "\"\<\!\(\*SubscriptBox[\(\[CapitalOmega]\), \(p\)]\)\>\""}], ",", 
       RowBox[{
        RowBox[{"2", "<->", "1"}], 
        "->", "\"\<\!\(\*SubscriptBox[\(\[CapitalOmega]\), \(s\)]\)\>\""}]}], 
      "}"}]}]}], "]"}], "\n"}]], "Input",
 CellChangeTimes->{{3.9691937823226233`*^9, 3.969193815742989*^9}, {
  3.969193866391878*^9, 3.9691939787354403`*^9}, {3.969209016811406*^9, 
  3.969209042594241*^9}},
 CellLabel->"In[92]:=",ExpressionUUID->"6faf8419-ab31-4bb3-ae24-e1c79b97b418"],

Cell["\<\
This setup is a workhorse in quantum optics because it lets you move \
population or create superpositions between the two stable lower states while \
keeping the fragile excited state mostly unoccupied, enabling techniques like \
Stimulated Raman Adiabatic Passage (STIRAP), electromagnetically induced \
transparency, and coherent population trapping.\
\>", "Text",
 CellChangeTimes->{
  3.969216918200678*^9},ExpressionUUID->"c558bf27-20b6-4c03-9dd6-\
4ebf7d0e2cb0"],

Cell["Consider an operator as follows:", "Text",
 CellChangeTimes->{{3.969192648999094*^9, 3.969192659325623*^9}, 
   3.969193184368857*^9},ExpressionUUID->"34cc0465-16b3-41fd-8226-\
979e671a32e0"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{
  "\[CapitalOmega]s", ",", "\[CapitalOmega]p", ",", "\[CapitalDelta]"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "\[CapitalOmega]p", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalOmega]p", ",", 
       RowBox[{"2", "\[CapitalDelta]"}], ",", "\[CapitalOmega]s"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "\[CapitalOmega]s", ",", "0"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"h", "//", "MatrixForm"}]}], "Input",
 CellChangeTimes->{{3.969192673108924*^9, 3.9691927125081387`*^9}, {
  3.96919285162735*^9, 3.969192858243805*^9}, {3.969193104382573*^9, 
  3.96919310638701*^9}, {3.969217607481072*^9, 3.969217619756606*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"6fcb685b-5423-47dc-a2f1-ac09c6afb5c4"],

Cell[TextData[{
 "This operator (which is the Hamiltonian operator) describes a \
\[CapitalLambda]-type qutrit where the pump coupling has the Rabi frequency ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "p"], TraditionalForm]],ExpressionUUID->
  "a2696ff0-f64e-4855-980e-111f2f1b0d3d"],
 " and the Stokes coupling with Rabi frequency ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "s"], TraditionalForm]],ExpressionUUID->
  "2abcb5d0-674b-4238-add0-3d6d18c4c9ac"],
 ". Additionally, \[CapitalDelta] is the common one-photon detuning."
}], "Text",
 CellChangeTimes->{{3.9691928617017117`*^9, 3.969192914836973*^9}, {
  3.969192977526161*^9, 3.9691930796031513`*^9}, {3.9691932143066587`*^9, 
  3.969193340868452*^9}, {3.969193621513966*^9, 3.96919362397511*^9}, {
  3.9692091021432343`*^9, 3.969209114971059*^9}, {3.9692169444333963`*^9, 
  3.969216972507296*^9}},ExpressionUUID->"8c92093d-1025-4e16-85ee-\
35b6cc5d6331"],

Cell["Find the eigensystem of the Hamiltonian:", "Text",
 CellChangeTimes->{{3.969209086806368*^9, 3.969209092583953*^9}, {
  3.969209159388489*^9, 
  3.969209164323028*^9}},ExpressionUUID->"4543732f-af4b-4937-895c-\
ed834a685f83"],

Cell[BoxData[
 RowBox[{"Eigensystem", "[", "h", "]"}]], "Input",
 CellChangeTimes->{{3.9692087726992207`*^9, 3.9692087754045067`*^9}, {
  3.969208902313241*^9, 3.9692089047952557`*^9}},
 CellLabel->"In[96]:=",ExpressionUUID->"27d8ffc8-575f-4675-bcfe-56a4ebc5498d"],

Cell["\<\
As one can see, one of the eigenvectors correspond to the eigenvalue zero.\
\>", "Text",
 CellChangeTimes->{{3.969209167735969*^9, 3.969209193334216*^9}, 
   3.969209432668034*^9},ExpressionUUID->"5fb6d7a0-1835-4e92-87a6-\
0a2f64ed7564"],

Cell[TextData[{
 "Consider a state defined as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalOmega]", "s"], 
     TemplateBox[{"0"},
      "Ket"]}], "-", 
    RowBox[{
     SubscriptBox["\[CapitalOmega]", "p"], 
     TemplateBox[{"2"},
      "Ket"]}]}], TraditionalForm]],ExpressionUUID->
  "f83a4c9e-52b4-4c8c-9242-6f2bbf19951f"],
 ":"
}], "Text",
 CellChangeTimes->{{3.969193126621949*^9, 
  3.9691931462690287`*^9}},ExpressionUUID->"c89cc128-2f86-46af-a704-\
9669660544b5"],

Cell[BoxData[
 RowBox[{"dark", "=", 
  RowBox[{
   RowBox[{"\[CapitalOmega]s", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "-", 
   RowBox[{"\[CapitalOmega]p", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}]}]], "Input",
 CellChangeTimes->{{3.969192757418639*^9, 3.9691927959462643`*^9}, {
  3.969193109797565*^9, 3.969193118970529*^9}},
 CellLabel->"In[97]:=",ExpressionUUID->"7a3e1c27-0684-403b-a338-845af2a5f73e"],

Cell[TextData[{
 "Show that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", ".", " ", "dark"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"c6e0334e-0fd9-4276-b10a-c2cc1f48e168"],
 ", meaning it is the 0-eigenvector:"
}], "Text",
 CellChangeTimes->{{3.9691933867604017`*^9, 3.969193407196294*^9}, {
  3.969209210195653*^9, 
  3.969209229626169*^9}},ExpressionUUID->"aada652d-88ce-435a-9c9e-\
6f553a16977a"],

Cell[BoxData[
 RowBox[{"h", ".", "dark"}]], "Input",
 CellChangeTimes->{{3.969192799142242*^9, 3.969192821178338*^9}, {
  3.969193150465405*^9, 3.969193153839164*^9}},
 CellLabel->"In[98]:=",ExpressionUUID->"3da2766c-ab89-4cbf-8d35-c1b24797acc9"],

Cell["\<\
The above state is called a dark state. A dark state is a special \
superposition of the two long-lived ground states in a three-level \
\[CapitalLambda] system that does not couple to the excited state under the \
applied lasers. Practically, the pump tries to lift amplitude from one ground \
state and the Stokes from the other; in the right superposition their effects \
on the excited level cancel by destructive interference, so the system does \
not absorb light.\
\>", "Text",
 CellChangeTimes->{{3.9692093906392193`*^9, 3.969209411927157*^9}, {
  3.9695473168500757`*^9, 
  3.969547317473257*^9}},ExpressionUUID->"83f0212d-9995-4dd6-b930-\
af1cd4ce210d"],

Cell[TextData[{
 "Note that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"\[CapitalOmega]s", ",", "0", ",", 
     RowBox[{"-", "\[CapitalOmega]p"}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"1e89f5e6-a36c-4ece-8eba-240d8a572955"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["\[CapitalOmega]s", "\[CapitalOmega]p"]}], ",", "0", ",", 
     "1"}], "}"}], TraditionalForm]],ExpressionUUID->
  "0e7c66e5-c4be-4646-bc7b-05ddbcc47a5d"],
 " differ only by an overall factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "\[CapitalOmega]p"}], TraditionalForm]],ExpressionUUID->
  "f0227231-474b-4c0c-82a3-bd3e6a9b4cf9"],
 ", so they represent the same quantum state; a global phase is unobservable."
}], "Text",
 CellChangeTimes->{{3.9692092325687647`*^9, 
  3.969209360847402*^9}},ExpressionUUID->"fce8005c-afff-42ad-bf3e-\
0a07f3916f87"],

Cell["Check the quantum states are the same:", "Text",
 CellChangeTimes->{{3.969217584184194*^9, 
  3.969217593498479*^9}},ExpressionUUID->"7afdcb95-592d-4bf2-b111-\
1e76f4a8bcaa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   FormBox[
    RowBox[{"{", 
     RowBox[{"\[CapitalOmega]s", ",", "0", ",", 
      RowBox[{"-", "\[CapitalOmega]p"}]}], "}"}],
    TraditionalForm], "]"}], "==", 
  RowBox[{"QuantumState", "[", 
   FormBox[
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["\[CapitalOmega]s", "\[CapitalOmega]p"]}], ",", "0", ",", 
      "1"}], "}"}],
    TraditionalForm], "]"}]}]], "Input",
 CellChangeTimes->{{3.969217555852599*^9, 3.969217581649454*^9}},
 CellLabel->"In[99]:=",ExpressionUUID->"fa436664-e16e-43ea-9eff-f0cf141af974"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Probability and Measurement", "Chapter",
 CellChangeTimes->{{3.9448487458361225`*^9, 3.94484874867618*^9}, {
  3.969217691688139*^9, 
  3.969217693746374*^9}},ExpressionUUID->"ba8a45af-b9a4-4142-bc20-\
fc4bd3abee5c"],

Cell["\<\
We will discuss the concept of probability and how it relates to the \
frequency of different outcomes in a repeatable measurement. Then we will \
show how probabilities in quantum theory help us calculate joint and marginal \
probabilities.\
\>", "Text",
 CellChangeTimes->{{3.968331700214238*^9, 3.9683317023573513`*^9}, {
  3.968349049736882*^9, 
  3.9683491163527946`*^9}},ExpressionUUID->"0a561a36-5941-455d-8c06-\
cdd26052514c"],

Cell[CellGroupData[{

Cell["Key Concepts", "Section",
 CellChangeTimes->{{3.9448487565071926`*^9, 
  3.944848758051235*^9}},ExpressionUUID->"21014298-4b14-4c12-999c-\
bb1f1e0d02b2"],

Cell["\<\
Random Outcome, Probability Distribution, Marginal Probability, Joint \
Probability\
\>", "Item",
 CellChangeTimes->{{3.9448487641071663`*^9, 3.944848772534397*^9}, {
  3.945083983169876*^9, 3.9450839880544662`*^9}, {3.9450853294131107`*^9, 
  3.945085330108259*^9}, {3.969215677221362*^9, 3.969215677759988*^9}, {
  3.969383507003355*^9, 
  3.969383513852251*^9}},ExpressionUUID->"5dc124ac-6d93-4d87-93f2-\
19c83e8915ab"],

Cell["Marginal Probability", "Item",
 CellChangeTimes->{{3.9448487641071663`*^9, 3.944848772534397*^9}, {
   3.9683491041238327`*^9, 3.968349108511135*^9}, 
   3.969215681461865*^9},ExpressionUUID->"ce543b72-70eb-4a37-b86a-\
937756c2d6c8"],

Cell["Joint Probability", "Item",
 CellChangeTimes->{{3.9448487641071663`*^9, 3.944848772534397*^9}, {
   3.9683491041238327`*^9, 3.968349111357705*^9}, 
   3.9692156839288893`*^9},ExpressionUUID->"e276e339-bc78-4f39-81c4-\
7844c0bb75cb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Frequency vs probability", "Section",
 CellChangeTimes->{{3.9450842281823845`*^9, 3.945084231085821*^9}, {
   3.945088886049017*^9, 3.9450888905680294`*^9}, 3.969206254588737*^9, {
   3.969977062115522*^9, 
   3.969977062419264*^9}},ExpressionUUID->"f29e149d-8c07-40b1-93fd-\
e937959e9957"],

Cell["\<\
You\[CloseCurlyQuote]re no doubt familiar with coin flips or dice rolls as \
ways to generate random outcomes. For our purposes, think of a random outcome \
as a definite result from a repeatable experiment. Randomness here means that \
several different outcomes are possible, and while we may know their \
probabilities, there is no way to determine which specific outcome will occur \
before running the experiment.\
\>", "Text",
 CellChangeTimes->{{3.945085291101513*^9, 3.9450853176283836`*^9}, {
   3.9450853533803387`*^9, 3.945085373932991*^9}, {3.945085588900688*^9, 
   3.945085600461693*^9}, {3.9450858169158382`*^9, 3.945085950666769*^9}, 
   3.968331793368844*^9},ExpressionUUID->"b7bf897a-9687-480d-8bf9-\
58963031f399"],

Cell[TextData[{
 "You can find much more information on probability and statistics in any of \
the following Wolfram U courses: ",
 ButtonBox["Introduction to Probability",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/wolfram-u/courses/mathematics/introduction-\
to-probability/"], None},
  ButtonNote->
   "https://www.wolfram.com/wolfram-u/courses/mathematics/introduction-to-\
probability/"],
 ", and ",
 ButtonBox["Introduction to Statistics",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/wolfram-u/courses/mathematics/introduction-\
to-statistics/"], None},
  ButtonNote->
   "https://www.wolfram.com/wolfram-u/courses/mathematics/introduction-to-\
statistics/"],
 "."
}], "Text",
 CellChangeTimes->{
  3.9450855848760777`*^9, {3.9692100665057707`*^9, 
   3.9692100719495687`*^9}},ExpressionUUID->"a90d7fae-f9bc-4a2e-b826-\
172ef089a4dc"],

Cell["\<\
Quantum theory provides a way to compute the probability distribution over \
possible measurement outcomes. You can think of a probability distribution as \
a rule that assigns a nonnegative probability to each possible outcome of an \
experiment, with all probabilities adding up to 1. In quantum circuits, this \
distribution is typically defined over the discrete set of possible \
bitstrings.\
\>", "Text",
 CellChangeTimes->{{3.9450854540443497`*^9, 3.945085499540102*^9}, {
   3.9450855373336105`*^9, 3.945085565252907*^9}, {3.9450859836765633`*^9, 
   3.945086073819351*^9}, {3.968331832707749*^9, 3.968331857850827*^9}, 
   3.968331905057693*^9},ExpressionUUID->"70441759-77cc-4b56-8c82-\
857d1609e2ac"],

Cell["\<\
Let\[CloseCurlyQuote]s look at a couple examples of generating random \
outcomes to build intuition.\
\>", "Text",
 CellChangeTimes->{{3.9450863574437885`*^9, 
  3.945086383034889*^9}},ExpressionUUID->"4cbb436c-dfdb-491c-945f-\
05b1300d7283"],

Cell["\<\
Suppose you want to sample a random integer between 1 and 10. One realization \
of this process is as follows:\
\>", "Text",
 CellChangeTimes->{{3.945086419387413*^9, 3.9450865199953384`*^9}, 
   3.9683319969342833`*^9, {3.9692063134642076`*^9, 
   3.969206360208858*^9}},ExpressionUUID->"e7d5c743-e49d-4c07-87eb-\
70b3cbf36132"],

Cell[BoxData[
 RowBox[{"RandomInteger", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", "10"}], "}"}], "]"}]], "Input",
 CellChangeTimes->{3.945086444261326*^9},
 CellLabel->
  "In[100]:=",ExpressionUUID->"c4e0683e-88df-4d23-a97c-6afc89a494f4"],

Cell["\<\
The above function returns a uniformly random integer from 1 to 10 \
(inclusive).\
\>", "Text",
 CellChangeTimes->{
  3.968331989853199*^9, {3.968345137625216*^9, 
   3.968345140945898*^9}},ExpressionUUID->"c68ddad2-e03a-4568-947b-\
6a4b20e33610"],

Cell["Now examine the count of each number in the sequence above.", "Text",
 CellChangeTimes->{{3.945086505914669*^9, 3.9450865453806267`*^9}, 
   3.968345156756831*^9, {3.969206470603088*^9, 
   3.969206473589244*^9}},ExpressionUUID->"c873a6bc-58d5-4167-96da-\
42ddfb4277d9"],

Cell[BoxData[
 RowBox[{"numberdata", "=", 
  RowBox[{"RandomInteger", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "10"}], "}"}], ",", "50"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.96920641136404*^9, 3.969206411855741*^9}, {
  3.9692065218291483`*^9, 3.96920652362171*^9}},
 CellLabel->
  "In[101]:=",ExpressionUUID->"571f8dbb-1144-4ecd-adb5-260381703020"],

Cell["\<\
Now examine the frequency of each number in the sequence above:\
\>", "Text",
 CellChangeTimes->{{3.945086846427105*^9, 3.94508685878866*^9}, {
  3.945086949602453*^9, 3.9450869571624775`*^9}, {3.969206423854501*^9, 
  3.969206448710129*^9}, {3.969206487607438*^9, 3.9692064893076468`*^9}, {
  3.969206543133527*^9, 
  3.96920654510148*^9}},ExpressionUUID->"09275978-34ca-4bde-a73b-\
e6f0b1d98aff"],

Cell[BoxData[
 RowBox[{"Histogram", "[", 
  RowBox[{"numberdata", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["5", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["680", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[{0.5}, "Count", Ticks -> {
       Range[10], Automatic}, PlotRange -> {{0, 11}, All}, PlotLabel -> 
     "Count of different number for a sequence of 50"],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellChangeTimes->{{3.9450867664203815`*^9, 3.9450867675299015`*^9}, {
  3.968332019958971*^9, 3.968332127126045*^9}, {3.968332846059518*^9, 
  3.968332846399328*^9}, {3.969206456461357*^9, 3.96920645764797*^9}, {
  3.9692065342510967`*^9, 3.9692065350595713`*^9}, {3.969210092117426*^9, 
  3.969210095638475*^9}, {3.9692101451889057`*^9, 3.969210145527388*^9}, {
  3.9692105033702297`*^9, 3.969210564371533*^9}},
 CellLabel->
  "In[102]:=",ExpressionUUID->"a7e65861-8c0e-4635-a2df-bc6bc0afec0a"],

Cell["\<\
Now examine the frequency of each number across different sequences as the \
sequence length increases:\
\>", "Text",
 CellChangeTimes->{{3.9692065141917763`*^9, 3.969206519137735*^9}, {
  3.969206552706807*^9, 3.969206569557378*^9}, {3.96920660380655*^9, 
  3.9692066057071447`*^9}},ExpressionUUID->"0fbde0a9-950b-42dd-89a8-\
767ff2c476bb"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Histogram", "[", 
     RowBox[{
      RowBox[{"RandomInteger", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "10"}], "}"}], ",", "j"}], "]"}], ",", 
      InterpretationBox[
       DynamicModuleBox[{Typeset`open = False}, 
        TemplateBox[{"Expression", "SequenceIcon", 
          GridBox[{{
             RowBox[{
               TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["Sequence", "IconizedItem"]}]}, {
             RowBox[{
               TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["6", "IconizedItem"]}]}, {
             RowBox[{
               TagBox["\"Byte count: \"", "IconizedLabel"], 
               "\[InvisibleSpace]", 
               TagBox["944", "IconizedItem"]}]}}, 
           GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
           "Column", 
           GridBoxItemSize -> {
            "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
          Dynamic[Typeset`open]},
         "IconizedObject"]],
       Sequence[{0.5}, "Probability", Ticks -> {
          Range[10], Automatic}, PlotRange -> {{0, 11}, {0, 0.25}}, PlotLabel -> 
        ToString[$CellContext`j] <> " repetition of experiment", ImageSize -> 
        200],
       SelectWithContents->True,
       Selectable->False]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", 
      RowBox[{"10", "^", 
       RowBox[{"Range", "[", "5", "]"}]}]}], "}"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.968332658265246*^9, 3.968332877957559*^9}, {
   3.969206503462186*^9, 3.969206504119877*^9}, 3.9692065971049337`*^9},
 CellLabel->
  "In[103]:=",ExpressionUUID->"af25aff5-fa30-49c0-8aed-6ea95cf4de60"],

Cell["\<\
As you can see, with more repetition of the same experiment, the observed \
frequency of outcomes gets closer to the true probability distribution. \
\>", "Text",
 CellChangeTimes->{{3.968332889987005*^9, 3.968332971779386*^9}, 
   3.9692066245848303`*^9},ExpressionUUID->"a6138947-382c-4e71-bce9-\
deb677e7622c"],

Cell["\<\
Now let\[CloseCurlyQuote]s consider the case where we assign a specific \
weight to each number: {1,1,2,3,4,4,3,2,1,1}.
We can compute the corresponding probabilities by normalizing the weights; \
that is:\
\>", "Text",
 CellChangeTimes->{{3.968345181559595*^9, 3.9683451951228*^9}, {
  3.9683453503648567`*^9, 3.968345367118132*^9}, {3.9683454584931917`*^9, 
  3.968345470108626*^9}},ExpressionUUID->"dd5d952a-535e-47b0-b628-\
86b1214bebe2"],

Cell[BoxData[
 RowBox[{"probWeights", "=", 
  RowBox[{"Normalize", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "1", ",", "1", ",", "2", ",", "3", ",", "4", ",", "4", ",", "3", ",", 
      "2", ",", "1", ",", "1"}], "}"}], ",", "Total"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.968345369766575*^9, 3.968345374593595*^9}, {
   3.968345819314685*^9, 3.9683458252444763`*^9}, 3.969206638242259*^9},
 CellLabel->
  "In[104]:=",ExpressionUUID->"d1797dd5-ff44-4fa5-bad1-b7bbdebee7b9"],

Cell["\<\
If we run the experiment many times, we expect the frequency of results to \
converge to the probabilities above. Now let\[CloseCurlyQuote]s generate \
different data samples of results for 10, 100, and 10,000 runs. As the number \
of realizations increases, the observed frequencies should get closer to the \
expected probabilities.\
\>", "Text",
 CellChangeTimes->{{3.968346092222145*^9, 3.968346212612296*^9}, 
   3.96834629812549*^9},ExpressionUUID->"6c8cca8c-23c7-4867-aaef-\
3f3344d95b1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sequenceOfResults", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"RandomChoice", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "1", ",", "1", ",", "2", ",", "3", ",", "4", ",", "4", ",", "3", ",",
           "2", ",", "1", ",", "1"}], "}"}], "->", 
        RowBox[{"Range", "[", "10", "]"}]}], ",", "j"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"2", "^", 
        RowBox[{"{", 
         RowBox[{"6", ",", "8", ",", "10"}], "}"}]}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.968345229247994*^9, 3.96834523812041*^9}, {
   3.968345303449218*^9, 3.968345332873069*^9}, {3.968345674732768*^9, 
   3.968345699044365*^9}, {3.9683459056361732`*^9, 3.96834591941611*^9}, {
   3.9683459784916162`*^9, 3.968345981479224*^9}, 3.968346039268961*^9, {
   3.969210606671832*^9, 3.969210642863203*^9}},
 CellLabel->
  "In[105]:=",ExpressionUUID->"fe4aa59f-e615-4dd5-a979-2e895a27350b"],

Cell["Calculate frequencies for each experiment:", "Text",
 CellChangeTimes->{{3.96834630862914*^9, 
  3.968346340037835*^9}},ExpressionUUID->"6ddead2d-cebf-4740-b401-\
2512c2690b6f"],

Cell[BoxData[
 RowBox[{"freq", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"KeySort", "[", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"Range", "[", "10", "]"}], "->", "0"}], "]"}], ",", 
       RowBox[{"Normalize", "[", 
        RowBox[{
         RowBox[{"Counts", "[", "#", "]"}], ",", "Total"}], "]"}]}], "]"}], 
     "]"}], "&"}], "/@", "sequenceOfResults"}]}]], "Input",
 CellChangeTimes->{{3.96834570067354*^9, 3.968345726467319*^9}, {
  3.9683458400453043`*^9, 3.968345841560568*^9}, {3.968345876989462*^9, 
  3.968345879338402*^9}, {3.968345927713394*^9, 3.96834594675403*^9}, {
  3.968346001358674*^9, 3.968346027818421*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"293ef5cc-f03d-4683-82cc-e3ec8dba719a"],

Cell["Visualize the results:", "Text",
 CellChangeTimes->{{3.968346343994961*^9, 
  3.96834634682174*^9}},ExpressionUUID->"faf98e04-c0ea-453e-822d-\
60ab268e0e93"],

Cell[BoxData[
 RowBox[{"BarChart", "[", 
  RowBox[{
   RowBox[{"Transpose", "@", 
    RowBox[{"Append", "[", 
     RowBox[{
      RowBox[{"Values", "/@", "freq"}], ",", "probWeights"}], "]"}]}], ",", 
   RowBox[{"ChartLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<64 runs of experiment\>\"", 
      ",", "\"\<256 runs of experiment\>\"", 
      ",", "\"\<1,024 runs of experiment\>\"", ",", "\"\<Probabilities\>\""}],
      "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9683457607292233`*^9, 3.9683457699785557`*^9}, {
   3.968345828819425*^9, 3.9683458650473022`*^9}, {3.968345895245739*^9, 
   3.9683458962447157`*^9}, {3.968345940724985*^9, 3.9683459654802103`*^9}, {
   3.9683463487080307`*^9, 3.9683464161570053`*^9}, 3.9692100447328997`*^9, {
   3.969210653094048*^9, 3.969210679453546*^9}},
 CellLabel->
  "In[107]:=",ExpressionUUID->"35a13f82-17a9-4581-9e78-d88ae209e9ab"],

Cell["\<\
As expected, with more runs of the experiment, the observed frequencies get \
closer to the expected probabilities (law of large numbers).\
\>", "Text",
 CellChangeTimes->{{3.96840497477395*^9, 
  3.968405020445067*^9}},ExpressionUUID->"77e0dbb9-c58b-401e-a69f-\
06fba528e017"],

Cell["\<\
Now let\[CloseCurlyQuote]s consider a case analogous to three different \
players rolling dice and collecting their joint outcomes. Of course, the \
quantum case can differ markedly from the classical \
one\[LongDash]classically, similar correlations might require prearranged \
strategies or communication. For the moment, however, we will set aside \
interpretation and focus only on the probabilities of the outcomes (i.e., the \
joint distribution and any marginals), leaving the discussion of correlations \
for later.\
\>", "Text",
 CellChangeTimes->{{3.9684050308300858`*^9, 
  3.968405168796027*^9}},ExpressionUUID->"2d5b46ff-6c18-4e89-81cd-\
14e41dd64b14"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Joint vs Marginal Probabilities", "Section",
 CellChangeTimes->{{3.968346525411975*^9, 3.96834652971935*^9}, 
   3.968347200471768*^9, {3.9699770637190733`*^9, 
   3.9699770700706663`*^9}},ExpressionUUID->"4c531064-e629-495a-8f79-\
62d8cc81cc2f"],

Cell[TextData[{
 "Consider a three-qubit system. Each qubit is measured in the computational \
basis, so any measurement result can be described by a three-bit string; \
overall ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "3"], TraditionalForm]],ExpressionUUID->
  "6d4b86ef-847a-4c11-b957-135364e5e349"],
 " possible outcomes:"
}], "Text",
 CellChangeTimes->{{3.968334798703397*^9, 3.968334800860444*^9}, {
  3.96833837210157*^9, 3.9683385059593153`*^9}, {3.9683387496589127`*^9, 
  3.968338750236002*^9}},ExpressionUUID->"9764833d-b145-4e12-a41a-\
f9d2b6016447"],

Cell[BoxData[
 RowBox[{"Tuples", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], ",", "3"}], "]"}]], "Input",
 CellChangeTimes->{{3.968338463681965*^9, 3.968338477912222*^9}, {
  3.968338727623354*^9, 3.96833874458032*^9}},
 CellLabel->
  "In[108]:=",ExpressionUUID->"5df8e9f1-cd74-44c0-a618-922bf9a6da9b"],

Cell["\<\
We will prepare the system in a special initial state. For now, we will skip \
the details of what this state is and focus only on the probability of \
outcomes. Using quantum theory, we can calculate the joint probabilities of \
the measurement results, that is, the probabilities for all possible tuples \
of 0s and 1s listed above.\
\>", "Text",
 CellChangeTimes->{{3.968338514342286*^9, 3.9683385826424026`*^9}, {
  3.9692067569734163`*^9, 
  3.9692067589440613`*^9}},ExpressionUUID->"a264aaf1-4f42-4f55-a828-\
5447755990c7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"state", "=", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<RandomPure\>\"", "[", "3", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"state", "[", "\"\<Probabilities\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.96834658818622*^9, 3.968346590837062*^9}, {
  3.96834747927142*^9, 3.968347483151351*^9}, {3.9683475175205107`*^9, 
  3.9683475179073763`*^9}, {3.969206692362191*^9, 3.969206699643125*^9}},
 CellLabel->
  "In[109]:=",ExpressionUUID->"71033094-7e87-4af9-928d-2c846548faae"],

Cell["\<\
Generate the corresponding multivariate distribution of outcomes:\
\>", "Text",
 CellChangeTimes->{{3.969206721345047*^9, 
  3.969206733314212*^9}},ExpressionUUID->"84aa2c93-54d4-47c8-aa9e-\
2c8e9abcd685"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalD]", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumMeasurementOperator", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "1", "}"}], ",", 
        RowBox[{"{", "2", "}"}], ",", 
        RowBox[{"{", "3", "}"}]}], "}"}], "]"}], "[", "state", "]"}], 
    "[", "\"\<MultivariateDistribution\>\"", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.96834658818622*^9, 3.968346590837062*^9}, {
   3.96834747927142*^9, 3.968347483151351*^9}, {3.9683475175205107`*^9, 
   3.9683475179073763`*^9}, 3.969206692362191*^9},
 CellLabel->
  "In[111]:=",ExpressionUUID->"175826e7-cd91-480c-ab70-4ca8334df808"],

Cell["Visualize the contingency table of the distribution:", "Text",
 CellChangeTimes->{{3.968338636686473*^9, 
  3.968338644575511*^9}},ExpressionUUID->"4fefc87f-b91f-4bc7-a5a7-\
46dd4bb4482c"],

Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"\[ScriptCapitalD]", ",", "\"\<ProbabilityTable\>\""}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.968334621333435*^9, 3.968334623985634*^9}, {
   3.968334718782447*^9, 3.968334786839274*^9}, {3.968334817411254*^9, 
   3.9683348328871202`*^9}, 3.9683349308898687`*^9, 3.968335091370207*^9, {
   3.968337811372466*^9, 3.968337814299076*^9}, {3.9683379010531588`*^9, 
   3.968337916340279*^9}, 3.9683379854138927`*^9, {3.9683383073642797`*^9, 
   3.968338349906373*^9}, {3.9683440544597597`*^9, 3.968344059957852*^9}, {
   3.9683465784339323`*^9, 3.968346579339635*^9}},
 CellLabel->
  "In[112]:=",ExpressionUUID->"47f821c9-5010-4307-8246-497ce2f8c3a8"],

Cell["\<\
Since we have the multivariate distribution, we can compute the probability \
of any scenario by summing over the appropriate outcomes. Let\
\[CloseCurlyQuote]s consider a few cases.\
\>", "Text",
 CellChangeTimes->{{3.968346620867334*^9, 3.968346674311495*^9}, {
  3.968407065500433*^9, 
  3.9684070901593113`*^9}},ExpressionUUID->"e40825d4-61ed-4819-b37e-\
d8feb0b0e7a2"],

Cell["\<\
Calculate the probability of getting 0 for qubit-1 and 1 for qubit-3 (and any \
result for qubit-2)\
\>", "Text",
 CellChangeTimes->{{3.968343296961424*^9, 3.9683433000128717`*^9}, 
   3.96834336409851*^9, {3.968344154426264*^9, 3.968344165506075*^9}, {
   3.968344946656548*^9, 3.968344962896373*^9}, {3.9683450014458847`*^9, 
   3.9683450047735357`*^9}},ExpressionUUID->"39b9cc91-7458-4592-9d87-\
4226f2c1c70b"],

Cell[BoxData[
 RowBox[{"Probability", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"q1", "\[Equal]", "0"}], "&&", 
    RowBox[{"q3", "==", "1"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}], "\[Distributed]", 
    "\[ScriptCapitalD]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9683440306290407`*^9, 3.9683440421543617`*^9}},
 CellLabel->
  "In[113]:=",ExpressionUUID->"7aa962c7-ade8-4c0d-8765-8964f2707334"],

Cell["Let\[CloseCurlyQuote]s calculate the above probability step-by-step:", \
"Text",
 CellChangeTimes->{{3.9683443234486*^9, 3.9683443298891563`*^9}, {
  3.968344476476479*^9, 3.968344585352982*^9}, {3.968344634166768*^9, 
  3.9683446714700403`*^9}, {3.968346688410387*^9, 3.9683466947212954`*^9}, {
  3.971796839496479*^9, 
  3.971796839934346*^9}},ExpressionUUID->"3d4343b5-99d2-49f4-a8c5-\
570676f76f79"],

Cell[TextData[{
 "From the full list of outcome\[Dash]probability pairs, select the outcomes \
whose first bit is 0 and last bit is 1 (i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "b", ",", "1"}], "}"}], TraditionalForm]],
  ExpressionUUID->"ed695b27-df6b-4807-b6a9-ee298c2b6358"],
 "; ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "843f7a4c-3bc4-4c85-b502-408ba9779227"],
 " can be either 0 or 1, but we do not care)."
}], "ItemNumbered",
 CellChangeTimes->{{3.9683443234486*^9, 3.9683443298891563`*^9}, {
  3.968344476476479*^9, 3.968344585352982*^9}, {3.968344634166768*^9, 
  3.9683446714700403`*^9}, {3.968346688410387*^9, 3.9683466947212954`*^9}, {
  3.970668476735811*^9, 3.970668522952186*^9}, {3.971788846312392*^9, 
  3.9717888650427923`*^9}},
 CellID->2099836181,ExpressionUUID->"f917f51f-4c6f-462b-b39f-921cf7c4a01e"],

Cell["\<\
Extract the probabilities associated with those selected outcomes.\
\>", "ItemNumbered",
 CellChangeTimes->{{3.9683443234486*^9, 3.9683443298891563`*^9}, {
  3.968344476476479*^9, 3.968344585352982*^9}, {3.968344634166768*^9, 
  3.9683446714700403`*^9}, {3.968346688410387*^9, 3.9683466947212954`*^9}, {
  3.970668476735811*^9, 3.9706685056924686`*^9}},
 CellID->200439269,ExpressionUUID->"e0d347bd-e370-45a2-95e8-19c43a6f49f5"],

Cell["Add those probabilities together.", "ItemNumbered",
 CellChangeTimes->{{3.9683443234486*^9, 3.9683443298891563`*^9}, {
  3.968344476476479*^9, 3.968344585352982*^9}, {3.968344634166768*^9, 
  3.9683446714700403`*^9}, {3.968346688410387*^9, 3.9683466947212954`*^9}, {
  3.970668476735811*^9, 3.9706685000561867`*^9}},
 CellID->1528435587,ExpressionUUID->"312968f5-77fe-4ff2-ab4f-4e07d5df6ab3"],

Cell["\<\
We can use the multivariate distribution and compute the full list of outcome\
\[Dash]probability pairs:\
\>", "Text",
 CellChangeTimes->{{3.968338674962756*^9, 3.968338714106701*^9}, {
  3.9692099692433968`*^9, 
  3.96920997155223*^9}},ExpressionUUID->"71b98272-9be2-4908-af4c-\
fccae28e0df4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"prob", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"#", ",", 
       RowBox[{"PDF", "[", 
        RowBox[{"\[ScriptCapitalD]", ",", "#"}], "]"}]}], "}"}], "&"}], "/@", 
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", "3"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", 
  RowBox[{"prob", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["2", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["592", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[TableDepth -> 2, TableHeadings -> {None, 
       Map[Style[#, Bold]& , {"Outcome", "Probability"}]}],
    SelectWithContents->True,
    Selectable->False]}], "]"}]}], "Input",
 CellChangeTimes->{{3.968338667267015*^9, 3.9683386793897867`*^9}, {
  3.968338715954968*^9, 3.968338740208674*^9}, {3.968339496759749*^9, 
  3.968339498023903*^9}, {3.968339562988065*^9, 3.968339623711769*^9}, {
  3.9692067776889057`*^9, 3.969206812667809*^9}, {3.969206844877241*^9, 
  3.969206853159433*^9}},
 CellLabel->
  "In[114]:=",ExpressionUUID->"e8e95732-b8aa-402f-963b-37881300d6d2"],

Cell[BoxData[
 RowBox[{"Total", "@", 
  RowBox[{
   RowBox[{"Select", "[", 
    RowBox[{"prob", ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", "0"}], "&&", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "3"}], "]"}], "]"}], "==", "1"}]}], "&"}]}], 
    "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"All", ",", 
     RowBox[{"-", "1"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.968344286911707*^9, 3.968344321057107*^9}},
 CellLabel->
  "In[116]:=",ExpressionUUID->"bdbf0d64-6d7a-4cb2-954f-c7e12c38b35b"],

Cell["\<\
Now suppose we do not care about qubit 3 and want to focus only on the \
statistics of qubits 1 and 2. To do this, we compute the marginal \
distribution by summing over the outcomes of qubit 3. (In the quantum \
formalism, this corresponds to taking the partial trace over qubit 3 to \
obtain the reduced state of qubits 1 and 2.)\
\>", "Text",
 CellChangeTimes->{{3.9683387696786413`*^9, 3.968338826104653*^9}, 
   3.968338867958982*^9},ExpressionUUID->"bd6f714c-fd45-456b-9e94-\
21baeb91aa59"],

Cell["\<\
To get the marginal distribution, the calculation as follows:
- first group outcomes based on the values of the first and second elements \
(we are only interested in the marginal distribution qubit 1 and 2)
- for each group, add up the values of probabilities\
\>", "Text",
 CellChangeTimes->{{3.9683396735888*^9, 3.9683397394130077`*^9}, {
   3.968342609785865*^9, 3.968342627514386*^9}, 
   3.968342793727981*^9},ExpressionUUID->"531d5ed4-1784-411a-9499-\
f32453e33d0b"],

Cell[BoxData[
 RowBox[{"GroupBy", "[", 
  RowBox[{"prob", ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{";;", "2"}], "]"}], "]"}], "&"}], ")"}], "->", "Last"}], ",", 
   "Total"}], "]"}]], "Input",
 CellChangeTimes->{{3.9683396667035522`*^9, 3.968339668030319*^9}},
 CellLabel->
  "In[117]:=",ExpressionUUID->"e9c3e200-f868-4f57-bc64-ba24fe340c38"],

Cell["\<\
The same process can be done more cleanly using built-in Wolfram Language \
functionality. This makes it much easier to compute other probabilities as \
well (you\[CloseCurlyQuote]ll see this shortly).\
\>", "Text",
 CellChangeTimes->{{3.968342802234582*^9, 3.96834284010005*^9}, 
   3.968342991108684*^9},ExpressionUUID->"d4f27321-3e6b-4ab1-821e-\
0ed86247a4fe"],

Cell["Calculate  the marginal distribution", "Text",
 CellChangeTimes->{{3.968343071721896*^9, 3.9683430828735113`*^9}, 
   3.9683432077817698`*^9},ExpressionUUID->"24f8801f-79fd-49cb-90b6-\
230fdb03a2d7"],

Cell[BoxData[
 RowBox[{"\[ScriptCapitalD]12", "=", 
  RowBox[{"MarginalDistribution", "[", 
   RowBox[{"\[ScriptCapitalD]", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9683388810538483`*^9, 3.9683389257334347`*^9}},
 CellLabel->
  "In[118]:=",ExpressionUUID->"29506a1e-4b66-48cc-834d-c6a1c2a7b44d"],

Cell["\<\
Visualize the contingency table of the marginal distribution:\
\>", "Text",
 CellChangeTimes->{{3.968343056167914*^9, 
  3.968343066604546*^9}},ExpressionUUID->"1a050242-5f57-4b81-b480-\
b6b400b0129d"],

Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"\[ScriptCapitalD]12", ",", "\"\<ProbabilityTable\>\""}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9683395156082172`*^9, 3.96833951607542*^9}},
 CellLabel->
  "In[119]:=",ExpressionUUID->"e5da22c2-d16b-4107-81ba-4188691dd47f"],

Cell["\<\
Calculate the probability of getting 0 for qubit-1 from the marginal \
probability distribution:\
\>", "Text",
 CellChangeTimes->{{3.968343279930684*^9, 3.9683432879877996`*^9}, {
  3.968347171297394*^9, 3.9683471738250303`*^9}, {3.968347282354623*^9, 
  3.968347288384892*^9}, {3.96834733353307*^9, 3.968347334192477*^9}, {
  3.968347404911089*^9, 
  3.9683474072806377`*^9}},ExpressionUUID->"94b64114-68a0-403b-8683-\
f4a7312b503a"],

Cell[BoxData[
 RowBox[{"Probability", "[", 
  RowBox[{
   RowBox[{"q1", "\[Equal]", "0"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1", ",", "q2"}], "}"}], "\[Distributed]", 
    "\[ScriptCapitalD]12"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9683432462218018`*^9, 3.9683432763884373`*^9}},
 CellLabel->
  "In[120]:=",ExpressionUUID->"d2256ad3-67fb-4143-9626-e5d80a1f1261"],

Cell["\<\
Calculate the probability of getting 0 for qubit-1 from the overall \
probability distribution:\
\>", "Text",
 CellChangeTimes->{{3.968343279930684*^9, 3.9683432879877996`*^9}, {
  3.968347171297394*^9, 3.9683471738250303`*^9}, {3.968347282354623*^9, 
  3.968347288384892*^9}, {3.96834733353307*^9, 3.968347340185274*^9}, {
  3.9683474104085197`*^9, 
  3.968347410637444*^9}},ExpressionUUID->"a747127e-94ff-419b-b730-\
fe0c74c7ca25"],

Cell[BoxData[
 RowBox[{"Probability", "[", 
  RowBox[{
   RowBox[{"q1", "\[Equal]", "0"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}], "\[Distributed]", 
    "\[ScriptCapitalD]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9683471801529303`*^9, 3.9683471823847637`*^9}},
 CellLabel->
  "In[121]:=",ExpressionUUID->"db5c68dc-3b88-41a4-93b1-b535df161220"],

Cell["\<\
Let\[CloseCurlyQuote]s focus again on the computation that we did for finding \
two-dimensional marginal distribution from the three dimensional one, by \
averaging over third system:\
\>", "Text",
 CellChangeTimes->{{3.969217736782476*^9, 3.969217762558445*^9}, {
  3.96921779844172*^9, 
  3.9692178193252287`*^9}},ExpressionUUID->"3b496aea-487c-411a-95e3-\
eb8ff97385fc"],

Cell[BoxData[
 RowBox[{"\[ScriptCapitalD]", "->", 
  RowBox[{"MarginalDistribution", "[", 
   RowBox[{"\[ScriptCapitalD]", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.969217747061429*^9, 3.9692177482770977`*^9}},
 CellLabel->
  "In[122]:=",ExpressionUUID->"14b017ec-ba91-438e-9bb5-308fe0e069ca"],

Cell["\<\
The analysis above used standard probability theory throughout; only the \
initial probabilities were derived from quantum mechanics. That said, the \
rules of quantum theory provide a recipe for obtaining the quantum state of \
qubits 1 and 2 by averaging over all contributions from qubit 3, and thus \
getting probabilities directly from a new quantum state. For this aim, one \
should trace over the degrees of freedom of qubit 3, which yields the reduced \
state for qubits 1 and 2.\
\>", "Text",
 CellChangeTimes->{{3.968347608460641*^9, 3.968347618114686*^9}, {
  3.968347694369904*^9, 3.968347725796362*^9}, {3.9683483774023848`*^9, 
  3.9683484078304653`*^9}, {3.968348472196415*^9, 3.9683484806477013`*^9}, {
  3.969217822760223*^9, 
  3.969217923007019*^9}},ExpressionUUID->"6ac2ebd6-854d-4e1d-a970-\
a5c310aea857"],

Cell["\<\
Trace out the qubit-3 (which is the 3rd subsystem) from the overall state:\
\>", "Text",
 CellChangeTimes->{{3.96834913803797*^9, 
  3.9683491518502893`*^9}},ExpressionUUID->"1c618c28-846a-4cc2-9928-\
dab4b7e15f7d"],

Cell[BoxData[
 RowBox[{"QuantumPartialTrace", "[", 
  RowBox[{"state", ",", 
   RowBox[{"{", "3", "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.968348413703866*^9, 3.9683484146103067`*^9}},
 CellLabel->
  "In[123]:=",ExpressionUUID->"83a7191c-f034-430a-ad43-cecfd931c147"],

Cell["\<\
Note what happened: the three-qubit state was pure, but the reduced state of \
qubits 1 and 2 is mixed (after tracing out qubit 3, due to entanglement).\
\>", "Text",
 CellChangeTimes->{{3.969217934630929*^9, 
  3.969217981598363*^9}},ExpressionUUID->"dce239af-7d73-4cfb-b63b-\
668ddb095410"],

Cell["\<\
As expected, this reduced state yields the same marginal probabilities as \
before:\
\>", "Text",
 CellChangeTimes->{{3.968348432601138*^9, 3.9683484444804983`*^9}, 
   3.9683486123255367`*^9, {3.9692179968342752`*^9, 
   3.969217999413041*^9}},ExpressionUUID->"1cb318dd-c1e9-40c2-a8d0-\
64d8db39a2bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumPartialTrace", "[", 
   RowBox[{"state", ",", 
    RowBox[{"{", "3", "}"}]}], "]"}], "[", "\"\<Probabilities\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{3.968348418703348*^9, 3.9683484257486973`*^9}, {
  3.968348807351156*^9, 3.968348807780431*^9}},
 CellLabel->
  "In[124]:=",ExpressionUUID->"0267f8e5-4c56-458e-a333-cfefc3e83e9f"],

Cell["Show the probabilities obtained from marginal distribution:", "Text",
 CellChangeTimes->{{3.9692180086138773`*^9, 
  3.9692180226530943`*^9}},ExpressionUUID->"90d991ad-cb8f-48c9-a335-\
f4db932779e8"],

Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"\[ScriptCapitalD]12", ",", "\"\<Probabilities\>\""}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.968348993820956*^9, 3.9683490200113792`*^9}},
 CellLabel->
  "In[125]:=",ExpressionUUID->"1c2e5608-80be-4694-a3e7-9d740c5fe211"],

Cell["\<\
In future chapters, we will discuss in details the idea of tracing out a \
subsystem and how to describe the state of composite systems in quantum \
theory.\
\>", "Text",
 CellChangeTimes->{{3.968348724077909*^9, 
  3.968348784413887*^9}},ExpressionUUID->"393327d8-dd18-4df6-8a36-\
8f1bfaa26c40"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Quantum States: Multi-Particle Cases", "Chapter",
 CellChangeTimes->{{3.944662887397749*^9, 3.944662891885006*^9}, 
   3.9446629743009224`*^9, 3.968337128953205*^9, {3.9683495172391033`*^9, 
   3.968349528261919*^9}, {3.968349689865692*^9, 3.968349690463126*^9}, {
   3.9684080550787992`*^9, 3.968408065769932*^9}, {3.969213383647562*^9, 
   3.969213391951494*^9}},ExpressionUUID->"982276ce-5075-40e9-97b5-\
2618e9e7bb89"],

Cell["\<\
We will discuss the tensoring of vector spaces, which provides a recipe for \
constructing larger systems from smaller ones. This recipe comes with some \
unique features. For example, there exist states that cannot be written as a \
tensor product of smaller states. We will examine these states and their \
distinctive feature: entanglement.\
\>", "Text",
 CellChangeTimes->{{3.9683351418507547`*^9, 3.968335145248692*^9}, {
  3.968337132871228*^9, 3.968337135575295*^9}, {3.968349674120285*^9, 
  3.9683496759193697`*^9}, {3.968411141693409*^9, 3.968411209122325*^9}, {
  3.968411303077074*^9, 
  3.968411314667409*^9}},ExpressionUUID->"61a34fd3-a57a-457c-99ff-\
5294b35423f8"],

Cell[CellGroupData[{

Cell["Key Concepts", "Section",
 CellChangeTimes->{{3.9442479373933716`*^9, 
  3.944247939017521*^9}},ExpressionUUID->"fb1c4ec2-f25c-4c76-a801-\
3fa29606ddc4"],

Cell["Tensor product", "Item",
 CellChangeTimes->{{3.944247943963133*^9, 3.9442479547025547`*^9}, 
   3.968349671754785*^9, {3.968409929205969*^9, 3.968409931901044*^9}, {
   3.969383542802808*^9, 
   3.969383549827654*^9}},ExpressionUUID->"2ed32bfd-42cd-46b9-840c-\
fd542822b529"],

Cell["Kronecker product", "Item",
 CellChangeTimes->{{3.944247943963133*^9, 3.944247958262329*^9}, 
   3.968349677939341*^9, {3.9684099328517714`*^9, 
   3.968409938055585*^9}},ExpressionUUID->"0f9fa15e-cd41-42ca-963c-\
332b28c8af44"],

Cell["Composite systems", "Item",
 CellChangeTimes->{{3.944247943963133*^9, 3.944247960345806*^9}, 
   3.9683496791701117`*^9, {3.968409939039494*^9, 3.9684099462361298`*^9}, {
   3.969275716000348*^9, 
   3.969275716006859*^9}},ExpressionUUID->"5ff3a503-52a7-4261-93a3-\
969463fa6bcf"],

Cell["Separable states vs entangled states", "Item",
 CellChangeTimes->{{3.944247943963133*^9, 3.944247960345806*^9}, 
   3.9683496791701117`*^9, {3.968409939039494*^9, 3.9684099462361298`*^9}, {
   3.969275716542651*^9, 
   3.96927572495693*^9}},ExpressionUUID->"fe996701-ce2c-4a1f-b8de-\
8eddb8432cfa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tensor Product Structure", "Section",
 CellChangeTimes->{{3.9683496865121317`*^9, 3.968349687336903*^9}, {
  3.9684099092819843`*^9, 3.968409915787979*^9}, {3.969977073503502*^9, 
  3.969977075443471*^9}},ExpressionUUID->"0e73e77b-89d2-40ec-bfea-\
4fc5444170cf"],

Cell["\<\
Consider a quantum system that is a qubit. This means its state lives in a \
2-dimensional Hilbert space. The corresponding computational basis elements \
are\
\>", "Text",
 CellChangeTimes->{{3.968408076652995*^9, 3.968408115136784*^9}, 
   3.968408627809394*^9},ExpressionUUID->"ba77a47a-7d81-41d8-8012-\
8f80cc147ffd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", "2", "]"}], "[", "\"\<Association\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{3.9684081166382627`*^9, 3.968408124222184*^9}},
 CellLabel->
  "In[126]:=",ExpressionUUID->"2e09a7aa-b242-4050-97f5-d5e127db0d0d"],

Cell["\<\
Of course, quantum systems can have other dimensions. For example, consider a \
3-dimensional Hilbert space (a qutrit). The corresponding computational basis \
elements are\
\>", "Text",
 CellChangeTimes->{{3.968408132584638*^9, 3.968408163851523*^9}, 
   3.968408643807416*^9},ExpressionUUID->"61d42f57-7404-49fe-938b-\
e06142b29454"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", "3", "]"}], "[", "\"\<Association\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{3.968408169231956*^9, 3.968408169501425*^9}},
 CellLabel->
  "In[127]:=",ExpressionUUID->"8be6cc32-c226-4e6e-b2a0-6628aedc31c8"],

Cell[TextData[{
 "Or consider a 4-dimensional Hilbert space (a ququart, i.e., a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "4"}], TraditionalForm]],ExpressionUUID->
  "72485cff-b305-45bf-90c0-397d8a006a9f"],
 " qudit). The corresponding computational basis elements are:"
}], "Text",
 CellChangeTimes->{{3.968408172257228*^9, 3.968408181284606*^9}, {
  3.968408658088986*^9, 
  3.9684086848635798`*^9}},ExpressionUUID->"8c65c309-9a7a-4ca6-b9f0-\
c830d0b4d0a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumBasis", "[", "4", "]"}], "[", "\"\<Association\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{3.968408185627795*^9, 3.96840818585921*^9}},
 CellLabel->
  "In[128]:=",ExpressionUUID->"5f2ed095-33f2-47a7-98c5-3f1dbffb9f6b"],

Cell["\<\
Now consider a composite system made of two qubits. How can we construct the \
larger space from the Hilbert spaces of the single qubits? This is the \
fundamental idea behind the tensor product.\
\>", "Text",
 CellChangeTimes->{{3.96840825055856*^9, 3.968408309693502*^9}, 
   3.96840870381185*^9},ExpressionUUID->"a24e1533-ea66-481d-b23d-\
c041f180e5f9"],

Cell[TextData[{
 "If we have a composite system of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "441fdd0b-a050-4655-8878-d23f534cc32d"],
 " and ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],ExpressionUUID->
  "7699979b-72e5-432b-8ca2-dce15ab41892"],
 " with Hilbert spaces ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalH]", "A"], TraditionalForm]],ExpressionUUID->
  "a0d80b7a-3cbc-45f1-b69a-74c27eeae2bb"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalH]", "B"], TraditionalForm]],ExpressionUUID->
  "8e65fd5a-5e34-4d36-939e-6e803c705365"],
 ", then the composite system lives in the larger space ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalH]", "A"], "\[CircleTimes]", 
    SubscriptBox["\[ScriptCapitalH]", "B"]}], TraditionalForm]],
  ExpressionUUID->"47bd6b63-26f2-44af-b3e9-bd96ad2e949f"],
 ", where \[CircleTimes] (the tensor product) means we keep track of both \
systems at once. The tensor product is a way of combining vector spaces (and \
vectors) to form a larger space. For finite-dimensional spaces, the Kronecker \
product gives the matrix/tensor representation of the tensor product. "
}], "Text",
 CellChangeTimes->{{3.968408312843883*^9, 3.968408424499954*^9}, {
   3.968408733915766*^9, 3.9684087879005136`*^9}, {3.968408871713707*^9, 
   3.968408878365244*^9}, 3.9692278153504057`*^9, {3.9695479844513702`*^9, 
   3.9695479870594683`*^9}, {3.971796856429346*^9, 
   3.9717968587789593`*^9}},ExpressionUUID->"134a0054-b33d-4a09-b242-\
08bcce8be9b9"],

Cell[TextData[{
 "Consider the case where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalH]", "A"], TraditionalForm]],ExpressionUUID->
  "94384e41-582f-4da7-812d-88a0ec279109"],
 " is 2-dimensional and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalH]", "B"], TraditionalForm]],ExpressionUUID->
  "863f8206-06c9-44ab-84cf-4c4afb25f8d9"],
 " is 3-dimensional. The corresponding basis elements are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"0"},
      "Ket"], ",", 
     TemplateBox[{"1"},
      "Ket"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "b405c872-1454-4380-8df4-e8fcf7d7e60e"],
 " for ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ed0104b6-8f86-4123-8c5d-ef2774cdea90"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"0"},
      "Ket"], ",", 
     TemplateBox[{"1"},
      "Ket"], ",", 
     TemplateBox[{"2"},
      "Ket"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "a0573273-89e7-4f76-825c-3e698efbb2ec"],
 " for ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8a66ff24-6f7c-45b4-9e2d-79b22ce9313a"],
 ". The composite system then has dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "\[Times]", "3"}], "=", "6"}], TraditionalForm]],
  ExpressionUUID->"df66e51f-f45f-41ae-88db-d414c186fe32"],
 ". Its computational basis is formed by tensoring the single-system basis \
states:",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"00"},
     "Ket"], "=", 
    RowBox[{
     SubscriptBox[
      TemplateBox[{"0"},
       "Ket"], "A"], "\[CircleTimes]", 
     SubscriptBox[
      TemplateBox[{"0"},
       "Ket"], "B"]}]}], TraditionalForm]],ExpressionUUID->
  "9e3b0ff3-737b-4258-b9a2-f076a7522f39"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"01"},
     "Ket"], "=", 
    RowBox[{
     SubscriptBox[
      TemplateBox[{"0"},
       "Ket"], "A"], "\[CircleTimes]", 
     SubscriptBox[
      TemplateBox[{"1"},
       "Ket"], "B"]}]}], TraditionalForm]],ExpressionUUID->
  "c44a6a04-b4bc-4e45-8cd8-09aa41ad68e8"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"02"},
     "Ket"], "=", 
    RowBox[{
     SubscriptBox[
      TemplateBox[{"0"},
       "Ket"], "A"], "\[CircleTimes]", 
     SubscriptBox[
      TemplateBox[{"1"},
       "Ket"], "B"]}]}], TraditionalForm]],ExpressionUUID->
  "34b80c94-e2fb-4083-8ea3-b198a091eb5c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"10"},
     "Ket"], "=", 
    RowBox[{
     SubscriptBox[
      TemplateBox[{"1"},
       "Ket"], "A"], "\[CircleTimes]", 
     SubscriptBox[
      TemplateBox[{"0"},
       "Ket"], "B"]}]}], TraditionalForm]],ExpressionUUID->
  "ea3da810-b98f-4b98-af4d-186a1554667c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"11"},
     "Ket"], "=", 
    RowBox[{
     SubscriptBox[
      TemplateBox[{"1"},
       "Ket"], "A"], "\[CircleTimes]", 
     SubscriptBox[
      TemplateBox[{"1"},
       "Ket"], "B"]}]}], TraditionalForm]],ExpressionUUID->
  "aa659e87-5ee9-4996-b77c-d45f7dc9c6ac"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"12"},
     "Ket"], "=", 
    RowBox[{
     SubscriptBox[
      TemplateBox[{"1"},
       "Ket"], "A"], "\[CircleTimes]", 
     SubscriptBox[
      TemplateBox[{"1"},
       "Ket"], "B"]}]}], TraditionalForm]],ExpressionUUID->
  "52283fe8-8420-4431-8d70-978c6cd75cc9"],
 ". Therefore, a label such as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"11"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "6eab46d3-10b1-4fa8-9f1d-459997b22a86"],
 " by itself is ambiguous unless dimensions are specified. By default, assume \
qubits unless stated otherwise."
}], "Text",
 CellChangeTimes->{{3.968408813676058*^9, 3.968408867473757*^9}, {
  3.968408933578343*^9, 3.968408935300968*^9}, {3.968409037418096*^9, 
  3.96840929451558*^9}, {3.969227823378251*^9, 3.969227832092284*^9}, {
  3.969548027106056*^9, 3.969548188070611*^9}, {3.972485911762878*^9, 
  3.972485914712038*^9}},ExpressionUUID->"913e06b4-0eca-49ef-9fb0-\
c06d8eea1e5f"],

Cell["\<\
The exact computation for basis tensoring is done as follows:\
\>", "Text",
 CellChangeTimes->{{3.968408813676058*^9, 3.968408867473757*^9}, {
  3.968408933578343*^9, 3.968408935300968*^9}, {3.968409037418096*^9, 
  3.96840929451558*^9}, {3.969227823378251*^9, 3.969227832092284*^9}, {
  3.969548077707716*^9, 
  3.969548079903113*^9}},ExpressionUUID->"e137ee2a-e59a-4c82-9461-\
9012d1a215f7"],

Cell[BoxData[
 RowBox[{"MatrixForm", "/@", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"Outer", "[", 
     RowBox[{"KroneckerProduct", ",", 
      RowBox[{
       RowBox[{"QuantumBasis", "[", "2", "]"}], "[", "\"\<Elements\>\"", 
       "]"}], ",", 
      RowBox[{
       RowBox[{"QuantumBasis", "[", "3", "]"}], "[", "\"\<Elements\>\"", 
       "]"}], ",", "1"}], "]"}], ",", "1"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.968408936248364*^9, 3.9684090140970507`*^9}, {
  3.968409407559616*^9, 3.9684094236320667`*^9}},
 CellLabel->
  "In[129]:=",ExpressionUUID->"0fe95266-73bc-4236-9c8d-3b02858caaad"],

Cell["\<\
There are some minor details regarding the shapes of arrays after tensoring, \
which we\[CloseCurlyQuote]ll skip for now. The good news is that this \
tensor-product structure is fully supported in the Wolfram Quantum Framework: \
you can obtain the corresponding computational basis of a composite system \
simply by supplying the dimensions of the subsystems. For example:\
\>", "Text",
 CellChangeTimes->{{3.9684092970380993`*^9, 
  3.9684093796343117`*^9}},ExpressionUUID->"765708b8-49e4-4776-a61d-\
4b86387869f9"],

Cell[BoxData[
 RowBox[{"MatrixForm", "/@", 
  RowBox[{
   RowBox[{"QuantumBasis", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], "]"}], "[", "\"\<Association\>\"", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.968409381837322*^9, 3.9684093971671677`*^9}, {
  3.968409435045389*^9, 3.96840943662845*^9}},
 CellLabel->
  "In[130]:=",ExpressionUUID->"40380ba1-7925-463a-97a2-b3edf6c2260e"],

Cell["\<\
This idea of tensoring applies directly to quantum states and operators. For \
example, we can create the composite state of a two-qubit system from its \
subsystem states:\
\>", "Text",
 CellChangeTimes->{{3.968409467901236*^9, 3.9684095088105173`*^9}, 
   3.968409586494981*^9},ExpressionUUID->"d5d73f96-7daf-4e21-9b30-\
dd6109d3e14d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"state1", "=", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]1", ",", "\[Beta]1"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"state2", "=", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]2", ",", "\[Beta]2"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"QuantumTensorProduct", "[", 
  RowBox[{"state1", ",", "state2"}], "]"}]}], "Input",
 CellChangeTimes->{{3.968409511773069*^9, 3.968409539527437*^9}},
 CellLabel->
  "In[131]:=",ExpressionUUID->"66f82dea-7156-4dbb-99ab-75c7fbfb4e36"],

Cell["Show the traditional form of above composite state:", "Text",
 CellChangeTimes->{{3.968409556589511*^9, 
  3.968409566394712*^9}},ExpressionUUID->"5a75e7bc-1286-4477-8b30-\
46b557d3ebbd"],

Cell[BoxData[
 RowBox[{"%", "//", "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.968409544166806*^9, 3.968409546557006*^9}},
 CellLabel->
  "In[134]:=",ExpressionUUID->"adbbab95-7232-435a-b198-49fa96c22123"],

Cell["\<\
As another example, let\[CloseCurlyQuote]s create a composite (i.e., \
multi-particle) operator as Pauli-Z acting on qubit 1 and Pauli-Y acting on \
qubit 2:\
\>", "Text",
 CellChangeTimes->{{3.9684096073983393`*^9, 3.9684096651939917`*^9}, {
  3.9684097418606863`*^9, 
  3.968409742158525*^9}},ExpressionUUID->"125f7e36-cb34-403a-a346-\
32f4909635db"],

Cell[BoxData[
 RowBox[{"QuantumTensorProduct", "[", 
  RowBox[{
   RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], ",", 
   RowBox[{"QuantumOperator", "[", "\"\<Y\>\"", "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.968409666378343*^9, 3.968409676335878*^9}, {
  3.9684097387520447`*^9, 3.9684097399361763`*^9}},
 CellLabel->
  "In[135]:=",ExpressionUUID->"3d7af775-efcc-4709-bc1c-29af63c8509c"],

Cell["Show the matrix form explicitly:", "Text",
 CellChangeTimes->{{3.968409694015019*^9, 
  3.968409701168692*^9}},ExpressionUUID->"98f02642-122e-4196-a8c3-\
6d01b8157264"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", "\"\<ZY\>\"", "]"}], "[", "\"\<Matrix\>\"",
    "]"}], "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.968409679377442*^9, 3.9684096848199863`*^9}, {
  3.969300492690219*^9, 3.9693004951594143`*^9}},
 CellLabel->
  "In[136]:=",ExpressionUUID->"9c3abe0c-3c4d-41f2-b085-07a31e476ca2"],

Cell[TextData[{
 "As you can see, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Z", "\[CircleTimes]", "Y"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2bf82c5d-ca32-4d2f-a3ab-2e231c543858"],
 " is formed by placing blocks of Y multiplied by the elements of Z in the \
corresponding positions: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Z", "\[CircleTimes]", "Y"}], "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{"1", "\[Times]", "Y"}], 
         RowBox[{"0", "\[Times]", "Y"}]},
        {
         RowBox[{"0", "\[Times]", "Y"}], 
         RowBox[{
          RowBox[{"-", "1"}], "\[Times]", "Y"}]}
       }], ")"}], "=", 
     RowBox[{
      RowBox[{"(", GridBox[{
         {"Y", "0"},
         {"0", 
          RowBox[{"-", "Y"}]}
        }], ")"}], "=", 
      TagBox[
       RowBox[{"(", "\[NoBreak]", GridBox[{
          {"0", 
           RowBox[{"-", "\[ImaginaryI]"}], "0", "0"},
          {"\[ImaginaryI]", "0", "0", "0"},
          {"0", "0", "0", "\[ImaginaryI]"},
          {"0", "0", 
           RowBox[{"-", "\[ImaginaryI]"}], "0"}
         },
         GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
         GridBoxSpacings->{"Columns" -> {
             Offset[0.27999999999999997`], {
              Offset[0.7]}, 
             Offset[0.27999999999999997`]}, "Rows" -> {
             Offset[0.2], {
              Offset[0.4]}, 
             Offset[0.2]}}], "\[NoBreak]", ")"}],
       Function[BoxForm`e$, 
        MatrixForm[
        SparseArray[
         Automatic, {4, 4}, 0, {
          1, {{0, 1, 2, 3, 4}, {{2}, {1}, {4}, {3}}}, {
           Complex[0, -1], Complex[0, 1], Complex[0, 1], Complex[
            0, -1]}}]]]]}]}]}], TraditionalForm]],ExpressionUUID->
  "d6769b8f-6d88-46c5-8557-2e7e24346758"]
}], "Text",
 CellChangeTimes->{{3.968409707782013*^9, 3.968409879602915*^9}, {
  3.969227910038389*^9, 
  3.969227912046604*^9}},ExpressionUUID->"42d40032-27d2-4297-8040-\
265f093c3405"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Separable vs Nonseparable Objects", "Section",
 CellChangeTimes->{{3.9684111278266973`*^9, 3.9684111352721367`*^9}, {
  3.969548345379794*^9, 3.969548357904715*^9}, {3.969977076654624*^9, 
  3.969977078709733*^9}},ExpressionUUID->"b28d351a-4fcc-4d9f-b3b2-\
937bbfe175ff"],

Cell["\<\
An important point is this: the larger space built from smaller spaces can \
contain elements (states or operators) that cannot be written as a simple \
tensor product of two elements. For now, we will focus only on quantum states.\
\>", "Text",
 CellChangeTimes->{{3.968410288112801*^9, 3.968410406649589*^9}, {
  3.969227951350588*^9, 
  3.969227952178526*^9}},ExpressionUUID->"bb0a60cb-1717-4268-9a38-\
8b3f0a486de2"],

Cell[TextData[{
 "Rephrasing the question: given a composite state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"\[CapitalPsi]"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "1c45dc8a-00af-4e75-b071-b06710644bda"],
 " in the Hilbert space ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalH]", "A"], "\[CircleTimes]", 
    SubscriptBox["\[ScriptCapitalH]", "B"]}], TraditionalForm]],
  ExpressionUUID->"5829ffb0-436d-44a9-a91c-dc4465e9d7bd"],
 ", is it always possible to write ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"\[CapitalPsi]"},
     "Ket"], 
    OverscriptBox["=", "?"], 
    RowBox[{
     SubscriptBox[
      TemplateBox[{"\[Psi]"},
       "Ket"], "A"], "\[CircleTimes]", 
     SubscriptBox[
      TemplateBox[{"\[Psi]"},
       "Ket"], "B"]}]}], TraditionalForm]],ExpressionUUID->
  "4d95c2b4-1146-4a49-b3f0-57d2f35e3119"],
 "\n\nNo. States that cannot be written in this form are called ",
 StyleBox["entangled",
  FontSlant->"Italic"],
 " (i.e., non-separable). Entangled states have distinctive features: their \
corresponding measurement probabilities exhibit correlations that cannot \
arise in a classical setting. We will explore these correlations in more \
detail later. For now, let\[CloseCurlyQuote]s explore some special cases."
}], "Text",
 CellChangeTimes->{{3.968410288112801*^9, 3.968410406649589*^9}, {
  3.969227951350588*^9, 3.969228005028389*^9}, {3.969548269249229*^9, 
  3.9695482698064327`*^9}},ExpressionUUID->"9908b5b9-d985-42d0-980e-\
d6a0607de154"],

Cell["Consider a uniform superposition of a two qubit system:", "Text",
 CellChangeTimes->{{3.9684104107374163`*^9, 3.968410411623115*^9}, {
  3.968410447248815*^9, 
  3.968410460677074*^9}},ExpressionUUID->"11a9bb3a-ac68-4b47-bd5a-\
2411c0890f53"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalPsi]", "=", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<UniformSuperposition\>\"", ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[CapitalPsi]", "//", "TraditionalForm"}]}], "Input",
 CellChangeTimes->{{3.968410413461988*^9, 3.968410443209103*^9}},
 CellLabel->
  "In[137]:=",ExpressionUUID->"2a423874-ae74-4f8b-821c-10a580192535"],

Cell["\<\
The above state can be obtained by two Hadamard operators acting on 2-qubit \
register state:\
\>", "Text",
 CellChangeTimes->{{3.968410477043398*^9, 3.968410505422546*^9}, 
   3.969548288052984*^9},ExpressionUUID->"b8fcd2fc-e3c5-4bde-af70-\
d2c8a20ebfda"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", "\"\<HH\>\"", "]"}], "[", "]"}], "==", 
  "\[CapitalPsi]"}]], "Input",
 CellChangeTimes->{{3.968410462587184*^9, 3.968410474010683*^9}},
 CellLabel->
  "In[139]:=",ExpressionUUID->"9caed385-fb25-4a10-bdcd-ce7dc221adb6"],

Cell[TextData[{
 "Since the operators are separable\[LongDash]meaning we apply two \
independent operations on qubit 1 and qubit 2\[LongDash]we expect the overall \
state to remain separable, provided the initial state is separable. In other \
words, local operations of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "\[CircleTimes]", "B"}], TraditionalForm]],ExpressionUUID->
  "676f100c-4691-40b3-84f2-d41a9aa36cb9"],
 ", in this case ",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", "\[CircleTimes]", "H"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0bd9013b-9acc-4700-be93-fd0dc145a69a"],
 ", cannot create entanglement. Let\[CloseCurlyQuote]s check that."
}], "Text",
 CellChangeTimes->{{3.968410541176877*^9, 3.968410576253174*^9}, {
  3.968410643864287*^9, 3.968410674814869*^9}, {3.969228036368445*^9, 
  3.9692280548065434`*^9}},ExpressionUUID->"74c680f4-1393-426c-acce-\
12a9a455bc86"],

Cell["Create uniform superposition of qubit 1 and 2:", "Text",
 CellChangeTimes->{{3.968410676707078*^9, 
  3.9684106863002996`*^9}},ExpressionUUID->"46e37972-2e91-433e-978b-\
2e117b0d626e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]A", "=", 
   RowBox[{"\[Psi]B", "=", 
    RowBox[{"QuantumState", "[", "\"\<UniformSuperposition\>\"", "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.96841057743185*^9, 3.9684106078085327`*^9}},
 CellLabel->
  "In[140]:=",ExpressionUUID->"ac95a8c7-ccc8-430b-a5bc-564b9207c175"],

Cell["Create the corresponding tensor product state:", "Text",
 CellChangeTimes->{{3.968410688146203*^9, 
  3.968410697304586*^9}},ExpressionUUID->"99b33ca5-67ea-48a4-b71b-\
3faf7505d2af"],

Cell[BoxData[
 RowBox[{"\[CapitalPsi]2", "=", 
  RowBox[{"QuantumTensorProduct", "[", 
   RowBox[{"\[Psi]A", ",", "\[Psi]A"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.96841057743185*^9, 3.9684106078085327`*^9}},
 CellLabel->
  "In[141]:=",ExpressionUUID->"326a357d-bd3b-4260-be15-72b9a0601dd1"],

Cell["Check the new state is the same as the previous one:", "Text",
 CellChangeTimes->{{3.968410699769313*^9, 
  3.9684107065608063`*^9}},ExpressionUUID->"7853c1bd-81ab-4984-b624-\
01ab1ef7cedc"],

Cell[BoxData[
 RowBox[{"\[CapitalPsi]2", "==", "\[CapitalPsi]"}]], "Input",
 CellChangeTimes->{{3.9684107127150307`*^9, 3.9684107138645144`*^9}},
 CellLabel->
  "In[142]:=",ExpressionUUID->"ac8bf42e-8dcf-41d1-a448-a67a06813912"],

Cell["\<\
How, in general, can we check whether a state is separable? A systematic way \
to handle the general cases is the Schmidt decomposition. It says that any \
two-part pure state can be expressed as a sum of paired basis states for the \
two subsystems, each paired term weighted by a nonnegative number called a \
Schmidt coefficient. The state is separable exactly when there is only one \
nonzero Schmidt coefficient. In that situation, the state reduces to a single \
paired basis term (often called the Schmidt basis form), which means it is a \
simple product state rather than an entangled one.\
\>", "Text",
 CellChangeTimes->{{3.968410723154612*^9, 3.968410792767116*^9}, 
   3.9684108919403048`*^9, {3.969228080876906*^9, 
   3.969228116960305*^9}},ExpressionUUID->"f36f02e7-788e-4d93-a373-\
3ac57bd104e6"],

Cell["\<\
In the Wolfram quantum framework, you only need to transform the state into \
its Schmidt basis and check Schmidt coefficients.\
\>", "Text",
 CellChangeTimes->{{3.969228145651819*^9, 
  3.9692281780114727`*^9}},ExpressionUUID->"10486d27-4cec-423d-abee-\
927fc5db8ba7"],

Cell["Show the composite state after the Schmidt decomposition:", "Text",
 CellChangeTimes->{{3.968410902548163*^9, 3.9684109121183157`*^9}, {
  3.969548379141425*^9, 
  3.969548379603531*^9}},ExpressionUUID->"0dab2182-29da-4bf5-b0c0-\
4d77510d7918"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalPsi]", "[", "\"\<SchmidtBasis\>\"", "]"}], "//", 
  "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.968410517722897*^9, 3.9684105269390783`*^9}},
 CellLabel->
  "In[143]:=",ExpressionUUID->"bac1baa5-0fe3-4399-a990-fb3391b3313e"],

Cell[TextData[{
 "As expected, since the state ",
 Cell[BoxData[
  FormBox["\[CapitalPsi]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3f07e63e-91e7-4707-89e8-dcee6bd35fef"],
 " was created as a product-state, there is only one non-zero Schmidt \
coefficient."
}], "Text",
 CellChangeTimes->{{3.969228188354868*^9, 
  3.969228231187159*^9}},ExpressionUUID->"8e5c8aaa-9570-49ca-89b8-\
27af082f62ff"],

Cell["Show amplitudes in the Schmidt basis:", "Text",
 CellChangeTimes->{{3.968410809441421*^9, 3.9684108140259953`*^9}, 
   3.968410883435645*^9},ExpressionUUID->"7fd7d337-ddb1-4626-be7a-\
c6c19bf61c71"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalPsi]", "[", "\"\<SchmidtBasis\>\"", "]"}], 
  "[", "\"\<Amplitudes\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.9684108013835506`*^9, 3.9684108060001097`*^9}},
 CellLabel->
  "In[144]:=",ExpressionUUID->"90f4a5d7-b9c7-42da-9f56-6529ef7d3e15"],

Cell["\<\
Now let\[CloseCurlyQuote]s consider another example. We will use one of Bell \
states\
\>", "Text",
 CellChangeTimes->{{3.968410920611128*^9, 3.968410955775416*^9}, 
   3.969228240143268*^9},ExpressionUUID->"bdb843ca-3f4a-4a7c-8abc-\
8b72d56fe55b"],

Cell[BoxData[
 RowBox[{"bell", "=", 
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}]}], "]"}], "[", "\"\<Normalize\>\"", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.968410959048236*^9, 3.9684109856363487`*^9}},
 CellLabel->
  "In[145]:=",ExpressionUUID->"15717754-3298-42ef-9334-f01f54a18490"],

Cell["Show its Dirac notation:", "Text",
 CellChangeTimes->{{3.9684110522464*^9, 
  3.968411055442834*^9}},ExpressionUUID->"8bc3b477-06e9-4e47-b201-\
efa1aca1039a"],

Cell[BoxData[
 RowBox[{"bell", "//", "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.968410989844425*^9, 3.968410990853305*^9}},
 CellLabel->
  "In[146]:=",ExpressionUUID->"fce06fe7-8394-424d-a3c3-a33c5eab201b"],

Cell["\<\
As we can see from the Schmidt decomposition, there is more than one nonzero \
Schmidt coefficient. This means the state is not separable; in other words, \
it is entangled.\
\>", "Text",
 CellChangeTimes->{{3.968411008552771*^9, 
  3.9684110635286913`*^9}},ExpressionUUID->"8d9355dc-ab81-4447-9f2a-\
82c770ed5374"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bell", "[", "\"\<SchmidtBasis\>\"", "]"}], 
  "[", "\"\<Amplitudes\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.968410995285918*^9, 3.968411004993248*^9}},
 CellLabel->
  "In[147]:=",ExpressionUUID->"5add4e25-d191-4164-992e-e69d8bcfcdb7"],

Cell["Check the state is entangled:", "Text",
 CellChangeTimes->{{3.9684110680564623`*^9, 
  3.968411084249998*^9}},ExpressionUUID->"6980d516-8e54-4ce7-9b33-\
52a8f9cc41ff"],

Cell[BoxData[
 RowBox[{"QuantumEntangledQ", "[", "bell", "]"}]], "Input",
 CellChangeTimes->{{3.968411078110799*^9, 3.968411081235929*^9}},
 CellLabel->
  "In[148]:=",ExpressionUUID->"486b80df-31a0-452e-88ac-aeb00384b5c3"],

Cell["\<\
An important question is how to quantify entanglement. We will cover standard \
measures and criteria in the next chapter.\
\>", "Text",
 CellChangeTimes->{{3.9692282696473827`*^9, 
  3.969228320470058*^9}},ExpressionUUID->"72467153-68ee-4f9e-aaab-\
4a1dc980e0d6"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Superposition and Entanglement", "Chapter",
 CellChangeTimes->{{3.9446647815387936`*^9, 
  3.9446648144354954`*^9}},ExpressionUUID->"1cd02937-82c6-45f4-96af-\
b9a89da84be3"],

Cell["\<\
We will discuss the concepts of quantum superposition and entanglement in \
more detail. We will show how a linear combination of quantum states can look \
different from one basis to another, and how this relates to whether states \
are separable or entangled. We will then explain how to test whether a state \
is entangled and how to quantify the amount of entanglement.\
\>", "Text",
 CellChangeTimes->{{3.968337801010654*^9, 3.9683378020725813`*^9}, {
   3.9684145563656807`*^9, 3.968414625392131*^9}, 
   3.968414708499058*^9},ExpressionUUID->"72f04830-c447-4382-aadd-\
ac5fafaead6c"],

Cell[CellGroupData[{

Cell["Key Concepts", "Section",
 CellChangeTimes->{{3.944336548792145*^9, 
  3.9443365503924484`*^9}},ExpressionUUID->"be3aa473-c335-4a5c-bdff-\
0aee2ae76cbc"],

Cell["Superposition", "Item",
 CellChangeTimes->{{3.9443365580642242`*^9, 
  3.9443365679602833`*^9}},ExpressionUUID->"5c6be012-f958-448c-b5f7-\
556f97e89cd6"],

Cell["Entanglement", "Item",
 CellChangeTimes->{{3.9443365580642242`*^9, 3.944336560928747*^9}, {
  3.9443388422878494`*^9, 3.944338842290859*^9}, {3.9443391787823772`*^9, 
  3.9443391787840023`*^9}},ExpressionUUID->"c58a3967-64e2-486f-8006-\
1b5a34f03cbf"],

Cell["Partial Trace", "Item",
 CellChangeTimes->{{3.9443365580642242`*^9, 3.944336560928747*^9}, {
  3.9443388422878494`*^9, 3.944338842290859*^9}, {3.944339179227257*^9, 
  3.9443391816450996`*^9}, {3.9443396255824776`*^9, 
  3.9443396255854797`*^9}},ExpressionUUID->"a21daaea-50e3-4db1-a840-\
bdf994bee5b3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Superposition", "Section",
 CellChangeTimes->{{3.9443367981914616`*^9, 3.9443368232954483`*^9}, {
  3.944337319087488*^9, 3.944337320806822*^9}, {3.969228925178687*^9, 
  3.969228927427574*^9}},ExpressionUUID->"fa43e825-1655-4034-8266-\
f18cb8c81038"],

Cell["\<\
Superposition and entanglement are two fundamental characteristic traits of \
the quantum world. Superposition is a direct consequence of the linearity of \
quantum dynamics, while entanglement stems from the tensor-product structure \
of the underlying vector spaces together with the linearity.\
\>", "Text",
 CellChangeTimes->{
  3.9443374049591503`*^9, {3.96841141394207*^9, 3.9684114747946987`*^9}, {
   3.968411601682445*^9, 
   3.968411617783354*^9}},ExpressionUUID->"3f6c2424-1689-4c7e-8e7a-\
ab3cfcf2b592"],

Cell[TextData[{
 "Quantum superposition means a system existing in a linear combination of \
possible states. For example, consider ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["x", "+"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "b7515821-51b5-44b5-ae62-331868d6b67a"],
 " state (eigenstate of Pauli-X with the eigenvalue +1). Note that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["x", "+"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "197cbca2-f462-468e-99d0-92f1df17f502"],
 " is also called a uniform superposition, and it is the outcome of below \
circuit:"
}], "Text",
 CellChangeTimes->{{3.9443368093591747`*^9, 3.9443368147431774`*^9}, {
  3.944336847904045*^9, 3.944336958998743*^9}, {3.9443373810218716`*^9, 
  3.9443374022063084`*^9}, {3.968411507867107*^9, 3.968411579317492*^9}, {
  3.968412713844185*^9, 
  3.968412742228446*^9}},ExpressionUUID->"638fc483-e888-4a11-a9d1-\
8ac37111bb26"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", "\"\<H\>\"", "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "->", "100"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.968412742948924*^9, 3.968412750418071*^9}, {
  3.9692284149084873`*^9, 3.9692284178141947`*^9}},
 CellLabel->
  "In[149]:=",ExpressionUUID->"08221959-62de-497b-bab5-9e6a7a760336"],

Cell["\<\
Check the final state of the circuit is a uniform superposition:\
\>", "Text",
 CellChangeTimes->{{3.968412762028083*^9, 
  3.968412786170574*^9}},ExpressionUUID->"5f69d298-110e-4b83-9322-\
ce864e73ee5a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", "\"\<H\>\"", "]"}], "[", "]"}], "==", 
  RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], "==", 
  RowBox[{
  "QuantumState", "[", "\"\<UniformSuperposition\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.968412756957149*^9, 3.9684127759841433`*^9}},
 CellLabel->
  "In[150]:=",ExpressionUUID->"670e7597-1dc9-441b-afb1-a746a409de88"],

Cell["Show the Dirac notation in the corresponding basis:", "Text",
 CellChangeTimes->{{3.968411581446887*^9, 
  3.968411594394945*^9}},ExpressionUUID->"0723379d-fb0b-4eb8-a7bf-\
cf73bf891488"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], "//", 
  "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.968411526762991*^9, 3.968411534456141*^9}},
 CellLabel->
  "In[151]:=",ExpressionUUID->"22915262-90fb-49c4-9446-7c52277c25a9"],

Cell["\<\
This representation can also be misleading, because it is a linear \
combination (i.e., a quantum superposition) in the computational basis. If \
you rewrite the same state in a different basis, it may take a very different \
form.\
\>", "Text",
 CellChangeTimes->{{3.968411629238832*^9, 3.968411678286188*^9}, {
   3.968411713788342*^9, 3.9684117140674963`*^9}, 
   3.9684117560611553`*^9},ExpressionUUID->"175ac462-80f8-4084-becc-\
384938718f34"],

Cell["Transform the state in the Pauli-X basis:", "Text",
 CellChangeTimes->{{3.968411581446887*^9, 3.968411594394945*^9}, {
  3.9684116870720997`*^9, 
  3.9684117213264236`*^9}},ExpressionUUID->"76b1b007-f5d5-45a6-8a53-\
aa69c430b528"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], ",", "\"\<X\>\""}], 
   "]"}], "//", "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.968411526762991*^9, 3.968411534456141*^9}, {
  3.968411699930601*^9, 3.968411704439981*^9}},
 CellLabel->
  "In[152]:=",ExpressionUUID->"9904a23a-8717-42e8-b341-08ab9b0336a7"],

Cell["Transform the state in the Pauli-Y basis:", "Text",
 CellChangeTimes->{{3.968411771129447*^9, 
  3.968411778217071*^9}},ExpressionUUID->"1de94f62-6a17-4f5e-9d3f-\
d50fbb0d40c9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], ",", "\"\<Y\>\""}], 
   "]"}], "//", "TraditionalForm"}]], "Input",
 CellChangeTimes->{3.9684117800768538`*^9},
 CellLabel->
  "In[153]:=",ExpressionUUID->"2efef393-1a8b-46de-a044-8f38f74162d2"],

Cell["\<\
Given the infinite choices of bases to represent a state, which basis is most \
convenient for a given task? Let\[CloseCurlyQuote]s discuss practical \
criteria for choosing a basis.\
\>", "Text",
 CellChangeTimes->{{3.9695484630939417`*^9, 3.969548491292017*^9}, {
  3.969548547851058*^9, 
  3.96954854891992*^9}},ExpressionUUID->"e78142af-54de-46fa-a61c-\
a65308782bf8"],

Cell[TextData[{
 "Quantum operations are linear: applying an operator ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d2c4c95a-9942-418a-a312-cfc166b3c4da"],
 " to a superposition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Alpha]", 
     TemplateBox[{"0"},
      "Ket"]}], "+", 
    RowBox[{"\[Beta]", 
     TemplateBox[{"1"},
      "Ket"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "53031847-8d8f-4599-abde-c0a145e5c021"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Alpha]", " ", 
     RowBox[{"(", 
      RowBox[{"A", 
       TemplateBox[{"0"},
        "Ket"]}], ")"}]}], "+", 
    RowBox[{"\[Beta]", " ", 
     RowBox[{"(", 
      RowBox[{"A", 
       TemplateBox[{"1"},
        "Ket"]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d7e6337d-20c5-49c6-bbe7-8d5ff1bdff70"],
 ". In other words, the action of operators can be treated as how they \
transform a specific basis."
}], "Text",
 CellChangeTimes->{{3.969228802391458*^9, 3.969228803030944*^9}, {
  3.969228907915332*^9, 
  3.969229103736834*^9}},ExpressionUUID->"3ce691a9-6deb-4723-b9a7-\
a42988236570"],

Cell["\<\
Let\[CloseCurlyQuote]s consider the effect of phase operator on 1-qubit \
computational basis vs Pauli-X basis:\
\>", "Text",
 CellChangeTimes->{{3.969228802391458*^9, 3.969228803030944*^9}, {
  3.969228907915332*^9, 3.9692291048669558`*^9}, {3.969229288020714*^9, 
  3.969229292728348*^9}},ExpressionUUID->"808d44b2-62d4-4dda-a65e-\
0912fb2e51c7"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qc", "=", 
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<P\>\"", "[", "\[Theta]", "]"}], "}"}], "]"}]}], "}"}], ",", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"qc", "[", 
       RowBox[{"\"\<Diagram\>\"", ",", 
        RowBox[{"ImageSize", "->", "100"}], ",", 
        RowBox[{"\"\<WireLabels\>\"", "->", "None"}]}], "]"}], 
      ",", "\"\<  \>\"", ",", 
      RowBox[{"TableForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"TraditionalForm", "[", "#", "]"}], ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"qc", "[", "#", "]"}], "]"}]}], "}"}], "&"}], "/@", 
         RowBox[{
          RowBox[{"QuantumBasis", "[", "2", "]"}], "[", "\"\<BasisStates\>\"",
           "]"}]}], ",", 
        RowBox[{"TableHeadings", "->", 
         RowBox[{"{", 
          RowBox[{"None", ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\>\"", 
             ",", "\"\<P[\[Theta]]\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\>\
\""}], "}"}]}], "}"}]}]}], "]"}], ",", "\"\<  \>\"", ",", 
      "\[IndentingNewLine]", 
      RowBox[{"TableForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"TraditionalForm", "[", "#", "]"}], ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"FullSimplify", "@", 
              RowBox[{"QuantumState", "[", 
               RowBox[{
                RowBox[{"qc", "[", "#", "]"}], ",", "\"\<X\>\""}], "]"}]}], 
             "]"}]}], "}"}], "&"}], "/@", 
         RowBox[{
          RowBox[{"QuantumBasis", "[", "\"\<X\>\"", "]"}], 
          "[", "\"\<BasisStates\>\"", "]"}]}], ",", 
        RowBox[{"TableHeadings", "->", 
         RowBox[{"{", 
          RowBox[{"None", ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\>\"", 
             ",", "\"\<P[\[Theta]]\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\>\
\""}], "}"}]}], "}"}]}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.968413470954113*^9, 3.968413485280118*^9}, {
  3.968413526497491*^9, 3.968413556602401*^9}, {3.96922883381355*^9, 
  3.9692288944828053`*^9}, {3.969229321958603*^9, 3.9692293529285707`*^9}},
 CellLabel->
  "In[154]:=",ExpressionUUID->"ae8655b5-78b8-468d-b07b-d973831f2c43"],

Cell[TextData[{
 "Comparing the two cases, the phase operator is clearest in the \
computational basis: it leaves ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"0"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "85c3da4e-9e1a-46e0-8e65-403b3a6c188e"],
 " unchanged and adds a phase to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"1"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "35eea4e8-b21c-468a-ad95-d324c2fe8cc1"],
 "."
}], "Text",
 CellChangeTimes->{{3.969228953578705*^9, 3.969228953818777*^9}, {
  3.969229185433339*^9, 3.969229209300063*^9}, {3.969229402732827*^9, 
  3.969229462744401*^9}},ExpressionUUID->"5303f275-1c51-45fd-b748-\
d80bdb5cd953"],

Cell["\<\
For the X-rotation gate, the Pauli-X eigenbasis is the most natural basis to \
describe its effect.\
\>", "Text",
 CellChangeTimes->{{3.969228802391458*^9, 3.969228803030944*^9}, {
  3.969228907915332*^9, 3.9692291048669558`*^9}, {3.969229151216043*^9, 
  3.969229152873042*^9}, {3.969229472216249*^9, 
  3.969229512596374*^9}},ExpressionUUID->"d908c747-f70d-4cd9-a99b-\
789dee9b6538"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qc", "=", 
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], "}"}], "]"}]}], "}"}], ",", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"qc", "[", 
       RowBox[{"\"\<Diagram\>\"", ",", 
        RowBox[{"ImageSize", "->", "100"}], ",", 
        RowBox[{"\"\<WireLabels\>\"", "->", "None"}]}], "]"}], 
      ",", "\"\<  \>\"", ",", 
      RowBox[{"TableForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"TraditionalForm", "[", "#", "]"}], ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"qc", "[", "#", "]"}], "]"}]}], "}"}], "&"}], "/@", 
         RowBox[{
          RowBox[{"QuantumBasis", "[", "2", "]"}], "[", "\"\<BasisStates\>\"",
           "]"}]}], ",", 
        RowBox[{"TableHeadings", "->", 
         RowBox[{"{", 
          RowBox[{"None", ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\>\"", 
             ",", "\"\<\!\(\*SubscriptBox[\(R\), \
\(X\)]\)[\[Theta]]\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\>\""}], "}"}]}], 
          "}"}]}]}], "]"}], ",", "\"\<  \>\"", ",", "\[IndentingNewLine]", 
      RowBox[{"TableForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"TraditionalForm", "[", "#", "]"}], ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"FullSimplify", "@", 
              RowBox[{"QuantumState", "[", 
               RowBox[{
                RowBox[{"qc", "[", "#", "]"}], ",", "\"\<X\>\""}], "]"}]}], 
             "]"}]}], "}"}], "&"}], "/@", 
         RowBox[{
          RowBox[{"QuantumBasis", "[", "\"\<X\>\"", "]"}], 
          "[", "\"\<BasisStates\>\"", "]"}]}], ",", 
        RowBox[{"TableHeadings", "->", 
         RowBox[{"{", 
          RowBox[{"None", ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\>\"", 
             ",", "\"\<\!\(\*SubscriptBox[\(R\), \
\(X\)]\)[\[Theta]]\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\>\""}], "}"}]}], 
          "}"}]}]}], "]"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.968413470954113*^9, 3.968413485280118*^9}, {
  3.968413526497491*^9, 3.968413556602401*^9}, {3.96922883381355*^9, 
  3.9692288944828053`*^9}, {3.969229321958603*^9, 3.969229391579439*^9}},
 CellLabel->
  "In[155]:=",ExpressionUUID->"922f2b76-fa90-4655-92b3-c7c9bc05fe53"],

Cell[TextData[{
 "The choice of basis and superposition directly affects measurement. For a \
circuit with a Hadamard followed by a phase gate of angle \[Pi]/3, the final \
state carries a relative phase ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", 
     SqrtBox["2"]], 
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{"0"},
       "Ket"], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]\[Pi]", "/", "3"}]], 
       TemplateBox[{"1"},
        "Ket"]}]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9ffd2cb5-12e4-4f68-8f56-10ac84c5ca10"],
 ". Measured in the computational basis, that phase has no effect on outcome \
probabilities; measured in the Pauli-X basis, the phase becomes observable."
}], "Text",
 CellChangeTimes->{{3.9692298328368273`*^9, 3.969229929589183*^9}, {
  3.969230042043352*^9, 
  3.969230069110579*^9}},ExpressionUUID->"157d00be-da02-4be3-b852-\
e964346c14c2"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"qc", "=", 
         RowBox[{"QuantumCircuitOperator", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<H\>\"", ",", 
            RowBox[{"\"\<P\>\"", "[", 
             RowBox[{"\[Pi]", "/", "3"}], "]"}], ",", 
            RowBox[{"{", "1", "}"}]}], "}"}], "]"}]}], "}"}], ",", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"qc", "[", 
           RowBox[{"\"\<Diagram\>\"", ",", 
            InterpretationBox[
             DynamicModuleBox[{Typeset`open = False}, 
              TemplateBox[{"Expression", "SequenceIcon", 
                GridBox[{{
                   RowBox[{
                    TagBox["\"Head: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["Sequence", "IconizedItem"]}]}, {
                   RowBox[{
                    TagBox["\"Length: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["2", "IconizedItem"]}]}, {
                   RowBox[{
                    TagBox["\"Byte count: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["224", "IconizedItem"]}]}}, 
                 GridBoxAlignment -> {"Columns" -> {{Left}}}, 
                 DefaultBaseStyle -> "Column", 
                 GridBoxItemSize -> {
                  "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
                Dynamic[Typeset`open]},
               "IconizedObject"]],
             Sequence[ImageSize -> 140, "WireLabels" -> None],
             SelectWithContents->True,
             Selectable->False]}], "]"}], ",", "\"\<  \>\"", ",", 
          RowBox[{
           RowBox[{"qc", "[", "]"}], "[", "\"\<Probabilities\>\"", "]"}]}], 
         "}"}], "]"}]}], "]"}], ",", "\"\<   \>\"", ",", 
     "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"qc", "=", 
         RowBox[{"QuantumCircuitOperator", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<H\>\"", ",", 
            RowBox[{"\"\<P\>\"", "[", 
             RowBox[{"\[Pi]", "/", "3"}], "]"}], ",", 
            RowBox[{"1", "->", "\"\<X\>\""}]}], "}"}], "]"}]}], "}"}], ",", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"qc", "[", 
           RowBox[{"\"\<Diagram\>\"", ",", 
            InterpretationBox[
             DynamicModuleBox[{Typeset`open = False}, 
              TemplateBox[{"Expression", "SequenceIcon", 
                GridBox[{{
                   RowBox[{
                    TagBox["\"Head: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["Sequence", "IconizedItem"]}]}, {
                   RowBox[{
                    TagBox["\"Length: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["2", "IconizedItem"]}]}, {
                   RowBox[{
                    TagBox["\"Byte count: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["224", "IconizedItem"]}]}}, 
                 GridBoxAlignment -> {"Columns" -> {{Left}}}, 
                 DefaultBaseStyle -> "Column", 
                 GridBoxItemSize -> {
                  "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
                Dynamic[Typeset`open]},
               "IconizedObject"]],
             Sequence[ImageSize -> 140, "WireLabels" -> None],
             SelectWithContents->True,
             Selectable->False]}], "]"}], ",", "\"\<  \>\"", ",", 
          RowBox[{
           RowBox[{"qc", "[", "]"}], "[", "\"\<Probabilities\>\"", "]"}]}], 
         "}"}], "]"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9692295651330023`*^9, 3.969229724616968*^9}, {
  3.969229992590843*^9, 3.9692300111358547`*^9}, {3.969230099451776*^9, 
  3.969230120470389*^9}},
 CellLabel->
  "In[156]:=",ExpressionUUID->"944539f6-2728-4af3-8988-84d7f1f17917"],

Cell["\<\
A basis transformation can be done also for a composite state. For example, \
consider the state coming out of this circuit:\
\>", "Text",
 CellChangeTimes->{{3.968411795629973*^9, 3.9684118223088427`*^9}, {
   3.968412486511567*^9, 3.968412504190737*^9}, {3.968412599203245*^9, 
   3.968412604489574*^9}, {3.9684129117323227`*^9, 3.968412918432773*^9}, 
   3.969228734647943*^9},ExpressionUUID->"2b5361e7-b650-4041-8155-\
f3842529386c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<H\>\"", ",", 
     RowBox[{"\"\<H\>\"", "->", "2"}], ",", 
     RowBox[{"\"\<Z\>\"", "->", "2"}]}], "}"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "->", "120"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9684126069073057`*^9, 3.9684126251019983`*^9}, {
  3.969228396460793*^9, 3.9692284066965933`*^9}},
 CellLabel->
  "In[157]:=",ExpressionUUID->"0d12977d-671e-4802-a76d-9ec4c7a0a2be"],

Cell["\<\
Execute the circuit and show the Dirac notation of the state:\
\>", "Text",
 CellChangeTimes->{{3.968412641098543*^9, 3.968412650438192*^9}, 
   3.9684126926948967`*^9},ExpressionUUID->"f731c441-7012-4d58-83a7-\
a1074ed870a0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalPsi]", "=", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<H\>\"", ",", 
       RowBox[{"\"\<H\>\"", "->", "2"}], ",", 
       RowBox[{"\"\<Z\>\"", "->", "2"}]}], "}"}], "]"}], "[", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[CapitalPsi]", "//", "TraditionalForm"}]}], "Input",
 CellChangeTimes->{{3.968411824163124*^9, 3.968411831967723*^9}, {
  3.968412452097376*^9, 3.968412478665502*^9}, {3.968412633897316*^9, 
  3.9684126346112127`*^9}},
 CellLabel->
  "In[158]:=",ExpressionUUID->"7b688c4a-4c31-4b01-86d7-a2850a81a8e0"],

Cell[TextData[{
 "Is the above state separable? One smart way to answer that is since we \
start with a separable state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"00"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ef115350-7f09-4e33-ac56-7834114f5649"],
 " and only applied single-qubit gates (i.e. gates acting on single wires \
only) the final state should be separable too. Let\[CloseCurlyQuote]s \
consider another way of answering the question."
}], "Text",
 CellChangeTimes->{{3.969548632864356*^9, 
  3.969548700916162*^9}},ExpressionUUID->"3ab51602-6722-4ecb-bd7a-\
27fe3c90fdd8"],

Cell["\<\
If we transform this state to the Pauli-X basis, the form of the \
superposition changes. In particular, if the state is an eigenstate of X, it \
appears as a single basis vector in the  X-basis (so the superposition \
\[OpenCurlyDoubleQuote]disappears\[CloseCurlyDoubleQuote]). Otherwise, it \
remains a superposition\[LongDash]just expressed in terms of the X-basis \
vectors.\
\>", "Text",
 CellChangeTimes->{{3.968411859036787*^9, 3.968411885651164*^9}, {
  3.968411928668537*^9, 3.9684119578197727`*^9}, {3.9684126598085537`*^9, 
  3.9684126610069237`*^9}},ExpressionUUID->"eb0df124-9a3e-434f-b982-\
80e43a53ea62"],

Cell[TextData[{
 "Show the state in the basis of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"X", "\[CircleTimes]", "X"}], TraditionalForm]],ExpressionUUID->
  "ad1a8d39-ba14-411b-bca4-c3632dcde97c"],
 ":"
}], "Text",
 CellChangeTimes->{{3.96841188864533*^9, 
  3.9684118998231773`*^9}},ExpressionUUID->"91e04e8a-0c2d-48ef-9b23-\
c1aa053f5008"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"\[CapitalPsi]", ",", "\"\<XX\>\""}], "]"}], "//", 
  "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.9684118457613487`*^9, 3.9684118529940577`*^9}, 
   3.968412513049078*^9},
 CellLabel->
  "In[160]:=",ExpressionUUID->"2bdb992a-f2c9-486a-89da-75ce1db9c648"],

Cell["\<\
In other words, the representation of the state in the computational basis \
shows a superposition, so it is not immediately clear whether the state is a \
tensor product of two single-qubit states. However, if we rewrite the same \
state in another basis (for example, the eigenstates of Pauli-X) and the \
factorization becomes explicit, then the state is separable (not entangled) \
and can indeed be written as a tensor product. Note that separability is a \
property of the state itself, not the basis; a different basis can simply \
make that property more evident.\
\>", "Text",
 CellChangeTimes->{{3.968411965656139*^9, 
  3.9684120538415422`*^9}},ExpressionUUID->"786d4973-9736-4e8e-881c-\
4c3e95a60c97"],

Cell["If a state is separable, we say it is not entangled.", "Text",
 CellChangeTimes->{{3.9443373320225754`*^9, 3.9443373761189804`*^9}, {
  3.944337452366894*^9, 3.9443374576938457`*^9}, {3.944665088851124*^9, 
  3.9446650889384003`*^9}, {3.968412262707741*^9, 
  3.968412304792842*^9}},ExpressionUUID->"bd3cfd22-42a4-4b69-96c2-\
00c66f9fe744"],

Cell[BoxData[
 RowBox[{"QuantumEntangledQ", "[", "\[CapitalPsi]", "]"}]], "Input",
 CellChangeTimes->{{3.9443374590840664`*^9, 3.9443374685934105`*^9}, 
   3.968412260361719*^9, {3.968412518559971*^9, 3.9684125213014107`*^9}},
 CellLabel->
  "In[161]:=",ExpressionUUID->"1cc06d0c-1cd2-4336-801b-5f501ff1d64e"],

Cell["\<\
One way to confirm that a state is separable (for pure states) is to trace \
out a subsystem and check that the resulting reduced state is the same \
single-system state you specified in the product. Equivalently, both reduced \
states are pure, which indicates the overall state is a product (not \
entangled).\
\>", "Text",
 CellChangeTimes->{{3.96841234696229*^9, 
  3.9684124110578117`*^9}},ExpressionUUID->"92c6056a-5265-41f1-b723-\
87e29771e12d"],

Cell[TextData[{
 "Tracing out qubit 2 gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["x", "+"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "6a16b643-2878-43c7-adf8-6530892519f1"],
 " as the reduced state:"
}], "Text",
 CellChangeTimes->{{3.968412535226941*^9, 
  3.968412561413787*^9}},ExpressionUUID->"e05b5b02-9243-40c0-9dd3-\
70f09458240e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumPartialTrace", "[", 
   RowBox[{"\[CapitalPsi]", ",", 
    RowBox[{"{", "2", "}"}]}], "]"}], "==", 
  RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.9684123347243443`*^9, 3.968412344290855*^9}, 
   3.9684125243757477`*^9},
 CellLabel->
  "In[162]:=",ExpressionUUID->"8f8cc502-ecf7-436b-9f7e-6f03d8059e3b"],

Cell[TextData[{
 "Tracing out qubit 1 gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["x", "-"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "d4897e06-7dca-4d16-b72d-2b6c44cd7e4e"],
 " as the reduced state:"
}], "Text",
 CellChangeTimes->{{3.968412535226941*^9, 
  3.968412570306837*^9}},ExpressionUUID->"7d776269-cce5-4924-ac28-\
740965e54fec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumPartialTrace", "[", 
   RowBox[{"\[CapitalPsi]", ",", 
    RowBox[{"{", "1", "}"}]}], "]"}], "==", 
  RowBox[{"QuantumState", "[", "\"\<-\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.968412530219172*^9, 3.968412532385769*^9}},
 CellLabel->
  "In[163]:=",ExpressionUUID->"dc6bdf47-d444-44bc-816f-a01615a11440"],

Cell["\<\
Additionally, for separable states, the reduced state is a pure state:\
\>", "Text",
 CellChangeTimes->{{3.969228492104741*^9, 
  3.969228533348649*^9}},ExpressionUUID->"2779db2f-c95b-4a7a-af69-\
91292f30a7c3"],

Cell[BoxData[
 RowBox[{"QuantumPartialTrace", "[", 
  RowBox[{"\[CapitalPsi]", ",", 
   RowBox[{"{", "2", "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[164]:=",ExpressionUUID->"4108f47b-338b-4b12-8b27-9f682395d5cf"],

Cell["Let\[CloseCurlyQuote]s discuss entanglement in more detail.", "Text",
 CellChangeTimes->{{3.969228596867456*^9, 3.969228605597603*^9}, 
   3.969228683829093*^9},ExpressionUUID->"5c5f0bff-c926-4180-b8d7-\
615b79746d59"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Entanglement", "Section",
 CellChangeTimes->{{3.9443367981914616`*^9, 3.9443368232954483`*^9}, {
   3.944337319087488*^9, 3.944337320806822*^9}, 
   3.9692285945322113`*^9},ExpressionUUID->"783c6ff8-4523-476c-8285-\
1068b661baf0"],

Cell["\<\
Entanglement is when a composite quantum system has a well-defined overall \
state, but its parts cannot be assigned complete, independent states.\
\>", "Text",
 CellChangeTimes->{{3.9443375145823917`*^9, 3.944337612077919*^9}, 
   3.9692286158622828`*^9},ExpressionUUID->"d0be385c-f79a-497c-9493-\
919f6cfed447"],

Cell["\<\
To create an entangled state, you will need a gate that is not separable. A \
famous gate that can be used is CNOT. Let\[CloseCurlyQuote]s see the effect \
of CNOT on the computational basis:\
\>", "Text",
 CellChangeTimes->{{3.9443376293108044`*^9, 3.9443376758388023`*^9}, {
  3.968413422087681*^9, 3.968413460427622*^9}, {3.9684134926222982`*^9, 
  3.968413501741304*^9}, {3.969228624005908*^9, 
  3.9692286361506844`*^9}},ExpressionUUID->"5eaf8cfe-8d8a-46ed-b2f0-\
ef1dff24bc02"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumCircuitOperator", "[", "\"\<CNOT\>\"", "]"}], "[", 
     RowBox[{"\"\<Diagram\>\"", ",", 
      RowBox[{"ImageSize", "\[Rule]", "120"}], ",", 
      RowBox[{"\"\<WireLabels\>\"", "\[Rule]", "None"}]}], "]"}], 
    ",", "\"\<  \>\"", ",", 
    RowBox[{"TableForm", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"TraditionalForm", "[", "#", "]"}], ",", 
          RowBox[{"TraditionalForm", "[", 
           RowBox[{
            RowBox[{"QuantumCircuitOperator", "[", "\"\<CNOT\>\"", "]"}], "[",
             "#", "]"}], "]"}]}], "}"}], "&"}], "/@", 
       RowBox[{
        RowBox[{"QuantumBasis", "[", 
         RowBox[{"2", ",", "2"}], "]"}], "[", "\"\<BasisStates\>\"", "]"}]}], 
      ",", 
      RowBox[{"TableHeadings", "->", 
       RowBox[{"{", 
        RowBox[{"None", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\>\"", 
           ",", "\"\<CNOT\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\>\""}], 
          "}"}]}], "}"}]}]}], "]"}]}], "}"}], "]"}]], "Input",
 CellChangeTimes->{{3.968413470954113*^9, 3.968413485280118*^9}, {
  3.968413526497491*^9, 3.968413556602401*^9}, {3.9699246983905287`*^9, 
  3.96992472527905*^9}},
 CellLabel->
  "In[165]:=",ExpressionUUID->"53edd583-8791-47ab-a80f-e51a27af7ead"],

Cell[TextData[{
 "Looking at the table above, the CNOT\[CloseCurlyQuote]s effect becomes \
visible only if qubit 1 (the control) has support on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"0"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "90b7eb9b-0893-4ea0-aa76-7537ac36a52e"],
 " as well as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"1"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "be882717-7e93-4ffb-b783-19df1b546020"],
 ". In other words, we need a superposition of 0 and 1 for the control qubit. \
We can create such a superposition with a Hadamard gate or with an \
appropriate single-qubit rotation."
}], "Text",
 CellChangeTimes->{{3.968413597566835*^9, 3.968413675240679*^9}, {
   3.968413735150833*^9, 3.9684137554499702`*^9}, 3.9692286429697657`*^9, {
   3.969548796829777*^9, 
   3.969548808108541*^9}},ExpressionUUID->"ef4d1536-c3c9-446b-b1c7-\
9498cbbe39de"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<RY\>\"", "[", 
      RowBox[{"\[Pi]", "/", "3"}], "]"}], ",", "\"\<CNOT\>\""}], "}"}], "]"}],
   "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "\[Rule]", "120"}], ",", 
   RowBox[{"\"\<WireLabels\>\"", "\[Rule]", "None"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.944337717924307*^9, 3.944337737383005*^9}, {
   3.9684129509110394`*^9, 3.968412958773651*^9}, {3.968412993344837*^9, 
   3.9684130203469553`*^9}, {3.968413715356133*^9, 3.9684137219489737`*^9}, 
   3.969924730915511*^9},
 CellLabel->
  "In[166]:=",ExpressionUUID->"3a871c85-bf72-4013-8b7b-0b4759024124"],

Cell["Calculate the final state of above circuit:", "Text",
 CellChangeTimes->{{3.944337771278042*^9, 3.944337784358526*^9}, {
  3.968413039451226*^9, 3.968413039641375*^9}, {3.968413165963201*^9, 
  3.968413200569207*^9}, {3.968413373791815*^9, 3.968413395705831*^9}, {
  3.9684137823680058`*^9, 
  3.968413789553821*^9}},ExpressionUUID->"f3cea3b2-32c9-4aa9-b339-\
ea8e4856dc8b"],

Cell[BoxData[
 RowBox[{"state", "=", 
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<RY\>\"", "[", 
       RowBox[{"\[Pi]", "/", "3"}], "]"}], ",", "\"\<CNOT\>\""}], "}"}], 
    "]"}], "[", "]"}]}]], "Input",
 CellChangeTimes->{{3.9443377436741047`*^9, 3.9443377505510883`*^9}, 
   3.968412982123889*^9, {3.9684130312556887`*^9, 3.968413048546935*^9}, {
   3.9684137746762543`*^9, 3.9684137790339317`*^9}},
 CellLabel->
  "In[167]:=",ExpressionUUID->"54588b5c-db34-4ee3-861b-92f968210dbf"],

Cell["Show it in the Dirac notation:", "Text",
 CellChangeTimes->{{3.968413794854344*^9, 
  3.968413802149295*^9}},ExpressionUUID->"e2de2993-6d10-412d-a971-\
261d59cb0e37"],

Cell[BoxData[
 RowBox[{"state", "//", "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.9443378066271954`*^9, 3.944337810894804*^9}, 
   3.968413051503902*^9, {3.968413109651555*^9, 3.9684131107367783`*^9}},
 CellLabel->
  "In[168]:=",ExpressionUUID->"1a81cb27-4b3d-4060-88b2-433acc3f6884"],

Cell["Calculate the corresponding measurement probabilities:", "Text",
 CellChangeTimes->{{3.9443378295183125`*^9, 3.9443379075497093`*^9}, 
   3.968413132166594*^9, {3.968413807542124*^9, 
   3.9684138170398693`*^9}},ExpressionUUID->"eb63b43a-bdc6-48eb-baef-\
80b723b2222d"],

Cell[BoxData[
 RowBox[{"state", "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.9443379303393364`*^9, 3.9443379703355064`*^9}, 
   3.96841305908997*^9, {3.969277759710267*^9, 3.96927777942612*^9}},
 CellLabel->
  "In[169]:=",ExpressionUUID->"1e8364e8-fe7f-4185-8e67-3f6d340c258b"],

Cell["\<\
Consider the state one gets after measuring above state. This is usually \
called post-measurement state. It will be a mixed state of 00 and 11, with \
the corresponding probabilities. It can be written as:\
\>", "Text",
 CellChangeTimes->{{3.969277703891749*^9, 3.969277743851203*^9}, {
  3.969548850525814*^9, 
  3.969548867690139*^9}},ExpressionUUID->"061fa115-293f-406b-8742-\
e84d86623d60"],

Cell[BoxData[
 RowBox[{"mixedState", "=", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          SqrtBox["3"], "2"], ")"}], "2"], ",", "0", ",", "0", ",", "0"}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox["1", "2"], ")"}], "2"]}], "}"}]}], "}"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.969277582011449*^9, 3.969277700533641*^9}},
 CellLabel->
  "In[170]:=",ExpressionUUID->"09a1cdc1-2bd1-4756-aba0-9868084ac09c"],

Cell["\<\
As you can see, the mixed state yields the same measurement probabilities as \
the original state.\
\>", "Text",
 CellChangeTimes->{{3.9692778027755957`*^9, 
  3.9692778591844893`*^9}},ExpressionUUID->"0fdf16ba-737a-4196-b0a9-\
c0613d39a1c6"],

Cell[BoxData[
 RowBox[{"mixedState", "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.969277756917371*^9, 3.969277786131597*^9}},
 CellLabel->
  "In[171]:=",ExpressionUUID->"487ae0ae-d0bb-4050-aecb-1282ce2b1f1b"],

Cell["\<\
In other words, one instance of measurement statistics alone does not make it \
obvious whether the state is entangled.\
\>", "Text",
 CellChangeTimes->{{3.968413829158798*^9, 3.968413963928246*^9}, 
   3.96927757787986*^9, {3.969277795174431*^9, 3.969277801153118*^9}, {
   3.9692779144002953`*^9, 3.9692779253613443`*^9}, 
   3.971796903849689*^9},ExpressionUUID->"c365b080-c601-45f4-af0e-\
28ba63df90bb"],

Cell[TextData[{
 "In the Wolfram Quantum Framework, you can test the entanglement using ",
 ButtonBox["QuantumEntangledQ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/PacletRepository/resources/\
Wolfram/QuantumFramework/ref/QuantumEntangledQ.html"], None},
  ButtonNote->
   "https://resources.wolframcloud.com/PacletRepository/resources/Wolfram/\
QuantumFramework/ref/QuantumEntangledQ.html"],
 ", which returns ",
 Cell[BoxData[
  FormBox["True", TraditionalForm]],ExpressionUUID->
  "1f6e059e-cbb6-4f33-8b46-13f69075f0bd"],
 " if the state is entangled (with respect to the chosen partition) and ",
 Cell[BoxData[
  FormBox["False", TraditionalForm]],ExpressionUUID->
  "42d3f9f7-56c9-46f4-9bf9-5d1b2ae86f7f"],
 " otherwise. "
}], "Text",
 CellChangeTimes->{{3.968413829158798*^9, 3.968413963928246*^9}, {
  3.969548891887971*^9, 
  3.969548896827671*^9}},ExpressionUUID->"1db25152-1dfe-4d44-a9a0-\
88e20035d19b"],

Cell["Test if above pure state is entangled or not:", "Text",
 CellChangeTimes->{{3.9695489087851353`*^9, 
  3.969548920239752*^9}},ExpressionUUID->"abebd362-b499-4f95-b2ae-\
5c516fb03a64"],

Cell[BoxData[
 RowBox[{"QuantumEntangledQ", "[", "state", "]"}]], "Input",
 CellChangeTimes->{{3.968413861307946*^9, 3.968413864258871*^9}},
 CellLabel->
  "In[172]:=",ExpressionUUID->"2c88f422-40b0-414a-866f-704692bfb7fc"],

Cell["\<\
Test if above the post-measurement state is entangled or not:\
\>", "Text",
 CellChangeTimes->{{3.969548923084091*^9, 
  3.969548930137535*^9}},ExpressionUUID->"c7206fdf-936a-4206-946f-\
eb9b061be35b"],

Cell[BoxData[
 RowBox[{"QuantumEntangledQ", "[", "mixedState", "]"}]], "Input",
 CellChangeTimes->{{3.969277812754299*^9, 3.969277814233615*^9}},
 CellLabel->
  "In[173]:=",ExpressionUUID->"c9d67ec1-1d8a-4fcb-912d-e420817fc135"],

Cell[TextData[{
 "For multi-qubit systems, be sure to specify the partition of subsystems \
when you call ",
 ButtonBox["QuantumEntangledQ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/PacletRepository/resources/\
Wolfram/QuantumFramework/ref/QuantumEntangledQ.html"], None},
  ButtonNote->
   "https://resources.wolframcloud.com/PacletRepository/resources/Wolfram/\
QuantumFramework/ref/QuantumEntangledQ.html"],
 ", (always check the documentation pages)."
}], "Text",
 CellChangeTimes->{{3.9684139654915037`*^9, 
  3.968413993629825*^9}},ExpressionUUID->"386f7235-e911-4a2d-9118-\
c21dfd7922de"],

Cell["\<\
Another way to test whether a state is entangled is as follows. First, \
compute the reduced states by performing partial traces. Then compare the \
tensor product of the reduced states with the original state. If they are the \
same, the state is not entangled; otherwise, it is entangled.\
\>", "Text",
 CellChangeTimes->{{3.968414001134247*^9, 3.968414056376484*^9}, {
  3.968414110450828*^9, 
  3.96841411328749*^9}},ExpressionUUID->"655580c2-3763-48b4-947f-\
d1c599346280"],

Cell["Generate the reduced state of qubit 1:", "Text",
 CellChangeTimes->{{3.968414139393393*^9, 
  3.968414146883438*^9}},ExpressionUUID->"619c097d-a881-4793-b756-\
84509774f408"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]1", "=", 
   RowBox[{"QuantumPartialTrace", "[", 
    RowBox[{"state", ",", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.968414073947143*^9, 3.968414083712232*^9}},
 CellLabel->
  "In[174]:=",ExpressionUUID->"7bd566dc-ba51-407b-9416-0cd8ceb1ca4a"],

Cell["Generate the reduced state of qubit 2:", "Text",
 CellChangeTimes->{{3.968414149951715*^9, 
  3.968414151572893*^9}},ExpressionUUID->"0633803f-a39e-4fbe-bd76-\
e5ce3dd0cfae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]2", "=", 
   RowBox[{"QuantumPartialTrace", "[", 
    RowBox[{"state", ",", 
     RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.968414087629229*^9, 3.96841409015993*^9}},
 CellLabel->
  "In[175]:=",ExpressionUUID->"396484a4-6b94-42ab-aafe-7467cdc274d4"],

Cell["\<\
Compare the tensor product of the reduced states with the original state:\
\>", "Text",
 CellChangeTimes->{{3.968414154700742*^9, 
  3.968414174601309*^9}},ExpressionUUID->"504ef2ff-c360-4a62-adec-\
8109a2602878"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumTensorProduct", "[", 
   RowBox[{"\[Rho]1", ",", "\[Rho]2"}], "]"}], "==", "state"}]], "Input",
 CellChangeTimes->{{3.9684140948545027`*^9, 3.968414101478421*^9}},
 CellLabel->
  "In[176]:=",ExpressionUUID->"925d3cf7-6415-4d86-a6e5-b1b8d4152b8e"],

Cell["\<\
Since they are not the same, it means the original state was entangled state.\
\>", "Text",
 CellChangeTimes->{{3.968414176432619*^9, 
  3.968414194112912*^9}},ExpressionUUID->"5f18e752-fc4f-4663-988f-\
bc6869b28b41"],

Cell["\<\
The above criterion works only for pure states. For mixed states, however, \
separability does not generally imply equality with the product of the \
marginals (many separable mixed states are mixtures of product states), so \
additional tests are needed.\
\>", "Text",
 CellChangeTimes->{{3.968414001134247*^9, 3.968414056376484*^9}, {
  3.968414110450828*^9, 3.968414128711547*^9}, {3.969548964432405*^9, 
  3.9695489665922613`*^9}},ExpressionUUID->"049f3aa4-2ec7-476e-aab1-\
f449a0a8ee6d"],

Cell["\<\
Show that above approach does not work for an initial mixed state:\
\>", "Text",
 CellChangeTimes->{{3.9692781426889563`*^9, 
  3.969278166455755*^9}},ExpressionUUID->"69068646-3aa5-449c-af98-\
aef791ab88e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumTensorProduct", "[", 
   RowBox[{
    RowBox[{"QuantumPartialTrace", "[", 
     RowBox[{"mixedState", ",", 
      RowBox[{"{", "2", "}"}]}], "]"}], ",", 
    RowBox[{"QuantumPartialTrace", "[", 
     RowBox[{"mixedState", ",", 
      RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}], "==", 
  "mixedState"}]], "Input",
 CellLabel->
  "In[177]:=",ExpressionUUID->"eecf361f-0f20-4698-b268-90a0d8819d47"],

Cell["\<\
So although the result is False, but the initial state is not entangled.\
\>", "Text",
 CellChangeTimes->{{3.969278168719561*^9, 
  3.969278177293695*^9}},ExpressionUUID->"c65e9295-1e91-4020-925e-\
473741a4c45e"],

Cell[TextData[{
 "Last but not least, given an entangled state, an interesting question is to \
quantify the entanglement. One common measure is called the generalized ",
 StyleBox["concurrence",
  FontSlant->"Italic"],
 ", which is a measure for the entanglement monotone. See the documentation \
page of ",
 ButtonBox["QuantumEntanglementMonotone",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/PacletRepository/resources/\
Wolfram/QuantumFramework/ref/QuantumEntanglementMonotone.html"], None},
  ButtonNote->
   "https://resources.wolframcloud.com/PacletRepository/resources/Wolfram/\
QuantumFramework/ref/QuantumEntanglementMonotone.html"],
 " for more details."
}], "Text",
 CellChangeTimes->{{3.9684141984059343`*^9, 3.968414221039674*^9}, {
  3.9684142611250896`*^9, 3.968414298090719*^9}, {3.968414357617764*^9, 
  3.968414387023411*^9}},ExpressionUUID->"f4fbd629-bbb3-4e8b-8944-\
a943986667fb"],

Cell["Calculate the concurrence for the above state:", "Text",
 CellChangeTimes->{{3.96841429954292*^9, 3.968414310221732*^9}, 
   3.968414353363797*^9},ExpressionUUID->"6bf82c61-5e64-420a-8c85-\
df9648085676"],

Cell[BoxData[
 RowBox[{"QuantumEntanglementMonotone", "[", "state", "]"}]], "Input",
 CellChangeTimes->{{3.968414226106338*^9, 3.968414230546732*^9}},
 CellLabel->
  "In[178]:=",ExpressionUUID->"58bc8b04-4e27-4802-b182-be4878a5f403"],

Cell["Calculate the concurrence for the Bell state:", "Text",
 CellChangeTimes->{{3.9684143134655046`*^9, 3.968414317419396*^9}, 
   3.968414355145801*^9},ExpressionUUID->"eed8b65c-84ba-4257-9e2c-\
44fd05efafb6"],

Cell[BoxData[
 RowBox[{"QuantumEntanglementMonotone", "[", 
  RowBox[{"QuantumState", "[", "\"\<Bell\>\"", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.968414236755299*^9, 3.968414243089836*^9}},
 CellLabel->
  "In[179]:=",ExpressionUUID->"3c678f62-7215-40c8-b51a-f607587649b0"],

Cell["\<\
As you can see, the Bell state is maximally entangled, it exhibits the \
strongest possible two-qubit entanglement (e.g., one bit of entanglement \
entropy, concurrence equal to 1).\
\>", "Text",
 CellChangeTimes->{{3.968414319399663*^9, 3.9684143367530317`*^9}, {
  3.968414406481086*^9, 3.96841443397278*^9}, {3.969549026141952*^9, 
  3.969549026298594*^9}},ExpressionUUID->"2f27dbf1-bb83-45ff-8603-\
ccd717337145"],

Cell["\<\
Entanglement can extend beyond only two qubits. The GHZ circuit is shown \
below:\
\>", "Text",
 CellChangeTimes->{{3.944339897571535*^9, 
  3.9443399226998215`*^9}},ExpressionUUID->"28c1040d-064e-42bc-a6b3-\
511fbec80dca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", "\"\<GHZ\>\"", "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "\[Rule]", "120"}], ",", 
   RowBox[{"\"\<WireLabels\>\"", "\[Rule]", "None"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.944339924816496*^9, 3.9443399389894905`*^9}, 
   3.969924740697453*^9},
 CellLabel->
  "In[180]:=",ExpressionUUID->"840e0723-5d7f-442f-bc7f-bd1d5a4d1042"],

Cell["\<\
The outcome of above circuit is a state is usually called as GHZ state:\
\>", "Text",
 CellChangeTimes->{{3.9684146528506613`*^9, 
  3.9684146695056543`*^9}},ExpressionUUID->"032f6ccc-7d5b-4a53-9a60-\
3966082028b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", "\"\<GHZ\>\"", "]"}], "[", "]"}], "//",
   "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.9684144736118107`*^9, 3.9684144753378077`*^9}},
 CellLabel->
  "In[181]:=",ExpressionUUID->"06bcd111-33a6-4975-970b-12162d9ac6e9"],

Cell["\<\
We also have GHZ as a named state in the Wolfram quantum framework:\
\>", "Text",
 CellChangeTimes->{{3.9684145394726887`*^9, 
  3.9684145513145657`*^9}},ExpressionUUID->"622d516a-52f2-449a-a1e7-\
1b2f3ab0c6ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", "\"\<GHZ\>\"", "]"}], "[", "]"}], "==", 
  RowBox[{"QuantumState", "[", "\"\<GHZ\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.968414533941235*^9, 3.96841453680821*^9}},
 CellLabel->
  "In[182]:=",ExpressionUUID->"ca586b21-a199-4a7d-b778-6f65fab8e4cd"],

Cell["Check GHZ state is an entangled state:", "Text",
 CellChangeTimes->{{3.9443401433476887`*^9, 3.944340145556572*^9}, {
  3.9443402874841366`*^9, 3.944340310052004*^9}, {3.968414681036813*^9, 
  3.968414692729841*^9}},ExpressionUUID->"60d0187f-0ba2-4558-aab0-\
d7548697bc07"],

Cell[BoxData[
 RowBox[{"QuantumEntangledQ", "[", 
  RowBox[{"QuantumState", "[", "\"\<GHZ\>\"", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.944340057722288*^9, 3.944340063980427*^9}},
 CellLabel->
  "In[183]:=",ExpressionUUID->"8ce535a6-8338-4c40-9020-a415495e1f52"],

Cell["Calculate its concurrence:", "Text",
 CellChangeTimes->{{3.9684146945230513`*^9, 
  3.968414701513918*^9}},ExpressionUUID->"65c49d66-5808-4bc4-8aba-\
e2bd0b6328ad"],

Cell[BoxData[
 RowBox[{"QuantumEntanglementMonotone", "[", 
  RowBox[{"QuantumState", "[", "\"\<GHZ\>\"", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.9684144844692173`*^9, 3.968414492153152*^9}},
 CellLabel->
  "In[184]:=",ExpressionUUID->"56342527-7b1b-47b9-a54b-22175c6b63cb"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["A Quick Tour of Quantum Gates", "Chapter",
 CellChangeTimes->{{3.944663694037163*^9, 3.9446637058294487`*^9}, {
   3.968416806218306*^9, 3.9684168119070883`*^9}, 
   3.969218266370532*^9},ExpressionUUID->"c9d2291f-aae5-49b7-9139-\
75a8136d8dfc"],

Cell["\<\
This chapter offers a streamlined overview of quantum gates, focusing first \
on single-qubit operations that create superposition and control phase, then \
on multi-qubit gates that generate and manipulate entanglement. We survey \
core primitives and how they compose into universal sets, highlighting the \
role of controlled interactions such as CNOT, CZ, and SWAP. The goal is to \
give readers a compact, working intuition for how quantum gates shape \
computation, from isolated rotations to coordinated, entangling dynamics.\
\>", "Text",
 CellChangeTimes->{{3.9692141783192883`*^9, 3.969214179572744*^9}, 
   3.969218212830324*^9, {3.969300630426942*^9, 
   3.969300655286298*^9}},ExpressionUUID->"f8a930c8-5959-4b8e-9ed8-\
92ebec9c3c60"],

Cell[CellGroupData[{

Cell["Key Concepts", "Section",
 CellChangeTimes->{{3.9443259933952217`*^9, 
  3.9443259950116215`*^9}},ExpressionUUID->"0dba4ea8-df32-46a5-8c31-\
c7a090f8e846"],

Cell["Quantum logic operations", "Item",
 CellChangeTimes->{{3.9443260003154984`*^9, 3.9443260063458576`*^9}, {
  3.9692182783401127`*^9, 
  3.969218285948213*^9}},ExpressionUUID->"c9720a6a-038c-4c9e-85be-\
ec81029e9045"],

Cell["Single-qubit quantum gates", "Item",
 CellChangeTimes->{{3.9443260003154984`*^9, 3.9443260049636917`*^9}, {
   3.9443264916038094`*^9, 3.9443264972911034`*^9}, {3.9443328984067*^9, 
   3.944332898409855*^9}, 3.9443358329212112`*^9, {3.9692182872483807`*^9, 
   3.969218291791112*^9}},ExpressionUUID->"fea09079-cd88-4fb1-9f43-\
c769180c4bec"],

Cell["Multi-qubit quantum gates", "Item",
 CellChangeTimes->{{3.9443260003154984`*^9, 3.9443260049636917`*^9}, {
   3.9443264916038094`*^9, 3.9443264972911034`*^9}, {3.9443328989737453`*^9, 
   3.9443329059887295`*^9}, 3.9443358361772804`*^9, {3.9692182931792793`*^9, 
   3.96921829744946*^9}},ExpressionUUID->"1d14fd60-dd65-4c66-8482-\
8376cedacb1d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Introduction", "Section",
 CellChangeTimes->{{3.9692761477948437`*^9, 
  3.969276151523546*^9}},ExpressionUUID->"06815c12-277b-4bfa-9e41-\
630e56c63cf0"],

Cell["\<\
Quantum circuits are usually represented using conventional names for the \
corresponding gates. For example, consider the circuit below:\
\>", "Text",
 CellChangeTimes->{{3.9684173601791058`*^9, 3.9684173819637403`*^9}, {
   3.968417674667172*^9, 3.9684176802984743`*^9}, 
   3.968417770835189*^9},ExpressionUUID->"8a663577-480f-4d78-9e9d-\
1960d6508cc1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Cup\>\"", ",", "\"\<H\>\"", ",", 
     RowBox[{"\"\<Z\>\"", "->", "2"}], ",", 
     RowBox[{"\"\<RY\>\"", "[", "\[Theta]", "]"}], ",", 
     RowBox[{"\"\<RootNOT\>\"", "->", "3"}], ",", 
     RowBox[{"\"\<S\>\"", "->", "3"}], ",", 
     RowBox[{
      RowBox[{"\"\<P\>\"", "[", "\[Phi]", "]"}], "->", "3"}], 
     ",", "\"\<CH\>\"", ",", "\"\<CSWAP\>\"", ",", 
     RowBox[{"\"\<ZSpider\>\"", "->", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}]}]}], ",", 
     RowBox[{"\"\<Multiplexer\>\"", "[", 
      RowBox[{"\"\<Z\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "]"}], ",", 
     RowBox[{"\"\<Cap\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]}]}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.968417382885313*^9, 3.9684175697141037`*^9}, {
  3.9684176140834103`*^9, 3.9684176625511417`*^9}, {3.968417735591598*^9, 
  3.968417751219529*^9}, {3.968495790154447*^9, 3.96849581068506*^9}},
 CellLabel->
  "In[185]:=",ExpressionUUID->"9584888d-4043-4ab5-b0e6-4d94e4dad956"],

Cell[TextData[{
 "The notations and symbols provided are usually sufficient to construct the \
corresponding operators and perform the calculations. Gate connectivity \
reveals arity. For example, the multiplexer in the circuit acts on three \
qubits, while ",
 Cell[BoxData[
  FormBox[
   SqrtBox["NOT"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e840ee18-21ec-4a61-a45b-723e647ce4ba"],
 " acts only on qubit-3. Next, we will discuss some common gates and \
elaborate on their effects on the quantum state."
}], "Text",
 CellChangeTimes->{{3.968417689910125*^9, 3.968417722106016*^9}, {
  3.968417811511396*^9, 3.968417814738192*^9}, {3.9692761800434523`*^9, 
  3.9692762247515497`*^9}, {3.969276261349605*^9, 
  3.969276286877561*^9}},ExpressionUUID->"51de3fc5-3704-4018-8466-\
fe10fdc5ca27"]
}, Closed]],

Cell[CellGroupData[{

Cell["Single-Qubit Gates", "Section",
 CellChangeTimes->{{3.9684168851275578`*^9, 3.968416887225954*^9}, {
  3.969977083489005*^9, 
  3.9699770890073557`*^9}},ExpressionUUID->"235c7821-2711-42d4-b22d-\
ec2e4319ceb6"],

Cell["\<\
Single-qubit gates are the building blocks of quantum computation. Each one \
acts on a single qubit, changing its state without touching the rest of the \
qubits. You can think of them as moving of a point on the Bloch sphere, \
steering a qubit from one configuration to another while preserving quantum \
amplitudes overall. Because any multi-qubit algorithm ultimately relies on \
carefully shaped single-qubit transformations combined with entangling \
operations, mastering these gates is essential for designing circuits, \
controlling interference and preparing useful superpositions.\
\>", "Text",
 CellChangeTimes->{{3.968501874851885*^9, 3.968501926719102*^9}, {
   3.96929711110273*^9, 3.969297138833419*^9}, {3.969297210359043*^9, 
   3.969297243440786*^9}, {3.9692972830036383`*^9, 3.9692972911438637`*^9}, 
   3.9717969155787163`*^9},ExpressionUUID->"426edc8f-14d3-40f5-b6e9-\
8d29f1e61b71"],

Cell["\<\
In practice, single-qubit gates include familiar primitives like Pauli X, Y, \
and Z, which implement axis flips; the Hadamard, which creates and removes \
balanced superpositions; phase-type gates such as S and T that adjust \
relative phase without changing measurement probabilities; and continuously \
tunable rotations that let hardware enact arbitrary angles around chosen \
axes. Together they form a universal toolkit for shaping quantum states: \
calibrating amplitudes, sculpting phases, and setting up interference \
patterns that later multi-qubit gates can exploit.\
\>", "Text",
 CellChangeTimes->{{3.968501874851885*^9, 3.968501926719102*^9}, {
  3.96929711110273*^9, 3.969297138833419*^9}, {3.969297210359043*^9, 
  3.969297243440786*^9}, {3.9692972830036383`*^9, 
  3.969297286557529*^9}},ExpressionUUID->"eede6a49-cd77-471a-a9c6-\
083741df15ce"],

Cell[CellGroupData[{

Cell["Pauli gates", "Subsection",
 CellChangeTimes->{{3.968752593609651*^9, 
  3.968752595566235*^9}},ExpressionUUID->"9d1f6086-8464-4c34-951c-\
a6150b95c224"],

Cell["\<\
Pauli operators are a common set of single-qubit gates. The Pauli-Z operator \
acts like a phase flip: it leaves the 0 state unchanged and adds a minus sign \
to the 1 state. In other words, if a qubit has some amount of 0 plus some \
amount of 1, applying Z keeps the 0 part the same and flips the sign of the 1 \
part. (By comparison, X swaps the 0 and 1 states, and Y also swaps them but \
introduces a phase.)\
\>", "Text",
 CellChangeTimes->{{3.968417834335589*^9, 3.968417849488624*^9}, {
  3.9684178811540537`*^9, 3.968417890994*^9}, {3.9684180609395237`*^9, 
  3.9684180812660522`*^9}, {3.968429795266588*^9, 
  3.9684297968248367`*^9}},ExpressionUUID->"95bade14-44e1-4814-af22-\
97989e6eb2bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", "\"\<Z\>\"", "}"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["2", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["224", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence["WireLabels" -> None, ImageSize -> 100],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellChangeTimes->{{3.9684456905558853`*^9, 3.968445701964212*^9}, {
  3.969275764860018*^9, 3.96927577672561*^9}},
 CellLabel->
  "In[187]:=",ExpressionUUID->"25dd3ef7-91ac-4de9-9415-ea466d4a908f"],

Cell["Effect of Pauli-Z on the state vector:", "Text",
 CellChangeTimes->{{3.968429667911319*^9, 3.968429683845615*^9}, {
  3.968429876969195*^9, 
  3.968429877555614*^9}},ExpressionUUID->"a9637a4c-7913-4eaa-a012-\
22fedc683932"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MatrixForm", "[", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}], "->", 
  RowBox[{"MatrixForm", "[", 
   RowBox[{
    RowBox[{"PauliMatrix", "[", "3", "]"}], ".", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.968418082959483*^9, 3.9684181284004498`*^9}, {
  3.968418191939884*^9, 3.968418232308118*^9}, {3.968495818334922*^9, 
  3.968495821617435*^9}},
 CellLabel->
  "In[188]:=",ExpressionUUID->"e91b02e0-79a4-4286-a23d-d24deed1b5e3"],

Cell["Effect of Pauli-Z in the Dirac notation:", "Text",
 CellChangeTimes->{{3.968429879827054*^9, 
  3.968429887826387*^9}},ExpressionUUID->"10c90a06-763b-42ef-9828-\
84aa71b852e7"],

Cell[BoxData[
 RowBox[{"TraditionalForm", "[", 
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}], "->", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "@", 
    RowBox[{"QuantumState", "[", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9684181365209846`*^9, 3.968418166478387*^9}, {
   3.968418234412457*^9, 3.968418304849619*^9}, 3.96844571520761*^9, {
   3.9692758021612*^9, 3.96927580613756*^9}},
 CellLabel->
  "In[190]:=",ExpressionUUID->"d8ab11d9-357b-45ea-932f-f3eb53e9d610"],

Cell["\<\
The Pauli-Z gate is equivalent to a phase rotation by an angle of pi. Aside \
from an overall global factor (a \[OpenCurlyDoubleQuote]global phase\
\[CloseCurlyDoubleQuote] that doesn\[CloseCurlyQuote]t affect measurement \
outcomes), they act the same on any qubit: the 0 part is unchanged, and the 1 \
part picks up a minus sign.\
\>", "Text",
 CellChangeTimes->{{3.968429893115006*^9, 
  3.968429942134205*^9}},ExpressionUUID->"2cf79165-4280-4301-8092-\
3245d2f3c956"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", "\"\<P\>\"", "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["2", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["224", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence["WireLabels" -> None, ImageSize -> 100],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellChangeTimes->{{3.968419141971715*^9, 3.968419168219451*^9}, 
   3.968445730488312*^9, {3.969275829034411*^9, 3.9692758351718893`*^9}},
 CellLabel->
  "In[191]:=",ExpressionUUID->"68372e38-3d80-4667-908f-f8598ecd880b"],

Cell["Effect of Phase-\[Pi] gate in the Dirac notation :", "Text",
 CellChangeTimes->{{3.968429967347736*^9, 
  3.9684299770261106`*^9}},ExpressionUUID->"1406aa35-c673-4c25-971b-\
f7cd1d5a6e30"],

Cell[BoxData[
 RowBox[{"TraditionalForm", "[", 
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}], "->", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"\"\<P\>\"", "[", "\[Pi]", "]"}], "]"}], "@", 
    RowBox[{"QuantumState", "[", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{
  3.968419135782919*^9, {3.9692758442531424`*^9, 3.969275852728695*^9}},
 CellLabel->
  "In[192]:=",ExpressionUUID->"71ef58d4-07f2-4411-b40c-dcfe07a424c6"],

Cell["\<\
Additionally, Pauli-Z operator can be seen as flipping eigenstates of Pauli-X\
\>", "Text",
 CellChangeTimes->{{3.968418318701169*^9, 
  3.968418341209982*^9}},ExpressionUUID->"02cbe234-5223-41ee-8543-\
8fc4bb0312c3"],

Cell["\<\
The Pauli-Z gate turns the plus state (the equal mix of 0 and 1 with the same \
sign) into the minus state (the equal mix of 0 and 1 with opposite signs)\
\>", "Text",
 CellChangeTimes->{{3.968429988164729*^9, 
  3.968430029247772*^9}},ExpressionUUID->"4337386d-7a05-4cb0-ab7d-\
b694a8f76d55"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], "->", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "[", 
    RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], "]"}]}], "//", 
  "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.968430046867453*^9, 3.9684300666007233`*^9}, {
  3.969275876157226*^9, 3.969275882113057*^9}},
 CellLabel->
  "In[193]:=",ExpressionUUID->"a124d28d-d446-4ce1-aba4-1b5e667d0975"],

Cell["\<\
Check that applying the Pauli-Z gate to the plus state returns the minus \
state.\
\>", "Text",
 CellChangeTimes->{{3.968430070809308*^9, 
  3.968430128321726*^9}},ExpressionUUID->"9ae1845d-7539-4e6a-8583-\
ad541850acf6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "[", 
   RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], "]"}], "==", 
  RowBox[{"QuantumState", "[", "\"\<-\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.968418342237467*^9, 3.968418358703759*^9}},
 CellLabel->
  "In[194]:=",ExpressionUUID->"6c54f36a-e39c-4f3c-ba43-66f0876ce061"],

Cell["\<\
The Pauli-Z gate turns the minus state (equal mix of 0 and 1 with opposite \
signs) into the plus state (equal mix with the same sign).\
\>", "Text",
 CellChangeTimes->{{3.968430003879735*^9, 3.9684300113135*^9}, 
   3.968430095394618*^9},ExpressionUUID->"52a28606-2d71-471c-a753-\
1f961f637278"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumState", "[", "\"\<-\>\"", "]"}], "->", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "[", 
    RowBox[{"QuantumState", "[", "\"\<-\>\"", "]"}], "]"}]}], "//", 
  "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.9684301502988453`*^9, 3.968430153542697*^9}},
 CellLabel->
  "In[195]:=",ExpressionUUID->"755a9050-fb6f-443a-8f6d-0f8eca695ecf"],

Cell["\<\
Check that applying the Pauli-Z gate to the minus state returns the plus \
state.\
\>", "Text",
 CellChangeTimes->{{3.968430143010745*^9, 
  3.968430147717763*^9}},ExpressionUUID->"f7048df1-ecc7-4eb3-a2d7-\
656059e22805"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "[", 
   RowBox[{"QuantumState", "[", "\"\<-\>\"", "]"}], "]"}], "==", 
  RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.968418364806123*^9, 3.968418367079721*^9}},
 CellLabel->
  "In[196]:=",ExpressionUUID->"cff46ec5-a767-4451-8322-83e754f586e9"],

Cell["\<\
Let\[CloseCurlyQuote]s visualize the effect of the Pauli-Z gate on different \
states by comparing the Bloch vectors of the initial and final states.\
\>", "Text",
 CellChangeTimes->{{3.968419102844343*^9, 3.968419106209217*^9}, {
   3.968430163479196*^9, 3.968430180581851*^9}, 
