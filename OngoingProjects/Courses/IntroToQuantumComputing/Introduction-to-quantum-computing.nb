                    StyleBox["\[Rho]", "TR"], 
                    StyleBox["n", "TI"]]}], "}"}], "]"}]], "Description" -> 
             TextData[{
               "plots a labeled Bloch sphere together with Bloch vectors of \
quantum density matrices ", 
                Cell[
                 BoxData[
                  RowBox[{
                    SubscriptBox[
                    StyleBox["\[Rho]", "TR"], 
                    StyleBox["i", "TI"]], "\[Element]", 
                    RowBox[{
                    SuperscriptBox["\[DoubleStruckCapitalC]", "2"], 
                    "\[CircleTimes]", 
                    SuperscriptBox["\[DoubleStruckCapitalC]", "2"]}]}]], 
                 "InlineFormula", FontFamily -> "Source Sans Pro"], "."}]|>}, 
          "Notes" -> {
            Cell[
            "The Bloch sphere is a way to draw any single qubit (2-level \
quantum system) as a point on a unit sphere.", "Notes", TaggingRules -> {}, 
             CellEventActions -> {
              Inherited, {"KeyDown", "\t"} :> Replace[SelectionMove[
                   SelectedNotebook[], After, Cell]; NotebookFind[
                   SelectedNotebook[], "TabNext", Next, CellTags, AutoScroll -> 
                   True, WrapAround -> True], Blank[NotebookSelection] :> 
                 SelectionMove[
                   SelectedNotebook[], All, CellContents, AutoScroll -> 
                   True]], PassEventsDown -> False, PassEventsUp -> False}, 
             CellChangeTimes -> {{3.972661759366757*^9, 3.97266179592277*^9}},
              CellTags -> {"DefaultContent", "TabNext"}, CellID -> 896489891], 
            Cell[
             TextData[{"For a generic qubit state vector ", 
               Cell[
                BoxData[
                 FormBox[
                  RowBox[{"{", 
                    RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], 
                  TraditionalForm]]], " with ", 
               Cell[
                BoxData[
                 FormBox[
                  RowBox[{"\[Alpha]", ",", 
                    
                    RowBox[{
                    "\[Beta]", "\[Element]", "\[DoubleStruckCapitalC]"}]}], 
                  TraditionalForm]]], ", assumed to be normalized ", 
               Cell[
                BoxData[
                 FormBox[
                  RowBox[{
                    RowBox[{
                    SuperscriptBox[
                    
                    RowBox[{
                    "\[LeftBracketingBar]", "\[Alpha]", 
                    "\[RightBracketingBar]"}], "2"], "+", 
                    SuperscriptBox[
                    
                    RowBox[{
                    "\[LeftBracketingBar]", "\[Beta]", 
                    "\[RightBracketingBar]"}], "2"]}], "=", "1"}], 
                  TraditionalForm]]], ", the Bloch vector is defined as ", 
               Cell[
                BoxData[
                 FormBox[
                  RowBox[{
                    OverscriptBox["n", "\[RightVector]"], "=", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"2", 
                    RowBox[{"Re", "[", 
                    RowBox[{
                    SuperscriptBox["\[Alpha]", "*"], " ", "\[Beta]"}], 
                    "]"}]}], ",", 
                    RowBox[{"2", 
                    RowBox[{"Im", "[", 
                    RowBox[{
                    SuperscriptBox["\[Alpha]", "*"], " ", "\[Beta]"}], 
                    "]"}]}], ",", 
                    RowBox[{
                    SuperscriptBox[
                    
                    RowBox[{
                    "\[LeftBracketingBar]", "\[Alpha]", 
                    "\[RightBracketingBar]"}], "2"], "-", 
                    SuperscriptBox[
                    
                    RowBox[{
                    "\[LeftBracketingBar]", "\[Beta]", 
                    "\[RightBracketingBar]"}], "2"]}]}], "}"}]}], 
                  TraditionalForm]]], "."}], "Notes", TaggingRules -> {}, 
             CellChangeTimes -> {{3.972661807722632*^9, 3.972661916844228*^9},
                3.9726771852777357`*^9}, CellID -> 1786160524], 
            Cell[
             TextData[{"For a qubit state denoted by a ", 
               Cell[
                BoxData[
                 FormBox[
                  RowBox[{"2", "\[Times]", "2"}], TraditionalForm]]], 
               " density matrix \[Rho], the Bloch vector is defined as ", 
               Cell[
                BoxData[
                 FormBox[
                  RowBox[{
                    OverscriptBox["n", "\[RightVector]"], "=", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Tr", "[", 
                    RowBox[{"\[Rho]", ".", 
                    SubscriptBox["\[Sigma]", "x"]}], "]"}], ",", 
                    RowBox[{"Tr", "[", 
                    RowBox[{"\[Rho]", ".", 
                    SubscriptBox["\[Sigma]", "y"]}], "]"}], ",", 
                    RowBox[{"Tr", "[", 
                    RowBox[{"\[Rho]", ".", 
                    SubscriptBox["\[Sigma]", "z"]}], "]"}]}], "}"}]}], 
                  TraditionalForm]]], 
               ". The density matrix \[Rho] should be explicitly positive \
semidefinite."}], "Notes", TaggingRules -> {}, 
             CellChangeTimes -> {{3.9726619224847803`*^9, 
               3.972661994558238*^9}, {3.972662088970006*^9, 
