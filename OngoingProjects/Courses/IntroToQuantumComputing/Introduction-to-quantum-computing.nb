Cell[TextData[{
 "Given the quantum state of the Bloch vector, check that Bloch coordinate of \
transformed state by ",
 Cell[BoxData[
  RowBox[{"U3", "[", 
   RowBox[{"\[Lambda]", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cc899c31-fffe-465d-8ecb-96dfb3831a04"],
 " is the same as ",
 Cell[BoxData[
  RowBox[{"EulerMatrix", "[", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "\[Lambda]", ",", "\[Phi]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bd6d9754-29b9-4f37-8895-900082f56457"],
 " on the Bloch vector:"
}], "Text",
 CellID->627301778,ExpressionUUID->"4e65d94b-cb5f-4747-9645-e71413846a06"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<U3\>\"", "[", 
       RowBox[{"\[Lambda]", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], "]"}], 
     "]"}], "[", 
    RowBox[{"QuantumState", "[", 
