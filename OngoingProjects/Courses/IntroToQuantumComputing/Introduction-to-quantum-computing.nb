         RowBox[{"TableHeadings", "->", 
          RowBox[{"{", 
           RowBox[{"None", ",", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\>\"", 
              ",", "\"\<\!\(\*SubscriptBox[\(R\), \
\(XX\)]\)[\[Theta]]\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\>\""}], "}"}]}], 
           "}"}]}]}], "]"}]}], "}"}], "]"}]}], "]"}]}]], "Input",
