Cell["Rotation around z-axis:", "Text",
 CellChangeTimes->{{3.9684312450462847`*^9, 3.968431261400467*^9}, 
   3.9684313573402357`*^9},ExpressionUUID->"75d58c82-e77c-4e45-b6fe-\
1130c280ea3a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<RZ\>\"", "[", "\[Theta]", "]"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"\"\<WireLabels\>\"", "->", "None"}], ",", 
   RowBox[{"ImageSize", "->", "100"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9684192046268673`*^9, 3.968419223992776*^9}, 
   3.968419904861864*^9, {3.9684200148429937`*^9, 3.9684200167975817`*^9}, {
   3.96842007602942*^9, 3.9684200765435143`*^9}, 3.968430886564411*^9, 
   3.9684309519332533`*^9, 3.968431358933071*^9, 3.96844577642144*^9},
 CellLabel->
  "In[244]:=",ExpressionUUID->"cdd0a3be-3589-42ff-bdc1-910aace8c6f4"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["R", "Z"], "[", "\[Theta]", "]"}], "=", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], 
     FractionBox["\[Theta]", "2"], "Z"}]]}], 
  TraditionalForm]],ExpressionUUID->"ccd2b7ea-47ca-4205-9977-04720e0b9f6d"]], \
"Text",
 CellChangeTimes->{{3.9684310517690983`*^9, 3.968431078567883*^9}, {
  3.96843136174337*^9, 
  3.968431363743771*^9}},ExpressionUUID->"34378b95-1d02-4c80-94f2-\
05e8916b22a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<RZ\>\"", "[", "\[Theta]", "]"}], "]"}], "==", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     RowBox[{"\[Theta]", "/", "2"}], " ", 
     RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], "]"}]}], "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.9684309641125193`*^9, 3.968431046598651*^9}, {
  3.968431365399288*^9, 3.9684313678042994`*^9}},
 CellLabel->
  "In[245]:=",ExpressionUUID->"03a4256d-c3e1-4fdf-a6d0-7cb5544a8a2b"],

Cell["Show the effect of z-rotation on a generic quantum state:", "Text",
 CellChangeTimes->{{3.96843108616328*^9, 3.968431105030004*^9}, {
  3.9684313702116117`*^9, 
  3.968431370476913*^9}},ExpressionUUID->"548e378c-ea7e-4d33-9820-\
59d444e1c6eb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}], "->", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"\"\<RZ\>\"", "[", "\[Theta]", "]"}], "]"}], "[", 
    RowBox[{"QuantumState", "[", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}], "]"}]}], "//", 
  "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.968419240993031*^9, 3.968419242039564*^9}, {
   3.9684199084720507`*^9, 3.968419918654922*^9}, {3.9684199790544167`*^9, 
   3.9684199800906277`*^9}, {3.96842002070317*^9, 3.96842002335177*^9}, {
