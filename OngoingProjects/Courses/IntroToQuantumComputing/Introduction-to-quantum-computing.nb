  3.968431458770389*^9}},ExpressionUUID->"0bb7195d-bb3b-456f-abcb-\
49a4a8d1545b"],

Cell[BoxData[
 RowBox[{"1", "/", 
  SuperscriptBox["2", 
   RowBox[{"n", "-", "1"}]]}]], "Input",
 CellChangeTimes->{{3.9684279757913647`*^9, 3.9684279778804913`*^9}},
 CellLabel->
  "In[227]:=",ExpressionUUID->"e5441db3-2ef0-42e0-9e34-d3b1ef7fef71"],

Cell["Show that the phase shift is similar to a phase operator:", "Text",
 CellChangeTimes->{{3.968431470005471*^9, 
  3.9684314916103983`*^9}},ExpressionUUID->"1b4ab90d-788d-4716-9215-\
b5c45e1ba461"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumOperator", "[", 
   RowBox[{"\"\<PhaseShift\>\"", "[", "n", "]"}], "]"}], "==", 
  RowBox[{"QuantumOperator", "[", 
   RowBox[{"\"\<P\>\"", "[", 
    RowBox[{"\[Pi]", "/", 
     SuperscriptBox["2", 
      RowBox[{"n", "-", "1"}]]}], "]"}], "]"}]}]], "Input",
 CellProlog:>Needs["Wolfram`QuantumFramework`"],
 CellChangeTimes->{{3.968427600032464*^9, 3.968427600785451*^9}, 
   3.968427664065744*^9, {3.968427983565394*^9, 3.9684279855835342`*^9}, {
   3.968431462084725*^9, 3.9684314627959557`*^9}},
 CellLabel->"In[228]:=",
 CellID->1200636875,ExpressionUUID->"ef224ff6-2ffa-48c1-9346-1fd3ce704b4b"],

Cell["\<\
A special case of adding a phase is adding a global phase. This is what we \
usually call a global phase gate.\
\>", "Text",
 CellChangeTimes->{{3.968431517480537*^9, 3.968431540186554*^9}, 
   3.968431579007187*^9},ExpressionUUID->"0df4c1ff-5dd5-4d22-8454-\
aa90cf68c591"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\[Theta]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<GlobalPhase\>\"", "[", "\[Theta]", "]"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"\"\<WireLabels\>\"", "->", "None"}], ",", 
   RowBox[{"ImageSize", "->", "100"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9684281792897043`*^9, 3.968428187383206*^9}, 
   3.9684457688927526`*^9},
 CellLabel->
  "In[229]:=",ExpressionUUID->"0520df94-af7f-44e3-9bd7-af3918e21a56"],

Cell["\<\
Since the phase is global (the same factor in front of all terms in the \
linear combination), it is not observable\[LongDash]it does not change the \
physical state.\
\>", "Text",
 CellChangeTimes->{{3.9684315440345716`*^9, 
  3.968431591620294*^9}},ExpressionUUID->"c99847a3-ffce-4b91-b958-\
969845b3601d"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"st", "=", 
     RowBox[{"QuantumState", "[", "\"\<RandomPure\>\"", "]"}]}], "}"}], ",", 
   RowBox[{"st", "==", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<GlobalPhase\>\"", "[", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"2", "\[Pi]"}]}], "}"}], "]"}], "]"}], "]"}], "[", "st", 
     "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.968428222697431*^9, 3.968428242010552*^9}, {
  3.9684282921886187`*^9, 3.968428297945609*^9}, {3.968429635163087*^9, 
  3.968429643140849*^9}},
 CellLabel->
  "In[231]:=",ExpressionUUID->"166c9b28-d68d-415c-9960-3e6ab47caa2a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Family of rotation gates", "Subsection",
 CellChangeTimes->{{3.968752664622073*^9, 
  3.968752671736555*^9}},ExpressionUUID->"3f2abf9c-0dff-4a63-a26a-\
d22e03736f38"],

Cell[TextData[{
 "Another important family of single-qubit gates is the set of rotation \
gates: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "X"], TraditionalForm]],ExpressionUUID->
  "27d10ab2-83fc-4f34-9337-37ff0ed35c83"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "Y"], TraditionalForm]],ExpressionUUID->
  "1a01019e-2a99-4dfd-a0e8-3498b6eb3920"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "Z"], TraditionalForm]],ExpressionUUID->
  "ced3c182-8f49-4c41-ad65-eca3eae1a4eb"],
 " that can be understand as rotations around the corresponding x, y, or z \
axis on the Bloch sphere by a given angle."
}], "Text",
 CellChangeTimes->{{3.96843084930234*^9, 3.968430947341003*^9}, {
  3.968431255188188*^9, 
  3.968431258562146*^9}},ExpressionUUID->"5d04192c-1330-4e72-bb22-\
19faf5d00023"],

Cell["Rotation around x-axis:", "Text",
 CellChangeTimes->{{3.9684312450462847`*^9, 
  3.968431261400467*^9}},ExpressionUUID->"8062d4f7-ea12-4a7e-b214-\
e0571ebcc321"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\[Theta]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"\"\<WireLabels\>\"", "->", "None"}], ",", 
   RowBox[{"ImageSize", "->", "100"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9684192046268673`*^9, 3.968419223992776*^9}, 
   3.968419904861864*^9, {3.9684200148429937`*^9, 3.9684200167975817`*^9}, {
   3.96842007602942*^9, 3.9684200765435143`*^9}, 3.968430886564411*^9, 
   3.9684309519332533`*^9, 3.968445771020678*^9, {3.968495879144331*^9, 
   3.968495879694914*^9}},
 CellLabel->
  "In[232]:=",ExpressionUUID->"da85a4b5-bc96-4e26-ab39-817bd5c68ca6"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["R", "X"], "[", "\[Theta]", "]"}], "=", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], 
     FractionBox["\[Theta]", "2"], "X"}]]}], 
  TraditionalForm]],ExpressionUUID->"9ba09c61-baea-4cbe-8876-897f0329f61d"]], \
"Text",
 CellChangeTimes->{{3.9684310517690983`*^9, 
  3.968431078567883*^9}},ExpressionUUID->"256ec192-0c28-451e-87c1-\
63b7c247d003"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], "]"}], "==", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     RowBox[{"\[Theta]", "/", "2"}], " ", 
     RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], "]"}]}], "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.9684309641125193`*^9, 3.968431046598651*^9}},
 CellLabel->
  "In[234]:=",ExpressionUUID->"420e2e0f-79f7-4547-8bba-92eeb4419a0e"],

Cell["Show the effect of X-rotation on a generic quantum state:", "Text",
 CellChangeTimes->{{3.96843108616328*^9, 
  3.968431105030004*^9}},ExpressionUUID->"842c8bc6-7209-46ad-bc90-\
c09b006d1328"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}], "->", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], "]"}], "[", 
    RowBox[{"QuantumState", "[", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], "]"}], "]"}]}], "//", 
  "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.968419240993031*^9, 3.968419242039564*^9}, {
  3.9684199084720507`*^9, 3.968419918654922*^9}, {3.9684199790544167`*^9, 
  3.9684199800906277`*^9}, {3.96842002070317*^9, 3.96842002335177*^9}, {
  3.968420079732174*^9, 3.968420110533834*^9}, {3.9684311140499372`*^9, 
  3.968431176049054*^9}},
 CellLabel->
  "In[235]:=",ExpressionUUID->"a6a42504-88ac-4cb3-a5f7-4cbfcba054a5"],

Cell["Show the matrix form of x-rotation:", "Text",
 CellChangeTimes->{{3.9684311800110903`*^9, 
  3.968431190610025*^9}},ExpressionUUID->"f1a6d8c2-d510-482f-b8e9-\
2d22aed46085"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], "]"}], "[", "\"\<Matrix\>\"",
    "]"}], "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.968419929306333*^9, 3.9684199326970043`*^9}, {
  3.968420026411455*^9, 3.968420027842965*^9}, {3.968420120150296*^9, 
  3.9684201203657017`*^9}},
 CellLabel->
  "In[236]:=",ExpressionUUID->"bc61fccc-5755-4c8b-b63d-47c7faa55db0"],

Cell["\<\
As mentioned before, an x-rotation is a rotation around the x-axis on the \
Bloch sphere.\
\>", "Text",
 CellChangeTimes->{{3.968431193238394*^9, 3.968431223824994*^9}, {
  3.968431395220447*^9, 
  3.968431396665763*^9}},ExpressionUUID->"0b36e4ec-9bc9-43a4-80be-\
2e89eebbc753"],

