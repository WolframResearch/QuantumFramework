Cell[TextData[{
 "The states labeled ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"+"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "337307ca-bcc1-46d1-868d-301c87f637b7"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"-"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "6e625939-9246-463f-b432-541afa80fc73"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"L"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "ddae65c1-d178-4c08-b78a-6b18e0884e5b"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"R"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "b4dbad51-7898-442e-ba32-9457c7d57bdb"],
 " are other specific states the qubits can attain. However, the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"0"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "c958dbb8-de8a-41d0-9414-758f99e30119"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"1"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "a5954fde-226c-490b-9a90-c0f7b0db9c9e"],
 " states are usually called the ",
 StyleBox["computational basis",
  FontWeight->"Bold"],
 " states. The use of the sphere already suggests that the space of 1-qubit \
states is already quite a bit richer than only 0 or 1 as in classical bits. "
}], "Text",
 CellChangeTimes->{
  3.969218926095389*^9, {3.9695460609570513`*^9, 
   3.9695460691886187`*^9}},ExpressionUUID->"f742098c-1763-4d3d-8039-\
2e8c47ea7a65"]
}, Open  ]],

