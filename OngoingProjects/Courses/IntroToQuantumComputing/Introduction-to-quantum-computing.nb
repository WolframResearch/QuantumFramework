TemplateBox[{
SubscriptBox[\"x\", \
\"-\"]},\"Ket\"]],ExpressionUUID->\"ecf38c2e-2e0d-49a3-b6e2-5367cca4cea9\"]],\
ExpressionUUID->\"fb3a3091-b550-4fb6-9884-49253b63ebec\"]\)\>\"", ",", 
