 CellLabel->
  "In[306]:=",ExpressionUUID->"cbed51a8-4982-4626-848d-e340317c365d"],

Cell["\<\
Show how a Toffoli gate acts on the computational basis of three-qubits:\
\>", "Text",
 CellChangeTimes->{{3.96930127120288*^9, 3.969301283720964*^9}, 
   3.971797224581264*^9},ExpressionUUID->"a3598d7c-13cd-49ac-b25a-\
ea7289ea566a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"op", "=", 
      RowBox[{"QuantumCircuitOperator", "[", 
       RowBox[{"{", 
        RowBox[{"QuantumOperator", "@", "\"\<Toffoli\>\""}], "}"}], "]"}]}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"op", "[", 
        RowBox[{"\"\<Diagram\>\"", ",", 
         RowBox[{"\"\<WireLabels\>\"", "->", "None"}], ",", 
         RowBox[{"ImageSize", "->", "100"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<Toffoli gate\>\""}]}], "]"}], ",", 
       ",", "\"\<  \>\"", ",", 
       RowBox[{"TableForm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"TraditionalForm", "[", "#", "]"}], ",", 
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"op", "[", "#", "]"}], "]"}]}], "}"}], "&"}], "/@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"QuantumState", "[", 
             RowBox[{"\"\<Register\>\"", "[", 
              RowBox[{"3", ",", "i"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", 
              RowBox[{
               SuperscriptBox["2", "3"], "-", "1"}]}], "}"}]}], "]"}]}], ",", 
         RowBox[{"TableHeadings", "->", 
          RowBox[{"{", 
           RowBox[{"None", ",", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<\!\(\*TemplateBox[{\"abc\"},\"Ket\"]\)\>\"", 
              ",", "\"\<Toffoli\!\(\*TemplateBox[{\"abc\"},\"Ket\"]\)\>\""}], 
             "}"}]}], "}"}]}], ",", 
         RowBox[{"TableDepth", "->", "2"}]}], "]"}]}], "}"}], "]"}]}], "]"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.96902254004335*^9, 3.9690226217372093`*^9}, {
  3.9693010320088654`*^9, 3.9693011300545483`*^9}, {3.969301255601666*^9, 
  3.9693012619099903`*^9}},
