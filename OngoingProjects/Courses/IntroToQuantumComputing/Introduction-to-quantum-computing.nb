TemplateBox[{\"0\"},\"Ket\"]],ExpressionUUID->\"8c9e83d4-0dae-43b0-a802-\
1e15c4d849db\"]],ExpressionUUID->\"ed6b29b3-1de2-40ae-9403-14b1193aa186\"]\)\>\
\"", ",", "Left"}], "]"}], ",", 
         RowBox[{"Placed", "[", 
