Cell[CellGroupData[{

Cell["Post-Processing the Eigenvalue Estimations", "Subsection",
 CellChangeTimes->{{3.955640667651602*^9, 
  3.955640674364357*^9}},ExpressionUUID->"fdacd10c-9ce1-4a30-a102-\
c467a23af026"],

Cell[TextData[{
 "For now, take for granted the curious fact about the distribution of \
sampled eigenvalues and the distribution for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "=", 
    FractionBox["k", "r"]}], TraditionalForm]],ExpressionUUID->
  "e0d4492a-a822-42cb-b3db-15a34c8371d0"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "\[Element]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "\[Ellipsis]", ",", 
      RowBox[{"r", "-", "1"}]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "dae38698-277b-424d-b424-76fdb566f947"],
 ". You can use this fact to obtain ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "55ab46e8-303a-4074-83de-172da9f38057"],
 ". Consider all possible outcomes that can be obtained by the previous \
circuit:"
}], "Text",
 CellChangeTimes->{{3.9556411919977207`*^9, 3.955641203421673*^9}, {
  3.955641248269373*^9, 3.955641272536148*^9}, {3.955641430583742*^9, 
  3.955641526105728*^9}},ExpressionUUID->"93b3b5d6-a5d8-4790-9699-\
f9bfe5bd8bb6"],

Cell[BoxData[
 RowBox[{"Keys", "@", 
  RowBox[{"measurement1", "[", "\"\<Probability\>\"", "]"}]}]], "Input",
 CellLabel->
  "In[525]:=",ExpressionUUID->"03459fb5-a0fb-4bfc-8e7b-4f04345168af"],

Cell[TextData[{
 "Next, convert these to fractions which uniformly estimate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "=", 
    FractionBox["k", "r"]}], TraditionalForm]],ExpressionUUID->
  "09002eff-842f-434a-aa30-5d632798c56c"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9556415766803513`*^9, 
  3.9556416090163364`*^9}},ExpressionUUID->"cb28b01c-edd6-4977-a1da-\
74a3ba96667f"],

Cell[BoxData[
 RowBox[{"\[Phi]s", "=", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"FromDigits", "[", 
       RowBox[{
        RowBox[{"#", "[", "\"\<Name\>\"", "]"}], ",", "2"}], "]"}], 
      SuperscriptBox["2", 
       RowBox[{"Length", "[", 
        RowBox[{"#", "[", "\"\<Name\>\"", "]"}], "]"}]]], "&"}], ",", 
    RowBox[{"Keys", "@", 
     RowBox[{"measurement1", "[", "\"\<Probability\>\"", "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9556416315616264`*^9, 3.955641703468399*^9}, {
  3.969373365834263*^9, 3.969373374208541*^9}},
 CellLabel->
  "In[526]:=",ExpressionUUID->"447f2494-f933-4058-851d-76a04c94f3be"],

Cell[TextData[{
 "Finally, the least common multiple of the denominators can be used to tell \
you ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "f5f4b60f-da48-413b-a6d8-5f65664a04ed"],
 ":"
}], "Text",
 CellChangeTimes->{{3.955641726849327*^9, 
  3.955641774693966*^9}},ExpressionUUID->"394782ad-22e6-4c53-ba37-\
11d45b99729d"],

Cell[BoxData[
 RowBox[{"LCM", "@@", 
  RowBox[{"Denominator", "[", "\[Phi]s", "]"}]}]], "Input",
 CellChangeTimes->{{3.95564174592733*^9, 3.955641758618721*^9}},
 CellLabel->
  "In[527]:=",ExpressionUUID->"6b58f15b-f429-497c-ab00-dbaf75b8eca1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Exploring the Details", "Subsection",
 CellChangeTimes->{{3.955640667651602*^9, 3.955640674364357*^9}, {
   3.9556411296096535`*^9, 3.9556411442437286`*^9}, 3.955641221921154*^9, {
   3.9556454087623806`*^9, 
   3.955645410332775*^9}},ExpressionUUID->"0d3a03d8-684e-457e-b477-\
cc2737065853"],

Cell[TextData[{
 "In the phase estimation circuit, you may have noticed that the ancilla \
qubits are prepared in the state ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]],ExpressionUUID->"e41831fd-f07a-42e9-aed3-71f93b59e81e"],
 ". Why was this state chosen? Recall that the unitary operator used for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "\[ScriptA]"], TraditionalForm]],ExpressionUUID->
  "6ad563f6-b846-4769-ba08-836812195f86"],
 " had four distinct eigenvalues because the multiplicative order of \
\[ScriptA] modulo \[ScriptCapitalN] was also equal to four."
}], "Text",
 CellChangeTimes->{{3.955640712489649*^9, 3.95564076812302*^9}, {
  3.955640804569317*^9, 3.955640878372389*^9}, {3.969373161021226*^9, 
  3.969373185941321*^9}},ExpressionUUID->"c78e583d-76ae-4d6a-942d-\
056582e53537"],

Cell[BoxData[
 RowBox[{"MultiplicativeOrder", "[", 
  RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}]], "Input",
 CellChangeTimes->{{3.969373134053895*^9, 3.9693731547822847`*^9}},
 CellLabel->
  "In[528]:=",ExpressionUUID->"3df4e4db-a4f2-4044-9f54-4f4739ec369b"],

Cell[TextData[{
 "What happens if you express the state ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]],ExpressionUUID->"175a7fce-9cc5-4d5d-96f0-a782420d20a3"],
 " in a new basis? If you recall from linear algebra, a unitary matrix can be \
converted into a diagonal form using its eigenvectors as basis elements. If \
you don\[CloseCurlyQuote]t remember how to carry out this computation, the \
Quantum Framework can automate much of the process."
}], "Text",
 CellChangeTimes->{{3.9556408898811016`*^9, 3.9556409052157307`*^9}, {
  3.955640939413019*^9, 
  3.955641044321102*^9}},ExpressionUUID->"fcc52523-6c59-4de0-9a24-\
be918ff1ab3e"],

Cell["\<\
First, let\[CloseCurlyQuote]s label the new basis elements according to their \
eigenvalues (and an arbitrary index, since there are repeated eigenvalues):\
\>", "Text",
 CellChangeTimes->{{3.955641051395439*^9, 3.9556410960571556`*^9}, 
   3.95564449897908*^9},ExpressionUUID->"f624e00f-701d-439e-9f3a-\
c1b938ffbf04"],

Cell[BoxData[
 RowBox[{"\[ScriptCapitalU]eigenbasis", "=", 
  RowBox[{"QuantumBasis", "@", 
   RowBox[{"Association", "@", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sys", "=", 
        RowBox[{"Eigensystem", "@", 
         RowBox[{"\[ScriptCapitalU]a", "[", 
          RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}]}]}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"QuditName", "[", 
           SubsuperscriptBox["\"\<\[Psi]\>\"", 
            RowBox[{"\"\<\[Lambda]=\>\"", "<>", 
             RowBox[{"ToString", "@", 
              RowBox[{"TraditionalForm", "@", "#2"}]}]}], 
            RowBox[{"ToString", "@", "#1"}]], "]"}], "->", "#3"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"Length", "@", 
            RowBox[{"sys", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"sys", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"sys", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9556445534754295`*^9, 3.9556446649992695`*^9}, {
  3.955644697870178*^9, 3.9556447221224957`*^9}, {3.9556448748522053`*^9, 
  3.955644885153858*^9}, {3.955645163416033*^9, 3.955645164701109*^9}, {
  3.969373223341044*^9, 3.9693732292962227`*^9}},
 CellLabel->
  "In[529]:=",ExpressionUUID->"9bfc2f71-1a42-4af1-b43b-313d9c32935f"],

Cell["\<\
Now, each new basis vector has an arbitrary index and you can see its \
corresponding eigenvalue:\
\>", "Text",
 CellChangeTimes->{{3.9556448961151123`*^9, 3.9556449057341423`*^9}, {
  3.9556449847298737`*^9, 
  3.9556449952672043`*^9}},ExpressionUUID->"07ff67e4-2cf5-4e2e-9286-\
3ab43e85ad23"],

Cell[BoxData[
 RowBox[{"\[ScriptCapitalU]eigenbasis", "[", "\"\<ElementNames\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{3.955644668859215*^9, 3.9556446858749046`*^9}, {
   3.9556447409252033`*^9, 3.9556447517487717`*^9}, 3.955645172263258*^9},
 CellLabel->
  "In[530]:=",ExpressionUUID->"dd026cfa-d7cb-47d7-8cee-82424b940a57"],

Cell[TextData[{
 "The state ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]],ExpressionUUID->"f0fa4a2f-eba6-4fdd-994b-ae0a6c9e537e"],
 " has a nice feature when represented in this new basis. As you can see, it \
is a linear combination of one vector with each distinct eigenvalue:"
}], "Text",
 CellChangeTimes->{{3.9556450741292953`*^9, 3.955645090045471*^9}, {
  3.9556451361284904`*^9, 
  3.9556451374788647`*^9}},ExpressionUUID->"ada56f3e-7911-4beb-b3e5-\
e7bf11f35ca8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"\"\<1\>\"", ",", 
      RowBox[{"QuantumBasis", "[", 
       RowBox[{"2", ",", "m"}], "]"}]}], "]"}], ",", 
    "\[ScriptCapitalU]eigenbasis"}], "]"}], "//", 
  "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.9556447875313587`*^9, 3.9556448113478527`*^9}, 
   3.955645179112179*^9, {3.9693732782369432`*^9, 3.969373312036433*^9}},
 CellLabel->
  "In[531]:=",ExpressionUUID->"bc227946-de88-4325-841d-4d88dae7777c"],

Cell["\<\
This (perhaps surprising) fact is what allows the quantum phase estimation \
algorithm to sample uniformly from the distinct eigenvalues.\
\>", "Text",
 CellChangeTimes->{{3.955645094305132*^9, 3.9556451553995075`*^9}, {
  3.9556452757176266`*^9, 
  3.9556453063195305`*^9}},ExpressionUUID->"9ea4cd65-35c3-4ee9-967a-\
96115636ee14"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"\"\<1\>\"", ",", 
      RowBox[{"QuantumBasis", "[", 
       RowBox[{"2", ",", "m"}], "]"}]}], "]"}], ",", 
    "\[ScriptCapitalU]eigenbasis"}], "]"}], "[", 
  RowBox[{"\"\<ProbabilityPlot\>\"", ",", 
   RowBox[{"AspectRatio", "->", 
    RowBox[{"1", "/", "4"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9556453176106606`*^9, 3.955645346456293*^9}, 
   3.9693733262053022`*^9, 3.969923000571535*^9},
 CellLabel->
  "In[532]:=",ExpressionUUID->"adf94328-68a6-4b4e-9399-cd832aa3d88a"],

Cell[TextData[{
 "As long as enough register qubits are used to capture each possible \
eigenvalue, this idealized circuit will very quickly allow you to estimate ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "50e5ae7b-2164-4195-acd7-0ae946815ad5"],
 "."
}], "Text",
 CellChangeTimes->{{3.955645477459997*^9, 
  3.955645543724123*^9}},ExpressionUUID->"01bdce18-020e-4b7f-809e-\
05ff1be98864"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Quantum Key Distribution: BB84 scheme", "Chapter",
 CellChangeTimes->{3.972496577762621*^9},
 CellID->419239073,ExpressionUUID->"b826bb71-476f-4daf-9e88-41dbb055ff7d"],

Cell[TextData[{
 "BB84 (named after ",
 ButtonBox["Bennett and Brassard's 1984 paper",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/2003.06557"], None},
  ButtonNote->"https://arxiv.org/pdf/2003.06557"],
 ") is a quantum protocol for securely establishing a shared secret key \
between two parties. It is the earliest and most well-known example of \
Quantum Key Distribution (QKD), and it uses properties of quantum mechanics, \
such as the fact that measuring a quantum state disturbs it, to detect any \
eavesdropping and ensure the secrecy of the generated key."
}], "Text",
 CellChangeTimes->{{3.97299328822009*^9, 3.972993297908687*^9}, {
  3.9729974958081207`*^9, 3.9729975133427*^9}, {3.972997726636238*^9, 
  3.972997753326304*^9}},
 CellID->1190450338,ExpressionUUID->"f2ec30e0-7e5a-43c5-a5c8-5c2a0bcbc58d"],

Cell[CellGroupData[{

Cell["Key Concepts", "Section",
 CellChangeTimes->{{3.9458857262477703`*^9, 3.945885728184759*^9}},
 CellID->310316371,ExpressionUUID->"cbe1bb19-509a-4aed-8e59-e52eae494d35"],

Cell["BB84 protocol. ", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, {
  3.9459508180356083`*^9, 3.9459508219695263`*^9}, {3.9465031788793373`*^9, 
  3.9465031894301834`*^9}, {3.9548600289721966`*^9, 3.954860032093584*^9}, {
  3.9552069118913784`*^9, 3.955206918579336*^9}, {3.955207387443159*^9, 
  3.955207387443159*^9}, {3.972999803194654*^9, 3.972999825323427*^9}},
 CellID->1396952481,ExpressionUUID->"46ea5689-726a-476c-899a-b21556a20f06"],

Cell["Quantum Key Distribution", "Item",
 CellChangeTimes->{{3.9458859634015427`*^9, 3.945885977867079*^9}, 
   3.945966437091715*^9, {3.94650320037673*^9, 3.9465032026390457`*^9}, {
   3.9465034302710743`*^9, 3.9465034355196266`*^9}, {3.9465079620495815`*^9, 
   3.94650798489847*^9}, {3.946921626805523*^9, 3.9469216289980717`*^9}, {
   3.954860034753294*^9, 3.9548600366745224`*^9}, {3.9552069230513515`*^9, 
   3.95520692616238*^9}, {3.972999814833434*^9, 3.9729998189314423`*^9}, 
   3.973004140455896*^9},
 CellID->1056236536,ExpressionUUID->"db9f94e6-3c4c-4119-99b4-271894201462"]
}, Open  ]],

Cell[CellGroupData[{

Cell["One-time pad encryption", "Section",
 CellChangeTimes->{{3.855414385560004*^9, 3.855414391411203*^9}},
 CellID->298316802,ExpressionUUID->"52013c69-dbfc-4803-b594-5f41245066c2"],

Cell["\<\
In this section, we briefly review the one-time pad encryption by using a \
secret key, securely shared between two parties (e.g., Alice and Bob). We let \
Alice and Bob share the same secret key securely. Once they have that key, \
they use it in an ordinary classical one-time pad encryption.\
\>", "Text",
 CellChangeTimes->{{3.855622427333453*^9, 3.855622476204163*^9}, {
  3.97299994493661*^9, 3.972999993446496*^9}},
 CellID->1583659116,ExpressionUUID->"5a20193c-ce86-4ec1-909f-053990b16715"],

Cell["\<\
First, Alice and Bob need a way to turn text into bits. \
Let\[CloseCurlyQuote]s define a function that is doing just that.\
\>", "Text",
 CellChangeTimes->{{3.973000025403035*^9, 3.973000047720845*^9}},
 CellID->1721617063,ExpressionUUID->"dc7fe2dd-679d-4297-8c59-ecec1f7a3382"],

Cell["Define a function that returns the ASCII bits of a string:", "Text",
 CellChangeTimes->{{3.855413538174942*^9, 3.8554135531129417`*^9}},
 CellID->646441694,ExpressionUUID->"cf9a39b2-6a7b-4183-b88b-bb60e943b918"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ascii", "[", "st_String", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"IntegerDigits", "[", 
     RowBox[{"#", ",", "2"}], "]"}], "&"}], "/@", 
   RowBox[{"ToCharacterCode", "[", "st", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.855413529285034*^9, 3.855413535125636*^9}},
 CellLabel->"In[533]:=",
 CellID->625780885,ExpressionUUID->"756b0cf8-ff1f-48ef-806b-730faa95df18"],

Cell["\<\
When you give it a string like \[OpenCurlyDoubleQuote]Wolfram\
\[CloseCurlyDoubleQuote], it takes each character, finds its ASCII code (a \
number that represents that character), and then converts that number into \
its binary representation, that is, a sequence of zeros and ones. \
\>", "Text",
 CellChangeTimes->{
  3.97300017322919*^9, {3.973000213160677*^9, 3.9730002154415617`*^9}},
 CellID->72987773,ExpressionUUID->"4580e390-abd6-4f11-a2fa-706ab0dade4b"],

Cell["Select a secret key (shared securely between Alice and bob):", "Text",
 CellChangeTimes->{{3.855413572240138*^9, 3.855413576916546*^9}, {
  3.8554147016725693`*^9, 3.8554147121105843`*^9}},
 CellID->1271914836,ExpressionUUID->"d0183386-cfb3-4b71-afe0-3ffdc5a276f1"],

Cell[BoxData[
 RowBox[{"key", "=", 
  RowBox[{"ascii", "[", "\"\<Wolfram\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.855413554674172*^9, 3.855413560378119*^9}},
 CellLabel->"In[534]:=",
 CellID->1020426414,ExpressionUUID->"a0f81f91-04cc-4a7a-9c2a-9de2d81fa8f5"],

Cell["\<\
The output is a list of lists: one list of seven bits for each character. \
This list of bit blocks is what both Alice and Bob possess as their shared \
secret key.\
\>", "Text",
 CellChangeTimes->{{3.9730000851207457`*^9, 3.973000090388939*^9}, {
  3.9730001378788033`*^9, 3.973000164690159*^9}, {3.9730002170247927`*^9, 
  3.9730002284389763`*^9}},
 CellID->1099532538,ExpressionUUID->"ef094205-4e2e-479a-ad7e-a03b2b8e3be6"],

Cell["\<\
Then Alice prepares the message she wants to send, which here is the word \
\[OpenCurlyDoubleQuote]Quantum\[CloseCurlyDoubleQuote].\
\>", "Text",
 CellChangeTimes->{3.9730002561521273`*^9},
 CellID->1535985037,ExpressionUUID->"87e110e0-281b-4026-9ed2-6320b9319c84"],

Cell["Select a message (Alice wants to send it to Bob):", "Text",
 CellChangeTimes->{{3.855413572240138*^9, 3.855413576916546*^9}, {
  3.855414288318163*^9, 3.855414290854863*^9}, {3.85541471657795*^9, 
  3.8554147226278563`*^9}},
 CellID->988750535,ExpressionUUID->"6d456ebb-4f9b-4225-8b67-d1203de997a6"],

Cell[BoxData[
 RowBox[{"message", "=", 
  RowBox[{"ascii", "[", "\"\<Quantum\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.8554136308962297`*^9, 3.855413639767542*^9}},
 CellLabel->"In[535]:=",
 CellID->701781259,ExpressionUUID->"452ee515-9383-440d-9d06-24f27e5c7e78"],

Cell["\<\
Now Alice has two aligned lists: one is the message bits, one is the key \
bits, both the same length, with each character of the message lined up with \
a corresponding character of the key. To encrypt, Alice combines the message \
bits with the key bits using the bitwise XOR operation. XOR is a very simple \
rule on individual bits: if the two bits are the same, the result is zero; if \
they are different, the result is one. The result is a ciphertext that looks \
like nonsense if you try to interpret it as plain text, and without the key, \
it gives no information about the original message.\
\>", "Text",
 CellChangeTimes->{{3.973000278691886*^9, 3.9730003042704782`*^9}, {
  3.973000863032318*^9, 3.973000887715433*^9}},
 CellID->399596272,ExpressionUUID->"a667cf96-b443-4a3a-bbac-95a1c2e66de5"],

Cell["\<\
Generate a ciphertext by taking the XOR of each bit of the message with each \
bit of the secret key (Alice does this, and send the ciphertext to Bob):\
\>", "Text",
 CellChangeTimes->{{3.855413596322937*^9, 3.8554136239557467`*^9}, {
  3.855414729872843*^9, 3.8554147414826717`*^9}, {3.855587825380554*^9, 
  3.855587831785231*^9}},
 CellID->1222318653,ExpressionUUID->"f30cb72c-8641-433f-9563-b9d53bbca7d0"],

Cell[BoxData[
 RowBox[{"ciphertext", "=", 
  RowBox[{"MapThread", "[", 
   RowBox[{"BitXor", ",", 
    RowBox[{"{", 
     RowBox[{"message", ",", "key"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.855413645909501*^9, 3.85541365566499*^9}, {
  3.855413721441183*^9, 3.855413743309786*^9}, {3.855414034433812*^9, 
  3.855414061155361*^9}},
 CellLabel->"In[536]:=",
 CellID->681033769,ExpressionUUID->"5242d82a-f079-4d4f-8018-c09215b5c7e9"],

Cell["\<\
Alice then sends this ciphertext over the classical channel to Bob. An \
eavesdropper can see the ciphertext, but without the key, the one-time pad \
guarantees that the message is information-theoretically secure, provided the \
key is truly random, at least as long as the message, and used only once. \
When Bob receives the ciphertext, he decrypts it using the exact same \
operation: bitwise XOR with the same key.\
\>", "Text",
 CellChangeTimes->{{3.9730003182498293`*^9, 3.973000341447782*^9}},
 CellID->551859077,ExpressionUUID->"c886f2a8-ad44-4a28-ab36-f38019f0283f"],

Cell["\<\
Decode the ciphertext by taking the XOR of each bit of it with each bit of \
the secret key (Given Alice message, Bob does this step):\
\>", "Text",
 CellChangeTimes->{{3.855413572240138*^9, 3.855413576916546*^9}, {
  3.855414307061659*^9, 3.855414323361528*^9}, {3.855414744933134*^9, 
  3.8554147552788773`*^9}},
 CellID->1342314756,ExpressionUUID->"bc60e17d-e8c4-49fb-8f98-4b997aa86081"],

Cell[BoxData[
 RowBox[{"decodedtext", "=", 
  RowBox[{"MapThread", "[", 
   RowBox[{"BitXor", ",", 
    RowBox[{"{", 
     RowBox[{"ciphertext", ",", "key"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.855414213733192*^9, 3.855414220338399*^9}},
 CellLabel->"In[537]:=",
 CellID->968392357,ExpressionUUID->"57abaa08-fdde-4575-949b-ba25691a3912"],

Cell["Show the text of the decoded text:", "Text",
 CellChangeTimes->{{3.855414355618075*^9, 3.855414371793005*^9}},
 CellID->1491486257,ExpressionUUID->"629d2f7e-305d-4d0f-b6c2-f5040f559b30"],

Cell[BoxData[
 RowBox[{"StringJoin", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"FromCharacterCode", "[", 
     RowBox[{"FromDigits", "[", 
      RowBox[{"#", ",", "2"}], "]"}], "]"}], "&"}], "/@", "decodedtext"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.855414109487344*^9, 3.855414160779251*^9}, {
  3.855414224132895*^9, 3.855414254263747*^9}},
 CellLabel->"In[538]:=",
 CellID->1980393615,ExpressionUUID->"862c2a87-eb63-4b56-8bfd-43897e199bf0"],

Cell["\<\
So, in plain language, Alice and Bob shared a secret string of bits. Alice \
turned her message into bits, combined it with the secret bits using XOR to \
produce an encrypted bit string, and send that to Bob. Bob used the same \
secret bits and the same XOR operation to reverse the process and get the \
original message back. \
\>", "Text",
 CellChangeTimes->{{3.973000921210219*^9, 3.973000995387947*^9}},
 CellID->224146245,ExpressionUUID->"62fd9ca2-6597-4734-ab5e-601e9e80ba3d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bennett-Brassard quantum solution (BB84)", "Section",
 CellChangeTimes->{{3.855414434587627*^9, 3.855414456710215*^9}},
 CellID->1653453170,ExpressionUUID->"ac41c7c4-f918-46da-9f9e-adef24c34f38"],

Cell["\<\
As an example of a quantum key distribution (QKD), we consider BB84 protocol. \
It starts with Alice. She decides she\[CloseCurlyQuote]s going to send nine \
qubits to Bob. Note that the number of qubits (here nine) is completely your \
choice and not special to BB84 at all. For each qubit, Alice needs two random \
choices: which bit she wants to encode (zero or one), and which basis she \
wants to use to encode it. In BB84, there are two possible bases: the Z basis \
and the X basis. We will first choose nine random bits for Alice, and then \
nine random bases, each either Z or X. So, for each position from one to \
nine, Alice now has a pair: a bit and a basis.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.809817407148046*^9, 3.809817456944992*^9}, {
   3.8098174905033965`*^9, 3.8098176617526493`*^9}, {3.8104212004091887`*^9, 
   3.81042120964787*^9}, {3.812401644190731*^9, 3.812401658366069*^9}, {
   3.851536092761649*^9, 3.8515360986455927`*^9}, {3.855414574745767*^9, 
   3.855414606564493*^9}, 3.973001226711541*^9, {3.9730012624034767`*^9, 
   3.973001267837326*^9}, {3.973001376097602*^9, 3.9730013980080433`*^9}},
 CellID->1481897464,ExpressionUUID->"ebda3575-56a8-4da1-a4b3-9c850bcf2ace"],

Cell["Generate bases and bits of Alice randomly for nine qubits:", "Text",
 CellChangeTimes->{{3.855414784550252*^9, 3.855414851392618*^9}, {
  3.8554285920944767`*^9, 3.855428611990284*^9}, {3.97249675639746*^9, 
  3.972496758328409*^9}, {3.973001282394166*^9, 3.973001295286544*^9}},
 CellID->1149036010,ExpressionUUID->"35e36aba-da07-4bee-8d06-4a89bcd8e754"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "9"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"aliceBits", " ", "=", " ", 
  RowBox[{"RandomChoice", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}], ",", "n"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"aliceBases", "=", " ", 
  RowBox[{"RandomChoice", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<Z\>\"", ",", "\"\<X\>\""}], "}"}], ",", "n"}], 
   "]"}]}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.8098209761059437`*^9, 3.8098209920724964`*^9}, {
   3.809822152246843*^9, 3.8098221548620176`*^9}, 3.843425048801353*^9, {
   3.8554148618771677`*^9, 3.855414897126485*^9}, {3.855415078847789*^9, 
   3.8554150790987062`*^9}, {3.855415132815703*^9, 3.855415133526641*^9}, {
   3.8554893900803347`*^9, 3.8554893935624743`*^9}, {3.972497715409873*^9, 
   3.972497723369969*^9}},
 CellLabel->"In[6]:=",
 CellID->845626301,ExpressionUUID->"2676f7c6-1570-4794-bc00-6f2445d13ecc"],

Cell[TextData[{
 "Next, let\[CloseCurlyQuote]s define Alice\[CloseCurlyQuote]s \
\[OpenCurlyDoubleQuote]sending rule\[CloseCurlyDoubleQuote]. It\
\[CloseCurlyQuote]s basically a mapping that says: if \
Alice\[CloseCurlyQuote]s bit is zero and she picked the Z basis, she prepares \
a qubit in the standard zero state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"0"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c8098fc0-4589-4b42-b567-9e22153bbae3"],
 ". If her bit is one and she picked the Z basis, she prepares the standard \
one state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"1"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ccbb8f69-57c8-4e50-8846-64b60f6f4aca"],
 ". If she picked the X basis instead, then zero is encoded as the \
\[OpenCurlyDoubleQuote]plus\[CloseCurlyDoubleQuote] state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["x", "+"]},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fbb1f3c7-2d03-4df4-a0b2-684feb545c3e"],
 " in the X basis, and one is encoded as the \[OpenCurlyDoubleQuote]minus\
\[CloseCurlyDoubleQuote] state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["x", "-"]},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "928ce0f8-5086-4bb8-806c-db1f77ffca24"],
 " in the X basis."
}], "Text",
 CellChangeTimes->{{3.973001734419682*^9, 3.9730018372401123`*^9}},
 CellID->1905317028,ExpressionUUID->"2224b890-f443-4ecf-96c0-07e6096b5c9d"],

Cell["\<\
Depending on what bit and what base, Alice follows the following protocol for \
sending a qubit to Bob:\
\>", "Text",
 CellChangeTimes->{{3.855415085998945*^9, 3.855415110832653*^9}, {
  3.972496770890093*^9, 3.9724968032387743`*^9}},
 CellID->1180569302,ExpressionUUID->"c9cc3d51-735d-4d3d-a4c6-e2166d9fff13"],

Cell[BoxData[
 RowBox[{
  RowBox[{"aliceProtocol", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "\"\<Z\>\""}], "}"}], "->", 
      RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "\"\<X\>\""}], "}"}], "->", 
      RowBox[{"QuantumState", "[", 
       RowBox[{"\"\<0\>\"", ",", "\"\<PauliX\>\""}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "\"\<Z\>\""}], "}"}], "->", 
      RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "\"\<X\>\""}], "}"}], "->", 
      RowBox[{"QuantumState", "[", 
       RowBox[{"\"\<1\>\"", ",", "\"\<PauliX\>\""}], "]"}]}]}], "|>"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.855414972268262*^9, 3.855415064967411*^9}, {
   3.8554151177091913`*^9, 3.855415148201499*^9}, {3.855416055800744*^9, 
   3.85541607125688*^9}, 3.85541610439459*^9, {3.855428636353283*^9, 
   3.855428661153986*^9}, {3.8555878788631697`*^9, 3.855587890853857*^9}, {
   3.855588279626498*^9, 3.8555883100585613`*^9}, {3.972496814190537*^9, 
   3.9724968320441217`*^9}, {3.972497845242487*^9, 3.972497847612816*^9}},
 CellLabel->"In[9]:=",
 CellID->1226844081,ExpressionUUID->"758e9be2-47c0-4568-ad34-6750765da433"],

Cell["Visualize Alice\[CloseCurlyQuote]s protocol:", "Text",
 CellChangeTimes->{{3.972496834095265*^9, 3.972496842115738*^9}},
 CellID->1577974520,ExpressionUUID->"b8b88883-9e3e-4b2f-9616-09aae049146a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", "\"\<Formula\>\"", "]"}], "&"}], "/@", 
    "aliceProtocol"}], "//", "Normal"}], "//", "Column"}]], "Input",
 CellChangeTimes->{{3.855414972268262*^9, 3.855415064967411*^9}, {
   3.8554151177091913`*^9, 3.855415148201499*^9}, {3.855416055800744*^9, 
   3.85541607125688*^9}, 3.85541610439459*^9, {3.855428636353283*^9, 
   3.855428661153986*^9}, {3.8555878788631697`*^9, 3.855587890853857*^9}, {
   3.855588279626498*^9, 3.8555883100585613`*^9}, {3.972496814190537*^9, 
   3.9724968320441217`*^9}},
 CellLabel->"In[10]:=",
 CellID->1742200837,ExpressionUUID->"b0b456e6-972e-4212-a24a-c4b2f35bb718"],

Cell[TextData[{
 "Keep in mind that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["x", "\[PlusMinus]"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "70983930-b5bd-4fd9-95de-a72ee085d1e3"],
 " are linear combination of computational basis as follows:"
}], "Text",
 CellChangeTimes->{{3.972496848169113*^9, 3.972496857142949*^9}, {
  3.972496922386065*^9, 3.972496959650069*^9}},
 CellID->1288818545,ExpressionUUID->"9cd83ccb-33ad-46c5-9a63-587a5d6425bd"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qb", "=", 
     RowBox[{
      RowBox[{"QuantumBasis", "[", "\"\<X\>\"", "]"}], 
      "[", "\"\<BasisStates\>\"", "]"}]}], "}"}], ",", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{
     RowBox[{"TraditionalForm", "/@", "qb"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"#", "[", "\"\<Computational\>\"", "]"}], "]"}], "&"}], "/@", 
      "qb"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.972496858349299*^9, 3.9724969052064943`*^9}, {
  3.972497002651432*^9, 3.972497019168363*^9}},
 CellLabel->"In[11]:=",
 CellID->1653222173,ExpressionUUID->"eb48b36a-d41a-4d13-92bf-bf90fecc83ab"],

Cell[TextData[{
 "Additionally, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["z", "\[PlusMinus]"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "f202c1a4-6a48-4f29-8be4-61283b1e07ee"],
 "  are the same as the computational basis (only a different notation):"
}], "Text",
 CellChangeTimes->{{3.972496978849222*^9, 3.972496998609208*^9}},
 CellID->2030787088,ExpressionUUID->"8b567a00-eacc-4f8a-9ac0-b56d938d9e64"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qb", "=", 
     RowBox[{
      RowBox[{"QuantumBasis", "[", "\"\<Z\>\"", "]"}], 
      "[", "\"\<BasisStates\>\"", "]"}]}], "}"}], ",", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{
     RowBox[{"TraditionalForm", "/@", "qb"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"#", "[", "\"\<Computational\>\"", "]"}], "]"}], "&"}], "/@", 
      "qb"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.972496973912259*^9, 3.972496975457629*^9}, {
  3.972497023033876*^9, 3.972497025998373*^9}},
 CellLabel->"In[12]:=",
 CellID->1480986245,ExpressionUUID->"a4bb49d9-4bb2-4c31-9ae5-335527d58983"],

Cell["\<\
Also recall the common convention for the computational basis:\
\>", "Text",
 CellChangeTimes->{{3.9724970410226173`*^9, 3.9724970549100122`*^9}, {
  3.972497093056446*^9, 3.972497099682171*^9}, {3.9730016743913097`*^9, 
  3.973001708491428*^9}},
 CellID->2013809867,ExpressionUUID->"edc77299-ecee-4d30-9557-922d772e6c54"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qb", "=", 
     RowBox[{
      RowBox[{"QuantumBasis", "[", "2", "]"}], "[", "\"\<BasisStates\>\"", 
      "]"}]}], "}"}], ",", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{
     RowBox[{"TraditionalForm", "/@", "qb"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"MatrixForm", "[", 
        RowBox[{"#", "[", "\"\<StateVector\>\"", "]"}], "]"}], "&"}], "/@", 
      "qb"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9724970706128263`*^9, 3.9724970841335697`*^9}},
 CellLabel->"In[13]:=",
 CellID->1760157949,ExpressionUUID->"592bd704-5602-4247-81cb-2a650e7e6d3f"],

Cell["\<\
Next, take every pair of Alice\[CloseCurlyQuote]s random bit and basis and \
pass them through Alice\[CloseCurlyQuote]s sending rules. That produces a \
list of nine actual qubit states: some of them are plain zero or one in the Z \
basis, and some are the plus or minus states in the X basis. \
\>", "Text",
 CellChangeTimes->{{3.973001860609932*^9, 3.973001907016045*^9}, 
   3.973002501987924*^9},
 CellID->1741118541,ExpressionUUID->"b3fad13e-ac8d-41ee-8e1e-8ca9cc604d05"],

Cell["\<\
Therefore, given Alice\[CloseCurlyQuote]s bit and bases that are generated \
randomly, she will send Bob these qubits:\
\>", "Text",
 CellChangeTimes->{{3.855415978116468*^9, 3.8554160041581383`*^9}, {
  3.855587913552953*^9, 3.855587915230315*^9}, {3.972497115085392*^9, 
  3.972497116061735*^9}},
 CellID->846263200,ExpressionUUID->"30b0d64f-c070-4934-a794-43d8cc0082eb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"aliceQubits", "=", 
   RowBox[{"aliceProtocol", "/@", 
    RowBox[{"Thread", "[", 
     RowBox[{"List", "[", 
      RowBox[{"aliceBits", ",", "aliceBases"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"#", "[", "\"\<Formula\>\"", "]"}], "&"}], "/@", 
  "aliceQubits"}]}], "Input",
 CellChangeTimes->{{3.855416007414851*^9, 3.8554160458536453`*^9}, {
  3.855416121350917*^9, 3.855416128120607*^9}, {3.85541866962391*^9, 
  3.855418701345318*^9}, {3.85548940359761*^9, 3.855489404773147*^9}},
 CellLabel->"In[14]:=",
 CellID->361408319,ExpressionUUID->"cf2ff75a-7fbb-432b-b67f-d2f01eb15788"],

Cell["\<\
The above sequence of qubits is what Alice will physically send down the \
quantum channel to Bob.\
\>", "Text",
 CellChangeTimes->{{3.9730025054547567`*^9, 3.973002515528708*^9}},
 CellID->130994323,ExpressionUUID->"09f23e63-0666-4354-812e-b3e06ff69bb6"],

Cell["\<\
Now it\[CloseCurlyQuote]s Bob\[CloseCurlyQuote]s turn. Bob doesn\
\[CloseCurlyQuote]t know which basis Alice used for each qubit, so he follows \
the BB84 rule: for every qubit he receives, he randomly chooses a basis of \
his own, again either Z or X.\
\>", "Text",
 CellChangeTimes->{3.973002539095278*^9},
 CellID->828332680,ExpressionUUID->"243937d9-2245-41b3-a92f-a963dfbee8e9"],

Cell["\<\
Bob randomly generate a sequence of either Z-basis or X-basis of measurement:\
\>", "Text",
 CellChangeTimes->{{3.85542869031958*^9, 3.8554287126761503`*^9}, {
  3.855488757233986*^9, 3.855488759388896*^9}},
 CellID->1928010481,ExpressionUUID->"7f2ba206-8580-4cf4-8abe-5c776c7aed2e"],

Cell[BoxData[
 RowBox[{"bobBases", " ", "=", " ", 
  RowBox[{"RandomChoice", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<Z\>\"", ",", "\"\<X\>\""}], "}"}], ",", "9"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.855415926894153*^9, 3.8554159286157722`*^9}, 
   3.855489410628729*^9},
 CellLabel->"In[16]:=",
 CellID->691404584,ExpressionUUID->"698acffb-cc51-4105-88a1-7e0c87536b5d"],

Cell["\<\
It means, Bob applies the measurement operators in above bases on qubits he \
relieved from Alice. Each measurement destroys the original qubit state and \
produces an outcome in the basis Bob chose. To see a specific \
\[OpenCurlyDoubleQuote]run\[CloseCurlyDoubleQuote] of what could happen, we \
will simulate one possible set of outcomes, giving a concrete basis state for \
each qubit, such as the plus or minus state in X, or the plus or minus state \
in Z.\
\>", "Text",
 CellChangeTimes->{{3.855428868469883*^9, 3.855428898167309*^9}, {
  3.972497153965613*^9, 3.972497167875506*^9}, {3.9730025968674498`*^9, 
  3.9730026375817013`*^9}},
 CellID->1484783053,ExpressionUUID->"a0d612d3-6b47-4fb0-8cb9-c13c24655842"],

Cell["Generate measurement objects for Bob:", "Text",
 CellChangeTimes->{{3.855488771898755*^9, 3.8554888173890047`*^9}, {
  3.855488922993178*^9, 3.855488975743203*^9}, {3.9730026518737307`*^9, 
  3.973002660467971*^9}},
 CellID->988793631,ExpressionUUID->"8757e740-6d1b-4a09-9786-88f5fb0366f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bobMeasurements", "=", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#1", "[", "#2", "]"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"QuantumMeasurementOperator", "/@", "bobBases"}], ",", 
       "aliceQubits"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.8554894149306393`*^9, {3.972497211951919*^9, 3.97249721379802*^9}, {
   3.972497878986569*^9, 3.972497880814921*^9}, 3.973002584556292*^9},
 CellLabel->"In[25]:=",
 CellID->1426095731,ExpressionUUID->"f9fc66ae-196d-47e4-b38e-9e97e434d754"],

Cell["\<\
Return one possible realization of Bob' s series of measurements (note some \
will always return the same result, some randomly, depending on what Alice' s \
qubit is and what direction Bob measures):\
\>", "Text",
 CellChangeTimes->{{3.855488977860755*^9, 3.855488996912999*^9}},
 CellID->292383753,ExpressionUUID->"77ca2e80-3536-48f4-9a98-67a94e3a8162"],

Cell[BoxData[
 RowBox[{"bobRealization", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"#", "[", "\"\<SimulatedMeasurement\>\"", "]"}], "&"}], "/@", 
   "bobMeasurements"}]}]], "Input",
 CellChangeTimes->{{3.855428747570434*^9, 3.855428822268446*^9}, {
   3.8554289177539454`*^9, 3.855428967870555*^9}, {3.85548871567859*^9, 
   3.85548872112393*^9}, {3.8554892755773077`*^9, 3.85548928736903*^9}, 
   3.855489517809093*^9, 3.9724972190559187`*^9, 3.972497885838592*^9},
 CellLabel->"In[18]:=",
 CellID->651152335,ExpressionUUID->"ed0fd291-f25d-4370-8175-9f58242addeb"],

Cell["\<\
Once Bob has a list of measurement outcomes, he needs to convert these into \
bits. The convention in this code is simple: whenever he gets the \
\[OpenCurlyDoubleQuote]plus\[CloseCurlyDoubleQuote] outcome in either basis, \
he calls that bit zero; whenever he gets the \[OpenCurlyDoubleQuote]minus\
\[CloseCurlyDoubleQuote] outcome in either basis, he calls that bit one.\
\>", "Text",
 CellChangeTimes->{{3.973002680254818*^9, 3.973002700866798*^9}},
 CellID->2036862872,ExpressionUUID->"e58de6e1-4eef-4974-bc56-120b2913aca9"],

Cell[TextData[{
 "Bob assigns the bit 0 whenever he gets ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["z", "+"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "e56e135b-10d2-4182-a191-3c0c892f9e74"],
 " or ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["x", "+"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "29d1626a-c047-462f-90e2-a126c9ba52be"],
 ", and the bit 1 for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["z", "-"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "870ac609-643e-4fed-ae93-490909a02d2b"],
 " or ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["x", "-"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "9d49a838-5947-4c40-a886-0a94385f7e6f"],
 ". Perform this replacement across the list of measurement outcomes and \
produce Bob\[CloseCurlyQuote]s raw bits:"
}], "Text",
 CellChangeTimes->{{3.8554891437661123`*^9, 3.855489196431576*^9}, {
  3.85548923624426*^9, 3.855489271649727*^9}, {3.855489332069278*^9, 
  3.855489334361363*^9}, {3.9724972394897738`*^9, 3.9724972831541224`*^9}, {
  3.9730027119835157`*^9, 3.973002749745681*^9}},
 CellID->1911599776,ExpressionUUID->"a4b4af84-d77b-4ab1-b723-f605d34e91c1"],

Cell[BoxData[
 RowBox[{"bobBits", "=", 
  RowBox[{"bobRealization", "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       InterpretationBox[
        StyleBox[
         TemplateBox[{
           RowBox[{
             SubscriptBox["\"\[ScriptZ]\"", 
              InterpretationBox["\"+\"", 1]]}]},
          "Ket"],
         FontWeight->"Plain"],
        Wolfram`QuantumFramework`QuditName[
         Subscript["\[ScriptZ]", 
          Interpretation["+", 1]], "Dual" -> False]], "|", 
       InterpretationBox[
        StyleBox[
         TemplateBox[{
           RowBox[{
             SubscriptBox["\"\[ScriptX]\"", 
              InterpretationBox["\"+\"", 1]]}]},
          "Ket"],
         FontWeight->"Plain"],
        Wolfram`QuantumFramework`QuditName[
         Subscript["\[ScriptX]", 
          Interpretation["+", 1]], "Dual" -> False]]}], ":>", "0"}], ",", 
     RowBox[{
      RowBox[{
       InterpretationBox[
        StyleBox[
         TemplateBox[{
           RowBox[{
             SubscriptBox["\"\[ScriptZ]\"", 
              InterpretationBox["\"\[Minus]\"", -1]]}]},
          "Ket"],
         FontWeight->"Plain"],
        Wolfram`QuantumFramework`QuditName[
         Subscript["\[ScriptZ]", 
          Interpretation["\[Minus]", -1]], "Dual" -> False]], "|", 
       InterpretationBox[
        StyleBox[
         TemplateBox[{
           RowBox[{
             SubscriptBox["\"\[ScriptX]\"", 
              InterpretationBox["\"\[Minus]\"", -1]]}]},
          "Ket"],
         FontWeight->"Plain"],
        Wolfram`QuantumFramework`QuditName[
         Subscript["\[ScriptX]", 
          Interpretation["\[Minus]", -1]], "Dual" -> False]]}], ":>", "1"}]}],
     "}"}]}]}]], "Input",
 CellChangeTimes->{{3.855428744571043*^9, 3.855428746037155*^9}, {
  3.855489297079609*^9, 3.855489354493277*^9}, {3.855489420738346*^9, 
  3.855489423302652*^9}, {3.855588377604528*^9, 3.855588389941887*^9}, {
  3.855588430279817*^9, 3.8555884322269897`*^9}, {3.855588520435845*^9, 
  3.855588548297456*^9}, {3.9724972897328*^9, 3.972497311273925*^9}},
 CellLabel->"In[19]:=",
 CellID->1902076112,ExpressionUUID->"977cc632-6c54-4c38-b712-f797a0ff8dcd"],

Cell["\<\
At this stage, Alice has her original sequence of bits and bases; Bob has his \
bits and his bases. Many of Bob\[CloseCurlyQuote]s bits will not match Alice\
\[CloseCurlyQuote]s bits, because sometimes he measured in the \
\[OpenCurlyDoubleQuote]wrong\[CloseCurlyDoubleQuote] basis. That is the core \
of BB84: if Bob chooses a different basis from Alice, his result is \
completely random and carries no reliable information about Alice\
\[CloseCurlyQuote]s bit. \
\>", "Text",
 CellChangeTimes->{
  3.973002777472467*^9, {3.973003090469817*^9, 3.973003105230588*^9}},
 CellID->1702098786,ExpressionUUID->"6c64c7ba-8bd4-4729-9f61-2ba6420dc5bf"],

Cell["\<\
The next step is the classical sifting process. Alice and Bob now talk over a \
normal (but authenticated) classical channel. Importantly, they do not reveal \
their bits. Instead, they reveal only the bases they used for each position. \
For each index from one to nine, they compare Alice\[CloseCurlyQuote]s basis \
and Bob\[CloseCurlyQuote]s basis. If they used the same basis, they keep that \
position; if they used different bases, they discard it. \
\>", "Text",
 CellChangeTimes->{
  3.973002777472467*^9, {3.973003090469817*^9, 3.9730030928333197`*^9}, 
   3.973003163568412*^9},
 CellID->1098670791,ExpressionUUID->"34e7f132-958c-4a91-8be8-d38248f1e927"],

Cell["\<\
Zip together Alice\[CloseCurlyQuote]s bits, Alice\[CloseCurlyQuote]s bases, \
and Bob\[CloseCurlyQuote]s bases into triples, then select only the triples \
where Alice\[CloseCurlyQuote]s basis equals Bob\[CloseCurlyQuote]s basis:\
\>", "Text",
 CellChangeTimes->{
  3.973002777472467*^9, {3.973003090469817*^9, 3.9730030928333197`*^9}, {
   3.9730031737555313`*^9, 3.973003192596443*^9}},
 CellID->314633736,ExpressionUUID->"ab7e9ba1-c5d7-4022-ba3a-376360bd85ed"],

Cell[BoxData[
 RowBox[{"aliceSecretKey", "=", 
  RowBox[{
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"aliceBits", ",", "aliceBases", ",", "bobBases"}], "}"}], 
      "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "==", 
       RowBox[{"#", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "&"}]}], "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"All", ",", "1"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8555880155446568`*^9, 3.85558801824859*^9}, {
  3.85558805462665*^9, 3.8555881327674007`*^9}},
 CellLabel->"In[20]:=",
 CellID->960432225,ExpressionUUID->"0c854c96-b8fa-47ed-9915-cfbe2c34eea1"],

Cell["\<\
Alice extracts her bits from these surviving triples to get her secret key. \
Bob does the same with his bits: he takes his bits from the positions where \
the bases match.\
\>", "Text",
 CellChangeTimes->{
  3.9730031965123863`*^9, {3.973003227540401*^9, 3.973003228682851*^9}},
 CellID->1103239463,ExpressionUUID->"81231c6b-27a7-4bdd-9da4-0301aceb297c"],

Cell[BoxData[
 RowBox[{"bobSecretKey", "=", 
  RowBox[{
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"bobBits", ",", "aliceBases", ",", "bobBases"}], "}"}], "]"}], 
     ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "==", 
       RowBox[{"#", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "&"}]}], "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"All", ",", "1"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.855588141534981*^9, 3.855588146538837*^9}},
 CellLabel->"In[21]:=",
 CellID->1155173915,ExpressionUUID->"edfaa5bd-e75d-4286-9c74-43b0b5fc4a41"],

Cell["\<\
Both resulting lists of bits are identical! Alice and Bob have successfully \
distilled a shorter, but shared, secret key out of the original nine \
transmissions.\
\>", "Text",
 CellChangeTimes->{{3.973003231589121*^9, 3.97300324698986*^9}},
 CellID->1929278776,ExpressionUUID->"c310c16e-f80a-4466-9cdf-61778884aea2"],

Cell[BoxData[
 RowBox[{"bobSecretKey", "==", "aliceSecretKey"}]], "Input",
 CellChangeTimes->{{3.8555902840307703`*^9, 3.855590291135441*^9}},
 CellLabel->"In[22]:=",
 CellID->1502770248,ExpressionUUID->"d3ee36a3-9d4e-4f01-a7ff-1db76579c2f6"],

Cell["\<\
The key that came out is shorter than the number of qubits Alice sent. That\
\[CloseCurlyQuote]s expected. Whenever Bob happened to guess the wrong basis, \
that position got thrown away. In the long run, about half the positions \
survive. If Alice and Bob want a key of a certain length, they just keep \
running this process, Alice sending more qubits, Bob measuring with random \
bases, and both of them doing the public basis comparison and discarding \
mismatches, until the number of agreed positions reaches the desired length. \
This can be implemented as follows.\
\>", "Text",
 CellChangeTimes->{{3.973003273332984*^9, 3.9730033131095877`*^9}},
 CellID->63363286,ExpressionUUID->"6c64885f-1298-4c14-bd2b-045b0655f98b"],

Cell["\<\
This can be implemented as follows. Take the current partial keys for Alice \
and Bob, runs one more \[OpenCurlyDoubleQuote]round\[CloseCurlyDoubleQuote] \
of the protocol for a single qubit (choosing a random bit and basis for \
Alice, generating a qubit, choosing a random basis for Bob, measuring, \
mapping Bob\[CloseCurlyQuote]s outcome to a bit), then checks if the bases \
matched. If they did,  append the new bit to both Alice\[CloseCurlyQuote]s \
and Bob\[CloseCurlyQuote]s keys; if not, leave the keys unchanged. Then, \
using NestWhile, repeatedly call this function, starting from empty keys, \
until Alice\[CloseCurlyQuote]s key reaches a length of five bits.\
\>", "Text",
 CellChangeTimes->{{3.855619851157954*^9, 3.8556200204436827`*^9}, 
   3.97300330754115*^9, {3.97300344054629*^9, 3.973003477804637*^9}, {
   3.97300351654877*^9, 3.9730035274870253`*^9}},
 CellID->1093664874,ExpressionUUID->"430e7331-88c2-4982-9735-89f663d12a6f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BB84SingleRound", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "aliceBit", ",", "aliceBase", ",", "aliceQubit", ",", "bobBase", ",", 
      "bobBit"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"aliceBit", "=", " ", 
      RowBox[{"RandomChoice", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"aliceBase", "=", " ", 
      RowBox[{"RandomChoice", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Z\>\"", ",", "\"\<X\>\""}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"aliceQubit", "=", 
      RowBox[{"aliceProtocol", "[", 
       RowBox[{"{", 
        RowBox[{"aliceBit", ",", "aliceBase"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bobBase", "=", " ", 
      RowBox[{"RandomChoice", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Z\>\"", ",", "\"\<X\>\""}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bobBit", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"QuantumMeasurementOperator", "[", "bobBase", "]"}], "[", 
         "aliceQubit", "]"}], "[", "\"\<SimulatedMeasurement\>\"", "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           InterpretationBox[
            StyleBox[
             TemplateBox[{
               RowBox[{
                 SubscriptBox["\"\[ScriptZ]\"", 
                  InterpretationBox["\"+\"", 1]]}]},
              "Ket"],
             FontWeight->"Plain"],
            Wolfram`QuantumFramework`QuditName[
             Subscript["\[ScriptZ]", 
              Interpretation["+", 1]], "Dual" -> False]], "|", 
           InterpretationBox[
            StyleBox[
             TemplateBox[{
               RowBox[{
                 SubscriptBox["\"\[ScriptX]\"", 
                  InterpretationBox["\"+\"", 1]]}]},
              "Ket"],
             FontWeight->"Plain"],
            Wolfram`QuantumFramework`QuditName[
             Subscript["\[ScriptX]", 
              Interpretation["+", 1]], "Dual" -> False]]}], ":>", "0"}], ",", 
         RowBox[{
          RowBox[{
           InterpretationBox[
            StyleBox[
             TemplateBox[{
               RowBox[{
                 SubscriptBox["\"\[ScriptZ]\"", 
                  InterpretationBox["\"\[Minus]\"", -1]]}]},
              "Ket"],
             FontWeight->"Plain"],
            Wolfram`QuantumFramework`QuditName[
             Subscript["\[ScriptZ]", 
              Interpretation["\[Minus]", -1]], "Dual" -> False]], "|", 
           InterpretationBox[
            StyleBox[
             TemplateBox[{
               RowBox[{
                 SubscriptBox["\"\[ScriptX]\"", 
                  InterpretationBox["\"\[Minus]\"", -1]]}]},
              "Ket"],
             FontWeight->"Plain"],
            Wolfram`QuantumFramework`QuditName[
             Subscript["\[ScriptX]", 
              Interpretation["\[Minus]", -1]], "Dual" -> False]]}], ":>", 
          "1"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"aliceBase", "==", "bobBase"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Append", "[", 
          RowBox[{"x", ",", "aliceBit"}], "]"}], ",", 
         RowBox[{"Append", "[", 
          RowBox[{"y", ",", "bobBit"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.855591230261938*^9, 3.8555912922824593`*^9}, {
   3.855591323509919*^9, 3.855591348522645*^9}, {3.8555916713888807`*^9, 
   3.8555916793072557`*^9}, {3.8555968720578537`*^9, 3.855596872413368*^9}, 
   3.972497575159932*^9, {3.973003377081439*^9, 3.9730033881699333`*^9}, 
   3.973003492920459*^9},
 CellLabel->"In[26]:=",
 CellID->913002645,ExpressionUUID->"c826a935-5ace-41d0-b616-9239d69224b6"],

Cell["\<\
For example, the key length is set as 5 bits in the following:\
\>", "Text",
 CellChangeTimes->{{3.855620026546513*^9, 3.8556200575016613`*^9}},
 CellID->1064796700,ExpressionUUID->"3fc4f9dd-9c41-4feb-872a-db7d91dfb0b3"],

Cell[BoxData[
 RowBox[{"NestWhile", "[", 
  RowBox[{"BB84SingleRound", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "}"}], ",", 
     RowBox[{"{", "}"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"#", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}], "<", "5"}], "&"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.855588708188613*^9, 3.855588715389256*^9}, {
   3.8555905897351933`*^9, 3.855590728846375*^9}, {3.85559076345592*^9, 
   3.855590825717696*^9}, {3.855590917716902*^9, 3.855590938124901*^9}, {
   3.8555909872406607`*^9, 3.855590987466729*^9}, {3.8555910242977133`*^9, 
   3.8555910937061357`*^9}, {3.85559112780651*^9, 3.855591128290409*^9}, {
   3.8555911684289513`*^9, 3.855591192204403*^9}, 3.855591225905837*^9, {
   3.855591277103157*^9, 3.8555912791782093`*^9}, {3.855591464560698*^9, 
   3.855591499333562*^9}, {3.8555915665123796`*^9, 3.8555915714097033`*^9}, {
   3.8555916069188223`*^9, 3.855591643545129*^9}, {3.855594286338173*^9, 
   3.855594287345928*^9}, {3.855594371061227*^9, 3.8555943790966187`*^9}, {
   3.855596849541884*^9, 3.855596856895856*^9}, 3.855596901710609*^9, 
   3.9730034947527*^9},
 CellLabel->"In[27]:=",
 CellID->1056906449,ExpressionUUID->"be04e42d-8c82-44dc-bf9a-96d96e0ae187"],

Cell["\<\
All of this is the \[OpenCurlyDoubleQuote]quantum\[CloseCurlyDoubleQuote] \
front end that you can connect to the one-time pad we discussed about \
earlier. BB84 gives Alice and Bob a shared random key, built in such a way \
that any eavesdropping would disturb the statistics of their measurements and \
be detectable. Once they have that key, they can use it exactly as in the \
one-time pad example: combine it with a message using XOR to encrypt, and \
combine again with the same key to decrypt.\
\>", "Text",
 CellChangeTimes->{{3.9730035471932173`*^9, 3.973003565296399*^9}},
 CellID->1009791976,ExpressionUUID->"f74af766-d418-41e4-b6e3-13a51a0e17f3"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Acknowledgment", "Chapter",
 CellChangeTimes->{{3.9552068592185345`*^9, 3.9552068657504444`*^9}, {
  3.96921806391912*^9, 
  3.969218068566722*^9}},ExpressionUUID->"042d29b4-46fc-4ead-a5fb-\
f1494c903281"],

Cell["\<\
A portion of this book builds on an early draft prepared by John McNally of \
Wolfram Research during his work on this project. Many of the ideas and their \
presentation grew through countless conversations with colleagues at Wolfram \
Research, including Nikolay Murzin, Bruno Tenorio, and Sebastian Rodriguez. I \
would also like to express my gratitude to Stephen Wolfram, founder and CEO \
of Wolfram Research, for his steady support throughout the years I\
\[CloseCurlyQuote]ve led the quantum initiative. Finally, my heartfelt thanks \
go to the late Michael Trott (friend, mentor, and teacher) who, sadly, passed \
away before I completed this draft. He is deeply missed.\
\>", "Text",
 CellChangeTimes->{{3.9692180697990093`*^9, 3.969218127364338*^9}, 
   3.9692181870518208`*^9, {3.973003592843927*^9, 3.973003801173479*^9}, {
   3.9730038344879103`*^9, 
   3.973003876297358*^9}},ExpressionUUID->"317e4c38-4e44-4ed4-bea0-\
c7022ddc1fef"],

Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "this", " ", "is", " ", "the", " ", "code", " ", "to", " ", 
    "automatically", " ", "generate", " ", "the", " ", "TOC"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nb", ",", "cells", ",", "headings", ",", "details", ",", "toc"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nb", "=", 
      RowBox[{"EvaluationNotebook", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cells", "=", 
      RowBox[{"Cells", "[", "nb", "]"}]}], ";", "\n", 
     RowBox[{"headings", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"NotebookRead", "[", "#", "]"}]}], "}"}], "&"}], ",", 
          "cells"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"cell_", ",", 
            RowBox[{"Cell", "[", 
             RowBox[{"title_", ",", "style_String", ",", "___"}], "]"}]}], 
           "}"}], "/;", 
          RowBox[{"MemberQ", "[", 
           RowBox[{
            RowBox[{"{", 
             
             RowBox[{"\"\<Chapter\>\"", ",", "\"\<Section\>\"", 
              ",", "\"\<Subsection\>\""}], "}"}], ",", "style"}], "]"}]}], ":>", 
         RowBox[{"{", 
          RowBox[{"style", ",", "title", ",", "cell"}], "}"}]}]}], "]"}]}], ";",
      "\n", 
     RowBox[{"details", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"style", ",", "title", ",", "cell", ",", "newstyle"}], 
           "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"style", ",", "title", ",", "cell"}], "}"}], "=", "#"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"newstyle", "=", 
            RowBox[{"Switch", "[", 
             RowBox[{
             "style", ",", "\"\<Chapter\>\"", ",", "\"\<ItemNumbered\>\"", 
              ",", "\"\<Section\>\"", ",", "\"\<SubitemNumbered\>\"", 
              ",", "\"\<Subsection\>\"", ",", "\"\<SubsubitemNumbered\>\""}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Cell", "[", 
            RowBox[{"title", 
             RowBox[{"(*", 
              RowBox[{"ButtonBox", "[", 
               RowBox[{"title", ",", 
                RowBox[{"ButtonFunction", ":>", 
                 RowBox[{"SelectionMove", "[", 
                  RowBox[{"cell", ",", "After", ",", "Cell"}], "]"}]}], ",", 
                RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], "*)"}], ",",
              "newstyle"}], "]"}]}]}], "]"}], "&"}], "/@", "headings"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"toc", "=", 
      RowBox[{"CellGroupData", "[", 
       RowBox[{
        RowBox[{"Flatten", "@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cell", "[", 
            RowBox[{"\"\<Table of Contents\>\"", ",", "\"\<Chapter\>\""}], 
            "]"}], ",", "details"}], "}"}]}], ",", "Open"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"NotebookWrite", "[", 
      RowBox[{"nb", ",", "toc"}], "]"}]}]}], "]"}], "*)"}]], "Input",
 CellChangeTimes->{
  3.970423420107484*^9, {3.971797441703868*^9, 3.9717974578659763`*^9}},
 CellLabel->"In[558]:=",
 CellID->1327143649,ExpressionUUID->"219bbe6f-93ee-46ef-b80e-6df6e6060ba7"]
}, Open  ]]
}, Open  ]]
