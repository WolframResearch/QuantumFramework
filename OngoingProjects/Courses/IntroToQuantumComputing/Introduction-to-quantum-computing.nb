   RowBox[{"EulerMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", "\[Lambda]", ",", "\[Phi]"}], "}"}], "]"}], ".",
    "vec"}]}]], "Input",
 CellProlog:>Needs["Wolfram`QuantumFramework`"],
