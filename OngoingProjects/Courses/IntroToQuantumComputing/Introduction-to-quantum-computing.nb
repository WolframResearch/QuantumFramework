  3.971797177108451*^9, 3.971797199497768*^9}},
 CellLabel->"In[256]:=",
 CellID->1972766706,ExpressionUUID->"200a00c3-ac2c-4992-8cf3-f0e200fd9abf"],

Cell["\<\
Visualize the transformed point using Euler rotations and the corresponding \
Bloch vector after U3:\
\>", "Text",
 CellChangeTimes->{{3.9684956434501953`*^9, 
  3.968495680753889*^9}},ExpressionUUID->"04a4a9be-924c-4160-9efc-\
8ec087c99e9b"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<U3\>\"", "[", 
       RowBox[{"\[Lambda]", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], "]"}], "[", 
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<BlochVector\>\"", "[", "vec", "]"}], "]"}], "]"}], 
    "[", "\"\<BlochPlot\>\"", "]"}], ",", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Blue", ",", 
        RowBox[{"PointSize", "[", "Large", "]"}], ",", 
        RowBox[{"Point", "[", "vec", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Green", ",", 
        RowBox[{"PointSize", "[", "Large", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{
          RowBox[{"EulerMatrix", "[", 
           RowBox[{"{", 
            RowBox[{"\[Theta]", ",", "\[Lambda]", ",", "\[Phi]"}], "}"}], 
           "]"}], ".", "vec"}], "]"}]}], "}"}]}], "}"}], "]"}], ",", 
