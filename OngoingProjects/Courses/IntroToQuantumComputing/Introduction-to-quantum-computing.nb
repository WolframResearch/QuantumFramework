Cell[CellGroupData[{

Cell["Multi-Qubit Gates", "Section",
 CellChangeTimes->{{3.968416891303835*^9, 3.968416897541297*^9}, {
  3.969977087351321*^9, 
  3.9699770901395483`*^9}},ExpressionUUID->"aacce2e3-c9f8-4c03-9c1b-\
69dbc8530cb1"],

Cell["\<\
We now focus on multi-qubit gates. These are gates that cannot be written as \
a simple tensor product of single-qubit gates. Among multi-qubit gates, \
conditional (controlled) gates are especially important, because they serve \
as universal entanglers. Practically, you can take any of the single-qubit \
gates discussed before and make a controlled version. You designate a control \
qubit and a target qubit: the gate checks whether the control is in 0 or 1, \
and then, depending on the choice, control-0 (if the control is 0) or \
control-1 (if the control is 1), it applies the chosen gate to the target \
qubit.\
\>", "Text",
 CellChangeTimes->{{3.968501874851885*^9, 
  3.968501926719102*^9}},ExpressionUUID->"ddf7179a-11ad-417a-9892-\
cf6008c3e567"],

Cell[CellGroupData[{

Cell["Family of control NOT", "Subsection",
 CellChangeTimes->{{3.969276425306428*^9, 
  3.9692764398673687`*^9}},ExpressionUUID->"a5083b3d-52ae-4788-8832-\
7524b0cacce7"],

Cell["\<\
CNOT (or CX) flips the target qubit when the control qubit is in the 1 state.\
\>", "Text",
 CellChangeTimes->{{3.9685018419910593`*^9, 3.9685018541616583`*^9}, 
   3.968501938437298*^9},ExpressionUUID->"3e0bb364-f7c2-4708-87f5-\
a9ef9e071066"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", "\"\<CNOT\>\"", "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["2", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["224", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence["WireLabels" -> None, ImageSize -> 100],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellChangeTimes->{{3.9685018279586067`*^9, 3.968501832590905*^9}, 
   3.969276312519524*^9},
 CellLabel->
  "In[262]:=",ExpressionUUID->"0370f8ad-c750-476f-801c-9ee12e529eca"],

Cell["How CNOT transform 2-qubit computational basis:", "Text",
 CellChangeTimes->{{3.968752716749547*^9, 
  3.968752733263032*^9}},ExpressionUUID->"bf57c1d9-b10a-45c6-9431-\
db36792399c6"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"op", "=", 
      RowBox[{"QuantumCircuitOperator", "[", "\"\<CNOT\>\"", "]"}]}], "}"}], ",", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"op", "[", 
        RowBox[{"\"\<Diagram\>\"", ",", 
         RowBox[{"\"\<WireLabels\>\"", "->", "None"}], ",", 
         RowBox[{"ImageSize", "->", "100"}]}], "]"}], ",", "\"\<  \>\"", ",", 
       RowBox[{"TableForm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"TraditionalForm", "[", "#", "]"}], ",", 
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"op", "[", "#", "]"}], "]"}]}], "}"}], "&"}], "/@", 
          RowBox[{
           RowBox[{"QuantumBasis", "[", 
            RowBox[{"2", ",", "2"}], "]"}], "[", "\"\<BasisStates\>\"", 
           "]"}]}], ",", 
         RowBox[{"TableHeadings", "->", 
          RowBox[{"{", 
           RowBox[{"None", ",", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\>\"", 
              ",", "\"\<CNOT\!\(\*TemplateBox[{\"\[Psi]\"},\"Ket\"]\)\>\""}], 
             "}"}]}], "}"}]}]}], "]"}]}], "}"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.968501623464031*^9, {3.968502000039297*^9, 3.9685020284941273`*^9}, {
   3.9685023283535833`*^9, 3.968502331817149*^9}},
 CellLabel->
  "In[263]:=",ExpressionUUID->"2dc841d6-0260-4a6c-8d49-f025793112e1"],

Cell["CNOT is the same as CX:", "Text",
 CellChangeTimes->{{3.968752737314328*^9, 
  3.968752741886299*^9}},ExpressionUUID->"d24687d0-22a7-47c0-9641-\
e72ef63b5115"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumOperator", "[", "\"\<CNOT\>\"", "]"}], "==", 
  RowBox[{"QuantumOperator", "[", "\"\<CX\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.968502046901334*^9, 3.9685020517233047`*^9}},
 CellLabel->
  "In[264]:=",ExpressionUUID->"7d7e1d45-b903-4f9a-b351-df9ea4b7a996"],

Cell["Show the matrix form of CNOT gate:", "Text",
 CellChangeTimes->{{3.9687527437439213`*^9, 
  3.968752749790186*^9}},ExpressionUUID->"73f90572-6f83-45cd-98f9-\
453f7f16b34b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", "\"\<CNOT\>\"", "]"}], 
   "[", "\"\<Matrix\>\"", "]"}], "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.968502054211216*^9, 3.968502057530177*^9}},
 CellLabel->
  "In[265]:=",ExpressionUUID->"79c42edd-94cc-41ea-97ef-51266025ab74"],

Cell["\<\
As mentioned earlier, CNOT is one of the most important multi-qubit gates for \
generating entangled states. Example: prepare two qubits in a product state \
by putting qubit 1 into a uniform superposition with a Hadamard gate and \
leaving qubit 2 in the 0 state.\
\>", "Text",
 CellChangeTimes->{{3.9687527599481297`*^9, 
  3.968752862518939*^9}},ExpressionUUID->"18923ed2-ded7-4eca-a5df-\
9c01d64e5e10"],

Cell[BoxData[
 RowBox[{"\[Psi]", "=", 
  RowBox[{
   RowBox[{"QuantumOperator", "[", "\"\<H\>\"", "]"}], "[", 
   RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.968502077577696*^9, 3.968502086270566*^9}, {
