Cell[TextData[{
 "Now let\[CloseCurlyQuote]s examine how the BV oracle acts on the current \
quantum state. As discussed earlier, through the phase kickback effect, the \
oracle introduces a phase shift to specific terms determined by the secret \
string. For clarity, let\[CloseCurlyQuote]s recall the secret string: {1, 0, \
1}. In this case, the oracle imprints a phase of -1 according to the \
function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "s"], "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "c23c8eaf-a6a7-4a5c-8ff9-14310cbb4ceb"],
 ", while the answer qubit remains unchanged."
}], "Text",
 CellChangeTimes->{{3.968769753211266*^9, 3.968769798359578*^9}, {
  3.968769882980597*^9, 3.968769945040504*^9}, {3.968770064586687*^9, 
  3.968770079266889*^9}, {3.968770183395129*^9, 
  3.968770216366377*^9}},ExpressionUUID->"6ee6be9e-042b-48ba-af5d-\
a019e9fe06fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{"\"\<BernsteinVaziraniOracle\>\"", "[", "secret", "]"}], "]"}], 
     "[", "\[Psi]1", "]"}], ",", 
    RowBox[{"QuantumBasis", "[", 
     RowBox[{"\"\<X\>\"", ",", 
      RowBox[{
       RowBox[{"Length", "[", "secret", "]"}], "+", "1"}]}], "]"}]}], "]"}], "//",
   "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.968767886024632*^9, 3.9687679150076447`*^9}, {
  3.9687687423943157`*^9, 3.9687687435228863`*^9}},
 CellLabel->
  "In[357]:=",ExpressionUUID->"c58ef6b0-f6c4-4b26-9688-842222d68ba2"],

