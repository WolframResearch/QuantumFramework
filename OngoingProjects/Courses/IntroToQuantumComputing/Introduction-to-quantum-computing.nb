            "]"}], ",", 
           RowBox[{"mea", "[", 
            RowBox[{"\"\<ProbabilitiesPlot\>\"", ",", 
             RowBox[{"AspectRatio", "->", 
              RowBox[{"1", "/", "3"}]}], ",", 
             RowBox[{"ImageSize", "->", "Small"}], ",", 
             RowBox[{"\"\<LabelsAngle\>\"", "->", 
              RowBox[{"90", "Degree"}]}]}], "]"}], ",", 
           RowBox[{"Chop", "/@", 
            RowBox[{
             RowBox[{"mea", "[", "\"\<Probabilities\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{";;", "1"}], "]"}], "]"}]}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"bf", ",", 
         RowBox[{"threeVariableBooleans", "[", "\"\<Constant\>\"", "]"}]}], 
        "}"}]}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
      RowBox[{"{", 
       RowBox[{"\"\<Constant Boolean function\>\"", 
        ",", "\"\<Probability plot\>\"", 
        ",", "\"\<Probability of \!\(\*Cell[TextData[Cell[BoxData[
TemplateBox[{
RowBox[{
SubscriptBox[\"x\", \"+\"], 
SubscriptBox[\"x\", \"+\"], 
SubscriptBox[\"x\", \
\"+\"]}]},\"Ket\"]],ExpressionUUID->\"7fd771e5-485d-4f11-9aba-2028befb48ae\"]]\
,ExpressionUUID->\"cd414828-419d-43e3-939f-301fd060e1ea\"]\)\>\""}], 
       "}"}]}]}], "]"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"Left", ",", "Center"}], "}"}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.969281521385152*^9, 3.969281542356379*^9}, {
  3.96928161089782*^9, 3.969281612647023*^9}},
 CellLabel->
  "In[339]:=",ExpressionUUID->"1637cfda-421a-4b9d-a048-d088b5195678"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bernstein-Vazirani Algorithm", "Chapter",
 CellChangeTimes->{{3.9445760573132553`*^9, 3.9445760689615955`*^9}, {
  3.944667039184496*^9, 
  3.944667042800411*^9}},ExpressionUUID->"d41d76b9-6047-48b2-9a8a-\
5a202ebbff4d"],

Cell["\<\
We will discuss Bernstein-Vazirani algorithm. Bernstein\[Dash]Vazirani finds \
a hidden n-bit string using one oracle call instead of n. Prepare the n input \
qubits in equal superposition and the extra \[OpenCurlyDoubleQuote]answer\
\[CloseCurlyDoubleQuote] qubit in a state that turns flips into phases. Query \
the bit oracle once; its action doesn\[CloseCurlyQuote]t store information in \
the answer qubit but kicks back a phase pattern onto the inputs that encodes \
the hidden string. Apply Hadamards to convert that phase pattern into a \
single basis state corresponding to the hidden string. Measure the inputs and \
read the string with certainty. The speedup comes from superposition, phase \
kickback, and interference, reducing queries from n to one.\
\>", "Text",
 CellChangeTimes->{{3.968753761973868*^9, 3.968753763041209*^9}, {
  3.968768140074353*^9, 3.96876814447363*^9}, {3.968768231560348*^9, 
  3.968768248109923*^9}},ExpressionUUID->"2de61441-f9f0-4339-b565-\
2a8a9f3f4de9"],

Cell[CellGroupData[{

Cell["Key Concepts", "Section",
 CellChangeTimes->{{3.944497868437477*^9, 
  3.944497870796896*^9}},ExpressionUUID->"93654eb9-62eb-455e-a54c-\
cfb08bb59b18"],

Cell["Oracle function", "Item",
 CellChangeTimes->{{3.944508177626053*^9, 
  3.944508183173065*^9}},ExpressionUUID->"6786f13b-002b-4c92-8453-\
2da558246f5b"],

Cell["Bernstein-Vazirani (BV) Algorithm", "Item",
 CellChangeTimes->{{3.944508177626053*^9, 3.944508180634098*^9}, {
   3.944508219361307*^9, 3.9445082314652767`*^9}, 3.9687681760854588`*^9, {
   3.968770823994581*^9, 
   3.968770825266705*^9}},ExpressionUUID->"c1ad30d0-1743-4fe9-8fb8-\
a4f273b9e83e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Statement of the Bernstein-Vazirani Problem", "Section",
 CellChangeTimes->{{3.944508432191864*^9, 3.9445084422011356`*^9}, {
   3.944517955412842*^9, 3.9445179596145287`*^9}, 
   3.9445181248445587`*^9},ExpressionUUID->"659d7d12-9869-4d57-adcb-\
0c5fc009a32c"],

Cell[TextData[{
 "In many computer science problems, it is common to assume there is some \
kind of ",
 StyleBox["oracle function",
  FontWeight->"Bold"],
 " that is used in order to compute partial results for use in the rest of an \
algorithm. In practice, the oracle could be a database query or some similar \
operation. "
}], "Text",
 CellChangeTimes->{{3.9445179738371143`*^9, 3.9445180168947735`*^9}, {
  3.9445180797418633`*^9, 3.9445181445412617`*^9}, {3.944518211204897*^9, 
  3.9445182654037266`*^9}, {3.944527196634075*^9, 3.944527236515232*^9}, {
  3.9445272717238045`*^9, 3.9445272770622654`*^9}, {3.9687614797787037`*^9, 
  3.968761483523835*^9}},ExpressionUUID->"988528fc-25d5-40d6-b7d3-\
0dcc5b0784d7"],

Cell[TextData[{
 "The Bernstein-Vazirani algorithm is a quantum algorithm for a \
specific \[OpenCurlyDoubleQuote]oracle problem.\[CloseCurlyDoubleQuote] We \
are given a black-box oracle (a function) that returns the dot product \
(modulo 2) of an unknown binary string ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "ccdbbb19-5e51-4756-924d-52189c647c6a"],
 " with an input binary string ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "4cfff9c9-241d-41dc-810f-b4845ebc839b"],
 ". The goal is to determine the unknown string ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "a3c62a11-c898-4155-99a4-d1a16dfe11f3"],
 ". The classical oracle function can be implemented in a straightforward way:"
}], "Text",
 CellChangeTimes->{{3.968761460161345*^9, 3.968761522028022*^9}, {
   3.9687615594182663`*^9, 3.968761583459609*^9}, 
   3.9693040157950563`*^9},ExpressionUUID->"84b509e8-c99f-4ff4-8b8a-\
75c3d5a1b5f8"],

Cell[TextData[{
 "You may try several methods, but finding the secret string of length ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "858f5b26-8906-4cfb-9aa7-e7f40ab8728e"],
 " requires at least ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "97502fd3-2e3d-41d7-a8c8-0c63bd7abd46"],
 " queries to a classical oracle. A simple strategy is to query the oracle on \
each input that has exactly one 1 and the rest 0. One query to the oracle on \
input ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", "i"], TraditionalForm]],ExpressionUUID->
  "fa82689a-f421-49aa-8eb9-aea6b7b31eec"],
 " (the unit vector with a single 1 in position ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "9e8a7556-2490-416c-8586-ee63e0ba80d5"],
 ") returns ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "i"], TraditionalForm]],ExpressionUUID->
  "ba93f882-bc42-44a6-8ab5-7dc8fb434633"],
 ". To learn all ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "8c3755b6-f57d-4c09-8e77-9cc1e0c8a1c8"],
 " bits, any deterministic, classical algorithm needs ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "722d26ea-0873-49d4-9108-6d10a154db93"],
 " queries in the worst case. Each query returns only one bit, namely the dot \
product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"s", "\[CenterDot]", "x"}], " ", 
    RowBox[{"(", 
     RowBox[{"mod", " ", "2"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "8fa04444-4d9d-423b-a05f-e9786caa920e"],
 " , so you cannot learn more than one independent bit of ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "4577e713-1f52-498b-9247-921c5deaaf05"],
 " per query."
}], "Text",
 CellChangeTimes->{{3.9687619196998167`*^9, 3.968761982639112*^9}, {
  3.9693040317145567`*^9, 3.969304035342825*^9}, {3.969304210260708*^9, 
  3.969304210659539*^9}},ExpressionUUID->"7497e7ab-9907-4caf-a297-\
feb53ef7df16"],

Cell["Let\[CloseCurlyQuote]s consider a secret sequence of 0 and 1:", "Text",
 CellChangeTimes->{{3.9687618939780607`*^9, 3.968761904893346*^9}, {
  3.968768707069278*^9, 
  3.9687687079186583`*^9}},ExpressionUUID->"9ef16ec3-78f5-4d2a-875a-\
59b1cf71383e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"secret", "=", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"List", "ListIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["List", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["3", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["112", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    {1, 0, 1},
    SelectWithContents->True,
    Selectable->False]}], ";"}]], "Input",
 CellChangeTimes->{{3.968761809890524*^9, 3.968761821113159*^9}, 
   3.9687618905075397`*^9, {3.968768696298842*^9, 3.968768705582738*^9}, {
   3.969303336482123*^9, 3.969303341301193*^9}, {3.96930432739421*^9, 
   3.969304331171406*^9}},
 CellLabel->
  "In[342]:=",ExpressionUUID->"aee41cfa-6ed4-495d-ac34-091fd552bb0f"],

Cell[TextData[{
 "Calculate  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"s", "\[CenterDot]", 
     SubscriptBox["e", "i"]}], " ", 
    RowBox[{"(", 
     RowBox[{"mod", " ", "2"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "92ec57ee-f9f0-4f50-940e-cd09cbf29dcd"],
 " for all unit vectors (3 queries):"
}], "Text",
 CellChangeTimes->{{3.969304235260952*^9, 3.969304263020199*^9}, {
  3.969304308028623*^9, 3.969304308781377*^9}, {3.969304347695486*^9, 
  3.9693043498684053`*^9}},ExpressionUUID->"2d83e01e-6336-4cae-85cf-\
8f366d73b2d3"],

Cell[BoxData[
 RowBox[{"result", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Mod", "[", 
     RowBox[{
      RowBox[{"secret", ".", "#"}], ",", "2"}], "]"}], "&"}], "/@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"UnitVector", "[", 
      RowBox[{
       RowBox[{"Length", "[", "secret", "]"}], ",", "j"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"Length", "[", "secret", "]"}]}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.969304157149564*^9, 3.969304188704112*^9}, {
  3.969304284185185*^9, 3.969304322990597*^9}, {3.969304364518536*^9, 
  3.969304366281035*^9}},
 CellLabel->
  "In[343]:=",ExpressionUUID->"d7677d2c-da3f-48ca-976a-688c7e602697"],

Cell["Check that the result is the same as the secret code:", "Text",
 CellChangeTimes->{{3.968762044074134*^9, 
  3.968762052708506*^9}},ExpressionUUID->"ad46372d-baef-4ecf-a694-\
3948565c9394"],

Cell[BoxData[
 RowBox[{"result", "==", "secret"}]], "Input",
 CellChangeTimes->{{3.94452687052676*^9, 3.944526890981226*^9}, 
   3.968762041800261*^9},
 CellLabel->
  "In[344]:=",ExpressionUUID->"ad703505-cc7f-4132-a227-318545093031"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Quantum Bernstein-Vazirani Algorithm", "Section",
 CellChangeTimes->{{3.9445270348915176`*^9, 
  3.944527052838402*^9}},ExpressionUUID->"03579da5-bbb8-472b-bd84-\
12f819c0e4f9"],

Cell[TextData[{
 "In the quantum version of the algorithm, the oracle will also depend on the \
secret sequence. This is no different from the classical oracle. But the BV \
algorithm needs 1 query to the oracle and recovers all ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "241c427b-b470-4bcd-9d5a-fc8980b5d932"],
 " bits with certainty."
}], "Text",
 CellChangeTimes->{{3.944527086677225*^9, 3.944527138572214*^9}, {
  3.968762108744814*^9, 
  3.9687621400060596`*^9}},ExpressionUUID->"fcb3790b-defb-4ef0-ac21-\
6d66ef6c97cc"],

Cell[TextData[{
 "In order to create the quantum BV oracle for secret sequence of length ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "f2e5a110-626d-44e2-9984-bddeaca52d72"],
 ", you will need ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "0a575896-658a-4be9-b434-9add594b7e40"],
 " qubits. The last qubit, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "3a09d15c-73e2-4096-a938-9015a1fd8bd0"],
 "-th one, is usually called as the answer qubit. For each 1 in the secret \
sequence, the oracle applies a CNOT gate with control qubit corresponding to \
that one\[CloseCurlyQuote]s place in the secret sequence and target qubit \
corresponding to the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "3e9aae62-2b4d-4b53-a27e-334ef318214b"],
 " qubit."
}], "Text",
 CellChangeTimes->{{3.944527301148287*^9, 3.944527326077116*^9}, {
  3.944527407795986*^9, 3.9445275599415855`*^9}, {3.9446671743210297`*^9, 
  3.9446672307609463`*^9}, {3.9687655105780077`*^9, 
  3.968765544307229*^9}},ExpressionUUID->"c65c059f-92ca-4c09-92ed-\
8ff22c4884aa"],

Cell["Recall the secret sequence from before:", "Text",
 CellChangeTimes->{{3.9445275661949654`*^9, 
  3.9445275753148174`*^9}},ExpressionUUID->"116d691b-5f2a-49f9-ab49-\
c021dccaa815"],

Cell[BoxData["secret"], "Input",
 CellChangeTimes->{{3.944527577280609*^9, 3.9445275791304207`*^9}},
 CellLabel->
  "In[345]:=",ExpressionUUID->"86b8f2b8-d804-497d-8ef9-4be1de73681f"],

Cell["The quantum BV oracle for this sequence is given by:", "Text",
 CellChangeTimes->{{3.94452758320265*^9, 3.944527589564436*^9}, {
  3.944527698554735*^9, 
  3.944527703107319*^9}},ExpressionUUID->"ca959f68-a068-423c-bbd9-\
182a013451aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<BernsteinVaziraniOracle\>\"", "[", "secret", "]"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "->", "100"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.944527592885317*^9, 3.9445276906434746`*^9}, {
  3.969303352501957*^9, 3.969303352769457*^9}},
 CellLabel->
  "In[346]:=",ExpressionUUID->"9e8cdd6b-8489-4047-9b95-b1fc9f67bc39"],

Cell[TextData[{
 "So let\[CloseCurlyQuote]s remind ourself: the first n-qubits are called \
register or input or query qubits. The last one (",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "422b0ce1-d4dd-4cc2-95d4-e272a2d54e5d"],
 "-th qubit) is commonly called the answer or target qubit."
}], "Text",
 CellChangeTimes->{{3.9687671816476727`*^9, 3.968767189175564*^9}, {
  3.968767224562858*^9, 3.968767267459516*^9}, {3.969304823538694*^9, 
  3.9693048274030867`*^9}},ExpressionUUID->"cef4476f-acdf-4f50-bbea-\
7798aea319d1"],

Cell[TextData[{
 "The (standard) BV oracle acts as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     TemplateBox[{"x"},
      "Ket"], 
     TemplateBox[{"b"},
      "Ket"]}], "->", 
    RowBox[{
     TemplateBox[{"x"},
      "Ket"], 
     TemplateBox[{
       RowBox[{"b", "\[CirclePlus]", 
         RowBox[{"(", 
           RowBox[{
             RowBox[{"s", ".", "x"}], " ", "mod", " ", "2"}], ")"}]}]},
      "Ket"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1609b1d5-4e92-4e1c-80ca-00d28c8cd150"],
 ". Let\[CloseCurlyQuote]s calculate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"s", ".", "x"}], " ", "mod", " ", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8dd68812-87b9-4ba6-8b1e-f788b9c23303"],
 " for all elements of the computational basis:"
}], "Text",
 CellChangeTimes->{{3.969304925437615*^9, 
  3.969305029486178*^9}},ExpressionUUID->"773fbd45-e7a4-4bd8-82c0-\
1e070d78d7e6"],

Cell[BoxData[
 RowBox[{"AssociationMap", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Mod", "[", 
     RowBox[{
      RowBox[{"#", ".", "secret"}], ",", "2"}], "]"}], "&"}], ",", 
   RowBox[{"Tuples", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", "3"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9693048738213577`*^9, 3.9693048946892633`*^9}},
 CellLabel->
  "In[347]:=",ExpressionUUID->"f3516e89-6967-48eb-9ea9-f889ce589508"],

Cell[TextData[{
 "If we load the target qubit into the minus state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"-"},
    "Ket"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3430f143-705b-468d-9f6a-88d4b5fcf6dc"],
 ", then toggling it (",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "->", 
    RowBox[{"b", "\[CirclePlus]", 
     RowBox[{"f", "(", "x", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cebbefaa-9d63-4f7d-b14f-926856dfdee4"],
 " kicks back a phase: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"-"},
     "Ket"], "->", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"f", "(", "x", ")"}]], 
     TemplateBox[{"-"},
      "Ket"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "140543fe-f667-49b1-83fa-da508c4b9d34"]
}], "Text",
 CellChangeTimes->{{3.968752716749547*^9, 3.968752733263032*^9}, {
   3.968765408531855*^9, 3.968765499470747*^9}, 3.9693045068060904`*^9, {
   3.969304610971509*^9, 3.9693046114729233`*^9}, {3.9693050572925787`*^9, 
   3.969305145369659*^9}},ExpressionUUID->"1c64e505-49cf-428e-9eb4-\
3547e2a20bb1"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"op", "=", 
       RowBox[{"QuantumCircuitOperator", "[", 
        RowBox[{"\"\<BernsteinVaziraniOracle\>\"", "[", "secret", "]"}], 
        "]"}]}], ",", 
      RowBox[{"states", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"QuantumTensorProduct", "[", 
          RowBox[{"#", ",", 
           RowBox[{"QuantumState", "[", "\"\<-\>\"", "]"}]}], "]"}], "&"}], "/@", 
        RowBox[{
         RowBox[{"QuantumBasis", "[", 
          RowBox[{"2", ",", "3"}], "]"}], "[", "\"\<BasisStates\>\"", 
         "]"}]}]}]}], "}"}], ",", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"op", "[", 
        RowBox[{"\"\<Diagram\>\"", ",", 
         RowBox[{"\"\<WireLabels\>\"", "->", "None"}], ",", 
         RowBox[{"ImageSize", "->", "140"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<BV oracle\>\""}]}], "]"}], 
       ",", "\"\<  \>\"", ",", 
       RowBox[{"TableForm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"QuantumState", "[", 
               RowBox[{"#", ",", 
                RowBox[{"{", 
                 RowBox[{"2", ",", "2", ",", "2", ",", "\"\<X\>\""}], "}"}]}],
                "]"}], "]"}], ",", 
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"QuantumState", "[", 
               RowBox[{
                RowBox[{"op", "[", "#", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"2", ",", "2", ",", "2", ",", "\"\<X\>\""}], "}"}]}],
                "]"}], "]"}]}], "}"}], "&"}], "/@", "states"}], ",", 
         RowBox[{"TableHeadings", "->", 
          RowBox[{"{", 
           RowBox[{"None", ",", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<\!\(\*TemplateBox[{\"x\"},\"Ket\"]\)\!\(\*\
TemplateBox[{\"-\"},\"Ket\"]\)\>\"", 
              ",", "\"\<BV\!\(\*TemplateBox[{\"x\"},\"Ket\"]\)\!\(\*\
TemplateBox[{\"-\"},\"Ket\"]\)\>\""}], "}"}]}], "}"}]}], ",", 
         RowBox[{"TableDepth", "->", "2"}]}], "]"}]}], "}"}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.968501623464031*^9, {3.968502000039297*^9, 3.9685020284941273`*^9}, {
   3.9685023283535833`*^9, 3.968502331817149*^9}, {3.968762289868658*^9, 
   3.968762301226012*^9}, {3.968764801316526*^9, 3.968764801536784*^9}, {
   3.9687652720337353`*^9, 3.968765371957715*^9}, 3.9687708471166077`*^9, {
   3.9687709136055317`*^9, 3.968770926505014*^9}, {3.969303641465576*^9, 
   3.969303707966734*^9}, {3.9693045127067966`*^9, 3.969304527879777*^9}, {
   3.969304558383896*^9, 3.969304581707333*^9}, {3.969304616106154*^9, 
   3.969304728946341*^9}},
 CellLabel->
  "In[348]:=",ExpressionUUID->"421d1b42-a8d2-4bb6-bbc0-ebcb8ed2afd8"],

Cell["\<\
In order to use this oracle to discover the secret code, only one query is \
necessary. Using the phenomenon of phase kickback, it is possible to send a \
uniform superposition of all possible sequences (as measured in the \
computational basis) and encode the solution in the three control qubits.\
\>", "Text",
 CellChangeTimes->{{3.944527843466154*^9, 3.944527867724104*^9}, {
  3.944527930714279*^9, 3.9445281033953056`*^9}, {3.9446672944405785`*^9, 
  3.944667296137375*^9}},ExpressionUUID->"3f1c6218-3f9f-495a-b0e3-\
5bd6d881c502"],

Cell["The full circuit would look like this:", "Text",
 CellChangeTimes->{{3.944528126993908*^9, 
  3.9445281397542343`*^9}},ExpressionUUID->"bc8340d3-c0dd-44a9-b001-\
320677805877"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bv", "=", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<BernsteinVazirani\>\"", "[", "secret", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"bv", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.9445281567650948`*^9, 3.9445281772905655`*^9}, {
  3.968767631729246*^9, 3.9687676402808733`*^9}},
 CellLabel->
  "In[349]:=",ExpressionUUID->"458cfd01-6827-4deb-aad6-14676c34aaa3"],

Cell[TextData[{
 "Phase kickback is the mechanism by which a conditional action on a target \
(when the target sits in an eigenstate) becomes a conditional phase on the \
control. In BV, CNOTs into an answer qubit prepared as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"-"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "6d87e522-3b51-4213-9089-9fcb5b346aa1"],
 " kick back the parity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", "x", ")"}]}], "=", "s\:22c5x"}], TraditionalForm]],
  ExpressionUUID->"27975724-e364-45d3-ad65-aebe2beed6fa"],
 " as a phase ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{"f", "(", "x", ")"}]], TraditionalForm]],ExpressionUUID->
  "8fb7c538-2c73-4812-916f-27d52e550d03"],
 " on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"x"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "e1a9be02-b9e1-4424-bf76-569aff5bdad4"],
 ". Two Hadamard layers then turn that phase pattern into the deterministic \
answer ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"s"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "4c95b1b3-6247-4593-9e3d-423255a30b4a"],
 "."
}], "Text",
 CellChangeTimes->{{3.968767439653358*^9, 
  3.968767498413856*^9}},ExpressionUUID->"68273ec5-e4b0-44a4-ba70-\
5b74b0032509"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s monitor the state evolution in the BV circuit. \
Before the oracle, the n-qubits are in a uniform superposition, and the \
answer qubit is in the minus state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["x", "-"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "f432aa03-fc84-4d27-a553-5fff797475ac"],
 "."
}], "Text",
 CellChangeTimes->{{3.96876828559202*^9, 3.968768286039731*^9}, {
  3.968768900904367*^9, 3.9687689561397457`*^9}, {3.968768988302505*^9, 
  3.9687689974954157`*^9}, {3.9687710278067217`*^9, 
  3.968771029825163*^9}},ExpressionUUID->"93f7e305-e4db-4a67-81c6-\
1d35a6b6de8b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"step1", "=", 
   RowBox[{"bv", "[", 
    RowBox[{"[", 
     RowBox[{";;", 
      RowBox[{
       RowBox[{"Length", "[", "secret", "]"}], "+", "2"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"step1", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "->", "100"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.968767526134726*^9, 3.968767579007666*^9}, {
  3.968767645875592*^9, 3.968767694274044*^9}, {3.968767741657213*^9, 
  3.968767746633978*^9}, {3.96876836703196*^9, 3.9687684041823378`*^9}, {
  3.9687694703030863`*^9, 3.9687694797878*^9}, {3.968770354631802*^9, 
  3.968770361230397*^9}, {3.968770961381372*^9, 3.9687709780990953`*^9}},
 CellLabel->
  "In[351]:=",ExpressionUUID->"d43c0bcb-b9a6-4fcf-8591-4f35a17d2114"],

Cell["Execute the above circuit and get the result:", "Text",
 CellChangeTimes->{{3.968770981207376*^9, 
  3.968771000689033*^9}},ExpressionUUID->"7ae85a43-49da-45ec-a48b-\
454f9df7eb71"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Psi]1", "=", 
   RowBox[{"step1", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"\[Psi]1", ",", 
    RowBox[{"QuantumBasis", "[", 
     RowBox[{"\"\<X\>\"", ",", 
      RowBox[{
       RowBox[{"Length", "[", "secret", "]"}], "+", "1"}]}], "]"}]}], "]"}], "//",
   "TraditionalForm"}]}], "Input",
 CellChangeTimes->{{3.968767526134726*^9, 3.968767579007666*^9}, {
   3.968767645875592*^9, 3.968767694274044*^9}, {3.968767741657213*^9, 
   3.968767746633978*^9}, {3.96876836703196*^9, 3.9687684041823378`*^9}, {
   3.9687694703030863`*^9, 3.9687694797878*^9}, {3.968770354631802*^9, 
   3.968770361230397*^9}, 3.968770961381372*^9},
 CellLabel->
  "In[353]:=",ExpressionUUID->"a992e46a-9cf3-4f21-8ab3-e2a820abc80c"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s dive into the above code. First, we execute part of \
BV circuit which prepares an initial state. The resulting state is in the \
computational basis. Then we transform the state into the Pauli-X basis of \
the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "5f077b05-ec61-4879-a707-1592c5d26ffe"],
 " basis. This is a very useful feature in the Wolfram Quantum Framework. You \
can do the basis transformation as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"QuantumState", "[", 
    RowBox[{"\[Psi]", ",", 
     RowBox[{"QuantumBasis", "[", "...", "]"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"a5d2081b-37b4-4c3f-895d-003f569ece0f"],
 " which transforms the state ",
 Cell[BoxData[
  FormBox["\[Psi]", TraditionalForm]],ExpressionUUID->
  "7e4ea10c-0baa-49d1-be9a-e33d5da1d6ea"],
 " into the new basis. Let\[CloseCurlyQuote]s look at the state before and \
after the basis transformation:"
}], "Text",
 CellChangeTimes->{{3.968769002063652*^9, 3.968769052500527*^9}, {
   3.968769096574842*^9, 3.968769135607562*^9}, {3.968769358202466*^9, 
   3.968769441803172*^9}, {3.9687695776268377`*^9, 3.968769657327524*^9}, {
   3.968771005891921*^9, 3.968771014307678*^9}, 
   3.97179726681916*^9},ExpressionUUID->"dfa9cc84-cd0e-4689-bbad-\
9a149692fdce"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"TraditionalForm", "[", "\[Psi]1", "]"}], ",", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<\[LongRightArrow]\>\"", ",", 
      RowBox[{"Directive", "[", 
       RowBox[{"Bold", ",", "Red"}], "]"}]}], "]"}], ",", 
    RowBox[{"TraditionalForm", "[", 
     RowBox[{"QuantumState", "[", 
      RowBox[{"\[Psi]1", ",", 
       RowBox[{"QuantumBasis", "[", 
        RowBox[{"\"\<X\>\"", ",", 
         RowBox[{
          RowBox[{"Length", "[", "secret", "]"}], "+", "1"}]}], "]"}]}], 
      "]"}], "]"}]}], "}"}], "]"}]], "Input",
 CellChangeTimes->{{3.968769453512251*^9, 3.968769454632613*^9}, {
  3.9687694998132257`*^9, 3.96876952769808*^9}, {3.968771046215044*^9, 
  3.9687711131562443`*^9}},
 CellLabel->
  "In[355]:=",ExpressionUUID->"e3939ddf-39a8-49e2-ae7b-b669833f24c7"],

Cell["\<\
It is clear that, in the new basis, the state is represented more compactly, \
and the idea of a uniform superposition with the answer qubit in the minus \
state is made explicit.\
\>", "Text",
 CellChangeTimes->{{3.9687696698257227`*^9, 
  3.968769731255372*^9}},ExpressionUUID->"ecd9c896-312f-4fd6-8559-\
8c9f7e06e8ed"],

