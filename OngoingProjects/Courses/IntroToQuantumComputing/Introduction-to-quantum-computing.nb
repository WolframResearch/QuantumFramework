Cell[TextData[{
 "Phase-shift operator is a phase operator with an angle ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"2", 
    RowBox[{"\[Pi]", "/", 
     SuperscriptBox["2", "n"]}]}], "=", 
   RowBox[{"\[Pi]", "/", 
    SuperscriptBox["2", 
     RowBox[{"n", "-", "1"}]]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d2137724-7308-4357-9f00-00d74040e0a3"],
 ":"
}], "Text",
 CellChangeTimes->{{3.968427993186591*^9, 3.9684280070119743`*^9}, {
  3.9684314270745792`*^9, 3.968431430496982*^9}},
 CellID->30987997,ExpressionUUID->"4a760281-74d2-4a3c-a061-efb1157e30ac"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<PhaseShift\>\"", "[", "n", "]"}], "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
