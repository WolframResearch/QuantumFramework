         RowBox[{"Placed", "[", 
          RowBox[{"\"\<\!\(\*Cell[TextData[Cell[BoxData[
TemplateBox[{\"0\"},\"Ket\"]],ExpressionUUID->\"902e76d9-7fac-4c39-9433-\
a2a061432fd9\"]],ExpressionUUID->\"51637deb-c29e-43a1-9ed1-025053271d3e\"]\)\>\
\"", ",", "Left"}], "]"}], ",", 
