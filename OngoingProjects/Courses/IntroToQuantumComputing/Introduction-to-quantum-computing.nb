     RowBox[{"{", 
      RowBox[{
      "\[Alpha]", ",", "0", 
       ",", "\"\<\[Alpha] in \!\(\*SubscriptBox[\(R\), \
\(Z\)]\)[\[Alpha]]\>\""}], "}"}], ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}], ",", 
     RowBox[{"AppearanceElements", "->", "All"}]}], "}"}], ",", 
   RowBox[{"SaveDefinitions", ":>", "True"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9684274095901613`*^9, 3.9684274841191683`*^9}, {
  3.968431744819962*^9, 3.968431744973823*^9}, {3.968445506966502*^9, 
  3.968445507149242*^9}, {3.968445660838478*^9, 3.9684456612773743`*^9}, {
  3.970334067990761*^9, 3.9703340747632*^9}, {3.972995011416554*^9, 
  3.9729950540140753`*^9}, {3.972995771187028*^9, 3.972995823884774*^9}, {
  3.972995854657971*^9, 3.972995861441024*^9}},
 CellLabel->"In[5]:=",
 CellID->1234072286,ExpressionUUID->"e7ea7ec5-b5c6-4110-af8f-97cb71092535"],

Cell["\<\
The U3 gate is a general single-qubit rotation formed by combining the \
earlier rotations. It is defined by three angles.\
\>", "Text",
 CellChangeTimes->{
  3.968427791004533*^9, {3.9684316007090673`*^9, 3.968431631455923*^9}},
 CellID->1698749807,ExpressionUUID->"594440e0-fff3-4fe2-a363-c22785ad9052"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"\[Theta]", ",", " ", "\[Phi]", " ", ",", "\[Lambda]"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<U3\>\"", "[", 
    RowBox[{"\[Theta]", ",", " ", "\[Phi]", " ", ",", "\[Lambda]"}], "]"}], 
   "]"}], "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"\"\<WireLabels\>\"", "->", "None"}], ",", 
   RowBox[{"ImageSize", "->", "100"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9684280462173443`*^9, 3.968428057683321*^9}, 
   3.968495893639223*^9},
 CellLabel->
  "In[249]:=",ExpressionUUID->"049b1537-b1ef-464f-92ab-3ba597a2e934"],

Cell["Show the matrix forma of U3:", "Text",
 CellChangeTimes->{{3.968431634158834*^9, 
  3.968431637988769*^9}},ExpressionUUID->"6f970bb1-d3eb-4659-96e1-\
c0cb9b90f337"],

Cell[BoxData[
 RowBox[{"MatrixForm", "[", 
  RowBox[{
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<U3\>\"", "[", 
     RowBox[{"\[Theta]", ",", " ", "\[Phi]", " ", ",", "\[Lambda]"}], "]"}], 
    "]"}], "[", "\"\<Matrix\>\"", "]"}], "]"}]], "Input",
 CellProlog:>Needs["Wolfram`QuantumFramework`"],
 CellChangeTimes->{3.9684277778108463`*^9, 3.9684278090711117`*^9},
 CellLabel->"In[251]:=",
 CellID->475475519,ExpressionUUID->"88a15eaf-3901-4c10-bc5c-4fe7b6cb0117"],

Cell[TextData[{
 "In the Bloch sphere, the action of ",
 Cell[BoxData[
  RowBox[{"U3", "[", 
   RowBox[{"\[Lambda]", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "83578208-3827-4acd-b437-95bb4fb614be"],
 " is the same as ",
 Cell[BoxData[
  RowBox[{"EulerMatrix", "[", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "\[Lambda]", ",", "\[Phi]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e89e47f6-969b-44e2-b6c6-7d43eecddcc1"],
 ", which is the Euler 3D rotation matrix formed by rotating by ",
 Cell[BoxData["\[Theta]"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "453218b4-0b71-4fac-8c20-307a73233ebe"],
 " around the current ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]], "InlineMath",ExpressionUUID->
  "121690ed-82ec-463d-b2b8-15e107a4b040"],
 " axis, then by ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TR"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5ec2d2b4-192c-44ce-b43b-e3812264ddea"],
 " around the current ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]], "InlineMath",ExpressionUUID->
  "5f43d6de-dd97-42eb-964f-8673e57541e3"],
 " axis, and then by ",
 Cell[BoxData["\[Phi]"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1a35e719-6ef1-4534-ba67-de46ce1f05f2"],
 " around the current ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]], "InlineMath",ExpressionUUID->
  "18e3f48c-964b-4d6e-af68-4dbb0f9c3995"],
 " axis. "
}], "Text",
 CellChangeTimes->{{3.968428102156663*^9, 3.9684281088518*^9}, {
  3.968493799012718*^9, 3.968493818229787*^9}},
 CellID->698703856,ExpressionUUID->"687d59d6-cdd0-4059-8612-8445a78bfd09"],

Cell["\<\
For example, generate three angles, and a point on the Bloch sphere:\
\>", "Text",
 CellChangeTimes->{{3.968428102156663*^9, 3.9684281088518*^9}, {
  3.968493799012718*^9, 3.96849381389482*^9}, {3.971796993038898*^9, 
  3.971796993492251*^9}},ExpressionUUID->"dc1318d2-a887-40e8-b9b4-\
1216500fda6c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"\[Lambda]", ",", "\[Theta]", ",", "\[Phi]", ",", "vec"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Lambda]", ",", "\[Theta]", ",", "\[Phi]"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Pi]", "/", "7"}], ",", 
     RowBox[{"\[Pi]", "/", "5"}], ",", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], "/", "3"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vec", "=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", " ", 
       SqrtBox["2"]}]], ",", 
     FractionBox[
      SqrtBox[
       FractionBox["3", "2"]], "2"], ",", 
     FractionBox["1", 
      SqrtBox["2"]]}], "}"}]}], ";"}]}], "Input",
 CellProlog:>Needs["Wolfram`QuantumFramework`"],
 CellChangeTimes->{{3.968428074768187*^9, 3.968428077153973*^9}, {
   3.968493873673205*^9, 3.968493893107624*^9}, {3.971797046064102*^9, 
   3.971797065389905*^9}, 3.9717971227560453`*^9, {3.971797168458179*^9, 
   3.971797187293911*^9}},
 CellLabel->"In[252]:=",
 CellID->720006038,ExpressionUUID->"438e8510-c65b-4304-82cb-e7171d359774"],

