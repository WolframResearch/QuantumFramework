Cell[BoxData[
 RowBox[{"\[Lambda]s", "=", 
  RowBox[{"Eigenvalues", "[", 
   RowBox[{"\[ScriptCapitalU]a", "[", 
    RowBox[{"\[ScriptA]", ",", "\[ScriptCapitalN]"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9693735796003733`*^9, 3.969373589310103*^9}, {
   3.96937362750931*^9, 3.9693736290085897`*^9}, 3.969373702430274*^9},
 CellLabel->
  "In[518]:=",ExpressionUUID->"82ca31eb-c504-41c1-95ab-0b9a1e4fdd90"],

Cell[TextData[{
 "Find each \[Theta] such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "=", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", " ", "\[Theta]"}]]}], 
   TraditionalForm]],ExpressionUUID->"2a1e2e2f-5253-45e4-be92-623f63d83313"],
 ":"
}], "Text",
 CellChangeTimes->{{3.954864986149494*^9, 
  3.9548650520232716`*^9}},ExpressionUUID->"a6ecd217-0c23-4eca-8b52-\
f99db8a64fb3"],

Cell[BoxData[
 RowBox[{"\[Theta]s", "=", 
  RowBox[{"Mod", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Arg", "[", "\[Lambda]s", "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "Pi"}], ")"}]}], ",", "1"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9548647927825623`*^9, 3.9548648311123257`*^9}, {
  3.954865066315548*^9, 3.9548650743985634`*^9}, {3.954865109012377*^9, 
  3.9548651120550766`*^9}, {3.969373636438772*^9, 3.969373639268749*^9}},
 CellLabel->
  "In[519]:=",ExpressionUUID->"9e8f377a-df55-4006-8481-4798bea9bcda"],

Cell[TextData[{
 "Verify  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "=", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", " ", "\[Theta]"}]]}], 
   TraditionalForm]],ExpressionUUID->"4283ceec-cea1-4012-bcdc-13d798e2573e"],
 ":"
}], "Text",
 CellChangeTimes->{{3.969373665213561*^9, 3.969373687903502*^9}, {
  3.969373826978689*^9, 
  3.969373828683969*^9}},ExpressionUUID->"56217278-582f-4279-9df8-\
a2d79bd28d9c"],

Cell[BoxData[
 RowBox[{"\[Lambda]s", "==", 
  RowBox[{"Exp", "[", 
   RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", " ", "\[Theta]s"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.969373803134334*^9, 3.969373817253212*^9}},
