Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"st", "=", 
          RowBox[{"QuantumState", "[", "#", "]"}]}], ",", 
         RowBox[{"op", "=", 
          RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"st", "[", "\"\<BlochPlot\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{"QuantumCircuitOperator", "[", "op", "]"}], "[", 
          RowBox[{"\"\<Diagram\>\"", ",", 
           RowBox[{"\"\<WireLabels\>\"", "->", "None"}], ",", 
           RowBox[{"ImageSize", "->", "200"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"op", "[", "st", "]"}], "[", "\"\<BlochPlot\>\"", "]"}]}], 
        "}"}]}], "]"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{"\"\<+\>\"", ",", "\"\<-\>\"", ",", "\"\<R\>\"", 
      ",", "\"\<L\>\""}], "}"}]}], ",", 
   RowBox[{"Frame", "->", 
    RowBox[{"{", 
