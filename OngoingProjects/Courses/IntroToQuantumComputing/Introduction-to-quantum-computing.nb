Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["R", "Y"], "[", "\[Theta]", "]"}], "=", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], 
     FractionBox["\[Theta]", "2"], "Y"}]]}], 
  TraditionalForm]],ExpressionUUID->"9a01c6ae-813c-4cf5-a0f0-3ca3f0b7084f"]], \
"Text",
 CellChangeTimes->{{3.9684310517690983`*^9, 3.968431078567883*^9}, {
  3.968431320210409*^9, 
  3.96843132671122*^9}},ExpressionUUID->"c6006f38-cc76-4157-b0c7-\
8c65aba544dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<RY\>\"", "[", "\[Theta]", "]"}], "]"}], "==", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     RowBox[{"\[Theta]", "/", "2"}], " ", 
     RowBox[{"QuantumOperator", "[", "\"\<Y\>\"", "]"}]}], "]"}]}], "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.9684309641125193`*^9, 3.968431046598651*^9}, {
  3.968431328917143*^9, 3.968431330851441*^9}},
 CellLabel->
  "In[240]:=",ExpressionUUID->"c0ec57d3-1959-4033-996e-d80e6987d36f"],

