Cell["\<\
The oscillation is the qubit, but its amplitude is smaller than individual \
finite-record fluctuations. Confirm first that the same estimator applied to \
a pure Wiener record also has nonzero sample scatter:\
\>", "Text",ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pureDy", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"Sqrt", "[", "dt0", "]"}]}], "]"}], ",", " ", 
       RowBox[{"Length", "[", "dy0", "]"}]}], "]"}]}], "\n", "   ", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"pureCorr", " ", "=", " ", 
   RowBox[{"CorrelationFunction", "[", 
    RowBox[{"pureDy", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"First", "[", "lagSteps", "]"}], ",", " ", 
       RowBox[{"Last", "[", "lagSteps", "]"}], ",", " ", "4"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", "pureCorr", "]"}], "]"}]}], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],

Cell[BoxData["0.009241105980635591`"], "Output",
 CellLabel->
  "Out[10]= ",ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"]
}, Open  ]],

Cell[TextData[{
 "The maxima are similar, so the largest correlation value alone cannot \
identify the qubit. We need a statistic chosen from the model before \
comparing the two records. The Hamiltonian fixes the trial oscillation scale \
at ",
 Cell[BoxData[
  SubscriptBox["\[CapitalOmega]", "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07359582-e823-44a1-2eca-0cef89d62e8b"],
 ", so project both correlations onto that cosine before comparing either \
score:"
}], "Text",ExpressionUUID->"7c239bd0-3ff5-3b18-25d0-129ab9818662"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"correlationTemplate", " ", "=", " ", 
   RowBox[{"Cos", "[", 
    RowBox[{"\[CapitalOmega]0", " ", "dt0", " ", "lagSteps"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"correlationScores", " ", "=", "\n", "  ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"#", " ", ".", " ", "correlationTemplate"}], "/", 
       RowBox[{"Norm", "[", "correlationTemplate", "]"}]}], " ", "&"}], ")"}],
     " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"corr0", ",", " ", "pureCorr"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"AssociationThread", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<qubit record\>\"", ",", " ", "\"\<pure Wiener record\>\""}], 
    "}"}], ",", " ", "correlationScores"}], "]"}]}], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"68c76573-72ce-0c1a-18fd-7d3d077b5760"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"qubit record\"\>", "\[Rule]", "0.012561810111466207`"}], ",", 
   
   RowBox[{"\<\"pure Wiener record\"\>", "\[Rule]", 
    RowBox[{"-", "0.0012296905026277138`"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[11]= ",ExpressionUUID->"6184d2f2-049e-728e-17bb-cbbcad2b40d4"]
}, Open  ]],

Cell["\<\
As one can see, the model-guided oscillatory score separates these seeded \
records even though their largest individual correlation values do not. This \
is still a demonstration, not a detection threshold. A serious claim needs \
independent seeds or a sampling distribution for the score.\
\>", "Text",ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"],

Cell["\<\
Part III: A Calibrated Power Spectrum with Built-in Functions\
\>", "Section",ExpressionUUID->"19bb1c5e-57ab-6e36-4f58-9618625e351c"],

Cell["\<\
The Wiener-Khinchin theorem connects the covariance to the power spectral \
density. For the normalized homodyne current\
\>", "Text",ExpressionUUID->"5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["n", "TI"]], "=", 
    FractionBox[
     RowBox[{
      StyleBox["d", "TI"], 
      SubscriptBox[
       StyleBox["y", "TI"], 
       StyleBox["n", "TI"]]}], 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"30baa1c8-66ad-75e0-6059-389213585fca"],

Cell[TextData[{
 "white shot noise has a flat two-sided spectral density equal to one. Since ",
 Cell[BoxData["PeriodogramArray"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52535901-cb26-8b9c-0261-516aeed0d9e6"],
 " preserves the mean power per sample, the physical normalization can be \
written in either of two equivalent ways:"
}], "Text",ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["J", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox["k", "TI"]], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], " ", 
    StyleBox["PeriodogramArray",
     FontSlant->"Plain"], 
    SubscriptBox[
     RowBox[{
      StyleBox["[",
       SpanMaxSize->1], 
      StyleBox["J", "TI"], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     StyleBox["k", "TI"]], "=", 
    FractionBox["1", 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]], " ", 
    StyleBox["PeriodogramArray",
     FontSlant->"Plain"], 
    SubscriptBox[
     RowBox[{
      StyleBox["[",
       SpanMaxSize->1], 
      StyleBox[
       RowBox[{"d", "y"}], "TI"], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     StyleBox["k", "TI"]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"],

Cell[TextData[{
 "In other words, the factor of ",
 Cell[BoxData["dt"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "511b3347-8d7d-ab60-0738-ab212409f64a"],
 " is a units conversion, not an adjustable constant."
}], "Text",ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"],

Cell["\<\
Choose overlapping segments and a Hann window. The overlap averages more \
estimates, while the window reduces leakage from a frequency that does not \
land exactly on a discrete Fourier bin:\
\>", "Text",ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nWindow", " ", "=", " ", "8192"}], ";", " ", 
  RowBox[{"nOffset", " ", "=", " ", 
   RowBox[{"nWindow", "/", "2"}]}], ";", " ", 
  RowBox[{"nFourier", " ", "=", " ", "nWindow"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"periodogram0", " ", "=", " ", 
   RowBox[{
    RowBox[{"PeriodogramArray", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"dy0", " ", "-", " ", 
       RowBox[{"Mean", "[", "dy0", "]"}]}], ",", " ", "nWindow", ",", " ", 
      "nOffset", ",", " ", "HannWindow", ",", " ", "nFourier"}], "\n", "    ",
      "]"}], "/", "dt0"}]}], ";"}]}], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"],

Cell["\<\
Verify directly that analyzing the current gives the same normalized array:\
\>", "Text",ExpressionUUID->"5900aac7-5263-773e-0f3f-43a167165a04"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"currentPeriodogram", " ", "=", " ", 
   RowBox[{"dt0", " ", 
    RowBox[{"PeriodogramArray", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"current0", " ", "-", " ", 
       RowBox[{"Mean", "[", "current0", "]"}]}], ",", " ", "nWindow", ",", 
      " ", "nOffset", ",", " ", "HannWindow", ",", " ", "nFourier"}], "\n", 
     "    ", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"currentPeriodogram", " ", "-", " ", "periodogram0"}], "]"}], 
   "]"}], " ", "<", " ", 
  RowBox[{"10", "^", 
   RowBox[{"-", "12"}]}]}]}], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"12d95fcb-3316-2212-42e7-569546a37178"]
}, Open  ]],

Cell["\<\
Attach the physical angular-frequency axis and retain the nonnegative half. \
We keep the two-sided normalization, so the shot-noise floor remains one even \
though only one half is plotted:\
\>", "Text",ExpressionUUID->"733995c2-f5bf-78ee-22c6-0caffc4a4a34"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nPositive", " ", "=", " ", 
   RowBox[{
    RowBox[{"Floor", "[", 
     RowBox[{"nFourier", "/", "2"}], "]"}], " ", "+", " ", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Omega]Grid", " ", "=", " ", 
   RowBox[{"2", " ", "Pi", " ", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"nPositive", " ", "-", " ", "1"}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"nFourier", " ", "dt0"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spectrum0", " ", "=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"\[Omega]Grid", ",", " ", 
      RowBox[{"periodogram0", "[", 
       RowBox[{"[", 
        RowBox[{"1", " ", ";;", " ", "nPositive"}], "]"}], "]"}]}], "}"}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"4f8ab258-7e7f-0723-7589-34027b0a6a09"],

Cell["\<\
Calibrate the estimator on synthetic shot noise before interpreting the qubit:\
\>", "Text",ExpressionUUID->"6b12ee74-9953-131d-1921-003e18e67e67"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"noisePeriodogram", " ", "=", " ", 
   RowBox[{
    RowBox[{"PeriodogramArray", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"pureDy", " ", "-", " ", 
       RowBox[{"Mean", "[", "pureDy", "]"}]}], ",", " ", "nWindow", ",", " ", 
      "nOffset", ",", " ", "HannWindow", ",", " ", "nFourier"}], "\n", "    ",
      "]"}], "/", "dt0"}]}], ";"}], "\n", 
 RowBox[{"Mean", "[", "noisePeriodogram", "]"}]}], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"65262d3c-fccc-1dc6-0cdd-c579f579672c"],

Cell[BoxData["1.00025700105388`"], "Output",
 CellLabel->
  "Out[15]= ",ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"]
}, Open  ]],

Cell[TextData[{
 "The result is close to one. The same conclusion can be checked at a chosen \
angular frequency with ",
 Cell[BoxData["PowerSpectralDensity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78287f93-0f12-7c52-2828-76ddaaa746b8"],
 ", whose smoothing specification is a cutoff together with a window:"
}], "Text",ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"PowerSpectralDensity", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"pureDy", " ", "-", " ", 
     RowBox[{"Mean", "[", "pureDy", "]"}]}], ",", " ", 
    RowBox[{"\[CapitalOmega]0", " ", "dt0"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"512", ",", " ", "HannWindow"}], "}"}]}], "\n", "  ", "]"}], "/",
   "dt0"}]], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],

Cell[BoxData["0.9733393658511219`"], "Output",
 CellLabel->
  "Out[16]= ",ExpressionUUID->"187adc3d-3961-76c2-4819-d667b8145c28"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["PowerSpectralDensity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "641c78eb-7f03-7846-0c24-71b57ab64aac"],
 " is convenient when a symbolic frequency or a few selected frequencies are \
wanted. ",
 Cell[BoxData["PeriodogramArray"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],
 " is convenient when a dense grid and explicit segment averaging are wanted. \
Both are built-in, and neither requires us to write a Fourier normalization \
by hand."
}], "Text",ExpressionUUID->"112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],

Cell["\<\
Now plot the measured spectrum over the band containing the drive:\
\>", "Text",ExpressionUUID->"6121b9de-dddd-aca8-10de-309bd469f6f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Select", "[", 
    RowBox[{"spectrum0", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"First", "[", "#", "]"}], " ", "<=", " ", "8"}], " ", "&"}]}], 
    "]"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "\[CapitalOmega]0", "}"}], ",", " ", 
      RowBox[{"{", "1", "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<angular frequency \[Omega]\>\"", ",", 
      " ", "\"\<S_J(\[Omega])\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<A Rabi feature rises above the unit shot-noise floor\>\""}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"30209679-023a-ee91-61df-0823b7ccb4fb"],

