Cell["\<\
The picture is suggestive, but we should compute the change rather than read \
it only by eye. Average the first and second halves of the spectrogram and \
locate the strongest line in a fixed band:\
\>", "Text",ExpressionUUID->"6f6ad260-8ee1-565a-1569-d44a2a943ca0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"stftFrequencies", " ", "=", " ", 
   RowBox[{"2", " ", "Pi", " ", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"maxFrequencyBin", " ", "-", " ", "1"}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"nSTFT", " ", "dt0"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"stftBand", " ", "=", " ", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Position", "[", 
     RowBox[{"stftFrequencies", ",", " ", 
      RowBox[{"\[Omega]_", " ", "/;", " ", 
       RowBox[{"1", " ", "<", " ", "\[Omega]", " ", "<", " ", "7"}]}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"halfSpectra", " ", "=", " ", 
   RowBox[{"Mean", " ", "/@", " ", 
    RowBox[{
     RowBox[{"Partition", "[", 
      RowBox[{"stftPower", ",", " ", 
       RowBox[{"Floor", "[", 
        RowBox[{
         RowBox[{"Length", "[", "stftPower", "]"}], "/", "2"}], "]"}]}], 
      "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", " ", ";;", " ", "2"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"halfFeatureFrequencies", " ", "=", " ", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"halfSpectrum", ",", "\n", "     ", 
      RowBox[{"stftFrequencies", "[", 
       RowBox[{"[", 
        RowBox[{"stftBand", "[", 
         RowBox[{"[", 
          RowBox[{"First", "@", 
           RowBox[{"Ordering", "[", 
            RowBox[{
             RowBox[{"halfSpectrum", "[", 
              RowBox[{"[", "stftBand", "]"}], "]"}], ",", " ", 
             RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}], "]"}], "]"}]}], 
     "\n", "     ", "]"}], " ", "/@", " ", "halfSpectra"}]}], ";"}], "\n", 
 RowBox[{"AssociationThread", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<first half\>\"", ",", " ", "\"\<second half\>\""}], "}"}], ",",
    " ", "halfFeatureFrequencies"}], "]"}]}], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"first half\"\>", "\[Rule]", "1.8407769454627694`"}], ",", 
   RowBox[{"\<\"second half\"\>", "\[Rule]", "4.908738521234052`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[28]= ",ExpressionUUID->"26dca2d1-2715-746d-4ee3-3b9b52a05eb7"]
}, Open  ]],

Cell["\<\
Verify that the two computed features lie near the imposed drive values:\
\>", "Text",ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"halfFeatureFrequencies", " ", "-", " ", 
     RowBox[{"{", 
      RowBox[{"2.", ",", " ", "5."}], "}"}]}], "]"}], "]"}], " ", "<", " ", 
  "0.3"}]], "Input",
 CellLabel->
  "In[29]:= ",ExpressionUUID->"6b853673-18d0-d9fa-19ba-a83d996aabc0"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[29]= ",ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"]
}, Open  ]],

Cell["\<\
The time-frequency calculation resolves the switch for this seeded record. It \
sacrifices frequency resolution to recover timing. That tradeoff is \
unavoidable: longer windows locate frequency more sharply, while shorter \
windows locate a change more sharply.\
\>", "Text",ExpressionUUID->"574a2197-51ef-7938-7d49-b8d1679a4802"],

Cell["\<\
Before we move on, let us summarize the most important points we have learned \
so far:\
\>", "Text",ExpressionUUID->"6e85e9ed-427b-8528-16ba-00b7770fec72"],

Cell[TextData[{
 Cell[BoxData["dy0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73b76025-96bb-3fff-214d-798f234f85c5"],
 " fluctuates on the ",
 Cell[BoxData[
  SqrtBox[
   StyleBox[
    RowBox[{"d", "t"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31f4c073-8ff6-126f-678b-da3d298360b5"],
 " scale, while ",
 Cell[BoxData["current0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ff7667-e560-b2c0-2285-68408c1a002a"],
 " fluctuates on the ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox[
     RowBox[{"d", "t"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c9be80e-0554-61c1-24b8-0268ace1332b"],
 " scale."
}], "Item",ExpressionUUID->"106b7ad8-6378-599b-4069-7382160d2be1"],

Cell["\<\
A model-guided projection separates the qubit's oscillatory correlation from \
a pure Wiener record, while the largest raw correlation value does not.\
\>", "Item",ExpressionUUID->"7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],

Cell[TextData[{
 Cell["PeriodogramArray[dy]/dt", "InlineCode",ExpressionUUID->
  "304452a4-201b-d64c-607c-4b0e51afbc96"],
 " and ",
 Cell[BoxData[
  RowBox[{"dt", " ", 
   RowBox[{"PeriodogramArray", "[", "current", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],
 " share a unit white-noise floor."
}], "Item",ExpressionUUID->"4b5b9263-9199-4e16-7978-144d202c157c"],

Cell["\<\
An excess-power centroid finds a broad Rabi feature without overinterpreting \
a single raw bin.\
\>", "Item",ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"],

Cell[TextData[{
 Cell[BoxData["SpectrogramArray"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],
 " and the two half-record estimates resolve the imposed change from ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3343f580-98d5-e31c-6170-ecea1961ce66"],
 " to ",
 Cell[BoxData["5"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a7420b-376a-b23f-505d-6455421c0105"],
 "."
}], "Item",ExpressionUUID->"6af863a9-1098-c609-1a98-7af3a112ad53"],

Cell[TextData[{
 Cell[BoxData["LindbladSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "055bc2ad-6b92-a3be-3378-dbf70e24f184"],
 " gives an independent unconditional transient whose peak spacing agrees \
with the record's oscillation scale."
}], "Item",ExpressionUUID->"2b0fb60e-2211-365f-5934-286857a59ca5"],

Cell["Part IV: Replay an External Record as a Quantum Filter", "Section",ExpressionUUID->"201a2509-bdd9-2fa1-5039-bd53346c758b"],

Cell[TextData[{
 "The trajectory generator draws ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 ", converts it to ",
 Cell[BoxData["dy"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f932952-49a5-d34f-05a0-c11c6851a195"],
 " with ",
 Cell[BoxData["\[ScriptCapitalR]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "160f17c4-d31a-fe19-3e34-8ea1e6acc563"],
 ", and then updates the state. An experiment supplies ",
 Cell[BoxData["dy"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10beb8bd-bdb6-ee93-4045-31e73440b4f9"],
 " directly. Filtering therefore removes only the random draw and keeps the \
state update unchanged."
}], "Text",ExpressionUUID->"3fdc991b-fead-14b0-65e3-1144fb587e9a"],

Cell[TextData[{
 "In other words, the following functions do not define a second trajectory \
algorithm. They validate the external record, expose the body of ",
 Cell[BoxData["\|01d4af"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],
 " after the line that generated the record, then fold the supplied values \
through the same ",
 Cell[BoxData["s"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0642d375-09f3-9942-2e71-cb3faf87eba8"],
 ", ",
 Cell[BoxData["m"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0651775d-2bad-791b-2e6f-6f074e584861"],
 ", and ",
 Cell[BoxData["num"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63b9e3d6-2298-231e-1146-fa9057128e64"],
 " expressions."
}], "Text",ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"],

Cell["\<\
First check the physical dimensions: a positive time step, a density operator \
and Hermitian Hamiltonian of the same size, at least one compatible monitored \
channel, one efficiency per channel, and one numeric entry per channel in \
every record row:\
\>", "Text",ExpressionUUID->"4c440104-ea8a-4285-747b-99618f3f10ef"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "validRecordModelQ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"validRecordModelQ", "[", 
    RowBox[{
    "\[Rho]0_", ",", " ", "H_", ",", " ", "Ls_List", ",", " ", "\[Eta]_", ",",
      " ", "V_", ",", " ", "dt_", ",", " ", "record_List"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"Length", "[", "\[Rho]0", "]"}]}], ",", " ", 
       RowBox[{"Vs", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"V", " ", "===", " ", "None"}], ",", " ", 
          RowBox[{"{", "}"}], ",", " ", "V"}], "]"}]}]}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{
      RowBox[{"TrueQ", "[", 
       RowBox[{"dt", " ", ">", " ", "0"}], "]"}], " ", "&&", " ", 
      RowBox[{"densityOperatorQ", "[", 
       RowBox[{"N", "[", "\[Rho]0", "]"}], "]"}], " ", "&&", " ", 
      RowBox[{"HermitianMatrixQ", "[", 
       RowBox[{"N", "[", "H", "]"}], "]"}], " ", "&&", "\n", "   ", 
      RowBox[{
       RowBox[{"Dimensions", "[", "H", "]"}], " ", "==", " ", 
       RowBox[{"{", 
        RowBox[{"d", ",", " ", "d"}], "}"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Length", "[", "Ls", "]"}], " ", ">", " ", "0"}], " ", "&&", 
      "\n", "   ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{"Ls", ",", " ", "Vs"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"MatrixQ", "[", "#", "]"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"Dimensions", "[", "#", "]"}], " ", "==", " ", 
           RowBox[{"{", 
            RowBox[{"d", ",", " ", "d"}], "}"}]}]}], " ", "&"}]}], "]"}], " ",
       "&&", "\n", "   ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Eta]", " ", "===", " ", "None"}], " ", "||", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ListQ", "[", "\[Eta]", "]"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"Length", "[", "\[Eta]", "]"}], " ", "==", " ", 
           RowBox[{"Length", "[", "Ls", "]"}]}], " ", "&&", "\n", "      ", 
          RowBox[{"VectorQ", "[", 
           RowBox[{"\[Eta]", ",", " ", 
            RowBox[{"Function", "[", 
             RowBox[{"x", ",", " ", 
              RowBox[{
               RowBox[{"NumberQ", "[", 
                RowBox[{"N", "[", "x", "]"}], "]"}], " ", "&&", " ", 
               RowBox[{"TrueQ", "[", 
                RowBox[{"0", " ", "<=", " ", "x", " ", "<=", " ", "1"}], 
                "]"}]}]}], "]"}]}], "]"}]}], ")"}]}], ")"}], " ", "&&", "\n", 
      "   ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"record", ",", " ", 
        RowBox[{"Function", "[", 
         RowBox[{"row", ",", "\n", "     ", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "row", "]"}], " ", "==", " ", 
            RowBox[{"Length", "[", "Ls", "]"}]}], " ", "&&", "\n", "      ", 
           RowBox[{"VectorQ", "[", 
            RowBox[{"row", ",", " ", 
             RowBox[{"Function", "[", 
              RowBox[{"x", ",", " ", 
               RowBox[{
                RowBox[{"NumberQ", "[", 
                 RowBox[{"N", "[", "x", "]"}], "]"}], " ", "&&", " ", 
                RowBox[{"TrueQ", "[", 
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"Im", "[", 
                    RowBox[{"N", "[", "x", "]"}], "]"}], "]"}], " ", "<", " ", 
                  RowBox[{"10", "^", 
                   RowBox[{"-", "10"}]}]}], "]"}]}]}], "]"}]}], "]"}]}]}], 
         "]"}]}], "]"}]}]}], "\n", "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[30]:= ",ExpressionUUID->"66c9a615-af45-c085-0ef6-385ecaf192ef"],

Cell[TextData[{
 "Now build the one-step update from the unchanged coefficients of ",
 Cell[BoxData["\|01d4af"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0513e607-0f4c-1e20-3320-f861aaf9650a"],
 ":"
}], "Text",ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "makeConditionedStep", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"makeConditionedStep", "[", 
    RowBox[{
     RowBox[{"\[Rho]0_", "?", "MatrixQ"}], ",", " ", 
     RowBox[{"H_", "?", "MatrixQ"}], ",", " ", "Ls_List", ",", " ", "\[Eta]_",
      ",", " ", "V_", ",", " ", 
     RowBox[{"dt_", "?", "NumericQ"}]}], "]"}], " ", ":=", "\n", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"Length", "[", "\[Rho]0", "]"}]}], ",", " ", 
       RowBox[{"Hn", " ", "=", " ", 
        RowBox[{"N", "[", "H", "]"}]}], ",", " ", 
       RowBox[{"Lsn", " ", "=", " ", 
        RowBox[{"N", "[", "Ls", "]"}]}], ",", " ", 
       RowBox[{"dtn", " ", "=", " ", 
        RowBox[{"N", "[", "dt", "]"}]}], ",", "\n", "   ", "\[Eta]v", ",", 
       " ", "Vsn", ",", " ", "heff", ",", " ", "lcorr"}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{
      RowBox[{"\[Eta]v", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"\[Eta]", " ", "===", " ", "None"}], ",", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"Length", "[", "Ls", "]"}]}], "]"}], ",", " ", "\[Eta]"}],
          "]"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"Vsn", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"V", " ", "===", " ", "None"}], ",", " ", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"N", "[", "V", "]"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"heff", " ", "=", " ", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "d", "]"}], " ", "-", " ", 
        RowBox[{"dtn", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"I", " ", "Hn"}], "\n", "      ", "+", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}], " ", 
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"ConjugateTranspose", "[", "#", "]"}], " ", ".", " ", 
                "#"}], " ", "&"}], " ", "/@", " ", "Lsn"}], "]"}]}], "\n", 
           "      ", "+", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}], " ", 
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"ConjugateTranspose", "[", "#", "]"}], " ", ".", " ", 
                "#"}], " ", "&"}], " ", "/@", " ", "Vsn"}], "]"}]}]}], 
          ")"}]}]}]}], ";", "\n", "  ", 
      RowBox[{"lcorr", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"dtn", "/", "2"}], ")"}], " ", 
        RowBox[{"Total", "[", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#1", " ", 
             RowBox[{"(", 
              RowBox[{"#2", " ", ".", " ", "#2"}], ")"}]}], " ", "&"}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{"\[Eta]v", ",", " ", "Lsn"}], "}"}]}], "]"}], "]"}]}]}], ";",
       "\n", "  ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Rho]", ",", " ", "dy"}], "}"}], ",", " ", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"s", ",", " ", "m", ",", " ", "num"}], "}"}], ",", "\n", 
          "    ", 
          RowBox[{
           RowBox[{"s", " ", "=", " ", 
            RowBox[{"Total", "[", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#1", " ", 
                 RowBox[{"Sqrt", "[", "#2", "]"}], " ", "#3"}], " ", "&"}], ",",
                " ", 
               RowBox[{"{", 
                RowBox[{"dy", ",", " ", "\[Eta]v", ",", " ", "Lsn"}], "}"}]}],
               "]"}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"m", " ", "=", " ", 
            RowBox[{"heff", " ", "+", " ", "s", " ", "+", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "/", "2"}], ")"}], " ", 
              RowBox[{"s", " ", ".", " ", "s"}]}], " ", "-", " ", "lcorr"}]}],
            ";", "\n", "    ", 
           RowBox[{"num", " ", "=", " ", 
            RowBox[{
             RowBox[{"m", " ", ".", " ", "\[Rho]", " ", ".", " ", 
              RowBox[{"ConjugateTranspose", "[", "m", "]"}]}], "\n", 
             "       ", "+", " ", 
             RowBox[{"dtn", " ", 
              RowBox[{"Total", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"#", " ", ".", " ", "\[Rho]", " ", ".", " ", 
                   RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], ")"}], 
                 " ", "&"}], " ", "/@", " ", "Vsn"}], "]"}]}], "\n", 
             "       ", "+", " ", 
             RowBox[{"dtn", " ", 
              RowBox[{"Total", "[", 
               RowBox[{"MapThread", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", " ", "-", " ", "#2"}], ")"}], " ", 
                   RowBox[{"(", 
                    RowBox[{"#1", " ", ".", " ", "\[Rho]", " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "#1", "]"}]}], ")"}]}],
                   " ", "&"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"Lsn", ",", " ", "\[Eta]v"}], "}"}]}], "]"}], 
               "]"}]}]}]}], ";", "\n", "    ", 
           RowBox[{"num", "/", 
            RowBox[{"Tr", "[", "num", "]"}]}]}]}], "]"}]}], "]"}]}]}], "\n", 
    "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[31]:= ",ExpressionUUID->"6833ae6a-6ac5-a2c8-19c0-40340f71f012"],

Cell["Now fold that step through an external record:", "Text",ExpressionUUID->"5f7f2999-1aee-25a5-0504-c0c39e988f8f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "conditionOnRecord", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"conditionOnRecord", "[", 
    RowBox[{
    "\[Rho]0_", ",", " ", "H_", ",", " ", "Ls_", ",", " ", "dt_", ",", " ", 
     "record_"}], "]"}], " ", ":=", "\n", " ", 
   RowBox[{"conditionOnRecord", "[", 
    RowBox[{
    "\[Rho]0", ",", " ", "H", ",", " ", "Ls", ",", " ", "None", ",", " ", 
     "None", ",", " ", "dt", ",", " ", "record"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"conditionOnRecord", "[", 
    RowBox[{
    "\[Rho]0_", ",", " ", "H_", ",", " ", "Ls_", ",", " ", "\[Eta]_", ",", 
     " ", "dt_", ",", " ", "record_"}], "]"}], " ", ":=", "\n", " ", 
   RowBox[{"conditionOnRecord", "[", 
    RowBox[{
    "\[Rho]0", ",", " ", "H", ",", " ", "Ls", ",", " ", "\[Eta]", ",", " ", 
     "None", ",", " ", "dt", ",", " ", "record"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"conditionOnRecord", "[", 
    RowBox[{
    "\[Rho]0_", ",", " ", "H_", ",", " ", "Ls_", ",", " ", "\[Eta]_", ",", 
     " ", "V_", ",", " ", "dt_", ",", " ", "record_"}], "]"}], " ", ":=", 
   "\n", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TrueQ", "@", 
      RowBox[{"validRecordModelQ", "[", 
       RowBox[{
       "\[Rho]0", ",", " ", "H", ",", " ", "Ls", ",", " ", "\[Eta]", ",", " ",
         "V", ",", " ", "dt", ",", " ", "record"}], "]"}]}], ",", "\n", "  ", 
     
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"step", " ", "=", " ", 
         RowBox[{"makeConditionedStep", "[", 
          RowBox[{
          "\[Rho]0", ",", " ", "H", ",", " ", "Ls", ",", " ", "\[Eta]", ",", 
           " ", "V", ",", " ", "dt"}], "]"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"FoldList", "[", 
        RowBox[{"step", ",", " ", 
         RowBox[{"N", "[", "\[Rho]0", "]"}], ",", " ", 
         RowBox[{"N", "[", "record", "]"}]}], "]"}]}], "\n", "   ", "]"}], ",",
      "\n", "  ", 
     RowBox[{"Failure", "[", 
      RowBox[{"\"\<InvalidRecordModel\>\"", ",", "\n", "   ", 
       RowBox[{"<|", 
        RowBox[{"\"\<MessageTemplate\>\"", " ", "->", 
         " ", "\"\<Dimensions, efficiencies, or record rows are incompatible.\
\>\""}], "|>"}]}], "]"}]}], "\n", "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[32]:= ",ExpressionUUID->"128c7526-c883-085d-42b4-6c83e9365aa7"],

Cell["\<\
The strongest implementation check is a round trip. Generate a short \
trajectory, retain its record, and replay that record from the same initial \
state:\
\>", "Text",ExpressionUUID->"3279c00f-c9e2-8758-6206-da68ef94eda2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"trajectoryReplay", ",", " ", 
     RowBox[{"{", "recordReplay", "}"}]}], "}"}], " ", "=", " ", 
   RowBox[{"BlockRandom", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "20", "]"}], ";", " ", 
     RowBox[{"Reap", "@", 
      RowBox[{"\[ScriptCapitalT]", "[", 
       RowBox[{
       "\[Rho]0", ",", " ", "H0", ",", " ", "L0", ",", " ", "dt0", ",", " ", 
        "8."}], "]"}]}]}], "\n", "   ", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"filteredReplay", " ", "=", " ", 
   RowBox[{"conditionOnRecord", "[", 
    RowBox[{
    "\[Rho]0", ",", " ", "H0", ",", " ", "L0", ",", " ", "dt0", ",", " ", 
     "recordReplay"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "@", 
   RowBox[{"Flatten", "[", 
    RowBox[{"trajectoryReplay", " ", "-", " ", "filteredReplay"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[33]:= ",ExpressionUUID->"50b12ff8-e606-85f7-004e-c6a593b0efdd"],

Cell[BoxData["0.`"], "Output",
 CellLabel->
  "Out[33]= ",ExpressionUUID->"640f47a5-4648-c62d-0c35-5e0f73e2ad77"]
}, Open  ]],

Cell["\<\
The difference should be zero to machine precision. This is stronger than \
saying the two curves look similar: the filter and generator use the same \
increments and the same update.\
\>", "Text",ExpressionUUID->"63a48922-0fac-666c-115b-208caa594cb6"],

Cell[TextData[{
 "The definitions are list based, so a one-channel example should not be \
their only test. Generate a short record from simultaneous monitored ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "387a9e0d-0234-0e73-6819-1057b7c15559"],
 " and ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f64ca0d-9927-5f44-651b-ec5718d225ae"],
 " channels, replay both columns, and challenge the validator with malformed \
inputs:"
}], "Text",ExpressionUUID->"399d1ff3-4632-be92-6fa2-96bd73c404f8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"LTwo", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", "0.2", "]"}], " ", "X"}], ",", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", "0.3", "]"}], " ", "Z"}]}], "}"}]}], ";", " ", 
  RowBox[{"\[Eta]Two", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.7", ",", " ", "0.5"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"trajectoryTwo", ",", " ", 
     RowBox[{"{", "recordTwo", "}"}]}], "}"}], " ", "=", " ", 
   RowBox[{"BlockRandom", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "22", "]"}], ";", " ", 
     RowBox[{"Reap", "@", 
      RowBox[{"\[ScriptCapitalT]", "[", 
       RowBox[{"\[Rho]0", ",", " ", 
        RowBox[{"0.", " ", "X"}], ",", " ", "LTwo", ",", " ", "\[Eta]Two", ",",
         " ", "dt0", ",", " ", "0.2"}], "]"}]}]}], "\n", "   ", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"filteredTwo", " ", "=", " ", 
   RowBox[{"conditionOnRecord", "[", 
    RowBox[{"\[Rho]0", ",", " ", 
     RowBox[{"0.", " ", "X"}], ",", " ", "LTwo", ",", " ", "\[Eta]Two", ",", 
     " ", "dt0", ",", " ", "recordTwo"}], "]"}]}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<record dimensions\>\"", " ", "->", " ", 
    RowBox[{"Dimensions", "[", "recordTwo", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<two-channel replay error\>\"", " ", "->", " ", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "@", 
      RowBox[{"Flatten", "[", 
       RowBox[{"trajectoryTwo", " ", "-", " ", "filteredTwo"}], "]"}]}], 
     "]"}]}]}], "|>"}]}], "Input",
 CellLabel->
  "In[34]:= ",ExpressionUUID->"1170384d-2f38-2c50-470f-b2174acd76ba"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"record dimensions\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"20", ",", "2"}], "}"}]}], ",", 
   RowBox[{"\<\"two-channel replay error\"\>", "\[Rule]", "0.`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[34]= ",ExpressionUUID->"6ce33075-6d34-44a7-1490-aa3f04c12e8d"]
}, Open  ]],

Cell["\<\
As expected, the record has two columns and its replay error vanishes. Now \
challenge the validator with misaligned efficiencies, the wrong number of \
columns, a complex increment, and symbolic efficiencies:\
\>", "Text",ExpressionUUID->"54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<short efficiency list rejected\>\"", " ", "->", "\n", "    ", 
    
    RowBox[{"FailureQ", "@", 
     RowBox[{"conditionOnRecord", "[", 
      RowBox[{"\[Rho]0", ",", " ", 
       RowBox[{"0.", " ", "X"}], ",", " ", "LTwo", ",", " ", 
       RowBox[{"{", "0.7", "}"}], ",", " ", "dt0", ",", " ", "recordTwo"}], 
      "]"}]}]}], ",", "\n", "  ", 
   RowBox[{"\"\<one-column record rejected\>\"", " ", "->", "\n", "    ", 
    RowBox[{"FailureQ", "@", 
     RowBox[{"conditionOnRecord", "[", 
      RowBox[{"\[Rho]0", ",", " ", 
       RowBox[{"0.", " ", "X"}], ",", " ", "LTwo", ",", " ", "\[Eta]Two", ",",
        " ", "dt0", ",", " ", 
       RowBox[{"recordTwo", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], "]"}]}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<complex record rejected\>\"", " ", "->", " ", 
    RowBox[{"FailureQ", "@", 
     RowBox[{"conditionOnRecord", "[", "\n", "    ", 
      RowBox[{"\[Rho]0", ",", " ", 
       RowBox[{"0.", " ", "X"}], ",", " ", "LTwo", ",", " ", "\[Eta]Two", ",",
        " ", "dt0", ",", " ", 
       RowBox[{"ReplacePart", "[", 
        RowBox[{"recordTwo", ",", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}], " ", "->", " ", "I"}]}], 
        "]"}]}], "]"}]}]}], ",", "\n", "  ", 
   RowBox[{"\"\<symbolic efficiencies rejected\>\"", " ", "->", "\n", "    ", 
    
    RowBox[{"FailureQ", "@", 
     RowBox[{"conditionOnRecord", "[", 
      RowBox[{"\[Rho]0", ",", " ", 
       RowBox[{"0.", " ", "X"}], ",", " ", "LTwo", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Eta]x", ",", " ", "\[Eta]z"}], "}"}], ",", " ", "dt0", ",",
        " ", "recordTwo"}], "]"}]}]}]}], "|>"}]], "Input",
 CellLabel->
  "In[35]:= ",ExpressionUUID->"6334ac9c-43f1-85c0-12cb-45c67585ef2a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"short efficiency list rejected\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"one-column record rejected\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"complex record rejected\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"symbolic efficiencies rejected\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[35]= ",ExpressionUUID->"74397683-04f4-1d4d-1dc7-6fedac816797"]
}, Open  ]],

Cell[TextData[{
 "Alignment errors, complex increments, and symbolic efficiencies all return \
a ",
 Cell[BoxData["Failure"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "735e49d5-32a1-4a48-2166-609f47541892"],
 " instead of entering the numerical update."
}], "Text",ExpressionUUID->"335d55a2-cf9b-493d-6163-4c0fea2e1807"],

Cell["\<\
Now start the replay from a wrong prior. Inefficient detection keeps the true \
conditional state mixed, which makes trace distance a more informative \
comparison than raw overlap:\
\>", "Text",ExpressionUUID->"3bfbbd45-edb8-1b0b-6998-352e844d6651"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Eta]Wrong", " ", "=", " ", 
   RowBox[{"{", "0.6", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"trajectoryWrong", ",", " ", 
     RowBox[{"{", "recordWrong", "}"}]}], "}"}], " ", "=", " ", 
   RowBox[{"BlockRandom", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "21", "]"}], ";", " ", 
     RowBox[{"Reap", "@", 
      RowBox[{"\[ScriptCapitalT]", "[", 
       RowBox[{
       "\[Rho]0", ",", " ", "H0", ",", " ", "L0", ",", " ", "\[Eta]Wrong", ",",
         " ", "dt0", ",", " ", "10."}], "]"}]}]}], "\n", "   ", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"filteredWrong", " ", "=", " ", 
   RowBox[{"conditionOnRecord", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], "/", "2"}], ",", " ", "H0", ",",
      " ", "L0", ",", " ", "\[Eta]Wrong", ",", " ", "dt0", ",", " ", 
     "recordWrong"}], "\n", "   ", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[36]:= ",ExpressionUUID->"045023ab-c37d-b770-2c6f-baf4f6091a5a"],

Cell["Compute the trace distance at every step:", "Text",ExpressionUUID->"73e8aeff-5b91-f8f4-2197-47b95e25cade"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"traceDistances", " ", "=", " ", 
   RowBox[{"MapThread", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"Abs", "@", 
         RowBox[{"Eigenvalues", "[", 
          RowBox[{"#1", " ", "-", " ", "#2"}], "]"}]}], "]"}], "/", "2"}], 
      " ", "&"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"trajectoryWrong", ",", " ", "filteredWrong"}], "}"}]}], "\n", 
    "   ", "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"dt0", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{
          RowBox[{"Length", "[", "traceDistances", "]"}], " ", "-", " ", 
          "1"}]}], "]"}]}], ",", " ", "traceDistances"}], "}"}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "All"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<trace distance\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<The record progressively erases a wrong prior\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[37]:= ",ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"],

