Cell[26941, 691, 214, 3, 70, "Text",ExpressionUUID->"5b82e386-6ff5-c0ee-09b1-fae009819234"],
Cell[27158, 696, 143, 2, 70, "Text",ExpressionUUID->"34a39a2f-b372-ffce-5c50-1388c604c514"],
Cell[27304, 700, 571, 14, 70, "Input",ExpressionUUID->"66ca9132-7812-8248-0ec9-097c79a4d092"],
Cell[27878, 716, 176, 3, 70, "Text",ExpressionUUID->"023b1c4a-5b09-a8c9-33d8-96145ebdfa13"],
Cell[28057, 721, 377, 10, 70, "Input",ExpressionUUID->"29a4f364-fd74-7ca4-5f5b-eb41f401468e"],
