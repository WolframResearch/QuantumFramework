Cell["\<\
For an observable and stable filter, the distance tends to shrink as the \
shared record accumulates. It need not decrease at every individual step, and \
not every measurement model identifies every component of the state. Prior \
forgetting is a property to test for the chosen dynamics, not a universal \
monotonicity theorem.\
\>", "Text",ExpressionUUID->"167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],

Cell["\<\
Check Hermiticity, unit trace, and positivity together over the generated and \
reconstructed states:\
\>", "Text",ExpressionUUID->"15eb24b6-b946-3a65-43e8-bdf038f0894f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{
    "trajectoryReplay", ",", " ", "filteredReplay", ",", " ", "trajectoryTwo",
      ",", " ", "filteredTwo", ",", "\n", "  ", "trajectoryWrong", ",", " ", 
     "filteredWrong"}], "]"}], ",", " ", "densityOperatorQ"}], "]"}]], "Input",\

 CellLabel->
  "In[38]:= ",ExpressionUUID->"27d2a24c-1e84-19ee-4de1-44169b316b34"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[38]= ",ExpressionUUID->"285985c7-a1c8-13eb-5866-1ca0d07d6131"]
}, Open  ]],

Cell["Part V: Estimate a Parameter from the Innovations", "Section",ExpressionUUID->"57868ed1-450c-c474-7dbd-279b6cbeaf5e"],

Cell["\<\
A candidate model predicts a conditional mean for each next increment. For \
independent homodyne channels,\
\>", "Text",ExpressionUUID->"0c5e608e-35dc-f74f-3466-79e8bc6edd95"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["y", "TI"], 
     StyleBox["n", "TI"]], "\[VerticalSeparator]", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["n", "TI"]], "\[Tilde]", "\|01d4a9", "\[NegativeThinSpace]", "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Mu]", "TI"], 
      StyleBox["n", "TI"]], ",", 
     RowBox[{
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"], " ", 
      StyleBox["I", "TI"]}]}], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      SubscriptBox[
       StyleBox["\[Mu]", "TI"], 
       StyleBox["n", "TI"]], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     StyleBox["r", "TI"]], "=", 
    RowBox[{
     SqrtBox[
      SubscriptBox[
       StyleBox["\[Eta]", "TI"], 
       StyleBox["r", "TI"]]], " ", 
     RowBox[{
      StyleBox["Tr",
       FontSlant->"Plain"], 
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         StyleBox["L", "TI"], 
         StyleBox["r", "TI"]], "+", 
        SubsuperscriptBox[
         StyleBox["L", "TI"], 
         StyleBox["r", "TI"], "\[Dagger]"]}], 
       StyleBox[")",
        SpanMaxSize->1], 
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], 
        StyleBox["n", "TI"]]}], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     StyleBox["d", "TI"], 
     RowBox[{
      StyleBox["t", "TI"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"1a1e4090-3303-05ed-4a26-59da46b66f37"],

Cell[TextData[{
 "The difference ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["y", "TI"], 
    StyleBox["n", "TI"]], "-", 
   SubscriptBox[
    StyleBox["\[Mu]", "TI"], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10256af3-3972-af7a-41da-83bdb804f240"],
 " is the innovation. A good candidate makes the observed innovations \
probable; a poor candidate leaves structured residuals."
}], "Text",ExpressionUUID->"457602f1-d86e-ac86-730d-9bbad918f6ec"],

Cell["\<\
In other words, parameter estimation is repeated filtering plus a built-in \
Gaussian log likelihood.\
\>", "Text",ExpressionUUID->"499f95c1-a958-6c18-7fa4-0caac8ed3762"],

Cell["\<\
Define the record likelihood for any number of independent monitored channels:\
\>", "Text",ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "recordLogLikelihood", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"recordLogLikelihood", "[", 
    RowBox[{
    "\[Rho]0_", ",", " ", "H_", ",", " ", "Ls_", ",", " ", "\[Eta]_List", ",",
      " ", "V_", ",", " ", "dt_", ",", " ", "record_"}], "]"}], " ", ":=", 
   "\n", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "trajectory", ",", " ", "means", ",", " ", "observations", ",", " ", 
       "innovations"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"trajectory", " ", "=", " ", 
       RowBox[{"conditionOnRecord", "[", 
        RowBox[{
        "\[Rho]0", ",", " ", "H", ",", " ", "Ls", ",", " ", "\[Eta]", ",", 
         " ", "V", ",", " ", "dt", ",", " ", "record"}], "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{"means", " ", "=", " ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"\[Rho]", ",", "\n", "      ", 
          RowBox[{"MapThread", "[", "\n", "       ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Sqrt", "[", "#2", "]"}], " ", 
              RowBox[{"Re", "@", 
               RowBox[{"Tr", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"#1", " ", "+", " ", 
                   RowBox[{"ConjugateTranspose", "[", "#1", "]"}]}], ")"}], 
                 " ", ".", " ", "\[Rho]"}], "]"}]}], " ", "dt"}], " ", "&"}], 
            ",", "\n", "       ", 
            RowBox[{"{", 
             RowBox[{"Ls", ",", " ", "\[Eta]"}], "}"}]}], "\n", "       ", 
           "]"}]}], "\n", "      ", "]"}], " ", "/@", " ", 
        RowBox[{"Most", "[", "trajectory", "]"}]}]}], ";", "\n", "  ", 
      RowBox[{"observations", " ", "=", " ", 
       RowBox[{"Re", "@", 
        RowBox[{"N", "[", "record", "]"}]}]}], ";", "\n", "  ", 
      RowBox[{"innovations", " ", "=", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"observations", " ", "-", " ", "means"}], "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{"LogLikelihood", "[", 
       RowBox[{
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"Sqrt", "[", "dt", "]"}]}], "]"}], ",", " ", 
        "innovations"}], "]"}]}]}], "\n", "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[39]:= ",ExpressionUUID->"0c02104f-9807-e6c4-3431-8a2919b3cc2e"],

Cell["\<\
The flattening step must preserve channel alignment. Reuse the two-channel \
record to compute its innovation matrix explicitly:\
\>", "Text",ExpressionUUID->"6f909018-5ea1-6a32-15af-0a425b543918"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"twoChannelMeans", " ", "=", " ", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"\[Rho]", ",", "\n", "     ", 
      RowBox[{"MapThread", "[", "\n", "      ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", "#2", "]"}], " ", 
          RowBox[{"Re", "@", 
           RowBox[{"Tr", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#1", " ", "+", " ", 
               RowBox[{"ConjugateTranspose", "[", "#1", "]"}]}], ")"}], " ", ".",
              " ", "\[Rho]"}], "]"}]}], " ", "dt0"}], " ", "&"}], ",", "\n", 
        "      ", 
        RowBox[{"{", 
         RowBox[{"LTwo", ",", " ", "\[Eta]Two"}], "}"}]}], "]"}]}], "\n", 
     "     ", "]"}], " ", "/@", " ", 
    RowBox[{"Most", "[", "filteredTwo", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"twoChannelInnovations", " ", "=", " ", 
   RowBox[{
    RowBox[{"Re", "@", "recordTwo"}], " ", "-", " ", "twoChannelMeans"}]}], 
  ";"}], "\n", 
 RowBox[{"Dimensions", "[", "twoChannelInnovations", "]"}]}], "Input",
 CellLabel->
  "In[40]:= ",ExpressionUUID->"2f4595f3-090a-1216-557a-0cbda8bf617c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"20", ",", "2"}], "}"}]], "Output",
 CellLabel->
  "Out[40]= ",ExpressionUUID->"06385f5e-e9d4-4e6c-2fd8-571b886114b6"]
}, Open  ]],

Cell["\<\
Now verify that the multichannel function equals the explicit sum of the \
scalar Gaussian log densities:\
\>", "Text",ExpressionUUID->"25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"twoChannelLikelihood", " ", "=", " ", 
   RowBox[{"recordLogLikelihood", "[", "\n", "   ", 
    RowBox[{"\[Rho]0", ",", " ", 
     RowBox[{"0.", " ", "X"}], ",", " ", "LTwo", ",", " ", "\[Eta]Two", ",", 
     " ", "None", ",", " ", "dt0", ",", " ", "recordTwo"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"explicitTwoChannelLikelihood", " ", "=", " ", 
   RowBox[{"Total", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"Sqrt", "[", "dt0", "]"}]}], "]"}], ",", " ", "#"}], "]"}],
        "]"}], " ", "&"}], " ", "/@", "\n", "    ", 
     RowBox[{"Flatten", "[", "twoChannelInnovations", "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Abs", "[", 
   RowBox[{
   "twoChannelLikelihood", " ", "-", " ", "explicitTwoChannelLikelihood"}], 
   "]"}], " ", "<", " ", 
  RowBox[{"10", "^", 
   RowBox[{"-", "10"}]}]}]}], "Input",
 CellLabel->
  "In[41]:= ",ExpressionUUID->"3b9a140e-d97a-4136-69b9-8e6bd80f101c"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[41]= ",ExpressionUUID->"4f9438da-b80f-a114-75ab-b18439bbf07e"]
}, Open  ]],

Cell["\<\
Generate a finite record at a known drive. Keep the record much shorter than \
the spectral example so that the finite-data uncertainty remains visible:\
\>", "Text",ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalOmega]True", " ", "=", " ", "1.7"}], ";", " ", 
  RowBox[{"\[Gamma]Estimate", " ", "=", " ", "0.8"}], ";", " ", 
  RowBox[{"\[Eta]Estimate", " ", "=", " ", 
   RowBox[{"{", "0.7", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"HEstimate", " ", "=", " ", 
   RowBox[{"\[CapitalOmega]True", " ", "X"}]}], ";", " ", 
  RowBox[{"LEstimate", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sqrt", "[", "\[Gamma]Estimate", "]"}], " ", "Jminus"}], "}"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"recordEstimate", " ", "=", " ", 
   RowBox[{
    RowBox[{"BlockRandom", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "31", "]"}], ";", "\n", "   ", 
      RowBox[{"Reap", "@", 
       RowBox[{"\[ScriptCapitalT]", "[", 
        RowBox[{
        "\[Rho]0", ",", " ", "HEstimate", ",", " ", "LEstimate", ",", " ", 
         "\[Eta]Estimate", ",", " ", "dt0", ",", " ", "60."}], "]"}]}]}], 
     "\n", "   ", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[42]:= ",ExpressionUUID->"3c8746fc-db76-c487-64bd-5fb9de00aeed"],

Cell["\<\
Scan candidate drives. A grid makes the entire likelihood landscape visible, \
including secondary structure or a boundary maximum that a single optimizer \
call could hide:\
\>", "Text",ExpressionUUID->"11f0f87a-e6f0-91cd-478f-f227928ae317"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalOmega]Candidates", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"1.2", ",", " ", "2.2", ",", " ", "0.1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"logLikelihoodFull", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"recordLogLikelihood", "[", "\n", "      ", 
      RowBox[{"\[Rho]0", ",", " ", 
       RowBox[{"#", " ", "X"}], ",", " ", "LEstimate", ",", " ", 
       "\[Eta]Estimate", ",", " ", "None", ",", " ", "dt0", ",", " ", 
       "recordEstimate"}], "\n", "      ", "]"}], " ", "&"}], " ", "/@", " ", 
    "\[CapitalOmega]Candidates"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"relativeFull", " ", "=", " ", 
   RowBox[{"logLikelihoodFull", " ", "-", " ", 
    RowBox[{"Max", "[", "logLikelihoodFull", "]"}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[43]:= ",ExpressionUUID->"473164ce-b547-c1f4-6ecf-7da83cf393de"],

Cell["Compare the full record with its first third:", "Text",ExpressionUUID->"12c4fc3b-e00c-2bba-42fb-f66491b97980"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"shortRecord", " ", "=", " ", 
   RowBox[{"Take", "[", 
    RowBox[{"recordEstimate", ",", " ", 
     RowBox[{"Floor", "[", 
      RowBox[{
       RowBox[{"Length", "[", "recordEstimate", "]"}], "/", "3"}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"logLikelihoodShort", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"recordLogLikelihood", "[", "\n", "      ", 
      RowBox[{"\[Rho]0", ",", " ", 
       RowBox[{"#", " ", "X"}], ",", " ", "LEstimate", ",", " ", 
       "\[Eta]Estimate", ",", " ", "None", ",", " ", "dt0", ",", " ", 
       "shortRecord"}], "\n", "      ", "]"}], " ", "&"}], " ", "/@", " ", 
    "\[CapitalOmega]Candidates"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"relativeShort", " ", "=", " ", 
   RowBox[{"logLikelihoodShort", " ", "-", " ", 
    RowBox[{"Max", "[", "logLikelihoodShort", "]"}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[44]:= ",ExpressionUUID->"1d7e6892-18cd-6f45-4b05-81dc997835af"],

Cell["Plot both profiles and mark the generating value:", "Text",ExpressionUUID->"325c8f47-cd85-89da-6263-2720e431db20"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"\[CapitalOmega]Candidates", ",", " ", "relativeShort"}], 
       "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"\[CapitalOmega]Candidates", ",", " ", "relativeFull"}], "}"}],
       "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"StandardOrange", ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "StandardBlue"}], "]"}]}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<first third\>\"", ",", " ", "\"\<full record\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "\[CapitalOmega]True", "}"}], ",", " ", "None"}], "}"}]}], 
   ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<candidate drive \[CapitalOmega]\>\"", ",", 
      " ", "\"\<relative log likelihood\>\""}], "}"}]}], ",", "\n", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<More record sharpens the likelihood\>\""}]}], "]"}]], "Input",
 CellLabel->
  "In[45]:= ",ExpressionUUID->"43fcea2e-12ab-c026-7183-0388a75f930c"],

