Cell["\<\
One raw bin is a poor frequency estimator for a broad noisy line. Instead, \
subtract the calibrated unit floor, clip negative finite-sample fluctuations \
to zero, and compute the excess-power centroid inside a search band chosen \
before looking at the noise outside it. The estimator must also handle a \
record with no power above the floor:\
\>", "Text",ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "excessPowerCentroid", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"excessPowerCentroid", "[", 
    RowBox[{"spectrum_List", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Omega]min_", ",", " ", "\[Omega]max_"}], "}"}], ",", " ", 
     RowBox[{"floor_", ":", " ", "1"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"band", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"spectrum", ",", " ", 
          RowBox[{
           RowBox[{"\[Omega]min", " ", "<", " ", 
            RowBox[{"First", "[", "#", "]"}], " ", "<", " ", "\[Omega]max"}], 
           " ", "&"}]}], "]"}]}], ",", " ", "weights"}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"band", " ", "===", " ", 
         RowBox[{"{", "}"}]}], ",", "\n", "   ", 
        RowBox[{"Return", "[", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<NoSpectralFeature\>\"", ",", "\n", "     ", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<MessageTemplate\>\"", " ", "->", 
             " ", "\"\<The selected band is empty.\>\""}], "|>"}]}], "]"}], 
         "]"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"weights", " ", "=", " ", 
       RowBox[{"Clip", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"band", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
          "floor"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "Infinity"}], "}"}]}], "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", "weights", "]"}], " ", ">", " ", "0"}], ",", 
        "\n", "   ", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"band", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], " ", "weights"}], 
          "]"}], "/", 
         RowBox[{"Total", "[", "weights", "]"}]}], ",", "\n", "   ", 
        RowBox[{"Failure", "[", 
         RowBox[{"\"\<NoSpectralFeature\>\"", ",", "\n", "    ", 
          RowBox[{"<|", 
           
           RowBox[{"\"\<MessageTemplate\>\"", " ", "->", 
            " ", "\"\<The selected band has no power above the floor.\>\""}], 
           "|>"}]}], "]"}]}], "\n", "   ", "]"}]}]}], "\n", "  ", "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"],

Cell["\<\
Apply the guarded estimator to the record and verify its no-feature boundary:\
\
\>", "Text",ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"featureFrequency", " ", "=", " ", 
   RowBox[{"excessPowerCentroid", "[", 
    RowBox[{"spectrum0", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<excess-power centroid\>\"", " ", "->", " ", 
    "featureFrequency"}], ",", "\n", "  ", 
   RowBox[{"\"\<drive parameter\>\"", " ", "->", " ", "\[CapitalOmega]0"}], ",",
    "\n", "  ", 
   RowBox[{"\"\<Fourier-bin width\>\"", " ", "->", " ", 
    RowBox[{"2", " ", 
     RowBox[{"Pi", "/", 
      RowBox[{"(", 
       RowBox[{"nFourier", " ", "dt0"}], ")"}]}]}]}], ",", "\n", "  ", 
   RowBox[{"\"\<flat unit spectrum rejected\>\"", " ", "->", "\n", "    ", 
    RowBox[{"FailureQ", "@", 
     RowBox[{"excessPowerCentroid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2.5", ",", " ", "1."}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"3.5", ",", " ", "1."}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "5"}], "}"}]}], "]"}]}]}]}], "|>"}]}], "Input",\

 CellLabel->
  "In[19]:= ",ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"excess-power centroid\"\>", "\[Rule]", 
    "3.3833897377177298`"}], ",", 
   RowBox[{"\<\"drive parameter\"\>", "\[Rule]", "3.5`"}], ",", 
   RowBox[{"\<\"Fourier-bin width\"\>", "\[Rule]", "0.07669903939428206`"}], ",", 
   RowBox[{"\<\"flat unit spectrum rejected\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[19]= ",ExpressionUUID->"51fce014-dca1-0630-0783-fa51d5546d1a"]
}, Open  ]],

Cell["\<\
As one can see, the centroid locates the coherent oscillation scale without \
pretending that one upward noise fluctuation is the line center. Its \
uncertainty is limited by record length, linewidth, band choice, and the \
estimator itself. It would be too strong to say that this one number gives \
the Hamiltonian exactly, or that the full width is always equal to the bare \
emission rate.\
\>", "Text",ExpressionUUID->"657c1c65-980e-511d-1303-964f19bb2067"],

Cell["\<\
The Deterministic Reference: Use the Companion's LindbladSolve\
\>", "Subsection",ExpressionUUID->"0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],

Cell[TextData[{
 "The record spectrum reveals an oscillation scale in noisy detector data. An \
independent check should use the same Hamiltonian and collapse operator \
without reusing the stochastic trajectory update. The companion chapter \
already chose ",
 Cell[BoxData[
  RowBox[{"ResourceFunction", "[", "\"\<LindbladSolve\>\"", "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9b7e66-629a-1114-26b9-7040172f607e"],
 " for exactly this job."
}], "Text",ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"],

Cell["\<\
Solve the unconditional master equation over a short transient:\
\>", "Text",ExpressionUUID->"1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lindblad0", " ", "=", " ", 
   RowBox[{
    RowBox[{"ResourceFunction", "[", "\"\<LindbladSolve\>\"", "]"}], "[", 
    "\n", "    ", 
    RowBox[{"H0", ",", " ", "L0", ",", " ", "\[Rho]0", ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "6."}], "}"}]}], "\n", "    ", 
    "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"370294fd-9e49-2d35-5d31-0da71bfc741f"],

Cell[TextData[{
 "Sample the deterministic ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2845529c-454d-b13b-587b-4bc66cf90001"],
 " expectation on the same time step as the record:"
}], "Text",ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lindbladTimes", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0.", ",", " ", "6.", ",", " ", "dt0"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lindbladX", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"blochVector", "[", 
       RowBox[{"lindblad0", "[", "#", "]"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "lindbladTimes"}]}], ";"}]}], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell["Plot the transient before reducing it to one number:", "Text",ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"],

