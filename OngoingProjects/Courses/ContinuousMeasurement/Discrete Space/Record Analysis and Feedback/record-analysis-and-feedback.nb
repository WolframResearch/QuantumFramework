Cell["\<\
As one can see, the full-record profile is narrower around its maximum than \
the first-third profile. The longer record therefore discriminates nearby \
drive values more strongly.\
\>", "Text",ExpressionUUID->"5add4728-e92e-eff1-0ae3-5f7588d8b5db"],

Cell["Read off the grid maximum only after seeing the profile:", "Text",ExpressionUUID->"621761a3-d300-b412-122d-780ce6ba1f78"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalOmega]Estimate", " ", "=", " ", 
   RowBox[{"First", "@", 
    RowBox[{"First", "@", 
     RowBox[{"MaximalBy", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"\[CapitalOmega]Candidates", ",", " ", "logLikelihoodFull"}],
          "}"}], "]"}], ",", " ", "Last"}], "\n", "    ", "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<estimate\>\"", " ", "->", " ", "\[CapitalOmega]Estimate"}], ",",
    " ", 
   RowBox[{"\"\<generating value\>\"", " ", "->", " ", 
    "\[CapitalOmega]True"}]}], "|>"}]}], "Input",
 CellLabel->
  "In[46]:= ",ExpressionUUID->"5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"estimate\"\>", "\[Rule]", "1.7`"}], ",", 
   RowBox[{"\<\"generating value\"\>", "\[Rule]", "1.7`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[46]= ",ExpressionUUID->"7d3ffb2e-09a8-fc78-24c4-f288a842c742"]
}, Open  ]],

Cell[TextData[{
 "The word ",
 StyleBox["sharper", "TI"],
 " should also name a computed criterion. Use the centered second difference \
at each profile maximum: a more negative value means greater local curvature \
on this common grid:"
}], "Text",ExpressionUUID->"4139b36b-52b1-2977-70c6-2b356744785d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "peakCurvature", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"peakCurvature", "[", "values_List", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", " ", "=", " ", 
       RowBox[{"First", "@", 
        RowBox[{"Ordering", "[", 
         RowBox[{"values", ",", " ", 
          RowBox[{"-", "1"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"1", " ", "<", " ", "i", " ", "<", " ", 
        RowBox[{"Length", "[", "values", "]"}]}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"values", "[", 
         RowBox[{"[", 
          RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
        RowBox[{"2", " ", 
         RowBox[{"values", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], " ", "+", " ", 
        RowBox[{"values", "[", 
         RowBox[{"[", 
          RowBox[{"i", " ", "-", " ", "1"}], "]"}], "]"}]}], ",", " ", 
       "Indeterminate"}], "]"}]}], "\n", "  ", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"profileCurvatures", " ", "=", " ", 
   RowBox[{"peakCurvature", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"relativeShort", ",", " ", "relativeFull"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<first-third curvature\>\"", " ", "->", " ", 
    RowBox[{"First", "[", "profileCurvatures", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<full-record curvature\>\"", " ", "->", " ", 
    RowBox[{"Last", "[", "profileCurvatures", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<full record is sharper\>\"", " ", "->", "\n", "    ", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Last", "[", "profileCurvatures", "]"}], "]"}], " ", ">", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{"First", "[", "profileCurvatures", "]"}], "]"}]}]}]}], 
  "|>"}]}], "Input",
 CellLabel->
  "In[47]:= ",ExpressionUUID->"494d6e39-7750-b6eb-7f72-806302ea1c31"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"first-third curvature\"\>", "\[Rule]", 
    RowBox[{"-", "0.08496869841269472`"}]}], ",", 
   RowBox[{"\<\"full-record curvature\"\>", "\[Rule]", 
    RowBox[{"-", "0.31645213479623635`"}]}], ",", 
   RowBox[{"\<\"full record is sharper\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[47]= ",ExpressionUUID->"39b01e29-d171-5c92-6f4f-9072e00426f8"]
}, Open  ]],

Cell["\<\
A finite record can move the maximum away from the generating value. That is \
sampling uncertainty, not automatically a coding error. A serious inference \
should also refine the grid, examine the innovations, and report an interval \
from likelihood curvature, bootstrap records, or Fisher information rather \
than only the maximizing number.\
\>", "Text",ExpressionUUID->"4f6d713e-2461-11c8-7513-69784d146312"],

Cell["\<\
Before we move on, let us summarize the most important points we have learned \
so far:\
\>", "Text",ExpressionUUID->"14ad582f-66ff-93eb-3c53-5189128be131"],

Cell[TextData[{
 Cell[BoxData["makeConditionedStep"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f7ea056-2d28-85ec-7505-3a1044c2ef36"],
 " contains the same ",
 Cell[BoxData["s"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b00368-b832-202d-3e4f-9b3239c77377"],
 ", ",
 Cell[BoxData["m"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06d00634-a672-f252-2eef-9871d304c0b8"],
 ", and ",
 Cell[BoxData["num"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],
 " update as ",
 Cell[BoxData["\|01d4af"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583a98af-415b-100e-09d9-110970ee6354"],
 ", with no new random draw."
}], "Item",ExpressionUUID->"07beae85-a317-6bf9-2d45-47eed6a239c3"],

Cell["\<\
Replaying one-channel and two-channel records from the same prior reproduces \
both original trajectories to machine precision.\
\>", "Item",ExpressionUUID->"503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],

Cell["\<\
A filter started from the maximally mixed prior approaches the reference \
conditional state for this observable example.\
\>", "Item",ExpressionUUID->"60049622-f570-0e0e-103b-0f8ffc055554"],

Cell[TextData[{
 "Each candidate drive produces a sequence of innovations ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["y", "TI"], 
    StyleBox["n", "TI"]], "-", 
   SubscriptBox[
    StyleBox["\[Mu]", "TI"], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40ea559d-da93-7842-70ea-4cc6df264aa8"],
 " with variance ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23ccc6ee-92c0-e596-51f3-dfc8277acffc"],
 "."
}], "Item",ExpressionUUID->"114d8d02-b276-9c05-4772-256fc700e76f"],

Cell["\<\
The two-channel likelihood equals the explicit sum of all per-channel \
Gaussian log densities.\
\>", "Item",ExpressionUUID->"2dc22b63-32d1-862f-5bf1-c34d4765ed75"],

Cell[TextData[{
 Cell[BoxData["LogLikelihood"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36ea7e2c-072a-2221-5eea-7076b2df710b"],
 " ranks those innovation sequences, and the full record gives a sharper \
profile than its first third."
}], "Item",ExpressionUUID->"5b23761c-2477-64e8-0ad1-68464d024e32"],

Cell["Part VI: Close the Loop with the Same Trajectory Map", "Section",ExpressionUUID->"73216bcf-7cf1-61ac-22de-82a9748433f6"],

Cell[TextData[{
 "For unit-efficiency Markovian feedback, let a Hermitian operator ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], 
   StyleBox["r", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],
 " multiply each measured current. During one step, the current produces the \
unitary kick"
}], "Text",ExpressionUUID->"409bca18-cbd6-e54d-70b8-ec45ee60cf97"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["U", "TI"], 
     RowBox[{
      StyleBox["fb",
       FontSlant->"Plain"], ",", 
      StyleBox["n", "TI"]}]], "=", 
    StyleBox["exp",
     FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", "[", 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     UnderscriptBox["\[Sum]", 
      StyleBox["r", "TI"],
      LimitsPositioning->False], 
     SubscriptBox[
      StyleBox["F", "TI"], 
      StyleBox["r", "TI"]], " ", 
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["y", "TI"], 
      RowBox[{
       StyleBox["r", "TI"], ",", 
       StyleBox["n", "TI"]}]]}], "]"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"10b62b5f-1d3f-f012-404d-c31994cbc378"],

Cell[TextData[{
 "The order matters. First ",
 Cell[BoxData["\|01d4af"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79984792-c453-565a-2fb8-5edfede63ca0"],
 " performs one measurement step and produces ",
 Cell[BoxData["dy"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d45428e-8fa1-6801-4b7b-5be82a543b6b"],
 "; then the record from that same step determines the unitary."
}], "Text",ExpressionUUID->"604bb87d-3174-a116-1048-32274006f07c"],

Cell[TextData[{
 "In other words, feedback can wrap ",
 Cell[BoxData["\|01d4af"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "763191a2-6f8b-197a-1fce-080c0a3e6840"],
 " one step at a time without introducing another SME implementation. One \
Hermitian feedback operator is required for each monitored channel; otherwise \
the proposed kick is not the unitary controller just described."
}], "Text",ExpressionUUID->"635fdfdb-2856-deda-1164-d68549e0a420"],

Cell["\<\
Check that physical input condition before building the wrapper:\
\>", "Text",ExpressionUUID->"0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "validFeedbackOperatorsQ", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"validFeedbackOperatorsQ", "[", 
    RowBox[{
     RowBox[{"\[Rho]0_", "?", "MatrixQ"}], ",", " ", 
     RowBox[{"H_", "?", "MatrixQ"}], ",", " ", "Ls_List", ",", " ", 
     "Fs_List"}], "]"}], " ", ":=", "\n", " ", 
   RowBox[{
    RowBox[{"densityOperatorQ", "[", 
     RowBox[{"N", "[", "\[Rho]0", "]"}], "]"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"Dimensions", "[", "\[Rho]0", "]"}], " ", "==", " ", 
     RowBox[{"Dimensions", "[", "H", "]"}]}], " ", "&&", "\n", "  ", 
    RowBox[{
     RowBox[{"Length", "[", "Ls", "]"}], " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"Length", "[", "Ls", "]"}], " ", "==", " ", 
     RowBox[{"Length", "[", "Fs", "]"}]}], " ", "&&", " ", 
    RowBox[{"HermitianMatrixQ", "[", 
     RowBox[{"N", "[", "H", "]"}], "]"}], " ", "&&", "\n", "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"Fs", ",", " ", "HermitianMatrixQ"}], "]"}], " ", "&&", "\n", 
    "  ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{"Ls", ",", " ", "Fs"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"MatrixQ", "[", "#", "]"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"Dimensions", "[", "#", "]"}], " ", "==", " ", 
         RowBox[{"Dimensions", "[", "H", "]"}]}]}], " ", "&"}]}], "]"}]}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[48]:= ",ExpressionUUID->"5c8469dd-bfc7-2a7a-04bb-80873a727940"],

Cell["\<\
Test one physical controller and five invalid specifications:\
\>", "Text",ExpressionUUID->"182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<physical controller\>\"", " ", "->", " ", 
    RowBox[{"validFeedbackOperatorsQ", "[", 
     RowBox[{"\[Rho]0", ",", " ", 
      RowBox[{"0.", " ", "X"}], ",", " ", 
      RowBox[{"{", "Z", "}"}], ",", " ", 
      RowBox[{"{", "Y", "}"}]}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<non-Hermitian operator\>\"", " ", "->", " ", 
    RowBox[{"validFeedbackOperatorsQ", "[", 
     RowBox[{"\[Rho]0", ",", " ", 
      RowBox[{"0.", " ", "X"}], ",", " ", 
      RowBox[{"{", "Z", "}"}], ",", " ", 
      RowBox[{"{", "Jminus", "}"}]}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<wrong channel count\>\"", " ", "->", " ", 
    RowBox[{"validFeedbackOperatorsQ", "[", 
     RowBox[{"\[Rho]0", ",", " ", 
      RowBox[{"0.", " ", "X"}], ",", " ", 
      RowBox[{"{", "Z", "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"Y", ",", " ", "Y"}], "}"}]}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<empty channel list\>\"", " ", "->", " ", 
    RowBox[{"validFeedbackOperatorsQ", "[", 
     RowBox[{"\[Rho]0", ",", " ", 
      RowBox[{"0.", " ", "X"}], ",", " ", 
      RowBox[{"{", "}"}], ",", " ", 
      RowBox[{"{", "}"}]}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<wrong state dimension\>\"", " ", "->", "\n", "    ", 
    RowBox[{"validFeedbackOperatorsQ", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "3", "]"}], "/", "3"}], ",", " ", 
      RowBox[{"0.", " ", "X"}], ",", " ", 
      RowBox[{"{", "Z", "}"}], ",", " ", 
      RowBox[{"{", "Y", "}"}]}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<non-density initial matrix\>\"", " ", "->", "\n", "    ", 
    RowBox[{"validFeedbackOperatorsQ", "[", 
     RowBox[{
      RowBox[{"2", " ", "\[Rho]0"}], ",", " ", 
      RowBox[{"0.", " ", "X"}], ",", " ", 
      RowBox[{"{", "Z", "}"}], ",", " ", 
      RowBox[{"{", "Y", "}"}]}], "]"}]}]}], "|>"}]], "Input",
 CellLabel->
  "In[49]:= ",ExpressionUUID->"3921e4bb-f5e4-3596-68de-fde483969ffc"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"physical controller\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"non-Hermitian operator\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"wrong channel count\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"empty channel list\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"wrong state dimension\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"non-density initial matrix\"\>", "\[Rule]", "False"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[49]= ",ExpressionUUID->"13db9173-5387-1c16-41f8-093d6632677c"]
}, Open  ]],

Cell["\<\
The valid Hermitian controller passes. Non-Hermitian, misaligned, empty, \
wrong-dimension, and non-density specifications do not. Build the \
unit-efficiency wrapper only for a valid initial state, channel list, and \
operator list:\
\>", "Text",ExpressionUUID->"6804c0ab-fd16-b7db-183b-d9f4f4a01d21"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "feedbackTrajectory", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"feedbackTrajectory", "[", 
    RowBox[{
    "\[Rho]0_", ",", " ", "H_", ",", " ", "Ls_", ",", " ", "Fs_", ",", " ", 
     "dt_", ",", " ", "tf_"}], "]"}], " ", ":=", "\n", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", 
      RowBox[{
       RowBox[{"NumberQ", "[", 
        RowBox[{"N", "[", "dt", "]"}], "]"}], " ", "&&", " ", 
       RowBox[{"NumberQ", "[", 
        RowBox[{"N", "[", "tf", "]"}], "]"}], " ", "&&", " ", 
       RowBox[{"dt", " ", ">", " ", "0"}], " ", "&&", " ", 
       RowBox[{"tf", " ", ">=", " ", "0"}], " ", "&&", "\n", "    ", 
       RowBox[{"validFeedbackOperatorsQ", "[", 
        RowBox[{"\[Rho]0", ",", " ", "H", ",", " ", "Ls", ",", " ", "Fs"}], 
        "]"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "step", "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"step", "[", "\[Rho]_", "]"}], " ", ":=", " ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "measured", ",", " ", "oneRecord", ",", " ", "dy", ",", " ", 
             "u"}], "}"}], ",", "\n", "     ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"measured", ",", " ", 
               RowBox[{"{", "oneRecord", "}"}]}], "}"}], " ", "=", " ", 
             RowBox[{"Reap", "@", 
              RowBox[{"\[ScriptCapitalT]", "[", 
               RowBox[{
               "\[Rho]", ",", " ", "H", ",", " ", "Ls", ",", " ", "dt", ",", 
                " ", "dt"}], "]"}]}]}], ";", "\n", "     ", 
            RowBox[{"dy", " ", "=", " ", 
             RowBox[{"First", "[", "oneRecord", "]"}]}], ";", "\n", "     ", 
            RowBox[{"Sow", "[", "dy", "]"}], ";", "\n", "     ", 
            RowBox[{"u", " ", "=", " ", 
             RowBox[{"MatrixExp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", 
               RowBox[{"Total", "[", 
                RowBox[{"MapThread", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"#1", " ", "#2"}], " ", "&"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"dy", ",", " ", "Fs"}], "}"}]}], "]"}], "]"}]}], 
              "]"}]}], ";", "\n", "     ", 
            RowBox[{"u", " ", ".", " ", 
             RowBox[{"Last", "[", "measured", "]"}], " ", ".", " ", 
             RowBox[{"ConjugateTranspose", "[", "u", "]"}]}]}]}], "\n", 
          "     ", "]"}]}], ";", "\n", "   ", 
        RowBox[{"NestList", "[", 
         RowBox[{"step", ",", " ", 
          RowBox[{"N", "[", "\[Rho]0", "]"}], ",", " ", 
          RowBox[{"Floor", "[", 
           RowBox[{"tf", "/", "dt"}], "]"}]}], "]"}]}]}], "\n", "   ", "]"}], 
     ",", "\n", "  ", 
     RowBox[{"Failure", "[", 
      RowBox[{"\"\<InvalidFeedbackModel\>\"", ",", "\n", "   ", 
       RowBox[{"<|", 
        RowBox[{"\"\<MessageTemplate\>\"", " ", "->", 
         " ", "\"\<Use nonempty aligned channels and Hermitian feedback \
operators.\>\""}], "|>"}]}], "]"}]}], "\n", "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[50]:= ",ExpressionUUID->"77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],

Cell["\<\
Confirm that the wrapper itself returns a structured failure for the \
non-Hermitian controller:\
\>", "Text",ExpressionUUID->"4289b0c6-8043-1b93-72b6-29a031f669f9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FailureQ", "@", 
  RowBox[{"feedbackTrajectory", "[", 
   RowBox[{"\[Rho]0", ",", " ", 
    RowBox[{"0.", " ", "X"}], ",", " ", 
    RowBox[{"{", "Z", "}"}], ",", " ", 
    RowBox[{"{", "Jminus", "}"}], ",", " ", "dt0", ",", " ", "0.1"}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[51]:= ",ExpressionUUID->"070f3e08-556d-9d60-2d34-b0525c19e44a"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[51]= ",ExpressionUUID->"6d593b15-c37a-9c59-1b66-b35ef60ce6a3"]
}, Open  ]],

Cell[TextData[{
 "Choose a transparent control problem. Continuously measure ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4140e475-1e41-1f16-777f-fe3f9bf4627c"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], "=", 
   SqrtBox[
    StyleBox["k", "TI"]], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67f13035-938c-831a-0d8e-aa7f263eee60"],
 " and feed the record back through ",
 Cell[BoxData[
  RowBox[{
   StyleBox["F", "TI"], "=", 
   SqrtBox[
    StyleBox["k", "TI"]], 
   StyleBox["Y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b44e14-0404-e868-3e4c-605eadb6bab2"],
 ". In the continuous-time, zero-delay limit the ensemble master equation is"
}], "Text",ExpressionUUID->"70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["H", "TI"], "+", 
      FractionBox["1", "2"], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SuperscriptBox[
        StyleBox["c", "TI"], "\[Dagger]"], 
       StyleBox["F", "TI"], "+", 
       StyleBox["F", "TI"], 
       StyleBox["c", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["c", "TI"], "-", 
     StyleBox["i", "TI"], 
     StyleBox["F", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"7e10bd94-ae42-3b4d-262f-34d1cbf48997"],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["c", "TI"], "\[Dagger]"], 
   StyleBox["F", "TI"], "+", 
   StyleBox["F", "TI"], 
   StyleBox["c", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], "-", 
   StyleBox["i", "TI"], 
   StyleBox["F", "TI"], "=", 
   SqrtBox[
    StyleBox["k", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["Z", "TI"], "-", 
    StyleBox["i", "TI"], 
    StyleBox["Y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],
 " has the ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b734859-75e7-efa6-7901-62030393b58c"],
 " eigenstate of ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ae31c17-eefa-a706-7a90-96508a8c0a6c"],
 " as a dark state. The feedback should therefore stabilize ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"+", 
      StyleBox["x", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00844d77-2817-3ec6-30bc-653149a3842c"],
 " from an initially mixed state."
}], "Text",ExpressionUUID->"20b97f64-b973-0c8a-5047-774e380656d0"],

Cell["\<\
Verify both parts of that statement symbolically before choosing a numerical \
rate:\
\>", "Text",ExpressionUUID->"04469009-6b02-dcc3-2c7d-0a530eb4a629"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ketPlusX", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}], "/", 
    RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", "\n", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Kappa]", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{"Z", " ", "-", " ", 
          RowBox[{"I", " ", "Y"}]}], ")"}]}], ")"}], ".", "ketPlusX"}], " ", "==",
      " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}]}], " ", "&&", "\n", "  ", 
    RowBox[{
     RowBox[{"X", ".", "ketPlusX"}], " ", "==", " ", "ketPlusX"}]}], ",", 
   "\n", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"\[Kappa]", " ", ">", " ", "0"}]}]}], "]"}]}], "Input",
 CellLabel->
  "In[52]:= ",ExpressionUUID->"4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[52]= ",ExpressionUUID->"5547dfb6-0e84-e145-037c-d6f0ab36b3af"]
}, Open  ]],

Cell["Set the controller and run an ensemble:", "Text",ExpressionUUID->"12b61bfc-9cd7-eca9-424d-92a61563b6f3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kFeedback", " ", "=", " ", "0.8"}], ";", " ", 
  RowBox[{"dtFeedback", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"tfFeedback", " ", "=", " ", "2."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"HFeedback", " ", "=", " ", 
   RowBox[{"0.", " ", "X"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"LFeedback", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sqrt", "[", "kFeedback", "]"}], " ", "Z"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FFeedback", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sqrt", "[", "kFeedback", "]"}], " ", "Y"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]Mixed", " ", "=", " ", 
   RowBox[{
    RowBox[{"IdentityMatrix", "[", "2", "]"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ensembleFeedback", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "41", "]"}], ";", "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"feedbackTrajectory", "[", "\n", "     ", 
        RowBox[{
        "\[Rho]Mixed", ",", " ", "HFeedback", ",", " ", "LFeedback", ",", " ",
          "FFeedback", ",", " ", "dtFeedback", ",", " ", "tfFeedback"}], "\n",
         "     ", "]"}], ",", " ", 
       RowBox[{"{", "80", "}"}]}], "]"}]}], "\n", "   ", "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[53]:= ",ExpressionUUID->"451364b5-819d-fb99-7321-7dff3029c9e3"],

Cell[TextData[{
 "Build the independent deterministic reference with the same ",
 Cell[BoxData["LindbladSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13b49e24-0fb7-4441-414b-178eaa422eab"],
 " used in the companion chapter:"
}], "Text",ExpressionUUID->"445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cFeedback", " ", "=", " ", 
   RowBox[{"First", "[", "LFeedback", "]"}]}], ";", " ", 
  RowBox[{"fFeedback", " ", "=", " ", 
   RowBox[{"First", "[", "FFeedback", "]"}]}], ";"}], "\n", 
 RowBox[{"hWisemanMilburn", " ", "=", " ", "HFeedback"}], "\n", 
 RowBox[{"   ", 
  RowBox[{
   RowBox[{
    RowBox[{"+", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "cFeedback", "]"}], " ", ".", " ", 
        "fFeedback"}], " ", "+", " ", 
       RowBox[{"fFeedback", " ", ".", " ", "cFeedback"}]}], ")"}]}], "/", 
    "2"}], ";"}]}], "\n", 
 RowBox[{
  RowBox[{"jumpWisemanMilburn", " ", "=", " ", 
   RowBox[{"cFeedback", " ", "-", " ", 
    RowBox[{"I", " ", "fFeedback"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"referenceFeedback", " ", "=", " ", 
   RowBox[{
    RowBox[{"ResourceFunction", "[", "\"\<LindbladSolve\>\"", "]"}], "[", 
    "\n", "   ", 
    RowBox[{"hWisemanMilburn", ",", " ", 
     RowBox[{"{", "jumpWisemanMilburn", "}"}], ",", " ", "\[Rho]Mixed", ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "tfFeedback"}], "}"}]}], "\n", 
    "   ", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[54]:= ",ExpressionUUID->"089aa42d-ce49-3603-38b9-3e76ebfd9d69"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.`", ",", "0.`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.`", ",", "0.`"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[54]= ",ExpressionUUID->"48fccab3-b886-a0f7-7883-e3fd3930f2dd"]
}, Open  ]],

Cell["Compare the ensemble mean with the deterministic curve:", "Text",ExpressionUUID->"0cdaad60-2181-5e26-34f9-454a5034250c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"timeFeedback", " ", "=", " ", 
   RowBox[{"dtFeedback", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", 
      RowBox[{"Floor", "[", 
       RowBox[{"tfFeedback", "/", "dtFeedback"}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"meanFeedback", " ", "=", " ", 
   RowBox[{"Mean", "[", "ensembleFeedback", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xMeanFeedback", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"blochVector", "[", "#", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "meanFeedback"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xReferenceFeedback", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"blochVector", "[", 
       RowBox[{"referenceFeedback", "[", "#", "]"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "timeFeedback"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"timeFeedback", ",", " ", "xMeanFeedback"}], "}"}], "]"}], ",",
      "\n", "  ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"timeFeedback", ",", " ", "xReferenceFeedback"}], "}"}], 
      "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "StandardBlue"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Dashed", ",", " ", "StandardRed"}], "]"}]}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<trajectory ensemble\>\"", ",", 
      " ", "\"\<feedback master equation\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "0.05"}], ",", " ", "1.05"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<mean \:27e8X\:27e9\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<The measured current stabilizes the +X state\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[55]:= ",ExpressionUUID->"542cff75-84e0-b601-7dd3-f73f2c9a1d6b"],

