Cell[TextData[{
 "The local maxima are separated by one oscillation period. Use the built-in ",
 Cell[BoxData["FindPeaks"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539491e8-328f-8d7b-01ab-08b2473bd441"],
 " and convert the mean peak spacing to an angular frequency:"
}], "Text",ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lindbladPeakIndices", " ", "=", " ", 
   RowBox[{
    RowBox[{"FindPeaks", "[", "lindbladX", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lindbladPeakTimes", " ", "=", " ", 
   RowBox[{"lindbladTimes", "[", 
    RowBox[{"[", "lindbladPeakIndices", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lindbladFrequency", " ", "=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Pi", "/", 
     RowBox[{"Mean", "[", 
      RowBox[{"Differences", "[", "lindbladPeakTimes", "]"}], "]"}]}]}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"023f49e2-a747-9723-33c5-60cfd2f3fa09"],

Cell["\<\
Compare the noisy record estimate with the independent deterministic estimate:\
\>", "Text",ExpressionUUID->"21aa1c49-e16c-f406-57a9-9612901edf6c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<record excess-power centroid\>\"", " ", "->", " ", 
    "featureFrequency"}], ",", "\n", "  ", 
   RowBox[{"\"\<Lindblad peak-spacing frequency\>\"", " ", "->", " ", 
    "lindbladFrequency"}], ",", "\n", "  ", 
   RowBox[{"\"\<agreement within 0.5\>\"", " ", "->", " ", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"featureFrequency", " ", "-", " ", "lindbladFrequency"}], "]"}],
      " ", "<", " ", "0.5"}]}]}], "|>"}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"record excess-power centroid\"\>", "\[Rule]", 
    "3.3833897377177298`"}], ",", 
   RowBox[{"\<\"Lindblad peak-spacing frequency\"\>", "\[Rule]", 
    "3.490658503988659`"}], ",", 
   RowBox[{"\<\"agreement within 0.5\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[24]= ",ExpressionUUID->"12f3dbee-abc4-6375-4280-d2cbce714e5f"]
}, Open  ]],

Cell["\<\
As one can see, the two calculations locate the same dynamical scale. They do \
not compute the same object: one is a stationary detector-record spectrum, \
while the other is an unconditional transient. Agreement in frequency is \
therefore a consistency check, not a derivation of the full measured spectrum.\
\>", "Text",ExpressionUUID->"7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],

Cell["\<\
This distinction also prevents a common overstatement. The Mollow triplet is \
normally the spectrum of the emitted field's first-order correlation. A \
homodyne-current spectrum is quadrature resolved, so it should not be called \
a Mollow triplet without computing the appropriate field correlation and its \
weights.\
\>", "Text",ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"],

Cell["Nonstationary Records: When One Spectrum Is Not Enough", "Subsection",ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell["\<\
A periodogram averages over the whole record and therefore assumes that its \
statistics are approximately stationary. If a drive changes halfway through \
the experiment, the global spectrum mixes the two regimes.\
\>", "Text",ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell["\<\
In other words, ask a time-frequency question with a time-frequency function.\
\
\>", "Text",ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"],

Cell["\<\
Generate two consecutive record segments with different Rabi frequencies, \
carrying the final state of the first segment into the second:\
\>", "Text",ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"trajectorySlow", ",", " ", 
     RowBox[{"{", "recordSlow", "}"}]}], "}"}], " ", "=", " ", 
   RowBox[{"BlockRandom", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "11", "]"}], ";", " ", 
     RowBox[{"Reap", "@", 
      RowBox[{"\[ScriptCapitalT]", "[", 
       RowBox[{"\[Rho]0", ",", " ", 
        RowBox[{"2.0", " ", 
         RowBox[{"Y", "/", "2"}]}], ",", " ", "L0", ",", " ", "dt0", ",", " ",
         "250."}], "]"}]}]}], "\n", "   ", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"trajectoryFast", ",", " ", 
     RowBox[{"{", "recordFast", "}"}]}], "}"}], " ", "=", " ", 
   RowBox[{"BlockRandom", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "12", "]"}], ";", " ", 
     RowBox[{"Reap", "@", 
      RowBox[{"\[ScriptCapitalT]", "[", 
       RowBox[{
        RowBox[{"Last", "[", "trajectorySlow", "]"}], ",", " ", 
        RowBox[{"5.0", " ", 
         RowBox[{"Y", "/", "2"}]}], ",", " ", "L0", ",", " ", "dt0", ",", " ",
         "250."}], "]"}]}]}], "\n", "   ", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"switchedDy", " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Re", "@", 
      RowBox[{"recordSlow", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"Re", "@", 
      RowBox[{"recordFast", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell[TextData[{
 "Use ",
 Cell[BoxData["SpectrogramArray"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],
 " for the short-time Fourier transform, then average neighboring time \
windows to make a persistent line easier to distinguish from shot noise:"
}], "Text",ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nSTFT", " ", "=", " ", "2048"}], ";", " ", 
  RowBox[{"hop", " ", "=", " ", "256"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"stftPower", " ", "=", " ", 
   RowBox[{"MovingAverage", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"SpectrogramArray", "[", 
        RowBox[{
         RowBox[{"switchedDy", " ", "-", " ", 
          RowBox[{"Mean", "[", "switchedDy", "]"}]}], ",", " ", "nSTFT", ",", 
         " ", "hop", ",", " ", "HannWindow"}], "]"}], "]"}], "^", "2"}], ",", 
     "\n", "   ", "15"}], "\n", "   ", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"maxFrequencyBin", " ", "=", " ", 
   RowBox[{
    RowBox[{"Floor", "[", 
     RowBox[{"8", " ", "nSTFT", " ", 
      RowBox[{"dt0", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "Pi"}], ")"}]}]}], "]"}], " ", "+", " ", "1"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"52243646-2fbd-210e-03db-a8204a487054"],

Cell["Plot only the physical frequency band of interest:", "Text",ExpressionUUID->"1acd7f4d-3da3-7753-4af3-7717b4565db9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixPlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Transpose", "@", 
    RowBox[{"Log10", "[", 
     RowBox[{
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}], " ", "+", " ", 
      RowBox[{"stftPower", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", 
         RowBox[{"1", " ", ";;", " ", "maxFrequencyBin"}]}], "]"}], "]"}]}], 
     "]"}]}], ",", "\n", " ", 
   RowBox[{"DataRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{
         RowBox[{"Length", "[", "switchedDy", "]"}], " ", "dt0"}]}], "}"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "8"}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"DataReversed", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"ColorFunction", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Blend", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"StandardBlue", ",", " ", "StandardYellow"}], "}"}], ",", 
        " ", "#"}], "]"}], " ", "&"}], ")"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "560"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<angular frequency \[Omega]\>\""}],
      "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<The record's dominant frequency changes when the drive \
changes\>\""}]}], "]"}]], "Input",
 CellLabel->
  "In[27]:= ",ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a"],

