Cell[TextData[{
 "Both curves approach ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["X", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],
 ": the trajectory ensemble and the independent ",
 Cell[BoxData["LindbladSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],
 " reference agree that the feedback stabilizes the ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "333832e2-8bec-4128-62c7-abcc2d991072"],
 " state."
}], "Text",ExpressionUUID->"78cf51d6-d7cd-4672-28f5-4893e2782d58"],

Cell["\<\
The displayed difference contains both finite-step error and Monte Carlo \
error. Without rerunning the trajectories, compare the root-mean-square \
discrepancy for several nested ensemble sizes:\
\>", "Text",ExpressionUUID->"1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "feedbackRMS", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"feedbackRMS", "[", 
     RowBox[{"n_Integer", "?", "Positive"}], "]"}], " ", "/;", " ", 
    RowBox[{"n", " ", "<=", " ", 
     RowBox[{"Length", "[", "ensembleFeedback", "]"}]}]}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "xMean", "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"xMean", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"blochVector", "[", "#", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"Mean", "[", 
         RowBox[{"Take", "[", 
          RowBox[{"ensembleFeedback", ",", " ", "n"}], "]"}], "]"}]}]}], ";", 
      "\n", "  ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Mean", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"xMean", " ", "-", " ", "xReferenceFeedback"}], ")"}], "^", 
         "2"}], "]"}], "]"}]}]}], "\n", "  ", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ensembleCounts", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "5", ",", " ", "10", ",", " ", "20", ",", " ", "40", ",", " ", "60", ",", 
     " ", "80"}], "}"}]}], ";"}], "\n", 
 RowBox[{"AssociationThread", "[", 
  RowBox[{"ensembleCounts", ",", " ", 
   RowBox[{"feedbackRMS", " ", "/@", " ", "ensembleCounts"}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[56]:= ",ExpressionUUID->"710db4a8-d877-0db2-2732-2df5d9025798"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"5", "\[Rule]", "0.04386301299728129`"}], ",", 
   RowBox[{"10", "\[Rule]", "0.02585503685804116`"}], ",", 
   RowBox[{"20", "\[Rule]", "0.016809045872545263`"}], ",", 
   RowBox[{"40", "\[Rule]", "0.007911159475623524`"}], ",", 
   RowBox[{"60", "\[Rule]", "0.010273552818621657`"}], ",", 
   RowBox[{"80", "\[Rule]", "0.01703478180487527`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[56]= ",ExpressionUUID->"71e12f72-3ad4-a92f-279e-c73cbf66f875"]
}, Open  ]],

Cell[TextData[{
 "As one can see, the discrepancy initially falls and then fluctuates rather \
than decreasing monotonically for every nested subset. That is itself a \
useful Monte Carlo lesson: one seed is not a convergence proof. A production \
study should average the error over independent seeds and repeat the \
calculation for smaller values of ",
 Cell[BoxData["dtFeedback"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ea8612-dd18-b4f0-2ee9-185fd4921eda"],
 "."
}], "Text",ExpressionUUID->"0b02f270-2101-5c3d-3931-f43a50b42707"],

Cell["\<\
Finally check agreement at the combined discretization and Monte Carlo scale, \
and positivity of a representative conditioned run:\
\>", "Text",ExpressionUUID->"2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<maximum ensemble-reference difference\>\"", " ", "->", "\n", 
    "    ", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"xMeanFeedback", " ", "-", " ", "xReferenceFeedback"}], "]"}], 
     "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Monte Carlo scale\>\"", " ", "->", " ", 
    RowBox[{"1", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Length", "[", "ensembleFeedback", "]"}], "]"}]}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<maximum difference is below that scale\>\"", " ", "->", "\n", 
    "    ", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"xMeanFeedback", " ", "-", " ", "xReferenceFeedback"}], "]"}], 
      "]"}], " ", "<", "\n", "     ", 
     RowBox[{"1", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Length", "[", "ensembleFeedback", "]"}], "]"}]}]}]}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<representative run remains a density operator\>\"", " ", "->",
     "\n", "    ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"First", "[", "ensembleFeedback", "]"}], ",", " ", 
      "densityOperatorQ"}], "]"}]}]}], "|>"}]], "Input",
 CellLabel->
  "In[57]:= ",ExpressionUUID->"669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"maximum ensemble-reference difference\"\>", "\[Rule]", 
    "0.04077772755747128`"}], ",", 
   RowBox[{"\<\"Monte Carlo scale\"\>", "\[Rule]", 
    FractionBox["1", 
     RowBox[{"4", " ", 
      SqrtBox["5"]}]]}], ",", 
   RowBox[{"\<\"maximum difference is below that scale\"\>", "\[Rule]", 
    "True"}], ",", 
   RowBox[{"\<\"representative run remains a density operator\"\>", "\[Rule]",
     "True"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[57]= ",ExpressionUUID->"5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"]
}, Open  ]],

Cell["\<\
The unitary kick preserves positivity exactly. The numerical comparison above \
tests one finite step and one seeded ensemble; it is not a substitute for a \
full convergence scan. Finite delay, inefficient detection, filtering \
bandwidth, and actuator saturation require an enlarged control model; the \
unit-efficiency, zero-delay formula should not be used for them without \
modification.\
\>", "Text",ExpressionUUID->"66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],

Cell["Part VII: What the Record Does Not Give for Free", "Section",ExpressionUUID->"3e73fafe-05d0-7203-6600-f3b8ac654169"],

Cell["The calculations above support several sharp boundaries.", "Text",ExpressionUUID->"7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],

Cell["\<\
The lesson has deliberately covered distinct regimes rather than treating one \
seeded trajectory as universal:\
\>", "Text",ExpressionUUID->"12c044c4-b778-74e1-42f0-5da1c20d5ecb"],

Cell[BoxData[GridBox[{
   {Cell["Regime", "TableText",
     FontWeight->Bold,ExpressionUUID->"3d9aa029-60a8-273a-6bb9-3a7311428a00"],
     Cell["Evidence computed here", "TableText",
     FontWeight->Bold,ExpressionUUID->"64adc082-4122-deff-0c52-d9ec70d4a4c5"]},
   {Cell["General symbolic case", "TableText",ExpressionUUID->
     "7e451771-8a55-ceec-267a-8f3b2fe19436"], Cell[TextData[{
     "Fully symbolic stochastic paths are not meaningful because the detector \
record is a numerical random draw. The general list structure is still \
exercised by the two-channel replay, and the feedback dark-state identity \
retains symbolic ",
     Cell[BoxData[
      StyleBox["\[Kappa]", "TI"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4670f053-f537-0b3f-6e0f-ea1cfcc25605"],
     "."
    }], "TableText",ExpressionUUID->"330aabc0-bdd5-22a3-6109-42aa34607089"]},
   {Cell["Exactly solvable special case", "TableText",ExpressionUUID->
     "38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"], Cell[
    "The symbolic dark-state calculation proves $(c-iF)", "TableText",
     ExpressionUUID->"70d705b8-410a-1477-20ec-9ce270bf7f5d"]},
   {Cell["Limiting case", "TableText",ExpressionUUID->
     "737c509e-bc52-eefb-2104-49d835e4b4c1"], Cell["\<\
A pure Wiener record gives a unit spectral floor and a much smaller matched \
oscillatory score for the seeded comparison.\
\>", "TableText",ExpressionUUID->"01a44b6b-c85f-9e0e-375c-6334e9ebe554"]},
   {Cell["Numerical reference case", "TableText",ExpressionUUID->
     "10bcaec6-cc03-bcfd-4043-47a3e5b706c7"], Cell["\<\
Replay, likelihood recovery, spectrogram switching, and the feedback \
master-equation comparison provide independent numeric checks.\
\>", "TableText",ExpressionUUID->"25120901-cfbc-a8e6-5321-a16aea4efacc"]},
   {Cell["Failure or edge case", "TableText",ExpressionUUID->
     "3ee7491f-72c3-8814-669d-61590777db7e"], Cell["\<\
A band with no excess spectral power, misaligned records and efficiencies, \
complex records, symbolic efficiencies, invalid initial states, feedback \
lists, non-Hermitian controllers, and empty controllers are rejected; low \
periodogram bins, reversed-record filtering, and field-spectrum labels are \
ruled out as shortcuts.\
\>", "TableText",ExpressionUUID->"67860241-8011-89c8-0dbd-a42b31a5db12"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
  GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}},
  GridBoxItemSize->{"Columns" -> {
      Scaled[0.44], 
      Scaled[0.44]}, "Rows" -> {{Automatic}}},
  GridBoxSpacings->{"Columns" -> {{1.5}}, "Rows" -> {{0.8}}}]], "Text",Express\
ionUUID->"b3189bc9-f997-427d-88f5-3f5256bc138d"],

Cell[TextData[{
 "First, a low periodogram bin is not evidence of squeezing. A noisy \
periodogram fluctuates above and below its expectation even for vacuum noise. \
Squeezing requires a calibrated quadrature spectrum, uncertainty estimates, \
and a statistically significant band below the unit floor. Taking ",
 Cell[BoxData["Min"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1318f44b-7a0d-b86f-4127-ee157fb90ab5"],
 " of one realization is biased downward and cannot establish it."
}], "Text",ExpressionUUID->"221ecbfd-1ed7-d323-5225-e2a79b63be09"],

Cell[TextData[{
 "Second, a spectral peak is not automatically a Mollow triplet. The measured \
observable and its correlation function decide the weights. The unconditional \
",
 Cell[BoxData["LindbladSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f067a83-888f-4db3-653e-73ed293a1799"],
 " transient can confirm a shared dynamical frequency, but it does not \
determine the weights in a field spectrum."
}], "Text",ExpressionUUID->"287fc527-5526-9e30-5804-dc815cd0e51a"],

Cell[TextData[{
 "Third, filtering is not smoothing. ",
 Cell[BoxData["conditionOnRecord"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2207e002-80f7-0285-523c-fa6c308250ef"],
 " is causal: the state at step ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "440467ae-8db5-79b4-6c3c-7e0824404b9e"],
 " uses records only through step ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141585f4-d1c1-5bbd-3c2a-1cb1e0742987"],
 ". A genuine quantum smoother combines a forward conditional state with a \
backward effect or an equivalent past-quantum-state construction. Reversing \
the record through the forward filter is not that construction. In a \
linear-Gaussian limit, Wolfram Language's ",
 Cell[BoxData["KalmanEstimator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d27d006-86b8-9131-64dc-ca603332e01b"],
 " supplies the classical forward analogue, but a classical \
Rauch-Tung-Striebel example should be labeled as an analogy rather than as a \
quantum smoother."
}], "Text",ExpressionUUID->"3e44340b-ef5c-51d5-667b-ae548ae9233f"],

Cell["\<\
Fourth, feedback is a physical loop, not just a post-processing curve. Its \
delay, efficiency convention, and bandwidth enter the dynamics. The wrapper \
above states its regime explicitly: unit efficiency, negligible delay, one \
measurement step followed by one unitary kick.\
\>", "Text",ExpressionUUID->"321034f4-436e-dcec-622f-adbe7618a636"],

Cell["\<\
These boundaries are useful because they tell us what computation must come \
next. To claim squeezing, add statistical error bars or independent records. \
To identify a field spectrum, compute the correct two-time operator \
correlation. To smooth a quantum estimate, add the backward effect. To model \
an experiment's feedback, add its delay and efficiency.\
\>", "Text",ExpressionUUID->"1287d3f9-6500-de4e-42bc-caa30cbaa494"],

Cell["Where This Leaves Us (and What Comes Next)", "Section",ExpressionUUID->"3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],

Cell[TextData[{
 "We began with exactly the ",
 Cell[BoxData["\[ScriptCapitalR]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087f5f2f-6486-1b59-3805-56890d3369a3"],
 " and ",
 Cell[BoxData["\|01d4af"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],
 " of the companion chapter and did not create a competing trajectory \
implementation. From their ",
 Cell[BoxData["Sow"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],
 "ed increments we computed a correlation with ",
 Cell[BoxData["CorrelationFunction"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13ecd9ee-6506-67bb-4193-d0c80cb34d81"],
 ", a calibrated spectrum with ",
 Cell[BoxData["PeriodogramArray"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6724c974-bdf1-27a5-0edb-e13e3b858d8f"],
 " and ",
 Cell[BoxData["PowerSpectralDensity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b52875c-0948-9ae8-5961-1f06a8e2e832"],
 ", and a changing frequency with ",
 Cell[BoxData["SpectrogramArray"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53412643-5a68-df00-017e-b82d5f02a26a"],
 ". The companion's ",
 Cell[BoxData["LindbladSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "696f5b1d-d56b-3a26-1f15-5346dc1f890c"],
 " then supplied an independent unconditional transient with the same \
oscillation scale."
}], "Text",ExpressionUUID->"0eb02373-2484-618c-364f-bb3d4d3133d6"],

Cell[TextData[{
 "The same update then became a filter by replacing generated noise with an \
external record. A round trip proved that replaying a generated record \
reconstructs the generated trajectory. Built-in ",
 Cell[BoxData["LogLikelihood"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640353f1-ff8e-e9b3-0c31-4abafa38bb99"],
 " turned the filter's innovations into a parameter profile. Finally, \
wrapping one call to ",
 Cell[BoxData["\|01d4af"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37161f66-4600-a3a8-5d2d-974073baf1f2"],
 " per step closed a unit-efficiency feedback loop, and ",
 Cell[BoxData["LindbladSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e44757e-c407-f813-567c-6d3bedb3cb79"],
 " supplied the independent Wiseman-Milburn master-equation reference."
}], "Text",ExpressionUUID->"07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"],

Cell[TextData[{
 "The next useful extensions are now precise rather than aspirational: \
multichannel cross-spectra, likelihood-based joint estimation with \
uncertainty, a backward-effect quantum smoother, and delayed or inefficient \
feedback. Each begins from the same record contract. The detector produces ",
 Cell[BoxData["dy"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539b0e4e-9e5a-5525-01b8-a0281bef3c0f"],
 "; everything else is an inference or an action built from it."
}], "Text",ExpressionUUID->"1cd82739-42e3-b7ed-44e7-bf6376971d37"],

Cell["References and Acknowledgment", "Subsection",ExpressionUUID->"0971a20b-7913-467e-3f0e-445578a62d44"],

Cell[TextData[{
 "The positivity-preserving update is due to Rouchon and Ralph, ",
 ButtonBox["arXiv:1410.5345",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/1410.5345"], None}],
 ". The feedback limit follows Wiseman and Milburn's ",
 StyleBox["Quantum Measurement and Control", "TI"],
 ". The distinction between filtering and quantum smoothing follows the \
past-quantum-state and quantum-smoothing literature."
}], "Text",ExpressionUUID->"09df342d-d743-5809-3fe4-ae76e2f62b53"],

Cell[TextData[{
 "For the Wolfram Language analysis used here, see the documentation for ",
 ButtonBox["CorrelationFunction",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/CorrelationFunction.html"]\
, None}],
 ", ",
 ButtonBox["PeriodogramArray",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/PeriodogramArray.html"], 
    None}],
 ", ",
 ButtonBox["PowerSpectralDensity",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/PowerSpectralDensity.\
html"], None}],
 ", and ",
 ButtonBox["SpectrogramArray",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/SpectrogramArray.html"], 
    None}],
 ". The ",
 ButtonBox["Wolfram Community discussion on power spectral density",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/1260549"], None}],
 " is also a useful reminder to inspect intermediate outputs, supply an \
explicit sampling interval for continuous-time data, and use ",
 Cell[BoxData["CorrelationFunction"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"],
 " for temporal data rather than rebuilding these operations from scratch."
}], "Text",ExpressionUUID->"21fdaace-430e-f3f9-5782-43a876b8c1c3"]
},
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (February 17, 2026)",
