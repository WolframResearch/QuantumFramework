Cell[TextData[{
 "As expected, the estimated means stay compatible with the Lindblad value \
within the Monte-Carlo scatter while the spread descends from an inflated \
coarse value and flattens toward the native reference as ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],
 " shrinks. In the white-noise limit the affine drift fixes the mean exactly; \
at finite ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c6bfc6-0792-5005-77fd-36a0b227236f"],
 " any regularization bias in the mean sits below the Monte-Carlo scatter \
here, while the bias in the spread is large enough to watch converge out. Put \
the mean column in its own units, each row's distance from the exact Lindblad \
value in that row's standard error:"
}], "Text",ExpressionUUID->"62752e4e-571f-d961-120a-c02862aba84b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lbz", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"lindbladBloch", "[", 
        RowBox[{"ratesB", ",", " ", 
         RowBox[{"initB", "[", 
          RowBox[{"[", 
           RowBox[{"1", " ", ";;", " ", "3"}], "]"}], "]"}]}], "]"}], "[", 
       "tfB", "]"}], "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"TableForm", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Mean", "[", "#", "]"}], " ", "-", " ", "lbz"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"StandardDeviation", "[", "#", "]"}], "/", 
          RowBox[{"Sqrt", "[", "nSweep", "]"}]}], ")"}]}], " ", "&"}], " ", "/@",
       " ", "sweepZB"}], ",", "\n", "  ", 
     RowBox[{"TableHeadings", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"N", "[", 
        RowBox[{"tfB", "/", 
         RowBox[{"{", 
          RowBox[{
          "6", ",", " ", "12", ",", " ", "25", ",", " ", "100", ",", " ", 
           "400"}], "}"}]}], "]"}], "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[54]:= ",ExpressionUUID->"34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      TagBox["0.5`",
       HoldForm], "0.7122492551951692`"},
     {
      TagBox["0.25`",
       HoldForm], "0.7891894376732196`"},
     {
      TagBox["0.12`",
       HoldForm], "0.9614124808698071`"},
     {
      TagBox["0.03`",
       HoldForm], "0.2417774627010668`"},
     {
      TagBox["0.0075`",
       HoldForm], "2.0169747440554224`"}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {{False}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.5599999999999999]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   OutputFormsDump`HeadedColumn],
  Function[BoxForm`e$, 
   TableForm[
   BoxForm`e$, 
    TableHeadings -> {{0.5, 0.25, 0.12, 0.03, 0.0075}}]]]], "Output",
 CellLabel->
  "Out[54]= ",ExpressionUUID->"166277e1-e8de-815f-3e12-6eca8968d3a5"]
}, Open  ]],

Cell[TextData[{
 "All five distances sit where sampling noise puts the largest of a handful \
of draws, with no growth as the grid coarsens, so the mean carries no \
resolvable regularization bias at any of these grids: the affine drift doing \
exactly what the algebra said it must. So of the two increments it is ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ae7a534-7379-468c-3a9c-3d7e060c2cd6"],
 " that sets the answer, and at this sampling accuracy the spread is where we \
can see it move."
}], "Text",ExpressionUUID->"34baef30-7963-b757-5c59-077a78171dbd"],

Cell["Phase backaction: the x channel comes alive", "Section",ExpressionUUID->"15ce0314-20ee-2b64-43f5-9b5e509b764e"],

Cell[TextData[{
 "So far the backaction quadrature has been off (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38a9ac88-4644-6c0e-6856-45d273f13754"],
 "), which decoupled ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64802aa2-b136-451c-0cbf-c30fc0c32c66"],
 " and left it trivial. Turn it on and the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"],
 " channel comes alive, but watch where: the affine It\[OHat] drift still \
decouples ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "233ecb8e-17f3-8d32-52c5-e2e8a187d418"],
 "'s mean, so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dd949a9-d8cf-50b3-2be7-60f2d97a2299"],
 " decays on its own, while the diffusion's ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"B", "A"}], "TI"]]], " ", 
   StyleBox["y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],
 " term now feeds ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "598f41e5-f1df-a461-0fb5-58ce806b0f4b"],
 "'s fluctuations from ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e0f0df5-2071-c96f-4634-a4bf51059bb5"],
 ". So the mean is the weak test of the coupling and the spread is the real \
one. Fix a case with both quadratures on, from a tilted start. This set \
satisfies the admissibility condition with equality, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "+", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "=", "2", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     StyleBox["d", "TI"]], "+", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Phi]", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f6e12d5-e3b9-0bb9-2515-8b9e964c5983"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41ecc127-3c02-05fa-7793-d881b5b76fc0"],
 ": a quantum-limited detector (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1190ff72-a9fe-60f8-47af-f73fcf8b32c2"],
 ") and nothing else dephasing, so run the check as an equality:"
}], "Text",ExpressionUUID->"19c80315-d7de-7125-4ff7-9b5ee26b400f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ratesX", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0.4", ",", " ", "0.4", ",", " ", "0.4", ",", " ", "0.", ",", " ", "1.", ",",
      " ", "2."}], "}"}]}], ";", " ", 
  RowBox[{"initX", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.3", ",", " ", "0.", ",", " ", "0.6", ",", " ", "0."}], "}"}]}],
   ";", " ", 
  RowBox[{"tfX", " ", "=", " ", "2."}], ";", " ", 
  RowBox[{"nX", " ", "=", " ", "600"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ratesX", "[", 
    RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
   RowBox[{"ratesX", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], " ", "==", " ", 
  RowBox[{"2", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"ratesX", "[", 
      RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
     RowBox[{"ratesX", "[", 
      RowBox[{"[", "4", "]"}], "]"}]}], ")"}]}]}]}], "Input",
 CellLabel->
  "In[55]:= ",ExpressionUUID->"6fdf78a7-59a9-97d9-15e5-7101585dfd23"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[55]= ",ExpressionUUID->"7a87483f-bfa4-2eb6-2abd-62793a51749c"]
}, Open  ]],

