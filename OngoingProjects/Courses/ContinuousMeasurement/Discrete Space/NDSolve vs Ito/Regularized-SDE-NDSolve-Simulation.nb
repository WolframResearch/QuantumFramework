        Offset[0.2]}}],
   {OutputFormsDump`HeadedRows, OutputFormsDump`HeadedColumns}],
  Function[BoxForm`e$, 
   TableForm[
   BoxForm`e$, 
    TableHeadings -> {{"x", "y", "z"}, {
      "Stratonovich", "regularized"}}]]]], "Output",
 CellLabel->
  "Out[30]= ",ExpressionUUID->"15eb24b6-b946-3a65-43e8-bdf038f0894f"]
}, Open  ]],

Cell[TextData[{
 "As one can see, the spreads agree component by component, so the \
regularized route reproduces the noise, not just the drift. The ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27d2a24c-1e84-19ee-4de1-44169b316b34"],
 " row is flat zero: with the backaction quadrature off (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "285985c7-a1c8-13eb-5866-1ca0d07d6131"],
 ") and no initial ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57868ed1-450c-c474-7dbd-279b6cbeaf5e"],
 "-coherence, nothing sources ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c5e608e-35dc-f74f-3466-79e8bc6edd95"],
 ", and the substance sits in ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a1e4090-3303-05ed-4a26-59da46b66f37"],
 " and ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10256af3-3972-af7a-41da-83bdb804f240"],
 ". That flat zero is exact, not numerical: at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "457602f1-d86e-ac86-730d-9bbad918f6ec"],
 " the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "499f95c1-a958-6c18-7fa4-0caac8ed3762"],
 " row of both the drift and the diffusion vanishes on the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1e874b-6d22-b8ab-3525-1f1504d40af1"],
 " plane, so the plane is invariant for every remaining rate:"
}], "Text",ExpressionUUID->"0c02104f-9807-e6c4-3431-8a2919b3cc2e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"driftStrat", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], "}"}], ",",
         " ", "ratesSym"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"diffStrat", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], "}"}], ",",
         " ", "ratesSym"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "}"}], " ", "/.", "\n", "  ", 
   RowBox[{
    RowBox[{"ratesSym", "[", 
     RowBox[{"[", "2", "]"}], "]"}], " ", "->", " ", "0"}]}], "]"}]], "Input",\

 CellLabel->
  "In[31]:= ",ExpressionUUID->"6f909018-5ea1-6a32-15af-0a425b543918"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0"}], "}"}]], "Output",
 CellLabel->
  "Out[31]= ",ExpressionUUID->"2f4595f3-090a-1216-557a-0cbda8bf617c"]
}, Open  ]],

Cell[TextData[{
 "\"Agree\" needs a scale, though: a spread estimated from finitely many \
samples is itself uncertain, with standard error ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["m", "TI"], "4"], "-", 
     SuperscriptBox[
      StyleBox["s", "TI"], "4"]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"4", " ", 
     SuperscriptBox[
      StyleBox["s", "TI"], "2"], " ", 
     StyleBox["n", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06385f5e-e9d4-4e6c-2fd8-571b886114b6"],
 ", where ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["m", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],
 " is the sample's own fourth central moment (for near-Gaussian samples this \
reduces to the familiar spread over ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"2", 
    StyleBox["n", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9a140e-d97a-4136-69b9-8e6bd80f101c"],
 "; taking it from the samples themselves costs nothing and assumes nothing \
about their shape), and the gap between two such estimates is uncertain by \
their errors in quadrature. In other words, a spread is itself a measurement \
with an error bar, and two spreads disagree only when their gap outruns that \
bar. Define that statistic once and read the two live components:"
}], "Text",ExpressionUUID->"4f9438da-b80f-a114-75ab-b18439bbf07e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"sdErr", ",", " ", "spreadGap"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sdErr", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", " ", "=", " ", 
       RowBox[{"CentralMoment", "[", 
        RowBox[{"x", ",", " ", "2"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"CentralMoment", "[", 
          RowBox[{"x", ",", " ", "4"}], "]"}], " ", "-", " ", 
         RowBox[{"v", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"4", " ", "v", " ", 
         RowBox[{"Length", "[", "x", "]"}]}], ")"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"spreadGap", "[", 
    RowBox[{"x1_", ",", " ", "x2_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"StandardDeviation", "[", "x1", "]"}], " ", "-", " ", 
      RowBox[{"StandardDeviation", "[", "x2", "]"}]}], "]"}], "/", "\n", 
    "   ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"sdErr", "[", "x1", "]"}], "^", "2"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"sdErr", "[", "x2", "]"}], "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"spreadGap", "[", 
    RowBox[{
     RowBox[{"stratRunB", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", 
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"2", " ", ";;", " ", "3"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{"regRunB", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", 
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"2", " ", ";;", " ", "3"}]}], "]"}], "]"}]}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"\"\<y\>\"", ",", " ", "\"\<z\>\""}], "}"}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[32]:= ",ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      TagBox["\<\"y\"\>",
       HoldForm], "0.8008983116426129`"},
     {
      TagBox["\<\"z\"\>",
       HoldForm], "0.5885201822665023`"}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {{False}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.5599999999999999]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   OutputFormsDump`HeadedColumn],
  Function[BoxForm`e$, 
   TableForm[BoxForm`e$, TableHeadings -> {{"y", "z"}}]]]], "Output",
 CellLabel->
  "Out[32]= ",ExpressionUUID->"3c8746fc-db76-c487-64bd-5fb9de00aeed"]
}, Open  ]],

Cell["\<\
Both gaps sit at the size sampling error alone allows, so at this ensemble \
size the two routes' spreads are statistically indistinguishable.\
\>", "Text",ExpressionUUID->"11f0f87a-e6f0-91cd-478f-f227928ae317"],

Cell[TextData[{
 "The state should stay inside the unit ball, because the trajectory is a \
positivity-preserving unraveling of a Lindblad equation, and the \
admissibility condition tested above is exactly what enforces that. Here is \
the promised derivation. The radial component of the noise, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"], "=", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["z", "TI"], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["x", "TI"], "2"], "-", 
    SuperscriptBox[
     StyleBox["y", "TI"], "2"], "-", 
    SuperscriptBox[
     StyleBox["z", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "473164ce-b547-c1f4-6ecf-7da83cf393de"],
 ", vanishes on the unit sphere. Equivalently, the noise moves the state \
along the sphere, never through it, so whether a path can cross is decided by \
the It\[OHat] drift of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "=", 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], "+", 
   SuperscriptBox[
    StyleBox["y", "TI"], "2"], "+", 
   SuperscriptBox[
    StyleBox["z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c4fc3b-e00c-2bba-42fb-f66491b97980"],
 " there, which is ",
 Cell[BoxData[
  RowBox[{"2", " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], "+", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7e6892-18cd-6f45-4b05-81dc997835af"],
 " on the three state rows, the readout row playing no part in the radius, \
evaluated at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "325c8f47-cd85-89da-6263-2720e431db20"],
 " and with the closed form"
}], "Text",ExpressionUUID->"43fcea2e-12ab-c026-7183-0388a75f930c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     RowBox[{
      FractionBox[
       RowBox[{
        StyleBox["d", "TI"], " ", 
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        SuperscriptBox[
         StyleBox["r", "TI"], "2"], 
        StyleBox["\[RightAngleBracket]",
         SpanMaxSize->1]}], 
       StyleBox[
        RowBox[{"d", "t"}], "TI"]], "\[RightBracketingBar]"}], 
     RowBox[{
      StyleBox["r", "TI"], "=", "1"}]], "=", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["z", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1], " ", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox["\[CapitalGamma]", 
      StyleBox[
       RowBox[{"C", "I"}], "TI"]], "+", 
     SubscriptBox["\[CapitalGamma]", 
      StyleBox[
       RowBox[{"B", "A"}], "TI"]], "-", "2", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox["\[CapitalGamma]", 
       StyleBox["d", "TI"]], "+", 
      SubscriptBox[
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["\[Phi]", "TI"]]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox[")",
     SpanMaxSize->1], "-", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "1"], 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"1", "-", 
       StyleBox["z", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"5b416c07-c3d3-bf4f-097e-8660f6670595"],

Cell["\<\
Verify that closed form, substituting a point on the sphere and subtracting \
the claim:\
\>", "Text",ExpressionUUID->"5add4728-e92e-eff1-0ae3-5f7588d8b5db"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"b3", " ", "=", " ", 
     RowBox[{
      RowBox[{"diffStrat", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], "}"}], ",",
         " ", "ratesSym"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", " ", ";;", " ", "3"}], "]"}], "]"}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", ".", " ", 
           RowBox[{"driftIto", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
             "ratesSym"}], "]"}]}]}], " ", "+", " ", 
         RowBox[{"b3", " ", ".", " ", "b3"}]}], ")"}], " ", "/.", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"z", "^", "2"}]}], "]"}], " ", 
           RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"z", "^", "2"}]}], "]"}], " ", 
           RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}]}], "}"}]}], ")"}], " ", "-",
      "\n", "   ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"z", "^", "2"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ratesSym", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
          RowBox[{"ratesSym", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"ratesSym", "[", 
              RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
             RowBox[{"ratesSym", "[", 
              RowBox[{"[", "4", "]"}], "]"}]}], ")"}]}]}], ")"}]}], " ", "-", 
       "\n", "     ", 
       RowBox[{
        RowBox[{"ratesSym", "[", 
         RowBox[{"[", "5", "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "z"}], ")"}], "^", "2"}]}]}], ")"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[33]:= ",ExpressionUUID->"621761a3-d300-b412-122d-780ce6ba1f78"],

Cell[BoxData["0"], "Output",
 CellLabel->
  "Out[33]= ",ExpressionUUID->"5b08d465-1dcc-fb87-0937-ce4f947ec9ed"]
}, Open  ]],

Cell[TextData[{
 "The subtraction cancels identically, so the closed form is exact. Read it: \
the relaxation term ",
 Cell[BoxData[
  RowBox[{"-", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["z", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d3ffb2e-09a8-fc78-24c4-f288a842c742"],
 " always pulls inward but dies quadratically at the ground pole, while the \
measurement bracket scales as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["z", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4139b36b-52b1-2977-70c6-2b356744785d"],
 " and survives there linearly, so the drift points inward for every ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "494d6e39-7750-b6eb-7f72-806302ea1c31"],
 " precisely when ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "+", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "\[LessEqual]", "2", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     StyleBox["d", "TI"]], "+", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Phi]", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39b01e29-d171-5c92-6f4f-9072e00426f8"],
 ", the admissibility condition. Every rate set that drives an ensemble in \
this document passes that test in the cell defining it; of the three \
single-path sets below, one is a deliberate violation and the other two sit \
exactly on the admissibility boundary, each named as such where it appears. \
So the largest Bloch radius any regularized path reached, over the stored \
grid, should sit at one to within the small overshoot of an unprojected \
scheme:"
}], "Text",ExpressionUUID->"4f6d713e-2461-11c8-7513-69784d146312"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Map", "[", 
   RowBox[{"Norm", ",", " ", 
    RowBox[{"regRunB", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "All", ",", " ", 
       RowBox[{"1", " ", ";;", " ", "3"}]}], "]"}], "]"}], ",", " ", 
    RowBox[{"{", "2", "}"}]}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[34]:= ",ExpressionUUID->"14ad582f-66ff-93eb-3c53-5189128be131"],

Cell[BoxData["1.`"], "Output",
 CellLabel->
  "Out[34]= ",ExpressionUUID->"4f7ea056-2d28-85ec-7505-3a1044c2ef36"]
}, Open  ]],

Cell[TextData[{
 "The radius sits at one to within a hair, with no projection step. Read this \
as a spot-check of positivity, not a proof of it: it samples one ensemble on \
a fixed grid from a state that began on the surface. Violate the \
admissibility condition, which for a detector means ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], ">", "1", "+", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "/", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b00368-b832-202d-3e4f-9b3239c77377"],
 ", more information extracted than the dephasing paid for, and the equation \
stops being a valid unraveling: the trajectory can leave the ball, and its \
coordinates no longer describe a density matrix. That failure is one cell \
away. Fix rates that fail the check, twice the information the dephasing \
supplies, start on the sphere away from the pole where the closed form above \
makes the flux point outward, and read the largest radius one path reaches:"
}], "Text",ExpressionUUID->"06d00634-a672-f252-2eef-9871d304c0b8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ratesBad", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "2.", ",", " ", "0.", ",", " ", "0.5", ",", " ", "0.", ",", " ", "1.", ",",
        " ", "0."}], "}"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tr", " ", "=", " ", 
       RowBox[{"oneTraj", "[", 
        RowBox[{"ratesBad", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.8", ",", " ", "0.", ",", " ", "0.6", ",", " ", "0."}], 
          "}"}], ",", " ", "1.", ",", " ", 
         RowBox[{"dtGenOf", "[", "ratesBad", "]"}], ",", " ", "5", ",", " ", 
         RowBox[{
          RowBox[{"dtGenOf", "[", "ratesBad", "]"}], "/", "4"}]}], "]"}]}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{"Max", "[", 
      RowBox[{"Norm", " ", "/@", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"Subdivide", "[", 
            RowBox[{"0.", ",", " ", "1.", ",", " ", "200"}], "]"}], "]"}], 
          " ", "&"}], " ", "/@", " ", 
         RowBox[{"tr", "[", 
          RowBox[{"[", 
           RowBox[{"1", " ", ";;", " ", "3"}], "]"}], "]"}]}], "]"}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[35]:= ",ExpressionUUID->"05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],

Cell[BoxData["1.0247271358992156`"], "Output",
 CellLabel->
  "Out[35]= ",ExpressionUUID->"583a98af-415b-100e-09d9-110970ee6354"]
}, Open  ]],

Cell["\<\
The radius runs past one: on this part of the sphere the drift itself points \
outward, so the exit is deterministic, not a rare fluctuation. The equation \
still integrates; what fails is its meaning, since no density matrix has a \
Bloch vector outside the ball.\
\>", "Text",ExpressionUUID->"07beae85-a317-6bf9-2d45-47eed6a239c3"],

Cell[TextData[{
 "The boundary is just as sharp from the inside. Saturate the condition with \
no relaxation and no intrinsic dephasing, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],
 " with both quadratures on and the drive on too, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "+", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "=", "2", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60049622-f570-0e0e-103b-0f8ffc055554"],
 " exactly, and the closed form above vanishes identically: the sphere itself \
is invariant, so a pure state stays pure along every single trajectory, not \
merely on average. Start a path on the sphere and read how far it ever leaves:"
}], "Text",ExpressionUUID->"40ea559d-da93-7842-70ea-4cc6df264aa8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rPure", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "0.352", ",", " ", "0.4", ",", " ", "0.376", ",", " ", "0.", ",", " ", 
       "0.", ",", " ", "3."}], "}"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tr", " ", "=", " ", 
        RowBox[{"oneTraj", "[", 
         RowBox[{"rPure", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.6", ",", " ", "0.", ",", " ", "0.8", ",", " ", "0."}], 
           "}"}], ",", " ", "3.", ",", " ", 
          RowBox[{"dtGenOf", "[", "rPure", "]"}], ",", " ", "5", ",", " ", 
          RowBox[{
           RowBox[{"dtGenOf", "[", "rPure", "]"}], "/", "4"}]}], "]"}]}], ",",
        "\n", "   ", 
       RowBox[{"s", " ", "=", " ", 
        RowBox[{"Subdivide", "[", 
         RowBox[{"0.", ",", " ", "3.", ",", " ", "400"}], "]"}]}]}], "}"}], ",",
      "\n", "  ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"Norm", " ", "/@", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "s", "]"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"tr", "[", 
            RowBox[{"[", 
             RowBox[{"1", " ", ";;", " ", "3"}], "]"}], "]"}]}], "]"}]}], " ",
         "-", " ", "1"}], "]"}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[36]:= ",ExpressionUUID->"23ccc6ee-92c0-e596-51f3-dfc8277acffc"],

Cell[BoxData["5.794197892816655`*^-6"], "Output",
 CellLabel->
  "Out[36]= ",ExpressionUUID->"114d8d02-b276-9c05-4772-256fc700e76f"]
}, Open  ]],

Cell["\<\
The radius sticks to the sphere at solver error, the sharpest test of the \
diffusion's scale in the document: a noise term wrong by any factor would \
walk the path off the sphere at once. On the boundary, positivity is not an \
inequality respected but an equality enforced.\
\>", "Text",ExpressionUUID->"2dc22b63-32d1-862f-5bf1-c34d4765ed75"],

Cell["The readout: the average signal and the shared noise", "Section",ExpressionUUID->"36ea7e2c-072a-2221-5eea-7076b2df710b"],

Cell[TextData[{
 "We carried the readout ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b23761c-2477-64e8-0ad1-68464d024e32"],
 " beside the state through every run but have only looked at the state. Turn \
to the record itself. Taking the mean of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["Q", "TI"], "=", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["z", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73216bcf-7cf1-61ac-22de-82a9748433f6"],
 " and using ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"d", "W"}], "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],
 ", the average record is the integrated signal,"
}], "Text",ExpressionUUID->"409bca18-cbd6-e54d-70b8-ec45ee60cf97"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["Q", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "=", 
    SqrtBox[
     SubscriptBox["\[CapitalGamma]", 
      StyleBox[
       RowBox[{"C", "I"}], "TI"]]], 
    UnderoverscriptBox["\[Integral]", "0", 
     StyleBox["t", "TI"],
     LimitsPositioning->False], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["z", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["s", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], " ", 
    StyleBox["d", "TI"], 
    StyleBox["s", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"10b62b5f-1d3f-f012-404d-c31994cbc378"],

Cell[TextData[{
 "a closed prediction we already hold, since ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79984792-c453-565a-2fb8-5edfede63ca0"],
 " is the Lindblad mean. And the records are already in hand: every stored \
trajectory carries ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d45428e-8fa1-6801-4b7b-5be82a543b6b"],
 " as its fourth component, so slice the record ensemble out of the same run \
whose state we just averaged:"
}], "Text",ExpressionUUID->"604bb87d-3174-a116-1048-32274006f07c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"recQB", " ", "=", " ", 
   RowBox[{"regRunB", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "All", ",", " ", "4"}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[37]:= ",ExpressionUUID->"763191a2-6f8b-197a-1fce-080c0a3e6840"],

Cell[TextData[{
 "The prediction is itself a closed form, not a quadrature: append ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["u", "TI"], "\[Prime]"], "=", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "635fdfdb-2856-deda-1164-d68549e0a420"],
 " to the affine system and let ",
 Cell[BoxData["DSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],
 " integrate it exactly:"
}], "Text",ExpressionUUID->"5c8469dd-bfc7-2a7a-04bb-80873a727940"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "qpredB", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qpredB", " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sol", ",", " ", "xf", ",", " ", "yf", ",", " ", "zf", ",", " ", "uf", ",",
        " ", "t"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"sol", " ", "=", " ", 
       RowBox[{
        RowBox[{"DSolve", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"#1", "'"}], "[", "t", "]"}], " ", "==", " ", "#2"}],
                " ", "&"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"xf", ",", " ", "yf", ",", " ", "zf"}], "}"}], ",", 
                " ", 
                RowBox[{"driftIto", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"xf", "[", "t", "]"}], ",", " ", 
                    RowBox[{"yf", "[", "t", "]"}], ",", " ", 
                    RowBox[{"zf", "[", "t", "]"}]}], "}"}], ",", " ", 
                  "ratesB"}], "]"}]}], "}"}]}], "]"}], ",", "\n", "       ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"uf", "'"}], "[", "t", "]"}], " ", "==", " ", 
               RowBox[{
                RowBox[{"Sqrt", "[", 
                 RowBox[{"ratesB", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", 
                RowBox[{"zf", "[", "t", "]"}]}]}], ",", " ", 
              RowBox[{
               RowBox[{"xf", "[", "0", "]"}], " ", "==", " ", 
               RowBox[{"initB", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
              RowBox[{
               RowBox[{"yf", "[", "0", "]"}], " ", "==", " ", 
               RowBox[{"initB", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", "\n", "        ", 
              RowBox[{
               RowBox[{"zf", "[", "0", "]"}], " ", "==", " ", 
               RowBox[{"initB", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
              RowBox[{
               RowBox[{"uf", "[", "0", "]"}], " ", "==", " ", "0"}]}], 
             "}"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"xf", ",", " ", "yf", ",", " ", "zf", ",", " ", "uf"}], 
           "}"}], ",", " ", "t"}], "]"}], " ", "//", " ", "First"}]}], ";", 
      "\n", "   ", 
      RowBox[{"Function", "[", 
       RowBox[{"tt", ",", " ", 
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{"uf", "[", "tt", "]"}], " ", "/.", " ", "sol"}], "]"}]}], 
       "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[38]:= ",ExpressionUUID->"182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],

Cell["Overlay the ensemble-averaged record on that prediction:", "Text",ExpressionUUID->"3921e4bb-f5e4-3596-68de-fde483969ffc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"noiseGrid", "[", 
      RowBox[{"tfB", ",", " ", 
       RowBox[{"dtGenOf", "[", "ratesB", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Mean", "[", "recQB", "]"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"g", ",", " ", 
          RowBox[{"qpredB", " ", "/@", " ", "g"}]}], "}"}], "]"}]}], "}"}], ",",
      "\n", "  ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{"Thick", ",", " ", "Black"}], "]"}]}], "}"}]}], ",", "\n", 
     "  ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<ensemble mean \[LeftAngleBracket]Q\[RightAngleBracket](t)\
\>\"", ",", 
        " ", "\"\<\!\(\*SqrtBox[\(\[CapitalGamma]CI\)]\) \[Integral]\
\[LeftAngleBracket]z\[RightAngleBracket] dt\>\""}], "}"}]}], ",", "\n", "  ", 
     
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<t\>\"", ",", 
        " ", "\"\<\[LeftAngleBracket]Q\[RightAngleBracket]\>\""}], "}"}]}], ",",
      "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<the average record is the integrated signal\>\""}], ",", " ", 
     
     RowBox[{"ImageSize", " ", "->", " ", "520"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->
  "In[39]:= ",ExpressionUUID->"13db9173-5387-1c16-41f8-093d6632677c"],

