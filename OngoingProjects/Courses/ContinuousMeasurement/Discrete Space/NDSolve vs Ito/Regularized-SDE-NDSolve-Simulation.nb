}], "Text",ExpressionUUID->"2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nSweep", " ", "=", " ", "300"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sweepZB", " ", "=", " ", 
