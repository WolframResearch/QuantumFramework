Cell[TextData[{
 "As one can see, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7519012f-e657-215b-2326-988893e273a1"],
 " is a continuous random walk and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["W", "TI"], "\[Prime]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "594776df-9e75-d16a-0f7d-6f991b01a3b0"],
 " is a jagged but genuine function, varying on the scale ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6405505f-4b92-3bd6-0c3b-4a196e24893c"],
 ". There are two time increments here, and they play different roles. The \
first, ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6878c7f8-419e-9db5-1807-dea27028e79f"],
 ", is the grid the Gaussian increments are drawn on: it sets the correlation \
time of the smoothed noise, and it is the dial that fixes which stochastic \
equation we actually solve, converging to the ideal white-noise SDE only as \
",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48a3d607-c312-9dd3-7850-c860f6a4e739"],
 ". The second, the ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539491e8-328f-8d7b-01ab-08b2473bd441"],
 " step, carries no physics; it only has to resolve the forcing ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["W", "TI"], "\[Prime]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],
 ", smooth between noise knots, and we cap it below ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023f49e2-a747-9723-33c5-60cfd2f3fa09"],
 ", which forces several solver steps across each noise interval, keeps a \
step from straddling many derivative jumps, and supplements the adaptive \
error control. Which of the two actually moves the answer is a question we \
put to the machine below."
}], "Text",ExpressionUUID->"21aa1c49-e16c-f406-57a9-9612901edf6c"],

Cell[TextData[{
 "Assemble one trajectory. Build a smooth noise, form the random ODE ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    OverscriptBox[
     StyleBox["v", "TI"], "\[RightVector]"], "."], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "\[RightVector]"], 
    StyleBox["Strat",
     FontSlant->"Plain"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["b", "TI"], "\[RightVector]"], 
    StyleBox["Strat",
     FontSlant->"Plain"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SuperscriptBox[
    StyleBox["W", "TI"], "\[Prime]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "289b85cd-827f-9a9c-58b8-1c97370be8e6"],
 " for the full four-vector, and hand it to ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f3dbee-abc4-6375-4280-d2cbce714e5f"],
 " with its ",
 Cell[BoxData["MaxStepSize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
 " capped below ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cfa2c34-ef50-7d46-5499-c6718ae547ac"],
 ":"
}], "Text",ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "oneTraj", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"oneTraj", "[", 
    RowBox[{
    "r_", ",", " ", "init_", ",", " ", "tf_", ",", " ", "dtGen_", ",", " ", 
     "seed_", ",", " ", "maxstep_", ",", " ", 
     RowBox[{"goal_", " ", ":", " ", "Automatic"}]}], "]"}], " ", ":=", "\n", 
   "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "Wf", ",", " ", "xx", ",", " ", "yy", ",", " ", "zz", ",", " ", "QQ", ",",
        " ", "t", ",", " ", "rhs", ",", " ", "eqs"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Wf", " ", "=", " ", 
       RowBox[{"wienerFun", "[", 
        RowBox[{"tf", ",", " ", "dtGen", ",", " ", "seed"}], "]"}]}], ";", 
      "\n", "   ", 
      RowBox[{"rhs", " ", "=", " ", 
       RowBox[{
        RowBox[{"driftStrat", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"xx", "[", "t", "]"}], ",", " ", 
            RowBox[{"yy", "[", "t", "]"}], ",", " ", 
            RowBox[{"zz", "[", "t", "]"}], ",", " ", 
            RowBox[{"QQ", "[", "t", "]"}]}], "}"}], ",", " ", "r"}], "]"}], 
        " ", "+", "\n", "     ", 
        RowBox[{
         RowBox[{"diffStrat", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"xx", "[", "t", "]"}], ",", " ", 
             RowBox[{"yy", "[", "t", "]"}], ",", " ", 
             RowBox[{"zz", "[", "t", "]"}], ",", " ", 
             RowBox[{"QQ", "[", "t", "]"}]}], "}"}], ",", " ", "r"}], "]"}], " ", 
         RowBox[{
          RowBox[{"Wf", "'"}], "[", "t", "]"}]}]}]}], ";", "\n", "   ", 
      RowBox[{"eqs", " ", "=", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#1", "'"}], "[", "t", "]"}], " ", "==", " ", "#2"}], 
            " ", "&"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"xx", ",", " ", "yy", ",", " ", "zz", ",", " ", "QQ"}], 
              "}"}], ",", " ", "rhs"}], "}"}]}], "]"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"xx", "[", "0", "]"}], " ", "==", " ", 
            RowBox[{"init", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"yy", "[", "0", "]"}], " ", "==", " ", 
            RowBox[{"init", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"zz", "[", "0", "]"}], " ", "==", " ", 
            RowBox[{"init", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"QQ", "[", "0", "]"}], " ", "==", " ", 
            RowBox[{"init", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], "]"}]}], ";", "\n", 
      "   ", 
      RowBox[{"NDSolveValue", "[", 
       RowBox[{"eqs", ",", " ", 
        RowBox[{"{", 
         RowBox[{"xx", ",", " ", "yy", ",", " ", "zz", ",", " ", "QQ"}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", ",", " ", "tf"}], "}"}], ",", " ", 
        RowBox[{"MaxStepSize", " ", "->", " ", "maxstep"}], ",", "\n", "    ", 
        RowBox[{"AccuracyGoal", " ", "->", " ", "goal"}], ",", " ", 
        RowBox[{"PrecisionGoal", " ", "->", " ", "goal"}]}], "]"}]}]}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[TextData[{
 "Show one trajectory two ways: the monitored component ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa29c-d013-1000-4004-3bd9e1a6636a"],
 " against the exact Lindblad mean, and the readout ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Q", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6798df62-4cc7-e4e1-0da7-d74c6573cecb"],
 " it accumulates, both built from the single four-vector solution:"
}], "Text",ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"traj", " ", "=", " ", 
      RowBox[{"oneTraj", "[", 
       RowBox[{"ratesB", ",", " ", "initB", ",", " ", "tfB", ",", " ", 
        RowBox[{"dtGenOf", "[", "ratesB", "]"}], ",", " ", "7", ",", " ", 
        RowBox[{
         RowBox[{"dtGenOf", "[", "ratesB", "]"}], "/", "4"}]}], "]"}]}], ",", 
     "\n", "   ", 
     RowBox[{"lb", " ", "=", " ", 
      RowBox[{"lindbladBloch", "[", 
       RowBox[{"ratesB", ",", " ", 
        RowBox[{"initB", "[", 
         RowBox[{"[", 
          RowBox[{"1", " ", ";;", " ", "3"}], "]"}], "]"}]}], "]"}]}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", "\n", "   ", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"traj", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"lb", "[", "t", "]"}], "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", ",", " ", "tfB"}], "}"}], ",", "\n", 
        "    ", 
        RowBox[{"PlotLegends", " ", "->", " ", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"{", 
            
            RowBox[{"\"\<one trajectory z(t)\>\"", ",", 
             " ", "\"\<Lindblad \[LeftAngleBracket]z\[RightAngleBracket](t)\>\
\""}], "}"}], ",", " ", "Below"}], "]"}]}], ",", "\n", "    ", 
        RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
        RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
        RowBox[{"FrameLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<t\>\"", ",", " ", "\"\<z\>\""}], "}"}]}], ",", "\n", 
        "    ", 
        RowBox[{
        "PlotLabel", " ", "->", 
         " ", "\"\<state: the monitored component\>\""}], ",", " ", 
        RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}], ",", 
      " ", "\"\<   \>\"", ",", "\n", "   ", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"traj", "[", 
          RowBox[{"[", "4", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", ",", " ", "tfB"}], "}"}], ",", " ", 
        RowBox[{"PlotStyle", " ", "->", " ", 
         RowBox[{"ColorData", "[", 
          RowBox[{"97", ",", " ", "2"}], "]"}]}], ",", "\n", "    ", 
        RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
        RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
        RowBox[{"FrameLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<t\>\"", ",", " ", "\"\<Q\>\""}], "}"}]}], ",", "\n", 
        "    ", 
        RowBox[{
        "PlotLabel", " ", "->", 
         " ", "\"\<readout: the accumulated record Q(t)\>\""}], ",", " ", 
        RowBox[{"ImageSize", " ", "->", " ", "Medium"}]}], "]"}]}], "}"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],

