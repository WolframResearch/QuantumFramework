(* Beginning of Notebook Content *)
Notebook[{
Cell["\<\
Handing NDSolve the explicit Stratonovich SDE: the state and the readout of a \
monitored qubit\
\>", "Title",ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 StyleBox["The trajectory of a continuously monitored qubit, the three Bloch \
components plus the readout the detector accumulates, is one stochastic \
differential equation driven by a single noise. This document writes it in \
the explicit Stratonovich form a smooth-noise solver requires and hands it to \
",
  FontWeight->"Bold"],
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 StyleBox[" directly, the white noise replaced by a cubic-interpolated Wiener \
path. Every step of the route is certified in place: the built-in \
Stratonovich-to-It\[OHat] conversion recovers the Lindblad drift \
symbolically, the ensemble mean lands on the exact ",
  FontWeight->"Bold"],
 Cell[BoxData["DSolve"], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 StyleBox[" solution of the master equation, the ensemble spread lands on a \
native ",
  FontWeight->"Bold"],
 Cell[BoxData["StratonovichProcess"], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],
 StyleBox[" reference that is itself step-refined, and the readout is held to \
the same standard, its mean against a closed form, its spread against the \
same native ensemble, its pathwise identity at solver error. Positivity is \
the admissibility condition ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "+", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "\[LessEqual]", "2", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     StyleBox["d", "TI"]], "+", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Phi]", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],
 StyleBox[", derived from the flux through the Bloch sphere and exercised \
inside, at, and beyond its boundary.",
  FontWeight->"Bold"]
}], "Text",ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell["Mads Bahrami (last updated: August 11, 2026)", "Text",ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell["\<\
The trajectory equations: the state and the readout in one SDE\
\>", "Section",ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell[TextData[{
 "Continuous homodyne monitoring of a driven qubit produces two coupled \
equations driven by the same noise: one for the observer's running estimate \
of the Bloch vector ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["x", "TI"]}], ",", 
   StyleBox["y", "TI"], ",", 
   RowBox[{
    StyleBox["z", "TI"], "}", "=", "{", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["x", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["y", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e0e12c-de7d-6135-7e9f-f889db08301f"],
 ", in the convention ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Bra"]}], "-", 
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5708d032-2150-04f2-7d37-ca7c50e56ed8"],
 " that puts the ground state at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 " (some literature uses the opposite sign), and one for the readout ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166f8969-5e31-e8e5-3e14-21335bc5bacf"],
 " the detector accumulates while measuring ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "234f1fb7-07c6-bba9-5174-96f1b27009f3"],
 ". Stacking the readout as a fourth component, the pair is a single \
scalar-noise It\[OHat] stochastic differential equation, a drift ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
 " times ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],
 " plus a diffusion ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ec9a758-58be-624c-16f6-3f02594b3096"],
 " times one Wiener increment ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23253b8d-1c99-a6bf-52da-b2d7952d0c85"],
 ":"
}], "Text",ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], "(", GridBox[{
      {
       StyleBox["x", "TI"]},
      {
       StyleBox["y", "TI"]},
      {
       StyleBox["z", "TI"]},
      {
       StyleBox["Q", "TI"]}
     }], ")", "=", 
    UnderscriptBox[
     UnderscriptBox[
      RowBox[{"(", GridBox[{
         {
          RowBox[{"-", 
           SubsuperscriptBox["\[CapitalGamma]", "2", 
            StyleBox["eff",
             FontSlant->"Plain"]], " ", 
           StyleBox["x", "TI"]}]},
         {
          RowBox[{"-", 
           SubsuperscriptBox["\[CapitalGamma]", "2", 
            StyleBox["eff",
             FontSlant->"Plain"]], " ", 
           StyleBox["y", "TI"], "-", 
           SubscriptBox["\[CapitalOmega]", 
            StyleBox["x", "TI"]], " ", 
           StyleBox["z", "TI"]}]},
         {
          RowBox[{
           SubscriptBox[
            StyleBox["\[Gamma]", "TI"], "1"], 
           StyleBox["(",
            SpanMaxSize->1], 
           RowBox[{"1", "-", 
            StyleBox["z", "TI"]}], 
           StyleBox[")",
            SpanMaxSize->1], "+", 
           SubscriptBox["\[CapitalOmega]", 
            StyleBox["x", "TI"]], " ", 
           StyleBox["y", "TI"]}]},
         {
          RowBox[{
           SqrtBox[
            SubscriptBox["\[CapitalGamma]", 
             StyleBox[
              RowBox[{"C", "I"}], "TI"]]], " ", 
           StyleBox["z", "TI"]}]}
        }], ")"}], "\[UnderBrace]"], 
     OverscriptBox[
      StyleBox["a", "TI"], "\[RightVector]"]], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "\[ThickSpace]", "+", "\[ThickSpace]", 
    UnderscriptBox[
     UnderscriptBox[
      RowBox[{"(", GridBox[{
         {
          RowBox[{"-", 
           SqrtBox[
            SubscriptBox["\[CapitalGamma]", 
             StyleBox[
              RowBox[{"C", "I"}], "TI"]]], " ", 
           StyleBox["x", "TI"], 
           StyleBox["z", "TI"], "-", 
           SqrtBox[
            SubscriptBox["\[CapitalGamma]", 
             StyleBox[
              RowBox[{"B", "A"}], "TI"]]], " ", 
           StyleBox["y", "TI"]}]},
         {
          RowBox[{"-", 
           SqrtBox[
            SubscriptBox["\[CapitalGamma]", 
             StyleBox[
              RowBox[{"C", "I"}], "TI"]]], " ", 
           StyleBox["y", "TI"], 
           StyleBox["z", "TI"], "+", 
           SqrtBox[
            SubscriptBox["\[CapitalGamma]", 
             StyleBox[
              RowBox[{"B", "A"}], "TI"]]], " ", 
           StyleBox["x", "TI"]}]},
         {
          RowBox[{
           SqrtBox[
            SubscriptBox["\[CapitalGamma]", 
             StyleBox[
              RowBox[{"C", "I"}], "TI"]]], " ", 
           StyleBox["(",
            SpanMaxSize->1], 
           RowBox[{"1", "-", 
            SuperscriptBox[
             StyleBox["z", "TI"], "2"]}], 
           StyleBox[")",
            SpanMaxSize->1]}]},
         {"1"}
        }], ")"}], "\[UnderBrace]"], 
     OverscriptBox[
      StyleBox["b", "TI"], "\[RightVector]"]], " ", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell[TextData[{
 "This is the target: the process whose mean we will check against the \
Lindblad master equation and whose spread we will check against a native \
integrator. The top three rows, the Bloch state, close on their own, nothing \
in them depends on ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],
 "; the fourth row is the record, an integral whose drift ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "779c57de-bb93-d239-1da4-4e983e27a103"],
 " carries the ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2867ea9b-6e8d-517b-581c-03c50b382041"],
 " signal and whose noise is the same ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76dfbc62-92ac-7b6e-1ee4-364c275949b4"],
 " that kicks the state."
}], "Text",ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[TextData[{
 "Every parameter is a rate, in units where ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 ": ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"C", "I"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "741b091d-feb2-1a39-1c38-a146fb476903"],
 " is the informative (coherent-information) rate, which sharpens the state \
toward a ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf5a20e-c541-e06e-698a-446becf5b2b4"],
 " eigenstate; ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"B", "A"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07964fa7-8d1e-ff14-2dae-660124a8c27e"],
 " is the backaction rate of the orthogonal quadrature, which only kicks the \
phase; ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],
 " is the measurement's contribution to the ensemble dephasing, the price in \
coherence the readout pays; ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["\[Phi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbaaaf7-1388-e538-4b59-43b1a622cc02"],
 " is the intrinsic pure dephasing; ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "=", "1", "/", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77d99fdb-a351-2d53-1de6-1684d6e477b9"],
 " is the relaxation rate; and ",
 Cell[BoxData[
  SubscriptBox["\[CapitalOmega]", 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04646437-faee-7dfc-2c1c-7e70fe9b47c6"],
 " is the Rabi frequency. One combination recurs, the effective transverse \
decay ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["\[CapitalGamma]", "2", 
    StyleBox["eff",
     FontSlant->"Plain"]], "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "/", "2", "+", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "+", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbde497-e826-5557-4442-fdd089d33fbd"],
 ". One dimensionless ratio matters too, the detector efficiency ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]], "+", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"B", "A"}], "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox["d", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],
 ", with ",
 Cell[BoxData[
  RowBox[{"0", "\[LessEqual]", 
   StyleBox["\[Eta]", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c358d3e-86d3-ec5f-75ca-25783367b6a5"],
 ": we fix it at its quantum limit ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f908cf3-3c70-d55a-45af-25bdb50abfa0"],
 " throughout, meaning no information is lost between the qubit and the \
amplifier, while the homodyne phase is what divides that total between ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"C", "I"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " and ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"B", "A"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 ". Throughout, the code takes a rate vector ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["r", "TI"], "=", "{", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]}], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], ",", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], ",", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], ",", 
   RowBox[{
    SubscriptBox["\[CapitalOmega]", 
     StyleBox["x", "TI"]], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d004f9-29e5-6665-1eef-9da34f904d4f"],
 " and names its entries, so each vector field below reads term for term like \
these formulas."
}], "Text",ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell[TextData[{
 "Now the same process written the other way. For a single scalar noise, the \
It\[OHat] equation above is identical to a Stratonovich equation with the \
same diffusion and a drift lowered by one exact term (the \
It\[OHat]-Stratonovich conversion, unambiguous for scalar noise, with no L\
\[EAcute]vy-area subtlety). We will not compute that term. Its effect is \
already written into the explicit Stratonovich drift below, and that is the \
drift we hand ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35077f55-9291-6519-633d-771f27244c63"],
 ":"
}], "Text",ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], "(", GridBox[{
      {
       StyleBox["x", "TI"]},
      {
       StyleBox["y", "TI"]},
      {
       StyleBox["z", "TI"]},
      {
       StyleBox["Q", "TI"]}
     }], ")", "=", "(", GridBox[{
      {
       RowBox[{
        StyleBox["(",
         FontSize->1.2 Inherited], 
        FractionBox[
         RowBox[{
          SubscriptBox["\[CapitalGamma]", 
           StyleBox[
            RowBox[{"B", "A"}], "TI"]], "+", 
          SubscriptBox["\[CapitalGamma]", 
           StyleBox[
            RowBox[{"C", "I"}], "TI"]]}], "2"], "-", 
        SubsuperscriptBox["\[CapitalGamma]", "2", 
         StyleBox["eff",
          FontSlant->"Plain"]], "-", 
        SubscriptBox["\[CapitalGamma]", 
         StyleBox[
          RowBox[{"C", "I"}], "TI"]], " ", 
        SuperscriptBox[
         StyleBox["z", "TI"], "2"], 
        StyleBox[")",
         FontSize->1.2 Inherited], " ", 
        StyleBox["x", "TI"], "-", 
        SqrtBox[
         RowBox[{
          SubscriptBox["\[CapitalGamma]", 
           StyleBox[
            RowBox[{"B", "A"}], "TI"]], 
          SubscriptBox["\[CapitalGamma]", 
           StyleBox[
            RowBox[{"C", "I"}], "TI"]]}]], " ", 
        StyleBox["y", "TI"], 
        StyleBox["z", "TI"]}]},
      {
       RowBox[{
        StyleBox["(",
         FontSize->1.2 Inherited], 
        FractionBox[
         RowBox[{
          SubscriptBox["\[CapitalGamma]", 
           StyleBox[
            RowBox[{"B", "A"}], "TI"]], "+", 
          SubscriptBox["\[CapitalGamma]", 
           StyleBox[
            RowBox[{"C", "I"}], "TI"]]}], "2"], "-", 
        SubsuperscriptBox["\[CapitalGamma]", "2", 
         StyleBox["eff",
          FontSlant->"Plain"]], "-", 
        SubscriptBox["\[CapitalGamma]", 
         StyleBox[
          RowBox[{"C", "I"}], "TI"]], " ", 
        SuperscriptBox[
         StyleBox["z", "TI"], "2"], 
        StyleBox[")",
         FontSize->1.2 Inherited], " ", 
        StyleBox["y", "TI"], "+", 
        SqrtBox[
         RowBox[{
          SubscriptBox["\[CapitalGamma]", 
           StyleBox[
            RowBox[{"B", "A"}], "TI"]], 
          SubscriptBox["\[CapitalGamma]", 
           StyleBox[
            RowBox[{"C", "I"}], "TI"]]}]], " ", 
        StyleBox["x", "TI"], 
        StyleBox["z", "TI"], "-", 
        SubscriptBox["\[CapitalOmega]", 
         StyleBox["x", "TI"]], " ", 
        StyleBox["z", "TI"]}]},
      {
       RowBox[{
        SubscriptBox[
         StyleBox["\[Gamma]", "TI"], "1"], 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"1", "-", 
         StyleBox["z", "TI"]}], 
        StyleBox[")",
         SpanMaxSize->1], "+", 
        SubscriptBox["\[CapitalGamma]", 
         StyleBox[
          RowBox[{"C", "I"}], "TI"]], " ", 
        StyleBox["z", "TI"], 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"1", "-", 
         SuperscriptBox[
          StyleBox["z", "TI"], "2"]}], 
        StyleBox[")",
         SpanMaxSize->1], "+", 
        SubscriptBox["\[CapitalOmega]", 
         StyleBox["x", "TI"]], " ", 
        StyleBox["y", "TI"]}]},
      {
       RowBox[{
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", 
          StyleBox[
           RowBox[{"C", "I"}], "TI"]]], " ", 
        StyleBox["z", "TI"]}]}
     }], ")", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "\[ThickSpace]", "+", "\[ThickSpace]", "(", 
    GridBox[{
      {
       RowBox[{"-", 
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", 
          StyleBox[
           RowBox[{"C", "I"}], "TI"]]], " ", 
        StyleBox["x", "TI"], 
        StyleBox["z", "TI"], "-", 
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", 
          StyleBox[
           RowBox[{"B", "A"}], "TI"]]], " ", 
        StyleBox["y", "TI"]}]},
      {
       RowBox[{"-", 
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", 
          StyleBox[
           RowBox[{"C", "I"}], "TI"]]], " ", 
        StyleBox["y", "TI"], 
        StyleBox["z", "TI"], "+", 
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", 
          StyleBox[
           RowBox[{"B", "A"}], "TI"]]], " ", 
        StyleBox["x", "TI"]}]},
      {
       RowBox[{
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", 
          StyleBox[
           RowBox[{"C", "I"}], "TI"]]], " ", 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"1", "-", 
         SuperscriptBox[
          StyleBox["z", "TI"], "2"]}], 
        StyleBox[")",
         SpanMaxSize->1]}]},
      {"1"}
     }], ")", "\[SmallCircle]", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"65de4a87-3471-cd9f-13e6-63e1bd0597e5"],

Cell[TextData[{
 "The reason this is the form to feed a smooth-noise solver is one sentence: \
a white noise replaced by a differentiable curve of vanishing correlation \
time integrates to the Stratonovich reading, not the It\[OHat] one, so ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 ", which sees only a smooth forcing, must be given the Stratonovich drift. \
That is the entire design of this route, and it is why the correction never \
has to be computed: the smoothing puts it back. The readout row is the same \
in both forms, because its noise is additive, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["Q", "TI"], "=", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["z", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 ", with nothing to reinterpret. ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 " itself is dimensionless: it is the integrated homodyne current, scaled so \
its shot noise accumulates as the standard Wiener process ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "034d641c-5834-e412-3173-7e4659c6cf78"],
 ", whose increments have variance ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 ", and clocked in the ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfe104a-50de-a555-0985-8a1461680fbf"],
 " time units used throughout."
}], "Text",ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell["Encoding the Stratonovich vector field", "Section",ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell[TextData[{
 "Encode the Stratonovich drift, all four rows. Name the entries of the rate \
vector ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["r", "TI"], "=", "{", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]}], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], ",", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], ",", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], ",", 
   RowBox[{
    SubscriptBox["\[CapitalOmega]", 
     StyleBox["x", "TI"]], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1c99a5-dcef-9c28-1623-100ed49be772"],
 " and fold the transverse rate ",
 Cell[BoxData[
  SubsuperscriptBox["\[CapitalGamma]", "2", 
   StyleBox["eff",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "608e87cc-8fce-afdf-10b5-1e962a78f525"],
 " into a local name, so each row reads term for term like the display \
equation:"
}], "Text",ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "driftStrat", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"driftStrat", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_", ",", " ", "q_"}], "}"}], ",",
      " ", "r_"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalGamma]CI", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
       RowBox[{"\[CapitalGamma]BA", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
       RowBox[{"\[CapitalGamma]d", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"\[Gamma]\[Phi]", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], ",", " ", 
       RowBox[{"\[Gamma]1", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "5", "]"}], "]"}]}], ",", " ", 
       RowBox[{"\[CapitalOmega]x", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "6", "]"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[CapitalGamma]2", " ", "=", " ", 
         RowBox[{
          RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", "\[Gamma]\[Phi]", 
          " ", "+", " ", "\[CapitalGamma]d"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
               "\[CapitalGamma]BA", " ", "+", " ", "\[CapitalGamma]CI"}], 
               ")"}], "/", "2"}], " ", "-", " ", "\[CapitalGamma]2", " ", "-",
              " ", 
             RowBox[{"\[CapitalGamma]CI", " ", 
              RowBox[{"z", "^", "2"}]}]}], ")"}], " ", "x"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"\[CapitalGamma]BA", " ", "\[CapitalGamma]CI"}], "]"}], " ",
            "y", " ", "z"}]}], ",", "\n", "     ", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
               "\[CapitalGamma]BA", " ", "+", " ", "\[CapitalGamma]CI"}], 
               ")"}], "/", "2"}], " ", "-", " ", "\[CapitalGamma]2", " ", "-",
              " ", 
             RowBox[{"\[CapitalGamma]CI", " ", 
              RowBox[{"z", "^", "2"}]}]}], ")"}], " ", "y"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"\[CapitalGamma]BA", " ", "\[CapitalGamma]CI"}], "]"}], " ",
            "x", " ", "z"}], " ", "-", " ", 
          RowBox[{"\[CapitalOmega]x", " ", "z"}]}], ",", "\n", "     ", 
         RowBox[{
          RowBox[{"\[Gamma]1", " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", "z"}], ")"}]}], " ", "+", " ", 
          RowBox[{"\[CapitalGamma]CI", " ", "z", " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"z", "^", "2"}]}], ")"}]}], " ", "+", " ", 
          RowBox[{"\[CapitalOmega]x", " ", "y"}]}], ",", "\n", "     ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}], " ", "z"}]}], 
        "}"}]}], "]"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell[TextData[{
 "Encode the Stratonovich diffusion, the same ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 " as the It\[OHat] form, with the additive readout row equal to one:"
}], "Text",ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "diffStrat", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"diffStrat", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_", ",", " ", "q_"}], "}"}], ",",
      " ", "r_"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalGamma]CI", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
       RowBox[{"\[CapitalGamma]BA", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}]}], " ", "x", " ", 
         "z"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", "\[CapitalGamma]BA", "]"}], " ", "y"}]}], ",", 
       "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}]}], " ", "y", " ", 
         "z"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", "\[CapitalGamma]BA", "]"}], " ", "x"}]}], ",", 
       "\n", "    ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"z", "^", "2"}]}], ")"}]}], ",", "\n", "    ", "1"}], 
      "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"644cc522-c7c4-9b18-0c73-dc8ff276e662"],

Cell[TextData[{
 "To read these back as formulas, write the six rates as symbols, using \
string subscripts so the labels stay ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], ",", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
 " and never collide with the Bloch ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 " or fuse into a ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "\[CenterDot]", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0daf8e98-7628-e40b-3b54-27c203c2cf51"],
 " product. The readbacks and the symbolic conversion below use ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], ",", 
   StyleBox["y", "TI"], ",", 
   StyleBox["z", "TI"], ",", 
   StyleBox["q", "TI"], ",", 
   StyleBox["Q", "TI"], ",", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 ", a formal noise ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],
 ", the starting values, and the rate symbols themselves as unassigned \
variables, so clear them first:"
}], "Text",ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "x", ",", " ", "y", ",", " ", "z", ",", " ", "q", ",", " ", "Q", ",", " ", 
    "t", ",", " ", "w", ",", " ", "x0", ",", " ", "y0", ",", " ", "z0", ",", 
    " ", "q0", ",", " ", "\[CapitalGamma]", ",", " ", "\[Gamma]", ",", " ", 
    "\[CapitalOmega]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ratesSym", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"\[CapitalGamma]", ",", " ", "\"\<CI\>\""}], "]"}], ",", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[CapitalGamma]", ",", " ", "\"\<BA\>\""}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[CapitalGamma]", ",", " ", "\"\<d\>\""}], "]"}], ",", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[Gamma]", ",", " ", "\"\<\[Phi]\>\""}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[Gamma]", ",", " ", "\"\<1\>\""}], "]"}], ",", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[CapitalOmega]", ",", " ", "\"\<x\>\""}], "]"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],

Cell["\<\
Verify that the encoded drift is the Stratonovich drift written above, by \
reading it back on the symbolic rates:\
\>", "Text",ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"driftStrat", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "Q"}], "}"}], ",", 
    " ", "ratesSym"}], "]"}], " ", "//", " ", "MatrixForm"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", 
   TagBox[GridBox[{
      {
       RowBox[{
        RowBox[{
         RowBox[{"-", "y"}], " ", "z", " ", 
         SqrtBox[
          RowBox[{
           SubscriptBox["\[CapitalGamma]", "\<\"BA\"\>"], " ", 
           SubscriptBox["\[CapitalGamma]", "\<\"CI\"\>"]}]]}], "+", 
        RowBox[{"x", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox[
             SubscriptBox["\[Gamma]", "\<\"1\"\>"], "2"]}], "-", 
           SubscriptBox["\[Gamma]", "\<\"\[Phi]\"\>"], "-", 
           RowBox[{
            SuperscriptBox["z", "2"], " ", 
            SubscriptBox["\[CapitalGamma]", "\<\"CI\"\>"]}], "+", 
           RowBox[{
            FractionBox["1", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["\[CapitalGamma]", "\<\"BA\"\>"], "+", 
              SubscriptBox["\[CapitalGamma]", "\<\"CI\"\>"]}], ")"}]}], "-", 
           SubscriptBox["\[CapitalGamma]", "\<\"d\"\>"]}], ")"}]}]}]},
      {
       RowBox[{
        RowBox[{"x", " ", "z", " ", 
         SqrtBox[
          RowBox[{
           SubscriptBox["\[CapitalGamma]", "\<\"BA\"\>"], " ", 
           SubscriptBox["\[CapitalGamma]", "\<\"CI\"\>"]}]]}], "+", 
        RowBox[{"y", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox[
             SubscriptBox["\[Gamma]", "\<\"1\"\>"], "2"]}], "-", 
           SubscriptBox["\[Gamma]", "\<\"\[Phi]\"\>"], "-", 
           RowBox[{
            SuperscriptBox["z", "2"], " ", 
            SubscriptBox["\[CapitalGamma]", "\<\"CI\"\>"]}], "+", 
           RowBox[{
            FractionBox["1", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["\[CapitalGamma]", "\<\"BA\"\>"], "+", 
              SubscriptBox["\[CapitalGamma]", "\<\"CI\"\>"]}], ")"}]}], "-", 
           SubscriptBox["\[CapitalGamma]", "\<\"d\"\>"]}], ")"}]}], "-", 
        RowBox[{"z", " ", 
         SubscriptBox["\[CapitalOmega]", "\<\"x\"\>"]}]}]},
      {
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "z"}], ")"}], " ", 
         SubscriptBox["\[Gamma]", "\<\"1\"\>"]}], "+", 
        RowBox[{"z", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["z", "2"]}], ")"}], " ", 
         SubscriptBox["\[CapitalGamma]", "\<\"CI\"\>"]}], "+", 
        RowBox[{"y", " ", 
         SubscriptBox["\[CapitalOmega]", "\<\"x\"\>"]}]}]},
      {
       RowBox[{"z", " ", 
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", "\<\"CI\"\>"]]}]}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.5599999999999999]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}],
    Column], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"]
}, Open  ]],

Cell[TextData[{
 "As one can see, the four rows are term for term the drift in the display \
equation, with Wolfram ordering each sum its own way: the state rows carry \
the ",
 Cell[BoxData[
  RowBox[{"-", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], 
   SuperscriptBox[
    StyleBox["z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 " sharpening and the ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"B", "A"}], "TI"]], 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d359769-845f-cd94-44ca-0f332deb97fe"],
 " cross term, and the readout row is the bare ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2055bfee-d4b5-7aa2-506a-36cbdd404888"],
 " signal. Confirm the diffusion the same way:"
}], "Text",ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"diffStrat", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "Q"}], "}"}], ",", 
    " ", "ratesSym"}], "]"}], " ", "//", " ", "MatrixForm"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", 
   TagBox[GridBox[{
      {
       RowBox[{
        RowBox[{
         RowBox[{"-", "y"}], " ", 
         SqrtBox[
          SubscriptBox["\[CapitalGamma]", "\<\"BA\"\>"]]}], "-", 
        RowBox[{"x", " ", "z", " ", 
         SqrtBox[
          SubscriptBox["\[CapitalGamma]", "\<\"CI\"\>"]]}]}]},
      {
       RowBox[{
        RowBox[{"x", " ", 
         SqrtBox[
          SubscriptBox["\[CapitalGamma]", "\<\"BA\"\>"]]}], "-", 
        RowBox[{"y", " ", "z", " ", 
         SqrtBox[
          SubscriptBox["\[CapitalGamma]", "\<\"CI\"\>"]]}]}]},
      {
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SuperscriptBox["z", "2"]}], ")"}], " ", 
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", "\<\"CI\"\>"]]}]},
      {"1"}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.5599999999999999]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}],
    Column], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"]
}, Open  ]],

Cell[TextData[{
 "As expected, the three state rows are ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 " and the readout row is the constant one, the additive noise that makes ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04786d0e-016a-d127-2c07-8568b01ca00d"],
 " the same in both stochastic calculi. The code and the equations are one \
object, so from here on we compute with the code."
}], "Text",ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

Cell[TextData[{
 "Fix the representative dispersive-transmon rate set, rescaled by ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1ff276-b82a-c3ca-5b24-f43039dc9110"],
 ", starting from the ground state with the readout zeroed, over a short \
window; its readout is quantum-limited (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fd1512-f616-8834-3c82-8d5f83a0db1e"],
 "), ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "+", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "=", "2", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c67103-72a1-9427-0efe-696d0755ff0d"],
 " exactly. The initial condition is a four-vector, the three Bloch numbers \
followed by the record ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
 ". For the trajectory to stay a density matrix, the measurement must fit \
inside the total dephasing, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "+", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "\[LessEqual]", "2", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     StyleBox["d", "TI"]], "+", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Phi]", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58ee7ecb-1370-1005-0896-7795a605636f"],
 ", an admissibility condition we derive below, at the radius check. In terms \
of the efficiency it reads ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "\[LessEqual]", "1", "+", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "/", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],
 ", so any real detector satisfies it; the check guards the numbers we type, \
not the physics. The cell fixes the rates and confirms they pass:"
}], "Text",ExpressionUUID->"7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ratesB", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0.352", ",", " ", "0.", ",", " ", "0.176", ",", " ", "1.", ",", " ", 
     "1.", ",", " ", "3."}], "}"}]}], ";", " ", 
  RowBox[{"initB", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.", ",", " ", "0.", ",", " ", "1.", ",", " ", "0."}], "}"}]}], ";",
   " ", 
  RowBox[{"tfB", " ", "=", " ", "3."}], ";", " ", 
  RowBox[{"nB", " ", "=", " ", "600"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ratesB", "[", 
    RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
   RowBox[{"ratesB", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], " ", "<=", " ", 
  RowBox[{"2", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"ratesB", "[", 
      RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
     RowBox[{"ratesB", "[", 
      RowBox[{"[", "4", "]"}], "]"}]}], ")"}]}]}]}], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"]
}, Open  ]],

Cell["\<\
The quantum-limit claim is one division away; define the efficiency and read \
this set's:\
\>", "Text",ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "efficiency", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"efficiency", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"r", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
      RowBox[{"r", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"r", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"efficiency", "[", "ratesB", "]"}]}], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"5e187950-8ca2-2ab2-0638-711a25577898"],

Cell[BoxData["1.`"], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"250a2d7c-9b81-05b0-5309-c5261e346f9a"]
}, Open  ]],

Cell["The quantum limit exactly, by construction.", "Text",ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell[TextData[{
 "The reference for the mean is the Lindblad master equation. Because the It\
\[OHat] drift ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],
 " is affine in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["x", "TI"]}], ",", 
   StyleBox["y", "TI"], ",", 
   RowBox[{
    StyleBox["z", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43821c38-6720-b4f9-71b1-966212da1ec3"],
 ", the ensemble mean obeys that drift as a closed linear ODE. Encode ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c54d9-3079-6bba-5c24-4d83410c3980"],
 "'s three state rows once; the symbolic conversion check below must land on \
this same object, so one encoding serves both:"
}], "Text",ExpressionUUID->"1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "driftIto", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"driftIto", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "}"}], ",", " ", "r_"}],
     "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalGamma]d", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
       RowBox[{"\[Gamma]\[Phi]", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], ",", " ", 
       RowBox[{"\[Gamma]1", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "5", "]"}], "]"}]}], ",", " ", 
       RowBox[{"\[CapitalOmega]x", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "6", "]"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[CapitalGamma]2", " ", "=", " ", 
         RowBox[{
          RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", "\[Gamma]\[Phi]", 
          " ", "+", " ", "\[CapitalGamma]d"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[CapitalGamma]2"}], " ", "x"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "\[CapitalGamma]2"}], " ", "y"}], " ", "-", " ", 
          RowBox[{"\[CapitalOmega]x", " ", "z"}]}], ",", " ", 
         RowBox[{
          RowBox[{"\[Gamma]1", " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", "z"}], ")"}]}], " ", "+", " ", 
          RowBox[{"\[CapitalOmega]x", " ", "y"}]}]}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"],

Cell[TextData[{
 "Calling that encoding \"the Lindblad master equation\" is a claim, so \
certify it. In other words, the drift must fall out of an explicit generator, \
not just carry the name. Build the generator itself, the drive ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   FractionBox[
    SubscriptBox["\[CapitalOmega]", 
     StyleBox["x", "TI"]], "2"], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],
 " with relaxation ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], " ", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], "-"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5077c06e-c394-b43c-000c-da4bf6261f06"],
 " toward the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07359582-e823-44a1-2eca-0cef89d62e8b"],
 " ground state and total dephasing ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    RowBox[{
     SubscriptBox[
      StyleBox["\[Gamma]", "TI"], 
      StyleBox["\[Phi]", "TI"]], "+", 
     SubscriptBox["\[CapitalGamma]", 
      StyleBox["d", "TI"]]}], "2"], " ", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c239bd0-3ff5-3b18-25d0-129ab9818662"],
 ", where ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["L", "TI"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"], "=", 
   StyleBox["L", "TI"], 
   StyleBox["\[Rho]", "TI"], 
   SuperscriptBox[
    StyleBox["L", "TI"], "\[Dagger]"], "-", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["L", "TI"], "\[Dagger]"], 
    StyleBox["L", "TI"], 
    StyleBox["\[Rho]", "TI"], "+", 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     StyleBox["L", "TI"], "\[Dagger]"], 
    StyleBox["L", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c76573-72ce-0c1a-18fd-7d3d077b5760"],
 "; project it onto the Pauli components and subtract ",
 Cell[BoxData["driftIto"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6184d2f2-049e-728e-17bb-cbbcad2b40d4"],
 ":"
}], "Text",ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"sx", " ", "=", " ", 
      RowBox[{"PauliMatrix", "[", "1", "]"}]}], ",", " ", 
     RowBox[{"sy", " ", "=", " ", 
      RowBox[{"PauliMatrix", "[", "2", "]"}]}], ",", " ", 
     RowBox[{"sz", " ", "=", " ", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}], ",", "\n", "  ", 
     RowBox[{"sm", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"id", " ", "=", " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Rho]", ",", " ", "diss", ",", " ", "gen"}], "}"}], ",", "\n",
      "  ", 
     RowBox[{
      RowBox[{"\[Rho]", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"id", " ", "+", " ", 
          RowBox[{"x", " ", "sx"}], " ", "+", " ", 
          RowBox[{"y", " ", "sy"}], " ", "+", " ", 
          RowBox[{"z", " ", "sz"}]}], ")"}], "/", "2"}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"diss", "[", "L_", "]"}], " ", ":=", " ", 
       RowBox[{
        RowBox[{"L", " ", ".", " ", "\[Rho]", " ", ".", " ", 
         RowBox[{"ConjugateTranspose", "[", "L", "]"}]}], " ", "-", "\n", 
        "    ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", "L", "]"}], " ", ".", " ", "L",
             " ", ".", " ", "\[Rho]"}], " ", "+", " ", 
           RowBox[{"\[Rho]", " ", ".", " ", 
            RowBox[{"ConjugateTranspose", "[", "L", "]"}], " ", ".", " ", 
            "L"}]}], ")"}], "/", "2"}]}]}], ";", "\n", "  ", 
      RowBox[{"gen", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "I"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ratesSym", "[", 
            RowBox[{"[", "6", "]"}], "]"}], "/", "2"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"sx", " ", ".", " ", "\[Rho]"}], " ", "-", " ", 
           RowBox[{"\[Rho]", " ", ".", " ", "sx"}]}], ")"}]}], " ", "+", "\n",
         "    ", 
        RowBox[{
         RowBox[{"ratesSym", "[", 
          RowBox[{"[", "5", "]"}], "]"}], " ", 
         RowBox[{"diss", "[", "sm", "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"ratesSym", "[", 
              RowBox[{"[", "4", "]"}], "]"}], " ", "+", " ", 
             RowBox[{"ratesSym", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "/", "2"}], ")"}], " ", 
         RowBox[{"diss", "[", "sz", "]"}]}]}]}], ";", "\n", "  ", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Tr", "[", 
            RowBox[{"gen", " ", ".", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
           " ", 
          RowBox[{"{", 
           RowBox[{"sx", ",", " ", "sy", ",", " ", "sz"}], "}"}]}], ")"}], 
        " ", "-", " ", 
        RowBox[{"driftIto", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
          "ratesSym"}], "]"}]}], "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"19bb1c5e-57ab-6e36-4f58-9618625e351c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0"}], "}"}]], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"]
}, Open  ]],

Cell[TextData[{
 "Every component cancels, so the affine drift is the Lindblad master \
equation in Bloch coordinates, with each rate's home named by the generator: \
relaxation carries ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30baa1c8-66ad-75e0-6059-389213585fca"],
 ", and the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52535901-cb26-8b9c-0261-516aeed0d9e6"],
 " dissipator carries the intrinsic and the measurement dephasing together, \
which is exactly the total the admissibility condition weighs against the \
measurement. Solve that affine system exactly with ",
 Cell[BoxData["DSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "323a4b1c-b138-a791-63da-6359c0b20dfb"],
 ", building the equations from ",
 Cell[BoxData["driftIto"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7421cf44-a1ac-4319-1dde-e721d0592e63"],
 " itself so the reference and the certified drift stay one object, and \
return ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "511b3347-8d7d-ab60-0738-ab212409f64a"],
 ":"
}], "Text",ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "lindbladBloch", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lindbladBloch", "[", 
    RowBox[{"r_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x0_", ",", " ", "y0_", ",", " ", "z0_"}], "}"}]}], "]"}], " ", 
   ":=", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sol", ",", " ", "xf", ",", " ", "yf", ",", " ", "zf", ",", " ", "t"}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"sol", " ", "=", " ", 
       RowBox[{
        RowBox[{"DSolve", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"#1", "'"}], "[", "t", "]"}], " ", "==", " ", "#2"}],
                " ", "&"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"xf", ",", " ", "yf", ",", " ", "zf"}], "}"}], ",", 
                " ", 
                RowBox[{"driftIto", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"xf", "[", "t", "]"}], ",", " ", 
                    RowBox[{"yf", "[", "t", "]"}], ",", " ", 
                    RowBox[{"zf", "[", "t", "]"}]}], "}"}], ",", " ", "r"}], 
                 "]"}]}], "}"}]}], "]"}], ",", "\n", "       ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"xf", "[", "0", "]"}], " ", "==", " ", "x0"}], ",", 
              " ", 
              RowBox[{
               RowBox[{"yf", "[", "0", "]"}], " ", "==", " ", "y0"}], ",", 
              " ", 
              RowBox[{
               RowBox[{"zf", "[", "0", "]"}], " ", "==", " ", "z0"}]}], 
             "}"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"xf", ",", " ", "yf", ",", " ", "zf"}], "}"}], ",", " ", 
          "t"}], "]"}], " ", "//", " ", "First"}]}], ";", "\n", "   ", 
      RowBox[{"Function", "[", 
       RowBox[{"tt", ",", " ", 
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"xf", "[", "tt", "]"}], ",", " ", 
            RowBox[{"yf", "[", "tt", "]"}], ",", " ", 
            RowBox[{"zf", "[", "tt", "]"}]}], "}"}], " ", "/.", " ", "sol"}], 
         "]"}]}], "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

Cell[TextData[{
 "Two time steps will drive every simulation below, and they should follow \
the physics, not the trajectory count ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519775d4-d545-25f2-07ad-6c91dcf18fd8"],
 ": a step size sets accuracy, ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5900aac7-5263-773e-0f3f-43a167165a04"],
 " sets statistics, and they are independent axes. Fix them from the fastest \
rate in each case. Let ",
 Cell[BoxData["\[CapitalLambda]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],
 " be the largest of the Rabi frequency, the transverse decay ",
 Cell[BoxData[
  SubsuperscriptBox["\[CapitalGamma]", "2", 
   StyleBox["eff",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12d95fcb-3316-2212-42e7-569546a37178"],
 ", and the total measurement rate ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "+", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "733995c2-f5bf-78ee-22c6-0caffc4a4a34"],
 ":"
}], "Text",ExpressionUUID->"4f8ab258-7e7f-0723-7589-34027b0a6a09"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "maxRate", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxRate", "[", "r_", "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalGamma]CI", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
       RowBox[{"\[CapitalGamma]BA", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
       RowBox[{"\[CapitalGamma]d", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"\[Gamma]\[Phi]", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], ",", " ", 
       RowBox[{"\[Gamma]1", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "5", "]"}], "]"}]}], ",", " ", 
       RowBox[{"\[CapitalOmega]x", " ", "=", " ", 
        RowBox[{"r", "[", 
         RowBox[{"[", "6", "]"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"Abs", "[", "\[CapitalOmega]x", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", "\[Gamma]\[Phi]", " ",
         "+", " ", "\[CapitalGamma]d"}], ",", " ", 
       RowBox[{"\[CapitalGamma]CI", " ", "+", " ", "\[CapitalGamma]BA"}]}], 
      "]"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"6b12ee74-9953-131d-1921-003e18e67e67"],

Cell[TextData[{
 "Set the noise grid ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65262d3c-fccc-1dc6-0cdd-c579f579672c"],
 " to resolve that fastest timescale with forty knots, a working resolution \
the refinement sweep checks below for the representative case. Everything \
else follows: ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e157ee2-48da-d240-062b-77cc696ca0aa"],
 "'s adaptive step is capped at a quarter of it, and the native reference \
below runs on the same grid:"
}], "Text",ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "dtGenOf", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dtGenOf", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"40", " ", 
      RowBox[{"maxRate", "[", "r", "]"}]}], ")"}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"],

Cell["Regularizing the noise: a Wiener path NDSolve can integrate", "Section",ExpressionUUID->"1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],

Cell[TextData[{
 "A white-noise increment ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "187adc3d-3961-76c2-4819-d667b8145c28"],
 " is not a function of time, it is a distribution, and ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "641c78eb-7f03-7846-0c24-71b57ab64aac"],
 " cannot integrate a distribution. But if we draw the noise on a grid and \
connect the dots into a continuous curve ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],
 ", then ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["W", "TI"], "\[Prime]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],
 " is an ordinary function, and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], "=", 
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6121b9de-dddd-aca8-10de-309bd469f6f2"],
 " becomes the ordinary differential equation ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    OverscriptBox[
     StyleBox["v", "TI"], "\[RightVector]"], "."], "=", 
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SuperscriptBox[
    StyleBox["W", "TI"], "\[Prime]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30209679-023a-ee91-61df-0823b7ccb4fb"],
 ". In other words, we replace white noise by a regularized noise with a \
short but finite correlation time: smooth between the grid knots, its \
derivative jumping at them."
}], "Text",ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell[TextData[{
 "One grid carries both the noise and the read-off, so define it once, a \
uniform grid on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    SubscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["f", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],
 " that lands exactly on ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], 
   StyleBox["f", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3119d855-3ffd-7401-6726-d21fb9885f6b"],
 ", with about ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["f", "TI"]], "/", "\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],
 " intervals and never fewer than three (the cubic needs the points):"
}], "Text",ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "noiseGrid", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"noiseGrid", "[", 
    RowBox[{"tf_", ",", " ", "dt_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Subdivide", "[", 
    RowBox[{"0.", ",", " ", "tf", ",", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"3", ",", " ", 
       RowBox[{"Ceiling", "[", 
        RowBox[{"tf", "/", "dt"}], "]"}]}], "]"}]}], "]"}]}], ";"}]}], "Input",\

 CellLabel->
  "In[13]:= ",ExpressionUUID->"51fce014-dca1-0630-0783-fa51d5546d1a"],

Cell[TextData[{
 "Concretely: on that grid, draw i.i.d. Gaussian increments with variance the \
grid spacing, accumulate them into a Wiener path, and interpolate with a \
cubic so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657c1c65-980e-511d-1303-964f19bb2067"],
 " is a continuous curve and its derivative ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["W", "TI"], "\[Prime]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],
 " an ordinary, piecewise-smooth function of time that jumps at the knots, no \
longer the distribution that white noise is:"
}], "Text",ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "wienerFun", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wienerFun", "[", 
    RowBox[{"tf_", ",", " ", "dtGen_", ",", " ", "seed_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"grid", " ", "=", " ", 
         RowBox[{"noiseGrid", "[", 
          RowBox[{"tf", ",", " ", "dtGen"}], "]"}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"incr", " ", "=", " ", 
           RowBox[{"RandomVariate", "[", 
            RowBox[{
             RowBox[{"NormalDistribution", "[", 
              RowBox[{"0", ",", " ", 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{"grid", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
                 RowBox[{"grid", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}], ",", " ", 
             
             RowBox[{
              RowBox[{"Length", "[", "grid", "]"}], " ", "-", " ", "1"}]}], 
            "]"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"Interpolation", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"grid", ",", " ", 
              RowBox[{"Prepend", "[", 
               RowBox[{
                RowBox[{"Accumulate", "[", "incr", "]"}], ",", " ", "0."}], 
               "]"}]}], "}"}], "]"}], ",", " ", 
           RowBox[{"InterpolationOrder", " ", "->", " ", "3"}]}], "]"}]}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"],

Cell["\<\
Visualize one realization of the path and its derivative, the ordinary \
function that stands in for white noise:\
\>", "Text",ExpressionUUID->"1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Wf", " ", "=", " ", 
     RowBox[{"wienerFun", "[", 
      RowBox[{"tfB", ",", " ", 
       RowBox[{"dtGenOf", "[", "ratesB", "]"}], ",", " ", "11"}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", "\n", "   ", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Wf", "[", "t", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "tfB"}], "}"}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", 
         "    ", 
         RowBox[{
         "PlotLabel", " ", "->", 
          " ", "\"\<regularized Wiener path W(t)\>\""}], ",", " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<t\>\"", ",", " ", "\"\<W\>\""}], "}"}]}]}], "]"}], ",",
        "\n", "   ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Wf", "'"}], "[", "t", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "tfB"}], "}"}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", 
         "    ", 
         RowBox[{
         "PlotLabel", " ", "->", 
          " ", "\"\<its derivative W'(t): the smooth noise\>\""}], ",", " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<t\>\"", ",", " ", "\"\<W'\>\""}], "}"}]}]}], "]"}]}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{"ImageSize", " ", "->", " ", "640"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->
  "In[15]:= ",ExpressionUUID->"370294fd-9e49-2d35-5d31-0da71bfc741f"],

