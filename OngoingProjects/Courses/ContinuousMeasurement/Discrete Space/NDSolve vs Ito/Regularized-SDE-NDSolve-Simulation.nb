       RowBox[{"{", 
        RowBox[{
        "6", ",", " ", "12", ",", " ", "25", ",", " ", "100", ",", " ", 
         "400"}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"N", "[", 
