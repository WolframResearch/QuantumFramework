Cell[TextData[{
 "Note that both ensemble means, the built-in ",
 Cell[BoxData["StratonovichProcess"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6334ac9c-43f1-85c0-12cb-45c67585ef2a"],
 " integrator and the regularized route, lie on the exact Lindblad curve \
across the whole interval, not only at the final time. Averaging over the \
trajectories rebuilds the deterministic master equation, which is the sense \
in which the smooth Lindblad flow was an average over jagged records all \
along."
}], "Text",ExpressionUUID->"74397683-04f4-1d4d-1dc7-6fedac816797"],

Cell[TextData[{
 "Quantify \"on the curve\" rather than eyeball it: the largest gap between \
the regularized mean of ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "735e49d5-32a1-4a48-2166-609f47541892"],
 " and the Lindblad value anywhere on the grid, in Monte-Carlo standard \
errors, skipping ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "335d55a2-cf9b-493d-6163-4c0fea2e1807"],
 " where all paths coincide and the standard error vanishes:"
}], "Text",ExpressionUUID->"3bfbbd45-edb8-1b0b-6998-352e844d6651"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"Rest", "[", 
       RowBox[{"noiseGrid", "[", 
        RowBox[{"tfB", ",", " ", 
         RowBox[{"dtGenOf", "[", "ratesB", "]"}]}], "]"}], "]"}]}], ",", " ", 
     
     RowBox[{"lb", " ", "=", " ", 
      RowBox[{"lindbladBloch", "[", 
       RowBox[{"ratesB", ",", " ", 
        RowBox[{"initB", "[", 
         RowBox[{"[", 
          RowBox[{"1", " ", ";;", " ", "3"}], "]"}], "]"}]}], "]"}]}], ",", 
     "\n", "  ", 
     RowBox[{"zc", " ", "=", " ", 
      RowBox[{"regRunB", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", 
         RowBox[{"2", " ", ";;"}], ",", " ", "3"}], "]"}], "]"}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Mean", "[", "zc", "]"}], " ", "-", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"lb", "[", "#", "]"}], "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", "&"}], " ", "/@", " ", "g"}], 
        ")"}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"StandardDeviation", "[", "zc", "]"}], "/", 
       RowBox[{"Sqrt", "[", "nB", "]"}]}], ")"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[29]:= ",ExpressionUUID->"045023ab-c37d-b770-2c6f-baf4f6091a5a"],

Cell[BoxData["2.8190826805882563`"], "Output",
 CellLabel->
  "Out[29]= ",ExpressionUUID->"73e8aeff-5b91-f8f4-2197-47b95e25cade"]
}, Open  ]],

Cell["\<\
This is the worst standardized gap along the whole curve, the \
mean-to-Lindblad distance in units of the Monte-Carlo standard error; it \
stays within the scatter a maximum over hundreds of correlated read-offs \
produces by chance, so the mean sits on the master-equation curve everywhere, \
not merely at the end.\
\>", "Text",ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"],

Cell["\<\
The mean sees only the drift, so it is a weak test. The measurement \
backaction lives in the standard deviation of the final Bloch vector, its \
spread across the ensemble, compared across the two routes:\
\>", "Text",ExpressionUUID->"794a4309-908b-2549-2f4a-5b53213f8f93"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableForm", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"StandardDeviation", "[", 
       RowBox[{"stratRunB", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"1", " ", ";;", " ", "3"}]}], "]"}], "]"}], "]"}], ",", " ", 
      RowBox[{"StandardDeviation", "[", 
       RowBox[{"regRunB", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"1", " ", ";;", " ", "3"}]}], "]"}], "]"}], "]"}]}], "}"}], 
    "]"}], ",", "\n", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", " ", "\"\<y\>\"", ",", " ", "\"\<z\>\""}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Stratonovich\>\"", ",", " ", "\"\<regularized\>\""}], 
       "}"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[30]:= ",ExpressionUUID->"167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      StyleBox["\[Null]",
       ShowStringCharacters->False], 
      TagBox["\<\"Stratonovich\"\>",
       HoldForm], 
      TagBox["\<\"regularized\"\>",
       HoldForm]},
     {
      TagBox["\<\"x\"\>",
       HoldForm], "0.`", "0.`"},
     {
      TagBox["\<\"y\"\>",
       HoldForm], "0.2118333118951556`", "0.21795099453110858`"},
     {
      TagBox["\<\"z\"\>",
       HoldForm], "0.2707247051031512`", "0.2762896026011138`"}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxDividers->{
     "Columns" -> {False, True, {False}, False}, 
      "Rows" -> {False, True, {False}, False}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[2.0999999999999996`]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
