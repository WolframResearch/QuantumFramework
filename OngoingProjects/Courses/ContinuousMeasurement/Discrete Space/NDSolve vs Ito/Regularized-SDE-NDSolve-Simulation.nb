Cell[BoxData[
 RowBox[{
  RowBox[{"regX", " ", "=", " ", 
   RowBox[{"ensemble", "[", 
    RowBox[{"ratesX", ",", " ", "initX", ",", " ", "tfX", ",", " ", 
     RowBox[{"dtGenOf", "[", "ratesX", "]"}], ",", " ", "nX", ",", " ", 
     "7100"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[58]:= ",ExpressionUUID->"7cc522fa-6a93-e579-24fa-bba40f27cc43"],

Cell["\<\
Compare the mean of the final Bloch vector across the three routes:\
\>", "Text",ExpressionUUID->"5b82e386-6ff5-c0ee-09b1-fae009819234"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableForm", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"lindbladBloch", "[", 
        RowBox[{"ratesX", ",", " ", 
         RowBox[{"initX", "[", 
          RowBox[{"[", 
           RowBox[{"1", " ", ";;", " ", "3"}], "]"}], "]"}]}], "]"}], "[", 
       "tfX", "]"}], ",", " ", 
      RowBox[{"Mean", "[", "stratX", "]"}], ",", " ", 
      RowBox[{"Mean", "[", "regX", "]"}]}], "}"}], "]"}], ",", "\n", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
