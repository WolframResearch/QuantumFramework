Notebook[{
Cell[554, 20, 177, 3, 70, "Title",ExpressionUUID->"34a39a2f-b372-ffce-5c50-1388c604c514"],
Cell[734, 25, 2020, 34, 70, "Text",ExpressionUUID->"66ca9132-7812-8248-0ec9-097c79a4d092"],
Cell[2757, 61, 115, 0, 70, "Text",ExpressionUUID->"023b1c4a-5b09-a8c9-33d8-96145ebdfa13"],
