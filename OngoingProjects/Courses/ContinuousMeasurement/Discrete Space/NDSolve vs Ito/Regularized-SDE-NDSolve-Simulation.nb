        ",", " ", "\"\<mean z\>\"", ",", " ", "\"\<spread z\>\""}], "}"}]}], 
     "}"}]}]}], "]"}]}], "Input",
 CellLabel->
  "In[53]:= ",ExpressionUUID->"21fdaace-430e-f3f9-5782-43a876b8c1c3"],

