 RowBox[{
  RowBox[{"stratX", " ", "=", " ", 
   RowBox[{"stratRef", "[", 
    RowBox[{"ratesX", ",", " ", "initX", ",", " ", "tfX", ",", " ", 
     RowBox[{"dtGenOf", "[", "ratesX", "]"}], ",", " ", "nX", ",", " ", 
     "4040"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[57]:= ",ExpressionUUID->"30c454b2-bdb8-e427-60fc-4dfc3432cf0d"],

