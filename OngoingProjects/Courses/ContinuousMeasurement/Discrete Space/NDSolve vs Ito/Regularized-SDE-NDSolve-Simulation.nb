}, Open  ]],

Cell[TextData[{
 "As expected, the mean record climbs along the integrated ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],
 ", the two curves tracking with a residual wander that is the \
ensemble-averaged noise, of order ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["t", "TI"], "/", 
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["traj",
      FontSlant->"Plain"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4289b0c6-8043-1b93-72b6-29a031f669f9"],
 " and not yet fully cancelled at this sample size. The signal is what \
survives averaging; the noise is what does not."
}], "Text",ExpressionUUID->"070f3e08-556d-9d60-2d34-b0525c19e44a"],

Cell["\<\
Turn that visual match into a number: the largest gap between the mean record \
and its prediction anywhere on the grid, in Monte-Carlo standard errors, \
again skipping the start where the record is pinned at zero:\
\>", "Text",ExpressionUUID->"6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"Rest", "[", 
       RowBox[{"noiseGrid", "[", 
        RowBox[{"tfB", ",", " ", 
         RowBox[{"dtGenOf", "[", "ratesB", "]"}]}], "]"}], "]"}]}], ",", " ", 
     
     RowBox[{"qc", " ", "=", " ", 
      RowBox[{"recQB", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", 
         RowBox[{"2", " ", ";;"}]}], "]"}], "]"}]}]}], "}"}], ",", "\n", " ", 
   
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Mean", "[", "qc", "]"}], " ", "-", " ", 
       RowBox[{"(", 
        RowBox[{"qpredB", " ", "/@", " ", "g"}], ")"}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"StandardDeviation", "[", "qc", "]"}], "/", 
       RowBox[{"Sqrt", "[", "nB", "]"}]}], ")"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[40]:= ",ExpressionUUID->"4140e475-1e41-1f16-777f-fe3f9bf4627c"],

Cell[BoxData["1.6626908417121813`"], "Output",
 CellLabel->
  "Out[40]= ",ExpressionUUID->"67f13035-938c-831a-0d8e-aa7f263eee60"]
}, Open  ]],

Cell[TextData[{
 "Again the worst standardized gap along the window: it stays within what \
sampling noise alone produces, so the mean record is the integrated signal \
everywhere on the grid, which is all the average can claim at finite ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["traj",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b44e14-0404-e868-3e4c-605eadb6bab2"],
 "."
}], "Text",ExpressionUUID->"70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],

Cell[TextData[{
 "The record's spread deserves the same two-route treatment as the state's, \
and the native ensemble has been carrying the fourth row all along; read its \
final-",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e10bd94-ae42-3b4d-262f-34d1cbf48997"],
 " spread against the regularized ensemble's, in the same units as before:"
}], "Text",ExpressionUUID->"5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"spreadGap", "[", 
  RowBox[{
   RowBox[{"stratRunB", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", 
      RowBox[{"-", "1"}], ",", " ", "4"}], "]"}], "]"}], ",", " ", 
   RowBox[{"recQB", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", 
      RowBox[{"-", "1"}]}], "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[41]:= ",ExpressionUUID->"013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],

Cell[BoxData["0.9100112979132597`"], "Output",
 CellLabel->
  "Out[41]= ",ExpressionUUID->"4b734859-75e7-efa6-7901-62030393b58c"]
}, Open  ]],

Cell["\<\
The record's final spread agrees between the routes at the sampling scale \
too: beyond its mean and its pathwise identity, the record's spread now has \
an independent reference, so the fourth row is held to the same standard as \
the state.\
\>", "Text",ExpressionUUID->"4ae31c17-eefa-a706-7a90-96508a8c0a6c"],

Cell[TextData[{
 "The average removed the noise, but a single record still carries it, and \
carries a specific one. Since ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["Q", "TI"], "-", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["z", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "=", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00844d77-2817-3ec6-30bc-653149a3842c"],
 " exactly, subtracting the integrated signal from one record must return the \
very Wiener path that drove the state. Build one trajectory, strip its \
signal, and overlay the remainder on its driving path ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20b97f64-b973-0c8a-5047-774e380656d0"],
 ":"
}], "Text",ExpressionUUID->"04469009-6b02-dcc3-2c7d-0a530eb4a629"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", " ", "=", " ", "ratesB"}], ",", " ", 
     RowBox[{"dt", " ", "=", " ", 
      RowBox[{"dtGenOf", "[", "ratesB", "]"}]}], ",", " ", 
     RowBox[{"seed", " ", "=", " ", "7"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Wf", " ", "=", " ", 
        RowBox[{"wienerFun", "[", 
         RowBox[{"tfB", ",", " ", "dt", ",", " ", "seed"}], "]"}]}], ",", " ", 
       RowBox[{"traj", " ", "=", " ", 
        RowBox[{"oneTraj", "[", 
         RowBox[{
         "r", ",", " ", "initB", ",", " ", "tfB", ",", " ", "dt", ",", " ", 
          "seed", ",", " ", 
          RowBox[{"dt", "/", "4"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "t", ",", " ", "zint"}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{
        RowBox[{"zint", " ", "=", " ", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"u", "'"}], "[", "t", "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"traj", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}]}], ",", " ", 
             RowBox[{
              RowBox[{"u", "[", "0", "]"}], " ", "==", " ", "0."}]}], "}"}], ",",
            " ", "u", ",", " ", 
           RowBox[{"{", 
            RowBox[{"t", ",", " ", "0", ",", " ", "tfB"}], "}"}]}], "]"}]}], ";",
         "\n", "   ", 
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"traj", "[", 
               RowBox[{"[", "4", "]"}], "]"}], "[", "t", "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"Sqrt", "[", 
               RowBox[{"r", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", 
              RowBox[{"zint", "[", "t", "]"}]}]}], ",", " ", 
            RowBox[{"Wf", "[", "t", "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "0", ",", " ", "tfB"}], "}"}], ",", "\n", 
          "    ", 
          RowBox[{"PlotStyle", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{"Thick", ",", " ", 
               RowBox[{"ColorData", "[", 
                RowBox[{"97", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", 
             RowBox[{"Directive", "[", 
              RowBox[{"Dashed", ",", " ", "Black"}], "]"}]}], "}"}]}], ",", 
          "\n", "    ", 
          RowBox[{"PlotLegends", " ", "->", " ", 
           RowBox[{"Placed", "[", 
            RowBox[{
             RowBox[{"{", 
              
              RowBox[{"\"\<record minus signal: Q(t) - \!\(\*SqrtBox[\(\
\[CapitalGamma]CI\)]\) \[Integral]z dt\>\"", ",", 
               " ", "\"\<driving path W(t)\>\""}], "}"}], ",", " ", "Below"}],
             "]"}]}], ",", "\n", "    ", 
          RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
          RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
          RowBox[{"FrameLabel", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<t\>\"", ",", " ", "\"\<W\>\""}], "}"}]}], ",", "\n", 
          "    ", 
          RowBox[{
          "PlotLabel", " ", "->", 
           " ", "\"\<stripping the signal from the record returns the driving \
noise\>\""}], ",", " ", 
          RowBox[{"ImageSize", " ", "->", " ", "520"}]}], "]"}]}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[42]:= ",ExpressionUUID->"4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],

