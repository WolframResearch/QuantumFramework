 CellLabel->
  "Out[49]= ",ExpressionUUID->"13ecd9ee-6506-67bb-4193-d0c80cb34d81"]
}, Open  ]],

Cell[TextData[{
 "and its final-",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6724c974-bdf1-27a5-0edb-e13e3b858d8f"],
 " spread, the number the regularized route must reproduce as the grid \
tightens:"
}], "Text",ExpressionUUID->"2b52875c-0948-9ae8-5961-1f06a8e2e832"],

