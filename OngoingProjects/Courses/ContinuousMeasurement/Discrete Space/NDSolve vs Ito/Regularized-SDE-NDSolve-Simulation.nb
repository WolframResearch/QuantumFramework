     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", " ", "\"\<y\>\"", ",", " ", "\"\<z\>\""}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Lindblad\>\"", ",", " ", "\"\<Stratonovich\>\"", ",", 
        " ", "\"\<regularized\>\""}], "}"}]}], "}"}]}]}], "]"}]], "Input",
