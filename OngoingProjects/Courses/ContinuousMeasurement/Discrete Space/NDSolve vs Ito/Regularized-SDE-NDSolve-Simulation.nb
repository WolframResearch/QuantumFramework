Cell[TextData[{
 "Notice that the stripped record lands on the driving path to the width of \
the line. This is the physical content of a measurement made literal: the \
fluctuations in the record are not merely correlated with the noise that \
kicked the state, they are that noise. The observer reads ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   StyleBox["z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12b61bfc-9cd7-eca9-424d-92a61563b6f3"],
 " as signal; the remainder is the single innovation ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "451364b5-819d-fb99-7321-7dff3029c9e3"],
 " the detector wrote into the record and the backaction at once."
}], "Text",ExpressionUUID->"13b49e24-0fb7-4441-414b-178eaa422eab"],

Cell["\<\
Rather than trust the line width, put a number on it, the largest gap between \
the stripped record and the driving path across the window; define the \
residual once, its solver goals adjustable, and read it at the default \
tolerance:\
\>", "Text",ExpressionUUID->"445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "recordResidual", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"recordResidual", "[", "goal_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", " ", "=", " ", "ratesB"}], ",", " ", 
       RowBox[{"dt", " ", "=", " ", 
        RowBox[{"dtGenOf", "[", "ratesB", "]"}]}], ",", " ", 
       RowBox[{"seed", " ", "=", " ", "7"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Wf", " ", "=", " ", 
          RowBox[{"wienerFun", "[", 
           RowBox[{"tfB", ",", " ", "dt", ",", " ", "seed"}], "]"}]}], ",", 
         " ", 
         RowBox[{"traj", " ", "=", " ", 
          RowBox[{"oneTraj", "[", 
           RowBox[{
           "r", ",", " ", "initB", ",", " ", "tfB", ",", " ", "dt", ",", " ", 
            "seed", ",", " ", 
            RowBox[{"dt", "/", "4"}], ",", " ", "goal"}], "]"}]}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"u", ",", " ", "t", ",", " ", "zint"}], "}"}], ",", "\n", 
         "     ", 
         RowBox[{
          RowBox[{"zint", " ", "=", " ", 
           RowBox[{"NDSolveValue", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"u", "'"}], "[", "t", "]"}], " ", "==", " ", 
                RowBox[{
                 RowBox[{"traj", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}]}], ",", " ", 
               RowBox[{
                RowBox[{"u", "[", "0", "]"}], " ", "==", " ", "0."}]}], "}"}],
              ",", " ", "u", ",", " ", 
             RowBox[{"{", 
              RowBox[{"t", ",", " ", "0", ",", " ", "tfB"}], "}"}], ",", "\n",
              "       ", 
             RowBox[{"AccuracyGoal", " ", "->", " ", "goal"}], ",", " ", 
             RowBox[{"PrecisionGoal", " ", "->", " ", "goal"}]}], "]"}]}], ";",
           "\n", "     ", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"s", " ", "=", " ", 
              RowBox[{"Subdivide", "[", 
               RowBox[{"0.", ",", " ", "tfB", ",", " ", "1000"}], "]"}]}], 
             "}"}], ",", "\n", "      ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"traj", "[", 
                 RowBox[{"[", "4", "]"}], "]"}], "[", "s", "]"}], " ", "-", 
               " ", 
               RowBox[{
                RowBox[{"Sqrt", "[", 
                 RowBox[{"r", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", 
                RowBox[{"zint", "[", "s", "]"}]}], " ", "-", " ", 
               RowBox[{"Wf", "[", "s", "]"}]}], "]"}], "]"}]}], "]"}]}]}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"recordResidual", "[", "Automatic", "]"}]}], "Input",
 CellLabel->
  "In[43]:= ",ExpressionUUID->"089aa42d-ce49-3603-38b9-3e76ebfd9d69"],

Cell[BoxData["1.2859111055973926`*^-6"], "Output",
 CellLabel->
  "Out[43]= ",ExpressionUUID->"48fccab3-b886-a0f7-7883-e3fd3930f2dd"]
}, Open  ]],

Cell[TextData[{
 "The residual is pure solver error, and note what this cell is: the same ODE \
defines ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["Q", "TI"], "\[Prime]"], "=", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["z", "TI"], "+", 
   SuperscriptBox[
    StyleBox["W", "TI"], "\[Prime]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cdaad60-2181-5e26-34f9-454a5034250c"],
 ", so stripping the signal is a self-consistency check that the integrator \
preserves the defining record identity, not an independent validation of the \
route. If that reading is right, the residual must fall when the solver is \
asked for more digits. Rerun the same trajectory with ",
 Cell[BoxData["AccuracyGoal"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "542cff75-84e0-b601-7dd3-f73f2c9a1d6b"],
 " and ",
 Cell[BoxData["PrecisionGoal"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00dd9d4d-f7ec-565f-30e2-151681993ca5"],
 " tightened:"
}], "Text",ExpressionUUID->"0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"recordResidual", "[", "10", "]"}]], "Input",
 CellLabel->
  "In[44]:= ",ExpressionUUID->"3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],

Cell[BoxData["3.737804293857394`*^-8"], "Output",
 CellLabel->
  "Out[44]= ",ExpressionUUID->"333832e2-8bec-4128-62c7-abcc2d991072"]
}, Open  ]],

Cell["\<\
The residual falls with the tolerance, confirming it is integration error and \
nothing else: the record minus its signal is the driving noise as an \
identity, at whatever precision the solver is asked to keep.\
\>", "Text",ExpressionUUID->"78cf51d6-d7cd-4672-28f5-4893e2782d58"],

Cell[TextData[{
 "One regime makes the tie between the state and its record total. Switch off \
relaxation and drive, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "=", 
   SubscriptBox["\[CapitalOmega]", 
    StyleBox["x", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],
 ", and leave everything else alone: backaction, dephasing, any efficiency. \
Those only kick the phase, never the population, so dividing the Stratonovich \
",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "710db4a8-d877-0db2-2732-2df5d9025798"],
 " row by ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[
    StyleBox["z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e12f72-3ad4-a92f-279e-c73cbf66f875"],
 " turns the ordinary chain rule loose, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], " ", 
   StyleBox["arctanh",
    FontSlant->"Plain"], " ", 
   StyleBox["z", "TI"], "=", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], " ", 
   StyleBox["z", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"], "=", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ea8612-dd18-b4f0-2ee9-185fd4921eda"],
 ", and the monitored component becomes a closed function of its own \
accumulated record, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["tanh",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["arctanh",
     FontSlant->"Plain"], " ", 
    SubscriptBox[
     StyleBox["z", "TI"], "0"], "+", 
    SqrtBox[
     SubscriptBox["\[CapitalGamma]", 
      StyleBox[
       RowBox[{"C", "I"}], "TI"]]], " ", 
    StyleBox["Q", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b02f270-2101-5c3d-3931-f43a50b42707"],
 ", exactly and pathwise. In other words, with nothing but measurement \
acting, the record is a complete log of the state. First check the \
differential identity on the whole symbolic flow, the formal ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],
 " standing in for the noise:"
}], "Text",ExpressionUUID->"669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rFree", " ", "=", " ", 
     RowBox[{"ReplacePart", "[", 
      RowBox[{"ratesSym", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"5", " ", "->", " ", "0"}], ",", " ", 
         RowBox[{"6", " ", "->", " ", "0"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"driftStrat", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], "}"}],
            ",", " ", "rFree"}], "]"}], "[", 
         RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"diffStrat", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], 
             "}"}], ",", " ", "rFree"}], "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", "w"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"z", "^", "2"}]}], ")"}]}], " ", "-", "\n", "   ", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"rFree", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"driftStrat", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], "}"}],
            ",", " ", "rFree"}], "]"}], "[", 
         RowBox[{"[", "4", "]"}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"diffStrat", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], 
             "}"}], ",", " ", "rFree"}], "]"}], "[", 
          RowBox[{"[", "4", "]"}], "]"}], " ", "w"}]}], ")"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[45]:= ",ExpressionUUID->"5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],

Cell[BoxData["0"], "Output",
 CellLabel->
  "Out[45]= ",ExpressionUUID->"66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"]
}, Open  ]],

Cell[TextData[{
 "The identity holds with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], ",", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e73fafe-05d0-7203-6600-f3b8ac654169"],
 " fully symbolic: reading the state off the record is filtering, and the \
trajectory does it at any efficiency; only relaxation or a drive can decouple \
",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],
 " from its own record. Now read the largest violation along one regularized \
path, at a bare-measurement rate set that sits exactly on the admissibility \
boundary, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "=", "2", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c044c4-b778-74e1-42f0-5da1c20d5ecb"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d9aa029-60a8-273a-6bb9-3a7311428a00"],
 "; make the residual's solver goals adjustable, like the record residual \
above:"
}], "Text",ExpressionUUID->"64adc082-4122-deff-0c52-d9ec70d4a4c5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"rG", ",", " ", "tanhResidual"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rG", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0.352", ",", " ", "0.", ",", " ", "0.176", ",", " ", "0.", ",", " ", 
     "0.", ",", " ", "0."}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tanhResidual", "[", "goal_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z0", " ", "=", " ", "0.6"}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tr", " ", "=", " ", 
          RowBox[{"oneTraj", "[", 
           RowBox[{"rG", ",", " ", 
            RowBox[{"{", 
             RowBox[{"0.", ",", " ", "0.", ",", " ", "z0", ",", " ", "0."}], 
             "}"}], ",", " ", "tfB", ",", " ", 
            RowBox[{"dtGenOf", "[", "rG", "]"}], ",", " ", "11", ",", " ", 
            RowBox[{
             RowBox[{"dtGenOf", "[", "rG", "]"}], "/", "4"}], ",", " ", 
            "goal"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{"s", " ", "=", " ", 
          RowBox[{"Subdivide", "[", 
           RowBox[{"0.", ",", " ", "tfB", ",", " ", "1000"}], "]"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"tr", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "[", "s", "]"}], " ", "-", " ", 
          RowBox[{"Tanh", "[", 
           RowBox[{
            RowBox[{"ArcTanh", "[", "z0", "]"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{"rG", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", 
             RowBox[{
              RowBox[{"tr", "[", 
               RowBox[{"[", "4", "]"}], "]"}], "[", "s", "]"}]}]}], "]"}]}], 
         "]"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"tanhResidual", "[", "Automatic", "]"}]}], "Input",
 CellLabel->
  "In[46]:= ",ExpressionUUID->"7e451771-8a55-ceec-267a-8f3b2fe19436"],

Cell[BoxData["1.1700755728205614`*^-6"], "Output",
 CellLabel->
  "Out[46]= ",ExpressionUUID->"4670f053-f537-0b3f-6e0f-ea1cfcc25605"]
}, Open  ]],

Cell["\<\
Tighten the goals and the violation must follow the solver, not the noise \
grid:\
\>", "Text",ExpressionUUID->"330aabc0-bdd5-22a3-6109-42aa34607089"],

