Cell[TextData[{
 "The formula determines the monitored component ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],
 ", not by itself the entire Bloch vector. First check the differential \
identity on the symbolic flow, with the formal ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "333832e2-8bec-4128-62c7-abcc2d991072"],
 " standing in for the regularized noise:"
}], "Text",ExpressionUUID->"78cf51d6-d7cd-4672-28f5-4893e2782d58"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rFree", " ", "=", " ", 
     RowBox[{"ReplacePart", "[", 
      RowBox[{"ratesSym", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"5", " ", "->", " ", "0"}], ",", " ", 
         RowBox[{"6", " ", "->", " ", "0"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"driftStrat", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], "}"}],
            ",", " ", "rFree"}], "]"}], "[", 
         RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"diffStrat", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], 
             "}"}], ",", " ", "rFree"}], "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", "w"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"z", "^", "2"}]}], ")"}]}], " ", "-", "\n", "   ", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"rFree", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"driftStrat", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], "}"}],
            ",", " ", "rFree"}], "]"}], "[", 
         RowBox[{"[", "4", "]"}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"diffStrat", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], 
             "}"}], ",", " ", "rFree"}], "]"}], "[", 
          RowBox[{"[", "4", "]"}], "]"}], " ", "w"}]}], ")"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[46]:= ",ExpressionUUID->"1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],

Cell[TextData[{
 "The identity holds with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], ",", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "710db4a8-d877-0db2-2732-2df5d9025798"],
 " symbolic: only relaxation or a drive breaks this closed relation between \
",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e12f72-3ad4-a92f-279e-c73cbf66f875"],
 " and ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ea8612-dd18-b4f0-2ee9-185fd4921eda"],
 ". The numerical example uses ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Q", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b02f270-2101-5c3d-3931-f43a50b42707"],
 " and a bare-measurement rate set on the admissibility boundary, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "=", "2", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],
 ":"
}], "Text",ExpressionUUID->"5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"rG", ",", " ", "tanhResidual"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rG", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0.352", ",", " ", "0.", ",", " ", "0.176", ",", " ", "0.", ",", " ", 
     "0.", ",", " ", "0."}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tanhResidual", "[", "goal_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z0", " ", "=", " ", "0.6"}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tr", " ", "=", " ", 
          RowBox[{"oneTraj", "[", 
           RowBox[{"rG", ",", " ", 
            RowBox[{"{", 
             RowBox[{"0.", ",", " ", "0.", ",", " ", "z0", ",", " ", "0."}], 
             "}"}], ",", " ", "tfB", ",", " ", 
            RowBox[{"dtGenOf", "[", "rG", "]"}], ",", " ", "11", ",", " ", 
            RowBox[{
             RowBox[{"dtGenOf", "[", "rG", "]"}], "/", "4"}], ",", " ", 
            "goal"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{"s", " ", "=", " ", 
          RowBox[{"Subdivide", "[", 
           RowBox[{"0.", ",", " ", "tfB", ",", " ", "1000"}], "]"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"tr", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "[", "s", "]"}], " ", "-", " ", 
          RowBox[{"Tanh", "[", 
           RowBox[{
            RowBox[{"ArcTanh", "[", "z0", "]"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{"rG", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", 
             RowBox[{
              RowBox[{"tr", "[", 
               RowBox[{"[", "4", "]"}], "]"}], "[", "s", "]"}]}]}], "]"}]}], 
         "]"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"tanhResidual", "[", "Automatic", "]"}]}], "Input",
 CellLabel->
  "In[47]:= ",ExpressionUUID->"66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],

Cell["\<\
Tighten the goals and the violation must follow the solver, not the noise \
grid:\
\>", "Text",ExpressionUUID->"3e73fafe-05d0-7203-6600-f3b8ac654169"],

Cell[BoxData[
 RowBox[{"tanhResidual", "[", "10", "]"}]], "Input",
 CellLabel->
  "In[48]:= ",ExpressionUUID->"7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],

Cell[TextData[{
 "It falls with the tolerance. For each regularized path, the ordinary chain \
rule makes the identity exact independently of the white-noise limit. In this \
regime the monitored coordinate ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c044c4-b778-74e1-42f0-5da1c20d5ecb"],
 " is the record read through a ",
 Cell[BoxData[
  StyleBox["tanh",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d9aa029-60a8-273a-6bb9-3a7311428a00"],
 "."
}], "Text",ExpressionUUID->"64adc082-4122-deff-0c52-d9ec70d4a4c5"],

Cell["The two time steps: which one sets the answer", "Section",ExpressionUUID->"7e451771-8a55-ceec-267a-8f3b2fe19436"],

Cell[TextData[{
 "The simulation uses two distinct time increments: the noise-grid spacing ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4670f053-f537-0b3f-6e0f-ea1cfcc25605"],
 " and ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "330aabc0-bdd5-22a3-6109-42aa34607089"],
 "'s maximum integration step. Which one controls the numerical result? Test \
the integration step first by holding the noise grid, the noise realizations, \
and the solver goals fixed, then comparing the final-",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],
 " mean and spread for two step caps: ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d705b8-410a-1477-20ec-9ce270bf7f5d"],
 " and ",
 Cell[BoxData[
  RowBox[{"10", "\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "737c509e-bc52-eefb-2104-49d835e4b4c1"],
 ". The first row uses the stored ensemble; the second recomputes the same \
trajectories with the relaxed step cap:"
}], "Text",ExpressionUUID->"01a44b6b-c85f-9e0e-375c-6334e9ebe554"],

Cell[BoxData[
 RowBox[{"TableForm", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Mean", "[", "#", "]"}], "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"StandardDeviation", "[", "#", "]"}], "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], "}"}], " ", "&"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"regRunB", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"1", " ", ";;", " ", "3"}]}], "]"}], "]"}], ",", "\n", 
       "   ", 
       RowBox[{"ensemble", "[", 
        RowBox[{"ratesB", ",", " ", "initB", ",", " ", "tfB", ",", " ", 
         RowBox[{"dtGenOf", "[", "ratesB", "]"}], ",", " ", "nB", ",", " ", 
         "9100", ",", " ", 
         RowBox[{"10", " ", 
          RowBox[{"dtGenOf", "[", "ratesB", "]"}]}], ",", " ", "5"}], "]"}]}],
       "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<step \!\(\*SubscriptBox[\(\[CapitalDelta]t\), \
\(gen\)]\)/4\>\"", ",", "\n", 
        "    ", "\"\<step 10 \!\(\*SubscriptBox[\(\[CapitalDelta]t\), \
\(gen\)]\)\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<mean z\>\"", ",", " ", "\"\<spread z\>\""}], "}"}]}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[49]:= ",ExpressionUUID->"10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],

Cell[TextData[{
 "The same seeds generate the same interpolated paths in both rows. For this \
parameter set and these observables, relaxing the cap moves the mean and the \
spread by far less than their Monte-Carlo uncertainties; the residual \
difference between the rows is solver error at the production goals, not a \
noise-discretization effect. This is a case-specific sensitivity check, not \
evidence that ",
 Cell[BoxData["MaxStepSize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25120901-cfbc-a8e6-5321-a16aea4efacc"],
 " is generally irrelevant."
}], "Text",ExpressionUUID->"3ee7491f-72c3-8814-669d-61590777db7e"],

Cell[TextData[{
 "The regularization dial is ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67860241-8011-89c8-0dbd-a42b31a5db12"],
 ", and the native ",
 Cell[BoxData["StratonovichProcess"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1318f44b-7a0d-b86f-4127-ee157fb90ab5"],
 " ensemble supplies a finite-step reference. Read its final-",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "221ecbfd-1ed7-d323-5225-e2a79b63be09"],
 " mean:"
}], "Text",ExpressionUUID->"3f067a83-888f-4db3-653e-73ed293a1799"],

Cell[BoxData[
 RowBox[{"Mean", "[", 
  RowBox[{"stratRunB", "[", 
   RowBox[{"[", 
    RowBox[{"All", ",", " ", 
     RowBox[{"-", "1"}], ",", " ", "3"}], "]"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[50]:= ",ExpressionUUID->"287fc527-5526-9e30-5804-dc815cd0e51a"],

Cell[TextData[{
 "and its final-",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2207e002-80f7-0285-523c-fa6c308250ef"],
 " spread, the number the regularized route must reproduce as the grid \
tightens:"
}], "Text",ExpressionUUID->"440467ae-8db5-79b4-6c3c-7e0824404b9e"],

Cell[BoxData[
 RowBox[{"StandardDeviation", "[", 
  RowBox[{"stratRunB", "[", 
   RowBox[{"[", 
    RowBox[{"All", ",", " ", 
     RowBox[{"-", "1"}], ",", " ", "3"}], "]"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[51]:= ",ExpressionUUID->"141585f4-d1c1-5bbd-3c2a-1cb1e0742987"],

Cell["\<\
Check the native integrator at three step sizes. The runs use the same \
integer seed, but changing the step changes how random numbers are consumed, \
so they should be treated as separate Monte Carlo samples rather than \
pathwise-coupled trajectories:\
\>", "Text",ExpressionUUID->"3d27d006-86b8-9131-64dc-ca603332e01b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"natZB", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"stratRef", "[", 
         RowBox[{"ratesB", ",", " ", "initB", ",", " ", "tfB", ",", " ", 
          RowBox[{
           RowBox[{"dtGenOf", "[", "ratesB", "]"}], "/", "f"}], ",", " ", 
          "nB", ",", " ", "2024"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"f", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"stratRunB", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", 
        RowBox[{"-", "1"}], ",", " ", "3"}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"dtGenOf", "[", "ratesB", "]"}], "/", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "4"}], "}"}]}], ",", " ", 
      RowBox[{"StandardDeviation", " ", "/@", " ", "natZB"}]}], "}"}], "]"}], 
   ",", "\n", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<dt\>\"", ",", " ", "\"\<spread z\>\""}], "}"}]}], 
     "}"}]}]}], "]"}]}], "Input",
 CellLabel->
  "In[52]:= ",ExpressionUUID->"3e44340b-ef5c-51d5-667b-ae548ae9233f"],

Cell["\<\
Read the two refined rows as distances from the working-step row, in units of \
the estimates' sampling errors in quadrature:\
\>", "Text",ExpressionUUID->"321034f4-436e-dcec-622f-adbe7618a636"],

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"spreadGap", "[", 
       RowBox[{"#", ",", " ", 
        RowBox[{"First", "[", "natZB", "]"}]}], "]"}], "}"}], " ", "&"}], " ",
     "/@", " ", 
    RowBox[{"Rest", "[", "natZB", "]"}]}], ",", "\n", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<dt/2\>\"", ",", " ", "\"\<dt/4\>\""}], "}"}], ",", " ", 
      RowBox[{"{", "\"\<Spread gap in z\>\"", "}"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[53]:= ",ExpressionUUID->"1287d3f9-6500-de4e-42bc-caa30cbaa494"],

Cell["\<\
The refined estimates show no resolved trend relative to their Monte Carlo \
uncertainty. That supports using the working step as a practical reference at \
this sample size, but it does not prove convergence.\
\>", "Text",ExpressionUUID->"3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],

Cell[TextData[{
 "Now sweep ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
