}, Open  ]],

Cell[TextData[{
 "It falls with the tolerance: under the Stratonovich reading the chain rule \
is exact at any ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "737c509e-bc52-eefb-2104-49d835e4b4c1"],
 ", so nothing about this identity waits for the white-noise limit. Where the \
general case shares one noise between state and record, this regime goes \
further: the state is the record, read through a ",
 Cell[BoxData[
  StyleBox["tanh",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01a44b6b-c85f-9e0e-375c-6334e9ebe554"],
 "."
}], "Text",ExpressionUUID->"10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],

Cell["The two time steps: which one sets the answer", "Section",ExpressionUUID->"25120901-cfbc-a8e6-5321-a16aea4efacc"],

Cell[TextData[{
 "The route carries two time increments, and the section title is a real \
question: which of them moves the answer? Put the integrator step to the test \
first. Hold the noise grid fixed and read the final-",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ee7491f-72c3-8814-669d-61590777db7e"],
 " mean and spread with the ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67860241-8011-89c8-0dbd-a42b31a5db12"],
 " step held far below ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1318f44b-7a0d-b86f-4127-ee157fb90ab5"],
 ", then again with it pushed well above; the first row reads the run already \
stored, the second re-integrates the same noise with the cap relaxed:"
}], "Text",ExpressionUUID->"221ecbfd-1ed7-d323-5225-e2a79b63be09"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableForm", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Mean", "[", "#", "]"}], "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"StandardDeviation", "[", "#", "]"}], "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], "}"}], " ", "&"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"regRunB", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"1", " ", ";;", " ", "3"}]}], "]"}], "]"}], ",", "\n", 
       "   ", 
       RowBox[{"ensemble", "[", 
        RowBox[{"ratesB", ",", " ", "initB", ",", " ", "tfB", ",", " ", 
         RowBox[{"dtGenOf", "[", "ratesB", "]"}], ",", " ", "nB", ",", " ", 
         "9100", ",", " ", 
         RowBox[{"10", " ", 
          RowBox[{"dtGenOf", "[", "ratesB", "]"}]}]}], "]"}]}], "}"}]}], 
    "]"}], ",", "\n", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<step \!\(\*SubscriptBox[\(\[CapitalDelta]t\), \
\(gen\)]\)/4\>\"", ",", "\n", 
        "    ", "\"\<step 10 \!\(\*SubscriptBox[\(\[CapitalDelta]t\), \
\(gen\)]\)\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<mean z\>\"", ",", " ", "\"\<spread z\>\""}], "}"}]}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[48]:= ",ExpressionUUID->"3f067a83-888f-4db3-653e-73ed293a1799"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      StyleBox["\[Null]",
       ShowStringCharacters->False], 
      TagBox["\<\"mean z\"\>",
       HoldForm], 
      TagBox["\<\"spread z\"\>",
       HoldForm]},
     {
      TagBox["\<\"step \\!\\(\\*SubscriptBox[\\(\[CapitalDelta]t\\), \
\\(gen\\)]\\)/4\"\>",
       HoldForm], "0.15488995691785581`", "0.2762896026011138`"},
     {
      TagBox["\<\"step 10 \\!\\(\\*SubscriptBox[\\(\[CapitalDelta]t\\), \
\\(gen\\)]\\)\"\>",
       HoldForm], "0.1548899613299345`", "0.27628960739213504`"}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxDividers->{
     "Columns" -> {False, True, {False}, False}, 
      "Rows" -> {False, True, {False}, False}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[2.0999999999999996`]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   {OutputFormsDump`HeadedRows, OutputFormsDump`HeadedColumns}],
  Function[BoxForm`e$, 
   TableForm[
   BoxForm`e$, 
    TableHeadings -> {{
      "step \!\(\*SubscriptBox[\(\[CapitalDelta]t\), \(gen\)]\)/4", 
       "step 10 \!\(\*SubscriptBox[\(\[CapitalDelta]t\), \(gen\)]\)"}, {
      "mean z", "spread z"}}]]]], "Output",
 CellLabel->
  "Out[48]= ",ExpressionUUID->"287fc527-5526-9e30-5804-dc815cd0e51a"]
}, Open  ]],

Cell[TextData[{
 "As one can see, with the same noise realizations under both, the two rows \
coincide to solver precision: for this parameter set and ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2207e002-80f7-0285-523c-fa6c308250ef"],
 "'s default tolerances, its adaptive error control refines the step wherever \
",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["W", "TI"], "\[Prime]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "440467ae-8db5-79b4-6c3c-7e0824404b9e"],
 " varies, so relaxing ",
 Cell[BoxData["MaxStepSize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141585f4-d1c1-5bbd-3c2a-1cb1e0742987"],
 " from a quarter of ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d27d006-86b8-9131-64dc-ca603332e01b"],
 " to ten times it leaves the observables unmoved. We still cap it below ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e44340b-ef5c-51d5-667b-ae548ae9233f"],
 " as a cheap guarantee, not because this run needs it, and it is not the \
binding dial."
}], "Text",ExpressionUUID->"321034f4-436e-dcec-622f-adbe7618a636"],

Cell[TextData[{
 "The binding dial is ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1287d3f9-6500-de4e-42bc-caa30cbaa494"],
 ", and the native ",
 Cell[BoxData["StratonovichProcess"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],
 " ensemble is the reference the shrinking grid should approach. Read its \
final-",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087f5f2f-6486-1b59-3805-56890d3369a3"],
 " mean:"
}], "Text",ExpressionUUID->"7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],

