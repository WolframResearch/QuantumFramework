Cell[84788, 2547, 434, 8, 70, "Text",ExpressionUUID->"669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],
Cell[85225, 2557, 899, 23, 70, "Input",ExpressionUUID->"5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],
Cell[86127, 2582, 234, 4, 70, "Text",ExpressionUUID->"66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],
Cell[86364, 2588, 119, 0, 70, "Section",ExpressionUUID->"3e73fafe-05d0-7203-6600-f3b8ac654169"],
Cell[86486, 2590, 2051, 57, 70, "Text",ExpressionUUID->"7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],
