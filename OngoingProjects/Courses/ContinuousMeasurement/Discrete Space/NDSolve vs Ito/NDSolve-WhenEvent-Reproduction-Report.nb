Cell["\<\
Now the invariant. Run one more ensemble with the projection turned off, at a \
coarser step so any overshoot is visible:\
\>", "Text",ExpressionUUID->"055bc2ad-6b92-a3be-3378-dbf70e24f184"],

Cell[BoxData[
 RowBox[{
  RowBox[{"emBnp", " ", "=", " ", 
   RowBox[{"emEnsemble", "[", 
    RowBox[{"ratesB", ",", " ", "initB", ",", " ", "tfB", ",", " ", 
     RowBox[{"tfB", "/", "50"}], ",", " ", "nB", ",", " ", "2024", ",", " ", 
     "False"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"2b0fb60e-2211-365f-5934-286857a59ca5"],

Cell["\<\
Compare the largest Bloch radius reached along the way. The projected \
Euler-Maruyama holds the ball to machine precision, the native SRK overshoots \
it a little (it is not norm-preserving), and the unprojected Euler-Maruyama \
overshoots more, since off the sphere the noise is no longer tangent and \
nothing pulls the state back:\
\>", "Text",ExpressionUUID->"201a2509-bdd9-2fa1-5039-bd53346c758b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<EM proj maxr\>\"", " ", "->", " ", 
    RowBox[{"emB", "[", "\"\<maxr\>\"", "]"}]}], ",", " ", 
   RowBox[{"\"\<Ito maxr\>\"", " ", "->", " ", 
    RowBox[{"itoB", "[", "\"\<maxr\>\"", "]"}]}], ",", " ", 
   RowBox[{"\"\<EM noProj maxr\>\"", " ", "->", " ", 
    RowBox[{"emBnp", "[", "\"\<maxr\>\"", "]"}]}]}], "}"}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"7085d256-6adc-aa08-20ba-d4100f6ef952"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"EM proj maxr\"\>", "\[Rule]", "1.0000000000000002`"}], ",", 
   RowBox[{"\<\"Ito maxr\"\>", "\[Rule]", "1.0000314594801312`"}], ",", 
   RowBox[{"\<\"EM noProj maxr\"\>", "\[Rule]", "1.1820130592833669`"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[20]= ",ExpressionUUID->"5f932952-49a5-d34f-05a0-c11c6851a195"]
}, Open  ]],

Cell[TextData[{
 "The projected value is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "160f17c4-d31a-fe19-3e34-8ea1e6acc563"],
 " to machine precision (the projection holds the ball exactly); the native \
SRK sits a hair above ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10beb8bd-bdb6-ee93-4045-31e73440b4f9"],
 ", its small non-norm-preserving overshoot; and the unprojected value sits \
clearly above ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fdc991b-fead-14b0-65e3-1144fb587e9a"],
 ", since without the projection the off-sphere overshoot is never corrected. \
Here the case is gentle, so the excursion stays bounded; the outright runaway \
is the stiff regime below, where a coarse step falls below the stability \
threshold."
}], "Text",ExpressionUUID->"3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],

Cell["Giving the check teeth: the second moment", "Section",ExpressionUUID->"0642d375-09f3-9942-2e71-cb3faf87eba8"],

Cell[TextData[{
 "Because the mean is diffusion-blind, matching it certifies only the drift. \
The measurement backaction lives in the ",
 StyleBox["second", "TI"],
 " moment, the spread of the final ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0651775d-2bad-791b-2e6f-6f074e584861"],
 " across paths. A small helper reads that spread off an ensemble:"
}], "Text",ExpressionUUID->"63b9e3d6-2298-231e-1146-fa9057128e64"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"stdFin", "[", "a_", "]"}], " ", ":=", " ", 
   RowBox[{"StandardDeviation", "[", 
    RowBox[{
     RowBox[{"a", "[", "\"\<zTrajs\>\"", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", 
       RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"],

Cell[TextData[{
 "To show the spread has teeth, build a deliberately wrong SDE: keep the \
drift but halve the diffusion, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"], "\[Function]", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c440104-ea8a-4285-747b-99618f3f10ef"],
 ". The mean is unchanged (it only sees the drift), so this cannot be caught \
by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c9a615-af45-c085-0ef6-385ecaf192ef"],
 ":"
}], "Text",ExpressionUUID->"0513e607-0f4c-1e20-3320-f861aaf9650a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"halfProc", " ", "=", " ", 
   RowBox[{"ItoProcess", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"driftV", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[FormalX]", "[", "t", "]"}], ",", " ", 
           RowBox[{"\[FormalY]", "[", "t", "]"}], ",", " ", 
           RowBox[{"\[FormalZ]", "[", "t", "]"}]}], "}"}], ",", " ", 
         "ratesB"}], "]"}], ",", "\n", "    ", 
       RowBox[{"List", " ", "/@", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"diffV", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[FormalX]", "[", "t", "]"}], ",", " ", 
              RowBox[{"\[FormalY]", "[", "t", "]"}], ",", " ", 
              RowBox[{"\[FormalZ]", "[", "t", "]"}]}], "}"}], ",", " ", 
            "ratesB"}], "]"}], "/", "2"}], ")"}]}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[FormalX]", "[", "t", "]"}], ",", " ", 
         RowBox[{"\[FormalY]", "[", "t", "]"}], ",", " ", 
         RowBox[{"\[FormalZ]", "[", "t", "]"}]}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[FormalX]", ",", " ", "\[FormalY]", ",", " ", "\[FormalZ]"}], "}"}],
        ",", " ", "initB"}], "}"}], ",", " ", "t"}], "]"}]}], ";"}]], "Input",\

 CellLabel->
  "In[22]:= ",ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"],

Cell[TextData[{
 "Integrate this wrong process and keep the final ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6833ae6a-6ac5-a2c8-19c0-40340f71f012"],
 " of each path:"
}], "Text",ExpressionUUID->"5f7f2999-1aee-25a5-0504-c0c39e988f8f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"halfFin", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"BlockRandom", "[", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "2024", "]"}], ";", "\n", "    ", 
        RowBox[{"RandomFunction", "[", 
         RowBox[{"halfProc", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "tfB", ",", " ", 
            RowBox[{"tfB", "/", "600"}]}], "}"}], ",", " ", "nB", ",", "\n", 
          "      ", 
          RowBox[{
          "Method", " ", "->", 
           " ", "\"\<StochasticRungeKuttaScalarNoise\>\""}]}], "]"}]}], "]"}],
       "[", "\"\<ValueList\>\"", "]"}], ")"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", 
      RowBox[{"-", "1"}], ",", " ", "3"}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"128c7526-c883-085d-42b4-6c83e9365aa7"],

Cell["\<\
Compare the standard deviations. The Euler-Maruyama spread matches the native \
Ito spread, while the half-diffusion spread is clearly smaller, even though \
its mean still sits on the Lindblad value:\
\>", "Text",ExpressionUUID->"3279c00f-c9e2-8758-6206-da68ef94eda2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Std Ito\>\"", " ", "->", " ", 
    RowBox[{"stdFin", "[", "itoB", "]"}]}], ",", " ", 
   RowBox[{"\"\<Std EM\>\"", " ", "->", " ", 
    RowBox[{"stdFin", "[", "emB", "]"}]}], ",", "\n", " ", 
   RowBox[{"\"\<Std half-diffusion\>\"", " ", "->", " ", 
    RowBox[{"StandardDeviation", "[", "halfFin", "]"}]}], ",", "\n", " ", 
   RowBox[{"\"\<half-diffusion mean (still matches)\>\"", " ", "->", " ", 
    RowBox[{"Mean", "[", "halfFin", "]"}]}]}], "}"}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"50b12ff8-e606-85f7-004e-c6a593b0efdd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Std Ito\"\>", "\[Rule]", "0.2772128826176653`"}], ",", 
   RowBox[{"\<\"Std EM\"\>", "\[Rule]", "0.2679429149621552`"}], ",", 
   RowBox[{"\<\"Std half-diffusion\"\>", "\[Rule]", "0.14478486032160445`"}], 
   ",", 
   RowBox[{"\<\"half-diffusion mean (still matches)\"\>", "\[Rule]", 
    "0.1500501234026085`"}]}], "}"}]], "Output",
 CellLabel->
  "Out[24]= ",ExpressionUUID->"640f47a5-4648-c62d-0c35-5e0f73e2ad77"]
}, Open  ]],

Cell["\<\
The two correct spreads agree, while the half-diffusion spread is markedly \
smaller (halving the noise amplitude narrows the distribution), even though \
its mean is unmoved. The standard deviation is what distinguishes a correct \
measurement model from a wrong one.\
\>", "Text",ExpressionUUID->"63a48922-0fac-666c-115b-208caa594cb6"],

Cell["The honest catch: Euler-Maruyama is only strong order 0.5", "Section",ExpressionUUID->"387a9e0d-0234-0e73-6819-1057b7c15559"],

Cell[TextData[{
 "The catch is that the hand-rolled route is explicit Euler-Maruyama, and it \
treats the fast Rabi rotation explicitly. Linearizing the drift about a \
point, the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f64ca0d-9927-5f44-651b-ec5718d225ae"],
 " block is a damped rotation with eigenvalues ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     SubsuperscriptBox["\[CapitalGamma]", "2", 
      StyleBox["eff",
       FontSlant->"Plain"]], "+", 
     SubscriptBox[
      StyleBox["\[Gamma]", "TI"], "1"]}], "2"], "\[PlusMinus]", 
   StyleBox["i", "TI"], " ", 
   SubscriptBox["\[CapitalOmega]", 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "399d1ff3-4632-be92-6fa2-96bd73c404f8"],
 " (for ",
 Cell[BoxData[
  SubscriptBox["\[CapitalOmega]", 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1170384d-2f38-2c50-470f-b2174acd76ba"],
 " large). Explicit Euler is stable only when ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{"1", "+", 
       StyleBox["\[Lambda]", "TI"], " ", "\[CapitalDelta]", 
       StyleBox["t", "TI"]}]},
    "Abs"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ce33075-6d34-44a7-1490-aa3f04c12e8d"],
 ", i.e. ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[CapitalDelta]", 
    StyleBox["t", "TI"]}], "\[LessTilde]", 
   RowBox[{"2", " ", 
    StyleBox["Re",
     FontSlant->"Plain"], 
    RowBox[{
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"-", 
       StyleBox["\[Lambda]", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "/", 
     SuperscriptBox[
      TemplateBox[{
        StyleBox["\[Lambda]", "TI"]},
       "Abs"], "2"]}]}], "\[TildeTilde]", 
   RowBox[{
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubsuperscriptBox["\[CapitalGamma]", "2", 
       StyleBox["eff",
        FontSlant->"Plain"]], "+", 
      SubscriptBox[
       StyleBox["\[Gamma]", "TI"], "1"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "/", 
    SubsuperscriptBox["\[CapitalOmega]", 
     StyleBox["x", "TI"], "2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],
 ", so the step count must exceed"
}], "Text",ExpressionUUID->"6334ac9c-43f1-85c0-12cb-45c67585ef2a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["n", "TI"], "*"], "=", 
    FractionBox[
     RowBox[{
      SubsuperscriptBox["\[CapitalOmega]", 
       StyleBox["x", "TI"], "2"], " ", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["f", "TI"]]}], 
     RowBox[{
      SubsuperscriptBox["\[CapitalGamma]", "2", 
       StyleBox["eff",
        FontSlant->"Plain"]], "+", 
      SubscriptBox[
       StyleBox["\[Gamma]", "TI"], "1"]}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"74397683-04f4-1d4d-1dc7-6fedac816797"],

Cell[TextData[{
 "Turn off the measurement (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "=", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "735e49d5-32a1-4a48-2166-609f47541892"],
 ", so the diffusion vanishes and the single path is deterministic) and keep \
only dephasing, relaxation, and the drive, now at the true transmon strength. \
In the same dimensionless units the real drive-to-relaxation ratio is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalOmega]", 
    StyleBox["x", "TI"]], "/", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "=", "2", "\[Pi]", " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", " ", 
    StyleBox["MHz",
     FontSlant->"Plain"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"30", " ", 
    StyleBox["\[Mu]", "TI"], 
    StyleBox["s", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "60", "\[Pi]", "\[TildeTilde]", "188"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "335d55a2-cf9b-493d-6163-4c0fea2e1807"],
 ", and the final time ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox["f", "TI"]], "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["f", "TI"]], "=", "1", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bfbbd45-edb8-1b0b-6998-352e844d6651"],
 " is the dimensionless form of ",
 Cell[BoxData[
  RowBox[{"10", " ", 
   StyleBox["\[Mu]", "TI"], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "045023ab-c37d-b770-2c6f-baf4f6091a5a"],
 ":"
}], "Text",ExpressionUUID->"73e8aeff-5b91-f8f4-2197-47b95e25cade"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ratesFast", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0.", ",", " ", "0.", ",", " ", "0.", ",", " ", "1.", ",", " ", "1.", ",",
      " ", 
     RowBox[{"60", " ", "Pi"}]}], "}"}]}], ";", " ", 
  RowBox[{"initFast", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sin", "[", "0.001", "]"}], ",", " ", "0.", ",", " ", 
      RowBox[{"Cos", "[", "0.001", "]"}]}], "}"}], "]"}]}], ";", " ", 
  RowBox[{"tfFast", " ", "=", " ", 
   RowBox[{"1.", "/", "3"}]}], ";"}]], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"],

Cell[TextData[{
 "The exact answer and the threshold ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["n", "TI"], "*"], "=", 
   SubsuperscriptBox["\[CapitalOmega]", 
    StyleBox["x", "TI"], "2"], 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["f", "TI"]], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubsuperscriptBox["\[CapitalGamma]", "2", 
     StyleBox["eff",
      FontSlant->"Plain"]], "+", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "794a4309-908b-2549-2f4a-5b53213f8f93"],
 " are (positions 5, 4, 3 of the rate vector are ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],
 "):"
}], "Text",ExpressionUUID->"15eb24b6-b946-3a65-43e8-bdf038f0894f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<exact Lindblad z(tf)\>\"", " ", "->", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"lindbladBloch", "[", 
       RowBox[{"ratesFast", ",", " ", "initFast"}], "]"}], "[", "tfFast", 
      "]"}], "[", 
     RowBox[{"[", "3", "]"}], "]"}]}], ",", "\n", " ", 
   RowBox[{"\"\<threshold n*\>\"", " ", "->", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"ratesFast", "[", 
       RowBox[{"[", "6", "]"}], "]"}], "^", "2"}], " ", 
     RowBox[{"tfFast", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"ratesFast", "[", 
            RowBox[{"[", "5", "]"}], "]"}], "/", "2"}], " ", "+", " ", 
          RowBox[{"ratesFast", "[", 
           RowBox[{"[", "4", "]"}], "]"}], " ", "+", " ", 
          RowBox[{"ratesFast", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ")"}], " ", "+", " ", 
        RowBox[{"ratesFast", "[", 
         RowBox[{"[", "5", "]"}], "]"}]}], ")"}]}]}]}]}], "}"}]], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"27d2a24c-1e84-19ee-4de1-44169b316b34"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"exact Lindblad z(tf)\"\>", "\[Rule]", "0.6592544432780927`"}],
    ",", 
   RowBox[{"\<\"threshold n*\"\>", "\[Rule]", "4737.410112522892`"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[26]= ",ExpressionUUID->"285985c7-a1c8-13eb-5866-1ca0d07d6131"]
}, Open  ]],

Cell[TextData[{
 "The exact ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57868ed1-450c-c474-7dbd-279b6cbeaf5e"],
 " lands partway up the damped-Rabi envelope, and ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["n", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c5e608e-35dc-f74f-3466-79e8bc6edd95"],
 " is a few thousand steps. Now sweep the step count across the threshold. \
One row of the sweep runs a single deterministic path at a given step count, \
with and without projection, and reads off the final ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a1e4090-3303-05ed-4a26-59da46b66f37"],
 ":"
}], "Text",ExpressionUUID->"10256af3-3972-af7a-41da-83bdb804f240"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"detRow", "[", "ns_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{"ns", ",", " ", 
     RowBox[{"Last", "[", 
      RowBox[{
       RowBox[{"emEnsemble", "[", 
        RowBox[{
        "ratesFast", ",", " ", "initFast", ",", " ", "tfFast", ",", " ", 
         RowBox[{"tfFast", "/", "ns"}], ",", " ", "1", ",", " ", "1", ",", 
         " ", "False"}], "]"}], "[", "\"\<meanZ\>\"", "]"}], "]"}], ",", "\n",
      "   ", 
     RowBox[{"Last", "[", 
      RowBox[{
       RowBox[{"emEnsemble", "[", 
        RowBox[{
        "ratesFast", ",", " ", "initFast", ",", " ", "tfFast", ",", " ", 
         RowBox[{"tfFast", "/", "ns"}], ",", " ", "1", ",", " ", "1", ",", 
         " ", "True"}], "]"}], "[", "\"\<meanZ\>\"", "]"}], "]"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[27]:= ",ExpressionUUID->"457602f1-d86e-ac86-730d-9bbad918f6ec"],

Cell[TextData[{
 "Tabulate the sweep and watch the transition across ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["n", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "499f95c1-a958-6c18-7fa4-0caac8ed3762"],
 ":"
}], "Text",ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"detRow", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
       "1000", ",", " ", "4000", ",", " ", "8000", ",", " ", "16000", ",", 
        " ", "32000"}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<nSteps\>\"", ",", " ", "\"\<EM noProj z(tf)\>\"", ",", 
       " ", "\"\<EM proj z(tf)\>\""}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"0c02104f-9807-e6c4-3431-8a2919b3cc2e"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"nSteps\"\>", "\<\"EM noProj z(tf)\"\>", "\<\"EM proj z(tf)\"\>"},
    {"1000", "4.725220317725765`", "0.9983564048244957`"},
    {"4000", "1.0798662389355638`", "0.9999993523299081`"},
    {"8000", "0.8437479075872352`", "0.8417461622465865`"},
    {"16000", "0.7458167590048764`", "0.7452080138911261`"},
    {"32000", "0.7012006547983787`", "0.7010008195926389`"}
   },
   AutoDelete->False,
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellLabel->
  "Out[28]= ",ExpressionUUID->"6f909018-5ea1-6a32-15af-0a425b543918"]
}, Open  ]],

Cell[TextData[{
 "Below ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["n", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f4595f3-090a-1216-557a-0cbda8bf617c"],
 " the explicit scheme amplifies: the unprojected value blows past one, and \
projection prevents blowup but pins the state at the pole, which is wrong \
physics. Above ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["n", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06385f5e-e9d4-4e6c-2fd8-571b886114b6"],
 " it converges to the Lindblad, but only at first order in ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],
 ", so it is still visibly above the exact value even at the finest step \
counts in the sweep. The native SRK reaches the same answer at a thousand \
steps, because its stability region is far larger. This is the division of \
labor: for a stiff, fast-Rabi qubit, the native ",
 Cell[BoxData["ItoProcess"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9a140e-d97a-4136-69b9-8e6bd80f101c"],
 " route is the right tool, and the projected ",
 Cell["NDSolve/WhenEvent", "InlineCode",ExpressionUUID->
  "4f9438da-b80f-a114-75ab-b18439bbf07e"],
 " scheme is a demonstration of what one can build when a native Wiener input \
is absent, not the tool of choice."
}], "Text",ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell["What is now true", "Section",ExpressionUUID->"3c8746fc-db76-c487-64bd-5fb9de00aeed"],

Cell[TextData[{
 "The Cartesian-Bloch trajectory SDE carries its own positivity: the noise is \
tangent to the sphere and the drift points inward at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11f0f87a-e6f0-91cd-478f-f227928ae317"],
 ", so the exact flow never leaves the ball, and because that drift is affine \
the ensemble mean is the Lindblad master equation identically. ",
 Cell[BoxData["RandomFunction"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "473164ce-b547-c1f4-6ecf-7da83cf393de"],
 " on ",
 Cell[BoxData["ItoProcess"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c4fc3b-e00c-2bba-42fb-f66491b97980"],
 " integrates this in the coordinates that keep it stable; the hand-rolled \
Euler-Maruyama in ",
 Cell["NDSolve/WhenEvent", "InlineCode",ExpressionUUID->
  "1d7e6892-18cd-6f45-4b05-81dc997835af"],
 " reaches the same ensemble, and the same second moment, but only as a \
strong-order-0.5 explicit scheme whose stability against the fast Rabi is \
bought with either a projection or a small step, so its cost tracks ",
 Cell[BoxData[
  SubsuperscriptBox["\[CapitalOmega]", 
   StyleBox["x", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "325c8f47-cd85-89da-6263-2720e431db20"],
 " while the SRK's does not. The projection is what makes the discrete \
Cartesian scheme stay in the ball that the continuous SDE never left on its \
own."
}], "Text",ExpressionUUID->"43fcea2e-12ab-c026-7183-0388a75f930c"]
},
