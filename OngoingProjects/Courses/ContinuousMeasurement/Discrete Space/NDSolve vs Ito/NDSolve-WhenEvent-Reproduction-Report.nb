(* Beginning of Notebook Content *)
Notebook[{
Cell["\<\
NDSolve/WhenEvent vs ItoProcess: a continuously measured qubit's trajectory\
\>", "Title",ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 StyleBox["A companion to ",
  FontWeight->"Bold"],
 StyleBox["Trajectories, the Record, and the Master Equation", "TI",
  FontWeight->"Bold"],
 StyleBox[". There the free particle is watched on a grid; here the object is \
a continuously monitored qubit, whose complete state is the three Bloch \
numbers ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["x", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["y", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 StyleBox[" living in the ball ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   StyleBox["|",
    SpanMaxSize->1], 
   RowBox[{"{", 
    StyleBox["x", "TI"]}], ",", 
   StyleBox["y", "TI"], ",", 
   RowBox[{
    StyleBox["z", "TI"], "}"}], 
   StyleBox["|",
    SpanMaxSize->1], 
   RowBox[{"\[LessEqual]", "1"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 StyleBox[". The trajectory is a Cartesian-Bloch Ito SDE, integrated natively \
by the built-in ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{"RandomFunction", "[", 
   RowBox[{"ItoProcess", "[", "...", "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],
 StyleBox[". ",
  FontWeight->"Bold"],
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],
 StyleBox[" has no native Wiener input, so this document hand-rolls \
Euler-Maruyama inside ",
  FontWeight->"Bold"],
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 StyleBox[" via ",
  FontWeight->"Bold"],
 Cell[BoxData["WhenEvent"], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 StyleBox[", and asks a sharp question: does the hand-rolled route reproduce \
the built-in ensemble and the Lindblad master equation, while keeping ",
  FontWeight->"Bold"],
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],
 StyleBox[", and at what cost? Every number below is produced by a cell you \
can rerun.",
  FontWeight->"Bold"]
}], "Text",ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell["Mads Bahrami (last updated: July 29, 2026)", "Text",ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell[TextData[{
 "This document is nearly self-contained: evaluate the cells top to bottom, \
and the only external ingredient is one Wolfram Function Repository function, \
",
 Cell[BoxData["ItoProcessChangeVariables"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 ", which performs the Ito change of variables for the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166f8969-5e31-e8e5-3e14-21335bc5bacf"],
 " proof and is fetched automatically on first use. The six rates ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]}], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], ",", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], ",", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], ",", 
   RowBox[{
    SubscriptBox["\[CapitalOmega]", 
     StyleBox["x", "TI"]], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "234f1fb7-07c6-bba9-5174-96f1b27009f3"],
 " (measurement coherent-information, backaction dephasing, measurement \
dephasing ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["m", "TI"]], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
 ", pure dephasing, ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],
 ", and Rabi) stay symbolic where the algebra is symbolic and become numbers \
only when we simulate. The code uses these same Greek letters for the rates, \
so it reads like the formulas."
}], "Text",ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell["From the density matrix to the Bloch SDE", "Section",ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell[TextData[{
 "The trajectory follows from continuous homodyne detection of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e84829b-9667-6594-16bb-1bc523124ffe"],
 " (Gambetta07), with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e173f-6b36-b240-7ea5-8f790ec000aa"],
 " decay, pure dephasing, and a Rabi drive. ",
 StyleBox["Homodyne detection", "TI"],
 " beats the cavity's output field against a strong local-oscillator \
reference at the same frequency, so the recorded photocurrent reads out one \
chosen field quadrature, here the one carrying the qubit's ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],
 " (which-state) information. Write the effective transverse rate as ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["\[CapitalGamma]", "2", 
    StyleBox["eff",
     FontSlant->"Plain"]], "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "/", "2", "+", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "+", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], "=", "1", "/", 
   SubsuperscriptBox[
    StyleBox["T", "TI"], "2", 
    StyleBox["eff",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "779c57de-bb93-d239-1da4-4e983e27a103"],
 ". The object actually being tracked is the conditional density matrix ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2867ea9b-6e8d-517b-581c-03c50b382041"],
 ", which obeys a stochastic master equation, a deterministic Lindblad drift \
plus a state-dependent measurement backaction along the record's noise:"
}], "Text",ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", 
    StyleBox["(",
     FontSize->1.8 Inherited], 
    UnderscriptBox[
     UnderscriptBox[
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["H", "TI"], ",", 
        StyleBox["\[Rho]", "TI"]}], 
       StyleBox["]",
        SpanMaxSize->1], "+", 
       SubscriptBox[
        StyleBox["\[Gamma]", "TI"], "1"], " ", "\|01d49f", 
       StyleBox["[",
        SpanMaxSize->1], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], "-"], 
       StyleBox["]",
        SpanMaxSize->1], 
       StyleBox["\[Rho]", "TI"], "+", 
       FractionBox[
        RowBox[{
         SubscriptBox[
          StyleBox["\[Gamma]", "TI"], 
          StyleBox["\[Phi]", "TI"]], "+", 
         SubscriptBox["\[CapitalGamma]", 
          StyleBox["d", "TI"]]}], "2"], " ", "\|01d49f", 
       StyleBox["[",
        SpanMaxSize->1], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], 
        StyleBox["z", "TI"]], 
       StyleBox["]",
        SpanMaxSize->1], 
       StyleBox["\[Rho]", "TI"]}], "\[UnderBrace]"], 
     StyleBox[
      RowBox[{"Lindblad", "\[NonBreakingSpace]", "drift"}],
      FontSlant->"Plain"]], 
    StyleBox[")",
     FontSize->1.8 Inherited], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "\[ThickSpace]", "+", "\[ThickSpace]", 
    UnderscriptBox[
     UnderscriptBox[
      RowBox[{"\[ScriptCapitalH]", 
       StyleBox["[",
        SpanMaxSize->1], 
       StyleBox["c", "TI"], 
       StyleBox["]",
        SpanMaxSize->1], 
       StyleBox["\[Rho]", "TI"]}], "\[UnderBrace]"], 
     StyleBox[
      RowBox[{"homodyne", "\[NonBreakingSpace]", "backaction"}],
      FontSlant->"Plain"]], " ", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[TextData[{
 "with the Rabi Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   FractionBox[
    SubscriptBox["\[CapitalOmega]", 
     StyleBox["x", "TI"]], "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 ", the GKSL dissipator ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    StyleBox["L", "TI"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "=", 
    StyleBox["L", "TI"], 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     StyleBox["L", "TI"], "\[Dagger]"], "-", 
    FractionBox["1", "2"], "{", 
    SuperscriptBox[
     StyleBox["L", "TI"], "\[Dagger]"], 
    StyleBox["L", "TI"]}], ",", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "741b091d-feb2-1a39-1c38-a146fb476903"],
 ", and the homodyne measurement (innovation) superoperator ",
 Cell[BoxData[
  RowBox[{"\[ScriptCapitalH]", 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["c", "TI"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"], "=", 
   StyleBox["c", "TI"], 
   StyleBox["\[Rho]", "TI"], "+", 
   StyleBox["\[Rho]", "TI"], 
   SuperscriptBox[
    StyleBox["c", "TI"], "\[Dagger]"], "-", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["c", "TI"], "+", 
     SuperscriptBox[
      StyleBox["c", "TI"], "\[Dagger]"]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], " ", 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf5a20e-c541-e06e-698a-446becf5b2b4"],
 " (Wiseman-Milburn; the calligraphic ",
 Cell[BoxData["\[ScriptCapitalH]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07964fa7-8d1e-ff14-2dae-660124a8c27e"],
 " is the measurement superoperator, not the Hamiltonian ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],
 "), with measurement operator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], "-", 
   StyleBox["i", "TI"], 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"B", "A"}], "TI"]]], 
   StyleBox[")",
    FontSize->1.2 Inherited], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbaaaf7-1388-e538-4b59-43b1a622cc02"],
 ". Here ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"C", "I"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77d99fdb-a351-2d53-1de6-1684d6e477b9"],
 " weights the informative quadrature that sharpens the state toward a ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04646437-faee-7dfc-2c1c-7e70fe9b47c6"],
 " eigenstate, and ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"B", "A"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbde497-e826-5557-4442-fdd089d33fbd"],
 " the orthogonal quadrature that only kicks the phase."
}], "Text",ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell[TextData[{
 "Projected onto the Bloch vector ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["x", "TI"]}], ",", 
   StyleBox["y", "TI"], ",", 
   RowBox[{
    StyleBox["z", "TI"], "}", "=", "{", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["x", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["y", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c358d3e-86d3-ec5f-75ca-25783367b6a5"],
 ", the Lindblad drift becomes the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f908cf3-3c70-d55a-45af-25bdb50abfa0"],
 " terms and the backaction the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " terms of a single scalar-noise Ito SDE:"
}], "Text",ExpressionUUID->"110914de-bbdd-83a1-4736-8d983e69d18b"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], "(", GridBox[{
      {
       StyleBox["x", "TI"]},
      {
       StyleBox["y", "TI"]},
      {
       StyleBox["z", "TI"]}
     }], ")", "=", 
    UnderscriptBox[
     UnderscriptBox[
      RowBox[{"(", GridBox[{
         {
          RowBox[{"-", 
           SubsuperscriptBox["\[CapitalGamma]", "2", 
            StyleBox["eff",
             FontSlant->"Plain"]], " ", 
           StyleBox["x", "TI"]}]},
         {
          RowBox[{"-", 
           SubsuperscriptBox["\[CapitalGamma]", "2", 
            StyleBox["eff",
             FontSlant->"Plain"]], " ", 
           StyleBox["y", "TI"], "-", 
           SubscriptBox["\[CapitalOmega]", 
            StyleBox["x", "TI"]], 
           StyleBox["z", "TI"]}]},
         {
          RowBox[{
           SubscriptBox[
            StyleBox["\[Gamma]", "TI"], "1"], 
           StyleBox["(",
            SpanMaxSize->1], 
           RowBox[{"1", "-", 
            StyleBox["z", "TI"]}], 
           StyleBox[")",
            SpanMaxSize->1], "+", 
           SubscriptBox["\[CapitalOmega]", 
            StyleBox["x", "TI"]], 
           StyleBox["y", "TI"]}]}
        }], ")"}], "\[UnderBrace]"], 
     OverscriptBox[
      StyleBox["a", "TI"], "\[RightVector]"]], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "\[ThickSpace]", "+", "\[ThickSpace]", 
    UnderscriptBox[
     UnderscriptBox[
      RowBox[{"(", GridBox[{
         {
          RowBox[{"-", 
           SqrtBox[
            SubscriptBox["\[CapitalGamma]", 
             StyleBox[
              RowBox[{"C", "I"}], "TI"]]], " ", 
           StyleBox["x", "TI"], 
           StyleBox["z", "TI"], "-", 
           SqrtBox[
            SubscriptBox["\[CapitalGamma]", 
             StyleBox[
              RowBox[{"B", "A"}], "TI"]]], " ", 
           StyleBox["y", "TI"]}]},
         {
          RowBox[{"-", 
           SqrtBox[
            SubscriptBox["\[CapitalGamma]", 
             StyleBox[
              RowBox[{"C", "I"}], "TI"]]], " ", 
           StyleBox["y", "TI"], 
           StyleBox["z", "TI"], "+", 
           SqrtBox[
            SubscriptBox["\[CapitalGamma]", 
             StyleBox[
              RowBox[{"B", "A"}], "TI"]]], " ", 
           StyleBox["x", "TI"]}]},
         {
          RowBox[{
           SqrtBox[
            SubscriptBox["\[CapitalGamma]", 
             StyleBox[
              RowBox[{"C", "I"}], "TI"]]], " ", 
           StyleBox["(",
            SpanMaxSize->1], 
           RowBox[{"1", "-", 
            SuperscriptBox[
             StyleBox["z", "TI"], "2"]}], 
           StyleBox[")",
            SpanMaxSize->1]}]}
        }], ")"}], "\[UnderBrace]"], 
     OverscriptBox[
      StyleBox["b", "TI"], "\[RightVector]"]], " ", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell[TextData[{
 "This is the standard split ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], "=", 
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c76c797-c249-79ca-540d-ded0f7fc4b10"],
 " with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["v", "TI"], "\[RightVector]"], "=", "{", 
    StyleBox["x", "TI"]}], ",", 
   StyleBox["y", "TI"], ",", 
   RowBox[{
    StyleBox["z", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35077f55-9291-6519-633d-771f27244c63"],
 ": the two labeled columns are the drift vector ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebf3687-f906-130d-7644-afe0f8b37e57"],
 " (the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 " part) and the diffusion vector ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 " (the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 " part, a single column since one scalar noise ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 " drives all three components). In code, the drift, with the transverse rate \
",
 Cell[BoxData[
  SubsuperscriptBox["\[CapitalGamma]", "2", 
   StyleBox["eff",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "034d641c-5834-e412-3173-7e4659c6cf78"],
 " folded in:"
}], "Text",ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"driftV", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "\[CapitalGamma]CI_", ",", " ", "\[CapitalGamma]BA_", ",", " ", 
       "\[CapitalGamma]d_", ",", " ", "\[Gamma]\[Phi]_", ",", " ", 
       "\[Gamma]1_", ",", " ", "\[CapitalOmega]x_"}], "}"}]}], "]"}], " ", ":=",
    "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[CapitalGamma]2eff", " ", "=", " ", 
       RowBox[{
        RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", "\[Gamma]\[Phi]", " ",
         "+", " ", "\[CapitalGamma]d"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[CapitalGamma]2eff"}], " ", "x"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[CapitalGamma]2eff"}], " ", "y"}], " ", "-", " ", 
        RowBox[{"\[CapitalOmega]x", " ", "z"}]}], ",", " ", 
       RowBox[{
        RowBox[{"\[Gamma]1", " ", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "z"}], ")"}]}], " ", "+", " ", 
        RowBox[{"\[CapitalOmega]x", " ", "y"}]}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell[TextData[{
 "And the diffusion ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "134534fb-1061-d656-417a-ada5a115bcbc"],
 ", the second column above:"
}], "Text",ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"diffV", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "\[CapitalGamma]CI_", ",", " ", "\[CapitalGamma]BA_", ",", " ", 
       "\[CapitalGamma]d_", ",", " ", "\[Gamma]\[Phi]_", ",", " ", 
       "\[Gamma]1_", ",", " ", "\[CapitalOmega]x_"}], "}"}]}], "]"}], " ", ":=",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}]}], " ", "x", " ", 
       "z"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", "\[CapitalGamma]BA", "]"}], " ", "y"}]}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}]}], " ", "y", " ", 
       "z"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", "\[CapitalGamma]BA", "]"}], " ", "x"}]}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"z", "^", "2"}]}], ")"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell[TextData[{
 "The ",
 StyleBox["native", "TI"],
 " route hands ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    OverscriptBox[
     StyleBox["a", "TI"], "\[RightVector]"]}], ",", 
   RowBox[{
    OverscriptBox[
     StyleBox["b", "TI"], "\[RightVector]"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "608e87cc-8fce-afdf-10b5-1e962a78f525"],
 " to ",
 Cell[BoxData["ItoProcess"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aa912c6-4938-1bb7-5a56-8ba068cd699d"],
 " and integrates with ",
 Cell[BoxData["RandomFunction"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66b4bee0-d247-b105-0e4b-37cde7f3006f"],
 " using the SDE-native scalar-noise stochastic Runge-Kutta. The ",
 StyleBox["hand-rolled", "TI"],
 " route freezes the ODE (",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"x", "'"}], "[", "t", "]"}], "==", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 ") inside ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 " and injects one explicit Euler-Maruyama step at each ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 " through a ",
 Cell[BoxData["WhenEvent"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
 ", adding ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 " to the current state. Two mistakes to avoid: do not integrate the drift in \
the ODE and re-add it in the event (double count), and the event must ADD the \
increment to the state, not replace the state with it."
}], "Text",ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell["The mean is the Lindblad equation, exactly", "Section",ExpressionUUID->"7b6211f5-475c-1194-2911-88bf72e963fe"],

Cell[TextData[{
 "The drift is ",
 StyleBox["affine", "TI"],
 " in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["x", "TI"]}], ",", 
   StyleBox["y", "TI"], ",", 
   RowBox[{
    StyleBox["z", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],
 ": ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["A", "TI"], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], "+", 
   OverscriptBox[
    StyleBox["c", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],
 ". Taking the Ito expectation kills the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],
 " term (",
 Cell[BoxData[
  RowBox[{"\|01d53c", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["b", "TI"], "\[RightVector]"], " ", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7fe4cc-5889-7f4e-6904-fd96593c4594"],
 "), so the mean ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "\|01d53c", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cb5c01f-62f5-68e0-144a-da5916803aca"],
 " obeys a closed, deterministic linear ODE,"
}], "Text",ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      StyleBox["d", "TI"], 
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      StyleBox["x", "TI"], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]], "=", "-", 
    SubsuperscriptBox["\[CapitalGamma]", "2", 
     StyleBox["eff",
      FontSlant->"Plain"]], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    FractionBox[
     RowBox[{
      StyleBox["d", "TI"], 
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      StyleBox["y", "TI"], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SubsuperscriptBox["\[CapitalGamma]", "2", 
        StyleBox["eff",
         FontSlant->"Plain"]]}], 
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       StyleBox["y", "TI"], "\[VeryThinSpace]", 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]}], "-", 
     RowBox[{
      SubscriptBox["\[CapitalOmega]", 
       StyleBox["x", "TI"]], 
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       StyleBox["z", "TI"], "\[VeryThinSpace]", 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    FractionBox[
     RowBox[{
      StyleBox["d", "TI"], 
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      StyleBox["z", "TI"], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["\[Gamma]", "TI"], "1"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "-", 
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        StyleBox["z", "TI"], "\[VeryThinSpace]", 
        StyleBox["\[RightAngleBracket]",
         SpanMaxSize->1]}], 
       StyleBox[")",
        SpanMaxSize->1]}]}], "+", 
     RowBox[{
      SubscriptBox["\[CapitalOmega]", 
       StyleBox["x", "TI"]], 
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       StyleBox["y", "TI"], "\[VeryThinSpace]", 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"4b6e5dad-9702-0c1f-7916-54f722b75765"],

Cell[TextData[{
 "which is exactly the Bloch form of the Lindblad drift above: transverse \
decay at ",
 Cell[BoxData[
  SubsuperscriptBox["\[CapitalGamma]", "2", 
   StyleBox["eff",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d359769-845f-cd94-44ca-0f332deb97fe"],
 ", relaxation to the ground state at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2055bfee-d4b5-7aa2-506a-36cbdd404888"],
 ", and the Rabi rotation ",
 Cell[BoxData[
  SubscriptBox["\[CapitalOmega]", 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 ". Solve it symbolically with ",
 Cell[BoxData["DSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 ":"
}], "Text",ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "\[CapitalGamma]2eff", ",", " ", "\[Gamma]1", ",", " ", "\[CapitalOmega]x",
     ",", " ", "x0", ",", " ", "y0", ",", " ", "z0"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"meanSol", " ", "=", " ", 
   RowBox[{
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"X", "'"}], "[", "t", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"-", "\[CapitalGamma]2eff"}], " ", 
          RowBox[{"X", "[", "t", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Y", "'"}], "[", "t", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "\[CapitalGamma]2eff"}], " ", 
           RowBox[{"Y", "[", "t", "]"}]}], " ", "-", " ", 
          RowBox[{"\[CapitalOmega]x", " ", 
           RowBox[{"Z", "[", "t", "]"}]}]}]}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"Z", "'"}], "[", "t", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"\[Gamma]1", " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"Z", "[", "t", "]"}]}], ")"}]}], " ", "+", " ", 
          RowBox[{"\[CapitalOmega]x", " ", 
           RowBox[{"Y", "[", "t", "]"}]}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"X", "[", "0", "]"}], " ", "==", " ", "x0"}], ",", " ", 
        RowBox[{
         RowBox[{"Y", "[", "0", "]"}], " ", "==", " ", "y0"}], ",", " ", 
        RowBox[{
         RowBox[{"Z", "[", "0", "]"}], " ", "==", " ", "z0"}]}], "}"}], ",", 
      "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"X", ",", " ", "Y", ",", " ", "Z"}], "}"}], ",", " ", "t"}], 
     "]"}], " ", "//", " ", "First"}]}], ";"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"25a0bfbe-b1d4-2428-535f-36fbc0668f72"],

Cell[TextData[{
 "The transverse component decouples and decays as a pure exponential, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["x", "TI"], "0"], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SubsuperscriptBox["\[CapitalGamma]", "2", 
      StyleBox["eff",
       FontSlant->"Plain"]], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04786d0e-016a-d127-2c07-8568b01ca00d"],
 ", while ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["y", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["z", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],
 " form a damped Rabi pair:"
}], "Text",ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"X", "[", "t", "]"}], " ", "/.", " ", "meanSol"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"14fd1512-f616-8834-3c82-8d5f83a0db1e"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"-", "t"}], " ", "\[CapitalGamma]2eff"}]], " ", "x0"}]], "Output",\

 CellLabel->"Out[4]= ",ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"]
}, Open  ]],

Cell["\<\
So the ensemble mean of the trajectory SDE is the Lindblad master equation, \
identically. The mean sees only the drift; it is blind to any diffusion that \
leaves the drift alone, which makes matching it a weak test. We sharpen it \
with the second moment below.\
\>", "Text",ExpressionUUID->"48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],

Cell[TextData[{
 "The ball ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58ee7ecb-1370-1005-0896-7795a605636f"],
 " is an invariant, proven"
}], "Section",ExpressionUUID->"11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],

Cell[TextData[{
 "Positivity of the qubit density matrix is exactly ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],
 ", because ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    StyleBox["x", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["x", "TI"]], "+", 
    StyleBox["y", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["y", "TI"]], "+", 
    StyleBox["z", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3181a460-bc62-f1ee-67be-3e4a3514c334"],
 " has ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Rho]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],
 ", which is non-negative iff ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b45e796-37a7-eecc-197a-fed04253b416"],
 ". The cleanest way to see that the SDE respects this is to change \
coordinates from Cartesian ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["x", "TI"]}], ",", 
   StyleBox["y", "TI"], ",", 
   RowBox[{
    StyleBox["z", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 " to spherical ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["r", "TI"]}], ",", 
   StyleBox["\[Theta]", "TI"], ",", 
   RowBox[{
    StyleBox["\[Phi]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 " and read off the radius's own one-dimensional Ito equation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["r", "TI"], "=", 
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["r", "TI"]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   SubscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["r", "TI"]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a9104d-5625-6af3-4356-8a1763d038d9"],
 ": its two coefficients settle the invariant directly. Build the Cartesian \
process symbolically first:"
}], "Text",ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "x", ",", " ", "y", ",", " ", "z", ",", " ", "x0", ",", " ", "y0", ",", 
    " ", "z0", ",", " ", "\[CapitalGamma]CI", ",", " ", "\[CapitalGamma]BA", ",",
     " ", "\[CapitalGamma]d", ",", " ", "\[Gamma]\[Phi]", ",", " ", 
    "\[Gamma]1", ",", " ", "\[CapitalOmega]x"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ratesSym", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "\[CapitalGamma]CI", ",", " ", "\[CapitalGamma]BA", ",", " ", 
     "\[CapitalGamma]d", ",", " ", "\[Gamma]\[Phi]", ",", " ", "\[Gamma]1", ",",
      " ", "\[CapitalOmega]x"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"procSym", " ", "=", " ", 
   RowBox[{"ItoProcess", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"driftV", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
         "ratesSym"}], "]"}], ",", " ", 
       RowBox[{"List", " ", "/@", " ", 
        RowBox[{"diffV", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
          "ratesSym"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x0", ",", " ", "y0", ",", " ", "z0"}], "}"}]}], "}"}], ",", 
     " ", "t"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

Cell[TextData[{
 "The Wolfram Function Repository's ",
 Cell[BoxData["ItoProcessChangeVariables"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c54d9-3079-6bba-5c24-4d83410c3980"],
 " applies Ito's rule, including the second-order correction, to rewrite the \
SDE in spherical coordinates. This is the one external ingredient in the \
document, fetched automatically on first use:"
}], "Text",ExpressionUUID->"1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sphProc", " ", "=", " ", 
   RowBox[{
    RowBox[{
    "ResourceFunction", "[", "\"\<ItoProcessChangeVariables\>\"", "]"}], "[", 
    
    RowBox[{"procSym", ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], "}"}], ",", 
     " ", 
     RowBox[{"\"\<Cartesian\>\"", " ", "->", " ", "\"\<Spherical\>\""}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"],

Cell[TextData[{
 "First the noise. The radial diffusion coefficient ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["b", "TI"], 
   StyleBox["r", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],
 " is the top entry of the transformed diffusion:"
}], "Text",ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"sphProc", "[", "\"\<Diffusion\>\"", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", "[", "t", "]"}], " ", ">", " ", "0"}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"07359582-e823-44a1-2eca-0cef89d62e8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   SqrtBox["\[CapitalGamma]CI"]}], " ", 
  RowBox[{"Cos", "[", 
   RowBox[{"\[Theta]", "[", "t", "]"}], "]"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    SuperscriptBox[
     RowBox[{"r", "[", "t", "]"}], "2"]}], ")"}]}]], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"7c239bd0-3ff5-3b18-25d0-129ab9818662"]
}, Open  ]],

Cell[TextData[{
 "It is proportional to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c76573-72ce-0c1a-18fd-7d3d077b5760"],
 ", namely ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["r", "TI"]], "=", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6184d2f2-049e-728e-17bb-cbbcad2b40d4"],
 ", so it vanishes on the surface ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fd967ef-5008-0b29-75e7-7ec961bd5673"],
 " for every choice of rates. The measurement noise is tangent to the Bloch \
sphere: a noise step slides the state along the sphere and never off it."
}], "Text",ExpressionUUID->"19bb1c5e-57ab-6e36-4f58-9618625e351c"],

Cell[TextData[{
 "Second the drift. Evaluate the radial drift ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a", "TI"], 
   StyleBox["r", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],
 " on the surface ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30baa1c8-66ad-75e0-6059-389213585fca"],
 ":"
}], "Text",ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\[Eta]", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"radialDrift", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"sphProc", "[", "\"\<Drift\>\"", "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "/.", " ", 
      RowBox[{
       RowBox[{"r", "[", "t", "]"}], " ", "->", " ", "1"}]}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", " ", "<=", " ", 
        RowBox[{"\[Theta]", "[", "t", "]"}], " ", "<=", " ", "Pi"}], 
       "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell[TextData[{
 "Write the measurement efficiency as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]], "+", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"B", "A"}], "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox["d", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7421cf44-a1ac-4319-1dde-e721d0592e63"],
 " and ask ",
 Cell[BoxData["Reduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "511b3347-8d7d-ab60-0738-ab212409f64a"],
 " whether any point on the sphere, for any physical efficiency ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "\[Element]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36c19c85-764d-0b01-5efe-15ef03f8566b"],
 " and non-negative rates, can make the radial drift point outward, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["r", "TI"]], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6815cd54-0cd7-196f-182a-e51ea5626bb5"],
 ":"
}], "Text",ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"radialDrift", " ", "/.", " ", 
       RowBox[{"\[CapitalGamma]BA", " ", "->", " ", 
        RowBox[{
         RowBox[{"2", " ", "\[Eta]", " ", "\[CapitalGamma]d"}], " ", "-", " ",
          "\[CapitalGamma]CI"}]}]}], ")"}], " ", ">", " ", "0"}], " ", "&&", 
    "\n", "   ", 
    RowBox[{"0", " ", "<=", " ", 
     RowBox[{"\[Theta]", "[", "t", "]"}], " ", "<=", " ", "Pi"}], " ", "&&", 
    " ", 
    RowBox[{"\[Gamma]1", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]\[Phi]", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[CapitalGamma]d", " ", ">=", " ", "0"}], " ", "&&", "\n", "   ", 
    RowBox[{"\[CapitalGamma]CI", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", "\[Eta]", " ", "\[CapitalGamma]d"}], " ", "-", " ", 
      "\[CapitalGamma]CI"}], " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<=", " ", "\[Eta]", " ", "<=", " ", "1"}]}], ",", " ", 
   
   RowBox[{"{", 
    RowBox[{"\[Theta]", "[", "t", "]"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"5900aac7-5263-773e-0f3f-43a167165a04"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12d95fcb-3316-2212-42e7-569546a37178"],
 ": no such point exists, so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["r", "TI"]], "\[LessEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "733995c2-f5bf-78ee-22c6-0caffc4a4a34"],
 " everywhere on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f8ab258-7e7f-0723-7589-34027b0a6a09"],
 ". The noise cannot push the state off the sphere and the drift can only \
pull it inward, so the exact continuous flow never leaves the ball. Discrete \
integrators are another matter, which is the whole point of what follows."
}], "Text",ExpressionUUID->"6b12ee74-9953-131d-1921-003e18e67e67"],

Cell["The three integrators", "Section",ExpressionUUID->"65262d3c-fccc-1dc6-0cdd-c579f579672c"],

Cell[TextData[{
 "The native route builds an ",
 Cell[BoxData["ItoProcess"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e157ee2-48da-d240-062b-77cc696ca0aa"],
 " from the drift, the diffusion (as a one-column matrix, since the noise is \
scalar), and the state variables, then lets ",
 Cell[BoxData["RandomFunction"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78287f93-0f12-7c52-2828-76ddaaa746b8"],
 " integrate ",
 Cell[BoxData["ntraj"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08285353-0e0e-39f8-3828-4b1dabb88bc2"],
 " paths on the grid ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "0"}], ",", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["f", "TI"]], ",", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],
 " with the SDE-native scalar-noise stochastic Runge-Kutta. The process \
variables are Wolfram's formal symbols, unbound by construction, so they are \
safe placeholders:"
}], "Text",ExpressionUUID->"187adc3d-3961-76c2-4819-d667b8145c28"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"itoEnsemble", "[", 
    RowBox[{"rates_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x0_", ",", " ", "y0_", ",", " ", "z0_"}], "}"}], ",", " ", 
     "tf_", ",", " ", "dt_", ",", " ", "ntraj_", ",", " ", "seed_"}], "]"}], 
   " ", ":=", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"proc", ",", " ", "td", ",", " ", "vals"}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"proc", " ", "=", " ", 
       RowBox[{"ItoProcess", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"driftV", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"\[FormalX]", "[", "t", "]"}], ",", " ", 
               RowBox[{"\[FormalY]", "[", "t", "]"}], ",", " ", 
               RowBox[{"\[FormalZ]", "[", "t", "]"}]}], "}"}], ",", " ", 
             "rates"}], "]"}], ",", "\n", "      ", 
           RowBox[{"List", " ", "/@", " ", 
            RowBox[{"diffV", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\[FormalX]", "[", "t", "]"}], ",", " ", 
                RowBox[{"\[FormalY]", "[", "t", "]"}], ",", " ", 
                RowBox[{"\[FormalZ]", "[", "t", "]"}]}], "}"}], ",", " ", 
              "rates"}], "]"}]}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[FormalX]", "[", "t", "]"}], ",", " ", 
             RowBox[{"\[FormalY]", "[", "t", "]"}], ",", " ", 
             RowBox[{"\[FormalZ]", "[", "t", "]"}]}], "}"}]}], "}"}], ",", 
         "\n", "     ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "\[FormalX]", ",", " ", "\[FormalY]", ",", " ", "\[FormalZ]"}], 
            "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"x0", ",", " ", "y0", ",", " ", "z0"}], "}"}]}], "}"}], ",",
          " ", "t"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"td", " ", "=", " ", 
       RowBox[{"BlockRandom", "[", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "     ", 
         RowBox[{"RandomFunction", "[", 
          RowBox[{"proc", ",", " ", 
           RowBox[{"{", 
            RowBox[{"0.", ",", " ", "tf", ",", " ", "dt"}], "}"}], ",", " ", 
           "ntraj", ",", " ", 
           RowBox[{
           "Method", " ", "->", 
            " ", "\"\<StochasticRungeKuttaScalarNoise\>\""}]}], "]"}]}], 
        "]"}]}], ";", "\n", "   ", 
      RowBox[{"vals", " ", "=", " ", 
       RowBox[{"td", "[", "\"\<ValueList\>\"", "]"}]}], ";", "   ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"full", " ", 
         RowBox[{"data", ":", " ", 
          RowBox[{"ntraj", " ", "x", " ", "npts", " ", "x", " ", "3"}]}]}], ",",
         " ", 
        RowBox[{"the", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}], " ", "of", " ", "every", " ",
          "path"}]}], " ", "*)"}], "\n", "   ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<trajectories\>\"", " ", "->", " ", "vals"}], ",", " ", 
        RowBox[{"\"\<times\>\"", " ", "->", " ", 
         RowBox[{"td", "[", "\"\<Times\>\"", "]"}]}], ",", "\n", "     ", 
        RowBox[{"\"\<meanZ\>\"", " ", "->", " ", 
         RowBox[{"Mean", "[", 
          RowBox[{"vals", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "All", ",", " ", "3"}], "]"}], "]"}], 
          "]"}]}], ",", " ", 
        RowBox[{"\"\<zTrajs\>\"", " ", "->", " ", 
         RowBox[{"vals", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "All", ",", " ", "3"}], "]"}], "]"}]}], ",",
         "\n", "     ", 
        RowBox[{"\"\<maxr\>\"", " ", "->", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"Map", "[", 
           RowBox[{"Norm", ",", " ", "vals", ",", " ", 
            RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"641c78eb-7f03-7846-0c24-71b57ab64aac"],

Cell[TextData[{
 "Both ensemble builders keep the full simulated data: the returned \
association carries a ",
 Cell[BoxData["trajectories"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],
 " key, an ",
 Cell[BoxData["ntraj"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],
 Cell[BoxData["\[Times]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6121b9de-dddd-aca8-10de-309bd469f6f2"],
 Cell[BoxData["npts"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30209679-023a-ee91-61df-0823b7ccb4fb"],
 Cell[BoxData[
  RowBox[{"\[Times]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29bc1606-c22d-409d-5f43-8863f7d812e7"],
 " array of the Bloch vector ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["x", "TI"]}], ",", 
   StyleBox["y", "TI"], ",", 
   RowBox[{
    StyleBox["z", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],
 " at every path and step, and ",
 Cell[BoxData["meanZ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3119d855-3ffd-7401-6726-d21fb9885f6b"],
 ", ",
 Cell[BoxData["zTrajs"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],
 ", and ",
 Cell[BoxData["maxr"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],
 " are convenience reductions of it."
}], "Text",ExpressionUUID->"51fce014-dca1-0630-0783-fa51d5546d1a"],

Cell[TextData[{
 "The hand-rolled route is explicit Euler-Maruyama. For the SDE ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], "=", 
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657c1c65-980e-511d-1303-964f19bb2067"],
 " the update is"
}], "Text",ExpressionUUID->"0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["v", "TI"], "\[RightVector]"], 
     RowBox[{
      StyleBox["n", "TI"], "+", "1"}]], "=", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["v", "TI"], "\[RightVector]"], 
     StyleBox["n", "TI"]], "+", 
    OverscriptBox[
     StyleBox["a", "TI"], "\[RightVector]"], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["v", "TI"], "\[RightVector]"], 
     StyleBox["n", "TI"]], 
    StyleBox[")",
     SpanMaxSize->1], " ", "\[CapitalDelta]", 
    StyleBox["t", "TI"], "+", 
    OverscriptBox[
     StyleBox["b", "TI"], "\[RightVector]"], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["v", "TI"], "\[RightVector]"], 
     StyleBox["n", "TI"]], 
    StyleBox[")",
     SpanMaxSize->1], " ", "\[CapitalDelta]", 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["n", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{"\[CapitalDelta]", 
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["n", "TI"]]}], "\[Tilde]", 
    RowBox[{"\|01d4a9", 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"0", ",", 
       SqrtBox[
        RowBox[{"\[CapitalDelta]", 
         StyleBox["t", "TI"]}]]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell[TextData[{
 "with an optional projection ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], "\[Function]", 
   RowBox[{
    RowBox[{
     OverscriptBox[
      StyleBox["v", "TI"], "\[RightVector]"], "/", 
     StyleBox["max",
      FontSlant->"Plain"]}], "\[ThinSpace]", 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", ",", 
      TemplateBox[{
        OverscriptBox[
         StyleBox["v", "TI"], "\[RightVector]"]},
       "Abs"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "585a51e6-774f-2dd2-087a-48c002fa7738"],
 " that snaps any overshoot back onto the ball. One ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],
 " carries three length-",
 Cell[BoxData["ntraj"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370294fd-9e49-2d35-5d31-0da71bfc741f"],
 " vectors; a single ",
 Cell[BoxData["WhenEvent"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2845529c-454d-b13b-587b-4bc66cf90001"],
 " at each grid point draws ",
 Cell[BoxData["ntraj"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7519012f-e657-215b-2326-988893e273a1"],
 " Wiener increments ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "594776df-9e75-d16a-0f7d-6f991b01a3b0"],
 " (one per trajectory), reuses ",
 Cell[BoxData["driftV"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6405505f-4b92-3bd6-0c3b-4a196e24893c"],
 "/",
 Cell[BoxData["diffV"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6878c7f8-419e-9db5-1807-dea27028e79f"],
 ", and applies the update. The midpoint event phase ",
 Cell["Mod[t+dt/2,dt]==0", "InlineCode",ExpressionUUID->
  "48a3d607-c312-9dd3-7850-c860f6a4e739"],
 " fires exactly ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["f", "TI"]], "/", "\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539491e8-328f-8d7b-01ab-08b2473bd441"],
 " times and samples cleanly on the grid:"
}], "Text",ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"emEnsemble", "[", 
    RowBox[{"rates_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x0_", ",", " ", "y0_", ",", " ", "z0_"}], "}"}], ",", " ", 
     "tf_", ",", " ", "dt_", ",", " ", "ntraj_", ",", " ", "seed_", ",", " ", 
     "project_"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "xs", ",", " ", "ys", ",", " ", "zs", ",", " ", "sol", ",", " ", "grid",
        ",", " ", "xyzg"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"sol", " ", "=", " ", 
       RowBox[{"BlockRandom", "[", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "     ", 
         RowBox[{
          RowBox[{"NDSolve", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"xs", "'"}], "[", "t", "]"}], " ", "==", " ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"0.", ",", " ", "ntraj"}], "]"}]}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"ys", "'"}], "[", "t", "]"}], " ", "==", " ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"0.", ",", " ", "ntraj"}], "]"}]}], ",", "\n", 
              "       ", 
              RowBox[{
               RowBox[{
                RowBox[{"zs", "'"}], "[", "t", "]"}], " ", "==", " ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"0.", ",", " ", "ntraj"}], "]"}]}], ",", "\n", 
              "       ", 
              RowBox[{"WhenEvent", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{"t", " ", "+", " ", 
                    RowBox[{"dt", "/", "2"}]}], ",", " ", "dt"}], "]"}], " ", 
                 "==", " ", "0"}], ",", "\n", "        ", 
                RowBox[{"Block", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"\[CapitalDelta]W", " ", "=", " ", 
                    RowBox[{"RandomVariate", "[", 
                    RowBox[{
                    RowBox[{"NormalDistribution", "[", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{"Sqrt", "[", "dt", "]"}]}], "]"}], ",", " ", 
                    "ntraj"}], "]"}]}], ",", " ", "xyz", ",", " ", "new", ",",
                     " ", "capr"}], "}"}], ",", "\n", "         ", 
                  RowBox[{
                   RowBox[{"xyz", " ", "=", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"xs", "[", "t", "]"}], ",", " ", 
                    RowBox[{"ys", "[", "t", "]"}], ",", " ", 
                    RowBox[{"zs", "[", "t", "]"}]}], "}"}]}], ";", "\n", 
                   "         ", 
                   RowBox[{"new", " ", "=", " ", 
                    RowBox[{"xyz", " ", "+", " ", 
                    RowBox[{"MapThread", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"#1", " ", "dt"}], " ", "+", " ", 
                    RowBox[{"#2", " ", "\[CapitalDelta]W"}]}], " ", "&"}], ",",
                     " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"driftV", "[", 
                    RowBox[{"xyz", ",", " ", "rates"}], "]"}], ",", " ", 
                    RowBox[{"diffV", "[", 
                    RowBox[{"xyz", ",", " ", "rates"}], "]"}]}], "}"}]}], 
                    "]"}]}]}], ";", "\n", "         ", 
                   RowBox[{"capr", " ", "=", " ", 
                    RowBox[{"If", "[", 
                    RowBox[{"project", ",", " ", 
                    RowBox[{"Clip", "[", 
                    RowBox[{
                    RowBox[{"Sqrt", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"new", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], " ", "+", " ", 
                    RowBox[{
                    RowBox[{"new", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "+", " ", 
                    RowBox[{
                    RowBox[{"new", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "^", "2"}]}], "]"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"1.", ",", " ", "Infinity"}], "}"}]}], "]"}], ",",
                     "\n", "                   ", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"1.", ",", " ", "ntraj"}], "]"}]}], "]"}]}], ";", 
                   "\n", "         ", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"xs", "[", "t", "]"}], ",", " ", 
                    RowBox[{"ys", "[", "t", "]"}], ",", " ", 
                    RowBox[{"zs", "[", "t", "]"}]}], "}"}], " ", "->", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "/", "capr"}], " ", "&"}], " ", "/@", " ", 
                    "new"}], ")"}]}]}]}], "]"}]}], "]"}], ",", "\n", 
              "       ", 
              RowBox[{
               RowBox[{"xs", "[", "0", "]"}], " ", "==", " ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{
                 RowBox[{"N", "@", "x0"}], ",", " ", "ntraj"}], "]"}]}], ",", 
              " ", 
              RowBox[{
               RowBox[{"ys", "[", "0", "]"}], " ", "==", " ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{
                 RowBox[{"N", "@", "y0"}], ",", " ", "ntraj"}], "]"}]}], ",", 
              "\n", "       ", 
              RowBox[{
               RowBox[{"zs", "[", "0", "]"}], " ", "==", " ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{
                 RowBox[{"N", "@", "z0"}], ",", " ", "ntraj"}], "]"}]}]}], 
             "}"}], ",", "\n", "      ", 
            RowBox[{"{", 
             RowBox[{"xs", ",", " ", "ys", ",", " ", "zs"}], "}"}], ",", " ", 
            
            RowBox[{"{", 
             RowBox[{"t", ",", " ", "0", ",", " ", "tf"}], "}"}], ",", " ", 
            RowBox[{"MaxStepSize", " ", "->", " ", "dt"}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"grid", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0.", ",", " ", "tf", ",", " ", "dt"}], "]"}]}], ";", "\n", 
      "   ", 
      RowBox[{"xyzg", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"xs", "[", "#", "]"}], ",", " ", 
             RowBox[{"ys", "[", "#", "]"}], ",", " ", 
             RowBox[{"zs", "[", "#", "]"}]}], "}"}], " ", "/.", " ", "sol"}], 
          ")"}], " ", "&"}], " ", "/@", " ", "grid"}]}], ";", "   ", 
      RowBox[{"(*", " ", 
       RowBox[{"npts", " ", "x", " ", "3", " ", "x", " ", "ntraj"}], " ", 
       "*)"}], "\n", "   ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<trajectories\>\"", " ", "->", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"xyzg", ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "3", ",", " ", "1"}], "}"}]}], "]"}]}], ",",
         "   ", 
        RowBox[{"(*", " ", 
         RowBox[{"full", " ", 
          RowBox[{"data", ":", " ", 
           RowBox[{"ntraj", " ", "x", " ", "npts", " ", "x", " ", "3"}]}]}], 
         " ", "*)"}], "\n", "     ", 
        RowBox[{"\"\<times\>\"", " ", "->", " ", "grid"}], ",", " ", 
        RowBox[{"\"\<meanZ\>\"", " ", "->", " ", 
         RowBox[{"Mean", " ", "/@", " ", 
          RowBox[{"xyzg", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}]}], ",", "\n", 
        "     ", 
        RowBox[{"\"\<zTrajs\>\"", " ", "->", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"xyzg", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "]"}]}], ",", "\n", 
        "     ", 
        RowBox[{"\"\<maxr\>\"", " ", "->", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"xyzg", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "^", "2"}], " ", 
            "+", " ", 
            RowBox[{
             RowBox[{"xyzg", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "^", "2"}], " ", 
            "+", " ", 
            RowBox[{
             RowBox[{"xyzg", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "^", "2"}]}], 
           "]"}], "]"}]}]}], "|>"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"023f49e2-a747-9723-33c5-60cfd2f3fa09"],

Cell[TextData[{
 "The exact reference is the mean ODE from the first section, which closes in \
a ",
 Cell[BoxData["DSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21aa1c49-e16c-f406-57a9-9612901edf6c"],
 " closed form (no integration error). Wrapped as a function of the rates, \
initial state, and time, it returns the full mean Bloch vector ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["v", "TI"], "\[RightVector]"], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", "{", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["y", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["z", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "}", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "289b85cd-827f-9a9c-58b8-1c97370be8e6"],
 "; its third component is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f3dbee-abc4-6375-4280-d2cbce714e5f"],
 ":"
}], "Text",ExpressionUUID->"7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"lindbladBloch", "[", 
     RowBox[{"rates_", ",", " ", 
      RowBox[{"{", 
       RowBox[{"x0_", ",", " ", "y0_", ",", " ", "z0_"}], "}"}]}], "]"}], " ",
     ":=", "\n", "  ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[CapitalGamma]CI", ",", " ", "\[CapitalGamma]BA", ",", " ", 
        "\[CapitalGamma]d", ",", " ", "\[Gamma]\[Phi]", ",", " ", "\[Gamma]1",
         ",", " ", "\[CapitalOmega]x", ",", " ", "\[CapitalGamma]2eff", ",", 
        " ", "sol"}], "}"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\[CapitalGamma]CI", ",", " ", "\[CapitalGamma]BA", ",", " ", 
          "\[CapitalGamma]d", ",", " ", "\[Gamma]\[Phi]", ",", " ", 
          "\[Gamma]1", ",", " ", "\[CapitalOmega]x"}], "}"}], " ", "=", " ", 
        "rates"}], ";", "\n", "   ", 
       RowBox[{"\[CapitalGamma]2eff", " ", "=", " ", 
        RowBox[{
         RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", "\[Gamma]\[Phi]", 
         " ", "+", " ", "\[CapitalGamma]d"}]}], ";", "\n", "   ", 
       RowBox[{"sol", " ", "=", " ", 
        RowBox[{
         RowBox[{"DSolve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"\[FormalX]", "'"}], "[", "t", "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"-", "\[CapitalGamma]2eff"}], " ", 
               RowBox[{"\[FormalX]", "[", "t", "]"}]}]}], ",", "\n", "      ", 
             RowBox[{
              RowBox[{
               RowBox[{"\[FormalY]", "'"}], "[", "t", "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "\[CapitalGamma]2eff"}], " ", 
                RowBox[{"\[FormalY]", "[", "t", "]"}]}], " ", "-", " ", 
               RowBox[{"\[CapitalOmega]x", " ", 
                RowBox[{"\[FormalZ]", "[", "t", "]"}]}]}]}], ",", "\n", 
             "      ", 
             RowBox[{
              RowBox[{
               RowBox[{"\[FormalZ]", "'"}], "[", "t", "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"\[Gamma]1", " ", 
                RowBox[{"(", 
                 RowBox[{"1", " ", "-", " ", 
                  RowBox[{"\[FormalZ]", "[", "t", "]"}]}], ")"}]}], " ", "+", 
               " ", 
               RowBox[{"\[CapitalOmega]x", " ", 
                RowBox[{"\[FormalY]", "[", "t", "]"}]}]}]}], ",", "\n", 
             "      ", 
             RowBox[{
              RowBox[{"\[FormalX]", "[", "0", "]"}], " ", "==", " ", "x0"}], ",",
              " ", 
             RowBox[{
              RowBox[{"\[FormalY]", "[", "0", "]"}], " ", "==", " ", "y0"}], ",",
              " ", 
             RowBox[{
              RowBox[{"\[FormalZ]", "[", "0", "]"}], " ", "==", " ", "z0"}]}],
             "}"}], ",", "\n", "     ", 
           RowBox[{"{", 
            RowBox[{
            "\[FormalX]", ",", " ", "\[FormalY]", ",", " ", "\[FormalZ]"}], 
            "}"}], ",", " ", "t"}], "]"}], " ", "//", " ", "First"}]}], ";", 
       "\n", "   ", 
       RowBox[{"Function", "[", 
        RowBox[{"tt", ",", " ", 
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[FormalX]", "[", "tt", "]"}], ",", " ", 
             RowBox[{"\[FormalY]", "[", "tt", "]"}], ",", " ", 
             RowBox[{"\[FormalZ]", "[", "tt", "]"}]}], "}"}], " ", "/.", " ", 
           "sol"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"<", "x", ">"}], ",", 
      RowBox[{"<", "y", ">"}], ",", 
      RowBox[{"<", "z", ">"}]}], "}"}], 
    RowBox[{"(", "tt", ")"}]}], " ", "*)"}]}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"],

Cell["Reproduction on a clean dimensionless case", "Section",ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell[TextData[{
 "Rescaling every rate by ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01ed6b92-5a5f-fa78-3792-82dc5febc942"],
 " makes the physics dimensionless without changing it: the trajectory in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Tau]", "TI"], "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa29c-d013-1000-4004-3bd9e1a6636a"],
 " is identical, and the dimensionless ratios that survive are what matter. \
Take the decoherence structure of a representative dispersive transmon (",
 Cell[BoxData[
  RowBox[{"30", "/", "20", " ", 
   StyleBox["\[Mu]", "TI"], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6798df62-4cc7-e4e1-0da7-d74c6573cecb"],
 " for ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "1"], "/", 
   SubscriptBox[
    StyleBox["T", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49f5450b-e8d1-97dd-7f8b-5d548965fd27"],
 ", a weak readout), rescaled by ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],
 ", which gives ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]}], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], ",", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "1"], "}", "/", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "1"], "=", "{", "0.352"}], ",", "0", ",", 
   "0.176", ",", "1", ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b990c23-b656-01a6-39a6-a58cc3e3538c"],
 " with efficiency ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]], "+", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"B", "A"}], "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox["d", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52243646-2fbd-210e-03db-a8204a487054"],
 " (optimal homodyne phase). Pair it with a deliberately gentle drive ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalOmega]", 
    StyleBox["x", "TI"]], "/", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1acd7f4d-3da3-7753-4af3-7717b4565db9"],
 ", from a ground-state start ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "0"}], ",", "0", ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "062d91f0-6326-41c0-2fd2-08ba16d3132a"],
 ". The drive is gentled on purpose so the explicit scheme sits well inside \
its stability window; the true transmon drive is about sixty times faster, \
and that stiff case is the honest catch below. The rate vector is positional, \
",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]}], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], ",", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], ",", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], ",", 
   RowBox[{
    SubscriptBox["\[CapitalOmega]", 
     StyleBox["x", "TI"]], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],
 ":"
}], "Text",ExpressionUUID->"6f6ad260-8ee1-565a-1569-d44a2a943ca0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ratesB", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0.352", ",", " ", "0.", ",", " ", "0.176", ",", " ", "1.", ",", " ", 
     "1.", ",", " ", "3."}], "}"}]}], ";", " ", 
  RowBox[{"initB", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.", ",", " ", "0.", ",", " ", "1."}], "}"}]}], ";", " ", 
  RowBox[{"tfB", " ", "=", " ", "3."}], ";", " ", 
  RowBox[{"nB", " ", "=", " ", "1000"}], ";"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell[TextData[{
 "First the exact reference: the affine mean ODE closed in ",
 Cell[BoxData["DSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],
 " form, evaluated as a function of time (its third component is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],
 "):"
}], "Text",ExpressionUUID->"6b853673-18d0-d9fa-19ba-a83d996aabc0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lindB", " ", "=", " ", 
   RowBox[{"lindbladBloch", "[", 
    RowBox[{"ratesB", ",", " ", "initB"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"],

Cell[TextData[{
 "Next the native route, integrating ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "574a2197-51ef-7938-7d49-b8d1679a4802"],
 " trajectories of the ",
 Cell[BoxData["ItoProcess"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e85e9ed-427b-8528-16ba-00b7770fec72"],
 " with the SDE-native scalar-noise stochastic Runge-Kutta:"
}], "Text",ExpressionUUID->"73b76025-96bb-3fff-214d-798f234f85c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"itoB", " ", "=", " ", 
   RowBox[{"itoEnsemble", "[", 
    RowBox[{"ratesB", ",", " ", "initB", ",", " ", "tfB", ",", " ", 
     RowBox[{"tfB", "/", "600"}], ",", " ", "nB", ",", " ", "2024"}], "]"}]}],
   ";"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"],

Cell[TextData[{
 "Then the hand-rolled route, the same ensemble through the projected \
Euler-Maruyama inside ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ff7667-e560-b2c0-2285-68408c1a002a"],
 "/",
 Cell[BoxData["WhenEvent"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c9be80e-0554-61c1-24b8-0268ace1332b"],
 ":"
}], "Text",ExpressionUUID->"106b7ad8-6378-599b-4069-7382160d2be1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"emB", " ", "=", " ", 
   RowBox[{"emEnsemble", "[", 
    RowBox[{"ratesB", ",", " ", "initB", ",", " ", "tfB", ",", " ", 
     RowBox[{"tfB", "/", "600"}], ",", " ", "nB", ",", " ", "2024", ",", " ", 
     "True"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],

Cell[TextData[{
 "Compare the exact final ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "304452a4-201b-d64c-607c-4b0e51afbc96"],
 " against the two ensemble means:"
}], "Text",ExpressionUUID->"6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"lindB", "[", "tfB", "]"}], "[", 
    RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
   RowBox[{"Last", "[", 
    RowBox[{"itoB", "[", "\"\<meanZ\>\"", "]"}], "]"}], ",", " ", 
   RowBox[{"Last", "[", 
    RowBox[{"emB", "[", "\"\<meanZ\>\"", "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"4b5b9263-9199-4e16-7978-144d202c157c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.1466657170433383`", ",", "0.15297872769048965`", ",", 
   "0.14681418080391148`"}], "}"}]], "Output",
 CellLabel->
  "Out[17]= ",ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"]
}, Open  ]],

Cell[TextData[{
 "Both ensemble means land within the Monte-Carlo scatter ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],
 " of the exact Lindblad, which is the sense in which they agree. As curves, \
the two ensemble means track the exact black line:"
}], "Text",ExpressionUUID->"3343f580-98d5-e31c-6170-ecea1961ce66"],

Cell[CellGroupData[{

