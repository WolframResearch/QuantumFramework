Cell["\<\
The table shows how the estimated mean and spread vary across the sampled \
noise meshes. Put the mean column in pointwise Monte Carlo standard-error \
units relative to the exact Lindblad value:\
\>", "Text",ExpressionUUID->"6724c974-bdf1-27a5-0edb-e13e3b858d8f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lbz", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"lindbladBloch", "[", 
        RowBox[{"ratesB", ",", " ", 
         RowBox[{"initB", "[", 
          RowBox[{"[", 
           RowBox[{"1", " ", ";;", " ", "3"}], "]"}], "]"}]}], "]"}], "[", 
       "tfB", "]"}], "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"TableForm", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"tfB", "/", 
          RowBox[{"{", 
           RowBox[{
           "6", ",", " ", "12", ",", " ", "25", ",", " ", "100", ",", " ", 
            "400"}], "}"}]}], "]"}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Mean", "[", "#", "]"}], " ", "-", " ", "lbz"}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"StandardDeviation", "[", "#", "]"}], "/", 
             RowBox[{"Sqrt", "[", "nSweep", "]"}]}], ")"}]}], " ", "&"}], " ",
          "/@", " ", "sweepZB"}]}], "}"}], "]"}], ",", "\n", "  ", 
     RowBox[{"TableHeadings", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<noise step\>\"", ",", 
          " ", "\"\<gap of the mean from Lindblad, in standard errors\>\""}], 
         "}"}]}], "}"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"2b52875c-0948-9ae8-5961-1f06a8e2e832"],

