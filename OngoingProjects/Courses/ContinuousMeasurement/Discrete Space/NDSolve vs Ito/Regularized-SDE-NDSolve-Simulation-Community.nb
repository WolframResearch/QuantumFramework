     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"23ccc6ee-92c0-e596-51f3-dfc8277acffc"],

Cell[TextData[{
 "In the infinite-ensemble limit, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["z", "TI"], "_"], "\[Rule]", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "114d8d02-b276-9c05-4772-256fc700e76f"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["W", "TI"], "_"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dc22b63-32d1-862f-5bf1-c34d4765ed75"],
 ", recovering the exact prediction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["Q", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], 
   UnderoverscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"],
    LimitsPositioning->False], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["z", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["s", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], " ", 
   StyleBox["d", "TI"], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36ea7e2c-072a-2221-5eea-7076b2df710b"],
 ". At finite ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["traj",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b23761c-2477-64e8-0ad1-68464d024e32"],
 ", the averaged Wiener path has standard deviation ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["t", "TI"], "/", 
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["traj",
      FontSlant->"Plain"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73216bcf-7cf1-61ac-22de-82a9748433f6"],
 ", so it leaves a Brownian-like residual wander rather than cancelling \
exactly. For example, at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["traj",
     FontSlant->"Plain"]], "=", "600"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "409bca18-cbd6-e54d-70b8-ec45ee60cf97"],
 ", this direct noise contribution has a standard deviation of about ",
 Cell[BoxData["0.071"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b62b5f-1d3f-f012-404d-c31994cbc378"],
 ". The complete discrepancy also includes sampling fluctuations in ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["z", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79984792-c453-565a-2fb8-5edfede63ca0"],
 ", so its appropriate error scale is the standard error of the mean record, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["Q", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox[
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["traj",
      FontSlant->"Plain"]]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d45428e-8fa1-6801-4b7b-5be82a543b6b"],
 ". The signal survives averaging, while the statistical fluctuations shrink \
as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["traj",
      FontSlant->"Plain"]]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "604bb87d-3174-a116-1048-32274006f07c"],
 "."
}], "Text",ExpressionUUID->"763191a2-6f8b-197a-1fce-080c0a3e6840"],

Cell[TextData[{
 "Quantify the agreement at each nonzero grid time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "635fdfdb-2856-deda-1164-d68549e0a420"],
 " with the standardized residual"
}], "Text",ExpressionUUID->"0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["Q", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["j", "TI"]], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox[GridBox[{
       {
        RowBox[{
         OverscriptBox[
          StyleBox["Q", "TI"], "_"], 
         StyleBox["(",
          SpanMaxSize->1], 
         SubscriptBox[
          StyleBox["t", "TI"], 
          StyleBox["j", "TI"]], 
         StyleBox[")",
          SpanMaxSize->1], "-", 
         SubscriptBox[
          StyleBox["Q", "TI"], 
          StyleBox["pred",
           FontSlant->"Plain"]], 
         StyleBox["(",
          SpanMaxSize->1], 
         SubscriptBox[
          StyleBox["t", "TI"], 
          StyleBox["j", "TI"]], 
         StyleBox[")",
          SpanMaxSize->1]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], 
     RowBox[{
      SubscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["Q", "TI"]], 
      StyleBox["(",
       SpanMaxSize->1], 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["j", "TI"]], 
      StyleBox[")",
       SpanMaxSize->1], "/", 
      SqrtBox[
       SubscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["traj",
         FontSlant->"Plain"]]]}]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"5c8469dd-bfc7-2a7a-04bb-80873a727940"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["pred",
     FontSlant->"Plain"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["j", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], 
   UnderoverscriptBox["\[Integral]", "0", 
    SubscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["j", "TI"]],
    LimitsPositioning->False], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["z", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["s", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], " ", 
   StyleBox["d", "TI"], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["Q", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["j", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3921e4bb-f5e4-3596-68de-fde483969ffc"],
 " is the sample standard deviation of the records at that time. The \
denominator therefore includes both the direct Wiener noise and the \
trajectory-to-trajectory variation of the integrated signal. Omit ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13db9173-5387-1c16-41f8-093d6632677c"],
 ", where every record is fixed at zero and the standard error vanishes, and \
report the largest standardized residual on the sampled grid:"
}], "Text",ExpressionUUID->"6804c0ab-fd16-b7db-183b-d9f4f4a01d21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"Rest", "[", 
       RowBox[{"noiseGrid", "[", 
        RowBox[{"tfB", ",", " ", 
         RowBox[{"dtGenOf", "[", "ratesB", "]"}]}], "]"}], "]"}]}], ",", " ", 
     
     RowBox[{"qc", " ", "=", " ", 
      RowBox[{"recQB", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", 
         RowBox[{"2", " ", ";;"}]}], "]"}], "]"}]}]}], "}"}], ",", "\n", " ", 
   
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Mean", "[", "qc", "]"}], " ", "-", " ", 
       RowBox[{"(", 
        RowBox[{"qpredB", " ", "/@", " ", "g"}], ")"}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"StandardDeviation", "[", "qc", "]"}], "/", 
       RowBox[{"Sqrt", "[", "nB", "]"}]}], ")"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],

Cell[BoxData["1.6511691179115477`"], "Output",
 CellChangeTimes->{3.9957151016003036`*^9},
 CellLabel->"Out[61]=",ExpressionUUID->"9dc3c193-8584-4ae2-abe7-af78894cb3e9"]
}, Open  ]],

Cell["\<\
The result measures the largest pointwise discrepancy in standard-error \
units. Because the maximum is taken over correlated times, pointwise Gaussian \
thresholds do not give its false-alarm probability. It is a diagnostic of \
scale, not a calibrated simultaneous test and not a claim about unsampled \
times.\
\>", "Text",ExpressionUUID->"4289b0c6-8043-1b93-72b6-29a031f669f9"],

Cell[TextData[{
 "The record's spread deserves the same two-route treatment as the state's, \
and the native ensemble has been carrying the fourth row all along; read its \
final-",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070f3e08-556d-9d60-2d34-b0525c19e44a"],
 " spread against the regularized ensemble's, in the same units as before:"
}], "Text",ExpressionUUID->"6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"spreadGap", "[", 
  RowBox[{
   RowBox[{"stratRunB", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", 
      RowBox[{"-", "1"}], ",", " ", "4"}], "]"}], "]"}], ",", " ", 
   RowBox[{"recQB", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", 
      RowBox[{"-", "1"}]}], "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[62]:=",ExpressionUUID->"4140e475-1e41-1f16-777f-fe3f9bf4627c"],

Cell[BoxData["0.9009946547122958`"], "Output",
 CellChangeTimes->{3.995715101606192*^9},
 CellLabel->"Out[62]=",ExpressionUUID->"5ca9353e-bbd8-47e5-a7ec-40956b744e19"]
}, Open  ]],

Cell["\<\
The final-record spread supplies the corresponding diffusion-sensitive \
comparison for the fourth row. Here the two finite samples differ on the \
scale estimated above.\
\>", "Text",ExpressionUUID->"67f13035-938c-831a-0d8e-aa7f263eee60"],

Cell[TextData[{
 "The average removed the noise, but a single record still carries it, and \
carries a specific one. Since ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["Q", "TI"], "-", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["z", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "=", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b44e14-0404-e868-3e4c-605eadb6bab2"],
 " exactly, subtracting the integrated signal from one record must return the \
very Wiener path that drove the state. Build one trajectory, strip its \
signal, and overlay the remainder on its driving path ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],
 ":"
}], "Text",ExpressionUUID->"7e10bd94-ae42-3b4d-262f-34d1cbf48997"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", " ", "=", " ", "ratesB"}], ",", " ", 
     RowBox[{"dt", " ", "=", " ", 
      RowBox[{"dtGenOf", "[", "ratesB", "]"}]}], ",", " ", 
     RowBox[{"seed", " ", "=", " ", "7"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Wf", " ", "=", " ", 
        RowBox[{"wienerFun", "[", 
         RowBox[{"tfB", ",", " ", "dt", ",", " ", "seed"}], "]"}]}], ",", " ", 
       RowBox[{"traj", " ", "=", " ", 
        RowBox[{"oneTraj", "[", 
         RowBox[{
         "r", ",", " ", "initB", ",", " ", "tfB", ",", " ", "dt", ",", " ", 
          "seed", ",", " ", 
          RowBox[{"dt", "/", "4"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "t", ",", " ", "zint"}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{
        RowBox[{"zint", " ", "=", " ", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"u", "'"}], "[", "t", "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"traj", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}]}], ",", " ", 
             RowBox[{
              RowBox[{"u", "[", "0", "]"}], " ", "==", " ", "0."}]}], "}"}], ",",
            " ", "u", ",", " ", 
           RowBox[{"{", 
            RowBox[{"t", ",", " ", "0", ",", " ", "tfB"}], "}"}]}], "]"}]}], ";",
         "\n", "   ", 
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"traj", "[", 
               RowBox[{"[", "4", "]"}], "]"}], "[", "t", "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"Sqrt", "[", 
               RowBox[{"r", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", 
              RowBox[{"zint", "[", "t", "]"}]}]}], ",", " ", 
            RowBox[{"Wf", "[", "t", "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "0", ",", " ", "tfB"}], "}"}], ",", "\n", 
          "    ", 
          RowBox[{"PlotStyle", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"Thick", ",", " ", "Dashed"}], "}"}]}], ",", "\n", "    ", 
          RowBox[{"PlotLegends", " ", "->", " ", 
           RowBox[{"Placed", "[", 
            RowBox[{
             RowBox[{"{", 
              
              RowBox[{"\"\<record minus signal: Q(t) - \!\(\*SqrtBox[\(\
\[CapitalGamma]CI\)]\) \[Integral]z dt\>\"", ",", 
               " ", "\"\<driving path W(t)\>\""}], "}"}], ",", " ", "Below"}],
             "]"}]}], ",", "\n", "    ", 
          RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
          RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
          RowBox[{"FrameLabel", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<t\>\"", ",", " ", "\"\<W\>\""}], "}"}]}], ",", "\n", 
          "    ", 
          RowBox[{
          "PlotLabel", " ", "->", 
           " ", "\"\<stripping the signal from the record returns the driving \
noise\>\""}]}], "]"}]}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"],

