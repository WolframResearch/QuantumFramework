Cell[TextData[{
 "The displayed spreads provide a diffusion-sensitive comparison between the \
two finite-step routes. All three components fluctuate: ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f64ca0d-9927-5f44-651b-ec5718d225ae"],
 " starts at zero and its mean stays there, yet the backaction quadrature \
feeds its fluctuations from ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "399d1ff3-4632-be92-6fa2-96bd73c404f8"],
 "."
}], "Text",ExpressionUUID->"1170384d-2f38-2c50-470f-b2174acd76ba"],

Cell[TextData[{
 "The sample spread is itself uncertain. A large-sample delta-method estimate \
is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["SE",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["s", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[TildeTilde]", 
   SqrtBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["m", "TI"], "4"], "-", 
      SuperscriptBox[
       StyleBox["s", "TI"], "4"]}], 
     StyleBox[")",
      SpanMaxSize->1], "/", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"4", 
      SuperscriptBox[
       StyleBox["s", "TI"], "2"], 
      StyleBox["n", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ce33075-6d34-44a7-1490-aa3f04c12e8d"],
 ", where ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["m", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],
 " is the fourth central moment. The plug-in code below estimates the moments \
from the same sample. It is an asymptotic scale estimate, not an exact \
finite-sample error bar."
}], "Text",ExpressionUUID->"6334ac9c-43f1-85c0-12cb-45c67585ef2a"],

Cell[TextData[{
 "Encode ",
 Cell[BoxData[
  StyleBox["SE",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74397683-04f4-1d4d-1dc7-6fedac816797"],
 ", the error bar of one spread, both moments read off the sample:"
}], "Text",ExpressionUUID->"735e49d5-32a1-4a48-2166-609f47541892"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "sdErr", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sdErr", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", " ", "=", " ", 
       RowBox[{"CentralMoment", "[", 
        RowBox[{"x", ",", " ", "2"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"CentralMoment", "[", 
          RowBox[{"x", ",", " ", "4"}], "]"}], " ", "-", " ", 
         RowBox[{"v", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"4", " ", "v", " ", 
         RowBox[{"Length", "[", "x", "]"}]}], ")"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"335d55a2-cf9b-493d-6163-4c0fea2e1807"],

Cell["\<\
Compare the Stratonovich and regularized spreads by dividing their absolute \
difference by their combined standard error,\
\>", "Text",ExpressionUUID->"3bfbbd45-edb8-1b0b-6998-352e844d6651"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["G", "TI"], "=", 
    FractionBox[GridBox[{
       {
        RowBox[{
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["Strat",
           FontSlant->"Plain"]], "-", 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["reg",
           FontSlant->"Plain"]]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], 
     SqrtBox[
      RowBox[{
       StyleBox["SE",
        FontSlant->"Plain"], 
       SuperscriptBox[
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["Strat",
           FontSlant->"Plain"]], 
         StyleBox[")",
          SpanMaxSize->1]}], "2"], "+", 
       StyleBox["SE",
        FontSlant->"Plain"], 
       SuperscriptBox[
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["reg",
           FontSlant->"Plain"]], 
         StyleBox[")",
          SpanMaxSize->1]}], "2"]}]]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"045023ab-c37d-b770-2c6f-baf4f6091a5a"],

Cell[TextData[{
 "so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["G", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73e8aeff-5b91-f8f4-2197-47b95e25cade"],
 " means that the two spreads differ by one combined standard error. Encode \
this statistic:"
}], "Text",ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "spreadGap", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"spreadGap", "[", 
    RowBox[{"x1_", ",", " ", "x2_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"StandardDeviation", "[", "x1", "]"}], " ", "-", " ", 
      RowBox[{"StandardDeviation", "[", "x2", "]"}]}], "]"}], "/", "\n", 
    "   ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"sdErr", "[", "x1", "]"}], "^", "2"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"sdErr", "[", "x2", "]"}], "^", "2"}]}], "]"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"794a4309-908b-2549-2f4a-5b53213f8f93"],

Cell["Read each component's gap in those units:", "Text",ExpressionUUID->"167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AssociationThread", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<Spread gap in x\>\"", ",", " ", "\"\<Spread gap in y\>\"", ",",
      "\n", "  ", "\"\<Spread gap in z\>\""}], "}"}], ",", "\n", " ", 
   RowBox[{"spreadGap", "[", 
    RowBox[{
     RowBox[{"stratRunB", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", 
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"1", " ", ";;", " ", "3"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{"regRunB", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", 
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"1", " ", ";;", " ", "3"}]}], "]"}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[52]:=",ExpressionUUID->"15eb24b6-b946-3a65-43e8-bdf038f0894f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Spread gap in x\"\>", "\[Rule]", "1.3443544097602969`"}], ",", 
   RowBox[{"\<\"Spread gap in y\"\>", "\[Rule]", "0.8634181216654757`"}], ",", 
   RowBox[{"\<\"Spread gap in z\"\>", "\[Rule]", "0.5552444622627272`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.995715100577681*^9},
 CellLabel->"Out[52]=",ExpressionUUID->"e1ef9b11-b093-4314-ad3c-a14b19e349db"]
}, Open  ]],

Cell["\<\
The returned numbers express each spread difference in approximate \
combined-standard-error units. They are useful diagnostics, but they are not \
a distribution-free hypothesis test and do not justify the phrase \
\[OpenCurlyDoubleQuote]statistically \
indistinguishable\[CloseCurlyDoubleQuote] without a calibrated sampling \
analysis.\
\>", "Text",ExpressionUUID->"27d2a24c-1e84-19ee-4de1-44169b316b34"],

Cell[TextData[{
 "The conditional state must stay in the unit Bloch ball. On its boundary the \
radial diffusion vanishes, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"], "=", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], 
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["x", "TI"], "2"], "-", 
    SuperscriptBox[
     StyleBox["y", "TI"], "2"], "-", 
    SuperscriptBox[
     StyleBox["z", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "285985c7-a1c8-13eb-5866-1ca0d07d6131"],
 ". The remaining stochastic-invariance condition is that the It\[OHat] \
generator applied to ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "=", 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], "+", 
   SuperscriptBox[
    StyleBox["y", "TI"], "2"], "+", 
   SuperscriptBox[
    StyleBox["z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57868ed1-450c-c474-7dbd-279b6cbeaf5e"],
 " point inward or tangent there. Its boundary value is ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], "+", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c5e608e-35dc-f74f-3466-79e8bc6edd95"],
 ":"
}], "Text",ExpressionUUID->"1a1e4090-3303-05ed-4a26-59da46b66f37"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     RowBox[{
      RowBox[{"\[ScriptCapitalL]", 
       StyleBox["(",
        SpanMaxSize->1], 
       SuperscriptBox[
        StyleBox["r", "TI"], "2"], 
       StyleBox[")",
        SpanMaxSize->1]}], "\[RightBracketingBar]"}], 
     RowBox[{
      StyleBox["r", "TI"], "=", "1"}]], "=", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["z", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1], " ", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox["\[CapitalGamma]", 
      StyleBox[
       RowBox[{"C", "I"}], "TI"]], "+", 
     SubscriptBox["\[CapitalGamma]", 
      StyleBox[
       RowBox[{"B", "A"}], "TI"]], "-", "2", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox["\[CapitalGamma]", 
       StyleBox["d", "TI"]], "+", 
      SubscriptBox[
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["\[Phi]", "TI"]]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox[")",
     SpanMaxSize->1], "-", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "1"], 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"1", "-", 
       StyleBox["z", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"10256af3-3972-af7a-41da-83bdb804f240"],

Cell[TextData[{
 "where ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "457602f1-d86e-ac86-730d-9bbad918f6ec"],
 " is the It\[OHat] generator."
}], "Text",ExpressionUUID->"499f95c1-a958-6c18-7fa4-0caac8ed3762"],

Cell["\<\
Verify that closed form, substituting a point on the sphere and subtracting \
the claim:\
\>", "Text",ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"b3", " ", "=", " ", 
     RowBox[{
      RowBox[{"diffStrat", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], "}"}], ",",
         " ", "ratesSym"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", " ", ";;", " ", "3"}], "]"}], "]"}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", ".", " ", 
           RowBox[{"driftIto", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
             "ratesSym"}], "]"}]}]}], " ", "+", " ", 
         RowBox[{"b3", " ", ".", " ", "b3"}]}], ")"}], " ", "/.", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"z", "^", "2"}]}], "]"}], " ", 
           RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ",", " ", 
         RowBox[{"y", " ", "->", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"z", "^", "2"}]}], "]"}], " ", 
           RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}]}], "}"}]}], ")"}], " ", "-",
      "\n", "   ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"z", "^", "2"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ratesSym", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
          RowBox[{"ratesSym", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"ratesSym", "[", 
              RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
             RowBox[{"ratesSym", "[", 
              RowBox[{"[", "4", "]"}], "]"}]}], ")"}]}]}], ")"}]}], " ", "-", 
       "\n", "     ", 
       RowBox[{
        RowBox[{"ratesSym", "[", 
         RowBox[{"[", "5", "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "z"}], ")"}], "^", "2"}]}]}], ")"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[53]:=",ExpressionUUID->"0c02104f-9807-e6c4-3431-8a2919b3cc2e"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.995715100584988*^9},
 CellLabel->"Out[53]=",ExpressionUUID->"81c0ad87-776c-4ba3-a676-2e558fb85c54"]
}, Open  ]],

Cell[TextData[{
 "The subtraction cancels identically. The relaxation term is nonpositive and \
vanishes quadratically at the ground pole, whereas the measurement term is \
linear in ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   StyleBox["z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f909018-5ea1-6a32-15af-0a425b543918"],
 " near that pole. Consequently the generator is inward or tangent at every \
boundary point if and only if ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "+", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "\[LessEqual]", "2", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     StyleBox["d", "TI"]], "+", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Phi]", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f4595f3-090a-1216-557a-0cbda8bf617c"],
 ". Under nonnegative rates and the usual existence assumptions, this is the \
Bloch-ball invariance condition for this SDE. Every ensemble rate set below \
satisfies it; one single-path example deliberately violates it. The following \
maximum is only a numerical spot-check of the regularized solver:"
}], "Text",ExpressionUUID->"06385f5e-e9d4-4e6c-2fd8-571b886114b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Map", "[", 
   RowBox[{"Norm", ",", " ", 
    RowBox[{"regRunB", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "All", ",", " ", 
       RowBox[{"1", " ", ";;", " ", "3"}]}], "]"}], "]"}], ",", " ", 
    RowBox[{"{", "2", "}"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],

Cell[BoxData["1.`"], "Output",
 CellChangeTimes->{3.995715100613468*^9},
 CellLabel->"Out[54]=",ExpressionUUID->"b6d5d9b3-be35-4b74-ab62-5d187613d825"]
}, Open  ]],

Cell[TextData[{
 "The radius sits at one to within a hair, with no projection step. Read this \
as a spot-check of positivity, not a proof of it: it samples one ensemble on \
a fixed grid from a state that began on the surface. Violate the \
admissibility condition, which for a detector means ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], ">", "1", "+", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "/", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9a140e-d97a-4136-69b9-8e6bd80f101c"],
 ", more information extracted than the dephasing paid for, and the equation \
stops being a valid unraveling: the trajectory can leave the ball, and its \
coordinates no longer describe a density matrix. That failure is one cell \
away. Fix rates that fail the check, twice the information the dephasing \
supplies, start on the sphere away from the pole where the closed form above \
makes the flux point outward, and read the largest radius one path reaches:"
}], "Text",ExpressionUUID->"4f9438da-b80f-a114-75ab-b18439bbf07e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ratesBad", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "2.", ",", " ", "0.", ",", " ", "0.5", ",", " ", "0.", ",", " ", "1.", ",",
        " ", "0."}], "}"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tr", " ", "=", " ", 
       RowBox[{"oneTraj", "[", 
        RowBox[{"ratesBad", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.8", ",", " ", "0.", ",", " ", "0.6", ",", " ", "0."}], 
          "}"}], ",", " ", "1.", ",", " ", 
         RowBox[{"dtGenOf", "[", "ratesBad", "]"}], ",", " ", "5", ",", " ", 
         RowBox[{
          RowBox[{"dtGenOf", "[", "ratesBad", "]"}], "/", "4"}]}], "]"}]}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{"Max", "[", 
      RowBox[{"Norm", " ", "/@", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"Subdivide", "[", 
            RowBox[{"0.", ",", " ", "1.", ",", " ", "200"}], "]"}], "]"}], 
          " ", "&"}], " ", "/@", " ", 
         RowBox[{"tr", "[", 
          RowBox[{"[", 
           RowBox[{"1", " ", ";;", " ", "3"}], "]"}], "]"}]}], "]"}]}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[55]:=",ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell[BoxData["1.0247271358992156`"], "Output",
 CellChangeTimes->{3.995715100678857*^9},
 CellLabel->"Out[55]=",ExpressionUUID->"97919aa4-3eea-4d04-bbb0-1033e5b70b9d"]
}, Open  ]],

Cell["\<\
The radius runs past one. At the chosen initial boundary point the radial \
diffusion is zero while the radial generator points outward, so the model \
immediately violates the invariance condition. The equation still integrates; \
what fails is its interpretation as a density-matrix trajectory.\
\>", "Text",ExpressionUUID->"3c8746fc-db76-c487-64bd-5fb9de00aeed"],

Cell[TextData[{
 "The boundary is just as sharp from the inside. Saturate the condition with \
no relaxation and no intrinsic dephasing, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11f0f87a-e6f0-91cd-478f-f227928ae317"],
 " with both quadratures on and the drive on too, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "+", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "=", "2", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "473164ce-b547-c1f4-6ecf-7da83cf393de"],
 " exactly, and the closed form above vanishes identically: the sphere itself \
is invariant, so a pure state stays pure along every single trajectory, not \
merely on average. Start a path on the sphere and read how far it ever leaves:"
}], "Text",ExpressionUUID->"12c4fc3b-e00c-2bba-42fb-f66491b97980"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rPure", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "0.352", ",", " ", "0.4", ",", " ", "0.376", ",", " ", "0.", ",", " ", 
       "0.", ",", " ", "3."}], "}"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tr", " ", "=", " ", 
        RowBox[{"oneTraj", "[", 
         RowBox[{"rPure", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.6", ",", " ", "0.", ",", " ", "0.8", ",", " ", "0."}], 
           "}"}], ",", " ", "3.", ",", " ", 
          RowBox[{"dtGenOf", "[", "rPure", "]"}], ",", " ", "5", ",", " ", 
          RowBox[{
           RowBox[{"dtGenOf", "[", "rPure", "]"}], "/", "4"}]}], "]"}]}], ",",
        "\n", "   ", 
       RowBox[{"s", " ", "=", " ", 
        RowBox[{"Subdivide", "[", 
         RowBox[{"0.", ",", " ", "3.", ",", " ", "400"}], "]"}]}]}], "}"}], ",",
      "\n", "  ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"Norm", " ", "/@", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "s", "]"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"tr", "[", 
            RowBox[{"[", 
             RowBox[{"1", " ", ";;", " ", "3"}], "]"}], "]"}]}], "]"}]}], " ",
         "-", " ", "1"}], "]"}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[56]:=",ExpressionUUID->"1d7e6892-18cd-6f45-4b05-81dc997835af"],

Cell[BoxData["5.794197892816655`*^-6"], "Output",
 CellChangeTimes->{3.995715101054109*^9},
 CellLabel->"Out[56]=",ExpressionUUID->"5e27b19b-e9cd-476b-bb6a-e7b900598dfc"]
}, Open  ]],

Cell["\<\
The radius sticks to the sphere at solver error, the sharpest test of the \
diffusion's scale in the document: a noise term wrong by any factor would \
walk the path off the sphere at once. On the boundary, positivity is not an \
inequality respected but an equality enforced.\
\>", "Text",ExpressionUUID->"325c8f47-cd85-89da-6263-2720e431db20"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The readout: the average signal and the shared noise", "Section",ExpressionUUID->"43fcea2e-12ab-c026-7183-0388a75f930c"],

Cell[TextData[{
 "We carried the readout ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b416c07-c3d3-bf4f-097e-8660f6670595"],
 " beside the state through every run but have only looked at the state. Turn \
to the record itself. Taking the mean of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["Q", "TI"], "=", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["z", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5add4728-e92e-eff1-0ae3-5f7588d8b5db"],
 " and using ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"d", "W"}], "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "621761a3-d300-b412-122d-780ce6ba1f78"],
 ", the average record is the integrated signal,"
}], "Text",ExpressionUUID->"5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["Q", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "=", 
    SqrtBox[
     SubscriptBox["\[CapitalGamma]", 
      StyleBox[
       RowBox[{"C", "I"}], "TI"]]], 
    UnderoverscriptBox["\[Integral]", "0", 
     StyleBox["t", "TI"],
     LimitsPositioning->False], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["z", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["s", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], " ", 
    StyleBox["d", "TI"], 
    StyleBox["s", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"7d3ffb2e-09a8-fc78-24c4-f288a842c742"],

Cell[TextData[{
 "a closed prediction we already hold, since ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4139b36b-52b1-2977-70c6-2b356744785d"],
 " is the Lindblad mean. And the records are already in hand: every stored \
trajectory carries ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "494d6e39-7750-b6eb-7f72-806302ea1c31"],
 " as its fourth component, so slice the record ensemble out of the same run \
whose state we just averaged:"
}], "Text",ExpressionUUID->"39b01e29-d171-5c92-6f4f-9072e00426f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"recQB", " ", "=", " ", 
   RowBox[{"regRunB", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "All", ",", " ", "4"}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"4f6d713e-2461-11c8-7513-69784d146312"],

Cell[TextData[{
 "The prediction is itself a closed form, not a quadrature: append ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["u", "TI"], "\[Prime]"], "=", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14ad582f-66ff-93eb-3c53-5189128be131"],
 " to the affine system and let ",
 Cell[BoxData["DSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f7ea056-2d28-85ec-7505-3a1044c2ef36"],
 " integrate it exactly:"
}], "Text",ExpressionUUID->"16b00368-b832-202d-3e4f-9b3239c77377"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "qpredB", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qpredB", " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sol", ",", " ", "xf", ",", " ", "yf", ",", " ", "zf", ",", " ", "uf", ",",
        " ", "t"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"sol", " ", "=", " ", 
       RowBox[{
        RowBox[{"DSolve", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"#1", "'"}], "[", "t", "]"}], " ", "==", " ", "#2"}],
                " ", "&"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"xf", ",", " ", "yf", ",", " ", "zf"}], "}"}], ",", 
                " ", 
                RowBox[{"driftIto", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"xf", "[", "t", "]"}], ",", " ", 
                    RowBox[{"yf", "[", "t", "]"}], ",", " ", 
                    RowBox[{"zf", "[", "t", "]"}]}], "}"}], ",", " ", 
                  "ratesB"}], "]"}]}], "}"}]}], "]"}], ",", "\n", "       ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"uf", "'"}], "[", "t", "]"}], " ", "==", " ", 
               RowBox[{
                RowBox[{"Sqrt", "[", 
                 RowBox[{"ratesB", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", 
                RowBox[{"zf", "[", "t", "]"}]}]}], ",", " ", 
              RowBox[{
               RowBox[{"xf", "[", "0", "]"}], " ", "==", " ", 
               RowBox[{"initB", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
              RowBox[{
               RowBox[{"yf", "[", "0", "]"}], " ", "==", " ", 
               RowBox[{"initB", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", "\n", "        ", 
              RowBox[{
               RowBox[{"zf", "[", "0", "]"}], " ", "==", " ", 
               RowBox[{"initB", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
              RowBox[{
               RowBox[{"uf", "[", "0", "]"}], " ", "==", " ", "0"}]}], 
             "}"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"xf", ",", " ", "yf", ",", " ", "zf", ",", " ", "uf"}], 
           "}"}], ",", " ", "t"}], "]"}], " ", "//", " ", "First"}]}], ";", 
      "\n", "   ", 
      RowBox[{"Function", "[", 
       RowBox[{"tt", ",", " ", 
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{"uf", "[", "tt", "]"}], " ", "/.", " ", "sol"}], "]"}]}], 
       "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[58]:=",ExpressionUUID->"06d00634-a672-f252-2eef-9871d304c0b8"],

Cell["Overlay the ensemble-averaged record on that prediction:", "Text",ExpressionUUID->"05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"noiseGrid", "[", 
      RowBox[{"tfB", ",", " ", 
       RowBox[{"dtGenOf", "[", "ratesB", "]"}]}], "]"}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"g", ",", " ", 
          RowBox[{"Mean", "[", "recQB", "]"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"g", ",", " ", 
          RowBox[{"qpredB", " ", "/@", " ", "g"}]}], "}"}], "]"}]}], "}"}], ",",
      "\n", "  ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "Thick"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<ensemble mean \[LeftAngleBracket]Q\[RightAngleBracket](t)\
\>\"", ",", 
        " ", "\"\<\!\(\*SqrtBox[\(\[CapitalGamma]CI\)]\) \[Integral]\
\[LeftAngleBracket]z\[RightAngleBracket] dt\>\""}], "}"}]}], ",", "\n", "  ", 
     
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<t\>\"", ",", 
        " ", "\"\<\[LeftAngleBracket]Q\[RightAngleBracket]\>\""}], "}"}]}], ",",
      "\n", "  ", 
     RowBox[{
     "PlotLabel", " ", "->", 
      " ", "\"\<the average record is the integrated signal\>\""}]}], "]"}]}],
   "]"}]], "Input",
 CellLabel->"In[60]:=",ExpressionUUID->"583a98af-415b-100e-09d9-110970ee6354"],

