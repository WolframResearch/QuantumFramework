Cell["\<\
The refined estimates show no resolved trend relative to their Monte Carlo \
uncertainty. That supports using the working step as a practical reference at \
this sample size, but it does not prove convergence.\
\>", "Text",ExpressionUUID->"3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],

Cell[TextData[{
 "Now sweep ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087f5f2f-6486-1b59-3805-56890d3369a3"],
 " from coarse to fine, the integrator step held below it, and tabulate the \
regularized mean and spread of the final ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],
 " against the grid step:"
}], "Text",ExpressionUUID->"2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nSweep", " ", "=", " ", "300"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sweepZB", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ensemble", "[", 
       RowBox[{"ratesB", ",", " ", "initB", ",", " ", "tfB", ",", " ", 
        RowBox[{"tfB", "/", "k"}], ",", " ", "nSweep", ",", " ", "6000", ",", 
        " ", "Automatic", ",", " ", "5"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "6", ",", " ", "12", ",", " ", "25", ",", " ", "100", ",", " ", 
         "400"}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
