Cell[TextData[{
 "Notice that the stripped record lands on the driving path to the width of \
the line. This is the physical content of a measurement made literal: the \
fluctuations in the record are not merely correlated with the noise that \
kicked the state, they are that noise. The observer reads ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], 
   RowBox[{
    StyleBox["\[Integral]",
     FontSize->1.15 Inherited], 
    StyleBox[
     RowBox[{"z", " ", "ds"}], "TI"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],
 " as signal; the remainder is the single innovation ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b734859-75e7-efa6-7901-62030393b58c"],
 " the detector wrote into the record and the backaction at once."
}], "Text",
 CellChangeTimes->{{3.995715673593474*^9, 
  3.995715699004839*^9}},ExpressionUUID->"4ae31c17-eefa-a706-7a90-\
96508a8c0a6c"],

Cell["\<\
Rather than trust the line width, put a number on it, the largest gap between \
the stripped record and the driving path across the window; define the \
residual once, its solver goals adjustable, and read it at the default \
tolerance:\
\>", "Text",ExpressionUUID->"00844d77-2817-3ec6-30bc-653149a3842c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "recordResidual", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"recordResidual", "[", "goal_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", " ", "=", " ", "ratesB"}], ",", " ", 
       RowBox[{"dt", " ", "=", " ", 
        RowBox[{"dtGenOf", "[", "ratesB", "]"}]}], ",", " ", 
       RowBox[{"seed", " ", "=", " ", "7"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Wf", " ", "=", " ", 
          RowBox[{"wienerFun", "[", 
           RowBox[{"tfB", ",", " ", "dt", ",", " ", "seed"}], "]"}]}], ",", 
         " ", 
         RowBox[{"traj", " ", "=", " ", 
          RowBox[{"oneTraj", "[", 
           RowBox[{
           "r", ",", " ", "initB", ",", " ", "tfB", ",", " ", "dt", ",", " ", 
            "seed", ",", " ", 
            RowBox[{"dt", "/", "4"}], ",", " ", "goal"}], "]"}]}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"u", ",", " ", "t", ",", " ", "zint"}], "}"}], ",", "\n", 
         "     ", 
         RowBox[{
          RowBox[{"zint", " ", "=", " ", 
           RowBox[{"NDSolveValue", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"u", "'"}], "[", "t", "]"}], " ", "==", " ", 
                RowBox[{
                 RowBox[{"traj", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}]}], ",", " ", 
               RowBox[{
                RowBox[{"u", "[", "0", "]"}], " ", "==", " ", "0."}]}], "}"}],
              ",", " ", "u", ",", " ", 
             RowBox[{"{", 
              RowBox[{"t", ",", " ", "0", ",", " ", "tfB"}], "}"}], ",", "\n",
              "       ", 
             RowBox[{"AccuracyGoal", " ", "->", " ", "goal"}], ",", " ", 
             RowBox[{"PrecisionGoal", " ", "->", " ", "goal"}]}], "]"}]}], ";",
           "\n", "     ", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"s", " ", "=", " ", 
              RowBox[{"Subdivide", "[", 
               RowBox[{"0.", ",", " ", "tfB", ",", " ", "1000"}], "]"}]}], 
             "}"}], ",", "\n", "      ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"traj", "[", 
                 RowBox[{"[", "4", "]"}], "]"}], "[", "s", "]"}], " ", "-", 
               " ", 
               RowBox[{
                RowBox[{"Sqrt", "[", 
                 RowBox[{"r", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", 
                RowBox[{"zint", "[", "s", "]"}]}], " ", "-", " ", 
               RowBox[{"Wf", "[", "s", "]"}]}], "]"}], "]"}]}], "]"}]}]}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"recordResidual", "[", "Automatic", "]"}]}], "Input",
 CellLabel->"In[64]:=",ExpressionUUID->"20b97f64-b973-0c8a-5047-774e380656d0"],

Cell[BoxData["1.9175845626939747`*^-6"], "Output",
 CellChangeTimes->{3.9957151025069304`*^9},
 CellLabel->"Out[66]=",ExpressionUUID->"bf08437b-df46-4b82-a17f-efc01fc1253a"]
}, Open  ]],

Cell[TextData[{
 "The same ODE defines ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["Q", "TI"], "\[Prime]"], "=", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], 
   StyleBox["z", "TI"], "+", 
   SuperscriptBox[
    StyleBox["W", "TI"], "\[Prime]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04469009-6b02-dcc3-2c7d-0a530eb4a629"],
 ", so this is a self-consistency check, not an independent validation of the \
route. Its residual combines the numerical errors of the four-component solve \
and the auxiliary integral. Rerun the same trajectory with tighter goals:"
}], "Text",ExpressionUUID->"4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"recordResidual", "[", "10", "]"}]], "Input",
 CellLabel->"In[67]:=",ExpressionUUID->"5547dfb6-0e84-e145-037c-d6f0ab36b3af"],

Cell[BoxData["1.6900609689507462`*^-8"], "Output",
 CellChangeTimes->{3.995715103087399*^9},
 CellLabel->"Out[67]=",ExpressionUUID->"ec2e4001-8985-409b-899a-7208b94b6f1e"]
}, Open  ]],

Cell["\<\
The residual decreases when the requested goals are tightened, as expected \
for integration error. The exact regularized ODE satisfies the identity; the \
reported nonzero residual is numerical.\
\>", "Text",ExpressionUUID->"12b61bfc-9cd7-eca9-424d-92a61563b6f3"],

Cell[TextData[{
 "One regime makes the tie between the monitored population and its record \
explicit. Switch off relaxation and drive, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "=", 
   SubscriptBox["\[CapitalOmega]", 
    StyleBox["x", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "451364b5-819d-fb99-7321-7dff3029c9e3"],
 ". Phase backaction and transverse dephasing still affect ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13b49e24-0fb7-4441-414b-178eaa422eab"],
 " and ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],
 ", but not ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "089aa42d-ce49-3603-38b9-3e76ebfd9d69"],
 ". Dividing the Stratonovich ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48fccab3-b886-a0f7-7883-e3fd3930f2dd"],
 " row by ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[
    StyleBox["z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cdaad60-2181-5e26-34f9-454a5034250c"],
 " and using the ordinary chain rule gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], " ", 
   StyleBox["arctanh",
    FontSlant->"Plain"], " ", 
   StyleBox["z", "TI"], "=", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], 
   StyleBox["z", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"], "=", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], " ", 
   StyleBox["d", "TI"], 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "542cff75-84e0-b601-7dd3-f73f2c9a1d6b"],
 ". Therefore"
}], "Text",ExpressionUUID->"00dd9d4d-f7ec-565f-30e2-151681993ca5"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["z", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    StyleBox["tanh",
     FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        StyleBox["arctanh",
         FontSlant->"Plain"], " ", 
        SubscriptBox[
         StyleBox["z", "TI"], "0"]}], "+", 
       SqrtBox[
        SubscriptBox["\[CapitalGamma]", 
         StyleBox[
          RowBox[{"C", "I"}], "TI"]]]}], " ", ")"}], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],

Cell[TextData[{
 "The formula determines the monitored component ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],
 ", not by itself the entire Bloch vector. First check the differential \
identity on the symbolic flow, with the formal ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "333832e2-8bec-4128-62c7-abcc2d991072"],
 " standing in for the regularized noise:"
}], "Text",ExpressionUUID->"78cf51d6-d7cd-4672-28f5-4893e2782d58"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rFree", " ", "=", " ", 
     RowBox[{"ReplacePart", "[", 
      RowBox[{"ratesSym", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"5", " ", "->", " ", "0"}], ",", " ", 
         RowBox[{"6", " ", "->", " ", "0"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"driftStrat", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], "}"}],
            ",", " ", "rFree"}], "]"}], "[", 
         RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"diffStrat", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], 
             "}"}], ",", " ", "rFree"}], "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", "w"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"z", "^", "2"}]}], ")"}]}], " ", "-", "\n", "   ", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"rFree", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"driftStrat", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], "}"}],
            ",", " ", "rFree"}], "]"}], "[", 
         RowBox[{"[", "4", "]"}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"diffStrat", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], 
             "}"}], ",", " ", "rFree"}], "]"}], "[", 
          RowBox[{"[", "4", "]"}], "]"}], " ", "w"}]}], ")"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[68]:=",ExpressionUUID->"1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.9957151030920353`*^9},
 CellLabel->"Out[68]=",ExpressionUUID->"58a1bafc-7e0c-47dd-82f0-da26bfc5e3d0"]
}, Open  ]],

Cell[TextData[{
 "The identity holds with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], ",", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "710db4a8-d877-0db2-2732-2df5d9025798"],
 " symbolic: only relaxation or a drive breaks this closed relation between \
",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e12f72-3ad4-a92f-279e-c73cbf66f875"],
 " and ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ea8612-dd18-b4f0-2ee9-185fd4921eda"],
 ". The numerical example uses ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Q", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b02f270-2101-5c3d-3931-f43a50b42707"],
 " and a bare-measurement rate set on the admissibility boundary, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "=", "2", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],
 ":"
}], "Text",ExpressionUUID->"5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"rG", ",", " ", "tanhResidual"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rG", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0.352", ",", " ", "0.", ",", " ", "0.176", ",", " ", "0.", ",", " ", 
     "0.", ",", " ", "0."}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tanhResidual", "[", "goal_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z0", " ", "=", " ", "0.6"}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tr", " ", "=", " ", 
          RowBox[{"oneTraj", "[", 
           RowBox[{"rG", ",", " ", 
            RowBox[{"{", 
             RowBox[{"0.", ",", " ", "0.", ",", " ", "z0", ",", " ", "0."}], 
             "}"}], ",", " ", "tfB", ",", " ", 
            RowBox[{"dtGenOf", "[", "rG", "]"}], ",", " ", "11", ",", " ", 
            RowBox[{
             RowBox[{"dtGenOf", "[", "rG", "]"}], "/", "4"}], ",", " ", 
            "goal"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{"s", " ", "=", " ", 
          RowBox[{"Subdivide", "[", 
           RowBox[{"0.", ",", " ", "tfB", ",", " ", "1000"}], "]"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"tr", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "[", "s", "]"}], " ", "-", " ", 
          RowBox[{"Tanh", "[", 
           RowBox[{
            RowBox[{"ArcTanh", "[", "z0", "]"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{"rG", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", 
             RowBox[{
              RowBox[{"tr", "[", 
               RowBox[{"[", "4", "]"}], "]"}], "[", "s", "]"}]}]}], "]"}]}], 
         "]"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"tanhResidual", "[", "Automatic", "]"}]}], "Input",
 CellLabel->"In[69]:=",ExpressionUUID->"66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],

Cell[BoxData["1.1700755728205614`*^-6"], "Output",
 CellChangeTimes->{3.995715103129899*^9},
 CellLabel->"Out[72]=",ExpressionUUID->"ed10e2b2-c57a-48d0-ae50-59ccdf80b0a3"]
}, Open  ]],

Cell["\<\
Tighten the goals and the violation must follow the solver, not the noise \
grid:\
\>", "Text",ExpressionUUID->"3e73fafe-05d0-7203-6600-f3b8ac654169"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tanhResidual", "[", "10", "]"}]], "Input",
 CellLabel->"In[73]:=",ExpressionUUID->"7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],

Cell[BoxData["4.519738538988349`*^-8"], "Output",
 CellChangeTimes->{3.9957151031952868`*^9},
 CellLabel->"Out[73]=",ExpressionUUID->"38cfe751-5329-435a-8d7a-db7ebb8d07e1"]
}, Open  ]],

Cell[TextData[{
 "It falls with the tolerance. For each regularized path, the ordinary chain \
rule makes the identity exact independently of the white-noise limit. In this \
regime the monitored coordinate ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c044c4-b778-74e1-42f0-5da1c20d5ecb"],
 " is the record read through a ",
 Cell[BoxData[
  StyleBox["tanh",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d9aa029-60a8-273a-6bb9-3a7311428a00"],
 "."
}], "Text",ExpressionUUID->"64adc082-4122-deff-0c52-d9ec70d4a4c5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The two time steps: which one sets the answer", "Section",ExpressionUUID->"7e451771-8a55-ceec-267a-8f3b2fe19436"],

Cell[TextData[{
 "The simulation uses two distinct time increments: the noise-grid spacing ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4670f053-f537-0b3f-6e0f-ea1cfcc25605"],
 " and ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "330aabc0-bdd5-22a3-6109-42aa34607089"],
 "'s maximum integration step. Which one controls the numerical result? Test \
the integration step first by holding the noise grid, the noise realizations, \
and the solver goals fixed, then comparing the final-",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],
 " mean and spread for two step caps: ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d705b8-410a-1477-20ec-9ce270bf7f5d"],
 " and ",
 Cell[BoxData[
  RowBox[{"10", "\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["gen",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "737c509e-bc52-eefb-2104-49d835e4b4c1"],
 ". The first row uses the stored ensemble; the second recomputes the same \
trajectories with the relaxed step cap:"
}], "Text",ExpressionUUID->"01a44b6b-c85f-9e0e-375c-6334e9ebe554"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableForm", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Mean", "[", "#", "]"}], "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"StandardDeviation", "[", "#", "]"}], "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], "}"}], " ", "&"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"regRunB", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", 
          RowBox[{"1", " ", ";;", " ", "3"}]}], "]"}], "]"}], ",", "\n", 
       "   ", 
       RowBox[{"ensemble", "[", 
        RowBox[{"ratesB", ",", " ", "initB", ",", " ", "tfB", ",", " ", 
         RowBox[{"dtGenOf", "[", "ratesB", "]"}], ",", " ", "nB", ",", " ", 
         "9100", ",", " ", 
         RowBox[{"10", " ", 
          RowBox[{"dtGenOf", "[", "ratesB", "]"}]}], ",", " ", "5"}], "]"}]}],
       "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<step \!\(\*SubscriptBox[\(\[CapitalDelta]t\), \
\(gen\)]\)/4\>\"", ",", "\n", 
        "    ", "\"\<step 10 \!\(\*SubscriptBox[\(\[CapitalDelta]t\), \
\(gen\)]\)\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<mean z\>\"", ",", " ", "\"\<spread z\>\""}], "}"}]}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[74]:=",ExpressionUUID->"10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],

