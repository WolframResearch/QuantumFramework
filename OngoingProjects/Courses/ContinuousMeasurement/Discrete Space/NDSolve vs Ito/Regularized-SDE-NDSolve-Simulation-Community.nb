Cell[TextData[{
 "The realized noise spacing ",
 Cell[BoxData[
  StyleBox["h", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6405505f-4b92-3bd6-0c3b-4a196e24893c"],
 " selects the regularized random ODE and controls its bias relative to the \
white-noise limit. ",
 Cell[BoxData["MaxStepSize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6878c7f8-419e-9db5-1807-dea27028e79f"],
 " controls only the numerical integration of that fixed ODE. Capping it \
below ",
 Cell[BoxData[
  StyleBox["h", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48a3d607-c312-9dd3-7850-c860f6a4e739"],
 " makes ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539491e8-328f-8d7b-01ab-08b2473bd441"],
 " resolve each interpolation interval, but neither the cap nor the rate \
heuristic establishes convergence by itself."
}], "Text",ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell[TextData[{
 "Assemble one trajectory. Build the piecewise-smooth forcing, form the \
random ODE ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    OverscriptBox[
     StyleBox["v", "TI"], "\[RightVector]"], "."], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "\[RightVector]"], 
    StyleBox["Strat",
     FontSlant->"Plain"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["b", "TI"], "\[RightVector]"], 
    StyleBox["Strat",
     FontSlant->"Plain"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["v", "TI"], "\[RightVector]"], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubsuperscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["h", "TI"], "\[Prime]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023f49e2-a747-9723-33c5-60cfd2f3fa09"],
 " for the full four-vector, and hand it to ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21aa1c49-e16c-f406-57a9-9612901edf6c"],
 ". If no cap is supplied, use one quarter of the realized noise-grid spacing:"
}], "Text",ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "oneTraj", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"oneTraj", "[", 
    RowBox[{
    "r_", ",", " ", "init_", ",", " ", "tf_", ",", " ", "dtGen_", ",", " ", 
     "seed_", ",", " ", 
     RowBox[{"maxstep_", " ", ":", " ", "Automatic"}], ",", " ", 
     RowBox[{"goal_", " ", ":", " ", "Automatic"}]}], "]"}], " ", ":=", "\n", 
   "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "Wf", ",", " ", "xx", ",", " ", "yy", ",", " ", "zz", ",", " ", "QQ", ",",
        " ", "t", ",", " ", "rhs", ",", " ", "eqs", ",", " ", "stepCap"}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Wf", " ", "=", " ", 
       RowBox[{"wienerFun", "[", 
        RowBox[{"tf", ",", " ", "dtGen", ",", " ", "seed"}], "]"}]}], ";", 
      "\n", "   ", 
      RowBox[{"stepCap", " ", "=", " ", 
       RowBox[{"Replace", "[", 
        RowBox[{"maxstep", ",", " ", 
         RowBox[{"Automatic", " ", "->", " ", 
          RowBox[{
           RowBox[{"noiseStep", "[", 
            RowBox[{"tf", ",", " ", "dtGen"}], "]"}], "/", "4"}]}]}], "]"}]}],
       ";", "\n", "   ", 
      RowBox[{"rhs", " ", "=", " ", 
       RowBox[{
        RowBox[{"driftStrat", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"xx", "[", "t", "]"}], ",", " ", 
            RowBox[{"yy", "[", "t", "]"}], ",", " ", 
            RowBox[{"zz", "[", "t", "]"}], ",", " ", 
            RowBox[{"QQ", "[", "t", "]"}]}], "}"}], ",", " ", "r"}], "]"}], 
        " ", "+", "\n", "     ", 
        RowBox[{
         RowBox[{"diffStrat", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"xx", "[", "t", "]"}], ",", " ", 
             RowBox[{"yy", "[", "t", "]"}], ",", " ", 
             RowBox[{"zz", "[", "t", "]"}], ",", " ", 
             RowBox[{"QQ", "[", "t", "]"}]}], "}"}], ",", " ", "r"}], "]"}], " ", 
         RowBox[{
          RowBox[{"Wf", "'"}], "[", "t", "]"}]}]}]}], ";", "\n", "   ", 
      RowBox[{"eqs", " ", "=", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#1", "'"}], "[", "t", "]"}], " ", "==", " ", "#2"}], 
            " ", "&"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"xx", ",", " ", "yy", ",", " ", "zz", ",", " ", "QQ"}], 
              "}"}], ",", " ", "rhs"}], "}"}]}], "]"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"xx", "[", "0", "]"}], " ", "==", " ", 
            RowBox[{"init", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"yy", "[", "0", "]"}], " ", "==", " ", 
            RowBox[{"init", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"zz", "[", "0", "]"}], " ", "==", " ", 
            RowBox[{"init", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"QQ", "[", "0", "]"}], " ", "==", " ", 
            RowBox[{"init", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], "]"}]}], ";", "\n", 
      "   ", 
      RowBox[{"NDSolveValue", "[", 
       RowBox[{"eqs", ",", " ", 
        RowBox[{"{", 
         RowBox[{"xx", ",", " ", "yy", ",", " ", "zz", ",", " ", "QQ"}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", ",", " ", "tf"}], "}"}], ",", " ", 
        RowBox[{"MaxStepSize", " ", "->", " ", "stepCap"}], ",", "\n", "    ", 
        RowBox[{"AccuracyGoal", " ", "->", " ", "goal"}], ",", " ", 
        RowBox[{"PrecisionGoal", " ", "->", " ", "goal"}]}], "]"}]}]}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"12f3dbee-abc4-6375-4280-d2cbce714e5f"],

Cell[TextData[{
 "Show one trajectory two ways: the monitored component ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
 " against the exact Lindblad mean, and the readout ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Q", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cfa2c34-ef50-7d46-5499-c6718ae547ac"],
 " it accumulates, both built from the single four-vector solution:"
}], "Text",ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"traj", " ", "=", " ", 
      RowBox[{"oneTraj", "[", 
