}, Open  ]],

Cell["Compare the full qutrit mean state with the master equation:", "Text",ExpressionUUID->"39b01e29-d171-5c92-6f4f-9072e00426f8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"qutritMaster", " ", "=", " ", 
   RowBox[{"masterEquationSolution", "[", 
    RowBox[{
    "initialState3", ",", " ", "hamiltonian3", ",", " ", "measured3", ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"time", ",", " ", "0", ",", " ", "finalTime3"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qutritCount", " ", "=", " ", "120"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qutritMean", " ", "=", " ", 
   RowBox[{"Mean", "@", 
    RowBox[{"BlockRandom", "[", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "9", "]"}], ";", "\n", "   ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"simulateTrajectory", "[", 
          RowBox[{
          "initialState3", ",", " ", "hamiltonian3", ",", " ", "measured3", ",",
            " ", "dt3", ",", " ", "finalTime3", ",", "\n", "      ", 
           RowBox[{"\"\<Efficiencies\>\"", " ", "->", " ", 
            RowBox[{"{", "0.4", "}"}]}]}], "]"}], "[", "\"\<States\>\"", 
         "]"}], ",", " ", 
        RowBox[{"{", "qutritCount", "}"}]}], "]"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"qutritTimes", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0.", ",", " ", "finalTime3", ",", " ", "dt3"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qutritMasterStates", " ", "=", " ", 
    RowBox[{"qutritMaster", " ", "/@", " ", "qutritTimes"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"Max", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{"#1", " ", "-", " ", "#2"}], ",", " ", "\"\<Frobenius\>\""}], 
     "]"}], " ", "&"}], " ", "@@@", "\n", "  ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"qutritMean", ",", " ", "qutritMasterStates"}], "}"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[43]:= ",ExpressionUUID->"4f6d713e-2461-11c8-7513-69784d146312"],

Cell[BoxData["0.05377167368194949`"], "Output",
 CellLabel->
  "Out[43]= ",ExpressionUUID->"14ad582f-66ff-93eb-3c53-5189128be131"]
}, Open  ]],

Cell["\<\
This tests the full density matrix, not only its populations.\
\>", "Text",ExpressionUUID->"4f7ea056-2d28-85ec-7505-3a1044c2ef36"],

Cell["Coverage by Case", "Subsection",ExpressionUUID->"16b00368-b832-202d-3e4f-9b3239c77377"],

Cell[BoxData[GridBox[{
   {Cell["Case", "TableText",
     FontWeight->Bold,ExpressionUUID->"06d00634-a672-f252-2eef-9871d304c0b8"],
     Cell["Evidence in this notebook", "TableText",
     FontWeight->Bold,ExpressionUUID->"05feeeaf-4f58-f7b7-3385-07096ad2dd9d"]},
   {Cell[TextData[{
     "One recorded ",
     Cell[BoxData[
      StyleBox["Z", "TI"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "583a98af-415b-100e-09d9-110970ee6354"],
     " channel"
    }], "TableText",ExpressionUUID->"07beae85-a317-6bf9-2d45-47eed6a239c3"], 
    Cell["\<\
One path is reconstructed from its record; the simulated mean is compared \
with the master equation.\
\>", "TableText",ExpressionUUID->"503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"]},
   {Cell[TextData[{
     "General driven ",
     Cell[BoxData[
      StyleBox["Z", "TI"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "60049622-f570-0e0e-103b-0f8ffc055554"],
     " model"
    }], "TableText",ExpressionUUID->"40ea559d-da93-7842-70ea-4cc6df264aa8"], 
    Cell["\<\
Symbolic calculation checks the equation, initial values, and \
strong-monitoring rate.\
\>", "TableText",ExpressionUUID->"23ccc6ee-92c0-e596-51f3-dfc8277acffc"]},
   {Cell["Finite weak and strong examples", "TableText",ExpressionUUID->
     "114d8d02-b276-9c05-4772-256fc700e76f"], Cell[TextData[{
     "The numerical master solver is compared with the exact ",
     Cell[BoxData[
      StyleBox["Z", "TI"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2dc22b63-32d1-862f-5bf1-c34d4765ed75"],
     " solution."
    }], "TableText",ExpressionUUID->"36ea7e2c-072a-2221-5eea-7076b2df710b"]},
   {Cell["No recorded channel and a short final step", "TableText",
     ExpressionUUID->"5b23761c-2477-64e8-0ad1-68464d024e32"], Cell["\<\
The boundary cell checks record shape, step sizes, and final time.\
\>", "TableText",ExpressionUUID->"73216bcf-7cf1-61ac-22de-82a9748433f6"]},
   {Cell["Two recorded channels plus one unmonitored channel", "TableText",
     ExpressionUUID->"69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"], Cell[
    "Positivity and the final mean state are checked.", "TableText",
     ExpressionUUID->"409bca18-cbd6-e54d-70b8-ec45ee60cf97"]},
   {Cell["Three-state system", "TableText",ExpressionUUID->
     "10b62b5f-1d3f-f012-404d-c31994cbc378"], Cell[
    "Positivity and the full mean density matrix are checked.", "TableText",
     ExpressionUUID->"79984792-c453-565a-2fb8-5edfede63ca0"]},
   {Cell["Invalid input", "TableText",ExpressionUUID->
     "1d45428e-8fa1-6801-4b7b-5be82a543b6b"], Cell[TextData[{
     "The code returns a named ",
     Cell[BoxData["Failure"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "604bb87d-3174-a116-1048-32274006f07c"],
     " before drawing random numbers."
    }], "TableText",ExpressionUUID->"763191a2-6f8b-197a-1fce-080c0a3e6840"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
  GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}},
  GridBoxItemSize->{"Columns" -> {
      Scaled[0.44], 
      Scaled[0.44]}, "Rows" -> {{Automatic}}},
  GridBoxSpacings->{"Columns" -> {{1.5}}, "Rows" -> {{0.8}}}]], "Text",Express\
ionUUID->"a08e1863-86eb-499d-b6a3-ba7d0a5ad8fa"],

Cell["Before closing, collect the verified distinctions:", "Text",ExpressionUUID->"635fdfdb-2856-deda-1164-d68549e0a420"],

Cell["An experimental current is observed data.", "Item",ExpressionUUID->"0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],

Cell["\<\
A state path computed from that current is inferred and model-dependent.\
\>", "Item",ExpressionUUID->"5c8469dd-bfc7-2a7a-04bb-80873a727940"],

Cell[TextData[{
 "A state path and current generated by ",
 Cell[BoxData["simulateTrajectory"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],
 " are synthetic."
}], "Item",ExpressionUUID->"3921e4bb-f5e4-3596-68de-fde483969ffc"],

Cell["\<\
Record statistics can expose a mean, delayed correlations, and spectral peaks.\
\>", "Item",ExpressionUUID->"13db9173-5387-1c16-41f8-093d6632677c"],

Cell["\<\
A simulation can reveal model behavior and test code, but it cannot validate \
a device.\
\>", "Item",ExpressionUUID->"6804c0ab-fd16-b7db-183b-d9f4f4a01d21"],

Cell["\<\
Positivity does not remove time-step error; convergence still must be checked.\
\>", "Item",ExpressionUUID->"77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],

Cell["\<\
In the continuous-time equation, monitoring every loss or noise channel at \
unit efficiency guarantees preserved purity for a pure initial state.\
\>", "Item",ExpressionUUID->"4289b0c6-8043-1b93-72b6-29a031f669f9"],

Cell["\<\
Agreement of the simulated mean with the master equation checks the \
implementation in two and three dimensions.\
\>", "Item",ExpressionUUID->"070f3e08-556d-9d60-2d34-b0525c19e44a"],

Cell["Where This Leaves Us", "Subsection",ExpressionUUID->"6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],

Cell["\<\
The notebook now has separate tools for inference and simulation. That \
separation fixes the status of every plot: detector statistics are observable \
when the input is experimental, state quantities computed from a record are \
inferred, and every detector record generated here is synthetic. No plot \
contains experimental data. The next step for an experiment is to replace the \
synthetic readout with calibrated detector increments and reserve part of the \
data for an independent test.\
\>", "Text",ExpressionUUID->"4140e475-1e41-1f16-777f-fe3f9bf4627c"],

Cell["Acknowledgment", "Subsection",ExpressionUUID->"67f13035-938c-831a-0d8e-aa7f263eee60"],

Cell[TextData[{
 "The state update follows the positivity-preserving scheme of Rouchon and \
Ralph. The examples use standard models of monitored ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b44e14-0404-e868-3e4c-605eadb6bab2"],
 " noise and emitted-light detection."
}], "Text",ExpressionUUID->"70bc3c38-1a7f-2cd8-2043-b6629f0a7622"]
},
