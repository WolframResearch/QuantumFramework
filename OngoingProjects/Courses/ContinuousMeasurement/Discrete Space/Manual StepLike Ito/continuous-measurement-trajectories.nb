Cell["Check the master-equation solver against the exact result:", "Text",ExpressionUUID->"73b76025-96bb-3fff-214d-798f234f85c5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"strongMaster", " ", "=", " ", 
   RowBox[{"masterEquationSolution", "[", 
    RowBox[{
     RowBox[{"densityMatrix", "[", "ket0", "]"}], ",", " ", 
     RowBox[{"omegaD", " ", "X"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "gammaStrong", "]"}], " ", "Z"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"time", ",", " ", "0", ",", " ", "finalTimeD"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"weakMaster", " ", "=", " ", 
    RowBox[{"masterEquationSolution", "[", 
     RowBox[{
      RowBox[{"densityMatrix", "[", "ket0", "]"}], ",", " ", 
      RowBox[{"omegaD", " ", "X"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sqrt", "[", "gammaWeak", "]"}], " ", "Z"}], "}"}], ",", " ", 
      
      RowBox[{"{", 
       RowBox[{"time", ",", " ", "0", ",", " ", "finalTimeD"}], "}"}]}], 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<strong-rate error\>\"", " ", "->", "\n", "   ", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"blochVector", "[", 
            RowBox[{"strongMaster", "[", "#", "]"}], "]"}], "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         "timeGridD"}], ")"}], " ", "-", "\n", "      ", 
       RowBox[{"zDephasing", "[", 
        RowBox[{"timeGridD", ",", " ", "omegaD", ",", " ", "gammaStrong"}], 
        "]"}]}], "]"}], "]"}]}], ",", "\n", " ", 
   RowBox[{"\"\<weak-rate error\>\"", " ", "->", "\n", "   ", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"blochVector", "[", 
            RowBox[{"weakMaster", "[", "#", "]"}], "]"}], "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         "timeGridD"}], ")"}], " ", "-", "\n", "      ", 
       RowBox[{"zDephasing", "[", 
        RowBox[{"timeGridD", ",", " ", "omegaD", ",", " ", "gammaWeak"}], 
        "]"}]}], "]"}], "]"}]}]}], "|>"}]}], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"strong-rate error\"\>", "\[Rule]", "6.688186759973291`*^-8"}],
    ",", 
   RowBox[{"\<\"weak-rate error\"\>", "\[Rule]", 
    "1.9301656057901795`*^-6"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[24]= ",ExpressionUUID->"72ff7667-e560-b2c0-2285-68408c1a002a"]
}, Open  ]],

Cell["\<\
One synthetic path in each regime gives intuition about individual records:\
\>", "Text",ExpressionUUID->"7c9be80e-0554-61c1-24b8-0268ace1332b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"strongSimulation", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "7", "]"}], ";", "\n", "  ", 
     RowBox[{"simulateTrajectory", "[", 
      RowBox[{
       RowBox[{"densityMatrix", "[", "ket0", "]"}], ",", " ", 
       RowBox[{"omegaD", " ", "X"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "gammaStrong", "]"}], " ", "Z"}], "}"}], ",", 
       " ", "dtD", ",", " ", "finalTimeD"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"weakSimulation", " ", "=", " ", 
    RowBox[{"BlockRandom", "[", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "7", "]"}], ";", "\n", "  ", 
      RowBox[{"simulateTrajectory", "[", 
       RowBox[{
        RowBox[{"densityMatrix", "[", "ket0", "]"}], ",", " ", 
        RowBox[{"omegaD", " ", "X"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sqrt", "[", "gammaWeak", "]"}], " ", "Z"}], "}"}], ",", 
        " ", "dtD", ",", " ", "finalTimeD"}], "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"strongSimulation", "[", "\"\<Times\>\"", "]"}], ",", "\n", 
        "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"blochVector", "[", "#", "]"}], "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"strongSimulation", "[", "\"\<States\>\"", "]"}]}]}], "}"}], 
      "]"}], ",", "\n", "  ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"weakSimulation", "[", "\"\<Times\>\"", "]"}], ",", "\n", 
        "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"blochVector", "[", "#", "]"}], "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"weakSimulation", "[", "\"\<States\>\"", "]"}]}]}], "}"}], 
      "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"ColorData", "[", 
       RowBox[{"97", ",", " ", "2"}], "]"}]}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<strong monitoring: one simulation\>\"", ",", 
      " ", "\"\<weak monitoring: one simulation\>\""}], "}"}]}], ",", "\n", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<inferred <Z>\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "540"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}]}], "]"}]}], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"106b7ad8-6378-599b-4069-7382160d2be1"],

