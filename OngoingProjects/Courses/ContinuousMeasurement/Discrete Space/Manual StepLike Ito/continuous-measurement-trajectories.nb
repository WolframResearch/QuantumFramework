    GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
    AutoDelete -> False, GridBoxItemSize -> Automatic, 
    BaselinePosition -> {1, 1}]& ),
  Editable->True,
  InterpretationFunction->(RowBox[{"Legended", "[", 
     RowBox[{#, ",", 
       RowBox[{"Placed", "[", 
         RowBox[{#2, ",", "After"}], "]"}]}], "]"}]& )]], "Output",
 CellLabel->
  "Out[25]= ",ExpressionUUID->"7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"]
}, Open  ]],

Cell[TextData[{
 "The strong case stays near a ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "304452a4-201b-d64c-607c-4b0e51afbc96"],
 " eigenstate for long intervals. The weak case follows the drive more \
freely. These paths illustrate the model. Only a detector record from an \
experiment could support a claim about a real device."
}], "Text",ExpressionUUID->"6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],

Cell["Part V: Monitored Spontaneous Emission", "Section",ExpressionUUID->"4b5b9263-9199-4e16-7978-144d202c157c"],

Cell[TextData[{
 "Now monitor emission through ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], "-"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "475d7054-346c-a3cc-6d63-6a1ebd1ef116"],
 ". In homodyne detection, the instrument records one real component of the \
emitted field. With a complete unit-efficiency record and a pure initial \
state, the inferred state remains pure."
}], "Text",ExpressionUUID->"2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"omegaS", " ", "=", " ", "2.0"}], ";", " ", 
  RowBox[{"detuningS", " ", "=", " ", "1.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hamiltonianS", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"omegaS", " ", "X"}], " ", "+", " ", 
      RowBox[{"detuningS", " ", "Z"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gammaS", " ", "=", " ", "0.2"}], ";", " ", 
  RowBox[{"measuredS", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sqrt", "[", "gammaS", "]"}], " ", "jMinus"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"initialStateS", " ", "=", " ", 
   RowBox[{"densityMatrix", "[", "ketPlus", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dtS", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"finalTimeS", " ", "=", " ", "10.0"}], ";"}]}], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"3343f580-98d5-e31c-6170-ecea1961ce66"],

Cell["Generate five synthetic paths:", "Text",ExpressionUUID->"20a7420b-376a-b23f-505d-6455421c0105"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"emissionSimulations", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "3", "]"}], ";", "\n", "  ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"simulateTrajectory", "[", 
        RowBox[{
        "initialStateS", ",", " ", "hamiltonianS", ",", " ", "measuredS", ",",
          " ", "dtS", ",", "\n", "    ", "finalTimeS"}], "]"}], ",", " ", 
       RowBox[{"{", "5", "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"emissionBlochPaths", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"blochVector", " ", "/@", " ", 
       RowBox[{"#", "[", "\"\<States\>\"", "]"}]}], ")"}], " ", "&"}], " ", "/@",
     " ", "emissionSimulations"}]}], ";"}]}], "Input",
 CellLabel->
  "In[27]:= ",ExpressionUUID->"6af863a9-1098-c609-1a98-7af3a112ad53"],

Cell["Draw a simple Bloch sphere and overlay the paths:", "Text",ExpressionUUID->"055bc2ad-6b92-a3be-3378-dbf70e24f184"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"blochSphere", " ", "=", " ", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{
      RowBox[{"{", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Opacity", "[", "0.12", "]"}], ",", " ", "LightBlue", ",", 
          " ", 
          RowBox[{"Sphere", "[", "]"}]}], "}"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"Gray", ",", " ", 
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1.1"}], ",", " ", "0", ",", " ", "0"}], "}"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"1.1", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], 
           "]"}], ",", "\n", "     ", 
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", " ", 
               RowBox[{"-", "1.1"}], ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "1.1", ",", " ", "0"}], "}"}]}], "}"}], 
           "]"}], ",", "\n", "     ", 
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0", ",", " ", 
               RowBox[{"-", "1.1"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0", ",", " ", "1.1"}], "}"}]}], "}"}], 
           "]"}]}], "}"}]}], "}"}], ",", "\n", "   ", 
      RowBox[{"Boxed", " ", "->", " ", "False"}], ",", " ", 
      RowBox[{"PlotRange", " ", "->", " ", "1.15"}], ",", " ", 
      RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{"blochSphere", ",", "\n", " ", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", "\n", "   ", 
      RowBox[{"MapIndexed", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ColorData", "[", 
            RowBox[{"97", ",", " ", 
             RowBox[{"First", "@", "#2"}]}], "]"}], ",", " ", 
           RowBox[{"Line", "@", "#1"}]}], "}"}], " ", "&"}], ",", " ", 
        "emissionBlochPaths"}], "]"}]}], "}"}], "]"}]}], "]"}]}], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"2b0fb60e-2211-365f-5934-286857a59ca5"],

