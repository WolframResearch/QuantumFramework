Cell["\<\
Each curve is a possible inferred state path for a possible synthetic record. \
The plot shows model behavior, not observed motion.\
\>", "Text",ExpressionUUID->"7085d256-6adc-aa08-20ba-d4100f6ef952"],

Cell["\<\
Check the mean of many simulations against the master equation:\
\>", "Text",ExpressionUUID->"5f932952-49a5-d34f-05a0-c11c6851a195"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"emissionTimeGrid", " ", "=", " ", 
   RowBox[{
    RowBox[{"emissionSimulations", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<Times\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"emissionMaster", " ", "=", " ", 
   RowBox[{"masterEquationSolution", "[", 
    RowBox[{
    "initialStateS", ",", " ", "hamiltonianS", ",", " ", "measuredS", ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"time", ",", " ", "0", ",", " ", "finalTimeS"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"emissionMasterStates", " ", "=", " ", 
   RowBox[{"emissionMaster", " ", "/@", " ", "emissionTimeGrid"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"emissionStateSets", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "11", "]"}], ";", "\n", "  ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"simulateTrajectory", "[", 
         RowBox[{
         "initialStateS", ",", " ", "hamiltonianS", ",", " ", "measuredS", ",",
           " ", "dtS", ",", "\n", "    ", "finalTimeS"}], "]"}], 
        "[", "\"\<States\>\"", "]"}], ",", " ", 
       RowBox[{"{", "150", "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"emissionMeanStates", " ", "=", " ", 
    RowBox[{"Mean", "[", "emissionStateSets", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"Max", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{"#1", " ", "-", " ", "#2"}], ",", " ", "\"\<Frobenius\>\""}], 
     "]"}], " ", "&"}], " ", "@@@", "\n", "  ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"emissionMeanStates", ",", " ", "emissionMasterStates"}], "}"}], 
    "]"}]}], "]"}]}], "Input",
 CellLabel->
  "In[29]:= ",ExpressionUUID->"160f17c4-d31a-fe19-3e34-8ea1e6acc563"],

Cell[BoxData["0.08882473794104732`"], "Output",
 CellLabel->
  "Out[29]= ",ExpressionUUID->"10beb8bd-bdb6-ee93-4045-31e73440b4f9"]
}, Open  ]],

Cell[TextData[{
 "This extends the numerical mean-state check from ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fdc991b-fead-14b0-65e3-1144fb587e9a"],
 " monitoring to emission. It still tests the implementation, not a \
laboratory system."
}], "Text",ExpressionUUID->"3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],

Cell["Part VI: What a Detector Record Can Show", "Section",ExpressionUUID->"0642d375-09f3-9942-2e71-cb3faf87eba8"],

Cell["\<\
An experimental detector directly supplies a current. From that record we can \
compute its mean, how readings separated in time vary together, and how power \
is spread across frequency. The standard names for the last two quantities \
are autocovariance and power spectrum.\
\>", "Text",ExpressionUUID->"0651775d-2bad-791b-2e6f-6f074e584861"],

Cell["\<\
The record below is synthetic. The analysis is the same analysis one can \
apply to calibrated experimental data, but its result is only a prediction of \
the chosen model.\
\>", "Text",ExpressionUUID->"63b9e3d6-2298-231e-1146-fa9057128e64"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"omegaC", " ", "=", " ", "3.5"}], ";", " ", 
  RowBox[{"gammaC", " ", "=", " ", "0.7"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hamiltonianC", " ", "=", " ", 
   RowBox[{"omegaC", " ", 
    RowBox[{"Y", "/", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"measuredC", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sqrt", "[", "gammaC", "]"}], " ", "jMinus"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dtC", " ", "=", " ", "0.01"}], ";", " ", 
   RowBox[{"finalTimeC", " ", "=", " ", "1200.0"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"longSimulation", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\n", "  ", 
     RowBox[{"simulateTrajectory", "[", 
      RowBox[{
       RowBox[{"densityMatrix", "[", "ket0", "]"}], ",", " ", "hamiltonianC", 
       ",", " ", "measuredC", ",", " ", "dtC", ",", "\n", "    ", 
       "finalTimeC"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simulatedCurrent", " ", "=", " ", 
   RowBox[{"Re", "@", 
    RowBox[{
     RowBox[{"longSimulation", "[", "\"\<Current\>\"", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[30]:= ",ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"],

Cell["Check the current's sample mean and standard deviation:", "Text",ExpressionUUID->"4c440104-ea8a-4285-747b-99618f3f10ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "simulatedCurrent", "]"}], ",", " ", 
   RowBox[{"Mean", "[", "simulatedCurrent", "]"}], ",", "\n", " ", 
   RowBox[{"StandardDeviation", "[", "simulatedCurrent", "]"}], ",", " ", 
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", "dtC", "]"}]}]}], "}"}]], "Input",
 CellLabel->
  "In[31]:= ",ExpressionUUID->"66c9a615-af45-c085-0ef6-385ecaf192ef"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"120000", ",", 
   RowBox[{"-", "0.15668163095488444`"}], ",", "10.003033914908336`", ",", 
   "10.`"}], "}"}]], "Output",
 CellLabel->
  "Out[31]= ",ExpressionUUID->"0513e607-0f4c-1e20-3320-f861aaf9650a"]
}, Open  ]],

Cell[TextData[{
 "The white-noise part of the current has standard deviation ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox[
     RowBox[{"d", "t"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0371ff35-cd30-cda2-310e-f77ee4ca9788"],
 ". A single sample is therefore noisy. Correlations across time can reveal \
repeated motion."
}], "Text",ExpressionUUID->"6833ae6a-6ac5-a2c8-19c0-40340f71f012"],

Cell["\<\
The autocovariance measures how readings separated by a chosen delay vary \
together. Compute it with a fast Fourier transform. Each delay is divided by \
its own number of data pairs:\
\>", "Text",ExpressionUUID->"5f7f2999-1aee-25a5-0504-c0c39e988f8f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "autocovariance", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"autocovariance", "[", 
    RowBox[{
    "data_", ",", " ", "maximumLag_Integer", ",", " ", "dt_", ",", " ", 
     RowBox[{"stride_Integer", " ", ":", " ", "1"}]}], "]"}], " ", ":=", " ", 
   
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"centered", ",", " ", 
       RowBox[{"count", " ", "=", " ", 
        RowBox[{"Length", "[", "data", "]"}]}], ",", " ", "paddedLength", ",",
        "\n", "   ", "sums", ",", " ", "lags"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"VectorQ", "[", 
           RowBox[{"data", ",", " ", "realNumberQ"}], "]"}]}], " ", "||", " ", 
         RowBox[{
          RowBox[{"Length", "[", "data", "]"}], " ", "<", " ", "2"}], " ", "||",
          " ", 
         RowBox[{"maximumLag", " ", "<", " ", "0"}], " ", "||", "\n", "    ", 
         
         RowBox[{"!", 
          RowBox[{"realNumberQ", "[", "dt", "]"}]}], " ", "||", " ", 
         RowBox[{"dt", " ", "<=", " ", "0"}], " ", "||", " ", 
         RowBox[{"stride", " ", "<=", " ", "0"}]}], ",", "\n", "   ", 
        RowBox[{"Return", "@", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidData\>\"", ",", "\n", "     ", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<MessageTemplate\>\"", " ", "->", 
             " ", "\"\<Use a numerical record, a nonnegative maximum lag, a \
positive step, and a positive stride.\>\""}], "|>"}]}], "]"}]}]}], "]"}], ";",
       "\n", "  ", 
      RowBox[{"centered", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"data", " ", "-", " ", 
         RowBox[{"Mean", "[", "data", "]"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"lags", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"Min", "[", 
          RowBox[{"maximumLag", ",", " ", 
           RowBox[{"count", " ", "-", " ", "1"}]}], "]"}], ",", " ", 
         "stride"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"paddedLength", " ", "=", " ", 
       RowBox[{"2", "^", 
        RowBox[{"Ceiling", "[", 
         RowBox[{"Log", "[", 
          RowBox[{"2", ",", " ", 
           RowBox[{
            RowBox[{"2", " ", "count"}], " ", "-", " ", "1"}]}], "]"}], 
         "]"}]}]}], ";", "\n", "  ", 
      RowBox[{"sums", " ", "=", " ", 
       RowBox[{"Re", "@", 
        RowBox[{"InverseFourier", "[", "\n", "     ", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"Fourier", "[", 
             RowBox[{
              RowBox[{"PadRight", "[", 
               RowBox[{"centered", ",", " ", "paddedLength"}], "]"}], ",", 
              "\n", "        ", 
              RowBox[{"FourierParameters", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"1", ",", " ", 
                 RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], "]"}], "^", "2"}], ",",
           "\n", "     ", 
          RowBox[{"FourierParameters", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", 
             RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}]}], ";", "\n", "  ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dt", " ", "lags"}], ",", " ", 
         RowBox[{
          RowBox[{"sums", "[", 
           RowBox[{"[", 
            RowBox[{"lags", " ", "+", " ", "1"}], "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"count", " ", "-", " ", "lags"}], ")"}]}]}], "}"}], 
       "]"}]}]}], "\n", "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[32]:= ",ExpressionUUID->"128c7526-c883-085d-42b4-6c83e9365aa7"],

Cell["\<\
Skip the zero-lag point in the plot because it contains the large white-noise \
variance:\
\>", "Text",ExpressionUUID->"3279c00f-c9e2-8758-6206-da68ef94eda2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"currentCovariance", " ", "=", " ", 
    RowBox[{"Rest", "@", 
     RowBox[{"autocovariance", "[", 
      RowBox[{"simulatedCurrent", ",", " ", 
       RowBox[{"Floor", "[", 
        RowBox[{"8", "/", "dtC"}], "]"}], ",", " ", "dtC", ",", " ", "4"}], 
      "]"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"currentCovariance", ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "540"}], ",", "\n", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<lag\>\"", ",", " ", "\"\<current autocovariance\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<A synthetic current retains the driven oscillation\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[33]:= ",ExpressionUUID->"50b12ff8-e606-85f7-004e-c6a593b0efdd"],

