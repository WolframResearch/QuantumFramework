Cell["\<\
For ideal white noise, the expected covariance is zero at every nonzero lag. \
A finite record still has random scatter there. The same noise also changes \
the future state, so it is incorrect to say that shot noise contributes \
nothing away from zero lag.\
\>", "Text",ExpressionUUID->"63a48922-0fac-666c-115b-208caa594cb6"],

Cell["\<\
The power spectrum shows signal strength against frequency. To reduce random \
scatter, divide the record into separate segments, subtract each segment's \
mean, and average the resulting estimates:\
\>", "Text",ExpressionUUID->"387a9e0d-0234-0e73-6819-1057b7c15559"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "averagedPeriodogram", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"averagedPeriodogram", "[", 
    RowBox[{"data_", ",", " ", "dt_", ",", " ", "segmentLength_Integer"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "segments", ",", " ", "twoSided", ",", " ", "meanSpectrum", ",", " ", 
       "indices", ",", " ", "frequencies"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"VectorQ", "[", 
           RowBox[{"data", ",", " ", "realNumberQ"}], "]"}]}], " ", "||", " ", 
         RowBox[{"!", 
          RowBox[{"realNumberQ", "[", "dt", "]"}]}], " ", "||", " ", 
         RowBox[{"dt", " ", "<=", " ", "0"}], " ", "||", "\n", "    ", 
         RowBox[{"segmentLength", " ", "<", " ", "3"}], " ", "||", " ", 
         RowBox[{"segmentLength", " ", ">", " ", 
          RowBox[{"Length", "[", "data", "]"}]}]}], ",", "\n", "   ", 
        RowBox[{"Return", "@", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidData\>\"", ",", "\n", "     ", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<MessageTemplate\>\"", " ", "->", 
             " ", "\"\<Use a numerical record, a positive step, and a segment \
length between 3 and the record length.\>\""}], "|>"}]}], "]"}]}]}], "]"}], ";",
       "\n", "  ", 
      RowBox[{"segments", " ", "=", " ", 
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"N", "[", "data", "]"}], ",", " ", "segmentLength", ",", " ",
          "segmentLength"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"twoSided", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"dt", "/", "segmentLength"}], ")"}], " ", 
          RowBox[{
           RowBox[{"Abs", "[", "\n", "        ", 
            RowBox[{"Fourier", "[", 
             RowBox[{
              RowBox[{"#", " ", "-", " ", 
               RowBox[{"Mean", "[", "#", "]"}]}], ",", " ", 
              RowBox[{"FourierParameters", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"1", ",", " ", 
                 RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], "]"}], "^", "2"}]}], 
         " ", "&"}], " ", "/@", " ", "segments"}]}], ";", "\n", "  ", 
      RowBox[{"meanSpectrum", " ", "=", " ", 
       RowBox[{"Mean", "[", "twoSided", "]"}]}], ";", "\n", "  ", 
      RowBox[{"indices", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"2", ",", " ", 
         RowBox[{"Ceiling", "[", 
          RowBox[{"segmentLength", "/", "2"}], "]"}]}], "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{"frequencies", " ", "=", " ", 
       RowBox[{"2", " ", "Pi", " ", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"1", ",", " ", 
           RowBox[{"Length", "[", "indices", "]"}]}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"segmentLength", " ", "dt"}], ")"}]}]}]}], ";", "\n", "  ", 
      
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"frequencies", ",", " ", 
         RowBox[{"2", " ", 
          RowBox[{"meanSpectrum", "[", 
           RowBox[{"[", "indices", "]"}], "]"}]}]}], "}"}], "]"}]}]}], "\n", 
    "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[34]:= ",ExpressionUUID->"3f64ca0d-9927-5f44-651b-ec5718d225ae"],

Cell[TextData[{
 "Compute the spectrum of the current, not the increments. Under this \
one-sided convention, ideal unit white noise has a flat level of ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "399d1ff3-4632-be92-6fa2-96bd73c404f8"],
 ":"
}], "Text",ExpressionUUID->"1170384d-2f38-2c50-470f-b2174acd76ba"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"spectrum", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"averagedPeriodogram", "[", 
      RowBox[{"simulatedCurrent", ",", " ", "dtC", ",", " ", "4096"}], "]"}], 
     ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"First", "[", "#", "]"}], " ", "<=", " ", "8"}], " ", "&"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"oscillationFrequency", " ", "=", " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"omegaC", "^", "2"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"gammaC", "^", "2"}], "/", "16"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"spectrum", ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "540"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "oscillationFrequency", "}"}], ",", " ", 
      RowBox[{"{", "2", "}"}]}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<angular frequency\>\"", ",", 
      " ", "\"\<one-sided power spectrum\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<Synthetic homodyne spectrum: a peak above the white-noise level\
\>\""}]}], "]"}]}], "Input",
 CellLabel->
  "In[35]:= ",ExpressionUUID->"6ce33075-6d34-44a7-1490-aa3f04c12e8d"],

