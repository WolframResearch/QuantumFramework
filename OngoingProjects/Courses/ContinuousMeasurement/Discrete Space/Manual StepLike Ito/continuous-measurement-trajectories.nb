 RowBox[{
  RowBox[{"MaximalBy", "[", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{"spectrum", ",", " ", 
      RowBox[{
       RowBox[{"2", " ", "<=", " ", 
        RowBox[{"First", "[", "#", "]"}], " ", "<=", " ", "5"}], " ", "&"}]}],
