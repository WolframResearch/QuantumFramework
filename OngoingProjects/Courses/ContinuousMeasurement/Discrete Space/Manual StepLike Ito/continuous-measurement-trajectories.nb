Cell["\<\
Check time-step convergence without random scatter by setting the efficiency \
to zero. The channel still acts, but every run gives the same state:\
\>", "Text",ExpressionUUID->"0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"timeStepValues", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.08", ",", " ", "0.04", ",", " ", "0.02", ",", " ", "0.01"}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{"timeStepErrors", " ", "=", " ", 
  RowBox[{"AssociationThread", "[", 
   RowBox[{"timeStepValues", ",", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", "[", 
          RowBox[{
           RowBox[{"simulateTrajectory", "[", 
            RowBox[{
            "initialState", ",", " ", "hamiltonian", ",", " ", 
             "measuredOperators", ",", " ", "#", ",", "\n", "        ", 
             "finalTime", ",", " ", 
             RowBox[{"\"\<Efficiencies\>\"", " ", "->", " ", 
              RowBox[{"{", "0.0", "}"}]}]}], "]"}], "[", "\"\<States\>\"", 
           "]"}], "]"}], " ", "-", "\n", "      ", 
         RowBox[{"masterSolution", "[", "finalTime", "]"}]}], ",", 
        " ", "\"\<Frobenius\>\""}], "]"}], " ", "&"}], " ", "/@", " ", 
     "timeStepValues"}]}], "]"}]}]}], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"0.08`", "\[Rule]", "0.0032995248784169033`"}], ",", 
   RowBox[{"0.04`", "\[Rule]", "0.0017962933111270046`"}], ",", 
   RowBox[{"0.02`", "\[Rule]", "0.0009362929322241937`"}], ",", 
   RowBox[{"0.01`", "\[Rule]", "0.0004778935719250497`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[16]= ",ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"]
}, Open  ]],

Cell["\<\
The error decreases as the step is halved. Positivity alone would not show \
this accuracy check.\
\>", "Text",ExpressionUUID->"1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],

Cell["Now average 150 independent simulations:", "Text",ExpressionUUID->"370294fd-9e49-2d35-5d31-0da71bfc741f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"simulationCount", " ", "=", " ", "150"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simulatedStateSets", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "42", "]"}], ";", "\n", "  ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"simulateTrajectory", "[", 
         RowBox[{
         "initialState", ",", " ", "hamiltonian", ",", " ", 
          "measuredOperators", ",", " ", "dt", ",", "\n", "     ", 
          "finalTime"}], "]"}], "[", "\"\<States\>\"", "]"}], ",", " ", 
       RowBox[{"{", "simulationCount", "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"meanStates", " ", "=", " ", 
   RowBox[{"Mean", "[", "simulatedStateSets", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

Cell["\<\
Compare the full mean density matrix with the master-equation solution at \
every time:\
\>", "Text",ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{"#1", " ", "-", " ", "#2"}], ",", " ", "\"\<Frobenius\>\""}], 
     "]"}], " ", "&"}], " ", "@@@", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"meanStates", ",", " ", "masterStates"}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell[BoxData["0.08034279177657991`"], "Output",
 CellLabel->
  "Out[18]= ",ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"]
}, Open  ]],

