Cell["Part III: One Synthetic Path and the Mean over Many Paths", "Section",ExpressionUUID->"4f8ab258-7e7f-0723-7589-34027b0a6a09"],

Cell[TextData[{
 "Use a driven qubit whose ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b12ee74-9953-131d-1921-003e18e67e67"],
 " component is monitored. This section checks code. It does not analyze \
experimental data."
}], "Text",ExpressionUUID->"65262d3c-fccc-1dc6-0cdd-c579f579672c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"omega", " ", "=", " ", "1.0"}], ";", " ", 
  RowBox[{"gamma", " ", "=", " ", "0.4"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hamiltonian", " ", "=", " ", 
   RowBox[{"omega", " ", "X"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"measuredOperators", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sqrt", "[", "gamma", "]"}], " ", "Z"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"initialState", " ", "=", " ", 
   RowBox[{"densityMatrix", "[", "ket0", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dt", " ", "=", " ", "0.005"}], ";", " ", 
  RowBox[{"finalTime", " ", "=", " ", "10.0"}], ";"}]}], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"],

Cell["Define an independent solver for the master equation:", "Text",ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"dissipator", ",", " ", "masterEquationSolution"}], "]"}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dissipator", "[", 
     RowBox[{"channel_", ",", " ", "state_"}], "]"}], " ", ":=", "\n", "  ", 
    RowBox[{
     RowBox[{"channel", " ", ".", " ", "state", " ", ".", " ", 
      RowBox[{"ConjugateTranspose", "[", "channel", "]"}]}], " ", "-", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", "channel", "]"}], " ", ".", " ", 
         "channel", " ", ".", " ", "state"}], " ", "+", "\n", "      ", 
        RowBox[{"state", " ", ".", " ", 
         RowBox[{"ConjugateTranspose", "[", "channel", "]"}], " ", ".", " ", 
         "channel"}]}], ")"}], "/", "2"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"masterEquationSolution", "[", 
    RowBox[{
    "initialState_", ",", " ", "hamiltonian_", ",", " ", "channels_", ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"time_", ",", " ", "start_", ",", " ", "stop_"}], "}"}]}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "state", "}"}], ",", "\n", "  ", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"state", "'"}], "[", "time", "]"}], " ", "==", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"hamiltonian", " ", ".", " ", 
               RowBox[{"state", "[", "time", "]"}]}], " ", "-", " ", 
              RowBox[{
               RowBox[{"state", "[", "time", "]"}], " ", ".", " ", 
               "hamiltonian"}]}], ")"}]}], " ", "+", "\n", "      ", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"dissipator", "[", 
               RowBox[{"#", ",", " ", 
                RowBox[{"state", "[", "time", "]"}]}], "]"}], " ", "&"}], " ",
              "/@", " ", "channels"}], "]"}]}]}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{"state", "[", "start", "]"}], " ", "==", " ", 
          "initialState"}]}], "}"}], ",", " ", "state", ",", " ", 
       RowBox[{"{", 
        RowBox[{"time", ",", " ", "start", ",", " ", "stop"}], "}"}]}], 
      "]"}]}], "\n", "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"],

Cell["Generate one synthetic record and state path:", "Text",ExpressionUUID->"1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"oneSimulation", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\n", "  ", 
     RowBox[{"simulateTrajectory", "[", 
      RowBox[{
      "initialState", ",", " ", "hamiltonian", ",", " ", "measuredOperators", 
       ",", " ", "dt", ",", " ", "finalTime"}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"187adc3d-3961-76c2-4819-d667b8145c28"],

Cell["\<\
Check unit trace, equality to the conjugate transpose, and positivity along \
this path:\
\>", "Text",ExpressionUUID->"641c78eb-7f03-7846-0c24-71b57ab64aac"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"oneStates", " ", "=", " ", 
   RowBox[{"oneSimulation", "[", "\"\<States\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<largest trace error\>\"", " ", "->", " ", 
    RowBox[{"Max", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Tr", "[", "#", "]"}], " ", "-", " ", "1"}], "]"}], " ", 
       "&"}], " ", "/@", " ", "oneStates"}], "]"}]}], ",", "\n", " ", 
   RowBox[{"\"\<largest Hermiticity error\>\"", " ", "->", "\n", "   ", 
    RowBox[{"Max", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"#", " ", "-", " ", 
          RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], "]"}], "]"}], " ", 
       "&"}], " ", "/@", " ", "oneStates"}], "]"}]}], ",", "\n", " ", 
   RowBox[{"\"\<smallest eigenvalue\>\"", " ", "->", "\n", "   ", 
    RowBox[{"Min", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Eigenvalues", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#", " ", "+", " ", 
            RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], ")"}], "/", 
          "2"}], "]"}], " ", "&"}], " ", "/@", " ", "oneStates"}], "]"}], 
     "]"}]}]}], "|>"}]}], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"largest trace error\"\>", "\[Rule]", 
    "2.220446049250313`*^-16"}], ",", 
   RowBox[{"\<\"largest Hermiticity error\"\>", "\[Rule]", 
    "1.4988010832439613`*^-15"}], ",", 
   RowBox[{"\<\"smallest eigenvalue\"\>", "\[Rule]", 
    RowBox[{"-", "5.92755546366682`*^-16"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"112ae6ec-4b5c-6ad2-4729-ffb66ee93838"]
}, Open  ]],

Cell[TextData[{
 "The errors should be at numerical roundoff. Positivity is preserved, but \
accuracy still depends on ",
 Cell[BoxData["dt"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6121b9de-dddd-aca8-10de-309bd469f6f2"],
 "."
}], "Text",ExpressionUUID->"30209679-023a-ee91-61df-0823b7ccb4fb"],

Cell["\<\
Feed the synthetic record into the separate inference function:\
\>", "Text",ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"reconstructed", " ", "=", " ", 
   RowBox[{"inferTrajectory", "[", 
    RowBox[{
    "initialState", ",", " ", "hamiltonian", ",", " ", "measuredOperators", ",",
      "\n", "  ", 
     RowBox[{"oneSimulation", "[", "\"\<RecordIncrements\>\"", "]"}], ",", 
     " ", 
     RowBox[{"Differences", "[", 
      RowBox[{"oneSimulation", "[", "\"\<Times\>\"", "]"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Max", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{"#1", " ", "-", " ", "#2"}], ",", " ", "\"\<Frobenius\>\""}], 
     "]"}], " ", "&"}], " ", "@@@", "\n", "  ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"oneSimulation", "[", "\"\<States\>\"", "]"}], ",", " ", 
      RowBox[{"reconstructed", "[", "\"\<States\>\"", "]"}]}], "}"}], "]"}]}],
   "]"}]}], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell[BoxData["3.676043161998968`*^-13"], "Output",
 CellLabel->
  "Out[14]= ",ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"]
}, Open  ]],

Cell["\<\
The two state paths agree because they use the same record and the same \
update rule. This checks the separation between simulation and inference. It \
is not an experimental validation.\
\>", "Text",ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],

Cell["\<\
Compare one state estimate from a synthetic record with the smooth \
master-equation result:\
\>", "Text",ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"timeGrid", " ", "=", " ", 
   RowBox[{"oneSimulation", "[", "\"\<Times\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"masterSolution", " ", "=", " ", 
   RowBox[{"masterEquationSolution", "[", 
    RowBox[{
    "initialState", ",", " ", "hamiltonian", ",", "\n", "  ", 
     "measuredOperators", ",", " ", 
     RowBox[{"{", 
      RowBox[{"time", ",", " ", "0", ",", " ", "finalTime"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"masterStates", " ", "=", " ", 
    RowBox[{"masterSolution", " ", "/@", " ", "timeGrid"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"timeGrid", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"blochVector", "[", "#", "]"}], "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         "oneStates"}]}], "}"}], "]"}], ",", "\n", "  ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"timeGrid", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"blochVector", "[", "#", "]"}], "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         "masterStates"}]}], "}"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"Opacity", "[", "0.65", "]"}], ",", " ", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", " ", "1"}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "Red"}], "]"}]}], "}"}]}], ",", "\n", " ", 
