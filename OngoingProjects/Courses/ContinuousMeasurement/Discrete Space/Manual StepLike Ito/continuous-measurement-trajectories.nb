     "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"], Cell[
    "Simulated, useful for insight but not experimental evidence", 
     "TableText",ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"]},
   {Cell["\<\
Average of simulations compared with a master-equation solver\
\>", "TableText",ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"], 
    Cell["Two calculations of the same model", "TableText",ExpressionUUID->
     "76dfbc62-92ac-7b6e-1ee4-364c275949b4"], Cell[
    "Numerical code check, not an experimental test", "TableText",
     ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
  GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}},
  GridBoxItemSize->{"Columns" -> {
      Scaled[0.14], 
      Scaled[0.37], 
      Scaled[0.37]}, "Rows" -> {{Automatic}}},
  GridBoxSpacings->{"Columns" -> {{1.5}}, "Rows" -> {{0.8}}}]], "Text",Express\
ionUUID->"745d1b74-bd26-44ff-aa04-e4202d3d04cb"],

Cell[TextData[{
 "Evaluate the cells from top to bottom. The code uses only built-in Wolfram \
Language functions. We set ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 ", so Hamiltonians have units of inverse time."
}], "Text",ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell["Part I: The Equation and the Detector Record", "Section",ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell[TextData[{
 "When environmental effects have no relevant memory, the state ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07964fa7-8d1e-ff14-2dae-660124a8c27e"],
 " obeys the Lindblad master equation"
}], "Text",ExpressionUUID->"3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    FractionBox[
     StyleBox[
      RowBox[{"d", "\[Rho]"}], "TI"], 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["H", "TI"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["k", "TI"],
     LimitsPositioning->False], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["k", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     RowBox[{"\|01d49f", 
      StyleBox["[",
       SpanMaxSize->1], 
      StyleBox["c", "TI"], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     StyleBox["\[Rho]", "TI"]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["c", "TI"], 
      StyleBox["\[Rho]", "TI"], 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Dagger]"]}], "-", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          StyleBox["c", "TI"], "\[Dagger]"], 
         StyleBox["c", "TI"]}], ",", 
        RowBox[{
         RowBox[{
          StyleBox["\[Rho]", "TI"], "}"}], "."}]}]}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell["\<\
This equation gives the state averaged over all possible detector records \
when no record is used. It has no random term.\
\>", "Text",ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell[TextData[{
 "Now monitor some channels ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["L", "TI"], 
   StyleBox["r", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04646437-faee-7dfc-2c1c-7e70fe9b47c6"],
 " with efficiencies ",
 Cell[BoxData[
  RowBox[{"0", "\[LessEqual]", 
   SubscriptBox[
    StyleBox["\[Eta]", "TI"], 
    StyleBox["r", "TI"]], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbde497-e826-5557-4442-fdd089d33fbd"],
 ". Leave the other channels ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],
 " unmonitored. The state estimate based on the detector record obeys"
}], "Text",ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["H", "TI"], ",", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["c", "TI"]]}], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->False], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["j", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["r", "TI"],
     LimitsPositioning->False], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["r", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["r", "TI"],
     LimitsPositioning->False], 
    SqrtBox[
     SubscriptBox[
      StyleBox["\[Eta]", "TI"], 
      StyleBox["r", "TI"]]], " ", "\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["r", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["c", "TI"]], " ", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["r", "TI"]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"1f908cf3-3c70-d55a-45af-25bdb50abfa0"],

Cell["where", "Text",ExpressionUUID->"5dac66ba-272d-3627-0b54-7fe452d99d0d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"\[ScriptCapitalH]", 
    StyleBox["[",
     SpanMaxSize->1], 
    StyleBox["c", "TI"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "=", 
    StyleBox["c", "TI"], 
    StyleBox["\[Rho]", "TI"], "+", 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     StyleBox["c", "TI"], "\[Dagger]"], "-", 
    StyleBox["Tr",
     FontSlant->"Plain"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["c", "TI"], "+", 
      SuperscriptBox[
       StyleBox["c", "TI"], "\[Dagger]"]}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"110914de-bbdd-83a1-4736-8d983e69d18b"],

Cell["The detector supplies a real readout increment", "Text",ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["r", "TI"]], "=", 
    SqrtBox[
     SubscriptBox[
      StyleBox["\[Eta]", "TI"], 
      StyleBox["r", "TI"]]], " ", 
    StyleBox["Tr",
     FontSlant->"Plain"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["r", "TI"]], "+", 
      SubsuperscriptBox[
       StyleBox["L", "TI"], 
       StyleBox["r", "TI"], "\[Dagger]"]}], 
     StyleBox[")",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["c", "TI"]]}], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["r", "TI"]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell[TextData[{
 "Each ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["r", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35077f55-9291-6519-633d-771f27244c63"],
 " is a zero-mean Gaussian increment with variance ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebf3687-f906-130d-7644-afe0f8b37e57"],
 ". The measured current over one discrete step is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["r", "TI"]], "=", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["r", "TI"]], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 "."
}], "Text",ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell["\<\
The equation updates a state estimate after each detector reading. That \
estimate depends on the record, the model, and the initial state. It is not \
another detector output.\
\>", "Text",ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],

Cell[TextData[{
 "Rates are included in the operators. A channel with rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 " and dimensionless operator ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "034d641c-5834-e412-3173-7e4659c6cf78"],
 " is passed as ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], 
   StyleBox["A", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 "."
}], "Text",ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell[TextData[{
 "Two limits provide checks. If every ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Eta]", "TI"], 
    StyleBox["r", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "134534fb-1061-d656-417a-ada5a115bcbc"],
 ", the record carries no state information and the state follows the master \
equation. In the continuous-time equation, a pure record-based state remains \
pure when every loss or noise channel is monitored at unit efficiency. The \
mean over many simulated records returns the master-equation state in the \
same limit. A finite-step calculation also has time-step error."
}], "Text",ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell["Part II: A State Update That Preserves Positivity", "Section",ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell[TextData[{
 "A direct Euler step can produce a negative eigenvalue. We instead use the \
update of Rouchon and Ralph (",
 ButtonBox["arXiv:1410.5345",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/1410.5345"], None}],
 "):"
}], "Text",ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     RowBox[{
      StyleBox["n", "TI"], "+", "1"}]], "=", 
    FractionBox[
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Rho]", "TI"], "~"], 
      RowBox[{
       StyleBox["n", "TI"], "+", "1"}]], 
     RowBox[{
      StyleBox["Tr",
       FontSlant->"Plain"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Rho]", "TI"], "~"], 
       RowBox[{
        StyleBox["n", "TI"], "+", "1"}]]}]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Rho]", "TI"], "~"], 
     RowBox[{
      StyleBox["n", "TI"], "+", "1"}]], "=", 
    StyleBox["M", "TI"], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["n", "TI"]], 
    SuperscriptBox[
     StyleBox["M", "TI"], "\[Dagger]"], "+", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["j", "TI"]], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["n", "TI"]], 
    SubsuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["j", "TI"], "\[Dagger]"], "+", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], 
    UnderscriptBox["\[Sum]", 
     StyleBox["r", "TI"],
     LimitsPositioning->False], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     SubscriptBox[
      StyleBox["\[Eta]", "TI"], 
      StyleBox["r", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["r", "TI"]], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["n", "TI"]], 
    SubsuperscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["r", "TI"], "\[Dagger]"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["M", "TI"], "=", "1", "-", "(", 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["H", "TI"], "+", 
     FractionBox["1", "2"], 
     UnderscriptBox["\[Sum]", 
      StyleBox["r", "TI"],
      LimitsPositioning->False], 
     SubsuperscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["r", "TI"], "\[Dagger]"], 
     SubscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["r", "TI"]], "+", 
     FractionBox["1", "2"], 
     UnderscriptBox["\[Sum]", 
      StyleBox["j", "TI"],
      LimitsPositioning->False], 
     SubsuperscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["j", "TI"], "\[Dagger]"], 
     SubscriptBox[
      StyleBox["V", "TI"], 
      StyleBox["j", "TI"]]}], ")", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["r", "TI"],
     LimitsPositioning->False], 
    SqrtBox[
     SubscriptBox[
      StyleBox["\[Eta]", "TI"], 
      StyleBox["r", "TI"]]], 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["r", "TI"]], " ", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["r", "TI"]], "+", 
    FractionBox["1", "2"], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["r", "TI"], ",", 
      StyleBox["s", "TI"]}],
     LimitsPositioning->False], 
    SqrtBox[
     RowBox[{
      SubscriptBox[
       StyleBox["\[Eta]", "TI"], 
       StyleBox["r", "TI"]], 
      SubscriptBox[
       StyleBox["\[Eta]", "TI"], 
       StyleBox["s", "TI"]]}]], 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["r", "TI"]], 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["s", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["R", "TI"], 
      StyleBox["r", "TI"]], 
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["R", "TI"], 
      StyleBox["s", "TI"]], "-", 
     SubscriptBox[
      StyleBox["\[Delta]", "TI"], 
      StyleBox[
       RowBox[{"r", "s"}], "TI"]], 
     StyleBox["d", "TI"], 
     StyleBox["t", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"337c2d89-644e-5b5e-6103-c4d30dfb29a4"],

Cell[TextData[{
 "Every term in ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "~"], 
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 " has the form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], 
   StyleBox["\[Rho]", "TI"], 
   SuperscriptBox[
    StyleBox["A", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 " with a nonnegative coefficient. Therefore a valid input state stays \
positive when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "\[GreaterEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
 ", ",
 Cell[BoxData[
  RowBox[{"0", "\[LessEqual]", 
   SubscriptBox[
    StyleBox["\[Eta]", "TI"], 
    StyleBox["r", "TI"]], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 ", and the normalization is nonzero."
}], "Text",ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell[TextData[{
 "This is a statement about physical validity, not numerical accuracy. A \
large step can still give a poor approximation to the continuous equation. We \
must check convergence as ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 " decreases."
}], "Text",ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

Cell["\<\
The double sum can be computed without building all operator pairs. Define\
\>", "Text",ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["S", "TI"], "=", 
    UnderscriptBox["\[Sum]", 
     StyleBox["r", "TI"],
     LimitsPositioning->False], 
    SqrtBox[
     SubscriptBox[
      StyleBox["\[Eta]", "TI"], 
      StyleBox["r", "TI"]]], 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["r", "TI"]], 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["r", "TI"]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],

Cell["Then", "Text",ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["r", "TI"], ",", 
      StyleBox["s", "TI"]}],
     LimitsPositioning->False], 
    SqrtBox[
     RowBox[{
      SubscriptBox[
       StyleBox["\[Eta]", "TI"], 
       StyleBox["r", "TI"]], 
      SubscriptBox[
       StyleBox["\[Eta]", "TI"], 
       StyleBox["s", "TI"]]}]], 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["r", "TI"]], 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["s", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["R", "TI"], 
      StyleBox["r", "TI"]], 
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["R", "TI"], 
      StyleBox["s", "TI"]], "-", 
     SubscriptBox[
      StyleBox["\[Delta]", "TI"], 
      StyleBox[
       RowBox[{"r", "s"}], "TI"]], 
     StyleBox["d", "TI"], 
     StyleBox["t", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox["1", "2"], 
    SuperscriptBox[
     StyleBox["S", "TI"], "2"], "-", 
    FractionBox[
     StyleBox[
      RowBox[{"d", "t"}], "TI"], "2"], 
    UnderscriptBox["\[Sum]", 
     StyleBox["r", "TI"],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["\[Eta]", "TI"], 
     StyleBox["r", "TI"]], 
    SubsuperscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["r", "TI"], "2"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

Cell[TextData[{
 "This is an exact algebraic identity. The order ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["L", "TI"], 
    StyleBox["r", "TI"]], 
   SubscriptBox[
    StyleBox["L", "TI"], 
    StyleBox["s", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f417ec-7166-d78d-038b-8eb60010bdd7"],
 " is unchanged."
}], "Text",ExpressionUUID->"4b6e5dad-9702-0c1f-7916-54f722b75765"],

Cell["\<\
First define input checks and prepare the fixed parts of the model:\
\>", "Text",ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "realNumberQ", ",", " ", "numericSquareMatrixQ", ",", " ", 
     "hermitianMatrixQ", ",", "\n", "  ", "densityMatrixQ", ",", " ", 
     "prepareModel"}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"realNumberQ", "[", "x_", "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"NumericQ", "[", "x", "]"}], " ", "&&", " ", 
     RowBox[{"TrueQ", "[", 
      RowBox[{
       RowBox[{"Im", "@", 
        RowBox[{"N", "[", "x", "]"}]}], " ", "==", " ", "0"}], "]"}]}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"numericSquareMatrixQ", "[", "m_", "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"MatrixQ", "[", 
      RowBox[{"m", ",", " ", "NumericQ"}], "]"}], " ", "&&", "\n", "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dims", " ", "=", " ", 
         RowBox[{"Dimensions", "[", "m", "]"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "dims", "]"}], " ", "==", " ", "2"}], " ", "&&",
         " ", 
        RowBox[{
         RowBox[{"First", "[", "dims", "]"}], " ", "==", " ", 
         RowBox[{"Last", "[", "dims", "]"}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"First", "[", "dims", "]"}], " ", ">", " ", "0"}]}]}], 
      "]"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hermitianMatrixQ", "[", 
     RowBox[{"m_", ",", " ", 
      RowBox[{"tolerance_", " ", ":", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", "\n", "  ", 
    RowBox[{
     RowBox[{"numericSquareMatrixQ", "[", "m", "]"}], " ", "&&", "\n", "   ", 
     
     RowBox[{
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"N", "[", "m", "]"}], " ", "-", " ", 
         RowBox[{"ConjugateTranspose", "[", 
          RowBox[{"N", "[", "m", "]"}], "]"}]}], "]"}], "]"}], " ", "<=", " ",
       "tolerance"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"densityMatrixQ", "[", 
     RowBox[{"m_", ",", " ", 
      RowBox[{"tolerance_", " ", ":", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", "\n", "  ", 
    RowBox[{
     RowBox[{"hermitianMatrixQ", "[", 
      RowBox[{"m", ",", " ", "tolerance"}], "]"}], " ", "&&", "\n", "   ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{"N", "[", "m", "]"}], "]"}], " ", "-", " ", "1"}], "]"}], 
      " ", "<=", " ", "tolerance"}], " ", "&&", "\n", "   ", 
     RowBox[{
      RowBox[{"Min", "[", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"N", "[", "m", "]"}], " ", "+", " ", 
           RowBox[{"ConjugateTranspose", "[", 
            RowBox[{"N", "[", "m", "]"}], "]"}]}], ")"}], "/", "2"}], "]"}], 
       "]"}], " ", ">=", " ", 
      RowBox[{"-", "tolerance"}]}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"prepareModel", "[", 
    RowBox[{
    "initialState_", ",", " ", "hamiltonian_", ",", " ", "measuredOperators_",
      ",", " ", "efficiencies_", ",", "\n", "   ", "unmonitoredOperators_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"state", " ", "=", " ", 
        RowBox[{"N", "[", "initialState", "]"}]}], ",", " ", 
       RowBox[{"ham", " ", "=", " ", 
        RowBox[{"N", "[", "hamiltonian", "]"}]}], ",", "\n", "   ", 
       RowBox[{"measured", " ", "=", " ", 
        RowBox[{"N", "[", "measuredOperators", "]"}]}], ",", " ", 
       RowBox[{"unmonitored", " ", "=", " ", 
        RowBox[{"N", "[", "unmonitoredOperators", "]"}]}], ",", "\n", "   ", 
       "eta", ",", " ", "dimension", ",", " ", "operators"}], "}"}], ",", 
     "\n", "\n", "  ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"densityMatrixQ", "[", "state", "]"}]}], ",", "\n", "   ", 
        RowBox[{"Return", "@", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidInitialState\>\"", ",", "\n", "     ", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<MessageTemplate\>\"", " ", "->", 
             " ", "\"\<The initial state must be a positive, unit-trace \
density matrix.\>\""}], "|>"}]}], "]"}]}]}], "]"}], ";", "\n", "\n", "  ", 
      RowBox[{"dimension", " ", "=", " ", 
       RowBox[{"Length", "[", "state", "]"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"ListQ", "[", "measured", "]"}]}], " ", "||", " ", 
         RowBox[{"!", 
          RowBox[{"ListQ", "[", "unmonitored", "]"}]}], " ", "||", "\n", 
         "    ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"efficiencies", " ", "=!=", " ", "Automatic"}], " ", "&&", 
           " ", 
           RowBox[{"!", 
            RowBox[{"ListQ", "[", "efficiencies", "]"}]}]}], ")"}]}], ",", 
        "\n", "   ", 
        RowBox[{"Return", "@", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidOptions\>\"", ",", "\n", "     ", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<MessageTemplate\>\"", " ", "->", 
             " ", "\"\<Measured operators, efficiencies, and unmonitored \
operators must be lists.\>\""}], "|>"}]}], "]"}]}]}], "]"}], ";", "\n", "  ", 
      
      RowBox[{"eta", " ", "=", " ", 
       RowBox[{"N", "@", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"efficiencies", " ", "===", " ", "Automatic"}], ",", "\n", 
          "     ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"Length", "[", "measured", "]"}]}], "]"}], ",", " ", 
          "efficiencies"}], "]"}]}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{"measured", ",", " ", "unmonitored"}], "]"}], ",", " ", 
           "numericSquareMatrixQ"}], "]"}]}], ",", "\n", "   ", 
        RowBox[{"Return", "@", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidChannel\>\"", ",", "\n", "     ", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<MessageTemplate\>\"", " ", "->", 
             " ", "\"\<Every channel operator must be a numerical square \
matrix.\>\""}], "|>"}]}], "]"}]}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"operators", " ", "=", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "ham", "}"}], ",", " ", "measured", ",", " ", 
         "unmonitored"}], "]"}]}], ";", "\n", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"hermitianMatrixQ", "[", "ham", "]"}]}], ",", "\n", "   ", 
        RowBox[{"Return", "@", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidHamiltonian\>\"", ",", "\n", "     ", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<MessageTemplate\>\"", " ", "->", 
             " ", "\"\<The Hamiltonian must be a numerical Hermitian \
matrix.\>\""}], "|>"}]}], "]"}]}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"operators", ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Dimensions", "[", "#", "]"}], " ", "==", " ", 
             RowBox[{"{", 
              RowBox[{"dimension", ",", " ", "dimension"}], "}"}]}], " ", 
            "&"}]}], "]"}]}], ",", "\n", "   ", 
        RowBox[{"Return", "@", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<DimensionMismatch\>\"", ",", "\n", "     ", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<MessageTemplate\>\"", " ", "->", 
             " ", "\"\<The state, Hamiltonian, and all channel operators must \
have the same dimension.\>\""}], "|>"}]}], "]"}]}]}], "]"}], ";", "\n", "  ", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "eta", "]"}], " ", "!=", " ", 
          RowBox[{"Length", "[", "measured", "]"}]}], " ", "||", "\n", "    ", 
         RowBox[{"!", 
          RowBox[{"VectorQ", "[", 
           RowBox[{"eta", ",", " ", "realNumberQ"}], "]"}]}], " ", "||", " ", 
         
         RowBox[{"!", 
          RowBox[{"AllTrue", "[", 
           RowBox[{"eta", ",", " ", 
            RowBox[{
             RowBox[{"0", " ", "<=", " ", "#", " ", "<=", " ", "1"}], " ", 
             "&"}]}], "]"}]}]}], ",", "\n", "   ", 
        RowBox[{"Return", "@", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidEfficiency\>\"", ",", "\n", "     ", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<MessageTemplate\>\"", " ", "->", 
             " ", "\"\<Provide one real efficiency between 0 and 1 for each \
measured channel.\>\""}], "|>"}]}], "]"}]}]}], "]"}], ";", "\n", "\n", "  ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<InitialState\>\"", " ", "->", " ", "state"}], ",", " ", 
        RowBox[{"\"\<Hamiltonian\>\"", " ", "->", " ", "ham"}], ",", "\n", 
        "   ", 
        RowBox[{"\"\<MeasuredOperators\>\"", " ", "->", " ", "measured"}], ",",
         " ", 
        RowBox[{"\"\<Efficiencies\>\"", " ", "->", " ", "eta"}], ",", "\n", 
        "   ", 
        RowBox[{"\"\<UnmonitoredOperators\>\"", " ", "->", " ", 
         "unmonitored"}], ",", "\n", "   ", 
        RowBox[{"\"\<Identity\>\"", " ", "->", " ", 
         RowBox[{"IdentityMatrix", "[", "dimension", "]"}]}], ",", "\n", 
        "   ", 
        RowBox[{"\"\<DriftRate\>\"", " ", "->", " ", 
         RowBox[{
          RowBox[{"I", " ", "ham"}], " ", "+", "\n", "     ", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "#", "]"}], " ", ".", " ", 
               "#"}], " ", "&"}], " ", "/@", " ", 
             RowBox[{"Join", "[", 
              RowBox[{"measured", ",", " ", "unmonitored"}], "]"}]}], "]"}], "/",
            "2"}]}]}], ",", "\n", "   ", 
        RowBox[{"\"\<CorrectionRate\>\"", " ", "->", "\n", "     ", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"#1", " ", 
               RowBox[{"(", 
                RowBox[{"#2", " ", ".", " ", "#2"}], ")"}]}], " ", "&"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"eta", ",", " ", "measured"}], "}"}]}], "]"}], "]"}], "/",
           "2"}]}]}], "|>"}]}]}], "\n", "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell[TextData[{
 "Now build one state step from the fixed model. The input ",
 Cell[BoxData["stepData"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 " is ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"stepSize", ",", " ", "readoutIncrements"}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 ":"
}], "Text",ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"makeStateStep", ",", " ", "trajectoryFailureTag"}], "]"}], ";"}],
   "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"makeStateStep", "[", "model_Association", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"identity", " ", "=", " ", 
        RowBox[{"model", "[", "\"\<Identity\>\"", "]"}]}], ",", " ", 
       RowBox[{"driftRate", " ", "=", " ", 
        RowBox[{"model", "[", "\"\<DriftRate\>\"", "]"}]}], ",", "\n", "   ", 
       
       RowBox[{"correctionRate", " ", "=", " ", 
        RowBox[{"model", "[", "\"\<CorrectionRate\>\"", "]"}]}], ",", "\n", 
       "   ", 
       RowBox[{"measured", " ", "=", " ", 
        RowBox[{"model", "[", "\"\<MeasuredOperators\>\"", "]"}]}], ",", " ", 
       
       RowBox[{"eta", " ", "=", " ", 
        RowBox[{"model", "[", "\"\<Efficiencies\>\"", "]"}]}], ",", "\n", 
       "   ", 
       RowBox[{"unmonitored", " ", "=", " ", 
        RowBox[{"model", "[", "\"\<UnmonitoredOperators\>\"", "]"}]}]}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"state", ",", " ", "stepData"}], "}"}], ",", "\n", "   ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"stepSize", " ", "=", " ", 
            RowBox[{"First", "[", "stepData", "]"}]}], ",", " ", 
           RowBox[{"readout", " ", "=", " ", 
            RowBox[{"Last", "[", "stepData", "]"}]}], ",", "\n", "     ", 
           "signalStep", ",", " ", "measurementMatrix", ",", " ", "numerator",
            ",", " ", "normalization"}], "}"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{"signalStep", " ", "=", " ", 
           RowBox[{"Total", "@", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", " ", "identity"}], "}"}], ",", "\n", "      ", 
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#1", " ", 
                  RowBox[{"Sqrt", "[", "#2", "]"}], " ", "#3"}], " ", "&"}], ",",
                 " ", 
                RowBox[{"{", 
                 RowBox[{"readout", ",", " ", "eta", ",", " ", "measured"}], 
                 "}"}]}], "]"}]}], "]"}]}]}], ";", "\n", "    ", 
          RowBox[{"measurementMatrix", " ", "=", " ", 
           RowBox[{"identity", " ", "-", " ", 
            RowBox[{"stepSize", " ", "driftRate"}], " ", "+", " ", 
            "signalStep", " ", "+", "\n", "      ", 
            RowBox[{
             RowBox[{"signalStep", " ", ".", " ", "signalStep"}], "/", "2"}], 
            " ", "-", " ", 
            RowBox[{"stepSize", " ", "correctionRate"}]}]}], ";", "\n", 
          "    ", 
          RowBox[{"numerator", " ", "=", " ", 
           RowBox[{
            RowBox[{
            "measurementMatrix", " ", ".", " ", "state", " ", ".", "\n", 
             "       ", 
             RowBox[{"ConjugateTranspose", "[", "measurementMatrix", "]"}]}], 
            " ", "+", "\n", "      ", 
            RowBox[{"stepSize", " ", 
             RowBox[{"Total", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#", " ", ".", " ", "state", " ", ".", " ", 
                 RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], " ", "&"}], 
               " ", "/@", " ", "unmonitored"}], "]"}]}], " ", "+", "\n", 
            "      ", 
            RowBox[{"stepSize", " ", 
             RowBox[{"Total", "[", "\n", "        ", 
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1", " ", "-", " ", "#2"}], ")"}], " ", 
                  RowBox[{"(", 
                   RowBox[{"#1", " ", ".", " ", "state", " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "#1", "]"}]}], ")"}]}],
                  " ", "&"}], ",", "\n", "         ", 
                RowBox[{"{", 
                 RowBox[{"measured", ",", " ", "eta"}], "}"}]}], "]"}], 
              "]"}]}]}]}], ";", "\n", "    ", 
          RowBox[{"normalization", " ", "=", " ", 
           RowBox[{"Re", "@", 
            RowBox[{"Tr", "[", "numerator", "]"}]}]}], ";", "\n", "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"TrueQ", "[", 
              RowBox[{"normalization", " ", ">", " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "14"}]}]}], "]"}]}], ",", "\n", "     ", 
            RowBox[{"Throw", "[", 
             RowBox[{
              RowBox[{"Failure", "[", 
               RowBox[{"\"\<ZeroNormalization\>\"", ",", "\n", "       ", 
                RowBox[{"<|", 
                 
                 RowBox[{"\"\<MessageTemplate\>\"", " ", "->", 
                  " ", "\"\<This step has zero numerical weight. Reduce the \
step size or check the record.\>\""}], "|>"}]}], "]"}], ",", "\n", "      ", 
              "trajectoryFailureTag"}], "]"}]}], "]"}], ";", "\n", "    ", 
          RowBox[{"numerator", "/", "normalization"}]}]}], "\n", "    ", 
        "]"}]}], "]"}]}], "\n", "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"25a0bfbe-b1d4-2428-535f-36fbc0668f72"],

Cell["\<\
The next function uses supplied readout increments. This is the function to \
use with calibrated experimental data:\
\>", "Text",ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"inferTrajectory", ",", " ", "currentFromIncrements"}], "]"}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "inferTrajectory", "]"}], " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Efficiencies\>\"", " ", "->", " ", "Automatic"}], ",", 
      "\n", "   ", 
      RowBox[{"\"\<UnmonitoredOperators\>\"", " ", "->", " ", 
       RowBox[{"{", "}"}]}]}], "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"currentFromIncrements", "[", 
     RowBox[{"increments_", ",", " ", "stepSizes_"}], "]"}], " ", ":=", "\n", 
    "  ", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#1", "/", "#2"}], " ", "&"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"increments", ",", " ", "stepSizes"}], "}"}]}], "]"}]}], ";"}],
   "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"inferTrajectory", "[", 
    RowBox[{
    "initialState_", ",", " ", "hamiltonian_", ",", "\n", "   ", 
     "measuredOperators_", ",", " ", "recordIncrements_", ",", " ", 
     "stepSizes_", ",", "\n", "   ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"model", ",", " ", 
       RowBox[{"steps", " ", "=", " ", 
        RowBox[{"N", "[", "stepSizes", "]"}]}], ",", " ", 
       RowBox[{"records", " ", "=", " ", 
        RowBox[{"N", "[", "recordIncrements", "]"}]}], ",", "\n", "   ", 
       "stateStep", ",", " ", "states", ",", " ", "times", ",", " ", 
       "channelCount"}], "}"}], ",", "\n", "\n", "  ", 
     RowBox[{
      RowBox[{"model", " ", "=", " ", 
       RowBox[{"prepareModel", "[", 
        RowBox[{
        "initialState", ",", " ", "hamiltonian", ",", " ", 
         "measuredOperators", ",", "\n", "    ", 
         RowBox[{"OptionValue", "[", "\"\<Efficiencies\>\"", "]"}], ",", " ", 
         
         RowBox[{"OptionValue", "[", "\"\<UnmonitoredOperators\>\"", "]"}]}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"FailureQ", "[", "model", "]"}], ",", " ", 
        RowBox[{"Return", "[", "model", "]"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"channelCount", " ", "=", " ", 
       RowBox[{"Length", "[", 
        RowBox[{"model", "[", "\"\<MeasuredOperators\>\"", "]"}], "]"}]}], ";",
       "\n", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"ListQ", "[", "records", "]"}]}], " ", "||", " ", 
         RowBox[{"!", 
          RowBox[{"ListQ", "[", "steps", "]"}]}], " ", "||", " ", 
         RowBox[{
          RowBox[{"Length", "[", "records", "]"}], " ", "!=", " ", 
          RowBox[{"Length", "[", "steps", "]"}]}], " ", "||", "\n", "    ", 
         RowBox[{"!", 
          RowBox[{"AllTrue", "[", 
           RowBox[{"steps", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"realNumberQ", "[", "#", "]"}], " ", "&&", " ", 
              RowBox[{"#", " ", ">", " ", "0"}]}], " ", "&"}]}], "]"}]}], " ",
          "||", "\n", "    ", 
         RowBox[{"!", 
          RowBox[{"AllTrue", "[", 
           RowBox[{"records", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"VectorQ", "[", 
               RowBox[{"#", ",", " ", "realNumberQ"}], "]"}], " ", "&&", " ", 
              
              RowBox[{
               RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", 
               "channelCount"}]}], " ", "&"}]}], "]"}]}]}], ",", "\n", "   ", 
        
        RowBox[{"Return", "@", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidRecord\>\"", ",", "\n", "     ", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<MessageTemplate\>\"", " ", "->", 
             " ", "\"\<Use one positive step size and one readout vector per \
time step.\>\""}], "|>"}]}], "]"}]}]}], "]"}], ";", "\n", "\n", "  ", 
      RowBox[{"stateStep", " ", "=", " ", 
       RowBox[{"makeStateStep", "[", "model", "]"}]}], ";", "\n", "  ", 
      RowBox[{"states", " ", "=", " ", 
       RowBox[{"Catch", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"FoldList", "[", 
          RowBox[{"stateStep", ",", " ", 
           RowBox[{"model", "[", "\"\<InitialState\>\"", "]"}], ",", " ", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"steps", ",", " ", "records"}], "}"}], "]"}]}], "]"}], ",",
          "\n", "    ", "trajectoryFailureTag"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"FailureQ", "[", "states", "]"}], ",", " ", 
        RowBox[{"Return", "[", "states", "]"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"times", " ", "=", " ", 
       RowBox[{"Accumulate", "@", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "0.", "}"}], ",", " ", "steps"}], "]"}]}]}], ";", "\n",
       "\n", "  ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Times\>\"", " ", "->", " ", "times"}], ",", " ", 
        RowBox[{"\"\<States\>\"", " ", "->", " ", "states"}], ",", "\n", 
        "   ", 
        RowBox[{"\"\<RecordIncrements\>\"", " ", "->", " ", "records"}], ",", 
        "\n", "   ", 
        RowBox[{"\"\<Current\>\"", " ", "->", " ", 
         RowBox[{"currentFromIncrements", "[", 
          RowBox[{"records", ",", " ", "steps"}], "]"}]}]}], "|>"}]}]}], "\n",
     "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

Cell["\<\
The simulator draws Gaussian noise and generates a synthetic record. It also \
returns the state path used to generate that record:\
\>", "Text",ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "makeStepSizes", ",", " ", "readoutIncrement", ",", " ", 
     "simulateTrajectory"}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "simulateTrajectory", "]"}], " ", "=", " ", 
    RowBox[{"Options", "[", "inferTrajectory", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeStepSizes", "[", 
     RowBox[{"dt_", ",", " ", "finalTime_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"step", " ", "=", " ", 
         RowBox[{"N", "[", "dt", "]"}]}], ",", " ", 
        RowBox[{"stop", " ", "=", " ", 
         RowBox[{"N", "[", "finalTime", "]"}]}], ",", " ", "count", ",", " ", 
        "remainder", ",", " ", "tolerance"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"!", 
           RowBox[{"realNumberQ", "[", "step", "]"}]}], " ", "||", " ", 
          RowBox[{"!", 
           RowBox[{"realNumberQ", "[", "stop", "]"}]}], " ", "||", " ", 
          RowBox[{"step", " ", "<=", " ", "0"}], " ", "||", " ", 
          RowBox[{"stop", " ", "<", " ", "0"}]}], ",", "\n", "   ", 
         RowBox[{"Return", "@", 
          RowBox[{"Failure", "[", 
           RowBox[{"\"\<InvalidTime\>\"", ",", "\n", "     ", 
            RowBox[{"<|", 
             
             RowBox[{"\"\<MessageTemplate\>\"", " ", "->", 
              " ", "\"\<The step size must be positive and the final time \
must be nonnegative.\>\""}], "|>"}]}], "]"}]}]}], "]"}], ";", "\n", "  ", 
       RowBox[{"tolerance", " ", "=", " ", 
        RowBox[{"100", " ", "$MachineEpsilon", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"1.", ",", " ", "step", ",", " ", "stop"}], "]"}]}]}], ";", 
       "\n", "  ", 
       RowBox[{"count", " ", "=", " ", 
        RowBox[{"Floor", "[", 
         RowBox[{"stop", "/", "step"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"remainder", " ", "=", " ", 
        RowBox[{"stop", " ", "-", " ", 
         RowBox[{"count", " ", "step"}]}]}], ";", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"count", " ", ">", " ", "0"}], " ", "&&", " ", 
          RowBox[{"remainder", " ", "<", " ", "tolerance"}]}], ",", " ", 
         RowBox[{"remainder", " ", "=", " ", "0."}]}], "]"}], ";", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"step", " ", "-", " ", "remainder"}], " ", "<", " ", 
          "tolerance"}], ",", " ", 
         RowBox[{
          RowBox[{"count", " ", "+=", " ", "1"}], ";", " ", 
          RowBox[{"remainder", " ", "=", " ", "0."}]}]}], "]"}], ";", "\n", 
       "  ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"step", ",", " ", "count"}], "]"}], ",", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"remainder", " ", ">", " ", "0"}], ",", " ", 
           RowBox[{"{", "remainder", "}"}], ",", " ", 
           RowBox[{"{", "}"}]}], "]"}]}], "]"}]}]}], "\n", "  ", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"readoutIncrement", "[", 
     RowBox[{
     "state_", ",", " ", "measuredOperators_", ",", " ", "efficiencies_", ",",
       " ", "stepSize_", ",", " ", "noise_"}], "]"}], " ", ":=", "\n", "  ", 
    RowBox[{"MapThread", "[", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", "#3", "]"}], " ", 
         RowBox[{"Re", "@", 
          RowBox[{"Tr", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"#1", " ", "+", " ", 
              RowBox[{"ConjugateTranspose", "[", "#1", "]"}]}], ")"}], " ", ".",
             " ", "state"}], "]"}]}], " ", "stepSize"}], " ", "+", " ", 
        "#2"}], " ", "&"}], ",", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{
       "measuredOperators", ",", " ", "noise", ",", " ", "efficiencies"}], 
       "}"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"simulateTrajectory", "[", 
    RowBox[{
    "initialState_", ",", " ", "hamiltonian_", ",", "\n", "   ", 
     "measuredOperators_", ",", " ", "dt_", ",", " ", "finalTime_", ",", "\n",
      "   ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "model", ",", " ", "steps", ",", " ", "noise", ",", " ", "stateStep", ",",
        " ", "simulationStep", ",", " ", "states", ",", " ", "recordBag", ",",
        " ", "records", ",", " ", "times"}], "}"}], ",", "\n", "\n", "  ", 
     RowBox[{
      RowBox[{"model", " ", "=", " ", 
       RowBox[{"prepareModel", "[", 
        RowBox[{
        "initialState", ",", " ", "hamiltonian", ",", " ", 
         "measuredOperators", ",", "\n", "    ", 
         RowBox[{"OptionValue", "[", "\"\<Efficiencies\>\"", "]"}], ",", " ", 
         
         RowBox[{"OptionValue", "[", "\"\<UnmonitoredOperators\>\"", "]"}]}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"FailureQ", "[", "model", "]"}], ",", " ", 
        RowBox[{"Return", "[", "model", "]"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"steps", " ", "=", " ", 
       RowBox[{"makeStepSizes", "[", 
        RowBox[{"dt", ",", " ", "finalTime"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"FailureQ", "[", "steps", "]"}], ",", " ", 
        RowBox[{"Return", "[", "steps", "]"}]}], "]"}], ";", "\n", "\n", "  ", 
      RowBox[{"noise", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"Sqrt", "[", "#", "]"}]}], "]"}], ",", "\n", "      ", 
           RowBox[{"Length", "[", 
            RowBox[{"model", "[", "\"\<MeasuredOperators\>\"", "]"}], "]"}]}],
           "]"}], " ", "&"}], " ", "/@", " ", "steps"}]}], ";", "\n", "  ", 
      RowBox[{"stateStep", " ", "=", " ", 
       RowBox[{"makeStateStep", "[", "model", "]"}]}], ";", "\n", "  ", 
      RowBox[{"simulationStep", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"state", ",", " ", "stepData"}], "}"}], ",", "\n", "    ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"stepSize", " ", "=", " ", 
              RowBox[{"First", "[", "stepData", "]"}]}], ",", " ", 
             RowBox[{"noiseVector", " ", "=", " ", 
              RowBox[{"Last", "[", "stepData", "]"}]}], ",", " ", "readout"}],
             "}"}], ",", "\n", "     ", 
           RowBox[{
            RowBox[{"readout", " ", "=", " ", 
             RowBox[{"readoutIncrement", "[", 
              RowBox[{"state", ",", " ", 
               RowBox[{"model", "[", "\"\<MeasuredOperators\>\"", "]"}], ",", 
               "\n", "       ", 
               RowBox[{"model", "[", "\"\<Efficiencies\>\"", "]"}], ",", " ", 
               "stepSize", ",", " ", "noiseVector"}], "]"}]}], ";", "\n", 
            "     ", 
            RowBox[{"Sow", "[", 
             RowBox[{"readout", ",", " ", "\"\<record\>\""}], "]"}], ";", 
            "\n", "     ", 
            RowBox[{"stateStep", "[", 
             RowBox[{"state", ",", " ", 
              RowBox[{"{", 
               RowBox[{"stepSize", ",", " ", "readout"}], "}"}]}], "]"}]}]}], 
          "\n", "     ", "]"}]}], "]"}]}], ";", "\n", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"states", ",", " ", "recordBag"}], "}"}], " ", "=", " ", 
       RowBox[{"Reap", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"Catch", "[", 
          RowBox[{
           RowBox[{"FoldList", "[", 
            RowBox[{"simulationStep", ",", " ", 
             RowBox[{"model", "[", "\"\<InitialState\>\"", "]"}], ",", "\n", 
             "      ", 
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"steps", ",", " ", "noise"}], "}"}], "]"}]}], "]"}], ",",
            " ", "trajectoryFailureTag"}], "]"}], ",", 
         " ", "\"\<record\>\""}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"FailureQ", "[", "states", "]"}], ",", " ", 
        RowBox[{"Return", "[", "states", "]"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"records", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"recordBag", " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"First", "[", "recordBag", "]"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"times", " ", "=", " ", 
       RowBox[{"Accumulate", "@", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "0.", "}"}], ",", " ", "steps"}], "]"}]}]}], ";", "\n",
       "\n", "  ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Times\>\"", " ", "->", " ", "times"}], ",", " ", 
        RowBox[{"\"\<States\>\"", " ", "->", " ", "states"}], ",", "\n", 
        "   ", 
        RowBox[{"\"\<RecordIncrements\>\"", " ", "->", " ", "records"}], ",", 
        "\n", "   ", 
        RowBox[{"\"\<Current\>\"", " ", "->", " ", 
         RowBox[{"currentFromIncrements", "[", 
          RowBox[{"records", ",", " ", "steps"}], "]"}]}]}], "|>"}]}]}], "\n",
     "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"14fd1512-f616-8834-3c82-8d5f83a0db1e"],

Cell[TextData[{
 Cell[BoxData["inferTrajectory"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c67103-72a1-9427-0efe-696d0755ff0d"],
 " contains no random-number generator. Its state path is inferred from its \
input record. ",
 Cell[BoxData["simulateTrajectory"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
 " does use random numbers. Its outputs are synthetic."
}], "Text",ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],

Cell["Define the qubit matrices:", "Text",ExpressionUUID->"11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "X", ",", " ", "Y", ",", " ", "Z", ",", " ", "identity2", ",", " ", 
    "jMinus", ",", " ", "densityMatrix", ",", " ", "blochVector", ",", " ", 
    "purity"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"X", " ", "=", " ", 
   RowBox[{"PauliMatrix", "[", "1", "]"}]}], ";", " ", 
  RowBox[{"Y", " ", "=", " ", 
   RowBox[{"PauliMatrix", "[", "2", "]"}]}], ";", " ", 
  RowBox[{"Z", " ", "=", " ", 
   RowBox[{"PauliMatrix", "[", "3", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"identity2", " ", "=", " ", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"jMinus", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"X", " ", "-", " ", 
      RowBox[{"I", " ", "Y"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"densityMatrix", "[", "stateVector_", "]"}], " ", ":=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"Times", ",", " ", "stateVector", ",", " ", 
     RowBox[{"Conjugate", "[", "stateVector", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"blochVector", "[", "state_", "]"}], " ", ":=", " ", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"state", " ", ".", " ", "#"}], "]"}], " ", "&"}], " ", "/@", 
     " ", 
     RowBox[{"{", 
      RowBox[{"X", ",", " ", "Y", ",", " ", "Z"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"purity", "[", "state_", "]"}], " ", ":=", " ", 
   RowBox[{"Re", "@", 
    RowBox[{"Tr", "[", 
     RowBox[{"state", " ", ".", " ", "state"}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"blochVector", "[", "state", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3181a460-bc62-f1ee-67be-3e4a3514c334"],
 " returns the three averages of ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],
 ", ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b45e796-37a7-eecc-197a-fed04253b416"],
 ", and ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 ". ",
 Cell[BoxData[
  RowBox[{"purity", "[", "state", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 " returns ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "2"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a9104d-5625-6af3-4356-8a1763d038d9"],
 "; it equals one for a pure state. When the state is inferred, both \
quantities are inferred too. They are not detector readings."
}], "Text",ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

Cell["With our basis convention,", "Text",ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], "-"], "=", "(", GridBox[{
      {"0", "0"},
      {"1", "0"}
     }], ")"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"341c54d9-3079-6bba-5c24-4d83410c3980"],

Cell[TextData[{
 "It sends ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],
 " to ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f449897-1a0e-51e7-357b-11d19fbb23cd"],
 ". Thus ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],
 " is the excited state and ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5077c06e-c394-b43c-000c-da4bf6261f06"],
 " is the ground state in this notebook."
}], "Text",ExpressionUUID->"07359582-e823-44a1-2eca-0cef89d62e8b"],

Cell["Define three pure states:", "Text",ExpressionUUID->"7c239bd0-3ff5-3b18-25d0-129ab9818662"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ket0", " ", "=", " ", 
   RowBox[{"{", 
