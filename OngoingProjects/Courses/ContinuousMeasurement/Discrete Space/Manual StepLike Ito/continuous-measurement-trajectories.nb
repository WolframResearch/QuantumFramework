Cell["\<\
Small differences remain because only 150 paths were used. Agreement checks \
that the random update has the correct mean. Both curves come from the same \
model, so this is a code check, not a measurement.\
\>", "Text",ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell["Part IV: Strong and Weak Monitoring", "Section",ExpressionUUID->"023f49e2-a747-9723-33c5-60cfd2f3fa09"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", "\[CapitalOmega]", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21aa1c49-e16c-f406-57a9-9612901edf6c"],
 " and a monitored operator ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "289b85cd-827f-9a9c-58b8-1c97370be8e6"],
 ", the value ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f3dbee-abc4-6375-4280-d2cbce714e5f"],
 " averaged over all possible records satisfies"
}], "Text",ExpressionUUID->"7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["z", "TI"], ".."], "+", "2", 
    StyleBox["\[Gamma]", "TI"], 
    OverscriptBox[
     StyleBox["z", "TI"], "."], "+", "4", 
    SuperscriptBox["\[CapitalOmega]", "2"], 
    StyleBox["z", "TI"], "=", "0"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["z", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "0", 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", "1"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     OverscriptBox[
      StyleBox["z", "TI"], "."], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "0", 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{"0", "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"],

Cell["The two exponents are", "Text",ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"-", 
    StyleBox["\[Gamma]", "TI"], "\[PlusMinus]", 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["\[Gamma]", "TI"], "2"], "-", "4", 
      SuperscriptBox["\[CapitalOmega]", "2"]}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[TextData[{
 "Strong monitoring means ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "\[GreaterGreater]", "\[CapitalOmega]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa29c-d013-1000-4004-3bd9e1a6636a"],
 ". The slow rate is then"
}], "Text",ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["\[Gamma]", "TI"], "-", 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["\[Gamma]", "TI"], "2"], "-", "4", 
      SuperscriptBox["\[CapitalOmega]", "2"]}]], "\[TildeEqual]", 
    FractionBox[
     RowBox[{"2", 
      SuperscriptBox["\[CapitalOmega]", "2"]}], 
     StyleBox["\[Gamma]", "TI"]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell[TextData[{
 "Thus stronger monitoring slows the change of ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],
 ". This slowing is called the quantum Zeno effect."
}], "Text",ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c"],

Cell["Define the exact solution for the two noncritical cases:", "Text",ExpressionUUID->"52243646-2fbd-210e-03db-a8204a487054"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "zDephasing", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zDephasing", "[", 
    RowBox[{"t_", ",", " ", "omega_", ",", " ", "gamma_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{
        RowBox[{"gamma", "^", "2"}], " ", "-", " ", 
        RowBox[{"4", " ", 
         RowBox[{"omega", "^", "2"}]}]}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"Which", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"q", " ", ">", " ", "0"}], ",", " ", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "gamma"}], " ", "t"}], "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cosh", "[", 
           RowBox[{
            RowBox[{"Sqrt", "[", "q", "]"}], " ", "t"}], "]"}], " ", "+", " ", 
          RowBox[{"gamma", " ", 
           RowBox[{
            RowBox[{"Sinh", "[", 
             RowBox[{
              RowBox[{"Sqrt", "[", "q", "]"}], " ", "t"}], "]"}], "/", 
            RowBox[{"Sqrt", "[", "q", "]"}]}]}]}], ")"}]}], ",", "\n", "   ", 
       
       RowBox[{"q", " ", "<", " ", "0"}], ",", " ", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "gamma"}], " ", "t"}], "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"-", "q"}], "]"}], " ", "t"}], "]"}], " ", "+", " ", 
          RowBox[{"gamma", " ", 
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{
              RowBox[{"Sqrt", "[", 
               RowBox[{"-", "q"}], "]"}], " ", "t"}], "]"}], "/", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"-", "q"}], "]"}]}]}]}], ")"}]}], ",", "\n", "   ", 
       "True", ",", " ", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "gamma"}], " ", "t"}], "]"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"gamma", " ", "t"}]}], ")"}]}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"1acd7f4d-3da3-7753-4af3-7717b4565db9"],

Cell["\<\
Check the equation, initial values, and strong-monitoring rate without \
choosing numerical values:\
\>", "Text",ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "symbolicTime", ",", " ", "symbolicOmega", ",", " ", "symbolicGamma", ",",
      " ", "symbolicZ"}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"symbolicZ", " ", "=", " ", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "symbolicGamma"}], " ", "symbolicTime"}], "]"}], " ", 
     RowBox[{"(", "\n", "   ", 
      RowBox[{
       RowBox[{"Cosh", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"symbolicGamma", "^", "2"}], " ", "-", " ", 
           RowBox[{"4", " ", 
            RowBox[{"symbolicOmega", "^", "2"}]}]}], "]"}], " ", 
         "symbolicTime"}], "]"}], " ", "+", "\n", "    ", 
       RowBox[{"symbolicGamma", " ", 
        RowBox[{
         RowBox[{"Sinh", "[", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"symbolicGamma", "^", "2"}], " ", "-", " ", 
             RowBox[{"4", " ", 
              RowBox[{"symbolicOmega", "^", "2"}]}]}], "]"}], " ", 
           "symbolicTime"}], "]"}], "/", "\n", "     ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"symbolicGamma", "^", "2"}], " ", "-", " ", 
           RowBox[{"4", " ", 
            RowBox[{"symbolicOmega", "^", "2"}]}]}], "]"}]}]}]}], ")"}]}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"symbolicZ", ",", " ", 
        RowBox[{"{", 
         RowBox[{"symbolicTime", ",", " ", "2"}], "}"}]}], "]"}], " ", "+", 
      "\n", "   ", 
      RowBox[{"2", " ", "symbolicGamma", " ", 
       RowBox[{"D", "[", 
        RowBox[{"symbolicZ", ",", " ", "symbolicTime"}], "]"}]}], " ", "+", 
      "\n", "   ", 
      RowBox[{"4", " ", 
       RowBox[{"symbolicOmega", "^", "2"}], " ", "symbolicZ"}]}], ",", "\n", 
     "  ", 
     RowBox[{"symbolicZ", " ", "/.", " ", 
      RowBox[{"symbolicTime", " ", "->", " ", "0"}]}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"symbolicZ", ",", " ", "symbolicTime"}], "]"}], " ", "/.", " ", 
      RowBox[{"symbolicTime", " ", "->", " ", "0"}]}], ",", "\n", "  ", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{"symbolicGamma", " ", 
        RowBox[{"(", 
         RowBox[{"symbolicGamma", " ", "-", "\n", "      ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"symbolicGamma", "^", "2"}], " ", "-", " ", 
            RowBox[{"4", " ", 
             RowBox[{"symbolicOmega", "^", "2"}]}]}], "]"}]}], ")"}]}], ",", 
       "\n", "    ", 
       RowBox[{"symbolicGamma", " ", "->", " ", "Infinity"}]}], "]"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"symbolicGamma", " ", ">", " ", 
     RowBox[{"2", " ", "symbolicOmega"}], " ", ">", " ", "0"}]}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "1", ",", "0", ",", 
   RowBox[{"2", " ", 
    SuperscriptBox["symbolicOmega", "2"]}]}], "}"}]], "Output",
 CellLabel->
  "Out[21]= ",ExpressionUUID->"6f6ad260-8ee1-565a-1569-d44a2a943ca0"]
}, Open  ]],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "1", ",", " ", "0", ",", " ", 
    RowBox[{"2", " ", 
     RowBox[{"symbolicOmega", "^", "2"}]}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "612fd791-c81e-86f2-10d4-cedae9a8ecd8"],
 ". It verifies the equation, both initial values, and the coefficient in the \
slow rate."
}], "Text",ExpressionUUID->"26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],

Cell["Choose rates that are clearly separated:", "Text",ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"omegaD", " ", "=", " ", "1.0"}], ";", " ", 
  RowBox[{"gammaStrong", " ", "=", " ", "20.0"}], ";", " ", 
  RowBox[{"gammaWeak", " ", "=", " ", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dtD", " ", "=", " ", "0.0025"}], ";", " ", 
  RowBox[{"finalTimeD", " ", "=", " ", "8.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"timeGridD", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0.", ",", " ", "finalTimeD", ",", " ", "dtD"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"6b853673-18d0-d9fa-19ba-a83d996aabc0"],

Cell["Plot the exact mean curves:", "Text",ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"timeGridD", ",", " ", 
        RowBox[{"zDephasing", "[", 
