Notebook[{
Cell["\<\
Watching a Qubit: Continuous Measurement and Quantum Trajectories\
\>", "Title",ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[StyleBox["A computation-first guide to continuous measurement \
with plain matrices and the Wolfram Language. We separate detector data, \
state estimates, and simulations at every step.",
 FontWeight->"Bold"]], "Text",ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell["Mads Bahrami. Last updated August 4, 2026.", "Text",ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell["Setting the Stage: What This Notebook Does", "Subsection",ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell[TextData[{
 "This notebook builds two tools. ",
 Cell[BoxData["inferTrajectory"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a568a6-87a2-527f-535a-810032572145"],
 " updates a state estimate from a supplied detector record. ",
 Cell[BoxData["simulateTrajectory"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 " generates a synthetic record and a matching state path from a model and \
random noise."
}], "Text",ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell["\<\
Computation has three roles here: infer a state from data, illustrate a model \
with simulation, and check code against a separate calculation.\
\>", "Text",ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell["Keep these distinctions fixed:", "Text",ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[BoxData[GridBox[{
   {Cell["Object", "TableText",
     FontWeight->Bold,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],
     Cell["Source", "TableText",
     FontWeight->Bold,ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"],
     Cell["Status", "TableText",
     FontWeight->Bold,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"]},
   {Cell["Detector current from an experiment", "TableText",ExpressionUUID->
     "234f1fb7-07c6-bba9-5174-96f1b27009f3"], Cell[
    "Detector electronics", "TableText",ExpressionUUID->
     "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"], Cell[
    "Observed data", "TableText",ExpressionUUID->
     "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"]},
   {Cell["State path computed from an experimental record", "TableText",
     ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"], Cell[
    "Record, model, and initial state", "TableText",ExpressionUUID->
