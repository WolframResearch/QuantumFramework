Cell[TextData[{
 "Check two boundary cases together: no recorded channel and a final step \
shorter than ",
 Cell[BoxData["dt"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6815cd54-0cd7-196f-182a-e51ea5626bb5"],
 ":"
}], "Text",ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"boundaryExample", " ", "=", " ", 
    RowBox[{"simulateTrajectory", "[", 
     RowBox[{
      RowBox[{"densityMatrix", "[", "ket0", "]"}], ",", " ", 
      RowBox[{"0.", " ", "identity2"}], ",", " ", 
      RowBox[{"{", "}"}], ",", "\n", "  ", "0.007", ",", " ", "0.023", ",", 
      " ", 
      RowBox[{"\"\<UnmonitoredOperators\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "0.2", "]"}], " ", "jMinus"}], "}"}]}]}], 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<step sizes\>\"", " ", "->", " ", 
    RowBox[{"Differences", "[", 
     RowBox[{"boundaryExample", "[", "\"\<Times\>\"", "]"}], "]"}]}], ",", 
   "\n", " ", 
   RowBox[{"\"\<record dimensions\>\"", " ", "->", " ", 
    RowBox[{"Dimensions", "[", 
     RowBox[{"boundaryExample", "[", "\"\<RecordIncrements\>\"", "]"}], 
     "]"}]}], ",", "\n", " ", 
   RowBox[{"\"\<state dimensions\>\"", " ", "->", " ", 
    RowBox[{"Dimensions", "[", 
     RowBox[{"boundaryExample", "[", "\"\<States\>\"", "]"}], "]"}]}], ",", 
   "\n", " ", 
   RowBox[{"\"\<ends at requested time\>\"", " ", "->", "\n", "   ", 
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{
       RowBox[{"Last", "[", 
        RowBox[{"boundaryExample", "[", "\"\<Times\>\"", "]"}], "]"}], " ", "-",
        " ", "0.023"}], "]"}], " ", "==", " ", "0"}]}]}], "|>"}]}], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"5900aac7-5263-773e-0f3f-43a167165a04"],

