Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3.3747577333484107`", ",", "4.950926286840625`"}], "}"}]], "Output",\

 CellLabel->
  "Out[36]= ",ExpressionUUID->"735e49d5-32a1-4a48-2166-609f47541892"]
}, Open  ]],

Cell["\<\
For this driven, emitting qubit, the equations for the mean Bloch vector \
oscillate at\
\>", "Text",ExpressionUUID->"335d55a2-cf9b-493d-6163-4c0fea2e1807"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["osc",
     FontSlant->"Plain"]], "=", 
   SqrtBox[
    RowBox[{
     SubsuperscriptBox["\[CapitalOmega]", 
      StyleBox["C", "TI"], "2"], "-", 
     SubsuperscriptBox[
      StyleBox["\[Gamma]", "TI"], 
      StyleBox["C", "TI"], "2"], "/", "16"}]]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"3bfbbd45-edb8-1b0b-6998-352e844d6651"],

Cell[TextData[{
 "and decay at rate ",
 Cell[BoxData[
  RowBox[{"3", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["C", "TI"]], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "045023ab-c37d-b770-2c6f-baf4f6091a5a"],
 ". The spectrum should show a peak near ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["osc",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73e8aeff-5b91-f8f4-2197-47b95e25cade"],
 ". Its detailed shape depends on the full model. A decay rate must be \
obtained from a fit with stated assumptions; it is not simply the width read \
by eye."
}], "Text",ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"],

Cell["What Is Observable, and What Is a Test?", "Subsection",ExpressionUUID->"794a4309-908b-2549-2f4a-5b53213f8f93"],

Cell["\<\
Given an experimental current, its mean, autocovariance, and spectrum are \
calculated directly from observed data. A spectral peak is therefore an \
observed feature of that record. Identifying the peak with a system parameter \
still requires a model.\
\>", "Text",ExpressionUUID->"167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],

Cell[TextData[{
 "A state path is different. It is inferred by applying ",
 Cell[BoxData["inferTrajectory"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15eb24b6-b946-3a65-43e8-bdf038f0894f"],
 " to the record. Its Bloch vector, purity, and expectation values are \
properties of the estimate, not raw detector readings."
}], "Text",ExpressionUUID->"27d2a24c-1e84-19ee-4de1-44169b316b34"],

Cell["\<\
Using the same record both to construct the state estimate and to compare its \
mean signal with that record is a consistency check, not an independent test. \
Stronger tests use data that were not used in the inference: a later \
measurement, a separate detector channel, repeated final-state measurements, \
or a prediction made before more data arrive.\
\>", "Text",ExpressionUUID->"285985c7-a1c8-13eb-5866-1ca0d07d6131"],

Cell[TextData[{
 "Experiments have used continuous records to estimate mechanical quantum \
states in real time and have tested those estimates with later or separate \
measurements: ",
 ButtonBox["Magrini et al., Nature 595, 373-377 (2021)",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.nature.com/articles/s41586-021-03602-3"], None}],
 " and ",
 ButtonBox["Rossi et al., Physical Review Letters 123, 163601 (2019)",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://journals.aps.org/prl/abstract/10.1103/PhysRevLett.123.\
163601"], None}],
 ". Those results support the method in those systems. A synthetic trajectory \
in this notebook does not inherit that status."
}], "Text",ExpressionUUID->"57868ed1-450c-c474-7dbd-279b6cbeaf5e"],

Cell["Part VII: Efficiency and Dimension", "Section",ExpressionUUID->"0c5e608e-35dc-f74f-3466-79e8bc6edd95"],

Cell["\<\
Detection efficiency changes the record-based state estimate. It does not \
change the master equation obtained after averaging over all records.\
\>", "Text",ExpressionUUID->"1a1e4090-3303-05ed-4a26-59da46b66f37"],

Cell["\<\
For the continuous-time equation, monitoring every loss or noise channel at \
unit efficiency guarantees that a pure record-based state remains pure. \
Special unmonitored channels or states can also preserve purity, but that \
requires a separate check.\
\>", "Text",ExpressionUUID->"10256af3-3972-af7a-41da-83bdb804f240"],

Cell[TextData[{
 "The finite-step update used here preserves purity exactly when the \
unmonitored-operator list is empty and every measured channel has unit \
efficiency. Otherwise the update can mix the state. With an unmonitored \
operator, small time-step mixing can appear even when the continuous equation \
would not predict it; that error vanishes as ",
 Cell[BoxData["dt"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "457602f1-d86e-ac86-730d-9bbad918f6ec"],
 " decreases."
}], "Text",ExpressionUUID->"499f95c1-a958-6c18-7fa4-0caac8ed3762"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"omegaE", " ", "=", " ", "2.0"}], ";", " ", 
  RowBox[{"gammaE", " ", "=", " ", "1.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hamiltonianE", " ", "=", " ", 
   RowBox[{"omegaE", " ", 
    RowBox[{"X", "/", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"measuredE", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sqrt", "[", "gammaE", "]"}], " ", "jMinus"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"initialStateE", " ", "=", " ", 
   RowBox[{"densityMatrix", "[", "ketPlus", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dtE", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"finalTimeE", " ", "=", " ", "6.0"}], ";"}]}], "Input",
 CellLabel->
  "In[37]:= ",ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

Cell["Compare one synthetic path at full and half efficiency:", "Text",ExpressionUUID->"0c02104f-9807-e6c4-3431-8a2919b3cc2e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fullEfficiency", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "5", "]"}], ";", "\n", "  ", 
     RowBox[{"simulateTrajectory", "[", 
      RowBox[{
      "initialStateE", ",", " ", "hamiltonianE", ",", " ", "measuredE", ",", 
       " ", "dtE", ",", " ", "finalTimeE", ",", "\n", "   ", 
       RowBox[{"\"\<Efficiencies\>\"", " ", "->", " ", 
        RowBox[{"{", "1.0", "}"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"halfEfficiency", " ", "=", " ", 
    RowBox[{"BlockRandom", "[", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "5", "]"}], ";", "\n", "  ", 
      RowBox[{"simulateTrajectory", "[", 
       RowBox[{
       "initialStateE", ",", " ", "hamiltonianE", ",", " ", "measuredE", ",", 
        " ", "dtE", ",", " ", "finalTimeE", ",", "\n", "   ", 
        RowBox[{"\"\<Efficiencies\>\"", " ", "->", " ", 
         RowBox[{"{", "0.5", "}"}]}]}], "]"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<largest purity error at eta = 1\>\"", " ", "->", "\n", "   ", 
    
    RowBox[{"Max", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"purity", "[", "#", "]"}], " ", "-", " ", "1"}], "]"}], " ", 
       "&"}], " ", "/@", " ", 
      RowBox[{"fullEfficiency", "[", "\"\<States\>\"", "]"}]}], "]"}]}], ",", 
   "\n", " ", 
   RowBox[{"\"\<mean purity at eta = 0.5\>\"", " ", "->", " ", 
    RowBox[{"Mean", "[", 
     RowBox[{"purity", " ", "/@", " ", 
      RowBox[{"halfEfficiency", "[", "\"\<States\>\"", "]"}]}], "]"}]}]}], 
  "|>"}]}], "Input",
 CellLabel->
  "In[38]:= ",ExpressionUUID->"6f909018-5ea1-6a32-15af-0a425b543918"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"largest purity error at eta = 1\"\>", "\[Rule]", 
    "2.220446049250313`*^-15"}], ",", 
   RowBox[{"\<\"mean purity at eta = 0.5\"\>", "\[Rule]", 
    "0.7904674856653089`"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[38]= ",ExpressionUUID->"2f4595f3-090a-1216-557a-0cbda8bf617c"]
}, Open  ]],

Cell["\<\
The full-efficiency path remains pure in this example. The half-efficiency \
path is mixed because some information is lost.\
\>", "Text",ExpressionUUID->"06385f5e-e9d4-4e6c-2fd8-571b886114b6"],

Cell["Check the mean over many records at three efficiencies:", "Text",ExpressionUUID->"25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"efficiencyValues", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"1.0", ",", " ", "0.5", ",", " ", "0.0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"efficiencyMaster", " ", "=", " ", 
   RowBox[{"masterEquationSolution", "[", 
    RowBox[{
    "initialStateE", ",", " ", "hamiltonianE", ",", " ", "measuredE", ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"time", ",", " ", "0", ",", " ", "finalTimeE"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"efficiencyCount", " ", "=", " ", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"efficiencySeeds", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"101", ",", " ", "102", ",", " ", "103"}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"efficiencyErrors", " ", "=", " ", 
  RowBox[{"AssociationThread", "[", 
   RowBox[{"efficiencyValues", ",", "\n", "  ", 
    RowBox[{"MapThread", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"efficiency", ",", " ", "seed"}], "}"}], ",", "\n", "    ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"finalMean", " ", "=", " ", 
            RowBox[{"Mean", "@", 
             RowBox[{"BlockRandom", "[", 
              RowBox[{
               RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", 
               "        ", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"simulateTrajectory", "[", 
                    RowBox[{
                    "initialStateE", ",", " ", "hamiltonianE", ",", " ", 
                    "measuredE", ",", " ", "dtE", ",", "\n", "           ", 
                    "finalTimeE", ",", " ", 
                    RowBox[{"\"\<Efficiencies\>\"", " ", "->", " ", 
                    RowBox[{"{", "efficiency", "}"}]}]}], "]"}], 
                   "[", "\"\<States\>\"", "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"-", "1"}], "]"}], "]"}], ",", "\n", "         ", 
                 RowBox[{"{", "efficiencyCount", "}"}]}], "]"}]}], "]"}]}]}], 
           "}"}], ",", "\n", "     ", 
          RowBox[{"Norm", "[", 
           RowBox[{
            RowBox[{"finalMean", " ", "-", " ", 
             RowBox[{"efficiencyMaster", "[", "finalTimeE", "]"}]}], ",", 
            " ", "\"\<Frobenius\>\""}], "]"}]}], "]"}]}], "]"}], ",", "\n", 
      "   ", 
      RowBox[{"{", 
       RowBox[{"efficiencyValues", ",", " ", "efficiencySeeds"}], "}"}]}], 
     "]"}]}], "]"}]}]}], "Input",
 CellLabel->
  "In[39]:= ",ExpressionUUID->"3b9a140e-d97a-4136-69b9-8e6bd80f101c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"1.`", "\[Rule]", "0.06268454275306226`"}], ",", 
   RowBox[{"0.5`", "\[Rule]", "0.020524657831115636`"}], ",", 
   RowBox[{"0.`", "\[Rule]", "0.001702763182547126`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[39]= ",ExpressionUUID->"4f9438da-b80f-a114-75ab-b18439bbf07e"]
}, Open  ]],

Cell[TextData[{
 "At efficiencies ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7281c19b-2602-dcd4-22be-d8c553b4a63e"],
 " and ",
 Cell[BoxData["0.5"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8746fc-db76-c487-64bd-5fb9de00aeed"],
 ", the error includes scatter from using a finite number of paths and error \
from the time step. At efficiency ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11f0f87a-e6f0-91cd-478f-f227928ae317"],
 ", every run is identical, so the remaining error comes mainly from the time \
step. All three approach the same master-equation state within those \
numerical errors."
}], "Text",ExpressionUUID->"473164ce-b547-c1f4-6ecf-7da83cf393de"],

Cell["\<\
Exercise two measured channels and one unmonitored channel in the same call:\
\>", "Text",ExpressionUUID->"12c4fc3b-e00c-2bba-42fb-f66491b97980"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"multiMeasured", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", "0.2", "]"}], " ", "X"}], ",", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", "0.3", "]"}], " ", "Z"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"multiUnmonitored", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sqrt", "[", "0.1", "]"}], " ", "jMinus"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"multiHamiltonian", " ", "=", " ", 
   RowBox[{"0.3", " ", "Y"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"multiInitial", " ", "=", " ", 
   RowBox[{"densityMatrix", "[", "ketPlus", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"multiExample", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "31", "]"}], ";", "\n", "  ", 
     RowBox[{"simulateTrajectory", "[", 
      RowBox[{
      "multiInitial", ",", " ", "multiHamiltonian", ",", " ", "multiMeasured",
        ",", " ", "0.005", ",", " ", "2.0", ",", "\n", "   ", 
       RowBox[{"\"\<Efficiencies\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0.8", ",", " ", "0.5"}], "}"}]}], ",", "\n", "   ", 
       RowBox[{"\"\<UnmonitoredOperators\>\"", " ", "->", " ", 
        "multiUnmonitored"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"multiMaster", " ", "=", " ", 
   RowBox[{"masterEquationSolution", "[", 
    RowBox[{"multiInitial", ",", " ", "multiHamiltonian", ",", "\n", "  ", 
     RowBox[{"Join", "[", 
      RowBox[{"multiMeasured", ",", " ", "multiUnmonitored"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"time", ",", " ", "0", ",", " ", "2.0"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"multiMeanFinal", " ", "=", " ", 
    RowBox[{"Mean", "@", 
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "32", "]"}], ";", "\n", "   ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"simulateTrajectory", "[", 
            RowBox[{
            "multiInitial", ",", " ", "multiHamiltonian", ",", " ", 
             "multiMeasured", ",", " ", "0.005", ",", "\n", "      ", "2.0", ",",
              " ", 
             RowBox[{"\"\<Efficiencies\>\"", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"0.8", ",", " ", "0.5"}], "}"}]}], ",", "\n", "      ", 
             
             RowBox[{"\"\<UnmonitoredOperators\>\"", " ", "->", " ", 
              "multiUnmonitored"}]}], "]"}], "[", "\"\<States\>\"", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], ",", " ", 
         RowBox[{"{", "120", "}"}]}], "]"}]}], "]"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<recorded channels per step\>\"", " ", "->", " ", 
    RowBox[{"Length", "[", 
     RowBox[{"First", "@", 
      RowBox[{"multiExample", "[", "\"\<RecordIncrements\>\"", "]"}]}], 
     "]"}]}], ",", "\n", " ", 
   RowBox[{"\"\<smallest eigenvalue\>\"", " ", "->", "\n", "   ", 
    RowBox[{"Min", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Eigenvalues", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#", " ", "+", " ", 
            RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], ")"}], "/", 
          "2"}], "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"multiExample", "[", "\"\<States\>\"", "]"}]}], "]"}], "]"}]}],
    ",", "\n", " ", 
   RowBox[{"\"\<final mean-state error\>\"", " ", "->", "\n", "   ", 
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{"multiMeanFinal", " ", "-", " ", 
       RowBox[{"multiMaster", "[", "2.0", "]"}]}], ",", 
      " ", "\"\<Frobenius\>\""}], "]"}]}]}], "|>"}]}], "Input",
 CellLabel->
  "In[40]:= ",ExpressionUUID->"1d7e6892-18cd-6f45-4b05-81dc997835af"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"recorded channels per step\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"smallest eigenvalue\"\>", "\[Rule]", "0.`"}], ",", 
   RowBox[{"\<\"final mean-state error\"\>", "\[Rule]", 
    "0.026797112429393744`"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[40]= ",ExpressionUUID->"325c8f47-cd85-89da-6263-2720e431db20"]
}, Open  ]],

Cell["\<\
The example checks the multi-channel and unmonitored-channel branches. Its \
records and states remain synthetic.\
\>", "Text",ExpressionUUID->"43fcea2e-12ab-c026-7183-0388a75f930c"],

Cell[TextData[{
 "The same code also works above dimension two. Use the standard spin-one \
operator ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["x", "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], "-"], "+", 
    SubscriptBox[
     StyleBox["J", "TI"], "+"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b416c07-c3d3-bf4f-097e-8660f6670595"],
 ":"
}], "Text",ExpressionUUID->"5add4728-e92e-eff1-0ae3-5f7588d8b5db"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"jMinus3", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], ",", " ", "0", ",", " ", "0"}], "}"}],
      ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"Sqrt", "[", "2", "]"}], ",", " ", "0"}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"jX3", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"jMinus3", " ", "+", " ", 
      RowBox[{"ConjugateTranspose", "[", "jMinus3", "]"}]}], ")"}], "/", 
    "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hamiltonian3", " ", "=", " ", 
   RowBox[{"1.5", " ", "jX3"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"measured3", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sqrt", "[", "0.6", "]"}], " ", "jMinus3"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"initialState3", " ", "=", " ", 
   RowBox[{"densityMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dt3", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"finalTime3", " ", "=", " ", "8.0"}], ";"}]}], "Input",
 CellLabel->
  "In[41]:= ",ExpressionUUID->"621761a3-d300-b412-122d-780ce6ba1f78"],

Cell[TextData[{
 "Run one qutrit simulation at efficiency ",
 Cell[BoxData["0.4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],
 ":"
}], "Text",ExpressionUUID->"7d3ffb2e-09a8-fc78-24c4-f288a842c742"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"qutritSimulation", " ", "=", " ", 
    RowBox[{"BlockRandom", "[", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "2", "]"}], ";", "\n", "  ", 
      RowBox[{"simulateTrajectory", "[", 
       RowBox[{
       "initialState3", ",", " ", "hamiltonian3", ",", " ", "measured3", ",", 
        " ", "dt3", ",", " ", "finalTime3", ",", "\n", "   ", 
        RowBox[{"\"\<Efficiencies\>\"", " ", "->", " ", 
         RowBox[{"{", "0.4", "}"}]}]}], "]"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<state dimension\>\"", " ", "->", " ", 
    RowBox[{"Dimensions", "[", 
     RowBox[{"First", "@", 
      RowBox[{"qutritSimulation", "[", "\"\<States\>\"", "]"}]}], "]"}]}], ",",
    "\n", " ", 
   RowBox[{"\"\<smallest eigenvalue\>\"", " ", "->", "\n", "   ", 
    RowBox[{"Min", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Eigenvalues", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#", " ", "+", " ", 
            RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], ")"}], "/", 
          "2"}], "]"}], " ", "&"}], " ", "/@", "\n", "      ", 
       RowBox[{"qutritSimulation", "[", "\"\<States\>\"", "]"}]}], "]"}], 
     "]"}]}]}], "|>"}]}], "Input",
 CellLabel->
  "In[42]:= ",ExpressionUUID->"4139b36b-52b1-2977-70c6-2b356744785d"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"state dimension\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"3", ",", "3"}], "}"}]}], ",", 
