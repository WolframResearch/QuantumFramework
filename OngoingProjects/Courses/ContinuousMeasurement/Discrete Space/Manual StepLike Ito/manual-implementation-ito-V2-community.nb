   3.865527039292523*^9}, 3.879246375112106*^9, {3.925998725921139*^9, 
   3.925998754220487*^9}, {3.9259988649006243`*^9, 3.925998958369305*^9}, 
   3.926023308239381*^9, {3.947263419196144*^9, 3.947263420237281*^9}},
 CellLabel->
  "In[206]:=",ExpressionUUID->"4f03af55-c7e4-48c8-b1a2-c09f65639d5d"],

Cell["Jump operators and damping rates (note they are List):", "Text",
 CellChangeTimes->{{3.925998960750853*^9, 3.9259989879401073`*^9}, {
   3.926018778868944*^9, 3.926018785124914*^9}, 
