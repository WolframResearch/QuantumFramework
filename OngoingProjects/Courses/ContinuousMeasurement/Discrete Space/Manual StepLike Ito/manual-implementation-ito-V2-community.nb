Notebook[{
Cell["\<\
The Quantum Stochastic Master Equation (SME) describes the evolution of an \
open quantum system interacting with its environment in a probabilistic \
manner. It extends the Lindblad master equation by incorporating stochastic \
noise, often modeled using quantum Wiener or Poisson processes. QSMEs are \
crucial for understanding decoherence, quantum measurement dynamics, and \
feedback control in quantum information processing.\
\>", "Abstract",
 CellChangeTimes->{{3.9472802658583927`*^9, 
  3.9472802698125343`*^9}},ExpressionUUID->"0dca69e5-b5a8-4d9b-812e-\
181195e705cf"],

Cell["Dynamical equation of the quantum system:", "Text",
 CellChangeTimes->{{3.947259506696175*^9, 
  3.947259513234138*^9}},ExpressionUUID->"25ae17c7-d1f9-461b-a6be-\
a0a8b4a7a577"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[DifferentialD]", "\[Rho]"}], "=", 
   RowBox[{
    RowBox[{"\[DifferentialD]", 
     RowBox[{"t", "(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"i", "[", 
         RowBox[{"H", ",", "\[Rho]"}], "]"}]}], "+", 
       RowBox[{
        SubscriptBox["\[Sum]", "i"], 
        RowBox[{
         SubscriptBox["\[CapitalGamma]", "i"], "(", 
         RowBox[{
          RowBox[{
           SubscriptBox["V", "i"], "\[Rho]", " ", 
           SubsuperscriptBox["V", "i", "\[Dagger]"]}], "-", 
          RowBox[{
           FractionBox["1", "2"], 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              SubsuperscriptBox["V", "i", "\[Dagger]"], 
              SubscriptBox["V", "i"]}], ",", "\[Rho]"}], "}"}]}]}], ")"}]}], "+", 
       RowBox[{
        SubscriptBox["\[Sum]", "i"], 
        RowBox[{
         SubscriptBox["\[Gamma]", "i"], "(", 
         RowBox[{
          RowBox[{
           SubscriptBox["L", "i"], "\[Rho]", " ", 
           SubsuperscriptBox["L", "i", "\[Dagger]"]}], "-", 
          RowBox[{
           FractionBox["1", "2"], 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              SubsuperscriptBox["L", "i", "\[Dagger]"], 
              SubscriptBox["L", "i"]}], ",", "\[Rho]"}], "}"}]}]}], ")"}]}]}],
       ")"}]}], "+", 
    RowBox[{
     SubscriptBox["\[Sum]", "i"], 
     RowBox[{
      SqrtBox[
       SubscriptBox["\[Eta]", "i"]], 
      RowBox[{"\[DifferentialD]", 
       SubscriptBox["w", "i"]}], 
      SqrtBox[
       SubscriptBox["\[Gamma]", "i"]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubscriptBox["L", "i"], " ", "\[Rho]"}], "+", 
        RowBox[{"\[Rho]", " ", 
         SubsuperscriptBox["L", "i", "\[Dagger]"]}], "-", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["L", "i"], " ", "\[Rho]"}], "+", 
           RowBox[{"\[Rho]", " ", 
            SubsuperscriptBox["L", "i", "\[Dagger]"]}]}], "]"}], "\[Rho]"}]}],
        ")"}]}]}]}]}], 
  TraditionalForm]],ExpressionUUID->"e78e0789-ebf5-44ab-a2fd-c43cfe089794"]], \
"Text",
 CellChangeTimes->{{3.92607119099926*^9, 3.9260712239952393`*^9}, {
   3.926077223906535*^9, 3.926077224595005*^9}, {3.926081579388802*^9, 
   3.926081606580157*^9}, {3.926087309475465*^9, 3.92608733337333*^9}, {
   3.926192109666902*^9, 3.926192125315446*^9}, 3.926192311761175*^9, {
   3.947259817873583*^9, 3.94725982270964*^9}, {3.947260219757711*^9, 
   3.947260224612423*^9}},ExpressionUUID->"8b941bbd-7075-40c2-ba9e-\
0e8a10116a40"],

Cell[TextData[{
 "There are jump/Lindblad operators due to the environment, denoted by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a42a92f3-ac9d-499b-a242-f37f60cb5a76"],
 ", that contribute  only as decoherence term in the dynamical equation \
(deterministic) with the decoherence rate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalGamma]", "i"], TraditionalForm]],ExpressionUUID->
  "ec05cd64-6483-4767-854e-008cec06fe1e"],
 ".\nThere are jump/Lindblad operators due to the monitoring of the system \
(with a corresponding readout), denoted by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "af5ec826-67fa-4223-9247-9fec8d9c81a2"],
 ", that contribute as decoherence terms and also stochastic terms in the \
dynamical equation, with the decoherence rate of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "i"], TraditionalForm]],ExpressionUUID->
  "58fd1ff8-b4f8-47fe-828f-49e8134b84d5"],
 " and the measurement channel efficiency of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Eta]", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "46e9f6f4-f511-4956-8353-3e2ec3c22fa3"],
 ". Their corresponding output signal reads as"
}], "Text",
 CellChangeTimes->{{3.947259533133933*^9, 3.947259553549474*^9}, {
  3.947259674344309*^9, 3.947259769385804*^9}, {3.947259830228138*^9, 
  3.947260014304628*^9}, {3.947280178444872*^9, 
  3.947280182822771*^9}},ExpressionUUID->"e364b7cc-84d1-430d-bc4f-\
423f58caf176"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[DifferentialD]", 
    SubscriptBox["R", "j"]}], "=", 
   RowBox[{
    RowBox[{
     SqrtBox[
      SubscriptBox["\[Eta]", "i"]], 
     RowBox[{"\[DifferentialD]", "t"}], " ", 
     RowBox[{"Tr", "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["L", "i"], "\[Rho]"}], "+", 
       SubsuperscriptBox["\[Rho]L", "i", "\[Dagger]"]}], ")"}]}], "+", 
    RowBox[{"\[DifferentialD]", 
     SubscriptBox["w", "i"]}]}]}], 
  TraditionalForm]],ExpressionUUID->"204c19b0-a722-4e62-b330-446551b0a223"]], \
"Text",
 CellChangeTimes->{{3.92607119099926*^9, 3.9260712239952393`*^9}, {
   3.926077223906535*^9, 3.926077224595005*^9}, {3.926081579388802*^9, 
   3.926081606580157*^9}, {3.926087309475465*^9, 3.92608733337333*^9}, {
   3.926192109666902*^9, 3.926192125315446*^9}, 3.926192311761175*^9, {
   3.947259817873583*^9, 3.94725982270964*^9}, {3.947260205235787*^9, 
   3.9472602077513227`*^9}, {3.94726024304218*^9, 3.9472603209398518`*^9}, {
   3.9473448708304234`*^9, 
   3.947344871157105*^9}},ExpressionUUID->"ad70d217-bc54-4792-9d17-\
403ef4402b96"],

Cell["\<\
We have implemented the efficient numerical scheme proposed in this paper:  \
https://arxiv.org/pdf/1410.5345
The main function for simulation is the following one:\
\>", "Text",
 CellChangeTimes->{{3.94728040691263*^9, 
  3.9472804660867243`*^9}},ExpressionUUID->"1e7b6c4a-8c26-427d-a557-\
0b9026422311"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalT]", "[", 
    RowBox[{
     SubscriptBox["\[Rho]", "0"], ",", "H", ",", "L", ",", "\[Eta]", ",", "V",
      ",", "\[Delta]t", ",", 
     SubscriptBox["t", "f"]}]}], TraditionalForm]],ExpressionUUID->
  "21bb6002-2f12-4b77-838e-dceee4aa6ce5"],
 "]\nThe function for manual evolution, with \[Rho] the initial state, ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],ExpressionUUID->
  "5927a3d9-5b53-43f2-8502-f0db6bd5a0b7"],
 " the Hamiltonian, ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "396a06bc-6317-4269-86e0-74ed61515dbf"],
 " the list of jump operators being monitored (and the evolution is \
conditioned upon their corresponding readout currents), \[Eta] the readout \
efficiency, ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "6577e34d-09c7-4049-b594-0878ad0be4ad"],
 " the list of jump operator not being monitors (e.g. environmental noise; by \
default it is None), \[Delta]t the time increment and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "f"], TraditionalForm]],ExpressionUUID->
  "b60a8b47-527a-447e-a844-1eda8aef78cf"],
 " the final time.\n\nWe call it manual evolution because we do not use \
numerical features of Mathematica such as NDSolve or ItoProcess. The main \
reason for that is we were not able to using those functionalities while \
preserving important features of a Bloch sphere dynamics."
}], "Text",
 CellChangeTimes->{{3.926192072427475*^9, 3.9261921007556543`*^9}, {
  3.9261921416820517`*^9, 3.926192320073847*^9}, {3.926192448001748*^9, 
  3.926192448303687*^9}, {3.947264170742906*^9, 3.947264201533884*^9}, {
  3.9472804794740677`*^9, 
  3.94728057779045*^9}},ExpressionUUID->"2ce3fbae-0ac1-44a8-b1c0-\
7d7c7fc08984"],

Cell["The readout currents are sowed in \[ScriptCapitalT].", "Text",
 CellChangeTimes->{{3.92619245368419*^9, 
  3.9261924646191473`*^9}},ExpressionUUID->"82baa8c1-e290-4c37-9d69-\
f09d12492eff"],

