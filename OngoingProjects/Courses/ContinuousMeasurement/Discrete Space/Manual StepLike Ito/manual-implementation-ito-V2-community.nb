Cell[TextData[{
 "Solve the Lindblad master equation for the density matrix: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], "\[Rho]"}], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"i", "[", 
       RowBox[{"H", ",", "\[Rho]"}], "]"}]}], "+", 
     RowBox[{
      SubscriptBox["\[Sum]", "i"], 
      RowBox[{
       SubscriptBox["\[Gamma]", "i"], "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["L", "i"], "\[Rho]", " ", 
         SubsuperscriptBox["L", "i", "\[Dagger]"]}], "-", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["L", "i", "\[Dagger]"], 
            SubscriptBox["L", "i"]}], ",", "\[Rho]"}], "}"}]}]}], ")"}]}]}]}],
    TraditionalForm]],ExpressionUUID->"bd40a801-52ca-43b2-9f8e-431dbbdad16a"]
}], "Text",
 CellChangeTimes->{{3.925992340702659*^9, 
  3.925992348922151*^9}},ExpressionUUID->"19da502e-21d5-4b03-871e-\
5cc5f116cbc5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Rho]t", "=", 
  RowBox[{"QuantumEvolve", "[", 
   RowBox[{"H", ",", 
    RowBox[{"Ls", "->", "\[Gamma]s"}], ",", "\[Rho]0", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tf"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.925470950375353*^9, 3.925470950972752*^9}, {
