Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]", "=", "0"}], ";", 
  RowBox[{"\[CapitalOmega]", "=", "3."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", "2"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[CapitalOmega]", " ", 
       RowBox[{"QuantumOperator", "[", "\"\<Y\>\"", "]"}]}], "+", 
      RowBox[{"\[CapitalDelta]", " ", 
       RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}]}], ")"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.861358260495375*^9, 3.86135839149502*^9}, {
