Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]", "=", "1."}], ";", 
  RowBox[{"\[CapitalOmega]", "=", "2."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", "2"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[CapitalOmega]", " ", 
       RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], "+", 
      RowBox[{"\[CapitalDelta]", " ", 
       RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}]}], ")"}]}]}], 
  ";"}]}], "Input",
