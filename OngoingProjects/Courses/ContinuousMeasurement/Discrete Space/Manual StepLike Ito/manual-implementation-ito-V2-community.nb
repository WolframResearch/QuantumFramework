Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalR]", "[", 
   RowBox[{
   "\[Rho]_", ",", "L_", ",", "\[Delta]t_", ",", "\[Delta]w_", ",", 
    "\[Eta]_"}], "]"}], ":=", 
  RowBox[{"MapThread", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SqrtBox["#3"], " ", 
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#1", "+", 
           RowBox[{"ConjugateTranspose", "[", "#1", "]"}]}], ")"}], ".", 
         "\[Rho]"}], "]"}], "\[Delta]t"}], "+", "#2"}], "&"}], ",", 
    RowBox[{"{", 
     RowBox[{"L", ",", "\[Delta]w", ",", "\[Eta]"}], "}"}]}], "]"}]}]], "Code",\

 CellChangeTimes->{{3.9261564087916813`*^9, 3.926156417644915*^9}, {
   3.926156510104566*^9, 3.926156563235715*^9}, {3.9261576025136213`*^9, 
   3.926157681395193*^9}, {3.9472611458411493`*^9, 3.947261156310651*^9}, {
   3.947261573914567*^9, 3.9472615748454123`*^9}, 3.947262747091069*^9},
 CellLabel->
  "In[198]:=",ExpressionUUID->"4c0ca4d2-9b5b-46f1-b480-5bdc7747cb21"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalT]", "[", 
   RowBox[{"\[Rho]_", ",", "H_", ",", "L_", ",", 
    RowBox[{"\[Eta]_", ":", "None"}], ",", 
    RowBox[{"V_", ":", "None"}], ",", "\[Delta]t_", ",", "tf_"}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Delta]w", ",", "Lmat", ",", "Vmat", ",", "Hmat", ",", "\[Rho]0", ",", 
      "Heff", ",", "\[Eta]m"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"\[Eta]m", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{"\[Eta]", ",", "None"}], "]"}], ",", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"1", ",", 
          RowBox[{"Length", "[", "L", "]"}]}], "]"}], ",", "\[Eta]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Rho]0", "=", 
      RowBox[{
       RowBox[{"\[Rho]", "[", "\"\<Computational\>\"", "]"}], 
       "[", "\"\<DensityMatrix\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Lmat", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<Computational\>\"", "]"}], 
         "[", "\"\<Matrix\>\"", "]"}], "&"}], "/@", "L"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Vmat", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<Computational\>\"", "]"}], 
         "[", "\"\<Matrix\>\"", "]"}], "&"}], "/@", "V"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Hmat", "=", 
      RowBox[{
       RowBox[{"H", "[", "\"\<Computational\>\"", "]"}], "[", "\"\<Matrix\>\"",
        "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Heff", "=", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "2", "]"}], "-", 
       RowBox[{"\[Delta]t", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"I", " ", "Hmat"}], "+", 
          RowBox[{".5", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"l", ".", "l"}], "+", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "l", "]"}], ".", "l"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"l", ",", "Lmat"}], "}"}]}], "]"}]}], "+", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"MatchQ", "[", 
             RowBox[{"V", ",", "None"}], "]"}], ",", "0", ",", 
            RowBox[{".5", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"l", ".", "l"}], "+", 
                RowBox[{
                 RowBox[{"ConjugateTranspose", "[", "l", "]"}], ".", "l"}]}], 
               ",", 
               RowBox[{"{", 
                RowBox[{"l", ",", "Vmat"}], "}"}]}], "]"}]}]}], "]"}]}], 
         ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Delta]w", "=", 
      RowBox[{"RandomVariate", "[", 
       RowBox[{
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"0", ",", 
          SqrtBox["\[Delta]t"]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Length", "[", "L", "]"}], ",", 
          RowBox[{"Floor", "[", 
           RowBox[{"tf", "/", "\[Delta]t"}], "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"FoldList", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"M", ",", "st", ",", "\[CapitalUpsilon]"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"\[CapitalUpsilon]", "=", 
            RowBox[{"Total", "[", 
             RowBox[{
              SqrtBox["\[Eta]m"], "Lmat", " ", 
              RowBox[{"Sow", "@", 
               RowBox[{"\[ScriptCapitalR]", "[", 
                RowBox[{
                "#1", ",", "Lmat", ",", "\[Delta]t", ",", "#2", ",", 
                 "\[Eta]m"}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           
           RowBox[{"M", "=", 
            RowBox[{"Heff", "+", 
             RowBox[{".5", 
              RowBox[{"\[CapitalUpsilon]", ".", "\[CapitalUpsilon]"}]}], "+", 
             "\[CapitalUpsilon]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"st", "=", 
            RowBox[{
             RowBox[{"M", ".", "#1", ".", 
              RowBox[{"ConjugateTranspose", "[", "M", "]"}]}], "+", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"MatchQ", "[", 
                RowBox[{"V", ",", "None"}], "]"}], ",", "0", ",", 
               RowBox[{"\[Delta]t", " ", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{"l", ".", "#1", ".", 
                   RowBox[{"ConjugateTranspose", "[", "l", "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"l", ",", "Vmat"}], "}"}]}], "]"}]}]}], "]"}], "+", 
             RowBox[{"\[Delta]t", " ", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   RowBox[{"\[Eta]m", "[", 
                    RowBox[{"[", "l", "]"}], "]"}]}], ")"}], 
                 RowBox[{
                  RowBox[{"Lmat", "[", 
                   RowBox[{"[", "l", "]"}], "]"}], ".", "#1", ".", 
                  RowBox[{"ConjugateTranspose", "[", 
                   RowBox[{"Lmat", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "]"}]}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"l", ",", 
                  RowBox[{"Range", "[", 
                   RowBox[{"Length", "@", "Lmat"}], "]"}]}], "}"}]}], 
               "]"}]}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"st", "/", 
            RowBox[{"Tr", "[", "st", "]"}]}]}]}], "]"}], "&"}], ",", 
       "\[Rho]0", ",", 
       RowBox[{"Transpose", "[", "\[Delta]w", "]"}]}], "]"}]}]}], 
   "]"}]}]], "Code",
 CellChangeTimes->{
