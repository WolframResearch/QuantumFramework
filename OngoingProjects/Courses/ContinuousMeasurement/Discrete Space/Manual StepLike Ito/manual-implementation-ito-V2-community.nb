Cell[TextData[{
 "Solve the Lindblad master equation for the density matrix: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], "\[Rho]"}], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"i", "[", 
       RowBox[{"H", ",", "\[Rho]"}], "]"}]}], "+", 
     RowBox[{
      SubscriptBox["\[Sum]", "i"], 
      RowBox[{
       SubscriptBox["\[Gamma]", "i"], "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["L", "i"], "\[Rho]", " ", 
         SubsuperscriptBox["L", "i", "\[Dagger]"]}], "-", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["L", "i", "\[Dagger]"], 
            SubscriptBox["L", "i"]}], ",", "\[Rho]"}], "}"}]}]}], ")"}]}]}]}],
    TraditionalForm]],ExpressionUUID->"f8856143-b55f-4441-8914-e33ee7e58756"]
}], "Text",
 CellChangeTimes->{{3.925992340702659*^9, 
  3.925992348922151*^9}},ExpressionUUID->"9e142075-cd93-42a9-9812-\
637539b4849d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Rho]t", "=", 
  RowBox[{"QuantumEvolve", "[", 
   RowBox[{"H", ",", 
    RowBox[{"Ls", "->", "\[Gamma]s"}], ",", "\[Rho]0", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tf"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.925470950375353*^9, 3.925470950972752*^9}, {
   3.925519156893359*^9, 3.925519167441406*^9}, {3.925519328364678*^9, 
