Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "TwoPointCorrelation", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TwoPointCorrelation", "[", 
   RowBox[{"data_", ",", "hmax_", ",", 
    RowBox[{"dt_", ":", "None"}], ",", 
    RowBox[{"steps_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[ScriptCapitalN]", "=", 
       RowBox[{"Length", "@", "data"}]}], ",", 
      RowBox[{"ave", " ", "=", " ", 
       RowBox[{"Mean", "[", "data", "]"}]}], ",", "vec1", ",", "M", ",", 
      "corr"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vec1", " ", "=", " ", 
      RowBox[{"data", "\[LeftDoubleBracket]", 
       RowBox[{"1", ";;", 
        RowBox[{"\[ScriptCapitalN]", "-", "hmax"}]}], 
       "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"M", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"data", "\[LeftDoubleBracket]", 
         RowBox[{
          RowBox[{"1", "+", "i"}], ";;", 
          RowBox[{"\[ScriptCapitalN]", "-", "hmax", "+", "i"}]}], 
         "\[RightDoubleBracket]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "hmax", ",", "steps"}], "}"}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"corr", "=", 
      RowBox[{
       FractionBox["1", "\[ScriptCapitalN]"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"M", ".", "vec1"}], "-", 
         SuperscriptBox["ave", "2"]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"dt", "===", "None"}], ",", "corr", ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"dt", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"1", ",", " ", "hmax", ",", "steps"}], "]"}]}], ",", 
          "corr"}], "}"}], "\[Transpose]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Code",
 CellLabel->
  "In[201]:=",ExpressionUUID->"07afd03a-da71-4161-a8d2-f5156beb8c45"],

Cell["\<\
https://mathematica.stackexchange.com/questions/46500/data-filtering-using-\
butterworth-filter\
\>", "Text",
 CellChangeTimes->{
  3.926191609676557*^9},ExpressionUUID->"05412fb1-7668-4d9c-ad0f-\
c137c9507059"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "butterworthFilter", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"butterworthFilter", "[", 
   RowBox[{"data_", ",", "\[Omega]c_", ",", 
    RowBox[{"dt_", ":", "1"}], ",", 
    RowBox[{"order_", ":", "2"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f", ",", "b"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "=", 
      RowBox[{"RecurrenceFilter", "[", 
       RowBox[{
        RowBox[{"ToDiscreteTimeModel", "[", 
         RowBox[{
          RowBox[{"ButterworthFilterModel", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<Lowpass\>\"", ",", "order", ",", "\[Omega]c"}], " ", 
            "}"}], "]"}], ",", "dt"}], "]"}], ",", "data"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"RecurrenceFilter", "[", 
       RowBox[{
        RowBox[{"ToDiscreteTimeModel", "[", 
         RowBox[{
          RowBox[{"ButterworthFilterModel", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<Lowpass\>\"", ",", "order", ",", "\[Omega]c"}], " ", 
            "}"}], "]"}], ",", "dt"}], "]"}], ",", 
        RowBox[{"Reverse", "[", "data", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"f", "+", 
        RowBox[{"Reverse", "[", "b", "]"}]}], ")"}], "/", "2"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Code",
 CellChangeTimes->{{3.926191691673223*^9, 3.926191696683222*^9}},
 CellLabel->
  "In[203]:=",ExpressionUUID->"8adf9154-08e9-4806-999c-d3f27addc427"]
}, Open  ]]
}, Open  ]]
