Cell[TextData[{
 "Solve the Lindblad master equation for the density matrix: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], "\[Rho]"}], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"i", "[", 
       RowBox[{"H", ",", "\[Rho]"}], "]"}]}], "+", 
     RowBox[{
      SubscriptBox["\[Sum]", "i"], 
      RowBox[{
       SubscriptBox["\[Gamma]", "i"], "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["L", "i"], "\[Rho]", " ", 
         SubsuperscriptBox["L", "i", "\[Dagger]"]}], "-", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["L", "i", "\[Dagger]"], 
            SubscriptBox["L", "i"]}], ",", "\[Rho]"}], "}"}]}]}], ")"}]}]}]}],
    TraditionalForm]],ExpressionUUID->"e5bbcb60-74b3-4e1a-9492-954a1eb97a97"]
}], "Text",
 CellChangeTimes->{{3.925992340702659*^9, 
  3.925992348922151*^9}},ExpressionUUID->"381f9ac3-1a3a-4a37-b493-\
e4e1ef059bc5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Rho]t", "=", 
  RowBox[{"QuantumEvolve", "[", 
   RowBox[{"H", ",", 
    RowBox[{"Ls", "->", "\[Gamma]s"}], ",", "\[Rho]0", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tf"}], "}"}]}], "]"}]}]], "Input",
