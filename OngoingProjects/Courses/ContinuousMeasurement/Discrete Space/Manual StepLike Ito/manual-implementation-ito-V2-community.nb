106dbe11d10c"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[ScriptCapitalL]", "[", "\[Rho]", "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"i", " ", "[", 
      RowBox[{
       SubscriptBox["\[CapitalOmega]\[Sigma]", "x"], ",", "\[Rho]"}], "]"}]}],
     " ", "+", " ", 
    RowBox[{"\[Gamma]", " ", 
     RowBox[{"D", "[", 
      SubscriptBox["\[Sigma]", "z"], "]"}]}]}]}], 
  TraditionalForm]],ExpressionUUID->"8e00e613-0ab4-4c93-8460-e0354c850388"]], \
"Text",
 CellChangeTimes->{{3.861358637781603*^9, 3.861358653652028*^9}, {
  3.925998732761194*^9, 
  3.92599873640249*^9}},ExpressionUUID->"dc70baf0-175c-40d0-b292-\
8728eb15dd39"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalOmega]", " ", "=", " ", "1.0"}], ";", 
  RowBox[{"H", " ", "=", " ", 
   RowBox[{"\[CapitalOmega]", " ", 
    RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.861358260495375*^9, 3.86135839149502*^9}, {
   3.861358496765419*^9, 3.861358534050394*^9}, {3.861358654616357*^9, 
