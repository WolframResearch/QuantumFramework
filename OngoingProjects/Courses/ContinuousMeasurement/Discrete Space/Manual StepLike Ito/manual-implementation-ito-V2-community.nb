   3.9259990313164062`*^9, 3.925999032586817*^9}, {3.926001446703449*^9, 
   3.926001446857757*^9}},
 CellLabel->"In[213]:=",
 CellID->1045637319,ExpressionUUID->"7254cb03-6ba3-41a7-af72-9bee025db77b"],

