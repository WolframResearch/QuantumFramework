Cell[TextData[{
 "Solve the Lindblad master equation for the density matrix: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], "\[Rho]"}], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"i", "[", 
       RowBox[{"H", ",", "\[Rho]"}], "]"}]}], "+", 
     RowBox[{
      SubscriptBox["\[Sum]", "i"], 
      RowBox[{
       SubscriptBox["\[Gamma]", "i"], "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["L", "i"], "\[Rho]", " ", 
         SubsuperscriptBox["L", "i", "\[Dagger]"]}], "-", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["L", "i", "\[Dagger]"], 
            SubscriptBox["L", "i"]}], ",", "\[Rho]"}], "}"}]}]}], ")"}]}]}]}],
    TraditionalForm]],ExpressionUUID->"e6638e32-e84f-4247-ae6b-7878e7b97287"]
}], "Text",
 CellChangeTimes->{{3.925992340702659*^9, 
  3.925992348922151*^9}},ExpressionUUID->"970d4c30-8304-4648-8fd2-\
4e0c57e13a88"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Rho]t", "=", 
  RowBox[{"QuantumEvolve", "[", 
   RowBox[{"H", ",", 
    RowBox[{"Ls", "->", "\[Gamma]s"}], ",", "\[Rho]0", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tf"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.925470950375353*^9, 3.925470950972752*^9}, {
