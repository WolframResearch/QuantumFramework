  RowBox[{"\[Rho]0", "=", 
   RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.925992588613193*^9, 3.925992589621928*^9}, {
