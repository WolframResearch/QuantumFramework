  3.947260367739273*^9}},ExpressionUUID->"a8dfca50-588c-4e87-add0-\
7fc421afe4db"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ScriptCapitalL]", "[", "\[Rho]", "]"}], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"i", " ", "[", 
       RowBox[{
        SubscriptBox["\[CapitalOmega]\[Sigma]", "x"], ",", "\[Rho]"}], 
       "]"}]}], " ", "+", " ", 
     RowBox[{"\[Gamma]", " ", 
      RowBox[{"D", "[", 
       SubscriptBox["\[Sigma]", "z"], "]"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"8ed8d432-d1e9-4cdd-904e-ed71283a5d4b"],
 " and \[Gamma] >> \[CapitalOmega]"
}], "Subsection",
 CellChangeTimes->{{3.926081378623004*^9, 
  3.926081388225338*^9}},ExpressionUUID->"d3670209-8464-44d4-8ba0-\
e067e99f5ba5"],

