Cell[TextData[{
 "Solve the Lindblad master equation for the density matrix: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], "\[Rho]"}], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"i", "[", 
       RowBox[{"H", ",", "\[Rho]"}], "]"}]}], "+", 
     RowBox[{
      SubscriptBox["\[Sum]", "i"], 
      RowBox[{
       SubscriptBox["\[Gamma]", "i"], "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["L", "i"], "\[Rho]", " ", 
         SubsuperscriptBox["L", "i", "\[Dagger]"]}], "-", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox["L", "i", "\[Dagger]"], 
            SubscriptBox["L", "i"]}], ",", "\[Rho]"}], "}"}]}]}], ")"}]}]}]}],
    TraditionalForm]],ExpressionUUID->"011ac311-7946-4e25-9d33-68833b0e64b1"]
}], "Text",
 CellChangeTimes->{{3.925992340702659*^9, 
  3.925992348922151*^9}},ExpressionUUID->"e6aee0bb-59b6-4b44-8562-\
e90946ddd20f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Rho]t", "=", 
  RowBox[{"QuantumEvolve", "[", 
   RowBox[{"H", ",", 
    RowBox[{"Ls", "->", "\[Gamma]s"}], ",", "\[Rho]0", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tf"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.925470950375353*^9, 3.925470950972752*^9}, {
   3.925519156893359*^9, 3.925519167441406*^9}, {3.925519328364678*^9, 
