Cell[TextData[{
 "The diffusion enters only as three constant sources: ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox["\[HBar]", "2"], 
   SubscriptBox[
    StyleBox["D", "TI"], 
    StyleBox[
     RowBox[{"X", "X"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09cb884c-5fc8-b209-3fc8-22165a620153"],
 " (position, the new term), ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox["\[HBar]", "2"], 
   SubscriptBox[
    StyleBox["D", "TI"], 
    StyleBox[
     RowBox[{"P", "P"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "376c6589-bcca-29e8-5d14-7cd3357f7b32"],
 " (momentum, the heating), and ",
 Cell[BoxData[
  RowBox[{"-", "4", 
   SuperscriptBox["\[HBar]", "2"], 
   SubscriptBox[
    StyleBox["D", "TI"], 
    StyleBox[
     RowBox[{"X", "P"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "667bb688-7420-22c7-0e18-2fd27dd5702d"],
 " in the correlation equation (zero at the paper's point, but the very \
coefficient the mean-force section turns on). All five displayed equations \
are operator identities, checkable at once on a truncated Fock carrier with \
",
 Cell[BoxData["\[HBar]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72002252-da4c-5210-223f-c41fdff9217a"],
 ", ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "084561a7-5440-aaee-387b-78015dfaf834"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "721e71e5-9ca7-ded5-2226-68cf1553a43f"],
 ", the anharmonicity, and every coefficient symbolic (keeping ",
 Cell[BoxData["\[HBar]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a84e7eb-55e0-1894-3abb-feb563956afe"],
 " symbolic is what pins the ",
 Cell[BoxData[
  SuperscriptBox["\[HBar]", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3261920b-7b77-02d6-621e-14557e02503c"],
 " powers of the sources; a carrier at ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebe3b2c-9c8f-bd2d-7645-b376153b0477"],
 " would pass a wrong power silently), on an interior block clear of the \
truncation edge:"
}], "Text",
 CellID->544914423,ExpressionUUID->"7d6a0058-fb4a-caff-2b69-9a05fefc98c5"],

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"nn", " ", "=", " ", "18"}], ",", " ", "a", ",", " ", "x", ",", 
     " ", "p", ",", " ", "comm", ",", " ", "acomm", ",", " ", "vp", ",", " ", 
     "hs", ",", " ", "ldag", ",", " ", "obs", ",", " ", "rhs"}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Band", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], " ", "->", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Range", "[", 
          RowBox[{"nn", " ", "-", " ", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"nn", ",", " ", "nn"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
    RowBox[{"x", " ", "=", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"hbar", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "M", " ", "w0"}], ")"}]}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{"a", " ", "+", " ", 
        RowBox[{"Transpose", "[", "a", "]"}]}], ")"}]}]}], ";", " ", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"I", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"hbar", " ", "M", " ", 
        RowBox[{"w0", "/", "2"}]}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Transpose", "[", "a", "]"}], " ", "-", " ", "a"}], ")"}]}]}],
     ";", "\n", "  ", 
    RowBox[{
     RowBox[{"comm", "[", 
      RowBox[{"u_", ",", " ", "v_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"u", " ", ".", " ", "v"}], " ", "-", " ", 
      RowBox[{"v", " ", ".", " ", "u"}]}]}], ";", " ", 
    RowBox[{
     RowBox[{"acomm", "[", 
      RowBox[{"u_", ",", " ", "v_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"u", " ", ".", " ", "v"}], " ", "+", " ", 
      RowBox[{"v", " ", ".", " ", "u"}]}]}], ";", "\n", "  ", 
    RowBox[{"vp", " ", "=", " ", 
     RowBox[{
      RowBox[{"M", " ", 
       RowBox[{"w0", "^", "2"}], " ", "x"}], " ", "+", " ", 
      RowBox[{"g3", " ", 
       RowBox[{"x", " ", ".", " ", "x"}]}], " ", "+", " ", 
      RowBox[{"g4", " ", 
       RowBox[{"x", " ", ".", " ", "x", " ", ".", " ", "x"}]}]}]}], ";", "\n",
     "  ", 
    RowBox[{"hs", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"p", " ", ".", " ", "p"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "M"}], ")"}]}], " ", "+", " ", 
      RowBox[{"M", " ", 
       RowBox[{"w0", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"x", " ", ".", " ", "x"}], "/", "2"}]}], " ", "+", " ", 
      RowBox[{"g3", " ", 
       RowBox[{
        RowBox[{"x", " ", ".", " ", "x", " ", ".", " ", "x"}], "/", "3"}]}], 
      " ", "+", " ", 
      RowBox[{"g4", " ", 
       RowBox[{
        RowBox[{
        "x", " ", ".", " ", "x", " ", ".", " ", "x", " ", ".", " ", "x"}], "/",
         "4"}]}]}]}], ";", "\n", "  ", 
    RowBox[{
     RowBox[{"ldag", "[", "o_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"I", "/", "hbar"}], ")"}], " ", 
       RowBox[{"comm", "[", 
        RowBox[{"hs", ",", " ", "o"}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"I", " ", 
         RowBox[{"gam", "/", "hbar"}]}], ")"}], " ", 
       RowBox[{"acomm", "[", 
        RowBox[{"p", ",", " ", 
         RowBox[{"comm", "[", 
          RowBox[{"x", ",", " ", "o"}], "]"}]}], "]"}]}], " ", "-", "\n", 
      "     ", 
      RowBox[{"dpp", " ", 
       RowBox[{"comm", "[", 
        RowBox[{"x", ",", " ", 
         RowBox[{"comm", "[", 
          RowBox[{"x", ",", " ", "o"}], "]"}]}], "]"}]}], " ", "-", " ", 
      RowBox[{"dxx", " ", 
       RowBox[{"comm", "[", 
        RowBox[{"p", ",", " ", 
         RowBox[{"comm", "[", 
          RowBox[{"p", ",", " ", "o"}], "]"}]}], "]"}]}], " ", "-", " ", 
      RowBox[{"2", " ", "dxp", " ", 
       RowBox[{"comm", "[", 
        RowBox[{"p", ",", " ", 
         RowBox[{"comm", "[", 
          RowBox[{"x", ",", " ", "o"}], "]"}]}], "]"}]}]}]}], ";", "\n", "  ", 
    RowBox[{"obs", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "p", ",", " ", 
       RowBox[{"x", " ", ".", " ", "x"}], ",", " ", 
       RowBox[{"p", " ", ".", " ", "p"}], ",", " ", 
       RowBox[{"acomm", "[", 
        RowBox[{"x", ",", " ", "p"}], "]"}]}], "}"}]}], ";", "\n", "  ", 
    RowBox[{"rhs", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", "/", "M"}], ",", " ", 
       RowBox[{
        RowBox[{"-", "vp"}], " ", "-", " ", 
        RowBox[{"2", " ", "gam", " ", "p"}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"acomm", "[", 
          RowBox[{"x", ",", " ", "p"}], "]"}], "/", "M"}], " ", "+", " ", 
        RowBox[{"2", " ", 
         RowBox[{"hbar", "^", "2"}], " ", "dxx", " ", 
         RowBox[{"IdentityMatrix", "[", "nn", "]"}]}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"acomm", "[", 
          RowBox[{"p", ",", " ", "vp"}], "]"}]}], " ", "-", " ", 
        RowBox[{"4", " ", "gam", " ", 
         RowBox[{"p", " ", ".", " ", "p"}]}], " ", "+", " ", 
        RowBox[{"2", " ", 
         RowBox[{"hbar", "^", "2"}], " ", "dpp", " ", 
         RowBox[{"IdentityMatrix", "[", "nn", "]"}]}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{
          RowBox[{"p", " ", ".", " ", "p"}], "/", "M"}]}], " ", "-", " ", 
        RowBox[{"acomm", "[", 
         RowBox[{"x", ",", " ", "vp"}], "]"}], " ", "-", " ", 
        RowBox[{"2", " ", "gam", " ", 
         RowBox[{"acomm", "[", 
          RowBox[{"x", ",", " ", "p"}], "]"}]}], " ", "-", " ", 
        RowBox[{"4", " ", 
         RowBox[{"hbar", "^", "2"}], " ", "dxp", " ", 
         RowBox[{"IdentityMatrix", "[", "nn", "]"}]}]}]}], "}"}]}], ";", "\n",
     "  ", 
    RowBox[{"Union", " ", "@", " ", 
     RowBox[{"Flatten", " ", "@", " ", 
      RowBox[{"Simplify", " ", "@", " ", 
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ldag", " ", "/@", " ", "obs"}], " ", "-", " ", "rhs"}], 
          ")"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", 
           RowBox[{"1", " ", ";;", " ", "8"}], ",", " ", 
           RowBox[{"1", " ", ";;", " ", "8"}]}], "]"}], "]"}], 
        "]"}]}]}]}]}]}], "]"}]], "Input",
 CellLabel->"In[40]:= ",
 CellID->1088734259,ExpressionUUID->"41d92934-9aba-8299-77e6-c17e1f4cd0e3"],

Cell[TextData[{
 "All five ladder lines vanish identically on the interior block, for a \
genuinely anharmonic force ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["V", "TI"], "\[Prime]"], "=", 
   StyleBox["M", "TI"], 
   SubsuperscriptBox[
    StyleBox["\[Omega]", "TI"], "0", "2"], 
   StyleBox["X", "TI"], "+", 
   SubscriptBox[
    StyleBox["g", "TI"], "3"], 
   SuperscriptBox[
    StyleBox["X", "TI"], "2"], "+", 
   SubscriptBox[
    StyleBox["g", "TI"], "4"], 
   SuperscriptBox[
    StyleBox["X", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cc23ff5-bf0f-f019-04f1-b6bf3abbc363"],
 " with two independent anharmonicities, pinning every constant source with \
its ",
 Cell[BoxData[
  SuperscriptBox["\[HBar]", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29880975-91f0-008f-5fb7-a13f278552d5"],
 " power and the sign of the cross term. The closure-breakers are exactly ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Prime]"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["X", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "551c00cf-fc58-99c4-0323-99a8f5d2eb2e"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"{", 
     StyleBox["P", "TI"]}], ",", 
    RowBox[{
     SuperscriptBox[
      StyleBox["V", "TI"], "\[Prime]"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["X", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], "}"}]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22235db8-54be-42b7-53d1-54e25d4b109d"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"{", 
     StyleBox["X", "TI"]}], ",", 
    RowBox[{
     SuperscriptBox[
      StyleBox["V", "TI"], "\[Prime]"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["X", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], "}"}]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0976d5ae-737d-f257-3f0d-cc080609c0bd"],
 ": for quadratic ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13e711b4-4d78-4d68-419c-88fe640d17b2"],
 " they are linear in the second moments and the system closes into the \
Lyapunov flow behind feature A; for anharmonic ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fd09d86-aea1-a602-65ef-14e3cb550d68"],
 " they climb the hierarchy and name precisely what a cumulant closure must \
model. TO DEVELOP: run ",
 Cell["/nca-route", "InlineCode",ExpressionUUID->
  "2f6c0922-6605-ed68-5513-a08c13b1b7b2"],
 " to produce these symbolically for general ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2caab86a-2af9-b1b1-54a9-32344e8d039b"],
 ", verify against the Fock carrier, and derive the energy balance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["S", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f56169e-4783-4dbb-256d-8fd872361781"],
 " (heating rate versus friction, the fluctuation-dissipation content)."
}], "Text",
 CellID->476175344,ExpressionUUID->"5b84d4d6-858d-5842-09bb-cd902c382aa8"],

Cell["Further features (identified)", "Section",
 CellID->201272189,ExpressionUUID->"67558936-e5eb-8680-0d6a-2173939fecea"],

Cell[TextData[{
 StyleBox["Relaxation spectrum.",
  FontWeight->"Bold"],
 " Now computed in section A: the drift eigenvalues are ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["\[Gamma]", "TI"], "\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["\[Gamma]", "TI"], "2"], "-", 
     SubsuperscriptBox[
      StyleBox["\[Omega]", "TI"], "0", "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1072dc7c-f7d5-c74e-4001-d6398261ad94"],
 " for the first moments, their pairwise sums governing the covariance, so \
the thermalization time is ",
 Cell[BoxData[
  RowBox[{"\[Tilde]", "1", "/", "2", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3462f0a3-098c-f6b3-5c11-e90da83edc99"],
 ", independent of temperature and ",
 Cell[BoxData["\[HBar]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04cac1af-436c-9192-2cc9-d809761ee3f8"],
 "."
}], "Item",
 CellID->320292756,ExpressionUUID->"63be94f2-239e-9b81-1145-0dbc5628e9eb"],

Cell[TextData[{
 StyleBox["Entropy production / second law.",
  FontWeight->"Bold"],
 " The completely positive steady state is a non-equilibrium steady state, so \
its entropy production rate is nonzero. The closed form for the Gaussian \
case, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    RowBox[{"\\", "Pi"}], 
    StyleBox[
     RowBox[{"s", "s"}], "TI"]], "\[Proportional]", 
   SubscriptBox[
    StyleBox["D", "TI"], 
    StyleBox[
     RowBox[{"X", "X"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a3d7a71-218e-1995-0bc3-7c3b503b6bff"],
 ", and its reading as the thermodynamic signature of the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["P", "TI"], ",", 
    StyleBox["P", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a0f2024-2f71-09ca-6a34-b98e4a045b10"],
 " term, are given by Artini and co-workers (arXiv:2507.23322) and by Bern\
\[AAcute]d, Homa and Csirik (Eur. Phys. J. D ",
 StyleBox["72",
  FontWeight->"Bold"],
 ", 212 (2018)); the tension is made exact for the paper's point in section \
A. What is open ",
 StyleBox["here", "TI"],
 " is the transient entropy production from a non-Gaussian initial state \
under anharmonic ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "277956ac-4c9d-d338-4d07-4ff66529be02"],
 ", which the closed-form track cannot reach and the simulation track must."
}], "Item",
 CellID->1146801282,ExpressionUUID->"178a6a52-23e4-1142-3d89-8c1c559163a8"],

Cell["Next steps", "Section",
 CellID->41202278,ExpressionUUID->"52ddf811-e480-8137-02e2-f25a8d3ad01d"],

Cell["\<\
Fill feature C (the Wigner Fokker-Planck) symbolically: the phase-space face \
of feature B and the cleanest classical limit.\
\>", "ItemNumbered",
 CellID->1124146653,ExpressionUUID->"719ae17a-c654-ed44-27b9-f927f3e6b7ae"],

Cell[TextData[{
 "Run ",
 Cell["/nca-route", "InlineCode",ExpressionUUID->
  "62c8f42b-c628-388a-12f7-ee74f3c28ad0"],
 " on the engine for general ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36e5ffeb-8179-694d-5e9a-f6b5300c3b97"],
 ", promoting features A and B off the harmonic case and setting up the \
anharmonic simulation track."
}], "ItemNumbered",
 CellID->1232284935,ExpressionUUID->"7af061c8-c44a-ae8e-2a80-7895edfcf4d4"],

Cell[TextData[{
 "Test the prediction the ledger makes about exact quantum Brownian motion: \
the asymptotic Hu-Paz-Zhang generator should be non-completely-positive with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["a", "TI"], "\[LessEqual]", "-", 
   SubsuperscriptBox[
    StyleBox["\[Gamma]", "TI"], "\[Infinity]", "2"], "/", 
   SuperscriptBox["\[HBar]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d437dad-8290-de9a-3b71-74f7372aa4e0"],
 ", and its asymptotic cross coefficient should match the slice inversion's \
",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["D", "TI"], 
   StyleBox[
    RowBox[{"X", "P"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aafc905-908a-67da-2a54-e16f213f4d20"],
 " once the renormalized frequency is used in the drift on both sides. A \
caution on sources: the closed-form Hu-Paz-Zhang coefficients of Homa, Bern\
\[AAcute]d and Csord\[AAcute]s (arXiv:2211.15722) are evaluated at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62016b94-8ad8-fb56-123e-82de2f52c9bc"],
 ", where the high-temperature generator does not exist, so they support only \
a ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e7c794a-82c2-56e7-3604-711437773ccd"],
 " consistency check; the finite-",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30f601cf-5001-fb68-608d-98a961b5c9b2"],
 " comparison needs the finite-",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04bc0f0b-f02f-243d-2c43-a75481db8f07"],
 " coefficients (Hu-Paz-Zhang; Halliwell-Yu). Secondary: the Gaussian \
relative entropy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox[
      RowBox[{"s", "s"}], "TI"]], 
    RowBox[{"\\", "Vert"}], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox[
      RowBox[{"M", "F"}], "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],
 " as the operational size of the equilibrium error, the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Gamma]", "TI"], "2"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705e212e-f5a4-7717-2065-b88bfc515a7d"],
 " anatomy, and the regularization dependence of the finite part beside the \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c2f5325-a3f6-c048-05d5-4a8ed5809292"],
 "."
}], "ItemNumbered",
 CellID->2082395230,ExpressionUUID->"211ecaf2-61ee-418f-5725-e3bc179b13d5"],

Cell[TextData[{
 "Carry out the transient half of the Hu-Paz-Zhang benchmark the essay sets \
up (",
 Cell["caldeira-leggett-high-T-lindblad.md", "InlineCode",ExpressionUUID->
  "51e4dffc-d38f-5703-079b-d6b9e63a3a69"],
 ", Part VIII). The equilibrium endpoints are now settled (the exact dynamics \
ends at the mean-force covariance, the generator at its even-in-",
 Cell[BoxData["\[HBar]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30e43b5d-74af-d0fb-609b-b3077d5ba2c1"],
 " steady state); what remains is the approach, a closed-form Gaussian \
contest between truncation error and memory."
}], "ItemNumbered",
 CellID->2045146513,ExpressionUUID->"44d9380c-2e05-8f35-6ce6-b2564bb1d21f"]
},
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (February 17, 2026)",
