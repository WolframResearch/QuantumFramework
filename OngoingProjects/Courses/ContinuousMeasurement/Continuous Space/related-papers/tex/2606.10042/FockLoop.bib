@article{Wilson2015,
  title = {Measurement-Based Control of a Mechanical Oscillator at Its Thermal Decoherence Rate},
  author = {Wilson, D. J. and Sudhir, V. and Piro, N. and Schilling, R. and Ghadimi, A. and Kippenberg, T. J.},
  year = 2015,
  month = aug,
  journal = {Nature},
