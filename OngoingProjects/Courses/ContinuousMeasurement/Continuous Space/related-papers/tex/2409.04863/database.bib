pages = {103037},
author = {J Li and I Moaddel Haghighi and N Malossi and S Zippilli and D Vitali},
title = {Generation and detection of large and robust entanglement between two different mechanical resonators in cavity optomechanics},
journal = {New Journal of Physics},
abstract = {We investigate a general scheme for generating, either dynamically or in the steady state, continuous variable entanglement between two mechanical resonators with different frequencies. We employ an optomechanical system in which a single optical cavity mode driven by a suitably chosen two-tone field is coupled to the two resonators. Significantly large mechanical entanglement can be achieved, which is extremely robust with respect to temperature.}
}

