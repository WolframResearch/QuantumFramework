@article{rossi_optomechanical_nodate,
  title = {Optomechanical Normal Mode Splitting by Active Feedback},
  author = {Rossi, Massimiliano},
  pages = {16},
  abstract = {Active feedback on an optical field was introduced to generate the so called squashed states of light [1], in order to reduce the in-loop quadrature fluctuations. Such technique has been studied for laser noise reduction and generation of non-classical state of light. Here, we present a study of an active feedback on a field that is injected into an optical cavity, i.e. the loop contains the cavity. The spectrum of the in-loop noise presents reduction (squashing) and enhancement (anti-squashing) with respect to the open-loop noise. The feedback-assisted cavity mode operated in the antisquashing limit is described by a frequency-dependent noise driving an effective cavity whose decay rate tends to zero as the instability threshold is approached. This effective ultra-high finesse cavity was exploited to increase the cooperativity of an optomechanical system placing a Si3N4 membrane into a cavity, leading to enhancement of optomechanical phenomena as optical damping and cooling. Finally we show that the system can reach the strong coupling regime with a modest optomechanical coupling. Splitting of the normal modes as well as optomechanical induced transparency (OMIT) of the transmitted light are signatures of this regime.},
  copyright = {All rights reserved},
  langid = {english},
  file = {/Users/massimilianoro/Zotero/storage/4WE8DVWP/RossiOptomechanical normal mode splitting by active fee.pdf}
}

