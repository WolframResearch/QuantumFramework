@article{gamse_statistical_2014,
  title = {Statistical {{Process Control}} of a {{Kalman Filter Model}}},
  author = {Gamse, Sonja and {Nobakht-Ersi}, Fereydoun and Sharifi, Mohammad},
  year = {2014},
  month = sep,
  journal = {Sensors},
  volume = {14},
  number = {10},
  pages = {18053--18074},
  issn = {1424-8220},
  doi = {10.3390/s141018053},
  urldate = {2019-06-02},
  abstract = {For the evaluation of measurement data, different functional and stochastic models can be used. In the case of time series, a Kalman filtering (KF) algorithm can be implemented. In this case, a very well-known stochastic model, which includes statistical tests in the domain of measurements and in the system state domain, is used. Because the output results depend strongly on input model parameters and the normal distribution of residuals is not always fulfilled, it is very important to perform all possible tests on output results. In this contribution, we give a detailed description of the evaluation of the Kalman filter model. We describe indicators of inner confidence, such as controllability and observability, the determinant of state transition matrix and observing the properties of the a posteriori system state covariance matrix and the properties of the Kalman gain matrix. The statistical tests include the convergence of standard deviations of the system state components and normal distribution beside standard tests. Especially, computing controllability and observability matrices and controlling the normal distribution of residuals are not the standard procedures in the implementation of KF. Practical implementation is done on geodetic kinematic observations.},
  langid = {english},
  file = {/Users/massimilianoro/Zotero/storage/HR9HMJWJ/Gamse et al.2014-Statistical Process Control of a Kalman Filter Mod.pdf}
}

