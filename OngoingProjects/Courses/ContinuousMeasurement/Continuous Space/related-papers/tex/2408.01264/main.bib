@article{walker_quantum_1987,
  title = {Quantum {{Theory}} of {{Multiport Optical Homodyning}}},
  author = {Walker, N.G.},
  year = {1987},
  month = jan,
  journal = {J. Mod. Opt.},
  volume = {34},
  number = {1},
  pages = {15--60},
  issn = {0950-0340, 1362-3044},
  doi = {10.1080/09500348714550131},
  urldate = {2020-01-26},
  abstract = {Multiport optical homodyning concerns the combining of a local oscillator with N-1 signals of the same frequency in a lossless 2N-port junction or an N x N directional coupler . An operator representation is derived for quantum measurements made on these signals in the limit of a strong local oscillator . The local oscillator may otherwise be in an arbitrary quantum state . A general class of probability operator measures (POMs) 'over complex amplitude, parameterized by a `seed state', is introduced in order to describe the multiport measurements . The coherent-state POM and the squeezed-state POMs are included as special cases for which the seed state is the ground state and the squeezed ground state, respectively . These POMs have an attractive representation as a correlation of the Wigner functions for the state being measured and the seed state of the POM . The theory is applied to a balanced eight-port junction, or a 4 x 4 coupler, which measures the complex amplitude of one of the input signals . Any of the generalized POMs can, in principle, be realized using this multiport, although those with non-classical seed states require non-classical inputs to the otherwise unused ports . For an arbitrary multiport, measurements made on a single signal when all unused ports are in the ground state are considered . In this case, the squeezedstate POMs are the complete set of measurements realizable with multiport detection . The squeezing parameter for the equivalent POM depends in a simple way on the scattering matrix of the multiport junction . A modified version of the 4 x 4 coupler shows how this POM describes a weighted measurement of two orthogonal quadratures . The measurements are also generalized to include the case when the unused inputs are in arbitrary classical states .},
  langid = {english},
  keywords = {multiport homodyning,quantum optics},
  file = {/Users/massimilianoro/Zotero/storage/JBE4T753/Walker1987-Quantum Theory of Multiport Optical Homodyning.pdf}
}

