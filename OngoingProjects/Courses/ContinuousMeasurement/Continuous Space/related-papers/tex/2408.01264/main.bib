  doi = {10.1063/5.0190658},
  urldate = {2024-07-15},
  abstract = {Many experiments in the field of optical levitation with nanoparticles today are limited by the available technologies for particle loading. Here, we introduce a particle loading method that solves the main challenges, namely deterministic positioning of the particles and clean delivery at ultra-high vacuum levels as required for quantum experiments. We demonstrate the efficient loading, positioning, and repositioning of nanoparticles in the range of 100--755~ nm diameter into different lattice sites of a standing wave optical trap, as well as direct loading of 143--365~ nm diameter particles into ultra-high vacuum, down to an unprecedented pressure below 10-9~ mbar. Our method relies on the transport of nanoparticles within a hollow-core photonic crystal fiber using an optical conveyor belt, which can be precisely positioned with respect to the target trap. Our work opens the path for increasing nanoparticle numbers in the study of multiparticle dynamics and high turn-around times for exploiting the quantum regime of levitated solids in ultra-high vacuum.},
  langid = {english},
  file = {/Users/massimilianoro/Zotero/storage/GNWXWXH2/Lindner et al. - 2024 - Hollow-core fiber loading of nanoparticles into ul.pdf}
}

@article{liu_acousto-optic_2018,
  title = {Acousto-{{Optic Modulation Induced Noises}} on {{Heterodyne-Interrogated Interferometric Fiber-Optic Sensors}}},
  author = {Liu, Fei and Gu, Lijuan and Xie, Shangran and He, Xiangge and Yi, Duo and Zhang, Min and Tao, Qingchang},
  year = {2018},
  month = aug,
  journal = {J. Lightwave Technol.},
  volume = {36},
  number = {16},
  pages = {3465--3471},
  issn = {0733-8724, 1558-2213},
  doi = {10.1109/JLT.2018.2846280},
  urldate = {2020-11-21},
  abstract = {Acousto-optic modulator (AOM) is a key component in heterodyne-interrogated interferometric fiber-optic sensors. Here, we analyze in detail the effect of AOM on the noise floor of interferometric fiber-optic sensors with heterodyne detection. Besides the well-known phase noises caused by the AOM driver, the intensity noise induced by the relative diffraction efficiency fluctuation (RDEF) of AOM is considered and for the first time studied in detail. The power spectrum density of the intensity noise is found 0.8-0.9 times of the ``switching noise,'' which is defined as the sum of RDEF and relative intensity noise of the laser. The switching noise varies with the driving power of AOM and can be reduced by setting the driving power close to its saturation point. Experimentally, we achieved {$\sim$}5-dB suppression of the switching noise and {$\sim$}2-dB reduction of the overall noise floor. By working at the optimal driving power, together with reducing the AOMinduced phase noise to -130 dB level at the frequency offset twice of the heterodyne frequency, the overall noise floor of the s{\textsurd}ensor can be optimized to about -101 dB, i.e., the order of 10 {\textmu}rad/ Hz.},
  langid = {english},
  file = {/Users/massimilianoro/Zotero/storage/IX7J8SFY/Liu et al.2018-Acousto-Optic Modulation Induced Noises on Heterod.pdf}
}

