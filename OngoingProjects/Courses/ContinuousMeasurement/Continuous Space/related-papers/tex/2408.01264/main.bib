@phdthesis{cremer_photoacoustic_nodate,
  title = {Photoacoustic Spectroscopy of Single Optically Trapped Aerosol Droplets},
  author = {Cremer, Johannes W.},
  abstract = {Photoacoustic spectroscopy measures light absorption by a sample by period- ically heating the sample with a modulated laser and recording the resulting acoustic wave in the gas surrounding the sample. For aerosol particles, it is the most successful method for pure absorption measurements. Because of its accuracy and sensitivity it is routinely used to monitor air quality to quantify light absorption by atmospheric aerosol particles, and for the cali- bration of other instruments. There are, however, predicted biases for photoacoustic measurements of large aerosol particles and at high relative humidity. These biases have their ori- gin in the microphysical processes describing the heat and mass transfer from aerosol particles to the surrounding gas. Model predictions have quanti ed these biases, but attempts to verify these predictions have so far been in- conclusive. Here a major experimental issue comes from the fact that so far photoacoustic measurements of aerosols were possible only for particle ensembles but not for single particles. The di culty with particle ensemble studies is the variation in their properties, such as particle size, shape and chemical composition. A major goal of this thesis was the development of the  rst single particle surement biases. Single particles are immobilized in the photoacoustic setup by optical traps. In parallel to the photoacoustic signal, the size of a trapped particle can be monitored through light scattering measurements. This allows precise size control, which is a prerequisite to study the size-dependence of the mentioned measurement biases. Modulated (resonant) and pulsed photoa- coustic setups are compared, with the  nding that resonant photoacoustics performs much better for single aerosol particles. In addition, two di erent photoacoustic resonators - a resonant photoacoustic cell and a quartz tuning fork - are tested. The former allows to reduce measurement biases for larger particle sizes by using low resonance frequencies, while the latter provides higher sensitivity. This  rst single particle photoacoustic study reveals that a very high sensitivity can be achieved. Absorbances of 10-7 can be recorded in attoliter sample amounts. The single particle photoacoustic instrument allows us to quantify the signal contribution due to limited heat transfer. It's contribution to the photoa- coustic signal is found to be large and strongly size-dependent. Comparisons with heat transfer calculations based on Fourier's heat law (heat conduction) show quantitative agreement with the experiment, and reveal that these cal- culations are indeed applicable to predict photoacoustic signals even for sub- micron particles. The single particle photoacoustic spectrometer also provides a unique exper- imental tool that allows monitoring chemical reactions in a single isolated aerosol particle in real time. A pressing open question is the in uence of the particle size on chemical reactions. This thesis demonstrates for the  rst time that photoreaction rates in aerosol particles are signi cantly higher than in the bulk because of particle size e ects. The enhanced photokinetics in par- ticles are due to size-dependent optical cavity e ects that strongly increase the average light intensity inside the particle. Modelled photoreaction rates in atmospheric aerosol particles show that these cavity e ects can accelerate photoreactions by up to an order of magnitude.},
  school = {2019},
  file = {/Users/massimilianoro/Zotero/storage/YMZL42Q3/Cremer - Photoacoustic spectroscopy of single optically tra.pdf}
}

@article{cremer_photoacoustics_2016,
  title = {Photoacoustics of Single Laser-Trapped Nanodroplets for the Direct Observation of Nanofocusing in Aerosol Photokinetics},
  author = {Cremer, Johannes W. and Thaler, Klemens M. and Haisch, Christoph and Signorell, Ruth},
  year = {2016},
  month = mar,
  journal = {Nat Commun},
  volume = {7},
  number = {1},
  pages = {10941},
  issn = {2041-1723},
  doi = {10.1038/ncomms10941},
  urldate = {2023-12-01},
  abstract = {Abstract             Photochemistry taking place in atmospheric aerosol droplets has a significant impact on the Earth's climate. Nanofocusing of electromagnetic radiation inside aerosols plays a crucial role in their absorption behaviour, since the radiation flux inside the droplet strongly affects the activation rate of photochemically active species. However, size-dependent nanofocusing effects in the photokinetics of small aerosols have escaped direct observation due to the inability to measure absorption signatures from single droplets. Here we show that photoacoustic measurements on optically trapped single nanodroplets provide a direct, broadly applicable method to measure absorption with attolitre sensitivity. We demonstrate for a model aerosol that the photolysis is accelerated by an order of magnitude in the sub-micron to micron size range, compared with larger droplets. The versatility of our technique promises broad applicability to absorption studies of aerosol particles, such as atmospheric aerosols where quantitative photokinetic data are critical for climate predictions.},
  langid = {english},
  file = {/Users/massimilianoro/Zotero/storage/PFE6HG24/Cremer et al. - 2016 - Photoacoustics of single laser-trapped nanodroplet.pdf}
}

