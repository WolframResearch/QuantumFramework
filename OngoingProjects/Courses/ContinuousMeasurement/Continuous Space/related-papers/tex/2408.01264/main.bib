@phdthesis{diveky_photothermal_2022,
  title = {Photothermal {{Single-Particle Spectroscopy}} -- {{Water Transport Across}} the {{Air-Liquid Interface}} of {{Organic Aerosol Droplets}}},
  author = {Diveky, Matus},
  year = {2022},
  abstract = {The mass accommodation coefficient ({$\alpha$}M) describes the probability of a gas-phase molecule being absorbed by a surface upon their collision. Mass accommodation coefficients influence the mass transport of species across an interface between the gas and condensed phases. They are important in number of applications, such as climate modelling or pharmaceutical drug delivery to the lungs. Despite their relevance, there are numerous experimental challenges associated with measuring reliable values of mass accommodation coefficients. We designed and implemented a new experimental technique called Photothermal Single-Particle Spectroscopy (PSPS) that allows us to retrieve mass accommoda- tion coefficients from three simultaneous independent measurements (photoacous- tic amplitude and phase, and modulated Mie scattering). PSPS operates close to equilibrium, which is necessary for the retrieval of accurate {$\alpha$}M values. We performed all our measurements on single particles of specific sizes in the sub- micrometre to micrometre range. In stark contrast to measurements on aerosol ensembles, the single-particle nature enables us to assess the mass transport from fully characterised droplets. We induced the mass transport between the gas and particle phases by shining an intensity-modulated excitation laser onto a trapped droplet. The absorption of this laser induces periodic heat and mass flux from the droplet, which can be measured using photoacoustic spectroscopy or elastic light scattering techniques. v  Photoacoustic spectroscopy is highly sensitive absorption spectroscopy technique that is routinely used to study aerosol droplets both in the field and laboratories. Photoacoustic measurements are influenced by elevated levels of relative humidity due to the presence of mass flux between the gas and particle phases. Using our single-particle approach, we analysed the contribution of the mass flux to the pho- toacoustic signal. Our data helped to resolve a dispute in the literature regarding the influence of elevated relative humidity on the photoacoustic signal. The major goal of this thesis was the retrieval of mass accommodation coeffi- cients of gas-phase water on miscible organic droplets. We selected tetraethylene glycol (TEG) as a model system for miscible organics. The temperature depen- dence of {$\alpha$}M as well as its dependence on water concentration inside the droplet were investigated. We found a pronounced inverse temperature dependence of the mass accommodation coefficient with values dropping from {$\sim$} 0.12 to {$\sim$} 0.01 when the temperature of the droplet increased from 296 K to 308 K, respectively. Furthermore, we also found that the mass accommodation coefficient of water on TEG increases by a factor of eight when the mole fraction of water inside the droplet increases from 0.5 to 0.85. For mole fractions of water less than 0.5, the mass accommodation coefficient is essentially independent of the composition of the droplet. The assessment of such temperature- and concentration- dependent trends of the mass accommodation coefficient is of paramount importance for mod- elling cloud formation due to the abundance of water vapour and organic aerosols in the Earth's atmosphere as well as due to strong temperature variations with altitude in the troposphere.},
  school = {ETH Zurich},
  file = {/Users/massimilianoro/Zotero/storage/SWL8JBH2/Diveky - 2022 - Photothermal Single-Particle Spectroscopy – Water .pdf}
}

