@article{kelly_electromagnetic_nodate,
  title = {Electromagnetic Levitation Using the Fringing Fields of a Microwave Cavity},
  author = {Kelly, M B and Sangster, A J},
  abstract = {Levitation of a rotor within an electrostatically driven micromotor has been proposed as a method of overcoming the relatively large frictional resistance caused by conlactfriction. A novel arrangement in which the rotor is levitated by embedding it within the fringing fields of a pair of microwave cavities Is described. The nature of the levitating system is a dynamic one, and requires no feedback as all movements by the levitated element are selfcorrecting until equilibrium is achieved. Although this means the system is relative(v simple, it also means that analysis of the levitation process is complex, and stability predictions are problematic. For this reason, as well as experimental ana(ysis of the system, a simulation of the cavity geometry using an EM finite element modelling package (HFSS) is used. HFSS allows ana(vsis of the levitating fields, and gives a thorough understanding of the fields and energies generated and optimum equilibrium conditions. Two re-entrant cavities have been modelled using the package. and the element to be levitated has been added. Energies and field strengths have been calculated and optimum component dimenSions selected. The experimental set-up is outlined, along with the eqUivalent geometry generated in HFSS, and results obtainedfrom both approaches are discussed.},
  langid = {english},
  file = {/Users/massimilianoro/Zotero/storage/FYSAAWCW/Kelly and Sangster - Electromagnetic levitation using the fringing fiel.pdf}
}

