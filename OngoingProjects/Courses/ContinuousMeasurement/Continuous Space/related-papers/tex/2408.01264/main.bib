@article{rademacher_quantum_2020,
  title = {Quantum Sensing with Nanoparticles for Gravimetry: When Bigger Is Better},
  shorttitle = {Quantum Sensing with Nanoparticles for Gravimetry},
  author = {Rademacher, Markus and Millen, James and Li, Ying Lia},
  year = {2020},
