  primaryclass = {cond-mat, physics:physics, physics:quant-ph},
  urldate = {2021-10-08},
  abstract = {Nanodiamonds containing negatively charged nitrogen vacancy centers (\$\{{\textbackslash}text\{NV\}\}{\textasciicircum}\{-\}\$) have been proposed as a platform to generate macroscopic spatial superpositions. Requirements for this include obtaining nanodiamonds containing \$\{{\textbackslash}text\{NV\}\}{\textasciicircum}\{-\}\$ with long spin coherence times, which necessitates formulating a dynamical decoupling strategy in which the regular spin flips do not cancel the growth of the superposition through the Stern-Gerlach effect in an inhomogeneous magnetic field. Here, we first show that the electron spin coherence times of \$\{{\textbackslash}text\{NV\}\}{\textasciicircum}\{-\}\$ in natural abundance \$\{\}{\textasciicircum}\{13\}{\textbackslash}text\{C\}\$ nanodiamonds produced by \$\{{\textbackslash}text\{Si\}\}\_\{3\}\{{\textbackslash}text\{N\}\}\_\{4\}\$ ball milling can exceed \$400 {\textbackslash}:{\textbackslash}mu{\textbackslash}text\{s\}\$ with dynamical decoupling. We then propose a scheme to place a similarly-sized \$250 {\textbackslash}text\{-nm\}\$-diameter diamond in a superposition with spatial separation of over \$250 {\textbackslash}: {\textbackslash}text\{nm\}\$, while incorporating dynamical decoupling. We achieve this by letting a diamond fall for \$2.4 {\textbackslash}:{\textbackslash}text\{m\}\$ through a magnetic structure, including \$1.13 {\textbackslash}:{\textbackslash}text\{m\}\$ in an inhomogeneous region generated by magnetic teeth.},
  archiveprefix = {arXiv},
  keywords = {Condensed Matter - Mesoscale and Nanoscale Physics,Physics - Optics,Quantum Physics},
