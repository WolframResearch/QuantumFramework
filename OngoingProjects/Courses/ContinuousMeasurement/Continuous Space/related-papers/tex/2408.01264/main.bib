@phdthesis{mathiassen_characterising_2019,
  title = {Characterising and Modelling Thermal Substrate Noise for a Membrane in the Middle Optomechanical Cavity},
  author = {Mathiassen, J. B.},
  year = {2019},
  address = {Copenhagen},
  abstract = {In our research group, QUANTOP, we investigate quantum effects of light-matter interaction. One of our interests is in the field of optomechanics where a vibra- tional mode on a dielectric, sub-wavelength-thick membrane suspended inside an optical Fabry-Perot cavity is coupled to the light via the radiation pressure force. In this thesis, we make efforts to address an experimental challenge that has proven detrimental to many of our experiments: The thermal noise from the cavity mirror substrates. When the thermally driven mechanical resonances of the mirrors coincide spectrally with the mechanical frequency of the membrane, it inhibits optomechanical cooling, and prevents optical readout of the mechanical membrane mode. We here perform experimental characterisation and numerical modelling of mirror noise with the goal of designing mirrors without resonances at the me- chanical frequency of our membranes, {$\sim$}1.4 MHz. The numerical model simulates the mirror noise for a free mass, and therefore neglects the effect of mechanical coupling between the mirror and the surrounding structure. We systematically study the effect of this coupling by comparing the free mass simulations to mea- surements of mirror noise for varied clamping conditions. To this end, we have constructed a homodyne interferometer around the cavity, which allows the me- chanical spectrum to be measured as fluctuations in the phase quadrature of the light transmitted through the cavity. Given certain clamping conditions, we find reasonable agreement between the free mass simulations and the measurements. Using the free mass simulations, we find that circular mirrors with a diameter of 5.2 mm, and 1 mm center thickness, show no resonant mechanical peaks between 1.3 MHz and 1.5 MHz. This offers a significant improvement over the mirrors cur- rently used in our experiments.},
  school = {University of Copenhagen}
}

@phdthesis{mattana_ground_2024,
  title = {{{GROUND STATE COOLING AND FREE FALL EVOLUTIONS WITH LEVITATED NANOPARTICLES}}},
  author = {Mattana, M. Luisa},
  year = {2024},
  abstract = {R ecent experimental breakthroughs [1--4] have brought levitated optome- chanics under the limelight as a compelling candidate for probing the laws of Nature at the interface between classical and quantum mechanics. Particularly ambitious proposals envision the use of massive microparticles for the preparation of large delocalized states, on scales comparable to the particles' size [5]. The use of a levitated system, relying on the engineering of electromagnetic fields for the confinement and control of macroscopic objects in vacuum, is promising in all of those protocols that require highly tunable confining potentials, and low coupling to the surrounding environment [6]. With this work, we address two fundamental requirements for the realization of delocalized states with large objects, namely how to initialize their center- of-mass modes in a pure state, and how to implement a reliable protocol to generate a coherent delocalization of the wave function. Our main probing tool is a femtogram silica nanoparticle composed by several billions of atoms, levitated in a harmonic optical trap. We first study how to carefully control the center-of-mass motion of an electrically charged 100 nm nanoparticle below single mean phonon occupation. We suppress excess decoherence by working in a cryogenic environment, and rely on a highly efficient interferometric measurement of the particle's motion to create a linear electric feedback to damp the center-of-mass energy to the quantum ground state. We then move to a room-temperature system, and experimentally realize controlled and repeatable free evolutions of a free falling neutral nanoparticle prepared in a thermal state. We engineer a steerable intermittent trap to actuate a release-recapture protocol, completely freeing the nanoparticle from any confining potential for up to 270 {$\mu$}s, and across distances over 350 nm, more than three times its size. We steer the recapture tweezer to overlap its center with the position of the falling nanoparticle at the moment of recapture, and use it to verify a two-hundred-fold expansions of the thermal state's probability distribution in space. Lastly, we discuss the possibility of merging the two experiments together, to achieve a nanometer-scale delocalization of the center-of-mass wave function of a levitated nanoparticle.},
  school = {ETH Zurich},
  file = {/Users/massimilianoro/Zotero/storage/C6QFJEH7/Mattana - 2024 - GROUND STATE COOLING AND FREE FALL EVOLUTIONS WITH.pdf}
}

@article{maurer_quantum_2021,
  title = {Quantum {{Electrodynamics}} with a {{Nonmoving Dielectric Sphere}}: {{Quantizing Lorenz-Mie Scattering}}},
  shorttitle = {Quantum {{Electrodynamics}} with a {{Nonmoving Dielectric Sphere}}},
  author = {Maurer, Patrick and {Gonzalez-Ballestero}, Carlos and {Romero-Isart}, Oriol},
  year = {2021},
  month = jun,
  journal = {arXiv:2106.07975 [physics, physics:quant-ph]},
  eprint = {2106.07975},
  primaryclass = {physics, physics:quant-ph},
  urldate = {2022-01-14},
  abstract = {We quantize the electromagnetic field in the presence of a nonmoving dielectric sphere in vacuum. The sphere is assumed to be lossless, dispersionless, isotropic, and homogeneous. The quantization is performed using normalized eigenmodes as well as plane-wave modes. We specify two useful alternative bases of normalized eigenmodes: spherical eigenmodes and scattering eigenmodes. A canonical transformation between plane-wave modes and normalized eigenmodes is derived. This formalism is employed to study the scattering of a single photon, coherent squeezed light, and two-photon states off a dielectric sphere. In the latter case we calculate the second-order correlation function of the scattered field, thereby unveiling the angular distribution of the Hong-Ou-Mandel interference for a dielectric sphere acting as a three-dimensional beam splitter. Our results are analytically derived for an arbitrary size of the dielectric sphere with a particular emphasis on the small-particle limit. This work sets the theoretical foundation for describing the quantum interaction between light and the motional, rotational and vibrational degrees of freedom of a dielectric sphere.},
  archiveprefix = {arXiv},
  keywords = {Physics - Optics,Quantum Physics},
  file = {/Users/massimilianoro/Zotero/storage/RNG2Q29A/Maurer et al. - 2021 - Quantum Electrodynamics with a Nonmoving Dielectri.pdf;/Users/massimilianoro/Zotero/storage/FW62VYW5/2106.html}
}

