Cell[TextData[{
 "As predicted, the trace holds at ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1449d45f-8382-90b9-3c76-ce193634e283"],
 " and the spectrum stays nonnegative to roundoff. Of those two, positivity \
is the invariant with teeth: the step's very structure, a unit-diagonal \
damping inside a unitary sandwich, preserves the trace even for a \
wrong-signed kernel, while the spectrum would blow up instantly. The energy \
climbs in equal steps over ",
 Cell[BoxData[
  RowBox[{"0", "\[LessEqual]", 
   StyleBox["t", "TI"], "\[LessEqual]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "444f09dd-766a-dba7-6c74-a087031ca98d"],
 ", a straight ramp of slope exactly ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox["\[HBar]", "2"], "/", "2", 
   StyleBox["m", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79e9b65a-67eb-1624-2f96-2804119e7d0e"],
 "; both ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "394df0e2-3b3f-7a44-6f72-e9ccbeca48ae"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d3de1d4-e864-19c9-04c2-f89189116b13"],
 " grow, and the purity falls from ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1adc8861-0296-99d3-4ae3-224bb720eb39"],
 " as the unconditional state mixes. There is no steady state to plot, only a \
ramp:"
}], "Text",ExpressionUUID->"47f3727e-1788-b883-6d81-7438a2220ae9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"tsHL", ",", " ", 
      RowBox[{"Emeas", " ", "/@", " ", "\[Rho]sHL"}]}], "}"}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", " ", 
