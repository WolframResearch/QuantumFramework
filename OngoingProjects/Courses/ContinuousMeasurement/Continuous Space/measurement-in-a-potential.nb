Cell[TextData[{
 "There is the answer, stated plainly: continuous position measurement pushes \
the conditional variance below the zero-point at ",
 StyleBox["any", "TI"],
 " strength ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09816d05-11e9-fb6e-3fbe-856fa79dc9b4"],
 ", and deeper the harder you watch. The conditional state is a pure squeezed \
state, narrower in position than the ground state itself, because the \
measurement is steadily extracting position information."
}], "Text",ExpressionUUID->"35ec423d-cde2-7917-6394-6466eb97487d"],

Cell[TextData[{
 "Now put numbers to it. Fix a strongly-measured regime, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05e0e9bc-56b1-1bf2-339f-00e6634469d8"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46408f14-a324-388b-6e7f-2751d6d68ad1"],
 " (so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40213c85-9219-7c2b-71de-b5ef27ac4771"],
 "), and the vacuum scales that go with it:"
}], "Text",ExpressionUUID->"678faed4-2cca-f411-0db4-479e457cdf7b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Omega]R", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"\[Lambda]H", " ", "=", " ", "2."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalSigma]xZP", " ", "=", " ", 
   RowBox[{"hbar", "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", "mass", " ", "\[Omega]R"}], ")"}]}]}], ";", " ", 
  RowBox[{"\[CapitalSigma]pZP", " ", "=", " ", 
   RowBox[{"hbar", " ", "mass", " ", 
    RowBox[{"\[Omega]R", "/", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"harmNum", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[HBar]", " ", "->", " ", "hbar"}], ",", " ", 
     RowBox[{"m", " ", "->", " ", "mass"}], ",", " ", 
     RowBox[{"\[Omega]", " ", "->", " ", "\[Omega]R"}], ",", " ", 
     RowBox[{"\[Lambda]", " ", "->", " ", "\[Lambda]H"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[75]:=",ExpressionUUID->"3b3cac94-919f-f08d-6ac3-45de202bc2d7"],

Cell[TextData[{
 "Read the steady position variance in units of the vacuum, the \
grid-substituted expression beside its exact closed form at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "634a1270-2707-566e-1149-943a52b23cb4"],
 "; both land on the same number, and both fall below one:"
}], "Text",ExpressionUUID->"571f0194-b08e-3ab4-7d24-98d1c138889e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<grid-substituted\>\"", " ", "->", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[CapitalSigma]xSS", " ", "/.", " ", "harmNum"}], ")"}], "/", 
     "\[CapitalSigma]xZP"}]}], ",", " ", 
   RowBox[{"\"\<exact closed form\>\"", " ", "->", " ", 
    RowBox[{"sqRatio", "[", "4", "]"}]}]}], "|>"}]], "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"79764466-e076-5945-2f0e-5e4391032baf"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"grid-substituted\"\>", "\[Rule]", "0.6248105338438266`"}], ",", 
   RowBox[{"\<\"exact closed form\"\>", "\[Rule]", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     SqrtBox[
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SqrtBox["17"]}], ")"}]}]]}]}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.9949617398558187`*^9},
 CellLabel->"Out[78]=",ExpressionUUID->"6348a478-84b5-4d6a-9521-d912833c93c0"]
}, Open  ]],

Cell[TextData[{
 "It is below ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25f5c72f-3423-741a-538a-de89bdd65f60"],
 ": sharper in position than the ground state. For momentum the opposite \
happens, anti-squeezed above its own zero-point value:"
}], "Text",ExpressionUUID->"6dbbd446-5835-e39a-1b58-ce2059c1b1e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"\[CapitalSigma]pSS", " ", "/.", " ", "harmNum"}], ")"}], "/", 
  "\[CapitalSigma]pZP"}]], "Input",
 CellLabel->"In[79]:=",ExpressionUUID->"6d34e655-b983-17e8-14cb-f81f38367d32"],

Cell[BoxData["2.5761598270366552`"], "Output",
 CellChangeTimes->{3.9949617398600492`*^9},
 CellLabel->"Out[79]=",ExpressionUUID->"7bf78302-d19a-4f16-80a4-189501499b33"]
}, Open  ]],

Cell[TextData[{
 "The position is squeezed well below the zero-point and the momentum is \
anti-squeezed above it: the backaction paid for the position information. \
Notice the momentum pays ",
 StyleBox["more", "TI"],
 " than the reciprocal of the position gain: the two ratios multiply to more \
than one. They must, because the steady state also carries the \
position-momentum correlation ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21714cd0-c04e-e57a-570f-659df1f8cc40"],
 ", and the purity identity verified above rearranges into"
}], "Text",ExpressionUUID->"74ff421b-073b-c6d4-1c85-6445b2cfac3e"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    FractionBox[
     SubsuperscriptBox["\[CapitalSigma]", 
      StyleBox["x", "TI"], 
      StyleBox[
       RowBox[{"s", "s"}], "TI"]], 
     SubsuperscriptBox["\[CapitalSigma]", 
      StyleBox["x", "TI"], 
      StyleBox[
       RowBox[{"z", "p"}], "TI"]]], "\[CenterDot]", 
    FractionBox[
     SubsuperscriptBox["\[CapitalSigma]", 
      StyleBox["p", "TI"], 
      StyleBox[
       RowBox[{"s", "s"}], "TI"]], 
     SubsuperscriptBox["\[CapitalSigma]", 
      StyleBox["p", "TI"], 
      StyleBox[
       RowBox[{"z", "p"}], "TI"]]], "\[ThickSpace]", "=", "\[ThickSpace]", 
    "1", "+", 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"2", 
       StyleBox["C", "TI"], "/", "\[HBar]"}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"3ebc3a74-dd7c-3fa6-6643-bc31d40e858c"],

Cell["Confirm it:", "Text",ExpressionUUID->"7d5c93fe-a057-3a16-2b63-0abbd1e3897c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[CapitalSigma]xSS", "/", 
       RowBox[{"(", 
        RowBox[{"\[HBar]", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "m", " ", "\[Omega]"}], ")"}]}], ")"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"\[CapitalSigma]pSS", "/", 
       RowBox[{"(", 
        RowBox[{"\[HBar]", " ", "m", " ", 
         RowBox[{"\[Omega]", "/", "2"}]}], ")"}]}], ")"}]}], " ", "==", " ", 
    RowBox[{"1", " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"CcSS", "/", "\[HBar]"}]}], ")"}], "^", "2"}]}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Lambda]", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{"\[Omega]", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{"m", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{"\[HBar]", " ", ">", " ", "0"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[80]:=",ExpressionUUID->"487dadd0-5ed6-7873-7802-449a5b634b59"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.994961739995417*^9},
 CellLabel->"Out[80]=",ExpressionUUID->"429c18af-5f89-40ad-9f7b-833f4fbd1225"]
}, Open  ]],

Cell[TextData[{
 "The reciprocal holds exactly only in a frame tilted to match the state's \
own spread; in the ordinary ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69346765-6d1c-e9c9-18cc-7f4f04aebb13"],
 " and ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c22b8c2-70f4-0562-25d1-31ac00816c48"],
 " directions the correlation ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04fec585-b88c-469b-2c85-dcef39392ce1"],
 " is what lifts the product above one, while the state stays exactly pure. \
All of this came from the closed-form moments. Does the grid, which never \
assumes the state stays a neat Gaussian, agree? Set up the trap potential and \
a grid:"
}], "Text",ExpressionUUID->"7aa617d4-4041-969d-2a5d-8e9e71f5fce7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Vharm", " ", "=", " ", 
   RowBox[{
    RowBox[{"0.5", " ", "mass", " ", 
     RowBox[{"\[Omega]R", "^", "2"}], " ", 
     RowBox[{"#", "^", "2"}]}], " ", "&"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gH", " ", "=", " ", 
   RowBox[{"grid", "[", 
    RowBox[{"256", ",", " ", "24."}], "]"}]}], ";", " ", 
  RowBox[{"dtH", " ", "=", " ", "0.002"}], ";", " ", 
  RowBox[{"tfH", " ", "=", " ", "3."}], ";", " ", 
  RowBox[{"ntH", " ", "=", " ", 
   RowBox[{"Round", "[", 
    RowBox[{"tfH", "/", "dtH"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[81]:=",ExpressionUUID->"5e86e5c8-d785-1389-06bd-fc95e23061d3"],

Cell["\<\
Evolve one trajectory from the ground state and take its conditional width \
over the run:\
\>", "Text",ExpressionUUID->"3582ea65-851b-2569-63b1-0c4f2caf8fb3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"runH", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "11", "]"}], ";", " ", 
     RowBox[{
      RowBox[{"trajectory", "[", 
       RowBox[{
       "gH", ",", " ", "Vharm", ",", " ", "\[Lambda]H", ",", " ", "dtH", ",", 
        " ", "ntH"}], "]"}], "[", 
      RowBox[{"gaussian", "[", 
       RowBox[{"gH", ",", " ", "0.", ",", " ", "0.", ",", " ", 
        RowBox[{"Sqrt", "[", "\[CapitalSigma]xZP", "]"}]}], "]"}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalSigma]xH", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"xVar", "[", 
      RowBox[{"gH", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "runH"}]}], ";"}]}], "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"5e81d752-d9a7-cf7a-06be-cf1fd8539240"],

Cell["\<\
Plot it in units of the vacuum, against the closed-form Riccati value (red):\
\>", "Text",ExpressionUUID->"6dc17641-57cc-3497-1bff-682b627e9efd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"\[CapitalSigma]xH", "/", "\[CapitalSigma]xZP"}], ",", " ", 
   RowBox[{"DataRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "tfH"}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Dashed", ",", " ", "Gray", ",", " ", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"tfH", ",", " ", "1"}], "}"}]}], "}"}], "]"}]}], "}"}], ",",
       "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"Dashed", ",", " ", "Red", ",", " ", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\[CapitalSigma]xSS", " ", "/.", " ", "harmNum"}], 
               ")"}], "/", "\[CapitalSigma]xZP"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"tfH", ",", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\[CapitalSigma]xSS", " ", "/.", " ", "harmNum"}], 
               ")"}], "/", "\[CapitalSigma]xZP"}]}], "}"}]}], "}"}], "]"}]}], 
       "}"}]}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time t\>\"", ",", 
      " ", "\"\<\[CapitalSigma]x / zero-point\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<Measurement squeezes the variance below the zero-point (gray, \
1)\n to the Riccati value (red)\>\""}]}], "]"}]], "Input",
 CellLabel->"In[85]:=",ExpressionUUID->"647a9320-5a37-336f-0c19-0a8a5fc381b5"],

