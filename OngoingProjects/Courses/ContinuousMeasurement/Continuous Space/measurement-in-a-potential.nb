}, Open  ]],

Cell[TextData[{
 "That raw stream is almost pure noise: each reading scatters with standard \
deviation ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    RowBox[{"4", 
     StyleBox["\[Lambda]", "TI"], " ", 
     StyleBox["d", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a87483f-bfa4-2eb6-2abd-62793a51749c"],
 ", far wider than the ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09b26917-59e6-8729-3f41-81515f90ea73"],
 " lobe separation, so no single outcome names the lobe. The verdict lives \
only in the slow average that ",
 Cell[BoxData["PleftRec"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "521ad179-838d-ce9b-0239-c923363994e1"],
 " accumulates, which the grid's own final ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "136d7364-bcfb-8461-4113-6b4e348fef4b"],
 " should confirm, ending negative for the left lobe:"
}], "Text",ExpressionUUID->"2b78534b-7a52-d624-5918-4b157fe4bd0e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"xMean", "[", 
  RowBox[{"gC", ",", " ", 
   RowBox[{"Last", "@", "catStates"}]}], "]"}]], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"30c454b2-bdb8-e427-60fc-4dfc3432cf0d"],

Cell[BoxData[
 RowBox[{"-", "7.053177433636674`"}]], "Output",
 CellChangeTimes->{3.994961737517765*^9},
 CellLabel->"Out[54]=",ExpressionUUID->"d0198bf9-3cd6-4b1a-8c2f-23d38db85c32"]
}, Open  ]],

Cell[TextData[{
 "So the outcomes say ",
 StyleBox["left lobe", "TI"],
 " and the grid agrees. The road there is the instructive part: the belief \
builds only over many steps, and can even lean the wrong way first. For the \
comparison, first read the exact left-lobe mass the grid state carries at \
each step, which the observer never sees:"
}], "Text",ExpressionUUID->"7cc522fa-6a93-e579-24fa-bba40f27cc43"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PleftGrid", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Total", "@", 
      RowBox[{"Pick", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", "#", "]"}], "^", "2"}], ",", " ", 
        RowBox[{"UnitStep", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"xL", " ", "+", " ", "xR"}], ")"}], "/", "2"}], " ", "-", 
          " ", 
          RowBox[{"gC", "[", "\"\<x\>\"", "]"}]}], "]"}], ",", " ", "1"}], 
       "]"}]}], " ", "&"}], " ", "/@", " ", "catStates"}]}], ";"}]], "Input",
 CellLabel->"In[55]:=",ExpressionUUID->"5b82e386-6ff5-c0ee-09b1-fae009819234"],

Cell[TextData[{
 "Plot the observer's posterior forming over the first many steps, from the \
even prior ",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34a39a2f-b372-ffce-5c50-1388c604c514"],
 ", beside that hidden grid mass:"
}], "Text",ExpressionUUID->"66ca9132-7812-8248-0ec9-097c79a4d092"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{"PleftRec", ",", " ", "0.5"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", " ", ";;", " ", "120"}], "]"}], "]"}], ",", " ", 
     RowBox[{"PleftGrid", "[", 
      RowBox[{"[", 
       RowBox[{"1", " ", ";;", " ", "120"}], "]"}], "]"}]}], "}"}], ",", " ", 
   
   RowBox[{"DataRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "119"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"0.5", ",", " ", "Gray"}], "}"}], "}"}]}], "}"}]}], ",", " ", 
   
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<two-point bet from the outcomes\>\"", ",", 
      " ", "\"\<left-lobe mass on the grid\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<measurement step k\>\"", ",", 
      " ", "\"\<observer's posterior \!\(\*SubscriptBox[\(P\), \
\(left\)]\)\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<The outcomes decide the lobe (here \[RightArrow] 1, the left \
lobe won)\>\""}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9949616991323013`*^9, 3.9949616997654123`*^9}},
 CellLabel->"In[56]:=",ExpressionUUID->"023b1c4a-5b09-a8c9-33d8-96145ebdfa13"],

