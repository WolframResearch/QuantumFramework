Cell["One step is that update:", "Text",ExpressionUUID->"6eee5857-8f9d-bf63-1696-52112a290249"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"filterStep", "[", "dtq_", "]"}], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mx_", ",", " ", "mp_", ",", " ", "\[CapitalSigma]x_", ",", " ", "Cc_", 
       ",", " ", "\[CapitalSigma]p_"}], "}"}], ",", " ", 
     "\[CapitalDelta]Yk_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dWf", " ", "=", " ", 
        RowBox[{"\[CapitalDelta]Yk", " ", "-", " ", 
         RowBox[{"2", " ", 
          RowBox[{"Sqrt", "[", "\[Lambda]H", "]"}], " ", "mx", " ", 
          "dtq"}]}]}], ",", " ", 
       RowBox[{"cov", " ", "=", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[CapitalSigma]x", ",", " ", "Cc", ",", " ", "\[CapitalSigma]p"}], 
          "}"}], " ", "+", " ", 
         RowBox[{"dtq", " ", 
          RowBox[{"covDrift", "[", 
           RowBox[{
           "\[CapitalSigma]x", ",", " ", "Cc", ",", " ", "\[CapitalSigma]p"}],
            "]"}]}]}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mx", " ", "+", " ", 
          RowBox[{
           RowBox[{"mp", "/", "mass"}], " ", "dtq"}], " ", "+", " ", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "\[Lambda]H", "]"}], " ", "\[CapitalSigma]x", 
           " ", "dWf"}]}], ",", " ", 
         RowBox[{"mp", " ", "-", " ", 
          RowBox[{"mass", " ", 
           RowBox[{"\[Omega]R", "^", "2"}], " ", "mx", " ", "dtq"}], " ", "+",
           " ", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "\[Lambda]H", "]"}], " ", "Cc", " ", 
           "dWf"}]}]}], "}"}], ",", " ", "cov"}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[91]:=",ExpressionUUID->"2635f536-2fc9-ab3c-4fca-ed704a7df606"],

Cell[TextData[{
 "Build the record increment ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["Y", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3760e9-4a32-92b2-4acd-79b36fc4e098"],
 " the step consumes from the outcomes:"
}], "Text",ExpressionUUID->"14fe93a8-4ee9-5b9e-3c85-0af26a9c29e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalDelta]Y", " ", "=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Sqrt", "[", "\[Lambda]H", "]"}], " ", "dtH", " ", "recOuts"}]}], 
  ";"}]], "Input",
 CellLabel->"In[92]:=",ExpressionUUID->"11cf5d11-52cc-ddbb-47f5-555b677ea781"],

Cell["\<\
Run the filter along the whole record from the ground state, and keep its \
estimate of the conditional mean:\
\>", "Text",ExpressionUUID->"7ba8138a-66ce-478c-2957-8ad4137b2dd6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mFilter", " ", "=", " ", 
   RowBox[{
    RowBox[{"FoldList", "[", 
     RowBox[{
      RowBox[{"filterStep", "[", "dtH", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
       "0.", ",", " ", "0.", ",", " ", "\[CapitalSigma]xZP", ",", " ", "0.", ",",
         " ", "\[CapitalSigma]pZP"}], "}"}], ",", " ", "\[CapitalDelta]Y"}], 
     "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[93]:=",ExpressionUUID->"35c9e6d4-f3c4-84c1-63f6-ff918676ee2b"],

Cell["\<\
Compare that estimate with the grid's conditional mean, taking the largest \
gap between them as a fraction of the full range that mean covers over the \
run:\
\>", "Text",ExpressionUUID->"6fd66644-13e4-6fa7-15ee-782ea591358d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Max", "@", 
   RowBox[{"Abs", "[", 
    RowBox[{"mFilter", " ", "-", " ", "xGrid"}], "]"}]}], "/", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Max", "@", "xGrid"}], " ", "-", " ", 
    RowBox[{"Min", "@", "xGrid"}]}], ")"}]}]], "Input",
 CellLabel->"In[94]:=",ExpressionUUID->"00abf1cf-696b-3507-30a8-e8a9081f9c6d"],

Cell[BoxData["0.0016535575334043484`"], "Output",
 CellChangeTimes->{3.99496174033077*^9},
 CellLabel->"Out[94]=",ExpressionUUID->"7d78b5cf-9d12-4cd9-85bc-13093dbbdeab"]
}, Open  ]],

Cell["\<\
The gap is a tiny fraction of that range: the small price of finite time \
steps, not a real disagreement between the five numbers and the grid. From \
the noisy signal alone, five numbers recover the conditional mean that the \
full 256-point grid computed. Overlay them:\
\>", "Text",ExpressionUUID->"03dda600-4b0b-c3af-31e2-386a6ebf91f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dtH", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", "ntH"}], "]"}]}], ",", " ", "xGrid"}], "}"}],
       "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dtH", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", "ntH"}], "]"}]}], ",", " ", "mFilter"}], 
       "}"}], "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", 
        RowBox[{"GrayLevel", "[", "0.6", "]"}]}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Red", ",", " ", "Dashed"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<grid (256 amplitudes)\>\"", ",", 
      " ", "\"\<filter (5 numbers)\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time t\>\"", ",", " ", "\"\<position \:27e8x\:27e9\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<Five numbers recover the full-grid conditional mean\>\""}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.994961710439918*^9, 3.994961710992711*^9}},
 CellLabel->"In[95]:=",ExpressionUUID->"4de38b79-ee67-8bee-7b90-23228b13d934"],

