Cell[TextData[{
 "The conditional mean ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e7621e1-2fba-a33a-560d-b8cb4a4c0e00"],
 " comes out not by averaging the noise away but through the filter, which \
carries five numbers: its estimates of the mean position ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15938457-0322-a4d9-43a0-1e11b6d40e23"],
 " and mean momentum ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["p", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f1ed2e3-b722-4b37-2525-cbccc2d7161d"],
 ", and three more, ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52e63e44-9d5c-26a1-029d-b02e14ee8c8b"],
 ", ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e766a94-5ec6-6187-160d-83de5b7333ed"],
 ", and their correlation ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eead67c-41e5-1519-56e9-c82677907c63"],
 ", measuring how uncertain those estimates are. It updates all five at each \
reading, but the two kinds behave differently: the three uncertainty numbers \
follow a rule that never looks at the readings, set only by the trap and the \
measurement rate, so their whole path is fixed in advance and the same in \
every run, while the readings move only the two estimates. In one step all \
five advance by the same Euler-Maruyama update, a drift times ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23a655ec-dad2-e192-515e-4cc9df64b3f8"],
 " plus a gain times the filter's surprise ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["f", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62ef85cc-c62f-39ac-1294-1ca9f3db8bf6"],
 ":"
}], "Text",ExpressionUUID->"7d6c313b-6800-4a9b-2b13-a96509b518e1"],

Cell[BoxData[
 PaneBox[
  RowBox[{"\[CapitalDelta]", "(", GridBox[{
     {
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["x", "TI"], "^"], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]},
     {
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["p", "TI"], "^"], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]},
     {
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["x", "TI"]]},
     {
      StyleBox["C", "TI"]},
     {
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["p", "TI"]]}
    }], ")", "=", "(", GridBox[{
     {
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["p", "TI"], "^"], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1], "/", 
       StyleBox["m", "TI"]}]},
     {
      RowBox[{"-", 
       StyleBox["m", "TI"], 
       SuperscriptBox[
        StyleBox["\[Omega]", "TI"], "2"], 
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["x", "TI"], "^"], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]},
     {
      RowBox[{"2", 
       StyleBox["C", "TI"], "/", 
       StyleBox["m", "TI"], "-", "4", 
       StyleBox["\[Lambda]", "TI"], 
       SubsuperscriptBox["\[CapitalSigma]", 
        StyleBox["x", "TI"], "2"]}]},
     {
      RowBox[{
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["p", "TI"]], "/", 
       StyleBox["m", "TI"], "-", 
       StyleBox["m", "TI"], 
       SuperscriptBox[
        StyleBox["\[Omega]", "TI"], "2"], 
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["x", "TI"]], "-", "4", 
       StyleBox["\[Lambda]", "TI"], 
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["x", "TI"]], 
       StyleBox["C", "TI"]}]},
     {
      RowBox[{"-", "2", 
       StyleBox["m", "TI"], 
       SuperscriptBox[
        StyleBox["\[Omega]", "TI"], "2"], 
       StyleBox["C", "TI"], "+", 
       StyleBox["\[Lambda]", "TI"], 
       SuperscriptBox["\[HBar]", "2"], "-", "4", 
       StyleBox["\[Lambda]", "TI"], 
       SuperscriptBox[
        StyleBox["C", "TI"], "2"]}]}
    }], ")", "\[CapitalDelta]", 
   StyleBox["t", "TI"], "+", "(", GridBox[{
     {
      RowBox[{"2", 
       SqrtBox[
        StyleBox["\[Lambda]", "TI"]], " ", 
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["x", "TI"]]}]},
     {
      RowBox[{"2", 
       SqrtBox[
        StyleBox["\[Lambda]", "TI"]], " ", 
       StyleBox["C", "TI"]}]},
     {"0"},
     {"0"},
     {"0"}
    }], ")", "\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["f", "TI"]]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"75dfb56b-bb47-a02b-23e4-2d353ef3f371"],

Cell["\<\
The gain is nonzero only on the two means, so the readings move them and \
never the spreads. The last three rows of the drift are the covariance block, \
exactly the symbolic Riccati of this Part with the numbers substituted, so \
one definition serves both the algebra and the filter:\
\>", "Text",ExpressionUUID->"57533ce7-69d6-be0e-7d60-b5c108600554"],

Cell[BoxData[
 RowBox[{
  RowBox[{"covDrift", " ", "=", " ", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[CapitalSigma]x", ",", " ", "Cc", ",", " ", "\[CapitalSigma]p"}], 
      "}"}], ",", " ", 
     RowBox[{"Evaluate", "[", 
      RowBox[{"riccati", " ", "/.", " ", "harmNum"}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[90]:=",ExpressionUUID->"27c3fefb-2ee6-8038-4df0-f7a54a90d302"],

Cell[TextData[{
 "The surprise itself, the ",
 StyleBox["innovation", "TI"],
 ", is the newest reading minus what the estimate predicted, and it reduces \
to the outcome and the step alone:"
}], "Text",ExpressionUUID->"60d4995f-bb7f-b80c-10eb-11193e0b0b56"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"\[CapitalDelta]", 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["f", "TI"]], "=", "\[CapitalDelta]", 
    SubscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["k", "TI"]], "-", "2", 
    SqrtBox[
     StyleBox["\[Lambda]", "TI"]], " ", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["x", "TI"], "^"], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], " ", "\[CapitalDelta]", 
    StyleBox["t", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{"\[CapitalDelta]", 
     SubscriptBox[
      StyleBox["Y", "TI"], 
      StyleBox["k", "TI"]]}], "=", 
    RowBox[{
     RowBox[{"2", 
      SqrtBox[
       StyleBox["\[Lambda]", "TI"]], " ", "\[CapitalDelta]", 
      StyleBox["t", "TI"], " ", 
      RowBox[{
       SubscriptBox[
        OverscriptBox[
         StyleBox["x", "TI"], "_"], 
        StyleBox["k", "TI"]], "\[ThickSpace]", "\[DoubleLongRightArrow]", 
       "\[ThickSpace]", "\[CapitalDelta]"}], 
      SubscriptBox[
       StyleBox["W", "TI"], 
       StyleBox["f", "TI"]]}], "=", 
     RowBox[{"2", 
      SqrtBox[
       StyleBox["\[Lambda]", "TI"]], " ", "\[CapitalDelta]", 
      StyleBox["t", "TI"], " ", 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["x", "TI"], "_"], 
         StyleBox["k", "TI"]], "-", 
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        OverscriptBox[
         StyleBox["x", "TI"], "^"], 
        StyleBox["\[RightAngleBracket]",
         SpanMaxSize->1]}], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"64608bbe-760c-8af3-0c1f-22f803bed8d9"],

Cell[TextData[{
 "Substitute that innovation back and every increment is proportional to ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09661063-a2cf-675e-3f1d-8a4cd77a4da4"],
 ": the noise term folds into the drift, the two means picking up the \
measurement gain times the reading's offset ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "_"], 
    StyleBox["k", "TI"]], "-", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5561d787-26b0-8d0a-031e-cee1534ad450"],
 ", the covariances keeping only their deterministic terms,"
}], "Text",ExpressionUUID->"0fea91e8-e80e-a1ed-35e9-08b589b8f337"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"\[CapitalDelta]", "(", GridBox[{
      {
       RowBox[{
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        OverscriptBox[
         StyleBox["x", "TI"], "^"], 
        StyleBox["\[RightAngleBracket]",
         SpanMaxSize->1]}]},
      {
       RowBox[{
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        OverscriptBox[
         StyleBox["p", "TI"], "^"], 
        StyleBox["\[RightAngleBracket]",
         SpanMaxSize->1]}]},
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["x", "TI"]]},
      {
       StyleBox["C", "TI"]},
      {
       SubscriptBox["\[CapitalSigma]", 
        StyleBox["p", "TI"]]}
     }], ")", "=", "(", GridBox[{
      {
       RowBox[{
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        OverscriptBox[
         StyleBox["p", "TI"], "^"], 
        StyleBox["\[RightAngleBracket]",
