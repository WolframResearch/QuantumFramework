 CellLabel->
  "Out[117]=",ExpressionUUID->"bc9ce7b4-8742-4ab4-a9e0-f31591b0ea40"]
}, Open  ]],

Cell[TextData[{
 "Now set this beside Part IV, where the conditional variance froze at a \
squeezed value, and resolve the apparent contradiction. Both statements are \
true because the packet's center never settles: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["x", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["p", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cb4236e-91b2-9328-644b-bb482044fe72"],
 " is an undamped oscillator kicked by the record through the gains ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    StyleBox["\[Lambda]", "TI"]], " ", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "631da35c-735e-7e3b-1122-3b0606eb4501"],
 " and ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    StyleBox["\[Lambda]", "TI"]], " ", 
   StyleBox["C", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44b7daea-ed84-b50e-6c4c-d3b784361c54"],
 " of Part IV, and its excursions grow without bound even as the shape stays \
fixed. The heating lives entirely in that wandering. Once the covariance has \
settled, the It\[OHat] power the kicks feed into the center's energy, ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    RowBox[{"2", 
     StyleBox["\[Lambda]", "TI"]}], 
    StyleBox["m", "TI"]], 
   SuperscriptBox[
    StyleBox["C", "TI"], "2"], "+", "2", 
   StyleBox["m", "TI"], 
   SuperscriptBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   StyleBox["\[Lambda]", "TI"], " ", 
   SubsuperscriptBox["\[CapitalSigma]", 
    StyleBox["x", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39f2334d-24de-3dcb-6f81-ab174d688711"],
 ", is exactly the Lindblad rate:"
}], "Text",ExpressionUUID->"1ec600b7-0050-8550-46fd-99f1b1eaefba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"2", " ", "\[Lambda]", " ", 
      RowBox[{
       RowBox[{"CcSS", "^", "2"}], "/", "m"}]}], " ", "+", " ", 
     RowBox[{"2", " ", "m", " ", 
      RowBox[{"\[Omega]", "^", "2"}], " ", "\[Lambda]", " ", 
      RowBox[{"\[CapitalSigma]xSS", "^", "2"}]}]}], " ", "==", " ", 
    RowBox[{"\[Lambda]", " ", 
     RowBox[{
      RowBox[{"\[HBar]", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "m"}], ")"}]}]}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Lambda]", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{"\[Omega]", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{"m", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{"\[HBar]", " ", ">", " ", "0"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[118]:=",ExpressionUUID->"33bfe66e-cd59-d601-6144-f84be4edbd6b"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.994961742111631*^9},
 CellLabel->
  "Out[118]=",ExpressionUUID->"d49eb687-cad6-4e2c-80cd-7efe556f317d"]
}, Open  ]],

Cell[TextData[{
 "So the division of labor is clean: the width holds the quantum uncertainty \
steady, the center performs the heating. (The free particle obeys the same \
bookkeeping: its steady ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", "\[HBar]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33885b0f-111a-0c54-6188-5369a0af56be"],
 " makes the momentum mean absorb ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox[
    StyleBox["C", "TI"], "2"], "=", 
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox["\[HBar]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c9080a8-67dd-9047-04af-19f21269e2ad"],
 " per unit time, which is the whole ramp of Part III.)"
}], "Text",ExpressionUUID->"2abc9d06-0494-496b-5a43-1560ad211bb1"],

Cell[TextData[{
 "One scope note: the unbounded ramp is a statement about the continuum \
model, and the grid honors it only while the packet stays clear of the box \
edge and the momentum cutoff. Check the headroom on each axis. First the \
largest position squared the box can hold, the ceiling ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43e301a0-76bb-1057-7190-980a034e62bd"],
 " would have to climb toward before the packet feels the box edge:"
}], "Text",ExpressionUUID->"1ae06f2b-7109-3ba5-4a9f-877500bd898f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "@", 
    RowBox[{"gHL", "[", "\"\<x\>\"", "]"}]}], "]"}], "^", "2"}]], "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"0856a555-3f58-6085-386d-3d1fbaed32ef"],

Cell[BoxData["144.`"], "Output",
 CellChangeTimes->{3.994961742125668*^9},
 CellLabel->
  "Out[119]=",ExpressionUUID->"05fefc1b-27ce-4fd7-b86f-f935a3e72614"]
}, Open  ]],

Cell[TextData[{
 "Then the largest momentum squared the grid can hold, the ceiling ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59070895-187c-42ea-0f3c-a1df99091030"],
 " would have to climb toward before the packet reaches the top of the \
momentum ladder:"
}], "Text",ExpressionUUID->"189fe470-6cd8-7cf4-48a4-fe3a056d46de"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "@", 
    RowBox[{"gHL", "[", "\"\<p\>\"", "]"}]}], "]"}], "^", "2"}]], "Input",
 CellLabel->
  "In[120]:=",ExpressionUUID->"04ed2843-d86c-272a-2c92-c22cd91e8a70"],

Cell[BoxData["157.91367041742973`"], "Output",
 CellChangeTimes->{3.9949617421291924`*^9},
 CellLabel->
  "Out[120]=",ExpressionUUID->"339cbd93-d62e-460f-84f5-e04171a022f2"]
}, Open  ]],

Cell["\<\
The tabulated moments sit fifty-fold or more below both bounds across this \
window; run long enough and any finite grid must eventually betray the ramp \
when the packet meets a cutoff. Watch that betrayal happen, on Part III's \
deliberately small free grid run far past its comfort. Run the free master \
equation for many thousands of steps:\
\>", "Text",ExpressionUUID->"29221b72-bc55-8ef4-58d1-933c35e1d4de"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]long", " ", "=", " ", 
   RowBox[{"NestList", "[", 
    RowBox[{
     RowBox[{"lindbladStep", "[", 
      RowBox[{"gS", ",", " ", 
       RowBox[{"0", " ", "&"}], ",", " ", "\[Lambda]R", ",", " ", "0.002"}], 
      "]"}], ",", " ", 
     RowBox[{"projector", "[", "\[Psi]0", "]"}], ",", " ", "8000"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[121]:=",ExpressionUUID->"41172bde-c012-830e-772c-c29bf1a4ee54"],

Cell[TextData[{
 "Plot the grid's momentum variance against the continuum ramp, which keeps \
climbing at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox["\[HBar]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dd84232-0c35-660d-6bf8-647ca5c04d57"],
 " while the grid's momentum ladder tops out:"
}], "Text",ExpressionUUID->"5558c8fc-3d33-9e90-0367-e1a6b4c7e4fa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Re", "@", 
        RowBox[{"Tr", "[", 
         RowBox[{"#", " ", ".", " ", "p2S"}], "]"}]}], " ", "&"}], " ", "/@", 
      " ", "\[Rho]long"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"Re", "[", 
       RowBox[{
        RowBox[{"Conjugate", "[", "\[Psi]0", "]"}], " ", ".", " ", "p2S", " ",
         ".", " ", "\[Psi]0"}], "]"}], " ", "+", " ", 
      RowBox[{"\[Lambda]R", " ", 
       RowBox[{"hbar", "^", "2"}], " ", "0.002", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "8000"}], "]"}]}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{"DataRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "16."}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<grid \:27e8p\.b2\:27e9\>\"", ",", 
      " ", "\"\<continuum ramp\>\""}], "}"}]}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time t\>\"", ",", " ", "\"\<\:27e8p\.b2\:27e9\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<A finite grid betrays the ramp once the packet meets the cutoff\
\>\""}]}], "]"}]], "Input",
 CellLabel->
  "In[122]:=",ExpressionUUID->"53291d47-a111-bd44-02d6-9520d0a507ae"],

