     RowBox[{"0", ",", " ", "All"}], "}"}]}], ",", " ", 
   RowBox[{"Mesh", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time t\>\"", ",", 
      " ", "\"\<unconditional energy E(t)\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<The trapped unconditional state heats linearly: dE/dt = \
\[Lambda]\[HBar]\.b2/2m\>\""}]}], "]"}]], "Input",
 CellChangeTimes->{{3.99496171674006*^9, 3.994961717243536*^9}},
