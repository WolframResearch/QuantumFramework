Cell["\<\
The two ridges compete and one grows while the other fades, with no potential \
in sight.\
\>", "Text",ExpressionUUID->"1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"],

Cell[TextData[{
 "That surface is the simulated conditional density, which no single run of \
an experiment can read out. What an observer holds is the stream of noisy \
outcomes ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["x", "TI"], "_"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],
 ", and from it alone they must infer which lobe won. That inference is a \
running bet between two hypotheses, the left lobe at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["L", "TI"]], "=", "-", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c6bfc6-0792-5005-77fd-36a0b227236f"],
 " against the right at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["R", "TI"]], "=", "+", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62752e4e-571f-d961-120a-c02862aba84b"],
 ", a deliberate coarse-graining that treats each lobe as a point at its \
center and ignores its width and motion. Each outcome has likelihood ",
 Cell[BoxData[
  RowBox[{"\[Proportional]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "2", 
     StyleBox["\[Lambda]", "TI"], " ", 
     StyleBox["d", "TI"], 
     StyleBox["t", "TI"], 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["x", "TI"], "_"], 
         StyleBox["k", "TI"]], "-", 
        SubscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["h", "TI"]]}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],
 " under hypothesis ",
 Cell[BoxData[
  StyleBox["h", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166277e1-e8de-815f-3e12-6eca8968d3a5"],
 ", so the log-odds for left over right accumulate one term at a time: each \
term is ",
 Cell[BoxData[
  RowBox[{"-", "2", 
   StyleBox["\[Lambda]", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ae7a534-7379-468c-3a9c-3d7e060c2cd6"],
 " times ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["x", "TI"], "_"], 
       StyleBox["k", "TI"]], "+", "6"}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], "-", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["x", "TI"], "_"], 
       StyleBox["k", "TI"]], "-", "6"}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34baef30-7963-b757-5c59-077a78171dbd"],
 ", which is exactly ",
 Cell[BoxData[
  RowBox[{"24", " ", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "_"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15ce0314-20ee-2b64-43f5-9b5e509b764e"],
 ", so the increment is simply ",
 Cell[BoxData[
  RowBox[{"-", "48", 
   StyleBox["\[Lambda]", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], " ", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "_"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38a9ac88-4644-6c0e-6856-45d273f13754"],
 ". Once a lobe has won and the readings center on it, the increment's mean \
is ",
 Cell[BoxData[
  RowBox[{"288", 
   StyleBox["\[Lambda]", "TI"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64802aa2-b136-451c-0cbf-c30fc0c32c66"],
 " in the winner's favor, the distinguishability rate ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CapitalDelta]", 
      StyleBox["x", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"],
 " of Part I at lobe separation ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"], "=", "12"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "233ecb8e-17f3-8d32-52c5-e2e8a187d418"],
 ". Rerun the same trajectory and keep both the conditional states and its \
stream of outcomes:"
}], "Text",ExpressionUUID->"7dd949a9-d8cf-50b3-2be7-60f2d97a2299"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"catStates", ",", " ", 
     RowBox[{"{", "catOuts", "}"}]}], "}"}], " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
     RowBox[{"Reap", "[", 
      RowBox[{
       RowBox[{"trajectory", "[", 
        RowBox[{"gC", ",", " ", 
         RowBox[{"0", " ", "&"}], ",", " ", "\[Lambda]C", ",", " ", "dtC", ",",
          " ", "600"}], "]"}], "[", "\[Psi]Cat", "]"}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],

Cell["\<\
Each outcome contributes a log-odds increment, left lobe against right; \
define it:\
\>", "Text",ExpressionUUID->"598f41e5-f1df-a461-0fb5-58ce806b0f4b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"logOdds", "[", "xb_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"-", "2"}], " ", "\[Lambda]C", " ", "dtC", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"xb", " ", "-", " ", "xL"}], ")"}], "^", "2"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"xb", " ", "-", " ", "xR"}], ")"}], "^", "2"}]}], ")"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"1e0f0df5-2071-c96f-4634-a4bf51059bb5"],

Cell["\<\
Accumulate those increments and turn the running total into the posterior \
probability for the left lobe:\
\>", "Text",ExpressionUUID->"7f6e12d5-e3b9-0bb9-2515-8b9e964c5983"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PleftRec", " ", "=", " ", 
   RowBox[{"LogisticSigmoid", "[", 
    RowBox[{"Accumulate", "[", 
     RowBox[{"logOdds", "[", "catOuts", "]"}], "]"}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[52]:=",ExpressionUUID->"41ecc127-3c02-05fa-7793-d881b5b76fc0"],

Cell["\<\
First look at the raw stream the detector logs, the signal buried in noise:\
\>", "Text",ExpressionUUID->"1190ff72-a9fe-60f8-47af-f73fcf8b32c2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"catOuts", ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<measurement step k\>\"", ",", 
      " ", "\"\<outcome \!\(\*OverscriptBox[\(x\), \(_\)]\)\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<The raw outcomes: signal buried in noise\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[53]:=",ExpressionUUID->"19c80315-d7de-7125-4ff7-9b5ee26b400f"],

