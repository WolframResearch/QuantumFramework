  RowBox[{"dtHL", " ", "=", " ", "0.002"}], ";", " ", 
  RowBox[{"p2HL", " ", "=", " ", 
   RowBox[{"p2Op", "[", "gHL", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"x2Mean", "[", 
    RowBox[{"g_", ",", " ", "\[Rho]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"Diagonal", "[", "\[Rho]", "]"}], " ", ".", " ", 
     RowBox[{
      RowBox[{"g", "[", "\"\<x\>\"", "]"}], "^", "2"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Emeas", "[", "\[Rho]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Re", "@", 
      RowBox[{"Tr", "[", 
       RowBox[{"\[Rho]", " ", ".", " ", "p2HL"}], "]"}]}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "mass"}], ")"}]}], " ", "+", " ", 
    RowBox[{"0.5", " ", "mass", " ", 
     RowBox[{"\[Omega]R", "^", "2"}], " ", 
     RowBox[{"x2Mean", "[", 
      RowBox[{"gHL", ",", " ", "\[Rho]"}], "]"}]}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[110]:=",ExpressionUUID->"166d4e5f-4333-9385-3e13-601976c7e1ef"],

Cell["\<\
Now build the run from the ground state and tabulate. Start the density \
matrix from the trap ground state:\
\>", "Text",ExpressionUUID->"1c99ee20-d785-d362-44a6-078de231be48"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0HL", " ", "=", " ", 
   RowBox[{"projector", "[", 
    RowBox[{"gaussian", "[", 
     RowBox[{"gHL", ",", " ", "0.", ",", " ", "0.", ",", " ", 
      RowBox[{"Sqrt", "[", "\[CapitalSigma]xZP", "]"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[113]:=",ExpressionUUID->"60858f89-56d8-6615-10ba-26d3636d4d7f"],

Cell["Choose a handful of times to sample:", "Text",ExpressionUUID->"2e45545e-c429-efe4-567b-4e1bedddb5ce"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tsHL", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0.", ",", " ", "0.5", ",", " ", "1.", ",", " ", "1.5", ",", " ", "2."}], 
    "}"}]}], ";"}]], "Input",
 CellLabel->
  "In[114]:=",ExpressionUUID->"24564246-a2b2-7a9b-4c6e-6423d74748e1"],

Cell[TextData[{
 "Propagate the master equation and snapshot ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "273d1382-afb1-09c0-4ec2-8aefca445b2a"],
 " at each of those times:"
}], "Text",ExpressionUUID->"39c9e52f-ed06-87fb-6ff6-fc8884b0edc1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]sHL", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"stp", " ", "=", " ", 
       RowBox[{"lindbladStep", "[", 
        RowBox[{
        "gHL", ",", " ", "Vharm", ",", " ", "\[Lambda]H", ",", " ", "dtHL"}], 
        "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"FoldList", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Nest", "[", 
         RowBox[{"stp", ",", " ", "#1", ",", " ", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#2", "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
              RowBox[{"#2", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "dtHL"}], 
           "]"}]}], "]"}], " ", "&"}], ",", " ", "\[Rho]0HL", ",", " ", 
       RowBox[{"Partition", "[", 
        RowBox[{"tsHL", ",", " ", "2", ",", " ", "1"}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[115]:=",ExpressionUUID->"46be6341-4be3-06d9-6e46-7b2b6d966c23"],

Cell[TextData[{
 "Tabulate the trace, the smallest eigenvalue of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "352b8971-1d3f-d4c9-6328-213b94cbbe13"],
 " (which stays nonnegative only while ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "227c7e4b-1c68-aac8-5204-70159502f812"],
 " is a genuine physical state, its populations never going negative), the \
energy, both second moments, and the purity at each time:"
}], "Text",ExpressionUUID->"6cd9b5a9-dbed-51da-14e6-2cf2dd982320"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Re", "@", 
        RowBox[{"Tr", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
      "\[Rho]sHL"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{"Re", "@", 
         RowBox[{"Eigenvalues", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
       " ", "\[Rho]sHL"}], ",", " ", 
     RowBox[{"Emeas", " ", "/@", " ", "\[Rho]sHL"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"x2Mean", "[", 
        RowBox[{"gHL", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "\[Rho]sHL"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Re", "@", 
        RowBox[{"Tr", "[", 
         RowBox[{"#", " ", ".", " ", "p2HL"}], "]"}]}], " ", "&"}], " ", "/@",
       " ", "\[Rho]sHL"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Re", "@", 
        RowBox[{"Tr", "[", 
         RowBox[{"#", " ", ".", " ", "#"}], "]"}]}], " ", "&"}], " ", "/@", 
      " ", "\[Rho]sHL"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<tr \[Rho]\>\"", ",", " ", "\"\<min eig\>\"", ",", 
        " ", "\"\<E\>\"", ",", " ", "\"\<\:27e8x\.b2\:27e9\>\"", ",", 
        " ", "\"\<\:27e8p\.b2\:27e9\>\"", ",", " ", "\"\<purity\>\""}], "}"}],
       ",", " ", "tsHL"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[116]:=",ExpressionUUID->"4becebe3-5bfe-fac0-7993-02cd5d88c82a"],

