 CellLabel->"Out[41]=",ExpressionUUID->"6a75de0b-15c4-48b7-9ea8-74643bbd2bd6"]
}, Open  ]],

Cell[TextData[{
 "And the endpoint lands on the prediction to integrator precision, because \
the ramp is exact for this split: the damping flow adds exactly ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox["\[HBar]", "2"], " ", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ee7491f-72c3-8814-669d-61590777db7e"],
 " to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67860241-8011-89c8-0dbd-a42b31a5db12"],
 " per step and the free drift conserves it:"
}], "Text",ExpressionUUID->"1318f44b-7a0d-b86f-4127-ee157fb90ab5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Abs", "[", 
  RowBox[{
   RowBox[{"Re", "@", 
    RowBox[{"Tr", "[", 
     RowBox[{
      RowBox[{"Last", "[", "\[Rho]free", "]"}], " ", ".", " ", "p2S"}], 
     "]"}]}], " ", "-", " ", "predP2"}], "]"}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"221ecbfd-1ed7-d323-5225-e2a79b63be09"],

Cell[BoxData["4.262146191535976`*^-13"], "Output",
 CellChangeTimes->{3.994961737158791*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"5d2bc7fc-f304-4847-85db-287be7314f40"]
}, Open  ]],

Cell[TextData[{
 "The momentum variance rises exactly as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["p", "TI"], "^"], "2"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], "0"], "+", 
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox["\[HBar]", "2"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "287fc527-5526-9e30-5804-dc815cd0e51a"],
 ": position measurement feeds momentum at the constant rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox["\[HBar]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2207e002-80f7-0285-523c-fa6c308250ef"],
 ", the price the uncertainty principle charges for position information. \
That rate is state- and Hamiltonian-independent, so for the free particle, \
whose ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "440467ae-8db5-79b4-6c3c-7e0824404b9e"],
 " commutes with ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["p", "TI"], "^"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141585f4-d1c1-5bbd-3c2a-1cb1e0742987"],
 ", it is the whole story. In a potential it is not: the force couples ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d27d006-86b8-9131-64dc-ca603332e01b"],
 " to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e44340b-ef5c-51d5-667b-ae548ae9233f"],
 " as the packet swings, which is why Part V follows the total energy \
instead. This backaction is the one piece of physics common to every case \
below; we meet it again competing with the trap."
}], "Text",ExpressionUUID->"321034f4-436e-dcec-622f-adbe7618a636"],

Cell[TextData[{
 "As another example, let's consider a delocalized initial state. Take a \
\"cat,\" a superposition of two packets sitting at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "\[PlusMinus]", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1287d3f9-6500-de4e-42bc-caa30cbaa494"],
 ". Set up a fresh grid, a moderate strength, and the two lobe centers:"
}], "Text",ExpressionUUID->"3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gC", " ", "=", " ", 
   RowBox[{"grid", "[", 
    RowBox[{"256", ",", " ", "50."}], "]"}]}], ";", " ", 
  RowBox[{"\[Lambda]C", " ", "=", " ", "0.1"}], ";", " ", 
  RowBox[{"dtC", " ", "=", " ", "0.005"}], ";", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xL", ",", " ", "xR"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "6."}], ",", " ", "6."}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"087f5f2f-6486-1b59-3805-56890d3369a3"],

Cell["\<\
Build the cat as the normalized sum of a left packet and a right packet:\
\>", "Text",ExpressionUUID->"7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]Cat", " ", "=", " ", 
   RowBox[{"Normalize", "[", 
    RowBox[{
     RowBox[{"gaussian", "[", 
      RowBox[{"gC", ",", " ", "xL", ",", " ", "0.", ",", " ", "1."}], "]"}], 
     " ", "+", " ", 
     RowBox[{"gaussian", "[", 
      RowBox[{"gC", ",", " ", "xR", ",", " ", "0.", ",", " ", "1."}], "]"}]}],
     "]"}]}], ";"}]], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],

Cell["Look at its two lobes:", "Text",ExpressionUUID->"13ecd9ee-6506-67bb-4193-d0c80cb34d81"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"\[Psi]Cat", ",", " ", 
   RowBox[{"DataRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"gC", "[", "\"\<x\>\"", "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"gC", "[", "\"\<x\>\"", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", " ", "\"\<\[Psi](x)\>\""}], "}"}]}], ",", " ", 
   
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<A cat state: two packets at x = \[PlusMinus]6\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[45]:=",ExpressionUUID->"6724c974-bdf1-27a5-0edb-e13e3b858d8f"],

