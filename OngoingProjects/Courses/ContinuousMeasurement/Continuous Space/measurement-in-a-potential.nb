Cell["\<\
The grid variance relaxes to the Riccati steady value and sits well below the \
zero-point; the small remaining offset is the same first-order splitting bias \
Part III measured, independent of the grid spacing, and it shrinks with the \
step. The relaxation is the same in every run, because the conditional \
variance obeys a deterministic (noiseless) equation while only the mean is \
driven by the record.\
\>", "Text",ExpressionUUID->"575b10e3-003a-b957-7d78-89cdb1cc0bbd"],

Cell[TextData[{
 "The width plot compared just one number, ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c7345dd-208f-a284-2401-5c87513bf0ee"],
 ". Take the final step of the same run and compare the whole state: its \
position variance ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0121a537-2575-8479-30de-3d714c01ef43"],
 ", its momentum variance ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f325126-465a-e19d-26c2-488073ecb3e7"],
 ", and their correlation ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "739af998-c5c1-31b3-21b9-f0c5ec758399"],
 ", each beside the value the algebra predicted:"
}], "Text",ExpressionUUID->"003becda-d908-4451-31d8-0587d8bd2ebb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Psi]f", " ", "=", " ", 
      RowBox[{"Last", "[", "runH", "]"}]}], ",", " ", "ft\[Psi]", ",", " ", 
     "pm", ",", " ", "sx", ",", " ", "cc", ",", " ", "sp"}], "}"}], ",", "\n",
    "  ", 
   RowBox[{
    RowBox[{"ft\[Psi]", " ", "=", " ", 
     RowBox[{"ft", "[", "\[Psi]f", "]"}]}], ";", "\n", "  ", 
    RowBox[{"pm", " ", "=", " ", 
     RowBox[{
      RowBox[{"gH", "[", "\"\<p\>\"", "]"}], " ", ".", " ", 
      RowBox[{
       RowBox[{"Abs", "[", "ft\[Psi]", "]"}], "^", "2"}]}]}], ";", "\n", "  ", 
    RowBox[{"sx", " ", "=", " ", 
     RowBox[{"xVar", "[", 
      RowBox[{"gH", ",", " ", "\[Psi]f"}], "]"}]}], ";", "\n", "  ", 
    RowBox[{"cc", " ", "=", " ", 
     RowBox[{
      RowBox[{"Re", "[", 
       RowBox[{
        RowBox[{"Conjugate", "[", "\[Psi]f", "]"}], " ", ".", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gH", "[", "\"\<x\>\"", "]"}], " ", 
          RowBox[{"ift", "[", 
           RowBox[{
            RowBox[{"gH", "[", "\"\<p\>\"", "]"}], " ", "ft\[Psi]"}], "]"}]}],
          ")"}]}], "]"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"xMean", "[", 
        RowBox[{"gH", ",", " ", "\[Psi]f"}], "]"}], " ", "pm"}]}]}], ";", 
    "\n", "  ", 
    RowBox[{"sp", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"gH", "[", "\"\<p\>\"", "]"}], "^", "2"}], " ", ".", " ", 
       RowBox[{
        RowBox[{"Abs", "[", "ft\[Psi]", "]"}], "^", "2"}]}], " ", "-", " ", 
      RowBox[{"pm", "^", "2"}]}]}], ";", "\n", "  ", 
    RowBox[{"TableForm", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"sx", ",", " ", 
          RowBox[{"\[CapitalSigma]xSS", " ", "/.", " ", "harmNum"}], ",", " ", 
          RowBox[{"sx", "/", 
           RowBox[{"(", 
            RowBox[{"\[CapitalSigma]xSS", " ", "/.", " ", "harmNum"}], 
            ")"}]}]}], "}"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"cc", ",", " ", 
          RowBox[{"CcSS", " ", "/.", " ", "harmNum"}], ",", " ", 
          RowBox[{"cc", "/", 
           RowBox[{"(", 
            RowBox[{"CcSS", " ", "/.", " ", "harmNum"}], ")"}]}]}], "}"}], ",",
         "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"sp", ",", " ", 
          RowBox[{"\[CapitalSigma]pSS", " ", "/.", " ", "harmNum"}], ",", " ", 
          RowBox[{"sp", "/", 
           RowBox[{"(", 
            RowBox[{"\[CapitalSigma]pSS", " ", "/.", " ", "harmNum"}], 
            ")"}]}]}], "}"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"sx", " ", "sp"}], " ", "-", " ", 
           RowBox[{"cc", "^", "2"}]}], ",", " ", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"hbar", "^", "2"}], "/", "4"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"sx", " ", "sp"}], " ", "-", " ", 
             RowBox[{"cc", "^", "2"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"hbar", "^", "2"}], "/", "4"}], ")"}]}]}], "}"}]}], 
       "}"}], ",", "\n", "   ", 
      RowBox[{"TableHeadings", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          
          RowBox[{"\"\<\[CapitalSigma]x\>\"", ",", " ", "\"\<C\>\"", ",", 
           " ", "\"\<\[CapitalSigma]p\>\"", ",", 
           " ", "\"\<\[CapitalSigma]x \[CapitalSigma]p - C\.b2\>\""}], "}"}], 
         ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<grid\>\"", ",", " ", "\"\<steady\>\"", ",", 
           " ", "\"\<ratio\>\""}], "}"}]}], "}"}]}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[86]:=",ExpressionUUID->"7aeb468a-2cc6-59e2-2ae9-5fd445732bc8"],

