Cell[TextData[{
 "Its initial variance is large, dominated by that ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53412643-5a68-df00-017e-b82d5f02a26a"],
 " lobe separation:"
}], "Text",ExpressionUUID->"696f5b1d-d56b-3a26-1f15-5346dc1f890c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"xVar", "[", 
  RowBox[{"gC", ",", " ", "\[Psi]Cat"}], "]"}]], "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"0eb02373-2484-618c-364f-bb3d4d3133d6"],

Cell[BoxData["36.999999451720726`"], "Output",
 CellChangeTimes->{3.99496173720751*^9},
 CellLabel->"Out[46]=",ExpressionUUID->"8af30b28-5415-4fdf-8343-c960240ad516"]
}, Open  ]],

Cell[TextData[{
 "Now watch the measurement collapse it. Take a moderate strength ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "0.1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37161f66-4600-a3a8-5d2d-974073baf1f2"],
 ", chosen so the two lobes coexist for a visible stretch before one wins \
rather than collapsing in the first few steps, and run one trajectory:"
}], "Text",ExpressionUUID->"2e44757e-c407-f813-567c-6d3bedb3cb79"],

Cell[BoxData[
 RowBox[{
  RowBox[{"statesC", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
     RowBox[{
      RowBox[{"trajectory", "[", 
       RowBox[{"gC", ",", " ", 
        RowBox[{"0", " ", "&"}], ",", " ", "\[Lambda]C", ",", " ", "dtC", ",",
         " ", "600"}], "]"}], "[", "\[Psi]Cat", "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"],

Cell[TextData[{
 "See the collapse as a surface of the conditional density ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["x", "TI"], ",", 
        StyleBox["t", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539b0e4e-9e5a-5525-01b8-a0281bef3c0f"],
 " over position and time. First pick the central band of the grid to plot, \
the window where the packets live:"
}], "Text",ExpressionUUID->"1cd82739-42e3-b7ed-44e7-bf6376971d37"],

Cell[BoxData[
 RowBox[{
  RowBox[{"band", " ", "=", " ", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Position", "[", 
     RowBox[{
      RowBox[{"UnitStep", "[", 
       RowBox[{"10", " ", "-", " ", 
        RowBox[{"Abs", "[", 
         RowBox[{"gC", "[", "\"\<x\>\"", "]"}], "]"}]}], "]"}], ",", " ", 
      "1"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"0971a20b-7913-467e-3f0e-445578a62d44"],

Cell["Then raise the density over position and time:", "Text",ExpressionUUID->"09df342d-d743-5809-3fe4-ae76e2f62b53"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Abs", "[", "statesC", "]"}], "^", "2"}], ")"}], "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"1", " ", ";;", " ", ";;", " ", "6"}], ",", " ", "band"}], 
     "]"}], "]"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", " ", 
   RowBox[{"DataRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"gC", "[", "\"\<x\>\"", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"First", "@", "band"}], ",", " ", 
          RowBox[{"Last", "@", "band"}]}], "}"}], "]"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "3."}], "}"}]}], "}"}]}], ",", "\n", " ", 
   RowBox[{"ColorFunction", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"ColorData", "[", "\"\<DarkRainbow\>\"", "]"}], "[", "#3", 
       "]"}], " ", "&"}], ")"}]}], ",", " ", 
   RowBox[{"Mesh", " ", "->", " ", "None"}], ",", "\n", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", " ", "\"\<t\>\"", ",", 
      " ", "\"\<|\[Psi]|\.b2\>\""}], "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", " ", "\"\<A cat collapses to one packet\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"],

