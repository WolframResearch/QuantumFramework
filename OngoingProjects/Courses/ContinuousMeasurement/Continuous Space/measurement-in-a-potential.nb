Cell[TextData[{
 "The norm sits at ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "604bb87d-3174-a116-1048-32274006f07c"],
 " by construction, every factor in the step being unitary or explicitly \
normalized, so its residual reports only floating-point health:"
}], "Text",ExpressionUUID->"763191a2-6f8b-197a-1fce-080c0a3e6840"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"normError", "[", 
  RowBox[{"Last", "@", "statesF"}], "]"}]], "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"635fdfdb-2856-deda-1164-d68549e0a420"],

Cell[BoxData["0.`"], "Output",
 CellChangeTimes->{3.994961736852585*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"be7f8dc7-9810-4aee-9b09-882e744056f9"]
}, Open  ]],

Cell[TextData[{
 "The checks with content are ",
 Cell[BoxData["edgeMass"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8469dd-bfc7-2a7a-04bb-80873a727940"],
 " and ",
 Cell[BoxData["tailMass"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],
 " from Part II. Take their worst values over the run, one axis at a time. \
First the position leakage: the largest share of probability that ever \
reaches the outer tenth of the box, which stays negligible only while the \
packet never feels the glued seam of the ring."
}], "Text",ExpressionUUID->"3921e4bb-f5e4-3596-68de-fde483969ffc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"edgeMass", "[", 
     RowBox[{"gF", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
   "statesF"}], "]"}]], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"13db9173-5387-1c16-41f8-093d6632677c"],

Cell[BoxData["1.578912895292335`*^-29"], "Output",
 CellChangeTimes->{3.994961736859164*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"c83d0173-2b4d-49bb-9275-105ce27c17ca"]
}, Open  ]],

Cell["\<\
Then the momentum leakage: the largest share that ever reaches the fastest \
tenth of the momenta, which stays negligible only while the packet never \
reaches the top of the momentum ladder.\
\>", "Text",ExpressionUUID->"77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"tailMass", "[", 
     RowBox[{"gF", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
   "statesF"}], "]"}]], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"4289b0c6-8043-1b93-72b6-29a031f669f9"],

Cell[BoxData["7.942924884579693`*^-31"], "Output",
 CellChangeTimes->{3.994961736870268*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"07d821de-32d1-4f11-a7e3-02e59d8b4632"]
}, Open  ]],

Cell[TextData[{
 "Both stay negligible: the packet never learns that the box is a ring or \
that the momentum ladder has a top rung. One bias does hide in the width \
plot: the terminal width sits slightly above the prediction, and it is worth \
splitting into its two parts. The approach to the steady width is a Riccati \
transient that dies at the rate ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    RowBox[{
     StyleBox["\[Lambda]", "TI"], "\[HBar]", "/", 
     StyleBox["m", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],
 ", not quite dead at the plotted time; and the step applies measurement and \
drift in sequence when in truth they share the interval, which shifts the \
discrete steady width by an offset first order in ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4140e475-1e41-1f16-777f-fe3f9bf4627c"],
 ". The width is deterministic here (the free Riccati flow, blind to the \
record), so both parts are cleanly measurable: run to twice the time, killing \
the transient, and halve the step:"
}], "Text",ExpressionUUID->"67f13035-938c-831a-0d8e-aa7f263eee60"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"widthBias", "[", 
    RowBox[{"dtq_", ",", " ", "tf_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "@", 
     RowBox[{"xVar", "[", 
      RowBox[{"gF", ",", " ", 
       RowBox[{"Last", "@", 
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "11", "]"}], ";", "\n", "      ", 
          RowBox[{
           RowBox[{"trajectory", "[", 
            RowBox[{"gF", ",", " ", 
             RowBox[{"0", " ", "&"}], ",", " ", "\[Lambda]R", ",", " ", "dtq",
              ",", " ", 
             RowBox[{"Round", "[", 
              RowBox[{"tf", "/", "dtq"}], "]"}]}], "]"}], "[", 
           RowBox[{"gaussian", "[", 
            RowBox[{"gF", ",", " ", "0.", ",", " ", "0.", ",", " ", "2."}], 
            "]"}], "]"}]}], "]"}]}]}], "]"}]}], " ", "-", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"hbar", "/", 
       RowBox[{"(", 
        RowBox[{"4", " ", "\[Lambda]R", " ", "mass"}], ")"}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"1", "/", "4"}], ")"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"16b44e14-0404-e868-3e4c-605eadb6bab2"],

Cell["\<\
The offset is first order in the step, so halving the step should roughly \
halve it: the offset at the full step divided by the offset at the half step \
should come out near two.\
\>", "Text",ExpressionUUID->"70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"widthBias", "[", 
   RowBox[{"dt", ",", " ", "6."}], "]"}], "/", 
  RowBox[{"widthBias", "[", 
   RowBox[{
    RowBox[{"dt", "/", "2"}], ",", " ", "6."}], "]"}]}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"7e10bd94-ae42-3b4d-262f-34d1cbf48997"],

Cell[BoxData["1.9967557920278187`"], "Output",
 CellChangeTimes->{3.9949617370297832`*^9},
 CellLabel->"Out[29]=",ExpressionUUID->"7a0cec7e-78a6-4ffd-8b53-1712b23034f1"]
}, Open  ]],

Cell["\<\
The surviving offset halves with the step: pure splitting bias, first order \
exactly as Part II promised, and none of it physics.\
\>", "Text",ExpressionUUID->"013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],

Cell["\<\
At unit detection efficiency the conditional state stays pure, which is what \
lets us carry it as a single state vector; the state only becomes mixed when \
we average over the noise, which is the master equation, coming next.\
\>", "Text",ExpressionUUID->"4b734859-75e7-efa6-7901-62030393b58c"],

Cell[TextData[{
 "To average, we need the unconditional state as a density matrix ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ae31c17-eefa-a706-7a90-96508a8c0a6c"],
 ". Discarding the record and averaging the conditional states over the \
Wiener noise gives the Lindblad master equation, which integrates by the same \
operator split: the measurement dissipator damps each element ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox[
    RowBox[{"i", "j"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00844d77-2817-3ec6-30bc-653149a3842c"],
 " by the factor ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    FractionBox[
     StyleBox["\[Lambda]", "TI"], "2"], 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["i", "TI"]], "-", 
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["j", "TI"]]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20b97f64-b973-0c8a-5047-774e380656d0"],
 ", and the Hamiltonian acts as ",
 Cell[BoxData["evolveStep"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04469009-6b02-dcc3-2c7d-0a530eb4a629"],
 " turned into a matrix. Define the damping factor first:"
}], "Text",ExpressionUUID->"4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"decohereMat", "[", 
    RowBox[{"g_", ",", " ", "\[Lambda]_", ",", " ", "dt_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"\[Lambda]", "/", "2"}], ")"}]}], " ", 
     RowBox[{
      RowBox[{"Outer", "[", 
       RowBox[{"Subtract", ",", " ", 
        RowBox[{"g", "[", "\"\<x\>\"", "]"}], ",", " ", 
        RowBox[{"g", "[", "\"\<x\>\"", "]"}]}], "]"}], "^", "2"}], " ", 
     "dt"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"5547dfb6-0e84-e145-037c-d6f0ab36b3af"],

Cell[TextData[{
 "Turn ",
 Cell[BoxData["evolveStep"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12b61bfc-9cd7-eca9-424d-92a61563b6f3"],
 " into a matrix by applying it to each basis vector, materializing the very \
map the trajectories run so that conditional and unconditional dynamics share \
one drift by construction, and assemble one master-equation step in the same \
symmetric pattern as the wavefunction step, half the damping on each side of \
the unitary:"
}], "Text",ExpressionUUID->"451364b5-819d-fb99-7321-7dff3029c9e3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"uniMat", "[", 
    RowBox[{"g_", ",", " ", "Vfun_", ",", " ", "dt_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{
     RowBox[{"evolveStep", "[", 
      RowBox[{"g", ",", " ", "Vfun", ",", " ", "dt"}], "]"}], " ", "/@", " ", 
     
     RowBox[{"IdentityMatrix", "[", 
      RowBox[{"g", "[", "\"\<n\>\"", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lindbladStep", "[", 
    RowBox[{
    "g_", ",", " ", "Vfun_", ",", " ", "\[Lambda]_", ",", " ", "dt_"}], "]"}],
    " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u", " ", "=", " ", 
        RowBox[{"uniMat", "[", 
         RowBox[{"g", ",", " ", "Vfun", ",", " ", "dt"}], "]"}]}], ",", " ", 
       RowBox[{"dec", " ", "=", " ", 
        RowBox[{"decohereMat", "[", 
         RowBox[{"g", ",", " ", "\[Lambda]", ",", " ", 
          RowBox[{"dt", "/", "2"}]}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Function", "[", 
      RowBox[{"\[Rho]", ",", " ", 
       RowBox[{"dec", " ", 
        RowBox[{"(", 
         RowBox[{"u", " ", ".", " ", 
          RowBox[{"(", 
           RowBox[{"dec", " ", "\[Rho]"}], ")"}], " ", ".", " ", 
          RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], ")"}]}]}], "]"}]}],
     "]"}]}], ";"}]}], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"13b49e24-0fb7-4441-414b-178eaa422eab"],

Cell[TextData[{
 "Each factor is exact, the damping being the dissipator's own flow and the \
unitary the Strang drift, so the symmetric sandwich keeps the deterministic \
step second order in ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],
 "."
}], "Text",ExpressionUUID->"089aa42d-ce49-3603-38b9-3e76ebfd9d69"],

Cell[TextData[{
 "Position observables read straight off ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48fccab3-b886-a0f7-7883-e3fd3930f2dd"],
 "'s diagonal, but momentum observables like ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cdaad60-2181-5e26-34f9-454a5034250c"],
 " need the momentum-squared operator as a matrix, built spectrally as ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["F", "TI"], "\[Dagger]"], " ", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["F", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "542cff75-84e0-b601-7dd3-f73f2c9a1d6b"],
 " with ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00dd9d4d-f7ec-565f-30e2-151681993ca5"],
 " the transform matrix:"
}], "Text",ExpressionUUID->"0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"p2Op", "[", "g_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fm", " ", "=", " ", 
       RowBox[{"FourierMatrix", "[", 
        RowBox[{
         RowBox[{"g", "[", "\"\<n\>\"", "]"}], ",", " ", 
         RowBox[{"FourierParameters", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", 
            RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"ConjugateTranspose", "[", "fm", "]"}], " ", ".", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"g", "[", "\"\<p\>\"", "]"}], "^", "2"}], " ", "fm"}], 
       ")"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],

Cell[TextData[{
 "The same momentum diagonal also gives the momentum-tail leakage of a \
density matrix, the ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "333832e2-8bec-4128-62c7-abcc2d991072"],
 "-version of ",
 Cell[BoxData["tailMass"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78cf51d6-d7cd-4672-28f5-4893e2782d58"],
 ": it feeds the shared helper the momentum-basis diagonal ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["p", "TI"]},
    "Bra"], 
   StyleBox["\[Rho]", "TI"], 
   TemplateBox[{
     StyleBox["p", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],
 " in place of ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["p", "TI"]]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "710db4a8-d877-0db2-2732-2df5d9025798"],
 ". We define it here, beside the other matrix tools, and use it in Part V \
once the master equation is run far past the grid's comfort:"
}], "Text",ExpressionUUID->"71e12f72-3ad4-a92f-279e-c73cbf66f875"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]pTail", "[", 
    RowBox[{"g_", ",", " ", "\[Rho]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fm", " ", "=", " ", 
       RowBox[{"FourierMatrix", "[", 
        RowBox[{
         RowBox[{"g", "[", "\"\<n\>\"", "]"}], ",", " ", 
         RowBox[{"FourierParameters", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", 
            RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"outerTenth", "[", 
      RowBox[{
       RowBox[{"g", "[", "\"\<p\>\"", "]"}], ",", " ", 
       RowBox[{"Re", "@", 
        RowBox[{"Diagonal", "[", 
         RowBox[{"fm", " ", ".", " ", "\[Rho]", " ", ".", " ", 
          RowBox[{"ConjugateTranspose", "[", "fm", "]"}]}], "]"}]}]}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"06ea8612-dd18-b4f0-2ee9-185fd4921eda"],

Cell["\<\
Now the second known fact, the measurement backaction. Work on a small \
32-point grid over a box of width 16:\
\>", "Text",ExpressionUUID->"0b02f270-2101-5c3d-3931-f43a50b42707"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gS", " ", "=", " ", 
   RowBox[{"grid", "[", 
    RowBox[{"32", ",", " ", "16."}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],

Cell["Use a fine step and a short total time:", "Text",ExpressionUUID->"669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dtS", " ", "=", " ", "0.0005"}], ";", " ", 
  RowBox[{"tf", " ", "=", " ", "0.4"}], ";", " ", 
  RowBox[{"ntS", " ", "=", " ", 
   RowBox[{"Round", "[", 
    RowBox[{"tf", "/", "dtS"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],

Cell["Start from a single narrow packet at the origin:", "Text",ExpressionUUID->"66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]0", " ", "=", " ", 
   RowBox[{"gaussian", "[", 
    RowBox[{"gS", ",", " ", "0.", ",", " ", "0.", ",", " ", "1."}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"3e73fafe-05d0-7203-6600-f3b8ac654169"],

Cell[TextData[{
 "Propagate the free master equation from that packet, carried now as a \
density matrix ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],
 ":"
}], "Text",ExpressionUUID->"12c044c4-b778-74e1-42f0-5da1c20d5ecb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]free", " ", "=", " ", 
   RowBox[{"NestList", "[", 
    RowBox[{
     RowBox[{"lindbladStep", "[", 
      RowBox[{"gS", ",", " ", 
       RowBox[{"0", " ", "&"}], ",", " ", "\[Lambda]R", ",", " ", "dtS"}], 
      "]"}], ",", " ", 
     RowBox[{"projector", "[", "\[Psi]0", "]"}], ",", " ", "ntS"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[38]:=",ExpressionUUID->"3d9aa029-60a8-273a-6bb9-3a7311428a00"],

Cell[TextData[{
 "Calculate ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["p", "TI"], "^"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64adc082-4122-deff-0c52-d9ec70d4a4c5"],
 ":"
}], "Text",ExpressionUUID->"7e451771-8a55-ceec-267a-8f3b2fe19436"],

Cell[BoxData[
 RowBox[{
  RowBox[{"p2S", " ", "=", " ", 
   RowBox[{"p2Op", "[", "gS", "]"}]}], ";"}]], "Input",
 CellLabel->"In[39]:=",ExpressionUUID->"4670f053-f537-0b3f-6e0f-ea1cfcc25605"],

Cell[TextData[{
 "The prediction is the initial momentum variance plus the steady gain, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["p", "TI"], "^"], "2"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], "0"], "+", 
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox["\[HBar]", "2"], 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["f", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "330aabc0-bdd5-22a3-6109-42aa34607089"],
 ":"
}], "Text",ExpressionUUID->"38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"predP2", " ", "=", " ", 
   RowBox[{
    RowBox[{"Re", "[", 
     RowBox[{
      RowBox[{"Conjugate", "[", "\[Psi]0", "]"}], " ", ".", " ", "p2S", " ", ".",
       " ", "\[Psi]0"}], "]"}], " ", "+", " ", 
    RowBox[{"\[Lambda]R", " ", 
     RowBox[{"hbar", "^", "2"}], " ", "tf"}]}]}], ";"}]], "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"70d705b8-410a-1477-20ec-9ce270bf7f5d"],

Cell[TextData[{
 "Plot the momentum variance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "737c509e-bc52-eefb-2104-49d835e4b4c1"],
 " climbing to that value (dashed):"
}], "Text",ExpressionUUID->"01a44b6b-c85f-9e0e-375c-6334e9ebe554"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Re", "@", 
      RowBox[{"Tr", "[", 
       RowBox[{"#", " ", ".", " ", "p2S"}], "]"}]}], " ", "&"}], " ", "/@", 
    " ", "\[Rho]free"}], ",", " ", 
   RowBox[{"DataRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "tf"}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time t\>\"", ",", " ", "\"\<\:27e8p\.b2\:27e9\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<Measurement heats momentum linearly (predicted value \
dashed)\>\""}], ",", "\n", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Dashed", ",", " ", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "predP2"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"tf", ",", " ", "predP2"}], "}"}]}], "}"}], "]"}]}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],

