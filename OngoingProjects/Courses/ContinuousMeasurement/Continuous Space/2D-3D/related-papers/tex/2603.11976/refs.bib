	volume = {6452},
	url = {https://www.spiedigitallibrary.org/conference-proceedings-of-spie/6452/64520J/How-to-simulate-the-whispering-gallery-modes-of-dielectric-microresonators/10.1117/12.714954.full},
	doi = {10.1117/12.714954},
	abstract = {It is explained how FEMLAB / COMSOL Multiphysics can be configured to calculate, the frequencies, electromagnetic-field patterns, mode volumes, filling factors, radiation losses ... of the whispering-gallery modes of axisymmetric microresonators. The method exploits COMSOL's ability to accept the definition of solutions to Maxwells equations in so-called 'weak form'. As no transverse approximation is imposed, it remains accurate even for so-called quasi-TM and -TE modes of low, finite azimuthal mode order, as are relevant to applications in non-linear/quantum optics. The method's utility is exemplified by simulating various microresonators in the form of dielectric toroids and disks.},
	urldate = {2024-09-25},
	booktitle = {Laser {Resonators} and {Beam} {Control} {IX}},
	publisher = {SPIE},
	author = {Oxborrow, Mark},
	month = feb,
	year = {2007},
	pages = {146--157},
}

