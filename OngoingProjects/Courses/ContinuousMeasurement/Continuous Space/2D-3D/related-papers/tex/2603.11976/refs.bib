@article{hume_high-fidelity_2007,
	title = {High-{Fidelity} {Adaptive} {Qubit} {Detection} through {Repetitive} {Quantum} {Nondemolition} {Measurements}},
	volume = {99},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.99.120502},
