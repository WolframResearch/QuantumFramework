	title = {Millikelvin cooling of an optically trapped microsphere in vacuum},
	volume = {7},
	copyright = {2011 Springer Nature Limited},
	issn = {1745-2481},
	url = {https://www.nature.com/articles/nphys1952},
	doi = {10.1038/nphys1952},
	abstract = {Microscale resonators cooled so that their vibrational motion approaches the quantum limit enable the study of quantum effects in macroscopic systems. An approach that could probe the interface between quantum mechanics and general relativity is now demonstrated by using lasers to suspend a glass microsphere in a vacuum.},
	 
