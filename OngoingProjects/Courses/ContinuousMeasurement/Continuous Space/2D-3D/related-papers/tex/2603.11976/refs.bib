@article{wang_using_2012,
	title = {Using {Interference} for {High} {Fidelity} {Quantum} {State} {Transfer} in {Optomechanics}},
	volume = {108},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.108.153603},
