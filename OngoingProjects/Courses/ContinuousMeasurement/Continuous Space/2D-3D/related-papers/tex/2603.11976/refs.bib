}

@article{moore_searching_2021,
	title = {Searching for new physics using optically levitated sensors},
	volume = {6},
	issn = {2058-9565},
	url = {https://dx.doi.org/10.1088/2058-9565/abcf8a},
	doi = {10.1088/2058-9565/abcf8a},
	abstract = {We describe a variety of searches for new physics beyond the standard model of particle physics which may be enabled in the coming years by the use of optically levitated masses in high vacuum. Such systems are expected to reach force and acceleration sensitivities approaching (and possibly eventually exceeding) the standard quantum limit over the next decade. For new forces or phenomena that couple to mass, high precision sensing using objects with masses in the fg–ng range have significant discovery potential for new physics. Such applications include tests of fundamental force laws, searches for non-neutrality of matter, high-frequency gravitational wave detectors, dark matter searches, and tests of quantum foundations using massive objects.},
	 
	number = {1},
	urldate = {2024-07-09},
	journal = {Quantum Science and Technology},
	author = {Moore, David C. and Geraci, Andrew A.},
	month = jan,
	year = {2021},
	pages = {014008},
}

@article{conangla_extending_2020,
	title = {Extending {Vacuum} {Trapping} to {Absorbing} {Objects} with {Hybrid} {Paul}-{Optical} {Traps}},
	volume = {20},
	issn = {1530-6984},
	url = {https://doi.org/10.1021/acs.nanolett.0c02025},
	doi = {10.1021/acs.nanolett.0c02025},
	abstract = {The levitation of condensed matter in vacuum allows the study of its physical properties under extreme isolation from the environment. It also offers a venue to investigate quantum mechanics with large systems, at the transition between the quantum and classical worlds. In this work, we study a novel hybrid levitation platform that combines a Paul trap with a weak but highly focused laser beam, a configuration that integrates a deep potential with excellent confinement and motion detection. We combine simulations and experiments to demonstrate the potential of this approach to extend vacuum trapping and interrogation to a broader range of nanomaterials, such as absorbing particles. We study the stability and dynamics of different specimens, such as fluorescent dielectric crystals and gold nanorods, and demonstrate stable trapping down to pressures of 1 mbar.},
	number = {8},
	urldate = {2024-07-25},
	journal = {Nano Letters},
	author = {Conangla, Gerard P. and Rica, Raúl A. and Quidant, Romain},
	month = aug,
	year = {2020},
	pages = {6018--6023},
}



@article{magrini_near-field_2018,
	title = {Near-field coupling of a levitated nanoparticle to a photonic crystal cavity},
	volume = {5},
	issn = {2334-2536},
	url = {https://opg.optica.org/optica/abstract.cfm?uri=optica-5-12-1597},
	doi = {10.1364/OPTICA.5.001597},
	abstract = {Quantum control of levitated dielectric particles is an emerging subject in quantum optomechanics. A major challenge is to efficiently measure and manipulate the particle\&\#x2019;s motion at the Heisenberg uncertainty limit. Here we present a nanophotonic interface suited to address this problem. By optically trapping a 150\&\#x00A0;nm silica particle and placing it in the near field of a photonic crystal cavity, we achieve tunable single-photon optomechanical coupling of up to g0/2\&\#x03C0;=9\&\#x2009;\&\#x2009;kHz, three orders of magnitude larger than previously reported for levitated cavity optomechanical systems. Efficient collection and guiding of light through the nanophotonic structure results in a per-photon displacement sensitivity that is increased by two orders of magnitude compared to conventional far-field detection. The demonstrated performance shows a promising route for room temperature quantum optomechanics.},
	
	number = {12},
	urldate = {2023-09-12},
	journal = {Optica},
	author = {Magrini, Lorenzo and Norte, Richard A. and Riedinger, Ralf and Marinković, Igor and Grass, David and Delić, Uroš and Gröblacher, Simon and Hong, Sungkun and Aspelmeyer, Markus},
	month = dec,
	year = {2018},
	keywords = {Optical tweezers, Optomechanics, Photonic crystal cavities, Photons, Power spectral density, Single mode fibers},
	pages = {1597--1602},
}

@article{gonzalez-ballestero_levitodynamics_2021,
	title = {Levitodynamics: {Levitation} and control of microscopic objects in vacuum},
	volume = {374},
	shorttitle = {Levitodynamics},
	url = {https://www.science.org/doi/10.1126/science.abg3027},
	doi = {10.1126/science.abg3027},
	abstract = {The control of levitated nano- and micro-objects in vacuum—which capitalizes on scientific achievements in the fields of atomic physics, control theory, and optomechanics—is of considerable interest. The ability to couple the motion of levitated systems to internal degrees of freedom, as well as to external forces and systems, provides opportunities for science and technology. Attractive research directions, ranging from fundamental quantum physics to commercial sensors, have been unlocked by the many recent experimental achievements, including motional ground-state cooling of an optically levitated nanoparticle. Here we review the status, challenges, and prospects of levitodynamics, the multidisciplinary research area devoted to understanding, controlling, and using levitated nano- and micro-objects in vacuum.},
	number = {6564},
	urldate = {2023-09-15},
	journal = {Science},
	author = {Gonzalez-Ballestero, C. and Aspelmeyer, M. and Novotny, L. and Quidant, R. and Romero-Isart, O.},
