@article{basiri-esfahani_precision_2019,
	title = {Precision ultrasound sensing on a chip},
	volume = {10},
	copyright = {2019 The Author(s)},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-018-08038-4},
	doi = {10.1038/s41467-018-08038-4},
	abstract = {Ultrasound sensors have wide applications across science and technology. However, improved sensitivity is required for both miniaturisation and increased spatial resolution. Here, we introduce cavity optomechanical ultrasound sensing, where dual optical and mechanical resonances enhance the ultrasound signal. We achieve noise equivalent pressures of 8–300 μPa Hz−1/2 at kilohertz to megahertz frequencies in a microscale silicon-chip-based sensor with {\textgreater}120 dB dynamic range. The sensitivity far exceeds similar sensors that use an optical resonance alone and, normalised to the sensing area, surpasses previous air-coupled ultrasound sensors by several orders of magnitude. The noise floor is dominated by collisions from molecules in the gas within which the acoustic wave propagates. This approach to acoustic sensing could find applications ranging from biomedical diagnostics, to autonomous navigation, trace gas sensing, and scientific exploration of the metabolism-induced-vibrations of single cells.},
	
	number = {1},
	urldate = {2024-09-26},
	journal = {Nature Communications},
	author = {Basiri-Esfahani, Sahar and Armin, Ardalan and Forstner, Stefan and Bowen, Warwick P.},
	month = jan,
	year = {2019},
	 not = {Publisher: Nature Publishing Group},
	keywords = {Imaging and sensing, Micro-optics, Optomechanics},
	pages = {132},
}

