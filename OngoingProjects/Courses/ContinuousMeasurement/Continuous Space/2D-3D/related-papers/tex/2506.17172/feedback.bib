@Article{kamba2023nanoscale,
author={Kamba, Mitsuyoshi
and Shimizu, Ryoga
and Aikawa, Kiyotaka},
title={Nanoscale feedback control of six degrees of freedom of a near-sphere},
journal={Nature Communications},
year={2023},
month={Dec},
day={01},
volume={14},
number={1},
pages={7943},
abstract={Manipulating the rotational as well as the translational degrees of freedom of rigid bodies has been a crucial ingredient in diverse areas, from optically controlled micro-robots, navigation, and precision measurements at macroscale to artificial and biological Brownian motors at nanoscale. Here, we demonstrate feedback cooling of all the angular motions of a near-spherical neutral nanoparticle with all the translational motions feedback-cooled to near the ground state. The occupation numbers of the three translational motions are 6{\thinspace}{\textpm}{\thinspace}1, 6{\thinspace}{\textpm}{\thinspace}1, and 0.69{\thinspace}{\textpm}{\thinspace}0.18. A tight, anisotropic optical confinement allows us to clearly observe three angular oscillations and to identify the ratio of two radii to the longest radius with a precision of 0.08 {\%}. We develop a thermometry for three angular oscillations and realize feedback cooling of them to temperatures of lower than 0.03{\thinspace}K by electrically controlling the electric dipole moment of the nanoparticle.},
issn={2041-1723},
doi={10.1038/s41467-023-43745-7},
url={https://doi.org/10.1038/s41467-023-43745-7}
}
