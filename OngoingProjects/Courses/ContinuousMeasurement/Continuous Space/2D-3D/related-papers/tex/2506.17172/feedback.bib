@article{liska2023cold,
author = {Vojt\v{e}ch Li\v{s}ka and Tereza Zem\'{a}nkov\'{a} and Vojt\v{e}ch Svak and Petr J\'{a}kl and Jan Je\v{z}ek and Martin Br\'{a}neck\'{y} and Stephen H. Simpson and Pavel Zem\'{a}nek and Oto Brzobohat\'{y}},
journal = {Optica},
keywords = {CMOS cameras; Gaussian beams; Optical force; Optical trapping; Photonic crystal fibers; Scattering theory},
number = {9},
pages = {1203--1209},
publisher = {Optica Publishing Group},
title = {Cold damping of levitated optically coupled nanoparticles},
volume = {10},
month = {Sep},
year = {2023},
url = {https://opg.optica.org/optica/abstract.cfm?URI=optica-10-9-1203},
doi = {10.1364/OPTICA.496072},
abstract = {Methods for controlling the motion of single particles, optically levitated in vacuum, have developed rapidly in recent years. The technique of cold damping makes use of feedback-controlled, electrostatic forces to increase dissipation without introducing additional thermal fluctuations. This process has been instrumental in the ground-state cooling of individual electrically charged nanoparticles. Here we show that the same method can be applied to a pair of nanoparticles, coupled by optical binding forces. These optical binding forces are about three orders of magnitude stronger than typical Coulombic inter-particle force and result in a coupled motion of both nanoparticles characterized by a pair of normal modes. We demonstrate cold damping of these normal modes, either independently or simultaneously, to sub-Kelvin temperatures at pressures of 5{\texttimes}10{\textminus}3            m            b            a            r. Experimental observations are captured by a theoretical model that we use to survey the parameter space more widely and to quantify the limits imposed by measurement noise and time delays. Our work paves the way for the study of quantum interactions between meso-scale particles and the exploration of multiparticle entanglement in levitated optomechanical systems.},
}
