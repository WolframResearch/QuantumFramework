@article{haroche,
    author={Sayrin, Cl{\'e}ment
    and Dotsenko, Igor
    and Zhou, Xingxing
    and Peaudecerf, Bruno
    and Rybarczyk, Th{\'e}o
    and Gleyzes, S{\'e}bastien
    and Rouchon, Pierre
    and Mirrahimi, Mazyar
    and Amini, Hadis
    and Brune, Michel
    and Raimond, Jean-Michel
    and Haroche, Serge},
    title={Real-time quantum feedback prepares and stabilizes photon number states},
    journal={Nature},
    year={2011},
    day={01},
    volume={477},
    number={7362},
    pages={73-77},
    abstract={Feedback loops are central to most classical control procedures. Generalizing this approach to quantum states is complicated by the fact that sensor measurements of the output cause a random back-action on the system. Serge Haroche and colleagues overcome this problem using weak measurements, demonstrating a real-time, stabilizing quantum feedback scheme. In this system, information about the photon number is obtained from a weak quantum non-demolition measurement of the field state with Rydberg atoms crossing the cavity one by one. This represents a significant step towards the implementation of complex quantum information operations.},
    issn={1476-4687},
    doi={10.1038/nature10376},
}

