	volume = {65},
	issn = {1558-2523},
	url = {https://ieeexplore.ieee.org/abstract/document/8901195},
	doi = {10.1109/TAC.2019.2953457},
	abstract = {This article develops a quantum projection filtering approach to approximating the quantum filter equation based on It{\textbackslash}hat{\textbackslash}rm o stochastic Taylor expansions and quantum information geometric techniques. The proposed approximation scheme is designed so that the truncated Taylor expansion of the difference between the true quantum trajectory, and its approximation on a lower dimensional differential submanifold is minimized, through an orthogonal projection operation in the quantum Fisher metric. In addition, a convenient design for a special class of open quantum systems is formulated. Simulation results from a numerical example demonstrate the approximation capability of the proposed quantum projection filter.},
