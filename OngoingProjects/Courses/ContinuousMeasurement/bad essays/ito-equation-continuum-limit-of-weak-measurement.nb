Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["Kurt",
     FontSlant->"Plain"], "\[NegativeThinSpace]", "(", 
    FractionBox[
     RowBox[{"\[CapitalDelta]", 
      SubscriptBox[
       StyleBox["W", "TI"], 
