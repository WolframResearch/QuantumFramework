Cell[TextData[{
 "The derivation did not assume a Gaussian quantum state. To test that point, \
take a symmetric bimodal Born density, the equal mixture of ",
 Cell[BoxData[
  RowBox[{"\|01d4a9", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", 
     StyleBox["a", "TI"]}], ",", 
    StyleBox["s", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6cb6ec0-c343-4783-9dc5-2abac69485e1"],
 " and ",
 Cell[BoxData[
  RowBox[{"\|01d4a9", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["s", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7564fba2-058c-4ed0-9cdd-f3fce13b34b6"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], ",", 
   RowBox[{
    StyleBox["s", "TI"], ">", "0"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "576c99e5-4e27-45c5-9e31-b4913bbcfa45"],
 ". It has mean zero and variance ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], "+", 
   SuperscriptBox[
    StyleBox["s", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f26d6c9-7cef-4573-b2af-b3868a1b96d1"],
 ", but it is not Gaussian."
}], "Text",ExpressionUUID->"21cc974b-0008-4b35-9bd3-f4e43da733fc"],

Cell[TextData[{
 "The next cell integrates this Born density against the detector response. \
It then verifies the resulting measured-output density, transforms the \
measured reading to ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["k", "TI"]], "/", 
   SqrtBox[
    RowBox[{"\[CapitalDelta]", 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "756ed093-3822-4548-9d4e-fed479d6e31e"],
 ", and computes its variance and excess kurtosis:"
}], "Text",ExpressionUUID->"68af7435-49ca-4b42-ad54-25671921b705"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bimodalAssumptions", " ", "=", " ", 
    RowBox[{"And", "[", "\n", "    ", 
     RowBox[{"assumptions", ",", "\n", "    ", 
      RowBox[{"separation", " ", ">", " ", "0"}], ",", "\n", "    ", 
      RowBox[{"stateWidth", " ", ">", " ", "0"}], ",", "\n", "    ", 
      RowBox[{"Element", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"separation", ",", " ", "stateWidth"}], "}"}], ",", " ", 
        "Reals"}], "]"}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bimodalPositionDistribution", " ", "=", " ", 
    RowBox[{"MixtureDistribution", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", " ", "/", " ", "2"}], ",", " ", 
        RowBox[{"1", " ", "/", " ", "2"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", "\n", "        ", 
       RowBox[{
        RowBox[{"NormalDistribution", "[", 
         RowBox[{
          RowBox[{"-", "separation"}], ",", " ", "stateWidth"}], "]"}], ",", 
        "\n", "        ", 
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"separation", ",", " ", "stateWidth"}], "]"}]}], "\n", 
       "    ", "}"}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bimodalReadingDensity", " ", "=", " ", 
    RowBox[{"FullSimplify", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Integrate", "[", "\n", "        ", 
       RowBox[{
        RowBox[{
         RowBox[{"PDF", "[", 
          RowBox[{"bimodalPositionDistribution", ",", " ", "position"}], 
          "]"}], " ", 
         RowBox[{"responsePDF", "[", 
          RowBox[{"reading", ",", " ", "position"}], "]"}]}], ",", "\n", 
        "        ", 
        RowBox[{"{", 
         RowBox[{"position", ",", " ", 
          RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], "\n", 
       "    ", "]"}], ",", "\n", "    ", "bimodalAssumptions"}], "\n", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bimodalReadingDistribution", " ", "=", " ", 
    RowBox[{"MixtureDistribution", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", " ", "/", " ", "2"}], ",", " ", 
        RowBox[{"1", " ", "/", " ", "2"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", "\n", "        ", 
       RowBox[{
        RowBox[{"NormalDistribution", "[", "\n", "            ", 
         RowBox[{
          RowBox[{"-", "separation"}], ",", "\n", "            ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"stateWidth", "^", "2"}], " ", "+", " ", 
            RowBox[{"1", " ", "/", " ", 
             RowBox[{"(", 
              RowBox[{"4", " ", "strength", " ", "binWidth"}], ")"}]}]}], 
           "]"}]}], "\n", "        ", "]"}], ",", "\n", "        ", 
        RowBox[{"NormalDistribution", "[", "\n", "            ", 
         RowBox[{"separation", ",", "\n", "            ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"stateWidth", "^", "2"}], " ", "+", " ", 
            RowBox[{"1", " ", "/", " ", 
             RowBox[{"(", 
              RowBox[{"4", " ", "strength", " ", "binWidth"}], ")"}]}]}], 
           "]"}]}], "\n", "        ", "]"}]}], "\n", "    ", "}"}]}], "\n", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bimodalStandardizedDistribution", " ", "=", " ", 
    RowBox[{"TransformedDistribution", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"strength", " ", "binWidth"}], "]"}], " ", "reading"}], ",", 
      "\n", "    ", 
      RowBox[{"Distributed", "[", 
       RowBox[{"reading", ",", " ", "bimodalReadingDistribution"}], "]"}], ",",
       "\n", "    ", 
      RowBox[{"Assumptions", " ", "->", " ", "bimodalAssumptions"}]}], "\n", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"FullSimplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"{", "\n", "        ", 
    RowBox[{
     RowBox[{
      RowBox[{"PDF", "[", 
       RowBox[{"bimodalReadingDistribution", ",", " ", "reading"}], "]"}], 
      " ", "==", " ", "bimodalReadingDensity"}], ",", "\n", "        ", 
     RowBox[{"Variance", "[", "bimodalStandardizedDistribution", "]"}], ",", 
     "\n", "        ", 
     RowBox[{
      RowBox[{"Kurtosis", "[", "bimodalStandardizedDistribution", "]"}], " ", 
      "-", " ", "3"}], ",", "\n", "        ", 
     RowBox[{"Limit", "[", "\n", "            ", 
      RowBox[{
       RowBox[{"Kurtosis", "[", "bimodalStandardizedDistribution", "]"}], ",",
        "\n", "            ", 
       RowBox[{"binWidth", " ", "->", " ", "0"}], ",", "\n", "            ", 
       RowBox[{"Direction", " ", "->", " ", "\"\<FromAbove\>\""}]}], "\n", 
      "        ", "]"}]}], "\n", "    ", "}"}], ",", "\n", "    ", 
   "bimodalAssumptions"}], "\n", "]"}]}], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"7bc4b1cb-a9d2-43db-9e22-d2efc4075306"],

