  FontSize->0.9 Inherited,ExpressionUUID->
  "5f104080-1e4d-483f-b4ab-3106707169a4"],
 " and do not survive. The complete retained factor is computed by:"
}], "Text",ExpressionUUID->"427e5ee3-9a61-4988-9247-3c9deaf58987"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"unitaryFactor", " ", "=", " ", 
    RowBox[{"1", " ", "-", " ", 
     RowBox[{"I", " ", "hamiltonian", " ", 
      RowBox[{"binWidth", " ", "/", " ", "hbar"}]}]}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Expand", "[", "\n", "    ", 
    RowBox[{"unitaryFactor", " ", "measurementFactor"}], "\n", "]"}], " ", "/.",
    " ", "itoRules"}], " ", "//", " ", "Expand"}]}], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"d6261674-71da-4ae8-8950-f3ab81282975"],

Cell["The result is", "Text",ExpressionUUID->"012f2e47-dff1-445a-a820-9f3fecba9aed"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["I", "TI"], "^"], "-", 
    FractionBox[
     StyleBox["i", "TI"], "\[HBar]"], 
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "\[CapitalDelta]", 
    StyleBox["t", "TI"], "-", 
    FractionBox[
     StyleBox["\[Lambda]", "TI"], "2"], 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["A", "TI"], "^"], 
     StyleBox["k", "TI"], "2"], "\[CapitalDelta]", 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox["\[Lambda]", "TI"]], " ", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["A", "TI"], "^"], 
     StyleBox["k", "TI"]], "\[CapitalDelta]", 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["k", "TI"]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"747b479d-e188-468b-\
a8f0-039e09e9fe4b"],

Cell["\<\
Replacing the finite increments by the differentials already defined gives \
the conditioned state SDE:\
\>", "Text",ExpressionUUID->"53470374-144b-451d-a1ca-8bdcfeedcfa9"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   FrameBox[
    RowBox[{
     RowBox[{
      StyleBox["d", "TI"], 
      TemplateBox[{
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], 
         StyleBox["t", "TI"]]},
       "Ket"]}], "=", 
     RowBox[{
      RowBox[{"[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           StyleBox["i", "TI"], "\[HBar]"]}], 
         OverscriptBox[
          StyleBox["H", "TI"], "^"], 
         StyleBox["d", "TI"], 
         StyleBox["t", "TI"]}], "-", 
        RowBox[{
         FractionBox[
          StyleBox["\[Lambda]", "TI"], "2"], 
         SuperscriptBox[
          RowBox[{
           StyleBox["(",
            FontSize->1.2 Inherited], 
           RowBox[{
            OverscriptBox[
             StyleBox["x", "TI"], "^"], "-", 
            SubscriptBox[
             RowBox[{
              StyleBox["\[LeftAngleBracket]",
               SpanMaxSize->1], 
              OverscriptBox[
               StyleBox["x", "TI"], "^"], 
              StyleBox["\[RightAngleBracket]",
               SpanMaxSize->1]}], 
             StyleBox["t", "TI"]]}], 
           StyleBox[")",
            FontSize->1.2 Inherited]}], "2"], 
         StyleBox["d", "TI"], 
         StyleBox["t", "TI"]}], "+", 
        RowBox[{
         SqrtBox[
          StyleBox["\[Lambda]", "TI"]], 
         RowBox[{
          StyleBox["(",
           FontSize->1.2 Inherited], 
          RowBox[{
           OverscriptBox[
            StyleBox["x", "TI"], "^"], "-", 
           SubscriptBox[
            RowBox[{
             StyleBox["\[LeftAngleBracket]",
              SpanMaxSize->1], 
             OverscriptBox[
              StyleBox["x", "TI"], "^"], 
             StyleBox["\[RightAngleBracket]",
              SpanMaxSize->1]}], 
            StyleBox["t", "TI"]]}], 
          StyleBox[")",
           FontSize->1.2 Inherited]}], 
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["W", "TI"], 
          StyleBox["t", "TI"]]}]}], "]"}], 
      TemplateBox[{
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], 
         StyleBox["t", "TI"]]},
       "Ket"]}]}]], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"e4d1e36e-31c8-4a52-\
beeb-e05c54e9d5ff"],

Cell[TextData[{
 "The same ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["t", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "885f1d8e-7dbb-4713-b56d-2d6a9e835535"],
 " appears in both boxed equations because both are derived from the same \
observed reading ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["x", "TI"], "_"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05644ac0-a3e8-42d2-a69e-8a72c632549b"],
 ". The record equation describes what the detector data become in the \
continuous limit. The state equation describes how that same data condition \
the quantum state."
}], "Text",ExpressionUUID->"f404f4cb-fbca-4857-80a2-ee6401df3881"]
},
