       StyleBox["\[Lambda]", "TI"], "2"], "\[CapitalDelta]", 
      SuperscriptBox[
       StyleBox["t", "TI"], "2"], 
      SuperscriptBox[
       StyleBox["a", "TI"], "4"]}], 
     SuperscriptBox[
      RowBox[{"[", 
       RowBox[{"1", "+", "4", 
        StyleBox["\[Lambda]", "TI"], "\[CapitalDelta]", 
        StyleBox["t", "TI"], 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], "+", 
         SuperscriptBox[
          StyleBox["s", "TI"], "2"]}], 
        StyleBox[")",
         SpanMaxSize->1]}], "]"}], "2"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     UnderscriptBox[
      StyleBox["lim",
       FontSlant->"Plain"], 
      RowBox[{"\[CapitalDelta]", 
       StyleBox["t", "TI"], "\[Rule]", "0"}],
      LimitsPositioning->False], "\[ThinSpace]", 
     StyleBox["Kurt",
      FontSlant->"Plain"]}], "=", 
    RowBox[{"3", "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"9b0bf64d-685a-457a-\
8f2f-fdac714a00d2"],

Cell["\<\
The nonzero excess kurtosis shows that the exact finite-bin record need not \
be Gaussian. Its vanishing limit agrees with the general Wiener limit.\
\>", "Text",ExpressionUUID->"45297a3d-c2b3-4f3e-a330-feea308d9f7d"],

Cell[TextData[{
 "A numerical check should start from simulated detector readings, not from \
the target normal distribution. Here the first returned row contains the \
sampled mean, variance, and kurtosis of ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["k", "TI"]], "/", 
   SqrtBox[
    RowBox[{"\[CapitalDelta]", 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ebc5adb-e914-474a-a102-1d2b44f3f1fd"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2073d4e-b951-44f8-a1d0-b9ae37891d25"],
 ", ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["t", "TI"], "=", "1", "/", "10"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d16c6a50-da1d-49b1-873b-af95fafa5a13"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "259e8cab-7650-4f99-a0c0-dc0ad2982e8c"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5dcf073-0bd3-401f-8cf6-fe81a44c1d6f"],
 ". The second row contains their exact values:"
}], "Text",ExpressionUUID->"7735937f-ef78-43c6-a624-f947ffee807d"],

Cell[BoxData[
 RowBox[{"BlockRandom", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "20260727", "]"}], ";", "\n", "    ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", "\n", "        ", 
      RowBox[{"parameters", " ", "=", " ", 
       RowBox[{"{", "\n", "            ", 
        RowBox[{
         RowBox[{"strength", " ", "->", " ", "1"}], ",", "\n", "            ", 
         RowBox[{"binWidth", " ", "->", " ", 
          RowBox[{"1", " ", "/", " ", "10"}]}], ",", "\n", "            ", 
         RowBox[{"separation", " ", "->", " ", "2"}], ",", "\n", 
         "            ", 
         RowBox[{"stateWidth", " ", "->", " ", 
          RowBox[{"1", " ", "/", " ", "2"}]}]}], "\n", "        ", "}"}]}], 
      "\n", "    ", "}"}], ",", "\n", "        ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", "\n", "            ", 
        RowBox[{"measuredReadings", " ", "=", " ", 
         RowBox[{"RandomVariate", "[", "\n", "                ", 
          RowBox[{
           RowBox[{
           "bimodalReadingDistribution", " ", "/.", " ", "parameters"}], ",", 
           "\n", "                ", "50000"}], "\n", "            ", "]"}]}],
         "\n", "        ", "}"}], ",", "\n", "            ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", "\n", "                ", 
          RowBox[{"standardizedRecord", " ", "=", " ", 
           RowBox[{"2", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"strength", " ", "binWidth"}], ")"}], " ", "/.", " ", 
              "parameters"}], "]"}], " ", "measuredReadings"}]}], "\n", 
          "            ", "}"}], ",", "\n", "                ", 
         RowBox[{"N", " ", "@", " ", 
          RowBox[{"{", "\n", "                    ", 
           RowBox[{
            RowBox[{"{", "\n", "                        ", 
             RowBox[{
              RowBox[{"Mean", "[", "standardizedRecord", "]"}], ",", "\n", 
              "                        ", 
              RowBox[{"Variance", "[", "standardizedRecord", "]"}], ",", "\n",
               "                        ", 
              RowBox[{"Kurtosis", "[", "standardizedRecord", "]"}]}], "\n", 
             "                    ", "}"}], ",", "\n", "                    ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", 
              RowBox[{"27", " ", "/", " ", "10"}], ",", " ", 
              RowBox[{"1675", " ", "/", " ", "729"}]}], "}"}]}], "\n", 
           "                ", "}"}]}]}], "\n", "            ", "]"}]}], "\n",
       "        ", "]"}]}], "\n", "    ", "]"}]}], "\n", "]"}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"25876569-d8b5-4674-ae3e-222ffd81ffb8"],

Cell[TextData[{
 "The sampled row is approximately ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "0.00078"}], ",", "2.7229", ",", 
   RowBox[{"2.2967", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ec72d58-ce86-49ab-9d68-c2967ab6ea45"],
 ", close to the exact row ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "0"}], ",", "2.7", ",", 
   RowBox[{"2.2977", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28ccf09d-dbdd-4a49-83ed-c002631fa9eb"],
 ". This checks the path from measured readings to the centered record; it is \
not used in the derivation."
}], "Text",ExpressionUUID->"33eebb22-aaf3-4151-af82-2229b1fb6a30"],

Cell["From finite-bin fluctuations to a Wiener process", "Section",ExpressionUUID->"3653f70f-f21a-437e-bc05-c9e949a3d179"],

Cell["\<\
Define the accumulated centered record at finite resolution by\
\>", "Text",ExpressionUUID->"bd075e50-dfd1-4f92-b505-0c24dfe89bfb"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     StyleBox["W", "TI"], 
     SubscriptBox[
      StyleBox["t", "TI"], 
      StyleBox["n", "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"\[CapitalDelta]", 
       StyleBox["t", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]], "\[Congruent]", 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "=", "0"}], 
     RowBox[{
      StyleBox["n", "TI"], "-", "1"}],
     LimitsPositioning->False], "\[CapitalDelta]", 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["k", "TI"]], "=", 
    SubscriptBox[
     StyleBox["Y", "TI"], 
     SubscriptBox[
      StyleBox["t", "TI"], 
      StyleBox["n", "TI"]]], "-", "2", 
    SqrtBox[
     StyleBox["\[Lambda]", "TI"]], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "=", "0"}], 
     RowBox[{
      StyleBox["n", "TI"], "-", "1"}],
     LimitsPositioning->False], 
    SubscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["x", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox["k", "TI"]], "\[CapitalDelta]", 
    StyleBox["t", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"f3b1d00c-bc7f-4f6e-\
bcb2-7428f1a7a9f4"],

Cell[TextData[{
 "Between grid points, take ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["W", "TI"], 
   StyleBox["t", "TI"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CapitalDelta]", 
     StyleBox["t", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3655f6fd-3c74-415e-b3c7-740f9c9f9eb8"],
 " to remain constant until the next detector reading. This makes ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["W", "TI"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CapitalDelta]", 
     StyleBox["t", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "baab9a9d-8c38-444a-aba6-5ebb2c3ac998"],
 " a defined finite-resolution process, not only a list of increments."
}], "Text",ExpressionUUID->"267ad129-c708-4515-8aa1-e6a49c054139"],

Cell[TextData[{
 "At bin ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fec633ac-9c10-42f2-a353-57778eaaaba5"],
 ", the previously observed readings determine ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox[
     StyleBox["\[Psi]", "TI"], 
     StyleBox["k", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87f531e8-097b-41d9-92d0-07e0ac2f159d"],
 ", and the next increment has conditional mean zero. The increments need not \
be independent at finite ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5707ff80-d412-4a26-8769-9a23fd2d95e3"],
 " because each new reading changes the state used in the next bin."
}], "Text",ExpressionUUID->"cce818b0-73fa-42fb-ac19-32248dc99580"],

Cell[TextData[{
 "Over a fixed interval ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "=", 
   StyleBox["n", "TI"], "\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "145a3f52-76c0-43da-acab-afc8e9f92bea"],
 ", the leading conditional variances sum to ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3aa350cb-8753-4d11-9444-3f9994fce9f8"],
 ". If the position variance is bounded above by ",
 Cell[BoxData["maximumPositionVariance"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f850aa8-b34b-4144-ab93-39f5e460afed"],
 " on that interval, the correction is bounded by"
}], "Text",ExpressionUUID->"6446ec68-695a-4acb-9937-bd61e40f2a2e"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"4", 
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["T", "TI"], "\[CapitalDelta]", 
    StyleBox["t", "TI"], " ", 
    StyleBox["maximumPositionVariance",
     FontSlant->"Plain"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"2c442ea8-b84b-450c-\
815c-3ede1ee8868d"],

Cell["Its limit is:", "Text",ExpressionUUID->"f2404bda-e12f-416a-8671-d079dd92f5b7"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"Limit", "[", "\n", "        ", 
    RowBox[{
     RowBox[{
     "4", " ", "strength", " ", "totalTime", " ", "binWidth", "\n", 
      "            ", "maximumPositionVariance"}], ",", "\n", "        ", 
     RowBox[{"binWidth", " ", "->", " ", "0"}], ",", "\n", "        ", 
     RowBox[{"Direction", " ", "->", " ", "\"\<FromAbove\>\""}]}], "\n", 
    "    ", "]"}], ",", "\n", "    ", "assumptions"}], "\n", "]"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"ace8bfef-e179-4874-b2aa-f06fdeb3c149"],

Cell[TextData[{
 "The result is zero. To control rare large increments as well, assume that \
the conditional position moments of some order ",
 Cell[BoxData[
  RowBox[{"2", "+", 
   StyleBox["\[CurlyEpsilon]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21d20f49-95ea-492e-b374-f805675de71e"],
 " remain uniformly bounded on every finite time interval, for some ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[CurlyEpsilon]", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed7f716-6000-4a74-8d04-14a3bd10c242"],
 ". The martingale functional central-limit theorem then gives"
}], "Text",ExpressionUUID->"ae819c17-a6e2-4e64-ad81-55b351070265"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"\[CapitalDelta]", 
       StyleBox["t", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]], "\[DoubleLongRightArrow]", 
    StyleBox["W", "TI"], "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CapitalDelta]", 
     StyleBox["t", "TI"], "\[Rule]", "0"}], 
    StyleBox[")",
     SpanMaxSize->1]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"7c863748-db54-424c-\
9538-c293acecd294"],

Cell[TextData[{
 "where the arrow denotes convergence in distribution of the accumulated \
process and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["W", "TI"], 
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11e6ba06-aa4a-4f4a-affe-e0f91361ad73"],
 " is a standard Wiener process. This theorem is the one probabilistic limit \
used here; Wolfram Language checks the finite-bin inputs and the properties \
of the limiting process, not the theorem itself."
}], "Text",ExpressionUUID->"fbf6b1f8-a840-4041-9184-39b451b46919"],

Cell[TextData[{
 "For comparison, the built-in standard Wiener process gives the distribution \
of an increment of duration ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ede217b-9dd5-408a-87ce-69ed62101cc4"],
 " directly:"
}], "Text",ExpressionUUID->"5e7dc0c7-4805-43eb-8087-4c46b68958aa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"standardWiener", " ", "=", " ", 
    RowBox[{"WienerProcess", "[", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"FullSimplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"TransformedDistribution", "[", "\n", "        ", 
    RowBox[{
     RowBox[{
      RowBox[{"w", "[", 
       RowBox[{"t", " ", "+", " ", "binWidth"}], "]"}], " ", "-", " ", 
      RowBox[{"w", "[", "t", "]"}]}], ",", "\n", "        ", 
     RowBox[{"Distributed", "[", 
      RowBox[{"w", ",", " ", "standardWiener"}], "]"}], ",", "\n", "        ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{
       RowBox[{"t", " ", ">=", " ", "0"}], " ", "&&", " ", 
       RowBox[{"binWidth", " ", ">", " ", "0"}]}]}]}], "\n", "    ", "]"}], ",",
    "\n", "    ", 
   RowBox[{"assumptions", " ", "&&", " ", 
    RowBox[{"t", " ", ">=", " ", "0"}]}]}], "\n", "]"}]}], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"223735ca-8ab4-42ac-9981-4782ab80df63"],

Cell[TextData[{
 "Inside this cell, ",
 Cell[BoxData["w"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17e4c1e7-1ae2-41b5-be92-83e91a108af5"],
 " is only the local process symbol required by ",
 Cell[BoxData["Distributed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4387d277-441d-4ef2-86a6-f2a5adaca8e8"],
 ". The result is ",
 Cell[BoxData[
  RowBox[{"NormalDistribution", "[", 
   RowBox[{"0", ",", 
    RowBox[{"Sqrt", "[", "binWidth", "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f297c0b-f51a-44a3-931e-cb505a4b5aab"],
 ", exactly the limiting distribution ",
 Cell[BoxData[
  RowBox[{"\|01d4a9", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    SqrtBox[
     RowBox[{"\[CapitalDelta]", 
      StyleBox["t", "TI"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac963a06-2d57-4d67-8c92-2b2a1c9f989b"],
 "."
}], "Text",ExpressionUUID->"5c6eb1f2-9dfc-4134-bb7b-9b60e553fcfd"],

Cell["\<\
We now make the single notational transition from finite bins to \
differentials:\
\>", "Text",ExpressionUUID->"55fc1546-de58-40ff-9fdb-5884cbd111bc"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"\[CapitalDelta]", 
    StyleBox["t", "TI"], "\[LongRightArrow]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{"\[CapitalDelta]", 
    RowBox[{
     SubscriptBox[
      StyleBox["Y", "TI"], 
      StyleBox["k", "TI"]], "\[LongRightArrow]", 
     StyleBox["d", "TI"]}], 
    SubscriptBox[
     StyleBox["Y", "TI"], 
     StyleBox["t", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{"\[CapitalDelta]", 
    RowBox[{
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["k", "TI"]], "\[LongRightArrow]", 
     StyleBox["d", "TI"]}], 
    RowBox[{
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["t", "TI"]], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"ab67718d-517f-46d5-\
a5ff-320f0b966c54"],

Cell[TextData[{
 "Because ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["W", "TI"], 
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b943743b-8e74-462e-9faa-3fdbca21eeb8"],
 " is a Wiener process, its It\[OHat] increments satisfy"
}], "Text",ExpressionUUID->"97135ade-ea59-4f5d-91ea-9ab45c3c137c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["d", "TI"], 
       SubscriptBox[
        StyleBox["W", "TI"], 
        StyleBox["t", "TI"]]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "=", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     StyleBox["t", "TI"], " ", 
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["t", "TI"]]}], "=", "0"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     SuperscriptBox[
      StyleBox["t", "TI"], "2"]}], "=", 
    RowBox[{"0", "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"7f625cc9-8136-4ad2-\
a6f6-b9ce914801bb"],

Cell[TextData[{
 "These rules specify the It\[OHat] convention. No Stratonovich equation is \
being used. The exact finite-bin definition of ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59754a4d-dbc7-4edd-8957-8984a46481a1"],
 " now becomes the record SDE"
}], "Text",ExpressionUUID->"8dbc323c-abcf-4078-b20e-4ee04d8d051c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   FrameBox[
    RowBox[{
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["Y", "TI"], 
      StyleBox["t", "TI"]], "=", "2", 
     SqrtBox[
      StyleBox["\[Lambda]", "TI"]], " ", 
     SubscriptBox[
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["x", "TI"], "^"], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], 
      StyleBox["t", "TI"]], " ", 
     StyleBox["d", "TI"], 
     StyleBox["t", "TI"], "+", 
     StyleBox["d", "TI"], 
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["t", "TI"]]}]], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"0f4e5cb5-ee76-47a7-\
a35d-c9434f318d43"],

Cell["\<\
The measured finite-bin values are still recovered from the accumulated \
record by\
\>", "Text",ExpressionUUID->"5fdcf67c-ab22-4831-a5d9-aec323c1b69c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["x", "TI"], "_"], 
     StyleBox["k", "TI"]], "=", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["Y", "TI"], 
       SubscriptBox[
        StyleBox["t", "TI"], 
        RowBox[{
         StyleBox["k", "TI"], "+", "1"}]]], "-", 
      SubscriptBox[
       StyleBox["Y", "TI"], 
       SubscriptBox[
        StyleBox["t", "TI"], 
        StyleBox["k", "TI"]]]}], 
     RowBox[{"2", 
      SqrtBox[
       StyleBox["\[Lambda]", "TI"]], " ", "\[CapitalDelta]", 
      StyleBox["t", "TI"]}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"3d38d16c-d6e9-4dd1-\
ab68-d38a4e8a5d61"],

Cell[TextData[{
 "Thus the experiment measures the sequence ",
 Cell[BoxData[
  RowBox[{"{", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "_"], 
    StyleBox["k", "TI"]], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d066d1fa-acf5-4d47-8cbc-738e8e8ea5c6"],
 ", ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8eaecb58-e62b-435f-b565-5c3235195b63"],
 " is the same data in the scaling that has a continuous limit, and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["t", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90e44591-3901-4815-a479-ab64fdda5b16"],
 " is the centered random part of that limiting record."
}], "Text",ExpressionUUID->"5338af09-e013-46fc-868f-72ca04ea5a4f"],

Cell["The conditioned state equation", "Section",ExpressionUUID->"589d1fda-fb58-49bf-9684-8aaae09940d9"],

Cell[TextData[{
 "For the operator expansions below, assume that the states considered lie in \
a common invariant analytic domain for ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84ab60e6-b9a1-4697-9b8e-7e742269ee36"],
 " and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["x", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e2808c9-662e-4f6c-ab00-7a6b2d33fba3"],
 ". This is the regularity needed to interpret the uppercase-",
 Cell[BoxData[
  StyleBox["O", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56eb7a0d-71f1-4245-9806-87e6d7c26097"],
 " remainders when these operators are unbounded."
}], "Text",ExpressionUUID->"365153af-efb3-448b-b31c-36174aa70c25"],

Cell["Return to the exact state update and substitute", "Text",ExpressionUUID->"05977509-76ab-4015-87c3-6c45fcba8152"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["x", "TI"], "_"], 
     StyleBox["k", "TI"]], "=", 
    SubscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["x", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox["k", "TI"]], "+", 
    FractionBox[
     RowBox[{"\[CapitalDelta]", 
      SubscriptBox[
       StyleBox["W", "TI"], 
       StyleBox["k", "TI"]]}], 
     RowBox[{"2", 
      SqrtBox[
       StyleBox["\[Lambda]", "TI"]], " ", "\[CapitalDelta]", 
      StyleBox["t", "TI"]}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"368a33c9-0f3b-4408-\
a113-42cc9acfd279"],

Cell["Define", "Text",ExpressionUUID->"436564a7-9652-48da-aa21-d88571e9f84c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["A", "TI"], "^"], 
     StyleBox["k", "TI"]], "\[Congruent]", 
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "-", 
    SubscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["x", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox["k", "TI"]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"4660a90c-bbee-4137-\
be1e-061f674a8564"],

Cell["The measurement exponent becomes", "Text",ExpressionUUID->"a20c9618-e8b7-465b-8bf7-5a72fc17fcb0"],

Cell[BoxData[
 PaneBox[GridBox[{
    {
     RowBox[{"-", 
      StyleBox["\[Lambda]", "TI"], "\[CapitalDelta]", 
      StyleBox["t", "TI"], 
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         OverscriptBox[
          StyleBox["x", "TI"], "^"], "-", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["x", "TI"], "_"], 
          StyleBox["k", "TI"]]}], 
        StyleBox[")",
         SpanMaxSize->1]}], "2"]}], 
     RowBox[{"=", 
      RowBox[{"-", 
       StyleBox["\[Lambda]", "TI"], "\[CapitalDelta]", 
       StyleBox["t", "TI"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           OverscriptBox[
            StyleBox["A", "TI"], "^"], 
           StyleBox["k", "TI"]], "-", 
          FractionBox[
           RowBox[{"\[CapitalDelta]", 
            SubscriptBox[
             StyleBox["W", "TI"], 
             StyleBox["k", "TI"]]}], 
           RowBox[{"2", 
            SqrtBox[
             StyleBox["\[Lambda]", "TI"]], " ", "\[CapitalDelta]", 
            StyleBox["t", "TI"]}]]}], ")"}], "2"]}]}]},
    {"", 
     RowBox[{"=", 
      RowBox[{
       SqrtBox[
        StyleBox["\[Lambda]", "TI"]], " ", 
       SubscriptBox[
        OverscriptBox[
         StyleBox["A", "TI"], "^"], 
        StyleBox["k", "TI"]], "\[CapitalDelta]", 
       SubscriptBox[
        StyleBox["W", "TI"], 
        StyleBox["k", "TI"]], "-", 
       StyleBox["\[Lambda]", "TI"], 
       SubsuperscriptBox[
        OverscriptBox[
         StyleBox["A", "TI"], "^"], 
        StyleBox["k", "TI"], "2"], "\[CapitalDelta]", 
       StyleBox["t", "TI"], "-", 
       FractionBox[
        SuperscriptBox[
         RowBox[{
          StyleBox["(",
           SpanMaxSize->1], 
          RowBox[{"\[CapitalDelta]", 
           SubscriptBox[
            StyleBox["W", "TI"], 
            StyleBox["k", "TI"]]}], 
          StyleBox[")",
           SpanMaxSize->1]}], "2"], 
        RowBox[{"4", "\[CapitalDelta]", 
         StyleBox["t", "TI"]}]]}], "."}]}
   },
   GridBoxAlignment->{"Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"77439bfc-1e18-4869-\
a27b-02d05084125d"],

Cell[TextData[{
 "The identity is purely algebraic. Using ",
 Cell[BoxData["centeredOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cca3ae77-bcda-4f2f-9d08-fa6586dc0178"],
 " for ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["A", "TI"], "^"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b104fb68-6dcc-4217-9402-a5d2ed7127f5"],
 " and ",
 Cell[BoxData["centeredValue"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bd67620-6051-4b8d-b763-af9624904014"],
 " for ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57c7e891-ab22-4c54-81ab-deb616289514"],
 ", Wolfram Language verifies it exactly:"
}], "Text",ExpressionUUID->"227aaeea-ff0b-46eb-9408-fe4caf9add51"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", "strength"}], " ", "binWidth", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"centeredOperator", " ", "-", " ", 
        RowBox[{"centeredValue", " ", "/", " ", 
         RowBox[{"(", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "strength", "]"}], " ", "binWidth"}], 
          ")"}]}]}], ")"}], "^", "2"}]}], " ", "==", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", "strength", "]"}], " ", "centeredOperator", " ", 
      "centeredValue"}], " ", "-", " ", 
     RowBox[{"strength", " ", 
      RowBox[{"centeredOperator", "^", "2"}], " ", "binWidth"}], " ", "-", 
     " ", 
     RowBox[{
      RowBox[{"centeredValue", "^", "2"}], " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"4", " ", "binWidth"}], ")"}]}]}]}], ",", "\n", "    ", 
   "assumptions"}], "\n", "]"}]], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"08c02b7f-dc02-4e99-8116-cac337c8dd1e"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c568370d-484c-4f8b-8b72-2b0c8d566654"],
 ". The last term is a scalar, so it multiplies the whole unnormalized state \
by the positive number"
}], "Text",ExpressionUUID->"f18564a1-474f-4ec3-8791-601420253baf"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", "[", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
