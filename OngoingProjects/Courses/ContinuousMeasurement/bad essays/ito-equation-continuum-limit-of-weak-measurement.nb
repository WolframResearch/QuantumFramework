  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"3d24a66b-c567-4918-\
a5ab-a483ac9e2552"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ce98304-4e12-4db6-89d6-8c6a49050fc3"],
 " is of order ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"\[CapitalDelta]", 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b19887f-f3fc-4829-9555-3c45d342e079"],
 ", its square contributes at order ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d055ac0-f841-49d7-abe2-8040b9b7bbab"],
 ". Expand the exponential through second order and then apply the \
It\[OHat]-order rules:"
}], "Text",ExpressionUUID->"135bdea9-2d43-4107-8df1-0c30cfd16d77"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"measurementExponent", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", "strength", "]"}], " ", "centeredOperator", " ", 
      "centeredValue"}], " ", "-", " ", 
     RowBox[{"strength", " ", 
      RowBox[{"centeredOperator", "^", "2"}], " ", "binWidth"}]}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"itoRules", " ", "=", " ", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"centeredValue", "^", "2"}], " ", "->", " ", "binWidth"}], ",",
       "\n", "    ", 
      RowBox[{
       RowBox[{"centeredValue", " ", "binWidth"}], " ", "->", " ", "0"}], ",",
       "\n", "    ", 
      RowBox[{
       RowBox[{"binWidth", "^", "2"}], " ", "->", " ", "0"}]}], "\n", "}"}]}],
    ";"}], "\n"}], "\n", 
 RowBox[{"measurementFactor", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Expand", "[", "\n", "    ", 
     RowBox[{"Total", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "measurementExponent", ",", " ", 
        RowBox[{
         RowBox[{"measurementExponent", "^", "2"}], " ", "/", " ", "2"}]}], 
       "}"}], "]"}], "\n", "]"}], " ", "/.", " ", "itoRules"}], " ", "//", 
   " ", "Expand"}]}]}], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"a3d02cf9-899e-46b7-9849-ca7c5abefe67"],

Cell["The returned factor is", "Text",ExpressionUUID->"5a181b45-269f-489f-866a-b74f99a8bfa2"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"1", "+", 
    SqrtBox[
     StyleBox["\[Lambda]", "TI"]], " ", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["A", "TI"], "^"], 
     StyleBox["k", "TI"]], "\[CapitalDelta]", 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["k", "TI"]], "-", 
    FractionBox[
     StyleBox["\[Lambda]", "TI"], "2"], 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["A", "TI"], "^"], 
     StyleBox["k", "TI"], "2"], "\[CapitalDelta]", 
    StyleBox["t", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"5d97d148-591d-434a-\
a2f8-4526bdfef5db"],

Cell[TextData[{
 "The coefficient ",
 Cell[BoxData[
  RowBox[{"-", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "949a031c-da69-4865-b0b5-14673cc6170f"],
 " comes from combining the explicit term ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["\[Lambda]", "TI"], 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["A", "TI"], "^"], 
    StyleBox["k", "TI"], "2"], "\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f63dd8b5-6691-4975-9c9b-0600416974e5"],
 " with the quadratic contribution ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["\[Lambda]", "TI"], 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["A", "TI"], "^"], 
    StyleBox["k", "TI"], "2"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CapitalDelta]", 
      SubscriptBox[
       StyleBox["W", "TI"], 
       StyleBox["k", "TI"]]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46cf59ae-de2a-4628-b5e7-66b7720f1d9e"],
 " and then using ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CapitalDelta]", 
      SubscriptBox[
       StyleBox["W", "TI"], 
       StyleBox["k", "TI"]]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], "=", "\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c1686ae-28dc-43b8-91a5-0193003b2a27"],
 " at It\[OHat] order."
}], "Text",ExpressionUUID->"0cfc480b-68d5-4f40-a648-4d95cfe1363d"],

Cell[TextData[{
 "This factor preserves the norm to the same order. Squaring it, applying the \
It\[OHat] rules, and then replacing powers of ",
 Cell[BoxData["centeredOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "622b6569-e1fd-424c-af00-825393d1977e"],
 " by their state expectations gives:"
}], "Text",ExpressionUUID->"632c4ecf-c69f-4184-be5a-705269487a5f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"normChange", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{
        RowBox[{"measurementFactor", "^", "2"}], " ", "-", " ", "1"}], "]"}], 
      " ", "/.", " ", "itoRules"}], " ", "//", " ", "Expand"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"normExpectation", " ", "=", " ", 
    RowBox[{"normChange", " ", "/.", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"centeredOperator", "^", "2"}], " ", "->", " ", 
        "centeredSecondMoment"}], ",", "\n", "    ", 
       RowBox[{"centeredOperator", " ", "->", " ", "centeredMean"}]}], "\n", 
      "}"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"{", "\n", "    ", 
  RowBox[{"normExpectation", ",", "\n", "    ", 
   RowBox[{"normExpectation", " ", "/.", " ", 
    RowBox[{"centeredMean", " ", "->", " ", "0"}]}]}], "\n", "}"}]}], "Input",\

 CellLabel->
  "In[20]:= ",ExpressionUUID->"95ce34e2-a60f-4033-9602-e53f3d45cad5"],

Cell[TextData[{
 "The first expression is ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    StyleBox["\[Lambda]", "TI"]], " ", 
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["A", "TI"], "^"], 
      StyleBox["k", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["k", "TI"]], "\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e7d4c87-987f-43a8-a5a8-4ebb59800a67"],
 ", and the second is zero because"
}], "Text",ExpressionUUID->"ca4b8299-dbad-41bf-9f21-3efb757d4803"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["A", "TI"], "^"], 
       StyleBox["k", "TI"]], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox["k", "TI"]], "=", 
    SubscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      RowBox[{
       OverscriptBox[
        StyleBox["x", "TI"], "^"], "-", 
       SubscriptBox[
        RowBox[{
         StyleBox["\[LeftAngleBracket]",
          SpanMaxSize->1], 
         OverscriptBox[
          StyleBox["x", "TI"], "^"], 
         StyleBox["\[RightAngleBracket]",
          SpanMaxSize->1]}], 
        StyleBox["k", "TI"]]}], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox["k", "TI"]], "=", "0"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"8c433ff4-0a7e-4e73-\
a66a-ed292c3dc3b5"],

Cell["The unitary factor is", "Text",ExpressionUUID->"72ce6c3b-75dc-483d-b43d-7c86ba8daa80"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["U", "TI"], "^"], "=", 
    OverscriptBox[
     StyleBox["I", "TI"], "^"], "-", 
    FractionBox[
     StyleBox["i", "TI"], "\[HBar]"], 
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "\[CapitalDelta]", 
    StyleBox["t", "TI"], "+", 
    StyleBox["O", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CapitalDelta]", 
     SuperscriptBox[
      StyleBox["t", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"c54926ce-2efc-414b-\
b13a-db3b6d165f0f"],

Cell[TextData[{
 "Products of its order-",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28b0839c-a3ff-42e4-89ab-37f9a9d9595c"],
 " term with the order-",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"\[CapitalDelta]", 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7eb5f41-989b-4f6d-9571-16dc7e67edfb"],
 " measurement term are ",
 Cell[BoxData[
