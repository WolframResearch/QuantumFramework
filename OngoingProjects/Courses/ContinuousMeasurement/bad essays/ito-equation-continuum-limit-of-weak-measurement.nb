Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"standardizedConditionalDistribution", "[", "position_", "]"}], 
    " ", ":=", " ", 
    RowBox[{"TransformedDistribution", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"centeredValue", " ", "/", " ", 
       RowBox[{"Sqrt", "[", "binWidth", "]"}]}], ",", "\n", "    ", 
      RowBox[{"Distributed", "[", "\n", "        ", 
       RowBox[{"centeredValue", ",", "\n", "        ", 
        RowBox[{"conditionalCenteredDistribution", "[", "position", "]"}]}], 
       "\n", "    ", "]"}], ",", "\n", "    ", 
      RowBox[{"Assumptions", " ", "->", " ", "assumptions"}]}], "\n", "]"}]}],
    ";"}], "\n"}], "\n", 
 RowBox[{"FullSimplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"{", "\n", "        ", 
    RowBox[{
     RowBox[{"standardizedConditionalDistribution", "[", "position", "]"}], ",",
      "\n", "        ", 
     RowBox[{"Limit", "[", "\n", "            ", 
      RowBox[{
       RowBox[{
       "4", " ", "strength", " ", "binWidth", " ", "positionVariance"}], ",", 
       "\n", "            ", 
       RowBox[{"binWidth", " ", "->", " ", "0"}], ",", "\n", "            ", 
       RowBox[{"Direction", " ", "->", " ", "\"\<FromAbove\>\""}]}], "\n", 
      "        ", "]"}]}], "\n", "    ", "}"}], ",", "\n", "    ", 
   "assumptions"}], "\n", "]"}]}], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"8168ad9c-369e-4bab-9bf0-bde40729c248"],

