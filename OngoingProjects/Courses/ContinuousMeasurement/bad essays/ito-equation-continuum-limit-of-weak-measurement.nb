Notebook[{
Cell["The It\[OHat] Equation: The Continuum Limit of Weak Measurement", \
"Title",ExpressionUUID->"237d061a-9920-4ff4-91d8-96126b125dbe"],

Cell["\<\
We derive the continuous equations for the measured position record and for \
the quantum state conditioned on that record. I want each nontrivial \
algebraic or probabilistic claim to be reproducible, so each one is followed \
by a focused Wolfram Language computation.\
\>", "Text",ExpressionUUID->"5626c109-5aa1-4e67-9ba0-1952d67595bf"],

Cell["\<\
The detector is ideal and efficient: all measurement backaction is associated \
with its observed output, so a conditioned pure state remains pure. It is \
also memoryless: once the state at the beginning of a time bin is known from \
the outputs already observed, the next output is governed by the same \
measurement rule.\
\>", "Text",ExpressionUUID->"376efdc7-d394-42b1-82a3-b5f6e7846ea9"],

Cell["Let", "Text",ExpressionUUID->"e1c54b50-3dce-4ff8-ad50-e40e05ad70dd"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["k", "TI"]], "=", 
    RowBox[{
     StyleBox["k", "TI"], "\[CapitalDelta]", 
     StyleBox["t", "TI"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["k", "TI"]]},
     "Ket"], "=", 
    RowBox[{
     TemplateBox[{
       RowBox[{
         StyleBox["\[Psi]", "TI"], 
         StyleBox["(", SpanMaxSize -> 1], 
         SubscriptBox[
          StyleBox["t", "TI"], 
          StyleBox["k", "TI"]], 
         StyleBox[")", SpanMaxSize -> 1]}]},
      "Ket"], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"ad1c721d-a3b8-4420-\
aab8-250d5f87a0e8"],

Cell[TextData[{
 "During the bin ",
 Cell[BoxData[
  RowBox[{"[", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["k", "TI"]], ",", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    RowBox[{
     StyleBox["k", "TI"], "+", "1"}]], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16d2389c-4465-4172-9e73-f2f874d75f39"],
 ", the detector measures one real number ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["x", "TI"], "_"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "785db132-c581-4e16-9e84-54df5b06fe2a"],
 ". This is the only newly observed random quantity in the derivation. The \
sequence ",
 Cell[BoxData[
  RowBox[{"{", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "_"], 
    StyleBox["k", "TI"]], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3597d82-e25d-4ee1-affc-69c798956ff4"],
 " is the finite-resolution position record."
}], "Text",ExpressionUUID->"22019ecf-522a-453e-9507-192189738ffc"],

Cell["\<\
The code uses descriptive names for the symbols in the equations:\
\>", "Text",ExpressionUUID->"0af339ea-186f-4059-857c-8021f8202f60"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\n", "    ", 
    RowBox[{
    "strength", ",", "\n", "    ", "binWidth", ",", "\n", "    ", "position", 
     ",", "\n", "    ", "reading", ",", "\n", "    ", "meanPosition", ",", 
     "\n", "    ", "positionVariance", ",", "\n", "    ", "responsePDF", ",", 
     "\n", "    ", "conditionalReadingDistribution", ",", "\n", "    ", 
     "conditionalRecordMoments", ",", "\n", "    ", "bornMomentRules", ",", 
     "\n", "    ", "recordMoments", ",", "\n", "    ", 
     "leadingAccumulatedVariance", ",", "\n", "    ", 
     "recordIncrementMoments", ",", "\n", "    ", "centeredValue", ",", "\n", 
     "    ", "conditionalCenteredDistribution", ",", "\n", "    ", 
     "standardizedConditionalDistribution", ",", "\n", "    ", 
     "bimodalAssumptions", ",", "\n", "    ", "separation", ",", "\n", "    ",
      "stateWidth", ",", "\n", "    ", "bimodalPositionDistribution", ",", 
     "\n", "    ", "bimodalReadingDensity", ",", "\n", "    ", 
     "bimodalReadingDistribution", ",", "\n", "    ", 
     "bimodalStandardizedDistribution", ",", "\n", "    ", "scale", ",", "\n",
      "    ", "power", ",", "\n", "    ", "totalTime", ",", "\n", "    ", 
     "maximumPositionVariance", ",", "\n", "    ", "standardWiener", ",", 
     "\n", "    ", "w", ",", "\n", "    ", "t", ",", "\n", "    ", 
     "centeredOperator", ",", "\n", "    ", "centeredMean", ",", "\n", "    ",
      "centeredSecondMoment", ",", "\n", "    ", "hamiltonian", ",", "\n", 
     "    ", "hbar", ",", "\n", "    ", "measurementExponent", ",", "\n", 
     "    ", "measurementFactor", ",", "\n", "    ", "normChange", ",", "\n", 
     "    ", "normExpectation", ",", "\n", "    ", "unitaryFactor", ",", "\n",
      "    ", "itoRules"}], "\n", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{"assumptions", " ", "=", " ", 
  RowBox[{"And", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"strength", " ", ">", " ", "0"}], ",", "\n", "    ", 
    RowBox[{"binWidth", " ", ">", " ", "0"}], ",", "\n", "    ", 
    RowBox[{"positionVariance", " ", ">=", " ", "0"}], ",", "\n", "    ", 
    RowBox[{"maximumPositionVariance", " ", ">=", " ", "0"}], ",", "\n", 
    "    ", 
    RowBox[{"totalTime", " ", ">", " ", "0"}], ",", "\n", "    ", 
    RowBox[{"hbar", " ", ">", " ", "0"}], ",", "\n", "    ", 
    RowBox[{"Element", "[", "\n", "        ", 
     RowBox[{
      RowBox[{"{", "\n", "            ", 
       RowBox[{
       "position", ",", "\n", "            ", "reading", ",", "\n", 
        "            ", "meanPosition", ",", "\n", "            ", 
        "centeredValue", ",", "\n", "            ", "scale", ",", "\n", 
        "            ", "positionVariance", ",", "\n", "            ", 
        "maximumPositionVariance", ",", "\n", "            ", "totalTime", ",",
         "\n", "            ", "hbar"}], "\n", "        ", "}"}], ",", "\n", 
      "        ", "Reals"}], "\n", "    ", "]"}]}], "\n", "]"}]}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c0645e46-8384-4670-9f71-499a2b774b27"],

Cell[TextData[{
 "Thus ",
 Cell[BoxData["strength"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a98ecf43-ea8d-46d8-be32-007fa4952299"],
 ", ",
 Cell[BoxData["binWidth"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ba04947-1693-4c87-a347-28f6adfc574b"],
 ", ",
 Cell[BoxData["reading"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a326f37e-dbbe-431d-87c7-c2e6fee730d6"],
 ", and ",
 Cell[BoxData["meanPosition"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb19b7cf-03f0-42d8-bbcc-84c8f68041c5"],
 " represent ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b41b59b9-3dec-4778-9cd4-e472a9db8e95"],
 ", ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7f5a9e3-88db-44f3-82da-a55577cdab53"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["x", "TI"], "_"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31ca43b8-4683-4088-93d2-e40f4831aa8f"],
 ", and ",
 Cell[BoxData[
  SubscriptBox[
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["x", "TI"], "^"], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8ab293e-ff6e-4b23-91bc-ca151cd6d98a"],
 ", respectively."
}], "Text",ExpressionUUID->"db3f08a0-b65f-4c1b-b470-e79a87d32689"],

Cell["One weak position reading", "Section",ExpressionUUID->"b3a39f55-a67e-4c81-a545-d57c72a1c411"],

Cell[TextData[{
 "The measurement operator associated with the observed value ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["x", "TI"], "_"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7efba8aa-c62f-440c-99e3-ed1217d007d0"],
 " is"
}], "Text",ExpressionUUID->"6781c8d9-1fc0-4d3a-b37e-9b74a7bc84c7"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["M", "TI"], "^"], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["x", "TI"], "_"], 
     StyleBox["k", "TI"]], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"2", 
        StyleBox["\[Lambda]", "TI"], "\[CapitalDelta]", 
        StyleBox["t", "TI"]}], "\[Pi]"], ")"}], 
     RowBox[{"1", "/", "4"}]], 
    StyleBox["exp",
     FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", "[", 
    RowBox[{"-", 
     StyleBox["\[Lambda]", "TI"], "\[CapitalDelta]", 
     StyleBox["t", "TI"], 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        OverscriptBox[
         StyleBox["x", "TI"], "^"], "-", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["x", "TI"], "_"], 
         StyleBox["k", "TI"]]}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"]}], "]"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["\[Lambda]", "TI"], ">", 
    RowBox[{"0", "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"f4c3748f-4c65-40e9-\
80e5-6723f2e23038"],

Cell[TextData[{
 "The limit is taken with ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4a0983f-6ae6-4549-ba2a-4e02fea00b11"],
 " fixed, so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "\[CapitalDelta]", 
   StyleBox["t", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c76bbf10-b2ef-4a7b-a003-10341d8f3bd2"],
 ". Each measurement becomes weak, but the measurement strength per unit time \
remains finite."
}], "Text",ExpressionUUID->"b19f6255-9a1d-45d1-8ca7-d37116b125a1"],

Cell[TextData[{
 "To check the normalization, work in the position basis, where ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], 
    TemplateBox[{
      StyleBox["x", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    StyleBox["x", "TI"], 
    TemplateBox[{
      StyleBox["x", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60ed587a-9619-400f-9a69-16b9e8cccb2a"],
 ". The diagonal element of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    OverscriptBox[
     StyleBox["M", "TI"], "^"], "\[Dagger]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "_"], 
    StyleBox["k", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["M", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "_"], 
    StyleBox["k", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e910e467-1210-4937-b794-3c910e4e5697"],
 " is the Gaussian response"
}], "Text",ExpressionUUID->"d514c6c0-33cd-4743-9dc0-2caca4e470e2"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], 
     RowBox[{"\[CapitalDelta]", 
      StyleBox["t", "TI"]}]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["x", "TI"], "_"], 
      StyleBox["k", "TI"]], "\[VerticalSeparator]", 
     StyleBox["x", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    SqrtBox[
     FractionBox[
      RowBox[{"2", 
       StyleBox["\[Lambda]", "TI"], "\[CapitalDelta]", 
       StyleBox["t", "TI"]}], "\[Pi]"]], 
    StyleBox["exp",
     FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", "[", 
    RowBox[{"-", "2", 
     StyleBox["\[Lambda]", "TI"], "\[CapitalDelta]", 
     StyleBox["t", "TI"], 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["x", "TI"], "_"], 
         StyleBox["k", "TI"]], "-", 
        StyleBox["x", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"]}], "]"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"65c68cd4-240c-4eef-\
ac2d-57844bbda80b"],

Cell["\<\
Its normalization, center, and variance follow from one integral:\
\>", "Text",ExpressionUUID->"2d3329aa-fb56-4fe8-8d66-2360a64971df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"responsePDF", "[", 
     RowBox[{"reading_", ",", " ", "position_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", "strength", " ", 
       RowBox[{"binWidth", " ", "/", " ", "Pi"}]}], "]"}], " ", 
     RowBox[{"Exp", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "strength", " ", "binWidth", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"reading", " ", "-", " ", "position"}], ")"}], "^", "2"}]}], 
      "\n", "]"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"FullSimplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"Integrate", "[", "\n", "        ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "reading", ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"reading", " ", "-", " ", "position"}], ")"}], "^", "2"}]}],
        "}"}], " ", 
      RowBox[{"responsePDF", "[", 
       RowBox[{"reading", ",", " ", "position"}], "]"}]}], ",", "\n", 
     "        ", 
     RowBox[{"{", 
      RowBox[{"reading", ",", " ", 
       RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], "\n", 
    "    ", "]"}], ",", "\n", "    ", "assumptions"}], "\n", "]"}]}], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"3028ffb4-86dc-4ce4-b676-7b948ba4849f"],

Cell["The result is", "Text",ExpressionUUID->"01bd4bd4-c388-42be-a2cd-c496afbfe821"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", 
     StyleBox["x", "TI"], ",", " ", 
     FractionBox["1", 
      RowBox[{"4", 
       StyleBox["\[Lambda]", "TI"], "\[CapitalDelta]", 
       StyleBox["t", "TI"]}]]}], "}"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"3465ed99-c196-4632-\
9e34-3ddce378d6c6"],

Cell["The first entry proves", "Text",ExpressionUUID->"9b695680-39fa-405f-8a3a-4053c058716f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]",
     LimitsPositioning->False], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["M", "TI"], "^"], "\[Dagger]"], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["x", "TI"], "_"], 
     StyleBox["k", "TI"]], 
    StyleBox[")",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["M", "TI"], "^"], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["x", "TI"], "_"], 
     StyleBox["k", "TI"]], 
    StyleBox[")",
     SpanMaxSize->1], " ", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["x", "TI"], "_"], 
     StyleBox["k", "TI"]], "=", 
    OverscriptBox[
     StyleBox["I", "TI"], "^"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"8649553d-7e9b-4300-\
9533-04d1f5ef2a23"],

Cell["\<\
The same response can be represented directly as a Wolfram Language \
distribution:\
\>", "Text",ExpressionUUID->"9710a65e-5e54-491a-8155-659fdbac78d2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"conditionalReadingDistribution", "[", "position_", "]"}], " ", ":=",
     " ", 
    RowBox[{"NormalDistribution", "[", "\n", "    ", 
     RowBox[{"position", ",", "\n", "    ", 
      RowBox[{"1", " ", "/", " ", 
       RowBox[{"(", 
        RowBox[{"2", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"strength", " ", "binWidth"}], "]"}]}], ")"}]}]}], "\n", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"FullSimplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"{", "\n", "        ", 
    RowBox[{
     RowBox[{
      RowBox[{"PDF", "[", 
       RowBox[{
        RowBox[{"conditionalReadingDistribution", "[", "position", "]"}], ",",
         " ", "reading"}], "]"}], " ", "==", " ", 
      RowBox[{"responsePDF", "[", 
       RowBox[{"reading", ",", " ", "position"}], "]"}]}], ",", "\n", 
     "        ", 
     RowBox[{"Mean", "[", 
      RowBox[{"conditionalReadingDistribution", "[", "position", "]"}], "]"}],
      ",", "\n", "        ", 
     RowBox[{"StandardDeviation", "[", 
      RowBox[{"conditionalReadingDistribution", "[", "position", "]"}], "]"}],
      ",", "\n", "        ", 
     RowBox[{"Variance", "[", 
      RowBox[{"conditionalReadingDistribution", "[", "position", "]"}], 
      "]"}]}], "\n", "    ", "}"}], ",", "\n", "    ", "assumptions"}], "\n", 
  "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"da5c19e1-5672-4b61-be44-a25100a7b637"],

Cell[TextData[{
 "The returned list confirms the same density, mean ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ac094bb-3167-47ef-a529-13d600f10249"],
 ", standard deviation ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SqrtBox[
     RowBox[{
      StyleBox["\[Lambda]", "TI"], "\[CapitalDelta]", 
      StyleBox["t", "TI"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "362635bb-0e2b-4ab5-a1ad-87042358abfa"],
 ", and variance ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"4", 
    StyleBox["\[Lambda]", "TI"], "\[CapitalDelta]", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b41b623-440b-4a35-9f06-7db8a0d40b7e"],
 ". In both the mathematics and Wolfram Language, ",
 Cell[BoxData[
  RowBox[{"\|01d4a9", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], ",", 
    StyleBox["s", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9204ce33-674e-4ae3-b29e-beced23a825e"],
 " or ",
 Cell[BoxData[
  RowBox[{"NormalDistribution", "[", 
   RowBox[{"m", ",", "s"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bda5b59c-4520-4708-a86b-6987255765ee"],
 " means a normal Gaussian distribution with mean ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a23807d2-4f57-4ada-9144-dfbaafc25663"],
 " and standard deviation ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe50fef6-b3b8-459f-87d8-5c88e935512b"],
 ", not variance ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82f675d0-91f9-4f33-b7be-0ef1576a19ba"],
 "."
}], "Text",ExpressionUUID->"6222f785-2061-475a-b57a-811d470726b0"],

Cell["The probability density for the actual detector output is", "Text",ExpressionUUID->"bbbc338c-6ce5-4d43-939c-a480e086c8f8"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["p", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["x", "TI"], "_"], 
       StyleBox["k", "TI"]], "\[VerticalSeparator]", 
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["k", "TI"]]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    SuperscriptBox[GridBox[{
       {GridBox[{
          {
           RowBox[{
            OverscriptBox[
             StyleBox["M", "TI"], "^"], 
            RowBox[{
             StyleBox["(",
              SpanMaxSize->1], 
             SubscriptBox[
              OverscriptBox[
               StyleBox["x", "TI"], "_"], 
              StyleBox["k", "TI"]], 
             StyleBox[")",
              SpanMaxSize->1]}], 
            TemplateBox[{
              SubscriptBox[
               StyleBox["\[Psi]", "TI"], 
               StyleBox["k", "TI"]]},
             "Ket"]}]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.22}}}], "2"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]",
      LimitsPositioning->False], 
     RowBox[{
      SuperscriptBox[GridBox[{
         {
          RowBox[{
           SubscriptBox[
            StyleBox["\[Psi]", "TI"], 
            StyleBox["k", "TI"]], 
           StyleBox["(",
            SpanMaxSize->1], 
           StyleBox["x", "TI"], 
           StyleBox[")",
            SpanMaxSize->1]}]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
      SubscriptBox[
       StyleBox["g", "TI"], 
       RowBox[{"\[CapitalDelta]", 
        StyleBox["t", "TI"]}]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["x", "TI"], "_"], 
         StyleBox["k", "TI"]], "\[VerticalSeparator]", 
        StyleBox["x", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      StyleBox["d", "TI"], 
      RowBox[{
       StyleBox["x", "TI"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"12d5faf4-c002-4083-\
9533-4def24eb9eab"],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f76ae735-ca41-43ae-9f83-558e2ecc75f8"],
 " is only the integration variable labeling position eigenvalues. It is not \
a second measured value and it is not a hidden particle position. The formula \
says that the detector reading is a position measurement broadened by the \
Gaussian response ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["g", "TI"], 
   RowBox[{"\[CapitalDelta]", 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bd35f10-ae8a-4d9b-bcd9-bcdf35ee5883"],
 "."
}], "Text",ExpressionUUID->"afffe9fe-ef26-4a39-9ec9-351798c89fc4"],

Cell[TextData[{
 "Once ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "_"], "0"], ",", "\[Ellipsis]", ",", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "_"], 
    RowBox[{
     StyleBox["k", "TI"], "-", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84387c63-a4e9-4b7f-8129-afa933e9376b"],
 " have been observed, they determine ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox[
     StyleBox["\[Psi]", "TI"], 
     StyleBox["k", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf1f5a4c-39ab-4de0-a157-78d382c041df"],
 ". The density above then gives the probabilities for the next, not yet \
observed value ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["x", "TI"], "_"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "471942b8-c08f-4ba6-b862-4a261868eac1"],
 "."
}], "Text",ExpressionUUID->"175f2eb0-bdae-406b-b1e1-13dc7b24f6a9"],

Cell["\<\
The inner Gaussian averages needed for the first two moments are:\
\>", "Text",ExpressionUUID->"e8108e91-37af-403c-9d8c-bcf3747ddea6"],

Cell[BoxData[
 RowBox[{"conditionalRecordMoments", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"Integrate", "[", "\n", "        ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", "\n", "            ", 
        RowBox[{"reading", ",", "\n", "            ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"reading", " ", "-", " ", "meanPosition"}], ")"}], "^", 
          "2"}]}], "\n", "        ", "}"}], " ", 
       RowBox[{"responsePDF", "[", 
        RowBox[{"reading", ",", " ", "position"}], "]"}]}], ",", "\n", 
      "        ", 
      RowBox[{"{", 
       RowBox[{"reading", ",", " ", 
        RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], "\n", 
     "    ", "]"}], ",", "\n", "    ", "assumptions"}], "\n", 
   "]"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"3daf84c1-14d4-404c-a04a-076d12237c54"],

Cell["The result is", "Text",ExpressionUUID->"ef8dd3f4-de4b-4f89-99d2-9638c88e7982"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     StyleBox["x", "TI"], ",", " ", 
     RowBox[{
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         StyleBox["x", "TI"], "-", 
         SubscriptBox[
          RowBox[{
           StyleBox["\[LeftAngleBracket]",
            SpanMaxSize->1], 
           OverscriptBox[
            StyleBox["x", "TI"], "^"], 
           StyleBox["\[RightAngleBracket]",
            SpanMaxSize->1]}], 
          StyleBox["k", "TI"]]}], 
        StyleBox[")",
         SpanMaxSize->1]}], "2"], "+", 
      FractionBox["1", 
       RowBox[{"4", 
        StyleBox["\[Lambda]", "TI"], "\[CapitalDelta]", 
        StyleBox["t", "TI"]}]]}]}], "}"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"50b78c9a-9031-4b65-\
bb9d-f3a05c556a4e"],

Cell[TextData[{
 "The outer Born average needs only normalization, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     StyleBox["x", "TI"], "\[VeryThinSpace]", 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["k", "TI"]], "=", 
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["x", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d634dab-437a-4b9e-8ef0-9fa50d53ce81"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SuperscriptBox[
      StyleBox["x", "TI"], "2"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["k", "TI"]], "=", 
   SubscriptBox[
    StyleBox["Var",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["\[Psi]", "TI"], 
     StyleBox["k", "TI"]]], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   SubsuperscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["x", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["k", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "580d9fb5-6943-4de1-9dde-58379ccfe600"],
 ". Because the two inner moments are at most quadratic in ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ddb0c574-5061-4b37-b2d2-4c2b576e2143"],
 ", these three identities complete the average without assuming a shape for ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      RowBox[{
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], 
        StyleBox["k", "TI"]], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["x", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67b59d9a-e813-4a9e-b489-c1dd00a3d9e0"],
 ":"
}], "Text",ExpressionUUID->"de6186d8-d87d-486c-95b5-559ca3f66969"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bornMomentRules", " ", "=", " ", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"position", "^", "2"}], " ", "->", " ", 
       RowBox[{"positionVariance", " ", "+", " ", 
        RowBox[{"meanPosition", "^", "2"}]}]}], ",", "\n", "    ", 
      RowBox[{"position", " ", "->", " ", "meanPosition"}]}], "\n", "}"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{"recordMoments", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", "\n", "    ", 
   RowBox[{
    RowBox[{
     RowBox[{"Expand", "[", "conditionalRecordMoments", "]"}], " ", "/.", " ",
      "bornMomentRules"}], ",", "\n", "    ", "assumptions"}], "\n", 
   "]"}]}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"d639575d-20d9-4b20-b6b1-122a7404521b"],

Cell["\<\
The constant terms are unchanged because the Born density integrates to one. \
The returned pair gives\
\>", "Text",ExpressionUUID->"3f7f6d0b-6152-477b-bac3-a540274046e4"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"\|01d53c", 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["x", "TI"], "_"], 
      StyleBox["k", "TI"]], "\[VerticalSeparator]", 
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], 
      StyleBox["k", "TI"]]}], 
    StyleBox["]",
     SpanMaxSize->1], "=", 
    StyleBox["\[Integral]",
     FontSize->1.4 Inherited], 
    StyleBox["x", "TI"], 
    SuperscriptBox[GridBox[{
       {
        RowBox[{
         SubscriptBox[
          StyleBox["\[Psi]", "TI"], 
          StyleBox["k", "TI"]], 
         StyleBox["(",
          SpanMaxSize->1], 
         StyleBox["x", "TI"], 
         StyleBox[")",
          SpanMaxSize->1]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
    StyleBox["d", "TI"], 
    StyleBox["x", "TI"], "=", 
    SubscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["x", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox["k", "TI"]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"3d385844-4f70-4710-\
95bf-d43a1d6a784b"],

Cell["and", "Text",ExpressionUUID->"05f7ca7f-4ab1-4316-b5ef-7b7c855dc0fe"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["Var",
     FontSlant->"Plain"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["x", "TI"], "_"], 
      StyleBox["k", "TI"]], "\[VerticalSeparator]", 
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], 
      StyleBox["k", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    SubscriptBox[
     RowBox[{"\[LeftAngleBracket]", 
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         OverscriptBox[
          StyleBox["x", "TI"], "^"], "-", 
         SubscriptBox[
          RowBox[{
           StyleBox["\[LeftAngleBracket]",
            SpanMaxSize->1], 
           OverscriptBox[
            StyleBox["x", "TI"], "^"], 
           StyleBox["\[RightAngleBracket]",
            SpanMaxSize->1]}], 
          StyleBox["k", "TI"]]}], 
        StyleBox[")",
         SpanMaxSize->1]}], "2"], "\[RightAngleBracket]"}], 
     StyleBox["k", "TI"]], "+", 
    FractionBox["1", 
     RowBox[{"4", 
      StyleBox["\[Lambda]", "TI"], "\[CapitalDelta]", 
      StyleBox["t", "TI"]}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"9893679e-17c7-4b75-\
8d16-ff54459e84f8"],

Cell[TextData[{
 "No probability distribution for the state position has been assumed beyond \
the Born density ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      RowBox[{
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], 
        StyleBox["k", "TI"]], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["x", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a2e7434-b3b9-495b-b6b3-48163bb2653d"],
 "."
}], "Text",ExpressionUUID->"8405bb4e-cc9c-4197-8c43-fdc4266ca14d"],

Cell[TextData[{
 "Given the observed ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["x", "TI"], "_"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5538bdd-e26d-4d72-9206-7fb47dc0a8f4"],
 ", the normalized state update is"
}], "Text",ExpressionUUID->"f5c3010f-2e80-4d0a-b99f-733fbb046994"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       RowBox[{
         StyleBox["k", "TI"], "+", "1"}]]},
     "Ket"], "=", 
    FractionBox[
     RowBox[{
      OverscriptBox[
       StyleBox["U", "TI"], "^"], 
      OverscriptBox[
       StyleBox["M", "TI"], "^"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["x", "TI"], "_"], 
        StyleBox["k", "TI"]], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      TemplateBox[{
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], 
         StyleBox["k", "TI"]]},
       "Ket"]}], GridBox[{
       {GridBox[{
          {
           RowBox[{
            OverscriptBox[
             StyleBox["U", "TI"], "^"], 
            OverscriptBox[
             StyleBox["M", "TI"], "^"], 
            RowBox[{
             StyleBox["(",
              SpanMaxSize->1], 
             SubscriptBox[
              OverscriptBox[
               StyleBox["x", "TI"], "_"], 
              StyleBox["k", "TI"]], 
             StyleBox[")",
              SpanMaxSize->1]}], 
            TemplateBox[{
              SubscriptBox[
               StyleBox["\[Psi]", "TI"], 
               StyleBox["k", "TI"]]},
             "Ket"]}]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.22}}}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    OverscriptBox[
     StyleBox["U", "TI"], "^"], "=", 
    RowBox[{
     StyleBox["exp",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         StyleBox["i", "TI"], "\[HBar]"]}], 
       OverscriptBox[
        StyleBox["H", "TI"], "^"], "\[CapitalDelta]", 
       StyleBox["t", "TI"]}], ")"}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox[
       StyleBox["H", "TI"], "^"], "\[Dagger]"], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"606bdb79-8508-40e0-\
8979-e844b140d915"],

Cell["The record variable that has a continuous limit", "Section",ExpressionUUID->"3fc4093d-7fd7-4fe4-adf9-81f9bc9738bb"],

Cell[TextData[{
 "The variance of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["x", "TI"], "_"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5934596-80a8-42a2-abde-72fe29fb7fa8"],
 " diverges like ",
 Cell[BoxData[
  RowBox[{"1", "/", "\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "389bf3c1-e0d3-4ed4-891e-00d03bbdac67"],
 ", so the individual readings do not approach finite values as ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["t", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5449cada-304c-4178-81f8-e29181c87048"],
 ". We therefore seek a scaled increment whose variance is proportional to ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33d643ce-e96f-4755-bc7e-4feb08a5b82c"],
 ". Such increments vanish individually but accumulate a finite variance over \
a fixed duration."
}], "Text",ExpressionUUID->"62384b9c-2c33-4443-9d22-1009ad75e14b"],

Cell[TextData[{
 "The power of ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b871bb56-fcef-488e-b133-8dbb566bf393"],
 " is fixed by this requirement. Keeping only the leading detector variance, \
scaling each reading by ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SuperscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["\[Alpha]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bf983971-4706-44c2-90ab-fc2f5a5e7f9d"],
 " gives accumulated variance"
}], "Text",ExpressionUUID->"2797e60f-9a1a-4a11-b078-3985dfdcdbd9"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    FractionBox[
     StyleBox["T", "TI"], 
     RowBox[{"\[CapitalDelta]", 
      StyleBox["t", "TI"]}]], "\[Times]", 
    FractionBox[
     RowBox[{"\[CapitalDelta]", 
      SuperscriptBox[
       StyleBox["t", "TI"], 
       RowBox[{"2", 
        StyleBox["\[Alpha]", "TI"]}]]}], 
     RowBox[{"4", 
      StyleBox["\[Lambda]", "TI"], "\[CapitalDelta]", 
      StyleBox["t", "TI"]}]], "=", 
    FractionBox[
     StyleBox["T", "TI"], 
     RowBox[{"4", 
      StyleBox["\[Lambda]", "TI"]}]], "\[CapitalDelta]", 
    SuperscriptBox[
     StyleBox["t", "TI"], 
     RowBox[{"2", 
      StyleBox["\[Alpha]", "TI"], "-", "2"}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"7a610af8-a487-49dc-\
a722-ee55a436d202"],

Cell["The three relevant cases are computed directly:", "Text",ExpressionUUID->"373d349f-c5a6-4d81-b31a-7d2bf2e78e69"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"leadingAccumulatedVariance", "[", "power_", "]"}], " ", ":=", 
    " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"totalTime", " ", "/", " ", "binWidth"}], ")"}], " ", 
     RowBox[{
      RowBox[{"binWidth", "^", 
       RowBox[{"(", 
        RowBox[{"2", " ", "power"}], ")"}]}], " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"4", " ", "strength", " ", "binWidth"}], ")"}]}]}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"FullSimplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"{", "\n", "        ", 
    RowBox[{
     RowBox[{"Limit", "[", "\n", "            ", 
      RowBox[{
       RowBox[{"leadingAccumulatedVariance", "[", 
        RowBox[{"1", " ", "/", " ", "2"}], "]"}], ",", "\n", "            ", 
       RowBox[{"binWidth", " ", "->", " ", "0"}], ",", "\n", "            ", 
       RowBox[{"Direction", " ", "->", " ", "\"\<FromAbove\>\""}]}], "\n", 
      "        ", "]"}], ",", "\n", "        ", 
     RowBox[{"leadingAccumulatedVariance", "[", "1", "]"}], ",", "\n", 
     "        ", 
     RowBox[{"Limit", "[", "\n", "            ", 
      RowBox[{
       RowBox[{"leadingAccumulatedVariance", "[", 
        RowBox[{"3", " ", "/", " ", "2"}], "]"}], ",", "\n", "            ", 
       RowBox[{"binWidth", " ", "->", " ", "0"}], ",", "\n", "            ", 
       RowBox[{"Direction", " ", "->", " ", "\"\<FromAbove\>\""}]}], "\n", 
      "        ", "]"}]}], "\n", "    ", "}"}], ",", "\n", "    ", 
   "assumptions"}], "\n", "]"}]}], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"4ef1865d-ad01-45f3-8928-8d436524e9e3"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "\[Infinity]"}], ",", 
   RowBox[{
    StyleBox["T", "TI"], "/", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"4", 
     StyleBox["\[Lambda]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   RowBox[{"0", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58545fae-6470-43a8-b035-6ffd9dbec2fe"],
 ". A smaller power makes the accumulated variance diverge, a larger power \
removes the noise, and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05c88525-8829-4e25-a6c1-cc44aae43e0f"],
 " is the unique finite nonzero choice."
}], "Text",ExpressionUUID->"db8051eb-15f7-473c-a41f-6d01757e388d"],

Cell[TextData[{
 "The remaining positive scale factor is chosen so that the leading variance \
over time ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0627ba1-2f81-41d0-882d-773883aa3c80"],
 " is exactly ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80660841-bdf6-4652-829e-f0f27fa4a00a"],
 ":"
}], "Text",ExpressionUUID->"92322fe0-dfb2-4c43-b8a8-091fb78d54d8"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"Solve", "[", "\n", "        ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"scale", "^", "2"}], " ", "/", " ", 
        RowBox[{"(", 
         RowBox[{"4", " ", "strength"}], ")"}]}], " ", "==", " ", "1"}], " ", 
      "&&", " ", 
      RowBox[{"scale", " ", ">", " ", "0"}]}], ",", "\n", "        ", "scale",
      ",", "\n", "        ", "Reals"}], "\n", "    ", "]"}], ",", "\n", 
   "    ", "assumptions"}], "\n", "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"866c5166-5f28-45ee-a913-93b7645b4c17"],

