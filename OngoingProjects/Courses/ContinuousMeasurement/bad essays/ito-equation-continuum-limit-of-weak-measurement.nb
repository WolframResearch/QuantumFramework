        StyleBox[")",
         SpanMaxSize->1]}], "2"], 
      RowBox[{"4", "\[CapitalDelta]", 
       StyleBox["t", "TI"]}]]}], "]"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"606a6b61-c38e-4bf0-\
87a7-2d6f26bbc021"],

Cell["\<\
The same factor appears in the norm and cancels exactly. The scalar ratio is:\
\
\>", "Text",ExpressionUUID->"ed7b5d43-6815-409b-8841-68e9397f7292"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"centeredValue", "^", "2"}]}], " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"4", " ", "binWidth"}], ")"}]}], "]"}], " ", "/", " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"centeredValue", "^", "2"}]}], " ", "/", " ", 
       RowBox[{"(", 
        RowBox[{"2", " ", "binWidth"}], ")"}]}], "]"}], "]"}]}], ",", "\n", 
   "    ", "assumptions"}], "\n", "]"}]], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"3308355b-f50c-4f8b-98cc-15fb247b5ae7"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4329a66d-a159-4214-ade0-32d390b048fe"],
 ". Therefore the state-changing part of the measurement operator is"
}], "Text",ExpressionUUID->"c1268cf3-e405-4fe6-b46e-fa6ba0f2b948"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["exp",
     FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", "(", 
    RowBox[{
     SqrtBox[
      StyleBox["\[Lambda]", "TI"]], " ", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["A", "TI"], "^"], 
      StyleBox["k", "TI"]], "\[CapitalDelta]", 
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["k", "TI"]], "-", 
     StyleBox["\[Lambda]", "TI"], 
     SubsuperscriptBox[
      OverscriptBox[
       StyleBox["A", "TI"], "^"], 
      StyleBox["k", "TI"], "2"], "\[CapitalDelta]", 
