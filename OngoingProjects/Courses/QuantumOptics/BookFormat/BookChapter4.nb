Cell[TextData[{
 "Considering a general initial state |\[Psi](",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "76d33574-ac17-be45-ac31-bb76aeff5d79"],
 ")\[RightAngleBracket] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["c", "a"], "(", "t", ")"}], Cell[
    "|",ExpressionUUID->"1fe86e53-1ec1-7742-98a2-152c499d2a02"], "a", Cell[
    "\[RightAngleBracket]",ExpressionUUID->
     "a9f3aa35-bfee-d94b-a2f1-39d89318e9dd"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4001bf9b-b4f3-ef4b-b136-3dd0999cc084"],
 " + ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["c", "b"], "(", "t", ")"}], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", 
      SubscriptBox["\[Omega]", "0"], "t"}]], Cell[
    "|",ExpressionUUID->"13ccbf03-df02-3946-8c54-31d01c531228"], "b", Cell[
    "\[RightAngleBracket]",ExpressionUUID->
     "ad685faa-0eec-3345-b7d6-bf88c5c1c688"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6b518c53-0221-e94f-a2c2-de58b75fa2e3"],
 ", the exponential contemplates the free evolution:"
}], "Text",
 CellID->244280574,ExpressionUUID->"0e29db78-dffe-5a42-9fa2-c41c53a6fa6e"],

