Cell[TextData[{
 "Extracting the probability of finding the atom in |",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d900ef92-acdf-3145-99f4-f91b00d0d134"],
 "\[RightAngleBracket] state:"
}], "Text",
 CellID->507177693,ExpressionUUID->"e7acc932-ca7e-004a-9535-a15a7b4e5aae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"probFuncs", " ", "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"solvedState", "[", 
          RowBox[{"t", ",", "#", ",", 
           SqrtBox[
            RowBox[{"1", "+", 
             SuperscriptBox["#", "2"]}]], ",", "1"}], "]"}], 
         "[", "\"\<Probability\>\"", "]"}], "[", 
        InterpretationBox[
         StyleBox[
          TemplateBox[{
            RowBox[{"\"b\""}]},
           "Ket"],
          FontWeight->"Plain"],
         Wolfram`QuantumFramework`QuditName["b", "Dual" -> False]], "]"}], 
       "&"}], " ", "/@", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "3"}], "]"}]}], " ", "/.", " ", 
     RowBox[{"\[Phi]", "->", "0"}]}], ")"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9322287326857224`*^9, 3.9322287676631393`*^9}, {
   3.932228803279045*^9, 3.932228979202133*^9}, {3.932229015110035*^9, 
   3.932229070005354*^9}, 3.93222912880805*^9, {3.932229168004705*^9, 
   3.9322291920543766`*^9}, {3.932229537045353*^9, 3.932229547237578*^9}, {
   3.932229606591608*^9, 3.932229616544935*^9}, {3.934295249007887*^9, 
   3.9342952530447865`*^9}},
 CellLabel->"In[223]:=",
 CellID->7282976,ExpressionUUID->"38f1aed1-b31f-2b4b-8885-be07ddf4345a"],

Cell["Plotting the results:", "Text",
 CellChangeTimes->{{3.953755704634123*^9, 3.953755709339281*^9}},
 CellID->320022338,ExpressionUUID->"826c5c0e-47f7-3942-a3ad-6fa0f59e8805"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{"probFuncs", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"6", "\[Pi]"}]}], "}"}], ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["6", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["1320", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    Frame -> True, 
     FrameLabel -> {
      "t \!\(\*SubscriptBox[\(\[CapitalOmega]\), \(1\)]\)", 
       "\!\(\*SubscriptBox[\(P\), \(a  \[Rule]  b\)]\)"}, 
     PlotLegends -> {
      "\[Delta] = 0", 
