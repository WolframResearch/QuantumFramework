   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"bareState", "[", 
          RowBox[{"0", ",", "n"}], "]"}], "\[Dagger]"], " ", "@", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"H0", "+", "H1"}], ")"}], " ", "@", " ", 
         RowBox[{"bareState", "[", 
          RowBox[{"0", ",", "n"}], "]"}]}]}], ")"}], "[", "\"\<Scalar\>\"", 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", 
       RowBox[{"$FockSize", "-", "2"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H00theory", " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"h", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", " ", "\[Nu]"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"1", "/", "2"}], " ", "\[Omega]"}]}], ")"}]}], "]"}], 
      "&"}], ",", 
     RowBox[{"$FockSize", "-", "1"}], ",", "0"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[278]:=",
 CellID->194108661,ExpressionUUID->"a814dcf3-2d17-ec47-86d4-8333ea4136f4"],

