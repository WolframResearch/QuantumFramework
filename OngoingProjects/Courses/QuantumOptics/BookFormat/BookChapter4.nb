Cell[TextData[{
 "To analyze the matrix element ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "ik"], TraditionalForm]],ExpressionUUID->
  "bee8d29f-c7bf-0a49-a656-f3575da5cbe0"],
 " we consider the form of the electric field as  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["E",
      FontWeight->"Bold"], "(", 
     SubscriptBox["r", "0"], ")"}], " ", "=", " ", 
    RowBox[{"\[Epsilon]", " ", 
     RowBox[{"E", "(", 
      SubscriptBox["r", "0"], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "7ff0d688-c7dd-bf43-8f90-a5004b52cd5f"],
 " where \[Epsilon] is a unit polarization vector "
}], "Text",
 CellChangeTimes->{{3.932124352590187*^9, 3.932124354091875*^9}, {
  3.932124424348243*^9, 3.932124503608963*^9}, {3.932127733411642*^9, 
  3.932127904388132*^9}, {3.932134788608692*^9, 3.9321348283658504`*^9}, {
  3.932134874557715*^9, 3.932135014085266*^9}, {3.934281715392897*^9, 
  3.934281716966414*^9}, {3.9342818151743584`*^9, 3.9342818391494274`*^9}, {
  3.934281873823847*^9, 3.934281875955288*^9}, {3.9666188254233704`*^9, 
  3.96661886322661*^9}},
 CellID->62033676,ExpressionUUID->"b97df80c-47b7-3d4d-acd6-9843c06009b8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["W", 
    RowBox[{"k", "i"}]], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"k", "|", 
       RowBox[{
        OverscriptBox["D", "^"], "\[CenterDot]", "\[Epsilon]"}], "|", "i"}], 
      "\[RightAngleBracket]"}]}], "=", 
    RowBox[{
     RowBox[{"-", Cell[TextData[Cell[BoxData[
       FormBox["d", TraditionalForm]],
       FormatType->TraditionalForm,ExpressionUUID->
       "5fa7a34c-87c1-3045-aa27-4ae48bd40d2e"]],ExpressionUUID->
       "18da9e2c-7885-e848-8a59-fde859a3cd3a"]}], " ", 
     RowBox[{"E", "(", 
      SubscriptBox["r", "0"], ")"}]}]}]}], TraditionalForm]], "DisplayFormula",
 CellID->85100741,ExpressionUUID->"91c4cc7a-38e3-a244-9d6e-d3fec4191d0d"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eb46ffd7-edb8-564b-a259-05f77897c2e6"],
 " is the matrix element of the component of ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["D", "^"], TraditionalForm]],ExpressionUUID->
  "01b76912-9242-7140-98b2-933d132a3622"],
 " along the direction of the electric field, depending on the phase of the \
states ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "i"}], "\[RightAngleBracket]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3cbbc3fc-27cc-ec4c-9734-2ebe1e7a3ab7"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[VerticalSeparator]", "k"}], "\[RightAngleBracket]"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f3ceeb47-9615-a54a-a07d-54616a011186"],
 " it is possible to make the matrix element a real negative number so we can \
write"
}], "Text",
 CellChangeTimes->{{3.932124352590187*^9, 3.932124354091875*^9}, {
  3.932124424348243*^9, 3.932124503608963*^9}, {3.932127733411642*^9, 
  3.932127904388132*^9}, {3.932134788608692*^9, 3.9321348283658504`*^9}, {
  3.932134874557715*^9, 3.932135014085266*^9}, {3.934281715392897*^9, 
  3.934281716966414*^9}, {3.9342818151743584`*^9, 3.9342818391494274`*^9}, {
  3.934281873823847*^9, 3.934281875955288*^9}, {3.9666188254233704`*^9, 
  3.9666188256653976`*^9}, {3.9666188752567177`*^9, 3.9666188895759506`*^9}, {
  3.9666189270153465`*^9, 3.9666189547199383`*^9}},
 CellID->34391709,ExpressionUUID->"5a518780-7162-c245-969b-be7e5c2991c5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["W", 
    RowBox[{"k", "i"}]], "=", 
   RowBox[{"-", "d", " ", "E", 
    RowBox[{"(", 
     SubscriptBox["r", "0"], ")"}]}], "=", 
   RowBox[{"\[HBar]", " ", 
    SubscriptBox["\[CapitalOmega]", "1"]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->420342896,ExpressionUUID->"b86a2f4a-3ef4-274f-b91f-f1178b5c3d26"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "1"], " ", "is", " ", "said", " ", "to", " ",
     "be", " ", "the", " ", "Rabi", " ", "frequency", " "}], 
   TraditionalForm]],ExpressionUUID->"b0178c4a-a83a-5142-bb01-d237fb68db72"],
 "and the transition probability takes the form"
}], "Text",
 CellChangeTimes->{{3.932124352590187*^9, 3.932124354091875*^9}, {
  3.932124424348243*^9, 3.932124503608963*^9}, {3.932127733411642*^9, 
  3.932127904388132*^9}, {3.932134788608692*^9, 3.9321348283658504`*^9}, {
  3.932134874557715*^9, 3.932135014085266*^9}, {3.934281715392897*^9, 
  3.934281716966414*^9}, {3.9342818151743584`*^9, 3.9342818391494274`*^9}, {
  3.934281873823847*^9, 3.934281875955288*^9}, {3.9666188254233704`*^9, 
  3.9666188256653976`*^9}, {3.9666188752567177`*^9, 3.9666188895759506`*^9}, {
  3.9666189270153465`*^9, 3.966618974615633*^9}},
 CellID->24357541,ExpressionUUID->"e44fddbc-cae3-8b48-bbd7-06df72a4d79a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", 
     RowBox[{"i", "\[RightArrow]", "k"}]], 
    RowBox[{"(", "T", ")"}]}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SubscriptBox["\[CapitalOmega]", "1"], " ", "T"}], "2"], ")"}], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"sin", "(", 
        RowBox[{"\[Delta]", " ", 
         RowBox[{"T", "/", "2"}]}], ")"}], 
       RowBox[{"\[Delta]", " ", 
        RowBox[{"T", "/", "2"}]}]], ")"}], "2"]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->623758220,ExpressionUUID->"7735da12-d028-6e49-a5d2-385384191f70"],

Cell["\<\
This approach has limited applicability because it is only valid for \
transition probabilities small compared to unity.\
\>", "Text",
 CellChangeTimes->{{3.9321352379729805`*^9, 3.9321352946208324`*^9}, {
  3.9666189997585106`*^9, 3.966619002671133*^9}},
 CellID->422042,ExpressionUUID->"63cc0161-dcc7-2f49-a37c-1622e795feaa"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Rabi oscillations between two levels", \
"Subsubsection"]], "Subsubsection",
 CellChangeTimes->{{3.931892310671335*^9, 3.931892320434341*^9}},
 CellID->350033878,ExpressionUUID->"41e74742-5543-fb4b-9f1a-b4a5dfd4465a"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s try to use now a non perturbative approach to \
calculate the transition probability ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", 
    RowBox[{"i", " ", "->", " ", "k"}]], TraditionalForm]],ExpressionUUID->
  "3e15ebc4-0957-a349-b7bd-c201442b250b"],
 " in the quasi-resonant case  of angular frequency \[Omega] close to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{
     SubscriptBox["E", "k"], "-", 
     SubscriptBox["E", "i"]}], "|", 
    RowBox[{"/", "\[HBar]"}]}], TraditionalForm]],ExpressionUUID->
  "e6d36753-1c1f-3a4a-98a5-2a8211d8a8a0"],
 ". Using the two level atom approximation with states ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "a"}], "\[RightAngleBracket]"}], TraditionalForm]],
  ExpressionUUID->"1a33bd88-2bb3-9246-940b-17c092ff2d37"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "b"}], "\[RightAngleBracket]"}], TraditionalForm]],
  ExpressionUUID->"b54c8c02-6774-6a48-809a-355104be6098"],
 " and energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["E", "a"], ",", " ", 
    SubscriptBox["E", "b"]}], TraditionalForm]],ExpressionUUID->
  "d1307f27-6ed4-484d-8aad-4aa8ba75f4a4"],
 ", if we set ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["E", "a"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"9bd7d499-ab16-5a4c-9f48-2bd5ba004697"],
 " and let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "0"], " "}], TraditionalForm]],ExpressionUUID->
  "50c1e4e7-99a8-b84e-ba0b-37cd4caea1e1"],
 "be the Bohr frequency such ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["E", 
      RowBox[{"b", " "}]], "-", 
     SubscriptBox["E", "a"]}], " ", "=", " ", 
    RowBox[{"\[HBar]", " ", 
     SubscriptBox["\[Omega]", "0"]}]}], TraditionalForm]],ExpressionUUID->
  "526aff29-3133-4141-b74c-08c92aa88950"]
}], "Text",
 CellID->370733766,ExpressionUUID->"857a704b-e7f4-4840-84cb-70230d533a94"],

Cell["The free Hamiltonian is ", "Text",
 CellChangeTimes->{{3.932135443377762*^9, 3.932135978651565*^9}, {
   3.932136164466242*^9, 3.9321362253559074`*^9}, {3.93428191574226*^9, 
