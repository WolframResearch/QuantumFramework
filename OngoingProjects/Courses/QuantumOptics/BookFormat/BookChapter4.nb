 CellLabel->"In[217]:=",
 CellID->568827479,ExpressionUUID->"04a284db-ac84-f943-a23e-d079fd095e83"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   TooltipBox[
    StyleBox[
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["c", "\[FormalA]"], "\[Prime]",
            MultilineFunction->None], "(", "t", ")"}]}], "-", 
         RowBox[{
          SubscriptBox["\[CapitalOmega]", "1"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", 
            SubscriptBox["\[Omega]", "0"]}]], " ", 
          RowBox[{
           SubscriptBox["c", "\[FormalB]"], "(", "t", ")"}], " ", 
          RowBox[{"cos", "(", 
           RowBox[{
            RowBox[{"t", " ", "\[Omega]"}], "+", "\[Phi]"}], ")"}]}]}], ")"}], 
       FormBox[
        InterpretationBox[
         StyleBox[
          TemplateBox[{
            RowBox[{
              FormBox["\"a\"", TraditionalForm]}]},
           "Ket"],
          FontWeight->"Plain"],
         Wolfram`QuantumFramework`QuditName["a", "Dual" -> False]],
        TraditionalForm]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalOmega]", "1"], " ", 
          RowBox[{
           SubscriptBox["c", "\[FormalA]"], "(", "t", ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"-", 
            RowBox[{"cos", "(", 
             RowBox[{
              RowBox[{"t", " ", "\[Omega]"}], "+", "\[Phi]"}], ")"}]}], 
           ")"}]}], "+", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", 
               SubscriptBox["\[Omega]", "0"]}]], " ", 
             RowBox[{
              SuperscriptBox[
               SubscriptBox["c", "\[FormalB]"], "\[Prime]",
               MultilineFunction->None], "(", "t", ")"}]}], "-", 
            RowBox[{"\[ImaginaryI]", " ", 
             SubscriptBox["\[Omega]", "0"], " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", 
               SubscriptBox["\[Omega]", "0"]}]], " ", 
             RowBox[{
              SubscriptBox["c", "\[FormalB]"], "(", "t", ")"}]}]}], ")"}]}], "-", 
         RowBox[{
          SubscriptBox["\[Omega]", "0"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", 
            SubscriptBox["\[Omega]", "0"]}]], " ", 
          RowBox[{
           SubscriptBox["c", "\[FormalB]"], "(", "t", ")"}]}]}], ")"}], 
       FormBox[
        InterpretationBox[
         StyleBox[
          TemplateBox[{
            RowBox[{
              FormBox["\"b\"", TraditionalForm]}]},
           "Ket"],
          FontWeight->"Plain"],
         Wolfram`QuantumFramework`QuditName["b", "Dual" -> False]],
        TraditionalForm]}]}],
     ShowStringCharacters->False],
    TagBox[
     GridBox[{{"None"}, {
        TemplateBox[{"\"QuantumState: \"", 
          RowBox[{
            RowBox[{"{", "}"}], "\[Rule]", 
            RowBox[{"{", "2", "}"}]}]}, "RowDefault"]}}, 
      GridBoxAlignment -> {"Columns" -> {{Center}}}, DefaultBaseStyle -> 
      "Column", 
      GridBoxItemSize -> {
       "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"]],
   Wolfram`QuantumFramework`QuantumState[
   SparseArray[
    Automatic, {2}, 0, {
     1, {{0, 2}, {{1}, {
       2}}}, {-E^(Complex[0, -1] $CellContext`t 
          Subscript[$CellContext`\[Omega], 0]) 
        Cos[$CellContext`\[Phi] + $CellContext`t $CellContext`\[Omega]] 
        Subscript[$CellContext`\[CapitalOmega], 1] 
        Subscript[$CellContext`c, \[FormalB]][$CellContext`t] + 
       Complex[0, 1] 
        Derivative[1][
         Subscript[$CellContext`c, \[FormalA]]][$CellContext`t], -
        Cos[$CellContext`\[Phi] + $CellContext`t $CellContext`\[Omega]] 
        Subscript[$CellContext`\[CapitalOmega], 1] 
        Subscript[$CellContext`c, \[FormalA]][$CellContext`t] - 
       E^(Complex[0, -1] $CellContext`t Subscript[$CellContext`\[Omega], 0]) 
       Subscript[$CellContext`\[Omega], 0] 
       Subscript[$CellContext`c, \[FormalB]][$CellContext`t] + 
       Complex[0, 1] (
         Complex[0, -1] 
          E^(Complex[0, -1] $CellContext`t 
            Subscript[$CellContext`\[Omega], 0]) 
          Subscript[$CellContext`\[Omega], 0] 
          Subscript[$CellContext`c, \[FormalB]][$CellContext`t] + 
         E^(Complex[0, -1] $CellContext`t Subscript[$CellContext`\[Omega], 0])
             Derivative[1][
           Subscript[$CellContext`c, \[FormalB]]][$CellContext`t])}}], 
    Wolfram`QuantumFramework`QuantumBasis[<|
     "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
           
           Wolfram`QuantumFramework`QuditName[\[FormalCapitalI], "Dual" -> 
            False], 1} -> 1|>], "Output" -> 
      Wolfram`QuantumFramework`QuditBasis[<|{
           Wolfram`QuantumFramework`QuditName["a", "Dual" -> False], 1} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName["b", "Dual" -> False], 1} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
      "Picture" -> "Schrodinger", "Label" -> None, "ParameterSpec" -> {}|>]]],
   TraditionalForm]], "Output",
 CellLabel->"Out[217]=",
 CellID->462123004,ExpressionUUID->"e1b9ba5c-56a6-7e40-9a58-a4d8eb3b10e8"]
}, Open  ]],

