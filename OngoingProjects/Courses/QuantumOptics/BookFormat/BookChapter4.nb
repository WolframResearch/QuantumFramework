Cell[TextData[{
 "At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", " ", "t"}], " ", "=", " ", "30"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40a54af3-295b-6840-bf85-6f8eeaa6c068"],
 " the distribution looks similar to the initial one, around that time the \
revival is more pronounced"
}], "Text",
 CellChangeTimes->{{3.966629299468191*^9, 3.9666293101715584`*^9}, {
  3.9666295733832455`*^9, 3.966629618634121*^9}},
 CellID->869107726,ExpressionUUID->"19a98532-d0ed-174f-afde-3da837923b69"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Density operator applied to thermal states", \
"Subsubsection"]], "Subsubsection",
 CellChangeTimes->{{3.926615967610342*^9, 3.926616012892992*^9}, 
   3.926634351202017*^9, {3.9667047716988125`*^9, 3.9667047731155624`*^9}},
 CellID->475834616,ExpressionUUID->"0ae900ca-95ff-264c-9727-61a7e535130a"],

Cell[TextData[{
 "Atom initially in the superposition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", 
     SqrtBox["2"]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"|", "e", "\[RightAngleBracket]"}], "+", 
      RowBox[{"|", "g", "\[RightAngleBracket]"}]}], ")"}]}], 
   TraditionalForm]], "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{{3.9858909352880764`*^9, 3.9858909553790417`*^9}},
  ExpressionUUID->"d55fc77a-6d51-1646-b799-b58e8fc9648f"],
 " , and we consider the field in a thermal state(thermal state will be \
treated symbolically):"
}], "Text",
 CellID->743876693,ExpressionUUID->"d3fd8024-debe-f047-be28-da3ff044cb27"],

Cell["Define the state:", "Text",
 CellID->249264975,ExpressionUUID->"173ce712-c247-cb40-8e6e-b453502e69f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<+\>\"", ",", "atomBasis"}], "]"}], ",", 
     RowBox[{"ThermalState", "[", "x", "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[267]:=",
 CellID->159212180,ExpressionUUID->"99e2e486-07b4-4f41-984c-e948ef686fb1"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["\[Rho]", "0"], "Text"], TraditionalForm]], "CodeText",
  ExpressionUUID->"8f6967c5-8786-0544-9e5e-1dc0e9699c78"],
 " is a matrix state:"
}], "Text",
 CellID->501538559,ExpressionUUID->"cc487f7d-b76c-584b-9b30-ea8ed9600630"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Rho]0", "[", "\"\<StateType\>\"", "]"}]], "Input",
 CellLabel->"In[268]:=",
 CellID->706726385,ExpressionUUID->"7db9adfd-dc68-bf44-8aef-8ec3dcba6214"],

Cell[BoxData["\<\"Matrix\"\>"], "Output",
 CellLabel->"Out[268]=",
 CellID->62034293,ExpressionUUID->"46af314f-5188-9a4b-9885-e550f92db00a"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Shortcut for matrix states to describe the evolution operation ", 
  "Text"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", "t", ")"}], " ", "=", 
    RowBox[{
     RowBox[{
      OverscriptBox["U", "^"], "(", "t", ")"}], " ", 
     RowBox[{"\[Rho]", "(", "0", ")"}], " ", 
     RowBox[{
      SuperscriptBox[
       OverscriptBox["U", "^"], "\[Dagger]"], "(", "t", ")"}]}]}], 
   TraditionalForm]], "Text",
  FontColor->GrayLevel[0],ExpressionUUID->
  "d0974563-f77e-a14d-b669-73d236c153ab"], "Text"],
 StyleBox[", can be done in the following way:", "Text"]
}], "CodeText",
 CellID->89716738,ExpressionUUID->"7653040d-82ca-1041-bad6-689661d80ad4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]t", "  ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["U", "\[Dagger]"], "[", "\[Rho]0", "]"}], ",", 
     RowBox[{"\"\<Parameters\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"g", ",", "t"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[269]:=",
 CellID->59563293,ExpressionUUID->"f8c2aac1-2f00-944a-94a7-d176b6dd9a91"],

Cell["Extracting matrix of the atomic part:", "Text",
 CellChangeTimes->{3.9537608048967934`*^9},
 CellID->10354439,ExpressionUUID->"89a4d372-41fe-604f-8511-7435c23dd83e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"atomMatrix", " ", "=", " ", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{
      RowBox[{"QuantumPartialTrace", "[", 
       RowBox[{
        RowBox[{"\[Rho]t", "[", 
         RowBox[{"1", ",", "t"}], "]"}], ",", 
        RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<DensityMatrix\>\"", "]"}],
      "]"}], "//", "ComplexExpand"}]}], ";"}]], "Input",
 CellLabel->"In[270]:=",
 CellID->152228318,ExpressionUUID->"f11ffa1d-0422-a940-b3f2-66d8b5c75417"],

Cell[TextData[{
 StyleBox["Plotting components, since the thermal state was evolved \
symbolically the value of ", "Text"],
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c1c2ca6d-aa76-ba48-9e45-3eb24bfbbf46"],
 StyleBox[" can be changed (of course considering that it can be represented \
in the chosen Fock space size accurately):", "Text"]
}], "CodeText",
 CellID->458277534,ExpressionUUID->"8740e165-edbf-8244-b263-ec74476795e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"atomMatrix", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], "/.", 
     RowBox[{"x", "->", "4."}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "400"}], "}"}], ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          ItemBox[
           RowBox[{
             TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["Sequence", "IconizedItem"]}]]}, {
          ItemBox[
           RowBox[{
             TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["8", "IconizedItem"]}]]}, {
          ItemBox[
           RowBox[{
             TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["1080", "IconizedItem"]}]]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    ImageSize -> 500, PlotRange -> {-0.3, 1}, Frame -> True, LabelStyle -> 14,
      FrameLabel -> {"t", ""}, 
     PlotLegends -> {
      "\!\(\*SubscriptBox[\(\[Rho]\), \(EE\)]\)", 
       "\!\(\*SubscriptBox[\(\[Rho]\), \(EG\)]\)"}, AspectRatio -> 0.5, 
     PlotLabel -> "Evolution of matrix elements of the atomic part"],
