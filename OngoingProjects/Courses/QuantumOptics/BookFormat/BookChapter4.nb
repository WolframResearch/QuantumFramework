       SubscriptBox["\[CapitalPhi]", "n"], "/", "2"}], ")"}], "=", 
     RowBox[{
      FractionBox["1", 
       SqrtBox["2"]], 
      SuperscriptBox[
       RowBox[{"[", 
        FractionBox[
         RowBox[{
          SubscriptBox["\[CapitalOmega]", "n"], "+", "\[CapitalDelta]"}], 
         SubscriptBox["\[CapitalOmega]", "n"]], "]"}], 
       RowBox[{"1", "/", "2"}]]}]}],
    TraditionalForm], "Text"]}]], "DisplayFormula",
 CellID->834718282,ExpressionUUID->"5f3012f6-d747-b749-9128-086d6f9702d0"],

Cell[TextData[StyleBox["Calculate the eigenvectors, and re-express the \
variables:", "Text"]], "CodeText",
 CellChangeTimes->{{3.96680207675683*^9, 3.966802114444353*^9}},
 CellID->111972228,ExpressionUUID->"15bc0548-8629-664e-9b66-65ad078afb5a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eigenVecs", " ", "=", 
   RowBox[{"dressedSubspace", "[", "\"\<Eigenvectors\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"simplificationRules", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Nu]", "-", "\[Omega]"}], "->", "\[CapitalDelta]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[Nu]"}], "+", "\[Omega]"}], "->", 
       RowBox[{"-", "\[CapitalDelta]"}]}], ",", 
      RowBox[{
       SqrtBox[
        RowBox[{
         RowBox[{"4", " ", 
          SuperscriptBox["g", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", "n"}], ")"}]}], "+", 
         SuperscriptBox["\[CapitalDelta]", "2"]}]], "->", 
       SubscriptBox["\[CapitalOmega]", "n"]}]}], "}"}]}], ";"}], 
  " "}]}], "Input",
 CellLabel->"In[359]:=",
 CellID->620239542,ExpressionUUID->"721dd95d-9e62-b24a-adb1-572c35b0299f"],

Cell["Simplify the result:", "Text",
 CellID->175183982,ExpressionUUID->"c5de459a-f136-fd42-855a-599dd48eecdc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"eigenVecs", " ", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"eigenVecs", "//.", "simplificationRules"}], " ", ")"}], " ", ",", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["\[CapitalOmega]", "n"], ",", "g", ",", "n", ",", 
         "\[CapitalDelta]"}], "}"}], ",", "Reals"}], "]"}], " ", "&&", " ", 
     RowBox[{
      SubscriptBox["\[CapitalOmega]", "n"], ">", "\[CapitalDelta]", ">", 
      "0"}], " ", "&&", " ", 
     RowBox[{"n", ">=", "0"}], " ", "&&", " ", 
     RowBox[{"g", ">", "0"}]}]}], " ", "]"}]}]], "Input",
 CellLabel->"In[361]:=",
 CellID->409434620,ExpressionUUID->"74ed6d54-9503-da48-967f-b9446fdc2864"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"-", 
       FractionBox[
        RowBox[{"\[CapitalDelta]", "+", 
         SubscriptBox["\[CapitalOmega]", "n"]}], 
        SqrtBox[
         RowBox[{
          SuperscriptBox["\[CapitalDelta]", "2"], "+", 
          RowBox[{"4", " ", 
           SuperscriptBox["g", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"n", "+", "1"}], ")"}]}], "+", 
          RowBox[{"2", " ", "\[CapitalDelta]", " ", 
           SubscriptBox["\[CapitalOmega]", "n"]}], "+", 
          SubsuperscriptBox["\[CapitalOmega]", "n", "2"]}]]]}], 
      FractionBox["2", 
       SqrtBox[
        RowBox[{
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"\[CapitalDelta]", "+", 
             SubscriptBox["\[CapitalOmega]", "n"]}], ")"}], "2"], 
          RowBox[{
           SuperscriptBox["g", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"n", "+", "1"}], ")"}]}]], "+", "4"}]]]},
     {
      FractionBox[
       RowBox[{
        SubscriptBox["\[CapitalOmega]", "n"], "-", "\[CapitalDelta]"}], 
       SqrtBox[
        RowBox[{
         SuperscriptBox["\[CapitalDelta]", "2"], "+", 
         RowBox[{"4", " ", 
          SuperscriptBox["g", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"n", "+", "1"}], ")"}]}], "-", 
         RowBox[{"2", " ", "\[CapitalDelta]", " ", 
          SubscriptBox["\[CapitalOmega]", "n"]}], "+", 
         SubsuperscriptBox["\[CapitalOmega]", "n", "2"]}]]], 
      FractionBox["2", 
       SqrtBox[
        RowBox[{
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"\[CapitalDelta]", "-", 
             SubscriptBox["\[CapitalOmega]", "n"]}], ")"}], "2"], 
          RowBox[{
           SuperscriptBox["g", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"n", "+", "1"}], ")"}]}]], "+", "4"}]]]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellLabel->"Out[361]=",
 CellID->33956318,ExpressionUUID->"e1342a78-f334-e547-b7dd-8312813a2038"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\"\<Eigenvectors\>\"", " "}], TraditionalForm]], "CodeText",
  ExpressionUUID->"1872906f-009d-4645-a2ae-df9a9120521e"],
 " finds a different set of valid eigenvectors of the form \
{-cos(\[CapitalPhi]), sin(\[CapitalPhi])} and {sin(\[CapitalPhi]), cos(\
\[CapitalPhi])}, we perform further symbolic manipulation:"
}], "Text",
 CellID->33267699,ExpressionUUID->"b24dfcbb-eefb-5a42-adf6-fa72c05c8899"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"simplifiedDressedEigenvecs", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"#", "/.", 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["g", "2"], 
              RowBox[{"(", 
               RowBox[{"n", "+", "1"}], ")"}]}], ")"}]}], "->", 
           RowBox[{"4", "/", 
            RowBox[{"(", " ", 
             RowBox[{
              SuperscriptBox[
               SubscriptBox["\[CapitalOmega]", "n"], "2"], "-", 
              SuperscriptBox["\[CapitalDelta]", "2"]}], ")"}]}]}], ",", " ", 
          RowBox[{
           RowBox[{"4", 
            SuperscriptBox["g", "2"], 
            RowBox[{"(", 
             RowBox[{"n", "+", "1"}], ")"}]}], "->", 
           RowBox[{
            SuperscriptBox[
             SubscriptBox["\[CapitalOmega]", "n"], "2"], "-", 
            SuperscriptBox["\[CapitalDelta]", "2"]}]}]}], " ", "}"}]}], ",", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[CapitalOmega]", "n"], ">", "0"}], " ", "&&", " ", 
        RowBox[{"\[CapitalDelta]", ">", "0"}]}]}], "]"}], "&"}], " ", "/@", 
    " ", "eigenVecs"}], " ", "//", "Together"}]}]], "Input",
 CellChangeTimes->{
  3.92582845690819*^9, {3.9258285958363113`*^9, 3.925828597893783*^9}, {
   3.925828712175089*^9, 3.9258287156657467`*^9}, {3.9258311930954075`*^9, 
   3.925831208491928*^9}, {3.925835036468521*^9, 3.925835036809458*^9}, {
   3.93446106627919*^9, 3.934461090128641*^9}, 3.9344611708616447`*^9, {
   3.969624580181919*^9, 3.969624581683552*^9}},
 CellLabel->"In[362]:=",
 CellID->136702050,ExpressionUUID->"0bebf9a9-09b3-154c-9381-ff47097fadbe"],

