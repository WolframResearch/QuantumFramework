Cell[BoxData[{
 RowBox[{
  RowBox[{"H01bracket", " ", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"bareState", "[", 
          RowBox[{"0", ",", "n"}], "]"}], "\[Dagger]"], " ", "@", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"H0", "+", "H1"}], ")"}], " ", "@", " ", 
         RowBox[{"bareState", "[", 
          RowBox[{"1", ",", "n"}], "]"}]}]}], ")"}], "[", "\"\<Scalar\>\"", 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", 
       RowBox[{"$FockSize", "-", "2"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H01theory", " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"h", 
        RowBox[{"(", 
         RowBox[{"g", 
          SqrtBox[
           RowBox[{"(", 
            RowBox[{"#", "+", "1"}], ")"}]]}], ")"}]}], "]"}], "&"}], ",", 
     RowBox[{"$FockSize", "-", "1"}], ",", "0"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[288]:=",
 CellID->10112203,ExpressionUUID->"3722cb99-1c19-394d-b5d4-d599819218d5"],

