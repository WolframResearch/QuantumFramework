Cell[CellGroupData[{

Cell[TextData[StyleBox["Spontaneous emission", "Subsubsection"]], "Subsection",
 CellChangeTimes->{{3.930775293452881*^9, 3.930775305901087*^9}},
 CellID->18412242,ExpressionUUID->"4e01135b-92a8-6149-afae-bb6804f4fd2b"],

Cell[TextData[{
 "Even when there is not a an electromagnetic field an atom can decay from \
state |",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "31d57540-4b35-0446-8242-f4f6db2b0266"],
 "\[RightAngleBracket] to |",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "011a2c9f-d42d-0248-881c-ab00006bed27"],
 "\[RightAngleBracket], and a photon is emitted at the resonant frequency. \
The emitted photon leaves the atom with completely arbitrary phase and \
polarization. This phenomenon is introduced here for the sake of \
completeness, but cannot be explained until we consider interactions of an \
atom with a quantized field (all the modes including the vacuum)."
}], "Text",
 CellID->6747793,ExpressionUUID->"a047c31c-b4e4-904e-8a00-46a6e816d1df"],

