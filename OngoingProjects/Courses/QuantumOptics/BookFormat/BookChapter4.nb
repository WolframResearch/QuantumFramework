Cell[TextData[{
 "It can shown that the long term time averages ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["P", "\[LongDash]"], "e"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c5d0c08e-a8d8-7843-93a2-451b64b92bd8"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["P", "\[LongDash]"], "g"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8fe0fd15-6ca0-b745-be08-5f8a89ae5f8c"],
 " hold the ratio ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox["P", "\[LongDash]"], "e"], "/", 
     SubscriptBox[
      OverscriptBox["P", "\[LongDash]"], "g"]}], "=", 
    FractionBox[
     RowBox[{
      RowBox[{"2", 
       OverscriptBox["n", "\[LongDash]"]}], "+", "1"}], 
     RowBox[{
      RowBox[{"2", 
       OverscriptBox["n", "\[LongDash]"]}], "+", "3"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3f56e14b-c3a3-034a-8afc-e4880c5ae487"],
 " that depends on ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "\[LongDash]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9b4f40c9-ffe1-af49-9501-65d2a5d8dc64"],
 " (which depends on the temperature)"
}], "Text",
 CellID->558714179,ExpressionUUID->"3631832d-ad01-8b44-8077-6f1fd229b566"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"n", "=", "2"}], ",", "avgPe", ",", "avgPg", ",", 
     RowBox[{"tf", "=", "3000"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"avgPe", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"atomMatrix", "\[LeftDoubleBracket]", 
          RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "/.", 
         "\[VeryThinSpace]", 
         RowBox[{"x", "\[Rule]", "n"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tf"}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", "\"\<LocalAdaptive\>\""}]}], "]"}]}], ";", 
    RowBox[{"avgPg", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"atomMatrix", "\[LeftDoubleBracket]", 
          RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}], "/.", 
         "\[VeryThinSpace]", 
         RowBox[{"x", "\[Rule]", "n"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tf"}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", "\"\<LocalAdaptive\>\""}]}], "]"}]}], ";", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["avgPe", "avgPg"], ",", 
      RowBox[{"N", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"2", " ", "n"}], "+", "1"}], 
        RowBox[{
         RowBox[{"2", " ", "n"}], "+", "3"}]], "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[324]:=",
 CellID->468269353,ExpressionUUID->"ee5d9ba2-e537-2049-bc70-31b84427c970"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.7142807284415678`", ",", "0.7142857142857143`"}], 
  "}"}]], "Output",
 CellLabel->"Out[324]=",
 CellID->644311914,ExpressionUUID->"e56dbb16-58ff-e841-94c9-cc5bf8e4193a"]
}, Open  ]],

Cell[TextData[StyleBox["Time average for one of the coherences:", "Text"]], \
"CodeText",
 CellChangeTimes->{{3.9667002960779705`*^9, 3.9667003050868607`*^9}},
 CellID->87278320,ExpressionUUID->"822e0643-3e00-2947-a927-56025d017914"],

Cell[BoxData[
 RowBox[{
  RowBox[{"timeAverages", " ", "=", " ", 
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"atomMatrix", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], "/.", 
         RowBox[{"x", "->", "2."}]}], ")"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "tf"}], "}"}]}], "]"}], "/", "tf"}]}], 
  ";"}]], "Input",
 CellLabel->"In[328]:=",
 CellID->201619341,ExpressionUUID->"fbade4c3-181f-4f47-895c-24bc4ad3a740"],

Cell[TextData[StyleBox["Plot the time average with increasing time window, it \
approaches zero:", "Text"]], "CodeText",
 CellID->175610645,ExpressionUUID->"3755672b-71ea-c24c-8ee3-3ef545c2b1fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{"timeAverages", ",", 
   RowBox[{"{", 
    RowBox[{"tf", ",", "5", ",", "200"}], "}"}], ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          ItemBox[
           RowBox[{
             TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["Sequence", "IconizedItem"]}]]}, {
          ItemBox[
           RowBox[{
             TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["3", "IconizedItem"]}]]}, {
          ItemBox[
           RowBox[{
             TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["376", "IconizedItem"]}]]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    PlotRange -> All, AxesLabel -> {"g t", "Time Average"}, LabelStyle -> 12],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellLabel->"In[329]:=",
 CellID->258043693,ExpressionUUID->"6838570c-3d36-e740-9fed-176319a40ce9"],

