    RowBox[{"\[CapitalDelta]", "->", "0"}]}], ")"}]}]], "Input",
 CellLabel->"In[330]:=",
 CellID->332655763,ExpressionUUID->"5f159826-5cb8-8441-8f91-c70254ca4cc2"],

Cell[BoxData[
 RowBox[{"{", 
