Cell["\<\
Wolfram QuantumFramework supports \[OpenCurlyDoubleQuote]SchmidtBasis\
\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]SchmidtDecompose\
\[CloseCurlyDoubleQuote] properties for quantum states\
\>", "Text",
 CellChangeTimes->{{3.9538345523097725`*^9, 3.9538346153360863`*^9}},
 CellID->738301327,ExpressionUUID->"79605702-26ca-3e48-9b92-5d44a5152718"],

Cell[TextData[{
 "Verifying ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "25a26315-387b-a14d-8aca-b825b95e712f"],
 "(",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "66cc629f-12c9-554a-857f-15cf1e90e383"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "2"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6acaab0d-3814-ee40-9445-ebad1a1a6e78"],
 " coincide with the amplitudes of \[OpenCurlyDoubleQuote]SchmidtBasis\
