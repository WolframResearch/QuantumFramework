Cell[TextData[{
 "Define using the Quantum Framework a modified Jaynes-Cummings Hamiltonian, \
such that the atom has three levels, two ground states and one excited state. \
Find the state \[Psi](t) as a function of time for the initial state ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SqrtBox["3"]], TraditionalForm]],ExpressionUUID->
  "9cddb4a8-a680-a149-9e2d-5d2833deefce"],
 "(|e\[RightAngleBracket] + |",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "1"], TraditionalForm]],ExpressionUUID->
  "b29a7dc1-f498-6b42-804b-02712b2af84e"],
 "\[RightAngleBracket] + |",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "2"], TraditionalForm]],ExpressionUUID->
  "ea81795d-1dc3-624e-9f73-5ce687cbd164"],
 "\[RightAngleBracket] ) \[CircleTimes] |1\[RightAngleBracket]"
}], "Exercise",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.972144065617754*^9, 3.972144066538479*^9}, {
  3.972144199936983*^9, 3.972144275638912*^9}, {3.9721447784919853`*^9, 
  3.972144781256794*^9}, {3.972399925080223*^9, 3.9724000236260815`*^9}, {
  3.9724001210636845`*^9, 3.9724001222983932`*^9}},
 CellID->273589973,ExpressionUUID->"b6c7510e-72ac-9f45-bfce-bb87108b3464"],

