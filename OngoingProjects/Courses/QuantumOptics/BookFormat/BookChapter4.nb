Cell[TextData[{
 "We can also directly compute ",
 Cell[BoxData["\"\<VonNeumannEntropy\>\""], "InlineCode",ExpressionUUID->
  "67e7aa99-0c7e-2f4f-8796-47656f796fd7"],
 " for a ",
 StyleBox["QuantumState", "FormattedFunction"],
 ", getting the same result as before:"
}], "Text",
 CellChangeTimes->{{3.953834028075901*^9, 3.9538340338041*^9}, {
  3.9538349383022327`*^9, 3.953834942280115*^9}},
 CellID->140870067,ExpressionUUID->"19b953d7-1d22-d64c-8969-2c945e87a17b"],

Cell[TextData[StyleBox["Atomic part of the evolved state:", "Text"]], \
"CodeText",
 CellChangeTimes->{{3.9668070964979515`*^9, 3.966807127616459*^9}},
 CellID->33124526,ExpressionUUID->"3aab13fc-7259-9b41-b6e8-5255d4a8587c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evol", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"QuantumPartialTrace", "[", 
      RowBox[{
       RowBox[{"U", "@", "\[Psi]0"}], ",", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"g", ",", "t"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[529]:=",
 CellID->716284079,ExpressionUUID->"4b7e8554-5243-9f4a-9042-b85a3e28f779"],

