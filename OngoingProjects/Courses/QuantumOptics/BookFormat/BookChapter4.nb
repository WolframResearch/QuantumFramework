Cell["\<\
The atom will get \[OpenCurlyDoubleQuote]thermalized\[CloseCurlyDoubleQuote] \
that means time average of the coherences tends to zero, and also the ratio \
of the probabilities of the ground and excited states oscillates around some \
value \
\>", "Text",
 CellID->252581849,ExpressionUUID->"63ae0fc2-c6e2-6c4a-b6e5-f99c9b8f024d"],

Cell[TextData[{
 "Plot the ratio of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["P", "e"], "(", "t", ")"}], "/", 
    RowBox[{
     SubscriptBox["P", "g"], "(", "t", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "35ff6fe2-180a-5449-a9c7-2d827a2e9ac6"],
 ":"
}], "Text",
 CellID->93157088,ExpressionUUID->"ddb772df-e360-a348-b621-5b599b64689c"],

