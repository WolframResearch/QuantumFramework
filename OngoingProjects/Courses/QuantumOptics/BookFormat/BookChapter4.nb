}], "CodeText",
 CellID->13331585,ExpressionUUID->"c3776b4e-ddee-ba48-9654-93517871278d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"H11bracket", " ", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"bareState", "[", 
          RowBox[{"1", ",", "n"}], "]"}], "\[Dagger]"], " ", "@", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"H0", "+", "H1"}], ")"}], " ", "@", " ", 
         RowBox[{"bareState", "[", 
          RowBox[{"1", ",", "n"}], "]"}]}]}], ")"}], "[", "\"\<Scalar\>\"", 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", 
       RowBox[{"$FockSize", "-", "2"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H11theory", " ", "=", "  ", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"h", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#", "+", "1"}], ")"}], " ", "\[Nu]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"1", "/", "2"}], " ", "\[Omega]"}]}], ")"}]}], "]"}], 
      "&"}], ",", 
     RowBox[{"$FockSize", "-", "1"}], ",", "0"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[281]:=",
 CellID->5303523,ExpressionUUID->"8489225f-4253-9243-8e4c-a7b31930e3d4"],

