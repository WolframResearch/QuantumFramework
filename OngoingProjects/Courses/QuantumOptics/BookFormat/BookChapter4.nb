Cell[CellGroupData[{

Cell[TextData[StyleBox["Stimulated emission", "Subsubsection"]], "Subsection",
 CellChangeTimes->{{3.930771480192118*^9, 3.9307714841386633`*^9}},
 CellID->58024873,ExpressionUUID->"061d3665-84c3-7c4c-8516-48d3d29f79fc"],

Cell[TextData[{
 "Stimulated emission is the process that is the counterpart of absorption, \
and is also relevant when the field frequency is quasi-resonant. In this case \
an atom decays to a lower energy level and the field is ",
 StyleBox["amplified",
  FontSlant->"Italic"],
 ". For the field to be amplified means that a photon was emitted with the \
same frequency, polarization and phase as the incident field ; so they can \
interfere coherently."
}], "Text",
 CellChangeTimes->{{3.930773464847191*^9, 3.930773682165428*^9}, {
  3.930773740582037*^9, 3.930773918001921*^9}, {3.930822746076689*^9, 
  3.930822768062435*^9}, {3.969619523801281*^9, 3.9696195313688564`*^9}, {
  3.9696195742723255`*^9, 3.9696196061573315`*^9}, {3.969619662897417*^9, 
  3.969619666347473*^9}, {3.969619737492611*^9, 3.9696197863781185`*^9}},
 CellID->81198359,ExpressionUUID->"51201488-0041-204c-9c62-2349efc2d86e"],

