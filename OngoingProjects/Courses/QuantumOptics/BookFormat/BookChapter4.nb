Cell[TextData[{
 "Take the Jaynes\[Dash]Cummings model far from resonance,",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"\[CapitalDelta]", " ", "=", " ", 
     RowBox[{"20", "g"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7b8b8354-354a-024a-84f8-3283cc117321"],
 ", with the field in a coherent state |",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a6c73a5e-5728-7340-8af5-84056f01f0d9"],
 "\:27e9 and the atom in |",
 Cell[BoxData[
  FormBox["e", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9f5d660e-fba2-c344-8d8b-2b801b0d9ac9"],
 "\:27e9 and |",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6b8ddbe7-7e57-a54c-b7f7-3657364d2a22"],
 "\:27e9. Evolve both cases and plot the Husimi Q function of the field, \
visualize that the two coherent states rotate in opposite directions in phase \
space. Using appropriate parameters find when the HusimiQ functions have \
maximum overlap at a phase space point different than the initial one."
}], "Exercise",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellID->404992693,ExpressionUUID->"5331f432-fbdd-e349-8c2b-d2dc32576029"],

Cell[CellGroupData[{

Cell["\<\
Define the cutoff , the field operator and the atomic operators:\
\>", "ExerciseNote",
 CellID->74573212,ExpressionUUID->"c3e9baab-a0a4-b14b-a905-077b4b11a013"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "30", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", ":=", 
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"{", "2", "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"atomBasis", " ", "=", " ", 
   RowBox[{"QuantumBasis", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<e\>\"", ",", "\"\<g\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]plus", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<+\>\"", ",", "atomBasis"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]minus", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<-\>\"", ",", "atomBasis"}], "]"}]}], ";"}]}], "ExerciseInput",
 CellLabel->"In[13]:=",
 CellID->101346323,ExpressionUUID->"53b87e59-e06e-2e46-8d44-30777d4aae91"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Define the Jaynes-Cummings Hamiltonian:", "ExerciseNote",
 CellID->91726493,ExpressionUUID->"92f63255-838c-4246-b164-48cb1f1bbc8d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HJC", "=", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Nu]", " ", 
       RowBox[{
        SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], "+", 
      RowBox[{
       RowBox[{"\[Omega]", "/", "2"}], " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<Z\>\"", ",", "atomBasis"}], "]"}]}], "+", 
      RowBox[{"g", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Sigma]plus", "@", "a"}], "+", 
         RowBox[{"\[Sigma]minus", "@", 
          SuperscriptBox["a", "\[Dagger]"]}]}], ")"}]}]}], ",", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", "\[Omega]", ",", "g"}], "}"}]}]}], "]"}]}], 
  ";"}]], "ExerciseInput",
 CellLabel->"In[19]:=",
 CellID->579523672,ExpressionUUID->"8b4c5368-161b-6449-8814-670e805c490f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Define parameters, consider ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "=", "0.2"}], ",", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b28ec33f-1347-6d4c-8848-6d10614ea363"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "=", 
    RowBox[{"20", "g"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "268f9d64-b7b4-3c4b-8307-34a4588e9158"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "=", "0.01"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "864b61df-0d15-694b-8ab4-2fc9d07582cd"],
 ":"
}], "ExerciseNote",
 CellID->264124979,ExpressionUUID->"0cb1280e-c08c-3645-9d60-2895220e5fe3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]", "=", "2"}], ";", 
   RowBox[{"gc", "=", "0.2"}], ";", 
   RowBox[{"\[CapitalDelta]c", "=", 
    RowBox[{"20", "gc"}]}], ";", 
   RowBox[{"\[Chi]", "=", 
    RowBox[{
     SuperscriptBox["gc", "2"], "/", "\[CapitalDelta]c"}]}], ";"}], 
  " "}]], "ExerciseInput",
 CellLabel->"In[20]:=",
 CellID->255887601,ExpressionUUID->"575296c0-1a92-6d4b-acf6-6f6b00ad0be6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Instantiate the Hamiltonian:", "ExerciseNote",
 CellID->10581468,ExpressionUUID->"bbdd5625-c96e-3a48-b20a-eb573017a0f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Hrot", "=", 
   RowBox[{"HJC", "[", 
    RowBox[{"0", ",", 
     RowBox[{"-", "\[CapitalDelta]c"}], ",", "gc"}], "]"}]}], 
  ";"}]], "ExerciseInput",
 CellLabel->"In[21]:=",
 CellID->660932671,ExpressionUUID->"06b87641-7db1-cc48-8c6f-e664ad792b65"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compute the evolutions for |e\[RightAngleBracket] \[CircleTimes] |\
\[Alpha]\[RightAngleBracket] and \
|g\[RightAngleBracket]\[CircleTimes]|\[Alpha]\[RightAngleBracket]:", \
"ExerciseNote",
 CellID->127523677,ExpressionUUID->"d414fc02-688a-b94b-89ab-6310a7e08644"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Psi]e", ",", "\[Psi]g"}], "}"}], "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{"Hrot", ",", 
       RowBox[{"QuantumTensorProduct", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"atomBasis", "[", "\"\<BasisStates\>\"", "]"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]", "]"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "400"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}]], "ExerciseInput",
 CellLabel->"In[27]:=",
 CellID->87971084,ExpressionUUID->"d736bc06-6ff6-6a4f-89cd-51bb8d52d7fa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Calculate the HusimiQ representation of the reduced state:", \
"ExerciseNote",
 CellID->398663034,ExpressionUUID->"674ec10c-4b30-c94c-9afe-b649bc309e42"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qFn", "[", 
   RowBox[{"\[Psi]_", ",", "\[Tau]_"}], "]"}], ":=", 
  RowBox[{"HusimiQRepresentation", "[", 
   RowBox[{
    RowBox[{"QuantumPartialTrace", "[", 
     RowBox[{
      RowBox[{"\[Psi]", "[", "\[Tau]", "]"}], ",", 
      RowBox[{"{", "1", "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "6"}], ",", "6"}], "}"}]}], "]"}]}]], "ExerciseInput",
 CellLabel->"In[23]:=",
 CellID->102423718,ExpressionUUID->"07a5881b-3c38-a54b-ad75-04a9086f731f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Snapshot of the contours of two HusimiQ functions:", "ExerciseNote",
 CellID->163251240,ExpressionUUID->"010edb83-9f91-8947-9884-bba87de78a3c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"snapshot", "[", "\[Tau]_", "]"}], ":=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{"qFn", "[", 
         RowBox[{"\[Psi]e", ",", "\[Tau]"}], "]"}], "[", 
        RowBox[{"x", ",", "p"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"p", ",", 
        RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
      InterpretationBox[
       DynamicModuleBox[{Typeset`open = False}, 
        TemplateBox[{"Expression", "SequenceIcon", 
          GridBox[{{
             RowBox[{
               TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["Sequence", "IconizedItem"]}]}, {
             RowBox[{
               TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["3", "IconizedItem"]}]}, {
             RowBox[{
               TagBox["\"Byte count: \"", "IconizedLabel"], 
               "\[InvisibleSpace]", 
               TagBox["336", "IconizedItem"]}]}}, 
           GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
           "Column", 
           GridBoxItemSize -> {
            "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
          Dynamic[Typeset`open]},
         "IconizedObject"]],
       Sequence[
       Contours -> 5, ContourShading -> None, ContourStyle -> 
        ColorData[97, 1]],
       SelectWithContents->True,
       Selectable->False]}], "]"}], ",", 
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{"qFn", "[", 
         RowBox[{"\[Psi]g", ",", "\[Tau]"}], "]"}], "[", 
        RowBox[{"x", ",", "p"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"p", ",", 
        RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
      InterpretationBox[
       DynamicModuleBox[{Typeset`open = False}, 
        TemplateBox[{"Expression", "SequenceIcon", 
          GridBox[{{
             RowBox[{
               TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["Sequence", "IconizedItem"]}]}, {
             RowBox[{
               TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["3", "IconizedItem"]}]}, {
             RowBox[{
               TagBox["\"Byte count: \"", "IconizedLabel"], 
               "\[InvisibleSpace]", 
               TagBox["336", "IconizedItem"]}]}}, 
           GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
           "Column", 
           GridBoxItemSize -> {
            "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
          Dynamic[Typeset`open]},
         "IconizedObject"]],
       Sequence[
       Contours -> 5, ContourShading -> None, ContourStyle -> 
        ColorData[97, 2]],
       SelectWithContents->True,
       Selectable->False]}], "]"}], ",", 
    InterpretationBox[
     DynamicModuleBox[{Typeset`open = False}, 
      TemplateBox[{"Expression", "SequenceIcon", 
        GridBox[{{
           RowBox[{
             TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["Sequence", "IconizedItem"]}]}, {
           RowBox[{
             TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["3", "IconizedItem"]}]}, {
           RowBox[{
             TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
