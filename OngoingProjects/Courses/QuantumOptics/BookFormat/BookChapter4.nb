Cell[TextData[StyleBox["Define a function to optimize the entropy:", \
"Text"]], "CodeText",
 CellID->30017463,ExpressionUUID->"040e7f55-b951-8647-aed7-0a5f29610368"],

Cell[BoxData[
 RowBox[{
  RowBox[{"func", "[", 
   RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"QuantityMagnitude", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"evol", "[", 
      RowBox[{"1", ",", "t"}], "]"}], "[", "\"\<VonNeumannEntropy\>\"", "]"}], 
    RowBox[{"Log", "[", "2", "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9668075474194736`*^9, 3.966807552002857*^9}, {
  3.9668075923720226`*^9, 3.966807611300333*^9}, {3.9668077716126213`*^9, 
  3.9668077756664104`*^9}, {3.9668082077791786`*^9, 3.966808295376322*^9}, {
  3.966808337661358*^9, 3.966808383698351*^9}},
 CellLabel->"In[531]:=",
 CellID->159217019,ExpressionUUID->"69a8ac28-c45c-6d49-b46a-4ebe86639382"],

Cell[TextData[StyleBox["Finding the time of the local minimum of entropy:", \
"Text"]], "CodeText",
 CellChangeTimes->{{3.966808479956293*^9, 3.9668085170305653`*^9}},
 CellID->71110499,ExpressionUUID->"56c98e0b-f303-9340-b2c6-5364776dbfa5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Tmin", " ", "=", 
  RowBox[{
   RowBox[{"FindMinimum", "[", 
    RowBox[{
     RowBox[{"func", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "5"}], "}"}], ",", 
     RowBox[{"Method", "->", "\"\<ConjugateGradient\>\""}]}], "]"}], "[", 
   RowBox[{"[", "2", "]"}], "]"}]}]], "Input",
 CellLabel->"In[532]:=",
 CellID->786389743,ExpressionUUID->"10959f00-4925-264f-9116-ba14f7276693"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"t", "\[Rule]", "15.653962797985209`"}], "}"}]], "Output",
 CellLabel->"Out[532]=",
 CellID->418796860,ExpressionUUID->"0cce0d24-5bf8-384c-954d-d52cf7bce5f4"]
}, Open  ]],

Cell[TextData[{
 "The maximum of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "2"], TraditionalForm]],ExpressionUUID->
  "68285939-d6b9-554c-9de5-e9ad2b796890"],
 " corresponds to a minimum of the Von Neumann entropy, which can be \
understood as the time where the reduced density matrices of the atom-field \
system are approximately pure , happens at around ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6cf2df8a-f2e6-6f4e-b24b-f03e609a4cb4"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", " ", "t"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2b2f7b80-5d49-6943-b3e9-06ae26bb2b89"],
 "  \[TildeTilde] 15.6 for this example"
}], "Text",
 CellID->218893763,ExpressionUUID->"19091319-daaa-754d-a660-09e83bb181c4"],

Cell[TextData[StyleBox["Use the \[OpenCurlyDoubleQuote]Purity\
\[CloseCurlyDoubleQuote] property at the calculated time:", "Text"]], \
"CodeText",
 CellChangeTimes->{{3.9668086863987675`*^9, 3.966808702987152*^9}, {
  3.972399276815508*^9, 3.9723992781804295`*^9}},
 CellID->307349532,ExpressionUUID->"b8532561-e7cb-6b4c-a102-3758dfd2fc12"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumPartialTrace", "[", 
     RowBox[{
      RowBox[{"\[Psi]t", "[", 
       RowBox[{"1", ",", 
        RowBox[{"t", "/.", "Tmin"}]}], "]"}], ",", 
      RowBox[{"{", "i", "}"}]}], "]"}], "[", "\"\<Purity\>\"", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.953835334868021*^9, 3.9538353703238297`*^9}, 
   3.9668085813668137`*^9, {3.9668086555443726`*^9, 3.9668086672689285`*^9}},
 CellLabel->"In[533]:=",
