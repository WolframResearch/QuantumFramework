Cell[TextData[{
 "The atomic inversion is calculated ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"W", "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Rho]", "ee", "A"], "(", "t", ")"}], "-", 
     RowBox[{
      SubsuperscriptBox["\[Rho]", "gg", "A"], "(", "t", ")"}]}], "=", 
    RowBox[{
     RowBox[{"2", " ", 
      SubsuperscriptBox["\[Rho]", "ee", "A"], "(", "t", ")"}], "-", "1"}]}], 
   TraditionalForm]], "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{{3.985890935289072*^9, 3.9858909553806477`*^9}},
  ExpressionUUID->"aac1f940-ecba-504f-8485-5a6fac6c69ae"],
 ",   after tracing out the Fock states. Lets calculate the atomic inversion \
for atom initially excited and the field in a thermal state with ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "\[LongDash]"], TraditionalForm]],ExpressionUUID->
  "6cb3d368-c175-8646-8aef-2113136240a4"],
 " = 5"
}], "Text",
 CellID->161159950,ExpressionUUID->"9d271c21-74fc-0448-b998-2e0f5f5f5e9b"],

Cell[TextData[StyleBox["Redoing the evolution for the state with the atom in \
the excited state:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9667038901185207`*^9, 3.966703921391571*^9}, {
  3.9667039639851303`*^9, 3.9667040014501114`*^9}},
 CellID->341511205,ExpressionUUID->"ceee1834-cfbc-ee44-ae70-9431646bb121"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<0\>\"", ",", "atomBasis"}], "]"}], ",", 
     RowBox[{"ThermalState", "[", "5.", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
