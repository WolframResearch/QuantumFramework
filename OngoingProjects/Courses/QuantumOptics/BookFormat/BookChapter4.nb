Cell[TextData[StyleBox["Norm of the Bloch vector:", "Text"]], "CodeText",
 CellChangeTimes->{
  3.953833719068432*^9, {3.9668068665306473`*^9, 3.966806881504122*^9}},
 CellID->568568045,ExpressionUUID->"c783d68f-9a5b-eb49-a8f1-6d0f5138e6bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"normBloch", " ", "=", " ", 
   RowBox[{"Norm", "[", "blochVector", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.9668068860490723`*^9},
 CellLabel->"In[521]:=",
 CellID->768216457,ExpressionUUID->"11957fd9-499d-6440-ba72-cc90d6943903"],

Cell[TextData[{
 StyleBox["Extracting the ", "Text"],
 StyleBox[Cell[BoxData[
  FormBox["g", TraditionalForm]], "Text",ExpressionUUID->
  "5a8194b9-3713-7843-b61d-f8f8457c40ac"], "Text"],
 StyleBox[" coefficients:", "Text"]
}], "CodeText",
 CellChangeTimes->{{3.966806889891102*^9, 3.96680690155645*^9}},
 CellID->56333571,ExpressionUUID->"2a47c898-5ab2-ce46-b89c-2f3cbeeeea77"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g1", ",", "g2"}], "}"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{"1", "+", "normBloch"}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{"1", "-", "normBloch"}], ")"}]}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9668068860490723`*^9, 3.966806905829954*^9}},
 CellLabel->"In[522]:=",
 CellID->153743597,ExpressionUUID->"7ba1abf1-f756-314c-a24d-dff952581aed"],

Cell[TextData[StyleBox["Calculating the Von Neumann entropy:", "Text"]], \
"CodeText",
 CellChangeTimes->{{3.96680690890551*^9, 3.9668069193743076`*^9}},
 CellID->190894531,ExpressionUUID->"119f8c23-6bba-2548-bd54-8bcdd9c57851"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"vonneumann", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "g1"}], " ", 
      RowBox[{"Log", "[", "g1", "]"}]}], "-", 
     RowBox[{"g2", " ", 
      RowBox[{"Log", "[", "g2", "]"}]}]}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.9668068860490723`*^9, 3.966806905829954*^9}},
 CellLabel->"In[523]:=",
