Cell[TextData[StyleBox["Note: in the diagrams we are depicting photons \
because make the diagrams clearer, but the field that we will consider first \
is classical",
 FontSize->16,
 FontColor->GrayLevel[0]]], "Answer",
 CellChangeTimes->{
  3.9666152548231792`*^9, {3.9666152901093597`*^9, 3.9666153540513496`*^9}},
