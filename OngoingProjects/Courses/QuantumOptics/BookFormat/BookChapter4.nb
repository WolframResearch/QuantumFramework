       FontWeight->"Bold"], "Bold",
      FontWeight->"Bold"], "\[CenterDot]", 
     RowBox[{
      OverscriptBox[
       StyleBox["E", "Bold",
        FontWeight->"Bold"], "^"], "(", 
      RowBox[{
       SubscriptBox[
        StyleBox["r", "Bold",
         FontWeight->"Bold"], "0"], ",", "t"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->212515129,ExpressionUUID->"4717977f-6145-1545-9bcc-57a6a257e085"],

Cell[TextData[{
 "For this case we can also use the long-wavelength approximation replacing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["A",
     FontWeight->"Bold"], "'"}], TraditionalForm]],ExpressionUUID->
  "98b3c2e1-636c-6448-8b69-207024d67318"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     OverscriptBox["r", "^"], ",", "t"}], ")"}], TraditionalForm]],
  ExpressionUUID->"073905d2-4412-f845-a4f4-7d33492f1048"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["A",
      FontWeight->"Bold"], "'"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["r", "0"], ",", "t"}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"69de252e-dc45-7a42-bed5-2f7699252e95"],
 " using the transformed potentials we get ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox["A",
       FontWeight->"Bold"], "'"}], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["r", "0"], ",", "t"}], ")"}]}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"b1c9a5d5-d60c-d440-be97-aa3c4a46f5e0"],
 " and finally the Hamiltonian terms  become "
}], "Text",
 CellChangeTimes->{{3.931878725429253*^9, 3.9318787629653835`*^9}, {
   3.93187887418725*^9, 3.931878946719106*^9}, {3.931879584561558*^9, 
   3.931879603162646*^9}, {3.931879695388855*^9, 3.931879699242565*^9}, {
