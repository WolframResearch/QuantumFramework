Cell["\<\
We recover the same resonant Rabi oscillations as the semiclassical case, the \
frequency of the oscillations is dependent on the number of the Fock state \
evolved\
\>", "Text",
 CellID->4750095,ExpressionUUID->"451ae393-bb6c-df49-91d5-c9bf6c17a8fa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"probs", "=", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", "n", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"QuantumState", "[", 
            RowBox[{"\"\<0\>\"", ",", "atomBasis"}], "]"}], "\[Dagger]"], "@", 
          RowBox[{"U", "@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"QuantumState", "[", 
              RowBox[{"\"\<1\>\"", ",", "atomBasis"}], "]"}], "//", " ", 
             RowBox[{"FockState", "[", "n", "]"}]}], ")"}]}]}], ")"}], 
        "[", "\"\<Norm\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot3D", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"probs", "/.", 
      RowBox[{"g", "->", "1"}]}], " ", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"3", "\[Pi]"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", "14"}], ",", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<Resonant Rabi oscillations\>\""}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "400"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<|1\[RightAngleBracket]\>\"", 
      ",", "\"\<|2\[RightAngleBracket]\>\"", 
      ",", "\"\<|3\[RightAngleBracket]\>\"", 
      ",", "\"\<|4\[RightAngleBracket]\>\""}], "}"}]}], ",", 
   RowBox[{"BoxRatios", "->", 
    RowBox[{"{", 
     RowBox[{"3", ",", "2", ",", "0.5"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.96962148210281*^9, 3.9696214954982643`*^9}, {
  3.969621526577112*^9, 3.9696215401396923`*^9}, {3.969622503140545*^9, 
