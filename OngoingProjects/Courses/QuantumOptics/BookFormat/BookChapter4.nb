Cell[TextData[{
 StyleBox["The Schrodinger equation  ", "Text"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", 
      FractionBox[
       RowBox[{"d", " ", 
        RowBox[{"|", 
         RowBox[{"\[Psi]", "(", "t", ")"}], "\[RightAngleBracket]"}]}], 
       RowBox[{"d", "t"}]]}], "-", 
     RowBox[{
      OverscriptBox["H", "^"], Cell[
      "|",ExpressionUUID->"92ce2a1e-ea56-1240-94df-6cca2604db7b"], 
      RowBox[{"\[Psi]", "(", "t", ")"}], Cell[
      "\[RightAngleBracket]",ExpressionUUID->
       "932e0af7-6bd1-4f48-8aed-12d24da8abf5"]}]}], "=", "0"}], 
   TraditionalForm]], "Text",
  CellChangeTimes->{{3.985890935274164*^9, 3.9858909553740406`*^9}},
  ExpressionUUID->"b9896081-dab0-6246-b707-54bfa3422dec"],
 ", the left hand side can be seen as a differential operator that can be \
applied to the state",
 StyleBox[":", "Text"]
}], "Text",
 CellID->284847707,ExpressionUUID->"dfb8990f-d027-9149-9cb7-63a063994e1f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"schrodingerEq", " ", "=", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"D", "[", 
      RowBox[{"\[Psi]i", ",", "t"}], "]"}]}], " ", "-", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"atomicHamiltonian", "/", "h"}], ")"}], "@", "\[Psi]i"}]}], 
   ")"}]}]], "Input",
 CellChangeTimes->{{3.932136593195125*^9, 3.9321366026800575`*^9}, {
   3.9321367568830814`*^9, 3.9321367575494347`*^9}, {3.9321367934221783`*^9, 
   3.9321368199854736`*^9}, {3.932136874476528*^9, 3.932136881292979*^9}, {
   3.932136934387665*^9, 3.932136943504539*^9}, {3.932137093025973*^9, 
   3.932137114989689*^9}, {3.932138150706597*^9, 3.9321381583960857`*^9}, 
