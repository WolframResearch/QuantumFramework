Cell[TextData[StyleBox["Define the annihilation operator (with automatic \
resizing), the field will be in the second qudit, so we specify the order:", \
"Text"]], "CodeText",
 CellID->108033763,ExpressionUUID->"705fce0c-f87b-7d43-99e9-933b623358d7"],

Cell[BoxData[
 RowBox[{"a", " ", ":=", " ", 
  RowBox[{"AnnihilationOperator", "[", 
   RowBox[{"{", "2", "}"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9666272395440006`*^9, 3.9666272400618286`*^9}, {
  3.9667048841686096`*^9, 3.966704885449106*^9}},
 CellLabel->"In[215]:=",
 CellID->58895617,ExpressionUUID->"43e9eb7a-d815-ad45-8e64-7ec0ebf3ec0a"],

Cell[TextData[{
 "Define the atomic basis and the truncation size. We specify the atomic \
basis with the excited state first because the atom energy term has ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "z"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b77811f2-a8c5-4843-b0a3-0e72f2760975"],
 " , so the first state must have higher energy:"
}], "Text",
 CellID->107418972,ExpressionUUID->"59fa22b7-b294-ba44-ac06-85142e897f3f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "50", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"atomBasis", "=", 
   RowBox[{"QuantumBasis", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<e\>\"", ",", "\"\<g\>\""}], "}"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.966620277565628*^9, 3.966620279704521*^9}, {
  3.9666976958357277`*^9, 3.9666976970337486`*^9}, {3.9666978817550716`*^9, 
  3.9666978819319134`*^9}},
 CellLabel->"In[216]:=",
 CellID->498704825,ExpressionUUID->"c22ef41b-5e20-d447-899c-06c889db5059"],

Cell[TextData[{
 "Transition operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Sigma]", "-"], "=", 
    RowBox[{
     RowBox[{"|", "g", "\[RightAngleBracket]"}], 
     RowBox[{"\[LeftAngleBracket]", "e", "|"}]}]}], TraditionalForm]], 
  "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{{3.985890935284788*^9, 3.985890955377037*^9}},
  ExpressionUUID->"17753cc9-25ee-ad4e-b209-603135abfb21"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Sigma]", "+"], "=", 
    RowBox[{
     RowBox[{"|", "e", "\[RightAngleBracket]"}], 
     RowBox[{"\[LeftAngleBracket]", "g", "|"}]}]}], TraditionalForm]],
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{{3.985890935285734*^9, 3.985890955377037*^9}},
  ExpressionUUID->"a4b591cd-2a9f-3645-a509-ed936775f51e"],
 ":"
}], "Text",
 CellID->63744310,ExpressionUUID->"4b488584-0628-574f-93df-d9f284e5c19c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Sigma]plus", "=", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<+\>\"", ",", "atomBasis"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]minus", "=", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<-\>\"", ",", "atomBasis"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.966620358252846*^9, 3.96662036240485*^9}},
 CellLabel->"In[218]:=",
 CellID->329221303,ExpressionUUID->"8f0f9c51-b2cd-e04f-b6bb-6910ef1a3a51"],

Cell["Verify the Dirac notation:", "Text",
 CellID->61964310,ExpressionUUID->"a074ba78-a402-ee45-81a2-4365365880c2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"\[Sigma]minus", ",", "\[Sigma]plus"}], "}"}], "//", 
  "TraditionalForm"}]], "Input",
 CellLabel->"In[220]:=",
 CellID->24432258,ExpressionUUID->"befbf554-44a7-7c41-adcd-b2e5aa2c80a8"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    InterpretationBox[
     TooltipBox[
      StyleBox[
       InterpretationBox[
        RowBox[{
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"\"g\""}]},
            "Ket"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName["g", "Dual" -> False]], 
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"\"e\""}]},
            "Bra"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName["e", "Dual" -> True]]}],
        Wolfram`QuantumFramework`QuditName[
         Wolfram`QuantumFramework`QuditName["g", "Dual" -> False], 
         Wolfram`QuantumFramework`QuditName["e", "Dual" -> True]]],
       ShowStringCharacters->False],
      TagBox[
       GridBox[{{"\"-\""}, {
          TemplateBox[{"\"QuantumOperator: \"", 
            RowBox[{
              RowBox[{"{", 
                SubscriptBox["2", "1"], "}"}], "\[Rule]", 
              RowBox[{"{", 
                SubscriptBox["2", "1"], "}"}]}]}, "RowDefault"]}}, 
        GridBoxAlignment -> {"Columns" -> {{Center}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"]],
     Wolfram`QuantumFramework`QuantumOperator[
      Wolfram`QuantumFramework`QuantumState[
      SparseArray[Automatic, {4}, 0, {1, {{0, 1}, {{3}}}, {1}}], 
       Wolfram`QuantumFramework`QuantumBasis[<|
        "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
              Wolfram`QuantumFramework`QuditName["e", "Dual" -> True], 1} -> 
            SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
              Wolfram`QuantumFramework`QuditName["g", "Dual" -> True], 1} -> 
            SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
         "Output" -> Wolfram`QuantumFramework`QuditBasis[<|{
              Wolfram`QuantumFramework`QuditName["e", "Dual" -> False], 1} -> 
            SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
              Wolfram`QuantumFramework`QuditName["g", "Dual" -> False], 1} -> 
            SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
         "Picture" -> "Schrodinger", "Label" -> "-", 
         "ParameterSpec" -> {}|>]], {{1}, {1}}]], ",", 
    InterpretationBox[
     TooltipBox[
      StyleBox[
       InterpretationBox[
        RowBox[{
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"\"e\""}]},
            "Ket"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName["e", "Dual" -> False]], 
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"\"g\""}]},
            "Bra"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName["g", "Dual" -> True]]}],
        Wolfram`QuantumFramework`QuditName[
         Wolfram`QuantumFramework`QuditName["e", "Dual" -> False], 
         Wolfram`QuantumFramework`QuditName["g", "Dual" -> True]]],
       ShowStringCharacters->False],
      TagBox[
       GridBox[{{"\"+\""}, {
          TemplateBox[{"\"QuantumOperator: \"", 
            RowBox[{
              RowBox[{"{", 
                SubscriptBox["2", "1"], "}"}], "\[Rule]", 
              RowBox[{"{", 
                SubscriptBox["2", "1"], "}"}]}]}, "RowDefault"]}}, 
        GridBoxAlignment -> {"Columns" -> {{Center}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"]],
     Wolfram`QuantumFramework`QuantumOperator[
      Wolfram`QuantumFramework`QuantumState[
      SparseArray[Automatic, {4}, 0, {1, {{0, 1}, {{2}}}, {1}}], 
       Wolfram`QuantumFramework`QuantumBasis[<|
        "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
              Wolfram`QuantumFramework`QuditName["e", "Dual" -> True], 1} -> 
            SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
              Wolfram`QuantumFramework`QuditName["g", "Dual" -> True], 1} -> 
            SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
         "Output" -> Wolfram`QuantumFramework`QuditBasis[<|{
              Wolfram`QuantumFramework`QuditName["e", "Dual" -> False], 1} -> 
            SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
              Wolfram`QuantumFramework`QuditName["g", "Dual" -> False], 1} -> 
            SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
         "Picture" -> "Schrodinger", "Label" -> "+", 
         "ParameterSpec" -> {}|>]], {{1}, {1}}]]}], "}"}], 
  TraditionalForm]], "Output",
 CellLabel->"Out[220]//TraditionalForm=",
 CellID->180836999,ExpressionUUID->"5a31c19c-5a87-de48-8682-0a8fd4fa51e1"]
}, Open  ]],

Cell["Free Hamiltonian, with the frequencies as parameters:", "Text",
 CellID->1151677,ExpressionUUID->"85df4c0b-4ac2-5549-a0c8-3b1f9f4b58c9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H0", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"h", " ", "\[Nu]", " ", 
       RowBox[{
        SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], "+", "  ", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", "h", " ", "\[Omega]", " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<Z\>\"", ",", "atomBasis"}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", "\[Omega]"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.966627280382374*^9, 3.966627289264799*^9}, {
  3.9666273770916634`*^9, 3.966627378534918*^9}, {3.966627484128786*^9, 
  3.966627487767746*^9}},
 Background->None,
 CellLabel->"In[221]:=",
 CellID->120262363,ExpressionUUID->"09440309-3a62-524b-9900-70a0f8f03388"],

Cell["Atom-field interaction term:", "Text",
 CellChangeTimes->{3.9537561586617756`*^9},
 CellID->12565338,ExpressionUUID->"8749ff03-5478-8540-aba8-5de43619798a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H1", " ", "=", " ", 
   RowBox[{"h", " ", "g", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Sigma]plus", "@", "a"}], " ", "+", 
      RowBox[{"\[Sigma]minus", "@", 
       SuperscriptBox["a", "\[Dagger]"]}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9666273871550503`*^9, 3.9666274345149975`*^9}},
 Background->None,
 CellLabel->"In[222]:=",
 CellID->34160367,ExpressionUUID->"ea20ee74-c4a3-3145-98fb-a8db91a5c7be"],

Cell["Interaction picture Hamiltonian:", "Text",
 CellChangeTimes->{
  3.953756180427561*^9, {3.966626931558531*^9, 3.9666269866620464`*^9}, 
   3.9666270781759453`*^9},
 CellID->82616792,ExpressionUUID->"c3128141-3dc1-2c4c-9fa8-329dbbdaa239"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HInteract", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"MatrixExp", "[", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"H0", "/", "h"}], " ", "t"}], "]"}], "@", " ", 
     RowBox[{"H1", " ", "@", " ", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"H0", "/", "h"}], " ", "t"}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{
  3.935507691182604*^9, {3.9355092403741226`*^9, 3.93550925898095*^9}, {
   3.935509367142691*^9, 3.935509402006359*^9}, {3.935509571785343*^9, 
   3.935509573214687*^9}, {3.9355096258261547`*^9, 3.935509652063593*^9}, {
   3.935509682247745*^9, 3.935509682967472*^9}, 3.9362729682564754`*^9, {
   3.936977671549059*^9, 3.936977700841099*^9}, {3.9370659326853104`*^9, 
   3.9370659416623306`*^9}, {3.937066023526727*^9, 3.9370660310076103`*^9}, {
   3.937066068917912*^9, 3.9370660720303097`*^9}, {3.9370662563735714`*^9, 
   3.937066291774168*^9}, {3.937066340906325*^9, 3.937066371280645*^9}, {
   3.937499693497793*^9, 3.93749969441774*^9}, {3.966626851164942*^9, 
   3.966626860078581*^9}, {3.9666271012637863`*^9, 3.96662710185923*^9}},
 Background->None,
 CellLabel->"In[223]:=",
 CellID->174662274,ExpressionUUID->"79e069f7-e81d-8a46-95d0-110b0bd142f0"],

Cell[TextData[StyleBox["At resonance this Hamiltonian is time independent:", \
"Text"]], "CodeText",
 CellChangeTimes->{{3.966627084798523*^9, 3.966627089612238*^9}, {
  3.972141563824526*^9, 3.972141574264494*^9}},
 CellID->798417804,ExpressionUUID->"ddd87792-d170-1e47-a5c1-856930fd53ab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FreeQ", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"HInteract", "[", 
     RowBox[{"\[Nu]", ",", "\[Nu]"}], "]"}], "[", "\"\<AmplitudeList\>\"", 
    "]"}], ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.966627027003149*^9, 3.966627065194008*^9}},
 CellLabel->"In[224]:=",
 CellID->78510405,ExpressionUUID->"0111e0b2-0f03-d947-addc-2c2dd4a9a870"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[224]=",
 CellID->739295254,ExpressionUUID->"ccd85bd9-39c0-a942-a0bc-21a103839c9e"]
}, Open  ]],

Cell[TextData[{
 StyleBox["So we can solve for the evolution operator ", "Text"],
 StyleBox[Cell[BoxData[
  FormBox[
   OverscriptBox["U", "^"], TraditionalForm]], "Text",ExpressionUUID->
  "5b7650ce-bda1-884c-91d4-2fef0544e2a9"], "Text"],
 StyleBox[":", "Text"]
}], "CodeText",
 CellChangeTimes->{{3.9666271116309586`*^9, 3.966627154686865*^9}, {
  3.972141550644726*^9, 3.972141550879652*^9}, {3.9721418016276855`*^9, 
  3.9721418017950134`*^9}},
 CellID->104681719,ExpressionUUID->"94230d7f-027e-0546-a419-aaa9233789a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"U", " ", "=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     RowBox[{
      RowBox[{"HInteract", "[", 
       RowBox[{"\[Nu]", ",", "\[Nu]"}], "]"}], "/", "h"}], " ", "t"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.9666978208735123`*^9, {3.966697934551218*^9, 3.966697935355877*^9}},
 CellLabel->"In[225]:=",
 CellID->763854760,ExpressionUUID->"17f3d100-b644-854c-a03f-746e929fa1d7"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Solving JCH: Fock state as initial field state", \
"Subsubsection"]], "Subsubsection",
