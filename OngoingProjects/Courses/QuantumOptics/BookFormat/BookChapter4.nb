Cell[TextData[StyleBox["Test that limit(we negate first components to follow \
the literature convention):", "Text"]], "CodeText",
 CellChangeTimes->{{3.96680227000313*^9, 3.9668022846068306`*^9}, {
  3.96962536995446*^9, 3.969625383258663*^9}},
