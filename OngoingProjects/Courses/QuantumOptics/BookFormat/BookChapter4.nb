Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"atomicHamiltonian", " ", "=", " ", 
  RowBox[{"h", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"\"\<X\>\"", ",", "atomBasis"}], "]"}], 
      SubscriptBox["\[CapitalOmega]", "1"], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{
        RowBox[{"\[Omega]", " ", "t"}], " ", "+", "\[Phi]"}], "]"}]}], "+", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          SubscriptBox["\[Omega]", "0"]}], "}"}], "]"}], ",", "atomBasis"}], 
      "]"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.932125901578838*^9, 3.932125958991241*^9}, {
   3.9321260466209316`*^9, 3.932126047014925*^9}, {3.932126083198662*^9, 
