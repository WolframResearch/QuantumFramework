Cell[TextData[{
 "With those matrix elements we can generate a matrix that contains the \
relevant dynamics (that is a given due to the interaction term of the \
Hamiltonian), it can be reduced to a ",
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{"2", " ", "x", " ", "2"}], TraditionalForm]], "CodeText",
  FormatType->TraditionalForm,ExpressionUUID->
  "48e131fa-e5fd-4c40-9519-b90991b5c99e"], "CodeText"],
 StyleBox[" ", "CodeText"],
 "subspace for a given ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "8dd985bf-3820-7f4f-93d3-47b13da756ff"],
 ":"
}], "Text",
 CellID->18971964,ExpressionUUID->"76eabaf9-c2b8-1c4b-8857-72c8d8befbaa"],

Cell[TextData[StyleBox["Dressed subspace operator:", "Text"]], "CodeText",
 CellChangeTimes->{{3.966705583667507*^9, 3.9667055942539234`*^9}, {
  3.9668019059938297`*^9, 3.9668019187312737`*^9}},
 CellID->598826628,ExpressionUUID->"4b7da8bb-1f7b-4f49-ae92-5fb36e771ec4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dressedSubspace", " ", "=", " ", 
  RowBox[{"QuantumOperator", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"n", " ", "\[Nu]"}], " ", "+", 
          RowBox[{
           RowBox[{"1", "/", "2"}], "  ", "\[Omega]"}]}], ")"}]}], ",", 
       RowBox[{"h", " ", "g", " ", 
        SqrtBox[
         RowBox[{"n", "+", "1"}]]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", " ", "g", " ", 
        SqrtBox[
         RowBox[{"n", "+", "1"}]]}], ",", " ", 
       RowBox[{"h", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "+", "1"}], ")"}], " ", "\[Nu]"}], " ", "-", 
          RowBox[{
           RowBox[{"1", "/", "2"}], " ", "\[Omega]"}]}], ")"}]}]}], "}"}]}], 
    "}"}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.925491996135374*^9, {3.925492033803463*^9, 3.9254921725569687`*^9}, {
   3.9254922730914745`*^9, 3.925492286658281*^9}, {3.9254923499751625`*^9, 
   3.925492377509527*^9}, {3.92549242104891*^9, 3.925492423719076*^9}, {
   3.9254924594231567`*^9, 3.925492492275196*^9}, {3.925492525560169*^9, 
   3.925492532398964*^9}, {3.925811994324962*^9, 3.9258120063119297`*^9}, {
   3.925812068418537*^9, 3.9258120711841564`*^9}, {3.9258121166180573`*^9, 
   3.925812124321146*^9}, {3.925834178679663*^9, 3.925834181161412*^9}, {
   3.925834232265351*^9, 3.925834270043234*^9}},
 CellLabel->"In[354]:=",
 CellID->164387314,ExpressionUUID->"5b98a2fe-0afc-5144-a601-949c43fb628d"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   TooltipBox[
    StyleBox[
     RowBox[{
      RowBox[{
       RowBox[{"h", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"n", " ", "\[Nu]"}], "+", 
          FractionBox["\[Omega]", "2"]}], ")"}]}], 
       InterpretationBox[
        RowBox[{
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"0"}]},
            "Ket"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[0, "Dual" -> False]], 
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"0"}]},
            "Bra"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[0, "Dual" -> True]]}],
        Wolfram`QuantumFramework`QuditName[
         Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 
         Wolfram`QuantumFramework`QuditName[0, "Dual" -> True]]]}], "+", 
      RowBox[{
       RowBox[{"g", " ", "h", " ", 
        SqrtBox[
         RowBox[{"1", "+", "n"}]]}], 
       InterpretationBox[
        RowBox[{
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"0"}]},
            "Ket"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[0, "Dual" -> False]], 
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"1"}]},
            "Bra"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[1, "Dual" -> True]]}],
        Wolfram`QuantumFramework`QuditName[
         Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 
         Wolfram`QuantumFramework`QuditName[1, "Dual" -> True]]]}], "+", 
      RowBox[{
       RowBox[{"g", " ", "h", " ", 
        SqrtBox[
         RowBox[{"1", "+", "n"}]]}], 
       InterpretationBox[
        RowBox[{
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"1"}]},
            "Ket"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[1, "Dual" -> False]], 
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"0"}]},
            "Bra"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[0, "Dual" -> True]]}],
        Wolfram`QuantumFramework`QuditName[
         Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 
         Wolfram`QuantumFramework`QuditName[0, "Dual" -> True]]]}], "+", 
      RowBox[{
       RowBox[{"h", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "n"}], ")"}], " ", "\[Nu]"}], "-", 
          FractionBox["\[Omega]", "2"]}], ")"}]}], 
       InterpretationBox[
        RowBox[{
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"1"}]},
            "Ket"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[1, "Dual" -> False]], 
         InterpretationBox[
          StyleBox[
           TemplateBox[{
             RowBox[{"1"}]},
            "Bra"],
           FontWeight->"Plain"],
          Wolfram`QuantumFramework`QuditName[1, "Dual" -> True]]}],
        Wolfram`QuantumFramework`QuditName[
         Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 
         Wolfram`QuantumFramework`QuditName[1, "Dual" -> True]]]}]}],
     ShowStringCharacters->False],
    TagBox[
     GridBox[{{"None"}, {
        TemplateBox[{"\"QuantumOperator: \"", 
          RowBox[{
            RowBox[{"{", 
              SubscriptBox["2", "1"], "}"}], "\[Rule]", 
            RowBox[{"{", 
              SubscriptBox["2", "1"], "}"}]}]}, "RowDefault"]}}, 
      GridBoxAlignment -> {"Columns" -> {{Center}}}, DefaultBaseStyle -> 
      "Column", 
      GridBoxItemSize -> {
       "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"]],
   Wolfram`QuantumFramework`QuantumOperator[
    Wolfram`QuantumFramework`QuantumState[
    SparseArray[
     Automatic, {4}, 0, {
      1, {{0, 4}, {{1}, {2}, {3}, {
        4}}}, {$CellContext`h ($CellContext`n $CellContext`\[Nu] + 
         Rational[
           1, 2] $CellContext`\[Omega]), $CellContext`g $CellContext`h (
          1 + $CellContext`n)^
         Rational[1, 2], $CellContext`g $CellContext`h (1 + $CellContext`n)^
         Rational[
          1, 2], $CellContext`h ((1 + $CellContext`n) $CellContext`\[Nu] + 
         Rational[-1, 2] $CellContext`\[Omega])}}], 
     Wolfram`QuantumFramework`QuantumBasis[<|
      "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
            Wolfram`QuantumFramework`QuditName[0, "Dual" -> True], 1} -> 
          SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
            Wolfram`QuantumFramework`QuditName[1, "Dual" -> True], 1} -> 
          SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
       "Output" -> Wolfram`QuantumFramework`QuditBasis[<|{
            Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 1} -> 
          SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
            Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 1} -> 
          SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
       "Picture" -> "Schrodinger", "Label" -> None, 
       "ParameterSpec" -> {}|>]], {{1}, {1}}]], TraditionalForm]], "Output",
 CellLabel->"Out[354]=",
 CellID->208253501,ExpressionUUID->"101ab92b-4e7c-8642-b6ed-9c98b08fc762"]
}, Open  ]],

Cell[TextData[StyleBox["Calculate the eigenvalues expressed in terms of the \
detuning:", "Text"]], "CodeText",
 CellID->174860325,ExpressionUUID->"1201ef99-bab7-944d-a748-46d3925d0477"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"eigenvals", " ", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"ReplaceAll", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Nu]", "-", "\[Omega]"}], ")"}], "->", "\[CapitalDelta]"}],
        "}"}]}], "]"}], "&"}], " ", "/@", 
   RowBox[{"(", 
    RowBox[{"dressedSubspace", "[", "\"\<Eigenvalues\>\"", "]"}], 
    ")"}]}]}]], "Input",
 CellChangeTimes->{{3.925492536469473*^9, 3.925492541412539*^9}, {
  3.925492647205101*^9, 3.9254926656393166`*^9}, {3.925492703948984*^9, 
  3.9254927639913654`*^9}, {3.9254928010426655`*^9, 3.925492803548767*^9}, {
  3.925492928263361*^9, 3.9254929511960106`*^9}, {3.9254929872542324`*^9, 
  3.9254929877050114`*^9}, {3.9258120787622776`*^9, 3.9258120804185143`*^9}, {
  3.925812137731539*^9, 3.92581213812236*^9}, {3.925812403312511*^9, 
  3.9258124065464935`*^9}, {3.925813386783361*^9, 3.925813405811798*^9}, {
  3.925813449068544*^9, 3.925813462459116*^9}, {3.9258151782122784`*^9, 
  3.925815242901644*^9}, {3.925815273722359*^9, 3.925815278941078*^9}, {
  3.925834285185347*^9, 3.925834294368418*^9}, {3.934306181290739*^9, 
  3.9343061837541037`*^9}},
 CellLabel->"In[355]:=",
 CellID->71063424,ExpressionUUID->"1dbf5917-be62-c143-82fe-9f395951066a"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", "h", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SqrtBox[
         RowBox[{
          SuperscriptBox["\[CapitalDelta]", "2"], "+", 
          RowBox[{"4", " ", 
           SuperscriptBox["g", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"n", "+", "1"}], ")"}]}]}]]}], "+", "\[Nu]", "+", 
       RowBox[{"2", " ", "\[Nu]", " ", "n"}]}], ")"}]}], ",", 
    RowBox[{
     FractionBox["1", "2"], " ", "h", " ", 
     RowBox[{"(", 
      RowBox[{
       SqrtBox[
        RowBox[{
         SuperscriptBox["\[CapitalDelta]", "2"], "+", 
         RowBox[{"4", " ", 
          SuperscriptBox["g", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"n", "+", "1"}], ")"}]}]}]], "+", "\[Nu]", "+", 
       RowBox[{"2", " ", "\[Nu]", " ", "n"}]}], ")"}]}]}], "}"}], 
  TraditionalForm]], "Output",
 CellLabel->"Out[355]=",
 CellID->388737782,ExpressionUUID->"42d87ed7-eb70-5b4c-a000-28b9b7263d33"]
}, Open  ]],

Cell[TextData[{
 "With the interaction Hamiltonian there is an energy shift  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[HBar]", " ", 
    RowBox[{
     SubscriptBox["\[CapitalOmega]", "n"], "(", "\[CapitalDelta]", ")"}]}], 
   TraditionalForm]],ExpressionUUID->"2bff6e14-dd8e-7e45-abc1-03bf4a20f11a"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalOmega]", "n"], "(", "\[CapitalDelta]", ")"}], " ",
     "=", " ", 
    SqrtBox[
     RowBox[{
      RowBox[{"4", 
       RowBox[{
        SuperscriptBox["g", "2"], "(", 
        RowBox[{"n", "+", "1"}], ")"}]}], " ", "+", " ", 
      SuperscriptBox["\[CapitalDelta]", "2"]}]]}], TraditionalForm]],
  ExpressionUUID->"3ca72f8b-c9e1-8a4b-a0a6-b8f42b94c62b"],
 " (generalized Rabi frequency). The energy splitting of the states is also \
called",
 StyleBox[" ",
  FontSlant->"Italic"],
 StyleBox["AC Stark Shift",
  FontWeight->"Bold",
  FontSlant->"Italic"]
}], "Text",
 CellID->173109227,ExpressionUUID->"820d80c3-b107-a549-9d96-eb3f8fd2cf7f"],

