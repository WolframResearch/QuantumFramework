Cell[CellGroupData[{

Cell[TextData[StyleBox["Atom-field interaction (quantum model two level atom \
and single mode field)", "Subsection"]], "Subsection",
 CellChangeTimes->{{3.924950863283537*^9, 3.924950869021581*^9}, {
  3.924953206588574*^9, 3.9249532204924316`*^9}, {3.924954294972893*^9, 
  3.9249542979044895`*^9}, {3.924957926605287*^9, 3.9249579291657143`*^9}, {
  3.924958575747656*^9, 3.9249585784796314`*^9}},
 CellID->118550611,ExpressionUUID->"c7cce889-8c6a-e04a-90c2-9d4bde2801c3"],

Cell["\<\
Having introduced the semiclassical models and field quantization, we can \
describe the interactions in a fully quantum model. The general multiple-mode \
field and two-level atom Hamiltonian takes the form:\
\>", "Text",
 CellChangeTimes->{3.9696210207143*^9},
 CellID->177246626,ExpressionUUID->"7b4fd340-37ac-324d-a490-eb56d282b98a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["\[ScriptCapitalH]", "Bold"], "=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox[
      StyleBox["\[Sum]",
       FontSize->18], "k", ""], 
     RowBox[{"\[HBar]", " ", 
      SubscriptBox["\[Nu]", "k"], 
      SuperscriptBox[
       SubscriptBox[
        OverscriptBox["a", "^"], "k"], "\[Dagger]"], 
      SubscriptBox[
       OverscriptBox["a", "^"], "k"]}]}], "+", 
    RowBox[{
     FractionBox["1", "2"], "\[HBar]", " ", "\[Omega]", " ", 
     SubscriptBox["\[Sigma]", "z"]}], "+", 
    RowBox[{"\[HBar]", " ", 
     RowBox[{
      UnderoverscriptBox[
       StyleBox["\[Sum]",
        FontSize->18], "k", ""], " ", 
      RowBox[{
       SubscriptBox["g", "k"], "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Sigma]", "+"], 
         SubscriptBox[
          OverscriptBox["a", "^"], "k"]}], "+", 
        RowBox[{
         SuperscriptBox[
          SubscriptBox[
           OverscriptBox["a", "^"], "k"], "\[Dagger]"], 
         SubscriptBox["\[Sigma]", "-"]}]}], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 CellID->503277016,ExpressionUUID->"c7e69299-1455-c649-a132-cbf45f6fa342"],

Cell[TextData[{
 "The Hamiltonian considering only a single-mode field and a two-level atom \
(after using RWA in the interaction term), results in the famous ",
 StyleBox["Jaynes",
  IgnoreSpellCheck->True,
  FontSlant->"Italic"],
 StyleBox["-Cummings Hamiltonian(JCH)",
  FontSlant->"Italic"],
 ": "
}], "Text",
 CellID->68882775,ExpressionUUID->"b12aa3a8-467e-a248-a96f-475176d0aa18"],

Cell["Energy of the field and atom:", "Text",
 CellID->368041893,ExpressionUUID->"86b90a50-89cb-a44e-abf7-da95a4385a1b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[ScriptCapitalH]", "0"], "=", 
   RowBox[{
    RowBox[{"\[HBar]", " ", "\[Nu]", " ", 
     SuperscriptBox[
      OverscriptBox["a", "^"], "\[Dagger]"], 
     OverscriptBox["a", "^"]}], "+", 
    RowBox[{
     FractionBox["1", "2"], "\[HBar]", " ", "\[Omega]", " ", 
     SubscriptBox["\[Sigma]", "z"]}]}]}], TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{{3.9858909352824745`*^9, 3.9858909553760376`*^9}},
 CellID->42294596,ExpressionUUID->"4c67b045-ad1d-164c-8a74-12f4dd22512c"],

Cell[TextData[{
 "Interaction term, ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bd129a70-6c4d-094d-8c0d-49ab7ddd3dbf"],
 " represents the coupling between the atom and field:"
}], "Text",
 CellID->129175796,ExpressionUUID->"ea3bd29e-0c36-244e-afdb-87d21a9d9856"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[ScriptCapitalH]", "I"], "=", 
   RowBox[{"\[HBar]", " ", "g", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Sigma]", "+"], 
       OverscriptBox["a", "^"]}], "+", 
      RowBox[{
       SubscriptBox["\[Sigma]", "-"], 
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{{3.985890935283474*^9, 3.985890955377037*^9}},
 CellID->419534861,ExpressionUUID->"58b625d5-a5dd-904c-b943-4827f91b8873"],

Cell[TextData[{
 "Representation of the basis that will be used, complete system is \
represented in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalH]", "atom"], "\[CircleTimes]", 
    SubscriptBox["\[ScriptCapitalH]", "field"]}], TraditionalForm]],
  ExpressionUUID->"68aac8f1-e5c3-9343-b0fa-63c3f77311ec"],
 " (Hilbert spaces):"
}], "Text",
 CellID->283715714,ExpressionUUID->"1999e3fd-d677-ae42-b560-ae3fb4e1b843"],

