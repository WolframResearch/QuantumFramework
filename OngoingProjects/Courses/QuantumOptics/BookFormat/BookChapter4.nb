     FormatType->TraditionalForm,ExpressionUUID->
     "e4f25952-9498-eb46-95fe-bc8139ef59c0"]],ExpressionUUID->
     "a427eba8-c5b2-2f4e-9f5a-7d386d8d360a"]}], TraditionalForm]],
  ExpressionUUID->"1e463301-acee-424f-b6ec-06c27df5edde"],
 ":"
}], "Text",
