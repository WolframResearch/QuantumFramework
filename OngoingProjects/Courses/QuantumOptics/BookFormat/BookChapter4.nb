Cell[TextData[StyleBox["Finding the probability of finding the atom in the \
excited state using a projection:", "Text"]], "CodeText",
 CellChangeTimes->{{3.966628091486643*^9, 3.9666281092157955`*^9}},
 CellID->601240352,ExpressionUUID->"6dcee682-f488-7049-a1e6-f9fceaa2b68a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"probE", " ", "=", 
  SuperscriptBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"QuantumState", "[", 
        RowBox[{"\"\<0\>\"", ",", "atomBasis"}], "]"}], "\[Dagger]"], "@", 
      "\[Psi]t"}], ")"}], "[", "\"\<Norm\>\"", "]"}], "2"]}]], "Input",
 CellChangeTimes->{{3.966627961351946*^9, 3.9666280581575966`*^9}},
 CellLabel->"In[228]:=",
 CellID->125823,ExpressionUUID->"b24232ac-bd07-aa43-b524-e0eb384d3bc0"],

Cell[BoxData[
 FormBox[
  SuperscriptBox[
   TemplateBox[{
     RowBox[{"sin", "(", 
       RowBox[{"g", " ", "t"}], ")"}]},
    "Abs"], "2"], TraditionalForm]], "Output",
 CellLabel->"Out[228]=",
 CellID->113903696,ExpressionUUID->"16f1344c-3c45-a74f-b0ec-97fa58abc65e"]
}, Open  ]],

