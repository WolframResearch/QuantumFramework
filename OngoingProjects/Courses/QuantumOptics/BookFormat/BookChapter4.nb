Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Rho]", "u"], "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{" ", "n"}], ""], 
        SuperscriptBox[
         RowBox[{"|", 
          RowBox[{
           SubscriptBox["a", "n"], "(", "t", ")"}], "|"}], "2"]}], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{" ", "n"}], ""], 
        SubscriptBox["a", "n"], "(", "t", ")", 
        SuperscriptBox[
         SubscriptBox["b", "n"], "*"], "(", "t", ")"}]},
      {
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{" ", "n"}], ""], 
        SubscriptBox["b", "n"], "(", "t", ")", 
        SuperscriptBox[
         SubscriptBox["a", "n"], "*"], "(", "t", ")"}], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{" ", "n"}], ""], 
        SuperscriptBox[
         RowBox[{"|", 
          RowBox[{
           SubscriptBox["b", "n"], "(", "t", ")"}], "|"}], "2"]}]}
     }], ")"}]}], TraditionalForm]], "DisplayFormula",
 CellID->443867208,ExpressionUUID->"25f88804-ba23-a148-8f6f-1daf56defda5"],

Cell["\<\
Employing the parametrization of the density matrix in terms of Bloch vector \
components, it is possible to obtain the relations\
\>", "Text",
