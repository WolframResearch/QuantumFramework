Cell[TextData[{
 "Consider the atom-field Hamiltonian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Omega]", "c"], " ", 
     SuperscriptBox["a", "\[Dagger]"], " ", "a"}], "+", 
    RowBox[{
     FractionBox[
      SubscriptBox["\[Omega]", "r"], "2"], " ", 
     SubscriptBox["\[Sigma]", "z"]}], "+", 
    RowBox[{"g", " ", 
     SubscriptBox["\[Sigma]", "x"], " ", "(", 
     RowBox[{"a", "+", 
      SuperscriptBox["a", "\[Dagger]"]}], ")"}]}], TraditionalForm]], 
  "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{{3.9858909353148384`*^9, 3.985890955389761*^9}},
  ExpressionUUID->"4c2efdf1-712e-0740-adaa-180d9a7415a1"],
 " without using the rotating wave approximation, this means keeping also \
terms that are not energy preserving ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Sigma]", "x"], "is", " ", "used"}], ")"}], 
   TraditionalForm]],ExpressionUUID->"5d6ab39c-8ae9-1943-a223-6f13c1e35be9"],
 ". Use values of strong coupling ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Omega]", "c"], "/", "g"}], " ", "\[TildeTilde]", " ", 
    "0.5"}], TraditionalForm]],ExpressionUUID->
  "09abddc9-69b4-1a46-a41b-7bfa66eda173"],
 "  , initial state |e,0\[RightAngleBracket]  and plot the concurrence and \
the Rabi oscillations as function of time. Also visualize the Wigner function \
of the field system at times when there is high atom-field entanglement."
}], "Exercise",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellID->700159855,ExpressionUUID->"bc6e0c9a-a3a1-8041-a286-45edb20b8be0"],

Cell["Solution", "ExerciseSolution",
 CellID->270685216,ExpressionUUID->"c1bff68e-da4d-f346-b0bc-e3e98fc48c66"],

Cell[CellGroupData[{

Cell["Define the atomic basis:", "ExerciseNote",
 CellID->213512622,ExpressionUUID->"9a586488-4dc5-cc4c-a2f2-b98f6f77bc2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"atomBasis", " ", "=", " ", 
   RowBox[{"QuantumBasis", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<e\>\"", ",", "\"\<g\>\""}], "}"}], "]"}]}], 
  ";"}]], "ExerciseInput",
 CellChangeTimes->{{3.9724035893573074`*^9, 3.9724035996103497`*^9}, 
   3.9724036306403255`*^9},
 CellLabel->"In[59]:=",
 CellID->176045743,ExpressionUUID->"125d4315-ac08-f440-82ad-a7ebe6421033"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Define the atomic operators:", "ExerciseNote",
 CellID->205562163,ExpressionUUID->"377f3c25-1db6-b948-93d5-5c67ecdd0b89"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Sigma]plus", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<+\>\"", ",", "atomBasis"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]minus", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<-\>\"", ",", "atomBasis"}], "]"}]}], ";"}]}], "ExerciseInput",
 CellChangeTimes->{{3.972403635218668*^9, 3.9724036661469097`*^9}},
 CellLabel->"In[62]:=",
 CellID->68661454,ExpressionUUID->"e7b58753-9be5-294e-8bcd-46dedb66123b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Define the Hamiltonian:", "ExerciseNote",
 CellChangeTimes->{{3.972412637995941*^9, 3.972412642806572*^9}},
 CellID->18696221,ExpressionUUID->"33ffc97e-e1df-5747-9198-53e225d0cced"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H", " ", "=", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Omega]c", " ", 
       RowBox[{
        SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], "+", " ", 
      RowBox[{
       FractionBox["\[Omega]r", "2"], 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<Z\>\"", ",", "atomBasis"}], "]"}]}], "+", " ", 
      RowBox[{"g", " ", 
       RowBox[{"QuantumTensorProduct", "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<X\>\"", ",", "atomBasis"}], "]"}], ",", 
         RowBox[{"a", "+", 
          SuperscriptBox["a", "\[Dagger]"]}]}], "]"}]}]}], ",", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\[Omega]c", ",", "\[Omega]r", ",", "g"}], "}"}]}]}], "]"}]}], 
  ";"}]], "ExerciseInput",
 CellChangeTimes->{{3.972403548922327*^9, 3.9724035835716953`*^9}, {
  3.972403677717596*^9, 3.9724037559690304`*^9}},
 CellLabel->"In[69]:=",
 CellID->280984275,ExpressionUUID->"262f92f8-b7e6-194c-8dff-c3ecb8583b82"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Initial state:", "ExerciseNote",
 CellChangeTimes->{{3.9724126466848927`*^9, 3.972412648071106*^9}, 
   3.9724127536636524`*^9},
 CellID->510755056,ExpressionUUID->"b69c8c0d-2ca7-574e-a48d-33ca8fc0a176"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]0", " ", "=", " ", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<0\>\"", ",", "atomBasis"}], "]"}], ",", 
     RowBox[{"FockState", "[", "0", "]"}]}], "]"}]}], ";"}]], "ExerciseInput",
 CellLabel->"In[153]:=",
 CellID->218951358,ExpressionUUID->"3b1c10eb-6da2-714f-973b-7afbb7f25e5c"]
}, Open  ]],

