Cell["\<\
Initial state (atom excited and field coherent state with |\[Alpha]|=5:\
\>", "Text",
 CellID->32078113,ExpressionUUID->"d357bb9c-6f39-0646-b06b-162e57d87ae9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]0", " ", "=", " ", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<0\>\"", ",", "atomBasis"}], "]"}], ",", 
     RowBox[{
      RowBox[{"CoherentState", "[", "]"}], "[", "5.", "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[518]:=",
 CellID->258611736,ExpressionUUID->"8229448f-bb60-0c46-af6f-e6a90431826d"],

Cell[TextData[StyleBox["Evolved state:", "Text"]], "CodeText",
 CellChangeTimes->{{3.966806676131075*^9, 3.966806685213135*^9}},
 CellID->598324255,ExpressionUUID->"a682c3bd-4351-2a45-b22b-024bc707abd8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]t", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"U", "@", "\[Psi]0"}], ")"}], ",", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"g", ",", "t"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9538232295359287`*^9, 3.953823251903702*^9}, {
  3.9538233103293686`*^9, 3.953823341436199*^9}},
 CellLabel->"In[519]:=",
 CellID->8303716,ExpressionUUID->"bc9539d6-9670-ca44-9c55-8e091ba0b12e"],

Cell["Bloch vector of reduced density matrix:", "Text",
 CellChangeTimes->{{3.9538311837867985`*^9, 3.953831190820921*^9}},
 CellID->341690842,ExpressionUUID->"5092de46-5f36-4349-b536-53e9c99ac496"],

Cell[BoxData[
 RowBox[{
  RowBox[{"blochVector", " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumPartialTrace", "[", 
      RowBox[{
       RowBox[{"U", "@", "\[Psi]0"}], ",", 
       RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<BlochVector\>\"", "]"}], 
    " ", "/.", " ", 
    RowBox[{
     RowBox[{"g", " ", "t"}], "->", "T"}]}]}], ";"}]], "Input",
 CellLabel->"In[520]:=",
 CellID->100001809,ExpressionUUID->"fe171c10-ad41-3843-8f70-7b45c047fdbf"],

