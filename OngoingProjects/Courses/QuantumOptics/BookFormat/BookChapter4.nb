}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Semiclassical Hamiltonian models", "Subsection"]], \
"Subsection",
 CellChangeTimes->{{3.930757474929203*^9, 3.9307574795256033`*^9}, {
  3.930826706564369*^9, 3.9308267079175434`*^9}, {3.9308293806781635`*^9, 
  3.93082938241098*^9}, {3.9666161058124714`*^9, 3.9666161063766117`*^9}},
 CellID->26237480,ExpressionUUID->"6b112350-5715-8444-b1a6-b519b346b26f"],

Cell[TextData[{
 "The simplest semiclassical model  is to consider the dynamics of a single \
electron in the field of a stationary nucleus. The motion of the electron is \
described by quantum operators, while the field is taken to be classical \
defined by the potentials ",
 Cell[BoxData[
  FormBox[
   StyleBox["A",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "51a64cbe-5fa3-4749-b1a2-a6e09c85ab13"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"r", ",", "t"}], ")"}], " "}], TraditionalForm]],ExpressionUUID->
  "ad049c88-3329-ef4a-87cb-86a62024ece9"],
 "and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U",
     FontWeight->"Bold"], "(", 
    RowBox[{"r", ",", "t"}], ")"}], TraditionalForm]],ExpressionUUID->
  "2af9c7f1-7c07-4c47-898e-d99286bd81ed"]
}], "Text",
 CellChangeTimes->{{3.9318616322680664`*^9, 3.9318618497375565`*^9}, {
  3.9318618817037354`*^9, 3.9318619213482*^9}, {3.9318623623266754`*^9, 
  3.9318624652326984`*^9}, {3.9318627374077415`*^9, 3.9318627653974857`*^9}, {
  3.931862820523773*^9, 3.9318628225355206`*^9}, {3.9666157256752415`*^9, 
  3.9666157256752415`*^9}, {3.969619932037628*^9, 3.9696199497634506`*^9}},
 CellID->68727535,ExpressionUUID->"af512c6b-86a8-7b46-85e7-227c0b9439ca"],

Cell["\<\
It can be shown using the Lagrangian formalism, that the interaction \
Hamiltonian that includes the field of the nucleus and also external fields \
takes the following form:\
\>", "Text",
 CellChangeTimes->{{3.9318616322680664`*^9, 3.9318618497375565`*^9}, {
   3.9318618817037354`*^9, 3.9318619213482*^9}, {3.9318623623266754`*^9, 
   3.9318624652326984`*^9}, {3.9318627374077415`*^9, 
   3.9318627653974857`*^9}, {3.931862820523773*^9, 3.9318628225355206`*^9}, 
   3.9666157368025036`*^9, {3.9696199840747128`*^9, 3.9696200079812584`*^9}},
 CellID->300395806,ExpressionUUID->"cd3f7986-0e3f-7840-96fa-34ebd18c8069"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox[
    OverscriptBox["H", "^"],
    FontSize->18], "=", 
   RowBox[{
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        OverscriptBox[
         StyleBox["p",
          FontWeight->"Bold"], "^"], "-", 
        RowBox[{"q", " ", 
         RowBox[{
          OverscriptBox[
           StyleBox["A",
            FontWeight->"Bold"], "^"], "(", 
          RowBox[{
           OverscriptBox["r", "^"], ",", "t"}], ")"}]}]}], ")"}], "2"], 
     RowBox[{"2", " ", "m"}]], "+", 
    RowBox[{"q", " ", 
     RowBox[{"U", "(", 
      RowBox[{
       OverscriptBox[
        StyleBox["r",
         FontWeight->"Bold"], "^"], ",", "t"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->223910686,ExpressionUUID->"ae76a18e-3a4b-5e45-b7fb-6702891b97ed"],

Cell[TextData[{
 "This Hamiltonian leads to the classical equation of motion when averages  \
values are calculated. There exists an infinite number of pairs {",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["A",
      FontWeight->"Bold"], "(", 
     RowBox[{"r", ",", "t"}], ")"}], ",", " ", 
    RowBox[{
     StyleBox["U",
      FontWeight->"Bold"], "(", 
     RowBox[{"r", ",", "t"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "e2bb67a4-9cab-f542-aae7-78596138e790"],
 "} associated with values of electric and magnetic fields, going from a pair \
of potentials to another valid pair is done by the so called Gauge \
transformations"
}], "Text",
 CellChangeTimes->{{3.931862932372606*^9, 3.9318629772057*^9}, {
   3.931863175155632*^9, 3.931863183617029*^9}, {3.931876412431185*^9, 
   3.9318764125613537`*^9}, {3.931877174760614*^9, 3.93187734390394*^9}, {
   3.9318774982912*^9, 3.931877500957615*^9}, {3.931877589251943*^9, 
   3.931877598813783*^9}, {3.931878206186853*^9, 3.931878208260448*^9}, {
   3.966615683954323*^9, 3.9666157088119507`*^9}, 3.966615743319998*^9},
 CellID->242730096,ExpressionUUID->"680af26c-2513-b448-a932-9563649109dd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox[Cell["A",ExpressionUUID->"101b314c-6799-8e4c-a6b0-2f466f111e0d"],
      FontWeight->"Bold"], "'"}], 
    RowBox[{"(", 
     RowBox[{"r", ",", "t"}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     StyleBox[Cell["A",ExpressionUUID->"6e2ca1f7-a8ae-3341-9997-81ecf48735c8"],
      FontWeight->"Bold"], 
     RowBox[{
      StyleBox["(",
       FontWeight->"Bold"], 
      RowBox[{"r", ",", "t"}], ")"}]}], "+", 
    RowBox[{"\[Del]", 
     RowBox[{"F", "(", 
      RowBox[{"r", ",", "t"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->60690860,ExpressionUUID->"576c4d86-4b61-ef41-b774-2ed874b853f3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox[Cell["U",ExpressionUUID->"5a73c4ff-57fc-1946-afe4-96bbe21fbfc6"],
      FontWeight->"Bold"], "'"}], 
    RowBox[{"(", 
     RowBox[{"r", ",", "t"}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     StyleBox[Cell["U",ExpressionUUID->"dd7ad044-7736-3949-b2fb-8fc7f4b7cdd5"],
      FontWeight->"Bold"], 
     RowBox[{
      StyleBox["(",
       FontWeight->"Bold"], 
      RowBox[{"r", ",", "t"}], ")"}]}], "-", 
    RowBox[{
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", "t"}]], 
     RowBox[{"F", "(", 
      RowBox[{"r", ",", "t"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->654198049,ExpressionUUID->"7f26ec9e-f64c-6849-ad9b-a2a8408011d4"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["F", TraditionalForm]],ExpressionUUID->
  "fda52b07-b636-9843-a250-21fb7a113ee1"],
 "(",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "0845f820-9cf6-a248-8ef8-66b63846e90f"],
 ", ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "41ae6781-5739-9344-8240-14167073fd6c"],
 ")  is just a scalar field "
}], "Text",
 CellChangeTimes->{{3.931862932372606*^9, 3.9318629772057*^9}, {
  3.931863175155632*^9, 3.931863183617029*^9}, {3.931876412431185*^9, 
  3.9318764125613537`*^9}, {3.931877174760614*^9, 3.93187734390394*^9}, {
  3.9318774982912*^9, 3.931877500957615*^9}, {3.931877589251943*^9, 
  3.931877598813783*^9}, {3.931878206186853*^9, 3.931878208260448*^9}, {
  3.966615683954323*^9, 3.9666157088119507`*^9}, {3.9666157467442436`*^9, 
  3.9666157906971188`*^9}, {3.9666160069236584`*^9, 3.966616006924656*^9}},
 CellID->276570963,ExpressionUUID->"f44a6cff-3260-794c-8e3a-585794d4eabb"],

Cell["Define the potentials and the scalar field:", "Text",
 CellID->710895,ExpressionUUID->"e3c3a874-088d-b148-ba13-24d89d8721ce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"Sequence", "[", 
    RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Ax", "[", "r", "]"}], ",", 
     RowBox[{"Ay", "[", "r", "]"}], ",", 
     RowBox[{"Az", "[", "r", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"U", "=", 
   RowBox[{"u", "[", "r", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"func", "=", 
   RowBox[{"f", "[", "r", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[99]:=",
 CellID->130020730,ExpressionUUID->"adfb51a5-19bf-0d40-85b9-853c01244b94"],

Cell["Perform the Gauge transformations:", "Text",
 CellID->89603765,ExpressionUUID->"77ebf0e1-fb17-a543-874f-8b89c54cf58e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Aprime", "=", 
   RowBox[{"A", "+", 
    RowBox[{"Grad", "[", 
     RowBox[{"func", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Uprime", "=", 
   RowBox[{"U", "-", 
    RowBox[{"D", "[", 
     RowBox[{"func", ",", "t"}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[117]:=",
 CellID->725305669,ExpressionUUID->"1c156bd9-8c64-5f41-aa87-5ab48d2f497b"],

Cell["Define functions for calculating the fields:", "Text",
 CellID->578709904,ExpressionUUID->"74975bbe-5ca4-9341-82b4-058839681628"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Bfield", "=", 
   RowBox[{
    RowBox[{"Curl", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "&"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Efield", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Grad", "[", 
       RowBox[{"#1", ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], "-", 
     RowBox[{"D", "[", 
      RowBox[{"#2", ",", "t"}], "]"}]}], "&"}]}], ";"}]}], "Input",
 CellLabel->"In[119]:=",
 CellID->8043414,ExpressionUUID->"f13b3fe5-9081-1b4e-8417-7aa3139db578"],

Cell["\<\
Show the fields are invariant under the transformation of the potentials:\
\>", "Text",
 CellID->16715436,ExpressionUUID->"9908b0a9-d96c-e64d-98dd-3dc5925a41d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Bfield", "[", "A", "]"}], "-", 
    RowBox[{"Bfield", "[", "Aprime", "]"}]}], ",", 
   RowBox[{
    RowBox[{"Efield", "[", 
     RowBox[{"U", ",", "A"}], "]"}], "-", 
    RowBox[{"Efield", "[", 
     RowBox[{"Uprime", ",", "Aprime"}], "]"}]}]}], "}"}]], "Input",
 CellLabel->"In[122]:=",
 CellID->93197490,ExpressionUUID->"f0354047-e728-3840-b0cb-6dff869a10d0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[122]=",
 CellID->892471050,ExpressionUUID->"42fd718a-72ee-7d4a-a93f-496eb9ef219f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Coulomb gauge and A \[CenterDot] p Hamiltonian", \
"Subsubsection"]], "Subsubsection",
 CellChangeTimes->{{3.931863189953268*^9, 3.931863198520122*^9}, {
  3.931876424223976*^9, 3.931876435938511*^9}},
 CellID->116734659,ExpressionUUID->"d15ab293-d038-0043-a7c6-bd7a976ea139"],

Cell[TextData[{
 "It is known that there are infinite solutions (",
 StyleBox["A",
  FontWeight->"Bold"],
 "(",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "07d55fff-162a-d344-bc7b-454486d3ac7c"],
 ",",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b4e332e2-5038-2743-9bd5-898008ae4885"],
 "), ",
 StyleBox["U",
  FontWeight->"Bold"],
 "(",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"r", ",", "t"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "01b2408d-9f95-7644-ae40-cdb4eaf85203"],
 ") that reproduce an electromagnetic field related by Gauge transformations. "
}], "Text",
 CellID->55904842,ExpressionUUID->"a128ac6b-4559-874d-856a-10e69d663434"],

Cell["\<\
Additional conditions on the potentials determines a choice of Gauge that \
removes the arbitrariness . One choice that is commonly used in quantum \
optics, is the Coulomb Gauge determined by the condition:\
\>", "Text",
 CellChangeTimes->{{3.9318632619362335`*^9, 3.931863399250869*^9}, {
   3.93186364251252*^9, 3.931863696590654*^9}, {3.931864123857677*^9, 
   3.931864205929329*^9}, {3.931864237888082*^9, 3.9318642506998158`*^9}, {
   3.931864611437538*^9, 3.931864616640579*^9}, {3.931864764586813*^9, 
   3.931864771855875*^9}, {3.931865611626533*^9, 3.931865698592113*^9}, {
   3.93186577780892*^9, 3.931865800370127*^9}, {3.931865890667004*^9, 
   3.9318662853659534`*^9}, {3.931866343617195*^9, 3.93186655293746*^9}, {
   3.931866637819906*^9, 3.9318666401127663`*^9}, {3.931867197731943*^9, 
   3.931867332866646*^9}, {3.931868588015274*^9, 3.931868731628324*^9}, {
   3.93186877058469*^9, 3.931868800220356*^9}, {3.931869090882971*^9, 
   3.931869206447752*^9}, {3.931874999136261*^9, 3.9318750224309*^9}, 
   3.931875334856697*^9, {3.931876217370228*^9, 3.931876233044479*^9}, {
   3.931876317769405*^9, 3.931876372135084*^9}, {3.931876481098697*^9, 
   3.931876704701605*^9}, {3.931876742582676*^9, 3.9318767441043663`*^9}, {
   3.9318828569319706`*^9, 3.931883002757054*^9}, {3.931883035619457*^9, 
   3.931883037489776*^9}, {3.9318831465589733`*^9, 3.931883203742243*^9}, {
   3.934286767659872*^9, 3.93428678725692*^9}, 3.9342948093857536`*^9, 
   3.934294930685274*^9, 3.9666158354736576`*^9, {3.9666165076191597`*^9, 
   3.9666165308438663`*^9}, {3.9696200619576473`*^9, 3.9696200667120056`*^9}},
 CellID->28210891,ExpressionUUID->"25b6c325-e8f0-444b-ad6b-6d134f32551f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Del]", "\[CenterDot]", 
    RowBox[{
     StyleBox["A",
      FontWeight->"Bold"], 
     StyleBox["(",
      FontWeight->"Plain"], 
     RowBox[{
      StyleBox["r",
       FontWeight->"Plain"], 
      StyleBox[",",
       FontWeight->"Bold"], 
      StyleBox["t",
       FontWeight->"Plain"]}], 
     StyleBox[")",
      FontWeight->"Plain"]}]}], 
   StyleBox["=",
    FontWeight->"Plain"], 
   StyleBox[" ",
    FontWeight->"Bold"], 
   StyleBox["0",
    FontSize->18,
    FontWeight->"Plain"]}], TraditionalForm]], "DisplayFormula",
 FontSize->18,
 CellID->314078673,ExpressionUUID->"7858220d-fc0d-7f4e-a23b-277c86e386b7"],

Cell[TextData[{
 "This choice for the vector potential is called  the transverse vector \
potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     SubscriptBox["A", "\[Perpendicular]"],
     FontWeight->"Bold"], "(", 
    RowBox[{"r", ",", "t"}], " ", ")"}], TraditionalForm]],ExpressionUUID->
  "27b4029d-441d-c249-a446-423309c524b9"],
 ", for example in the case of plane electromagnetic wave\nthe Coulomb Gauge \
potentials ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["A",
      FontWeight->"Bold"], "\[Perpendicular]"], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["E", "0"], "\[Omega]"], 
     RowBox[{"sin", "(", 
      RowBox[{
       RowBox[{"\[Omega]", " ", "t"}], " ", "-", " ", 
       RowBox[{
        StyleBox["k",
         FontWeight->"Bold"], "\[CenterDot]", 
        StyleBox["r",
         FontWeight->"Bold"]}]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "51252a55-e1c1-ef49-a4fc-c174a46fe56c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"U", "(", 
     RowBox[{
      StyleBox["r",
       FontWeight->"Bold"], ",", "t"}], ")"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7de14773-638c-2f4a-8570-63ad7694c0d7"],
 "  reproduce the ",
 StyleBox["E",
  FontWeight->"Bold"],
 " and ",
 StyleBox["B",
  FontWeight->"Bold"],
 " fields for this case. And the electric field is related to the vector \
potentials as:"
}], "Text",
 CellID->320106624,ExpressionUUID->"4914e154-86fe-b54f-816e-8d4d5bf0be34"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox[Cell["E",ExpressionUUID->"049cb26a-a027-c04d-83e0-3ac3f2371f3d"],
     FontWeight->"Bold"], 
    RowBox[{
     StyleBox["(",
      FontWeight->"Plain"], 
     RowBox[{
      StyleBox["r",
       FontWeight->"Bold"], 
      StyleBox[",",
       FontWeight->"Plain"], 
      StyleBox["t",
       FontWeight->"Plain"]}], 
     StyleBox[")",
      FontWeight->"Plain"]}]}], 
   StyleBox["=",
    FontWeight->"Plain"], 
   StyleBox[" ",
    FontWeight->"Plain"], 
   RowBox[{
    RowBox[{
     StyleBox["-",
      FontWeight->"Plain"], 
     RowBox[{
      StyleBox[
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", "t"}]],
       FontWeight->"Plain"], 
      SubscriptBox[
       StyleBox[Cell[
        "A",ExpressionUUID->"5711c24a-a351-4a4c-9237-c438f2e43bb9"],
        FontWeight->"Bold"], "\[Perpendicular]"]}]}], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["r",
       FontWeight->"Bold"], ",", "t"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 FontSize->18,
 CellID->157561432,ExpressionUUID->"a0d8326d-5db5-b149-8ef3-c980e0e2f703"],

Cell[TextData[{
 "Consider the situation of an electron evolving in an external applied field \
and the Coulomb potential of the nucleus. If we take the external field to be \
a plane wave, the nuclear electrostatic field has zero vector potential and \
the scalar potential is   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["V", "coul"], "(", 
     StyleBox["r",
      FontWeight->"Bold"], ")"}], "=", 
    RowBox[{"q", " ", 
     RowBox[{
      SubscriptBox["U", "coul"], "(", 
      StyleBox["r",
       FontWeight->"Bold"], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "64fd5ec3-ced1-bb41-bd6f-6aba5cf6b327"],
 ". Then the semiclassical interaction Hamiltonian is:"
}], "Text",
 CellID->161714323,ExpressionUUID->"7a42f7e1-d41a-984b-ae04-ba84d3dd40dd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["H", "^"], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", Cell[TextData[Cell[BoxData[
        FormBox["m", TraditionalForm]],
        FormatType->TraditionalForm,ExpressionUUID->
        "11a0a352-13d9-8c44-87a4-ccc6c2ab717e"]],ExpressionUUID->
        "d3541545-2b77-d54e-b307-9a13d388f925"]}]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         StyleBox[
          OverscriptBox["p", "^"],
          FontWeight->"Bold"], "2"], "-", 
        RowBox[{"q", " ", 
         SubscriptBox[
          
          StyleBox[Cell[
           "A",ExpressionUUID->"73c5e1e5-0776-8a45-ae9f-f3967c64f7a9"],
           FontWeight->"Bold"], "\[Perpendicular]"], 
         RowBox[{"(", 
          RowBox[{
           StyleBox[
            OverscriptBox["r", "^"],
            FontWeight->"Bold"], ",", "t"}], ")"}]}]}], ")"}], "2"]}], "+", 
    RowBox[{
     SubscriptBox[
      OverscriptBox["V", "^"], "Coul"], "(", 
     StyleBox[
      OverscriptBox["r", "^"],
      FontWeight->"Bold"], ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellID->3074648,ExpressionUUID->"d6627239-458e-8d47-867f-c757f2d3770b"],

Cell[TextData[{
 "After simplifying using the Gauge condition we can distinguish two parts, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["H", "0"], " ", "is", " ", "just", " "}], TraditionalForm]],
  ExpressionUUID->"a99dada6-b3d7-5941-867e-d7f4ca64430b"],
 "related to a charged particle moving in a Coulomb nuclear field and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["H", "I"], " "}], TraditionalForm]],ExpressionUUID->
  "7e72258f-f03f-ef44-9427-807c1fa6ced4"],
 "is the interaction term of the external field and the hydrogen-like atom"
}], "Text",
 CellChangeTimes->{{3.9318632619362335`*^9, 3.931863399250869*^9}, {
   3.93186364251252*^9, 3.931863696590654*^9}, {3.931864123857677*^9, 
   3.931864205929329*^9}, {3.931864237888082*^9, 3.9318642506998158`*^9}, {
   3.931864611437538*^9, 3.931864616640579*^9}, {3.931864764586813*^9, 
   3.931864771855875*^9}, {3.931865611626533*^9, 3.931865698592113*^9}, {
   3.93186577780892*^9, 3.931865800370127*^9}, {3.931865890667004*^9, 
   3.9318662853659534`*^9}, {3.931866343617195*^9, 3.93186655293746*^9}, {
   3.931866637819906*^9, 3.9318666401127663`*^9}, {3.931867197731943*^9, 
