Cell[TextData[{
 "Using  the relation between the electric field and vector potential and \
introducing the operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     OverscriptBox["D", "^"],
     FontWeight->"Bold"], "=", " ", 
    RowBox[{"q", "(", 
     RowBox[{
      OverscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "^"], "-", 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "0"]}], ")"}], " "}], TraditionalForm]],
  ExpressionUUID->"4bd147ed-59b6-1347-823d-45a1ef341632"],
 "the Hamiltonian can be rewritten as"
}], "Text",
 CellChangeTimes->{{3.931878725429253*^9, 3.9318787629653835`*^9}, {
   3.93187887418725*^9, 3.931878946719106*^9}, {3.931879584561558*^9, 
