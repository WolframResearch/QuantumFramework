Cell[TextData[{
 "In atom-light interactions the wavelength \[Lambda]  of the light is \
typically  very large compared to the atomic size. The amplitude of the \
external field is approximated constant along the atom ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     SubscriptBox["A", "\[Perpendicular]"],
     FontWeight->"Bold"], "(", 
    RowBox[{
     SubscriptBox["r", "0"], ",", " ", "t"}], ")"}], TraditionalForm]],
  ExpressionUUID->"03a620fb-1b5e-da40-acb6-24153c725cb2"],
 " it is well known as a long wavelength approximation. In this approximation \
the vector potential is just a constant"
}], "Text",
 CellChangeTimes->{{3.9318632619362335`*^9, 3.931863399250869*^9}, {
   3.93186364251252*^9, 3.931863696590654*^9}, {3.931864123857677*^9, 
