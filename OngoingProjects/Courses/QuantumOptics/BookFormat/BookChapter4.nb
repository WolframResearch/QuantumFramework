Cell[CellGroupData[{

Cell[TextData[StyleBox["Solving JC: coherent state as initial field state", \
"Subsubsection"]], "Subsubsection",
 CellChangeTimes->{{3.953758160676203*^9, 3.953758161739441*^9}, {
  3.9537582135819798`*^9, 3.953758221739603*^9}},
 CellID->92967212,ExpressionUUID->"c975c1fb-0ace-e441-9281-a575a84bb03a"],

Cell[TextData[{
 "Initial state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", 
     RowBox[{"\[Psi]", "(", "0", ")"}], "\[RightAngleBracket]"}], "=", 
    RowBox[{
     RowBox[{"|", "g", "\[RightAngleBracket]"}], 
     RowBox[{"|", "\[Alpha]", "\[RightAngleBracket]"}]}]}], TraditionalForm]],
   "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{{3.985890935285734*^9, 3.985890955377037*^9}},
  ExpressionUUID->"e6af14fb-b28f-c648-a88a-1b9389d6e06e"],
 ", with |\[Alpha]|=",
 Cell[BoxData[
  FormBox["5", TraditionalForm]], "CodeText",
  FormatType->TraditionalForm,ExpressionUUID->
  "dab88f26-9312-ef41-93d2-69e84cf43580"],
 ":"
}], "Text",
 CellID->37037644,ExpressionUUID->"b7377719-5733-7946-9788-2e7e2b648c5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]0", "=", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<1\>\"", ",", "atomBasis"}], "]"}], ",", 
     RowBox[{
      RowBox[{"CoherentState", "[", "]"}], "[", "5.", "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[230]:=",
 CellID->194870558,ExpressionUUID->"7b1c860d-75e1-8e42-9325-acc2157979fd"],

Cell[TextData[{
 "The evolved state can be expressed in terms of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "e"], "(", "t", ")"}], TraditionalForm]], "Text",
  ExpressionUUID->"7e15739f-9d9c-cc47-852a-ee1366fa6b23"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["c", "g"], "(", "t", ")"}], "Text"], TraditionalForm]], 
  "CodeText",ExpressionUUID->"dd13a0b4-fbe7-5949-bff5-bd20bee4dd8f"],
 " coefficients for each ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "1f6c0a37-fc2f-c840-a026-28689b427c59"],
 " of the truncated Fock space"
}], "Text",
 CellID->218990563,ExpressionUUID->"22b94309-c81c-7548-88de-5dce0b4fedc7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Psi]", "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", "n", ""], 
     RowBox[{
      RowBox[{
       SubscriptBox["c", "e"], "(", "t", ")"}], Cell[TextData[{
       "|",
       Cell[BoxData[
        FormBox[
         RowBox[{"e", "\[RightAngleBracket]"}], TraditionalForm]],
        ExpressionUUID->"b9842503-504d-be40-9382-82f22fb001a3"]
      }],ExpressionUUID->"0e9d70c0-049c-7a4a-b527-427271e7733b"], Cell[
      TextData[{
       "|",
       Cell[BoxData[
        FormBox[
         RowBox[{"n", "\[RightAngleBracket]"}], TraditionalForm]],
        ExpressionUUID->"52827717-8d8d-c846-b0e7-ce06f280ea9a"]
      }],ExpressionUUID->"2309f745-afa5-2f48-b9d2-3b1e1028d672"]}]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["c", "g"], "(", "t", ")"}], Cell[TextData[{
      "|",
      Cell[BoxData[
       FormBox["g", TraditionalForm]],ExpressionUUID->
       "064b602d-9f9c-8945-a9c9-81aa724fd5b7"],
      "\[RightAngleBracket]"
     }],ExpressionUUID->"28bdffb1-ae61-e345-bdc1-dc0b36f03201"], Cell[
     TextData[{
      "|",
      Cell[BoxData[
       FormBox["n", TraditionalForm]],ExpressionUUID->
       "6ab51669-78a0-4b4c-88dc-c11669939d89"],
      "\[RightAngleBracket]"
     }],ExpressionUUID->"0381ea9d-5b42-954b-8f95-4d09c3fde8df"]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->104952098,ExpressionUUID->"15c87176-9ab5-ed41-b922-7f450c2ba13c"],

Cell[TextData[StyleBox["Evolved state:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9666284146595745`*^9, 3.966628417249483*^9}},
 CellID->329184138,ExpressionUUID->"46994659-67af-3842-b8b4-5f671b92d89d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]t", "=", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"U", "@", "\[Psi]0"}], ",", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"g", ",", "t"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.953758767359024*^9, 3.953758770694334*^9}, 
   3.966628428608347*^9},
 CellLabel->"In[231]:=",
 CellID->240248008,ExpressionUUID->"e9f9350b-8d58-ee4a-a861-929c74cd7edb"],

Cell[TextData[{
 StyleBox["Finding the time dependent  coefficients by projecting, for \
simplicity we take ", "Text"],
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "=", "1"}], TraditionalForm]], "Text",
  FormatType->TraditionalForm,ExpressionUUID->
  "d4902434-e10c-cf42-b262-e65e8bdb1e12"],
 StyleBox[":", "Text"]
}], "CodeText",
 CellID->772782621,ExpressionUUID->"a1e23221-b899-1b40-a641-7f647056ea5c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cet", "[", "t_", "]"}], ",", 
     RowBox[{"cgt", "[", "t_", "]"}]}], "}"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["#", "\[Dagger]"], "@", 
        RowBox[{"\[Psi]t", "[", 
         RowBox[{"1", ",", "t"}], "]"}]}], ")"}], 
      "[", "\"\<AmplitudesList\>\"", "]"}], "&"}], " ", "/@", " ", 
    RowBox[{"atomBasis", "[", "\"\<BasisStates\>\"", "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[232]:=",
 CellID->114608505,ExpressionUUID->"e16f7e5a-4e41-2b4e-8b81-b156de5d4e67"],

Cell[TextData[{
 "For any ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f5aa691f-3244-3c4f-9ed6-b7333713669c"],
 ", a list is returned of the size of the truncation size(for all ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "195b14cc-2acb-af43-b84f-849d91c9fa7f"],
 "):"
}], "Text",
 CellID->368397017,ExpressionUUID->"d4cc4130-b731-f147-bfaf-de818d191fdb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Length", "@", 
   RowBox[{"cet", "[", "0", "]"}]}], " ", "==", " ", "$FockSize"}]], "Input",
 CellChangeTimes->{{3.953758982364292*^9, 3.953759026922266*^9}, {
  3.966628678806654*^9, 3.966628682482998*^9}},
 CellLabel->"In[233]:=",
 CellID->30567796,ExpressionUUID->"a3c51a22-0982-7d4b-8b6e-c053db98ab5e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[233]=",
 CellID->79013819,ExpressionUUID->"07e1a4ba-26e7-db42-b750-7415313932df"]
}, Open  ]],

Cell[TextData[{
 "Plotting the population inversion that can be calculated using ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["c", "e"], "(", "t", " ", ")"}], " ", "and", " ", 
    RowBox[{
     SubscriptBox["c", "g"], "(", "t", ")"}]}], TraditionalForm]],
  ExpressionUUID->"a67ee067-4802-644f-a5c5-3096f2838ce6"],
 ". We see collapse and revivals a phenomena ",
 StyleBox["only present in the fully quantum model",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9537590827053623`*^9, 3.953759142916113*^9}, {
  3.9537591945113773`*^9, 3.9537592036114044`*^9}},
 CellID->369836824,ExpressionUUID->"2e03da57-cb9c-fd44-b072-7916c9f45e18"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Total", " ", "@", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Abs", "[", 
         RowBox[{"cet", "[", "t", "]"}], "]"}], "2"], "-", 
       SuperscriptBox[
        RowBox[{"Abs", "[", 
         RowBox[{"cgt", "[", "t", "]"}], "]"}], "2"]}], " ", ")"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "100"}], "}"}], ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["10", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["1112", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    PlotRange -> {-1, 1}, Frame -> True, FrameLabel -> {"gt", "W(t)"}, 
     PlotTheme -> "Detailed", PlotLegends -> None, ImageSize -> 500, 
     LabelStyle -> 14, PlotLabel -> 
     "Population inversion W(t) for the atom, |\[Alpha]|= 5", PlotPoints -> 
     150, PlotStyle -> Thickness[0.002]],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellLabel->"In[241]:=",
 CellID->358678828,ExpressionUUID->"56730325-1b53-6343-a29b-80a9a571d2c7"],

