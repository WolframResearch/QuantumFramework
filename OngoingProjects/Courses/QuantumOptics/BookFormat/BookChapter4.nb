Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 
 CounterBox["Section"],
 StyleBox[" | ", "SectionBar"],
 "Atom-field interactions"
}], "Section",
 CellChangeTimes->{
  3.652728456208679*^9, 3.652728527108994*^9, {3.9666141937854652`*^9, 
   3.9666141999881496`*^9}},
 CounterAssignments->{{"Section", 3}},
 CellID->874060909,ExpressionUUID->"9192c08a-2238-5442-bfe6-840aa1bba10f"],

Cell[TextData[StyleBox["The starting point to understand atom-field \
interactions is to study the coupling of a single mode field and two level \
atom. In the semiclassical model the atom is quantized and the field is \
treated as a classical field. Using dipole approximation when field \
wavelength is larger than atomic size, the mathematics are analogous to a \
spin 1/2 particle. In the same manner as a spin 1/2 particle have Rabi \
oscillations when interacting with a time dependent magnetic field, the two \
level atom shows optical Rabi oscillations. This can be shown just using a \
semiclassical model, but when both atom and field are quantized other \
phenomena arise such as \[OpenCurlyDoubleQuote]collapse and revivals\
\[CloseCurlyDoubleQuote]. We explore evolutions of different initial states \
and discuss mathematical formalisms to analyze the atom-field system.", \
"Abstract"]], "Text",
 CellChangeTimes->{
  3.966618302764879*^9, {3.9666183338637695`*^9, 3.966618335060898*^9}, {
   3.966618382520809*^9, 3.9666183836033287`*^9}},
 CellID->372268528,ExpressionUUID->"9d19fef2-55ea-ff45-bd43-d885181f23ff"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Key Concepts", "Subsubsection"]], "Subsection",
 CellChangeTimes->{{3.966614446378605*^9, 3.9666144546046314`*^9}},
 CellID->655216799,ExpressionUUID->"9565d143-617c-5748-8fb7-44b6f39e70d2"],

Cell[CellGroupData[{

Cell["Semiclassical models", "Item",
 CellChangeTimes->{{3.9579699027714176`*^9, 3.957969924612791*^9}, {
  3.9579699728702583`*^9, 3.95796997287228*^9}},
 CellID->349563083,ExpressionUUID->"6b376cef-4e3b-9e4e-b9bb-478e6f03b120"],

Cell["Rabi oscillations", "Item",
 CellChangeTimes->{{3.9579699027714176`*^9, 3.957969924612791*^9}, 
   3.957969973661089*^9},
 CellID->764806843,ExpressionUUID->"e0c49091-bfde-7645-ab67-4095dc9c7671"],

Cell["Jaynes-Cummings model", "Item",
 CellChangeTimes->{{3.9579699027714176`*^9, 3.9579699603323956`*^9}},
 CellID->290931448,ExpressionUUID->"1d920c9c-6aa1-1942-8c9b-2c781fe7c36e"],

Cell["Dressed state basis", "Item",
 CellChangeTimes->{{3.9579699027714176`*^9, 3.9579699525686817`*^9}},
 CellID->205299704,ExpressionUUID->"4b11a377-1209-b645-9cb3-efe4001c4588"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Atom-field interaction processes", "Subsection"]], \
"Subsection",
 CellChangeTimes->{{3.9307559324537306`*^9, 3.930755952350666*^9}, {
  3.930757456495682*^9, 3.930757464689766*^9}, {3.9308257935473843`*^9, 
  3.9308258115870647`*^9}, {3.930825853255089*^9, 3.9308258587524014`*^9}},
 CellID->102325116,ExpressionUUID->"1b2e798c-27eb-6347-8b59-d8ec7a8aa9b1"],

Cell[TextData[{
 "We consider an atom with levels |",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "\[RightAngleBracket]"}], TraditionalForm]],ExpressionUUID->
  "1f7095d5-f0b8-824d-a6a3-388e066de427"],
 ",|",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "\[RightAngleBracket]"}], TraditionalForm]],ExpressionUUID->
  "5ae3ea02-3d95-e449-bd96-cda435ad5615"],
 ",|",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "\[RightAngleBracket]"}], TraditionalForm]],ExpressionUUID->
  "f7faebb0-55ff-9f42-89e8-9a81ec718b33"],
 "\[Ellipsis] with energies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["E", "A"], ",", 
    SubscriptBox["E", "B"], ",", 
    RowBox[{
     SubscriptBox["E", "C"], "\[Ellipsis]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f1e7e04-c3e7-5943-8a0a-dc8ea4595d6b"],
 " and the level |",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "\[RightAngleBracket]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b26e4eb8-b970-764d-9a74-f5c7081ff3b9"],
 "  is the lowest energy level that interacts with a electric field ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"E", "(", 
     RowBox[{"r", ",", "t"}], ")"}], "=", 
    RowBox[{
     SubscriptBox["E", "0"], 
     RowBox[{"cos", "(", 
      RowBox[{
       RowBox[{"\[Omega]", " ", "t"}], " ", "+", " ", 
       RowBox[{"\[Phi]", "(", "r", ")"}]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f2e36ae-385a-ba4d-94dc-1c9c6f4aed09"]
}], "Text",
 CellID->30774180,ExpressionUUID->"6cc4e414-f102-164d-b74e-5c2c65c3c8d8"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Absorption", "Subsubsection"]], "Subsection",
 CellChangeTimes->{{3.930767391333185*^9, 3.930767393994711*^9}},
 CellID->84568281,ExpressionUUID->"99761e1d-dea6-434b-952b-0a84f87824be"],

Cell[TextData[{
 "Absorption happens when  an atom in a particular state goes to a higher \
energy level and in the process the amplitude of the electric field ",
 StyleBox["reduces",
  FontSlant->"Italic"],
 ". This is relevant when the field frequency is quasi-resonant, that is  \
\[LineSeparator]\[Omega] \[TildeEqual] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "ba"], " ", "=", " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["E", "b"], "-", 
      SubscriptBox["E", "a"]}]}]}], TraditionalForm]],ExpressionUUID->
  "84c62e99-6561-8f41-9bca-bc30494a79e1"],
 ")/\[HBar], for \[Omega] close to that frequency the model can be simplified \
to just a two level atom."
}], "Text",
 CellChangeTimes->{{3.9307674712915688`*^9, 3.930767518537977*^9}, {
  3.930767574634428*^9, 3.930767678081524*^9}, {3.9307698418244514`*^9, 
  3.9307698800510483`*^9}, {3.930770088247275*^9, 3.930770191957844*^9}, {
  3.9307713247257977`*^9, 3.9307714623812084`*^9}, {3.9342872696531105`*^9, 
  3.9342872724569416`*^9}, {3.9666145854263268`*^9, 3.9666146010389614`*^9}, {
  3.966614670821598*^9, 3.9666146830828114`*^9}, {3.9696195046571255`*^9, 
  3.9696195089031334`*^9}},
 CellID->38024323,ExpressionUUID->"f2f38ad7-651d-e74d-a791-a91a96b86ae2"],

