 CellID->963517570,ExpressionUUID->"ff7bcffa-c271-e940-af3e-f57e2d71e6b8"],

Cell[BoxData[{
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["H", "^"], "0"], "=", 
   RowBox[{
    FractionBox[
     SuperscriptBox[
      OverscriptBox["p", "^"], "2"], 
     RowBox[{"2", " ", "m"}]], "+", 
    RowBox[{
     SubscriptBox["V", "Coul"], "(", 
     OverscriptBox["r", "^"], ")"}]}]}], TraditionalForm], "\n", 
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     SubscriptBox["H", "I"], "^"], "'"}], "=", 
   RowBox[{
    RowBox[{"-", 
     OverscriptBox[
      StyleBox["D",
       FontWeight->"Bold"], "^"]}], "\[CenterDot]", 
    RowBox[{
     StyleBox["E",
      FontWeight->"Bold"], "(", 
     RowBox[{
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "0"], ",", "t"}], ")"}]}]}], 
  TraditionalForm]}], "DisplayFormula",
 CellID->18040877,ExpressionUUID->"c9ae5dde-3754-dc40-941c-84e6452c4686"],

Cell[TextData[{
 "This form is referred as the electric dipole Hamiltonian , because it has \
the form of interaction energy of a classical electric dipole located at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]],ExpressionUUID->
  "6c9322bc-22a6-e84e-bebc-e8048223e12f"],
 " with an electric field ",
 Cell[BoxData[
  FormBox[
   StyleBox["E",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "30311d26-d61c-3e4b-9667-e298532b0498"],
 "\[LineSeparator]"
}], "Text",
 CellChangeTimes->{{3.931878725429253*^9, 3.9318787629653835`*^9}, {
   3.93187887418725*^9, 3.931878946719106*^9}, {3.931879584561558*^9, 
   3.931879603162646*^9}, {3.931879695388855*^9, 3.931879699242565*^9}, {
   3.9318800893924522`*^9, 3.9318800938749037`*^9}, 3.931880384243868*^9, {
   3.931882303280103*^9, 3.931882325410082*^9}, {3.931882495056583*^9, 
   3.931882542131975*^9}, 3.931882695043253*^9, {3.931883065411398*^9, 
   3.931883123286962*^9}, {3.931883251962118*^9, 3.9318833725494633`*^9}, {
   3.931883415048708*^9, 3.931883416499126*^9}, {3.931885911774873*^9, 
   3.931885989580639*^9}, {3.931886024815738*^9, 3.93188626442468*^9}, {
   3.931886354908169*^9, 3.931886356470941*^9}, {3.931886463213108*^9, 
   3.9318865669612904`*^9}, {3.93376988265004*^9, 3.9337698841770535`*^9}, {
   3.933769968670065*^9, 3.933769969659937*^9}, {3.934287519293487*^9, 
   3.9342875196657734`*^9}, {3.934287551409056*^9, 3.934287572308253*^9}, {
   3.966616612497444*^9, 3.966616644894663*^9}, 3.96661680986528*^9, {
   3.966617220380228*^9, 3.966617325029537*^9}, {3.9666173642345943`*^9, 
   3.9666173934601326`*^9}, {3.9666174703250484`*^9, 
   3.9666175037908497`*^9}, {3.966617842791462*^9, 3.9666179071898117`*^9}, {
   3.966618138995899*^9, 3.966618170139244*^9}},
 CellID->279496750,ExpressionUUID->"f1da1d07-daef-9e43-bb75-ea80b25d998c"],

Cell[TextData[{
 StyleBox["Even if we have two different Hamiltonians , if we use exact \
equations and do not employ any additional approximation the predictions are \
the same regardless of the Hamiltonian choice . The long-wavelength \
approximation also predicts the same transition probabilities independent if ",
  Background->None],
 StyleBox["A ",
  FontWeight->"Bold",
  Background->None],
 StyleBox["\[CenterDot] ",
  Background->None],
 StyleBox["p",
  FontWeight->"Bold",
  Background->None],
 StyleBox[" or ",
  Background->None],
 StyleBox["D",
  FontWeight->"Bold",
  Background->None],
 StyleBox[" \[CenterDot]",
  Background->None],
 StyleBox["E",
  FontWeight->"Bold",
  Background->None],
 StyleBox[" is used . However, if extra approximations are used the results \
can differ depending on the specific problem, one Hamiltonian can provide \
more  accurate results to certain problems",
  Background->None]
}], "Answer",
 CellFrame->True,
 CellChangeTimes->{3.9666155425110226`*^9},
 CellID->117934347,ExpressionUUID->"796e6b51-2f44-2244-8851-45552cc149d2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Atomic transitions: Rabi oscillations", \
"Subsection"]], "Subsection",
 CellChangeTimes->{{3.930828019657104*^9, 3.930828033577095*^9}},
 CellID->159201875,ExpressionUUID->"0106c446-98a3-234d-add9-4ef09c04e268"],

Cell["\<\
We already described how to get an interaction Hamiltonian in the \
semiclassical theory, so now we can study the transitions between atomic \
levels  in the presence of a sinusoidally oscillating electromagnetic wave. \
It is possible to get solutions using first-order perturbation theory, and a \
more exact method using a two level atom in the quasi-resonant approximation\
\>", "Text",
 CellChangeTimes->{{3.9318907154360027`*^9, 3.9318908670275497`*^9}, {
  3.9318917082973995`*^9, 3.9318917380964394`*^9}, {3.9318921831365623`*^9, 
  3.9318922306255455`*^9}, {3.9696205126369667`*^9, 3.9696205630648537`*^9}},
 CellID->160171675,ExpressionUUID->"ceeabba5-067b-d14f-bd37-413c0daf7dd3"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Transition probabilities in first-order perturbation \
theory", "Subsubsection"]], "Subsubsection",
 CellChangeTimes->{{3.93188974861022*^9, 3.9318897540041924`*^9}, {
  3.9318906290363064`*^9, 3.9318906365998993`*^9}, {3.9318918690433254`*^9, 
  3.9318918852440434`*^9}, {3.931891928895941*^9, 3.9318919375005817`*^9}, {
  3.9318922909258366`*^9, 3.931892306624075*^9}},
 CellID->91134855,ExpressionUUID->"85cfb769-7b23-a64c-88be-eae2a3ce43d1"],

Cell[TextData[{
 "Given a system describing an atom with Hamiltonian ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "0"], TraditionalForm]],ExpressionUUID->
  "8c9d1589-5060-fd48-a05d-b8a6f1c25726"],
 " and eigenstates ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"|", "j"}], "\[RightAngleBracket]"}], " "}], TraditionalForm]],
  ExpressionUUID->"316b21bb-02be-5947-b804-cb95b9832f06"],
 " associated with energy levels ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "j"], TraditionalForm]],ExpressionUUID->
  "f274b45a-687e-2e44-a251-54acf697178e"],
 " . If the atom is initially in the eigenstate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"|", "i"}], "\[RightAngleBracket]"}], " "}], TraditionalForm]],
  ExpressionUUID->"2b3feaa8-f6dc-3745-84a5-8d7a5b7afb32"],
 "of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "0"], TraditionalForm]],ExpressionUUID->
  "9007824c-5900-a543-a24f-e279a4016795"],
 ", and the external electromagnetic field has frequency \[Omega] , a natural \
question is to find the probabilities that the atom is in a different \
eigenstate |",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "747e377b-734d-1845-9de2-59bf7b0e9600"],
 "\[RightAngleBracket] at a later time ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "b395d955-83d0-f147-897b-0212fd9bfbdd"],
 ". We assume that the validity of the usage of the interaction Hamiltonians \
can be extended to other atoms and not just hydrogen, so we assume we can use \
the long-wavelength approximation electric dipole Hamiltonian"
}], "Text",
 CellID->51508656,ExpressionUUID->"4f69e610-3963-1443-b566-970de5e7d3d4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["H", "^"], "I"], "=", 
   RowBox[{
    RowBox[{"-", 
     OverscriptBox[
      StyleBox["D",
       FontWeight->"Bold"], "^"]}], "\[CenterDot]", 
    RowBox[{
     StyleBox["E",
      FontWeight->"Bold"], "(", 
     RowBox[{
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "0"], ",", "t"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->227670708,ExpressionUUID->"6cff18b4-66de-0c4e-8872-707e89c7e52f"],

Cell[TextData[{
 "Where ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["D", "^"], TraditionalForm]],ExpressionUUID->
  "c5446a34-1ebe-744d-9b9b-61feffee45c6"],
 " has non zero matrix element between different eigenstates of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "0"], TraditionalForm]],ExpressionUUID->
  "cfc7a5d8-6f96-c547-a3c2-f7d1cc73c200"],
 ". Using the classical expression for an electric field we can write "
}], "Text",
 CellChangeTimes->{{3.931892333504122*^9, 3.931892599840637*^9}, {
   3.931892757142666*^9, 3.93189293793536*^9}, {3.931892969986589*^9, 
   3.9318930064862423`*^9}, {3.9318930387460423`*^9, 3.931893175177257*^9}, {
   3.9318934424006653`*^9, 3.931893446575676*^9}, 3.9318938980418663`*^9, 
   3.931893935140835*^9, {3.932119622762379*^9, 3.9321197097787*^9}, {
   3.9321207500206985`*^9, 3.932120825146805*^9}, 3.9321214033675766`*^9, {
   3.932121546815827*^9, 3.932121728510941*^9}, 3.934281651594094*^9, {
   3.934281694363434*^9, 3.934281700831417*^9}, {3.93428700902466*^9, 
   3.934287009614847*^9}, {3.934287136329717*^9, 3.934287152173601*^9}, {
   3.9342871852342587`*^9, 3.9342871870028553`*^9}, {3.934295288860321*^9, 
   3.9342952893439064`*^9}, {3.9342955301202083`*^9, 3.934295534578426*^9}, {
   3.966618529930231*^9, 3.9666185931198006`*^9}, {3.9666186320561447`*^9, 
   3.9666186829576244`*^9}},
 CellID->868437602,ExpressionUUID->"1a3269a8-2636-5544-86f9-6a1ae8173467"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["H", "^"], "I"], "=", 
   RowBox[{
    RowBox[{
     OverscriptBox["W", "^"], 
     RowBox[{"cos", "(", 
      RowBox[{
       RowBox[{"\[Omega]", " ", "t"}], " ", "+", " ", "\[Phi]"}], ")"}], "          ",
      "where", "   ", 
     OverscriptBox["W", "^"]}], "=", 
    RowBox[{
     RowBox[{"-", 
      OverscriptBox[
       StyleBox["D",
        FontWeight->"Bold"], "^"]}], "\[CenterDot]", 
     RowBox[{
      StyleBox["E",
       FontWeight->"Bold"], "(", 
      SubscriptBox["r", "0"], ")"}]}]}]}], TraditionalForm]], "DisplayFormula",
 CellID->109394557,ExpressionUUID->"377a71b8-f03a-5640-9ca2-317ed739e4c0"],

Cell[TextData[{
 "Using first order perturbation theory for a sinusoidal perturbation with \
time duration T, the transition probability from a state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "i"}], "\[RightAngleBracket]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "92fc92c5-7150-4e47-bd4f-5c80b7a27fc4"],
 " to state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "k"}], "\[RightAngleBracket]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a6c75801-9c2b-f544-8362-e3d73e58c0ae"],
 " is "
}], "Text",
 CellChangeTimes->{{3.931892333504122*^9, 3.931892599840637*^9}, {
   3.931892757142666*^9, 3.93189293793536*^9}, {3.931892969986589*^9, 
   3.9318930064862423`*^9}, {3.9318930387460423`*^9, 3.931893175177257*^9}, {
   3.9318934424006653`*^9, 3.931893446575676*^9}, 3.9318938980418663`*^9, 
   3.931893935140835*^9, {3.932119622762379*^9, 3.9321197097787*^9}, {
   3.9321207500206985`*^9, 3.932120825146805*^9}, 3.9321214033675766`*^9, {
   3.932121546815827*^9, 3.932121728510941*^9}, 3.934281651594094*^9, {
   3.934281694363434*^9, 3.934281700831417*^9}, {3.93428700902466*^9, 
   3.934287009614847*^9}, {3.934287136329717*^9, 3.934287152173601*^9}, {
   3.9342871852342587`*^9, 3.9342871870028553`*^9}, {3.934295288860321*^9, 
   3.9342952893439064`*^9}, {3.9342955301202083`*^9, 3.934295534578426*^9}, {
   3.966618529930231*^9, 3.9666185931198006`*^9}, {3.9666186320561447`*^9, 
   3.966618677620844*^9}, {3.96661871301416*^9, 3.9666187303768787`*^9}},
 CellID->557883671,ExpressionUUID->"4fa3b49d-f11f-3c42-b418-3681988b94b2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", 
     RowBox[{"i", "\[RightArrow]", "k"}]], "(", "T", ")"}], "=", 
   RowBox[{
    FractionBox["1", "4"], 
    FractionBox[
     SuperscriptBox[
      RowBox[{"|", 
       SubscriptBox["W", 
        RowBox[{"k", "i"}]], "|"}], "2"], 
     RowBox[{" ", 
      SuperscriptBox["\[HBar]", "2"]}]], 
    RowBox[{
     SubscriptBox["g", "T"], "(", 
     RowBox[{"\[HBar]", " ", "\[Delta]"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->130444860,ExpressionUUID->"35202f46-bde4-914d-b186-e6be51fde176"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["g", "T"], 
    RowBox[{"(", 
     RowBox[{"\[HBar]", " ", "\[Delta]"}], ")"}]}], "=", 
   RowBox[{
    SuperscriptBox["T", "2"], " ", "sinc", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"\[Delta]", " ", "T"}], "2"], ")"}], "2"]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->740331701,ExpressionUUID->"2ba99f36-198e-ff44-8c6d-c7199e33126d"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["W", 
     RowBox[{"k", " ", "i", " "}]], "is", " ", "the", " ", "matrix", " ", 
    "element", " ", "and", " "}], TraditionalForm]],ExpressionUUID->
  "2d621cfc-21aa-ec45-8ed8-709dd67985a4"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "=", 
    RowBox[{"\[Omega]", "-", 
     FractionBox[
      RowBox[{"|", 
       RowBox[{
        SubscriptBox["E", "i"], "-", 
        SubscriptBox["E", "k"]}], "|"}], "\[HBar]"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1d2ab918-7d93-7a4e-8c4d-7d4c0eb2feb4"],
 " is the detuning (the absolute value serves to treat both emission and \
absorption). The function has a dominant peak of height ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "2"], TraditionalForm]],ExpressionUUID->
  "e6da57ee-b8a7-c34e-8683-4550ccb88d6a"],
 " centered at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "=", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "ac1cb39c-7416-fe49-84fb-9178ef23b77f"]
}], "Text",
 CellID->111757083,ExpressionUUID->"58f62af8-34a5-f348-9ff7-83c5a8d63056"],

Cell[TextData[{
 "The transition amplitude rate is proportional to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[ImaginaryI]", 
     FormBox[
      RowBox[{
       SubscriptBox["\[Omega]", 
        RowBox[{"k", ",", "i"}]], "t"}],
      TraditionalForm]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cdfa14ce-15f5-bd44-b23b-4a6de9aa1dc5"],
 ". We substitute ",
 Cell[BoxData[
  FormBox[
   RowBox[{"cos", "(", 
    RowBox[{"\[Omega]", " ", "t"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5a6f6bc4-9647-8843-919b-c5b1d859e58f"],
 "with its resonant exponential part: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "01fa756a-5d33-3049-aea8-4861ad8c0c79"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", "t"}]], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "283b3dba-09d8-424c-b3c7-fbaf07c9e29e"],
 " :"
}], "Text",
 CellID->540088548,ExpressionUUID->"9d7a92bc-3b1e-ef44-beeb-b578590c5dd7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"integrand", "=", 
   FractionBox[
    RowBox[{"Wki", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", "t"}], "]"}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{"\[ImaginaryI]", " ", "\[Omega]ki", " ", "t"}], "]"}]}], 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"\[ImaginaryI]", " ", "\[HBar]"}], ")"}]}]]}], ";"}]], "Input",
 CellLabel->"In[211]:=",
 CellID->31799240,ExpressionUUID->"59ba96df-5ca6-0e4e-bd18-9b21034f6053"],

Cell[TextData[{
 "Integrate from",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"t", "=", "0", " "}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "91ab6b51-e866-0941-9909-82fa7aad1e36"],
 "to the duration of the perturbation ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cb86707a-4df1-1249-b595-01d94ef54df2"],
 ":"
}], "Text",
 CellID->144211527,ExpressionUUID->"f0a7766c-2e87-124c-a30a-15ba246a4ec5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ck", "=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Simplify", "[", "integrand", "]"}], "/.", "\[VeryThinSpace]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Omega]", "-", "\[Omega]ki"}], "\[Rule]", "\[Delta]"}], 
       "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "T"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[212]:=",
 CellID->18661865,ExpressionUUID->"606d455a-98a7-304f-9040-462856d84145"],

Cell["Calculate the transition probability:", "Text",
 CellID->126853724,ExpressionUUID->"719a408d-3e73-be41-b782-41780d323c7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"probability", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"ComplexExpand", "[", 
      RowBox[{"ck", " ", 
       RowBox[{"ck", "\[Conjugate]"}]}], "]"}], ",", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"T", ">", "0"}], ",", 
        RowBox[{"\[Delta]", "\[Element]", 
         TemplateBox[{},
          "Reals"]}], ",", 
        RowBox[{"Wki", "\[Element]", 
         TemplateBox[{},
          "Reals"]}], ",", 
        RowBox[{"\[HBar]", ">", "0"}]}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[213]:=",
 CellID->316369601,ExpressionUUID->"3c5ed60b-28f6-5946-9cc8-c885a860d544"],

Cell["Verify the analytic expression:", "Text",
 CellID->158251124,ExpressionUUID->"c088af27-ebc2-6c48-89f9-2556f71aa32c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    FractionBox["1", "4"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["Wki", "\[HBar]"], ")"}], "2"], " ", 
    SuperscriptBox["T", "2"], " ", 
    SuperscriptBox[
     RowBox[{"Sinc", "[", 
      FractionBox[
       RowBox[{"\[Delta]", " ", "T"}], "2"], "]"}], "2"]}], "==", 
   "probability"}], "]"}]], "Input",
 CellLabel->"In[214]:=",
 CellID->133518873,ExpressionUUID->"92cc4224-cfdc-964d-92d7-45e47ae2e0c0"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[214]=",
 CellID->287601456,ExpressionUUID->"e1192af4-5749-7945-999f-4e2eaad52a3c"]
}, Open  ]],

Cell[TextData[StyleBox["Visualize this function:", "Text"]], "CodeText",
 CellChangeTimes->{{3.966618802924118*^9, 3.9666188116720257`*^9}},
 CellID->171978536,ExpressionUUID->"67e89bb5-5a6f-1941-af04-e989d0ef5003"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["T", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"Sinc", "[", 
        RowBox[{"\[Delta]", " ", 
         RowBox[{"T", "/", "2"}]}], "]"}], ")"}], "2"]}], " ", "/.", " ", 
    RowBox[{"T", "->", "1"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Delta]", ",", 
     RowBox[{"-", "20"}], ",", "20"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "Full"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Delta]T/2\>\"", ",", "\"\<Probability\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.931893731565197*^9, 3.931893864252189*^9}, {
  3.93212090526737*^9, 3.9321209057529297`*^9}, {3.9321209518277645`*^9, 
  3.9321209771084976`*^9}, {3.932121734458805*^9, 3.932121777573246*^9}},
