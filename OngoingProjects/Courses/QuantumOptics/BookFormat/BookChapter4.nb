 FormBox[
  RowBox[{
   FormBox[
    OverscriptBox["H", "^"],
    TraditionalForm], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", " ", "m"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        OverscriptBox[
         StyleBox["p", "Bold",
          FontWeight->"Bold"], "^"], "-", 
        RowBox[{"q", " ", 
         SuperscriptBox[
          
          StyleBox[Cell[
           "A",ExpressionUUID->"27a2410d-9ca1-0e4f-8c05-e313a0aa82bc"], "Bold",
           FontWeight->"Bold"], "\[Prime]"], 
         RowBox[{"(", 
          RowBox[{
           OverscriptBox[
            StyleBox["r", "Bold",
             FontWeight->"Bold"], "^"], ",", "t"}], ")"}]}]}], ")"}], "2"]}], 
    "+", 
    RowBox[{
     SubscriptBox["V", "Coul"], "(", 
     OverscriptBox[
      StyleBox["r", "Bold",
       FontWeight->"Bold"], "^"], ")"}], "-", 
    RowBox[{
     StyleBox[
