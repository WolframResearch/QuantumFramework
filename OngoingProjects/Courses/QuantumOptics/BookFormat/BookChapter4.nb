Cell[TextData[{
 "Using Schmidt decomposition, it is possible to find for any time , bases ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"|", 
       RowBox[{
        SubscriptBox["u", "i"], "(", "t", ")"}]}]}], "\[RightAngleBracket]"}],
     "}"}], TraditionalForm]],ExpressionUUID->
  "5a8bcb02-b73e-b347-94d9-c34154644d92"],
 " for the atom and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"|", 
       RowBox[{
        SubscriptBox["v", "i"], "(", "t", ")"}]}]}], "\[RightAngleBracket]"}],
     "}"}], TraditionalForm]],ExpressionUUID->
  "d489dc6a-6c9c-984d-91c7-8dd0335c0d2b"],
 " for the field such that:"
}], "Text",
 CellChangeTimes->{
  3.9538228078524895`*^9, {3.9538344923612595`*^9, 3.953834492746191*^9}},
 CellID->180560685,ExpressionUUID->"289b55a6-3a43-7047-be86-ba9b2a29a25b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"|", 
    RowBox[{"\[Psi]", "(", "t", ")"}], "\[RightAngleBracket]"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["g", "1"], "(", "t", ")", 
     RowBox[{"|", 
      RowBox[{
       SubscriptBox["u", "1"], "(", "t", ")"}], "\[RightAngleBracket]"}], 
     RowBox[{"|", 
      RowBox[{
       SubscriptBox["v", "1"], "(", "t", ")"}], "\[RightAngleBracket]"}]}], "+", 
    RowBox[{
     SubscriptBox["g", "2"], "(", "t", ")", 
     RowBox[{"|", 
      RowBox[{
       SubscriptBox["u", "2"], "(", "t", ")"}], "\[RightAngleBracket]"}], 
     RowBox[{"|", 
      RowBox[{
       SubscriptBox["v", "2"], "(", "t", ")"}], 
      "\[RightAngleBracket]"}]}]}]}], TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{{3.9858909353065853`*^9, 3.9858909553864613`*^9}},
 CellID->117801694,ExpressionUUID->"3651f9ff-0255-f34f-8e13-e135756adc51"],

Cell["\<\
In those bases, the reduced density matrices of the atom and field are the \
same:\
\>", "Text",
 CellChangeTimes->{3.953822864320463*^9},
 CellID->86955451,ExpressionUUID->"ffbf5428-a97e-f848-8f71-98675c515e17"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Rho]", "u"], "(", "t", ")"}], "=", 
   RowBox[{
    SubscriptBox["\[Rho]", "v"], "(", "t", ")"}], "=", 
   RowBox[{"(", GridBox[{
      {
       SuperscriptBox[
        RowBox[{"|", 
         RowBox[{
          SubscriptBox["g", "1"], "(", "t", ")"}], "|"}], "2"], "0"},
      {"0", 
       SuperscriptBox[
        RowBox[{"|", 
         RowBox[{
          SubscriptBox["g", "2"], "(", "t", ")"}], "|"}], "2"]}
     }], ")"}]}], TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
