}, Open  ]],

Cell[TextData[{
 "Without coupling, |",
 Cell[BoxData[
  FormBox["e", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "39992514-ea77-2240-81b7-d7f3f482f9d6"],
 ",",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", "n"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "88f8f19b-929e-d64d-a8d3-5338cc163b73"],
 "\:27e9 and |",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "519dbe48-5b26-ad42-8a7e-b2862417b992"],
 ",",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c63c2ace-b4c9-ea4c-a241-fd8c8870fb5a"],
 "\:27e9 have opposite slopes in \[CapitalDelta] and cross at resonance, the \
atom and field carry the same excitation energy, and the system is \
degenerate. The interaction removes this degeneracy, the dressed energies \
form a hyperbola with the bare lines as asymptotes , far off resonance the \
coupling cannot compete with the energy mismatch, but near ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", "=", " ", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e7a661e2-214b-4b45-827a-d94c99771245"],
 " the branches bend apart and never meet, separated at closest approach by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", " ", "\[HBar]", " ", "g", " ", 
    SqrtBox[
     RowBox[{"n", "+", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ff541160-43fe-0046-9d70-c45d3a3ca0fe"]
}], "Text",
 CellID->623706477,ExpressionUUID->"687abbf7-c5d1-f84c-90fa-3c5c25c5534b"],

