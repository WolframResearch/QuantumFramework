   SubscriptBox["c", "b"], TraditionalForm]], "Text",ExpressionUUID->
  "db07754f-01c7-d24c-b78e-71146f97ab91"], "Text"],
 StyleBox[" equating the amplitudes to zero:", "Text"]
}], "CodeText",
 CellID->76248259,ExpressionUUID->"b3f12a43-cf1e-c244-8990-5a5b93cc0a74"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"coefs", " ", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"SolveValues", "[", " ", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"schrodingerEq", "[", "\"\<AmplitudeList\>\"", "]"}], "==", 
        "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          SubscriptBox["c", "\[FormalA]"], "\[Prime]",
          MultilineFunction->None], "[", "t", "]"}], ",", 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["c", "\[FormalB]"], "\[Prime]",
          MultilineFunction->None], "[", "t", "]"}]}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}], "//", "TrigToExp"}]}]], "Input",
 CellChangeTimes->{{3.9321371303624153`*^9, 3.932137212983507*^9}, {
   3.932137834560961*^9, 3.932137838192723*^9}, {3.932138169895033*^9, 
   3.932138200578148*^9}, {3.932138298479347*^9, 3.932138309635282*^9}, {
   3.9321384002485123`*^9, 3.932138620271038*^9}, {3.93213871123962*^9, 
   3.932138718486025*^9}, {3.93213883659506*^9, 3.932138849581913*^9}, {
   3.932138921786173*^9, 3.932138923903154*^9}, {3.932138961946195*^9, 
   3.932139054230133*^9}, {3.932139571583723*^9, 3.932139583035124*^9}, {
   3.932139641653108*^9, 3.932139653178589*^9}, 3.932140036430994*^9, {
   3.93214231760646*^9, 3.9321424147436924`*^9}, {3.932142702132456*^9, 
   3.932142754664259*^9}, {3.9321427863131275`*^9, 3.932142813307585*^9}, {
   3.9342950553006763`*^9, 3.9342950564998302`*^9}, {3.9537554271516495`*^9, 
   3.9537554351260834`*^9}, 3.969620828457102*^9},
 CellLabel->"In[218]:=",
 CellID->183276315,ExpressionUUID->"318541d4-955e-934f-8153-f8fd975975f7"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
       SubscriptBox["\[CapitalOmega]", "1"], " ", 
       RowBox[{
        SubscriptBox["c", "\[FormalB]"], "(", "t", ")"}], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "t", " ", "\[Omega]"}], "-", 
         RowBox[{"\[ImaginaryI]", " ", "t", " ", 
          SubscriptBox["\[Omega]", "0"]}], "+", 
         RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]}]]}]}], "-", 
     RowBox[{
      FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
      SubscriptBox["\[CapitalOmega]", "1"], " ", 
      RowBox[{
       SubscriptBox["c", "\[FormalB]"], "(", "t", ")"}], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"\[ImaginaryI]", " ", "t", " ", "\[Omega]"}]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", "t", " ", 
         SubscriptBox["\[Omega]", "0"]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]}]]}]}], ",", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
       SubscriptBox["\[CapitalOmega]", "1"], " ", 
       RowBox[{
        SubscriptBox["c", "\[FormalA]"], "(", "t", ")"}], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "t", " ", "\[Omega]"}], "+", 
         RowBox[{"\[ImaginaryI]", " ", "t", " ", 
          SubscriptBox["\[Omega]", "0"]}], "+", 
         RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]}]]}]}], "-", 
     RowBox[{
      FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
      SubscriptBox["\[CapitalOmega]", "1"], " ", 
      RowBox[{
       SubscriptBox["c", "\[FormalA]"], "(", "t", ")"}], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"\[ImaginaryI]", " ", "t", " ", "\[Omega]"}]}], "+", 
        RowBox[{"\[ImaginaryI]", " ", "t", " ", 
         SubscriptBox["\[Omega]", "0"]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]}]]}]}]}], "}"}], 
  TraditionalForm]], "Output",
 CellLabel->"Out[218]=",
 CellID->142642586,ExpressionUUID->"126f9846-1094-c041-96da-76df6c4356e4"]
}, Open  ]],

Cell[TextData[{
 "Utilizing the Rotating Wave Approximation(RWA) we can discard the terms \
with exp(|\[Omega] + ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Omega]", "0"], "|"}], ")"}], TraditionalForm]],
  ExpressionUUID->"c47aa552-58f4-9f42-bb42-481e2095f342"],
 " because are rapidly oscillating terms and let \[Delta] = \[Omega] - ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "0"], TraditionalForm]],ExpressionUUID->
  "d2359e94-0acf-e64e-9f9f-cfd90fc5d0fd"],
 " be the detuning from resonance"
}], "Text",
 CellID->71352421,ExpressionUUID->"25c60f7f-7fa5-c349-aef7-1195d65175f0"],

Cell[TextData[StyleBox["Define rules to use RWA and replace the detuning:", \
"Text"]], "CodeText",
 CellChangeTimes->{{3.966619405924402*^9, 3.966619442538275*^9}},
 CellID->271886352,ExpressionUUID->"9b42e921-5dc6-434a-9433-fd41ee2b92d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RWA\[Delta]rules", " ", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}], " ", "+", " ", 
        RowBox[{"\[ImaginaryI]", " ", "t", " ", "\[Omega]"}], " ", "+", " ", 
        RowBox[{"\[ImaginaryI]", " ", "t", " ", 
         SubscriptBox["\[Omega]", "0"]}]}]], "->", "0"}], ",", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Phi]"}], " ", "-", " ", 
        RowBox[{"\[ImaginaryI]", " ", "t", " ", "\[Omega]"}], " ", "-", " ", 
        RowBox[{"\[ImaginaryI]", " ", "t", " ", 
         SubscriptBox["\[Omega]", "0"]}]}]], "->", "0"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", "t", " ", "\[Omega]"}], "-", 
        RowBox[{"\[ImaginaryI]", " ", "t", " ", 
         SubscriptBox["\[Omega]", "0"]}]}], ")"}], "->", " ", 
      RowBox[{"\[ImaginaryI]", " ", "t", " ", "\[Delta]"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", "t", " ", 
         SubscriptBox["\[Omega]", "0"]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", "t", " ", "\[Omega]"}]}], ")"}], "->", 
      " ", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", "\[Delta]"}]}]}], 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.932142817562277*^9, 3.932142854431644*^9}, {
   3.93214302283741*^9, 3.9321431165651436`*^9}, {3.932221909399183*^9, 
   3.932221912674444*^9}, {3.934295061547844*^9, 3.9342950899480457`*^9}, {
   3.934295150730459*^9, 3.934295151837105*^9}, 3.9537555229163074`*^9},
 CellLabel->"In[219]:=",
 CellID->60590276,ExpressionUUID->"9792ff9e-0847-4c4c-a02b-340a557fab42"],

Cell[TextData[StyleBox["Resulting equations:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9666194256117916`*^9, 3.966619434847849*^9}},
 CellID->128080500,ExpressionUUID->"abd77dd2-81d4-a64c-b7ae-ead472a47d5a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"eqs", " ", "=", " ", 
  RowBox[{"Thread", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         SubscriptBox["c", "\[FormalA]"], "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], ",", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["c", "\[FormalB]"], "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}]}], "}"}], " ", "==", " ", 
     "coefs"}], " ", "/.", "RWA\[Delta]rules"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.932143890932745*^9, 3.932143897974716*^9}, {
   3.932143928140142*^9, 3.93214392990575*^9}, {3.9342950692830677`*^9, 
   3.934295069952011*^9}, {3.9342951603672447`*^9, 3.934295161443918*^9}, 
   3.9537555351241913`*^9},
 CellLabel->"In[220]:=",
 CellID->186869704,ExpressionUUID->"92449e56-84ce-3d4b-8b1b-ffc5e2dfbc84"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox[
       SubscriptBox["c", "\[FormalA]"], "\[Prime]",
       MultilineFunction->None], "(", "t", ")"}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
      SubscriptBox["\[CapitalOmega]", "1"], " ", 
      RowBox[{
       SubscriptBox["c", "\[FormalB]"], "(", "t", ")"}], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", "\[Delta]", " ", "t"}], "+", 
        RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]}]]}]}], ",", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       SubscriptBox["c", "\[FormalB]"], "\[Prime]",
       MultilineFunction->None], "(", "t", ")"}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
      SubscriptBox["\[CapitalOmega]", "1"], " ", 
      RowBox[{
       SubscriptBox["c", "\[FormalA]"], "(", "t", ")"}], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"\[ImaginaryI]", " ", "\[Delta]", " ", "t"}]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]}]]}]}]}], "}"}], 
  TraditionalForm]], "Output",
 CellLabel->"Out[220]=",
 CellID->560339867,ExpressionUUID->"2cf0726f-1c0b-b74d-97ff-8637178554e9"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Lets solve them for the case ", "Text"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "a"], "(", "0", ")", "=", "1", ",", " ", 
    SubscriptBox["c", "b"], "(", "0", ")", "=", "0"}], TraditionalForm]], 
  "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{{3.985890935276165*^9, 3.9858909553740406`*^9}},
  ExpressionUUID->"4caf9cdf-19b6-fc4d-9dfd-798800940337"],
 StyleBox[" (atom initially at the ground state) and we  introduce the \
variable \[CapitalOmega] called ", "Text"],
 StyleBox["generalized Rabi frequency ", "Text",
  FontSlant->"Italic"],
 StyleBox["to the solution of the differential equation", "Text"],
 StyleBox[":", "Text",
  FontSlant->"Italic"]
}], "CodeText",
 CellID->547696625,ExpressionUUID->"f4959d14-c297-ca45-a1c3-8dfe82193831"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"coefSols", " ", "=", " ", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{"eqs", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            SubscriptBox["c", "\[FormalA]"], "[", "0", "]"}], "==", " ", 
           "1"}], ",", " ", 
          RowBox[{
           RowBox[{
            SubscriptBox["c", "\[FormalB]"], "[", "0", "]"}], " ", "==", " ", 
           "0"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SubscriptBox["c", "\[FormalA]"], "[", "t", "]"}], ",", 
        RowBox[{
         SubscriptBox["c", "\[FormalB]"], "[", "t", "]"}]}], "}"}], ",", 
      "t"}], "]"}], "]"}], " ", "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SqrtBox["_"], "->", "\[CapitalOmega]"}], ",", 
     RowBox[{
      RowBox[{"1", "/", 
       SqrtBox["_"]}], "->", 
      RowBox[{"1", "/", " ", "\[CapitalOmega]"}]}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.932221081864279*^9, 3.932221122397951*^9}, {
  3.932221255116215*^9, 3.9322212629752293`*^9}, {3.932221615297041*^9, 
  3.932221845344187*^9}, {3.932222694926214*^9, 3.9322227227719345`*^9}, {
  3.93222369380257*^9, 3.9322236967335596`*^9}, {3.932226528404461*^9, 
  3.9322265614896293`*^9}, {3.93429518926713*^9, 3.934295189621027*^9}, {
  3.9537555635544014`*^9, 3.953755586022146*^9}},
 CellLabel->"In[221]:=",
 CellID->51895428,ExpressionUUID->"f808e423-9def-6447-87ed-9d6a17cc5920"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["c", "\[FormalA]"], "(", "t", ")"}], "\[Rule]", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"\[ImaginaryI]", " ", "\[Delta]", " ", "t"}], "2"]], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"cos", "(", 
          FractionBox[
           RowBox[{"t", " ", "\[CapitalOmega]"}], "2"], ")"}], "-", 
         FractionBox[
          RowBox[{"\[ImaginaryI]", " ", "\[Delta]", " ", 
           RowBox[{"sin", "(", 
            FractionBox[
             RowBox[{"t", " ", "\[CapitalOmega]"}], "2"], ")"}]}], 
          "\[CapitalOmega]"]}], ")"}]}]}], ",", 
     RowBox[{
      RowBox[{
       SubscriptBox["c", "\[FormalB]"], "(", "t", ")"}], "\[Rule]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["\[CapitalOmega]", "1"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Delta]", " ", "t"}], "+", 
             RowBox[{"2", " ", "\[Phi]"}]}], ")"}]}]], " ", 
         RowBox[{"sin", "(", 
          FractionBox[
           RowBox[{"t", " ", "\[CapitalOmega]"}], "2"], ")"}]}], 
        "\[CapitalOmega]"]}]}]}], "}"}], "}"}], TraditionalForm]], "Output",
 CellLabel->"Out[221]=",
 CellID->811908,ExpressionUUID->"68797443-8e26-4647-b505-45f2c0b4eb10"]
}, Open  ]],

Cell[TextData[{
 "We can find the probability that the initial state of the atom ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   Cell["|",ExpressionUUID->"a6126bdb-d90b-4a45-9757-89e700605d7b"], "a", 
    Cell["\[RightAngleBracket]",ExpressionUUID->
     "2f1f4469-08ed-dd44-8756-ab8fcb0935e7"]}], TraditionalForm]],
  ExpressionUUID->"3870ebaa-a56c-4b45-a7e5-fa608f7d0dea"],
 " transitions to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   Cell["|",ExpressionUUID->"167cb35c-b12d-0d40-9b1a-72234afc3647"], "b", 
    Cell["\[RightAngleBracket]",ExpressionUUID->
     "09f3f3e4-b33d-5349-981b-fb75851599fb"]}], TraditionalForm]],
  ExpressionUUID->"d0c719f0-fcf9-dd4e-bb8a-d9f74e60816c"],
 " as a function of time, and we plot it for different ",
 StyleBox["detunings",
  IgnoreSpellCheck->True]
}], "Text",
 CellID->203543325,ExpressionUUID->"87b1d8be-3f81-3047-883e-308d0a887f67"],

Cell[TextData[{
 "Wrapping the solution in a ",
 StyleBox["QuantumState", "FormattedFunction"],
 " that is dependent on the parameters:"
}], "Text",
 CellID->5094125,ExpressionUUID->"e11aaaa8-590c-ce46-a41d-f57b6fcb0881"],

Cell[BoxData[
 RowBox[{
  RowBox[{"solvedState", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"Values", " ", "@", " ", 
      RowBox[{"coefSols", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", "atomBasis", ",", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"t", ",", "\[Delta]", ",", "\[CapitalOmega]", ",", 
        SubscriptBox["\[CapitalOmega]", "1"]}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.932226585476242*^9, 3.932226662089279*^9}, {
   3.9322267690210247`*^9, 3.932226775295439*^9}, {3.932226807709055*^9, 
   3.9322270816359234`*^9}, {3.932227120163744*^9, 3.932227237431393*^9}, {
   3.9322276020653687`*^9, 3.932227639496666*^9}, {3.9322278996070824`*^9, 
   3.9322279289488482`*^9}, {3.9322281260582304`*^9, 3.9322281292948256`*^9}, 
   3.932229761169405*^9, {3.934295196409916*^9, 3.9342951968523064`*^9}},
