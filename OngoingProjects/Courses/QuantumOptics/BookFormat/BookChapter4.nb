 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "12", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.925488448059025*^9, 3.925488455540657*^9}, {
   3.925491136924469*^9, 3.92549113730368*^9}, 3.925811569446467*^9, 
   3.932569552473772*^9, {3.9343056789889126`*^9, 3.9343056819671*^9}},
 CellLabel->"In[334]:=",
 CellID->305816395,ExpressionUUID->"cc820531-b77f-c948-a118-94a5590434b1"],

Cell["\<\
Returning to the Jaynes Cummings model separating the free and interaction \
terms:\
\>", "Text",
 CellChangeTimes->{{3.9538071288167896`*^9, 3.953807157480097*^9}},
 CellID->95426253,ExpressionUUID->"4bc33435-5816-5d40-9304-e98cbf6a3a5c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"H0", " ", "=", " ", 
    RowBox[{"QuantumOperator", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"h", " ", "\[Nu]", " ", 
        RowBox[{
         SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], "+", " ", 
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", "h", " ", "\[Omega]", " ", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<Z\>\"", ",", "atomBasis"}], "]"}]}]}], ",", 
      RowBox[{"\"\<Parameters\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"\[Nu]", ",", "\[Omega]"}], "}"}]}]}], "]"}]}], ";"}], 
  " "}]], "Input",
 CellChangeTimes->{{3.9258135127151585`*^9, 3.925813535786131*^9}, 
   3.925813637429844*^9, 3.92581509949238*^9, {3.934305710500033*^9, 
   3.9343057222709446`*^9}, {3.953807026781433*^9, 3.9538070508035526`*^9}, {
   3.966705190583103*^9, 3.9667052040133266`*^9}},
 CellLabel->"In[335]:=",
 CellID->412353055,ExpressionUUID->"dfc9903f-b380-cd4e-9661-50b04113c11e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H1", " ", "=", " ", 
   RowBox[{"h", " ", "g", "  ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Sigma]plus", "@", "a"}], "+", 
      RowBox[{"\[Sigma]minus", "@", 
       SuperscriptBox["a", "\[Dagger]"]}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9538071043878956`*^9, 3.953807106036907*^9}, {
  3.9667051589162636`*^9, 3.9667051808215446`*^9}},
 CellLabel->"In[273]:=",
 CellID->47653396,ExpressionUUID->"f9ed4007-f258-9e49-b76d-62c18a0cfcfb"],

Cell[TextData[{
 "For a fixed ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "4da5a4c1-4cd4-cc4b-abb0-54bee8e9709e"],
 ", the dynamics is determined by the product states ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"|", "e"}], "\[RightAngleBracket]"}], "|", 
     FormBox["n",
      TraditionalForm]}], "\[RightAngleBracket]"}], TraditionalForm]],
  ExpressionUUID->"4d5d095d-4557-e843-bd4f-df0ebe90017a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[VerticalSeparator]", "g"}], "\[RightAngleBracket]"}], "|", 
     RowBox[{"n", "+", "1"}]}], "\[RightAngleBracket]"}], TraditionalForm]],
  ExpressionUUID->"b3a5b259-8554-ae41-a684-45065603dfbf"],
 " (or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"|", "e"}], "\[RightAngleBracket]"}], "|", 
     RowBox[{
      FormBox["n",
       TraditionalForm], "-", "1"}]}], "\[RightAngleBracket]"}], 
   TraditionalForm]],ExpressionUUID->"13d833df-8012-3c4a-a5f8-cb255e3fc8f4"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[VerticalSeparator]", "g"}], "\[RightAngleBracket]"}], "|", 
     "n"}], "\[RightAngleBracket]"}], TraditionalForm]],ExpressionUUID->
  "fd4577ee-17e0-be43-892b-74cefbc5f592"],
 "). At near resonance ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
