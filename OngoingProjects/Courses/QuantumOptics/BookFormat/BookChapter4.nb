Cell[CellGroupData[{

Cell["Free Hamiltonian:", "ExerciseNote",
 CellChangeTimes->{{3.972145352966507*^9, 3.9721453567735023`*^9}},
 CellID->229574746,ExpressionUUID->"bab9546a-ddf1-3445-91a4-9cf6f34a9635"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H0", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"h", " ", "\[Nu]", " ", 
       RowBox[{
        SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], "+", "  ", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", "h", " ", "\[Omega]", " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}]}], "}"}], "]"}], ",", "atomBasis"}], "]"}]}]}],
      ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", "\[Omega]"}], "}"}]}]}], "]"}]}], 
  ";"}]], "ExerciseInput",
 CellLabel->"In[542]:=",
 CellID->61835759,ExpressionUUID->"53cfed14-ecdf-e343-becf-25d68fd27cbf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Interaction part:", "ExerciseNote",
 CellID->22333820,ExpressionUUID->"01da0f51-5e0c-ac49-bc8a-1efc773e32d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H1", " ", "=", " ", 
   RowBox[{"h", " ", "g", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Sigma]plus", "@", "a"}], " ", "+", 
      RowBox[{"\[Sigma]minus", "@", 
       SuperscriptBox["a", "\[Dagger]"]}]}], ")"}]}]}], 
  ";"}]], "ExerciseInput",
 CellChangeTimes->{{3.9666273871550503`*^9, 3.9666274345149975`*^9}},
 Background->None,
 CellLabel->"In[543]:=",
 CellID->12193314,ExpressionUUID->"8c24ad8a-825b-1d4b-8594-d8c6435d183f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Going to the interaction picture:", "ExerciseNote",
 CellID->54462979,ExpressionUUID->"03d709aa-8c99-a347-829e-f4e732c45dc4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HInteract", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"MatrixExp", "[", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"H0", "/", "h"}], " ", "t"}], "]"}], "@", " ", 
     RowBox[{"H1", " ", "@", " ", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"H0", "/", "h"}], " ", "t"}], "]"}]}]}], "]"}]}], 
  ";"}]], "ExerciseInput",
 CellChangeTimes->{
  3.935507691182604*^9, {3.9355092403741226`*^9, 3.93550925898095*^9}, {
