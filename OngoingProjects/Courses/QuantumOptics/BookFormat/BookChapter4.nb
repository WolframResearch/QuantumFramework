Cell[TextData[{
 "Is not hard to check from the results that the Rabi oscillations go between \
",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "67959144-0789-9c4d-b14d-460364f2e5cb"],
 " and a maximum value , and that value is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "max"], "=", 
    FractionBox[
     SuperscriptBox[
      SubscriptBox["\[CapitalOmega]", "1"], "2"], 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["\[CapitalOmega]", "1"], "2"], "+", 
      SuperscriptBox["\[Delta]", "2"]}]]}], TraditionalForm]],
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{{3.9858909352784786`*^9, 3.9858909553760376`*^9}},
  ExpressionUUID->"8e8a2a40-6e80-4749-871f-72e94c689ee3"],
 " . If we consider it as a function of \[Omega] it has a Lorentzian profile \
that is maximum when the detuning is zero, and the width at half-maximum is 2 \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "1"], TraditionalForm]],ExpressionUUID->
  "ad5f82f1-af62-1641-a179-bb3f8f171028"],
 " dependent of the amplitude of the electromagnetic field "
}], "Text",
 CellID->63843637,ExpressionUUID->"da0e2364-6e20-ba45-9f2c-24305749cf48"],

