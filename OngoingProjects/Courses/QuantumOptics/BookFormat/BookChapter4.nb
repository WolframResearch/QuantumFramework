 CellID->669359696,ExpressionUUID->"70968ae3-5bc1-e04b-a705-853f291e92cc"],

Cell[TextData[StyleBox["Calculate energy shift:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9668023685727024`*^9, 3.9668023947394695`*^9}},
 CellID->193762536,ExpressionUUID->"568ff9dd-339a-3742-899f-87f4cfba965d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"eigenvals", "//", "Differences"}], " ", "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.9258152868662148`*^9, 3.925815293026726*^9}, {
  3.925834361020176*^9, 3.925834374983865*^9}, {3.934306189434986*^9, 
  3.9343061911855335`*^9}},
 CellLabel->"In[356]:=",
 CellID->276511899,ExpressionUUID->"e31693ec-01ec-1a49-be42-46f7b412b54d"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"h", " ", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["\[CapitalDelta]", "2"], "+", 
      RowBox[{"4", " ", 
       SuperscriptBox["g", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"n", "+", "1"}], ")"}]}]}]]}], "}"}], 
  TraditionalForm]], "Output",
 CellLabel->"Out[356]=",
 CellID->20898066,ExpressionUUID->"51b721ce-ead8-0a48-97e1-8d59dfe3ab92"]
}, Open  ]],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ab8bbf41-411d-904d-ba4c-d55f29d84679"],
 " there is no interaction and we recover the previous result:"
}], "Text",
 CellID->134437244,ExpressionUUID->"ae29c3ee-0d10-d947-bfb0-202d92b4fe74"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"%", "/.", 
    RowBox[{"g", "->", "0"}]}], ",", 
   RowBox[{"\[CapitalDelta]", ">", "0"}]}], "]"}]], "Input",
 CellLabel->"In[358]:=",
 CellID->216631204,ExpressionUUID->"7ed7c757-76fb-e948-b511-168d9dd57d83"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"h", " ", "\[CapitalDelta]"}], "}"}]], "Output",
 CellLabel->"Out[358]=",
 CellID->178446121,ExpressionUUID->"8cd22c28-a3d0-ca4c-b9dc-ce7d1843cd1f"]
}, Open  ]],

Cell[TextData[{
 "The eigenstates associated with the energy eigenvalues have the following \
form:",
 StyleBox[" ",
  FontSize->18]
}], "Text",
 CellChangeTimes->{{3.925832533563184*^9, 3.925832551358511*^9}, {
   3.925832676716741*^9, 3.925833252966275*^9}, {3.934297610818298*^9, 
   3.934297613385858*^9}, {3.9342976998301926`*^9, 3.9342977318895683`*^9}, {
   3.934297834964571*^9, 3.934297839763733*^9}, {3.934298075464466*^9, 
   3.9342981240381594`*^9}, {3.934298168574709*^9, 3.934298174699354*^9}, {
   3.934298243402174*^9, 3.934298243889595*^9}, 3.9668019742767124`*^9},
 CellID->321391677,ExpressionUUID->"3d065e1f-a58e-534c-a3e0-4707034be2f4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"|", 
        RowBox[{"n", ",", "+"}], "\[RightAngleBracket]"}], "=", 
       RowBox[{
        RowBox[{"cos", "(", 
         RowBox[{
          SubscriptBox["\[CapitalPhi]", "n"], "/", "2"}], ")"}], "|", 
        SubscriptBox["\[Psi]", 
         RowBox[{"0", ",", "n"}]]}]}], "\[RightAngleBracket]"}], "+", 
     RowBox[{"sin", "(", 
      RowBox[{
       SubscriptBox["\[CapitalPhi]", "n"], "/", "2"}], ")"}]}], "|", 
    SubscriptBox["\[Psi]", 
     RowBox[{"1", ",", "n"}]]}], "\[RightAngleBracket]"}], 
  TraditionalForm]], "DisplayFormula",
 CellID->372176848,ExpressionUUID->"b0f5d1d3-9d0d-c348-9812-a7352927e2a8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"|", 
        RowBox[{"n", ",", "-"}], "\[RightAngleBracket]"}], "=", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"sin", "(", 
          RowBox[{
           SubscriptBox["\[CapitalPhi]", "n"], "/", "2"}], ")"}]}], "|", 
        SubscriptBox["\[Psi]", 
         RowBox[{"0", ",", "n"}]]}]}], "\[RightAngleBracket]"}], "+", 
     RowBox[{"cos", "(", 
      RowBox[{
       SubscriptBox["\[CapitalPhi]", "n"], "/", "2"}], ")"}]}], "|", 
    SubscriptBox["\[Psi]", 
     RowBox[{"1", ",", "n"}]]}], "\[RightAngleBracket]"}], 
  TraditionalForm]], "DisplayFormula",
 CellID->403049114,ExpressionUUID->"0c9cd83c-8be1-9f46-9542-71e99e83a37b"],

Cell[BoxData[
 StyleBox[
  RowBox[{"such", " ", "that", " "}], "Text"]], "DisplayFormula",
