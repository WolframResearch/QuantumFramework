Cell[TextData[StyleBox["Bloch vector expressed in terms of the components of \
the matrix:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9668029497056084`*^9, 3.9668029765136166`*^9}, {
  3.966806540197811*^9, 3.966806547745592*^9}},
