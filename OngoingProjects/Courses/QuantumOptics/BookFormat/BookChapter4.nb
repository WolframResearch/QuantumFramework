Cell[CellGroupData[{

Cell["Distance function:", "ExerciseNote",
 CellID->24105538,ExpressionUUID->"b7b1d4b3-cdd9-df47-a90a-bfa9c2a41698"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dist", "[", 
   RowBox[{"\[Tau]_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"QuantumDistance", "[", 
   RowBox[{
    RowBox[{"QuantumPartialTrace", "[", 
     RowBox[{
      RowBox[{"\[Psi]e", "[", "\[Tau]", "]"}], ",", 
      RowBox[{"{", "1", "}"}]}], "]"}], ",", 
    RowBox[{"QuantumPartialTrace", "[", 
     RowBox[{
      RowBox[{"\[Psi]g", "[", "\[Tau]", "]"}], ",", 
      RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}]}]], "ExerciseInput",
 CellLabel->"In[31]:=",
 CellID->86603997,ExpressionUUID->"fe3fcdab-7b44-9d43-9ba9-aef04ae0651c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Minimize the function in a domain excluding 0, compare with a good \
approximation given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "/", "\[Chi]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "22aebb8a-d01c-5c48-89f8-e88301da3a20"],
 ":"
}], "ExerciseNote",
 CellID->412756096,ExpressionUUID->"2d98c2da-a3f0-ab46-acb8-1d8fede09ccc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"NMinimize", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "@", 
      RowBox[{"dist", "[", "\[Tau]", "]"}]}], ",", 
     RowBox[{"100", "<", "\[Tau]", "<", "400"}]}], "}"}], ",", "\[Tau]"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"N", "[", 
  RowBox[{"\[Pi]", "/", "\[Chi]"}], "]"}]}], "ExerciseInput",
 CellLabel->"In[46]:=",
 CellID->183911948,ExpressionUUID->"dfc3a742-5d6f-1949-945d-f8b1ac2bc0db"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.003134839586339644`", ",", 
   RowBox[{"{", 
    RowBox[{"\[Tau]", "\[Rule]", "321.93085254711673`"}], "}"}]}], 
  "}"}]], "ExerciseOutput",
 CellLabel->"Out[46]=",
