Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"state", "[", "\"\<BlochVector\>\"", "]"}]], "Input",
 CellLabel->"In[516]:=",
 CellID->249034594,ExpressionUUID->"a5465ff3-b02b-a14e-a047-af504190e222"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SubscriptBox["b", "12"], "+", 
    SubscriptBox["b", "21"]}], ",", 
   RowBox[{
    RowBox[{"\[ImaginaryI]", " ", 
     SubscriptBox["b", "12"]}], "-", 
    RowBox[{"\[ImaginaryI]", " ", 
     SubscriptBox["b", "21"]}]}], ",", 
   RowBox[{
    SubscriptBox["b", "11"], "-", 
    SubscriptBox["b", "22"]}]}], "}"}]], "Output",
 CellLabel->"Out[516]=",
 CellID->18079885,ExpressionUUID->"ec42a012-0343-7b4c-bcb8-93934f56e3cb"]
}, Open  ]],

Cell[TextData[{
 "And the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "i"], " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "acff8f7c-3f86-4343-8513-56ffd3f65fd1"],
 "coefficients are calculated as a function of the length of the Bloch vector:"
}], "Text",
 CellID->57543637,ExpressionUUID->"b0f9e096-4d4b-cd47-8bfc-ba10ea37da8d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["g", "1"], "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox["1", "2"], "(", 
    RowBox[{"1", "+", 
     RowBox[{"|", 
      RowBox[{
       StyleBox["s", "Bold"], "(", "t", ")"}], "|"}]}], ")"}], ",", " ", 
   RowBox[{
    SubscriptBox["g", "2"], "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox["1", "2"], "(", 
    RowBox[{"1", "-", 
     RowBox[{"|", 
      RowBox[{
       StyleBox["s", "Bold"], "(", "t", ")"}], "|"}]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{{3.9858909353128414`*^9, 3.985890955388462*^9}},
 CellID->700928725,ExpressionUUID->"a1ef4a09-ed89-bf4c-92f1-fa3dc1b40ae5"],

Cell["Von Neumann entropy for each of the subsystems:", "Text",
 CellChangeTimes->{3.953823130543968*^9},
 CellID->53908040,ExpressionUUID->"943d2578-b6b4-5147-be60-ee6e98d4ea4e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"S", "(", 
    SubscriptBox["\[Rho]", "u"], ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      SubscriptBox["g", "1"], "(", "t", ")"}], " ", "ln", "(", 
     SubscriptBox["g", "1"], "(", "t", ")", ")"}], "-", 
    RowBox[{
     SubscriptBox["g", "2"], "(", "t", ")", " ", "ln", "(", 
     SubscriptBox["g", "2"], "(", "t", ")", ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{{3.985890935313841*^9, 3.9858909553889084`*^9}},
 CellID->106747496,ExpressionUUID->"87052ebb-9b55-174b-97cc-8416877c1aab"],

