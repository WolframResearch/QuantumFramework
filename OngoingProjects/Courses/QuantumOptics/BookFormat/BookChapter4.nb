Cell[TextData[{
 "The dressed states are stationary states of the atom-field system, so the \
evolution say for  the initial state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{"\[Psi]", "(", "0", ")"}],
     FontSize->18,
     FontWeight->"Plain"], "=", 
    RowBox[{
     SubscriptBox["\[Sum]", 
      RowBox[{" ", 
       StyleBox["n",
        FontWeight->"Plain"]}]], 
     RowBox[{
      SubscriptBox["C", "n"], "[", 
      RowBox[{
       RowBox[{
        RowBox[{"cos", "(", 
         RowBox[{
          SubscriptBox["\[CapitalPhi]", "n"], "/", "2"}], ")"}], Cell[
        "|",ExpressionUUID->"cef1077e-b769-ba4b-8156-e20fd35de2a5"], "n"}], ",", 
       RowBox[{
        RowBox[{
        "+", Cell[
         "\[RightAngleBracket]",ExpressionUUID->
          "49591b90-aab2-4d4f-9c76-f0e4e06766d2"]}], "-", 
        RowBox[{
         RowBox[{"sin", "(", 
          RowBox[{
           SubscriptBox["\[CapitalPhi]", "n"], "/", "2"}], ")"}], Cell[
         "|",ExpressionUUID->"5f37d8b3-f3ff-1348-ba85-ef7ec21c6a08"], "n"}]}],
        ",", 
       RowBox[{
       "-", Cell[
        "\[RightAngleBracket]",ExpressionUUID->
         "665b9a2c-aa69-9746-8302-a8260f987958"]}]}], "]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"e6d1f07b-7f57-8e4b-ae42-49ce8ccad374"],
 " can be described in this basis as"
}], "Text",
 CellID->466823281,ExpressionUUID->"80875c8a-32fe-a945-920c-9248f095e12b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Psi]", "(", "t", ")"}], "=", 
   RowBox[{
    UnderoverscriptBox[
     StyleBox["\[Sum]",
      FontSize->18,
      FontWeight->"Bold"], "n", ""], 
    RowBox[{
     SubscriptBox["C", "n"], "[", 
     RowBox[{
      RowBox[{
       RowBox[{"cos", "(", 
        RowBox[{
         SubscriptBox["\[CapitalPhi]", "n"], "/", "2"}], ")"}], Cell[
       "|",ExpressionUUID->"be7b6228-0ea0-164e-b5bf-8fda77c21d1d"], "n"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
        "+", Cell[
         "\[RightAngleBracket]",ExpressionUUID->
          "c8d0fcb2-c6ee-874b-a194-f58646d13b17"]}], 
        SuperscriptBox["e", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", 
          SubscriptBox["E", "+"], "(", "n", ")", " ", 
          RowBox[{"t", "/", "\[HBar]"}]}]]}], "-", 
       RowBox[{
        RowBox[{"sin", "(", 
         RowBox[{
          SubscriptBox["\[CapitalPhi]", "n"], "/", "2"}], ")"}], Cell[
        "|",ExpressionUUID->"d8dfc312-bbb3-ae4a-b8d1-128bf6d3ff60"], "n"}]}], 
      ",", 
      RowBox[{
       RowBox[{
       "-", Cell[
        "\[RightAngleBracket]",ExpressionUUID->
         "d7557f4f-d3f8-3448-867a-e13e0e3f68f5"]}], 
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         SubscriptBox["E", "-"], "(", "n", ")", " ", 
         RowBox[{"t", "/", "\[HBar]"}]}]]}]}], "]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->133743851,ExpressionUUID->"46e61658-ab1a-1c4f-86f4-8e90e704a55e"]
}, Open  ]],

