Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalPhi]", "n"], "=", 
   RowBox[{
    SuperscriptBox["tan", 
     RowBox[{"-", "1"}]], "(", 
    FractionBox[
     RowBox[{"2", " ", "g", " ", 
      SqrtBox[
       RowBox[{"n", "+", "1"}]]}], "\[CapitalDelta]"], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->2309853,ExpressionUUID->"c7acae13-2a89-8d47-a001-e1998035b94a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   StyleBox["and", "Text"], "  ", 
   FormBox[
    StyleBox[
     RowBox[{
      RowBox[{"sin", "(", 
       RowBox[{
        SubscriptBox["\[CapitalPhi]", "n"], "/", "2"}], ")"}], "=", 
      RowBox[{
       FractionBox["1", 
        SqrtBox["2"]], 
       SuperscriptBox[
        RowBox[{"[", 
         FractionBox[
          RowBox[{
           SubscriptBox["\[CapitalOmega]", "n"], "-", "\[CapitalDelta]"}], 
          SubscriptBox["\[CapitalOmega]", "n"]], "]"}], 
        RowBox[{"1", "/", "2"}]]}]}], "Text"],
    TraditionalForm]}], ",", 
  StyleBox[
   FormBox[
    RowBox[{
     RowBox[{"cos", "(", 
