         RowBox[{"(", 
          RowBox[{
           OverscriptBox["r", "^"], ",", "t"}], ")"}]}]}], ")"}], "2"]}], "+", 
    RowBox[{
     SubscriptBox["V", "Coul"], "(", Cell[TextData[Cell[BoxData[
      FormBox[
       OverscriptBox[
