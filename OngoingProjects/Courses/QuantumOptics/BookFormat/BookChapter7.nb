Cell[CellGroupData[{

Cell[TextData[StyleBox["Squeezed operator and squeezed vacuum", \
"Subsubsection"]], "Subsection",
 CellChangeTimes->{{3.925562880553051*^9, 3.9255628851255684`*^9}, {
  3.930914670428442*^9, 3.9309146736939735`*^9}},
 CellID->102053714,ExpressionUUID->"5c995a07-98a1-8344-a346-af0c40926017"],

Cell["The unitary squeeze operator is defined as ", "Text",
 CellID->927380995,ExpressionUUID->"88ea4552-14b8-fc49-9b6e-559f951fbd5a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["S", "^"], "(", "\[Xi]", ")"}], "=", 
   RowBox[{"exp", "(", 
    RowBox[{
     FractionBox["1", "2"], "(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[Xi]", "*"], " ", 
       SuperscriptBox[
        OverscriptBox["a", "^"], "2"]}], "-", 
      RowBox[{"\[Xi]", " ", 
       SuperscriptBox[
        OverscriptBox["a", "^"], 
        RowBox[{"\[Dagger]", "2"}]]}]}], ")"}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{{3.9859481464695816`*^9, 3.98594816894878*^9}},
 FontSize->18,
 CellID->196516586,ExpressionUUID->"9b8b3151-e569-9b43-bb8d-1b19c28ae95b"],

Cell[TextData[{
 "The squeeze operator can be understood as a two photon generalization of \
displacement operator, where \[Xi] is a complex number \[Xi] = ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "93dc63aa-ab62-c649-9211-5e0a94aa9aa9"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], TraditionalForm]],
  ExpressionUUID->"8353dace-da29-b04c-9dc0-302b5b607040"],
 ", ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "00bf4c76-fbfd-6b43-8e4a-b22bcd990144"],
 " is called the squeeze parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "0", " ", "\[LessEqual]", " ", "r", " ", "\[LessEqual]", " ", 
    "\[Infinity]"}], TraditionalForm]],ExpressionUUID->
  "189f867c-3cd5-144f-8867-326ba130eaff"]
}], "Text",
 CellID->36840141,ExpressionUUID->"ad274fe7-0974-f841-98d5-b45454aa4074"],

Cell[TextData[{
 "Quadratic combinations of ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["a", "^"], TraditionalForm]],ExpressionUUID->
  "831ecf86-477f-0344-a4c6-eec2e1a2a320"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["a", "^"], "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "c055481b-e8c8-204b-b255-42f221aecd50"],
 " can generate terms like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      OverscriptBox["x", "^"], 
      OverscriptBox["p", "^"]}], "+", 
     RowBox[{
      OverscriptBox["p", "^"], 
      OverscriptBox["x", "^"]}]}], ",", " ", 
    SuperscriptBox[
     OverscriptBox["x", "^"], "2"], ",", " ", 
    SuperscriptBox[
     OverscriptBox["p", "^"], "2"]}], TraditionalForm]],ExpressionUUID->
  "5b21c187-c57a-3c4e-964b-48b75bba51ae"],
 " which exponentiated act like a scaling transformation. So it makes sense \
this operator can squeeze or stretch the variances of the quadratures"
}], "Text",
 CellID->161926922,ExpressionUUID->"00c1ccb8-82de-394a-9326-3444dc60cc80"],

Cell["\<\
Squeeze operator in Wolfram Quantum Framework (can specify the truncation \
size):\
\>", "Text",
 CellID->276657929,ExpressionUUID->"ce30ecac-8284-ab4e-a457-d6953199b415"],

