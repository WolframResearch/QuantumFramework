Cell["\<\
The squeezed vacuum satisfies the Bogoliubov transformation eigenvalue \
equation\
\>", "Text",
 CellID->191042309,ExpressionUUID->"330dc669-6a46-4a4c-979d-871de0d1a26f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       OverscriptBox["a", "^"], " ", 
       RowBox[{"cosh", "(", "r", ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["e", 
        RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], 
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"], 
       RowBox[{"sinh", "(", "r", ")"}]}]}], ")"}], Cell[
    "|",ExpressionUUID->"8cbb4053-5980-a747-8125-b2bb4510ff1d"], "\[Xi]", 
    Cell["\[RightAngleBracket]",ExpressionUUID->
     "185b2684-c346-ed49-ad94-b37a0272a6cd"]}], "=", "0"}], 
  TraditionalForm]], "DisplayFormula",
 CellID->136073495,ExpressionUUID->"d63ab6d4-1f35-c749-8b8a-d07c3b157ba7"],

Cell[TextData[StyleBox["Define the linear combination of creation and \
annihilation operators:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681632063423157`*^9, 3.968163230455353*^9}},
 CellID->96661693,ExpressionUUID->"6e44b4b4-0e79-bd4a-a0fa-47b92d5031b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"op", " ", "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"a", " ", 
      RowBox[{"Cosh", "[", 
       RowBox[{"Abs", "[", "\[Xi]1", "]"}], "]"}]}], " ", "+", " ", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"Arg", "[", "\[Xi]1", "]"}]}]], " ", 
      SuperscriptBox["a", "\[Dagger]"], 
      RowBox[{"Sinh", "[", 
       RowBox[{"Abs", "[", "\[Xi]1", "]"}], "]"}]}]}], ")"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9681626932472076`*^9, 3.9681626993861313`*^9}},
 CellLabel->"In[76]:=",
 CellID->692149290,ExpressionUUID->"6f9c1ac6-ce0c-f24f-876c-d17a029af208"],

Cell[TextData[StyleBox["Indeed the squeezed state is an eigenstate with \
