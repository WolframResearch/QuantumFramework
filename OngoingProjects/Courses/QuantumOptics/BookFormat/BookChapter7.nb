Cell["\<\
A coherent is said to be the \[OpenCurlyDoubleQuote]most classical\
\[CloseCurlyDoubleQuote] state, and as we have seen in previous chapters it \
has some distinctive properties\
\>", "Text",
 CellID->629512852,ExpressionUUID->"9d37caa6-2972-714e-9ab1-487ff4de3f0b"],

Cell[TextData[{
 " For a coherent state with a complex amplitude \[Alpha] , ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"\[LeftAngleBracket]", 
      SubscriptBox[
       OverscriptBox["X", "^"], "1"], "\[RightAngleBracket]"}], "\[Alpha]"], "=", 
    RowBox[{"Re", "(", "\[Alpha]", ")"}]}], TraditionalForm]], 
  "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{{3.985948146467581*^9, 3.985948168946396*^9}},
  ExpressionUUID->"e4532203-ffea-0f42-8a45-e00aa0732d64"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["and", "Text"], " "}], TraditionalForm]], "CodeText",
  ExpressionUUID->"f92dfd49-769e-154c-aeaf-425c6f694911"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     SubscriptBox[
      OverscriptBox["X", "^"], "2"], "\[RightAngleBracket]"}], "=", 
    RowBox[{"Im", "(", "\[Alpha]", ")"}]}], TraditionalForm]], 
  "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{{3.9859481464685802`*^9, 3.9859481689477863`*^9}},
  ExpressionUUID->"499a67e0-f13f-d64e-acde-8b63f03de9de"],
 ":  "
}], "Text",
