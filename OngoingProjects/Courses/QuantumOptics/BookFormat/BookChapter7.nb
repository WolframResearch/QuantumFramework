Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["\[Rho]", "^"], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
      Cell["|",ExpressionUUID->"d8941502-c3f7-c246-a2ca-64693620c71c"], 
       "\[Alpha]", Cell[
       "\[RightAngleBracket]",ExpressionUUID->
        "4475c869-fb74-ce4c-8a27-defc06d76370"], Cell[
       "\[LeftAngleBracket]",ExpressionUUID->
        "e06871b9-d083-464b-bb99-18904cd02ee5"], "\[Alpha]", Cell[
       "|",ExpressionUUID->"58cdf761-a579-e946-957d-686f3d2dfe97"]}], "+", 
      Cell["|",ExpressionUUID->"d8df517a-800f-8e4d-b615-135fcab8c3ff"], "-", 
      RowBox[{
      "\[Alpha]", Cell[
       "\[RightAngleBracket]",ExpressionUUID->
        "5477ac2d-1d90-1942-be95-50f75a1111e4"], Cell[
       "\[LeftAngleBracket]",ExpressionUUID->
        "c6a87f09-bcb5-314a-8e35-d10785280f07"]}], "-", 
      RowBox[{
      "\[Alpha]", Cell[
       "|",ExpressionUUID->"42e9e3f3-bb15-0341-8a30-d283b2aa38a7"]}]}], 
     ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellID->117090908,ExpressionUUID->"9edd48f5-d0a0-f041-87c1-3b38d16404ab"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[CapitalDelta]", " ", 
        SubscriptBox["X", "1"]}], ")"}], "2"], "\[RightAngleBracket]"}], "=", 
    RowBox[{
     FractionBox["1", "4"], "+", 
     SuperscriptBox["\[Alpha]", "2"]}]}], TraditionalForm]], "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{{3.985948146494192*^9, 3.985948168963091*^9}},
  ExpressionUUID->"4c14cffb-5948-9741-ac6e-680fceb2dadb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[CapitalDelta]", " ", 
        SubscriptBox["X", "2"]}], ")"}], "2"], "\[RightAngleBracket]"}], "=", 
    FractionBox["1", "4"]}], TraditionalForm]], "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{{3.9859481464951916`*^9, 3.985948168963091*^9}},
  ExpressionUUID->"814e74eb-3bfa-444a-ba28-fa00d4de612f"],
 " , so there is clearly not squeezing"
}], "Text",
 CellID->379415320,ExpressionUUID->"0d973916-536c-1a40-9251-21e4df1783e7"],

Cell["  For example for \[Alpha] = 2, define the statistical mixture:", "Text",
 CellChangeTimes->{{3.932493434477167*^9, 3.932493448664701*^9}, {
  3.932494578382174*^9, 3.932494655593179*^9}, {3.934908373101873*^9, 
  3.934908373637039*^9}, {3.934908476448395*^9, 3.934908479535209*^9}, {
  3.934908748393036*^9, 3.934908754476324*^9}, {3.934908796079807*^9, 
  3.934908835394588*^9}, {3.9350635674889145`*^9, 3.9350635732492065`*^9}, {
  3.968169728128847*^9, 3.968169748954666*^9}},
 CellID->207361375,ExpressionUUID->"14f9d788-23ac-4a4d-84db-69b169e28404"],

Cell[BoxData[
 RowBox[{
  RowBox[{"statisticalMixture", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "2"}], 
     RowBox[{
      RowBox[{
       RowBox[{"CoherentState", "[", "]"}], "[", "2.", "]"}], 
      "[", "\"\<MatrixState\>\"", "]"}]}], "+", 
    RowBox[{
     RowBox[{"1", "/", "2"}], 
     RowBox[{
      RowBox[{
       RowBox[{"CoherentState", "[", "]"}], "[", 
       RowBox[{"-", "2."}], "]"}], "[", "\"\<MatrixState\>\"", "]"}]}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[231]:=",
 CellID->44596287,ExpressionUUID->"026923d9-58af-324e-9649-1dccacfd3b7c"],

Cell[TextData[StyleBox["Quadrature variances:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681697762230225`*^9, 3.968169778832144*^9}},
 CellID->13875042,ExpressionUUID->"a3de85f8-6806-7e44-8fd8-116359e19cb8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", " ", "=", 
      RowBox[{"statisticalMixture", "[", "\"\<Operator\>\"", "]"}]}], "}"}], ",",
     " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", "@", "#"}], ")"}], "@", "m"}], "]"}], "-", " ", 
       SuperscriptBox[
        RowBox[{"Tr", "[", 
         RowBox[{"#", "@", "m"}], "]"}], "2"]}], "&"}], " ", "/@", " ", 
     RowBox[{"QuadratureOperators", "[", "]"}]}]}], "]"}], "//", 
  "Chop"}]], "Input",
 CellLabel->"In[232]:=",
 CellID->101285702,ExpressionUUID->"f3fd3d9a-4dc6-814b-b44f-8f134dc3199a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4.249999840658824`", ",", "0.2500000393179524`"}], "}"}]], "Output",
 CellLabel->"Out[232]=",
 CellID->108528439,ExpressionUUID->"eb61c8a7-463e-9b48-a64a-eb47fa8bca0c"]
}, Open  ]],

Cell["\<\
The Wigner quasi-probability distribution can give more insight about the \
contrast of  superpositions and statistical mixtures. The Wigner function for \
the statistical mixture are two gaussian peaks centered at \[PlusMinus] \
\[Alpha] (or scalings of it) . The Wigner function of the even cat state \
shows a behavior that is oscillatory because of the interference of |\[Alpha]\
\[RightAngleBracket] and |-\[Alpha]\[RightAngleBracket], and also presents \
negative values that is a non-classical characteristic. The Wigner functions \
for the odd cat state and Yorke-Stoler are quite similar in behavior to the \
even cat state.\
\>", "Text",
 CellID->246145165,ExpressionUUID->"dcdc0418-3dce-7a4e-8c95-99652110fd65"],

Cell[TextData[StyleBox["Wigner function of even cat state:", "Text"]], \
"CodeText",
 CellChangeTimes->{{3.968170006090105*^9, 3.9681700110356903`*^9}},
 CellID->450282452,ExpressionUUID->"15179872-1d23-f941-9dc2-79a28db9b140"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"wig", " ", "=", " ", 
     RowBox[{"WignerRepresentation", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CatState", "[", "]"}], "[", 
        RowBox[{"2", ",", "0"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "4.5"}], ",", "4.5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "4.5"}], ",", "4.5"}], "}"}]}], "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"wig", "[", 
      RowBox[{"x", ",", "p"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "4.5"}], ",", "4.5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"p", ",", 
       RowBox[{"-", "4.5"}], ",", "4.5"}], "}"}], ",", "\[IndentingNewLine]", 
