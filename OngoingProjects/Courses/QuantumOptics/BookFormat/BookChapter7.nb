  "a5a1ae6d-9361-334e-8f17-9979c1d86303"],
 " =  \[ImaginaryI] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "2"], TraditionalForm]],ExpressionUUID->
  "6896b59b-9805-ce4b-9f01-fb4291489768"],
 ":"
}], "ExerciseNote",
 CellID->74882193,ExpressionUUID->"cef813ee-eb4d-3140-af7a-ccb2bb2c2f5e"],

