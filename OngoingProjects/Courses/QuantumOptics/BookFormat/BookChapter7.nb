Cell["\<\
Normal ordered calculations are more robust numerically in truncated spaces. \
So the matrix elements of the operators in weak and normal ordering can have \
significant differences due to truncation\
\>", "Text",
 CellID->18616172,ExpressionUUID->"ccd72884-7f16-d64c-8da6-d139640113ed"],

Cell["Visualize the difference for \[Xi]=0.2:", "Text",
 CellID->16249685,ExpressionUUID->"5f2c859f-ddbe-e941-b96a-a3b5a2753d97"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixPlot", "[", 
  RowBox[{"Chop", "[", 
