Cell[TextData[StyleBox["Two mode squeeze vacuum definition:", "Text"]], \
"CodeText",
 CellChangeTimes->{{3.9681703746004143`*^9, 3.9681703872552395`*^9}},
 CellID->179412720,ExpressionUUID->"e982cbc1-5a5f-3d46-8700-f132891a60dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"twoModesqueezeVacuum", "[", 
   RowBox[{"\[Xi]_", "?", "NumberQ"}], "]"}], ":=", " ", 
  RowBox[{"MatrixExp", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Xi]", "\[Conjugate]"}], " ", 
       RowBox[{"a1", "[", "\"\<Bend\>\"", "]"}]}], "-", 
      RowBox[{"\[Xi]", " ", 
       RowBox[{
        SuperscriptBox["a1", "\[Dagger]"], "[", "\"\<Bend\>\"", "]"}]}]}], 
     ")"}], ",", 
    RowBox[{"FockState", "[", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[237]:=",
 CellID->331494230,ExpressionUUID->"65e30092-9255-764e-9475-49debca81296"],

Cell["We can define quadrature operators for the two mode field:", "Text",
 CellID->400596428,ExpressionUUID->"6ca4d086-8743-514f-a202-4a20823cdc86"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["X", 
    RowBox[{"1", "  ", "two", " ", "mode"}]], "=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["2", 
      RowBox[{"3", "/", "2"}]]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["a", "^"], "1"], "+", 
      SuperscriptBox[
       SubscriptBox[
        OverscriptBox["a", "^"], "1"], "\[Dagger]"], "+", 
      SubscriptBox[
       OverscriptBox["b", "^"], "1"], "+", 
      SuperscriptBox[
       SubscriptBox[
        OverscriptBox["b", "^"], "1"], "\[Dagger]"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->94979425,ExpressionUUID->"2d4260f4-30b4-5c47-b039-b91f5353b0b8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["X", 
    RowBox[{"2", " ", "two", " ", "mode"}]], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      SuperscriptBox["2", 
       RowBox[{"3", "/", "2"}]], "\[ImaginaryI]"}]], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["a", "^"], "1"], "-", 
      SuperscriptBox[
       SubscriptBox[
        OverscriptBox["a", "^"], "1"], "\[Dagger]"], "+", 
      SubscriptBox[
       OverscriptBox["b", "^"], "1"], "-", 
      SuperscriptBox[
       SubscriptBox[
        OverscriptBox["b", "^"], "1"], "\[Dagger]"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->84324882,ExpressionUUID->"c023e112-8fcc-fa41-831d-803c6906b2d3"],

Cell["Defining them in terms of quantum operators:", "Text",
 CellID->500431583,ExpressionUUID->"a894930b-9a97-3444-bd6f-368d9c214069"],

Cell[BoxData[{
 RowBox[{"twomodeX1", " ", ":=", " ", 
  RowBox[{
   FractionBox["1", 
    SuperscriptBox["2", 
     RowBox[{"3", "/", "2"}]]], 
   RowBox[{"(", 
    RowBox[{"a1", "+", 
     SuperscriptBox["a1", "\[Dagger]"], "+", "b1", "+", 
     SuperscriptBox["b1", "\[Dagger]"]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"twomodeX2", " ", ":=", " ", 
  RowBox[{
   FractionBox["1", 
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{"3", "/", "2"}]], " ", "\[ImaginaryI]"}]], 
   RowBox[{"(", 
    RowBox[{"a1", "-", 
     SuperscriptBox["a1", "\[Dagger]"], "+", "b1", "-", 
     SuperscriptBox["b1", "\[Dagger]"]}], ")"}]}]}]}], "Input",
 CellLabel->"In[246]:=",
 CellID->269845000,ExpressionUUID->"95ba1893-5a82-4741-b3f9-ecf3b7d06411"],

Cell["\<\
Check the commutator is still \[ImaginaryI]/2 for the two mode definition:\
\>", "Text",
 CellID->463694161,ExpressionUUID->"fe3006dd-6cd8-494e-b78f-8f8fd5834575"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BosonicNormalOrder", "[", 
  RowBox[{
   RowBox[{"Commutator", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       SuperscriptBox["2", 
        RowBox[{"3", "/", "2"}]]], 
      RowBox[{"(", 
       RowBox[{"\[FormalA]", "+", 
        SuperscriptBox["\[FormalA]", "\[Dagger]"], "+", "\[FormalB]", "+", 
        SuperscriptBox["\[FormalB]", "\[Dagger]"]}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        SuperscriptBox["2", 
         RowBox[{"3", "/", "2"}]], " ", "\[ImaginaryI]"}]], 
      RowBox[{"(", 
       RowBox[{"\[FormalA]", "-", 
        SuperscriptBox["\[FormalA]", "\[Dagger]"], "+", "\[FormalB]", "-", 
        SuperscriptBox["\[FormalB]", "\[Dagger]"]}], ")"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"FieldVariables", "[", 
    RowBox[{"{", 
     RowBox[{"\[FormalA]", ",", "\[FormalB]"}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[243]:=",
 CellID->81192390,ExpressionUUID->"14fc8a73-60a0-3c42-9bb5-716d627af1fd"],

Cell[BoxData[
 FormBox[
  FractionBox["\[ImaginaryI]", "2"], TraditionalForm]], "Output",
 CellLabel->"Out[243]=",
 CellID->132933743,ExpressionUUID->"c7ded2ec-3800-7a45-84a0-b25a79b456af"]
}, Open  ]],

Cell[TextData[{
 "It holds that  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     SubscriptBox["X", "1"], "\[RightAngleBracket]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      SubscriptBox["X", "2"], "\[RightAngleBracket]"}], " ", "=", " ", 
     "0"}]}], TraditionalForm]],ExpressionUUID->
  "d334bd60-ac41-854a-a251-8f0eb846aa04"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9324725999453506`*^9, 3.9324726337171783`*^9}, 
   3.9681713098547096`*^9, {3.9735994386280727`*^9, 3.9735994756473255`*^9}},
 CellID->149661935,ExpressionUUID->"7d9c6574-eaa1-1b47-a028-74250bdd8320"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Xi]1", " ", "=", " ", 
   RowBox[{"RandomComplex", "[", "]"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"state", " ", "=", " ", 
     RowBox[{"twoModesqueezeVacuum", "[", "\[Xi]1", "]"}]}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["state", "\[Dagger]"], "@", " ", 
        RowBox[{"#", " ", "@", " ", "state"}]}], ")"}], "[", "\"\<Scalar\>\"",
       "]"}], "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"twomodeX1", ",", "twomodeX2"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.932469737904829*^9, 3.932469739715063*^9}, {
  3.9324697703041763`*^9, 3.932469778552975*^9}, {3.9324698244578276`*^9, 
  3.932470031516626*^9}, {3.932480669399046*^9, 3.93248068718996*^9}, {
  3.95402240532477*^9, 3.9540224208606796`*^9}},
 CellLabel->"In[248]:=",
 CellID->726494937,ExpressionUUID->"7a439191-f443-8748-9002-c3dff7a217b5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0"}], "}"}]], "Output",
 CellLabel->"Out[249]=",
 CellID->248253690,ExpressionUUID->"4b9b6936-c7df-2e47-9699-721a5fe7ac43"]
}, Open  ]],

Cell[TextData[{
 "Like the single mode case the variances of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", 
     RowBox[{"1", " "}]], "and", " ", 
    SubscriptBox["X", "2"], " "}], TraditionalForm]],ExpressionUUID->
  "259608df-794e-2c4a-8cab-663634107dd6"],
 "are"
}], "Text",
