Cell[TextData[{
 "A squeezing  ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "4ce049a1-980e-b745-9201-eb895c310d4a"],
 " parameter is defined ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "bb976ac6-3c32-7943-972f-0569a7d24492"],
 "(\[Theta]) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{Cell["4",ExpressionUUID->"ae6091e3-46de-4249-9164-dba457935998"], 
     RowBox[{"\[LeftAngleBracket]", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[CapitalDelta]X", "(", "\[Theta]", ")"}], ")"}], "2"], 
      "\[RightAngleBracket]"}]}], "-", "1"}], TraditionalForm]],
  ExpressionUUID->"7feb69ad-efd4-0141-8f71-436de81df62f"],
 ", squeezing exists if for some angle \[Theta]  -1 \[LessEqual] ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "b25e4cc0-53d0-ae4e-8dd9-1e8b35117cfd"],
 "(\[Theta]) <0:"
}], "Text",
 CellID->723471588,ExpressionUUID->"e78ba46f-ec26-6742-a58c-aa7acd1741dd"],

