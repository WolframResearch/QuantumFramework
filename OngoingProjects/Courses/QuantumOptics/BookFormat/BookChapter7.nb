Cell[BoxData[
 RowBox[{"variances", " ", "=", " ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"Abs", "[", "\[Xi]1", "]"}]}], ",", " ", 
       RowBox[{"\[Theta]1", " ", "=", " ", 
        RowBox[{"Arg", "[", "\[Xi]1", "]"}]}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"OperatorVariance", "[", 
        RowBox[{"squeezevacuum", ",", "#"}], "]"}], "&"}], " ", "/@", " ", 
      RowBox[{"Through", "[", 
       RowBox[{"YOperators", "[", "\[Theta]1", "]"}], "]"}]}]}], "]"}], "//", 
   "Chop"}]}]], "Input",
