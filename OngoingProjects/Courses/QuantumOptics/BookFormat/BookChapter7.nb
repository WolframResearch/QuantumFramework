Cell[TextData[StyleBox["Why one of the variances is not going below 0.25? ",
 FontSize->16,
 FontSlant->"Italic"]], "Question",
 CellChangeTimes->{{3.967913019894806*^9, 3.9679130405560474`*^9}, {
  3.967913224427414*^9, 3.9679132359996986`*^9}},
 CellID->2131901,ExpressionUUID->"e7df4f14-bc06-9f49-9a42-bf4bf2cc021b"],

Cell[TextData[{
 " Using the properties of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["S", "^"], " ", "on", " ", "a", " ", "and", " ", 
    SuperscriptBox["a", "\[Dagger]"]}], TraditionalForm]],ExpressionUUID->
  "fbb7aa3b-e05d-b54e-8f42-9f0c29f8452d"],
 " can be derived that"
}], "Text",
 CellChangeTimes->{{3.9256668051727924`*^9, 3.925666981960554*^9}, {
   3.9309142407590046`*^9, 3.93091427959334*^9}, {3.934845500702589*^9, 
   3.9348455019133663`*^9}, {3.934845596584036*^9, 3.934845600199251*^9}, 
   3.934845632403828*^9, 3.967912002137371*^9, {3.969647973169565*^9, 
   3.9696479808189697`*^9}},
 CellID->50669472,ExpressionUUID->"9409fc2c-b10a-7b4d-8a3e-3d2d0341ef37"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"\[CapitalDelta]", " ", 
      SubscriptBox["X", "1"]}], "\[RightAngleBracket]"}], "2"], "=", 
   RowBox[{
    FractionBox["1", "4"], "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"cosh", "(", "r", ")"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"sinh", "(", "r", ")"}], "2"], "-", 
     RowBox[{"2", 
      RowBox[{"sinh", "(", "r", ")"}], 
      RowBox[{"cosh", "(", "r", ")"}], 
      RowBox[{"cos", "(", "\[Theta]", ")"}]}]}], "]"}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{{3.9859481464758453`*^9, 3.985948168950777*^9}},
 CellID->99399011,ExpressionUUID->"28387c8a-1411-594a-8a33-0aa25a4b92b8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"\[CapitalDelta]", " ", 
      SubscriptBox["X", "2"]}], "\[RightAngleBracket]"}], "2"], "=", 
   RowBox[{
    FractionBox["1", "4"], "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"cosh", "(", "r", ")"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"sinh", "(", "r", ")"}], "2"], "+", 
     RowBox[{"2", 
      RowBox[{"sinh", "(", "r", ")"}], 
      RowBox[{"cosh", "(", "r", ")"}], 
      RowBox[{"cos", "(", "\[Theta]", ")"}]}]}], "]"}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{{3.9859481464758453`*^9, 3.985948168950777*^9}},
 CellID->54359342,ExpressionUUID->"c067f70e-3723-2347-be91-92d3b4d3decd"],

Cell[TextData[StyleBox["Verification:", "Text"]], "CodeText",
 CellChangeTimes->{{3.967912107208132*^9, 3.9679121104982147`*^9}},
 CellID->47079765,ExpressionUUID->"c414494e-6462-e442-b2e4-700486dc461b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "=", 
      RowBox[{"Abs", "[", "\[Xi]1", "]"}]}], ",", 
     RowBox[{"\[Theta]", " ", "=", " ", 
      RowBox[{"Arg", "[", "\[Xi]1", "]"}]}]}], "}"}], ",", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "4"}], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"Cosh", "[", "r", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"Sinh", "[", "r", "]"}], "2"], "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "m"], "2", 
         RowBox[{"Sinh", "[", "r", "]"}], 
         RowBox[{"Cosh", "[", "r", "]"}], 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.925667155092645*^9, 3.92566723378529*^9}, {
  3.9256672692694874`*^9, 3.925667344282465*^9}, {3.925667469658191*^9, 
  3.925667475345693*^9}, {3.925667524097554*^9, 3.9256675632271175`*^9}},
 CellLabel->"In[26]:=",
 CellID->826821658,ExpressionUUID->"fae5917f-e08b-ad49-92a4-4fd760350517"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.26620371674638277`", ",", "0.2976092658568076`"}], 
  "}"}]], "Output",
 CellLabel->"Out[26]=",
 CellID->167973572,ExpressionUUID->"fcfcbb05-6c2e-2740-a670-8072bf36e905"]
}, Open  ]],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Theta]", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "f9cce552-6ad9-6a4d-9f33-06763fb638e6"],
 " the expressions reduce to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"\[CapitalDelta]", " ", 
       SubscriptBox["X", "1"]}], "\[RightAngleBracket]"}], "2"], "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "4"], 
      SuperscriptBox["e", 
       RowBox[{
        RowBox[{"-", "2"}], "r"}]], "  ", "and", " \[VeryThinSpace]", 
      SuperscriptBox[
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{"\[CapitalDelta]", " ", 
         SubscriptBox["X", "2"]}], "\[RightAngleBracket]"}], "2"]}], "=", 
     RowBox[{
      FractionBox["1", "4"], 
      SuperscriptBox["e", 
       RowBox[{"2", "r"}]]}]}]}], TraditionalForm]], "DisplayFormula",
  CellChangeTimes->{{3.985948146476845*^9, 3.9859481689517784`*^9}},
  ExpressionUUID->"cdea1bca-4c8b-6c49-ba60-4213d0644fa8"],
 " .\nFor this case we can clearly see one quadrature gets \
\[OpenCurlyDoubleQuote]squeezed\[CloseCurlyDoubleQuote] while the other \
increases so it maintains the uncertainty principle. For the case (\[Theta] = \
0)  the inequality is saturated ( the product of uncertainties equals 1/16 = \
0.0625). This is different from a coherent state or the vacuum that also \
saturate the inequality, but with the same value of the uncertainties in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", 
     RowBox[{"1", " "}]], "and", " ", 
    SubscriptBox["X", "2"]}], TraditionalForm]],ExpressionUUID->
  "3bd2e7ac-8293-f14c-821b-5b6bbb41cea9"],
 "."
}], "Text",
 CellID->42501048,ExpressionUUID->"696a8942-7ca0-da46-ac70-9e2221b65486"],

Cell[TextData[StyleBox["Set up \[Xi] as a real parameter:", "Text"]], \
"CodeText",
 CellID->51080616,ExpressionUUID->"7de7f395-b3bb-ed4b-8fad-9bd465129a07"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Xi]1", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0.6"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"squeezevacuum", " ", "=", " ", 
   RowBox[{
    RowBox[{"SqueezeOperator", "[", "\[Xi]1", "]"}], "[", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.925662306811941*^9, 3.925662324236477*^9}, {
   3.925662375712618*^9, 3.9256623797314568`*^9}, {3.925662413468864*^9, 
   3.925662413875459*^9}, {3.925662709533499*^9, 3.925662709923681*^9}, {
   3.925662764729845*^9, 3.925662765136097*^9}, {3.925662800221878*^9, 
   3.925662800565613*^9}, {3.925662919347423*^9, 3.925662921222448*^9}, {
   3.925664990976696*^9, 3.925665000465019*^9}, {3.925667860035227*^9, 
   3.925667894569256*^9}, {3.925668245553449*^9, 3.925668246615949*^9}, 
   3.925771080601189*^9, {3.934845785072296*^9, 3.9348457866495304`*^9}, 
   3.9538512587075367`*^9, {3.967912436140934*^9, 3.967912455305813*^9}},
 CellLabel->"In[27]:=",
 CellID->72486944,ExpressionUUID->"e0e9f8d3-e7bc-de4f-a544-43ec5cce5d02"],

Cell[TextData[StyleBox["Calculate the variances, this time we do get one \
below 0.25:", "Text"]], "CodeText",
 CellID->118830030,ExpressionUUID->"598c41c2-b15a-114f-bdac-bd55c8f47cff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"variances", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"OperatorVariance", "[", 
       RowBox[{"squeezevacuum", ",", "#"}], "]"}], "//", "Chop"}], ")"}], 
    "&"}], " ", "/@", " ", 
   RowBox[{"QuadratureOperators", "[", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.925667931869924*^9, 3.925667949013277*^9}, {
  3.934845803543297*^9, 3.934845815877035*^9}, {3.934845854674963*^9, 
  3.934845859503231*^9}},
 CellLabel->"In[29]:=",
 CellID->884466984,ExpressionUUID->"5188963d-81d2-464e-a1d4-05ed842471d9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.12157190182485073`", ",", "0.5140993330841745`"}], 
  "}"}]], "Output",
 CellLabel->"Out[29]=",
 CellID->463939177,ExpressionUUID->"0aa0abbc-7d3d-9644-a113-7cf9a08f7ddf"]
}, Open  ]],

Cell[TextData[StyleBox["That coincide with the exponential expressions:", \
"Text"]], "CodeText",
 CellChangeTimes->{{3.9679132072232075`*^9, 3.967913219921505*^9}},
 CellID->240624884,ExpressionUUID->"dda7ecb4-0d9e-224b-b0f6-0ab5da0f2a31"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"1", "/", "4"}], 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "2"}], "\[Xi]1"}], "]"}], ",", 
    RowBox[{"Exp", "[", 
     RowBox[{"2", "\[Xi]1"}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.925667979203884*^9, 3.925668004410082*^9}, {
