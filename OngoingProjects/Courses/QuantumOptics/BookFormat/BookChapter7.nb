Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"wig", " ", "=", " ", 
     RowBox[{"WignerRepresentation", "[", 
      RowBox[{"statisticalMixture", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "4.5"}], ",", "4.5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "4.5"}], ",", "4.5"}], "}"}]}], "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"wig", "[", 
      RowBox[{"x", ",", "p"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "4.5"}], ",", "4.5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"p", ",", 
       RowBox[{"-", "4.5"}], ",", "4.5"}], "}"}], ",", "\[IndentingNewLine]", 
     InterpretationBox[
      DynamicModuleBox[{Typeset`open = False}, 
       TemplateBox[{"Expression", "SequenceIcon", 
         GridBox[{{
