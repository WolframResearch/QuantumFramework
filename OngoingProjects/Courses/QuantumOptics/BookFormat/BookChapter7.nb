 CellID->597027045,ExpressionUUID->"c0a8b082-fb5a-864d-a0d5-b75eba64ad14"],

Cell[BoxData[
 RowBox[{
  RowBox[{"X\[Theta]", " ", ":=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Theta]"}]]}], "+", 
        RowBox[{
         SuperscriptBox["a", "\[Dagger]"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}]}], ")"}]}], ",", 
     RowBox[{"\"\<Parameters\>\"", "->", "\[Theta]"}]}], "]"}]}], 
  ";"}]], "Input",
