Cell[TextData[{
 "Squeezed states are referred as ",
 StyleBox["non-classical",
  FontWeight->"Bold"],
 " , because according to the ",
 StyleBox["Glauber",
  IgnoreSpellCheck->True],
 "-",
 StyleBox["Sudarshan P function  if one quadrature variance goes below  1/4 \
implies ",
  IgnoreSpellCheck->True],
 Cell[BoxData[
  FormBox["P", TraditionalForm]],ExpressionUUID->
  "2c2086db-0997-d74a-8c17-59322060efab"],
 StyleBox["(\[Alpha]) is negative in at least  some phase space region. It is \
also useful to introduce an angle dependent quadrature operator  ",
  IgnoreSpellCheck->True],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["X", "^"], "(", "\[Theta]", ")"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        OverscriptBox["a", "^"], "  ", 
        SuperscriptBox["e", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Theta]"}]]}], "+", 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["a", "^"], "\[Dagger]"], " ", 
        SuperscriptBox["e", 
         RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"ce23cbac-e896-2e47-bee7-2c50e04741fc"]
}], "Text",
 CellID->919733546,ExpressionUUID->"6beb547b-b853-b44d-819b-905cc2b5e7f0"],

Cell[TextData[StyleBox["Angle dependent quadrature operator:", "Text"]], \
