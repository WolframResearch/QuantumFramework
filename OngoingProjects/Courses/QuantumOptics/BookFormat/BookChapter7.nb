    RowBox[{"(", 
     RowBox[{
      RowBox[{"SqueezeOperator", "[", 
       RowBox[{"0.2", ",", 
        RowBox[{"\"\<Ordering\>\"", "->", "\"\<Weak\>\""}]}], "]"}], "-", 
      RowBox[{"SqueezeOperator", "[", "0.2", "]"}]}], ")"}], 
    "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}]], "Input",
 CellLabel->"In[87]:=",
