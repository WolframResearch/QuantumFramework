Cell[TextData[{
 "The coherent band has constant width, while the squeezed band distorts \
pinching to its narrowest at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "s"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c61d704c-7066-c544-a6cf-d6a9f8342625"],
 " and bulging a quarter turn later, while both centers trace the same \
sinusoid curve"
}], "Text",
 CellID->325147929,ExpressionUUID->"c135847e-05ef-0a47-a118-5c0c2a881cc7"],

Cell[TextData[{
 "The closing calculation fits ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e65a078a-caf6-4947-98c7-00e62df8916d"],
 " and the squeezing angle from the variance curve"
}], "Text",
 CellID->676192194,ExpressionUUID->"35f44bba-cc12-e94f-857b-8fd619979f4c"],

Cell[TextData[{
 "Helper for simulating a measurement of variance ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"V", "(", "\[Theta]", ")"}], ":"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6ccfb515-4da9-3441-b301-ea774857d8ac"]
}], "Text",
 CellID->158969241,ExpressionUUID->"8ea468de-aa85-ba45-ac65-e4bd577da6ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vMeas", "[", 
   RowBox[{"qs_", ",", "amp_", ",", "\[Theta]_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"st", "=", 
      RowBox[{"QuantumTensorProduct", "[", 
       RowBox[{"qs", ",", 
        RowBox[{
         RowBox[{"CoherentState", "[", "]"}], "[", 
         RowBox[{"amp", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{"(", 
             RowBox[{"\[Theta]", "+", 
              FractionBox["\[Pi]", "2"]}], ")"}]}], "]"}]}], "]"}]}], "]"}]}],
      "}"}], ",", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m", "=", 
        RowBox[{"expect", "[", 
         RowBox[{"st", ",", "i34"}], "]"}]}], "}"}], ",", 
      FractionBox[
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"expect", "[", 
          RowBox[{"st", ",", 
           SuperscriptBox["i34", "2"]}], "]"}], "-", 
         SuperscriptBox["m", "2"]}], "]"}], 
       RowBox[{"4", " ", 
        SuperscriptBox["amp", "2"]}]]}], "]"}]}], "]"}]}]], "Input",
 CellID->3528033,ExpressionUUID->"1f2ecbf9-b30c-5642-bd56-3085a70c236a"],

Cell["Mean number of photons of the squeezed state:", "Text",
 CellID->558386327,ExpressionUUID->"30854ded-8ab9-854b-ba3f-1ee5d36b1ae0"],

Cell[BoxData[
 RowBox[{"nbarSq", "=", 
  RowBox[{"Re", "@", 
   RowBox[{"expect", "[", 
    RowBox[{"psiSq", ",", "nOp"}], "]"}]}]}]], "Input",
 CellID->150387533,ExpressionUUID->"9aa7337a-b98e-d744-94e5-1cb942ef9255"],

Cell["\<\
Get the simulated data, comparing the ideal case to the case representing the \
effect of the local-oscillator in the homodyne detection:\
\>", "Text",
 CellID->315780485,ExpressionUUID->"a5d423d1-5782-804d-8276-fd3c1c8e182b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dataIdeal", ",", "dataMeas"}], "}"}], "=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ths", "=", 
        RowBox[{"N", "[", 
         RowBox[{"Subdivide", "[", 
          RowBox[{"0", ",", 
           RowBox[{"2", " ", "\[Pi]"}], ",", "24"}], "]"}], "]"}]}], "}"}], ",", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"t", ",", 
             RowBox[{"quadForm", "[", 
              RowBox[{"covSq", ",", "t"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", 
             RowBox[{"vMeas", "[", 
              RowBox[{"psiSq", ",", "3.", ",", "t"}], "]"}]}], "}"}]}], "}"}],
          ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "ths"}], "}"}]}], "]"}], "]"}]}], "]"}]}], ";"}], 
  "//", "Quiet"}]], "Input",
 CellLabel->"In[148]:=",
 CellID->82407690,ExpressionUUID->"3370ee35-f80d-bd4a-953f-8168fb98c9ea"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "(", "\[Theta]", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "59d2d2a0-3143-d04a-90d9-74702697dff4"],
 " can be represented with the following model, that comes from analytical \
calculations:"
}], "Text",
 CellID->12821004,ExpressionUUID->"970276f9-cf1a-a347-8841-d8315c424127"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"model", "=", 
  RowBox[{
   FractionBox["1", "4"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "r"}], "]"}], " ", 
      SuperscriptBox[
       RowBox[{"Cos", "[", 
        RowBox[{"\[Theta]", "-", 
         FractionBox["\[Theta]0", "2"]}], "]"}], "2"]}], "+", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"2", " ", "r"}], "]"}], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", 
        RowBox[{"\[Theta]", "-", 
         FractionBox["\[Theta]0", "2"]}], "]"}], "2"]}]}], ")"}]}]}]], "Input",
 CellLabel->"In[151]:=",
 CellID->201468118,ExpressionUUID->"9894cb2c-624f-674e-88d8-b3e1f7dd433d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["1", "4"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", " ", "r"}]], " ", 
      RowBox[{
       SuperscriptBox["sin", "2"], "(", 
       RowBox[{"\[Theta]", "-", 
        FractionBox["\[Theta]0", "2"]}], ")"}]}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "r"}]], " ", 
      RowBox[{
       SuperscriptBox["cos", "2"], "(", 
       RowBox[{"\[Theta]", "-", 
        FractionBox["\[Theta]0", "2"]}], ")"}]}]}], ")"}]}], 
  TraditionalForm]], "Output",
 CellLabel->"Out[151]=",
 CellID->162122394,ExpressionUUID->"02877f92-59de-a94e-aa06-0a3155de9058"]
}, Open  ]],

Cell["Fit the data to the model:", "Text",
 CellID->246750943,ExpressionUUID->"4348b27c-6f1c-8e4a-86da-4c8eebd80a16"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fit", " ", "=", 
  RowBox[{
   RowBox[{"NonlinearModelFit", "[", 
    RowBox[{"dataMeas", ",", "model", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", "0.3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]0", ",", "0.2"}], "}"}]}], "}"}], ",", "\[Theta]"}], 
    "]"}], "[", "\"\<BestFitParameters\>\"", "]"}]}]], "Input",
 CellLabel->"In[159]:=",
 CellID->462275249,ExpressionUUID->"ee2f3555-e5df-944b-b12f-4d30a9b5007b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"r", "\[Rule]", "0.5174561522404453`"}], ",", 
   RowBox[{"\[Theta]0", "\[Rule]", "0.7034030773137171`"}]}], "}"}]], "Output",
 CellLabel->"Out[159]=",
 CellID->87158186,ExpressionUUID->"55958498-9409-6e46-8eda-e7f8de96fa6a"]
}, Open  ]],

Cell[TextData[{
 "There is a higher error in the squeezing parameter ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5a8ac551-3339-bb48-92d1-93ff0a79563e"],
 " :"
}], "Text",
 CellID->153201147,ExpressionUUID->"344ec36c-20cc-7f4d-a5a9-d207126d3ebc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PercentForm", "[", 
  FractionBox[
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"AbsArg", "[", "\[Xi]0", "]"}], "-", 
      RowBox[{"{", 
       RowBox[{"r", ",", "\[Theta]0"}], "}"}]}], "/.", " ", "fit"}], "]"}], 
   RowBox[{"AbsArg", "[", "\[Xi]0", "]"}]], "]"}]], "Input",
 CellLabel->"In[183]:=",
 CellID->236280662,ExpressionUUID->"b979be92-1e35-654f-add1-a5b6e4b2d5c5"],

Cell[BoxData[
 TagBox[
  RowBox[{"{", 
   RowBox[{
    InterpretationBox[
     StyleBox["\<\"3.491%\"\>",
      ShowStringCharacters->False],
     0.03491230448089067,
     AutoDelete->True], ",", 
    InterpretationBox[
     StyleBox["\<\"0.4862%\"\>",
      ShowStringCharacters->False],
