Cell["\<\
Mean number of photons has the following analytical expression\
\>", "Text",
 CellID->184586862,ExpressionUUID->"a3be7283-3232-a341-a4ec-3cf9521fa9a7"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       OverscriptBox["n", "^"], "\[RightAngleBracket]"}], "=", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"|", "\[Alpha]", "|"}], "2"], "(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"cosh", "(", "r", ")"}], "2"], "+", 
         SuperscriptBox[
          RowBox[{"sinh", "(", "r", ")"}], "2"]}], ")"}], "-", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          SuperscriptBox["\[Alpha]", "*"], ")"}], "2"], 
        SuperscriptBox["e", 
         RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], " ", 
        RowBox[{"sinh", "(", "r", ")"}], 
        RowBox[{"cosh", "(", "r", ")"}]}]}]}]},
    {
     RowBox[{"-", 
      RowBox[{
       SuperscriptBox["\[Alpha]", "2"], 
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Theta]"}]], 
       RowBox[{"sinh", "(", "r", ")"}], 
       RowBox[{"cosh", "(", "r", ")"}]}], "+", 
      SuperscriptBox[
       RowBox[{"sinh", "(", "r", ")"}], "2"]}]}
   }], TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{{3.9859481464788857`*^9, 3.985948168952778*^9}},
 CellID->179922203,ExpressionUUID->"71be66c8-bc11-0d4e-887a-f3b49d5972a0"],

