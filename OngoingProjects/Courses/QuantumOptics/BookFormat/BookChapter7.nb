Cell[TextData[StyleBox["Mean number of photons from \
QuantumMeasurementOperator:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681535310253143`*^9, 3.9681535390239906`*^9}, {
  3.9681538182610893`*^9, 3.9681538249409695`*^9}},
 CellID->459733036,ExpressionUUID->"e7b735c9-2b39-434e-83d3-56dc2d39fe8e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"QuantumMeasurementOperator", "[", 
     RowBox[{
      SuperscriptBox["a", "\[Dagger]"], "@", "a"}], "]"}], "@", 
    "squeezeCoh"}], ")"}], "[", "\"\<Mean\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.925577265740687*^9, 3.925577322081972*^9}, {
  3.930923257398182*^9, 3.930923261591023*^9}, {3.9348889117985573`*^9, 
  3.9348889151702747`*^9}},
 CellLabel->"In[53]:=",
 CellID->211732748,ExpressionUUID->"b3d982fa-e208-9a49-93bb-d4b5f0f6d562"],

Cell[BoxData["8.016773103057194`"], "Output",
 CellLabel->"Out[53]=",
 CellID->257821935,ExpressionUUID->"42eb9d8f-7b57-544c-8fbb-d006e289c9b7"]
}, Open  ]],

Cell[TextData[StyleBox["Compare with the analytical expression:", "Text"]], \
"CodeText",
 CellID->245215664,ExpressionUUID->"2d9868e7-5dd1-3940-b25b-34efc144b08b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "=", 
      RowBox[{"Abs", "[", "\[Xi]1", "]"}]}], ",", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"Arg", "[", "\[Xi]1", "]"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"Abs", "[", "\[Alpha]coh", "]"}], "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Cosh", "[", "r", "]"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"Sinh", "[", "r", "]"}], "2"]}], ")"}]}], "+", 
    SuperscriptBox[
     RowBox[{"Sinh", "[", "r", "]"}], "2"], "-", 
    RowBox[{"2", " ", 
     RowBox[{"Re", "[", 
      RowBox[{
       SuperscriptBox["\[Alpha]coh", "2"], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Theta]"}], "]"}]}], "]"}], " ", 
     RowBox[{"Cosh", "[", "r", "]"}], " ", 
     RowBox[{"Sinh", "[", "r", "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[54]:=",
 CellID->456602212,ExpressionUUID->"95138673-7761-8c48-9a6a-c63d0eccc644"],

Cell[BoxData["8.016773103069704`"], "Output",
 CellLabel->"Out[54]=",
 CellID->527228515,ExpressionUUID->"79703b34-de39-4245-a3b9-36faa475635f"]
}, Open  ]],

Cell[TextData[{
 "Another state  that is more general than the squeezed vacuum is the \
displaced squeezed state is defined as: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{Cell[TextData[Cell[BoxData[
      FormBox["|", TraditionalForm]],ExpressionUUID->
      "49332c17-b8eb-4047-9316-8087736aae13"]],ExpressionUUID->
      "28a71854-0827-c94d-97bb-2863ae9fad18"], "\[Alpha]"}], ",", " ", 
    RowBox[{"\[Xi]", " ", Cell[TextData[Cell[BoxData[
      FormBox["\[RightAngleBracket]", TraditionalForm]],ExpressionUUID->
      "09ee6e24-ff3f-c848-a0cb-4aebf6e77cd0"]],ExpressionUUID->
      "a2528fab-c363-4346-9cae-3b7424731b4b"]}]}], TraditionalForm]],
  ExpressionUUID->"684ca7de-24c1-bd48-89b9-a8e97de64558"],
 " =  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"D", 
    RowBox[{"(", "\[Alpha]", ")"}], " "}], TraditionalForm]],ExpressionUUID->
  "486fc746-8722-2442-8234-a02b6de3be5d"],
 Cell[BoxData[
  FormBox[
   RowBox[{"S", 
    RowBox[{"(", "\[Xi]", ")"}]}], TraditionalForm]],ExpressionUUID->
  "2a16c434-4b6b-0749-be00-778ce60b8d26"],
 "|0\[RightAngleBracket], is not the same as a squeezed coherent state \
because the displacement operator and the squeeze operator do not commute"
}], "Text",
 CellID->453825832,ExpressionUUID->"cd3dc35d-18d9-934f-a4c6-a01489aa8260"],

Cell["\<\
Clearly the commutator is not 0, plotting the matrix of the resulting \
operator:\
\>", "Text",
 CellChangeTimes->{{3.9257713012535496`*^9, 3.925771311316529*^9}, 
   3.968153284711197*^9, {3.9681548806087494`*^9, 3.9681549049395275`*^9}, {
   3.9696484533452244`*^9, 3.9696484614992695`*^9}},
 CellID->129642613,ExpressionUUID->"a62ea7ea-4405-c547-a38c-5bd6058c5715"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Commutator", "[", 
    RowBox[{
     RowBox[{"SqueezeOperator", "[", "\[Xi]1", "]"}], ",", 
     RowBox[{"DisplacementOperator", "[", "\[Alpha]coh", "]"}]}], "]"}], 
   "[", "\"\<Matrix\>\"", "]"}], "//", "MatrixPlot"}]], "Input",
 CellLabel->"In[55]:=",
 CellID->393196838,ExpressionUUID->"32f834ab-bf4c-214e-9131-0e321c43bca2"],

