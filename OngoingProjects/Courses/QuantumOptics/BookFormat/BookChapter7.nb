Cell["Photo-current curve:", "Text",
 CellID->118698579,ExpressionUUID->"0ccd798c-5bb1-034b-8a59-6cdcf4022073"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"curve", "[", "qs_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Re", "@", 
       RowBox[{"Chop", "@", 
        RowBox[{"expect", "[", 
         RowBox[{
          RowBox[{"QuantumTensorProduct", "[", 
           RowBox[{"qs", ",", 
            RowBox[{
             RowBox[{"CoherentState", "[", "]"}], "[", 
             RowBox[{"3.", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"I", " ", "\[Phi]"}], "]"}]}], "]"}]}], "]"}], ",", 
          "i34"}], "]"}]}]}], "/", 
      RowBox[{"(", 
       RowBox[{"2", "*", "3."}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", "phis"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[31]:=",
 CellID->288167260,ExpressionUUID->"8faa4597-f9fa-b54e-9ad9-132743f5781f"],

