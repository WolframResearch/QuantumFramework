Cell["\<\
Since we are working in a truncated Fock space size, some calculations can \
work better numerically in a particular operator ordering:\
\>", "Text",
 CellID->8266319,ExpressionUUID->"4769fd58-e40b-7e40-8798-3a58473c899c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SqueezeOperator", "[", 
   RowBox[{"0.3", ",", 
    RowBox[{"\"\<Ordering\>\"", "->", "\"\<Weak\>\""}]}], "]"}], 
  "[", "\"\<UnitaryQ\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.967911279797817*^9, 3.9679112885392857`*^9}, {
  3.96791156734585*^9, 3.9679116204524307`*^9}},
 CellLabel->"In[213]:=",
 CellID->111524159,ExpressionUUID->"13dc8c49-0823-5d48-9e0f-ee35ee568c9d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[213]=",
 CellID->56775750,ExpressionUUID->"ceff89ac-2b11-b94d-b5d7-a75368336942"]
}, Open  ]],

Cell["Using Baker-Hausdorff formula we can get the relations", "Text",
 CellID->133681266,ExpressionUUID->"ae0e7ea6-4670-2540-82c0-5b8edff6dc97"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     OverscriptBox["S", "^"], "\[Dagger]"], "(", "\[Xi]", ")"}], " ", 
   OverscriptBox["a", "^"], " ", 
   RowBox[{
    OverscriptBox["S", "^"], "(", "\[Xi]", ")"}], "=", 
   RowBox[{
    RowBox[{
     OverscriptBox["a", "^"], " ", 
     RowBox[{"cosh", "(", "r", ")"}]}], "-", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox["a", "^"], "\[Dagger]"], " ", 
     SuperscriptBox["e", 
      RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], " ", 
     RowBox[{"sinh", "(", "r", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{{3.9859481464718723`*^9, 3.9859481689497795`*^9}},
 CellID->115599685,ExpressionUUID->"7fdcfbe4-47cb-6848-a4a4-5863e277e98b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     OverscriptBox["S", "^"], "\[Dagger]"], "(", "\[Xi]", ")"}], " ", 
   SuperscriptBox[
    OverscriptBox["a", "^"], "\[Dagger]"], " ", 
   RowBox[{
    OverscriptBox["S", "^"], "(", "\[Xi]", ")"}], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      OverscriptBox["a", "^"], "\[Dagger]"], " ", 
     RowBox[{"cosh", "(", "r", ")"}]}], "-", 
    RowBox[{
     OverscriptBox["a", "^"], 
     SuperscriptBox["e", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Theta]"}]], " ", 
     RowBox[{"sinh", "(", "r", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{{3.9859481464738503`*^9, 3.9859481689497795`*^9}},
 CellID->420664122,ExpressionUUID->"81edf511-6d62-2d4e-9d48-c255165d77a5"],

Cell["Represent the squeeze operator as a symbolic expression:", "Text",
 CellID->141663350,ExpressionUUID->"9cc8f741-8535-c640-95d1-c0e02db3bf99"],

Cell[BoxData[
 RowBox[{
  RowBox[{"S", "[", "z_", "]"}], ":=", 
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"Conjugate", "[", "z", "]"}], " ", 
     RowBox[{"\[FormalA]", "**", "\[FormalA]"}]}], "-", 
    RowBox[{
     FractionBox["1", "2"], " ", "z", " ", 
     RowBox[{
      SuperscriptBox["\[FormalA]", "\[Dagger]"], "**", 
      SuperscriptBox["\[FormalA]", "\[Dagger]"]}]}]}], "]"}]}]], "Input",
 CellLabel->"In[11]:=",
 CellID->39279340,ExpressionUUID->"a85c50f3-2978-3648-89b6-6725f4c96a45"],

Cell[TextData[{
 "Verify the relations, note that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["S", "\[Dagger]"], "(", 
     RowBox[{"r", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}], ")"}], "=", 
    RowBox[{"S", "(", 
     RowBox[{
      RowBox[{"-", "r"}], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"fe6a4f43-615e-1f4c-a4ec-1e46c8e2e074"],
 ":"
}], "Text",
 CellID->654942040,ExpressionUUID->"e50735ec-57a9-b94e-898b-2e6832f3e64b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BosonicExpSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"S", "[", 
     RowBox[{
      RowBox[{"-", "r"}], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}], "]"}], "**", 
    "\[FormalA]", "**", 
    RowBox[{"S", "[", 
     RowBox[{"r", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}], "]"}]}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{
     RowBox[{"r", ">", "0"}], "&&", 
     RowBox[{"\[Theta]", "\[Element]", 
      TemplateBox[{},
       "Reals"]}]}]}]}], "]"}]], "Input",
 CellLabel->"In[14]:=",
 CellID->174312600,ExpressionUUID->"fc0d2172-263e-0a46-968a-5874246cb73a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[FormalA]", " ", 
    RowBox[{"cosh", "(", "r", ")"}]}], "-", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], " ", 
    SuperscriptBox["\[FormalA]", "\[Dagger]"], " ", 
    RowBox[{"sinh", "(", "r", ")"}]}]}], TraditionalForm]], "Output",
 CellLabel->"Out[14]=",
 CellID->294322207,ExpressionUUID->"1e466cd8-2cd7-764d-a8db-9f12542d3ee4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BosonicExpSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"S", "[", 
     RowBox[{
      RowBox[{"-", "r"}], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}], "]"}], "**", 
    SuperscriptBox["\[FormalA]", "\[Dagger]"], " ", "**", " ", 
    RowBox[{"S", "[", 
     RowBox[{"r", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}], "]"}]}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{
     RowBox[{"r", ">", "0"}], "&&", 
     RowBox[{"\[Theta]", "\[Element]", 
      TemplateBox[{},
       "Reals"]}]}]}]}], "]"}]], "Input",
 CellLabel->"In[15]:=",
 CellID->317936974,ExpressionUUID->"9be819a6-7007-1a49-bc36-807b9239f47c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[FormalA]", "\[Dagger]"], " ", 
    RowBox[{"cosh", "(", "r", ")"}]}], "-", 
   RowBox[{"\[FormalA]", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Theta]"}]], " ", 
    RowBox[{"sinh", "(", "r", ")"}]}]}], TraditionalForm]], "Output",
 CellLabel->"Out[15]=",
 CellID->178540511,ExpressionUUID->"8c5691ab-f986-534a-9342-c81b3eb9a472"]
}, Open  ]],

Cell[TextData[{
 "However, in the truncated implementation these do not hold exactly because \
they rely on the commutator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{"a", ",", 
      SuperscriptBox["a", "\[Dagger]"]}], "]"}], " ", "=", "1"}], 
   TraditionalForm]],ExpressionUUID->"7c5ee4d1-0460-204d-8265-26286678d9be"],
 Cell[BoxData[
  FormBox[
  Cell[" ",ExpressionUUID->"8e9ab96e-82b1-6543-bfe4-97465f25a77e"], 
   TraditionalForm]],ExpressionUUID->"53b1de41-6b77-5f47-8048-5edca83beef0"],
 " , that is not exact in a truncated Fock space.\nSqueeze operator is very \
sensitive to numerical error because it has second order terms in the \
annihilation and creation operators. The Fock space size has to scale  to \
larger sizes compared to displacement operator to get accurate numeric results"
}], "Text",
 CellID->178671984,ExpressionUUID->"8f2014d5-5c13-b442-a9ac-e81388a89642"],

Cell[TextData[{
 "Create a squeezed vacuum state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
    Cell["|",ExpressionUUID->"8cf691e5-0da9-5042-8eae-7c0bf7660af0"], "\[Xi]",
      Cell["\[RightAngleBracket]",ExpressionUUID->
      "4efd96d2-fe8f-d145-bde6-acd33390670e"]}], "=", 
    RowBox[{
     RowBox[{"S", "(", "\[Xi]", ")"}], Cell[
     "|",ExpressionUUID->"8eee50f8-cc88-2d46-a5f3-056167d668e0"], "0", Cell[
     "\[RightAngleBracket]",ExpressionUUID->
      "07201583-571f-d941-897c-303a3e147d26"]}]}], TraditionalForm]], 
  "DisplayFormula",
  CellChangeTimes->{{3.985948146474846*^9, 3.9859481689497795`*^9}},
  ExpressionUUID->"b231639d-5fe8-ac4d-8c93-deae3a56d4c4"],
 ":"
}], "Text",
 CellID->914275750,ExpressionUUID->"bd847388-755a-9542-bbe6-e054518aea59"],

