Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"expect", "[", 
       RowBox[{"#", ",", "nOp"}], "]"}], "&"}], "/@", 
     RowBox[{"{", 
      RowBox[{"psiCoh", ",", "psiSq"}], "}"}]}], "]"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"Re", "@", 
      RowBox[{"Chop", "@", 
       RowBox[{"OperatorVariance", "[", 
        RowBox[{"#", ",", 
         RowBox[{"X", "[", "0", "]"}]}], "]"}]}]}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{"psiCoh", ",", "psiSq"}], "}"}]}]}], "}"}]], "Input",
 CellLabel->"In[36]:=",
 CellID->149969148,ExpressionUUID->"5e914f06-61f6-9e47-aa94-90b3f5eb443a"],

