Cell["Analytical Fock basis expansion:", "Text",
 CellChangeTimes->{{3.9538553479046555`*^9, 3.953855354718483*^9}, {
  3.9681561824432087`*^9, 3.9681561883477383`*^9}},
 CellID->22124711,ExpressionUUID->"047283b3-e7fc-0e42-b851-771b87069fe3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"amps", " ", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", " ", "=", " ", 
       RowBox[{"AbsArg", "[", "\[Xi]1", "]"}]}], "}"}], ",", " ", 
     RowBox[{
      FractionBox["1", 
       SqrtBox[
        RowBox[{"Cosh", "[", 
         RowBox[{"vals", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]]], 
      RowBox[{"Table", "[", 
       RowBox[{
        FormBox[
         FractionBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "m"], " ", 
           SqrtBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"2", " ", "m"}], ")"}], "!"}]], " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"\[ImaginaryI]", " ", "m", " ", 
             RowBox[{
             "vals", "\[LeftDoubleBracket]", "2", 
              "\[RightDoubleBracket]"}]}]], " ", 
           RowBox[{
            SuperscriptBox["tanh", "m"], "(", 
            RowBox[{
            "vals", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
            ")"}]}], 
          RowBox[{
           SuperscriptBox["2", "m"], " ", 
           RowBox[{"m", "!"}]}]],
         TraditionalForm], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "0", ",", 
          RowBox[{"Ceiling", "[", 
           RowBox[{
            RowBox[{"$FockSize", "/", "2"}], "-", "1"}], "]"}]}], "}"}]}], 
       "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[74]:=",
 CellID->312732081,ExpressionUUID->"7e4f3c2b-65f2-e549-9945-41699553edf0"],

Cell[TextData[StyleBox["Check amplitudes equality:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681561099261475`*^9, 3.9681561167734184`*^9}, {
  3.9681562381928596`*^9, 3.9681562467949276`*^9}},
