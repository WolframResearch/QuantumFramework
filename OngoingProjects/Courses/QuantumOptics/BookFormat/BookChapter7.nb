Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"states025", ",", "states2"}], "}"}], "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", "=", 
         RowBox[{
          RowBox[{"CatState", "[", "]"}], "[", 
          RowBox[{"\[Alpha]", ",", 
           RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", 
         RowBox[{
          RowBox[{
           SuperscriptBox["a", "\[Dagger]"], "[", "s", "]"}], 
          "[", "\"\<Normalize\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{
           SuperscriptBox[
            SuperscriptBox["a", "\[Dagger]"], "2"], "[", "s", "]"}], 
          "[", "\"\<Normalize\>\"", "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", 
       RowBox[{"{", 
        RowBox[{"0.25", ",", "2."}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}]], "ExerciseInput",
 CellLabel->"In[339]:=",
 CellID->155314466,ExpressionUUID->"bee1328d-5598-5b43-8727-4968b5508291"],

