Cell["We would get a very similar plot using the Wigner function:", "Text",
 CellID->873976859,ExpressionUUID->"3b307c13-b7cc-984b-8def-489c99bdb42c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wigner", " ", "=", " ", 
   RowBox[{"WignerRepresentation", "[", 
    RowBox[{"dispSqueezed", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"\"\<GridSize\>\"", "->", "50"}], ",", 
     RowBox[{"\"\<GaussianScaling\>\"", "->", "2"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[65]:=",
 CellID->760859010,ExpressionUUID->"8aef0883-265d-eb4e-9585-046f8e41d2a7"],

Cell["Plot the function:", "Text",
 CellID->235859195,ExpressionUUID->"828e0bad-fd96-964c-a2f7-b217c6e23f6d"],

