Cell[TextData[{
 "If we consider a metric of entanglement like the \[OpenCurlyDoubleQuote]",
 StyleBox["Concurrence\[CloseCurlyDoubleQuote], ",
  FontSlant->"Italic"],
 "we can observe that the measure of entanglement increases with increasing ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "bb7ceff7-d615-c14b-a532-c9c41af48636"],
 ":"
}], "Text",
 CellID->217158854,ExpressionUUID->"4374969a-9864-ac4b-91a1-34437220c3ab"],

Cell[TextData[{
 StyleBox["Compute a list of entanglement monotones varying ", "Text"],
 StyleBox[Cell[BoxData[
  FormBox["r", TraditionalForm]], "Text",ExpressionUUID->
  "1d3a0d1f-c2c1-d444-abbc-6f42579057d1"], "Text"],
 StyleBox[":", "Text"]
}], "CodeText",
 CellChangeTimes->{{3.9681719422598457`*^9, 3.9681719592740517`*^9}},
 CellID->496742417,ExpressionUUID->"16007a25-8db3-d14f-af04-18cec3fe8e16"],

Cell[BoxData[
 RowBox[{
  RowBox[{"entanglementEntropies", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", ",", 
       RowBox[{"QuantumEntanglementMonotone", "[", 
        RowBox[{
         RowBox[{"twoModesqueezeVacuum", "[", "r", "]"}], 
         ",", "\"\<Concurrence\>\""}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0.", ",", "1.5", ",", "0.05"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[260]:=",
 CellID->490278798,ExpressionUUID->"e4955c6a-53ca-e549-a04e-0f7b74be5340"],

Cell[TextData[StyleBox["Plot the curve, we see the monotonically increase in \
entanglement:", "Text"]], "CodeText",
 CellID->591896815,ExpressionUUID->"583a230c-65d0-bb4d-8c96-e48b002a4774"],

