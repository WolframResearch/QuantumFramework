Cell[TextData[{
 "If two operators ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["A", "^"], TraditionalForm]],ExpressionUUID->
  "2b1b4e46-00d9-e046-9ac2-863288ef54c5"],
 " and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["B", "^"], TraditionalForm]],ExpressionUUID->
  "ec5aa63e-d23a-e54d-b5e4-eac9dabea5c5"],
 " follow the commutation relation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      OverscriptBox["A", "^"], ",", 
      OverscriptBox["B", "^"]}], "]"}], "=", 
    RowBox[{"\[ImaginaryI]", " ", 
     OverscriptBox["C", "^"]}]}], TraditionalForm]], "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{3.9859476374274044`*^9, 3.985947736621456*^9},
  ExpressionUUID->"d170bfb4-4ebe-2b42-9843-3fbe99f546d0"],
 ", it is a well known fact that "
}], "Text",
 CellID->236306259,ExpressionUUID->"1f949c09-ea1a-ae42-bb28-f8b8b3fe831a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[CapitalDelta]", " ", 
        OverscriptBox["A", "^"]}], ")"}], "2"], "\[RightAngleBracket]"}], 
    RowBox[{"\[LeftAngleBracket]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[CapitalDelta]", " ", 
        OverscriptBox["B", "^"]}], ")"}], "2"], "\[RightAngleBracket]"}]}], "\[GreaterEqual]", 
   RowBox[{
    FractionBox["1", "4"], 
    SuperscriptBox[
     RowBox[{"|", 
      RowBox[{"\[LeftAngleBracket]", 
       OverscriptBox["C", "^"], "\[RightAngleBracket]"}], "|"}], "2"]}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.985947637428419*^9, 3.985947736621456*^9},
 CellID->257706550,ExpressionUUID->"0165d98c-6f52-9a4e-a50c-f7c4f3158742"],

