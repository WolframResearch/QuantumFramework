Cell[TextData[{
 StyleBox["Consider the operators defined as \[LineSeparator]",
  FontWeight->"Plain"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "1"], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"c7b36aa8-d84c-de43-8c5f-85b2be131140"],
 StyleBox[" = 1/2 (",
  FontWeight->"Plain"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SuperscriptBox["a", "\[Dagger]"], "2"], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"5f98dbb1-3f12-d34b-b4d3-8b68592030d0"],
 StyleBox["+",
  FontWeight->"Plain"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "2"], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"997cb5b6-2927-9041-ae41-59f1656129d0"],
 StyleBox[") ,  ",
  FontWeight->"Plain"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["K", "2"], "=", 
    RowBox[{
     RowBox[{"1", "/", "2"}], "\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        SuperscriptBox["a", "\[Dagger]"], "2"], "-", 
       SuperscriptBox["a", "2"]}], ")"}]}]}], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"21965d10-e3db-e64c-a42e-870913551e6a"],
 StyleBox[",  ",
  FontWeight->"Plain"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "3"], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"aae549d3-e5ab-1f4b-8ea5-122798ccd21b"],
 StyleBox[" = 1/2 (",
  FontWeight->"Plain"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["a", "\[Dagger]"], "a"}], "+", 
     RowBox[{"1", "/", "2"}]}], ")"}], TraditionalForm]],
  FontWeight->"Plain",ExpressionUUID->"2795e8bb-bc65-894b-83aa-1c3b248a1ca1"],
 StyleBox["\nThe first two are sometimes referred to as the quadratures of \
the square of the field. Show that these operators form a closed set under \
commutation,that is, the commutator of any two yields the third (up to \
proportionality constant). Obtain the uncertainty product for the operators \
K1 and K2 and use the coherent states |\[Alpha]\[RightAngleBracket]\.04 to \
see if they equalize this product.",
  FontWeight->"Plain"]
}], "Exercise",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 FontWeight->"Bold",
 CellID->4144461,ExpressionUUID->"3bf58aca-75fe-0c4f-b34d-f8112c49474b"],

Cell[CellGroupData[{

Cell["Solution", "ExerciseSolution",
 CellID->356729712,ExpressionUUID->"973d4922-dd25-f04e-ad2f-4b254c0baa4d"],

Cell["Define the operators: ", "SolutionAnswer",
 CellID->836132642,ExpressionUUID->"9fcc8066-d278-8144-bf8b-b0d20566c266"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"K1", " ", "=", " ", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[FormalA]", "\[Dagger]"], "**", 
       SuperscriptBox["\[FormalA]", "\[Dagger]"]}], "+", 
      RowBox[{"\[FormalA]", "**", "\[FormalA]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"K2", " ", "=", " ", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "\[ImaginaryI]"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[FormalA]", "\[Dagger]"], "**", 
       SuperscriptBox["\[FormalA]", "\[Dagger]"]}], "-", 
      RowBox[{"\[FormalA]", "**", "\[FormalA]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"K3", " ", "=", " ", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[FormalA]", "\[Dagger]"], "**", "\[FormalA]"}], "+", 
      RowBox[{"1", "/", "2"}]}], ")"}]}]}], ";"}]}], "ExerciseInput",
 CellLabel->"In[274]:=",
 CellID->3164009,ExpressionUUID->"b37295e7-905b-9444-95ea-9a1f450aa810"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Define the variables and the commutation relation:", "ExerciseNote",
 CellID->176868616,ExpressionUUID->"6e421236-ce5b-7c40-8cb4-a7151021007b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"vars", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"\[FormalA]", ",", 
     SuperscriptBox["\[FormalA]", "\[Dagger]"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"commRel", " ", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Commutator", "[", 
      RowBox[{"\[FormalA]", ",", 
       SuperscriptBox["\[FormalA]", "\[Dagger]"]}], "]"}], "-", "1"}], 
    "}"}]}], ";"}]}], "ExerciseInput",
 CellLabel->"In[277]:=",
 CellID->22927731,ExpressionUUID->"c3fb2268-efc6-354b-a9b6-be8676ab8f00"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 " Show ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     SubscriptBox["K", "1"], ",", 
     SubscriptBox["K", "2"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "5e86fee3-6675-5b45-8803-b29ad87abe8a"],
 " = -4 \[ImaginaryI] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "3"], TraditionalForm]],ExpressionUUID->
  "e3da28a1-346b-3f46-af01-662f6e9ff9d9"],
 ":"
}], "ExerciseNote",
 CellID->545173854,ExpressionUUID->"4c116a9d-ae10-8f44-90b8-ccb3d0c5418f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"NonCommutativePolynomialReduce", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Commutator", "[", 
      RowBox[{"K1", ",", "K2"}], "]"}], "+", 
     RowBox[{"4", "\[ImaginaryI]", " ", "K3"}]}], ",", "commRel", ",", 
    "vars"}], "]"}], "[", 
  RowBox[{"[", 
   RowBox[{"-", "1"}], "]"}], "]"}]], "ExerciseInput",
 CellLabel->"In[279]:=",
