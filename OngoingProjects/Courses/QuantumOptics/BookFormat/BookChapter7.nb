Cell["\<\
Photon adding modifies the phase-space structure and the parity, an odd \
number of added photons produces a phase shift of \[Pi] respect to the \
original state. When \[Alpha] increases we can also see its effect on the \
interference fringes of the Wigner function\
\>", "SolutionAnswer",
 CellID->917412346,ExpressionUUID->"8ee70276-c685-064d-8bb4-bc29e47c6bf5"],

Cell[TextData[{
 "Of course the Wigner functions of the photon added states for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c60fbc47-7a81-d540-9d02-a7090db96096"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3044ed2d-45c2-2a4e-a918-3d38d3472bcc"],
 " have to be orthogonal (up to numerical and truncation errors):"
}], "SolutionAnswer",
 CellID->290931509,ExpressionUUID->"83805886-ad89-6e4b-bd62-9f53f70602e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NIntegrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"wigFuncs", "[", 
      RowBox[{"[", "5", "]"}], "]"}], "[", 
     RowBox[{"x", ",", "p"}], "]"}], 
    RowBox[{
     RowBox[{"wigFuncs", "[", 
      RowBox[{"[", "6", "]"}], "]"}], "[", 
     RowBox[{"x", ",", "p"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"p", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
   RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}]}], 
  "]"}]], "ExerciseInput",
 CellLabel->"In[362]:=",
 CellID->139401936,ExpressionUUID->"fd272a65-0862-0145-9f88-c28cc1e1dbab"],

Cell[BoxData["0.0005573551931579929`"], "ExerciseOutput",
 CellLabel->"Out[362]=",
 CellID->439008381,ExpressionUUID->"b95ce343-577e-cf43-9359-838d750cd27d"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

