Cell["\<\
That does not mean that we do not have matrix elements with good accuracy in \
both cases, for example when applying to the vacuum:\
\>", "Text",
 CellID->187296318,ExpressionUUID->"aa271199-8ebc-de4a-ad1e-a8a07b80b69f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"state", " ", "=", 
     RowBox[{
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"HI", "[", 
         RowBox[{
          RowBox[{"2", "\[Omega]"}], ",", "\[Omega]", ",", "1"}], "]"}], 
        RowBox[{"0.5", "/", "h"}]}], "]"}], "[", "]"}]}], "}"}], ",", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"QuantumSimilarity", "[", 
      RowBox[{"state", ",", 
       RowBox[{
        RowBox[{"SqueezeOperator", "[", 
         RowBox[{
          RowBox[{"2", " ", "0.5"}], ",", 
          RowBox[{"\"\<Ordering\>\"", "->", "ord"}]}], "]"}], "[", "]"}]}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ord", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Normal\>\"", ",", "\"\<Weak\>\""}], "}"}]}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[88]:=",
 CellID->5708953,ExpressionUUID->"c7323c54-6e79-9045-a8a1-b741fcc2b62b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.9999972872953211`", ",", "1.0000000000000002`"}], 
  "}"}]], "Output",
 CellLabel->"Out[88]=",
 CellID->45828853,ExpressionUUID->"fd8d81b8-d9ca-364c-9019-c452f94da4cf"]
}, Open  ]]
}, Open  ]],

