}, Open  ]],

Cell["\<\
The curves coincide while the photon numbers differ by 64% and the quadrature \
variances by a third. The mean photo-current cannot see squeezing at all , it \
sees one complex number and the displaced squeezed signal keeps its squeezing \
entirely in moments the mean discards. That is why the measurement has to go \
to second order moments.\
\>", "Text",
 CellID->163307805,ExpressionUUID->"2c577994-be73-284b-8ed8-9f2e9ce97206"],

Cell["\<\
The reference is the coherent state, whose covariance matrix is isotropic, \
but that changes with the squeezing:\
\>", "Text",
 CellID->332558273,ExpressionUUID->"27dd8bed-b8a4-3140-b256-41960376e53d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"covCoh", ",", "covSq"}], "}"}], " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Chop", "@", 
     RowBox[{"CovarianceMatrix", "[", 
      RowBox[{"#", ",", 
       RowBox[{"\"\<QuadratureScaling\>\"", "->", 
        RowBox[{"1", "/", "2"}]}]}], "]"}]}], "&"}], "/@", 
   RowBox[{"{", 
    RowBox[{"psiCoh", ",", "psiSq"}], "}"}]}]}]], "Input",
 CellLabel->"In[40]:=",
 CellID->343293000,ExpressionUUID->"1cf1f870-bb3a-5d4b-b1c1-8b054ece7d0a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.25000000000000006`", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0.25`"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.1610592958424431`", ",", 
       RowBox[{"-", "0.18927134875174603`"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.18927134875174603`"}], ",", "0.6104810215646141`"}], 
      "}"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[40]=",
 CellID->374599337,ExpressionUUID->"4b9565fb-337b-704b-9fed-a99bee1a0081"]
}, Open  ]],

Cell["\<\
The squeezed signal breaks the isotropy, and its variance curve can be \
computed as a quadratic form that depends on the covariance matrix\
\>", "Text",
 CellID->930722323,ExpressionUUID->"00dd3986-a3d9-cb45-98cb-30a788cb6656"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"V", 
     RowBox[{"(", "\[Theta]", ")"}]}], "=", " ", 
    RowBox[{
     SuperscriptBox["u", "T"], 
     RowBox[{"(", "\[Theta]", ")"}], " ", "\[Sigma]", "  ", "u", 
     RowBox[{"(", "\[Theta]", ")"}]}]}], ",", "   ", 
   RowBox[{
    RowBox[{"u", 
     RowBox[{"(", "\[Theta]", ")"}]}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"cos", 
       RowBox[{"(", "\[Theta]", ")"}]}], ",", " ", 
      RowBox[{"sin", 
       RowBox[{"(", "\[Theta]", ")"}]}]}], "}"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->439248635,ExpressionUUID->"559b3273-7dae-5b4b-9fb5-377e8d7c307b"],

Cell["Check the claim:", "Text",
 CellID->166216455,ExpressionUUID->"f36ba384-e526-b345-9d89-14499706cbb1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"quadForm", "[", 
    RowBox[{"s_", ",", "t_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", "t", "]"}], ",", 
      RowBox[{"Sin", "[", "t", "]"}]}], "}"}], ".", "s", ".", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", "t", "]"}], ",", 
      RowBox[{"Sin", "[", "t", "]"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t", ",", 
      RowBox[{"Re", "@", 
       RowBox[{"Chop", "@", 
        RowBox[{"OperatorVariance", "[", 
         RowBox[{"psiSq", ",", 
          RowBox[{"X", "[", "t", "]"}]}], "]"}]}]}], ",", 
      RowBox[{"quadForm", "[", 
       RowBox[{"covSq", ",", "t"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "\[Pi]", ",", 
      RowBox[{"\[Pi]", "/", "6"}]}], "}"}]}], "]"}], "//", 
  "Column"}]}], "Input",
 CellLabel->"In[41]:=",
 CellID->125534883,ExpressionUUID->"f2e6744b-7d4f-a84d-b8b8-e0d6414eaa07"],

