Cell[TextData[{
 "There is also the concept of amplitude or number squeezing that comes from \
the uncertainty relation [",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", ",", "\[CurlyPhi]"}], TraditionalForm]],ExpressionUUID->
  "15b86401-2037-484d-8482-762d319da55b"],
 "] = \[ImaginaryI], a simple quantity that gives information about the \
photon statistics is the Mandel Q-parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "=", 
    FractionBox[
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       SuperscriptBox[
        RowBox[{"(", "\[CapitalDelta]n", ")"}], "2"], 
       "\[RightAngleBracket]"}], "-", 
      RowBox[{"\[LeftAngleBracket]", "n", "\[RightAngleBracket]"}]}], 
     RowBox[{"\[LeftAngleBracket]", "n", "\[RightAngleBracket]"}]]}], 
   TraditionalForm]],ExpressionUUID->"7a13ee58-a52f-a144-a923-5aea91cff9f1"],
 ". For a state with -1 \[LessEqual] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "<", "0"}], TraditionalForm]],ExpressionUUID->
  "72a15a31-69e2-d74c-80a2-86bd86850984"],
 " the statistics are sub-Poissonian, if ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],ExpressionUUID->
  "b4625ca1-3841-2740-8972-c73e2f792aee"],
 " > 0 super-Poissonian and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "088e764f-766d-fd42-90e1-e4ad7aada47d"],
 " corresponds to Poissonian statistics"
}], "Text",
 CellID->566801525,ExpressionUUID->"e1f310a5-f0e5-d744-b578-4bcc850da3e7"],

Cell[TextData[{
 "The ",
 StyleBox["Mandel",
  IgnoreSpellCheck->True],
 " Q-parameter for even cat state is > 0 so has super-",
 StyleBox["Poissonian statistics",
  IgnoreSpellCheck->True],
 " for all \[Alpha], for the odd cat state is < 0 for all \[Alpha]  showing \
sub-",
 StyleBox["Poissonian",
  IgnoreSpellCheck->True],
 " statistics. For the Yurke-Stoler state  obviously Q = 0 because its photon \
distribution is the same as coherent state, when |\[Alpha]| is large  Q \
\[Rule] 0 for both even and odd cat states."
}], "Text",
 CellID->170467508,ExpressionUUID->"8dae33f5-75d7-4344-a02b-37e635a5b946"],

