Cell[CellGroupData[{

Cell["Two-mode  squeezed vacuum states", "Subsection",
 CellChangeTimes->{{3.930917161314915*^9, 3.9309171719409294`*^9}},
 CellID->11963412,ExpressionUUID->"154730c3-7903-904b-9a36-bfbd772a8468"],

Cell["\<\
We now consider squeezing with multimode fields, this means it is possible to \
have entanglement between the modes , such characteristics can exhibit more \
diverse non-classical effects. We will just explore the two mode case , \
defining the two mode squeeze operator and two mode squeezed vacuum: \
\>", "Text",
 CellID->147387226,ExpressionUUID->"e7ba3487-609d-5b44-9307-47f2584b4279"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox["S", "^"], "2"], "(", "\[Xi]", ")"}], "=", 
   RowBox[{"exp", "(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[Xi]", "*"], " ", 
      OverscriptBox["a", "^"], 
      OverscriptBox["b", "^"]}], "-", 
     RowBox[{"\[Xi]", " ", 
      SuperscriptBox[
       OverscriptBox["a", "^"], "\[Dagger]"], 
      SuperscriptBox[
       OverscriptBox["b", "^"], "\[Dagger]"]}]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{{3.985948146496193*^9, 3.985948168963091*^9}},
 CellID->398506652,ExpressionUUID->"90bacd8a-e4a0-2e40-bb9e-133848d0d624"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
    Cell["|",ExpressionUUID->"7b83454f-9e51-bf40-846a-8e11aec85a5a"], "\[Xi]", 
     SubscriptBox[Cell[
      "\[RightAngleBracket]",ExpressionUUID->
       "c6f03317-9ecc-344d-b587-510f787cd9fe"], "2"]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       OverscriptBox["S", "^"], "2"], "(", "\[Xi]", ")"}], Cell[
     "|",ExpressionUUID->"d8074661-2669-d641-bf81-b2dd9e874b77"], 
     StyleBox["0", "CodeText"]}]}], 
   StyleBox[",", "CodeText"], 
   RowBox[{
    StyleBox["0", "CodeText"], Cell[
    "\[RightAngleBracket]",ExpressionUUID->
     "e2811c81-a400-0e4a-910b-c5e597f8ddc1"]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->564022276,ExpressionUUID->"afd436d0-a059-6a40-9f2f-018e5487e1fb"],

Cell["\<\
Note the squeezed operator of two modes cannot be decomposed as a product of \
two single mode squeeze operator, so it makes sense this operator produces \
entangled squeezed states with correlations between the two modes\
\>", "Text",
 CellID->411821459,ExpressionUUID->"c61538fb-ed9b-754f-9cca-3ac9c710ca71"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "30", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.932235954444229*^9, 3.932236075250492*^9}, {
  3.932464227521545*^9, 3.9324642558445244`*^9}, {3.9324643864973335`*^9, 
  3.9324644259849195`*^9}, {3.9324695265438533`*^9, 3.932469613812483*^9}, {
