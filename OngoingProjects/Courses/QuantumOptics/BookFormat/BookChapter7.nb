Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[CapitalDelta]", " ", 
       SubscriptBox["X", "1"]}], ")"}], "2"], "\[RightAngleBracket]"}], "=", 
   RowBox[{
    FractionBox["1", "4"], "(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"cosh", "(", "r", ")"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"sinh", "(", "r", ")"}], "2"], "-", 
     RowBox[{"2", 
      RowBox[{"sinh", "(", "r", ")"}], 
      RowBox[{"cosh", "(", "r", ")"}], 
      RowBox[{"cos", "(", "\[Theta]", ")"}]}]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
