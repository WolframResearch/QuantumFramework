Cell[TextData[{
 "For qudits the concurrence has a limit value of ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"1", "/", "d"}]}], ")"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "82db90e3-684d-7649-a86d-3cd454efe4f9"],
 ", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "30"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0d8208d2-5306-fb4e-8c8c-645fd27639a9"],
 " the upper bound is \[TildeTilde] 1.39. We see we approach that value \
asymptotically when increasing ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "658a26fc-44dc-714a-a1c4-ac71ef44cc77"]
}], "Text",
 CellID->328416319,ExpressionUUID->"60831577-3507-1d4d-96ad-d6a01d0da0df"],

