Cell[BoxData[
 RowBox[{
  RowBox[{"MandelQParameter", "[", "\[Psi]_QuantumState", "]"}], ":=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mean", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Psi]", "[", "\"\<Dagger\>\"", "]"}], "@", 
         RowBox[{
          SuperscriptBox["a", "\[Dagger]"], "@", 
          RowBox[{"a", "@", "\[Psi]"}]}]}], ")"}], "[", "\"\<Scalar\>\"", 
       "]"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"OperatorVariance", "[", 
        RowBox[{"\[Psi]", ",", 
         RowBox[{
          SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], "]"}], "-", " ", 
       "mean"}], ")"}], "/", "mean"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.932487581013996*^9, 3.932487665020611*^9}, {
  3.9324877001797924`*^9, 3.93248781441074*^9}, {3.9324878594367447`*^9, 
