Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Negative area can be calculated as \[Integral]\[Integral]  |W(", 
  "ExerciseNote"],
 StyleBox[Cell[BoxData[
  FormBox["x", TraditionalForm]], "ExerciseNote",ExpressionUUID->
  "b48f5c1f-dbb2-6e40-99f8-58a1707abccd"], "ExerciseNote"],
 StyleBox[",", "ExerciseNote"],
 StyleBox[Cell[BoxData[
  FormBox["p", TraditionalForm]], "ExerciseNote",ExpressionUUID->
  "28a4e359-da5c-594f-96f4-01fb8a3daf35"], "ExerciseNote"],
 StyleBox[")| d", "ExerciseNote"],
 StyleBox[Cell[BoxData[
  FormBox["x", TraditionalForm]], "ExerciseNote",ExpressionUUID->
  "1a49b995-dcb1-3b4d-9aa7-d476412a76c2"], "ExerciseNote"],
 StyleBox[" d", "ExerciseNote"],
 StyleBox[Cell[BoxData[
  FormBox["p", TraditionalForm]], "ExerciseNote",ExpressionUUID->
  "ac96d930-b733-2645-b4e4-cc813a2cac20"], "ExerciseNote"],
 StyleBox[" - 1:", "ExerciseNote"]
}], "ExerciseNote",
 CellID->481567024,ExpressionUUID->"a66e21a8-40d5-dc45-a277-f7e135591fec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"negativeAreas", "=", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"s", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["a", "\[Dagger]"], "@", 
           RowBox[{
            RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]", "]"}]}], 
          ")"}], "[", "\"\<Normalize\>\"", "]"}]}], ";", 
       RowBox[{"wig", " ", "=", " ", 
        RowBox[{"WignerRepresentation", "[", 
         RowBox[{"s", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "6"}], ",", "6"}], "}"}]}], "]"}]}], ";", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", 
         RowBox[{
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"wig", "[", 
              RowBox[{"x", ",", "p"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", 
              RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"p", ",", 
              RowBox[{"-", "6"}], ",", "6"}], "}"}]}], "]"}], "-", "1"}]}], 
        "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "0", ",", "1.5", ",", "0.1"}], "}"}]}], "]"}],
     "//", "Quiet"}]}], ";"}]], "ExerciseInput",
 CellLabel->"In[270]:=",
 CellID->78525684,ExpressionUUID->"ccff1701-ba7a-864f-9281-8dc8afed8b4f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
We see there is a negative area but it decreases as \[Alpha] increases, a \
coherent state with bigger values of \[Alpha] is more \
\[OpenCurlyDoubleQuote]classical\[CloseCurlyDoubleQuote]\
\>", "ExerciseNote",
 CellID->191874137,ExpressionUUID->"3fdf6531-61e2-0246-8639-b4c07d896ea5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"negativeAreas", ",", 
   RowBox[{"InterpolationOrder", "->", "2"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Alpha]\>\"", ",", "\"\<Negative Area\>\""}], "}"}]}]}], 
  "]"}]], "ExerciseInput",
 CellLabel->"In[273]:=",
 CellID->107538820,ExpressionUUID->"a36f4994-d270-2041-86e6-96cf3f70cd43"],

