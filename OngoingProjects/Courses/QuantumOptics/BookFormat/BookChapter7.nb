Cell["\<\
A balanced beam splitter with the signal in port 1 and the local oscillator \
in port 2 sends the difference of the two detector photocurrents to \
\>", "Text",
 CellID->537385897,ExpressionUUID->"4d9e89bc-93c4-5942-9fc1-5324e51503f5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["i", "34"], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox["n", "^"], "3"], "-", 
     SubscriptBox[
      OverscriptBox["n", "^"], "4"]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SubscriptBox[
         OverscriptBox["a", "^"], "3"], "\[Dagger]"], 
       SubscriptBox[
        OverscriptBox["a", "^"], "3"]}], "-", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox[
         OverscriptBox["a", "^"], "4"], "\[Dagger]"], 
       SubscriptBox[
        OverscriptBox["a", "^"], "4"]}]}], "=", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          SubscriptBox[
           OverscriptBox["a", "^"], "2"], "\[Dagger]"], 
         SubscriptBox[
          OverscriptBox["a", "^"], "1"]}], "-", 
        RowBox[{
         SuperscriptBox[
          SubscriptBox[
           OverscriptBox["a", "^"], "1"], "\[Dagger]"], 
         SubscriptBox["a", "2"]}]}], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->153703990,ExpressionUUID->"4d6b9dbe-1351-e64c-ab12-9e275a113427"],

Cell["\<\
Given an input state where |\[Beta]\[RightAngleBracket] is a coherent state \
and \[Psi] any state :\
\>", "Text",
 CellChangeTimes->{{3.926163386134287*^9, 3.9261637067482376`*^9}, {
   3.926163746412127*^9, 3.926163801873501*^9}, {3.9261819438637543`*^9, 
   3.92618196669454*^9}, {3.926182062769764*^9, 3.926182090290634*^9}, {
   3.9261821421745872`*^9, 3.926182193101185*^9}, {3.9261823095390663`*^9, 
   3.926182371262554*^9}, {3.926182443288004*^9, 3.926182518089329*^9}, {
   3.926182570317608*^9, 3.926182598454079*^9}, 3.926183141886372*^9, {
   3.9261831872103596`*^9, 3.926183301568327*^9}, {3.934907751393454*^9, 
   3.934907753308569*^9}, 3.934907889872017*^9, {3.934907938902794*^9, 
   3.9349079411421413`*^9}, {3.9349079719400024`*^9, 
   3.9349079865813885`*^9}, {3.934908205700917*^9, 3.9349082558984394`*^9}, {
   3.934908350484316*^9, 3.9349083538513317`*^9}, {3.935067844945593*^9, 
   3.9350678468543625`*^9}, 3.9681654871741943`*^9, {3.969705216127224*^9, 
   3.969705224635088*^9}},
 CellID->9112204,ExpressionUUID->"8c14248e-010b-3047-b8cd-76bc266004cd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
   Cell["|",ExpressionUUID->"ed43708e-d410-954b-8960-4bcb312c5b19"], "in", 
    Cell["\[RightAngleBracket]",ExpressionUUID->
     "23f88eaa-9a09-5745-948b-61c47714bc2d"]}], "=", 
   RowBox[{
   Cell["|",ExpressionUUID->"d8014fe8-c793-504e-87cc-32a49ffa54a7"], "\[Psi]", 
    SubscriptBox[Cell[
     "\[RightAngleBracket]",ExpressionUUID->
      "85a6b36e-ac9b-3744-afd9-b7738d385881"], "1"], Cell[
    "|",ExpressionUUID->"ad589b12-e14e-e047-a395-8c5f57d186c6"], "\[Beta]", 
    SubscriptBox[Cell[
     "\[RightAngleBracket]",ExpressionUUID->
      "64e31527-70bc-324f-a692-590571d09567"], "2"], " "}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->927714622,ExpressionUUID->"cea683bc-816a-da49-897b-84674695e4e3"],

Cell["We get for the current:", "Text",
 CellID->119500053,ExpressionUUID->"a235ee0d-73c9-9c49-81cd-ecb67886031c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     SubscriptBox[
      OverscriptBox["n", "^"], "3"], "-", 
     SubscriptBox[
      OverscriptBox["n", "^"], "4"]}], "\[RightAngleBracket]"}], "=", 
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     SubscriptBox["i", "34"], "\[RightAngleBracket]"}], "=", 
    RowBox[{
     StyleBox["2", "CodeText"], " ", "|", "\[Beta]", "|", 
     RowBox[{"\[LeftAngleBracket]", "in", "|", 
      RowBox[{"X", "(", 
       RowBox[{"\[Phi]", "-", 
        RowBox[{"\[Pi]", "/", "2"}]}], ")"}], "|", "in", 
      "\[RightAngleBracket]"}]}]}]}], TraditionalForm]], "DisplayFormula",
 CellID->157421607,ExpressionUUID->"eb5b3a9c-df16-1147-8b6e-b20a1ab42564"],

Cell[TextData[{
 "Where \[Phi] is the phase of the complex  number \[Beta]. We can define \
\[Theta] = \[Phi] - \[Pi]/2 and the quadrature at angle \[Theta] is defined ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"X", "(", "\[Theta]", ")"}], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        OverscriptBox["a", "^"], " ", 
        SuperscriptBox["e", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Theta]"}]]}], "+", 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["a", "^"], "\[Dagger]"], 
        SuperscriptBox["e", 
         RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}]}], ")"}]}]}], 
   TraditionalForm]], "DisplayFormula",
  CellChangeTimes->{{3.985948146491192*^9, 3.985948168961916*^9}},
  ExpressionUUID->"c2f1858b-5e5d-384c-ab4c-07ba5115910c"],
 ", to vary \[Theta] we vary \[Phi] and get different quadrature measurements"
}], "Text",
 CellID->114352551,ExpressionUUID->"2b72cc87-7125-3846-8fc0-169d7fa3453f"],

Cell["\<\
Also for that kind of input state each expectation factorizes\
\>", "Text",
 CellID->46908422,ExpressionUUID->"67d4222a-2202-c14b-a827-73b97a22e2cd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
   Cell["\[LeftAngleBracket]",ExpressionUUID->
     "88a071b5-e3a2-4543-a2cb-9d09a9f54530"], 
    SubsuperscriptBox["a", "2", "\[Dagger]"], 
    SubscriptBox["a", "1"], Cell[
    "\[RightAngleBracket]",ExpressionUUID->
     "4535ebb9-7408-1243-a64e-5d79643f5f10"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
    Cell["\[LeftAngleBracket]",ExpressionUUID->
      "321c3470-f922-664b-bbe6-67ece79b26d7"], 
     SubsuperscriptBox["a", "2", "\[Dagger]"], 
     SubscriptBox[Cell[
      "\[RightAngleBracket]",ExpressionUUID->
       "792a7d0c-548d-0348-b4e7-f5694cc56e52"], "\[Beta]"], Cell[
     "\[LeftAngleBracket]",ExpressionUUID->
      "22ef742e-0f85-eb4d-96a2-5d3bfae7664a"], 
     SubscriptBox["a", "1"], 
     SubscriptBox[Cell[
      "\[RightAngleBracket]",ExpressionUUID->
       "098783c5-2443-bd4a-b276-2c364dbe508f"], "\[Psi]"]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Beta]", "\[Conjugate]"}], " ", 
      SubscriptBox[
       RowBox[{"\[LeftAngleBracket]", "a", "\[RightAngleBracket]"}], 
       "\[Psi]"], "  ", "and", " ", "similarly", " ", 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        SubsuperscriptBox["a", "1", "\[Dagger]"], 
        SubscriptBox["a", "2"]}], "\[RightAngleBracket]"}]}], "=", 
     RowBox[{
     "\[Beta]", " ", Cell[
      "\[LeftAngleBracket]",ExpressionUUID->
       "31288db2-e2fe-a047-9e95-2bfb52d2bce1"], "a", 
      SubscriptBox[Cell[
       "\[RightAngleBracket]\[Conjugate]",ExpressionUUID->
        "799b4480-39b4-d246-aaef-a525da3e2b40"], "\[Psi]"]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->18768617,ExpressionUUID->"620c4d8a-a177-4044-a9a9-c81a1775453f"],

Cell["Then an alternative calculation is:", "Text",
 CellID->67392076,ExpressionUUID->"112f08f6-76d4-3a41-b317-986d03471c75"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    SubscriptBox[
     OverscriptBox["i", "^"], "34"], "\[RightAngleBracket]"}], "=", 
   RowBox[{
    RowBox[{"-", "2"}], Cell[
    "|",ExpressionUUID->"c48b8115-7070-c545-8149-d8d303fb992a"], "\[Beta]", 
    Cell["|",ExpressionUUID->"6131675f-6a71-784e-ba0e-3dc955092edf"], 
    RowBox[{"Im", "[", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]], 
      SubscriptBox[
       RowBox[{"\[LeftAngleBracket]", "a", "\[RightAngleBracket]"}], 
       "\[Psi]"]}], "]"}]}]}], TraditionalForm]], "DisplayFormula",
 CellID->174463859,ExpressionUUID->"e9f32d5a-977d-6142-8252-1be4adef4cad"],

Cell["For the second moments we get a similar formula", "Text",
 CellID->252375511,ExpressionUUID->"8342f46f-bfe8-3d43-a535-034dbf94b40d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    SuperscriptBox[
     RowBox[{"\[CapitalDelta]", "(", 
      SubscriptBox["i", "34"], ")"}], "2"], "\[RightAngleBracket]"}], "=", 
   RowBox[{
    StyleBox["4", "CodeText"], " ", "|", "\[Beta]", 
    SuperscriptBox["|", "2"], 
    RowBox[{"\[LeftAngleBracket]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[CapitalDelta]", " ", 
        RowBox[{"X", "(", "\[Theta]", ")"}]}], ")"}], "2"], 
     "\[RightAngleBracket]"}]}]}], TraditionalForm]], "DisplayFormula",
 CellID->38643530,ExpressionUUID->"5fc13723-dc3b-204a-8d41-e58ff395db9f"],

Cell["Set the truncation size:", "Text",
 CellID->5130369,ExpressionUUID->"f5a770e6-072b-f74e-9f5e-d677a93f81d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "40", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.92616276771426*^9, 3.926162770674206*^9}, {
  3.930999827547341*^9, 3.9309998411069*^9}, {3.934910102499628*^9, 
  3.934910113674774*^9}},
 CellLabel->"In[14]:=",
 CellID->237428021,ExpressionUUID->"41a36dec-f928-3947-815a-3bb7859e09ba"],

Cell[TextData[StyleBox["Mode operators:", "Text"]], "CodeText",
 CellChangeTimes->{{3.968165609072407*^9, 3.9681656111429977`*^9}},
 CellID->149388842,ExpressionUUID->"efed1ec9-966a-1c4f-87f3-7d145b6c4a15"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a1", ",", "a2"}], "}"}], "=", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"AnnihilationOperator", "[", 
       RowBox[{"{", "#", "}"}], "]"}], "&"}], ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nOp", " ", "=", " ", 
   RowBox[{
    SuperscriptBox["a1", "\[Dagger]"], "@", "a1"}]}], ";"}]}], "Input",
 CellLabel->"In[34]:=",
 CellID->86056666,ExpressionUUID->"ed70cf6d-d52d-f24a-9b16-f8c46b33af2c"],

Cell[TextData[StyleBox["Photo-current difference definition:", "Text"]], \
"CodeText",
 CellID->275208689,ExpressionUUID->"f5b24c18-fbda-6f47-8f1b-a7339a7e937e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"i34", " ", "=", 
   RowBox[{"\[ImaginaryI]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["a2", "\[Dagger]"], "@", "a1"}], "-", 
      RowBox[{
       SuperscriptBox["a1", "\[Dagger]"], "@", "a2"}]}], ")"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{
  3.926164182738796*^9, {3.9349075803682327`*^9, 3.934907580744541*^9}, {
   3.93491111501083*^9, 3.934911188404989*^9}, {3.935066238306841*^9, 
   3.935066239539583*^9}, {3.9540095998071976`*^9, 3.954009612050312*^9}, {
   3.9681656580071926`*^9, 3.968165665003088*^9}},
 CellLabel->"In[16]:=",
 CellID->92545244,ExpressionUUID->"f298ab9a-2b37-7d48-91d6-eab9a8b31919"],

Cell["Expectation value helper:", "Text",
 CellID->630214213,ExpressionUUID->"12bd2197-62ae-4a4d-b91c-152995e4b695"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"expect", "[", 
    RowBox[{"qs_", ",", "op_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"SuperDagger", "[", "qs", "]"}], "@", 
      RowBox[{"(", 
       RowBox[{"op", "@", "qs"}], ")"}]}], ")"}], "[", "\"\<Scalar\>\"", 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[17]:=",
 CellID->45024004,ExpressionUUID->"6a882788-7f3f-5643-a5a4-847513881a39"],

Cell[TextData[StyleBox["Quadrature at angle \[Theta]:", "Text"]], "CodeText",
 CellChangeTimes->{{3.968165671080105*^9, 3.968165675262121*^9}},
 CellID->263292804,ExpressionUUID->"bcada03e-2b38-434b-9919-f5eddce2e092"],

Cell[BoxData[
 RowBox[{
  RowBox[{"X", "[", "\[Theta]_", "]"}], ":=", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Theta]"}], "]"}], " ", "a"}], 
     "+", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}], "]"}], " ", 
      SuperscriptBox["a", "\[Dagger]"]}]}], ")"}]}]}]], "Input",
 CellLabel->"In[18]:=",
 CellID->54247864,ExpressionUUID->"79de0e4c-e508-224b-9554-fb47e0d16310"],

Cell["List of values of \[Phi]:", "Text",
 CellID->39987476,ExpressionUUID->"75ee522a-0a2b-f442-b05b-39e04d182fb3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"phis", "=", 
   RowBox[{"N", "@", 
    RowBox[{"Subdivide", "[", 
     RowBox[{"0", ",", 
      RowBox[{"2", " ", "Pi"}], ",", "40"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[19]:=",
 CellID->90892286,ExpressionUUID->"278d53fe-6eb1-0d4b-ae67-919d4a1cadd0"],

Cell["\<\
Define two signals: a coherent state, which is the shot-noise reference, and \
the displaced squeezed state that the section is about\
\>", "Text",
 CellID->8212263,ExpressionUUID->"135c5831-d397-b34a-a4c4-7946d44ac10f"],

Cell["Set up parameter values:", "Text",
 CellID->298189557,ExpressionUUID->"c70f96b1-16f7-1048-8121-ea98e221888e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Alpha]0", "=", 
   RowBox[{"0.6", "+", 
    RowBox[{"0.25", " ", "I"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Xi]0", "=", 
   RowBox[{"0.5", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "0.7"}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[20]:=",
 CellID->60526966,ExpressionUUID->"d3a2eda2-9f24-054a-8a8d-856a5c15cbb4"],

Cell["Define the states:", "Text",
 CellID->343634294,ExpressionUUID->"73ac0b60-ff36-9342-98bb-61b9df962895"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"psiCoh", "=", 
   RowBox[{
    RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]0", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"psiSq", "=", 
   RowBox[{
    RowBox[{"DisplacementOperator", "[", "\[Alpha]0", "]"}], "@", 
    RowBox[{
     RowBox[{"SqueezeOperator", "[", "\[Xi]0", "]"}], "[", "]"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[22]:=",
 CellID->30116751,ExpressionUUID->"985b2cb1-f4f1-c249-b683-cd31822b0fdf"],

Cell[TextData[{
 "Assuming a local oscillator ",
 Cell[BoxData[
  FormBox[
  Cell["| \[Beta] |= 3",ExpressionUUID->
    "9768ec74-a30b-e94a-a300-496435c0f04f"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ec2efb57-37e1-874d-9c73-9f55892cfef7"],
 ", calculate \[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["i", "34"], "\[RightAngleBracket]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9914a440-e5cb-464f-acee-77595475e7e9"],
 " with the two mode definition:"
}], "Text",
 CellID->346258760,ExpressionUUID->"694b1de6-24f6-984d-a60f-21d5cdeb5d68"],

Cell[BoxData[
 RowBox[{
  RowBox[{"refVals", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{
       RowBox[{"expect", "[", 
        RowBox[{
         RowBox[{"QuantumTensorProduct", "[", 
          RowBox[{"psiSq", ",", 
           RowBox[{
            RowBox[{"CoherentState", "[", "]"}], "[", 
            RowBox[{"3.", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "\[Phi]"}], "]"}]}], "]"}]}], "]"}], ",", 
         "i34"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "3."}], ")"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", "phis"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[24]:=",
 CellID->182477918,ExpressionUUID->"4782a2bf-a3a0-e34c-b0a3-26231aa3213e"],

Cell["And with the alternative way:", "Text",
 CellID->573138348,ExpressionUUID->"28fe3130-9491-3e4b-b715-9ab97c04b5ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fast", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a0", "=", 
       RowBox[{"expect", "[", 
        RowBox[{"psiSq", ",", "a"}], "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Im", "[", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", "#"}], "]"}], " ", "a0"}], "]"}]}], 
       "&"}], "/@", "phis"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[25]:=",
 CellID->116862416,ExpressionUUID->"7b790eb5-d4ad-7f4d-94a1-084e34d973f2"],

Cell["Verify they are numerically the same:", "Text",
 CellID->405996546,ExpressionUUID->"70a2ab27-66c7-364b-8b4b-1e2091d8dcdf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "[", 
   RowBox[{"refVals", "-", "fast"}], "]"}]}]], "Input",
 CellLabel->"In[26]:=",
 CellID->61332164,ExpressionUUID->"85cd8501-defe-5f40-98f7-18b8b4596f1d"],

Cell[BoxData["6.52811138479592`*^-14"], "Output",
 CellLabel->"Out[26]=",
 CellID->752295677,ExpressionUUID->"7919f00d-0c40-7a43-b4e8-c46b6128fd91"]
}, Open  ]],

