Cell[TextData[{
 "And the variances ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", " "}], TraditionalForm]],ExpressionUUID->
  "3f485aa1-49f0-9d4d-9a2c-98646f2756cc"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SubscriptBox["\[CapitalDelta]n", "a"], ")"}], "2"], Cell[
     "\[RightAngleBracket]",ExpressionUUID->
      "a0db4a4c-3a9e-0047-8f0d-eb4366a4f2e2"]}], "=", " ", 
    RowBox[{
    Cell["\[LeftAngleBracket]",ExpressionUUID->
      "af222fd6-3c73-b849-a713-d4ab1e2e1f52"], 
     SuperscriptBox[
      RowBox[{"(", 
       SubscriptBox["\[CapitalDelta]n", "b"], ")"}], "2"], Cell[TextData[{
      "\[RightAngleBracket] = 1/4 ",
      Cell[BoxData[
       FormBox[
        RowBox[{
         SuperscriptBox["sinh", "2"], "(", "r", ")"}], TraditionalForm]],
       ExpressionUUID->"8c6cf3fa-5bcf-df45-876f-69a859204a8a"]
     }],ExpressionUUID->"61d57658-a4eb-0549-bfa7-8ddc391df55d"]}]}], 
   TraditionalForm]],ExpressionUUID->"e0225de1-6532-9848-a60c-e7256c923835"],
 ", it follows that both modes have super-",
 StyleBox["Poissonian",
  IgnoreSpellCheck->True],
 " photon distributions"
}], "Text",
 CellChangeTimes->{{3.932480258020155*^9, 3.93248040132366*^9}},
 CellID->870681360,ExpressionUUID->"3965d11a-36f6-3f4d-8c89-a59a8152c5f5"],

Cell[TextData[StyleBox["Calculate the variances:", "Text"]], "CodeText",
 CellChangeTimes->{{3.968171923093807*^9, 3.9681719286418457`*^9}},
 CellID->133804286,ExpressionUUID->"dd24261e-f078-6f49-b832-4ae0a0d69aa6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"state", "=", 
      RowBox[{"twoModesqueezeVacuum", "[", "\[Xi]1", "]"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"OperatorVariance", "[", 
       RowBox[{"state", ",", "#"}], "]"}], "&"}], " ", "/@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"a1", "[", "\"\<Dagger\>\"", "]"}], "@", "a1"}], ",", 
       RowBox[{
        RowBox[{"b1", "[", "\"\<Dagger\>\"", "]"}], "@", "b1"}]}], "}"}]}]}], 
   "]"}], "//", "Chop"}]], "Input",
 CellChangeTimes->{{3.932479359914215*^9, 3.9324794563136797`*^9}, {
