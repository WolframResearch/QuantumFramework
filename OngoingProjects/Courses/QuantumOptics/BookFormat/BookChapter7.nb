 CellID->161000254,ExpressionUUID->"9d2fb346-a30a-0c4e-bf26-2ee83d56da9e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Norm", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", 
          RowBox[{"HI", "[", 
           RowBox[{
            RowBox[{"2", "\[Omega]"}], ",", "\[Omega]", ",", "1"}], "]"}], 
          RowBox[{"t", "/", "h"}]}], "]"}], "-", 
        RowBox[{"SqueezeOperator", "[", 
         RowBox[{"2", " ", "t"}], "]"}]}], ")"}], "[", "\"\<Matrix\>\"", 
      "]"}], ",", "\"\<Frobenius\>\""}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0.1", ",", "0.5", ",", "0.05"}], "}"}]}], 
