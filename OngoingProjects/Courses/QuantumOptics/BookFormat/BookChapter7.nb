      RowBox[{
       RowBox[{"quadForm", "[", 
        RowBox[{"covSq", ",", "\[Theta]"}], "]"}], ",", 
       RowBox[{"0", "<", "\[Theta]", "<", "\[Pi]"}]}], "}"}], ",", 
     "\[Theta]"}], "]"}], "&"}], "/@", 
  RowBox[{"{", 
   RowBox[{"NMaximize", ",", "NMinimize"}], "}"}]}]], "Input",
 CellLabel->"In[54]:=",
 CellID->451087140,ExpressionUUID->"0ed5449e-e066-ab41-b13c-a6ebf568928c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.6795704571139943`", ",", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", "\[Rule]", "1.9207963268475745`"}], "}"}]}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"0.09196986029306298`", ",", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", "\[Rule]", "0.35000000004269705`"}], "}"}]}], 
    "}"}]}], "}"}]], "Output",
 CellLabel->"Out[54]=",
 CellID->116355888,ExpressionUUID->"20f5554b-dfd9-9e4b-a8c7-459dc48f02de"]
}, Open  ]],

Cell[TextData[{
 "Both quantities were moments, a homodyne run returns a number per shot. And \
the histogram of those numbers is the quadrature probability density. The \
eigenstates of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"X", "(", "\[Theta]", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "99d9785c-8090-3046-83e4-b9c56457a9a2"],
 " are rotations of the |",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "548ed46a-84e2-5049-851b-537747e36eac"],
 Cell[BoxData[
  FormBox[
   RowBox[{Cell[TextData[Cell[BoxData[
     FormBox[
      SubscriptBox["\[RightAngleBracket]", "\[Theta]"], TraditionalForm]],
     FormatType->TraditionalForm,ExpressionUUID->
     "225dae80-18a8-8345-b970-2e39e47f0308"]],ExpressionUUID->
     "457f443e-ef0e-8142-a9b0-3aa1a4265738"], "=", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "\[Theta]", " ", 
       OverscriptBox["n", "^"]}]], Cell[
     "|",ExpressionUUID->"c7682ff1-5969-c74a-8c2c-bbb9c250da59"], "x", Cell[
     "\[RightAngleBracket]",ExpressionUUID->
      "1dbd9e8a-3c3d-6a4c-b297-b4302f4dc8f3"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1c6a9b4d-72fa-8340-99bd-2f6a09672a54"],
 ". So the amplitude is the phase weighted sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Pr", "(", 
     RowBox[{"x", ",", " ", "\[Theta]"}], ")"}], "=", 
    RowBox[{"|", 
     RowBox[{
      SubscriptBox["\[Sum]", 
       RowBox[{" ", "n"}]], " ", 
      RowBox[{
       SubscriptBox["c", "n"], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "n", " ", "\[Theta]"}]], 
       RowBox[{
        SubscriptBox["\[CurlyPhi]", "n"], "(", "x", ")"}]}]}], 
     SuperscriptBox["|", "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "98d4f20d-0052-c649-aaf4-1a5a64b48bd8"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyPhi]", "n"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f7c35b1f-3694-af49-b099-349993506cc7"],
 " are the harmonic oscillator wave-functions"
}], "Text",
 CellID->43590506,ExpressionUUID->"17e89660-514b-a84b-85b0-6d2aebf0bf40"],

Cell["Define the quadrature density:", "Text",
 CellID->306219027,ExpressionUUID->"cd7e3a57-7b4b-3f4d-b729-7ad26c9203fc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"quadratureDensity", "[", "qs_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{"$FockSize", "-", "1"}]}], "]"}]}], ",", "coef"}], "}"}], ",", 
    RowBox[{
     RowBox[{"coef", "=", 
      FractionBox[
       RowBox[{
        RowBox[{"qs", "[", "\"\<AmplitudesList\>\"", "]"}], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["2", "\[Pi]"], ")"}], 
         RowBox[{"1", "/", "4"}]]}], 
       SqrtBox[
        RowBox[{
         SuperscriptBox["2", "n"], " ", 
         RowBox[{"n", "!"}]}]]]}], ";", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Abs", "[", 
        RowBox[{"coef", ".", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "\[ImaginaryI]"}], " ", "n", " ", "#2"}], "-", 
             SuperscriptBox["#1", "2"]}], "]"}], " ", 
           RowBox[{"HermiteH", "[", 
            RowBox[{"n", ",", 
             RowBox[{
              SqrtBox["2"], " ", "#1"}]}], "]"}]}], ")"}]}], "]"}], "2"], 
      "&"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[79]:=",
 CellID->305645328,ExpressionUUID->"43751737-a915-274b-8b27-7cedf53cadad"],

Cell["Compute the density for the states:", "Text",
 CellID->40957699,ExpressionUUID->"e7c9e721-5aac-ee4b-8fca-69d2b820a2f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"densities", " ", "=", " ", 
   RowBox[{"quadratureDensity", "/@", 
    RowBox[{"{", 
     RowBox[{"psiCoh", ",", "psiSq"}], "}"}]}]}], ";"}]], "Input",
 CellLabel->"In[81]:=",
 CellID->59842819,ExpressionUUID->"ac98a270-134a-d34d-8f4c-5cbfd2f48a42"],

Cell[TextData[{
 "Visualize the plot of the densities in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "-", "\[Theta]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2a4ff61d-276f-d248-9715-9439ba5ee863"],
 " plane:"
}], "Text",
 CellID->25346296,ExpressionUUID->"6fb60652-62c5-8a4a-aa8d-2eb6eaabfd35"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"DensityPlot", "[", 
     RowBox[{
      RowBox[{"#", "[", 
       RowBox[{"x", ",", "\[Theta]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", "0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
      InterpretationBox[
       DynamicModuleBox[{Typeset`open = False}, 
        TemplateBox[{"Expression", "SequenceIcon", 
          GridBox[{{
             RowBox[{
               TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["Sequence", "IconizedItem"]}]}, {
             RowBox[{
               TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["9", "IconizedItem"]}]}, {
             RowBox[{
               TagBox["\"Byte count: \"", "IconizedLabel"], 
               "\[InvisibleSpace]", 
               TagBox["1712", "IconizedItem"]}]}}, 
           GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
           "Column", 
           GridBoxItemSize -> {
            "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
          Dynamic[Typeset`open]},
         "IconizedObject"]],
       Sequence[
       PlotPoints -> 90, PlotRange -> All, ColorFunction -> 
        ColorData[{"SunsetColors", {0, 1.1}}], ColorFunctionScaling -> False, 
        FrameTicks -> {{Automatic, None}, {
           Range[0, 2 Pi, Pi/2], None}}, FrameLabel -> {"\[Theta]", "x"}, 
        LabelStyle -> 13, ImageSize -> 200, PlotLegends -> 
        BarLegend[{"SunsetColors", {0, 1.1}}]],
       SelectWithContents->True,
       Selectable->False]}], "]"}], "&"}], "/@", "densities"}], 
  "]"}]], "Input",
 CellLabel->"In[88]:=",
 CellID->318722712,ExpressionUUID->"22863506-87ca-5344-9073-a87a7b7ce830"],

