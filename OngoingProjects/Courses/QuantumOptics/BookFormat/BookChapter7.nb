Cell[TextData[{
 "Using the uncertainty principle for two operators ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "86c617da-e9e7-6443-a335-f34efc76335e"],
 " and ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],ExpressionUUID->
  "5cb67595-aa56-a743-8313-8721e083106b"],
 " we have \[CapitalDelta]",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "778c9974-cd59-6c4f-86bc-f1a429ff6a73"],
 " \[CapitalDelta]",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],ExpressionUUID->
  "fde4d11d-f4ec-6c41-8ac1-503a4a801745"],
 " \[GreaterEqual] ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]],ExpressionUUID->
  "3923d610-5c95-d94b-a513-1dc775c40e95"],
 "| \[LeftAngleBracket] [ ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "d8c74c96-7a63-7149-8839-233ddc7b226e"],
 ", ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],ExpressionUUID->
  "2f66e73a-cea2-854d-a113-2748be731c84"],
 "] \[RightAngleBracket] |, applying to this case we get ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", 
    SubscriptBox["K", "1"]}], TraditionalForm]],ExpressionUUID->
  "3f554791-60d1-0740-bfd0-54eb16d77c25"],
 " \[CapitalDelta]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "2"], TraditionalForm]],ExpressionUUID->
  "7d89b0bb-d94a-a541-b2c0-198394e455e4"],
 " \[GreaterEqual] 2 \[LeftAngleBracket] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "3"], TraditionalForm]],ExpressionUUID->
  "eb7d4811-dc55-9441-8fcc-48e13cad900b"],
 "\[RightAngleBracket]"
}], "ExerciseNote",
 CellID->809217888,ExpressionUUID->"feac5af8-c1e8-6546-8d91-ca2bd3a96846"],

Cell[CellGroupData[{

Cell["Defining as quantum operators:", "ExerciseNote",
 CellID->42258018,ExpressionUUID->"b1452ba8-f37d-5c44-8f81-b1f9140d49ef"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"K1op", " ", "=", " ", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       SuperscriptBox["a", "\[Dagger]"], "2"], "+", 
      SuperscriptBox["a", "2"]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"K2op", " ", "=", " ", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "\[ImaginaryI]"}]], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       SuperscriptBox["a", "\[Dagger]"], "2"], "-", 
      SuperscriptBox["a", "2"]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"K3op", " ", "=", " ", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["a", "\[Dagger]"], "@", "a"}], "+", 
      RowBox[{"1", "/", "2"}]}], ")"}]}]}], ";"}]}], "ExerciseInput",
 CellLabel->"In[282]:=",
 CellID->17488130,ExpressionUUID->"50f6dc0a-eab4-b348-bde2-2922f67d73e3"],

Cell["Random complex amplitude:", "SolutionAnswer",
 CellID->26241420,ExpressionUUID->"cff18414-7c3c-a047-8af6-4aaed7ca27ed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Alpha]coh", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"{", 
     RowBox[{"0", ",", "2"}], "}"}], "]"}]}], ";"}]], "ExerciseInput",
 CellLabel->"In[285]:=",
 CellID->541517385,ExpressionUUID->"80bec3ee-b7b5-2a4b-8aa0-6fc5fea5f1b0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Evaluate the left and right hand side of the inequality:", \
"ExerciseNote",
 CellID->363987791,ExpressionUUID->"12126a5a-1654-fa42-be19-8d466cc33a22"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LHS", " ", "=", 
   RowBox[{"\[Sqrt]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"OperatorVariance", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]coh", "]"}], ",", 
        "K1op"}], "]"}], 
      RowBox[{"OperatorVariance", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]coh", "]"}], ",", 
        "K2op"}], "]"}]}], ")"}]}]}], ";"}]], "ExerciseInput",
 CellLabel->"In[286]:=",
 CellID->358846652,ExpressionUUID->"622f01e0-bd20-6c41-b374-d8a8d3d1bb2c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RHS", " ", "=", " ", 
   RowBox[{"2", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{
         RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]coh", "]"}], 
        "\[Dagger]"], "@", 
       RowBox[{"K3op", "@", 
        RowBox[{
         RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]coh", "]"}]}]}], 
      ")"}], "[", "\"\<Scalar\>\"", "]"}]}]}], ";"}]], "ExerciseInput",
 CellLabel->"In[287]:=",
 CellID->9444510,ExpressionUUID->"47d8c172-de9f-6341-a538-91abe646390e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["We see it satisfies the equality:", "ExerciseNote",
 CellID->296358800,ExpressionUUID->"c0b7084a-a65c-b74a-b633-ae82fc3b67f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"LHS", "-", "RHS"}], "]"}]], "ExerciseInput",
 CellLabel->"In[288]:=",
 CellID->161862514,ExpressionUUID->"e72966fb-25dd-094e-96db-39e787d9aad1"],

