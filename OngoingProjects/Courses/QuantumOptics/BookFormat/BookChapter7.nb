  FormBox[
   RowBox[{"n", ",", "n"}], TraditionalForm]],ExpressionUUID->
  "ec7bfe0c-caa4-e444-bdc0-1abbf9eaaedf"],
 "\[RightAngleBracket] appear"
}], "Text",
