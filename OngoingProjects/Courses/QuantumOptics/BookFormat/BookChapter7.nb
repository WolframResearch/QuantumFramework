Cell[BoxData[{
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[CapitalDelta]", " ", 
       OverscriptBox["A", "^"]}], ")"}], "2"], "\[RightAngleBracket]"}], "<", 
   RowBox[{
    FractionBox["1", "2"], Cell[
    "|",ExpressionUUID->"31cdfcfb-2ff2-6a4b-9310-eaee63c9be4a"], 
    RowBox[{"\[LeftAngleBracket]", 
     OverscriptBox["C", "^"], "\[RightAngleBracket]"}], Cell[
    "|",ExpressionUUID->"605be1c2-eeb5-8741-9eed-c60ffbefe8ec"], "or", 
    RowBox[{"\[LeftAngleBracket]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[CapitalDelta]", " ", 
        OverscriptBox["B", "^"]}], ")"}], "2"], "\[RightAngleBracket]"}]}], "<", 
   RowBox[{
    FractionBox["1", "2"], Cell[
    "|",ExpressionUUID->"ad64995a-0971-2d40-93c5-90d9a82629e8"], 
    RowBox[{"\[LeftAngleBracket]", 
     OverscriptBox["C", "^"], "\[RightAngleBracket]"}], Cell[
    "|",ExpressionUUID->"3bf54ee9-3f7f-3542-a446-978fbcaa2935"]}]}], 
  TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{
  "both", " ", "cannot", " ", "hold", " ", "otherwise", " ", "uncertainty", " ",
    "principle", " ", "is", " ", "violated"}], 
  TraditionalForm]}], "DisplayFormula",
 CellID->94490454,ExpressionUUID->"311db4a3-e774-dc4b-b081-c40c5ab0658e"],

Cell[TextData[{
 "For quadrature operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", "1"], " ", "and", " ", 
    SubscriptBox["X", "2"]}], TraditionalForm]],ExpressionUUID->
  "f0f7c4ca-9fa3-5346-950e-b9c4c60a2efe"],
 " , the commutator is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["X", "^"], "1"], ",", 
      SubscriptBox[
       OverscriptBox["X", "^"], "2"]}], "]"}], "=", 
    RowBox[{"\[ImaginaryI]", "/", "2"}]}], TraditionalForm]], "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{3.985947637430418*^9, 3.985947736622055*^9},
  ExpressionUUID->"da2fe295-3889-ab4b-8284-7a05383aeff2"],
 "  so quadrature squeezing exists if"
}], "Text",
 CellID->477030020,ExpressionUUID->"d35048f6-3b65-1344-8756-fc6245f35950"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[CapitalDelta]", " ", 
       SubscriptBox[
        OverscriptBox["X", "^"], "1"]}], ")"}], "2"], 
    "\[RightAngleBracket]"}], "<", 
   RowBox[{
    FractionBox["1", "4"], "or", "  ", 
    RowBox[{"\[LeftAngleBracket]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[CapitalDelta]", " ", 
        SubscriptBox[
         OverscriptBox["X", "^"], "2"]}], ")"}], "2"], 
     "\[RightAngleBracket]"}]}], "<", 
   FractionBox["1", "4"]}], TraditionalForm]], "DisplayFormula",
 CellID->552628207,ExpressionUUID->"aee18d58-8ec7-7e49-aa08-48eebb4cd702"],

Cell["\<\
We know coherent states and the vacuum have quadrature variances of 1/4 in \
both quadratures, and satisfy the uncertainty inequality limit. In the figure \
below, we can see a representation of squeezing, in the shaded regions one \
quadrature variance can go below vacuum(\[OpenCurlyDoubleQuote]squeezed\
\[CloseCurlyDoubleQuote]) but the other one increases. Ideal squeezed states \
lie in the hyperbola (they satisfy the equality), but in general squeezed \
states can be anywhere in the shaded regions.\
\>", "Text",
 CellID->330048318,ExpressionUUID->"eedde76a-f36b-f643-aca3-a3a02255a383"],

