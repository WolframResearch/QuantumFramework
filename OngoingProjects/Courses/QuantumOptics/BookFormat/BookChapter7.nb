Cell[TextData[{
 "Phase space representation for the cases  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Theta]", " ", "=", " ", 
    RowBox[{
     RowBox[{
     Cell["0",ExpressionUUID->"023a8ded-918c-6b4b-aaa3-5083d4cd07a9"], " ", 
      "and", " ", "\[Theta]"}], "=", "\[Pi]"}]}], TraditionalForm]],
  ExpressionUUID->"336a3c01-9f2b-bc42-81b7-00ba96061240"],
 " (not to scale for visual purposes). In these cases the squeezing is along \
the axes of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", "1"], "or", " ", 
    SubscriptBox["X", "2"]}], TraditionalForm]],ExpressionUUID->
  "7be6060d-6b47-f64a-92a0-79fabc19a94c"],
 " describing error ellipses:"
}], "Text",
