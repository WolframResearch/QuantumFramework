Cell[CellGroupData[{

Cell[TextData[StyleBox["Generation of squeezed states", "Subsection"]], \
"Subsection",
 CellChangeTimes->{{3.930917183033842*^9, 3.9309171909590664`*^9}},
 CellID->66028895,ExpressionUUID->"a4969d2f-a862-4a42-bb76-0b98993e90e1"],

Cell[TextData[{
 "A common technique  to generate squeezed light is  to implement parametric \
processes with the aid of non linear optical devices. A non-linear medium  is \
pumped by a field of frequency ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "P"], TraditionalForm]],ExpressionUUID->
  "06ef77b3-4542-5748-bc07-824cbbac299e"],
 ",  and photons of the field are converted into pairs of signal photons each \
of frequency \[Omega] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "P"], "/", "2"}], TraditionalForm]],
  ExpressionUUID->"d89a183c-da9c-bd4c-a16a-bbd3aaee9b48"],
 ". This is known as ",
 StyleBox["degenerate parametric down-conversion",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.9309260592709846`*^9, 3.930926101280615*^9}, {
  3.930926988107935*^9, 3.930927011063263*^9}, {3.930928062682436*^9, 
  3.9309281771205673`*^9}, {3.930928211375557*^9, 3.930928222769705*^9}, {
  3.9697047926288033`*^9, 3.9697047935131626`*^9}},
 CellID->447264005,ExpressionUUID->"8308e195-1b28-6d43-80f3-d2e6539320dd"],

Cell["Can be represented by this Hamiltonian", "Text",
 CellChangeTimes->{{3.969704827708832*^9, 3.969704834009182*^9}},
 CellID->280622824,ExpressionUUID->"a55d1d02-3135-e146-9aac-d276dc4d8ce7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["H", "^"], "=", 
   RowBox[{
    RowBox[{"\[HBar]", " ", "\[Omega]", " ", 
     SuperscriptBox[
      OverscriptBox["a", "^"], "\[Dagger]"], 
     OverscriptBox["a", "^"]}], "+", 
    RowBox[{"\[HBar]", " ", 
     SubscriptBox["\[Omega]", "P"], 
     SuperscriptBox[
      OverscriptBox["b", "^"], "\[Dagger]"], 
     OverscriptBox["b", "^"]}], "-", 
    RowBox[{"\[ImaginaryI]", " ", "\[HBar]", " ", 
     SuperscriptBox["\[Chi]", 
      RowBox[{"(", "2", ")"}]], "(", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        OverscriptBox["a", "^"], "2"], 
       SuperscriptBox[
        OverscriptBox["b", "^"], "\[Dagger]"]}], "-", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["a", "^"], 
        RowBox[{"\[Dagger]", "2"}]], 
       OverscriptBox["b", "^"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{{3.9859481464839287`*^9, 3.9859481689579086`*^9}},
 CellID->759522152,ExpressionUUID->"31656e07-11f9-d946-9134-2f2bc17339b7"],

Cell[TextData[{
 "where  ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "2444ff75-5e85-964b-b1db-ca766c82fb1b"],
 " is the pump mode, ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "e19f726a-678c-a04c-9dca-6abc51c6c9e6"],
 " is the signal mode and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Chi]", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],ExpressionUUID->
  "0ab97817-c976-e34f-817d-efe037d14a39"],
 " is the second order susceptibility"
}], "Text",
 CellID->473978391,ExpressionUUID->"db95e676-d60f-f34e-a723-3432105055ac"],

Cell[TextData[{
 "And we can make the approximation that the pump is a really strong \
classical field, strong enough to never run out of photons. We can assume the \
field  is in  a coherent state |\[Beta] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["e", 
     RowBox[{
      RowBox[{"-", " ", "\[ImaginaryI]"}], " ", 
      SubscriptBox["\[Omega]", 
       RowBox[{"P", " "}]], "t"}]], Cell[
    "\[RightAngleBracket]",ExpressionUUID->
     "74e89984-3192-b44d-9dc7-29edf9f8a219"]}], TraditionalForm]],
  ExpressionUUID->"66c74a6a-5f5b-4048-9703-8075c1513cb7"],
 " and operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", " ", "and", " ", 
    SuperscriptBox["b", "\[Dagger]"]}], TraditionalForm]],ExpressionUUID->
  "57b8960f-9aae-dc4b-be5b-a7f2f1f1e596"],
 " are replaced by  \[Beta] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{
     RowBox[{"-", " ", "\[ImaginaryI]"}], " ", 
     SubscriptBox["\[Omega]", "P"], " ", "t"}]], TraditionalForm]],
  ExpressionUUID->"38d1ffc0-439f-e441-b9d0-15381d13e3be"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Beta]", "*"], " ", 
    SuperscriptBox["e", 
     RowBox[{"\[ImaginaryI]", " ", 
      SubscriptBox["\[Omega]", "P"], " ", "t"}]]}], TraditionalForm]],
  ExpressionUUID->"2b0f4851-2bdd-eb43-83cf-759ccb19bca2"],
 ", so the Hamiltonian can be expressed as:"
}], "Text",
 CellID->268890132,ExpressionUUID->"26ce1997-a463-5d4e-a7f8-dc702a10e41f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    OverscriptBox["H", "^"], 
    RowBox[{"(", "PA", ")"}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[HBar]", " ", "\[Omega]", " ", 
      SuperscriptBox[
       OverscriptBox["a", "^"], "\[Dagger]"], 
      OverscriptBox["a", "^"]}], "+", 
     RowBox[{"\[ImaginaryI]", " ", "\[HBar]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Eta]", "*"], 
         SuperscriptBox[
          OverscriptBox["a", "^"], "2"], 
         SuperscriptBox["e", 
          RowBox[{"\[ImaginaryI]", " ", 
           SubscriptBox["\[Omega]", "P"], " ", "t"}]]}], "-", 
        RowBox[{"\[Eta]", " ", 
         SuperscriptBox[
          OverscriptBox["a", "^"], 
          RowBox[{"\[Dagger]", "2"}]], 
         SuperscriptBox["e", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], 
           SubscriptBox["\[Omega]", "P"], " ", "t"}]]}]}], ")"}], " ", 
      "where", " ", "\[Eta]"}]}], "=", 
    RowBox[{"\[Beta]", " ", 
     SuperscriptBox["\[Chi]", 
      RowBox[{"(", "2", ")"}]]}]}]}], TraditionalForm]], "DisplayFormula",
 CellID->213777362,ExpressionUUID->"cd7900db-a18e-a94f-9c97-fd59417bd72b"],

Cell[TextData[StyleBox["Set the truncation size:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681649457332554`*^9, 3.968164949657789*^9}},
 CellID->5003649,ExpressionUUID->"aba5d52b-74c9-b045-912f-3688b9c6e09d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "40", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9348919481363153`*^9, 3.934891953910448*^9}, {
  3.934893032689932*^9, 3.934893033575767*^9}, {3.934893129068834*^9, 
  3.934893129196844*^9}, {3.934900462593033*^9, 3.934900463328375*^9}, {
  3.934909390500105*^9, 3.934909391220312*^9}},
 CellLabel->"In[78]:=",
 CellID->82969429,ExpressionUUID->"c41eede9-cc81-ee4a-9bf0-c2bf7ea44a7f"],

Cell["Time independent term:", "Text",
 CellChangeTimes->{{3.93093140506439*^9, 3.930931423171255*^9}},
 CellID->69592148,ExpressionUUID->"8b07c227-e434-454b-9b44-f8ade03aca47"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H0PA", " ", "=", " ", 
   RowBox[{"h", " ", "\[Omega]", " ", 
    RowBox[{
     SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9309290748511753`*^9, 3.930929096174705*^9}, 
   3.930929137925041*^9, {3.934891962294824*^9, 3.934891965475662*^9}},
 CellLabel->"In[79]:=",
 CellID->982409135,ExpressionUUID->"593074b0-d79c-234e-b49e-139a73446ea7"],

Cell["Time dependent term:", "Text",
 CellChangeTimes->{{3.9309314178609257`*^9, 3.930931426401144*^9}},
 CellID->570857025,ExpressionUUID->"e7f21394-a2c8-214c-999f-ac3f9de10a25"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HIPA", " ", "=", " ", 
   RowBox[{"\[ImaginaryI]", " ", "h", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Eta]", "\[Conjugate]"}], " ", 
       RowBox[{"a", "@", "a"}], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["\[Omega]", "P"], " ", "t"}]]}], "-", 
      RowBox[{"\[Eta]", "  ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["a", "\[Dagger]"], "@", 
          SuperscriptBox["a", "\[Dagger]"]}], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", 
           SubscriptBox["\[Omega]", "P"], "t"}]]}], ")"}]}]}], ")"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.930929139982071*^9, 3.9309291506185513`*^9}, {
   3.9309292139998264`*^9, 3.930929329902868*^9}, 3.930930525380741*^9, {
   3.93489197328169*^9, 3.9348920516953316`*^9}},
 CellLabel->"In[80]:=",
 CellID->479622004,ExpressionUUID->"f8854b27-f27d-694f-bd33-0b31be1e1acc"],

Cell["Exponential of free part:", "Text",
 CellChangeTimes->{{3.953855562493862*^9, 3.95385556738455*^9}},
 CellID->101078877,ExpressionUUID->"cb52a6dd-9e6e-3645-a2a0-794a086322af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"U0", " ", "=", "  ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     RowBox[{"H0PA", "/", "h"}], " ", "t"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[81]:=",
 CellID->230239061,ExpressionUUID->"01d83d6a-fd1d-9d41-9f75-b4ac01ea2abd"],

Cell["Going to the interaction picture:", "Text",
 CellChangeTimes->{{3.953855574385868*^9, 3.953855583918009*^9}},
 CellID->455426139,ExpressionUUID->"bcfaac49-17ce-1340-8fd5-f3daab786159"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HI", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox["U0", "\[Dagger]"], "@", " ", 
        RowBox[{"HIPA", " ", "@", " ", "U0"}]}], ",", 
       RowBox[{"Element", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"h", ",", 
           SubscriptBox["\[Omega]", "P"], ",", "t", ",", "\[Omega]"}], "}"}], 
         ",", "Reals"}], "]"}]}], "]"}], ",", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["\[Omega]", "P"], ",", "\[Omega]", ",", "\[Eta]"}], 
       "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[82]:=",
 CellID->365662760,ExpressionUUID->"d4d68dcb-37af-b640-9fb4-09d018c356bd"],

Cell[TextData[{
 "We get an interaction picture Hamiltonian that is time dependent , but when \
we consider ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "P"], " ", "=", " ", 
    RowBox[{"2", " ", "\[Omega]"}]}], TraditionalForm]],ExpressionUUID->
  "5c0e0c1c-da59-3b46-8d5d-94806e61f51a"],
 " that is an energy conservation condition , then the Hamiltonian becomes \
time independent"
}], "Text",
 CellID->166960753,ExpressionUUID->"07c8075a-a15f-2b47-8184-19a80e76abfd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FreeQ", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"HI", "[", 
      RowBox[{"\[Omega]p", ",", "\[Omega]"}], "]"}], "[", "\"\<Amplitudes\>\"",
      "]"}], "//", "Values"}], ",", "t"}], "]"}]], "Input",
 CellLabel->"In[83]:=",
 CellID->345808708,ExpressionUUID->"ff3a2f3a-ef23-4044-9027-fd64d002402c"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[83]=",
 CellID->17412698,ExpressionUUID->"5f14747a-af57-c84f-ab12-fff34f9dfa17"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FreeQ", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"HI", "[", 
      RowBox[{
       RowBox[{"2", "\[Omega]"}], ",", "\[Omega]"}], "]"}], 
     "[", "\"\<Amplitudes\>\"", "]"}], "//", "Values"}], ",", "t"}], 
  "]"}]], "Input",
 CellLabel->"In[84]:=",
 CellID->688925982,ExpressionUUID->"6ec81a7b-3771-a943-b821-9f5a8cb72feb"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[84]=",
 CellID->53409214,ExpressionUUID->"bd228e96-cb91-1842-a0c3-fe2566973b1c"]
}, Open  ]],

Cell[TextData[{
 "The evolution operator using this interaction Hamiltonian can be shown to \
take the form of a squeeze operator where \[Xi] = 2 \[Eta] t, which should \
not come as a surprise because of the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["a", "^"], "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "345d4ea4-e2d6-4b46-aa1a-b24743ab50e3"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["a", "^"], "\[Dagger]2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fa948f81-e6b9-a249-954c-1397421b5ae1"],
 " terms."
}], "Text",
 CellID->274940042,ExpressionUUID->"b879f44d-01d1-3b4f-adcf-6dcf99c6f334"],

Cell[TextData[{
 StyleBox["We can check comparing the Frobenius norm of ", "Text"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"||", " ", 
     RowBox[{"U", " ", "-", " ", "SqueezeOperator"}], 
     SubscriptBox["||", "F"]}], "Text"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "089facde-9c28-9b4e-bc25-d5d12ca88a03"],
 StyleBox[" numerically , for the sake of the example we take ", "Text"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"\[Eta]", "=", "1"}], "Text"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "de0d2f3d-5fb9-b045-8394-2a33d7727a72"],
 StyleBox[". The evolution operator has good agreement to the SqueezeOperator \
with \[OpenCurlyDoubleQuote]Weak\[CloseCurlyDoubleQuote] ordering because of \
the form of interaction Hamiltonian:", "Text"]
}], "CodeText",
 CellID->331415116,ExpressionUUID->"423f8f41-75c3-d043-810c-26f9eb566c00"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Norm", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", 
          RowBox[{"HI", "[", 
           RowBox[{
            RowBox[{"2", "\[Omega]"}], ",", "\[Omega]", ",", "1"}], "]"}], 
          RowBox[{"t", "/", "h"}]}], "]"}], "-", 
        RowBox[{"SqueezeOperator", "[", 
         RowBox[{
          RowBox[{"2", " ", "t"}], ",", 
          RowBox[{"\"\<Ordering\>\"", "->", "\"\<Weak\>\""}]}], "]"}]}], 
       ")"}], "[", "\"\<Matrix\>\"", "]"}], ",", "\"\<Frobenius\>\""}], "]"}],
    ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0.1", ",", "0.5", ",", "0.05"}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[85]:=",
 CellID->736814655,ExpressionUUID->"eb4936e5-23d7-4b4c-859c-2d3e6c50acab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "2.277144042346219`*^-15", ",", "2.7383130959284983`*^-15", ",", 
   "3.520879539455671`*^-15", ",", "1.4569327966849025`*^-14", ",", 
