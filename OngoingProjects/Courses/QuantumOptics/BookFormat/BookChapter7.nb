Cell[TextData[{
 "Applying on a coherent state with the annihilation operator has no effect \
on the state itself\.04. But consider now the effect of operating on a \
coherent state with the creation operator ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "48219cf1-6cf6-734f-93ac-9d2d4fcf3767"],
 ". Obtain the normalized state and investigate its properties. Is it a \
nonclassical state? Check the negative area of the Wigner function varying \
the value \[Alpha] of the coherent state."
}], "Exercise",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellID->5564766,ExpressionUUID->"5b9214aa-3a27-724c-b911-bd864a96a410"],

Cell["Solution", "ExerciseSolution",
 CellID->30617050,ExpressionUUID->"7229cdd2-1763-b340-b970-ee2e2aaff858"],

Cell[CellGroupData[{

Cell["Calculate the Wigner representation for \[Alpha] = 0.5:", "ExerciseNote",
 CellID->227023302,ExpressionUUID->"890c2938-6dcb-2942-bf03-b25a282d0240"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"s", " ", "=", " ", 
   RowBox[{
    SuperscriptBox["a", "\[Dagger]"], "@", 
    RowBox[{
     RowBox[{"CoherentState", "[", "]"}], "[", "0.5", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wig", " ", "=", " ", 
   RowBox[{"WignerRepresentation", "[", 
    RowBox[{"s", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "6"}], ",", "6"}], "}"}]}], "]"}]}], 
  ";"}]}], "ExerciseInput",
 CellLabel->"In[271]:=",
 CellID->251519787,ExpressionUUID->"af20cd08-15a0-7141-872b-0eb00ef86b03"]
}, Open  ]],

