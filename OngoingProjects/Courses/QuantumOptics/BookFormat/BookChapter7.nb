Cell[BoxData[
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"DensityPlot", "[", 
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"x", ",", "p"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", 
           RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
         InterpretationBox[
          DynamicModuleBox[{Typeset`open = False}, 
           TemplateBox[{"Expression", "SequenceIcon", 
             GridBox[{{
                RowBox[{
                  TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                  TagBox["Sequence", "IconizedItem"]}]}, {
                RowBox[{
                  TagBox["\"Length: \"", "IconizedLabel"], 
                  "\[InvisibleSpace]", 
                  TagBox["5", "IconizedItem"]}]}, {
                RowBox[{
                  TagBox["\"Byte count: \"", "IconizedLabel"], 
                  "\[InvisibleSpace]", 
                  TagBox["624", "IconizedItem"]}]}}, 
              GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
              "Column", 
              GridBoxItemSize -> {
               "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
             Dynamic[Typeset`open]},
            "IconizedObject"]],
          Sequence[
          PlotPoints -> 100, ColorFunctionScaling -> False, ColorFunction -> 
           ColorData[{"CMYKColors", {-0.3, 0.3}}], PlotRange -> All, 
           ImageSize -> 150],
          SelectWithContents->True,
          Selectable->False]}], "]"}], "&"}], ")"}], "/@", 
     RowBox[{"wigFuncs", "\[LeftDoubleBracket]", 
      RowBox[{"4", ";;", "6"}], "\[RightDoubleBracket]"}]}], "]"}], ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", 
       RowBox[{"BarLegend", "[", 
         DynamicBox[
          FEPrivate`FrontEndResource["FEBitmaps", "IconizeEllipsis"]], "]"}], 
       GridBox[{{
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["592", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    BarLegend[{"CMYKColors", {-(3/10), 3/10}}],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "ExerciseInput",
