Cell["\<\
For a displaced squeezed state the mean number of photons is \
\>", "Text",
 CellEvaluationLanguage->"Python",
 CellChangeTimes->{{3.9258446153376503`*^9, 3.925844664958004*^9}, {
  3.925845435120182*^9, 3.925845637145697*^9}, {3.9309164099784184`*^9, 
  3.930916439188095*^9}, {3.930918048117815*^9, 3.9309180570061474`*^9}, {
  3.93091867455097*^9, 3.930918698486927*^9}, {3.934890011912136*^9, 
  3.934890028599968*^9}, {3.9348900847390137`*^9, 3.9348900893027477`*^9}, {
  3.9348901349040527`*^9, 3.934890150213917*^9}, {3.9538526429483757`*^9, 
  3.9538526667099*^9}, {3.9681549256557884`*^9, 3.968154938077097*^9}},
 CellID->623539364,ExpressionUUID->"d9d46304-1cab-114c-8e70-1f0fcfca6ae9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    OverscriptBox["n", "^"], "\[RightAngleBracket]"}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"|", "\[Alpha]", "|"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"sinh", "(", "r", ")"}], "2"]}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{{3.9859481464798946`*^9, 3.985948168952778*^9}},
 CellID->46393182,ExpressionUUID->"2b903d09-1a55-b24a-920f-5453a0d25b14"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "->", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "27f3282f-3f14-e84b-913c-c99fe5301cbe"],
 " the results for a coherent state are recovered, or when \[Alpha] \[Rule] 0 \
 the results of squeezed vacuum are recovered"
}], "Text",
 CellEvaluationLanguage->"Python",
 CellID->32864723,ExpressionUUID->"ea8b48a3-d94f-c14e-8cc1-ea2f004bd9b5"],

Cell[TextData[StyleBox["Displaced squeezed state:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681549658852425`*^9, 3.9681549697407513`*^9}},
 CellID->88554793,ExpressionUUID->"9408a306-d03b-9a4d-8680-91114160fc6d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dispSqueezed", " ", "=", " ", 
   RowBox[{
    RowBox[{"DisplacementOperator", "[", "\[Alpha]coh", "]"}], "@", " ", 
    RowBox[{
     RowBox[{"SqueezeOperator", "[", "\[Xi]1", "]"}], "[", "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.92576702032617*^9, 3.9257670327688904`*^9}, {
   3.925767617416502*^9, 3.9257676280118217`*^9}, 3.925771281378771*^9, {
   3.9348898224542217`*^9, 3.934889831810438*^9}},
 CellLabel->"In[56]:=",
 CellID->28132118,ExpressionUUID->"60028e1c-0f85-254f-80e3-0a3bde614ca7"],

Cell[TextData[StyleBox["Mean number of photons comparison:", "Text"]], \
"CodeText",
 CellChangeTimes->{{3.96815498082806*^9, 3.968154986271097*^9}},
 CellID->430372309,ExpressionUUID->"fb667ebc-01fb-1f46-919f-605f4658a967"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"QuantumMeasurementOperator", "[", 
       RowBox[{
        SuperscriptBox["a", "\[Dagger]"], "@", "a"}], "]"}], "@", " ", 
      "dispSqueezed"}], ")"}], "[", "\"\<Mean\>\"", "]"}], ",", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Abs", "[", "\[Alpha]coh", "]"}], "2"], " ", "+", 
    SuperscriptBox[
     RowBox[{"Sinh", "[", 
      RowBox[{"Abs", "[", "\[Xi]1", "]"}], "]"}], "2"]}]}], "}"}]], "Input",
 CellChangeTimes->{{3.925843490146848*^9, 3.925843576836752*^9}, {
  3.92584515311376*^9, 3.92584519989299*^9}, {3.9309164820475407`*^9, 
  3.9309165003104515`*^9}, {3.93488986333976*^9, 3.9348898677696514`*^9}},
 CellLabel->"In[57]:=",
 CellID->187335911,ExpressionUUID->"3a172219-db87-7849-ae3d-843682f519eb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"10.645327783670808`", ",", "10.64532778366219`"}], "}"}]], "Output",
 CellLabel->"Out[57]=",
 CellID->724096837,ExpressionUUID->"1ad961ce-aa81-2f4b-8afd-0d581e7bdbba"]
}, Open  ]],

Cell[TextData[{
 "For this state it still holds ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[CapitalDelta]", " ", 
        SubscriptBox["Y", "1"]}], ")"}], "2"], "\[RightAngleBracket]"}], "=", 
    RowBox[{
     FractionBox["1", "4"], 
     SuperscriptBox["e", 
      RowBox[{
       RowBox[{"-", "2"}], "r"}]]}]}], TraditionalForm]], "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{{3.9859481464798946`*^9, 3.985948168952778*^9}},
  ExpressionUUID->"d39a6fc5-8c0b-894e-8df9-8e60b07c02c1"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[CapitalDelta]", " ", 
        SubscriptBox["Y", "2"]}], ")"}], "2"], "\[RightAngleBracket]"}], "=", 
    RowBox[{
     FractionBox["1", "4"], 
     SuperscriptBox["e", 
      RowBox[{"2", "r"}]]}]}], TraditionalForm]], "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{{3.985948146480892*^9, 3.985948168952778*^9}},
  ExpressionUUID->"742372be-d6d9-6846-bddb-36377aa80c8d"],
 "\nThat can be interpreted that the error ellipses keep their shape for any \
\[Xi], the center is displaced by \[Alpha] maintaining the ellipse shape"
}], "Text",
 CellID->17958229,ExpressionUUID->"b680823c-a304-0640-b147-80d3fbe39ae0"],

Cell[TextData[StyleBox["Variance calculation:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681552674865093`*^9, 3.9681552796910267`*^9}},
 CellID->201598443,ExpressionUUID->"8e13a3d9-e547-a048-958a-3d193bb86ef7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"Abs", "[", "\[Xi]1", "]"}]}], ",", " ", 
     RowBox[{"\[Theta]1", " ", "=", " ", 
      RowBox[{"Arg", "[", "\[Xi]1", "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"OperatorVariance", "[", 
         RowBox[{"dispSqueezed", ",", "#"}], "]"}], "&"}], " ", "/@", " ", 
       RowBox[{"Through", "[", 
        RowBox[{"YOperators", "[", "\[Theta]1", "]"}], "]"}]}], "//", 
      "Chop"}], ",", 
     RowBox[{
      RowBox[{"1", "/", "4"}], 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "2"}], "r"}], "]"}], ",", 
        RowBox[{"Exp", "[", 
         RowBox[{"2", "r"}], "]"}]}], "}"}]}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.925845804450739*^9, 3.92584584700124*^9}, {
  3.925845883855503*^9, 3.92584590071034*^9}, {3.934891010938032*^9, 
  3.9348910113529854`*^9}, {3.9348910413766727`*^9, 3.934891067851076*^9}},
 CellLabel->"In[58]:=",
 CellID->99553688,ExpressionUUID->"55ce5c93-0f39-7249-82a9-ea53558bc46b"],

