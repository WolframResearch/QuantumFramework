Cell[CellGroupData[{

Cell[TextData[StyleBox["Properties of a squeezed vacuum state", \
"Subsubsection"]], "Subsubsection",
 CellChangeTimes->{{3.9309235776030807`*^9, 3.930923587853016*^9}, {
  3.968155728769005*^9, 3.9681557404964085`*^9}},
 CellID->902868798,ExpressionUUID->"40a2383c-d6cc-c846-98f2-ad5ae5f1a554"],

Cell["\<\
For a squeezed vacuum state it can be shown mathematically that  the photon \
distribution only has non zero values for states with even number of photons\
\>", "Text",
 CellID->45693531,ExpressionUUID->"9bb38e4a-e01f-a741-bc7a-a132004e7cb9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"|", "\[Xi]", "\[RightAngleBracket]"}], "=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      RowBox[{"cosh", "(", "r", ")"}]]], 
    RowBox[{
     UnderoverscriptBox[
      StyleBox["\[Sum]",
       FontWeight->"Bold"], 
      RowBox[{"m", "=", "0"}], "\[Infinity]"], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", 
         StyleBox["1", "CodeText"]}], ")"}], "m"], 
      FractionBox[
       SqrtBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "m"}], ")"}], "!"}]], 
       RowBox[{
        SuperscriptBox["2", "m"], 
        RowBox[{"m", "!"}]}]], 
      SuperscriptBox["e", 
       RowBox[{"\[ImaginaryI]", " ", "m", " ", "\[Theta]"}]], 
      SuperscriptBox[
       RowBox[{"tanh", "(", "r", ")"}], "m"], Cell[
      "|",ExpressionUUID->"bb463122-1bc4-2d45-9108-deb183d1f892"], "2", "m", 
      Cell["\[RightAngleBracket]",ExpressionUUID->
       "a4330cc5-2c3b-a74b-9072-4713cbd92928"]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->29926031,ExpressionUUID->"98eb7176-407d-0b45-9e24-c53515e6c2a3"],

