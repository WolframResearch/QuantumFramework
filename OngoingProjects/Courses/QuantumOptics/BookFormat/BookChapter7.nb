Cell[TextData[{
 "For a general  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Xi]", " ", "=", " ", 
    RowBox[{"r", " ", 
     SuperscriptBox["e", "\[ImaginaryI]\[Theta]"]}]}], TraditionalForm]],
  ExpressionUUID->"5a1d02c3-44f5-1743-b613-1f354b5824e8"],
 " we can define rotated quadrature operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Y", "1"], " ", "=", " ", 
    RowBox[{
     RowBox[{"cos", "(", 
      RowBox[{"\[Theta]", "/", "2"}], ")"}], Cell[TextData[{
      Cell[BoxData[
       FormBox[
        RowBox[{
         SubscriptBox["X", "1"], "+", " ", 
         RowBox[{
          RowBox[{"sin", "(", 
           RowBox[{"\[Theta]", "/", "2"}], ")"}], 
          SubscriptBox["X", "2"]}]}], TraditionalForm]],ExpressionUUID->
       "c5108c6a-6058-f745-b134-0f034999192c"],
      "  and ",
      Cell[BoxData[
       FormBox[
        RowBox[{
         SubscriptBox["Y", 
          RowBox[{"2", " "}]], "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"sin", "(", 
             RowBox[{"\[Theta]", "/", "2"}], ")"}]}], 
           SubscriptBox["X", "1"]}], "+", 
          RowBox[{
           RowBox[{"cos", "(", 
            RowBox[{"\[Theta]", "/", "2"}], ")"}], 
           SubscriptBox["X", "2"]}]}]}], TraditionalForm]],ExpressionUUID->
       "7abc8659-945b-594d-96c8-d64630de0066"]
     }],ExpressionUUID->"586dce7c-9a32-fc46-827e-82aec9f33966"]}]}], 
   TraditionalForm]],ExpressionUUID->"54badebb-8f0c-af43-9b10-17c3a93d4c0f"],
 " such that the variances are calculated along the rotated quadrature axes. \
For these operators  the variances are ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SuperscriptBox[
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"\[CapitalDelta]", " ", 
       SubscriptBox["Y", "1"]}], " ", "\[RightAngleBracket]"}], "2"]}], 
   TraditionalForm]],ExpressionUUID->"c13e54b0-9813-9b4b-adb4-3375ddacf551"],
 " = 1/4 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{
     RowBox[{"-", "2"}], "r"}]], TraditionalForm]],ExpressionUUID->
  "955f3eef-c910-1a4a-a7ec-b72391f56caf"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SuperscriptBox[
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"\[CapitalDelta]", " ", 
       SubscriptBox["Y", "2"]}], " ", "\[RightAngleBracket]"}], "2"]}], 
   TraditionalForm]],ExpressionUUID->"a5b37b31-b01e-8c46-b2ae-9706a3e5c2b9"],
 " = 1/4 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"2", "r"}]], TraditionalForm]],ExpressionUUID->
  "86c4eaf2-424b-e84d-adf7-1ccd4cee0853"],
 " .  At  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Theta]", " ", "=", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "bea7d195-8fcd-4843-9cb8-e31b5b4c821a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Y", 
     RowBox[{"1", " "}]], " ", "and", " ", 
    SubscriptBox["Y", "2"], " ", "reduce", " ", "to", " ", 
    SubscriptBox["X", "1"], " ", "and", " ", 
    SubscriptBox["X", "2"]}], TraditionalForm]],ExpressionUUID->
  "4b58e7cc-0076-9a43-adc9-af1477499c6c"]
}], "Text",
 CellID->132712055,ExpressionUUID->"1e9d6116-d087-b644-8ba8-167ef27b4398"],

Cell[TextData[StyleBox["Rotated quadrature operators:", "Text"]], "CodeText",
 CellID->341657453,ExpressionUUID->"fc456e51-84a2-124c-81a1-f9bda7d02f43"],

Cell[BoxData[
 RowBox[{"YOperators", " ", ":=", 
  RowBox[{
   RowBox[{"(", " ", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"#", ",", 
       RowBox[{"\"\<Parameters\>\"", "->", "\[Theta]"}]}], "]"}], "&"}], " ", 
    ")"}], "/@", 
   RowBox[{"(", " ", 
    RowBox[{
     RowBox[{"RotationMatrix", "[", 
      RowBox[{
       RowBox[{"-", "\[Theta]"}], "/", "2"}], "]"}], ".", 
     RowBox[{"QuadratureOperators", "[", "]"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.934845908389511*^9, 3.934845943443125*^9}, {
   3.9348459781419563`*^9, 3.9348461112398844`*^9}, {3.934846929203386*^9, 
