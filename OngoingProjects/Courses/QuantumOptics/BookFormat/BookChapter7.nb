   RowBox[{"Abs", "[", "\[Xi]1", "]"}], "]"}], "2"]], "Input",
 CellChangeTimes->{{3.932479359914215*^9, 3.9324794563136797`*^9}, {
   3.9324795808795567`*^9, 3.9324796145325747`*^9}, {3.932479730404745*^9, 
