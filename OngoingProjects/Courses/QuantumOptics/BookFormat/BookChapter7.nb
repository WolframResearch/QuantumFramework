Cell[CellGroupData[{

Cell[TextData[StyleBox["Schrodinger cat states", "Subsection"]], "Subsection",
 CellChangeTimes->{{3.930917141464508*^9, 3.930917147925734*^9}},
 CellID->537094601,ExpressionUUID->"00c4f890-37bb-f340-9c21-790dee9be18e"],

Cell["\<\
Another important type of states with non-classical properties are \
superpositions of classical-like states.  Let\[CloseCurlyQuote]s analyze the \
superposition of coherent states with equal amplitude magnitude but with a \
phase difference of \[Pi] (\[Alpha] and -\[Alpha])  so the state has the form\
\>", "Text",
 CellID->490375582,ExpressionUUID->"a0f85fea-318b-b840-bb92-05bd5a5a37af"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
    Cell["|",ExpressionUUID->"71f25d96-e460-d74c-b236-7e58a535b759"], 
     "\[Psi]", Cell[
     "\[RightAngleBracket]",ExpressionUUID->
      "fcaf6ad1-edf2-ee4e-932a-c7cef087d6b9"]}], "=", 
    RowBox[{
     RowBox[{"\[ScriptCapitalN]", "(", 
      RowBox[{
       RowBox[{
       Cell["|",ExpressionUUID->"0cbe78a2-6143-6c4b-8a99-6555213773a4"], 
        "\[Alpha]", Cell[
        "\[RightAngleBracket]",ExpressionUUID->
         "92d3767e-b8e0-cd49-a32a-9e77be47a299"]}], "+", 
       RowBox[{
        SuperscriptBox["e", 
         RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]], Cell[
        "|",ExpressionUUID->"7202c97f-185e-2b4f-9c75-0e3695114cfe"]}], "-", 
       RowBox[{
       "\[Alpha]", Cell[
        "\[RightAngleBracket]",ExpressionUUID->
         "ca6027c9-67a7-084c-9425-c13777d41bb4"]}]}], ")"}], "  ", "where", " ",
      "\[ScriptCapitalN]", " ", "is", " ", Cell[
     "a",ExpressionUUID->"49987565-060d-1549-846c-dacebddf6922"], " ", 
     "normalization", " ", "factor"}]}], " ", ",", " ", 
   RowBox[{"\[Phi]", " ", "relative", " ", "phase", " "}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->319255545,ExpressionUUID->"c2409444-0658-9143-ae5f-83b9d7be6504"],

Cell[TextData[{
 "When |\[Alpha]| is large the states are macroscopically distinguishable  \
and the superpositions are called Schrodinger cat states( resembling the dead \
or alive state), Schrodinger\[CloseCurlyQuote]s intention was to mock the \
Copenhagen interpretation of quantum mechanics. Nowadays, it is possible to \
consider quantum superpositions of macroscopically distinguishable states in \
an experimental setup. The reason of why we do not observe superpositions of \
macroscopic states naturally, is because a quantum system is not  completely \
isolated,  it interacts with the environment and as a result quantum \
superpositions ",
 StyleBox["decohere",
  IgnoreSpellCheck->True],
 " into statistical mixtures. The state decays into a statistical mixture of \
the form  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Rho]", "^"], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"|", "\[Beta]", "\[RightAngleBracket]"}], 
        RowBox[{"\[LeftAngleBracket]", "\[Beta]", "|"}]}], "+", 
       RowBox[{
        RowBox[{"|", 
         RowBox[{"-", "\[Beta]"}], "\[RightAngleBracket]"}], 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{"-", "\[Beta]"}], "|"}]}]}], ")"}], "/", "2"}]}], 
   TraditionalForm]], "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{{3.9859481464931927`*^9, 3.985948168963091*^9}},
  ExpressionUUID->"a855f566-f9f1-fb49-b30e-7e1e3442437f"],
 ", and when |\[Alpha]| is big that decay is faster, for now we will focus on \
the non-classical properties of these states.  "
}], "Text",
 CellID->161304359,ExpressionUUID->"e7289df4-7e47-9546-9e53-829d53387fd2"],

Cell[TextData[{
 "Based on the general definition of a Schrodinger cat state, setting \[Phi] \
= 0 yields a state called even cat state, while setting \[Phi] = \[Pi] \
results in an odd cat state. The case when \[Phi] = \[Pi]/2 is known as the ",
 StyleBox["Yurke",
  IgnoreSpellCheck->True],
 "-",
 StyleBox["Stoler",
  IgnoreSpellCheck->True],
 " state. Notably, all three of these states are eigenstates of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox["a", "^"], "2"], " ", "with", " ", "eigenvalue", " ", 
    SuperscriptBox["\[Alpha]", "2"]}], TraditionalForm]],ExpressionUUID->
  "5e3aa979-77c5-3d44-a4d5-3cf2f24512a9"]
}], "Text",
 CellID->384815191,ExpressionUUID->"2ed7c762-3d1b-fa4b-8903-121ef4f1d8e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "21", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.932483758538513*^9, 3.932483949019672*^9}, {
  3.932487209292959*^9, 3.9324872143232512`*^9}, {3.932491463736582*^9, 
  3.932491464966768*^9}, {3.9350612514301567`*^9, 3.9350612656342697`*^9}, {
  3.935061508270277*^9, 3.9350615256410713`*^9}, {3.935061572389477*^9, 
  3.9350615825985336`*^9}, {3.973599095142206*^9, 3.973599095477335*^9}},
 CellLabel->"In[184]:=",
 CellID->161247429,ExpressionUUID->"c454a307-c335-3a49-8093-36fa47cf8828"],

Cell["\<\
Lets visualize the photon distributions, the even cat state only has non zero \
amplitudes at even Fock states:\
\>", "Text",
 CellID->162041421,ExpressionUUID->"e514a7b6-31dd-304e-b8e0-891bf7a4a817"],

