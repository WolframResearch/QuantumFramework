Cell[TextData[{
 "The modes are symmetric in their photon distribution ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    SubscriptBox["n", "a"], "\[RightAngleBracket]"}], TraditionalForm]],
  ExpressionUUID->"3c549cb9-f59a-8f47-8763-006962addaa0"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    SubscriptBox["n", "b"], "\[RightAngleBracket]"}], TraditionalForm]],
  ExpressionUUID->"fe52bed9-456f-bb4d-bb57-fd8100f26db7"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["sinh", "2"], "(", "r", ")"}], TraditionalForm]],
  ExpressionUUID->"b752f1e7-0d8d-7c48-b692-91e533507ff5"]
}], "Text",
 CellChangeTimes->{{3.932480033838417*^9, 3.9324801282564487`*^9}, {
  3.932480232429308*^9, 3.932480240623829*^9}},
 CellID->146955504,ExpressionUUID->"80e9f49d-a322-bb4a-aa68-46034e7e33e9"],

Cell[TextData[StyleBox["Calculating the expectations:", "Text"]], "CodeText",
 CellChangeTimes->{{3.968171825125618*^9, 3.968171831589039*^9}, {
  3.9681719177369766`*^9, 3.9681719183776417`*^9}},
 CellID->303024960,ExpressionUUID->"fa810edf-dba8-394a-b49f-3c24ca349446"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"state", "=", 
      RowBox[{"twoModesqueezeVacuum", "[", "\[Xi]1", "]"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         SuperscriptBox["state", "\[Dagger]"], "[", 
         RowBox[{"#1", "[", "state", "]"}], "]"}], "[", "\"\<Scalar\>\"", 
        "]"}], "&"}], ")"}], "/@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["a1", "\[Dagger]"], "[", "a1", "]"}], ",", 
       RowBox[{
        SuperscriptBox["b1", "\[Dagger]"], "[", "b1", "]"}]}], "}"}]}]}], 
   "]"}], "]"}]], "Input",
 CellLabel->"In[256]:=",
 CellID->691259460,ExpressionUUID->"6ca2251e-3648-054d-ace7-76d476d38187"],

