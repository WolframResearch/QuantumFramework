Cell[TextData[StyleBox["Phase space representation of the error ellipse:", \
"Text"]], "CodeText",
 CellChangeTimes->{{3.968155302072792*^9, 3.968155316035839*^9}},
 CellID->562246797,ExpressionUUID->"f3b383be-3c80-da47-bbdb-2e1d4b1f9d2c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]1", "=", 
      RowBox[{"Arg", "[", "\[Xi]1", "]"}]}], ",", "dx", " ", ",", "dy", ",", 
     " ", 
     RowBox[{"h", "=", 
      RowBox[{"Re", "[", "\[Alpha]coh", "]"}]}], ",", " ", 
     RowBox[{"k", " ", "=", " ", 
      RowBox[{"Im", "[", "\[Alpha]coh", "]"}]}]}], "}"}], ",", " ", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dx", " ", "=", " ", 
     RowBox[{"OperatorVariance", "[", 
      RowBox[{"dispSqueezed", ",", 
       RowBox[{
        RowBox[{"YOperators", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", "\[Theta]1", "]"}]}], "]"}]}], ";", 
    RowBox[{"dy", " ", "=", 
     RowBox[{"OperatorVariance", "[", 
      RowBox[{"dispSqueezed", ",", 
       RowBox[{
        RowBox[{"YOperators", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", "\[Theta]1", "]"}]}], "]"}]}], 
    " ", ";", 
    RowBox[{"Graphics", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"EdgeForm", "[", "Thick", "]"}], ",", "Green", ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Rotate", "[", 
         RowBox[{
          RowBox[{"Disk", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"h", ",", "k"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"dx", ",", "dy"}], "}"}]}], "]"}], ",", 
          RowBox[{"\[Theta]1", "/", "2"}]}], "]"}], ",", 
        "\[IndentingNewLine]", "Black", ",", "Dashed", ",", 
        RowBox[{"Line", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "+", 
            RowBox[{"{", 
             RowBox[{"h", ",", "k"}], "}"}]}], "&"}], "/@", 
          RowBox[{"Outer", "[", 
           RowBox[{"Times", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "dx"}], ",", "dx"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Cos", "[", 
               RowBox[{"\[Theta]1", "/", "2"}], "]"}], ",", 
              RowBox[{"Sin", "[", 
               RowBox[{"\[Theta]1", "/", "2"}], "]"}]}], "}"}]}], "]"}]}], 
         "]"}], ",", 
        RowBox[{"Line", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "+", 
            RowBox[{"{", 
             RowBox[{"h", ",", "k"}], "}"}]}], "&"}], " ", "/@", " ", 
          RowBox[{"Outer", "[", 
           RowBox[{"Times", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "dy"}], ",", "dy"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Sin", "[", 
                RowBox[{"\[Theta]1", "/", "2"}], "]"}]}], ",", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[Theta]1", "/", "2"}], "]"}]}], "}"}]}], "]"}]}], 
         "\[IndentingNewLine]", "]"}], ",", 
        RowBox[{"PointSize", "[", "0.022", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"h", ",", "k"}], "}"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"Dashing", "[", 
           RowBox[{"1", ",", "0", ",", "0"}], "]"}], ",", 
          RowBox[{"Arrow", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"h", ",", "k"}], "}"}]}], "}"}], "]"}], ",", 
          RowBox[{"Text", "[", 
           RowBox[{"\"\<\[Alpha]\>\"", ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"0.24", "*", "h"}], ",", "0"}], "}"}], "+", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"h", ",", "k"}], "}"}], "/", "2"}]}]}], "]"}]}], 
         "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Axes", "->", "True"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"ImageSize", "->", "Medium"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<X1\>\"", ",", "\"\<X2\>\""}], "}"}]}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "6"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"AspectRatio", "->", "0.6"}], ",", 
      RowBox[{"ImageSize", "->", "400"}]}], "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
