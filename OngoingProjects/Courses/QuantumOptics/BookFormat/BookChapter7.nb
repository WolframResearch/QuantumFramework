Cell["\<\
The two mode squeezed vacuum can be shown to be decomposed in the number \
state basis as\
\>", "Text",
 CellID->354952869,ExpressionUUID->"a10ff64c-22ff-6942-8492-1bc3767dc493"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
    Cell["|",ExpressionUUID->"8b417e43-7651-224a-a2ad-a40d788f66ca"], "\[Xi]", 
     SubscriptBox[Cell[
      "\[RightAngleBracket]",ExpressionUUID->
       "05d58dd1-53db-d947-9a8b-0686d0bbb877"], "2"]}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"cosh", " ", "r"}]], 
     RowBox[{
      UnderoverscriptBox[
       StyleBox["\[Sum]",
        FontWeight->"Bold"], 
       RowBox[{"n", "=", "0"}], "\[Infinity]"], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "n"], 
       SuperscriptBox["e", 
        RowBox[{"\[ImaginaryI]", " ", "n", " ", "\[Theta]"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"tanh", " ", "r"}], ")"}], "n"], Cell[
       "|",ExpressionUUID->"78ba09bb-a789-b240-972d-e3e4bfdfe0ba"], 
       "n"}]}]}]}], ",", 
   RowBox[{
   "n", Cell[
    "\[RightAngleBracket]",ExpressionUUID->
     "9e890d7f-ea04-5845-a002-851661821db1"]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->32994685,ExpressionUUID->"6d9bc86d-8c05-e141-b1df-7cb15536a689"],

Cell[TextData[{
 "So this state is entangled with  strong correlations such that only the \
states |",
