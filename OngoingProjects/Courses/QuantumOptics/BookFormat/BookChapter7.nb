Cell[TextData[{
 "For a coherent state we can extract the parameters easily, X(\[Phi] = 0) = \
X(\[Theta] = \[Dash]\[Pi]/2) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["X", "2"]}], TraditionalForm]],ExpressionUUID->
  "e32308fd-724d-464e-ae8e-7bba54349615"],
 " , and X(\[Phi] = \[Pi]/2) = X(\[Theta] = 0) = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "1"], TraditionalForm]],ExpressionUUID->
  "0122f8a4-2a7e-a142-8128-3c7c46f550a1"],
 " so the real and imaginary part of the \[Alpha] amplitude can be obtained"
}], "Text",
 CellID->349325365,ExpressionUUID->"2e58807c-e56a-2342-b52a-eaa48720beb8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"X", "[", "0", "]"}], "==", 
    RowBox[{
     RowBox[{"QuadratureOperators", "[", "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ",", 
   RowBox[{
    RowBox[{"X", "[", 
     RowBox[{"\[Pi]", "/", "2"}], "]"}], "==", 
    RowBox[{
     RowBox[{"QuadratureOperators", "[", "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]], "Input",
 CellLabel->"In[28]:=",
 CellID->82401289,ExpressionUUID->"7aa93ed3-a826-514e-9146-08c36f64c2d1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[28]=",
 CellID->22814149,ExpressionUUID->"e5837a9b-1e20-cb46-bc38-60049ab54ba5"]
}, Open  ]],

