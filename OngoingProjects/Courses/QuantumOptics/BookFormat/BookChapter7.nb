Cell[TextData[StyleBox["Equal probabilities:", "Text"]], "CodeText",
 CellChangeTimes->{{3.968167863082491*^9, 3.968167878927944*^9}},
 CellID->99460836,ExpressionUUID->"4a264f24-c28f-bd4f-9f64-ab1a0301140e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"CatState", "[", "]"}], "[", 
     RowBox[{"2.", ",", 
      RowBox[{"\[Pi]", "/", "2"}]}], "]"}], "[", "\"\<ProbabilityList\>\"", 
    "]"}], "-", 
   RowBox[{
    RowBox[{
     RowBox[{"CoherentState", "[", "]"}], "[", "2.", "]"}], 
    "[", "\"\<ProbabilityList\>\"", "]"}]}], "]"}]], "Input",
 CellLabel->"In[99]:=",
 CellID->303746288,ExpressionUUID->"4e0966a9-cafe-7147-a646-7694dcf1113b"],

Cell[BoxData[
 RowBox[{"{", 
