Cell[BoxData[
 RowBox[{
  RowBox[{"meanPhotons", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"Dot", "[", 
        RowBox[{"fock", ",", 
         RowBox[{"Diagonal", "[", 
          RowBox[{
           RowBox[{"\[Rho]t", "[", "t", "]"}], "[", "\"\<DensityMatrix\>\"", 
           "]"}], "]"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "time"}], "}"}]}], "]"}]}], " ", ";"}]], "Input",
