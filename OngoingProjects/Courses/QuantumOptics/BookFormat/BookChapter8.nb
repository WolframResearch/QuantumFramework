Cell[TextData[{
 "We can find the steady state of the evolution when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Rho]", "."], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b492f54d-357f-e04d-bdd0-ffe35629d8bd"],
 ", which amounts to finding the null space of \[ScriptCapitalL] or solving ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ScriptCapitalL]", "(", "\[Rho]", ")"}], "=", "0"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d0490233-6d81-3340-bf82-14839b54e7c5"],
 ":"
}], "Text",
 CellID->305109336,ExpressionUUID->"c6ca90d1-51d1-e34d-9766-6ac501c7b3cb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]steady", " ", "=", " ", 
   RowBox[{"Partition", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"NullSpace", "[", 
       RowBox[{"\[ScriptCapitalL]", "[", "\"\<Matrix\>\"", "]"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", "$FockSize"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[295]:=",
 CellID->18357278,ExpressionUUID->"f5b84256-e2b2-f94d-a27b-2ca58f81f340"],

Cell[TextData[{
 "Fidelity distance between the steady state and ",
 Cell[BoxData[
  FormBox[
   RowBox[{Cell["|",ExpressionUUID->"2e6202e8-b91b-8b43-8580-aa0178077379"], "-", 
    RowBox[{"2", "\[ImaginaryI]", " ", 
     RowBox[{"G", "/", "\[Gamma]"}], Cell[
     "\[RightAngleBracket]",ExpressionUUID->
      "ac328ad8-960e-c446-b615-eaec46074c37"]}]}], TraditionalForm]],
  ExpressionUUID->"97a9504e-06e2-9c43-8e01-737cb68ccf1f"],
 ", a distance returns how far are the states apart:"
}], "Text",
 CellID->107975068,ExpressionUUID->"606b6232-ffa1-544e-b2f8-3c3071dd9e8a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumDistance", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumState", "[", " ", 
     RowBox[{"\[Rho]steady", ",", "$FockSize"}], "]"}], 
    "[", "\"\<Normalize\>\"", "]"}], ",", 
   RowBox[{
    RowBox[{"CoherentState", "[", "]"}], "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", "2", 
     RowBox[{"G", "/", "\[Gamma]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[299]:=",
 CellID->726237,ExpressionUUID->"582a0959-67fe-7145-a614-378db02d8aa8"],

Cell[BoxData["6.213496384077644`*^-10"], "Output",
 CellLabel->"Out[299]=",
 CellID->239532231,ExpressionUUID->"03e3d88f-c8a3-7045-b94c-6f355de1f347"]
}, Open  ]],

Cell[TextData[{
 "If we have an initial vacuum state  ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Rho]", "^"], TraditionalForm]],ExpressionUUID->
  "702ef2e3-28cf-3540-b928-1e344d207a46"],
 "(0) = |0\[RightAngleBracket] \[LeftAngleBracket]0| at short enough times we \
ignore dissipation. The evolution will be unitary and we will get a coherent \
state  of the form \[VerticalSeparator] -\[ImaginaryI] ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "1bc06515-610b-5549-b64f-b2d3fff796b0"],
 " t \[RightAngleBracket]\[LeftAngleBracket]- \[ImaginaryI] ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "c84d139c-529e-b841-9c35-95450b8ca6fd"],
 " t | independent of \[Gamma] . Fidelity remains around 1 for small times \
until the approximation is no longer valid"
}], "Text",
 CellChangeTimes->{{3.927297842429279*^9, 3.927298031486595*^9}, {
   3.927305585247563*^9, 3.927305611983265*^9}, 3.968178672094532*^9, {
   3.9727335751099606`*^9, 3.9727335854489975`*^9}, {3.9727336222936554`*^9, 
   3.9727336224645977`*^9}},
 CellID->695938505,ExpressionUUID->"2aeb0f1a-1533-3441-aa6c-6ac4d6fc308f"],

Cell["Evolving the ground state:", "Text",
 CellChangeTimes->{
  3.9542410128963737`*^9, {3.968178678352749*^9, 3.9681786795875053`*^9}},
 CellID->76726705,ExpressionUUID->"66e9be03-d824-864b-b2e1-0fb526887fc5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]t", " ", "=", 
   RowBox[{"QuantumEvolve", "[", " ", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", "\[ScriptCapitalL]"}], ",", 
     RowBox[{"FockState", "[", "0", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.927298036577057*^9, 3.92729807059173*^9}, {
   3.9326466897639074`*^9, 3.9326467263951826`*^9}, {3.935058553113802*^9, 
   3.9350585558691425`*^9}, 3.95424101959614*^9},
 CellLabel->"In[300]:=",
 CellID->345697552,ExpressionUUID->"9775dc98-59e6-ee47-bb27-6b42a3c8609f"],

Cell[TextData[StyleBox["Auxiliary variables for time steps and Fock \
numbers:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681787525003624`*^9, 3.9681787665843678`*^9}},
 CellID->377300756,ExpressionUUID->"6f5bd3d2-d336-164d-aa52-825a126dabe0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"time", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "1.", ",", "0.02"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fock", " ", "=", 
   RowBox[{
    RowBox[{"Range", "[", "$FockSize", "]"}], "-", "1"}]}], ";"}]}], "Input",
 CellLabel->"In[309]:=",
 CellID->189675329,ExpressionUUID->"0b6579fb-4c4c-c34f-ac97-29b2db3e713f"],

Cell[TextData[StyleBox["Computing fidelity and mean photon number:", \
"Text"]], "CodeText",
 CellChangeTimes->{{3.968178715757183*^9, 3.9681787320514755`*^9}, {
  3.96817876941346*^9, 3.968178779529604*^9}, {3.9727336546104565`*^9, 
  3.9727336551869335`*^9}},
 CellID->448409876,ExpressionUUID->"71606b1b-2142-9346-bde8-42f407546f3e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qs", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumSimilarity", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CoherentState", "[", "]"}], "[", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "G", " ", "#"}], "]"}], ",", 
       RowBox[{"\[Rho]t", "[", "#", "]"}]}], "]"}], "&"}], " ", "/@", " ", 
    "time"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"meanN", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{"fock", ".", 
       RowBox[{"Diagonal", "[", 
        RowBox[{
         RowBox[{"\[Rho]t", "[", "#", "]"}], "[", "\"\<DensityMatrix\>\"", 
         "]"}], "]"}]}], "]"}], "&"}], " ", "/@", " ", "time"}]}], " ", 
  ";"}]}], "Input",
 CellLabel->"In[311]:=",
 CellID->216001225,ExpressionUUID->"8d039efe-468f-6040-b829-172f868c672a"],

Cell[TextData[StyleBox["Plot the statistics:", "Text"]], "CodeText",
 CellChangeTimes->{{3.968178783520233*^9, 3.968178787880274*^9}},
 CellID->421104160,ExpressionUUID->"19fe35f5-c8d2-284c-abb5-c5e191819c42"],

