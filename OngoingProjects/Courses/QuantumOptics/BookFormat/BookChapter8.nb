Cell[TextData[{
 "Energy exchange between cavities (allowing decay) can be modelled with the \
jump operator (\[Mu] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "1"], TraditionalForm]],ExpressionUUID->
  "46d39d1f-86b9-3a4f-9d63-6b52be8cbe29"],
 " - \[Lambda] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["a", "2"], "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "dac8d0a1-cb99-a84d-a4ec-c8e3b82fa225"],
 "), where \[Mu] and \[Lambda] are parameters. Consider an initial state |1,1\
\[RightAngleBracket] and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", ">", "\[Lambda]"}], TraditionalForm]],ExpressionUUID->
  "99ad9772-86bc-9c4a-994a-a54c5484b085"],
 ". How does the entanglement of the two mode system behaves as function of \
time?"
}], "Exercise",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{
  3.9727448417665863`*^9, {3.9731668979132137`*^9, 3.9731669433567505`*^9}, {
   3.9731670521758537`*^9, 3.9731672153207912`*^9}, {3.973167251279997*^9, 
   3.9731673737265625`*^9}},
 CellID->228206043,ExpressionUUID->"16ffb33d-4739-b744-a195-dce2ac2998ef"],

Cell[CellGroupData[{

Cell["Solution", "ExerciseSolution",
 CellID->652494427,ExpressionUUID->"3caf7f13-e086-c945-920a-72384dd698ad"],

Cell[CellGroupData[{

Cell["Set the size of the Fock space:", "SolutionAnswer",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->360968946,ExpressionUUID->"6e362301-e5b6-6e45-81f0-5dae32a2d16b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "10", "]"}], ";"}]], "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[11]:=",
 CellID->23602084,ExpressionUUID->"84f924f0-72fd-a044-8960-80a78384850b"],

Cell["Operators of the two modes:", "SolutionAnswer",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->17987314,ExpressionUUID->"4f996e6e-7fd8-5446-91c4-6d88c871a9b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}], "=", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"AnnihilationOperator", "[", 
       RowBox[{"{", "#", "}"}], "]"}], "&"}], ",", "2"}], "]"}]}], 
  ";"}]], "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[12]:=",
 CellID->281080680,ExpressionUUID->"9b199553-06c0-5645-8ba8-d760f4a05e80"],

Cell["Initial state:", "SolutionAnswer",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->64766242,ExpressionUUID->"28718370-dd80-3c49-9d09-f1f577fa1d9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{"FockState", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}], "]"}]}], ";"}]], "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[13]:=",
 CellID->865277160,ExpressionUUID->"5bcb42ac-657d-ba44-951f-d0b81e054a64"],

Cell["Setting \[Mu] and \[Lambda]:", "SolutionAnswer",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->207996727,ExpressionUUID->"dafa26a3-6097-e54a-985d-c4478ed37049"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Mu]", ",", "\[Lambda]"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"0.6", ",", "0.2"}], "}"}]}], ";"}]], "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[14]:=",
 CellID->234462745,ExpressionUUID->"b2c72a62-582f-2241-82a7-7871549fb363"],

Cell[TextData[{
 "Build Liouvillian with jump operator \[Mu] a - \[Lambda] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["b", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "278ee995-b78d-ad40-9a54-9b718394c17e"],
 ":"
}], "SolutionAnswer",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->38168806,ExpressionUUID->"36089d62-3701-f449-a948-f379aaa5d366"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalL]", " ", "=", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Liouvillian\>\"", "[", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Mu]", " ", "a"}], " ", "-", " ", 
        RowBox[{"\[Lambda]", " ", 
         SuperscriptBox["b", "\[Dagger]"]}]}], "}"}], ",", 
      RowBox[{"{", "0.6", "}"}]}], "]"}], "]"}]}], ";"}]], "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[15]:=",
 CellID->292806986,ExpressionUUID->"b35f0b76-b70c-5441-ac16-043dbdf409f0"],

Cell["Evolve the state:", "SolutionAnswer",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->243182819,ExpressionUUID->"6f00a392-53e2-7446-b0e1-3f3ca3e247b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evolved", "=", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{"I", " ", "\[ScriptCapitalL]"}], ",", "\[Rho]0", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "4"}], "}"}]}], "]"}]}], 
  ";"}]], "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[16]:=",
 CellID->399520118,ExpressionUUID->"50a5757d-e7be-9542-8bfa-8685d3de9107"],

