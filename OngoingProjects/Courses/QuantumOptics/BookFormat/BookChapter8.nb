Cell[CellGroupData[{

Cell["Worked Example: squeezing in a parametric oscillator", "Subsubsection",
 CellID->208981051,ExpressionUUID->"d15cf887-aed2-7d4b-aa9a-4f80066bd831"],

Cell["\<\
A degenerate parametric oscillator driven by a strong classical pump is \
described, in the pump\[CloseCurlyQuote]s rotating frame, by\
\>", "Text",
 CellID->54682109,ExpressionUUID->"50752765-683b-184c-8c4a-8ac32179211f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"H", " ", "=", " ", 
    RowBox[{"\[ImaginaryI]", " ", 
     FractionBox["\[CurlyEpsilon]", "2"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        SuperscriptBox["a", "\[Dagger]"], "2"], "-", 
       SuperscriptBox["a", "2"]}], ")"}]}]}], ",", "     ", 
   RowBox[{"L", "=", 
    RowBox[{
     SqrtBox["\[Kappa]"], "a"}]}]}], TraditionalForm]], "DisplayFormula",
 CellID->41980251,ExpressionUUID->"5434e1de-4d24-634c-a00e-e6bc637f2f8c"],

Cell[TextData[{
 "With the pump held fixed (no depletion) the problem is quadratic, the FPE \
is exactly second order, and nothing is approximated. The commutator reads as \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     RowBox[{"\[ImaginaryI]", "[", 
      RowBox[{"H", ",", " ", "\[Rho]"}], "]"}]}], "=", 
    RowBox[{
     FractionBox["\[CurlyEpsilon]", "2"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         SuperscriptBox["a", "\[Dagger]"], "2"], "\[Rho]"}], "-", 
       RowBox[{"\[Rho]", " ", 
        SuperscriptBox[
         SuperscriptBox["a", "\[Dagger]"], "2"]}], "-", 
       RowBox[{
        SuperscriptBox["a", "2"], "\[Rho]"}], "+", 
       RowBox[{"\[Rho]", " ", 
        SuperscriptBox["a", "2"]}]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1037ece0-a40e-f84c-bcaa-8bee41c52762"],
 " and we can use the previously defined photon loss action"
}], "Text",
 CellID->137386026,ExpressionUUID->"68f558e5-734f-724b-aab7-e2e044296dec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"parametric", "[", "f_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CurlyEpsilon]", "/", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"ad\[Rho]", "[", 
       RowBox[{"ad\[Rho]", "[", "f", "]"}], "]"}], "-", 
      RowBox[{"\[Rho]ad", "[", 
       RowBox[{"\[Rho]ad", "[", "f", "]"}], "]"}], "-", 
      RowBox[{"a\[Rho]", "[", 
       RowBox[{"a\[Rho]", "[", "f", "]"}], "]"}], "+", 
      RowBox[{"\[Rho]a", "[", 
       RowBox[{"\[Rho]a", "[", "f", "]"}], "]"}]}], ")"}]}], "+", 
   RowBox[{"\[Kappa]", " ", 
    RowBox[{"loss", "[", "f", "]"}]}]}]}]], "Input",
 CellLabel->"In[137]:=",
 CellID->74694240,ExpressionUUID->"7ed2bbd7-9ce5-7c47-927b-47fa39eb893f"],

Cell["\<\
Look at the noise in the three most important representations:\
\>", "Text",
 CellID->344505452,ExpressionUUID->"14f1473f-d76f-e742-aba6-9e5deb9f889d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"kramersMoyal", "[", 
     RowBox[{"parametric", ",", "#"}], "]"}], "[", "\"\<Diffusion\>\"", "]"}],
    "&"}], "/@", 
  RowBox[{"{", 
   RowBox[{"1", ",", "0", ",", 
    RowBox[{"-", "1"}]}], "}"}]}]], "Input",
 CellLabel->"In[139]:=",
 CellID->58010863,ExpressionUUID->"0c80900f-18d4-8749-8037-520dd28d4f00"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[CurlyEpsilon]", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "\[CurlyEpsilon]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox["\[Kappa]", "2"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox["\[Kappa]", "2"]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[CurlyEpsilon]"}], "+", "\[Kappa]"}], ",", "0"}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"\[CurlyEpsilon]", "+", "\[Kappa]"}]}], "}"}]}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[139]=",
 CellID->64039609,ExpressionUUID->"e7409995-30d0-e74e-bcae-7e3d9d14de8e"]
}, Open  ]],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9b3c61eb-257f-9540-948f-4f03a555d856"],
 "representation has negative diffusion in the ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3c063795-1bee-414a-94e2-f1497cf2b44c"],
 " quadrature, which means no \nwell behaved ",
 Cell[BoxData[
  FormBox["P", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "08bfe069-bf48-ce4f-9ecf-e4df58121439"],
 " function and no Langevin equation in this representation. This is the \
phase space signature of nonclassical light"
}], "Text",
 CellID->249473206,ExpressionUUID->"a8d19946-9501-7048-a430-3495494ea54d"],

Cell["The Wigner equation is perfectly well behaved:", "Text",
 CellID->186013667,ExpressionUUID->"b5505f21-2514-5a4a-b30f-2d834296826c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"km", "=", 
   RowBox[{"kramersMoyal", "[", 
    RowBox[{"parametric", ",", "0"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"opo", "=", 
   RowBox[{"langevin", "[", 
    RowBox[{"km", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[150]:=",
 CellID->627845825,ExpressionUUID->"141e1fcc-dccf-a349-a3f9-30944c0af308"],

Cell[TextData[{
 "We get the expected ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], "\[DoubleStruckCapitalP]"}], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       SubscriptBox["\[PartialD]", "x"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CurlyEpsilon]", "-", 
           RowBox[{"\[Kappa]", "/", "2"}]}], ")"}], "x", " ", 
         "\[DoubleStruckCapitalP]"}], ")"}]}]}], "+", 
     RowBox[{
      SubscriptBox["\[PartialD]", "p"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[CurlyEpsilon]", "+", 
          RowBox[{"\[Kappa]", "/", "2"}]}], ")"}], "p", " ", 
        "\[DoubleStruckCapitalP]"}], ")"}]}], "+", " ", 
     RowBox[{
      FractionBox["\[Kappa]", "4"], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["\[PartialD]", "x", "2"], 
        RowBox[{"+", 
         SubsuperscriptBox["\[PartialD]", "p", "2"]}]}], ")"}], 
      "\[DoubleStruckCapitalP]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6a6bdb7d-9e60-5a4c-a753-025ba1993053"]
}], "Text",
 CellID->19263551,ExpressionUUID->"02a0284b-52ca-ca45-b2d9-2e199c8d674d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"opo", "[", "\"\<KolmogorovForwardEquation\>\"", "]"}], "/.", 
   "rulesFP"}], "]"}]], "Input",
 CellLabel->"In[150]:=",
 CellID->295208294,ExpressionUUID->"6d86c5f3-62f4-0245-a0d2-022d2bdcb288"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[FormalP]", 
     TagBox[
      RowBox[{"(", 
       RowBox[{"0", ",", "0", ",", "1"}], ")"}],
      Derivative],
     MultilineFunction->None], "(", 
    RowBox[{"x", ",", "p", ",", "t"}], ")"}], "\[LongEqual]", 
   RowBox[{
    RowBox[{
     FractionBox["1", "4"], " ", "\[Kappa]", " ", 
     RowBox[{"(", 
      RowBox[{
       TagBox[
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], 
          RowBox[{"\[FormalP]", "(", 
           RowBox[{"x", ",", "p", ",", "t"}], ")"}]}], 
         RowBox[{
          RowBox[{"\[PartialD]", "p"}], "\[ThinSpace]", 
          RowBox[{"\[PartialD]", "p"}]}],
         MultilineFunction->None],
        "InactiveDTraditional"], "+", 
       TagBox[
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], 
          RowBox[{"\[FormalP]", "(", 
           RowBox[{"x", ",", "p", ",", "t"}], ")"}]}], 
         RowBox[{
          RowBox[{"\[PartialD]", "x"}], "\[ThinSpace]", 
          RowBox[{"\[PartialD]", "x"}]}],
         MultilineFunction->None],
        "InactiveDTraditional"]}], ")"}]}], "+", 
    TagBox[
     TagBox[
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", "x"}]], 
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], " ", "x", " ", 
         RowBox[{"(", 
          RowBox[{"\[Kappa]", "-", 
           RowBox[{"2", " ", "\[CurlyEpsilon]"}]}], ")"}], " ", 
         RowBox[{"\[FormalP]", "(", 
          RowBox[{"x", ",", "p", ",", "t"}], ")"}]}], ")"}]}],
      D],
     "InactiveDTraditional"], "+", 
    TagBox[
     TagBox[
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", "p"}]], 
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], " ", "p", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "\[CurlyEpsilon]"}], "+", "\[Kappa]"}], ")"}], " ", 
         RowBox[{"\[FormalP]", "(", 
          RowBox[{"x", ",", "p", ",", "t"}], ")"}]}], ")"}]}],
      D],
     "InactiveDTraditional"]}]}], TraditionalForm]], "Output",
 CellLabel->"Out[152]=",
 CellID->214323381,ExpressionUUID->"a544f33e-94a8-b044-9184-ee079dbae65e"]
}, Open  ]],

Cell[TextData[{
 "The pump amplifies ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5151f4b0-fd30-764a-9e25-f0569688147e"],
 " and de-amplifies ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "34376602-99bf-be4e-9943-d18b53b09272"],
 ", against the same vacuum noise. The drift is linear ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "=", 
    RowBox[{"J", " ", 
     StyleBox["x",
      FontWeight->"Bold"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "96adf0bf-50b9-014c-b3f3-9c3535d0a0d7"]
}], "Text",
 CellID->253865216,ExpressionUUID->"0bf192d8-9167-c949-acf2-a22e58627d26"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"km", "[", "\"\<Drift\>\"", "]"}]], "Input",
 CellLabel->"In[159]:=",
 CellID->127141123,ExpressionUUID->"15f7f2e9-b8d9-b944-b5d5-ce31431cc307"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"x", " ", 
    RowBox[{"(", 
     RowBox[{"\[CurlyEpsilon]", "-", 
      FractionBox["\[Kappa]", "2"]}], ")"}]}], ",", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], " ", "p", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", "\[CurlyEpsilon]"}], "+", "\[Kappa]"}], ")"}]}]}], 
  "}"}]], "Output",
 CellLabel->"Out[159]=",
 CellID->108414326,ExpressionUUID->"24620ff3-ab1f-8145-ac6d-72c9c4bff77d"]
}, Open  ]],

Cell[TextData[{
 "The stationary covariance \[Sigma] solves the Lyapunov equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"J", " ", "\[Sigma]"}], " ", "+", 
     RowBox[{"\[Sigma]", " ", 
      RowBox[{"J", "\[Transpose]"}]}], "+", "D"}], "=", "0"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5722e7d8-3d13-2348-992e-d45b2787759b"],
 ":"
}], "Text",
 CellID->600374583,ExpressionUUID->"bb108ca1-a911-9949-80ff-0d229407db64"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Sigma]s", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"LyapunovSolve", "[", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"x", ",", "p"}], "}"}], "}"}]], 
       RowBox[{"km", "[", "\"\<Drift\>\"", "]"}]}], ",", 
      RowBox[{"-", 
       RowBox[{"km", "[", "\"\<Diffusion\>\"", "]"}]}]}], "]"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Kappa]", ",", "\[CurlyEpsilon]"}], "}"}], "\[Element]", 
     TemplateBox[{},
      "Reals"]}]}], "]"}]}]], "Input",
 CellLabel->"In[160]:=",
 CellID->449749262,ExpressionUUID->"2a460a66-22fa-924f-8586-d1d98a9e0444"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox["\[Kappa]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "4"}], " ", "\[CurlyEpsilon]"}], "+", 
       RowBox[{"2", " ", "\[Kappa]"}]}]], ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     FractionBox["\[Kappa]", 
      RowBox[{
       RowBox[{"4", " ", "\[CurlyEpsilon]"}], "+", 
       RowBox[{"2", " ", "\[Kappa]"}]}]]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[160]=",
 CellID->104542990,ExpressionUUID->"7f281016-af5c-cd4c-864d-d8bab77a9eef"]
}, Open  ]],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0a71e7bd-d5b3-8a4a-a202-5b3ec5a4b4d8"],
 "quadrature diverges at the threshold ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", "=", 
    RowBox[{"\[CurlyEpsilon]", "/", "2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c9e47c91-791e-e349-9442-01c30d0e72a4"],
 " while ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d0f5f72c-5431-6042-9f0c-650d77156c52"],
 " is squeezed below vacuum value"
}], "Text",
 CellID->62663,ExpressionUUID->"731773fa-0db6-4640-81fc-7c9f7aa1fc0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{
   UnderscriptBox["\[Limit]", 
    RowBox[{"\[CurlyEpsilon]", "\[Rule]", 
     FractionBox["\[Kappa]", "2"]}]], 
   RowBox[{"10", " ", 
    RowBox[{"Log10", "[", 
     RowBox[{"2", " ", 
      RowBox[{"\[Sigma]", "\[LeftDoubleBracket]", 
       RowBox[{"2", ",", "2"}], "\[RightDoubleBracket]"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[164]:=",
 CellID->583173419,ExpressionUUID->"75dc1d22-7e58-d04b-beca-55a4598c1a46"],

Cell[BoxData[
 RowBox[{"-", "3.0102999566398116`"}]], "Output",
