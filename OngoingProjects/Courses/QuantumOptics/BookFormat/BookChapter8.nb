Cell["Calculate symbolic moments from the process:", "Text",
 CellID->32732048,ExpressionUUID->"2d8e4a3f-1e1a-6645-8d78-58b57c552f53"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Mean", "[", 
      RowBox[{"proc", "[", "t", "]"}], "]"}], ",", 
     RowBox[{"Covariance", "[", 
      RowBox[{"proc", "[", "t", "]"}], "]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"t", ">", "0"}], "&&", 
    RowBox[{"\[Gamma]", ">", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[128]:=",
