  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1a868cec-ab5e-fa4f-bcb0-a3cd3c18e64a"],
 " = 2:"
}], "Text",
 CellChangeTimes->{{3.9732611175354557`*^9, 3.9732611803667755`*^9}},
 CellID->849674303,ExpressionUUID->"f044be13-eac1-1341-82d5-d00e88a0a777"],

