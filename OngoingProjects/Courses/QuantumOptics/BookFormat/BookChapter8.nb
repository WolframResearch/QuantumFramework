 CellID->72082282,ExpressionUUID->"690198c3-1e47-924f-8604-ed67d7e55f0b"]
}, Open  ]],

Cell["\<\
The intracavity field can be squeezed by at most a factor of two or 3 dB limit\
\>", "Text",
 CellID->80439662,ExpressionUUID->"2a613732-854e-7c4f-87de-9e0837e3b563"],

Cell[TextData[{
 "For the comparison, the master equation is solved with ",
 StyleBox["QuantumEvolve", "FormattedFunction"],
 ":"
}], "Text",
 CellID->852632294,ExpressionUUID->"1a31ddcc-4b77-4242-bc67-dc13b63a3173"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "40", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"steadyState", "[", "\[CurlyEpsilon]v_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "\[CurlyEpsilon]v", 
        " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox["a", "\[Dagger]"], "@", 
           SuperscriptBox["a", "\[Dagger]"]}], "-", 
          RowBox[{"a", "@", "a"}]}], ")"}]}], ",", 
       RowBox[{"{", "a", "}"}], ",", 
       RowBox[{"FockState", "[", "0", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "80"}], "}"}]}], "]"}], "[", "80", "]"}], 
    "[", "\"\<Normalize\>\"", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[166]:=",
 CellID->106125926,ExpressionUUID->"e4e32ed9-2abe-f549-8409-7fb820883b39"],

Cell["\<\
We use CovarianceMatrix for the quadrature covariance elements:\
\>", "Text",
 CellID->327960213,ExpressionUUID->"9570ed11-1cc3-9945-9924-7c38f4c25c21"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"noisedB", "[", "\[CurlyEpsilon]v_", "]"}], ":=", 
   RowBox[{"10", " ", 
    RowBox[{"Log10", "[", 
     RowBox[{"2", " ", 
      RowBox[{"Diagonal", "[", 
       RowBox[{"CovarianceMatrix", "[", 
        RowBox[{"steadyState", "[", "\[CurlyEpsilon]v", "]"}], "]"}], "]"}]}],
      "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qf", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dB", "=", 
         RowBox[{"noisedB", "[", "\[CurlyEpsilon]v", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[CurlyEpsilon]v", ",", 
           RowBox[{
           "dB", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[CurlyEpsilon]v", ",", 
           RowBox[{
           "dB", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
          "}"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[CurlyEpsilon]v", ",", "0", ",", "0.4", ",", "0.1"}], "}"}]}],
     "]"}]}], ";"}]}], "Input",
 CellLabel->"In[166]:=",
 CellID->578440964,ExpressionUUID->"51fc704d-3f29-f241-b8fc-3bcfe058bb43"],

Cell["\<\
Define the trajectory cloud and the Wigner representation of the steady state:\
\>", "Text",
 CellID->800567730,ExpressionUUID->"5e163bc2-fa9d-2c4f-a0e1-e5c89a4c525b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"cloud", "=", 
   RowBox[{
    RowBox[{"First", "[", 
     RowBox[{
      RowBox[{"RandomFunction", "[", 
       RowBox[{
        RowBox[{"opo", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Kappa]", "->", "1"}], ",", 
           RowBox[{"\[CurlyEpsilon]", "->", "0.3"}]}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "4000", ",", "0.05"}], "}"}]}], "]"}], 
      "[", "\"\<ValueList\>\"", "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"400", ";;", " ", ";;", "10"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wSteady", "=", 
   RowBox[{"WignerRepresentation", "[", 
    RowBox[{
     RowBox[{"steadyState", "[", "0.3", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", "4"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[170]:=",
 CellID->1227667,ExpressionUUID->"6a8d695f-3b3f-2a46-9f74-e1ddf5aad070"],

Cell["\<\
Time is in units of 1/\[Kappa], we show one long Langevin trajectory sampled \
after it reaches steady state with the steady-state Wigner contour from  \
(red) and the vacuum contour (dashed), both at. And also the noise in each \
quadrature against pump strength, the Lyapunov formula (lines) against the \
master equation (dots).\
\>", "Text",
 CellID->24818344,ExpressionUUID->"8f42d8ea-ec5d-254b-9c82-a5117d57db8f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"phase", "=", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{"cloud", ",", 
       InterpretationBox[
        DynamicModuleBox[{Typeset`open = False}, 
         TemplateBox[{"Expression", 
           RowBox[{
             DynamicBox[
              FEPrivate`FrontEndResource["FEBitmaps", "IconizeEllipsis"]], 
             "\[Rule]", 
             DynamicBox[
              FEPrivate`FrontEndResource["FEBitmaps", "IconizeEllipsis"]]}], 
           GridBox[{{
              RowBox[{
                TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                TagBox["Rule", "IconizedItem"]}]}, {
              RowBox[{
                TagBox["\"Byte count: \"", "IconizedLabel"], 
                "\[InvisibleSpace]", 
                TagBox["312", "IconizedItem"]}]}}, 
            GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
            "Column", 
            GridBoxItemSize -> {
             "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
           Dynamic[Typeset`open]},
          "IconizedObject"]],
        PlotStyle -> Directive[
          GrayLevel[0.4], 
          PointSize[0.004], 
          Opacity[0.4]],
        SelectWithContents->True,
        Selectable->False]}], "]"}], ",", 
     RowBox[{"ContourPlot", "[", 
      RowBox[{
       RowBox[{"wSteady", "[", 
        RowBox[{"x", ",", "p"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", 
         RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
       InterpretationBox[
        DynamicModuleBox[{Typeset`open = False}, 
         TemplateBox[{"Expression", "SequenceIcon", 
           GridBox[{{
              RowBox[{
                TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                TagBox["Sequence", "IconizedItem"]}]}, {
              RowBox[{
                TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                TagBox["5", "IconizedItem"]}]}, {
              RowBox[{
                TagBox["\"Byte count: \"", "IconizedLabel"], 
                "\[InvisibleSpace]", 
                TagBox["832", "IconizedItem"]}]}}, 
            GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
            "Column", 
            GridBoxItemSize -> {
             "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
           Dynamic[Typeset`open]},
          "IconizedObject"]],
        Sequence[
        Contours -> {$CellContext`wSteady[0, 0] Exp[(-1)/2]}, ContourShading -> 
         None, PlotRange -> All, ContourStyle -> Directive[Red, Thick], 
         PlotPoints -> 60],
        SelectWithContents->True,
        Selectable->False]}], "]"}], ",", 
     RowBox[{"ContourPlot", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["x", "2"]}], "-", 
          SuperscriptBox["p", "2"]}], "]"}], "\[Pi]"], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", 
         RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
       InterpretationBox[
        DynamicModuleBox[{Typeset`open = False}, 
         TemplateBox[{"Expression", "SequenceIcon", 
           GridBox[{{
              RowBox[{
                TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                TagBox["Sequence", "IconizedItem"]}]}, {
              RowBox[{
                TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                TagBox["4", "IconizedItem"]}]}, {
              RowBox[{
                TagBox["\"Byte count: \"", "IconizedLabel"], 
                "\[InvisibleSpace]", 
                TagBox["744", "IconizedItem"]}]}}, 
            GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
            "Column", 
            GridBoxItemSize -> {
             "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
