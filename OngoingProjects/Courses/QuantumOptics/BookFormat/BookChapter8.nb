Cell["Calculate the s-ordered function:", "Text",
 CellID->665524007,ExpressionUUID->"1e6f1587-221c-874d-aa2b-2f8155f140b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"quasi", "[", "op_", "]"}], ":=", 
   RowBox[{"SOrderedFunction", "[", 
    RowBox[{
     RowBox[{"op", "[", "\"\<MatrixQuantumState\>\"", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "p"}], "}"}], ",", "s"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[11]:=",
 CellID->138412578,ExpressionUUID->"33e79c41-d406-df42-b311-6f9ef8b2fbb7"],

Cell["Verify the rules:", "Text",
 CellID->231887026,ExpressionUUID->"34378559-6d81-8d46-9ec4-6a3e544e83e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"quasi", "[", "#1", "]"}], "-", 
        RowBox[{"#2", "[", 
         RowBox[{"quasi", "[", "\[Rho]", "]"}], "]"}]}], "]"}], "]"}], "===", 
     "0"}], "&"}], ")"}], "@@@", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", "[", "\[Rho]", "]"}], ",", "a\[Rho]"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SuperscriptBox["a", "\[Dagger]"], "[", "\[Rho]", "]"}], ",", 
      "ad\[Rho]"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Rho]", "[", "a", "]"}], ",", "\[Rho]a"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Rho]", "[", 
       SuperscriptBox["a", "\[Dagger]"], "]"}], ",", "\[Rho]ad"}], "}"}]}], 
   "}"}]}]], "Input",
 CellLabel->"In[133]:=",
 CellID->74810640,ExpressionUUID->"4d383b16-776d-0e43-9956-428c2a2ecc67"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[133]=",
 CellID->130526270,ExpressionUUID->"bc3fde5e-a341-104d-902f-7cfb5e2a9715"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["From the master equation to a Fokker-Planck equation", "Subsubsection",
 CellID->60373018,ExpressionUUID->"476c3199-2196-0548-8c88-51aa6bc90932"],

Cell["Starting from the Lindblad master equation", "Text",
 CellID->101896327,ExpressionUUID->"43113e21-ca9b-d64c-9362-5fe0df401532"],

Cell[BoxData[
 RowBox[{
  OverscriptBox["\[Rho]", "."], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], Cell[TextData[{
     Cell[BoxData[
      FormBox[
       RowBox[{"[", "H"}], TraditionalForm]],ExpressionUUID->
      "c10ee320-1cbe-c545-8b7e-e9b882ee1ea6"],
     ", \[Rho]]"
    }],ExpressionUUID->"bfa86168-5f12-444d-923d-4bcf79484775"]}], "+", 
   RowBox[{
    SubscriptBox["\[Sum]", 
     RowBox[{" ", Cell[TextData[Cell[BoxData[
       FormBox["k", TraditionalForm]],ExpressionUUID->
       "45fd0fe6-83b6-9c45-bfbf-7752f97266cc"]],ExpressionUUID->
       "453d5cf9-316e-2f42-b537-be14af0d9f6e"]}]], 
    RowBox[{
     SubscriptBox["\[Gamma]", Cell[TextData[Cell[BoxData[
       FormBox["k", TraditionalForm]],ExpressionUUID->
       "6b912352-ad0d-bc40-a174-40430bc029c8"]],ExpressionUUID->
       "c0dd6b5b-cf84-9141-af90-ddf584ea3047"]], Cell[TextData[Cell[BoxData[
      FormBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["L", "k"], "\[Rho]", " ", 
          SubsuperscriptBox["L", "k", "\[Dagger]"]}], "-", 
         RowBox[{
          FractionBox["1", "2"], 
          SubsuperscriptBox["L", "k", "\[Dagger]"], 
          SubscriptBox["L", "k"], "\[Rho]"}], "-", 
         RowBox[{
          FractionBox["1", "2"], "\[Rho]", " ", 
          SubsuperscriptBox["L", "k", "\[Dagger]"], 
          SubscriptBox["L", "k"]}]}], ")"}], TraditionalForm]],ExpressionUUID->
      "6f66b9e3-06ee-b041-a494-f43c5ca2e780"]],ExpressionUUID->
      "67654771-e9fb-d54c-a961-88f6baf52ac7"]}]}]}]}]], "DisplayFormula",
 CellID->25267604,ExpressionUUID->"3e789ca8-cde9-1742-85a6-cc5330cc9ebd"],

Cell[TextData[{
 "If we consider the dissipators of photon loss and gain (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"L", "=", "a"}], ",", " ", 
     RowBox[{"L", "=", 
      SuperscriptBox["a", "\[Dagger]"]}]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "80bb8636-ceb3-e94e-82e5-36dd80fcf126"],
 " and use the rules we derived their action on ",
 Cell[BoxData[
  FormBox["W", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1d4cd686-d0b0-964a-8b5f-790337f7f435"],
 " is :"
}], "Text",
 CellID->643916116,ExpressionUUID->"b7e6c6a8-a57d-2947-b566-7aab38c80ec1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"loss", "[", "f_", "]"}], ":=", 
   RowBox[{
    RowBox[{"a\[Rho]", "[", 
     RowBox[{"\[Rho]ad", "[", "f", "]"}], "]"}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ad\[Rho]", "[", 
        RowBox[{"a\[Rho]", "[", "f", "]"}], "]"}], "+", 
       RowBox[{"\[Rho]a", "[", 
        RowBox[{"\[Rho]ad", "[", "f", "]"}], "]"}]}], ")"}], "/", "2"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gain", "[", "f_", "]"}], ":=", 
   RowBox[{
    RowBox[{"ad\[Rho]", "[", 
     RowBox[{"\[Rho]a", "[", "f", "]"}], "]"}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a\[Rho]", "[", 
        RowBox[{"ad\[Rho]", "[", "f", "]"}], "]"}], "+", 
       RowBox[{"\[Rho]ad", "[", 
        RowBox[{"\[Rho]a", "[", "f", "]"}], "]"}]}], ")"}], "/", "2"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[98]:=",
 CellID->247335654,ExpressionUUID->"7a3a8b32-6edb-d84c-8168-185b900b9cd3"],

Cell["\<\
Every master equation we will explore in this section will be built from \
these pieces\
\>", "Text",
 CellID->43580012,ExpressionUUID->"0e141235-c42b-d744-b088-45286f92b2b6"],

Cell[TextData[{
 "Think of ",
 Cell[BoxData[
  FormBox["W", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "515f5cbf-497a-d84e-a307-b26a7fcb92aa"],
 " as a cloud of points wandering through phase space. In a short time ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", "t"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "69af5631-c340-e74b-8f80-18797ccb4cbe"],
 " a point at ",
 Cell[BoxData[
  FormBox[
   StyleBox["x",
    FontWeight->"Bold"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ca760cd7-bb1c-7742-ba62-fc1d976d39f2"],
 " jumps by an amount ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", 
    StyleBox["x",
     FontWeight->"Bold"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5ef94973-3e57-c948-b0c2-a0d76cc80b5c"],
 ", and we can define the following statistics:\[LineSeparator]",
 StyleBox["The average jump per unit time ", "Subsubitem"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "i"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"\[CapitalDelta]", " ", 
        SubscriptBox["x", "i"]}], "\[RightAngleBracket]"}], "/", 
      "\[CapitalDelta]"}], " ", "t"}]}], TraditionalForm]], "Subsubitem",
  FormatType->TraditionalForm,ExpressionUUID->
  "c4a71352-a1b8-a845-96ab-8a9fde6a948d"], "Subsubitem"],
 StyleBox[" or ", "Subsubitem"],
 StyleBox["drift ", "Subsubitem",
  FontWeight->"Bold"],
 StyleBox[", \[LineSeparator]The spread of the jumps per unit time ", 
  "Subsubitem"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", 
     RowBox[{"i", " ", "j"}]], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"\[CapitalDelta]", " ", 
        SubscriptBox["x", "i"], "\[CapitalDelta]", " ", 
        SubscriptBox["x", "j"]}], "\[RightAngleBracket]"}], "/", 
      "\[CapitalDelta]"}], " ", "t"}]}], TraditionalForm]], "Subsubitem",
  FormatType->TraditionalForm,ExpressionUUID->
  "bf41efdb-ced8-af4c-b768-9397a1281f05"], "Subsubitem"],
 StyleBox[" or ", "Subsubitem"],
 StyleBox["diffusion\[LineSeparator]", "Subsubitem",
  FontWeight->"Bold"],
 StyleBox["The skewness ", "Subsubitem"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"\[CapitalDelta]", " ", 
       SubscriptBox["x", "i"], "\[CapitalDelta]", " ", 
       SubscriptBox["x", "j"], " ", "\[CapitalDelta]", " ", 
       SubscriptBox["x", "k"]}], "\[RightAngleBracket]"}], "/", 
     "\[CapitalDelta]"}], " ", "t"}], TraditionalForm]], "Subsubitem",
  FormatType->TraditionalForm,ExpressionUUID->
  "7f6d4783-890b-944e-8155-38bbd511aa43"], "Subsubitem"],
 StyleBox[" , and so on to even higher moments", "Subsubitem"]
}], "Text",
 CellID->302573890,ExpressionUUID->"b0ba3c89-c84a-f940-9387-c21117fc2640"],

Cell[TextData[{
 "Kramers and Moyal showed that the evolution of the density matrix can be \
written as a series in which the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d5a68ca8-3f34-6a48-beb6-2f5434f495b2"],
 "-moment of the jumps multiply the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6d8bff82-8892-d849-9247-30f74124527d"],
 "-th derivative of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"W", ":"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "683e53f9-833d-0f42-8390-aa5ddc3b6f63"]
}], "Text",
 CellID->558541068,ExpressionUUID->"0fc5a9e3-8734-2b4a-80cf-632e9c066ffc"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], "W"}], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      SubscriptBox["\[PartialD]", "i"], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["A", "i"], "W"}], ")"}]}]}], "+", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{
      SubscriptBox["\[PartialD]", "i"], 
      RowBox[{
       SubscriptBox["\[PartialD]", "j"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["D", 
          RowBox[{"i", " ", "j"}]], "W"}], ")"}]}]}]}], "-", 
    RowBox[{
     FractionBox["1", "6"], 
     RowBox[{
      SubscriptBox["\[PartialD]", "i"], 
      RowBox[{
       SubscriptBox["\[PartialD]", "j"], 
       RowBox[{
        SubscriptBox["\[PartialD]", "k"], 
        RowBox[{"(", "\[Ellipsis]", ")"}]}]}]}]}], "+", "\[Ellipsis]"}]}], 
  TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"3537161d-1af8-4549-842a-07a21687ce59"]], \
"Text",
 CellID->388893507,ExpressionUUID->"c143605b-9a16-5146-9649-2eb56db76e2e"],

Cell["\<\
A drop of ink in a flowing river is the picture to keep in mind. The current \
carries the drop along (the first-derivative drift term), and molecular \
motion spreads it out (the second-derivative diffusion term). If the series \
stops after these two terms, it is the Fokker\[Dash]Planck equation, and the \
cloud of points is an accurate representation a set of particles that drift \
and diffuse. However Pawula\[CloseCurlyQuote]s theorem states the series \
either stops at second order or goes on forever. Keeping a third or fourth \
term while dropping the rest generally produces \
\[OpenCurlyDoubleQuote]probabilities\[CloseCurlyDoubleQuote] that turn \
negative. For the Wigner function, linear damping and quadratic Hamiltonians \
stop exactly at second order, we will se later how to deal with Hamiltonians \
such as the Kerr effect.\t\t\
\>", "Text",
 CellID->12418124,ExpressionUUID->"9dda2458-fff0-3949-9f28-1b6aad08a13e"],

Cell[TextData[{
 "Implementation of Kramers Moyal approach, a trick used is acting on  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"u", " ", "x"}], " ", "+", " ", 
     RowBox[{"v", " ", "p"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b151794b-f97c-1e43-a9b0-40ec1e0ca803"],
 " turns every ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], " ", "into"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1fcb4ae9-f976-284c-a680-ccba78627e5a"],
 " a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ce847eae-a574-044f-81a5-4e3ebac07476"],
 "and every ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[PartialD]", "p"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "03ae1816-0101-0140-ab6b-0e5767c7a794"],
 " into ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5c3cda1f-bdda-d140-9705-4faf66f5eb32"],
 ". So ",
 StyleBox["CoefficientRules", "FormattedFunction"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"u", ",", "v"}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e4a9826c-0638-3f4a-a66a-15021c21d39f"],
 " lists the coefficients of each derivative"
}], "Text",
 CellID->2499063,ExpressionUUID->"1a7281c5-7fbc-084e-9c7b-79ef7e3f70ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kramersMoyal", "[", 
   RowBox[{"lindbladian_", ",", "s0_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", "=", "s0"}], "}"}], ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"coefficients", ",", "moment"}], "}"}], ",", 
      RowBox[{
       RowBox[{"coefficients", "=", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "u"}], " ", "x"}], "-", 
              RowBox[{"v", " ", "p"}]}], "]"}], " ", 
            RowBox[{"lindbladian", "[", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"u", " ", "x"}], "+", 
               RowBox[{"v", " ", "p"}]}], "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ";", 
       RowBox[{
        RowBox[{"moment", "[", "g_", "]"}], ":=", 
        RowBox[{"Simplify", "[", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], 
               RowBox[{"Total", "[", "#1", "]"}]], " ", 
              RowBox[{
               SubscriptBox["\[PartialD]", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", ",", 
                   RowBox[{
                   "#1", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"p", ",", 
                   RowBox[{
                   "#1", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}]}], "}"}]}]], 
               RowBox[{"(", 
                RowBox[{"#2", " ", "g"}], ")"}]}]}], "&"}], ")"}], "@@@", 
           "coefficients"}], "]"}], "]"}]}], ";", 
       RowBox[{"Association", "[", 
        RowBox[{
         RowBox[{"\"\<Order\>\"", "\[Rule]", 
          RowBox[{"Max", "[", 
           RowBox[{"Total", "/@", 
            RowBox[{"Keys", "[", "coefficients", "]"}]}], "]"}]}], ",", 
         RowBox[{"\"\<Drift\>\"", "\[Rule]", 
          RowBox[{"moment", "/@", 
           RowBox[{"{", 
            RowBox[{"x", ",", "p"}], "}"}]}]}], ",", 
         RowBox[{"\"\<Diffusion\>\"", "\[Rule]", 
          RowBox[{"Simplify", "[", 
           RowBox[{"Outer", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"moment", "[", 
                RowBox[{"#1", " ", "#2"}], "]"}], "-", 
               RowBox[{"#1", " ", 
                RowBox[{"moment", "[", "#2", "]"}]}], "-", 
               RowBox[{"#2", " ", 
                RowBox[{"moment", "[", "#1", "]"}]}]}], "&"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "p"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "p"}], "}"}]}], "]"}], "]"}]}]}], "]"}]}]}], 
     "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[100]:=",
 CellID->256745704,ExpressionUUID->"4ff7c121-39d0-5f40-96ba-1806af036bff"],

Cell[TextData[{
 "For example, for a thermal bath with mean occupation ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "\[LongDash]"], TraditionalForm]],ExpressionUUID->
  "e5a827e5-807e-844b-80be-217dd2e7badb"],
 " has loss at rate \[Gamma]",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     OverscriptBox["n", "\[LongDash]"], "+", "1"}], ")"}], TraditionalForm]],
  ExpressionUUID->"f25188a0-78c8-2945-b3ff-ceb221625aff"],
 " and gain at rate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", " ", 
    OverscriptBox["n", "\[LongDash]"]}], TraditionalForm]],ExpressionUUID->
  "ba959f27-846a-b149-b6e2-230c968b2684"],
 ":"
}], "Text",
 CellID->38869768,ExpressionUUID->"26ccf144-8bf1-af47-8252-49d72bb949ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"thermal", "[", "f_", "]"}], ":=", 
  RowBox[{
   RowBox[{"\[Gamma]", " ", 
    RowBox[{"(", 
     RowBox[{
      OverscriptBox["n", "_"], "+", "1"}], ")"}], " ", 
    RowBox[{"loss", "[", "f", "]"}]}], "+", 
   RowBox[{"\[Gamma]", " ", 
    OverscriptBox["n", "_"], " ", 
    RowBox[{"gain", "[", "f", "]"}]}]}]}]], "Input",
 CellLabel->"In[46]:=",
 CellID->123653446,ExpressionUUID->"5497fd85-b3ea-1447-a30b-37321c5c9e98"],

Cell[TextData[{
 "We keep ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "267e4b5a-997e-1048-93fe-3d78f2b2d6ee"],
 " symbolic:"
}], "Text",
 CellID->3125968,ExpressionUUID->"862c92f6-e642-c24c-a78c-f7a2f8e0737d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"kramersMoyal", "[", 
  RowBox[{"thermal", ",", "s"}], "]"}]], "Input",
 CellLabel->"In[47]:=",
 CellID->122418137,ExpressionUUID->"dc14e90f-9671-244b-b6db-73be7d20d14a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Order\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"Drift\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"x", " ", "\[Gamma]"}], "2"]}], ",", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"p", " ", "\[Gamma]"}], "2"]}]}], "}"}]}], ",", 
   RowBox[{"\<\"Diffusion\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"\[Gamma]", "-", 
           RowBox[{"s", " ", "\[Gamma]"}], "+", 
           RowBox[{"2", " ", "\[Gamma]", " ", 
            OverscriptBox["n", "_"]}]}], ")"}]}], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"\[Gamma]", "-", 
           RowBox[{"s", " ", "\[Gamma]"}], "+", 
           RowBox[{"2", " ", "\[Gamma]", " ", 
            OverscriptBox["n", "_"]}]}], ")"}]}]}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[47]=",
 CellID->52726284,ExpressionUUID->"3bea8a31-d969-b74d-a794-4e6929d33c89"]
}, Open  ]],

Cell["\<\
All representations have the same drift amplitude relaxation with \[Gamma]/2 \
behavior. But the noise depends on the specific representation ordering\
\>", "Text",
 CellID->26652213,ExpressionUUID->"ef2fb108-b7a6-7446-b13d-ae07a261d719"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Fokker-Planck to Langevin: the damped oscillator", "Subsubsection",
 CellID->187895188,ExpressionUUID->"8c51c1f1-fd13-6042-83f6-508dc21dafe1"],

Cell["\<\
The Fokker\[Dash]Planck equation describes the whole cloud at once, how the \
density of points flows and spreads. Langevin motivated by studying Brownian \
motion, took the other view and followed a single particle. A classic example \
of a pollen grain in water obeys Newton\[CloseCurlyQuote]s law with two \
forces from the water a smooth friction that slows it down, and a rapidly \
fluctuating force from individual molecular impacts\
\>", "Text",
 CellID->205919991,ExpressionUUID->"7c8bae4c-43cc-9241-9e38-d074071b2d46"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"m", " ", 
    OverscriptBox["x", "."]}], " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[Eta]"}], " ", "v"}], "+", 
    RowBox[{"\[Xi]", 
     RowBox[{"(", "t", ")"}]}]}]}], TraditionalForm]], "DisplayFormula",
 CellID->182222718,ExpressionUUID->"11485ee0-ec66-8e4f-9763-ac868ab0b90f"],

Cell["\<\
If we solve this equation many times with independent random forces, and \
construct a histogram from  the results, we can recover the density that the \
Fokker\[Dash]Planck equation evolves\
\>", "Text",
 CellID->533829437,ExpressionUUID->"dd4cc662-6a81-c947-8337-da0839b30d69"],

Cell[TextData[{
 "In the It\[OHat] form we use ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DifferentialD]", 
     StyleBox["x",
      FontWeight->"Bold"]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["A",
       FontWeight->"Bold"], " ", 
      RowBox[{"\[DifferentialD]", "t"}]}], "+", 
     RowBox[{
      StyleBox["B",
       FontWeight->"Bold"], " ", 
      RowBox[{"\[DifferentialD]", 
       StyleBox["W",
        FontWeight->"Bold"]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ecdf71ef-a720-4446-b18d-b01b4c4abee2"],
 " during a short step ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", "t"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d319c6e0-229b-604c-a351-17e0f664f6f6"],
 " we get a deterministic move ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["A",
     FontWeight->"Bold"], " ", 
    RowBox[{"\[DifferentialD]", "t"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f3829830-9175-6648-8658-a356f30635f8"],
 " along the drift and a random kick ",
 Cell[BoxData[
  FormBox[
   StyleBox["B",
    FontWeight->"Bold"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ce9bdca0-9b41-a144-8b32-87a6f622a06a"],
 " \[DifferentialD] ",
 StyleBox["W ",
  FontWeight->"Bold"],
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DifferentialD]", 
    StyleBox["W",
     FontWeight->"Bold"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "78e3e2b7-6e37-544f-84c5-8d5431cd6d2e"],
 " is a gaussian increment with variance ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", " ", "t"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "25953fa6-b54f-7f42-94dd-17b6c4927301"],
 ". The kick scales as ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{"d", " ", "t"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a2bff57a-0709-9349-8ff4-b2e7a4f18f17"],
 " and not ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", " ", "t"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1647a140-356f-0140-a22c-e3e075d65735"],
 " because independent kicks contribute variance adding, after ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d73e726b-7459-b146-a484-0c9115a0813e"],
 " steps the displacement is ",
 Cell[BoxData[
  FormBox[
   SqrtBox["N"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f89846b-5c3c-1f48-ad38-bd4d661b546e"],
 "times a single kick, the familiar random-walk spreading. This is also why \
stochastic calculus differs from ordinary calculus"
}], "Text",
 CellID->232947297,ExpressionUUID->"81eb7409-ddfd-a04e-84da-1b55c6435210"],

Cell[TextData[{
 "A single Langevin trajectory in phase space is not the path the quantum \
field \[OpenCurlyDoubleQuote]really\[CloseCurlyDoubleQuote] takes, it has no \
definite ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"x", ",", "p"}], ")"}], TraditionalForm]],ExpressionUUID->
  "88c33c4d-3cf0-b440-938c-cec0e7587c38"],
 ". It is a sampling device, each trajectory is one draw from the \
quasi-probability distribution, and only averages over many trajectories \
carry physical meaning"
}], "Note",
 CellID->7025476,ExpressionUUID->"5bbf583e-be0e-6a4c-b59f-3e3970b51475"],

Cell[TextData[{
 "A second-order FPE with positive semidefinite ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d9fc961a-4b2a-c049-89d8-6bc935f23338"],
 " is equivalent to the It\[OHat] equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "=", 
    SuperscriptBox["D", 
     RowBox[{"1", "/", "2"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "063c74c9-04ea-e54c-8d98-0728f1a69d4c"],
 ". ",
 StyleBox["ItoProcess", "FormattedFunction"],
 " takes this stochastic differential equation building it from the \
Kramers-Moyal coefficients"
}], "Text",
 CellID->242279581,ExpressionUUID->"923dcece-0809-a842-95dd-269ba7336a5c"],

Cell["Langevin builder:", "Text",
 CellID->569307427,ExpressionUUID->"fb44a7cb-ae14-074f-b968-8fda93f0dc3c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"langevin", "[", 
   RowBox[{"km_", ",", "init_"}], "]"}], ":=", 
  RowBox[{"ItoProcess", "[", 
   RowBox[{
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[DifferentialD]", 
         RowBox[{"x", "[", "t", "]"}]}], ",", 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"p", "[", "t", "]"}]}]}], "}"}], "\[Equal]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"km", "[", "\"\<Drift\>\"", "]"}], " ", 
          RowBox[{"\[DifferentialD]", "t"}]}], "+", 
         RowBox[{
          RowBox[{"MatrixPower", "[", 
           RowBox[{
            RowBox[{"km", "[", "\"\<Diffusion\>\"", "]"}], ",", 
            FractionBox["1", "2"]}], "]"}], ".", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[DifferentialD]", 
             RowBox[{"w1", "[", "t", "]"}]}], ",", 
            RowBox[{"\[DifferentialD]", 
             RowBox[{"w2", "[", "t", "]"}]}]}], "}"}]}]}], "/.", 
        "\[VeryThinSpace]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "\[Rule]", 
           RowBox[{"x", "[", "t", "]"}]}], ",", 
          RowBox[{"p", "\[Rule]", 
           RowBox[{"p", "[", "t", "]"}]}]}], "}"}]}], ")"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], ",", 
      RowBox[{"p", "[", "t", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "p"}], "}"}], ",", "init"}], "}"}], ",", "t", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"w1", "\[Distributed]", 
       RowBox[{"WienerProcess", "[", "]"}]}], ",", 
      RowBox[{"w2", "\[Distributed]", 
       RowBox[{"WienerProcess", "[", "]"}]}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[101]:=",
 CellID->327876420,ExpressionUUID->"d2cb1c5a-3021-8a4c-83d8-a078265fc311"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s compute the Wigner Fokker\[Dash]Planck equation for \
the density ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DoubleStruckCapitalP]", "(", 
    RowBox[{"x", ",", "p", ",", "t"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f6d242a9-3875-7d4f-bcfc-8a6239286fe9"],
 " applied to the thermal bath, the expected result is "
}], "Text",
 CellID->355034998,ExpressionUUID->"208bf404-415b-324a-a17e-07bc9217e515"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], "\[DoubleStruckCapitalP]"}], " ", "=", 
   " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["\[Gamma]", "2"], "x", " ", "\[DoubleStruckCapitalP]"}], 
      ")"}]}], "+", 
    RowBox[{
     SubscriptBox["\[PartialD]", "p"], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["\[Gamma]", "2"], "p", " ", "\[DoubleStruckCapitalP]"}], 
      ")"}]}], "+", 
    RowBox[{
     FractionBox["\[Gamma]", "2"], 
     RowBox[{"(", 
      RowBox[{
       OverscriptBox["n", "\[LongDash]"], "+", 
       FractionBox["1", "2"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[PartialD]", "x", "2"], 
       RowBox[{"+", 
        SubsuperscriptBox["\[PartialD]", "p", "2"]}]}], ")"}], 
     "\[DoubleStruckCapitalP]"}]}]}], TraditionalForm]], "DisplayFormula",
 CellID->63901129,ExpressionUUID->"6014ee56-6a6d-904a-b5a1-2627765855f8"],

Cell[TextData[{
 "Get the Fokker-Planck equation from the ",
 StyleBox["\[OpenCurlyDoubleQuote]KolmogorovForwardEquation\
\[CloseCurlyDoubleQuote] ", "FormattedFunction"],
 "property:"
}], "Text",
 CellID->329040970,ExpressionUUID->"8b10af95-315d-2043-811d-4304b927dd7f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"proc", "=", 
   RowBox[{"langevin", "[", 
    RowBox[{
     RowBox[{"kramersMoyal", "[", 
      RowBox[{"thermal", ",", "0"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x0", ",", "p0"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"proc", "[", "\"\<KolmogorovForwardEquation\>\"", "]"}], "/.", 
   "rulesFP"}], "]"}]}], "Input",
 CellLabel->"In[125]:=",
 CellID->194936783,ExpressionUUID->"9ee81e18-9594-4646-ab27-5861c9678c7e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[FormalP]", 
     TagBox[
      RowBox[{"(", 
       RowBox[{"0", ",", "0", ",", "1"}], ")"}],
      Derivative],
     MultilineFunction->None], "(", 
    RowBox[{"x", ",", "p", ",", "t"}], ")"}], "\[LongEqual]", 
   RowBox[{
    RowBox[{
     FractionBox["1", "4"], " ", "\[Gamma]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        OverscriptBox["n", "_"]}], "+", "1"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       TagBox[
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], 
          RowBox[{"\[FormalP]", "(", 
           RowBox[{"x", ",", "p", ",", "t"}], ")"}]}], 
         RowBox[{
          RowBox[{"\[PartialD]", "p"}], "\[ThinSpace]", 
          RowBox[{"\[PartialD]", "p"}]}],
         MultilineFunction->None],
        "InactiveDTraditional"], "+", 
       TagBox[
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], 
          RowBox[{"\[FormalP]", "(", 
           RowBox[{"x", ",", "p", ",", "t"}], ")"}]}], 
         RowBox[{
          RowBox[{"\[PartialD]", "x"}], "\[ThinSpace]", 
          RowBox[{"\[PartialD]", "x"}]}],
         MultilineFunction->None],
        "InactiveDTraditional"]}], ")"}]}], "+", 
    TagBox[
     TagBox[
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", "p"}]], 
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], " ", "p", " ", "\[Gamma]", " ", 
         RowBox[{"\[FormalP]", "(", 
          RowBox[{"x", ",", "p", ",", "t"}], ")"}]}], ")"}]}],
      D],
     "InactiveDTraditional"], "+", 
    TagBox[
     TagBox[
      RowBox[{
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", "x"}]], 
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], " ", "x", " ", "\[Gamma]", " ", 
         RowBox[{"\[FormalP]", "(", 
          RowBox[{"x", ",", "p", ",", "t"}], ")"}]}], ")"}]}],
      D],
     "InactiveDTraditional"]}]}], TraditionalForm]], "Output",
 CellLabel->"Out[126]=",
 CellID->396480941,ExpressionUUID->"4d71d9a9-37b4-2a4f-8e3c-2890a5012a9b"]
}, Open  ]],

Cell[TextData[{
 "Which must coincide with the previous result at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"s", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "76831286-2df6-1845-8764-aaee826bde26"],
 ":"
}], "Text",
 CellID->108710598,ExpressionUUID->"828d4f25-efa5-d64e-9a6f-0a67c0ec35dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"s", "=", "0"}], "}"}], ",", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"thermal", "[", 
      RowBox[{"\[FormalP]", "[", 
       RowBox[{"x", ",", "p", ",", "t"}], "]"}], "]"}], "==", 
     RowBox[{"Activate", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"proc", "[", "\"\<KolmogorovForwardEquation\>\"", "]"}], "]"}],
       "]"}]}], "]"}]}], "]"}]], "Input",
