Cell[TextData[{
 "Apart  from the energy decay we can see there is another quantity that \
decays,  the the value of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{
     RowBox[{"-", "2"}], 
     SuperscriptBox[
      RowBox[{"|", "\[Alpha]", "|"}], "2"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", "\[Gamma]"}], " ", "t"}]]}], ")"}]}]], 
   TraditionalForm]], "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{3.9859500928415737`*^9, 3.9859501562522717`*^9},
  ExpressionUUID->"3e913a45-f570-724a-ae5f-d9e90626de73"],
 " multiply the \[OpenCurlyDoubleQuote]",
 StyleBox["coherences",
  IgnoreSpellCheck->True],
 "\[CloseCurlyDoubleQuote](off diagonal elements). For short times a \
decoherence time is obtained from an expansion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "decoh"], "=", 
    FractionBox["1", 
     RowBox[{"2", " ", "\[Gamma]", " ", 
      SuperscriptBox[
       RowBox[{"|", "\[Alpha]", "|"}], "2"]}]], "=", 
    FractionBox[
     SubscriptBox["T", "decay"], 
     RowBox[{"2", 
      SuperscriptBox[
       RowBox[{"|", "\[Alpha]", "|"}], "2"]}]]}], TraditionalForm]], 
  "DisplayFormula",
  CellChangeTimes->{3.985950092842575*^9, 3.9859501562522717`*^9},
  ExpressionUUID->"dd639f46-7b1e-9d44-8294-73f8c46eceef"],
 ". Such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "decoh"], "<", 
    SubscriptBox["T", "decay"]}], TraditionalForm]], "DisplayFormula",
  CellChangeTimes->{3.9859500928435726`*^9, 3.985950156253271*^9},
  ExpressionUUID->"01a0a162-b5a7-9945-be89-453871aa8936"],
 " as long as ",
 Cell[BoxData[
  FormBox["|", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "22b18bda-2918-ef49-b862-2a398c910331"],
 "\[Alpha]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[Cell[
    "|",ExpressionUUID->"3ddc0b1d-4289-2840-8b0f-5927aac2c7d3"], "2"], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8e2c08bf-e0ed-bd43-a16f-a94977949ae4"],
 Cell[BoxData[
  FormBox[
   RowBox[{">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cfcad725-1d78-5b46-9ec5-b799c45ce643"],
 "."
}], "Text",
 CellID->276578929,ExpressionUUID->"64a42b51-2012-3345-8b4b-ba33c51d4fbd"],

Cell[TextData[{
 "This can be visualized with the Wigner representation, using some time in \
between ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "decay"], TraditionalForm]],ExpressionUUID->
  "c9c6aa60-cda2-6841-9639-3346824ad811"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "decoh"], TraditionalForm]],ExpressionUUID->
  "bb8b9912-9315-4948-a6d2-26acb382f213"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9542393614481564`*^9, 3.9542393725373096`*^9}, {
  3.954239428995653*^9, 3.954239457409916*^9}, {3.9727330019670544`*^9, 
  3.9727330208418903`*^9}},
 CellID->158154556,ExpressionUUID->"0b1e9419-3738-f040-ae22-c47460eb23a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Tevol", " ", "=", " ", 
   FractionBox["1", 
    RowBox[{"2", "\[Gamma]"}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.954239413843569*^9, 3.954239415317045*^9}},
 CellLabel->"In[266]:=",
 CellID->275900283,ExpressionUUID->"f01604bd-de33-9b4a-920d-d5037409c242"],

Cell["Statistical mixture of coherent states:", "Text",
 CellChangeTimes->{{3.9542394653884354`*^9, 3.9542394706685658`*^9}, {
  3.9727331824286213`*^9, 3.972733184812479*^9}},
 CellID->314274867,ExpressionUUID->"bf6aa33a-0c44-514f-9bda-6675ec9e2e6c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]mix", " ", "=", " ", 
   RowBox[{"Mean", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"CoherentState", "[", "]"}], "[", "#", "]"}], 
       "[", "\"\<MatrixState\>\"", "]"}], "&"}], "/@", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]coh", ",", 
       RowBox[{"-", "\[Alpha]coh"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[267]:=",
 CellID->5982757,ExpressionUUID->"fef344a4-6468-f646-973d-2970e87a1aad"],

Cell[TextData[StyleBox["Plot the Wigner function of the states:", "Text"]], \
"CodeText",
 CellID->205106674,ExpressionUUID->"b87b31c8-f5a5-6e43-be66-a601014eddec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"wig", " ", "=", " ", 
       RowBox[{"WignerRepresentation", "[", 
        RowBox[{
         RowBox[{"s", "[", 
