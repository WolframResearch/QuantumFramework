Cell[CellGroupData[{

Cell[TextData[StyleBox["8.3 Generation of coherent states from decoherence: \
optical balance", "Subsection"]], "Subsection",
 CellID->21766836,ExpressionUUID->"d3c95ff8-002d-7e4f-9f4b-34bd35c086e5"],

Cell["\<\
Dissipation destroys coherence in quantum superposition effects. However, \
even if it does not sound intuitive, it is also possible to create \
\[OpenCurlyDoubleQuote]coherence\[CloseCurlyDoubleQuote] from dissipative \
effects. The master equation has unitary(the commutator term)and non-unitary \
terms(dissipation) with nonlinear behavior in the creation and annihilation \
operators. It possible that the interactions can \
\[OpenCurlyDoubleQuote]balance each other\[CloseCurlyDoubleQuote] such that \
the evolution at t \[Rule] \[Infinity]  converges to a different state than \
the vacuum.\
\>", "Text",
 CellID->790245475,ExpressionUUID->"00a2228f-553e-3d41-8f3a-db44c6c8c2f2"],

Cell[TextData[{
 "Considering an interaction Hamiltonian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     SubscriptBox["H", "I"], "^"], " ", "=", " ", 
    RowBox[{"h", " ", 
     RowBox[{"G", "(", 
      RowBox[{
       OverscriptBox["a", "^"], "+", 
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"]}], ")"}], " "}]}], 
   TraditionalForm]],ExpressionUUID->"b3116940-4919-6348-b712-1e76c04482b8"],
 " where ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "c41ad396-0b75-584c-80eb-8347291a93c5"],
 " is the strength of a pump field that propagates in a photon absorbing \
medium (dissipation). The master equation then can be described as:"
}], "Text",
 CellID->246585398,ExpressionUUID->"02b83811-a3af-3a4f-ba69-fdddf2ff08f0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"d", 
     OverscriptBox["\[Rho]", "^"]}], 
    RowBox[{"d", "t"}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], "G", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{
        OverscriptBox["a", "^"], "+", 
        SuperscriptBox[
         OverscriptBox["a", "^"], "\[Dagger]"]}], ",", 
       OverscriptBox["\[Rho]", "^"]}], "]"}]}], "+", 
    RowBox[{
     FractionBox["\[Gamma]", "2"], "(", 
     RowBox[{
      RowBox[{"2", " ", 
       OverscriptBox["a", "^"], 
       OverscriptBox["\[Rho]", "^"], 
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"]}], "-", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"], 
       OverscriptBox["a", "^"], 
       OverscriptBox["\[Rho]", "^"]}], "-", 
      RowBox[{
       OverscriptBox["\[Rho]", "^"], 
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"], 
       OverscriptBox["a", "^"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.985950092844572*^9, 3.9859501562542744`*^9},
 CellID->929398382,ExpressionUUID->"c00954b3-8203-624e-b53a-b3fcd1f448ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "\"\<Lindblad\>\"", "]"}], ";"}]], "Input",
 CellLabel->"In[287]:=",
 CellID->325859117,ExpressionUUID->"cd279d9d-0fa9-9f40-b7e3-7f76ddd08e6e"],

Cell["We start with a random cavity field:", "Text",
 CellChangeTimes->{{3.927297773925234*^9, 3.927297790513159*^9}, 
   3.9542410977290535`*^9},
 CellID->78873866,ExpressionUUID->"b22edf77-5403-ab4d-a034-6d992cd08df8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"\"\<RandomPure\>\"", ",", "$FockSize"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[288]:=",
 CellID->20379731,ExpressionUUID->"7038f51e-c0d3-2b48-bbd4-e811cb1b0487"],

Cell["\<\
Establishing simulation parameters, driving strength and photon loss rate:\
\>", "Text",
 CellChangeTimes->{{3.954240756812973*^9, 3.954240793996073*^9}},
 CellID->20494533,ExpressionUUID->"86e2015b-802f-b64a-bf61-714ad29cd0df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"G", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Gamma]", "  ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"{", 
     RowBox[{"1.5", ",", "2"}], "}"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.927295560685646*^9, 3.927295573366431*^9}, 
   3.95423990579702*^9, 3.954240751145092*^9},
 CellLabel->"In[289]:=",
 CellID->644000454,ExpressionUUID->"a178ca8e-f13d-384d-b537-5975b7db673d"],

Cell[TextData[{
 "For the Lindbladian of the master equation we now consider a driving \
interaction term so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["H", "^"], "\[NotEqual]", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"ae7d6d19-561e-1e41-ae70-09f7341e8671"],
 ":"
}], "Text",
 CellID->550802729,ExpressionUUID->"b7525286-5077-9e43-b554-f43b6977a2a3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalL]", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Liouvillian\>\"", "[", 
     RowBox[{
      RowBox[{"G", 
       RowBox[{"(", 
        RowBox[{"a", "+", 
         SuperscriptBox["a", "\[Dagger]"]}], ")"}]}], ",", 
      RowBox[{"{", "a", "}"}], ",", 
      RowBox[{"{", "\[Gamma]", "}"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9272956599586544`*^9, 3.9272956662797184`*^9}, {
  3.9542408103850765`*^9, 3.954240817387207*^9}},
 CellLabel->"In[291]:=",
 CellID->395198230,ExpressionUUID->"78447b08-32f4-f843-b24a-4f806dd80c0e"],

Cell["Solving the master equation numerically:", "Text",
 CellChangeTimes->{{3.95424084779138*^9, 3.954240854696741*^9}, {
  3.9727334955434113`*^9, 3.972733497002117*^9}},
 CellID->443403098,ExpressionUUID->"d18599e0-3d7c-6b4a-bddb-3cb6ed9a96ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]t", " ", "=", 
   RowBox[{"QuantumEvolve", "[", " ", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", "\[ScriptCapitalL]"}], ",", "\[Rho]0", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[292]:=",
 CellID->152350170,ExpressionUUID->"aa41c172-751e-4a4e-85e7-bb9be1bf5cf9"],

Cell[TextData[{
 "The steady-state solution of the equation can be shown to converge to \
\[Rho] = ",
 Cell[BoxData[
  FormBox["|", TraditionalForm]],ExpressionUUID->
  "0888225d-8c73-6f4d-b158-9ce0d51a8162"],
 " \[Beta] ",
 Cell[BoxData[
  FormBox["\[RightAngleBracket]", TraditionalForm]],ExpressionUUID->
  "f28fd517-5674-5f45-85d2-a174eeaf1a5e"],
 " ",
 Cell[BoxData[
  FormBox["\[LeftAngleBracket]", TraditionalForm]],ExpressionUUID->
  "738d1bb8-f336-5941-b88a-fad2c3960ab9"],
 "\[Beta] ",
 Cell[BoxData[
  FormBox["|", TraditionalForm]],ExpressionUUID->
  "a5330d05-ce08-e04c-90f7-631b4355a633"],
 " where \[Beta] = - 2 \[ImaginaryI] G/\[Gamma]"
}], "Text",
 CellID->217781661,ExpressionUUID->"45fc2102-4cd8-f249-a9ba-89be488109a6"],

Cell["\<\
Compute the fidelity between the evolved state and the proposed solution:\
\>", "Text",
 CellID->661042094,ExpressionUUID->"b8b10a18-6f4d-4a4a-a780-b1c13c29489a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"similarities", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"QuantumSimilarity", "[", 
        RowBox[{
         RowBox[{"\[Rho]t", "[", "t", "]"}], ",", 
         RowBox[{
          RowBox[{"CoherentState", "[", "]"}], "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", "2", 
           RowBox[{"G", "/", "\[Gamma]"}]}], "]"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "3", ",", "0.1"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[293]:=",
 CellID->153052932,ExpressionUUID->"c47d7bcd-5ac0-a246-a34a-bf5bb20c2880"],

Cell[TextData[StyleBox["Plot state-fidelity, we see it approaches 1 as time \
evolves:", "Text"]], "CodeText",
 CellChangeTimes->{{3.968178598352684*^9, 3.9681786345509605`*^9}},
 CellID->190498180,ExpressionUUID->"12452e42-9d3d-6045-ad3a-b4add8a89a1d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"similarities", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
