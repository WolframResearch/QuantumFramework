 CellID->820754307,ExpressionUUID->"2ff5b08d-6297-3f43-b6c2-2553c6d0cd13"]
}, Open  ]],

Cell[TextData[{
 "The same physics looks simpler in intensity and phase.  Defining ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalI]", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["x", "2"], "+", 
        SuperscriptBox["p", "2"]}], ")"}], "/", "2"}], "=", 
     RowBox[{"|", "\[Alpha]", 
      SuperscriptBox["|", "2"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d68cf5a7-e837-4543-a67f-c2cedf27a0d8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyPhi]", "=", 
    RowBox[{
     SuperscriptBox["tan", 
      RowBox[{"-", "1"}]], "(", 
     RowBox[{"p", "/", "x"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2cfa65f6-1a24-3543-a127-fefb5e435adc"],
 " . Changing variables in Ito calculus is not the same as ordinary calculus \
and needs It\[OHat]\[CloseCurlyQuote]s lemma"
}], "Text",
 CellID->9748333,ExpressionUUID->"73be110e-33b5-0a42-9428-3f9912910ecc"],

Cell[TextData[{
 "We can use ",
 StyleBox["ItoProcessChangeVariables", "FormattedFunction"],
 " resource function for this:"
}], "Text",
 CellID->365375147,ExpressionUUID->"a051ce52-3c3d-2c4f-b570-c77a39dd0df3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"polar", "=", 
   RowBox[{
    RowBox[{
    "ResourceFunction", "[", "\"\<ItoProcessChangeVariables\>\"", "]"}], "[", 
    RowBox[{"proc", ",", 
     RowBox[{"{", 
      RowBox[{"\[ScriptCapitalI]", ",", "\[CurlyPhi]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[ScriptCapitalI]", "\[Equal]", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", "2"], "+", 
           SuperscriptBox["p", "2"]}], ")"}]}]}], ",", 
       RowBox[{"\[CurlyPhi]", "\[Equal]", 
        RowBox[{"ArcTan", "[", 
         RowBox[{"x", ",", "p"}], "]"}]}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[103]:=",
 CellID->650887292,ExpressionUUID->"2684bca6-6acb-0f43-a3db-12d2eb7870b4"],

Cell["\<\
It returns also an Ito process that we can access its properties:\
\>", "Text",
 CellID->38574566,ExpressionUUID->"bae7b94c-1d2c-3a44-a2a8-274a68ad7182"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"polar", "[", "\"\<Drift\>\"", "]"}], ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"polar", "[", "\"\<Diffusion\>\"", "]"}], ".", 
     RowBox[{
      RowBox[{"polar", "[", "\"\<Diffusion\>\"", "]"}], "\[Transpose]"}]}], 
    "]"}]}], "}"}]], "Input",
 CellLabel->"In[117]:=",
 CellID->229281688,ExpressionUUID->"b421a0ca-57b8-c64e-810f-ba5e4c709087"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["\[Gamma]", "2"], "+", 
      RowBox[{"\[Gamma]", " ", 
       OverscriptBox["n", "_"]}], "-", 
      RowBox[{"\[Gamma]", " ", 
       RowBox[{"\[ScriptCapitalI]", "[", "t", "]"}]}]}], ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Gamma]", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", 
           OverscriptBox["n", "_"]}]}], ")"}], " ", 
        RowBox[{"\[ScriptCapitalI]", "[", "t", "]"}]}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox[
        RowBox[{"\[Gamma]", "+", 
         RowBox[{"2", " ", "\[Gamma]", " ", 
          OverscriptBox["n", "_"]}]}], 
        RowBox[{"4", " ", 
         RowBox[{"\[ScriptCapitalI]", "[", "t", "]"}]}]]}], "}"}]}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[117]=",
 CellID->672021363,ExpressionUUID->"f78e0dd1-deef-c94b-bcb4-8acd175e1c3b"]
}, Open  ]],

Cell[TextData[{
 "The  constant \[Gamma] (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["n", "\[LongDash]"], "+", 
    RowBox[{"1", "/", "2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "02cfad6c-388b-f64c-ba78-7bdd3ee05010"],
 ") is the Ito term and it is the whole source of the thermal photons. The \
phase has no drift but diffuses at a rate proportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "\[ScriptCapitalI]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c30a2012-258a-6241-a502-554a3d8eff39"],
 ", the more intense the field the more slowly its phase disperses."
}], "Text",
 CellID->512956064,ExpressionUUID->"0cb29789-4713-584b-9bd7-43252920336f"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s now do a numerical implementation with three \
methods: solving the PDE of the Fokker-Planck equation, sampling Langevin \
trajectories with ",
 StyleBox["RandomFunction ", "FormattedFunction"],
 Cell[BoxData[
  FormBox["and", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "63a97beb-7471-9248-88d1-d6ec4880c2cd"],
 " density matrix evolution with ",
 StyleBox["QuantumEvolve", "FormattedFunction"]
}], "Text",
 CellID->480504062,ExpressionUUID->"88f80abb-cc1c-744c-8164-3c89d1687319"],

Cell[TextData[{
 "Set up parameters, start from a coherent state with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "=", "3"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bbdee88d-6412-ae4a-a95a-afe0318c18bf"],
 " and a thermal bath with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["n", "\[LongDash]"], "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8363de70-7c36-5f45-b56b-34502d4c664d"],
 ":"
}], "Text",
 CellID->18197656,ExpressionUUID->"7c8e6368-5ff0-e446-b287-9f6c27ed1286"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nPaths", "=", "400"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tStep", "=", "0.02"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tEnd", "=", "4"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"amplitude", "=", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"values", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Gamma]", "\[Rule]", "1"}], ",", 
     RowBox[{
      OverscriptBox["n", "_"], "\[Rule]", "2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "50", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"number", "=", 
   RowBox[{
    SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], ";"}]}], "Input",
 CellLabel->"In[453]:=",
 CellID->62853097,ExpressionUUID->"75a8d9bf-7ee9-c54e-a42f-020c4d084694"],

Cell[TextData[{
 "The initial condition is the coherent state\[CloseCurlyQuote]s Wigner \
function from ",
 StyleBox["WignerRepresentation", "FormattedFunction"],
 ", an interpolating function on a grid:"
}], "Text",
 CellID->37108976,ExpressionUUID->"c708653e-b878-f54e-92dc-f4d9ee1a36a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Psi]0", "=", 
   RowBox[{
    RowBox[{"CoherentState", "[", "]"}], "[", "amplitude", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"w0", "=", 
   RowBox[{"WignerRepresentation", "[", 
    RowBox[{"\[Psi]0", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "7"}], ",", "10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "7"}], ",", "7"}], "}"}], ",", 
     RowBox[{"\"\<GridSize\>\"", "\[Rule]", "200"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[462]:=",
 CellID->590926915,ExpressionUUID->"4b4ad3f2-ed0e-c24d-8c63-b1653b4bbd2c"],

Cell[TextData[{
 "The PDE solution is a function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"wigner", "[", 
    RowBox[{"x", ",", " ", "p", ",", " ", "t"}], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "faeef15b-f7e7-d545-8d6b-4829acbdcfc5"],
 ", with its arguments in the order of \:2119[x, p, t]:"
}], "Text",
 CellID->403387022,ExpressionUUID->"b1a48b3b-0b27-e945-8f70-a37475503605"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wigner", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Activate", "[", 
         RowBox[{"proc", "[", "\"\<KolmogorovForwardEquation\>\"", "]"}], 
         "]"}], "/.", "\[VeryThinSpace]", "values"}], ",", 
       RowBox[{
        RowBox[{"\[FormalP]", "[", 
         RowBox[{"x", ",", "p", ",", "0"}], "]"}], "\[Equal]", 
        RowBox[{"w0", "[", 
         RowBox[{"x", ",", "p"}], "]"}]}], ",", 
       RowBox[{"DirichletCondition", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[FormalP]", "[", 
           RowBox[{"x", ",", "p", ",", "t"}], "]"}], "\[Equal]", "0"}], ",", 
         "True"}], "]"}]}], "}"}], ",", "\[FormalP]", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tEnd"}], "}"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "p"}], "}"}], "\[Element]", 
      RowBox[{"Rectangle", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "7"}], ",", 
          RowBox[{"-", "7"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"10", ",", "7"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"Method", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<PDEDiscretization\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<MethodOfLines\>\"", ",", 
          RowBox[{"\"\<SpatialDiscretization\>\"", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"\"\<FiniteElement\>\"", ",", 
             RowBox[{"\"\<MeshOptions\>\"", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"\"\<MaxCellMeasure\>\"", "\[Rule]", "0.02"}], 
               "}"}]}]}], "}"}]}]}], "}"}]}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellID->495798556,ExpressionUUID->"030b093e-6b17-f44c-9f8d-92485c755277"],

Cell[TextData[{
 "Evolution with ",
 StyleBox["QuantumEvolve", "FormattedFunction"],
 ":"
}], "Text",
 CellID->8895448,ExpressionUUID->"c9bd38f9-2091-a345-914c-86a6b805043a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]t", "=", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{"0", " ", "number"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SqrtBox[
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Gamma]", " ", 
            RowBox[{"(", 
             RowBox[{
              OverscriptBox["n", "_"], "+", "1"}], ")"}]}], ",", 
           RowBox[{"\[Gamma]", " ", 
            OverscriptBox["n", "_"]}]}], "}"}]], "/.", "\[VeryThinSpace]", 
        "values"}], ")"}], " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", 
        SuperscriptBox["a", "\[Dagger]"]}], "}"}]}], ",", "\[Psi]0", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tEnd"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[477]:=",
 CellID->140604402,ExpressionUUID->"baabf019-96b2-5b41-96fd-a3599abf575c"],

Cell["Sampling mean photon number:", "Text",
 CellID->838567502,ExpressionUUID->"a549f298-9f47-3546-abe4-013f64be9de7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"nQF", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Tau]", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"QuantumMeasurementOperator", "[", "number", "]"}], "[", 
         RowBox[{"\[Rho]t", "[", "\[Tau]", "]"}], "]"}], "[", "\"\<Mean\>\"", 
        "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]", ",", "0", ",", "tEnd", ",", 
       FractionBox["tEnd", "10"]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[477]:=",
 CellID->6532964,ExpressionUUID->"9414640e-c195-0448-81dd-99027a57ed02"],

Cell["\<\
We show the time-lapse of the cloud. The trajectories are frozen at four \
instants, one color per instant, and each dot is one trajectory at that \
moment. The circle of the same color is the PDE solution at that instant, \
drawn one standard deviation from its center. Three individual trajectories \
are drawn in light gray. Each one is a jagged path, the drift carries it \
towards the origin, and the noise kicks it sideways at every step\
\>", "Text",
 CellID->114960267,ExpressionUUID->"c09db6dc-e9f6-9b4d-b59e-55f264873a34"],

Cell[TextData[{
 "And we also observe the two effects, the center of the cloud \
\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e511423d-3b3f-6c47-b41d-cc040ac8fd53"],
 "\[RightAngleBracket] is moved by the drift it decays to the origin as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[Gamma]"}], " ", 
     RowBox[{"t", "/", "2"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2bb99e9f-b9d5-af4d-883d-6ee919aa5806"],
 ".  The spread of the cloud is set by the competition of drift and \
diffusion.  The drift squeezes the initial spread ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "2", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a36cf2af-f15b-5e4e-9b96-89a4fc9f8ed6"],
 " by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[Dash]", 
     RowBox[{"\[Gamma]", " ", "t"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "69d9a800-6d80-6046-8de0-326ddd9fa2ee"],
 " while the noise feeds new spread until the variance settles at the thermal \
value ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["n", "\[LongDash]"], "+", 
     RowBox[{"1", "/", "2"}]}], "=", "2.5"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "732f6834-2a41-b146-9730-bcfb9208b904"]
}], "Text",
 CellID->37996024,ExpressionUUID->"65211714-7fe3-204e-a69d-43f7ee9d85f8"],

Cell["\<\
Visualize the result, we show up to 100 trajectories in the plot but all \
enter the average calculation. The shaded bands show how far the dots should \
scatter two standard deviations of the Monte Carlo error\
\>", "Text",
 CellID->781872778,ExpressionUUID->"aacf4bb0-940d-8442-bfbf-f1a4569e9316"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["timeLapse", "FormattedFunction"],
 " and ",
 StyleBox["driftDiffusion", "FormattedFunction"],
 " code"
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->78448215,ExpressionUUID->"81f4cf7b-fb98-ad43-8c03-ef64b7f12210"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"times", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0.5", ",", "1.5", ",", "4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"colors", "=", 
   RowBox[{"{", 
    RowBox[{"Black", ",", "Blue", ",", 
     RowBox[{"Darker", "[", "Green", "]"}], ",", "Red"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cloudAt", "[", "\[Tau]_", "]"}], ":=", 
   RowBox[{"paths", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", 
      RowBox[{
       RowBox[{"Round", "[", 
        RowBox[{"\[Tau]", "/", "tStep"}], "]"}], "+", "1"}]}], "]"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"centre", "[", "\[Tau]_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"First", "[", 
       RowBox[{"Mean", "[", 
        RowBox[{"proc", "[", "\[Tau]", "]"}], "]"}], "]"}], "/.", " ", 
      "values"}], "/.", " ", 
     RowBox[{"x0", "->", 
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], " ", "amplitude"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"nShow", "=", 
   RowBox[{"Min", "[", 
    RowBox[{"100", ",", "nPaths"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"timeLapse", "=", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"paths", "[", 
         RowBox[{"[", 
          RowBox[{";;", "3"}], "]"}], "]"}], ",", 
        InterpretationBox[
         DynamicModuleBox[{Typeset`open = False}, 
          TemplateBox[{"Expression", 
            RowBox[{
              DynamicBox[
               FEPrivate`FrontEndResource["FEBitmaps", "IconizeEllipsis"]], 
              "\[Rule]", 
              DynamicBox[
               FEPrivate`FrontEndResource["FEBitmaps", "IconizeEllipsis"]]}], 
            GridBox[{{
               RowBox[{
                 TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                 TagBox["Rule", "IconizedItem"]}]}, {
               RowBox[{
                 TagBox["\"Byte count: \"", "IconizedLabel"], 
                 "\[InvisibleSpace]", 
                 TagBox["240", "IconizedItem"]}]}}, 
             GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
             "Column", 
             GridBoxItemSize -> {
              "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
            Dynamic[Typeset`open]},
           "IconizedObject"]],
         PlotStyle -> Directive[
           GrayLevel[0.75], 
           Thickness[0.002]],
         SelectWithContents->True,
         Selectable->False]}], "]"}], ",", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ListPlot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"cloudAt", "[", "#1", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{";;", "nShow"}], "]"}], "]"}], ",", 
           InterpretationBox[
            DynamicModuleBox[{Typeset`open = False}, 
             TemplateBox[{"Expression", 
               RowBox[{
                 DynamicBox[
                  FEPrivate`FrontEndResource["FEBitmaps", "IconizeEllipsis"]],
                  "\[Rule]", 
                 DynamicBox[
                  FEPrivate`FrontEndResource[
                  "FEBitmaps", "IconizeEllipsis"]]}], 
               GridBox[{{
                  RowBox[{
                    TagBox["\"Head: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["Rule", "IconizedItem"]}]}, {
                  RowBox[{
                    TagBox["\"Byte count: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["312", "IconizedItem"]}]}}, 
                GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
                "Column", 
                GridBoxItemSize -> {
                 "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
               Dynamic[Typeset`open]},
              "IconizedObject"]],
            PlotStyle -> Directive[#2, 
              PointSize[0.009], 
              Opacity[0.6]],
            SelectWithContents->True,
            Selectable->False]}], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"times", ",", "colors"}], "}"}]}], "]"}], ",", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ContourPlot", "[", 
          RowBox[{
           RowBox[{"wigner", "[", 
            RowBox[{"x", ",", "p", ",", "#1"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "6"}], ",", "9"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"p", ",", 
             RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
           InterpretationBox[
            DynamicModuleBox[{Typeset`open = False}, 
             TemplateBox[{"Expression", "SequenceIcon", 
               GridBox[{{
                  RowBox[{
                    TagBox["\"Head: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["Sequence", "IconizedItem"]}]}, {
                  RowBox[{
                    TagBox["\"Length: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["5", "IconizedItem"]}]}, {
                  RowBox[{
                    TagBox["\"Byte count: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["1064", "IconizedItem"]}]}}, 
                GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
                "Column", 
                GridBoxItemSize -> {
                 "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
               Dynamic[Typeset`open]},
              "IconizedObject"]],
            Sequence[Contours -> {Exp[(-1)/2] $CellContext`wigner[
                 $CellContext`centre[#], 0, #]}, ContourShading -> None, 
             ContourStyle -> Directive[#2, Thick], PlotRange -> All, 
             PlotPoints -> 50],
            SelectWithContents->True,
            Selectable->False]}], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"times", ",", "colors"}], "}"}]}], "]"}], ",", 
      InterpretationBox[
       DynamicModuleBox[{Typeset`open = False}, 
        TemplateBox[{"Expression", "SequenceIcon", 
          GridBox[{{
             RowBox[{
               TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["Sequence", "IconizedItem"]}]}, {
             RowBox[{
               TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["7", "IconizedItem"]}]}, {
             RowBox[{
               TagBox["\"Byte count: \"", "IconizedLabel"], 
               "\[InvisibleSpace]", 
               TagBox["1408", "IconizedItem"]}]}}, 
           GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
           "Column", 
           GridBoxItemSize -> {
            "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
          Dynamic[Typeset`open]},
         "IconizedObject"]],
       Sequence[
       Frame -> True, Axes -> False, FrameLabel -> {"x", "p"}, AspectRatio -> 
        Automatic, PlotRange -> {{-6, 9}, {-6, 6}}, ImageSize -> 420, Epilog -> 
        Inset[
          LineLegend[$CellContext`colors, 
           Map[Row[{"\[Gamma]t = ", #}]& , $CellContext`times]], 
          Scaled[{0.86, 0.8}]]],
       SelectWithContents->True,
       Selectable->False]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"meanCurve", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"First", "[", 
      RowBox[{"Mean", "[", 
       RowBox[{"proc", "[", "t", "]"}], "]"}], "]"}], "/.", " ", "values"}], "/.",
     " ", 
    RowBox[{"x0", "->", 
     RowBox[{
      RowBox[{"Sqrt", "[", "2", "]"}], " ", "amplitude"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"varianceCurve", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Covariance", "[", 
       RowBox[{"proc", "[", "t", "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Gamma]"}], " ", "t"}], "]"}], "/", "2"}]}], "/.", " ",
     "values"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"stats", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Tau]", ",", 
       RowBox[{"Mean", "[", 
        RowBox[{
         RowBox[{"cloudAt", "[", "\[Tau]", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"Variance", "[", 
        RowBox[{
         RowBox[{"cloudAt", "[", "\[Tau]", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]", ",", "0", ",", "tEnd", ",", 
       RowBox[{"10", " ", "tStep"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"driftDiffusion", "=", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"meanCurve", "+", 
           RowBox[{"2", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"varianceCurve", "/", "nPaths"}], "]"}]}]}], ",", 
          RowBox[{"meanCurve", "-", 
           RowBox[{"2", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"varianceCurve", "/", "nPaths"}], "]"}]}]}], ",", 
          RowBox[{"varianceCurve", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"2", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"2", "/", 
                RowBox[{"(", 
                 RowBox[{"nPaths", "-", "1"}], ")"}]}], "]"}]}]}], ")"}]}], ",", 
          RowBox[{"varianceCurve", " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"2", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"2", "/", 
                RowBox[{"(", 
                 RowBox[{"nPaths", "-", "1"}], ")"}]}], "]"}]}]}], ")"}]}]}], 
         "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tEnd"}], "}"}], ",", 
       InterpretationBox[
        DynamicModuleBox[{Typeset`open = False}, 
         TemplateBox[{"Expression", "SequenceIcon", 
           GridBox[{{
              RowBox[{
                TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
