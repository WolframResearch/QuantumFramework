Cell[BoxData[
 RowBox[{
  RowBox[{"H", " ", "=", "  ", 
   RowBox[{
    RowBox[{"\[Nu]", " ", 
     RowBox[{
      SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], "+", " ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", "\[Omega]", " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Z\>\"", ",", "atomBasis"}], "]"}]}], "+", 
    RowBox[{"gc", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Sigma]plus", "@", "a"}], "+", 
       RowBox[{"\[Sigma]minus", "@", 
        SuperscriptBox["a", "\[Dagger]"]}]}], ")"}]}]}]}], 
  ";"}]], "ExerciseInput",
 CellLabel->"In[54]:=",
 CellID->33271166,ExpressionUUID->"03591388-e83f-4641-9f67-5590710b1433"],

Cell["Master equation set up:", "SolutionAnswer",
 CellID->145029955,ExpressionUUID->"2524d3f2-3dd4-7b49-9195-913ffa852fb5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"decayAtom", " ", "=", " ", 
   RowBox[{"\[Sigma]minus", "@", 
    RowBox[{"QuantumOperator", "[", 
     RowBox[{
      RowBox[{"\"\<I\>\"", "[", "$FockSize", "]"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lossField", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"\"\<I\>\"", ",", "atomBasis"}], "]"}], "@", "a"}]}], 
  ";"}]}], "ExerciseInput",
 CellChangeTimes->{{3.9397368503673954`*^9, 3.93973685218326*^9}, 
   3.9668884341579*^9, 3.966888538090782*^9},
 CellLabel->"In[56]:=",
 CellID->23717435,ExpressionUUID->"e2f7cb00-b2af-5649-a67f-955aa637050f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalH]", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Hamiltonian\>\"", "[", 
     RowBox[{"H", ",", " ", 
      RowBox[{"{", 
       RowBox[{"decayAtom", ",", " ", "lossField"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]1", ",", " ", "\[Gamma]2"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "ExerciseInput",
