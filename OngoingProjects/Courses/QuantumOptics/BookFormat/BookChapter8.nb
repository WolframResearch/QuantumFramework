Cell[CellGroupData[{

Cell["\<\
8.6  Phase space methods with Langevin/Fokker Planck equations\
\>", "Subsection",
 CellID->346717352,ExpressionUUID->"47f7914f-82de-1748-8637-205e8b284773"],

Cell[TextData[{
 "The master equation of section 8.3 evolves a density matrix. A cavity \
truncated at \n",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8b4a9579-24f0-5d4c-b0a8-8f199feb087d"],
 " photons needs ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["N", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1c8fdb4c-c81d-ff41-afa0-c62726af464a"],
 " numbers, and ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "66314c90-8f7f-5846-916f-60925e96a24b"],
 " modes need ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["N", 
    RowBox[{"2", "M"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3840d2e0-ada8-8641-a3cd-07c6bab9b415"],
 ". Phase-space methods trade the density matrix for a quasi-probability \
distribution ",
 Cell[BoxData[
  FormBox["W", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "36468705-de0e-8c4a-948a-ded21ab006a2"],
 "(",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2a1137f5-8bea-e245-8429-a15ae1134305"],
 ", ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "682f5087-6282-724d-a4cd-df100a32ce43"],
 ").  When that distribution obeys a Fokker\[Dash]Planck equation,  we can \
sample it with classical stochastic trajectories that the cost grows linearly \
with the number of modes."
}], "Text",
 CellID->368682538,ExpressionUUID->"2794be4f-db5b-5b47-aa07-612e1647d383"],

Cell["We will use the following workflow:", "Text",
 CellID->177172136,ExpressionUUID->"058551ec-1028-784b-86a8-7ef1da20d023"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["master equation ", "DisplayFormula"],
 StyleBox[Cell[BoxData[
  FormBox["->", TraditionalForm]], "DisplayFormula",ExpressionUUID->
  "cbaa68cd-9659-3c40-a425-5ede0edcc8db"], "DisplayFormula"],
 StyleBox[" Fokker-Planck equation \[LeftRightArrow] ", "DisplayFormula"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{"Langevin", "/", "Ito"}], TraditionalForm]], "DisplayFormula",
  ExpressionUUID->"ad5a8283-e833-b643-a8b3-7abe7bae8902"], "DisplayFormula"],
 StyleBox[" (", "DisplayFormula"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[DifferentialD]", 
      StyleBox["x",
       FontWeight->"Bold"]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"A", "(", 
        StyleBox["x",
         FontWeight->"Bold"], ")"}], 
       RowBox[{"\[DifferentialD]", "t"}]}], "+", 
      RowBox[{
       RowBox[{"B", "(", 
        StyleBox["x",
         FontWeight->"Bold"], ")"}], 
       RowBox[{"\[DifferentialD]", "W"}]}]}]}], ")"}], TraditionalForm]], 
  "DisplayFormula",ExpressionUUID->"ab0555cc-2446-f24c-9a33-f75725b160e1"], 
  "DisplayFormula"],
 StyleBox["\[LineSeparator]where ", "DisplayFormula"],
 StyleBox[Cell[BoxData[
  FormBox["A", TraditionalForm]], "DisplayFormula",ExpressionUUID->
  "6b1b6e99-12b5-ac44-9907-77ffc2680245"], "DisplayFormula"],
 StyleBox[" and ", "DisplayFormula"],
 StyleBox[Cell[BoxData[
  FormBox["B", TraditionalForm]], "DisplayFormula",ExpressionUUID->
  "7791c27b-5238-b242-9513-b96b3ea0675e"], "DisplayFormula"],
 StyleBox[" are the drift and diffusion matrix of the process", 
  "DisplayFormula"]
}], "ExerciseSectionNote",
 CellID->147784489,ExpressionUUID->"1f1ce328-1948-3647-8a95-59cd752aff18"],

Cell[TextData[{
 "For the s-parameter quasi-probability function, we can associate \
multiplying \[Rho] by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bcdb1a81-5f3e-034b-bcd6-e5b0d2b3192b"],
 "and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "\[Dagger]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c4b446da-0dd8-a74e-bc91-ece9a199e5db"],
 " to a differential operator affecting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"W", "(", 
    RowBox[{"\[Alpha]", ",", "s"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "82ef42cf-07cd-b648-b337-3658bd862d91"],
 ". They are called Bopp differential operators and have the following rules:"
}], "Text",
 CellID->735507557,ExpressionUUID->"0a9ce1cd-48ae-0042-9a77-4bdff1ac7efa"],

Cell[BoxData[{
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"a", " ", "\[Rho]"}], " ", "->", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Alpha]", " ", "+", " ", 
       RowBox[{
        FractionBox[
         RowBox[{"1", "-", "s"}], "2"], " ", 
        SubscriptBox["\[PartialD]", 
         RowBox[{"\[Alpha]", "\[Conjugate]"}]]}]}], ")"}], "W"}]}], " ", ",", 
   "     ", 
   RowBox[{
    RowBox[{
     SuperscriptBox["a", "\[Dagger]"], "\[Rho]"}], "->", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Alpha]", "\[Conjugate]"}], "-", 
       RowBox[{
        FractionBox[
         RowBox[{"1", "-", "s"}], "2"], 
        SubscriptBox["\[PartialD]", "\[Alpha]"]}]}], ")"}], "W"}]}]}], 
  TraditionalForm], "\[LineSeparator]", 
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", " ", "a"}], "->", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Alpha]", " ", "-", " ", 
       RowBox[{
        FractionBox[
         RowBox[{"1", "+", "s"}], "2"], " ", 
        SubscriptBox["\[PartialD]", 
         RowBox[{"\[Alpha]", "\[Conjugate]"}]]}]}], ")"}], "W"}]}], "  ", ",",
    "     ", 
   RowBox[{
    RowBox[{"\[Rho]", " ", 
     SuperscriptBox["a", "\[Dagger]"]}], "\[Rule]", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Alpha]", "\[Conjugate]"}], "+", 
       RowBox[{
        FractionBox[
         RowBox[{"1", "-", "s"}], "2"], " ", 
        SubscriptBox["\[PartialD]", "\[Alpha]"]}]}], ")"}], "W", " "}]}]}], 
  TraditionalForm]}], "DisplayFormula",
 CellID->230941832,ExpressionUUID->"fba63637-c5e6-4f44-acca-b4e6cd263b94"],

Cell["Define the Bopp rules application:", "Text",
 CellID->165348485,ExpressionUUID->"77ae371b-aa72-da48-8f55-ccc33e18d0f7"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"\[Alpha]", ",", "\[Alpha]c"}], "]"}]], "Input",
 CellLabel->"In[84]:=",
 CellID->615269,ExpressionUUID->"a357f336-782f-f44a-ab03-866d4fc19571"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Alpha]", "=", 
   FractionBox[
    RowBox[{"x", "+", 
     RowBox[{"\[ImaginaryI]", " ", "p"}]}], 
    SqrtBox["2"]]}], ";", 
  RowBox[{"\[Alpha]c", "=", 
   FractionBox[
    RowBox[{"x", "-", 
     RowBox[{"\[ImaginaryI]", " ", "p"}]}], 
    SqrtBox["2"]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"d\[Alpha]", "[", "f_", "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], "f"}], "-", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{
       SubscriptBox["\[PartialD]", "p"], "f"}]}]}], 
    SqrtBox["2"]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"d\[Alpha]c", "[", "f_", "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], "f"}], "+", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{
       SubscriptBox["\[PartialD]", "p"], "f"}]}]}], 
    SqrtBox["2"]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"a\[Rho]", "[", "f_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Alpha]", " ", "f"}], "+", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "s"}], ")"}], " ", 
     RowBox[{"d\[Alpha]c", "[", "f", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ad\[Rho]", "[", "f_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Alpha]c", " ", "f"}], "-", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "s"}], ")"}], " ", 
     RowBox[{"d\[Alpha]", "[", "f", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]a", "[", "f_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Alpha]", " ", "f"}], "-", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "s"}], ")"}], " ", 
     RowBox[{"d\[Alpha]c", "[", "f", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]ad", "[", "f_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Alpha]c", " ", "f"}], "+", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "s"}], ")"}], " ", 
     RowBox[{"d\[Alpha]", "[", "f", "]"}]}]}]}], ";"}]}], "Input",
 CellLabel->"In[91]:=",
 CellID->176560768,ExpressionUUID->"9e7ab45e-d848-da49-bc37-410111fe834a"],

Cell["Basic definitions:", "Text",
 CellID->80534119,ExpressionUUID->"77ef9c0d-115e-bd49-95dc-b55bd9d35de4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "8", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"a", ":=", 
  RowBox[{"AnnihilationOperator", "[", "]"}]}]}], "Input",
 CellLabel->"In[7]:=",
 CellID->511930476,ExpressionUUID->"d6e26f5c-8c0a-f041-a009-a9f328602990"],

Cell[TextData[{
 "Define a random density operator whose elements only fill up to ",
 StyleBox["$FockSize/2 , ", "FormattedFunction"],
 "so all operator applications are determined exactly for the given cutoff:"
}], "Text",
 CellID->73740783,ExpressionUUID->"6c599940-9181-0045-affa-0a0f47a2bbd8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{
       RowBox[{"RandomComplex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "1"}], "-", "\[ImaginaryI]"}], ",", 
           RowBox[{"1", "+", "\[ImaginaryI]"}]}], "}"}], ",", 
         RowBox[{"$FockSize", "/", "2"}]}], "]"}], ",", "$FockSize"}], "]"}], 
     "[", "\"\<Normalize\>\"", "]"}], "[", "\"\<Operator\>\"", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[9]:=",
 CellID->511079924,ExpressionUUID->"1f51386a-ea73-f64b-9793-d154ec3dcc9d"],

