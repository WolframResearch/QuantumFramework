Cell[BoxData[
 RowBox[{"QuantumSimilarity", "[", 
  RowBox[{
   RowBox[{"\[Rho]t", "[", "10", "]"}], ",", 
   RowBox[{"FockState", "[", "0", "]"}]}], "]"}]], "Input",
 CellLabel->"In[270]:=",
 CellID->126561825,ExpressionUUID->"dc0e66c5-bb38-b640-9ff9-d57da5655e0a"],

Cell[BoxData["0.9997533848942235`"], "Output",
