Cell[TextData[{
 "For strong coupling there are two peaks at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "=", 
    RowBox[{"\[PlusMinus]", "g"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6a611c14-6ffb-4440-a41e-5e4b08364e9d"],
 ".  This vacuum Rabi splitting is is the standard proof that an experiment \
has reached strong coupling. The peaks reach ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"\[Kappa]", "/", 
      RowBox[{"(", 
       RowBox[{"\[Kappa]", "+", "\[Gamma]"}], ")"}]}], ")"}], "2"], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "daf179b1-6a1b-5345-beb5-2211dd7e9a46"],
 " and not 1 because  the atom\[CloseCurlyQuote]s own decay steals light from \
the cavity mode"
}], "Text",
 CellID->69512815,ExpressionUUID->"a6fa9bcb-de00-0b43-a1ac-d49e214d8588"],

Cell["Verification of the maximum:", "Text",
 CellID->76104376,ExpressionUUID->"1006dc24-e33a-5f4c-ab2a-44b91749ccdc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Kappa]", "=", "0.4"}], ",", 
     RowBox[{"\[Gamma]", "=", "0.1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"NMaximize", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"transmission", "[", 
          RowBox[{
           RowBox[{"gc", " ", "s"}], ",", " ", "\[Kappa]", ",", " ", 
           "\[Gamma]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"-", "3"}], "<", "s", "<", "3"}]}], "}"}], ",", "s"}], 
      "]"}], ",", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[Kappa]", "/", 
        RowBox[{"(", 
         RowBox[{"\[Kappa]", "+", "\[Gamma]"}], ")"}]}], ")"}], "2"]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[81]:=",
 CellID->245453699,ExpressionUUID->"982558f3-1bb0-c348-9b3f-71e041387c99"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.641584218932561`", ",", 
     RowBox[{"{", 
      RowBox[{"s", "\[Rule]", "1.004949172128797`"}], "}"}]}], "}"}], ",", 
   "0.6400000000000001`"}], "}"}]], "Output",
 CellLabel->"Out[81]=",
 CellID->827895108,ExpressionUUID->"27b180d7-4a18-9d4f-b3b8-a091c2784a9b"]
}, Open  ]],

Cell[TextData[{
 "For Purcell regime the cavity\[CloseCurlyQuote]s broad resonance has a deep \
narrow hole at \n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "35274d2f-e00a-dc49-8eaf-12a7f03ad15a"],
 ". The hole is the atom, it scatters the light out of the cavity mode, and \
its width is the Purcell-broadened atomic linewidth \[TildeTilde] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "+", 
    RowBox[{"4", 
     RowBox[{
      SuperscriptBox["g", "2"], "/", "\[Kappa]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fdab6e58-4f12-794d-a10c-02c6e269b856"],
 " when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", ">>", "\[Gamma]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3a4c40f0-162c-1047-b623-e458dd2487fc"]
}], "Text",
 CellID->3774820,ExpressionUUID->"71a65578-5ad9-3046-9e07-f78da03e0dee"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dipWidth", "[", "\[Kappa]v_", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t0", "=", 
       RowBox[{"transmission", "[", 
        RowBox[{"0", ",", "\[Kappa]v", ",", "0.1"}], "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"2", " ", "\[Delta]"}], "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"transmission", "[", 
          RowBox[{"\[Delta]", ",", "\[Kappa]v", ",", "0.1"}], "]"}], "==", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "t0"}], ")"}], "/", "2"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Delta]", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"0.1", "+", 
             RowBox[{"4", " ", 
              RowBox[{
               RowBox[{"gc", "^", "2"}], "/", "\[Kappa]v"}]}]}], ")"}], "/", 
           "2"}]}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"LogLinearPlot", "[", 
    RowBox[{
     RowBox[{"0.1", "+", 
      RowBox[{"4", " ", 
       RowBox[{
        RowBox[{"gc", "^", "2"}], "/", "\[Kappa]v"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Kappa]v", ",", "5", ",", "250"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Black"}]}], "]"}], ",", 
   RowBox[{"ListLogLinearPlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Kappa]v", ",", 
         RowBox[{"dipWidth", "[", "\[Kappa]v", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Kappa]v", ",", 
         RowBox[{"{", 
          RowBox[{"6", ",", "12", ",", "20", ",", "60", ",", "200"}], "}"}]}],
         "}"}]}], "]"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Red", ",", 
        RowBox[{"PointSize", "[", "0.02", "]"}]}], "]"}]}]}], "]"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"Axes", "->", "False"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Kappa]/g\>\"", ",", "\"\<dip width\>\""}], "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "400"}], ",", 
   RowBox[{"Epilog", "->", 
    RowBox[{"Inset", "[", 
     RowBox[{
      RowBox[{"LineLegend", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Black", ",", "Red"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Gamma] + 4g\.b2/\[Kappa]\>\"", 
          ",", "\"\<measured full width at half depth\>\""}], "}"}]}], "]"}], 
      ",", 
      RowBox[{"Scaled", "[", 
       RowBox[{"{", 
        RowBox[{"0.62", ",", "0.82"}], "}"}], "]"}]}], "]"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[82]:=",
 CellID->98493098,ExpressionUUID->"2a925142-da4d-9545-99c4-27f7d32e2967"],

