Cell["\<\
We see there is  point where the fidelity starts to decrease signaling the \
approximation starts to differ with the exact result\
\>", "Text",
 CellID->302431365,ExpressionUUID->"bb57bf33-a41d-2242-9e80-b45695b77ddc"],

Cell["Compute the time where the fidelity goes below 0.99:", "Text",
 CellID->209689059,ExpressionUUID->"1c768387-32c9-bd4c-bedd-3a7031588e3a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tOnset", " ", "=", " ", 
  RowBox[{"Extract", "[", 
   RowBox[{"time", ",", 
    RowBox[{"FirstPosition", "[", 
     RowBox[{"qs", ",", 
      RowBox[{"x_", "/;", 
       RowBox[{"x", "<", "0.99"}]}]}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[315]:=",
 CellID->105951617,ExpressionUUID->"cba75371-a515-134e-8c4f-c74711a1238f"],

Cell[BoxData["0.62`"], "Output",
 CellLabel->"Out[315]=",
 CellID->152370837,ExpressionUUID->"63dbbdc4-80d5-954b-a6f0-9732af8086ed"]
}, Open  ]],

Cell["\<\
At the calculated time we can propose it is a numerical estimator to indicate \
when the approximation is starting to difer\
\>", "Text",
 CellID->320409103,ExpressionUUID->"c8e96f01-b894-6b45-aeb0-79a402c4b5a0"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["8.4 Thermalization master equation", "Subsection"]], \
"Subsection",
 CellID->117309990,ExpressionUUID->"aa54fc46-64db-7644-b7d5-1e207970f16d"],

Cell[TextData[{
 "A thermalization master equation in quantum optics describes how a system \
(e.g., a qubit or harmonic oscillator) drives towards a thermal Gibbs state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", "th"], "=", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[Beta]"}], " ", "H"}]], "/", "Z"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fa48eb4a-498b-4a42-b4d5-50b203078de7"],
 " via interaction with a reservoir. Under Born-Markov and rotating-wave \
approximations, this typically yields a Lindblad master equation with damping \
and excitation rates satisfying local detailed balance"
}], "Text",
 CellID->19334130,ExpressionUUID->"a67ce069-a41a-b345-9d55-bce0c6bfff95"],

Cell["Master equation:", "Text",
 CellChangeTimes->{{3.9542419806865044`*^9, 3.954242009880934*^9}},
 CellID->245537579,ExpressionUUID->"231e83fe-e3e7-0648-90cc-2ba4d49cefa3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"d", "\[Rho]"}], 
    RowBox[{"d", "t"}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], "[", 
     RowBox[{"H", ",", "\[Rho]"}], "]"}], "+", 
    RowBox[{
    Cell["\[Kappa]",ExpressionUUID->"755ca186-df71-ec40-af7e-105bf2c65407"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["n", "th"], "+", "1"}], ")"}], 
     RowBox[{"\[ScriptCapitalD]", "[", 
      OverscriptBox["a", "^"], "]"}], "\[Rho]"}], "+", 
    RowBox[{"\[Kappa]", " ", 
     SubscriptBox["n", "th"], " ", 
     RowBox[{"\[ScriptCapitalD]", "[", 
      SuperscriptBox[
       OverscriptBox["a", "^"], "\[Dagger]"], "]"}], "\[Rho]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->14792433,ExpressionUUID->"86186718-6536-8844-9103-bce559843c6b"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "th"], TraditionalForm]],ExpressionUUID->
  "5e075be8-16e9-7746-afbe-c3ced850e359"],
 " is the thermal photon number that is dependent on temperature and \
frequency of the cavity, and ",
 Cell[BoxData[
  FormBox["\[Kappa]", TraditionalForm]],ExpressionUUID->
  "fc467473-ebe0-a549-903d-f1a7b7c6adb8"],
 " is the decay photon rate. We now include both ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8b9f4d37-a06c-ed4f-90c5-b256d70ce5f5"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "\[Dagger]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8e9e807f-fadc-404f-826e-8ec2ac93ae28"],
 " as Lindblad jump operators(photon loss and photon injection channels)"
}], "Text",
 CellID->20213119,ExpressionUUID->"c21857c4-b28a-6245-b851-c4b1fe83e27f"],

Cell[TextData[StyleBox["Set up truncation size:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681789563583145`*^9, 3.9681789608401737`*^9}},
 CellID->376131594,ExpressionUUID->"4ffe2511-2834-294f-863f-3cb284e8e792"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "25", "]"}], ";"}]], "Input",
 CellLabel->"In[316]:=",
 CellID->221286733,ExpressionUUID->"1c384c22-12e4-244f-9b90-201d659c0117"],

Cell[TextData[StyleBox["Final evolution time:", "Text"]], "CodeText",
 CellChangeTimes->{{3.968178970133093*^9, 3.968178972645378*^9}, {
  3.972733787704056*^9, 3.9727337889255276`*^9}},
 CellID->78439035,ExpressionUUID->"4ed4ed31-bc16-8645-b0bc-999a344ffe8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tf", " ", "=", " ", "10."}], ";"}]], "Input",
 CellLabel->"In[317]:=",
 CellID->830641661,ExpressionUUID->"2f1a02e8-8e97-5b45-860c-d8514be65200"],

Cell[TextData[{
 "Setting the master equation (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["H", "^"], "=", 
    RowBox[{"\[HBar]", " ", "\[Omega]", " ", 
     SuperscriptBox["a", "\[Dagger]"], "a"}]}], TraditionalForm]],
  ExpressionUUID->"de122dfb-9808-c544-935a-878c14db6a09"],
 ") with the relevant jump operators:"
}], "Text",
 CellChangeTimes->{{3.9542420792819557`*^9, 3.954242119109745*^9}, {
  3.968179787027731*^9, 3.968179791448162*^9}, {3.9727338064511414`*^9, 
  3.972733834981489*^9}},
 CellID->431192140,ExpressionUUID->"33871b5c-13fb-7648-9170-9693386de914"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalL]", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{"\"\<Liouvillian\>\"", "[", " ", 
      RowBox[{
       RowBox[{"\[FormalOmega]", " ", 
        RowBox[{
         SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", 
         SuperscriptBox["a", "\[Dagger]"]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Kappa]", 
          RowBox[{"(", 
           RowBox[{"nth", "+", "1"}], ")"}]}], ",", 
         RowBox[{"\[Kappa]", " ", "nth"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\[FormalOmega]", ",", "\[Kappa]", ",", "nth"}], "}"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9681789500750313`*^9, 3.968178975285553*^9}},
 CellLabel->"In[318]:=",
 CellID->399311451,ExpressionUUID->"a8b905ee-9b7e-7446-a3c7-b23957a65aef"],

Cell[TextData[{
 StyleBox["Pick some parameters, for example ", "Text"],
 StyleBox[Cell[BoxData[
  FormBox[
   SubscriptBox["n", "th"], TraditionalForm]], "Text",ExpressionUUID->
  "76365a76-0021-944a-a56a-85caf9243a1f"], "Text"],
 StyleBox[" = 3, \[Omega] = 1, \[Kappa] = 0.6 :", "Text"]
}], "CodeText",
 CellChangeTimes->{{3.968179078172716*^9, 3.9681791344611454`*^9}, {
  3.968179803390791*^9, 3.9681798346482487`*^9}},
 CellID->131753310,ExpressionUUID->"2a4fa084-29f2-594b-8acf-e57a513355ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lindbladian", "=", 
   RowBox[{"\[ScriptCapitalL]", "[", 
    RowBox[{"1", ",", "0.6", ",", "3"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[323]:=",
 CellID->6823606,ExpressionUUID->"f7ec561d-b875-5740-a1ea-868c594f74e8"],

Cell[TextData[StyleBox["Calculating mean number of photons for different \
initial Fock states:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9542421607666664`*^9, 3.954242177187752*^9}, {
  3.9681791822642956`*^9, 3.968179186608959*^9}},
 CellID->254318098,ExpressionUUID->"39a50caf-84bb-4e44-91a8-30449618a9b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"meanPhotons", " ", "=", "\[IndentingNewLine]", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Rho]t", " ", "=", " ", 
       RowBox[{"QuantumEvolve", "[", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "lindbladian"}], " ", ",", 
         RowBox[{"FockState", "[", "i", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tf"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"Dot", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", 
              RowBox[{"$FockSize", "-", "1"}]}], "]"}], ",", 
            RowBox[{"Diagonal", "[", 
             RowBox[{
              RowBox[{"\[Rho]t", "[", "t", "]"}], "[", "\"\<DensityMatrix\>\"",
               "]"}], "]"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "tf", ",", "0.01"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "4"}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[324]:=",
 CellID->79855378,ExpressionUUID->"160ebcbc-c660-5f4b-a204-afdcd1b344fb"],

Cell[TextData[{
 StyleBox["Plot mean number of photons curves for the Fock states, see the \
convergence towards ", "Text"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "th"], TraditionalForm]],ExpressionUUID->
  "96e55149-ebfd-e34f-ae18-8416d7aa7c67"],
 StyleBox[":", "Text"]
}], "Text",
 CellID->71122240,ExpressionUUID->"fcb98543-94ee-a342-986c-ac2c4c0061ee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"meanPhotons", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["5", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["1160", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[PlotRange -> {0, 6}, Epilog -> {
       Style[
        Line[{{0, 3}, {10, 3}}], Dashed, Red]}, 
     PlotLegends -> {
      "|0\[RightAngleBracket]", "|1\[RightAngleBracket]", 
       "|4\[RightAngleBracket]"}, 
     AxesLabel -> {"Time (a.u)", "Number of photons"}, LabelStyle -> 13],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellChangeTimes->{{3.968179525020956*^9, 3.9681795390158176`*^9}, 
   3.968179729627331*^9},
 CellLabel->"In[325]:=",
 CellID->106235101,ExpressionUUID->"7886950f-48eb-6c49-a04e-7ac1908d5ec9"],

