Cell[CellGroupData[{

Cell["Vacuum Rabi splitting: transmission spectrum", "Subsubsection",
 CellID->200955061,ExpressionUUID->"9c8d9394-bedb-ca4f-9cee-2d64a41d12bb"],

Cell[TextData[{
 "What an experiment usually measures is not ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "e"], "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "a95909e7-a677-bf4d-a3fb-e35c7810ad08"],
 " but a spectrum. Drive the cavity weakly with a laser of frequency ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "L"], " "}], TraditionalForm]],ExpressionUUID->
  "960d6ba0-bedd-714e-92ff-3e5539db45ce"],
 "and strength \[Eta], and record how many photons build up inside or the \
light leaks out through the mirror as a function of the detuning ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", "=", " ", 
    RowBox[{"\[Nu]", "-", 
     SubscriptBox["\[Omega]", "L"]}]}], TraditionalForm]],ExpressionUUID->
  "a7326c59-f871-c546-bb63-bb4cec2b9761"],
 ". Going to the rotating frame subtracts ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "L"], "(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["a", "\[Dagger]"], "a"}], "+", 
     RowBox[{
      SubscriptBox["\[Sigma]", "z"], "/", "2"}]}], ")"}], TraditionalForm]],
  ExpressionUUID->"bcfab0c6-17a3-a24e-8592-8e1a29e3b461"],
 " from ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],ExpressionUUID->
  "8e165f62-c4c8-ac4d-9a28-5d37bafc0143"],
 " and also the drive term becomes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Eta]", "(", 
    RowBox[{"a", "+", 
     SuperscriptBox["a", "\[Dagger]"]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9b56eb5c-ae9e-4b48-8a21-50f71d138e9c"],
 " "
}], "Text",
 CellID->563560834,ExpressionUUID->"7ef03a28-6d1f-6e4e-b99b-95f9106f14b2"],

Cell["Set up the weak laser strength:", "Text",
 CellID->95112547,ExpressionUUID->"45b8e9b9-81a8-f54f-964c-47c7031c6b1d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Eta]d", "=", "0.005"}], ";"}]], "Input",
 CellLabel->"In[54]:=",
 CellID->519663478,ExpressionUUID->"f809e7b8-f3ee-8b4d-b00c-c23e235a64fc"],

Cell["Define the Hamiltonian:", "Text",
 CellID->120574798,ExpressionUUID->"3a731f7f-b1e6-1743-8cb7-e9b9c4591861"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Hdrive", "[", "\[CapitalDelta]_", "]"}], ":=", 
   RowBox[{"H", "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Nu]", "-", "\[CapitalDelta]"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["a", "\[Dagger]"], "@", "a"}], "+", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<Z\>\"", ",", "atomBasis"}], "]"}]}]}], ")"}]}], "+", 
    RowBox[{"\[Eta]d", " ", 
     RowBox[{"(", 
      RowBox[{"a", "+", 
       SuperscriptBox["a", "\[Dagger]"]}], ")"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[55]:=",
 CellID->411681779,ExpressionUUID->"e89b7462-1a4f-8547-9972-c285ea6a1c7c"],

Cell[TextData[{
 "The steady state is the density matrix that the Lindblad generator ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalL]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "856480cc-8e88-414c-a789-9ab9d7f3bc0d"],
 " sends to zero, \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ScriptCapitalL]", " ", 
     SubscriptBox["\[Rho]", "ss"]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "134437f4-d9b4-a94e-b4eb-2a2d7f8dc83b"],
 ". And we consider one more observation \[CapitalDelta] enters ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "drive"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "65bd7085-ee46-ed41-848a-6a22272145a1"],
 " linearly and the losses do not depend on it, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ScriptCapitalL]", "(", "\[CapitalDelta]", ")"}], "=", 
    RowBox[{
     SubscriptBox["\[ScriptCapitalL]", "0"], "+", 
     RowBox[{"\[CapitalDelta]", " ", 
      SubscriptBox["\[ScriptCapitalL]", "1"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "80d2e1d1-6853-ec41-8aed-22395773ce7d"],
 ". Two super-operator instances per set of rates are enough, hence every \
detuning is then obtained with a linear-algebra solve"
}], "Text",
 CellID->508891224,ExpressionUUID->"94d68a9b-cba6-5a49-827e-60a70cbdb86c"],

Cell["Steady state calculation:", "Text",
 CellID->358444,ExpressionUUID->"3d697b7c-3b8c-9f41-9f0e-9de4eb0f7e50"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"liouvillianParts", "[", 
    RowBox[{"\[Kappa]_", ",", "\[Gamma]_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l0", "=", 
       RowBox[{
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<Liouvillian\>\"", "[", 
          RowBox[{
           RowBox[{"Hdrive", "[", "0", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Sigma]minus", ",", "a"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Gamma]", ",", "\[Kappa]"}], "}"}]}], "]"}], "]"}], 
        "[", "\"\<Matrix\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l0", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<Liouvillian\>\"", "[", 
           RowBox[{
            RowBox[{"Hdrive", "[", "1", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Sigma]minus", ",", "a"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Gamma]", ",", "\[Kappa]"}], "}"}]}], "]"}], "]"}], 
         "[", "\"\<Matrix\>\"", "]"}], "-", "l0"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[56]:=",
 CellID->127800840,ExpressionUUID->"68cf814d-133a-c940-a440-d80a2815beee"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"steadyState", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l0_", ",", "l1_"}], "}"}], ",", "\[CapitalDelta]_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Rho]", "=", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"First", "[", 
          RowBox[{"NullSpace", "[", 
           RowBox[{"N", "[", 
            RowBox[{"l0", "+", 
             RowBox[{"\[CapitalDelta]", " ", "l1"}]}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", " ", "$FockSize"}], ",", 
           RowBox[{"2", " ", "$FockSize"}]}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"QuantumState", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "/", 
        RowBox[{"Tr", "[", "\[Rho]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "$FockSize"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[57]:=",
 CellID->238368586,ExpressionUUID->"fb43093e-9664-954d-b0f5-ac0dbfae745f"],

Cell[TextData[{
 "By input\[Dash]output theory (a topic that is not covered), the outgoing \
field is proportional to the field inside, so the transmitted power is \
proportional to \n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", " ", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SuperscriptBox["a", "\[Dagger]"], "a"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fa010c03-15a1-8a46-af7b-d575ba1366ee"],
 "\[RightAngleBracket]. To normalize it  we divide by the same quantity for \
an empty cavity driven exactly on resonance. Without the atom, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[DifferentialD]", 
      RowBox[{"\[LeftAngleBracket]", "a", "\[RightAngleBracket]"}]}], 
     RowBox[{"\[DifferentialD]", "t"}]], " ", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["\[Kappa]", "2"]}], 
      RowBox[{"\[LeftAngleBracket]", "a", "\[RightAngleBracket]"}]}], "-", 
     RowBox[{"\[ImaginaryI]", " ", "\[Eta]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eaf9b79a-a442-314e-9c13-3efd38d7fcc8"],
 " whose steady state is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", "a", "\[RightAngleBracket]"}], "=", 
    RowBox[{
     RowBox[{"-", "2"}], "\[ImaginaryI]", " ", 
     RowBox[{"\[Eta]", "/", "\[Kappa]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "593ad309-30bf-054d-bcbd-6c4e926d2eb9"],
 " so \[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{
      RowBox[{
       SuperscriptBox["a", "\[Dagger]"], "a"}], "\[RightAngleBracket]"}], 
     "empty"], "=", 
    FractionBox[
     RowBox[{"4", " ", 
      SuperscriptBox["\[Eta]", "2"]}], 
     SuperscriptBox["\[Kappa]", "2"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6518b31e-5b2b-0f4a-973f-ded9e73cab79"],
 " \[Rule] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", " ", "=", 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[Kappa]", "2"], 
      RowBox[{"4", " ", 
       SuperscriptBox["\[Eta]", "2"]}]], 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SuperscriptBox["a", "\[Dagger]"], "a"}], "\[RightAngleBracket]"}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "af88a9c2-c4f3-3642-89a8-fbbaaccc1e43"]
}], "Text",
 CellID->55239738,ExpressionUUID->"70867b7b-98c4-df40-9218-53155534f92b"],

Cell["Transmission obtained from the steady state:", "Text",
 CellID->52423506,ExpressionUUID->"180c317c-d162-8b49-9ec1-4ed53aff73eb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"transmissionQF", "[", 
    RowBox[{"parts_", ",", "\[CapitalDelta]_", ",", "\[Kappa]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[Kappa]", "2"], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumMeasurementOperator", "[", 
         RowBox[{
          SuperscriptBox["a", "\[Dagger]"], "@", "a"}], "]"}], "[", 
        RowBox[{"steadyState", "[", 
         RowBox[{"parts", ",", "\[CapitalDelta]"}], "]"}], "]"}], 
       "[", "\"\<Mean\>\"", "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"4", " ", 
      SuperscriptBox["\[Eta]d", "2"]}], ")"}]}]}], ";"}]], "Input",
 CellLabel->"In[58]:=",
 CellID->953199300,ExpressionUUID->"8c2f0742-db16-3348-9c62-076973d42e7f"],

Cell[TextData[{
 "For weak driving the atom stays close to its ground state, \
\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "437dc3e8-12d8-1947-87d1-d654b9ff1091"],
 "\[RightAngleBracket] and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    SubscriptBox["\[Sigma]", "-"], "\[RightAngleBracket]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8a6c003a-1627-bf4f-884b-9e37652ce846"],
 " obey two linear equations in steady state:"
}], "Text",
 CellID->57501580,ExpressionUUID->"b8c28cde-08fd-f944-ae81-77d7a5fb4b72"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"0", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "\[CapitalDelta]"}], "+", 
         FractionBox["\[Kappa]", "2"]}], ")"}]}], 
      RowBox[{"\[LeftAngleBracket]", "a", "\[RightAngleBracket]"}]}], "-", 
     RowBox[{"\[ImaginaryI]", " ", "g", " ", 
      RowBox[{"\[LeftAngleBracket]", 
       SubscriptBox["\[Sigma]", "-"], "\[RightAngleBracket]"}]}]}]}], ",", 
   "   ", 
   RowBox[{"0", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "\[CapitalDelta]"}], " ", "+", " ", 
         FractionBox["\[Gamma]", "2"]}], ")"}]}], 
      RowBox[{"\[LeftAngleBracket]", 
       SubscriptBox["\[Sigma]", "-"], "\[RightAngleBracket]"}]}], "-", 
     RowBox[{"\[ImaginaryI]", " ", "g", " ", 
      RowBox[{"\[LeftAngleBracket]", "a", "\[RightAngleBracket]"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->502734820,ExpressionUUID->"922d1b13-1dd7-9d4f-a851-a0b9baef53b1"],

Cell["Alternative method for weak driving:", "Text",
 CellID->502489659,ExpressionUUID->"0cc32ccd-260c-0146-86df-2c76685910b5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"cavityAmplitude", "=", 
   RowBox[{"cav", "/.", "\[VeryThinSpace]", 
    RowBox[{"First", "[", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", "\[Equal]", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[ImaginaryI]", " ", "\[CapitalDelta]"}], "+", 
               FractionBox["\[Kappa]", "2"]}], ")"}]}], " ", "cav"}], "-", 
           RowBox[{"\[ImaginaryI]", " ", "gc", " ", "atm"}], "-", 
           RowBox[{"\[ImaginaryI]", " ", "\[Eta]d"}]}]}], ",", 
         RowBox[{"0", "\[Equal]", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[ImaginaryI]", " ", "\[CapitalDelta]"}], "+", 
               FractionBox["\[Gamma]", "2"]}], ")"}]}], " ", "atm"}], "-", 
           RowBox[{"\[ImaginaryI]", " ", "gc", " ", "cav"}]}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"cav", ",", "atm"}], "}"}]}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"transmission", "[", 
    RowBox[{"\[CapitalDelta]v_", ",", "\[Kappa]v_", ",", "\[Gamma]v_"}], 
    "]"}], "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Kappa]", "2"], " ", 
       SuperscriptBox[
        RowBox[{"Abs", "[", "cavityAmplitude", "]"}], "2"]}], 
      RowBox[{"4", " ", 
       SuperscriptBox["\[Eta]d", "2"]}]], "/.", "\[VeryThinSpace]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", "\[Rule]", "\[CapitalDelta]v"}], ",", 
       RowBox[{"\[Kappa]", "\[Rule]", "\[Kappa]v"}], ",", 
       RowBox[{"\[Gamma]", "\[Rule]", "\[Gamma]v"}]}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[59]:=",
 CellID->369947722,ExpressionUUID->"3f275897-90aa-7041-9888-4878f56a9c2d"],

Cell["Plotting panel as function of \[Kappa] assuming a fixed \[Gamma] :", \
"Text",
 CellID->741449147,ExpressionUUID->"b2a5e72c-0989-384f-92d2-ac344fcde287"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"spectrumPanel", "[", 
    RowBox[{"\[Kappa]v_", ",", "label_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"parts", "=", 
       RowBox[{"liouvillianParts", "[", 
        RowBox[{"\[Kappa]v", ",", "0.1"}], "]"}]}], "}"}], ",", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"transmission", "[", 
          RowBox[{
           RowBox[{"gc", " ", "s"}], ",", "\[Kappa]v", ",", "0.1"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", 
           RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
         InterpretationBox[
          DynamicModuleBox[{Typeset`open = False}, 
           TemplateBox[{"Expression", "SequenceIcon", 
             GridBox[{{
                RowBox[{
                  TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                  TagBox["Sequence", "IconizedItem"]}]}, {
                RowBox[{
                  TagBox["\"Length: \"", "IconizedLabel"], 
                  "\[InvisibleSpace]", 
                  TagBox["2", "IconizedItem"]}]}, {
                RowBox[{
                  TagBox["\"Byte count: \"", "IconizedLabel"], 
                  "\[InvisibleSpace]", 
                  TagBox["256", "IconizedItem"]}]}}, 
              GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
              "Column", 
              GridBoxItemSize -> {
               "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
             Dynamic[Typeset`open]},
            "IconizedObject"]],
          Sequence[PlotRange -> {0, 1.05}, PlotStyle -> Black],
          SelectWithContents->True,
          Selectable->False]}], "]"}], ",", 
       InterpretationBox[
        DynamicModuleBox[{Typeset`open = False}, 
         TemplateBox[{"Expression", "SequenceIcon", 
           GridBox[{{
              RowBox[{
                TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                TagBox["Sequence", "IconizedItem"]}]}, {
              RowBox[{
                TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                TagBox["6", "IconizedItem"]}]}, {
              RowBox[{
                TagBox["\"Byte count: \"", "IconizedLabel"], 
                "\[InvisibleSpace]", 
                TagBox["1096", "IconizedItem"]}]}}, 
            GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
            "Column", 
            GridBoxItemSize -> {
             "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
           Dynamic[Typeset`open]},
          "IconizedObject"]],
        Sequence[
         ListPlot[
          Table[{$CellContext`s, 
            $CellContext`transmissionQF[$CellContext`parts, $CellContext`gc \
$CellContext`s, $CellContext`\[Kappa]v]}, {$CellContext`s, -3, 3, 0.5}], 
          PlotStyle -> Directive[Red, 
            PointSize[0.02]]], Frame -> True, Axes -> False, 
         FrameLabel -> {"\[CapitalDelta]/g", "transmission"}, 
         PlotLabel -> $CellContext`label, ImageSize -> 330],
        SelectWithContents->True,
        Selectable->False]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[61]:=",
 CellID->46989844,ExpressionUUID->"a5521d0b-f653-034d-a394-7cdd4db4dcce"],

Cell["Visualize the transmission spectra:", "Text",
 CellID->306311318,ExpressionUUID->"0f8be40d-a96d-c241-a3eb-166da3c40c32"],

Cell[CellGroupData[{

