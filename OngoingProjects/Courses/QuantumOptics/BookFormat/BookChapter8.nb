Cell[TextData[{
 "|\[Alpha]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["|", "2"], TraditionalForm]],ExpressionUUID->
  "980dd937-75a6-b54a-bf44-1b97c3922463"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[Gamma]"}], " ", "t"}]], TraditionalForm]],ExpressionUUID->
  "ceea8099-b9b3-5444-a6c3-4c5cb3653eec"],
 " is the functional form of the mean photon number curve. Then the decay \
time of the field energy is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "decay"], "=", 
    RowBox[{"1", "/", "\[Gamma]"}]}], TraditionalForm]], "DisplayFormula",
  CellChangeTimes->{3.985950092838423*^9, 3.985950156251272*^9},
  ExpressionUUID->"324cac4c-b071-b64b-b9e8-d284c69b4c2f"]
}], "Text",
 CellID->359330677,ExpressionUUID->"25dd7134-bc4b-5245-a27e-94ad99e1211c"],

Cell[TextData[StyleBox["Do an exponential decaying fit:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681764567533283`*^9, 3.968176465694906*^9}},
 CellID->10367851,ExpressionUUID->"3e528bb9-0c42-a047-af83-d2666c420098"],

Cell[BoxData[
 RowBox[{
  RowBox[{"nlm", " ", "=", 
   RowBox[{"NonlinearModelFit", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{"time", ",", "meanN"}], "}"}], "]"}], ",", 
     RowBox[{"k", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "g"}], " ", "t"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "g"}], "}"}], ",", 
     RowBox[{"{", "t", "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.927217002480791*^9, 3.927217010214598*^9}, {
   3.927217051973039*^9, 3.927217143051523*^9}, {3.932644035009336*^9, 
   3.932644035885273*^9}, {3.932644125222688*^9, 3.932644131600366*^9}, {
   3.9350574022073784`*^9, 3.935057402965723*^9}, {3.9350583415941143`*^9, 
   3.935058343317936*^9}, 3.9542370716675415`*^9, 3.9727289996895714`*^9},
 CellLabel->"In[246]:=",
 CellID->385017647,ExpressionUUID->"7a1cc828-2149-4d46-9e4d-b562a01b3f77"],

