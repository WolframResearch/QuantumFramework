Cell[CellGroupData[{

Cell["8.5 Jaynes-Cummings with dissipation", "Subsection",
 CellID->278590745,ExpressionUUID->"446bd0be-7bbd-d647-b85c-74e82fbc4fd6"],

Cell["\<\
We revisit the Jaynes-Cummings model but now including jump operators related \
to energy dissipation. The proposed master equation is :\
\>", "Text",
 CellID->613129430,ExpressionUUID->"8ef53d81-f410-104c-8228-46b3ad4cb161"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["H", "^"], "=", 
   RowBox[{
    RowBox[{"\[HBar]", " ", "\[Nu]", " ", 
     SuperscriptBox[
      OverscriptBox["a", "^"], "\[Dagger]"], 
     OverscriptBox["a", "^"]}], "+", 
    RowBox[{
     FractionBox["1", "2"], "\[HBar]", " ", "\[Omega]", " ", 
     SubscriptBox["\[Sigma]", "z"]}], "+", 
    RowBox[{"\[HBar]", " ", "g", " ", "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Sigma]", "-"], " ", 
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"]}], "+", 
      RowBox[{
       SubscriptBox["\[Sigma]", "+"], " ", 
       OverscriptBox["a", "^"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.985950092846567*^9, 3.985950156255274*^9},
 CellID->44308642,ExpressionUUID->"dcb16c41-2c0b-ce46-82b0-b6ba3117ab9a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"d", " ", "\[Rho]"}], 
    RowBox[{"d", " ", "t"}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["\[ImaginaryI]", "\[HBar]"]}], 
     RowBox[{"[", 
      RowBox[{
       OverscriptBox["H", "^"], ",", "\[Rho]"}], "]"}]}], "+", 
    RowBox[{"\[ScriptCapitalD]", "[", 
     SubscriptBox["\[Sigma]", "-"], "]", "\[Rho]"}], "+", 
    RowBox[{"\[ScriptCapitalD]", "[", 
     OverscriptBox["a", "^"], "]", "\[Rho]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.9859500928488617`*^9, 3.985950156256275*^9},
 CellID->282608776,ExpressionUUID->"4be14e45-2c11-654e-b98c-e2265b0d8d88"],

Cell[TextData[{
 "The jump operators are  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "decay"], "=", 
    RowBox[{
     SqrtBox[
      SubscriptBox["\[Gamma]", "1"]], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Sigma]", "-"], " ", "\[CircleTimes]", " ", 
       "\[ScriptCapitalI]"}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "c7b2172c-4066-0c4b-96ae-dd7f3e2d0f85"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "loss"], " ", "=", " ", 
    RowBox[{
     SqrtBox[
      SubscriptBox["\[Gamma]", "2"]], 
     RowBox[{"(", 
      RowBox[{"\[ScriptCapitalI]", " ", "\[CircleTimes]", " ", "a"}], 
      ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "3b7550da-3679-ca4e-9d26-1549cedb112e"],
 " associated to dissipation rates ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "24aedb87-af92-5747-840b-9e7f72e0dd96"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "2"], TraditionalForm]],ExpressionUUID->
  "946b4db6-970a-a64a-aa26-ab90875abf4b"],
 " , the atom decaying or the field losing photons"
}], "Text",
 CellID->458483564,ExpressionUUID->"e0e6baec-9d26-5246-b87d-4e8fadc68036"],

Cell["Annihilation operator in the second qudit:", "Text",
 CellChangeTimes->{{3.9732614041853123`*^9, 3.97326141347122*^9}},
 CellID->635340703,ExpressionUUID->"88792dce-6f1e-0f4f-aa5a-7f52a8318e58"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", ":=", " ", 
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"{", "2", "}"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.973261416477993*^9, 3.9732614217798023`*^9}},
 CellLabel->"In[6]:=",
 CellID->674740542,ExpressionUUID->"2afc8eb3-ca94-9b4d-becc-2e2fb911a431"],

Cell["Atomic operators:", "Text",
 CellChangeTimes->{{3.9732614488653145`*^9, 3.973261451740011*^9}},
 CellID->207877727,ExpressionUUID->"6ede7498-29da-a745-b4b7-a08388246e2c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"atomBasis", " ", "=", " ", 
   RowBox[{"QuantumBasis", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<e\>\"", ",", "\"\<g\>\""}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]plus", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<+\>\"", ",", "atomBasis"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]minus", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<-\>\"", ",", "atomBasis"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.973261465569685*^9, 3.973261469184351*^9}, {
  3.9732615322887344`*^9, 3.9732615846792927`*^9}},
 CellLabel->"In[7]:=",
 CellID->601344993,ExpressionUUID->"5c1c7e3c-6939-db49-b986-a3d71397b3bf"],

Cell["\<\
Setting up parameters for field frequency, atomic frequency and interaction \
coupling, we consider a resonant case (\[Nu] = \[Omega])\
\>", "Text",
 CellChangeTimes->{{3.973261194821562*^9, 3.9732612515737095`*^9}, {
  3.9732682912627144`*^9, 3.973268308457878*^9}},
 CellID->46585975,ExpressionUUID->"e6e61a7e-28c5-b04c-80bf-e7e00b9a67b2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "12", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Nu]", " ", "=", " ", "10."}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"field", " ", "frequency"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]", " ", "=", " ", "10."}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"atomic", " ", "frequency"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gc", " ", "=", " ", "15."}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"interaction", " ", "coupling", " ", "strength"}], " ", 
   "*)"}]}]}], "Input",
 CellLabel->"In[36]:=",
 CellID->23924304,ExpressionUUID->"783b1be4-4fb9-db4d-90a8-2812395f7203"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s consider an initial state |",
 Cell[BoxData[
  FormBox["e", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f77a08ae-cfa2-6349-a0fe-fabbab11b610"],
 "\[RightAngleBracket] |",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9eb82a96-231e-4641-9057-95ffba6961a7"],
 "\[RightAngleBracket] with ",
