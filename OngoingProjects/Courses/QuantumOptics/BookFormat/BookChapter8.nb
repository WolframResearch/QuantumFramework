Cell[CellGroupData[{

Cell["Strong coupling, the crossover and the Purcell regime", "Subsubsection",
 CellID->828982573,ExpressionUUID->"2057fd93-d453-d64b-9030-c4fb6709a82c"],

Cell["Consider the state with one quantum of energy:", "Text",
 CellID->489911514,ExpressionUUID->"1ab795d2-9138-7245-9081-6181a918ed13"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Psi]e0", "=", 
  RowBox[{"QuantumTensorProduct", "[", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"\"\<0\>\"", ",", "atomBasis"}], "]"}], ",", 
    RowBox[{"FockState", "[", "0", "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[51]:=",
 CellID->328645208,ExpressionUUID->"74d0e250-58b2-b444-acbf-46bf91af34a6"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   TooltipBox[
    StyleBox[
     FormBox[
      InterpretationBox[
       StyleBox[
        TemplateBox[{
          RowBox[{
            FormBox["\"e\"", TraditionalForm], "\[InvisibleSpace]", 
            FormBox["0", TraditionalForm]}]},
         "Ket"],
        FontWeight->"Plain"],
       Wolfram`QuantumFramework`QuditName[{"e", 0}, "Dual" -> False]],
      TraditionalForm],
     ShowStringCharacters->False],
    TagBox[
     GridBox[{{
        RowBox[{"\"0\"", "\[CircleTimes]", 
          TemplateBox[{"0"}, "Ket"]}]}, {
        TemplateBox[{"\"QuantumState: \"", 
          RowBox[{
            RowBox[{"{", "}"}], "\[Rule]", 
            RowBox[{"{", 
              RowBox[{"2", ",", "12"}], "}"}]}]}, "RowDefault"]}}, 
      GridBoxAlignment -> {"Columns" -> {{Center}}}, DefaultBaseStyle -> 
      "Column", 
      GridBoxItemSize -> {
       "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"]],
   Wolfram`QuantumFramework`QuantumState[
   SparseArray[Automatic, {24}, 0, {1, {{0, 1}, {{1}}}, {1}}], 
    Wolfram`QuantumFramework`QuantumBasis[<|
     "Output" -> Wolfram`QuantumFramework`QuditBasis[<|{
           Wolfram`QuantumFramework`QuditName["e", "Dual" -> False], 1} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName["g", "Dual" -> False], 1} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {12}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {12}, 0, {1, {{0, 1}, {{2}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[2, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {12}, 0, {1, {{0, 1}, {{3}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[3, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {12}, 0, {1, {{0, 1}, {{4}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[4, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {12}, 0, {1, {{0, 1}, {{5}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[5, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {12}, 0, {1, {{0, 1}, {{6}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[6, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {12}, 0, {1, {{0, 1}, {{7}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[7, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {12}, 0, {1, {{0, 1}, {{8}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[8, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {12}, 0, {1, {{0, 1}, {{9}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[9, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {12}, 0, {1, {{0, 1}, {{10}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[10, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {12}, 0, {1, {{0, 1}, {{11}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[11, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {12}, 0, {1, {{0, 1}, {{12}}}, {1}}]|>], 
      "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
           
           Wolfram`QuantumFramework`QuditName[\[FormalCapitalI], "Dual" -> 
            False], 1} -> 1, {
           
           Wolfram`QuantumFramework`QuditName[\[FormalCapitalI], "Dual" -> 
            False], 2} -> 1|>], "Picture" -> "Schrodinger", "Label" -> 
      CircleTimes["0", 
        Ket[{0}]], "ParameterSpec" -> {}|>]]], TraditionalForm]], "Output",
 CellLabel->"Out[51]=",
 CellID->118562011,ExpressionUUID->"977619f6-ba8c-1f43-a7b3-3cd956ccbf45"]
}, Open  ]],

Cell[TextData[{
 "With one excitation the problem can be solved exactly. Only |",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"e", ",", "0"}], "\[RightAngleBracket]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "524b4247-fb48-6c42-b2a6-50650093ea42"],
 " and |",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e9deeca7-fbe2-2d41-88b1-fe8ec2856f4b"],
 ",1\:27e9 take part in the coherent exchange, and either loss sends the \
system to ",
 Cell[BoxData[
  FormBox["|", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f90db1fe-2dd7-424e-a7e7-314c1628db91"],
 Cell[BoxData[
  FormBox["g", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "00320846-5560-244f-8e66-128da76ebfa8"],
 ",0\:27e9 which never comes back. So ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "e"], "="}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2df91b6a-95fe-d146-af84-f6bff9529bca"],
 "|",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "e"], 
    SuperscriptBox[Cell[
     "|",ExpressionUUID->"469a64d8-e28a-8d44-bbb9-642762f0d0ff"], "2"]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e612dd97-fc7a-6c45-872c-f47aca93076e"],
 " where the amplitudes obey the \[OpenCurlyDoubleQuote]no-jump\
\[CloseCurlyDoubleQuote] equations:"
}], "Text",
 CellID->27827951,ExpressionUUID->"6e78b64f-ed74-ed41-9d25-fc5ed6559836"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{" ", 
      RowBox[{"\[DifferentialD]", 
       SubscriptBox["c", "e"]}]}], 
     RowBox[{"\[DifferentialD]", "t"}]], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["\[Gamma]", "2"]}], 
      SubscriptBox["c", "e"]}], "-", 
     RowBox[{"\[ImaginaryI]", " ", "g", " ", 
      SubscriptBox["c", "1"]}]}]}], "  ", ",", "   ", 
   RowBox[{
    FractionBox[
     RowBox[{" ", 
      RowBox[{"\[DifferentialD]", 
       SubscriptBox["c", "1"]}]}], 
     RowBox[{"\[DifferentialD]", "t"}]], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["\[Kappa]", "2"]}], 
      SubscriptBox["c", "1"]}], "-", 
     RowBox[{"\[ImaginaryI]", " ", "g", " ", 
      SubscriptBox["c", "e"]}]}]}]}], TraditionalForm]], "DisplayFormula",
 CellID->59411,ExpressionUUID->"d11fb2d5-cc43-ca45-a5ee-bdf05570b372"],

Cell[TextData[{
 "Define the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "92926109-c9f0-a848-8548-573d8f411e9c"],
 " matrix and calculate the eigenvalues:"
}], "Text",
 CellID->922839815,ExpressionUUID->"4d462fd5-1c0e-a14c-a1e5-52fda7dbf0cb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"noJump", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["\[Gamma]", "2"]}], ",", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "g"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "g"}], ",", 
       RowBox[{"-", 
        FractionBox["\[Kappa]", "2"]}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{"Eigenvalues", "[", "noJump", "]"}], "]"}]}], "Input",
 CellLabel->"In[27]:=",
 CellID->332432234,ExpressionUUID->"dc4a99a0-6938-c340-a6fb-90f52c80218c"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     FractionBox["1", "4"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "\[Gamma]"}], "-", 
       SqrtBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Gamma]", "-", "\[Kappa]"}], ")"}], "2"], "-", 
         RowBox[{"16", " ", 
          SuperscriptBox["g", "2"]}]}]], "-", "\[Kappa]"}], ")"}]}], ",", 
    RowBox[{
     FractionBox["1", "4"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "\[Gamma]"}], "+", 
       SqrtBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Gamma]", "-", "\[Kappa]"}], ")"}], "2"], "-", 
         RowBox[{"16", " ", 
          SuperscriptBox["g", "2"]}]}]], "-", "\[Kappa]"}], ")"}]}]}], "}"}], 
  TraditionalForm]], "Output",
 CellLabel->"Out[28]=",
 CellID->97402501,ExpressionUUID->"755f854a-a595-ee4c-af46-52b37d7c3a3c"]
}, Open  ]],

Cell["We can identify three regimes based on the eigenvalues", "Text",
 CellID->108887971,ExpressionUUID->"1bbceace-c70f-3240-a585-0d7d56befd1e"],

Cell[TextData[{
 StyleBox["Strong coupling  ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{"g", ">", 
    FractionBox[
     RowBox[{"|", 
      RowBox[{"\[Kappa]", "-", "\[Gamma]"}], "|"}], "4"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cbd9667f-ba25-c44b-8f97-dff2acd9131d"],
 " the square root is imaginary the excitation oscillates between atom and \
cavity the vacuum Rabi oscillation under a decaying envelope"
}], "Subsubitem",
 CellID->153881644,ExpressionUUID->"8e19e308-5c63-9848-ac73-9ee908642522"],

Cell[TextData[{
 StyleBox["The crossover  ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "=", 
    FractionBox[
     RowBox[{"|", 
      RowBox[{"\[Kappa]", "-", "\[Gamma]"}], "|"}], "4"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "384371d2-e9cb-5d4b-acae-96df1ea42648"],
 "  the two eigenvalues merge and the oscillation stops"
}], "Subsubitem",
 CellID->902523123,ExpressionUUID->"65102fe4-93b1-1947-acd6-a98c0f17eeef"],

Cell[TextData[{
 StyleBox["Purcell regime   ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", " ", ">>", " ", "g"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "079e8f39-f861-924e-b8e4-d5e3bd1c9222"],
 "  a photon leaves the cavity before it can be reabsorbed, so the atom \
simply decays  but in a faster manner the rate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", " ", 
    RowBox[{
     SuperscriptBox["g", "2"], "/", "\[Kappa]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4b43b3be-23a7-3d4d-b79a-ea8d035f8e47"],
 " is the Purcell enhancement"
}], "Subsubitem",
 CellID->528877812,ExpressionUUID->"ce8ac720-a3f1-4e4c-a031-65f5fd40035c"],

Cell[TextData[{
 "The solution is the matrix exponential of ",
 Cell[BoxData[
  FormBox["Mt", TraditionalForm]],ExpressionUUID->
  "07efdaa5-bff2-bf4b-8619-c29179095bf7"],
 " applied to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "0"}], ")"}], TraditionalForm]],ExpressionUUID->
  "a550f887-18bf-b748-ad25-0e2021eacdf5"],
 ", the excited atom:"
}], "Text",
 CellID->95757123,ExpressionUUID->"976a9ae5-7b12-7b40-bc9b-485e2338e953"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"peExact", "[", 
     RowBox[{"\[Kappa]v_", ",", "\[Gamma]v_"}], "]"}], "[", "\[Tau]_", "]"}], 
   ":=", 
   SuperscriptBox[
    RowBox[{"Abs", "[", 
     RowBox[{"First", "[", 
      RowBox[{
       RowBox[{"MatrixExp", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"noJump", "/.", "\[VeryThinSpace]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"g", "\[Rule]", "gc"}], ",", 
             RowBox[{"\[Kappa]", "\[Rule]", "\[Kappa]v"}], ",", 
             RowBox[{"\[Gamma]", "\[Rule]", "\[Gamma]v"}]}], "}"}]}], ")"}], " ",
          "\[Tau]"}], "]"}], ".", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "]"}], "]"}], "2"]}], 
  ";"}]], "Input",
 CellLabel->"In[29]:=",
 CellID->219396154,ExpressionUUID->"1b6f6f47-9a6a-8141-be9e-89a7b963ebc6"],

Cell[TextData[{
 "Change to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "fbd87455-758f-2b47-a22d-9e18f1145c5e"],
 ":"
}], "Text",
 CellID->17407610,ExpressionUUID->"967316f9-2768-c742-9ee4-6b27cb36afa3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gc", "=", "1."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", " ", "=", "  ", 
   RowBox[{
    RowBox[{"\[Nu]", " ", 
     RowBox[{
      SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], "+", " ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", "\[Omega]", " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Z\>\"", ",", "atomBasis"}], "]"}]}], "+", 
    RowBox[{"gc", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Sigma]plus", "@", "a"}], "+", 
       RowBox[{"\[Sigma]minus", "@", 
        SuperscriptBox["a", "\[Dagger]"]}]}], ")"}]}]}]}], ";"}]}], "Input",
 CellLabel->"In[52]:=",
 CellID->299556076,ExpressionUUID->"14651174-4592-d14e-97a4-797bad5c7403"],

Cell["Set up value of rates per regime:", "Text",
 CellID->66346871,ExpressionUUID->"49618f22-e874-4440-b1e0-c3ffd6779d9d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"regimes", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.4", ",", "0.1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4.1", ",", "0.1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"20.", ",", "0.1"}], "}"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[48]:=",
 CellID->12545245,ExpressionUUID->"c96854c2-4d00-924f-b2fa-09829447a98b"],

Cell["Compute the evolved states with the regime parameters:", "Text",
 CellID->524488456,ExpressionUUID->"d6fc7d2f-ca6e-7748-b020-64dff40f86b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evolutions", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"QuantumEvolve", "[", 
       RowBox[{
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<Hamiltonian\>\"", "[", 
          RowBox[{"H", ",", 
           RowBox[{"{", 
            RowBox[{"\[Sigma]minus", ",", "a"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
             "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
             RowBox[{
             "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
            "}"}]}], "]"}], "]"}], ",", "\[Psi]e0", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}], "&"}], ")"}], "/@",
     "regimes"}]}], ";"}]], "Input",
 CellLabel->"In[49]:=",
 CellID->37133551,ExpressionUUID->"cc08a6de-4fa7-604a-85df-ab255ce8e591"],

Cell[TextData[{
 "Show the three regimes, the dots come from the ",
 StyleBox["QuantumEvolve", "FormattedFunction"],
 " solution and the solid lines come from the exact result for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "e"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a286e150-dba6-3044-9973-2af95e0c143a"],
 ":"
}], "Text",
 CellID->165167918,ExpressionUUID->"75bf5dd9-20ed-3e4a-a820-643b56f0b574"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"regimeColours", "=", 
     RowBox[{"{", 
      RowBox[{"Blue", ",", 
       RowBox[{"Darker", "[", "Green", "]"}], ",", "Red"}], "}"}]}], "}"}], ",", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"peExact", "[", 
             RowBox[{"#1", ",", "#2"}], "]"}], "[", "t", "]"}], "&"}], ")"}], 
         "@@@", "regimes"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", 
       InterpretationBox[
        DynamicModuleBox[{Typeset`open = False}, 
         TemplateBox[{"Expression", "SequenceIcon", 
