Cell["The theoretical solution of the master equation  is:", "Text",
 CellChangeTimes->{{3.927288471685427*^9, 3.927288484189781*^9}, {
   3.927288516201269*^9, 3.927288808792694*^9}, {3.934980096373392*^9, 
   3.934980106854973*^9}, {3.9349806664598637`*^9, 3.93498067065642*^9}, {
   3.934980798688616*^9, 3.934980815133901*^9}, 3.968177544829111*^9},
 CellID->26559417,ExpressionUUID->"8916a20b-191d-c643-99eb-625ec7dbab11"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Rho]", "F"], Cell[
    "(",ExpressionUUID->"34996a59-7987-3d45-9074-9bc29501e05a"], "t", Cell[
    ")",ExpressionUUID->"1a834bc5-ae69-bc44-a626-d3cdb59aa9ac"]}], "=", 
   RowBox[{
    SubsuperscriptBox["\[ScriptCapitalN]", "e", "2"], " ", 
    StyleBox["[",
     FontSize->18], GridBox[{
      {
       RowBox[{
        RowBox[{
         RowBox[{"|", 
          RowBox[{"\[Alpha]", " ", 
           SuperscriptBox["e", 
            RowBox[{
             RowBox[{"-", "\[Gamma]"}], " ", "t", "/", "2"}]]}], 
          "\[RightAngleBracket]"}], 
         RowBox[{"\[LeftAngleBracket]", 
          RowBox[{"\[Alpha]", " ", 
           SuperscriptBox["e", 
            RowBox[{
             RowBox[{"-", "\[Gamma]"}], " ", "t", "/", "2"}]]}], "|"}]}], "+", 
        RowBox[{
         RowBox[{"|", 
          RowBox[{
           RowBox[{"-", "\[Alpha]"}], " ", 
           SuperscriptBox["e", 
            RowBox[{
             RowBox[{"-", "\[Gamma]"}], " ", "t", "/", "2"}]]}], 
          "\[RightAngleBracket]"}], 
         RowBox[{"\[LeftAngleBracket]", 
          RowBox[{
           RowBox[{"-", "\[Alpha]"}], " ", 
           SuperscriptBox["e", 
            RowBox[{
             RowBox[{"-", "\[Gamma]"}], " ", "t", "/", "2"}]]}], "|"}]}]}]},
      {
       RowBox[{"+", 
        SuperscriptBox["e", 
         RowBox[{
          RowBox[{"-", "2"}], 
          SuperscriptBox[
           RowBox[{"|", "\[Alpha]", "|"}], "2"], 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            SuperscriptBox["e", 
             RowBox[{
              RowBox[{"-", "\[Gamma]"}], " ", "t"}]]}], ")"}]}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"|", 
            RowBox[{"\[Alpha]", " ", 
             SuperscriptBox["e", 
              RowBox[{
               RowBox[{"-", "\[Gamma]"}], " ", "t", "/", "2"}]]}], 
            "\[RightAngleBracket]"}], 
           RowBox[{"\[LeftAngleBracket]", 
            RowBox[{
             RowBox[{"-", "\[Alpha]"}], " ", 
             SuperscriptBox["e", 
              RowBox[{
               RowBox[{"-", "\[Gamma]"}], " ", "t", "/", "2"}]]}], "|"}]}], "+", 
          RowBox[{
           RowBox[{"|", 
            RowBox[{
             RowBox[{"-", "\[Alpha]"}], " ", 
             SuperscriptBox["e", 
              RowBox[{
               RowBox[{"-", "\[Gamma]"}], " ", "t", "/", "2"}]]}], 
            "\[RightAngleBracket]"}], 
           RowBox[{"\[LeftAngleBracket]", 
            RowBox[{"\[Alpha]", " ", 
             SuperscriptBox["e", 
              RowBox[{
               RowBox[{"-", "\[Gamma]"}], " ", "t", "/", "2"}]]}], "|"}]}]}], 
         ")"}]}]}
     }], 
    StyleBox["]",
     FontSize->18]}]}], TraditionalForm]], "DisplayFormula",
 CellID->189212246,ExpressionUUID->"63d7de5e-a5c4-2f49-a01d-65c23954169b"],

Cell[TextData[StyleBox["Implement analytical solution:", "Text"]], "CodeText",
 CellChangeTimes->{{3.96817800496706*^9, 3.9681780102734203`*^9}},
 CellID->146658295,ExpressionUUID->"6e7fb401-08dc-f24e-8872-fa8d536fcc1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sol", " ", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Alpha]", "=", 
        RowBox[{"\[Alpha]coh", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"-", "\[Gamma]"}], ")"}], " ", "t"}]]}]}], ",", 
       RowBox[{"decay", "=", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          SuperscriptBox[
           RowBox[{"Abs", "[", "\[Alpha]coh", "]"}], "2"], " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{
              RowBox[{"-", "\[Gamma]"}], " ", "t"}]]}], ")"}]}]]}]}], "}"}], ",", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"cPlus", "=", 
          RowBox[{
           RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]", "]"}]}], ",", 
         RowBox[{"cMinus", "=", 
          RowBox[{
           RowBox[{"CoherentState", "[", "]"}], "[", 
           RowBox[{"-", "\[Alpha]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"QuantumState", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"cPlus", "[", "\"\<MatrixState\>\"", "]"}], "+", 
            RowBox[{"cMinus", "[", "\"\<MatrixState\>\"", "]"}], "+", 
            RowBox[{
             RowBox[{"QuantumOperator", "[", 
              RowBox[{"(", 
               RowBox[{"decay", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"cPlus", "@", 
                   SuperscriptBox["cMinus", "\[Dagger]"]}], "+", 
                  RowBox[{"cMinus", "@", 
                   SuperscriptBox["cPlus", "\[Dagger]"]}]}], ")"}]}], ")"}], 
              "]"}], "[", "\"\<MatrixQuantumState\>\"", "]"}]}], ")"}], ",", 
          RowBox[{"\"\<Parameters\>\"", "\[Rule]", "t"}]}], "]"}], 
        "[", "\"\<Normalize\>\"", "]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[261]:=",
 CellID->197752699,ExpressionUUID->"8a5facf7-b8e0-ad4b-9153-977ec108e9c0"],

Cell[TextData[StyleBox["Compute fidelity as function of time:", "Text"]], \
"CodeText",
 CellChangeTimes->{{3.968178013769022*^9, 3.968178016720793*^9}, {
  3.972732941145033*^9, 3.9727329497974167`*^9}},
 CellID->66723722,ExpressionUUID->"b1d010d6-8ff4-9d44-99eb-e6251240400e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"similarities", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"QuantumSimilarity", "[", 
       RowBox[{
        RowBox[{"\[Rho]t", "[", "t", "]"}], ",", 
        RowBox[{"sol", "[", "t", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "10", ",", "0.05"}], "}"}]}], "]"}]}], 
   ";"}], "//", "EchoTiming"}]], "Input",
 CellLabel->"In[263]:=",
 CellID->104955924,ExpressionUUID->"3a55c179-6c26-2e41-99b8-5250b2c65f0a"],

Cell[BoxData["25.1540187`"], "EchoTiming",
 CellID->164022724,ExpressionUUID->"1a77595d-9d73-d24f-9a79-5f44e36255ba"]
}, Open  ]],

