Cell[CellGroupData[{

Cell[TextData[StyleBox["8.1 Quantum jump approach and decoherence", \
"Subsection"]], "Subsection",
 CellID->47083638,ExpressionUUID->"8441000d-3ff7-574c-b945-1577a6496d0d"],

Cell["\<\
Quantum theory was initially developed as a theory based on ensembles because \
it was thought that manipulating single quantum systems (like one electron or \
one atom) was impossible. In 1975 Dehmelt proposed in the context of \
fluorescence spectroscopy some schemes for measuring transition frequencies \
that required single quantum system observations, that were later implemented \
using single ion traps. Predictions were confirmed by experiments that \
impulsed the development of the quantum jump approach \
\>", "Text",
 CellChangeTimes->{{3.9326391740129623`*^9, 3.932639203078983*^9}, {
   3.932639551171717*^9, 3.932639605914968*^9}, 3.932641343399147*^9, {
   3.93264143661602*^9, 3.932641444197128*^9}, {3.932641678424989*^9, 
   3.9326416938990946`*^9}, {3.932641853804302*^9, 3.932641860318855*^9}, {
   3.932641891882576*^9, 3.932641996380153*^9}, {3.932642046146461*^9, 
   3.93264209595298*^9}, {3.932642270834175*^9, 3.932642279394993*^9}, {
   3.932642536203165*^9, 3.9326425691538935`*^9}, {3.932642681376775*^9, 
   3.9326426818586397`*^9}},
 CellID->144864503,ExpressionUUID->"00b7f6a6-05ae-9846-91e7-8deef8faf0c2"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Algorithm description", "Subsubsection"]], \
"Subsubsection",
 CellID->32144301,ExpressionUUID->"0f777a3d-0267-1a41-aaaf-73f93b337769"],

Cell[TextData[{
 "The quantum jump algorithm is similar to Monte Carlo methods, we assume a \
cavity field at T = 0 K,  and photon emission is represented by the \
annihilation operator ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["a", "^"], TraditionalForm]],ExpressionUUID->
  "e3abeac3-bfb1-3949-9d4c-2c7283ec719b"],
 ". We can describe the algorithm with the following steps"
}], "Text",
 CellID->628080899,ExpressionUUID->"d99305f8-1507-8c48-ac82-f344ab4f3ceb"],

Cell[CellGroupData[{

Cell[TextData[{
 "Calculate the current probability \[CapitalDelta]",
 Cell[BoxData[
  FormBox["P", TraditionalForm]],ExpressionUUID->
  "609b930a-f0be-9243-9d1d-1da492e6d26e"],
 " of emission of a photon in a time interval \[Delta]",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "95d9aad8-c70a-2848-b700-35020e9840eb"],
 " according to ",
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", "P", "=", 
    RowBox[{"\[Gamma]", " ", 
     RowBox[{"\[LeftAngleBracket]", "\[Psi]", "|", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"], 
       OverscriptBox["a", "^"]}], "|", "\[Psi]", "\[RightAngleBracket]"}], " ",
      "\[Delta]", " ", "t"}]}], TraditionalForm]], "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{3.9859500928154697`*^9, 3.9859501562430077`*^9},
  ExpressionUUID->"d93342b9-49e7-6d43-996e-005f0cf739c3"], "DisplayFormula"],
 StyleBox[" ", "DisplayFormula"],
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", "\[Psi]", "\[RightAngleBracket]"}], TraditionalForm]], 
  "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{3.985950092816471*^9, 3.9859501562440166`*^9},
  ExpressionUUID->"81659a7b-e0c3-5c44-a578-49f244b8fedb"],
 " is one member of the ensemble"
}], "Item",
 CellID->512973167,ExpressionUUID->"23584bd7-2b80-cb42-85d7-d7d630acfc69"],

Cell["\<\
Obtain a random number 0 \[LessEqual] r < 1, compare with \[CapitalDelta]P to \
decide emission\
\>", "Item",
 CellChangeTimes->{{3.9270254966587963`*^9, 3.927025649255085*^9}, {
  3.927025905181288*^9, 3.927025988578144*^9}, {3.927026272307045*^9, 
  3.927026278234801*^9}},
 CellID->826356926,ExpressionUUID->"47e6763d-011b-eb4d-9072-be0ee33d8156"],

Cell[TextData[{
 "Emit if r ",
 Cell[BoxData[
  FormBox["<", TraditionalForm]],ExpressionUUID->
  "fca1b8c6-f1be-0a4f-8284-d5395dfd92c7"],
 " \[CapitalDelta]P (field loses one photon), the system jumps to \
renormalized form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"|", "\[Psi]"}], "\[RightAngleBracket]"}], "\[RightArrow]"}], 
      "|", 
      SubscriptBox["\[Psi]", "emit"]}], "\[RightAngleBracket]"}], "=", 
    FractionBox[
     RowBox[{
      OverscriptBox["a", "^"], 
      RowBox[{"|", "\[Psi]", "\[RightAngleBracket]"}]}], 
     SuperscriptBox[
      RowBox[{"\[LeftAngleBracket]", "\[Psi]", "|", 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["a", "^"], "\[Dagger]"], 
        OverscriptBox["a", "^"]}], "|", "\[Psi]", "\[RightAngleBracket]"}], 
      RowBox[{"1", "/", "2"}]]]}], TraditionalForm]], "DisplayFormula",
  CellChangeTimes->{3.9859500928174763`*^9, 3.9859501562440166`*^9},
  ExpressionUUID->"565a6f91-0534-7549-9352-4041247b4d6f"]
}], "Item",
 CellID->549601966,ExpressionUUID->"6f0f3e1a-c9a3-d74a-97d6-a4006c24fe19"],

Cell[TextData[{
 "No emission r ",
 Cell[BoxData[
  FormBox[">", TraditionalForm]],ExpressionUUID->
  "29c7ad69-36aa-dc47-922f-2562c1c4358e"],
 " \[CapitalDelta]P, the system evolves according to\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"|", "\[Psi]"}], "\[RightAngleBracket]"}], "\[RightArrow]"}], 
      "|", 
      SubscriptBox["\[Psi]", 
       RowBox[{"no", " ", "emit"}]]}], "\[RightAngleBracket]"}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Delta]", " ", "t", " ", 
         SubscriptBox["H", "eff"]}]], 
       RowBox[{"|", "\[Psi]", "\[RightAngleBracket]"}]}], 
      SuperscriptBox[
       RowBox[{"[", 
        RowBox[{"\[LeftAngleBracket]", "\[Psi]", "|", 
         SuperscriptBox["e", 
          RowBox[{"\[ImaginaryI]", " ", "\[Delta]", " ", "t", " ", 
           SuperscriptBox[
            SubscriptBox["H", "eff"], "\[Dagger]"]}]], " ", 
         SuperscriptBox["e", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Delta]", " ", "t", " ", 
           SubscriptBox["H", "eff"]}]], "|", "\[Psi]", 
         "\[RightAngleBracket]"}], "]"}], 
       RowBox[{"1", "/", "2"}]]], "=", 
     FractionBox[
      RowBox[{
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Delta]", " ", "t", " ", 
         SubscriptBox["H", "eff"]}]], 
       RowBox[{"|", "\[Psi]", "\[RightAngleBracket]"}]}], 
      SuperscriptBox[
       RowBox[{"[", 
        RowBox[{"\[LeftAngleBracket]", "\[Psi]", "|", 
         SuperscriptBox["e", 
          RowBox[{
           RowBox[{"-", "\[Gamma]"}], " ", "\[Delta]", " ", "t", " ", 
           SuperscriptBox[
            OverscriptBox["a", "^"], "\[Dagger]"], 
           OverscriptBox["a", "^"]}]], "|", "\[Psi]", 
         "\[RightAngleBracket]"}], "]"}], 
       RowBox[{"1", "/", "2"}]]]}]}], TraditionalForm]], "DisplayFormula",
  CellChangeTimes->{3.98595009281847*^9, 3.985950156245018*^9},
  FontSize->18,ExpressionUUID->"9a4faef8-a3ae-c64f-af74-77e7b143b595"],
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[TildeTilde]", 
    FractionBox[
     RowBox[{
      RowBox[{"[", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[ImaginaryI]", "/", "\[HBar]"}], ")"}], 
         OverscriptBox["H", "^"], "\[Delta]", " ", "t"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Gamma]", "/", "2"}], ")"}], "\[Delta]", " ", "t", " ", 
         SuperscriptBox[
          OverscriptBox["a", "^"], "\[Dagger]"], 
         OverscriptBox["a", "^"]}]}], "]"}], 
      RowBox[{"|", "\[Psi]", "\[RightAngleBracket]"}]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"\[CapitalDelta]", " ", "P"}]}], ")"}], 
      RowBox[{"1", "/", "2"}]]]}], TraditionalForm]], "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{3.985950092820471*^9, 3.985950156245018*^9},
  FontSize->18,ExpressionUUID->"7a184386-b4bd-3844-af3f-01bff35b37a6"],
 "\[LineSeparator]where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["H", "^"], "eff"], "=", 
    RowBox[{
     OverscriptBox["H", "^"], "-", 
     RowBox[{"\[ImaginaryI]", " ", "\[HBar]", " ", 
      RowBox[{"(", 
       RowBox[{"\[Gamma]", "/", "2"}], ")"}], 
      SuperscriptBox[
       OverscriptBox["a", "^"], "\[Dagger]"], 
      OverscriptBox["a", "^"]}]}]}], TraditionalForm]], "DisplayFormula",
  CellChangeTimes->{3.9859500928216076`*^9, 3.9859501562460175`*^9},
  ExpressionUUID->"2f43cf9f-b6a4-bf4d-ae27-e0175549426d"],
 " is the effective non Hermitian Hamiltonian describing non unitary \
evolution, where the second term represents decay of the cavity field."
}], "Item",
 CellID->506796703,ExpressionUUID->"9dc876de-9843-f042-9430-a51122d43619"],

Cell[TextData[{
 " Iterate the process to record a trajectory of conditional evolution of one \
member of the ensemble with jump events  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["t", 
      RowBox[{"1", ","}]], 
     SubscriptBox["t", 
      RowBox[{"2", " "}]]}], "..."}], TraditionalForm]],ExpressionUUID->
  "aa77751a-4341-c545-ab53-0a111c8f4e81"]
}], "Item",
 CellChangeTimes->{{3.9270254966587963`*^9, 3.927025649255085*^9}, {
  3.927025905181288*^9, 3.927025988578144*^9}, {3.927026272307045*^9, 
  3.927026324063644*^9}, {3.927026386112919*^9, 3.927026455983848*^9}, {
  3.927026503712078*^9, 3.927026719631979*^9}, {3.927026848611534*^9, 
  3.9270269395533257`*^9}, {3.92702700332275*^9, 3.92702716596016*^9}, {
  3.927028235245201*^9, 3.92702844114604*^9}, {3.927030841544771*^9, 
  3.927030883675516*^9}, {3.927037955750769*^9, 3.927037975565363*^9}, {
  3.9270380148575096`*^9, 3.927038018218727*^9}, {3.9270390090790005`*^9, 
  3.9270391031233273`*^9}},
 CellID->64775577,ExpressionUUID->"38c964e3-3dc1-2543-a8ea-2e5105e2d959"],

Cell["\<\
 Average observables over a big number of trajectories to get average \
behavior of the whole ensemble\
\>", "Item",
 CellID->31893946,ExpressionUUID->"00159f35-b9b4-c348-bb94-609cd234729c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Quantum jumps on familiar states", "Subsubsection"]], \
"Subsubsection",
 CellChangeTimes->{{3.9270406892104263`*^9, 3.927040694137367*^9}},
 CellID->202336528,ExpressionUUID->"3ad087ff-db62-4447-9ca4-7871c2fdae50"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s assume ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["H", "^"], TraditionalForm]],ExpressionUUID->
  "ea92eb9d-7533-9742-aa35-e35941003e25"],
 " = 0 so only the dissipation acts. If we have an initial cavity field in a \
coherent state |\[Alpha]\[RightAngleBracket] the jump evolution leaves the \
field unchanged because a coherent state is an eigenstate of the annihilation \
operator, and the no jump-evolution results:"
}], "Text",
 CellID->445424427,ExpressionUUID->"eb956329-7d34-9f41-b612-a916a9ffeb1a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["e", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"\[Gamma]", "/", "2"}], ")"}]}], "\[Delta]", " ", "t", " ", 
       SuperscriptBox["a", "\[Dagger]"], "a"}]], 
     RowBox[{"|", "\[Alpha]", "\[RightAngleBracket]"}]}], 
    SqrtBox[
     RowBox[{"\[LeftAngleBracket]", "\[Alpha]", "|", 
      SuperscriptBox["e", 
       RowBox[{
        RowBox[{"-", "\[Gamma]"}], " ", "\[Delta]", " ", "t", " ", 
        SuperscriptBox["a", "\[Dagger]"], "a"}]], "|", "\[Alpha]", 
      "\[RightAngleBracket]"}]]], "=", 
   RowBox[{"|", 
    RowBox[{"\[Alpha]", " ", 
     SuperscriptBox["e", 
      RowBox[{
       RowBox[{"-", "\[Gamma]"}], " ", "\[Delta]", " ", "t", "/", "2"}]]}], 
    "\[RightAngleBracket]"}]}], TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.9859500928307495`*^9, 3.9859501562480164`*^9},
 CellID->661372106,ExpressionUUID->"75c6692a-cf15-b741-baa2-ad6109ecf560"],

Cell["\<\
The coherent state remains a coherent state after the evolution, however, the \
amplitude of the state has an exponential decay due to the non unitary \
Hamiltonian\
\>", "Text",
 CellChangeTimes->{{3.927053468274975*^9, 3.927053536857331*^9}, {
  3.9542356578347588`*^9, 3.9542356632944965`*^9}},
 CellID->275989706,ExpressionUUID->"0a10fefe-6811-3c46-96e3-c0013f779b7d"],

Cell[TextData[StyleBox["Set truncation size:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681756448937397`*^9, 3.9681756524178486`*^9}},
 CellID->18210839,ExpressionUUID->"a6474016-f78e-d640-bbe6-e4cf80191048"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SetFockSpaceSize", "[", "20", "]"}], ";"}], "  "}]], "Input",
 CellChangeTimes->{{3.92704162601029*^9, 3.927041633342953*^9}, {
   3.932642811745704*^9, 3.9326428670902596`*^9}, {3.932643360054964*^9, 
   3.932643361364561*^9}, {3.934974617677716*^9, 3.934974695351498*^9}, {
   3.934974864754429*^9, 3.934974865480383*^9}, {3.934975955688896*^9, 
   3.934975957752548*^9}, 3.9542351876500072`*^9, {3.9542354397322903`*^9, 
   3.9542354414093323`*^9}},
 CellLabel->"In[7]:=",
 CellID->756026789,ExpressionUUID->"2b90775e-3905-ea45-b8e3-e07ccb715d52"],

Cell["Term describing non unitary evolution:", "Text",
 CellChangeTimes->{{3.9542354947487926`*^9, 3.954235503439171*^9}},
 CellID->508086990,ExpressionUUID->"9c2dcb29-4f2f-9e4d-b70e-cd218d6c636b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Hdisp", "=", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", "h", " ", "\[Gamma]", " ", 
    RowBox[{
     SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}]}], ";"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->158773009,ExpressionUUID->"85cf312c-f640-6e4e-a252-fd0f0494ced5"],

Cell[TextData[StyleBox["Let\[CloseCurlyQuote]s verify the equation \
symbolically:", "Text"]], "CodeText",
 CellID->161454874,ExpressionUUID->"bb975c6f-ec7e-714a-b512-88d9aff8feef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", "Hdisp", " ", "\[Delta]t"}], "h"]}]], "[", 
   RowBox[{
    RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]", "]"}], "]"}], "\[Equal]", 
  RowBox[{
   RowBox[{"CoherentState", "[", "]"}], "[", 
   RowBox[{"\[Alpha]", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"-", "\[Gamma]"}], ")"}], " ", "\[Delta]t"}]]}], 
   "]"}]}]], "Input",
 CellLabel->"In[10]:=",
 CellID->516224375,ExpressionUUID->"50826b43-e77e-d94a-bbd6-28bfa27db74f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[10]=",
 CellID->142642353,ExpressionUUID->"b6aa679f-ddd3-8143-bbcf-ec3212fced71"]
}, Open  ]],

Cell[TextData[{
 "We get a valid result because the square root in the denominator is just a \
normalization factor. ",
 StyleBox["QuantumState", "FormattedFunction"],
 "  equality (==) in Wolfram QuantumFramework works up to global phases and \
multiplicative factors"
}], "Text",
 CellID->697734537,ExpressionUUID->"b05ac6de-8546-e84a-b519-4586fa67d727"],

Cell[TextData[StyleBox["Check the dissipative Hamiltonian is not unitary:", \
"Text"]], "CodeText",
 CellID->850783525,ExpressionUUID->"2e0e155a-d03c-6e44-bd93-a21649bdce10"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Hdisp", "[", "\"\<UnitaryQ\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.9542356272425194`*^9, 3.954235633396736*^9}},
 CellLabel->"In[10]:=",
 CellID->73539124,ExpressionUUID->"b1854fb4-80c2-754f-9d79-b8b511b5b86d"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[10]=",
 CellID->178999944,ExpressionUUID->"1a71c269-8d82-c34e-8638-22a6e648d4e5"]
}, Open  ]],

Cell[TextData[{
 "If we now consider a cavity field prepared in a even cat state  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"|", "\[Psi]", "\[RightAngleBracket]"}], "e"], "=", 
    RowBox[{
     SubscriptBox["\[ScriptCapitalN]", "e"], "(", 
     RowBox[{
      RowBox[{"|", "\[Alpha]", "\[RightAngleBracket]"}], "+", 
      RowBox[{"|", 
       RowBox[{"-", "\[Alpha]"}], "\[RightAngleBracket]"}]}], ")"}]}], 
   TraditionalForm]], "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{3.985950092831255*^9, 3.98595015624922*^9},ExpressionUUID->
  "d84ee312-c9a3-f947-8db0-9e570d3f1620"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalN]", "e"], "  "}], TraditionalForm]],
  ExpressionUUID->"20d5748a-fcde-3546-afd2-b14023aec737"],
 " is  a normalization constant , the annihilation operator converts an even \
cat state to odd cat state"
}], "Text",
 CellID->394959207,ExpressionUUID->"bb28c9aa-b5a1-7c47-8a62-510ed5b0d135"],

