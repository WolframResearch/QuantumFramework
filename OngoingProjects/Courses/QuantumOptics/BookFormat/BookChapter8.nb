Cell[TextData[{
 "For the thermal bath keep ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "92a098f9-c857-0040-9b77-6328e3d4e880"],
 " symbolic and read off how the diffusion depends on n\:0304 and s. Build \
the Langevin process from it, start from the s-ordered function of |\[Alpha]\
\:2080\:27e9 (a Gaussian with covariance ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "\[Minus]", "s"}], ")"}], "/", "2"}], "\[CenterDot]", 
    "\|01d7d9", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0214f6a5-59c5-3244-9348-049ec43d594b"],
 "for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"s", "<", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4a4c5c62-28fb-ec4d-802d-28ad40346422"],
 "), and repeat the expectation calculation with the appropriate ordering \
correction. Show that the result agrees for every s. What is the long-time \
variance of the cloud, and why is it n\:0304 only after the correction? \
Finally, set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"s", " ", "=", " ", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "050f13cb-e4dc-bd46-90b6-d4fa580a3088"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n\:0304", " ", "=", " ", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c0ec65e3-ec5a-9d49-8142-3e3efdb8f52d"],
 "  and compute the covariance of the process and explain why the \
P-representation Langevin equation needs no random numbers at all."
}], "Exercise",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellID->353471685,ExpressionUUID->"15c1b471-9631-914c-a02c-614c506e0273"],

Cell[CellGroupData[{

Cell["Solution", "ExerciseSolution",
 CellID->754019172,ExpressionUUID->"f57e1749-9853-464d-acd9-f0b3a9318f57"],

Cell[CellGroupData[{

Cell["Thermal bath:", "ExerciseNote",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->306843115,ExpressionUUID->"8317f53a-3740-2542-95d4-e1a156ea8453"],

Cell[BoxData[
 RowBox[{
  RowBox[{"thermal", "[", "f_", "]"}], ":=", 
  RowBox[{
   RowBox[{"\[Gamma]", " ", 
    RowBox[{"(", 
     RowBox[{
      OverscriptBox["n", "_"], "+", "1"}], ")"}], " ", 
    RowBox[{"loss", "[", "f", "]"}]}], "+", 
   RowBox[{"\[Gamma]", " ", 
    OverscriptBox["n", "_"], " ", 
    RowBox[{"gain", "[", "f", "]"}]}]}]}]], "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->807195244,ExpressionUUID->"c52d1106-fd38-f64e-9639-f815ac53e8dd"],

Cell["Obtain the diffusion from Kramers-Moyal:", "ExerciseNote",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->478570342,ExpressionUUID->"a903bfa5-be23-a24e-a22c-1d69de635cdf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kmS", "=", 
   RowBox[{"kramersMoyal", "[", 
    RowBox[{"thermal", ",", "s"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"kmS", "[", "\"\<Diffusion\>\"", "]"}]}], "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[145]:=",
 CellID->187538364,ExpressionUUID->"33638891-f68d-6942-9ec4-fbdc56dcbbde"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"\[Gamma]", "-", 
        RowBox[{"s", " ", "\[Gamma]"}], "+", 
        RowBox[{"2", " ", "\[Gamma]", " ", 
         OverscriptBox["n", "_"]}]}], ")"}]}], ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"\[Gamma]", "-", 
        RowBox[{"s", " ", "\[Gamma]"}], "+", 
        RowBox[{"2", " ", "\[Gamma]", " ", 
         OverscriptBox["n", "_"]}]}], ")"}]}]}], "}"}]}], 
  "}"}]], "ExerciseOutput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"Out[146]=",
 CellID->963045688,ExpressionUUID->"1eaa85e3-62ec-fa4c-89d2-81f7e7d19670"],

Cell["Langevin equation process:", "ExerciseNote",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->171305026,ExpressionUUID->"7c0715a7-2db4-6349-b93f-05306931aee2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"procS", "=", 
   RowBox[{"langevin", "[", 
    RowBox[{"kmS", ",", 
     RowBox[{"{", 
      RowBox[{"x0", ",", "p0"}], "}"}]}], "]"}]}], ";"}]], "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[148]:=",
 CellID->1054312002,ExpressionUUID->"2327a6c8-bca6-aa48-997a-d0c37786f07a"],

Cell["Expectation calculation:", "ExerciseNote",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->464543260,ExpressionUUID->"33253405-b180-6645-ade3-5199fae8b0f8"],

Cell[BoxData[
 RowBox[{"Expectation", "[", 
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Total", "[", 
       SuperscriptBox[
        RowBox[{"Mean", "[", 
         RowBox[{"procS", "[", "t", "]"}], "]"}], "2"], "]"}], "+", 
      RowBox[{"Tr", "[", 
       RowBox[{"Covariance", "[", 
        RowBox[{"procS", "[", "t", "]"}], "]"}], "]"}]}], ")"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x0", ",", "p0"}], "}"}], "\[Distributed]", 
    RowBox[{"MultinormalDistribution", "[", 
     RowBox[{
      RowBox[{
       SqrtBox["2"], " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "[", "\[Alpha]0", "]"}], ",", 
         RowBox[{"Im", "[", "\[Alpha]0", "]"}]}], "}"}]}], ",", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", "s"}], ")"}], " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "]"}]}]}], 
  "]"}]], "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[156]:=",
 CellID->26443321,ExpressionUUID->"fcfc7ef7-025c-3945-b118-bccac104f559"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["1", "2"]}], " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"-", "t"}], " ", "\[Gamma]"}]], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"t", " ", "\[Gamma]"}]]}], "+", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"t", " ", "\[Gamma]"}]], " ", "s"}], "-", 
    RowBox[{"2", " ", 
     SuperscriptBox[
      RowBox[{"Im", "[", "\[Alpha]0", "]"}], "2"]}], "+", 
    RowBox[{"2", " ", 
     OverscriptBox["n", "_"]}], "-", 
    RowBox[{"2", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"t", " ", "\[Gamma]"}]], " ", 
     OverscriptBox["n", "_"]}], "-", 
    RowBox[{"2", " ", 
     SuperscriptBox[
      RowBox[{"Re", "[", "\[Alpha]0", "]"}], "2"]}]}], 
   ")"}]}]], "ExerciseOutput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"Out[156]=",
 CellID->258507889,ExpressionUUID->"34bea294-bbdf-ea42-b894-99d460bb06d2"],

Cell[TextData[{
 "The correction is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "s"}], ")"}], "/", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "13c540ad-3809-3b40-a255-927222156236"],
 " and we get the same result that was obtained:"
}], "ExerciseNote",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->232348013,ExpressionUUID->"bf5a94d1-5e6c-7b48-b312-e8d400fd7d80"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"%", "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "s"}], ")"}], "/", "2"}], "-", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "t"}], " ", "\[Gamma]"}]], " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"Abs", "[", "\[Alpha]0", "]"}], "2"], "-", 
        OverscriptBox["n", "_"]}], ")"}]}], "+", 
     OverscriptBox["n", "_"]}], ")"}]}], "]"}]], "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[157]:=",
 CellID->94687341,ExpressionUUID->"327ff5d7-4e34-9247-814c-f2bb7ec6ce20"],

Cell[BoxData["0"], "ExerciseOutput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"Out[157]=",
 CellID->51412642,ExpressionUUID->"5ef886b7-f3c0-4148-8411-4f50d3885b29"],

Cell[TextData[{
 "The steady-state cloud is the s-ordered function of a thermal state, its \
width is the thermal photons plus the ordering\[CloseCurlyQuote]s vacuum \
share. Only after subtracting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "\[Minus]", "s"}], ")"}], "/", "2", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1162d0f5-7886-0f4f-bb35-801cb974a716"],
 "we get  \[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["a", "\[Dagger]"], "a"}], "\[RightAngleBracket]"}], "=", 
    OverscriptBox["n", "\[LongDash]"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8afc4837-55c9-b540-ad36-8052b7a1b846"]
}], "ExerciseNote",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->212103974,ExpressionUUID->"5958e984-d597-9543-825b-466393fcaffb"],

Cell[BoxData[
 RowBox[{"Limit", "[", 
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"Tr", "[", 
     RowBox[{"Covariance", "[", 
      RowBox[{"procS", "[", "t", "]"}], "]"}], "]"}]}], ",", 
   RowBox[{"t", "\[Rule]", "\[Infinity]"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"\[Gamma]", ">", "0"}]}]}], "]"}]], "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[158]:=",
 CellID->618352615,ExpressionUUID->"39b874a4-896e-d542-ab7f-b5d306f3d338"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["n", "_"], "-", 
   FractionBox["s", "2"], "+", 
   FractionBox["1", "2"]}], TraditionalForm]], "ExerciseOutput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"Out[158]=",
 CellID->585115653,ExpressionUUID->"ceb9e84e-4103-5248-8a28-5574c78264e9"],

Cell["Compute the P representation covariance:", "ExerciseNote",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->62640637,ExpressionUUID->"c9e99b77-6ef9-0f49-a700-b12a1e9ae14e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"procP", "=", 
   RowBox[{"langevin", "[", 
    RowBox[{
     RowBox[{"kmS", "/.", "\[VeryThinSpace]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"s", "\[Rule]", "1"}], ",", 
        RowBox[{
         OverscriptBox["n", "_"], "\[Rule]", "0"}]}], "}"}]}], ",", 
     RowBox[{
      SqrtBox["2"], " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Re", "[", "\[Alpha]0", "]"}], ",", 
        RowBox[{"Im", "[", "\[Alpha]0", "]"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Covariance", "[", 
    RowBox[{"procP", "[", "t", "]"}], "]"}], ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"Total", "[", 
      SuperscriptBox[
       RowBox[{"Mean", "[", 
        RowBox[{"procP", "[", "t", "]"}], "]"}], "2"], "]"}]}], "]"}]}], 
  "}"}]}], "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[159]:=",
 CellID->119177748,ExpressionUUID->"bea291c2-d862-bb49-996a-35b93d1c8d44"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "t"}], " ", "\[Gamma]"}]], " ", "\[Alpha]0", " ", 
    RowBox[{"Conjugate", "[", "\[Alpha]0", "]"}]}]}], "}"}]], "ExerciseOutput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"Out[160]=",
 CellID->178780119,ExpressionUUID->"c54e7f47-67cc-8d42-89e7-a759399006f7"],

Cell[TextData[{
 "The ordering share ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "s"}], ")"}], "/", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "97e5d700-534a-1f49-a9b9-ac5450261053"],
 " is zero, normal ordering carries no vacuum noise. Also at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["n", "\[LongDash]"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f40f174c-e2d5-4545-9cf4-7322179ac2ed"],
 " there is thermal noise, and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "85adda44-f7bb-3847-bea8-cb7130002f81"],
 "function of |",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3a67edf6-8841-294c-b57f-644402bc08a5"],
 "\[RightAngleBracket] is single point so no random starting point . That is \
why no random number involved and the exact trajectory is |",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "\[RightAngleBracket]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5aa4ae8b-04b1-2246-825b-6973d326e04c"],
 Cell[BoxData[
  FormBox[
   RowBox[{" ", "->"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ae029a82-f657-fd4d-8f82-94432b70e6ce"],
 " |",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[Gamma]"}], " ", 
      RowBox[{"t", "/", "2"}]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ce4f0efe-cabc-7f4f-9fe6-5fae50aca330"],
 "\[RightAngleBracket]"
}], "ExerciseNote",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->122502831,ExpressionUUID->"01cace61-13c9-f74f-93fe-a1dc4923c029"]
}, Open  ]]
}, Closed]]
}, Open  ]],

