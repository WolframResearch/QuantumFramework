Cell["\<\
This verifies that the \[OpenCurlyDoubleQuote]coherences\
\[CloseCurlyDoubleQuote] decay faster than the energy and the evolved state \
becomes a statistical mixture, of course the amplitude is not the same \
because during the evolution  photon loss has acted\
\>", "Text",
 CellID->9869428,ExpressionUUID->"340ac2f9-f3fd-f64d-b6a0-d7baf6300f6a"],

Cell["\<\
But after a sufficient time the photon loss transforms the state into the \
vacuum:\
\>", "Text",
 CellChangeTimes->{
  3.95423968865361*^9, {3.9727333144516487`*^9, 3.972733356173712*^9}, {
   3.972733388342411*^9, 3.9727334044331017`*^9}},
 CellID->130400418,ExpressionUUID->"074a8a82-6b3c-0c4e-9cb9-09a628eaef1f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"wig", " ", "=", " ", 
   RowBox[{"WignerRepresentation", "[", 
    RowBox[{
     RowBox[{"\[Rho]t", "[", "10", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"DensityPlot", "[", 
   RowBox[{
    RowBox[{"Chop", "@", 
     RowBox[{"wig", "[", 
      RowBox[{"x", ",", "p"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"p", ",", 
      RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
    InterpretationBox[
     DynamicModuleBox[{Typeset`open = False}, 
      TemplateBox[{"Expression", "SequenceIcon", 
        GridBox[{{
           RowBox[{
             TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["Sequence", "IconizedItem"]}]}, {
           RowBox[{
             TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["6", "IconizedItem"]}]}, {
           RowBox[{
             TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["720", "IconizedItem"]}]}}, 
         GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
         "Column", 
         GridBoxItemSize -> {
          "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
        Dynamic[Typeset`open]},
       "IconizedObject"]],
     Sequence[
     PlotRange -> All, PlotPoints -> 150, ColorFunction -> "DeepSeaColors", 
      FrameLabel -> {"x", "p"}, LabelStyle -> 14, PlotLabel -> 
      "Wigner representation for t = \!\(\*SubscriptBox[\(t\), \(f\)]\)"],
     SelectWithContents->True,
     Selectable->False]}], "]"}]}]], "Input",
 CellLabel->"In[269]:=",
 CellID->52630001,ExpressionUUID->"6ddda5cd-b959-cd47-943f-fe0cb9595b6d"],

