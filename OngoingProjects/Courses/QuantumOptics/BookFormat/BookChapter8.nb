Cell[TextData[{
 "The TWA gets the expected behavior. It reproduces the dip, its depth to \
within a few tenths of a dB, its position in \[Tau]  and the later rise. The \
optimal squeezing time shrinks like ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["n", "0"], 
    RowBox[{
     RowBox[{"-", "2"}], "/", "3"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fbb2ce55-e3c2-af4c-8fa9-6633cce2f1e0"],
 "  the one-axis-twisting scaling due to the similarities in structure of the \
Kerr non linear Hamiltonian and the spin ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["S", "z"], "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "70791adb-2350-9a4e-957a-ed6359d201d6"],
 "."
}], "Text",
 CellID->112540370,ExpressionUUID->"52a77207-1910-4e4c-abc8-95f597c26da2"],

Cell["Function for preparing Wigner plot panels:", "Text",
 CellID->477634481,ExpressionUUID->"31b7d0c4-26a9-dd49-ab63-9a6e9a078831"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"kerrPanels", "[", 
    RowBox[{"n0_", ",", "\[Tau]_", ",", 
     RowBox[{"{", 
      RowBox[{"x1_", ",", "x2_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"p1_", ",", "p2_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"clouds", ",", "exact", ",", 
       RowBox[{"k", "=", 
        RowBox[{"Round", "[", 
         RowBox[{"\[Tau]", " ", 
          RowBox[{"nSteps", "/", "\[Tau]max"}]}], "]"}]}], ",", "cloud", ",", 
       "rot", ",", "w", ",", "wmax", ",", "colour"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"clouds", ",", "exact"}], "}"}], "=", 
       RowBox[{"runs", "[", "n0", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"cloud", "=", 
       RowBox[{"clouds", "[", 
        RowBox[{"[", 
         RowBox[{"k", "+", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rot", "=", 
       RowBox[{"RotationMatrix", "[", 
        RowBox[{"Arg", "[", 
         RowBox[{"Mean", "[", 
          RowBox[{
           RowBox[{
           "cloud", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "+", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{
            "cloud", "\[LeftDoubleBracket]", "2", 
             "\[RightDoubleBracket]"}]}]}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"w", "=", 
       RowBox[{"WignerRepresentation", "[", 
        RowBox[{
         RowBox[{"exact", "[", 
          RowBox[{"k", " ", 
           RowBox[{"\[Tau]max", "/", "nSteps"}], " ", 
           SuperscriptBox["n0", 
            RowBox[{
             RowBox[{"-", "2"}], "/", "3"}]]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "13"}], ",", "13"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "13"}], ",", "13"}], "}"}], ",", 
         RowBox[{"\"\<GridSize\>\"", "->", "300"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wmax", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"w", "@@", 
            RowBox[{"(", 
             RowBox[{"rot", ".", 
              RowBox[{"{", 
               RowBox[{"x", ",", "p"}], "}"}]}], ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "x1", ",", "x2", ",", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x2", "-", "x1"}], ")"}], "/", "100"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"p", ",", "p1", ",", "p2", ",", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"p2", "-", "p1"}], ")"}], "/", "100"}]}], "}"}]}], 
          "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"colour", "=", 
       RowBox[{
        RowBox[{"Blend", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Blue", ",", "White", ",", "Red"}], "}"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"#", "/", "wmax"}]}], ")"}], "/", "2"}]}], "]"}], 
        "&"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"DensityPlot", "[", 
         RowBox[{
          RowBox[{"w", "@@", 
           RowBox[{"(", 
            RowBox[{"rot", ".", 
             RowBox[{"{", 
              RowBox[{"x", ",", "p"}], "}"}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "x1", ",", "x2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"p", ",", "p1", ",", "p2"}], "}"}], ",", 
          InterpretationBox[
           DynamicModuleBox[{Typeset`open = False}, 
            TemplateBox[{"Expression", "SequenceIcon", 
              GridBox[{{
                 RowBox[{
                   TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                   TagBox["Sequence", "IconizedItem"]}]}, {
                 RowBox[{
                   TagBox["\"Length: \"", "IconizedLabel"], 
                   "\[InvisibleSpace]", 
                   TagBox["8", "IconizedItem"]}]}, {
                 RowBox[{
                   TagBox["\"Byte count: \"", "IconizedLabel"], 
                   "\[InvisibleSpace]", 
                   TagBox["1040", "IconizedItem"]}]}}, 
               GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
               "Column", 
               GridBoxItemSize -> {
                "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
              Dynamic[Typeset`open]},
             "IconizedObject"]],
           Sequence[
           PlotPoints -> 120, MaxRecursion -> 1, 
            PlotRange -> {{$CellContext`x1, $CellContext`x2}, \
{$CellContext`p1, $CellContext`p2}, All}, ColorFunctionScaling -> False, 
            ColorFunction -> $CellContext`colour, FrameLabel -> {"x", "p"}, 
            PlotLabel -> Row[{"exact,  \[Tau] = ", $CellContext`\[Tau]}], 
            ImageSize -> 240],
           SelectWithContents->True,
           Selectable->False]}], "]"}], ",", 
        RowBox[{"SmoothDensityHistogram", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "rot", "]"}], ".", "cloud"}], "]"}], ",",
           "0.15", ",", 
          InterpretationBox[
           DynamicModuleBox[{Typeset`open = False}, 
            TemplateBox[{"Expression", "SequenceIcon", 
              GridBox[{{
                 RowBox[{
                   TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                   TagBox["Sequence", "IconizedItem"]}]}, {
                 RowBox[{
                   TagBox["\"Length: \"", "IconizedLabel"], 
                   "\[InvisibleSpace]", 
                   TagBox["7", "IconizedItem"]}]}, {
                 RowBox[{
                   TagBox["\"Byte count: \"", "IconizedLabel"], 
                   "\[InvisibleSpace]", 
                   TagBox["960", "IconizedItem"]}]}}, 
               GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
               "Column", 
               GridBoxItemSize -> {
                "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
              Dynamic[Typeset`open]},
             "IconizedObject"]],
           Sequence[
           PlotPoints -> 80, 
            PlotRange -> {{$CellContext`x1, $CellContext`x2}, \
{$CellContext`p1, $CellContext`p2}, All}, ColorFunctionScaling -> False, 
            ColorFunction -> $CellContext`colour, FrameLabel -> {"x", "p"}, 
            PlotLabel -> Row[{"TWA,  \[Tau] = ", $CellContext`\[Tau]}], 
            ImageSize -> 240],
           SelectWithContents->True,
           Selectable->False]}], "]"}]}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[314]:=",
 CellID->92054882,ExpressionUUID->"0aace7e0-d207-9d4b-8bab-36a8aeae90ab"],

Cell["Visualize the phase space evolution at three instants:", "Text",
