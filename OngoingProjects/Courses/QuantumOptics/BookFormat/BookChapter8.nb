     LabelStyle -> 12, PlotLegends -> {"Fidelity", "Mean number of photons"}, 
     PlotLabel -> "Optical balance for short times", ImageSize -> 400],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
