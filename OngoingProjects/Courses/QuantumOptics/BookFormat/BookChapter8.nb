Cell["Jaynes-Cummings Hamiltonian:", "Text",
 CellChangeTimes->{{3.9732616098551216`*^9, 3.9732616149966984`*^9}},
 CellID->749920064,ExpressionUUID->"60665387-ce73-bd4f-8d90-fffa37310dab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H", " ", "=", "  ", 
   RowBox[{
    RowBox[{"\[Nu]", " ", 
     RowBox[{
      SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], "+", " ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", "\[Omega]", " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Z\>\"", ",", "atomBasis"}], "]"}]}], "+", 
    RowBox[{"gc", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Sigma]plus", "@", "a"}], "+", 
       RowBox[{"\[Sigma]minus", "@", 
        SuperscriptBox["a", "\[Dagger]"]}]}], ")"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[41]:=",
 CellID->466484576,ExpressionUUID->"2d6ee459-1717-8e49-b941-9c89142ed126"],

Cell["\<\
Get the probability of finding the atom in the excited state:\
\>", "Text",
 CellChangeTimes->{{3.9668886487763863`*^9, 3.9668886632159805`*^9}, {
  3.973262157076103*^9, 3.9732621584211693`*^9}},
 CellID->115898076,ExpressionUUID->"08a35714-0fe4-7c49-9865-6c7097bd6133"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"atomProb", "[", 
    RowBox[{"evolved_", ",", "tspecs_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pe", "=", 
       RowBox[{"Re", "@", 
        RowBox[{
         RowBox[{
          RowBox[{"QuantumPartialTrace", "[", 
           RowBox[{"evolved", ",", 
            RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<DensityMatrix\>\"", 
          "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", "pe"}], "}"}], ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"Sequence", "@@", "tspecs"}]}], "}"}], "]"}]}], "]"}]}], 
    "]"}]}], "\n"}]], "Input",
 CellLabel->"In[42]:=",
 CellID->50352114,ExpressionUUID->"46dfc863-68f7-a249-b6f8-efcf254f6204"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s calculate the evolution for different damping \
parameters such that ",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "1"], "=", 
    SubscriptBox["\[Gamma]", "2"]}], "Text"]], "InlineFormula",ExpressionUUID->
  "9856a1fc-ab2f-7045-9e6f-816fd843effe"],
 ", saving the probability of finding the atom in the excited state. ",
 StyleBox["QuantumOperator", "CodeText"],
 StyleBox["  ", "FormattedFunction"],
 "also admits the",
 StyleBox[" \[OpenCurlyDoubleQuote]Hamiltonian\[CloseCurlyDoubleQuote]", 
  "FormattedFunction"],
 " syntax to include jump operators, \[ImaginaryI] is not needed when using",
 StyleBox[" QuantumEvolve ", "FormattedFunction"],
 "in this case",
 StyleBox[".  ", "FormattedFunction"],
 "And the jump operators can be specified in their respective subspace \
because it works with automatic identity padding ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SuperscriptBox["\[Sigma]", "-"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b28f2ad9-d790-7c4f-87d6-035d48945039"],
 " and ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a4eb3723-cddc-bb49-ba5f-662d7a6b2ac9"],
 ") "
}], "Text",
 CellID->344828823,ExpressionUUID->"ad861a34-2d9a-aa43-8a5d-d18931fe0b6c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"probsE", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[ScriptCapitalH]", " ", "=", " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<Hamiltonian\>\"", "[", 
         RowBox[{"H", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\[Sigma]minus", ",", " ", "a"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "x"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
      "   ", 
      RowBox[{"atomProb", "[", 
       RowBox[{
        RowBox[{"QuantumEvolve", "[", " ", 
         RowBox[{"\[ScriptCapitalH]", ",", " ", "\[Psi]0", ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "2", ",", "0.01"}], "}"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.8", ",", " ", "0.4", ",", " ", "0.2"}], "}"}]}], "}"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[17]:=",
 CellID->219999820,ExpressionUUID->"44129305-3e42-244a-a81c-5a53d0f1b521"],

Cell["Visualize damped Rabi oscillations:", "Text",
 CellID->12231643,ExpressionUUID->"48a32b6e-0148-a043-8d81-c6bb7c3dab3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"probsE", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["8", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["1064", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    PlotRange -> All, Frame -> True, InterpolationOrder -> 2, 
     FrameLabel -> {
      "t", "\!\(\*SubscriptBox[\(P\), \
\(\(\(|\)\(e\)\)\(\[RightAngleBracket]\)\)]\)(t)"}, LabelStyle -> 12, 
     ImageSize -> 450, 
     PlotLegends -> {
      "\[Gamma],\[Kappa] = 0.8", "\[Gamma],\[Kappa] = 0.4", 
       "\[Gamma],\[Kappa] = 0.2"}, PlotLabel -> 
     "Damped Rabi oscillations for different dissipation parameters"],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellChangeTimes->{{3.973263941289034*^9, 3.9732640483305244`*^9}, {
   3.97326435093647*^9, 3.9732643515010853`*^9}, {3.973264464843155*^9, 
