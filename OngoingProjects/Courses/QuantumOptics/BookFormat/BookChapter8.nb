Cell["For a no jump transition the field state decays as", "Text",
 CellID->155468375,ExpressionUUID->"6c915a89-17bd-1541-ab54-68afa3ce2186"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", "\[Gamma]"}], " ", "\[Delta]", " ", "t", " ", 
      SuperscriptBox[
       OverscriptBox["a", "^"], "\[Dagger]"], 
      OverscriptBox["a", "^"], "/", "2"}], ")"}], "(", 
    RowBox[{
     RowBox[{"|", "\[Alpha]", "\[RightAngleBracket]"}], "\[PlusMinus]", 
     RowBox[{"|", 
      RowBox[{"-", "\[Alpha]"}], "\[RightAngleBracket]"}]}], ")"}], "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"|", 
      RowBox[{"\[Alpha]", " ", 
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", "\[Gamma]"}], " ", "\[Delta]", " ", "t", "/", "2"}]]}], 
      "\[RightAngleBracket]"}], "\[PlusMinus]", 
     RowBox[{"|", 
      RowBox[{
       RowBox[{"-", "\[Alpha]"}], " ", 
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", "\[Gamma]"}], " ", "\[Delta]", " ", "t", "/", "2"}]]}], 
      "\[RightAngleBracket]"}]}], ")"}]}], TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.985950092832262*^9, 3.98595015624922*^9},
 CellID->39977557,ExpressionUUID->"3afd9e8d-763f-cd4f-88a9-79b0391cd7b4"],

Cell[TextData[{
 "We will also verify this symbolically without normalizing, that is why we \
will not use ",
 StyleBox["CatState", "FormattedFunction"],
 " (which comes normalized). Instead, we define a superposition of \
not-normalized coherent states"
}], "Text",
 CellID->88461038,ExpressionUUID->"9301e1c4-3a51-704d-85e8-89862a358f10"],

Cell[TextData[StyleBox["Coherent state superposition:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681760441649456`*^9, 3.9681760486713676`*^9}},
 CellID->666294589,ExpressionUUID->"20ce03dc-88c7-764b-8239-66d4c77b8352"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evenCat", "=", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"CoherentState", "[", 
           RowBox[{"\"\<Normalized\>\"", "\[Rule]", "False"}], "]"}], "[", 
          "#1", "]"}], "&"}], ")"}], "/@", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", 
         RowBox[{"-", "\[Alpha]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"\"\<Parameters\>\"", "\[Rule]", "\[Alpha]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[14]:=",
 CellID->185380696,ExpressionUUID->"eacd8629-b4ad-e34a-b757-3c345a1debb0"],

Cell[TextData[StyleBox["\[OpenCurlyDoubleQuote]No-jump\[CloseCurlyDoubleQuote]\
 evolution:", "Text"]], "CodeText",
 CellChangeTimes->{{3.968176054933487*^9, 3.968176061777691*^9}},
 CellID->11249264,ExpressionUUID->"1d52eca3-e742-e744-a05d-a26c64fbdcf1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", " ", "\[ImaginaryI]"}], " ", 
     RowBox[{"Hdisp", " ", "/", "h"}], " ", "\[Delta]t"}]], " ", "@", " ", 
   "evenCat"}], "  ", "==", " ", 
  RowBox[{"evenCat", "[", 
   RowBox[{"\[Alpha]", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[Gamma]"}], " ", 
      RowBox[{"\[Delta]t", " ", "/", "2"}]}]]}], "]"}]}]], "Input",
 CellLabel->"In[15]:=",
 CellID->839352606,ExpressionUUID->"261555a4-f829-1145-a43b-d82edf45381b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[15]=",
 CellID->911456096,ExpressionUUID->"b9ff8c77-3ea4-a441-8423-6bb3324767f9"]
}, Open  ]],

Cell["\<\
The cat state \[OpenCurlyDoubleQuote]reduces\[CloseCurlyDoubleQuote]  during \
the no-jump evolution (the amplitude decays)\
\>", "Text",
 CellID->125471884,ExpressionUUID->"d8c9e5bd-34f3-fa4a-922a-69e1ce720c96"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Decoherence", "Subsubsection"]], "Subsection",
 CellChangeTimes->{{3.92711510850239*^9, 3.9271151102255535`*^9}},
 CellID->254189671,ExpressionUUID->"8a427621-f218-634b-8858-20ce39718f53"],

Cell["\<\
It can be defined as the transformation over time of a quantum mechanical \
superposition into a classical statistical mixture, as a result of \
interaction with an environment. As an example, consider  an initial even cat \
state , the cavity-environment state is \
\>", "Text",
 CellChangeTimes->{{3.927119461981594*^9, 3.927119502529274*^9}, {
   3.9271196054061356`*^9, 3.92711963963892*^9}, 3.927199098623513*^9, {
   3.9273722381382866`*^9, 3.927372274246418*^9}, {3.9349733267215385`*^9, 
   3.934973354274437*^9}, {3.934973601798282*^9, 3.934973603041956*^9}, {
   3.934973648651085*^9, 3.9349736600206776`*^9}, 3.934973948341749*^9, {
   3.934973990135414*^9, 3.93497399105969*^9}, {3.934974026262705*^9, 
   3.934974040091999*^9}, {3.934974074728485*^9, 3.93497409603269*^9}, {
   3.934974270851897*^9, 3.934974278308375*^9}, 3.9681760957621*^9, {
   3.972727537577734*^9, 3.9727275380138226`*^9}},
 CellID->597432481,ExpressionUUID->"472e8874-4fc1-fb40-922e-6852f43ee5fd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{Cell["|",ExpressionUUID->"cd8a2f08-8f10-2346-8da2-cbc02e2b5346"], 
    RowBox[{"\[Psi]", "(", "0", ")"}], Cell[
    "\[RightAngleBracket]",ExpressionUUID->
     "40de0a05-0a00-5942-ad8e-d3f1a7965058"]}], "\[Proportional]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"|", "\[Alpha]", "\[RightAngleBracket]"}], "+", 
      RowBox[{"|", 
       RowBox[{"-", "\[Alpha]"}], "\[RightAngleBracket]"}]}], ")"}], 
    RowBox[{"|", "\[Epsilon]", "\[RightAngleBracket]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->78314670,ExpressionUUID->"abafb7a9-b2bb-5d4a-9be5-d0e07d07d447"],

Cell["\<\
where |\[Epsilon] \[RightAngleBracket] is the quantum state of the \
environment. The environment can be described  with an arbitrary number of \
systems and states which are not relevant for the analysis. At a later time \
the system will evolve to \
\>", "Text",
 CellID->12252007,ExpressionUUID->"1400cedb-cbd9-5840-bf47-09165228e3d1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{Cell["|",ExpressionUUID->"c062c74d-22d2-504b-88bd-0c76b0face39"], 
    RowBox[{"\[Psi]", "(", "t", ")"}], Cell[
    "\[RightAngleBracket]",ExpressionUUID->
     "b1559636-927a-9340-9ef5-bcadfb16c9fa"]}], "\[Proportional]", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
     Cell["|",ExpressionUUID->"f0b49191-04eb-6e47-8ef8-e2eea8e820e9"], 
      "\[Beta]", Cell[
      "\[RightAngleBracket]",ExpressionUUID->
       "92a61bf5-de1b-3c44-b2fc-789c959ec425"], Cell[
      "|",ExpressionUUID->"3aafd2f9-edc0-2d45-8913-3ae7cdba80e6"], 
      SubscriptBox["\[Epsilon]", "1"], Cell[
      "\[RightAngleBracket]",ExpressionUUID->
       "3a08b760-7e55-5d41-9f93-64759fbeb28a"]}], "+", Cell[
     "|",ExpressionUUID->"a530c663-0b8d-854b-a46a-f349e3fbbbfc"], "-", 
     RowBox[{
     "\[Beta]", Cell[
      "\[RightAngleBracket]",ExpressionUUID->
       "ecd8bba2-a49f-a249-95ee-13b754a20681"], Cell[
      "|",ExpressionUUID->"3a16e239-6503-b14c-baa5-4a880b2e4486"], 
      SubscriptBox["\[Epsilon]", "2"], Cell[
      "\[RightAngleBracket]",ExpressionUUID->
       "6806e40b-3729-d343-a43e-68b01b58bc86"]}]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->297145891,ExpressionUUID->"3947563a-9c77-2a46-812b-80e45dd15ff0"],

Cell[TextData[{
 "such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "=", 
    RowBox[{"\[Alpha]", " ", 
     SuperscriptBox["e", 
      RowBox[{
       RowBox[{"-", "\[Gamma]"}], " ", "t", "/", "2"}]]}]}], 
   TraditionalForm]], "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{3.9859500928354225`*^9, 3.9859501562502766`*^9},
  ExpressionUUID->"8432f889-1244-df40-9cce-485dfd35aeed"],
 "   from the previous section, so that the field becomes entangled with the \
environment. If we compute the density operator and trace over a complete set \
of states of the environment ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     SubscriptBox["\[Epsilon]", "i"], "|", 
     SubscriptBox["\[Epsilon]", "j"], "\[RightAngleBracket]"}], "=", 
    SubscriptBox["\[Delta]", 
     RowBox[{"i", "j"}]]}], TraditionalForm]], "DisplayFormula",
  GeneratedCell->True,
  CellAutoOverwrite->True,
  CellChangeTimes->{3.9859500928354225`*^9, 3.9859501562502766`*^9},
  ExpressionUUID->"e25377dd-3737-ee43-b225-ee030e5de7a1"],
 ", we get a reduced field density operator"
}], "Text",
 CellID->335892180,ExpressionUUID->"63b59423-f3ef-a54e-9417-602e97d13d39"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Rho]", "F"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["Tr", "Env"], 
     RowBox[{"\[Rho]", "(", "t", ")"}]}], "=", 
    RowBox[{
     RowBox[{
      UnderscriptBox[
       StyleBox["\[Sum]",
        FontSize->18,
        FontWeight->"Bold"], "i"], 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        SubscriptBox["\[Epsilon]", "i"], "|", "\[Rho]", "|", 
        SubscriptBox["\[Epsilon]", "i"]}], "\[RightAngleBracket]"}]}], "=", 
     RowBox[{
      RowBox[{
      Cell["|",ExpressionUUID->"92903cf2-a580-9f41-9887-7dd7d29837c2"], 
       RowBox[{"\[Beta]", "(", "t", ")"}], Cell[
       "\[RightAngleBracket]",ExpressionUUID->
        "8a5855f6-b9ea-0a45-9d87-8f97a2c34d70"], Cell[
       "\[LeftAngleBracket]",ExpressionUUID->
        "2039c114-cf31-8445-8d49-261dd47737aa"], 
       RowBox[{"\[Beta]", "(", "t", ")"}], Cell[
       "|",ExpressionUUID->"16772f61-0b8f-e742-bf8a-a5ea3ad3aee7"]}], "+", 
      Cell["|",ExpressionUUID->"3372c46f-6552-0b4f-8681-fdefabc3a3f9"], "-", 
      RowBox[{
       RowBox[{"\[Beta]", "(", "t", ")"}], Cell[
       "\[RightAngleBracket]",ExpressionUUID->
        "3d1d8fd7-638d-7745-9c55-74e4446ba9c7"], Cell[
       "\[LeftAngleBracket]",ExpressionUUID->
        "08bc41b6-1f77-2c49-b596-d190a4bdf1c1"]}], "-", 
      RowBox[{
       RowBox[{"\[Beta]", "(", "t", ")"}], Cell[
       "|",ExpressionUUID->"6b2e47d1-9a2d-db4f-9bcf-2135e1cf656f"]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->48988055,ExpressionUUID->"93e55230-6288-b245-9b1f-87652c5a8a05"],

Cell["is a statistical mixture of two coherent states", "Text",
 CellChangeTimes->{{3.927119461981594*^9, 3.927119502529274*^9}, {
   3.9271196054061356`*^9, 3.92711963963892*^9}, 3.927199098623513*^9, {
   3.9273722381382866`*^9, 3.927372274246418*^9}, {3.9349733267215385`*^9, 
   3.934973354274437*^9}, {3.934973601798282*^9, 3.934973603041956*^9}, {
   3.934973648651085*^9, 3.9349736600206776`*^9}, 3.934973948341749*^9, {
   3.934973990135414*^9, 3.93497399105969*^9}, {3.934974026262705*^9, 
   3.934974040091999*^9}, {3.934974074728485*^9, 3.93497409603269*^9}, {
   3.934974270851897*^9, 3.934974278308375*^9}, {3.9681761096623936`*^9, 
   3.968176145114975*^9}},
 CellID->29256280,ExpressionUUID->"58dc1ab2-a3ba-3b40-9b51-f07e8e8aad29"],

Cell[CellGroupData[{

Cell["Quantum jump implementation", "Subsubsection",
 CellID->334214273,ExpressionUUID->"2c51ffa1-d19c-d540-8264-7a6c07d794c9"],

Cell["\<\
Let\[CloseCurlyQuote]s implement the quantum jump algorithm of the previous \
section, the quantum jump algorithm is also known in literature as the Monte \
Carlo wave function (MCWF) method. This will also give more intuition about \
why that exponential decay factor appears in the equations\
\>", "Text",
 CellID->713802472,ExpressionUUID->"dd58aff9-d3fa-7c42-937b-3ddf927310ed"],

Cell["Setup simulation parameters:", "Text",
 CellID->2804768,ExpressionUUID->"3fe2b096-1675-5a44-8d18-9fe8da5712a9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dim", "=", "8"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Gamma]", "=", "0.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]t", "=", "0.01"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"steps", "=", "600"}], ";"}]}], "Input",
 CellLabel->"In[120]:=",
 CellID->142665299,ExpressionUUID->"786343a1-151c-eb48-956a-677b70ca5050"],

Cell["Annihilation and number operators:", "Text",
 CellID->272567781,ExpressionUUID->"043d107b-c025-9b45-9c32-e76a529f8f63"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"aOp", "=", 
   RowBox[{
    RowBox[{"AnnihilationOperator", "[", "dim", "]"}], "[", "\"\<Matrix\>\"", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nOp", "=", 
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", "aOp", "]"}], ".", " ", "aOp"}]}], " ",
   ";"}]}], "Input",
 CellLabel->"In[181]:=",
 CellID->263149352,ExpressionUUID->"7cf466fc-2548-3f4c-a409-f2ebf64e79a4"],

Cell["\<\
Define the non-Hermitian Hamiltonian, we assume pure dissipation so the \
coherent Hamiltonian is zero:\
\>", "Text",
 CellID->238074833,ExpressionUUID->"34b99bc2-b678-d84e-a6b4-ae5fd023a120"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Heff", "=", 
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    RowBox[{"(", 
     RowBox[{"\[Gamma]", "/", "2"}], ")"}], " ", "nOp"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"U0", "=", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "Heff", " ", "\[Delta]t"}], "]"}]}],
   ";"}]}], "Input",
 CellLabel->"In[183]:=",
 CellID->27107353,ExpressionUUID->"7d14dc9c-ba0d-0141-ac40-a09ce567484c"],

Cell["Consider as an initial state |4\[RightAngleBracket]:", "Text",
 CellID->226089447,ExpressionUUID->"bfc58cf1-f160-3f4b-a28a-39ee5b20d1f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]Initial", "=", 
   RowBox[{
    RowBox[{"FockState", "[", 
     RowBox[{"4", ",", "dim"}], "]"}], "[", "\"\<StateVector\>\"", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[185]:=",
 CellID->103952789,ExpressionUUID->"3229d041-3f5e-0748-9e6a-5fb3baac2f7f"],

Cell["\<\
Implement the jump function, based on the algorithm that was described before:\
\>", "Text",
 CellID->64213134,ExpressionUUID->"6b8b5104-8cfc-3b4a-8fc4-22e8585a6244"],

Cell[BoxData[
 RowBox[{
  RowBox[{"takeStep", "[", "\[Psi]_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[CapitalDelta]P", ",", "\[Psi]New"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[CapitalDelta]P", "=", 
      RowBox[{"\[Gamma]", " ", "\[Delta]t", " ", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "\[Psi]", "]"}], ".", "nOp", ".", 
         "\[Psi]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"RandomReal", "[", "]"}], "<", "\[CapitalDelta]P"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "JUMP", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"\[Psi]New", "=", 
        RowBox[{"aOp", ".", "\[Psi]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"NO", " ", "JUMP"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"\[Psi]New", "=", 
        RowBox[{"U0", ".", "\[Psi]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Psi]New", "/", 
      RowBox[{"Norm", "[", "\[Psi]New", "]"}]}]}]}], "]"}]}]], "Input",
 CellLabel->"In[186]:=",
 CellID->178393227,ExpressionUUID->"b26f7d0e-df00-b847-96c6-260e199a5746"],

Cell["\<\
Run the quantum jump algorithm for 1000 trajectories, and track the mean \
photon number for each trajectory and calculate the average of all \
trajectories:\
\>", "Text",
 CellID->44466164,ExpressionUUID->"a1895949-746b-2141-9726-31d2065e5926"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numTrajectories", "=", "1000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Simulating \>\"", ",", "numTrajectories", 
    ",", "\"\< trajectories...\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allTrajectories", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"NestList", "[", 
      RowBox[{"takeStep", ",", "\[Psi]Initial", ",", "steps"}], "]"}], ",", 
     RowBox[{"{", "numTrajectories", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Simulation completed. \>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allPhotonNumbers", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"traj", ",", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{
            RowBox[{"Conjugate", "[", "#", "]"}], ".", "nOp", ".", "#"}], 
           "]"}], "&"}], ",", "traj"}], "]"}]}], "]"}], ",", 
     "allTrajectories"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"averagePhotonNumbers", "=", 
   RowBox[{"Mean", "[", "allPhotonNumbers", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[187]:=",
 CellID->236121256,ExpressionUUID->"6e37b494-7d27-3f4a-999f-49af3f838f22"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Simulating \"\>", "\[InvisibleSpace]", "1000", 
   "\[InvisibleSpace]", "\<\" trajectories...\"\>"}],
  SequenceForm["Simulating ", 1000, " trajectories..."],
  Editable->False]], "Print",
 CellLabel->"During evaluation of In[187]:=",
 CellID->244649460,ExpressionUUID->"7a3034d3-cbf3-3940-b40d-52b49a384887"],

Cell[BoxData["\<\"Simulation completed. \"\>"], "Print",
 CellLabel->"During evaluation of In[187]:=",
 CellID->183012361,ExpressionUUID->"cba3b48b-5ed5-ec4b-86a1-503ae214a4bf"]
}, Open  ]]
}, Open  ]],

Cell["Plot the results of every trajectory:", "Text",
 CellID->248802574,ExpressionUUID->"05161766-4eb2-9148-8229-40e0298db5fc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLinePlot", "[", 
    RowBox[{"allPhotonNumbers", ",", 
     InterpretationBox[
      DynamicModuleBox[{Typeset`open = False}, 
       TemplateBox[{"Expression", "SequenceIcon", 
         GridBox[{{
            RowBox[{
              TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["Sequence", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["4", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Byte count: \"", "IconizedLabel"], 
              "\[InvisibleSpace]", 
              TagBox["592", "IconizedItem"]}]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
          "Column", 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
         Dynamic[Typeset`open]},
        "IconizedObject"]],
      Sequence[
      DataRange -> {0, $CellContext`steps $CellContext`\[Delta]t}, PlotStyle -> 
       Directive[
         Opacity[0.8], Thin], ImageSize -> 400, ColorFunction -> "Rainbow"],
      SelectWithContents->True,
      Selectable->False]}], "]"}], ",", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{"averagePhotonNumbers", ",", 
     InterpretationBox[
      DynamicModuleBox[{Typeset`open = False}, 
       TemplateBox[{"Expression", "SequenceIcon", 
         GridBox[{{
            RowBox[{
              TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["Sequence", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["3", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Byte count: \"", "IconizedLabel"], 
              "\[InvisibleSpace]", 
              TagBox["600", "IconizedItem"]}]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
          "Column", 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
         Dynamic[Typeset`open]},
        "IconizedObject"]],
      Sequence[
      DataRange -> {0, $CellContext`steps $CellContext`\[Delta]t}, PlotStyle -> 
       Directive[Thick, Black], PlotLegends -> {
         Style["Trajectory Time Average (N=1000)", 11]}],
      SelectWithContents->True,
      Selectable->False]}], "]"}], ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["6", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["1576", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
     Plot[
     4 Exp[(-$CellContext`\[Gamma]) $CellContext`t], {$CellContext`t, 
       0, $CellContext`steps $CellContext`\[Delta]t}, PlotStyle -> 
      Directive[Thick, Dashed, 
        ColorData[97][7]], PlotLegends -> {
        Style["Analytical", 11]}], PlotRange -> {0, 4.2}, 
     FrameLabel -> {
      "Time t", 
       "Expected Photon Number \[LeftAngleBracket]n\[RightAngleBracket]"}, 
     PlotTheme -> "Detailed", Frame -> True, LabelStyle -> 12],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellLabel->"In[194]:=",
 CellID->998308450,ExpressionUUID->"8ffb4669-b6cf-fc44-bb66-cad9ecd85934"],

