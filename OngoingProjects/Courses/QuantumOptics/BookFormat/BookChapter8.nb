Cell[TextData[StyleBox["Helper rules  for simplification of inactive \
differential equations:", "CodeText"]], "Text",
 CellID->61020656,ExpressionUUID->"b6204c43-908d-c541-9b35-dfd52b947c02"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rulesFP", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      TemplateBox[{"Inactive", "0", "__"},
       "InactiveD"], "\[RuleDelayed]", "0"}], ",", 
     RowBox[{
      RowBox[{"-", 
       TemplateBox[{"Inactive", "arg_", "var_Symbol"},
        "InactiveD"]}], "\[RuleDelayed]", 
      TemplateBox[{"Inactive", 
        RowBox[{"Simplify", "[", 
          RowBox[{"-", "arg"}], "]"}], "var"},
       "InactiveD"]}], ",", 
     RowBox[{
      RowBox[{
       TemplateBox[{"Inactive", 
         RowBox[{"(", 
           RowBox[{"c_", " ", 
             RowBox[{"(", 
               RowBox[{"P", ":", 
                 RowBox[{"\[FormalP]", "[", "__", "]"}]}], ")"}]}], ")"}], 
         "v1_Symbol", "v2_Symbol"},
        "InactiveD"], "/;", 
       RowBox[{
        RowBox[{"FreeQ", "[", 
         RowBox[{"c", ",", "v1"}], "]"}], "&&", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"c", ",", "v2"}], "]"}]}]}], "\[RuleDelayed]", 
      RowBox[{"c", " ", 
       TemplateBox[{"Inactive", "P", "v1", "v2"},
        "InactiveD"]}]}]}], "}"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[124]:=",
 CellID->135947433,ExpressionUUID->"8dd521a4-64ee-054e-b661-09b58f6c6eff"]
}, Open  ]],

