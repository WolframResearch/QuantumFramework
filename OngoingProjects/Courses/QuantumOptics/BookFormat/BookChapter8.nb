Cell["\<\
We can also simulate the evolution for different values of \[Kappa] to see \
how it affects the convergence of the state\
\>", "Text",
 CellID->121436293,ExpressionUUID->"33e7a13f-43f7-024b-ac1c-a0660bb9698b"],

Cell["Compute evolved states varying \[Kappa]:", "Text",
 CellID->238197292,ExpressionUUID->"ac2f5e16-f27a-014a-95c5-c0ea0be2aeaa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evolved", " ", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"\[ScriptCapitalL]", "[", 
         RowBox[{"1", ",", "k", ",", "3"}], "]"}]}], ",", 
       RowBox[{"FockState", "[", "0", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tf"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"{", 
        RowBox[{"0.5", ",", "1.", ",", "1.5"}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[329]:=",
 CellID->960822721,ExpressionUUID->"8c341d8c-aad0-3144-a186-187e1b2e6592"],

Cell[TextData[StyleBox["Calculate again the mean number of photons:", \
"Text"]], "CodeText",
 CellChangeTimes->{{3.9681794774763184`*^9, 3.9681794946263046`*^9}},
 CellID->101871630,ExpressionUUID->"e6e07942-ce8f-6f40-bfbe-5547ef74a6ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"meanPhotons", " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"Dot", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", 
             RowBox[{"$FockSize", "-", "1"}]}], "]"}], ",", 
           RowBox[{"Diagonal", "[", 
            RowBox[{
             RowBox[{"#", "[", "t", "]"}], "[", "\"\<DensityMatrix\>\"", 
             "]"}], "]"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tf", ",", "0.01"}], "}"}]}], "]"}], 
     "&"}], "/@", "evolved"}]}], ";"}]], "Input",
 CellLabel->"In[330]:=",
 CellID->198526507,ExpressionUUID->"d26f8340-0dbb-d640-b565-f3c11059952a"],

Cell[TextData[StyleBox["Plot the curves, we see change in the rate of \
convergence such that higher \[Kappa] converges faster:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681796167739162`*^9, 3.9681796669296303`*^9}, {
  3.968179861658346*^9, 3.96817986334622*^9}},
 CellID->310513308,ExpressionUUID->"9d94f962-3e70-4d4f-bf45-8627978aaa32"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"meanPhotons", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["5", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["1176", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[PlotRange -> {0, 3.8}, Epilog -> {
       Style[
        Line[{{0, 3}, {10, 3}}], Dashed, Red]}, 
     PlotLegends -> {"\[Kappa] = 0.5", "\[Kappa] = 1.", "\[Kappa] = 1.5"}, 
     AxesLabel -> {"Time (a.u)", "Number of photons"}, LabelStyle -> 13],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
