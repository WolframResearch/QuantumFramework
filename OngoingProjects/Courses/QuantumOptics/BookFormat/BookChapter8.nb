Cell[TextData[{
 "Clearly the steady-state behavior is that the field mean number of photons \
converges to ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "\[LongDash]"], TraditionalForm]],ExpressionUUID->
  "8f270957-2697-6646-8834-f01418e348b9"],
 ":"
}], "Text",
 CellID->27344759,ExpressionUUID->"43f7975a-666d-fc40-9977-5706b58be998"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     OverscriptBox["n", "_"], ">=", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]", ">", "0"}]}], ",", 
   RowBox[{
    UnderscriptBox["\[Limit]", 
     RowBox[{"t", "\[Rule]", "\[Infinity]"}]], "%"}]}], "]"}]], "Input",
 CellLabel->"In[99]:=",
 CellID->46887221,ExpressionUUID->"a914197a-ea57-7d40-b12c-ac8e921f7372"],

Cell[BoxData[
