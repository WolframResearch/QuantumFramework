Cell["Generate a uniform superposition state:", "SolutionAnswer",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->956824479,ExpressionUUID->"4ebf92fc-ad5b-4dbd-aaca-6bdbbfaad20b"],

Cell["\[Rho] = QuantumState[\"UniformSuperposition\",$FockSize];", \
"ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[8]:=",
 CellID->1980263083,ExpressionUUID->"4c9817d8-7956-4458-ba07-2fc8078fae73"],

Cell[TextData[{
 "Dephasing can be modelled with the jump operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "\[Dagger]"], "a"}], TraditionalForm]],ExpressionUUID->
  "dd3b744a-aa91-488e-bdf0-c68760fed474"],
 ":"
}], "SolutionAnswer",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->1199198005,ExpressionUUID->"29b0069f-cc24-4148-8edf-8ea7bad39b6d"],

Cell["\<\
\[ScriptCapitalL] = QuantumOperator[\"Liouvillian\"[ None,{a[\"Dagger\"]@a},{\
\[Kappa]\[Phi]}],\"Parameters\"->{\[Kappa]\[Phi]}];\
\>", "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[9]:=",
 CellID->2026507447,ExpressionUUID->"33946a44-2121-4776-86ff-6bc3f7550efc"],

Cell["Evolution of the state:", "SolutionAnswer",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->904239267,ExpressionUUID->"1982ae17-7817-43d0-80de-223f51073256"],

Cell["evolved =QuantumEvolve[\[ImaginaryI] \[ScriptCapitalL][0.2], \
\[Rho],{t,0,10}];", "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[10]:=",
 CellID->1466593197,ExpressionUUID->"57f3b5c2-e5fe-42f4-ab2d-61342e2e4234"],

Cell["Get frames:", "SolutionAnswer",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellID->318319006,ExpressionUUID->"c3315b5c-20a6-44c8-8a2e-f7c0a16e1dc0"],

Cell["\<\
frames = Table[MatrixPlot[evolved[t][\"DensityMatrix\"],ColorFunction->\"\
RedBlueTones\",PlotLegends->All, PlotLabel->StringForm[\"t = \
``\",Round[t,0.01]],ImageSize->300,ImageMargins->20,LabelStyle->13],{t,10^-6,\
5,0.1}];\
\>", "ExerciseInput",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellLabel->"In[11]:=",
