 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "1"], "=", 
    RowBox[{
     SubscriptBox["\[Gamma]", "2"], "=", "0.5"}]}], TraditionalForm]],
  ExpressionUUID->"84bda1f2-d95b-2742-80a2-31f14d30f802"],
