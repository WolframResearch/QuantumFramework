            TagBox["568", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    Mesh -> All, AxesLabel -> {"t (Time)", "Fidelity"}, MeshStyle -> {Black, 
       PointSize[0.01]}, LabelStyle -> 13],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellChangeTimes->{{3.927297566890438*^9, 3.927297571272457*^9}, {
