Cell[CellGroupData[{

Cell["Kerr effect: truncated Wigner approximation", "Subsubsection",
 CellID->20909599,ExpressionUUID->"ccbd7fd0-8db3-3d48-a3d0-56ce71b65f19"],

Cell[TextData[{
 "So far every FPE stopped at second order, so the Langevin description was \
exact. However, take the Kerr oscillator ",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", "=", 
    RowBox[{"\[Chi]", " ", 
     SuperscriptBox[
      SuperscriptBox["a", "\[Dagger]"], "2"], 
     SuperscriptBox["a", "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f9f11877-04ce-fe40-8d00-617c22d967c5"],
 " whose commutator  is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    RowBox[{"\[Chi]", "(", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SuperscriptBox["a", "\[Dagger]"], "2"], 
       SuperscriptBox["a", "2"], "\[Rho]"}], "-", 
      RowBox[{"\[Rho]", " ", 
       SuperscriptBox[
        SuperscriptBox["a", "\[Dagger]"], "2"], 
       SuperscriptBox["a", "2"]}]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1299ca56-ea80-4f4a-9a3c-1a688edd8119"]
}], "Text",
 CellID->685425624,ExpressionUUID->"767edee5-9fb2-e44b-9612-f6396359d3cb"],

Cell["Translating the equation to our formalism:", "Text",
 CellID->750942377,ExpressionUUID->"548e5253-b4fd-424b-9217-2c6c5846a8f7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"kerr", "[", "f_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Chi]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"ad\[Rho]", "[", 
       RowBox[{"ad\[Rho]", "[", 
        RowBox[{"a\[Rho]", "[", 
         RowBox[{"a\[Rho]", "[", "f", "]"}], "]"}], "]"}], "]"}], "-", 
      RowBox[{"\[Rho]a", "[", 
       RowBox[{"\[Rho]a", "[", 
        RowBox[{"\[Rho]ad", "[", 
         RowBox[{"\[Rho]ad", "[", "f", "]"}], "]"}], "]"}], "]"}]}], 
     ")"}]}]}], ";"}]], "Input",
 CellLabel->"In[66]:=",
 CellID->287871926,ExpressionUUID->"78eeb3d9-a037-3943-82ef-7a519baece12"],

Cell[TextData[{
 "Obtain the \[OpenCurlyDoubleQuote]Order\[CloseCurlyDoubleQuote] and check \
if the diffusion matrices are positive semidefinite for the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", ",", " ", 
    RowBox[{"W", " ", "and", " ", "P", " ", 
     RowBox[{"representations", ":"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e34561ac-7a3c-9c40-ae37-41bc410aa099"]
}], "Text",
 CellID->85685656,ExpressionUUID->"da8289a2-9608-3f40-9807-80111cf6bd15"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"kramersMoyal", "[", 
     RowBox[{"kerr", ",", "#"}], "]"}], "[", "\"\<Order\>\"", "]"}], "&"}], "/@", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"-", "1"}], ",", "0", ",", "1"}], "}"}]}]], "Input",
 CellLabel->"In[69]:=",
 CellID->685775602,ExpressionUUID->"76b903b5-0b52-e147-9d06-59dcf981b622"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[69]=",
 CellID->100126687,ExpressionUUID->"83553113-8b48-c648-87ea-07b377da0300"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PositiveSemidefiniteMatrixQ", "[", 
    RowBox[{
     RowBox[{"kramersMoyal", "[", 
      RowBox[{"kerr", ",", "#"}], "]"}], "[", "\"\<Diffusion\>\"", "]"}], 
    "]"}], "&"}], "/@", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"-", "1"}], ",", "0", ",", "1"}], "}"}]}]], "Input",
 CellLabel->"In[70]:=",
 CellID->137509931,ExpressionUUID->"53d04a12-c03b-3e44-8849-566ee8df5df3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[70]=",
 CellID->78739483,ExpressionUUID->"4140737d-fb39-4944-aafd-d9bbaf4de741"]
}, Open  ]],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8a79676b-9b6f-6745-8d02-06e08e017a74"],
 " and ",
 Cell[BoxData[
  FormBox["P", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "30122e68-0125-5e48-8ad6-df7bcb089aaa"],
 " equations are second order, but their diffusion matrices are not positive \
semidefinite. The Wigner equation has positive (in fact zero) diffusion, but \
it is third order. A Langevin equation can only carry the first two orders, \
so the difference between the full Wigner equation and the forward equation \
of its ItoProcess is what gets lost"
}], "Text",
 CellID->28776540,ExpressionUUID->"ac142913-8f6a-c344-ab6d-0c36c691c340"],

Cell["Compute that difference:", "Text",
 CellID->193091650,ExpressionUUID->"101eb633-5084-fc49-ae69-6d455fdd5778"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kerrKM", "=", 
   RowBox[{"kramersMoyal", "[", 
    RowBox[{"kerr", ",", "0"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrProc", "=", 
   RowBox[{"langevin", "[", 
    RowBox[{"kerrKM", ",", 
     RowBox[{"{", 
      RowBox[{"x0", ",", "p0"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"s", "=", "0"}], "}"}], ",", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"kerr", "[", 
      RowBox[{"\[FormalP]", "[", 
       RowBox[{"x", ",", "p", ",", "t"}], "]"}], "]"}], "-", 
     RowBox[{"Activate", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"kerrProc", "[", "\"\<KolmogorovForwardEquation\>\"", "]"}], 
       "]"}], "]"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[135]:=",
 CellID->278379501,ExpressionUUID->"2eb06143-9db9-c041-8245-8996993b776d"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "4"], " ", "\[Chi]", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "x"}], " ", 
     RowBox[{
      SuperscriptBox["\[FormalP]", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"0", ",", "3", ",", "0"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"x", ",", "p", ",", "t"}], "]"}]}], "+", 
    RowBox[{"p", " ", 
     RowBox[{
      SuperscriptBox["\[FormalP]", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"1", ",", "2", ",", "0"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"x", ",", "p", ",", "t"}], "]"}]}], "-", 
    RowBox[{"x", " ", 
     RowBox[{
      SuperscriptBox["\[FormalP]", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"2", ",", "1", ",", "0"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"x", ",", "p", ",", "t"}], "]"}]}], "+", 
    RowBox[{"p", " ", 
     RowBox[{
      SuperscriptBox["\[FormalP]", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"3", ",", "0", ",", "0"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"x", ",", "p", ",", "t"}], "]"}]}]}], ")"}]}]], "Output",
 CellLabel->"Out[137]=",
 CellID->392357723,ExpressionUUID->"86a04dcf-7c6b-2d4f-95fa-645332fd383c"]
}, Open  ]],

Cell[TextData[{
 "Which can be reduced to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["\[Chi]", "4"], 
    RowBox[{"(", 
     RowBox[{"p", " ", 
      RowBox[{
       SubscriptBox["\[PartialD]", "x"], 
       RowBox[{"-", "x"}]}], " ", 
      SubscriptBox["\[PartialD]", "p"]}], ")"}], 
    RowBox[{
     SuperscriptBox["\[Del]", "2"], 
     RowBox[{"(", "\[Ellipsis]", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8406fdff-6a35-a143-817e-b750d177235a"],
 " :"
}], "Text",
 CellID->31526083,ExpressionUUID->"e541cda9-55b8-474b-810b-fcfa74559395"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Factor", "[", 
  RowBox[{"%", "/.", "\[VeryThinSpace]", 
   RowBox[{
    RowBox[{
     SuperscriptBox["\[FormalP]", 
      TagBox[
       RowBox[{"(", 
        RowBox[{"i_", ",", "j_", ",", "0"}], ")"}],
       Derivative],
      MultilineFunction->None], "[", 
     RowBox[{"x", ",", "p", ",", "t"}], "]"}], "\[RuleDelayed]", 
    RowBox[{
     SubsuperscriptBox["\"\<\[PartialD]\>\"", "x", "i"], " ", 
     SubsuperscriptBox["\"\<\[PartialD]\>\"", "p", "j"]}]}]}], "]"}]], "Input",
 CellLabel->"In[138]:=",
 CellID->230778387,ExpressionUUID->"9fc54815-3e2d-694f-85db-2c7f27da81e5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"-", 
    FractionBox["1", "4"]}], " ", "\[Chi]", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"x", " ", 
      SubscriptBox["\<\"\[PartialD]\"\>", "p"]}], "-", 
     RowBox[{"p", " ", 
      SubscriptBox["\<\"\[PartialD]\"\>", "x"]}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     SubsuperscriptBox["\<\"\[PartialD]\"\>", "p", "2"], "+", 
     SubsuperscriptBox["\<\"\[PartialD]\"\>", "x", "2"]}], ")"}]}], 
  TraditionalForm]], "Output",
 CellLabel->"Out[138]=",
 CellID->237561721,ExpressionUUID->"08ca366c-45a0-8c4d-a02e-d811fe7a23d8"]
}, Open  ]],

Cell[TextData[{
 "The truncated Wigner approximation (TWA) discards this term. The drift is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", 
    RowBox[{"\[Chi]", "(", 
     RowBox[{
      RowBox[{Cell[TextData[Cell[BoxData[
        FormBox["|", TraditionalForm]],
        FormatType->TraditionalForm,ExpressionUUID->
        "4aac485c-dd79-e040-9423-f0d2bd84be7c"]],ExpressionUUID->
        "78d90230-03dc-c046-980c-e59b04357c70"], "\[Alpha]", 
       SuperscriptBox[Cell[TextData[Cell[BoxData[
         FormBox["|", TraditionalForm]],
         FormatType->TraditionalForm,ExpressionUUID->
         "8d95543c-1b4f-224e-ad15-738978bbeaa2"]],ExpressionUUID->
         "4478b921-7283-244a-9d95-7113d2eb1f12"], "2"]}], "-", "1"}], ")"}], 
    "\[Alpha]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "34d654a0-8072-6249-a667-d551ee94b4c2"],
 "  that grows like |\[Alpha]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[Cell[
    "|",ExpressionUUID->"4aa193ea-4f33-f64e-b070-4a51bb2396f2"], "3"], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40b21b1d-9300-c144-b6c2-0793dc107554"],
 " while the third order coefficient grows like |\[Alpha]|. For large \
amplitudes the truncation is a semiclassical expansion in 1/|\[Alpha]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["|", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a9a0a2f4-e246-c642-8529-a448ff97a57a"]
}], "Text",
 CellID->19133963,ExpressionUUID->"a6d8ef19-20f6-b643-8fe2-fafdb461c827"],

Cell["Express the drift in intensity form:", "Text",
 CellID->75899473,ExpressionUUID->"5cd3af05-6fb9-6040-90e2-89c5fe044dc6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Factor", "[", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dr", "=", 
      FractionBox[
       RowBox[{
        RowBox[{"kerrKM", "[", "\"\<Drift\>\"", "]"}], ".", 
        RowBox[{"{", 
         RowBox[{"1", ",", "\[ImaginaryI]"}], "}"}]}], 
       SqrtBox["2"]]}], "}"}], ",", 
    RowBox[{"dr", "/.", "\[VeryThinSpace]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         SuperscriptBox["p", "2"], "+", 
         SuperscriptBox["x", "2"]}], "\[Rule]", 
        SuperscriptBox[
         RowBox[{"Abs", "[", "\[FormalAlpha]", "]"}], "2"]}], ",", 
       RowBox[{"x", "\[Rule]", 
        RowBox[{
         RowBox[{
          SqrtBox["2"], " ", "\[FormalAlpha]"}], "-", 
         RowBox[{"\[ImaginaryI]", " ", "p"}]}]}]}], "}"}]}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[139]:=",
 CellID->536682867,ExpressionUUID->"4290ef38-5d46-0441-a457-b3e7a744ffd5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"-", "\[ImaginaryI]"}], " ", "\[FormalAlpha]", " ", "\[Chi]", " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      TemplateBox[{"\[FormalAlpha]"},
       "Abs"], "2"], "-", "2"}], ")"}]}], TraditionalForm]], "Output",
 CellLabel->"Out[139]=",
 CellID->48737899,ExpressionUUID->"d224a176-e5c9-824a-8af2-54be2021ca3a"]
}, Open  ]],

Cell[TextData[{
 "Each phase-space point rotates about the origin at a speed set by its own \
intensity\[LineSeparator]Something the TWA gets right is the squeezing. Start \
from a coherent state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", 
     SubscriptBox["\[Alpha]", "0"]}], "\[RightAngleBracket]"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "83587763-05b4-1a4f-a4fd-586cc3da8f25"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "0"], "=", 
    RowBox[{"|", 
     SubscriptBox["\[Alpha]", "0"], 
     SuperscriptBox["|", "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "adbff207-7f0d-e140-9943-10815adb5996"],
 " photons, its Wigner function is a blob with the vacuum noise. Points on \
the outer edge of the disk have more intensity, so they rotate faster than \
points on the inner edge, and the disk is sheared into a tilted ellipse. A \
sheared disk is a squeezed state, some quadrature has less noise than the \
vacuum. In the TWA, though, it comes from nothing more than the initial \
vacuum noise carried along by the classical drift, which is not  lost by the \
truncation"
}], "Text",
 CellID->11018660,ExpressionUUID->"db0110ca-ebb3-6242-88ea-d0fd7c305f89"],

Cell[TextData[{
 "The TWA implementation can be done in three main steps: drawing samples \
from the initial Wigner function, evolving every sample independently with \
the truncated Langevin equation and computing averages say for example \
\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "da0a5b6c-646e-4d44-84e3-75678679f8be"],
 "\[RightAngleBracket]\[TildeTilde] ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Alpha]", "\[LongDash]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f95929b3-598c-f447-ba67-ece13951b363"],
 " or \[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["a", "\[Dagger]"], "a"}], "\[RightAngleBracket]"}], "\[TildeTilde]", 
    RowBox[{
     OverscriptBox[
      SuperscriptBox[
       TemplateBox[{"\[Alpha]"},
        "Abs"], "2"], "_"], "-", 
     RowBox[{"1", "/", "2"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b26d04d0-1436-fc49-a5dd-b4ee6a1bcd58"],
 " "
}], "Text",
 CellID->104882903,ExpressionUUID->"abb1c805-d21e-d142-8058-a0ed48b677d4"],

Cell["Set TWA parameters:", "Text",
 CellID->540033118,ExpressionUUID->"971ae6c5-d6af-b645-bf0c-4d6dad3f4bb4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nTWA", "=", "4000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nSteps", "=", "400"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"chiRule", " ", "=", " ", 
   RowBox[{"\[Chi]", "->", "1"}]}], ";"}]}], "Input",
 CellLabel->"In[293]:=",
 CellID->80738252,ExpressionUUID->"82e6a2f8-532c-5b44-aaa9-d4e3a81ebfd8"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "TWA"], "=", " ", "4000"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "29395230-0cf0-d945-ac72-19a5111fb3d6"],
 " samples, a separate ",
 StyleBox["RandomFunction", "FormattedFunction"],
 " call per sample is slow. Because the noise is additive (a constant ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3cef1482-950b-dd4a-a879-be309c037ca3"],
 "), all samples can be advanced together as one ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", 
    SubscriptBox["n", "TWA"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5ac6592f-7c89-3342-9f3f-1fb18788f8a1"],
 " packed array, with the stochastic Heun step"
}], "Text",
 CellID->6116630,ExpressionUUID->"53cbb67b-c2a6-aa4d-8349-f5840dd85341"],

Cell["TWA helper functions:", "Text",
 CellID->3218104,ExpressionUUID->"fd9a0ab1-b94b-3b40-950a-7bea57126ff7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"drift", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "p_"}], "}"}], "]"}], "=", 
   RowBox[{
    RowBox[{"kerrKM", "[", "\"\<Drift\>\"", "]"}], "/.", "chiRule"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{"MatrixPower", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"kerrKM", "[", "\"\<Diffusion\>\"", "]"}], "/.", " ", 
      "chiRule"}], ",", 
     RowBox[{"1", "/", "2"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"heun", "[", "\[Delta]t_", "]"}], "[", 
    RowBox[{"y_", ",", "\[Delta]w_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"yp", "=", 
       RowBox[{"y", "+", 
        RowBox[{"\[Delta]t", " ", 
         RowBox[{"drift", "[", "y", "]"}]}], "+", 
        RowBox[{"B", ".", "\[Delta]w"}]}]}], "}"}], ",", 
     RowBox[{"y", "+", 
      RowBox[{"\[Delta]t", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"drift", "[", "y", "]"}], "+", 
          RowBox[{"drift", "[", "yp", "]"}]}], ")"}], "/", "2"}]}], "+", 
      RowBox[{"B", ".", "\[Delta]w"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[287]:=",
 CellID->561892907,ExpressionUUID->"60a4e4e2-5796-0c43-a701-f3dde5df73bb"],

Cell[TextData[{
 StyleBox["twaRun", "FormattedFunction"],
 " returns a list of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"nSteps", " ", "+", " ", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5b0eb99f-2dfa-594d-9860-6c56a45b7129"],
 " clouds, one per time step, each a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", " ", 
    SubscriptBox["n", "TWA"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5df04af1-835f-3547-a4b4-5561141732a8"],
 " array holding the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "94422dc7-1767-6a46-b1e1-5c29273a993a"],
 " and ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2913ce18-7ca5-cb41-8eea-77ca5e9a80d1"],
 " of every trajectory"
}], "Text",
 CellID->216726361,ExpressionUUID->"163ee93f-ef2b-a840-8fa4-758ed61084a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"twaRun", "[", 
   RowBox[{"n0_", ",", "tmax_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Delta]t", "=", 
      RowBox[{"tmax", "/", "nSteps"}]}], "}"}], ",", 
    RowBox[{"FoldList", "[", 
     RowBox[{
      RowBox[{"heun", "[", "\[Delta]t", "]"}], ",", 
      RowBox[{"Transpose", "@", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"MultinormalDistribution", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             SqrtBox[
              RowBox[{"2", " ", "n0"}]], ",", "0"}], "}"}], ",", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "2", "]"}], "/", "2"}]}], "]"}], ",",
          "nTWA"}], "]"}]}], ",", 
      RowBox[{"RandomVariate", "[", 
       RowBox[{
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"0", ",", 
          SqrtBox["\[Delta]t"]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"nSteps", ",", "2", ",", "nTWA"}], "}"}]}], "]"}]}], "]"}]}],
    "]"}]}]], "Input",
 CellLabel->"In[290]:=",
 CellID->669729304,ExpressionUUID->"b4e3eee0-ec94-ba43-8b7f-ff78fb6d8994"],

Cell["\<\
Kerr \[OpenCurlyDoubleQuote]exact\[CloseCurlyDoubleQuote] evolution from \
QuantumEvolve using an appropriate truncation size that is big enough to get \
really accurate results:\
\>", "Text",
 CellID->9418652,ExpressionUUID->"ba65cc2a-cc56-3340-9b5d-57dc218fa1b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kerrExact", "[", 
   RowBox[{"n0_", ",", "tmax_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"$FockSize", "=", 
      RowBox[{"Ceiling", "[", 
       RowBox[{"n0", "+", 
        RowBox[{"8", " ", 
         SqrtBox["n0"]}], "+", "15"}], "]"}]}], "}"}], ",", 
    RowBox[{"QuantumEvolve", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox["a", "\[Dagger]"], "@", 
       RowBox[{
        SuperscriptBox["a", "\[Dagger]"], "@", 
        RowBox[{"a", "@", "a"}]}]}], ",", 
      RowBox[{
       RowBox[{"CoherentState", "[", "]"}], "[", 
       SqrtBox[
        RowBox[{"N", "[", "n0", "]"}]], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[291]:=",
 CellID->745556,ExpressionUUID->"6f96ff17-4401-7e4d-81ad-4ea36cb68055"],

Cell["\<\
The quadrature covariance is needed at about 150 instants, so we take the \
quadrature matrices once per dimension and form the moments with the state \
vector:\
\>", "Text",
 CellID->87000339,ExpressionUUID->"12e4f943-af04-7947-a65e-eefac809fa2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"quadratures", "[", "dk_", "]"}], ":=", 
   RowBox[{
    RowBox[{"quadratures", "[", "dk", "]"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"#1", "[", "\"\<Matrix\>\"", "]"}], "&"}], ")"}], "/@", 
     RowBox[{"(", 
      RowBox[{
       SqrtBox["2"], " ", 
       RowBox[{"QuadratureOperators", "[", "dk", "]"}]}], ")"}]}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[275]:=",
 CellID->840606036,ExpressionUUID->"22e2a56f-9a17-8c40-b35a-91379ad0b384"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"quadratureMoments", "[", "\[Psi]_QuantumState", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"v", "=", 
        RowBox[{
         RowBox[{"\[Psi]", "[", "\"\<Normalize\>\"", "]"}], 
         "[", "\"\<StateVector\>\"", "]"}]}], ",", 
       RowBox[{"R", "=", 
        RowBox[{"quadratures", "[", 
         RowBox[{"\[Psi]", "[", "\"\<Dimension\>\"", "]"}], "]"}]}]}], "}"}], 
     ",", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"A", "=", 
         RowBox[{"R", ".", "v"}]}], "}"}], ",", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", "=", 
           RowBox[{"Re", "[", 
            RowBox[{
             RowBox[{"A", "\[Conjugate]"}], ".", "v"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{
              RowBox[{"A", "\[Conjugate]"}], ".", 
              RowBox[{"A", "\[Transpose]"}]}], "]"}], "-", 
            RowBox[{"Outer", "[", 
             RowBox[{"Times", ",", "m", ",", "m"}], "]"}]}]}], "}"}]}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[276]:=",
 CellID->175992929,ExpressionUUID->"38b2f827-fde7-ba48-8924-87a87fcbecd4"],

Cell["Squeezing limit in dB  comparison:", "Text",
 CellID->617378116,ExpressionUUID->"bba162cb-8d97-1d4c-ad80-9ddd3c1f7c00"],

Cell[BoxData[
 RowBox[{
  RowBox[{"squeezing", "[", "c_", "]"}], ":=", 
  RowBox[{"10", " ", 
   RowBox[{"Log10", "[", 
    RowBox[{"2", " ", 
     RowBox[{"Min", "[", 
      RowBox[{"Eigenvalues", "[", "c", "]"}], "]"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[277]:=",
 CellID->201164733,ExpressionUUID->"798f71c6-e26c-3141-b9fc-6fc3d4f8f61e"],

Cell[TextData[{
 "Define run parameters, we use photon number ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["n", "0"], "=", "4"}], ",", "25", ",", "100"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "feff4bd4-c2ae-144d-bc7c-ca8602062cdd"],
 " each up to the same scaled time ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Tau]", "max"], "=", 
    RowBox[{"\[Chi]", " ", "t", " ", 
     SuperscriptBox[
      SubscriptBox["n", "0"], 
      RowBox[{"2", "/", "3"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "26fc8620-f787-f646-a167-72b6e0128df4"],
 ":"
}], "Text",
 CellID->98785517,ExpressionUUID->"9abf916b-5782-d84c-9949-cd907c21d56e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"n0s", "=", 
   RowBox[{"{", 
    RowBox[{"4", ",", "25", ",", "100"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Tau]max", "=", "1."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nExact", "=", "100"}], ";"}]}], "Input",
 CellLabel->"In[306]:=",
 CellID->150749285,ExpressionUUID->"594d91dc-6b7f-8b47-a8b3-52a3b51b614d"],

Cell["Compute the squeezing curves:", "Text",
 CellID->16960514,ExpressionUUID->"ee34ba85-12e3-aa4e-8739-1a5619d98581"],

Cell[BoxData[
 RowBox[{
  RowBox[{"runs", "=", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"twaRun", "[", 
         RowBox[{"#1", ",", 
          RowBox[{"\[Tau]max", " ", 
           SuperscriptBox["#1", 
            RowBox[{
             RowBox[{"-", "2"}], "/", "3"}]]}]}], "]"}], ",", 
        RowBox[{"kerrExact", "[", 
         RowBox[{"#1", ",", 
          RowBox[{"\[Tau]max", " ", 
           SuperscriptBox["#1", 
            RowBox[{
             RowBox[{"-", "2"}], "/", "3"}]]}]}], "]"}]}], "}"}], "&"}], ",", 
     "n0s"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[309]:=",
 CellID->471542020,ExpressionUUID->"c79491bc-a6ae-ac46-a5a4-57976a0ee279"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"squeezingCurves", "[", 
    RowBox[{"n0_", ",", 
     RowBox[{"{", 
      RowBox[{"clouds_", ",", "exact_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tmax", "=", 
       RowBox[{"\[Tau]max", " ", 
        SuperscriptBox["n0", 
         RowBox[{
          RowBox[{"-", "2"}], "/", "3"}]]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Subdivide", "[", 
           RowBox[{"0", ",", "\[Tau]max", ",", "nSteps"}], "]"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"squeezing", "[", 
              RowBox[{"Covariance", "[", 
               RowBox[{"Transpose", "[", "#1", "]"}], "]"}], "]"}], "&"}], 
            ")"}], "/@", "clouds"}]}], "}"}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Tau]", " ", 
            SuperscriptBox["n0", 
             RowBox[{"2", "/", "3"}]]}], ",", 
           RowBox[{"squeezing", "[", 
            RowBox[{"Last", "[", 
             RowBox[{"quadratureMoments", "[", 
              RowBox[{"exact", "[", "\[Tau]", "]"}], "]"}], "]"}], "]"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Tau]", ",", "0", ",", "tmax", ",", 
           FractionBox["tmax", "nExact"]}], "}"}]}], "]"}]}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"curves", "=", 
   RowBox[{"KeyValueMap", "[", 
    RowBox[{"squeezingCurves", ",", "runs"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[310]:=",
 CellID->250187661,ExpressionUUID->"4306e790-31ae-9143-88c2-b36aa72e0fea"],

Cell["Visualize the curves:", "Text",
