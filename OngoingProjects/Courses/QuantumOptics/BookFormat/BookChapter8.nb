Cell[CellGroupData[{

Cell[TextData[StyleBox["Decoherence of an even cat state : becoming \
statistical mixture", "Subsubsection"]], "Subsubsection",
 CellID->919007720,ExpressionUUID->"7fb878c5-4c4d-774c-a5d1-027d6e099484"],

Cell["Set up the cutoff:", "Text",
 CellID->214170899,ExpressionUUID->"c79473b4-e453-274b-a5b9-e1e4771a7734"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "15", "]"}], ";"}]], "Input",
 CellLabel->"In[286]:=",
 CellID->495791414,ExpressionUUID->"2125b5cb-ae1d-e24c-af21-3b8cea24c805"],

Cell[TextData[{
 "Now we analyze the evolution of  a cavity prepared initially with an even \
cat state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "\[Alpha]", "|"}], "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "141274b0-340d-1743-8b5a-4c391fff6c7c"],
 " :"
}], "Text",
 CellID->166972728,ExpressionUUID->"bfcb0ef9-c595-de4d-86d0-24b72f781ae1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Alpha]coh", "=", 
   RowBox[{"2", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"2", " ", "\[Pi]"}]}], "}"}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]0", "=", 
   RowBox[{
    RowBox[{"CatState", "[", "]"}], "[", 
    RowBox[{"\[Alpha]coh", ",", "0"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[251]:=",
 CellID->511004614,ExpressionUUID->"5c692902-2b18-ae48-a5c3-8effa1a70bf7"],

Cell[TextData[{
 StyleBox["Setting a pure decoherence master equation with photon loss ", 
  "Text"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"H", " ", "=", " ", "0"}], ")"}], TraditionalForm]], "Text",
  ExpressionUUID->"5b80f6b4-42e6-3043-a985-34b041d76481"], "Text"],
 StyleBox[":", "Text"]
}], "CodeText",
 CellChangeTimes->{3.9542373229074497`*^9},
 CellID->120722660,ExpressionUUID->"68a3b10f-e3e3-e347-a27f-dc511dee8255"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Gamma]", " ", "=", " ", "0.9"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalL]", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Liouvillian\>\"", "[", 
     RowBox[{"None", ",", 
      RowBox[{"{", "a", "}"}], ",", 
      RowBox[{"{", "\[Gamma]", "}"}]}], "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.932644514180347*^9, 3.932644518356388*^9}, 
   3.9542373455684147`*^9, {3.954237635586134*^9, 3.9542376361168365`*^9}, {
   3.9542377043768883`*^9, 3.9542377045963993`*^9}, {3.9542377894724617`*^9, 
   3.9542377928106213`*^9}},
 CellLabel->"In[253]:=",
 CellID->494841938,ExpressionUUID->"71876232-7bb5-114c-a972-ae6271574db7"],

Cell["Evolving the state:", "Text",
 CellChangeTimes->{3.954237365722187*^9},
 CellID->128927315,ExpressionUUID->"9a395cdd-eb12-bf40-9f85-7ea27b5c33d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]t", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", "\[ScriptCapitalL]"}], ",", " ", "\[Rho]0",
      ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.927280437828266*^9, 3.927280439298519*^9}, {
   3.927282027117544*^9, 3.927282027537857*^9}, {3.927283719429913*^9, 
   3.9272837197936726`*^9}, 3.927295731163153*^9, 3.927299048549156*^9, {
   3.927300321375759*^9, 3.927300324789458*^9}, {3.93264435399258*^9, 
   3.932644360561107*^9}, {3.935057535032896*^9, 3.935057536802294*^9}, {
   3.9542373725457783`*^9, 3.954237377109621*^9}},
 CellLabel->"In[255]:=",
 CellID->200162597,ExpressionUUID->"28d65bca-664a-e243-88d0-f5398e95e47b"],

Cell[TextData[{
 "Monitoring how the traces change. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Tr", "[", 
     SuperscriptBox[
      OverscriptBox["\[Rho]", "^"], "2"], "]"}], "is", " ", "related", " ", 
    "to", " ", "the", " ", "purity", " ", "and", " ", "also", " "}], 
   TraditionalForm]],ExpressionUUID->"db244296-80cc-3f49-924c-30ef02c5243f"],
 "a measure of decoherence. But there will be a turning point that purity \
starts to increase after decreasing, because the decay in energy makes state \
converge towards the vacuum (pure state) : "
}], "Text",
 CellID->514575331,ExpressionUUID->"da1b0edb-136c-854b-a624-832b41cfc780"],

Cell[TextData[StyleBox["Sampling time:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681773430818157`*^9, 3.9681773449192543`*^9}},
 CellID->751424305,ExpressionUUID->"acf14e6a-8d13-3949-a076-397a80c067cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"time", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "10", ",", "0.01"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.954237522601883*^9},
 CellLabel->"In[256]:=",
 CellID->838520989,ExpressionUUID->"1a96c5c6-05e7-b043-8ba3-d33b703f1e78"],

Cell[TextData[StyleBox["Compute trace and purity:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681773489423523`*^9, 3.968177350927273*^9}, {
  3.972732810660866*^9, 3.972732814305691*^9}},
 CellID->245425477,ExpressionUUID->"93682ce8-40bc-7348-a02b-6303e4902427"],

Cell[BoxData[
 RowBox[{
  RowBox[{"traces", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{"\[Rho]t", "[", "t", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"\[Rho]t", "[", "t", "]"}], "[", "\"\<Purity\>\"", "]"}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "time"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.927280677742232*^9, 3.927280909040521*^9}, {
   3.927280941508679*^9, 3.927281004096339*^9}, {3.9272810483164053`*^9, 
   3.927281120774433*^9}, {3.927281246275645*^9, 3.927281258091572*^9}, {
   3.92728137774144*^9, 3.9272814424750047`*^9}, {3.92728236265637*^9, 
   3.927282365240883*^9}, {3.9272837317231255`*^9, 3.927283747610948*^9}, 
   3.927283984491731*^9, {3.9542375433252544`*^9, 3.954237576219116*^9}},
 CellLabel->"In[257]:=",
 CellID->18230427,ExpressionUUID->"18186959-bae0-924f-a89b-9eb3586d8a5c"],

Cell[TextData[StyleBox["Plot result:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9681773545379715`*^9, 3.9681773566662846`*^9}},
 CellID->150860384,ExpressionUUID->"d12b752d-9e04-f849-a89e-7fba5024e6a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{"time", ",", "#"}], "}"}], "]"}], "&"}], "/@", 
    RowBox[{"Transpose", "[", "traces", "]"}]}], "\n", ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["5", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["920", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    PlotLegends -> {
      "Tr[\[Rho]]", "Tr[\!\(\*SuperscriptBox[\(\[Rho]\), \(2\)]\)]"}, 
     FrameLabel -> {"Time", ""}, Frame -> True, PlotRange -> {0, 1.1}, 
     PlotStyle -> {
       Opacity[1.], 
       Opacity[0.7]}],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellChangeTimes->{{3.927283995944788*^9, 3.927284124690935*^9}, {
   3.927284156941632*^9, 3.927284185490423*^9}, {3.9272999067967834`*^9, 
   3.9272999092153873`*^9}, {3.954238124499134*^9, 3.954238223473612*^9}, {
