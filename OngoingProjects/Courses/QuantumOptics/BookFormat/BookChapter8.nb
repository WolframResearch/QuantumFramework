Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"t", " ", "\[Gamma]"}], "2"]}]], " ", "x0"}], ",", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"t", " ", "\[Gamma]"}], "2"]}]], " ", "p0"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "t"}], " ", "\[Gamma]"}]], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"t", " ", "\[Gamma]"}]]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", 
           OverscriptBox["n", "_"]}]}], ")"}]}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "t"}], " ", "\[Gamma]"}]], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"t", " ", "\[Gamma]"}]]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", 
           OverscriptBox["n", "_"]}]}], ")"}]}]}], "}"}]}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[128]=",
 CellID->645262952,ExpressionUUID->"6c378e64-ff4b-5c4b-93eb-1fe01822e54a"]
}, Open  ]],

Cell[TextData[{
 "To get a quantum expectation value we also average over the initial Wigner \
function. For a coherent state ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox["\[Alpha]", "0"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "910ad0a9-6ef9-6b48-a718-0fd195f6a5d9"],
 "\[RightAngleBracket] that is a Gaussian centered at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["2"], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Re", "(", 
       SubscriptBox["\[Alpha]", "0"], ")"}], ",", 
      RowBox[{"Im", "(", 
       SubscriptBox["\[Alpha]", "0"], ")"}]}], "}"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "578b2741-981b-034f-a227-50ef93a4539f"],
 " with covariance ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], "\[DoubleStruckOne]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "465f2077-8e43-7648-9da6-16918deab94b"],
 " . The Wigner function gives symmetrically ordered moments so \
\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["a", "\[Dagger]"], "a"}], "\[RightAngleBracket]"}], "=", 
    RowBox[{
     SubscriptBox[
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"|", "\[Alpha]", 
        SuperscriptBox["|", "2"]}], "\[RightAngleBracket]"}], "W"], "-", 
     RowBox[{"1", "/", "2"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e6820a09-0184-1a42-b9e1-577998ca5b0e"]
}], "Text",
 CellID->4278889,ExpressionUUID->"359e292d-579b-8a48-9d0d-4477be8c9031"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"nOfT", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Expectation", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Total", "[", 
           SuperscriptBox[
            RowBox[{"Mean", "[", 
             RowBox[{"proc", "[", "t", "]"}], "]"}], "2"], "]"}], "+", 
          RowBox[{"Tr", "[", 
           RowBox[{"Covariance", "[", 
            RowBox[{"proc", "[", "t", "]"}], "]"}], "]"}]}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x0", ",", "p0"}], "}"}], "\[Distributed]", 
        RowBox[{"MultinormalDistribution", "[", 
         RowBox[{
          RowBox[{
           SqrtBox["2"], " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Re", "[", "\[Alpha]0", "]"}], ",", 
             RowBox[{"Im", "[", "\[Alpha]0", "]"}]}], "}"}]}], ",", 
          FractionBox[
           RowBox[{"IdentityMatrix", "[", "2", "]"}], "2"]}], "]"}]}]}], 
      "]"}], "-", 
     FractionBox["1", "2"]}], ",", 
    RowBox[{
     RowBox[{"t", ">", "0"}], "&&", 
     RowBox[{"\[Gamma]", ">", "0"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[129]:=",
 CellID->414734017,ExpressionUUID->"c3ac345c-bf15-6444-ac03-76b073c22917"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "t"}], " ", "\[Gamma]"}]], " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Abs", "[", "\[Alpha]0", "]"}], "2"], "-", 
     OverscriptBox["n", "_"]}], ")"}]}], "+", 
  OverscriptBox["n", "_"]}]], "Output",
 CellLabel->"Out[129]=",
 CellID->64760762,ExpressionUUID->"0dbe2fb9-fa45-894b-99d8-741937b0a121"]
}, Open  ]],

Cell[TextData[{
 "Alternatively, we can follow a Glauber ",
 Cell[BoxData[
  FormBox["P", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1c62e92f-c25f-5445-8221-7c45d85cc0b5"],
 " function approach \[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["a", "\[Dagger]"], "a"}], "\[RightAngleBracket]"}], "=", 
    SubscriptBox[
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"|", "\[Alpha]", 
       SuperscriptBox["|", "2"]}], "\[RightAngleBracket]"}], 
     RowBox[{"s", "->", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2572c484-d781-014e-81a8-d935cf67c053"],
 " that is associated to normal ordering. For this process the initial \
coherent state is just a single point (a Dirac delta) and not a blob:"
}], "Text",
 CellID->588748616,ExpressionUUID->"ef4ad724-3e88-3f4f-9df1-62b96c7b5623"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"procP", "=", 
  RowBox[{"langevin", "[", 
   RowBox[{
    RowBox[{"kramersMoyal", "[", 
     RowBox[{"thermal", ",", "1"}], "]"}], ",", 
    RowBox[{
     SqrtBox["2"], " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", "\[Alpha]0", "]"}], ",", 
       RowBox[{"Im", "[", "\[Alpha]0", "]"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[83]:=",
 CellID->600592707,ExpressionUUID->"0acd7072-b806-cd4b-b38b-708186a4efb1"],

Cell[BoxData[
 RowBox[{"ItoProcess", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "2"]}], " ", "\[Gamma]", " ", 
        RowBox[{"x", "[", "t", "]"}]}], ",", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "2"]}], " ", "\[Gamma]", " ", 
        RowBox[{"p", "[", "t", "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SqrtBox[
          RowBox[{"\[Gamma]", " ", 
           OverscriptBox["n", "_"]}]], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         SqrtBox[
          RowBox[{"\[Gamma]", " ", 
           OverscriptBox["n", "_"]}]]}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], ",", 
       RowBox[{"p", "[", "t", "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "p"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SqrtBox["2"], " ", 
        RowBox[{"Re", "[", "\[Alpha]0", "]"}]}], ",", 
       RowBox[{
        SqrtBox["2"], " ", 
        RowBox[{"Im", "[", "\[Alpha]0", "]"}]}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0"}], "}"}]}], "]"}]], "Output",
 CellLabel->"Out[83]=",
 CellID->26947021,ExpressionUUID->"2238b1eb-c29d-ee49-a22c-91a24aba78a3"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Expectation", "FormattedFunction"],
 " is not needed, recovering the same result:"
}], "Text",
