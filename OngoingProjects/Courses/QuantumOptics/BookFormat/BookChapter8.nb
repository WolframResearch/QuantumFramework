Cell["\<\
We saw the dissipative Jaynes-Cummings with a Fock state, now observe how \
collapse and revivals change with dissipation. The point of this exercise is \
to encourage exploration and determine relevant parameters. There are \
different regimes of interaction, so changing the Hamiltonian parameters and \
the \[Gamma] rates can result in diverse dynamics.\
\>", "Exercise",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellID->374645821,ExpressionUUID->"c2c9a399-244e-a640-8eb9-fd26411322fa"],

Cell[CellGroupData[{

Cell["Solution", "ExerciseSolution",
 CellID->426455834,ExpressionUUID->"806e093e-fd1e-6a49-adb1-94235e06621c"],

Cell["Set the truncation size and relevant parameters:", "SolutionAnswer",
 CellID->141756422,ExpressionUUID->"06923126-d66e-1e4b-ae1e-c35b24b727ab"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "20", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Nu]", " ", "=", " ", "8."}], ";"}], "   "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]", " ", "=", " ", "8."}], ";"}], "   "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gc", " ", "=", " ", "10."}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Gamma]1", " ", "=", " ", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Gamma]2", " ", "=", " ", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", ":=", " ", 
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"{", "2", "}"}], "]"}]}], ";"}]}], "ExerciseInput",
 CellLabel->"In[47]:=",
