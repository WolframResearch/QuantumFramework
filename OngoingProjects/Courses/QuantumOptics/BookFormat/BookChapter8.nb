Cell["Find the steady state of the Lindbladian:", "Text",
 CellID->274907101,ExpressionUUID->"77a4a25e-85f9-5741-a02e-0e4654e413d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]steady", " ", "=", 
   RowBox[{"Chop", "[", 
    RowBox[{"Partition", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"NullSpace", "[", 
        RowBox[{"lindbladian", "[", "\"\<Matrix\>\"", "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", "$FockSize"}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[327]:=",
 CellID->409173406,ExpressionUUID->"6dc43b14-6c9d-d741-b1ff-9ac95b271f7c"],

Cell[TextData[{
 "Verify it is the thermal state with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "th"], "=", "3"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "931e9bdc-617c-904f-b475-e3475ddc4e7e"],
 ":"
}], "Text",
 CellID->339739672,ExpressionUUID->"1ae378bb-e6ad-a648-8fb0-969b6fc2b688"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{"\[Rho]steady", ",", "$FockSize"}], "]"}], 
    "[", "\"\<Normalize\>\"", "]"}], "-", 
   RowBox[{"ThermalState", "[", "3.", "]"}]}], "]"}]], "Input",
 CellLabel->"In[328]:=",
