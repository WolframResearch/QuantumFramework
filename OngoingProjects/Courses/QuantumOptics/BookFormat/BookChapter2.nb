Cell[BoxData[
 RowBox[{
  RowBox[{"H", " ", "=", " ", 
   RowBox[{"h", " ", "\[Omega]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["a", "\[Dagger]"], "@", "a"}], " ", "+", 
      RowBox[{"1", "/", "2"}]}], " ", ")"}]}]}], ";"}]], "Input",
