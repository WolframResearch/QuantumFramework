Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", "=", 
      RowBox[{"CoherentState", "[", 
       RowBox[{"10", ",", 
        RowBox[{"\"\<Normalized\>\"", "->", "False"}]}], "]"}]}], "}"}], ",", 
    
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{"r", 
         RowBox[{
          RowBox[{"(", " ", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{"-", 
              SuperscriptBox[
               RowBox[{"Abs", "[", "\[FormalAlpha]", "]"}], "2"]}], "]"}], 
            RowBox[{"(", 
             RowBox[{"s", "@", 
              SuperscriptBox["s", "\[Dagger]"]}], ")"}]}], ")"}], 
          "[", "\"\<Matrix\>\"", "]"}]}], "]"}], "/.", " ", 
       RowBox[{"\[FormalAlpha]", "->", 
        RowBox[{"r", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", "0", ",", 
        RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}]}], "]"}], "//", 
