Cell[CellGroupData[{

Cell[TextData[StyleBox["Additional properties of coherent states ", \
"Subsection"]], "Subsection",
 CellChangeTimes->{{3.92826176541835*^9, 3.928261770519718*^9}, {
  3.9653236129355583`*^9, 3.9653236172346725`*^9}},
 CellID->25535950,ExpressionUUID->"71a7d055-e107-374b-9788-85ffff4d7589"],

Cell["\<\
The  inner  product   of  two  coherent  states \
|\[Alpha]\[RightAngleBracket],  |\[Beta]\[RightAngleBracket] is:\
\>", "Text",
 CellID->547586355,ExpressionUUID->"fd96c5f3-5847-a34f-a308-69c7cb93dd86"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{"\[Beta]", " ", "|", "\[Alpha]"}], "\[RightAngleBracket]"}], " ", 
   "=", 
   RowBox[{
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Beta]", "\[Conjugate]"}], "\[Alpha]"}], "-", 
        RowBox[{"\[Beta]", " ", 
         RowBox[{"\[Alpha]", "\[Conjugate]"}]}]}], ")"}]}], ")"}], " ", 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], Cell[
       "|",ExpressionUUID->"66dbe4c6-6179-c242-bfef-e35fd6c0a4b2"], 
       "\[Beta]"}], "-", 
      RowBox[{"\[Alpha]", 
       SuperscriptBox[Cell[
        "|",ExpressionUUID->"95960263-9ead-b240-a68a-26ac5a62b891"], "2"]}]}],
      ")"}]}]}], TraditionalForm]], "DisplayFormula",
 FontSize->18,
 CellID->31141434,ExpressionUUID->"a94f4579-4c12-db46-b00a-f275462c32b1"],

Cell[TextData[{
 "So when \[Alpha] and \[Beta] are different clearly the states are not \
orthogonal , but when the quantity |\[Beta] - ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", 
    SuperscriptBox[Cell[
     "|",ExpressionUUID->"b6216c23-8e66-8541-a128-a9ecd4f14843"], "2"]}], 
   TraditionalForm]],ExpressionUUID->"b21f39de-60e2-e945-9332-c74e3daa38de"],
 " is large enough the states are almost orthogonal ( \[LeftAngleBracket] \
\[Beta] | \[Alpha]\[RightAngleBracket] \[TildeTilde] 0)"
}], "Text",
 CellID->742689228,ExpressionUUID->"9de97b95-78e6-4642-b2d3-3d16b3848b7e"],

Cell[TextData[StyleBox["Choose values of \[Alpha] and \[Beta]:", "Text"]], \
"CodeText",
 CellChangeTimes->{{3.965323665951771*^9, 3.9653237039989147`*^9}},
 CellID->131432912,ExpressionUUID->"9f0ee223-5fdb-f946-ac64-16d3eb612b81"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Alpha]c", ",", "\[Beta]c"}], "}"}], " ", "=", " ", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1.5", "+", 
       RowBox[{"1.5", "I"}]}], "}"}], ",", "2"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.931535906385927*^9, 3.9315359954415264`*^9}, {
   3.931536029543684*^9, 3.9315360510478497`*^9}, 3.9342279296141586`*^9},
 CellLabel->"In[25]:=",
 CellID->389250356,ExpressionUUID->"fcd3bf1e-283c-6545-b71f-1f563178dd5f"],

