 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["1", "24"], " ", 
      SuperscriptBox["\[FormalAlpha]", "4"], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"Abs", "[", "\[FormalAlpha]", "]"}], "2"]}]], " ", 
      SuperscriptBox[
       RowBox[{"Conjugate", "[", "\[FormalAlpha]", "]"}], "4"]}], "/.", 
     RowBox[{"\[FormalAlpha]", "->", 
      RowBox[{"x", "+", 
       RowBox[{"y", " ", "\[ImaginaryI]"}]}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"{", 
