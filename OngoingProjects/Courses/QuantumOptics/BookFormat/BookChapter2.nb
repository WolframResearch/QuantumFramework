Cell["Any state can be decomposed in terms of coherent states:", "Text",
 CellChangeTimes->{{3.931703694640251*^9, 3.931703709137665*^9}, {
  3.931859930885313*^9, 3.93185995293305*^9}, {3.931860266359165*^9, 
  3.931860291961834*^9}, {3.931860329899174*^9, 3.9318603386809425`*^9}, {
  3.9318605964721107`*^9, 3.931860602095043*^9}, {3.931860830521461*^9, 
  3.931860926083904*^9}, {3.965323760135086*^9, 3.965323772353071*^9}},
 CellID->237111420,ExpressionUUID->"63c4e648-67bd-fe4e-b795-126ab86562e8"],

Cell[BoxData[
 FormBox[
  RowBox[{
  Cell["|\[Psi]\[RightAngleBracket]",ExpressionUUID->
    "821116c4-4369-764c-9358-692045362f02"], "=", 
   RowBox[{"\[Integral]", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["\[DifferentialD]", "2"], "\[Alpha]"}], "\[Pi]"], Cell[
     "|\[Alpha]\[RightAngleBracket]",ExpressionUUID->
      "deb21c93-d16e-c64d-957c-a261fb6ec5a3"], 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"\[Alpha]", "|", "\[Psi]"}], "\[RightAngleBracket]"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->45398984,ExpressionUUID->"2bcb8f6f-c0ac-994b-ada2-9f248dbc2e4b"],

Cell["\<\
When the state is also a coherent state | \[Beta] \[RightAngleBracket], we \
see the coherent states are not linear independent and are said to be \
\[OpenCurlyDoubleQuote]overcomplete\[CloseCurlyDoubleQuote], the inner \
product of the coherent states (exponential factor)  is called a reproducing \
kernel:\
\>", "Text",
 CellChangeTimes->{{3.931703694640251*^9, 3.931703709137665*^9}, {
  3.931859930885313*^9, 3.93185995293305*^9}, {3.931860266359165*^9, 
  3.931860291961834*^9}, {3.931860329899174*^9, 3.9318603386809425`*^9}, {
  3.9318605964721107`*^9, 3.931860602095043*^9}, {3.931860830521461*^9, 
  3.931860926083904*^9}, {3.965323760135086*^9, 3.965323800441393*^9}},
 CellID->20060496,ExpressionUUID->"f5f6d72c-c233-0541-8631-988e46b52df9"],

Cell[BoxData[
 FormBox[
  RowBox[{
  Cell["| \[Beta]\[RightAngleBracket]",ExpressionUUID->
    "39cc1b1a-290c-7a40-8e94-c1b3d97bfc1b"], " ", "=", 
   RowBox[{"\[Integral]", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["\[DifferentialD]", "2"], "\[Alpha]"}], "\[Pi]"], Cell[
     "|\[Alpha]\[RightAngleBracket]",ExpressionUUID->
      "a6adf0c7-d09c-514e-96de-a64853dbf56f"], 
     RowBox[{"exp", "(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "2"]}], Cell[TextData[Cell[BoxData[
         FormBox[
          RowBox[{"|", "\[Alpha]", 
           SuperscriptBox["|", "2"]}], TraditionalForm]],
         FormatType->TraditionalForm,ExpressionUUID->
         "0407b19e-6c62-634e-9f41-8440bab3907b"]],ExpressionUUID->
         "baaa6dda-627f-6648-ae66-11e2a4726ba3"]}], "-", 
       RowBox[{
        FractionBox["1", "2"], " ", Cell[TextData[Cell[BoxData[
         FormBox[
          RowBox[{
          Cell["|",ExpressionUUID->"e1a243ca-4563-404f-9e37-e6399a013f0b"], 
           "\[Beta]", 
           SuperscriptBox[Cell[TextData[Cell[BoxData[
             FormBox["|", TraditionalForm]],
             FormatType->TraditionalForm,ExpressionUUID->
             "5d0fb45e-3421-2e4a-b21c-e9f54bea4caa"]],ExpressionUUID->
             "911caf9d-b065-6445-bd6a-cb8c2c90a70c"], "2"]}], 
          TraditionalForm]],
         FormatType->TraditionalForm,ExpressionUUID->
         "7c536e26-15d3-1849-8eb3-b645d62b427a"]],ExpressionUUID->
         "ac317624-d779-174a-baa2-896e2b3100ba"]}], "+", 
       RowBox[{
        RowBox[{"\[Alpha]", "\[Conjugate]"}], "\[Beta]"}]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->2107683,ExpressionUUID->"4b93802b-b4da-c246-8f35-53c4428a5e89"],

Cell["\<\
Because a coherent state |\[Alpha]\[RightAngleBracket] is a displaced vacuum, \
any expectation value calculated on a coherent state is mathematically \
equivalent to the \[OpenCurlyDoubleQuote]shifted\[CloseCurlyDoubleQuote] \
expectation on the vacuum\
\>", "Text",
 CellID->161180256,ExpressionUUID->"8fe6f8e3-74cb-b843-b0bf-8bd90d0b48a7"],

Cell[TextData[{
 "This means for some operator ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["O", "^"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1e08aa54-c814-d541-b4fb-6141b5f2c244"],
 ":"
}], "Text",
 CellID->71683784,ExpressionUUID->"ea76bc03-7960-094b-9144-f3dc8932f110"],

Cell[BoxData[
 StyleBox[
  RowBox[{
  Cell["\[LeftAngleBracket]",ExpressionUUID->
    "160698be-0531-f54f-aabf-1315734d1011"], "\[Alpha]", Cell[
   "|",ExpressionUUID->"8d45c10b-2686-2444-a380-85f33654793f"], Cell[BoxData[
    FormBox[
     OverscriptBox["O", "^"], TraditionalForm]], "DisplayFormula",
    ExpressionUUID->"6a300e74-8317-6a4c-9c49-74a46855ccb4"], Cell[
   "|",ExpressionUUID->"90d6cc1a-1cf2-4f4e-ad1c-4b9637624cc2"], "\[Alpha]", 
   Cell["\[RightAngleBracket]",ExpressionUUID->
    "c3e25b3e-2059-d54b-b17c-7d5c063fdb97"], Cell[BoxData[
    FormBox[
     RowBox[{" ", 
      RowBox[{"=", " "}]}], TraditionalForm]], "DisplayFormula",
    ExpressionUUID->"6265efb1-8dd5-a34c-a6c3-755404110f6d"], Cell[
   "\[LeftAngleBracket]",ExpressionUUID->
    "39500ed0-92cd-a141-9a91-cb2b8821fd3f"], "0", Cell[
   "|",ExpressionUUID->"f3e21f4f-73a0-4e4b-b37e-6dd1ff7eac4f"], Cell[BoxData[
    FormBox[
     RowBox[{
      RowBox[{
       SuperscriptBox[
        OverscriptBox["D", "^"], "\[Dagger]"], "(", "\[Alpha]", ")"}], 
      OverscriptBox["O", "^"], 
      RowBox[{
       OverscriptBox["D", "^"], "(", "\[Alpha]", ")"}]}], TraditionalForm]], 
    "DisplayFormula",ExpressionUUID->"153c6663-d5e4-8d48-9f0c-a7e17511e66d"], 
   Cell["|",ExpressionUUID->"94286955-f18f-0e4b-8e11-9c18973165cd"], "0", 
   Cell["\[RightAngleBracket]",ExpressionUUID->
    "17bc1c48-111f-d043-ba5c-2444b2aabe16"]}], 
  "DisplayFormula"]], "DisplayFormula",
 CellID->212471572,ExpressionUUID->"90ed6c15-a07c-094f-80ad-3e85c312d5e0"],

Cell[TextData[{
 "For example let\[CloseCurlyQuote]s compute the known result for the number \
operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "\[Dagger]"], "a"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "64360283-095e-7542-9dc5-ee85da39f16c"]
}], "Text",
 CellID->457423488,ExpressionUUID->"36c69ebe-d10a-f441-9f9d-2cb52cf44784"],

Cell[TextData[{
 "Shorthand for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["D", "^"], "(", "\[Alpha]", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "57342f93-9928-4c4a-b291-8a406914dbb0"],
 ":"
}], "Text",
 CellID->515368119,ExpressionUUID->"247b599e-6064-2948-a6eb-80dca93001bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Dop", "[", "x_", "]"}], ":=", 
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"x", " ", 
     SuperscriptBox["\[FormalA]", "\[Dagger]"]}], "-", 
    RowBox[{
     RowBox[{"x", "\[Conjugate]"}], " ", "\[FormalA]"}]}], "]"}]}]], "Input",
 CellLabel->"In[7]:=",
 CellID->196151632,ExpressionUUID->"f3c9b753-9f7b-ad41-9dbd-faaec83ce9f2"],

Cell[TextData[{
 StyleBox["BosonicVEV", "FormattedFunction"],
 " can be used to compute vacuum expectation values, we get ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", "\[Alpha]", 
    SuperscriptBox["|", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a97537cf-4f4a-6b47-82f4-c29825a6987c"],
 " as expected:"
}], "Text",
 CellID->173690571,ExpressionUUID->"f91c5edb-abcb-7b4f-a2c1-fa4a7b380e19"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"BosonicVEV", "@", 
   RowBox[{"BosonicExpSimplify", "[", 
    RowBox[{
     RowBox[{"Dop", "[", 
      RowBox[{"-", "\[Alpha]"}], "]"}], "**", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[FormalA]", "\[Dagger]"], "**", "\[FormalA]"}], ")"}],
      "**", 
     RowBox[{"Dop", "[", "\[Alpha]", "]"}]}], "]"}]}], "//", 
  "FullSimplify"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->292310091,ExpressionUUID->"be35add8-bdfa-8942-be63-081fe569bb8a"],

Cell[BoxData[
 FormBox[
  SuperscriptBox[
   TemplateBox[{"\[Alpha]"},
    "Abs"], "2"], TraditionalForm]], "Output",
 CellLabel->"Out[8]=",
 CellID->98979982,ExpressionUUID->"b0f7220e-c097-584b-9649-bcb84d0dd064"]
}, Open  ]],

Cell[TextData[{
 "The quadrature operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["X", "1"], "=", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{"a", "+", 
        SuperscriptBox["a", "\[Dagger]"]}], ")"}]}]}], ",", " ", 
    RowBox[{
     SubscriptBox["X", "2"], "=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"2", " ", "\[ImaginaryI]"}]], 
      RowBox[{"(", 
       RowBox[{"a", "-", 
        SuperscriptBox["a", "\[Dagger]"]}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "67d08eb7-4cab-8f40-a0b8-6f3e1f5187a4"],
 " have as coherent expectation values the real and imaginary parts of the \
complex amplitude \[Alpha]"
}], "Text",
 CellID->597657050,ExpressionUUID->"dbca70cf-10e4-6f4d-8a87-fd80655335f0"],

