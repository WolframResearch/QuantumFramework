Cell[TextData[{
 "This shows that the photon distribution follows a Poisson distribution, \
this is clearly shown when calculating ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "n"], " "}], TraditionalForm]],
  FontSize->15,ExpressionUUID->"5c3c5e32-7937-7a4d-abef-1e4dc29409f4"],
 ", the probability of measuring ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "881529e6-8dcf-3b4b-a4e9-055bc4686959"],
 " photons. From the definition of a coherent state in Fock basis it is not \
difficult to obtain:",
 StyleBox[" ",
  FontSize->14]
}], "Text",
 CellID->87065138,ExpressionUUID->"58803541-f84d-654a-924a-a373fe96f6fc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox[
    SubscriptBox["P", "n"],
    FontSize->18], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       RowBox[{"|", "\[Alpha]", 
        SuperscriptBox["|", "2"]}]}]], 
     FractionBox[
      RowBox[{"|", "\[Alpha]", 
       SuperscriptBox["|", 
        RowBox[{"2", "n"}]]}], 
      SqrtBox[
       RowBox[{"n", "!"}]]]}], "=", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", " ", 
        OverscriptBox["n", "\[LongDash]"]}]], 
      SuperscriptBox[
       OverscriptBox["n", "\[LongDash]"], "n"]}], 
     SqrtBox[
      RowBox[{"n", "!"}]]]}]}], TraditionalForm]], "DisplayFormula",
 CellID->64009354,ExpressionUUID->"d1972c0e-2f73-4348-bc13-3f12994b5199"],

Cell[TextData[{
 "The fractional uncertainty ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[CapitalDelta]", " ", "n"}], 
     OverscriptBox["n", "\[LongDash]"]], "=", 
    FractionBox["1", 
     SqrtBox[
      OverscriptBox["n", "\[LongDash]"]]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c66468c8-5acb-2542-b676-32b4dc68cea2"],
 " decreases with increasing mean photon number. Also the phase distribution \
for a coherent state |\[Alpha]\[RightAngleBracket] (\[Alpha] = |\[Alpha]| ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], TraditionalForm]],
  ExpressionUUID->"85133d13-0e5e-fc4c-aed7-59c8b6a95f94"],
 ") is: "
}], "Text",
 CellID->209563745,ExpressionUUID->"b55fa570-a8e3-264b-9ca3-57bcdb3e5a10"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox[
    RowBox[{"P", "(", "\[Psi]", ")"}],
    FontSize->18], "=", 
   RowBox[{
    StyleBox[
     FractionBox["1", 
      RowBox[{"2", " ", "\[Pi]"}]],
     FontSize->18], " ", 
    StyleBox[Cell["|",ExpressionUUID->"a8fba538-a68d-6b4e-bf94-d383778a7f27"],
     FontSize->18], 
    StyleBox[
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"\[Psi]", "|", "\[Alpha]"}], "\[RightAngleBracket]"}],
     FontSize->18], 
    StyleBox[
     SuperscriptBox[Cell[
      "|",ExpressionUUID->"7990ce22-87a2-f54d-a292-7c40167b3abe"], "2"],
     FontSize->18]}]}], TraditionalForm]], "DisplayFormula",
 CellID->15982139,ExpressionUUID->"18f7e329-2eef-2e46-8c15-894356bef84b"],

Cell["\<\
For large |\[Alpha]| the Poisson distribution approximates to a Gaussian so \
we get the compact expression\
\>", "Text",
 CellID->213290273,ExpressionUUID->"612f7fcd-f4d1-3d4e-839a-fca9bfc29998"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"P", "(", "\[Psi]", ")"}], "\[TildeTilde]", 
   RowBox[{
    SqrtBox[
     RowBox[{
     "2", Cell["|",ExpressionUUID->"6cf30e0f-99ed-5b46-a434-e0abc5033af5"], 
      "\[Alpha]", 
      RowBox[{
       SuperscriptBox[Cell[
        "|",ExpressionUUID->"9c7dd9c9-a6fb-3a4f-bb7d-c81b83f1931a"], "2"], "/",
        "\[Pi]"}]}]], " ", 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", "2"}], "|", "\[Alpha]", 
      SuperscriptBox["|", "2"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[Psi]", "-", "\[Theta]"}], ")"}], "2"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->456015332,ExpressionUUID->"88fd5001-3f3a-224e-9931-f8546e108899"],

Cell[TextData[{
 StyleBox["Plot photon distributions, for ", "Text"],
 Cell[BoxData[
  FormBox["|", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "890d65ee-8743-314d-8c0f-f4a7edd182ef"],
 StyleBox["\[Alpha]", "Text"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[Cell[
      "|",ExpressionUUID->"4d571f66-0243-cb45-ab08-54dc0f1361c9"], "2"], "=", 
     "1"}], ",", "2", ",", 
    RowBox[{"...", "10"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aa69492e-d3a8-dc41-9f88-438145f26dc7"],
 StyleBox[": ", "Text"]
}], "CodeText",
 CellID->337713417,ExpressionUUID->"18deccf2-de81-3444-b823-ba487235a3c4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "20", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"BarChart", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"CoherentState", "[", "]"}], "[", 
        SqrtBox["x"], "]"}], "[", "\"\<Probabilities\>\"", "]"}], "//", 
      "Values"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1.", ",", "10"}], "}"}]}], "]"}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "Large"}], ",", 
   RowBox[{"BarSpacing", "\[Rule]", "Medium"}], ",", 
   RowBox[{"ColorFunction", "->", "\"\<SolarColors\>\""}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{"Automatic", ",", "Below"}], "]"}]}], ",", 
   RowBox[{
   "PlotLabel", 
    "\[Rule]", "\"\<Coherent state photon distributions in a basis of size 20\
\>\""}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Mean Photon number ( from 1 to 10)\>\"", 
      ",", "\"\<Probabilities\>\""}], "}"}]}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", "14"}], ",", 
   RowBox[{"ImageSize", "->", "450"}]}], "]"}]}], "Input",
 CellLabel->"In[169]:=",
 CellID->133389352,ExpressionUUID->"b0e983a8-b1a1-b940-9701-494d88afb12c"],

