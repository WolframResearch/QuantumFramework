    RowBox[{
      SqrtBox[
       RowBox[{"m", "!"}]], " ", 
      SqrtBox[
       RowBox[{"n", "!"}]]}]], "r", "0", "\[Infinity]", "\[Theta]", 
   RowBox[{"-", "\[Pi]"}], "\[Pi]"},
  "InactiveIntegrate",
  DisplayFunction->(RowBox[{
     SubsuperscriptBox[
      StyleBox["\[Integral]", "Inactive"], #3, #4], 
