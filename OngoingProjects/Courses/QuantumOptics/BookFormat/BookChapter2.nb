Cell[TextData[{
 "NOTE: Since we are using a truncated basis it is worth noting that to \
appropriately describe a coherent state with amplitude \[Alpha], the basis \
size should be around \[LineSeparator]",
 Cell[BoxData[
  FormBox["|", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5cc89aad-25e9-254e-83f4-39fc2c9ab31f"],
 StyleBox["\[Alpha]", "CodeText"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[Cell[
     "|",ExpressionUUID->"de99ca0e-3fe3-4749-af0c-f205cdb12dba"], "2"], "+", 
    "5"}], TraditionalForm]], "CodeText",
  FormatType->TraditionalForm,ExpressionUUID->
  "83053f14-a56c-7942-bdec-4afa9504c86f"], "CodeText"],
 Cell[BoxData[
  FormBox["|", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "08f8047d-4d1d-6543-a847-19527ecbb92d"],
 StyleBox["\[Alpha]", "CodeText"],
 Cell[BoxData[
  FormBox["|", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a050e4d3-32bb-ae45-83b5-73f3228ea434"],
 Cell[BoxData[
  FormBox[
  Cell[" (or higher)",ExpressionUUID->"89e712b8-0d0b-1146-a322-e2a45d230584"],
    TraditionalForm]],
  InitializationCell->True,ExpressionUUID->
  "6d94ea7c-bde2-1349-b549-0280364ef0a6"],
 " to completely include the tails of the  Poisson distribution"
}], "Text",
 CellID->158588016,ExpressionUUID->"c6dfc98f-9f7b-744f-8e83-d216050d94b9"],

Cell[TextData[{
 "For  example, for  |\[Alpha]| ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", " ", 
    SqrtBox[
     RowBox[{"10", " "}]]}], TraditionalForm]], "CodeText",ExpressionUUID->
  "08c530f2-3c36-0442-8f52-ca04a83e6e2a"],
 "the best size would ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"be", " ", 
      StyleBox["10", "CodeText"]}], 
     StyleBox["+", "CodeText"], 
     StyleBox[
      RowBox[{"5", 
       SqrtBox["10"]}], "CodeText"]}], 
    StyleBox[" ", "CodeText"], 
    StyleBox["\[TildeTilde]", "CodeText"], 
    StyleBox[" ", "CodeText"], 
    StyleBox["25", "CodeText"]}], TraditionalForm]], "Text",ExpressionUUID->
  "400f4c7d-0fca-c141-8717-fdfc2593b68b"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9306819705874405`*^9, 3.930682017526003*^9}, {
  3.930738081646454*^9, 3.9307380914575005`*^9}, {3.965302138198967*^9, 
  3.9653021506770153`*^9}},
 CellID->165289523,ExpressionUUID->"f8527a07-05a6-194d-902c-77d7ff48f6c5"],

