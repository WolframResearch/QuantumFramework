Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["O", 
    RowBox[{"m", ",", "n"}]], " ", "=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      RowBox[{
       RowBox[{"m", "!"}], " ", 
       RowBox[{"n", "!"}]}]]], 
    RowBox[{"\[Integral]", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        RowBox[{"|", "\[Alpha]", 
         SuperscriptBox["|", "2"]}]}]], 
      SuperscriptBox[
       RowBox[{
        SuperscriptBox["\[Alpha]", "m"], "(", 
        RowBox[{"\[Alpha]", "\[Conjugate]"}], ")"}], "n"], 
      RowBox[{
       SuperscriptBox["\[DifferentialD]", "2"], "\[Alpha]"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->232762223,ExpressionUUID->"a0348211-de8c-fb42-90f6-24c60bf5b166"],

