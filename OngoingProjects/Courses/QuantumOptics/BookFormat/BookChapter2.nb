 CellChangeTimes->{{3.965323685170103*^9, 3.965323688889204*^9}},
 CellID->865618008,ExpressionUUID->"e4fc5bbe-7b74-6543-8646-15e489942cbf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"CoherentState", "[", "]"}], "[", "\[Alpha]c", "]"}], 
     "[", "\"\<Dagger\>\"", "]"}], "@", 
    RowBox[{
