     RowBox[{"NotebookDirectory", "[", "]"}], "<>", "\"\<Coh.GIF\>\""}], ",", 
    "frames", ",", "\"\<GIF\>\""}], "]"}], ";"}]], "ExerciseInput",
 CellChangeTimes->{{3.9715395839836826`*^9, 3.9715396041771374`*^9}, 
   3.9715397167289677`*^9},
 CellLabel->"In[12]:=",
 CellID->34385537,ExpressionUUID->"bc537386-f381-344f-ab44-2325a999d898"]
}, Open  ]],

Cell["\<\
If we have the not normalized superposition of coherent states 0.2 |\[Alpha] \
= 2 \[RightAngleBracket] + 0.5 |\[Beta] \[RightAngleBracket]. What is a \
possible value of \[Beta] such there is probability zero of measuring two \
photons?\
\>", "Exercise",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellID->30751020,ExpressionUUID->"24e1567e-4c2b-1e4d-9138-7b90706e8042"],

Cell["Solution", "ExerciseSolution",
 CellID->640449883,ExpressionUUID->"bdc8c4a4-5561-f648-a846-648ad0fbb8d4"],

Cell[CellGroupData[{

Cell["Define the state:", "ExerciseNote",
 CellID->378427925,ExpressionUUID->"57ac9f0b-e0d5-0944-a1cc-3a3218cbcb89"],

Cell[BoxData[
 RowBox[{
  RowBox[{"state", " ", "=", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"0.2", " ", 
         RowBox[{
          RowBox[{"CoherentState", "[", "]"}], "[", "2", "]"}]}], "+", 
        RowBox[{"0.5", " ", 
         RowBox[{
          RowBox[{"CoherentState", "[", "]"}], "[", 
          RowBox[{"x", "+", 
           RowBox[{"\[ImaginaryI]", " ", "y"}]}], "]"}]}]}], ")"}], 
      "[", "\"\<Normalize\>\"", "]"}], ",", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}]}]}], "]"}]}], ";"}]], "ExerciseInput",
 CellLabel->"In[17]:=",
 CellID->288925735,ExpressionUUID->"0fb1f4de-4e2e-5a40-9025-8837c3ce30a6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Get the relevant amplitude:", "ExerciseNote",
 CellID->471672530,ExpressionUUID->"4def9ef0-a0ff-244d-8536-0d1467e9493a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"amplitude", " ", "=", " ", 
   RowBox[{
    RowBox[{"state", "[", "\"\<Amplitudes\>\"", "]"}], "[", 
    RowBox[{"[", "3", "]"}], "]"}]}], ";"}]], "ExerciseInput",
 CellLabel->"In[20]:=",
 CellID->792728,ExpressionUUID->"bf6c69f3-6860-6141-9ed5-20f6e2cfbf31"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Minimize the magnitude of the amplitude:", "ExerciseNote",
 CellID->170310025,ExpressionUUID->"de74c045-d43c-de46-a8e2-07e26248a7b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"result", " ", "=", 
  RowBox[{"NMinimize", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Abs", "[", "amplitude", "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "<=", "x", "<=", "1"}], " ", "&&", 
       RowBox[{
        RowBox[{"-", "1"}], "<=", "y", "<=", "1"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]], "ExerciseInput",
 CellChangeTimes->{{3.971541833088585*^9, 3.9715418689474277`*^9}, {
  3.9715419070023155`*^9, 3.9715419728237934`*^9}, {3.971542022218088*^9, 
  3.97154203199185*^9}, {3.9715420836897984`*^9, 3.9715421443013077`*^9}, {
  3.9715424391679497`*^9, 3.9715424406413364`*^9}},
 CellLabel->"In[21]:=",
 CellID->179831671,ExpressionUUID->"66f3e909-dea0-714d-8282-daa3130c2fb3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"9.401962746834734`*^-12", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "1.1000226379687322`*^-12"}], ",", 
     RowBox[{"y", "\[Rule]", 
      RowBox[{"-", "0.49469301073214184`"}]}]}], "}"}]}], 
  "}"}]], "ExerciseOutput",
 CellLabel->"Out[21]=",
 CellID->168753669,ExpressionUUID->"6d99198d-13ee-ad48-9628-93876566408c"]
}, Open  ]]
}, Open  ]],

