 CellID->301597213,ExpressionUUID->"6a062d6f-e7e2-df43-818a-8e68bf3d44b3"],

Cell[TextData[StyleBox["Define the algebra:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9695592249729385`*^9, 3.969559227756752*^9}},
 CellID->157632824,ExpressionUUID->"5c0a95ad-0f2a-204c-a9e1-25ea13e263ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"alg", " ", "=", 
   RowBox[{"NonCommutativeAlgebra", "[", 
    RowBox[{"<|", 
     RowBox[{"\"\<ScalarVariables\>\"", "->", "\[Alpha]"}], "|>"}], "]"}]}], 
  ";"}]], "Input",
