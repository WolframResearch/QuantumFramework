Cell["\<\
We create an evolution operator to evolve the states at any time:\
\>", "Text",
 CellChangeTimes->{{3.930741837170599*^9, 3.930741852738682*^9}, {
  3.9653231897127686`*^9, 3.9653231897297688`*^9}},
 CellID->55649282,ExpressionUUID->"c422a36b-f689-f04a-893c-4cf6ee017c07"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QOE", "=", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{"H", "/", "h"}], ",", "None", ",", "t"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.930741778205118*^9, 3.930741804920765*^9}, {
  3.9653232158926945`*^9, 3.9653232193475494`*^9}, {3.9653232601466007`*^9, 
  3.965323263468895*^9}},
 CellLabel->"In[13]:=",
 CellID->262397970,ExpressionUUID->"9725c189-5d75-3a45-b513-f360f5ea692e"],

Cell[TextData[{
 "A coherent state  remains a coherent state under the evolution , however \
the complex amplitude phase depends on time  with an extra global phase \
\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", 
     RowBox[{"\[Psi]", "(", "t", ")"}]}], "\[RightAngleBracket]"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8af61b52-9497-644a-b874-42bc9f6bf23d"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", 
     RowBox[{"t", "/", "2"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6ab6ed8a-61e4-de45-83b9-d28829f3b6bc"],
 "|\[Alpha] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", "t"}]], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "97a64173-acf1-a44f-ad87-e188756b54bd"],
 "\[RightAngleBracket]:"
}], "Text",
 CellID->72709578,ExpressionUUID->"50a96644-5d36-214c-9b40-bfd52a9fc745"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"QOE", " ", "@", " ", 
    RowBox[{"CoherentState", "[", "]"}]}], ")"}], " ", "==", " ", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", 
     RowBox[{"t", "/", "2"}]}]], 
   RowBox[{
    RowBox[{"CoherentState", "[", "]"}], "[", 
    RowBox[{"\[FormalAlpha]", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", "t"}]]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[74]:=",
 CellID->250755957,ExpressionUUID->"02103b76-8036-5545-9109-ca77f381ac72"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[74]=",
 CellID->317455591,ExpressionUUID->"a9310a8b-ac79-fc47-9555-637f8ce39ac4"]
}, Open  ]],

Cell[TextData[{
 "Another approach to show this comes from the fact  that the Hamiltonian is \
time independent so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"U", "(", "t", ")"}], "=", 
    RowBox[{"Exp", "(", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "H", " ", 
      RowBox[{"t", "/", "\[HBar]"}]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3edfbe24-20fa-7c4d-9d28-e0c71657aaf7"],
 ", so the evolved state can be expressed as |\[Psi]",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4078d314-eb22-614b-9e63-29f605795e96"],
 "\[RightAngleBracket]=",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "(", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", 
         RowBox[{"t", "(", 
          RowBox[{
           RowBox[{
            SuperscriptBox["a", "\[Dagger]"], "a"}], "+", 
           RowBox[{"1", "/", "2"}]}], ")"}]}], ")"}], 
       RowBox[{"D", "(", "\[Alpha]", ")"}]}], "|", "0"}], 
     "\[RightAngleBracket]"}], "=", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", 
       RowBox[{"t", "/", "2"}]}]], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", "t", " ", 
       SuperscriptBox["a", "\[Dagger]"], "a"}]], 
     RowBox[{"D", "(", "\[Alpha]", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "edc08a29-cce6-7645-a22e-3b5911a0beed"],
 "|0\[RightAngleBracket]"
}], "Text",
 CellID->334415446,ExpressionUUID->"a07355e1-c812-2a4d-9fb8-c2432f6c43ad"],

Cell[TextData[{
 "We can insert the unity as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[Beta]"}], " ", 
      OverscriptBox["n", "^"]}]], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"\[Beta]", " ", 
      OverscriptBox["n", "^"]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f8d33404-6012-8b42-80f5-dc20853cbc4d"],
 " and simplify the expression:"
}], "Text",
 CellID->107487366,ExpressionUUID->"bfb4faf8-45cb-df4b-917a-7f7fe907d86d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "@", 
   RowBox[{"BosonicExpSimplify", "[", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"\[Beta]", " ", 
       RowBox[{
        SuperscriptBox["\[FormalA]", "\[Dagger]"], "**", "\[FormalA]"}]}], 
      "]"}], "**", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"\[Alpha]", " ", 
        SuperscriptBox["\[FormalA]", "\[Dagger]"]}], "-", 
       RowBox[{
        RowBox[{"\[Alpha]", "\[Conjugate]"}], " ", "\[FormalA]"}]}], "]"}], "**", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "\[Beta]"}], " ", 
       RowBox[{
        SuperscriptBox["\[FormalA]", "\[Dagger]"], "**", "\[FormalA]"}]}], 
      "]"}], "**", 
     RowBox[{"Exp", "[", 
      RowBox[{"\[Beta]", " ", 
       RowBox[{
        SuperscriptBox["\[FormalA]", "\[Dagger]"], "**", "\[FormalA]"}]}], 
      "]"}]}], "]"}]}], "/.", " ", 
  RowBox[{"\[Beta]", "->", 
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", "t"}]}]}]], "Input",\

 CellLabel->"In[24]:=",
 CellID->132038166,ExpressionUUID->"08a48cfd-7ce7-654f-ae93-077e4f93b36e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"\[Alpha]", " ", 
      SuperscriptBox["\[FormalA]", "\[Dagger]"], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", "\[Omega]"}]]}], "-", 
     RowBox[{"\[FormalA]", " ", 
      TemplateBox[{"\[Alpha]"},
       "Conjugate"], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "t", " ", "\[Omega]"}]]}]}]], "**", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", "\[Omega]", " ", 
     RowBox[{
      SuperscriptBox["\[FormalA]", "\[Dagger]"], "**", "\[FormalA]"}]}]]}], 
  TraditionalForm]], "Output",
 CellLabel->"Out[24]=",
 CellID->199898897,ExpressionUUID->"cb0ed974-b17a-8249-973c-75e8a0d9891d"]
}, Open  ]],

Cell[TextData[{
 "Also ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", "t", " ", 
     SuperscriptBox["a", "\[Dagger]"], "a"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cf1a8b07-2fdb-bd4c-8cb8-c259b64846a5"],
 " |0\[RightAngleBracket] = |0\[RightAngleBracket], since the ground state is \
an eigenstate of number operator with eigenvalue 0:"
}], "Text",
 CellID->104099966,ExpressionUUID->"aef21f6f-bd8b-f143-93d5-bbf9a9fa8e21"],

