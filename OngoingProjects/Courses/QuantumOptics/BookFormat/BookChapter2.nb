 CellLabel->"In[181]:=",
 CellID->717960859,ExpressionUUID->"aff3fe74-77f5-1b4e-a8cb-969619830825"],

Cell[TextData[StyleBox["Basic commutator:", "Text"]], "CodeText",
 CellChangeTimes->{{3.969559203550665*^9, 3.9695592061162415`*^9}},
 CellID->85094816,ExpressionUUID->"6686119c-c913-f64b-8436-fc7acca13d14"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rels", " ", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Commutator", "[", 
      RowBox[{"\[FormalA]", ",", 
       SuperscriptBox["\[FormalA]", "\[Dagger]"]}], "]"}], "-", "1"}], 
    "}"}]}], ";"}]], "Input",
 CellLabel->"In[45]:=",
 CellID->17701732,ExpressionUUID->"00d9a3be-4307-8849-8404-b274d1ae5416"],

Cell[TextData[{
 StyleBox["Perform the calculation using non-commutative algebra functions, \
we sum up to the ", "Text"],
 "10th",
 StyleBox[" term to show the convergence:", "Text"]
}], "CodeText",
 CellID->589368215,ExpressionUUID->"700f7269-c50c-fd41-ab6b-3b66dc33a014"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sum", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"NonCommutativePolynomialReduce", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"zassen", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Alpha]", " ", 
           SuperscriptBox["\[FormalA]", "\[Dagger]"]}], ",", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"\[Alpha]", "\[Conjugate]"}]}], "\[FormalA]"}]}], "}"}], ",",
         "n"}], "]"}], ",", "\[IndentingNewLine]", "rels", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        SuperscriptBox["\[FormalA]", "\[Dagger]"], ",", "\[FormalA]"}], "}"}],
       ",", " ", "alg"}], " ", "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"n", ",", "2", ",", "10"}], "}"}]}], "]"}], "[", 
  RowBox[{"[", 
   RowBox[{"-", "1"}], "]"}], "]"}]], "Input",
 CellLabel->"In[183]:=",
 CellID->96426593,ExpressionUUID->"c240c89b-0b09-0441-b6bb-ae11ef1e194a"],

Cell[BoxData[
 FormBox[
  RowBox[{"-", 
   FractionBox[
    RowBox[{"\[Alpha]", " ", 
     TemplateBox[{"\[Alpha]"},
      "Conjugate"]}], "2"]}], TraditionalForm]], "Output",
 CellLabel->"Out[183]=",
 CellID->57652850,ExpressionUUID->"128963c0-1ca0-4740-a636-20ef0f9fcebb"]
}, Open  ]],

Cell[TextData[{
 "Or we can call the function ",
 StyleBox["BosonicExpOrder ", "FormattedFunction"],
 "for handling normal order of exponentials of ladder operators for some \
closed-form cases",
 StyleBox[":", "FormattedFunction"]
}], "Text",
 CellID->329534002,ExpressionUUID->"d54aec9e-6477-3f46-8d0a-ce50d1396e87"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BosonicExpOrder", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"\[Alpha]", " ", 
      SuperscriptBox["\[FormalA]", "\[Dagger]"]}], "-", 
     RowBox[{
      RowBox[{"\[Alpha]", "\[Conjugate]"}], " ", "\[FormalA]"}]}], "]"}], ",", 
   RowBox[{"\"\<Ordering\>\"", "->", "\"\<Normal\>\""}]}], "]"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->8969639,ExpressionUUID->"e382abc8-bca2-b64b-8db1-3082d870e7ff"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"\[Alpha]", " ", 
       TemplateBox[{"\[Alpha]"},
        "Conjugate"]}], "2"]}]], " ", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"\[Alpha]", " ", 
      SuperscriptBox["\[FormalA]", "\[Dagger]"]}]], "**", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[FormalA]"}], " ", 
      TemplateBox[{"\[Alpha]"},
       "Conjugate"]}]]}]}], TraditionalForm]], "Output",
 CellLabel->"Out[7]=",
 CellID->191022102,ExpressionUUID->"517fdb63-ff60-5649-8a7c-d803a3971c8e"]
}, Open  ]],

Cell[TextData[{
 "In this form we can apply the directly the exponential depending on ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["a", "^"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1d760586-e2ff-704a-95e3-9d024e8b3e7e"],
 " to the vacuum , expanding this exponential:"
}], "Text",
 CellID->97227518,ExpressionUUID->"794afa21-caec-eb46-bb39-d808fe9ce349"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{Cell[BoxData[
      FormBox[
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"\[Alpha]", "\[Conjugate]"}]}], " ", 
         OverscriptBox["a", "^"]}]], TraditionalForm]], "DisplayFormula",
      ExpressionUUID->"042dd69f-d066-fe44-bd7e-15d49a7c736d"], Cell[
     "|0\[RightAngleBracket]",ExpressionUUID->
      "c8d3974f-dfc2-6f42-b350-9da39470296f"]}], " ", "=", 
    RowBox[{
     UnderoverscriptBox[
      OverscriptBox["\[Sum]", " "], 
      RowBox[{"k", "=", "0"}], "\[Infinity]"], 
     RowBox[{Cell[BoxData[
       FormBox[
        StyleBox[
         SubscriptBox[
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"\[Alpha]", "\[Conjugate]"}]}], " ", 
              OverscriptBox["a", "^"]}], ")"}], "k"], 
           RowBox[{"k", "!"}]], "  "],
         FontSize->24], TraditionalForm]], "DisplayFormula",ExpressionUUID->
       "b3523475-a80a-f34c-b635-007cd8843c57"], Cell[
      "|0\[RightAngleBracket]",ExpressionUUID->
       "0ff48208-f3b5-3341-bc10-7597e4a44954"]}]}]}], "DisplayFormula"], 
  TraditionalForm]], "DisplayFormula",
 CellID->120362577,ExpressionUUID->"15ee9d93-fd33-9945-90af-5c2da7b9ce1a"],

Cell[TextData[{
 "Now we note that because the annihilation operator and their powers \
\[OpenCurlyDoubleQuote]kill\[CloseCurlyDoubleQuote] the vacuum state except \
when",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"k", " ", "=", " ", "0"}]}], TraditionalForm]],ExpressionUUID->
  "9a68e222-14b5-0a45-ab98-f90aa68fea36"],
 " , only the vacuum remains. The other exponential can also be expanded as"
}], "Text",
 CellID->393520439,ExpressionUUID->"27b940a4-d549-1c4a-93aa-3e113a31194a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox[
    RowBox[{Cell[BoxData[
      FormBox[
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[Alpha]", " ", 
         SuperscriptBox[
          OverscriptBox["a", "^"], "\[Dagger]"]}]], TraditionalForm]], 
      "DisplayFormula",
      FontSize->18,ExpressionUUID->"a7695d31-d941-2d4d-ba85-1a0c5bfbd77b"], 
     Cell["|0\[RightAngleBracket]",ExpressionUUID->
      "6a4c200a-ffb9-ff44-9f62-d8cc7511f358"]}], "DisplayFormula"], 
   StyleBox[" ", "DisplayFormula"], 
   StyleBox["=", "DisplayFormula"], 
   RowBox[{
    StyleBox[
     UnderoverscriptBox[
      OverscriptBox["\[Sum]", " "], 
      RowBox[{"n", "=", "0"}], "\[Infinity]"], "DisplayFormula"], 
    RowBox[{
     StyleBox[Cell[BoxData[
       FormBox[
        StyleBox[
         SubscriptBox[
          StyleBox[
           FractionBox[
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"\[Alpha]", " ", 
               SuperscriptBox[
                OverscriptBox["a", "^"], "\[Dagger]"]}], ")"}], "n"], 
            RowBox[{"n", "!"}]],
           FontSize->18], "  "],
         FontSize->20], TraditionalForm]], "DisplayFormula",ExpressionUUID->
       "f46cb4f5-a59f-4647-b016-c77b39d69376"], "DisplayFormula"], 
     StyleBox[Cell[
      "|0\[RightAngleBracket]",ExpressionUUID->
       "1f3cb299-8ce1-d543-9f2b-4318dfe4777e"], "DisplayFormula"], 
     StyleBox[Cell[
      "=",ExpressionUUID->"38156b04-8dc0-524f-b225-cbe5078fbf6c"], 
      "DisplayFormula"], 
     RowBox[{
      UnderoverscriptBox[
       OverscriptBox["\[Sum]", " "], 
       RowBox[{"n", "=", "0"}], "\[Infinity]"], 
      RowBox[{Cell[BoxData[
        FormBox[
         StyleBox[
          SubscriptBox[
           FractionBox[
            SuperscriptBox["\[Alpha]", "n"], 
            SqrtBox[
             RowBox[{"n", "!"}]]], "  "],
          FontSize->20], TraditionalForm]], "DisplayFormula",ExpressionUUID->
        "c0442515-092d-2d41-9f9f-3b7987178303"], Cell[TextData[{
        "|",
        Cell[BoxData[
         FormBox["n", TraditionalForm]],
         FormatType->TraditionalForm,ExpressionUUID->
         "e5ff9d68-aa36-2244-935b-5e1a2e3020fe"],
        "\[RightAngleBracket]"
       }],ExpressionUUID->"69a4e1d9-fa19-e947-b96b-32a737c099a7"]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->293486412,ExpressionUUID->"b575160a-58e1-8b44-94b8-662f31628ed2"],

Cell[TextData[{
 "because ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SuperscriptBox[
      OverscriptBox["a", "^"], "\[Dagger]"], ")"}], "n"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fbb30254-a659-b24d-9ab1-d35c1df6f59b"],
 "|0\[RightAngleBracket] = ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{"n", "!"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1e9f8717-aa6b-9c43-8d83-0638a1ef4907"],
 "|",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[RightAngleBracket]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bff95eee-8e54-f849-803c-52ba424197cd"],
 ",  finally including the normalization constant we see ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{"D", "(", "\[Alpha]", ")"}], " ", Cell[
     "|0\[RightAngleBracket]",ExpressionUUID->
      "d02169db-ae42-7d47-9f04-07120b929ed2"]}]}], TraditionalForm]],
  ExpressionUUID->"f4b8e05a-4e22-f248-b5c3-966c02f8b41f"],
 " is exactly the same as the definition of a coherent state"
}], "Text",
 CellID->44195517,ExpressionUUID->"79c5e3d3-f9d6-1544-9165-a580d3450cdb"],

Cell["\<\
Verifying symbolically the displacement operator main property , here we are \
omitting a normalization because quantum state equality works up to a \
multiplicative global constant:\
\>", "Text",
 CellChangeTimes->{{3.930678387918674*^9, 3.93067839569993*^9}, {
  3.9306784391257935`*^9, 3.9306784733313637`*^9}, {3.934202470542568*^9, 
  3.9342025242508316`*^9}, {3.9342026959195004`*^9, 3.934202698213354*^9}, {
  3.9537409298575726`*^9, 3.9537409326869545`*^9}, {3.9653032051274853`*^9, 
  3.9653032585947895`*^9}},
 CellID->28753805,ExpressionUUID->"0ae2e963-f5a6-7e43-aec4-ca0bd6968c20"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DisplacementOperator", "[", "\[Alpha]", "]"}], "[", "]"}], "==", 
  RowBox[{
   RowBox[{"CoherentState", "[", 
    RowBox[{"\"\<Normalized\>\"", "->", "False"}], "]"}], "[", "\[Alpha]", 
   "]"}]}]], "Input",
 CellLabel->"In[8]:=",
 CellID->7193361,ExpressionUUID->"29eb2d23-a04c-664b-b056-9524f6ca1eed"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[8]=",
 CellID->172722500,ExpressionUUID->"38b7d888-8625-f645-8283-7452061e72ac"]
}, Open  ]],

Cell[TextData[{
 "For calculations involving exponentials of ladder operators, the truncated \
representation has additional numerical error propagation due to [",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "5fd31324-8af1-a24d-b7b3-d1239b80fba1"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "39433dea-f803-1c44-8f65-b680a97d92ef"],
 Cell[BoxData[
  FormBox["]", TraditionalForm]],ExpressionUUID->
  "b28d278e-628a-1f46-aa60-7e92f94c446f"],
 " not being exactly the identity. Using a bigger space size or reducing the \
magnitude of \[Alpha] can control the desired precision."
}], "Text",
 CellID->355637384,ExpressionUUID->"00d7a8b7-2c16-3346-8073-2e5b0fe604be"],

Cell[TextData[StyleBox["Pick a value of \[Alpha]:", "Text"]], "CodeText",
 CellChangeTimes->{{3.9653032847520714`*^9, 3.9653032910040436`*^9}},
 CellID->161585040,ExpressionUUID->"29242bee-c34e-4e4b-a681-f3986ecc1357"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Alpha]random", " ", "=", " ", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"2", "+", 
       RowBox[{"2", "\[ImaginaryI]"}]}], ",", 
      RowBox[{"3", "+", 
