        StyleBox["\[Integral]", "Inactive"], #6, #7], 
       RowBox[{#, 
         RowBox[{
           StyleBox["\[DifferentialD]", "Inactive"], #5}], 
         RowBox[{
           StyleBox["\[DifferentialD]", "Inactive"], #2}]}]}]}]& ),
  InterpretationFunction->(RowBox[{
     RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
     RowBox[{#, ",", 
       RowBox[{"{", 
         RowBox[{#2, ",", #3, ",", #4}], "}"}], ",", 
       RowBox[{"{", 
         RowBox[{#5, ",", #6, ",", #7}], "}"}]}], "]"}]& )]], "Output",
 CellLabel->"Out[104]=",
 CellID->32515890,ExpressionUUID->"082879fe-4b53-de4e-8221-50c51594fee2"]
}, Open  ]],

