Cell[CellGroupData[{

Cell[TextData[{
 "Solving for what angle ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "(", "\[Theta]", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7fe62ecf-9889-964e-88c9-917fc7204972"],
 "|\[Psi]\[RightAngleBracket] ",
 Cell[BoxData[
  FormBox["-", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "151b2293-b2d2-a544-a9d5-0998085df1f2"],
 " |\[Psi]\[RightAngleBracket] is zero, keep only the roots representing real \
numbers:"
}], "ExerciseNote",
 CellID->8672030,ExpressionUUID->"579cc5ec-ae76-8a41-bd77-f4135251fb97"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Select", "[", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"MatrixExp", "[", 
            RowBox[{"\[ImaginaryI]", " ", "\[Theta]", " ", 
             RowBox[{
              SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], "]"}], "[", 
           "\[Psi]", "]"}], "-", "\[Psi]"}], ")"}], "[", "\"\<Norm\>\"", 
        "]"}], "2"], "==", "0"}], ",", "\[Theta]"}], "]"}], ",", 
   RowBox[{
    RowBox[{"RealValuedNumericQ", "[", 
     RowBox[{"#", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "&"}]}], 
  "]"}]], "ExerciseInput",
 CellLabel->"In[330]:=",
 CellID->332424807,ExpressionUUID->"51131396-003c-4d4a-825f-a6cd08d49746"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Theta]", "\[Rule]", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", " ", "\[Pi]"}], "3"]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", "\[Rule]", 
     FractionBox[
      RowBox[{"2", " ", "\[Pi]"}], "3"]}], "}"}]}], "}"}]], "ExerciseOutput",
 CellLabel->"Out[330]=",
 CellID->285969417,ExpressionUUID->"36e672fc-5945-a04d-b343-6b8e89f5869b"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Due to the way the state was constructed, it has a symmetry and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "(", 
    RowBox[{"2", 
     RowBox[{"\[Pi]", "/", "3"}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "735d6b4a-c4f7-1942-969f-f2cf259dc024"],
 " does not affect the state. We will explore more of this in the chapter \
related to phase space representations"
}], "ExerciseNote",
 CellID->473297584,ExpressionUUID->"c3553525-5fa8-154b-bb7f-25e68daebd2a"],

Cell[TextData[{
 "Consider the Kerr non-linear Hamiltonian \[Chi] (",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "1e33331f-a798-a042-90f0-93086e36e593"],
 "a",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[")", "2"], TraditionalForm]],ExpressionUUID->
  "f9fcea11-f670-8b4e-b832-3812055115d1"],
 ". Describe the evolution a coherent state only under this Hamiltonian. Plot \
the fidelity of the evolved state respect to the initial coherent state. Do \
you see a periodic behavior? We consider \[HBar] = 1, use an appropriate \
value of \[Chi] and well a represented coherent state in the chosen \
truncation size"
}], "Exercise",
 CellFrame->{{0, 0}, {0, 0.5}},
