Cell[TextData[{
 "Fluctuations of the number operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalDelta]", " ", "n"}], " ", "=", 
    RowBox[{
     SqrtBox[
      RowBox[{
       RowBox[{
       Cell["|",ExpressionUUID->"8a39a615-5830-7842-a801-40fa79e5e35e"], 
        "\[Alpha]", 
        SuperscriptBox[Cell[
         "|",ExpressionUUID->"2223dc01-6b2b-084c-b345-157858d20afd"], "4"]}], 
       "+", 
       RowBox[{
       Cell["|",ExpressionUUID->"db8cd270-2e96-bf42-a7f3-43734bbc0b33"], 
        "\[Alpha]", 
        SuperscriptBox[Cell[
         "|",ExpressionUUID->"88c7d26e-c965-4241-9258-9bdeb70eb1e0"], "2"]}], 
       "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
         Cell["|",ExpressionUUID->"f6f50230-1492-8447-a493-d8018a0c2fa1"], 
          "\[Alpha]", 
          
          SuperscriptBox[Cell[
           "|",ExpressionUUID->"2d747405-f3fb-2d43-8612-f33c313f2bbc"], 
           "2"]}], ")"}], "2"]}]], "=", 
     RowBox[{
      SqrtBox[
       OverscriptBox["n", "\[LongDash]"]], "="}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1d0ae383-08e9-f240-839d-a682ea49b0f1"],
 "|\[Alpha]|"
}], "Text",
 CellID->148018345,ExpressionUUID->"f97c366f-3036-c943-b5ee-27c0a901a881"],

Cell["Compute fluctuations for a symbolic coherent state:", "Text",
 CellID->139111431,ExpressionUUID->"396765ee-5c36-4a43-8a52-ef6452722bda"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fluctuations", "=", 
   SqrtBox[
    RowBox[{"OperatorVariance", "[", 
     RowBox[{
      RowBox[{"CoherentState", "[", "]"}], ",", "numberOp"}], "]"}]]}], 
  ";"}]], "Input",
 CellLabel->"In[141]:=",
 CellID->850371637,ExpressionUUID->"64ca8c08-7648-864f-b889-ed9b51b27c2d"],

