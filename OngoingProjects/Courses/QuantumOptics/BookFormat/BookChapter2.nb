Cell["\<\
So coherent states are quantum states with classical-like  features because:\
\>", "Text",
 CellChangeTimes->{{3.930673780670952*^9, 3.9306738408292503`*^9}},
 CellID->265793217,ExpressionUUID->"987b5e7b-560b-fd47-ad52-0d73020c0ed1"],

Cell["\<\
Mean value of electric field has the form of a classical expression\
\>", "Subsubitem",
 CellChangeTimes->{{3.930673854231632*^9, 3.930673874453335*^9}},
 CellID->140568060,ExpressionUUID->"ffcce683-1ea5-4d4f-9c9e-be6bdf09a957"],

Cell[" Electric field fluctuations are those of the vacuum", "Subsubitem",
 CellChangeTimes->{{3.930673854231632*^9, 3.9306738915750637`*^9}},
 CellID->25468615,ExpressionUUID->"b42a308d-5f1e-084b-bffe-f47fa23b7163"],

Cell["\<\
Fluctuations in the photon number decrease when the mean photon number \
increases \
\>", "Subsubitem",
 CellChangeTimes->{{3.930673854231632*^9, 3.930673890870199*^9}, {
  3.9306739395075245`*^9, 3.9306739666987476`*^9}},
 CellID->502006369,ExpressionUUID->"d1d80174-b73d-da40-9233-059fbaaee802"],

Cell["\<\
Their phase becomes more localized when the mean photon number increases\
\>", "Subsubitem",
 CellChangeTimes->{{3.930673854231632*^9, 3.930673890870199*^9}, {
  3.9306739395075245`*^9, 3.9306740109874763`*^9}},
 CellID->3514026,ExpressionUUID->"155dd1ae-f2d7-844a-8da7-05a297b99ed3"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Displacement operator and displaced vacuum states", \
"Subsection"]], "Subsection",
 CellChangeTimes->{{3.928261713770573*^9, 3.928261728791712*^9}, {
  3.9306746535971184`*^9, 3.93067465854142*^9}},
 CellID->221500748,ExpressionUUID->"e27405a4-7487-cd49-9f7f-266cd2de6fea"],

Cell["\<\
There exists an equivalent definition of a coherent state that is based on \
displacing the vacuum state , it gives more insight why coherent states have \
must have the uncertainty of the vacuum. The generator is the displacement \
operator, it is defined as:\
\>", "Text",
 CellChangeTimes->{{3.9306743332504387`*^9, 3.9306744437469063`*^9}, {
  3.9306744755276985`*^9, 3.930674511154604*^9}, {3.9653028299439316`*^9, 
  3.965302835166052*^9}, {3.9653202493140945`*^9, 3.9653202587334843`*^9}},
 CellID->26326210,ExpressionUUID->"57ee26a9-d8ab-b842-8965-0897794b04c9"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{
     OverscriptBox["D", "^"], 
     RowBox[{"(", "\[Alpha]", ")"}]}], "=", " ", 
    RowBox[{"exp", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Alpha]", " ", 
        SuperscriptBox[
         OverscriptBox["a", "^"], "\[Dagger]"]}], "-", 
       RowBox[{
        RowBox[{"\[Alpha]", "\[Conjugate]"}], 
        OverscriptBox["a", "^"]}]}], ")"}]}]}], "Text"], 
  TraditionalForm]], "DisplayFormula",
 CellID->190823563,ExpressionUUID->"32ee765b-942a-9b42-ad3c-7075b4e15f86"],

Cell["And a coherent state can be build as:", "Text",
 CellChangeTimes->{{3.965302724216196*^9, 3.9653027354202976`*^9}},
 CellID->616125700,ExpressionUUID->"6ffe8c2e-88cf-7d42-b17a-000723f7d5d6"],

Cell[BoxData[
 StyleBox[
  RowBox[{
  Cell["|\[Alpha]\[RightAngleBracket]",ExpressionUUID->
    "84510174-c8aa-a143-bf50-fd4be1986499"], "=", 
   RowBox[{
    FormBox[
     RowBox[{
      OverscriptBox["D", "^"], "(", "\[Alpha]", ")"}],
     TraditionalForm], Cell[
    "|0\[RightAngleBracket]",ExpressionUUID->
     "a973c006-1a35-8a4f-845b-7ea2398327c1"]}]}], "Text"]], "DisplayFormula",
 CellID->75171067,ExpressionUUID->"f49c9870-f733-7445-83f0-4f4e1cc4a5f1"],

Cell[TextData[{
 "Using the disentangling theorem ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     OverscriptBox["A", "^"], "+", 
     OverscriptBox["B", "^"]}]], TraditionalForm]],ExpressionUUID->
  "ef7dfe85-aa56-9a49-90dc-0a7711a174a6"],
 "= ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     OverscriptBox["A", "^"]], 
    SuperscriptBox["\[ExponentialE]", 
     OverscriptBox["B", "^"]], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "1"}], "/", 
      RowBox[{"2", "[", 
       RowBox[{
        OverscriptBox["A", "^"], ",", 
        OverscriptBox["B", "^"]}], "]"}]}]]}], TraditionalForm]],
  ExpressionUUID->"f495c64d-c8f6-2c40-b9c4-d2179128c7c0"],
 "  valid when [",
 Cell[BoxData[
  FormBox[
   OverscriptBox["A", "^"], TraditionalForm]],ExpressionUUID->
  "e733b805-ea46-0346-99da-4fec2d014656"],
 ",",
 Cell[BoxData[
  FormBox[
   OverscriptBox["B", "^"], TraditionalForm]],ExpressionUUID->
  "7f5db442-40ce-5b49-82c0-6b3119dcdea8"],
 "] \[NotEqual] 0  but  [",
 Cell[BoxData[
  FormBox[
   OverscriptBox["A", "^"], TraditionalForm]],ExpressionUUID->
  "c174ed45-0f17-7447-8fcf-cad74fb51af2"],
 ",[",
 Cell[BoxData[
  FormBox[
   OverscriptBox["A", "^"], TraditionalForm]],ExpressionUUID->
  "393c34e8-7b04-e840-9946-958929200cb6"],
 ",",
 Cell[BoxData[
  FormBox[
   OverscriptBox["B", "^"], TraditionalForm]],ExpressionUUID->
  "9b7a975b-b06c-f24b-ba2c-f24e67b360c4"],
 "]] = [",
 Cell[BoxData[
  FormBox[
   OverscriptBox["B", "^"], TraditionalForm]],ExpressionUUID->
  "66d1d206-ddec-d240-8893-9b86fdd9f48e"],
 ",[",
 Cell[BoxData[
  FormBox[
   OverscriptBox["A", "^"], TraditionalForm]],ExpressionUUID->
  "7a0d9389-3fbf-6349-b259-6e5003746599"],
 ",",
 Cell[BoxData[
  FormBox[
   OverscriptBox["B", "^"], TraditionalForm]],ExpressionUUID->
  "9bfdc0c9-7a3e-a149-9fa2-29b9ceb68f86"],
 "]] = 0  hold, so the displacement operator takes the following form in \
normal order:"
}], "Text",
 CellID->8776988,ExpressionUUID->"bdfec196-8499-4747-ad33-dc8440061aea"],

Cell[BoxData[
 FormBox[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["D", "^"], "(", "\[Alpha]", ")"}], "=", " ", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}], " ", "|", "\[Alpha]", 
       SuperscriptBox["|", "2"]}]], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[Alpha]", " ", 
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"]}]], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"\[Alpha]", "\[Conjugate]"}]}], " ", 
       OverscriptBox["a", "^"]}]]}]}],
   TraditionalForm], TraditionalForm]], "DisplayFormula",
 FontSize->18,
 CellID->120942169,ExpressionUUID->"830c1ff4-9f36-dd41-9ea5-7051f6da6802"],

Cell[TextData[{
 StyleBox["We can check this rearrangement using non-commutative algebra, we \
just recover the prefactor , because the product of separated terms comes \
automatically from the Zassenhaus expansion definition ", "Text"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"A", "+", "B"}]], "=", " ", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", "A"], 
     SuperscriptBox["\[ExponentialE]", "B"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "de616f46-883e-254e-8431-52f0a2130d86"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Product]", 
     RowBox[{" ", 
      RowBox[{"n", "=", "2"}]}], 
     RowBox[{" ", "\[Infinity]"}]], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      SubscriptBox["C", "n"], "(", 
      RowBox[{"A", ",", "B"}], ")"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "50bd8c53-5453-3f47-8346-51e118afecae"],
 StyleBox[" :", "Text"]
}], "Text",
 CellID->311358543,ExpressionUUID->"ee7a547b-c53d-cc41-beee-4a88cb326b6a"],

Cell[TextData[{
 StyleBox["Load the ", "Text"],
 StyleBox["ZassenhausTerms", "FormattedFunction"],
 StyleBox[" function:", "Text"]
}], "CodeText",
 CellID->560510211,ExpressionUUID->"fba83f6e-8f06-4246-a75f-501934f64a9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"zassen", " ", "=", 
   RowBox[{"ResourceFunction", "[", "\"\<ZassenhausTerms\>\"", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.969559341746668*^9, 3.9695593512008457`*^9}},
