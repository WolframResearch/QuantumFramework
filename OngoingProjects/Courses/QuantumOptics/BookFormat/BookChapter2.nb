 CellLabel->"In[140]:=",
 CellID->381919190,ExpressionUUID->"e810113f-917d-5947-bb6f-d99422768af5"],

Cell[BoxData[
 GraphicsBox[
  InterpretationBox[{
    TagBox[{{{}, {}, 
       TagBox[
