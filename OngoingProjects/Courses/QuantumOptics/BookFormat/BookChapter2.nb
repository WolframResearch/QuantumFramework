Cell[TextData[StyleBox["Specify the algebra:", "Text"]], "CodeText",
 CellChangeTimes->{{3.969560579134207*^9, 3.96956058361162*^9}},
 CellID->6995664,ExpressionUUID->"6b1a572f-eae6-bd48-8c0a-487037183611"],

Cell[BoxData[
 RowBox[{
  RowBox[{"alg", " ", "=", 
   RowBox[{"NonCommutativeAlgebra", "[", 
    RowBox[{"\"\<Generators\>\"", "->", 
     RowBox[{"{", 
      RowBox[{"\[FormalA]", ",", 
       SuperscriptBox["\[FormalA]", "\[Dagger]"]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[41]:=",
 CellID->67425313,ExpressionUUID->"c7b7c912-d6b7-ad4f-a231-6a3ae2a99d45"],

Cell[TextData[StyleBox["Compute the result up to seventh order:", "Text"]], \
"CodeText",
 CellID->411559490,ExpressionUUID->"7a1ae40e-6e4f-ba40-bcbf-826adadf8949"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"NonCommutativePolynomialReduce", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"BCH", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Alpha]", " ", 
            SuperscriptBox["\[FormalA]", "\[Dagger]"]}], "-", 
           RowBox[{
            RowBox[{"\[Alpha]", "\[Conjugate]"}], "\[FormalA]"}]}], ",", 
          RowBox[{
           RowBox[{"\[Beta]", " ", 
            SuperscriptBox["\[FormalA]", "\[Dagger]"]}], "-", 
           RowBox[{
            RowBox[{"\[Beta]", "\[Conjugate]"}], "\[FormalA]"}]}]}], "}"}], ",",
         "n"}], "]"}], ",", "\[IndentingNewLine]", "rels", ",", 
      "\[IndentingNewLine]", "alg"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"-", "1"}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "1", ",", "7"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[46]:=",
 CellID->3251681,ExpressionUUID->"e0db3872-d4a7-e34a-9f35-6feac71e8545"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[Alpha]", "+", "\[Beta]"}], ")"}], " ", 
    SuperscriptBox["\[FormalA]", "\[Dagger]"]}], "+", 
   RowBox[{"\[FormalA]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       TemplateBox[{"\[Alpha]"},
        "Conjugate"]}], "-", 
      TemplateBox[{"\[Beta]"},
       "Conjugate"]}], ")"}]}], "-", 
   FractionBox[
    RowBox[{"\[Beta]", " ", 
     TemplateBox[{"\[Alpha]"},
      "Conjugate"]}], "2"], "+", 
   FractionBox[
    RowBox[{"\[Alpha]", " ", 
     TemplateBox[{"\[Beta]"},
      "Conjugate"]}], "2"]}], TraditionalForm]], "Output",
 CellLabel->"Out[46]=",
 CellID->127736976,ExpressionUUID->"83fce15e-892f-8440-b63c-10b0a50374da"]
}, Open  ]],

Cell[TextData[{
 StyleBox["DisplacementOperator", "FormattedFunction"],
 " also accepts the \[Infinity] size to denote the exact symbolic expression, \
for example, we can define two displacement operators with parameters \
\[Alpha] and \[Beta]:"
}], "Text",
 CellID->602399576,ExpressionUUID->"a670cc18-1147-f544-87a2-e176b975442c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"disps", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"DisplacementOperator", "[", 
     RowBox[{"#", ",", "\[Infinity]"}], "]"}], "&"}], "/@", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]}]}]], "Input",
 CellLabel->"In[22]:=",
 CellID->310782711,ExpressionUUID->"3871b96b-7064-464e-b293-f979ee36e1ab"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"\[Alpha]", " ", 
       SuperscriptBox["\[FormalA]1", "\[Dagger]"]}], "-", 
      RowBox[{"\[FormalA]1", " ", 
       TemplateBox[{"\[Alpha]"},
        "Conjugate"]}]}]], ",", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"\[Beta]", " ", 
       SuperscriptBox["\[FormalA]1", "\[Dagger]"]}], "-", 
      RowBox[{"\[FormalA]1", " ", 
       TemplateBox[{"\[Beta]"},
        "Conjugate"]}]}]]}], "}"}], TraditionalForm]], "Output",
 CellLabel->"Out[22]=",
 CellID->775679719,ExpressionUUID->"b959d145-9a12-3e43-90e5-b38d65e74c32"]
}, Open  ]],

Cell[TextData[{
 StyleBox["BosonicExpSimplify", "FormattedFunction"],
 " can be used to transform the non-commutative product of the two \
displacement operators, to recover the same result:"
}], "Text",
 CellID->629154085,ExpressionUUID->"03759acc-f4d6-094a-9ac1-cc5b8e797841"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BosonicExpSimplify", "[", 
  RowBox[{"NonCommutativeMultiply", "@@", "disps"}], "]"}]], "Input",
 CellLabel->"In[27]:=",
 CellID->335592494,ExpressionUUID->"be8b6bba-8879-dc4a-ae0a-6a9c7a94da6f"],

Cell[BoxData[
 FormBox[
  RowBox[{"exp", "(", 
   RowBox[{
    RowBox[{"\[Alpha]", " ", 
     SuperscriptBox["\[FormalA]1", "\[Dagger]"]}], "+", 
    RowBox[{"\[Beta]", " ", 
     SuperscriptBox["\[FormalA]1", "\[Dagger]"]}], "-", 
    RowBox[{"\[FormalA]1", " ", 
     TemplateBox[{"\[Alpha]"},
      "Conjugate"]}], "-", 
    RowBox[{"\[FormalA]1", " ", 
     TemplateBox[{"\[Beta]"},
      "Conjugate"]}], "+", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Alpha]", " ", 
        TemplateBox[{"\[Beta]"},
         "Conjugate"]}], "-", 
       RowBox[{"\[Beta]", " ", 
        TemplateBox[{"\[Alpha]"},
         "Conjugate"]}]}], ")"}]}]}], ")"}], TraditionalForm]], "Output",
 CellLabel->"Out[27]=",
 CellID->47747799,ExpressionUUID->"2973a30a-2a89-5b40-b5d6-d02c094c73f9"]
}, Open  ]],

Cell["\<\
Intuitively if we do a displacement of \[Alpha] and then a displacement of \
\[Beta], the net displacement is \[Alpha] + \[Beta], so we get a coherent \
state with amplitude \[Alpha] + \[Beta] up to a global phase:\
\>", "Text",
 CellID->347638786,ExpressionUUID->"e4836127-c992-cc44-8741-bb581a1b750d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     OverscriptBox["D", "^"], "(", "\[Alpha]", ")"}], 
    RowBox[{
     OverscriptBox["D", "^"], "(", "\[Beta]", ")"}], Cell[
    "|",ExpressionUUID->"dc6810ef-9fd0-1945-8d88-d46e52af0e46"], "0", Cell[
    "\[RightAngleBracket]",ExpressionUUID->
     "f2d5f439-620e-774d-83e9-5a111c174fdd"]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      OverscriptBox["D", "^"], "(", "\[Alpha]", ")"}], Cell[
     "|",ExpressionUUID->"3a3c484b-1efb-9142-8d1f-4bac637f6523"], "\[Beta]", 
     Cell["\[RightAngleBracket]",ExpressionUUID->
      "5f1e069b-1f00-c648-83fc-db35973b0263"]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"exp", "(", 
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"Im", "(", 
         RowBox[{"\[Alpha]", " ", 
          RowBox[{"\[Beta]", "\[Conjugate]"}]}], ")"}]}], ")"}], " ", Cell[
      "|",ExpressionUUID->"9fa82c8e-c887-da48-9aa8-0ec4795c308e"], 
      "\[Alpha]"}], " ", "+", " ", 
     RowBox[{
     "\[Beta]", Cell[
      "\[RightAngleBracket]",ExpressionUUID->
       "ea22e3e7-52eb-ae40-a99b-b584f28a8139"]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 FontSize->18,
 CellID->12112534,ExpressionUUID->"1480323d-e57c-c140-a864-a99ffbe7dde7"],

Cell[TextData[StyleBox["Pick values of \[Alpha] and \[Beta]:", "Text"]], \
"CodeText",
 CellChangeTimes->{{3.9695607527892323`*^9, 3.9695607608372135`*^9}},
 CellID->185953145,ExpressionUUID->"8d800214-5dc6-bf4c-8b0e-773012c55560"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "100", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Alpha]random", ",", "\[Beta]random"}], "}"}], "=", " ", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "-", 
        RowBox[{"2", "I"}]}], ",", 
       RowBox[{"2", "+", 
        RowBox[{"2", "I"}]}]}], "}"}], ",", "2"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[28]:=",
 CellID->206859100,ExpressionUUID->"4529c77e-65bf-234d-bdc1-3126c71b1586"],

Cell["\<\
We consider a bigger size because we are composing displacements:\
\>", "Text",
 CellID->611582394,ExpressionUUID->"f947f776-87ac-4a46-a0b6-0bbc2d2be7ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "50", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9306834809474106`*^9, 3.930683488803051*^9}, {
  3.934217599798378*^9, 3.9342176110420017`*^9}},
 CellLabel->"In[31]:=",
 CellID->887785149,ExpressionUUID->"b9b14e0e-1a7b-af48-b559-b9bc711ce00b"],

Cell[TextData[StyleBox["Composition of displacement operators applied to the \
state |0\[RightAngleBracket]:", "Text"]], "CodeText",
 CellID->74462877,ExpressionUUID->"512e95b8-f256-0646-b5ff-e316ce3ba801"],

Cell[BoxData[
 RowBox[{
  RowBox[{"composedDisplacement", " ", "=", 
   RowBox[{
    RowBox[{"DisplacementOperator", "[", "\[Alpha]random", "]"}], "@", 
    RowBox[{
     RowBox[{"DisplacementOperator", "[", "\[Beta]random", "]"}], "[", 
     "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9695608235883656`*^9, 3.9695608346030807`*^9}},
 CellLabel->"In[34]:=",
 CellID->141058297,ExpressionUUID->"e159a1c4-fc2b-6147-9bc8-09ed03788526"],

Cell[TextData[StyleBox["Result using the coherent state  |\[Alpha] + \[Beta] \
\[RightAngleBracket] with a global phase:", "Text"]], "CodeText",
 CellID->516293936,ExpressionUUID->"7499264f-db49-704b-8cf9-eaee4333e441"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coherentresult", " ", "=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"Im", "[", 
       RowBox[{"\[Alpha]random", " ", 
        RowBox[{"\[Beta]random", "\[Conjugate]"}]}], "]"}]}], "]"}], 
    RowBox[{
     RowBox[{"CoherentState", "[", "]"}], "[", 
     RowBox[{"\[Alpha]random", " ", "+", " ", "\[Beta]random"}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[35]:=",
 CellID->151667143,ExpressionUUID->"b0f5576e-b416-264f-95a9-1fbd2d424d4b"],

Cell["\<\
\[OpenCurlyDoubleQuote]AmplitudeList\[CloseCurlyDoubleQuote] returns non zero \
amplitudes, so the empty list means the states are numerically the same:\
\>", "Text",
 CellID->105632571,ExpressionUUID->"b5bece7d-ab3d-214d-9f42-9c80e3305414"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"composedDisplacement", "-", "coherentresult"}], ")"}], 
  "[", "\"\<AmplitudeList\>\"", "]"}]], "Input",
 CellLabel->"In[38]:=",
 CellID->188711742,ExpressionUUID->"3a51ac04-77cd-c24a-89de-2882725540f3"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",
 CellLabel->"Out[38]=",
 CellID->257899909,ExpressionUUID->"b0be9237-b8a4-f44f-ae4a-19435adb779e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Wave packets and time evolution", "Subsection"]], \
"Subsection",
 CellChangeTimes->{{3.92826174048374*^9, 3.928261744975685*^9}},
 CellID->72228754,ExpressionUUID->"ec25e493-12ac-f24a-a753-9ca1c28b3a1d"],

Cell[TextData[{
 "The position operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["q", "^"], " ", "is", " ", "defined"}], TraditionalForm]],
  ExpressionUUID->"849b874d-ef87-e642-abf3-ad2ded460613"],
 ", such that ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["q", "^"], TraditionalForm]],ExpressionUUID->
  "b4fe4099-396f-0e40-ae3e-3f6b0bb2954f"],
 " ",
 Cell[BoxData[
  FormBox[Cell[TextData[{
    "|",
    Cell[BoxData[
     FormBox["q", TraditionalForm]],ExpressionUUID->
     "45b0bf56-9de2-5348-a76a-94756119845d"],
    "\[RightAngleBracket]"
   }],ExpressionUUID->"593684c1-818e-664e-963e-69368a78d228"], 
   TraditionalForm]],ExpressionUUID->"18584a0c-ce7e-df48-a0c4-f3bb4b461b36"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", " ", Cell[TextData[{
     "|",
     Cell[BoxData[
      FormBox["q", TraditionalForm]],ExpressionUUID->
      "e7077bcc-6a2a-214f-9be1-de4f58fb880b"],
     "\[RightAngleBracket]"
    }],ExpressionUUID->"a40336bf-8f5c-4e4a-b81b-15f1ee8ccf4b"]}], 
   TraditionalForm]],ExpressionUUID->"009f4322-e530-5344-a6fd-a6f4ca7eedf0"],
 " describes the position eigenstates, in terms of ladder operators can be \
written as:"
}], "Text",
 CellChangeTimes->{{3.930743647167815*^9, 3.93074376972863*^9}, {
  3.933695168003647*^9, 3.933695169590749*^9}, {3.965322642705202*^9, 
  3.9653226599203205`*^9}, {3.9695610068570004`*^9, 3.969561010783407*^9}},
 CellID->421904392,ExpressionUUID->"7361a750-bd9c-4c4f-9f28-782d0c5d8b37"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox[
    OverscriptBox["q", "^"],
    FontSize->18], " ", "=", 
   RowBox[{
    RowBox[{
     SqrtBox[
      FractionBox["\[HBar]", 
       RowBox[{"2", " ", "m", " ", "\[Omega]"}]]], 
     RowBox[{"(", 
      RowBox[{
       OverscriptBox["a", "^"], "+", 
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"]}], ")"}]}], " ", "=", 
    RowBox[{
     SqrtBox[
      FractionBox[
       StyleBox["\[HBar]",
        FontSize->14], 
       RowBox[{"m", " ", "\[Omega]"}]]], 
     OverscriptBox[
      SubscriptBox["X", "1"], "^"]}]}]}], TraditionalForm]], "DisplayFormula",
 CellID->364769191,ExpressionUUID->"7d6fad78-4e40-6d48-b2be-413c3575a713"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "20", "]"}], ";"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->173925608,ExpressionUUID->"675da20a-f19e-0348-ad67-8b6ff3a71814"],

Cell[TextData[StyleBox["Define the position operator:", "Text"]], "CodeText",
 CellChangeTimes->{{3.965322687481716*^9, 3.965322692154457*^9}},
 CellID->65373409,ExpressionUUID->"f0ac6187-819d-554e-a28f-28fe93d997dd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"q", " ", "=", " ", 
   RowBox[{
    SqrtBox[
     RowBox[{
      FractionBox["h", 
       RowBox[{"m", " ", "\[Omega]"}]], " "}]], " ", 
    RowBox[{
     RowBox[{"QuadratureOperators", "[", "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.930740239828523*^9, 3.930740262519783*^9}, {
   3.93074189853486*^9, 3.93074191010317*^9}, 3.930741964761982*^9, {
   3.9342262322494717`*^9, 3.9342262328351536`*^9}, {3.9342263365627213`*^9, 
   3.9342263628405704`*^9}, 3.934226402734474*^9},
 CellLabel->"In[8]:=",
 CellID->3863137,ExpressionUUID->"628a0a0b-94ad-f744-b32f-962c64c70045"],

Cell["\<\
The Fock states wave functions are the following (derivations can be found in \
standard quantum mechanics textbooks regarding a quantum harmonic oscillator):\
\>", "Text",
 CellChangeTimes->{{3.930742641214775*^9, 3.930742720296711*^9}, {
   3.930742899904163*^9, 3.9307429002606373`*^9}, {3.9307437618243656`*^9, 
   3.930743780047645*^9}, {3.93074724463328*^9, 3.930747277856961*^9}, {
   3.931520120783432*^9, 3.931520235632183*^9}, 3.9653227082207737`*^9},
 CellID->19696550,ExpressionUUID->"5e81eb9e-56b6-5948-8a70-3e6b4cfaaabe"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]", "n"], "(", "q", ")"}], "=", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"m", " ", "\[Omega]"}], 
       RowBox[{"\[Pi]", " ", "\[HBar]"}]], ")"}], 
     RowBox[{"1", "/", "4"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["2", "n"], 
       RowBox[{"n", "!"}]}], ")"}], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]], 
    RowBox[{
     SubscriptBox["H", "n"], "(", "\[Xi]", ")"}], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["\[Xi]", "2"]}], "/", "2"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 FontSize->18,
 CellID->26638433,ExpressionUUID->"ad0c4b0e-e966-c14b-8bf5-48fe011d42cf"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Xi]", "=", " ", 
    RowBox[{"q", 
     SqrtBox[
      RowBox[{"m", " ", 
       RowBox[{"\[Omega]", "/", "\[HBar]"}]}]]}]}], TraditionalForm]],
  ExpressionUUID->"0952166a-7ed3-144b-a3d4-ddf50877d3eb"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "n"], TraditionalForm]],ExpressionUUID->
  "50973694-3528-e34e-9dd3-08ca82b71830"],
 " are Hermite polynomials:"
}], "Text",
 CellID->159073160,ExpressionUUID->"5b3cfb0e-b49c-474d-bd73-5cec7350d4ff"],

Cell["Then the wave function for a coherent state is:", "Text",
 CellChangeTimes->{{3.93152003977309*^9, 3.931520053957964*^9}, {
  3.9315202466308956`*^9, 3.9315202931599083`*^9}, {3.965322859873396*^9, 
  3.965322875326353*^9}},
 CellID->29476923,ExpressionUUID->"a3e8d04c-68c2-6c4d-87a4-fe1035452d0e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]", "\[Alpha]"], "(", "q", ")"}], "=", 
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"q", "|", "\[Alpha]"}], "\[RightAngleBracket]"}], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"m", " ", "\[Omega]"}], 
        RowBox[{"\[Pi]", " ", "\[HBar]"}]], ")"}], 
      RowBox[{"1", "/", "4"}]], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       RowBox[{"|", "\[Alpha]", 
        SuperscriptBox["|", "2"], 
        RowBox[{"/", "2"}]}]}]], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[Xi]", "2"]}], "/", "2"}]], " ", 
     RowBox[{
      UnderoverscriptBox[
       OverscriptBox[
        StyleBox["\[Sum]",
         FontSize->18], " "], 
       RowBox[{"n", "=", "0"}], "\[Infinity]"], 
      RowBox[{
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Alpha]", "/", 
           SqrtBox["2"]}], ")"}], "n"], 
        RowBox[{"n", "!"}]], " ", 
       RowBox[{
        SubscriptBox["H", "n"], "(", "\[Xi]", ")"}]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->486247426,ExpressionUUID->"0a65beff-8a1f-9c45-abf8-1690b806657c"],

Cell[TextData[{
 "It can be simplified and it takes the form of a gaussian, and the \
probability distribution ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{
     SubscriptBox["\[Psi]", "\[Alpha]"], "(", "q", ")"}], 
    SuperscriptBox["|", "2"]}], TraditionalForm]],ExpressionUUID->
  "ce8669d9-6262-4647-a500-7271a9fc96b5"],
 " also takes the form of a gaussian"
}], "Text",
 CellChangeTimes->{{3.9315213436381016`*^9, 3.931521348168501*^9}, {
  3.931523343856003*^9, 3.9315234092241993`*^9}},
 CellID->920759841,ExpressionUUID->"7cb60ea2-bef2-bd44-b8d8-a567099d46b5"],

Cell[TextData[StyleBox["Perform the simplification symbolically:", "Text"]], \
"CodeText",
 CellChangeTimes->{{3.9653230168731136`*^9, 3.965323024025419*^9}},
 CellID->6854500,ExpressionUUID->"9578c1f2-3162-7a43-a865-497b20f4bd91"],

Cell[BoxData[
 RowBox[{
  RowBox[{"waveFuncCoh", " ", "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"m", " ", "\[Omega]"}], 
        RowBox[{"\[Pi]", " ", "h"}]], ")"}], 
      RowBox[{"1", "/", "4"}]], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"Abs", "[", "\[Alpha]", "]"}], "2"]}], "/", "2"}]], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[Xi]", "2"]}], "/", "2"}]], 
     SuperscriptBox["\[ExponentialE]", 
      SuperscriptBox["\[Xi]", "2"]], 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"-", 
          SuperscriptBox["\[Xi]", "2"]}]], " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", "z", ")"}], "n"], "/", 
            RowBox[{"n", "!"}]}], 
           RowBox[{"HermiteH", "[", 
            RowBox[{"n", ",", "\[Xi]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}]}], 
       ")"}], "]"}]}], "/.", 
    RowBox[{"z", "->", 
     RowBox[{"\[Alpha]", "/", 
      SqrtBox["2"]}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9315152912763176`*^9, 3.931515338287298*^9}, {
   3.931515387910383*^9, 3.931515479245445*^9}, {3.9315156638523045`*^9, 
   3.931515740540016*^9}, {3.931515901755476*^9, 3.931515937648969*^9}, {
   3.931516072107056*^9, 3.9315162217406*^9}, {3.931516298788519*^9, 
   3.9315163553067207`*^9}, {3.931516487268301*^9, 3.9315165067576528`*^9}, {
   3.9315169471300297`*^9, 3.9315170333184357`*^9}, {3.931517094417364*^9, 
   3.9315171503242226`*^9}, {3.931517399926124*^9, 3.931517551140505*^9}, {
   3.931517608922419*^9, 3.93151761238027*^9}, {3.931517727626852*^9, 
   3.931517728036724*^9}, {3.9315177853327045`*^9, 3.931517827460572*^9}, 
   3.931518186986089*^9, {3.9315182722108326`*^9, 3.931518284815937*^9}, {
   3.9315184255615063`*^9, 3.931518429051647*^9}, {3.9315184665328503`*^9, 
   3.931518569961765*^9}, {3.9315186142432985`*^9, 3.931518673323353*^9}, {
   3.931518704162354*^9, 3.9315187331004124`*^9}, 3.931518991002182*^9, {
   3.931519498977728*^9, 3.931519521081375*^9}, {3.931519671068342*^9, 
   3.9315196968605976`*^9}, {3.9315198396888685`*^9, 3.931519998437908*^9}, {
   3.931521272795569*^9, 3.931521313506176*^9}, {3.931522143458137*^9, 
   3.931522143882829*^9}, {3.931523429926527*^9, 3.931523457713648*^9}, {
   3.934226461725338*^9, 3.934226468808647*^9}, 3.965323042967144*^9},
 CellLabel->"In[9]:=",
 CellID->185857200,ExpressionUUID->"9d8ccbf3-ea20-7c4d-a620-212de3c09d71"],

