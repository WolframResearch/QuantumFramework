 CellChangeTimes->{{3.9653237169516506`*^9, 3.9653237339515305`*^9}},
 CellID->15119244,ExpressionUUID->"19b77bff-2163-b248-a8d0-a20287ef781a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", "\[Beta]c", "]"}], " ", "\[Alpha]c"}], "-", 
      RowBox[{"\[Beta]c", " ", 
       RowBox[{"Conjugate", "[", "\[Alpha]c", "]"}]}]}], ")"}]}], "]"}], " ", 
  
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], " ", 
    SuperscriptBox[
     RowBox[{"Abs", "[", 
      RowBox[{"\[Beta]c", "-", "\[Alpha]c"}], "]"}], "2"]}], "]"}]}]], "Input",\

 CellLabel->"In[27]:=",
 CellID->90273997,ExpressionUUID->"1389d134-a714-3d4e-a7bb-246fe5fcd15f"],

Cell[BoxData[
 RowBox[{"0.7486795968515852`", "\[VeryThinSpace]", "+", 
