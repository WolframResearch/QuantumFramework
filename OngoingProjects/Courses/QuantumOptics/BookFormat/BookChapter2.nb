Cell["\<\
Check the normalization of this state is directly related to truncating the \
exponential as expected:\
\>", "Text",
 CellID->76901646,ExpressionUUID->"f9d09358-c740-bd48-829e-565348aa27ac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Alpha]ket", "[", "\"\<Norm\>\"", "]"}], " ", "==", 
  SqrtBox[
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"Series", "[", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", "x"}]], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", 
         RowBox[{"$FockSize", "-", "1"}]}], "}"}]}], "]"}], "]"}], "/.", 
    RowBox[{"x", "->", 
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"Abs", "[", "\[FormalAlpha]", "]"}], "2"]}]}]}]]}]], "Input",
 CellLabel->"In[109]:=",
 CellID->118268759,ExpressionUUID->"314057c8-9a2e-d34d-ac42-4d1bef06099e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[109]=",
 CellID->343078104,ExpressionUUID->"add0fddb-52a7-1e4b-86c3-f9c0fd486a48"]
}, Open  ]],

