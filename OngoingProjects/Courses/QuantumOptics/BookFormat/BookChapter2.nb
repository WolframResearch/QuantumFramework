Cell[CellGroupData[{

Cell[TextData[{
 "Define a superposition of coherent states such that the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d60249c4-ec1d-c241-915c-ac6ede06d57d"],
 " complex amplitudes lie in a equilateral triangle. If we apply the operator \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"U", "(", "\[Theta]", ")"}], "=", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"\[ImaginaryI]", " ", "\[Theta]", " ", 
      SuperscriptBox["a", "\[Dagger]"], "a"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ab1cefbd-bf89-5c45-9e5c-5fd385a4b01a"],
 " to that state, what is a value of the angle \[Theta] that keeps the state \
unchanged?"
}], "Exercise",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellID->68632093,ExpressionUUID->"1f8338be-62dc-8144-be40-84637ead9955"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "30", "]"}], ";"}]], "ExerciseInput",
 CellLabel->"In[332]:=",
 CellID->281491242,ExpressionUUID->"66225d83-1f29-8b4f-83e0-5ab732a85eb8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Compute the state using the cubic roots of a generic complex number \[Alpha]:\
\
\>", "ExerciseNote",
 CellID->444850196,ExpressionUUID->"b7e02266-385d-9640-81df-bba7a511f7ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Psi]", " ", "=", 
  RowBox[{"Total", "[", 
   RowBox[{
    RowBox[{"CoherentState", "[", "]"}], "/@", 
    RowBox[{"(", 
     RowBox[{"z", "/.", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         SuperscriptBox["z", "3"], "==", "\[Alpha]"}], ",", "z"}], "]"}]}], 
     ")"}]}], "]"}]}]], "ExerciseInput",
 CellLabel->"In[301]:=",
 CellID->431416155,ExpressionUUID->"00dd0656-6caf-794a-99a6-de619a305d90"],

