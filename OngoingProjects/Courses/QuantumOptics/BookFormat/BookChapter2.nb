Cell[CellGroupData[{

Cell[TextData[StyleBox["Eigenstates of the annihilation operator and minimum \
uncertainty", "Subsection"]], "Subsection",
 CellChangeTimes->{{3.9282616948887463`*^9, 3.928261708277588*^9}},
 CellID->268378881,ExpressionUUID->"9c235317-2862-1d4d-9bf3-6b669ed38454"],

Cell[TextData[{
 "If we consider a superposition of number states that differ in \[PlusMinus] \
1  \[VerticalSeparator]\[Psi]\[RightAngleBracket] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["c", "n"], "|", "n"}], "\[RightAngleBracket]"}], " ", "+",
       " ", 
      SubscriptBox["c", 
       RowBox[{"n", "+", "1"}]]}], "|", 
     RowBox[{"n", "+", "1"}]}], "\[RightAngleBracket]"}], TraditionalForm]],
  ExpressionUUID->"a55e1918-e877-344f-a323-af2f2d1311eb"],
 ", it will have non zero expectation for the electric field operator. More \
generally, a superposition of all number states will also hold that property. "
}], "Text",
 CellID->182024225,ExpressionUUID->"9bbdba70-1a1c-a649-82c5-8edb1d9cc1bf"],

Cell[TextData[{
 "If the annihilation and creation operators, ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "47b96729-6e90-af40-b29a-856612c840f5"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "8c7ccd4d-dada-494a-ac9d-1b6fc4df9c8c"],
 ", are replaced by complex amplitudes the field can have the structure of a \
classical field. A reasonable way to try to perform this replacement is to \
find eigenstates of annihilation operator , in other words solving the \
eigenvalue equation ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["a", "^"], TraditionalForm]],ExpressionUUID->
  "1a49bd83-8c12-824f-9c42-5c460a8bce05"],
 "|",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Alpha]", "\[RightAngleBracket]"}], " ", "=", " ", "\[Alpha]"}],
    TraditionalForm]],ExpressionUUID->"7e6db682-75f7-7f43-9559-506119039b87"],
 "|",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "\[RightAngleBracket]"}], TraditionalForm]],
  ExpressionUUID->"14907a49-006f-a540-90ba-12ff1baf7daf"],
 " where \[Alpha] can be in general complex because the operator is not \
Hermitian."
}], "Text",
 CellID->623431636,ExpressionUUID->"229ed9e8-21a4-6b43-9084-e228fa05298a"],

Cell["We can expand the state |\[Alpha]\[RightAngleBracket] in the complete \
Fock basis:", "Text",
 CellChangeTimes->{{3.9652985836689377`*^9, 3.96529859077112*^9}, 
   3.965298789501108*^9},
 CellID->155210040,ExpressionUUID->"d29c8b94-9dbc-6641-87c9-345145950348"],

Cell[BoxData[
 StyleBox[
  RowBox[{
  Cell["|\[Alpha]\[RightAngleBracket]",ExpressionUUID->
    "06b432f6-00be-3e48-87c3-1dd08e70c1a1"], 
   StyleBox[" ",
    FontSize->18], 
   StyleBox["=",
    FontSize->18], 
   StyleBox[" ",
    FontSize->18], 
   RowBox[{Cell[BoxData[
     FormBox[
      RowBox[{
       UnderoverscriptBox[
        OverscriptBox[
         StyleBox["\[Sum]",
          FontSize->24,
          FontWeight->"Bold"], " "], 
        RowBox[{"n", "=", "0"}], "\[Infinity]"], 
       SubscriptBox["C", "n"]}], TraditionalForm]], "DisplayFormula",
     FontSize->18,ExpressionUUID->"7753cddb-febf-3b4d-a756-0569ae030284"], 
    Cell[BoxData[
     FormBox["|", TraditionalForm]], "DisplayFormula",
     FontSize->18,ExpressionUUID->"c253986c-d4ad-634c-82e3-af5c563ed093"], 
    Cell[BoxData[
     FormBox[
      RowBox[{"n", "\[RightAngleBracket]"}], TraditionalForm]], 
     "DisplayFormula",
     FontSize->18,ExpressionUUID->"09581016-b22d-b540-b991-83ae23a32f69"]}]}],
   "DisplayFormula"]], "DisplayFormula",
 CellID->246019597,ExpressionUUID->"bde6e624-b64f-4e40-bc20-f425d07bc609"],

Cell[TextData[{
 "Replacing this expansion in the eigenstate equation and comparing \
coefficients we get the recurrence relation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["C", "n"], " ", 
     SqrtBox["n"]}], " ", "=", " ", 
    RowBox[{"\[Alpha]", " ", 
     SubscriptBox["C", 
      RowBox[{"n", "-", "1"}]]}]}], TraditionalForm]],ExpressionUUID->
  "2f501be3-4f89-6449-adfb-8466616503d5"]
}], "Text",
 CellID->366145243,ExpressionUUID->"c80d99af-4dcf-1d4f-befd-79993297e697"],

Cell[TextData[{
 "This recurrence is not hard solve and a compact form can be expressed just \
in terms of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "0"], TraditionalForm]],ExpressionUUID->
  "adb9d2bf-93b5-424e-8f73-ced3f21aff48"],
 ":"
}], "Text",
 CellID->329027095,ExpressionUUID->"ac7ea7dc-fd05-b944-8dff-cf24acd17722"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[Alpha]", " ", 
           RowBox[{"C", "[", 
            RowBox[{"n", "-", "1"}], "]"}]}], "-", " ", 
          RowBox[{
           RowBox[{"C", "[", "n", "]"}], 
           SqrtBox["n"]}]}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{"C", "[", "0", "]"}], "==", 
         SubscriptBox["\[FormalCapitalC]", "0"]}]}], "}"}], ",", 
      RowBox[{"C", "[", "n", "]"}], ",", "n"}], "]"}], ",", 
    RowBox[{"n", " ", "\[Element]", "PositiveIntegers"}]}], "]"}], "[", 
  RowBox[{"[", 
   RowBox[{"1", ",", "1"}], "]"}], "]"}]], "Input",
 CellLabel->"In[102]:=",
 CellID->60065148,ExpressionUUID->"03c64e16-cf66-2b48-90a0-2e0bf26df0b0"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"n"},
   "C"], "\[Rule]", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[Alpha]", "n"], " ", 
    SubscriptBox["\[FormalCapitalC]", "0"]}], 
   SqrtBox[
    RowBox[{"n", "!"}]]]}]], "Output",
 CellLabel->"Out[102]=",
 CellID->239102954,ExpressionUUID->"e9e84ddf-ca3c-b845-a053-10b3fd177a79"]
}, Open  ]],

Cell["So the state |\[Alpha]\[RightAngleBracket] can be written as:", "Text",
 CellID->422020044,ExpressionUUID->"a65017eb-c32c-ac49-89ba-d0531eb51395"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{Cell[BoxData[
     FormBox[
      RowBox[{
      Cell["|\[Alpha]\[RightAngleBracket]",ExpressionUUID->
        "2e3b5016-bbb3-2b47-b185-b12e3863a23f"], "="}], TraditionalForm]], 
     "DisplayFormula",ExpressionUUID->"4c69ca2f-2b8f-a44d-b272-83d4a280e75b"],
     " ", Cell[BoxData[
     FormBox[
      RowBox[{
       StyleBox[
        SubscriptBox["C", "0"],
        FontSize->18], 
       RowBox[{
        UnderoverscriptBox[
         StyleBox[
          OverscriptBox["\[Sum]", " "],
          FontSize->24,
          FontWeight->"Bold"], 
         RowBox[{"n", "=", "0"}], "\[Infinity]"], 
        StyleBox[
         FractionBox[
          SuperscriptBox["\[Alpha]", "n"], 
          SqrtBox[
           RowBox[{"n", "!"}]]],
         FontSize->24]}]}], TraditionalForm]], "DisplayFormula",
     ExpressionUUID->"ec9d885d-4c78-8544-a300-9dc5ed45a3a2"], Cell[BoxData[
     FormBox["|", TraditionalForm]], "DisplayFormula",
     FontSize->18,ExpressionUUID->"d44cc2bd-49fa-ed43-ad88-6b454baaa0a9"], 
    Cell[BoxData[
     FormBox[
      RowBox[{"n", "\[RightAngleBracket]"}], TraditionalForm]], 
     "DisplayFormula",
     FontSize->18,ExpressionUUID->"d332b8d3-1dec-6444-bece-08656ddd9d5c"]}], 
   "DisplayFormula"], TraditionalForm]], "DisplayFormula",
 CellID->142601438,ExpressionUUID->"87706a2b-6030-bf44-84bf-d8480388db9b"],

Cell[TextData[{
 "Imposing state normalization, we can find ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", "0"], " ", "yielding", " "}], TraditionalForm]],
  ExpressionUUID->"abf5e9c9-a502-c54c-978f-10672c9f33e4"],
 ":"
}], "Text",
 CellChangeTimes->{
  3.965298643363798*^9, {3.965298730514206*^9, 3.9652987810438843`*^9}},
 CellID->306423248,ExpressionUUID->"e8f0cfd2-429a-824b-947b-4c3d14b7b7c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["\[Alpha]", "n"], " ", 
      SubscriptBox["\[FormalCapitalC]", "0"]}], 
     SqrtBox[
      RowBox[{"n", "!"}]]], 
    RowBox[{"Conjugate", "[", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Alpha]", "n"], " ", 
       SubscriptBox["\[FormalCapitalC]", "0"]}], 
      SqrtBox[
       RowBox[{"n", "!"}]]], "]"}]}], ",", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[FormalCapitalC]", "0"], "\[Element]", "Reals"}], " ", "&&",
     " ", 
    RowBox[{"n", ">=", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[103]:=",
 CellID->8565421,ExpressionUUID->"311042f0-119a-c14f-be07-a74b6319d596"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    SubsuperscriptBox["\[FormalCapitalC]", "0", "2"], " ", 
    SuperscriptBox[
     TemplateBox[{"\[Alpha]"},
      "Abs"], 
     RowBox[{"2", " ", "n"}]]}], 
   RowBox[{"n", "!"}]], TraditionalForm]], "Output",
 CellLabel->"Out[103]=",
 CellID->102440231,ExpressionUUID->"cefc4d3d-4e7f-fe4f-805d-415cec65fed2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{"%", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}], "==", 
     "1"}], ",", 
    SubscriptBox["\[FormalCapitalC]", "0"]}], "]"}], "[", 
  RowBox[{"[", "2", "]"}], "]"}]], "Input",
 CellLabel->"In[104]:=",
 CellID->139215803,ExpressionUUID->"fb1d82fd-5d24-9c47-b05f-ff5c40020998"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    SubscriptBox["\[FormalCapitalC]", "0"], "\[Rule]", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox[
        TemplateBox[{"\[Alpha]"},
         "Abs"], "2"], "2"]}]]}], "}"}], TraditionalForm]], "Output",
 CellLabel->"Out[104]=",
 CellID->297521489,ExpressionUUID->"e62bb0c1-0d48-cb43-b199-ed27537693cc"]
}, Open  ]],

Cell["So the annihilation operator eigenstate can be expressed as:", "Text",
 CellID->12193464,ExpressionUUID->"92cf950e-f3bd-dd4d-9f85-a5fa7b1ce63c"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{Cell[BoxData[
     FormBox[
      RowBox[{
      Cell["|\[Alpha]\[RightAngleBracket]",ExpressionUUID->
        "a815acd9-3d06-c840-b267-d2973df09006"], "="}], TraditionalForm]], 
     "DisplayFormula",ExpressionUUID->"f04bb4e2-dd73-c241-8e4d-f7fd379d9358"],
     " ", Cell[BoxData[
     FormBox[
      RowBox[{
       StyleBox[
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], "/", "2"}], " ", "|", "\[Alpha]", 
          SuperscriptBox["|", "2"]}]],
        FontSize->18], 
       RowBox[{
        UnderoverscriptBox[
         StyleBox[
          OverscriptBox["\[Sum]", " "],
          FontSize->24,
          FontWeight->"Bold"], 
         RowBox[{"n", "=", "0"}], "\[Infinity]"], 
        StyleBox[
         FractionBox[
          SuperscriptBox["\[Alpha]", "n"], 
          SqrtBox[
           RowBox[{"n", "!"}]]],
         FontSize->24]}]}], TraditionalForm]], "DisplayFormula",
     ExpressionUUID->"6c9cf268-4f3a-a742-acbc-693472071dab"], Cell[BoxData[
     FormBox["|", TraditionalForm]], "DisplayFormula",
     FontSize->18,ExpressionUUID->"02cc3aaa-af37-e44d-a67e-3c61f339783e"], 
    Cell[BoxData[
     FormBox[
      RowBox[{"n", "\[RightAngleBracket]"}], TraditionalForm]], 
     "DisplayFormula",
     FontSize->18,ExpressionUUID->"5c476c7b-8124-0f4a-bb1c-9a1941cc8875"]}], 
   "DisplayFormula"], TraditionalForm]], "DisplayFormula",
 CellID->671473176,ExpressionUUID->"3f70c5b7-cc92-854e-8660-80886c66a68a"],

Cell[TextData[{
 "This is our first definition of a ",
 StyleBox["coherent state ",
  FontWeight->"Bold"],
 "in the Fock basis representation",
 " "
}], "Text",
 CellChangeTimes->{{3.9652990489746513`*^9, 3.965299148057024*^9}, {
  3.965299228250311*^9, 3.9652993154921265`*^9}},
 CellID->151647233,ExpressionUUID->"68fc4cb4-e09b-3a4d-a8d5-2a71abdce55e"],

Cell["\<\
In the Quantum Framework  we can define a normalized coherent state in a \
truncated Fock space. Within the truncated space, the exponential \
normalization factor is replaced by its series expansion, truncated at the \
same order as the Fock space itself\
\>", "Text",
 CellID->161266249,ExpressionUUID->"3c4ad902-9cbe-784c-bd15-b472b190f3f7"],

Cell[TextData[StyleBox["Set up the space size, and the annihilation \
operator:", "Text"]], "CodeText",
 CellChangeTimes->{{3.965299366731848*^9, 3.965299386350649*^9}},
 CellID->219120817,ExpressionUUID->"6d340c11-600b-5144-9c76-52d99c2835a5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "30", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", " ", ":=", " ", 
   RowBox[{"AnnihilationOperator", "[", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.934046615366565*^9, 3.9340466426500187`*^9}, {
  3.9340478177228603`*^9, 3.934047824416647*^9}, {3.953740457926258*^9, 
  3.9537404586290665`*^9}},
 CellLabel->"In[5]:=",
 CellID->958750085,ExpressionUUID->"13fd1f87-bf39-e945-a382-b699be270861"],

Cell["\<\
For symbolic manipulations can also be useful to define a non-normalized \
coherent state, which can be done with \[OpenCurlyDoubleQuote]Normalized\
\[CloseCurlyDoubleQuote] option:\
\>", "Text",
 CellID->165047156,ExpressionUUID->"155c9f7d-526c-d44c-b851-10c04062b35d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Alpha]ket", " ", "=", " ", 
   RowBox[{"CoherentState", "[", 
    RowBox[{"\"\<Normalized\>\"", "->", "False"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[107]:=",
 CellID->385810814,ExpressionUUID->"69ac539b-2de3-2c4e-aa24-bb671020d395"],

Cell[TextData[StyleBox["See the formula of the state in Dirac notation:", \
"Text"]], "CodeText",
