Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 
 CounterBox["Section"],
 StyleBox[" | ", "SectionBar"],
 "Coherent states"
}], "Section",
 CellChangeTimes->{
  3.652728456208679*^9, 3.652728527108994*^9, {3.965297012480404*^9, 
   3.9652970155478535`*^9}},
 CounterAssignments->{{"Section", 1}},
 CellID->428949895,ExpressionUUID->"c8b9cd55-f88f-f047-850e-85376021b063"],

Cell[TextData[StyleBox["The number states have a uniform phase distribution \
from 0 to 2\[Pi], meaning there is not a defined phase. One may think that \
the classical limit is when the number of photons of a number state goes to \
infinity , but that is not the case because the average electric field is \
zero for any value of quanta. We seek states such that the expectation value \
of the electric field operator oscillates sinusoidally. Following this idea, \
we will introduce the coherent states, that are said to be the \
\[OpenCurlyDoubleQuote]most classical\[CloseCurlyDoubleQuote] quantum states \
of light.  We will explore the properties of the coherent states and its \
connection to the displacement operator.", "Abstract"]], "Text",
 TextJustification->1.,
 CellID->306412981,ExpressionUUID->"c01bf78d-b8bc-8a48-a1de-3f223bbc0cab"],

Cell[CellGroupData[{

Cell["Key Concepts", "Subsubsection",
 CellChangeTimes->{{3.9579688431511*^9, 3.9579688466768475`*^9}},
 CellID->61472348,ExpressionUUID->"415ddec1-ab6d-464a-b816-fc8dc22992fc"],

Cell[CellGroupData[{

Cell["Classical-like dynamics", "Item",
 CellChangeTimes->{{3.9579688667388477`*^9, 3.957968914999668*^9}, {
  3.9652970916201286`*^9, 3.965297095637472*^9}, {3.9696148549830265`*^9, 
  3.9696148630366745`*^9}},
 CellID->66346657,ExpressionUUID->"ef6b7881-de9b-4e45-b9ea-f2d369000efc"],

