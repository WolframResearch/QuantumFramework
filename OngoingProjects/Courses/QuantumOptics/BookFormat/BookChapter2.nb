Cell["\<\
The coherent states have a completeness relation  over the complex \[Alpha] \
plane given by:\
\>", "Text",
 CellChangeTimes->{{3.9316217645826645`*^9, 3.9316218861549854`*^9}, {
  3.933695384430187*^9, 3.9336953851619625`*^9}, {3.933695424789537*^9, 
  3.933695426914091*^9}, {3.9653238224829807`*^9, 3.9653238354051285`*^9}},
 CellID->100873090,ExpressionUUID->"efe9bf70-db62-6046-917c-3363e0f392f2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Integral]", " ", 
    RowBox[{
    Cell["|\[Alpha]\[RightAngleBracket]",ExpressionUUID->
      "e9d4f73f-a03f-b642-807d-d5fdd175e4f2"], Cell[
     "\[LeftAngleBracket]\[Alpha]|",ExpressionUUID->
      "98bb12bb-ec0f-d043-ad0d-0f2031ac9414"], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[DifferentialD]", "2"], "\[Alpha]"}], "\[Pi]"]}]}], "=",
    "\[ScriptOne]"}], TraditionalForm]], "DisplayFormula",
 CellID->293460665,ExpressionUUID->"e0fef698-db7b-8a47-833d-71804e8d9038"],

Cell["\<\
We include the exact normalization constant so we can try to reproduce the \
theoretical results, we use a Fock space size of 5 just to take a look at the \
matrix elements of |\[Alpha]\[RightAngleBracket]\[LeftAngleBracket]\[Alpha]|:\
\>", "Text",
 CellID->184435727,ExpressionUUID->"2646c269-14e8-1042-9ea1-e01277738c04"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"s", "=", 
     RowBox[{"CoherentState", "[", 
      RowBox[{"5", ",", 
       RowBox[{"\"\<Normalized\>\"", "->", "False"}]}], "]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"Abs", "[", "\[FormalAlpha]", "]"}], "2"]}], "]"}], 
    RowBox[{"(", 
     RowBox[{"s", "@", 
      SuperscriptBox["s", "\[Dagger]"]}], ")"}]}]}], "]"}]], "Input",
 CellLabel->"In[28]:=",
 CellID->89983341,ExpressionUUID->"2dee33c0-c24b-3a43-a9ed-9beb84347f53"],

