Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
         RowBox[{"-", 
           SuperscriptBox["r", "2"]}], "+", 
         RowBox[{"\[ImaginaryI]", " ", "m", " ", "\[Theta]"}], "-", 
         RowBox[{"\[ImaginaryI]", " ", "n", " ", "\[Theta]"}]}]], " ", 
      SuperscriptBox["r", 
