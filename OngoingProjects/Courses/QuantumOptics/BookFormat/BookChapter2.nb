Cell[BoxData[
 RowBox[{"intPolar", " ", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"IntegrateChangeVariables", "[", 
     RowBox[{"int", ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "\[Theta]"}], "}"}], ",", 
