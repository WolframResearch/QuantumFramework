Cell["\<\
Composing two displacement operators also has the form of a displacement \
operator times an overall phase factor:\
\>", "Text",
 CellChangeTimes->{{3.930738251567709*^9, 3.930738254770375*^9}, {
  3.93073864379945*^9, 3.930738660363233*^9}, {3.9307387901958084`*^9, 
  3.9307389077805595`*^9}, {3.930738940849407*^9, 3.930738993149749*^9}, {
  3.930739054662459*^9, 3.930739201666632*^9}, {3.9307453341448517`*^9, 
  3.930745345592039*^9}, {3.933699479129511*^9, 3.933699480035387*^9}, {
  3.933699607813154*^9, 3.933699668152111*^9}, {3.933699732903551*^9, 
  3.933699733272553*^9}, {3.965321428591528*^9, 3.965321450517414*^9}, {
  3.9653214956324234`*^9, 3.965321562151232*^9}},
 CellID->431897797,ExpressionUUID->"329f4023-e17d-3741-9d1f-a6af5247dfc4"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{
     RowBox[{
      OverscriptBox["D", "^"], "(", "\[Alpha]", ")"}], 
     RowBox[{
      OverscriptBox["D", "^"], "(", "\[Beta]", ")"}]}], "=", " ", 
    RowBox[{
     RowBox[{"exp", "(", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"Im", "(", 
        RowBox[{"\[Alpha]", " ", 
         RowBox[{"\[Beta]", "\[Conjugate]"}]}], ")"}]}], ")"}], 
     RowBox[{
      OverscriptBox["D", "^"], "(", 
      RowBox[{"\[Alpha]", " ", "+", " ", "\[Beta]"}], ")"}]}]}],
   FontSize->18], TraditionalForm]], "DisplayFormula",
 CellID->738550269,ExpressionUUID->"2509d48f-b9cc-7244-8309-a308b4bfb078"],

Cell[TextData[{
 StyleBox["Can be proved using disentangling theorem from the \
Baker-Campbell-Hausdorff expansion, we see we get the terms of the \
displacement operator with ", "Text"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", 
    RowBox[{"\[Alpha]", " ", "+", " ", "\[Beta]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fb60737a-e5f9-9b4c-90fe-1474b91120d6"],
 " a",
 StyleBox["nd the phase factor (", "Text"],
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "-", 
    RowBox[{"z", "\[Conjugate]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1f76d896-fd2e-7941-9618-d9de1bcd7240"],
 ")/2 = \[ImaginaryI] Im(",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ee288d48-8467-cc46-8f92-5f3db2a064ca"],
 ")."
}], "Text",
 CellID->394572051,ExpressionUUID->"f376f7bc-7ce7-7247-8922-f413fd0ffb19"],

Cell[TextData[{
 StyleBox["Load the ", "Text"],
 StyleBox["BakerCampbellHausdorffTerms", "FormattedFunction"],
 StyleBox[" function:", "Text"]
}], "CodeText",
 CellID->319097139,ExpressionUUID->"639a9a74-b590-204a-9f6b-1caea1b981ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BCH", " ", "=", " ", 
   RowBox[{
   "ResourceFunction", "[", "\"\<BakerCampbellHausdorffTerms\>\"", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9695605357634277`*^9, 3.969560545763815*^9}},
 CellLabel->"In[40]:=",
