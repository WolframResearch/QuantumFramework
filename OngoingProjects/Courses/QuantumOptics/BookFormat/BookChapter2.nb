Cell[BoxData[
 RowBox[{
  RowBox[{"int", "=", 
   TemplateBox[{
     FractionBox[
      RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
           RowBox[{"-", 
             SuperscriptBox["x", "2"]}], "-", 
           SuperscriptBox["y", "2"]}]], " ", 
        SuperscriptBox[
         RowBox[{"(", 
           RowBox[{"x", "-", 
             RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}], "n"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
           RowBox[{"x", "+", 
             RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}], "m"]}], 
      SqrtBox[
       RowBox[{
         RowBox[{"m", "!"}], " ", 
         RowBox[{"n", "!"}]}]]], "x", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]", "y", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"},
    "InactiveIntegrate",
    DisplayFunction->(RowBox[{
       SubsuperscriptBox[
        StyleBox["\[Integral]", "Inactive"], #3, #4], 
       RowBox[{
         SubsuperscriptBox[
          StyleBox["\[Integral]", "Inactive"], #6, #7], 
         RowBox[{#, 
           RowBox[{
             StyleBox["\[DifferentialD]", "Inactive"], #5}], 
           RowBox[{
             StyleBox["\[DifferentialD]", "Inactive"], #2}]}]}]}]& ),
    InterpretationFunction->(RowBox[{
       RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
       RowBox[{#, ",", 
         RowBox[{"{", 
           RowBox[{#2, ",", #3, ",", #4}], "}"}], ",", 
         RowBox[{"{", 
