Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          FractionBox["\[Alpha]", 
           SqrtBox["2"]], "-", "\[Xi]"}], ")"}], "2"]}], "-", 
      FractionBox[
       SuperscriptBox[
        TemplateBox[{"\[Alpha]"},
         "Abs"], "2"], "2"], "+", 
      FractionBox[
       SuperscriptBox["\[Xi]", "2"], "2"]}]], " ", 
    RadicalBox[
     FractionBox[
      RowBox[{"m", " ", "\[Omega]"}], "h"], "4"]}], 
   RadicalBox["\[Pi]", "4"]], TraditionalForm]], "Output",
 CellLabel->"Out[10]//TraditionalForm=",
 CellID->59328177,ExpressionUUID->"2a9284ed-c170-aa48-8e1f-236c6e9d9edf"]
}, Open  ]],

