Cell[TextData[{
 StyleBox["Plots of phase distributions for different mean photon numbers, \
becomes more definite when ", "Text"],
 StyleBox[Cell[BoxData[
  FormBox[
   OverscriptBox["n", "\[LongDash]"], TraditionalForm]], "Text",
  ExpressionUUID->"bf33c5e7-feba-e44a-8ac2-1b78dac0e689"], "Text"],
 StyleBox[" increases:", "Text"]
}], "CodeText",
 CellChangeTimes->{{3.9653024523673973`*^9, 3.965302467302809*^9}, {
  3.96530252340481*^9, 3.965302540070326*^9}, {3.969615040209938*^9, 
  3.9696151038449917`*^9}},
 CellID->309429202,ExpressionUUID->"d318a0d8-d2c4-7a45-8a0b-cf2e40b8cb64"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       SqrtBox[
        FractionBox[
         RowBox[{"2", " ", 
          SuperscriptBox[
           RowBox[{"Abs", "[", "x", "]"}], "2"]}], "\[Pi]"]], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], " ", 
         SuperscriptBox[
          RowBox[{"Abs", "[", "x", "]"}], "2"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Psi]", "-", 
            RowBox[{"Arg", "[", "x", "]"}]}], ")"}], "2"]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        SqrtBox[
         SuperscriptBox["2", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "4"}], "]"}]]]}], "}"}]}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Psi]", ",", 
     RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["Sequence", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["6", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            
            TagBox["1816", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    PlotRange -> Full, PlotLegends -> 
     Placed[{"\!\(\*OverscriptBox[\(n\), \(\[LongDash]\)]\) = 1", 
        "\!\(\*OverscriptBox[\(n\), \(\[LongDash]\)]\) = 2", 
        "\!\(\*OverscriptBox[\(n\), \(\[LongDash]\)]\) = 4", 
        "\!\(\*OverscriptBox[\(n\), \(\[LongDash]\)]\) = 8", 
        "\!\(\*OverscriptBox[\(n\), \(\[LongDash]\)]\) = 16"}, Below], 
     ImageSize -> Large, AxesLabel -> {"\[Psi]", "P(\[Psi])"}, LabelStyle -> 
     14, Ticks -> {{-Pi, -(Pi/2), 0.1, Pi/2, Pi}, {0, 1, 2, 3}}],
    SelectWithContents->True,
    Selectable->False]}], "]"}]], "Input",
 CellLabel->"In[177]:=",
 CellID->370318696,ExpressionUUID->"a4a2c1bd-4d02-bb48-8a5d-2b57c15c30fd"],

