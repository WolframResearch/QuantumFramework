Cell[TextData[{
 "We clearly see the other exponential has the form of a displacement \
operator with complex amplitude \[Alpha] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", "t"}]], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "68b77a56-e05e-4743-a258-77b1889ab86b"],
 " finishing the verification"
}], "Text",
 CellID->540827553,ExpressionUUID->"c3454173-78c5-4443-acda-da35aac247dd"],

Cell["\<\
The mean value of the position operator for the evolved state behaves like it \
is a classical oscillator (sinusoidal oscillations). This emphasizes another \
reason why coherent states are called \[OpenCurlyDoubleQuote]the most \
classical\[CloseCurlyDoubleQuote] quantum states. This also holds for the \
mean value of the momentum operator.\
\>", "Text",
 CellID->16701956,ExpressionUUID->"c5a28368-9ba8-fb44-a2b7-1749778b7fb7"],

Cell[TextData[StyleBox["Pick a value of \[Alpha]:", "Text"]], "CodeText",
 CellChangeTimes->{{3.965323372748789*^9, 3.965323381545004*^9}},
 CellID->177037132,ExpressionUUID->"f1d66002-1d0d-b043-b38a-ee528449e6ac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Alpha]c", " ", "=", " ", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     SqrtBox["2"], 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "-", "\[ImaginaryI]"}], ",", 
       RowBox[{"1", "+", "\[ImaginaryI]"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
