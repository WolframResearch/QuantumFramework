Cell["\<\
The diagonal quantum harmonic oscillator Hamiltonian for a single mode field: \
\>", "Text",
 CellChangeTimes->{{3.9307408478039284`*^9, 3.930740877471838*^9}, {
  3.9307473772289333`*^9, 3.9307474051670456`*^9}, {3.9653230728584785`*^9, 
