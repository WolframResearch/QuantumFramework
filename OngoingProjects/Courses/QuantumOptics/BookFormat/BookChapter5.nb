Cell[TextData[{
 "When the initial field has an average of one photon |\[Alpha]|",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b07010a3-f09b-4849-8c55-b99c033f9197"],
 ", the mathematical singularities are washed away. The field dynamically \
swings between being sub-Poissonian and heavily super-Poissonian as the atom \
exchanges energy with a field that now possesses a wider distribution of Fock \
states. The case with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d16661f8-29df-6345-9543-e0c4428cf73a"],
 " can be said to be the onset of complex interference. And finally when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", "3"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "30c0ba54-9c6b-7745-bee9-f2f245ab031a"],
 " we see something that resembles collapse and revivals due to the \
interference between the many different Rabi frequencies"
}], "Text",
 CellID->9530836,ExpressionUUID->"ac9ef542-8437-f943-80f0-d45072f30954"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Initialization", "Subsubsection"]], "Subsubsubsection",
 CellID->783477438,ExpressionUUID->"5777dd86-2183-0f4e-be39-010c2c63bd99"],

