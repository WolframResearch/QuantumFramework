Cell[TextData[{
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"(", "2", ")"}]], "=", "1"}], TraditionalForm]],ExpressionUUID->
  "773cb8b1-173f-4d4b-a6dc-2979662b2288"],
 ", verifying that a coherent state is second-order coherent and the photon \
arrivals can be described as random with a Poisson distribution"
}], "Text",
 CellID->227160420,ExpressionUUID->"2a4e1e20-8157-6342-bba4-59a2be4adc46"],

