Cell["It can be shown that the integral evaluates to", "Text",
 CellID->201289195,ExpressionUUID->"8fefeec1-1be6-f349-898a-ba5ddc818b40"],

Cell[BoxData[
 FormBox[
  RowBox[{"I", "=", 
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {
          TagBox[GridBox[{
             {
              RowBox[{"(", 
               RowBox[{"1", "-", 
                FractionBox["\[Tau]", 
                 SubscriptBox["\[Tau]", "0"]]}], ")"}], 
              RowBox[{"    ", 
               RowBox[{"\[Tau]", "<", 
                SubscriptBox["\[Tau]", "0"]}]}]},
             {"0", 
              RowBox[{"    ", 
               RowBox[{"\[Tau]", "\[GreaterEqual]", 
                SubscriptBox["\[Tau]", "0"]}]}]}
            }],
           "Piecewise"], " "}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
        GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
        GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.84]}, 
            Offset[0.27999999999999997`]}, "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}},
        Selectable->True]}
     },
     GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
     GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.35]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}],
    "Piecewise",
    DeleteWithContents->True,
    Editable->False,
    SelectWithContents->True,
    Selectable->False,
    StripWrapperBoxes->True]}], TraditionalForm]], "DisplayFormula",
 CellID->167704493,ExpressionUUID->"9e39207b-bc9c-db43-a38e-c62ab03bac31"],

Cell[TextData[{
 "For example, lets perform the numerical integration for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Tau]", "0"], "=", "1"}], ",", 
    RowBox[{"\[Tau]", "=", "0.5"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4cef4cf1-bf20-494f-9d29-a11ea99fd539"],
 ", we should get a value close to 0.5:"
}], "Text",
 CellID->344451513,ExpressionUUID->"ce422037-cf33-9645-b496-f072d0ab4f7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"T", "=", 
      SuperscriptBox["10", "6"]}], "}"}], ",", 
    RowBox[{
     RowBox[{"1", "/", "T"}], " ", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"Exp", "[", 
         RowBox[{"\[ImaginaryI]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"psi", "[", 
             RowBox[{"t", ",", "1"}], "]"}], "-", 
            RowBox[{"psi", "[", 
             RowBox[{
              RowBox[{"t", "+", "0.5"}], ",", "1"}], "]"}]}], ")"}]}], "]"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "T"}], "}"}], ",", 
       RowBox[{"Method", "->", "\"\<MultiPeriodic\>\""}]}], "]"}]}]}], "]"}], 
  "//", "Quiet"}]], "Input",
 CellLabel->"In[24]:=",
 CellID->339289702,ExpressionUUID->"0cc0f7d2-6b7b-ae40-832d-53ca4497e4cb"],

Cell[BoxData["0.5036982411388635`"], "Output",
 CellLabel->"Out[24]=",
 CellID->53517,ExpressionUUID->"1911f578-59e3-4b47-b765-4ed6f5fc51d4"]
}, Open  ]],

Cell[TextData[{
 "So ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", " ", 
     RowBox[{
      SuperscriptBox["\[Gamma]", 
       RowBox[{"(", "1", ")"}]], "(", "\[Tau]", ")"}], "|"}], "=", 
    RowBox[{"1", "-", 
     RowBox[{"\[Tau]", "/", 
      SubscriptBox["\[Tau]", "0"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e6118a29-a548-9249-a011-64a71122b88d"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", " ", "<", 
    SubscriptBox["\[Tau]", "0"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b9080eed-9f0f-5543-ac79-611da5dbf498"],
 ", and zero otherwise. So if the delay is longer than the coherence time of \
the source there is just no coherence at all"
}], "Text",
 CellID->72222704,ExpressionUUID->"f88e28ce-01ed-0942-ba6d-cfe8a0d9cbea"],

Cell[TextData[{
 "Other model is the collision broadened light such that has a Lorentzian \
power spectrum centered at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "0"], TraditionalForm]],ExpressionUUID->
  "66565b5f-618f-2e41-9c4f-60678f78f4f5"],
 ". This case has the following autocorrelation function"
}], "Text",
 CellID->374742155,ExpressionUUID->"adcf6b66-8ca0-c446-a677-ef42c4a68719"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["E", "*"], "(", "t", ")"}], 
     RowBox[{"E", "(", 
      RowBox[{"t", "+", "\[Tau]"}], ")"}]}], "\[RightAngleBracket]"}], "=", 
   RowBox[{
    SubsuperscriptBox["E", "0", "2"], 
    SuperscriptBox["e", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], "\[Omega]", " ", "\[Tau]"}], "-", 
      RowBox[{
       RowBox[{"|", "\[Tau]", "|"}], "/", 
       SubscriptBox["\[Tau]", "0"]}]}]]}]}], 
  TraditionalForm]], "DisplayFormula",
 FontSize->18,
 CellID->80528060,ExpressionUUID->"010bab87-de72-c440-bd4d-86822f06be69"],

Cell["\<\
One way to represent this calculation is to model the broadened light by \
phase diffusion of the source:\
\>", "Text",
 CellID->602015835,ExpressionUUID->"54393150-d316-5b48-8a64-100d06e4c213"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"autocorrelation", "=", 
  RowBox[{
   SuperscriptBox["E0", "2"], " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]0", " ", "\[Tau]"}], "]"}],
    " ", 
   RowBox[{"Expectation", "[", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"\[ImaginaryI]", " ", "\[Delta]\[Phi]"}], "]"}], ",", 
     RowBox[{"\[Delta]\[Phi]", "\[Distributed]", 
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"0", ",", 
        SqrtBox[
         FractionBox[
          RowBox[{"2", " ", 
           RowBox[{"Abs", "[", "\[Tau]", "]"}]}], "\[Tau]0"]]}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[25]:=",
 CellID->98603167,ExpressionUUID->"ddbe0d9f-e5fb-1b4c-825a-a0cf3d8aab4b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["E0", "2"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       TemplateBox[{"\[Tau]"},
        "Abs"], "\[Tau]0"]}], "-", 
     RowBox[{"\[ImaginaryI]", " ", "\[Tau]", " ", "\[Omega]0"}]}]]}], 
  TraditionalForm]], "Output",
 CellLabel->"Out[25]=",
 CellID->19176929,ExpressionUUID->"18d5e13e-2473-e649-a5d9-16c0afb049f8"]
}, Open  ]],

Cell["\<\
Get the Lorentzian power spectrum from the Fourier transform:\
\>", "Text",
 CellID->286187595,ExpressionUUID->"c5ae641e-9225-b646-a092-5c91c9fd8414"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FourierTransform", "[", 
  RowBox[{"autocorrelation", ",", "\[Tau]", ",", "\[Omega]"}], "]"}]], "Input",
 CellLabel->"In[26]:=",
 CellID->134302027,ExpressionUUID->"2ff8d97e-e0b5-9b46-b671-f3d5566e5ece"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    SqrtBox[
     FractionBox["2", "\[Pi]"]], " ", 
    SuperscriptBox["E0", "2"], " ", "\[Tau]0"}], 
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Tau]0", "2"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[Omega]", "-", "\[Omega]0"}], ")"}], "2"]}], "+", "1"}]], 
  TraditionalForm]], "Output",
 CellLabel->"Out[26]=",
 CellID->142494716,ExpressionUUID->"7c41067b-68ab-ca41-bf44-6bf6b97380a6"]
}, Open  ]],

Cell[TextData[{
 "From this ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Gamma]", 
      RowBox[{"(", "1", ")"}]], "(", "\[Tau]", ")"}], "=", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", 
       SubscriptBox["\[Omega]", "0"], "\[Tau]"}], " ", "-", " ", 
      FractionBox[
       RowBox[{"|", "\[Tau]", "|"}], 
       SubscriptBox["\[Tau]", "0"]]}]]}], TraditionalForm]],ExpressionUUID->
  "cfaecb3b-a2c8-954e-92f5-d204301c5372"],
 ", which clearly has magnitude between 0 and 1 as expected, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", 
     RowBox[{
      SuperscriptBox["\[Gamma]", 
       RowBox[{"(", "1", ")"}]], "(", "\[Tau]", ")"}], "|"}], "\[Rule]", 
    RowBox[{
     RowBox[{"0", " ", "when", " ", "\[Tau]"}], "\[Rule]", " ", 
     "\[Infinity]"}]}], TraditionalForm]],ExpressionUUID->
  "97cc1a58-6adc-df4f-92ef-affc0d2a4a64"],
 " which means increasing the time delay reduces the coherence. We can see ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", "\[Tau]", "|", 
    RowBox[{"<<", 
     SubscriptBox["\[Tau]", "0"]}]}], TraditionalForm]],ExpressionUUID->
  "e78b3e13-008e-1a46-83d3-675f91f884e9"],
 " then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", 
     RowBox[{
      SuperscriptBox["\[Gamma]", 
       RowBox[{"(", "1", ")"}]], "(", "\[Tau]", ")"}], "|"}], "\[Rule]", 
    "1"}], TraditionalForm]],ExpressionUUID->
  "b3382316-521f-f847-9fb3-49e9db04282d"],
 ", also if the average collision time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Tau]", "0"], TraditionalForm]],ExpressionUUID->
  "c318e348-af92-1d48-9fe3-8312341bdb5f"],
 " is reduced the coherence goes to 0 faster when increasing \[Tau]. "
}], "Text",
 CellID->46614057,ExpressionUUID->"61b7d9ff-be47-ea42-adc1-e612899121d2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Quantum approach to coherence functions", "Subsection",
 CellID->93478736,ExpressionUUID->"e24cd10b-c971-bc4c-aa42-7a7497e23b06"],

Cell[TextData[{
 "When describing the theory of coherence in quantum optics, the measuring \
device can absorb photons. If we think of the detector as some atom, then the \
atom can be excited by the field from a band of wavelengths. The coupling of \
the atom and the quantized field can be described with the electric dipole \
interaction with Hamiltonian ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["H", 
    RowBox[{"(", "I", ")"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4a104572-bc9e-0c4c-98f7-5d7710877d1e"],
 "."
}], "Text",
 CellID->29643526,ExpressionUUID->"ec62ad97-c1e6-1b43-ba7a-9c684d95a959"],

Cell[TextData[{
 "In this model the electric field can be written using Heisenberg picture \
and the long-wavelength approximation (\[Lambda] >> ",
 Cell[BoxData[
  FormBox["atom", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "64f23499-239e-5445-aec7-ef7d160adb64"],
 " size) as"
}], "Text",
 CellID->246387956,ExpressionUUID->"24aef34c-4861-2f4f-a45c-a4fc4ee4ed2e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox[
    RowBox[{
     OverscriptBox[
      StyleBox["E", "Bold",
       FontWeight->"Bold"], "^"], "(", 
     RowBox[{
      StyleBox["r", "Bold",
       FontWeight->"Bold"], ",", "t"}], ")"}],
    FontSize->18], "\[TildeTilde]", 
   RowBox[{"\[ImaginaryI]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["k", "Bold",
        FontWeight->"Bold"], ",", "s"}]], 
     RowBox[{
      SqrtBox[
       FractionBox[
        RowBox[{"\[HBar]", " ", 
         SubscriptBox["\[Omega]", "k"]}], 
        RowBox[{
         StyleBox["2", "CodeText"], " ", 
         SubscriptBox["\[CurlyEpsilon]", "0"], "V"}]]], 
      RowBox[{
       SubscriptBox[
        StyleBox["e", "Bold",
         FontWeight->"Bold"], 
        StyleBox[
         RowBox[{
          StyleBox["k", "Bold",
           FontWeight->"Bold"], "s"}]]], "[", 
       RowBox[{
        RowBox[{
         SubscriptBox[
          OverscriptBox["a", "^"], 
          StyleBox[
           RowBox[{
            StyleBox["k", "Bold",
             FontWeight->"Bold"], "s"}]]], "(", "t", ")"}], "-", 
        RowBox[{
         SubsuperscriptBox[
          OverscriptBox["a", "^"], 
          StyleBox[
           RowBox[{
            StyleBox["k", "Bold",
             FontWeight->"Bold"], "s"}]], "\[Dagger]"], "(", "t", ")"}]}], 
       "]"}]}]}]}]}], TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.9859441174155235`*^9, 3.985944176564951*^9},
 CellID->129238133,ExpressionUUID->"3f678131-544a-104c-b8b1-f3109a658f74"],

Cell["\<\
Which has a component describing photon absorption related to the \
annihilation operator, this component is called the positive frequency part\
\>", "Text",
 CellID->448031485,ExpressionUUID->"d12073a9-6568-7e4c-b815-ddd863f90985"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["E", "Bold",
       FontWeight->"Bold"], "^"], 
     RowBox[{"(", "+", ")"}]], "(", 
    RowBox[{
     StyleBox["r", "Bold",
      FontWeight->"Bold"], ",", "t"}], ")"}], "=", 
   RowBox[{"\[ImaginaryI]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["k", "Bold",
        FontWeight->"Bold"], ",", "s"}]], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{"\[HBar]", " ", 
          SubscriptBox["\[Omega]", "k"]}], 
         RowBox[{
          StyleBox["2", "CodeText"], " ", 
          SubscriptBox["\[CurlyEpsilon]", "0"], "V"}]], ")"}], 
       RowBox[{"1", "/", "2"}]], 
      SubscriptBox[
       StyleBox["e", "Bold",
        FontWeight->"Bold"], 
       StyleBox[
        RowBox[{
         StyleBox["k", "Bold",
          FontWeight->"Bold"], "s"}]]], 
      RowBox[{
       SubscriptBox[
        OverscriptBox["a", "^"], 
        StyleBox[
         RowBox[{
          StyleBox["k", "Bold",
           FontWeight->"Bold"], "s"}]]], "(", "t", ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.9859441174155235`*^9, 3.985944176564951*^9},
 CellID->153627307,ExpressionUUID->"d65f84ac-5adb-7d45-8905-60d51a2e6640"],

Cell[TextData[{
 "Assuming the atom is in some initial state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   Cell["|",ExpressionUUID->"c13e3c56-2818-ca4f-b110-70db9cfdee60"], "g", 
    Cell["\[RightAngleBracket]",ExpressionUUID->
     "52718f7a-99c2-554b-af73-119c660bf63e"]}], TraditionalForm]],
  ExpressionUUID->"4617b42e-5d55-a749-86e6-4848fab6fdf9"],
 " and transitions to a ionized atomic state",
 Cell[BoxData[
  FormBox[
   RowBox[{
   Cell["|",ExpressionUUID->"1602ff7d-0aee-584b-bee2-e4522f3b26c1"], "e", 
    Cell[TextData[Cell[BoxData[
     FormBox["\[RightAngleBracket]", TraditionalForm]],
     FormatType->TraditionalForm,ExpressionUUID->
     "27ca283f-d2a7-6241-8e01-42e6d38e8b8d"]],ExpressionUUID->
     "4dcfcfc8-e5a4-914c-8d45-a221f89eb718"]}], TraditionalForm]],
  ExpressionUUID->"21585f11-6839-f54c-bbca-ac230515b38f"],
 ", and the field transitions to some state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   Cell["|",ExpressionUUID->"1c9706cd-c7b8-834c-88d3-fd4bf3a4fcb4"], "i", 
    Cell["\[RightAngleBracket]",ExpressionUUID->
     "62689a4e-eb94-9b4a-bdff-6bdde4dfe8f4"]}], TraditionalForm]],
  ExpressionUUID->"9c67446e-10ff-7f4e-8485-2bb7ad6c7912"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   Cell["|",ExpressionUUID->"d05ed8ee-5348-6049-8671-ae652934bd81"], " ", "f",
     " ", Cell[
    "\[RightAngleBracket]",ExpressionUUID->
     "992f6fb6-d4ca-244d-870a-d3a0886a32c4"], " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a85b3a33-00cf-344d-b188-e36cf1dd6790"],
 ". Letting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
    Cell["|",ExpressionUUID->"31b7fa2c-920d-b242-870c-88bff4eff0a3"], "I", 
     Cell["\[RightAngleBracket]",ExpressionUUID->
      "7d6b9489-515e-f34e-a2c7-866d94382d3e"]}], " ", "=", 
    RowBox[{
    Cell["|",ExpressionUUID->"ac750adb-2a27-9c43-83e5-7c837c41fb14"], "g", 
     Cell["\[RightAngleBracket]",ExpressionUUID->
      "d4ae2fa7-5a30-0d4d-91ed-1437b777432b"], " ", Cell[
     "|",ExpressionUUID->"bc3011a9-71a3-3341-9c05-d7952a2aa251"], "i", Cell[
     "\[RightAngleBracket]",ExpressionUUID->
      "7e52c829-0ebb-1f4c-90ac-380fd8c1f90b"]}]}], TraditionalForm]],
  ExpressionUUID->"69efa624-ba8f-5c43-be50-0bbd6d52c70b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
    Cell["|",ExpressionUUID->"c66693d7-bc1e-d841-affd-4d51795eb38c"], "F", 
     Cell["\[RightAngleBracket]",ExpressionUUID->
      "0f478840-5e8c-2b41-9b88-4341b5d02469"]}], " ", "=", " ", 
    RowBox[{
    Cell["|",ExpressionUUID->"42f009bf-a292-da48-ba58-af48f512e277"], "e", 
     Cell["\[RightAngleBracket]",ExpressionUUID->
      "a7ed9b1a-85bc-8147-96f1-0c583aa5abb6"], " ", Cell[
     "|",ExpressionUUID->"f62e56ff-a68c-394e-93a3-ad72e4fa7071"], "g", Cell[
     "\[RightAngleBracket]",ExpressionUUID->
      "375f4d61-538a-b74b-9019-8ce324ead5c3"]}]}], TraditionalForm]],
  ExpressionUUID->"e8e741bc-70c3-0a4b-8519-d7050e397032"],
 " the transition probability for the full system is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"F", "|", 
      SuperscriptBox["H", 
       RowBox[{"(", "I", ")"}]], "|", "I"}], "\[RightAngleBracket]"}], 
    SuperscriptBox["|", "2"]}], TraditionalForm]],ExpressionUUID->
  "3518028f-e603-4342-b8f4-c9739e792fc6"],
 ", and for the field is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"f", "|", 
      RowBox[{
       SuperscriptBox["E", 
        RowBox[{"(", "+", ")"}]], "(", 
       RowBox[{
        StyleBox["r",
         FontWeight->"Bold"], ",", "t"}], ")"}], "|", "i"}], 
     "\[RightAngleBracket]"}], 
    SuperscriptBox["|", "2"]}], TraditionalForm]],ExpressionUUID->
  "9e3554aa-5a75-0948-ad93-04146f88954e"],
 ". We only care about the final state of the detector not the field, so we \
have to sum over all the states ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "f"}], "\[RightAngleBracket]"}], TraditionalForm]],
  ExpressionUUID->"cb8765d4-36ce-6544-a23b-530ec98d3aac"],
 " which without loss of generality assume to be complete"
}], "Text",
 CellID->11138904,ExpressionUUID->"517588f3-9bb5-9c4f-b2ab-b343bd7c6186"],

Cell["Performing the sum we get:", "Text",
 CellID->158135442,ExpressionUUID->"e0a4ec5e-2a6c-bc4c-a4ef-8257365a2032"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[LeftAngleBracket]", 
   RowBox[{"i", "|", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       OverscriptBox[
        StyleBox["E", "Bold",
         FontWeight->"Bold"], "^"], 
       RowBox[{"(", "-", ")"}]], "(", 
      RowBox[{
       StyleBox["r", "Bold",
        FontWeight->"Bold"], ",", "t"}], ")"}], "\[CenterDot]", 
     RowBox[{
      SuperscriptBox[
       OverscriptBox[
        StyleBox["E", "Bold",
         FontWeight->"Bold"], "^"], 
       RowBox[{"(", "+", ")"}]], "(", 
      RowBox[{
       StyleBox["r", "Bold",
        FontWeight->"Bold"], ",", "t"}], ")"}]}], "|", "i"}], 
   "\[RightAngleBracket]"}], TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.9859441174155235`*^9, 3.985944176564951*^9},
 CellID->98383331,ExpressionUUID->"dd4d78a6-7c9c-1046-a02f-9013e21371b6"],

Cell[TextData[{
 "Or for mixed states ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "F"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2eabe1ae-2cef-a84a-ae7f-f2b11caa3aef"],
 ":"
}], "Text",
 CellID->132199762,ExpressionUUID->"4ffb9633-8d61-8146-87b4-890db46b3efa"],

Cell[BoxData[
 FormBox[
  RowBox[{"Tr", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      OverscriptBox["\[Rho]", "^"], "F"], 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        OverscriptBox[
         StyleBox["E", "Bold",
          FontWeight->"Bold"], "^"], 
        RowBox[{"(", "-", ")"}]], "(", 
       RowBox[{
        StyleBox["r", "Bold",
         FontWeight->"Bold"], ",", "t"}], ")"}], "\[CenterDot]", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox[
         StyleBox["E", "Bold",
          FontWeight->"Bold"], "^"], 
        RowBox[{"(", "+", ")"}]], "(", 
       RowBox[{
        StyleBox["r", "Bold",
         FontWeight->"Bold"], ",", "t"}], ")"}]}]}], "}"}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.9859441174155235`*^9, 3.985944176564951*^9},
 FontSize->18,
 CellID->355498906,ExpressionUUID->"e60969dd-c672-174c-99c8-3a835910f9c1"],

Cell["\<\
Treating the fields as scalars(same polarization) we can define the quantum \
version:  \
\>", "Text",
 CellID->16975560,ExpressionUUID->"6fa67b41-2611-f140-9fa3-0ecdac1e0b02"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["G", 
     RowBox[{"(", "1", ")"}]], "(", 
    RowBox[{"x", ",", "x"}], ")"}], "=", 
   RowBox[{"Tr", "{", 
    RowBox[{"\[Rho]", " ", 
     SuperscriptBox[
      OverscriptBox["E", "^"], 
      RowBox[{"(", "-", ")"}]], "(", "x", ")", 
     SuperscriptBox[
      OverscriptBox["E", "^"], 
      RowBox[{"(", "+", ")"}]], "(", "x", ")"}], "}"}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.9859441174155235`*^9, 3.985944176564951*^9},
 CellID->572011726,ExpressionUUID->"b7073298-4914-964c-8f2f-3456f3d6314f"],

Cell[TextData[{
 "Referring to the previous diagram of Young\[CloseCurlyQuote]s interference \
we can similarly consider the quantum analog ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["E", 
      RowBox[{"(", "+", ")"}]], "(", 
     RowBox[{
      StyleBox["r",
       FontWeight->"Bold"], ",", "t"}], ")"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["K", "1"], 
      RowBox[{
       SuperscriptBox["E", 
        RowBox[{"(", "+", ")"}]], "(", 
       RowBox[{
        SubscriptBox[
         StyleBox["r",
          FontWeight->"Bold"], "1"], ",", 
        SubscriptBox["t", "1"]}], ")"}]}], "+", 
     RowBox[{
      SubscriptBox["K", "2"], 
      RowBox[{
       SuperscriptBox["E", 
        RowBox[{"(", "+", ")"}]], "(", 
       RowBox[{
        SubscriptBox[
         StyleBox["r",
          FontWeight->"Bold"], "2"], ",", 
        SubscriptBox["t", "2"]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"346d71eb-e125-cd49-87ee-cfea7b52c268"],
 " using positive frequency operators. So the intensity at the detector is"
}], "Text",
 CellID->458261786,ExpressionUUID->"ff36595c-5074-ba44-a296-27a473054402"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"I", "(", 
    RowBox[{
     StyleBox["r", "Bold"], ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{"Tr", 
     RowBox[{"{", 
      RowBox[{
       OverscriptBox["\[Rho]", "^"], 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["E", "^"], 
         RowBox[{"(", "-", ")"}]], "(", 
        RowBox[{
         StyleBox["r", "Bold",
          FontWeight->"Bold"], ",", "t"}], ")"}], 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["E", "^"], 
         RowBox[{"(", "+", ")"}]], "(", 
        RowBox[{
         StyleBox["r", "Bold",
          FontWeight->"Bold"], ",", "t"}], ")"}]}], "}"}]}], "=", 
    "\[IndentingNewLine]", 
    RowBox[{"|", 
     SubscriptBox["K", "1"], 
     SuperscriptBox["|", "2"], 
     RowBox[{
      RowBox[{
       SuperscriptBox["G", 
        RowBox[{"(", "1", ")"}]], "(", 
       RowBox[{
        SubscriptBox["x", "1"], ",", 
        SubscriptBox["x", "1"]}], ")"}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"|", 
         SubscriptBox["K", "2"], "|"}], "2"], 
       SuperscriptBox["G", 
        RowBox[{"(", "1", ")"}]], "(", 
       RowBox[{
        SubscriptBox["x", "2"], ",", 
        SubscriptBox["x", "2"]}], ")"}], "+", 
      RowBox[{"2", " ", "Re", "[", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["K", "1"], "*"], 
        SubscriptBox["K", "2"], 
        SuperscriptBox["G", 
         RowBox[{"(", "1", ")"}]], "(", 
        RowBox[{
         SubscriptBox["x", "1"], ",", 
         SubscriptBox["x", "2"]}], ")"}], "]"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellID->351915792,ExpressionUUID->"252f1354-c858-1c42-bee3-0ac236977b85"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["G", 
        RowBox[{"(", "1", ")"}]], "(", 
       RowBox[{
        SubscriptBox["x", "i"], ",", 
        SubscriptBox["x", "i"]}], ")"}], "   ", "i"}], "=", "1"}], ",", "2"}],
    TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b3802bf3-8738-844a-a60b-2049dcb61bdc"],
 " is the intensity at the detector coming from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8fd8c9e2-e60e-4445-b096-a91cd01e73ef"],
 ", and the correlation of light arriving from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a295dbb8-9ef0-624c-b970-59e2ab549b7a"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f5dcae30-c17a-e84f-bb84-8fb0e21fdf16"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["G", 
     RowBox[{"(", "1", ")"}]], "(", 
    RowBox[{
     SubscriptBox["x", "1"], ",", 
     SubscriptBox["x", "2"]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1035fd95-6036-f340-bdcd-62e71617c620"],
 " (interference)"
}], "Text",
 CellID->127826847,ExpressionUUID->"cf8d5911-c135-a143-89f9-9afd977f6498"],

Cell[TextData[{
 "Analogously to the classical ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Gamma]", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "d2e99fb3-62d7-bc46-baa9-5f1080e9e893"],
 ", the normalized first-order coherence function is:"
}], "Text",
 CellID->254482591,ExpressionUUID->"8728f0b2-0d4b-ec47-8488-478342a350eb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"(", "1", ")"}]], "(", 
    RowBox[{
     SubscriptBox["x", "1"], ",", 
     SubscriptBox["x", "2"]}], ")"}], "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["G", 
      RowBox[{"(", "1", ")"}]], "(", 
     RowBox[{
      SubscriptBox["x", "1"], ",", 
      SubscriptBox["x", "2"]}], ")"}], 
    SuperscriptBox[
     RowBox[{"[", 
      RowBox[{
       SuperscriptBox["G", 
        RowBox[{"(", "1", ")"}]], "(", 
       RowBox[{
        SubscriptBox["x", "1"], ",", 
        SubscriptBox["x", "1"]}], ")", 
       SuperscriptBox["G", 
        RowBox[{"(", "1", ")"}]], "(", 
       RowBox[{
        SubscriptBox["x", "2"], ",", 
        SubscriptBox["x", "2"]}], ")"}], "]"}], 
     RowBox[{"1", "/", "2"}]]]}], TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.9859441174155235`*^9, 3.985944176564951*^9},
 CellID->71634294,ExpressionUUID->"3bd91761-1c16-3e4d-9a4d-02ec7e39ace3"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"0", "<="}], "|", 
    SuperscriptBox["g", 
     RowBox[{"(", "1", ")"}]], "|", 
    RowBox[{"<=", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "361f68e5-e8d4-1e4e-9b16-55b6cddc0e47"],
 " determines if it is coherent, partial coherence or incoherent"
}], "Text",
 CellID->666224448,ExpressionUUID->"5570d8e0-e532-a747-8576-fc57c9343001"],

Cell["Pick a Fock state number:", "Text",
 CellID->72053357,ExpressionUUID->"e3c9dc39-9a0f-3a44-b0c7-676d8e8050b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"n", "=", " ", 
   RowBox[{"RandomInteger", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"$FockSize", "-", "1"}]}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[27]:=",
 CellID->247647723,ExpressionUUID->"88d36789-32e0-024b-9eeb-54c39b253837"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["G", 
      RowBox[{"(", "1", ")"}]], "(", 
     RowBox[{"x", ",", "x"}], ")"}], "=", "n"}], TraditionalForm]],
  ExpressionUUID->"53574d06-e8c6-3844-9d2e-5e7290915bd9"],
 " for a Fock state:"
}], "Text",
 CellID->748862904,ExpressionUUID->"19189373-e60d-7a4f-a30e-20fc7eb3a8f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"G1Correlation", "[", 
   RowBox[{
    RowBox[{"FockState", "[", "n", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", "t"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "t"}], "}"}]}], "}"}]}], "]"}], "==", "n"}]], "Input",
 CellLabel->"In[28]:=",
 CellID->261313709,ExpressionUUID->"a4c2be33-3b2d-694a-85b3-2e333d62ce65"],

Cell[BoxData["True"], "Output",
