Cell[TextData[StyleBox["Three types of behavior of photon statistics",
 FontSlant->"Italic"]], "CodeText",
 TextAlignment->-0.5,
 CellID->370494209,ExpressionUUID->"83411d9d-e995-a246-9eb5-c89d371df89a"],

Cell[TextData[{
 "Following a really similar approach when defining ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", 
    RowBox[{"(", "1", ")"}]], TraditionalForm]],ExpressionUUID->
  "60527007-b39b-9c45-9f0d-4c6fb12a87f7"],
 ", we define ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],ExpressionUUID->
  "dbb5e4f5-fdc3-2a41-84d3-4389df67faf8"],
 " the second-order quantum correlation as"
}], "Text",
 CellID->168378245,ExpressionUUID->"ccb73d63-8b0a-d240-987e-5971bddeb6b5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["G", 
     RowBox[{"(", "2", ")"}]], "(", 
    RowBox[{
     SubscriptBox["x", "1"], ",", 
     SubscriptBox["x", "2"], ";", 
     SubscriptBox["x", "2"], ",", 
     SubscriptBox["x", "1"]}], ")"}], "=", 
   RowBox[{"Tr", "{", 
    RowBox[{
     OverscriptBox["\[Rho]", "^"], 
     SuperscriptBox[
      OverscriptBox["E", "^"], 
      RowBox[{"(", "-", ")"}]], "(", 
     SubscriptBox["x", "1"], ")", 
     SuperscriptBox[
      OverscriptBox["E", "^"], 
      RowBox[{"(", "-", ")"}]], "(", 
     SubscriptBox["x", "2"], ")", 
     SuperscriptBox[
      OverscriptBox["E", "^"], 
      RowBox[{"(", "+", ")"}]], "(", 
     SubscriptBox["x", "2"], ")", 
     SuperscriptBox[
      OverscriptBox["E", "^"], 
      RowBox[{"(", "+", ")"}]], "(", 
     SubscriptBox["x", "1"], ")"}], "}"}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.9859441174155235`*^9, 3.985944176564951*^9},
 FontSize->18,
 CellID->61791917,ExpressionUUID->"55520788-2946-d64e-aa14-34a02124dc4e"],

Cell[TextData[{
 "which is the ensemble average of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"I", "(", 
     SubscriptBox["x", "1"], ")"}], 
    RowBox[{"I", "(", 
     SubscriptBox["x", "2"], ")"}]}], TraditionalForm]],ExpressionUUID->
  "50233a2a-a855-704f-b742-ae01bc4bd691"],
 " following normal order of field operators"
}], "Text",
 CellID->158305501,ExpressionUUID->"b12e35ef-79f3-2f49-865c-4e3f1c82d386"],

Cell["Similarly the second-order quantum coherence function is:", "Text",
 CellID->101764566,ExpressionUUID->"5ba59328-28d5-214f-b437-63f7c0945987"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"(", "2", ")"}]], "(", 
    RowBox[{
     SubscriptBox["x", "1"], ",", 
     SubscriptBox["x", "2"], ";", 
     SubscriptBox["x", "2"], ",", 
     SubscriptBox["x", "1"]}], ")"}], "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["G", 
      RowBox[{"(", "2", ")"}]], "(", 
     RowBox[{
      SubscriptBox["x", "1"], ",", 
      SubscriptBox["x", "2"], ";", 
      SubscriptBox["x", "2"], ",", 
      SubscriptBox["x", "1"]}], ")"}], 
    RowBox[{
     SuperscriptBox["G", 
      RowBox[{"(", "1", ")"}]], "(", 
     RowBox[{
      SubscriptBox["x", "1"], ",", 
      SubscriptBox["x", "1"]}], ")", 
     SuperscriptBox["G", 
      RowBox[{"(", "1", ")"}]], "(", 
     RowBox[{
      SubscriptBox["x", "2"], ",", 
      SubscriptBox["x", "2"]}], ")"}]]}], TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.9859441174155235`*^9, 3.985944176564951*^9},
 CellID->80792832,ExpressionUUID->"a0a46f7b-0aa2-dc42-9108-8aae68e60b9b"],

Cell[TextData[{
 "A state of light is second-order coherent if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", 
     RowBox[{
      SuperscriptBox["g", 
       RowBox[{"(", "2", ")"}]], "(", 
      RowBox[{
       SubscriptBox["x", "1"], ",", 
       SubscriptBox["x", "2"]}], ")"}], "|"}], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "760e25fd-4b1b-6942-978e-7981ef0bbd0d"],
 ", such that the factorization ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["G", 
      RowBox[{"(", "2", ")"}]], "(", 
     RowBox[{
      SubscriptBox["x", "1"], ",", 
      SubscriptBox["x", "2"]}], ")"}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["G", 
       RowBox[{"(", "1", ")"}]], "(", 
      RowBox[{
       SubscriptBox["x", "1"], ",", 
       SubscriptBox["x", "1"]}], ")"}], 
     RowBox[{
      SuperscriptBox["G", 
       RowBox[{"(", "1", ")"}]], "(", 
      RowBox[{
       SubscriptBox["x", "2"], ",", 
       SubscriptBox["x", "2"]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5397ea04-df4b-e241-9dd7-52a6aa31e2fb"],
 " holds"
}], "Text",
 CellID->57124424,ExpressionUUID->"fdaf408c-f694-234f-99df-01ececdbbc1c"],

Cell[TextData[{
 "If the position has a fixed value, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c0eeb4e8-5922-564f-af39-c28075bf1859"],
 " depends only on the time difference \[Tau]"
}], "Text",
 CellID->889731,ExpressionUUID->"da258418-b3b5-9941-8c78-3a5d7f3c886d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"(", "2", ")"}]], "(", "\[Tau]", ")"}], "=", 
   FractionBox[
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SuperscriptBox[
       OverscriptBox["E", "^"], 
       RowBox[{"(", "-", ")"}]], "(", "t", ")", 
      SuperscriptBox[
       OverscriptBox["E", "^"], 
       RowBox[{"(", "-", ")"}]], "(", 
      RowBox[{"t", "+", "\[Tau]"}], ")", 
      SuperscriptBox[
       OverscriptBox["E", "^"], 
       RowBox[{"(", "+", ")"}]], "(", 
      RowBox[{"t", "+", "\[Tau]"}], ")", 
      SuperscriptBox[
       OverscriptBox["E", "^"], 
       RowBox[{"(", "+", ")"}]], "(", "t", ")"}], "\[RightAngleBracket]"}], 
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["E", "^"], 
        RowBox[{"(", "-", ")"}]], "(", "t", ")", 
       SuperscriptBox[
        OverscriptBox["E", "^"], 
        RowBox[{"(", "+", ")"}]], "(", "t", ")"}], "\[RightAngleBracket]"}], 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["E", "^"], 
        RowBox[{"(", "-", ")"}]], "(", 
       RowBox[{"t", "+", "\[Tau]"}], ")", 
       SuperscriptBox[
        OverscriptBox["E", "^"], 
        RowBox[{"(", "+", ")"}]], "(", 
       RowBox[{"t", "+", "\[Tau]"}], ")"}], "\[RightAngleBracket]"}]}]]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.9859441174155235`*^9, 3.985944176564951*^9},
 CellID->69856150,ExpressionUUID->"1ee2a2b5-e9bc-1740-8d3f-78444b31d7a2"],

Cell["\<\
For single-mode states the second-order coherence assumes a simple form\
\>", "Text",
 CellID->89763477,ExpressionUUID->"d2172aea-2d89-c847-9d6e-ff0128ca1d83"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"(", "2", ")"}]], "(", "\[Tau]", ")"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"], 
       SuperscriptBox[
        OverscriptBox["a", "^"], "\[Dagger]"], 
       OverscriptBox["a", "^"], 
       OverscriptBox["a", "^"]}], "\[RightAngleBracket]"}], 
     SuperscriptBox[
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        SuperscriptBox[
         OverscriptBox["a", "^"], "\[Dagger]"], 
        OverscriptBox["a", "^"]}], "\[RightAngleBracket]"}], "2"]], "=", 
    FractionBox[
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       OverscriptBox["n", "^"], "(", 
       RowBox[{
        OverscriptBox["n", "^"], "-", "1"}], ")"}], "\[RightAngleBracket]"}], 
     SuperscriptBox[
      RowBox[{"\[LeftAngleBracket]", 
       OverscriptBox["n", "^"], "\[RightAngleBracket]"}], "2"]]}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.9859441174155235`*^9, 3.985944176564951*^9},
 CellID->197531003,ExpressionUUID->"1a78d0c0-bdc1-224f-8d17-e17b6c2b5b46"],

Cell[TextData[{
 "and does not depend on \[Tau], so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["g", "2"], "(", "\[Tau]", ")"}], "=", 
    RowBox[{
     SuperscriptBox["g", "2"], "(", "0", ")"}]}], TraditionalForm]],
  ExpressionUUID->"0c245b81-12b1-db4c-a19e-216ae90e5945"],
 " which can be easier to calculate, and it relates to photon statistics and \
not to temporal correlations"
}], "Text",
 CellID->415587589,ExpressionUUID->"bdb62701-9516-bd44-9f26-ca97f032f172"],

Cell[TextData[{
 "For a Fock state ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", ">=", "1"}], TraditionalForm]],ExpressionUUID->
  "3cc28043-f99c-404f-b30f-114e15ff4aaa"],
 ", the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"(", "2", ")"}]], "(", "0", ")"}], TraditionalForm]],
  ExpressionUUID->"07ba1fa1-bdf0-3341-b0d1-5e4de361916f"],
 " has the value of  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    RowBox[{"1", "/", "n"}]}], TraditionalForm]],ExpressionUUID->
  "fd92de22-e006-fe49-8b99-930b2195393c"],
 ":"
}], "Text",
 CellID->672345487,ExpressionUUID->"9c2180dd-f8cd-6f4e-9409-6b91d8e25dea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FindSequenceFunction", "[", 
    RowBox[{"Array", "[", 
     RowBox[{
      RowBox[{"G2Coherence", "@*", "FockState"}], ",", 
      RowBox[{"$FockSize", "-", "1"}], ",", "1"}], "]"}], "]"}], "[", 
   "\[FormalN]", "]"}], "//", "Apart"}]], "Input",
 CellLabel->"In[35]:=",
 CellID->75531368,ExpressionUUID->"8ca8228d-25db-d043-bfbd-24610e973918"],

Cell[BoxData[
 RowBox[{"1", "-", 
  FractionBox["1", "\[FormalN]"]}]], "Output",
 CellLabel->"Out[35]=",
 CellID->540332370,ExpressionUUID->"fe2b5330-9a90-6d42-a486-30c62da87a60"]
}, Open  ]],

Cell[TextData[{
 "For the vacuum state ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],ExpressionUUID->
  "4043adc9-ea64-8e4e-a344-82d5e22c6b7d"],
 " is not defined from the mathematical definition, we can also see that \
plugging ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "7ea6a121-d411-424d-ba1d-907d0067778a"],
 " in the above formula. Does not make sense to quantify the coherence of a \
no photons state"
}], "Text",
 CellID->832794082,ExpressionUUID->"0b600402-9b8d-fe45-b8c3-eba83e364955"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"G2Coherence", "[", 
   RowBox[{"FockState", "[", "0", "]"}], "]"}], "//", "Quiet"}]], "Input",
 CellLabel->"In[36]:=",
 CellID->10397615,ExpressionUUID->"cfdd6ebd-b7b1-3140-bfc6-fc9661830814"],

Cell[BoxData["Indeterminate"], "Output",
 CellLabel->"Out[36]=",
 CellID->41310055,ExpressionUUID->"8074f18e-6471-6c45-a098-0cda699cb874"]
}, Open  ]],

Cell[TextData[{
 "Evidently, the superposition ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SqrtBox["2"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "431e5ace-6205-f140-bfa7-6c627b0ea1ff"],
 "(|0\[RightAngleBracket] + |1\[RightAngleBracket]) has zero ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a00fb8b3-2109-c640-abb8-fc27fcd5b85a"],
 ":"
}], "Text",
 CellID->21865247,ExpressionUUID->"ecc55833-afcd-a843-9af0-1c33e2749d0e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"G2Coherence", "[", 
  RowBox[{
   FractionBox["1", 
    SqrtBox["2"]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"FockState", "[", "0", "]"}], "+", 
     RowBox[{"FockState", "[", "1", "]"}]}], ")"}]}], "]"}]], "Input",
 CellLabel->"In[37]:=",
 CellID->45502580,ExpressionUUID->"b804288c-9cf1-e843-b717-6feee0ff738b"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[37]=",
 CellID->280732633,ExpressionUUID->"3d90afb6-1019-de4f-bf4d-e7106fbe25ed"]
}, Open  ]],

Cell["Also for the mixed state of the number states 0 and 1:", "Text",
