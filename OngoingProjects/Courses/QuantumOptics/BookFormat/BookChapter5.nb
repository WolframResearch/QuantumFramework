Cell[TextData[{
 "In general, the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4c848980-43ee-4b46-9a5d-3b6c596b2407"],
 "-",
 Cell[BoxData[
  FormBox["th", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a867a05a-6a2e-7847-9477-25ad891e483a"],
 " order quantum correlation function is:"
}], "Text",
 CellID->226883297,ExpressionUUID->"322945ef-b9cd-c444-aedc-b7c35c22c956"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["G", 
     RowBox[{"(", "n", ")"}]], "(", 
    RowBox[{
     SubscriptBox["x", "1"], ",", "\[Ellipsis]", 
     SubscriptBox["x", "n"], ";", 
     SubscriptBox["x", "n"], ",", "\[Ellipsis]", 
     SubscriptBox["x", "1"]}], ")"}], "=", 
   RowBox[{"Tr", "{", 
    RowBox[{
     OverscriptBox["\[Rho]", "^"], 
     SuperscriptBox[
      OverscriptBox["E", "^"], 
      RowBox[{"(", "-", ")"}]], "(", 
     SubscriptBox["x", "1"], ")", "\[Ellipsis]", 
     SuperscriptBox[
      OverscriptBox["E", "^"], 
      RowBox[{"(", "-", ")"}]], "(", 
     SubscriptBox["x", "n"], ")", 
     SuperscriptBox[
      OverscriptBox["E", "^"], 
      RowBox[{"(", "+", ")"}]], "(", 
     SubscriptBox["x", "n"], ")", "\[Ellipsis]", 
     SuperscriptBox[
      OverscriptBox["E", "^"], 
      RowBox[{"(", "+", ")"}]], "(", 
     SubscriptBox["x", "1"], ")"}], "}"}]}], 
  TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.9859441174155235`*^9, 3.985944176564951*^9},
 CellID->174714044,ExpressionUUID->"7380c5e4-3e62-df4d-93a7-cf7a7d239744"],

Cell[TextData[{
 "And the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9656afc3-3262-c748-baad-651b84c3b38d"],
 "-",
 Cell[BoxData[
  FormBox["th", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a6b366db-e19e-6846-aa0b-d2260b90ed09"],
 " order coherence function can be defined as:"
}], "Text",
 CellID->272316668,ExpressionUUID->"dc3dd4a6-0d64-b74b-a8e2-879e83142196"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"(", "n", ")"}]], "(", 
    RowBox[{
     SubscriptBox["x", "1"], ",", "\[Ellipsis]", 
     SubscriptBox["x", "n"], ";", 
     SubscriptBox["x", "n"], ",", "\[Ellipsis]", 
     SubscriptBox["x", "1"]}], ")"}], "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["G", 
      RowBox[{"(", "n", ")"}]], "(", 
     RowBox[{
      SubscriptBox["x", "1"], ",", "\[Ellipsis]", 
      SubscriptBox["x", "n"], ";", 
      SubscriptBox["x", "n"], ",", "\[Ellipsis]", 
      SubscriptBox["x", "1"]}], ")"}], 
    RowBox[{
     SuperscriptBox["G", 
      RowBox[{"(", "1", ")"}]], "(", 
     RowBox[{
      SubscriptBox["x", "1"], ",", 
      SubscriptBox["x", "1"]}], ")", "\[Ellipsis]", 
     SuperscriptBox["G", 
      RowBox[{"(", "1", ")"}]], "(", 
     RowBox[{
      SubscriptBox["x", "n"], ",", 
      SubscriptBox["x", "n"]}], ")"}]]}], TraditionalForm]], "DisplayFormula",
 GeneratedCell->True,
 CellAutoOverwrite->True,
 CellChangeTimes->{3.9859441174155235`*^9, 3.985944176564951*^9},
 CellID->729594796,ExpressionUUID->"c4781aa2-6962-d540-9242-659c9d7d5837"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Coherence of the field in the Jaynes-Cummings(JC) model", "Subsection",
 CellID->965844199,ExpressionUUID->"3b6f8538-ad68-7a47-8e76-d4e9597c6cb8"],

Cell[TextData[{
 "The second-order correlation function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"(", "2", ")"}]], "(", "0", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f3f4978-750a-4d43-a370-4104bbad6bc0"],
 " for the reduced state of the field in the Jaynes-Cummings model measures \
photon statistics and quantum coherence (bunching or anti-bunching) of the \
cavity mode after tracing out the atom. The interaction generates \
entanglement between the atom and field that reshapes the photon statistics \
as function of time. Since the state is going to evolve we will denote ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"(", "2", ")"}]], "(", 
    RowBox[{"0", ",", "t"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8dab08b2-a428-cf4a-b74c-8ee7e49f3bd8"],
 " as the quantity that is going to be analyzed"
}], "Text",
 CellID->121730330,ExpressionUUID->"2b3ff7fd-49ad-d149-b830-c97094267a18"],

Cell["Setting up parameters:", "Text",
 CellID->766525217,ExpressionUUID->"f450abf3-b536-214b-bb25-fdd6bfed2ed7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetFockSpaceSize", "[", "40", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"atomBasis", "=", 
   RowBox[{"QuantumBasis", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<e\>\"", ",", "\"\<g\>\""}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", ":=", 
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"{", "2", "}"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[28]:=",
 CellID->498704825,ExpressionUUID->"c203ab2d-a4d0-df4e-92da-5e4dd26fde06"],

Cell["Atomic operators:", "Text",
 CellID->415436094,ExpressionUUID->"506648cb-a75d-0d43-92bf-a59955c25268"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Sigma]plus", "=", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<+\>\"", ",", "atomBasis"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]minus", "=", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<-\>\"", ",", "atomBasis"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.966620358252846*^9, 3.96662036240485*^9}},
 CellLabel->"In[31]:=",
 CellID->329221303,ExpressionUUID->"00afcf9d-10ed-2a42-a362-9eb76f4067f0"],

Cell["Solving the JC model in the same way as in Chapter 4:", "Text",
 CellID->1027449386,ExpressionUUID->"228144cf-d784-8649-a1fe-6e0dda460689"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"H0", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"h", " ", "\[Nu]", " ", 
       RowBox[{
        SuperscriptBox["a", "\[Dagger]"], "@", "a"}]}], "+", "  ", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", "h", " ", "\[Omega]", " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<Z\>\"", ",", "atomBasis"}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", "\[Omega]"}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H1", " ", "=", " ", 
   RowBox[{"h", " ", "g", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Sigma]plus", "@", "a"}], " ", "+", 
      RowBox[{"\[Sigma]minus", "@", 
       SuperscriptBox["a", "\[Dagger]"]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HInteract", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"MatrixExp", "[", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"H0", "/", "h"}], " ", "t"}], "]"}], "@", " ", 
     RowBox[{"H1", " ", "@", " ", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"H0", "/", "h"}], " ", "t"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"U", " ", "=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     RowBox[{
      RowBox[{"HInteract", "[", 
       RowBox[{"\[Nu]", ",", "\[Nu]"}], "]"}], "/", "h"}], " ", "t"}], 
    "]"}]}], ";"}]}], "Input",
 Background->None,
 CellLabel->"In[33]:=",
 CellID->120262363,ExpressionUUID->"c1c7b91f-cc60-a848-953f-d41987415f75"],

Cell[TextData[{
 "We will consider initial states of the form |",
 Cell[BoxData[
  FormBox["e", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "09da861e-77ef-f249-a8e6-22a468fbce04"],
 "\[RightAngleBracket]\[CircleTimes]|\[Alpha]\[RightAngleBracket], for \
different values of the complex amplitude \[Alpha]"
}], "Text",
 CellID->169557567,ExpressionUUID->"06749267-4153-c947-a476-bab2658c333e"],

Cell["Build the product states:", "Text",
 CellID->385574472,ExpressionUUID->"6d3b68d6-ffe8-894b-8514-c6db8b6712f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]0states", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumTensorProduct", "[", 
      RowBox[{
       RowBox[{"QuantumState", "[", 
        RowBox[{"\"\<1\>\"", ",", "atomBasis"}], "]"}], ",", 
       RowBox[{
        RowBox[{"CoherentState", "[", "]"}], "[", "#", "]"}]}], "]"}], "&"}], 
    "/@", 
    RowBox[{"{", 
     RowBox[{"0.001", ",", "1.", ",", "2.", ",", "3."}], "}"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[37]:=",
 CellID->196992466,ExpressionUUID->"5d085e4e-247e-3945-8d91-c06179a59a0b"],

Cell[TextData[{
 "Evolve the states with the ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["U", "^"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7171aad2-57a7-2a47-89ec-33b272f874e5"],
 " unitary operator:"
}], "Text",
 CellID->498424339,ExpressionUUID->"5a79c300-9de1-394d-8100-36907c2cd27c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]ts", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{
       RowBox[{"U", "@", "#"}], ",", 
       RowBox[{"\"\<Parameters\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"g", ",", "t"}], "}"}]}]}], "]"}], "&"}], "/@", 
    "\[Psi]0states"}]}], ";"}]], "Input",
 CellLabel->"In[38]:=",
 CellID->21639175,ExpressionUUID->"1f78c476-11dc-0543-bd76-cfab99684686"],

Cell[TextData[{
 "Compute ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", 
    RowBox[{"(", "2", ")"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e4680cd9-b03e-ec46-a1ac-c3a365c73f6a"],
 " for the time evolved states:"
}], "Text",
 CellID->194930845,ExpressionUUID->"84879dd5-0741-c942-aaf6-1909e70fe182"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g2s", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"G2Coherence", "[", 
      RowBox[{"QuantumPartialTrace", "[", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"0.5", ",", "t"}], "]"}], ",", 
        RowBox[{"{", "1", "}"}]}], "]"}], "]"}], "&"}], "/@", "\[Psi]ts"}]}], 
  ";"}]], "Input",
 CellLabel->"In[43]:=",
 CellID->38835492,ExpressionUUID->"c92d9611-8630-c54e-b4dc-90607777dccf"],

Cell[TextData[{
 "Results of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"(", "2", ")"}]], "(", 
    RowBox[{"0", ",", "t"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4fc19dc6-2901-2c4a-9cbc-d6985f589474"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Alpha]", "\[TildeTilde]", " ", 
      RowBox[{"0", " ", "and", " ", "\[Alpha]"}]}], "=", "1"}], ",", "2", ",",
     "3"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b942df3d-6b2c-8f49-810f-672fa578551d"]
}], "Text",
 CellID->147313564,ExpressionUUID->"9bcf3b91-f1f1-5f4a-960a-b31bfca49e80"],

Cell[TextData[{
 "Observing the case ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "\[TildeTilde]", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4d8f093c-8f62-8244-b535-8e9234966e8a"],
 " perfectly captures the theoretical prediction for an excited atom \
interacting with a near-vacuum cavity. The massive spikes are the \
singularities that occur at the vacuum nodes. As the energy transfers \
completely back to the atom, the mean photon number in the cavity approaches \
zero, causing the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", "2"], "(", "0", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
