Cell[TextData[{
 "For a thermal state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"(", "2", ")"}]], "=", "2"}], TraditionalForm]],ExpressionUUID->
  "5645df1b-84cf-2e4c-ad3b-da9061dff3ed"],
 ", so we say thermal light is not second-order coherent and has higher \
probability of detecting coincident photons"
}], "Text",
 CellID->350187346,ExpressionUUID->"29558ef1-a1ca-9342-9008-e709043bd877"],

Cell["\<\
Second order coherence for a symbolic thermal state depending on the mean \
number of photons:\
\>", "Text",
 CellID->91372758,ExpressionUUID->"03d72cd6-86df-8d44-9091-d486f67a36fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"thermalG2", " ", "=", " ", 
   RowBox[{"G2Coherence", "[", 
    RowBox[{"ThermalState", "[", 
     RowBox[{"x", ",", "30"}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[41]:=",
 CellID->55923922,ExpressionUUID->"300858a5-191b-9a4e-9e47-b1e7cff45065"],

Cell["We can also see the effect of truncation numerical error:", "Text",
 CellID->820420271,ExpressionUUID->"07cd3fb8-0e16-e946-873d-54cb230baea3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{"thermalG2", ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "5"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*OverscriptBox[\(n\), \(\[LongDash]\)]\)\>\"", 
      ",", "\"\<\!\(\*SuperscriptBox[\(g\), \((2)\)]\)\>\""}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"1.5", ",", "2"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[54]:=",
