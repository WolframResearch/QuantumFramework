 CellID->141492488,ExpressionUUID->"d4d2c4bd-07eb-e443-9863-6579c0409832"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["G", 
     RowBox[{"(", "1", ")"}]], "(", 
    RowBox[{
     SubscriptBox["x", "1"], ",", 
     SubscriptBox["x", "2"]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "46e1845f-630b-6143-a94a-587fabd564f5"],
 " for a Fock state:"
}], "Text",
 CellID->97543443,ExpressionUUID->"645e88ab-1ee7-b345-8c06-43fc8513888b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"G1Correlation", "[", 
   RowBox[{
    RowBox[{"FockState", "[", "n", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r1", ",", "t1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"r2", ",", "t2"}], "}"}]}], "}"}]}], "]"}], "//", 
  "FullSimplify"}]], "Input",
 CellLabel->"In[29]:=",
 CellID->168861056,ExpressionUUID->"f14df542-428b-c642-b899-ec405af49718"],

Cell[BoxData[
 RowBox[{"10", " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"\[ImaginaryI]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[FormalOmega]", " ", 
       RowBox[{"(", 
        RowBox[{"t1", "-", "t2"}], ")"}]}], "+", 
      RowBox[{"\[FormalK]", ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "r1"}], "+", "r2"}], ")"}]}]}], ")"}]}]]}]], "Output",
 CellLabel->"Out[29]=",
 CellID->453167819,ExpressionUUID->"45c891d2-8800-6e4a-81bc-fb780535a4c6"]
}, Open  ]],

Cell[TextData[{
 "clearly when normalizing we divide by ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2d6f106e-7758-7d4e-87d8-9b0e5b22a54f"],
 " , hence |",
