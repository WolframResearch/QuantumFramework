           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
         Dynamic[Typeset`open]},
        "IconizedObject"]],
      Sequence[
      PlotStyle -> Red, PlotMarkers -> Automatic, PlotLegends -> {"GBS"}, 
       AxesLabel -> {"modes", "collision-free fraction"}, PlotRange -> {0, 1},
        LabelStyle -> 13],
      SelectWithContents->True,
      Selectable->False]}], "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"Binomial", "[", 
       RowBox[{"m", ",", "4"}], "]"}], 
      RowBox[{"Binomial", "[", 
       RowBox[{
        RowBox[{"m", "+", "3"}], ",", "4"}], "]"}]], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "4", ",", "24"}], "}"}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"{", "\"\<uniform bosons\>\"", "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
