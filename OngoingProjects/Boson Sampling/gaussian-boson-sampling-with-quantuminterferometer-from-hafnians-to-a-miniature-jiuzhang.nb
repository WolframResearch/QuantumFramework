  4.002381773493244*^9}},ExpressionUUID->"178d762a-36ef-ee45-9668-\
15ec078d047b"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]],ExpressionUUID->
  "c86dc8bd-4a10-d848-bb67-8753dd583275"],
 " is the set of modes that click, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "Q"], TraditionalForm]],ExpressionUUID->
  "cc32d9d4-617e-1c4e-a5fd-62fce6b27007"],
 " is the covariance matrix of the Husimi Q function in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a", ",", 
     SuperscriptBox["a", "\[Dagger]"]}], "}"}], TraditionalForm]],
  ExpressionUUID->"b22b46b8-e9f5-9640-85bb-124d03135dff"],
 " basis, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["O", "Z"], TraditionalForm]],ExpressionUUID->
  "9361ea86-a2af-3b4c-9ed7-15adaa1ba185"],
 " keeps the rows and columns of the modes in ",
 Cell[BoxData[
  FormBox["Z", TraditionalForm]],ExpressionUUID->
  "9315c6dd-778d-0e48-977c-9f64624af57f"],
 ". In terms of ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "aac7ec77-97cd-b641-a3ef-a61dad895de0"],
 " and ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "97529abf-1576-3e41-b6ca-fe24d90cce2c"],
 ":"
}], "Text",
 CellChangeTimes->{{4.0023818895720863`*^9, 
  4.0023819646359024`*^9}},ExpressionUUID->"a554974c-9e90-6f49-9072-\
26317f996864"],

Cell[BoxData[
 RowBox[{
  RowBox[{"husimiCovariance", "[", 
   RowBox[{"{", 
    RowBox[{"n_", ",", "m_"}], "}"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"id", "=", 
      RowBox[{"IdentityMatrix", "[", 
       RowBox[{"Length", "[", "n", "]"}], "]"}]}], "}"}], ",", 
    RowBox[{"ArrayFlatten", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", "n", "]"}], "+", "id"}], ",", "m"}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Conjugate", "[", "m", "]"}], ",", 
         RowBox[{"n", "+", "id"}]}], "}"}]}], "}"}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{4.00238197215053*^9, 4.0023819751103516`*^9}},
 CellLabel->"In[71]:=",ExpressionUUID->"10d27dd4-e606-be46-8432-79548fa7ede8"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"I", "-", 
     SubscriptBox["O", "Z"]}], "=", 
    SubscriptBox[
     RowBox[{"(", 
      SubsuperscriptBox["\[Sigma]", "Q", 
       RowBox[{"-", "1"}]], ")"}], "Z"]}], TraditionalForm]],ExpressionUUID->
  "db1d8c3e-bdca-164e-9b80-2a38cd2a01bf"],
 ", the Torontonian only needs principal minors of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", "Q", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "efa58bb1-06f2-3e4b-88f8-9bd06f48f937"],
 ":"
}], "Text",
 CellChangeTimes->{{4.0023823677824574`*^9, 
  4.002382433559046*^9}},ExpressionUUID->"13935c52-8f02-8c48-9a1a-\
9a87700e0452"],

Cell[BoxData[
 RowBox[{
  RowBox[{"clickProbability", "[", 
   RowBox[{"\[Sigma]Q_", ",", "s_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m", "=", 
       FractionBox[
        RowBox[{"Length", "[", "\[Sigma]Q", "]"}], "2"]}], ",", 
      RowBox[{"inv", "=", 
       TemplateBox[{"\[Sigma]Q"},
        "Inverse"]}]}], "}"}], ",", 
    RowBox[{"Re", "[", 
     FractionBox[
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], 
            RowBox[{
             RowBox[{"Length", "[", "s", "]"}], "-", 
             RowBox[{"Length", "[", "#1", "]"}]}]], " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"#1", "===", 
              RowBox[{"{", "}"}]}], ",", "1", ",", 
             FractionBox["1", 
              SqrtBox[
               RowBox[{"Det", "[", 
                RowBox[{"inv", "\[LeftDoubleBracket]", 
                 RowBox[{
                  RowBox[{"Join", "[", 
                   RowBox[{"#1", ",", 
                    RowBox[{"#1", "+", "m"}]}], "]"}], ",", 
                  RowBox[{"Join", "[", 
                   RowBox[{"#1", ",", 
                    RowBox[{"#1", "+", "m"}]}], "]"}]}], 
                 "\[RightDoubleBracket]"}], "]"}]]]}], "]"}]}], "&"}], ")"}], 
        "/@", 
        RowBox[{"Subsets", "[", "s", "]"}]}], "]"}], 
      SqrtBox[
       RowBox[{"Det", "[", "\[Sigma]Q", "]"}]]], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.0023820475416737`*^9, 4.0023820516974907`*^9}, {
  4.0023837405331497`*^9, 4.0023837425840626`*^9}},
 CellLabel->
  "In[100]:=",ExpressionUUID->"b9f61f73-e8ec-7b43-af93-092ed2a29995"],

Cell["\<\
A Jiuzhang in miniature six equal squeezers into a random twelve-mode mesh, \
the other six inputs left in vacuum\
\>", "Text",
 CellChangeTimes->{{4.002382079746231*^9, 4.0023820822270927`*^9}, 
   4.002382831678171*^9},ExpressionUUID->"b076cfe8-b3a3-1444-84b2-\
928435c9bca5"],

Cell["Define the squeezers values:", "Text",
 CellChangeTimes->{{4.0023828413502655`*^9, 
  4.0023828459734516`*^9}},ExpressionUUID->"eaf557b3-5c4c-8c4d-9cc9-\
5208be90b34b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Xi]12", "=", 
   RowBox[{"PadRight", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.6", ",", "6"}], "]"}], ",", "12"}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{4.0023828358174877`*^9, 4.0023828387186775`*^9}},
 CellLabel->
  "In[101]:=",ExpressionUUID->"b36213fa-fbde-794e-8bf5-818056cdfd10"],

Cell["Build the GBS network:", "Text",
 CellChangeTimes->{{4.0023828935789814`*^9, 
  4.0023829022224503`*^9}},ExpressionUUID->"7529a522-fffc-c944-bf24-\
0e1c2d8174f7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "100", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"jiuzhangMesh", "=", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"\"\<Random\>\"", "[", "12", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"jiuzhang", "=", 
   RowBox[{"gbsNetwork", "[", 
    RowBox[{"\[Xi]12", ",", "jiuzhangMesh"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0023828722522526`*^9, 4.0023828786051655`*^9}},
 CellLabel->
  "In[102]:=",ExpressionUUID->"fb802c68-9395-6b42-9125-1b7ed3a9a0d7"],

Cell["Visualize the network:", "Text",
 CellChangeTimes->{{4.002382913549181*^9, 
  4.002382917228279*^9}},ExpressionUUID->"3e2a5aed-c5f9-e748-ba7a-\
60fc8b15a112"],

