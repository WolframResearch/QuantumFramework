Cell["\<\
With vacuum input, the GBS form gives the same probabilities for every \
pattern up to 6 photons:\
\>", "Text",
 CellChangeTimes->{
  4.0021299509311256`*^9},ExpressionUUID->"b594e5f9-57e7-314a-8004-\
91b1c90c79f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Values", "[", 
      RowBox[{"net", "[", 
