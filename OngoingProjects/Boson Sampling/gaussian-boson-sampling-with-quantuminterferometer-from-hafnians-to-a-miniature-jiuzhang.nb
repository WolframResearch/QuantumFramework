Cell["\<\
If the squeezers are of the same sign we do not get the squeezed vacuum state:\
\>", "Text",
 CellChangeTimes->{{4.002128024981642*^9, 
  4.0021280385995636`*^9}},ExpressionUUID->"176719f2-c07c-3241-8066-\
b80c17452ae5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sameSign", "=", 
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<S\>\"", "[", 
        RowBox[{"1", "/", "2"}], "]"}], "->", "1"}], ",", 
      RowBox[{
       RowBox[{"\"\<S\>\"", "[", 
        RowBox[{"1", "/", "2"}], "]"}], "->", "2"}], ",", 
      RowBox[{
       RowBox[{"\"\<BS\>\"", "[", 
        RowBox[{
         RowBox[{"\[Pi]", "/", "4"}], ",", "0"}], "]"}], "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}]}]}], "}"}], ",", "2"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{4.0017864708203697`*^9, 4.0017865087517624`*^9}, {
   4.0023629779262104`*^9, 4.002362979216097*^9}, {4.0023631950659485`*^9, 
   4.002363196385729*^9}, {4.0023635587900906`*^9, 4.0023635675840683`*^9}, {
