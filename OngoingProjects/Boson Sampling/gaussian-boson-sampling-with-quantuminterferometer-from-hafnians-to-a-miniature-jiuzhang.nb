Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sq0Prob", " ", "=", " ", 
  RowBox[{"FunctionExpand", "@", 
   RowBox[{"Simplify", "@", 
    RowBox[{"FindSequenceFunction", "[", 
     RowBox[{"%", ",", "n"}], "]"}]}]}]}]], "Input",
