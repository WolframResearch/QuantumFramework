Cell[TextData[{
 "Each additional pair of photons doubles the cost, times the polynomial \
factor. Bunched patterns are cheaper, when row ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "7819f8fb-d6d6-f74d-90d5-c720c7d4b95e"],
 " repeats ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "j"], TraditionalForm]],ExpressionUUID->
  "81f126bf-778b-cd40-9ad9-5d72d3d7405f"],
 " times, the hafnian is a sum of  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPi]", "j"], " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["n", "j"], "+", "1"}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"164e1bef-dc89-2048-8d02-b50dc914da57"],
 " , instead of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    RowBox[{"n", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "72bb3fd2-ce98-4240-8900-bd9a236140b0"],
 " for the collision-free case"
}], "Text",
 CellChangeTimes->{{4.00239212668227*^9, 
  4.0023922211433544`*^9}},ExpressionUUID->"f16d93f3-a0f0-d741-9a7d-\
aaae694a2014"],

Cell["With 32 photons in two modes:", "Text",
 CellChangeTimes->{
  4.002392224377146*^9},ExpressionUUID->"048b3523-cc3a-264b-967b-\
1c5bcbd0b2ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"big", "[", 
    RowBox[{"\"\<Amplitude\>\"", ",", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", "32"}], "]"}], "->", 
      RowBox[{"onFirstModes", "[", 
