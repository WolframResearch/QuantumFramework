Cell[TextData[{
 "Indices of the photons of a pattern, mode ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "1f566716-bfc8-2947-a320-583c670d0a40"],
 " repeated ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "j"], TraditionalForm]],ExpressionUUID->
  "b575dad7-e37f-3147-a4e1-58eb39cae50b"],
 " times:"
}], "Text",
 CellChangeTimes->{{4.0023662018314342`*^9, 
  4.0023662084432297`*^9}},ExpressionUUID->"e4a082e0-43b6-c44a-bae3-\
683b97b76344"],

Cell[BoxData[
 RowBox[{
  RowBox[{"photonIndices", "[", "n_", "]"}], ":=", 
  RowBox[{"Catenate", "[", 
   RowBox[{"MapIndexed", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"First", "[", "#2", "]"}], ",", "#1"}], "]"}], "&"}], ",", 
     "n"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{4.00236622069252*^9, 4.00236622069252*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"a2a13588-b309-ff4f-b649-0d9db8a67bfa"],

Cell["The amplitude of Hamilton et al. :", "Text",
 CellChangeTimes->{{4.002133478622984*^9, 
  4.0021334851220036`*^9}},ExpressionUUID->"2f77a7b2-e4a2-6d4a-b02b-\
a7cf82d76ff3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"hamiltonAmplitude", "[", 
   RowBox[{"w_", ",", "\[Xi]s_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"b", "=", 
       RowBox[{"-", 
        RowBox[{"w", ".", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"\[ImaginaryI]", " ", 
             RowBox[{"Arg", "[", "\[Xi]s", "]"}]}], "]"}], " ", 
           RowBox[{"Tanh", "[", 
            RowBox[{"Abs", "[", "\[Xi]s", "]"}], "]"}]}], "]"}], ".", 
         RowBox[{"Transpose", "[", "w", "]"}]}]}]}], ",", 
      RowBox[{"idx", "=", 
       RowBox[{"photonIndices", "[", "n", "]"}]}]}], "}"}], ",", 
    FractionBox[
     RowBox[{"hafnian", "[", 
      RowBox[{"b", "\[LeftDoubleBracket]", 
       RowBox[{"idx", ",", "idx"}], "\[RightDoubleBracket]"}], "]"}], 
     SqrtBox[
      RowBox[{
       RowBox[{"Times", "@@", 
        RowBox[{"(", 
         RowBox[{"n", "!"}], ")"}]}], " ", 
       RowBox[{"Times", "@@", 
        RowBox[{"Cosh", "[", 
         RowBox[{"Abs", "[", "\[Xi]s", "]"}], "]"}]}]}]]]}], "]"}]}]], "Input",\

 CellChangeTimes->{{4.0023662326692696`*^9, 4.0023662358613396`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"a344788c-119b-c047-90a6-72212ff04e4d"],

Cell["Extract the unitary:", "Text",
 CellChangeTimes->{{4.002133622610367*^9, 
  4.0021336261462994`*^9}},ExpressionUUID->"a6adfd3e-b524-384e-aba6-\
1dcf2488fe69"],

Cell[BoxData[
 RowBox[{
  RowBox[{"w", "=", 
   RowBox[{"mesh", "[", "\"\<Unitary\>\"", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002130700576723*^9, 4.002130700576723*^9}, {
   4.0021335689620647`*^9, 4.0021335715075397`*^9}, 4.002133631308296*^9},
 CellLabel->"In[31]:=",ExpressionUUID->"f0285b55-14e1-9143-937f-83e75fefc1fa"],

Cell["Every pattern up to 6 photons, 130 patterns in total:", "Text",
 CellChangeTimes->{{4.002133642870699*^9, 
  4.0021336683157673`*^9}},ExpressionUUID->"4fb1d365-6b27-314c-a883-\
024f382e77bc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"patterns", "=", 
   RowBox[{"Catenate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"FrobeniusSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", "#"}], 
       "]"}], "&"}], "/@", 
     RowBox[{"{", 
      RowBox[{"0", ",", "2", ",", "4", ",", "6"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "patterns", "]"}]}], "Input",
 CellChangeTimes->{{4.002130700576723*^9, 4.002130700576723*^9}, {
  4.0021335689620647`*^9, 4.0021335715075397`*^9}, {4.002133631308296*^9, 
  4.00213366052001*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"4b1520bd-0cf4-9e47-a0c4-42656e7e4851"],

Cell[BoxData["130"], "Output",
 CellChangeTimes->{4.0021336610249214`*^9, 4.002133873765854*^9, 
  4.002366261336216*^9},
 CellLabel->"Out[76]=",ExpressionUUID->"9076b4dc-98e8-7647-88d4-200465140d56"]
}, Open  ]],

Cell["Compare with QuantumInterferometer on every pattern:", "Text",
 CellChangeTimes->{{4.0021337657002316`*^9, 
  4.0021337733229733`*^9}},ExpressionUUID->"41b43255-8822-bc4f-9ad1-\
91777b1ab5f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"amplitudes", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"gbs", "[", 
        RowBox[{"\"\<Amplitude\>\"", ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], "->", "#"}]}], 
        "]"}], "&"}], "/@", "patterns"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"hamiltonAmplitude", "[", 
        RowBox[{"w", ",", "\[Xi]s", ",", "#"}], "]"}], "&"}], "/@", 
      "patterns"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002133684363453*^9, 4.002133684363453*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"968dca84-11b3-894f-805e-3dece8527ea9"],

Cell["Show the result:", "Text",
 CellChangeTimes->{{4.002133781841444*^9, 
  4.002133783596945*^9}},ExpressionUUID->"b3b1b9e6-e60f-4546-a31d-\
3d8c325a75d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"Abs", "[", "amplitudes", "]"}], "2"], ",", 
   RowBox[{"PlotMarkers", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<\[FilledCircle]\>\"", ",", "12"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<\[EmptyCircle]\>\"", ",", "18"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<QuantumInterferometer\>\"", 
      ",", "\"\<hafnian formula\>\""}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<pattern\>\"", ",", "\"\<probability\>\""}], "}"}]}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", "13"}]}], "]"}]], "Input",
