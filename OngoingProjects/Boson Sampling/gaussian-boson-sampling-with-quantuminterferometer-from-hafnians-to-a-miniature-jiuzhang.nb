Cell[TextData[{
 "Calculate the distribution for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "3c1f55d9-f0f8-8248-8488-0a531fc39fcd"],
 " , ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Eta]", "=", "0.7"}], TraditionalForm]],ExpressionUUID->
  "6afff663-64cb-474e-8f4b-0ad8a12e431f"],
 " :"
}], "Text",
 CellChangeTimes->{{4.002626537236849*^9, 4.002626552659506*^9}, {
  4.0026270057752857`*^9, 4.002627024285425*^9}, {4.0026272064641705`*^9, 
  4.0026272141163635`*^9}, {4.00262766814365*^9, 
  4.0026276815668697`*^9}},ExpressionUUID->"8950d3cd-125a-fd41-bcce-\
90f6dec3b83d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"detected", "=", 
   RowBox[{"detectedDistribution", "[", 
    RowBox[{"1.", ",", "0.7", ",", "50"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002625903997473*^9, 4.002625903997473*^9}, {
  4.0026262748567123`*^9, 4.0026262951373177`*^9}, {4.0026265314220333`*^9, 
  4.0026265865000534`*^9}, {4.0026270483313007`*^9, 4.0026270487940083`*^9}, {
  4.002627137413702*^9, 4.002627184452421*^9}, {4.002627684582262*^9, 
  4.0026276946183167`*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"70f20637-94cb-744b-b1a0-ad932c437def"],

Cell[TextData[{
 "The mean photon number is \[Eta] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"sinh", "(", "r", ")"}], "2"], TraditionalForm]],ExpressionUUID->
  "f67ef24e-a29b-cb48-8bb7-8dab02e48f06"],
 ":"
}], "Text",
 CellChangeTimes->{{4.0026277209094257`*^9, 
  4.0026277453607044`*^9}},ExpressionUUID->"12147288-fa2e-044c-9e58-\
20aa9e224677"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Total", "[", 
    RowBox[{"KeyValueMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#1", " ", "#2"}], "&"}], ",", "detected"}], "]"}], "]"}], ",", 
   RowBox[{"0.7", " ", 
    SuperscriptBox[
     RowBox[{"Sinh", "[", "1.", "]"}], "2"]}]}], "}"}]], "Input",
 CellChangeTimes->{{4.0026259322538166`*^9, 4.002625935361582*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"6dd0a6d1-6470-854c-9968-b53048b197ff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.9667640035605735`", ",", "0.9667684918792707`"}], 
  "}"}]], "Output",
 CellChangeTimes->{
  4.0026259375732307`*^9, {4.0026262854464893`*^9, 4.0026263029012966`*^9}, 
   4.0026277506915684`*^9},
 CellLabel->"Out[50]=",ExpressionUUID->"f6f522f3-c3cf-d14b-9cce-e65c660b5cc7"]
}, Open  ]],

Cell[TextData[{
 "For a Gaussian state the parity is  \[Pi] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"W", "(", "0", ")"}], TraditionalForm]],ExpressionUUID->
  "82cae7b4-7de6-ec4d-8948-d80e08012c92"],
 ", and after loss the quadrature variances become ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Eta]", " ", 
       SuperscriptBox[
        RowBox[{"\[ExponentialE]", " "}], 
        RowBox[{
         RowBox[{"\[PlusMinus]", " ", "2"}], "r"}]]}], "+", "1", "-", 
      "\[Eta]"}], ")"}], "/", "2"}], TraditionalForm]],ExpressionUUID->
  "b503a3a1-c5a1-ac41-95b0-ab007a3972c1"],
 ". This gives the probability of an odd photon number:"
}], "Text",
 CellChangeTimes->{
  4.0026277729562035`*^9, {4.00262782405048*^9, 
   4.0026278770709515`*^9}},ExpressionUUID->"7684c83c-7f06-e448-8a45-\
4fd6dad65269"],

Cell[BoxData[
 RowBox[{
  RowBox[{"oddProbability", "[", 
   RowBox[{"r_", ",", "\[Eta]_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     FractionBox["1", 
      SqrtBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Eta]", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{"2", " ", "r"}], "]"}]}], "+", "1", "-", "\[Eta]"}], 
         ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Eta]", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "2"}], " ", "r"}], "]"}]}], "+", "1", "-", 
          "\[Eta]"}], ")"}]}]]]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{4.002625954337021*^9, 4.0026259564439545`*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"63a9ba8b-210c-f14a-a4ee-d6e532ec9dfa"],

Cell["\<\
Odd fraction from the table, for transmissions from 10% to 100%:\
\>", "Text",
 CellChangeTimes->{
  4.0026279247907047`*^9},ExpressionUUID->"1cd72632-34ff-3141-a200-\
4fb0016816ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"oddFromTable", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Eta]", ",", 
       RowBox[{"Total", "@", 
        RowBox[{"KeySelect", "[", 
         RowBox[{
          RowBox[{"detectedDistribution", "[", 
           RowBox[{"1.", ",", "\[Eta]"}], "]"}], ",", "OddQ"}], "]"}]}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Eta]", ",", "0.1", ",", "1", ",", "0.1"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.002625964440239*^9, 4.002625964440239*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"7a166ce8-6edc-374b-a55e-66ffd8411dd4"],

