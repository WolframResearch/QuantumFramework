Cell["\<\
Sample each pattern mode by mode, heterodyne outcomes on the modes not yet \
counted leave the counted ones in a pure Gaussian state, and trading one \
heterodyne outcome at a time for a photon count gives the exact distribution \
\
\>", "Text",
 CellChangeTimes->{{4.002380378929899*^9, 
  4.0023803976257267`*^9}},ExpressionUUID->"43f1ce44-7b03-ef46-b8e4-\
493db71cb339"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"shots", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"#1", "[", "\"\<Name\>\"", "]"}], "&"}], ")"}], "/@", 
    RowBox[{"gbs", "[", 
     RowBox[{"\"\<Samples\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
      SuperscriptBox["10", "5"]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0023801018866024`*^9, 
  4.002380121622877*^9}},ExpressionUUID->"23375b6f-5432-6345-bc8e-\
a056cb386fd8"],

Cell[TextData[{
 "Now estimate the same moments from the first ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "6ee3d13d-6f9e-cd4b-ae54-a2527a64649a"],
 " shots and measure their largest deviation from Wick\[CloseCurlyQuote]s \
theorem:"
}], "Text",
 CellChangeTimes->{{4.0023804234429417`*^9, 4.0023804372235928`*^9}, {
  4.002380478453167*^9, 
  4.0023804803280964`*^9}},ExpressionUUID->"60c18307-ea52-2a49-913a-\
b0f163014378"],

Cell[BoxData[
 RowBox[{
  RowBox[{"shotErrors", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"wickErrors", "[", 
         RowBox[{"EmpiricalDistribution", "[", 
          RowBox[{"N", "[", 
           RowBox[{"shots", "\[LeftDoubleBracket]", 
            RowBox[{"1", ";;", "k"}], "\[RightDoubleBracket]"}], "]"}], "]"}],
          "]"}]}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"Round", "[", 
        SuperscriptBox["10", 
         RowBox[{"Range", "[", 
          RowBox[{"2", ",", "5", ",", "0.5"}], "]"}]], "]"}]}], "}"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002380136809759*^9, 4.0023801384709415`*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"f6142c85-f16a-854a-b9dd-d23fd554093c"],

Cell[TextData[{
 "Both deviations follow the dashed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SqrtBox["k"], " "}], TraditionalForm]],ExpressionUUID->
  "bb5547a0-56b6-e44b-9f58-159c29e4e2d4"],
 "line, the statistical error of a finite experiment, so the sampler has no \
bias at this level:"
}], "Text",
 CellChangeTimes->{
  4.002380485731386*^9},ExpressionUUID->"ae690413-acf8-ed46-b23d-\
d6e0c031144a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLogLogPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", "shotErrors", "]"}], ",", 
     InterpretationBox[
