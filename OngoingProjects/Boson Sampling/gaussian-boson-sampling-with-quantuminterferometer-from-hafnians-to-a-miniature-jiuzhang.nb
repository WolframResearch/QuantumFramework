Cell[TextData[{
 "\nThe thermal model falls far short because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["N", 
     RowBox[{"i", " ", "j"}]], " ", "=", " ", 
    RowBox[{
     SubscriptBox["\[Sum]", 
      RowBox[{" ", "k"}]], " ", 
     RowBox[{
      RowBox[{
       SubscriptBox["W", 
        RowBox[{"i", " ", "k"}]], "\[Conjugate]"}], 
      SubscriptBox["W", 
       RowBox[{"j", " ", "k"}]], " ", 
      SuperscriptBox[
       RowBox[{"sinh", "(", 
        SubscriptBox["r", "k"], ")"}], "2"]}]}]}], TraditionalForm]],
  ExpressionUUID->"f7a49f36-3218-b648-9768-a7260d63eee8"],
 " vanishes off the diagonal when all squeezers are equal, the rows of W \
being orthogonal , here it only comes from the unequal squeezing. Tests like \
this one were used to rule out thermal and distinguishable-photon models of \
Jiuzhang. "
}], "Text",
 CellChangeTimes->{
  4.0023807339260674`*^9, {4.0023807675896435`*^9, 4.002380772534672*^9}, {
   4.0023808067992897`*^9, 4.002380836712227*^9}, {4.002380872643673*^9, 
   4.00238088863361*^9}},ExpressionUUID->"91e909bd-026f-ab41-8e0b-\
e117cce6bb3d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Simple model of photon loss", "Section",
 CellChangeTimes->{{4.00262584731386*^9, 4.0026258485487576`*^9}, {
  4.0026260280622654`*^9, 
  4.002626031884819*^9}},ExpressionUUID->"68afcd18-18c7-4542-a6d2-\
ac65eeedd367"],

Cell["\<\
Loss in a mode can be described as a coupling to beam splitter with \
transmission \[Eta] to a mode we do not look at:\
\>", "Text",
 CellChangeTimes->{{4.002626061299631*^9, 4.0026261131200695`*^9}, {
  4.0026269595826626`*^9, 
  4.0026269876130238`*^9}},ExpressionUUID->"b7b6bbde-a974-0149-ba7e-\
da39da04a3ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lossySqueezer", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\"\<S\>\"", "[", "r", "]"}], "->", "1"}], ",", 
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{
          RowBox[{"ArcCos", "[", 
           SqrtBox["\[Eta]"], "]"}], ",", "0"}], "]"}], "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}]}]}], "}"}], ",", "2", ",", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"r", ",", "\[Eta]"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.00262584993503*^9, 4.00262584993503*^9}, {
  4.0026261212391586`*^9, 4.0026261212391586`*^9}, {4.0026261528096695`*^9, 
  4.00262617523703*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"cf417c88-0cf7-8240-b583-f08aff446147"],

Cell[CellGroupData[{

