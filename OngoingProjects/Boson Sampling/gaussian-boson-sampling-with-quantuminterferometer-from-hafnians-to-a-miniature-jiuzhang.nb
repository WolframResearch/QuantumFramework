Cell["\<\
Photons still come in pairs, so the total photon number is always even:\
\>", "Text",
 CellChangeTimes->{
  4.002368851476572*^9},ExpressionUUID->"6cefe2db-147a-b54f-b3b3-\
1d6985dae4ac"],

