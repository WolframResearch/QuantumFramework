     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None]], "Output",
 CellChangeTimes->{4.0023855355876923`*^9, 4.002386394290825*^9},
 CellLabel->
  "Out[179]=",ExpressionUUID->"0d68503a-b7e1-1640-8e1f-738a8536368e"]
}, Open  ]],

Cell[TextData[{
 "We need the Takagi decomposition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", " ", "=", " ", 
    RowBox[{"W", " ", 
     RowBox[{"diag", "(", "\[Lambda]", ")"}], 
     RowBox[{"W", "\[Transpose]"}]}]}], TraditionalForm]],ExpressionUUID->
  "5c191d5f-d3d7-e24a-898f-4c188fc68c03"],
 " of the adjacency matrix itself, with W unitary and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "j"], "\[GreaterEqual]", "0"}], 
   TraditionalForm]],ExpressionUUID->"26d7aaae-6b8b-5d48-a206-345c1374a9ef"],
 " . For a real symmetric matrix the eigendecomposition is enough, \
multiplying the eigenvectors of negative eigenvalues by \[ImaginaryI]"
}], "Text",
 CellChangeTimes->{{4.0023864118607464`*^9, 4.002386490153204*^9}, 
   4.0023867442596626`*^9},ExpressionUUID->"85818a3a-dd73-3e44-8a1b-\
3403087c81bb"],

Cell["Extract the adjacency matrix:", "Text",
 CellChangeTimes->{{4.002386613401043*^9, 
  4.0023866208446064`*^9}},ExpressionUUID->"c64abd9c-1af4-7e4a-9f3e-\
d6ad90e35d82"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", " ", "=", " ", 
   RowBox[{"AdjacencyMatrix", "[", "g", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002386600069504*^9, 4.002386631449991*^9}},
 CellLabel->
  "In[189]:=",ExpressionUUID->"3589e929-1ea5-2d40-a9a4-9d3d765e6216"],

Cell["Compute the eigenvalues and eigenvectors:", "Text",
 CellChangeTimes->{{4.0023866345515594`*^9, 
  4.002386651982397*^9}},ExpressionUUID->"a03aca51-d3ba-ef46-8f57-\
c14dd6d04d6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"vals", ",", "vecs"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", 
    RowBox[{"N", "[", "a", "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[187]:=",ExpressionUUID->"263c9815-1d45-e641-af30-80e31bf11c3f"],

Cell["Perform the extra step for negative eigenvalues:", "Text",
 CellChangeTimes->{{4.0023867909658947`*^9, 
  4.0023868036239986`*^9}},ExpressionUUID->"af6acc9a-de2a-ba48-9c3f-\
168c19a77b4d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"wg", "=", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{"Orthogonalize", "[", "vecs", "]"}], "]"}], ".", 
    RowBox[{"DiagonalMatrix", "[", 
     SuperscriptBox["\[ImaginaryI]", 
      RowBox[{"UnitStep", "[", 
       RowBox[{"-", "vals"}], "]"}]], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Lambda]g", "=", 
   RowBox[{"Abs", "[", "vals", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0023855572077065`*^9, 4.002385560891884*^9}, {
  4.00238660458189*^9, 4.0023866252775955`*^9}, {4.0023866572169323`*^9, 
  4.002386659559864*^9}},ExpressionUUID->"4ac20c4d-9ca5-6148-b54b-\
a0ad10562862"],

Cell["Check the decomposition is correct:", "Text",
 CellChangeTimes->{{4.0023868248151493`*^9, 
  4.002386832688772*^9}},ExpressionUUID->"2c58f323-5c3b-864f-bbe2-\
9d77d5ac5eb3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{
   RowBox[{"wg", ".", 
    RowBox[{"DiagonalMatrix", "[", "\[Lambda]g", "]"}], ".", 
    RowBox[{"Transpose", "[", "wg", "]"}]}], "-", "a"}], "]"}]], "Input",
 CellChangeTimes->{{4.0023855742215633`*^9, 4.0023855742215633`*^9}, {
  4.0023868187810936`*^9, 4.002386842124193*^9}},
 CellLabel->
  "In[193]:=",ExpressionUUID->"a4bd35af-f875-f74c-8395-39287a3ddf71"],

