Cell[TextData[{
 "Compute the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "Q"], TraditionalForm]],ExpressionUUID->
  "e6f90bff-5add-b44c-84af-6ba778a2d0cc"],
 ":"
}], "Text",
 CellChangeTimes->{{4.002382955027727*^9, 
  4.002382959813677*^9}},ExpressionUUID->"5e9ddfaf-a3e3-ba49-9d20-\
a195c04767c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Sigma]Q", "=", 
   RowBox[{"husimiCovariance", "[", 
    RowBox[{"secondMoments", "[", 
     RowBox[{"\[Xi]12", ",", 
      RowBox[{"jiuzhangMesh", "[", "\"\<Unitary\>\"", "]"}]}], "]"}], "]"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{4.0023829436125393`*^9, 
  4.0023829519688225`*^9}},ExpressionUUID->"8f4154f4-6139-de4f-8768-\
80a9d179ee3a"],

Cell[TextData[{
 "The vacuum probability is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "/", 
     SqrtBox[
      RowBox[{"Det", "(", 
       SubscriptBox["\[Sigma]", "Q"], ")"}]]}], "=", 
    RowBox[{
     SubscriptBox["\[CapitalPi]", "j"], " ", 
     FractionBox["1", 
      RowBox[{"Cosh", "(", 
       SubscriptBox["r", "j"], ")"}]]}]}], TraditionalForm]],ExpressionUUID->
  "a5e12cc6-a498-e948-ac9a-5a9d1b04605f"],
 ":"
}], "Text",
 CellChangeTimes->{{4.002384023951063*^9, 4.002384049281433*^9}, {
  4.002384452854561*^9, 
  4.0023844908579235`*^9}},ExpressionUUID->"33938e6c-9b6b-1441-8718-\
3cfb52d4abf3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"{", 
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      RowBox[{"Det", "[", "\[Sigma]Q", "]"}]]], ",", "\[IndentingNewLine]", 
    RowBox[{"jiuzhang", "[", 
     RowBox[{"\"\<Probability\>\"", ",", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", "12"}], "]"}], "\[Rule]", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", "12"}], "]"}]}]}], "]"}], ",", 
    RowBox[{"Times", "@@", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"jiuzhang", "[", "\"\<Elements\>\"", "]"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\"\<S\>\"", "[", "val_", "]"}], "->", "_"}], ")"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Cosh", "[", "val", "]"}]}]}]}], "]"}]}]}], "}"}], 
  "]"}]], "Input",
 CellChangeTimes->{{4.0023829716504*^9, 4.002382973790142*^9}, {
  4.0023843921284466`*^9, 4.00238442343734*^9}},
 CellLabel->
  "In[127]:=",ExpressionUUID->"cd7d2039-4047-2042-98b7-33e23af20082"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.36030235657132137`", ",", "0.36030235657132165`", ",", 
   "0.36030235657132137`"}], "}"}]], "Output",
 CellChangeTimes->{
  4.0023829766622314`*^9, {4.0023844197568283`*^9, 4.0023844272635*^9}, 
   4.0023845031213837`*^9},
 CellLabel->
