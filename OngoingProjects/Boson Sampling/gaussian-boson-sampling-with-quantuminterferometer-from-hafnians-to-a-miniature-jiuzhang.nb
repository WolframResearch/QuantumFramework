Cell[TextData[{
 "Recover the symbolic ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", 
     RowBox[{"2", " ", "n"}]], "(", "r", ")"}], TraditionalForm]],
  ExpressionUUID->"434d71e4-400a-fa40-8d50-c0eb4aaa7ccd"],
 " with ",
 "FindSequenceFunction",
 ":"
}], "Text",
 CellChangeTimes->{{4.0017803929866543`*^9, 4.0017804079852448`*^9}, {
