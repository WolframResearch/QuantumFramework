Cell["\<\
The blue bars sit far to the right of the yellow ones. The device doesn\
\[CloseCurlyQuote]t search through the  candidates it just samples, and its \
samples come out much denser than random. GBS samples are good starting \
points for a classical search for the densest subgraph.\
\>", "Text",
 CellChangeTimes->{{4.002391207040039*^9, 
  4.002391229371443*^9}},ExpressionUUID->"3c378e65-8bad-b64d-aa4a-\
3b27e08efabf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["How hard it gets: Complexity", "Section",
 CellChangeTimes->{{4.002030977051153*^9, 
  4.00203098075786*^9}},ExpressionUUID->"8a0b5e5f-ed56-c345-8ec5-\
2c74167ee5be"],

Cell[TextData[{
 "Every probability needs a hafnian, and the best known algorithms for an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[Times]", "n"}], TraditionalForm]],ExpressionUUID->
  "6f5b7dd5-8320-3144-8dd9-1e26fa34bfa2"],
 " hafnian cost ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    RowBox[{
     SuperscriptBox["n", "3"], 
     SuperscriptBox["2", 
      RowBox[{"n", "/", "2"}]]}], ")"}], TraditionalForm]],ExpressionUUID->
  "83908bdb-5c55-6544-b5e6-53c85e00862d"],
 " . Let\[CloseCurlyQuote]s define a 32-mode network with equal squeezing:"
}], "Text",
 CellChangeTimes->{{4.0023916912075233`*^9, 
  4.0023917433285255`*^9}},ExpressionUUID->"69901f66-bb8d-9541-ba2e-\
22b8f5847228"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "3", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"big", "=", 
   RowBox[{"gbsNetwork", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.5", ",", "32"}], "]"}], ",", 
     RowBox[{"QuantumInterferometer", "[", 
      RowBox[{"\"\<Random\>\"", "[", "32", "]"}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.0023912781088295`*^9, 4.0023912825026035`*^9}},
 CellLabel->
  "In[242]:=",ExpressionUUID->"0232fc57-2b1c-684d-8852-2a7203f6291d"],

Cell["\<\
Photon pattern with the given occupations in the first modes:\
\>", "Text",
 CellChangeTimes->{{4.0023917602095337`*^9, 
  4.002391767873625*^9}},ExpressionUUID->"fcae3f90-bd2f-d647-a695-\
a61f1c29abd8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"onFirstModes", "[", 
   RowBox[{"l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Join", "[", 
   RowBox[{"l", ",", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", 
      RowBox[{"m", "-", 
       RowBox[{"Length", "[", "l", "]"}]}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.0023912969080677`*^9, 4.0023912969080677`*^9}, 
   4.002391770969387*^9},
 CellLabel->
  "In[244]:=",ExpressionUUID->"c3a0980a-238e-a94b-8054-999bf7a31766"],

Cell[" And the best of two timings of its amplitude:", "Text",
 CellChangeTimes->{{4.002391772699356*^9, 
  4.002391777391363*^9}},ExpressionUUID->"5a38f533-49c3-794a-897f-\
bac469e84d65"],

Cell[BoxData[
 RowBox[{
  RowBox[{"amplitudeTiming", "[", 
   RowBox[{"qi_", ",", "l_"}], "]"}], ":=", 
  RowBox[{"Min", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"First", "@", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"qi", "[", 
        RowBox[{"\"\<Amplitude\>\"", ",", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"qi", "[", "\"\<Modes\>\"", "]"}]}], "]"}], "->", 
          RowBox[{"onFirstModes", "[", 
           RowBox[{"l", ",", 
            RowBox[{"qi", "[", "\"\<Modes\>\"", "]"}]}], "]"}]}]}], "]"}], 
       "]"}]}], ",", "2"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.0023912969080677`*^9, 4.0023912969080677`*^9}, 
   4.002391770969387*^9},
 CellLabel->
  "In[245]:=",ExpressionUUID->"84f1f07c-6325-854a-b658-dbae1b51504e"],

Cell["\<\
Time for one collision-free amplitude, as a function of the photon number:\
\>", "Text",
 CellChangeTimes->{
  4.0023918002301598`*^9},ExpressionUUID->"b1b36f4f-41e5-b24e-bdf2-\
dbc0d274dbad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"times", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"amplitudeTiming", "[", 
        RowBox[{"big", ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1", ",", "n"}], "]"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "20", ",", "32", ",", "2"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.0023913116742783`*^9, 4.0023913116742783`*^9}, {
  4.00239180435063*^9, 4.002391818195299*^9}, {4.0023918799147625`*^9, 
  4.0023918803342247`*^9}, {4.002391945063093*^9, 4.002391945436964*^9}},
 CellLabel->
  "In[250]:=",ExpressionUUID->"10295ce4-2f1f-0547-afc6-7adbe1a2a009"],

Cell["Show the complexity behavior:", "Text",
 CellChangeTimes->{{4.0023920158342953`*^9, 
  4.0023920193125935`*^9}},ExpressionUUID->"c785d896-de6b-1947-b3db-\
97da590e22c8"],

