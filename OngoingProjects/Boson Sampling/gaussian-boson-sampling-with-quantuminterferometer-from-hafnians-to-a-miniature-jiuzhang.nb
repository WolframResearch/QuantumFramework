Cell[TextData[{
 "Passive optics conserves photon number, so the interferometer cannot change \
the distribution of the total photon number. That distribution is just that \
of the squeezers on their own. For ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "423f9462-e05c-b446-bf29-019e03681235"],
 " equal squeezers it has a closed form. With four symbolic squeezers, the \
probability of ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "fe091ca2-0720-6845-82ce-ee647bb1eb4a"],
 " pairs is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"tanh", "(", "r", ")"}], 
     RowBox[{"2", "k"}]], "/", 
    SuperscriptBox[
     RowBox[{"cosh", "(", "r", ")"}], "4"]}], TraditionalForm]],
  ExpressionUUID->"5e433eca-b67e-6b4d-a194-0bb7fe1c3564"],
 " times ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"k", "+", "1"}], ")"}], TraditionalForm]],ExpressionUUID->
  "b958c085-d924-7247-abce-246caad7d5dd"],
 ":"
}], "Text",
 CellChangeTimes->{{4.002368866292879*^9, 4.002368929496065*^9}, {
  4.0023692678972473`*^9, 
  4.002369273847292*^9}},ExpressionUUID->"b1fc04b2-4c3e-174c-b2bb-\
c2575a4e26b1"],

Cell["Define the squeezers:", "Text",
 CellChangeTimes->{{4.002369301937931*^9, 
  4.002369310039366*^9}},ExpressionUUID->"7bbf65a3-3d72-0a4d-a289-\
82116bfc4e04"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fourSqueezers", "=", 
  RowBox[{"squeezers", "[", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"r", ",", "4"}], "]"}], "]"}]}]], "Input",
 CellLabel->
  "In[161]:=",ExpressionUUID->"6318fa35-64f7-194c-9d4a-55d0b571973a"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["QuantumInterferometer",
    "SummaryHead"], "[", 
   DynamicModuleBox[{Typeset`open$$ = False, Typeset`embedState$$ = "Ready"}, 
    
    TemplateBox[{
      PaneSelectorBox[{False -> GridBox[{{
            PaneBox[
             ButtonBox[
              DynamicBox[
               FEPrivate`FrontEndResource["FEBitmaps", "SummaryBoxOpener"]], 
              ButtonFunction :> (Typeset`open$$ = True), Appearance -> None, 
              BaseStyle -> {}, Evaluator -> Automatic, Method -> 
              "Preemptive"], Alignment -> {Center, Center}, ImageSize -> 
             Dynamic[{
               Automatic, 
                3.5 (CurrentValue["FontCapHeight"]/AbsoluteCurrentValue[
                 Magnification])}]], 
            GraphicsBox[{{
