f4682799eb81"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "5", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"scatterShots", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"#1", "[", "\"\<Name\>\"", "]"}], "&"}], ")"}], "/@", 
    RowBox[{"scatter", "[", 
     RowBox[{"\"\<Samples\>\"", ",", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", "6"}], "]"}], ",", 
      SuperscriptBox["10", "5"]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.002367825240078*^9, 4.0023678332124844`*^9}, 
   4.0023683067689133`*^9},
 CellLabel->
  "In[134]:=",ExpressionUUID->"c23a2b2f-68e3-a446-85ca-84c6f103b7d3"],

