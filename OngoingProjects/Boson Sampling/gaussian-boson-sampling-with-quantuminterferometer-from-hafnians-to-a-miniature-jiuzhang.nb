}, Open  ]],

Cell["\<\
Against the collision-free pattern with the same photon number:\
\>", "Text",
 CellChangeTimes->{{4.0023922352168427`*^9, 
  4.002392238828123*^9}},ExpressionUUID->"16b5e7fd-3c01-a843-b1ff-\
2d7507ad6799"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"big", "[", 
    RowBox[{"\"\<Amplitude\>\"", ",", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", "32"}], "]"}], "->", 
      RowBox[{"onFirstModes", "[", 
       RowBox[{
        RowBox[{"ConstantArray", "[", 
         RowBox[{"1", ",", "32"}], "]"}], ",", "32"}], "]"}]}]}], "]"}], 
   ";"}], "//", "AbsoluteTiming"}]], "Input",
