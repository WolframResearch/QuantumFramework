Cell[TextData[{
 "Its Bloch\[Dash]Messiah form, that is interferometer, squeezers, \
interferometer and it is exact for any input. When it can be more useful is \
when many squeezers are scattered through a network, it becomes at most one \
column of ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "929318da-30f3-3846-a320-8f51ba5cd3e6"],
 " squeezers between two passive meshes"
}], "Text",
 CellChangeTimes->{{4.0021295410342083`*^9, 4.002129563057905*^9}, {
  4.0021296076539536`*^9, 
  4.0021296647790146`*^9}},ExpressionUUID->"65ac2d4b-3bc3-0647-af0a-\
4ef084049541"],

Cell[CellGroupData[{

