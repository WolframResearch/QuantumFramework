Cell[CellGroupData[{

Cell["GBS contains boson sampling", "Subsection",
 CellChangeTimes->{
  4.002133923993038*^9},ExpressionUUID->"cc122c2e-e788-9748-a798-\
c2fc04e5b04f"],

Cell[TextData[{
 "The heralded scheme of Lund et al., later called scattershot boson \
sampling, is a special case of GBS. Two-mode squeezed vacua feed ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "279dcbbe-5fa0-ad41-8cd2-2bed79533f53"],
 " herald modes and ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "056cc9e4-e545-bf4a-a641-974678efdbc9"],
 " signal modes, and only the signal modes go through the interferometer. \
Each pair is the twoModeSqueezer  from above, on signal mode ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "cd76d9a2-4315-e640-9506-672018183dea"],
 " and herald mode ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "+", "m"}], TraditionalForm]],ExpressionUUID->
  "106774e0-5135-0b44-8489-fa4848dbffeb"],
 ", followed by an ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "16504050-5401-7743-95a6-ebd249f7a154"],
 "-mode mesh on the signal modes:"
}], "Text",
 CellChangeTimes->{{4.002366332347601*^9, 
  4.0023663810621967`*^9}},ExpressionUUID->"6db7dca6-0bb0-db45-a40a-\
8acec71594d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"scattershotNetwork", "[", 
   RowBox[{"r_", ",", "mesh_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", "=", 
      RowBox[{"mesh", "[", "\"\<Modes\>\"", "]"}]}], "}"}], ",", 
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Catenate", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"\"\<S\>\"", "[", "r", "]"}], "\[Rule]", "k"}], ",", 
             RowBox[{
              RowBox[{"\"\<S\>\"", "[", 
               RowBox[{"-", "r"}], "]"}], "\[Rule]", 
              RowBox[{"k", "+", "m"}]}], ",", 
             RowBox[{
              RowBox[{"\"\<BS\>\"", "[", 
               RowBox[{
                FractionBox["\[Pi]", "4"], ",", "0"}], "]"}], "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"k", "+", "m"}]}], "}"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "m"}], "}"}]}], "]"}], "]"}], ",", 
        RowBox[{"mesh", "[", "\"\<Elements\>\"", "]"}]}], "]"}], ",", 
      RowBox[{"2", " ", "m"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.002366401218321*^9, 4.002366403210039*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"e74f7418-eda9-4b42-acdf-6b74e0cb3b7c"],

Cell["Network squeezing parameter value:", "Text",
 CellChangeTimes->{{4.002366776335966*^9, 
  4.002366782221775*^9}},ExpressionUUID->"399bcf4d-4d48-6e42-8961-\
ef50f76d3ef2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rsq", " ", "=", " ", "0.4"}], ";"}]], "Input",
 CellChangeTimes->{{4.002366784253891*^9, 4.002366788262102*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"4c371b03-bdbe-4c4f-ba20-d51fc725b1bd"],

Cell["\<\
Three pairs, heralds on modes 4\[Dash]6, and a random three-mode mesh on the \
signal modes 1\[Dash]3:\
\>", "Text",
 CellChangeTimes->{
  4.002366436227314*^9},ExpressionUUID->"cf8ba345-9943-6e41-8be6-\
f219b63aba43"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "11", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mesh3", "=", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"\"\<Random\>\"", "[", "3", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"scatter", "=", 
   RowBox[{"scattershotNetwork", "[", 
    RowBox[{"rsq", ",", "mesh3"}], "]"}]}], ";"}], "\n", 
 RowBox[{"scatter", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellChangeTimes->{{4.002133964900593*^9, 4.002133964900593*^9}, 
   4.002366508919464*^9, {4.002366803062315*^9, 4.0023668044626026`*^9}},
