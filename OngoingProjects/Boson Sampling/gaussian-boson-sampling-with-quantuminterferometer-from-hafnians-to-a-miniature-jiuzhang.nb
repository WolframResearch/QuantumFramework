 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "5", ",", "8", ",", "13", ",", "14"}], "}"}],
     "\[Rule]", "30"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "8", ",", "13", ",", "14"}], "}"}],
     "\[Rule]", "16"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "3", ",", "5", ",", "8", ",", "13", ",", "14"}], "}"}],
     "\[Rule]", "13"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "5", ",", "13", ",", "14", ",", "16"}], 
     "}"}], "\[Rule]", "13"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "5", ",", "8", ",", "13"}], "}"}], 
    "\[Rule]", "12"}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.0023857922436657`*^9, 4.002388319661995*^9},
 CellLabel->
  "Out[228]=",ExpressionUUID->"92dcf096-56eb-5f4a-a073-d1ac284949b8"]
}, Open  ]],

Cell["\<\
The runners-up trade one vertex of the hidden subgraph for a well-connected \
neighbor:\
\>", "Text",
 CellChangeTimes->{{4.002388371934103*^9, 
  4.002388374931078*^9}},ExpressionUUID->"e1608af0-a350-184c-8f25-\
1313c63473f6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"HighlightGraph", "[", 
     RowBox[{"g", ",", 
      RowBox[{"Subgraph", "[", 
       RowBox[{"g", ",", "#"}], "]"}], ",", 
