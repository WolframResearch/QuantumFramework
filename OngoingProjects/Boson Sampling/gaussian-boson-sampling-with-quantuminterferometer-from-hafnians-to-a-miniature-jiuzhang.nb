Cell[CellGroupData[{

Cell[TextData[{
 "The ",
 StyleBox["hafnian",
  IgnoreSpellCheck->True]
}], "Section",
 CellChangeTimes->{{4.0017866240539722`*^9, 
  4.001786629047016*^9}},ExpressionUUID->"fb5d7d2e-0939-2d4d-915a-\
70fb7213ee5d"],

Cell[TextData[{
 "The hafnian of a symmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "n", "\[Times]", "2", "n", " "}], TraditionalForm]],
  ExpressionUUID->"814eb499-dc26-eb4d-99e0-8f7ea32fc919"],
 "matrix is a sum over its perfect matchings, the ways to split the indices \
into n pairs:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Haf", "(", "A", ")"}], " ", "=", " ", 
    RowBox[{
     SubscriptBox["\[Sum]", "M"], " ", 
     RowBox[{
      SubscriptBox["\[CapitalPi]", 
       RowBox[{" ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"i", ",", "j"}], ")"}], " ", "\[Element]", " ", "M"}]}]], "   ", 
      RowBox[{
       SubscriptBox["a", 
        RowBox[{"i", " ", "j"}]], "."}]}]}]}], TraditionalForm]],
  ExpressionUUID->"8049090c-e5a6-fb4f-a3be-cda58454e543"],
 " There are (2n\[Minus]1)!! of them, if we expand along the first row allows \
to build a direct recursive definition:"
}], "Text",
 CellChangeTimes->{{4.0017989300764866`*^9, 4.0017989763013325`*^9}, {
   4.001799873929497*^9, 4.0017998762546024`*^9}, 4.002128352002905*^9, {
   4.0021284589968185`*^9, 4.0021284825896263`*^9}, {4.0026294167227116`*^9, 
   4.0026294682927322`*^9}},ExpressionUUID->"3d7b6a78-7ace-be41-93e3-\
669cf4c02b27"],

Cell["Define the Hafnian:", "Text",
 CellChangeTimes->{{4.002128515130537*^9, 
  4.0021285184844418`*^9}},ExpressionUUID->"18161536-da8a-1741-9bc3-\
ce38971a4d77"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"hafnian", "[", 
    RowBox[{"{", "}"}], "]"}], ":=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hafnian", "[", "a_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "j"}], "]"}], "]"}], 
     RowBox[{"hafnian", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "[", 
         RowBox[{"[", 
          RowBox[{"#", ",", "#"}], "]"}], "]"}], "&"}], "[", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"2", ",", 
           RowBox[{"Length", "[", "a", "]"}]}], "]"}], ",", 
         RowBox[{"{", "j", "}"}]}], "]"}], "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "2", ",", 
      RowBox[{"Length", "[", "a", "]"}]}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.0017866422452526`*^9, 4.001786643615206*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"8be2b0e0-53cd-9c42-a99d-9d532392a5ef"],

Cell["A 4\[Times]4 symmetric matrix has three perfect matchings:", "Text",
 CellChangeTimes->{
  4.002128507231642*^9},ExpressionUUID->"0d9b9084-a1d9-4342-9767-\
118f2931d873"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"hafnian", "[", 
  RowBox[{"Array", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"b", ",", 
       RowBox[{"Min", "[", 
        RowBox[{"#1", ",", "#2"}], "]"}], ",", 
       RowBox[{"Max", "[", 
        RowBox[{"#1", ",", "#2"}], "]"}]}], "]"}], "&"}], ",", 
    RowBox[{"{", 
     RowBox[{"4", ",", "4"}], "}"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{4.001786649125475*^9, 4.0017866496557045`*^9}},
 CellLabel->"In[81]:=",ExpressionUUID->"7f97f469-26c4-4e46-bd12-a62d8f763c48"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["b", 
    RowBox[{"1", ",", "4"}]], " ", 
   SubscriptBox["b", 
    RowBox[{"2", ",", "3"}]]}], "+", 
  RowBox[{
   SubscriptBox["b", 
    RowBox[{"1", ",", "3"}]], " ", 
   SubscriptBox["b", 
    RowBox[{"2", ",", "4"}]]}], "+", 
  RowBox[{
   SubscriptBox["b", 
    RowBox[{"1", ",", "2"}]], " ", 
   SubscriptBox["b", 
    RowBox[{"3", ",", "4"}]]}]}]], "Output",
 CellChangeTimes->{4.0017866500782185`*^9, 4.0021285471384068`*^9, 
  4.0023662858152103`*^9},
 CellLabel->"Out[81]=",ExpressionUUID->"01ee78ed-0919-8849-9ef2-a2f76b5b5a45"]
}, Open  ]],

Cell[TextData[{
 "The hafnian of the all-ones matrix counts the perfect matchings of the \
complete graph on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "n", " "}], TraditionalForm]],ExpressionUUID->
  "c952555c-64e3-ab41-a99c-aa7e77dae5ea"],
 "vertices, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "n"}], "\[Minus]", "1"}], ")"}], "!!"}], TraditionalForm]],
  ExpressionUUID->"b069a72e-b11f-5447-820f-87a45457ca4e"],
 ":"
}], "Text",
 CellChangeTimes->{{4.002128527835573*^9, 
  4.00212853662953*^9}},ExpressionUUID->"91bbef16-b6e1-c741-9038-\
4c147cb6fdc5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindSequenceFunction", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"hafnian", "[", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"1", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "n"}], ",", 
          RowBox[{"2", "n"}]}], "}"}]}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "5"}], "}"}]}], "]"}], ",", "n"}], "]"}]], "Input",
 CellChangeTimes->{{4.0017866555756454`*^9, 4.001786656335842*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"b2c973f8-37f5-5248-9d43-9a7e30509d98"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " ", "n"}], "-", "1"}], ")"}], "!!"}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{
  4.0017866569757957`*^9, {4.0021285510150013`*^9, 4.0021285531558056`*^9}, {
   4.0023662873648453`*^9, 4.0023662889118347`*^9}},
 CellLabel->"Out[82]=",ExpressionUUID->"29cfb9ee-0c2e-6b40-8e3b-ed88b956a07d"]
}, Open  ]],

Cell["For a bipartite block matrix it reduces to the permanent:", "Text",
 CellChangeTimes->{
  4.0017997736586018`*^9},ExpressionUUID->"f3fc274c-20e3-0140-af21-\
459cd0593fe3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", "=", 
     RowBox[{"Array", "[", 
      RowBox[{"x", ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Expand", "[", 
     RowBox[{"hafnian", "[", 
      RowBox[{"ArrayFlatten", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "g"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Transpose", "[", "g", "]"}], ",", "0"}], "}"}]}], "}"}], 
       "]"}], "]"}], "]"}], "\[Equal]", 
    RowBox[{"Expand", "[", 
     RowBox[{"Permanent", "[", "g", "]"}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{4.0017866664761696`*^9, 4.0017866686623325`*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"284b1b8d-d866-8143-808c-f0ceca83cc75"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{4.00178667118701*^9, 4.0021285611987267`*^9, 
  4.002366293385481*^9},
 CellLabel->"Out[83]=",ExpressionUUID->"665a01e9-1edc-ab4a-821b-eddd4c6384f0"]
}, Open  ]],

Cell["\<\
The permanent counts perfect matchings of bipartite graphs and the hafnian \
counts them for any graph. GBS generalizes the permanents of standard boson \
sampling, and the counting interpretation connects it to graph problems, as \
we will see at the end.\
\>", "Text",
 CellChangeTimes->{
  4.0017998507822075`*^9},ExpressionUUID->"034435e3-1fff-dc4f-98f0-\
bd2ed0594bcc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Every pure Gaussian state is a GBS network", "Section",
 CellChangeTimes->{4.0018009145347996`*^9, 
  4.0018010147333717`*^9},ExpressionUUID->"cb34d8a4-a9e2-1d48-a984-\
08c42d336d6e"],

Cell[TextData[{
 "Squeezers and beam splitters in any order produce a Gaussian state, and \
with vacuum input every amplitude is a hafnian of a single symmetric matrix \
",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],ExpressionUUID->
  "f7fe7fcb-46bf-554d-a7d6-b5fd3215b338"]
}], "Text",
 CellChangeTimes->{{4.001800918513157*^9, 4.0018009374809685`*^9}, {
  4.001800978936861*^9, 4.0018009995051746`*^9}, {4.0020229810213394`*^9, 
  4.002022983303915*^9}, {4.0020251796141376`*^9, 
  4.0020251884888935`*^9}},ExpressionUUID->"c21a4d92-9bb4-2f42-9739-\
e7b6ab0e8325"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{"n", "|", "\[Psi]"}], "\[RightAngleBracket]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"0", "|", "\[Psi]"}], "\[RightAngleBracket]"}], "  ", 
    RowBox[{
     RowBox[{"Haf", "(", 
      SubscriptBox["B", "n"], ")"}], "/", 
     SqrtBox[
      RowBox[{
       RowBox[{
        SubscriptBox["n", "1"], "!"}], "\[Ellipsis]", " ", 
       SubscriptBox["n", "m"]}]]}]}]}], 
  TraditionalForm]],ExpressionUUID->"c4a4bb40-b614-7e46-981e-b278d16ba01d"]], \
"Text",
 CellChangeTimes->{{4.002022930841799*^9, 4.0020229976449966`*^9}, 
   4.0020251848635597`*^9},ExpressionUUID->"00d634dd-dddd-4145-9b3c-\
0e4ccecb2fcb"],

Cell["\<\
The Bloch\[Dash]Messiah decomposition says more any such network is an \
interferometer, a column of single-mode squeezers and a second \
interferometer. On vacuum the first interferometer does nothing, which leaves \
squeezers followed by one interferometer, exactly the layout of a GBS \
experiment\
\>", "Text",
 CellChangeTimes->{{4.002025191928953*^9, 4.002025195103014*^9}, {
  4.002128621002884*^9, 4.0021286701682415`*^9}, {4.0021329531635895`*^9, 
