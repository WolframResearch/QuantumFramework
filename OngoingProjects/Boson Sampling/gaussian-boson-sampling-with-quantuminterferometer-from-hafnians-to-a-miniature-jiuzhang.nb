Cell["A network with squeezers in between the beam splitters:", "Text",
 CellChangeTimes->{
  4.0020252077672424`*^9},ExpressionUUID->"261e01fd-33a4-944b-8e89-\
d219dc336637"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"net", "=", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\"\<S\>\"", "[", "0.4", "]"}], "->", "1"}], ",", 
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{"0.7", ",", "0.3"}], "]"}], "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}]}], ",", 
       RowBox[{
        RowBox[{"\"\<S\>\"", "[", 
         RowBox[{"0.3", "I"}], "]"}], "->", "2"}], ",", 
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{"1.1", ",", 
          RowBox[{"-", "0.5"}]}], "]"}], "->", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}]}], ",", 
       RowBox[{
        RowBox[{"\"\<S\>\"", "[", 
         RowBox[{"-", "0.5"}], "]"}], "->", "3"}], ",", 
       RowBox[{
        RowBox[{"\"\<PS\>\"", "[", "0.9", "]"}], "->", "1"}], ",", 
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{"0.4", ",", "1.2"}], "]"}], "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}]}]}], "}"}], ",", "3"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"net", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellChangeTimes->{{4.0020252137254295`*^9, 4.0020252250735493`*^9}, 
   4.0020259589493256`*^9, 4.002128674733738*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"b31a0100-779c-8548-bbd6-d6af2c278d48"],

