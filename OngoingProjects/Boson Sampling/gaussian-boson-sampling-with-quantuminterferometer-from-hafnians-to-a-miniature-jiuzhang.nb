Cell["\<\
Distribution of the photons that reach the detector in mode 1:\
\>", "Text",
 CellChangeTimes->{{4.002626209888014*^9, 4.0026262202950134`*^9}, {
  4.0026264785369205`*^9, 
  4.0026264813479576`*^9}},ExpressionUUID->"d3cc3647-c7e2-c94e-ba9e-\
4a7be2590158"],

Cell[BoxData[
 RowBox[{
  RowBox[{"detectedDistribution", "[", 
   RowBox[{"r_", ",", "\[Eta]_", ",", "c_"}], "]"}], ":=", 
  RowBox[{"KeySort", "[", 
   RowBox[{"Merge", "[", 
    RowBox[{
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#1", "[", "\"\<Name\>\"", "]"}], "\[LeftDoubleBracket]", 
          "1", "\[RightDoubleBracket]"}], "\[Rule]", "#2"}], "&"}], ",", 
       RowBox[{
        RowBox[{"lossySqueezer", "[", 
         RowBox[{"r", ",", "\[Eta]"}], "]"}], "[", 
        RowBox[{"\"\<Probabilities\>\"", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"\"\<Cutoff\>\"", "\[Rule]", "c"}]}], "]"}]}], "]"}], ",", 
     "Total"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{4.0026258928453026`*^9, 4.002625894346081*^9}, 
   4.002626193715584*^9, {4.002626246624361*^9, 4.0026262507760315`*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"d34bd07d-0126-304f-a87f-bb28afa9e284"],

Cell["\<\
Losing one photon of a pair leaves the other one alone, so odd photon numbers \
appear, see the effect of loss on the photon distribution for different \
\[Eta]:\
\>", "Text",
 CellChangeTimes->{
  4.002626533414089*^9, {4.0026276416028233`*^9, 
   4.002627654651308*^9}},ExpressionUUID->"4bdce2e7-0c70-8140-8fb0-\
31b3a15b772a"],

