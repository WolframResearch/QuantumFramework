Cell[TextData[{
 "For vacuum input, the GBS form drops the first interferometer. It takes the \
Takagi decomposition of B, which with our squeezer convention reads ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "=", 
    RowBox[{
     RowBox[{"-", " ", "W"}], " ", 
     RowBox[{"diag", "(", 
      RowBox[{"tanh", "(", 
       SubscriptBox["r", "j"], ")"}], ")"}], 
     RowBox[{"W", "\[Transpose]"}]}]}], TraditionalForm]],ExpressionUUID->
  "3193db86-c319-904c-9044-d987dfb9847c"],
 ":"
}], "Text",
 CellChangeTimes->{{4.002129734967926*^9, 
  4.0021297929642563`*^9}},ExpressionUUID->"c62abc22-d9cb-b244-b809-\
5ec0f2fcca74"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"gbsForm", "=", 
