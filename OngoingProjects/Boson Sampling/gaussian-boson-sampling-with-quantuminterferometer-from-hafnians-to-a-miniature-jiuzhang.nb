Cell[TextData[{
 "The covariance has two contributions. The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox["N", 
     RowBox[{"i", " ", "j"}]], 
    SuperscriptBox["|", "2"]}], TraditionalForm]],ExpressionUUID->
  "a89d3618-ad7a-a944-9a09-7262a30a1157"],
 " term is the bunching that thermal light, a classical mixture of coherent \
states, would also show. The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox["M", 
     RowBox[{"i", " ", "j"}]], 
    SuperscriptBox["|", "2"]}], TraditionalForm]],ExpressionUUID->
  "7d83abb9-9699-a94b-a033-0c0665d7b567"],
 " term comes from the photon pairs. A thermal mock-up with the same ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "23efe152-0004-bb40-977b-a064cfcedd9a"],
 " has ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "d67ea547-a74d-f840-b463-f408cb6a2700"],
 ", so it predicts ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox["N", 
     RowBox[{"i", " ", "j"}]], 
    SuperscriptBox["|", "2"]}], TraditionalForm]],ExpressionUUID->
  "b8473e27-49ba-d64d-9914-538d38dfb260"],
 "  alone. The covariance measured from all shots, for each pair of modes, \
against both predictions:"
}], "Text",
 CellChangeTimes->{{4.0023805991696014`*^9, 
  4.0023806752664967`*^9}},ExpressionUUID->"cfa9e0b2-cd34-9a4d-8993-\
6db87495479e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"modePairs", "=", 
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{"Range", "[", "4", "]"}], ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"BarChart", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Extract", "[", 
         RowBox[{
          RowBox[{"Covariance", "[", "shots", "]"}], ",", "modePairs"}], 
         "]"}], ",", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"Abs", "[", 
           RowBox[{"Extract", "[", 
            RowBox[{"nMat", ",", "modePairs"}], "]"}], "]"}], "2"], "+", 
         SuperscriptBox[
          RowBox[{"Abs", "[", 
           RowBox[{"Extract", "[", 
            RowBox[{"mMat", ",", "modePairs"}], "]"}], "]"}], "2"]}], ",", 
        SuperscriptBox[
         RowBox[{"Abs", "[", 
          RowBox[{"Extract", "[", 
           RowBox[{"nMat", ",", "modePairs"}], "]"}], "]"}], "2"]}], "}"}], 
      "]"}], ",", 
     InterpretationBox[
      DynamicModuleBox[{Typeset`open = False}, 
       TemplateBox[{"Expression", "SequenceIcon", 
         GridBox[{{
            RowBox[{
              TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["Sequence", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["4", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Byte count: \"", "IconizedLabel"], 
              "\[InvisibleSpace]", 
              TagBox["928", "IconizedItem"]}]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
          "Column", 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
         Dynamic[Typeset`open]},
        "IconizedObject"]],
      Sequence[ChartLabels -> {
         Map[Row[#, ","]& , $CellContext`modePairs], None}, 
       ChartLegends -> {"measured", "squeezed light", "thermal light"}, 
       AxesLabel -> {"modes", "cov"}, LabelStyle -> 13],
      SelectWithContents->True,
      Selectable->False]}], "]"}]}], "]"}]], "Input",
