Cell[CellGroupData[{

Cell["Threshold detectors: Torontonians", "Section",
 CellChangeTimes->{{4.0020309394362144`*^9, 
  4.0020309476804543`*^9}},ExpressionUUID->"1d58e00b-d7b4-0b45-a14f-\
2c2628123100"],

Cell["\<\
Jiuzhang, with 50 squeezed inputs in 100 modes, used threshold detectors \
which only click or stay silent and recorded up to 76 clicks. The probability \
of a click pattern is a sum over all photon patterns with nonzero counts in \
the same modes. For a Gaussian state it has a closed form, the Torontonian:\
\>", "Text",
 CellChangeTimes->{
  4.0023809148227673`*^9, {4.002381619040497*^9, 
   4.002381641594324*^9}},ExpressionUUID->"4794c3b9-d273-1344-a407-\
33bdfff08d4d"],

