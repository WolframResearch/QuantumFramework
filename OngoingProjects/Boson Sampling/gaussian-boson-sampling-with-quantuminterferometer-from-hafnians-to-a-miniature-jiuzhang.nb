Cell["\<\
The clicks follow the Torontonian. The photon numbers are always even and run \
up to 22, while the clicks stop at 9. In twelve modes, many shots put two or \
more photons into the same mode, and those reach the threshold detectors as \
one click. When the photons spread over many more modes than there are \
photons, a click almost always means a single photon\
\>", "Text",
 CellChangeTimes->{{4.0023848916270485`*^9, 
  4.002384916710474*^9}},ExpressionUUID->"de7dbb3a-52cb-5043-a108-\
811f37919895"],

Cell["\<\
Four squeezers into m modes, and the fraction of four-click events that carry \
exactly four photons, from the Hafnians of the collision-free patterns and \
the Torontonians of the same click patterns:\
\>", "Text",
 CellChangeTimes->{
  4.002384948200941*^9, {4.002385101643997*^9, 
   4.002385107411352*^9}},ExpressionUUID->"57ba2094-c904-ba40-b910-\
0e155e00352a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"singlePhotonFraction", "[", "m_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"mesh", "=", 
       RowBox[{"QuantumInterferometer", "[", 
        RowBox[{"\"\<Random\>\"", "[", "m", "]"}], "]"}]}], ",", 
      RowBox[{"\[Xi]", "=", 
       RowBox[{"PadRight", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.5", ",", "4"}], "]"}], ",", "m"}], "]"}]}], ",", "net", ",",
       "\[Sigma]", ",", 
      RowBox[{"fourClicks", "=", 
       RowBox[{"Subsets", "[", 
        RowBox[{
         RowBox[{"Range", "[", "m", "]"}], ",", 
         RowBox[{"{", "4", "}"}]}], "]"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"net", "=", 
      RowBox[{"gbsNetwork", "[", 
       RowBox[{"\[Xi]", ",", "mesh"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Sigma]", "=", 
      RowBox[{"husimiCovariance", "[", 
       RowBox[{"secondMoments", "[", 
        RowBox[{"\[Xi]", ",", 
         RowBox[{"N", "[", 
          RowBox[{"mesh", "[", "\"\<Unitary\>\"", "]"}], "]"}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"net", "[", 
          RowBox[{"\"\<Probability\>\"", ",", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0", ",", "m"}], "]"}], "->", 
            RowBox[{"Normal", "[", 
             RowBox[{"SparseArray", "[", 
              RowBox[{
               RowBox[{"Thread", "[", 
                RowBox[{"#", "->", "1"}], "]"}], ",", "m"}], "]"}], "]"}]}]}],
           "]"}], "&"}], "/@", "fourClicks"}], "]"}], "/", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"clickProbability", "[", 
          RowBox[{"\[Sigma]", ",", "#"}], "]"}], "&"}], "/@", "fourClicks"}], 
       "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.002384968999796*^9, 4.002384993133108*^9}},
 CellLabel->
  "In[136]:=",ExpressionUUID->"a27fc509-cae7-4541-b4c0-330fd4259c1e"],

Cell[TextData[{
 "Calculate it  up to ",
 Cell[BoxData[
  FormBox["24", TraditionalForm]],ExpressionUUID->
  "a08893d7-83be-5345-99f2-8604aceefc81"],
 " modes in steps of 2:"
}], "Text",
 CellChangeTimes->{{4.0023852410482426`*^9, 
  4.002385257242296*^9}},ExpressionUUID->"9ae263eb-2211-a64d-a8cd-\
27f0c29c4fe6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "3", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fractions", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", 
       RowBox[{"singlePhotonFraction", "[", "m", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "4", ",", "24", ",", "2"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.002385006964575*^9, 4.002385006964575*^9}, {
  4.0023851183206577`*^9, 
  4.002385141771515*^9}},ExpressionUUID->"d9a17073-bad6-b24d-a3d4-\
d52b9b35a319"],

