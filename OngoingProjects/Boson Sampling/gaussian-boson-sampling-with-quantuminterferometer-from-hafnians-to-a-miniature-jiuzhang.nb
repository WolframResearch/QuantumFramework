Cell["\<\
In four modes half of the four-click events carry more than four photons. In \
24 modes nine in ten are clean,threshold detection approaches photon-number \
resolution as the modes outnumber the photons\
\>", "Text",
 CellChangeTimes->{{4.0023853122073*^9, 
  4.002385325611683*^9}},ExpressionUUID->"7d9e1b66-71dd-9341-a95b-\
2aeb06b34be0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Graph problems: dense subgraphs and perfect matchings", "Section",
 CellChangeTimes->{
  4.0017867389413776`*^9},ExpressionUUID->"36f36e74-a52e-2d45-ba57-\
0c73d62675cf"],

Cell[TextData[{
 "For a symmetric matrix with entries 0 and 1, the adjacency matrix A of a \
graph, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Haf", "(", 
    SubscriptBox["A", "s"], ")"}], TraditionalForm]],ExpressionUUID->
  "4947b612-d565-884c-a8e1-db360b8b0e54"],
 " counts the perfect matchings of the subgraph with vertices ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]],ExpressionUUID->
  "34be9ca1-cef9-e349-a408-d3eeccfdac60"],
 ". If we can make B proportional to A, the GBS probability of the \
collision-free pattern on ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]],ExpressionUUID->
  "ae1dd18d-7a9f-964f-92c8-e71eae1a767f"],
 " is"
}], "Text",
 CellChangeTimes->{{4.0023853730254498`*^9, 
  4.0023854071116867`*^9}},ExpressionUUID->"bc972bfd-6440-bf43-9e26-\
d0a907e2ba97"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"P", 
    RowBox[{"(", "S", ")"}]}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{" ", 
      RowBox[{
       SuperscriptBox["c", 
        RowBox[{"|", "S", "|"}]], 
       SuperscriptBox[
        RowBox[{"Haf", "(", 
         SubscriptBox["A", "S"], ")"}], "2"]}]}], 
     RowBox[{
      SubscriptBox["\[CapitalPi]", "j"], " ", 
      RowBox[{"cosh", "(", 
       SubscriptBox["r", "j"], ")"}]}]], "        ", "where", " ", "c", "  ", 
    "depends", " ", "on", " ", "squeezers"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0023854260249367`*^9, 4.002385481266241*^9}, {
  4.002387024960558*^9, 4.002387071275406*^9}, {4.0023871231303177`*^9, 
  4.0023871400644913`*^9}},ExpressionUUID->"12f332fb-36b2-0146-a997-\
15b1dd4d2793"],

Cell["\<\
so the device samples subgraphs with many perfect matchings, which tend to be \
dense ones\
\>", "Text",
 CellChangeTimes->{
  4.0023863297321053`*^9},ExpressionUUID->"eaa3e16a-17e4-194c-a018-\
8edc9463479a"],

Cell["\<\
A sparse random graph on 16 vertices with a complete subgraph \
\[OpenCurlyDoubleQuote]hidden\[CloseCurlyDoubleQuote] on six of them:\
\>", "Text",
 CellChangeTimes->{{4.0023863441079426`*^9, 4.0023863482587852`*^9}, 
   4.0023863827059326`*^9},ExpressionUUID->"dc5094f4-ef79-274e-8bcf-\
3df5f0855792"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hidden", "=", 
   RowBox[{"Sort", "@", 
    RowBox[{"RandomSample", "[", 
     RowBox[{
      RowBox[{"Range", "[", "16", "]"}], ",", "6"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"Graph", "[", 
    RowBox[{
     RowBox[{"Range", "[", "16", "]"}], ",", 
     RowBox[{"Union", "[", 
      RowBox[{
       RowBox[{"EdgeList", "[", 
        RowBox[{"RandomGraph", "[", 
         RowBox[{"{", 
          RowBox[{"16", ",", "20"}], "}"}], "]"}], "]"}], ",", 
       RowBox[{"UndirectedEdge", "@@@", 
        RowBox[{"Subsets", "[", 
         RowBox[{"hidden", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"VertexLabels", "->", "Automatic"}]}], "]"}]}], ";"}]}], "Input",\

 CellChangeTimes->{{4.0023855319856186`*^9, 4.0023855319856186`*^9}, 
   4.002386368738283*^9},
 CellLabel->
  "In[176]:=",ExpressionUUID->"6a149482-6a32-ff46-aa13-34c1abdb64c8"],

Cell["Show the subgraph:", "Text",
 CellChangeTimes->{{4.002386371403267*^9, 
  4.002386377108185*^9}},ExpressionUUID->"42872149-237f-0342-a6a5-\
4a7d52ac85cf"],

