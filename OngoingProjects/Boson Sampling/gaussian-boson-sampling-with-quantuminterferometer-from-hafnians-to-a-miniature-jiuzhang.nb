Cell[CellGroupData[{

Cell["Squeezed vacuum: photon come in pairs", "Section",
 CellChangeTimes->{{4.001780191617464*^9, 4.001780196758442*^9}, {
  4.001780372517578*^9, 4.0017803754103756`*^9}, {4.0017810342849636`*^9, 
  4.0017810375253334`*^9}},ExpressionUUID->"075c778c-8542-b44d-9518-\
259a9597a880"],

Cell[CellGroupData[{

Cell["Single mode squeezing", "Subsection",
 CellChangeTimes->{{4.001781044788967*^9, 
  4.0017810640840626`*^9}},ExpressionUUID->"a43bffbd-bc36-634d-baf1-\
2d8d92d842b1"],

Cell[TextData[{
 "The single-mode squeezer is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"S", "(", "\[Xi]", ")"}], "=", " ", 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Xi]", "\[Conjugate]"}], " ", 
         SuperscriptBox["a", "2"]}], "-", " ", 
        RowBox[{"\[Xi]", " ", 
         SuperscriptBox[
          SuperscriptBox["a", "\[Dagger]"], "2"]}]}], ")"}], "/", "2"}], 
     ")"}]}], TraditionalForm]],ExpressionUUID->
  "7b20fbee-52a1-254e-ad5b-de21a889d326"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Xi]", " ", "=", " ", 
    RowBox[{"r", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}]}], TraditionalForm]],
  ExpressionUUID->"d8006560-8bd1-9e4e-b074-f45eadced6b8"],
 " . Its generator ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SuperscriptBox["a", "\[Dagger]"], "2"], TraditionalForm]],ExpressionUUID->
  "a3752c26-be2c-114e-9a7c-8aa16aba8821"],
 " creates photons two at a time, so squeezed vacuum only has even photon \
numbers. Such that the following properties hold"
}], "Text",
 CellChangeTimes->{{4.0021261017480164`*^9, 
  4.0021262348739624`*^9}},ExpressionUUID->"4e12ada6-0296-5e48-96c7-\
ef52b0531c1a"],

