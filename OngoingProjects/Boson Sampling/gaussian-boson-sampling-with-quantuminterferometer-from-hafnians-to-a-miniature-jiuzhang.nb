Cell[CellGroupData[{

Cell["Two mode squeezing", "Subsection",
 CellChangeTimes->{{4.0017810779362793`*^9, 
  4.001781080626095*^9}},ExpressionUUID->"ca5d1b80-6fb3-c446-b008-\
ee310ec4a74f"],

Cell[TextData[{
 "Two parametric squeezers with opposite signs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Xi]", "1"], "=", "r"}], ",", " ", 
    RowBox[{
     SubscriptBox["\[Xi]", "2"], "=", 
     RowBox[{"r", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Pi]"}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"b837dba7-5c1c-dc4e-8135-a9c6e4806225"],
 " , combined on a 50:50 beam splitter generate a two mode squeezed vacuum"
}], "Text",
 CellChangeTimes->{
  4.0017811000817566`*^9, {4.002126906758047*^9, 4.0021269584005833`*^9}, {
   4.002127517819582*^9, 
   4.002127546240362*^9}},ExpressionUUID->"9e845a7f-2e1a-2948-bd22-\
51808f05f99b"],

Cell["Define the parametric interferometer:", "Text",
 CellChangeTimes->{{4.002126971580349*^9, 
  4.002126989840893*^9}},ExpressionUUID->"dd6a0073-95a4-374a-a588-\
d38049d66588"],

Cell[BoxData[
 RowBox[{
  RowBox[{"twoModeSqueezer", "=", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\"\<S\>\"", "[", "r", "]"}], "->", "1"}], ",", 
       RowBox[{
        RowBox[{"\"\<S\>\"", "[", 
         RowBox[{"-", "r"}], "]"}], "->", "2"}], ",", 
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "4"}], ",", "0"}], "]"}], "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}]}]}], "}"}], ",", "2", ",", 
     RowBox[{"\"\<Parameters\>\"", "->", 
      RowBox[{"{", "r", "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.001773144542412*^9, 4.001773144542412*^9}, 
   4.0017734492845535`*^9, {4.001781106866787*^9, 4.001781120827345*^9}, {
   4.001781250921177*^9, 4.001781260241722*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"fb60c540-56f9-a74d-a598-743681bce115"],

Cell["Visualize the network:", "Text",
 CellChangeTimes->{{4.002126997287281*^9, 4.00212700209676*^9}, {
  4.002127253818428*^9, 
  4.002127256087639*^9}},ExpressionUUID->"0778155e-e529-934d-a636-\
7ec23e27eb1f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"twoModeSqueezer", "[", 
  RowBox[{"\"\<Diagram\>\"", ",", 
   RowBox[{"ImageSize", "->", "150"}], ",", 
   RowBox[{"ImagePadding", "->", 
    RowBox[{"-", "20"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{4.001781811618826*^9, 4.001781813946724*^9}, {
  4.0021270084461956`*^9, 4.00212703448032*^9}, {4.0021272116227055`*^9, 
  4.0021272484195576`*^9}},
