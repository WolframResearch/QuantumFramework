Cell[TextData[{
 "Detecting the herald pattern ",
 Cell[BoxData[
  FormBox["h", TraditionalForm]],ExpressionUUID->
  "0fcab668-b1a5-0647-a0a6-38ae2f2b70b3"],
 " tells us that exactly the same pattern",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", "h"}], TraditionalForm]],ExpressionUUID->
  "9ee9b778-6b81-2949-84bd-cc6406dd4b8e"],
 " of photons entered the interferometer, so the joint amplitude is a \
permanent, with ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "e1f02d67-0774-e049-9d00-b1038466b35d"],
 " the number of heralded photons:"
}], "Text",
 CellChangeTimes->{{4.0023665564226856`*^9, 
  4.002366580241724*^9}},ExpressionUUID->"66d7dc82-4d6e-7f48-97f8-\
a27feb96c3b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"scattershotAmplitude", "[", 
   RowBox[{"w_", ",", "r_", ",", "t_", ",", "h_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", 
       RowBox[{"Tanh", "[", "r", "]"}]}], ")"}], 
     RowBox[{"Total", "[", "h", "]"}]], " ", 
    RowBox[{"Permanent", "[", 
     RowBox[{"w", "\[LeftDoubleBracket]", 
      RowBox[{
       RowBox[{"photonIndices", "[", "t", "]"}], ",", 
       RowBox[{"photonIndices", "[", "h", "]"}]}], "\[RightDoubleBracket]"}], 
     "]"}]}], 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Cosh", "[", "r", "]"}], 
     RowBox[{"Length", "[", "h", "]"}]], " ", 
    SqrtBox[
     RowBox[{
      RowBox[{"Times", "@@", 
       RowBox[{"(", 
        RowBox[{"t", "!"}], ")"}]}], " ", 
      RowBox[{"Times", "@@", 
       RowBox[{"(", 
        RowBox[{"h", "!"}], ")"}]}]}]]}]]}]], "Input",
 CellChangeTimes->{{4.002134029583376*^9, 4.002134031610777*^9}, {
  4.0023665925309124`*^9, 4.0023665940076256`*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"6563f0ac-234d-1442-b179-852e3036a58e"],

Cell["\<\
Check against the permanent for several herald patterns, including one with \
two photons from the same source:\
\>", "Text",
 CellChangeTimes->{
  4.0023666043604393`*^9},ExpressionUUID->"8da9c457-059f-b446-be6c-\
a278d423c09d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"scatter", "[", 
      RowBox[{"\"\<Amplitude\>\"", ",", 
       RowBox[{
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", "6"}], "]"}], "\[Rule]", 
        RowBox[{"Join", "[", 
         RowBox[{"t", ",", "h"}], "]"}]}]}], "]"}], "-", 
     RowBox[{"scattershotAmplitude", "[", 
      RowBox[{
       RowBox[{"mesh3", "[", "\"\<Unitary\>\"", "]"}], ",", "rsq", ",", "t", ",",
        "h"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"h", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0", ",", "1"}], "}"}]}], "}"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", 
      RowBox[{"FrobeniusSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
        RowBox[{"Total", "[", "h", "]"}]}], "]"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{4.002367126734127*^9, 4.002367127938854*^9}, {
  4.002367166285967*^9, 4.002367186486864*^9}},
 CellLabel->
  "In[112]:=",ExpressionUUID->"0d5e9837-95bc-a24a-9563-cba616e2d9d7"],

