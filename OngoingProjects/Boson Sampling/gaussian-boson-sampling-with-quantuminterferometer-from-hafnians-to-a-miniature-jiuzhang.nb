Cell["Compute the symbolic formula:", "Text",
 CellChangeTimes->{{4.002369601428999*^9, 
  4.002369619235012*^9}},ExpressionUUID->"02c1c2c3-2519-8c48-a6c0-\
69d25a20c8f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"FindSequenceFunction", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"fourSqueezers", "[", 
              RowBox[{"\"\<Probability\>\"", ",", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], "\[Rule]",
                 "#1"}]}], "]"}], "&"}], ")"}], "/@", 
           RowBox[{"FrobeniusSolve", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
             RowBox[{"2", " ", "k"}]}], "]"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "5"}], "}"}]}], "]"}], ",", "k"}], "]"}], 
   ",", 
   RowBox[{"r", ">", "0"}]}], "]"}]], "Input",
 CellChangeTimes->{{4.002369321974226*^9, 4.0023693382691326`*^9}, {
  4.002369543168085*^9, 4.0023695746050034`*^9}},
 CellLabel->
  "In[168]:=",ExpressionUUID->"5ecc3e9e-0499-5240-bf9e-cff3df8a6223"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{"k", "+", "1"}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["sech", "4"], "(", "r", ")"}], " ", 
   RowBox[{
    SuperscriptBox["tanh", 
     RowBox[{"2", " ", "k"}]], "(", "r", ")"}]}], TraditionalForm]], "Output",\

 CellChangeTimes->{{4.0023693307501183`*^9, 4.002369342588749*^9}, {
   4.0023695707670918`*^9, 4.0023695798162594`*^9}, 4.002629780717354*^9},
 CellLabel->
  "Out[168]=",ExpressionUUID->"94440cbc-ca9a-5a41-a505-c1aec871a6dd"]
}, Open  ]],

Cell["\<\
The total count can be classically easy to predict. Everything that makes GBS \
hard is in how the photons are distributed among the modes, which is what the \
hafnians resolve\
\>", "Text",
