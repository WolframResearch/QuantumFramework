Cell[TextData[{
 "The two outputs carry perfectly correlated photon numbers. Counting ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "211b98ee-a625-aa45-8ecf-a0aabacdae3d"],
 " photons in one arm tells us, without touching it, that the other arm holds \
exactly ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "58616b32-e6c4-1c47-8244-3d6f89f7d750"],
 " photons. This is the state of spontaneous parametric down-conversion, and \
it is how heralded single-photon sources work"
}], "Text",
 CellChangeTimes->{{4.00212828131468*^9, 
  4.002128307473568*^9}},ExpressionUUID->"8eead31e-3de8-f34b-ace0-\
f01f1dcf7e66"],

Cell[TextData[{
 "Compute the distribution ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", 
     RowBox[{"n", ",", "n"}]], "(", "r", ")"}], TraditionalForm]],
  ExpressionUUID->"1ed83ccc-0598-0647-8eea-93069e312c7e"],
 ":"
}], "Text",
 CellChangeTimes->{{4.002127425365782*^9, 
  4.0021274556214123`*^9}},ExpressionUUID->"ee6525c1-f076-bc43-b2ec-\
3e7ca27145be"],

