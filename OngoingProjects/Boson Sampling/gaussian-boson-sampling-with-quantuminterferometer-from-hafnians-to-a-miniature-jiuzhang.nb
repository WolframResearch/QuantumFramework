Cell[TextData[{
 "Photon-number distribution of the squeezed vacuum, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"r", " ", "=", " ", "0.8"}], ","}], TraditionalForm]],
  ExpressionUUID->"cd229613-c681-0c41-af99-385b67ff4a26"],
 " up to 10 photons:"
}], "Text",
 CellChangeTimes->{{4.001780315297163*^9, 
  4.0017803212968006`*^9}},ExpressionUUID->"e8dbc816-2c96-7144-b18e-\
f4c117804f89"],

