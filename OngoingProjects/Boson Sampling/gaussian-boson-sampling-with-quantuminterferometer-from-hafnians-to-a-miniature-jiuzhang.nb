Cell["\<\
Edge densities of the sampled subgraphs, against all 8008 six-vertex \
subgraphs drawn uniformly.  The densities you\[CloseCurlyQuote]d get by \
picking 6 vertices at random. In this sparse graph most have 3\[Dash]5 edges:\
\
\>", "Text",
 CellChangeTimes->{{4.0023884422800617`*^9, 4.0023884502188168`*^9}, {
  4.0023910933763924`*^9, 
  4.0023911551228256`*^9}},ExpressionUUID->"344ce126-12f1-6940-ae7c-\
cd5b424bf8f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Histogram", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
