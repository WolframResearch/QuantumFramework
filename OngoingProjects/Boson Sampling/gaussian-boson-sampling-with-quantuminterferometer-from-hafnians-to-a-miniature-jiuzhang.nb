Cell[TextData[{
 "Distribution of the signal pattern among the shots with herald pattern ",
 Cell[BoxData[
  FormBox["h", TraditionalForm]],ExpressionUUID->
  "9fa20fe1-80ff-ad4a-b7c2-7828e059a631"],
 ":"
}], "Text",
 CellChangeTimes->{{4.0023684375311985`*^9, 
  4.0023684424158363`*^9}},ExpressionUUID->"e30a1a7d-4a68-e642-8aea-\
38e7bc61a447"],

Cell[BoxData[
 RowBox[{
  RowBox[{"heraldedDistribution", "[", 
   RowBox[{"shots_", ",", "h_"}], "]"}], ":=", 
  RowBox[{"Normalize", "[", 
   RowBox[{
    RowBox[{"Counts", "[", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"shots", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"4", ";;"}], "]"}], "]"}], "==", "h"}], "&"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{";;", "3"}]}], "]"}], "]"}], "]"}], ",", "Total"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{4.0023679668527737`*^9, 4.0023679668527737`*^9}},
 CellLabel->
  "In[138]:=",ExpressionUUID->"bba044d4-e0fe-3d42-8ff3-511265b8cf2a"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"884b4430-cd61-9141-89f0-b800e24d8752"],
 ", about 1300 of the shots, it is the boson sampling distribution of the \
mesh with one photon in modes 1 and 2 up to statistical error of the number \
of shots:"
}], "Text",
 CellChangeTimes->{{4.0023685006305656`*^9, 4.00236851272715*^9}, {
  4.0023686282256184`*^9, 
  4.0023686374497623`*^9}},ExpressionUUID->"a8e15ce2-1555-1d4a-aed7-\
ba15adfd5e66"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Abs", "/@", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"KeySort", "[", 
     RowBox[{"heraldedDistribution", "[", 
      RowBox[{"scatterShots", ",", 
       RowBox[{"{", 
