Cell[TextData[{
 "The collision-free pattern ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], " "}], 
   TraditionalForm]],ExpressionUUID->"9299d3cb-b950-5345-bfde-5f29ab102df1"],
 " carries a small part of the four-photon probability:"
}], "Text",
 CellChangeTimes->{{4.0023699832063255`*^9, 
  4.002369993012995*^9}},ExpressionUUID->"edd7b034-513f-e14c-91b2-\
bdac7e76c708"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"probs", "[", 
    InterpretationBox[
     StyleBox[
      TemplateBox[{
        RowBox[{
         "1", "\[InvisibleSpace]", "1", "\[InvisibleSpace]", "1", 
          "\[InvisibleSpace]", "1"}]},
       "Ket"],
      FontWeight->"Plain"],
     Wolfram`QuantumFramework`QuditName[{1, 1, 1, 1}]], "]"}], ",", 
   RowBox[{"Total", "[", "four", "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{4.002370000296627*^9, 4.002370001644079*^9}},
 CellLabel->
  "In[180]:=",ExpressionUUID->"4249f927-4e31-674f-a732-e2a1bd15d242"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.0020221793357696935`", ",", "0.0833901097732085`"}], 
  "}"}]], "Output",
 CellChangeTimes->{4.0023700038721485`*^9},
 CellLabel->
  "Out[180]=",ExpressionUUID->"d610ae23-8c09-2d48-91e3-eb34c1298b25"]
}, Open  ]],

Cell[TextData[{
 "With four modes there is nowhere for four photons to go without meeting. \
The hardness arguments assume the opposite regime, many more modes than \
photons . Fraction of collision-free events among the four-photon events, for \
a random ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "f4c08208-e12e-2549-b0b1-100a7cee2ed8"],
 "-mode network with equal squeezing and a mean photon number of 2:"
}], "Text",
 CellChangeTimes->{
  4.002370464599676*^9, {4.0023704979512177`*^9, 4.0023705044560585`*^9}, {
   4.002388780731367*^9, 
   4.002388787515955*^9}},ExpressionUUID->"504b3407-328c-044e-bce2-\
916874d21202"],

Cell[BoxData[
 RowBox[{
  RowBox[{"collisionFreeFraction", "[", 
   RowBox[{"m_", ",", "seed_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"four", "=", 
      RowBox[{"fourPhotonProbabilities", "[", 
       RowBox[{"gbsNetwork", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"ArcSinh", "[", 
            SqrtBox[
             RowBox[{"2.", "/", "m"}]], "]"}], ",", "m"}], "]"}], ",", 
         RowBox[{"BlockRandom", "[", 
          RowBox[{
           RowBox[{"QuantumInterferometer", "[", 
            RowBox[{"\"\<Random\>\"", "[", "m", "]"}], "]"}], ",", 
           RowBox[{"RandomSeeding", "->", "seed"}]}], "]"}]}], "]"}], "]"}]}],
      "}"}], ",", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"KeySelect", "[", 
       RowBox[{"four", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"#", "[", "\"\<Name\>\"", "]"}], "]"}], "==", "1"}], 
         "&"}]}], "]"}], "]"}], "/", 
     RowBox[{"Total", "[", "four", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.00237051987846*^9, 4.0023705658922024`*^9}},
 CellLabel->
  "In[182]:=",ExpressionUUID->"384eeadb-654e-4f43-8824-c533255554b0"],

Cell["\<\
Average over three random meshes for different number of modes:\
\>", "Text",
 CellChangeTimes->{{4.0023711022003937`*^9, 
  4.002371107867834*^9}},ExpressionUUID->"f0f891ca-c29b-3e45-b598-\
1a33d6907be1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"collisionFree", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", 
       RowBox[{"Mean", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"collisionFreeFraction", "[", 
           RowBox[{"m", ",", "s"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "3"}], "}"}]}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "6", ",", "8", ",", "12", ",", "16", ",", "24"}], 
        "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.0023705779949265`*^9, 4.002370582018381*^9}, 
   4.0023706138705387`*^9},
 CellLabel->
  "In[184]:=",ExpressionUUID->"d203866e-fdbe-6e45-9642-05d6e67a0144"],

Cell[TextData[{
 "For comparison, the bosonic birthday paradox,  if all four-photon patterns \
were equally likely, the collision-free fraction would be ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     TemplateBox[{"m", "4"},
      "Binomial"], " ", 
     TemplateBox[{
       RowBox[{"m", "+", "3"}], "4"},
      "Binomial"]}],
    HoldForm], TraditionalForm]],
  CellChangeTimes->{{4.0023706381349545`*^9, 4.0023706638318653`*^9}},
  ExpressionUUID->"0d77497c-c134-7a48-9b2a-75518c882b4c"],
 ":"
}], "Text",
 CellChangeTimes->{{4.002370610797653*^9, 4.0023706218030033`*^9}, {
  4.002370669131439*^9, 4.0023706705128155`*^9}, {4.00237183651857*^9, 
  4.0023718368869953`*^9}},ExpressionUUID->"2ec9bed1-e2f5-0844-8062-\
6bca79de981f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{"collisionFree", ",", 
     InterpretationBox[
      DynamicModuleBox[{Typeset`open = False}, 
       TemplateBox[{"Expression", "SequenceIcon", 
         GridBox[{{
            RowBox[{
              TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
