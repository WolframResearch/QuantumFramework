 RowBox[{
  RowBox[{"squeezer", "[", "0.8", "]"}], "[", 
  RowBox[{"\"\<Probabilities\>\"", ",", 
   RowBox[{"{", "0", "}"}], ",", 
   RowBox[{"\"\<Cutoff\>\"", "->", "10"}]}], "]"}]], "Input",
