Cell[CellGroupData[{

Cell["Gaussian boson sampling network properties", "Section",
 CellChangeTimes->{{4.0020308722369556`*^9, 
  4.002030904356697*^9}},ExpressionUUID->"5f3fb5af-4fb6-7844-80d8-\
264932ef0b4f"],

Cell[TextData[{
 "In GBS, ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "396ff20d-6202-ff44-94d3-ea87582e764b"],
 " squeezed vacua enter an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "-"}], TraditionalForm]],ExpressionUUID->
  "f7ddffc6-007e-5149-90ef-1fbde2ca744b"],
 "mode interferometer W, and photon-number-resolving detectors record a \
pattern ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n",
     FontWeight->"Bold"], 
    StyleBox["=",
     FontWeight->"Bold"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["n", "1"], ",", 
      RowBox[{"\[Ellipsis]", " ", 
       SubscriptBox["n", "m"]}]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "8a5bef2b-9d8f-964d-8fe8-431616510fdf"],
 ". With squeezing  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Xi]", "j"], "=", " ", 
    RowBox[{
     SubscriptBox["r", "j"], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", 
       SubscriptBox["\[Phi]", "j"]}]]}]}], TraditionalForm]],ExpressionUUID->
  "166de77e-3f43-f846-b5a2-d2c3d5f1e626"],
 " in mode ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "33d18dc7-1b4e-d246-a586-5d93372214b2"],
 ", the amplitude is a hafnian "
}], "Text",
 CellChangeTimes->{{4.002133011151211*^9, 
  4.0021331134176598`*^9}},ExpressionUUID->"6922df49-3989-8446-872c-\
490dbea23895"],

