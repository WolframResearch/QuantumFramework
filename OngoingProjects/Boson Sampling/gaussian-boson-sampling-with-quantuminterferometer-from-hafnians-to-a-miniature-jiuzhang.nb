 RowBox[{"squeezer", "=", 
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<S\>\"", "[", "\[Xi]", "]"}], "->", "1"}], "}"}], ",", "1", 
    ",", 
