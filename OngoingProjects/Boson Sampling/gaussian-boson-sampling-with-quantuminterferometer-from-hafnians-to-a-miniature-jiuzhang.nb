}, Open  ]],

Cell["\<\
A photon-number table of this network is out of reach shots carry up to 22 \
photons, and the table would need every pattern up to that number in twelve \
modes. The sampler only needs one pattern at a time:\
\>", "Text",
 CellChangeTimes->{{4.0023845178474026`*^9, 
  4.0023845208074265`*^9}},ExpressionUUID->"9dd3e89c-8e5b-5e48-90c3-\
9633bc712f31"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"jiuzhangShots", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"#1", "[", "\"\<Name\>\"", "]"}], "&"}], ")"}], "/@", 
    RowBox[{"jiuzhang", "[", 
     RowBox[{"\"\<Samples\>\"", ",", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", "12"}], "]"}], ",", 
      SuperscriptBox["10", "4"]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.002382996973833*^9, 4.002383000082142*^9}, {
  4.002384540142086*^9, 4.0023845433768234`*^9}},
 CellLabel->
  "In[128]:=",ExpressionUUID->"82f28aa4-2197-8342-ae3a-92ebce7b0547"],

Cell["Check the maximum number of photons of the shots:", "Text",
 CellChangeTimes->{{4.0023846504742126`*^9, 
  4.002384662928396*^9}},ExpressionUUID->"78a5e5d3-d362-b943-9f7b-\
f3f666811b84"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Total", "/@", "jiuzhangShots"}], "]"}]], "Input",
 CellChangeTimes->{{4.002382996973833*^9, 4.002383000082142*^9}, {
  4.002384540142086*^9, 4.0023845433768234`*^9}},
 CellLabel->
  "In[132]:=",ExpressionUUID->"bc6be3f8-0cbe-e04e-a20a-8fb7c7fc62f7"],

Cell[BoxData["22"], "Output",
 CellChangeTimes->{4.0023845968292522`*^9, 4.002384665432518*^9},
 CellLabel->
  "Out[132]=",ExpressionUUID->"e0eaec80-5e5e-164e-b5a6-8c93545ff0a6"]
}, Open  ]],

Cell[TextData[{
 "The Torontonian needs no cutoff it sums ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    RowBox[{"|", "S", "|"}]], TraditionalForm]],ExpressionUUID->
  "ea6244ca-7b7f-7541-9095-00c3ead093c5"],
 " determinants and accounts for every photon number at once. Summed over all \
4096 click patterns, it gives the distribution of the number of clicks:"
}], "Text",
 CellChangeTimes->{{4.0023846767751217`*^9, 
  4.002384695427431*^9}},ExpressionUUID->"e9cd4ff2-a24d-2d4b-90dd-\
b458ca815384"],

Cell[BoxData[
 RowBox[{
  RowBox[{"clickCounts", "=", 
   RowBox[{"GroupBy", "[", 
    RowBox[{
     RowBox[{"Subsets", "[", 
      RowBox[{"Range", "[", "12", "]"}], "]"}], ",", "Length", ",", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"clickProbability", "[", 
           RowBox[{"\[Sigma]Q", ",", "#1"}], "]"}], "&"}], ")"}], "/@", 
        "#1"}], "]"}], "&"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002384706423359*^9, 4.0023847077374687`*^9}},
 CellLabel->
  "In[133]:=",ExpressionUUID->"0cfd3c3b-ae29-4044-ba7f-0f09920bdb49"],

Cell["\<\
A threshold detector sees a mode with photons as one click. The same shots, \
counted with photon-number resolution and with threshold detectors, against \
the Torontonian:\
\>", "Text",
 CellChangeTimes->{{4.002384727483698*^9, 
  4.0023847416052856`*^9}},ExpressionUUID->"625a43bf-1e9a-9a41-993e-\
fd4ee27a2256"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLogPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"KeySort", "@", 
         RowBox[{"Counts", "[", 
          RowBox[{"Total", "/@", "jiuzhangShots"}], "]"}]}], ",", 
        RowBox[{"KeySort", "@", 
         RowBox[{"Counts", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Count", "[", 
             RowBox[{"#", ",", 
              RowBox[{"_", "?", "Positive"}]}], "]"}], "&"}], "/@", 
           "jiuzhangShots"}], "]"}]}]}], "}"}], "/", 
      RowBox[{"Length", "[", "jiuzhangShots", "]"}]}], ",", 
     InterpretationBox[
      DynamicModuleBox[{Typeset`open = False}, 
       TemplateBox[{"Expression", "SequenceIcon", 
         GridBox[{{
            RowBox[{
              TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["Sequence", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["3", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Byte count: \"", "IconizedLabel"], 
              "\[InvisibleSpace]", 
              TagBox["512", "IconizedItem"]}]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
          "Column", 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
         Dynamic[Typeset`open]},
        "IconizedObject"]],
      Sequence[
      PlotMarkers -> Automatic, PlotLegends -> {"photons", "clicks"}, 
       PlotRange -> {10^(-5), 1}],
      SelectWithContents->True,
      Selectable->False]}], "]"}], ",", 
   RowBox[{"ListLogPlot", "[", 
    RowBox[{"clickCounts", ",", 
     InterpretationBox[
      DynamicModuleBox[{Typeset`open = False}, 
       TemplateBox[{"Expression", "SequenceIcon", 
         GridBox[{{
            RowBox[{
              TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["Sequence", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["3", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Byte count: \"", "IconizedLabel"], 
              "\[InvisibleSpace]", 
              TagBox["376", "IconizedItem"]}]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
          "Column", 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
         Dynamic[Typeset`open]},
        "IconizedObject"]],
      Sequence[
      Joined -> True, PlotStyle -> Directive[Gray, Dashed], 
       PlotLegends -> {"torontonian"}],
      SelectWithContents->True,
