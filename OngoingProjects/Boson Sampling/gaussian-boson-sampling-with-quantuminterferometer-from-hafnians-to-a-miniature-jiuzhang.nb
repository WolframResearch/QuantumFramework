Cell[TextData[{
 "Calculate the non-zero patterns of the probability distribution for a given \
cutoff, only the |",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "8114ff03-7c1f-0244-8865-7be8eda0b4d5"],
 ", ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "9b44e220-f5e1-454e-ab78-c0d0ae118fa6"],
 "\[RightAngleBracket] patterns remain:"
}], "Text",
 CellChangeTimes->{{4.002127307964283*^9, 4.002127347537798*^9}, {
  4.0021273902663307`*^9, 
  4.00212740392428*^9}},ExpressionUUID->"d309ab89-3e8c-ff40-8bd9-\
1db6101725a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pp", " ", "=", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"#", ",", 
        RowBox[{"r", ">", "0"}]}], "]"}], "&"}], "/@", 
     RowBox[{
      RowBox[{"twoModeSqueezer", "[", "r", "]"}], "[", 
      RowBox[{"\"\<Probabilities\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"\"\<Cutoff\>\"", "->", "10"}]}], "]"}]}], ",", "0"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{4.0017817144039783`*^9, 4.00178175696533*^9}, {
  4.0017821643186474`*^9, 4.0017821659240856`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"a5626d86-df6f-ad4e-85bb-5c0dc853d2c9"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
    InterpretationBox[
     StyleBox[
      TemplateBox[{
        RowBox[{"0", "\[InvisibleSpace]", "0"}]},
       "Ket"],
      FontWeight->"Plain"],
     Wolfram`QuantumFramework`QuditName[{0, 0}, "Dual" -> False]], "\[Rule]", 
    
    SuperscriptBox[
     RowBox[{"Sech", "[", "r", "]"}], "2"]}], ",", 
