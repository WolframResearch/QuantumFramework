Cell["\<\
At four modes, GBS produces about three times more collision-free events than \
uniform bosons. Beyond eight modes the two curves are close, and the fraction \
approaches one half only at 16 modes, four times the photon number. \
Collisions become rare once the number of modes grows faster than the square \
of the photon number, the bosonic birthday paradox. \
\>", "Text",
 CellChangeTimes->{{4.0023711985682697`*^9, 
  4.0023712329759464`*^9}},ExpressionUUID->"c9b751ce-d048-c040-94b7-\
b8325fff0408"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Two point ",
 StyleBox["correlators",
  IgnoreSpellCheck->True]
}], "Section",
 CellChangeTimes->{{4.0020309149277496`*^9, 
  4.0020309204241447`*^9}},ExpressionUUID->"88d51ea1-e076-eb43-9c1e-\
17bf117231ae"],

Cell[TextData[{
 "A device with a hundred modes cannot be checked pattern by pattern. A first \
test uses low-order correlations, which are easy to compute for Gaussian \
states. The output of the network is a Gaussian state with zero mean, fully \
described by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["N", 
     RowBox[{"i", " ", "j", " "}]], "=", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubsuperscriptBox["a", "i", "\[Dagger]"], 
      SubscriptBox["a", "j"]}], "\[RightAngleBracket]"}]}], TraditionalForm]],
  ExpressionUUID->"49b011d1-9d66-c74d-8f7c-4a10701e29aa"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", 
     RowBox[{"i", " ", "j", " "}]], "=", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox["a", "i"], 
      SubscriptBox["a", "j"]}], "\[RightAngleBracket]"}]}], TraditionalForm]],
  ExpressionUUID->"31069c86-eb98-ca47-bcd1-95b792165888"],
 ". And by Wick\[CloseCurlyQuote]s theorem  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      SubscriptBox["n", "i"], "\[RightAngleBracket]"}], " ", "=", " ", 
     SubscriptBox["N", 
      RowBox[{"i", " ", "i"}]]}], ",", " ", 
    RowBox[{
     RowBox[{"cov", "(", 
      RowBox[{
       SubscriptBox["n", "i"], ",", 
       SubscriptBox["n", "j"]}], ")"}], "=", 
     RowBox[{"|", 
      SubscriptBox["N", 
       RowBox[{"i", " ", "j"}]], 
      SuperscriptBox["|", "2"], 
      RowBox[{"+", 
       RowBox[{"|", 
        SubscriptBox["M", 
         RowBox[{"i", " ", "j"}]], 
        SuperscriptBox["|", "2"], 
        RowBox[{"(", 
         RowBox[{"i", " ", "\[NotEqual]", " ", "j"}], ")"}]}]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"e7f71f7f-031e-5149-9443-c9a0f7f18bee"]
}], "Text",
 CellChangeTimes->{{4.002371304296484*^9, 4.0023713225466537`*^9}, {
  4.0023713640297756`*^9, 4.0023714094668694`*^9}, {4.002371449565323*^9, 
  4.002371516109436*^9}, {4.0023781726292152`*^9, 
  4.0023781773976345`*^9}},ExpressionUUID->"efaa0a55-38ff-4b45-b0cf-\
bb862a7c11d5"],

Cell[TextData[{
 "Wick\[CloseCurlyQuote]s theorem (for bosonic operators) applies to a \
Gaussian state with zero mean. In such a state, the expectation of any \
product of creation and annihilation operators is the sum, over every way of \
grouping the operators into pairs, of the product of the pair expectations. \
With four operators there are three pairings ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"A", " ", "B", " ", "C", " ", "D"}], "\[RightAngleBracket]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"A", " ", "B"}], "\[RightAngleBracket]"}], 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"C", " ", "D"}], "\[RightAngleBracket]"}]}], "+", " ", 
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"A", " ", "C"}], "\[RightAngleBracket]"}], 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"B", " ", "D"}], "\[RightAngleBracket]"}]}], " ", "+", 
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"A", " ", "D"}], "\[RightAngleBracket]"}], 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"B", " ", "C"}], "\[RightAngleBracket]"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"f23c7f6d-4cd5-a248-b2bd-db662b23070d"],
 ". Every higher moment follows from them."
}], "Text",
 CellFrame->{{0, 0}, {0, 1}},
 CellMargins->{{66, 0}, {8, 6}},
 CellFrameMargins->{{14, 14}, {12, 12}},
 CellFrameColor->RGBColor[0.901961, 0.411765, 0.027451],
 CellChangeTimes->{
  4.0023657014120064`*^9, {4.0023657556824055`*^9, 4.002365839653263*^9}, {
   4.002378318326866*^9, 4.0023784101526985`*^9}},
 LineSpacing->{1.2, 1., 2.},
 FontFamily->"Source Sans Pro",
 FontSize->15,
 FontColor->GrayLevel[0.2],
 Background->RGBColor[
  1., 0.9647058823529412, 
   0.9411764705882353],ExpressionUUID->"ff7ee3a3-bf94-6d4d-a37c-5fa37473f57a"],

Cell[TextData[{
 "For squeezed vacua in the input ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubsuperscriptBox["a", "k", "\[Dagger]"], 
      SubscriptBox["a", "k"]}], "\[RightAngleBracket]"}], "=", 
    SuperscriptBox[
     RowBox[{"sinh", "(", 
      SubscriptBox["r", "k"], ")"}], "2"]}], TraditionalForm]],ExpressionUUID->
  "95b8052e-7846-6949-91de-8690670089d5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     SubsuperscriptBox["a", "k", "2"], "\[RightAngleBracket]"}], "=", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", 
        SubscriptBox["\[Phi]", "k"]}]]}], 
     RowBox[{"sinh", "(", 
      SubscriptBox["r", "k"], ")"}], 
     RowBox[{"cosh", "(", 
      SubscriptBox["r", "k"], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "d9fa0e3f-48e4-0448-9443-b619dea7bf9b"],
 ":"
}], "Text",
 CellChangeTimes->{{4.0023715341928654`*^9, 
  4.0023716429351654`*^9}},ExpressionUUID->"98217f0a-7cb0-d048-bd2d-\
3fb488c4f96d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"secondMoments", "[", 
   RowBox[{"\[Xi]s_", ",", "w_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "w", "]"}], ".", 
     RowBox[{"DiagonalMatrix", "[", 
      SuperscriptBox[
       RowBox[{"Sinh", "[", 
        RowBox[{"Abs", "[", "\[Xi]s", "]"}], "]"}], "2"], "]"}], ".", 
     RowBox[{"Transpose", "[", "w", "]"}]}], ",", 
    RowBox[{"w", ".", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Exp", "[", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"Arg", "[", "\[Xi]s", "]"}]}], "]"}]}], " ", 
       RowBox[{"Sinh", "[", 
        RowBox[{"Abs", "[", "\[Xi]s", "]"}], "]"}], " ", 
       RowBox[{"Cosh", "[", 
        RowBox[{"Abs", "[", "\[Xi]s", "]"}], "]"}]}], "]"}], ".", 
     RowBox[{"Transpose", "[", "w", "]"}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{4.002382551177582*^9, 4.0023825576981354`*^9}},
 CellLabel->"In[81]:=",ExpressionUUID->"b5cc2b91-bc64-e842-85f6-ff1cd60dbc96"],

Cell[TextData[{
 "Calculate it for the GBS ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]],ExpressionUUID->
  "aac4e0f5-0acd-4c4d-8747-9e8769d5af99"],
 " mode network:"
}], "Text",
 CellChangeTimes->{{4.002382576836546*^9, 
  4.002382593741167*^9}},ExpressionUUID->"9894d144-dda2-e54e-99e2-\
d95777f075d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"nMat", ",", "mMat"}], "}"}], "=", 
   RowBox[{"secondMoments", "[", 
    RowBox[{"\[Xi]s", ",", "w"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002382569172619*^9, 4.002382569172619*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"f27b7a6c-d2d3-eb42-b0d0-5b98ffdc7085"],

Cell["We compare off-diagonal parts only:", "Text",
 CellChangeTimes->{
  4.002377673686775*^9},ExpressionUUID->"50e31a43-32e8-634e-9c4c-\
c89b954a84c2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"offDiagonal", "[", "mat_", "]"}], ":=", 
  RowBox[{"mat", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{"IdentityMatrix", "[", 
      RowBox[{"Length", "[", "mat", "]"}], "]"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{4.0021345221521854`*^9, 4.0021345221521854`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"1b542cda-5f21-b041-ae95-98c0e73eb372"],

Cell["\<\
Largest error of the mean photon numbers and of the off-diagonal covariances \
of a distribution of photon counts, against Wick\[CloseCurlyQuote]s theorem:\
\>", "Text",
 CellChangeTimes->{
  4.002378214708954*^9},ExpressionUUID->"2dc1d8ed-bb35-a34b-bffc-\
4b09d82cd94e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wickErrors", "[", "dist_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Mean", "[", "dist", "]"}], "-", 
       RowBox[{"Re", "[", 
        RowBox[{"Diagonal", "[", "nMat", "]"}], "]"}]}], "]"}], "]"}], ",", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"offDiagonal", "[", 
       RowBox[{
        RowBox[{"Covariance", "[", "dist", "]"}], "-", 
        SuperscriptBox[
         RowBox[{"Abs", "[", "nMat", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"Abs", "[", "mMat", "]"}], "2"]}], "]"}], "]"}], "]"}]}], 
   "}"}]}]], "Input",
 CellChangeTimes->{{4.002377691939602*^9, 4.002377694975294*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"035fd18e-7ca3-5f40-a4f6-cdf549009f37"],

Cell["\<\
A probability table  with each pattern weighted by its probability:\
\>", "Text",
 CellChangeTimes->{{4.002378455791401*^9, 
  4.002378463174095*^9}},ExpressionUUID->"a8cf28b5-fc62-7247-ab51-\
28dff04af8fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"countDistribution", "[", "probs_", "]"}], ":=", 
  RowBox[{"EmpiricalDistribution", "[", 
   RowBox[{
    RowBox[{"Values", "[", "probs", "]"}], "->", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<Name\>\"", "]"}], "&"}], "/@", 
      RowBox[{"Keys", "[", "probs", "]"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.002377722367113*^9, 4.002377722367113*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"bb05abb8-a487-0946-9dda-1d39534f3d47"],

Cell["Compute the cutoff dependent errors:", "Text",
 CellChangeTimes->{{4.002378484671318*^9, 4.002378501671196*^9}, {
  4.002378578489271*^9, 
  4.0023785832869434`*^9}},ExpressionUUID->"6e4df9ec-84a7-c04a-888e-\
9f28d8fbdab0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cutoffErrors", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{"c", ",", 
        RowBox[{"wickErrors", "[", 
         RowBox[{"countDistribution", "[", 
          RowBox[{"gbs", "[", 
           RowBox[{"\"\<Probabilities\>\"", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
            RowBox[{"\"\<Cutoff\>\"", "\[Rule]", "c"}]}], "]"}], "]"}], 
         "]"}]}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "4", ",", "16", ",", "2"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.0023777424317856`*^9, 4.0023777440870247`*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"9df20555-1edd-8a44-9a9f-ca7d3ffc1aad"],

Cell["Both errors fall exponentially with the cutoff:", "Text",
 CellChangeTimes->{{4.002378558389166*^9, 
  4.0023785744841576`*^9}},ExpressionUUID->"9e2e75dd-0da8-e443-bb62-\
871b1610f370"],

Cell[CellGroupData[{

Cell[BoxData[
