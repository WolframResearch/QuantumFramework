Cell[TextData[{
 "We get other output states that are not the |",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", ",", "n"}], "\[RightAngleBracket]"}], TraditionalForm]],
  ExpressionUUID->"b92eebca-eb75-894b-a040-44f863a6fcc1"],
 ", so it\[CloseCurlyQuote]s clear is a different state:"
}], "Text",
