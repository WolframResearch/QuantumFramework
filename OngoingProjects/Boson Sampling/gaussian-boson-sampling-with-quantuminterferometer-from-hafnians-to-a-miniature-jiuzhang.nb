Cell[TextData[{
 "The squeezing can also be symbolic, if we assume a real ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "80be7c52-6bf7-5f41-8963-f70e677da5f8"],
 " to calculate probabilities that given an initial |0\[RightAngleBracket] \
state we have ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
