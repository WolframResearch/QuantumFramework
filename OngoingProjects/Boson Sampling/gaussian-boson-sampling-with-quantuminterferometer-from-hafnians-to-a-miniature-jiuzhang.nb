Cell[TextData[{
 "The squeezers ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"tanh", "(", 
     SubscriptBox["r", "j"], ")"}], "=", " ", 
    RowBox[{"c", " ", 
     SubscriptBox["\[Lambda]", "j"]}]}], TraditionalForm]],ExpressionUUID->
  "f7072cf1-9608-4649-b880-4b7f7c94fa64"],
 " , with ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "ccf95a1d-f775-a540-9913-9decbabe44ce"],
 " chosen to keep every ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"tanh", "(", 
     SubscriptBox["r", "j"], ")"}], "<=", " ", "0.7"}], TraditionalForm]],
  ExpressionUUID->"126c486c-01ed-f741-9099-d2a8907ef5ab"],
 ":"
}], "Text",
 CellChangeTimes->{{4.002387159305046*^9, 4.0023872157986374`*^9}, {
  4.0023872629385796`*^9, 4.0023872775307674`*^9}, {4.002391242336233*^9, 
  4.00239126232819*^9}, {4.002629586157789*^9, 
  4.0026296036087437`*^9}},ExpressionUUID->"cad11bfc-3387-644f-a08b-\
4deecf9ad8f8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"0.7", "/", 
    RowBox[{"Max", "[", "\[Lambda]g", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rg", "=", 
   RowBox[{"ArcTanh", "[", 
    RowBox[{"c", " ", "\[Lambda]g"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.00238558632325*^9, 4.00238558632325*^9}, 
   4.002387283948965*^9},ExpressionUUID->"98ea4cd6-5113-374c-8077-\
5501021d40f9"],

Cell["\<\
The 0.7 was not derived from anything. It was picked it by trial as a \
compromise between how many six-photon events you get and how heavily one \
mode is squeezed.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 1}},
 CellMargins->{{66, 0}, {8, 6}},
 CellFrameMargins->{{14, 14}, {12, 12}},
 CellFrameColor->RGBColor[0.901961, 0.411765, 0.027451],
 CellChangeTimes->{
  4.0023657014120064`*^9, {4.0023657556824055`*^9, 4.002365839653263*^9}, {
   4.002378318326866*^9, 4.0023784101526985`*^9}, {4.002387320275837*^9, 
   4.0023873452945786`*^9}},
 LineSpacing->{1.2, 1., 2.},
 FontFamily->"Source Sans Pro",
 FontSize->15,
 FontColor->GrayLevel[0.2],
 Background->RGBColor[
  1., 0.9647058823529412, 
   0.9411764705882353],ExpressionUUID->"23a886be-98df-f24c-a792-ead0da345df6"],

Cell["Build the network:", "Text",
 CellChangeTimes->{{4.00238735485133*^9, 
  4.002387357255707*^9}},ExpressionUUID->"8730a1a7-1349-d24d-8dd9-\
b7f6b0c9d78d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"graphGBS", "=", 
   RowBox[{"gbsNetwork", "[", 
    RowBox[{"rg", ",", 
     RowBox[{"QuantumInterferometer", "[", "wg", "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.00238558632325*^9, 4.00238558632325*^9}, 
   4.002387283948965*^9},
 CellLabel->
  "In[195]:=",ExpressionUUID->"287f9c75-e67d-6249-9c76-74d7113ad08b"],

Cell[TextData[{
 "The complete graph on six vertices has 5!! = 15 perfect matchings, and the \
probability of one photon on each hidden vertex is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["c", "6"], "\[Times]", 
    RowBox[{
     SuperscriptBox["15", "2"], "/", 
     SubscriptBox["\[CapitalPi]", "j"]}], " ", 
    RowBox[{"cosh", "(", 
     SubscriptBox["r", "j"], ")"}]}], TraditionalForm]],ExpressionUUID->
  "719827f9-3ef2-984b-b4b9-a8f6c7a2c4f8"],
 ", compared with the hafnian from the beginning of the post:"
}], "Text",
 CellChangeTimes->{
  4.002387488883337*^9, {4.002387523913252*^9, 
   4.0023875540002117`*^9}},ExpressionUUID->"ae9e9c03-cd6b-944c-be74-\
387a69077a76"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"zero", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "16"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"graphGBS", "[", 
      RowBox[{"\"\<Probability\>\"", ",", 
       RowBox[{"zero", "\[Rule]", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{"zero", ",", 
          RowBox[{
           RowBox[{"List", "/@", "hidden"}], "\[Rule]", "1"}]}], "]"}]}]}], 
      "]"}], ",", 
     FractionBox[
      RowBox[{
       SuperscriptBox["c", "6"], " ", 
       SuperscriptBox[
        RowBox[{"hafnian", "[", 
         RowBox[{"a", "\[LeftDoubleBracket]", 
          RowBox[{"hidden", ",", "hidden"}], "\[RightDoubleBracket]"}], "]"}],
         "2"]}], 
      RowBox[{"Times", "@@", 
       RowBox[{"Cosh", "[", "rg", "]"}]}]], ",", 
     RowBox[{"hafnian", "[", 
      RowBox[{"a", "\[LeftDoubleBracket]", 
       RowBox[{"hidden", ",", "hidden"}], "\[RightDoubleBracket]"}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{4.0023855983483753`*^9, 4.0023856005294647`*^9}, 
   4.002387812581911*^9, {4.002387888445484*^9, 4.00238793188859*^9}},
 CellLabel->
  "In[222]:=",ExpressionUUID->"dcad7a68-85a1-da4b-8b2a-c08433248f87"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.00032226705315328586`", ",", "0.00032226705315329144`", ",", "15"}], 
  "}"}]], "Output",
 CellChangeTimes->{
  4.0023856030616226`*^9, 4.0023878173320866`*^9, 4.0023878897679024`*^9, {
   4.002387934454775*^9, 4.002387956679758*^9}},
 CellLabel->
  "Out[222]=",ExpressionUUID->"b4f43734-52d4-c84c-b34e-80f3ea1f06dc"]
}, Open  ]],

Cell["\<\
There are 8008 six-vertex subgraphs, and a search for the densest one has to \
compare them:\
\>", "Text",
 CellChangeTimes->{{4.002387985283144*^9, 4.002387992828621*^9}, {
   4.00238802825634*^9, 4.002388047821436*^9}, {4.0023881304289303`*^9, 
   4.002388133796608*^9}, 
   4.002388177580223*^9},ExpressionUUID->"8896393c-2977-de4f-9c7a-\
4b765f70701c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Binomial", "[", 
  RowBox[{"16", ",", "6"}], "]"}]], "Input",
 CellChangeTimes->{{4.0023881384511757`*^9, 4.0023881409653664`*^9}},
 CellLabel->
  "In[225]:=",ExpressionUUID->"735aa9f0-e3f6-d543-9bb3-83eab57af8a8"],

Cell[BoxData["8008"], "Output",
 CellChangeTimes->{4.0023881660460167`*^9},
 CellLabel->
  "Out[225]=",ExpressionUUID->"86289fe3-811d-c945-9d31-11105d15b459"]
}, Open  ]],

Cell["\<\
We perform samples, the sampler takes about a minute and a half:\
\>", "Text",
 CellChangeTimes->{{4.002387985283144*^9, 4.002387992828621*^9}, {
  4.00238802825634*^9, 4.002388047821436*^9}, {4.0023885649328823`*^9, 
  4.0023885653355846`*^9}},ExpressionUUID->"209a9a6b-8062-2149-8193-\
fa008d8194f4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"graphShots", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"#1", "[", "\"\<Name\>\"", "]"}], "&"}], ")"}], "/@", 
     RowBox[{"graphGBS", "[", 
      RowBox[{"\"\<Samples\>\"", ",", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", "16"}], "]"}], ",", 
       SuperscriptBox["10", "5"]}], "]"}]}]}], ";"}], "//", 
  "EchoTiming"}]}], "Input",
 CellChangeTimes->{{4.002385611277584*^9, 4.0023856401573696`*^9}, 
   4.0023880118987064`*^9},
 CellLabel->
  "In[223]:=",ExpressionUUID->"dd97622b-11e5-d644-9096-7dab4925ffaf"],

Cell[BoxData["93.8736374`"], "EchoTiming",
 CellChangeTimes->{
  4.0023881659729824`*^9},ExpressionUUID->"9e255510-cb34-b444-8851-\
e7ae0b2797fd"]
}, Open  ]],

Cell[TextData[{
 "Keep the collision-free six-photon events of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", "5"], TraditionalForm]],ExpressionUUID->
  "5ded1b78-0b97-a44d-b980-7083f8f2f90b"],
 " shots, each a six-vertex subgraph:"
}], "Text",
 CellChangeTimes->{
  4.002388051361273*^9, 4.002388228533993*^9, {4.002388562770836*^9, 
   4.0023885631348763`*^9}},ExpressionUUID->"17a7c947-7901-8a48-b935-\
8af4161b4c1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sixVertex", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{"#1", ",", "1"}], "]"}], "]"}], "&"}], ")"}], "/@", 
    RowBox[{"Select", "[", 
     RowBox[{"graphShots", ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", "#1", "]"}], "\[Equal]", "1"}], "&&", 
        RowBox[{
         RowBox[{"Total", "[", "#1", "]"}], "\[Equal]", "6"}]}], "&"}]}], 
     "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002385611277584*^9, 4.0023856401573696`*^9}, 
   4.0023880118987064`*^9, {4.00238823090234*^9, 4.002388231337923*^9}},
 CellLabel->
  "In[226]:=",ExpressionUUID->"8dd0e686-8b45-6644-8242-34dfa2cfa0f3"],

Cell["\<\
The hidden subgraph is the most frequent one, show the top 5:\
\>", "Text",
 CellChangeTimes->{
  4.0023882625001545`*^9, {4.002388339184263*^9, 
   4.002388352004881*^9}},ExpressionUUID->"d32d00af-0cf9-744e-b3f3-\
827505694b95"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Take", "[", 
  RowBox[{
   RowBox[{"frequents", "=", 
    RowBox[{"ReverseSort", "[", 
     RowBox[{"Counts", "[", "sixVertex", "]"}], "]"}]}], ",", "5"}], 
  "]"}]], "Input",
 CellChangeTimes->{{4.0023857914708214`*^9, 4.0023857914708214`*^9}, {
  4.002388301347431*^9, 4.0023883081327972`*^9}},
 CellLabel->
  "In[228]:=",ExpressionUUID->"ca1c8790-a0cb-6e46-8786-ab141b0b3fc7"],

