Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", 
    StyleBox["n",
     FontWeight->"Bold"]], TraditionalForm]],ExpressionUUID->
  "e9e6f8ad-ba4a-4547-8610-17f411b51c10"],
 " repeats row and column",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", "j", " "}], TraditionalForm]],ExpressionUUID->
  "0fae040e-95eb-8643-a19c-4999895ae0a0"],
 "of ",
 "B",
 "  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "j"], TraditionalForm]],ExpressionUUID->
  "ef3a91eb-4a5b-e746-8dc9-9fe74305a7bc"],
 " times,the overall minus sign comes from our squeezer convention"
}], "Text",
 CellChangeTimes->{
  4.0021331730819054`*^9, {4.0021332753335*^9, 
   4.0021333218773003`*^9}},ExpressionUUID->"4ea5ba69-df1d-d440-a993-\
c0e9dde02547"],

Cell[TextData[{
 "A column of squeezers, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Xi]", "j"], TraditionalForm]],ExpressionUUID->
  "0d479d64-0f50-594d-938b-7e4c95acbec3"],
 " on mode ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "2cd8ce84-1bb6-2344-9843-e21b9447a79f"],
 " :"
}], "Text",
 CellChangeTimes->{{4.002366042826851*^9, 
  4.002366055488001*^9}},ExpressionUUID->"0328a3cd-9c7f-8848-b6e7-\
d71390a617be"],

Cell[BoxData[
 RowBox[{
  RowBox[{"squeezers", "[", "\[Xi]s_", "]"}], ":=", 
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{
    RowBox[{"MapIndexed", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\"\<S\>\"", "[", "#1", "]"}], "->", 
        RowBox[{"First", "[", "#2", "]"}]}], "&"}], ",", "\[Xi]s"}], "]"}], ",", 
    RowBox[{"Length", "[", "\[Xi]s", "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.002366018466053*^9, 4.0023660207671223`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"94013d45-c0b9-184d-8d2e-ef51e5faa9a9"],

Cell["\<\
A GBS network is the squeezers followed by a mesh. Applying one \
interferometer to another places the mesh after the squeezers:\
\>", "Text",
 CellChangeTimes->{{4.002133229439867*^9, 4.002133255096506*^9}, {
  4.0023660728411655`*^9, 
  4.002366080877201*^9}},ExpressionUUID->"b2804f35-478c-ab48-82c9-\
db561015ce32"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gbsNetwork", "[", 
   RowBox[{"\[Xi]s_", ",", "mesh_"}], "]"}], ":=", 
  RowBox[{"mesh", "@", 
   RowBox[{"squeezers", "[", "\[Xi]s", "]"}]}]}]], "Input",
 CellChangeTimes->{{4.00236608781213*^9, 4.00236608781213*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"0d6c3c9f-30d6-b247-8140-49fefcf514fe"],

Cell["\<\
Four squeezers with different strengths and phases, followed by a Haar-random \
four-mode mesh:\
\>", "Text",
 CellChangeTimes->{
  4.0023661460900307`*^9},ExpressionUUID->"c2e45ee8-fd90-564a-a209-\
994e07b7563c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "2026", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mesh", "=", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"\"\<Random\>\"", "[", "4", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Xi]s", "=", 
   RowBox[{"{", 
    RowBox[{"0.3", ",", 
     RowBox[{"0.5", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"\[Pi]", "/", "3"}]}], "]"}]}], ",", 
     RowBox[{"0.7", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{"\[Pi]", "/", "4"}]}], "]"}]}], ",", 
     RowBox[{"-", "0.4"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gbs", "=", 
   RowBox[{"gbsNetwork", "[", 
    RowBox[{"\[Xi]s", ",", "mesh"}], "]"}]}], ";"}], "\n", 
 RowBox[{"gbs", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellChangeTimes->{{4.0023661077185593`*^9, 4.0023661077185593`*^9}, {
  4.0023661428894615`*^9, 4.0023661432310467`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"ffef1d2b-aac4-584e-8c3a-a8e701f75f3b"],

