  FormBox[
   SuperscriptBox["10", "5"], TraditionalForm]],ExpressionUUID->
  "42f20870-77be-734e-bc4e-920d3fdceeb1"],
 " shots:"
}], "Text",
 CellChangeTimes->{{4.002368297811184*^9, 
