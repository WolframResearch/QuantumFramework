$ProgressReporting=False;
PacletDirectoryLoad["/Users/mohammadb/Documents/GitHub/QuantumFramework/QuantumFramework"];
Needs["Wolfram`QuantumFramework`"];
Needs["Wolfram`QuantumFramework`PackageScope`"];
same[a_,b_]:=a["Signs"]===b["Signs"]&&a["Tableau"]===b["Tableau"];
SeedRandom[9867];
Echo[Table[With[{p=PauliStabilizer[<|"Signs"->1-2 RandomInteger[1,2 n],"Tableau"->RandomInteger[1,{2,n,2 n}]|>],sp={"H"->n,"S"->1,"CNOT"->{n,1},"CZ"->{1,n},"Y"->n,"SWAP"->{1,n}}},same[p["ApplyCircuit",sp],Fold[#1[#2]&,p,sp]]],{n,{31,32,62,63,125,1024}}],"Arbitrary binary Pauli-row exact resident/scalar equality"];
stabilizerClearCaches[];
a=QuantumCircuitOperator[{"H"->1}]; b=QuantumCircuitOperator[{"X"->2}];
pa=stabilizerExecutionPlan[a]; pb=stabilizerExecutionPlan[b];
$stabilizerCircuitMemo[Hash[b]]={a,pa};
Echo[stabilizerExecutionPlan[b]===pb,"Full plan collision key equality"];
stabilizerClearCaches[];
Scan[stabilizerExecutionPlan[QuantumCircuitOperator[{"H"->#}]]&,Range[35]];
Echo[{Length[$stabilizerCircuitMemo],Length[$stabilizerEncodeMemo]},"Caches remain below16 entries after35 distinct inputs"];
stabilizerClearCaches[];
Echo[{Length[$stabilizerCircuitMemo],Length[$stabilizerEncodeMemo]},"Unified clear"];
Echo[With[{p=PauliStabilizer[3]},p["ApplyCircuit",{}]===p],"Empty exact object identity"];
Echo[encodeStabilizerGates[{"H"->2^63,"CNOT"->{-2^63,2^63}}],"Exact encoding across machine word maximum"];
Echo[$MessageList,"Messages"];
Exit[];
