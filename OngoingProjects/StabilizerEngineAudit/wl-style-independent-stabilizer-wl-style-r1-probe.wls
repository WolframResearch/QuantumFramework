$ProgressReporting = False;
PacletDirectoryLoad["/Users/mohammadb/Documents/GitHub/QuantumFramework/QuantumFramework"];
Needs["Wolfram`QuantumFramework`"];
Needs["Wolfram`QuantumFramework`PackageScope`"];
Echo[$Version, "Version"];
ps=PauliStabilizer[2];
Echo[PauliStabilizerQ[ps], "Constructor valid"];
Echo[ps["H",0], "H wire 0"];
Echo[ps["H",3], "H wire 3"];
Echo[ps["CNOT",1,1]["Signs"], "CNOT self signs"];
Echo[ps["CNOT",1,1]["Tableau"], "CNOT self tableau"];
Echo[PauliStabilizerQ[ps["CNOT",1,1]], "CNOT self accepted"];
Echo[ps["SWAP",1,1]["Tableau"] === ps["Tableau"], "Self swap identity"];
bad=PauliStabilizer[<|"Tableau"->ConstantArray[0,{2,1,2}],"Signs"->{1}|>];
Echo[{PauliStabilizerQ[bad],psConcreteFastQ[bad]}, "Invalid canonical fast eligibility"];
Echo[bad["ApplyCircuit",{"H"->1}], "Invalid canonical bulk"];
Echo[PauliStabilizerQ[bad["ApplyCircuit",{"H"->1}]], "Invalid bulk validity"];
Echo[$MessageList,"Messages"];
Exit[];
