$ProgressReporting=False;
PacletDirectoryLoad["/Users/mohammadb/Documents/GitHub/QuantumFramework/QuantumFramework"];
Needs["Wolfram`QuantumFramework`"];
Needs["Wolfram`QuantumFramework`PackageScope`"];
Echo[$Version,"Version"];
same[a_,b_]:=a["Signs"]===b["Signs"]&&a["Tableau"]===b["Tableau"];
base=PauliStabilizer[2];
mixed=PauliStabilizer[Append[First[base],"Tableau"->ConstantArray[1,{2,2,4}]]];
Echo[{PauliStabilizerQ[mixed],mixed["Tableau"]===base["Tableau"],mixed["Signs"]===base["Signs"]},"Mixed representation"];
Echo[mixed["Tableau"],"Mixed canonical property"];
Echo[mixed["ApplyCircuit",{"H"->1}]["Tableau"],"Mixed evolved property"];
qcX=QuantumChannel[QuantumOperator["X"]];
Echo[{qcX["Label"],QuantumChannelQ[qcX]},"X QuantumChannel label"];
ccX=CliffordChannel[qcX];
Echo[ccX,"X CliffordChannel"];
Echo[ccX[PauliStabilizer[1]]["Stabilizers"],"X CliffordChannel |0>"];
Echo[qcX[PauliStabilizer[1]],"X native channel |0>"];
negGraph=PauliStabilizer[{"-X"}];
Echo[GraphState[negGraph]["PauliStabilizer"]["Stabilizers"],"Negative graph roundtrip"];
SeedRandom[7451];
randSpec[n_]:=Table[With[{g=RandomChoice[{"H","S",SuperDagger["S"],"X","Y","Z","CNOT","CZ","SWAP"}],w=RandomSample[Range[n],2]},g->If[MemberQ[{"CNOT","CZ","SWAP"},g],w,First[w]]],{30}];
Echo[And@@Flatten[Table[With[{p=PauliStabilizer[n]["ApplyCircuit",randSpec[n]]},Table[same[p[g,j],p["H",j][If[g==="V","S",SuperDagger["S"]],j]["H",j]],{g,{"V",SuperDagger["V"]}},{j,n}]],{n,{2,3,5}}]],"V local decomposition exact signs/tableau"];
p=PauliStabilizer[2]["ApplyCircuit",randSpec[2]];
sym=PauliStabilizer[<|"Tableau"->p["Tableau"],"Signs"->Array[sign,4]|>];
Echo[And@@Flatten[Table[same[sym[g,j],sym["H",j][If[g==="V","S",SuperDagger["S"]],j]["H",j]],{g,{"V",SuperDagger["V"]}},{j,2}]],"V local arbitrary-symbol signs exact SameQ"];
Echo[$MessageList,"Messages"];
Exit[];
