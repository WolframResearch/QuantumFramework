repo="/Users/mohammadb/Documents/GitHub/QuantumFramework";
PacletDirectoryLoad[repo<>"/QuantumFramework"];Needs["Wolfram`QuantumFramework`"];Needs["Wolfram`QuantumFramework`PackageScope`"];
results=<||>;record[n_,v_]:=(results[n]=v;Echo[{n,v}]);
p=PauliStabilizer[2];
inputs={<|"Tableau"->p["Tableau"],"Qubits"->99|>,KeyDrop[Join[First[p],<|"Tableau"->p["Tableau"]|>],"Signs"]};
check[a_,wire_]:=Module[{ps=PauliStabilizer[a],calls=0,out,msgs},Block[{$MessageList={}},out=Catch[Block[{compiledCliffordFold=Function[Null,calls++;Throw["native intercepted",r3Native]]},ps["ApplyCircuit",{"H"->wire}]],r3Native];msgs=$MessageList];<|"Qubits"->ps["Qubits"],"Keys"->Keys[First[ps]],"TableauDimensions"->Dimensions[ps["Tableau"]],"Valid"->PauliStabilizerQ[ps],"Wire"->wire,"NativeCalls"->calls,"Result"->out,"Messages"->ToString[msgs,InputForm]|>];
record["NormalizationWireBounds",Table[check[a,wire],{a,inputs},{wire,{1,50}}]];
record["CPlanCollision",Module[{h=QuantumCircuitOperator[{"H"->1}],x=QuantumCircuitOperator[{"X"->1}],plan},stabilizerClearCaches[];plan=stabilizerExecutionPlan[h];Wolfram`QuantumFramework`GateMatrix`PackagePrivate`$stabilizerCircuitMemo[Hash[x]]={h,plan};x[PauliStabilizer[1]]["Stabilizers"]==={"-Z"}&&First[Wolfram`QuantumFramework`GateMatrix`PackagePrivate`$stabilizerCircuitMemo[Hash[x]]]===x]];
record["LiveVMatrix",Simplify[Normal[QuantumOperator["V"]["Matrix"]]-{{1+I,1-I},{1-I,1+I}}/2]===ConstantArray[0,{2,2}]];
ghz=PauliStabilizer[3]["ApplyCircuit",{"H"->1,"CNOT"->{1,2},"CNOT"->{2,3}}];
v=Normal[ghz["State"]["StateVector"]];
h={{1,1},{1,-1}}/Sqrt[2];vm={{1+I,1-I},{1-I,1+I}}/2;
f=ghz["ApplyCircuit",{"P"[r3Angle]->1,"H"->2,"V"->3}];
a=Normal[f["StateVector"]];b=KroneckerProduct[DiagonalMatrix[{1,Exp[I r3Angle]}],h,vm].v;
record["SymbolicFramePhysicalAction",FullSimplify[{Conjugate[a].a-1,Outer[Times,a,Conjugate[a]]-Outer[Times,b,Conjugate[b]]},Element[r3Angle,Reals]]==={0,ConstantArray[0,{8,8}]}];
branches=ghz["M",1];
record["GHZMeasurementPhysicalBranches",Keys[branches]==={0,1}&&And@@KeyValueMap[Function[{bit,post},With[{pv=KroneckerProduct[DiagonalMatrix[If[bit===0,{1,0},{0,1}]],IdentityMatrix[2],IdentityMatrix[2]].v,w=Normal[post["State"]["StateVector"]]},FullSimplify[Conjugate[w].w]===1&&FullSimplify[Outer[Times,w,Conjugate[w]]-2Outer[Times,pv,Conjugate[pv]]]===ConstantArray[0,{8,8}]]],branches]];
Block[{$MessageList={}},stabilizerClearCaches[];QuantumCircuitOperator[{"H"->1}][PauliStabilizer[1]];o=QuantumCircuitOperator[{QuantumOperator[QuantumOperator["H"],QuantumBasis["PauliX"]]}][PauliStabilizer[1]];record["CacheBasisChange",{o===$Failed,ToString[$MessageList,InputForm]}]];
Export["/private/tmp/stabilizer-r3-supplement.json",Map[ToString[#,InputForm]&,results],"RawJSON"];Echo["DONE"];Exit[];
