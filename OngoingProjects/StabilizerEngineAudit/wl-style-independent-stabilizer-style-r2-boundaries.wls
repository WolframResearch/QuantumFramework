repo="/Users/mohammadb/Documents/GitHub/QuantumFramework";
PacletDirectoryLoad[repo<>"/QuantumFramework"];
Needs["Wolfram`QuantumFramework`"];
Needs["Wolfram`QuantumFramework`PackageScope`"];
$ProgressReporting=False;
same[a_,b_] := a["Signs"]===b["Signs"] && Normal[a["Tableau"]]===Normal[b["Tableau"]];
rows=Internal`Bag[];
SetAttributes[record,HoldRest];
record[name_,expr_] := With[{v=expr},Internal`StuffBag[rows,<|"Name"->name,"Value"->ToString[v,InputForm]|>];Echo[{name,v}]];
stabilizerClearCaches[];
record["ReversedWireOrder",same[QuantumCircuitOperator[{QuantumOperator["CNOT",{3,1}]}][PauliStabilizer[3]],PauliStabilizer[3]["ApplyCircuit",{"CNOT"->{3,1}}]]];
stabilizerClearCaches[];
record["BasisSeparatesCache",Module[{good,bad,r},good=QuantumCircuitOperator[{QuantumOperator["H"]}];bad=QuantumCircuitOperator[{QuantumOperator[QuantumOperator["H"],"PauliX"]}];good[PauliStabilizer[1]];r=bad[PauliStabilizer[1]];{Head[r],r}]];
record["QubitMetadata",Module[{base,p},base=PauliStabilizer[2];p=PauliStabilizer[<|"Signs"->base["Signs"],"Tableau"->base["Tableau"],"Qubits"->99|>];{PauliStabilizerQ[p],psConcreteFastQ[p],p["Qubits"],Dimensions[p["Tableau"]]}]];
record["TableauOverridePacked",Module[{base,p},base=PauliStabilizer[2];p=PauliStabilizer[Append[First[base],"Tableau"->ConstantArray[0,{2,1,2}]]];{PauliStabilizerQ[p],psConcreteFastQ[p],p["Qubits"],Dimensions[p["Tableau"]]}]];
record["CanonicalExtraKeysDriveBoundary",Module[{base,p,calls=0,r},base=PauliStabilizer[2];p=PauliStabilizer[<|"Signs"->base["Signs"],"Tableau"->base["Tableau"],"Qubits"->99|>];r=Block[{compiledCliffordFold=Function[Null,calls++;$Failed]},p["ApplyCircuit",{"H"->50}]];{calls,ToString[r,InputForm]}]];
record["ValidCachedMarkMutation",Module[{p,b},p=PauliStabilizer[2];b=p;b[[1,"Qubits"]]=3;{PauliStabilizerQ[p],PauliStabilizerQ[b]}]];
Export["/private/tmp/stabilizer-style-r2-boundaries.json",Internal`BagPart[rows,All],"RawJSON"];
Exit[];
