$ProgressReporting=False;
PacletDirectoryLoad["/Users/mohammadb/Documents/GitHub/QuantumFramework/QuantumFramework"];
Needs["Wolfram`QuantumFramework`"];
Needs["Wolfram`QuantumFramework`PackageScope`"];
Echo[$Version,"Version"];
same[a_,b_]:=a["Signs"]===b["Signs"]&&a["Tableau"]===b["Tableau"];
canon[p_]:=PauliStabilizer[<|"Signs"->p["Signs"],"Tableau"->p["Tableau"]|>];
tensor[ms_List]:=Fold[KroneckerProduct,{{1}},ms];
embed[m_,q_,n_]:=tensor[ReplacePart[ConstantArray[IdentityMatrix[2],n],q->m]];
local=<|"H"->{{1,1},{1,-1}}/Sqrt[2],"S"->DiagonalMatrix[{1,I}],SuperDagger["S"]->DiagonalMatrix[{1,-I}],"X"->PauliMatrix[1],"Y"->PauliMatrix[2],"Z"->PauliMatrix[3],"V"->{{1+I,1-I},{1-I,1+I}}/2,SuperDagger["V"]->{{1-I,1+I},{1+I,1-I}}/2|>;
dense[g_->q_Integer,n_]:=embed[local[g],q,n];
dense[g_->{j_Integer,k_Integer},n_]:=With[{bits=IntegerDigits[Range[0,2^n-1],2,n]},If[g==="CZ",DiagonalMatrix[(-1)^(#[[j]] #[[k]])&/@bits],With[{out=If[g==="CNOT",ReplacePart[#,k->Mod[#[[k]]+#[[j]],2]]&/@bits,ReplacePart[#,{j->#[[k]],k->#[[j]]}]&/@bits]},Normal[SparseArray[Thread[Transpose[{FromDigits[#,2]&/@out+1,Range[2^n]}]->1],{2^n,2^n}]]]]];
row[p_,r_]:=With[{t=p["Tableau"]},p["Signs"][[r]] tensor[PauliMatrix /@ (t[[1,All,r]]+2 t[[2,All,r]] /. {3->2,2->3})]];
normalizePhase[m_]:=RootReduce[m Abs[First[Select[Flatten[m],#=!=0&]]]/First[Select[Flatten[m],#=!=0&]]];
group=FixedPoint[DeleteDuplicatesBy[Join[#,Catenate[Function[p,Table[{normalizePhase[local[g].p[[1]]],Append[p[[2]],g->1]},{g,{"H","S"}}]]/@#]],First]& ,{{IdentityMatrix[2],{}}}];
Echo[Length[group],"Independent dense Clifford group cardinality"];
Echo[AllTrue[group,Function[p,With[{out=PauliStabilizer[1]["ApplyCircuit",p[[2]]],u=p[[1]]},And@@Table[Simplify[row[out,r]-u.PauliMatrix[If[r===1,1,3]].ConjugateTranspose[u]]===ConstantArray[0,{2,2}],{r,2}]]]],"All24 dense forward conjugations"];
Echo[AllTrue[group,Function[p,With[{out=PauliStabilizer[1]["ApplyCircuit",p[[2]]]["Dagger"],u=p[[1]]},And@@Table[Simplify[row[out,r]-ConjugateTranspose[u].PauliMatrix[If[r===1,1,3]].u]===ConstantArray[0,{2,2}],{r,2}]]]],"All24 dense inverse conjugations"];
SeedRandom[9876];
specs[n_]:=Table[With[{g=RandomChoice[{"H","S",SuperDagger["S"],"X","Y","Z","V",SuperDagger["V"],"CNOT","CZ","SWAP"}],w=RandomSample[Range[n],2]},g->If[MemberQ[{"CNOT","CZ","SWAP"},g],w,First[w]]],{25}];
checks=Table[With[{sp=specs[n]},With[{u=Fold[dense[#2,n].#1&,IdentityMatrix[2^n],sp],p=PauliStabilizer[n]["ApplyCircuit",sp]},With[{d=p["Dagger"]},And[RootReduce[ConjugateTranspose[u].u]===IdentityMatrix[2^n],And@@Table[With[{gen=embed[PauliMatrix[If[r<=n,1,3]],Mod[r-1,n]+1,n]},RootReduce[row[p,r]-u.gen.ConjugateTranspose[u]]===ConstantArray[0,{2^n,2^n}]&&RootReduce[row[d,r]-ConjugateTranspose[u].gen.u]===ConstantArray[0,{2^n,2^n}]],{r,2 n}]]]]],{n,{2,3,4}},{trial,4}];
Echo[checks,"Independent entangling forward/inverse dense checks"];
boundaries=Table[With[{sp=specs[n],p=PauliStabilizer[n]},With[{a=p["ApplyCircuit",sp],b=Fold[#1[#2]&,canon[p],sp]},same[a,b]&&same[a, p["ApplyCircuit",Take[sp,10]]["ApplyCircuit",Drop[sp,10]]]&&PauliStabilizerQ[a]&&Developer`PackedArrayQ[First[a]["GeneratorX"]]]],{n,{31,32,61,62,63,124,125,1024}}];
Echo[boundaries,"Large boundary resident/scalar/split checks"];
p=PauliStabilizer[2]["ApplyCircuit",specs[2]];
variables=Array[bit,4];
sym=PauliStabilizer[<|"Tableau"->p["Tableau"],"Signs"->1-2 variables|>];
symbolicChecks=Table[With[{a=sym[g,j],b=sym["H",j][If[g==="V","S",SuperDagger["S"]],j]["H",j]},a["Tableau"]===b["Tableau"]&&And@@Table[(a["Signs"]/.Thread[variables->bits])===(b["Signs"]/.Thread[variables->bits]),{bits,Tuples[{0,1},4]}]],{g,{"V",SuperDagger["V"]}},{j,2}];
Echo[symbolicChecks,"V supported symbolic binary-sign assignment equivalence"];
Echo[$MessageList,"Messages"];
Exit[];
