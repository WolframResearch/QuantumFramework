PacletDirectoryLoad["/private/tmp/qf-stabilizer-pre-coldfix/QuantumFramework"];
Needs["Wolfram`QuantumFramework`"];
Needs["Wolfram`QuantumFramework`PackageScope`"];
makeSpecs[n_,m_]:=Table[With[{j=Mod[37 i,n]+1},Switch[Mod[i,7],0,"H"->j,1,"S"->j,2,"CNOT"->{j,Mod[j,n]+1},3,"CZ"->{j,Mod[j,n]+1},4,"X"->j,5,"SWAP"->{j,Mod[j,n]+1},6,SuperDagger["S"]->j]],{i,m}];
prof[name_,f_]:=With[{trials=Table[ClearSystemCache[]; First[AbsoluteTiming[f[]]],{11}]}, Echo[<|"Name"->name,"Median"->Median[trials],"Range"->MinMax[trials]|>]];
p=PauliStabilizer[128]; specs=Flatten[ConstantArray[makeSpecs[128,1000],10],1];
gates=encodeStabilizerGates[specs]; applyCompiledFold[p,gates];
dispatch=ToExpression[First[Names["*`$stabilizerEncodeDispatch"]]];
rows=Replace[specs,dispatch,{1}]; flat=Catenate[rows];
raw[s_]:=With[{rs=Replace[s,dispatch,{1}]},If[FreeQ[rs,$Failed,{1}],Developer`ToPackedArray[Catenate[rs]],$Failed]];
prof["Hash",Function[Hash[specs]]];
prof["Dispatch",Function[Replace[specs,dispatch,{1}]]];
prof["FreeQ",Function[FreeQ[rows,$Failed,{1}]]];
prof["Catenate",Function[Catenate[rows]]];
prof["ToPacked",Function[Developer`ToPackedArray[flat]]];
prof["RawOldEncoding",Function[raw[specs]]];
prof["ColdEncoding",Function[stabilizerClearCaches[]; encodeStabilizerGates[specs]]];
prof["WarmEncoding",Function[encodeStabilizerGates[specs]]];
prof["MatchGateShape",Function[MatchQ[gates,{{_Integer,_Integer,_Integer}..}]]];
prof["WireValidation",Function[Module[{c=gates[[All,1]],a=gates[[All,2]],b=gates[[All,3]]},Min[a,b]<0 || Max[a,b]>=128 || MemberQ[Pick[a-b,Unitize[(c-3)(c-4)],0],0]]]];
prof["PreparedEvolution",Function[applyCompiledFold[p,gates]]];
prof["ColdFull",Function[stabilizerClearCaches[];p["ApplyCircuit",specs]]];
prof["WarmFull",Function[p["ApplyCircuit",specs]]];
Echo[$MessageList]; Exit[];
