repo = "/Users/mohammadb/Documents/GitHub/QuantumFramework";
PacletDirectoryLoad[repo <> "/QuantumFramework"];
Needs["Wolfram`QuantumFramework`"];
Needs["Wolfram`QuantumFramework`PackageScope`"];
target = Environment["R3_TARGET"];
$stabilizerCompileTarget = target;
SeedRandom[2026102403];
claims = <||>;
record[name_, value_] := (claims[name] = value; Echo[{name, value}]; value);
same[a_, b_] := a["Signs"] === b["Signs"] && Normal[a["Tableau"]] === Normal[b["Tableau"]];
canon[p_] := PauliStabilizer[<|"Signs" -> p["Signs"], "Tableau" -> Normal[p["Tableau"]]|>];
layouts[p_] := {canon[p], psFromPacked[psGetPacked[p]], psToGeneratorPacked[p]};
tensor[mats_] := Fold[KroneckerProduct, {{1}}, mats];
embed[m_, q_, n_] := tensor[ReplacePart[ConstantArray[IdentityMatrix[2], n], q -> m]];
one = <|"H" -> {{1,1},{1,-1}}/Sqrt[2], "S" -> {{1,0},{0,I}}, SuperDagger["S"] -> {{1,0},{0,-I}}, "X" -> PauliMatrix[1], "Y" -> PauliMatrix[2], "Z" -> PauliMatrix[3], "V" -> {{1+I,1-I},{1-I,1+I}}/2, SuperDagger["V"] -> {{1-I,1+I},{1+I,1-I}}/2|>;
gate[g_ -> w_, n_] := With[{qs = Flatten[{w}]}, If[KeyExistsQ[one,g], embed[one[g], First[qs], n], With[{bits = IntegerDigits[#,2,n]& /@ Range[0,2^n-1], a=First[qs], b=Last[qs]}, If[g === "CZ", DiagonalMatrix[(-1)^(#[[a]] #[[b]])& /@ bits], With[{out = Map[If[g === "CNOT", ReplacePart[#, b -> Mod[#[[a]]+#[[b]],2]], ReplacePart[#, {a->#[[b]], b->#[[a]]}]]&,bits]}, Normal[SparseArray[Thread[Transpose[{(FromDigits[#,2]+1&)/@out,Range[2^n]}] ->1],{2^n,2^n}]]]]]]];
row[p_, j_] := With[{t=Normal[p["Tableau"]]}, p["Signs"][[j]] tensor[Replace[Transpose[{t[[1,All,j]],t[[2,All,j]]}],{{0,0}->PauliMatrix[0],{1,0}->PauliMatrix[1],{1,1}->PauliMatrix[2],{0,1}->PauliMatrix[3]},{1}]]];
zeroQ[x_] := Simplify[x] === ConstantArray[0,Dimensions[x]];
imageQ[p_, u_, n_] := And@@Map[Function[j, With[{g=embed[PauliMatrix[If[j<=n,1,3]],Mod[j-1,n]+1,n]},zeroQ[row[p,j]-u.g.ConjugateTranspose[u]]]],Range[2n]];
specs[n_, m_] := Table[With[{g=RandomChoice[Join[Keys[one],If[n>1,{"CNOT","CZ","SWAP"},{}]]],w=If[n>1,RandomSample[Range[n],2],{1}]}, g -> If[KeyExistsQ[one,g],First[w],w]],{m}];
record["VersionAndAPI", {$Version,FindFile["Wolfram`QuantumFramework`"],Context[PauliStabilizer],Context[encodeStabilizerGates],Options[PauliStabilizerApply],Attributes[compiledCliffordFold],target}];
(* Exact independent enumeration keyed by all three conjugated Paulis. *)
key[u_] := Simplify[u.#.ConjugateTranspose[u]]& /@ Rest[PauliMatrix /@ Range[0,3]];
cliffords = FixedPoint[DeleteDuplicatesBy[Join[#,Catenate[Function[item,({one[#].First[item],Append[Last[item],#->1]}& /@ {"H","S"})]/@#]],key[First[#]]&]&,{{IdentityMatrix[2],{}}}];
record["All24Count",Length[cliffords]];
record["All24ForwardInverseDense",AllTrue[cliffords,Function[item, With[{u=First[item],p=PauliStabilizer[1]["ApplyCircuit",Last[item]]},AllTrue[layouts[p],imageQ[#,u,1]&&imageQ[#["Dagger"],ConjugateTranspose[u],1]&]]]]];
record["EntanglingDenseForwardInverse",And@@Flatten[Table[With[{s=Join[{"H"->1,"CNOT"->{1,2}},specs[n,35]]},With[{u=Fold[gate[#2,n].#1&,IdentityMatrix[2^n],s],p=PauliStabilizer[n]["ApplyCircuit",s]},zeroQ[ConjugateTranspose[u].u-IdentityMatrix[2^n]]&&AllTrue[layouts[p],imageQ[#,u,n]&&imageQ[#["Dagger"],ConjugateTranspose[u],n]&]]],{n,2,4},{trial,4}]]];
record["WordBoundaryExactAndProperties",And@@Map[Function[n,With[{s=specs[n,20],p=PauliStabilizer[n]},With[{b=p["ApplyCircuit",s],a=Fold[#1[#2]&,canon[p],s]},same[a,b]&&AllTrue[layouts[b],Function[l,And@@Map[l[#]===b[#]&,{"Qubits","Qudits","GeneratorCount","Signs","Matrix","TableauPhase","Stabilizers","Destabilizers"}]]]]]],{1,2,30,31,32,61,62,63,123,124,125,1024}]];
record["SymbolicBinaryPhaseAll64",With[{p=PauliStabilizer[3]["ApplyCircuit",specs[3,40]],s=specs[3,35],vars=Array[r3bit,6]},With[{sym=PauliStabilizer[<|"Tableau"->p["Tableau"],"Signs"->1-2vars|>]},With[{e=sym["ApplyCircuit",s],inv=sym["Inverse"]},And@@Map[Function[bits,With[{rules=Thread[vars->bits]},same[canon[e/.rules],canon[sym/.rules]["ApplyCircuit",s]]&&same[canon[inv/.rules],canon[sym/.rules]["Inverse"]]]],Tuples[{0,1},6]]]]]];
record["MeasurementAndFrameFallback",With[{p=PauliStabilizer[3]["ApplyCircuit",{"H"->1,"CNOT"->{1,2},"CNOT"->{2,3}}]},With[{sm=p["SymbolicMeasure",{1,2}],frames=p["ApplyCircuit",{"T"->1,"H"->2,"V"->3}]},AllTrue[sm["SampleOutcomes",25],ConcretePauliStabilizerQ]&&StabilizerFrameQ[frames]&&And@@(Keys[#["M",1]]===Keys[p["M",1]]& /@layouts[p])]]];
(* Intercept native entry: malformed input never executes machine code. *)
probe[a_Association] := Module[{p=PauliStabilizer[a],calls=0,out},out=Catch[Block[{compiledCliffordFold=Function[Null,calls++;Throw["native",r3Native]]},p["ApplyCircuit",{"H"->1}]],r3Native];{PauliStabilizerQ[p],psConcreteFastQ[p],calls,Head[out],Keys[First[p]]}];
record["MalformedRejected",AllTrue[Catenate[Map[Function[p,With[{a=First[p]},Join[Append[a,#->99]& /@{"Qubits","Qudits","GeneratorCount"},{Append[a,"Signs"->{}]}]]],layouts[PauliStabilizer[3]]]],Take[probe[#],3]==={False,False,0}&]];
record["MissingSignsConstructorMetadata",With[{t=PauliStabilizer[3]["Tableau"]},probe[<|"Tableau"->t,"Qubits"->99|>]]];
record["MissingSignsConstructorMixedStorage",With[{p=PauliStabilizer[3]},probe[KeyDrop[Join[First[p],<|"Tableau"->p["Tableau"]|>],"Signs"]]]];
record["MutationDropsValidity",AllTrue[layouts[PauliStabilizer[3]],Function[p,Module[{bad=p},bad[[1,"Signs"]]={};!PauliStabilizerQ[bad]&&!psConcreteFastQ[bad]]]]];
record["PlanCache",Module[{qc1=QuantumCircuitOperator[{"H"->1}],qc2=QuantumCircuitOperator[{"X"->1}],a,b},stabilizerClearCaches[];a=stabilizerExecutionPlan[qc1];Wolfram`QuantumFramework`GateMatrix`PackagePrivate`$stabilizerCircuitMemo[Hash[qc2]]={qc1,a};b=stabilizerExecutionPlan[qc2];b=!=a&&qc2[PauliStabilizer[1]]["Stabilizers"]==={"-Z"}&&First[Wolfram`QuantumFramework`GateMatrix`PackagePrivate`$stabilizerCircuitMemo[Hash[qc2]]]===qc2]];
record["EncodingCache",Module[{s1={"H"->1},s2={"S"->2},a,b},stabilizerClearCaches[];a=encodeStabilizerGates[s1];$stabilizerEncodeMemo[Hash[s2]]={s1,a};b=encodeStabilizerGates[s2];b==={{1,1,0}}&&First[$stabilizerEncodeMemo[Hash[s2]]]===s2]];
record["CacheBoundsClearRecompute",Module[{before,after,first=QuantumCircuitOperator[{"H"->1}],plan},stabilizerClearCaches[];Scan[(stabilizerExecutionPlan[QuantumCircuitOperator[{"H"->#}]];encodeStabilizerGates[{"S"->#}])&,Range[40]];before={Length[Wolfram`QuantumFramework`GateMatrix`PackagePrivate`$stabilizerCircuitMemo],Length[$stabilizerEncodeMemo]};plan=stabilizerExecutionPlan[first];stabilizerClearCaches[];after={Length[Wolfram`QuantumFramework`GateMatrix`PackagePrivate`$stabilizerCircuitMemo],Length[$stabilizerEncodeMemo]};Max[before]<=16&&after==={0,0}&&stabilizerExecutionPlan[first]===plan]];
reports=Map[Function[name,Module[{r=TestReport[repo<>"/Tests/Stabilizer/"<>name<>".wlt"]},With[{v=<|"File"->name,"Outcomes"->Counts[#["Outcome"]&/@r["Results"]],"Failures"->Map[{#["TestID"],#["Outcome"],#["ActualOutput"],#["ActualMessages"]}&,Select[r["Results"],#["Outcome"]=!="Success"&]]|>},Echo[v];v]]],{"ExecutionContracts","CompiledEvolution","InversePhase"}];
record["CompiledKernelShape",{Head[compiledCliffordFold],Developer`PackedArrayQ[encodeStabilizerGates[{"V"->1}]],Dimensions[compiledCliffordFold[{{1}},{{2}},{0},{3},{{0,0,0}}]]}];
Export["/private/tmp/stabilizer-r3-independent-"<>target<>".json",<|"Claims"->Map[ToString[#,InputForm]&,claims],"Reports"->Map[ToString[#,InputForm]&,reports],"Messages"->ToString[$MessageList,InputForm]|>,"RawJSON"];
Echo[{"DONE",target,ToString[$MessageList,InputForm]}];
Exit[];
