phase = Environment["QF_VERIFY_PHASE"];
repo = If[phase === "before", "/private/tmp/qf-stabilizer-before", "/Users/mohammadb/Documents/GitHub/QuantumFramework"];
PacletDirectoryLoad[FileNameJoin[{repo,"QuantumFramework"}]];
Needs["Wolfram`QuantumFramework`"];
Needs["Wolfram`QuantumFramework`PackageScope`"];
Echo[<|"Phase"->phase,"Version"->$Version,"LoadedFile"->FindFile["Wolfram`QuantumFramework`"]|>];
records=<||>;
measure[name_,f_]:=Module[{trials},f[];trials=Table[ClearSystemCache[];First[AbsoluteTiming[f[]]],{5}];AssociateTo[records,name-><|"Seconds"->trials,"Median"->Median[trials]|>];Echo[name->records[name]]];
makeSpecs[n_,m_] := Table[With[{j=Mod[37 i,n]+1}, Switch[Mod[i,7],0,"H"->j,1,"S"->j,2,"CNOT"->{j,Mod[j,n]+1},3,"CZ"->{j,Mod[j,n]+1},4,"X"->j,5,"SWAP"->{j,Mod[j,n]+1},6,SuperDagger["S"]->j]],{i,m}];
makeCircuit[s_] := QuantumCircuitOperator[<|"Elements" -> (FromCircuitOperatorShorthand /@ s), "Label" -> None|>];
PauliStabilizer[2]["ApplyCircuit",{"H"->1}];
Scan[Function[n,Module[{p=PauliStabilizer[n],small,long,blocks,qc,qcs},small=makeSpecs[n,1000];long=Flatten[ConstantArray[small,10],1];blocks=Partition[long,1000];qc=makeCircuit[small];qcs=ConstantArray[qc,10];
measure["Direct10000/n"<>ToString[n],Function[p["ApplyCircuit",long]]];
measure["ColdDirect10000/n"<>ToString[n],Function[stabilizerClearCaches[];p["ApplyCircuit",long]]];
measure["Split10/n"<>ToString[n],Function[Fold[#1["ApplyCircuit",#2]&,p,blocks]]];
measure["PublicWarm1000/n"<>ToString[n],Function[qc[p]]];
measure["PublicCold1000/n"<>ToString[n],Function[stabilizerClearCaches[];qc[p]]];
measure["PublicSplit10/n"<>ToString[n],Function[Fold[#2[#1]&,p,qcs]]];
With[{evolved=p["ApplyCircuit",long]},measure["Materialize/n"<>ToString[n],Function[evolved["Tableau"]]];Echo[<|"Storage"->n,"Bytes"->ByteCount[evolved]|>]];
]],{128,1024}];
With[{p=PauliStabilizer[128],long=Insert[makeSpecs[128,10000],"V"->1,5000]},measure["OneV10001/n128",Function[p["ApplyCircuit",long]]]];
Export["/private/tmp/stabilizer-independent-timing-r1-"<>phase<>".json",<|"Phase"->phase,"Version"->$Version,"Rows"->records,"Messages"->ToString[$MessageList,InputForm]|>,"RawJSON"];
Echo[<|"Done"->True,"Messages"->ToString[$MessageList,InputForm]|>];
Exit[];
