PacletDirectoryLoad["/Users/mohammadb/Documents/GitHub/QuantumFramework/QuantumFramework"];
Needs["Wolfram`QuantumFramework`"];
Needs["Wolfram`QuantumFramework`PackageScope`"];
Get["/private/tmp/coldfix-old-dispatch.wl"];
refEncode[specs_List] := With[{r=Replace[specs,refEncodeDispatch,{1}]},If[FreeQ[r,$Failed,{1}],Developer`ToPackedArray[Catenate[r]],$Failed]];
SeedRandom[991541];
sg={"H","S",SuperDagger["S"],"X","Y","Z","V",SuperDagger["V"]};
wires=Join[Range[-3,10],{-2^100,-2^63,2^63,2^100}];
singles=Catenate[Map[Function[g,Catenate[Map[Function[w,{g->w,g->{w},{g,w}}],wires]]],sg]];
pairs=Tuples[Take[wires,8],2];
twos=Catenate[Map[Function[g,Catenate[Map[Function[w,{g->w,Prepend[w,g]}],pairs]]],{"CNOT","CX","CZ","SWAP"}]];
controls=Catenate[Map[Function[g,Catenate[Map[Function[w,{"C"[g->{w[[2]]},{w[[1]]}],"C"[g->{w[[2]]},{w[[1]]},{}]}],pairs]]],{"NOT","X","Z"}]];
bad={"T"->1,"Unknown"->1,"H"->1.,"S"->a,"H"->{},"CNOT"->{1},"SWAP"->{1,2,3},{"H"},{{"H",1}}};
specs=Join[singles,twos,controls,bad];
small=And@@Map[Function[s,encodeStabilizerGates[{s}]===refEncode[{s}]],specs];
large=And@@Table[With[{s=RandomChoice[Join[singles,twos,controls],1000]},encodeStabilizerGates[s]===refEncode[s]],{10}];
empty=encodeStabilizerGates[{}]===refEncode[{}];
unknownResult=PauliStabilizer[3]["ApplyCircuit",{"H"->1,"Unknown"->1,"S"->2}];
malformedResult=PauliStabilizer[3]["ApplyCircuit",{"H"->1.}];
out=<|"Version"->$Version,"SingletonCases"->Length[specs],"SingletonExact"->small,"TenMixed1000Exact"->large,"EmptyExact"->empty,"UnknownFails"->(unknownResult===$Failed),"MalformedFails"->(malformedResult===$Failed),"EncoderMemoCount"->Length[$stabilizerEncodeMemo]|>;
Echo[out];Export["/private/tmp/coldfix-independent-encoder.json",out,"RawJSON"];
Exit[If[And[small,large,empty,unknownResult===$Failed,malformedResult===$Failed],0,1]];
