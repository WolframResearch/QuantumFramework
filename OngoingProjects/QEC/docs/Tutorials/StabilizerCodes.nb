     RowBox[{"QECDetectorModel", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Circuit\>\"", ",", " ", 
         RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", "1", ",", "\n", 
       "        ", 
       RowBox[{"\"\<Extraction\>\"", " ", "->", 
        " ", "\"\<Transversal\>\""}]}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"dem", "[", "\"\<DetectorMatrix\>\"", "]"}]}], ";", " ", 
    RowBox[{"o", " ", "=", " ", 
     RowBox[{"dem", "[", "\"\<ObservableMatrix\>\"", "]"}]}], ";", " ", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"dem", "[", "\"\<HeraldMatrix\>\"", "]"}]}], ";", "\n", "    ", 
    RowBox[{"keep", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "d", "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"h", "[", 
           RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "===", " ", "0"}], " ",
         "&"}]}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"grouped", " ", "=", " ", 
     RowBox[{"GroupBy", "[", 
      RowBox[{"keep", ",", " ", 
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], ",", " ", 
       RowBox[{
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"o", "[", 
            RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", "#"}],
          "]"}], " ", "&"}]}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<accepted faults\>\"", " ", "->", " ", 
       RowBox[{"Length", "[", "keep", "]"}]}], ",", " ", 
      RowBox[{"\"\<signatures\>\"", " ", "->", " ", 
       RowBox[{"Length", "[", "grouped", "]"}]}], ",", "\n", "      ", 
      RowBox[{"\"\<ambiguous\>\"", " ", "->", " ", 
       RowBox[{"Count", "[", 
        RowBox[{"grouped", ",", " ", 
         RowBox[{"alt_", " ", "/;", " ", 
          RowBox[{
           RowBox[{"Length", "[", "alt", "]"}], " ", ">", " ", "1"}]}]}], 
        "]"}]}]}], "|>"}]}]}], "]"}]], "Input",
