Cell[TextData[{
 "From ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["C", "TI"], "3"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "455ea632-3d4d-f0d3-7365-387cb4f9c239"],
 " on the set is no longer a group, so the test checks the image of every \
Pauli, not only the generators, as the book warns after eq. 13.3."
}], "Text",ExpressionUUID->"1f0fb95c-030e-c889-4534-3106b6b89ad3"],

Cell["Putting the gadgets together: FT(C)", "Section",ExpressionUUID->"16268eae-a572-7912-3fdd-270bcc074878"],

Cell[TextData[{
 "Every gadget so far has been built and checked on its own. Definition 10.6 \
is the instruction for spending them all at once. Take an ideal circuit ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "346a0e1a-2221-987e-5c69-a04457d5eb44"],
 ", replace each of its qubits with a ",
 StyleBox["block",
  FontWeight->"Bold"],
 " of the code, replace each of its locations with the corresponding gadget, \
and after every preparation, gate and storage gadget put an ",
 StyleBox["error correction gadget",
  FontWeight->"Bold"],
 " on each block involved \[LongDash] never after a measurement gadget, \
because its output is classical and classical circuits are assumed not to \
fail."
}], "Text",ExpressionUUID->"366be24c-537a-43bb-5e68-0416660f1181"],

Cell[TextData[{
 Cell[BoxData["QECFaultTolerantCircuit"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "501b1457-1a1d-907b-0038-8e119fa9e341"],
 " is that substitution. Here is a four-location circuit \[LongDash] prepare \
two logical qubits, Hadamard one, CNOT them, measure both \[LongDash] made \
fault tolerant on the seven-qubit code:"
}], "Text",ExpressionUUID->"291c68e0-f532-6cdd-5f23-81cdfcc73627"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECFaultTolerantCircuit", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<R\>\"", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<R\>\"", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<H\>\"", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<CNOT\>\"", ",", " ", "1", ",", " ", "2"}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"\"\<M\>\"", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<M\>\"", ",", " ", "2"}], "}"}]}], "}"}], ",", "\n", 
    "    ", 
    RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}]}], "]"}], 
  "[", "\"\<Gadgets\>\"", "]"}]], "Input",
 CellLabel->
  "In[110]:= ",ExpressionUUID->"5c29c458-c353-7b98-05d6-de05f6e649e2"],

