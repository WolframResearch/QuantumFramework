Cell[TextData[{
 "And half is not none. The five-qubit code has no transversal ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27c3fefb-2ee6-8038-4df0-f7a54a90d302"],
 " and no transversal ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60d4995f-bb7f-b80c-10eb-11193e0b0b56"],
 ", but it does have the cyclic Clifford ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["X", "TI"], "\[Rule]", 
    StyleBox["Y", "TI"], "\[Rule]", 
    StyleBox["Z", "TI"], "\[Rule]", 
    StyleBox["X", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64608bbe-760c-8af3-0c1f-22f803bed8d9"],
 ", which is ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09661063-a2cf-675e-3f1d-8a4cd77a4da4"],
 " followed by ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5561d787-26b0-8d0a-031e-cee1534ad450"],
 ":"
}], "Text",ExpressionUUID->"0fea91e8-e80e-a1ed-35e9-08b589b8f337"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"five", " ", "=", " ", 
      RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}]}], ",", " ", "g"}], 
    "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"QECTransversalGate", "[", 
      RowBox[{"five", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<S\>\"", ",", " ", "\"\<H\>\""}], "}"}]}], "]"}]}], ";", 
    "\n", "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<H alone\>\"", " ", "->", " ", 
       RowBox[{
        RowBox[{"QECTransversalGate", "[", 
         RowBox[{"five", ",", " ", "\"\<H\>\""}], "]"}], 
        "[", "\"\<TransversalQ\>\"", "]"}]}], ",", "\n", "      ", 
      RowBox[{"\"\<S then H\>\"", " ", "->", " ", 
       RowBox[{"g", "[", "\"\<TransversalQ\>\"", "]"}]}], ",", "\n", "      ", 
      RowBox[{"\"\<its logical action\>\"", " ", "->", " ", 
       RowBox[{"g", "[", "\"\<LogicalAction\>\"", "]"}]}]}], "|>"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[84]:= ",ExpressionUUID->"37725419-c8bf-c4cd-5d02-4e42e94bae17"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"H alone\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"S then H\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"its logical action\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\<\"X\"\>", ",", "1"}], "}"}], "\[Rule]", "\<\"-Y\"\>"}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\<\"Z\"\>", ",", "1"}], "}"}], "\[Rule]", "\<\"-X\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[84]= ",ExpressionUUID->"6eee5857-8f9d-bf63-1696-52112a290249"]
}, Open  ]],

Cell["\<\
Which is the useful form of a statement people usually shorten to \"the \
five-qubit code has no transversal gates\". It has a different set of them, \
and asking is one call.\
\>", "Text",ExpressionUUID->"2635f536-2fc9-ab3c-4fca-ed704a7df606"],

Cell["\<\
Between two blocks the question has the CNOT as its answer. The previous \
section checked that modulo sign; here the phases are carried, and two more \
gates come free with the same symmetry:\
\>", "Text",ExpressionUUID->"1b3760e9-4a32-92b2-4acd-79b36fc4e098"],

