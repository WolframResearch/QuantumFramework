  "Out[47]= ",ExpressionUUID->"16b00368-b832-202d-3e4f-9b3239c77377"]
}, Open  ]],

Cell[TextData[{
 "That is why the result is an object rather than a number. A pseudothreshold \
compares one level of encoding against none, at one point of the noise space, \
for one decoder; sec. 14.7.6's own example is a pseudothreshold lying ",
 StyleBox["outside", "TI"],
 " the true threshold surface. The object carries the polynomial it came \
from, the code, noise, decoder, rounds and extraction, and says what it is \
not:"
}], "Text",ExpressionUUID->"06d00634-a672-f252-2eef-9871d304c0b8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ps", "[", "\"\<Caveats\>\"", "]"}]], "Input",
 CellLabel->
  "In[48]:= ",ExpressionUUID->"05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"A pseudothreshold is not a threshold: it compares one level of \
encoding against none, at one point of the noise space, and can lie outside \
the true threshold surface (Got26 sec. 14.7.6).\"\>", 
   ",", "\<\"It belongs to this code, this noise model and this decoder; \
change any of them and the number changes.\"\>"}], "}"}]], "Output",
 CellLabel->
  "Out[48]= ",ExpressionUUID->"583a98af-415b-100e-09d9-110970ee6354"]
}, Open  ]],

