Cell["\<\
The check outcomes are heralds, not syndrome bits \[LongDash] a nonzero one \
means discard the attempt \[LongDash] which is why the logical error rate \
carries an acceptance alongside it when a gadget post-selects.\
\>", "Text",ExpressionUUID->"19c80315-d7de-7125-4ff7-9b5ee26b400f"],

Cell["Fault-tolerant measurement of a Pauli", "Section",ExpressionUUID->"6fdf78a7-59a9-97d9-15e5-7101585dfd23"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"QECPauliMeasurement", "[", 
   RowBox[{"code", ",", " ", "P"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a87483f-bfa4-2eb6-2abd-62793a51749c"],
 " spends the cat. One attempt applies the transversal controlled-",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09b26917-59e6-8729-3f41-81515f90ea73"],
 " and reads the eigenvalue out with a Hadamard transform, so the ",
 StyleBox["parity of the weight", "TI"],
 " of the measured string is the answer; the whole gadget repeats that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["t", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "521ad179-838d-ce9b-0239-c923363994e1"],
 " times with a fresh cat each time and takes the majority (Theorem 12.1)."
}], "Text",ExpressionUUID->"136d7364-bcfb-8461-4113-6b4e348fef4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"QECPauliMeasurement", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", 
       " ", "\"\<ZZZZZ\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"m", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Weight\>\"", ",", " ", "\"\<Repetitions\>\"", ",", 
       " ", "\"\<CatQubits\>\"", ",", " ", "\"\<Qubits\>\"", ",", 
       " ", "\"\<Measurements\>\"", ",", " ", "\"\<Heralds\>\""}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[63]:= ",ExpressionUUID->"2b78534b-7a52-d624-5918-4b157fe4bd0e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Weight\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"Repetitions\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"CatQubits\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"6", ",", "7", ",", "8", ",", "9", ",", "10"}], "}"}]}], ",", 
   RowBox[{"\<\"Qubits\"\>", "\[Rule]", "11"}], ",", 
   RowBox[{"\<\"Measurements\"\>", "\[Rule]", "15"}], ",", 
   RowBox[{"\<\"Heralds\"\>", "\[Rule]", "6"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[63]= ",ExpressionUUID->"30c454b2-bdb8-e427-60fc-4dfc3432cf0d"]
}, Open  ]],

Cell[TextData[{
 "The number the construction exists for, against the bare-ancilla circuit \
measuring the ",
 StyleBox["same", "TI"],
 " operator. ",
 Cell[BoxData["\"\<DataWeights\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6879dfe8-0276-0c7b-1806-d6b2b7035741"],
 " is the residual weight on the data over every single fault the gadget \
admits, and it is a conditional statement in two ways that the property \
handles rather than hides: only runs the cat checks ",
 StyleBox["accept", "TI"],
 " are counted, and the residual is read modulo ",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cc522fa-6a93-e579-24fa-bba40f27cc43"],
 ", because ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["X", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["m", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b82e386-6ff5-c0ee-09b1-fae009819234"],
 " stabilises the cat and so a pattern and its complement leave the same \
physical state."
}], "Text",ExpressionUUID->"34a39a2f-b372-ffce-5c50-1388c604c514"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"QECPauliMeasurement", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", 
       " ", "\"\<XZZXI\>\"", ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", 
   "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", "[", "\"\<TransversalQ\>\"", "]"}], ",", " ", 
     RowBox[{"m", "[", "\"\<DataWeights\>\"", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[64]:= ",ExpressionUUID->"66ca9132-7812-8248-0ec9-097c79a4d092"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[64]= ",ExpressionUUID->"023b1c4a-5b09-a8c9-33d8-96145ebdfa13"]
}, Open  ]],

Cell["\<\
One fault, one data error \[LongDash] where the same generator measured with \
one shared bare ancilla leaves four. That is the hook error gone, in the \
units the section above priced it in.\
\>", "Text",ExpressionUUID->"29a4f364-fd74-7ca4-5f5b-eb41f401468e"],

Cell[TextData[{
 "What repetition does ",
 StyleBox["not", "TI"],
 " fix is the honest boundary, and the gadget says so. If the codeword \
already carries an error ",
 Cell[BoxData[
  FormBox[
   StyleBox["E", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47740231-7fc8-4299-6d0b-a47b7a7d10e3"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], 
    StyleBox["P", "TI"], "\[LongEqual]", "-", 
    StyleBox["P", "TI"], 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1af52337-5e42-c8c3-4a8a-bb715bf49a29"],
 ", every repetition reads the flipped eigenvalue alike and the majority is \
confidently wrong \[LongDash] \"no matter how many times we repeat it\" (\
\[Section]12.1.4). So ",
 Cell[BoxData["\"\<MeasurementCorrectQ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fdb82dc-2353-e9b3-55f8-1b8656e7bb99"],
 " is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5782d92f-a790-094a-7db1-d088d2255b90"],
 " until an error-correction sub-gadget is spliced between repetitions, and \
",
 Cell[BoxData["\"\<OpenAssumptions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05d48452-325d-a277-33eb-1e1c47e9f15d"],
 " names what is still assumed:"
}], "Text",ExpressionUUID->"087ffcf6-194e-431e-3804-f5b098fb2e64"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"QECPauliMeasurement", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", 
       " ", "\"\<IZIZIZI\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", "[", "\"\<MeasurementCorrectQ\>\"", "]"}], ",", " ", 
     RowBox[{"m", "[", "\"\<ErrorCorrection\>\"", "]"}], ",", " ", 
     RowBox[{"m", "[", "\"\<OpenAssumptions\>\"", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[65]:= ",ExpressionUUID->"615fadf7-df9a-5675-1764-44b0da2f3d5f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "None", ",", 
   RowBox[{
   "{", "\<\"No error correction is spliced between repetitions, so a data \
error anticommuting with the measured Pauli defeats every repetition alike \
(Got26 sec. 12.1.4). The gadget handles ancilla faults only.\"\>", "}"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[65]= ",ExpressionUUID->"5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"]
}, Open  ]],

Cell["Steane error correction", "Section",ExpressionUUID->"2d0df906-1ebb-1081-5b32-f1609b4e62eb"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"QECErrorCorrection", "[", "code", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519a4e0d-3467-bfb9-07ba-6057bd130583"],
 " is the gadget that fills that slot. It is CSS-only, and for a reason \
rather than by restriction: the construction runs on transversal CNOT being \
the logical CNOT."
}], "Text",ExpressionUUID->"3a891815-8c00-cf41-6ab6-925f25ba95ab"],

Cell[TextData[{
 "Two halves. The bit-flip half puts an ancilla block in encoded ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "+"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dbacffa-31b0-43f6-3b59-e6a4404511dc"],
 " and runs transversal CNOT from data to ancilla \[LongDash] on the encoded \
states ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["CNOT",
     FontSlant->"Plain"], "|", "\[Psi]", "\[RightAngleBracket]", 
    RowBox[{"|", "+"}], "\[RightAngleBracket]", "\[LongEqual]", "|", "\[Psi]",
     "\[RightAngleBracket]", 
    RowBox[{"|", "+"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "196a859c-b643-c1b3-4f69-1cd9c3f79399"],
 ", so nothing happens logically, but the gate still copies bit flips into \
the ancilla where measuring them is harmless. The phase half uses encoded ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "0"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c8a383-1e42-ef31-78f7-3aed9bf4b21b"],
 ", the CNOT the other way, and a transversal Hadamard so the same ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50735439-04fd-dee7-0001-4e63ac89a4cd"],
 "-basis readout sees phase errors."
}], "Text",ExpressionUUID->"3597ba8d-914b-928f-63ac-33d720ffe0d5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ec", " ", "=", " ", 
     RowBox[{"QECErrorCorrection", "[", 
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "]"}]}], "}"}], ",",
    "\n", "    ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"ec", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DataQubits\>\"", ",", " ", "\"\<AncillaQubits\>\"", ",", 
       " ", "\"\<Qubits\>\"", ",", " ", "\"\<Measurements\>\"", ",", 
       " ", "\"\<TransversalQ\>\""}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[66]:= ",ExpressionUUID->"056fda38-a5bc-2884-3314-dc65cc497aee"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"DataQubits\"\>", "\[Rule]", "7"}], ",", 
   RowBox[{"\<\"AncillaQubits\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "8", ",", "9", ",", "10", ",", "11", ",", "12", ",", "13", ",", "14"}], 
     "}"}]}], ",", 
   RowBox[{"\<\"Qubits\"\>", "\[Rule]", "14"}], ",", 
   RowBox[{"\<\"Measurements\"\>", "\[Rule]", "14"}], ",", 
   RowBox[{"\<\"TransversalQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[66]= ",ExpressionUUID->"383c4a9f-130c-f8c1-69c4-63d9a6beca2b"]
}, Open  ]],

Cell[TextData[{
 "Why this gadget and not Shor EC: \[Section]12.3.3 asks whether Steane EC \
needs repeating and answers no, because the errors are ",
 StyleBox["additive",
  FontWeight->"Bold"],
 ". The measured classical error is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["e", "TI"], "+", 
    StyleBox["f", "TI"], "+", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b649e79-a2e1-7610-291b-1022d6945d7a"],
 " \[LongDash] the true data error, the ancilla's, and the measurement's \
\[LongDash] so correcting by it leaves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "+", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09cb884c-5fc8-b209-3fc8-22165a620153"],
 ", and \"a single-qubit error in the ancilla can only produce a single-qubit \
error in the final state. This is in contrast to Shor EC, where a single \
ancilla error changing one bit of the error syndrome could totally change the \
error we deduce.\""
}], "Text",ExpressionUUID->"376c6589-bcca-29e8-5d14-7cd3357f7b32"],

Cell["\<\
That is a claim to check rather than quote, and the gadget reports both \
halves of the answer:\
\>", "Text",ExpressionUUID->"667bb688-7420-22c7-0e18-2fd27dd5702d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ec", " ", "=", " ", 
     RowBox[{"QECErrorCorrection", "[", 
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "]"}]}], "}"}], ",",
    "\n", "    ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"ec", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<RepetitionsNeeded\>\"", ",", " ", "\"\<DataWeights\>\"", ",",
        " ", "\"\<PreparationDataWeights\>\""}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[67]:= ",ExpressionUUID->"72002252-da4c-5210-223f-c41fdff9217a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"RepetitionsNeeded\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"DataWeights\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}], ",", 
   RowBox[{"\<\"PreparationDataWeights\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[67]= ",ExpressionUUID->"084561a7-5440-aaee-387b-78015dfaf834"]
}, Open  ]],

Cell[TextData[{
 "One fault in the interaction leaves one data error. One fault in the \
ancilla ",
 StyleBox["preparation",
  FontWeight->"Bold"],
 " leaves up to four, because that preparation is still the code's \
non-fault-tolerant encoder. The split is the open assumption made \
quantitative, and ",
 Cell[BoxData["\"\<OpenAssumptions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "721e71e5-9ca7-ded5-2226-68cf1553a43f"],
 " states it in words."
}], "Text",ExpressionUUID->"0a84e7eb-55e0-1894-3abb-feb563956afe"],

Cell[TextData[{
 "Splicing it in completes the structure Theorem 12.1 asks for. The composed \
gadget still leaves one data error per fault, and inherits the sub-gadget's \
open assumption rather than hiding it behind that ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3261920b-7b77-02d6-621e-14557e02503c"],
 ":"
}], "Text",ExpressionUUID->"4ebe3b2c-9c8f-bd2d-7645-b376153b0477"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], 
       "[", "\"\<LogicalZ\>\"", "]"}], "]"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"QECPauliMeasurement", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", "p"}], 
       "]"}], "[", "\"\<MeasurementCorrectQ\>\"", "]"}], ",", "\n", "     ", 
     RowBox[{
      RowBox[{"QECPauliMeasurement", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", "p", ",",
         " ", 
        RowBox[{"\"\<ErrorCorrection\>\"", " ", "->", 
         " ", "\"\<Steane\>\""}]}], "]"}], "[", "\"\<MeasurementCorrectQ\>\"",
       "]"}], ",", "\n", "     ", 
     RowBox[{
      RowBox[{"QECPauliMeasurement", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", "p", ",",
         " ", 
        RowBox[{"\"\<ErrorCorrection\>\"", " ", "->", 
         " ", "\"\<Steane\>\""}]}], "]"}], "[", "\"\<DataWeights\>\"", 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[68]:= ",ExpressionUUID->"7d6a0058-fb4a-caff-2b69-9a05fefc98c5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True", ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[68]= ",ExpressionUUID->"41d92934-9aba-8299-77e6-c17e1f4cd0e3"]
}, Open  ]],

Cell["\<\
And the CSS restriction is enforced rather than documented. The five-qubit \
code can have a cat measurement, since that works for any code, but not \
Steane error correction:\
\>", "Text",ExpressionUUID->"5cc23ff5-bf0f-f019-04f1-b6bf3abbc363"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QECErrorCorrection", "[", 
  RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], "]"}]], "Input",
 CellLabel->
  "In[69]:= ",ExpressionUUID->"29880975-91f0-008f-5fb7-a13f278552d5"],

Cell[BoxData["$Failed"], "Output",
 CellLabel->
  "Out[69]= ",ExpressionUUID->"551c00cf-fc58-99c4-0323-99a8f5d2eb2e"]
}, Open  ]],

Cell["Handing the rate machinery a different extraction", "Section",ExpressionUUID->"22235db8-54be-42b7-53d1-54e25d4b109d"],

Cell[TextData[{
 "Everything above measures the bare-ancilla circuit, because that is the \
circuit ",
 Cell[BoxData["QECDetectorModel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0976d5ae-737d-f257-3f0d-cc080609c0bd"],
 " and ",
 Cell[BoxData["QECLogicalErrorRate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13e711b4-4d78-4d68-419c-88fe640d17b2"],
 " route through. ",
 Cell[BoxData["\"\<Extraction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fd09d86-aea1-a602-65ef-14e3cb550d68"],
 " is the option that changes it, and it is on both:"
}], "Text",ExpressionUUID->"2f6c0922-6605-ed68-5513-a08c13b1b7b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECDetectorModel", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<Circuit\>\"", ",", " ", 
      RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", "1", ",", "\n", "    ", 
    RowBox[{"\"\<Extraction\>\"", " ", "->", " ", "\"\<Transversal\>\""}]}], 
   "]"}], "[", "\"\<Faults\>\"", "]"}]], "Input",
 CellLabel->
  "In[70]:= ",ExpressionUUID->"2caab86a-2af9-b1b1-54a9-32344e8d039b"],

Cell[BoxData["624"], "Output",
 CellLabel->
  "Out[70]= ",ExpressionUUID->"7f56169e-4783-4dbb-256d-8fd872361781"]
}, Open  ]],

Cell[TextData[{
 "Only half the fault-tolerant construction can cross over, and the reason is \
worth stating because it is a property of the formalism rather than of the \
implementation. ",
 StyleBox["A detector error model is a matrix",
  FontWeight->"Bold"],
 ": the effect of a set of faults is the XOR of their rows, and the exact \
fold, the decoder table and the Stim export all rest on that. Theorem 12.1's \
gadget takes a ",
 StyleBox["majority",
  FontWeight->"Bold"],
 " over ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["t", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b84d4d6-858d-5842-09bb-cd902c382aa8"],
 " repetitions, and majority is not linear, so it cannot sit inside a \
detector model at all."
}], "Text",ExpressionUUID->"67558936-e5eb-8680-0d6a-2173939fecea"],

Cell[TextData[{
 "What can is ",
 StyleBox["transversality",
  FontWeight->"Bold"],
 " \[LongDash] which is the half that fixes the hook error anyway, repetition \
never having been what cured it. A cat readout's syndrome bit is the ",
 StyleBox["parity", "TI"],
 " of its ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1072dc7c-f7d5-c74e-4001-d6398261ad94"],
 " bits (eqs. 12.1\[Dash]12.3), and parity is linear. Repetition then stays \
where it already was, across rounds, handled by the detectors. So ",
 Cell[BoxData["\"\<Transversal\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3462f0a3-098c-f6b3-5c11-e90da83edc99"],
 " is not a weaker ",
 Cell[BoxData["\"\<FaultTolerant\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04cac1af-436c-9192-2cc9-d809761ee3f8"],
 "; it is the composition the detector formalism admits, and therefore the \
one whose rate can be computed."
}], "Text",ExpressionUUID->"63be94f2-239e-9b81-1145-0dbc5628e9eb"],

Cell[TextData[{
 "What that buys, counted the same way the section above counted it. With the \
bare ancilla, 288 faults collapse onto 71 detector signatures of which 29 \
carry conflicting logical effects. With a transversal extraction \[LongDash] ",
 StyleBox["more than twice as many fault locations",
  FontWeight->"Bold"],
 " \[LongDash] 624 faults collapse onto 72 signatures of which only 4 do:"
}], "Text",ExpressionUUID->"5a3d7a71-218e-1995-0bc3-7c3b503b6bff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "ambiguity", "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{
     RowBox[{"ambiguity", "[", "dem_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"dem", "[", "\"\<DetectorMatrix\>\"", "]"}]}], ",", " ", 
         RowBox[{"o", " ", "=", " ", 
          RowBox[{"dem", "[", "\"\<ObservableMatrix\>\"", "]"}]}], ",", " ", 
         "grouped"}], "}"}], ",", "\n", "        ", 
       RowBox[{
        RowBox[{"grouped", " ", "=", " ", 
         RowBox[{"GroupBy", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "d", "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"d", "[", 
             RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], ",", " ", 
           RowBox[{
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"o", "[", 
                RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
              "#"}], "]"}], " ", "&"}]}], "]"}]}], ";", "\n", "        ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<faults\>\"", " ", "->", " ", 
           RowBox[{"Length", "[", "d", "]"}]}], ",", " ", 
          RowBox[{"\"\<signatures\>\"", " ", "->", " ", 
           RowBox[{"Length", "[", "grouped", "]"}]}], ",", "\n", "          ", 
          RowBox[{"\"\<ambiguous\>\"", " ", "->", " ", 
           RowBox[{"Count", "[", 
            RowBox[{"grouped", ",", " ", 
             RowBox[{"alt_", " ", "/;", " ", 
              RowBox[{
               RowBox[{"Length", "[", "alt", "]"}], " ", ">", " ", "1"}]}]}], 
            "]"}]}]}], "|>"}]}]}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"Dataset", " ", "@", " ", 
     RowBox[{"<|", "\n", "        ", 
      RowBox[{
       RowBox[{"\"\<bare ancilla\>\"", " ", "->", " ", 
        RowBox[{"ambiguity", "[", 
         RowBox[{"QECDetectorModel", "[", 
          RowBox[{
           RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
           RowBox[{"QECNoiseModel", "[", 
            RowBox[{"\"\<Circuit\>\"", ",", " ", 
             RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", "1"}], "]"}], 
         "]"}]}], ",", "\n", "        ", 
       RowBox[{"\"\<transversal\>\"", " ", "->", " ", 
        RowBox[{"ambiguity", "[", 
         RowBox[{"QECDetectorModel", "[", 
          RowBox[{
           RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
           RowBox[{"QECNoiseModel", "[", 
            RowBox[{"\"\<Circuit\>\"", ",", " ", 
             RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", "1", ",", "\n", 
           "            ", 
           
           RowBox[{"\"\<Extraction\>\"", " ", "->", 
            " ", "\"\<Transversal\>\""}]}], "]"}], "]"}]}]}], "|>"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[71]:= ",ExpressionUUID->"3a0f2024-2f71-09ca-6a34-b98e4a045b10"],

