Cell[TextData[{
 "That is the restriction ",
 Cell[BoxData["QECErrorCorrection"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "766f3dde-6e6e-8ae3-1e14-b4980b18d8c9"],
 " enforces, seen at its source rather than at the gadget that inherits it."
}], "Text",ExpressionUUID->"7acff19c-f8f8-c05b-2af4-e8d9f97292a1"],

Cell[TextData[{
 "One detail worth keeping, because it is what makes the group test the one \
that decides. On the five-qubit code the ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"36bb0aa4-099e-3511-5e58-a30ea8289c7b"],
 StyleBox[" half of the action still comes out right",
  FontWeight->"Bold"],
 " \[LongDash] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fab4322-7f5b-c123-15a9-5a8c7aef9009"],
 " does map to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "1"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "559c0528-76f1-864e-03a3-9d720285ec94"],
 ", exactly as a CNOT would. Only the ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c3b3e9a-7f95-6e09-75d8-b7c47a203553"],
 " half breaks:"
}], "Text",ExpressionUUID->"7b834648-1855-f17e-29b1-581299e1c044"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"reg5", " ", "=", " ", 
      RowBox[{"QECRegister", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", "2"}], 
       "]"}]}], ",", " ", "act", ",", " ", "x", ",", " ", "z", ",", " ", 
     "prod"}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"act", " ", "=", " ", 
     RowBox[{"reg5", "[", 
      RowBox[{"\"\<LogicalAction\>\"", ",", " ", "1", ",", " ", "2"}], 
      "]"}]}], ";", "\n", "    ", 
    RowBox[{"x", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"QECPauli", "[", "#", "]"}], "[", "\"\<String\>\"", "]"}], 
        " ", "&"}], ")"}], " ", "/@", " ", 
      RowBox[{
       RowBox[{"reg5", "[", "\"\<LogicalVectors\>\"", "]"}], "[", "\"\<X\>\"",
        "]"}]}]}], ";", "\n", "    ", 
    RowBox[{"z", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"QECPauli", "[", "#", "]"}], "[", "\"\<String\>\"", "]"}], 
        " ", "&"}], ")"}], " ", "/@", " ", 
      RowBox[{
       RowBox[{"reg5", "[", "\"\<LogicalVectors\>\"", "]"}], "[", "\"\<Z\>\"",
        "]"}]}]}], ";", "\n", "    ", 
    RowBox[{
     RowBox[{"prod", "[", 
      RowBox[{"s1_", ",", " ", "s2_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"QECPauli", "[", "s1", "]"}], " ", "**", " ", 
        RowBox[{"QECPauli", "[", "s2", "]"}]}], ")"}], "[", "\"\<String\>\"", 
      "]"}]}], ";", "\n", "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Z half behaves\>\"", " ", "->", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"act", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Z\>\"", ",", " ", "2", ",", " ", "1"}], "}"}], "]"}], 
         " ", "===", " ", 
         RowBox[{"prod", "[", 
          RowBox[{
           RowBox[{"z", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"z", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ")"}]}], ",", "\n", 
      "      ", 
      RowBox[{"\"\<X half behaves\>\"", " ", "->", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"act", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<X\>\"", ",", " ", "1", ",", " ", "1"}], "}"}], "]"}], 
         " ", "===", " ", 
         RowBox[{"prod", "[", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"x", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ")"}]}]}], "|>"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[100]:= ",ExpressionUUID->"6aa15cf4-f328-f435-1a5f-55b186c2df1f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Z half behaves\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"X half behaves\"\>", "\[Rule]", "False"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[100]= ",ExpressionUUID->"1fa3178e-7287-38be-4550-8ee807338a84"]
}, Open  ]],

Cell["\<\
Checking the logical action alone would have passed half the time and been \
wrong.\
\>", "Text",ExpressionUUID->"33c53063-afff-c489-61fa-aa4cc98baed3"],

Cell["The gates a code gives you for free", "Section",ExpressionUUID->"08d8bcb3-70a4-55b3-38e7-35fd01513f99"],

Cell[TextData[{
 "A code that can only remember is half a code. Chapter 11 asks the other \
half: which gates can act on the encoded qubit ",
 StyleBox["without", "TI"],
 " letting one fault spread inside a block? For a stabilizer code the \
question turns out to be one about symmetry. Apply the same one-qubit gate ",
 Cell[BoxData[
  FormBox[
   StyleBox["U", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20e38226-5aed-155d-5090-1b805e987fa7"],
 " to every qubit of the block, separately. If that map sends the stabilizer \
group to itself, the gate is a valid gadget \[LongDash] and whatever it then \
does to ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["X", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "160727ef-d1b8-0069-3e3c-bec8e04d52b3"],
 " and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "261df1b1-b81e-57af-4e22-e8fb39ab3df5"],
 " is the logical gate you have performed."
}], "Text",ExpressionUUID->"00ba9d2f-c328-50fc-3059-1488f6dd22c6"],

Cell[TextData[{
 Cell[BoxData["QECTransversalGate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02964792-f196-8b6e-32ae-5edf8020d9b4"],
 " asks both halves and answers with the second. The Hadamard on the \
seven-qubit code:"
}], "Text",ExpressionUUID->"166d4e5f-4333-9385-3e13-601976c7e1ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECTransversalGate", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", 
    " ", "\"\<H\>\""}], "]"}], "[", "\"\<LogicalAction\>\"", "]"}]], "Input",
 CellLabel->
  "In[101]:= ",ExpressionUUID->"1c99ee20-d785-d362-44a6-078de231be48"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\<\"X\"\>", ",", "1"}], "}"}], "\[Rule]", "\<\"Z\"\>"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\<\"Z\"\>", ",", "1"}], "}"}], "\[Rule]", "\<\"X\"\>"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[101]= ",ExpressionUUID->"60858f89-56d8-6615-10ba-26d3636d4d7f"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["X", "TI"], "_"], "\[Rule]", 
    OverscriptBox[
     StyleBox["Z", "TI"], "_"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e45545e-c429-efe4-567b-4e1bedddb5ce"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "\[Rule]", 
    OverscriptBox[
     StyleBox["X", "TI"], "_"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24564246-a2b2-7a9b-4c6e-6423d74748e1"],
 ": the transversal Hadamard is the logical Hadamard (eq. \
11.18\[Dash]11.19)."
}], "Text",ExpressionUUID->"273d1382-afb1-09c0-4ec2-8aefca445b2a"],

Cell[TextData[{
 "Now ask the same of ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39c9e52f-ed06-87fb-6ff6-fc8884b0edc1"],
 ", and the answer is not the one the name suggests:"
}], "Text",ExpressionUUID->"46be6341-4be3-06d9-6e46-7b2b6d966c23"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"QECTransversalGate", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", 
       " ", "\"\<S\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<logical action\>\"", " ", "->", " ", 
      RowBox[{"s", "[", "\"\<LogicalAction\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<logical gate\>\"", " ", "->", " ", 
      RowBox[{"s", "[", "\"\<LogicalGate\>\"", "]"}]}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[102]:= ",ExpressionUUID->"352b8971-1d3f-d4c9-6328-213b94cbbe13"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"logical action\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\<\"X\"\>", ",", "1"}], "}"}], "\[Rule]", "\<\"-Y\"\>"}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\<\"Z\"\>", ",", "1"}], "}"}], "\[Rule]", "\<\"Z\"\>"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"logical gate\"\>", "\[Rule]", "\<\"Sdg\"\>"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[102]= ",ExpressionUUID->"227c7e4b-1c68-aac8-5204-70159502f812"]
}, Open  ]],

Cell[TextData[{
 StyleBox["One minus sign, and it is a different gate.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["X", "TI"], "_"], "\[Rule]", "-", 
    OverscriptBox[
     StyleBox["Y", "TI"], "_"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cd9b5a9-dbed-51da-14e6-2cf2dd982320"],
 " with ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4becebe3-5bfe-fac0-7993-02cd5d88c82a"],
 " fixed is the action of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "\[Dagger]"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "312d182f-c6c7-5e1e-60d2-9188f3722564"],
 ", not of ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1449d45f-8382-90b9-3c76-ce193634e283"],
 ". The transversal ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "444f09dd-766a-dba7-6c74-a087031ca98d"],
 " performs the ",
 StyleBox["inverse", "TI"],
 " of the gate it is built from \[LongDash] so if you want the logical ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79e9b65a-67eb-1624-2f96-2804119e7d0e"],
 " on this code, you apply the transversal ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "\[Dagger]"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "394df0e2-3b3f-7a44-6f72-e9ccbeca48ae"],
 "."
}], "Text",ExpressionUUID->"5d3de1d4-e864-19c9-04c2-f89189116b13"],

Cell["\<\
The sign is one line of Pauli algebra, and it is worth seeing on its own:\
\>", "Text",ExpressionUUID->"1adc8861-0296-99d3-4ae3-224bb720eb39"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"QECPauli", "[", "\"\<XXXXXXX\>\"", "]"}], " ", "**", " ", 
    RowBox[{"QECPauli", "[", "\"\<ZZZZZZZ\>\"", "]"}]}], ")"}], 
  "[", "\"\<String\>\"", "]"}]], "Input",
 CellLabel->
  "In[103]:= ",ExpressionUUID->"47f3727e-1788-b883-6d81-7438a2220ae9"],

Cell[BoxData["\<\"iYYYYYYY\"\>"], "Output",
 CellLabel->
  "Out[103]= ",ExpressionUUID->"02bfa0ec-e0fe-2fa7-3244-39c9908b758d"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["X", "TI"], "_"], 
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "\[LongEqual]", 
    StyleBox["i", "TI"], " ", 
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     RowBox[{"\[CircleTimes]", "7"}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cc1833e-1ead-5711-24fe-1b789b583a7b"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["Y", "TI"], "_"], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    OverscriptBox[
     StyleBox["X", "TI"], "_"], 
    OverscriptBox[
     StyleBox["Z", "TI"], "_"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cb4236e-91b2-9328-644b-bb482044fe72"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     RowBox[{"\[CircleTimes]", "7"}]], "\[LongEqual]", "-", 
    OverscriptBox[
     StyleBox["Y", "TI"], "_"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "631da35c-735e-7e3b-1122-3b0606eb4501"],
 " (eq. 11.22). Seven copies of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Y", "TI"], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    StyleBox["X", "TI"], 
    StyleBox["Z", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44b7daea-ed84-b50e-6c4c-d3b784361c54"],
 " do not give the logical ",
 Cell[BoxData[
  FormBox[
   StyleBox["Y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39f2334d-24de-3dcb-6f81-ab174d688711"],
 "; they give minus it."
}], "Text",ExpressionUUID->"1ec600b7-0050-8550-46fd-99f1b1eaefba"],

Cell[TextData[{
 "This is the one place in the layer where a sign carries the answer. \
Everywhere else \[LongDash] the Pauli frame, the detector model, the whole \
memory experiment \[LongDash] conjugation modulo sign was enough, and the \
frame propagator drops phases for good reasons. Here a sign-blind conjugation \
reports \"S\" and is wrong, so this file carries the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z",
     FontSlant->"Plain"], "4"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33bfe66e-cd59-d601-6144-f84be4edbd6b"],
 " phase through every step and asks membership of a routine that knows a \
generator's true phase."
}], "Text",ExpressionUUID->"6a3ee8c1-8740-e1ad-1bc5-01ab32fab3f7"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "\[Dagger]"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33885b0f-111a-0c54-6188-5369a0af56be"],
 " is not an accident of ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c9080a8-67dd-9047-04af-19f21269e2ad"],
 ". The transversal ",
 Cell[BoxData[
  FormBox[
   StyleBox["U", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2abc9d06-0494-496b-5a43-1560ad211bb1"],
 " performs the logical ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["U", "TI"], "*"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43e301a0-76bb-1057-7190-980a034e62bd"],
 ", the complex conjugate, which is visible across the whole one-qubit gate \
set at once:"
}], "Text",ExpressionUUID->"1ae06f2b-7109-3ba5-4a9f-877500bd898f"],

Cell[CellGroupData[{

