Cell[TextData[{
 "It also refuses to answer the wrong question. On the bare-ancilla \
extraction the rate starts at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"32", 
    StyleBox["p", "TI"], "/", "15"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60049622-f570-0e0e-103b-0f8ffc055554"],
 ", so encoding hurts at low noise; the polynomial still crosses ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40ea559d-da93-7842-70ea-4cc6df264aa8"],
 " further up, but that is where encoding ",
 StyleBox["starts", "TI"],
 " to help, not where it stops, and it is reported as a crossing, not as the \
pseudothreshold:"
}], "Text",ExpressionUUID->"23ccc6ee-92c0-e596-51f3-dfc8277acffc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ps", " ", "=", " ", 
     RowBox[{"QECPseudothreshold", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Circuit\>\"", ",", " ", "p"}], "]"}], ",", " ", 
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
    "\n", "    ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<value\>\"", " ", "->", " ", 
      RowBox[{"ps", "[", "\"\<Value\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<low-noise ratio\>\"", " ", "->", " ", 
      RowBox[{"ps", "[", "\"\<LowNoiseRatio\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<crossings\>\"", " ", "->", " ", 
      RowBox[{"N", "[", 
       RowBox[{"ps", "[", "\"\<Crossings\>\"", "]"}], "]"}]}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[50]:= ",ExpressionUUID->"114d8d02-b276-9c05-4772-256fc700e76f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"value\"\>", "\[Rule]", 
    RowBox[{"Missing", "[", "\<\"EncodingDoesNotHelp\"\>", "]"}]}], ",", 
   RowBox[{"\<\"low-noise ratio\"\>", "\[Rule]", 
    FractionBox["32", "15"]}], ",", 
   RowBox[{"\<\"crossings\"\>", "\[Rule]", 
    RowBox[{"{", "0.8159979885440253`", "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[50]= ",ExpressionUUID->"2dc22b63-32d1-862f-5bf1-c34d4765ed75"]
}, Open  ]],

Cell[TextData[{
 "A threshold ",
 StyleBox["surface", "TI"],
 " in this layer's terms is the same question along rays: give the noise with \
one free rate in a fixed direction \[LongDash] say two-qubit gates at ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36ea7e2c-072a-2221-5eea-7076b2df710b"],
 " and everything else at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], " ", 
    StyleBox["p", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b23761c-2477-64e8-0ad1-68464d024e32"],
 " \[LongDash] and map over the direction. Each ray is one root. It is still \
a pseudothreshold surface, one level against none, and is labelled as one."
}], "Text",ExpressionUUID->"73216bcf-7cf1-61ac-22de-82a9748433f6"],

Cell["The code as quantum operations", "Section",ExpressionUUID->"69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],

Cell["\<\
Everything so far has been symplectic: rows, syndromes, cosets. The same code \
is also a set of ordinary quantum objects \[LongDash] an encoding isometry, a \
code-space projector, a syndrome measurement, recovery channels, and one \
effective channel on the logical qubit \[LongDash] and those are what the \
rest of the framework composes with. The code gives them directly.\
\>", "Text",ExpressionUUID->"409bca18-cbd6-e54d-70b8-ec45ee60cf97"],

Cell[TextData[{
 "The encoder is the isometry ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b62b5f-1d3f-f012-404d-c31994cbc378"],
 " from the logical qubit into the physical ones:"
}], "Text",ExpressionUUID->"79984792-c453-565a-2fb8-5edfede63ca0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], "[", "\"\<Encoder\>\"",
   "]"}]], "Input",
 CellLabel->
  "In[51]:= ",ExpressionUUID->"1d45428e-8fa1-6801-4b7b-5be82a543b6b"],

