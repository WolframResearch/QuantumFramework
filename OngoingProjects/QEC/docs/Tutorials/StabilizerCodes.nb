Cell[TextData[{
 "Two of those rows are worth pointing at. The ",
 StyleBox["storage",
  FontWeight->"Bold"],
 " gadget is block 2 waiting while block 1 gets its Hadamard: a wait is a \
location, the book's storage gadget is \"just putting a wait location for all \
physical qubits in the code\", and it earns an error correction gadget like \
any other. It emits no instructions and it costs \[LongDash] which is the \
difference between an honest overhead and a count of typed-out gates. And \
there are ",
 StyleBox["six",
  FontWeight->"Bold"],
 " corrections, not four: one per live block per layer, stopping when the \
block is measured."
}], "Text",ExpressionUUID->"06c25578-1780-b25e-2ef2-4d22a23a00a4"],

Cell["\<\
Definition 10.6 also defines what that costs, in three ratios, so they are \
properties rather than something you assemble yourself:\
\>", "Text",ExpressionUUID->"5f70617e-b140-9f95-0500-793bc0fae5ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECFaultTolerant", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<R\>\"", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<R\>\"", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<H\>\"", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<CNOT\>\"", ",", " ", "1", ",", " ", "2"}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"\"\<M\>\"", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<M\>\"", ",", " ", "2"}], "}"}]}], "}"}], ",", "\n", 
    "    ", 
    RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}]}], "]"}], 
  "[", "\"\<Overheads\>\"", "]"}]], "Input",
 CellLabel->
  "In[87]:= ",ExpressionUUID->"79d0371a-30a6-04e5-2fef-af4441536ecf"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Size\"\>", "\[Rule]", "263"}], ",", 
   RowBox[{"\<\"Qubits\"\>", "\[Rule]", "14"}], ",", 
   RowBox[{"\<\"Depth\"\>", "\[Rule]", 
    FractionBox["77", "4"]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[87]= ",ExpressionUUID->"7d950d76-dd18-2b24-2baa-a533d4ad760e"]
}, Open  ]],

Cell[TextData[{
 "Seven locations become 1841. Fourteen physical qubits per logical one \
\[LongDash] seven for the block and seven for its own error-correction \
workspace, one workspace per block so that the corrections of a layer run in \
parallel rather than queueing. And nineteen and a quarter times the depth. \
Those are the numbers a fault-tolerance threshold has to beat, and they are \
why the threshold is a statement about ",
 StyleBox["rates", "TI"],
 " rather than about counts."
}], "Text",ExpressionUUID->"7234a9f4-3232-6781-23cb-40be47c74deb"],

Cell[TextData[{
 "Now the detail that makes this more than bookkeeping. The gadget for a \
logical ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42668d78-f434-72a4-721d-2525fdc1408e"],
 " is ",
 StyleBox["not",
  FontWeight->"Bold"],
 " the transversal ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c7cc198-0ad8-2426-3403-d8c2af528f0c"],
 ":"
}], "Text",ExpressionUUID->"69698b1d-3dc2-3628-1f16-2347b4749d72"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", " ", "@", " ", 
  RowBox[{"Map", "[", 
   RowBox[{"First", ",", "\n", "    ", 
    RowBox[{
     RowBox[{"QECFaultTolerant", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<R\>\"", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<S\>\"", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}]}], "]"}], "[", 
     RowBox[{"\"\<GadgetInstructions\>\"", ",", " ", "\"\<Gate\>\""}], 
     "]"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[88]:= ",ExpressionUUID->"701e1eb7-eeba-61c8-2025-97f08b4f3312"],

Cell[BoxData[
 RowBox[{"{", "\<\"Sdg\"\>", "}"}]], "Output",
 CellLabel->
  "Out[88]= ",ExpressionUUID->"0e322415-281a-3695-37c1-be5f49ac9cff"]
}, Open  ]],

Cell[TextData[{
 "Asked for a logical ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61beb272-ef15-9663-1745-343f8aa1fd49"],
 ", the assembler emitted a transversal ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "\[Dagger]"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e8a6a96-06b4-6465-0689-83d0b3414f4f"],
 " \[LongDash] because that is the word whose ",
 StyleBox["logical action", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55951090-ef25-ccfd-03aa-89dd8ad196c7"],
 ", as the previous section measured. It never emits \"the transversal \
version of the gate it was asked for\"; it asks which word performs the \
requested logical gate. A protocol assembled by name would compute the \
complex conjugate of the intended circuit and look perfectly healthy doing \
it, and on the engine the difference is visible: assembled properly the \
encoded qubit ends in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53a2ca13-da2c-324e-0151-ec5cdfde8094"],
 " eigenstate of ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Y", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5930221d-821b-4026-08cf-c44737ae130c"],
 ", and assembled by name in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76ba63e9-5df8-c241-1e5a-7ab3547290ab"],
 " eigenstate."
}], "Text",ExpressionUUID->"319e51f9-a9ce-1d21-67a6-48a2c87b640b"],

Cell[TextData[{
 "The classical side is tracked too. The logical bit of a measurement gadget \
is the parity of a few of its outcomes, and those outcomes sit in a record \
otherwise full of error-correction syndromes, so a decoder has to be told ",
 StyleBox["where", "TI"],
 ":"
}], "Text",ExpressionUUID->"26f4962c-805e-a216-4e8b-087631e8f17c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ft", " ", "=", " ", 
     RowBox[{"QECFaultTolerant", "[", "\n", "        ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<R\>\"", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<R\>\"", ",", " ", "2"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<H\>\"", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<CNOT\>\"", ",", " ", "1", ",", " ", "2"}], "}"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"\"\<M\>\"", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<M\>\"", ",", " ", "2"}], "}"}]}], "}"}], ",", "\n", 
       "        ", 
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}]}], "]"}]}], "}"}], 
   ",", "\n", "    ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<measurements in the whole circuit\>\"", " ", "->", " ", 
      RowBox[{"ft", "[", "\"\<Measurements\>\"", "]"}]}], ",", "\n", "      ", 
     RowBox[{"\"\<the ones that make logical qubit 1\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"ft", "[", "\"\<Readouts\>\"", "]"}], "[", "1", "]"}]}]}], 
    "|>"}]}], "]"}]], "Input",
 CellLabel->
  "In[89]:= ",ExpressionUUID->"313d5a7b-7caf-7acc-60c3-5c25755a4816"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"measurements in the whole circuit\"\>", "\[Rule]", "98"}], ",", 
   RowBox[{"\<\"the ones that make logical qubit 1\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"86", ",", "88", ",", "90"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[89]= ",ExpressionUUID->"2da78195-91be-94f0-5b5c-18df2048feda"]
}, Open  ]],

Cell[TextData[{
 "Three outcomes out of ninety-eight, being the support of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "\[LongEqual]", 
    StyleBox["I", "TI"], 
    StyleBox["Z", "TI"], 
    StyleBox["I", "TI"], 
    StyleBox["Z", "TI"], 
    StyleBox["I", "TI"], 
    StyleBox["Z", "TI"], 
    StyleBox["I", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39c6b7ab-78e0-e73c-6ffd-2ef5789aca06"],
 " inside the seventh-last block of measurements."
}], "Text",ExpressionUUID->"3f7d0c35-7157-44bf-6502-a67f00e22e85"],

Cell[TextData[{
 "What this protocol is not, stated rather than hidden \[LongDash] ",
 Cell[BoxData[
  RowBox[{"ft", "[", "\"\<OpenAssumptions\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47b49f91-c3c7-4deb-6d4b-16daf6721731"],
 " says all three. The preparation gadget is the code's own encoder, which is \
not fault tolerant, and so are the ancillas of every correction: that is \
chapter 13's work and the same debt the error correction gadget already \
reported. The gate gadgets are transversal, so the gate set is Clifford \
\[LongDash] Definition 10.5 asks for a ",
 StyleBox["universal", "TI"],
 " set, and a circuit with a ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "064e3005-d89e-7c03-2e75-aa6ed92b4769"],
 " in it is refused rather than approximated. And corrections stay in the \
Pauli frame, so nothing in the emitted circuit is classically conditioned."
}], "Text",ExpressionUUID->"76c2caed-aea0-13a2-1ef1-e3b6cb556188"],

Cell["Handing it to Stim", "Section",ExpressionUUID->"260c3025-1fa9-9acd-4e33-a98f9a5de817"],

Cell[TextData[{
 "Stim (",
 ButtonBox["arXiv:2103.02202",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2103.02202"], None}],
 ") is the community's reference stabilizer simulator, and the source of the \
detector error model as an explicit object. The point of connecting to it \
rather than competing with it is that the two are good at different things: \
it samples fast and large, this layer derives exactly and symbolically. \
Writing the memory experiment out in its syntax buys an independent check on \
all of the above, and a path to the decoders built on top of it."
}], "Text",ExpressionUUID->"4b1e6c2c-0452-4134-7925-8676ade7101e"],

Cell[TextData[{
 "The emitted circuit encodes first \[LongDash] Stim starts in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "0"}], "\[Ellipsis]", "0", "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2982aea8-af87-65d7-5fb1-47f5ca324f3d"],
 ", which is not a codeword for a general code, and a memory experiment that \
does not start inside the code space has a meaningless first round of \
detectors \[LongDash] then runs the noisy rounds, then a noiseless one:"
}], "Text",ExpressionUUID->"19ac3a5e-0cd6-873c-4f53-bc18a560ea06"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Column", " ", "@", " ", 
  RowBox[{"Take", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"StringSplit", "[", 
     RowBox[{
      RowBox[{"QECStimCircuit", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
        RowBox[{"QECNoiseModel", "[", 
         RowBox[{"\"\<Circuit\>\"", ",", " ", 
          RowBox[{"1", "/", "200"}]}], "]"}], ",", " ", "2"}], "]"}], ",", 
      " ", "\"\<\n\>\""}], "]"}], ",", "\n", "    ", "14"}], "\n", 
   "]"}]}]], "Input",
 CellLabel->
  "In[90]:= ",ExpressionUUID->"6e8690e9-968f-68b3-16bd-09b3233a3a99"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"# 3 data qubits, 2 check ancillas, 2 noisy rounds, Z-basis memory\"\
\>"},
    {"\<\"# emitted by QECStimCircuit\"\>"},
    {"\<\"# --- encode ---\"\>"},
    {"\<\"H 1\"\>"},
    {"\<\"H 0\"\>"},
    {"\<\"CZ 1 2\"\>"},
    {"\<\"H 1\"\>"},
    {"\<\"CZ 0 1\"\>"},
    {"\<\"H 0\"\>"},
    {"\<\"# --- round 1 ---\"\>"},
    {"\<\"R 3\"\>"},
    {"\<\"X_ERROR(0.005) 3\"\>"},
    {"\<\"CX 0 3\"\>"},
    {"\<\"DEPOLARIZE2(0.005) 0 3\"\>"}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellLabel->
  "Out[90]= ",ExpressionUUID->"2b6bc1ec-c569-bd9f-5968-d8c9ec1d07e5"]
}, Open  ]],

Cell["\<\
The structure scales as it should: one detector per check per round, plus the \
final noiseless round, and a single logical observable. Three noisy rounds of \
the Steane code's six checks give four layers of six:\
\>", "Text",ExpressionUUID->"25f1a39a-81e0-db80-538e-3ac4379aa9ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"source", " ", "=", " ", 
     RowBox[{"QECStimCircuit", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Circuit\>\"", ",", " ", 
         RowBox[{"1", "/", "500"}]}], "]"}], ",", " ", "3"}], "]"}]}], "}"}], 
   ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"StringCount", "[", 
      RowBox[{"source", ",", " ", "\"\<DETECTOR\>\""}], "]"}], ",", " ", 
     RowBox[{"StringCount", "[", 
      RowBox[{"source", ",", " ", "\"\<OBSERVABLE_INCLUDE\>\""}], "]"}]}], 
    "}"}]}], "\n", "]"}]], "Input",
 CellLabel->
  "In[91]:= ",ExpressionUUID->"35466be2-b7a8-26dc-637d-82cfc2428c26"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"24", ",", "1"}], "}"}]], "Output",
 CellLabel->
  "Out[91]= ",ExpressionUUID->"58bdea72-0ba3-5f4c-0842-0c3cae562596"]
}, Open  ]],

Cell[TextData[{
 "One asymmetry is deliberate. ",
 Cell[BoxData["QECLogicalErrorRate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e8cef58-e908-949c-16b3-070588a2fee6"],
 " asks whether the decoder got the residual error's whole class right, \
covering logical ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0abc4047-6c7b-4886-3a44-5a21050e1aec"],
 " and logical ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24e21d63-fe6b-5877-4c91-954cfb1e2b5d"],
 " damage at once, because that is the right question for an unknown logical \
state. A Stim memory experiment is single-basis by construction \[LongDash] \
prepare ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"|", "0"}], 
     StyleBox["L", "TI"]], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348d2737-4aeb-e3cb-5cb2-bf716e9fb111"],
 ", keep it, measure ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2161c865-0900-0907-571e-e24fa8b5586d"],
 " \[LongDash] so the emitted circuit declares one observable and ",
 Cell[BoxData["\"\<Observable\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cadbe4b-a339-c651-6452-3014d6cdacbb"],
 " chooses which. The detector part is basis-independent, and that is where \
the two models are compared."
}], "Text",ExpressionUUID->"31169419-f57b-983b-672d-0e42fc0feb01"],

Cell[TextData[{
 "That comparison has been run. Five cases \[LongDash] three at circuit \
level, two at phenomenological, including the non-CSS five-qubit code whose \
",
 Cell[BoxData[
  FormBox[
   StyleBox["Y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40aa99e8-53bd-499c-70a9-10b266481be6"],
 " generators are the only thing exercising the square-root-of-",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d165407-aaf3-867b-0b2e-4e60ce87ed41"],
 " rotation \[LongDash] with 58 detector firing rates and 5 observable flip \
rates computed exactly here and sampled over two million shots there. \
Everything agrees within 2.7 standard errors, and PyMatching decodes every \
exported circuit unchanged, which is a second and structural check: a \
malformed circuit does not produce a detector error model that decomposes \
into a matching graph."
}], "Text",ExpressionUUID->"75cb8946-a0dc-0da7-23c8-2123d169578d"],

Cell["Where this comes from", "Section",ExpressionUUID->"63688a50-35e7-99e6-1117-2c1a4393ebcc"],

Cell[TextData[{
 "Every claim above is either computed by the package and checked against an \
independent oracle, or taken from one of these. Section numbers are \
Gottesman's 2026 ",
 StyleBox["Stabilizer Codes and Quantum Error Correction", "TI"],
 " unless the thesis is named."
}], "Text",ExpressionUUID->"12187c95-2034-8b29-4238-75df51c6d673"],

