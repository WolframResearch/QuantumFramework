Cell[TextData[{
 "One and two. That is the hook error shown to be a defect of the ",
 StyleBox["gadget", "TI"],
 " rather than a property of circuit-level noise \[LongDash] which is what \
\[Section]10.2 exists to make possible, and what the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"29", 
    StyleBox["p", "TI"], "/", "5"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30f601cf-5001-fb68-608d-98a961b5c9b2"],
 " two sections above was the price of not having."
}], "Text",ExpressionUUID->"04bc0f0b-f02f-243d-2c43-a75481db8f07"],

Cell[TextData[{
 "Two things that number is not. It is a ",
 StyleBox["post-selected",
  FontWeight->"Bold"],
 " rate, and the acceptance travels with it \[LongDash] about 0.98 at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],
 ", and the gadget reports it rather than quietly dividing it out. And it \
still rests on the ancilla preparation being clean, since the cat is built by \
a non-fault-tolerant chain and only its dangerous patterns are checked; that \
is the same chapter-13 assumption Steane EC names, and it is why the four \
ambiguous signatures existed to be conditioned away in the first place."
}], "Text",ExpressionUUID->"705e212e-f5a4-7717-2065-b88bfc515a7d"],

Cell["Several blocks, and the gate between them", "Section",ExpressionUUID->"5c2f5325-a3f6-c048-05d5-4a8ed5809292"],

Cell[TextData[{
 "Everything so far lives on one block. A ",
 Cell[BoxData["QECCode"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "211ecaf2-61ee-418f-5725-e3bc179b13d5"],
 " is ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51e4dffc-d38f-5703-079b-d6b9e63a3a69"],
 " physical qubits carrying ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30e43b5d-74af-d0fb-609b-b3077d5ba2c1"],
 " logical ones, and a circuit numbers its qubits ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[Ellipsis]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44d9380c-2e05-8f35-6ce6-b2564bb1d21f"],
 " with ancillas after \[LongDash] which is enough for a memory experiment, \
and is why the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"],
 " above could be measured without any of this. It is not enough for anything \
that computes."
}], "Text",ExpressionUUID->"138e1639-4d05-8b97-41b5-886364b1d9fd"],

Cell[TextData[{
 StyleBox["A logical qubit is a block.",
  FontWeight->"Bold"],
 " So a logical two-qubit gate is a gate between two blocks, and Theorem 13.2 \
needs ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["m", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "156728ce-0023-e03b-431c-c1a8b1d7b301"],
 " blocks for a gate touching ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"],
 " of them. ",
 Cell[BoxData["QECRegister"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26ff5c08-e081-ff27-4e85-56559135c20d"],
 " is where blocks become addressable. Block ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07c988c4-3ef2-8066-2df6-21aeba84d34c"],
 " owns qubits ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["b", "TI"], "-", "1"}], ")"}], 
    StyleBox["n", "TI"], "+", "1", "\[Ellipsis]", 
    StyleBox["b", "TI"], 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bc0a2f3-6150-447f-79ff-3bbd10e52f45"],
 ", stated once so that nothing has to guess it:"
}], "Text",ExpressionUUID->"7ac66077-3bfa-1f18-2afe-7a31bd8f6262"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"reg", " ", "=", " ", 
     RowBox[{"QECRegister", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", "2"}], 
      "]"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"reg", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Blocks\>\"", ",", " ", "\"\<BlockQubits\>\"", ",", 
       " ", "\"\<Qubits\>\"", ",", " ", "\"\<StabilizerCount\>\"", ",", 
       " ", "\"\<LogicalQubits\>\""}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[74]:= ",ExpressionUUID->"3d863d84-94ab-5643-6bbd-b4ee1d5e3ca9"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Blocks\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"BlockQubits\"\>", "\[Rule]", "7"}], ",", 
   RowBox[{"\<\"Qubits\"\>", "\[Rule]", "14"}], ",", 
   RowBox[{"\<\"StabilizerCount\"\>", "\[Rule]", "12"}], ",", 
   RowBox[{"\<\"LogicalQubits\"\>", "\[Rule]", "2"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[74]= ",ExpressionUUID->"7ab8b877-e011-189c-2a47-323091a46ae6"]
}, Open  ]],

Cell[TextData[{
 "A single-block circuit moves into a block with ",
 Cell[BoxData["\"\<Lift\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35eb0178-2238-e094-63e8-992257b2b2fe"],
 ", which touches the qubit slots and nothing else:"
}], "Text",ExpressionUUID->"0da6433d-a7a4-ba24-3b5e-5b66d256090e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECRegister", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", "2"}], 
   "]"}], "[", 
  RowBox[{"\"\<Lift\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<R\>\"", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<H\>\"", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<CNOT\>\"", ",", " ", "1", ",", " ", "2"}], "}"}]}], "}"}], 
   ",", " ", "2"}], "]"}]], "Input",
 CellLabel->
  "In[75]:= ",ExpressionUUID->"462f64f6-435d-c7dd-6fd5-7db076e9ad27"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"R\"\>", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"H\"\>", ",", "9"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "8", ",", "9"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[75]= ",ExpressionUUID->"4b06bf63-5f43-ed7c-793d-374d5af7b446"]
}, Open  ]],

Cell["\<\
A register of one block is the identity on all of it \[LongDash] same label \
matrix, same generators, same circuits \[LongDash] which is what keeps the \
rest of the layer unaffected by this existing.\
\>", "Text",ExpressionUUID->"0fd1c247-21a4-d962-35ee-e4215056a848"],

Cell[TextData[{
 "The one gate between blocks is the ",
 StyleBox["transversal CNOT",
  FontWeight->"Bold"],
 ": a CNOT applied qubit by qubit, so each qubit of one block touches exactly \
the corresponding qubit of the other and nothing else. That is the property \
that stops a single fault from spreading inside either block, and it is the \
one Steane error correction already rested on two sections ago."
}], "Text",ExpressionUUID->"09347675-9fce-c17b-38cc-683f1a789041"],

Cell["\<\
It was cited there. Here it is checked, by conjugating the logical operators \
through the gate and reading the images off:\
\>", "Text",ExpressionUUID->"2c597ed5-00d9-d535-5467-779fb16dbc1f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECRegister", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", "2"}], 
   "]"}], "[", 
  RowBox[{"\"\<LogicalAction\>\"", ",", " ", "1", ",", " ", "2"}], 
  "]"}]], "Input",
 CellLabel->
  "In[76]:= ",ExpressionUUID->"66c4d8d6-27c8-a0db-0efb-d1905262f221"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\<\"X\"\>", ",", "1", ",", "1"}], "}"}], 
    "\[Rule]", "\<\"IIXIXXIIIXIXXI\"\>"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\<\"X\"\>", ",", "2", ",", "1"}], "}"}], 
    "\[Rule]", "\<\"IIIIIIIIIXIXXI\"\>"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\<\"Z\"\>", ",", "1", ",", "1"}], "}"}], 
    "\[Rule]", "\<\"IZIZIZIIIIIIII\"\>"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\<\"Z\"\>", ",", "2", ",", "1"}], "}"}], 
    "\[Rule]", "\<\"IZIZIZIIZIZIZI\"\>"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[76]= ",ExpressionUUID->"4d3801b6-8b23-0df3-74c7-98f02ed657d9"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["X", "TI"], "_"], "1"], "\[Rule]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["X", "TI"], "_"], "1"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["X", "TI"], "_"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09816d05-11e9-fb6e-3fbe-856fa79dc9b4"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["X", "TI"], "_"], "2"], "\[Rule]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["X", "TI"], "_"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35ec423d-cde2-7917-6394-6466eb97487d"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "1"], "\[Rule]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "1"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05e0e9bc-56b1-1bf2-339f-00e6634469d8"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "2"], "\[Rule]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "1"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46408f14-a324-388b-6e7f-2751d6d68ad1"],
 " \[LongDash] which is the action of a CNOT on the logical pair."
}], "Text",ExpressionUUID->"40213c85-9219-7c2b-71de-b5ef27ac4771"],

Cell[TextData[{
 "Acting correctly on the logical operators is only half of it. The gate also \
has to map the stabilizer group to itself, or it takes the state out of the \
code space and its logical action is beside the point. For the Steane code \
none of the twelve register generators leaves the group; for the five-qubit \
code, which is not CSS, ",
 StyleBox["all eight of them do",
  FontWeight->"Bold"],
 ":"
}], "Text",ExpressionUUID->"678faed4-2cca-f411-0db4-479e457cdf7b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "images", "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{
     RowBox[{"images", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"instr", " ", "=", " ", 
          RowBox[{"r", "[", 
           RowBox[{"\"\<TransversalCNOT\>\"", ",", " ", "1", ",", " ", "2"}], 
           "]"}]}], ",", " ", 
         RowBox[{"nq", " ", "=", " ", 
          RowBox[{"r", "[", "\"\<Qubits\>\"", "]"}]}], ",", " ", "group"}], 
        "}"}], ",", "\n", "        ", 
       RowBox[{
        RowBox[{"group", " ", "=", " ", 
         RowBox[{"QECCode", "[", 
          RowBox[{"r", "[", "\"\<Generators\>\"", "]"}], "]"}]}], ";", "\n", 
        "        ", 
        RowBox[{"Count", "[", "\n", "            ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"QECPauliString", "[", "\n", "                ", 
             RowBox[{
             "Wolfram`QuantumFramework`QEC`PackageScope`registerConjugate", "[", 
              RowBox[{"instr", ",", " ", "nq", ",", " ", 
               RowBox[{"QECPauliVector", "[", "#", "]"}]}], "]"}], "\n", 
             "            ", "]"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"r", "[", "\"\<Generators\>\"", "]"}]}], ",", "\n", 
          "            ", 
          RowBox[{"g_", " ", "/;", " ", 
           RowBox[{"!", " ", 
            RowBox[{"group", "[", 
             RowBox[{"\"\<StabilizerMemberQ\>\"", ",", " ", "g"}], 
             "]"}]}]}]}], "]"}]}]}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"Dataset", " ", "@", " ", 
     RowBox[{"<|", "\n", "        ", 
      RowBox[{
       RowBox[{"\"\<Steane (CSS)\>\"", " ", "->", " ", 
        RowBox[{"images", "[", 
         RowBox[{"QECRegister", "[", 
          RowBox[{
           RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
           "2"}], "]"}], "]"}]}], ",", "\n", "        ", 
       RowBox[{"\"\<five-qubit (not CSS)\>\"", " ", "->", " ", 
        RowBox[{"images", "[", 
         RowBox[{"QECRegister", "[", 
          RowBox[{
           RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
           "2"}], "]"}], "]"}]}]}], "|>"}]}]}]}], "]"}]], "Input",
 CellLabel->
  "In[77]:= ",ExpressionUUID->"3b3cac94-919f-f08d-6ac3-45de202bc2d7"],

