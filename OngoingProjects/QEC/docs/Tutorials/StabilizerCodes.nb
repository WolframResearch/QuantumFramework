     "6944803a-8297-e066-1f7b-1a643723b34c"], Cell[
    "What fault tolerance formally requires", "TableText",ExpressionUUID->
     "7e9e495e-a796-7cd0-26a6-611bd223463a"], Cell[
    "Book \[Section]10.2", "TableText",ExpressionUUID->
     "534f7e63-03c8-ee33-0175-704db662b519"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3b07ad27-9e6a-154b-693c-44811b1f7f91"], Cell["\<\
The phenomenological model, and thresholds not being comparable across levels\
\
\>", "TableText",ExpressionUUID->"1c7a415c-3e53-b7cb-441a-5906bbe71d11"], 
    Cell["Book \[Section]10.4", "TableText",ExpressionUUID->
     "417aec05-2fbb-8238-7719-066f4a4fd102"]},
