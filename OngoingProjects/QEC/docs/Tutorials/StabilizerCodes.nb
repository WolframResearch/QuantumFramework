           Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 3} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
      "Picture" -> "Schrodinger", "Label" -> None, 
      "ParameterSpec" -> {}|>]], {{1, 2, 3}, {1}}],
  Editable->False,
  SelectWithContents->True,
  Selectable->False]], "Output",
 CellLabel->
  "Out[51]= ",ExpressionUUID->"604bb87d-3174-a116-1048-32274006f07c"]
}, Open  ]],

Cell[TextData[{
 "Its columns are the codewords, and they are stated in the code's own \
logical basis: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"|", "0"}], 
     StyleBox["L", "TI"]], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "763191a2-6f8b-197a-1fce-080c0a3e6840"],
 " is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "635fdfdb-2856-deda-1164-d68549e0a420"],
 " eigenstate of the ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],
 " that ",
 Cell[BoxData[
  RowBox[{"code", "[", "\"\<LogicalZ\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8469dd-bfc7-2a7a-04bb-80873a727940"],
 " reports, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"|", "1"}], 
     StyleBox["L", "TI"]], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],
 " the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3921e4bb-f5e4-3596-68de-fde483969ffc"],
 " one. That is not automatic. The encoding circuit of the five-qubit code \
sends ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "00000"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13db9173-5387-1c16-41f8-093d6632677c"],
 " to the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6804c0ab-fd16-b7db-183b-d9f4f4a01d21"],
 " eigenstate of that ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],
 " \[LongDash] still a valid encoder, but with its own labels \[LongDash] so \
the codewords are moved into the code's basis before they are handed out:"
}], "Text",ExpressionUUID->"4289b0c6-8043-1b93-72b6-29a031f669f9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"five", " ", "=", " ", 
     RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}]}], "}"}], ",", "\n", 
   "    ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", " ", "=", " ", 
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{"QECPauli", "[", 
          RowBox[{"First", "[", 
           RowBox[{"five", "[", "\"\<LogicalZ\>\"", "]"}], "]"}], "]"}], 
         "[", "\"\<Matrix\>\"", "]"}], "]"}]}], "}"}], ",", "\n", "        ", 
     
     RowBox[{
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "z", " ", ".", 
         " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Normal", "[", 
          RowBox[{"#", "[", "\"\<StateVector\>\"", "]"}], "]"}], " ", "&"}], 
        " ", "/@", " ", 
        RowBox[{"five", "[", "\"\<Codewords\>\"", "]"}]}], ")"}]}]}], "\n", 
    "    ", "]"}]}], "\n", "]"}]], "Input",
 CellLabel->
  "In[52]:= ",ExpressionUUID->"070f3e08-556d-9d60-2d34-b0525c19e44a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", 
   RowBox[{"-", "1"}]}], "}"}]], "Output",
 CellLabel->
  "Out[52]= ",ExpressionUUID->"6d593b15-c37a-9c59-1b66-b35ef60ce6a3"]
}, Open  ]],

Cell[TextData[{
 "The syndrome measurement is a ",
 Cell[BoxData["QuantumMeasurementOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4140e475-1e41-1f16-777f-fe3f9bf4627c"],
 " with one projector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Product]", 
     StyleBox["i", "TI"],
     LimitsPositioning->True], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       SubscriptBox[
        StyleBox["s", "TI"], 
        StyleBox["i", "TI"]]], 
      SubscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["i", "TI"]]}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67f13035-938c-831a-0d8e-aa7f263eee60"],
 " per syndrome, outcome ",
 Cell[BoxData[
  FormBox[
   StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b44e14-0404-e868-3e4c-605eadb6bab2"],
 " being the syndrome ",
 Cell[BoxData[
  RowBox[{"IntegerDigits", "[", 
   RowBox[{
    RowBox[{"i", " ", "-", " ", "1"}], ",", " ", "2", ",", " ", "m"}], "]"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],
 ". An ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e10bd94-ae42-3b4d-262f-34d1cbf48997"],
 " on the middle qubit of the bit-flip code trips both checks, syndrome ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"],
 ", the fourth outcome, with certainty \[LongDash] and the recovery for that \
syndrome puts the codeword back:"
}], "Text",ExpressionUUID->"013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"bf", " ", "=", " ", 
      RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}]}], ",", " ", 
     "zero", ",", " ", "hit"}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"zero", " ", "=", " ", 
     RowBox[{"First", "[", 
      RowBox[{"bf", "[", "\"\<Codewords\>\"", "]"}], "]"}]}], ";", "\n", 
    "    ", 
    RowBox[{"hit", " ", "=", " ", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", "\"\<IXI\>\"", "]"}], "[", "zero", 
      "]"}]}], ";", "\n", "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<syndrome\>\"", " ", "->", " ", 
       RowBox[{"bf", "[", 
        RowBox[{"\"\<Syndrome\>\"", ",", " ", "\"\<IXI\>\""}], "]"}]}], ",", 
      "\n", "      ", 
      RowBox[{"\"\<outcome probabilities\>\"", " ", "->", " ", 
       RowBox[{"Values", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"bf", "[", "\"\<SyndromeMeasurement\>\"", "]"}], "[", 
           "hit", "]"}], "[", "\"\<Probabilities\>\"", "]"}], "]"}], "]"}]}], 
      ",", "\n", "      ", 
      RowBox[{"\"\<recovered\>\"", " ", "->", " ", 
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"bf", "[", 
              RowBox[{"\"\<Recovery\>\"", ",", " ", 
               RowBox[{"{", 
                RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}], "[", 
             RowBox[{"QuantumState", "[", 
              RowBox[{"hit", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], 
             "]"}], "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], " ", "-", 
          "\n", "          ", 
          RowBox[{"Normal", "[", 
           RowBox[{"zero", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], 
         "]"}], " ", "==", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"{", 
           RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}]}]}], "|>"}]}]}], 
  "\n", "]"}]], "Input",
 CellLabel->
  "In[53]:= ",ExpressionUUID->"4b734859-75e7-efa6-7901-62030393b58c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"syndrome\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}]}], ",", 
   RowBox[{"\<\"outcome probabilities\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}]}], ",", 
   RowBox[{"\<\"recovered\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[53]= ",ExpressionUUID->"4ae31c17-eefa-a706-7a90-96508a8c0a6c"]
}, Open  ]],

Cell[TextData[{
 "These four are dense \[LongDash] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00844d77-2817-3ec6-30bc-653149a3842c"],
 "-sized \[LongDash] and stop at ",
 Cell[BoxData["$QECDenseQubitLimit"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20b97f64-b973-0c8a-5047-774e380656d0"],
 " (10 qubits by default) with a message naming the cheap route. The next one \
is not dense, and it is the one that matters."
}], "Text",ExpressionUUID->"04469009-6b02-dcc3-2c7d-0a530eb4a629"],

Cell[TextData[{
 "Encode, apply the noise, measure the syndrome, recover, decode: the whole \
cycle is one channel on the logical qubit. Taken literally that composition \
runs through a ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["4", 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],
 "-dimensional superoperator. But for Pauli noise on a stabilizer code the \
cycle's net effect is always a logical Pauli \[LongDash] the error times the \
correction lies in the normalizer \[LongDash] so the logical channel is a \
Pauli channel with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["4", 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5547dfb6-0e84-e145-037c-d6f0ab36b3af"],
 " weights, and those weights are exactly the coset probabilities the \
maximum-likelihood decoder already computes. So it comes out exact and \
symbolic:"
}], "Text",ExpressionUUID->"12b61bfc-9cd7-eca9-424d-92a61563b6f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], "[", 
  RowBox[{"\"\<LogicalPauliProbabilities\>\"", ",", " ", 
   RowBox[{"QECNoiseModel", "[", 
    RowBox[{"\"\<BitFlip\>\"", ",", " ", "p"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[54]:= ",ExpressionUUID->"451364b5-819d-fb99-7321-7dff3029c9e3"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"I\"\>", "\[Rule]", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "p"}], ")"}], "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"2", " ", "p"}]}], ")"}]}]}], ",", 
   RowBox[{"\<\"X\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", "-", 
       RowBox[{"2", " ", "p"}]}], ")"}], " ", 
     SuperscriptBox["p", "2"]}]}], ",", 
   RowBox[{"\<\"Y\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"Z\"\>", "\[Rule]", "0"}]}], "\[RightAssociation]"}]], "Output",\

 CellLabel->
  "Out[54]= ",ExpressionUUID->"13b49e24-0fb7-4441-414b-178eaa422eab"]
}, Open  ]],

Cell["\<\
and the logical error rate is nothing but one minus its identity weight \
\[LongDash] on the Steane code, to the last coefficient:\
\>", "Text",ExpressionUUID->"445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"steane", " ", "=", " ", 
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}]}], ",", " ", 
     RowBox[{"noise", " ", "=", " ", 
      RowBox[{"QECNoiseModel", "[", 
       RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}]}]}], "}"}], ",",
    "\n", "    ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"1", " ", "-", " ", 
     RowBox[{
      RowBox[{"steane", "[", 
       RowBox[{"\"\<LogicalPauliProbabilities\>\"", ",", " ", "noise"}], 
       "]"}], "[", "\"\<I\>\"", "]"}], " ", "-", " ", 
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{"steane", ",", " ", "noise"}], "]"}]}], "]"}]}], "\n", 
  "]"}]], "Input",
 CellLabel->
  "In[55]:= ",ExpressionUUID->"089aa42d-ce49-3603-38b9-3e76ebfd9d69"],

Cell[BoxData["0"], "Output",
 CellLabel->
  "Out[55]= ",ExpressionUUID->"48fccab3-b886-a0f7-7883-e3fd3930f2dd"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"code", "[", 
   RowBox[{"\"\<LogicalChannel\>\"", ",", " ", "noise"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cdaad60-2181-5e26-34f9-454a5034250c"],
 " is the same thing as a ",
 Cell[BoxData["QuantumChannel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "542cff75-84e0-b601-7dd3-f73f2c9a1d6b"],
 " on the logical qubits, ready to compose with anything else in the \
framework. It is a code-capacity object: at circuit level the checks \
themselves are noisy, the cycle is not one channel, and the rate comes from \
the detector model instead."
}], "Text",ExpressionUUID->"00dd9d4d-f7ec-565f-30e2-151681993ca5"],

Cell[TextData[{
 "Noise can be given in the framework's own terms, too. A one-qubit ",
 Cell[BoxData["QuantumChannel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],
 " that is a Pauli channel reads back as a noise model \[LongDash] its Kraus \
operators reduced to Pauli weights, then checked against the channel's \
superoperator \[LongDash] and is accepted wherever a noise model is:"
}], "Text",ExpressionUUID->"3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"QuantumChannel", "[", 
      RowBox[{"\"\<Depolarizing\>\"", "[", "q", "]"}], "]"}], "]"}], 
    "[", "\"\<Probabilities\>\"", "]"}], ",", "\n", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"QECLogicalErrorRate", "[", 
     RowBox[{
      RowBox[{"QECCode", "[", 
       RowBox[{"\"\<Repetition\>\"", ",", " ", "3"}], "]"}], ",", " ", 
      RowBox[{"QuantumChannel", "[", 
       RowBox[{"\"\<BitFlip\>\"", "[", "p", "]"}], "]"}]}], "]"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->
  "In[56]:= ",ExpressionUUID->"333832e2-8bec-4128-62c7-abcc2d991072"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{"3", " ", "q"}], "4"]}], ",", 
     FractionBox["q", "4"], ",", 
     FractionBox["q", "4"], ",", 
     FractionBox["q", "4"]}], "}"}], ",", 
   RowBox[{
    RowBox[{"3", " ", 
     SuperscriptBox["p", "2"]}], "-", 
    RowBox[{"2", " ", 
     SuperscriptBox["p", "3"]}]}]}], "}"}]], "Output",
 CellLabel->
  "Out[56]= ",ExpressionUUID->"78cf51d6-d7cd-4672-28f5-4893e2782d58"]
}, Open  ]],

Cell["\<\
A channel that is not Pauli \[LongDash] amplitude damping is the usual one \
\[LongDash] is refused with its reason rather than twirled silently: its \
effect on a stabilizer code is not a distribution over Paulis, and choosing \
to approximate it by one is a modelling decision.\
\>", "Text",ExpressionUUID->"1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],

Cell[TextData[{
 "The question under all of this \[LongDash] does the code correct this set \
of errors? \[LongDash] is the Knill\[Dash]Laflamme condition, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["W", "TI"], 
       StyleBox["i", "TI"]], "|", 
      SubsuperscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["a", "TI"], "\[Dagger]"], 
      SubscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["b", "TI"]], "|", 
      SubscriptBox[
       StyleBox["W", "TI"], 
       StyleBox["j", "TI"]]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["h", "TI"], 
     StyleBox[
      RowBox[{"a", "b"}], "TI"]], " ", 
    SubscriptBox["\[Delta]", 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "710db4a8-d877-0db2-2732-2df5d9025798"],
 ". For Pauli errors it is decided by where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["a", "TI"], "\[Dagger]"], 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e12f72-3ad4-a92f-279e-c73cbf66f875"],
 " sits: anticommuting with a check gives 0, in the stabilizer gives its \
phase, a nontrivial logical breaks the condition. So it is computed on rows, \
at any size, and the dense definition is only its test:"
}], "Text",ExpressionUUID->"06ea8612-dd18-b4f0-2ee9-185fd4921eda"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bf", " ", "=", " ", 
     RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}]}], "}"}], ",", "\n",
    "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"bf", "[", 
      RowBox[{"\"\<KnillLaflammeMatrix\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<III\>\"", ",", " ", "\"\<XII\>\"", ",", 
         " ", "\"\<IXI\>\"", ",", " ", "\"\<IIX\>\""}], "}"}]}], "]"}], ",", 
     "\n", "     ", 
     RowBox[{"bf", "[", 
      RowBox[{"\"\<KnillLaflammeMatrix\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<XII\>\"", ",", " ", "\"\<IXX\>\""}], "}"}]}], "]"}]}], 
    "}"}]}], "\n", "]"}]], "Input",
 CellLabel->
  "In[57]:= ",ExpressionUUID->"0b02f270-2101-5c3d-3931-f43a50b42707"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", 
   RowBox[{"Missing", "[", 
    RowBox[{"\<\"NotCorrectable\"\>", ",", 
     RowBox[{"\[LeftAssociation]", 
      RowBox[{
       RowBox[{"\<\"Errors\"\>", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\<\"XII\"\>", ",", "\<\"IXX\"\>"}], "}"}]}], ",", 
       RowBox[{"\<\"Product\"\>", "\[Rule]", "\<\"XXX\"\>"}]}], 
      "\[RightAssociation]"}]}], "]"}]}], "}"}]], "Output",
 CellLabel->
  "Out[57]= ",ExpressionUUID->"2d1868bf-f524-2aaf-5b27-81f8fcd178f5"]
}, Open  ]],

Cell["\<\
The failure names the pair and the logical operator their product is. Asked \
of every error up to a weight, it reads the distance off:\
\>", "Text",ExpressionUUID->"669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "[", 
    RowBox[{"\"\<CorrectableQ\>\"", ",", " ", 
     RowBox[{"\"\<Weight\>\"", "[", "t", "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[58]:= ",ExpressionUUID->"5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False"}], "}"}]], "Output",
 CellLabel->
  "Out[58]= ",ExpressionUUID->"66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"]
}, Open  ]],

Cell[TextData[{
 "These are the spellings the bosonic branch of the project uses for the same \
questions \[LongDash] ",
 Cell[BoxData["\"\<Codewords\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e73fafe-05d0-7203-6600-f3b8ac654169"],
 ", ",
 Cell[BoxData["\"\<KnillLaflammeMatrix\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],
 ", ",
 Cell[BoxData["\"\<CorrectableQ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c044c4-b778-74e1-42f0-5da1c20d5ecb"],
 " \[LongDash] so a qubit code and an oscillator code answer them alike."
}], "Text",ExpressionUUID->"3d9aa029-60a8-273a-6bb9-3a7311428a00"],

Cell["Decoders as objects", "Section",ExpressionUUID->"64adc082-4122-deff-0c52-d9ec70d4a4c5"],

Cell[TextData[{
 "The decoders behind the rate can be held. ",
 Cell[BoxData[
  RowBox[{"QECDecoder", "[", "code", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e451771-8a55-ceec-267a-8f3b2fe19436"],
 " is the minimum-weight table, ",
 Cell[BoxData[
  RowBox[{"QECDecoder", "[", 
   RowBox[{"code", ",", " ", "noise"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4670f053-f537-0b3f-6e0f-ea1cfcc25605"],
 " maximum likelihood (or, at circuit level, the detector model's decoder), \
",
 Cell[BoxData[
  RowBox[{"QECDecoder", "[", "dem", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "330aabc0-bdd5-22a3-6109-42aa34607089"],
 " the detector model's lightest-fault rule:"
}], "Text",ExpressionUUID->"38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"QECDecoder", "[", 
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "]"}]}], "}"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"d", "[", "\"\<Method\>\"", "]"}], ",", " ", 
     RowBox[{"d", "[", 
      RowBox[{"\"\<Decode\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", " ", "0", ",", " ", "0", ",", " ", "1", ",", " ", "1", ",", 
         " ", "1"}], "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[59]:= ",ExpressionUUID->"70d705b8-410a-1477-20ec-9ce270bf7f5d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"MinimumWeight\"\>", ",", "\<\"IIIIIIX\"\>"}], "}"}]], "Output",\

 CellLabel->
  "Out[59]= ",ExpressionUUID->"737c509e-bc52-eefb-2104-49d835e4b4c1"]
}, Open  ]],

Cell[TextData[{
 "The fourth constructor is the seam for everything else. ",
 Cell[BoxData[
  RowBox[{"QECDecoder", "[", 
   RowBox[{"code", ",", " ", "f"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01a44b6b-c85f-9e0e-375c-6334e9ebe554"],
 " wraps any function from a syndrome to a correction \[LongDash] PyMatching \
through ",
 Cell[BoxData["ExternalEvaluate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],
 ", a neural decoder, a lookup \[LongDash] and the rate scores it with the \
same machinery as the built-ins, through ",
 Cell[BoxData[
  RowBox[{"\"\<Decoder\>\"", " ", "->", " ", "dec"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25120901-cfbc-a8e6-5321-a16aea4efacc"],
 ". The decoder that never corrects anything, on the bit-flip code, fails \
whenever anything happened:"
}], "Text",ExpressionUUID->"3ee7491f-72c3-8814-669d-61590777db7e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"QECLogicalErrorRate", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<BitFlip\>\"", ",", " ", "p"}], "]"}], ",", "\n", "    ", 
    RowBox[{"\"\<Decoder\>\"", " ", "->", " ", 
     RowBox[{"QECDecoder", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"#", " ", "===", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}]}], ",", " ", "\"\<III\>\"", ",",
           " ", 
          RowBox[{"Missing", "[", "]"}]}], "]"}], " ", "&"}]}], "]"}]}]}], 
   "]"}], "]"}]], "Input",
 CellLabel->
  "In[60]:= ",ExpressionUUID->"67860241-8011-89c8-0dbd-a42b31a5db12"],

Cell[BoxData[
 RowBox[{"p", " ", 
  RowBox[{"(", 
   RowBox[{"3", "-", 
    RowBox[{"3", " ", "p"}], "+", 
    SuperscriptBox["p", "2"]}], ")"}]}]], "Output",
 CellLabel->
  "Out[60]= ",ExpressionUUID->"1318f44b-7a0d-b86f-4127-ee157fb90ab5"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["QECLogicalErrorRate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "221ecbfd-1ed7-d323-5225-e2a79b63be09"],
 " returns the rate and only the rate. The full report \[LongDash] the rate, \
the probability of acceptance, and the joint failure probability \[LongDash] \
is one argument away, with the same keys whether or not anything was \
post-selected:"
}], "Text",ExpressionUUID->"3f067a83-888f-4db3-653e-73ed293a1799"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QECLogicalErrorRate", "[", 
  RowBox[{
   RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
   RowBox[{"QECNoiseModel", "[", 
    RowBox[{"\"\<Depolarizing\>\"", ",", " ", 
     RowBox[{"1", "/", "10"}]}], "]"}], ",", " ", "All"}], "]"}]], "Input",
 CellLabel->
  "In[61]:= ",ExpressionUUID->"287fc527-5526-9e30-5804-dc815cd0e51a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Rate\"\>", "\[Rule]", 
    FractionBox["13147289", "113906250"]}], ",", 
   RowBox[{"\<\"Acceptance\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"Failure\"\>", "\[Rule]", 
    FractionBox["13147289", "113906250"]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[61]= ",ExpressionUUID->"2207e002-80f7-0285-523c-fa6c308250ef"]
}, Open  ]],

Cell[TextData[{
 "The detector model answers the same questions as ",
 Cell[BoxData[
  RowBox[{"dem", "[", "\"\<LogicalErrorRate\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "440467ae-8db5-79b4-6c3c-7e0824404b9e"],
 ", ",
 Cell[BoxData[
  RowBox[{"dem", "[", "\"\<Acceptance\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141585f4-d1c1-5bbd-3c2a-1cb1e0742987"],
 " and ",
 Cell[BoxData[
  RowBox[{"dem", "[", "\"\<Failure\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d27d006-86b8-9131-64dc-ca603332e01b"],
 "; they differ from the plain rate only when a gadget rejects shots, which \
is where the next sections go."
}], "Text",ExpressionUUID->"3e44340b-ef5c-51d5-667b-ae548ae9233f"],

Cell["Noisy syndrome extraction", "Section",ExpressionUUID->"321034f4-436e-dcec-622f-adbe7618a636"],

Cell["\<\
Everything so far has assumed the checks are read out perfectly. That \
assumption is the one a hardware person will not grant, and giving it up is \
what the rest of this note is about.\
\>", "Text",ExpressionUUID->"1287d3f9-6500-de4e-42bc-caa30cbaa494"],

Cell[TextData[{
 "There are three levels, and they are the same object with different keys \
set. At ",
 StyleBox["code capacity",
  FontWeight->"Bold"],
 " the data is hit between rounds and the checks are exact \[LongDash] that \
is everything above. At the ",
 StyleBox["phenomenological",
  FontWeight->"Bold"],
 " level the checks additionally lie with some probability, which is the \
first point at which repeating the measurement means anything. At ",
 StyleBox["circuit level",
  FontWeight->"Bold"],
 " there are no \"checks\" at all: the extraction is written out as a \
subcircuit and every gate, reset and readout in it can fail; faults attach to \
circuit ",
 StyleBox["locations", "TI"],
 " with one rate per location type, which is a Pauli specialisation of the \
basic model of Gottesman's \[Section]10.1.1."
}], "Text",ExpressionUUID->"3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],

Cell[TextData[{
 "Each level drops an assumption the one before it made, but they are not \
three estimates of one number, and the middle one has a name in the \
literature that is worth carrying: Gottesman's \[Section]10.4 introduces the \
phenomenological model as the standard example of an ",
 StyleBox["optimistic",
  FontWeight->"Bold"],
 " assumption, not of a more realistic one."
}], "Text",ExpressionUUID->"087f5f2f-6486-1b59-3805-56890d3369a3"],

Cell["The level is derived from what you set, not declared:", "Text",ExpressionUUID->"7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}], 
    "[", "\"\<Level\>\"", "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p", ",", " ", 
      RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "q"}]}], "]"}], 
    "[", "\"\<Level\>\"", "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<Circuit\>\"", ",", " ", "p"}], "]"}], "[", "\"\<Level\>\"", 
    "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[62]:= ",ExpressionUUID->"2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"CodeCapacity\"\>", ",", "\<\"Phenomenological\"\>", 
   ",", "\<\"Circuit\"\>"}], "}"}]], "Output",
 CellLabel->
  "Out[62]= ",ExpressionUUID->"13ecd9ee-6506-67bb-4193-d0c80cb34d81"]
}, Open  ]],

Cell["\<\
A circuit-level model puts a rate on each kind of location. One number \
spreads over all of them; an Association sets them separately, and a missing \
key is zero, which is a clean way to ask what one kind of failure does on its \
own:\
\>", "Text",ExpressionUUID->"6724c974-bdf1-27a5-0edb-e13e3b858d8f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECNoiseModel", "[", 
   RowBox[{"\"\<Circuit\>\"", ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<TwoQubit\>\"", " ", "->", " ", "p"}], ",", " ", 
      RowBox[{"\"\<Measurement\>\"", " ", "->", " ", "q"}]}], "|>"}]}], "]"}],
   "[", "\"\<Rates\>\"", "]"}]], "Input",
 CellLabel->
  "In[63]:= ",ExpressionUUID->"2b52875c-0948-9ae8-5961-1f06a8e2e832"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"OneQubit\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"TwoQubit\"\>", "\[Rule]", "p"}], ",", 
   RowBox[{"\<\"Measurement\"\>", "\[Rule]", "q"}], ",", 
   RowBox[{"\<\"Reset\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"Idle\"\>", "\[Rule]", "0"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[63]= ",ExpressionUUID->"53412643-5a68-df00-017e-b82d5f02a26a"]
}, Open  ]],

Cell["\<\
Idling is modelled but stays at zero by default, and the next section says \
why that default is optimistic rather than neutral.\
\>", "Text",ExpressionUUID->"696f5b1d-d56b-3a26-1f15-5346dc1f890c"],

Cell["The extraction circuit", "Section",ExpressionUUID->"0eb02373-2484-618c-364f-bb3d4d3133d6"],

Cell[TextData[{
 "To measure a Pauli generator with an ancilla: rotate each data qubit in the \
generator's support so that its letter there becomes ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640353f1-ff8e-e9b3-0c31-4abafa38bb99"],
 ", CNOT those data qubits into the ancilla, rotate back, and measure the \
ancilla. The ancilla ends up holding the parity of the rotated qubits, which \
is the generator's eigenvalue."
}], "Text",ExpressionUUID->"37161f66-4600-a3a8-5d2d-974073baf1f2"],

Cell[TextData[{
 "This is the circuit of Gottesman's \[Section]12.1.1, figure 12.1a, and that \
section's title is worth quoting: ",
 StyleBox["Non-Fault-Tolerant Measurement of Paulis", "TI"],
 ". The book's version puts the ancilla in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "+"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e44757e-c407-f813-567c-6d3bedb3cb79"],
 " and applies controlled-",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"],
 " from ancilla to data; conjugating each data qubit by the rotation that \
sends its letter to ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539b0e4e-9e5a-5525-01b8-a0281bef3c0f"],
 " turns that into a controlled-",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd82739-42e3-b7ed-44e7-bf6376971d37"],
 " ladder, and since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[CenterDot]", 
    StyleBox["C", "TI"], 
    StyleBox["Z", "TI"], "\[CenterDot]", 
    StyleBox["H", "TI"], "\[LongEqual]", 
    StyleBox["C", "TI"], 
    StyleBox["N", "TI"], 
    StyleBox["O", "TI"], 
    StyleBox["T", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0971a20b-7913-467e-3f0e-445578a62d44"],
 " the ancilla's Hadamards are absorbed into the ladder. Gate for gate it is \
the same circuit with the basis change written out rather than folded into \
\"controlled-",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09df342d-d743-5809-3fe4-ae76e2f62b53"],
 "\"."
}], "Text",ExpressionUUID->"0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"],

Cell[TextData[{
 "The rotation is ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21fdaace-430e-f3f9-5782-43a876b8c1c3"],
 " for an ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"],
 ", the engine's ",
 Cell[BoxData["\"\<V\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],
 " \[LongDash] the square root of ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c6bfc6-0792-5005-77fd-36a0b227236f"],
 ", which sends ",
 Cell[BoxData[
  FormBox[
   StyleBox["Y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62752e4e-571f-d961-120a-c02862aba84b"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],
 " \[LongDash] for a ",
 Cell[BoxData[
  FormBox[
   StyleBox["Y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166277e1-e8de-815f-3e12-6eca8968d3a5"],
 ", and nothing at all for a ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ae7a534-7379-468c-3a9c-3d7e060c2cd6"],
 ". A single generator carrying all three letters shows every case at once:"
}], "Text",ExpressionUUID->"34baef30-7963-b757-5c59-077a78171dbd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QECCode", "[", 
    RowBox[{"{", "\"\<XYZ\>\"", "}"}], "]"}], "[", "\"\<SyndromeCircuit\>\"", 
   "]"}], "[", "\"\<Instructions\>\"", "]"}]], "Input",
 CellLabel->
  "In[64]:= ",ExpressionUUID->"15ce0314-20ee-2b64-43f5-9b5e509b764e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"R\"\>", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"H\"\>", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"V\"\>", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "1", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"H\"\>", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Vdg\"\>", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"M\"\>", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[64]= ",ExpressionUUID->"38a9ac88-4644-6c0e-6856-45d273f13754"]
}, Open  ]],

Cell[TextData[{
 "The bit-flip code's generators are pure ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64802aa2-b136-451c-0cbf-c30fc0c32c66"],
 ", so its circuit is nothing but CNOTs and measurements \[LongDash] one \
ancilla per generator, reset before use:"
}], "Text",ExpressionUUID->"67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], 
   "[", "\"\<SyndromeCircuit\>\"", "]"}], "[", "\"\<Instructions\>\"", 
  "]"}]], "Input",
 CellLabel->
  "In[65]:= ",ExpressionUUID->"233ecb8e-17f3-8d32-52c5-e2e8a187d418"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"R\"\>", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "1", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"M\"\>", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"R\"\>", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "2", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "3", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"M\"\>", ",", "5"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[65]= ",ExpressionUUID->"7dd949a9-d8cf-50b3-2be7-60f2d97a2299"]
}, Open  ]],

Cell["\<\
The ancillas are reset and reused between rounds, so a long experiment does \
not need more of them. Five rounds of the Steane code run on the same \
thirteen qubits as one:\
\>", "Text",ExpressionUUID->"4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "[", 
     RowBox[{"\"\<SyndromeCircuit\>\"", ",", " ", "1"}], "]"}], 
    "[", "\"\<Qubits\>\"", "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "[", 
     RowBox[{"\"\<SyndromeCircuit\>\"", ",", " ", "5"}], "]"}], 
    "[", "\"\<Qubits\>\"", "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[66]:= ",ExpressionUUID->"598f41e5-f1df-a461-0fb5-58ce806b0f4b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"13", ",", "13"}], "}"}]], "Output",
 CellLabel->
  "Out[66]= ",ExpressionUUID->"1e0f0df5-2071-c96f-4634-a4bf51059bb5"]
}, Open  ]],

Cell["\<\
What the whole thing costs, which is also the number of places a fault can \
happen:\
\>", "Text",ExpressionUUID->"7f6e12d5-e3b9-0bb9-2515-8b9e964c5983"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "[", 
   RowBox[{"\"\<SyndromeCircuit\>\"", ",", " ", "3"}], "]"}], 
  "[", "\"\<GateCounts\>\"", "]"}]], "Input",
 CellLabel->
  "In[67]:= ",ExpressionUUID->"41ecc127-3c02-05fa-7793-d881b5b76fc0"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"R\"\>", "\[Rule]", "18"}], ",", 
   RowBox[{"\<\"H\"\>", "\[Rule]", "72"}], ",", 
   RowBox[{"\<\"CNOT\"\>", "\[Rule]", "72"}], ",", 
   RowBox[{"\<\"M\"\>", "\[Rule]", "18"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[67]= ",ExpressionUUID->"1190ff72-a9fe-60f8-47af-f73fcf8b32c2"]
}, Open  ]],

Cell["\<\
Two limits are worth stating, and the first is not a rough edge. The ancillas \
are bare rather than cat-state-verified, and that is the difference between \
fault tolerant and not, not a detail alongside gate scheduling: \
\[Section]12.1.1 says of this exact circuit that \"a single faulty gate can \
cause multiple data errors, even if the fault doesn't directly affect the \
data block\". The fix is a verified ancilla feeding Shor (\[Section]12.2), \
Steane (\[Section]12.3) or Knill (\[Section]12.4) error correction. Using the \
bare version anyway is a sourced choice rather than a shortcut \[LongDash] \
\[Section]12.5.1: \"Frequently people using surface codes don't even bother \
with Shor EC, instead using the non-FT measurement technique of section \
12.1.1 instead\" \[LongDash] but that concession belongs to the surface-code \
setting and is not a general licence.\
\>", "Text",ExpressionUUID->"19c80315-d7de-7125-4ff7-9b5ee26b400f"],

Cell[TextData[{
 "The second: generators are extracted one after another rather than \
interleaved into parallel layers, so the circuit is deeper than a real one, \
and the ",
 Cell[BoxData["\"\<Idle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fdf78a7-59a9-97d9-15e5-7101585dfd23"],
 " rate is zero. Do not read that as idling being undefined here. \
\[Section]15.5.2 resolves an ill-defined time step by ",
 StyleBox["defining", "TI"],
 " one, the longest gate, and charging the padding as storage error; and \
\[Section]15.5.1 shows that less parallelism means ",
 StyleBox["more", "TI"],
 " waiting, multiplying the storage rate, with the flat statement that \"to \
have a threshold, it is essential to do parallel gates, at least when the \
storage error rate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["S", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a87483f-bfa4-2eb6-2abd-62793a51749c"],
 " is non-zero\". Zero idle noise is an optimistic simplification, and it is \
optimistic in exactly the direction this circuit is already weakest."
}], "Text",ExpressionUUID->"09b26917-59e6-8729-3f41-81515f90ea73"],

Cell[TextData[{
 "Nothing in this circuit is taken on trust. Pushing a Pauli through the \
emitted instructions and reading the ancilla measurements has to reproduce ",
 Cell[BoxData[
  RowBox[{"code", "[", 
   RowBox[{"\"\<Syndrome\>\"", ",", " ", "\[Ellipsis]"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "521ad179-838d-ce9b-0239-c923363994e1"],
 ", which is a matrix product that knows nothing about circuits; the same \
circuit is also run as an actual stabilizer state on the engine and its \
checks read by expectation. Both agree, for every weight-one and weight-two \
error on all five named codes."
}], "Text",ExpressionUUID->"136d7364-bcfb-8461-4113-6b4e348fef4b"],

Cell["Detectors", "Section",ExpressionUUID->"2b78534b-7a52-d624-5918-4b157fe4bd0e"],

Cell[TextData[{
 "Once a check can lie, a syndrome bit on its own is worthless: it can be \
wrong because the data was hit or because the readout misreported, and one \
round cannot tell those apart. Repeating the extraction is the old fix (\
\[Section]12.2.2). Decoding the ",
 StyleBox["differences", "TI"],
 " rather than the syndromes is a newer one, from the topological-code \
literature \[LongDash] Dennis, Kitaev, Landahl and Preskill, ",
 StyleBox["Topological quantum memory", "TI"],
 " (",
 ButtonBox["arXiv:quant-ph/0110143",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/quant-ph/0110143"], None}],
 "), where repeated noisy measurement turns the history into a lattice in one \
more dimension:"
}], "Text",ExpressionUUID->"30c454b2-bdb8-e427-60fc-4dfc3432cf0d"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["D", "TI"], "1"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["S", "TI"], "1"], 
    RowBox[{",", "    "}], 
    SubscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["r", "TI"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["r", "TI"]], "\[CirclePlus]", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     RowBox[{
      StyleBox["r", "TI"], "-", "1"}]], 
    RowBox[{",", "    "}], 
    SubscriptBox[
     StyleBox["D", "TI"], 
     RowBox[{
      StyleBox["R", "TI"], "+", "1"}]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["final",
      FontSlant->"Plain"]], "\[CirclePlus]", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["R", "TI"]]}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"6879dfe8-0276-0c7b-1806-d6b2b7035741"],

Cell[TextData[{
 "A detector is a parity that is deterministically zero when nothing goes \
wrong, so a fired detector is unambiguous evidence of a fault. The last one \
closes the experiment against a noiseless final readout, where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["final",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cc522fa-6a93-e579-24fa-bba40f27cc43"],
 " is the syndrome of whatever Pauli is left on the data."
}], "Text",ExpressionUUID->"5b82e386-6ff5-c0ee-09b1-fae009819234"],

Cell[TextData[{
 "Two things follow from \"deterministically zero\" that are easy to skip \
past. It assumes the data enters ",
 StyleBox["inside", "TI"],
 " the code space \[LongDash] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["D", "TI"], "1"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["S", "TI"], "1"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34a39a2f-b372-ffce-5c50-1388c604c514"],
 " is a detector only because the experiment prepares a codeword first \
\[LongDash] so what is modelled here is a memory experiment, not an \
error-correction gadget handed a block that already carries errors. And this \
is not the book's rule. Gottesman's answer to an untrustworthy syndrome is \
repeat and ",
 StyleBox["agree", "TI"],
 ": trust a run of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66ca9132-7812-8248-0ec9-097c79a4d092"],
 " consecutive identical syndromes, since at least one of them was taken with \
no faults, discard the rest, and look that single syndrome up \
(\[Section]12.2.2, \[Section]12.2.3). He raises the differencing strategy and \
sets it aside \[LongDash] \"it is difficult to analyze such strategies in the \
completely general case\" \[LongDash] so what follows computes exactly the \
thing the standard reference declines to analyse in general, and inherits \
none of its fault-tolerance guarantees."
}], "Text",ExpressionUUID->"023b1c4a-5b09-a8c9-33d8-96145ebdfa13"],

Cell[TextData[{
 Cell[BoxData["QECDetectorModel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29a4f364-fd74-7ca4-5f5b-eb41f401468e"],
 " is the map from each individual fault to what it does: which detectors it \
fires, which logical operators it flips, and with what probability. On the \
bit-flip code with one round it is small enough to read in full \[LongDash] \
three data faults and two readout faults, four detectors:"
}], "Text",ExpressionUUID->"47740231-7fc8-4299-6d0b-a47b7a7d10e3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dem", ",", " ", "bits"}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"dem", " ", "=", " ", 
     RowBox[{"QECDetectorModel", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<BitFlip\>\"", ",", " ", "p", ",", " ", 
         RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "q"}]}], "]"}], ",",
        " ", "1"}], "]"}]}], ";", "\n", "    ", 
    RowBox[{
     RowBox[{"bits", "[", "v_", "]"}], " ", ":=", " ", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"ToString", " ", "/@", " ", "v"}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"Grid", "[", "\n", "        ", 
     RowBox[{
      RowBox[{"Prepend", "[", "\n", "            ", 
       RowBox[{
        RowBox[{"MapThread", "[", "\n", "                ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"StringRiffle", "[", 
              RowBox[{
               RowBox[{"ToString", " ", "/@", " ", "#1"}], ",", 
               " ", "\"\< \>\""}], "]"}], ",", " ", 
             RowBox[{"bits", "[", "#2", "]"}], ",", " ", 
             RowBox[{"bits", "[", "#3", "]"}], ",", " ", "#4"}], "}"}], " ", 
           "&"}], ",", "\n", "                ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"dem", "[", "\"\<Locations\>\"", "]"}], ",", " ", 
            RowBox[{"dem", "[", "\"\<DetectorMatrix\>\"", "]"}], ",", " ", 
            RowBox[{"dem", "[", "\"\<ObservableMatrix\>\"", "]"}], ",", " ", 
            RowBox[{"dem", "[", "\"\<Probabilities\>\"", "]"}]}], "}"}]}], 
         "\n", "            ", "]"}], ",", "\n", "            ", 
        RowBox[{"{", 
         RowBox[{"\"\<fault\>\"", ",", " ", "\"\<detectors\>\"", ",", 
          " ", "\"\<observables\>\"", ",", " ", "\"\<probability\>\""}], 
         "}"}]}], "\n", "        ", "]"}], ",", "\n", "        ", 
      RowBox[{"Frame", " ", "->", " ", "All"}], ",", "\n", "        ", 
      RowBox[{"FrameStyle", " ", "->", " ", 
       RowBox[{"GrayLevel", "[", "0.85", "]"}]}], ",", "\n", "        ", 
      RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", "\n", "        ", 
      RowBox[{"Background", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"None", ",", " ", 
         RowBox[{"{", 
          RowBox[{"GrayLevel", "[", "0.94", "]"}], "}"}]}], "}"}]}], ",", 
      "\n", "        ", 
      RowBox[{"ItemSize", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "Automatic", ",", " ", "8", ",", " ", "8", ",", " ", "Automatic"}], 
          "}"}], ",", " ", "Automatic"}], "}"}]}]}], "\n", "    ", "]"}]}]}], 
  "\n", "]"}]], "Input",
 CellLabel->
  "In[68]:= ",ExpressionUUID->"1af52337-5e42-c8c3-4a8a-bb715bf49a29"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"fault\"\>", "\<\"detectors\"\>", "\<\"observables\"\>", \
"\<\"probability\"\>"},
    {"\<\"Data 1 1\"\>", "\<\"1000\"\>", "\<\"00\"\>", "p"},
    {"\<\"Data 1 2\"\>", "\<\"1100\"\>", "\<\"00\"\>", "p"},
    {"\<\"Data 1 3\"\>", "\<\"0100\"\>", "\<\"01\"\>", "p"},
    {"\<\"Measurement 4\"\>", "\<\"1010\"\>", "\<\"00\"\>", "q"},
    {"\<\"Measurement 8\"\>", "\<\"0101\"\>", "\<\"00\"\>", "q"}
   },
   AutoDelete->False,
   FrameStyle->GrayLevel[0.85],
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       GrayLevel[0.94]}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{
    "Columns" -> {Automatic, 8, 8, Automatic}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellLabel->
  "Out[68]= ",ExpressionUUID->"2fdb82dc-2353-e9b3-55f8-1b8656e7bb99"]
}, Open  ]],

Cell[TextData[{
 "That table is the point of the construction, and it is worth reading twice. \
A data error fires its checks in round one and is ",
 StyleBox["still there", "TI"],
 " at the final readout, so the difference detectors stay quiet: one fired \
detector. A readout error fires its check in its own round and again in the \
difference against the next one: two fired detectors, and nothing left on the \
data. The two failures no longer look alike."
}], "Text",ExpressionUUID->"5782d92f-a790-094a-7db1-d088d2255b90"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dem", " ", "=", " ", 
     RowBox[{"QECDetectorModel", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<BitFlip\>\"", ",", " ", "p", ",", " ", 
         RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "q"}]}], "]"}], ",",
        " ", "1"}], "]"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"dem", "[", "\"\<DetectorMatrix\>\"", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"dem", "[", "\"\<DetectorMatrix\>\"", "]"}], "[", 
      RowBox[{"[", "4", "]"}], "]"}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->
  "In[69]:= ",ExpressionUUID->"05d48452-325d-a277-33eb-1e1c47e9f15d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "1", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[69]= ",ExpressionUUID->"087ffcf6-194e-431e-3804-f5b098fb2e64"]
}, Open  ]],

Cell["\<\
The detector half of a data fault's row is exactly the syndrome computed the \
old way, which is the cheapest check there is that the circuit measures what \
it claims to:\
\>", "Text",ExpressionUUID->"615fadf7-df9a-5675-1764-44b0da2f3d5f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"code", " ", "=", " ", 
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}]}], ",", " ", 
     "dem"}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"dem", " ", "=", " ", 
     RowBox[{"QECDetectorModel", "[", 
      RowBox[{"code", ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<BitFlip\>\"", ",", " ", "p", ",", " ", 
         RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "q"}]}], "]"}], ",",
        " ", "1"}], "]"}]}], ";", "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"dem", "[", "\"\<DetectorMatrix\>\"", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", 
        RowBox[{"1", " ", ";;", " ", "6"}]}], "]"}], "]"}], " ", "==", " ", 
     RowBox[{"code", "[", 
      RowBox[{"\"\<Syndrome\>\"", ",", " ", "\"\<XIIIIII\>\""}], "]"}]}]}]}], 
  "\n", "]"}]], "Input",
 CellLabel->
  "In[70]:= ",ExpressionUUID->"5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[70]= ",ExpressionUUID->"2d0df906-1ebb-1081-5b32-f1609b4e62eb"]
}, Open  ]],

Cell[TextData[{
 "Some faults fire nothing at all and still move the logical qubit. Their \
existence is not a bug: they are the circuit-level analogue of a logical \
operator. Under depolarizing noise the bit-flip code has exactly three of \
them \[LongDash] the single ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519a4e0d-3467-bfb9-07ba-6057bd130583"],
 " errors \[LongDash] which is the circuit-level way of saying it has no \
phase protection:"
}], "Text",ExpressionUUID->"3a891815-8c00-cf41-6ab6-925f25ba95ab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECDetectorModel", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p", ",", " ", 
      RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "q"}]}], "]"}], ",",
     " ", "1"}], "]"}], "[", "\"\<UndetectableFaults\>\"", "]"}]], "Input",
 CellLabel->
  "In[71]:= ",ExpressionUUID->"0dbacffa-31b0-43f6-3b59-e6a4404511dc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"Data\"\>", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Data\"\>", ",", "1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Data\"\>", ",", "1", ",", "3"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[71]= ",ExpressionUUID->"196a859c-b643-c1b3-4f69-1cd9c3f79399"]
}, Open  ]],

Cell["\<\
Every detector's firing rate is available in closed form, which is the \
natural quantity to check an external simulator against \[LongDash] it is \
basis-free and every detector is a separate test. With the data noise \
switched off, each detector fires exactly when its own readout lies:\
\>", "Text",ExpressionUUID->"48c8a383-1e42-ef31-78f7-3aed9bf4b21b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", " ", "@", " ", 
  RowBox[{
   RowBox[{"QECDetectorModel", "[", 
    RowBox[{
     RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
     RowBox[{"QECNoiseModel", "[", 
      RowBox[{"\"\<BitFlip\>\"", ",", " ", "0", ",", " ", 
       RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "q"}]}], "]"}], ",",
      " ", "1"}], "]"}], "[", "\"\<DetectorRates\>\"", "]"}]}]], "Input",
 CellLabel->
  "In[72]:= ",ExpressionUUID->"50735439-04fd-dee7-0001-4e63ac89a4cd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"q", ",", "q", ",", "q", ",", "q"}], "}"}]], "Output",
 CellLabel->
  "Out[72]= ",ExpressionUUID->"3597ba8d-914b-928f-63ac-33d720ffe0d5"]
}, Open  ]],

Cell["The memory experiment", "Section",ExpressionUUID->"056fda38-a5bc-2884-3314-dc65cc497aee"],

Cell[TextData[{
 "Prepare a codeword, run ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "383c4a9f-130c-f8c1-69c4-63d9a6beca2b"],
 " rounds of noisy extraction, read the data out perfectly at the end, decode \
the whole detector history, and ask whether the logical qubit survived."
}], "Text",ExpressionUUID->"7b649e79-a2e1-7610-291b-1022d6945d7a"],

Cell[TextData[{
 Cell[BoxData["\"\<Rounds\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09cb884c-5fc8-b209-3fc8-22165a620153"],
 " says how many and defaults to the code distance. That is the \
topological-memory convention: fewer rounds than the distance protects the \
time direction less than the space ones, which quietly caps the whole thing. \
It is deliberately not the book's criterion, and the two should not be \
conflated \[LongDash] \[Section]12.2.2 asks instead for a run of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "376c6589-bcca-29e8-5d14-7cd3357f7b32"],
 " ",
 StyleBox["agreeing", "TI"],
 " syndrome measurements, proves ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["t", "TI"], "+", "1"}], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "667bb688-7420-22c7-0e18-2fd27dd5702d"],
 " repetitions enough to find one, and explicitly rejects ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["t", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72002252-da4c-5210-223f-c41fdff9217a"],
 " repetitions with a majority vote, \"since there are ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    RowBox[{
     StyleBox["n", "TI"], "-", 
     StyleBox["k", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "084561a7-5440-aaee-387b-78015dfaf834"],
 " possible values of the syndrome \[Ellipsis] There might not be a \
majority\". That criterion buys a fault-tolerance guarantee; this default \
buys a memory experiment whose time and space directions are equally \
protected."
}], "Text",ExpressionUUID->"721e71e5-9ca7-ded5-2226-68cf1553a43f"],

Cell[TextData[{
 "The identity that ties all of this to the earlier sections: a \
phenomenological model with perfect readout, run for one round, ",
 StyleBox["is", "TI"],
 " code-capacity noise. Its rate had better be the same polynomial, and it is:"
}], "Text",ExpressionUUID->"0a84e7eb-55e0-1894-3abb-feb563956afe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"QECLogicalErrorRate", "[", 
    RowBox[{
     RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
     RowBox[{"QECNoiseModel", "[", 
      RowBox[{"\"\<BitFlip\>\"", ",", " ", "p", ",", " ", 
       RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "0"}]}], "]"}], ",",
      " ", 
     RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}], " ", "==", 
   "\n", "        ", 
   RowBox[{"QECLogicalErrorRate", "[", 
    RowBox[{
     RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
     RowBox[{"QECNoiseModel", "[", 
      RowBox[{"\"\<BitFlip\>\"", ",", " ", "p"}], "]"}]}], "]"}]}], "\n", 
  "]"}]], "Input",
 CellLabel->
  "In[73]:= ",ExpressionUUID->"3261920b-7b77-02d6-621e-14557e02503c"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[73]= ",ExpressionUUID->"4ebe3b2c-9c8f-bd2d-7645-b376153b0477"]
}, Open  ]],

Cell["\<\
That one line exercises the circuit emitter, the frame propagation, the \
detector definition, the fault enumeration and the exact sum at once, against \
an answer already checked against a binomial tail.\
\>", "Text",ExpressionUUID->"7d6a0058-fb4a-caff-2b69-9a05fefc98c5"],

Cell[TextData[{
 "The rate is still exact, and now in two variables. Setting either to zero \
recovers a limit worth knowing: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41d92934-9aba-8299-77e6-c17e1f4cd0e3"],
 " gives back ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", 
    SuperscriptBox[
     StyleBox["p", "TI"], "2"], "-", "2", 
    SuperscriptBox[
     StyleBox["p", "TI"], "3"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cc23ff5-bf0f-f019-04f1-b6bf3abbc363"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29880975-91f0-008f-5fb7-a13f278552d5"],
 " gives ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["q", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "551c00cf-fc58-99c4-0323-99a8f5d2eb2e"],
 " \[LongDash] with no data errors at all, a single readout lie is recognised \
by its two-detector signature and corrected, so failure needs two of them:"
}], "Text",ExpressionUUID->"22235db8-54be-42b7-53d1-54e25d4b109d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Expand", " ", "@", " ", 
  RowBox[{"QECLogicalErrorRate", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<BitFlip\>\"", ",", " ", "p", ",", " ", 
      RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "q"}]}], "]"}], ",",
     " ", 
    RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[74]:= ",ExpressionUUID->"0976d5ae-737d-f257-3f0d-cc080609c0bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"3", " ", 
   SuperscriptBox["p", "2"]}], "-", 
  RowBox[{"2", " ", 
   SuperscriptBox["p", "3"]}], "+", 
  RowBox[{"6", " ", "p", " ", "q"}], "-", 
  RowBox[{"12", " ", 
   SuperscriptBox["p", "2"], " ", "q"}], "+", 
  RowBox[{"6", " ", 
   SuperscriptBox["p", "3"], " ", "q"}], "+", 
  SuperscriptBox["q", "2"], "-", 
  RowBox[{"6", " ", "p", " ", 
   SuperscriptBox["q", "2"]}], "+", 
  RowBox[{"9", " ", 
   SuperscriptBox["p", "2"], " ", 
   SuperscriptBox["q", "2"]}], "-", 
  RowBox[{"4", " ", 
   SuperscriptBox["p", "3"], " ", 
   SuperscriptBox["q", "2"]}]}]], "Output",
 CellLabel->
  "Out[74]= ",ExpressionUUID->"13e711b4-4d78-4d68-419c-88fe640d17b2"]
}, Open  ]],

Cell[TextData[{
 "This is the part no sampling simulator can do, and it is worth saying how \
it is possible. Enumerating fault configurations would mean ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "faults"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fd09d86-aea1-a602-65ef-14e3cb550d68"],
 " of them, which is hopeless. Instead the ",
 StyleBox["distribution over effects", "TI"],
 " is carried \[LongDash] a vector indexed by the possible \
detector-and-observable patterns \[LongDash] and the locations are folded in \
one at a time,"
}], "Text",ExpressionUUID->"2f6c0922-6605-ed68-5513-a08c13b1b7b2"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["P", "TI"], "\[Prime]"], 
    RowBox[{"[", 
     StyleBox["s", "TI"], "]"}], "\[LongEqual]", 
    StyleBox["P", "TI"], 
    RowBox[{"[", 
     StyleBox["s", "TI"], "]"}], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      UnderscriptBox["\[Sum]", 
       StyleBox["i", "TI"],
       LimitsPositioning->True], 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["i", "TI"]]}], ")"}], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["i", "TI"],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["i", "TI"]], " ", 
    StyleBox["P", "TI"], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["s", "TI"], "\[CirclePlus]", 
      SubscriptBox["\[Sigma]", 
       StyleBox["i", "TI"]]}], "]"}]}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"2caab86a-2af9-b1b1-54a9-32344e8d039b"],

Cell[TextData[{
 "the inner sum running over the mutually exclusive outcomes of a single \
location, so a three-way depolarizing channel is handled exactly rather than \
as three independent coins. The cost is locations times state space rather \
than ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "faults"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f56169e-4783-4dbb-256d-8fd872361781"],
 ", and the state space \[LongDash] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       StyleBox["r", "TI"], "+", "1"}], ")"}], 
     StyleBox["m", "TI"], "+", "2", 
     StyleBox["k", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b84d4d6-858d-5842-09bb-cd902c382aa8"],
 " \[LongDash] is what bounds it, through ",
 Cell[BoxData["$QECExactDetectorLimit"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67558936-e5eb-8680-0d6a-2173939fecea"],
 "."
}], "Text",ExpressionUUID->"1072dc7c-f7d5-c74e-4001-d6398261ad94"],

Cell["\<\
Past that bound the same quantity is sampled, and the two routes check each \
other. The Steane code at circuit level, exactly and then over two hundred \
thousand shots:\
\>", "Text",ExpressionUUID->"3462f0a3-098c-f6b3-5c11-e90da83edc99"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BlockRandom", "[", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "11", "]"}], ";", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"QECLogicalErrorRate", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
        RowBox[{"QECNoiseModel", "[", 
         RowBox[{"\"\<Circuit\>\"", ",", " ", 
          RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", 
        RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], ",", "\n",
      "     ", 
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Circuit\>\"", ",", " ", 
         RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", "200000", ",", " ", 
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], "}"}]}], 
  "\n", "]"}]], "Input",
 CellLabel->
  "In[75]:= ",ExpressionUUID->"04cac1af-436c-9192-2cc9-d809761ee3f8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.0038004875014007356`", ",", "0.00387`"}], "}"}]], "Output",
 CellLabel->
  "Out[75]= ",ExpressionUUID->"63be94f2-239e-9b81-1145-0dbc5628e9eb"]
}, Open  ]],

Cell[TextData[{
 "Because all three levels give polynomials, the price of honesty about noise \
is a picture rather than an argument. The same code, the same rate ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a3d7a71-218e-1995-0bc3-7c3b503b6bff"],
 ", three noise models:"
}], "Text",ExpressionUUID->"3a0f2024-2f71-09ca-6a34-b98e4a045b10"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"bf", " ", "=", " ", 
      RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}]}], ",", " ", 
     "capacity", ",", " ", "phenomenological", ",", " ", "circuit"}], "}"}], ",",
    "\n", "    ", 
   RowBox[{
    RowBox[{"capacity", " ", "=", " ", 
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{"bf", ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<BitFlip\>\"", ",", " ", "p"}], "]"}]}], "]"}]}], ";", 
    "\n", "    ", 
    RowBox[{"phenomenological", " ", "=", " ", 
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{"bf", ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<BitFlip\>\"", ",", " ", "p", ",", " ", 
         RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "p"}]}], "]"}], ",",
        " ", 
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], ";", "\n", 
    "    ", 
    RowBox[{"circuit", " ", "=", " ", 
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{"bf", ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Circuit\>\"", ",", " ", "p"}], "]"}], ",", " ", 
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], ";", "\n", 
    "    ", 
    RowBox[{"Plot", "[", "\n", "        ", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{"{", 
        RowBox[{
        "capacity", ",", " ", "phenomenological", ",", " ", "circuit"}], 
        "}"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "0", ",", " ", 
        RowBox[{"1", "/", "5"}]}], "}"}], ",", "\n", "        ", 
      RowBox[{"PlotLegends", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<code capacity\>\"", ",", " ", "\"\<phenomenological\>\"",
          ",", " ", "\"\<circuit\>\""}], "}"}]}], ",", "\n", "        ", 
      RowBox[{"AxesLabel", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<physical error rate\>\"", ",", 
         " ", "\"\<logical error rate\>\""}], "}"}]}], ",", "\n", "        ", 
      
      RowBox[{"ImageSize", " ", "->", " ", "380"}]}], "\n", "    ", "]"}]}]}],
   "\n", "]"}]], "Input",
 CellLabel->
  "In[76]:= ",ExpressionUUID->"277956ac-4c9d-d338-4d07-4ff66529be02"],

