Cell["Pseudothresholds", "Section",ExpressionUUID->"39b01e29-d171-5c92-6f4f-9072e00426f8"],

Cell[TextData[{
 "Because the rate is an exact polynomial, the point where encoding stops \
paying \[LongDash] the logical rate crossing the physical one, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["L", "TI"]], 
    RowBox[{"(", 
     StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["p", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f6d713e-2461-11c8-7513-69784d146312"],
 " \[LongDash] is a root, found exactly:"
}], "Text",ExpressionUUID->"14ad582f-66ff-93eb-3c53-5189128be131"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ps", " ", "=", " ", 
   RowBox[{"QECPseudothreshold", "[", 
    RowBox[{
     RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
     RowBox[{"QECNoiseModel", "[", 
      RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ps", "[", "\"\<Value\>\"", "]"}], ",", " ", 
   RowBox[{"N", "[", 
    RowBox[{"ps", "[", "\"\<Value\>\"", "]"}], "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[47]:= ",ExpressionUUID->"4f7ea056-2d28-85ec-7505-3a1044c2ef36"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[<|"icon" -> "Root", "small" -> InterpretationBox[
       StyleBox[
        TemplateBox[{"\"0.0811\"", 
          DynamicBox[
           FEPrivate`FrontEndResource[
           "FEExpressions", "NumericalApproximationElider"]]}, "RowDefault"], 
        ShowStringCharacters -> False], 
       0.08108189622828848586166827772103715688`15.954589770191003, Editable -> 
       False], "approx" -> 0.08108189622828849, "interp" -> 
     InterpretationBox["", 
       Root[81 - 1161 # + 2142 #^2 - 1824 #^3 + 608 #^4& , 1, 0]], "head" -> 
     "Root", "big" -> RowBox[{
        RowBox[{"81", "-", 
          RowBox[{"1161", " ", "#1"}], "+", 
          RowBox[{"2142", " ", 
            SuperscriptBox["#1", "2"]}], "-", 
          RowBox[{"1824", " ", 
            SuperscriptBox["#1", "3"]}], "+", 
          RowBox[{"608", " ", 
            SuperscriptBox["#1", "4"]}]}], "&"}], "degree" -> "4", 
     "shortDegree" -> "4", "number" -> 1|>,
    "NumericalApproximationInterp"], ",", "0.08108189622828849`"}], 
