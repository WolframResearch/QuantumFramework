Cell[TextData[{
 "Code capacity and the phenomenological level are both quadratic in ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ddf811-e480-8137-02e2-f25a8d3ad01d"],
 " and differ by a constant factor \[LongDash] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", 
    SuperscriptBox[
     StyleBox["p", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "719ae17a-c654-ed44-27b9-f927f3e6b7ae"],
 " against ",
 Cell[BoxData[
  FormBox[
   RowBox[{"10", 
    SuperscriptBox[
     StyleBox["p", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62c8f42b-c628-388a-12f7-ee74f3c28ad0"],
 ". The circuit-level curve is a different shape entirely, and the next \
section is about why."
}], "Text",ExpressionUUID->"36e5ffeb-8179-694d-5e9a-f6b5300c3b97"],

Cell[TextData[{
 "One caveat on that figure, and it is the book's: \"A threshold in a \
phenomenological model should not be confused with the threshold derived from \
a full circuit model; they are not at all comparable\" (\[Section]10.4). The \
three curves share an axis but not a quantity \[LongDash] the \
phenomenological ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7af061c8-c44a-ae8e-2a80-7895edfcf4d4"],
 " is a rate per qubit per round, the circuit-level ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d437dad-8290-de9a-3b71-74f7372aa4e0"],
 " a rate per location, and the phenomenological model ignores how many gates \
a syndrome bit costs. Read the picture as one code losing ground as \
assumptions are dropped, not as three thresholds being compared."
}], "Text",ExpressionUUID->"7aafc905-908a-67da-2a54-e16f213f4d20"],

Cell["What circuit-level noise actually costs", "Section",ExpressionUUID->"62016b94-8ad8-fb56-123e-82de2f52c9bc"],

Cell["\<\
Two facts fall out of these polynomials that are hard to state without them. \
Both are about the extraction circuit rather than the code, and both are \
exact.\
\>", "Text",ExpressionUUID->"0e7c794a-82c2-56e7-3604-711437773ccd"],

Cell[TextData[{
 StyleBox["Duality is a property of the codes, not of the circuits that \
measure them.",
  FontWeight->"Bold"],
 " The bit-flip and phase-flip codes are the same code with ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30f601cf-5001-fb68-608d-98a961b5c9b2"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04bc0f0b-f02f-243d-2c43-a75481db8f07"],
 " exchanged; both are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"[", 
     RowBox[{"3", ",", "1", ",", "1"}], "]"}], "]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],
 ", and under depolarizing noise at code capacity their rates are identical. \
At circuit level they are not:"
}], "Text",ExpressionUUID->"705e212e-f5a4-7717-2065-b88bfc515a7d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lead", " ", "=", " ", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], "]"}], 
      " ", "&"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"lead", " ", "@", " ", 
      RowBox[{"QECLogicalErrorRate", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
        RowBox[{"QECNoiseModel", "[", 
         RowBox[{"\"\<Circuit\>\"", ",", " ", "p"}], "]"}], ",", " ", 
        RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], ",", "\n",
      "     ", 
     RowBox[{"lead", " ", "@", " ", 
      RowBox[{"QECLogicalErrorRate", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<PhaseFlipCode\>\"", "]"}], ",", " ", 
        RowBox[{"QECNoiseModel", "[", 
         RowBox[{"\"\<Circuit\>\"", ",", " ", "p"}], "]"}], ",", " ", 
        RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}]}], "}"}]}],
   "\n", "]"}]], "Input",
 CellLabel->
  "In[77]:= ",ExpressionUUID->"5c2f5325-a3f6-c048-05d5-4a8ed5809292"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"32", " ", "p"}], "15"], ",", 
   FractionBox[
    RowBox[{"112", " ", "p"}], "15"]}], "}"}]], "Output",
 CellLabel->
  "Out[77]= ",ExpressionUUID->"211ecaf2-61ee-418f-5725-e3bc179b13d5"]
}, Open  ]],

Cell[TextData[{
 "The asymmetry is entirely the rotations. The phase-flip code's generators \
are ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51e4dffc-d38f-5703-079b-d6b9e63a3a69"],
 "-type, so its extraction needs eight ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30e43b5d-74af-d0fb-609b-b3077d5ba2c1"],
 " gates that the bit-flip code's does not, and each is a fresh depolarizing \
location sitting on a data qubit. Switch the one-qubit-gate noise off and the \
two codes agree again, to the coefficient:"
}], "Text",ExpressionUUID->"44d9380c-2e05-8f35-6ce6-b2564bb1d21f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"noise", " ", "=", " ", 
      RowBox[{"QECNoiseModel", "[", 
       RowBox[{"\"\<Circuit\>\"", ",", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<TwoQubit\>\"", " ", "->", " ", "p"}], ",", " ", 
          RowBox[{"\"\<Measurement\>\"", " ", "->", " ", "p"}], ",", " ", 
          RowBox[{"\"\<Reset\>\"", " ", "->", " ", "p"}]}], "|>"}]}], "]"}]}],
      ",", "\n", "        ", 
     RowBox[{"lead", " ", "=", " ", 
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{"Series", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"{", 
           RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], "]"}],
        " ", "&"}]}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"lead", " ", "@", " ", 
      RowBox[{"QECLogicalErrorRate", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
        "noise", ",", " ", 
        RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], ",", "\n",
      "     ", 
     RowBox[{"lead", " ", "@", " ", 
      RowBox[{"QECLogicalErrorRate", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<PhaseFlipCode\>\"", "]"}], ",", " ", 
        "noise", ",", " ", 
        RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}]}], "}"}]}],
   "\n", "]"}]], "Input",
 CellLabel->
  "In[78]:= ",ExpressionUUID->"36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"32", " ", "p"}], "15"], ",", 
   FractionBox[
    RowBox[{"32", " ", "p"}], "15"]}], "}"}]], "Output",
 CellLabel->
  "Out[78]= ",ExpressionUUID->"138e1639-4d05-8b97-41b5-886364b1d9fd"]
}, Open  ]],

Cell[TextData[{
 StyleBox["This extraction circuit stops a distance-three code correcting \
single faults.",
  FontWeight->"Bold"],
 " The five-qubit code has distance 3, so at code capacity and at the \
phenomenological level its logical error rate starts at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "156728ce-0023-e03b-431c-c1a8b1d7b301"],
 ": any one error is corrected. With this circuit it starts at ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"],
 ":"
}], "Text",ExpressionUUID->"26ff5c08-e081-ff27-4e85-56559135c20d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", " ", "@", " ", 
  RowBox[{"Series", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"QECLogicalErrorRate", "[", 
     RowBox[{
      RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
      RowBox[{"QECNoiseModel", "[", 
       RowBox[{"\"\<Circuit\>\"", ",", " ", "p"}], "]"}], ",", " ", 
      RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}], ",", "\n", 
    "    ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}]}], "\n", 
   "]"}]}]], "Input",
 CellLabel->
  "In[79]:= ",ExpressionUUID->"07c988c4-3ef2-8066-2df6-21aeba84d34c"],

Cell[BoxData[
 FractionBox[
  RowBox[{"29", " ", "p"}], "5"]], "Output",
 CellLabel->
  "Out[79]= ",ExpressionUUID->"4bc0a2f3-6150-447f-79ff-3bbd10e52f45"]
}, Open  ]],

Cell[TextData[{
 "Note the phrasing: this is a defect of the ",
 StyleBox["gadget", "TI"],
 ", not a property of circuit-level noise. Gottesman's \[Section]10.2 exists \
precisely so that circuit noise need not cost the exponent \[LongDash] a \
gadget satisfying its propagation properties keeps a distance-three code at \
",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ac66077-3bfa-1f18-2afe-7a31bd8f6262"],
 " under circuit noise. Order ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d863d84-94ab-5643-6bbd-b4ee1d5e3ca9"],
 " is the signature of a construction that does not satisfy them."
}], "Text",ExpressionUUID->"7ab8b877-e011-189c-2a47-323091a46ae6"],

Cell[TextData[{
 "The mechanism is the ",
 StyleBox["hook error", "TI"],
 ", and it is worth being exact about, because the direction of the CNOTs \
here is the mirror of figure 12.1b's and the obvious transcription is wrong. \
With the ancilla as target, an ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35eb0178-2238-e094-63e8-992257b2b2fe"],
 " on the ancilla reaches no data qubit at all \[LongDash] CNOT carries ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da6433d-a7a4-ba24-3b5e-5b66d256090e"],
 " only from control to target, so it sits there and flips one readout. The \
fault that spreads is a ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "462f64f6-435d-c7dd-6fd5-7db076e9ad27"],
 " (hence also a ",
 Cell[BoxData[
  FormBox[
   StyleBox["Y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b06bf63-5f43-ed7c-793d-374d5af7b446"],
 "): CNOT carries ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fd1c247-21a4-d962-35ee-e4215056a848"],
 " from target back to control, the ancilla keeps its ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09347675-9fce-c17b-38cc-683f1a789041"],
 ", and it lands on every data qubit the ladder has ",
 StyleBox["still to touch",
  FontWeight->"Bold"],
 ". After the un-rotation the residual is exactly the un-extracted tail of \
the generator \[LongDash] a mid-ladder ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c597ed5-00d9-d535-5467-779fb16dbc1f"],
 " on the five-qubit code's ",
 Cell[BoxData["XZZXI"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c4d8d6-27c8-a0db-0efb-d1905262f221"],
 " leaves ",
 Cell[BoxData["IZZXI"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d3801b6-8b23-0df3-74c7-98f02ed657d9"],
 ", ",
 Cell[BoxData["IIZXI"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09816d05-11e9-fb6e-3fbe-856fa79dc9b4"],
 " or ",
 Cell[BoxData["IIIXI"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35ec423d-cde2-7917-6394-6466eb97487d"],
 " \[LongDash] and, being a sub-product of the generator, it does not fire \
that generator's own check in the round it happened. A ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05e0e9bc-56b1-1bf2-339f-00e6634469d8"],
 " before the first CNOT leaves the whole generator, which is a stabilizer \
and harmless; after the last, nothing. Only mid-ladder hurts."
}], "Text",ExpressionUUID->"46408f14-a324-388b-6e7f-2751d6d68ad1"],

Cell["\<\
Count what that does to the decoder's job. At the phenomenological level \
every single fault has its own detector signature, so no single fault is ever \
ambiguous. With this circuit the signatures collide, and some of the \
colliding faults do different things to the logical qubit \[LongDash] at \
which point no decoder reading detectors alone can tell them apart.\
\>", "Text",ExpressionUUID->"40213c85-9219-7c2b-71de-b5ef27ac4771"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "ambiguity", "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{
     RowBox[{"ambiguity", "[", 
      RowBox[{"code_", ",", " ", "noise_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dem", ",", " ", "d", ",", " ", "o", ",", " ", "grouped"}], 
        "}"}], ",", "\n", "        ", 
       RowBox[{
        RowBox[{"dem", " ", "=", " ", 
         RowBox[{"QECDetectorModel", "[", 
          RowBox[{"code", ",", " ", "noise", ",", " ", "1"}], "]"}]}], ";", 
        "\n", "        ", 
        RowBox[{"d", " ", "=", " ", 
         RowBox[{"dem", "[", "\"\<DetectorMatrix\>\"", "]"}]}], ";", " ", 
        RowBox[{"o", " ", "=", " ", 
         RowBox[{"dem", "[", "\"\<ObservableMatrix\>\"", "]"}]}], ";", "\n", 
        "        ", 
        RowBox[{"grouped", " ", "=", " ", 
         RowBox[{"GroupBy", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "d", "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"d", "[", 
             RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], ",", " ", 
           RowBox[{
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"o", "[", 
                RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
              "#"}], "]"}], " ", "&"}]}], "]"}]}], ";", "\n", "        ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<faults\>\"", " ", "->", " ", 
           RowBox[{"Length", "[", "d", "]"}]}], ",", " ", 
          RowBox[{"\"\<distinct signatures\>\"", " ", "->", " ", 
           RowBox[{"Length", "[", "grouped", "]"}]}], ",", "\n", "          ", 
          RowBox[{"\"\<ambiguous signatures\>\"", " ", "->", " ", 
           RowBox[{"Count", "[", 
            RowBox[{"grouped", ",", " ", 
             RowBox[{"alternatives_", " ", "/;", " ", 
              RowBox[{
               RowBox[{"Length", "[", "alternatives", "]"}], " ", ">", " ", 
               "1"}]}]}], "]"}]}]}], "|>"}]}]}], "\n", "    ", "]"}]}], ";", 
    "\n", "    ", 
    RowBox[{"Dataset", " ", "@", " ", 
     RowBox[{"<|", "\n", "        ", 
      RowBox[{
       RowBox[{"\"\<phenomenological\>\"", " ", "->", " ", 
        RowBox[{"ambiguity", "[", 
         RowBox[{
          RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
          RowBox[{"QECNoiseModel", "[", 
           RowBox[{"\"\<Depolarizing\>\"", ",", " ", 
            RowBox[{"1", "/", "1000"}], ",", " ", 
            RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", 
             RowBox[{"1", "/", "1000"}]}]}], "]"}]}], "]"}]}], ",", "\n", 
       "        ", 
       RowBox[{"\"\<circuit\>\"", " ", "->", " ", 
        RowBox[{"ambiguity", "[", 
         RowBox[{
          RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
          RowBox[{"QECNoiseModel", "[", 
           RowBox[{"\"\<Circuit\>\"", ",", " ", 
            RowBox[{"1", "/", "1000"}]}], "]"}]}], "]"}]}]}], "\n", "    ", 
      "|>"}]}]}]}], "\n", "]"}]], "Input",
 CellLabel->
  "In[80]:= ",ExpressionUUID->"678faed4-2cca-f411-0db4-479e457cdf7b"],

