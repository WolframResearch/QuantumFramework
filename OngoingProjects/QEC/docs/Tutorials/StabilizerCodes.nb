     "383c4a9f-130c-f8c1-69c4-63d9a6beca2b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7b649e79-a2e1-7610-291b-1022d6945d7a"], Cell[
    "Reusing ancillas across rounds", "TableText",ExpressionUUID->
     "09cb884c-5fc8-b209-3fc8-22165a620153"], Cell[
    "Book \[Section]15.4, \[Section]15.4.3", "TableText",ExpressionUUID->
