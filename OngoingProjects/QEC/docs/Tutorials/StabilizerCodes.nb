Cell[TextData[{
 "On the five-qubit code the same gate is not a gadget at all, and section \
11.4 says why in one direction: demanding that transversal CNOT preserve the \
stabilizer forces the generators to be ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74b37722-3fdc-1a4f-1c41-6e8cba696895"],
 "-only or ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31781dc2-1028-33d4-6707-94aca1c2813e"],
 "-only, which is the definition of a CSS code."
}], "Text",ExpressionUUID->"2148b02c-d62e-5336-5777-2989e3db3e1c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "183293a6-0d60-7813-49c1-0a00a4154b79"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61e1f3c1-eae0-3799-179e-eaaa8e9a9de3"],
 " and CNOT generate the Clifford group, so the seven-qubit code performs the \
",
 StyleBox["whole logical Clifford group transversally",
  FontWeight->"Bold"],
 " \[LongDash] with the caveat above, that each gate arrives conjugated. What \
is missing is everything outside that group: no transversal ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20bddc2d-650e-8031-5042-d6770cb8d31b"],
 ", on this or any code of this kind, and that is chapter 13's problem rather \
than a gap in this one."
}], "Text",ExpressionUUID->"7a437910-f355-55ba-2a71-715d86e03f80"],

Cell["Beyond the Clifford group", "Section",ExpressionUUID->"49429438-4a3e-974e-7f71-0e626fc8fd94"],

Cell[TextData[{
 "Every transversal gate above is a Clifford, and that is not a coincidence \
of these two codes: the Clifford group is the second level of the ",
 StyleBox["Clifford hierarchy",
  FontWeight->"Bold"],
 " (Def 13.1), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], "1"], "\[LongEqual]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07e2168c-1726-1a27-2d91-8fd6a2d3690d"],
 " Paulis, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["k", "TI"]], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["U", "TI"], ":", 
      StyleBox["U", "TI"], 
      StyleBox["P", "TI"], 
      SuperscriptBox[
       StyleBox["U", "TI"], "\[Dagger]"], "\[Element]", 
      SubscriptBox[
       StyleBox["C", "TI"], 
       RowBox[{
        StyleBox["k", "TI"], "-", "1"}]], " ", "\[ForAll]", 
      StyleBox["P", "TI"]}], "}"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3540c51c-f580-c338-637f-dd59fc3aae02"],
 ". The gates that make a computer universal sit above it, and chapter 13 \
builds them from the third level by teleportation. ",
 Cell[BoxData["QECCliffordHierarchyLevel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "684f0173-fe99-1571-1874-993cfb2c7c5b"],
 " decides the level by the definition, exactly:"
}], "Text",ExpressionUUID->"6e32c5a8-aee9-5273-17c1-dcf5ca9c2159"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QECCliffordHierarchyLevel", " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{"\"\<X\>\"", ",", " ", "\"\<H\>\"", ",", " ", "\"\<CNOT\>\"", ",", 
    " ", "\"\<T\>\"", ",", " ", "\"\<Toffoli\>\"", ",", " ", "\"\<CS\>\""}], 
   "}"}]}]], "Input",
 CellLabel->
  "In[108]:= ",ExpressionUUID->"607492e2-157b-ba0c-100b-0bcc9c0f0956"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "2", ",", "3", ",", "3", ",", "3"}], 
  "}"}]], "Output",
 CellLabel->
  "Out[108]= ",ExpressionUUID->"7781757c-388d-abb9-1dbf-6d26b939f983"]
}, Open  ]],

Cell[TextData[{
 "The phase gates climb the tower one level per halving of the angle, and an \
angle that is not a dyadic multiple of ",
 Cell[BoxData[
  FormBox["\[Pi]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "566e7348-207a-dc95-7e16-6b12510ca6ff"],
 " is in no level at all (the induction after eq. 13.11):"
}], "Text",ExpressionUUID->"39672ae7-82f4-b353-6f1c-c3c1368601b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Append", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"QECCliffordHierarchyLevel", "[", 
      RowBox[{
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"Pi", "/", 
             RowBox[{"2", "^", "k"}]}]}], "]"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"\"\<MaxLevel\>\"", " ", "->", " ", "6"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}], ",", "\n", 
   "    ", 
   RowBox[{"QECCliffordHierarchyLevel", "[", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", "/", "10"}], "]"}]}], "}"}], "]"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[109]:= ",ExpressionUUID->"0c48aba4-6f27-6a39-3477-420e0ad23903"],

