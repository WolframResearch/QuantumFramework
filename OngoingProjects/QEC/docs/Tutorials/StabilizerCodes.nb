       RowBox[{
        RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", "#"}], 
       "]"}], "[", "\"\<LogicalGate\>\"", "]"}], " ", "&"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<CNOT\>\"", ",", " ", "\"\<CZ\>\"", ",", 
      " ", "\"\<SWAP\>\""}], "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[107]:= ",ExpressionUUID->"0c860bbc-8d1f-f590-34bd-a2e624abdffa"],

