Cell[TextData[{
 "And the four that survive are all shots the experiment throws away. Every \
one is a fault in the cat's own preparation that leaves a weight-two ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "178a6a52-23e4-1142-3d89-8c1c559163a8"],
 " pattern \[LongDash] exactly what the verification check is there to catch. \
Condition on the checks ",
 StyleBox["accepting",
  FontWeight->"Bold"],
 ", which is the only case that is kept, and no single fault is ambiguous at \
all:"
}], "Text",ExpressionUUID->"52ddf811-e480-8137-02e2-f25a8d3ad01d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "dem", ",", " ", "d", ",", " ", "o", ",", " ", "h", ",", " ", "keep", ",",
      " ", "grouped"}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"dem", " ", "=", " ", 
     RowBox[{"QECDetectorModel", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Circuit\>\"", ",", " ", 
         RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", "1", ",", "\n", 
       "        ", 
       RowBox[{"\"\<Extraction\>\"", " ", "->", 
        " ", "\"\<Transversal\>\""}]}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"dem", "[", "\"\<DetectorMatrix\>\"", "]"}]}], ";", " ", 
    RowBox[{"o", " ", "=", " ", 
     RowBox[{"dem", "[", "\"\<ObservableMatrix\>\"", "]"}]}], ";", " ", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"dem", "[", "\"\<HeraldMatrix\>\"", "]"}]}], ";", "\n", "    ", 
    RowBox[{"keep", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "d", "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"h", "[", 
           RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "===", " ", "0"}], " ",
         "&"}]}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"grouped", " ", "=", " ", 
     RowBox[{"GroupBy", "[", 
      RowBox[{"keep", ",", " ", 
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], ",", " ", 
       RowBox[{
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"o", "[", 
            RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", "#"}],
          "]"}], " ", "&"}]}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<accepted faults\>\"", " ", "->", " ", 
       RowBox[{"Length", "[", "keep", "]"}]}], ",", " ", 
      RowBox[{"\"\<signatures\>\"", " ", "->", " ", 
       RowBox[{"Length", "[", "grouped", "]"}]}], ",", "\n", "      ", 
      RowBox[{"\"\<ambiguous\>\"", " ", "->", " ", 
       RowBox[{"Count", "[", 
        RowBox[{"grouped", ",", " ", 
         RowBox[{"alt_", " ", "/;", " ", 
          RowBox[{
           RowBox[{"Length", "[", "alt", "]"}], " ", ">", " ", "1"}]}]}], 
        "]"}]}]}], "|>"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[72]:= ",ExpressionUUID->"719ae17a-c654-ed44-27b9-f927f3e6b7ae"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"accepted faults\"\>", "\[Rule]", "484"}], ",", 
   RowBox[{"\<\"signatures\"\>", "\[Rule]", "67"}], ",", 
   RowBox[{"\<\"ambiguous\"\>", "\[Rule]", "0"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[72]= ",ExpressionUUID->"62c8f42b-c628-388a-12f7-ee74f3c28ad0"]
}, Open  ]],

Cell[TextData[{
 "That zero is the fault-tolerance property, and getting it to show up in the \
",
 StyleBox["rate", "TI"],
 " took fixing the decoder to match. The decoder only ever runs on an \
accepted shot, so a fault that trips a verification check cannot have \
happened; leaving it in the hypothesis space let the lightest-set rule claim \
a detector pattern on behalf of a fault the experiment had already discarded, \
and that claim displaced the real explanation. The table is now built from \
the accepted rows. It is the decoder-side twin of the filter the measurement \
gadget applies to its residual weight \[LongDash] both statements are \
conditional on acceptance, and both are wrong if the condition is dropped on \
one side only."
}], "Text",ExpressionUUID->"36e5ffeb-8179-694d-5e9a-f6b5300c3b97"],

Cell[TextData[{
 "So, the number this layer was built to produce. The five-qubit code has \
distance three, so at code capacity its rate starts at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7af061c8-c44a-ae8e-2a80-7895edfcf4d4"],
 ": any one error is corrected. With the bare-ancilla extraction it starts at \
",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d437dad-8290-de9a-3b71-74f7372aa4e0"],
 ". With a transversal one the exponent comes back \[LongDash] measured, by \
evaluating the rate at two physical rates a factor of two apart and reading \
the slope off:"
}], "Text",ExpressionUUID->"7aafc905-908a-67da-2a54-e16f213f4d20"],

