Cell[TextData[{
 "That is the restriction ",
 Cell[BoxData["QECErrorCorrection"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "571f0194-b08e-3ab4-7d24-98d1c138889e"],
 " enforces, seen at its source rather than at the gadget that inherits it."
}], "Text",ExpressionUUID->"79764466-e076-5945-2f0e-5e4391032baf"],

Cell[TextData[{
 "One detail worth keeping, because it is what makes the group test the one \
that decides. On the five-qubit code the ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"54e8dec7-14b1-519a-7c97-d7a19d4423e0"],
 StyleBox[" half of the action still comes out right",
  FontWeight->"Bold"],
 " \[LongDash] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25f5c72f-3423-741a-538a-de89bdd65f60"],
 " does map to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "1"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dbbd446-5835-e39a-1b58-ce2059c1b1e0"],
 ", exactly as a CNOT would. Only the ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d34e655-b983-17e8-14cb-f81f38367d32"],
 " half breaks:"
}], "Text",ExpressionUUID->"5c435daa-0d1c-c5df-0471-54f4a4aeaf25"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"reg5", " ", "=", " ", 
      RowBox[{"QECRegister", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", "2"}], 
       "]"}]}], ",", " ", "act", ",", " ", "x", ",", " ", "z", ",", " ", 
     "prod"}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"act", " ", "=", " ", 
     RowBox[{"reg5", "[", 
      RowBox[{"\"\<LogicalAction\>\"", ",", " ", "1", ",", " ", "2"}], 
      "]"}]}], ";", "\n", "    ", 
    RowBox[{"x", " ", "=", " ", 
     RowBox[{"QECPauliString", " ", "/@", " ", 
      RowBox[{
       RowBox[{"reg5", "[", "\"\<LogicalVectors\>\"", "]"}], "[", "\"\<X\>\"",
        "]"}]}]}], ";", "\n", "    ", 
    RowBox[{"z", " ", "=", " ", 
     RowBox[{"QECPauliString", " ", "/@", " ", 
      RowBox[{
       RowBox[{"reg5", "[", "\"\<LogicalVectors\>\"", "]"}], "[", "\"\<Z\>\"",
        "]"}]}]}], ";", "\n", "    ", 
    RowBox[{
     RowBox[{"prod", "[", 
      RowBox[{"s1_", ",", " ", "s2_"}], "]"}], " ", ":=", " ", 
     RowBox[{"QECPauliString", "[", 
      RowBox[{"QECPauliProduct", "[", 
       RowBox[{"s1", ",", " ", "s2"}], "]"}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Z half behaves\>\"", " ", "->", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"act", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Z\>\"", ",", " ", "2", ",", " ", "1"}], "}"}], "]"}], 
         " ", "===", " ", 
         RowBox[{"prod", "[", 
          RowBox[{
           RowBox[{"z", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"z", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ")"}]}], ",", "\n", 
      "      ", 
      RowBox[{"\"\<X half behaves\>\"", " ", "->", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"act", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<X\>\"", ",", " ", "1", ",", " ", "1"}], "}"}], "]"}], 
         " ", "===", " ", 
         RowBox[{"prod", "[", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"x", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ")"}]}]}], "|>"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[78]:= ",ExpressionUUID->"21714cd0-c04e-e57a-570f-659df1f8cc40"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Z half behaves\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"X half behaves\"\>", "\[Rule]", "False"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[78]= ",ExpressionUUID->"74ff421b-073b-c6d4-1c85-6445b2cfac3e"]
}, Open  ]],

Cell["\<\
Checking the logical action alone would have passed half the time and been \
wrong.\
\>", "Text",ExpressionUUID->"3ebc3a74-dd7c-3fa6-6643-bc31d40e858c"],

Cell["The gates a code gives you for free", "Section",ExpressionUUID->"7d5c93fe-a057-3a16-2b63-0abbd1e3897c"],

Cell[TextData[{
 "A code that can only remember is half a code. Chapter 11 asks the other \
half: which gates can act on the encoded qubit ",
 StyleBox["without", "TI"],
 " letting one fault spread inside a block? For a stabilizer code the \
question turns out to be one about symmetry. Apply the same one-qubit gate ",
 Cell[BoxData[
  FormBox[
   StyleBox["U", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "487dadd0-5ed6-7873-7802-449a5b634b59"],
 " to every qubit of the block, separately. If that map sends the stabilizer \
group to itself, the gate is a valid gadget \[LongDash] and whatever it then \
does to ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["X", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5219761b-8a64-c9ff-0227-68452f169bc5"],
 " and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69346765-6d1c-e9c9-18cc-7f4f04aebb13"],
 " is the logical gate you have performed."
}], "Text",ExpressionUUID->"7c22b8c2-70f4-0562-25d1-31ac00816c48"],

Cell[TextData[{
 Cell[BoxData["QECTransversalGate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04fec585-b88c-469b-2c85-dcef39392ce1"],
 " asks both halves and answers with the second. The Hadamard on the \
seven-qubit code:"
}], "Text",ExpressionUUID->"7aa617d4-4041-969d-2a5d-8e9e71f5fce7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECTransversalGate", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", 
    " ", "\"\<H\>\""}], "]"}], "[", "\"\<LogicalAction\>\"", "]"}]], "Input",
 CellLabel->
  "In[79]:= ",ExpressionUUID->"5e86e5c8-d785-1389-06bd-fc95e23061d3"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\<\"X\"\>", ",", "1"}], "}"}], "\[Rule]", "\<\"Z\"\>"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\<\"Z\"\>", ",", "1"}], "}"}], "\[Rule]", "\<\"X\"\>"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[79]= ",ExpressionUUID->"3582ea65-851b-2569-63b1-0c4f2caf8fb3"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["X", "TI"], "_"], "\[Rule]", 
    OverscriptBox[
     StyleBox["Z", "TI"], "_"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e81d752-d9a7-cf7a-06be-cf1fd8539240"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "\[Rule]", 
    OverscriptBox[
     StyleBox["X", "TI"], "_"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dc17641-57cc-3497-1bff-682b627e9efd"],
 ": the transversal Hadamard is the logical Hadamard (eq. \
11.18\[Dash]11.19)."
}], "Text",ExpressionUUID->"647a9320-5a37-336f-0c19-0a8a5fc381b5"],

Cell[TextData[{
 "Now ask the same of ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57b40e76-1aa6-da65-7d4b-a0309f50a94f"],
 ", and the answer is not the one the name suggests:"
}], "Text",ExpressionUUID->"575b10e3-003a-b957-7d78-89cdb1cc0bbd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"QECTransversalGate", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", 
       " ", "\"\<S\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<logical action\>\"", " ", "->", " ", 
      RowBox[{"s", "[", "\"\<LogicalAction\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<logical gate\>\"", " ", "->", " ", 
      RowBox[{"s", "[", "\"\<LogicalGate\>\"", "]"}]}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[80]:= ",ExpressionUUID->"7c7345dd-208f-a284-2401-5c87513bf0ee"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"logical action\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\<\"X\"\>", ",", "1"}], "}"}], "\[Rule]", "\<\"-Y\"\>"}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\<\"Z\"\>", ",", "1"}], "}"}], "\[Rule]", "\<\"Z\"\>"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"logical gate\"\>", "\[Rule]", "\<\"Sdg\"\>"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[80]= ",ExpressionUUID->"0121a537-2575-8479-30de-3d714c01ef43"]
}, Open  ]],

Cell[TextData[{
 StyleBox["One minus sign, and it is a different gate.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["X", "TI"], "_"], "\[Rule]", "-", 
    OverscriptBox[
     StyleBox["Y", "TI"], "_"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f325126-465a-e19d-26c2-488073ecb3e7"],
 " with ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "739af998-c5c1-31b3-21b9-f0c5ec758399"],
 " fixed is the action of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "\[Dagger]"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "003becda-d908-4451-31d8-0587d8bd2ebb"],
 ", not of ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aeb468a-2cc6-59e2-2ae9-5fd445732bc8"],
 ". The transversal ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3873a668-04d7-31ac-6800-3832ad6383f6"],
 " performs the ",
 StyleBox["inverse", "TI"],
 " of the gate it is built from \[LongDash] so if you want the logical ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4156c81a-8a68-59d7-776d-e2442f1d2b3d"],
 " on this code, you apply the transversal ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "\[Dagger]"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e7ab4-00f8-e339-7ea6-73feb172ce03"],
 "."
}], "Text",ExpressionUUID->"0b3ec616-de69-0141-3ac5-d853db1c53ab"],

Cell["\<\
The sign is one line of Pauli algebra, and it is worth seeing on its own:\
\>", "Text",ExpressionUUID->"7c0d57bf-7ae8-3253-2433-4ef97e8280b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QECPauliString", "[", 
  RowBox[{"QECPauliProduct", "[", 
   RowBox[{"\"\<XXXXXXX\>\"", ",", " ", "\"\<ZZZZZZZ\>\""}], "]"}], 
  "]"}]], "Input",
 CellLabel->
  "In[81]:= ",ExpressionUUID->"0aaecb0d-dff0-cd78-3a55-e356d98a9442"],

Cell[BoxData["\<\"iYYYYYYY\"\>"], "Output",
 CellLabel->
  "Out[81]= ",ExpressionUUID->"4fe4a286-576e-fd11-759b-3be06218c47b"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["X", "TI"], "_"], 
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "\[LongEqual]", 
    StyleBox["i", "TI"], " ", 
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     RowBox[{"\[CircleTimes]", "7"}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07179650-9fbb-2bc1-2d2c-081a1a4e792b"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["Y", "TI"], "_"], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    OverscriptBox[
     StyleBox["X", "TI"], "_"], 
    OverscriptBox[
     StyleBox["Z", "TI"], "_"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aecd320-e31f-2936-2a93-ca8d96aa781c"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     RowBox[{"\[CircleTimes]", "7"}]], "\[LongEqual]", "-", 
    OverscriptBox[
     StyleBox["Y", "TI"], "_"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "326b0854-5043-0b63-6268-a21e61f65649"],
 " (eq. 11.22). Seven copies of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Y", "TI"], "\[LongEqual]", 
    StyleBox["i", "TI"], 
    StyleBox["X", "TI"], 
    StyleBox["Z", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d6edc53-4ce5-e0f2-4b15-d61d6491b2d8"],
 " do not give the logical ",
 Cell[BoxData[
  FormBox[
   StyleBox["Y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45f7e4e6-4e1c-a184-738c-fdc06baef3ee"],
 "; they give minus it."
}], "Text",ExpressionUUID->"70e98525-204e-6ba4-2096-1c8f51fb398e"],

Cell[TextData[{
 "This is the one place in the layer where a sign carries the answer. \
Everywhere else \[LongDash] the Pauli frame, the detector model, the whole \
memory experiment \[LongDash] conjugation modulo sign was enough, and the \
frame propagator drops phases for good reasons. Here a sign-blind conjugation \
reports \"S\" and is wrong, so this file carries the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z",
     FontSlant->"Plain"], "4"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "704169dd-a4db-5005-207e-8086cd6e236f"],
 " phase through every step and asks membership of a routine that knows a \
generator's true phase."
}], "Text",ExpressionUUID->"7b2d1c14-5aff-cd5f-2ad2-965e5e8b97a5"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "\[Dagger]"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62ac11c1-6d0b-a8c0-1253-88ab04bffa2a"],
 " is not an accident of ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e7621e1-2fba-a33a-560d-b8cb4a4c0e00"],
 ". The transversal ",
 Cell[BoxData[
  FormBox[
   StyleBox["U", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15938457-0322-a4d9-43a0-1e11b6d40e23"],
 " performs the logical ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["U", "TI"], "*"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f1ed2e3-b722-4b37-2525-cbccc2d7161d"],
 ", the complex conjugate, which is visible across the whole one-qubit gate \
set at once:"
}], "Text",ExpressionUUID->"52e63e44-9d5c-26a1-029d-b02e14ee8c8b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dataset", " ", "@", " ", 
  RowBox[{"AssociationMap", "[", "\n", "    ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"QECTransversalGate", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", "#"}], 
       "]"}], "[", "\"\<LogicalGate\>\"", "]"}], " ", "&"}], ",", "\n", 
    "    ", 
    RowBox[{"{", 
     RowBox[{"\"\<H\>\"", ",", " ", "\"\<S\>\"", ",", " ", "\"\<Sdg\>\"", ",",
       " ", "\"\<V\>\"", ",", " ", "\"\<Vdg\>\"", ",", " ", "\"\<X\>\"", ",", 
      " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\""}], "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[82]:= ",ExpressionUUID->"6e766a94-5ec6-6187-160d-83de5b7333ed"],

