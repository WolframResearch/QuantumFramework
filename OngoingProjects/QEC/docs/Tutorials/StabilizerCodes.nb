Cell["\<\
Below one half the longer code is better and the gap widens with n; above it \
the order reverses. That crossing is the whole argument for error correction, \
and here it is an exact statement about three polynomials rather than a claim \
about three sampled curves.\
\>", "Text",ExpressionUUID->"66c9a615-af45-c085-0ef6-385ecaf192ef"],

Cell["\<\
For codes past the enumeration limit the same quantity is estimated by \
drawing errors, and the two routes are independent implementations that check \
each other:\
\>", "Text",ExpressionUUID->"0513e607-0f4c-1e20-3320-f861aaf9650a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BlockRandom", "[", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "3", "]"}], ";", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"QECLogicalErrorRate", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
        RowBox[{"QECNoiseModel", "[", 
         RowBox[{"\"\<Depolarizing\>\"", ",", " ", 
          RowBox[{"1", "/", "20"}]}], "]"}]}], "]"}], "]"}], ",", "\n", 
     "     ", 
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Depolarizing\>\"", ",", " ", 
         RowBox[{"1", "/", "20"}]}], "]"}], ",", " ", "100000"}], "]"}]}], 
    "}"}]}], "\n", "]"}]], "Input",
 CellLabel->
  "In[39]:= ",ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.03436103593964335`", ",", "0.03409`"}], "}"}]], "Output",
 CellLabel->
  "Out[39]= ",ExpressionUUID->"6833ae6a-6ac5-a2c8-19c0-40340f71f012"]
}, Open  ]],

Cell[TextData[{
 "The decoder is maximum likelihood: for each syndrome it picks the coset \
carrying the most probability, not the lightest representative. The ",
 Cell[BoxData["\"\<Decoder\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7f2999-1aee-25a5-0504-c0c39e988f8f"],
 " option chooses, and the difference is not academic. Against the lookup \
table \[LongDash] the decoder anyone can afford on a large code \[LongDash] \
coset weighing wins in two separate ways. On the degenerate nine-qubit Shor \
code, under ordinary symmetric noise, because many light errors share a coset \
and the table sees only one of them: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"13", 
    SuperscriptBox[
     StyleBox["p", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "128c7526-c883-085d-42b4-6c83e9365aa7"],
 " against ",
 Cell[BoxData[
  FormBox[
   RowBox[{"31", 
    SuperscriptBox[
     StyleBox["p", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3279c00f-c9e2-8758-6206-da68ef94eda2"],
 ". And on the Steane code under biased noise, as real hardware is, with Z \
ten times likelier than X: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"651", 
    SuperscriptBox[
     StyleBox["p", "TI"], "2"], "/", "25"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50b12ff8-e606-85f7-004e-c6a593b0efdd"],
 " against ",
 Cell[BoxData[
  FormBox[
   RowBox[{"756", 
    SuperscriptBox[
     StyleBox["p", "TI"], "2"], "/", "25"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640f47a5-4648-c62d-0c35-5e0f73e2ad77"],
 ". On a perfect code like the five-qubit one there is nothing to gain and \
the two agree exactly."
}], "Text",ExpressionUUID->"63a48922-0fac-666c-115b-208caa594cb6"],

Cell["The biased case:", "Text",ExpressionUUID->"387a9e0d-0234-0e73-6819-1057b7c15559"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Coefficient", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", "\n", "        ", 
     RowBox[{
      RowBox[{"QECLogicalErrorRate", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
        RowBox[{"QECNoiseModel", "[", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<X\>\"", " ", "->", " ", 
            RowBox[{"p", "/", "10"}]}], ",", " ", 
           RowBox[{"\"\<Y\>\"", " ", "->", " ", 
            RowBox[{"p", "/", "10"}]}], ",", " ", 
           RowBox[{"\"\<Z\>\"", " ", "->", " ", "p"}]}], "|>"}], "]"}]}], 
       "]"}], ",", "\n", "        ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], "]"}], ",",
    "\n", "    ", "p", ",", " ", "2"}], "]"}]], "Input",
 CellLabel->
  "In[40]:= ",ExpressionUUID->"3f64ca0d-9927-5f44-651b-ec5718d225ae"],

Cell[BoxData[
 FractionBox["651", "25"]], "Output",
 CellLabel->
  "Out[40]= ",ExpressionUUID->"399d1ff3-4632-be92-6fa2-96bd73c404f8"]
}, Open  ]],

Cell["Noisy syndrome extraction", "Section",ExpressionUUID->"1170384d-2f38-2c50-470f-b2174acd76ba"],

Cell["\<\
Everything so far has assumed the checks are read out perfectly. That \
assumption is the one a hardware person will not grant, and giving it up is \
what the rest of this note is about.\
\>", "Text",ExpressionUUID->"6ce33075-6d34-44a7-1490-aa3f04c12e8d"],

Cell[TextData[{
 "There are three levels, and they are the same object with different keys \
set. At ",
 StyleBox["code capacity",
  FontWeight->"Bold"],
 " the data is hit between rounds and the checks are exact \[LongDash] that \
is everything above. At the ",
 StyleBox["phenomenological",
  FontWeight->"Bold"],
 " level the checks additionally lie with some probability, which is the \
first point at which repeating the measurement means anything. At ",
 StyleBox["circuit level",
  FontWeight->"Bold"],
 " there are no \"checks\" at all: the extraction is written out as a \
subcircuit and every gate, reset and readout in it can fail; faults attach to \
circuit ",
 StyleBox["locations", "TI"],
 " with one rate per location type, which is a Pauli specialisation of the \
basic model of Gottesman's \[Section]10.1.1."
}], "Text",ExpressionUUID->"54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],

Cell[TextData[{
 "Each level drops an assumption the one before it made, but they are not \
three estimates of one number, and the middle one has a name in the \
literature that is worth carrying: Gottesman's \[Section]10.4 introduces the \
phenomenological model as the standard example of an ",
 StyleBox["optimistic",
  FontWeight->"Bold"],
 " assumption, not of a more realistic one."
}], "Text",ExpressionUUID->"6334ac9c-43f1-85c0-12cb-45c67585ef2a"],

Cell["The level is derived from what you set, not declared:", "Text",ExpressionUUID->"74397683-04f4-1d4d-1dc7-6fedac816797"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}], 
    "[", "\"\<Level\>\"", "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p", ",", " ", 
      RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "q"}]}], "]"}], 
    "[", "\"\<Level\>\"", "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<Circuit\>\"", ",", " ", "p"}], "]"}], "[", "\"\<Level\>\"", 
    "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[41]:= ",ExpressionUUID->"735e49d5-32a1-4a48-2166-609f47541892"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"CodeCapacity\"\>", ",", "\<\"Phenomenological\"\>", 
   ",", "\<\"Circuit\"\>"}], "}"}]], "Output",
 CellLabel->
  "Out[41]= ",ExpressionUUID->"335d55a2-cf9b-493d-6163-4c0fea2e1807"]
}, Open  ]],

Cell["\<\
A circuit-level model puts a rate on each kind of location. One number \
spreads over all of them; an Association sets them separately, and a missing \
key is zero, which is a clean way to ask what one kind of failure does on its \
own:\
\>", "Text",ExpressionUUID->"3bfbbd45-edb8-1b0b-6998-352e844d6651"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECNoiseModel", "[", 
   RowBox[{"\"\<Circuit\>\"", ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<TwoQubit\>\"", " ", "->", " ", "p"}], ",", " ", 
      RowBox[{"\"\<Measurement\>\"", " ", "->", " ", "q"}]}], "|>"}]}], "]"}],
   "[", "\"\<Rates\>\"", "]"}]], "Input",
 CellLabel->
  "In[42]:= ",ExpressionUUID->"045023ab-c37d-b770-2c6f-baf4f6091a5a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"OneQubit\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"TwoQubit\"\>", "\[Rule]", "p"}], ",", 
   RowBox[{"\<\"Measurement\"\>", "\[Rule]", "q"}], ",", 
   RowBox[{"\<\"Reset\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"Idle\"\>", "\[Rule]", "0"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[42]= ",ExpressionUUID->"73e8aeff-5b91-f8f4-2197-47b95e25cade"]
}, Open  ]],

Cell["\<\
Idling is modelled but stays at zero by default, and the next section says \
why that default is optimistic rather than neutral.\
\>", "Text",ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"],

Cell["The extraction circuit", "Section",ExpressionUUID->"794a4309-908b-2549-2f4a-5b53213f8f93"],

Cell[TextData[{
 "To measure a Pauli generator with an ancilla: rotate each data qubit in the \
generator's support so that its letter there becomes ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],
 ", CNOT those data qubits into the ancilla, rotate back, and measure the \
ancilla. The ancilla ends up holding the parity of the rotated qubits, which \
is the generator's eigenvalue."
}], "Text",ExpressionUUID->"15eb24b6-b946-3a65-43e8-bdf038f0894f"],

Cell[TextData[{
 "This is the circuit of Gottesman's \[Section]12.1.1, figure 12.1a, and that \
section's title is worth quoting: ",
 StyleBox["Non-Fault-Tolerant Measurement of Paulis", "TI"],
 ". The book's version puts the ancilla in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "+"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27d2a24c-1e84-19ee-4de1-44169b316b34"],
 " and applies controlled-",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "285985c7-a1c8-13eb-5866-1ca0d07d6131"],
 " from ancilla to data; conjugating each data qubit by the rotation that \
sends its letter to ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57868ed1-450c-c474-7dbd-279b6cbeaf5e"],
 " turns that into a controlled-",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c5e608e-35dc-f74f-3466-79e8bc6edd95"],
 " ladder, and since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[CenterDot]", 
    StyleBox["C", "TI"], 
    StyleBox["Z", "TI"], "\[CenterDot]", 
    StyleBox["H", "TI"], "\[LongEqual]", 
    StyleBox["C", "TI"], 
    StyleBox["N", "TI"], 
    StyleBox["O", "TI"], 
    StyleBox["T", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a1e4090-3303-05ed-4a26-59da46b66f37"],
 " the ancilla's Hadamards are absorbed into the ladder. Gate for gate it is \
the same circuit with the basis change written out rather than folded into \
\"controlled-",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10256af3-3972-af7a-41da-83bdb804f240"],
 "\"."
}], "Text",ExpressionUUID->"457602f1-d86e-ac86-730d-9bbad918f6ec"],

Cell[TextData[{
 "The rotation is ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "499f95c1-a958-6c18-7fa4-0caac8ed3762"],
 " for an ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1e874b-6d22-b8ab-3525-1f1504d40af1"],
 ", the engine's ",
 Cell[BoxData["\"\<V\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c02104f-9807-e6c4-3431-8a2919b3cc2e"],
 " \[LongDash] the square root of ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f909018-5ea1-6a32-15af-0a425b543918"],
 ", which sends ",
 Cell[BoxData[
  FormBox[
   StyleBox["Y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f4595f3-090a-1216-557a-0cbda8bf617c"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06385f5e-e9d4-4e6c-2fd8-571b886114b6"],
 " \[LongDash] for a ",
 Cell[BoxData[
  FormBox[
   StyleBox["Y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],
 ", and nothing at all for a ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9a140e-d97a-4136-69b9-8e6bd80f101c"],
 ". A single generator carrying all three letters shows every case at once:"
}], "Text",ExpressionUUID->"4f9438da-b80f-a114-75ab-b18439bbf07e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QECCode", "[", 
    RowBox[{"{", "\"\<XYZ\>\"", "}"}], "]"}], "[", "\"\<SyndromeCircuit\>\"", 
   "]"}], "[", "\"\<Instructions\>\"", "]"}]], "Input",
 CellLabel->
  "In[43]:= ",ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"R\"\>", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"H\"\>", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"V\"\>", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "1", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"H\"\>", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Vdg\"\>", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"M\"\>", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[43]= ",ExpressionUUID->"3c8746fc-db76-c487-64bd-5fb9de00aeed"]
}, Open  ]],

Cell[TextData[{
 "The bit-flip code's generators are pure ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11f0f87a-e6f0-91cd-478f-f227928ae317"],
 ", so its circuit is nothing but CNOTs and measurements \[LongDash] one \
ancilla per generator, reset before use:"
}], "Text",ExpressionUUID->"473164ce-b547-c1f4-6ecf-7da83cf393de"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], 
   "[", "\"\<SyndromeCircuit\>\"", "]"}], "[", "\"\<Instructions\>\"", 
  "]"}]], "Input",
 CellLabel->
  "In[44]:= ",ExpressionUUID->"12c4fc3b-e00c-2bba-42fb-f66491b97980"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"R\"\>", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "1", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"M\"\>", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"R\"\>", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "2", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "3", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"M\"\>", ",", "5"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[44]= ",ExpressionUUID->"1d7e6892-18cd-6f45-4b05-81dc997835af"]
}, Open  ]],

Cell["\<\
The ancillas are reset and reused between rounds, so a long experiment does \
not need more of them. Five rounds of the Steane code run on the same \
thirteen qubits as one:\
\>", "Text",ExpressionUUID->"325c8f47-cd85-89da-6263-2720e431db20"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "[", 
     RowBox[{"\"\<SyndromeCircuit\>\"", ",", " ", "1"}], "]"}], 
    "[", "\"\<Qubits\>\"", "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "[", 
     RowBox[{"\"\<SyndromeCircuit\>\"", ",", " ", "5"}], "]"}], 
    "[", "\"\<Qubits\>\"", "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[45]:= ",ExpressionUUID->"43fcea2e-12ab-c026-7183-0388a75f930c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"13", ",", "13"}], "}"}]], "Output",
 CellLabel->
  "Out[45]= ",ExpressionUUID->"5b416c07-c3d3-bf4f-097e-8660f6670595"]
}, Open  ]],

Cell["\<\
What the whole thing costs, which is also the number of places a fault can \
happen:\
\>", "Text",ExpressionUUID->"5add4728-e92e-eff1-0ae3-5f7588d8b5db"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "[", 
   RowBox[{"\"\<SyndromeCircuit\>\"", ",", " ", "3"}], "]"}], 
  "[", "\"\<GateCounts\>\"", "]"}]], "Input",
 CellLabel->
  "In[46]:= ",ExpressionUUID->"621761a3-d300-b412-122d-780ce6ba1f78"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"R\"\>", "\[Rule]", "18"}], ",", 
   RowBox[{"\<\"H\"\>", "\[Rule]", "72"}], ",", 
   RowBox[{"\<\"CNOT\"\>", "\[Rule]", "72"}], ",", 
   RowBox[{"\<\"M\"\>", "\[Rule]", "18"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[46]= ",ExpressionUUID->"5b08d465-1dcc-fb87-0937-ce4f947ec9ed"]
}, Open  ]],

Cell["\<\
Two limits are worth stating, and the first is not a rough edge. The ancillas \
are bare rather than cat-state-verified, and that is the difference between \
fault tolerant and not, not a detail alongside gate scheduling: \
\[Section]12.1.1 says of this exact circuit that \"a single faulty gate can \
cause multiple data errors, even if the fault doesn't directly affect the \
data block\". The fix is a verified ancilla feeding Shor (\[Section]12.2), \
Steane (\[Section]12.3) or Knill (\[Section]12.4) error correction. Using the \
bare version anyway is a sourced choice rather than a shortcut \[LongDash] \
\[Section]12.5.1: \"Frequently people using surface codes don't even bother \
with Shor EC, instead using the non-FT measurement technique of section \
12.1.1 instead\" \[LongDash] but that concession belongs to the surface-code \
setting and is not a general licence.\
\>", "Text",ExpressionUUID->"7d3ffb2e-09a8-fc78-24c4-f288a842c742"],

Cell[TextData[{
 "The second: generators are extracted one after another rather than \
interleaved into parallel layers, so the circuit is deeper than a real one, \
and the ",
 Cell[BoxData["\"\<Idle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4139b36b-52b1-2977-70c6-2b356744785d"],
 " rate is zero. Do not read that as idling being undefined here. \
\[Section]15.5.2 resolves an ill-defined time step by ",
 StyleBox["defining", "TI"],
 " one, the longest gate, and charging the padding as storage error; and \
\[Section]15.5.1 shows that less parallelism means ",
 StyleBox["more", "TI"],
 " waiting, multiplying the storage rate, with the flat statement that \"to \
have a threshold, it is essential to do parallel gates, at least when the \
storage error rate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["S", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "494d6e39-7750-b6eb-7f72-806302ea1c31"],
 " is non-zero\". Zero idle noise is an optimistic simplification, and it is \
optimistic in exactly the direction this circuit is already weakest."
}], "Text",ExpressionUUID->"39b01e29-d171-5c92-6f4f-9072e00426f8"],

Cell[TextData[{
 "Nothing in this circuit is taken on trust. Pushing a Pauli through the \
emitted instructions and reading the ancilla measurements has to reproduce ",
 Cell[BoxData[
  RowBox[{"code", "[", 
   RowBox[{"\"\<Syndrome\>\"", ",", " ", "\[Ellipsis]"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f6d713e-2461-11c8-7513-69784d146312"],
 ", which is a matrix product that knows nothing about circuits; the same \
circuit is also run as an actual stabilizer state on the engine and its \
checks read by expectation. Both agree, for every weight-one and weight-two \
error on all five named codes."
}], "Text",ExpressionUUID->"14ad582f-66ff-93eb-3c53-5189128be131"],

Cell["Detectors", "Section",ExpressionUUID->"4f7ea056-2d28-85ec-7505-3a1044c2ef36"],

Cell[TextData[{
 "Once a check can lie, a syndrome bit on its own is worthless: it can be \
wrong because the data was hit or because the readout misreported, and one \
round cannot tell those apart. Repeating the extraction is the old fix (\
\[Section]12.2.2). Decoding the ",
 StyleBox["differences", "TI"],
 " rather than the syndromes is a newer one, from the topological-code \
literature \[LongDash] Dennis, Kitaev, Landahl and Preskill, ",
 StyleBox["Topological quantum memory", "TI"],
 " (",
 ButtonBox["arXiv:quant-ph/0110143",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/quant-ph/0110143"], None}],
 "), where repeated noisy measurement turns the history into a lattice in one \
more dimension:"
}], "Text",ExpressionUUID->"16b00368-b832-202d-3e4f-9b3239c77377"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["D", "TI"], "1"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["S", "TI"], "1"], 
    RowBox[{",", "    "}], 
    SubscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["r", "TI"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["r", "TI"]], "\[CirclePlus]", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     RowBox[{
      StyleBox["r", "TI"], "-", "1"}]], 
    RowBox[{",", "    "}], 
    SubscriptBox[
     StyleBox["D", "TI"], 
     RowBox[{
      StyleBox["R", "TI"], "+", "1"}]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["final",
      FontSlant->"Plain"]], "\[CirclePlus]", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["R", "TI"]]}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"06d00634-a672-f252-2eef-9871d304c0b8"],

Cell[TextData[{
 "A detector is a parity that is deterministically zero when nothing goes \
wrong, so a fired detector is unambiguous evidence of a fault. The last one \
closes the experiment against a noiseless final readout, where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["final",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],
 " is the syndrome of whatever Pauli is left on the data."
}], "Text",ExpressionUUID->"583a98af-415b-100e-09d9-110970ee6354"],

Cell[TextData[{
 "Two things follow from \"deterministically zero\" that are easy to skip \
past. It assumes the data enters ",
 StyleBox["inside", "TI"],
 " the code space \[LongDash] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["D", "TI"], "1"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["S", "TI"], "1"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07beae85-a317-6bf9-2d45-47eed6a239c3"],
 " is a detector only because the experiment prepares a codeword first \
\[LongDash] so what is modelled here is a memory experiment, not an \
error-correction gadget handed a block that already carries errors. And this \
is not the book's rule. Gottesman's answer to an untrustworthy syndrome is \
repeat and ",
 StyleBox["agree", "TI"],
 ": trust a run of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],
 " consecutive identical syndromes, since at least one of them was taken with \
no faults, discard the rest, and look that single syndrome up \
(\[Section]12.2.2, \[Section]12.2.3). He raises the differencing strategy and \
sets it aside \[LongDash] \"it is difficult to analyze such strategies in the \
completely general case\" \[LongDash] so what follows computes exactly the \
thing the standard reference declines to analyse in general, and inherits \
none of its fault-tolerance guarantees."
}], "Text",ExpressionUUID->"60049622-f570-0e0e-103b-0f8ffc055554"],

Cell[TextData[{
 Cell[BoxData["QECDetectorModel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40ea559d-da93-7842-70ea-4cc6df264aa8"],
 " is the map from each individual fault to what it does: which detectors it \
fires, which logical operators it flips, and with what probability. On the \
bit-flip code with one round it is small enough to read in full \[LongDash] \
three data faults and two readout faults, four detectors:"
}], "Text",ExpressionUUID->"23ccc6ee-92c0-e596-51f3-dfc8277acffc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dem", ",", " ", "bits"}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"dem", " ", "=", " ", 
     RowBox[{"QECDetectorModel", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<BitFlip\>\"", ",", " ", "p", ",", " ", 
         RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "q"}]}], "]"}], ",",
        " ", "1"}], "]"}]}], ";", "\n", "    ", 
    RowBox[{
     RowBox[{"bits", "[", "v_", "]"}], " ", ":=", " ", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"ToString", " ", "/@", " ", "v"}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"Grid", "[", "\n", "        ", 
     RowBox[{
      RowBox[{"Prepend", "[", "\n", "            ", 
       RowBox[{
        RowBox[{"MapThread", "[", "\n", "                ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"StringRiffle", "[", 
              RowBox[{
               RowBox[{"ToString", " ", "/@", " ", "#1"}], ",", 
               " ", "\"\< \>\""}], "]"}], ",", " ", 
             RowBox[{"bits", "[", "#2", "]"}], ",", " ", 
             RowBox[{"bits", "[", "#3", "]"}], ",", " ", "#4"}], "}"}], " ", 
           "&"}], ",", "\n", "                ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"dem", "[", "\"\<Locations\>\"", "]"}], ",", " ", 
            RowBox[{"dem", "[", "\"\<DetectorMatrix\>\"", "]"}], ",", " ", 
            RowBox[{"dem", "[", "\"\<ObservableMatrix\>\"", "]"}], ",", " ", 
            RowBox[{"dem", "[", "\"\<Probabilities\>\"", "]"}]}], "}"}]}], 
         "\n", "            ", "]"}], ",", "\n", "            ", 
        RowBox[{"{", 
         RowBox[{"\"\<fault\>\"", ",", " ", "\"\<detectors\>\"", ",", 
          " ", "\"\<observables\>\"", ",", " ", "\"\<probability\>\""}], 
         "}"}]}], "\n", "        ", "]"}], ",", "\n", "        ", 
      RowBox[{"Frame", " ", "->", " ", "All"}], ",", "\n", "        ", 
      RowBox[{"FrameStyle", " ", "->", " ", 
       RowBox[{"GrayLevel", "[", "0.85", "]"}]}], ",", "\n", "        ", 
      RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", "\n", "        ", 
      RowBox[{"Background", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"None", ",", " ", 
         RowBox[{"{", 
          RowBox[{"GrayLevel", "[", "0.94", "]"}], "}"}]}], "}"}]}], ",", 
      "\n", "        ", 
      RowBox[{"ItemSize", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "Automatic", ",", " ", "8", ",", " ", "8", ",", " ", "Automatic"}], 
          "}"}], ",", " ", "Automatic"}], "}"}]}]}], "\n", "    ", "]"}]}]}], 
  "\n", "]"}]], "Input",
 CellLabel->
  "In[47]:= ",ExpressionUUID->"114d8d02-b276-9c05-4772-256fc700e76f"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"fault\"\>", "\<\"detectors\"\>", "\<\"observables\"\>", \
"\<\"probability\"\>"},
    {"\<\"Data 1 1\"\>", "\<\"1000\"\>", "\<\"00\"\>", "p"},
    {"\<\"Data 1 2\"\>", "\<\"1100\"\>", "\<\"00\"\>", "p"},
    {"\<\"Data 1 3\"\>", "\<\"0100\"\>", "\<\"01\"\>", "p"},
    {"\<\"Measurement 4\"\>", "\<\"1010\"\>", "\<\"00\"\>", "q"},
    {"\<\"Measurement 8\"\>", "\<\"0101\"\>", "\<\"00\"\>", "q"}
   },
   AutoDelete->False,
   FrameStyle->GrayLevel[0.85],
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       GrayLevel[0.94]}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{
    "Columns" -> {Automatic, 8, 8, Automatic}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellLabel->
  "Out[47]= ",ExpressionUUID->"2dc22b63-32d1-862f-5bf1-c34d4765ed75"]
}, Open  ]],

Cell[TextData[{
 "That table is the point of the construction, and it is worth reading twice. \
A data error fires its checks in round one and is ",
 StyleBox["still there", "TI"],
 " at the final readout, so the difference detectors stay quiet: one fired \
detector. A readout error fires its check in its own round and again in the \
difference against the next one: two fired detectors, and nothing left on the \
data. The two failures no longer look alike."
}], "Text",ExpressionUUID->"36ea7e2c-072a-2221-5eea-7076b2df710b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dem", " ", "=", " ", 
     RowBox[{"QECDetectorModel", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<BitFlip\>\"", ",", " ", "p", ",", " ", 
         RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "q"}]}], "]"}], ",",
        " ", "1"}], "]"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"dem", "[", "\"\<DetectorMatrix\>\"", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"dem", "[", "\"\<DetectorMatrix\>\"", "]"}], "[", 
      RowBox[{"[", "4", "]"}], "]"}]}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->
  "In[48]:= ",ExpressionUUID->"5b23761c-2477-64e8-0ad1-68464d024e32"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "1", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[48]= ",ExpressionUUID->"73216bcf-7cf1-61ac-22de-82a9748433f6"]
}, Open  ]],

Cell["\<\
The detector half of a data fault's row is exactly the syndrome computed the \
old way, which is the cheapest check there is that the circuit measures what \
it claims to:\
\>", "Text",ExpressionUUID->"69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"code", " ", "=", " ", 
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}]}], ",", " ", 
     "dem"}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"dem", " ", "=", " ", 
     RowBox[{"QECDetectorModel", "[", 
      RowBox[{"code", ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<BitFlip\>\"", ",", " ", "p", ",", " ", 
         RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "q"}]}], "]"}], ",",
        " ", "1"}], "]"}]}], ";", "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"dem", "[", "\"\<DetectorMatrix\>\"", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", 
        RowBox[{"1", " ", ";;", " ", "6"}]}], "]"}], "]"}], " ", "==", " ", 
     RowBox[{"code", "[", 
      RowBox[{"\"\<Syndrome\>\"", ",", " ", "\"\<XIIIIII\>\""}], "]"}]}]}]}], 
  "\n", "]"}]], "Input",
 CellLabel->
  "In[49]:= ",ExpressionUUID->"409bca18-cbd6-e54d-70b8-ec45ee60cf97"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[49]= ",ExpressionUUID->"10b62b5f-1d3f-f012-404d-c31994cbc378"]
}, Open  ]],

Cell[TextData[{
 "Some faults fire nothing at all and still move the logical qubit. Their \
existence is not a bug: they are the circuit-level analogue of a logical \
operator. Under depolarizing noise the bit-flip code has exactly three of \
them \[LongDash] the single ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79984792-c453-565a-2fb8-5edfede63ca0"],
 " errors \[LongDash] which is the circuit-level way of saying it has no \
phase protection:"
}], "Text",ExpressionUUID->"1d45428e-8fa1-6801-4b7b-5be82a543b6b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECDetectorModel", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p", ",", " ", 
      RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "q"}]}], "]"}], ",",
     " ", "1"}], "]"}], "[", "\"\<UndetectableFaults\>\"", "]"}]], "Input",
 CellLabel->
  "In[50]:= ",ExpressionUUID->"604bb87d-3174-a116-1048-32274006f07c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"Data\"\>", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Data\"\>", ",", "1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Data\"\>", ",", "1", ",", "3"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[50]= ",ExpressionUUID->"763191a2-6f8b-197a-1fce-080c0a3e6840"]
}, Open  ]],

Cell["\<\
Every detector's firing rate is available in closed form, which is the \
natural quantity to check an external simulator against \[LongDash] it is \
basis-free and every detector is a separate test. With the data noise \
switched off, each detector fires exactly when its own readout lies:\
\>", "Text",ExpressionUUID->"635fdfdb-2856-deda-1164-d68549e0a420"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", " ", "@", " ", 
  RowBox[{
   RowBox[{"QECDetectorModel", "[", 
    RowBox[{
     RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
     RowBox[{"QECNoiseModel", "[", 
      RowBox[{"\"\<BitFlip\>\"", ",", " ", "0", ",", " ", 
       RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "q"}]}], "]"}], ",",
      " ", "1"}], "]"}], "[", "\"\<DetectorRates\>\"", "]"}]}]], "Input",
 CellLabel->
  "In[51]:= ",ExpressionUUID->"0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"q", ",", "q", ",", "q", ",", "q"}], "}"}]], "Output",
 CellLabel->
  "Out[51]= ",ExpressionUUID->"5c8469dd-bfc7-2a7a-04bb-80873a727940"]
}, Open  ]],

Cell["The memory experiment", "Section",ExpressionUUID->"182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],

Cell[TextData[{
 "Prepare a codeword, run ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3921e4bb-f5e4-3596-68de-fde483969ffc"],
 " rounds of noisy extraction, read the data out perfectly at the end, decode \
the whole detector history, and ask whether the logical qubit survived."
}], "Text",ExpressionUUID->"13db9173-5387-1c16-41f8-093d6632677c"],

Cell[TextData[{
 Cell[BoxData["\"\<Rounds\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6804c0ab-fd16-b7db-183b-d9f4f4a01d21"],
 " says how many and defaults to the code distance. That is the \
topological-memory convention: fewer rounds than the distance protects the \
time direction less than the space ones, which quietly caps the whole thing. \
It is deliberately not the book's criterion, and the two should not be \
conflated \[LongDash] \[Section]12.2.2 asks instead for a run of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],
 " ",
 StyleBox["agreeing", "TI"],
 " syndrome measurements, proves ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["t", "TI"], "+", "1"}], ")"}], "2"], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4289b0c6-8043-1b93-72b6-29a031f669f9"],
 " repetitions enough to find one, and explicitly rejects ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["t", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070f3e08-556d-9d60-2d34-b0525c19e44a"],
 " repetitions with a majority vote, \"since there are ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    RowBox[{
     StyleBox["n", "TI"], "-", 
     StyleBox["k", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],
 " possible values of the syndrome \[Ellipsis] There might not be a \
majority\". That criterion buys a fault-tolerance guarantee; this default \
buys a memory experiment whose time and space directions are equally \
protected."
}], "Text",ExpressionUUID->"4140e475-1e41-1f16-777f-fe3f9bf4627c"],

Cell[TextData[{
 "The identity that ties all of this to the earlier sections: a \
phenomenological model with perfect readout, run for one round, ",
 StyleBox["is", "TI"],
 " code-capacity noise. Its rate had better be the same polynomial, and it is:"
}], "Text",ExpressionUUID->"67f13035-938c-831a-0d8e-aa7f263eee60"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"QECLogicalErrorRate", "[", 
    RowBox[{
     RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
     RowBox[{"QECNoiseModel", "[", 
      RowBox[{"\"\<BitFlip\>\"", ",", " ", "p", ",", " ", 
       RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "0"}]}], "]"}], ",",
      " ", 
     RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}], " ", "==", 
   "\n", "        ", 
   RowBox[{"QECLogicalErrorRate", "[", 
    RowBox[{
     RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
     RowBox[{"QECNoiseModel", "[", 
      RowBox[{"\"\<BitFlip\>\"", ",", " ", "p"}], "]"}]}], "]"}]}], "\n", 
  "]"}]], "Input",
 CellLabel->
  "In[52]:= ",ExpressionUUID->"16b44e14-0404-e868-3e4c-605eadb6bab2"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[52]= ",ExpressionUUID->"70bc3c38-1a7f-2cd8-2043-b6629f0a7622"]
}, Open  ]],

Cell["\<\
That one line exercises the circuit emitter, the frame propagation, the \
detector definition, the fault enumeration and the exact sum at once, against \
an answer already checked against a binomial tail.\
\>", "Text",ExpressionUUID->"7e10bd94-ae42-3b4d-262f-34d1cbf48997"],

Cell[TextData[{
 "The rate is still exact, and now in two variables. Setting either to zero \
recovers a limit worth knowing: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"],
 " gives back ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", 
    SuperscriptBox[
     StyleBox["p", "TI"], "2"], "-", "2", 
    SuperscriptBox[
     StyleBox["p", "TI"], "3"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b734859-75e7-efa6-7901-62030393b58c"],
 " gives ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["q", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ae31c17-eefa-a706-7a90-96508a8c0a6c"],
 " \[LongDash] with no data errors at all, a single readout lie is recognised \
by its two-detector signature and corrected, so failure needs two of them:"
}], "Text",ExpressionUUID->"00844d77-2817-3ec6-30bc-653149a3842c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Expand", " ", "@", " ", 
  RowBox[{"QECLogicalErrorRate", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], ",", " ", 
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<BitFlip\>\"", ",", " ", "p", ",", " ", 
      RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "q"}]}], "]"}], ",",
     " ", 
    RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[53]:= ",ExpressionUUID->"20b97f64-b973-0c8a-5047-774e380656d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"3", " ", 
   SuperscriptBox["p", "2"]}], "-", 
  RowBox[{"2", " ", 
   SuperscriptBox["p", "3"]}], "+", 
  RowBox[{"6", " ", "p", " ", "q"}], "-", 
  RowBox[{"12", " ", 
   SuperscriptBox["p", "2"], " ", "q"}], "+", 
  RowBox[{"6", " ", 
   SuperscriptBox["p", "3"], " ", "q"}], "+", 
  SuperscriptBox["q", "2"], "-", 
  RowBox[{"6", " ", "p", " ", 
   SuperscriptBox["q", "2"]}], "+", 
  RowBox[{"9", " ", 
   SuperscriptBox["p", "2"], " ", 
   SuperscriptBox["q", "2"]}], "-", 
  RowBox[{"4", " ", 
   SuperscriptBox["p", "3"], " ", 
   SuperscriptBox["q", "2"]}]}]], "Output",
 CellLabel->
  "Out[53]= ",ExpressionUUID->"04469009-6b02-dcc3-2c7d-0a530eb4a629"]
}, Open  ]],

Cell[TextData[{
 "This is the part no sampling simulator can do, and it is worth saying how \
it is possible. Enumerating fault configurations would mean ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "faults"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],
 " of them, which is hopeless. Instead the ",
 StyleBox["distribution over effects", "TI"],
 " is carried \[LongDash] a vector indexed by the possible \
detector-and-observable patterns \[LongDash] and the locations are folded in \
one at a time,"
}], "Text",ExpressionUUID->"5547dfb6-0e84-e145-037c-d6f0ab36b3af"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["P", "TI"], "\[Prime]"], 
    RowBox[{"[", 
     StyleBox["s", "TI"], "]"}], "\[LongEqual]", 
    StyleBox["P", "TI"], 
    RowBox[{"[", 
     StyleBox["s", "TI"], "]"}], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      UnderscriptBox["\[Sum]", 
       StyleBox["i", "TI"],
       LimitsPositioning->True], 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["i", "TI"]]}], ")"}], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["i", "TI"],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["i", "TI"]], " ", 
    StyleBox["P", "TI"], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["s", "TI"], "\[CirclePlus]", 
      SubscriptBox["\[Sigma]", 
       StyleBox["i", "TI"]]}], "]"}]}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"12b61bfc-9cd7-eca9-424d-92a61563b6f3"],

Cell[TextData[{
 "the inner sum running over the mutually exclusive outcomes of a single \
location, so a three-way depolarizing channel is handled exactly rather than \
as three independent coins. The cost is locations times state space rather \
than ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "faults"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "451364b5-819d-fb99-7321-7dff3029c9e3"],
 ", and the state space \[LongDash] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       StyleBox["r", "TI"], "+", "1"}], ")"}], 
     StyleBox["m", "TI"], "+", "2", 
     StyleBox["k", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13b49e24-0fb7-4441-414b-178eaa422eab"],
 " \[LongDash] is what bounds it, through ",
 Cell[BoxData["$QECExactDetectorLimit"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],
 "."
}], "Text",ExpressionUUID->"089aa42d-ce49-3603-38b9-3e76ebfd9d69"],

Cell["\<\
Past that bound the same quantity is sampled, and the two routes check each \
other. The Steane code at circuit level, exactly and then over two hundred \
thousand shots:\
\>", "Text",ExpressionUUID->"48fccab3-b886-a0f7-7883-e3fd3930f2dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BlockRandom", "[", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "11", "]"}], ";", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"QECLogicalErrorRate", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
        RowBox[{"QECNoiseModel", "[", 
         RowBox[{"\"\<Circuit\>\"", ",", " ", 
          RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", 
        RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], ",", "\n",
      "     ", 
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Circuit\>\"", ",", " ", 
         RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", "200000", ",", " ", 
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], "}"}]}], 
  "\n", "]"}]], "Input",
 CellLabel->
  "In[54]:= ",ExpressionUUID->"0cdaad60-2181-5e26-34f9-454a5034250c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.0038004875014007356`", ",", "0.00387`"}], "}"}]], "Output",
 CellLabel->
  "Out[54]= ",ExpressionUUID->"542cff75-84e0-b601-7dd3-f73f2c9a1d6b"]
}, Open  ]],

Cell[TextData[{
 "Because all three levels give polynomials, the price of honesty about noise \
is a picture rather than an argument. The same code, the same rate ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00dd9d4d-f7ec-565f-30e2-151681993ca5"],
 ", three noise models:"
}], "Text",ExpressionUUID->"0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"bf", " ", "=", " ", 
      RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}]}], ",", " ", 
     "capacity", ",", " ", "phenomenological", ",", " ", "circuit"}], "}"}], ",",
    "\n", "    ", 
   RowBox[{
    RowBox[{"capacity", " ", "=", " ", 
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{"bf", ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<BitFlip\>\"", ",", " ", "p"}], "]"}]}], "]"}]}], ";", 
    "\n", "    ", 
    RowBox[{"phenomenological", " ", "=", " ", 
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{"bf", ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<BitFlip\>\"", ",", " ", "p", ",", " ", 
         RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "p"}]}], "]"}], ",",
        " ", 
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], ";", "\n", 
    "    ", 
    RowBox[{"circuit", " ", "=", " ", 
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{"bf", ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Circuit\>\"", ",", " ", "p"}], "]"}], ",", " ", 
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], ";", "\n", 
    "    ", 
    RowBox[{"Plot", "[", "\n", "        ", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{"{", 
        RowBox[{
        "capacity", ",", " ", "phenomenological", ",", " ", "circuit"}], 
        "}"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "0", ",", " ", 
        RowBox[{"1", "/", "5"}]}], "}"}], ",", "\n", "        ", 
      RowBox[{"PlotLegends", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<code capacity\>\"", ",", " ", "\"\<phenomenological\>\"",
          ",", " ", "\"\<circuit\>\""}], "}"}]}], ",", "\n", "        ", 
      RowBox[{"AxesLabel", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<physical error rate\>\"", ",", 
         " ", "\"\<logical error rate\>\""}], "}"}]}], ",", "\n", "        ", 
      
      RowBox[{"ImageSize", " ", "->", " ", "380"}]}], "\n", "    ", "]"}]}]}],
   "\n", "]"}]], "Input",
 CellLabel->
  "In[55]:= ",ExpressionUUID->"3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],

