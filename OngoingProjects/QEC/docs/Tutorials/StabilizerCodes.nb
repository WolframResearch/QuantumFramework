Cell[TextData[{
 "One and two. That is the hook error shown to be a defect of the ",
 StyleBox["gadget", "TI"],
 " rather than a property of circuit-level noise \[LongDash] which is what \
\[Section]10.2 exists to make possible, and what the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"29", 
    StyleBox["p", "TI"], "/", "5"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "260c3025-1fa9-9acd-4e33-a98f9a5de817"],
 " two sections above was the price of not having."
}], "Text",ExpressionUUID->"4b1e6c2c-0452-4134-7925-8676ade7101e"],

Cell[TextData[{
 "Two things that number is not. It is a ",
 StyleBox["post-selected",
  FontWeight->"Bold"],
 " rate, and the acceptance travels with it \[LongDash] about 0.98 at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "\[LongEqual]", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2982aea8-af87-65d7-5fb1-47f5ca324f3d"],
 ", and the layer reports it rather than quietly dividing it out:"
}], "Text",ExpressionUUID->"19ac3a5e-0cd6-873c-4f53-bc18a560ea06"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", " ", "@", " ", 
  RowBox[{"QECLogicalErrorRate", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<Circuit\>\"", ",", " ", 
      RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", "All", ",", "\n", "    ", 
    RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}], ",", " ", 
    RowBox[{"\"\<Extraction\>\"", " ", "->", " ", "\"\<Transversal\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[95]:= ",ExpressionUUID->"6e8690e9-968f-68b3-16bd-09b3233a3a99"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Rate\"\>", "\[Rule]", "0.002053129017489557`"}], ",", 
   RowBox[{"\<\"Acceptance\"\>", "\[Rule]", "0.9797115213492601`"}], ",", 
   RowBox[{"\<\"Failure\"\>", "\[Rule]", "0.0020114741532510057`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[95]= ",ExpressionUUID->"2b6bc1ec-c569-bd9f-5968-d8c9ec1d07e5"]
}, Open  ]],

Cell["\<\
The rate is the failure divided by the acceptance. And it still rests on the \
ancilla preparation being clean, since the cat is built by a \
non-fault-tolerant chain and only its dangerous patterns are checked; that is \
the same chapter-13 assumption Steane EC names, and it is why the four \
ambiguous signatures existed to be conditioned away in the first place.\
\>", "Text",ExpressionUUID->"25f1a39a-81e0-db80-538e-3ac4379aa9ea"],

Cell["Several blocks, and the gate between them", "Section",ExpressionUUID->"35466be2-b7a8-26dc-637d-82cfc2428c26"],

Cell[TextData[{
 "Everything so far lives on one block. A ",
 Cell[BoxData["QECCode"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58bdea72-0ba3-5f4c-0842-0c3cae562596"],
 " is ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e8cef58-e908-949c-16b3-070588a2fee6"],
 " physical qubits carrying ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0abc4047-6c7b-4886-3a44-5a21050e1aec"],
 " logical ones, and a circuit numbers its qubits ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[Ellipsis]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24e21d63-fe6b-5877-4c91-954cfb1e2b5d"],
 " with ancillas after \[LongDash] which is enough for a memory experiment, \
and is why the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348d2737-4aeb-e3cb-5cb2-bf716e9fb111"],
 " above could be measured without any of this. It is not enough for anything \
that computes."
}], "Text",ExpressionUUID->"2161c865-0900-0907-571e-e24fa8b5586d"],

Cell[TextData[{
 StyleBox["A logical qubit is a block.",
  FontWeight->"Bold"],
 " So a logical two-qubit gate is a gate between two blocks, and Theorem 13.2 \
needs ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["m", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cadbe4b-a339-c651-6452-3014d6cdacbb"],
 " blocks for a gate touching ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31169419-f57b-983b-672d-0e42fc0feb01"],
 " of them. ",
 Cell[BoxData["QECRegister"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40aa99e8-53bd-499c-70a9-10b266481be6"],
 " is where blocks become addressable. Block ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d165407-aaf3-867b-0b2e-4e60ce87ed41"],
 " owns qubits ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["b", "TI"], "-", "1"}], ")"}], 
    StyleBox["n", "TI"], "+", "1", "\[Ellipsis]", 
    StyleBox["b", "TI"], 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75cb8946-a0dc-0da7-23c8-2123d169578d"],
 ", stated once so that nothing has to guess it:"
}], "Text",ExpressionUUID->"63688a50-35e7-99e6-1117-2c1a4393ebcc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"reg", " ", "=", " ", 
     RowBox[{"QECRegister", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", "2"}], 
      "]"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"reg", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Blocks\>\"", ",", " ", "\"\<BlockQubits\>\"", ",", 
       " ", "\"\<Qubits\>\"", ",", " ", "\"\<StabilizerCount\>\"", ",", 
       " ", "\"\<LogicalQubits\>\""}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[96]:= ",ExpressionUUID->"12187c95-2034-8b29-4238-75df51c6d673"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Blocks\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"BlockQubits\"\>", "\[Rule]", "7"}], ",", 
   RowBox[{"\<\"Qubits\"\>", "\[Rule]", "14"}], ",", 
   RowBox[{"\<\"StabilizerCount\"\>", "\[Rule]", "12"}], ",", 
   RowBox[{"\<\"LogicalQubits\"\>", "\[Rule]", "2"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[96]= ",ExpressionUUID->"34b193bd-0a67-a7a6-5c4e-0ae7af130d8c"]
}, Open  ]],

Cell[TextData[{
 "A single-block circuit moves into a block with ",
 Cell[BoxData["\"\<Lift\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fca8ec2-4b73-3b52-75c9-27ac6e0789b8"],
 ", which touches the qubit slots and nothing else:"
}], "Text",ExpressionUUID->"656925a1-dac3-d209-1316-bc0adf77a153"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECRegister", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", "2"}], 
   "]"}], "[", 
  RowBox[{"\"\<Lift\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<R\>\"", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<H\>\"", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<CNOT\>\"", ",", " ", "1", ",", " ", "2"}], "}"}]}], "}"}], 
   ",", " ", "2"}], "]"}]], "Input",
 CellLabel->
  "In[97]:= ",ExpressionUUID->"09e13884-5cc5-f650-3f9e-b1ee5571dcba"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"R\"\>", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"H\"\>", ",", "9"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "8", ",", "9"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[97]= ",ExpressionUUID->"29829495-262a-abaa-5fb1-0ddf53dcf9f0"]
}, Open  ]],

Cell["\<\
A register of one block is the identity on all of it \[LongDash] same label \
matrix, same generators, same circuits \[LongDash] which is what keeps the \
rest of the layer unaffected by this existing.\
\>", "Text",ExpressionUUID->"136212ad-a4c2-b9f3-4111-8bf6cd740bd9"],

Cell[TextData[{
 "The one gate between blocks is the ",
 StyleBox["transversal CNOT",
  FontWeight->"Bold"],
 ": a CNOT applied qubit by qubit, so each qubit of one block touches exactly \
the corresponding qubit of the other and nothing else. That is the property \
that stops a single fault from spreading inside either block, and it is the \
one Steane error correction already rested on two sections ago."
}], "Text",ExpressionUUID->"67f6b273-a0bf-ee61-0d8d-343cd14bb54b"],

Cell["\<\
It was cited there. Here it is checked, by conjugating the logical operators \
through the gate and reading the images off:\
\>", "Text",ExpressionUUID->"07a2a6c0-d7ac-3784-2d51-3fade25e9dee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECRegister", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", "2"}], 
   "]"}], "[", 
  RowBox[{"\"\<LogicalAction\>\"", ",", " ", "1", ",", " ", "2"}], 
  "]"}]], "Input",
 CellLabel->
  "In[98]:= ",ExpressionUUID->"7d29df82-54ab-6c21-24d6-d6ec5d5e370b"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\<\"X\"\>", ",", "1", ",", "1"}], "}"}], 
    "\[Rule]", "\<\"IIXIXXIIIXIXXI\"\>"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\<\"X\"\>", ",", "2", ",", "1"}], "}"}], 
    "\[Rule]", "\<\"IIIIIIIIIXIXXI\"\>"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\<\"Z\"\>", ",", "1", ",", "1"}], "}"}], 
    "\[Rule]", "\<\"IZIZIZIIIIIIII\"\>"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\<\"Z\"\>", ",", "2", ",", "1"}], "}"}], 
    "\[Rule]", "\<\"IZIZIZIIZIZIZI\"\>"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[98]= ",ExpressionUUID->"2673b224-f5d9-a24c-4e00-2b81fc6df096"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["X", "TI"], "_"], "1"], "\[Rule]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["X", "TI"], "_"], "1"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["X", "TI"], "_"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27388ee6-22a7-f122-4ec7-27c05753c008"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["X", "TI"], "_"], "2"], "\[Rule]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["X", "TI"], "_"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51cd4bfd-d3fa-9dcf-07f3-62a6e58ce715"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "1"], "\[Rule]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "1"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06a776cb-b9d0-3c58-2e5d-6f95386a86a2"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "2"], "\[Rule]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "1"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7641b941-63e8-8619-1e7e-312b1582ed63"],
 " \[LongDash] which is the action of a CNOT on the logical pair."
}], "Text",ExpressionUUID->"42b8cf72-fa81-ffe6-7247-e73fff35c5cc"],

Cell[TextData[{
 "Acting correctly on the logical operators is only half of it. The gate also \
has to map the stabilizer group to itself, or it takes the state out of the \
code space and its logical action is beside the point. For the Steane code \
none of the twelve register generators leaves the group; for the five-qubit \
code, which is not CSS, ",
 StyleBox["all eight of them do",
  FontWeight->"Bold"],
 ":"
}], "Text",ExpressionUUID->"1c8db7a0-3aa3-299f-44b2-2e0abf567be5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "images", "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{
     RowBox[{"images", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"instr", " ", "=", " ", 
          RowBox[{"r", "[", 
           RowBox[{"\"\<TransversalCNOT\>\"", ",", " ", "1", ",", " ", "2"}], 
           "]"}]}], ",", " ", 
         RowBox[{"nq", " ", "=", " ", 
          RowBox[{"r", "[", "\"\<Qubits\>\"", "]"}]}], ",", " ", "group"}], 
        "}"}], ",", "\n", "        ", 
       RowBox[{
        RowBox[{"group", " ", "=", " ", 
         RowBox[{"QECCode", "[", 
          RowBox[{"r", "[", "\"\<Generators\>\"", "]"}], "]"}]}], ";", "\n", 
        "        ", 
        RowBox[{"Count", "[", "\n", "            ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"QECPauli", "[", 
              RowBox[{
              "Wolfram`QuantumFramework`QEC`PackageScope`registerConjugate", "[", 
               RowBox[{"instr", ",", " ", "nq", ",", " ", 
                RowBox[{
                 RowBox[{"QECPauli", "[", "#", "]"}], "[", "\"\<Vector\>\"", 
                 "]"}]}], "]"}], "]"}], "[", "\"\<String\>\"", "]"}], " ", 
            "&"}], " ", "/@", " ", 
           RowBox[{"r", "[", "\"\<Generators\>\"", "]"}]}], ",", "\n", 
          "            ", 
          RowBox[{"g_", " ", "/;", " ", 
           RowBox[{"!", " ", 
            RowBox[{"group", "[", 
             RowBox[{"\"\<StabilizerMemberQ\>\"", ",", " ", "g"}], 
             "]"}]}]}]}], "]"}]}]}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"Dataset", " ", "@", " ", 
     RowBox[{"<|", "\n", "        ", 
      RowBox[{
       RowBox[{"\"\<Steane (CSS)\>\"", " ", "->", " ", 
        RowBox[{"images", "[", 
         RowBox[{"QECRegister", "[", 
          RowBox[{
           RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
           "2"}], "]"}], "]"}]}], ",", "\n", "        ", 
       RowBox[{"\"\<five-qubit (not CSS)\>\"", " ", "->", " ", 
        RowBox[{"images", "[", 
         RowBox[{"QECRegister", "[", 
          RowBox[{
           RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
           "2"}], "]"}], "]"}]}]}], "|>"}]}]}]}], "]"}]], "Input",
 CellLabel->
  "In[99]:= ",ExpressionUUID->"473593be-64fb-e664-6eca-0af80c8fcd4e"],

