   {Cell["      ", "ModInfo",ExpressionUUID->
     "667bb688-7420-22c7-0e18-2fd27dd5702d"], Cell["\<\
Serial extraction, waiting, and why idle noise matters more not less\
\>", "TableText",ExpressionUUID->"72002252-da4c-5210-223f-c41fdff9217a"], 
    Cell["Book \[Section]15.5.1, \[Section]15.5.2", "TableText",
     ExpressionUUID->"084561a7-5440-aaee-387b-78015dfaf834"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "721e71e5-9ca7-ded5-2226-68cf1553a43f"], Cell[
    "Detectors as differences of repeated noisy syndromes", "TableText",
     ExpressionUUID->"0a84e7eb-55e0-1894-3abb-feb563956afe"], Cell[TextData[{
     "Dennis, Kitaev, Landahl, Preskill, ",
     ButtonBox["arXiv:quant-ph/0110143",
      BaseStyle->"Hyperlink",
      ButtonData->{
        URL["https://arxiv.org/abs/quant-ph/0110143"], None}]
    }], "TableText",ExpressionUUID->"3261920b-7b77-02d6-621e-14557e02503c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4ebe3b2c-9c8f-bd2d-7645-b376153b0477"], Cell[
