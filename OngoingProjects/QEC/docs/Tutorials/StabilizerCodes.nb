       "]"}], "[", "\"\<LogicalGate\>\"", "]"}], " ", "&"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<CNOT\>\"", ",", " ", "\"\<CZ\>\"", ",", 
      " ", "\"\<SWAP\>\""}], "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[85]:= ",ExpressionUUID->"14fe93a8-4ee9-5b9e-3c85-0af26a9c29e4"],

