Cell["\<\
The reduction can only ever emit the five gates of that dictionary, so the \
circuit's vocabulary is fixed in advance \[LongDash] here, four of them:\
\>", "Text",ExpressionUUID->"20a7420b-376a-b23f-505d-6455421c0105"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DeleteDuplicates", "[", 
  RowBox[{"First", " ", "/@", " ", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], 
    "[", "\"\<EncodingGates\>\"", "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[29]:= ",ExpressionUUID->"6af863a9-1098-c609-1a98-7af3a112ad53"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"H\"\>", ",", "\<\"CZ\"\>", ",", "\<\"SWAP\"\>", 
   ",", "\<\"CNOT\"\>"}], "}"}]], "Output",
 CellLabel->
  "Out[29]= ",ExpressionUUID->"055bc2ad-6b92-a3be-3378-dbf70e24f184"]
}, Open  ]],

Cell["\<\
The sign fixup is the one thing that can add to that vocabulary, and on codes \
that need it a Pauli appears alongside the Cliffords:\
\>", "Text",ExpressionUUID->"2b0fb60e-2211-365f-5934-286857a59ca5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DeleteDuplicates", "[", 
  RowBox[{"First", " ", "/@", " ", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], 
    "[", "\"\<EncodingGates\>\"", "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[30]:= ",ExpressionUUID->"201a2509-bdd9-2fa1-5039-bd53346c758b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"H\"\>", ",", "\<\"CZ\"\>", ",", "\<\"CNOT\"\>", 
   ",", "\<\"X\"\>"}], "}"}]], "Output",
 CellLabel->
  "Out[30]= ",ExpressionUUID->"7085d256-6adc-aa08-20ba-d4100f6ef952"]
}, Open  ]],

Cell["\<\
Reducing and inverting prepares a state stabilized by each generator up to \
sign; a Pauli fixup solved over GF(2) corrects the signs that came out wrong. \
Whether the result is really a codeword is checked against the engine, by \
measuring every check on the prepared state:\
\>", "Text",ExpressionUUID->"5f932952-49a5-d34f-05a0-c11c6851a195"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<BitFlipCode\>\"", ",", " ", "\"\<PhaseFlipCode\>\"", ",", 
     " ", "\"\<ShorCode\>\"", ",", " ", "\"\<5QubitCode\>\"", ",", 
     " ", "\"\<SteaneCode\>\""}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{
     RowBox[{"QECCode", "[", "#", "]"}], "[", "\"\<EncodingCircuitValidQ\>\"",
      "]"}], " ", "&"}]}], "]"}]], "Input",
 CellLabel->
  "In[31]:= ",ExpressionUUID->"160f17c4-d31a-fe19-3e34-8ea1e6acc563"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[31]= ",ExpressionUUID->"10beb8bd-bdb6-ee93-4045-31e73440b4f9"]
}, Open  ]],

Cell["Building codes from other codes", "Section",ExpressionUUID->"3fdc991b-fead-14b0-65e3-1144fb587e9a"],

Cell["\<\
Three constructions of Gottesman's thesis, section 3.5, plus the CSS \
construction of chapter 5 of the book, all return the same code object, so \
everything above works on the result unchanged.\
\>", "Text",ExpressionUUID->"3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],

Cell["\<\
A CSS code is built from classical parity-check matrices: rows of one become \
X-type checks, rows of the other Z-type, and they commute exactly when the \
matrices are orthogonal over GF(2). Fed the classical Hamming matrix, the \
construction reproduces the Steane code:\
\>", "Text",ExpressionUUID->"0642d375-09f3-9942-2e71-cb3faf87eba8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECCode", "[", 
   RowBox[{"\"\<CSS\>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "0", ",", " ", "0", ",", " ", "0", ",", " ", "1", ",", " ", "1", ",", 
        " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
       "0", ",", " ", "1", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",", 
        " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
       "1", ",", " ", "0", ",", " ", "1", ",", " ", "0", ",", " ", "1", ",", 
        " ", "0", ",", " ", "1"}], "}"}]}], "}"}]}], "]"}], 
  "[", "\"\<Parameters\>\"", "]"}]], "Input",
 CellLabel->
  "In[32]:= ",ExpressionUUID->"0651775d-2bad-791b-2e6f-6f074e584861"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"7", ",", "1", ",", "3"}], "}"}]], "Output",
 CellLabel->
  "Out[32]= ",ExpressionUUID->"63b9e3d6-2298-231e-1146-fa9057128e64"]
}, Open  ]],

Cell[TextData[{
 "\"Reproduces\" deserves care: the generators come out in a different order, \
so the claim is about the stabilizer ",
 StyleBox["group", "TI"],
 ", checked in both directions and with signs:"
}], "Text",ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"css", " ", "=", " ", 
      RowBox[{"QECCode", "[", 
       RowBox[{"\"\<CSS\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "0", ",", " ", "0", ",", " ", "0", ",", " ", "1", ",", " ", "1", ",",
             " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
           "0", ",", " ", "1", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",",
             " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
           "1", ",", " ", "0", ",", " ", "1", ",", " ", "0", ",", " ", "1", ",",
             " ", "0", ",", " ", "1"}], "}"}]}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"steane", " ", "=", " ", 
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}]}]}], "}"}], ",", 
   "\n", "    ", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"steane", "[", "\"\<GeneratorVectors\>\"", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"css", "[", 
        RowBox[{"\"\<StabilizerMemberQ\>\"", ",", " ", "#"}], "]"}], " ", 
       "&"}]}], "]"}], " ", "&&", "\n", "    ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"css", "[", "\"\<GeneratorVectors\>\"", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"steane", "[", 
        RowBox[{"\"\<StabilizerMemberQ\>\"", ",", " ", "#"}], "]"}], " ", 
       "&"}]}], "]"}]}]}], "\n", "]"}]], "Input",
 CellLabel->
  "In[33]:= ",ExpressionUUID->"4c440104-ea8a-4285-747b-99618f3f10ef"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[33]= ",ExpressionUUID->"66c9a615-af45-c085-0ef6-385ecaf192ef"]
}, Open  ]],

Cell["\<\
Concatenation re-encodes each qubit of an outer code with an inner one. The \
phase-flip code inside the bit-flip code is the Shor code, which is how Shor \
found it:\
\>", "Text",ExpressionUUID->"0513e607-0f4c-1e20-3320-f861aaf9650a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECConcatenate", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<PhaseFlipCode\>\"", "]"}], ",", " ", 
    RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}]}], "]"}], 
  "[", "\"\<Parameters\>\"", "]"}]], "Input",
 CellLabel->
  "In[34]:= ",ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"9", ",", "1", ",", "3"}], "}"}]], "Output",
 CellLabel->
  "Out[34]= ",ExpressionUUID->"6833ae6a-6ac5-a2c8-19c0-40340f71f012"]
}, Open  ]],

Cell["\<\
Distances multiply only as a lower bound, not an equality. The bit-flip code \
has quantum distance 1, yet concatenating it under the five-qubit code buys \
distance 5, not 3, because it still corrects bit flips at weight 3:\
\>", "Text",ExpressionUUID->"5f7f2999-1aee-25a5-0504-c0c39e988f8f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECConcatenate", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
    RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}]}], "]"}], 
  "[", "\"\<Parameters\>\"", "]"}]], "Input",
 CellLabel->
  "In[35]:= ",ExpressionUUID->"128c7526-c883-085d-42b4-6c83e9365aa7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"15", ",", "1", ",", "5"}], "}"}]], "Output",
 CellLabel->
  "Out[35]= ",ExpressionUUID->"3279c00f-c9e2-8758-6206-da68ef94eda2"]
}, Open  ]],

Cell[TextData[{
 "Qubit removal is surgery: recombine the generators so that exactly one ends \
in X and one in Z at the removed qubit, drop those two \[LongDash] they \
become the new logical pair \[LongDash] and truncate the rest. On the \
five-qubit code it produces the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"[", 
     RowBox[{"4", ",", "2", ",", "2"}], "]"}], "]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50b12ff8-e606-85f7-004e-c6a593b0efdd"],
 " code, with the generators Gottesman reports:"
}], "Text",ExpressionUUID->"640f47a5-4648-c62d-0c35-5e0f73e2ad77"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECRemoveQubit", "[", 
   RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], "]"}], 
  "[", "\"\<Generators\>\"", "]"}]], "Input",
 CellLabel->
  "In[36]:= ",ExpressionUUID->"63a48922-0fac-666c-115b-208caa594cb6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"XZZX\"\>", ",", "\<\"YXXY\"\>"}], "}"}]], "Output",
 CellLabel->
  "Out[36]= ",ExpressionUUID->"387a9e0d-0234-0e73-6819-1057b7c15559"]
}, Open  ]],

Cell["Noise", "Section",ExpressionUUID->"3f64ca0d-9927-5f44-651b-ec5718d225ae"],

Cell[TextData[{
 "None of the above says anything about whether a code ",
 StyleBox["works", "TI"],
 ", because a code only means something relative to a noise model. The \
simplest honest one is code-capacity noise: each qubit independently suffers \
X, Y or Z with fixed probabilities, between rounds, with perfect check \
measurements. That last assumption is a real one, and the sections after the \
next give it up."
}], "Text",ExpressionUUID->"399d1ff3-4632-be92-6fa2-96bd73c404f8"],

Cell["Depolarizing noise, with the rate left symbolic:", "Text",ExpressionUUID->"1170384d-2f38-2c50-470f-b2174acd76ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECNoiseModel", "[", 
   RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}], 
  "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellLabel->
  "In[37]:= ",ExpressionUUID->"6ce33075-6d34-44a7-1490-aa3f04c12e8d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "-", "p"}], ",", 
   FractionBox["p", "3"], ",", 
   FractionBox["p", "3"], ",", 
   FractionBox["p", "3"]}], "}"}]], "Output",
 CellLabel->
  "Out[37]= ",ExpressionUUID->"54e2b6d5-0ba4-5b19-7c91-2f9fae512663"]
}, Open  ]],

Cell[TextData[{
 "Because the errors are independent and identically distributed, the \
probability of a specific error depends only on how many X, Y and Z it \
carries \[LongDash] never on where they sit. That collapses a sum over ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["4", 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6334ac9c-43f1-85c0-12cb-45c67585ef2a"],
 " errors into a sum over the far smaller set of weight profiles, and it is \
what makes everything in the next section exact rather than sampled:"
}], "Text",ExpressionUUID->"74397683-04f4-1d4d-1dc7-6fedac816797"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECNoiseModel", "[", 
   RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}], "[", 
  RowBox[{"\"\<ErrorProbability\>\"", ",", " ", "\"\<XIIIIII\>\""}], 
  "]"}]], "Input",
 CellLabel->
  "In[38]:= ",ExpressionUUID->"735e49d5-32a1-4a48-2166-609f47541892"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "3"], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"1", "-", "p"}], ")"}], "6"], " ", "p"}]], "Output",
 CellLabel->
  "Out[38]= ",ExpressionUUID->"335d55a2-cf9b-493d-6163-4c0fea2e1807"]
}, Open  ]],

Cell["\<\
The model is not a private random-number generator: it maps onto the engine's \
own channels, so the probabilities can be checked against what the engine \
actually does to a stabilizer state. Note that the conventions differ \
\[LongDash] the engine's depolarizing parameter gives each Pauli a quarter of \
it, this model spreads its rate over three \[LongDash] so the constructor \
converts, and this is the test that the conversion is right:\
\>", "Text",ExpressionUUID->"3bfbbd45-edb8-1b0b-6998-352e844d6651"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"noise", " ", "=", " ", 
     RowBox[{"QECNoiseModel", "[", 
      RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}]}], "}"}], ",", 
   "\n", "    ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"noise", "[", 
         RowBox[{"\"\<QuantumChannel\>\"", ",", " ", 
          RowBox[{"{", "1", "}"}]}], "]"}], "[", 
        RowBox[{"PauliStabilizer", "[", "1", "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], " ", "==", " ", 
     RowBox[{"Sort", "[", 
      RowBox[{"noise", "[", "\"\<Probabilities\>\"", "]"}], "]"}]}], "]"}]}], 
  "\n", "]"}]], "Input",
 CellLabel->
  "In[39]:= ",ExpressionUUID->"045023ab-c37d-b770-2c6f-baf4f6091a5a"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[39]= ",ExpressionUUID->"73e8aeff-5b91-f8f4-2197-47b95e25cade"]
}, Open  ]],

Cell["\<\
For codes too large to enumerate, the model samples. A bit-flip channel can \
only produce X errors, and does:\
\>", "Text",ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BlockRandom", "[", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
   RowBox[{
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<BitFlip\>\"", ",", " ", 
      RowBox[{"1", "/", "3"}]}], "]"}], "[", 
    RowBox[{"\"\<RandomErrors\>\"", ",", " ", "6", ",", " ", "5"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[40]:= ",ExpressionUUID->"794a4309-908b-2549-2f4a-5b53213f8f93"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"XXIIXX\"\>", ",", "\<\"XXIIXX\"\>", ",", "\<\"IIIIXI\"\>", 
   ",", "\<\"IIXXXI\"\>", ",", "\<\"XXIXXI\"\>"}], "}"}]], "Output",
 CellLabel->
  "Out[40]= ",ExpressionUUID->"167ebcf0-2b32-2a61-3e05-35ba4ec7794b"]
}, Open  ]],

Cell["The logical error rate", "Section",ExpressionUUID->"15eb24b6-b946-3a65-43e8-bdf038f0894f"],

Cell["\<\
This is the question the subject is about. Prepare a codeword, hit it with an \
error drawn from the noise, measure the checks, decode, correct, and ask \
whether the logical qubit got flipped.\
\>", "Text",ExpressionUUID->"27d2a24c-1e84-19ee-4de1-44169b316b34"],

Cell[TextData[{
 "One observation makes it exact. Label every Pauli error by two things: \
which checks it anticommutes with (its syndrome) and which logical operators \
it anticommutes with (its class). Both are the same question, so both are one \
matrix product over GF(2). Two errors sharing a label differ by a stabilizer, \
so the label's fibre ",
 StyleBox["is", "TI"],
 " the coset; decoding is guessing the class half from the syndrome half; and \
a correction succeeds exactly when the guess was right. No residual algebra \
per trial \[LongDash] the label already decides it."
}], "Text",ExpressionUUID->"285985c7-a1c8-13eb-5866-1ca0d07d6131"],

Cell["\<\
The exact logical error rate of the five-qubit code under depolarizing noise:\
\
\>", "Text",ExpressionUUID->"57868ed1-450c-c474-7dbd-279b6cbeaf5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Expand", "[", 
  RowBox[{"QECLogicalErrorRate", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->
  "In[41]:= ",ExpressionUUID->"0c5e608e-35dc-f74f-3466-79e8bc6edd95"],

Cell[BoxData[
 RowBox[{
  RowBox[{"10", " ", 
   SuperscriptBox["p", "2"]}], "-", 
  FractionBox[
   RowBox[{"200", " ", 
    SuperscriptBox["p", "3"]}], "9"], "+", 
  FractionBox[
   RowBox[{"160", " ", 
    SuperscriptBox["p", "4"]}], "9"], "-", 
  FractionBox[
   RowBox[{"128", " ", 
    SuperscriptBox["p", "5"]}], "27"]}]], "Output",
 CellLabel->
  "Out[41]= ",ExpressionUUID->"1a1e4090-3303-05ed-4a26-59da46b66f37"]
}, Open  ]],

Cell[TextData[{
 "The leading term is not a fit. The five-qubit code is perfect, so every \
weight-one error is corrected and every weight-two error fails; there are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"9", 
     TemplateBox[{"5", "2"},
      "Binomial"]}], "\[LongEqual]", "90"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10256af3-3972-af7a-41da-83bdb804f240"],
 " of the latter, each of probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["p", "TI"], "/", "3"}], ")"}], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       StyleBox["p", "TI"]}], ")"}], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "457602f1-d86e-ac86-730d-9bbad918f6ec"],
 ", giving exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{"10", 
    SuperscriptBox[
     StyleBox["p", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "499f95c1-a958-6c18-7fa4-0caac8ed3762"],
 ". The polynomial is checkable by hand."
}], "Text",ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

Cell["\<\
The Steane code, which is not perfect, so some weight-two errors survive:\
\>", "Text",ExpressionUUID->"0c02104f-9807-e6c4-3431-8a2919b3cc2e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"QECLogicalErrorRate", "[", 
     RowBox[{
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
      RowBox[{"QECNoiseModel", "[", 
       RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}]}], "]"}], ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->
  "In[42]:= ",ExpressionUUID->"6f909018-5ea1-6a32-15af-0a425b543918"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"49", " ", 
    SuperscriptBox["p", "2"]}], "3"], "-", 
  RowBox[{"56", " ", 
   SuperscriptBox["p", "3"]}]}]], "Output",
 CellLabel->
  "Out[42]= ",ExpressionUUID->"2f4595f3-090a-1216-557a-0cbda8bf617c"]
}, Open  ]],

Cell["\<\
The strongest check available on any of this is a closed form that owes the \
package nothing. The repetition code under bit-flip noise fails exactly when \
a majority of its qubits flips, which is a binomial tail:\
\>", "Text",ExpressionUUID->"06385f5e-e9d4-4e6c-2fd8-571b886114b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"QECLogicalErrorRate", "[", 
    RowBox[{
     RowBox[{"QECCode", "[", 
      RowBox[{"\"\<Repetition\>\"", ",", " ", "5"}], "]"}], ",", " ", 
     RowBox[{"QECNoiseModel", "[", 
      RowBox[{"\"\<BitFlip\>\"", ",", " ", "p"}], "]"}]}], "]"}], " ", "==", 
   "\n", "        ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Binomial", "[", 
       RowBox[{"5", ",", " ", "j"}], "]"}], " ", 
      RowBox[{"p", "^", "j"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "p"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"5", " ", "-", " ", "j"}], ")"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "3", ",", " ", "5"}], "}"}]}], "]"}]}], "\n", 
  "]"}]], "Input",
 CellLabel->
  "In[43]:= ",ExpressionUUID->"25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[43]= ",ExpressionUUID->"3b9a140e-d97a-4136-69b9-8e6bd80f101c"]
}, Open  ]],

Cell["\<\
With an exact rate per code, the threshold \[LongDash] the rate below which \
adding qubits helps and above which it hurts \[LongDash] stops being a fit to \
sampled curves and becomes a crossing of polynomials. For repetition codes \
under bit flips it sits at exactly one half:\
\>", "Text",ExpressionUUID->"4f9438da-b80f-a114-75ab-b18439bbf07e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"QECLogicalErrorRate", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", 
         RowBox[{"\"\<Repetition\>\"", ",", " ", "n"}], "]"}], ",", " ", 
        RowBox[{"QECNoiseModel", "[", 
         RowBox[{"\"\<BitFlip\>\"", ",", " ", "p"}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "5", ",", " ", "7"}], "}"}]}], "}"}]}], "]"}],
     "]"}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}], ",", "\n", "    ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<n = 3\>\"", ",", " ", "\"\<n = 5\>\"", ",", 
      " ", "\"\<n = 7\>\""}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<physical error rate\>\"", ",", 
      " ", "\"\<logical error rate\>\""}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"ImageSize", " ", "->", " ", "380"}]}], "\n", "]"}]], "Input",
 CellLabel->
  "In[44]:= ",ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

