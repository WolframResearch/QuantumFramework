Cell[TextData[{
 "The check outcomes are heralds, not syndrome bits \[LongDash] a nonzero one \
means discard the attempt \[LongDash] which is why, when a gadget \
post-selects, the logical error rate is conditional on acceptance and its \
report, ",
 Cell[BoxData[
  RowBox[{"QECLogicalErrorRate", "[", 
   RowBox[{"code", ",", " ", "noise", ",", " ", "All"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e7ab4-00f8-e339-7ea6-73feb172ce03"],
 ", carries the acceptance alongside it."
}], "Text",ExpressionUUID->"0b3ec616-de69-0141-3ac5-d853db1c53ab"],

Cell["Fault-tolerant measurement of a Pauli", "Section",ExpressionUUID->"7c0d57bf-7ae8-3253-2433-4ef97e8280b9"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"QECPauliMeasurement", "[", 
   RowBox[{"code", ",", " ", "P"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aaecb0d-dff0-cd78-3a55-e356d98a9442"],
 " spends the cat. One attempt applies the transversal controlled-",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fe4a286-576e-fd11-759b-3be06218c47b"],
 " and reads the eigenvalue out with a Hadamard transform, so the ",
 StyleBox["parity of the weight", "TI"],
 " of the measured string is the answer; the whole gadget repeats that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["t", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07179650-9fbb-2bc1-2d2c-081a1a4e792b"],
 " times with a fresh cat each time and takes the majority (Theorem 12.1)."
}], "Text",ExpressionUUID->"7aecd320-e31f-2936-2a93-ca8d96aa781c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"QECPauliMeasurement", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", 
       " ", "\"\<ZZZZZ\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"m", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Weight\>\"", ",", " ", "\"\<Repetitions\>\"", ",", 
       " ", "\"\<CatQubits\>\"", ",", " ", "\"\<Qubits\>\"", ",", 
       " ", "\"\<Measurements\>\"", ",", " ", "\"\<Heralds\>\""}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[84]:= ",ExpressionUUID->"326b0854-5043-0b63-6268-a21e61f65649"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Weight\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"Repetitions\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"CatQubits\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"6", ",", "7", ",", "8", ",", "9", ",", "10"}], "}"}]}], ",", 
   RowBox[{"\<\"Qubits\"\>", "\[Rule]", "11"}], ",", 
   RowBox[{"\<\"Measurements\"\>", "\[Rule]", "15"}], ",", 
   RowBox[{"\<\"Heralds\"\>", "\[Rule]", "6"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[84]= ",ExpressionUUID->"1d6edc53-4ce5-e0f2-4b15-d61d6491b2d8"]
}, Open  ]],

Cell[TextData[{
 "The number the construction exists for, against the bare-ancilla circuit \
measuring the ",
 StyleBox["same", "TI"],
 " operator. ",
 Cell[BoxData["\"\<DataWeights\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45f7e4e6-4e1c-a184-738c-fdc06baef3ee"],
 " is the residual weight on the data over every single fault the gadget \
admits, and it is a conditional statement in two ways that the property \
handles rather than hides: only runs the cat checks ",
 StyleBox["accept", "TI"],
 " are counted, and the residual is read modulo ",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70e98525-204e-6ba4-2096-1c8f51fb398e"],
 ", because ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["X", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["m", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "704169dd-a4db-5005-207e-8086cd6e236f"],
 " stabilises the cat and so a pattern and its complement leave the same \
physical state."
}], "Text",ExpressionUUID->"7b2d1c14-5aff-cd5f-2ad2-965e5e8b97a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"QECPauliMeasurement", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", 
       " ", "\"\<XZZXI\>\"", ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", 
   "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", "[", "\"\<TransversalQ\>\"", "]"}], ",", " ", 
     RowBox[{"m", "[", "\"\<DataWeights\>\"", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[85]:= ",ExpressionUUID->"62ac11c1-6d0b-a8c0-1253-88ab04bffa2a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[85]= ",ExpressionUUID->"2e7621e1-2fba-a33a-560d-b8cb4a4c0e00"]
}, Open  ]],

Cell["\<\
One fault, one data error \[LongDash] where the same generator measured with \
one shared bare ancilla leaves four. That is the hook error gone, in the \
units the section above priced it in.\
\>", "Text",ExpressionUUID->"15938457-0322-a4d9-43a0-1e11b6d40e23"],

Cell[TextData[{
 "What repetition does ",
 StyleBox["not", "TI"],
 " fix is the honest boundary, and the gadget says so. If the codeword \
already carries an error ",
 Cell[BoxData[
  FormBox[
   StyleBox["E", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f1ed2e3-b722-4b37-2525-cbccc2d7161d"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], 
    StyleBox["P", "TI"], "\[LongEqual]", "-", 
    StyleBox["P", "TI"], 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52e63e44-9d5c-26a1-029d-b02e14ee8c8b"],
 ", every repetition reads the flipped eigenvalue alike and the majority is \
confidently wrong \[LongDash] \"no matter how many times we repeat it\" (\
\[Section]12.1.4). So ",
 Cell[BoxData["\"\<MeasurementCorrectQ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e766a94-5ec6-6187-160d-83de5b7333ed"],
 " is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eead67c-41e5-1519-56e9-c82677907c63"],
 " until an error-correction sub-gadget is spliced between repetitions, and \
",
 Cell[BoxData["\"\<OpenAssumptions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23a655ec-dad2-e192-515e-4cc9df64b3f8"],
 " names what is still assumed:"
}], "Text",ExpressionUUID->"62ef85cc-c62f-39ac-1294-1ca9f3db8bf6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"QECPauliMeasurement", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", 
       " ", "\"\<IZIZIZI\>\""}], "]"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", "[", "\"\<MeasurementCorrectQ\>\"", "]"}], ",", " ", 
     RowBox[{"m", "[", "\"\<ErrorCorrection\>\"", "]"}], ",", " ", 
     RowBox[{"m", "[", "\"\<OpenAssumptions\>\"", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[86]:= ",ExpressionUUID->"7d6c313b-6800-4a9b-2b13-a96509b518e1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "None", ",", 
   RowBox[{
   "{", "\<\"No error correction is spliced between repetitions, so a data \
error anticommuting with the measured Pauli defeats every repetition alike \
(Got26 sec. 12.1.4). The gadget handles ancilla faults only.\"\>", "}"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[86]= ",ExpressionUUID->"75dfb56b-bb47-a02b-23e4-2d353ef3f371"]
}, Open  ]],

Cell["Steane error correction", "Section",ExpressionUUID->"57533ce7-69d6-be0e-7d60-b5c108600554"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"QECErrorCorrection", "[", "code", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27c3fefb-2ee6-8038-4df0-f7a54a90d302"],
 " is the gadget that fills that slot. It is CSS-only, and for a reason \
rather than by restriction: the construction runs on transversal CNOT being \
the logical CNOT."
}], "Text",ExpressionUUID->"60d4995f-bb7f-b80c-10eb-11193e0b0b56"],

Cell[TextData[{
 "Two halves. The bit-flip half puts an ancilla block in encoded ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "+"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64608bbe-760c-8af3-0c1f-22f803bed8d9"],
 " and runs transversal CNOT from data to ancilla \[LongDash] on the encoded \
states ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["CNOT",
     FontSlant->"Plain"], "|", "\[Psi]", "\[RightAngleBracket]", 
    RowBox[{"|", "+"}], "\[RightAngleBracket]", "\[LongEqual]", "|", "\[Psi]",
     "\[RightAngleBracket]", 
    RowBox[{"|", "+"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09661063-a2cf-675e-3f1d-8a4cd77a4da4"],
 ", so nothing happens logically, but the gate still copies bit flips into \
the ancilla where measuring them is harmless. The phase half uses encoded ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "0"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5561d787-26b0-8d0a-031e-cee1534ad450"],
 ", the CNOT the other way, and a transversal Hadamard so the same ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fea91e8-e80e-a1ed-35e9-08b589b8f337"],
 "-basis readout sees phase errors."
}], "Text",ExpressionUUID->"37725419-c8bf-c4cd-5d02-4e42e94bae17"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ec", " ", "=", " ", 
     RowBox[{"QECErrorCorrection", "[", 
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "]"}]}], "}"}], ",",
    "\n", "    ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"ec", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DataQubits\>\"", ",", " ", "\"\<AncillaQubits\>\"", ",", 
       " ", "\"\<Qubits\>\"", ",", " ", "\"\<Measurements\>\"", ",", 
       " ", "\"\<TransversalQ\>\""}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[87]:= ",ExpressionUUID->"6eee5857-8f9d-bf63-1696-52112a290249"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"DataQubits\"\>", "\[Rule]", "7"}], ",", 
   RowBox[{"\<\"AncillaQubits\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "8", ",", "9", ",", "10", ",", "11", ",", "12", ",", "13", ",", "14"}], 
     "}"}]}], ",", 
   RowBox[{"\<\"Qubits\"\>", "\[Rule]", "14"}], ",", 
   RowBox[{"\<\"Measurements\"\>", "\[Rule]", "14"}], ",", 
   RowBox[{"\<\"TransversalQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[87]= ",ExpressionUUID->"2635f536-2fc9-ab3c-4fca-ed704a7df606"]
}, Open  ]],

Cell[TextData[{
 "Why this gadget and not Shor EC: \[Section]12.3.3 asks whether Steane EC \
needs repeating and answers no, because the errors are ",
 StyleBox["additive",
  FontWeight->"Bold"],
 ". The measured classical error is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["e", "TI"], "+", 
    StyleBox["f", "TI"], "+", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3760e9-4a32-92b2-4acd-79b36fc4e098"],
 " \[LongDash] the true data error, the ancilla's, and the measurement's \
\[LongDash] so correcting by it leaves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "+", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fe93a8-4ee9-5b9e-3c85-0af26a9c29e4"],
 ", and \"a single-qubit error in the ancilla can only produce a single-qubit \
error in the final state. This is in contrast to Shor EC, where a single \
ancilla error changing one bit of the error syndrome could totally change the \
error we deduce.\""
}], "Text",ExpressionUUID->"11cf5d11-52cc-ddbb-47f5-555b677ea781"],

Cell["\<\
That is a claim to check rather than quote, and the gadget reports both \
halves of the answer:\
\>", "Text",ExpressionUUID->"7ba8138a-66ce-478c-2957-8ad4137b2dd6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ec", " ", "=", " ", 
     RowBox[{"QECErrorCorrection", "[", 
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "]"}]}], "}"}], ",",
    "\n", "    ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"ec", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<RepetitionsNeeded\>\"", ",", " ", "\"\<DataWeights\>\"", ",",
        " ", "\"\<PreparationDataWeights\>\""}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[88]:= ",ExpressionUUID->"35c9e6d4-f3c4-84c1-63f6-ff918676ee2b"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"RepetitionsNeeded\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"DataWeights\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}], ",", 
   RowBox[{"\<\"PreparationDataWeights\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[88]= ",ExpressionUUID->"6fd66644-13e4-6fa7-15ee-782ea591358d"]
}, Open  ]],

Cell[TextData[{
 "One fault in the interaction leaves one data error. One fault in the \
ancilla ",
 StyleBox["preparation",
  FontWeight->"Bold"],
 " leaves up to four, because that preparation is still the code's \
non-fault-tolerant encoder. The split is the open assumption made \
quantitative, and ",
 Cell[BoxData["\"\<OpenAssumptions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00abf1cf-696b-3507-30a8-e8a9081f9c6d"],
 " states it in words."
}], "Text",ExpressionUUID->"03d898fe-d35a-9eef-31e7-11bbe6ece435"],

Cell[TextData[{
 "Splicing it in completes the structure Theorem 12.1 asks for. The composed \
gadget still leaves one data error per fault, and inherits the sub-gadget's \
open assumption rather than hiding it behind that ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03dda600-4b0b-c3af-31e2-386a6ebf91f5"],
 ":"
}], "Text",ExpressionUUID->"4de38b79-ee67-8bee-7b90-23228b13d934"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"First", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], 
       "[", "\"\<LogicalZ\>\"", "]"}], "]"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"QECPauliMeasurement", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", "p"}], 
       "]"}], "[", "\"\<MeasurementCorrectQ\>\"", "]"}], ",", "\n", "     ", 
     RowBox[{
      RowBox[{"QECPauliMeasurement", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", "p", ",",
         " ", 
        RowBox[{"\"\<ErrorCorrection\>\"", " ", "->", 
         " ", "\"\<Steane\>\""}]}], "]"}], "[", "\"\<MeasurementCorrectQ\>\"",
       "]"}], ",", "\n", "     ", 
     RowBox[{
      RowBox[{"QECPauliMeasurement", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", "p", ",",
         " ", 
        RowBox[{"\"\<ErrorCorrection\>\"", " ", "->", 
         " ", "\"\<Steane\>\""}]}], "]"}], "[", "\"\<DataWeights\>\"", 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[89]:= ",ExpressionUUID->"347cf1ed-0cc4-b4dc-5c03-e8b7a5761e26"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True", ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[89]= ",ExpressionUUID->"7d81b9ce-3a4c-aa2a-2bbe-30a8bffef970"]
}, Open  ]],

Cell["\<\
And the CSS restriction is enforced rather than documented. The five-qubit \
code can have a cat measurement, since that works for any code, but not \
Steane error correction:\
\>", "Text",ExpressionUUID->"6bb9b374-9caf-337d-1946-2b3e155b9e47"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QECErrorCorrection", "[", 
  RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], "]"}]], "Input",
 CellLabel->
  "In[90]:= ",ExpressionUUID->"6c340229-13f4-0181-15cb-a473a58153eb"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"QECErrorCorrection", "::", "css"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{
   RowBox[{
   "Steane", " ", "error", " ", "correction", " ", "needs", " ", "a", " ", 
    "CSS", " ", "code"}], ";", " ", 
   RowBox[{
    RowBox[{"this", " ", "one", " ", "is", " ", "not", " ", 
     RowBox[{"CSS", ".", " ", "Its"}], " ", "generators", " ", "must", " ", 
     "each", " ", "be", " ", "purely", " ", "X"}], "-", 
    RowBox[{"type", " ", "or", " ", "purely", " ", "Z"}], "-", 
    RowBox[{"type", "."}]}]}]}]], "Message", \
"MSG",ExpressionUUID->"25dfa134-0866-9bb5-53e4-397ea910e99f"],

Cell[BoxData["$Failed"], "Output",
 CellLabel->
  "Out[90]= ",ExpressionUUID->"425139cc-45a5-cefb-726e-b0966c5194c1"]
}, Open  ]],

Cell["Handing the rate machinery a different extraction", "Section",ExpressionUUID->"4d922994-f334-45bb-7ba1-c0d186c12f81"],

Cell[TextData[{
 "Everything above measures the bare-ancilla circuit, because that is the \
circuit ",
 Cell[BoxData["QECDetectorModel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06c25578-1780-b25e-2ef2-4d22a23a00a4"],
 " and ",
 Cell[BoxData["QECLogicalErrorRate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f70617e-b140-9f95-0500-793bc0fae5ff"],
 " route through. ",
 Cell[BoxData["\"\<Extraction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79d0371a-30a6-04e5-2fef-af4441536ecf"],
 " is the option that changes it, and it is on both:"
}], "Text",ExpressionUUID->"7d950d76-dd18-2b24-2baa-a533d4ad760e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECDetectorModel", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<Circuit\>\"", ",", " ", 
      RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", "1", ",", "\n", "    ", 
    RowBox[{"\"\<Extraction\>\"", " ", "->", " ", "\"\<Transversal\>\""}]}], 
   "]"}], "[", "\"\<Faults\>\"", "]"}]], "Input",
 CellLabel->
  "In[91]:= ",ExpressionUUID->"7234a9f4-3232-6781-23cb-40be47c74deb"],

Cell[BoxData["624"], "Output",
 CellLabel->
  "Out[91]= ",ExpressionUUID->"42668d78-f434-72a4-721d-2525fdc1408e"]
}, Open  ]],

Cell[TextData[{
 "Only half the fault-tolerant construction can cross over, and the reason is \
worth stating because it is a property of the formalism rather than of the \
implementation. ",
 StyleBox["A detector error model is a matrix",
  FontWeight->"Bold"],
 ": the effect of a set of faults is the XOR of their rows, and the exact \
fold, the decoder table and the Stim export all rest on that. Theorem 12.1's \
gadget takes a ",
 StyleBox["majority",
  FontWeight->"Bold"],
 " over ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["t", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c7cc198-0ad8-2426-3403-d8c2af528f0c"],
 " repetitions, and majority is not linear, so it cannot sit inside a \
detector model at all."
}], "Text",ExpressionUUID->"69698b1d-3dc2-3628-1f16-2347b4749d72"],

Cell[TextData[{
 "What can is ",
 StyleBox["transversality",
  FontWeight->"Bold"],
 " \[LongDash] which is the half that fixes the hook error anyway, repetition \
never having been what cured it. A cat readout's syndrome bit is the ",
 StyleBox["parity", "TI"],
 " of its ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "701e1eb7-eeba-61c8-2025-97f08b4f3312"],
 " bits (eqs. 12.1\[Dash]12.3), and parity is linear. Repetition then stays \
where it already was, across rounds, handled by the detectors. So ",
 Cell[BoxData["\"\<Transversal\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e322415-281a-3695-37c1-be5f49ac9cff"],
 " is not a weaker ",
 Cell[BoxData["\"\<FaultTolerant\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61beb272-ef15-9663-1745-343f8aa1fd49"],
 "; it is the composition the detector formalism admits, and therefore the \
one whose rate can be computed."
}], "Text",ExpressionUUID->"5e8a6a96-06b4-6465-0689-83d0b3414f4f"],

Cell[TextData[{
 "What that buys, counted the same way the section above counted it. With the \
bare ancilla, 288 faults collapse onto 71 detector signatures of which 29 \
carry conflicting logical effects. With a transversal extraction \[LongDash] ",
 StyleBox["more than twice as many fault locations",
  FontWeight->"Bold"],
 " \[LongDash] 624 faults collapse onto 72 signatures of which only 4 do:"
}], "Text",ExpressionUUID->"55951090-ef25-ccfd-03aa-89dd8ad196c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "ambiguity", "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{
     RowBox[{"ambiguity", "[", "dem_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"dem", "[", "\"\<DetectorMatrix\>\"", "]"}]}], ",", " ", 
         RowBox[{"o", " ", "=", " ", 
          RowBox[{"dem", "[", "\"\<ObservableMatrix\>\"", "]"}]}], ",", " ", 
         "grouped"}], "}"}], ",", "\n", "        ", 
       RowBox[{
        RowBox[{"grouped", " ", "=", " ", 
         RowBox[{"GroupBy", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "d", "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"d", "[", 
             RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], ",", " ", 
           RowBox[{
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"o", "[", 
                RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
              "#"}], "]"}], " ", "&"}]}], "]"}]}], ";", "\n", "        ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<faults\>\"", " ", "->", " ", 
           RowBox[{"Length", "[", "d", "]"}]}], ",", " ", 
          RowBox[{"\"\<signatures\>\"", " ", "->", " ", 
           RowBox[{"Length", "[", "grouped", "]"}]}], ",", "\n", "          ", 
          RowBox[{"\"\<ambiguous\>\"", " ", "->", " ", 
           RowBox[{"Count", "[", 
            RowBox[{"grouped", ",", " ", 
             RowBox[{"alt_", " ", "/;", " ", 
              RowBox[{
               RowBox[{"Length", "[", "alt", "]"}], " ", ">", " ", "1"}]}]}], 
            "]"}]}]}], "|>"}]}]}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"Dataset", " ", "@", " ", 
     RowBox[{"<|", "\n", "        ", 
      RowBox[{
       RowBox[{"\"\<bare ancilla\>\"", " ", "->", " ", 
        RowBox[{"ambiguity", "[", 
         RowBox[{"QECDetectorModel", "[", 
          RowBox[{
           RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
           RowBox[{"QECNoiseModel", "[", 
            RowBox[{"\"\<Circuit\>\"", ",", " ", 
             RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", "1"}], "]"}], 
         "]"}]}], ",", "\n", "        ", 
       RowBox[{"\"\<transversal\>\"", " ", "->", " ", 
        RowBox[{"ambiguity", "[", 
         RowBox[{"QECDetectorModel", "[", 
          RowBox[{
           RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
           RowBox[{"QECNoiseModel", "[", 
            RowBox[{"\"\<Circuit\>\"", ",", " ", 
             RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", "1", ",", "\n", 
           "            ", 
           
           RowBox[{"\"\<Extraction\>\"", " ", "->", 
            " ", "\"\<Transversal\>\""}]}], "]"}], "]"}]}]}], "|>"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[92]:= ",ExpressionUUID->"53a2ca13-da2c-324e-0151-ec5cdfde8094"],

Cell[BoxData[
 TagBox[
  TagBox[
   DynamicModuleBox[{TypeSystem`NestedGrid`PackagePrivate`$state$$ = <|
    "InitialData" -> <|
      "bare ancilla" -> <|
        "faults" -> 288, "signatures" -> 71, "ambiguous" -> 29|>, 
