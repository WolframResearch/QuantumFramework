Cell[TextData[{
 "And half is not none. The five-qubit code has no transversal ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41172bde-c012-830e-772c-c29bf1a4ee54"],
 " and no transversal ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dd84232-0c35-660d-6bf8-647ca5c04d57"],
 ", but it does have the cyclic Clifford ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["X", "TI"], "\[Rule]", 
    StyleBox["Y", "TI"], "\[Rule]", 
    StyleBox["Z", "TI"], "\[Rule]", 
    StyleBox["X", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5558c8fc-3d33-9e90-0367-e1a6b4c7e4fa"],
 ", which is ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53291d47-a111-bd44-02d6-9520d0a507ae"],
 " followed by ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14460f59-6b0f-818e-3c7d-a7030ebbd3d4"],
 ":"
}], "Text",ExpressionUUID->"6afe19ed-5a5e-331e-1a85-90b75fe89e64"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"five", " ", "=", " ", 
      RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}]}], ",", " ", "g"}], 
    "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"QECTransversalGate", "[", 
      RowBox[{"five", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<S\>\"", ",", " ", "\"\<H\>\""}], "}"}]}], "]"}]}], ";", 
    "\n", "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<H alone\>\"", " ", "->", " ", 
       RowBox[{
        RowBox[{"QECTransversalGate", "[", 
         RowBox[{"five", ",", " ", "\"\<H\>\""}], "]"}], 
        "[", "\"\<TransversalQ\>\"", "]"}]}], ",", "\n", "      ", 
      RowBox[{"\"\<S then H\>\"", " ", "->", " ", 
       RowBox[{"g", "[", "\"\<TransversalQ\>\"", "]"}]}], ",", "\n", "      ", 
      RowBox[{"\"\<its logical action\>\"", " ", "->", " ", 
       RowBox[{"g", "[", "\"\<LogicalAction\>\"", "]"}]}]}], "|>"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[106]:= ",ExpressionUUID->"142f588d-e120-bc70-3dd5-51d690da075a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"H alone\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"S then H\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"its logical action\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\<\"X\"\>", ",", "1"}], "}"}], "\[Rule]", "\<\"-Y\"\>"}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\<\"Z\"\>", ",", "1"}], "}"}], "\[Rule]", "\<\"-X\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[106]= ",ExpressionUUID->"029948d8-232c-2201-32a7-618256d9716b"]
}, Open  ]],

Cell["\<\
Which is the useful form of a statement people usually shorten to \"the \
five-qubit code has no transversal gates\". It has a different set of them, \
and asking is one call.\
\>", "Text",ExpressionUUID->"4b1b5b6f-b43d-594b-7939-53493dc82b91"],

Cell["\<\
Between two blocks the question has the CNOT as its answer. The previous \
section checked that modulo sign; here the phases are carried, and two more \
gates come free with the same symmetry:\
\>", "Text",ExpressionUUID->"32f703b9-71e1-95eb-628c-9ae30795ff31"],

