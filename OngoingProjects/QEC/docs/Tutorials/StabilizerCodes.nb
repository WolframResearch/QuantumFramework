               Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 2} -> 
             SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
               Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 2} -> 
             SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
          "Picture" -> "Schrodinger", "Label" -> 
          Subscript["C", "NOT"][{1}, {}], "ParameterSpec" -> {}|>]], {{1, 
       4}, {1, 4}}], 
      Wolfram`QuantumFramework`QuantumOperator[
       Wolfram`QuantumFramework`QuantumState[
       SparseArray[Automatic, {4}, 0, {1, {{0, 2}, {{2}, {3}}}, {1, 1}}], 
        Wolfram`QuantumFramework`QuantumBasis[<|
         "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
               Wolfram`QuantumFramework`QuditName[0, "Dual" -> True], 1} -> 
             SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
               Wolfram`QuantumFramework`QuditName[1, "Dual" -> True], 1} -> 
             SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
          "Output" -> Wolfram`QuantumFramework`QuditBasis[<|{
               Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 1} -> 
             SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
               Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 1} -> 
             SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
          "Picture" -> "Schrodinger", "Label" -> "X", 
          "ParameterSpec" -> {}|>]], {{5}, {5}}]}, "Label" -> Composition["X", 
      Subscript["C", "NOT"][{1}, {}], 
      Subscript["C", "Z"][{1}, {}], 
      Subscript["C", "Z"][{1}, {}], 
      Subscript["C", "NOT"][{2}, {}], 
      Subscript["C", "Z"][{2}, {}], 
      Subscript["C", "Z"][{2}, {}], 
      Subscript["C", "NOT"][{3}, {}], 
      Subscript["C", "Z"][{3}, {}], 
      Subscript["C", "Z"][{3}, {}], 
      Subscript["C", "NOT"][{4}, {}], 
      Subscript["C", "Z"][{4}, {}], "H", "H", "H", "H"]|>],
  Editable->False,
  SelectWithContents->True,
  Selectable->False]], "Output",
 CellLabel->
  "Out[22]= ",ExpressionUUID->"370294fd-9e49-2d35-5d31-0da71bfc741f"]
}, Open  ]],

Cell["\<\
The reduction can only ever emit the five gates of that dictionary, so the \
circuit's vocabulary is fixed in advance \[LongDash] here, four of them:\
\>", "Text",ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DeleteDuplicates", "[", 
  RowBox[{"First", " ", "/@", " ", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], 
    "[", "\"\<EncodingGates\>\"", "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"H\"\>", ",", "\<\"CZ\"\>", ",", "\<\"SWAP\"\>", 
   ",", "\<\"CNOT\"\>"}], "}"}]], "Output",
 CellLabel->
  "Out[23]= ",ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"]
}, Open  ]],

Cell["\<\
The sign fixup is the one thing that can add to that vocabulary, and on codes \
that need it a Pauli appears alongside the Cliffords:\
\>", "Text",ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DeleteDuplicates", "[", 
  RowBox[{"First", " ", "/@", " ", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], 
    "[", "\"\<EncodingGates\>\"", "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"6878c7f8-419e-9db5-1807-dea27028e79f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"H\"\>", ",", "\<\"CZ\"\>", ",", "\<\"CNOT\"\>", 
   ",", "\<\"X\"\>"}], "}"}]], "Output",
 CellLabel->
  "Out[24]= ",ExpressionUUID->"48a3d607-c312-9dd3-7850-c860f6a4e739"]
}, Open  ]],

Cell["\<\
Reducing and inverting prepares a state stabilized by each generator up to \
sign; a Pauli fixup solved over GF(2) corrects the signs that came out wrong. \
Whether the result is really a codeword is checked against the engine, by \
measuring every check on the prepared state:\
\>", "Text",ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<BitFlipCode\>\"", ",", " ", "\"\<PhaseFlipCode\>\"", ",", 
     " ", "\"\<ShorCode\>\"", ",", " ", "\"\<5QubitCode\>\"", ",", 
     " ", "\"\<SteaneCode\>\""}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{
     RowBox[{"QECCode", "[", "#", "]"}], "[", "\"\<EncodingCircuitValidQ\>\"",
      "]"}], " ", "&"}]}], "]"}]], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[25]= ",ExpressionUUID->"023f49e2-a747-9723-33c5-60cfd2f3fa09"]
}, Open  ]],

Cell["Building codes from other codes", "Section",ExpressionUUID->"21aa1c49-e16c-f406-57a9-9612901edf6c"],

Cell["\<\
Three constructions of Gottesman's thesis, section 3.5, plus the CSS \
construction of chapter 5 of the book, all return the same code object, so \
everything above works on the result unchanged.\
\>", "Text",ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"],

Cell["\<\
A CSS code is built from classical parity-check matrices: rows of one become \
X-type checks, rows of the other Z-type, and they commute exactly when the \
matrices are orthogonal over GF(2). Fed the classical Hamming matrix, the \
construction reproduces the Steane code:\
\>", "Text",ExpressionUUID->"12f3dbee-abc4-6375-4280-d2cbce714e5f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECCode", "[", 
   RowBox[{"\"\<CSS\>\"", ",", " ", 
    RowBox[{"QECClassicalHammingMatrix", "[", "3", "]"}]}], "]"}], 
  "[", "\"\<Parameters\>\"", "]"}]], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"7", ",", "1", ",", "3"}], "}"}]], "Output",
 CellLabel->
  "Out[26]= ",ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"]
}, Open  ]],

Cell[TextData[{
 "\"Reproduces\" deserves care: the generators come out in a different order, \
so the claim is about the stabilizer ",
 StyleBox["group", "TI"],
 ", checked in both directions and with signs:"
}], "Text",ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"css", " ", "=", " ", 
      RowBox[{"QECCode", "[", 
       RowBox[{"\"\<CSS\>\"", ",", " ", 
        RowBox[{"QECClassicalHammingMatrix", "[", "3", "]"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"steane", " ", "=", " ", 
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}]}]}], "}"}], ",", 
   "\n", "    ", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"steane", "[", "\"\<GeneratorVectors\>\"", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"css", "[", 
        RowBox[{"\"\<StabilizerMemberQ\>\"", ",", " ", "#"}], "]"}], " ", 
       "&"}]}], "]"}], " ", "&&", "\n", "    ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"css", "[", "\"\<GeneratorVectors\>\"", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"steane", "[", 
        RowBox[{"\"\<StabilizerMemberQ\>\"", ",", " ", "#"}], "]"}], " ", 
       "&"}]}], "]"}]}]}], "\n", "]"}]], "Input",
 CellLabel->
  "In[27]:= ",ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[27]= ",ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"]
}, Open  ]],

Cell["\<\
Concatenation re-encodes each qubit of an outer code with an inner one. The \
phase-flip code inside the bit-flip code is the Shor code, which is how Shor \
found it:\
\>", "Text",ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECConcatenate", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<PhaseFlipCode\>\"", "]"}], ",", " ", 
    RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}]}], "]"}], 
  "[", "\"\<Parameters\>\"", "]"}]], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"9", ",", "1", ",", "3"}], "}"}]], "Output",
 CellLabel->
  "Out[28]= ",ExpressionUUID->"2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"]
}, Open  ]],

Cell["\<\
Distances multiply only as a lower bound, not an equality. The bit-flip code \
has quantum distance 1, yet concatenating it under the five-qubit code buys \
distance 5, not 3, because it still corrects bit flips at weight 3:\
\>", "Text",ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECConcatenate", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
    RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}]}], "]"}], 
  "[", "\"\<Parameters\>\"", "]"}]], "Input",
 CellLabel->
  "In[29]:= ",ExpressionUUID->"52243646-2fbd-210e-03db-a8204a487054"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"15", ",", "1", ",", "5"}], "}"}]], "Output",
 CellLabel->
  "Out[29]= ",ExpressionUUID->"1acd7f4d-3da3-7753-4af3-7717b4565db9"]
}, Open  ]],

Cell[TextData[{
 "Qubit removal is surgery: recombine the generators so that exactly one ends \
in X and one in Z at the removed qubit, drop those two \[LongDash] they \
become the new logical pair \[LongDash] and truncate the rest. On the \
five-qubit code it produces the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"[", 
     RowBox[{"4", ",", "2", ",", "2"}], "]"}], "]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "062d91f0-6326-41c0-2fd2-08ba16d3132a"],
 " code, with the generators Gottesman reports:"
}], "Text",ExpressionUUID->"1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECRemoveQubit", "[", 
   RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], "]"}], 
  "[", "\"\<Generators\>\"", "]"}]], "Input",
 CellLabel->
  "In[30]:= ",ExpressionUUID->"6f6ad260-8ee1-565a-1569-d44a2a943ca0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"XZZX\"\>", ",", "\<\"YXXY\"\>"}], "}"}]], "Output",
 CellLabel->
  "Out[30]= ",ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"]
}, Open  ]],

Cell["Noise", "Section",ExpressionUUID->"26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],

Cell[TextData[{
 "None of the above says anything about whether a code ",
 StyleBox["works", "TI"],
 ", because a code only means something relative to a noise model. The \
simplest honest one is code-capacity noise: each qubit independently suffers \
X, Y or Z with fixed probabilities, between rounds, with perfect check \
measurements. That last assumption is a real one, and the sections after the \
next give it up."
}], "Text",ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],

Cell["Depolarizing noise, with the rate left symbolic:", "Text",ExpressionUUID->"6b853673-18d0-d9fa-19ba-a83d996aabc0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECNoiseModel", "[", 
   RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}], 
  "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellLabel->
  "In[31]:= ",ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "-", "p"}], ",", 
   FractionBox["p", "3"], ",", 
   FractionBox["p", "3"], ",", 
   FractionBox["p", "3"]}], "}"}]], "Output",
 CellLabel->
  "Out[31]= ",ExpressionUUID->"574a2197-51ef-7938-7d49-b8d1679a4802"]
}, Open  ]],

Cell[TextData[{
 "Because the errors are independent and identically distributed, the \
probability of a specific error depends only on how many X, Y and Z it \
carries \[LongDash] never on where they sit. That collapses a sum over ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["4", 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e85e9ed-427b-8528-16ba-00b7770fec72"],
 " errors into a sum over the far smaller set of weight profiles, and it is \
what makes everything in the next section exact rather than sampled:"
}], "Text",ExpressionUUID->"73b76025-96bb-3fff-214d-798f234f85c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QECNoiseModel", "[", 
   RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}], "[", 
  RowBox[{"\"\<ErrorProbability\>\"", ",", " ", "\"\<XIIIIII\>\""}], 
  "]"}]], "Input",
 CellLabel->
  "In[32]:= ",ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "3"], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"1", "-", "p"}], ")"}], "6"], " ", "p"}]], "Output",
 CellLabel->
  "Out[32]= ",ExpressionUUID->"72ff7667-e560-b2c0-2285-68408c1a002a"]
}, Open  ]],

Cell["\<\
The model is not a private random-number generator: it maps onto the engine's \
own channels, so the probabilities can be checked against what the engine \
actually does to a stabilizer state. Note that the conventions differ \
\[LongDash] the engine's depolarizing parameter gives each Pauli a quarter of \
it, this model spreads its rate over three \[LongDash] so the constructor \
converts, and this is the test that the conversion is right:\
\>", "Text",ExpressionUUID->"7c9be80e-0554-61c1-24b8-0268ace1332b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"noise", " ", "=", " ", 
     RowBox[{"QECNoiseModel", "[", 
      RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}]}], "}"}], ",", 
   "\n", "    ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"noise", "[", 
         RowBox[{"\"\<QuantumChannel\>\"", ",", " ", 
          RowBox[{"{", "1", "}"}]}], "]"}], "[", 
        RowBox[{"PauliStabilizer", "[", "1", "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], " ", "==", " ", 
     RowBox[{"Sort", "[", 
      RowBox[{"noise", "[", "\"\<Probabilities\>\"", "]"}], "]"}]}], "]"}]}], 
  "\n", "]"}]], "Input",
 CellLabel->
  "In[33]:= ",ExpressionUUID->"106b7ad8-6378-599b-4069-7382160d2be1"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[33]= ",ExpressionUUID->"7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"]
}, Open  ]],

Cell["\<\
For codes too large to enumerate, the model samples. A bit-flip channel can \
only produce X errors, and does:\
\>", "Text",ExpressionUUID->"304452a4-201b-d64c-607c-4b0e51afbc96"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BlockRandom", "[", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
   RowBox[{
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<BitFlip\>\"", ",", " ", 
      RowBox[{"1", "/", "3"}]}], "]"}], "[", 
    RowBox[{"\"\<RandomErrors\>\"", ",", " ", "6", ",", " ", "5"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[34]:= ",ExpressionUUID->"6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"XXIIXX\"\>", ",", "\<\"XXIIXX\"\>", ",", "\<\"IIIIXI\"\>", 
   ",", "\<\"IIXXXI\"\>", ",", "\<\"XXIXXI\"\>"}], "}"}]], "Output",
 CellLabel->
  "Out[34]= ",ExpressionUUID->"4b5b9263-9199-4e16-7978-144d202c157c"]
}, Open  ]],

Cell["The logical error rate", "Section",ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"],

Cell["\<\
This is the question the subject is about. Prepare a codeword, hit it with an \
error drawn from the noise, measure the checks, decode, correct, and ask \
whether the logical qubit got flipped.\
\>", "Text",ExpressionUUID->"2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],

Cell[TextData[{
 "One observation makes it exact. Label every Pauli error by two things: \
which checks it anticommutes with (its syndrome) and which logical operators \
it anticommutes with (its class). Both are the same question, so both are one \
matrix product over GF(2). Two errors sharing a label differ by a stabilizer, \
so the label's fibre ",
 StyleBox["is", "TI"],
 " the coset; decoding is guessing the class half from the syndrome half; and \
a correction succeeds exactly when the guess was right. No residual algebra \
per trial \[LongDash] the label already decides it."
}], "Text",ExpressionUUID->"3343f580-98d5-e31c-6170-ecea1961ce66"],

Cell["\<\
The exact logical error rate of the five-qubit code under depolarizing noise:\
\
\>", "Text",ExpressionUUID->"20a7420b-376a-b23f-505d-6455421c0105"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Expand", "[", 
  RowBox[{"QECLogicalErrorRate", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->
  "In[35]:= ",ExpressionUUID->"6af863a9-1098-c609-1a98-7af3a112ad53"],

Cell[BoxData[
 RowBox[{
  RowBox[{"10", " ", 
   SuperscriptBox["p", "2"]}], "-", 
  FractionBox[
   RowBox[{"200", " ", 
    SuperscriptBox["p", "3"]}], "9"], "+", 
  FractionBox[
   RowBox[{"160", " ", 
    SuperscriptBox["p", "4"]}], "9"], "-", 
  FractionBox[
   RowBox[{"128", " ", 
    SuperscriptBox["p", "5"]}], "27"]}]], "Output",
 CellLabel->
  "Out[35]= ",ExpressionUUID->"055bc2ad-6b92-a3be-3378-dbf70e24f184"]
}, Open  ]],

Cell[TextData[{
 "The leading term is not a fit. The five-qubit code is perfect, so every \
weight-one error is corrected and every weight-two error fails; there are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"9", 
     TemplateBox[{"5", "2"},
      "Binomial"]}], "\[LongEqual]", "90"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0fb60e-2211-365f-5934-286857a59ca5"],
 " of the latter, each of probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["p", "TI"], "/", "3"}], ")"}], "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       StyleBox["p", "TI"]}], ")"}], "3"]}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "201a2509-bdd9-2fa1-5039-bd53346c758b"],
 ", giving exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{"10", 
    SuperscriptBox[
     StyleBox["p", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 ". The polynomial is checkable by hand."
}], "Text",ExpressionUUID->"5f932952-49a5-d34f-05a0-c11c6851a195"],

Cell["\<\
The Steane code, which is not perfect, so some weight-two errors survive:\
\>", "Text",ExpressionUUID->"160f17c4-d31a-fe19-3e34-8ea1e6acc563"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"QECLogicalErrorRate", "[", 
     RowBox[{
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
      RowBox[{"QECNoiseModel", "[", 
       RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}]}], "]"}], ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->
  "In[36]:= ",ExpressionUUID->"10beb8bd-bdb6-ee93-4045-31e73440b4f9"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"49", " ", 
    SuperscriptBox["p", "2"]}], "3"], "-", 
  RowBox[{"56", " ", 
   SuperscriptBox["p", "3"]}]}]], "Output",
 CellLabel->
  "Out[36]= ",ExpressionUUID->"3fdc991b-fead-14b0-65e3-1144fb587e9a"]
}, Open  ]],

Cell["\<\
The strongest check available on any of this is a closed form that owes the \
package nothing. The repetition code under bit-flip noise fails exactly when \
a majority of its qubits flips, which is a binomial tail:\
\>", "Text",ExpressionUUID->"3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"QECLogicalErrorRate", "[", 
    RowBox[{
     RowBox[{"QECCode", "[", 
      RowBox[{"\"\<Repetition\>\"", ",", " ", "5"}], "]"}], ",", " ", 
     RowBox[{"QECNoiseModel", "[", 
      RowBox[{"\"\<BitFlip\>\"", ",", " ", "p"}], "]"}]}], "]"}], " ", "==", 
   "\n", "        ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Binomial", "[", 
       RowBox[{"5", ",", " ", "j"}], "]"}], " ", 
      RowBox[{"p", "^", "j"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "p"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"5", " ", "-", " ", "j"}], ")"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "3", ",", " ", "5"}], "}"}]}], "]"}]}], "\n", 
  "]"}]], "Input",
 CellLabel->
  "In[37]:= ",ExpressionUUID->"0642d375-09f3-9942-2e71-cb3faf87eba8"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[37]= ",ExpressionUUID->"0651775d-2bad-791b-2e6f-6f074e584861"]
}, Open  ]],

Cell["\<\
With an exact rate per code, the threshold \[LongDash] the rate below which \
adding qubits helps and above which it hurts \[LongDash] stops being a fit to \
sampled curves and becomes a crossing of polynomials. For repetition codes \
under bit flips it sits at exactly one half:\
\>", "Text",ExpressionUUID->"63b9e3d6-2298-231e-1146-fa9057128e64"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"QECLogicalErrorRate", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", 
         RowBox[{"\"\<Repetition\>\"", ",", " ", "n"}], "]"}], ",", " ", 
        RowBox[{"QECNoiseModel", "[", 
         RowBox[{"\"\<BitFlip\>\"", ",", " ", "p"}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "5", ",", " ", "7"}], "}"}]}], "}"}]}], "]"}],
     "]"}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}], ",", "\n", "    ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<n = 3\>\"", ",", " ", "\"\<n = 5\>\"", ",", 
      " ", "\"\<n = 7\>\""}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<physical error rate\>\"", ",", 
      " ", "\"\<logical error rate\>\""}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"ImageSize", " ", "->", " ", "380"}]}], "\n", "]"}]], "Input",
 CellLabel->
  "In[38]:= ",ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"],

