Cell[TextData[{
 "2. ",
 Cell[BoxData["QECPauliMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c76573-72ce-0c1a-18fd-7d3d077b5760"],
 " \[LongDash] spending the cat"
}], "Section",ExpressionUUID->"6184d2f2-049e-728e-17bb-cbbcad2b40d4"],

Cell[TextData[{
 "With a verified cat, measuring a Pauli ",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fd967ef-5008-0b29-75e7-7ec961bd5673"],
 " of weight ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19bb1c5e-57ab-6e36-4f58-9618625e351c"],
 " goes: prepare the cat, apply a controlled-",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],
 " from each cat qubit to its own data qubit, read the cat out in the ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30baa1c8-66ad-75e0-6059-389213585fca"],
 " basis, and take the ",
 StyleBox["parity",
  FontWeight->"Bold"],
 " of the outcomes \[LongDash] that parity is the eigenvalue (eqs. \
12.1\[Dash]12.3). Because a single round can still lie, the whole thing is \
repeated ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["t", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52535901-cb26-8b9c-0261-516aeed0d9e6"],
 " times and a majority taken (Theorem 12.1)."
}], "Text",ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

