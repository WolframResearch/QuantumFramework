Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "-", "3"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fd1512-f616-8834-3c82-8d5f83a0db1e"],
 " checks suffice, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c67103-72a1-9427-0efe-696d0755ff0d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
 " need none at all. A small result, and the kind this layer exists for: the \
book says a few checks are enough, and the object says how few."
}], "Text",ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],

Cell["\<\
The gadget can be placed anywhere, which is what the next section needs \
\[LongDash] the cat has to sit somewhere above the data qubits:\
\>", "Text",ExpressionUUID->"11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],

