Cell["\<\
Same distance, same single logical qubit, and one of them is CSS. Most of \
what separates the two below comes from that last bit.\
\>", "Text",ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell[TextData[{
 "1. ",
 Cell[BoxData["QECCatState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],
 " \[LongDash] an ancilla worth trusting"
}], "Section",ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell[TextData[{
 "The problem is one line long. To measure a weight-",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cb5c01f-62f5-68e0-144a-da5916803aca"],
 " check you couple ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f417ec-7166-d78d-038b-8eb60010bdd7"],
 " data qubits to an ancilla; if that ancilla is a single qubit, one fault on \
it spreads to every data qubit it touches afterwards. The fix (sec. 12.1.2) \
is to spread the ancilla out first: ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 " qubits in the cat state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "0"}], "\[Ellipsis]", "0", "\[RightAngleBracket]", "+", 
    RowBox[{"|", "1"}], "\[Ellipsis]", "1", "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d359769-845f-cd94-44ca-0f332deb97fe"],
 ", one per data qubit, so each ancilla qubit touches exactly one of them."
}], "Text",ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell[TextData[{
 "That only moves the problem, because preparing the cat state is itself a \
circuit, and one fault in it can produce exactly the correlated error the \
construction was meant to avoid. So the cat is ",
 StyleBox["verified",
  FontWeight->"Bold"],
 ": parity checks between pairs of its qubits, each one a herald that rejects \
the shot."
}], "Text",ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

