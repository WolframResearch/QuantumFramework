  "Out[18]= ",ExpressionUUID->"023f49e2-a747-9723-33c5-60cfd2f3fa09"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<RepetitionsNeeded\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21aa1c49-e16c-f406-57a9-9612901edf6c"],
 " is 1, and that is why this gadget and not Shor's fills the slot left open \
in section 2: the errors are ",
 StyleBox["additive",
  FontWeight->"Bold"],
 ". The measured classical error is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["e", "TI"], "+", 
    StyleBox["f", "TI"], "+", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "289b85cd-827f-9a9c-58b8-1c97370be8e6"],
 " for ",
 Cell[BoxData[
  FormBox[
   StyleBox["e", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f3dbee-abc4-6375-4280-d2cbce714e5f"],
 " the true data error, ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
 " the ancilla's and ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cfa2c34-ef50-7d46-5499-c6718ae547ac"],
 " the measurement's, so correcting by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["e", "TI"], "+", 
    StyleBox["f", "TI"], "+", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "362a4e41-4988-041f-5e2a-602b683d6f65"],
 " leaves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "+", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01ed6b92-5a5f-fa78-3792-82dc5febc942"],
 " behind \[LongDash] a single fault can only leave a single error, with no \
repetition and no majority vote at all (sec. 12.3.3)."
}], "Text",ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"],

Cell["\<\
Measured in the same units as section 2, and split in two, because the gadget \
is honest about which half is which:\
\>", "Text",ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<regions\>\"", " ", "->", " ", 
    RowBox[{"Map", "[", 
     RowBox[{"Length", ",", " ", 
      RowBox[{"ec", "[", "\"\<Regions\>\"", "]"}]}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<interaction\>\"", " ", "->", " ", 
    RowBox[{"ec", "[", "\"\<DataWeights\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<preparation\>\"", " ", "->", " ", 
    RowBox[{"ec", "[", "\"\<PreparationDataWeights\>\"", "]"}]}]}], 
  "|>"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"regions\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"Preparation\"\>", "\[Rule]", "65"}], ",", 
      RowBox[{"\<\"Interaction\"\>", "\[Rule]", "36"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"interaction\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}], ",", 
   RowBox[{"\<\"preparation\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[19]= ",ExpressionUUID->"2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"]
}, Open  ]],

Cell[TextData[{
 "The ",
 StyleBox["interaction",
  FontWeight->"Bold"],
 " \[LongDash] the transversal CNOTs and the readout \[LongDash] leaves at \
most one data error per fault, which is the additivity above. The ",
 StyleBox["preparation",
  FontWeight->"Bold"],
 " of the ancilla leaves up to four, because that preparation is still the \
code's ordinary, non-fault-tolerant encoder. That is chapter 13's work \
appearing as a number instead of a caveat, and it is the open assumption \
every gadget in this note carries \[LongDash] until section 7 pays it."
}], "Text",ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c"],

Cell["Each half is readable on its own:", "Text",ExpressionUUID->"52243646-2fbd-210e-03db-a8204a487054"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Take", "[", 
