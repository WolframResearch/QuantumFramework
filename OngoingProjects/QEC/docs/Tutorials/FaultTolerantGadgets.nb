ionUUID->"08730a59-14ca-494a-816d-f559f9cb327d"],

Cell[TextData[{
 "Every one of them answers ",
 Cell[BoxData[
  RowBox[{"obj", "[", "\"\<Properties\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0976d5ae-737d-f257-3f0d-cc080609c0bd"],
 " with its full list, and every one that stands on something it has not \
built says so in ",
 Cell[BoxData[
  RowBox[{"obj", "[", "\"\<OpenAssumptions\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13e711b4-4d78-4d68-419c-88fe640d17b2"],
 "."
}], "Text",ExpressionUUID->"3fd09d86-aea1-a602-65ef-14e3cb550d68"],

