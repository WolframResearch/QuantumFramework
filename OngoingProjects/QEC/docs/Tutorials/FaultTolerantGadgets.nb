Cell[BoxData[
 RowBox[{"Dataset", " ", "@", " ", 
  RowBox[{"AssociationMap", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"QECTransversalGate", "[", 
       RowBox[{"steane", ",", " ", "#"}], "]"}], "[", "\"\<LogicalGate\>\"", 
      "]"}], " ", "&"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<CNOT\>\"", ",", " ", "\"\<CZ\>\"", ",", 
