  RowBox[{
   RowBox[{"\<\"DataQubits\"\>", "\[Rule]", "7"}], ",", 
   RowBox[{"\<\"AncillaQubits\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "8", ",", "9", ",", "10", ",", "11", ",", "12", ",", "13", ",", "14"}], 
     "}"}]}], ",", 
   RowBox[{"\<\"Offset\"\>", "\[Rule]", "7"}], ",", 
   RowBox[{"\<\"Order\"\>", "\[Rule]", "\<\"BitFlipFirst\"\>"}], ",", 
   RowBox[{"\<\"Qubits\"\>", "\[Rule]", "14"}], ",", 
   RowBox[{"\<\"Measurements\"\>", "\[Rule]", "14"}], ",", 
   RowBox[{"\<\"Depth\"\>", "\[Rule]", "27"}], ",", 
   RowBox[{"\<\"InstructionCount\"\>", "\[Rule]", "100"}], ",", 
   RowBox[{"\<\"RepetitionsNeeded\"\>", "\[Rule]", "1"}]}], 
