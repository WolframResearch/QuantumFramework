Cell["\<\
and the order of the two halves is a choice with a consequence:\
\>", "Text",ExpressionUUID->"1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"QECErrorCorrection", "[", "steane", "]"}], "[", "\"\<Order\>\"", 
    "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"QECErrorCorrection", "[", 
     RowBox[{"steane", ",", " ", 
      RowBox[{"\"\<Order\>\"", " ", "->", " ", "\"\<PhaseFirst\>\""}]}], 
     "]"}], "[", "\"\<Order\>\"", "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"6f6ad260-8ee1-565a-1569-d44a2a943ca0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"BitFlipFirst\"\>", ",", "\<\"PhaseFirst\"\>"}], 
  "}"}]], "Output",
 CellLabel->
  "Out[21]= ",ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"]
}, Open  ]],

Cell[TextData[{
 "Either order is fault tolerant \[LongDash] Theorem 12.5 does not care \
\[LongDash] but the errors left at the end tend to be of the type corrected \
",
 StyleBox["first", "TI"],
 ", since more locations follow it."
}], "Text",ExpressionUUID->"26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],

Cell[TextData[{
 "The construction rests on the transversal CNOT being the logical CNOT, \
which holds for CSS codes and fails in general, so ",
 Cell[BoxData[
  RowBox[{"QECErrorCorrection", "[", "five", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],
 " is refused with a message rather than assembled into something that \
silently is not error correction. The next two sections are where that claim \
stops being a citation."
}], "Text",ExpressionUUID->"6b853673-18d0-d9fa-19ba-a83d996aabc0"],

Cell[TextData[{
 "4. ",
 Cell[BoxData["QECRegister"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25b5b884-ef74-61b3-534a-31e18a013399"],
 " \[LongDash] a logical qubit is a block"
}], "Section",ExpressionUUID->"574a2197-51ef-7938-7d49-b8d1679a4802"],

Cell[TextData[{
 "Everything so far lives on one block. A memory experiment needs no more, \
which is why the sections above never mentioned layout. Anything that ",
 StyleBox["computes", "TI"],
 " does: a logical two-qubit gate is a gate between two blocks, and Theorem \
13.2 needs ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["m", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e85e9ed-427b-8528-16ba-00b7770fec72"],
 " blocks for a gate touching ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73b76025-96bb-3fff-214d-798f234f85c5"],
 " of them."
}], "Text",ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"],

Cell[TextData[{
 Cell[BoxData["QECRegister"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ff7667-e560-b2c0-2285-68408c1a002a"],
 " fixes the layout once \[LongDash] block ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c9be80e-0554-61c1-24b8-0268ace1332b"],
 " owns qubits ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["b", "TI"], "-", "1"}], ")"}], 
    StyleBox["n", "TI"], "+", "1", "\[Ellipsis]", 
    StyleBox["b", "TI"], 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "106b7ad8-6378-599b-4069-7382160d2be1"],
 " \[LongDash] so nothing downstream has to guess it:"
}], "Text",ExpressionUUID->"7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],

