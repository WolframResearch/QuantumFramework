Cell[TextData[{
 "All twenty-four one-qubit Cliffords on the seven-qubit code \[LongDash] \
which is what chapter 11 singles it out for \[LongDash] and exactly half of \
them on the five-qubit code. Half is not none, and the ones it has are worth \
seeing: no ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c5e608e-35dc-f74f-3466-79e8bc6edd95"],
 ", no ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a1e4090-3303-05ed-4a26-59da46b66f37"],
 ", but the cyclic Clifford ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["X", "TI"], "\[Rule]", 
    StyleBox["Y", "TI"], "\[Rule]", 
    StyleBox["Z", "TI"], "\[Rule]", 
    StyleBox["X", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10256af3-3972-af7a-41da-83bdb804f240"],
 ", which is ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "457602f1-d86e-ac86-730d-9bbad918f6ec"],
 " followed by ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "499f95c1-a958-6c18-7fa4-0caac8ed3762"],
 ":"
}], "Text",ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

