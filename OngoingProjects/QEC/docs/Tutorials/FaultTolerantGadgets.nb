Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ft", "[", "\"\<GadgetCounts\>\"", "]"}]], "Input",
 CellLabel->
  "In[35]:= ",ExpressionUUID->"2f4595f3-090a-1216-557a-0cbda8bf617c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Preparation\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"ErrorCorrection\"\>", "\[Rule]", "6"}], ",", 
   RowBox[{"\<\"Gate\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"Storage\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"Measurement\"\>", "\[Rule]", "2"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[35]= ",ExpressionUUID->"06385f5e-e9d4-4e6c-2fd8-571b886114b6"]
}, Open  ]],

Cell[TextData[{
 "Two rows deserve a look. The ",
 StyleBox["storage",
  FontWeight->"Bold"],
 " gadget is block 2 waiting while block 1 gets its Hadamard: a wait is a \
location, the book's storage gadget is \"just putting a wait location for all \
physical qubits in the code\", and it earns a correction like any other. It \
emits no instructions and it still costs. And there are ",
 StyleBox["six",
  FontWeight->"Bold"],
 " corrections rather than four \[LongDash] one per live block per layer, \
stopping when a block is measured."
}], "Text",ExpressionUUID->"25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],

Cell["\<\
Definition 10.6 also defines what that costs, in three ratios:\
\>", "Text",ExpressionUUID->"3b9a140e-d97a-4136-69b9-8e6bd80f101c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ft", "[", "\"\<Overheads\>\"", "]"}]], "Input",
 CellLabel->
  "In[36]:= ",ExpressionUUID->"4f9438da-b80f-a114-75ab-b18439bbf07e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Size\"\>", "\[Rule]", "263"}], ",", 
   RowBox[{"\<\"Qubits\"\>", "\[Rule]", "14"}], ",", 
   RowBox[{"\<\"Depth\"\>", "\[Rule]", 
    FractionBox["77", "4"]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[36]= ",ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ft", "[", "\"\<CircuitLocations\>\"", "]"}], ",", " ", 
   RowBox[{"ft", "[", "\"\<Locations\>\"", "]"}], ",", " ", 
   RowBox[{"ft", "[", "\"\<Depth\>\"", "]"}], ",", " ", 
   RowBox[{"ft", "[", "\"\<InstructionCount\>\"", "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[37]:= ",ExpressionUUID->"3c8746fc-db76-c487-64bd-5fb9de00aeed"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"7", ",", "1841", ",", "77", ",", "692"}], "}"}]], "Output",
 CellLabel->
  "Out[37]= ",ExpressionUUID->"11f0f87a-e6f0-91cd-478f-f227928ae317"]
}, Open  ]],

Cell[TextData[{
 "Seven locations become 1841 \[LongDash] counted on both sides as \
instructions ",
 StyleBox["plus waits", "TI"],
 ", which is what keeps the first ratio honest. Fourteen physical qubits per \
logical one: seven for the block and seven for its own correction workspace, \
one workspace per block so the corrections of a layer run in parallel instead \
of queueing. And nineteen and a quarter times the depth. Those are the \
numbers a fault-tolerance threshold has to beat, and they are why the subject \
is about ",
 StyleBox["rates", "TI"],
 " rather than counts."
}], "Text",ExpressionUUID->"473164ce-b547-c1f4-6ecf-7da83cf393de"],

Cell[TextData[{
 "Now the detail that makes this more than bookkeeping. Asked for a logical \
",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c4fc3b-e00c-2bba-42fb-f66491b97980"],
 ", the assembler emits a transversal ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "\[Dagger]"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7e6892-18cd-6f45-4b05-81dc997835af"],
 ":"
}], "Text",ExpressionUUID->"325c8f47-cd85-89da-6263-2720e431db20"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", " ", "@", " ", 
  RowBox[{"Map", "[", 
   RowBox[{"First", ",", " ", 
    RowBox[{
     RowBox[{"QECFaultTolerant", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<R\>\"", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<S\>\"", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", 
       "steane"}], "]"}], "[", 
     RowBox[{"\"\<GadgetInstructions\>\"", ",", " ", "\"\<Gate\>\""}], 
     "]"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[38]:= ",ExpressionUUID->"43fcea2e-12ab-c026-7183-0388a75f930c"],

Cell[BoxData[
 RowBox[{"{", "\<\"Sdg\"\>", "}"}]], "Output",
 CellLabel->
  "Out[38]= ",ExpressionUUID->"5b416c07-c3d3-bf4f-097e-8660f6670595"]
}, Open  ]],

Cell[TextData[{
 "It never emits \"the transversal version of the gate it was asked for\" \
\[LongDash] it asks which word has the requested ",
 StyleBox["logical", "TI"],
 " action, which is section 5 doing work. A protocol assembled by name would \
compute the complex conjugate of the intended circuit and look perfectly \
healthy doing it: on the engine, assembled properly the encoded qubit ends in \
the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5add4728-e92e-eff1-0ae3-5f7588d8b5db"],
 " eigenstate of ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Y", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "621761a3-d300-b412-122d-780ce6ba1f78"],
 ", and assembled by name in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],
 " eigenstate."
}], "Text",ExpressionUUID->"7d3ffb2e-09a8-fc78-24c4-f288a842c742"],

Cell["\<\
The classical side is tracked too. A measurement gadget's outcomes sit in a \
record otherwise full of error-correction syndromes, so a decoder has to be \
told which ones make the logical bit:\
\>", "Text",ExpressionUUID->"4139b36b-52b1-2977-70c6-2b356744785d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<measurements\>\"", " ", "->", " ", 
    RowBox[{"ft", "[", "\"\<Measurements\>\"", "]"}]}], ",", " ", 
   RowBox[{"\"\<logical bit of qubit 1\>\"", " ", "->", " ", 
    RowBox[{
     RowBox[{"ft", "[", "\"\<Readouts\>\"", "]"}], "[", "1", "]"}]}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<of qubit 2\>\"", " ", "->", " ", 
    RowBox[{
     RowBox[{"ft", "[", "\"\<Readouts\>\"", "]"}], "[", "2", "]"}]}]}], 
  "|>"}]], "Input",
 CellLabel->
  "In[39]:= ",ExpressionUUID->"494d6e39-7750-b6eb-7f72-806302ea1c31"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"measurements\"\>", "\[Rule]", "98"}], ",", 
   RowBox[{"\<\"logical bit of qubit 1\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"86", ",", "88", ",", "90"}], "}"}]}], ",", 
   RowBox[{"\<\"of qubit 2\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"93", ",", "95", ",", "97"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[39]= ",ExpressionUUID->"39b01e29-d171-5c92-6f4f-9072e00426f8"]
}, Open  ]],

Cell[TextData[{
 "Three outcomes out of ninety-eight, being the support of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "\[LongEqual]", 
    StyleBox["I", "TI"], 
    StyleBox["Z", "TI"], 
    StyleBox["I", "TI"], 
    StyleBox["Z", "TI"], 
    StyleBox["I", "TI"], 
    StyleBox["Z", "TI"], 
    StyleBox["I", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f6d713e-2461-11c8-7513-69784d146312"],
 " inside that block's own measurements."
}], "Text",ExpressionUUID->"14ad582f-66ff-93eb-3c53-5189128be131"],

Cell["\<\
And what the protocol is not, said by the object rather than left to the \
reader:\
\>", "Text",ExpressionUUID->"4f7ea056-2d28-85ec-7505-3a1044c2ef36"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"ft", "[", "\"\<OpenAssumptions\>\"", "]"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "1"}]}], "]"}]], "Input",
 CellLabel->
  "In[40]:= ",ExpressionUUID->"16b00368-b832-202d-3e4f-9b3239c77377"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Preparation of an encoded |0> uses the code's own encoder, which is \
not fault tolerant (Got26 Procedure 6.6); so do the ancillas of every error \
correction gadget. Fault-tolerant preparation is chapter 13 work.\"\>"},
    {"\<\"The gate gadgets are transversal, so the protocol is Clifford only. \
A universal set (Def 10.5) needs the constructions of chapter 13.\"\>"},
    {"\<\"Corrections are carried in the Pauli frame (sec. 12.5.2) rather \
than applied, so the emitted circuit has no classically conditioned \
instruction.\"\>"}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{1}}}],
  "Column"]], "Output",
 CellLabel->
  "Out[40]= ",ExpressionUUID->"06d00634-a672-f252-2eef-9871d304c0b8"]
}, Open  ]],

Cell[TextData[{
 "The preparation gadget is the code's own encoder, and so are the ancillas \
of every correction \[LongDash] the same debt section 3 measured as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],
 ". The gate gadgets are transversal, so the gate set is Clifford: Definition \
10.5 asks for a ",
 StyleBox["universal", "TI"],
 " set, and a circuit with a ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583a98af-415b-100e-09d9-110970ee6354"],
 " in it is refused rather than approximated. And corrections stay in the \
Pauli frame, so nothing in the emitted circuit is classically conditioned \
\[LongDash] which is what real experiments do, and one fewer location that \
can fail."
}], "Text",ExpressionUUID->"07beae85-a317-6bf9-2d45-47eed6a239c3"],

Cell["The six, side by side", "Section",ExpressionUUID->"503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],

Cell[BoxData[GridBox[{
   {Cell["function", "TableText",
     FontWeight->Bold,ExpressionUUID->"60049622-f570-0e0e-103b-0f8ffc055554"],
     Cell["takes", "TableText",
     FontWeight->Bold,ExpressionUUID->"40ea559d-da93-7842-70ea-4cc6df264aa8"],
     Cell["gives back", "TableText",
     FontWeight->Bold,ExpressionUUID->"23ccc6ee-92c0-e596-51f3-dfc8277acffc"],
     Cell["the one thing it is for", "TableText",
     FontWeight->Bold,ExpressionUUID->"114d8d02-b276-9c05-4772-256fc700e76f"]},
   {Cell[TextData[Cell[BoxData[
     RowBox[{"QECCatState", "[", "m", "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2dc22b63-32d1-862f-5bf1-c34d4765ed75"]], "TableText",ExpressionUUID->
     "36ea7e2c-072a-2221-5eea-7076b2df710b"], Cell[TextData[{
     "the width ",
     Cell[BoxData[
      FormBox[
       StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5b23761c-2477-64e8-0ad1-68464d024e32"],
     ", or explicit qubits and a check qubit; options ",
     Cell[BoxData["\"\<Pairs\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "73216bcf-7cf1-61ac-22de-82a9748433f6"],
     ", ",
     Cell[BoxData["\"\<Repetitions\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"]
    }], "TableText",ExpressionUUID->"409bca18-cbd6-e54d-70b8-ec45ee60cf97"], 
    Cell["\<\
the preparation and its checks, the dangerous patterns, whether the checks \
cover them\
\>", "TableText",ExpressionUUID->"10b62b5f-1d3f-f012-404d-c31994cbc378"], 
    Cell["an ancilla a single fault cannot corrupt undetected", "TableText",
     ExpressionUUID->"79984792-c453-565a-2fb8-5edfede63ca0"]},
   {Cell[TextData[Cell[BoxData[
     RowBox[{"QECPauliMeasurement", "[", 
      RowBox[{"code", ",", " ", "P"}], "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1d45428e-8fa1-6801-4b7b-5be82a543b6b"]], "TableText",ExpressionUUID->
     "604bb87d-3174-a116-1048-32274006f07c"], Cell[TextData[{
     "a code and a Pauli; an optional repetition count; options ",
     Cell[BoxData["\"\<Pairs\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "763191a2-6f8b-197a-1fce-080c0a3e6840"],
     ", ",
     Cell[BoxData["\"\<CatRepetitions\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "635fdfdb-2856-deda-1164-d68549e0a420"],
     ", ",
     Cell[BoxData["\"\<ErrorCorrection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0f6eb37a-d9e9-6713-3515-2b27df9c4a79"]
    }], "TableText",ExpressionUUID->"5c8469dd-bfc7-2a7a-04bb-80873a727940"], 
    Cell["\<\
the circuit, the heralds, the residual data weights, whether the majority is \
right\
\>", "TableText",ExpressionUUID->"182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"], 
    Cell["measuring one Pauli without spreading errors", "TableText",
     ExpressionUUID->"3921e4bb-f5e4-3596-68de-fde483969ffc"]},
   {Cell[TextData[Cell[BoxData[
     RowBox[{"QECErrorCorrection", "[", "code", "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "13db9173-5387-1c16-41f8-093d6632677c"]], "TableText",ExpressionUUID->
     "6804c0ab-fd16-b7db-183b-d9f4f4a01d21"], Cell[TextData[{
     "a CSS code; an optional ancilla offset; option ",
     Cell[BoxData["\"\<Order\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "77076ae4-09e5-8344-1d3c-83ceaf91d1ae"]
    }], "TableText",ExpressionUUID->"4289b0c6-8043-1b93-72b6-29a031f669f9"], 
    Cell["\<\
the two halves, the two regions, and the data weights of each\
\>", "TableText",ExpressionUUID->"070f3e08-556d-9d60-2d34-b0525c19e44a"], 
    Cell["correcting a whole block, with no repetition needed", "TableText",
     ExpressionUUID->"6d593b15-c37a-9c59-1b66-b35ef60ce6a3"]},
   {Cell[TextData[Cell[BoxData[
     RowBox[{"QECRegister", "[", 
      RowBox[{"code", ",", " ", "b"}], "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4140e475-1e41-1f16-777f-fe3f9bf4627c"]], "TableText",ExpressionUUID->
     "67f13035-938c-831a-0d8e-aa7f263eee60"], Cell[
    "a code and a number of blocks", "TableText",ExpressionUUID->
     "16b44e14-0404-e868-3e4c-605eadb6bab2"], Cell["\<\
the layout, the lift, the transversal CNOT and what it does logically\
\>", "TableText",ExpressionUUID->"70bc3c38-1a7f-2cd8-2043-b6629f0a7622"], 
    Cell["making a logical qubit addressable", "TableText",ExpressionUUID->
     "7e10bd94-ae42-3b4d-262f-34d1cbf48997"]},
   {Cell[TextData[Cell[BoxData[
     RowBox[{"QECTransversalGate", "[", 
      RowBox[{"code", ",", " ", "gate"}], "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"]], "TableText",ExpressionUUID->
     "013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"], Cell[TextData[{
     "a code and a gate, a sequence of gates, or ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4b734859-75e7-efa6-7901-62030393b58c"]
    }], "TableText",ExpressionUUID->"4ae31c17-eefa-a706-7a90-96508a8c0a6c"], 
    Cell["\<\
whether it is a gadget, the images of the generators, the logical action and \
its name\
\>", "TableText",ExpressionUUID->"00844d77-2817-3ec6-30bc-653149a3842c"], 
    Cell["knowing which logical gate you actually performed", "TableText",
     ExpressionUUID->"20b97f64-b973-0c8a-5047-774e380656d0"]},
   {Cell[TextData[Cell[BoxData[
     RowBox[{"QECFaultTolerant", "[", 
      RowBox[{"circuit", ",", " ", "code"}], "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "04469009-6b02-dcc3-2c7d-0a530eb4a629"]], "TableText",ExpressionUUID->
     "4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"], Cell[
    "an ideal Clifford circuit on logical qubits, and a CSS code", 
     "TableText",ExpressionUUID->"5547dfb6-0e84-e145-037c-d6f0ab36b3af"], 
    Cell[TextData[{
     Cell[BoxData[
      FormBox[
       RowBox[{
        StyleBox["F", "TI"], 
        StyleBox["T", "TI"], 
        RowBox[{"(", 
         StyleBox["C", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "12b61bfc-9cd7-eca9-424d-92a61563b6f3"],
     ", its gadget table, its readouts, and the three overheads"
    }], "TableText",ExpressionUUID->"451364b5-819d-fb99-7321-7dff3029c9e3"], 
    Cell["turning a circuit into its fault-tolerant simulation", "TableText",
     ExpressionUUID->"13b49e24-0fb7-4441-414b-178eaa422eab"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
  GridBoxDividers->{"Columns" -> {{None}}, "Rows" -> {{True}}},
  GridBoxSpacings->{"Columns" -> {{1.5}}, "Rows" -> {{0.7}}}]], "Text",Express\
ionUUID->"17171511-2b46-499a-b4c0-1a35a03c071f"],

Cell[TextData[{
 "Every one of them answers ",
 Cell[BoxData[
  RowBox[{"obj", "[", "\"\<Properties\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],
 " with its full list, and every one that stands on something it has not \
built says so in ",
 Cell[BoxData[
  RowBox[{"obj", "[", "\"\<OpenAssumptions\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "089aa42d-ce49-3603-38b9-3e76ebfd9d69"],
 "."
}], "Text",ExpressionUUID->"48fccab3-b886-a0f7-7883-e3fd3930f2dd"],

Cell["Where this comes from", "Section",ExpressionUUID->"0cdaad60-2181-5e26-34f9-454a5034250c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "542cff75-84e0-b601-7dd3-f73f2c9a1d6b"], Cell["claim", "TableText",
     FontWeight->Bold,ExpressionUUID->"00dd9d4d-f7ec-565f-30e2-151681993ca5"],
     Cell["source", "TableText",
     FontWeight->Bold,ExpressionUUID->"0d66b502-775d-ec4c-3b1d-2d6c02e9b696"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"], Cell[
    "cat states as a spread-out ancilla, and their verification", "TableText",
     ExpressionUUID->"333832e2-8bec-4128-62c7-abcc2d991072"], Cell[TextData[{
     "Gottesman, ",
     StyleBox["Surviving as a Quantum Computer in a Classical World", "TI"],
     ", sec. 12.1.2\[Dash]12.1.3"
    }], "TableText",ExpressionUUID->"78cf51d6-d7cd-4672-28f5-4893e2782d58"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"], Cell[
    "the parity of the cat readout is the eigenvalue", "TableText",
     ExpressionUUID->"710db4a8-d877-0db2-2732-2df5d9025798"], Cell[
    "ibid., eqs. 12.1\[Dash]12.3", "TableText",ExpressionUUID->
