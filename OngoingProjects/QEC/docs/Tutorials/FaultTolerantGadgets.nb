Cell[TextData[{
 "Four resets, a Hadamard and a chain of CNOTs \[LongDash] that is the cat. \
Then a fifth qubit, two CNOTs from the pair being compared, and an ",
 Cell[BoxData["MH"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
 ": a measurement whose outcome is a ",
 StyleBox["herald", "TI"],
 ", deciding whether the shot is kept at all."
}], "Text",ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],

Cell[TextData[{
 "Now the part that is derived rather than assumed. A single fault during \
preparation leaves one of a small set of patterns on the cat, and only some \
of them are dangerous: ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["X", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["m", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],
 " stabilises the cat state, so a pattern and its complement are the same \
physical error, and only patterns of canonical weight ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GreaterEqual]", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],
 " can hurt. The object computes that set, and whether the checks it was \
given actually cover it:"
}], "Text",ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<dangerous\>\"", " ", "->", " ", 
    RowBox[{"cat", "[", "\"\<DangerousPatterns\>\"", "]"}]}], ",", " ", 
   RowBox[{"\"\<checks\>\"", " ", "->", " ", 
    RowBox[{"cat", "[", "\"\<Pairs\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<covered\>\"", " ", "->", " ", 
    RowBox[{"cat", "[", "\"\<ChecksCoverQ\>\"", "]"}]}]}], "|>"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"dangerous\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1", ",", "1"}], "}"}], "}"}]}], ",", 
   RowBox[{"\<\"checks\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], "}"}]}], ",", 
   RowBox[{"\<\"covered\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"]
}, Open  ]],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 " the one dangerous pattern is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 " \[LongDash] exactly the error drawn in the book's figure 12.3b \[LongDash] \
and comparing qubits 2 and 3 catches it. Sweeping the width gives the rule:"
}], "Text",ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dataset", " ", "@", " ", 
  RowBox[{"Association", " ", "@", " ", 
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"m", " ", "->", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<checks\>\"", " ", "->", " ", 
         RowBox[{"Length", "[", 
          RowBox[{
           RowBox[{"QECCatState", "[", "m", "]"}], "[", "\"\<Pairs\>\"", 
           "]"}], "]"}]}], ",", "\n", "           ", 
        RowBox[{"\"\<dangerous\>\"", " ", "->", " ", 
         RowBox[{"Length", "[", 
          RowBox[{
           RowBox[{"QECCatState", "[", "m", "]"}], 
           "[", "\"\<DangerousPatterns\>\"", "]"}], "]"}]}], ",", "\n", 
        "           ", 
        RowBox[{"\"\<covered\>\"", " ", "->", " ", 
         RowBox[{
          RowBox[{"QECCatState", "[", "m", "]"}], "[", "\"\<ChecksCoverQ\>\"",
           "]"}]}]}], "|>"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "2", ",", " ", "6"}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

