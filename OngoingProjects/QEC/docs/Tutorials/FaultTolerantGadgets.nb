Cell[TextData[{
 "All twenty-four one-qubit Cliffords on the seven-qubit code \[LongDash] \
which is what chapter 11 singles it out for \[LongDash] and exactly half of \
them on the five-qubit code. Half is not none, and the ones it has are worth \
seeing: no ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ce33075-6d34-44a7-1490-aa3f04c12e8d"],
 ", no ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],
 ", but the cyclic Clifford ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["X", "TI"], "\[Rule]", 
    StyleBox["Y", "TI"], "\[Rule]", 
    StyleBox["Z", "TI"], "\[Rule]", 
    StyleBox["X", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6334ac9c-43f1-85c0-12cb-45c67585ef2a"],
 ", which is ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74397683-04f4-1d4d-1dc7-6fedac816797"],
 " followed by ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "735e49d5-32a1-4a48-2166-609f47541892"],
 ":"
}], "Text",ExpressionUUID->"335d55a2-cf9b-493d-6163-4c0fea2e1807"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"QECTransversalGate", "[", 
      RowBox[{"five", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<S\>\"", ",", " ", "\"\<H\>\""}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "    ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<H alone\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"QECTransversalGate", "[", 
        RowBox[{"five", ",", " ", "\"\<H\>\""}], "]"}], 
       "[", "\"\<TransversalQ\>\"", "]"}]}], ",", "\n", "      ", 
     RowBox[{"\"\<S then H\>\"", " ", "->", " ", 
      RowBox[{"g", "[", "\"\<TransversalQ\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<action\>\"", " ", "->", " ", 
      RowBox[{"g", "[", "\"\<LogicalAction\>\"", "]"}]}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[31]:= ",ExpressionUUID->"3bfbbd45-edb8-1b0b-6998-352e844d6651"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"H alone\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"S then H\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"action\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\<\"X\"\>", ",", "1"}], "}"}], "\[Rule]", "\<\"-Y\"\>"}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\<\"Z\"\>", ",", "1"}], "}"}], "\[Rule]", "\<\"-X\"\>"}]}], 
     "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[31]= ",ExpressionUUID->"045023ab-c37d-b770-2c6f-baf4f6091a5a"]
}, Open  ]],

Cell["\<\
Between two blocks the answer is the CNOT, with the signs now carried, and \
two more gates come free with the same symmetry:\
\>", "Text",ExpressionUUID->"73e8aeff-5b91-f8f4-2197-47b95e25cade"],

