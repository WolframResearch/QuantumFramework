 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"data weights\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}], ",", 
   RowBox[{"\<\"worst\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"transversal\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"heralds\"\>", "\[Rule]", "3"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[12]= ",ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"]
}, Open  ]],

Cell[TextData[{
 StyleBox["One fault, at most one data error.",
  FontWeight->"Bold"],
 " The bare-ancilla circuit measuring the same generator leaves ",
 StyleBox["four",
  FontWeight->"Bold"],
 " \[LongDash] that is the hook error, a defect of the gadget rather than a \
fact about circuit-level noise, and removing it is what this object is for. \
The three heralds are the price: a shot can be rejected, so the acceptance \
probability belongs with any rate computed from this circuit \[LongDash] \
which is what ",
 Cell[BoxData[
  RowBox[{"QECLogicalErrorRate", "[", 
   RowBox[{"code", ",", " ", "noise", ",", " ", "All"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08285353-0e0e-39f8-3828-4b1dabb88bc2"],
 " and ",
 Cell[BoxData[
  RowBox[{"dem", "[", "\"\<Acceptance\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],
 " report."
}], "Text",ExpressionUUID->"187adc3d-3961-76c2-4819-d667b8145c28"],

Cell["\<\
And now the thing worth pausing on, because the object refuses to overclaim:\
\>", "Text",ExpressionUUID->"641c78eb-7f03-7846-0c24-71b57ab64aac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<majority is right\>\"", " ", "->", " ", 
    RowBox[{"meas", "[", "\"\<MeasurementCorrectQ\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<error correction between repetitions\>\"", " ", "->", " ", 
    RowBox[{"meas", "[", "\"\<ErrorCorrection\>\"", "]"}]}]}], 
  "|>"}]], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"majority is right\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"error correction between repetitions\"\>", "\[Rule]", 
    "None"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"112ae6ec-4b5c-6ad2-4729-ffb66ee93838"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6121b9de-dddd-aca8-10de-309bd469f6f2"],
 ". Repetition plus majority handles faults in the ",
 StyleBox["ancilla", "TI"],
 ", and nothing else. A data error that anticommutes with ",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30209679-023a-ee91-61df-0823b7ccb4fb"],
 " flips the true answer, so every repetition sees the same wrong value and \
the majority is confidently wrong (sec. 12.1.4). The object says which \
assumption it is standing on:"
}], "Text",ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{"meas", "[", "\"\<OpenAssumptions\>\"", "]"}], "]"}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"No error correction is spliced between repetitions, so a data error \
anticommuting with the measured Pauli defeats every repetition alike (Got26 \
sec. 12.1.4). The gadget handles ancilla faults only.\"\>"}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellLabel->
  "Out[14]= ",ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"]
}, Open  ]],

Cell["\<\
That is also what Theorem 12.1 says to do about it: interleave fault-tolerant \
error correction between the repetitions. Splice one in \[LongDash] which \
needs a CSS code, for reasons the next section gives \[LongDash] and the \
answer changes:\
\>", "Text",ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"withEC", " ", "=", " ", 
   RowBox[{"QECPauliMeasurement", "[", 
    RowBox[{"steane", ",", " ", "\"\<IIIXXXX\>\"", ",", " ", 
     RowBox[{"\"\<ErrorCorrection\>\"", " ", "->", " ", "\"\<Steane\>\""}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<majority is right\>\"", " ", "->", " ", 
    RowBox[{"withEC", "[", "\"\<MeasurementCorrectQ\>\"", "]"}]}], ",", " ", 
   RowBox[{"\"\<repetitions\>\"", " ", "->", " ", 
    RowBox[{"withEC", "[", "\"\<Repetitions\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<data weights\>\"", " ", "->", " ", 
    RowBox[{"withEC", "[", "\"\<DataWeights\>\"", "]"}]}], ",", " ", 
   RowBox[{"\"\<qubits\>\"", " ", "->", " ", 
    RowBox[{"withEC", "[", "\"\<Qubits\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<depth\>\"", " ", "->", " ", 
    RowBox[{"withEC", "[", "\"\<Depth\>\"", "]"}]}]}], "|>"}]}], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"majority is right\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"repetitions\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"data weights\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}], ",", 
   RowBox[{"\<\"qubits\"\>", "\[Rule]", "19"}], ",", 
   RowBox[{"\<\"depth\"\>", "\[Rule]", "77"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[15]= ",ExpressionUUID->"51fce014-dca1-0630-0783-fa51d5546d1a"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657c1c65-980e-511d-1303-964f19bb2067"],
 ", at the price of nineteen qubits and a depth of 77 for one measurement of \
one generator. The open assumption that remains is the one every gadget in \
this note inherits, and it is the honest one:"
}], "Text",ExpressionUUID->"0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{"withEC", "[", "\"\<OpenAssumptions\>\"", "]"}], "]"}]], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"The ancilla blocks are prepared by the code's own encoder, which is \
not fault tolerant (Got26 Procedure 6.6). Fault-tolerant preparation of \
encoded |0> and |+> is chapter 13 work, and this gadget is fault tolerant \
given a clean ancilla.\"\>"}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellLabel->
  "Out[16]= ",ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"]
}, Open  ]],

Cell[TextData[{
 "3. ",
 Cell[BoxData["QECErrorCorrection"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],
 " \[LongDash] Steane EC"
}], "Section",ExpressionUUID->"370294fd-9e49-2d35-5d31-0da71bfc741f"],

Cell[TextData[{
 "Measuring one Pauli is not error correction: for that you need every \
generator and then a decoder. Section 12.3 does all of them at once for a CSS \
code, and with a different trick \[LongDash] instead of a cat, a whole ",
 StyleBox["encoded ancilla block",
  FontWeight->"Bold"],
 "."
}], "Text",ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

Cell[TextData[{
 "The bit-flip half prepares an encoded ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "+"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7519012f-e657-215b-2326-988893e273a1"],
 ", applies a transversal CNOT from data to ancilla and measures the ancilla, \
so bit flips in the data copy over and are read there. The phase half is the \
mirror image: an encoded ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "0"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "594776df-9e75-d16a-0f7d-6f991b01a3b0"],
 ", the CNOT the other way, and a transversal Hadamard so the same ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6405505f-4b92-3bd6-0c3b-4a196e24893c"],
 "-basis readout sees phase errors."
}], "Text",ExpressionUUID->"6878c7f8-419e-9db5-1807-dea27028e79f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ec", " ", "=", " ", 
