Cell[TextData[{
 "2. ",
 Cell[BoxData["QECPauliMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],
 " \[LongDash] spending the cat"
}], "Section",ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell[TextData[{
 "With a verified cat, measuring a Pauli ",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 " of weight ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 " goes: prepare the cat, apply a controlled-",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a9104d-5625-6af3-4356-8a1763d038d9"],
 " from each cat qubit to its own data qubit, read the cat out in the ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],
 " basis, and take the ",
 StyleBox["parity",
  FontWeight->"Bold"],
 " of the outcomes \[LongDash] that parity is the eigenvalue (eqs. \
12.1\[Dash]12.3). Because a single round can still lie, the whole thing is \
repeated ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["t", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43821c38-6720-b4f9-71b1-966212da1ec3"],
 " times and a majority taken (Theorem 12.1)."
}], "Text",ExpressionUUID->"341c54d9-3079-6bba-5c24-4d83410c3980"],

