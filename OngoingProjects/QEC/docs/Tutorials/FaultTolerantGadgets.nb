Cell[TextData[{
 StyleBox["What it costs",
  FontWeight->"Bold"],
 " (sec. 14.7.5). Below the threshold, ",
 Cell[BoxData[
  FormBox[
   StyleBox["l", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21fdaace-430e-f3f9-5782-43a876b8c1c3"],
 " levels of concatenation fail per location with probability at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["T", "TI"]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["p", "TI"], "/", 
       SubscriptBox[
        StyleBox["p", "TI"], 
        StyleBox["T", "TI"]]}], ")"}], 
     SuperscriptBox["2", 
      StyleBox["l", "TI"]]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"],
 ", so a circuit of up to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", "/", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["T", "TI"]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         StyleBox["p", "TI"], "/", 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["T", "TI"]]}], ")"}], 
       SuperscriptBox["2", 
        StyleBox["l", "TI"]]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],
 " locations fails with probability at most ",
 Cell[BoxData[
  FormBox["\[Epsilon]", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c6bfc6-0792-5005-77fd-36a0b227236f"],
 "; and each level multiplies the size by the largest ",
 StyleBox["rectangle",
  FontWeight->"Bold"],
 " \[LongDash] an exRec without its leading EC, the piece ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["F", "TI"], 
    StyleBox["T", "TI"], 
    RowBox[{"(", 
     StyleBox["C", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62752e4e-571f-d961-120a-c02862aba84b"],
 " is cut into without overlap. With the book's inputs (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["T", "TI"]], "\[LongEqual]", "2.7", "\[Cross]", 
    SuperscriptBox["10", 
     RowBox[{"-", "5"}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["T", "TI"]], "/", "10"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166277e1-e8de-815f-3e12-6eca8968d3a5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", "\[LongEqual]", "0.01"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ae7a534-7379-468c-3a9c-3d7e060c2cd6"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B", "TI"], "\[LongEqual]", "492"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34baef30-7963-b757-5c59-077a78171dbd"],
 ") that is its table 14.1 exactly; with this protocol's own bound and its ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "/", "8"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15ce0314-20ee-2b64-43f5-9b5e509b764e"],
 " rectangle of 750 locations:"
}], "Text",ExpressionUUID->"38a9ac88-4644-6c0e-6856-45d273f13754"],

