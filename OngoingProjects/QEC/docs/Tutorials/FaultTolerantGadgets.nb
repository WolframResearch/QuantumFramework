Cell[TextData[{
 "Here is the number the gadget exists for. ",
 Cell[BoxData["\"\<DataWeights\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f8ab258-7e7f-0723-7589-34027b0a6a09"],
 " is the set of residual data errors left by ",
 StyleBox["every single fault",
  FontWeight->"Bold"],
 " anywhere in the circuit, conditional on the heralds accepting, and read \
modulo ",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b12ee74-9953-131d-1921-003e18e67e67"],
 " itself:"
}], "Text",ExpressionUUID->"65262d3c-fccc-1dc6-0cdd-c579f579672c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<data weights\>\"", " ", "->", " ", 
    RowBox[{"meas", "[", "\"\<DataWeights\>\"", "]"}]}], ",", " ", 
   RowBox[{"\"\<worst\>\"", " ", "->", " ", 
    RowBox[{"meas", "[", "\"\<MaxDataWeight\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<transversal\>\"", " ", "->", " ", 
    RowBox[{"meas", "[", "\"\<TransversalQ\>\"", "]"}]}], ",", " ", 
   RowBox[{"\"\<heralds\>\"", " ", "->", " ", 
    RowBox[{"meas", "[", "\"\<Heralds\>\"", "]"}]}]}], "|>"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"],

