   {Cell["      ", "ModInfo",ExpressionUUID->
     "06ea8612-dd18-b4f0-2ee9-185fd4921eda"], Cell[TextData[{
     Cell[BoxData[
      FormBox[
       RowBox[{"2", 
        StyleBox["t", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0b02f270-2101-5c3d-3931-f43a50b42707"],
     " repetitions, a majority vote, and FTEC interleaved between them"
    }], "TableText",ExpressionUUID->"2d1868bf-f524-2aaf-5b27-81f8fcd178f5"], 
    Cell["ibid., sec. 12.1.4\[Dash]12.1.5, Theorem 12.1", "TableText",
     ExpressionUUID->"669caa83-24d6-d7e9-0ea3-43ed4d60bd33"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"], Cell[
    "Steane error correction, and why not Shor's", "TableText",ExpressionUUID->
     "66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"], Cell[
    "ibid., sec. 12.3, fig. 12.8\[Dash]12.9", "TableText",ExpressionUUID->
     "3e73fafe-05d0-7203-6600-f3b8ac654169"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"], Cell[TextData[{
     "the ",
     Cell[BoxData[
      FormBox[
       RowBox[{
        StyleBox["e", "TI"], "+", 
        StyleBox["f", "TI"], "+", 
        StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "12c044c4-b778-74e1-42f0-5da1c20d5ecb"],
     " additivity, and therefore no repetition"
    }], "TableText",ExpressionUUID->"3d9aa029-60a8-273a-6bb9-3a7311428a00"], 
    Cell["ibid., sec. 12.3.3", "TableText",ExpressionUUID->
