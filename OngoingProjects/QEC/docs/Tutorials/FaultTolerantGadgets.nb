Cell[TextData[{
 "A Pauli pushed through ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e44757e-c407-f813-567c-6d3bedb3cb79"],
 " is not a Pauli, so the frame cannot search this exRec for malignant sets, \
and ",
 Cell[BoxData["framePropagate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"],
 " refuses a ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539b0e4e-9e5a-5525-01b8-a0281bef3c0f"],
 " rather than dropping it. The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "/", "8"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd82739-42e3-b7ed-44e7-bf6376971d37"],
 " exRec is bounded by bad sets, which is what sec. 14.5.3 does too \
\[LongDash] and then it is the worst exRec of the universal protocol:"
}], "Text",ExpressionUUID->"0971a20b-7913-467e-3f0e-445578a62d44"],

