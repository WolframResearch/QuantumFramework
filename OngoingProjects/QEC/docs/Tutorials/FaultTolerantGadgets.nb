Cell[TextData[{
 Cell[BoxData["\"\<RepetitionsNeeded\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51fce014-dca1-0630-0783-fa51d5546d1a"],
 " is 1, and that is why this gadget and not Shor's fills the slot left open \
in section 2: the errors are ",
 StyleBox["additive",
  FontWeight->"Bold"],
 ". The measured classical error is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["e", "TI"], "+", 
    StyleBox["f", "TI"], "+", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657c1c65-980e-511d-1303-964f19bb2067"],
 " for ",
 Cell[BoxData[
  FormBox[
   StyleBox["e", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],
 " the true data error, ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9b7e66-629a-1114-26b9-7040172f607e"],
 " the ancilla's and ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "585a51e6-774f-2dd2-087a-48c002fa7738"],
 " the measurement's, so correcting by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["e", "TI"], "+", 
    StyleBox["f", "TI"], "+", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],
 " leaves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "+", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370294fd-9e49-2d35-5d31-0da71bfc741f"],
 " behind \[LongDash] a single fault can only leave a single error, with no \
repetition and no majority vote at all (sec. 12.3.3)."
}], "Text",ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

Cell["\<\
Measured in the same units as section 2, and split in two, because the gadget \
is honest about which half is which:\
\>", "Text",ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<regions\>\"", " ", "->", " ", 
    RowBox[{"Map", "[", 
     RowBox[{"Length", ",", " ", 
      RowBox[{"ec", "[", "\"\<Regions\>\"", "]"}]}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<interaction\>\"", " ", "->", " ", 
    RowBox[{"ec", "[", "\"\<DataWeights\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<preparation\>\"", " ", "->", " ", 
    RowBox[{"ec", "[", "\"\<PreparationDataWeights\>\"", "]"}]}]}], 
  "|>"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"regions\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"Preparation\"\>", "\[Rule]", "65"}], ",", 
      RowBox[{"\<\"Interaction\"\>", "\[Rule]", "36"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"interaction\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}], ",", 
   RowBox[{"\<\"preparation\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[19]= ",ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"]
}, Open  ]],

Cell[TextData[{
 "The ",
 StyleBox["interaction",
  FontWeight->"Bold"],
 " \[LongDash] the transversal CNOTs and the readout \[LongDash] leaves at \
most one data error per fault, which is the additivity above. The ",
 StyleBox["preparation",
  FontWeight->"Bold"],
 " of the ancilla leaves up to four, because that preparation is still the \
code's ordinary, non-fault-tolerant encoder. That is chapter 13's work \
appearing as a number instead of a caveat, and it is the open assumption \
every gadget in this note carries."
}], "Text",ExpressionUUID->"6878c7f8-419e-9db5-1807-dea27028e79f"],

Cell["Each half is readable on its own:", "Text",ExpressionUUID->"48a3d607-c312-9dd3-7850-c860f6a4e739"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Take", "[", 
