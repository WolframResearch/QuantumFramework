Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"parts\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"LeadingEC\"\>", "\[Rule]", "146"}], ",", 
      RowBox[{"\<\"MagicPreparation\"\>", "\[Rule]", "23"}], ",", 
      RowBox[{"\<\"MagicEC\"\>", "\[Rule]", "146"}], ",", 
      RowBox[{"\<\"MagicTest\"\>", "\[Rule]", "72"}], ",", 
      RowBox[{"\<\"Injection\"\>", "\[Rule]", "21"}], ",", 
      RowBox[{"\<\"TrailingEC\"\>", "\[Rule]", "146"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"locations\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
