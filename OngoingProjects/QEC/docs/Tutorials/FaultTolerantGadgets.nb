Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "-", "3"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c54d9-3079-6bba-5c24-4d83410c3980"],
 " checks suffice, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f449897-1a0e-51e7-357b-11d19fbb23cd"],
 " need none at all. A small result, and the kind this layer exists for: the \
book says a few checks are enough, and the object says how few."
}], "Text",ExpressionUUID->"6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],

Cell["\<\
The gadget can be placed anywhere, which is what the next section needs \
\[LongDash] the cat has to sit somewhere above the data qubits:\
\>", "Text",ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

