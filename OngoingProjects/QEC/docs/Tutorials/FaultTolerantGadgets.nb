Cell[TextData[{
 "Three repetitions, because the five-qubit code has distance 3, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07359582-e823-44a1-2eca-0cef89d62e8b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["t", "TI"], "+", "1", "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c239bd0-3ff5-3b18-25d0-129ab9818662"],
 ". That count is derived from the code rather than typed in \[LongDash] and \
it can be overridden when you want to see what a single unrepeated round does:"
}], "Text",ExpressionUUID->"68c76573-72ce-0c1a-18fd-7d3d077b5760"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"QECPauliMeasurement", "[", 
     RowBox[{"five", ",", " ", "\"\<XZZXI\>\""}], "]"}], 
    "[", "\"\<Repetitions\>\"", "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"QECPauliMeasurement", "[", 
     RowBox[{"five", ",", " ", "\"\<XZZXI\>\"", ",", " ", "1"}], "]"}], 
    "[", "\"\<Repetitions\>\"", "]"}]}], "}"}]], "Input",
