Cell[TextData[{
 "Four resets, a Hadamard and a chain of CNOTs \[LongDash] that is the cat. \
Then a fifth qubit, two CNOTs from the pair being compared, and an ",
 Cell[BoxData["MH"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cb5c01f-62f5-68e0-144a-da5916803aca"],
 ": a measurement whose outcome is a ",
 StyleBox["herald", "TI"],
 ", deciding whether the shot is kept at all."
}], "Text",ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"],

Cell[TextData[{
 "Now the part that is derived rather than assumed. A single fault during \
preparation leaves one of a small set of patterns on the cat, and only some \
of them are dangerous: ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["X", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["m", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 " stabilises the cat state, so a pattern and its complement are the same \
physical error, and only patterns of canonical weight ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GreaterEqual]", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d359769-845f-cd94-44ca-0f332deb97fe"],
 " can hurt. The object computes that set, and whether the checks it was \
given actually cover it:"
}], "Text",ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<dangerous\>\"", " ", "->", " ", 
    RowBox[{"cat", "[", "\"\<DangerousPatterns\>\"", "]"}]}], ",", " ", 
   RowBox[{"\"\<checks\>\"", " ", "->", " ", 
    RowBox[{"cat", "[", "\"\<Pairs\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<covered\>\"", " ", "->", " ", 
    RowBox[{"cat", "[", "\"\<ChecksCoverQ\>\"", "]"}]}]}], "|>"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"dangerous\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1", ",", "1"}], "}"}], "}"}]}], ",", 
   RowBox[{"\<\"checks\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], "}"}]}], ",", 
   RowBox[{"\<\"covered\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"]
}, Open  ]],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea251ed-865f-e03c-1652-48b733ebb306"],
 " the one dangerous pattern is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 " \[LongDash] exactly the error drawn in the book's figure 12.3b \[LongDash] \
and comparing qubits 2 and 3 catches it. Sweeping the width gives the rule:"
}], "Text",ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dataset", " ", "@", " ", 
  RowBox[{"Association", " ", "@", " ", 
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"m", " ", "->", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<checks\>\"", " ", "->", " ", 
         RowBox[{"Length", "[", 
          RowBox[{
           RowBox[{"QECCatState", "[", "m", "]"}], "[", "\"\<Pairs\>\"", 
           "]"}], "]"}]}], ",", "\n", "           ", 
        RowBox[{"\"\<dangerous\>\"", " ", "->", " ", 
         RowBox[{"Length", "[", 
          RowBox[{
           RowBox[{"QECCatState", "[", "m", "]"}], 
           "[", "\"\<DangerousPatterns\>\"", "]"}], "]"}]}], ",", "\n", 
        "           ", 
        RowBox[{"\"\<covered\>\"", " ", "->", " ", 
         RowBox[{
          RowBox[{"QECCatState", "[", "m", "]"}], "[", "\"\<ChecksCoverQ\>\"",
           "]"}]}]}], "|>"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "2", ",", " ", "6"}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

