     " ", "\"\<Qubits\>\"", ",", " ", "\"\<StabilizerCount\>\"", ",", 
     " ", "\"\<LogicalQubits\>\"", ",", " ", "\"\<CSSQ\>\""}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a"],

