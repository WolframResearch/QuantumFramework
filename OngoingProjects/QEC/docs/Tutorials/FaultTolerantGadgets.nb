  RowBox[{"ec", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<DataQubits\>\"", ",", " ", "\"\<AncillaQubits\>\"", ",", 
     " ", "\"\<Offset\>\"", ",", " ", "\"\<Order\>\"", ",", 
     " ", "\"\<Qubits\>\"", ",", "\n", "    ", "\"\<Measurements\>\"", ",", 
     " ", "\"\<Depth\>\"", ",", " ", "\"\<InstructionCount\>\"", ",", 
     " ", "\"\<RepetitionsNeeded\>\""}], "}"}]}], "]"}]], "Input",
