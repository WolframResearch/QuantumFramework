Cell[TextData[{
 "Three repetitions, because the five-qubit code has distance 3, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519775d4-d545-25f2-07ad-6c91dcf18fd8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["t", "TI"], "+", "1", "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5900aac7-5263-773e-0f3f-43a167165a04"],
 ". That count is derived from the code rather than typed in \[LongDash] and \
it can be overridden when you want to see what a single unrepeated round does:"
}], "Text",ExpressionUUID->"06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],

