}, Open  ]],

Cell["\<\
Now the number the whole construction exists for, and it needs two \
corrections before it means anything.\
\>", "Text",ExpressionUUID->"7c0d57bf-7ae8-3253-2433-4ef97e8280b9"],

Cell[TextData[{
 "The residual is read ",
 StyleBox["modulo ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"0aaecb0d-dff0-cd78-3a55-e356d98a9442"],
 ". ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["X", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["m", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fe4a286-576e-fd11-759b-3be06218c47b"],
 " stabilises the cat, so a cat pattern and its complement are one physical \
error; through the transversal ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"C", "Z"}], "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07179650-9fbb-2bc1-2d2c-081a1a4e792b"],
 " those two differ on the data by a ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aecd320-e31f-2936-2a93-ca8d96aa781c"],
 " on every qubit of the support, which after the un-rotation is exactly ",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "326b0854-5043-0b63-6268-a21e61f65649"],
 ". The frame propagator tracks literal Paulis and cannot know the ancilla's \
own stabilizer, so without the quotient it reports a weight-",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d6edc53-4ce5-e0f2-4b15-d61d6491b2d8"],
 " residual for a fault that does nothing at all."
}], "Text",ExpressionUUID->"45f7e4e6-4e1c-a184-738c-fdc06baef3ee"],

Cell[TextData[{
 "And only ",
 StyleBox["accepted",
  FontWeight->"Bold"],
 " runs count: a fault early in the cat preparation does propagate along the \
chain, which is what checking is for, and the check fires."
}], "Text",ExpressionUUID->"70e98525-204e-6ba4-2096-1c8f51fb398e"],

