   RowBox[{"noiseLevel", "[", 
    RowBox[{"First", "[", "nCirc", "]"}], "]"}], ",", "\n", " ", 
   RowBox[{"noiseMeasErr", "[", 
    RowBox[{"First", "[", "nPhen", "]"}], "]"}], ",", " ", 
   RowBox[{"noiseMeasErr", "[", 
    RowBox[{"First", "[", "nCap", "]"}], "]"}], ",", "\n", " ", 
   RowBox[{"noiseSymbolicQ", "[", 
