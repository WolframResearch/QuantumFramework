  FontSize->0.9 Inherited,ExpressionUUID->
  "3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],
 " replaces a vector ",
 Cell[BoxData["Mod"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087f5f2f-6486-1b59-3805-56890d3369a3"],
 "."
}], "Text",ExpressionUUID->"7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],

