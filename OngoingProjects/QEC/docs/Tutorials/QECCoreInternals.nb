Cell["\<\
The ancilla states are checked against the engine rather than asserted. Which \
wire carries the logical qubit going into the encoder is derived the same way:\
\>", "Text",ExpressionUUID->"03d898fe-d35a-9eef-31e7-11bbe6ece435"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"prepared", "[", 
     RowBox[{"instrs_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
    RowBox[{"applyGates", "[", 
     RowBox[{
      RowBox[{"PauliStabilizer", "[", "n", "]"}], ",", " ", 
      RowBox[{"engineGates", "[", "instrs", "]"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"codeData", "[", 
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "]"}]}], ",", " ", 
     RowBox[{"st", " ", "=", " ", 
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}]}]}], "}"}], ",", 
   "\n", "    ", 
   RowBox[{"{", "\n", "        ", 
    RowBox[{
     RowBox[{"logicalWires", "[", "a", "]"}], ",", "\n", "        ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", " ", "=", " ", 
         RowBox[{"prepared", "[", 
          RowBox[{
           RowBox[{"encZero", "[", 
            RowBox[{"a", ",", " ", "0"}], "]"}], ",", " ", "7"}], "]"}]}], 
        "}"}], ",", "\n", "            ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"st", "[", "\"\<Generators\>\"", "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"s", "[", 
              RowBox[{"\"\<Expectation\>\"", ",", " ", "#"}], "]"}], " ", "===",
              " ", "1"}], " ", "&"}]}], "]"}], ",", " ", 
         RowBox[{"s", "[", 
          RowBox[{"\"\<Expectation\>\"", ",", " ", 
           RowBox[{"First", "[", 
            RowBox[{"st", "[", "\"\<LogicalZ\>\"", "]"}], "]"}]}], "]"}]}], 
        "}"}]}], "]"}], ",", "\n", "        ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", " ", "=", " ", 
         RowBox[{"prepared", "[", 
          RowBox[{
           RowBox[{"encPlus", "[", 
            RowBox[{"a", ",", " ", "0"}], "]"}], ",", " ", "7"}], "]"}]}], 
        "}"}], ",", "\n", "            ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"st", "[", "\"\<Generators\>\"", "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"s", "[", 
              RowBox[{"\"\<Expectation\>\"", ",", " ", "#"}], "]"}], " ", "===",
              " ", "1"}], " ", "&"}]}], "]"}], ",", " ", 
         RowBox[{"s", "[", 
          RowBox[{"\"\<Expectation\>\"", ",", " ", 
           RowBox[{"First", "[", 
            RowBox[{"st", "[", "\"\<LogicalX\>\"", "]"}], "]"}]}], "]"}]}], 
        "}"}]}], "]"}]}], "\n", "    ", "}"}]}], "]"}]}], "Input",
 CellLabel->
  "In[95]:= ",ExpressionUUID->"03dda600-4b0b-c3af-31e2-386a6ebf91f5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "7", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"True", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"True", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[95]= ",ExpressionUUID->"4de38b79-ee67-8bee-7b90-23228b13d934"]
}, Open  ]],

Cell[TextData[{
 "Now the property that makes this the right sub-gadget for the measurement's \
slot. Section 12.3.3 asks whether Steane EC needs repeating and answers no, \
because the errors are ",
 StyleBox["additive",
  FontWeight->"Bold"],
 ": the measured classical error is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["e", "TI"], "+", 
    StyleBox["f", "TI"], "+", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "347cf1ed-0cc4-b4dc-5c03-e8b7a5761e26"],
 ", for ",
 Cell[BoxData[
  FormBox[
   StyleBox["e", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d81b9ce-3a4c-aa2a-2bbe-30a8bffef970"],
 " the true data error, ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bb9b374-9caf-337d-1946-2b3e155b9e47"],
 " the ancilla's and ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c340229-13f4-0181-15cb-a473a58153eb"],
 " the measurement's, so correcting by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["e", "TI"], "+", 
    StyleBox["f", "TI"], "+", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25dfa134-0866-9bb5-53e4-397ea910e99f"],
 " leaves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["f", "TI"], "+", 
    StyleBox["g", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "425139cc-45a5-cefb-726e-b0966c5194c1"],
 " \[LongDash] \"a single-qubit error in the ancilla can only produce a \
single-qubit error in the final state. This is in contrast to Shor EC, where \
a single ancilla error changing one bit of the error syndrome could totally \
change the error we deduce.\""
}], "Text",ExpressionUUID->"4d922994-f334-45bb-7ba1-c0d186c12f81"],

Cell["\<\
That is a claim to check, not to quote. The gadget splits in two regions and \
reports each:\
\>", "Text",ExpressionUUID->"06c25578-1780-b25e-2ef2-4d22a23a00a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ec", "[", "\"\<RepetitionsNeeded\>\"", "]"}], ",", " ", 
   RowBox[{"ec", "[", "\"\<DataWeights\>\"", "]"}], ",", " ", 
   RowBox[{"ec", "[", "\"\<PreparationDataWeights\>\"", "]"}]}], 
  "}"}]], "Input",
 CellLabel->
  "In[96]:= ",ExpressionUUID->"5f70617e-b140-9f95-0500-793bc0fae5ff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[96]= ",ExpressionUUID->"79d0371a-30a6-04e5-2fef-af4441536ecf"]
}, Open  ]],

Cell[TextData[{
 "One fault in the interaction, one data error. One fault in the ancilla ",
 StyleBox["preparation",
  FontWeight->"Bold"],
 ", up to four \[LongDash] because that preparation is the code's own \
non-fault-tolerant encoder. Got26 is equally explicit about both halves of \
that: \"How do we make the ancilla states and ensure they do not have too \
many errors? That is the complicated part of Steane EC\", and it is chapter \
13 work, needed for a full FT protocol whatever EC gadget is chosen. So the \
gadget names the assumption rather than implying it:"
}], "Text",ExpressionUUID->"7d950d76-dd18-2b24-2baa-a533d4ad760e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ec", "[", "\"\<OpenAssumptions\>\"", "]"}]], "Input",
 CellLabel->
  "In[97]:= ",ExpressionUUID->"7234a9f4-3232-6781-23cb-40be47c74deb"],

Cell[BoxData[
 RowBox[{"{", "\<\"The ancilla blocks are prepared by the code's own encoder, \
which is not fault tolerant (Got26 Procedure 6.6). Fault-tolerant preparation \
of encoded |0> and |+> is chapter 13 work, and this gadget is fault tolerant \
given a clean ancilla.\"\>", "}"}]], "Output",
 CellLabel->
  "Out[97]= ",ExpressionUUID->"42668d78-f434-72a4-721d-2525fdc1408e"]
}, Open  ]],

Cell[TextData[{
 "Filling the slot completes Theorem 12.1's structure. Without it the \
measurement handles ancilla faults only; with it, the composed gadget still \
leaves one data error per fault, and inherits the sub-gadget's open \
assumption rather than hiding it behind that ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c7cc198-0ad8-2426-3403-d8c2af528f0c"],
 ":"
}], "Text",ExpressionUUID->"69698b1d-3dc2-3628-1f16-2347b4749d72"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"steane", " ", "=", " ", 
   RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{"{", "\n", "    ", 
  RowBox[{
   RowBox[{
    RowBox[{"QECPauliMeasurement", "[", 
     RowBox[{"steane", ",", " ", 
      RowBox[{"First", "[", 
       RowBox[{"steane", "[", "\"\<LogicalZ\>\"", "]"}], "]"}]}], "]"}], 
    "[", "\"\<MeasurementCorrectQ\>\"", "]"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"QECPauliMeasurement", "[", 
     RowBox[{"steane", ",", " ", 
      RowBox[{"First", "[", 
       RowBox[{"steane", "[", "\"\<LogicalZ\>\"", "]"}], "]"}], ",", " ", 
      RowBox[{"\"\<ErrorCorrection\>\"", " ", "->", " ", "\"\<Steane\>\""}]}],
      "]"}], "[", "\"\<MeasurementCorrectQ\>\"", "]"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"QECPauliMeasurement", "[", 
     RowBox[{"steane", ",", " ", 
      RowBox[{"First", "[", 
       RowBox[{"steane", "[", "\"\<LogicalZ\>\"", "]"}], "]"}], ",", " ", 
      RowBox[{"\"\<ErrorCorrection\>\"", " ", "->", " ", "\"\<Steane\>\""}]}],
      "]"}], "[", "\"\<DataWeights\>\"", "]"}]}], "\n", "}"}]}], "Input",
 CellLabel->
  "In[98]:= ",ExpressionUUID->"701e1eb7-eeba-61c8-2025-97f08b4f3312"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True", ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[98]= ",ExpressionUUID->"0e322415-281a-3695-37c1-be5f49ac9cff"]
}, Open  ]],

Cell["\<\
And the restriction is enforced rather than documented. The five-qubit code \
is not CSS, so it can have a cat measurement but not Steane EC:\
\>", "Text",ExpressionUUID->"61beb272-ef15-9663-1745-343f8aa1fd49"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], "[", "\"\<CSSQ\>\"", 
    "]"}], ",", " ", 
   RowBox[{"steane", "[", "\"\<CSSQ\>\"", "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[99]:= ",ExpressionUUID->"5e8a6a96-06b4-6465-0689-83d0b3414f4f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",
 CellLabel->
  "Out[99]= ",ExpressionUUID->"55951090-ef25-ccfd-03aa-89dd8ad196c7"]
}, Open  ]],

Cell["The extraction, and the one thing that cannot cross over", "Section",ExpressionUUID->"53a2ca13-da2c-324e-0151-ec5cdfde8094"],

Cell[TextData[{
 "The three gadgets above are built and checked, but the rate machinery \
routes through ",
 Cell[BoxData["codeCircuitInstructions"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5930221d-821b-4026-08cf-c44737ae130c"],
 ", which is the bare-ancilla circuit and nothing else. ",
 Cell[BoxData["codeExtraction"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76ba63e9-5df8-c241-1e5a-7ab3547290ab"],
 " is what makes that a choice: it returns the instructions, the qubit count, \
and the number of record bits each check contributes."
}], "Text",ExpressionUUID->"319e51f9-a9ce-1d21-67a6-48a2c87b640b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"codeExtraction", ",", " ", "recordSyndromes"}], "}"}], " ", "=",
     " ", 
    RowBox[{"sym", " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<codeExtraction\>\"", ",", " ", "\"\<recordSyndromes\>\""}],
       "}"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"{", "\n", "    ", 
  RowBox[{
   RowBox[{"KeyDrop", "[", 
    RowBox[{
     RowBox[{"codeExtraction", "[", 
      RowBox[{
       RowBox[{"codeData", "[", "bitFlip", "]"}], ",", " ", "1", ",", 
       " ", "\"\<BareAncilla\>\""}], "]"}], ",", 
     " ", "\"\<Instructions\>\""}], "]"}], ",", "\n", "    ", 
   RowBox[{"KeyDrop", "[", 
    RowBox[{
     RowBox[{"codeExtraction", "[", 
      RowBox[{
       RowBox[{"codeData", "[", "bitFlip", "]"}], ",", " ", "1", ",", 
       " ", "\"\<Transversal\>\""}], "]"}], ",", 
     " ", "\"\<Instructions\>\""}], "]"}]}], "\n", "}"}]}], "Input",
 CellLabel->
  "In[100]:= ",ExpressionUUID->"26f4962c-805e-a216-4e8b-087631e8f17c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Qubits\"\>", "\[Rule]", "5"}], ",", 
     RowBox[{"\<\"BlockSizes\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Qubits\"\>", "\[Rule]", "6"}], ",", 
     RowBox[{"\<\"BlockSizes\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[100]= ",ExpressionUUID->"313d5a7b-7caf-7acc-60c3-5c25755a4816"]
}, Open  ]],

Cell[TextData[{
 "Only half of Theorem 12.1's gadget can cross over, and the obstruction is \
structural. ",
 StyleBox["A detector error model is a matrix",
  FontWeight->"Bold"],
 " \[LongDash] the effect of a set of faults is the XOR of their rows \
\[LongDash] and the exact fold, the decoder table and the Stim writer all \
rest on that. A ",
 StyleBox["majority",
  FontWeight->"Bold"],
 " vote is not linear, so two faults whose individual effects are known do \
not have an effect given by their XOR once a vote is in the path."
}], "Text",ExpressionUUID->"2da78195-91be-94f0-5b5c-18df2048feda"],

Cell[TextData[{
 "This is the same fork the package already stands on one side of: \
\[Section]12.2.2 answers a noisy syndrome by repeat-and-agree, and ",
 Cell["DetectorModel.wl", "InlineCode",ExpressionUUID->
  "39c6b7ab-78e0-e73c-6ffd-2ef5789aca06"],
 " takes differencing instead. ",
 Cell[BoxData["QECPauliMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f7d0c35-7157-44bf-6502-a67f00e22e85"],
 " is the book's gadget and keeps the vote; the extraction takes ",
 StyleBox["transversality",
  FontWeight->"Bold"],
 ", which is the half that cured the hook error in the first place. Its \
readout is a ",
 StyleBox["parity", "TI"],
 ", which is linear, and ",
 Cell[BoxData["recordSyndromes"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47b49f91-c3c7-4deb-6d4b-16daf6721731"],
 " is where that reduction happens \[LongDash] the identity when a check \
contributes one bit, so the bare-ancilla path is untouched:"
}], "Text",ExpressionUUID->"064e3005-d89e-7c03-2e75-aa6ed92b4769"],

Cell[CellGroupData[{

