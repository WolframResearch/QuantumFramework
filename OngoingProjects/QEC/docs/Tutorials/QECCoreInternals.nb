   RowBox[{"pauliReps", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "3", ",", " ", "5", ",", " ", "7"}], "}"}]}], ",",
    " ", 
   RowBox[{
    RowBox[{"QECPauliMeasurement", "[", 
     RowBox[{"five", ",", " ", "\"\<ZZZZZ\>\""}], "]"}], 
    "[", "\"\<Repetitions\>\"", "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[88]:= ",ExpressionUUID->"569e7ab4-00f8-e339-7ea6-73feb172ce03"],

Cell[BoxData[
 RowBox[{"{", 
