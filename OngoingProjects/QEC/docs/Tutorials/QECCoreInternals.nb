     RowBox[{"a", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
   RowBox[{"Length", "[", 
    RowBox[{"demDecoderTable", "[", 
     RowBox[{"a", ",", " ", "2"}], "]"}], "]"}]}], "}"}]], "Input",
