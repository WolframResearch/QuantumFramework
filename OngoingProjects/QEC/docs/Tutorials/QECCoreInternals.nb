}, Open  ]],

Cell["Packing and grouping", "Subsection",ExpressionUUID->"3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],

Cell[TextData[{
 "Detector and observable patterns are only ever XORed and compared, so they \
are carried as integers: one ",
 Cell[BoxData["BitXor"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087f5f2f-6486-1b59-3805-56890d3369a3"],
 " replaces a vector ",
 Cell[BoxData["Mod"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],
 "."
}], "Text",ExpressionUUID->"2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],

