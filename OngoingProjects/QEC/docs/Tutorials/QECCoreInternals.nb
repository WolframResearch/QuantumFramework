       RowBox[{"\"\<Circuit\>\"", ",", " ", "p"}], "]"}], "]"}], ",", " ", 
     "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Take", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "10", "]"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
