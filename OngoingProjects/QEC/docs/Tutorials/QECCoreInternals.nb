Cell[TextData[{
 "A third tier is invisible even here: ",
 Cell[BoxData["oddParityRate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2867ea9b-6e8d-517b-581c-03c50b382041"],
 ", ",
 Cell[BoxData["bitsToInteger"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76dfbc62-92ac-7b6e-1ee4-364c275949b4"],
 ", ",
 Cell[BoxData["encoderLines"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],
 " and friends are private to their file and cannot be called by name at all. \
They appear below through their effect \[LongDash] ",
 Cell[BoxData["oddParityRate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 " through the ",
 Cell[BoxData["\"\<DetectorRates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "741b091d-feb2-1a39-1c38-a146fb476903"],
 " property. The basis rotations (",
 Cell[BoxData["letterAt"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf5a20e-c541-e06e-698a-446becf5b2b4"],
 ", ",
 Cell[BoxData["basisGate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07964fa7-8d1e-ff14-2dae-660124a8c27e"],
 ", ",
 Cell[BoxData["unbasisGate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],
 ", ",
 Cell[BoxData["rotation"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbaaaf7-1388-e538-4b59-43b1a622cc02"],
 ") used to be in that tier and were promoted to ",
 Cell[BoxData["PackageScope"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77d99fdb-a351-2d53-1de6-1684d6e477b9"],
 " when the fault-tolerant measurement needed the same letter vocabulary: two \
constructions deriving it separately is how they drift apart."
}], "Text",ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"],

Cell[TextData[{
 "Two codes carry the page. The bit-flip code is small enough for every exact \
route; the five-qubit code has generators carrying ",
 Cell[BoxData[
  FormBox[
   StyleBox["Y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbde497-e826-5557-4442-fdd089d33fbd"],
 ", so it exercises the ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],
 " basis change:"
}], "Text",ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

