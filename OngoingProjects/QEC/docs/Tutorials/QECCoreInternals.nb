Cell[TextData[{
 "A detector fires when an odd number of the mechanisms touching it fire, and \
odd-parity probabilities multiply through the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", "-", "2", 
     StyleBox["p", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],
 " form, one factor per independent location:"
}], "Text",ExpressionUUID->"3e73fafe-05d0-7203-6600-f3b8ac654169"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    StyleBox["P", "TI"], 
    RowBox[{"(", "odd", ")"}], "\[LongEqual]", 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      UnderscriptBox["\[Product]", "locations",
       LimitsPositioning->True], 
      RowBox[{"(", 
       RowBox[{"1", "-", "2", 
        UnderscriptBox["\[Sum]", 
         RowBox[{
          StyleBox["i", "TI"], "\[Element]", "loc", 
          RowBox[{",", " "}], 
          StyleBox["i", "TI"], " ", "touches", "\[DifferentialD]"}],
         LimitsPositioning->True], 
        SubscriptBox[
         StyleBox["p", "TI"], 
         StyleBox["i", "TI"]]}], ")"}]}], ")"}]}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],

