    {
     RowBox[{"{", 
      RowBox[{"\<\"H\"\>", ",", "1"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"\<\"H\"\>", ",", "4"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"\<\"CNOT\"\>", ",", "1", ",", "6"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"\<\"CNOT\"\>", ",", "2", ",", "6"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"\<\"CNOT\"\>", ",", "3", ",", "6"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"\<\"CNOT\"\>", ",", "4", ",", "6"}], "}"}]},
    {
     RowBox[{"{", 
