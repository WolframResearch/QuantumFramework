Cell["The decoder", "Subsection",ExpressionUUID->"0eb02373-2484-618c-364f-bb3d4d3133d6"],

Cell["\<\
Detector pattern to the observable flip implied by the lightest fault set \
that explains it. Because subsets are enumerated by increasing weight, the \
first set to produce a key claims it \[LongDash] which is what makes the \
table minimum-weight.\
\>", "Text",ExpressionUUID->"640353f1-ff8e-e9b3-0c31-4abafa38bb99"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"t1", " ", "=", " ", 
   RowBox[{"demDecoderTable", "[", 
    RowBox[{"a", ",", " ", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "t1", "]"}], ",", " ", 
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"Normal", "[", "t1", "]"}], ",", " ", 
     RowBox[{"UpTo", "[", "6", "]"}]}], "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[60]:= ",ExpressionUUID->"37161f66-4600-a3a8-5d2d-974073baf1f2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"10", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"0", "\[Rule]", "0"}], ",", 
     RowBox[{"10", "\[Rule]", "0"}], ",", 
     RowBox[{"2", "\[Rule]", "0"}], ",", 
     RowBox[{"8", "\[Rule]", "0"}], ",", 
     RowBox[{"6", "\[Rule]", "0"}], ",", 
     RowBox[{"12", "\[Rule]", "0"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[60]= ",ExpressionUUID->"2e44757e-c407-f813-567c-6d3bedb3cb79"]
}, Open  ]],

Cell["\<\
A larger reach explains more patterns. A pattern the table never reaches is \
undecodable and counts as a failure:\
\>", "Text",ExpressionUUID->"07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
