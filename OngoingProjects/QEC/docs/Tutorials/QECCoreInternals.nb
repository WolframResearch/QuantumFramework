Cell["Reaching the internals", "Subsection",ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell[TextData[{
 "Twenty-one symbols are ",
 Cell[BoxData["PackageExport"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23253b8d-1c99-a6bf-52da-b2d7952d0c85"],
 " and land on the context path. Everything else this page touches is ",
 Cell[BoxData["PackageScope"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e84829b-9667-6594-16bb-1bc523124ffe"],
 ", which means it exists but is not exported, and is reached by its full \
context name. This is the same idiom the test suite uses:"
}], "Text",ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

