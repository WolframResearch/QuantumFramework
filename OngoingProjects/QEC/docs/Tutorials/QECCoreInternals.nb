 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"reg", " ", "=", " ", 
     RowBox[{"QECRegister", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", "2"}], 
      "]"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"reg", "[", 
    RowBox[{"\"\<LogicalAction\>\"", ",", " ", "1", ",", " ", "2"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[106]:= ",ExpressionUUID->"67f6b273-a0bf-ee61-0d8d-343cd14bb54b"],

