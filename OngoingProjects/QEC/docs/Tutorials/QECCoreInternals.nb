Cell[TextData[{
 "One attempt still fails the measurement correctness property \[LongDash] a \
bit flip on a cat qubit before its readout flips the reported ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aeb468a-2cc6-59e2-2ae9-5fd445732bc8"],
 ". The answer is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["t", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3873a668-04d7-31ac-6800-3832ad6383f6"],
 " attempts with a ",
 StyleBox["fresh", "TI"],
 " cat each time and a majority vote (Theorem 12.1), since one fault can \
corrupt only one cat:"
}], "Text",ExpressionUUID->"4156c81a-8a68-59d7-776d-e2442f1d2b3d"],

Cell[CellGroupData[{

