 TagBox[GridBox[{
    {"\<\"after CNOT #\"\>", "\<\"x on data\"\>", "\<\"z on data\"\>", \
"\<\"record\"\>"},
    {"1", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "1", ",", "0"}], "}"}], 
