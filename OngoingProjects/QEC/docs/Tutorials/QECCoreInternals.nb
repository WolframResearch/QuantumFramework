Cell[BoxData[{
 RowBox[{
  RowBox[{"nMix", " ", "=", " ", 
   RowBox[{"QECNoiseModel", "[", 
    RowBox[{"\"\<Circuit\>\"", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<OneQubit\>\"", " ", "->", " ", "p"}], ",", " ", 
       RowBox[{"\"\<TwoQubit\>\"", " ", "->", " ", 
        RowBox[{"2", " ", "p"}]}], ",", " ", 
       RowBox[{"\"\<Measurement\>\"", " ", "->", " ", "q"}]}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"noiseCircRates", "[", 
  RowBox[{"First", "[", "nMix", "]"}], "]"}]}], "Input",
 CellLabel->
  "In[36]:= ",ExpressionUUID->"5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],

