Cell["The rows that get dropped", "Subsection",ExpressionUUID->"01a44b6b-c85f-9e0e-375c-6334e9ebe554"],

Cell[TextData[{
 Cell[BoxData["codeDetectorModel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],
 " is the raw builder underneath the constructor. It drops two kinds of row:"
}], "Text",ExpressionUUID->"25120901-cfbc-a8e6-5321-a16aea4efacc"],

