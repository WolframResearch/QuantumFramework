}, Open  ]],

Cell[TextData[{
 "This is a different kind of decoder from the book's, not a variant of it. \
Gottesman's uses the repetitions only as a certificate: find the last run of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["t", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd82739-42e3-b7ed-44e7-bf6376971d37"],
 " agreeing syndromes, conclude one of them was taken with no faults, discard \
everything else, and look that single syndrome up. What happens here is an \
optimisation over the whole spacetime history: nothing is discarded, all \
rounds are used jointly, and the answer is the lightest fault configuration \
consistent with every detector. It inherits none of that section's guarantees \
\[LongDash] what is exact here is the error rate of a stated protocol, not a \
fault-tolerance proof."
}], "Text",ExpressionUUID->"0971a20b-7913-467e-3f0e-445578a62d44"],

Cell["The exact route", "Subsection",ExpressionUUID->"09df342d-d743-5809-3fe4-ae76e2f62b53"],

Cell[TextData[{
 "Rather than enumerate ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    RowBox[{"#", "faults"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"],
 " configurations, carry the ",
 StyleBox["distribution over effects", "TI"],
 " \[LongDash] a vector of length ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    RowBox[{"detectors", "+", "observables"}]], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21fdaace-430e-f3f9-5782-43a876b8c1c3"],
 " \[LongDash] and fold the coins in one at a time:"
}], "Text",ExpressionUUID->"1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["P", "TI"], "\[Prime]"], 
    RowBox[{"[", 
     StyleBox["s", "TI"], "]"}], "\[LongEqual]", 
    StyleBox["P", "TI"], 
    RowBox[{"[", 
     StyleBox["s", "TI"], "]"}], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      UnderscriptBox["\[Sum]", 
       StyleBox["i", "TI"],
       LimitsPositioning->True], 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["i", "TI"]]}], ")"}], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["i", "TI"],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["i", "TI"]], " ", 
    StyleBox["P", "TI"], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["s", "TI"], "\[CirclePlus]", 
      SubscriptBox["\[Sigma]", 
       StyleBox["i", "TI"]]}], "]"}]}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],

Cell["\<\
the sum running over the mutually exclusive outcomes of one location, so a \
three-way depolarizing channel is handled exactly rather than as three \
independent coins. The state space is what bounds it:\
\>", "Text",ExpressionUUID->"41c6bfc6-0792-5005-77fd-36a0b227236f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"2", "^", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"a", "[", "\"\<Detectors\>\"", "]"}], " ", "+", " ", 
    RowBox[{"a", "[", "\"\<Observables\>\"", "]"}]}], ")"}]}]], "Input",
 CellLabel->
  "In[62]:= ",ExpressionUUID->"62752e4e-571f-d961-120a-c02862aba84b"],

Cell[BoxData["64"], "Output",
 CellLabel->
  "Out[62]= ",ExpressionUUID->"34ee5221-bb14-cc46-5c96-4b8b3ea696ac"]
}, Open  ]],

