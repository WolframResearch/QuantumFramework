    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<BitFlip\>\"", ",", " ", "p", ",", " ", 
      RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "q"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"raw", " ", "=", " ", 
   RowBox[{"codeDetModel", "[", 
    RowBox[{"bfData", ",", " ", "nP", ",", " ", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"faultMechanisms", "[", 
     RowBox[{"bfData", ",", " ", "nP", ",", " ", "1"}], "]"}], "]"}], ",", 
