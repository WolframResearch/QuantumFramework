Cell["\<\
That linearity is a claim, so it is checked rather than argued: the effect of \
two faults against the XOR of their rows, over two hundred random pairs.\
\>", "Text",ExpressionUUID->"4b1e6c2c-0452-4134-7925-8676ade7101e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "a", ",", " ", "ex", ",", " ", "instr", ",", " ", "nq", ",", " ", 
     "blocks", ",", " ", "eff", ",", " ", "faults", ",", " ", "pairs"}], 
    "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"codeData", "[", "bitFlip", "]"}]}], ";", "\n", "    ", 
    RowBox[{"ex", " ", "=", " ", 
     RowBox[{"codeExtraction", "[", 
      RowBox[{"a", ",", " ", "1", ",", " ", "\"\<Transversal\>\""}], "]"}]}], 
    ";", "\n", "    ", 
    RowBox[{"instr", " ", "=", " ", 
     RowBox[{"ex", "[", "\"\<Instructions\>\"", "]"}]}], ";", " ", 
    RowBox[{"nq", " ", "=", " ", 
     RowBox[{"ex", "[", "\"\<Qubits\>\"", "]"}]}], ";", " ", 
    RowBox[{"blocks", " ", "=", " ", 
     RowBox[{"ex", "[", "\"\<BlockSizes\>\"", "]"}]}], ";", "\n", "    ", 
    RowBox[{
     RowBox[{"eff", "[", "f_", "]"}], " ", ":=", " ", 
     RowBox[{"faultEffect", "[", 
      RowBox[{
      "a", ",", " ", "instr", ",", " ", "nq", ",", " ", "2", ",", " ", "1", ",",
        " ", "f", ",", " ", "blocks"}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"faults", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "q", ",", " ", "pauli"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "0", ",", " ", 
           RowBox[{"Length", "[", "instr", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"q", ",", " ", "nq"}], "}"}], ",", "\n", "        ", 
         RowBox[{"{", 
          RowBox[{"pauli", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], "}"}]}], "]"}], 
       ",", " ", "2"}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"pairs", " ", "=", " ", 
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "20260914", "]"}], ";", " ", 
       RowBox[{"RandomSample", "[", 
        RowBox[{
         RowBox[{"Subsets", "[", 
          RowBox[{"faults", ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", "200"}], "]"}]}], 
      "]"}]}], ";", "\n", "    ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{"pairs", ",", " ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"c", " ", "=", " ", 
            RowBox[{"eff", "[", "#", "]"}]}], ",", " ", 
           RowBox[{"u", " ", "=", " ", 
            RowBox[{"eff", "[", 
             RowBox[{"{", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "}"}], "]"}]}], ",", " ", 
           RowBox[{"v", " ", "=", " ", 
            RowBox[{"eff", "[", 
             RowBox[{"{", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "}"}], "]"}]}]}], "}"}], ",", 
         "\n", "        ", 
         RowBox[{
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "===", " ", 
           RowBox[{"BitXor", "[", 
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
             RowBox[{"v", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "===", " ", 
           RowBox[{"BitXor", "[", 
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
             RowBox[{"v", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], " ", "&&", "\n", 
          "        ", 
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"[", "3", "]"}], "]"}], " ", "===", " ", 
           RowBox[{"BitXor", "[", 
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
             RowBox[{"v", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}]}]}], "]"}], " ", 
       "&"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[102]:= ",ExpressionUUID->"2982aea8-af87-65d7-5fb1-47f5ca324f3d"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[102]= ",ExpressionUUID->"19ac3a5e-0cd6-873c-4f53-bc18a560ea06"]
}, Open  ]],

Cell[TextData[{
 "One change was needed on the decoder side before any of this showed up in a \
rate, and it is the kind of bug that hides behind a plausible number. ",
 Cell[BoxData["demDecoderTable"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e8690e9-968f-68b3-16bd-09b3233a3a99"],
 " built its hypothesis space from every row of the model. But the decoder \
only ever runs on a shot that was ",
 StyleBox["accepted",
  FontWeight->"Bold"],
 ", so a fault that trips a verification check cannot have happened in it; \
offering that fault as an explanation lets the lightest-set rule claim a \
detector pattern on behalf of something the experiment already threw away, \
and since the rule is first-come, the claim displaces the real explanation."
}], "Text",ExpressionUUID->"2b6bc1ec-c569-bd9f-5968-d8c9ec1d07e5"],

Cell["\<\
Before the fix the transversal extraction measured an exponent of 1.73 and \
looked like it had a residual linear term. It did not. The table now drops \
the herald-tripping rows, and the same condition is visible in the model \
itself:\
\>", "Text",ExpressionUUID->"25f1a39a-81e0-db80-538e-3ac4379aa9ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "dem", ",", " ", "d", ",", " ", "o", ",", " ", "h", ",", " ", "keep", ",",
      " ", "grouped"}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"dem", " ", "=", " ", 
     RowBox[{"QECDetectorModel", "[", 
      RowBox[{"five", ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Circuit\>\"", ",", " ", 
         RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", "1", ",", " ", 
       RowBox[{"\"\<Extraction\>\"", " ", "->", 
        " ", "\"\<Transversal\>\""}]}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"dem", "[", "\"\<DetectorMatrix\>\"", "]"}]}], ";", " ", 
    RowBox[{"o", " ", "=", " ", 
     RowBox[{"dem", "[", "\"\<ObservableMatrix\>\"", "]"}]}], ";", " ", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"dem", "[", "\"\<HeraldMatrix\>\"", "]"}]}], ";", "\n", "    ", 
    RowBox[{"keep", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "d", "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"h", "[", 
           RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "===", " ", "0"}], " ",
         "&"}]}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"grouped", " ", "=", " ", 
     RowBox[{"GroupBy", "[", 
      RowBox[{"keep", ",", " ", 
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], ",", " ", 
       RowBox[{
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"o", "[", 
            RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", "#"}],
          "]"}], " ", "&"}]}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<all rows\>\"", " ", "->", " ", 
       RowBox[{"Length", "[", "d", "]"}]}], ",", " ", 
      RowBox[{"\"\<accepted\>\"", " ", "->", " ", 
       RowBox[{"Length", "[", "keep", "]"}]}], ",", "\n", "      ", 
      RowBox[{"\"\<ambiguous among accepted\>\"", " ", "->", " ", 
       RowBox[{"Count", "[", 
        RowBox[{"grouped", ",", " ", 
         RowBox[{"alt_", " ", "/;", " ", 
          RowBox[{
           RowBox[{"Length", "[", "alt", "]"}], " ", ">", " ", "1"}]}]}], 
        "]"}]}]}], "|>"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[103]:= ",ExpressionUUID->"35466be2-b7a8-26dc-637d-82cfc2428c26"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"all rows\"\>", "\[Rule]", "624"}], ",", 
   RowBox[{"\<\"accepted\"\>", "\[Rule]", "484"}], ",", 
   RowBox[{"\<\"ambiguous among accepted\"\>", "\[Rule]", "0"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[103]= ",ExpressionUUID->"58bdea72-0ba3-5f4c-0842-0c3cae562596"]
}, Open  ]],

Cell[TextData[{
 "Zero ambiguous signatures among accepted faults is the fault-tolerance \
property stated in the detector model's own language, and it is the same \
conditional statement ",
 Cell[BoxData["QECPauliMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e8cef58-e908-949c-16b3-070588a2fee6"],
 " makes about its residual data weight. Both are wrong if the condition is \
dropped on one side only, which is exactly what the decoder was doing."
}], "Text",ExpressionUUID->"0abc4047-6c7b-4886-3a44-5a21050e1aec"],

Cell["Register.wl \[LongDash] blocks, and the layout that has to be right", \
"Section",ExpressionUUID->"24e21d63-fe6b-5877-4c91-954cfb1e2b5d"],

Cell[TextData[{
 "A logical qubit is a block, so a logical two-qubit gate is a gate between \
two blocks. ",
 Cell[BoxData["QECRegister"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348d2737-4aeb-e3cb-5cb2-bf716e9fb111"],
 " fixes the layout \[LongDash] block ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2161c865-0900-0907-571e-e24fa8b5586d"],
 " owns qubits ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["b", "TI"], "-", "1"}], ")"}], 
    StyleBox["n", "TI"], "+", "1", "\[Ellipsis]", 
    StyleBox["b", "TI"], 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cadbe4b-a339-c651-6452-3014d6cdacbb"],
 " \[LongDash] and ",
 Cell[BoxData["registerIndex"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31169419-f57b-983b-672d-0e42fc0feb01"],
 " is the one line that says so, stated once so no consumer reconstructs it."
}], "Text",ExpressionUUID->"40aa99e8-53bd-499c-70a9-10b266481be6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "registerIndex", ",", " ", "registerLift", ",", " ", 
      "registerLabelMatrix", ",", " ", "registerLogicalVectors", ",", "\n", 
      " ", "registerTransversalCNOT", ",", " ", "registerConjugate"}], "}"}], 
    " ", "=", "\n", "    ", 
    RowBox[{"sym", " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<registerIndex\>\"", ",", " ", "\"\<registerLift\>\"", ",", 
       " ", "\"\<registerLabelMatrix\>\"", ",", 
       " ", "\"\<registerLogicalVectors\>\"", ",", "\n", 
       "            ", "\"\<registerTransversalCNOT\>\"", ",", 
       " ", "\"\<registerConjugate\>\""}], "}"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"registerIndex", "[", 
    RowBox[{"7", ",", " ", "1", ",", " ", "3"}], "]"}], ",", " ", 
   RowBox[{"registerIndex", "[", 
    RowBox[{"7", ",", " ", "2", ",", " ", "3"}], "]"}], ",", " ", 
   RowBox[{"registerLift", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"\"\<CNOT\>\"", ",", " ", "1", ",", " ", "2"}], "}"}], "}"}], ",",
      " ", "7", ",", " ", "2"}], "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[104]:= ",ExpressionUUID->"5d165407-aaf3-867b-0b2e-4e60ce87ed41"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "10", ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"\<\"CNOT\"\>", ",", "8", ",", "9"}], "}"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[104]= ",ExpressionUUID->"75cb8946-a0dc-0da7-23c8-2123d169578d"]
}, Open  ]],

Cell[TextData[{
 "The label matrix is where this gets delicate, and the delicacy is inherited \
rather than invented. A code's label matrix has its ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63688a50-35e7-99e6-1117-2c1a4393ebcc"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12187c95-2034-8b29-4238-75df51c6d673"],
 " halves ",
 StyleBox["exchanged",
  FontWeight->"Bold"],
 ", so that a plain matrix product computes symplectic products. Lifting a \
block's rows into a register therefore scatters each row into ",
 StyleBox["two windows",
  FontWeight->"Bold"],
 ", one in each half of the register's columns, not into one contiguous run. \
Getting that wrong produces a matrix of exactly the right shape that quietly \
reports the wrong syndromes \[LongDash] which is the worst kind of wrong."
}], "Text",ExpressionUUID->"34b193bd-0a67-a7a6-5c4e-0ae7af130d8c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"steane", " ", "=", " ", 
     RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}]}], "}"}], ",", "\n", 
   "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Dimensions", "[", 
      RowBox[{"codeLabelMatrix", "[", 
       RowBox[{"codeData", "[", "steane", "]"}], "]"}], "]"}], ",", "\n", 
     "     ", 
     RowBox[{"Dimensions", "[", 
      RowBox[{"registerLabelMatrix", "[", 
       RowBox[{
        RowBox[{"codeData", "[", "steane", "]"}], ",", " ", "2"}], "]"}], 
      "]"}], ",", "\n", "     ", 
     RowBox[{
      RowBox[{"registerLabelMatrix", "[", 
       RowBox[{
        RowBox[{"codeData", "[", "steane", "]"}], ",", " ", "1"}], "]"}], " ",
       "===", " ", 
      RowBox[{"codeLabelMatrix", "[", 
       RowBox[{"codeData", "[", "steane", "]"}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[105]:= ",ExpressionUUID->"4fca8ec2-4b73-3b52-75c9-27ac6e0789b8"],

