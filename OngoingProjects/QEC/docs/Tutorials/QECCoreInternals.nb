Cell[TextData[{
 "Exact, symbolic if the rates are, and the natural quantity to check an \
external simulator against: it is basis-free and every detector is a separate \
test. This is what ",
 Cell["StimCrossCheck/", "InlineCode",ExpressionUUID->
  "330aabc0-bdd5-22a3-6109-42aa34607089"],
 " compares, detector by detector."
}], "Text",ExpressionUUID->"38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],

