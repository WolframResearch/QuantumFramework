     " ", 
    RowBox[{"Range", "[", "6", "]"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[27]:= ",ExpressionUUID->"6334ac9c-43f1-85c0-12cb-45c67585ef2a"],

