Cell[TextData[{
 "Two halves. The bit-flip half puts the ancilla in encoded ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "+"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3760e9-4a32-92b2-4acd-79b36fc4e098"],
 " and runs transversal CNOT from data to ancilla: on the encoded states ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], 
    StyleBox["N", "TI"], 
    StyleBox["O", "TI"], 
    StyleBox["T", "TI"], "|", "\[Psi]", "\[RightAngleBracket]", 
    RowBox[{"|", "+"}], "\[RightAngleBracket]", "\[LongEqual]", "|", "\[Psi]",
     "\[RightAngleBracket]", 
    RowBox[{"|", "+"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fe93a8-4ee9-5b9e-3c85-0af26a9c29e4"],
 ", so nothing happens logically, but the gate still propagates errors and \
bit flips land on the same positions of the ancilla. The phase half uses \
encoded ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "0"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11cf5d11-52cc-ddbb-47f5-555b677ea781"],
 ", the CNOT the other way, and a transversal Hadamard so the same ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ba8138a-66ce-478c-2957-8ad4137b2dd6"],
 "-basis readout sees phase errors:"
}], "Text",ExpressionUUID->"35c9e6d4-f3c4-84c1-63f6-ff918676ee2b"],

