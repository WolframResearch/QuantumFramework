   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"]
}, Open  ]],

Cell[TextData[{
 "A generator carrying a ",
 Cell[BoxData[
  FormBox[
   StyleBox["Y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 " instead brings in ",
 Cell[BoxData["V"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d359769-845f-cd94-44ca-0f332deb97fe"],
 " and ",
 Cell[BoxData["Vdg"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2055bfee-d4b5-7aa2-506a-36cbdd404888"],
 ". The two act identically on the symplectic part \[LongDash] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 " is the Pauli ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 " \[LongDash] and are separate operations only because the noise model \
counts instructions, and a rotation is one location whatever the hardware \
needs to realise it:"
}], "Text",ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

