    7, 4, {{2, 3}, {3, 4}, {4, 5}, {5, 6}}, 4}}]]], "Output",
 CellLabel->
  "Out[83]= ",ExpressionUUID->"4d3801b6-8b23-0df3-74c7-98f02ed657d9"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["catChecksCoverQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09816d05-11e9-fb6e-3fbe-856fa79dc9b4"],
 " is the proof obligation rather than a comment: the chosen pairs have to \
detect every dangerous pattern, and a ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35ec423d-cde2-7917-6394-6466eb97487d"],
 " here says the gadget is not fault tolerant."
}], "Text",ExpressionUUID->"05e0e9bc-56b1-1bf2-339f-00e6634469d8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"catCoverQ", "[", 
    RowBox[{
     RowBox[{"catPairs", "[", "m", "]"}], ",", " ", 
     RowBox[{"catXPatterns", "[", 
      RowBox[{
       RowBox[{"Range", "[", "m", "]"}], ",", " ", 
       RowBox[{"m", " ", "+", " ", "1"}]}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"m", ",", " ", "2", ",", " ", "9"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[84]:= ",ExpressionUUID->"46408f14-a324-388b-6e7f-2751d6d68ad1"],

