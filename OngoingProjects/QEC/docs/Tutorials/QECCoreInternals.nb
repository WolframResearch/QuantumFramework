Cell["The hook error", "Subsection",ExpressionUUID->"6b853673-18d0-d9fa-19ba-a83d996aabc0"],

Cell[TextData[{
 "The book's figure 12.1b puts the ancilla in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "+"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25b5b884-ef74-61b3-534a-31e18a013399"],
 " as the ",
 StyleBox["control", "TI"],
 ". Here the ancilla is the ",
 StyleBox["target", "TI"],
 ", and the mechanism is mirrored. Getting this backwards is the natural \
mistake, so it is worth watching happen."
}], "Text",ExpressionUUID->"574a2197-51ef-7938-7d49-b8d1679a4802"],

Cell["\<\
Find the CNOT ladder of generator 1, which runs into ancilla 6:\
\>", "Text",ExpressionUUID->"6e85e9ed-427b-8528-16ba-00b7770fec72"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ladder", " ", "=", " ", 
  RowBox[{"Select", "[", 
   RowBox[{
    RowBox[{"Range", "[", 
     RowBox[{"circ", "[", "\"\<Depth\>\"", "]"}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"MatchQ", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"circ", "[", "\"\<Instructions\>\"", "]"}], "[", 
        RowBox[{"[", "#", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<CNOT\>\"", ",", " ", "_", ",", " ", "6"}], "}"}]}], 
      "]"}], " ", "&"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"73b76025-96bb-3fff-214d-798f234f85c5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "5", ",", "6", ",", "7"}], "}"}]], "Output",
 CellLabel->
  "Out[22]= ",ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"]
}, Open  ]],

Cell[TextData[{
 "An ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ff7667-e560-b2c0-2285-68408c1a002a"],
 " on the ancilla mid-ladder reaches no data qubit at all: CNOT carries ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c9be80e-0554-61c1-24b8-0268ace1332b"],
 " from control to target, and the ancilla ",
 StyleBox["is", "TI"],
 " the target. It sits there until the measurement and flips that one \
outcome. A pure readout error:"
}], "Text",ExpressionUUID->"106b7ad8-6378-599b-4069-7382160d2be1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"framePropagate", "[", 
  RowBox[{
   RowBox[{"circ", "[", "\"\<Instructions\>\"", "]"}], ",", " ", 
   RowBox[{"circ", "[", "\"\<Qubits\>\"", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ladder", "[", 
       RowBox[{"[", "2", "]"}], "]"}], ",", " ", "6", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}], "}"}]}], "]"}]], "Input",\

 CellLabel->
  "In[23]:= ",ExpressionUUID->"7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Record\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}]}], ",", 
   RowBox[{"\<\"Frame\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "1", ",", "0", ",", 
        "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
        "0", ",", "0"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[23]= ",ExpressionUUID->"304452a4-201b-d64c-607c-4b0e51afbc96"]
}, Open  ]],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],
 " is the one that spreads. CNOT carries ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b5b9263-9199-4e16-7978-144d202c157c"],
 " from target back to control, and the ancilla keeps its ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "475d7054-346c-a3cc-6d63-6a1ebd1ef116"],
 ", so it lands on every data qubit the ladder has ",
 StyleBox["still to touch", "TI"],
 ". After the un-rotation the residual is exactly the un-extracted tail of \
the generator:"
}], "Text",ExpressionUUID->"2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"Prepend", "[", "\n", "        ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "            ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"run", " ", "=", " ", 
           RowBox[{"framePropagate", "[", 
            RowBox[{
             RowBox[{"circ", "[", "\"\<Instructions\>\"", "]"}], ",", " ", 
             RowBox[{"circ", "[", "\"\<Qubits\>\"", "]"}], ",", "\n", 
             "                    ", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"ladder", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], ",", " ", "6", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}], "}"}]}], 
            "]"}]}], "}"}], ",", "\n", "                ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", 
           RowBox[{"Take", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"run", "[", "\"\<Frame\>\"", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", "5"}], "]"}], ",", 
           " ", 
           RowBox[{"Take", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"run", "[", "\"\<Frame\>\"", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", " ", "5"}], "]"}], ",", 
           " ", 
           RowBox[{"run", "[", "\"\<Record\>\"", "]"}]}], "}"}]}], "]"}], ",",
        "\n", "            ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"Length", "[", "ladder", "]"}]}], "}"}]}], "]"}], ",", "\n", 
     "        ", 
     RowBox[{"{", 
      RowBox[{"\"\<after CNOT #\>\"", ",", " ", "\"\<x on data\>\"", ",", 
       " ", "\"\<z on data\>\"", ",", " ", "\"\<record\>\""}], "}"}]}], "]"}],
    ",", "\n", "    ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"3343f580-98d5-e31c-6170-ecea1961ce66"],

