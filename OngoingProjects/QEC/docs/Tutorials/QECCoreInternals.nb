 RowBox[{
  RowBox[{"QECPauli", "[", 
   RowBox[{"Append", "[", 
    RowBox[{"g1", ",", " ", "0"}], "]"}], "]"}], "[", "\"\<String\>\"", 
  "]"}]}], "Input",
