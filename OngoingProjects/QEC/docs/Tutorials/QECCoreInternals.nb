Cell["The rows that get dropped", "Subsection",ExpressionUUID->"10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],

Cell[TextData[{
 Cell[BoxData["codeDetectorModel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25120901-cfbc-a8e6-5321-a16aea4efacc"],
 " is the raw builder underneath the constructor. It drops two kinds of row:"
}], "Text",ExpressionUUID->"3ee7491f-72c3-8814-669d-61590777db7e"],

