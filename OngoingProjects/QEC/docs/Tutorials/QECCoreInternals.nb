       RowBox[{"\"\<Circuit\>\"", ",", " ", "0.01"}], "]"}], "]"}], ",", " ", 
     "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"demSampled", "[", 
    RowBox[{"aN", ",", " ", "200000", ",", " ", "2"}], "]"}], ",", " ", 
   RowBox[{"N", "[", 
    RowBox[{"Simplify", "[", 
     RowBox[{"demExactFailure", "[", 
      RowBox[{"aN", ",", " ", "2"}], "]"}], "]"}], "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[64]:= ",ExpressionUUID->"7dd949a9-d8cf-50b3-2be7-60f2d97a2299"],

