 CellLabel->"In[5]:= ",ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"H\"\>", ",", "\<\"S\"\>", ",", "\<\"Sdg\"\>", ",", "\<\"V\"\>",
    ",", "\<\"Vdg\"\>", ",", "\<\"X\"\>", ",", "\<\"Y\"\>", 
   ",", "\<\"Z\"\>"}], "}"}]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"]
}, Open  ]],

Cell[TextData[{
 "Take the five-qubit code's first generator. To measure a Pauli ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aa912c6-4938-1bb7-5a56-8ba068cd699d"],
 ", rotate each data qubit in ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66b4bee0-d247-b105-0e4b-37cde7f3006f"],
 "'s support so that ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 "'s letter there becomes ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 ", CNOT each of those into the ancilla, rotate back, and measure the ancilla \
in ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 ":"
}], "Text",ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    StyleBox["X", "TI"], "\[Rule]", 
    StyleBox["H", "TI"], "  ", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["H", "TI"], 
      StyleBox["X", "TI"], 
      StyleBox["H", "TI"], "\[LongEqual]", 
      StyleBox["Z", "TI"]}], ")"}], 
    RowBox[{",", "    "}], 
    StyleBox["Y", "TI"], "\[Rule]", 
    StyleBox["V", "TI"], "  ", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["V", "TI"], 
      StyleBox["Y", "TI"], 
      SuperscriptBox[
       StyleBox["V", "TI"], 
       RowBox[{"-", "1"}]], "\[LongEqual]", 
      StyleBox["Z", "TI"]}], ")"}], 
    RowBox[{",", "    "}], 
    StyleBox["Z", "TI"], "\[Rule]", "nothing"}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"6801f052-da94-0b6f-183e-ea1fdf2159b5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
