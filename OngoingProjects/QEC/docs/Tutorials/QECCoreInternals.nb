Cell[BoxData["\<\"XZZXI\"\>"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"7b6211f5-475c-1194-2911-88bf72e963fe"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["generatorInstructions"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],
 " emits that for one generator, one ancilla, one round. Here ",
 Cell[BoxData["XZZXI"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],
 " has support ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],
 ", so qubits 1 and 4 get an ",
 Cell[BoxData["H"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7fe4cc-5889-7f4e-6904-fd96593c4594"],
 " on the way in and out and qubits 2 and 3 get nothing:"
}], "Text",ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

