Cell["Cat.wl \[LongDash] a probe a single fault cannot spread", "Section",ExpressionUUID->"1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],

Cell[TextData[{
 "Everything above measures the bare-ancilla circuit, and the last two \
sections priced what it costs: order ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705e212e-f5a4-7717-2065-b88bfc515a7d"],
 " instead of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c2f5325-a3f6-c048-05d5-4a8ed5809292"],
 ", and 288 faults collapsing onto 71 signatures. The diagnosis in section \
12.1.2 is precise \[LongDash] one ancilla shared by every data qubit of a \
check lets one fault reach several of them \[LongDash] and so is the fix: \
make the controlled-",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "211ecaf2-61ee-418f-5725-e3bc179b13d5"],
 " transversal, one ancilla qubit per letter, which needs those ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51e4dffc-d38f-5703-079b-d6b9e63a3a69"],
 " qubits in a coherent superposition of \"do nothing\" and \"apply ",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30e43b5d-74af-d0fb-609b-b3077d5ba2c1"],
 " to all of them\". That is the cat state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "0"}], "\[Ellipsis]", "0", "\[RightAngleBracket]", "+", 
    RowBox[{"|", "1"}], "\[Ellipsis]", "1", "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44d9380c-2e05-8f35-6ce6-b2564bb1d21f"],
 "."
}], "Text",ExpressionUUID->"36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "catPrep", ",", " ", "catInstr", ",", " ", "catXPatterns", ",", " ", 
      "catPairs", ",", " ", "catCoverQ", ",", " ", "catCanonical"}], "}"}], 
    " ", "=", "\n", "    ", 
    RowBox[{"sym", " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<catPrepInstructions\>\"", ",", 
       " ", "\"\<catInstructions\>\"", ",", " ", "\"\<catXPatterns\>\"", ",", 
       "\n", "            ", "\"\<catCheckPairs\>\"", ",", 
       " ", "\"\<catChecksCoverQ\>\"", ",", 
       " ", "\"\<catCanonicalPattern\>\""}], "}"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"catPrep", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], 
  "]"}]}], "Input",
 CellLabel->
  "In[81]:= ",ExpressionUUID->"138e1639-4d05-8b97-41b5-886364b1d9fd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"R\"\>", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"R\"\>", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"R\"\>", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"R\"\>", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"H\"\>", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"CNOT\"\>", ",", "3", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[81]= ",ExpressionUUID->"156728ce-0023-e03b-431c-c1a8b1d7b301"]
}, Open  ]],

Cell[TextData[{
 "A cat built this way is useless unless it is checked, and the interesting \
question is ",
 StyleBox["which", "TI"],
 " pairs to check. The book says \"if we do this on enough pairs of qubits, \
any single fault in the circuit originally constructing the cat state will be \
picked up by the checks\" and leaves the set open. Here it is derived: \
propagate every single fault of the preparation and collect the ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"],
 " patterns it can leave."
}], "Text",ExpressionUUID->"26ff5c08-e081-ff27-4e85-56559135c20d"],

Cell[TextData[{
 "Two reductions make that set small. ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["X", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["m", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07c988c4-3ef2-8066-2df6-21aeba84d34c"],
 " stabilises the cat, so a pattern and its complement are the same error; \
and a pattern of canonical weight one is a single data error, which the code \
corrects. Only canonical weight two and above is dangerous:"
}], "Text",ExpressionUUID->"4bc0a2f3-6150-447f-79ff-3bbd10e52f45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"catCanonical", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1", ",", " ", "0", ",", " ", "0"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"catCanonical", "[", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0", ",", " ", "1", ",", " ", "1"}], "}"}], "]"}],
    ",", " ", 
   RowBox[{"catXPatterns", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",", 
     " ", "5"}], "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[82]:= ",ExpressionUUID->"7ac66077-3bfa-1f18-2afe-7a31bd8f6262"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1", ",", "1"}], "}"}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[82]= ",ExpressionUUID->"3d863d84-94ab-5643-6bbd-b4ee1d5e3ca9"]
}, Open  ]],

Cell[TextData[{
 "That single pattern is the book's own figure 12.3b, recovered rather than \
transcribed. And the count follows a rule the book does not state: a fault \
reaching qubit ",
 Cell[BoxData[
  FormBox[
   StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ab8b877-e011-189c-2a47-323091a46ae6"],
 " leaves a suffix of ones of length ",
 Cell[BoxData[
  FormBox[
   StyleBox["L", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35eb0178-2238-e094-63e8-992257b2b2fe"],
 ", which canonicalises to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"min", "(", 
    RowBox[{
     StyleBox["L", "TI"], ",", 
     StyleBox["m", "TI"], "-", 
     StyleBox["L", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da6433d-a7a4-ba24-3b5e-5b66d256090e"],
 ", so the dangerous ",
 Cell[BoxData[
  FormBox[
   StyleBox["L", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "462f64f6-435d-c7dd-6fd5-7db076e9ad27"],
 " run from 2 to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "-", "2"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b06bf63-5f43-ed7c-793d-374d5af7b446"],
 " and there are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "-", "3"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fd1c247-21a4-d962-35ee-e4215056a848"],
 " of them. An ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09347675-9fce-c17b-38cc-683f1a789041"],
 " cat needs one check, not three."
}], "Text",ExpressionUUID->"2c597ed5-00d9-d535-5467-779fb16dbc1f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", ",", " ", 
      RowBox[{"Length", "[", 
       RowBox[{"catXPatterns", "[", 
        RowBox[{
         RowBox[{"Range", "[", "m", "]"}], ",", " ", 
         RowBox[{"m", " ", "+", " ", "1"}]}], "]"}], "]"}], ",", " ", 
      RowBox[{"catPairs", "[", "m", "]"}], ",", " ", 
      RowBox[{"m", " ", "-", " ", "3"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"m", ",", " ", "2", ",", " ", "7"}], "}"}]}], "]"}], " ", "//", 
  " ", "TableForm"}]], "Input",
 CellLabel->
  "In[83]:= ",ExpressionUUID->"66c4d8d6-27c8-a0db-0efb-d1905262f221"],

