   ",", "\<\"Circuit\"\>", ",", "q", ",", "0", ",", "True", ",", "False"}], 
  "}"}]], "Output",
 CellLabel->
  "Out[37]= ",ExpressionUUID->"39b01e29-d171-5c92-6f4f-9072e00426f8"]
