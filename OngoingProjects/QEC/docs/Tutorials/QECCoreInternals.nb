Cell[TextData[{
 "Two checks that the quotient is forced rather than convenient. The accepted \
weights come in complementary pairs ",
 Cell[BoxData[
  FormBox[
   StyleBox["w", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f1ed2e3-b722-4b37-2525-cbccc2d7161d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "-", 
    StyleBox["w", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52e63e44-9d5c-26a1-029d-b02e14ee8c8b"],
 ", which is the fingerprint of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["X", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["m", "TI"]}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e766a94-5ec6-6187-160d-83de5b7333ed"],
 "; and dropping the herald filter brings weight two back, so the cat checks \
are visibly load-bearing:"
}], "Text",ExpressionUUID->"2eead67c-41e5-1519-56e9-c82677907c63"],

