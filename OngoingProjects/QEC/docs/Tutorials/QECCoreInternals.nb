    RowBox[{"bfCirc", "[", "\"\<Instructions\>\"", "]"}], ",", " ", "5"}], 
   "]"}], "]"}]], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"73e8aeff-5b91-f8f4-2197-47b95e25cade"],

Cell[BoxData["18"], "Output",
 CellLabel->
  "Out[28]= ",ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"]
}, Open  ]],

Cell[TextData[{
 "One consequence worth seeing, because it is why the anchors are computed \
over the whole circuit rather than per round: ",
 StyleBox["rounds pipeline",
  FontWeight->"Bold"],
 ". An ancilla's reset for round 2 schedules while the other ancilla of round \
1 is still being measured, so ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "794a4309-908b-2549-2f4a-5b53213f8f93"],
 " rounds are not ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],
 " copies of one round's schedule:"
}], "Text",ExpressionUUID->"15eb24b6-b946-3a65-43e8-bdf038f0894f"],

