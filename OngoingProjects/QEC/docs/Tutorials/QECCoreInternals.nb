Cell[TextData[{
 "Steane EC rested on that answer being the CNOT action, and the header of ",
 Cell["ErrorCorrection.wl", "InlineCode",ExpressionUUID->
  "7d29df82-54ab-6c21-24d6-d6ec5d5e370b"],
 " cites \[Section]12.3.1 for it. This is where it is computed."
}], "Text",ExpressionUUID->"2673b224-f5d9-a24c-4e00-2b81fc6df096"],

Cell[TextData[{
 "And the second half, which is the one that actually decides. A gate can act \
correctly on the logical operators and still take the state out of the code \
space; both have to hold. On the five-qubit code the ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27388ee6-22a7-f122-4ec7-27c05753c008"],
 " half of the action comes out right and the ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51cd4bfd-d3fa-9dcf-07f3-62a6e58ce715"],
 " half does not, so a test that looked only at the logical operators would \
have passed half the time:"
}], "Text",ExpressionUUID->"06a776cb-b9d0-3c58-2e5d-6f95386a86a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "leaves", "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{
     RowBox[{"leaves", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"instr", " ", "=", " ", 
          RowBox[{"r", "[", 
           RowBox[{"\"\<TransversalCNOT\>\"", ",", " ", "1", ",", " ", "2"}], 
           "]"}]}], ",", " ", 
         RowBox[{"nq", " ", "=", " ", 
          RowBox[{"r", "[", "\"\<Qubits\>\"", "]"}]}], ",", " ", "group"}], 
        "}"}], ",", "\n", "        ", 
       RowBox[{
        RowBox[{"group", " ", "=", " ", 
         RowBox[{"QECCode", "[", 
          RowBox[{"r", "[", "\"\<Generators\>\"", "]"}], "]"}]}], ";", "\n", 
        "        ", 
        RowBox[{"Count", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"QECPauli", "[", 
              RowBox[{"registerConjugate", "[", 
               RowBox[{"instr", ",", " ", "nq", ",", " ", 
                RowBox[{
                 RowBox[{"QECPauli", "[", "#", "]"}], "[", "\"\<Vector\>\"", 
                 "]"}]}], "]"}], "]"}], "[", "\"\<String\>\"", "]"}], " ", 
            "&"}], " ", "/@", " ", 
           RowBox[{"r", "[", "\"\<Generators\>\"", "]"}]}], ",", "\n", 
          "              ", 
          RowBox[{"g_", " ", "/;", " ", 
           RowBox[{"!", " ", 
            RowBox[{"group", "[", 
             RowBox[{"\"\<StabilizerMemberQ\>\"", ",", " ", "g"}], 
             "]"}]}]}]}], "]"}]}]}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Steane\>\"", " ", "->", " ", 
       RowBox[{"leaves", "[", 
        RowBox[{"QECRegister", "[", 
         RowBox[{
          RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
          "2"}], "]"}], "]"}]}], ",", "\n", "      ", 
      RowBox[{"\"\<five-qubit\>\"", " ", "->", " ", 
       RowBox[{"leaves", "[", 
        RowBox[{"QECRegister", "[", 
         RowBox[{
          RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
          "2"}], "]"}], "]"}]}]}], "|>"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[107]:= ",ExpressionUUID->"7641b941-63e8-8619-1e7e-312b1582ed63"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Steane\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"five-qubit\"\>", "\[Rule]", "8"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[107]= ",ExpressionUUID->"42b8cf72-fa81-ffe6-7247-e73fff35c5cc"]
}, Open  ]],

Cell["Transversal.wl \[LongDash] tables that are computed, not typed", \
"Section",ExpressionUUID->"1c8db7a0-3aa3-299f-44b2-2e0abf567be5"],

Cell[TextData[{
 "The criterion of sec. 11.2 is cheap to state and easy to get subtly wrong: ",
 Cell[BoxData[
  FormBox[
   StyleBox["U", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "473593be-64fb-e664-6eca-0af80c8fcd4e"],
 " applied to every qubit separately is a gate gadget when it maps the \
stabilizer group to itself, and the logical gate is what it does to ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["X", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79a8e286-b760-8808-2f57-fbe3c21adb52"],
 " and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "766f3dde-6e6e-8ae3-1e14-b4980b18d8c9"],
 ". The subtlety is that both halves are statements ",
 StyleBox["about signs",
  FontWeight->"Bold"],
 ", and every conjugation in the layer up to this file threw signs away."
}], "Text",ExpressionUUID->"7acff19c-f8f8-c05b-2af4-e8d9f97292a1"],

Cell[TextData[{
 "So the first decision here is a negative one: ",
 Cell[BoxData["framePropagate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36bb0aa4-099e-3511-5e58-a30ea8289c7b"],
 " is not used. Rows carry their ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z",
     FontSlant->"Plain"], "4"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fab4322-7f5b-c123-15a9-5a8c7aef9009"],
 " phase (",
 Cell["Pauli.wl", "InlineCode",ExpressionUUID->
  "559c0528-76f1-864e-03a3-9d720285ec94"],
 "), products go through ",
 Cell[BoxData["pauliProduct"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c3b3e9a-7f95-6e09-75d8-b7c47a203553"],
 " (the row function behind ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"QECPauli", "[", "p", "]"}], "[", 
   RowBox[{"\"\<Product\>\"", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b834648-1855-f17e-29b1-581299e1c044"],
 "), and membership is asked of ",
 Cell[BoxData["codeStabilizerElement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aa15cf4-f328-f435-1a5f-55b186c2df1f"],
 ", which returns the group element ",
 StyleBox["with its true phase", "TI"],
 " rather than a yes about its symplectic part. An image equal to minus a \
generator preserves the stabilizer as a set of Paulis and destroys the code \
space; only the phase-aware test can tell those apart."
}], "Text",ExpressionUUID->"1fa3178e-7287-38be-4550-8ee807338a84"],

Cell[TextData[{
 "The second decision is that the action tables are derived. A hand-written \
",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"H", ":", " ", "X"}], " ", "->", " ", "Z"}], ",", " ", 
   RowBox[{
    RowBox[{"S", ":", " ", "Y"}], " ", "->", " ", 
    RowBox[{"-", "X"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33c53063-afff-c489-61fa-aa4cc98baed3"],
 " table is exactly the kind of thing that acquires one wrong sign and then \
reports plausible answers forever, so ",
 Cell[BoxData["transversalAction"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08d8bcb3-70a4-55b3-38e7-35fd01513f99"],
 " computes each table once from the gate's own matrix \[LongDash] conjugate \
each Pauli, read the coefficient off a trace, and insist that it is a fourth \
root of unity:"
}], "Text",ExpressionUUID->"20e38226-5aed-155d-5090-1b805e987fa7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "transversalAction", ",", " ", "transversalConjugate", ",", " ", 
      "transversalPairCode", ",", " ", "transversalGateNames", ",", "\n", " ",
       "transversalCliffordWords"}], "}"}], " ", "=", "\n", "    ", 
    RowBox[{"sym", " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<transversalAction\>\"", ",", 
       " ", "\"\<transversalConjugate\>\"", ",", 
       " ", "\"\<transversalPairCode\>\"", ",", "\n", 
       "            ", "\"\<transversalGateNames\>\"", ",", 
       " ", "\"\<transversalCliffordWords\>\""}], "}"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"QECPauli", "[", "#", "]"}], "[", "\"\<String\>\"", "]"}], " ", 
    "&"}], ")"}], " ", "/@", " ", 
  RowBox[{"Lookup", "[", 
   RowBox[{
    RowBox[{"transversalAction", "[", 
     RowBox[{"\"\<S\>\"", ",", " ", "1"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}]}], "]"}]}]}], "Input",
 CellLabel->
  "In[108]:= ",ExpressionUUID->"160727ef-d1b8-0069-3e3c-bec8e04d52b3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Y\"\>", ",", "\<\"Z\"\>", ",", "\<\"-X\"\>"}], "}"}]], "Output",\

 CellLabel->
  "Out[108]= ",ExpressionUUID->"261df1b1-b81e-57af-4e22-e8fb39ab3df5"]
}, Open  ]],

Cell[TextData[{
 "Adding a gate to this file is adding a matrix. The matrices are the \
engine's, and the tests compare them against ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"QuantumOperator", "[", "name", "]"}], 
   "[", "\"\<MatrixRepresentation\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00ba9d2f-c328-50fc-3059-1488f6dd22c6"],
 " so that a drift in either convention fails loudly instead of quietly \
flipping every sign below."
}], "Text",ExpressionUUID->"02964792-f196-8b6e-32ae-5edf8020d9b4"],

Cell["\<\
Conjugating a whole row is then qubit by qubit: the factors live on different \
qubits, so they commute, and their phases simply add.\
\>", "Text",ExpressionUUID->"166d4e5f-4333-9385-3e13-601976c7e1ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"QECPauli", "[", 
     RowBox[{"transversalConjugate", "[", 
      RowBox[{"\"\<S\>\"", ",", " ", 
       RowBox[{
        RowBox[{"QECPauli", "[", "\"\<IIIXXXX\>\"", "]"}], 
        "[", "\"\<Vector\>\"", "]"}]}], "]"}], "]"}], "[", "\"\<String\>\"", 
    "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"QECPauli", "[", 
     RowBox[{"transversalConjugate", "[", 
      RowBox[{"\"\<S\>\"", ",", " ", 
       RowBox[{
        RowBox[{"QECPauli", "[", "\"\<XXXXXXX\>\"", "]"}], 
        "[", "\"\<Vector\>\"", "]"}]}], "]"}], "]"}], "[", "\"\<String\>\"", 
    "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"QECPauli", "[", 
     RowBox[{"transversalConjugate", "[", 
      RowBox[{"\"\<H\>\"", ",", " ", 
       RowBox[{
        RowBox[{"QECPauli", "[", "\"\<XZZXI\>\"", "]"}], "[", "\"\<Vector\>\"",
         "]"}]}], "]"}], "]"}], "[", "\"\<String\>\"", "]"}]}], 
  "}"}]], "Input",
 CellLabel->
  "In[109]:= ",ExpressionUUID->"1c99ee20-d785-d362-44a6-078de231be48"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"IIIYYYY\"\>", ",", "\<\"YYYYYYY\"\>", ",", "\<\"ZXXZI\"\>"}], 
  "}"}]], "Output",
 CellLabel->
  "Out[109]= ",ExpressionUUID->"60858f89-56d8-6615-10ba-26d3636d4d7f"]
}, Open  ]],

Cell[TextData[{
 "Note where the minus of sec. 11.3 is ",
 StyleBox["not", "TI"],
 ": the physical image of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["X", "TI"], 
    RowBox[{"\[CircleTimes]", "7"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e45545e-c429-efe4-567b-4e1bedddb5ce"],
 " is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Y", "TI"], 
    RowBox[{"\[CircleTimes]", "7"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24564246-a2b2-7a9b-4c6e-6423d74748e1"],
 " with phase zero. The sign appears only when that image is divided by the \
logical representative, because ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Y", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "273d1382-afb1-09c0-4ec2-8aefca445b2a"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox[
     StyleBox["Y", "TI"], 
     RowBox[{"\[CircleTimes]", "7"}]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39c9e52f-ed06-87fb-6ff6-fc8884b0edc1"],
 " and not ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Y", "TI"], 
    RowBox[{"\[CircleTimes]", "7"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46be6341-4be3-06d9-6e46-7b2b6d966c23"],
 ". ",
 Cell[BoxData["transversalDecompose"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "352b8971-1d3f-d4c9-6328-213b94cbbe13"],
 " is what does the dividing: the exponents of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["X", "TI"], "_"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "227c7e4b-1c68-aac8-5204-70159502f812"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cd9b5a9-dbed-51da-14e6-2cf2dd982320"],
 " come from commutation \[LongDash] anticommuting with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4becebe3-5bfe-fac0-7993-02cd5d88c82a"],
 " is what an ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["X", "TI"], "_"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "312d182f-c6c7-5e1e-60d2-9188f3722564"],
 " factor does \[LongDash] and the sign is whatever is left once the logical \
part and the stabilizer part have been divided out."
}], "Text",ExpressionUUID->"1449d45f-8382-90b9-3c76-ce193634e283"],

Cell["\<\
A gate gadget is checked generator by generator, and the check is reported \
rather than reduced to a boolean, because the interesting failures are \
partial:\
\>", "Text",ExpressionUUID->"444f09dd-766a-dba7-6c74-a087031ca98d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{"QECTransversalGate", "[", 
     RowBox[{
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", 
      " ", "\"\<S\>\""}], "]"}], "[", "\"\<StabilizerImages\>\"", "]"}], 
   "]"}], "[", 
  RowBox[{"[", "1", "]"}], "]"}]], "Input",
 CellLabel->
  "In[110]:= ",ExpressionUUID->"79e9b65a-67eb-1624-2f96-2804119e7d0e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Generator\"\>", "\[Rule]", "\<\"IIIXXXX\"\>"}], ",", 
   RowBox[{"\<\"Image\"\>", "\[Rule]", "\<\"IIIYYYY\"\>"}], ",", 
   RowBox[{"\<\"StabilizerQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[110]= ",ExpressionUUID->"394df0e2-3b3f-7a44-6f72-e9ccbeca48ae"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["X", "TI"], 
    RowBox[{"\[CircleTimes]", "4"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d3de1d4-e864-19c9-04c2-f89189116b13"],
 " goes to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["Y", "TI"], 
    RowBox[{"\[CircleTimes]", "4"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1adc8861-0296-99d3-4ae3-224bb720eb39"],
 ", which is in the group with the right sign because every element of this \
stabilizer has weight 4 \[LongDash] the book's \"the phases will take care of \
themselves\", checked instead of assumed."
}], "Text",ExpressionUUID->"47f3727e-1788-b883-6d81-7438a2220ae9"],

Cell[TextData[{
 "Two blocks reuse the machinery rather than duplicating it. ",
 Cell[BoxData["transversalPairCode"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02bfa0ec-e0fe-2fa7-3244-39c9908b758d"],
 " builds the direct sum of two copies of the stabilizer as an ordinary code \
association, which is what lets ",
 Cell[BoxData["codeStabilizerElement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cc1833e-1ead-5711-24fe-1b789b583a7b"],
 " answer membership for the pair with no second implementation, and the \
logical operators are taken block by block rather than from the pair's own \
standard form \[LongDash] the question is what the gate does to ",
 StyleBox["this", "TI"],
 " block's qubit and ",
 StyleBox["that", "TI"],
 " one's."
}], "Text",ExpressionUUID->"3cb4236e-91b2-9328-644b-bb482044fe72"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pc", " ", "=", " ", 
     RowBox[{"transversalPairCode", "[", 
      RowBox[{"codeData", "[", 
       RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "]"}], "]"}]}], 
    "}"}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"pc", "[", "\"\<CheckMatrix\>\"", "]"}], "]"}], ",", " ", 
     RowBox[{"pc", "[", "\"\<Qubits\>\"", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[111]:= ",ExpressionUUID->"631da35c-735e-7e3b-1122-3b0606eb4501"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"12", ",", "14"}], "}"}]], "Output",
 CellLabel->
  "Out[111]= ",ExpressionUUID->"44b7daea-ed84-b50e-6c4c-d3b784361c54"]
}, Open  ]],

Cell[TextData[{
 "The qubit layout is ",
 Cell["Register.wl", "InlineCode",ExpressionUUID->
  "39f2334d-24de-3dcb-6f81-ab174d688711"],
 "'s, so a two-block gate emitted here drops straight into a register."
}], "Text",ExpressionUUID->"1ec600b7-0050-8550-46fd-99f1b1eaefba"],

Cell[TextData[{
 "Naming the result is a lookup, not a classification. The twenty-four \
one-qubit Cliffords are enumerated as words in ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33bfe66e-cd59-d601-6144-f84be4edbd6b"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a3ee8c1-8740-e1ad-1bc5-01ab32fab3f7"],
 ", keyed by what they do to ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33885b0f-111a-0c54-6188-5369a0af56be"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c9080a8-67dd-9047-04af-19f21269e2ad"],
 "; the named gates are added last so that they win the key they share with a \
word, and the transversal ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2abc9d06-0494-496b-5a43-1560ad211bb1"],
 " of the seven-qubit code is reported as ",
 Cell[BoxData["\"\<Sdg\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43e301a0-76bb-1057-7190-980a034e62bd"],
 " rather than as ",
 Cell[BoxData["\"\<SSS\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ae06f2b-7109-3ba5-4a9f-877500bd898f"],
 "."
}], "Text",ExpressionUUID->"0856a555-3f58-6085-386d-3d1fbaed32ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"transversalCliffordWords", "[", "1", "]"}], "]"}], ",", " ", 
   RowBox[{"Length", "[", 
    RowBox[{"transversalGateNames", "[", "1", "]"}], "]"}], ",", " ", 
   RowBox[{"Length", "[", 
    RowBox[{"transversalGateNames", "[", "2", "]"}], "]"}]}], "}"}]], "Input",\

 CellLabel->
  "In[112]:= ",ExpressionUUID->"71eecbe3-9be0-9ba6-2795-e2cd1d9ae98c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"24", ",", "24", ",", "3"}], "}"}]], "Output",
 CellLabel->
  "Out[112]= ",ExpressionUUID->"59070895-187c-42ea-0f3c-a1df99091030"]
}, Open  ]],

Cell[TextData[{
 "Two consequences worth naming. A code with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], ">", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "189fe470-6cd8-7cf4-48a4-fe3a056d46de"],
 " gets its logical action reported and its logical gate left as ",
 Cell[BoxData[
  RowBox[{"Missing", "[", "\"\<NotNamed\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04ed2843-d86c-272a-2c92-c22cd91e8a70"],
 " \[LongDash] on the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"[", 
     RowBox[{"4", ",", "2", ",", "2"}], "]"}], "]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d9e217-b7c7-416b-20e6-0450c27213b1"],
 " code the transversal ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29221b72-bc55-8ef4-58d1-933c35e1d4de"],
 " is a Hadamard on each logical qubit ",
 StyleBox["and", "TI"],
 " a swap of the two, and there is no one-qubit name for that. And one \
vocabulary change leaked out of this file: ",
 Cell[BoxData["\"\<Sdg\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41172bde-c012-830e-772c-c29bf1a4ee54"],
 " had to join the circuit ops, where it moves the frame exactly as ",
 Cell[BoxData["\"\<S\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dd84232-0c35-660d-6bf8-647ca5c04d57"],
 " does and is emitted to the engine as three ",
 Cell[BoxData["\"\<S\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5558c8fc-3d33-9e90-0367-e1a6b4c7e4fa"],
 ", the same treatment ",
 Cell[BoxData["\"\<Vdg\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53291d47-a111-bd44-02d6-9520d0a507ae"],
 " already had."
}], "Text",ExpressionUUID->"14460f59-6b0f-818e-3c7d-a7030ebbd3d4"],

Cell["\<\
FaultTolerant.wl \[LongDash] the substitution, and the bookkeeping that goes \
with it\
\>", "Section",ExpressionUUID->"6afe19ed-5a5e-331e-1a85-90b75fe89e64"],

Cell["\<\
Def 10.6 is short, and almost all of this file is the bookkeeping it implies. \
Three parts of that bookkeeping are where a hand-assembled protocol goes \
wrong.\
\>", "Text",ExpressionUUID->"142f588d-e120-bc70-3dd5-51d690da075a"],

Cell[TextData[{
 StyleBox["Which gadget.",
  FontWeight->"Bold"],
 " Not the one with the same name. ",
 Cell[BoxData["ftGateWord"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "029948d8-232c-2201-32a7-618256d9716b"],
 " searches the transversal gates of the code for the one whose ",
 StyleBox["logical action", "TI"],
 " is the gate requested, named gates first so that a single instruction wins \
over a three-instruction word that does the same thing:"
}], "Text",ExpressionUUID->"4b1b5b6f-b43d-594b-7939-53493dc82b91"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ftGateWord", ",", " ", "ftRelocate", ",", " ", "ftLocations", ",", " ", 
      "ftReadoutSupport"}], "}"}], " ", "=", "\n", "    ", 
    RowBox[{"sym", " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<ftGateWord\>\"", ",", " ", "\"\<ftRelocate\>\"", ",", 
       " ", "\"\<ftLocations\>\"", ",", " ", "\"\<ftReadoutSupport\>\""}], 
      "}"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ftGateWord", "[", 
    RowBox[{
     RowBox[{"codeData", "[", 
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "]"}], ",", 
     " ", "\"\<S\>\""}], "]"}], ",", "\n", " ", 
   RowBox[{"ftGateWord", "[", 
    RowBox[{
     RowBox[{"codeData", "[", 
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "]"}], ",", 
     " ", "\"\<Sdg\>\""}], "]"}], ",", "\n", " ", 
   RowBox[{"ftGateWord", "[", 
    RowBox[{
     RowBox[{"codeData", "[", 
      RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "]"}], ",", 
     " ", "\"\<T\>\""}], "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[113]:= ",ExpressionUUID->"32f703b9-71e1-95eb-628c-9ae30795ff31"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Sdg\"\>", ",", "\<\"S\"\>", ",", 
   RowBox[{"Missing", "[", 
    RowBox[{"\<\"NoGadget\"\>", ",", "\<\"T\"\>"}], "]"}]}], "}"}]], "Output",\

 CellLabel->
  "Out[113]= ",ExpressionUUID->"0c860bbc-8d1f-f590-34bd-a2e624abdffa"]
}, Open  ]],

Cell[TextData[{
 "The gadget for a logical ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bab88a0-6539-d521-49a8-210a0ccdbc0b"],
 " is the transversal ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], "\[Dagger]"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74b37722-3fdc-1a4f-1c41-6e8cba696895"],
 " and vice versa (sec. 11.3), and a gate outside the Clifford group has no \
gadget at all, which is reported as a ",
 Cell[BoxData["Missing"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31781dc2-1028-33d4-6707-94aca1c2813e"],
 " rather than approximated. This is the whole payoff of carrying phases \
through ",
 Cell["Transversal.wl", "InlineCode",ExpressionUUID->
  "2148b02c-d62e-5336-5777-2989e3db3e1c"],
 ": without them the search cannot tell the two apart and the assembler ships \
the conjugate circuit."
}], "Text",ExpressionUUID->"183293a6-0d60-7813-49c1-0a00a4154b79"],

Cell[TextData[{
 StyleBox["Where the gadget goes.",
  FontWeight->"Bold"],
 " The error correction gadget is written for data on qubits ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[Ellipsis]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61e1f3c1-eae0-3799-179e-eaaa8e9a9de3"],
 " with its ancilla at an offset, because that is all it ever needed. Here \
the data is block ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20bddc2d-650e-8031-5042-d6770cb8d31b"],
 " and the ancilla is that block's own workspace. Every instruction of that \
gadget touches either a data qubit or an ancilla qubit, so relocating it is a \
two-branch map rather than a rewrite:"
}], "Text",ExpressionUUID->"7a437910-f355-55ba-2a71-715d86e03f80"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ftRelocate", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"\"\<CNOT\>\"", ",", " ", "1", ",", " ", "8"}], "}"}], "}"}], ",",
    " ", "7", ",", " ", "7", ",", " ", "7", ",", " ", "21"}], "]"}]], "Input",\

 CellLabel->
  "In[114]:= ",ExpressionUUID->"49429438-4a3e-974e-7f71-0e626fc8fd94"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"\<\"CNOT\"\>", ",", "8", ",", "22"}], "}"}], "}"}]], "Output",
 CellLabel->
  "Out[114]= ",ExpressionUUID->"07e2168c-1726-1a27-2d91-8fd6a2d3690d"]
}, Open  ]],

Cell["\<\
Data qubit 1 becomes qubit 1 of block 2; ancilla qubit 8 becomes qubit 1 of \
that block's workspace. One workspace per block rather than one shared one, \
so that the corrections of a layer can run in parallel \[LongDash] a shared \
ancilla would serialise them and inflate the depth overhead for no physical \
reason.\
\>", "Text",ExpressionUUID->"3540c51c-f580-c338-637f-dd59fc3aae02"],

Cell[TextData[{
 StyleBox["When it goes there.",
  FontWeight->"Bold"],
 " The assembly walks the ",
 StyleBox["schedule", "TI"],
 " of ",
 Cell[BoxData[
  FormBox[
   StyleBox["C", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "684f0173-fe99-1571-1874-993cfb2c7c5b"],
 ", not its instruction list. Def 10.6 puts a correction between every \
adjacent pair of locations, and in a circuit with parallel gates \"adjacent\" \
means a layer. Within a layer: emit each location's gadget; then give every \
live block nobody touched a ",
 StyleBox["storage",
  FontWeight->"Bold"],
 " gadget, which emits nothing and is still a location; then put an error \
correction gadget on every block still live at the end of the layer. A block \
measured in that layer is done, and gets none."
}], "Text",ExpressionUUID->"6e32c5a8-aee9-5273-17c1-dcf5ca9c2159"],

Cell[TextData[{
 "That is also why the size overhead is computed with ",
 Cell[BoxData["ftLocations"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "607492e2-157b-ba0c-100b-0bcc9c0f0956"],
 " rather than ",
 Cell[BoxData["Length"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7781757c-388d-abb9-1dbf-6d26b939f983"],
 ": a location is an instruction ",
 StyleBox["or", "TI"],
 " a wait, and the waits come from ",
 Cell[BoxData["circuitIdleSlots"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "566e7348-207a-dc95-7e16-6b12510ca6ff"],
 ", the same source the detector model and the Stim writer use."
}], "Text",ExpressionUUID->"39672ae7-82f4-b353-6f1c-c3c1368601b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ftLocations", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<R\>\"", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<R\>\"", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<H\>\"", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<CNOT\>\"", ",", " ", "1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<M\>\"", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<M\>\"", ",", " ", "2"}], "}"}]}], "}"}], ",", " ", "2"}], 
  "]"}]], "Input",
 CellLabel->
  "In[115]:= ",ExpressionUUID->"0c48aba4-6f27-6a39-3477-420e0ad23903"],

Cell[BoxData["7"], "Output",
 CellLabel->
  "Out[115]= ",ExpressionUUID->"2f62374d-f3df-131c-5511-af16866a7e66"]
}, Open  ]],

Cell["\<\
Six instructions and one wait \[LongDash] block 2 idling through the Hadamard.\
\>", "Text",ExpressionUUID->"455ea632-3d4d-f0d3-7365-387cb4f9c239"],

Cell[TextData[{
 StyleBox["What comes back out.",
  FontWeight->"Bold"],
 " The measurement record is tracked while emitting rather than recovered \
afterwards, because a measurement gadget's ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f0fb95c-030e-c889-4534-3106b6b89ad3"],
 " outcomes sit in the middle of a record otherwise made of error-correction \
outcomes. ",
 Cell[BoxData["\"\<Readouts\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16268eae-a572-7912-3fdd-270bcc074878"],
 " gives, per logical qubit, the absolute positions whose parity is the \
logical bit; their offsets inside the block are the support of ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "346a0e1a-2221-987e-5c69-a04457d5eb44"],
 ", which a transversal ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "366be24c-537a-43bb-5e68-0416660f1181"],
 " measurement is only able to read because that operator is a product of ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "501b1457-1a1d-907b-0038-8e119fa9e341"],
 "s:"
}], "Text",ExpressionUUID->"291c68e0-f532-6cdd-5f23-81cdfcc73627"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ftReadoutSupport", "[", 
  RowBox[{"codeData", "[", 
   RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], "]"}], "]"}]], "Input",\

 CellLabel->
  "In[116]:= ",ExpressionUUID->"5c29c458-c353-7b98-05d6-de05f6e649e2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "4", ",", "6"}], "}"}]], "Output",
 CellLabel->
  "Out[116]= ",ExpressionUUID->"6e1a2d6a-d2ad-c32a-1639-c537e759ae70"]
}, Open  ]],

Cell[TextData[{
 "And the gadgets can be taken apart again: the table is in emission order \
and each row carries its own length, so ",
 Cell[BoxData[
  RowBox[{"ft", "[", 
   RowBox[{"\"\<GadgetInstructions\>\"", ",", " ", "\"\<Gate\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6eb5612b-2266-f0f1-164b-79755710c2db"],
 " slices the assembled circuit by cumulative sums and never has to recognise \
a gadget by looking at its gates. That is what lets a check run the gate \
gadgets alone \[LongDash] preparation and gates, no corrections \[LongDash] \
and ask the engine whether the encoded blocks came out in the state the ideal \
circuit would have produced."
}], "Text",ExpressionUUID->"1f4b4965-e043-b514-4549-614e91f71c7e"],

Cell["Operational.wl \[LongDash] the code as the objects quantum theory \
uses", "Section",ExpressionUUID->"5bf36e21-2d79-2b6f-0980-878b440c79b5"],

Cell[TextData[{
 "The file makes a ",
 Cell[BoxData["QECCode"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fe9f85b-1ce6-27f0-1596-f20594908dda"],
 " present the operational formulation of error correction (Knill, Laflamme, \
Viola; Rahn, Doherty, Mabuchi): encoder isometry, codewords, code-space \
projector, syndrome instrument, recovery channels, logical channel, Knill\
\[Dash]Laflamme matrix. It is a change of face, not of engine; three \
decisions carry it."
}], "Text",ExpressionUUID->"3eadea9f-7d43-757d-6652-03d974f65c47"],

Cell[TextData[{
 StyleBox["The logical channel is built from the coset engine, never by \
composing channels.",
  FontWeight->"Bold"],
 " For Pauli noise the cycle's residue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["s", "TI"]], 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68be2dd2-eea3-f2cb-1845-c49f8b57c011"],
 " lies in the normalizer, so its effect is a logical Pauli, and the channel \
is the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["4", 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1279eb8d-ef8a-5dbb-4206-02d68a3f2781"],
 " probabilities of the residue class. ",
 Cell[BoxData["cosetProbabilities"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6afb4307-9f81-9d1b-1a99-5b611a35e461"],
 " already holds ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["P", "TI"], "(", 
    RowBox[{"syndrome", ",", "class"}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e902be9-4fb4-3e90-56af-c2b36a4684fa"],
 " exactly; the decoder maps a syndrome to a class ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46e8ad28-93a4-355d-6e97-457226569fa7"],
 "; labels are linear, so an error of class ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43090fa7-5002-8b65-7136-a60161b4d64f"],
 " leaves the residue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], "\[CirclePlus]", 
    StyleBox["d", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d6689b0-bbf9-a698-3b1d-20fa3d8d0ce2"],
 ". ",
 Cell[BoxData["codeLogicalClassPaulis"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ac87485-b214-a6e0-7ac8-6deec7a60cca"],
 " names each class key by labelling a representative of every logical Pauli \
with the same ",
 Cell[BoxData["codeLabelKeys"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e1d4b5-6b25-2976-7e9e-cdff0ed0785c"],
 " the rate uses, so the naming cannot drift from the decoding. A syndrome \
the decoder does not cover is kept apart as ",
 Cell[BoxData["\"\<Undecoded\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e41722a-1026-02f0-567f-7474a1d350da"],
 " \[LongDash] exactly the part the rate counts as failure on top of the \
wrong-class part \[LongDash] so ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["I", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aacec8a-85e6-bbaa-1a53-05d4339009f0"],
 " equals the rate for every decoder, and the channel refuses to exist when \
that part is nonzero, since the cycle then leaves the code space."
}], "Text",ExpressionUUID->"1c51a735-fee5-6802-446e-3f7efa903b68"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", "[", 
      RowBox[{"QECCode", "[", "\"\<BitFlipCode\>\"", "]"}], "]"}]}], "}"}], ",",
    "\n", "    ", 
   RowBox[{
   "Wolfram`QuantumFramework`QEC`PackageScope`codeLogicalClassPaulis", "[", 
    "a", "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[117]:= ",ExpressionUUID->"5e54a15d-ecde-9aa9-066b-39068568e8f3"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"0", "\[Rule]", "\<\"I\"\>"}], ",", 
   RowBox[{"2", "\[Rule]", "\<\"Z\"\>"}], ",", 
   RowBox[{"1", "\[Rule]", "\<\"X\"\>"}], ",", 
   RowBox[{"3", "\[Rule]", "\<\"Y\"\>"}]}], "\[RightAssociation]"}]], "Output",\

 CellLabel->
  "Out[117]= ",ExpressionUUID->"27fb6428-ecec-27d4-4d99-7e75849e8d3e"]
}, Open  ]],

Cell[TextData[{
 StyleBox["The encoder is canonicalized.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData["codeEncodingGates"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51f5ca74-88a2-9d2c-078a-ec3e2954e476"],
 " is a valid encoder whose logical labelling is its own; on the five-qubit \
code its ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "0"}], "\[Ellipsis]", "0", "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1154648e-ef0b-aa2b-476c-7deb8abff971"],
 " output is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c057904-8649-af2b-743b-716e33fdf271"],
 " eigenstate of the reported ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2baf9433-2e90-ebaf-5954-0e7d4b2ab9f5"],
 ". ",
 Cell[BoxData["codeEncoderMatrix"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "340e6ec8-e38f-b030-5c35-8795963b031a"],
 " takes that output, applies ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox[
     StyleBox["X", "TI"], "_"], 
    StyleBox["j", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64bff79f-1679-3ebc-0c44-eed9a30d8486"],
 " wherever ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], "0"], "|", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["Z", "TI"], "_"], 
       StyleBox["j", "TI"]], "|", 
      SubscriptBox[
       StyleBox["v", "TI"], "0"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    
    RowBox[{"-", "1"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "126dc52b-3dd5-bd31-4212-dd75b461041b"],
 ", and generates column ",
 Cell[BoxData[
  FormBox[
   StyleBox["c", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28023c0b-10a3-7000-5831-b655a156436a"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["X", "TI"], "_"], 
     StyleBox["c", "TI"]], 
    SubscriptBox[
     RowBox[{"|", "0"}], 
     StyleBox["L", "TI"]], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f1b960d-0301-b7cd-7538-0857b6b51d17"],
 ". A test pins ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Dagger]"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], 
     StyleBox["j", "TI"]], 
    StyleBox["V", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "268b8fe7-2cf2-fa64-4e88-26c14484c94e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Dagger]"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["X", "TI"], "_"], 
     StyleBox["j", "TI"]], 
    StyleBox["V", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["X", "TI"], 
     StyleBox["j", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41763b34-5a53-ec31-770d-b37e5fe7b71b"],
 " on five codes. ",
 Cell["Encoder.wl", "InlineCode",ExpressionUUID->
  "5d61c4f4-c0fb-847a-0b1e-ddb1f08fef40"],
 " is left as it is: the circuit is still what the extraction and Stim \
consume."
}], "Text",ExpressionUUID->"72fe9a0c-0c49-239f-2285-1c56a5fc71e5"],

Cell[TextData[{
 StyleBox["Knill\[Dash]Laflamme is symplectic.",
  FontWeight->"Bold"],
 " For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["a", "TI"]], ",", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14bcbead-0cb8-f132-3c43-37f7a532c018"],
 " the product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["a", "TI"], "\[Dagger]"], 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a015340-38cc-91ca-7a3f-4b2ab97ee310"],
 " is formed as a row (",
 Cell[BoxData["pauliDagger"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44807b7f-366d-41a7-6cb0-73394318138d"],
 " conjugates the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z",
     FontSlant->"Plain"], "4"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56b5d630-2397-dc8b-7e4a-c87a5623a6d1"],
 " phase, the Hermitian part is its own adjoint); a nonzero syndrome gives 0, \
",
 Cell[BoxData["codeStabilizerElement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "066e8396-42fa-b64f-2e15-1ad0768c1c95"],
 " gives the stabilizer element with its true phase and so the entry ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["i", "TI"], 
    RowBox[{
     StyleBox["e", "TI"], "-", 
     SuperscriptBox[
      StyleBox["e", "TI"], "\[Prime]"]}]], TraditionalForm]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fee4e15-659c-ade9-3596-605f0c2ef733"],
 ", and ",
 Cell[BoxData["Missing"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f99faa1-7599-adaa-15a6-f30b7c2df7f0"],
 " from it means a nontrivial logical, reported with the pair. No ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c80f068-193e-1d5a-14bf-ea3298cb67a0"],
 " vector is formed, which is why ",
 Cell[BoxData["\"\<CorrectableQ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77601adb-bf25-4789-1d1f-93853ad02dd3"],
 " is not behind ",
 Cell[BoxData["$QECDenseQubitLimit"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48b830c7-d270-6a57-7847-a9a0e70538bd"],
 " and the encoder is."
}], "Text",ExpressionUUID->"62f1d7f5-6807-0c72-128e-cebf09b25758"],

Cell[TextData[{
 "One engine quirk is routed around rather than fixed. A one-element Kraus \
list with an order is read by ",
 Cell[BoxData["QuantumChannel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e2af966-75ba-f15e-4629-f1407c4cc3a4"],
 " as a channel whose environment wire replaces the first system wire:"
}], "Text",ExpressionUUID->"7fcb302b-9e92-9019-25c8-aa751b24e363"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumChannel", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"PauliMatrix", "[", "1", "]"}], "}"}], ",", " ", 
    RowBox[{"{", "1", "}"}]}], "]"}], "[", "\"\<Order\>\"", "]"}]], "Input",
 CellLabel->
  "In[118]:= ",ExpressionUUID->"361ba0ac-b25b-03c3-5e38-3909c7ee5129"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "1", "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[118]= ",ExpressionUUID->"36c5768f-9366-0c29-5efb-6fe926135773"]
}, Open  ]],

Cell[TextData[{
 "A unitary channel given that way acts on the wrong qubits. ",
 Cell[BoxData["krausChannel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43fcd6d4-594a-1482-7183-cf9e58ff7ee8"],
 " (in ",
 Cell["Noise.wl", "InlineCode",ExpressionUUID->
  "4719bc21-ede2-73f0-6d26-358a8b9741da"],
 ") sends a single Kraus operator through ",
 Cell[BoxData[
  RowBox[{"QuantumChannel", "[", 
   RowBox[{"QuantumOperator", "[", "\[Ellipsis]", "]"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71a147e0-ad25-39c0-275f-5ecdc4d18b2a"],
 " instead, and both the recovery and the noiseless logical channel go \
through it; two tests pin the resulting order."
}], "Text",ExpressionUUID->"0d94734f-f5fd-5b1e-3bac-6b2883882664"],

Cell[TextData[{
 "On the noise side, ",
 Cell[BoxData[
  RowBox[{"QECNoiseModel", "[", "qc", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a66d044-93ea-cfa5-7a1d-ca2e259c958f"],
 " reads a one-qubit channel back as Pauli weights, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], "\[Sigma]"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["k", "TI"],
     LimitsPositioning->True], "|", 
    StyleBox["Tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"\[Sigma]", 
      SubscriptBox[
       StyleBox["K", "TI"], 
       StyleBox["k", "TI"]]}], ")"}], 
    SuperscriptBox["|", "2"], "/", "4"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08e3a6ae-198b-2f89-3890-3f08983e75d3"],
 ", takes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["q", "TI"], 
    StyleBox["I", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07ff9e3d-196e-b566-2d84-106798181c4c"],
 " as the complement (the trace form comes back as ",
 Cell[BoxData[
  RowBox[{"Abs", "[", 
   RowBox[{"1", " ", "-", " ", "u", " ", "-", " ", "w"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7611561e-6aa4-cbf1-1e2f-48580f5699db"],
 " for symbolic weights, the complement stays a polynomial), and accepts only \
if the Pauli mixture has the channel's own superoperator."
}], "Text",ExpressionUUID->"6d91ad73-9dce-768e-1bae-453d147b5cd4"],

Cell["\<\
Decoder.wl \[LongDash] three decoders that already existed, given one head\
\>", "Section",ExpressionUUID->"6bff65fb-5d0a-196c-1985-7ca554bf6bb6"],

Cell[TextData[{
 Cell[BoxData["QECDecoder"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e58ca76-8595-5ac4-0667-ec302c20282e"],
 " adds no decoding. Its four methods delegate: ",
 Cell[BoxData["\"\<MinimumWeight\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08a91809-3406-7705-3856-9253bdb35a6f"],
 " to ",
 Cell[BoxData["codeDecoderToWeight"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47ee4125-d524-d464-6d96-588edcd6bf4e"],
 ", ",
 Cell[BoxData["\"\<MaximumLikelihood\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a0bea5a-c3ff-c671-4a08-0c07f58bad5b"],
 " to ",
 Cell[BoxData["codeCosetRepresentatives"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d2ec88d-5e53-28f6-54d5-e1d75be67adc"],
 " and ",
 Cell[BoxData["codeMaximumLikelihoodDecoder"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230fc3bf-d3e5-5aa5-5134-daf8e590288f"],
 ", ",
 Cell[BoxData["\"\<DetectorModel\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c6e076f-8b93-3c10-3415-9f492e27877a"],
 " to ",
 Cell[BoxData["demDecoderTable"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29094997-c9cb-f733-5f37-60d0e87fda19"],
 ", and ",
 Cell[BoxData["\"\<Function\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "284fc6fb-b6ce-6422-5874-dfa4c37b4f08"],
 " to whatever was passed. The rate consumes decoders as syndrome-key \
\[RightArrow] class-key tables; ",
 Cell[BoxData["decoderClassTable"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cad16aa-0a89-b805-3452-8ff4af3d0b6f"],
 " builds that table for the object, from the engine's own table for the \
built-ins and by labelling the function's corrections with ",
 Cell[BoxData["codeLabelKeys"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5640583a-c911-1fe8-7e70-5267e8a46532"],
 " for the seam, and ",
 Cell[BoxData["decoderFor"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6944803a-8297-e066-1f7b-1a643723b34c"],
 " accepts the object as its ",
 Cell[BoxData["spec"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9e495e-a796-7cd0-26a6-611bd223463a"],
 "."
}], "Text",ExpressionUUID->"534f7e63-03c8-ee33-0175-704db662b519"],

Cell[TextData[{
 "Because every method delegates, the herald filter in ",
 Cell[BoxData["demDecoderTable"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b07ad27-9e6a-154b-693c-44811b1f7f91"],
 " \[LongDash] rows a verification check rejects are not offered as \
explanations \[LongDash] is inherited rather than re-implemented, and the \
test asserts it at the table level twice: the object's table is the engine's, \
and that table differs from the one built with the heralds ignored."
}], "Text",ExpressionUUID->"1c7a415c-3e53-b7cb-441a-5906bbe71d11"],

Cell[TextData[{
 "The rate itself lost its second return type in the same step. ",
 Cell[BoxData["rateReport"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "417aec05-2fbb-8238-7719-066f4a4fd102"],
 " normalizes whatever the engine returns (a number without heralds, an \
association with) into one report shape, ",
 Cell[BoxData["rateValue"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4705486f-1ac0-4964-6d3b-62499f75184e"],
 " reads the rate off it, and the public entry points choose which of the two \
to return by whether ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3af5a034-7641-6879-6a8a-3a7e03f43b43"],
 " was passed. The detector model's ",
 Cell[BoxData["demExactReport"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68379bed-79e9-22be-19cc-12b77f9c7084"],
 " is memoised, so ",
 Cell[BoxData["\"\<LogicalErrorRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "460eb9f9-c41e-8ef4-6e35-30a2eda8d4de"],
 ", ",
 Cell[BoxData["\"\<Acceptance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "258251be-7c16-7495-53b2-48f875a35eff"],
 " and ",
 Cell[BoxData["\"\<Failure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35c1f832-722b-ca69-63fe-f27c07df98b3"],
 " cost one computation between them."
}], "Text",ExpressionUUID->"7b6a50da-eb07-3910-296a-49878eb3887a"],

Cell["Deprecated.wl \[LongDash] the names that were retired", "Section",ExpressionUUID->"23591dbb-79d4-ec10-5166-94e57866b77a"],

Cell[TextData[{
 "Ten names were retired in step 5 of the redesign: the six ",
 Cell[BoxData[
  RowBox[{"QECPauli", "*"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "114fd905-c79d-9420-4774-d16ef229ff0a"],
 " verbs (now ",
 Cell[BoxData["QECPauli"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0047a90f-9cb0-808d-307c-4169154ad2d7"],
 "'s properties, with the verbs themselves as ",
 Cell[BoxData["PackageScope"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42e32fd7-26e6-6b71-7290-c6915293365b"],
 " row functions under their old definitions), ",
 Cell[BoxData["QECFaultTolerant"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a2652ed-88d4-efb2-7bde-4bb72966b598"],
 ", ",
 Cell[BoxData["QECStimCircuit"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0962d9db-7466-8598-3f11-d0857d10efe2"],
 ", ",
 Cell[BoxData["QECCodeCatalog"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b3d557b-19e1-b503-0ac3-4d259f951c69"],
 ", ",
 Cell[BoxData["QECClassicalHammingMatrix"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "529c5c95-0588-d8f1-02a4-55dfac22aadb"],
 ". Each alias calls the function that now does the job and warns once per \
session through ",
 Cell[BoxData[
  RowBox[{"General", "::", "qecdeprecated"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18bedc4a-f6ca-97e0-4845-d617837cfdca"],
 "; the set of warned names is reset on every load, which is what makes the \
warning testable in every test file that reloads the package. The file goes \
one release after the rename."
}], "Text",ExpressionUUID->"5f18273e-5cf5-00f5-0527-bf78548052df"],

Cell["Where this comes from", "Section",ExpressionUUID->"1890d11b-851d-d227-48af-c9452ca9a10d"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5b8be800-baff-aedd-0988-026a3e8bf427"], Cell["claim", "TableText",
     FontWeight->Bold,ExpressionUUID->"224fae0e-4768-b263-5274-406872020149"],
     Cell["source", "TableText",
     FontWeight->Bold,ExpressionUUID->"3d32ba1d-71ed-60b8-64c1-3c4707983282"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3ccd4f42-4869-4b08-64f3-672c691c1652"], Cell[
    "one ancilla per check, and that it is not fault tolerant", "TableText",
     ExpressionUUID->"0cf63df4-f608-7ba6-348d-b4b183bd498c"], Cell[TextData[{
     "Gottesman, ",
     StyleBox["Stabilizer Codes and Quantum Error Correction", "TI"],
     ", sec. 12.1.1, fig. 12.1a-b"
    }], "TableText",ExpressionUUID->"60948258-d69f-7f2c-10ab-2405e32a4276"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5bf5c13c-8c81-f0bf-098a-d9662535c285"], Cell[
    "using it anyway, as the surface-code community does", "TableText",
     ExpressionUUID->"27ebc314-3813-af61-4de8-db5eb9a7f24b"], Cell[
    "ibid., sec. 12.5.1", "TableText",ExpressionUUID->
     "59cd495b-92f8-de82-0ff3-61052772a4e8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1597811c-d04f-58d0-43ac-1959e1fa2a3a"], Cell[
    "the Pauli frame", "TableText",ExpressionUUID->
     "0d69ae9d-d0a3-a5e3-3b16-47c6e1570fc9"], Cell[
    "ibid., sec. 12.5.2", "TableText",ExpressionUUID->
     "1e10fbdd-fcac-b923-462f-f286f55e0809"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "68c26b95-e958-d351-18f1-82de88d2a1bb"], Cell[
    "locations, faults and one rate per location type", "TableText",
     ExpressionUUID->"56b7d10b-4c3b-5ee0-7e4c-c95565ce24ca"], Cell[
    "ibid., sec. 10.1.1, Definitions 10.1-10.3", "TableText",ExpressionUUID->
     "40ed67f4-ffa0-5cce-7093-7eb1fa552614"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4dc0df98-8a2c-0889-7bff-d6c22fd95ad3"], Cell[
    "repeat-and-agree as the book's answer to noisy syndromes", "TableText",
     ExpressionUUID->"2226f602-e60c-c55a-53dd-e86f93beafa0"], Cell[
    "ibid., sec. 12.2.2, 12.2.3", "TableText",ExpressionUUID->
     "4ed808ee-885a-0ea1-76e7-a1c829ef548b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1627cdbb-2852-50d0-3fdc-e4e549e7223a"], Cell[
    "differencing set aside as hard to analyse in general", "TableText",
     ExpressionUUID->"6801141d-c5dc-e96b-183e-8e46ec6ebbb1"], Cell[
    "ibid., sec. 12.2.2", "TableText",ExpressionUUID->
     "2fb5e010-3b47-28f4-554a-fa5abef27ade"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "69461d9a-9714-a717-1f7d-94c422a60a7d"], Cell["\<\
ancilla reuse via reset, and the residual as a preparation error\
\>", "TableText",ExpressionUUID->"1b3cd9b2-b2f5-0832-4ac3-d0ffc6805b18"], 
    Cell["ibid., sec. 15.4, 15.4.3", "TableText",ExpressionUUID->
     "17254721-59fc-dba5-3edb-5e8b5f8ea98f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "52d6b4d2-7b23-95d3-02ed-2d9c7ed7ff39"], Cell[TextData[{
     "parallelism is required for a threshold; ill-defined time steps are ",
     StyleBox["defined", "TI"],
     ", not dropped"
    }], "TableText",ExpressionUUID->"133f88c9-4e43-c7a8-42c4-21936bf7adf2"], 
    Cell["ibid., sec. 15.5.1, 15.5.2", "TableText",ExpressionUUID->
     "525bf512-066b-f79b-0278-ed5cb31fdde1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7020b0a8-e1ec-de26-21df-29f5979ea50c"], Cell["\<\
waiting is a fault location alongside preparation, gate and measurement\
\>", "TableText",ExpressionUUID->"6f4e56ea-c348-0e14-1576-4fb7f6fd557e"], 
    Cell["ibid., sec. 10.1.1, Definition 10.1", "TableText",ExpressionUUID->
     "2c7820da-3afe-8c15-5407-b984be88d77f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "491026a6-dd30-329c-7f2f-bf03d4ca80e6"], Cell[
    "detectors as differences of consecutive syndromes", "TableText",
     ExpressionUUID->"78f9e5c0-5bc5-e73b-2886-fcaa5e71ca01"], Cell[TextData[{
     "Dennis, Kitaev, Landahl, Preskill, ",
     StyleBox["Topological quantum memory", "TI"],
     ", arXiv:quant-ph/0110143"
    }], "TableText",ExpressionUUID->"295a1104-8f0a-9295-5f79-896e2abce0ff"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "34e49fcf-314b-942d-5c9b-16a940ffff77"], Cell["\<\
the detector error model as an object with an error model attached\
\>", "TableText",ExpressionUUID->"28081ee1-9923-6846-5837-97cb18d63aac"], 
    Cell[TextData[{
     "Gidney, ",
     StyleBox["Stim: a fast stabilizer circuit simulator", "TI"],
     ", Quantum 5, 497 (2021), arXiv:2103.02202"
    }], "TableText",ExpressionUUID->"35d104ab-d16d-b332-63ee-9df4e0191e18"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4f8fdcfc-c987-8804-75b4-d5b9e833db6e"], Cell[
    "the tableau engine underneath", "TableText",ExpressionUUID->
     "4bb02784-750c-cc73-794f-beee7cbe9759"], Cell["\<\
Aaronson, Gottesman, Phys. Rev. A 70, 052328 (2004), arXiv:quant-ph/0406196\
\>", "TableText",ExpressionUUID->"6368bf1a-89ab-f709-1117-3744285fda53"]}
  }]], "2ColumnTableMod",ExpressionUUID->"18aa8291-c565-6e81-48a9-1bdaec1034eb"],

Cell[CellGroupData[{

Cell["Related Guides", "TutorialMoreAboutSection",
 CellChangeTimes->{{3.843042384656711*^9, 3.843042386024461*^9}},
 CellID->23220180,ExpressionUUID->"0fb37437-3ad9-e813-3541-6e71bf6dbb79"],

Cell[TextData[Cell[BoxData[
 TemplateBox[{
   Cell[
    TextData["WolframQuantumComputationFramework"]], 
   "paclet:Wolfram/QuantumFramework/guide/WolframQuantumComputationFramework"},
  "RefLinkPlain",
  BaseStyle->{
