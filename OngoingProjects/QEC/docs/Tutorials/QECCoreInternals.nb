Cell["\<\
Code capacity is refused, because Stim has no notion of a model whose checks \
are perfect by assumption:\
\>", "Text",ExpressionUUID->"62016b94-8ad8-fb56-123e-82de2f52c9bc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QECStim", "[", 
  RowBox[{"bitFlip", ",", " ", 
   RowBox[{"QECNoiseModel", "[", 
    RowBox[{"\"\<BitFlip\>\"", ",", " ", "0.01"}], "]"}]}], "]"}]], "Input",
 CellLabel->
