    RowBox[{"codeData", "[", "bitFlip", "]"}], "]"}], ",", "\n", " ", 
   RowBox[{"codeDistanceF", "[", 
    RowBox[{"codeData", "[", "bitFlip", "]"}], "]"}], ",", " ", 
   RowBox[{"Dimensions", "[", 
    RowBox[{"codeLabelMatrix", "[", 
