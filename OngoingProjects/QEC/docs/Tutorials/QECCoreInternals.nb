      RowBox[{"\"\<BitFlip\>\"", ",", " ", "p"}], "]"}]}], "]"}], " ", "==", 
   "\n", "    ", 
   RowBox[{"QECLogicalErrorRate", "[", 
    RowBox[{"bitFlip", ",", " ", 
     RowBox[{"QECNoiseModel", "[", 
      RowBox[{"\"\<BitFlip\>\"", ",", " ", "p", ",", " ", 
       RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "0"}]}], "]"}], ",",
      "\n", "        ", 
     RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], "\n", 
  "]"}]], "Input",
 CellLabel->
