}, Open  ]],

Cell[TextData[{
 "An ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b734859-75e7-efa6-7901-62030393b58c"],
 " on data qubit 1 fires the checks it anticommutes with, and flips nothing \
logical."
}], "Text",ExpressionUUID->"4ae31c17-eefa-a706-7a90-96508a8c0a6c"],

Cell[TextData[{
 "Now a ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00844d77-2817-3ec6-30bc-653149a3842c"],
 " on the same qubit. It is invisible to a bit-flip code's checks \[LongDash] \
but it ",
 StyleBox["is", "TI"],
 " a logical:"
}], "Text",ExpressionUUID->"20b97f64-b973-0c8a-5047-774e380656d0"],

