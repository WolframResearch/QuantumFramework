Cell["The accessors that the rest of the layer dispatches on:", "Text",ExpressionUUID->"4139b36b-52b1-2977-70c6-2b356744785d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"noiseLevel", "[", 
    RowBox[{"First", "[", "nCap", "]"}], "]"}], ",", " ", 
   RowBox[{"noiseLevel", "[", 
