  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbaaaf7-1388-e538-4b59-43b1a622cc02"],
 " property."
}], "Text",ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell[TextData[{
 "Two codes carry the page. The bit-flip code is small enough for every exact \
route; the five-qubit code has generators carrying ",
 Cell[BoxData[
  FormBox[
   StyleBox["Y", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04646437-faee-7dfc-2c1c-7e70fe9b47c6"],
 ", so it exercises the ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbde497-e826-5557-4442-fdd089d33fbd"],
 " basis change:"
}], "Text",ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell[CellGroupData[{

