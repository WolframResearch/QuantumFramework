     RowBox[{"First", "[", 
      RowBox[{"QECNoiseModel", "[", 
       RowBox[{"\"\<Circuit\>\"", ",", " ", "0.01"}], "]"}], "]"}], ",", " ", 
     "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"demSampled", "[", 
    RowBox[{"aN", ",", " ", "200000", ",", " ", "2"}], "]"}], ",", " ", 
   RowBox[{"N", "[", 
    RowBox[{"Simplify", "[", 
     RowBox[{"demExactFailure", "[", 
      RowBox[{"aN", ",", " ", "2"}], "]"}], "]"}], "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[64]:= ",ExpressionUUID->"4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],

