Cell["Where this comes from", "Section",ExpressionUUID->"30f601cf-5001-fb68-608d-98a961b5c9b2"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "04bc0f0b-f02f-243d-2c43-a75481db8f07"], Cell["claim", "TableText",
     FontWeight->Bold,ExpressionUUID->"1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],
     Cell["source", "TableText",
     FontWeight->Bold,ExpressionUUID->"705e212e-f5a4-7717-2065-b88bfc515a7d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5c2f5325-a3f6-c048-05d5-4a8ed5809292"], Cell[
    "one ancilla per check, and that it is not fault tolerant", "TableText",
     ExpressionUUID->"211ecaf2-61ee-418f-5725-e3bc179b13d5"], Cell[TextData[{
     "Gottesman, ",
     StyleBox["Stabilizer Codes and Quantum Error Correction", "TI"],
     ", sec. 12.1.1, fig. 12.1a-b"
    }], "TableText",ExpressionUUID->"51e4dffc-d38f-5703-079b-d6b9e63a3a69"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "30e43b5d-74af-d0fb-609b-b3077d5ba2c1"], Cell[
    "using it anyway, as the surface-code community does", "TableText",
     ExpressionUUID->"44d9380c-2e05-8f35-6ce6-b2564bb1d21f"], Cell[
    "ibid., sec. 12.5.1", "TableText",ExpressionUUID->
     "36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "138e1639-4d05-8b97-41b5-886364b1d9fd"], Cell[
    "the Pauli frame", "TableText",ExpressionUUID->
     "156728ce-0023-e03b-431c-c1a8b1d7b301"], Cell[
    "ibid., sec. 12.5.2", "TableText",ExpressionUUID->
     "7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "26ff5c08-e081-ff27-4e85-56559135c20d"], Cell[
    "locations, faults and one rate per location type", "TableText",
     ExpressionUUID->"07c988c4-3ef2-8066-2df6-21aeba84d34c"], Cell[
    "ibid., sec. 10.1.1, Definitions 10.1-10.3", "TableText",ExpressionUUID->
     "4bc0a2f3-6150-447f-79ff-3bbd10e52f45"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7ac66077-3bfa-1f18-2afe-7a31bd8f6262"], Cell[
    "repeat-and-agree as the book's answer to noisy syndromes", "TableText",
     ExpressionUUID->"3d863d84-94ab-5643-6bbd-b4ee1d5e3ca9"], Cell[
    "ibid., sec. 12.2.2, 12.2.3", "TableText",ExpressionUUID->
     "7ab8b877-e011-189c-2a47-323091a46ae6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "35eb0178-2238-e094-63e8-992257b2b2fe"], Cell[
    "differencing set aside as hard to analyse in general", "TableText",
     ExpressionUUID->"0da6433d-a7a4-ba24-3b5e-5b66d256090e"], Cell[
    "ibid., sec. 12.2.2", "TableText",ExpressionUUID->
     "462f64f6-435d-c7dd-6fd5-7db076e9ad27"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4b06bf63-5f43-ed7c-793d-374d5af7b446"], Cell["\<\
ancilla reuse via reset, and the residual as a preparation error\
\>", "TableText",ExpressionUUID->"0fd1c247-21a4-d962-35ee-e4215056a848"], 
    Cell["ibid., sec. 15.4, 15.4.3", "TableText",ExpressionUUID->
     "09347675-9fce-c17b-38cc-683f1a789041"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2c597ed5-00d9-d535-5467-779fb16dbc1f"], Cell[TextData[{
     "parallelism is required for a threshold; ill-defined time steps are ",
     StyleBox["defined", "TI"],
     ", not dropped"
    }], "TableText",ExpressionUUID->"66c4d8d6-27c8-a0db-0efb-d1905262f221"], 
    Cell["ibid., sec. 15.5.1, 15.5.2", "TableText",ExpressionUUID->
     "4d3801b6-8b23-0df3-74c7-98f02ed657d9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "09816d05-11e9-fb6e-3fbe-856fa79dc9b4"], Cell["\<\
waiting is a fault location alongside preparation, gate and measurement\
\>", "TableText",ExpressionUUID->"35ec423d-cde2-7917-6394-6466eb97487d"], 
    Cell["ibid., sec. 10.1.1, Definition 10.1", "TableText",ExpressionUUID->
     "05e0e9bc-56b1-1bf2-339f-00e6634469d8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "46408f14-a324-388b-6e7f-2751d6d68ad1"], Cell[
    "detectors as differences of consecutive syndromes", "TableText",
     ExpressionUUID->"40213c85-9219-7c2b-71de-b5ef27ac4771"], Cell[TextData[{
     "Dennis, Kitaev, Landahl, Preskill, ",
     StyleBox["Topological quantum memory", "TI"],
     ", arXiv:quant-ph/0110143"
    }], "TableText",ExpressionUUID->"678faed4-2cca-f411-0db4-479e457cdf7b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3b3cac94-919f-f08d-6ac3-45de202bc2d7"], Cell["\<\
the detector error model as an object with an error model attached\
\>", "TableText",ExpressionUUID->"634a1270-2707-566e-1149-943a52b23cb4"], 
    Cell[TextData[{
     "Gidney, ",
     StyleBox["Stim: a fast stabilizer circuit simulator", "TI"],
     ", Quantum 5, 497 (2021), arXiv:2103.02202"
    }], "TableText",ExpressionUUID->"571f0194-b08e-3ab4-7d24-98d1c138889e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "79764466-e076-5945-2f0e-5e4391032baf"], Cell[
    "the tableau engine underneath", "TableText",ExpressionUUID->
     "54e8dec7-14b1-519a-7c97-d7a19d4423e0"], Cell["\<\
Aaronson, Gottesman, Phys. Rev. A 70, 052328 (2004), arXiv:quant-ph/0406196\
\>", "TableText",ExpressionUUID->"25f5c72f-3423-741a-538a-de89bdd65f60"]}
  }]], "2ColumnTableMod",ExpressionUUID->"6dbbd446-5835-e39a-1b58-ce2059c1b1e0"],

