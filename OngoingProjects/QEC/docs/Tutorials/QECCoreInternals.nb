Cell[TextData[{
 "Phases never enter: the frame's contribution to an outcome is whether it \
anticommutes with the measured ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539491e8-328f-8d7b-01ab-08b2473bd441"],
 ", which is the ancilla's ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],
 " bit."
}], "Text",ExpressionUUID->"023f49e2-a747-9723-33c5-60cfd2f3fa09"],

