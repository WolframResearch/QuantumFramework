      "\n", "    ", 
     RowBox[{"\"\<Observable\>\"", " ", "->", " ", "\"\<X\>\""}]}], "]"}], ",",
    " ", 
   RowBox[{"-", "60"}]}], "]"}]], "Input",
 CellLabel->
  "In[78]:= ",ExpressionUUID->"62c8f42b-c628-388a-12f7-ee74f3c28ad0"],

