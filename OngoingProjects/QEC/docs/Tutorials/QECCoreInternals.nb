Cell["The consistency identity", "Subsection",ExpressionUUID->"5b82e386-6ff5-c0ee-09b1-fae009819234"],

Cell[TextData[{
 "A phenomenological model with perfect readout over one round ",
 StyleBox["is", "TI"],
 " code-capacity noise. Two completely different code paths \[LongDash] \
enumeration over cosets, and a fold over detectors \[LongDash] therefore have \
to produce the same polynomial:"
}], "Text",ExpressionUUID->"34a39a2f-b372-ffce-5c50-1388c604c514"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"QECLogicalErrorRate", "[", 
    RowBox[{"bitFlip", ",", " ", 
     RowBox[{"QECNoiseModel", "[", 
      RowBox[{"\"\<BitFlip\>\"", ",", " ", "p"}], "]"}]}], "]"}], " ", "==", 
   "\n", "    ", 
   RowBox[{"QECLogicalErrorRate", "[", 
    RowBox[{"bitFlip", ",", " ", 
     RowBox[{"QECNoiseModel", "[", 
      RowBox[{"\"\<BitFlip\>\"", ",", " ", "p", ",", " ", 
       RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "0"}]}], "]"}], ",",
      "\n", "        ", 
     RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], "\n", 
  "]"}]], "Input",
 CellLabel->
  "In[68]:= ",ExpressionUUID->"66ca9132-7812-8248-0ec9-097c79a4d092"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[68]= ",ExpressionUUID->"023b1c4a-5b09-a8c9-33d8-96145ebdfa13"]
}, Open  ]],

