Cell["\<\
With no faults, every ancilla reads 0 and the data frame is empty. That is \
what makes a detector \"deterministically zero when nothing goes wrong\":\
\>", "Text",ExpressionUUID->"7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"framePropagate", "[", 
  RowBox[{
   RowBox[{"circ", "[", "\"\<Instructions\>\"", "]"}], ",", " ", 
   RowBox[{"circ", "[", "\"\<Qubits\>\"", "]"}], ",", " ", 
   RowBox[{"{", "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"],

