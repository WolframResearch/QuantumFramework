      RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}]},
    {"2", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "1", ",", "0"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1", ",", "0", ",", "0"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0", ",", "0"}], "}"}]},
    {"3", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "1", ",", "0"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "1", ",", "0"}], "}"}]},
    {"4", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellLabel->
  "Out[24]= ",ExpressionUUID->"6af863a9-1098-c609-1a98-7af3a112ad53"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["XZZXI"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "055bc2ad-6b92-a3be-3378-dbf70e24f184"],
 " leaves ",
 Cell[BoxData["IZZXI"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0fb60e-2211-365f-5934-286857a59ca5"],
 ", ",
 Cell[BoxData["IIZXI"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "201a2509-bdd9-2fa1-5039-bd53346c758b"],
 " or ",
 Cell[BoxData["IIIXI"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 " depending on where the fault struck \[LongDash] and being a sub-product of \
the generator, it does ",
 StyleBox["not",
  FontWeight->"Bold"],
 " fire that generator's own check in that round. A ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f932952-49a5-d34f-05a0-c11c6851a195"],
 " before the first CNOT leaves the whole generator, which is a stabilizer \
and harmless; a ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "160f17c4-d31a-fe19-3e34-8ea1e6acc563"],
 " after the last leaves nothing. Only mid-ladder hurts."
}], "Text",ExpressionUUID->"10beb8bd-bdb6-ee93-4045-31e73440b4f9"],

Cell[TextData[{
 "This is what turns a distance-three code's logical error rate from order ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fdc991b-fead-14b0-65e3-1144fb587e9a"],
 " into order ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],
 ", and it is a defect of the ",
 StyleBox["gadget", "TI"],
 ", not a property of circuit-level noise. A gadget satisfying the book's \
gate and error-correction propagation properties keeps the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0642d375-09f3-9942-2e71-cb3faf87eba8"],
 "."
}], "Text",ExpressionUUID->"0651775d-2bad-791b-2e6f-6f074e584861"],

Cell["The schedule, and idling", "Subsection",ExpressionUUID->"63b9e3d6-2298-231e-1146-fa9057128e64"],

Cell[TextData[{
 "The instruction list is flat and sequential. The ",
 StyleBox["circuit", "TI"],
 " is not: two instructions on disjoint qubits happen in the same time step. ",
 Cell[BoxData["circuitSchedule"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67c13665-f813-2f11-0dfe-a84ef9a6727b"],
 " recovers those layers from the flat list by ASAP list scheduling \
\[LongDash] each instruction goes into the earliest layer in which none of \
its qubits is already busy:"
}], "Text",ExpressionUUID->"4c440104-ea8a-4285-747b-99618f3f10ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"circ", "[", "\"\<Instructions\>\"", "]"}], "]"}], ",", " ", 
   RowBox[{"Length", "[", 
    RowBox[{"circuitSchedule", "[", 
     RowBox[{
      RowBox[{"circ", "[", "\"\<Instructions\>\"", "]"}], ",", " ", 
      RowBox[{"circ", "[", "\"\<Qubits\>\"", "]"}]}], "]"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"66c9a615-af45-c085-0ef6-385ecaf192ef"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"40", ",", "13"}], "}"}]], "Output",
 CellLabel->
  "Out[25]= ",ExpressionUUID->"0513e607-0f4c-1e20-3320-f861aaf9650a"]
}, Open  ]],

Cell[TextData[{
 "The schedule is ",
 StyleBox["derived", "TI"],
 ", never stored. The instruction list stays canonical, so every consumer \
that does not care about time \[LongDash] the frame propagator, the Stim \
writer, the tests \[LongDash] is untouched. What it is for is the fourth kind \
of fault location: a qubit that no instruction of a layer touches is ",
 StyleBox["waiting",
  FontWeight->"Bold"],
 ", and waiting is a location in its own right. Section 10.1.1's Definition \
10.1 lists preparation, gate, ",
 StyleBox["wait", "TI"],
 " and measurement."
}], "Text",ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bfCirc", " ", "=", " ", 
   RowBox[{"QECSyndromeCircuit", "[", "bitFlip", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bfLayers", " ", "=", " ", 
   RowBox[{"circuitSchedule", "[", 
    RowBox[{
     RowBox[{"bfCirc", "[", "\"\<Instructions\>\"", "]"}], ",", " ", 
     RowBox[{"bfCirc", "[", "\"\<Qubits\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"Prepend", "[", "\n", "        ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", " ", 
         RowBox[{"bfLayers", "[", 
          RowBox[{"[", "L", "]"}], "]"}], ",", " ", 
         RowBox[{"circuitIdleQubits", "[", 
          RowBox[{
           RowBox[{"bfCirc", "[", "\"\<Instructions\>\"", "]"}], ",", " ", 
           "5", ",", " ", 
           RowBox[{"bfLayers", "[", 
            RowBox[{"[", "L", "]"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
       "            ", 
       RowBox[{"{", 
        RowBox[{"L", ",", " ", 
         RowBox[{"Length", "[", "bfLayers", "]"}]}], "}"}]}], "]"}], ",", 
     "\n", "        ", 
     RowBox[{"{", 
      RowBox[{"\"\<layer\>\"", ",", " ", "\"\<instructions\>\"", ",", 
       " ", "\"\<waiting\>\""}], "}"}]}], "]"}], ",", "\n", "    ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"6833ae6a-6ac5-a2c8-19c0-40340f71f012"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"layer\"\>", "\<\"instructions\"\>", "\<\"waiting\"\>"},
