Cell[TextData[{
 "What repetition does ",
 StyleBox["not",
  FontWeight->"Bold"],
 " fix is the honest boundary. If the codeword carries an error ",
 Cell[BoxData[
  FormBox[
   StyleBox["E", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6c313b-6800-4a9b-2b13-a96509b518e1"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["E", "TI"], 
    StyleBox["P", "TI"], "\[LongEqual]", "-", 
    StyleBox["P", "TI"], 
    StyleBox["E", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75dfb56b-bb47-a02b-23e4-2d353ef3f371"],
 ", every repetition reads the flipped eigenvalue and the majority is \
confidently wrong \[LongDash] \"no matter how many times we repeat it\". \
Compare a fault inside one repetition against a data error that anticommutes \
with ",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57533ce7-69d6-be0e-7d60-b5c108600554"],
 ":"
}], "Text",ExpressionUUID->"27c3fefb-2ee6-8038-4df0-f7a54a90d302"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"parities", "[", 
     RowBox[{"m_", ",", " ", "f_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Mod", "[", 
     RowBox[{
      RowBox[{"Total", " ", "/@", " ", 
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"framePropagate", "[", 
           RowBox[{
            RowBox[{"m", "[", "\"\<Instructions\>\"", "]"}], ",", " ", 
            RowBox[{"m", "[", "\"\<Qubits\>\"", "]"}], ",", " ", "f"}], "]"}],
           "[", "\"\<Record\>\"", "]"}], ",", " ", 
         RowBox[{"m", "[", "\"\<Weight\>\"", "]"}]}], "]"}]}], ",", " ", 
      "2"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"i", " ", "=", " ", 
     RowBox[{
      RowBox[{"FirstPosition", "[", 
       RowBox[{
        RowBox[{"mz", "[", "\"\<Instructions\>\"", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<M\>\"", ",", " ", "6"}], "}"}]}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"parities", "[", 
      RowBox[{"mz", ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"i", " ", "-", " ", "1"}], ",", " ", "6", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}], "}"}]}], "]"}], ",", 
     " ", 
     RowBox[{"parities", "[", 
      RowBox[{"mz", ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}], "}"}]}], "]"}], ",", 
     " ", 
     RowBox[{"parities", "[", 
      RowBox[{"mz", ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]}], "Input",
 CellLabel->
  "In[92]:= ",ExpressionUUID->"60d4995f-bb7f-b80c-10eb-11193e0b0b56"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[92]= ",ExpressionUUID->"64608bbe-760c-8af3-0c1f-22f803bed8d9"]
}, Open  ]],

Cell["\<\
One repetition lost, majority intact; every repetition lost, majority wrong; \
and a commuting error invisible, as it should be. That middle column is why \
Theorem 12.1 needs error correction interspersed and not just more \
repetitions.\
\>", "Text",ExpressionUUID->"09661063-a2cf-675e-3f1d-8a4cd77a4da4"],

Cell["\<\
ErrorCorrection.wl \[LongDash] Steane EC, and why it is the one that fits\
\>", "Section",ExpressionUUID->"5561d787-26b0-8d0a-031e-cee1534ad450"],

Cell["\<\
Section 12.3 opens on cost: Shor EC \"involves a lot of locations. Lots of \
locations means lots of opportunities for errors, which eventually will \
translate into a lousy threshold.\" Steane EC moves that work into preparing \
the ancilla, and the asymmetry that licenses it is the idea of the whole \
chapter \[LongDash] an ancilla can be checked and a data block cannot, \"the \
reason is that we know the precise ancilla state that we are trying to \
create, but the state of the logical qubits somewhere in the middle of a long \
computation is unknown\".\
\>", "Text",ExpressionUUID->"0fea91e8-e80e-a1ed-35e9-08b589b8f337"],

Cell["\<\
It is CSS-only, and for a reason rather than by restriction: the construction \
runs on transversal CNOT being the logical CNOT.\
\>", "Text",ExpressionUUID->"37725419-c8bf-c4cd-5d02-4e42e94bae17"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "steaneRegions", ",", " ", "steaneWeights", ",", " ", "logicalWires", ",",
       " ", "encZero", ",", " ", "encPlus", ",", " ", "applyGates"}], "}"}], 
    " ", "=", "\n", "    ", 
    RowBox[{"sym", " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<steaneRegions\>\"", ",", 
       " ", "\"\<steaneResidualWeights\>\"", ",", 
       " ", "\"\<codeLogicalWires\>\"", ",", "\n", 
       "            ", "\"\<codeEncodedZeroInstructions\>\"", ",", 
       " ", "\"\<codeEncodedPlusInstructions\>\"", ",", 
       " ", "\"\<applyGates\>\""}], "}"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"ec", " ", "=", " ", 
