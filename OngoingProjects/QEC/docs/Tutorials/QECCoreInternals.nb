Cell[TextData[{
 "The leading term is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    StyleBox["p", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087ffcf6-194e-431e-3804-f5b098fb2e64"],
 ", not ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    SuperscriptBox[
     StyleBox["p", "TI"], "2"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "615fadf7-df9a-5675-1764-44b0da2f3d5f"],
 ". That is the hook error from the top of the page, priced. And it is the ",
 StyleBox["gadget", "TI"],
 " that costs the distance, not the noise level: a fault-tolerant extraction \
under the same circuit-level noise would keep the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"],
 "."
}], "Text",ExpressionUUID->"2d0df906-1ebb-1081-5b32-f1609b4e62eb"],

Cell["A duality that survives one level and breaks at the next", "Subsection",ExpressionUUID->"519a4e0d-3467-bfb9-07ba-6057bd130583"],

Cell["\<\
The bit-flip and phase-flip codes are related by a Hadamard on every qubit, \
so at code capacity with the dual channel they give the same polynomial. At \
circuit level they do not:\
\>", "Text",ExpressionUUID->"3a891815-8c00-cf41-6ab6-925f25ba95ab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{"bitFlip", ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Circuit\>\"", ",", " ", "p"}], "]"}], ",", " ", 
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], ",", "\n", 
   " ", 
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<PhaseFlipCode\>\"", "]"}], ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Circuit\>\"", ",", " ", "p"}], "]"}], ",", "\n", "    ", 
       
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->
  "In[71]:= ",ExpressionUUID->"0dbacffa-31b0-43f6-3b59-e6a4404511dc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   InterpretationBox[
    RowBox[{
     FractionBox[
      RowBox[{"32", " ", "p"}], "15"], "+", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "p", "]"}], "2"],
      SeriesData[MTNB$1b05aspkyfqlm`p, 0, {}, 1, 2, 1],
      Editable->False]}],
    SeriesData[MTNB$1b05aspkyfqlm`p, 0, {
      Rational[32, 15]}, 1, 2, 1],
    Editable->False], ",", 
   InterpretationBox[
    RowBox[{
     FractionBox[
      RowBox[{"112", " ", "p"}], "15"], "+", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "p", "]"}], "2"],
      SeriesData[MTNB$1b05aspkyfqlm`p, 0, {}, 1, 2, 1],
      Editable->False]}],
    SeriesData[MTNB$1b05aspkyfqlm`p, 0, {
      Rational[112, 15]}, 1, 2, 1],
    Editable->False]}], "}"}]], "Output",
 CellLabel->
  "Out[71]= ",ExpressionUUID->"196a859c-b643-c1b3-4f69-1cd9c3f79399"]
}, Open  ]],

Cell[TextData[{
 "The whole difference is that the ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c8a383-1e42-ef31-78f7-3aed9bf4b21b"],
 "-type checks need eight extra Hadamards. Switch off one-qubit-gate noise \
and the duality comes back:"
}], "Text",ExpressionUUID->"50735439-04fd-dee7-0001-4e63ac89a4cd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nNoGates", " ", "=", " ", 
   RowBox[{"QECNoiseModel", "[", 
    RowBox[{"\"\<Circuit\>\"", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<TwoQubit\>\"", " ", "->", " ", "p"}], ",", " ", 
       RowBox[{"\"\<Measurement\>\"", " ", "->", " ", "p"}], ",", " ", 
       RowBox[{"\"\<Reset\>\"", " ", "->", " ", "p"}]}], "|>"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{"bitFlip", ",", " ", "nNoGates", ",", " ", 
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], ",", "\n", 
   " ", 
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<PhaseFlipCode\>\"", "]"}], ",", " ", 
       "nNoGates", ",", " ", 
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->
  "In[72]:= ",ExpressionUUID->"3597ba8d-914b-928f-63ac-33d720ffe0d5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   InterpretationBox[
    RowBox[{
     FractionBox[
      RowBox[{"32", " ", "p"}], "15"], "+", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "p", "]"}], "2"],
      SeriesData[MTNB$1b05aspkyfqlm`p, 0, {}, 1, 2, 1],
      Editable->False]}],
    SeriesData[MTNB$1b05aspkyfqlm`p, 0, {
      Rational[32, 15]}, 1, 2, 1],
    Editable->False], ",", 
   InterpretationBox[
    RowBox[{
     FractionBox[
      RowBox[{"32", " ", "p"}], "15"], "+", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "p", "]"}], "2"],
      SeriesData[MTNB$1b05aspkyfqlm`p, 0, {}, 1, 2, 1],
      Editable->False]}],
    SeriesData[MTNB$1b05aspkyfqlm`p, 0, {
      Rational[32, 15]}, 1, 2, 1],
    Editable->False]}], "}"}]], "Output",
 CellLabel->
  "Out[72]= ",ExpressionUUID->"056fda38-a5bc-2884-3314-dc65cc497aee"]
}, Open  ]],

Cell["\<\
That is a statement about a circuit, not about a code, and it is awkward to \
make any other way.\
\>", "Text",ExpressionUUID->"383c4a9f-130c-f8c1-69c4-63d9a6beca2b"],

Cell["\<\
Sampling, when the state space is too large or the rates are numeric anyway:\
\>", "Text",ExpressionUUID->"7b649e79-a2e1-7610-291b-1022d6945d7a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QECLogicalErrorRate", "[", 
  RowBox[{"bitFlip", ",", " ", 
   RowBox[{"QECNoiseModel", "[", 
    RowBox[{"\"\<Circuit\>\"", ",", " ", "0.01"}], "]"}], ",", " ", "100000", 
   ",", " ", 
   RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]], "Input",
 CellLabel->
  "In[73]:= ",ExpressionUUID->"09cb884c-5fc8-b209-3fc8-22165a620153"],

Cell[BoxData["0.02206`"], "Output",
 CellLabel->
  "Out[73]= ",ExpressionUUID->"376c6589-bcca-29e8-5d14-7cd3357f7b32"]
}, Open  ]],

Cell["Stim.wl \[LongDash] the bridge", "Section",ExpressionUUID->"667bb688-7420-22c7-0e18-2fd27dd5702d"],

Cell["\<\
Stim is the community's reference stabilizer simulator, and the plan is \
explicit that we connect to it rather than compete with it: it samples fast \
and large, this layer derives exactly and symbolically. Writing the memory \
experiment out in its syntax buys an independent check on everything above, \
and a path to the decoders built on top of it.\
\>", "Text",ExpressionUUID->"72002252-da4c-5210-223f-c41fdff9217a"],

Cell["The gate map:", "Text",ExpressionUUID->"084561a7-5440-aaee-387b-78015dfaf834"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"stimGateName", " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{"\"\<H\>\"", ",", " ", "\"\<S\>\"", ",", " ", "\"\<V\>\"", ",", 
    " ", "\"\<Vdg\>\"", ",", " ", "\"\<CNOT\>\"", ",", " ", "\"\<CZ\>\"", ",",
     " ", "\"\<SWAP\>\"", ",", " ", "\"\<T\>\""}], "}"}]}]], "Input",
 CellLabel->
  "In[74]:= ",ExpressionUUID->"721e71e5-9ca7-ded5-2226-68cf1553a43f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"H\"\>", ",", "\<\"S\"\>", ",", "\<\"SQRT_X\"\>", 
   ",", "\<\"SQRT_X_DAG\"\>", ",", "\<\"CX\"\>", ",", "\<\"CZ\"\>", 
   ",", "\<\"SWAP\"\>", ",", 
   RowBox[{"Missing", "[", 
    RowBox[{"\<\"NotAvailable\"\>", ",", "\<\"T\"\>"}], "]"}]}], 
  "}"}]], "Output",
 CellLabel->
  "Out[74]= ",ExpressionUUID->"0a84e7eb-55e0-1894-3abb-feb563956afe"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["V"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3261920b-7b77-02d6-621e-14557e02503c"],
 " is the engine's ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    StyleBox["X", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebe3b2c-9c8f-bd2d-7645-b376153b0477"],
 "; Stim's ",
 Cell[BoxData["SQRT_X"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6a0058-fb4a-caff-2b69-9a05fefc98c5"],
 " is the same Clifford up to a Pauli, and a Pauli difference is invisible to \
detectors, which are defined relative to the circuit's own noiseless run. ",
 Cell[BoxData["T"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41d92934-9aba-8299-77e6-c17e1f4cd0e3"],
 " is not Clifford and has no entry."
}], "Text",ExpressionUUID->"5cc23ff5-bf0f-f019-04f1-b6bf3abbc363"],

Cell[TextData[{
 "Idling crosses the bridge too, and by the shared primitive rather than by a \
second computation: one ",
 Cell[BoxData["DEPOLARIZE1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29880975-91f0-008f-5fb7-a13f278552d5"],
 " per ",
 Cell[BoxData["circuitIdleSlots"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "551c00cf-fc58-99c4-0323-99a8f5d2eb2e"],
 " entry, at the same anchor the detector model uses. So the exported circuit \
carries exactly one idle channel per slot where the model carries three \
mechanisms, and the two cannot drift:"
}], "Text",ExpressionUUID->"22235db8-54be-42b7-53d1-54e25d4b109d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"noisyIdle", " ", "=", " ", 
   RowBox[{"QECNoiseModel", "[", 
    RowBox[{"\"\<Circuit\>\"", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<OneQubit\>\"", " ", "->", " ", 
        RowBox[{"1", "/", "1000"}]}], ",", " ", 
       RowBox[{"\"\<TwoQubit\>\"", " ", "->", " ", 
        RowBox[{"1", "/", "1000"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<Measurement\>\"", " ", "->", " ", 
        RowBox[{"1", "/", "1000"}]}], ",", " ", 
       RowBox[{"\"\<Reset\>\"", " ", "->", " ", 
        RowBox[{"1", "/", "1000"}]}], ",", " ", 
       RowBox[{"\"\<Idle\>\"", " ", "->", " ", 
        RowBox[{"1", "/", "500"}]}]}], "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", "\n", "  ", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"circuitIdleSlots", "[", 
     RowBox[{
      RowBox[{"codeCircInstr", "[", 
       RowBox[{"bfData", ",", " ", "2"}], "]"}], ",", " ", "5"}], "]"}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"StringCount", "[", 
    RowBox[{
     RowBox[{"QECStim", "[", 
      RowBox[{"bitFlip", ",", " ", "noisyIdle", ",", " ", "2"}], "]"}], ",", 
     " ", "\"\<DEPOLARIZE1(0.002)\>\""}], "]"}]}], "\n", "}"}]}], "Input",
 CellLabel->
  "In[75]:= ",ExpressionUUID->"0976d5ae-737d-f257-3f0d-cc080609c0bd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"26", ",", "26"}], "}"}]], "Output",
 CellLabel->
  "Out[75]= ",ExpressionUUID->"13e711b4-4d78-4d68-419c-88fe640d17b2"]
}, Open  ]],

Cell[TextData[{
 "No ",
 Cell[BoxData["TICK"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fd09d86-aea1-a602-65ef-14e3cb550d68"],
 " is emitted. ",
 Cell[BoxData["TICK"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f6c0922-6605-ed68-5513-a08c13b1b7b2"],
 " would claim a time step, and these lines are in ",
 StyleBox["emission", "TI"],
 " order rather than layer order \[LongDash] the two disagree, and reordering \
to fix that would move measurements relative to each other and silently \
invalidate every ",
 Cell[BoxData[
  RowBox[{"rec", "[", 
   RowBox[{"-", "k"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2caab86a-2af9-b1b1-54a9-32344e8d039b"],
 " index the detectors are built from. The final noiseless round carries no \
idling either, since the residual it exists to reveal must not be corrupted \
by the act of revealing it."
}], "Text",ExpressionUUID->"7f56169e-4783-4dbb-256d-8fd872361781"],

Cell[TextData[{
 "A full memory experiment. The encoder comes first and is not optional: Stim \
starts in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "0"}], "\[Ellipsis]", "0", "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b84d4d6-858d-5842-09bb-cd902c382aa8"],
 ", which is not a codeword for a general code, and a memory experiment has \
to start inside the code space or its first round of detectors means \
nothing."
}], "Text",ExpressionUUID->"67558936-e5eb-8680-0d6a-2173939fecea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{"StringSplit", "[", 
   RowBox[{
    RowBox[{"QECStim", "[", 
     RowBox[{"bitFlip", ",", " ", 
      RowBox[{"QECNoiseModel", "[", 
       RowBox[{"\"\<Circuit\>\"", ",", " ", "0.001"}], "]"}], ",", " ", "2"}],
      "]"}], ",", " ", "\"\<\n\>\""}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[76]:= ",ExpressionUUID->"1072dc7c-f7d5-c74e-4001-d6398261ad94"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"# 3 data qubits, 2 check ancillas, 2 noisy rounds, Z-basis memory\"\
\>"},
    {"\<\"# emitted by QECStim\"\>"},
    {"\<\"# --- encode ---\"\>"},
    {"\<\"H 1\"\>"},
    {"\<\"H 0\"\>"},
    {"\<\"CZ 1 2\"\>"},
    {"\<\"H 1\"\>"},
    {"\<\"CZ 0 1\"\>"},
    {"\<\"H 0\"\>"},
    {"\<\"# --- round 1 ---\"\>"},
    {"\<\"R 3\"\>"},
    {"\<\"X_ERROR(0.001) 3\"\>"},
    {"\<\"CX 0 3\"\>"},
    {"\<\"DEPOLARIZE2(0.001) 0 3\"\>"},
    {"\<\"CX 1 3\"\>"},
    {"\<\"DEPOLARIZE2(0.001) 1 3\"\>"},
    {"\<\"M(0.001) 3\"\>"},
    {"\<\"R 4\"\>"},
    {"\<\"X_ERROR(0.001) 4\"\>"},
    {"\<\"CX 1 4\"\>"},
    {"\<\"DEPOLARIZE2(0.001) 1 4\"\>"},
    {"\<\"CX 2 4\"\>"},
    {"\<\"DEPOLARIZE2(0.001) 2 4\"\>"},
    {"\<\"M(0.001) 4\"\>"},
    {"\<\"DETECTOR rec[-2]\"\>"},
    {"\<\"DETECTOR rec[-1]\"\>"},
    {"\<\"# --- round 2 ---\"\>"},
    {"\<\"R 3\"\>"},
    {"\<\"X_ERROR(0.001) 3\"\>"},
    {"\<\"CX 0 3\"\>"},
    {"\<\"DEPOLARIZE2(0.001) 0 3\"\>"},
    {"\<\"CX 1 3\"\>"},
    {"\<\"DEPOLARIZE2(0.001) 1 3\"\>"},
    {"\<\"M(0.001) 3\"\>"},
    {"\<\"R 4\"\>"},
    {"\<\"X_ERROR(0.001) 4\"\>"},
    {"\<\"CX 1 4\"\>"},
    {"\<\"DEPOLARIZE2(0.001) 1 4\"\>"},
    {"\<\"CX 2 4\"\>"},
    {"\<\"DEPOLARIZE2(0.001) 2 4\"\>"},
    {"\<\"M(0.001) 4\"\>"},
    {"\<\"DETECTOR rec[-2] rec[-4]\"\>"},
    {"\<\"DETECTOR rec[-1] rec[-3]\"\>"},
    {"\<\"# --- final noiseless round ---\"\>"},
    {"\<\"R 3\"\>"},
    {"\<\"CX 0 3\"\>"},
    {"\<\"CX 1 3\"\>"},
    {"\<\"M 3\"\>"},
    {"\<\"R 4\"\>"},
    {"\<\"CX 1 4\"\>"},
    {"\<\"CX 2 4\"\>"},
    {"\<\"M 4\"\>"},
    {"\<\"DETECTOR rec[-2] rec[-4]\"\>"},
    {"\<\"DETECTOR rec[-1] rec[-3]\"\>"},
    {"\<\"# --- logical Z ---\"\>"},
    {"\<\"R 5\"\>"},
    {"\<\"CX 2 5\"\>"},
    {"\<\"M 5\"\>"},
    {"\<\"OBSERVABLE_INCLUDE(0) rec[-1]\"\>"}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellLabel->
  "Out[76]= ",ExpressionUUID->"3462f0a3-098c-f6b3-5c11-e90da83edc99"]
}, Open  ]],

Cell["\<\
Phenomenological emits a single Pauli channel across the data at each round \
instead of per-gate noise, because there the extraction is a black box:\
\>", "Text",ExpressionUUID->"04cac1af-436c-9192-2cc9-d809761ee3f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{"StringSplit", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"QECStim", "[", 
     RowBox[{"bitFlip", ",", " ", 
      RowBox[{"QECNoiseModel", "[", 
       RowBox[{"\"\<BitFlip\>\"", ",", " ", "0.01", ",", " ", 
        RowBox[{"\"\<MeasurementError\>\"", " ", "->", " ", "0.02"}]}], "]"}],
       ",", " ", "1"}], "]"}], ",", "\n", "    ", "\"\<\n\>\""}], "]"}], 
  "]"}]], "Input",
 CellLabel->
  "In[77]:= ",ExpressionUUID->"63be94f2-239e-9b81-1145-0dbc5628e9eb"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"# 3 data qubits, 2 check ancillas, 1 noisy rounds, Z-basis memory\"\
\>"},
    {"\<\"# emitted by QECStim\"\>"},
    {"\<\"# --- encode ---\"\>"},
    {"\<\"H 1\"\>"},
    {"\<\"H 0\"\>"},
    {"\<\"CZ 1 2\"\>"},
    {"\<\"H 1\"\>"},
    {"\<\"CZ 0 1\"\>"},
    {"\<\"H 0\"\>"},
    {"\<\"# --- round 1 ---\"\>"},
    {"\<\"PAULI_CHANNEL_1(0.01, 0., 0.) 0 1 2\"\>"},
    {"\<\"R 3\"\>"},
    {"\<\"CX 0 3\"\>"},
    {"\<\"CX 1 3\"\>"},
    {"\<\"M(0.02) 3\"\>"},
    {"\<\"R 4\"\>"},
    {"\<\"CX 1 4\"\>"},
    {"\<\"CX 2 4\"\>"},
    {"\<\"M(0.02) 4\"\>"},
    {"\<\"DETECTOR rec[-2]\"\>"},
    {"\<\"DETECTOR rec[-1]\"\>"},
    {"\<\"# --- final noiseless round ---\"\>"},
    {"\<\"R 3\"\>"},
    {"\<\"CX 0 3\"\>"},
    {"\<\"CX 1 3\"\>"},
    {"\<\"M 3\"\>"},
    {"\<\"R 4\"\>"},
    {"\<\"CX 1 4\"\>"},
    {"\<\"CX 2 4\"\>"},
    {"\<\"M 4\"\>"},
    {"\<\"DETECTOR rec[-2] rec[-4]\"\>"},
    {"\<\"DETECTOR rec[-1] rec[-3]\"\>"},
    {"\<\"# --- logical Z ---\"\>"},
    {"\<\"R 5\"\>"},
    {"\<\"CX 2 5\"\>"},
    {"\<\"M 5\"\>"},
    {"\<\"OBSERVABLE_INCLUDE(0) rec[-1]\"\>"}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellLabel->
  "Out[77]= ",ExpressionUUID->"5a3d7a71-218e-1995-0bc3-7c3b503b6bff"]
}, Open  ]],

Cell[TextData[{
 "The option chooses which logical operator is kept. Our own logical error \
rate asks whether the decoder got the residual's ",
 StyleBox["class", "TI"],
 " right, which covers logical ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a0f2024-2f71-09ca-6a34-b98e4a045b10"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "277956ac-4c9d-d338-4d07-4ff66529be02"],
 " damage at once. A Stim memory experiment is single-basis by construction: \
prepare ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"|", "0"}], 
     StyleBox["L", "TI"]], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "178a6a52-23e4-1142-3d89-8c1c559163a8"],
 ", keep it, measure ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ddf811-e480-8137-02e2-f25a8d3ad01d"],
 ". The detector part is basis-independent, and is where the two models are \
compared."
}], "Text",ExpressionUUID->"719ae17a-c654-ed44-27b9-f927f3e6b7ae"],

Cell[CellGroupData[{

