}, Open  ]],

Cell[TextData[{
 "The internal views of the same object. ",
 Cell[BoxData["codeData"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " unwraps the association; the label matrix has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m", "TI"], "+", "2", 
    StyleBox["k", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 " rows, the syndrome half stacked on the logical-class half:"
}], "Text",ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

