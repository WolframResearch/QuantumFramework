 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Record\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], ",", 
   RowBox[{"\<\"Frame\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
        "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
        "0", ",", "0"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[18]= ",ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"]
}, Open  ]],

Cell[TextData[{
 "A fault is ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"instructionIndex", ",", " ", "qubit", ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "z"}], "}"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01ed6b92-5a5f-fa78-3792-82dc5febc942"],
 ", applied ",
 StyleBox["after", "TI"],
 " the instruction at that index. Index 0 means before the circuit starts, \
which is where a code-capacity error on the data lands. Put an ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa29c-d013-1000-4004-3bd9e1a6636a"],
 " on data qubit 1 and read the measurement record:"
}], "Text",ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"framePropagate", "[", 
   RowBox[{
    RowBox[{"circ", "[", "\"\<Instructions\>\"", "]"}], ",", " ", 
    RowBox[{"circ", "[", "\"\<Qubits\>\"", "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}], "}"}]}], "]"}], 
  "[", "\"\<Record\>\"", "]"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}]], "Output",
 CellLabel->
  "Out[19]= ",ExpressionUUID->"2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"]
}, Open  ]],

Cell[TextData[{
 "The oracle: ",
 Cell[BoxData["codeSyndrome"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b990c23-b656-01a6-39a6-a58cc3e3538c"],
 " computes the same thing by matrix product and knows nothing about \
circuits. They agree, and that agreement over every weight-one and weight-two \
error is what ",
 Cell["Tests/Circuit.wlt", "InlineCode",ExpressionUUID->
  "52243646-2fbd-210e-03db-a8204a487054"],
 " checks:"
}], "Text",ExpressionUUID->"1acd7f4d-3da3-7753-4af3-7717b4565db9"],

