  "True", ",", "True", ",", "True", ",", "True", ",", "True", ",", "True", ",",
    "True", ",", "True"}], "}"}]], "Output",
 CellLabel->
  "Out[84]= ",ExpressionUUID->"40213c85-9219-7c2b-71de-b5ef27ac4771"]
}, Open  ]],

Cell["\<\
And no pair is redundant \[LongDash] drop one and coverage fails, which is \
what says the default set is minimal rather than merely sufficient:\
\>", "Text",ExpressionUUID->"678faed4-2cca-f411-0db4-479e457cdf7b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", " ", "=", " ", "6"}], ",", " ", 
     RowBox[{"pats", " ", "=", " ", 
      RowBox[{"catXPatterns", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", " ", "7"}], "]"}]}]}], "}"}], ",",
    "\n", "    ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"catCoverQ", "[", 
      RowBox[{
       RowBox[{"Drop", "[", 
        RowBox[{
         RowBox[{"catPairs", "[", "m", "]"}], ",", " ", 
         RowBox[{"{", "k", "}"}]}], "]"}], ",", " ", "pats"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", 
       RowBox[{"Length", "[", 
        RowBox[{"catPairs", "[", "m", "]"}], "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[85]:= ",ExpressionUUID->"3b3cac94-919f-f08d-6ac3-45de202bc2d7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "False", ",", "False"}], "}"}]], "Output",
 CellLabel->
  "Out[85]= ",ExpressionUUID->"634a1270-2707-566e-1149-943a52b23cb4"]
}, Open  ]],

Cell[TextData[{
 "The check outcomes are heralds, not syndrome bits, which is why the \
instruction language grew ",
 Cell[BoxData["\"\<MH\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "571f0194-b08e-3ab4-7d24-98d1c138889e"],
 " two sections ago: a nonzero one means discard the attempt, and the price \
of that post-selection is an acceptance rate to carry alongside the answer."
}], "Text",ExpressionUUID->"79764466-e076-5945-2f0e-5e4391032baf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cat", " ", "=", " ", 
   RowBox[{"QECCatState", "[", "5", "]"}]}], ";"}], "\n", 
 RowBox[{"AssociationMap", "[", 
  RowBox[{"cat", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Size\>\"", ",", " ", "\"\<Pairs\>\"", ",", 
     " ", "\"\<Heralds\>\"", ",", " ", "\"\<DangerousPatterns\>\"", ",", 
     " ", "\"\<ChecksCoverQ\>\""}], "}"}]}], "]"}]}], "Input",
 CellLabel->
  "In[86]:= ",ExpressionUUID->"54e8dec7-14b1-519a-7c97-d7a19d4423e0"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Size\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"Pairs\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Heralds\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"DangerousPatterns\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", "1", ",", "1"}], "}"}]}], 
     "}"}]}], ",", 
   RowBox[{"\<\"ChecksCoverQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[86]= ",ExpressionUUID->"25f5c72f-3423-741a-538a-de89bdd65f60"]
}, Open  ]],

Cell["Measurement.wl \[LongDash] spending the cat", "Section",ExpressionUUID->"6dbbd446-5835-e39a-1b58-ce2059c1b1e0"],

Cell[TextData[{
 "The cat is the ancilla; this is the gadget that consumes it. One attempt \
applies a transversal controlled-",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d34e655-b983-17e8-14cb-f81f38367d32"],
 " and reads the eigenvalue out with a Hadamard transform, since"
}], "Text",ExpressionUUID->"5c435daa-0d1c-c5df-0471-54f4a4aeaf25"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["H", "TI"], 
     RowBox[{"\[CircleTimes]", 
      StyleBox["m", "TI"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"|", "0"}], "\[Ellipsis]", "0"}], "\[RightAngleBracket]"}], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     StyleBox["b", "TI"]], 
    RowBox[{"|", "1"}], "\[Ellipsis]", "1", "\[RightAngleBracket]", ")", "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["wt",
       FontSlant->"Plain"], 
      RowBox[{"(", 
       StyleBox["x", "TI"], ")"}], "\[Congruent]", 
      StyleBox["b", "TI"]}],
     LimitsPositioning->True], "|", 
    StyleBox["x", "TI"], "\[RightAngleBracket]"}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"21714cd0-c04e-e57a-570f-659df1f8cc40"],

Cell[TextData[{
 "so the ",
 StyleBox["parity of the weight", "TI"],
 " of the measured string is ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74ff421b-073b-c6d4-1c85-6445b2cfac3e"],
 " \[LongDash] ",
 Cell[BoxData[
  FormBox[
   StyleBox["m", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ebc3a74-dd7c-3fa6-6643-bc31d40e858c"],
 " bits of record, one bit of answer."
}], "Text",ExpressionUUID->"7d5c93fe-a057-3a16-2b63-0abbd1e3897c"],

Cell[TextData[{
 "The sandwich that applies the controlled-",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "487dadd0-5ed6-7873-7802-449a5b634b59"],
 " is the same one ",
 Cell[BoxData["generatorInstructions"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5219761b-8a64-c9ff-0227-68452f169bc5"],
 " uses to measure, in the other direction. To apply a controlled-",
 Cell[BoxData[
  FormBox[
   StyleBox["L", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69346765-6d1c-e9c9-18cc-7f4f04aebb13"],
 ", conjugate by the ",
 Cell[BoxData[
  FormBox[
   StyleBox["U", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c22b8c2-70f4-0562-25d1-31ac00816c48"],
 " that sends ",
 Cell[BoxData[
  FormBox[
   StyleBox["L", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04fec585-b88c-469b-2c85-dcef39392ce1"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox["Z", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aa617d4-4041-969d-2a5d-8e9e71f5fce7"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"controlled", "-"}], 
    StyleBox["L", "TI"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["I", "TI"], "\[CircleTimes]", 
      SuperscriptBox[
       StyleBox["U", "TI"], 
       RowBox[{"-", "1"}]]}], ")"}], " ", 
    StyleBox["C", "TI"], 
    StyleBox["Z", "TI"], " ", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["I", "TI"], "\[CircleTimes]", 
      StyleBox["U", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e86e5c8-d785-1389-06bd-fc95e23061d3"],
 ", which in time order is ",
 Cell[BoxData[
  FormBox[
   StyleBox["U", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3582ea65-851b-2569-63b1-0c4f2caf8fb3"],
 ", then ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"C", "Z"}], "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e81d752-d9a7-cf7a-06be-cf1fd8539240"],
 ", then ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["U", "TI"], 
    RowBox[{"-", "1"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dc17641-57cc-3497-1bff-682b627e9efd"],
 ". For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["L", "TI"], "\[LongEqual]", 
    StyleBox["X", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "647a9320-5a37-336f-0c19-0a8a5fc381b5"],
 " that is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[CenterDot]", 
    StyleBox["C", "TI"], 
    StyleBox["Z", "TI"], "\[CenterDot]", 
    StyleBox["H", "TI"], "\[LongEqual]", 
    StyleBox["C", "TI"], 
    StyleBox["N", "TI"], 
    StyleBox["O", "TI"], 
    StyleBox["T", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57b40e76-1aa6-da65-7d4b-a0309f50a94f"],
 ", so nothing is wasted. The rotations are shared rather than re-derived, \
which is why ",
 Cell[BoxData["basisGate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "575b10e3-003a-b957-7d78-89cdb1cc0bbd"],
 " and ",
 Cell[BoxData["rotation"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c7345dd-208f-a284-2401-5c87513bf0ee"],
 " are ",
 Cell[BoxData["PackageScope"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0121a537-2575-8479-30de-3d714c01ef43"],
 ":"
}], "Text",ExpressionUUID->"7f325126-465a-e19d-26c2-488073ecb3e7"],

