  SeriesData[MTNB$1pujh9qw6yer1`p, 0, {
    Rational[32, 15]}, 1, 2, 1],
  Editable->False]], "Output",
 CellLabel->
  "Out[70]= ",ExpressionUUID->"5782d92f-a790-094a-7db1-d088d2255b90"]
}, Open  ]],

Cell[TextData[{
 "The leading term is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    StyleBox["p", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05d48452-325d-a277-33eb-1e1c47e9f15d"],
 ", not ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    SuperscriptBox[
     StyleBox["p", "TI"], "2"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087ffcf6-194e-431e-3804-f5b098fb2e64"],
 ". That is the hook error from the top of the page, priced. And it is the ",
 StyleBox["gadget", "TI"],
 " that costs the distance, not the noise level: a fault-tolerant extraction \
under the same circuit-level noise would keep the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "615fadf7-df9a-5675-1764-44b0da2f3d5f"],
 "."
}], "Text",ExpressionUUID->"5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"],

Cell["A duality that survives one level and breaks at the next", "Subsection",ExpressionUUID->"2d0df906-1ebb-1081-5b32-f1609b4e62eb"],

Cell["\<\
The bit-flip and phase-flip codes are related by a Hadamard on every qubit, \
so at code capacity with the dual channel they give the same polynomial. At \
circuit level they do not:\
\>", "Text",ExpressionUUID->"519a4e0d-3467-bfb9-07ba-6057bd130583"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{"bitFlip", ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Circuit\>\"", ",", " ", "p"}], "]"}], ",", " ", 
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], ",", "\n", 
   " ", 
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<PhaseFlipCode\>\"", "]"}], ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Circuit\>\"", ",", " ", "p"}], "]"}], ",", "\n", "    ", 
       
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->
  "In[71]:= ",ExpressionUUID->"3a891815-8c00-cf41-6ab6-925f25ba95ab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   InterpretationBox[
    RowBox[{
     FractionBox[
      RowBox[{"32", " ", "p"}], "15"], "+", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "p", "]"}], "2"],
      SeriesData[MTNB$1pujh9qw6yer1`p, 0, {}, 1, 2, 1],
      Editable->False]}],
    SeriesData[MTNB$1pujh9qw6yer1`p, 0, {
      Rational[32, 15]}, 1, 2, 1],
    Editable->False], ",", 
   InterpretationBox[
    RowBox[{
     FractionBox[
      RowBox[{"112", " ", "p"}], "15"], "+", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "p", "]"}], "2"],
      SeriesData[MTNB$1pujh9qw6yer1`p, 0, {}, 1, 2, 1],
      Editable->False]}],
    SeriesData[MTNB$1pujh9qw6yer1`p, 0, {
      Rational[112, 15]}, 1, 2, 1],
    Editable->False]}], "}"}]], "Output",
 CellLabel->
  "Out[71]= ",ExpressionUUID->"0dbacffa-31b0-43f6-3b59-e6a4404511dc"]
}, Open  ]],

Cell[TextData[{
 "The whole difference is that the ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "196a859c-b643-c1b3-4f69-1cd9c3f79399"],
 "-type checks need eight extra Hadamards. Switch off one-qubit-gate noise \
and the duality comes back:"
}], "Text",ExpressionUUID->"48c8a383-1e42-ef31-78f7-3aed9bf4b21b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nNoGates", " ", "=", " ", 
   RowBox[{"QECNoiseModel", "[", 
    RowBox[{"\"\<Circuit\>\"", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<TwoQubit\>\"", " ", "->", " ", "p"}], ",", " ", 
       RowBox[{"\"\<Measurement\>\"", " ", "->", " ", "p"}], ",", " ", 
       RowBox[{"\"\<Reset\>\"", " ", "->", " ", "p"}]}], "|>"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{"bitFlip", ",", " ", "nNoGates", ",", " ", 
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], ",", "\n", 
   " ", 
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{
       RowBox[{"QECCode", "[", "\"\<PhaseFlipCode\>\"", "]"}], ",", " ", 
       "nNoGates", ",", " ", 
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->
  "In[72]:= ",ExpressionUUID->"50735439-04fd-dee7-0001-4e63ac89a4cd"],

