    "[", "\"\<Probabilities\>\"", "]"}], ",", "\n", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"QECLogicalErrorRate", "[", 
     RowBox[{
      RowBox[{"QECCode", "[", 
       RowBox[{"\"\<Repetition\>\"", "[", "3", "]"}], "]"}], ",", " ", 
      RowBox[{"QuantumChannel", "[", 
       RowBox[{"\"\<BitFlip\>\"", "[", "p", "]"}], "]"}]}], "]"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"73e8aeff-5b91-f8f4-2197-47b95e25cade"],

