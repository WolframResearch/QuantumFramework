Cell["\<\
And the detector model, which is where heralds come from, answers the same as \
properties:\
\>", "Text",ExpressionUUID->"621761a3-d300-b412-122d-780ce6ba1f78"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dem", " ", "=", " ", 
     RowBox[{"QECDetectorModel", "[", 
      RowBox[{"bitFlip", ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Circuit\>\"", ",", " ", 
         RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", "1"}], "]"}]}], "}"}],
    ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"dem", "[", "\"\<LogicalErrorRate\>\"", "]"}], " ", "===", " ", 
      
      RowBox[{"QECLogicalErrorRate", "[", 
       RowBox[{"bitFlip", ",", " ", 
        RowBox[{"QECNoiseModel", "[", 
         RowBox[{"\"\<Circuit\>\"", ",", " ", 
          RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", 
        RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], ",", "\n",
      "     ", 
     RowBox[{"dem", "[", "\"\<Acceptance\>\"", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
