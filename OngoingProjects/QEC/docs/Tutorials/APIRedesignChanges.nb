    RowBox[{"five", ",", " ", "\"\<XX\>\""}], "]"}], ",", " ", 
   RowBox[{"QECPauliMeasurement", "[", 
    RowBox[{"five", ",", " ", "\"\<-XZZXI\>\""}], "]"}]}], "}"}]], "Input",
