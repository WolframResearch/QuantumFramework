Cell[TextData[{
 "The third item of step 1, taking ",
 Cell[BoxData["QECClassicalHammingMatrix"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b45e796-37a7-eecc-197a-fed04253b416"],
 " out of the public namespace, moved to step 5, because six tests and two \
documentation cells used it."
}], "Text",ExpressionUUID->"5e187950-8ca2-2ab2-0638-711a25577898"],

Cell["Step 2: the gadgets hand back framework circuits", "Section",ExpressionUUID->"250a2d7c-9b81-05b0-5309-c5261e346f9a"],

Cell[TextData[{
 "Before, the six circuit-bearing objects (",
 Cell[BoxData["QECSyndromeCircuit"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a9104d-5625-6af3-4356-8a1763d038d9"],
 ", ",
 Cell[BoxData["QECCatState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],
 ", ",
 Cell[BoxData["QECPauliMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43821c38-6720-b4f9-71b1-966212da1ec3"],
 ", ",
 Cell[BoxData["QECErrorCorrection"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c54d9-3079-6bba-5c24-4d83410c3980"],
 ", ",
 Cell[BoxData["QECTransversalGate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],
 " and the FT object) only gave their own instruction list. Now they all also \
give the framework's ",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f449897-1a0e-51e7-357b-11d19fbb23cd"],
 " and its diagram, through one shared file, ",
 Cell["Gadget.wl", "InlineCode",ExpressionUUID->
  "6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],
 ":"
}], "Text",ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

Cell[CellGroupData[{

