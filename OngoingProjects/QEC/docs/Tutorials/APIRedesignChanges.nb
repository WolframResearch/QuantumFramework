    Cell["21", "TableText",ExpressionUUID->
     "2fdb82dc-2353-e9b3-55f8-1b8656e7bb99"], Cell[
    "25", "TableText",ExpressionUUID->
     "5782d92f-a790-094a-7db1-d088d2255b90"]}
  }]], "3ColumnTableMod",ExpressionUUID->"05d48452-325d-a277-33eb-1e1c47e9f15d"],

Cell[TextData[{
 "New files: ",
 Cell["Gadget.wl", "InlineCode",ExpressionUUID->
  "087ffcf6-194e-431e-3804-f5b098fb2e64"],
 ", ",
 Cell["Operational.wl", "InlineCode",ExpressionUUID->
  "615fadf7-df9a-5675-1764-44b0da2f3d5f"],
 ", ",
 Cell["Decoder.wl", "InlineCode",ExpressionUUID->
  "5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"],
 ", ",
 Cell["Deprecated.wl", "InlineCode",ExpressionUUID->
  "2d0df906-1ebb-1081-5b32-f1609b4e62eb"],
 ", and the tests ",
 Cell["Gadget.wlt", "InlineCode",ExpressionUUID->
  "519a4e0d-3467-bfb9-07ba-6057bd130583"],
 ", ",
 Cell["Operational.wlt", "InlineCode",ExpressionUUID->
  "3a891815-8c00-cf41-6ab6-925f25ba95ab"],
 ", ",
 Cell["Decoder.wlt", "InlineCode",ExpressionUUID->
  "0dbacffa-31b0-43f6-3b59-e6a4404511dc"],
 ", ",
 Cell["Surface.wlt", "InlineCode",ExpressionUUID->
  "196a859c-b643-c1b3-4f69-1cd9c3f79399"],
 ". Nothing in ",
 Cell["QuantumFramework/Kernel/", "InlineCode",ExpressionUUID->
  "48c8a383-1e42-ef31-78f7-3aed9bf4b21b"],
 " was modified."
}], "Text",ExpressionUUID->"50735439-04fd-dee7-0001-4e63ac89a4cd"],

Cell["\<\
Step 8: named objects and circuits in the framework's spelling\
\>", "Section",ExpressionUUID->"3597ba8d-914b-928f-63ac-33d720ffe0d5"],

Cell[TextData[{
 "A later pass, in November 2026, brought the remaining constructors in line \
with the framework's named objects. In ",
 Cell[BoxData[
  RowBox[{"QuantumState", "[", 
   RowBox[{"\"\<GHZ\>\"", "[", "3", "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "056fda38-a5bc-2884-3314-dc65cc497aee"],
 ", ",
 Cell[BoxData[
  RowBox[{"QuantumOperator", "[", 
   RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "383c4a9f-130c-f8c1-69c4-63d9a6beca2b"],
 " and ",
 Cell[BoxData[
  RowBox[{"QuantumChannel", "[", 
   RowBox[{"\"\<BitFlip\>\"", "[", "p", "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b649e79-a2e1-7610-291b-1022d6945d7a"],
 " the name carries its own parameters, and whatever follows it is order, \
basis or options. The QEC constructors now read the same way:"
}], "Text",ExpressionUUID->"09cb884c-5fc8-b209-3fc8-22165a620153"],

