Cell["Step 9: objects that behave like the framework's", "Section",ExpressionUUID->"7d5c93fe-a057-3a16-2b63-0abbd1e3897c"],

Cell[TextData[{
 "The same pass gave every QEC object the behaviour the framework's own \
objects share (",
 Cell["QuantumChannel.m", "InlineCode",ExpressionUUID->
  "487dadd0-5ed6-7873-7802-449a5b634b59"],
 ", ",
 Cell["QuantumState.m", "InlineCode",ExpressionUUID->
  "5219761b-8a64-c9ff-0227-68452f169bc5"],
 "):"
}], "Text",ExpressionUUID->"69346765-6d1c-e9c9-18cc-7f4f04aebb13"],

Cell[TextData[{
 StyleBox["Predicates.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData["QECCodeQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c22b8c2-70f4-0562-25d1-31ac00816c48"],
 ", ",
 Cell[BoxData["QECDecoderQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04fec585-b88c-469b-2c85-dcef39392ce1"],
 ", ",
 Cell[BoxData["QECNoiseModelQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aa617d4-4041-969d-2a5d-8e9e71f5fce7"],
 ", ",
 Cell[BoxData["QECDetectorModelQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e86e5c8-d785-1389-06bd-fc95e23061d3"],
 " and one for every other head. An object whose data carries what its head \
needs is marked valid with ",
 Cell[BoxData["System"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3582ea65-851b-2569-63b1-0c4f2caf8fb3"],
 "Private",
 Cell[BoxData["HoldSetValid"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e81d752-d9a7-cf7a-06be-cf1fd8539240"],
 " the first time it evaluates, so the predicate is a flag lookup from then \
on. ",
 Cell[BoxData[
  RowBox[{"obj", "[", "\"\<ValidQ\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dc17641-57cc-3497-1bff-682b627e9efd"],
 " asks the same question, and ",
 Cell[BoxData[
  RowBox[{"obj", "[", "\"\<AllProperties\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "647a9320-5a37-336f-0c19-0a8a5fc381b5"],
 " adds ",
 Cell[BoxData["\"\<Properties\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57b40e76-1aa6-da65-7d4b-a0309f50a94f"],
 ", ",
 Cell[BoxData["\"\<AllProperties\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "575b10e3-003a-b957-7d78-89cdb1cc0bbd"],
 " and ",
 Cell[BoxData["\"\<ValidQ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c7345dd-208f-a284-2401-5c87513bf0ee"],
 " to the list."
}], "Item",ExpressionUUID->"0121a537-2575-8479-30de-3d714c01ef43"],

Cell[TextData[{
 StyleBox["Unknown properties.",
  FontWeight->"Bold"],
 " A property the head does not know gives ",
 Cell[BoxData[
  RowBox[{"H", "::", "undefprop"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f325126-465a-e19d-26c2-488073ecb3e7"],
 " and is left unevaluated, as ",
 Cell[BoxData[
  RowBox[{"QuantumState", "[", "\"\<Nonsense\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "739af998-c5c1-31b3-21b9-f0c5ec758399"],
 " is. It used to give ",
 Cell[BoxData[
  RowBox[{"Missing", "[", 
   RowBox[{"\"\<NotFound\>\"", ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "003becda-d908-4451-31d8-0587d8bd2ebb"],
 "."
}], "Item",ExpressionUUID->"7aeb468a-2cc6-59e2-2ae9-5fd445732bc8"],

Cell[TextData[{
 StyleBox["Failures.",
  FontWeight->"Bold"],
 " Every refusal that comes with a message returns a ",
 Cell[BoxData["Failure"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3873a668-04d7-31ac-6800-3832ad6383f6"],
 " carrying that message, tagged with the message's name: ",
 Cell[BoxData[
  RowBox[{"QECCode", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<ZI\>\"", ",", " ", "\"\<IZ\>\"", ",", " ", "\"\<ZZ\>\""}], 
    "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4156c81a-8a68-59d7-776d-e2442f1d2b3d"],
 " gives ",
 Cell[BoxData[
  RowBox[{"Failure", "[", 
   RowBox[{"\"\<overcomplete\>\"", ",", " ", "..."}], "]"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e7ab4-00f8-e339-7ea6-73feb172ce03"],
 ". A failure met inside the layer is passed on unchanged, and every internal \
check asks ",
 Cell[BoxData["FailureQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b3ec616-de69-0141-3ac5-d853db1c53ab"],
 ", so a bare ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c0d57bf-7ae8-3253-2433-4ef97e8280b9"],
 " left in a helper is still handled."
}], "Item",ExpressionUUID->"0aaecb0d-dff0-cd78-3a55-e356d98a9442"],

Cell[TextData[{
 StyleBox["Caching.",
  FontWeight->"Bold"],
 " The layer's memoised results go through one store that keeps them only \
while the framework's ",
 Cell[BoxData["$QuantumFrameworkPropCache"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fe4a286-576e-fd11-759b-3be06218c47b"],
 " is on, so ",
 Cell[BoxData[
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"$QuantumFrameworkPropCache", " ", "=", " ", "False"}], "}"}], ",",
     " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07179650-9fbb-2bc1-2d2c-081a1a4e792b"],
 " turns off both caches at once. ",
 Cell[BoxData[
  RowBox[{"QECClearCache", "[", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aecd320-e31f-2936-2a93-ca8d96aa781c"],
 " still drops what is stored."
}], "Item",ExpressionUUID->"326b0854-5043-0b63-6268-a21e61f65649"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"QECCodeQ", "[", "steane", "]"}], ",", " ", 
   RowBox[{"QECCodeQ", "[", 
    RowBox[{"QECCode", "[", 
     RowBox[{"<|", 
      RowBox[{"\"\<Qubits\>\"", " ", "->", " ", "3"}], "|>"}], "]"}], "]"}], ",",
    " ", 
   RowBox[{"steane", "[", "\"\<ValidQ\>\"", "]"}], ",", " ", 
   RowBox[{"FailureQ", "[", 
    RowBox[{"Quiet", "[", 
     RowBox[{"QECCode", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<ZI\>\"", ",", " ", "\"\<IZ\>\"", ",", " ", "\"\<ZZ\>\""}],
        "}"}], "]"}], "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[35]:= ",ExpressionUUID->"1d6edc53-4ce5-e0f2-4b15-d61d6491b2d8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->
  "Out[35]= ",ExpressionUUID->"45f7e4e6-4e1c-a184-738c-fdc06baef3ee"]
}, Open  ]],

Cell["One finding", "Section",ExpressionUUID->"70e98525-204e-6ba4-2096-1c8f51fb398e"],

Cell[TextData[{
 StyleBox["The five-qubit code's encoder uses its own labels.",
  FontWeight->"Bold"],
 " Shown above: the encoding circuit produces the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "704169dd-a4db-5005-207e-8086cd6e236f"],
 " eigenstate of the code's ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b2d1c14-5aff-cd5f-2ad2-965e5e8b97a5"],
 ". ",
 Cell["Encoder.wl", "InlineCode",ExpressionUUID->
  "62ac11c1-6d0b-a8c0-1253-88ab04bffa2a"],
 " was not changed, because the circuit is still valid and is what the \
extraction and Stim consume; the new ",
 Cell[BoxData["\"\<Encoder\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e7621e1-2fba-a33a-560d-b8cb4a4c0e00"],
 " corrects it, and a test pins ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], 
    StyleBox["V", "TI"], "\[LongEqual]", 
    StyleBox["Z", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15938457-0322-a4d9-43a0-1e11b6d40e23"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["X", "TI"], "_"], 
    StyleBox["V", "TI"], "\[LongEqual]", 
    StyleBox["X", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f1ed2e3-b722-4b37-2525-cbccc2d7161d"],
 " on five codes."
}], "Text",ExpressionUUID->"52e63e44-9d5c-26a1-029d-b02e14ee8c8b"],

