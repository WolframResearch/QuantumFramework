Cell["The four decisions", "Section",ExpressionUUID->"65de4a87-3471-cd9f-13e6-63e1bd0597e5"],

Cell["\<\
The audit left four design questions open. They were settled provisionally so \
the work was not blocked; each one is isolated, so changing one does not \
touch the others.\
\>", "Text",ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"],
     Cell["question", "TableText",
     FontWeight->Bold,ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],
     Cell["decision", "TableText",
     FontWeight->Bold,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5bfe104a-50de-a555-0985-8a1461680fbf"], Cell[
    "A", "TableText",ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"], 
    Cell["Is the rate read from the logical channel?", "TableText",
     ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"], Cell[TextData[{
     StyleBox["Yes",
      FontWeight->"Bold"],
     ", but the channel is built from the coset engine, not by composing \
dense channels, so it stays exact and symbolic"
    }], "TableText",ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "608e87cc-8fce-afdf-10b5-1e962a78f525"], Cell[
    "B", "TableText",ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"], 
    Cell[TextData[{
     "Do the constructions (",
     Cell[BoxData["QECConcatenate"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "66b4bee0-d247-b105-0e4b-37cde7f3006f"],
     ", ",
     Cell[BoxData["QECPasteCodes"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
     ", ",
     Cell[BoxData["QECRemoveQubit"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
     ") become properties?"
    }], "TableText",ExpressionUUID->"644cc522-c7c4-9b18-0c73-dc8ff276e662"], 
    Cell[TextData[{
     StyleBox["They stay functions",
      FontWeight->"Bold"],
     " and can also be asked of a code as properties"
    }], "TableText",ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6801f052-da94-0b6f-183e-ea1fdf2159b5"], Cell[
    "C", "TableText",ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"], 
    Cell[TextData[{
     "Does ",
     Cell[BoxData[
      RowBox[{"code", "[", "\"\<Generators\>\"", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7b6211f5-475c-1194-2911-88bf72e963fe"],
     " return Pauli objects?"
    }], "TableText",ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"], 
