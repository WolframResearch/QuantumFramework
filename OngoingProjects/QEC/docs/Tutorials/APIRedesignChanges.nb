Cell[TextData[{
 "It is a code-capacity object: with circuit-level noise the checks \
themselves fail, the cycle is no longer one channel, and the answer is ",
 Cell[BoxData["Missing"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ce33075-6d34-44a7-1490-aa3f04c12e8d"],
 ", pointing to the detector model."
}], "Text",ExpressionUUID->"54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],

Cell["Noise as a channel", "Subsection",ExpressionUUID->"6334ac9c-43f1-85c0-12cb-45c67585ef2a"],

Cell[TextData[{
 "Noise can also be given in the framework's own terms. A one-qubit ",
 Cell[BoxData["QuantumChannel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74397683-04f4-1d4d-1dc7-6fedac816797"],
 " that is a Pauli channel is read back as a noise model and is accepted \
everywhere a noise model is:"
}], "Text",ExpressionUUID->"735e49d5-32a1-4a48-2166-609f47541892"],

