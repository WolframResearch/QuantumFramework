Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"QECDecoder", "[", "steane", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"d", "[", "\"\<Method\>\"", "]"}], ",", " ", 
     RowBox[{"d", "[", 
      RowBox[{"\"\<Decode\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", " ", "0", ",", " ", "0", ",", " ", "1", ",", " ", "1", ",", 
         " ", "1"}], "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"4f6d713e-2461-11c8-7513-69784d146312"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"MinimumWeight\"\>", ",", "\<\"IIIIIIX\"\>"}], "}"}]], "Output",\

 CellLabel->
  "Out[24]= ",ExpressionUUID->"14ad582f-66ff-93eb-3c53-5189128be131"]
}, Open  ]],

