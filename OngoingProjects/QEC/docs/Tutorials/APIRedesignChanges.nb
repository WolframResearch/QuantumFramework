    }], "TableText",ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"], 
    Cell["a state", "TableText",ExpressionUUID->
     "7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"]},
