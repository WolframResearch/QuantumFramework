  }]], "2ColumnTableMod",ExpressionUUID->"36e5ffeb-8179-694d-5e9a-f6b5300c3b97"],

Cell["Three more conventions came with it:", "Text",ExpressionUUID->"7af061c8-c44a-ae8e-2a80-7895edfcf4d4"],

Cell[TextData[{
 StyleBox["Bare names and name lists.",
  FontWeight->"Bold"],
 " A family's bare name is its default member and a noise's bare name takes \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "\[LongEqual]", "1", "/", "100"}], TraditionalForm]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d437dad-8290-de9a-3b71-74f7372aa4e0"],
 ", as ",
 Cell[BoxData[
  RowBox[{"QuantumChannel", "[", "\"\<BitFlip\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aafc905-908a-67da-2a54-e16f213f4d20"],
 " takes its default. ",
 Cell[BoxData["$QECCodeNames"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62016b94-8ad8-fb56-123e-82de2f52c9bc"],
 " and ",
 Cell[BoxData["$QECNoiseNames"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e7c794a-82c2-56e7-3604-711437773ccd"],
 " list the names, like ",
 Cell[BoxData["$QuantumChannelNames"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30f601cf-5001-fb68-608d-98a961b5c9b2"],
 "."
}], "Item",ExpressionUUID->"04bc0f0b-f02f-243d-2c43-a75481db8f07"],

Cell[TextData[{
 StyleBox["Failures.",
  FontWeight->"Bold"],
 " An unknown name returns ",
 Cell[BoxData[
  RowBox[{"Failure", "[", 
   RowBox[{"\"\<InvalidName\>\"", ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],
 " with ",
 Cell[BoxData[
  RowBox[{"::", "invalidName"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705e212e-f5a4-7717-2065-b88bfc515a7d"],
 ", and a known name with parameters it cannot use returns ",
 Cell[BoxData[
  RowBox[{"Failure", "[", 
   RowBox[{"\"\<InvalidArguments\>\"", ",", " ", "..."}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c2f5325-a3f6-c048-05d5-4a8ed5809292"],
 " with ",
 Cell[BoxData[
  RowBox[{"::", "invalidArgs"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "211ecaf2-61ee-418f-5725-e3bc179b13d5"],
 " or a message that says what is wrong, as ",
 Cell[BoxData["QuantumState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51e4dffc-d38f-5703-079b-d6b9e63a3a69"],
 " does."
}], "Item",ExpressionUUID->"30e43b5d-74af-d0fb-609b-b3077d5ba2c1"],

Cell[TextData[{
 StyleBox["Circuits.",
  FontWeight->"Bold"],
 " Every instruction list the layer hands out (",
 Cell[BoxData["\"\<Instructions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44d9380c-2e05-8f35-6ce6-b2564bb1d21f"],
 ", ",
 Cell[BoxData["\"\<GadgetInstructions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"],
 ", ",
 Cell[BoxData["\"\<BitFlipInstructions\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "138e1639-4d05-8b97-41b5-886364b1d9fd"],
 ", a register's ",
 Cell[BoxData["\"\<Lift\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "156728ce-0023-e03b-431c-c1a8b1d7b301"],
 " and ",
 Cell[BoxData["\"\<TransversalCNOT\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"],
 ") is a circuit ",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26ff5c08-e081-ff27-4e85-56559135c20d"],
 " accepts as it is: gate -> qubits, with the framework's own names, ",
 Cell[BoxData[
  RowBox[{"\"\<Reset\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07c988c4-3ef2-8066-2df6-21aeba84d34c"],
 ", ",
 Cell[BoxData[
  RowBox[{"\"\<Measurement\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bc0a2f3-6150-447f-79ff-3bbd10e52f45"],
 ", ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"SuperDagger", "[", "\"\<S\>\"", "]"}], " ", "->", " ", "q"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ac66077-3bfa-1f18-2afe-7a31bd8f6262"],
 ", and a verification readout as a ",
 Cell[BoxData["QuantumMeasurementOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d863d84-94ab-5643-6bbd-b4ee1d5e3ca9"],
 " labelled ",
 Cell[BoxData["\"\<Herald\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ab8b877-e011-189c-2a47-323091a46ae6"],
 ". ",
 Cell[BoxData["\"\<GateCounts\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35eb0178-2238-e094-63e8-992257b2b2fe"],
 " is keyed by the same names. Inside the layer the flat tuples stay, since \
every builder pattern-matches on them; ",
 Cell[BoxData["instructionRules"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da6433d-a7a4-ba24-3b5e-5b66d256090e"],
 " and ",
 Cell[BoxData["instructionTuples"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "462f64f6-435d-c7dd-6fd5-7db076e9ad27"],
 " (",
 Cell["Gadget.wl", "InlineCode",ExpressionUUID->
  "4b06bf63-5f43-ed7c-793d-374d5af7b446"],
 ") are the only crossing."
}], "Item",ExpressionUUID->"0fd1c247-21a4-d962-35ee-e4215056a848"],

Cell[TextData[{
 StyleBox["Objects applied to what they act on",
  FontWeight->"Bold"],
 ", as a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09347675-9fce-c17b-38cc-683f1a789041"],
 " is applied to a state: a decoder to a syndrome, ",
 Cell[BoxData[
  RowBox[{"dec", "[", 
   RowBox[{"{", 
    RowBox[{
    "0", ",", " ", "0", ",", " ", "0", ",", " ", "1", ",", " ", "1", ",", " ",
      "1"}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c597ed5-00d9-d535-5467-779fb16dbc1f"],
 ", and a code to a Pauli, ",
 Cell[BoxData[
  RowBox[{"code", "[", 
   RowBox[{"QECPauli", "[", "\"\<XIIIIII\>\"", "]"}], "]"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c4d8d6-27c8-a0db-0efb-d1905262f221"],
 ", which gives its syndrome."
}], "Item",ExpressionUUID->"4d3801b6-8b23-0df3-74c7-98f02ed657d9"],

Cell[TextData[{
 StyleBox["Equality by content.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{"code1", " ", "==", " ", "code2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09816d05-11e9-fb6e-3fbe-856fa79dc9b4"],
 " is true when the two codes have the same stabilizer group, signs included, \
whatever generators were written; ",
 Cell[BoxData[
  RowBox[{"noise1", " ", "==", " ", "noise2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35ec423d-cde2-7917-6394-6466eb97487d"],
 " when they put the same probabilities on the same locations; ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"QECPauli", "[", "p", "]"}], " ", "==", " ", 
   RowBox[{"QECPauli", "[", "q", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05e0e9bc-56b1-1bf2-339f-00e6634469d8"],
 " when they are the same Pauli."
}], "Item",ExpressionUUID->"46408f14-a324-388b-6e7f-2751d6d68ad1"],

Cell[TextData[{
 Cell[BoxData["QuantumTensorProduct"], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"40213c85-9219-7c2b-71de-b5ef27ac4771"],
 " joins codes side by side, as it joins bases, states, operators and \
channels: ",
 Cell[BoxData[
  RowBox[{"QuantumTensorProduct", "[", 
   RowBox[{
    RowBox[{"QECCode", "[", "\"\<SteaneCode\>\"", "]"}], ",", " ", 
    RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "678faed4-2cca-f411-0db4-479e457cdf7b"],
 " is a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"[", 
     RowBox[{"12", ",", "2", ",", "3"}], "]"}], "]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b3cac94-919f-f08d-6ac3-45de202bc2d7"],
 " code."
}], "Item",ExpressionUUID->"634a1270-2707-566e-1149-943a52b23cb4"],

Cell[TextData[{
 StyleBox["The framework's names",
  FontWeight->"Bold"],
 ": ",
 Cell[BoxData["\"\<7QubitCode\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "571f0194-b08e-3ab4-7d24-98d1c138889e"],
 " and ",
 Cell[BoxData["\"\<9QubitCode\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79764466-e076-5945-2f0e-5e4391032baf"],
 ", as ",
 Cell[BoxData["PauliStabilizer"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e8dec7-14b1-519a-7c97-d7a19d4423e0"],
 " calls them, name the Steane and Shor codes, and a detector model's Stim \
source is ",
 Cell[BoxData[
  RowBox[{"dem", "[", "\"\<Stim\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25f5c72f-3423-741a-538a-de89bdd65f60"],
 ", as a circuit's Qiskit form is ",
 Cell[BoxData[
  RowBox[{"qco", "[", "\"\<Qiskit\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dbbd446-5835-e39a-1b58-ce2059c1b1e0"],
 "."
}], "Item",ExpressionUUID->"6d34e655-b983-17e8-14cb-f81f38367d32"],

Cell["\<\
The old forms are not kept. Each is refused with a message that shows the new \
spelling:\
\>", "Text",ExpressionUUID->"5c435daa-0d1c-c5df-0471-54f4a4aeaf25"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QECCode", "[", 
  RowBox[{"\"\<Surface\>\"", ",", " ", "3"}], "]"}]], "Input",
 CellLabel->
  "In[34]:= ",ExpressionUUID->"21714cd0-c04e-e57a-570f-659df1f8cc40"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"QECCode", "::", "oldform"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{
  "The", " ", "parameters", " ", "of", " ", "a", " ", "code", " ", "family", " ",
    "go", " ", "inside", " ", "its", " ", 
   RowBox[{"name", ":", " "}]}], 
  RowBox[{"QECCode", "[", 
   RowBox[{"\<\"Surface\"\>", "[", "3", "]"}], "]"}], 
  RowBox[{",", " ", "not", " "}], 
  RowBox[{"QECCode", "[", 
   RowBox[{"\<\"Surface\"\>", ",", " ", "3"}], "]"}], "."}]], "Message", \
"MSG",ExpressionUUID->"74ff421b-073b-c6d4-1c85-6445b2cfac3e"],

