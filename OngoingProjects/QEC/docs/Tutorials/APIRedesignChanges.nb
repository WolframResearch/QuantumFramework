Cell["Asked directly:", "Text",ExpressionUUID->"1acd7f4d-3da3-7753-4af3-7717b4565db9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Head", " ", "/@", " ", 
  RowBox[{"<|", "\n", "    ", 
   RowBox[{
    RowBox[{"\"\<Encoder\>\"", " ", "->", " ", 
     RowBox[{"bitFlip", "[", "\"\<Encoder\>\"", "]"}]}], ",", "\n", "    ", 
    RowBox[{"\"\<Codewords\>\"", " ", "->", " ", 
     RowBox[{"First", "[", 
      RowBox[{"bitFlip", "[", "\"\<Codewords\>\"", "]"}], "]"}]}], ",", "\n", 
    "    ", 
    RowBox[{"\"\<Codespace\>\"", " ", "->", " ", 
     RowBox[{"bitFlip", "[", "\"\<Codespace\>\"", "]"}]}], ",", "\n", "    ", 
    
    RowBox[{"\"\<SyndromeMeasurement\>\"", " ", "->", " ", 
     RowBox[{"bitFlip", "[", "\"\<SyndromeMeasurement\>\"", "]"}]}], ",", 
    "\n", "    ", 
    RowBox[{"\"\<Recovery\>\"", " ", "->", " ", 
     RowBox[{"bitFlip", "[", 
      RowBox[{"\"\<Recovery\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]}], ",", "\n", "    ", 
    RowBox[{"\"\<LogicalChannel\>\"", " ", "->", " ", 
     RowBox[{"bitFlip", "[", 
      RowBox[{"\"\<LogicalChannel\>\"", ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<BitFlip\>\"", "[", 
         RowBox[{"1", "/", "10"}], "]"}], "]"}]}], "]"}]}], ",", "\n", "    ", 
    RowBox[{"\"\<noise[\\\"QuantumChannel\\\"]\>\"", " ", "->", " ", 
     RowBox[{
      RowBox[{"QECNoiseModel", "[", 
       RowBox[{"\"\<BitFlip\>\"", "[", 
        RowBox[{"1", "/", "10"}], "]"}], "]"}], "[", "\"\<QuantumChannel\>\"",
       "]"}]}]}], "|>"}]}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Encoder\"\>", "\[Rule]", "QuantumOperator"}], ",", 
   RowBox[{"\<\"Codewords\"\>", "\[Rule]", "QuantumState"}], ",", 
   RowBox[{"\<\"Codespace\"\>", "\[Rule]", "QuantumOperator"}], ",", 
   RowBox[{"\<\"SyndromeMeasurement\"\>", "\[Rule]", 
    "QuantumMeasurementOperator"}], ",", 
   RowBox[{"\<\"Recovery\"\>", "\[Rule]", "QuantumChannel"}], ",", 
   RowBox[{"\<\"LogicalChannel\"\>", "\[Rule]", "QuantumChannel"}], ",", 
   RowBox[{"\<\"noise[\\\"QuantumChannel\\\"]\"\>", "\[Rule]", 
    "QuantumChannel"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"]
}, Open  ]],

Cell["\<\
Because they are the framework's own objects, the framework's own operations \
work on them without any QEC-specific glue. The whole correction cycle can be \
run by hand: encode a framework state, hit it with a framework gate, measure \
the syndrome, apply the recovery \[LongDash] every step is just applying one \
framework object to another:\
\>", "Text",ExpressionUUID->"6f6ad260-8ee1-565a-1569-d44a2a943ca0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"psi", ",", " ", "hit", ",", " ", "fixed", ",", " ", "v"}], "}"}],
    ",", "\n", "    ", 
   RowBox[{
    RowBox[{"psi", " ", "=", " ", 
     RowBox[{
      RowBox[{"bitFlip", "[", "\"\<Encoder\>\"", "]"}], "[", 
      RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], "]"}]}], ";", 
    "          ", 
    RowBox[{"(*", " ", 
     RowBox[{"QuantumOperator", " ", "on", " ", "a", " ", "QuantumState"}], 
     " ", "*)"}], "\n", "    ", 
    RowBox[{"hit", " ", "=", " ", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"\"\<X\>\"", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], "[", "psi", "]"}]}], ";", 
    "                  ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "an", " ", "ordinary", " ", "framework", " ", "gate", " ", "as", " ", 
      "the", " ", "error"}], " ", "*)"}], "\n", "    ", 
    RowBox[{"fixed", " ", "=", " ", 
     RowBox[{
      RowBox[{"bitFlip", "[", 
       RowBox[{"\"\<Recovery\>\"", ",", " ", 
        RowBox[{"bitFlip", "[", 
         RowBox[{"\"\<Syndrome\>\"", ",", " ", "\"\<IXI\>\""}], "]"}]}], 
       "]"}], "[", 
      RowBox[{"QuantumState", "[", 
       RowBox[{"hit", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "]"}]}], ";",
     "\n", "    ", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"Normal", "[", 
      RowBox[{"psi", "[", "\"\<StateVector\>\"", "]"}], "]"}]}], ";", "\n", 
    "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<encoded\>\"", " ", "->", " ", 
       RowBox[{"Head", "[", "psi", "]"}]}], ",", "\n", "      ", 
      RowBox[{"\"\<left alone by the projector\>\"", " ", "->", " ", 
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"bitFlip", "[", "\"\<Codespace\>\"", "]"}], "[", "psi", 
             "]"}], "[", "\"\<StateVector\>\"", "]"}], "]"}], " ", "-", " ", 
          "v"}], "]"}], " ", "==", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", "8"}], "]"}]}]}], ",", "\n", "      ", 
      RowBox[{"\"\<syndrome probabilities\>\"", " ", "->", " ", 
       RowBox[{"Values", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"bitFlip", "[", "\"\<SyndromeMeasurement\>\"", "]"}], "[", 
           "hit", "]"}], "[", "\"\<Probabilities\>\"", "]"}], "]"}], "]"}]}], 
      ",", "\n", "      ", 
      RowBox[{"\"\<fidelity after recovery\>\"", " ", "->", " ", 
       RowBox[{"Chop", "[", 
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{"Conjugate", "[", "v", "]"}], " ", ".", " ", 
          RowBox[{"Normal", "[", 
           RowBox[{"fixed", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], " ", ".",
           " ", "v"}], "]"}], "]"}]}]}], "|>"}]}]}], "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"encoded\"\>", "\[Rule]", "QuantumState"}], ",", 
   RowBox[{"\<\"left alone by the projector\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"syndrome probabilities\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}]}], ",", 
   RowBox[{"\<\"fidelity after recovery\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"26dca2d1-2715-746d-4ee3-3b9b52a05eb7"]
}, Open  ]],

Cell["The rest of this step looks at each object in turn.", "Text",ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],

Cell[TextData[{
 "The encoder is the isometry ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b853673-18d0-d9fa-19ba-a83d996aabc0"],
 ", as a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25b5b884-ef74-61b3-534a-31e18a013399"],
 ", from 1 logical qubit to 3 physical ones:"
}], "Text",ExpressionUUID->"574a2197-51ef-7938-7d49-b8d1679a4802"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"bitFlip", "[", "\"\<Encoder\>\"", "]"}], "[", "\"\<Order\>\"", 
  "]"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"6e85e9ed-427b-8528-16ba-00b7770fec72"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", "1", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"73b76025-96bb-3fff-214d-798f234f85c5"]
}, Open  ]],

Cell[TextData[{
 "Its columns are the codewords, and they are in ",
 StyleBox["the code's own",
  FontWeight->"Bold"],
 " logical basis: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"|", "0"}], 
     StyleBox["L", "TI"]], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31f4c073-8ff6-126f-678b-da3d298360b5"],
 " is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ff7667-e560-b2c0-2285-68408c1a002a"],
 " eigenstate of the ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c9be80e-0554-61c1-24b8-0268ace1332b"],
 " that ",
 Cell[BoxData[
  RowBox[{"code", "[", "\"\<LogicalZ\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "106b7ad8-6378-599b-4069-7382160d2be1"],
 " reports. That was not automatic. The five-qubit code's encoding circuit \
sends ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "00000"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],
 " to the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "304452a4-201b-d64c-607c-4b0e51afbc96"],
 " eigenstate of that ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],
 " \[LongDash] a valid encoder, but with its labels swapped. Against what ",
 Cell[BoxData["\"\<Codewords\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b5b9263-9199-4e16-7978-144d202c157c"],
 " gives now:"
}], "Text",ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"z", " ", "=", " ", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"QECPauli", "[", 
         RowBox[{"First", "[", 
          RowBox[{"five", "[", "\"\<LogicalZ\>\"", "]"}], "]"}], "]"}], 
        "[", "\"\<Matrix\>\"", "]"}], "]"}]}], ",", " ", "raw", ",", " ", 
     "fixed"}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"raw", " ", "=", " ", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"QuantumCircuitOperator", "[", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"\"\<I\>\"", " ", "->", " ", "q"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"q", ",", " ", "5"}], "}"}]}], "]"}], ",", " ", 
            RowBox[{"five", "[", "\"\<EncodingGates\>\"", "]"}]}], "]"}], 
          "]"}], "[", "\n", "        ", "\"\<QuantumOperator\>\"", "]"}], 
        "[", "\"\<MatrixRepresentation\>\"", "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"fixed", " ", "=", " ", 
     RowBox[{"Normal", "[", 
      RowBox[{
       RowBox[{"First", "[", 
        RowBox[{"five", "[", "\"\<Codewords\>\"", "]"}], "]"}], 
       "[", "\"\<StateVector\>\"", "]"}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<circuit alone\>\"", " ", "->", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "raw", "]"}], " ", ".", " ", "z", " ", ".",
          " ", "raw"}], "]"}]}], ",", "\n", "      ", 
      RowBox[{"\"\<Codewords\>\"", " ", "->", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "fixed", "]"}], " ", ".", " ", "z", " ", ".",
          " ", "fixed"}], "]"}]}]}], "|>"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"circuit alone\"\>", "\[Rule]", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{"\<\"Codewords\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[10]= ",ExpressionUUID->"3343f580-98d5-e31c-6170-ecea1961ce66"]
}, Open  ]],

Cell[TextData[{
 "The projector is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["P", "TI"], "\[LongEqual]", 
    StyleBox["V", "TI"], 
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Dagger]"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a7420b-376a-b23f-505d-6455421c0105"],
 ". It is checked against ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Product]", 
     StyleBox["i", "TI"],
     LimitsPositioning->True], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SubscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["i", "TI"]]}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6af863a9-1098-c609-1a98-7af3a112ad53"],
 ", the same projector built without the encoder:"
}], "Text",ExpressionUUID->"055bc2ad-6b92-a3be-3378-dbf70e24f184"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"p", " ", "=", " ", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"bitFlip", "[", "\"\<Codespace\>\"", "]"}], 
        "[", "\"\<MatrixRepresentation\>\"", "]"}], "]"}]}], ",", " ", "gens",
      ",", " ", 
     RowBox[{"one", " ", "=", " ", 
      RowBox[{"IdentityMatrix", "[", "8", "]"}]}]}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"gens", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{"QECPauli", "[", "#", "]"}], "[", "\"\<Matrix\>\"", "]"}], 
        "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"bitFlip", "[", "\"\<Generators\>\"", "]"}]}]}], ";", "\n", 
    "    ", 
    RowBox[{"p", " ", "==", " ", 
     RowBox[{"Fold", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#1", " ", ".", " ", 
          RowBox[{"(", 
           RowBox[{"one", " ", "+", " ", "#2"}], ")"}]}], " ", "/", " ", 
         "2"}], " ", "&"}], ",", " ", "one", ",", " ", "gens"}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"2b0fb60e-2211-365f-5934-286857a59ca5"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[11]= ",ExpressionUUID->"201a2509-bdd9-2fa1-5039-bd53346c758b"]
}, Open  ]],

Cell[TextData[{
 "The syndrome measurement is a ",
 Cell[BoxData["QuantumMeasurementOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 " with one projector per syndrome. An ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f932952-49a5-d34f-05a0-c11c6851a195"],
 " on the middle qubit trips both checks, syndrome ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "160f17c4-d31a-fe19-3e34-8ea1e6acc563"],
 ", the fourth outcome; and the recovery for that syndrome gives the codeword \
back:"
}], "Text",ExpressionUUID->"10beb8bd-bdb6-ee93-4045-31e73440b4f9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"zero", " ", "=", " ", 
      RowBox[{"First", "[", 
       RowBox[{"bitFlip", "[", "\"\<Codewords\>\"", "]"}], "]"}]}], ",", " ", 
     "hit"}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"hit", " ", "=", " ", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", "\"\<IXI\>\"", "]"}], "[", "zero", 
      "]"}]}], ";", "\n", "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<syndrome\>\"", " ", "->", " ", 
       RowBox[{"bitFlip", "[", 
        RowBox[{"\"\<Syndrome\>\"", ",", " ", "\"\<IXI\>\""}], "]"}]}], ",", 
      "\n", "      ", 
      RowBox[{"\"\<outcome probabilities\>\"", " ", "->", " ", 
       RowBox[{"Values", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"bitFlip", "[", "\"\<SyndromeMeasurement\>\"", "]"}], "[", 
           "hit", "]"}], "[", "\"\<Probabilities\>\"", "]"}], "]"}], "]"}]}], 
      ",", "\n", "      ", 
      RowBox[{"\"\<recovered\>\"", " ", "->", " ", 
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"bitFlip", "[", 
              RowBox[{"\"\<Recovery\>\"", ",", " ", 
               RowBox[{"{", 
                RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}], "[", 
             RowBox[{"QuantumState", "[", 
              RowBox[{"hit", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], 
             "]"}], "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], " ", "-", 
          "\n", "          ", 
          RowBox[{"Normal", "[", 
           RowBox[{"zero", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], 
         "]"}], " ", "==", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"{", 
           RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}]}]}], "|>"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"3fdc991b-fead-14b0-65e3-1144fb587e9a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"syndrome\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}]}], ",", 
   RowBox[{"\<\"outcome probabilities\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}]}], ",", 
   RowBox[{"\<\"recovered\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[12]= ",ExpressionUUID->"3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"]
}, Open  ]],

Cell[TextData[{
 "The same measurement can be asked of the syndrome circuit: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"QECSyndromeCircuit", "[", "code", "]"}], 
   "[", "\"\<SyndromeMeasurement\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0642d375-09f3-9942-2e71-cb3faf87eba8"],
 "."
}], "Text",ExpressionUUID->"0651775d-2bad-791b-2e6f-6f074e584861"],

Cell[TextData[{
 "These four objects are dense \[LongDash] of size ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
