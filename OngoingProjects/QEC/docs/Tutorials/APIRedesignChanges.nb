Cell["The public surface", "Subsection",ExpressionUUID->"37161f66-4600-a3a8-5d2d-974073baf1f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"all", " ", "=", " ", 
      RowBox[{"Names", "[", "\"\<Wolfram`QuantumFramework`QEC`*\>\"", "]"}]}],
      ",", " ", "limits", ",", " ", "predicates"}], "}"}], ",", "\n", "    ", 
   
   RowBox[{
    RowBox[{"limits", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"all", ",", " ", 
       RowBox[{
        RowBox[{"StringStartsQ", "[", 
         RowBox[{"#", ",", " ", "\"\<$\>\""}], "]"}], " ", "&"}]}], "]"}]}], ";",
     "\n", "    ", 
    RowBox[{"predicates", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Complement", "[", 
        RowBox[{"all", ",", " ", "limits"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"StringEndsQ", "[", 
         RowBox[{"#", ",", " ", "\"\<Q\>\""}], "]"}], " ", "&"}]}], "]"}]}], ";",
     "\n", "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<public functions\>\"", " ", "->", " ", 
       RowBox[{"Complement", "[", 
        RowBox[{"all", ",", " ", "limits", ",", " ", "predicates"}], "]"}]}], 
      ",", " ", 
      RowBox[{"\"\<predicates\>\"", " ", "->", " ", "predicates"}], ",", " ", 
      
      RowBox[{"\"\<limits\>\"", " ", "->", " ", "limits"}]}], "|>"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[32]:= ",ExpressionUUID->"2e44757e-c407-f813-567c-6d3bedb3cb79"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"public functions\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"QECCatState\"\>", ",", "\<\"QECClearCache\"\>", 
      ",", "\<\"QECCliffordHierarchyLevel\"\>", ",", "\<\"QECCode\"\>", 
      ",", "\<\"QECConcatenate\"\>", ",", "\<\"QECDecoder\"\>", 
      ",", "\<\"QECDetectorModel\"\>", ",", "\<\"QECErrorCorrection\"\>", 
      ",", "\<\"QECExtendedRectangle\"\>", 
      ",", "\<\"QECFaultTolerantCircuit\"\>", 
      ",", "\<\"QECLogicalErrorRate\"\>", ",", "\<\"QECNoiseModel\"\>", 
      ",", "\<\"QECPasteCodes\"\>", ",", "\<\"QECPauli\"\>", 
      ",", "\<\"QECPauliMeasurement\"\>", ",", "\<\"QECPseudothreshold\"\>", 
      ",", "\<\"QECRegister\"\>", ",", "\<\"QECRemoveQubit\"\>", 
      ",", "\<\"QECStim\"\>", ",", "\<\"QECSyndromeCircuit\"\>", 
      ",", "\<\"QECThreshold\"\>", ",", "\<\"QECTransversalGate\"\>"}], 
     "}"}]}], ",", 
   RowBox[{"\<\"predicates\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"QECCatStateQ\"\>", ",", "\<\"QECCodeQ\"\>", 
      ",", "\<\"QECDecoderQ\"\>", ",", "\<\"QECDetectorModelQ\"\>", 
      ",", "\<\"QECErrorCorrectionQ\"\>", 
      ",", "\<\"QECExtendedRectangleQ\"\>", 
      ",", "\<\"QECFaultTolerantCircuitQ\"\>", ",", "\<\"QECNoiseModelQ\"\>", 
