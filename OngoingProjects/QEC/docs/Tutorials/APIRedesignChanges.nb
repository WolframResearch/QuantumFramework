     "733995c2-f5bf-78ee-22c6-0caffc4a4a34"]], "TableText",ExpressionUUID->
     "4f8ab258-7e7f-0723-7589-34027b0a6a09"], Cell[TextData[Cell[BoxData[
    "QuantumOperator"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6b12ee74-9953-131d-1921-003e18e67e67"]], "TableText",ExpressionUUID->
     "65262d3c-fccc-1dc6-0cdd-c579f579672c"], Cell[TextData[{
     "a linear map between qubits (here the isometry ",
     Cell[BoxData[
      FormBox[
       StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5e157ee2-48da-d240-062b-77cc696ca0aa"],
     ", 1 qubit in, ",
     Cell[BoxData[
