Notebook[{

Cell[CellGroupData[{
Cell["The QEC API Redesign: What Changed and Why", "Title",
 CellID->509267359,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 "This note walks through, with runnable examples, everything that changed in \
the QEC layer in response to the API audit (",
 Cell["QEC-API-Audit-and-Redesign.md", "InlineCode",ExpressionUUID->
  "4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 "). The plan that was followed, with its steps and the status of every \
observation, is ",
 Cell["QEC-API-Redesign-Plan.md", "InlineCode",ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 "; this note is the same work seen running."
}], "Text",ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell[TextData[{
 "The idea in one sentence: ",
 StyleBox["the mathematics did not change, the face did.",
  FontWeight->"Bold"],
 " The 593 tests that existed at the start passed after every step, and there \
are now 687. What changed is how the layer is asked things: through the \
objects the rest of the framework uses (",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a568a6-87a2-527f-535a-810032572145"],
 ", ",
 Cell[BoxData["QuantumChannel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 ", ",
 Cell[BoxData["QuantumMeasurementOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 ", ",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5902d484-617f-9570-0f31-cdee100bfc5a"],
 "), with one return type per function, and with fewer public names."
}], "Text",ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5708d032-2150-04f2-7d37-ca7c50e56ed8"], Cell["step", "TableText",
     FontWeight->Bold,ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"],
     Cell["what was done", "TableText",
     FontWeight->Bold,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "234f1fb7-07c6-bba9-5174-96f1b27009f3"], Cell[
    "1", "TableText",ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"], 
    Cell["three small fixes the audit asked for", "TableText",ExpressionUUID->
     "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6ec9a758-58be-624c-16f6-3f02594b3096"], Cell[
    "2", "TableText",ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"], 
    Cell["the gadgets hand back framework circuits", "TableText",
     ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "569e173f-6b36-b240-7ea5-8f790ec000aa"], Cell[
    "3", "TableText",ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"], 
    Cell["a code presents itself as quantum operations", "TableText",
     ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2867ea9b-6e8d-517b-581c-03c50b382041"], Cell[
    "4", "TableText",ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"], 
    Cell["the error rate has one return type; decoders are objects", 
     "TableText",ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"], Cell[
    "5", "TableText",ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"], 
    Cell["the renames, all at once, with aliases for the old names", 
     "TableText",ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "07964fa7-8d1e-ff14-2dae-660124a8c27e"], Cell[
    "6", "TableText",ExpressionUUID->"3e367b18-9aa8-58f9-67ce-73421f5d2ac3"], 
    Cell["gate matrices are read from the framework", "TableText",
     ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "77d99fdb-a351-2d53-1de6-1684d6e477b9"], Cell[
    "7", "TableText",ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"], 
    Cell["documentation and tests", "TableText",ExpressionUUID->
     "1cbde497-e826-5557-4442-fdd089d33fbd"]}
  }]], "2ColumnTableMod",ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell["Definition", "Section",ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell[TextData[{
 "The QEC layer still lives in ",
 Cell["OngoingProjects/QEC/", "InlineCode",ExpressionUUID->
  "1f908cf3-3c70-d55a-45af-25bdb50abfa0"],
 ", outside the paclet, so this page loads both the framework and the layer:"
}], "Text",ExpressionUUID->"5dac66ba-272d-3627-0b54-7fe452d99d0d"],

