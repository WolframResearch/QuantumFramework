Cell["The logical channel", "Subsection",ExpressionUUID->"6833ae6a-6ac5-a2c8-19c0-40340f71f012"],

Cell[TextData[{
 "Encoding, applying the noise, measuring the syndrome, recovering and \
decoding is one channel on the logical qubit. Building it literally goes \
through a ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["4", 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7f2999-1aee-25a5-0504-c0c39e988f8f"],
 "-dimensional superoperator. But for Pauli noise on a stabilizer code the \
net result is always a logical Pauli, so the logical channel is a Pauli \
channel with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["4", 
    StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "128c7526-c883-085d-42b4-6c83e9365aa7"],
 " weights, and those weights are exactly the coset probabilities the \
maximum-likelihood decoder already computed. So it comes out exact, symbolic, \
and cheap:"
}], "Text",ExpressionUUID->"3279c00f-c9e2-8758-6206-da68ef94eda2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bitFlip", "[", 
  RowBox[{"\"\<LogicalPauliProbabilities\>\"", ",", " ", 
   RowBox[{"QECNoiseModel", "[", 
    RowBox[{"\"\<BitFlip\>\"", "[", "p", "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"50b12ff8-e606-85f7-004e-c6a593b0efdd"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"I\"\>", "\[Rule]", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "p"}], ")"}], "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"2", " ", "p"}]}], ")"}]}]}], ",", 
   RowBox[{"\<\"X\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", "-", 
       RowBox[{"2", " ", "p"}]}], ")"}], " ", 
     SuperscriptBox["p", "2"]}]}], ",", 
   RowBox[{"\<\"Y\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"Z\"\>", "\[Rule]", "0"}]}], "\[RightAssociation]"}]], "Output",\

 CellLabel->
  "Out[14]= ",ExpressionUUID->"640f47a5-4648-c62d-0c35-5e0f73e2ad77"]
}, Open  ]],

Cell["\<\
This is decision A in one line: the logical error rate is one minus the \
identity weight, and the two agree coefficient for coefficient:\
\>", "Text",ExpressionUUID->"63a48922-0fac-666c-115b-208caa594cb6"],

