Cell["Step 1: three small fixes", "Section",ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

Cell[TextData[{
 Cell[BoxData["\"\<Decoder\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 " appeared twice in the property list, because it has two call shapes (",
 Cell[BoxData[
  RowBox[{"code", "[", "\"\<Decoder\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04786d0e-016a-d127-2c07-8568b01ca00d"],
 " and ",
 Cell[BoxData[
  RowBox[{"code", "[", 
   RowBox[{"\"\<Decoder\>\"", ",", " ", "noise"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],
 "). It now appears once:"
}], "Text",ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

