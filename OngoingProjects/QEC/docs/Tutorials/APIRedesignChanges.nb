Cell[TextData[{
 "The property that matters is that the translation neither drops nor invents \
anything: one instruction, one operator. Resets and measurements survive (",
 Cell[BoxData[
  RowBox[{"\"\<M\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19bb1c5e-57ab-6e36-4f58-9618625e351c"],
 " is the ",
 StyleBox["identity", "TI"],
 " in the framework, so ",
 Cell[BoxData[
  RowBox[{"\"\<Measurement\>\"", " ", "->", " ", "q"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],
 " is used), and ",
 Cell[BoxData["Sdg"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30baa1c8-66ad-75e0-6059-389213585fca"],
 " is one box, not three ",
 Cell[BoxData["S"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52535901-cb26-8b9c-0261-516aeed0d9e6"],
 ":"
}], "Text",ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"QECTransversalGate", "[", 
      RowBox[{"steane", ",", " ", "\"\<S\>\""}], "]"}]}], "}"}], ",", "\n", 
   "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"g", "[", "\"\<Instructions\>\"", "]"}], "]"}], ",", " ", 
     RowBox[{"Length", "[", 
      RowBox[{
       RowBox[{"g", "[", "\"\<QuantumCircuitOperator\>\"", "]"}], 
       "[", "\"\<Operators\>\"", "]"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"7", ",", "7"}], "}"}]], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"511b3347-8d7d-ab60-0738-ab212409f64a"]
}, Open  ]],

Cell["Step 3: a code as quantum operations", "Section",ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"],

Cell[TextData[{
 "This is the core of the redesign. The theory of error correction (Knill\
\[Dash]Laflamme\[Dash]Viola) describes a code with five objects: an encoding \
isometry, a projector onto the code space, a syndrome measurement, a recovery \
per syndrome and, composing all of it, a channel on the logical qubit. \
Before, the layer gave none of them; now a code gives them all. The new file \
is ",
 Cell["Operational.wl", "InlineCode",ExpressionUUID->
  "6815cd54-0cd7-196f-182a-e51ea5626bb5"],
 "."
}], "Text",ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"],

Cell[TextData[{
 StyleBox["Nothing new was invented to hold them.",
  FontWeight->"Bold"],
 " The framework already had an object for each of these ideas, and each \
property returns that object:"
}], "Text",ExpressionUUID->"5900aac7-5263-773e-0f3f-43a167165a04"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"], Cell["property", "TableText",
