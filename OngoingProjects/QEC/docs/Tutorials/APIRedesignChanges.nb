     " out)"
    }], "TableText",ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1daed7d3-93e8-7698-4b55-ce9d259d5ce2"], Cell[TextData[Cell[BoxData[
     RowBox[{"code", "[", "\"\<Codewords\>\"", "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "187adc3d-3961-76c2-4819-d667b8145c28"]], "TableText",ExpressionUUID->
     "641c78eb-7f03-7846-0c24-71b57ab64aac"], Cell[TextData[{
     "a list of ",
     Cell[BoxData["QuantumState"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5bfcc75d-c21d-6fb0-0983-df06f7a8359a"]
    }], "TableText",ExpressionUUID->"112ae6ec-4b5c-6ad2-4729-ffb66ee93838"], 
    Cell["a state", "TableText",ExpressionUUID->
     "6121b9de-dddd-aca8-10de-309bd469f6f2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "30209679-023a-ee91-61df-0823b7ccb4fb"], Cell[TextData[Cell[BoxData[
     RowBox[{"code", "[", "\"\<Codespace\>\"", "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "29bc1606-c22d-409d-5f43-8863f7d812e7"]], "TableText",ExpressionUUID->
     "7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"], Cell[TextData[Cell[BoxData[
    "QuantumOperator"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3119d855-3ffd-7401-6726-d21fb9885f6b"]], "TableText",ExpressionUUID->
     "62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"], Cell[TextData[{
     "an operator (here the projector ",
     Cell[BoxData[
      FormBox[
       RowBox[{
        StyleBox["P", "TI"], "\[LongEqual]", 
        StyleBox["V", "TI"], 
        SuperscriptBox[
         StyleBox["V", "TI"], "\[Dagger]"]}], TraditionalForm]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],
     ")"
    }], "TableText",ExpressionUUID->"51fce014-dca1-0630-0783-fa51d5546d1a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "657c1c65-980e-511d-1303-964f19bb2067"], Cell[TextData[Cell[BoxData[
     RowBox[{"code", "[", "\"\<SyndromeMeasurement\>\"", "]"}]], 
     "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"]], "TableText",ExpressionUUID->
     "7e9b7e66-629a-1114-26b9-7040172f607e"], Cell[TextData[Cell[BoxData[
    "QuantumMeasurementOperator"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "585a51e6-774f-2dd2-087a-48c002fa7738"]], "TableText",ExpressionUUID->
     "1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"], Cell[
    "a measurement with one projector per outcome", "TableText",
     ExpressionUUID->"370294fd-9e49-2d35-5d31-0da71bfc741f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2845529c-454d-b13b-587b-4bc66cf90001"], Cell[TextData[Cell[BoxData[
     RowBox[{"code", "[", 
      RowBox[{"\"\<Recovery\>\"", ",", " ", "s"}], "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7519012f-e657-215b-2326-988893e273a1"]], "TableText",ExpressionUUID->
     "594776df-9e75-d16a-0f7d-6f991b01a3b0"], Cell[TextData[Cell[BoxData[
    "QuantumChannel"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
