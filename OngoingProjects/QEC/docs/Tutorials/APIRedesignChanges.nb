Cell[TextData[{
 "The projector is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["P", "TI"], "\[LongEqual]", 
    StyleBox["V", "TI"], 
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Dagger]"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "475d7054-346c-a3cc-6d63-6a1ebd1ef116"],
 ". It is checked against ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Product]", 
     StyleBox["i", "TI"],
     LimitsPositioning->True], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SubscriptBox[
       StyleBox["g", "TI"], 
       StyleBox["i", "TI"]]}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],
 ", the same projector built without the encoder:"
}], "Text",ExpressionUUID->"3343f580-98d5-e31c-6170-ecea1961ce66"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"p", " ", "=", " ", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"bitFlip", "[", "\"\<Codespace\>\"", "]"}], 
        "[", "\"\<MatrixRepresentation\>\"", "]"}], "]"}]}], ",", " ", "gens",
      ",", " ", 
     RowBox[{"one", " ", "=", " ", 
      RowBox[{"IdentityMatrix", "[", "8", "]"}]}]}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"gens", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{"QECPauli", "[", "#", "]"}], "[", "\"\<Matrix\>\"", "]"}], 
        "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"bitFlip", "[", "\"\<Generators\>\"", "]"}]}]}], ";", "\n", 
    "    ", 
    RowBox[{"p", " ", "==", " ", 
     RowBox[{"Fold", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#1", " ", ".", " ", 
          RowBox[{"(", 
           RowBox[{"one", " ", "+", " ", "#2"}], ")"}]}], " ", "/", " ", 
         "2"}], " ", "&"}], ",", " ", "one", ",", " ", "gens"}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"20a7420b-376a-b23f-505d-6455421c0105"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[11]= ",ExpressionUUID->"6af863a9-1098-c609-1a98-7af3a112ad53"]
}, Open  ]],

Cell[TextData[{
 "The syndrome measurement is a ",
 Cell[BoxData["QuantumMeasurementOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "055bc2ad-6b92-a3be-3378-dbf70e24f184"],
 " with one projector per syndrome. An ",
 Cell[BoxData[
  FormBox[
   StyleBox["X", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0fb60e-2211-365f-5934-286857a59ca5"],
 " on the middle qubit trips both checks, syndrome ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "201a2509-bdd9-2fa1-5039-bd53346c758b"],
 ", the fourth outcome; and the recovery for that syndrome gives the codeword \
back:"
}], "Text",ExpressionUUID->"7085d256-6adc-aa08-20ba-d4100f6ef952"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"zero", " ", "=", " ", 
      RowBox[{"First", "[", 
       RowBox[{"bitFlip", "[", "\"\<Codewords\>\"", "]"}], "]"}]}], ",", " ", 
     "hit"}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"hit", " ", "=", " ", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", "\"\<IXI\>\"", "]"}], "[", "zero", 
      "]"}]}], ";", "\n", "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<syndrome\>\"", " ", "->", " ", 
       RowBox[{"bitFlip", "[", 
        RowBox[{"\"\<Syndrome\>\"", ",", " ", "\"\<IXI\>\""}], "]"}]}], ",", 
      "\n", "      ", 
      RowBox[{"\"\<outcome probabilities\>\"", " ", "->", " ", 
       RowBox[{"Values", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"bitFlip", "[", "\"\<SyndromeMeasurement\>\"", "]"}], "[", 
           "hit", "]"}], "[", "\"\<Probabilities\>\"", "]"}], "]"}], "]"}]}], 
      ",", "\n", "      ", 
      RowBox[{"\"\<recovered\>\"", " ", "->", " ", 
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"bitFlip", "[", 
              RowBox[{"\"\<Recovery\>\"", ",", " ", 
               RowBox[{"{", 
                RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}], "[", 
             RowBox[{"QuantumState", "[", 
              RowBox[{"hit", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], 
             "]"}], "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], " ", "-", 
          "\n", "          ", 
          RowBox[{"Normal", "[", 
           RowBox[{"zero", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], 
         "]"}], " ", "==", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"{", 
           RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}]}]}], "|>"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"5f932952-49a5-d34f-05a0-c11c6851a195"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"syndrome\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}]}], ",", 
   RowBox[{"\<\"outcome probabilities\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}]}], ",", 
   RowBox[{"\<\"recovered\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[12]= ",ExpressionUUID->"160f17c4-d31a-fe19-3e34-8ea1e6acc563"]
}, Open  ]],

