   {Cell["      ", "ModInfo",ExpressionUUID->
     "6e1c99a5-dcef-9c28-1623-100ed49be772"], Cell[
    "A", "TableText",ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"], 
    Cell["Is the rate read from the logical channel?", "TableText",
     ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"], Cell[TextData[{
     StyleBox["Yes",
      FontWeight->"Bold"],
     ", but the channel is built from the coset engine, not by composing \
dense channels, so it stays exact and symbolic"
    }], "TableText",ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "337c2d89-644e-5b5e-6103-c4d30dfb29a4"], Cell[
    "B", "TableText",ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"], 
    Cell[TextData[{
     "Do the constructions (",
     Cell[BoxData["QECConcatenate"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
     ", ",
     Cell[BoxData["QECPasteCodes"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
     ", ",
