Cell["The public surface", "Subsection",ExpressionUUID->"640353f1-ff8e-e9b3-0c31-4abafa38bb99"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"all", " ", "=", " ", 
      RowBox[{"Names", "[", "\"\<Wolfram`QuantumFramework`QEC`*\>\"", "]"}]}],
      ",", " ", "old", ",", " ", "limits"}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"old", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<QECPauliVector\>\"", ",", " ", "\"\<QECPauliString\>\"", ",",
        " ", "\"\<QECPauliWeight\>\"", ",", " ", "\"\<QECPauliCommuteQ\>\"", ",",
        " ", "\"\<QECPauliProduct\>\"", ",", "\n", 
       "        ", "\"\<QECPauliPhase\>\"", ",", 
       " ", "\"\<QECFaultTolerant\>\"", ",", " ", "\"\<QECStimCircuit\>\"", ",",
        " ", "\"\<QECCodeCatalog\>\"", ",", 
       " ", "\"\<QECClassicalHammingMatrix\>\""}], "}"}]}], ";", "\n", "    ", 
    RowBox[{"limits", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"all", ",", " ", 
       RowBox[{
        RowBox[{"StringStartsQ", "[", 
         RowBox[{"#", ",", " ", "\"\<$\>\""}], "]"}], " ", "&"}]}], "]"}]}], ";",
     "\n", "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<public functions\>\"", " ", "->", " ", 
       RowBox[{"Complement", "[", 
        RowBox[{"all", ",", " ", "old", ",", " ", "limits"}], "]"}]}], ",", 
      " ", 
      RowBox[{"\"\<limits\>\"", " ", "->", " ", "limits"}]}], "|>"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[33]:= ",ExpressionUUID->"37161f66-4600-a3a8-5d2d-974073baf1f2"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"public functions\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"QECCatState\"\>", ",", "\<\"QECClearCache\"\>", 
      ",", "\<\"QECCliffordHierarchyLevel\"\>", ",", "\<\"QECCode\"\>", 
      ",", "\<\"QECConcatenate\"\>", ",", "\<\"QECDecoder\"\>", 
      ",", "\<\"QECDetectorModel\"\>", ",", "\<\"QECErrorCorrection\"\>", 
      ",", "\<\"QECFaultTolerantCircuit\"\>", 
      ",", "\<\"QECLogicalErrorRate\"\>", ",", "\<\"QECNoiseModel\"\>", 
      ",", "\<\"QECPasteCodes\"\>", ",", "\<\"QECPauli\"\>", 
      ",", "\<\"QECPauliMeasurement\"\>", ",", "\<\"QECPauliQ\"\>", 
      ",", "\<\"QECPseudothreshold\"\>", ",", "\<\"QECRegister\"\>", 
      ",", "\<\"QECRemoveQubit\"\>", ",", "\<\"QECStim\"\>", 
      ",", "\<\"QECSyndromeCircuit\"\>", ",", "\<\"QECTransversalGate\"\>"}], 
     "}"}]}], ",", 
   RowBox[{"\<\"limits\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"$QECDecoderSubsetLimit\"\>", 
      ",", "\<\"$QECDenseQubitLimit\"\>", 
      ",", "\<\"$QECExactDetectorLimit\"\>", 
      ",", "\<\"$QECExactEnumerationLimit\"\>", 
      ",", "\<\"$QECStabilizerGroupLimit\"\>"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->
  "Out[33]= ",ExpressionUUID->"2e44757e-c407-f813-567c-6d3bedb3cb79"]
}, Open  ]],

Cell[TextData[{
 "There were 26 functions at the start. It is not the \"about 16\" the audit \
estimated, because ",
 Cell[BoxData["QECDecoder"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"],
 " was added and the three constructions stayed functions (decision B)."
}], "Text",ExpressionUUID->"539b0e4e-9e5a-5525-01b8-a0281bef3c0f"],

Cell["Step 6: transversal gates", "Section",ExpressionUUID->"1cd82739-42e3-b7ed-44e7-bf6376971d37"],

Cell[TextData[{
 Cell["Transversal.wl", "InlineCode",ExpressionUUID->
  "0971a20b-7913-467e-3f0e-445578a62d44"],
 " had the gate matrices copied by hand from the framework; a copy is a \
second convention that can drift. They are now read from ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09df342d-d743-5809-3fe4-ae76e2f62b53"],
 " at load time:"
}], "Text",ExpressionUUID->"0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumOperator", "[", "\"\<S\>\"", "]"}], "[", "\"\<Dagger\>\"",
      "]"}], "[", "\"\<MatrixRepresentation\>\"", "]"}], "]"}], " ", "===", 
  "\n", "    ", 
  RowBox[{
  "Wolfram`QuantumFramework`QEC`Transversal`PackagePrivate`$\
transversalGateMatrix", "[", "\"\<Sdg\>\"", "]"}]}]], "Input",
 CellLabel->
  "In[34]:= ",ExpressionUUID->"21fdaace-430e-f3f9-5782-43a876b8c1c3"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[34]= ",ExpressionUUID->"1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"]
}, Open  ]],

Cell[TextData[{
 "The audit also asked for a primitive the framework does not have: \
conjugating a Pauli through a Clifford while keeping its phase. The kernel \
was not touched; it is written up as a proposal in ",
 Cell["QF-Clifford-Conjugation-Proposal.md", "InlineCode",ExpressionUUID->
  "10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],
 ". ",
 Cell[BoxData["CliffordChannel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c6bfc6-0792-5005-77fd-36a0b227236f"],
 " already holds the table needed; what is missing is a constructor from a \
Clifford ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62752e4e-571f-d961-120a-c02862aba84b"],
 " and a ",
 Cell[BoxData[
  RowBox[{"cc", "[", 
   RowBox[{"\"\<Conjugate\>\"", ",", " ", "P"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],
 " query."
}], "Text",ExpressionUUID->"166277e1-e8de-815f-3e12-6eca8968d3a5"],

Cell["Step 7: documentation and tests", "Section",ExpressionUUID->"0ae7a534-7379-468c-3a9c-3d7e060c2cd6"],

Cell[TextData[{
 Cell[BoxData["StabilizerCodes"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34baef30-7963-b757-5c59-077a78171dbd"],
 " has two new sections (a code as quantum operations, and decoders as \
objects) and six new rows in its table of checks."
}], "Item",ExpressionUUID->"15ce0314-20ee-2b64-43f5-9b5e509b764e"],

Cell[TextData[{
 Cell[BoxData["QECCoreInternals"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38a9ac88-4644-6c0e-6856-45d273f13754"],
 " has three new sections: ",
 Cell["Operational.wl", "InlineCode",ExpressionUUID->
  "64802aa2-b136-451c-0cbf-c30fc0c32c66"],
 ", ",
 Cell["Decoder.wl", "InlineCode",ExpressionUUID->
  "67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"],
 " and ",
 Cell["Deprecated.wl", "InlineCode",ExpressionUUID->
  "233ecb8e-17f3-8d32-52c5-e2e8a187d418"],
 "."
}], "Item",ExpressionUUID->"7dd949a9-d8cf-50b3-2be7-60f2d97a2299"],

Cell["\<\
All three tech notes use the new notation throughout; their 262 cells were \
validated and the notebooks rebuilt.\
\>", "Item",ExpressionUUID->"4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],

Cell["\<\
The README, the roadmap and the plan carry the new numbers; the plan has a \
status column for each of the audit's 16 observations.\
\>", "Item",ExpressionUUID->"598f41e5-f1df-a461-0fb5-58ce806b0f4b"],

