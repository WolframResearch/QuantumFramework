   {Cell["      ", "ModInfo",ExpressionUUID->
     "539491e8-328f-8d7b-01ab-08b2473bd441"], Cell[TextData[Cell[BoxData[
     RowBox[{"code", "[", 
      RowBox[{"\"\<LogicalChannel\>\"", ",", " ", "noise"}], "]"}]], 
     "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"]], "TableText",ExpressionUUID->
     "023f49e2-a747-9723-33c5-60cfd2f3fa09"], Cell[TextData[Cell[BoxData[
    "QuantumChannel"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "21aa1c49-e16c-f406-57a9-9612901edf6c"]], "TableText",ExpressionUUID->
     "289b85cd-827f-9a9c-58b8-1c97370be8e6"], Cell[
    "a channel (here on the logical qubit)", "TableText",ExpressionUUID->
     "12f3dbee-abc4-6375-4280-d2cbce714e5f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"], Cell[TextData[Cell[BoxData[
