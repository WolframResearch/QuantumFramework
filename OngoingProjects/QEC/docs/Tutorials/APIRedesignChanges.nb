   RowBox[{"code", ",", " ", "noise"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f7ea056-2d28-85ec-7505-3a1044c2ef36"],
 " is maximum likelihood (or, at circuit level, the detector model's decoder) \
and ",
 Cell[BoxData[
  RowBox[{"QECDecoder", "[", "dem", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b00368-b832-202d-3e4f-9b3239c77377"],
 " is the detector model's rule. None of them re-implements anything: they \
call the same function that already decoded, so the herald filter that moved \
the exponent from 1.73 to 1.965 is kept, and a test checks it table against \
table."
}], "Text",ExpressionUUID->"06d00634-a672-f252-2eef-9871d304c0b8"],

Cell[TextData[{
 "The fourth form is the way in for any other decoder: ",
 Cell[BoxData[
  RowBox[{"QECDecoder", "[", 
   RowBox[{"code", ",", " ", "f"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],
 " wraps a function from syndrome to correction (PyMatching through ",
 Cell[BoxData["ExternalEvaluate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583a98af-415b-100e-09d9-110970ee6354"],
 ", a neural network, a lookup), and the rate scores it with the same \
machinery as the others. The decoder that never corrects anything fails \
whenever anything happens:"
}], "Text",ExpressionUUID->"07beae85-a317-6bf9-2d45-47eed6a239c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"QECLogicalErrorRate", "[", 
   RowBox[{"bitFlip", ",", " ", 
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<BitFlip\>\"", ",", " ", "p"}], "]"}], ",", "\n", "    ", 
    RowBox[{"\"\<Decoder\>\"", " ", "->", " ", 
     RowBox[{"QECDecoder", "[", 
      RowBox[{"bitFlip", ",", " ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"#", " ", "===", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}]}], ",", " ", "\"\<III\>\"", ",",
           " ", 
          RowBox[{"Missing", "[", "]"}]}], "]"}], " ", "&"}]}], "]"}]}]}], 
   "]"}], "]"}]], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],

Cell[BoxData[
 RowBox[{"p", " ", 
  RowBox[{"(", 
   RowBox[{"3", "-", 
    RowBox[{"3", " ", "p"}], "+", 
    SuperscriptBox["p", "2"]}], ")"}]}]], "Output",
 CellLabel->
  "Out[25]= ",ExpressionUUID->"60049622-f570-0e0e-103b-0f8ffc055554"]
}, Open  ]],

Cell["Step 5: the renames", "Section",ExpressionUUID->"40ea559d-da93-7842-70ea-4cc6df264aa8"],

