Cell[TextData[Cell[BoxData["QECDecoder"], "InlineFormula",
 FontSize->0.9 
  Inherited,ExpressionUUID->"4f6d713e-2461-11c8-7513-69784d146312"]], \
"Subsection",ExpressionUUID->"14ad582f-66ff-93eb-3c53-5189128be131"],

Cell["\<\
There were three decoders inside the layer \[LongDash] the minimum-weight \
table, maximum likelihood over cosets, and the detector model's rule \
\[LongDash] but they could only be chosen with a string. Now they are objects:\
\>", "Text",ExpressionUUID->"4f7ea056-2d28-85ec-7505-3a1044c2ef36"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"QECDecoder", "[", "steane", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"d", "[", "\"\<Method\>\"", "]"}], ",", " ", 
     RowBox[{"d", "[", 
      RowBox[{"\"\<Decode\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", " ", "0", ",", " ", "0", ",", " ", "1", ",", " ", "1", ",", 
         " ", "1"}], "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"16b00368-b832-202d-3e4f-9b3239c77377"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"MinimumWeight\"\>", ",", "\<\"IIIIIIX\"\>"}], "}"}]], "Output",\

 CellLabel->
  "Out[24]= ",ExpressionUUID->"06d00634-a672-f252-2eef-9871d304c0b8"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"QECDecoder", "[", 
   RowBox[{"code", ",", " ", "noise"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],
 " is maximum likelihood (or, at circuit level, the detector model's decoder) \
and ",
 Cell[BoxData[
  RowBox[{"QECDecoder", "[", "dem", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583a98af-415b-100e-09d9-110970ee6354"],
 " is the detector model's rule. None of them re-implements anything: they \
call the same function that already decoded, so the herald filter that moved \
the exponent from 1.73 to 1.965 is kept, and a test checks it table against \
table."
}], "Text",ExpressionUUID->"07beae85-a317-6bf9-2d45-47eed6a239c3"],

Cell[TextData[{
 "The fourth form is the way in for any other decoder: ",
 Cell[BoxData[
  RowBox[{"QECDecoder", "[", 
   RowBox[{"code", ",", " ", "f"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],
 " wraps a function from syndrome to correction (PyMatching through ",
 Cell[BoxData["ExternalEvaluate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60049622-f570-0e0e-103b-0f8ffc055554"],
 ", a neural network, a lookup), and the rate scores it with the same \
machinery as the others. The decoder that never corrects anything fails \
whenever anything happens:"
}], "Text",ExpressionUUID->"40ea559d-da93-7842-70ea-4cc6df264aa8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"QECLogicalErrorRate", "[", 
   RowBox[{"bitFlip", ",", " ", 
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<BitFlip\>\"", "[", "p", "]"}], "]"}], ",", "\n", "    ", 
    RowBox[{"\"\<Decoder\>\"", " ", "->", " ", 
     RowBox[{"QECDecoder", "[", 
      RowBox[{"bitFlip", ",", " ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"#", " ", "===", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}]}], ",", " ", "\"\<III\>\"", ",",
           " ", 
          RowBox[{"Missing", "[", "]"}]}], "]"}], " ", "&"}]}], "]"}]}]}], 
   "]"}], "]"}]], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"23ccc6ee-92c0-e596-51f3-dfc8277acffc"],

Cell[BoxData[
 RowBox[{"p", " ", 
  RowBox[{"(", 
   RowBox[{"3", "-", 
    RowBox[{"3", " ", "p"}], "+", 
    SuperscriptBox["p", "2"]}], ")"}]}]], "Output",
 CellLabel->
  "Out[25]= ",ExpressionUUID->"114d8d02-b276-9c05-4772-256fc700e76f"]
}, Open  ]],

Cell["Step 5: the renames", "Section",ExpressionUUID->"2dc22b63-32d1-862f-5bf1-c34d4765ed75"],

