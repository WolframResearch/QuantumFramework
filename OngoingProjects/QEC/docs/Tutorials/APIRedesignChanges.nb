     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{"3", " ", "q"}], "4"]}], ",", 
     FractionBox["q", "4"], ",", 
     FractionBox["q", "4"], ",", 
     FractionBox["q", "4"]}], "}"}], ",", 
   RowBox[{
    RowBox[{"3", " ", 
     SuperscriptBox["p", "2"]}], "-", 
