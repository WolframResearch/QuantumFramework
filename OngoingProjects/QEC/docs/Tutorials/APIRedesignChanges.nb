   {Cell["      ", "ModInfo",ExpressionUUID->
     "277956ac-4c9d-d338-4d07-4ff66529be02"], Cell[TextData[Cell[BoxData[
     RowBox[{"QECFaultTolerantCircuit", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<R\>\"", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<CNOT\>\"", ",", " ", "1", ",", " ", "2"}], "}"}], ",", 
         " ", 
