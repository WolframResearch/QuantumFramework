Cell["\<\
And the detector model, which is where heralds come from, answers the same as \
properties:\
\>", "Text",ExpressionUUID->"4139b36b-52b1-2977-70c6-2b356744785d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dem", " ", "=", " ", 
     RowBox[{"QECDetectorModel", "[", 
      RowBox[{"bitFlip", ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<Circuit\>\"", "[", 
         RowBox[{"1", "/", "1000"}], "]"}], "]"}], ",", " ", "1"}], "]"}]}], 
    "}"}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"dem", "[", "\"\<LogicalErrorRate\>\"", "]"}], " ", "===", " ", 
      
      RowBox[{"QECLogicalErrorRate", "[", 
       RowBox[{"bitFlip", ",", " ", 
        RowBox[{"QECNoiseModel", "[", 
         RowBox[{"\"\<Circuit\>\"", "[", 
          RowBox[{"1", "/", "1000"}], "]"}], "]"}], ",", " ", 
        RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], ",", "\n",
      "     ", 
     RowBox[{"dem", "[", "\"\<Acceptance\>\"", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"494d6e39-7750-b6eb-7f72-806302ea1c31"],

