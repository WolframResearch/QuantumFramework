   "\n", "    ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"1", " ", "-", " ", 
     RowBox[{
      RowBox[{"steane", "[", 
       RowBox[{"\"\<LogicalPauliProbabilities\>\"", ",", " ", "noise"}], 
       "]"}], "[", "\"\<I\>\"", "]"}], " ", "-", " ", 
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{"steane", ",", " ", "noise"}], "]"}]}], "]"}]}], "]"}]], "Input",\

