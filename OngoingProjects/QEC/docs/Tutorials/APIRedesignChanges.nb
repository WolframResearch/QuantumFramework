     "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3fd09d86-aea1-a602-65ef-14e3cb550d68"]], "TableText",ExpressionUUID->
     "2f6c0922-6605-ed68-5513-a08c13b1b7b2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2caab86a-2af9-b1b1-54a9-32344e8d039b"], Cell[TextData[Cell[BoxData[
