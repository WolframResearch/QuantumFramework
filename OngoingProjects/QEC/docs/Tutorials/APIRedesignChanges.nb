      "55f417ec-7166-d78d-038b-8eb60010bdd7"],
     "; \"Protocol\" is kept for the Definition 10.5 object"
    }], "TableText",ExpressionUUID->"4b6e5dad-9702-0c1f-7916-54f722b75765"]}
  }]], "3ColumnTableMod",ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell["Step 1: three small fixes", "Section",ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell[TextData[{
 Cell[BoxData["\"\<Decoder\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 " appeared twice in the property list, because it has two call shapes (",
 Cell[BoxData[
  RowBox[{"code", "[", "\"\<Decoder\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 " and ",
 Cell[BoxData[
  RowBox[{"code", "[", 
   RowBox[{"\"\<Decoder\>\"", ",", " ", "noise"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea251ed-865f-e03c-1652-48b733ebb306"],
 "). It now appears once:"
}], "Text",ExpressionUUID->"25a0bfbe-b1d4-2428-535f-36fbc0668f72"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Count", "[", 
  RowBox[{
   RowBox[{"steane", "[", "\"\<Properties\>\"", "]"}], ",", 
   " ", "\"\<Decoder\>\""}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell[BoxData["1"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["QECPauliMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1ff276-b82a-c3ca-5b24-f43039dc9110"],
 " validated its Pauli with a ",
 Cell[BoxData[
  RowBox[{"Quiet", "[", 
   RowBox[{"Check", "[", "...", "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fd1512-f616-8834-3c82-8d5f83a0db1e"],
 ", which the style guide forbids and which also hid errors. It now asks \
explicitly and refuses three different cases, each with its message: \
something that is not a Pauli, a Pauli of the wrong size, and a Pauli \
carrying a phase:"
}], "Text",ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"],

