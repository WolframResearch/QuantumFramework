        RowBox[{"-", "1"}], "+", "p"}], ")"}], "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"2", " ", "p"}]}], ")"}]}]}], ",", 
   RowBox[{"\<\"X\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", "-", 
       RowBox[{"2", " ", "p"}]}], ")"}], " ", 
     SuperscriptBox["p", "2"]}]}], ",", 
   RowBox[{"\<\"Y\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"Z\"\>", "\[Rule]", "0"}]}], "\[RightAssociation]"}]], "Output",\

 CellLabel->
  "Out[14]= ",ExpressionUUID->"128c7526-c883-085d-42b4-6c83e9365aa7"]
}, Open  ]],

