Cell["One finding", "Section",ExpressionUUID->"50735439-04fd-dee7-0001-4e63ac89a4cd"],

Cell[TextData[{
 StyleBox["The five-qubit code's encoder uses its own labels.",
  FontWeight->"Bold"],
 " Shown above: the encoding circuit produces the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3597ba8d-914b-928f-63ac-33d720ffe0d5"],
 " eigenstate of the code's ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "056fda38-a5bc-2884-3314-dc65cc497aee"],
 ". ",
 Cell["Encoder.wl", "InlineCode",ExpressionUUID->
  "383c4a9f-130c-f8c1-69c4-63d9a6beca2b"],
 " was not changed, because the circuit is still valid and is what the \
extraction and Stim consume; the new ",
 Cell[BoxData["\"\<Encoder\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b649e79-a2e1-7610-291b-1022d6945d7a"],
 " corrects it, and a test pins ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], 
    StyleBox["V", "TI"], "\[LongEqual]", 
    StyleBox["Z", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09cb884c-5fc8-b209-3fc8-22165a620153"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["X", "TI"], "_"], 
    StyleBox["V", "TI"], "\[LongEqual]", 
    StyleBox["X", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "376c6589-bcca-29e8-5d14-7cd3357f7b32"],
 " on five codes."
}], "Text",ExpressionUUID->"667bb688-7420-22c7-0e18-2fd27dd5702d"],

