Cell[TextData[{
 "And the other way round: ",
 Cell[BoxData[
  RowBox[{"noise", "[", "\"\<QuantumChannel\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],
 " used to work only for the named channels; it now works for every Pauli \
model."
}], "Text",ExpressionUUID->"15eb24b6-b946-3a65-43e8-bdf038f0894f"],

Cell["Knill\[Dash]Laflamme", "Subsection",ExpressionUUID->"27d2a24c-1e84-19ee-4de1-44169b316b34"],

Cell[TextData[{
 "The underlying question \[LongDash] does the code correct this set of \
errors? \[LongDash] is the Knill\[Dash]Laflamme condition. For Pauli errors \
it is decided on symplectic rows, without forming any ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "285985c7-a1c8-13eb-5866-1ca0d07d6131"],
 " vector, so it has no size limit. When it fails, it names the pair that \
breaks it and the logical operator their product is:"
}], "Text",ExpressionUUID->"57868ed1-450c-c474-7dbd-279b6cbeaf5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"bitFlip", "[", 
    RowBox[{"\"\<KnillLaflammeMatrix\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<III\>\"", ",", " ", "\"\<XII\>\"", ",", " ", "\"\<IXI\>\"",
        ",", " ", "\"\<IIX\>\""}], "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"bitFlip", "[", 
    RowBox[{"\"\<KnillLaflammeMatrix\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<XII\>\"", ",", " ", "\"\<IXX\>\""}], "}"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"0c5e608e-35dc-f74f-3466-79e8bc6edd95"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", 
   RowBox[{"Missing", "[", 
    RowBox[{"\<\"NotCorrectable\"\>", ",", 
     RowBox[{"\[LeftAssociation]", 
      RowBox[{
       RowBox[{"\<\"Errors\"\>", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\<\"XII\"\>", ",", "\<\"IXX\"\>"}], "}"}]}], ",", 
       RowBox[{"\<\"Product\"\>", "\[Rule]", "\<\"XXX\"\>"}]}], 
      "\[RightAssociation]"}]}], "]"}]}], "}"}]], "Output",
 CellLabel->
  "Out[19]= ",ExpressionUUID->"1a1e4090-3303-05ed-4a26-59da46b66f37"]
}, Open  ]],

Cell["\<\
Asked of every error up to a weight, it reads off the distance:\
\>", "Text",ExpressionUUID->"10256af3-3972-af7a-41da-83bdb804f240"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"steane", "[", 
    RowBox[{"\"\<CorrectableQ\>\"", ",", " ", 
     RowBox[{"\"\<Weight\>\"", "[", "t", "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"457602f1-d86e-ac86-730d-9bbad918f6ec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "False"}], "}"}]], "Output",
 CellLabel->
  "Out[20]= ",ExpressionUUID->"499f95c1-a958-6c18-7fa4-0caac8ed3762"]
}, Open  ]],

Cell[TextData[{
 "The names ",
 Cell[BoxData["\"\<Codewords\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1e874b-6d22-b8ab-3525-1f1504d40af1"],
 ", ",
 Cell[BoxData["\"\<KnillLaflammeMatrix\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c02104f-9807-e6c4-3431-8a2919b3cc2e"],
 " and ",
 Cell[BoxData["\"\<CorrectableQ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f909018-5ea1-6a32-15af-0a425b543918"],
 " are the ones the bosonic plan chose (",
 Cell["Bosonic-QEC-PartA-Spec.md", "InlineCode",ExpressionUUID->
  "2f4595f3-090a-1216-557a-0cbda8bf617c"],
 "), so a qubit code and an oscillator code answer the same questions the \
same way."
}], "Text",ExpressionUUID->"06385f5e-e9d4-4e6c-2fd8-571b886114b6"],

Cell["Step 4: the rate and the decoders", "Section",ExpressionUUID->"25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],

Cell["One return type", "Subsection",ExpressionUUID->"3b9a140e-d97a-4136-69b9-8e6bd80f101c"],

Cell[TextData[{
 "Before, ",
 Cell[BoxData["QECLogicalErrorRate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f9438da-b80f-a114-75ab-b18439bbf07e"],
 " returned a number, except when the circuit had heralds: then it returned \
an ",
 Cell[BoxData["Association"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7281c19b-2602-dcd4-22be-d8c553b4a63e"],
 " with ",
 Cell[BoxData["\"\<Rate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8746fc-db76-c487-64bd-5fb9de00aeed"],
 ", ",
 Cell[BoxData["\"\<Acceptance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11f0f87a-e6f0-91cd-478f-f227928ae317"],
 ", and so on. The caller had to know that in advance. Now it always returns \
the rate:"
}], "Text",ExpressionUUID->"473164ce-b547-c1f4-6ecf-7da83cf393de"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Head", " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"QECLogicalErrorRate", "[", 
     RowBox[{"steane", ",", " ", 
      RowBox[{"QECNoiseModel", "[", 
       RowBox[{"\"\<Depolarizing\>\"", ",", " ", 
        RowBox[{"1", "/", "10"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
    RowBox[{"QECLogicalErrorRate", "[", 
     RowBox[{"bitFlip", ",", " ", 
      RowBox[{"QECNoiseModel", "[", 
       RowBox[{"\"\<Circuit\>\"", ",", " ", 
        RowBox[{"1", "/", "1000"}]}], "]"}], ",", " ", 
      RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
   "}"}]}]], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"12c4fc3b-e00c-2bba-42fb-f66491b97980"],

