Cell["The four decisions", "Section",ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"],

Cell["\<\
The audit left four design questions open. They were settled provisionally so \
the work was not blocked; each one is isolated, so changing one does not \
touch the others.\
\>", "Text",ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],
     Cell["question", "TableText",
     FontWeight->Bold,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],
     Cell["decision", "TableText",
