     FontSize->0.9 Inherited,ExpressionUUID->
     "2cfa2c34-ef50-7d46-5499-c6718ae547ac"]], "TableText",ExpressionUUID->
     "362a4e41-4988-041f-5e2a-602b683d6f65"], Cell[TextData[Cell[BoxData[
    "QuantumChannel"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "01ed6b92-5a5f-fa78-3792-82dc5febc942"]], "TableText",ExpressionUUID->
     "107fa29c-d013-1000-4004-3bd9e1a6636a"], Cell["\<\
a channel (now for every Pauli model, not only the named ones)\
\>", "TableText",ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"]}
  }]], "3ColumnTableMod",ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell["Asked directly:", "Text",ExpressionUUID->"2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Head", " ", "/@", " ", 
  RowBox[{"<|", "\n", "    ", 
   RowBox[{
    RowBox[{"\"\<Encoder\>\"", " ", "->", " ", 
     RowBox[{"bitFlip", "[", "\"\<Encoder\>\"", "]"}]}], ",", "\n", "    ", 
    RowBox[{"\"\<Codewords\>\"", " ", "->", " ", 
     RowBox[{"First", "[", 
      RowBox[{"bitFlip", "[", "\"\<Codewords\>\"", "]"}], "]"}]}], ",", "\n", 
    "    ", 
    RowBox[{"\"\<Codespace\>\"", " ", "->", " ", 
     RowBox[{"bitFlip", "[", "\"\<Codespace\>\"", "]"}]}], ",", "\n", "    ", 
    
    RowBox[{"\"\<SyndromeMeasurement\>\"", " ", "->", " ", 
     RowBox[{"bitFlip", "[", "\"\<SyndromeMeasurement\>\"", "]"}]}], ",", 
    "\n", "    ", 
    RowBox[{"\"\<Recovery\>\"", " ", "->", " ", 
     RowBox[{"bitFlip", "[", 
      RowBox[{"\"\<Recovery\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]}], ",", "\n", "    ", 
    RowBox[{"\"\<LogicalChannel\>\"", " ", "->", " ", 
     RowBox[{"bitFlip", "[", 
      RowBox[{"\"\<LogicalChannel\>\"", ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"\"\<BitFlip\>\"", ",", " ", 
         RowBox[{"1", "/", "10"}]}], "]"}]}], "]"}]}], ",", "\n", "    ", 
    RowBox[{"\"\<noise[\\\"QuantumChannel\\\"]\>\"", " ", "->", " ", 
     RowBox[{
      RowBox[{"QECNoiseModel", "[", 
       RowBox[{"\"\<BitFlip\>\"", ",", " ", 
        RowBox[{"1", "/", "10"}]}], "]"}], "[", "\"\<QuantumChannel\>\"", 
      "]"}]}]}], "|>"}]}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Encoder\"\>", "\[Rule]", "QuantumOperator"}], ",", 
   RowBox[{"\<\"Codewords\"\>", "\[Rule]", "QuantumState"}], ",", 
   RowBox[{"\<\"Codespace\"\>", "\[Rule]", "QuantumOperator"}], ",", 
   RowBox[{"\<\"SyndromeMeasurement\"\>", "\[Rule]", 
    "QuantumMeasurementOperator"}], ",", 
   RowBox[{"\<\"Recovery\"\>", "\[Rule]", "QuantumChannel"}], ",", 
   RowBox[{"\<\"LogicalChannel\"\>", "\[Rule]", "QuantumChannel"}], ",", 
   RowBox[{"\<\"noise[\\\"QuantumChannel\\\"]\"\>", "\[Rule]", 
    "QuantumChannel"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"52243646-2fbd-210e-03db-a8204a487054"]
}, Open  ]],

Cell["\<\
Because they are the framework's own objects, the framework's own operations \
work on them without any QEC-specific glue. The whole correction cycle can be \
run by hand: encode a framework state, hit it with a framework gate, measure \
the syndrome, apply the recovery \[LongDash] every step is just applying one \
framework object to another:\
\>", "Text",ExpressionUUID->"1acd7f4d-3da3-7753-4af3-7717b4565db9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"psi", ",", " ", "hit", ",", " ", "fixed", ",", " ", "v"}], "}"}],
    ",", "\n", "    ", 
   RowBox[{
    RowBox[{"psi", " ", "=", " ", 
     RowBox[{
      RowBox[{"bitFlip", "[", "\"\<Encoder\>\"", "]"}], "[", 
      RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], "]"}]}], ";", 
    "          ", 
    RowBox[{"(*", " ", 
     RowBox[{"QuantumOperator", " ", "on", " ", "a", " ", "QuantumState"}], 
     " ", "*)"}], "\n", "    ", 
    RowBox[{"hit", " ", "=", " ", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"\"\<X\>\"", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], "[", "psi", "]"}]}], ";", 
    "                  ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "an", " ", "ordinary", " ", "framework", " ", "gate", " ", "as", " ", 
      "the", " ", "error"}], " ", "*)"}], "\n", "    ", 
    RowBox[{"fixed", " ", "=", " ", 
     RowBox[{
      RowBox[{"bitFlip", "[", 
       RowBox[{"\"\<Recovery\>\"", ",", " ", 
        RowBox[{"bitFlip", "[", 
         RowBox[{"\"\<Syndrome\>\"", ",", " ", "\"\<IXI\>\""}], "]"}]}], 
       "]"}], "[", 
      RowBox[{"QuantumState", "[", 
       RowBox[{"hit", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "]"}]}], ";",
     "\n", "    ", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"Normal", "[", 
      RowBox[{"psi", "[", "\"\<StateVector\>\"", "]"}], "]"}]}], ";", "\n", 
    "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<encoded\>\"", " ", "->", " ", 
       RowBox[{"Head", "[", "psi", "]"}]}], ",", "\n", "      ", 
      RowBox[{"\"\<left alone by the projector\>\"", " ", "->", " ", 
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"bitFlip", "[", "\"\<Codespace\>\"", "]"}], "[", "psi", 
             "]"}], "[", "\"\<StateVector\>\"", "]"}], "]"}], " ", "-", " ", 
          "v"}], "]"}], " ", "==", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", "8"}], "]"}]}]}], ",", "\n", "      ", 
      RowBox[{"\"\<syndrome probabilities\>\"", " ", "->", " ", 
       RowBox[{"Values", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"bitFlip", "[", "\"\<SyndromeMeasurement\>\"", "]"}], "[", 
           "hit", "]"}], "[", "\"\<Probabilities\>\"", "]"}], "]"}], "]"}]}], 
      ",", "\n", "      ", 
      RowBox[{"\"\<fidelity after recovery\>\"", " ", "->", " ", 
       RowBox[{"Chop", "[", 
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{"Conjugate", "[", "v", "]"}], " ", ".", " ", 
          RowBox[{"Normal", "[", 
           RowBox[{"fixed", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], " ", ".",
           " ", "v"}], "]"}], "]"}]}]}], "|>"}]}]}], "]"}]], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"encoded\"\>", "\[Rule]", "QuantumState"}], ",", 
   RowBox[{"\<\"left alone by the projector\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"syndrome probabilities\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}]}], ",", 
   RowBox[{"\<\"fidelity after recovery\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"]
}, Open  ]],

Cell["The rest of this step looks at each object in turn.", "Text",ExpressionUUID->"6f6ad260-8ee1-565a-1569-d44a2a943ca0"],

Cell[TextData[{
 "The encoder is the isometry ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "612fd791-c81e-86f2-10d4-cedae9a8ecd8"],
 ", as a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],
 ", from 1 logical qubit to 3 physical ones:"
}], "Text",ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"bitFlip", "[", "\"\<Encoder\>\"", "]"}], "[", "\"\<Order\>\"", 
  "]"}]], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"6b853673-18d0-d9fa-19ba-a83d996aabc0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", "1", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"]
}, Open  ]],

Cell[TextData[{
 "Its columns are the codewords, and they are in ",
 StyleBox["the code's own",
  FontWeight->"Bold"],
 " logical basis: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"|", "0"}], 
     StyleBox["L", "TI"]], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "574a2197-51ef-7938-7d49-b8d1679a4802"],
 " is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e85e9ed-427b-8528-16ba-00b7770fec72"],
 " eigenstate of the ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73b76025-96bb-3fff-214d-798f234f85c5"],
 " that ",
 Cell[BoxData[
  RowBox[{"code", "[", "\"\<LogicalZ\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31f4c073-8ff6-126f-678b-da3d298360b5"],
 " reports. That was not automatic. The five-qubit code's encoding circuit \
sends ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "00000"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ff7667-e560-b2c0-2285-68408c1a002a"],
 " to the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c9be80e-0554-61c1-24b8-0268ace1332b"],
 " eigenstate of that ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "106b7ad8-6378-599b-4069-7382160d2be1"],
 " \[LongDash] a valid encoder, but with its labels swapped. Against what ",
 Cell[BoxData["\"\<Codewords\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],
 " gives now:"
}], "Text",ExpressionUUID->"304452a4-201b-d64c-607c-4b0e51afbc96"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"z", " ", "=", " ", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"QECPauli", "[", 
         RowBox[{"First", "[", 
          RowBox[{"five", "[", "\"\<LogicalZ\>\"", "]"}], "]"}], "]"}], 
        "[", "\"\<Matrix\>\"", "]"}], "]"}]}], ",", " ", "raw", ",", " ", 
     "fixed"}], "}"}], ",", "\n", "    ", 
   RowBox[{
    RowBox[{"raw", " ", "=", " ", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"QuantumCircuitOperator", "[", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"\"\<I\>\"", " ", "->", " ", "q"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"q", ",", " ", "5"}], "}"}]}], "]"}], ",", " ", 
            RowBox[{"five", "[", "\"\<EncodingGates\>\"", "]"}]}], "]"}], 
          "]"}], "[", "\n", "        ", "\"\<QuantumOperator\>\"", "]"}], 
        "[", "\"\<MatrixRepresentation\>\"", "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"fixed", " ", "=", " ", 
     RowBox[{"Normal", "[", 
      RowBox[{
       RowBox[{"First", "[", 
        RowBox[{"five", "[", "\"\<Codewords\>\"", "]"}], "]"}], 
       "[", "\"\<StateVector\>\"", "]"}], "]"}]}], ";", "\n", "    ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<circuit alone\>\"", " ", "->", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "raw", "]"}], " ", ".", " ", "z", " ", ".",
          " ", "raw"}], "]"}]}], ",", "\n", "      ", 
      RowBox[{"\"\<Codewords\>\"", " ", "->", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "fixed", "]"}], " ", ".", " ", "z", " ", ".",
          " ", "fixed"}], "]"}]}]}], "|>"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"circuit alone\"\>", "\[Rule]", 
