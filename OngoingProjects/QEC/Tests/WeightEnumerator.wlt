(* ::Package:: *)

(* ============================================================================
   Tests/QEC/WeightEnumerator.wlt

   Weight enumerators (Got26 sec. 7.4.1) and the code-space probability of
   sec. 13.4.

   Three independent checks carry the file.  The dual enumerator comes from the
   MacWilliams identity, and is checked against the normalizer enumerated
   directly.  Theorem 7.7(c) reads the distance off A and B, and is checked
   against the distance search.  And the code-space probability, computed from
   the signed enumerator without any 2^n object, is checked against the dense
   projector of step 3 -- including the 1/6 of protocol 13.5.
   ============================================================================ *)

Needs["Wolfram`QuantumFramework`"];
Needs["Wolfram`QuantumFramework`PackageScope`"];

Get[FileNameJoin[{
    ParentDirectory[DirectoryName[FindFile["Wolfram`QuantumFramework`"], 2]],
    "OngoingProjects", "QEC", "QECCore", "QECCore.wl"
}]];

QECClearCache[];

qecScope = "Wolfram`QuantumFramework`QEC`PackageScope`";
qecVectors = Symbol[qecScope <> "codeVectors"];
qecLogicalVectors = Symbol[qecScope <> "codeLogicalVectors"];
qecProduct = Symbol[qecScope <> "pauliProduct"];
qecIdentity = Symbol[qecScope <> "pauliIdentity"];

bitFlip = QECCode["BitFlipCode"];
five = QECCode["5QubitCode"];
steane = QECCode["SteaneCode"];
shor = QECCode["ShorCode"];
signedPair = QECCode[{"XX", "-ZZ"}];

(* N(S) by brute force: the group generated by the stabilizer and the logicals. *)
normalizerWeights[c_QECCode] := Module[{n = c["Qubits"], gens, els},
    gens = Join[qecVectors[First[c]], Join @@ Values[qecLogicalVectors[First[c]]]];
    els = Fold[Function[{e, g}, Join[e, qecProduct[#, g] & /@ e]], {qecIdentity[n]}, gens];
    With[{w = Total[BitOr[els[[All, 1 ;; n]], els[[All, n + 1 ;; 2 n]]], {2}]},
        Table[Count[w, j], {j, 0, n}]
    ]
]

(* The number of leading j with A_j = B_j is the first j where they differ. *)
firstDifference[c_QECCode] := LengthWhile[c["DualWeightEnumerator"] - c["WeightEnumerator"], # === 0 &]


(* ============================================================================
   The enumerators
   ============================================================================ *)

VerificationTest[
    {five["WeightEnumerator", qecX], five["DualWeightEnumerator", qecX]},
    {1 + 15 qecX^4, 1 + 30 qecX^3 + 15 qecX^4 + 18 qecX^5},
    TestID -> "QEC-WeightEnumerator-five-qubit-code-as-in-the-book"
]

VerificationTest[
    {steane["WeightEnumerator", qecX], bitFlip["WeightEnumerator", qecX]},
    {1 + 21 qecX^4 + 42 qecX^6, 1 + 3 qecX^2},
    TestID -> "QEC-WeightEnumerator-Steane-and-bit-flip"
]

VerificationTest[
    Table[Total[c["WeightEnumerator"]] == 2^c["StabilizerCount"], {c, {bitFlip, five, steane, shor}}],
    {True, True, True, True},
    TestID -> "QEC-WeightEnumerator-counts-the-whole-group"
]

VerificationTest[
    Table[c["DualWeightEnumerator"] === normalizerWeights[c], {c, {bitFlip, five, steane, QECCode["DistanceTwo", 4]}}],
    {True, True, True, True},
    TestID -> "QEC-WeightEnumerator-MacWilliams-matches-the-normalizer"
]

(* Theorem 7.7(c): A_j = B_j exactly below the distance. *)
VerificationTest[
    Table[{firstDifference[c], c["Distance"]}, {c, {bitFlip, five, steane, shor, QECCode["DistanceTwo", 4]}}],
    {{1, 1}, {3, 3}, {3, 3}, {3, 3}, {2, 2}},
    TestID -> "QEC-WeightEnumerator-distance-from-the-enumerators"
]

VerificationTest[
    Length[QECCode["Hamming", 4]["DualWeightEnumerator"]],
    16,
    TestID -> "QEC-WeightEnumerator-dual-without-the-normalizer"
]


(* ============================================================================
   Signs
   ============================================================================ *)

(* XX and -ZZ: the group is {I, XX, -ZZ, YY}.  Unsigned, three of weight two;
   signed, the -ZZ cancels one of them. *)
VerificationTest[
    {signedPair["WeightEnumerator", qecX], signedPair["SignedWeightEnumerator", qecX]},
    {1 + 3 qecX^2, 1 + qecX^2},
    TestID -> "QEC-WeightEnumerator-signed-sees-the-sign"
]

VerificationTest[
    five["SignedWeightEnumerator"] === five["WeightEnumerator"],
    True,
    TestID -> "QEC-WeightEnumerator-five-qubit-code-has-no-negative-elements"
]


(* ============================================================================
   The code-space probability
   ============================================================================ *)

(* Protocol 13.5: five copies of |R+> or |R->, projected on the 5-qubit code. *)
VerificationTest[
    {five["CodespaceProbability", {1, 1, 1} / Sqrt[3]], five["CodespaceProbability", -{1, 1, 1} / Sqrt[3]]},
    {1/6, 1/6},
    TestID -> "QEC-WeightEnumerator-protocol-13-5-accepts-one-in-six"
]

VerificationTest[
    Module[{rho1 = (IdentityMatrix[2] + (PauliMatrix[1] + PauliMatrix[2] + PauliMatrix[3]) / Sqrt[3]) / 2, rho},
        rho = Fold[KroneckerProduct, ConstantArray[rho1, 5]];
        Simplify[Tr[rho . Normal[five["Codespace"]["MatrixRepresentation"]]]]
    ],
    1/6,
    TestID -> "QEC-WeightEnumerator-one-in-six-against-the-dense-projector"
]

VerificationTest[
    {bitFlip["CodespaceProbability", QuantumState["0"]], bitFlip["CodespaceProbability", QuantumState["+"]],
     signedPair["CodespaceProbability", QuantumState["0"]], signedPair["CodespaceProbability", QuantumState["+"]]},
    {1, 1/4, 0, 1/2},
    TestID -> "QEC-WeightEnumerator-codespace-probability-of-simple-states"
]

VerificationTest[
    five["CodespaceProbability", {qecA, qecB, qecC}],
    (1 + 5 qecB^2 qecC^2 + 5 qecA^2 (qecB^2 + qecC^2)) / 16,
    SameTest -> (Simplify[#1 - #2] === 0 &),
    TestID -> "QEC-WeightEnumerator-codespace-probability-is-symbolic"
]

VerificationTest[
    five["CodespaceProbability", QuantumState["00"]],
    $Failed,
    {QECCode::blochstate},
    TestID -> "QEC-WeightEnumerator-refuses-a-two-qubit-state"
]

VerificationTest[
    Block[{$QECStabilizerGroupLimit = 8}, steane["WeightEnumerator"]],
    $Failed,
    {QECCode::groupbig},
    TestID -> "QEC-WeightEnumerator-respects-the-group-limit"
]

VerificationTest[
    SubsetQ[steane["Properties"], {"WeightEnumerator", "SignedWeightEnumerator", "DualWeightEnumerator", "CodespaceProbability"}],
    True,
    TestID -> "QEC-WeightEnumerator-properties-are-listed"
]
