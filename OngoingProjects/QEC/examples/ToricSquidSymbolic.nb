Cell["\<\
The plaquettes are faces, which a graph does not hold. On the torus itself \
each plaquette is the patch of surface enclosed by its four edges. Draw the \
grid there, from above and from below, reading each star off the edges that \
meet at a vertex and each plaquette off the edges around a face:\
\>", "CodeText",
 CellID->633444251,ExpressionUUID->"b6df6ac4-be2d-447a-9072-33bcf0ee1da4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"toricTorus", "[", "L_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "=", " ", "1"}], ",", " ", 
       RowBox[{"R", " ", "=", " ", "3"}], ",", " ", 
       RowBox[{"sites", " ", "=", " ", 
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"L", " ", "-", " ", "1"}]}], "]"}], ",", " ", "2"}], 
         "]"}]}], ",", " ", 
       RowBox[{"qubits", " ", "=", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"2", " ", 
          RowBox[{"L", "^", "2"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "edge", ",", " ", "mid", ",", " ", "star", ",", " ", "plaquette", ",",
          " ", "T", ",", " ", "patch", ",", " ", "product", ",", " ", 
         "color"}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"edge", "[", "q_", "]"}], " ", ":=", " ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"r", " ", "=", " ", 
              RowBox[{"Quotient", "[", 
               RowBox[{
                RowBox[{"q", " ", "-", " ", "1"}], ",", " ", 
                RowBox[{"2", " ", "L"}]}], "]"}]}], ",", " ", 
             RowBox[{"d", " ", "=", " ", 
              RowBox[{"Quotient", "[", 
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"q", " ", "-", " ", "1"}], ",", " ", 
                  RowBox[{"2", " ", "L"}]}], "]"}], ",", " ", "L"}], "]"}]}], 
             ",", " ", 
             RowBox[{"c", " ", "=", " ", 
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"q", " ", "-", " ", "1"}], ",", " ", "L"}], "]"}]}]}],
             "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"r", ",", " ", "c"}], "}"}], ",", " ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"r", ",", " ", "c"}], "}"}], " ", "+", " ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"d", " ", "==", " ", "0"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}]}], "}"}]}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"mid", "[", "q_", "]"}], " ", ":=", " ", 
         RowBox[{"Mean", "[", 
          RowBox[{"edge", "[", "q", "]"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"star", "[", "s_", "]"}], " ", ":=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"qubits", ",", " ", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"edge", "[", "#", "]"}], ",", " ", "L"}], "]"}], ",", 
              " ", "s"}], "]"}], " ", "&"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"plaquette", "[", "f_", "]"}], " ", ":=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"qubits", ",", " ", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"f", " ", "+", " ", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"1", "/", "2"}], ",", " ", 
                    RowBox[{"1", "/", "2"}]}], "}"}], " ", "+", " ", "#"}], 
                  " ", ",", " ", "L"}], "]"}], " ", "&"}], " ", "/@", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}], ",", " ", 
                 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"-", "1"}], "/", "2"}], ",", " ", "0"}], "}"}], ",",
                  " ", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", " ", 
                   RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", " ", 
                   RowBox[{
                    RowBox[{"-", "1"}], "/", "2"}]}], "}"}]}], "}"}]}], ",", 
              " ", 
              RowBox[{"Mod", "[", 
               RowBox[{
                RowBox[{"mid", "[", "#", "]"}], ",", " ", "L"}], "]"}]}], 
             "]"}], " ", "&"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"T", "[", "rad_", "]"}], "[", 
          RowBox[{"{", 
           RowBox[{"r_", ",", " ", "c_"}], "}"}], "]"}], " ", ":=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"SurfaceData", "[", 
            
            RowBox[{"\"\<Torus\>\"", ",", 
             " ", "\"\<ParametricEquations\>\""}], "]"}], "[", 
           RowBox[{"rad", ",", " ", "R"}], "]"}], " ", "@@", " ", 
          RowBox[{"(", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"c", ",", " ", "r"}], "}"}], "/", "L"}]}], ")"}]}]}], ";",
         "\n", "   ", 
        RowBox[{
         RowBox[{"patch", "[", 
          RowBox[{"f_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"p", " ", "=", " ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"T", "[", "a", "]"}], "[", 
                RowBox[{"f", " ", "+", " ", 
                 RowBox[{"{", 
                  RowBox[{"s", ",", " ", "t"}], "}"}]}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"s", ",", " ", 
                 RowBox[{"Subdivide", "[", 
                  RowBox[{"0", ",", " ", "1", ",", " ", "n"}], "]"}]}], "}"}],
                ",", " ", 
               RowBox[{"{", 
                RowBox[{"t", ",", " ", 
                 RowBox[{"Subdivide", "[", 
                  RowBox[{"0", ",", " ", "1", ",", " ", "n"}], "]"}]}], 
                "}"}]}], "]"}]}], "}"}], ",", "\n", "     ", 
           RowBox[{"Polygon", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"p", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], ",", " ", 
                  RowBox[{"p", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "j"}], "]"}],
                    "]"}], ",", " ", 
                  RowBox[{"p", "[", 
                   RowBox[{"[", 
