   RowBox[{"lowWeight", "[", 
    RowBox[{"18", ",", " ", "2"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"code3", "[", 
     RowBox[{"\"\<LogicalPauliQ\>\"", ",", " ", 
      RowBox[{"label", "[", "#", "]"}]}], "]"}], " ", "&"}]}], "]"}]], "Input",\

 CellID->1564521590,ExpressionUUID->"bf3d9eb3-a71a-4ff8-ac9d-67700ff7b77a"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",ExpressionUUID->"50306ecf-6aec-4fbe-88d9-a8b976dc8abb"]
}, Open  ]],

Cell["Find the largest number of qubits two of its stars share.", "Text",
 CellID->1182552059,ExpressionUUID->"4e2c0f1a-d4e7-4076-8d9d-74b0f20fface"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Length", " ", "/@", " ", 
   RowBox[{"Apply", "[", 
    RowBox[{"Intersection", ",", " ", 
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"toricChecks", "[", "3", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}]], "Input",
 CellID->1182135500,ExpressionUUID->"d2dd87b6-2e0b-48b0-b6f0-d1c3d78a36f5"],

Cell[BoxData["1"], "Output",ExpressionUUID->"8970341a-c6db-47aa-bbbb-6b3baf1a3f8e"]
}, Open  ]],

Cell["\<\
A term produced jointly by two couplers can still act on all the qubits the \
two couplers touch, so this does not rule out every logical term at larger \
sizes.\
\>", "Text",
 CellID->624435969,ExpressionUUID->"ef7c68ec-cbd0-4a9c-8893-33d0115432a9"],

Cell[TextData[{
 "Now the preprint's largest unwanted term in the eight-qubit array: a ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["Z", "TI"], "^"], 
   OverscriptBox[
    StyleBox["Z", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3363f1cc-3b68-4fb4-b5cf-9a2a1852688a"],
 " coupling on its qubits 1 and 3 ([1], supplementary Sec. S7). That section \
orders the qubits differently from Table S1; in Table S1's order these are \
qubits 1 and 5. The preprint does not say clearly whether its coefficient \
table uses the circuit's axes or the code's axes, so test both."
}], "Text",
 CellID->636600166,ExpressionUUID->"22053243-67c6-43f4-bfa6-42de9ee15670"],

Cell[TextData[{
 "Write the term as a Pauli product in each convention: ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "1"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "5"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e4d35c0-ce45-4858-8932-ffc8b3e0c1b3"],
 " for the code's axes and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["Y", "TI"], "^"], "1"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["Y", "TI"], "^"], "5"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "651fe0f6-4444-4938-aa5c-d2c28e018a8e"],
 " for the circuit's axes."
}], "Text",
 CellID->482975697,ExpressionUUID->"1e56cd96-ecf4-4522-ba7c-7a9b80917f95"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"paperToS1", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "1", ",", " ", "2", ",", " ", "5", ",", " ", "6", ",", " ", "3", ",", " ",
      "4", ",", " ", "7", ",", " ", "8"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pair", " ", "=", " ", 
   RowBox[{"paperToS1", "[", 
    RowBox[{"[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"residualWords", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"zWord", "[", 
      RowBox[{"pair", ",", " ", "8"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"xWord", "[", 
       RowBox[{"pair", ",", " ", "8"}], "]"}], " ", "+", " ", 
      RowBox[{"zWord", "[", 
       RowBox[{"pair", ",", " ", "8"}], "]"}]}]}], "}"}]}], ";"}]}], "Input",
 CellID->218740597,ExpressionUUID->"af70f18d-9600-400d-8eae-0ff8ba5e5106"],

Cell["\<\
List the symplectic product of each with the eight checks: a 1 marks a check \
it anticommutes with.\
\>", "Text",
 CellID->1888719079,ExpressionUUID->"96228a23-2b1c-4cf4-bd4c-cd678f69cce5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AssociationThread", "[", 
  RowBox[{
   RowBox[{"label", " ", "/@", " ", "residualWords"}], ",", " ", 
   RowBox[{"sympTable", "[", 
    RowBox[{"residualWords", ",", " ", "checks2"}], "]"}]}], "]"}]], "Input",
 CellID->577319652,ExpressionUUID->"13542253-841e-4160-b9cf-1dd60ef50919"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"ZIIIZIII\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "1", ",", "1", ",", "1", ",", "1", ",", "0", ",", "0", ",", "0", ",", 
      "0"}], "}"}]}], ",", 
   RowBox[{"\<\"YIIIYIII\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "1", ",", "1", ",", "1", ",", "1", ",", "0", ",", "0", ",", "0", ",", 
      "0"}], "}"}]}]}], "\[RightAssociation]"}]], "Output",ExpressionUUID->\
"0aa3bfab-4e35-4c1d-af85-371006894d65"]
}, Open  ]],

Cell["\<\
Test whether each one's restriction to the protected space is zero.\
\>", "Text",
 CellID->1479264407,ExpressionUUID->"12f83164-42e5-47ad-8212-3441f2cbf37c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AssociationThread", "[", 
  RowBox[{
   RowBox[{"label", " ", "/@", " ", "residualWords"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"zeroQ", "[", 
      RowBox[{"compress", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "residualWords"}]}], "]"}]], "Input",
 CellID->2128371304,ExpressionUUID->"aaf2e850-51e1-477c-a405-9a9db6f93e61"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"ZIIIZIII\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"YIIIYIII\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"1bb9b3d4-cb9b-4b43-86d7-\
6e9cbe1f27a8"]
}, Open  ]],

Cell[TextData[{
 "In both conventions it anticommutes with four stars, so it costs ",
 Cell[BoxData[
  RowBox[{"8", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d44dc40c-90ab-4cd4-9e17-6e947841f790"],
 ", and it does nothing to the stored qubits at first order: it is a \
detectable error. But detectable does not mean harmless. A detectable term \
moves a state out of the protected space and back, and two such moves can \
combine into an action inside it. Take ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["V", "TI"], "^"], "=", 
   StyleBox["\[CurlyEpsilon]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "^"], "1"], "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "^"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f448255-86d5-4722-9560-f5474bac105a"],
 ". Each single ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Z", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a62777ea-d399-4d61-8dd9-a219ca8e9496"],
 " anticommutes with two stars and costs ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0affebb9-7311-4fc5-8191-fd2c2e409c78"],
 ", while their product ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "1"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f06f84-16c1-41d4-b4ee-e79910645ee0"],
 " is logical. Second-order perturbation theory gives"
}], "Text",
 CellID->950870772,ExpressionUUID->"0b91c37d-7b33-4459-874c-b3b1dbdfefd0"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["H", "TI"], "^"], 
     StyleBox["log",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "2", 
      StyleBox[")",
       SpanMaxSize->1]}]], "=", "-", 
    FractionBox[
     SuperscriptBox[
      StyleBox["\[CurlyEpsilon]", "TI"], "2"], 
     RowBox[{"4", 
      StyleBox["c", "TI"]}]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["P", "TI"], "^"], "0"], 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        OverscriptBox[
         StyleBox["Z", "TI"], "^"], "1"], "+", 
       SubscriptBox[
        OverscriptBox[
         StyleBox["Z", "TI"], "^"], "2"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["P", "TI"], "^"], "0"], "=", "-", 
    FractionBox[
     SuperscriptBox[
      StyleBox["\[CurlyEpsilon]", "TI"], "2"], 
     RowBox[{"2", 
      StyleBox["c", "TI"]}]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["I", "TI"], "^"], "+", 
     OverscriptBox[
      OverscriptBox[
       StyleBox["Z", "TI"], "_"], "^"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->514924614,ExpressionUUID->"af71c66f-8f88-49b7-8a8e-1b5e58e4211d"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "^"], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["P", "TI"], "^"], "0"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "1"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["P", "TI"], "^"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b4eabed-7936-4d4a-8a50-3c08697a3383"],
 ", the restriction of the logical product ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "1"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "acd671ef-9d04-4e79-8951-aaf749cc9f60"],
 ", acts on the stored qubits. So two detectable errors produce a coherent \
rotation of the stored qubits."
}], "Text",
 CellID->282462320,ExpressionUUID->"0ad20fed-a25a-4015-a63e-b7bce2cf8498"],

Cell[TextData[{
 "Build the term ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "1"], "+", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aabe7042-41d2-4a39-b579-94398b8b3a74"],
 "."
}], "Text",
 CellID->1296424774,ExpressionUUID->"584ac2a7-23f3-4bfb-b5c2-31994eb0cfa0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vPair", " ", "=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"pauliMatrix", "[", 
       RowBox[{"zWord", "[", 
        RowBox[{
         RowBox[{"{", "#", "}"}], ",", " ", "8"}], "]"}], "]"}], " ", "&"}], 
     " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellID->584425926,ExpressionUUID->"af38cbdc-6afa-48c1-8027-07fa868dafd3"],

Cell["Verify that its restriction to the protected space is zero.", "Text",
 CellID->626501257,ExpressionUUID->"907f3f6a-91b0-4267-bd50-a962c2f81828"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"zeroQ", "[", 
  RowBox[{"ground", " ", ".", " ", "vPair", " ", ".", " ", 
   RowBox[{"Transpose", "[", "ground", "]"}]}], "]"}]], "Input",
 CellID->1651638069,ExpressionUUID->"b3dcc992-5ddb-4c64-ade7-761926979988"],

Cell[BoxData["True"], "Output",ExpressionUUID->"999c7888-0514-4ddb-8929-6f629fc1fc11"]
}, Open  ]],

Cell[TextData[{
 "Verify that it sends every protected state to states ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3069e2d-bb98-4ae7-9e34-f50c6870ebae"],
 " higher in energy, or to zero."
}], "Text",
 CellID->893867186,ExpressionUUID->"8a78133d-30dd-44a2-9dfd-82753e38a553"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"zeroQ", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"h0", " ", "+", " ", 
      RowBox[{"8", " ", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"256", ",", " ", "SparseArray"}], "]"}]}]}], ")"}], " ", ".", 
    " ", "vPair", " ", ".", " ", 
    RowBox[{"Transpose", "[", "ground", "]"}]}], " ", "-", " ", 
   RowBox[{"4", " ", 
    RowBox[{"vPair", " ", ".", " ", 
     RowBox[{"Transpose", "[", "ground", "]"}]}]}]}], "]"}]], "Input",
 CellID->6250674,ExpressionUUID->"fc6b0f5f-3583-410e-bdff-68961d9b6f19"],

Cell[BoxData["True"], "Output",ExpressionUUID->"433a595a-19da-41a7-9329-8f55603c8ae0"]
}, Open  ]],

Cell[TextData[{
 "Verify that its square restricts to ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["I", "TI"], "^"], "+", 
    OverscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ba6d0cb-f6a2-41d6-86ea-367d72cafc53"],
 "."
}], "Text",
 CellID->1355056369,ExpressionUUID->"3e37d610-25b8-4400-9f9b-042b0f6941a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"zeroQ", "[", 
  RowBox[{
   RowBox[{
   "ground", " ", ".", " ", "vPair", " ", ".", " ", "vPair", " ", ".", " ", 
    RowBox[{"Transpose", "[", "ground", "]"}]}], " ", "-", " ", 
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "4", "]"}], " ", "+", " ", 
      RowBox[{"compress", "[", 
       RowBox[{"zWord", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "8"}], "]"}], 
       "]"}]}], ")"}]}]}], "]"}]], "Input",
 CellID->453774196,ExpressionUUID->"d91b82e8-7bd4-4e2b-a531-3e0b73f20f6e"],

Cell[BoxData["True"], "Output",ExpressionUUID->"cf23c1f9-7b37-493d-890a-bf226b5a4a2c"]
}, Open  ]],

Cell["Find the eigenvalues of that square.", "Text",
 CellID->2005971825,ExpressionUUID->"ff06953e-61b9-47ae-aeb4-820c88b1c95d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Eigenvalues", "[", 
  RowBox[{
  "ground", " ", ".", " ", "vPair", " ", ".", " ", "vPair", " ", ".", " ", 
   RowBox[{"Transpose", "[", "ground", "]"}]}], "]"}]], "Input",
 CellID->1080501523,ExpressionUUID->"fef22079-28d1-485e-9669-577390e4cce6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "4", ",", "0", ",", "0"}], "}"}]], "Output",ExpressionUUID\
->"a0bf7516-915d-4bf5-a7a1-d0ad5dab5c8b"]
}, Open  ]],

Cell[TextData[{
 "So ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "1"], "+", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1106667c-49ce-45a8-9921-7b75e12fbdef"],
 " annihilates half of the protected space, the states with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "^"], "=", "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "150e3d75-fba9-4209-b132-0e36e44bd85f"],
 ", and lifts the other half. This selective action is what splits the four \
protected states at second order."
}], "Text",
 CellID->266990780,ExpressionUUID->"089ee20d-ac8d-49a7-af1d-75d4b8a81067"],

Cell[TextData[{
 "The coupling can also be solved exactly. A protected state with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "^"], "=", "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d5d6ce5-e2bb-48a3-a0dc-a911c8376276"],
 " couples only to its image under ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "1"], "+", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed2f44e5-d173-483e-b430-26e0e0cec1e3"],
 ". The pair forms a two-level problem, whose lower level is ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", "3", 
    StyleBox["c", "TI"], "-", 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["c", "TI"], "2"], "+", 
      SuperscriptBox[
       StyleBox["\[CurlyEpsilon]", "TI"], "2"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afdfb16d-4e54-4ae4-aaae-c640411da769"],
 ". The states with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "^"], "=", "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "527bb75e-cbc9-484d-a873-12f5deb93d83"],
 " are annihilated, so they stay at ",
 Cell[BoxData[
  RowBox[{"-", "8", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e177fc9-3c9a-43b5-aa1e-24aa0d2c8535"],
 " exactly."
}], "Text",
 CellID->658048876,ExpressionUUID->"c3481300-b56f-4533-8acc-7e52966d9a5b"],

Cell[TextData[{
 "Verify both statements for symbolic ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e03a523-e475-4d20-8dbb-e968e46f7553"],
 " and ",
 Cell[BoxData[
  StyleBox["\[CurlyEpsilon]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85630413-bf6f-4c29-a3a3-083e0577dcda"],
 ": that the combination of a ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "^"], "=", "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d069e6d1-f73f-4f8d-99bb-97e076f9e1d1"],
 " state and its image is an eigenvector of ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "0"], "+", 
   StyleBox["\[CurlyEpsilon]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "^"], "1"], "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "^"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "271672cc-d14f-4143-bdbb-e9f66e11f247"],
 " with that eigenvalue, and that the ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "^"], "=", "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bc1525f-a7d3-494a-928c-9629db028737"],
 " states are eigenvectors at ",
 Cell[BoxData[
  RowBox[{"-", "8", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c0430a-c4de-4401-83f3-1d64a1889816"],
 "."
}], "Text",
 CellID->723744305,ExpressionUUID->"6d2100c4-467d-413b-b98d-0b483b074e4b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"zbar", " ", "=", " ", 
   RowBox[{"compress", "[", 
    RowBox[{"zWord", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "8"}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"gPlus", " ", "=", " ", 
   RowBox[{
    RowBox[{"First", "[", 
     RowBox[{"NullSpace", "[", 
      RowBox[{"zbar", " ", "-", " ", 
       RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}], "]"}], " ", ".", 
    " ", "ground"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gMinus", " ", "=", " ", 
   RowBox[{
    RowBox[{"NullSpace", "[", 
     RowBox[{"zbar", " ", "+", " ", 
      RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}], " ", ".", " ", 
    "ground"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eLow", " ", "=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], " ", "c"}], " ", "-", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"c", "^", "2"}], " ", "+", " ", 
        RowBox[{"eps", "^", "2"}]}], "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"psiLow", " ", "=", " ", 
   RowBox[{
    RowBox[{"2", " ", "eps", " ", "gPlus"}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"eLow", " ", "+", " ", 
       RowBox[{"8", " ", "c"}]}], ")"}], " ", 
     RowBox[{
      RowBox[{"vPair", " ", ".", " ", "gPlus"}], "/", "2"}]}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"c", " ", "h0"}], " ", "+", " ", 
         RowBox[{"eps", " ", "vPair"}]}], ")"}], " ", ".", " ", "psiLow"}], 
      " ", "-", " ", 
      RowBox[{"eLow", " ", "psiLow"}]}], "]"}], " ", "===", " ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", " ", "256"}], "]"}]}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"c", " ", "h0"}], " ", "+", " ", 
         RowBox[{"eps", " ", "vPair"}]}], ")"}], " ", ".", " ", 
       RowBox[{"Transpose", "[", "gMinus", "]"}]}], " ", "+", " ", 
      RowBox[{"8", " ", "c", " ", 
       RowBox[{"Transpose", "[", "gMinus", "]"}]}]}], "]"}], " ", "===", " ", 
    
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", " ", 
      RowBox[{"{", 
       RowBox[{"256", ",", " ", "2"}], "}"}]}], "]"}]}]}], "}"}]}], "Input",
 CellID->878430531,ExpressionUUID->"7af061ad-4eae-4d82-a4b3-666edfe1cc73"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",ExpressionUUID->"6f6ae085-4ff8-4cb5-a010-2d08e755cdc2"]
}, Open  ]],

Cell["Give the exact splitting of the four lowest eigenstates.", "Text",
 CellID->1953655798,ExpressionUUID->"36811638-b9cc-484b-90b5-abc6b3ea2b05"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", "8"}], " ", "c"}], " ", "-", " ", "eLow"}], ",", " ", 
   RowBox[{"c", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellID->1318894631,ExpressionUUID->"13a8389f-190d-410c-97c5-2cdeff1b6bd0"],

Cell[BoxData[
 RowBox[{"2", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "c"}], "+", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["c", "2"], "+", 
      SuperscriptBox["eps", "2"]}]]}], ")"}]}]], "Output",ExpressionUUID->\
"68e08c91-110e-45a5-9efc-e781918f69b5"]
}, Open  ]],

Cell["Expand the lower level for a small unwanted term.", "Text",
 CellID->1986353928,ExpressionUUID->"c79c5ae1-118e-49db-a40c-b39b8d3d821e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{"eLow", ",", " ", 
   RowBox[{"{", 
    RowBox[{"eps", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"c", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellID->1732688669,ExpressionUUID->"9b111703-c308-4702-9690-f64e0467ad5c"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"-", 
    RowBox[{"8", " ", "c"}]}], "-", 
   FractionBox[
    SuperscriptBox["eps", "2"], "c"], "+", 
   FractionBox[
    SuperscriptBox["eps", "4"], 
    RowBox[{"4", " ", 
     SuperscriptBox["c", "3"]}]], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "eps", "]"}], "5"],
    SeriesData[$CellContext`eps, 0, {}, 0, 5, 1],
    Editable->False]}],
  SeriesData[$CellContext`eps, 
   0, {(-8) $CellContext`c, 0, (-1)/$CellContext`c, 0, 
    Rational[1, 4] $CellContext`c^(-3)}, 0, 5, 1],
  Editable->False]], "Output",ExpressionUUID->"75d28758-c310-4b11-b778-\
3e1213f1bca4"]
}, Open  ]],

Cell[TextData[{
 "The exact level starts at ",
 Cell[BoxData[
  RowBox[{"-", "8", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b70a0aaf-bedf-4362-aae7-2657a6c80fac"],
 " and moves down by ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[CurlyEpsilon]", "TI"], "2"], "/", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bfe0521a-5416-4f11-9edf-3317189cb46a"],
 ", which is the second-order result ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox[
    SuperscriptBox[
     StyleBox["\[CurlyEpsilon]", "TI"], "2"], 
    RowBox[{"2", 
     StyleBox["c", "TI"]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    OverscriptBox[
     OverscriptBox[
      StyleBox["Z", "TI"], "_"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b66286af-aa89-451f-93bf-014110cbae51"],
 " at ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "^"], "=", "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e745ca5f-38c4-4ef2-a536-e8d27a638f78"],
 ". The expansion holds while ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      StyleBox["\[CurlyEpsilon]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "<", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b54d7b5d-aaa5-4297-83ed-a942753272ad"],
 "."
}], "Text",
 CellID->953325239,ExpressionUUID->"dcb6fa08-7680-4713-a07f-73a031198ed7"],

Cell["\<\
So the right question about an unwanted term is not only how large it is, but \
what it does to the stored qubits at first and second order. The \
certificate's bound limits how far the four lowest eigenstates can spread in \
energy, and the preprint's diagonalization gives a spread of 3.927 kHz ([1], \
supplementary Sec. S9). The bound cannot say which rotations of the stored \
qubits make up that spread. The effective Hamiltonian restricted to the four \
lowest eigenstates would, and the preprint names this kind of analysis as \
future work ([1], Conclusion).\
\>", "Text",
 CellID->467957530,ExpressionUUID->"493f7efb-06e9-4005-a607-d47176749203"],

Cell[TextData[{
 "The qubit model matters here too. Recall the oscillator model of the qubit \
from the coupling section: it adds a ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Z", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5092d854-56c5-420f-87b4-a7e237d70edf"],
 " part to each qubit's operator, and in the code's axes that part becomes ",
 Cell[BoxData[
  RowBox[{"-", 
   OverscriptBox[
    StyleBox["Y", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8cd102d6-1c24-4bd2-b217-ebf2bfdd3063"],
 "."
}], "Text",
 CellID->2110390618,ExpressionUUID->"bb45881d-532f-4e13-8666-f8707e06412f"],

Cell["\<\
Rotate the oscillator model's Pauli products on one star into the code's \
axes, and keep those that are logical.\
\>", "Text",
 CellID->783797437,ExpressionUUID->"7c5335ca-b815-48e8-87b4-ca9261ce6195"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"projPart", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<I\>\"", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", " ", "-", " ", 
         RowBox[{
          RowBox[{"#", "^", "2"}], "/", "2"}]}], " ", "&"}], ")"}]}], ",", 
     " ", 
     RowBox[{"\"\<Z\>\"", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "^", "2"}], "/", "2"}], " ", "&"}], ")"}]}], ",", " ", 
     RowBox[{"\"\<X\>\"", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"I", " ", "#"}], " ", "&"}], ")"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"projCoef", "[", "w_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"angles", " ", ".", " ", "angles"}]}], "/", "2"}], "]"}], " ", 
    
    RowBox[{"Times", " ", "@@", " ", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"projPart", "[", "#1", "]"}], "[", "#2", "]"}], " ", "&"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"w", ",", " ", "angles"}], "}"}]}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"onStar", "[", "w_", "]"}], " ", ":=", " ", 
   RowBox[{"StringJoin", "[", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{"\"\<I\>\"", ",", " ", "8"}], "]"}], ",", " ", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"toricChecks", "[", "2", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "->", " ", "w"}], 
       "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cssOnStar", "[", "w_", "]"}], " ", ":=", " ", 
   RowBox[{"StringReplace", "[", 
    RowBox[{
     RowBox[{"onStar", "[", "w", "]"}], ",", " ", 
     RowBox[{"\"\<Z\>\"", " ", "->", " ", "\"\<Y\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"projLogical", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<I\>\"", ",", " ", "\"\<Z\>\"", ",", " ", "\"\<X\>\""}],
           "}"}], ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"EvenQ", "[", 
         RowBox[{"Count", "[", 
          RowBox[{"#", ",", " ", "\"\<X\>\""}], "]"}], "]"}], " ", "&"}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"qec2", "[", 
       RowBox[{"\"\<LogicalPauliQ\>\"", ",", " ", 
        RowBox[{"cssOnStar", "[", "#", "]"}]}], "]"}], " ", "&"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellID->1786937431,ExpressionUUID->"39eab191-6fca-4441-ae41-0d776d3f0eeb"],

Cell["List them in the code's axes.", "Text",
 CellID->418411907,ExpressionUUID->"8257f5c5-5c20-4dad-9f14-0bfb4aebe98a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"cssOnStar", " ", "/@", " ", "projLogical"}]], "Input",
 CellID->1996901633,ExpressionUUID->"9a512df6-4d45-43f9-979d-abc1fb3611bc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"YYYIIIYI\"\>", ",", "\<\"YYXIIIXI\"\>", 
   ",", "\<\"XXYIIIYI\"\>"}], "}"}]], "Output",ExpressionUUID->"e93a8424-b301-\
406d-91ab-a5aac8a68523"]
}, Open  ]],

Cell["Give their coefficients with the coupler empty.", "Text",
 CellID->1172544731,ExpressionUUID->"32132f9f-fbbd-49ef-b139-1ac3279ccc78"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", 
       RowBox[{"Count", "[", 
        RowBox[{"#", ",", " ", "\"\<Z\>\""}], "]"}]}], " ", 
      RowBox[{"ComplexExpand", "[", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"osc", "[", 
          RowBox[{"0", ",", " ", "phizpf"}], "]"}], " ", 
         RowBox[{"projCoef", "[", "#", "]"}]}], "]"}], "]"}]}], " ", "&"}], 
    " ", "/@", " ", "projLogical"}], ",", " ", 
   RowBox[{"phizpf", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellID->575723684,ExpressionUUID->"9e0e0f24-30cd-4900-82c3-b5c6f01add74"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox["1", "16"], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["phizpf", "2"]}], "-", 
        SuperscriptBox["t1", "2"], "-", 
        SuperscriptBox["t2", "2"], "-", 
        SuperscriptBox["t3", "2"], "-", 
        SuperscriptBox["t4", "2"]}], ")"}]}]], " ", 
    SuperscriptBox["t1", "2"], " ", 
    SuperscriptBox["t2", "2"], " ", 
    SuperscriptBox["t3", "2"], " ", 
    SuperscriptBox["t4", "2"]}], ",", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["phizpf", "2"]}], "-", 
        SuperscriptBox["t1", "2"], "-", 
        SuperscriptBox["t2", "2"], "-", 
        SuperscriptBox["t3", "2"], "-", 
        SuperscriptBox["t4", "2"]}], ")"}]}]], " ", 
    SuperscriptBox["t1", "2"], " ", 
    SuperscriptBox["t2", "2"], " ", "t3", " ", "t4"}], ",", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["phizpf", "2"]}], "-", 
        SuperscriptBox["t1", "2"], "-", 
        SuperscriptBox["t2", "2"], "-", 
        SuperscriptBox["t3", "2"], "-", 
        SuperscriptBox["t4", "2"]}], ")"}]}]], " ", "t1", " ", "t2", " ", 
    SuperscriptBox["t3", "2"], " ", 
    SuperscriptBox["t4", "2"]}]}], "}"}]], "Output",ExpressionUUID->"e8d55d77-\
d85a-48e3-8d58-9c86682a5e84"]
}, Open  ]],

Cell[TextData[{
 "The products that survive have two ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["X", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fce81893-e00b-4842-87b5-c109730bb41f"],
 " and two ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Y", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a16ec22-dbf2-4553-a949-d128379fd155"],
 ", or four ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Y", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf8d97b1-780b-4b4f-8b5e-b82949eb027c"],
 ", and their coefficients start at the sixth and eighth power of the \
participation phase. The rotation decides this. The oscillator model's ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["Z", "TI"], "^"], 
   OverscriptBox[
    StyleBox["Z", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd504b6a-fa16-4f48-8667-c93cc7b32e46"],
 " pairs, written in the circuit's axes, are detectable errors once rotated \
into the code's axes. Read without the rotation, they would look like the \
code's logical ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["Z", "TI"], "^"], 
   OverscriptBox[
    StyleBox["Z", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3a2289f-587f-4ae5-a60a-59bc5ba62c1d"],
 " pairs. Like every coefficient of the Pauli sum, these hold at one instant; \
whether they survive as driven terms needs the same resonance analysis as the \
four-qubit term."
}], "Text",
 CellID->2092821110,ExpressionUUID->"41b45efe-2fa0-4072-befe-116e7b05caeb"],

Cell[TextData[{
 "The drive's own second-order shifts from Question 3 can be tested the same \
way. Rotate their ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Z", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72c57883-92bc-42b3-9fca-3ef76a3ff671"],
 " products into the code's axes on the same star, including the sign from ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["Z", "TI"], "^"], "\[Rule]", "-", 
   OverscriptBox[
    StyleBox["Y", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "455894fa-b4ee-4143-821d-c6bc331c8c08"],
 ", and list those that are logical."
}], "Text",
 CellID->1925920113,ExpressionUUID->"8c5df215-60b3-440a-81a0-ac183349942b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"starWord", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{"cssOnStar", "[", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{"\"\<I\>\"", ",", " ", "4"}], "]"}], ",", " ", 
      RowBox[{"Thread", "[", 
       RowBox[{"s", " ", "->", " ", "\"\<Z\>\""}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"zInCode", " ", "=", " ", 
   RowBox[{"KeyMap", "[", 
    RowBox[{"starWord", ",", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "^", 
          RowBox[{"Length", "[", "#", "]"}]}], " ", 
         RowBox[{"zExact", "[", "#", "]"}]}], " ", "&"}], ",", " ", 
       RowBox[{"Keys", "[", "zExact", "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Keys", "[", 
  RowBox[{"KeySelect", "[", 
   RowBox[{"zInCode", ",", " ", 
    RowBox[{
     RowBox[{"qec2", "[", 
      RowBox[{"\"\<LogicalPauliQ\>\"", ",", " ", "#"}], "]"}], " ", "&"}]}], 
   "]"}], "]"}]}], "Input",
 CellID->314502351,ExpressionUUID->"c15d03ea-2b24-4b89-8b8f-5451e74cfaf0"],

Cell[BoxData[
 RowBox[{"{", "\<\"YYYIIIYI\"\>", "}"}]], "Output",ExpressionUUID->"2fee80c8-069b-44c5-acab-2e24b33585c8"]
}, Open  ]],

Cell[TextData[{
 "So the circuit's own second-order shifts contain one term that acts on the \
stored qubits directly: the product of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Z", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd55b4c0-18fb-4cdf-a522-1cbc4c2839ab"],
 " on all four qubits. Recall from Question 3 that some transitions in that \
sum are not safely detuned under the rounding. Verify that dropping them \
leaves less than a tenth of this coefficient."
}], "Text",
 CellID->195787063,ExpressionUUID->"b72bba20-d7fa-4e69-9373-9ee0fa6993a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"zSafe", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], 
     "]"}], "/", 
    RowBox[{"zExact", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], 
     "]"}]}], "]"}], " ", "<", " ", 
  RowBox[{"1", "/", "10"}]}]], "Input",
 CellID->598157926,ExpressionUUID->"d2f61fb7-fcb2-41a3-ae3a-587d4b59926d"],

Cell[BoxData["True"], "Output",ExpressionUUID->"8e911140-5521-4626-a09c-53483bd00737"]
}, Open  ]],

Cell[TextData[{
 "So the logical term comes almost entirely from transitions that are not \
safely detuned, and the unrounded frequencies decide its size. Every other \
product is a detectable error. Complementary pairs of them, such as ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["Z", "TI"], "^"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cb9e271-e9f7-47df-b487-6e20be00114c"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "3"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14556891-1b03-47bf-9442-6cc04049bacd"],
 ", multiply to that logical term, so at the next order they produce a \
logical term too."
}], "Text",
 CellID->1697802771,ExpressionUUID->"d436a4e5-12c9-4a6b-b725-0be140516251"],

Cell[TextData[{
 "Compute that term with second-order perturbation theory, for either sum of \
Question 3. Each detectable product here anticommutes with four checks, so \
its intermediate cost is ",
 Cell[BoxData[
  RowBox[{"8", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "efa5b97b-b579-41c2-91ce-e46dbf93ef55"],
 "."
}], "Text",
 CellID->1957202297,ExpressionUUID->"5f3d8ab5-e494-4a84-af7b-4c109ec0f62b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"yOnStar", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"toricChecks", "[", "2", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "[", 
           RowBox[{"[", "#", "]"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{
         RowBox[{"xWord", "[", 
          RowBox[{
           RowBox[{"{", "q", "}"}], ",", " ", "8"}], "]"}], " ", "+", " ", 
         RowBox[{"zWord", "[", 
          RowBox[{
           RowBox[{"{", "q", "}"}], ",", " ", "8"}], "]"}]}]}], "]"}], " ", 
      "&"}], " ", "/@", " ", "s"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"detectable", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Keys", "[", "zExact", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"!", " ", 
       RowBox[{"qec2", "[", 
        RowBox[{"\"\<LogicalPauliQ\>\"", ",", " ", 
         RowBox[{"label", "[", 
          RowBox[{"yOnStar", "[", "#", "]"}], "]"}]}], "]"}]}], " ", "&"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"flipped", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{"sympTable", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"yOnStar", "[", "s", "]"}], "}"}], ",", " ", "checks2"}], 
      "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"logicalBlock", " ", "=", " ", 
   RowBox[{"compress", "[", 
    RowBox[{"yOnStar", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"inCodeSigns", "[", "zc_", "]"}], " ", ":=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", 
        RowBox[{"Length", "[", "#", "]"}]}], " ", 
       RowBox[{"zc", "[", "#", "]"}]}], " ", "&"}], ",", " ", 
     RowBox[{"Keys", "[", "zc", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hLog2", "[", "zc_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eps", " ", "=", " ", 
       RowBox[{"inCodeSigns", "[", "zc", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"-", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", 
          RowBox[{
           RowBox[{"eps", "[", "a", "]"}], " ", 
           RowBox[{"eps", "[", "b", "]"}], " ", 
           RowBox[{
            RowBox[{"ground", " ", ".", " ", 
             RowBox[{"pauliMatrix", "[", 
              RowBox[{"yOnStar", "[", "a", "]"}], "]"}], " ", ".", " ", 
             RowBox[{"pauliMatrix", "[", 
              RowBox[{"yOnStar", "[", "b", "]"}], "]"}], " ", ".", " ", 
             RowBox[{"Transpose", "[", "ground", "]"}]}], "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "c", " ", 
              RowBox[{"flipped", "[", "b", "]"}]}], ")"}]}]}]}], "]"}], " ", "@@@",
         " ", 
        RowBox[{"Tuples", "[", 
         RowBox[{"detectable", ",", " ", "2"}], "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hLog2Parts", "[", "zc_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h", " ", "=", " ", 
       RowBox[{"hLog2", "[", "zc", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Tr", "[", "h", "]"}], "/", "4"}], ",", " ", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{"h", " ", ".", " ", "logicalBlock"}], "]"}], "/", "4"}]}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"logicalRatio", "[", "zc_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"hLog2Parts", "[", "zc", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], "/", 
     RowBox[{
      RowBox[{"inCodeSigns", "[", "zc", "]"}], "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], 
      "]"}]}], " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"drv", " ", "->", " ", "drive0"}], ",", " ", 
      RowBox[{"c", " ", "->", " ", "cTable"}]}], "}"}]}]}], ";"}]}], "Input",
 CellID->292826501,ExpressionUUID->"b79a70bc-2f43-4576-9e37-85a493cf2008"],

Cell["Verify that every detectable product flips four checks.", "Text",
 CellID->2125497565,ExpressionUUID->"f662f543-07f7-4319-9ba5-c456a61ce00f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", "[", 
  RowBox[{"flipped", " ", "/@", " ", "detectable"}], "]"}]], "Input",
 CellID->1470571867,ExpressionUUID->"2a5aed14-6a05-43b8-a4de-548a0c2bc1b4"],

Cell[BoxData[
 RowBox[{"{", "4", "}"}]], "Output",ExpressionUUID->"5843e939-9463-4d58-afe5-10ebe97909ff"]
}, Open  ]],

Cell["\<\
Verify, for the full sum, that the result is a constant plus a multiple of \
the logical product, with nothing left over.\
\>", "Text",
 CellID->1541041306,ExpressionUUID->"045d4039-7a00-4898-b9db-3916caa7723b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"parts", " ", "=", " ", 
     RowBox[{"hLog2Parts", "[", "zExact", "]"}]}], "}"}], ",", " ", 
   RowBox[{"zeroQ", "[", 
    RowBox[{
     RowBox[{"hLog2", "[", "zExact", "]"}], " ", "-", " ", 
     RowBox[{
      RowBox[{"parts", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", 
      RowBox[{"IdentityMatrix", "[", "4", "]"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"parts", "[", 
       RowBox[{"[", "2", "]"}], "]"}], " ", "logicalBlock"}]}], "]"}]}], 
  "]"}]], "Input",
 CellID->572862704,ExpressionUUID->"41f604cb-4993-4f37-9ffd-8409efe6c4c4"],

Cell[BoxData["True"], "Output",ExpressionUUID->"75f16e86-446b-421e-a595-90bac0f8093b"]
}, Open  ]],

Cell[TextData[{
 "Give the powers of the drive strength and of ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be71767a-a0d4-4dd4-bf75-76c6adece69d"],
 " in its logical part."
}], "Text",
 CellID->775350673,ExpressionUUID->"a159a22b-7d34-4fee-b330-b8ccdf6c6f50"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Exponent", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"hLog2Parts", "[", "zExact", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", " ", "drv"}], "]"}], ",", " ", 
   RowBox[{"Exponent", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"hLog2Parts", "[", "zExact", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", " ", "c"}], "]"}]}], 
  "}"}]], "Input",
 CellID->1302506098,ExpressionUUID->"d7e063d6-e7c6-4ae3-b6ab-ef193156de68"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", 
   RowBox[{"-", "1"}]}], "}"}]], "Output",ExpressionUUID->"36d31eff-a1ad-419d-\
bd3b-7712fee1b12d"]
}, Open  ]],

Cell[TextData[{
 "Compare it with the first-order logical term at Table I, taking ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d3894f5-16ee-4059-90ac-c96b008f9251"],
 " as the four-qubit coupling, first for the full sum and then for the sum \
without the transitions that are not safely detuned. For each, test whether \
the ratio of second order to first order is negative and below a tenth in \
size, and whether it exceeds one in size."
}], "Text",
 CellID->219680269,ExpressionUUID->"2cb4d9b7-b1e0-4e2c-839a-221f5d5fd293"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "/", "10"}], " ", "<", " ", "#", " ", "<", " ", 
      "0"}], ",", " ", 
     RowBox[{
      RowBox[{"Abs", "[", "#", "]"}], " ", ">", " ", "1"}]}], "}"}], " ", 
   "&"}], " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"logicalRatio", "[", "zExact", "]"}], ",", " ", 
    RowBox[{"logicalRatio", "[", "zSafe", "]"}]}], "}"}]}]], "Input",
 CellID->2095861829,ExpressionUUID->"8fe8ca55-402a-4e0c-a3d6-39dabb188d2d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"True", ",", "False"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"False", ",", "True"}], "}"}]}], "}"}]], "Output",ExpressionUUID->\
"3a8923b1-f294-46db-802b-afe783a2e30c"]
}, Open  ]],

Cell[TextData[{
 "The second-order logical term grows as the fourth power of the drive over \
",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd9e5f44-0220-4326-8427-7f87bb104531"],
 ". With the full sum it is much smaller than the first-order term and has \
the opposite sign. With the rounding-safe sum it is larger and has the same \
sign. So the unrounded frequencies decide which mechanism dominates, as they \
decide the largest coefficients of Question 3. Either way, the drive's own \
terms act on the stored qubits both directly and through pairs of detectable \
errors."
}], "Text",
 CellID->1866772333,ExpressionUUID->"6a08149f-1207-496a-a937-dba64e596cf2"],

Cell[TextData[{
 "The code, its spectrum, the classification of each Pauli product as logical \
or detectable, and the two-level splitting are exact. The logical terms built \
from the drive rest on second-order perturbation theory twice: once for the \
energy shifts of Question 3, and once for the pairs of detectable errors, \
which needs the shifts to be small compared with ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "763277e2-0870-4dc2-8207-bb3ba184ea82"],
 ". The first-order logical coefficient is also smaller than what the \
appendix's time evolution can resolve. What stays open is the preprint's \
effective Hamiltonian restricted to its four lowest eigenstates, which would \
say which rotations of the stored qubits its simulated spread contains."
}], "Text",
 CellID->805821437,ExpressionUUID->"e2229053-ffaf-47a3-b5f8-a95d20afec22"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Question 5: What Happens to the Four-Qubit Term When the Coupler Holds an \
Excitation?\
\>", "Section",
 CellID->1559947742,ExpressionUUID->"912813d7-cc37-48dd-bd1d-ef18e64f40f0"],

Cell[TextData[{
 "The four-qubit coupling was computed with the coupler empty. A driven \
coupler need not stay empty, and the preprint's simulation keeps twelve \
levels of the coupler's lower mode ([1], \"Single cell demonstration\"). With \
",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6319fee3-2f4c-4df2-ab5e-de0103b482ff"],
 " excitations in the coupler, the four-qubit coefficient is multiplied, \
relative to the empty coupler, by the Laguerre factor ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["L", "TI"], 
    StyleBox["m", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubsuperscriptBox["\[CurlyPhi]", 
    StyleBox["zpf",
     FontSlant->"Plain"], "2"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77e501ec-9f8e-4ce6-b836-fde627c2ea75"],
 " from the coupling section. For one excitation this is ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SubsuperscriptBox["\[CurlyPhi]", 
    StyleBox["zpf",
     FontSlant->"Plain"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c5ae3b0-82b1-44e7-8956-2ed1c7472d85"],
 ". At the preprint's coupler parameters, one excitation reverses the sign of \
the four-qubit term and makes it stronger."
}], "Text",
 CellID->1666922708,ExpressionUUID->"0d6a59dc-b5ff-4e52-8e9b-de505ab69385"],

Cell["Find where the one-excitation factor becomes negative.", "Text",
 CellID->1650855363,ExpressionUUID->"fbe84958-d088-4a96-aa75-4e01ff4316c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"LaguerreL", "[", 
      RowBox[{"1", ",", " ", 
       RowBox[{"p", "^", "2"}]}], "]"}], " ", "<", " ", "0"}], " ", "&&", " ", 
    RowBox[{"p", " ", ">", " ", "0"}]}], ",", " ", "p"}], "]"}]], "Input",
 CellID->1512509229,ExpressionUUID->"74bcb1fc-8848-4373-a4ae-455333c57b75"],

Cell[BoxData[
 RowBox[{"p", ">", "1"}]], "Output",ExpressionUUID->"146efbfe-1e7b-4b5c-9b85-eb0d7fb65e7c"]
}, Open  ]],

Cell["Find where it exceeds the empty-coupler factor in size.", "Text",
 CellID->1169625615,ExpressionUUID->"64d7ea4c-f4b8-458b-b516-0aeb39f46374"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"LaguerreL", "[", 
       RowBox[{"1", ",", " ", 
        RowBox[{"p", "^", "2"}]}], "]"}], "]"}], " ", ">", " ", "1"}], " ", "&&",
     " ", 
    RowBox[{"p", " ", ">", " ", "0"}]}], ",", " ", "p"}], "]"}]], "Input",
 CellID->1918215688,ExpressionUUID->"abadcce8-8bf1-4699-8436-5259b959e604"],

Cell[BoxData[
 RowBox[{"p", ">", 
  SqrtBox["2"]}]], "Output",ExpressionUUID->"45000081-e4da-4e70-abb6-ab74b5606858"]
}, Open  ]],

Cell["\<\
Test the preprint's zero-point phase against the second threshold.\
\>", "Text",
 CellID->461593182,ExpressionUUID->"72c699fe-b4b6-4f45-ae6e-33f3ac00c318"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"params", "[", "\"\<phizpf\>\"", "]"}], " ", ">", " ", 
  RowBox[{"Sqrt", "[", "2", "]"}]}]], "Input",
 CellID->1783166340,ExpressionUUID->"ea495bf3-7664-428c-8cec-e10a854d7fe3"],

Cell[BoxData["True"], "Output",ExpressionUUID->"59bb2025-d799-4c1d-8e26-fd178b6c0c15"]
}, Open  ]],

Cell[TextData[{
 "The preprint's ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CurlyPhi]", 
    StyleBox["zpf",
     FontSlant->"Plain"]], "=", "1.65"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cc2e5eb-c360-4059-b04f-aaa753de87e1"],
 " lies above both thresholds."
}], "Text",
 CellID->979603465,ExpressionUUID->"d90bf63e-2c1d-418a-8421-f69b6ce05eaa"],

Cell["Compute the factor for zero to five coupler excitations.", "Text",
 CellID->1336720477,ExpressionUUID->"173d4681-b609-4734-85ba-38f1623e6e93"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"laguerreFactors", " ", "=", " ", 
  RowBox[{"LaguerreL", "[", 
   RowBox[{
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "5"}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"params", "[", "\"\<phizpf\>\"", "]"}], "^", "2"}]}], 
   "]"}]}]], "Input",
 CellID->2076424842,ExpressionUUID->"1433119c-9655-4dd4-8c16-74707fd0d275"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", 
   RowBox[{"-", 
    FractionBox["689", "400"]}], ",", 
   RowBox[{"-", 
    FractionBox["236479", "320000"]}], ",", 
   FractionBox["75175877", "128000000"], ",", 
   FractionBox["242135845547", "204800000000"], ",", 
   FractionBox["415552863048517", "409600000000000"]}], "}"}]], "Output",Expre\
ssionUUID->"2bbffdaf-3155-4ec0-9bcf-316fb43dfbc9"]
}, Open  ]],

Cell[TextData[{
 "What happens for many excitations? Find the leading large-",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "814eba34-1cae-401e-b257-51c9d2206e7b"],
 " form of the factor."
}], "Text",
 CellID->1516117956,ExpressionUUID->"c3816e3a-d34a-4c60-ac32-cdc083928278"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"laguerreLarge", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"ExpToTrig", "[", 
     RowBox[{"Asymptotic", "[", 
      RowBox[{
       RowBox[{"LaguerreL", "[", 
        RowBox[{"m", ",", " ", "x"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "Infinity", ",", " ", "1"}], "}"}]}], "]"}], 
     "]"}], ",", " ", 
    RowBox[{
     RowBox[{"m", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"x", " ", ">", " ", "0"}]}]}], "]"}]}]], "Input",
 CellID->991448093,ExpressionUUID->"6cdb9966-7238-4b5c-ae4f-aa49424ec0bd"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"x", "/", "2"}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "3"}], "-", 
        RowBox[{"4", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "6"}], "+", "x"}], ")"}], " ", "x"}]}], ")"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{
        FractionBox["\[Pi]", "4"], "+", 
        RowBox[{"2", " ", 
         SqrtBox[
          RowBox[{"m", " ", "x"}]]}]}], "]"}]}], "+", 
     RowBox[{"48", " ", 
      SqrtBox[
       RowBox[{"m", " ", "x"}]], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{
        FractionBox["\[Pi]", "4"], "+", 
        RowBox[{"2", " ", 
         SqrtBox[
          RowBox[{"m", " ", "x"}]]}]}], "]"}]}]}], ")"}]}], 
  RowBox[{"48", " ", 
   SqrtBox["\[Pi]"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"m", " ", "x"}], ")"}], 
    RowBox[{"3", "/", "4"}]]}]]], "Output",ExpressionUUID->"26abf687-7232-\
4fcd-a7db-93c337c1c443"]
}, Open  ]],

Cell[TextData[{
 "Compare it numerically with the exact factor at 5, 20 and 80 excitations, \
first the large-",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9286d9f4-fb23-41bf-b1c4-b3498588a4a5"],
 " form, then the exact factor."
}], "Text",
 CellID->390341740,ExpressionUUID->"6a0df9dc-c1d5-4758-b0f5-5d0ef57f027c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"laguerreLarge", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", " ", "->", " ", 
          RowBox[{
           RowBox[{"params", "[", "\"\<phizpf\>\"", "]"}], "^", "2"}]}], ",", 
         " ", 
         RowBox[{"m", " ", "->", " ", "#"}]}], "}"}]}], ",", " ", 
      RowBox[{"LaguerreL", "[", 
       RowBox[{"#", ",", " ", 
        RowBox[{
         RowBox[{"params", "[", "\"\<phizpf\>\"", "]"}], "^", "2"}]}], 
       "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
   RowBox[{"{", 
    RowBox[{"5", ",", " ", "20", ",", " ", "80"}], "}"}]}], "]"}]], "Input",
 CellID->1772228778,ExpressionUUID->"12504250-bdc0-4926-baa6-fd52acd660cb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1.0264523081134636`", ",", "1.0145333570520434`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.05892142929719642`", ",", "0.05831973789575241`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "0.5026355678730925`"}], ",", 
     RowBox[{"-", "0.502328430259494`"}]}], "}"}]}], "}"}]], "Output",Expressi\
onUUID->"633d2520-83b8-4013-adbb-38c9268030bb"]
}, Open  ]],

Cell[TextData[{
 "As the number of excitations grows, the factor keeps changing sign, and its \
size shrinks only as ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["m", "TI"], 
   RowBox[{"-", "1", "/", "4"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2430dfb2-ec7a-4f9a-b014-d93f722bd505"],
 ", toward zero rather than toward the empty-coupler value. So whether an \
excited coupler drives the four-qubit term with the intended sign depends on \
exactly how many excitations it holds."
}], "Text",
 CellID->140501601,ExpressionUUID->"54282ad1-77b9-4436-beaa-34edc9832809"],

Cell[TextData[{
 "The Laguerre factors and the two thresholds are exact; the large-",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eea0a803-9307-4684-b9f2-cfad9495e5ac"],
 " form is the leading term of an asymptotic expansion. Both hold at a fixed \
number of coupler excitations, without the level shifts from the linear \
coupling between qubits and coupler. What stays open is how often the driven \
coupler actually holds an excitation, which the simulation's twelve coupler \
levels could answer."
}], "Text",
 CellID->474244502,ExpressionUUID->"07312fc2-11a0-4c54-9121-4a168afcba25"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Where This Leaves Us", "Section",
 CellID->789196777,ExpressionUUID->"a12f23ab-eda7-4bca-ad8b-53c2ebcfc3d1"],

Cell["\<\
The certificate starts from the numbers the simulation produced; the formulas \
test the reasons behind them. They confirm the mechanism behind the \
four-qubit term, and they turn each of the five findings into a relation \
between circuit parameters. Each relation could be added as a condition in \
the preprint's parameter search and proved alongside the table, instead of \
being taken on trust. Most of what stays open here waits on the preprint's \
own data: its full coefficient table, its unrounded frequencies and its \
parameters for each coupler.\
\>", "Text",
 CellID->1106041681,ExpressionUUID->"052345fc-7e34-4cfa-9342-052b190e2608"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Appendix: Independent Tests of the Formulas", "Section",
 CellID->1271044621,ExpressionUUID->"0c19ce7c-4f79-4092-a3f2-ec218282c5a2"],

Cell[CellGroupData[{

Cell["The Code at Every Size", "Subsection",
 CellID->254279889,ExpressionUUID->"7768d791-68f7-472f-a8a6-738674f5d356"],

Cell[TextData[{
 "The general statements about the toric code rest on a rank argument: the \
star checks and the plaquette checks each satisfy exactly one relation (all \
stars multiply to the identity, and so do all plaquettes), so ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["L", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f165ffe0-a412-4e59-a555-888e63c304ef"],
 " qubits carry ",
 Cell[BoxData[
  RowBox[{"2", 
   SuperscriptBox[
    StyleBox["L", "TI"], "2"], "-", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27a043fb-ba06-46e8-94db-54db03dc8093"],
 " independent checks and two stored qubits. The computations below verify \
this and its consequences at several sizes."
}], "Text",
 CellID->1979172420,ExpressionUUID->"f2141bf1-d970-4a1a-9416-3ee85ea1c7cb"],

Cell["Verify that all checks commute, at sizes 2 to 5.", "Text",
 CellID->1824958391,ExpressionUUID->"26a3821c-c6cc-426e-ad73-ff151d47db4f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ch", " ", "=", " ", 
       RowBox[{"symplecticChecks", "[", "L", "]"}]}], "}"}], ",", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"sympTable", "[", 
        RowBox[{"ch", ",", " ", "ch"}], "]"}], "]"}], "]"}]}], "]"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"L", ",", " ", "2", ",", " ", "5"}], "}"}]}], "]"}]], "Input",
 CellID->1513822381,ExpressionUUID->"9a1a1aeb-5690-4d35-9f4c-e102fbc0e54f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "0", "}"}], ",", 
   RowBox[{"{", "0", "}"}], ",", 
   RowBox[{"{", "0", "}"}], ",", 
   RowBox[{"{", "0", "}"}]}], "}"}]], "Output",ExpressionUUID->"70d94e75-c345-\
4aff-b02c-6ab6b39a1938"]
}, Open  ]],

