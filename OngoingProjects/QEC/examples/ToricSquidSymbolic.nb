Cell[TextData[{
 "With no inductive energy, then, the bound fails for the 4.1 GHz qubit. The \
transition depends on the offset charge, and at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["g", "TI"]], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a7ed680-218c-491e-90e9-db0fc1a25a99"],
 " it drops below that qubit. The quartic formula missed this."
}], "Text",
 CellID->1896005334,ExpressionUUID->"e3f992a5-39f5-4f15-9b7a-fd0d3b296c2f"],

Cell["\<\
The circuit does have inductive energy, and it changes the picture in two \
ways. It adds to the stiffness, so it can only raise the minimum frequency. \
And it removes the dependence on offset charge, because the phase of an \
inductively shunted qubit is no longer confined to a circle. The coupler \
relations of the same paper ([2], Appendix B) give its size:\
\>", "Text",
 CellID->638836912,ExpressionUUID->"6b6268f1-cc0f-41e7-8e4d-b6999a18320e"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[CurlyPhi]", 
     StyleBox["zpf",
      FontSlant->"Plain"], "4"], "=", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["E", "TI"], "~"], 
     StyleBox["C", "TI"]], "/", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["L", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], "-"], "=", 
    RowBox[{"4", 
     SqrtBox[
      RowBox[{
       SubscriptBox[
        OverscriptBox[
         StyleBox["E", "TI"], "~"], 
        StyleBox["C", "TI"]], 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["L", "TI"]]}]]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["L", "TI"]], "=", 
    RowBox[{
     SubscriptBox[
      StyleBox["f", "TI"], "-"], "/", 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"4", 
       SubsuperscriptBox["\[CurlyPhi]", 
        StyleBox["zpf",
         FontSlant->"Plain"], "2"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->430719822,ExpressionUUID->"fdb7510a-1d6e-41bc-9650-33362e95cf1b"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["E", "TI"], "~"], 
   StyleBox["C", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c59ad17-0246-472a-af02-9ddb8e724cd8"],
 " the coupler's charging energy. So Table I's lower coupler frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["f", "TI"], "-"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cfb1a8f7-f8f5-4a26-b183-71886c442b0d"],
 " and zero-point phase fix ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], 
   StyleBox["L", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4a038bf-902b-4dd6-a872-8b93f0d5d1d4"],
 "."
}], "Text",
 CellID->1196179774,ExpressionUUID->"8c4d70e2-cda7-4797-a4a2-cefcb77672b4"],

Cell["\<\
Define the squared phase each frequency formula gives at a frequency, the \
largest phase allowed by the 4.9 GHz minimum, and Table I's inductive energy.\
\
\>", "Text",
 CellID->1547910459,ExpressionUUID->"c4cdc437-38be-45ad-bff9-268091922a73"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"phaseSquared", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Harmonic\>\"", " ", "->", " ", 
      RowBox[{"wv", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"ejq", " ", "+", " ", 
           RowBox[{"4", " ", "el"}]}], ")"}]}], ")"}]}]}], ",", "\n", "   ", 
     RowBox[{"\"\<Quartic\>\"", " ", "->", " ", 
      RowBox[{"2", " ", 
       RowBox[{"wv", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"ejq", " ", "+", " ", 
             RowBox[{"4", " ", "el"}]}], ")"}]}], " ", "+", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"4", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"ejq", " ", "+", " ", 
                RowBox[{"4", " ", "el"}]}], ")"}], "^", "2"}]}], " ", "-", 
            " ", 
            RowBox[{"2", " ", "ejq", " ", "wv"}]}], "]"}]}], ")"}]}]}]}]}], 
    "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"maxPhase", "[", "f_", "]"}], "[", 
    RowBox[{"w0_", ",", " ", "ind_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"phaseSquared", "[", "f", "]"}], " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ejq", " ", "->", " ", 
        RowBox[{"params", "[", "\"\<EJqMin\>\"", "]"}]}], ",", " ", 
       RowBox[{"el", " ", "->", " ", "ind"}], ",", " ", 
       RowBox[{"wv", " ", "->", " ", "w0"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"elTable", " ", "=", " ", 
   RowBox[{
    RowBox[{"params", "[", "\"\<wminus\>\"", "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"4", " ", 
      RowBox[{
       RowBox[{"params", "[", "\"\<phizpf\>\"", "]"}], "^", "2"}]}], 
     ")"}]}]}], ";"}]}], "Input",
 CellID->1041325139,ExpressionUUID->"4dfb8fba-a4a9-4b4c-b682-9f865063800d"],

Cell["Show the squared phase for both frequency formulas.", "Text",
 CellID->1219526466,ExpressionUUID->"93024f2a-54f8-4a05-ad04-fab4319b776f"],

Cell[CellGroupData[{

Cell[BoxData["phaseSquared"], "Input",
 CellID->585161887,ExpressionUUID->"d1a130d6-5b15-4432-a100-c853f813a297"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Harmonic\"\>", "\[Rule]", 
    FractionBox["wv", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{"ejq", "+", 
        RowBox[{"4", " ", "el"}]}], ")"}]}]]}], ",", 
   RowBox[{"\<\"Quartic\"\>", "\[Rule]", 
    FractionBox[
     RowBox[{"2", " ", "wv"}], 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"ejq", "+", 
         RowBox[{"4", " ", "el"}]}], ")"}]}], "+", 
      SqrtBox[
       RowBox[{
        RowBox[{"4", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"ejq", "+", 
            RowBox[{"4", " ", "el"}]}], ")"}], "2"]}], "-", 
        RowBox[{"2", " ", "ejq", " ", "wv"}]}]]}]]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"6777397d-f595-453a-9cb0-\
899223fd9c5c"]
}, Open  ]],

Cell["Verify that each is the root of its frequency equation.", "Text",
 CellID->2053749851,ExpressionUUID->"db260540-b39a-4466-b081-6decf2a1b8e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AssociationMap", "[", 
  RowBox[{
   RowBox[{"Function", "[", 
    RowBox[{"f", ",", " ", 
     RowBox[{"FullSimplify", "[", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"freqForms", "[", "f", "]"}], "[", 
         RowBox[{"ejq", ",", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"phaseSquared", "[", "f", "]"}], "]"}], ",", " ", "el"}], 
         "]"}], " ", "-", " ", "wv"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"ejq", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"el", " ", ">=", " ", "0"}], " ", "&&", " ", 
        RowBox[{"0", " ", "<", " ", "wv", " ", "<", " ", 
         RowBox[{
          RowBox[{"2", " ", "ejq"}], " ", "+", " ", 
          RowBox[{"16", " ", "el"}]}]}]}]}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"Keys", "[", "freqForms", "]"}]}], "]"}]], "Input",
 CellID->594572180,ExpressionUUID->"b2b338fb-8bf9-4f24-9180-4bd9726eb119"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Harmonic\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"Quartic\"\>", "\[Rule]", "0"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"955615dc-004c-4f19-9ce6-\
0a3a37d3f6d2"]
}, Open  ]],

Cell["Give Table I's inductive energy in GHz.", "Text",
 CellID->1535497137,ExpressionUUID->"c8043868-4839-411c-a0f1-fdae7b6a9d33"],

Cell[CellGroupData[{

Cell[BoxData["elTable"], "Input",
 CellID->87369187,ExpressionUUID->"6a27b297-18e5-40c5-8ca3-ac8bfac99a92"],

Cell[BoxData[
 FractionBox["845", "1089"]], "Output",ExpressionUUID->"e45a0405-9361-41c3-9c70-ffd752da0e42"]
}, Open  ]],

Cell[TextData[{
 "With this inductive energy, the quartic formula can be compared with a \
direct diagonalization of the qubit in its oscillator basis. The Hamiltonian \
is the harmonic part ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["E", "TI"], 
   SuperscriptBox["\[CurlyPhi]", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["b", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["b", "TI"], "^"], "+", 
    FractionBox["1", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9445d110-1606-47cf-bc62-31c6809bdb76"],
 " plus the nonlinear remainder of the Josephson energy, ",
 Cell[BoxData[
  RowBox[{"-", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox[
     RowBox[{"J", "q"}], "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]", 
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "-", "1", "+", 
    SuperscriptBox["\[CurlyPhi]", "2"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["x", "TI"], "^"], "2"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d364108-3913-4a95-9dc1-98875a16458e"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], "=", 
   OverscriptBox[
    StyleBox["b", "TI"], "^"], "+", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["b", "TI"], "^"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0159deac-9bbb-4b8d-98f7-b9addb8c2175"],
 "."
}], "Text",
 CellID->1816486678,ExpressionUUID->"adcacb3d-7603-489d-9753-a4fc87f764cb"],

Cell["\<\
Give the transition in GHz at the 4.9 GHz minimum, from 60 and from 90 \
oscillator levels, then the quartic formula as a decimal.\
\>", "Text",
 CellID->694469191,ExpressionUUID->"dc20a226-6881-424c-9723-bc2bf3d446b3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"oscillatorGap", "[", 
    RowBox[{"ejq_", ",", " ", "el_", ",", " ", "ph_", ",", " ", "levels_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", " ", "=", " ", 
       RowBox[{"ph", " ", 
        RowBox[{"N", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{"oscCoordinate", "[", "levels", "]"}], "]"}], "]"}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"Subtract", " ", "@@", " ", 
      RowBox[{"Reverse", "[", 
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{"Eigenvalues", "[", 
           RowBox[{
            RowBox[{"2", " ", 
             RowBox[{"(", 
              RowBox[{"ejq", " ", "+", " ", 
               RowBox[{"4", " ", "el"}]}], ")"}], " ", 
             RowBox[{"ph", "^", "2"}], " ", 
             RowBox[{"DiagonalMatrix", "[", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"0", ",", " ", 
                 RowBox[{"levels", " ", "-", " ", "1"}]}], "]"}], " ", "+", 
               " ", 
               RowBox[{"1", "/", "2"}]}], "]"}]}], " ", "-", "\n", "        ", 
            RowBox[{"ejq", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"MatrixFunction", "[", 
                RowBox[{"Cos", ",", " ", "x"}], "]"}], " ", "-", " ", 
               RowBox[{"IdentityMatrix", "[", "levels", "]"}], " ", "+", " ", 
               
               RowBox[{
                RowBox[{"x", " ", ".", " ", "x"}], "/", "2"}]}], ")"}]}]}], 
           "]"}], "]"}], ",", " ", "2"}], "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"oscillatorGap", "[", 
    RowBox[{
     RowBox[{"params", "[", "\"\<EJqMin\>\"", "]"}], ",", " ", "elTable", ",",
      " ", 
     RowBox[{"params", "[", "\"\<phi\>\"", "]"}], ",", " ", "60"}], "]"}], ",",
    " ", 
   RowBox[{"oscillatorGap", "[", 
    RowBox[{
     RowBox[{"params", "[", "\"\<EJqMin\>\"", "]"}], ",", " ", "elTable", ",",
      " ", 
     RowBox[{"params", "[", "\"\<phi\>\"", "]"}], ",", " ", "90"}], "]"}], ",",
    "\n", " ", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"freqForms", "[", "\"\<Quartic\>\"", "]"}], "[", 
     RowBox[{
      RowBox[{"params", "[", "\"\<EJqMin\>\"", "]"}], ",", " ", 
      RowBox[{"params", "[", "\"\<phi\>\"", "]"}], ",", " ", "elTable"}], 
     "]"}], "]"}]}], "}"}]}], "Input",
 CellID->732065401,ExpressionUUID->"39b74b5f-9ce4-4bd2-8487-51c9fc75e389"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "7.241479426830272`", ",", "7.241479426830504`", ",", 
   "7.255444623507805`"}], "}"}]], "Output",ExpressionUUID->"86237fc9-a9ec-\
443e-aa51-9e79948cb848"]
}, Open  ]],

Cell["\<\
With the inductive energy the quartic formula is accurate at the minimum, and \
the minimum frequency lies far above both low-frequency qubits.\
\>", "Text",
 CellID->445277513,ExpressionUUID->"37222659-7733-4dc8-b1b7-e856789ea180"],

Cell["\<\
Compute the largest phase each low-frequency qubit can have under the \
minimum, first with the harmonic formula and then with the quartic one. Each \
row gives the qubit frequency in GHz, the phase with Table I's inductive \
energy, and the phase with none.\
\>", "Text",
 CellID->724145374,ExpressionUUID->"53fab0a1-f227-4a5e-bc45-3a88a61389e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"w0", ",", " ", 
     RowBox[{
      RowBox[{"maxPhase", "[", "f", "]"}], "[", 
      RowBox[{"w0", ",", " ", "elTable"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"maxPhase", "[", "f", "]"}], "[", 
      RowBox[{"w0", ",", " ", "0"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"f", ",", " ", 
     RowBox[{"Keys", "[", "freqForms", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"w0", ",", " ", 
     RowBox[{
      RowBox[{"params", "[", "\"\<wq\>\"", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"3", " ", ";;", " ", "4"}], "]"}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellID->1893161544,ExpressionUUID->"cc038b34-5c71-4e4e-9e9b-243d85356052"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox["7", "2"], ",", 
       RowBox[{"33", " ", 
        SqrtBox[
         FractionBox["35", "174322"]]}], ",", 
       SqrtBox[
        FractionBox["5", "14"]]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["41", "10"], ",", 
       RowBox[{"33", " ", 
        SqrtBox[
         FractionBox["41", "174322"]]}], ",", 
       FractionBox[
        SqrtBox[
         FractionBox["41", "2"]], "7"]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox["7", "2"], ",", 
       SqrtBox[
        FractionBox["7", 
         RowBox[{
          FractionBox["87161", "5445"], "+", 
          FractionBox[
           SqrtBox[
            FractionBox["13160225327", "2"]], "5445"]}]]], ",", 
       SqrtBox[
        FractionBox["7", 
         RowBox[{
          FractionBox["49", "5"], "+", 
          FractionBox[
           RowBox[{"21", " ", 
            SqrtBox[
             FractionBox["7", "2"]]}], "5"]}]]]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["41", "10"], ",", 
       SqrtBox[
        FractionBox["41", 
         RowBox[{"5", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["87161", "5445"], "+", 
            FractionBox[
             SqrtBox[
              FractionBox["12811564553", "2"]], "5445"]}], ")"}]}]]], ",", 
       SqrtBox[
        FractionBox["41", 
         RowBox[{"5", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["49", "5"], "+", 
            FractionBox[
             RowBox[{"7", " ", 
              SqrtBox[
               FractionBox["57", "2"]]}], "5"]}], ")"}]}]]]}], "}"}]}], 
    "}"}]}], "}"}]], "Output",ExpressionUUID->"4839b767-10b2-4687-9b5c-\
676881f71e03"]
}, Open  ]],

Cell["Verify that every one of these phases lies below 0.7.", "Text",
 CellID->364502057,ExpressionUUID->"e9b5b549-be50-4069-9624-ad0904608cd5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"maxPhase", "[", "#1", "]"}], "[", 
      RowBox[{"#2", ",", " ", "#3"}], "]"}], " ", "&"}], " ", "@@@", " ", 
    RowBox[{"Tuples", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Keys", "[", "freqForms", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"params", "[", "\"\<wq\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"3", " ", ";;", " ", "4"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"elTable", ",", " ", "0"}], "}"}]}], "}"}], "]"}]}], "]"}], 
  " ", "<", " ", 
  RowBox[{"params", "[", "\"\<phi\>\"", "]"}]}]], "Input",
 CellID->245921084,ExpressionUUID->"ac59136b-1290-45c2-8694-6e98deef69ac"],

Cell[BoxData["True"], "Output",ExpressionUUID->"b6a0504b-11c3-4369-a614-ec5e0b3e880c"]
}, Open  ]],

Cell[TextData[{
 "Verify the formula exactly at one convenient point: with the harmonic \
frequency formula, a 3.5 GHz qubit with an inductive energy of 7/32 GHz under \
the 4.9 GHz minimum has largest phase ",
 Cell[BoxData[
  RowBox[{"\[CurlyPhi]", "=", 
   SqrtBox[
    RowBox[{"10", "/", "33"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b541e7ab-a61e-4d89-82eb-5f802b6030c8"],
 "."
}], "Text",
 CellID->912608870,ExpressionUUID->"06c926de-01c2-4237-9c10-18b58b8d112d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"maxPhase", "[", "\"\<Harmonic\>\"", "]"}], "[", 
   RowBox[{
    RowBox[{"7", "/", "2"}], ",", " ", 
    RowBox[{"7", "/", "32"}]}], "]"}], " ", "===", " ", 
  RowBox[{"Sqrt", "[", 
   RowBox[{"10", "/", "33"}], "]"}]}]], "Input",
 CellID->1410349120,ExpressionUUID->"d4a96744-7091-44d6-9478-a70dd12a26d1"],

Cell[BoxData["True"], "Output",ExpressionUUID->"05e5fe70-8761-4d7b-a6b8-56af470b65d5"]
}, Open  ]],

Cell["\<\
Under the minimum, neither low-frequency qubit reaches the phase 0.7, with or \
without the inductive energy. The same answer comes from the other direction: \
what Josephson energy does each qubit need to have phase 0.7 at its Table I \
frequency?\
\>", "Text",
 CellID->1167983258,ExpressionUUID->"07fec8a1-b582-4e06-8c56-f897faad60d6"],

Cell["\<\
Compute those energies, in GHz, for Table I's four qubits, with both \
frequency formulas.\
\>", "Text",
 CellID->371025263,ExpressionUUID->"2057b516-4492-413d-be51-2bf9bbc1e1a0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"inferredBare", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"f", ",", "\n", "   ", 
       RowBox[{"ejq", " ", "/.", " ", 
        RowBox[{"First", "[", 
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"freqForms", "[", "f", "]"}], "[", 
             RowBox[{"ejq", ",", " ", 
              RowBox[{"params", "[", "\"\<phi\>\"", "]"}], ",", " ", 
              "elTable"}], "]"}], " ", "==", " ", "wv"}], ",", " ", "ejq"}], 
          "]"}], "]"}]}]}], "]"}], ",", " ", 
     RowBox[{"Keys", "[", "freqForms", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{"expr", " ", "|->", " ", 
    RowBox[{"expr", " ", "/.", " ", 
     RowBox[{"wv", " ", "->", " ", 
      RowBox[{"params", "[", "\"\<wq\>\"", "]"}]}]}]}], ",", " ", 
   "inferredBare"}], "]"}]}], "Input",
 CellID->1970769953,ExpressionUUID->"36f19851-3c18-4513-be9c-ceb2e8ac10f8"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Harmonic\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["585790", "53361"], ",", 
      FractionBox["542230", "53361"], ",", 
      FractionBox["3565", "7623"], ",", 
      FractionBox["57625", "53361"]}], "}"}]}], ",", 
   RowBox[{"\<\"Quartic\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["234316000", "18729711"], ",", 
      FractionBox["16684000", "1440747"], ",", 
      FractionBox["1426000", "2675673"], ",", 
      FractionBox["23050000", "18729711"]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"259e01fa-96ba-4c87-86b7-\
e6d4d964a698"]
}, Open  ]],

Cell["\<\
Verify that, with both formulas, the two low-frequency qubits need less than \
the 4.9 GHz minimum.\
\>", "Text",
 CellID->1458776515,ExpressionUUID->"3b34ff64-29d6-499b-8a00-007f667d9587"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"expr", " ", "|->", " ", 
      RowBox[{"expr", " ", "/.", " ", 
       RowBox[{"wv", " ", "->", " ", 
        RowBox[{
         RowBox[{"params", "[", "\"\<wq\>\"", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"3", " ", ";;", " ", "4"}], "]"}], "]"}]}]}]}], ",", " ", 
     RowBox[{"Values", "[", "inferredBare", "]"}]}], "]"}], "]"}], " ", "<", 
  " ", 
  RowBox[{"params", "[", "\"\<EJqMin\>\"", "]"}]}]], "Input",
 CellID->1284630344,ExpressionUUID->"cf6deaa0-f23f-49dd-9866-1556a1e30c9c"],

Cell[BoxData["True"], "Output",ExpressionUUID->"3309b19d-3bc8-452b-85d0-ab2972a9f717"]
}, Open  ]],

Cell["\<\
The two high-frequency qubits need ordinary Josephson energies. The two \
low-frequency qubits need positive but small ones. So the single coupler is \
consistent on its own, but its two low-frequency qubits fall far below the \
array's minimum.\
\>", "Text",
 CellID->1097657070,ExpressionUUID->"57e6138d-bcb1-44ec-8108-ff40fd008827"],

Cell[TextData[{
 "The circuit relations are exact, and so is the rise of the frequency with \
",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], 
   StyleBox[
    RowBox[{"J", "q"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39db7f8e-0d65-4054-844b-1e45e8113d17"],
 " and ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03957ef1-13b6-41a5-9c6c-3fc448b1c5fd"],
 " that turns the minimum Josephson energy into a minimum frequency. The \
frequencies themselves are expansions. With no inductive energy the exact \
Mathieu levels show the expansion can fail, by an amount set by the offset \
charge. With Table I's inductive energy the diagonalization agrees with the \
quartic formula, and the quartic correction moves the required energies far \
less than their distance from the minimum. What stays open is the reading of \
Table I's phase 0.7 as each qubit's zero-point phase, as in the circuit of \
[2], and the array itself. The array search also changes the qubits' \
capacitances and the coupler's inductance ([1], supplementary Table S4), and \
the preprint does not list each array qubit's frequency and phase. So whether \
the array meets its minimum cannot be decided here. The relation between \
phase, frequency and circuit energies is what the parameter search could test \
directly."
}], "Text",
 CellID->1763005307,ExpressionUUID->"91f396e4-0e5f-4cda-8548-69a9ac43a442"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Question 2: Do the Two Written Josephson Terms Describe the Same Device?\
\>", "Section",
 CellID->1115878925,ExpressionUUID->"cdc7750f-1067-4c8c-b0a6-5e0dc80a4955"],

Cell[TextData[{
 "The preprint writes the coupler's Josephson energy twice. The main text \
uses the symmetric form above. The supplement writes a single cosine, ",
 Cell[BoxData[
  RowBox[{"-", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["J", "TI"]], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CurlyPhi]", 
     StyleBox[
      RowBox[{"d", "c"}], "TI"]], "+", 
    OverscriptBox["\[CurlyPhi]", "^"], "+", 
    SubscriptBox["\[CurlyPhi]", 
     StyleBox["d", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45f638e1-656c-4cda-bddb-78ddacd3d8f8"],
 ", and calls it schematic ([1], supplementary Sec. S4). If both describe the \
device, both should produce the four-qubit term. They do not. With the \
coupler empty, the four-qubit term linear in the drive grows as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CurlyPhi]", 
     StyleBox[
      RowBox[{"d", "c"}], "TI"]], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3b9497f-4ebf-455f-9d02-38f4bd44f736"],
 " in the main-text form and as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubscriptBox["\[CurlyPhi]", 
    StyleBox[
     RowBox[{"d", "c"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c499f8c-ca4a-4707-a55c-b24e6bb73b86"],
 " in the supplement's. So at the operating bias ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CurlyPhi]", 
    StyleBox[
     RowBox[{"d", "c"}], "TI"]], "=", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1d3ec61-e577-4f96-8148-5512d7a16198"],
 " the supplement's form gives none."
}], "Text",
 CellID->2125569533,ExpressionUUID->"5e17c239-d657-4515-bdf8-5c411ff028cd"],

Cell["\<\
Compare the two drive-linear coefficients at a symbolic bias.\
\>", "Text",
 CellID->1120586436,ExpressionUUID->"97711437-d83d-4030-88a4-346ea15ab4b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"pdc", "/", "2"}], "]"}], " ", 
      RowBox[{"couplerFactor", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
         " ", "0", ",", " ", "phizpf"}], "]"}]}], ",", "\n", "  ", 
     RowBox[{"ComplexExpand", "[", 
      RowBox[{"Im", "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "pdc"}], "]"}], " ", 
        RowBox[{"osc", "[", 
         RowBox[{"0", ",", " ", "phizpf"}], "]"}], " ", 
        RowBox[{"xFactor", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], 
         "]"}]}], "]"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"phizpf", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellID->25958871,ExpressionUUID->"7a27b8c6-65ba-4b2c-b148-19228d8ff28b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["phizpf", "2"], "2"]}]], " ", 
    RowBox[{"Sin", "[", 
     FractionBox["pdc", "2"], "]"}], " ", 
    RowBox[{"Sin", "[", "t1", "]"}], " ", 
    RowBox[{"Sin", "[", "t2", "]"}], " ", 
    RowBox[{"Sin", "[", "t3", "]"}], " ", 
    RowBox[{"Sin", "[", "t4", "]"}]}], ",", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["phizpf", "2"], "2"]}]], " ", 
    RowBox[{"Sin", "[", "pdc", "]"}], " ", 
    RowBox[{"Sin", "[", "t1", "]"}], " ", 
    RowBox[{"Sin", "[", "t2", "]"}], " ", 
    RowBox[{"Sin", "[", "t3", "]"}], " ", 
    RowBox[{"Sin", "[", "t4", "]"}]}]}], "}"}]], "Output",ExpressionUUID->\
"cc078919-2f10-4452-af9d-c101d06df3b2"]
}, Open  ]],

Cell[TextData[{
 "Compare their static four-qubit terms at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CurlyPhi]", 
    StyleBox[
     RowBox[{"d", "c"}], "TI"]], "=", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5000914-9c67-409f-8caf-a521f91eed60"],
 "."
}], "Text",
 CellID->1462357393,ExpressionUUID->"5c73298c-45a6-4090-b4a0-783fdfe036c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"Pi", "/", "2"}], "]"}], " ", 
      RowBox[{"couplerFactor", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
         " ", "0", ",", " ", "phizpf"}], "]"}]}], ",", "\n", "  ", 
     RowBox[{"-", 
      RowBox[{"ComplexExpand", "[", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "Pi"}], "]"}], " ", 
         RowBox[{"osc", "[", 
          RowBox[{"0", ",", " ", "phizpf"}], "]"}], " ", 
         RowBox[{"xFactor", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], 
          "]"}]}], "]"}], "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"phizpf", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellID->572246452,ExpressionUUID->"9c9a62a1-9c6d-4cd5-8a87-685a70319f27"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["phizpf", "2"], "2"]}]], " ", 
    RowBox[{"Sin", "[", "t1", "]"}], " ", 
    RowBox[{"Sin", "[", "t2", "]"}], " ", 
    RowBox[{"Sin", "[", "t3", "]"}], " ", 
    RowBox[{"Sin", "[", "t4", "]"}]}]}], "}"}]], "Output",ExpressionUUID->\
"c5fabac0-7c07-4171-83c1-2906d0d8791d"]
}, Open  ]],

Cell[TextData[{
 "At the operating bias, then, the main-text form drives the four-qubit term \
and has no static Josephson term. The supplement's form does not drive it, \
and keeps the full ",
 Cell[BoxData[
  RowBox[{"+", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["J", "TI"]], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   OverscriptBox["\[CurlyPhi]", "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e87b79aa-76c6-44d8-84d0-7a8a8fe728ab"],
 " as a static term. The two forms also drive different Pauli products \
altogether. With the coupler empty, the main-text drive contains only \
products of an even number of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["X", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "723b0eb9-8c37-45ed-87cd-930f49efa104"],
 ", and the supplement's, at this bias, only products of an odd number."
}], "Text",
 CellID->351728041,ExpressionUUID->"d0ebf997-dd2c-4ca8-8aa6-b187bc29ba7e"],

Cell["Define the nonzero Pauli products of a drive term.", "Text",
 CellID->1224652745,ExpressionUUID->"e4df1ef5-dacc-442b-82f9-c365afa87888"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"drivenWords", "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{"f", "[", "#", "]"}], ",", " ", 
          RowBox[{"phizpf", " ", ">", " ", "0"}]}], "]"}], " ", "&"}], ",", 
       " ", 
       RowBox[{"Subsets", "[", 
        RowBox[{"Range", "[", "4", "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"#", " ", "=!=", " ", "0"}], " ", "&"}]}], "]"}]}], 
  ";"}]], "Input",
 CellID->1289919228,ExpressionUUID->"c6ede72b-ccf7-4121-a68c-55d4d0b91521"],

Cell[TextData[{
 "List how many ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["X", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02586bda-fd8d-42d2-b2cc-11be21945ba6"],
 " each product in the main-text drive contains."
}], "Text",
 CellID->1169389055,ExpressionUUID->"1184a512-c96d-413f-8dc7-ce803a207552"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", "[", 
  RowBox[{"Length", " ", "/@", " ", 
   RowBox[{"Keys", "[", 
    RowBox[{"drivenWords", "[", 
     RowBox[{
      RowBox[{"couplerFactor", "[", 
       RowBox[{"#", ",", " ", "0", ",", " ", "phizpf"}], "]"}], " ", "&"}], 
     "]"}], "]"}]}], "]"}]], "Input",
 CellID->1710318553,ExpressionUUID->"bcacdbb6-934e-41bc-8185-34d8d854f6a9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "2", ",", "4"}], "}"}]], "Output",ExpressionUUID->\
"ff958031-057e-4b15-a013-be19083bdea3"]
}, Open  ]],

Cell["List the same for the supplement's drive.", "Text",
 CellID->543569477,ExpressionUUID->"f7e91b93-3ce8-4bbd-a1b3-f82dca56a941"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", "[", 
  RowBox[{"Length", " ", "/@", " ", 
   RowBox[{"Keys", "[", 
    RowBox[{"drivenWords", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"Im", "[", 
         RowBox[{
          RowBox[{"osc", "[", 
           RowBox[{"0", ",", " ", "phizpf"}], "]"}], " ", 
          RowBox[{"xFactor", "[", "#", "]"}]}], "]"}], "]"}]}], " ", "&"}], 
     "]"}], "]"}]}], "]"}]], "Input",
 CellID->524241718,ExpressionUUID->"49c1b439-bef2-430b-a354-f6613a3027aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3"}], "}"}]], "Output",ExpressionUUID->"fb743e72-4ba5-43a4-93bf-830f9bce67c2"]
}, Open  ]],

Cell["\<\
So the supplement's form flips single qubits and triples of qubits instead of \
producing the four-qubit term. Calling it schematic does not remove the \
conflict.\
\>", "Text",
 CellID->674005596,ExpressionUUID->"7c0dfe9a-2d07-4b7b-acde-b47be55a6db3"],

Cell[TextData[{
 "The conflict also holds at every higher order. At ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CurlyPhi]", 
    StyleBox[
     RowBox[{"d", "c"}], "TI"]], "=", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "437b3d69-2847-446a-a13c-2e7ff90061b5"],
 " the supplement's term is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["J", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    OverscriptBox["\[CurlyPhi]", "^"], 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox["\[CurlyPhi]", 
     StyleBox["d", "TI"]], "-", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    OverscriptBox["\[CurlyPhi]", "^"], 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SubscriptBox["\[CurlyPhi]", 
     StyleBox["d", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77277424-92d7-47c3-9190-e16a852ae42d"],
 ". With the coupler empty, the four-qubit product comes only from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   OverscriptBox["\[CurlyPhi]", "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d58eb08-0972-41bc-ac6f-85204a29f682"],
 ". It multiplies ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubscriptBox["\[CurlyPhi]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91957b4a-c6b4-4576-bca5-5cc186870b42"],
 ", whose expansion contains only products of an even number of tones. Each \
tone is a sum of the four qubit frequencies with signs ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a110ff7-b938-4968-b4ff-bcd8b96d7ef0"],
 ". So an even number of tones gives an even coefficient on every qubit \
frequency, while flipping all four qubits needs an odd one on each. The \
supplement's form therefore cannot drive the four-qubit term resonantly at \
any order, unless the qubit frequencies happen to be commensurate."
}], "Text",
 CellID->1067394268,ExpressionUUID->"f512ca3a-5ba4-464c-a9ba-fd6b9ffedd92"],

Cell["\<\
Verify that a sum of two signed tone patterns has only even coefficients.\
\>", "Text",
 CellID->662938664,ExpressionUUID->"59192789-7454-486b-b37c-fc6c40b4abc1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Total", " ", "/@", " ", 
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "4"}], "]"}], 
      ",", " ", "2"}], "]"}]}], ",", " ", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{"#", ",", " ", "EvenQ"}], "]"}], " ", "&"}]}], "]"}]], "Input",
 CellID->244926620,ExpressionUUID->"c4393d98-b474-4c0b-b4fd-b1adb60583e5"],

Cell[BoxData["True"], "Output",ExpressionUUID->"b502e340-0ce8-48f5-99ed-c99efe0d78bf"]
}, Open  ]],

Cell["\<\
Verify that, at the listed frequencies, no sum of two or four tones equals \
the energy of a four-qubit flip.\
\>", "Text",
 CellID->356162114,ExpressionUUID->"e436c542-3134-4fb7-b966-292878b60952"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"signed", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"params", "[", "\"\<tones\>\"", "]"}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"params", "[", "\"\<tones\>\"", "]"}]}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Intersection", "[", 
      RowBox[{
       RowBox[{"Union", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"Total", " ", "/@", " ", 
          RowBox[{"Tuples", "[", 
           RowBox[{"signed", ",", " ", "#"}], "]"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{"Union", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Tuples", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "4"}], 
           "]"}], " ", ".", " ", 
          RowBox[{"params", "[", "\"\<wq\>\"", "]"}]}], "]"}], "]"}]}], "]"}],
      " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "4"}], "}"}]}]}], "]"}]], "Input",
 CellID->1968701164,ExpressionUUID->"2a82d5f4-02b3-41b9-9158-1bb2592db47d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",ExpressionUUID->"1c4fb79e-9fca-4f84-\
8767-3e64ddc5b516"]
}, Open  ]],

Cell["\<\
Everything in this question is exact within the circuit model: the two \
first-order coefficients, the parity of the driven products, and the \
even-coefficient argument at every order. The last test holds for the listed, \
rounded frequencies and for sums of two and four tones only; the parity \
argument is what covers every order. What stays open is which form the \
preprint simulated, and the preprint should say.\
\>", "Text",
 CellID->1848903766,ExpressionUUID->"c08eff88-1bea-4c8b-8ceb-6dc1acf887c4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Question 3: What Else Does the Drive Produce?", "Section",
 CellID->2043314122,ExpressionUUID->"28a70205-494a-4131-8dce-4be729d6b050"],

Cell["\<\
The drive is tuned so that one transition, flipping all four qubits together, \
is resonant. But the same cosine contains every other Pauli product, combined \
with any number of coupler excitations, and a tone can match one of those \
too. The preprint limits these effects through its leakage budget and its \
limit on unwanted driven terms ([1], \"Single cell demonstration\"). This \
question lists them directly. At the listed frequencies, a few unwanted \
transitions are exactly resonant, each coupled far more strongly than the \
four-qubit term. But the listed frequencies are rounded too coarsely to tell \
whether they are resonant in the real circuit.\
\>", "Text",
 CellID->1823573859,ExpressionUUID->"69d8dec3-5c87-4f5c-9cbb-475f44b2bd48"],

Cell[TextData[{
 "A transition starts from a qubit configuration ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8e6af88-f28b-4cca-b678-b6f4b112f1b3"],
 ", where each ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["z", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3812cd29-3910-4151-b3fd-8ffe29953b6d"],
 " is 0 or 1, flips the qubits in a set ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3441111-209c-4a05-983c-96f305756924"],
 ", and leaves ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f39d1837-301a-4860-92e8-7fe0fc6b69f7"],
 " excitations in the coupler. Its energy change is"
}], "Text",
 CellID->801822598,ExpressionUUID->"e4f1f575-85fd-4d8d-8052-c9949e3a00d7"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"\[CapitalDelta]", 
    StyleBox["E", "TI"], "=", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "\[Element]", 
      StyleBox["S", "TI"]}],
     LimitsPositioning->False], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", "2", 
     SubscriptBox[
      StyleBox["z", "TI"], 
      StyleBox["i", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["i", "TI"]], "+", 
    StyleBox["m", "TI"], 
    SubscriptBox[
     StyleBox["f", "TI"], "-"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1331179845,ExpressionUUID->"230fdd7c-a3ef-438c-a838-893e7b9c92eb"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["f", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc6c69a1-b6c6-4b9e-94d4-66532348f76e"],
 " the qubit frequencies and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["f", "TI"], "-"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4040a2ec-b625-40c9-b478-ae43e457f6e7"],
 " the coupler's. A tone of frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25691103-82fe-48d8-80be-ccf5083ff117"],
 " makes the transition resonant when ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["E", "TI"], "=", "\[PlusMinus]", 
   StyleBox["\[Omega]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82fe38c8-4ffc-4f4d-bb7f-800fb0fe099f"],
 ", and its coupling is the coefficient from the Pauli sum times the coupler \
factor for ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2ae635b-d478-4897-a235-8e9b61d9a037"],
 " excitations. Transitions that only add coupler excitations, flipping no \
qubit, are left out: they shift every qubit configuration equally, so they \
cannot act on the qubits."
}], "Text",
 CellID->700675467,ExpressionUUID->"4ed8ded1-1322-4876-8ff8-415be0860a38"],

Cell["\<\
List every resonant transition other than the four-qubit term, up to a \
coupler cutoff set where the coupler factor has fallen to a hundredth of its \
largest value.\
\>", "Text",
 CellID->817607514,ExpressionUUID->"b519966c-2fc0-4e68-b322-afe7440d3c99"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mMax", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"amp", " ", "=", " ", 
       RowBox[{"Abs", "[", 
        RowBox[{"osc", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", "40"}], "]"}], ",", " ", 
          RowBox[{"params", "[", "\"\<phizpf\>\"", "]"}]}], "]"}], "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{
      RowBox[{"First", "[", 
       RowBox[{"FirstPosition", "[", 
        RowBox[{"amp", ",", " ", 
         RowBox[{"_", "?", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", " ", "<", " ", 
             RowBox[{
              RowBox[{"Max", "[", "amp", "]"}], "/", "100"}]}], " ", "&"}], 
           ")"}]}], ",", " ", 
         RowBox[{"Missing", "[", "]"}], ",", " ", 
         RowBox[{"{", "1", "}"}]}], "]"}], "]"}], " ", "-", " ", "1"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wordFactor", "[", 
    RowBox[{"s_", ",", " ", "m_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"wordFactor", "[", 
     RowBox[{"s", ",", " ", "m"}], "]"}], " ", "=", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"couplerFactor", "[", 
       RowBox[{"s", ",", " ", "m", ",", " ", 
        RowBox[{"params", "[", "\"\<phizpf\>\"", "]"}]}], "]"}], " ", "/.", 
      " ", 
      RowBox[{"Thread", "[", 
       RowBox[{"angles", " ", "->", " ", 
        RowBox[{
         RowBox[{"params", "[", "\"\<s\>\"", "]"}], " ", 
         RowBox[{
          RowBox[{"params", "[", "\"\<phi\>\"", "]"}], "/", "2"}]}]}], 
       "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"modes", " ", "=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{"params", "[", "\"\<wq\>\"", "]"}], ",", " ", 
     RowBox[{"params", "[", "\"\<wminus\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"signedTones", " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"params", "[", "\"\<tones\>\"", "]"}], ",", " ", 
     RowBox[{"-", 
      RowBox[{"params", "[", "\"\<tones\>\"", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zStates", " ", "=", " ", 
   RowBox[{"Tuples", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zWords", " ", "=", " ", 
   RowBox[{"Subsets", "[", 
    RowBox[{
     RowBox[{"Range", "[", "4", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"quanta", "[", 
    RowBox[{"z_", ",", " ", "s_", ",", " ", "m_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{"ReplacePart", "[", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"Thread", "[", 
        RowBox[{"s", " ", "->", " ", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"2", " ", 
           RowBox[{"z", "[", 
            RowBox[{"[", "s", "]"}], "]"}]}]}]}], "]"}]}], "]"}], ",", " ", 
     "m"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"energyChange", "[", 
    RowBox[{"z_", ",", " ", "s_", ",", " ", "m_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"quanta", "[", 
     RowBox[{"z", ",", " ", "s", ",", " ", "m"}], "]"}], " ", ".", " ", 
    "modes"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"drive0", " ", "=", " ", 
   RowBox[{
    RowBox[{"params", "[", "\"\<EJ\>\"", "]"}], " ", 
    RowBox[{
     RowBox[{"params", "[", "\"\<A\>\"", "]"}], "/", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"process", "[", "drive_", "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"z_", ",", " ", "s_", ",", " ", "m_", ",", " ", "w_"}], "}"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<State\>\"", " ", "->", " ", "z"}], ",", " ", 
     RowBox[{"\"\<Word\>\"", " ", "->", " ", "s"}], ",", " ", 
     RowBox[{"\"\<Fock\>\"", " ", "->", " ", "m"}], ",", " ", 
     RowBox[{"\"\<Tone\>\"", " ", "->", " ", "w"}], ",", "\n", "   ", 
     RowBox[{"\"\<Detuning\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"energyChange", "[", 
        RowBox[{"z", ",", " ", "s", ",", " ", "m"}], "]"}], " ", "-", " ", 
       "w"}]}], ",", " ", 
     RowBox[{"\"\<g\>\"", " ", "->", " ", 
      RowBox[{"drive", " ", 
       RowBox[{"wordFactor", "[", 
        RowBox[{"s", ",", " ", "m"}], "]"}]}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"processes", "[", 
    RowBox[{"z_", ",", " ", "mm_", ",", " ", "drive_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{
    RowBox[{"process", "[", "drive", "]"}], " ", "/@", " ", 
    RowBox[{"Tuples", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "z", "}"}], ",", " ", "zWords", ",", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "mm"}], "]"}], ",", " ", "signedTones"}], 
      "}"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"inTune", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Catenate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"processes", "[", 
         RowBox[{"#", ",", " ", "mMax", ",", " ", "drive0"}], "]"}], " ", 
        "&"}], " ", "/@", " ", "zStates"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"#Detuning", " ", "==", " ", "0"}], " ", "&&", " ", 
       RowBox[{"#g", " ", "=!=", " ", "0"}], " ", "&&", " ", 
       RowBox[{"!", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#Word", " ", "===", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], 
            "}"}]}], " ", "&&", " ", 
          RowBox[{"#Fock", " ", "==", " ", "0"}]}], ")"}]}]}], " ", "&"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resonant", " ", "=", " ", 
   RowBox[{"Union", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"MapAt", "[", 
       RowBox[{"Abs", ",", " ", 
        RowBox[{"KeyDrop", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<State\>\"", ",", " ", "\"\<Detuning\>\""}], "}"}]}], 
         "]"}], ",", " ", "\"\<Tone\>\""}], "]"}], " ", "&"}], " ", "/@", " ",
      "inTune"}], "]"}]}], ";"}]}], "Input",
 CellID->722614850,ExpressionUUID->"dd766715-ae28-43cb-a030-7cb6e0d34bf4"],

