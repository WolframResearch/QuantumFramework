Cell[CellGroupData[{

Cell["The Coupler Factors", "Subsection",
 CellID->1554103542,ExpressionUUID->"418c4945-9674-4664-a5fd-f7ebb2e3885c"],

Cell[TextData[{
 "Verify the formula for ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["m", "TI"]},
    "Bra"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "\[CurlyPhi]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["d", "TI"], "^"], "+", 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["d", "TI"], "^"], "\[Dagger]"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9460e07-9592-4c6d-9600-933c5b2ace12"],
 " for every ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74679dcc-aad9-4bdd-95b0-dcb8308c1139"],
 " at once, through the generating function of the oscillator wavefunctions."
}], "Text",
 CellID->1913063583,ExpressionUUID->"046a2c7c-0b34-4aa9-8742-85a2403f7155"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"generating", "[", 
    RowBox[{"t_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"y", "^", "2"}]}], "/", "2"}], "]"}], "/", 
     RowBox[{"Pi", "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "4"}], ")"}]}]}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], " ", "t", " ", "y"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"t", "^", "2"}], "/", "2"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"generating", "[", 
        RowBox[{"t", ",", " ", "y"}], "]"}], " ", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"y", "^", "2"}]}], "/", "2"}], "]"}], "/", 
        RowBox[{"Pi", "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "4"}], ")"}]}]}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", 
         RowBox[{"Sqrt", "[", "2", "]"}], " ", "p", " ", "y"}], "]"}]}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", 
        RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}]}], "]"}], 
    " ", "-", "\n", "   ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"t", "^", "m"}], "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"m", "!"}], "]"}]}], " ", 
       RowBox[{"osc", "[", 
        RowBox[{"m", ",", " ", "p"}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], "]"}]}], ",",
    " ", 
   RowBox[{
    RowBox[{"p", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"t", " ", ">", " ", "0"}]}]}], "]"}]}], "Input",
 CellID->303836288,ExpressionUUID->"78358fed-a429-4db1-a22b-c1fae9736aeb"],

Cell[BoxData["0"], "Output",ExpressionUUID->"06de56e4-5914-4169-bec0-d2ee0e5fe751"]
}, Open  ]],

Cell["\<\
The diagonal Laguerre formula follows from the Mehler kernel, the generating \
function of the squared wavefunctions.\
\>", "Text",
 CellID->1363762949,ExpressionUUID->"dcbf8a5d-3c37-4f04-bfed-c2e4bfa63437"],

Cell["Define the wavefunctions and the kernel.", "Text",
 CellID->1395687866,ExpressionUUID->"8a2fb984-2721-4d28-96ab-540b03ae7bfd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"psi", "[", 
    RowBox[{"m_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"HermiteH", "[", 
     RowBox[{"m", ",", " ", "y"}], "]"}], " ", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"y", "^", "2"}]}], "/", "2"}], "]"}], "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"2", "^", "m"}], " ", 
       RowBox[{"m", "!"}], " ", 
       RowBox[{"Sqrt", "[", "Pi", "]"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mehler", "[", 
    RowBox[{"t_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"y", "^", "2"}]}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "t"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "t"}], ")"}]}]}], "]"}], "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"Pi", " ", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"t", "^", "2"}]}], ")"}]}], "]"}]}]}], ";"}]}], "Input",
 CellID->791017620,ExpressionUUID->"046cbf71-0e0d-4270-8580-0d3dbf55016f"],

Cell["\<\
Compare the kernel with the wavefunctions through fourth order.\
\>", "Text",
 CellID->1188668753,ExpressionUUID->"050fdb23-ba24-4fe0-8b65-9ea66a22e8fa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"mehler", "[", 
       RowBox[{"t", ",", " ", "y"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}], "]"}], 
   " ", "-", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"t", "^", "m"}], " ", 
      RowBox[{
       RowBox[{"psi", "[", 
        RowBox[{"m", ",", " ", "y"}], "]"}], "^", "2"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellID->1925258800,ExpressionUUID->"f00927a3-0856-4836-8f66-183931820f76"],

Cell[BoxData["0"], "Output",ExpressionUUID->"0580ed74-30ca-424b-8e86-f65c2b71a9bb"]
}, Open  ]],

Cell["Compare its integral with the Laguerre generating function.", "Text",
 CellID->1100461527,ExpressionUUID->"599ab867-76be-456e-8085-520ec0ce0ec8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"mehler", "[", 
        RowBox[{"t", ",", " ", "y"}], "]"}], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", "2", "]"}], " ", "p", " ", "y"}], "]"}]}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", 
        RowBox[{"-", "Infinity"}], ",", " ", "Infinity"}], "}"}], ",", " ", 
      RowBox[{"Assumptions", " ", "->", " ", 
       RowBox[{
        RowBox[{"0", " ", "<", " ", "t", " ", "<", " ", "1"}], " ", "&&", " ", 
        RowBox[{"p", " ", ">", " ", "0"}]}]}]}], "]"}], " ", "-", "\n", "  ", 
    
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"p", "^", "2"}]}], "/", "2"}], "]"}], " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t", "^", "m"}], " ", 
        RowBox[{"LaguerreL", "[", 
         RowBox[{"m", ",", " ", 
          RowBox[{"p", "^", "2"}]}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], 
      "]"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "t", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"p", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellID->66331113,ExpressionUUID->"c3b10eec-7e5b-4f0b-91e8-2a9644861d7d"],

Cell[BoxData["0"], "Output",ExpressionUUID->"5082cc17-4e38-4ab0-b879-dee664df0ae6"]
}, Open  ]],

Cell["\<\
As an independent numerical test, exponentiate the coupler's position \
operator truncated to 40 and to 80 levels, and give the largest difference \
from the closed forms in the low entries.\
\>", "Text",
 CellID->1729644541,ExpressionUUID->"14f92173-1f83-4187-bdeb-3e5b5d9663f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p0", " ", "=", " ", 
     RowBox[{"params", "[", "\"\<phizpf\>\"", "]"}]}], "}"}], ",", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dsp", " ", "=", " ", 
         RowBox[{"MatrixExp", "[", 
          RowBox[{"I", " ", 
           RowBox[{"N", "[", "p0", "]"}], " ", 
           RowBox[{"oscCoordinate", "[", "n", "]"}]}], "]"}]}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"dsp", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"1", " ", ";;", " ", "8"}], ",", " ", "1"}], "]"}], 
             "]"}], " ", "-", " ", 
            RowBox[{"N", "[", 
             RowBox[{"osc", "[", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"0", ",", " ", "7"}], "]"}], ",", " ", "p0"}], "]"}], 
             "]"}]}], "]"}], "]"}], ",", "\n", "    ", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Diagonal", "[", "dsp", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", " ", ";;", " ", "4"}], "]"}], "]"}], " ", "-", " ", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"p0", "^", "2"}]}], "/", "2"}], "]"}], " ", 
              RowBox[{"LaguerreL", "[", 
               RowBox[{
                RowBox[{"Range", "[", 
                 RowBox[{"0", ",", " ", "3"}], "]"}], ",", " ", 
                RowBox[{"p0", "^", "2"}]}], "]"}]}], "]"}]}], "]"}], "]"}]}], 
        "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"{", 
        RowBox[{"40", ",", " ", "80"}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellID->574174116,ExpressionUUID->"79ef7b51-1a1e-442e-8785-c1e6c564f5be"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5.551115123125783`*^-16", ",", "7.494005416219807`*^-16"}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6.661338147750939`*^-16", ",", "3.885780586188048`*^-16"}], 
    "}"}]}], "}"}]], "Output",ExpressionUUID->"270820fe-9248-4b12-b123-\
24778590e8c8"]
}, Open  ]],

Cell["\<\
The differences are at machine precision: the closed forms agree with a route \
that shares no derivation with them.\
\>", "Text",
 CellID->1686078773,ExpressionUUID->"1817c90a-e1cd-42ac-b7f5-cd849cf469c3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Tones: Amplitude and Phases", "Subsection",
 CellID->1753397031,ExpressionUUID->"a52f652e-c425-4f69-a8f9-e07da5a8f9c8"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CurlyPhi]", 
    StyleBox[
     RowBox[{"d", "c"}], "TI"]], "=", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "533ff4dc-2806-48fa-924d-bbb309c29e49"],
 " the main-text Josephson term becomes ",
 Cell[BoxData[
  RowBox[{"2", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["J", "TI"]], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CurlyPhi]", 
     StyleBox["d", "TI"]], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   OverscriptBox["\[CurlyPhi]", "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66afff41-f434-44b1-bd0d-54e918d20d10"],
 ". Write ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CurlyPhi]", 
     StyleBox["d", "TI"]], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b62e6d3-8faa-4d85-a9f0-76f6e20c4d64"],
 " as the imaginary part of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     SubscriptBox["\[CurlyPhi]", 
      StyleBox["d", "TI"]], "/", "2"}]], "=", 
   UnderscriptBox["\[Product]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["A", "TI"], "/", "2"}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Omega]", "TI"], 
       StyleBox["k", "TI"]], 
      StyleBox["t", "TI"], "+", 
      SubscriptBox[
       StyleBox["\[Phi]", "TI"], 
       StyleBox["k", "TI"]]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "357ab5dc-4774-47a9-8f0d-6e3f2bb8a2fe"],
 " and expand each factor with the Jacobi-Anger identity ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["z", "TI"], 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["x", "TI"]}]], "=", 
   UnderscriptBox["\[Sum]", 
    StyleBox["n", "TI"],
    LimitsPositioning->False], 
   SuperscriptBox[
    StyleBox["i", "TI"], 
    StyleBox["n", "TI"]], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["z", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "n", "x"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41cfd71e-c75a-46af-85a0-d9e592325a42"],
 ", where ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a25fc4bc-d958-4c83-8a0a-f2a63f04703f"],
 " is the Bessel function of the first kind of order ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ff99ec8-e096-4967-80a2-44bbb2a439a2"],
 ". Keep ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3e3b969-6973-48af-abaa-c768c56ca4e2"],
 " for one tone and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eebae733-1923-4ad7-9459-8e12800a4581"],
 " for the other seven: the imaginary part is ",
 Cell[BoxData[
  RowBox[{"2", 
   SubscriptBox[
    StyleBox["J", "TI"], "1"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["A", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["J", "TI"], "0"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["A", "TI"], "/", "2"}], 
     StyleBox[")",
      SpanMaxSize->1]}], "7"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1477f24d-53a1-48ca-aec4-0c07c9b76044"],
 " times that tone's cosine. So the term oscillating at that tone's frequency \
is ",
 Cell[BoxData[
  RowBox[{"4", 
   SubscriptBox[
    StyleBox["J", "TI"], "1"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["A", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["J", "TI"], "0"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["A", "TI"], "/", "2"}], 
     StyleBox[")",
      SpanMaxSize->1]}], "7"], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox["k", "TI"]], 
    StyleBox["t", "TI"], "+", 
    SubscriptBox[
     StyleBox["\[Phi]", "TI"], 
     StyleBox["k", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["J", "TI"]], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   OverscriptBox["\[CurlyPhi]", "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8fc8929-a88c-4692-8120-72adf68be6fd"],
 ". For a weak drive ",
 Cell[BoxData[
  RowBox[{"4", 
   SubscriptBox[
    StyleBox["J", "TI"], "1"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["A", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["J", "TI"], "0"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["A", "TI"], "/", "2"}], 
     StyleBox[")",
      SpanMaxSize->1]}], "7"], "=", 
   StyleBox["A", "TI"], "+", 
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["A", "TI"], "3"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0555c4e9-4ce5-4a13-abac-72dc03779e2d"],
 ", which recovers the first-order term ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["J", "TI"]], 
   SubscriptBox["\[CurlyPhi]", 
    StyleBox["d", "TI"]], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   OverscriptBox["\[CurlyPhi]", "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb51ea1f-a402-492a-9c15-93f09a446257"],
 ". Tones whose frequencies are related add other terms at third order, so \
this product is not the whole third-order answer; at the preprint's weak \
drive the leading term is what matters."
}], "Text",
 CellID->1479540580,ExpressionUUID->"32ab9bb1-0114-466b-8f28-5476e1d43302"],

Cell["Expand the Bessel product.", "Text",
 CellID->1413782510,ExpressionUUID->"d399a064-69bc-4e9d-bd98-8aea68adf82d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"4", " ", 
    RowBox[{"BesselJ", "[", 
     RowBox[{"1", ",", " ", 
      RowBox[{"A", "/", "2"}]}], "]"}], " ", 
    RowBox[{
     RowBox[{"BesselJ", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"A", "/", "2"}]}], "]"}], "^", "7"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"A", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]], "Input",
 CellID->1044224263,ExpressionUUID->"5a62b392-1ae9-4b6d-9ee3-158c1ded57b2"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"A", "-", 
   FractionBox[
    RowBox[{"15", " ", 
     SuperscriptBox["A", "3"]}], "32"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "A", "]"}], "4"],
    SeriesData[$CellContext`A, 0, {}, 1, 4, 1],
    Editable->False]}],
  SeriesData[$CellContext`A, 0, {1, 0, 
    Rational[-15, 32]}, 1, 4, 1],
  Editable->False]], "Output",ExpressionUUID->"e72970db-e3c1-421c-a756-\
5052ffe6e4dd"]
}, Open  ]],

Cell["\<\
Give its leading relative correction at the preprint's drive.\
\>", "Text",
 CellID->877015706,ExpressionUUID->"f047a020-150a-4d2d-9bba-cb16a41b1c0c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Normal", "[", 
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"4", " ", 
       RowBox[{"BesselJ", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"A", "/", "2"}]}], "]"}], " ", 
       RowBox[{
        RowBox[{
         RowBox[{"BesselJ", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"A", "/", "2"}]}], "]"}], "^", "7"}], "/", "A"}]}], " ", "-",
       " ", "1"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"A", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], "]"}], " ",
   "/.", " ", 
  RowBox[{"A", " ", "->", " ", 
   RowBox[{"params", "[", "\"\<A\>\"", "]"}]}]}]], "Input",
 CellID->787058812,ExpressionUUID->"0cfe55ea-0787-4135-ae1d-7e349b825484"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox["6627", "640000000"]}]], "Output",ExpressionUUID->"e76a3046-4162-4d01-9d25-393c36509aab"]
}, Open  ]],

Cell["\<\
Verify that every tone is a signed sum of three others, so third-order mixing \
of tones lands exactly on a tone.\
\>", "Text",
 CellID->406898107,ExpressionUUID->"829f0302-9cd7-420f-b2a6-d8b4d8ca9552"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"params", "[", "\"\<tones\>\"", "]"}], ",", " ", 
   RowBox[{"t", " ", "|->", " ", 
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"Catenate", "[", 
        RowBox[{"Outer", "[", 
         RowBox[{"Dot", ",", " ", 
          RowBox[{"Tuples", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "3"}], 
           "]"}], ",", " ", 
          RowBox[{"Subsets", "[", 
           RowBox[{
            RowBox[{"DeleteCases", "[", 
             RowBox[{
              RowBox[{"params", "[", "\"\<tones\>\"", "]"}], ",", " ", "t"}], 
             "]"}], ",", " ", 
            RowBox[{"{", "3", "}"}]}], "]"}], ",", " ", "1"}], "]"}], "]"}], 
       "]"}], ",", " ", "t"}], "]"}]}]}], "]"}]], "Input",
 CellID->407861122,ExpressionUUID->"75c36898-6939-434d-ba2e-eac75db68013"],

Cell[BoxData["True"], "Output",ExpressionUUID->"86ba8abd-2344-4edd-aecf-e0909d444e93"]
}, Open  ]],

Cell["Verify that each tone matches exactly two four-qubit flips.", "Text",
 CellID->1135219512,ExpressionUUID->"c014b7b1-1dfc-4712-af60-f6427fa0f2fb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"KeySort", "[", 
   RowBox[{"Counts", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "4"}], "]"}], 
      " ", ".", " ", 
      RowBox[{"params", "[", "\"\<wq\>\"", "]"}]}], "]"}], "]"}], "]"}], " ", 
  "===", " ", 
  RowBox[{"AssociationThread", "[", 
   RowBox[{
    RowBox[{"params", "[", "\"\<tones\>\"", "]"}], " ", "->", " ", "2"}], 
   "]"}]}]], "Input",
 CellID->793234618,ExpressionUUID->"a208eb2e-97e9-4f21-8ef5-d209680a4cce"],

Cell[BoxData["True"], "Output",ExpressionUUID->"0ae90c54-9543-4af4-b585-285cf4fa871c"]
}, Open  ]],

Cell[TextData[{
 "A tone's phase multiplies the flip it drives by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Phi]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0203cc88-72e4-4bd3-945b-69b60bf28f2f"],
 " and the reverse flip by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "\[Phi]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66ce6f1d-4335-440a-b3b4-c21a9b486971"],
 ". By convention, the amplitudes are positive and the qubit axes fixed; with \
that convention, setting every phase to ",
 Cell[BoxData["\[Pi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92875cd6-50e0-4a15-bf8b-43c690e946cc"],
 " gives the requested ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["c", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["X", "TI"], "^"], 
    RowBox[{"\[CircleTimes]", "4"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9107b029-bea6-45bf-9f42-600095d4ddab"],
 "."
}], "Text",
 CellID->1675874795,ExpressionUUID->"85e29a2c-ad72-4e38-8de4-bde953003ebc"],

Cell["\<\
Define the operator the resonant tone components produce, for given phases, \
and its Pauli decomposition.\
\>", "Text",
 CellID->1149032613,ExpressionUUID->"51c1cc3c-16d2-4dd4-af73-6ebca389ef43"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"raise", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], ";", " ", 
  RowBox[{"lower", " ", "=", " ", 
   RowBox[{"Transpose", "[", "raise", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stationary", "[", "ph_", "]"}], " ", ":=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", 
           RowBox[{"Sign", "[", 
            RowBox[{"#", " ", ".", " ", 
             RowBox[{"params", "[", "\"\<wq\>\"", "]"}]}], "]"}], " ", 
           RowBox[{"ph", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"#", " ", ".", " ", 
              RowBox[{"params", "[", "\"\<wq\>\"", "]"}]}], "]"}], "]"}]}], 
          "]"}], "/", "2"}], ")"}], " ", 
       RowBox[{"KroneckerProduct", " ", "@@", " ", 
        RowBox[{"Replace", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", " ", "->", " ", "raise"}], ",", " ", 
            RowBox[{
             RowBox[{"-", "1"}], " ", "->", " ", "lower"}]}], "}"}], ",", " ", 
          RowBox[{"{", "1", "}"}]}], "]"}]}]}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "4"}], "]"}]}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pauliParts", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{"ExpToTrig", "[", 
       RowBox[{
        RowBox[{"QuantumOperator", "[", "m", "]"}], 
        "[", "\"\<PauliDecompose\>\"", "]"}], "]"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"#", " ", "=!=", " ", "0"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tonePhases", " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{"th", ",", " ", "8"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"toneParts", " ", "=", " ", 
   RowBox[{"pauliParts", "[", 
    RowBox[{"stationary", "[", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"params", "[", "\"\<tones\>\"", "]"}], ",", " ", 
       "tonePhases"}], "]"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellID->1932658243,ExpressionUUID->"cb56513d-64cb-4ca0-9c63-2961ab309d27"],

Cell["Decompose it for one common phase.", "Text",
 CellID->1815762940,ExpressionUUID->"16acfe29-9e09-4661-bf8f-db6f25fbc949"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{"pauliParts", "[", 
   RowBox[{"stationary", "[", 
    RowBox[{"th", " ", "&"}], "]"}], "]"}], "]"}]], "Input",
 CellID->1853265838,ExpressionUUID->"68bac1cf-174c-45a0-95a3-d50c6501c51c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"XXXX\"\>", "\[Rule]", 
    FractionBox[
     RowBox[{"Cos", "[", "th", "]"}], "2"]}], ",", 
   RowBox[{"\<\"XXXY\"\>", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"Sin", "[", "th", "]"}], "8"]}]}], ",", 
   RowBox[{"\<\"XXYX\"\>", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"Sin", "[", "th", "]"}], "8"]}]}], ",", 
   RowBox[{"\<\"XYXX\"\>", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"Sin", "[", "th", "]"}], "8"]}]}], ",", 
   RowBox[{"\<\"XYYY\"\>", "\[Rule]", 
    FractionBox[
     RowBox[{"Sin", "[", "th", "]"}], "8"]}], ",", 
   RowBox[{"\<\"YXXX\"\>", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"3", " ", 
       RowBox[{"Sin", "[", "th", "]"}]}], "8"]}]}], ",", 
   RowBox[{"\<\"YXYY\"\>", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"Sin", "[", "th", "]"}], "8"]}]}], ",", 
   RowBox[{"\<\"YYXY\"\>", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"Sin", "[", "th", "]"}], "8"]}]}], ",", 
   RowBox[{"\<\"YYYX\"\>", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"Sin", "[", "th", "]"}], "8"]}]}]}], "}"}]], "Output",Expression\
UUID->"5987c8cf-49b6-4832-b061-bb2622ff7b86"]
}, Open  ]],

Cell["\<\
Solve for the eight phases that give exactly the requested four-qubit term.\
\>", "Text",
 CellID->1426099606,ExpressionUUID->"d5145187-5073-4482-ad41-e0a9cc63343e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"toneParts", "[", "\"\<XXXX\>\"", "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]}], " ", "&&", " ", 
    RowBox[{"And", " ", "@@", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"Values", "[", 
        RowBox[{"KeyDrop", "[", 
         RowBox[{"toneParts", ",", " ", "\"\<XXXX\>\""}], "]"}], "]"}], " ", "==",
        " ", "0"}], "]"}]}], " ", "&&", "\n", "  ", 
    RowBox[{"And", " ", "@@", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{"0", " ", "<=", " ", "tonePhases", " ", "<", " ", 
       RowBox[{"2", " ", "Pi"}]}], "]"}]}]}], ",", " ", "tonePhases"}], 
  "]"}]], "Input",
 CellID->1584299858,ExpressionUUID->"f040d75b-fb7a-4589-945b-3e95bb5408ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"th", "[", "1", "]"}], "\[Equal]", "\[Pi]"}], "&&", 
  RowBox[{
   RowBox[{"th", "[", "2", "]"}], "\[Equal]", "\[Pi]"}], "&&", 
  RowBox[{
   RowBox[{"th", "[", "3", "]"}], "\[Equal]", "\[Pi]"}], "&&", 
  RowBox[{
   RowBox[{"th", "[", "4", "]"}], "\[Equal]", "\[Pi]"}], "&&", 
  RowBox[{
   RowBox[{"th", "[", "5", "]"}], "\[Equal]", "\[Pi]"}], "&&", 
  RowBox[{
   RowBox[{"th", "[", "6", "]"}], "\[Equal]", "\[Pi]"}], "&&", 
  RowBox[{
   RowBox[{"th", "[", "7", "]"}], "\[Equal]", "\[Pi]"}], "&&", 
  RowBox[{
   RowBox[{"th", "[", "8", "]"}], "\[Equal]", "\[Pi]"}]}]], "Output",Expressio\
nUUID->"2ca352da-e91f-4cdb-b78f-c33032da58da"]
}, Open  ]],

Cell[TextData[{
 "A generic common phase adds products with an odd number of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Y", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3e5f7fa-6f4e-44b7-ac79-01442ee28b7d"],
 "; phase zero gives ",
 Cell[BoxData[
  RowBox[{"+", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["X", "TI"], "^"], 
    RowBox[{"\[CircleTimes]", "4"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39bd4554-1a3a-4508-9538-c43a94f28f93"],
 ", and phase ",
 Cell[BoxData["\[Pi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f55be4a5-7992-4089-960b-b15cee456ab8"],
 " on every tone is the only solution giving the requested negative sign."
}], "Text",
 CellID->710769346,ExpressionUUID->"05b27630-d258-4bba-b52a-f9b46f196b6d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Energy Shifts Against a Time Evolution", "Subsection",
 CellID->1713310219,ExpressionUUID->"5f5f2a87-3935-4825-8a19-bde4de7b51ff"],

Cell[TextData[{
 "The energy shifts of Question 3 add up hundreds of second-order terms, each \
computed as if its transition were alone. A time evolution tests that sum \
without perturbation theory. Every tone is a multiple of 0.2 GHz and every \
frequency a multiple of 0.05 GHz, so in the frame of the bare energies the \
drive is periodic. Start in one qubit configuration with the coupler empty, \
couple it to every final state of the transitions summed in Question 3, with \
each tone's time dependence, and integrate the Schr\[ODoubleDot]dinger \
equation over one period with ",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "280775f3-99bc-4c0b-96e7-c8d4d630e4a8"],
 ". The phase the starting amplitude gains, divided by the period, is the \
energy shift."
}], "Text",
 CellID->1497493817,ExpressionUUID->"d7d87ddb-fc53-4fc4-86c3-7cb0eda186b7"],

Cell["\<\
Give that period, in ns, as the inverse of the greatest common divisor of the \
tones and the mode frequencies.\
\>", "Text",
 CellID->656454033,ExpressionUUID->"1d57e350-aa58-409c-b553-5015dc3aadf0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"floquetPeriod", " ", "=", " ", 
  RowBox[{"1", "/", 
   RowBox[{"(", 
    RowBox[{"GCD", " ", "@@", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"params", "[", "\"\<tones\>\"", "]"}], ",", " ", "modes"}], 
      "]"}]}], ")"}]}]}]], "Input",
 CellID->979567533,ExpressionUUID->"7cbfe069-91a5-405d-b456-d6fedf7d81bd"],

Cell[BoxData["20"], "Output",ExpressionUUID->"049c18dc-8301-480e-a416-dbe18725b687"]
}, Open  ]],

Cell["\<\
Define the evolution over one period for a qubit configuration. It returns \
the shift in kHz and the change in total probability, which tests the \
integrator.\
\>", "Text",
 CellID->1355946928,ExpressionUUID->"35efd8c9-e11d-4fe3-954b-6c1437337763"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"floquetShift", "[", "z_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"terms", " ", "=", " ", 
       RowBox[{"offResonant", "[", 
        RowBox[{"z", ",", " ", "mMax", ",", " ", "drive0"}], "]"}]}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"finals", " ", "=", " ", 
       RowBox[{"Union", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#Word", ",", " ", "#Fock"}], "}"}], " ", "&"}], " ", "/@",
          " ", "terms"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"idx", " ", "=", " ", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{"finals", ",", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "finals", "]"}], "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"nf", " ", "=", " ", 
        RowBox[{"Length", "[", "finals", "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"inc", " ", "=", " ", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"MapIndexed", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"idx", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"#1", "[", "\"\<Word\>\"", "]"}], ",", " ", 
                   RowBox[{"#1", "[", "\"\<Fock\>\"", "]"}]}], "}"}], "]"}], ",",
                 " ", 
                RowBox[{"First", "[", "#2", "]"}]}], "}"}], " ", "->", " ", 
              "1"}], " ", "&"}], ",", " ", "terms"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"nf", ",", " ", 
            RowBox[{"Length", "[", "terms", "]"}]}], "}"}]}], "]"}]}], ",", 
       "\n", "    ", 
       RowBox[{"gv", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#g", "/", "kHzPerGHz"}], " ", "&"}], " ", "/@", " ", 
          "terms"}], "]"}]}], ",", " ", 
       RowBox[{"dv", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"#Detuning", " ", "&"}], " ", "/@", " ", "terms"}], 
         "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sol", " ", "=", " ", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"ci", "'"}], "[", "t", "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"-", "2"}], " ", "Pi", " ", "I", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"gv", " ", 
                  RowBox[{"Exp", "[", 
                   RowBox[{
                    RowBox[{"-", "2"}], " ", "Pi", " ", "I", " ", "dv", " ", 
                    "t"}], "]"}]}], ")"}], " ", ".", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Transpose", "[", "inc", "]"}], " ", ".", " ", 
                  RowBox[{"cf", "[", "t", "]"}]}], ")"}]}]}]}], ",", "\n", 
             "        ", 
             RowBox[{
              RowBox[{
               RowBox[{"cf", "'"}], "[", "t", "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"-", "2"}], " ", "Pi", " ", "I", " ", 
               RowBox[{"ci", "[", "t", "]"}], " ", 
               RowBox[{"(", 
                RowBox[{"inc", " ", ".", " ", 
                 RowBox[{"(", 
                  RowBox[{"gv", " ", 
                   RowBox[{"Exp", "[", 
                    RowBox[{"2", " ", "Pi", " ", "I", " ", "dv", " ", "t"}], 
                    "]"}]}], ")"}]}], ")"}]}]}], ",", " ", 
             RowBox[{
              RowBox[{"ci", "[", "0", "]"}], " ", "==", " ", "1"}], ",", " ", 
             
             RowBox[{
              RowBox[{"cf", "[", "0", "]"}], " ", "==", " ", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", " ", "nf"}], "]"}]}]}], "}"}], ",", "\n", 
           "       ", 
           RowBox[{"{", 
            RowBox[{"ci", ",", " ", "cf"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"t", ",", " ", "0", ",", " ", "floquetPeriod"}], "}"}], ",",
            " ", 
           RowBox[{"MaxSteps", " ", "->", " ", "Infinity"}], ",", " ", 
           RowBox[{"PrecisionGoal", " ", "->", " ", "12"}], ",", " ", 
           RowBox[{"AccuracyGoal", " ", "->", " ", "14"}]}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "kHzPerGHz"}], " ", 
          RowBox[{
           RowBox[{"Arg", "[", 
            RowBox[{
             RowBox[{"sol", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "[", "floquetPeriod", "]"}], 
            "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "Pi", " ", "floquetPeriod"}], ")"}]}]}], ",", 
         "\n", "     ", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"sol", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "[", "floquetPeriod", "]"}], 
            "]"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"sol", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "[", "floquetPeriod", "]"}], 
            "]"}], "^", "2"}], " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellID->1133256110,ExpressionUUID->"94b618ed-ba3b-4e67-8b75-bf4ca6d74c1e"],

Cell["\<\
Run it for the configuration with every qubit in 0. This evolution takes a \
few minutes.\
\>", "Text",
 CellID->2072491980,ExpressionUUID->"ef31fcc2-e440-4fe2-9183-8e2d9c4c5060"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"zeroShift", " ", "=", " ", 
  RowBox[{"floquetShift", "[", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], 
   "]"}]}]], "Input",
 CellID->1352023997,ExpressionUUID->"f100ca2f-5bd6-4234-a9c8-05d2fcd4aff3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "59.45235705943572`"}], ",", 
   RowBox[{"-", "1.9129142714291447`*^-13"}]}], "}"}]], "Output",ExpressionUUI\
D->"9b97f064-822d-4b4b-863c-bd6ea3e795ea"]
}, Open  ]],

Cell["Compare the shift with the second-order sum as a decimal.", "Text",
 CellID->1391511406,ExpressionUUID->"fca1543c-abaf-4b58-927a-fa0a75b9243f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"zeroShift", "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
   RowBox[{"N", "[", 
    RowBox[{"secondOrder", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
       " ", "mMax", ",", " ", "drive0"}], "]"}], "]"}]}], "}"}]], "Input",
 CellID->758901761,ExpressionUUID->"80ae8b63-ea71-486e-9fb5-6ab5c6d6e4cc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "59.45235705943572`"}], ",", 
   RowBox[{"-", "59.46355185302005`"}]}], "}"}]], "Output",ExpressionUUID->\
"3041ede1-d8a6-44fe-aaab-7aa2455b3193"]
}, Open  ]],

Cell[TextData[{
 "The two differ because the evolution starts in the bare configuration, not \
in the dressed state the drive produces from it. The weight of the admixed \
states, the sum of ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["g", "TI"], "/", "\[CapitalDelta]"}], 
    StyleBox[")",
     SpanMaxSize->1]}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7befb204-41f2-4053-aacb-d65af187540c"],
 " over the transitions, sets the expected size of that difference. Verify \
that the relative difference is within three times that weight."
}], "Text",
 CellID->982000964,ExpressionUUID->"a73ba644-bee6-4b45-b940-a749375253a0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"second", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"secondOrder", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
         " ", "mMax", ",", " ", "drive0"}], "]"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"zeroShift", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "second"}], "]"}], "/", 
     RowBox[{"Abs", "[", "second", "]"}]}], " ", "<", " ", 
    RowBox[{"3", " ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#g", "/", 
           RowBox[{"(", 
            RowBox[{"kHzPerGHz", " ", "#Detuning"}], ")"}]}], ")"}], "^", 
         "2"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"offResonant", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
          " ", "mMax", ",", " ", "drive0"}], "]"}]}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellID->1813696053,ExpressionUUID->"fca08460-5fc5-465d-912f-3dc0501b3f11"],

Cell[BoxData["True"], "Output",ExpressionUUID->"f98c0e27-232e-428c-b2a5-fc44e6e0ae22"]
}, Open  ]],

Cell[TextData[{
 "So within the circuit model the second-order sum is accurate to the \
expected order, and total probability is conserved. The test covers the shift \
of one configuration; the ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Z", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93d9e8f3-3d88-47fe-a489-4788e78d6a1d"],
 "-product coefficients are differences of such shifts, so they inherit the \
difference as an uncertainty. The smallest of them, including the logical one \
of Question 4, are of the same order as that difference and are not resolved \
by this test. It does not test the circuit model itself, which only the \
preprint's full simulation can."
}], "Text",
 CellID->1210498725,ExpressionUUID->"286e3fe4-cecb-44c4-8427-b044c41eb761"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Coupler Cutoff", "Subsection",
 CellID->979673517,ExpressionUUID->"455e4fab-5be0-42ba-9574-53cbf3301e95"],

Cell["\<\
The energy shifts of Question 3 used a finite number of coupler levels. \
Verify that lowering the cutoff to 8, or raising it to 20, changes every \
coefficient by less than a hundredth of the largest one.\
\>", "Text",
 CellID->1640286876,ExpressionUUID->"e10f27a6-121e-4a89-81ea-5b1a100f9bb9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ref", " ", "=", " ", 
     RowBox[{"zCouplings", "[", 
      RowBox[{"mMax", ",", " ", "drive0"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"Values", "[", 
         RowBox[{
          RowBox[{"zCouplings", "[", 
           RowBox[{"#", ",", " ", "drive0"}], "]"}], " ", "-", " ", "ref"}], 
         "]"}], "]"}], "]"}], " ", "<", " ", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"Values", "[", "ref", "]"}], "]"}], "]"}], "/", "100"}]}], 
     " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"8", ",", " ", "20"}], "}"}]}]}], "]"}]], "Input",
 CellID->1628779081,ExpressionUUID->"b97dce7f-7ece-4b42-b6fd-bfe7111c7b4b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",ExpressionUUID->"fd7f765a-a46b-4e10-a230-8bb2ee3557d8"]
}, Open  ]],

Cell["\<\
So the cutoff used above has converged at the scale of the largest \
coefficients, on which the conclusions of Question 3 rest.\
\>", "Text",
 CellID->869026095,ExpressionUUID->"6a6fa8c4-3241-4744-8c7c-b020ec7b33ed"]
}, Open  ]],

Cell[CellGroupData[{

Cell["What Was Verified, and How", "Subsection",
 CellID->1403548103,ExpressionUUID->"bf8e2875-f1be-4054-8fb4-c302361bb66b"],

Cell["\<\
The general results are proved symbolically: the Pauli sum for the Josephson \
cosine, the coupler factors through their generating functions, the circuit \
relations of Question 1, the absence of the four-qubit term from the \
supplement's form at every order, and the rank argument for the toric code at \
every size. Where the system can be solved exactly, it is: the eight-qubit \
spectrum, the protected space and the algebra of the restricted logical \
products, the two-level splitting produced by two detectable errors, and the \
charge qubit through its Mathieu characteristic values. The formulas reduce \
correctly for small participation phases, a weak drive, small coupler \
fluctuations and many coupler excitations. Numerical tests, each named as \
such, test what has no closed form: truncated matrix exponentials for the \
coupler factors, diagonalizations of the qubit in the charge basis and in the \
oscillator basis, the convergence in the coupler cutoff, and a time evolution \
over one drive period for the second-order energy shifts. Several tests probe \
where the circuit model stops holding: the cancellation of the static term at \
the operating bias, the dependence on offset charge without inductive energy, \
the rule linking flipped qubits and coupler excitations, the sensitivity of \
resonances to rounding, and the sign reversal of the four-qubit term with an \
excited coupler. Decimals appear only in these numerical tests and in \
comparisons with the preprint's numbers; every other result is exact.\
\>", "Text",
 CellID->1815183444,ExpressionUUID->"35e1780a-d80e-41bf-8e0b-5a9117c4fb53"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["References", "Section",
 CellID->2036858554,ExpressionUUID->"4c7c275d-0c9d-482a-95ca-278564cc54d6"],

Cell[TextData[{
 "Arora, Holmes, Svore and Patti, ",
 StyleBox[ButtonBox["Agentic Pipelines for Mapping Topological Codes to \
Quantum Hardware",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2611.03329"], None}], "TI"],
 ". Parts used: in the main text, the section \"Agentic Derivation and \
Verification Workflow\", Theorem 1, the section \"Single cell demonstration\" \
(the coupler Hamiltonian and Table I) and the Conclusion; in the \
supplementary material, Sec. S1 and Table S1 (code and check supports), Sec. \
S4 (the schematic driven-circuit model), Sec. S5 (the single-coupler search \
and its sources of unwanted terms), Sec. S6 with Tables S3, S4 and S5 (the \
coupler-pair audit, the array search domain and the array testing \
conditions), Sec. S7 (the largest unwanted terms) and Sec. S9 (the spread of \
the four lowest eigenstates)."
}], "ItemNumbered",
 CellID->1010997909,ExpressionUUID->"1b96036e-9182-4dc2-bc8e-0226559ae6b3"],

Cell[TextData[{
 "Sameti, Poto\[CHacek]nik, Browne, Wallraff and Hartmann, ",
 StyleBox[ButtonBox["Superconducting quantum simulator for topological order \
and the toric code",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://doi.org/10.1103/PhysRevA.95.042330"], None}], "TI"],
 ", Phys. Rev. A ",
 StyleBox["95",
  FontWeight->"Bold"],
 ", 042330 (2017), ",
 ButtonBox["arXiv:1608.04565",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/1608.04565"], None}],
 ". Appendix B, Eqs. (B9), (B11)-(B15), supplies the participation phase, the \
harmonic frequency, the Josephson nonlinearity and the coupler relations used \
in Question 1."
}], "ItemNumbered",
 CellID->596806402,ExpressionUUID->"250d8f53-2ddd-401c-b3b9-4b5384107973"],

Cell[TextData[{
 "Koch, Yu, Gambetta, Houck, Schuster, Majer, Blais, Devoret, Girvin and \
Schoelkopf, ",
 StyleBox[ButtonBox["Charge-insensitive qubit design derived from the Cooper \
pair box",
  BaseStyle->"Hyperlink",
