Cell["\<\
The restrictions of the eight logical products to the protected space should \
behave like two-qubit Pauli operators.\
\>", "Text",
 CellID->460863017,ExpressionUUID->"20c0684a-c9c8-43e5-bb75-95de0b656ad3"],

Cell["\<\
Define their restrictions, their pairwise symplectic products, and their \
pairwise matrix products.\
\>", "Text",
 CellID->1687507410,ExpressionUUID->"1ccf3836-1143-4d84-b8ca-c42c12c20119"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"logicalBlocks", " ", "=", " ", 
   RowBox[{"Simplify", " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{"compress", " ", "/@", " ", "logicals2"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gram", " ", "=", " ", 
   RowBox[{"sympTable", "[", 
    RowBox[{"logicals2", ",", " ", "logicals2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"products", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{
    "Dot", ",", " ", "logicalBlocks", ",", " ", "logicalBlocks", ",", " ", 
     "1"}], "]"}]}], ";"}]}], "Input",
 CellID->1832340146,ExpressionUUID->"967a0a53-7a78-4d60-b84a-2a60b1cba8db"],

Cell["\<\
Fix the qubit ordering of the matrices against a Kronecker product.\
\>", "Text",
 CellID->729105885,ExpressionUUID->"8b1b2806-b925-4e92-ba0f-ac0569d1a5ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"VerificationTest", "[", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"pauliMatrix", "[", 
      RowBox[{"First", "[", "checks2", "]"}], "]"}], "]"}], ",", " ", 
    RowBox[{"KroneckerProduct", " ", "@@", " ", 
     RowBox[{"(", 
      RowBox[{"PauliMatrix", " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", " ", "1", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",", 
         " ", "0", ",", " ", "1", ",", " ", "0"}], "}"}]}], ")"}]}]}], "]"}], 
  "[", "\"\<Outcome\>\"", "]"}]], "Input",
 CellID->1322272499,ExpressionUUID->"456459a6-6061-4d5b-b484-565dc51832b4"],

Cell[BoxData["\<\"Success\"\>"], "Output",ExpressionUUID->"3fae4649-7914-41c8-9f9e-089800dbb29a"]
}, Open  ]],

Cell["\<\
Verify that every restriction is Hermitian and squares to the identity.\
\>", "Text",
 CellID->245486753,ExpressionUUID->"cb995ffa-8eab-4e10-a48b-7011050324dc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{"logicalBlocks", ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"zeroQ", "[", 
      RowBox[{"#", " ", "-", " ", 
       RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], "]"}], " ", "&&", " ", 
     RowBox[{"zeroQ", "[", 
      RowBox[{
       RowBox[{"#", " ", ".", " ", "#"}], " ", "-", " ", 
       RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], " ", "&"}]}], 
  "]"}]], "Input",
 CellID->1002263134,ExpressionUUID->"ff2c796b-c0c1-4f5d-80f9-c911c7d4a9a3"],

Cell[BoxData["True"], "Output",ExpressionUUID->"e408e406-5af0-4bbe-b681-c4f447fc266c"]
}, Open  ]],

Cell["\<\
Verify that they commute or anticommute exactly as their symplectic products \
say.\
\>", "Text",
 CellID->1973252530,ExpressionUUID->"37640c3e-0791-4f88-8c0f-255685de0cb7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"And", " ", "@@", " ", 
  RowBox[{"Flatten", "[", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"zeroQ", "[", 
       RowBox[{"#1", " ", "-", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "^", "#3"}], " ", "#2"}]}], "]"}], " ", 
      "&"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"products", ",", " ", 
       RowBox[{"Transpose", "[", "products", "]"}], ",", " ", "gram"}], "}"}],
      ",", " ", "2"}], "]"}], "]"}]}]], "Input",
 CellID->1223883181,ExpressionUUID->"2df7d775-29aa-42db-991f-851aadab86b4"],

Cell[BoxData["True"], "Output",ExpressionUUID->"7fe55318-e42b-41b0-a879-902f983808aa"]
}, Open  ]],

Cell["Count the independent operators their products span.", "Text",
 CellID->1703077277,ExpressionUUID->"95b19fb6-c5c8-47db-9781-f66872908164"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixRank", "[", 
  RowBox[{"Flatten", " ", "/@", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"Dot", " ", "@@", " ", 
        RowBox[{"Prepend", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], "]"}], " ", 
      "&"}], " ", "/@", " ", 
     RowBox[{"Subsets", "[", 
      RowBox[{"logicalBlocks", ",", " ", "4"}], "]"}]}], ")"}]}], 
  "]"}]], "Input",
 CellID->1990308697,ExpressionUUID->"270d926b-1391-4556-b00b-047d1b401e2d"],

Cell[BoxData["16"], "Output",ExpressionUUID->"e2760c3d-c8bc-4e5a-aa1b-fcd83c8430f3"]
}, Open  ]],

Cell["They span all 16 operators on two qubits.", "Text",
 CellID->1111238958,ExpressionUUID->"db8b9382-ca3c-474a-b467-93984a46ae8b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Finite Pauli Sum", "Subsection",
 CellID->1233443122,ExpressionUUID->"25f08672-bb6a-42b8-8b30-729c398e8b5e"],

Cell[TextData[{
 "Verify the full ",
 Cell[BoxData[
  RowBox[{"16", "\[Times]", "16"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "407b1044-7b62-4326-9d5b-ad765ad26ccc"],
 " matrix cosine against its Pauli sum, for symbolic angles."
}], "Text",
 CellID->1202661899,ExpressionUUID->"f06a1d14-1cab-4bf1-b485-35fa56cf29ba"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"xk", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", " ", "@@", " ", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "4"}], "]"}], ",",
       " ", 
      RowBox[{"k", " ", "->", " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xw", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{"Dot", " ", "@@", " ", 
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"xk", " ", "/@", " ", "s"}], ",", " ", 
      RowBox[{"IdentityMatrix", "[", "16", "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"zeroQ", "[", 
  RowBox[{"TrigExpand", "[", 
   RowBox[{
    RowBox[{"MatrixFunction", "[", 
     RowBox[{"Cos", ",", " ", 
      RowBox[{
       RowBox[{"a", " ", 
        RowBox[{"IdentityMatrix", "[", "16", "]"}]}], " ", "+", " ", 
       RowBox[{"angles", " ", ".", " ", 
        RowBox[{"(", 
         RowBox[{"xk", " ", "/@", " ", 
          RowBox[{"Range", "[", "4", "]"}]}], ")"}]}]}]}], "]"}], " ", "-", 
    "\n", "    ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"coef", "[", 
          RowBox[{"Cos", ",", " ", "#"}], "]"}], " ", 
         RowBox[{"xw", "[", "#", "]"}]}], ")"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"Subsets", "[", 
       RowBox[{"Range", "[", "4", "]"}], "]"}]}], "]"}]}], "]"}], 
  "]"}]}], "Input",
 CellID->1496683409,ExpressionUUID->"99d52fd3-9f16-4e46-b686-c8ebaee82870"],

Cell[BoxData["True"], "Output",ExpressionUUID->"4ecbbdb9-3867-4776-b553-ba7488ed4711"]
}, Open  ]],

Cell[TextData[{
 "Recover each coefficient a second way: average the scalar cosine over the \
16 patterns of the qubits' ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["X", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ec217cb-4b87-429a-81ad-b92b0180ddb8"],
 " eigenvalues ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cbf47ab-8685-424b-9599-18637557979c"],
 ", weighted by the product's sign on each pattern."
}], "Text",
 CellID->1548204329,ExpressionUUID->"e7b1c10a-07ba-4efd-b4b7-a44b05b60393"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"coefAverage", "[", 
    RowBox[{"f_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"2", "^", 
     RowBox[{"-", "4"}]}], " ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"a", " ", "+", " ", 
           RowBox[{"angles", " ", ".", " ", "#"}]}], "]"}], " ", 
         RowBox[{"Times", " ", "@@", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "s", "]"}], "]"}]}]}], ")"}], " ", "&"}], " ", "/@", 
      " ", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "4"}], 
       "]"}]}], "]"}]}]}], ";"}]], "Input",
 CellID->626084867,ExpressionUUID->"30f43a1a-a3da-4f84-b1ae-9d2b0712df9c"],

Cell["Compare the cosine coefficients.", "Text",
 CellID->214682545,ExpressionUUID->"28b5c2c3-c466-4ef8-9047-549f553eb931"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Subsets", "[", 
    RowBox[{"Range", "[", "4", "]"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{"TrigReduce", "[", 
       RowBox[{
        RowBox[{"coefAverage", "[", 
         RowBox[{"Cos", ",", " ", "#"}], "]"}], " ", "-", " ", 
        RowBox[{"coef", "[", 
         RowBox[{"Cos", ",", " ", "#"}], "]"}]}], "]"}], "]"}], " ", "===", 
     " ", "0"}], " ", "&"}]}], "]"}]], "Input",
 CellID->725969933,ExpressionUUID->"25af9128-6c70-4444-aca7-98073ec4fe73"],

Cell[BoxData["True"], "Output",ExpressionUUID->"ceb176ba-9189-4ea6-a828-0bbb4a56d6fa"]
}, Open  ]],

