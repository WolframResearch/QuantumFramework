Cell["\<\
The preprint measures leakage by an escape probability: the largest \
probability of ending outside the sixteen qubit configurations after one \
drive period, over every normalized superposition of them. It reports 0.974% \
([1], \"Single cell demonstration\", and supplementary Sec. S4). Starting \
from single configurations alone can underestimate it. The two-level \
fractions above are a cruder quantity, but they are of the same order, so \
these transitions would matter if they were resonant.\
\>", "Text",
 CellID->1228994069,ExpressionUUID->"b26272c3-ca0b-4a46-b412-70f4f09f726b"],

Cell["\<\
Whether they are resonant depends on what the listed frequencies mean. If \
they are the simulation's exact inputs, the resonances are exact. If they are \
rounded, the rounding can exceed the couplings. The tones are sums and \
differences of the qubit frequencies, so their rounding errors are tied to \
the qubits' and must be carried through together.\
\>", "Text",
 CellID->441742289,ExpressionUUID->"8dbb607f-6d15-4fac-8376-15f7b9f1d082"],

Cell["\<\
Bound the detuning of each transition, in MHz, when every listed frequency \
may be off by half its last digit, and when only the coupler frequency may \
be. Each row gives the flipped qubits, the coupler excitations, the coupling \
in MHz, and the two bounds.\
\>", "Text",
 CellID->372137377,ExpressionUUID->"8edd8516-c350-4ae3-9a94-d9528c56bab5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"toneQuanta", "[", "w_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sign", "[", "w", "]"}], " ", 
    RowBox[{"Append", "[", 
     RowBox[{
      RowBox[{"SelectFirst", "[", 
       RowBox[{
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "4"}], 
         "]"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"#", " ", ".", " ", 
           RowBox[{"params", "[", "\"\<wq\>\"", "]"}]}], " ", "==", " ", 
          RowBox[{"Abs", "[", "w", "]"}]}], " ", "&"}]}], "]"}], ",", " ", 
      "0"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mismatch", "[", "p_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"quanta", "[", 
     RowBox[{
      RowBox[{"p", "[", "\"\<State\>\"", "]"}], ",", " ", 
      RowBox[{"p", "[", "\"\<Word\>\"", "]"}], ",", " ", 
      RowBox[{"p", "[", "\"\<Fock\>\"", "]"}]}], "]"}], " ", "-", " ", 
    RowBox[{"toneQuanta", "[", 
     RowBox[{"p", "[", "\"\<Tone\>\"", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"roundingErrors", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "/", "20"}], ",", " ", 
     RowBox[{"1", "/", "20"}], ",", " ", 
     RowBox[{"1", "/", "20"}], ",", " ", 
     RowBox[{"1", "/", "20"}], ",", " ", 
     RowBox[{"1", "/", "200"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"couplerRounding", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0", ",", " ", 
     RowBox[{"1", "/", "200"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"worstCaseMHz", "[", 
    RowBox[{"p_", ",", " ", "errs_"}], "]"}], " ", ":=", " ", 
   RowBox[{"mhzPerGHz", " ", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"mismatch", "[", "p", "]"}], "]"}], " ", ".", " ", "errs"}]}]}],
   ";"}], "\n", 
 RowBox[{"Union", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"#Word", ",", " ", "#Fock", ",", " ", 
      RowBox[{"#g", " ", 
       RowBox[{"mhzPerGHz", "/", "kHzPerGHz"}]}], ",", " ", 
      RowBox[{"worstCaseMHz", "[", 
       RowBox[{"#", ",", " ", "roundingErrors"}], "]"}], ",", " ", 
      RowBox[{"worstCaseMHz", "[", 
       RowBox[{"#", ",", " ", "couplerRounding"}], "]"}]}], "}"}], " ", "&"}],
    " ", "/@", " ", "inTune"}], "]"}]}], "Input",
 CellID->1139778579,ExpressionUUID->"ef74d877-d3a5-4bb5-ab8b-633ee2f2facd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", "2", ",", 
     FractionBox[
      RowBox[{"51183", " ", 
       SuperscriptBox[
        RowBox[{"Sin", "[", 
         FractionBox["7", "10"], "]"}], "2"]}], 
      RowBox[{"3200", " ", 
       SqrtBox["2"], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"1089", "/", "800"}]]}]], ",", "310", ",", "10"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}], ",", "4", ",", 
     FractionBox[
      RowBox[{"18579429", " ", 
       SqrtBox[
        FractionBox["3", "2"]], " ", 
       SuperscriptBox[
        RowBox[{"Sin", "[", 
         FractionBox["7", "10"], "]"}], "2"]}], 
      RowBox[{"2560000", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"1089", "/", "800"}]]}]], ",", "220", ",", "20"}], "}"}]}], 
  "}"}]], "Output",ExpressionUUID->"3dfa9069-bcd9-4e55-a2cc-ad6ee41c32e3"]
}, Open  ]],

