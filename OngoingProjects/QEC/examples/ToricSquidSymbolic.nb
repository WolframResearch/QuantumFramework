Cell["\<\
List those that start with all qubits in 0 and leave at most two excitations \
in the coupler.\
\>", "Text",
 CellID->1923688675,ExpressionUUID->"3537ebf1-1576-478a-b29b-d1a0b379c218"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Cases", "[", 
  RowBox[{"twoToneCandidates", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", 
     " ", "_", ",", " ", 
     RowBox[{"m_", " ", "/;", " ", 
      RowBox[{"m", " ", "<=", " ", "2"}]}]}], "}"}]}], "]"}]], "Input",
 CellID->803646002,ExpressionUUID->"747b4042-3d82-4420-bfab-9513b810d3d6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}], ",", "2"}], "}"}], "}"}]], "Output",Expre\
ssionUUID->"68025a21-38c3-450c-b6bb-7ee88a338701"]
}, Open  ]],

Cell["\<\
The rule leaves a few dozen candidates. One of them starts with all qubits in \
0 and the coupler empty, and ends with qubits 1 and 3 flipped and two \
excitations in the coupler. By contrast, a transition that flips three qubits \
and leaves no coupler excitations breaks the rule, so this cosine cannot \
produce it at any order, whatever its energy.\
\>", "Text",
 CellID->851713092,ExpressionUUID->"624f4f62-0519-4992-9b90-92cb3b56725c"],

Cell[TextData[{
 "Within the circuit model, the list of resonant transitions, their \
couplings, the rounding bounds and the parity rule are exact. Two things are \
approximate: the population fractions, which treat each transition as an \
isolated two-level system, and the energy shifts, which stop at second order. \
The small ratios ",
 Cell[BoxData[GridBox[{
    {
     RowBox[{
      StyleBox["g", "TI"], "/", "\[CapitalDelta]"}]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ee2d064-684b-44b0-bbf8-85ef9e7ca947"],
 " support that order, and the appendix tests it for one configuration \
against a time evolution over one period, at the scale of the largest \
coefficients. Three things stay open: whether the resonances survive at the \
unrounded frequencies and shifted levels, the strengths of the allowed \
two-tone transitions, which depend on interference between paths, and a \
comparison with the preprint's 9.22 kHz term under the same conventions."
}], "Text",
 CellID->1123629898,ExpressionUUID->"aa1053f5-1a8e-4a95-bb81-a1223b404dc7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Question 4: What Does an Unwanted Term Do to the Stored Qubits?\
\>", "Section",
 CellID->1292170366,ExpressionUUID->"0844ce7d-4331-4da7-89bb-228de2c69d12"],

Cell["\<\
The certificate bounds the total size of the unwanted terms, and that \
guarantees four lowest eigenstates, separated by an energy gap and close to \
the protected space ([1], Theorem 1). It does not say what the unwanted terms \
do inside that space, and two terms of the same size can do very different \
things. A Pauli product that commutes with every four-qubit term of the \
target Hamiltonian leaves the protected space in place. Unless it is itself \
made of those terms, it acts on the stored qubits directly; the standard name \
for such a product is logical. A Pauli product that anticommutes with at \
least one of them moves every protected state out of the protected space, \
where the energy cost reveals it: a detectable error. And two detectable \
errors can combine into a logical one. To tell these apart we need the code \
itself.\
\>", "Text",
 CellID->731300649,ExpressionUUID->"7fdb920d-ddbe-4b42-9e41-40778ecaef62"],

Cell[CellGroupData[{

Cell["The Code as Bit Strings", "Subsection",
 CellID->2046071762,ExpressionUUID->"a2239809-1adb-43b9-8151-811187eaa849"],

Cell[TextData[{
 "The target Hamiltonian is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "0"], "=", "-", 
   StyleBox["c", "TI"], 
   UnderscriptBox["\[Sum]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "^"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d21fd3f9-552d-4034-86e6-5d830e0ae34c"],
 ". Each ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["S", "TI"], "^"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f43d992-16e9-4b4f-9551-f49dceb280b6"],
 ", called a check, is a product of four Pauli operators: ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["X", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d811abe5-af78-438f-ac5b-62499cb2acee"],
 " on the four qubits around a vertex of the lattice (a star), or ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Z", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "759224e3-130f-4754-9397-29294e7e7ece"],
 " on the four around a face (a plaquette). A Pauli product on ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0de324a4-9dde-461d-9cf9-0b96dd6eb877"],
 " qubits, such as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["X", "TI"], "^"], "1"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2097ce6-e3ad-4c8d-acc4-21de6c27f546"],
 ", can be stored as two strings of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0edbe0df-b9b2-4449-9884-504e275179e9"],
 " bits: one marking where it has an ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["X", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8acd818d-c06f-4a10-b72a-ed3be301d8d2"],
 ", one marking where it has a ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Z", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e0d79444-f038-4b71-90b1-3f5cf2b0adb4"],
 " (",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Y", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdbbf92f-0cc3-48e5-b8e2-1be50b96ebd3"],
 " has both). Two products commute exactly when the number of places where \
one has ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["X", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab3175d1-5e6c-476b-9d8b-d4bfbcd09eac"],
 " and the other has ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Z", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b47aeb92-06a8-4b61-af20-385dfc75e800"],
 " is even. This count, taken mod 2, is their symplectic product. So \"does \
this term commute with that check?\" becomes linear algebra over 0 and 1."
}], "Text",
 CellID->1072860934,ExpressionUUID->"7acf5e3a-c4c4-438f-8d2c-a187d1d35cd2"],

Cell["\<\
Construct the checks in the qubit order of [1], supplementary Table S1, which \
lists the eight check supports for the eight-qubit array, and verify them \
against that table.\
\>", "Text",
 CellID->534244854,ExpressionUUID->"f2020cb1-9ab6-4fc6-b1aa-ed894b289410"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"toricChecks", "[", "L_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", " ", "=", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "c"}], "}"}], " ", "|->", " ", 
         RowBox[{
          RowBox[{"2", " ", "L", " ", 
           RowBox[{"Mod", "[", 
            RowBox[{"r", ",", " ", "L"}], "]"}]}], " ", "+", " ", 
          RowBox[{"Mod", "[", 
           RowBox[{"c", ",", " ", "L"}], "]"}], " ", "+", " ", "1"}]}]}], ",",
        " ", 
       RowBox[{"v", " ", "=", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "c"}], "}"}], " ", "|->", " ", 
         RowBox[{
          RowBox[{"2", " ", "L", " ", 
           RowBox[{"Mod", "[", 
            RowBox[{"r", ",", " ", "L"}], "]"}]}], " ", "+", " ", "L", " ", "+",
           " ", 
          RowBox[{"Mod", "[", 
           RowBox[{"c", ",", " ", "L"}], "]"}], " ", "+", " ", "1"}]}]}], ",",
        "\n", "    ", 
       RowBox[{"sites", " ", "=", " ", 
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"L", " ", "-", " ", "1"}]}], "]"}], ",", " ", "2"}], 
         "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"h", "[", 
             RowBox[{"#1", ",", " ", "#2"}], "]"}], ",", " ", 
            RowBox[{"h", "[", 
             RowBox[{"#1", ",", " ", 
              RowBox[{"#2", " ", "-", " ", "1"}]}], "]"}], ",", " ", 
            RowBox[{"v", "[", 
             RowBox[{"#1", ",", " ", "#2"}], "]"}], ",", " ", 
            RowBox[{"v", "[", 
             RowBox[{
              RowBox[{"#1", " ", "-", " ", "1"}], ",", " ", "#2"}], "]"}]}], 
           "}"}], " ", "&"}], ",", " ", "sites", ",", " ", 
         RowBox[{"{", "1", "}"}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"Apply", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"h", "[", 
             RowBox[{"#1", ",", " ", "#2"}], "]"}], ",", " ", 
            RowBox[{"h", "[", 
             RowBox[{
              RowBox[{"#1", " ", "+", " ", "1"}], ",", " ", "#2"}], "]"}], ",",
             " ", 
            RowBox[{"v", "[", 
             RowBox[{"#1", ",", " ", "#2"}], "]"}], ",", " ", 
            RowBox[{"v", "[", 
             RowBox[{"#1", ",", " ", 
              RowBox[{"#2", " ", "+", " ", "1"}]}], "]"}]}], "}"}], " ", 
          "&"}], ",", " ", "sites", ",", " ", 
         RowBox[{"{", "1", "}"}]}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xWord", "[", 
    RowBox[{"s_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"s", " ", "->", " ", "1"}], "]"}], ",", " ", 
     RowBox[{"2", " ", "n"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zWord", "[", 
    RowBox[{"s_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"s", " ", "+", " ", "n"}], ")"}], " ", "->", " ", "1"}], 
      "]"}], ",", " ", 
     RowBox[{"2", " ", "n"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"symplecticChecks", "[", "L_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"2", " ", 
         RowBox[{"L", "^", "2"}]}]}], ",", " ", 
       RowBox[{"sp", " ", "=", " ", 
        RowBox[{"toricChecks", "[", "L", "]"}]}]}], "}"}], ",", " ", 
     RowBox[{"SparseArray", "[", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"xWord", "[", 
           RowBox[{"#", ",", " ", "n"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"sp", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"zWord", "[", 
           RowBox[{"#", ",", " ", "n"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"sp", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"symplecticForm", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"ArrayFlatten", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"n", ",", " ", "SparseArray"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"n", ",", " ", "SparseArray"}], "]"}], ",", " ", "0"}], 
       "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"symp", "[", 
    RowBox[{"u_", ",", " ", "v_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{"u", " ", ".", " ", 
      RowBox[{"symplecticForm", "[", 
       RowBox[{
        RowBox[{"Length", "[", "u", "]"}], "/", "2"}], "]"}], " ", ".", " ", 
      "v"}], ",", " ", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sympTable", "[", 
    RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{"Mod", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"SparseArray", "[", "a", "]"}], " ", ".", " ", 
       RowBox[{"symplecticForm", "[", 
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"First", "[", "a", "]"}], "]"}], "/", "2"}], "]"}], " ", ".",
        " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"SparseArray", "[", "b", "]"}], "]"}]}], ",", " ", "2"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"label", "[", "v_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", " ", "=", " ", 
       RowBox[{
        RowBox[{"Length", "[", "v", "]"}], "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"StringJoin", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<I\>\"", ",", " ", "\"\<X\>\"", ",", " ", "\"\<Z\>\"", ",",
          " ", "\"\<Y\>\""}], "}"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"Normal", "[", 
          RowBox[{
           RowBox[{"v", "[", 
            RowBox[{"[", 
             RowBox[{";;", " ", "n"}], "]"}], "]"}], " ", "+", " ", 
           RowBox[{"2", " ", 
            RowBox[{"v", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"n", " ", "+", " ", "1"}], " ", ";;"}], "]"}], 
             "]"}]}]}], "]"}]}], "]"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"checks2", " ", "=", " ", 
   RowBox[{"symplecticChecks", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"VerificationTest", "[", 
   RowBox[{
    RowBox[{"Map", "[", 
     RowBox[{"Sort", ",", " ", 
      RowBox[{"toricChecks", "[", "2", "]"}], ",", " ", 
      RowBox[{"{", "2", "}"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "7"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "4", ",", " ", "8"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "5", ",", " ", "6", ",", " ", "7"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5", ",", " ", "6", ",", " ", "8"}], "}"}]}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "4", ",", " ", "6"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "5", ",", " ", "7", ",", " ", "8"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "6", ",", " ", "7", ",", " ", "8"}], "}"}]}], 
       "}"}]}], "}"}]}], "]"}], "[", "\"\<Outcome\>\"", "]"}]}], "Input",
 CellID->1532461231,ExpressionUUID->"161acf5c-f0ad-4b39-ad04-e2141a3ecdb0"],

Cell[BoxData["\<\"Success\"\>"], "Output",ExpressionUUID->"323ac7fc-571c-42b3-b3d1-2756bcf62e2c"]
}, Open  ]],

Cell["\<\
Verify that the edges at each vertex of the grid drawn at the start are the \
stars above, at sizes 2 to 4:\
\>", "CodeText",
 CellID->1120240858,ExpressionUUID->"6a45a3e8-34fc-484a-974c-661908a2d777"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"VerificationTest", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{"Last", " ", "/@", " ", 
            RowBox[{"IncidenceList", "[", 
             RowBox[{
              RowBox[{"toricGraph", "[", "L", "]"}], ",", " ", "#"}], "]"}]}],
            "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"L", "^", "2"}], "]"}]}], ")"}], " ", "===", " ", 
       RowBox[{"(", 
        RowBox[{"Sort", " ", "/@", " ", 
         RowBox[{
          RowBox[{"toricChecks", "[", "L", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"L", ",", " ", "2", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
    
    RowBox[{"{", 
     RowBox[{"True", ",", " ", "True", ",", " ", "True"}], "}"}]}], "]"}], 
  "[", "\"\<Outcome\>\"", "]"}]], "Input",
 CellID->429364482,ExpressionUUID->"2458a514-84d9-489a-a98a-7c6ef85a6d93"],

Cell[BoxData["\<\"Success\"\>"], "Output",ExpressionUUID->"067a8097-5be1-42cb-91f1-bdf34981e10a"]
}, Open  ]],

Cell["\<\
Neighboring vertices are joined by two edges, because the lattice wraps \
around. So two stars share two qubits, which matters below.\
\>", "Text",
 CellID->1458976185,ExpressionUUID->"d1564917-4094-446d-a887-6b380495054e"],

Cell[TextData[{
 "What a term ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["O", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "613d8495-ac5f-4ac9-a7c3-119d7a0fd68c"],
 " does to the stored qubits directly is its restriction to the protected \
space: the ",
 Cell[BoxData[
  RowBox[{"4", "\[Times]", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad196d7c-17e6-4dcf-a44a-06d395542a37"],
 " matrix ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["P", "TI"], "^"], "0"], 
   OverscriptBox[
    StyleBox["O", "TI"], "^"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["P", "TI"], "^"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14732091-6b9b-48c6-82e8-7624871f9535"],
 ", with ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["P", "TI"], "^"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a12e68fb-cbc3-4b0d-8a92-dabf9b72a71f"],
 " the projector onto that space. That needs an explicit basis of the \
protected space. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11748b71-e3d1-40eb-af66-223105ae741b"],
 " every check is ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c130abfd-d7c1-4d70-a409-ad3de855c677"],
 " on it, so its energy is minus the number of checks."
}], "Text",
 CellID->878774297,ExpressionUUID->"e54a654b-f429-4a14-a7b1-ef722c33a713"],

Cell["\<\
Build the exact basis of the protected space, and define the restriction of a \
Pauli product to it.\
\>", "Text",
 CellID->1418402956,ExpressionUUID->"b4261e85-c1bc-42ad-ad13-391981bb0089"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pauliMatrix", "[", "v_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"QECPauli", "[", 
     RowBox[{"label", "[", "v", "]"}], "]"}], "[", "\"\<Matrix\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"h0", " ", "=", " ", 
   RowBox[{"-", 
    RowBox[{"Total", "[", 
     RowBox[{"pauliMatrix", " ", "/@", " ", "checks2"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ground", " ", "=", " ", 
   RowBox[{"Orthogonalize", "[", 
    RowBox[{"NullSpace", "[", 
     RowBox[{"h0", " ", "+", " ", 
      RowBox[{
       RowBox[{"Length", "[", "checks2", "]"}], " ", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{
         RowBox[{"2", "^", "8"}], ",", " ", "SparseArray"}], "]"}]}]}], "]"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"compress", "[", "v_", "]"}], " ", ":=", " ", 
   RowBox[{"ground", " ", ".", " ", 
    RowBox[{"pauliMatrix", "[", "v", "]"}], " ", ".", " ", 
    RowBox[{"Transpose", "[", "ground", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zeroQ", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{"MatrixQ", "[", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{"Normal", "[", "m", "]"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"#", " ", "===", " ", "0"}], " ", "&"}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"55871675-72ee-4a22-8599-80e3bb436621"],

Cell["\<\
QECPauli and QuantumOperator give the same matrix for every Pauli product on \
the eight qubits used below (all checks, and every product of weight at most \
two):\
\>", "Text",ExpressionUUID->"1ac2707f-f00d-4864-ad90-a037bf8168fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Normal", " ", "/@", " ", "checks2"}], ",", " ", 
     RowBox[{"Normal", " ", "/@", " ", 
      RowBox[{"Take", "[", 
       RowBox[{
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "16"}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "997"}], "}"}]}], "]"}]}]}], "]"}], ",",
    " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{"pauliMatrix", "[", "#", "]"}], "]"}], " ", "==", " ", 
     RowBox[{"Normal", "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"label", "[", "#", "]"}], "]"}], "[", "\"\<Matrix\>\"", "]"}],
       "]"}]}], " ", "&"}]}], "]"}]], "Input",ExpressionUUID->"fe6f1ec5-0496-\
4f6a-b298-8330621eea28"],

Cell[BoxData["True"], "Output",ExpressionUUID->"fb2d556e-77a9-42cb-b583-feb392654296"]
}, Open  ]],

