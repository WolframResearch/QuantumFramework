   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",ExpressionUUID->"6d21b5fd-a98d-4259-a6ac-72e26f059a53"]
}, Open  ]],

Cell[TextData[{
 "The product of all four ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["X", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4278f17f-1a79-408d-8e9b-dc88fc478db1"],
 " carries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f93669d-5139-40b0-b481-b56019b342bf"],
 " times the product of the four sines: this is what becomes the four-qubit \
term. Products of an odd number of qubits carry ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "202cd1f3-a60e-45f0-8173-0dd9d93d98dc"],
 " instead."
}], "Text",
 CellID->440008987,ExpressionUUID->"eed7f264-e2ea-43dc-bd32-ab354323e2fd"],

Cell["\<\
The remaining factor acts on the coupler alone. It shifts the coupler's \
oscillation, and its matrix elements are a standard result for a harmonic \
oscillator:\
\>", "Text",
 CellID->2121350252,ExpressionUUID->"c7ff235d-a769-4774-b990-cc52fb1e09d9"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["m", "TI"]},
      "Bra"], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{
       StyleBox["i", "TI"], "\[CurlyPhi]", 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        OverscriptBox[
         StyleBox["d", "TI"], "^"], "+", 
        SuperscriptBox[
         OverscriptBox[
          StyleBox["d", "TI"], "^"], "\[Dagger]"]}], 
       StyleBox[")",
        SpanMaxSize->1]}]], 
     TemplateBox[{"0"},
      "Ket"]}], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       SuperscriptBox["\[CurlyPhi]", "2"], "/", "2"}]], 
     FractionBox[
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         StyleBox["i", "TI"], "\[CurlyPhi]"}], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       StyleBox["m", "TI"]], 
      SqrtBox[
       RowBox[{
        StyleBox["m", "TI"], "!"}]]]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["m", "TI"]},
      "Bra"], 
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], 
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{"\[CurlyPhi]", 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         OverscriptBox[
          StyleBox["d", "TI"], "^"], "+", 
         SuperscriptBox[
          OverscriptBox[
           StyleBox["d", "TI"], "^"], "\[Dagger]"]}], 
        StyleBox[")",
         SpanMaxSize->1]}]}], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     TemplateBox[{
       StyleBox["m", "TI"]},
      "Ket"]}], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       SuperscriptBox["\[CurlyPhi]", "2"], "/", "2"}]], 
     SubscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["m", "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      SuperscriptBox["\[CurlyPhi]", "2"], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->751547568,ExpressionUUID->"3f5dcefb-48ba-4420-b2d5-b170c628ee3e"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["L", "TI"], 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82cd9556-b22e-45d9-8df6-dc860a2fdd02"],
 " a Laguerre polynomial. The first formula is the amplitude for leaving ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7157e43-cec4-4658-b849-fe2dcf3ecacc"],
 " excitations in a coupler that started empty. The second is what the \
coupler contributes when it starts and ends with ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29bb903b-c19f-46ed-abfa-423b2fea9a54"],
 " excitations. The appendix verifies both independently. So every transition \
the coupler drives is a product of two known factors: this coupler factor, \
and the qubit factor above."
}], "Text",
 CellID->1805299078,ExpressionUUID->"72845f87-8e10-44aa-9651-df60bc60e615"],

Cell["\<\
Define the coupler factor, and list it for zero to three excitations.\
\>", "Text",
 CellID->1307459721,ExpressionUUID->"d0fc2a05-9b37-43c1-b5ca-a2061488c688"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"osc", "[", 
    RowBox[{"m_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"p", "^", "2"}]}], "/", "2"}], "]"}], " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"I", " ", "p"}], ")"}], "^", "m"}], "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"m", "!"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"couplerFactor", "[", 
    RowBox[{"s_", ",", " ", "m_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Re", "[", 
     RowBox[{
      RowBox[{"osc", "[", 
       RowBox[{"m", ",", " ", "p"}], "]"}], " ", 
      RowBox[{"xFactor", "[", "s", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"osc", "[", 
  RowBox[{
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", "3"}], "]"}], ",", " ", "p"}], "]"}]}], "Input",
 CellID->246421316,ExpressionUUID->"e4f55c25-9b0a-4f13-b801-576ec19eef97"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["p", "2"], "2"]}]], ",", 
   RowBox[{"\[ImaginaryI]", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["p", "2"], "2"]}]], " ", "p"}], ",", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox["p", "2"], "2"]}]], " ", 
      SuperscriptBox["p", "2"]}], 
     SqrtBox["2"]]}], ",", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"\[ImaginaryI]", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox["p", "2"], "2"]}]], " ", 
      SuperscriptBox["p", "3"]}], 
     SqrtBox["6"]]}]}], "}"}]], "Output",ExpressionUUID->"424c4335-9794-4bb6-\
be55-6b02ebf5dfe8"]
}, Open  ]],

Cell[TextData[{
 "Each extra excitation adds a factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], 
   SubscriptBox["\[CurlyPhi]", 
    StyleBox["zpf",
     FontSlant->"Plain"]], "/", 
   SqrtBox[
    StyleBox["m", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5687dc00-dd94-4c0e-b30a-f6407c7bb56f"],
 ". Each flipped qubit also carries a factor ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c78cc629-b4d9-4c1f-8ce7-cb8cca6144b7"],
 ", so the cosine produces only transitions in which the flipped qubits plus \
the coupler excitations add up to an even number. Question 3 uses this rule."
}], "Text",
 CellID->1060885634,ExpressionUUID->"ee4c434a-2dc9-4691-a5ab-371ff008ca8a"],

Cell[TextData[{
 "Now the coupling. The preprint works at the operating bias ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CurlyPhi]", 
    StyleBox[
     RowBox[{"d", "c"}], "TI"]], "=", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "438915d9-ffd8-4534-a291-d2b97137be56"],
 ", where the static part of the Josephson term vanishes and the part linear \
in the drive is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["J", "TI"]], 
   SubscriptBox["\[CurlyPhi]", 
    StyleBox["d", "TI"]], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   OverscriptBox["\[CurlyPhi]", "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e21b84c3-8674-4e9b-900a-ee1ae51ca3da"],
 " ([1], same section). Keep the coupler empty, and keep only the tone \
components whose frequency matches flipping all four qubits. The other \
components oscillate and average to zero. The four-qubit coupling is then"
}], "Text",
 CellID->1894213956,ExpressionUUID->"24d0a1bb-e9fc-4273-9064-2baf593387ab"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], "0"], "=", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["J", "TI"]], 
      StyleBox["A", "TI"]}], "2"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SubsuperscriptBox["\[CurlyPhi]", 
       StyleBox["zpf",
        FontSlant->"Plain"], "2"], "/", "2"}]], 
    UnderscriptBox["\[Product]", 
     StyleBox["i", "TI"],
     LimitsPositioning->False], 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["i", "TI"]], 
     SubscriptBox["\[CurlyPhi]", 
      StyleBox["i", "TI"]], "/", "2"}], 
    StyleBox[")",
     SpanMaxSize->1]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1517395904,ExpressionUUID->"c4f4c8fb-fa44-4bb3-b278-9aec3132c43d"],

Cell["\<\
The tone phases set its sign, and the appendix shows that the preprint's \
phases give the requested negative sign.\
\>", "Text",
 CellID->1223813556,ExpressionUUID->"9e43fc3d-a37c-4155-9113-fb51398cda21"],

Cell["Encode the formula.", "Text",
 CellID->1577573989,ExpressionUUID->"8ff54243-63db-4678-bf33-d17d13bc38f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cFormula", "[", 
    RowBox[{
    "ej_", ",", " ", "amp_", ",", " ", "phizpf_", ",", " ", "phis_List", ",", 
     " ", "s_List"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"ej", " ", 
      RowBox[{"amp", "/", "2"}]}], ")"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"phizpf", "^", "2"}]}], "/", "2"}], "]"}], " ", 
    RowBox[{"Times", " ", "@@", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"s", " ", 
       RowBox[{"phis", "/", "2"}]}], "]"}]}]}]}], ";"}]], "Input",
 CellID->689611250,ExpressionUUID->"a595f59a-9ff1-4478-8233-83fbde41bdb3"],

Cell["Evaluate it for the preprint's signs.", "Text",
 CellID->1287491687,ExpressionUUID->"ad05d4b5-5423-49b6-bda0-e46ceece532d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"cFormula", "[", 
  RowBox[{"ej", ",", " ", "amp", ",", " ", "phizpf", ",", " ", 
   RowBox[{"{", 
    RowBox[{"p1", ",", " ", "p2", ",", " ", "p3", ",", " ", "p4"}], "}"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", 
     RowBox[{"-", "1"}], ",", " ", "1", ",", " ", 
     RowBox[{"-", "1"}]}], "}"}]}], "]"}]], "Input",
 CellID->976980945,ExpressionUUID->"ffff7da0-160e-46c6-b233-a18122960e2b"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", "amp", " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox["phizpf", "2"], "2"]}]], " ", "ej", " ", 
  RowBox[{"Sin", "[", 
   FractionBox["p1", "2"], "]"}], " ", 
  RowBox[{"Sin", "[", 
   FractionBox["p2", "2"], "]"}], " ", 
  RowBox[{"Sin", "[", 
   FractionBox["p3", "2"], "]"}], " ", 
  RowBox[{"Sin", "[", 
   FractionBox["p4", "2"], "]"}]}]], "Output",ExpressionUUID->"584ece80-d3a4-\
4c27-889d-6c0a55b0af9b"]
}, Open  ]],

Cell["\<\
Verify that it equals the coefficient of the four-qubit product found above, \
with the coupler empty.\
\>", "Text",
 CellID->422269520,ExpressionUUID->"37fafbe3-21e3-4c1f-aeb1-3bd481deeee1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"ej", " ", 
        RowBox[{"amp", "/", "2"}]}], ")"}], " ", 
      RowBox[{"couplerFactor", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
         " ", "0", ",", " ", "phizpf"}], "]"}]}], " ", "-", " ", 
     RowBox[{"cFormula", "[", 
      RowBox[{"ej", ",", " ", "amp", ",", " ", "phizpf", ",", " ", 
       RowBox[{"2", " ", "angles"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], "}"}]}], 
      "]"}]}], ",", " ", 
    RowBox[{"phizpf", " ", ">", " ", "0"}]}], "]"}], " ", "===", " ", 
  "0"}]], "Input",
 CellID->1078859116,ExpressionUUID->"302670b8-7b07-4c97-a6a1-a5da880e4af2"],

Cell[BoxData["True"], "Output",ExpressionUUID->"a7083685-c06f-4893-a649-81b58d09e703"]
}, Open  ]],

Cell["\<\
The formula shows what a single simulated number cannot. The coupling grows \
in proportion to the drive amplitude. It grows as the fourth power of the \
participation phase while that phase is small. And the coupler's zero-point \
motion suppresses it.\
\>", "Text",
 CellID->1580990759,ExpressionUUID->"83c14c02-01b6-414e-93cc-7e7cff27a0df"],

Cell["Expand for a small participation phase.", "Text",
 CellID->395337628,ExpressionUUID->"28faa167-e5d9-486c-a89e-3dda9af35799"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"cFormula", "[", 
    RowBox[{"ej", ",", " ", "amp", ",", " ", "phizpf", ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "p", ",", " ", "p", ",", " ", "p"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], "}"}]}], 
    "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]], "Input",
 CellID->64637481,ExpressionUUID->"c417b6e3-0496-446c-bc78-3e48397ed508"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{
    FractionBox["1", "32"], " ", "amp", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["phizpf", "2"], "2"]}]], " ", "ej", " ", 
    SuperscriptBox["p", "4"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "p", "]"}], "5"],
    SeriesData[$CellContext`p, 0, {}, 4, 5, 1],
    Editable->False]}],
  SeriesData[$CellContext`p, 0, {
   Rational[1, 32] $CellContext`amp 
    E^(Rational[-1, 2] $CellContext`phizpf^2) $CellContext`ej}, 4, 5, 1],
  Editable->False]], "Output",ExpressionUUID->"6f25d75c-390f-4281-9928-\
422a40e3dd8f"]
}, Open  ]],

Cell["Expand for small coupler fluctuations.", "Text",
 CellID->2093271564,ExpressionUUID->"c2c7a840-d157-477c-ad54-84a9816e2e71"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"cFormula", "[", 
    RowBox[{"ej", ",", " ", "amp", ",", " ", "phizpf", ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "p", ",", " ", "p", ",", " ", "p"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], "}"}]}], 
    "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"phizpf", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]], "Input",\

 CellID->124093734,ExpressionUUID->"da7ac37e-ee8e-461a-ad81-78d9d273a369"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", "amp", " ", "ej", " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", 
      FractionBox["p", "2"], "]"}], "4"]}], "-", 
   RowBox[{
    FractionBox["1", "4"], " ", 
    RowBox[{"(", 
     RowBox[{"amp", " ", "ej", " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", 
        FractionBox["p", "2"], "]"}], "4"]}], ")"}], " ", 
    SuperscriptBox["phizpf", "2"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "phizpf", "]"}], "3"],
    SeriesData[$CellContext`phizpf, 0, {}, 0, 3, 1],
    Editable->False]}],
  SeriesData[$CellContext`phizpf, 0, {
   Rational[1, 2] $CellContext`amp $CellContext`ej 
    Sin[Rational[1, 2] $CellContext`p]^4, 0, 
    Rational[-1, 4] $CellContext`amp $CellContext`ej 
    Sin[Rational[1, 2] $CellContext`p]^4}, 0, 3, 1],
  Editable->False]], "Output",ExpressionUUID->"0109dc90-46f4-4a37-9b49-\
61d0177b685b"]
}, Open  ]],

Cell["\<\
Evaluate the coupling, in kHz, at the preprint's single-coupler parameters \
([1], Table I).\
\>", "Text",
 CellID->129568409,ExpressionUUID->"5aee836c-5f4d-4b98-9f95-bbcb91c8c5f9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"cTable", " ", "=", " ", 
  RowBox[{"cFormula", "[", 
   RowBox[{
    RowBox[{"params", "[", "\"\<EJ\>\"", "]"}], ",", " ", 
    RowBox[{"params", "[", "\"\<A\>\"", "]"}], ",", " ", 
    RowBox[{"params", "[", "\"\<phizpf\>\"", "]"}], ",", " ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{
      RowBox[{"params", "[", "\"\<phi\>\"", "]"}], ",", " ", "4"}], "]"}], ",",
     " ", 
    RowBox[{"params", "[", "\"\<s\>\"", "]"}]}], "]"}]}]], "Input",
 CellID->597877820,ExpressionUUID->"f373258b-0a53-4c8d-a57a-d4c7ec7d5b7d"],

Cell[BoxData[
 FractionBox[
  RowBox[{"23500", " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", 
     FractionBox["7", "20"], "]"}], "4"]}], 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"1089", "/", "800"}]]]], "Output",ExpressionUUID->"6c7b7a32-0049-\
4b1f-998e-83b6177afdd6"]
}, Open  ]],

Cell["\<\
Give it as a decimal, for comparison with the preprint's simulated 80.916 kHz.\
\>", "Text",
 CellID->540230488,ExpressionUUID->"17a5d88f-d45b-4364-8926-20087b2e30e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", "cTable", "]"}]], "Input",
 CellID->2106617707,ExpressionUUID->"46ddfbc7-8693-400f-8d8d-3f77f1de2dbb"],

Cell[BoxData["83.28050144716038`"], "Output",ExpressionUUID->"d6abeb0f-7226-4dd5-a20f-bd6d65b42895"]
}, Open  ]],

Cell["\<\
So the formula lands a few percent above the preprint's simulated 80.916 kHz \
([1], \"Single cell demonstration\"). It captures the mechanism the \
simulation computes, and that is what lets us use it for the five questions.\
\>", "Text",
 CellID->1620417510,ExpressionUUID->"60eb0cb4-8380-4115-8b55-937aac9ade8f"],

Cell[CellGroupData[{

Cell["Does the Qubit Model Change the Answer?", "Subsection",
 CellID->724417869,ExpressionUUID->"03eb5cef-fe27-4d46-819a-c1286a90b312"],

Cell[TextData[{
 "The preprint treats each qubit as a two-level system from the start ([1], \
same section). A qubit is really a weakly nonlinear oscillator, though, and a \
second reasonable model keeps that. It applies the cosine to an oscillator \
phase ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["b", "TI"], "^"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["b", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3bdbbc2-e5bd-4d4f-951a-6b7cbbc5aacf"],
 " first, and only then keeps the two lowest levels. The two steps do not \
commute: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1aea92f-126f-4700-b065-3d0ea1dc1e14"],
 " becomes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[
      StyleBox["\[Theta]", "TI"], "2"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2465eac3-adcd-47ab-9239-784a717ce547"],
 ", and a ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Z", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ab56381-4c00-4819-a5b6-bc81a9f029dd"],
 " part appears. Call this the oscillator model of the qubit."
}], "Text",
 CellID->1160720061,ExpressionUUID->"539fcdb6-ac32-44ec-af21-620f3ad1c413"],

Cell["\<\
Define the two-level block of the oscillator model, and the ratio of its \
four-qubit coupling to the two-level model's.\
\>", "Text",
 CellID->1120081650,ExpressionUUID->"08b77db5-a07d-4ae1-8a2f-2d1977068ade"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"projBlock", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"osc", "[", 
      RowBox[{"0", ",", " ", "th"}], "]"}], ",", " ", 
     RowBox[{"osc", "[", 
      RowBox[{"1", ",", " ", "th"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"th", "^", "2"}]}], "/", "2"}], "]"}], " ", 
      RowBox[{"LaguerreL", "[", 
       RowBox[{"1", ",", " ", 
        RowBox[{"th", "^", "2"}]}], "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"projRatio", "[", "h_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"projBlock", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"I", " ", 
         RowBox[{"Sin", "[", "th", "]"}]}], ")"}]}], ")"}], "^", "4"}], " ", "/.",
     " ", 
    RowBox[{"th", " ", "->", " ", "h"}]}]}], ";"}]}], "Input",
 CellID->434933389,ExpressionUUID->"13467696-b7d7-47c0-b9cf-5b29cb038802"],

Cell["\<\
Show the block: the element between the two ground states, the element that \
flips the qubit, and the element between the two excited states.\
\>", "Text",
 CellID->1366089870,ExpressionUUID->"358ef3c6-ca0a-43c1-932d-7b04d89901b8"],

Cell[CellGroupData[{

Cell[BoxData["projBlock"], "Input",
 CellID->746866756,ExpressionUUID->"4e7c97b7-4af9-4289-b44c-8d1831e551a4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["th", "2"], "2"]}]], ",", 
   RowBox[{"\[ImaginaryI]", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["th", "2"], "2"]}]], " ", "th"}], ",", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["th", "2"], "2"]}]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SuperscriptBox["th", "2"]}], ")"}]}]}], "}"}]], "Output",ExpressionUUID->\
"9019153d-50fb-478d-a848-0d5048526475"]
}, Open  ]],

Cell["Evaluate the ratio at Table I's participation phase.", "Text",
 CellID->1224287971,ExpressionUUID->"b9193f00-7508-4b4a-bc85-5bee41b85c01"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"projRatio", "[", 
  RowBox[{
   RowBox[{"params", "[", "\"\<phi\>\"", "]"}], "/", "2"}], "]"}]], "Input",
 CellID->601390417,ExpressionUUID->"fad209d4-4b3b-4189-a046-67e0cdfb84ec"],

Cell[BoxData[
 FractionBox[
  RowBox[{"2401", " ", 
   SuperscriptBox[
    RowBox[{"Csc", "[", 
     FractionBox["7", "20"], "]"}], "4"]}], 
  RowBox[{"160000", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"49", "/", "200"}]]}]]], "Output",ExpressionUUID->"a71c0381-afe3-\
4f10-a11d-9412e5534541"]
}, Open  ]],

Cell["\<\
Verify that the oscillator model's coupling lies below the preprint's \
simulated 80.916 kHz, and the two-level model's above it.\
\>", "Text",
 CellID->809048352,ExpressionUUID->"3581f397-5755-4d91-9ac7-80edc369ab3a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"projRatio", "[", 
    RowBox[{
     RowBox[{"params", "[", "\"\<phi\>\"", "]"}], "/", "2"}], "]"}], " ", 
   "cTable"}], " ", "<", " ", 
  RowBox[{"80916", "/", "1000"}], " ", "<", " ", "cTable"}]], "Input",
 CellID->1424578159,ExpressionUUID->"1a8c3950-5a02-452c-8b73-9f5a22c55e92"],

Cell[BoxData["True"], "Output",ExpressionUUID->"cfe7ec43-b1f9-457c-af10-b023893b68d2"]
}, Open  ]],

Cell["Expand the ratio for small phases.", "Text",
 CellID->1939109630,ExpressionUUID->"ab36f35b-41ba-492c-b2cd-b5548a3cb474"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"projRatio", "[", "h", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"h", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]], "Input",
 CellID->2057835071,ExpressionUUID->"635c467a-96df-42cb-9826-221a005628a0"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"1", "-", 
   FractionBox[
    RowBox[{"4", " ", 
     SuperscriptBox["h", "2"]}], "3"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "h", "]"}], "3"],
    SeriesData[$CellContext`h, 0, {}, 0, 3, 1],
    Editable->False]}],
  SeriesData[$CellContext`h, 0, {1, 0, 
    Rational[-4, 3]}, 0, 3, 1],
  Editable->False]], "Output",ExpressionUUID->"3ef78af5-0737-44a5-9f2f-\
580e5dbdba9e"]
}, Open  ]],

Cell["\<\
The two models agree for small phases. At the preprint's phase, the \
oscillator model's coupling lands below the simulated value, while the \
two-level model's lands above it. So matching the simulation does not single \
out a qubit model; a second parameter point would.\
\>", "Text",
 CellID->1757108918,ExpressionUUID->"38c973ea-958d-4a60-93d9-6c7e86eb1989"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Question 1: Can the Single Coupler's Parameters Be Carried Into the \
Eight-Qubit Array?\
\>", "Section",
 CellID->682077713,ExpressionUUID->"009a3688-69a8-4efd-b549-aa3a0f7ed58d"],

Cell["\<\
The preprint chooses its parameters in two steps. It tunes one coupler with \
its four qubits ([1], Table I). Then it searches parameters for the \
eight-qubit array, where every qubit's Josephson energy must be at least 4.9 \
GHz ([1], supplementary Table S5). Table I gives each qubit a frequency, \
taken from Sameti et al. [2], and the participation phase 0.7. It does not \
give the qubits' Josephson energies. But the circuit fixes a qubit's \
Josephson energy once its frequency and phase are chosen. So we can ask \
whether Table I's qubits meet the array's minimum. The two low-frequency \
qubits do not.\
\>", "Text",
 CellID->1529757074,ExpressionUUID->"a3043b3d-0e8c-42a4-a5a1-3218a1c37c7e"],

Cell[TextData[{
 "In the circuit the preprint cites ([2], Appendix B), a qubit's \
participation phase is its zero-point phase. Two energies set it: the \
charging energy ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], 
   StyleBox["C", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "444272fb-7a1e-4653-b106-ec2438a1f35c"],
 ", and the total phase stiffness ",
 Cell[BoxData[
  StyleBox["E", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "642f71e2-fc01-41b1-8fad-9d862ab06159"],
 ". The stiffness is the qubit's own Josephson energy ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], 
   StyleBox[
    RowBox[{"J", "q"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b19f4371-8fb9-4744-9ecc-bc14368214f2"],
 " plus four times the inductive energy ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], 
   StyleBox["L", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51146d44-2ce6-4836-9357-22ba7ef08e0b"],
 " that connects it to the coupler:"
}], "Text",
 CellID->1701455113,ExpressionUUID->"03a4f9cd-0e31-4ebc-aba5-03e718162f3e"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["E", "TI"], "=", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox[
      RowBox[{"J", "q"}], "TI"]], "+", "4", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["L", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{"\[CurlyPhi]", "=", 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"2", 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["C", "TI"]], "/", 
       StyleBox["E", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{"1", "/", "4"}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["harm",
      FontSlant->"Plain"]], "=", 
    RowBox[{
     SqrtBox[
      RowBox[{"8", 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["C", "TI"]], 
       StyleBox["E", "TI"]}]], "=", 
     RowBox[{"2", 
      StyleBox["E", "TI"], 
      RowBox[{
       SuperscriptBox["\[CurlyPhi]", "2"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1263725061,ExpressionUUID->"0d38dea9-7ada-4ddf-8cda-54a9e862b77e"],

Cell[TextData[{
 "So a frequency and a phase together fix the circuit energies. The frequency \
needs one correction. Only the Josephson part of the stiffness is nonlinear, \
so the leading shift comes from ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], 
   StyleBox[
    RowBox[{"J", "q"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8947931-f5c6-4e14-9246-b38479650808"],
 " alone:"
}], "Text",
 CellID->1953622044,ExpressionUUID->"fda73211-2fe7-489e-93e5-76197201b8e4"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["quartic",
      FontSlant->"Plain"]], "=", 
    SqrtBox[
     RowBox[{"8", 
      SubscriptBox[
       StyleBox["E", "TI"], 
       StyleBox["C", "TI"]], 
      StyleBox["E", "TI"]}]], "-", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["C", "TI"]], 
    FractionBox[
     SubscriptBox[
      StyleBox["E", "TI"], 
      StyleBox[
       RowBox[{"J", "q"}], "TI"]], 
     StyleBox["E", "TI"]], "=", "2", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["E", "TI"], 
      StyleBox[
       RowBox[{"J", "q"}], "TI"]], "+", "4", 
     SubscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["L", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    SuperscriptBox["\[CurlyPhi]", "2"], "-", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["E", "TI"], 
       StyleBox[
        RowBox[{"J", "q"}], "TI"]], 
      SuperscriptBox["\[CurlyPhi]", "4"]}], "2"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->789879331,ExpressionUUID->"30b4c608-ff96-4993-a37c-6acc0fa21d75"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["L", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40e56e4f-2c01-4bbb-8b84-e22f3e087068"],
 " this is the familiar transmon correction ",
 Cell[BoxData[
  RowBox[{"-", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2d1c26b-a067-4c48-b523-a789ab0ecb6b"],
 "."
}], "Text",
 CellID->500411642,ExpressionUUID->"0cab3a56-3d75-4cee-abd2-c2cc3aabd253"],

Cell["\<\
Define both frequency formulas, the quartic level shift, and the stiffness \
and charging energy written in terms of the phase.\
\>", "Text",
 CellID->1708147932,ExpressionUUID->"ad4c4612-312a-443c-a1e4-6a6be0c17479"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"freqForms", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Harmonic\>\"", " ", "->", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ejq", ",", " ", "ph", ",", " ", "el"}], "}"}], ",", " ", 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"ejq", " ", "+", " ", 
           RowBox[{"4", " ", "el"}]}], ")"}], " ", 
         RowBox[{"ph", "^", "2"}]}]}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"\"\<Quartic\>\"", " ", "->", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ejq", ",", " ", "ph", ",", " ", "el"}], "}"}], ",", " ", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{"ejq", " ", "+", " ", 
            RowBox[{"4", " ", "el"}]}], ")"}], " ", 
          RowBox[{"ph", "^", "2"}]}], " ", "-", " ", 
         RowBox[{"ejq", " ", 
          RowBox[{
           RowBox[{"ph", "^", "4"}], "/", "2"}]}]}]}], "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"oscCoordinate", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Band", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], " ", "->", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Range", "[", 
          RowBox[{"n", " ", "-", " ", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Band", "[", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], " ", "->", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Range", "[", 
          RowBox[{"n", " ", "-", " ", "1"}], "]"}], "]"}]}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quarticGap", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x4", " ", "=", " ", 
       RowBox[{"MatrixPower", "[", 
        RowBox[{
         RowBox[{"oscCoordinate", "[", "6", "]"}], ",", " ", "4"}], "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{
      RowBox[{"x4", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
      RowBox[{"x4", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"stiffness", " ", "=", " ", 
   RowBox[{"ejq", " ", "+", " ", 
    RowBox[{"4", " ", "el"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"charging", " ", "=", " ", 
   RowBox[{
    RowBox[{"phT", "^", "4"}], " ", 
    RowBox[{"stiffness", "/", "2"}]}]}], ";"}]}], "Input",
 CellID->291071734,ExpressionUUID->"11418928-37fc-4fb4-96fa-1d1d7ecb0fc9"],

Cell["Show the two frequency formulas.", "Text",
 CellID->1086620463,ExpressionUUID->"0b147922-f0bf-49d7-ae5b-203e92bb4062"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Through", "[", 
  RowBox[{
   RowBox[{"Values", "[", "freqForms", "]"}], "[", 
   RowBox[{"ejq", ",", " ", "phT", ",", " ", "el"}], "]"}], "]"}]], "Input",
 CellID->270036435,ExpressionUUID->"3f03853d-2d2a-45db-8732-8e4712f6d327"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{"ejq", "+", 
      RowBox[{"4", " ", "el"}]}], ")"}], " ", 
    SuperscriptBox["phT", "2"]}], ",", 
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"ejq", "+", 
       RowBox[{"4", " ", "el"}]}], ")"}], " ", 
     SuperscriptBox["phT", "2"]}], "-", 
    FractionBox[
     RowBox[{"ejq", " ", 
      SuperscriptBox["phT", "4"]}], "2"]}]}], "}"}]], "Output",ExpressionUUID->\
"92fd6582-dc2b-4f81-be95-c7f7eed48f2b"]
}, Open  ]],

Cell["\<\
Verify that they follow from the circuit relations, the quartic one through \
the first-order shift of the lowest transition.\
\>", "Text",
 CellID->1642556927,ExpressionUUID->"baafb3d3-75c4-461f-83a3-5eda27d3806c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"8", " ", "charging", " ", "stiffness"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"8", " ", "charging", " ", "stiffness"}], "]"}], " ", "-", 
       " ", 
       RowBox[{"ejq", " ", 
        RowBox[{"phT", "^", "4"}], " ", 
        RowBox[{"quarticGap", "/", "24"}]}]}]}], "}"}], " ", "-", "\n", "  ", 
    
    RowBox[{"Through", "[", 
     RowBox[{
      RowBox[{"Values", "[", "freqForms", "]"}], "[", 
      RowBox[{"ejq", ",", " ", "phT", ",", " ", "el"}], "]"}], "]"}]}], ",", 
   " ", 
   RowBox[{
    RowBox[{"ejq", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"el", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"phT", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellID->773882931,ExpressionUUID->"fdd52af0-e2da-44d5-8956-4c87a0f21373"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0"}], "}"}]], "Output",ExpressionUUID->"c92ac854-780b-4e60-b335-e66a25c9b125"]
}, Open  ]],

Cell[TextData[{
 "Give the ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "/", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce7aa9b6-3e2f-432f-8dc3-e679ab90f902"],
 " that a given phase implies."
}], "Text",
 CellID->24404122,ExpressionUUID->"d802d074-bed2-4ba6-9038-d755eb3d341e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"stiffness", "/", "charging"}], "]"}]], "Input",
 CellID->1896186496,ExpressionUUID->"1c9c6167-d6c1-4e9b-8f7a-9b125d85c70c"],

Cell[BoxData[
 FractionBox["2", 
  SuperscriptBox["phT", "4"]]], "Output",ExpressionUUID->"0a8e0abf-b4ae-4e55-923c-6ebb79d1efeb"]
}, Open  ]],

Cell["\<\
The ratio falls as the fourth power of the phase. So the larger the phase, \
the further the qubit sits from the regime where these transmon formulas are \
accurate. This matters below.\
\>", "Text",
 CellID->1177856204,ExpressionUUID->"e5f5e459-bce6-40cc-9271-6a8e44328de8"],

Cell[TextData[{
 "Both frequencies rise with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], 
   StyleBox[
    RowBox[{"J", "q"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e75702d4-5be1-4388-bd33-ca790189ad0e"],
 ", and with ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f92117a2-cc6d-4d5c-a3c4-4a7ab0133112"],
 " for ",
 Cell[BoxData[
  RowBox[{"0", "<", "\[CurlyPhi]", "<", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6373e7f2-d623-4d7b-9df9-d80f5d82942d"],
 ". So a minimum Josephson energy and a given phase set a minimum frequency."
}], "Text",
 CellID->104431095,ExpressionUUID->"089deba0-166b-4936-ae5c-92b4916b5b4f"],

Cell["Define a test that both frequencies rise in both variables.", "Text",
 CellID->497190960,ExpressionUUID->"743b08d9-4d24-4926-8fcc-442ef7263bf9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"boundQ", "[", "freq_", "]"}], " ", ":=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"freq", "[", 
          RowBox[{"ejq", ",", " ", "ph", ",", " ", "el"}], "]"}], ",", " ", 
         "ejq"}], "]"}], " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"freq", "[", 
          RowBox[{"ejq", ",", " ", "ph", ",", " ", "el"}], "]"}], ",", " ", 
         "ph"}], "]"}], " ", ">", " ", "0"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"ejq", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"el", " ", ">=", " ", "0"}], " ", "&&", " ", 
      RowBox[{"0", " ", "<", " ", "ph", " ", "<", " ", 
       RowBox[{"Sqrt", "[", "2", "]"}]}]}]}], "]"}]}], ";"}]], "Input",
 CellID->1702078563,ExpressionUUID->"596ba350-1cdb-46b1-b61b-7ba558e507cf"],

Cell["Verify it for both frequency formulas.", "Text",
 CellID->464502757,ExpressionUUID->"e2732f32-165c-4461-ba96-3d04578e0456"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"boundQ", " ", "/@", " ", "freqForms"}]], "Input",
 CellID->499755699,ExpressionUUID->"7dc84173-1f54-4ce5-944f-a9891d0f2b5a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Harmonic\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Quartic\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"2d398d8f-9713-4d34-b0f0-\
489cfa3263fa"]
}, Open  ]],

Cell["\<\
Evaluate that minimum frequency, in GHz, at the 4.9 GHz minimum and the phase \
0.7, with no inductive energy.\
\>", "Text",
 CellID->231895782,ExpressionUUID->"27da87f6-9f88-4329-9185-66435c90913b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"minFreq", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"#", "[", 
     RowBox[{
      RowBox[{"params", "[", "\"\<EJqMin\>\"", "]"}], ",", " ", 
      RowBox[{"params", "[", "\"\<phi\>\"", "]"}], ",", " ", "0"}], "]"}], 
    " ", "&"}], " ", "/@", " ", "freqForms"}]}]], "Input",
 CellID->2139662887,ExpressionUUID->"df9040a2-0fe0-4d9a-b848-2f9abf63347b"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Harmonic\"\>", "\[Rule]", 
    FractionBox["2401", "500"]}], ",", 
   RowBox[{"\<\"Quartic\"\>", "\[Rule]", 
    FractionBox["842751", "200000"]}]}], "\[RightAssociation]"}]], "Output",Ex\
pressionUUID->"49c3ceb1-7deb-4149-8575-7b83d0605f92"]
}, Open  ]],

Cell["\<\
Verify that both lie above Table I's two low qubit frequencies.\
\>", "Text",
 CellID->1218094376,ExpressionUUID->"c531b569-acb8-404d-89ca-366e82faadee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Min", "[", 
   RowBox[{"Values", "[", "minFreq", "]"}], "]"}], " ", ">", " ", 
  RowBox[{"Max", "[", 
   RowBox[{
    RowBox[{"params", "[", "\"\<wq\>\"", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"3", " ", ";;", " ", "4"}], "]"}], "]"}], "]"}]}]], "Input",
 CellID->1367747305,ExpressionUUID->"f05a01e2-915f-4960-bec6-422ac9439f44"],

Cell[BoxData["True"], "Output",ExpressionUUID->"c137f3dc-0984-4fd7-b83f-4ededa0787eb"]
}, Open  ]],

Cell[TextData[{
 "But both formulas are expansions. They are least reliable with no inductive \
energy, because then ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "/", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]], "=", "2", "/", 
   SuperscriptBox["\[CurlyPhi]", "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50c984c6-31ce-41c4-bba9-44dfa5b46694"],
 " is small at this phase. That case has an exact solution. With no inductive \
energy the qubit is a charge qubit, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", "4", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["n", "TI"], "^"], "-", 
      SubscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["g", "TI"]]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], "-", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox[
     RowBox[{"J", "q"}], "TI"]], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["\[Phi]", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ec426ca-9668-45c9-bf3b-efb16067756a"],
 ". Here ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3867511b-35d0-40ae-a60e-9ed167ab28bd"],
 " counts Cooper pairs, and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["g", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0617779f-912c-44e0-a596-33d10d42a335"],
 " is the offset charge set by stray electric fields. The levels are Mathieu \
characteristic values ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["r", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["q", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea9c2805-7c9c-471e-b6d8-708b1565f746"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["q", "TI"], "=", "-", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox[
     RowBox[{"J", "q"}], "TI"]], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["C", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa982215-012c-4418-a34b-9ab4b858b481"],
 " and an exponent ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53e5699f-a5ab-4876-abb0-4772cc6562fd"],
 " fixed by ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["g", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "322fbd6f-b1f3-405a-b450-e26fbac9ee48"],
 " [3]. For ",
 Cell[BoxData[
  RowBox[{"0", "<", 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["g", "TI"]], "<", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bccf197-ffd9-4eb2-8b20-4d16af1c37a3"],
 " the two lowest levels have ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "2", 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["g", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "698ce818-d432-4919-8ebe-87cb43e530c5"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "2", "-", "2", 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["g", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "274edc98-7f61-4315-9f04-6a7e5cc3b0e8"],
 ". At the two ends of this range ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0546bbd0-45f0-4489-a2e5-29e1187611d7"],
 " is an integer, and the transition is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["b", "TI"], "2"], "-", 
    SubscriptBox[
     StyleBox["a", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09fc5be5-e061-410e-b1e8-5ac1f664cfc0"],
 " at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["g", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4956bd88-50cc-416b-803d-e544e3b1380e"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["b", "TI"], "1"], "-", 
    SubscriptBox[
     StyleBox["a", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7edefbac-73d8-4dab-8732-55558edb0b7d"],
 " at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["g", "TI"]], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae249e8e-8bc2-4de2-b619-f828d19317dc"],
 "."
}], "Text",
 CellID->471358270,ExpressionUUID->"954e8a22-a60e-420e-9077-d8dc4badbc4c"],

Cell["\<\
Write the lowest transition at the 4.9 GHz minimum and the phase 0.7, at the \
two extreme offset charges.\
\>", "Text",
 CellID->86914683,ExpressionUUID->"b2a296ec-dfc5-43c8-9f17-e50e6d4691eb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ecMin", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"params", "[", "\"\<phi\>\"", "]"}], "^", "4"}], " ", 
    RowBox[{
     RowBox[{"params", "[", "\"\<EJqMin\>\"", "]"}], "/", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qMin", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"params", "[", "\"\<EJqMin\>\"", "]"}]}], "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", "ecMin"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"chargeGap", " ", "=", " ", 
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"0", " ", "->", " ", 
     RowBox[{"ecMin", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"MathieuCharacteristicB", "[", 
         RowBox[{"2", ",", " ", "qMin"}], "]"}], " ", "-", " ", 
        RowBox[{"MathieuCharacteristicA", "[", 
         RowBox[{"0", ",", " ", "qMin"}], "]"}]}], ")"}]}]}], ",", "\n", 
    "   ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", "->", " ", 
     RowBox[{"ecMin", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"MathieuCharacteristicB", "[", 
         RowBox[{"1", ",", " ", "qMin"}], "]"}], " ", "-", " ", 
        RowBox[{"MathieuCharacteristicA", "[", 
         RowBox[{"1", ",", " ", "qMin"}], "]"}]}], ")"}]}]}]}], 
   "|>"}]}]}], "Input",
 CellID->1397423483,ExpressionUUID->"2b101a2d-6eb6-4d70-a5dc-13fda70917e4"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"0", "\[Rule]", 
    FractionBox[
     RowBox[{"117649", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"MathieuCharacteristicA", "[", 
          RowBox[{"0", ",", 
           RowBox[{"-", 
            FractionBox["10000", "2401"]}]}], "]"}]}], "+", 
        RowBox[{"MathieuCharacteristicB", "[", 
         RowBox[{"2", ",", 
          RowBox[{"-", 
           FractionBox["10000", "2401"]}]}], "]"}]}], ")"}]}], "200000"]}], ",", 
   RowBox[{
    FractionBox["1", "2"], "\[Rule]", 
    FractionBox[
     RowBox[{"117649", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"MathieuCharacteristicA", "[", 
          RowBox[{"1", ",", 
           RowBox[{"-", 
            FractionBox["10000", "2401"]}]}], "]"}]}], "+", 
        RowBox[{"MathieuCharacteristicB", "[", 
         RowBox[{"1", ",", 
          RowBox[{"-", 
           FractionBox["10000", "2401"]}]}], "]"}]}], ")"}]}], "200000"]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"a4aec489-4768-44a2-8dce-\
23ec8009e256"]
}, Open  ]],

Cell["\<\
Compare the Mathieu values with a direct diagonalization in 61 charge states, \
first the Mathieu values as decimals, then the diagonalization.\
\>", "Text",
 CellID->553956863,ExpressionUUID->"ca0eddf3-9e19-43e8-9879-32e97ce24237"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chargeBasisGap", "[", 
    RowBox[{"ejq_", ",", " ", "ec_", ",", " ", "ng_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "30"}], ",", " ", "30"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"Subtract", " ", "@@", " ", 
      RowBox[{"Reverse", "[", 
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{"Eigenvalues", "[", 
           RowBox[{"N", "[", 
            RowBox[{"Normal", "[", "\n", "      ", 
             RowBox[{"SparseArray", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Band", "[", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", " ", "1"}], "}"}], "]"}], " ", "->", 
                  " ", 
                  RowBox[{"4", " ", "ec", " ", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"n", " ", "-", " ", "ng"}], ")"}], "^", "2"}]}]}],
                  ",", " ", 
                 RowBox[{
                  RowBox[{"Band", "[", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], " ", "->", 
                  " ", 
                  RowBox[{
                   RowBox[{"-", "ejq"}], "/", "2"}]}], ",", " ", 
                 RowBox[{
                  RowBox[{"Band", "[", 
                   RowBox[{"{", 
                    RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], " ", "->", 
                  " ", 
                  RowBox[{
                   RowBox[{"-", "ejq"}], "/", "2"}]}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"61", ",", " ", "61"}], "}"}]}], "]"}], "]"}], "]"}], 
           "]"}], "]"}], ",", " ", "2"}], "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"N", "[", 
    RowBox[{"Values", "[", "chargeGap", "]"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"chargeBasisGap", "[", 
      RowBox[{
       RowBox[{"params", "[", "\"\<EJqMin\>\"", "]"}], ",", " ", "ecMin", ",",
        " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"Keys", "[", "chargeGap", "]"}]}]}], "}"}]}], "Input",
 CellID->116211384,ExpressionUUID->"f2151db4-0d27-48cc-81ec-e34a5a721f1e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4.220454724582281`", ",", "3.980026750128501`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4.220454724581912`", ",", "3.9800267501282622`"}], "}"}]}], 
  "}"}]], "Output",ExpressionUUID->"94cadc5e-b9cb-40d9-ab0e-7883c5006154"]
}, Open  ]],

Cell["\<\
Find which offset charges keep the transition above Table I's 4.1 GHz qubit.\
\>", "Text",
 CellID->2140780886,ExpressionUUID->"a880acd9-8513-4de6-a8e6-1a14e70931dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"#", " ", ">", " ", 
    RowBox[{
     RowBox[{"params", "[", "\"\<wq\>\"", "]"}], "[", 
     RowBox[{"[", "4", "]"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
  "chargeGap"}]], "Input",
 CellID->2364046,ExpressionUUID->"5fc0698e-34cf-461a-b9cf-891aa5d7cf7e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"0", "\[Rule]", "True"}], ",", 
