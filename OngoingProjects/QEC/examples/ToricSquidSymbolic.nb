Cell["\<\
Taking the listed frequencies as exact, each resonant transition flips a pair \
of qubits and leaves several excitations in the coupler. One of them is \
resonant with two different tones.\
\>", "Text",
 CellID->520476813,ExpressionUUID->"6094e0f1-e0c7-4f1c-93c7-9b63446362bd"],

Cell[TextData[{
 "Estimate the fraction of population each would move in one drive period ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dda99f5-7fd9-40fd-bfae-e1244ce3cf0d"],
 ", treating each transition as an isolated two-level system driven on \
resonance, for which that fraction is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", "\[Pi]", 
    StyleBox["g", "TI"], 
    StyleBox["T", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a00bad84-a768-4482-983d-cce69e575b93"],
 " with ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8030ffa-6cce-4d75-afaa-047b3f4e970c"],
 " in frequency units."
}], "Text",
 CellID->2054782259,ExpressionUUID->"f4b10d3a-6870-4bad-b9f0-00f12cd69178"],

