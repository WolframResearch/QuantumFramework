Cell[BoxData[
 RowBox[{"HermitianMatrixQ", "[", "h0", "]"}]], "Input",
 CellID->1249815441,ExpressionUUID->"9858c874-5a75-4c2e-b3e2-949e7753592a"],

Cell[BoxData["True"], "Output",ExpressionUUID->"856c49d5-9b29-48f3-a735-212859f6e870"]
