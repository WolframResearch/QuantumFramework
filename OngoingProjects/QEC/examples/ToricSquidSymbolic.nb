  FractionBox[
   SuperscriptBox["g", "2"], "d"]}]], "Output",ExpressionUUID->"0d0186ef-ebd8-\
4930-aaec-be8b138b30ef"]
}, Open  ]],

Cell[TextData[{
 "Compute the coefficients of those ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Z", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "92d9e3b2-1948-4ecc-b126-b2d83ef13775"],
 " products symbolically in the drive strength ",
 Cell[BoxData["drv"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2678cfea-1cdc-4084-889e-e596716d739b"],
 "."
}], "Text",
 CellID->696969587,ExpressionUUID->"95dd7bca-7a73-4fbd-9c19-613ec4e7a7cf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"offResonant", "[", 
    RowBox[{"z_", ",", " ", "mm_", ",", " ", "drive_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"processes", "[", 
      RowBox[{"z", ",", " ", "mm", ",", " ", "drive"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"#Detuning", " ", "!=", " ", "0"}], " ", "&&", " ", 
       RowBox[{"#g", " ", "=!=", " ", "0"}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zSigns", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Times", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"2", " ", 
          RowBox[{"#2", "[", 
           RowBox[{"[", "#1", "]"}], "]"}]}]}], ")"}]}], " ", "&"}], ",", " ",
      "zWords", ",", " ", "zStates", ",", " ", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"toZWords", "[", "shifts_", "]"}], " ", ":=", " ", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{"zWords", ",", " ", 
     RowBox[{
      RowBox[{"zSigns", " ", ".", " ", "shifts"}], "/", "16"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"secondOrder", "[", 
    RowBox[{"z_", ",", " ", "mm_", ",", " ", "drive_", ",", " ", 
     RowBox[{"keep_", " ", ":", " ", 
      RowBox[{"(", 
       RowBox[{"True", " ", "&"}], ")"}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"#g", "^", "2"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"kHzPerGHz", " ", "#Detuning"}], ")"}]}], " ", "&"}], " ", "/@",
      " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"offResonant", "[", 
        RowBox[{"z", ",", " ", "mm", ",", " ", "drive"}], "]"}], ",", " ", 
       "keep"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zCouplings", "[", 
    RowBox[{"mm_", ",", " ", "drive_", ",", " ", 
     RowBox[{"keep_", " ", ":", " ", 
      RowBox[{"(", 
       RowBox[{"True", " ", "&"}], ")"}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Expand", " ", "/@", " ", 
    RowBox[{"toZWords", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"secondOrder", "[", 
        RowBox[{"#", ",", " ", "mm", ",", " ", "drive", ",", " ", "keep"}], 
        "]"}], " ", "&"}], " ", "/@", " ", "zStates"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zExact", " ", "=", " ", 
   RowBox[{"zCouplings", "[", 
    RowBox[{"mMax", ",", " ", "drv"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"allOff", " ", "=", " ", 
   RowBox[{"Catenate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"offResonant", "[", 
       RowBox[{"#", ",", " ", "mMax", ",", " ", "drive0"}], "]"}], " ", "&"}],
      " ", "/@", " ", "zStates"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"stateShifts", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"secondOrder", "[", 
      RowBox[{"#", ",", " ", "mMax", ",", " ", "drv"}], "]"}], " ", "&"}], 
    " ", "/@", " ", "zStates"}]}], ";"}]}], "Input",
 CellID->1101432359,ExpressionUUID->"4fde5fc9-7702-4a65-a7ad-cad55c10820e"],

Cell["\<\
Verify that transforming back recovers the 16 shifts exactly.\
\>", "Text",
 CellID->1967428890,ExpressionUUID->"d718f5a5-5900-402c-ae5b-a499d5c722fb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Expand", "[", 
   RowBox[{
    RowBox[{"Mean", "[", "stateShifts", "]"}], " ", "+", " ", 
    RowBox[{
     RowBox[{"Transpose", "[", "zSigns", "]"}], " ", ".", " ", 
     RowBox[{"Values", "[", 
      RowBox[{"toZWords", "[", "stateShifts", "]"}], "]"}]}], " ", "-", " ", 
    "stateShifts"}], "]"}], " ", "===", " ", 
  RowBox[{"ConstantArray", "[", 
   RowBox[{"0", ",", " ", "16"}], "]"}]}]], "Input",
 CellID->2092495381,ExpressionUUID->"d38bfd0e-bf51-463f-8fc6-6ba1dd62ec34"],

