Cell["\<\
Some transitions kept here are detuned by less than the rounding above \
allows, so their detunings may not be safely nonzero. Compare the full sum \
with a sum that drops them.\
\>", "Text",
 CellID->963406321,ExpressionUUID->"c0790ea7-ce34-4d1a-9f25-269a48f7c62f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"roundingSafe", "[", "p_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"mhzPerGHz", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{"p", "[", "\"\<Detuning\>\"", "]"}], "]"}]}], " ", ">", " ", 
    RowBox[{"worstCaseMHz", "[", 
     RowBox[{"p", ",", " ", "roundingErrors"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zSafe", " ", "=", " ", 
   RowBox[{"zCouplings", "[", 
    RowBox[{"mMax", ",", " ", "drv", ",", " ", "roundingSafe"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"largestByWeight", "[", "zc_", "]"}], " ", ":=", " ", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"Values", "[", 
          RowBox[{"KeySelect", "[", 
           RowBox[{"zc", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "1"}], " ", 
             "&"}]}], "]"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"Values", "[", 
          RowBox[{"KeySelect", "[", 
           RowBox[{"zc", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], " ", ">", " ", "1"}], " ", 
             "&"}]}], "]"}], "]"}], "]"}], "]"}]}], "}"}], " ", "/.", " ", 
     RowBox[{"drv", " ", "->", " ", "drive0"}]}], "]"}]}], ";"}]}], "Input",
 CellID->229076040,ExpressionUUID->"251a86b3-339d-4d67-b1f1-d7e3084677fa"],

