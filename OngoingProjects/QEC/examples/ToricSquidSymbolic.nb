Cell[BoxData[
 RowBox[{"Length", "[", "twoToneCandidates", "]"}]], "Input",
 CellID->955427842,ExpressionUUID->"4143fc00-8479-4ab7-a5d3-09c91bca8aa2"],

Cell[BoxData["48"], "Output",ExpressionUUID->"b40d32a4-9c2f-4d80-a871-62b9a912a536"]
