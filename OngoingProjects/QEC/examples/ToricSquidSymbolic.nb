Cell["\<\
Verify exactly that every coefficient of both sums lies below 9.22 kHz.\
\>", "Text",
 CellID->687348431,ExpressionUUID->"3159b254-305f-4c40-9651-f0ee7c1999cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Values", "[", 
      RowBox[{"#", " ", "/.", " ", 
       RowBox[{"drv", " ", "->", " ", "drive0"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "#", "]"}], " ", "<", " ", 
       RowBox[{"922", "/", "100"}]}], " ", "&"}]}], "]"}], " ", "&"}], " ", "/@",
   " ", 
  RowBox[{"{", 
   RowBox[{"zExact", ",", " ", "zSafe"}], "}"}]}]], "Input",
 CellID->549535179,ExpressionUUID->"4a9fffe3-bb42-410c-a7fe-7990199e8b53"],

