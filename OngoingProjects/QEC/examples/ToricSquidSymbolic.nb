Cell[TextData[{
 "The distance grows as ",
 Cell[BoxData[
  StyleBox["L", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "780b7028-ac50-4797-9273-ba6d2c388743"],
 " while the number of stored qubits stays at two."
}], "Text",
 CellID->1804992986,ExpressionUUID->"fa709929-de18-4063-9327-9f793404e381"],

Cell["\<\
A second test for logical products, independent of the QEC layer: a product \
is logical when it commutes with every check and is not itself a product of \
checks (adding it raises the rank of the check matrix).\
\>", "Text",
 CellID->1569019346,ExpressionUUID->"a95c0ec6-ad58-4c01-ab25-55984d0a6962"],

Cell["Define that test.", "Text",
 CellID->1900592021,ExpressionUUID->"e88ad778-a389-47b3-b9a0-c436d7e5bdbf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"logicalQ", "[", "ch_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"MatrixRank", "[", 
        RowBox[{"ch", ",", " ", 
         RowBox[{"Modulus", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"Function", "[", 
      RowBox[{"v", ",", " ", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{"ch", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"symp", "[", 
             RowBox[{"v", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
           "&"}]}], "]"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"MatrixRank", "[", 
          RowBox[{
           RowBox[{"Append", "[", 
            RowBox[{"ch", ",", " ", "v"}], "]"}], ",", " ", 
           RowBox[{"Modulus", " ", "->", " ", "2"}]}], "]"}], " ", ">", " ", 
         "r"}]}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellID->2042972589,ExpressionUUID->"07ecdb4a-afdf-4d2e-b6dc-04967177ccf7"],

Cell["\<\
Verify that the only relations among the checks are all stars and all \
plaquettes, at sizes 2 to 5.\
\>", "Text",
 CellID->989807480,ExpressionUUID->"5d56d955-a735-4604-a4f6-c5c35853897f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", " ", "=", " ", 
       RowBox[{"L", "^", "2"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"NullSpace", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"symplecticChecks", "[", "L", "]"}], "]"}], ",", " ", 
         RowBox[{"Modulus", " ", "->", " ", "2"}]}], "]"}], "]"}], " ", "===",
       "\n", "   ", 
      RowBox[{"Sort", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"ConstantArray", "[", 
            RowBox[{"1", ",", " ", "n"}], "]"}], ",", " ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", " ", "n"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", " ", "n"}], "]"}], ",", " ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"1", ",", " ", "n"}], "]"}]}], "]"}]}], "}"}], "]"}]}]}], 
    "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"L", ",", " ", "2", ",", " ", "5"}], "}"}]}], "]"}]], "Input",
 CellID->616437651,ExpressionUUID->"ae531187-3de9-4aaf-9710-67c1031c21e4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True", ",", "True"}], "}"}]], "Output",Ex\
pressionUUID->"65beeb15-4d1e-4434-bd19-5501383d74ec"]
}, Open  ]],

