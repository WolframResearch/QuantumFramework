Cell["The protected space has four states: two stored qubits.", "Text",
 CellID->955812305,ExpressionUUID->"802cbe0a-9585-4466-93b5-db1b4c918d03"],

Cell[TextData[{
 "The whole spectrum of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71c66c79-7372-44c1-8e4c-1ca2ab0a2276"],
 " is known in closed form. Each check that is ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96f377dd-fbcb-45a2-b7a9-b589b9972a26"],
 " costs ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b26df7f9-8b17-43b0-a913-8d05444d138b"],
 ", and on a torus such stars, like such plaquettes, come in pairs. So a \
pattern with ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01885466-71e2-4d0c-8cd1-8b62a3717bac"],
 " stars and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "761409b9-a1d4-45ba-8c50-4922c830a155"],
 " plaquettes at ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5eeaf37-e013-4b19-b7d0-dbd8c61b13a1"],
 " costs ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["c", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["j", "TI"], "+", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db01e00b-711f-4a33-95d9-cba89a70082b"],
 " above the protected space. It occurs ",
 Cell[BoxData[
  RowBox[{"4", 
   TemplateBox[{
     SuperscriptBox[
      StyleBox["L", "TI"], "2"], 
     StyleBox["j", "TI"]},
    "Binomial"], 
   TemplateBox[{
     SuperscriptBox[
      StyleBox["L", "TI"], "2"], 
     StyleBox["k", "TI"]},
    "Binomial"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b0b742b-cd64-4571-b694-8dcbfe023cf7"],
 " times, where the factor 4 is the protected space itself, which every \
pattern inherits."
}], "Text",
 CellID->6560469,ExpressionUUID->"eec672dc-c891-4f15-a667-aadfdc91c869"],

Cell[TextData[{
 "Encode this count as a function of the lattice size ",
 Cell[BoxData[
  StyleBox["L", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc832adf-6fc2-43c3-a933-3148a5951d65"],
 "."
}], "Text",
 CellID->739238270,ExpressionUUID->"fa101c0f-5474-44dd-b10f-c989581777be"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"spectrum", "[", "L_", "]"}], " ", ":=", " ", 
   RowBox[{"Normal", " ", "@", " ", 
    RowBox[{"KeySort", " ", "@", " ", 
     RowBox[{"GroupBy", "[", "\n", "     ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", " ", "c", " ", 
            RowBox[{"(", 
             RowBox[{"#1", " ", "+", " ", "#2"}], ")"}]}], ",", " ", 
           RowBox[{"4", " ", 
            RowBox[{"Binomial", "[", 
             RowBox[{
              RowBox[{"L", "^", "2"}], ",", " ", "#1"}], "]"}], " ", 
            RowBox[{"Binomial", "[", 
             RowBox[{
              RowBox[{"L", "^", "2"}], ",", " ", "#2"}], "]"}]}]}], "}"}], 
         " ", "&"}], " ", "@@@", " ", 
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"L", "^", "2"}], ",", " ", "2"}], "]"}], ",", " ", "2"}], 
         "]"}]}], ",", " ", 
       RowBox[{"First", " ", "->", " ", "Last"}], ",", " ", "Total"}], 
      "]"}]}]}]}], ";"}]], "Input",
 CellID->1650059156,ExpressionUUID->"853e05b7-d2ff-4bff-b680-e98ef03a1151"],

Cell[TextData[{
 "List the levels and their multiplicities at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2da4f150-a1ab-4330-b69f-defbca3bf26d"],
 "."
}], "Text",
 CellID->1925022605,ExpressionUUID->"6a36e2be-1d97-43c9-b42e-66928254cd11"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"spectrum", "[", "2", "]"}]], "Input",
 CellID->192781458,ExpressionUUID->"71d2bc69-4793-47cd-95d7-111e27b51ec8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"0", "\[Rule]", "4"}], ",", 
   RowBox[{
    RowBox[{"4", " ", "c"}], "\[Rule]", "48"}], ",", 
   RowBox[{
    RowBox[{"8", " ", "c"}], "\[Rule]", "152"}], ",", 
   RowBox[{
    RowBox[{"12", " ", "c"}], "\[Rule]", "48"}], ",", 
   RowBox[{
    RowBox[{"16", " ", "c"}], "\[Rule]", "4"}]}], "}"}]], "Output",ExpressionU\
UID->"8018ad73-19f5-4cb0-bece-5744a1dd8f10"]
}, Open  ]],

Cell["\<\
Compare them with exact diagonalization of the eight-qubit Hamiltonian.\
\>", "Text",
 CellID->366821624,ExpressionUUID->"1ed85937-499c-4d3d-b666-e87291874da0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", "[", 
   RowBox[{"Tally", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", 
      RowBox[{"Normal", "[", "h0", "]"}], "]"}], " ", "+", " ", "8"}], "]"}], 
   "]"}], " ", "===", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"spectrum", "[", "2", "]"}], " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"e_", " ", "->", " ", "d_"}], ")"}], " ", ":>", " ", 
       RowBox[{"{", 
        RowBox[{"e", ",", " ", "d"}], "}"}]}], "}"}]}], " ", "/.", " ", 
    RowBox[{"c", " ", "->", " ", "1"}]}], ")"}]}]], "Input",
 CellID->976188230,ExpressionUUID->"514091ef-88ca-416c-967e-32635dc2683c"],

Cell[BoxData["True"], "Output",ExpressionUUID->"3377e9c7-2438-4ff0-ab0d-4dfd2b8504d8"]
}, Open  ]],

Cell[TextData[{
 "Verify that the multiplicities add up to the full Hilbert-space dimension \
",
 Cell[BoxData[
  SuperscriptBox["4", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ca6cbaf6-cbe5-4de2-a0f0-00363d34fb94"],
 " for symbolic ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", 
   SuperscriptBox[
    StyleBox["L", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a678a976-b07a-4b8e-ac6c-9686e783fabc"],
 "."
}], "Text",
 CellID->930350491,ExpressionUUID->"9b07500b-3a87-4b4d-b4c2-e9a463a1dc19"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"4", " ", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"Binomial", "[", 
        RowBox[{"n", ",", " ", 
         RowBox[{"2", " ", "j"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "0", ",", " ", 
         RowBox[{"Floor", "[", 
          RowBox[{"n", "/", "2"}], "]"}]}], "}"}]}], "]"}], "^", "2"}]}], ",",
    " ", 
   RowBox[{"Element", "[", 
    RowBox[{"n", ",", " ", "PositiveIntegers"}], "]"}]}], "]"}]], "Input",
 CellID->1438815762,ExpressionUUID->"3b17286b-74af-4c69-a3d7-3d8dc3ff640a"],

Cell[BoxData[
 SuperscriptBox["4", "n"]], "Output",ExpressionUUID->"7d4d524c-0b5d-4531-9395-ba6558bb5e9e"]
}, Open  ]],

Cell[TextData[{
 "The first excited level costs ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5681ec19-fd12-435a-9b76-96fbd3e395d1"],
 ": the energy gap. QuantumFramework's QEC layer gives a second, independent \
description of the same code, from six independent checks (two of the eight \
are products of the others)."
}], "Text",
 CellID->188722974,ExpressionUUID->"84833eac-65fd-4c26-9746-c2a18b8ab79c"],

Cell["Build the code from six independent checks.", "Text",
 CellID->1366133719,ExpressionUUID->"ee75a3c9-60de-4dd8-b0e6-2456b8341814"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qec2", " ", "=", " ", 
   RowBox[{"QECCode", "[", 
    RowBox[{"label", " ", "/@", " ", 
     RowBox[{"Delete", "[", 
      RowBox[{"checks2", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "4", "}"}], ",", " ", 
         RowBox[{"{", "8", "}"}]}], "}"}]}], "]"}]}], "]"}]}], ";"}]], "Input",\

 CellID->1883140676,ExpressionUUID->"ab02115a-fd81-48ac-80e4-819c147a64af"],

Cell["\<\
Read off its parameters: physical qubits, stored qubits, and distance (the \
fewest qubits an undetectable error must touch).\
\>", "Text",
 CellID->585028959,ExpressionUUID->"8ae67d07-1dee-46e5-a4c1-5bbf5f5a7990"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"qec2", "[", "\"\<Parameters\>\"", "]"}]], "Input",
 CellID->1143153712,ExpressionUUID->"f7f1871e-1b09-4126-ba3d-641a5ce19538"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"8", ",", "2", ",", "2"}], "}"}]], "Output",ExpressionUUID->\
"cb354e08-062b-4553-a524-1601b2be559f"]
}, Open  ]],

Cell[TextData[{
 "Compare its projector onto the protected space with the ground space of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fdccfa8-09b0-419f-8265-bac9823cc076"],
 "."
}], "Text",
 CellID->1913298502,ExpressionUUID->"828ea0ac-89c3-47db-a07f-b8cc6a1d48bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"zeroQ", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Transpose", "[", "ground", "]"}], " ", ".", " ", "ground"}], " ",
    "-", " ", 
   RowBox[{
    RowBox[{"qec2", "[", "\"\<Codespace\>\"", "]"}], "[", "\"\<Matrix\>\"", 
    "]"}]}], "]"}]], "Input",
 CellID->1057991137,ExpressionUUID->"5a8f20ad-9882-4097-9780-aea649473d72"],

Cell[BoxData["True"], "Output",ExpressionUUID->"ebd1f878-a4b8-413c-b8d4-60fa442091bf"]
}, Open  ]],

Cell["\<\
The two descriptions agree, and the code is the preprint's: eight qubits, two \
stored qubits, distance two ([1], supplementary Sec. S1).\
\>", "Text",
 CellID->610348239,ExpressionUUID->"926a4b12-9aba-4c45-95a6-785c9c6fd639"],

Cell[TextData[{
 "One convention matters below. The checks above put ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["X", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4d1c7d8-934e-4451-bdfa-121edf397401"],
 " on stars and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Z", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "068860bd-7339-4df0-a38e-bfa8778d4a64"],
 " on plaquettes. This is the usual form of the toric code, called CSS after \
Calderbank, Shor and Steane, and \"the code's axes\" means this form. The \
preprint's circuit produces ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["X", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6fe9ce5-62ac-4bdc-881a-7bf66664e518"],
 " on stars and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["Y", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c78a489-d455-49e7-8a00-cbe1dd4bcde9"],
 " on plaquettes, and a fixed rotation of every qubit maps one form to the \
other ([1], supplementary Table S1). We use ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["X", "TI"], "^"], "\[Function]", 
   OverscriptBox[
    StyleBox["X", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cea560d3-94f4-4baf-be5b-5c711669f04b"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["Y", "TI"], "^"], "\[Function]", 
   OverscriptBox[
    StyleBox["Z", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "637a8dc5-570b-4e7f-ba42-0ec64525aec3"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["Z", "TI"], "^"], "\[Function]", "-", 
   OverscriptBox[
    StyleBox["Y", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5ee8c9f-a85d-4d40-b700-28ca9f9ba349"],
 ". So a term written in the circuit's axes must be rotated before we ask \
what it does to the stored qubits."
}], "Text",
 CellID->1907071850,ExpressionUUID->"36f62860-2237-4ada-a1e6-2929268401d1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Logical and Detectable Terms", "Subsection",
 CellID->665556308,ExpressionUUID->"a5f5b2a3-3427-4a14-ac1d-f882f3195b90"],

Cell["\<\
Find all logical Pauli products that act on at most two qubits.\
\>", "Text",
 CellID->1841553427,ExpressionUUID->"39e95fc2-fb2f-4637-a38d-0f4425801c5c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"lowWeight", "[", 
    RowBox[{"n_", ",", " ", "w_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Catenate", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"q", ",", "\n", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"Thread", "[", 
              RowBox[{"q", " ", "->", " ", 
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}], ",", 
             " ", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"q", " ", "+", " ", "n"}], ")"}], " ", "->", " ", 
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], 
            "]"}], ",", " ", 
           RowBox[{"2", " ", "n"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", 
          RowBox[{"Length", "[", "q", "]"}]}], "]"}]}]}], "]"}], " ", "/@", 
     "\n", "    ", 
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{"Range", "[", "n", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "w"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"logicals2", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"lowWeight", "[", 
      RowBox[{"8", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"qec2", "[", 
       RowBox[{"\"\<LogicalPauliQ\>\"", ",", " ", 
        RowBox[{"label", "[", "#", "]"}]}], "]"}], " ", "&"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"label", " ", "/@", " ", "logicals2"}]}], "Input",
 CellID->1677045356,ExpressionUUID->"e8a2e58f-f353-4fbd-8cde-498d45b27f2f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"ZZIIIIII\"\>", ",", "\<\"XIIIXIII\"\>", 
   ",", "\<\"IXIIIXII\"\>", ",", "\<\"IIXXIIII\"\>", ",", "\<\"IIZIIIZI\"\>", 
   ",", "\<\"IIIZIIIZ\"\>", ",", "\<\"IIIIZZII\"\>", 
   ",", "\<\"IIIIIIXX\"\>"}], "}"}]], "Output",ExpressionUUID->"1aa2de70-2128-\
45da-811f-d17535465131"]
}, Open  ]],

Cell[TextData[{
 "Each ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["Z", "TI"], "^"], 
   OverscriptBox[
    StyleBox["Z", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b00f481-1205-4a27-be78-55255ca0ac41"],
 " pair sits on the two qubits shared by two stars, and each ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["X", "TI"], "^"], 
   OverscriptBox[
    StyleBox["X", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03fd81e5-7bba-4727-8401-4b5c84112756"],
 " pair on the two shared by two plaquettes. So a term produced jointly by \
two couplers of the same type can be logical. The preprint's audit of coupler \
pairs finds its largest coefficients in exactly such same-type pairs ([1], \
supplementary Table S3), but it does not say which Pauli products they \
multiply."
}], "Text",
 CellID->276547391,ExpressionUUID->"0ba2752f-eeaa-4260-8fc3-b4f9dc2586b9"],

Cell[TextData[{
 "This danger is special to the smallest torus. On a ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fedbb965-7ea7-44dc-ac7d-8224d3ae75a0"],
 " torus two stars share two qubits only because the lattice wraps around. \
From ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b51b5a75-a390-4612-8734-977691d04655"],
 " on they share at most one."
}], "Text",
 CellID->1758126758,ExpressionUUID->"bd1cc466-8d60-49dc-b9e2-2e8c519c6c12"],

Cell[TextData[{
 "Build the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["L", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a05bb865-ef0e-47ae-9fd7-aaba2eb87f15"],
 " code."
}], "Text",
 CellID->1695054173,ExpressionUUID->"47ea4443-c026-44c7-a5c3-3228e46a606b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"toricCSS", "[", "L_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"2", " ", 
         RowBox[{"L", "^", "2"}]}]}], ",", " ", 
       RowBox[{"sp", " ", "=", " ", 
        RowBox[{"toricChecks", "[", "L", "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"QECCode", "[", 
      RowBox[{"\"\<CSS\>\"", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{"SparseArray", "[", 
            RowBox[{
             RowBox[{"Thread", "[", 
              RowBox[{"#", " ", "->", " ", "1"}], "]"}], ",", " ", "n"}], 
            "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"Most", "[", 
          RowBox[{"sp", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{"SparseArray", "[", 
            RowBox[{
             RowBox[{"Thread", "[", 
              RowBox[{"#", " ", "->", " ", "1"}], "]"}], ",", " ", "n"}], 
            "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"Most", "[", 
          RowBox[{"sp", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "]"}], "]"}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"code3", " ", "=", " ", 
   RowBox[{"toricCSS", "[", "3", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"a684711c-ccd7-4732-9510-bdfd45d15c8a"],

Cell["\<\
List its logical Pauli products that act on at most two qubits.\
\>", "Text",
 CellID->947853736,ExpressionUUID->"3cd1d6c1-25f4-45b5-9439-3a31267c02d5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Select", "[", 
