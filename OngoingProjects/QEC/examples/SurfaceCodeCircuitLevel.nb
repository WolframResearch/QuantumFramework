Cell["\<\
Neither rate has a linear term: every single fault, in a CNOT or in a \
readout, is corrected. With readout errors alone the first decoder fails \
exactly when two or more of the eight readings are wrong, while maximum \
likelihood recognizes every two and every three wrong readings and first \
fails at four:\
\>", "Text",ExpressionUUID->"c90faba7-f936-490f-87a4-3d5ad11c6476"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"single", " ", "/.", " ", 
       RowBox[{"pC", " ", "->", " ", "0"}]}], ")"}], " ", "-", " ", 
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", "pM"}], ")"}], "^", "8"}], " ", "-", " ", 
       RowBox[{"8", " ", "pM", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "pM"}], ")"}], "^", "7"}]}]}], ")"}]}], 
    "]"}], ",", " ", 
   RowBox[{"Factor", "[", 
    RowBox[{"ml", " ", "/.", " ", 
     RowBox[{"pC", " ", "->", " ", "0"}]}], "]"}]}], "}"}]], "Input",Expressio\
nUUID->"b8b95e80-e54a-4eaf-9709-1999b5bbbd36"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{
    SuperscriptBox["pM", "4"], " ", 
    RowBox[{"(", 
     RowBox[{"2", "-", 
      RowBox[{"3", " ", "pM"}], "+", 
      SuperscriptBox["pM", "2"], "+", 
      SuperscriptBox["pM", "4"]}], ")"}]}]}], "}"}]], "Output",ExpressionUUID->\
"ee1118f8-3611-48c0-bcb7-9969e4f1f1ec"]
}, Open  ]],

Cell["\<\
The single-fault polynomial is the one surface-code.nb computes. Maximum \
likelihood has the leading terms of that notebook's second decoder, which \
knew every pair of faults, (2438/45) pC^2 + pC pM/5, and is lower still, \
since it also uses the combinations of three and more. The two rates at p = \
1/1000 and p = 1/100:\
\>", "Text",ExpressionUUID->"51a0ffc0-da39-4cbc-917f-2bb05a9d5027"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p0", ",", " ", 
         RowBox[{"N", "[", 
          RowBox[{"single", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"pC", " ", "->", " ", "p0"}], ",", " ", 
             RowBox[{"pM", " ", "->", " ", "p0"}]}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"N", "[", 
          RowBox[{"ml", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"pC", " ", "->", " ", "p0"}], ",", " ", 
             RowBox[{"pM", " ", "->", " ", "p0"}]}], "}"}]}], "]"}]}], "}"}], 
       ",", " ", 
       RowBox[{"{", 
        RowBox[{"p0", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "1000"}], ",", " ", 
           RowBox[{"1", "/", "100"}]}], "}"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<p\>\"", ",", " ", "\"\<single faults\>\"", ",", 
       " ", "\"\<maximum likelihood\>\""}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]], "Input",ExpressionUUID->\
"748f8b8f-1fe3-4f92-a41f-0406e469fc50"],

