Cell["The faults", "Section",ExpressionUUID->"d4d64786-2fe5-4bc7-9272-5974bbeca966"],

Cell["\<\
After each CNOT one of the 15 two-qubit Paulis other than the identity \
strikes, each with probability pC/15, and each ancilla readout is flipped \
with probability pM; one-qubit gates and waiting qubits do not err. The round \
is followed by a perfect measurement of all eight checks and of the logical \
operators. A detector is a check's reading in the round, or its change at \
that final measurement: both are 0 when nothing goes wrong.\
\>", "Text",ExpressionUUID->"3c177d90-7d90-45fd-a9b2-942832e97d43"],

Cell["\<\
QECDetectorModel carries every fault through the circuit at once, each one a \
bit of the same wide integers, as Stim's frame simulator does, and records \
the detectors it fires and the logical operators it flips. Faults that fire \
nothing and flip nothing are left out:\
\>", "Text",ExpressionUUID->"4aa0fa2b-7463-447f-b6d4-3c4b0e3306ad"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"noise", " ", "=", " ", 
   RowBox[{"QECNoiseModel", "[", 
    RowBox[{"\"\<Circuit\>\"", "[", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<TwoQubit\>\"", " ", "->", " ", "pC"}], ",", " ", 
       RowBox[{"\"\<Measurement\>\"", " ", "->", " ", "pM"}]}], "|>"}], "]"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tModel", ",", " ", "dem"}], "}"}], " ", "=", " ", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"QECDetectorModel", "[", 
     RowBox[{"code", ",", " ", "noise", ",", " ", "1"}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"tModel", ",", " ", 
   RowBox[{"dem", "[", "\"\<Faults\>\"", "]"}], ",", " ", 
   RowBox[{"dem", "[", "\"\<Detectors\>\"", "]"}], ",", " ", 
   RowBox[{"dem", "[", "\"\<Observables\>\"", "]"}]}], "}"}]}], "Input",Expres\
sionUUID->"add064ec-3e00-44f5-a483-46b760a2b131"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.012775`", ",", "352", ",", "16", ",", "2"}], "}"}]], "Output",Exp\
ressionUUID->"e2c03707-a266-49e6-ade9-ad28fcca638a"]
}, Open  ]],

Cell["\<\
352 faults (24 CNOTs \[Times] 15 Paulis and 8 readouts, less the 16 that do \
nothing), 16 detectors, and both logical operators. Counted by how many \
detectors they fire and by how many of them flip a logical operator:\
\>", "Text",ExpressionUUID->"aaac30c9-84ad-4667-bf28-b3f5ef5b4576"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rows", " ", "=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dem", "[", "\"\<DetectorMatrix\>\"", "]"}], ",", " ", 
        RowBox[{"dem", "[", "\"\<ObservableMatrix\>\"", "]"}]}], "}"}], 
      "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", " ", 
             RowBox[{"Length", "[", "#2", "]"}], ",", " ", 
             RowBox[{"Count", "[", 
              RowBox[{
               RowBox[{"#2", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"___", ",", " ", "1", ",", " ", "___"}], "}"}]}], 
              "]"}]}], "}"}], " ", "&"}], ",", " ", 
          RowBox[{"KeySort", "[", 
           RowBox[{"GroupBy", "[", 
            RowBox[{"rows", ",", " ", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{"First", "[", "#", "]"}], "]"}], " ", "&"}]}], "]"}], 
           "]"}]}], "]"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"\"\<detectors fired\>\"", ",", " ", "\"\<faults\>\"", ",", 
          " ", "\"\<of which flip a logical\>\""}], "}"}]}], "]"}], "]"}], ",",
      " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"FrameStyle", " ", "->", " ", 
      RowBox[{"GrayLevel", "[", "0.8", "]"}]}], ",", " ", 
     RowBox[{"Background", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"GrayLevel", "[", "0.93", "]"}], ",", " ", "None"}], "}"}], 
       "}"}]}]}], "]"}]}], "]"}]], "Input",ExpressionUUID->"27647d3e-e1d7-\
480b-8d75-dd58dac78ba3"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"detectors fired\"\>", "1", "2", "3", "4"},
    {"\<\"faults\"\>", "72", "144", "88", "48"},
    {"\<\"of which flip a logical\"\>", "32", "38", "36", "34"}
   },
   AutoDelete->False,
   FrameStyle->GrayLevel[0.8],
   GridBoxBackground->{"Columns" -> {
       GrayLevel[0.93], None}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"a2524d95-2c74-430d-b9a8-cd4db5e86561"]
}, Open  ]],

Cell["Two decoders, exactly", "Section",ExpressionUUID->"bcc5cf55-51a8-4987-9e4f-059beb85e05a"],

Cell["\<\
The first decoder knows the pattern of every single fault, undoes that fault, \
and counts any other pattern as a failure; it is QECLogicalErrorRate's \
default for a detector model. The second is maximum likelihood: for every \
pattern of the 16 detectors it applies the logical correction that is most \
probable given that pattern, over all combinations of faults, not only pairs. \
No decoder that reads these detectors does better. Its table is chosen at pC \
= pM = 1/1000 and then used at every rate. Both rates are exact polynomials \
in pC and pM:\
\>", "Text",ExpressionUUID->"af67f8cb-fa0b-4b9f-93f9-f0f70feb0d6d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tSingle", ",", " ", "single"}], "}"}], " ", "=", " ", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"QECLogicalErrorRate", "[", 
     RowBox[{"code", ",", " ", "noise", ",", " ", 
      RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tML", ",", " ", "ml"}], "}"}], " ", "=", " ", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"QECLogicalErrorRate", "[", 
     RowBox[{"code", ",", " ", "noise", ",", " ", 
      RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<Decoder\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<MaximumLikelihood\>\"", ",", " ", 
         RowBox[{"1", "/", "1000"}]}], "}"}]}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"tSingle", ",", " ", "tML"}], "}"}]}], "Input",ExpressionUUID->\
"f8994fd3-ea79-4e0e-b909-2d4546c462fe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.145189`", ",", "0.205621`"}], "}"}]], "Output",ExpressionUUID->\
"2d0d1c6a-4dd8-49de-8c27-e7c04902635c"]
}, Open  ]],

Cell["\<\
Their leading terms, and where each crosses PL = p when pC = pM = p:\
\>", "Text",ExpressionUUID->"db5cf706-68e7-444b-9a41-94a54de811cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"surfLead", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Expand", "[", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{"#", " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pC", " ", "->", " ", 
             RowBox[{"t", " ", "pC"}]}], ",", " ", 
            RowBox[{"pM", " ", "->", " ", 
             RowBox[{"t", " ", "pM"}]}]}], "}"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], "]"}], 
      " ", "/.", " ", 
      RowBox[{"t", " ", "->", " ", "1"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
   RowBox[{"{", 
    RowBox[{"single", ",", " ", "ml"}], "}"}]}]}]], "Input",ExpressionUUID->\
"7e7b3ba4-f8a4-46f0-a44a-4bbf926bc7db"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"48326", " ", 
      SuperscriptBox["pC", "2"]}], "225"], "+", 
    FractionBox[
     RowBox[{"2213", " ", "pC", " ", "pM"}], "15"], "+", 
    RowBox[{"28", " ", 
     SuperscriptBox["pM", "2"]}]}], ",", 
   RowBox[{
    FractionBox[
     RowBox[{"2438", " ", 
      SuperscriptBox["pC", "2"]}], "45"], "+", 
    FractionBox[
     RowBox[{"pC", " ", "pM"}], "5"]}]}], "}"}]], "Output",ExpressionUUID->\
"2f7c2213-2864-45af-bdeb-d89648bbd32a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"surfCross", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"First", "[", 
      RowBox[{"SolveValues", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#", " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"pC", " ", "->", " ", "p"}], ",", " ", 
              RowBox[{"pM", " ", "->", " ", "p"}]}], "}"}]}], ")"}], " ", "==",
           " ", "p"}], " ", "&&", " ", 
         RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", 
          RowBox[{"1", "/", "10"}]}]}], ",", " ", "p", ",", " ", "Reals"}], 
       "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"single", ",", " ", "ml"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"N", "[", "surfCross", "]"}]}], "Input",ExpressionUUID->"2d0eaa58-\
ab90-4d96-82b8-2d66f1d29fa3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.002690186954013614`", ",", "0.020456260130222836`"}], 
  "}"}]], "Output",ExpressionUUID->"530288fa-dc8d-41ea-8a26-a47372767ccc"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"surfPlot", " ", "=", " ", 
  RowBox[{"LogLogPlot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"single", ",", " ", "ml"}], "}"}], " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"pC", " ", "->", " ", "p"}], ",", " ", 
          RowBox[{"pM", " ", "->", " ", "p"}]}], "}"}]}], ",", " ", "p"}], 
      "]"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"p", ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "4"}]}], ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "1.5"}]}]}], "}"}], ",", " ", 
    RowBox[{"PlotStyle", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"Automatic", ",", " ", "Automatic", ",", " ", "Dotted"}], 
      "}"}]}], ",", " ", 
    RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
    RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", "\n", "   ", 
    RowBox[{"GridLinesStyle", " ", "->", " ", 
     RowBox[{"Directive", "[", 
      RowBox[{
       RowBox[{"GrayLevel", "[", "0.8", "]"}], ",", " ", "Dashed"}], "]"}]}], 
    ",", " ", 
    RowBox[{"FrameLabel", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<error probability p of each CNOT and each readout  \
(\>\"", ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<p\>\"", ",", " ", "\"\<C\>\""}], "]"}], ",", 
          " ", "\"\< = \>\"", ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<p\>\"", ",", " ", "\"\<M\>\""}], "]"}], ",", 
          " ", "\"\< = p)\>\""}], "}"}], "]"}], ",", " ", 
       RowBox[{"Subscript", "[", 
        RowBox[{"\"\<P\>\"", ",", " ", "\"\<L\>\""}], "]"}]}], "}"}]}], ",", 
    " ", 
    RowBox[{"ImageSize", " ", "->", " ", "480"}], ",", "\n", "   ", 
    RowBox[{"PlotLegends", " ", "->", " ", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<decoder knows single faults\>\"", ",", 
         " ", "\"\<maximum likelihood\>\"", ",", " ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<P\>\"", ",", " ", "\"\<L\>\""}], "]"}], ",", 
            " ", "\"\< = p\>\""}], "}"}], "]"}]}], "}"}], ",", " ", "Below"}],
       "]"}]}], ",", "\n", "   ", 
    RowBox[{"PlotLabel", " ", "->", " ", 
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"#1", ",", " ", "\"\<:  \>\"", ",", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<P\>\"", ",", " ", "\"\<L\>\""}], "]"}], ",", 
             " ", "\"\< = \>\"", ",", " ", 
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"#2", " ", "/.", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"pC", " ", "->", " ", 
                  RowBox[{"Subscript", "[", 
                   RowBox[{"\"\<p\>\"", ",", " ", "\"\<C\>\""}], "]"}]}], ",",
                  " ", 
                 RowBox[{"pM", " ", "->", " ", 
                  RowBox[{"Subscript", "[", 
                   RowBox[{"\"\<p\>\"", ",", " ", "\"\<M\>\""}], "]"}]}]}], 
                "}"}]}], "]"}], ",", " ", "\"\< + \[Ellipsis],   \>\"", ",", 
             " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<P\>\"", ",", " ", "\"\<L\>\""}], "]"}], ",", 
             " ", "\"\< < p  for  p < \>\"", ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"N", "[", "#3", "]"}], ",", " ", "3"}], "]"}]}], "}"}],
            "]"}], " ", "&"}], ",", "\n", "      ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            
            RowBox[{"\"\<single faults\>\"", ",", 
             " ", "\"\<maximum likelihood\>\""}], "}"}], ",", " ", "surfLead",
            ",", " ", "surfCross"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}]}]}], 
   "]"}]}]], "Input",ExpressionUUID->"eaface25-3fbc-4e7f-8b79-ad50ea317352"],

