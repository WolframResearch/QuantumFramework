Cell["How the rate is computed", "Section",ExpressionUUID->"2eeb57ca-59d0-4f15-a2b8-ab81de10ee82"],

Cell["\<\
Faults at different locations are independent, and their effects, bit \
patterns over the 16 detectors and the two logical operators, add bit by bit. \
In the Walsh\[Dash]Hadamard transform each location then contributes one \
factor, f(k) = 1 - 2 \[Sum] p_r over the outcomes r that are odd under k, and \
a decoder that fails on the patterns W fails with probability 2^-N \[Sum]_k \
W^(k) \[Product] f(k). At a CNOT either none or exactly eight of the fifteen \
Paulis are odd under k, so its factor is 1 or 1 - 16 pC/15; a readout \
contributes 1 or 1 - 2 pM.\
\>", "Text",ExpressionUUID->"6c4c9d71-8be2-4ad7-832f-b91bd85ade31"],

Cell["\<\
QECLogicalErrorRate does this for any detector model. W^ is the transform of \
a 0/1 vector, an exact integer vector computed in machine arithmetic; the k \
are grouped by how many of each factor they collect, so the symbolic part is \
a short sum of monomials. Maximum likelihood comes from the same machinery \
run the other way: with numeric rates the product of factors is the transform \
of the whole distribution, and one inverse transform gives the probability of \
every pattern. The exact route covers up to $QECExactDetectorLimit patterns:\
\>", "Text",ExpressionUUID->"83db25fe-ef4a-4053-90d7-f6ec3b0a66b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$QECExactDetectorLimit", " ", "==", " ", 
  RowBox[{"2", "^", "24"}]}]], "Input",ExpressionUUID->"1dc37049-7819-4892-\
8321-0f8bd2e94357"],

Cell[BoxData["True"], "Output",ExpressionUUID->"c264c2f7-23d5-49b4-be51-3adaeac4daf8"]
}, Open  ]],

Cell["Past one round and past distance 3", "Section",ExpressionUUID->"7f54f391-fc12-445f-b199-50d0a351c67f"],

Cell["\<\
More rounds multiply the detectors. \"Basis\" -> \"Z\" keeps a memory in one \
basis, the Z-bar observable and the detectors of the Z checks; on a CSS code \
that is an exact marginal of the full model, and it halves the bits. Rounds 1 \
to 4 of the distance-3 code, exactly, under pC = pM = p, with the time each \
takes and the leading term:\
\>", "Text",ExpressionUUID->"62fe3795-8baf-417e-98f5-0cf97416941f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n", " ", "=", " ", 
           RowBox[{"QECNoiseModel", "[", 
            RowBox[{"\"\<Circuit\>\"", "[", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<TwoQubit\>\"", " ", "->", " ", "p"}], ",", " ", 
               RowBox[{"\"\<Measurement\>\"", " ", "->", " ", "p"}]}], "|>"}],
              "]"}], "]"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"t", ",", " ", "r"}], "}"}], ",", "\n", "     ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"t", ",", " ", "r"}], "}"}], " ", "=", " ", 
             RowBox[{"AbsoluteTiming", "[", 
              RowBox[{"QECLogicalErrorRate", "[", 
               RowBox[{"code", ",", " ", "n", ",", " ", 
                RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "rounds"}], ",", 
                " ", 
                RowBox[{"\"\<Basis\>\"", " ", "->", " ", "\"\<Z\>\""}], ",", 
                " ", 
                RowBox[{"\"\<Decoder\>\"", " ", "->", " ", 
                 RowBox[{"{", 
                  RowBox[{"\"\<MaximumLikelihood\>\"", ",", " ", 
                   RowBox[{"1", "/", "1000"}]}], "}"}]}]}], "]"}], "]"}]}], ";",
             "\n", "     ", 
            RowBox[{"{", 
             RowBox[{"rounds", ",", " ", 
              RowBox[{"Round", "[", 
               RowBox[{"t", ",", " ", "0.01"}], "]"}], ",", " ", 
              RowBox[{"Normal", "[", 
               RowBox[{"Series", "[", 
                RowBox[{"r", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"p", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}],
                "]"}]}], "}"}]}]}], "]"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"rounds", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"\"\<rounds\>\"", ",", " ", "\"\<seconds\>\"", ",", 
       " ", "\"\<leading term\>\""}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]], "Input",ExpressionUUID->\
"a9bcc612-1679-4e77-9ab1-95f49e751850"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"rounds\"\>", "\<\"seconds\"\>", "\<\"leading term\"\>"},
    {"1", "0.04`", 
     FractionBox[
      RowBox[{"2932", " ", 
       SuperscriptBox["p", "2"]}], "75"]},
    {"2", "0.21`", 
     FractionBox[
      RowBox[{"31132", " ", 
       SuperscriptBox["p", "2"]}], "225"]},
    {"3", "0.62`", 
     FractionBox[
      RowBox[{"6348", " ", 
       SuperscriptBox["p", "2"]}], "25"]},
    {"4", "2.42`", 
     FractionBox[
      RowBox[{"83108", " ", 
       SuperscriptBox["p", "2"]}], "225"]}
   },
   AutoDelete->False,
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"c8d63178-d6b1-4aa0-9656-a073dd8cf845"]
}, Open  ]],

Cell["\<\
One round of the distance-5 code in one basis is 25 bits, 2^25 patterns, past \
the default limit, which is raised for this one call. The leading power is \
p^3, as distance 5 requires (this step needs about 3 GB of memory):\
\>", "Text",ExpressionUUID->"b318c32d-c759-414c-a90a-e99a4b694501"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t5", ",", " ", "d5"}], "}"}], " ", "=", " ", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"$QECExactDetectorLimit", " ", "=", " ", 
        RowBox[{"2", "^", "25"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"QECLogicalErrorRate", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", 
         RowBox[{"\"\<Surface\>\"", "[", "5", "]"}], "]"}], ",", " ", 
        RowBox[{"QECNoiseModel", "[", 
         RowBox[{"\"\<Circuit\>\"", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<TwoQubit\>\"", " ", "->", " ", "p"}], ",", " ", 
            RowBox[{"\"\<Measurement\>\"", " ", "->", " ", "p"}]}], "|>"}], 
          "]"}], "]"}], ",", "\n", "     ", 
        RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"\"\<Basis\>\"", " ", "->", " ", "\"\<Z\>\""}], ",", " ", 
        RowBox[{"\"\<Decoder\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<MaximumLikelihood\>\"", ",", " ", 
           RowBox[{"1", "/", "1000"}]}], "}"}]}]}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"t5", ",", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{"d5", ",", " ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], 
  "}"}]}], "Input",ExpressionUUID->"0f34040e-6438-453f-babf-c1e4b0766b90"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"15.776678`", ",", 
   FractionBox[
    RowBox[{"42320", " ", 
     SuperscriptBox["p", "3"]}], "27"]}], "}"}]], "Output",ExpressionUUID->\
"7930fc37-ef21-486e-8ea8-3876fd24f9b4"]
}, Open  ]],

Cell["\<\
Past the exact route the rate is sampled. The sampled rate agrees with the \
exact one where both exist:\
\>", "Text",ExpressionUUID->"0e96a111-2d50-4714-bf4f-d8654fbb9324"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "2026", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"QECNoiseModel", "[", 
      RowBox[{"\"\<Circuit\>\"", "[", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<TwoQubit\>\"", " ", "->", " ", 
          RowBox[{"1", "/", "50"}]}], ",", " ", 
         RowBox[{"\"\<Measurement\>\"", " ", "->", " ", 
          RowBox[{"1", "/", "50"}]}]}], "|>"}], "]"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"QECLogicalErrorRate", "[", 
      RowBox[{"code", ",", " ", "n", ",", " ", "50000", ",", " ", 
       RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"\"\<Basis\>\"", " ", "->", " ", "\"\<Z\>\""}], ",", " ", 
       RowBox[{"\"\<Decoder\>\"", " ", "->", 
        " ", "\"\<MaximumLikelihood\>\""}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"N", "[", 
      RowBox[{"QECLogicalErrorRate", "[", 
       RowBox[{"code", ",", " ", "n", ",", " ", 
        RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"\"\<Basis\>\"", " ", "->", " ", "\"\<Z\>\""}], ",", " ", 
        RowBox[{"\"\<Decoder\>\"", " ", "->", 
         " ", "\"\<MaximumLikelihood\>\""}]}], "]"}], "]"}]}], "}"}]}], 
  "]"}]}], "Input",ExpressionUUID->"cc1bee86-2dcb-4fcf-b06a-fa30b8009de0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.01274`", ",", "0.013332380983199802`"}], "}"}]], "Output",Express\
ionUUID->"b1f6a041-eaa0-4530-8949-cc58b198553a"]
}, Open  ]],

Cell["\<\
The standard memory experiment, d noisy rounds of the distance-d code, \
decoded by matching, 20000 shots each at p = 3/1000. The time includes \
building the detector model:\
\>", "Text",ExpressionUUID->"0596573f-6705-4593-a0a5-9432ade974a9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "2026", "]"}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n", " ", "=", " ", 
           RowBox[{"QECNoiseModel", "[", 
            RowBox[{"\"\<Circuit\>\"", "[", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<TwoQubit\>\"", " ", "->", " ", 
                RowBox[{"3", "/", "1000"}]}], ",", " ", 
               RowBox[{"\"\<Measurement\>\"", " ", "->", " ", 
                RowBox[{"3", "/", "1000"}]}]}], "|>"}], "]"}], "]"}]}], "}"}],
          ",", "\n", "    ", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"t", ",", " ", "r"}], "}"}], ",", "\n", "     ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"t", ",", " ", "r"}], "}"}], " ", "=", " ", 
             RowBox[{"AbsoluteTiming", "[", 
              RowBox[{"QECLogicalErrorRate", "[", 
               RowBox[{
                RowBox[{"QECCode", "[", 
                 RowBox[{"\"\<Surface\>\"", "[", "d", "]"}], "]"}], ",", " ", 
                "n", ",", " ", "20000", ",", " ", 
                RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "d"}], ",", " ", 
                RowBox[{"\"\<Basis\>\"", " ", "->", " ", "\"\<Z\>\""}], ",", 
                " ", 
                
                RowBox[{"\"\<Decoder\>\"", " ", "->", 
                 " ", "\"\<Matching\>\""}]}], "]"}], "]"}]}], ";", "\n", 
            "     ", 
            RowBox[{"{", 
             RowBox[{"d", ",", " ", 
              RowBox[{"Round", "[", 
               RowBox[{"t", ",", " ", "0.1"}], "]"}], ",", " ", "r"}], 
             "}"}]}]}], "]"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"d", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "5", ",", " ", "7"}], "}"}]}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<d = rounds\>\"", ",", " ", "\"\<seconds\>\"", ",", 
       " ", "\"\<logical error rate per experiment\>\""}], "}"}]}], "]"}], ",",
    " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}], "Input",ExpressionUUID\
->"9b55f9b9-f7dc-4917-a6b0-270d31a176b1"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"d = rounds\"\>", "\<\"seconds\"\>", "\<\"logical error rate per \
experiment\"\>"},
    {"3", "0.2`", "0.0021`"},
    {"5", "3.`", "0.0007`"},
    {"7", "15.8`", "0.00025`"}
   },
   AutoDelete->False,
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"a3c314d0-5c07-44c7-a093-942eac0600c7"]
}, Open  ]],

Cell["\<\
The logical error rate falls with the distance at this p, which is below the \
threshold of the circuit.\
\>", "Text",ExpressionUUID->"4d1d9431-990b-4bd9-99b7-14ca61abaf40"]
},
