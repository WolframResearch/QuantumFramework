 RowBox[{
  RowBox[{"$repo", " ", "=", " ", 
   RowBox[{"Quiet", " ", "@", " ", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"ParentDirectory", "[", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", "3"}], "]"}], ",", 
      " ", "\"\</Users/mauriceengelhard/Documents/REPOS/QuantumFramework\>\""}\
], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"PacletDirectoryLoad", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"$repo", ",", " ", "\"\<QuantumFramework\>\""}], "}"}], "]"}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
     "$repo", ",", " ", "\"\<OngoingProjects\>\"", ",", " ", "\"\<QEC\>\"", ",",
       " ", "\"\<QECCore\>\"", ",", " ", "\"\<QECCore.wl\>\""}], "}"}], "]"}],
    "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`QEC`\>\"", "]"}], 
  ";"}]}], "Input",ExpressionUUID->"9cc8c402-003c-4304-a95a-b40a8d37503d"],

Cell["The code and its extraction circuit", "Section",ExpressionUUID->"373319fb-3627-44c6-b4a1-05186e3e4b49"],

Cell["\<\
QECCode[\"Surface\"[3]] is the code of the question. Its parameters [[n, k, \
d]], its eight checks, and the order in which each check's CNOTs touch its \
data qubits (X checks row by row, Z checks column by column):\
\>", "Text",ExpressionUUID->"1cb0ace0-d8c1-432b-b422-180a64276ce2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"code", " ", "=", " ", 
   RowBox[{"QECCode", "[", 
    RowBox[{"\"\<Surface\>\"", "[", "3", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"code", "[", "\"\<Parameters\>\"", "]"}], ",", " ", 
   RowBox[{"code", "[", "\"\<Generators\>\"", "]"}], ",", " ", 
   RowBox[{"code", "[", "\"\<CheckOrder\>\"", "]"}]}], "}"}]}], "Input",Expres\
sionUUID->"8504c6b9-082a-42f1-9c1e-8192471bafd0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"9", ",", "1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"IXXIIIIII\"\>", ",", "\<\"XXIXXIIII\"\>", 
     ",", "\<\"IIIIXXIXX\"\>", ",", "\<\"IIIIIIXXI\"\>", 
     ",", "\<\"ZIIZIIIII\"\>", ",", "\<\"IZZIZZIII\"\>", 
     ",", "\<\"IIIZZIZZI\"\>", ",", "\<\"IIIIIZIIZ\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "4", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "6", ",", "8", ",", "9"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"7", ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "5", ",", "3", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "7", ",", "5", ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "9"}], "}"}]}], "}"}]}], "}"}]], "Output",ExpressionUU\
ID->"3bdc0957-488c-4729-a1a5-36002dbe465b"]
}, Open  ]],

Cell["\<\
Each check has its own ancilla, qubits 10 to 17, prepared in |0\
\[RightAngleBracket]. For an X check its data qubits are rotated by H, CNOTs \
copy their parity into the ancilla in the order above, the rotations are \
undone and the ancilla is read. The lattice is drawn from the code's own \
checks; the circuit is the code's \"SyndromeCircuit\", whose instructions \
QuantumCircuitOperator takes as they are:\
\>", "Text",ExpressionUUID->"e9d09d4a-de5c-4379-a01e-d49bf727811c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"surfChecks", " ", "=", " ", 
   RowBox[{"code", "[", "\"\<Generators\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"surfOrder", " ", "=", " ", 
   RowBox[{"code", "[", "\"\<CheckOrder\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"surfXCheckQ", " ", "=", " ", 
   RowBox[{"StringContainsQ", "[", "\"\<X\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"surfPos", "[", "q_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"q", " ", "-", " ", "1"}], ",", " ", "3"}], "]"}], ",", " ", 
     RowBox[{"-", 
      RowBox[{"Quotient", "[", 
       RowBox[{
        RowBox[{"q", " ", "-", " ", "1"}], ",", " ", "3"}], "]"}]}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"surfOut", "[", "qs_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", " ", "=", " ", 
       RowBox[{"Cross", "[", 
        RowBox[{"Subtract", " ", "@@", " ", 
         RowBox[{"(", 
          RowBox[{"surfPos", " ", "/@", " ", "qs"}], ")"}]}], "]"}]}], "}"}], 
     ",", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"v", " ", ".", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{"surfPos", " ", "/@", " ", "qs"}], "]"}], " ", "-", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", 
             RowBox[{"-", "1"}]}], "}"}]}], ")"}]}], " ", ">", " ", "0"}], ",",
        " ", "v", ",", " ", 
       RowBox[{"-", "v"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"surfFace", "[", "qs_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"Mean", "[", 
        RowBox[{"surfPos", " ", "/@", " ", "qs"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "qs", "]"}], " ", "==", " ", "4"}], ",", " ", 
       RowBox[{"Polygon", "[", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"surfPos", " ", "/@", " ", "qs"}], ",", " ", 
          RowBox[{
           RowBox[{"ArcTan", " ", "@@", " ", 
            RowBox[{"(", 
             RowBox[{"#", " ", "-", " ", "c"}], ")"}]}], " ", "&"}]}], "]"}], 
        "]"}], ",", "\n", "    ", 
       RowBox[{"Polygon", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"c", " ", "+", " ", 
           RowBox[{"0.5", " ", 
            RowBox[{
             RowBox[{"RotationMatrix", "[", "a", "]"}], " ", ".", " ", 
             RowBox[{"surfOut", "[", "qs", "]"}]}]}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", 
            RowBox[{
             RowBox[{"-", "Pi"}], "/", "2"}], ",", " ", 
            RowBox[{"Pi", "/", "2"}], ",", " ", 
            RowBox[{"Pi", "/", "24"}]}], "}"}]}], "]"}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"surfLattice", " ", "=", " ", 
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"qs", ",", " ", "check"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"EdgeForm", "[", 
              RowBox[{"GrayLevel", "[", "0.4", "]"}], "]"}], ",", " ", 
             RowBox[{"FaceForm", "[", 
              RowBox[{"Opacity", "[", 
               RowBox[{"0.35", ",", " ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"surfXCheckQ", "[", "check", "]"}], ",", " ", 
                  RowBox[{
                   RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], ",",
                   " ", 
                  RowBox[{
                   RowBox[{"ColorData", "[", "97", "]"}], "[", "2", "]"}]}], 
                 "]"}]}], "]"}], "]"}], ",", " ", 
             RowBox[{"surfFace", "[", "qs", "]"}], ",", "\n", "        ", 
             RowBox[{"Text", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"surfXCheckQ", "[", "check", "]"}], ",", 
                   " ", "\"\<X\>\"", ",", " ", "\"\<Z\>\""}], "]"}], ",", " ",
                  "14", ",", " ", "Bold"}], "]"}], ",", " ", 
               RowBox[{
                RowBox[{"Mean", "[", 
                 RowBox[{"surfPos", " ", "/@", " ", "qs"}], "]"}], " ", "+", 
                " ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "qs", "]"}], " ", "==", " ", "2"}], 
                  ",", " ", 
                  RowBox[{"0.25", " ", 
                   RowBox[{"surfOut", "[", "qs", "]"}]}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", " ", "0"}], "}"}]}], "]"}]}]}], "]"}]}], 
            "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"surfOrder", ",", " ", "surfChecks"}], "}"}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"EdgeForm", "[", "Black", "]"}], ",", " ", "White", ",", 
           " ", 
           RowBox[{"Disk", "[", 
            RowBox[{
             RowBox[{"surfPos", "[", "#", "]"}], ",", " ", "0.13"}], "]"}], ",",
            " ", 
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"#", ",", " ", "11"}], "]"}], ",", " ", 
             RowBox[{"surfPos", "[", "#", "]"}]}], "]"}]}], "}"}], " ", "&"}],
         " ", "/@", " ", 
        RowBox[{"Range", "[", "9", "]"}]}]}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "240"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"surfLattice", ",", " ", 
      RowBox[{
       RowBox[{"QuantumCircuitOperator", "[", 
        RowBox[{
         RowBox[{"code", "[", "\"\<SyndromeCircuit\>\"", "]"}], 
         "[", "\"\<Instructions\>\"", "]"}], "]"}], "[", "\"\<Diagram\>\"", 
       "]"}]}], "}"}], "}"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "4"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}]}], "Input",Express\
ionUUID->"f77e6e20-c7c2-4a9d-9e21-da37f3dc3d5a"],

