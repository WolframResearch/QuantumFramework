Cell["\<\
Loss between two beam splitters: in each probability the two phase terms are \
complex conjugates of each other, so it is visibly real, and the \
probabilities total 1 on the physical domain.\
\>", "Text",
 CellID->1906087345,ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"l2", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<BS\>\"", "[", 
       RowBox[{"th", ",", " ", "ph"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"\"\<Loss\>\"", "[", "eta", "]"}], " ", "->", " ", "1"}], ",", 
      " ", 
      RowBox[{"\"\<BS\>\"", "[", 
       RowBox[{"th2", ",", " ", "ph2"}], "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"l2", "[", 
   RowBox[{"\"\<Probabilities\>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      RowBox[{"QuditName", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", "th", "]"}], "^", "2"}], " ", "-", " ", 
       RowBox[{"eta", " ", 
        RowBox[{
         RowBox[{"Cos", "[", "th", "]"}], "^", "2"}]}]}]}], ",", "\n", 
     "     ", 
     RowBox[{
      RowBox[{"QuditName", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{
       RowBox[{"eta", " ", 
        RowBox[{
         RowBox[{"Cos", "[", "th", "]"}], "^", "2"}], " ", 
        RowBox[{
         RowBox[{"Cos", "[", "th2", "]"}], "^", "2"}]}], " ", "-", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "eta", "]"}], " ", 
        RowBox[{"Cos", "[", "th", "]"}], " ", 
        RowBox[{"Cos", "[", "th2", "]"}], " ", 
        RowBox[{"Sin", "[", "th", "]"}], " ", 
        RowBox[{
         RowBox[{"Sin", "[", "th2", "]"}], "/", 
         RowBox[{"E", "^", 
          RowBox[{"(", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{"ph", " ", "-", " ", "ph2"}], ")"}]}], ")"}]}]}]}], " ", 
       "-", " ", 
       RowBox[{
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"I", " ", "ph"}], " ", "-", " ", 
           RowBox[{"I", " ", "ph2"}]}], ")"}]}], " ", 
        RowBox[{"Sqrt", "[", "eta", "]"}], " ", 
        RowBox[{"Cos", "[", "th", "]"}], " ", 
        RowBox[{"Cos", "[", "th2", "]"}], " ", 
        RowBox[{"Sin", "[", "th", "]"}], " ", 
        RowBox[{"Sin", "[", "th2", "]"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", "th", "]"}], "^", "2"}], " ", 
        RowBox[{
         RowBox[{"Sin", "[", "th2", "]"}], "^", "2"}]}]}]}], ",", "\n", 
     "     ", 
     RowBox[{
      RowBox[{"QuditName", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "th2", "]"}], "^", "2"}], " ", 
        RowBox[{
         RowBox[{"Sin", "[", "th", "]"}], "^", "2"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "eta", "]"}], " ", 
        RowBox[{"Cos", "[", "th", "]"}], " ", 
        RowBox[{"Cos", "[", "th2", "]"}], " ", 
        RowBox[{"Sin", "[", "th", "]"}], " ", 
        RowBox[{
         RowBox[{"Sin", "[", "th2", "]"}], "/", 
         RowBox[{"E", "^", 
          RowBox[{"(", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{"ph", " ", "-", " ", "ph2"}], ")"}]}], ")"}]}]}]}], " ", 
       "+", " ", 
       RowBox[{
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"I", " ", "ph"}], " ", "-", " ", 
           RowBox[{"I", " ", "ph2"}]}], ")"}]}], " ", 
        RowBox[{"Sqrt", "[", "eta", "]"}], " ", 
        RowBox[{"Cos", "[", "th", "]"}], " ", 
        RowBox[{"Cos", "[", "th2", "]"}], " ", 
        RowBox[{"Sin", "[", "th", "]"}], " ", 
        RowBox[{"Sin", "[", "th2", "]"}]}], " ", "+", " ", 
       RowBox[{"eta", " ", 
        RowBox[{
         RowBox[{"Cos", "[", "th", "]"}], "^", "2"}], " ", 
        RowBox[{
         RowBox[{"Sin", "[", "th2", "]"}], "^", "2"}]}]}]}]}], "|>"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Total", "[", 
