Cell[BoxData[{
 RowBox[{
  RowBox[{"lb", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<BS\>\"", "[", "th", "]"}], ",", " ", 
