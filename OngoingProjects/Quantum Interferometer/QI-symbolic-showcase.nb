                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"n3", " ", "-", " ", "n4"}], ")"}], "/", "2"}], ",",
                 " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"-", "2"}], " ", "n1"}], " ", "-", " ", 
                   RowBox[{"2", " ", "n2"}], " ", "-", " ", "n3", " ", "-", 
