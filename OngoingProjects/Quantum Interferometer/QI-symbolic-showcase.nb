Cell[TextData[{
 "A photon number may be any polynomial with rational coefficients in \
photon-number variables: plain symbols, indexed symbols such as ",
 Cell[BoxData[
  RowBox[{"n", "[", "1", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fd1512-f616-8834-3c82-8d5f83a0db1e"],
 ", subscripted ones, formal letters and one-letter system symbols such as ",
 Cell[BoxData["K"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c67103-72a1-9427-0efe-696d0755ff0d"],
 " or ",
 Cell[BoxData["N"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
 ". Each such entry is taken to be a nonnegative integer."
}], "Text",
 CellID->653417278,ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],

