Cell["2. Concrete photon numbers, symbolic parameters", "Section",
 CellID->1541450781,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bs", "[", 
   RowBox[{"\"\<Amplitude\>\"", ",", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "0"}], "}"}]}]}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"Cos", "[", "th", "]"}], " ", 
    RowBox[{
     RowBox[{"Sin", "[", "th", "]"}], "/", 
     RowBox[{"E", "^", 
      RowBox[{"(", 
       RowBox[{"I", " ", "ph"}], ")"}]}]}]}], " ", "*)"}], "\n"}], "\n", 
 RowBox[{"bs", "[", 
  RowBox[{"\"\<Probability\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "th", "]"}], "^", "2"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"Sin", "[", "th", "]"}], "^", "2"}]}], ")"}], "^", "2"}], " ", 
   "*)"}]}]}], "Input",
 CellLabel->"In[14]:= ",
 CellID->1657269721,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

