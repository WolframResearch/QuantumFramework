Cell["An assumed photon-flow relation removes the path condition.", "Text",
 CellID->97201263,ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<BS\>\"", "[", 
        RowBox[{"th1", ",", " ", "ph1"}], "]"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
      RowBox[{
       RowBox[{"\"\<BS\>\"", "[", 
        RowBox[{"th2", ",", " ", "ph2"}], "]"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}]}], "}"}], ",", " ", "3"}], 
   "]"}], "[", 
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n1", ",", " ", "n2", ",", " ", "n3"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "}"}]}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{
     RowBox[{"n1", " ", "+", " ", "n2"}], " ", ">=", " ", "t1"}]}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{
      RowBox[{"n1", " ", "+", " ", "n2", " ", "+", " ", "n3"}], ",", " ", 
      RowBox[{"t1", " ", "+", " ", "t2", " ", "+", " ", "t3"}]}], "]"}], " ", 
    
    RowBox[{"WignerD", "[", "...", "]"}], " ", 
    RowBox[{"WignerD", "[", "...", "]"}]}], " ", "*)"}]}]}], "Input",
 CellLabel->"In[37]:= ",
 CellID->878831761,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

Cell["Restating the physical domain changes nothing.", "Text",
