Cell["Fock input, coherent output.", "Text",
 CellID->437474228,ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"],

Cell[BoxData[{
 RowBox[{"bs", "[", 
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "0"}], "}"}], " ", "->", " ", 
    RowBox[{"\"\<Coherent\>\"", "[", 
     RowBox[{"{", 
      RowBox[{"c", ",", " ", "d"}], "}"}], "]"}]}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"E", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"Abs", "[", "c", "]"}], "^", "2"}]}], " ", "-", " ", 
         RowBox[{
          RowBox[{"Abs", "[", "d", "]"}], "^", "2"}]}], ")"}], "/", "2"}], 
      ")"}]}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", "c", "]"}], " ", 
       RowBox[{"Cos", "[", "th", "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"E", "^", 
        RowBox[{"(", 
         RowBox[{"I", " ", "ph"}], ")"}]}], " ", 
       RowBox[{"Conjugate", "[", "d", "]"}], " ", 
       RowBox[{"Sin", "[", "th", "]"}]}]}], ")"}]}], " ", "*)"}]}]}], "Input",\

 CellLabel->"In[44]:= ",
 CellID->874582697,ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell["\<\
Coherent output from coherent input: the overlap probability is a Gaussian in \
the distance between the amplitudes.\
\>", "Text",
 CellID->11631581,ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bs", "[", 
   RowBox[{"\"\<Probability\>\"", ",", " ", 
    RowBox[{
     RowBox[{"\"\<Coherent\>\"", "[", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], " ", "->", " ", 
     RowBox[{"\"\<Coherent\>\"", "[", 
      RowBox[{"{", 
       RowBox[{"c", ",", " ", "d"}], "}"}], "]"}]}]}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"E", "^", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"c", " ", "-", " ", 
          RowBox[{"a", " ", 
           RowBox[{"Cos", "[", "th", "]"}]}], " ", "+", " ", 
          RowBox[{"b", " ", 
           RowBox[{
            RowBox[{"Sin", "[", "th", "]"}], "/", 
            RowBox[{"E", "^", 
             RowBox[{"(", 
              RowBox[{"I", " ", "ph"}], ")"}]}]}]}]}], "]"}], "^", "2"}]}], 
      " ", "-", " ", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"d", " ", "-", " ", 
         RowBox[{"b", " ", 
          RowBox[{"Cos", "[", "th", "]"}]}], " ", "-", " ", 
         RowBox[{"a", " ", 
          RowBox[{"E", "^", 
           RowBox[{"(", 
            RowBox[{"I", " ", "ph"}], ")"}]}], " ", 
          RowBox[{"Sin", "[", "th", "]"}]}]}], "]"}], "^", "2"}]}], ")"}]}], 
   " ", "*)"}]}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"bs", "[", 
    RowBox[{"\"\<Probability\>\"", ",", " ", 
     RowBox[{
      RowBox[{"\"\<Coherent\>\"", "[", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0"}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{"\"\<Coherent\>\"", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", " ", 
          RowBox[{"Cos", "[", "th", "]"}]}], ",", " ", 
         RowBox[{"a", " ", 
          RowBox[{"E", "^", 
           RowBox[{"(", 
            RowBox[{"I", " ", "ph"}], ")"}]}], " ", 
          RowBox[{"Sin", "[", "th", "]"}]}]}], "}"}], "]"}]}]}], "]"}], ",", 
   " ", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"th", ",", " ", "ph"}], "}"}], ",", " ", "Reals"}], "]"}]}], 
  "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "1", " ", "*)"}]}]}], "Input",
 CellLabel->"In[45]:= ",
 CellID->1933762060,ExpressionUUID->"511b3347-8d7d-ab60-0738-ab212409f64a"],

Cell["Photon distribution up to a cutoff.", "Text",
 CellID->1055776787,ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"],

Cell[BoxData[{
 RowBox[{"bs", "[", 
  RowBox[{"\"\<Probabilities\>\"", ",", " ", 
   RowBox[{"\"\<Coherent\>\"", "[", 
    RowBox[{"{", 
     RowBox[{"a", ",", " ", "0"}], "}"}], "]"}], ",", " ", 
   RowBox[{"\"\<Cutoff\>\"", " ", "->", " ", "1"}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      RowBox[{"QuditName", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{"E", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"a", " ", 
             RowBox[{"Cos", "[", "th", "]"}]}], "]"}], "^", "2"}]}], " ", "-",
          " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"a", " ", 
            RowBox[{"Sin", "[", "th", "]"}]}], "]"}], "^", "2"}]}], ")"}]}]}],
      ",", "\n", "     ", 
     RowBox[{
      RowBox[{"QuditName", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{
       RowBox[{"E", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"a", " ", 
              RowBox[{"Cos", "[", "th", "]"}]}], "]"}], "^", "2"}]}], " ", "-",
           " ", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"a", " ", 
             RowBox[{"Sin", "[", "th", "]"}]}], "]"}], "^", "2"}]}], ")"}]}], 
       " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"a", " ", 
          RowBox[{"Cos", "[", "th", "]"}]}], "]"}], "^", "2"}]}]}], ",", "\n",
      "     ", 
     RowBox[{
      RowBox[{"QuditName", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"a", " ", 
         RowBox[{"E", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"I", " ", "ph"}], " ", "-", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"a", " ", 
                RowBox[{"Cos", "[", "th", "]"}]}], "]"}], "^", "2"}], "/", 
             "2"}], " ", "-", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"a", " ", 
                RowBox[{"Sin", "[", "th", "]"}]}], "]"}], "^", "2"}], "/", 
             "2"}]}], ")"}]}], " ", 
         RowBox[{"Sin", "[", "th", "]"}]}], "]"}], "^", "2"}]}]}], "|>"}], 
   " ", "*)"}]}]}], "Input",
 CellLabel->"In[46]:= ",
 CellID->1859711813,ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

