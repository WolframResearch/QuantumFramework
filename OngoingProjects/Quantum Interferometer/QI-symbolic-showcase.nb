    RowBox[{"{", "n", "}"}]}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"al", " ", "==", " ", "Pi"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], "^", "n"}], " ", "*)"}]}]}], "Input",
 CellLabel->"In[36]:= ",
