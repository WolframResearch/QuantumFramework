    RowBox[{"{", 
     RowBox[{"n1", ",", " ", "n2", ",", " ", "n3"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{
      RowBox[{"n1", " ", "+", " ", "n2", " ", "+", " ", "n3"}], ",", " ", 
      RowBox[{"t1", " ", "+", " ", "t2", " ", "+", " ", "t3"}]}], "]"}], " ", 
    
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
