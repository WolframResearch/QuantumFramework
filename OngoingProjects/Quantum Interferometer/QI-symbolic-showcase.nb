Cell["\<\
A QuantumState goes through the Fock-space circuit of SqueezeOperator.\
\>", "Text",
 CellID->642744358,ExpressionUUID->"187adc3d-3961-76c2-4819-d667b8145c28"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{"sq", "[", 
     RowBox[{"FockState", "[", 
      RowBox[{
       RowBox[{"{", "0", "}"}], ",", " ", "3"}], "]"}], "]"}], 
    "[", "\"\<StateVector\>\"", "]"}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Cosh", "[", 
        RowBox[{"Abs", "[", "xi", "]"}], "]"}], "]"}]}], ",", " ", "0", ",", 
     " ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"E", "^", 
        RowBox[{"(", 
         RowBox[{"I", " ", 
          RowBox[{"Arg", "[", "xi", "]"}]}], ")"}]}]}], " ", 
      RowBox[{
       RowBox[{"Sinh", "[", 
        RowBox[{"Abs", "[", "xi", "]"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Sqrt", "[", "2", "]"}], " ", 
         RowBox[{
          RowBox[{"Cosh", "[", 
           RowBox[{"Abs", "[", "xi", "]"}], "]"}], "^", 
          RowBox[{"(", 
           RowBox[{"3", "/", "2"}], ")"}]}]}], ")"}]}]}]}], "}"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{
   RowBox[{"sq", "[", 
    RowBox[{"QuantumState", "[", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", " ", 
         RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}], "]"}], ",", " ", 
      "3"}], "]"}], "]"}], "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Sech", "[", 
         RowBox[{"Abs", "[", "xi", "]"}], "]"}], "/", "2"}], ",", " ", "0", ",",
        " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sech", "[", 
          RowBox[{"Abs", "[", "xi", "]"}], "]"}]}], " ", 
        RowBox[{
         RowBox[{"Tanh", "[", 
          RowBox[{"Abs", "[", "xi", "]"}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "2", "]"}], " ", 
           RowBox[{"E", "^", 
            RowBox[{"(", 
             RowBox[{"I", " ", 
              RowBox[{"Arg", "[", "xi", "]"}]}], ")"}]}]}], ")"}]}]}]}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Sech", "[", 
          RowBox[{"Abs", "[", "xi", "]"}], "]"}], "^", "3"}], "/", "2"}], ",",
        " ", "0"}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"E", "^", 
          RowBox[{"(", 
           RowBox[{"I", " ", 
            RowBox[{"Arg", "[", "xi", "]"}]}], ")"}]}]}], " ", 
        RowBox[{"Sech", "[", 
         RowBox[{"Abs", "[", "xi", "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"Tanh", "[", 
          RowBox[{"Abs", "[", "xi", "]"}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}]}], ",", " ", "0", ",", 
       " ", 
       RowBox[{
        RowBox[{"Sech", "[", 
         RowBox[{"Abs", "[", "xi", "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Tanh", "[", 
           RowBox[{"Abs", "[", "xi", "]"}], "]"}], "^", "2"}], "/", "4"}]}]}],
       "}"}]}], "}"}], " ", "*)"}]}]}], "Input",
