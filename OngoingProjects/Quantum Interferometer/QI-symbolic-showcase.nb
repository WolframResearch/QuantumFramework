      "n1", " ", "+", " ", "n2", " ", "+", " ", "n3", " ", "+", " ", "n4"}], ",",
       " ", 
      RowBox[{
      "t1", " ", "+", " ", "t2", " ", "+", " ", "t3", " ", "+", " ", "t4"}]}],
      "]"}], " ", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Inactive", "[", "Sum", "]"}], "[", "\n", "     ", 
          RowBox[{
           RowBox[{
            RowBox[{"WignerD", "[", 
