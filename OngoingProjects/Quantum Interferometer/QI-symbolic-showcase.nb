Cell["\<\
Independent attenuators: rates on one mode multiply; an untouched mode \
conserves its photons.\
\>", "Text",
 CellID->216741342,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<Loss\>\"", "[", "eta", "]"}], " ", "->", " ", "1"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"\"\<Loss\>\"", "[", "mu", "]"}], " ", "->", " ", "1"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"\"\<Loss\>\"", "[", "nu", "]"}], " ", "->", " ", "2"}]}], 
     "}"}], ",", " ", "3"}], "]"}], "[", 
  RowBox[{"\"\<Probability\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n1", ",", " ", "n2", ",", " ", "n3"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"k1", ",", " ", "k2", ",", " ", "k3"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"eta", " ", "mu"}], ")"}], "^", "k1"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"eta", " ", "mu"}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "k1"}], " ", "+", " ", "n1"}], ")"}]}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", "nu"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "k2"}], " ", "+", " ", "n2"}], ")"}]}], " ", 
    RowBox[{"nu", "^", "k2"}], " ", 
    RowBox[{"Binomial", "[", 
     RowBox[{"n1", ",", " ", "k1"}], "]"}], " ", 
    RowBox[{"Binomial", "[", 
     RowBox[{"n2", ",", " ", "k2"}], "]"}], " ", 
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"k3", ",", " ", "n3"}], "]"}]}], " ", "*)"}]}]}], "Input",
 CellLabel->"In[62]:= ",
 CellID->2096934290,ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

