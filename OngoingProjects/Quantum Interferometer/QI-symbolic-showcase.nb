Cell[BoxData[{
 RowBox[{
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<BS\>\"", "[", 
        RowBox[{"a1", ",", " ", "b1"}], "]"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
      RowBox[{
       RowBox[{"\"\<BS\>\"", "[", 
        RowBox[{"a2", ",", " ", "b2"}], "]"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
      RowBox[{
       RowBox[{"\"\<BS\>\"", "[", 
        RowBox[{"a3", ",", " ", "b3"}], "]"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}]}], "}"}], ",", " ", "3"}], 
   "]"}], "[", 
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n1", ",", " ", "n2", ",", " ", "0"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{
      RowBox[{"n1", " ", "+", " ", "n2"}], ",", " ", 
      RowBox[{"t1", " ", "+", " ", "t2", " ", "+", " ", "t3"}]}], "]"}], " ", 
    
    RowBox[{
     RowBox[{"Inactive", "[", "Sum", "]"}], "[", 
     RowBox[{
      RowBox[{
       RowBox[{"WignerD", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n1", " ", "+", " ", "n2"}], ")"}], "/", "2"}], ",", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n1", " ", "-", " ", "n2"}], ")"}], "/", "2"}], ",", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "n1"}], " ", "-", " ", "n2", " ", "+", " ", 
              RowBox[{"2", " ", 
               RowBox[{"K", "[", "1", "]"}]}]}], ")"}], "/", "2"}]}], "}"}], ",",
          " ", "b1", ",", " ", 
         RowBox[{"2", " ", "a1"}], ",", " ", 
         RowBox[{"-", "b1"}]}], "]"}], " ", "*", "\n", "     ", 
       RowBox[{"WignerD", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"t1", " ", "+", " ", "t2"}], ")"}], "/", "2"}], ",", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "t1"}], " ", "-", " ", "t2", " ", "+", " ", 
              RowBox[{"2", " ", 
               RowBox[{"K", "[", "1", "]"}]}]}], ")"}], "/", "2"}], ",", " ", 
           
           RowBox[{
            RowBox[{"(", 
             RowBox[{"t1", " ", "-", " ", "t2"}], ")"}], "/", "2"}]}], "}"}], 
         ",", " ", "b3", ",", " ", 
         RowBox[{"2", " ", "a3"}], ",", " ", 
         RowBox[{"-", "b3"}]}], "]"}], " ", "*", "\n", "     ", 
       RowBox[{"WignerD", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n1", " ", "+", " ", "n2", " ", "-", " ", 
              RowBox[{"K", "[", "1", "]"}]}], ")"}], "/", "2"}], ",", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n1", " ", "+", " ", "n2", " ", "-", " ", 
              RowBox[{"K", "[", "1", "]"}]}], ")"}], "/", "2"}], ",", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "n1"}], " ", "-", " ", "n2", " ", "+", " ", 
              RowBox[{"2", " ", "t1"}], " ", "+", " ", 
              RowBox[{"2", " ", "t2"}], " ", "-", " ", 
              RowBox[{"K", "[", "1", "]"}]}], ")"}], "/", "2"}]}], "}"}], ",",
          " ", "b2", ",", " ", 
         RowBox[{"2", " ", "a2"}], ",", " ", 
         RowBox[{"-", "b2"}]}], "]"}]}], ",", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"K", "[", "1", "]"}], ",", " ", "0", ",", " ", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"n1", " ", "+", " ", "n2"}], ",", " ", 
          RowBox[{"t1", " ", "+", " ", "t2"}]}], "]"}]}], "}"}]}], "]"}]}], 
   " ", "*)"}]}]}], "Input",
 CellLabel->"In[27]:= ",
 CellID->1717363484,ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"],

