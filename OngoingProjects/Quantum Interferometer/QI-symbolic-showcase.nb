     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"a", " ", 
            RowBox[{"Cos", "[", "th", "]"}]}], "]"}], "^", "2"}]}], "/", 
        "2"}], " ", "-", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"a", " ", 
           RowBox[{"Sin", "[", "th", "]"}]}], "]"}], "^", "2"}], "/", "2"}]}],
       ")"}]}], " ", 
    RowBox[{"Cos", "[", "th", "]"}]}], " ", "*)"}]}]}], "Input",
 CellLabel->"In[43]:= ",
