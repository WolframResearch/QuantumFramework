       RowBox[{"{", "0", "}"}]}]}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"sq", "[", "\"\<Dagger\>\"", "]"}], "[", "sq", "]"}], "[", 
