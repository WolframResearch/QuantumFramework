              RowBox[{"-", "b1"}]}], "]"}], " ", "*", "\n", "     ", 
            RowBox[{"WignerD", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"n3", " ", "+", " ", "n4"}], ")"}], "/", "2"}], ",",
