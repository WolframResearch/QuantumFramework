     RowBox[{"\"\<Coherent\>\"", "[", 
      RowBox[{"{", "a", "}"}], "]"}], " ", "->", " ", 
     RowBox[{"{", "2", "}"}]}]}], "]"}], "\n", 
  RowBox[{"(*", " ", 
