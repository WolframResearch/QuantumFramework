           RowBox[{"(", 
            RowBox[{"I", " ", "ph"}], ")"}]}], " ", 
          RowBox[{"Sin", "[", "th", "]"}]}]}], ")"}]}]}]}], "|>"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{"Union", "[", 
