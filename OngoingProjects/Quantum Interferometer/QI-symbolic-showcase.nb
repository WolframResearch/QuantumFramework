      RowBox[{
       RowBox[{"{", "1", "}"}], " ", "->", " ", 
       RowBox[{"{", "3", "}"}]}]}], "]"}]}], "}"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "0"}], "}"}], " ", "*)"}]}]}], "Input",
 CellLabel->"In[57]:= ",
 CellID->1468251080,ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],

Cell["\<\
The Fock-space circuit with 3 levels; its corner entry is the truncated \
SqueezeOperator, not an amplitude of the network.\
\>", "Text",
 CellID->1989234463,ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],

Cell[BoxData[{
 RowBox[{"Simplify", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{"sq", "[", 
     RowBox[{"\"\<CircuitOperator\>\"", ",", " ", "3"}], "]"}], 
    "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Cosh", "[", 
          RowBox[{"Abs", "[", "xi", "]"}], "]"}], "]"}]}], ",", " ", "0", ",",
        " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Sech", "[", 
          RowBox[{"Abs", "[", "xi", "]"}], "]"}], "^", 
         RowBox[{"(", 
          RowBox[{"3", "/", "2"}], ")"}]}], " ", 
        RowBox[{
         RowBox[{"Sinh", "[", 
          RowBox[{"Abs", "[", "xi", "]"}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sqrt", "[", "2", "]"}], " ", 
           RowBox[{"E", "^", 
            RowBox[{"(", 
             RowBox[{"I", " ", 
              RowBox[{"Arg", "[", "xi", "]"}]}], ")"}]}]}], ")"}]}]}]}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{
        RowBox[{"Cosh", "[", 
         RowBox[{"Abs", "[", "xi", "]"}], "]"}], "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "3"}], "/", "2"}], ")"}]}], ",", " ", "0"}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"E", "^", 
          RowBox[{"(", 
           RowBox[{"I", " ", 
            RowBox[{"Arg", "[", "xi", "]"}]}], ")"}]}]}], " ", 
        RowBox[{
         RowBox[{"Sech", "[", 
          RowBox[{"Abs", "[", "xi", "]"}], "]"}], "^", 
         RowBox[{"(", 
          RowBox[{"3", "/", "2"}], ")"}]}], " ", 
        RowBox[{
         RowBox[{"Sinh", "[", 
          RowBox[{"Abs", "[", "xi", "]"}], "]"}], "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}]}], ",", " ", "0", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "4"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "5"}], " ", "+", " ", 
           RowBox[{"Cosh", "[", 
            RowBox[{"2", " ", 
             RowBox[{"Abs", "[", "xi", "]"}]}], "]"}]}], ")"}], "/", 
         RowBox[{
          RowBox[{"Cosh", "[", 
           RowBox[{"Abs", "[", "xi", "]"}], "]"}], "^", 
          RowBox[{"(", 
           RowBox[{"5", "/", "2"}], ")"}]}]}]}]}], "}"}]}], "}"}], " ", 
   "*)"}]}]}], "Input",
 CellLabel->"In[58]:= ",
 CellID->1607696641,ExpressionUUID->"51fce014-dca1-0630-0783-fa51d5546d1a"],

