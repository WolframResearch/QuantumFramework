       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", "2"}], "]"}], "]"}], 
    "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], " ", "+", " ", "eta"}], ")"}], " ", 
          RowBox[{
           RowBox[{"Cos", "[", "th", "]"}], "^", "2"}]}], ")"}]}], ",", " ", 
       "0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{
        RowBox[{"Sin", "[", "th", "]"}], "^", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "eta", "]"}], " ", 
        RowBox[{"Cos", "[", "th", "]"}], " ", 
        RowBox[{"Sin", "[", "th", "]"}]}], ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "eta", "]"}], " ", 
        RowBox[{"Cos", "[", "th", "]"}], " ", 
        RowBox[{"Sin", "[", "th", "]"}]}], ",", " ", 
       RowBox[{"eta", " ", 
        RowBox[{
         RowBox[{"Cos", "[", "th", "]"}], "^", "2"}]}], ",", " ", "0"}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
