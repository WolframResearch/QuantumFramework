                RowBox[{"Sin", "[", "th", "]"}], "/", 
                RowBox[{"E", "^", 
                 RowBox[{"(", 
                  RowBox[{"I", " ", "ph"}], ")"}]}]}]}]}], "]"}], "^", 
            "2"}]}], "/", "2"}], " ", "-", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"b", " ", 
              RowBox[{"Cos", "[", "th", "]"}]}], " ", "+", " ", 
             RowBox[{"a", " ", 
              RowBox[{"E", "^", 
               RowBox[{"(", 
                RowBox[{"I", " ", "ph"}], ")"}]}], " ", 
              RowBox[{"Sin", "[", "th", "]"}]}]}], "]"}], "^", "2"}], "/", 
          "2"}]}], ")"}]}]}], ",", "\n", "     ", 
     RowBox[{
      RowBox[{"QuditName", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{
       RowBox[{"E", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"a", " ", 
                RowBox[{"Cos", "[", "th", "]"}]}], " ", "-", " ", 
               RowBox[{"b", " ", 
                RowBox[{
                 RowBox[{"Sin", "[", "th", "]"}], "/", 
                 RowBox[{"E", "^", 
                  RowBox[{"(", 
                   RowBox[{"I", " ", "ph"}], ")"}]}]}]}]}], "]"}], "^", 
             "2"}]}], "/", "2"}], " ", "-", " ", 
