 CellID->1208482393,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell["Transfer matrix of a beam splitter; an omitted phase is 0.", "Text",
 CellID->28909615,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bs", "[", "\"\<Unitary\>\"", "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", "th", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sin", "[", "th", "]"}]}], "/", 
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{"I", " ", "ph"}], ")"}]}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{"I", " ", "ph"}], ")"}]}], " ", 
        RowBox[{"Sin", "[", "th", "]"}]}], ",", " ", 
       RowBox[{"Cos", "[", "th", "]"}]}], "}"}]}], "}"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BS\>\"", "[", "th", "]"}], "}"}], "]"}], 
  "[", "\"\<Unitary\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", "th", "]"}], ",", " ", 
       RowBox[{"-", 
        RowBox[{"Sin", "[", "th", "]"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sin", "[", "th", "]"}], ",", " ", 
       RowBox[{"Cos", "[", "th", "]"}]}], "}"}]}], "}"}], " ", 
   "*)"}]}]}], "Input",
 CellLabel->"In[2]:= ",
 CellID->193832008,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

