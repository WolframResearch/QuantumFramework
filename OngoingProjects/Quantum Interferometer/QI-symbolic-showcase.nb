Cell["\<\
Long element names normalize to the short ones; a beam splitter also takes \
its angles as a list, and its two modes in either order.\
\>", "Text",
 CellID->1392207227,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<PhaseShift\>\"", "[", "al", "]"}], ",", " ", 
      RowBox[{"\"\<Squeeze\>\"", "[", "xi", "]"}]}], "}"}], "]"}], 
   "[", "\"\<Elements\>\"", "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\"\<PS\>\"", "[", "al", "]"}], " ", "->", " ", 
      RowBox[{"{", "1", "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"\"\<S\>\"", "[", "xi", "]"}], " ", "->", " ", 
      RowBox[{"{", "1", "}"}]}]}], "}"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<BeamSplitter\>\"", "[", 
      RowBox[{"{", 
       RowBox[{"th", ",", " ", "ph"}], "}"}], "]"}], "}"}], "]"}], 
   "[", "\"\<Elements\>\"", "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<BS\>\"", "[", 
      RowBox[{"th", ",", " ", "ph"}], "]"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<BS\>\"", "[", 
      RowBox[{"th", ",", " ", "ph"}], "]"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "1"}], "}"}]}], "}"}], "]"}], 
  "[", "\"\<Unitary\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", "th", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{"I", " ", "ph"}], ")"}]}], " ", 
        RowBox[{"Sin", "[", "th", "]"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sin", "[", "th", "]"}]}], "/", 
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{"I", " ", "ph"}], ")"}]}]}], ",", " ", 
       RowBox[{"Cos", "[", "th", "]"}]}], "}"}]}], "}"}], " ", 
   "*)"}]}]}], "Input",
 CellLabel->"In[4]:= ",
 CellID->705466992,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

