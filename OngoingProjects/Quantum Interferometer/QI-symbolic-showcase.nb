 CellID->1030824397,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{"{", 
