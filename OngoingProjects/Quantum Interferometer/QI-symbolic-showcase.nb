    RowBox[{
     RowBox[{"{", 
      RowBox[{"n1", ",", " ", "n2"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"t1", ",", " ", "t2"}], "}"}]}]}], "]"}], " ", "/.", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"n1", " ", "->", " ", "1"}], ",", " ", 
    RowBox[{"n2", " ", "->", " ", "0"}], ",", " ", 
    RowBox[{"t1", " ", "->", " ", "2"}], ",", " ", 
    RowBox[{"t2", " ", "->", " ", "0"}]}], "}"}]}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "0", " ", "*)"}]}]}], "Input",
 CellLabel->"In[77]:= ",
 CellID->861714746,ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"],

Cell[TextData[{
 "The all-outputs form ",
 Cell[BoxData[
  RowBox[{"qi", "[", "pattern", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ff7667-e560-b2c0-2285-68408c1a002a"],
 ", with Fock photons or a coherent slot, takes no ",
 Cell[BoxData["Assumptions"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c9be80e-0554-61c1-24b8-0268ace1332b"],
 " and ignores an enclosing ",
 Cell[BoxData["Assuming"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "106b7ad8-6378-599b-4069-7382160d2be1"],
 "; ",
 Cell[BoxData["\"\<Amplitude\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],
 " and ",
 Cell[BoxData["\"\<Probabilities\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "304452a4-201b-d64c-607c-4b0e51afbc96"],
 " honour both."
}], "Text",
 CellID->1192942815,ExpressionUUID->"6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],

Cell["Simplification the kernel leaves to the caller:", "Text",
 CellID->556077107,ExpressionUUID->"4b5b9263-9199-4e16-7978-144d202c157c"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"qi", "[", 
   RowBox[{"\"\<Channel\>\"", ",", " ", "d"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "475d7054-346c-a3cc-6d63-6a1ebd1ef116"],
 " and the ",
 Cell[BoxData["\"\<CircuitOperator\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],
 " of a lossy network apply QF's QuantumChannel, so their density matrices \
keep ",
 Cell[BoxData["Conjugate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3343f580-98d5-e31c-6170-ecea1961ce66"],
 ", as in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Sqrt", "[", "eta", "]"}], " ", 
   RowBox[{"Conjugate", "[", 
    RowBox[{"Sqrt", "[", "eta", "]"}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a7420b-376a-b23f-505d-6455421c0105"],
 ". ",
 Cell[BoxData[
  RowBox[{"qi", "[", "state", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6af863a9-1098-c609-1a98-7af3a112ad53"],
 " gives the simplified form for every network and state."
}], "Item",
 CellID->15883883,ExpressionUUID->"055bc2ad-6b92-a3be-3378-dbf70e24f184"],

Cell[TextData[{
 Cell[BoxData["Refine"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0fb60e-2211-365f-5934-286857a59ca5"],
 " does not apply trigonometric identities, so a mixed state through a beam \
splitter keeps ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", "th", "]"}], "^", "2"}], " ", "+", " ", 
     RowBox[{
      RowBox[{"Sin", "[", "th", "]"}], "^", "2"}]}], ")"}], "/", "2"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "201a2509-bdd9-2fa1-5039-bd53346c758b"],
 ", and a squeezer before a general beam splitter keeps ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Cos", "[", "th", "]"}], "^", "2"}], " ", 
    RowBox[{"Cosh", "[", 
     RowBox[{"Abs", "[", "xi", "]"}], "]"}]}], " ", "+", " ", 
   RowBox[{
    RowBox[{"Cosh", "[", 
     RowBox[{"Abs", "[", "xi", "]"}], "]"}], " ", 
    RowBox[{
     RowBox[{"Sin", "[", "th", "]"}], "^", "2"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 "."
}], "Item",
 CellID->308842859,ExpressionUUID->"5f932952-49a5-d34f-05a0-c11c6851a195"],

Cell[TextData[{
 "Coherent photon distributions keep ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"a", " ", 
     RowBox[{"Cos", "[", "th", "]"}]}], "]"}], "^", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "160f17c4-d31a-fe19-3e34-8ea1e6acc563"],
 " rather than ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", "a", "]"}], "^", "2"}], " ", 
   RowBox[{
    RowBox[{"Cos", "[", "th", "]"}], "^", "2"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10beb8bd-bdb6-ee93-4045-31e73440b4f9"],
 "; ",
 Cell[BoxData["Refine"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fdc991b-fead-14b0-65e3-1144fb587e9a"],
 " does not factor the modulus."
}], "Item",
 CellID->1108042358,ExpressionUUID->"3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],

Cell[TextData[{
 "A squeezing parameter written in polar form keeps ",
 Cell[BoxData[
  RowBox[{"Arg", "[", 
   RowBox[{"E", "^", 
    RowBox[{"(", 
     RowBox[{"I", " ", "f"}], ")"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0642d375-09f3-9942-2e71-cb3faf87eba8"],
 ", since ",
 Cell[BoxData["Arg"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0651775d-2bad-791b-2e6f-6f074e584861"],
 " reduces f modulo 2 Pi:"
}], "Item",
 CellID->1009200201,ExpressionUUID->"63b9e3d6-2298-231e-1146-fa9057128e64"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<S\>\"", "[", 
     RowBox[{"r", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "f"}], "]"}]}], "]"}], "}"}], "]"}], "[", 
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", "0", "}"}], " ", "->", " ", 
    RowBox[{"{", "2", "}"}]}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{
     RowBox[{"r", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"Element", "[", 
      RowBox[{"f", ",", " ", "Reals"}], "]"}]}]}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"E", "^", 
      RowBox[{"(", 
       RowBox[{"I", " ", 
        RowBox[{"Arg", "[", 
         RowBox[{"E", "^", 
          RowBox[{"(", 
           RowBox[{"I", " ", "f"}], ")"}]}], "]"}]}], ")"}]}]}], " ", 
    RowBox[{
     RowBox[{"Sech", "[", "r", "]"}], "^", 
     RowBox[{"(", 
      RowBox[{"3", "/", "2"}], ")"}]}], " ", 
    RowBox[{
     RowBox[{"Sinh", "[", "r", "]"}], "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}]}], " ", "*)"}]}]}], "Input",
 CellLabel->"In[78]:= ",
 CellID->752465254,ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"]
},
