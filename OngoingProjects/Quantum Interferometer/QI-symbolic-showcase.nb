         RowBox[{
          RowBox[{"WignerD", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"n1", " ", "+", " ", "n2"}], ")"}], "/", "2"}], ",", 
              " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"n1", " ", "-", " ", "n2"}], ")"}], "/", "2"}], ",", 
              " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "n1"}], " ", "-", " ", "n2", " ", "+", " ", 
                 RowBox[{"2", " ", "t1"}]}], ")"}], "/", "2"}]}], "}"}], ",", 
            " ", "ph1", ",", " ", 
            RowBox[{"2", " ", "th1"}], ",", " ", 
            RowBox[{"-", "ph1"}]}], "]"}], " ", "*", "\n", "     ", 
          RowBox[{"WignerD", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                "n1", " ", "+", " ", "n2", " ", "+", " ", "n3", " ", "-", " ",
                  "t1"}], ")"}], "/", "2"}], ",", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                "n1", " ", "+", " ", "n2", " ", "-", " ", "n3", " ", "-", " ",
                  "t1"}], ")"}], "/", "2"}], ",", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "n1"}], " ", "-", " ", "n2", " ", "-", " ", 
                 "n3", " ", "+", " ", "t1", " ", "+", " ", 
                 RowBox[{"2", " ", "t2"}]}], ")"}], "/", "2"}]}], "}"}], ",", 
            " ", "ph2", ",", " ", 
            RowBox[{"2", " ", "th2"}], ",", " ", 
            RowBox[{"-", "ph2"}]}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"n1", " ", "+", " ", "n2"}], " ", ">=", " ", "t1"}]}], 
        "}"}], "}"}], ",", " ", "0"}], "]"}]}], " ", "*)"}]}]}], "Input",
