        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{"eta", " ", 
           RowBox[{
            RowBox[{"Abs", "[", "a", "]"}], "^", "2"}]}], ")"}]}]}]}]}]}], 
    "|>"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"l", "[", 
   RowBox[{"\"\<Probability\>\"", ",", " ", 
