Cell["A coherent state stays coherent: |a> -> |W.a>.", "Text",
 CellID->724760089,ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"],

Cell[BoxData[{
 RowBox[{"bs", "[", 
  RowBox[{"\"\<Coherent\>\"", "[", 
   RowBox[{"{", 
    RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"\"\<Coherent\>\"", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"a", " ", 
        RowBox[{"Cos", "[", "th", "]"}]}], " ", "-", " ", 
       RowBox[{"b", " ", 
        RowBox[{
         RowBox[{"Sin", "[", "th", "]"}], "/", 
         RowBox[{"E", "^", 
          RowBox[{"(", 
           RowBox[{"I", " ", "ph"}], ")"}]}]}]}]}], ",", " ", 
      RowBox[{
       RowBox[{"b", " ", 
        RowBox[{"Cos", "[", "th", "]"}]}], " ", "+", " ", 
       RowBox[{"a", " ", 
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{"I", " ", "ph"}], ")"}]}], " ", 
        RowBox[{"Sin", "[", "th", "]"}]}]}]}], "}"}], "]"}], " ", 
   "*)"}]}]}], "Input",
 CellLabel->"In[42]:= ",
 CellID->168408080,ExpressionUUID->"19bb1c5e-57ab-6e36-4f58-9618625e351c"],

Cell["Coherent input, Fock output.", "Text",
 CellID->811283638,ExpressionUUID->"5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],

Cell[BoxData[{
 RowBox[{"bs", "[", 
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"\"\<Coherent\>\"", "[", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "0"}], "}"}], "]"}], " ", "->", " ", 
