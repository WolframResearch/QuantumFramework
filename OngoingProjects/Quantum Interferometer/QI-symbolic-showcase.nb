Cell["Finite states: coherences scale by Sqrt[eta].", "Text",
 CellID->476175344,ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{"l", "[", 
     RowBox[{"QuantumState", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "I"}], "}"}], "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", "2"}], "]"}], "]"}], 
    "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "eta"}], ")"}], "/", "2"}]}], ",", " ", 
       
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", "eta", "]"}], "/", "2"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"I", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", "eta", "]"}], "/", "2"}]}], ",", " ", 
       RowBox[{"eta", "/", "2"}]}], "}"}]}], "}"}], " ", "*)"}]}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{"lb", "[", 
