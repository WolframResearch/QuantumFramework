Cell[BoxData[{
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<S\>\"", "[", "r", "]"}], ",", " ", 
       RowBox[{"\"\<BS\>\"", "[", 
        RowBox[{
         RowBox[{"Pi", "/", "4"}], ",", " ", "0"}], "]"}]}], "}"}], "]"}], "[", 
    RowBox[{"\"\<Amplitude\>\"", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"r", " ", ">", " ", "0"}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      RowBox[{"Sech", "[", "r", "]"}], "^", 
      RowBox[{"(", 
       RowBox[{"3", "/", "2"}], ")"}]}]}], " ", 
    RowBox[{
     RowBox[{"Sinh", "[", "r", "]"}], "/", "2"}]}], " ", "*)"}]}]}], "Input",
 CellLabel->"In[54]:= ",
 CellID->1310926461,ExpressionUUID->"112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],

Cell["\<\
Two squeezers interfering: equal squeezing leaves a product of single-mode \
squeezed vacua, so the coincidence vanishes; opposite squeezing, x2 = -x1, \
makes a two-mode squeezed vacuum and the coincidence is largest.\
\>", "Text",
 CellID->1124211690,ExpressionUUID->"6121b9de-dddd-aca8-10de-309bd469f6f2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\"\<S\>\"", "[", "x1", "]"}], " ", "->", " ", "1"}], ",", " ", 
     
     RowBox[{
      RowBox[{"\"\<S\>\"", "[", "x2", "]"}], " ", "->", " ", "2"}], ",", " ", 
     
     RowBox[{"\"\<BS\>\"", "[", 
      RowBox[{
       RowBox[{"Pi", "/", "4"}], ",", " ", "0"}], "]"}]}], "}"}], "]"}], "[", 
  
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"Sech", "[", 
       RowBox[{"Abs", "[", "x1", "]"}], "]"}], " ", 
      RowBox[{"Sech", "[", 
       RowBox[{"Abs", "[", "x2", "]"}], "]"}]}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{"I", " ", 
           RowBox[{"Arg", "[", "x1", "]"}]}], ")"}]}]}], " ", 
       RowBox[{
        RowBox[{"Tanh", "[", 
         RowBox[{"Abs", "[", "x1", "]"}], "]"}], "/", "2"}]}], " ", "+", " ", 
      
      RowBox[{
       RowBox[{"E", "^", 
        RowBox[{"(", 
         RowBox[{"I", " ", 
          RowBox[{"Arg", "[", "x2", "]"}]}], ")"}]}], " ", 
       RowBox[{
        RowBox[{"Tanh", "[", 
         RowBox[{"Abs", "[", "x2", "]"}], "]"}], "/", "2"}]}]}], ")"}]}], " ",
    "*)"}]}]}], "Input",
 CellLabel->"In[55]:= ",
 CellID->1335749844,ExpressionUUID->"30209679-023a-ee91-61df-0823b7ccb4fb"],

Cell["\<\
A squeezer before a general beam splitter; the denominator is Cosh[Abs[xi]] \
once Cos^2 + Sin^2 = 1 is applied.\
\>", "Text",
 CellID->793802945,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\"\<S\>\"", "[", "xi", "]"}], " ", "->", " ", "1"}], ",", " ", 
     
     RowBox[{"\"\<BS\>\"", "[", 
      RowBox[{"th", ",", " ", "ph"}], "]"}]}], "}"}], "]"}], "[", 
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"E", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"I", " ", "ph"}], " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"Arg", "[", "xi", "]"}]}]}], ")"}]}]}], " ", 
    RowBox[{"Cos", "[", "th", "]"}], " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"Sech", "[", 
      RowBox[{"Abs", "[", "xi", "]"}], "]"}], "]"}], " ", 
    RowBox[{"Sin", "[", "th", "]"}], " ", 
    RowBox[{
     RowBox[{"Sinh", "[", 
      RowBox[{"Abs", "[", "xi", "]"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "th", "]"}], "^", "2"}], " ", 
        RowBox[{"Cosh", "[", 
         RowBox[{"Abs", "[", "xi", "]"}], "]"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"Cosh", "[", 
         RowBox[{"Abs", "[", "xi", "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"Sin", "[", "th", "]"}], "^", "2"}]}]}], ")"}]}]}], " ", 
   "*)"}]}]}], "Input",
 CellLabel->"In[56]:= ",
 CellID->631769182,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell["Counts and inverse; the inverse undoes the squeezer.", "Text",
