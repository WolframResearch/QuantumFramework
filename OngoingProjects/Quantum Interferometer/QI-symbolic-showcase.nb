      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n1", " ", "+", " ", "n2"}], ")"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"(", 
