Cell["\<\
A pure QuantumState goes through the permanents; a mixed one through the \
Fock-space circuit.\
\>", "Text",
 CellID->1560876240,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{"bs", "[", 
     RowBox[{"FockState", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", "2"}], "]"}], "]"}], 
    "[", "\"\<StateVector\>\"", "]"}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", 
     RowBox[{
      RowBox[{"E", "^", 
       RowBox[{"(", 
        RowBox[{"I", " ", "ph"}], ")"}]}], " ", 
      RowBox[{"Sin", "[", "th", "]"}]}], ",", " ", 
     RowBox[{"Cos", "[", "th", "]"}], ",", " ", "0"}], "}"}], " ", "*)"}]}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{
   RowBox[{"bs", "[", 
    RowBox[{"QuantumState", "[", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"1", "/", "2"}], ",", " ", 
         RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], "]"}], 
   "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", "th", "]"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"Sin", "[", "th", "]"}], "^", "2"}]}], ")"}], "/", "2"}], ",",
        " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", "th", "]"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"Sin", "[", "th", "]"}], "^", "2"}]}], ")"}], "/", "2"}], ",",
        " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
    "}"}], " ", "*)"}]}]}], "Input",
 CellLabel->"In[18]:= ",
 CellID->176337227,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell["\<\
A state with its own parameters keeps them, so the output can be bound later.\
\
\>", "Text",
 CellID->807053435,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{"bs", "[", 
     RowBox[{"QuantumState", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"Cos", "[", "g", "]"}], ",", " ", 
         RowBox[{"Sin", "[", "g", "]"}], ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
        RowBox[{"{", "g", "}"}]}]}], "]"}], "]"}], "[", "\"\<StateVector\>\"",
     "]"}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "g", "]"}], " ", 
       RowBox[{"Cos", "[", "th", "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"E", "^", 
        RowBox[{"(", 
         RowBox[{"I", " ", "ph"}], ")"}]}], " ", 
       RowBox[{"Sin", "[", "g", "]"}], " ", 
       RowBox[{"Sin", "[", "th", "]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "th", "]"}], " ", 
       RowBox[{"Sin", "[", "g", "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"Cos", "[", "g", "]"}], " ", 
       RowBox[{
        RowBox[{"Sin", "[", "th", "]"}], "/", 
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{"I", " ", "ph"}], ")"}]}]}]}]}], ",", " ", "0"}], "}"}], 
   " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"bs", "[", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"Cos", "[", "g", "]"}], ",", " ", 
       RowBox[{"Sin", "[", "g", "]"}], ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", "g", "}"}]}]}], "]"}], "]"}], "[", "\"\<Parameters\>\"", 
  "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", "g", "}"}], " ", "*)"}]}]}], "Input",
 CellLabel->"In[19]:= ",
 CellID->1633675818,ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell["3. Symbolic photon numbers (passive)", "Section",
 CellID->1828793009,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell["\<\
One beam splitter is a Wigner D-function; conservation is a Kronecker delta.\
\>", "Text",
 CellID->1232986364,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bs", "[", 
   RowBox[{"\"\<Amplitude\>\"", ",", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n1", ",", " ", "n2"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"t1", ",", " ", "t2"}], "}"}]}]}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{
      RowBox[{"n1", " ", "+", " ", "n2"}], ",", " ", 
      RowBox[{"t1", " ", "+", " ", "t2"}]}], "]"}], " ", 
    RowBox[{"WignerD", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n1", " ", "+", " ", "n2"}], ")"}], "/", "2"}], ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n1", " ", "-", " ", "n2"}], ")"}], "/", "2"}], ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "n1"}], " ", "-", " ", "n2", " ", "+", " ", 
           RowBox[{"2", " ", "t1"}]}], ")"}], "/", "2"}]}], "}"}], ",", " ", 
      "ph", ",", " ", 
      RowBox[{"2", " ", "th"}], ",", " ", 
      RowBox[{"-", "ph"}]}], "]"}]}], " ", "*)"}], "\n"}], "\n", 
 RowBox[{"bs", "[", 
  RowBox[{"\"\<Probability\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n1", ",", " ", "n2"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"t1", ",", " ", "t2"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"WignerD", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n1", " ", "+", " ", "n2"}], ")"}], "/", "2"}], ",", " ", 
          
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n1", " ", "-", " ", "n2"}], ")"}], "/", "2"}], ",", " ", 
          
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "n1"}], " ", "-", " ", "n2", " ", "+", " ", 
             RowBox[{"2", " ", "t1"}]}], ")"}], "/", "2"}]}], "}"}], ",", " ",
         "ph", ",", " ", 
        RowBox[{"2", " ", "th"}], ",", " ", 
        RowBox[{"-", "ph"}]}], "]"}], "]"}], "^", "2"}], " ", 
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{
      RowBox[{"n1", " ", "+", " ", "n2"}], ",", " ", 
      RowBox[{"t1", " ", "+", " ", "t2"}]}], "]"}]}], " ", "*)"}]}]}], "Input",\

 CellLabel->"In[20]:= ",
 CellID->762269937,ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"],

