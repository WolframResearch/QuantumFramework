Cell["\<\
Assumptions on squeezing parameters and coherent amplitudes, which the domain \
leaves complex, simplify them.\
\>", "Text",
 CellID->2099309037,ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<S\>\"", "[", "xi", "]"}], "}"}], "]"}], "[", 
   RowBox[{"\"\<Amplitude\>\"", ",", " ", 
    RowBox[{
     RowBox[{"{", "0", "}"}], " ", "->", " ", 
     RowBox[{"{", "2", "}"}]}], ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{"xi", " ", ">", " ", "0"}]}]}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      RowBox[{"Sech", "[", "xi", "]"}], "^", 
      RowBox[{"(", 
       RowBox[{"3", "/", "2"}], ")"}]}]}], " ", 
    RowBox[{
     RowBox[{"Sinh", "[", "xi", "]"}], "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{"bs", "[", 
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"\"\<Coherent\>\"", "[", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "0"}], "}"}], "]"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "0"}], "}"}]}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"a", " ", ">", " ", "0"}]}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"a", " ", 
    RowBox[{"E", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"a", "^", "2"}]}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", "th", "]"}], "^", "2"}], "/", "2"}]}], " ", "-",
        " ", 
       RowBox[{
        RowBox[{"a", "^", "2"}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", "th", "]"}], "^", "2"}], "/", "2"}]}]}], 
      ")"}]}], " ", 
    RowBox[{"Cos", "[", "th", "]"}]}], " ", "*)"}]}]}], "Input",
 CellLabel->"In[40]:= ",
 CellID->512383039,ExpressionUUID->"07359582-e823-44a1-2eca-0cef89d62e8b"],

Cell["Whole distributions take assumptions the same three ways.", "Text",
 CellID->273308241,ExpressionUUID->"7c239bd0-3ff5-3b18-25d0-129ab9818662"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bs", "[", 
   RowBox[{"\"\<Probabilities\>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{"th", " ", "==", " ", 
      RowBox[{"Pi", "/", "4"}]}]}]}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      RowBox[{"QuditName", "[", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "0"}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{"1", "/", "2"}]}], ",", " ", 
     RowBox[{
      RowBox[{"QuditName", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], "]"}], " ", "->", " ", "0"}], ",",
      " ", 
     RowBox[{
      RowBox[{"QuditName", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "2"}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{"1", "/", "2"}]}]}], "|>"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{"th", " ", "==", " ", 
      RowBox[{"Pi", "/", "4"}]}], ",", " ", 
     RowBox[{"bs", "[", 
      RowBox[{"\"\<Probabilities\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]}], "]"}], " ", "===", 
   " ", 
   RowBox[{"bs", "[", 
    RowBox[{"\"\<Probabilities\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"th", " ", "==", " ", 
        RowBox[{"Pi", "/", "4"}]}], "}"}]}]}], "]"}]}], "\n", 
  RowBox[{"(*", " ", "True", " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<S\>\"", "[", "xi", "]"}], "}"}], "]"}], "[", 
   RowBox[{"\"\<Probabilities\>\"", ",", " ", 
    RowBox[{"{", "0", "}"}], ",", " ", 
    RowBox[{"\"\<Cutoff\>\"", " ", "->", " ", "2"}], ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{"xi", " ", ">", " ", "0"}]}]}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      RowBox[{"QuditName", "[", "0", "]"}], " ", "->", " ", 
      RowBox[{"Sech", "[", "xi", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"QuditName", "[", "2", "]"}], " ", "->", " ", 
      RowBox[{
       RowBox[{"Sech", "[", "xi", "]"}], " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Tanh", "[", "xi", "]"}], "^", "2"}], "/", "2"}]}]}]}], 
    "|>"}], " ", "*)"}]}], "\n", 
 RowBox[{"bs", "[", 
  RowBox[{"\"\<Probabilities\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"th", " ", "==", " ", "I"}]}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"$Failed", ",", " ", 
    RowBox[{"Refine", "::", "fas"}]}], " ", "*)"}]}]}], "Input",
 CellLabel->"In[41]:= ",
 CellID->1809098798,ExpressionUUID->"68c76573-72ce-0c1a-18fd-7d3d077b5760"],

