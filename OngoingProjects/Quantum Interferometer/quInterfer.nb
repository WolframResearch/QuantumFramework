Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "6", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"w", "=", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{"CircularUnitaryMatrixDistribution", "[", "6", "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"meshes", "=", 
  RowBox[{"AssociationMap", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumInterferometer", "[", 
      RowBox[{"w", ",", 
       RowBox[{"Method", "->", "#"}]}], "]"}], "&"}], ",", 
    RowBox[{"{", 
     RowBox[{"\"\<Clements\>\"", ",", "\"\<Reck\>\"", 
      ",", "\"\<CosineSine\>\""}], "}"}]}], "]"}]}]}], "Input",
