{a, ad} = FieldVariables[{1}];
res = <||>;
SetAttributes[put, HoldRest];
put[k_, v_] := (res[k] = TimeConstrained[v, 60, $TimedOut]);
put["bmeDisp", BosonicMatrixElement[{n, 0}, DisplacementOperator[al, Infinity]]];
put["bmeSq", BosonicMatrixElement[{n, 0}, SqueezeOperator[xi, Infinity]]];
put["bmeSq0", BosonicMatrixElement[{0, n}, SqueezeOperator[xi, Infinity]]];
put["bmeExpAd", BosonicMatrixElement[{n, 0}, Exp[f ad]]];
put["bmeProj", Table[BosonicMatrixElement[{m, k}, NormalOrdered[Exp[-ad ** a]]], {m, 0, 3}, {k, 0, 3}]];
put["bmeProjSym", BosonicMatrixElement[{m, m}, NormalOrdered[Exp[-ad ** a]]]];
put["coh", BosonicMatrixElement[{al, be}, a ** ad ** a ** ad, "Basis" -> "Coherent"]];
put["cohProj1", BosonicMatrixElement[{al, al}, NormalOrdered[ad ** Exp[-ad ** a] ** a], "Basis" -> "Coherent"]];
put["SD", BosonicNormalOrder[SqueezeOperator[xi, Infinity, "Ordering" -> "Normal"] ** DisplacementOperator[be, Infinity, "Ordering" -> "Normal"]]];
put["SDexp", BosonicExpOrder[SqueezeOperator[xi, Infinity, "Ordering" -> "Normal"] ** DisplacementOperator[be, Infinity, "Ordering" -> "Normal"]]];
put["quadLin", BosonicExpOrder[Exp[p a ** a + q ad ** ad + r ad ** a + s ad + u a]]];
put["quadOnly", BosonicExpOrder[Exp[p a ** a + q ad ** ad + r ad ** a]]];
put["conjAff", BosonicExpSimplify[Exp[p a ** a + q ad ** ad + s ad + u a] ** a ** Exp[-(p a ** a + q ad ** ad + s ad + u a)]]];
put["conjQuadN", BosonicExpSimplify[Exp[I t (p a ** a + q ad ** ad + r ad ** a + s ad + u a)] ** a ** Exp[-I t (p a ** a + q ad ** ad + r ad ** a + s ad + u a)]]];
WriteString["stdout", StringRiffle[KeyValueMap[#1 <> " -> " <> ToString[InputForm[#2]] &, res], "\n\n"], "\n"];
