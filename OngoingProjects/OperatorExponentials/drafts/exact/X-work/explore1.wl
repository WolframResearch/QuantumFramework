{a, ad} = FieldVariables[{1}];
{a1, ad1, a2, ad2} = FieldVariables[{1, 2}];
emit[k_, v_] := WriteString["stdout", k, " -> ", ToString[InputForm[v]], "\n"];
emit["D adj", TimeConstraint[BosonicExpSimplify[Exp[-(\[Alpha] ad - Conjugate[\[Alpha]] a)] ** a ** Exp[\[Alpha] ad - Conjugate[\[Alpha]] a]], 60]];
emit["D comp", TimeConstraint[BosonicExpSimplify[Exp[\[Alpha] ad - Conjugate[\[Alpha]] a] ** Exp[\[Beta] ad - Conjugate[\[Beta]] a]], 60]];
emit["D order", TimeConstraint[BosonicExpOrder[Exp[\[Alpha] ad - Conjugate[\[Alpha]] a]], 60]];
emit["S vac ME", TimeConstraint[BosonicMatrixElement[{m, 0}, SqueezeOperator[\[Xi], Infinity]], 60]];
emit["S vac ME 4", TimeConstraint[BosonicMatrixElement[{4, 0}, SqueezeOperator[\[Xi], Infinity]], 60]];
emit["two-mode ME", TimeConstraint[BosonicMatrixElement[{{2, 2}, {0, 0}}, Exp[x a1 ** a2 + y ad1 ** ad2]], 60]];
emit["VEV exp", TimeConstraint[BosonicVEV[Exp[zb a] ** Exp[w ad]], 60]];
emit["VEV sq", TimeConstraint[BosonicVEV[Exp[c a ** a] ** Exp[d ad ** ad]], 60]];
emit["VEV 2mode", TimeConstraint[BosonicVEV[Exp[c11 a1 ** a1 + c12 a1 ** a2 + c22 a2 ** a2] ** Exp[d11 ad1 ** ad1 + d12 ad1 ** ad2 + d22 ad2 ** ad2]], 60]];
emit["2mode conj Z", TimeConstraint[BosonicExpSimplify[Exp[-(z11 ad1 ** ad1 + 2 z12 ad1 ** ad2 + z22 ad2 ** ad2)/2] ** a1 ** Exp[(z11 ad1 ** ad1 + 2 z12 ad1 ** ad2 + z22 ad2 ** ad2)/2]], 60]];
emit["2mode conj h", TimeConstraint[BosonicExpSimplify[Exp[h11 ad1 ** a1 + h12 ad1 ** a2 + h21 ad2 ** a1 + h22 ad2 ** a2] ** a1 ** Exp[-(h11 ad1 ** a1 + h12 ad1 ** a2 + h21 ad2 ** a1 + h22 ad2 ** a2)]], 60]];
emit["S2 conj", TimeConstraint[BosonicExpSimplify[Exp[Conjugate[\[Xi]] a1 ** a2 - \[Xi] ad1 ** ad2] ** a1 ** Exp[-(Conjugate[\[Xi]] a1 ** a2 - \[Xi] ad1 ** ad2)]], 60]];
emit["NO 2mode", TimeConstraint[BosonicExpOrder[Exp[h11 ad1 ** a1 + h12 ad1 ** a2 + h21 ad2 ** a1 + h22 ad2 ** a2]], 60]];
emit["proj ME", TimeConstraint[BosonicMatrixElement[{m, n}, NormalOrdered[Exp[-ad ** a]]], 60]];
emit["proj coh", TimeConstraint[BosonicMatrixElement[{z, w}, NormalOrdered[Exp[-ad ** a]], "Basis" -> "Coherent"], 60]];
emit["trace ME", TimeConstraint[BosonicMatrixElement[{n, n}, Exp[\[Lambda] ad ** a]], 60]];
emit["comm", TimeConstraint[BosonicNormalOrder[(u11 a1 + u12 a2 + v11 ad1 + v12 ad2) ** (Conjugate[u21] ad1 + Conjugate[u22] ad2 + Conjugate[v21] a1 + Conjugate[v22] a2) - (Conjugate[u21] ad1 + Conjugate[u22] ad2 + Conjugate[v21] a1 + Conjugate[v22] a2) ** (u11 a1 + u12 a2 + v11 ad1 + v12 ad2)], 60]];
emit["quad conj", TimeConstraint[BosonicExpSimplify[Exp[t (p a ** a + q ad ** ad + s ad ** a)] ** a ** Exp[-t (p a ** a + q ad ** ad + s ad ** a)]], 60]];
