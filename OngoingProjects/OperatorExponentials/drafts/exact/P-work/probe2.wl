{a, ad} = FieldVariables[{1}];
{a1, ad1, a2, ad2} = FieldVariables[{1, 2}];
r = <||>;
t[k_, e_] := (r[k] = TimeConstrained[e, 60]);
SetAttributes[t, HoldRest];
t["affA", BosonicMatrixElement[{0, 0}, Exp[ca a] ** Exp[cz/2 a ** a] ** Exp[z/2 ad ** ad] ** Exp[al ad]]];
t["affB", BosonicExpOrder[Exp[ca a] ** Exp[cz/2 a ** a] ** Exp[z/2 ad ** ad] ** Exp[al ad]]];
t["affC", BosonicExpOrder[Exp[cz/2 a ** a] ** Exp[z/2 ad ** ad]]];
t["affD", BosonicExpSimplify[Exp[ca a] ** Exp[z/2 ad ** ad]]];
t["twoSq", BosonicExpOrder[Exp[x a1 ** a2] ** Exp[y ad1 ** ad2]]];
t["twoSqN", BosonicExpOrder[Exp[x a1 ** a2] ** Exp[lam ad1 ** a1] ** Exp[y ad1 ** ad2]]];
t["twoAnn", BosonicExpSimplify[a1 ** Exp[-(z11 ad1 ** ad1 + 2 z12 ad1 ** ad2 + z22 ad2 ** ad2)/2]]];
t["twoAnnb", BosonicExpSimplify[a2 ** Exp[-(z11 ad1 ** ad1 + 2 z12 ad1 ** ad2 + z22 ad2 ** ad2)/2]]];
t["twoGen", BosonicExpOrder[Exp[rr Exp[I ph] ad1 ** ad2 - rr Exp[-I ph] a1 ** a2]]];
t["sq", SqueezeOperator[xi, Infinity, "Ordering" -> "Normal"]];
t["sqA", SqueezeOperator[xi, Infinity, "Ordering" -> "Antinormal"]];
t["sqExpOrd", BosonicExpOrder[Exp[(rr Exp[-I th] a ** a - rr Exp[I th] ad ** ad)/2]]];
t["sqExpOrdA", BosonicExpOrder[Exp[(rr Exp[-I th] a ** a - rr Exp[I th] ad ** ad)/2], "Ordering" -> "Antinormal"]];
t["Dn", DisplacementOperator[al, Infinity, "Ordering" -> "Normal"]];
t["Da", DisplacementOperator[al, Infinity, "Ordering" -> "Antinormal"]];
t["DnA", BosonicExpOrder[Exp[al ad - Conjugate[al] a]]];
t["posFac", BosonicExpSimplify[Exp[I P (a + ad)/Sqrt[2]] ** Exp[-I Q (a - ad)/(I Sqrt[2])]]];
t["chiN", BosonicExpSimplify[Exp[g ad] ** Exp[-Conjugate[g] a]]];
t["chiA", BosonicExpSimplify[Exp[-Conjugate[g] a] ** Exp[g ad]]];
t["nThermalCoh", BosonicMatrixElement[{al, be}, Exp[lam ad ** a], "Basis" -> "Coherent"]];
t["pq", BosonicNormalOrder[((a - ad)/(I Sqrt[2])) ** ((a + ad)/Sqrt[2]) + ((a + ad)/Sqrt[2]) ** ((a - ad)/(I Sqrt[2]))]];
t["DmeInt", Table[BosonicMatrixElement[{m, n}, DisplacementOperator[g]], {m, 0, 1}, {n, 0, 2}]];
t["conjK", BosonicExpSimplify[Exp[z ad ** ad/2] ** (a ** a/2) ** Exp[-z ad ** ad/2]]];
WriteString["stdout", ToString[InputForm[r]], "\n"];
