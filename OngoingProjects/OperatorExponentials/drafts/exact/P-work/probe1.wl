{a, ad} = FieldVariables[{1}];
r = <||>;
t[k_, e_] := (r[k] = TimeConstrained[e, 60]);
SetAttributes[t, HoldRest];
t["D", DisplacementOperator[al, Infinity]];
t["Dprod", BosonicExpSimplify[DisplacementOperator[al, Infinity] ** DisplacementOperator[be, Infinity]]];
t["Dswap", BosonicExpSimplify[DisplacementOperator[be, Infinity] ** DisplacementOperator[al, Infinity]]];
t["Dgc", BosonicExpSimplify[DisplacementOperator[al, Infinity] ** DisplacementOperator[be, Infinity] ** DisplacementOperator[-al, Infinity] ** DisplacementOperator[-be, Infinity]]];
t["ladder", Table[BosonicMatrixElement[{m, n}, a], {m, 0, 2}, {n, 0, 2}]];
t["ladderSym", BosonicMatrixElement[{m, n}, a]];
t["ladderSymAd", BosonicMatrixElement[{m, n}, ad]];
t["coh", BosonicMatrixElement[{n, 0}, Exp[al ad]]];
t["cohOv", BosonicMatrixElement[{0, 0}, Exp[cb a] ** Exp[be ad]]];
t["eig", BosonicExpSimplify[a ** Exp[al ad]]];
t["conjAd", BosonicExpSimplify[Exp[-alb a] ** ad ** Exp[alb a]]];
t["DmeSym", BosonicMatrixElement[{m, n}, DisplacementOperator[g]]];
t["DmeNN", BosonicMatrixElement[{n, n}, DisplacementOperator[g]]];
t["Dme11", BosonicMatrixElement[{1, 1}, DisplacementOperator[g]]];
t["QD", BosonicMatrixElement[{0, 0}, Exp[cal a] ** DisplacementOperator[g, Infinity] ** Exp[al ad]]];
t["QD2", BosonicMatrixElement[{0, 0}, BosonicExpOrder[Exp[cal a] ** DisplacementOperator[g, Infinity] ** Exp[al ad]]]];
t["QD3", BosonicExpSimplify[Exp[cal a] ** DisplacementOperator[g, Infinity] ** Exp[al ad]]];
t["vev", BosonicVEV[BosonicExpOrder[Exp[cal a] ** DisplacementOperator[g, Infinity] ** Exp[al ad]]]];
t["parity", BosonicExpSimplify[Exp[I Pi ad ** a] ** a ** Exp[-I Pi ad ** a]]];
t["parityD", BosonicExpSimplify[Exp[I Pi ad ** a] ** DisplacementOperator[al, Infinity] ** Exp[-I Pi ad ** a]]];
t["affine", BosonicMatrixElement[{0, 0}, Exp[cz/2 a ** a + ca a] ** Exp[z/2 ad ** ad + al ad]]];
t["affine2", BosonicExpOrder[Exp[cz/2 a ** a + ca a] ** Exp[z/2 ad ** ad + al ad]]];
t["sqOv", BosonicMatrixElement[{0, 0}, Exp[x a ** a] ** Exp[y ad ** ad]]];
t["cohOff", BosonicMatrixElement[{al, be}, ad ** a, "Basis" -> "Coherent"]];
WriteString["stdout", ToString[InputForm[r]], "\n"];
