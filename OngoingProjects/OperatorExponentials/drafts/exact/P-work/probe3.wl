{a, ad} = FieldVariables[{1}];
{a1, ad1, a2, ad2} = FieldVariables[{1, 2}];
r = <||>;
t[k_, e_] := (r[k] = TimeConstrained[e, 60]);
SetAttributes[t, HoldRest];
dn[al_, alb_] := Exp[-al alb/2] Exp[al ad] ** Exp[-alb a];
t["Dder", D[dn[al, alb], al]];
t["Dder2", D[dn[al, alb], alb]];
t["simp", Simplify[BosonicExpOrder[Exp[(rr Exp[-I th] a ** a - rr Exp[I th] ad ** ad)/2]], rr > 0]];
t["pq", BosonicNormalOrder[((a - ad)/(I Sqrt[2])) ** ((a + ad)/Sqrt[2]) + ((a + ad)/Sqrt[2]) ** ((a - ad)/(I Sqrt[2])), {a, ad}]];
t["sqVac", BosonicMatrixElement[{0, 0}, SqueezeOperator[xi]]];
t["mm", BosonicMatrixElement[{{0, 0}, {0, 0}}, (a1 ** a2) ** (ad1 ** ad2)]];
t["mm3", BosonicMatrixElement[{{3, 3}, {0, 0}}, ad1 ** ad1 ** ad1 ** ad2 ** ad2 ** ad2]];
t["vevTwo", BosonicVEV[(x a1 ** a2)**(x a1 ** a2) ** (y ad1 ** ad2) ** (y ad1 ** ad2)]];
t["DD", BosonicExpSimplify[DisplacementOperator[al, Infinity] ** DisplacementOperator[-al, Infinity]]];
t["DDsame", BosonicExpSimplify[DisplacementOperator[al, Infinity] ** DisplacementOperator[al, Infinity]]];
t["poly3", BosonicExpSimplify[DisplacementOperator[g, Infinity] ** DisplacementOperator[be, Infinity] ** DisplacementOperator[al, Infinity] ** DisplacementOperator[-(al + be + g), Infinity]]];
t["conjLin", BosonicExpSimplify[Exp[-al ad] ** a ** Exp[al ad]]];
t["affE", BosonicExpSimplify[Exp[ca a] ** Exp[z/2 ad ** ad] ** Exp[-ca a]]];
WriteString["stdout", ToString[InputForm[r]], "\n"];
