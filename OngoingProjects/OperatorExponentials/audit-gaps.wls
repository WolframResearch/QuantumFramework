PacletDirectoryLoad[FileNameJoin[{DirectoryName[$InputFileName, 3], "QuantumFramework"}]];
Needs["Wolfram`QuantumFramework`"]; Needs["Wolfram`QuantumFramework`SecondQuantization`"];
p[label_, e_] := Print[StringPadRight[label, 46], Short[InputForm[TimeConstrained[Quiet[e], 120, "TIMEOUT"]], 2]]; SetAttributes[p, HoldRest];
v = {{bd}, {b}}; v2 = {{bd1, bd2}, {b1, b2}}; nn = bd ** b;
p["<0|0^(-n)|0>   (want 1)", BosonicMatrixElement[{0, 0}, 0^(-nn), v]];
p["<1|0^(n-1)|1>  (want 1)", BosonicMatrixElement[{1, 1}, 0^(nn - 1), v]];
p["list, default method", BosonicNormalOrder[{b ** bd, bd ** b}, v]];
p["list, Blasiak", BosonicNormalOrder[{b ** bd, bd ** b}, v, Method -> "Blasiak"]];
p["list, BosonicVEV", BosonicVEV[{b ** bd, bd ** b}, v]];
p["<m|D(al)|m> symbolic m", BosonicMatrixElement[{m, m}, DisplacementOperator[al]]];
p["<2m|S(xi)|0> symbolic m", BosonicMatrixElement[{2 m, 0}, SqueezeOperator[xi]]];
p["ExpOrder exp(c n + linear)", BosonicExpOrder[Exp[c nn + x bd + y b], v]];
p["ExpOrder Kerr exp(l n^2)", BosonicExpOrder[Exp[l nn ** nn], v]];
p["ExpOrder exp(-(w+mu) n)", BosonicExpOrder[Exp[-(w + mu) nn], v]];
p["ExpSimplify S (a + f) S^-1", BosonicExpSimplify[Exp[(xc b ** b - x bd ** bd)/2] ** (b + f) ** Exp[-(xc b ** b - x bd ** bd)/2], v]];
p["ExpSimplify mixed quad+linear generator", BosonicExpSimplify[Exp[x bd ** bd + y bd] ** b ** Exp[-(x bd ** bd + y bd)], v]];
p["ExpSimplify S(xi) ** S(-xi)", BosonicExpSimplify[Exp[(xc b ** b - x bd ** bd)/2] ** Exp[-(xc b ** b - x bd ** bd)/2], v]];
p["ExpSimplify 2-mode general squeeze", BosonicExpSimplify[Exp[z11 bd1 ** bd1 + z12 bd1 ** bd2 + z22 bd2 ** bd2 - (zc11 b1 ** b1 + zc12 b1 ** b2 + zc22 b2 ** b2)] ** b1 ** Exp[-(z11 bd1 ** bd1 + z12 bd1 ** bd2 + z22 bd2 ** bd2 - (zc11 b1 ** b1 + zc12 b1 ** b2 + zc22 b2 ** b2))], v2]];
p["VEV of D ** D", BosonicVEV[Exp[al bd - alc b] ** Exp[be bd - bec b], v]];
