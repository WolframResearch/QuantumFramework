a92e29c3ab11"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"initial", "=", 
     RowBox[{"DensityPlot", "[", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x", "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}]}], ")"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotPoints", "->", "50"}], ",", 
       RowBox[{"ColorFunction", "->", "\"\<SunsetColors\>\""}]}], "]"}]}], 
    "}"}], ",", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{"initial", ",", 
       RowBox[{"Quiet", "@", 
        RowBox[{"ContourPlot", "[", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", 
                RowBox[{"R", " ", 
                 RowBox[{"Cos", "[", 
                  RowBox[{"2", "\[Pi]", " ", "\[Tau]"}], "]"}]}]}], ")"}], 
              "^", "2"}]}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"y", "-", 
               RowBox[{"R", " ", 
                RowBox[{"Sin", "[", 
                 RowBox[{"2", "\[Pi]", " ", "\[Tau]"}], "]"}]}]}], ")"}], "^",
              "2"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"ContourShading", "->", "None"}], ",", 
          RowBox[{"PlotPoints", "->", "100"}], ",", 
          RowBox[{"ContourStyle", "->", "Red"}]}], "]"}]}], ",", 
       RowBox[{"ParametricPlot", "[", 
        RowBox[{
         RowBox[{"R", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", 
             RowBox[{"2", "\[Pi]", " ", "u"}], "]"}], ",", 
            RowBox[{"Sin", "[", 
             RowBox[{"2", "\[Pi]", " ", "u"}], "]"}]}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"u", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Dotted", ",", "Green"}], "]"}]}]}], "]"}], ",", 
       RowBox[{
       "PlotLabel", "->", 
        "\"\<Perturbation wrt the initial wavefunction\>\""}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]", ",", "0", ",", "3"}], "}"}], ",", 
     RowBox[{"SaveDefinitions", "->", "True"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9421040034722357`*^9, 3.9421040238302402`*^9}, {
