Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[ScriptCapitalH]", "==", "0"}], ",", "ic"}], "}"}], ",", 
      "\[CapitalPsi]", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "20"}], ",", "20"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<PDEDiscretization\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<MethodOfLines\>\"", ",", 
           RowBox[{"\"\<SpatialDiscretization\>\"", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<FiniteElement\>\"", ",", 
              RowBox[{"\"\<MeshOptions\>\"", "->", 
               RowBox[{"\"\<MaxCellMeasure\>\"", "->", ".2"}]}]}], "}"}]}]}], 
          "}"}]}], "}"}]}]}], "]"}]}], ";"}], "//", 
  "AbsoluteTiming"}]], "Input",
