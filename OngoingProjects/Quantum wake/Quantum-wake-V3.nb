Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"initial", "=", 
     RowBox[{"DensityPlot", "[", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x", "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}]}], ")"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "15"}], ",", "15"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotPoints", "->", "50"}], ",", 
       RowBox[{"ColorFunction", "->", "\"\<SunsetColors\>\""}]}], "]"}]}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{"initial", ",", 
       RowBox[{"Quiet", "@", 
        RowBox[{"ContourPlot", "[", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", 
                RowBox[{"7", " ", "\[Tau]"}], "+", "7"}], ")"}], "^", "2"}]}],
             "-", 
            SuperscriptBox[
             RowBox[{"(", "y", ")"}], "2"]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"-", "15"}], ",", "15"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"ContourShading", "->", "None"}], ",", 
          RowBox[{"PlotPoints", "->", "50"}], ",", 
          RowBox[{"ContourStyle", "->", "Red"}]}], "]"}]}], ",", 
       RowBox[{"ParametricPlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"7", "u"}], "-", "7"}], ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"u", ",", "0", ",", "3"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Dotted", ",", "Green"}], "]"}]}]}], "]"}], ",", 
       RowBox[{
       "PlotLabel", "->", 
        "\"\<Perturbation wrt the initial wavefunction\>\""}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]", ",", "0", ",", "3"}], "}"}], ",", 
     RowBox[{"SaveDefinitions", "->", "True"}]}], "]"}]}], "]"}]], "Input",
