Cell["Hamiltonian:", "Text",
 CellChangeTimes->{{3.942088970333037*^9, 
  3.942088973375078*^9}},ExpressionUUID->"05ee8930-2cab-4ad8-b8e0-\
b3699d9f6067"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalH]", "=", 
   RowBox[{"SchrodingerPDEComponent", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalPsi]", "[", 
        RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", "t", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}]}], "}"}], ",", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<ReducedPlanckConstant\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<SchrodingerPotential\>\"", "->", 
        RowBox[{
         RowBox[{"3", 
          RowBox[{"\[CapitalPsi]", "[", 
           RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
          RowBox[{"Conjugate", "[", 
           RowBox[{"\[CapitalPsi]", "[", 
            RowBox[{"t", ",", "x", ",", "y"}], "]"}], "]"}]}], "+", 
         RowBox[{".5", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"x", "^", "2"}], "+", 
            RowBox[{"y", "^", "2"}]}], ")"}]}], "-", 
         RowBox[{"29", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", 
                RowBox[{"7", " ", "t"}], "+", "7"}], ")"}], "^", "2"}]}], "-", 
            SuperscriptBox[
             RowBox[{"(", "y", ")"}], "2"]}], "]"}]}]}]}]}], "|>"}]}], 
    "]"}]}], ";"}]], "Input",
