Cell["Hamiltonian:", "Text",
 CellChangeTimes->{{3.9420891060841923`*^9, 
  3.942089111114616*^9}},ExpressionUUID->"4dc1351f-3b06-4b61-befd-\
0aa399c44664"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalH]", "=", 
   RowBox[{"SchrodingerPDEComponent", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalPsi]", "[", 
        RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", "t", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}]}], "}"}], ",", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<ReducedPlanckConstant\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<SchrodingerPotential\>\"", "->", 
        RowBox[{
         RowBox[{"3", 
          RowBox[{"\[CapitalPsi]", "[", 
           RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
          RowBox[{"Conjugate", "[", 
           RowBox[{"\[CapitalPsi]", "[", 
            RowBox[{"t", ",", "x", ",", "y"}], "]"}], "]"}]}], "+", 
         RowBox[{".5", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"x", "^", "2"}], "+", 
            RowBox[{"y", "^", "2"}]}], ")"}]}], "-", 
         RowBox[{"29", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", 
                RowBox[{"R", " ", 
                 RowBox[{"Cos", "[", 
                  RowBox[{"2", "\[Pi]", " ", "t"}], "]"}]}]}], ")"}], "^", 
              "2"}]}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"y", "-", 
               RowBox[{"R", " ", 
                RowBox[{"Sin", "[", 
                 RowBox[{"2", "\[Pi]", " ", "t"}], "]"}]}]}], ")"}], "^", 
             "2"}]}], "]"}]}]}]}]}], "|>"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.914521267147268*^9, 3.914521285987202*^9}, {
