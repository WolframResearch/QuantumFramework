Cell["Get a snapshots of evolution:", "Text",
 CellChangeTimes->{{3.942089008262026*^9, 
  3.94208901332158*^9}},ExpressionUUID->"168d23ad-7b38-4ec5-92c4-\
9913e451963b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"imgs", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"DensityPlot", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"sol", "[", 
         RowBox[{"#", ",", "x", ",", "y"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "12"}], ",", "12"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "12"}], ",", "12"}], "}"}], ",", 
       RowBox[{"PlotPoints", "\[Rule]", "150"}], ",", 
       RowBox[{"ColorFunction", "\[Rule]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"ColorData", "[", "\"\<SunsetColors\>\"", "]"}], "[", 
           RowBox[{"Sqrt", "[", "#", "]"}], "]"}], "&"}], ")"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}], "&"}], "/@", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "2", ",", ".1"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.941917199828916*^9, 3.941917237021446*^9}, {
   3.941977546960231*^9, 3.941977548784176*^9}, {3.941977610288997*^9, 
