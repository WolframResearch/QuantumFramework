Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalH]", "=", 
   RowBox[{"SchrodingerPDEComponent", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalPsi]", "[", 
        RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", "t", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}]}], "}"}], ",", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<ReducedPlanckConstant\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<SchrodingerPotential\>\"", "->", 
        RowBox[{
         RowBox[{"3", 
          RowBox[{"\[CapitalPsi]", "[", 
           RowBox[{"t", ",", "x", ",", "y"}], "]"}], 
          RowBox[{"Conjugate", "[", 
           RowBox[{"\[CapitalPsi]", "[", 
            RowBox[{"t", ",", "x", ",", "y"}], "]"}], "]"}]}], "+", 
         RowBox[{".5", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"x", "^", "2"}], "+", 
            RowBox[{"y", "^", "2"}]}], ")"}]}], "-", 
         RowBox[{"29", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", "-", 
                RowBox[{"t", " ", 
                 RowBox[{"Cos", "[", 
                  RowBox[{"2", "\[Pi]", " ", "t"}], "]"}]}]}], ")"}], "^", 
              "2"}]}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"y", "-", 
               RowBox[{"t", " ", 
                RowBox[{"Sin", "[", 
                 RowBox[{"2", "\[Pi]", " ", "t"}], "]"}]}]}], ")"}], "^", 
             "2"}]}], "]"}]}]}]}]}], "|>"}]}], "]"}]}], ";"}]], "Input",
