 CellID->631769182,ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell[TextData[StyleBox["Tier 2 - Oracles.",
 FontWeight->"Bold"]], "Text",
 CellID->1873681340,ExpressionUUID->"26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],

Cell["Oracles", "Section",
 CellID->1468251080,ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],

Cell[TextData[{
 "An oracle is the black box the search and query algorithms compile to: it \
marks the basis states that satisfy a Boolean condition. The named oracles \
differ in ",
 StyleBox["how", "TI"],
 " they mark: flip a target qubit, flip a sign, rotate a target, or load a \
whole function of the input. The first three take a Boolean formula and \
variable-placement arguments; ",
 Cell[BoxData["GrayOracle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b853673-18d0-d9fa-19ba-a83d996aabc0"],
 " instead takes a function or angle list, a precision, a target, and a \
rotation axis."
}], "Text",
 CellID->1989234463,ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"],

Cell[TextData[{
 "Flag oracle: ",
 Cell[BoxData["BooleanOracle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "574a2197-51ef-7938-7d49-b8d1679a4802"]
}], "Subsection",
 CellID->1607696641,ExpressionUUID->"6e85e9ed-427b-8528-16ba-00b7770fec72"],

Cell["\<\
Flipping the target on the states that satisfy a formula, here a single \
multi-controlled gate for the one product term:\
\>", "Text",
 CellID->1817342824,ExpressionUUID->"73b76025-96bb-3fff-214d-798f234f85c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BooleanOracle\>\"", "[", 
     RowBox[{
      RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
      RowBox[{"\[FormalX]", "[", "2", "]"}], " ", "&&", " ", 
      RowBox[{"\[FormalX]", "[", "3", "]"}]}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[47]:= ",
 CellID->530774412,ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"],

Cell["\<\
A sum of exclusive-or terms compiles to one controlled gate per term (the \
ESOP form), so the gate count tracks the formula:\
\>", "Text",
 CellID->599957810,ExpressionUUID->"72ff7667-e560-b2c0-2285-68408c1a002a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BooleanOracle\>\"", "[", 
     RowBox[{"Xor", "[", 
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], ",", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}]}], "]"}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[48]:= ",
 CellID->1899946997,ExpressionUUID->"7c9be80e-0554-61c1-24b8-0268ace1332b"],

Cell["\<\
A variable-to-wire list placing the variables on wires 1 and 3, leaving wire \
2 idle and the target on wire 4:\
\>", "Text",
 CellID->1051619128,ExpressionUUID->"106b7ad8-6378-599b-4069-7382160d2be1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BooleanOracle\>\"", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "||", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[49]:= ",
 CellID->1921351195,ExpressionUUID->"7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],

Cell["\<\
An integer in the second slot sets the target wire, here wire 5, leaving the \
variables on 1,2 and wires 3,4 idle:\
\>", "Text",
 CellID->1207491739,ExpressionUUID->"304452a4-201b-d64c-607c-4b0e51afbc96"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BooleanOracle\>\"", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
       RowBox[{"!", " ", 
        RowBox[{"\[FormalX]", "[", "2", "]"}]}]}], ",", " ", "5"}], "]"}], 
    "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[50]:= ",
 CellID->216741342,ExpressionUUID->"6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],

Cell[TextData[{
 "An operator in the second slot becomes the marking gate, turning the oracle \
into a controlled-",
 StyleBox["U", "TI"],
 " that applies an arbitrary unitary to the target on the satisfying states:"
}], "Text",
 CellID->2096934290,ExpressionUUID->"4b5b9263-9199-4e16-7978-144d202c157c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BooleanOracle\>\"", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"!", " ", 
        RowBox[{"\[FormalX]", "[", "1", "]"}]}], " ", "&&", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}]}], ",", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"\"\<RandomUnitary\>\"", ",", " ", 
        RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<U\>\""}]}], "]"}]}], 
     "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[51]:= ",
 CellID->1367217003,ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"],

Cell[TextData[{
 "Phase oracle: ",
 Cell[BoxData["PhaseOracle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"]
}], "Subsection",
 CellID->1372538143,ExpressionUUID->"3343f580-98d5-e31c-6170-ecea1961ce66"],

Cell["\<\
Flipping the sign of the satisfying states with no ancilla (width 2, not 3):\
\>", "Text",
 CellID->485911656,ExpressionUUID->"20a7420b-376a-b23f-505d-6455421c0105"],

