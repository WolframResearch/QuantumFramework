 CellID->1335749844,ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c"],

Cell[TextData[{
 "The ",
 Cell[BoxData["PowerExpand"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52243646-2fbd-210e-03db-a8204a487054"],
 " option replaces each controlled ",
 Cell[BoxData[
  RowBox[{"U", "^", 
   RowBox[{"(", 
    RowBox[{"2", "^", "k"}], ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1acd7f4d-3da3-7753-4af3-7717b4565db9"],
 " by ",
 Cell[BoxData[
  RowBox[{"2", "^", "k"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "062d91f0-6326-41c0-2fd2-08ba16d3132a"],
 " repeated controlled-",
 Cell[BoxData["U"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],
 " gates:"
}], "Text",
 CellID->793802945,ExpressionUUID->"6f6ad260-8ee1-565a-1569-d44a2a943ca0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<PhaseEstimation\>\"", "[", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", "\"\<T\>\"", "]"}], ",", " ", "3", ",", 
      " ", 
      RowBox[{"\"\<PowerExpand\>\"", " ", "->", " ", "True"}]}], "]"}], "}"}],
    "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
