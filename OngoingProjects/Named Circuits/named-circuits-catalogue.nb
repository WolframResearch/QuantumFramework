 CellLabel->"In[57]:= ",
 CellID->41202278,ExpressionUUID->"0513e607-0f4c-1e20-3320-f861aaf9650a"],

Cell["\<\
A fourth argument sets the axis and angle of the marking rotation:\
\>", "Text",
 CellID->1124146653,ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BooleanOracleR\>\"", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"!", " ", 
        RowBox[{"\[FormalX]", "[", "1", "]"}]}], " ", "&&", " ", 
       RowBox[{"!", " ", 
        RowBox[{"\[FormalX]", "[", "2", "]"}]}]}], ",", " ", "Automatic", ",",
