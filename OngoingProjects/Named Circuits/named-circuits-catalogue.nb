  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "034d641c-5834-e412-3173-7e4659c6cf78"],
 "; pairing a phase oracle with the plain ",
 Cell[BoxData["Grover"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 " instead would mismatch the diffusion):"
}], "Text",
 CellID->496109794,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<GroverPhase\>\"", "[", 
    RowBox[{"QuantumOperator", "[", "\"\<CZ\>\"", "]"}], "]"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->108435171,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell["\<\
The phase-oracle search step, which marks by sign flip on the data wires and \
so needs no ancilla:\
\>", "Text",
 CellID->829388421,ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
