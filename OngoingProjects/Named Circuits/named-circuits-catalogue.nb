    RowBox[{"\"\<BooleanOracleR\>\"", "[", 
     RowBox[{
      RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
      RowBox[{"\[FormalX]", "[", "2", "]"}]}], "]"}], "}"}], "]"}], 
