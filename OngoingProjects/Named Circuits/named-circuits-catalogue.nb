Cell["Does it search?", "Subsection",
 CellID->176337227,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell[TextData[{
 "Two phase-Grover iterations on the uniform superposition concentrate the \
probability on the marked ",
 Cell[BoxData[
  TemplateBox[{"111"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 ":"
}], "Text",
 CellID->807053435,ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Nest", "[", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"\"\<GroverPhase\>\"", "[", 
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}], " ", "&&", " ", 
       RowBox[{"\[FormalX]", "[", "3", "]"}]}], "]"}], "]"}], ",", " ", 
    RowBox[{"QuantumState", "[", "\"\<+++\>\"", "]"}], ",", " ", "2"}], "]"}],
   "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->1633675818,ExpressionUUID->"644cc522-c7c4-9b18-0c73-dc8ff276e662"],

Cell["Deutsch and Deutsch-Jozsa", "Section",
 CellID->1828793009,ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],

Cell[TextData[{
 "Deutsch-Jozsa decides, for a function ",
 StyleBox["promised", "TI"],
 " to be either constant or balanced, which of the two it is in a single \
query. The named circuit assembles the oracle, the surrounding Hadamard \
layers, and the final measurement. The function argument does not enforce the \
promise: a formula or an integer indexes a general truth table, and ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 " draws from all Boolean functions (for three inputs only 72 of 256 are \
constant or balanced), so a random draw can be a valid circuit on an invalid \
problem instance. The explicit examples below pick balanced or constant \
functions; the ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0daf8e98-7628-e40b-3b54-27c203c2cf51"],
 " example does not enforce the promise. Each algorithm comes in a ",
 StyleBox["boolean", "TI"],
 " form (bit-flip oracle plus a ",
 Cell[BoxData[
  TemplateBox[{"-"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 " ancilla) and a ",
 StyleBox["phase", "TI"],
 " form (phase oracle, no ancilla); both read the input register out in the X \
basis."
}], "Text",
 CellID->1232986364,ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

Cell["Deutsch: one qubit", "Subsection",
 CellID->762269937,ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell[TextData[{
 "The balanced case, with the oracle ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"f", 
