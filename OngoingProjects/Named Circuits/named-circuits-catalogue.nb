 Cell[BoxData[
  RowBox[{"J", "+"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b78534b-7a52-d624-5918-4b157fe4bd0e"]
}], "Subsection",
 CellID->1767337052,ExpressionUUID->"30c454b2-bdb8-e427-60fc-4dfc3432cf0d"],

Cell[TextData[{
 "The spin-1 raising operator, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], "+"], 
    TemplateBox[{
      StyleBox["m", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    SqrtBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["j", "TI"], "-", 
       StyleBox["m", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["j", "TI"], "+", 
       StyleBox["m", "TI"], "+", "1"}], 
      StyleBox[")",
       SpanMaxSize->1]}]], 
    TemplateBox[{
      RowBox[{
        StyleBox["m", "TI"], "+", "1"}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6879dfe8-0276-0c7b-1806-d6b2b7035741"],
 " with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["J", "TI"], "+"], 
    TemplateBox[{
      RowBox[{
        StyleBox["j", "TI"], ",", 
        StyleBox["j", "TI"]}]},
     "Ket"]}], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cc522fa-6a93-e579-24fa-bba40f27cc43"],
 "; for spin 1 the nonzero coefficients are ",
 Cell[BoxData[
  SqrtBox["2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b82e386-6ff5-c0ee-09b1-fae009819234"],
 ":"
}], "Text",
 CellID->1422053341,ExpressionUUID->"34a39a2f-b372-ffce-5c50-1388c604c514"],

