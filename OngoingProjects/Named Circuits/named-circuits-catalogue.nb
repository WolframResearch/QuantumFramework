 CellID->695529426,ExpressionUUID->"4139b36b-52b1-2977-70c6-2b356744785d"],

Cell[TextData[StyleBox["Tier 4 - Beyond unitary gates.",
 FontWeight->"Bold"]], "Text",
 CellID->767788723,ExpressionUUID->"494d6e39-7750-b6eb-7f72-806302ea1c31"],

Cell["Nonclassicality Tests", "Section",
 CellID->494419947,ExpressionUUID->"39b01e29-d171-5c92-6f4f-9072e00426f8"],

Cell[TextData[{
 "These circuits stage the standard tests that separate quantum correlations \
from classical ones: a spatial Bell test, its temporal analogue, and a \
phase-space version. Each is parametrized by a single measurement angle, with \
the Alice, Bob, and Charlie roles laid out as labelled sub-circuits, \
barrier-separated in the spatial and temporal tests. The page builds the \
measurement circuits; the correlation value and its classical bound (for \
CHSH, the ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f6d713e-2461-11c8-7513-69784d146312"],
 " Tsirelson violation of the bound 2) are a classical post-processing step \
on the outcome statistics, not computed here."
}], "Text",
 CellID->1581507689,ExpressionUUID->"14ad582f-66ff-93eb-3c53-5189128be131"],

Cell[TextData[{
 "Spatial Bell test: ",
 Cell[BoxData["CHSH"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f7ea056-2d28-85ec-7505-3a1044c2ef36"]
}], "Subsection",
 CellID->2120100675,ExpressionUUID->"16b00368-b832-202d-3e4f-9b3239c77377"],

Cell["\<\
The CHSH Bell test: a shared entangled pair, Charlie's preparation, and Alice \
and Bob's measurements, with Bob's rotation carrying the angle, ending in \
four readouts:\
\>", "Text",
 CellID->950326543,ExpressionUUID->"06d00634-a672-f252-2eef-9871d304c0b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<CHSH\>\"", "[", "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"", 
  "]"}]], "Input",
 CellLabel->"In[72]:= ",
 CellID->1689126594,ExpressionUUID->"05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],

Cell["\<\
The measurement angle is the single knob; setting it changes Bob's rotation:\
\>", "Text",
 CellID->1490757098,ExpressionUUID->"583a98af-415b-100e-09d9-110970ee6354"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<CHSH\>\"", "[", 
     RowBox[{"Pi", "/", "3"}], "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"", 
  "]"}]], "Input",
 CellLabel->"In[73]:= ",
 CellID->148290444,ExpressionUUID->"07beae85-a317-6bf9-2d45-47eed6a239c3"],

Cell[TextData[{
 "Temporal Bell test: ",
 Cell[BoxData["LeggettGarg"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"]
}], "Subsection",
 CellID->1707667820,ExpressionUUID->"60049622-f570-0e0e-103b-0f8ffc055554"],

Cell["\<\
The temporal analogue of CHSH, correlating measurements of one system at \
different times rather than two systems in space:\
\>", "Text",
 CellID->933399197,ExpressionUUID->"40ea559d-da93-7842-70ea-4cc6df264aa8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<LeggettGarg\>\"", "[", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[74]:= ",
 CellID->955179929,ExpressionUUID->"23ccc6ee-92c0-e596-51f3-dfc8277acffc"],

Cell[TextData[{
 "Phase-space Bell test: ",
 Cell[BoxData["WignerCHSH"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "114d8d02-b276-9c05-4772-256fc700e76f"]
}], "Subsection",
 CellID->775067320,ExpressionUUID->"2dc22b63-32d1-862f-5bf1-c34d4765ed75"],

Cell[TextData[{
 "The CHSH test built on the Wigner minimal informationally complete basis, a \
discrete phase-space ",
 StyleBox["representation", "TI"],
 " of the qubit, rather than a physical measurement of phase space:"
}], "Text",
 CellID->72268088,ExpressionUUID->"36ea7e2c-072a-2221-5eea-7076b2df710b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<WignerCHSH\>\"", "[", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[75]:= ",
 CellID->546416532,ExpressionUUID->"5b23761c-2477-64e8-0ad1-68464d024e32"],

Cell["Non-Unitary Elements", "Section",
 CellID->2117784656,ExpressionUUID->"73216bcf-7cf1-61ac-22de-82a9748433f6"],

Cell["\<\
Not every circuit element is a unitary gate. A circuit can also measure a \
wire, reset it, trace it out, or discard it. Each of these is a named element \
whose action on a state is described below, not just drawn as a diagram.\
\>", "Text",
 CellID->853117843,ExpressionUUID->"69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],

Cell[TextData[{
 "Measurement: ",
 Cell[BoxData["Measurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "409bca18-cbd6-e54d-70b8-ec45ee60cf97"]
}], "Subsection",
 CellID->623836386,ExpressionUUID->"10b62b5f-1d3f-f012-404d-c31994cbc378"],

Cell[TextData[{
 "An unrecorded projective measurement on wire 1; applied to ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79984792-c453-565a-2fb8-5edfede63ca0"],
 " it returns the maximally mixed state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d45428e-8fa1-6801-4b7b-5be82a543b6b"],
 ":"
}], "Text",
 CellID->564394165,ExpressionUUID->"604bb87d-3174-a116-1048-32274006f07c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Measurement\>\"", "[", "1", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[76]:= ",
 CellID->2048244887,ExpressionUUID->"763191a2-6f8b-197a-1fce-080c0a3e6840"],

Cell[TextData[{
 "Acting on ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "635fdfdb-2856-deda-1164-d68549e0a420"],
 ", the density matrix is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],
 ": the coherence is gone:"
}], "Text",
 CellID->1432457359,ExpressionUUID->"5c8469dd-bfc7-2a7a-04bb-80873a727940"],

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Measurement\>\"", "[", "1", "]"}], "}"}], "]"}], "[", 
    RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], "]"}], 
   "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[77]:= ",
 CellID->200346680,ExpressionUUID->"182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],

Cell[TextData[{
 "Reset: ",
 Cell[BoxData["Reset"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3921e4bb-f5e4-3596-68de-fde483969ffc"]
}], "Subsection",
 CellID->447384324,ExpressionUUID->"13db9173-5387-1c16-41f8-093d6632677c"],

Cell[TextData[{
 "Resets a wire to ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6804c0ab-fd16-b7db-183b-d9f4f4a01d21"],
 " regardless of its input, so ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],
 " becomes ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0"},
    "Ket"], 
   TemplateBox[{"0"},
    "Bra"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4289b0c6-8043-1b93-72b6-29a031f669f9"],
 ":"
}], "Text",
 CellID->1438124241,ExpressionUUID->"070f3e08-556d-9d60-2d34-b0525c19e44a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Reset\>\"", "[", "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"",
   "]"}]], "Input",
 CellLabel->"In[78]:= ",
 CellID->2000382747,ExpressionUUID->"6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],

Cell[TextData[{
 "Partial trace: ",
 Cell[BoxData["Trace"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4140e475-1e41-1f16-777f-fe3f9bf4627c"]
}], "Subsection",
 CellID->902867877,ExpressionUUID->"67f13035-938c-831a-0d8e-aa7f263eee60"],

Cell["\<\
The partial trace over a wire, keeping the reduced state of the rest; tracing \
one half of a Bell pair leaves the other maximally mixed:\
\>", "Text",
 CellID->1315202099,ExpressionUUID->"16b44e14-0404-e868-3e4c-605eadb6bab2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Trace\>\"", "[", "2", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[79]:= ",
 CellID->376763343,ExpressionUUID->"70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],

Cell[TextData[{
 "Discard: ",
 Cell[BoxData["Discard"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e10bd94-ae42-3b4d-262f-34d1cbf48997"]
}], "Subsection",
 CellID->126027414,ExpressionUUID->"5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"],

Cell[TextData[{
 "The effect ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{"0", 
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{"+", 
      TemplateBox[{"1"},
       "Bra"]}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],
 " that contracts a wire's amplitudes, not a trace-preserving removal: it \
sends a Bell pair's kept wire to ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b734859-75e7-efa6-7901-62030393b58c"],
 " but maps ",
 Cell[BoxData[
  TemplateBox[{"-"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ae31c17-eefa-a706-7a90-96508a8c0a6c"],
 " to zero, so it carries a normalization or postselection caveat:"
}], "Text",
 CellID->570920987,ExpressionUUID->"00844d77-2817-3ec6-30bc-653149a3842c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Discard\>\"", "[", "2", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[80]:= ",
 CellID->378517449,ExpressionUUID->"20b97f64-b973-0c8a-5047-774e380656d0"],

Cell[TextData[{
 "Channel: ",
 Cell[BoxData["Channel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04469009-6b02-dcc3-2c7d-0a530eb4a629"]
}], "Subsection",
 CellID->1671903560,ExpressionUUID->"4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],

Cell[TextData[{
 "A completely positive map applied directly in the circuit (the strength \
nests inside the name, ",
 Cell[BoxData[
  RowBox[{"\"\<Depolarizing\>\"", "[", "p", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5547dfb6-0e84-e145-037c-d6f0ab36b3af"],
 "); the depolarizing channel at 3/10 partially mixes a pure input:"
}], "Text",
 CellID->1307059254,ExpressionUUID->"12b61bfc-9cd7-eca9-424d-92a61563b6f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Channel\>\"", "[", 
     RowBox[{"\"\<Depolarizing\>\"", "[", 
      RowBox[{"3", "/", "10"}], "]"}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[81]:= ",
 CellID->538512558,ExpressionUUID->"451364b5-819d-fb99-7321-7dff3029c9e3"],

Cell[TextData[{
 "Acting on ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13b49e24-0fb7-4441-414b-178eaa422eab"],
 " it damps the coherence rather than erasing it, giving ",
 Cell[BoxData[
  RowBox[{"(", GridBox[{
     {
      RowBox[{"1", "/", "2"}], 
      RowBox[{"7", "/", "20"}]},
     {
      RowBox[{"7", "/", "20"}], 
      RowBox[{"1", "/", "2"}]}
    }], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],
 ":"
}], "Text",
 CellID->824717693,ExpressionUUID->"089aa42d-ce49-3603-38b9-3e76ebfd9d69"],

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Channel\>\"", "[", 
       RowBox[{"\"\<Depolarizing\>\"", "[", 
        RowBox[{"3", "/", "10"}], "]"}], "]"}], "}"}], "]"}], "[", 
    RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], "]"}], 
   "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[82]:= ",
 CellID->496527141,ExpressionUUID->"48fccab3-b886-a0f7-7883-e3fd3930f2dd"],

Cell["Generators and the diagonal map", "Subsection",
 CellID->2009363188,ExpressionUUID->"0cdaad60-2181-5e26-34f9-454a5034250c"],

Cell[TextData[{
 "Two of these names are the one open-system generator in its two \
conventions. ",
 Cell[BoxData[
  RowBox[{"Hamiltonian", "[", 
   RowBox[{"H", ",", " ", 
    RowBox[{"{", "jumps", "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "542cff75-84e0-b601-7dd3-f73f2c9a1d6b"],
 " is the form ",
 Cell[BoxData["QuantumEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00dd9d4d-f7ec-565f-30e2-151681993ca5"],
 " consumes: the commutator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["H", "TI"], ",", "\[CenterDot]"}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],
 " for a closed system, and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], "\[ScriptCapitalL]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],
 ", with ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "333832e2-8bec-4128-62c7-abcc2d991072"],
 " the Lindblad generator, once jump operators are given. ",
 Cell[BoxData[
  RowBox[{"Liouvillian", "[", 
   RowBox[{"H", ",", " ", 
    RowBox[{"{", "jumps", "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78cf51d6-d7cd-4672-28f5-4893e2782d58"],
 " is ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],
 " itself, the bare generator of ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", "\[ScriptCapitalL]", 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "710db4a8-d877-0db2-2732-2df5d9025798"],
 ", equal to ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], "\[ThinSpace]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e12f72-3ad4-a92f-279e-c73cbf66f875"],
 Cell[BoxData[
  RowBox[{"Hamiltonian", "[", 
   RowBox[{"H", ",", " ", 
    RowBox[{"{", "jumps", "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ea8612-dd18-b4f0-2ee9-185fd4921eda"],
 "; reach for it when ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b02f270-2101-5c3d-3931-f43a50b42707"],
 " is wanted (its spectrum, say) rather than for ",
 Cell[BoxData["QuantumEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],
 ", which exponentiates ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],
 " times its argument. Evolving with ",
 Cell[BoxData[
  RowBox[{"Hamiltonian", "[", 
   RowBox[{"H", ",", " ", 
    RowBox[{"{", "jumps", "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],
 " and the separate Hamiltonian-and-jump-operator form ",
 Cell[BoxData[
  RowBox[{"QuantumEvolve", "[", 
   RowBox[{"H", ",", " ", 
    RowBox[{"{", "jumps", "}"}], ",", " ", "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],
 " give the same result. A third, ",
 Cell[BoxData["Decohere"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e73fafe-05d0-7203-6600-f3b8ac654169"],
 ", is not a generator at all but a dimension-reducing ",
 StyleBox["representation", "TI"],
 " map: the ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],
 " operator ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "{", "1"}], ",", 
   RowBox[{"0", ",", "0"}], ",", 
   RowBox[{"0", "}"}], ",", 
   RowBox[{"{", "0"}], ",", 
   RowBox[{"0", ",", "0"}], ",", 
   RowBox[{"1", "}", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c044c4-b778-74e1-42f0-5da1c20d5ecb"],
 " that pulls the diagonal from a doubled representation (4 amplitudes in, 2 \
out). Because its input and output dimensions differ it cannot serve as an \
evolution generator, and it is not a trace-preserving dephasing channel."
}], "Text",
 CellID->55669068,ExpressionUUID->"3d9aa029-60a8-273a-6bb9-3a7311428a00"],

Cell["Tensor-Network Atoms", "Section",
 CellID->1753574084,ExpressionUUID->"64adc082-4122-deff-0c52-d9ec70d4a4c5"],

Cell["\<\
These are the wire-level building blocks of the ZX and tensor-network \
calculus: bending a wire into a state or an effect, crossing two wires, \
copying a basis state, and the phase spider. Each caption states what the \
atom's matrix does, verified in the kernel.\
\>", "Text",
 CellID->2038359728,ExpressionUUID->"7e451771-8a55-ceec-267a-8f3b2fe19436"],

Cell[TextData[{
 "Cup: ",
 Cell[BoxData["Cup"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4670f053-f537-0b3f-6e0f-ea1cfcc25605"]
}], "Subsection",
 CellID->1525364821,ExpressionUUID->"330aabc0-bdd5-22a3-6109-42aa34607089"],

Cell[TextData[{
 "The cup bends a wire from two outputs, giving the unnormalized Bell state \
",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"00"},
    "Ket"], "+", 
   TemplateBox[{"11"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],
 ":"
}], "Text",
 CellID->1535108406,ExpressionUUID->"70d705b8-410a-1477-20ec-9ce270bf7f5d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Cup\>\"", "[", "2", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[83]:= ",
 CellID->1528788962,ExpressionUUID->"737c509e-bc52-eefb-2104-49d835e4b4c1"],

Cell[TextData[{
 "It has no inputs; its output state has amplitudes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", "0", ",", "0", ",", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01a44b6b-c85f-9e0e-375c-6334e9ebe554"],
 ":"
}], "Text",
 CellID->1505774531,ExpressionUUID->"10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Cup\>\"", "[", "2", "]"}], "}"}], "]"}], "[", "]"}], 
   "[", "\"\<StateVector\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[84]:= ",
 CellID->535490749,ExpressionUUID->"25120901-cfbc-a8e6-5321-a16aea4efacc"],

Cell[TextData[{
 "Cap: ",
 Cell[BoxData["Cap"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ee7491f-72c3-8814-669d-61590777db7e"]
}], "Subsection",
 CellID->1238905205,ExpressionUUID->"67860241-8011-89c8-0dbd-a42b31a5db12"],

Cell[TextData[{
 "The cap is the matching effect ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{"00", 
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{"+", 
      TemplateBox[{"11"},
       "Bra"]}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1318f44b-7a0d-b86f-4127-ee157fb90ab5"],
 ", a wire bent into two inputs that contracts a pair:"
}], "Text",
 CellID->2125008310,ExpressionUUID->"221ecbfd-1ed7-d323-5225-e2a79b63be09"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Cap\>\"", "[", "2", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[85]:= ",
 CellID->1684656716,ExpressionUUID->"3f067a83-888f-4db3-653e-73ed293a1799"],

Cell[TextData[{
 "Braid: ",
 Cell[BoxData["Braid"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "287fc527-5526-9e30-5804-dc815cd0e51a"]
}], "Subsection",
 CellID->2057792111,ExpressionUUID->"2207e002-80f7-0285-523c-fa6c308250ef"],

Cell[TextData[{
 "The braid crosses two wires: a swap carrying a ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "440467ae-8db5-79b4-6c3c-7e0824404b9e"],
 " phase on ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141585f4-d1c1-5bbd-3c2a-1cb1e0742987"],
 ":"
}], "Text",
 CellID->408837332,ExpressionUUID->"3d27d006-86b8-9131-64dc-ca603332e01b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Braid\>\"", "[", "2", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[86]:= ",
 CellID->1068510841,ExpressionUUID->"3e44340b-ef5c-51d5-667b-ae548ae9233f"],

Cell[TextData[{
 "Copy: ",
 Cell[BoxData["Copy"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "321034f4-436e-dcec-622f-adbe7618a636"]
}], "Subsection",
 CellID->1027032549,ExpressionUUID->"1287d3f9-6500-de4e-42bc-caa30cbaa494"],

Cell[TextData[{
 "The copy spider clones a basis state onto two wires, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0"},
    "Ket"], "\[Function]", 
   TemplateBox[{"00"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"1"},
    "Ket"], "\[Function]", 
   TemplateBox[{"11"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087f5f2f-6486-1b59-3805-56890d3369a3"],
 ":"
}], "Text",
 CellID->171792661,ExpressionUUID->"7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Copy\>\"", "[", "2", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[87]:= ",
 CellID->574949478,ExpressionUUID->"2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],

Cell[TextData[{
 "Phase spider: ",
 Cell[BoxData["ZSpider"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13ecd9ee-6506-67bb-4193-d0c80cb34d81"]
}], "Subsection",
 CellID->1664775781,ExpressionUUID->"6724c974-bdf1-27a5-0edb-e13e3b858d8f"],

Cell[TextData[{
 "A one-in one-out Z-spider carries a phase on the ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b52875c-0948-9ae8-5961-1f06a8e2e832"],
 " leg; at phase ",
 Cell[BoxData["\[Pi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53412643-5a68-df00-017e-b82d5f02a26a"],
 " it is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    RowBox[{"-", "1"}]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "696f5b1d-d56b-3a26-1f15-5346dc1f890c"],
 ":"
}], "Text",
 CellID->884697794,ExpressionUUID->"0eb02373-2484-618c-364f-bb3d4d3133d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<ZSpider\>\"", "[", "Pi", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[88]:= ",
 CellID->784201795,ExpressionUUID->"640353f1-ff8e-e9b3-0c31-4abafa38bb99"],

Cell[TextData[{
 "At phase ",
 Cell[BoxData[
  RowBox[{"\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37161f66-4600-a3a8-5d2d-974073baf1f2"],
 " the same spider is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    StyleBox["i", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["S", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e44757e-c407-f813-567c-6d3bedb3cb79"],
 ":"
}], "Text",
 CellID->1193259712,ExpressionUUID->"07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<ZSpider\>\"", "[", 
     RowBox[{"Pi", "/", "2"}], "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"", 
  "]"}]], "Input",
 CellLabel->"In[89]:= ",
 CellID->1084903799,ExpressionUUID->"539b0e4e-9e5a-5525-01b8-a0281bef3c0f"],

Cell["Qudits and Angular Momentum", "Section",
 CellID->964492758,ExpressionUUID->"1cd82739-42e3-b7ed-44e7-bf6376971d37"],

Cell[TextData[{
 "Beyond qubits, the library carries the clock-and-shift operators of a ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0971a20b-7913-467e-3f0e-445578a62d44"],
 "-level qudit, the qudit entangling gate, and angular-momentum operators \
whose dimension is set by the spin. Each caption states the matrix or the \
action."
}], "Text",
 CellID->242210635,ExpressionUUID->"09df342d-d743-5809-3fe4-ae76e2f62b53"],

Cell[TextData[{
 "Clock shift: ",
 Cell[BoxData["Shift"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"]
}], "Subsection",
 CellID->360816480,ExpressionUUID->"21fdaace-430e-f3f9-5782-43a876b8c1c3"],

Cell[TextData[{
 "The clock shift on a three-level qudit, cycling ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["j", "TI"]},
    "Ket"], "\[Rule]", 
   TemplateBox[{
     RowBox[{
       StyleBox["j", "TI"], "+", "1", 
       StyleBox["mod", FontSlant -> "Plain"], "3"}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"],
 ":"
}], "Text",
 CellID->1505759259,ExpressionUUID->"10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Shift\>\"", "[", "3", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[90]:= ",
 CellID->1384053022,ExpressionUUID->"41c6bfc6-0792-5005-77fd-36a0b227236f"],

Cell[TextData[{
 "Acting on ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62752e4e-571f-d961-120a-c02862aba84b"],
 " it advances the qutrit to ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
