 CellID->1411198270,ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell["\<\
The phase form, which drops the ancilla and measures in the X basis (width 2):\
\>", "Text",
 CellID->1703453532,ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
