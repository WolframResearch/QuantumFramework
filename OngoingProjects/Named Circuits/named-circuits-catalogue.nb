 CellID->320292756,ExpressionUUID->"4c440104-ea8a-4285-747b-99618f3f10ef"],

Cell["A variable-to-wire list fixing each variable's wire:", "Text",
 CellID->1146801282,ExpressionUUID->"66c9a615-af45-c085-0ef6-385ecaf192ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BooleanOracleR\>\"", "[", 
     RowBox[{
      RowBox[{"Xor", "[", 
       RowBox[{
        RowBox[{"\[FormalX]", "[", "1", "]"}], ",", " ", 
        RowBox[{"\[FormalX]", "[", "2", "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], "}"}], "]"}], 
