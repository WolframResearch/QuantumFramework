 CellLabel->"In[54]:= ",
 CellID->1859374462,ExpressionUUID->"10beb8bd-bdb6-ee93-4045-31e73440b4f9"],

Cell[TextData[{
 "An integer in the second slot offsets every wire up by ",
 StyleBox["m", "TI"],
 ", here placing the variables on wires 3,4 with 1,2 idle:"
}], "Text",
 CellID->544914423,ExpressionUUID->"3fdc991b-fead-14b0-65e3-1144fb587e9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<PhaseOracle\>\"", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}]}], ",", " ", "2"}], "]"}], "}"}],
    "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[55]:= ",
 CellID->1088734259,ExpressionUUID->"3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],

Cell[TextData[{
 "Rotation oracle: ",
 Cell[BoxData["BooleanOracleR"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0642d375-09f3-9942-2e71-cb3faf87eba8"]
}], "Subsection",
 CellID->476175344,ExpressionUUID->"0651775d-2bad-791b-2e6f-6f074e584861"],

Cell[TextData[{
 "Marking the states that satisfy a formula by a target rotation (",
 Cell[BoxData["RZ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63b9e3d6-2298-231e-1146-fa9057128e64"],
 " by \[Pi]) rather than a flip:"
}], "Text",
 CellID->201272189,ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
