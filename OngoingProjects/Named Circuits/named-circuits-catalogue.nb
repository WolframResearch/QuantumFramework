Cell[TextData[{
 "A prebuilt phase oracle wrapped with the matching phase diffusion, no \
formula compilation (here ",
 Cell[BoxData["CZ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
