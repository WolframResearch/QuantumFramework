  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "/", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1170384d-2f38-2c50-470f-b2174acd76ba"],
 " and the ladder halves:"
}], "Text",
 CellID->497245720,ExpressionUUID->"6ce33075-6d34-44a7-1490-aa3f04c12e8d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<GrayOracle\>\"", "[", 
