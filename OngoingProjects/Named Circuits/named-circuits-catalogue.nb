Cell[TextData[{
 "On the uniform state ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"+", "+"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "055bc2ad-6b92-a3be-3378-dbf70e24f184"],
 ", the oracle for ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], "1"], "\[Wedge]", 
   SubscriptBox[
    StyleBox["x", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0fb60e-2211-365f-5934-286857a59ca5"],
 " flips the sign of the marked ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "201a2509-bdd9-2fa1-5039-bd53346c758b"],
 " amplitude alone:"
}], "Text",
 CellID->1906087345,ExpressionUUID->"7085d256-6adc-aa08-20ba-d4100f6ef952"],

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<PhaseOracle\>\"", "[", 
       RowBox[{
        RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
        RowBox[{"\[FormalX]", "[", "2", "]"}]}], "]"}], "}"}], "]"}], "[", 
    RowBox[{"QuantumState", "[", "\"\<++\>\"", "]"}], "]"}], 
