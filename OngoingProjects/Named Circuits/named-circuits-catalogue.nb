 CellLabel->"In[58]:= ",
 CellID->1232284935,ExpressionUUID->"6833ae6a-6ac5-a2c8-19c0-40340f71f012"],

Cell[TextData[{
 "Gray-code angle oracle: ",
 Cell[BoxData["GrayOracle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7f2999-1aee-25a5-0504-c0c39e988f8f"]
}], "Subsection",
 CellID->2082395230,ExpressionUUID->"128c7526-c883-085d-42b4-6c83e9365aa7"],

Cell[TextData[{
 "A pure function loaded as target rotations ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox["x", "TI"]], "=", 
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SuperscriptBox["2", 
    StyleBox["prec",
     FontSlant->"Plain"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3279c00f-c9e2-8758-6206-da68ef94eda2"],
 ", sampled over the input values (default precision 4, so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["Y", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["x", "TI"], "2"], "/", "16"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50b12ff8-e606-85f7-004e-c6a593b0efdd"],
 " here):"
}], "Text",
 CellID->2045146513,ExpressionUUID->"640f47a5-4648-c62d-0c35-5e0f73e2ad77"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<GrayOracle\>\"", "[", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"#", "^", "2"}], " ", "&"}], ")"}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[59]:= ",
 CellID->25123057,ExpressionUUID->"63a48922-0fac-666c-115b-208caa594cb6"],

Cell[TextData[{
 "An explicit list of angles in place of a function, padded with zeros to the \
",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["prec",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "387a9e0d-0234-0e73-6819-1057b7c15559"],
 " the default four input wires expect (16 angles):"
}], "Text",
 CellID->371825621,ExpressionUUID->"3f64ca0d-9927-5f44-651b-ec5718d225ae"],

