 CellID->1051974278,ExpressionUUID->"621761a3-d300-b412-122d-780ce6ba1f78"],

Cell[TextData[{
 "A first-order step for ",
 Cell[BoxData[
  RowBox[{"X", " ", "+", " ", "Y", " ", "+", " ", "Z"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],
 " repeated three times, which shrinks the step error:"
}], "Text",
 CellID->1989924844,ExpressionUUID->"7d3ffb2e-09a8-fc78-24c4-f288a842c742"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
