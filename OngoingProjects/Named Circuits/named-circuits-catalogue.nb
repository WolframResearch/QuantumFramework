Notebook[{
Cell["Named Quantum Circuits and Operators", "Title",
 CellID->874461601,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 "A single catalogue of every named construction ",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 " accepts, each shown as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<Name\>\"", "[", "...", "]"}], "}"}], "]"}], 
   "[", "\"\<Diagram\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 " with a one-line caption stating what that signature does, and an action \
cell on the canonical examples. The families are ordered by impact for a \
quantum audience, from complete algorithms down to the primitive gate set. \
Every cell is verified against the kernel."
}], "Text",
 CellID->36768919,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell[TextData[StyleBox["Tier 1 - Complete algorithms.",
 FontWeight->"Bold"]], "Text",
 CellID->1699946459,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell["Grover", "Section",
 CellID->1535504786,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell[TextData[{
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 " accepts a library of named constructions. A bare string builds the default \
instance; ",
 Cell[BoxData[
  RowBox[{"\"\<Name\>\"", "[", "...", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5902d484-617f-9570-0f31-cdee100bfc5a"],
 " passes arguments. This page walks the ",
 StyleBox["Grover",
  FontWeight->"Bold"],
 " family through its main signatures, one line each, showing the circuit \
diagram."
}], "Text",
 CellID->1208482393,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[TextData[{
 "The names split into two layers: the diffusion block alone, and the full \
search step ",
 Cell[BoxData[
  RowBox[{
   StyleBox["G", "TI"], "=", 
   StyleBox["D", "TI"], "\[ThinSpace]", 
   StyleBox["O", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5708d032-2150-04f2-7d37-ca7c50e56ed8"],
 " that wraps a diffusion block around an oracle."
}], "Text",
 CellID->28909615,ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"],

Cell["The diffusion block", "Subsection",
 CellID->193832008,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"],

Cell[TextData[{
 "The diffusion reflection on ",
 StyleBox["n", "TI"],
 " wires, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "-", 
   RowBox[{"2", 
    TemplateBox[{
      RowBox[{"+", "\[CenterEllipsis]", "+", "-"}]},
     "Ket"], 
    TemplateBox[{
      RowBox[{"+", "\[CenterEllipsis]", "+", "-"}]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "234f1fb7-07c6-bba9-5174-96f1b27009f3"],
 ": every input wire in ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
 " and the flag wire in ",
 Cell[BoxData[
  TemplateBox[{"-"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],
 ":"
}], "Text",
 CellID->684317082,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<GroverDiffusion\>\"", "[", "4", "]"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
