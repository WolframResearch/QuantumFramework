Cell["\<\
A larger counting register, five qubits: more resolution for a general phase, \
though the dyadic 1/8 here is already exact with three:\
\>", "Text",
 CellID->1124211690,ExpressionUUID->"2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<PhaseEstimation\>\"", "[", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", "\"\<T\>\"", "]"}], ",", " ", "5"}], 
     "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
