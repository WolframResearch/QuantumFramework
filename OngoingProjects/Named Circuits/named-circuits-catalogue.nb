     RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
     RowBox[{"\[FormalX]", "[", "2", "]"}]}], "]"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->203008389,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell["\<\
The search step built with the shallower zero-control diffusion in place of \
