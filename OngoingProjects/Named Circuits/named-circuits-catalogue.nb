 CellLabel->"In[19]:= ",
 CellID->1477609488,ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell["Deutsch-Jozsa: n qubits", "Subsection",
 CellID->1030824397,ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],

Cell[TextData[{
 "A balanced function on three inputs, here the parity ",
 Cell[BoxData[
  RowBox[{"x1", " ", "\[Xor]", " ", "x2", " ", "\[Xor]", " ", "x3"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea251ed-865f-e03c-1652-48b733ebb306"],
 ":"
}], "Text",
 CellID->100031176,ExpressionUUID->"25a0bfbe-b1d4-2428-535f-36fbc0668f72"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<DeutschJozsa\>\"", "[", 
     RowBox[{"Xor", "[", 
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], ",", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}], ",", " ", 
       RowBox[{"\[FormalX]", "[", "3", "]"}]}], "]"}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->144223354,ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell["\<\
A constant function on three inputs, selected by the integer index:\
\>", "Text",
 CellID->1443527617,ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<DeutschJozsa\>\"", "[", 
     RowBox[{"1", ",", " ", "3"}], "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"",
   "]"}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->311511756,ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell["\<\
The decision, read out: the parity function sends all the weight onto the \
all-minus outcome, so the all-plus string that would certify a constant \
function has probability zero (the constant case puts probability 1 there \
instead):\
\>", "Text",
 CellID->1381425643,ExpressionUUID->"14fd1512-f616-8834-3c82-8d5f83a0db1e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<DeutschJozsa\>\"", "[", 
      RowBox[{"Xor", "[", 
       RowBox[{
        RowBox[{"\[FormalX]", "[", "1", "]"}], ",", " ", 
        RowBox[{"\[FormalX]", "[", "2", "]"}], ",", " ", 
        RowBox[{"\[FormalX]", "[", "3", "]"}]}], "]"}], "]"}], "}"}], "]"}], "[",
    "]"}], "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->377280352,ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"],

Cell["\<\
A second argument fixes the number of input qubits when the function is left \
to a random draw:\
\>", "Text",
 CellID->1717363484,ExpressionUUID->"48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<DeutschJozsa\>\"", "[", 
     RowBox[{"Automatic", ",", " ", "3"}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->1781880651,ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],

Cell[TextData[{
 "The phase form on two inputs, here the balanced equivalence ",
 Cell[BoxData[
  RowBox[{"\[Not]", 
   RowBox[{"(", 
    RowBox[{"x1", " ", "\[Xor]", " ", "x2"}], ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],
 ": phase oracle, no ancilla:"
}], "Text",
 CellID->1536527082,ExpressionUUID->"7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<DeutschJozsaPhase\>\"", "[", 
     RowBox[{"!", " ", 
      RowBox[{"Xor", "[", 
       RowBox[{
        RowBox[{"\[FormalX]", "[", "1", "]"}], ",", " ", 
        RowBox[{"\[FormalX]", "[", "2", "]"}]}], "]"}]}], "]"}], "}"}], "]"}],
   "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[24]:= ",
 CellID->1621535814,ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell["The oracles alone", "Subsection",
 CellID->1193935837,ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],

Cell["\<\
The bit-flip oracle for a balanced function, flipping the ancilla where the \
function is true:\
\>", "Text",
 CellID->105329933,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<DeutschJozsaBooleanOracle\>\"", "[", 
     RowBox[{"Xor", "[", 
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], ",", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}]}], "]"}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[25]:= ",
 CellID->1234416869,ExpressionUUID->"5e187950-8ca2-2ab2-0638-711a25577898"],

Cell["\<\
The phase oracle for the same function, marking by sign with no ancilla:\
\>", "Text",
 CellID->240380995,ExpressionUUID->"250a2d7c-9b81-05b0-5309-c5261e346f9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<DeutschJozsaPhaseOracle\>\"", "[", 
     RowBox[{"Xor", "[", 
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], ",", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}]}], "]"}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[26]:= ",
 CellID->1771870337,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell["\<\
The constant oracle on three inputs, selected by the integer index:\
\>", "Text",
 CellID->305160771,ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<DeutschJozsaBooleanOracle\>\"", "[", 
     RowBox[{"1", ",", " ", "3"}], "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"",
   "]"}]], "Input",
 CellLabel->"In[27]:= ",
 CellID->1896945989,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

Cell["Simon's Algorithm", "Section",
 CellID->653417278,ExpressionUUID->"341c54d9-3079-6bba-5c24-4d83410c3980"],

Cell[TextData[{
 "Simon's algorithm finds a hidden nonzero mask ",
 StyleBox["s", "TI"],
 " of a function promised to be two-to-one with that period: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], " ", "=", " ", 
   RowBox[{"f", 
    RowBox[{"(", 
     RowBox[{"x", "'"}], ")"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],
 " exactly when ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"x", "'"}], " ", "=", " ", "x"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f449897-1a0e-51e7-357b-11d19fbb23cd"],
 " or ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"x", "'"}], " ", "=", " ", 
   RowBox[{"x", " ", "\[CirclePlus]", " ", "s"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],
 ". (The bare period ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], " ", "=", " ", 
   RowBox[{"f", 
    RowBox[{"(", 
     RowBox[{"x", " ", "\[CirclePlus]", " ", "s"}], ")"}]}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5077c06e-c394-b43c-000c-da4bf6261f06"],
 " alone is weaker: a constant function satisfies it for every ",
 StyleBox["s", "TI"],
 ".) It uses exponentially fewer queries than any classical method. The named \
circuit is the ",
 StyleBox["sampling", "TI"],
 " step: oracle, Hadamard layers on the input register, and a measurement \
that returns one string ",
 Cell[BoxData["y"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07359582-e823-44a1-2eca-0cef89d62e8b"],
 " with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"y", " ", "\[CenterDot]", " ", "s"}], " ", "=", " ", "0"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c239bd0-3ff5-3b18-25d0-129ab9818662"],
 "; recovering ",
 StyleBox["s", "TI"],
 " needs repeated samples and classical linear algebra on top. The mask is \
given as a bit string, a bit list, or left to a random draw. One caveat \
verified in the kernel: the generated function respects the period ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], " ", "=", " ", 
   RowBox[{"f", 
    RowBox[{"(", 
     RowBox[{"x", " ", "\[CirclePlus]", " ", "s"}], ")"}]}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c76573-72ce-0c1a-18fd-7d3d077b5760"],
 " but is not guaranteed strictly two-to-one (the outputs are drawn at \
random), so it realizes the period rather than the full Simon promise."
}], "Text",
 CellID->1067269536,ExpressionUUID->"6184d2f2-049e-728e-17bb-cbbcad2b40d4"],

Cell[TextData[{
 "Sampling circuit: ",
 Cell[BoxData["Simon"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fd967ef-5008-0b29-75e7-7ec961bd5673"]
}], "Subsection",
 CellID->49659130,ExpressionUUID->"19bb1c5e-57ab-6e36-4f58-9618625e351c"],

Cell["\<\
The mask given as a bit string, on a 3-wire input register feeding a 3-wire \
output register:\
\>", "Text",
 CellID->464508221,ExpressionUUID->"5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Simon\>\"", "[", "\"\<101\>\"", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[28]:= ",
 CellID->1361313038,ExpressionUUID->"30baa1c8-66ad-75e0-6059-389213585fca"],

Cell["The mask given as a bit list:", "Text",
 CellID->1907680634,ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Simon\>\"", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[29]:= ",
 CellID->483148123,ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell["\<\
A random mask, defaulting to three bits (so the register is fixed at three \
input and three output wires):\
\>", "Text",
 CellID->1195452142,ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Simon\>\"", "[", "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"",
   "]"}]], "Input",
 CellLabel->"In[30]:= ",
 CellID->1521685512,ExpressionUUID->"511b3347-8d7d-ab60-0738-ab212409f64a"],

Cell[TextData[{
 "Oracle alone: ",
 Cell[BoxData["SimonOracle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36c19c85-764d-0b01-5efe-15ef03f8566b"]
}], "Subsection",
 CellID->97201263,ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

Cell["\<\
The two-register oracle for a chosen mask, mapping a 3-wire input register \
into a 3-wire output register:\
\>", "Text",
 CellID->878831761,ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<SimonOracle\>\"", "[", "\"\<110\>\"", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[31]:= ",
 CellID->1048559713,ExpressionUUID->"5900aac7-5263-773e-0f3f-43a167165a04"],

Cell["The same mask given as a bit list:", "Text",
 CellID->300048012,ExpressionUUID->"06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<SimonOracle\>\"", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1", ",", " ", "0"}], "}"}], "]"}], "}"}], "]"}],
   "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[32]:= ",
 CellID->1962937852,ExpressionUUID->"12d95fcb-3316-2212-42e7-569546a37178"],

Cell["Bernstein-Vazirani", "Section",
 CellID->588230824,ExpressionUUID->"733995c2-f5bf-78ee-22c6-0caffc4a4a34"],

Cell[TextData[{
 "Bernstein-Vazirani recovers a hidden bit string ",
 StyleBox["a", "TI"],
 " in a single query, where the oracle computes the dot product ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], " ", "=", " ", 
   RowBox[{
    RowBox[{"a", " ", "\[CenterDot]", " ", "x"}], " ", 
    RowBox[{"(", 
     RowBox[{"mod", " ", "2"}], ")"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f8ab258-7e7f-0723-7589-34027b0a6a09"],
 ". The named circuit builds the oracle (a ",
 Cell[BoxData["CNOT"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b12ee74-9953-131d-1921-003e18e67e67"],
 " from each wire whose secret bit is 1 onto the ancilla), the surrounding \
Hadamard layers, and the measurement, whose outcome reads the secret back \
directly."
}], "Text",
 CellID->2099309037,ExpressionUUID->"65262d3c-fccc-1dc6-0cdd-c579f579672c"],

Cell["The algorithm", "Subsection",
 CellID->512383039,ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"],

Cell["The secret given as a bit string:", "Text",
 CellID->273308241,ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BernsteinVazirani\>\"", "[", "\"\<101\>\"", "]"}], "}"}], 
   "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[33]:= ",
 CellID->1809098798,ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"],

Cell[TextData[{
 "Running the full circuit, a single measurement returns the secret ",
 Cell[BoxData["101"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],
 " with certainty:"
}], "Text",
 CellID->156430199,ExpressionUUID->"187adc3d-3961-76c2-4819-d667b8145c28"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<BernsteinVazirani\>\"", "[", "\"\<101\>\"", "]"}], "}"}], 
    "]"}], "[", "]"}], "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellLabel->"In[34]:= ",
 CellID->724760089,ExpressionUUID->"641c78eb-7f03-7846-0c24-71b57ab64aac"],

Cell["The secret given as a bit list:", "Text",
 CellID->168408080,ExpressionUUID->"5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BernsteinVazirani\>\"", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1", ",", " ", "0", ",", " ", "1"}], "}"}], 
     "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[35]:= ",
 CellID->811283638,ExpressionUUID->"112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],

Cell["\<\
A second argument shifts every wire up by one, leaving wire 1 idle with the \
register on wires 2-5 and the ancilla on 6:\
\>", "Text",
 CellID->207978548,ExpressionUUID->"6121b9de-dddd-aca8-10de-309bd469f6f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BernsteinVazirani\>\"", "[", 
     RowBox[{"\"\<1101\>\"", ",", " ", "1"}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[36]:= ",
 CellID->437474228,ExpressionUUID->"30209679-023a-ee91-61df-0823b7ccb4fb"],

Cell["The oracle alone", "Subsection",
 CellID->874582697,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell[TextData[{
 "The oracle for a chosen secret: one ",
 Cell[BoxData["CNOT"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],
 " onto the ancilla from each wire whose bit is 1:"
}], "Text",
 CellID->11631581,ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BernsteinVaziraniOracle\>\"", "[", "\"\<1011\>\"", "]"}], 
    "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[37]:= ",
 CellID->1933762060,ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],

Cell["The same oracle from a bit list:", "Text",
 CellID->1055776787,ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BernsteinVaziraniOracle\>\"", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "0", ",", " ", "1", ",", " ", "1"}], "}"}], 
     "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[38]:= ",
 CellID->1859711813,ExpressionUUID->"51fce014-dca1-0630-0783-fa51d5546d1a"],

Cell["Fourier Transform and Phase Estimation", "Section",
 CellID->1348896709,ExpressionUUID->"657c1c65-980e-511d-1303-964f19bb2067"],

Cell[TextData[{
 "The quantum Fourier transform moves a register between the computational \
and the Fourier basis; phase estimation uses its inverse to read the \
eigenphase of a unitary into a counting register. The Fourier transform and \
its inverse also exist as single ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],
 " matrices, so under the circuit form here the diagram is the gate ",
 StyleBox["decomposition", "TI"],
 ", Hadamards and controlled phase rotations, not an atomic box."
}], "Text",
 CellID->1427211115,ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell["Quantum Fourier transform", "Subsection",
 CellID->2099805207,ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"],

Cell["\<\
The transform on three qubits: a Hadamard and a ladder of controlled phase \
shifts on each wire, then the wire-reversing swap:\
\>", "Text",
 CellID->1402006442,ExpressionUUID->"1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Fourier\>\"", "[", "3", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[39]:= ",
 CellID->1901179466,ExpressionUUID->"370294fd-9e49-2d35-5d31-0da71bfc741f"],

Cell["\<\
A second argument offsets the transform up by that many leading wires:\
\>", "Text",
 CellID->210724908,ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Fourier\>\"", "[", 
     RowBox[{"3", ",", " ", "1"}], "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"",
   "]"}]], "Input",
 CellLabel->"In[40]:= ",
 CellID->1992790374,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell["The inverse transform, the dagger of the forward one:", "Text",
 CellID->292747604,ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<InverseFourier\>\"", "[", "3", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[41]:= ",
 CellID->1553818268,ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"],

Cell["Phase estimation", "Subsection",
 CellID->1870754514,ExpressionUUID->"6878c7f8-419e-9db5-1807-dea27028e79f"],

Cell[TextData[{
 "The eigenphase of the ",
 Cell[BoxData["T"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48a3d607-c312-9dd3-7850-c860f6a4e739"],
 " gate read into a three-qubit counting register; the constructor prepares \
the target in ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539491e8-328f-8d7b-01ab-08b2473bd441"],
 ", selecting its eigenphase 1/8 (both ",
 Cell[BoxData["T"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],
 " and ",
 Cell[BoxData["S"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023f49e2-a747-9723-33c5-60cfd2f3fa09"],
 " have eigenphase 0 on ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21aa1c49-e16c-f406-57a9-9612901edf6c"],
 "), and ends in an inverse Fourier transform and measurement:"
}], "Text",
 CellID->1358728755,ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
