 CellID->354048744,ExpressionUUID->"5f932952-49a5-d34f-05a0-c11c6851a195"],

Cell["A variable-to-wire list fixing the wire of each variable:", "Text",
 CellID->786710823,ExpressionUUID->"160f17c4-d31a-fe19-3e34-8ea1e6acc563"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<PhaseOracle\>\"", "[", 
