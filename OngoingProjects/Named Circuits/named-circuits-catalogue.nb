     RowBox[{
      RowBox[{"QuantumOperator", "[", "\"\<T\>\"", "]"}], ",", " ", "3"}], 
     "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[42]:= ",
 CellID->935019337,ExpressionUUID->"12f3dbee-abc4-6375-4280-d2cbce714e5f"],

Cell[TextData[{
 "Running it, the counting register reads ",
 Cell[BoxData["001"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
 " = 1/8, the eigenphase of ",
 Cell[BoxData["T"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cfa2c34-ef50-7d46-5499-c6718ae547ac"],
 ", with certainty:"
}], "Text",
 CellID->642744358,ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<PhaseEstimation\>\"", "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", "\"\<T\>\"", "]"}], ",", " ", "3"}], 
      "]"}], "}"}], "]"}], "[", "]"}], "[", "\"\<Probabilities\>\"", 
  "]"}]], "Input",
 CellLabel->"In[43]:= ",
 CellID->1478372881,ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[TextData[{
 "The same for the ",
 Cell[BoxData["S"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa29c-d013-1000-4004-3bd9e1a6636a"],
 " gate (phase 1/4), a different target unitary:"
}], "Text",
 CellID->124263719,ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<PhaseEstimation\>\"", "[", 
