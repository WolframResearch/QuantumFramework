      RowBox[{"(", 
       RowBox[{
        RowBox[{"#", "^", "2"}], " ", "&"}], ")"}], ",", " ", "3"}], "]"}], 
    "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[61]:= ",
 CellID->1090726268,ExpressionUUID->"54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],

Cell[TextData[{
 "A rotation-axis argument sets which rotation the angles drive, here ",
 Cell[BoxData["RZ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6334ac9c-43f1-85c0-12cb-45c67585ef2a"],
 ":"
}], "Text",
 CellID->2124519200,ExpressionUUID->"74397683-04f4-1d4d-1dc7-6fedac816797"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<GrayOracle\>\"", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"#", "^", "2"}], " ", "&"}], ")"}], ",", " ", "3", ",", " ", 
      "Automatic", ",", " ", "\"\<RZ\>\""}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[62]:= ",
 CellID->617350884,ExpressionUUID->"735e49d5-32a1-4a48-2166-609f47541892"],

Cell[TextData[StyleBox["Tier 3 - Composition and simulation.",
 FontWeight->"Bold"]], "Text",
 CellID->1357963930,ExpressionUUID->"335d55a2-cf9b-493d-6163-4c0fea2e1807"],

Cell["Composition and Simulation", "Section",
 CellID->1626918454,ExpressionUUID->"3bfbbd45-edb8-1b0b-6998-352e844d6651"],

Cell["\<\
These constructions take operators or whole circuits as input and assemble a \
larger circuit: controlling a circuit on extra wires, multiplexing a choice \
of gate on a control register, routing two unitaries in indefinite order, \
solving a linear system, and compiling a Hamiltonian into a product-formula \
circuit.\
\>", "Text",
 CellID->675379980,ExpressionUUID->"045023ab-c37d-b770-2c6f-baf4f6091a5a"],

Cell[TextData[{
 "Controlling a circuit: ",
 Cell[BoxData["Controlled"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73e8aeff-5b91-f8f4-2197-47b95e25cade"]
}], "Subsection",
 CellID->1331866192,ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"],

Cell["\<\
A whole circuit controlled on an extra wire, here a two-qubit Fourier \
transform on wires 2,3 fired by wire 1 (the transform is offset to 2,3 so it \
does not collide with the control):\
\>", "Text",
 CellID->1391655620,ExpressionUUID->"794a4309-908b-2549-2f4a-5b53213f8f93"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Controlled\>\"", "[", 
     RowBox[{
      RowBox[{"QuantumCircuitOperator", "[", 
       RowBox[{"\"\<Fourier\>\"", "[", 
        RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
      RowBox[{"{", "1", "}"}]}], "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"", 
  "]"}]], "Input",
 CellLabel->"In[63]:= ",
 CellID->861714746,ExpressionUUID->"167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],

Cell["\<\
Two control wires (3 and 4) gating a GHZ preparation on wires 1,2, so the \
pair is prepared only when both controls fire:\
\>", "Text",
 CellID->1192942815,ExpressionUUID->"15eb24b6-b946-3a65-43e8-bdf038f0894f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Controlled\>\"", "[", 
     RowBox[{
      RowBox[{"QuantumCircuitOperator", "[", 
       RowBox[{"\"\<GHZ\>\"", "[", "2", "]"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[64]:= ",
 CellID->556077107,ExpressionUUID->"27d2a24c-1e84-19ee-4de1-44169b316b34"],

Cell[TextData[{
 "Multiplexing a gate: ",
 Cell[BoxData["Multiplexer"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "285985c7-a1c8-13eb-5866-1ca0d07d6131"]
}], "Subsection",
 CellID->15883883,ExpressionUUID->"57868ed1-450c-c474-7dbd-279b6cbeaf5e"],

Cell["\<\
A gate chosen by the control register, one target gate per control value, \
here three gates on a two-wire control (shown as its gate decomposition):\
\>", "Text",
 CellID->308842859,ExpressionUUID->"0c5e608e-35dc-f74f-3466-79e8bc6edd95"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Multiplexer\>\"", "[", 
     RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\""}], 
     "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[65]:= ",
 CellID->1108042358,ExpressionUUID->"1a1e4090-3303-05ed-4a26-59da46b66f37"],

Cell["Two gates on a single control wire:", "Text",
 CellID->1009200201,ExpressionUUID->"10256af3-3972-af7a-41da-83bdb804f240"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Multiplexer\>\"", "[", 
     RowBox[{"\"\<X\>\"", ",", " ", "\"\<H\>\""}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[66]:= ",
 CellID->752465254,ExpressionUUID->"457602f1-d86e-ac86-730d-9bbad918f6ec"],

Cell[TextData[{
 "Its matrix is block-diagonal: ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "499f95c1-a958-6c18-7fa4-0caac8ed3762"],
 " on the control-0 block, ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1e874b-6d22-b8ab-3525-1f1504d40af1"],
 " on the control-1 block:"
}], "Text",
 CellID->891183881,ExpressionUUID->"0c02104f-9807-e6c4-3431-8a2919b3cc2e"],

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<Multiplexer\>\"", "[", 
      RowBox[{"\"\<X\>\"", ",", " ", "\"\<H\>\""}], "]"}], "}"}], "]"}], 
   "[", "\"\<Matrix\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[67]:= ",
 CellID->741634648,ExpressionUUID->"6f909018-5ea1-6a32-15af-0a425b543918"],

Cell[TextData[{
 "Indefinite causal order: ",
 Cell[BoxData["Switch"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f4595f3-090a-1216-557a-0cbda8bf617c"]
}], "Subsection",
 CellID->359589406,ExpressionUUID->"06385f5e-e9d4-4e6c-2fd8-571b886114b6"],

Cell["\<\
The quantum switch of two unitaries, applying them in an order set by an \
ancilla; preparing that ancilla in superposition puts the order in \
superposition (shown as its gate decomposition):\
\>", "Text",
 CellID->533832725,ExpressionUUID->"25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Switch\>\"", "[", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], ",", " ", 
      RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], "]"}], "}"}], 
   "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[68]:= ",
 CellID->739917449,ExpressionUUID->"3b9a140e-d97a-4136-69b9-8e6bd80f101c"],

Cell[TextData[{
 "Linear systems: ",
 Cell[BoxData["ControlledMultiplexer"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f9438da-b80f-a114-75ab-b18439bbf07e"]
}], "Subsection",
 CellID->473762610,ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell[TextData[{
 "The variational linear-solver construction for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"A", " ", "x"}], " ", "=", " ", "b"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8746fc-db76-c487-64bd-5fb9de00aeed"],
 " (coefficient-state preparation, an ansatz, multiplexing, and an ancilla \
contraction, returned before the fidelity cost and optimization), here a \
diagonal ",
 Cell[BoxData["A"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11f0f87a-e6f0-91cd-478f-f227928ae317"],
 " and a two-component ",
 Cell[BoxData["b"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "473164ce-b547-c1f4-6ecf-7da83cf393de"],
 ":"
}], "Text",
 CellID->1751712322,ExpressionUUID->"12c4fc3b-e00c-2bba-42fb-f66491b97980"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<ControlledMultiplexer\>\"", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "2"}], "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[69]:= ",
 CellID->1390140890,ExpressionUUID->"1d7e6892-18cd-6f45-4b05-81dc997835af"],

Cell[TextData[{
 "Hamiltonian simulation: ",
 Cell[BoxData["Trotterization"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "325c8f47-cd85-89da-6263-2720e431db20"]
}], "Subsection",
 CellID->1031105928,ExpressionUUID->"43fcea2e-12ab-c026-7183-0388a75f930c"],

Cell[TextData[{
 "A second-order Trotter step for the sum ",
 Cell[BoxData[
  RowBox[{"X", " ", "+", " ", "Z"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b416c07-c3d3-bf4f-097e-8660f6670595"],
