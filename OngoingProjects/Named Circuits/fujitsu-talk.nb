Notebook[{
Cell["QuantumFramework Selected Circuits", "Title",
 CellID->874461601,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 "Selected examples assembled from the named-circuit pages. Every cell is ",
 Cell[BoxData[
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Name\>\"", "[", "...", "]"}], "}"}], "]"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 ": a bare string builds the default instance, ",
 Cell[BoxData[
  RowBox[{"\"\<Name\>\"", "[", "...", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 " passes arguments, and the same object draws a diagram, returns a matrix, \
and acts on a state."
}], "Text",
 CellID->36768919,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell["Grover", "Section",
 CellID->1699946459,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell["\<\
The search step marking the states that satisfy a boolean formula:\
\>", "Text",
 CellID->1535504786,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<Grover\>\"", "[", 
    RowBox[{
     RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
     RowBox[{"\[FormalX]", "[", "2", "]"}], " ", "&&", " ", 
     RowBox[{"!", " ", 
      RowBox[{"\[FormalX]", "[", "3", "]"}]}]}], "]"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->1208482393,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell[TextData[{
 "Two phase-Grover iterations on the uniform superposition concentrate the \
probability on the marked ",
 Cell[BoxData[
  TemplateBox[{"111"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5902d484-617f-9570-0f31-cdee100bfc5a"],
 ":"
}], "Text",
 CellID->28909615,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Nest", "[", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"\"\<GroverPhase\>\"", "[", 
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}], " ", "&&", " ", 
       RowBox[{"\[FormalX]", "[", "3", "]"}]}], "]"}], "]"}], ",", " ", 
    RowBox[{"QuantumState", "[", "\"\<+++\>\"", "]"}], ",", " ", "2"}], "]"}],
   "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->193832008,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell["Fourier transform and phase estimation", "Section",
 CellID->684317082,ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"],

Cell[TextData[{
 "The quantum Fourier transform moves a register between the computational \
and the Fourier basis; phase estimation uses its inverse to read the \
eigenphase of a unitary into a counting register. The Fourier transform and \
its inverse also exist as single ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166f8969-5e31-e8e5-3e14-21335bc5bacf"],
 " matrices, so under the circuit form here the diagram is the gate ",
 StyleBox["decomposition", "TI"],
 ", Hadamards and controlled phase rotations, not an atomic box."
}], "Text",
 CellID->528485616,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell["\<\
The transform on three qubits: a Hadamard and a ladder of controlled phase \
shifts on each wire, then the wire-reversing swap:\
\>", "Text",
 CellID->1392207227,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Fourier\>\"", "[", "3", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->705466992,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell[TextData[{
 "The eigenphase of the ",
 Cell[BoxData["T"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ec9a758-58be-624c-16f6-3f02594b3096"],
 " gate read into a three-qubit counting register; the constructor prepares \
the target in ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23253b8d-1c99-a6bf-52da-b2d7952d0c85"],
 ", selecting its eigenphase 1/8 (both ",
 Cell[BoxData["T"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e84829b-9667-6594-16bb-1bc523124ffe"],
 " and ",
 Cell[BoxData["S"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e173f-6b36-b240-7ea5-8f790ec000aa"],
 " have eigenphase 0 on ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],
 "), and ends in an inverse Fourier transform and measurement:"
}], "Text",
 CellID->1350516518,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<PhaseEstimation\>\"", "[", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", "\"\<T\>\"", "]"}], ",", " ", "3"}], 
     "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->907546795,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell[TextData[{
 "Running it, the counting register reads ",
 Cell[BoxData["001"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76dfbc62-92ac-7b6e-1ee4-364c275949b4"],
 " = 1/8, the eigenphase of ",
 Cell[BoxData["T"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],
 ", with certainty:"
}], "Text",
 CellID->814772321,ExpressionUUID->"4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<PhaseEstimation\>\"", "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", "\"\<T\>\"", "]"}], ",", " ", "3"}], 
      "]"}], "}"}], "]"}], "[", "]"}], "[", "\"\<Probabilities\>\"", 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->1054628905,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell[TextData[{
 "Hamiltonian simulation: ",
 Cell[BoxData["Trotterization"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf5a20e-c541-e06e-698a-446becf5b2b4"]
}], "Section",
 CellID->2043779557,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"],

Cell[TextData[{
 "A second-order Trotter step for the sum ",
 Cell[BoxData[
  RowBox[{"X", " ", "+", " ", "Z"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],
 ", symmetrically ordered:"
}], "Text",
 CellID->17830494,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Trotterization\>\"", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<X\>\"", ",", " ", "\"\<Z\>\""}], "}"}], ",", " ", "2"}], 
     "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->1589986527,ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell["Non-unitary elements", "Section",
 CellID->943101875,ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"],

Cell["\<\
Not every circuit element is a unitary gate. A circuit can also measure a \
wire, reset it, trace it out, or discard it. Each of these is a named element \
whose action on a state is described below, not just drawn as a diagram.\
\>", "Text",
 CellID->67888809,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell[TextData[{
 "An unrecorded projective measurement on wire 1; applied to ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],
 " it returns the maximally mixed state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c358d3e-86d3-ec5f-75ca-25783367b6a5"],
 ":"
}], "Text",
 CellID->1432876021,ExpressionUUID->"1f908cf3-3c70-d55a-45af-25bdb50abfa0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Measurement\>\"", "[", "1", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->876231958,ExpressionUUID->"5dac66ba-272d-3627-0b54-7fe452d99d0d"],

Cell[TextData[{
 "Acting on ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 ", the density matrix is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d004f9-29e5-6665-1eef-9da34f904d4f"],
 ": the coherence is gone:"
}], "Text",
 CellID->1020575516,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Measurement\>\"", "[", "1", "]"}], "}"}], "]"}], "[", 
    RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], "]"}], 
   "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->1967685850,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell[TextData[{
 "A completely positive map applied directly in the circuit (the strength \
nests inside the name, ",
 Cell[BoxData[
  RowBox[{"\"\<Depolarizing\>\"", "[", "p", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebf3687-f906-130d-7644-afe0f8b37e57"],
 "); the depolarizing channel at 3/10 partially mixes a pure input:"
}], "Text",
 CellID->1044562475,ExpressionUUID->"65de4a87-3471-cd9f-13e6-63e1bd0597e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Channel\>\"", "[", 
     RowBox[{"\"\<Depolarizing\>\"", "[", 
      RowBox[{"3", "/", "10"}], "]"}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->1653200050,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell[TextData[{
 "Acting on ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 " it damps the coherence rather than erasing it, giving ",
 Cell[BoxData[
  RowBox[{"(", GridBox[{
     {
      RowBox[{"1", "/", "2"}], 
      RowBox[{"7", "/", "20"}]},
     {
      RowBox[{"7", "/", "20"}], 
      RowBox[{"1", "/", "2"}]}
    }], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 ":"
}], "Text",
 CellID->1384978530,ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Channel\>\"", "[", 
       RowBox[{"\"\<Depolarizing\>\"", "[", 
        RowBox[{"3", "/", "10"}], "]"}], "]"}], "}"}], "]"}], "[", 
    RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], "]"}], 
   "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->519689844,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],

Cell[TextData[{
 "Exact linear algebra: ",
 Cell[BoxData["Multiplexer"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfe104a-50de-a555-0985-8a1461680fbf"]
}], "Section",
 CellID->1609367578,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell[TextData[{
 "Its matrix is block-diagonal: ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],
 " on the control-0 block, ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1c99a5-dcef-9c28-1623-100ed49be772"],
 " on the control-1 block:"
}], "Text",
 CellID->1541450781,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<Multiplexer\>\"", "[", 
      RowBox[{"\"\<X\>\"", ",", " ", "\"\<H\>\""}], "]"}], "}"}], "]"}], 
   "[", "\"\<Matrix\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->1657269721,ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"],

Cell["Tensor-network atoms", "Section",
 CellID->1140508347,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell["\<\
These are the wire-level building blocks of the ZX and tensor-network \
calculus: bending a wire into a state or an effect, crossing two wires, \
copying a basis state, and the phase spider. Each caption states what the \
atom's matrix does, verified in the kernel.\
\>", "Text",
 CellID->496109794,ExpressionUUID->"337c2d89-644e-5b5e-6103-c4d30dfb29a4"],

Cell[TextData[{
 "A one-in one-out Z-spider carries a phase on the ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 " leg; at phase ",
 Cell[BoxData["\[Pi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 " it is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    RowBox[{"-", "1"}]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
 ":"
}], "Text",
 CellID->108435171,ExpressionUUID->"6801f052-da94-0b6f-183e-ea1fdf2159b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<ZSpider\>\"", "[", "Pi", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->829388421,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell[TextData[{
 "The braid crosses two wires: a swap carrying a ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 " phase on ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],
 ":"
}], "Text",
 CellID->203008389,ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Braid\>\"", "[", "2", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->1090263105,ExpressionUUID->"5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],

Cell[TextData[{
 "The cup bends a wire from two outputs, giving the unnormalized Bell state \
",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"00"},
    "Ket"], "+", 
   TemplateBox[{"11"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7fe4cc-5889-7f4e-6904-fd96593c4594"],
 ":"
}], "Text",
 CellID->1560876240,ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Cup\>\"", "[", "2", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->176337227,ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"],

Cell["Qudits and angular momentum", "Section",
 CellID->807053435,ExpressionUUID->"4b6e5dad-9702-0c1f-7916-54f722b75765"],

Cell[TextData[{
 "Beyond qubits, the library carries the clock-and-shift operators of a ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d359769-845f-cd94-44ca-0f332deb97fe"],
 "-level qudit, the qudit entangling gate, and angular-momentum operators \
whose dimension is set by the spin. Each caption states the matrix or the \
action."
}], "Text",
 CellID->1633675818,ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell[TextData[{
 "The clock shift on a three-level qudit, cycling ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["j", "TI"]},
    "Ket"], "\[Rule]", 
   TemplateBox[{
     RowBox[{
       StyleBox["j", "TI"], "+", "1", 
       StyleBox["mod", FontSlant -> "Plain"], "3"}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 ":"
}], "Text",
 CellID->1828793009,ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Shift\>\"", "[", "3", "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->1232986364,ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

Cell[TextData[{
 "Acting on ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 " it advances the qutrit to ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04786d0e-016a-d127-2c07-8568b01ca00d"],
 ", amplitudes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", "1", ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],
 ":"
}], "Text",
 CellID->762269937,ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Shift\>\"", "[", "3", "]"}], "}"}], "]"}], "[", 
    RowBox[{"QuantumState", "[", 
     RowBox[{
      RowBox[{"{", 
