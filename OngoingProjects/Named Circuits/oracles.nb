Notebook[{
Cell["Oracles", "Title",
 CellID->874461601,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 "An oracle is the black box the search and query algorithms compile to: it \
marks the basis states that satisfy a Boolean condition. The four named \
oracles differ only in ",
 StyleBox["how", "TI"],
 " they mark, flip a target qubit, flip a sign, rotate a target, or load a \
whole function of the input, and all take the same formula and \
variable-placement arguments."
}], "Text",
 CellID->36768919,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell[TextData[{
 "Flag oracle: ",
 Cell[BoxData["BooleanOracle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"]
}], "Section",
 CellID->1699946459,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell["\<\
Flipping the target on the states that satisfy a formula, here a single \
multi-controlled gate for the one product term:\
\>", "Text",
 CellID->1535504786,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BooleanOracle\>\"", "[", 
     RowBox[{
      RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
      RowBox[{"\[FormalX]", "[", "2", "]"}]}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->1208482393,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell["\<\
A sum of exclusive-or terms compiles to one controlled gate per term (the \
ESOP form), so the gate count tracks the formula:\
\>", "Text",
 CellID->28909615,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BooleanOracle\>\"", "[", 
     RowBox[{"Xor", "[", 
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], ",", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}]}], "]"}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->193832008,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell["\<\
A variable-to-wire list placing the variables on wires 1 and 3, leaving wire \
2 idle and the target on wire 4:\
\>", "Text",
 CellID->684317082,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BooleanOracle\>\"", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->528485616,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell["\<\
An integer in the second slot sets the target wire, here wire 5, leaving the \
variables on 1,2 and wires 3,4 idle:\
\>", "Text",
 CellID->1392207227,ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BooleanOracle\>\"", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}]}], ",", " ", "5"}], "]"}], "}"}],
    "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->705466992,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"],

Cell[TextData[{
 "An operator in the second slot becomes the marking gate, turning the oracle \
into a controlled-",
 StyleBox["U", "TI"],
 " that applies an arbitrary unitary to the target on the satisfying states:"
}], "Text",
 CellID->1350516518,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BooleanOracle\>\"", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}]}], ",", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"\"\<RandomUnitary\>\"", ",", " ", 
        RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<U\>\""}]}], "]"}]}], 
     "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->907546795,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell[TextData[{
 "Phase oracle: ",
 Cell[BoxData["PhaseOracle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"]
}], "Section",
 CellID->814772321,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell["\<\
Flipping the sign of the satisfying states with no ancilla (width 2, not 3):\
\>", "Text",
 CellID->1054628905,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<PhaseOracle\>\"", "[", 
     RowBox[{
      RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
      RowBox[{"\[FormalX]", "[", "2", "]"}]}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->2043779557,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell["A variable-to-wire list fixing the wire of each variable:", "Text",
 CellID->17830494,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<PhaseOracle\>\"", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->1589986527,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

Cell[TextData[{
 "A third argument offsets every wire up by ",
 StyleBox["m", "TI"],
 ", here starting the oracle at wire 3:"
}], "Text",
 CellID->943101875,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<PhaseOracle\>\"", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}]}], ",", " ", "Automatic", ",", 
      " ", "2"}], "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",\

 CellLabel->"In[8]:= ",
 CellID->67888809,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell[TextData[{
 "Rotation oracle: ",
 Cell[BoxData["BooleanOracleR"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76dfbc62-92ac-7b6e-1ee4-364c275949b4"]
}], "Section",
 CellID->1432876021,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[TextData[{
 "Marking the states that satisfy a formula by a target rotation (",
 Cell[BoxData["RZ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 " by \[Pi]) rather than a flip:"
}], "Text",
 CellID->876231958,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BooleanOracleR\>\"", "[", 
     RowBox[{
      RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
      RowBox[{"\[FormalX]", "[", "2", "]"}]}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->1020575516,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell["A variable-to-wire list fixing each variable's wire:", "Text",
 CellID->1967685850,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BooleanOracleR\>\"", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->1044562475,ExpressionUUID->"3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],

Cell["\<\
A fourth argument sets the axis and angle of the marking rotation:\
\>", "Text",
 CellID->1653200050,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BooleanOracleR\>\"", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[FormalX]", "[", "1", "]"}], " ", "&&", " ", 
       RowBox[{"\[FormalX]", "[", "2", "]"}]}], ",", " ", "Automatic", ",", 
      " ", "Automatic", ",", " ", 
      RowBox[{"\"\<RY\>\"", "[", 
       RowBox[{"Pi", "/", "2"}], "]"}]}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->1384978530,ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell[TextData[{
 "Gray-code angle oracle: ",
 Cell[BoxData["GrayOracle"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04646437-faee-7dfc-2c1c-7e70fe9b47c6"]
}], "Section",
 CellID->519689844,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell["\<\
The default oracle: a CNOT ladder that loads an angle sequence onto a target \
over four input wires:\
\>", "Text",
 CellID->1609367578,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", "\"\<GrayOracle\>\"", "}"}], "]"}], "[", "\"\<Diagram\>\"", 
  "]"}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->1541450781,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell["\<\
A pure function loaded as target rotations, sampled over the input-register \
values:\
\>", "Text",
 CellID->1657269721,ExpressionUUID->"1f908cf3-3c70-d55a-45af-25bdb50abfa0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<GrayOracle\>\"", "[", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"#", "^", "2"}], " ", "&"}], ")"}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->1140508347,ExpressionUUID->"5dac66ba-272d-3627-0b54-7fe452d99d0d"],

Cell["An explicit list of angles in place of a function:", "Text",
 CellID->496109794,ExpressionUUID->"110914de-bbdd-83a1-4736-8d983e69d18b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<GrayOracle\>\"", "[", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1", ",", " ", "2", ",", " ", "3"}], "}"}], 
     "]"}], "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->108435171,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell["\<\
A precision argument sets the number of input wires, here 3 instead of 4, \
halving the ladder:\
\>", "Text",
 CellID->829388421,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<GrayOracle\>\"", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"#", "^", "2"}], " ", "&"}], ")"}], ",", " ", "3"}], "]"}], 
    "}"}], "]"}], "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->203008389,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell[TextData[{
 "A rotation-axis argument sets which rotation the angles drive, here ",
 Cell[BoxData["RZ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebf3687-f906-130d-7644-afe0f8b37e57"],
 ":"
}], "Text",
 CellID->1090263105,ExpressionUUID->"65de4a87-3471-cd9f-13e6-63e1bd0597e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<GrayOracle\>\"", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"#", "^", "2"}], " ", "&"}], ")"}], ",", " ", "3", ",", " ", 
      "Automatic", ",", " ", "\"\<RZ\>\""}], "]"}], "}"}], "]"}], 
  "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->1560876240,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"]
},
