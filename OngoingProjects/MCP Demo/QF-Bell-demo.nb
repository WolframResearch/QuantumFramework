Notebook[{
Cell["Bell state in QuantumFramework", "Title",ExpressionUUID->"996e68da-0254-4b5b-b2f1-af2caa7629fe"],

Cell["\<\
A Hadamard on the first qubit followed by a CNOT prepares a maximally \
entangled pair. \
\>", "Text",ExpressionUUID->"1641c67c-058d-43c5-af5f-b3b116561b43"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bell", "=", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<H\>\"", ",", "\"\<CNOT\>\""}], "}"}], "]"}], "[", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Values", " ", "@", " ", 
    RowBox[{"bell", "[", "\"\<Amplitudes\>\"", "]"}]}], ",", 
   RowBox[{"QuantumEntangledQ", "[", "bell", "]"}], ",", 
   RowBox[{"QuantumEntanglementMonotone", "[", 
    RowBox[{"bell", ",", "\"\<Concurrence\>\""}], "]"}]}], "}"}]}], "Input",Ex\
pressionUUID->"19eb6e58-9285-4906-b7ce-fc4f324f085f"]
},
