 defectiveZeroFailure = Failure["ZeroBasePowerDefective", <|
     "MessageTemplate" -> "0^m is the limit of b^m as b -> 0, which does not exist: the zero eigenvalue of m is defective, where b^m grows as Log[b]."
 |>]
+
