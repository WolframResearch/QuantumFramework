Cell[TextData[{
 "The matrix returns exactly as the lab-frame Rabi propagator, written here \
with the detuning ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], "\[Congruent]", 
   StyleBox["\[Omega]", "TI"], "-", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3181a460-bc62-f1ee-67be-3e4a3514c334"],
 " and the generalized Rabi frequency ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalOmega]", 
    StyleBox["R", "TI"]], "\[Congruent]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "+", 
     SuperscriptBox[
      StyleBox["\[Delta]", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],
 ":"
}], "Text",
 CellID->1633675818,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

