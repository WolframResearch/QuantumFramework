Cell[TextData[{
 "Apply the Born rule ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["i", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c044c4-b778-74e1-42f0-5da1c20d5ecb"],
 " to all four effects at once:"
}], "Text",
 CellID->476175344,ExpressionUUID->"3d9aa029-60a8-273a-6bb9-3a7311428a00"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"probs", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"psi", "[", "\"\<DensityMatrix\>\"", "]"}], " ", ".", " ", 
        RowBox[{"Normal", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@", 
     " ", 
     RowBox[{"sic", "[", "\"\<POVMElements\>\"", "]"}]}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[53]:=",
 CellID->201272189,ExpressionUUID->"64adc082-4122-deff-0c52-d9ec70d4a4c5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox["1", "4"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", "12"], " ", 
    RowBox[{"(", 
     RowBox[{"3", "-", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "-", 
      RowBox[{
       SqrtBox["2"], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Phi]", "]"}], "+", 
         RowBox[{
          SqrtBox["3"], " ", 
          RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ")"}]}]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", "12"], " ", 
    RowBox[{"(", 
     RowBox[{"3", "-", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "-", 
      RowBox[{
       SqrtBox["2"], " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "+", 
      RowBox[{
       SqrtBox["6"], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", "12"], " ", 
    RowBox[{"(", 
     RowBox[{"3", "-", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "+", 
      RowBox[{"2", " ", 
       SqrtBox["2"], " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}]}]}], "}"}]], "Output",\

 CellChangeTimes->{4.00094269639755*^9},
 CellLabel->"Out[53]=",ExpressionUUID->"b43c0224-89d6-4b0e-b477-ee30d866b786"]
}, Open  ]],

Cell[TextData[{
 "The four probabilities return exactly as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], "=", 
   FractionBox["1", "4"], 
   StyleBox["(",
    FontSize->1.2 Inherited], "1", "+", 
   OverscriptBox[
    StyleBox["r", "TI"], "^"], "\[CenterDot]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], 
    StyleBox["i", "TI"]], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e451771-8a55-ceec-267a-8f3b2fe19436"],
 ", the first reading ",
 Cell[BoxData[
  FractionBox[
   RowBox[{"1", "+", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"]}], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4670f053-f537-0b3f-6e0f-ea1cfcc25605"],
 " and the others ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "12"], 
   StyleBox["(",
    FontSize->1.2 Inherited], "3", "-", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "+", 
   SqrtBox["2"], "\[ThinSpace]", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], "\[Ellipsis]", 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "330aabc0-bdd5-22a3-6109-42aa34607089"],
 " along the remaining tetrahedron directions ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["n", "TI"], "^"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],
 ", with ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["r", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d705b8-410a-1477-20ec-9ce270bf7f5d"],
 " the state's Bloch vector; they sum to ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "737c509e-bc52-eefb-2104-49d835e4b4c1"],
 " identically (verified). Pin the state to the north pole and the general \
formulas collapse to numbers:"
}], "Text",
 CellID->320292756,ExpressionUUID->"01a44b6b-c85f-9e0e-375c-6334e9ebe554"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"probs", " ", "/.", " ", 
  RowBox[{"\[Theta]", " ", "->", " ", "0"}]}]], "Input",
 CellLabel->"In[54]:=",
 CellID->1146801282,ExpressionUUID->"10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", "2"], ",", 
   FractionBox["1", "6"], ",", 
   FractionBox["1", "6"], ",", 
   FractionBox["1", "6"]}], "}"}]], "Output",
 CellChangeTimes->{4.000942696406101*^9},
 CellLabel->"Out[54]=",ExpressionUUID->"700b7824-6fe0-44ce-80ef-14b2bcc75566"]
}, Open  ]],

Cell[TextData[{
 "The distribution collapses to simple rationals: ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25120901-cfbc-a8e6-5321-a16aea4efacc"],
 " assigns probability one half to the tetrahedron vertex nearest the pole \
and one sixth to each of the other three. Because the SIC is informationally \
complete, these four probabilities are not merely statistics of the state; \
they determine the state: ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ee7491f-72c3-8814-669d-61590777db7e"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67860241-8011-89c8-0dbd-a42b31a5db12"],
 " can be recovered from them, which is what makes SIC measurements a natural \
basis for tomography."
}], "Text",
 CellID->41202278,ExpressionUUID->"1318f44b-7a0d-b86f-4127-ee157fb90ab5"],

Cell["\<\
The SIC is not only a symbolic Born-rule calculation; it is a measurement \
that drops directly into a circuit, alongside the gates, on any chosen wire. \
Place the tetrahedron SIC as a measurement on the first qubit:\
\>", "Text",
 CellID->1124146653,ExpressionUUID->"221ecbfd-1ed7-d323-5225-e2a79b63be09"],

