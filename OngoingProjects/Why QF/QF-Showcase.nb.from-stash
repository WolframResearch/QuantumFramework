 RowBox[{"coded", " ", "=", " ", 
  RowBox[{"qec", "[", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], ",", " ", 
     RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[104]:=",
 CellID->561487989,ExpressionUUID->"2da78195-91be-94f0-5b5c-18df2048feda"],

