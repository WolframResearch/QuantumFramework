  Wolfram`QuantumFramework`QuantumOperator[
   Wolfram`QuantumFramework`QuantumState[
   SparseArray[
    Automatic, {4}, 0., {
     1, {{0, 4}, {{1}, {2}, {3}, {4}}}, {
      2.718281828459045^(Complex[0., -0.25] $CellContext`t^2) 
       Hypergeometric1F1[
        Complex[0., 0.125] $CellContext`g, 0.5, 
         Complex[0., 0.5] $CellContext`t^2], 
       Complex[0.15915494309189535`, 0.15915494309189532`] 
       2.718281828459045^(Complex[0., -0.25] $CellContext`t^2) $CellContext`g^
        Rational[1, 2] (
        2.718281828459045^(Complex[0., 0.5] $CellContext`t^2) 
         Gamma[1. + Complex[0., -0.25] $CellContext`g] 
         Gamma[Complex[0., 0.125] $CellContext`g] 
         HermiteH[-1. + Complex[0., 0.25] $CellContext`g, 
           Complex[-0.5, 0.5] $CellContext`t] - 1. 
        Gamma[0.5 + Complex[0., -0.125] $CellContext`g] 
        Gamma[Complex[0., 0.25] $CellContext`g] 
        HermiteH[
         Complex[0., -0.25] $CellContext`g, 
          Complex[0.5, 0.5] $CellContext`t])/(
       Csch[0.39269908169872414` $CellContext`g] - 1. 
       Sech[0.39269908169872414` $CellContext`g]), 
       Complex[-0.6366197723675814, -0.6366197723675814] 
       2.718281828459045^(Complex[0., -0.25] $CellContext`t^2) $CellContext`g^
        Rational[-1, 2] (
        Gamma[1. + Complex[0., -0.125] $CellContext`g] 
         Gamma[Complex[0., 0.25] $CellContext`g] (-
           HermiteH[
            1. + Complex[0., -0.25] $CellContext`g, 
             Complex[0.5, 0.5] $CellContext`t] + 
          Complex[1., 1.] $CellContext`t 
           HermiteH[
            Complex[0., -0.25] $CellContext`g, 
             Complex[0.5, 0.5] $CellContext`t]) + 
        2.718281828459045^(Complex[0., 0.5] $CellContext`t^2) 
         Gamma[0.5 + Complex[0., 0.125] $CellContext`g] 
         Gamma[1. + Complex[0., -0.25] $CellContext`g] 
         HermiteH[
          Complex[0., 0.25] $CellContext`g, 
           Complex[-0.5, 0.5] $CellContext`t])/(
       Csch[0.39269908169872414` $CellContext`g] - 1. 
       Sech[0.39269908169872414` $CellContext`g]), 0.3183098861837907 
       2.^(-0.5 + Complex[0., -0.125] $CellContext`g) (
        2. Gamma[0.5 + Complex[0., -0.125] $CellContext`g] 
         Gamma[Complex[0., 0.25] $CellContext`g] (-
           ParabolicCylinderD[
            1. + Complex[0., -0.25] $CellContext`g, 
             Complex[0.7071067811865476, 0.7071067811865475] $CellContext`t] + 
          Complex[0.7071067811865476, 0.7071067811865475] $CellContext`t 
           ParabolicCylinderD[
            Complex[0., -0.25] $CellContext`g, 
             Complex[0.7071067811865476, 0.7071067811865475] $CellContext`t]) + 
        Complex[0., 1.] 2.^(0.5 + Complex[0., 0.25] $CellContext`g) 
         Gamma[1. + Complex[0., -0.25] $CellContext`g] 
         Gamma[Complex[0., 0.125] $CellContext`g] 
         ParabolicCylinderD[
          Complex[0., 0.25] $CellContext`g, 
           Complex[-0.7071067811865475, 0.7071067811865476] $CellContext`t])/(
       Csch[0.39269908169872414` $CellContext`g] - 1. 
       Sech[0.39269908169872414` $CellContext`g])}}], 
    Wolfram`QuantumFramework`QuantumBasis[<|
     "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
           Wolfram`QuantumFramework`QuditName[0, "Dual" -> True], 1} -> 
         SparseArray[Automatic, {2}, 0., {1, {{0, 1}, {{1}}}, {1.}}], {
           Wolfram`QuantumFramework`QuditName[1, "Dual" -> True], 1} -> 
         SparseArray[Automatic, {2}, 0., {1, {{0, 1}, {{2}}}, {1.}}]|>], 
      "Output" -> Wolfram`QuantumFramework`QuditBasis[<|{
           Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 1} -> 
         SparseArray[Automatic, {2}, 0., {1, {{0, 1}, {{1}}}, {1.}}], {
           Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 1} -> 
         SparseArray[Automatic, {2}, 0., {1, {{0, 1}, {{2}}}, {1.}}]|>], 
      "Picture" -> "Schrodinger", "Label" -> None, 
      "ParameterSpec" -> {{$CellContext`g, 0, 1}, {$CellContext`t, 0, 
         1}}|>]], {{1}, {1}}],
  Editable->False,
  SelectWithContents->True,
  Selectable->False]], "Output",
