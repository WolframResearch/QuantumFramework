Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"psi", "[", "\"\<Purity\>\"", "]"}], " ", "//", " ", 
  "FullSimplify"}]], "Input",
 CellLabel->"In[43]:=",
 CellID->1335749844,ExpressionUUID->"05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],

Cell[BoxData["1"], "Output",
