    RowBox[{"Sin", "[", 
     RowBox[{
      FractionBox["1", "2"], " ", "t", " ", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["\[CapitalOmega]", "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Omega]", "-", "\[Omega]0"}], ")"}], "2"]}]]}], "]"}], 
    "2"]}], 
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "+", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"\[Omega]", "-", "\[Omega]0"}], ")"}], "2"]}]]], "Output",
 CellChangeTimes->{4.000942429299361*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"521b3587-2808-468e-981d-60c4b78a29ab"]
}, Open  ]],

Cell[TextData[{
 "The result is the textbook Rabi formula, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    RowBox[{"0", "\[Rule]", "1"}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    SuperscriptBox["\[CapitalOmega]", "2"], 
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "+", 
     SuperscriptBox[
      StyleBox["\[Delta]", "TI"], "2"]}]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "\[NegativeThinSpace]", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   FractionBox[
    StyleBox["t", "TI"], "2"], 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "+", 
     SuperscriptBox[
      StyleBox["\[Delta]", "TI"], "2"]}]], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c239bd0-3ff5-3b18-25d0-129ab9818662"],
 ". On resonance (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c76573-72ce-0c1a-18fd-7d3d077b5760"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6184d2f2-049e-728e-17bb-cbbcad2b40d4"],
 ") this is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CapitalOmega]", 
    StyleBox["t", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fd967ef-5008-0b29-75e7-7ec961bd5673"],
 ": complete Rabi flopping between ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19bb1c5e-57ab-6e36-4f58-9618625e351c"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],
 ". The oscillation rate ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox["\[CapitalOmega]", "2"], "+", 
    SuperscriptBox[
     StyleBox["\[Delta]", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30baa1c8-66ad-75e0-6059-389213585fca"],
 " is the generalized Rabi frequency, the dressed-state gap in the rotating \
frame, here recovered as a closed-form function of the drive detuning and \
strength."
}], "Text",
 CellID->1039057480,ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["When the closed form needs special functions: Landau-Zener", \
"Subsection",
 CellID->1411198270,ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell[TextData[{
 "The rotating-field propagator was elementary, but symbolic evolution is not \
limited to elementary functions. Sweep the energy bias linearly through an \
avoided crossing at rate ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7421cf44-a1ac-4319-1dde-e721d0592e63"],
 " with a constant gap ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "511b3347-8d7d-ab60-0738-ab212409f64a"],
 ": the Landau-Zener model ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    StyleBox[
     RowBox[{"v", "t"}], "TI"], "2"], "\[ThinSpace]", 
   StyleBox["Z", "TI"], "+", 
   FractionBox["\[CapitalDelta]", "2"], "\[ThinSpace]", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36c19c85-764d-0b01-5efe-15ef03f8566b"],
 ", which asks whether a system swept through a level crossing stays in its \
energy branch or crosses the gap. It is again time-dependent and \
non-commuting:"
}], "Text",
 CellID->1703453532,ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"hlz", " ", "=", " ", 
