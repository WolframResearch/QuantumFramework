Cell[TextData[{
 "The diagram shows the bra-ket structure block by block: the labeled ",
 Cell[BoxData["Prep"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0642d375-09f3-9942-2e71-cb3faf87eba8"],
 "/",
 Cell[BoxData["Cost"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0651775d-2bad-791b-2e6f-6f074e584861"],
 "/",
 Cell[BoxData["Mixer"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63b9e3d6-2298-231e-1146-fa9057128e64"],
 " layer, the ",
 Cell[BoxData["Hamiltonian"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67c13665-f813-2f11-0dfe-a84ef9a6727b"],
 " in the middle, and the daggered layer mirrored on the right. Calling the \
same object with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"[", "]"}], "[", "\"\<Scalar\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c440104-ea8a-4285-747b-99618f3f10ef"],
 " returns the number, with no manual inner product:"
}], "Text",
 CellID->168408080,ExpressionUUID->"66c9a615-af45-c085-0ef6-385ecaf192ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"landscape", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"meanvalue", "[", "]"}], "[", "\"\<Scalar\>\"", "]"}], ",", " ", 
    
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Gamma]", ",", " ", "\[Theta]"}], "}"}], ",", " ", "Reals"}],
      "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[34]:=",
 CellID->811283638,ExpressionUUID->"0513e607-0f4c-1e20-3320-f861aaf9650a"],

Cell[BoxData[
 RowBox[{
  FractionBox["3", "8"], " ", 
  RowBox[{"(", 
   RowBox[{"7", "+", 
    RowBox[{"Cos", "[", 
     RowBox[{"2", " ", "\[Theta]"}], "]"}], "+", 
    RowBox[{"2", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"4", " ", "\[Gamma]"}], "]"}], " ", 
     SuperscriptBox[
      RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "-", 
    RowBox[{"8", " ", 
     SuperscriptBox[
      RowBox[{"Cos", "[", "\[Gamma]", "]"}], "2"], " ", 
     RowBox[{"Sin", "[", "\[Gamma]", "]"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", " ", "\[Theta]"}], "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{4.000942692113888*^9},
 CellLabel->"Out[34]=",ExpressionUUID->"dfb10963-7dc0-4f3d-a033-d9222f859c07"]
}, Open  ]],

Cell[TextData[{
 "The exact QAOA energy landscape returns as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["C", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Gamma]", "TI"], ",", 
    StyleBox["\[Theta]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["3", "8"], 
   StyleBox["(",
    FontSize->1.2 Inherited], "7", "+", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", "2", 
   StyleBox["\[Theta]", "TI"], "+", "2", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", "4", 
   StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "-", "8", 
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "2", 
   StyleBox["\[Theta]", "TI"], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0371ff35-cd30-cda2-310e-f77ee4ca9788"],
 ", a closed form in the two angles."
}], "Text",
 CellID->207978548,ExpressionUUID->"6833ae6a-6ac5-a2c8-19c0-40340f71f012"],

Cell["\<\
Because the landscape is a formula, the whole optimization problem can be \
looked at before it is solved. Plot the surface over a full period of both \
angles:\
\>", "Text",
 CellID->437474228,ExpressionUUID->"5f7f2999-1aee-25a5-0504-c0c39e988f8f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{"landscape", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Gamma]", ",", " ", "0", ",", " ", 
     RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", "0", ",", " ", 
     RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "  ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<\[Theta]\>\"", ",", 
      " ", "\"\<cost\>\""}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"ColorFunction", " ", "->", " ", "\"\<TemperatureMap\>\""}], ",", 
   "\n", "  ", 
   RowBox[{"PlotPoints", " ", "->", " ", "50"}]}], "]"}]], "Input",
 CellLabel->"In[35]:=",
 CellID->874582697,ExpressionUUID->"128c7526-c883-085d-42b4-6c83e9365aa7"],

