Cell[TextData[{
 "Apply it to ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"0", "\[Ellipsis]", "0"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43e301a0-76bb-1057-7190-980a034e62bd"],
 " through a greedily chosen contraction path:"
}], "Text",
 CellID->1670620029,ExpressionUUID->"1ae06f2b-7109-3ba5-4a9f-877500bd898f"],

Cell[BoxData[
 RowBox[{"found", " ", "=", " ", 
  RowBox[{"grover", "[", 
   RowBox[{"Method", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<TensorNetwork\>\"", ",", " ", 
      RowBox[{"\"\<Path\>\"", " ", "->", " ", "\"\<Greedy\>\""}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[120]:=",
 CellID->588214459,ExpressionUUID->"0856a555-3f58-6085-386d-3d1fbaed32ef"],

Cell["Read the largest outcome probability:", "Text",
 CellID->1759496502,ExpressionUUID->"71eecbe3-9be0-9ba6-2795-e2cd1d9ae98c"],

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"found", "[", "\"\<Probabilities\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[113]:= ",
 CellID->1641757231,ExpressionUUID->"59070895-187c-42ea-0f3c-a1df99091030"],

Cell["\<\
Because the contraction stayed exact, the probability comes back as an exact \
rational, a ratio of large integers. Read it as a decimal:\
\>", "Text",
 CellID->896279625,ExpressionUUID->"189fe470-6cd8-7cf4-48a4-fe3a056d46de"],

Cell[BoxData[
 RowBox[{"%", " ", "//", " ", "N"}]], "Input",
 CellLabel->"In[114]:= ",
 CellID->1264190945,ExpressionUUID->"04ed2843-d86c-272a-2c92-c22cd91e8a70"],

Cell[TextData[{
 "The success probability is very close to ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d9e217-b7c7-416b-20e6-0450c27213b1"],
 ", at the analytic Grover peak ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "\[NegativeThinSpace]", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["k", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["arcsin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SqrtBox[
    RowBox[{"1", "/", 
     StyleBox["N", "TI"]}]], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29221b72-bc55-8ef4-58d1-933c35e1d4de"],
 " that the iteration count ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "12"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41172bde-c012-830e-772c-c29bf1a4ee54"],
 " is chosen to reach; the most probable bitstring is the marked input \
itself, ",
 Cell[BoxData[
  RowBox[{"200", "=", "11001000"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dd84232-0c35-660d-6bf8-647ca5c04d57"],
 " (verified). A search of a few hundred gates, contracted in one steered \
pass."
}], "Text",
 CellID->1806910998,ExpressionUUID->"5558c8fc-3d33-9e90-0367-e1a6b4c7e4fa"],

Cell["\<\
The contraction plan is itself an inspectable object. Extract the circuit's \
tensor network:\
\>", "Text",
 CellID->962064851,ExpressionUUID->"53291d47-a111-bd44-02d6-9520d0a507ae"],

Cell[BoxData[
 RowBox[{"net", " ", "=", " ", 
  RowBox[{"grover", "[", "\"\<TensorNetwork\>\"", "]"}]}]], "Input",
 CellLabel->"In[115]:= ",
 CellID->1660212291,ExpressionUUID->"14460f59-6b0f-818e-3c7d-a7030ebbd3d4"],

Cell["\<\
Compute the greedy path and draw it as a tree, its branching the order in \
which the network is folded together:\
\>", "Text",
 CellID->1553450743,ExpressionUUID->"6afe19ed-5a5e-331e-1a85-90b75fe89e64"],

Cell[BoxData[
 RowBox[{"ContractionTree", "[", "\n", " ", 
  RowBox[{
   RowBox[{"TensorNetworkContraction", "[", 
    RowBox[{"net", ",", " ", 
     RowBox[{"GreedyContractionPath", "[", "net", "]"}]}], "]"}], ",", " ", 
   "\n", " ", 
   RowBox[{"TreeElementLabel", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{"All", " ", "->", " ", "None"}], ")"}]}], ",", " ", "\n", " ", 
   RowBox[{"TreeElementShapeFunction", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{"All", " ", "->", " ", "None"}], ")"}]}]}], "]"}]], "Input",
 CellLabel->"In[116]:= ",
 CellID->376345483,ExpressionUUID->"142f588d-e120-bc70-3dd5-51d690da075a"],

Cell["\<\
The tree is the contraction schedule: the leaves are the circuit's gate and \
state tensors, every internal node is one pairwise contraction, and the \
branching structure is the order the greedy path chose, showing which \
contractions are nested. The depth and balance of that tree are what the path \
adjusts to keep each intermediate tensor small.\
\>", "Text",
 CellID->1917523023,ExpressionUUID->"029948d8-232c-2201-32a7-618256d9716b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The stabilizer engine: the state as its symmetry group", "Subsection",
 CellID->225924774,ExpressionUUID->"4b1b5b6f-b43d-594b-7939-53493dc82b91"],

Cell[TextData[{
 "For Clifford circuits there is a representation that does not use \
amplitudes: store the state as the group of Pauli operators that fix it, ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     StyleBox["P", "TI"], ":", 
     RowBox[{
      StyleBox["P", "TI"], 
      TemplateBox[{
        StyleBox["\[Psi]", "TI"]},
       "Ket"]}]}], "=", 
    RowBox[{"+", 
     TemplateBox[{
       StyleBox["\[Psi]", "TI"]},
      "Ket"]}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32f703b9-71e1-95eb-628c-9ae30795ff31"],
 ", whose ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c860bbc-8d1f-f590-34bd-a2e624abdffa"],
 " commuting generators determine the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bab88a0-6539-d521-49a8-210a0ccdbc0b"],
 "-qubit state uniquely and fit in a binary symplectic tableau. This is the \
Gottesman-Knill representation, in which a Clifford gate is a constant-size \
rewrite of the tableau rather than a ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["2", 
    StyleBox["n", "TI"]], "\[Times]", 
   SuperscriptBox["2", 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74b37722-3fdc-1a4f-1c41-6e8cba696895"],
 " matrix product. The engine is selected by one option. Build a five-qubit \
linear cluster state, the entangled resource behind measurement-based \
computing, as a layer of Hadamards followed by nearest-neighbor controlled-",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31781dc2-1028-33d4-6707-94aca1c2813e"],
 " gates:"
}], "Text",
 CellID->1508526016,ExpressionUUID->"2148b02c-d62e-5336-5777-2989e3db3e1c"],

Cell[BoxData[
 RowBox[{"cluster5", " ", "=", " ", 
  RowBox[{"QuantumCircuitOperator", "[", "\n", "   ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"\"\<H\>\"", " ", "->", " ", 
       RowBox[{"Range", "[", "5", "]"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5"}], "}"}]}]}], "}"}]}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[117]:= ",
 CellID->1653333794,ExpressionUUID->"183293a6-0d60-7813-49c1-0a00a4154b79"],

Cell["Draw the circuit:", "Text",
 CellID->2117504204,ExpressionUUID->"61e1f3c1-eae0-3799-179e-eaaa8e9a9de3"],

Cell[BoxData[
 RowBox[{"cluster5", "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[118]:= ",
 CellID->201091240,ExpressionUUID->"20bddc2d-650e-8031-5042-d6770cb8d31b"],

Cell[TextData[{
 "The diagram is an ordinary gate-model circuit: a Hadamard on every wire, \
then controlled-",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a437910-f355-55ba-2a71-715d86e03f80"],
 " gates down the chain ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49429438-4a3e-974e-7f71-0e626fc8fd94"],
 "-",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07e2168c-1726-1a27-2d91-8fd6a2d3690d"],
 "-",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3540c51c-f580-c338-637f-dd59fc3aae02"],
 "-",
 Cell[BoxData["4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "684f0173-fe99-1571-1874-993cfb2c7c5b"],
 "-",
 Cell[BoxData["5"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e32c5a8-aee9-5273-17c1-dcf5ca9c2159"],
 ". Nothing about it is stabilizer-specific yet; the engine is a choice made \
at application time."
}], "Text",
 CellID->667003370,ExpressionUUID->"607492e2-157b-ba0c-100b-0bcc9c0f0956"],

Cell["Apply it with the stabilizer engine instead of the default:", "Text",
 CellID->526043023,ExpressionUUID->"7781757c-388d-abb9-1dbf-6d26b939f983"],

Cell[BoxData[
 RowBox[{"stab5", " ", "=", " ", 
  RowBox[{"cluster5", "[", 
   RowBox[{"Method", " ", "->", " ", "\"\<Stabilizer\>\""}], "]"}]}]], "Input",\

 CellLabel->"In[119]:= ",
 CellID->1120596176,ExpressionUUID->"566e7348-207a-dc95-7e16-6b12510ca6ff"],

Cell[TextData[{
 "A purely Clifford circuit that would otherwise carry a ",
 Cell[BoxData[
  SuperscriptBox["2", "5"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39672ae7-82f4-b353-6f1c-c3c1368601b9"],
 " amplitude vector returns instead a ",
 Cell[BoxData["PauliStabilizer"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c48aba4-6f27-6a39-3477-420e0ad23903"],
 ": the state stored as its symmetry group, not as its amplitudes."
}], "Text",
 CellID->64105026,ExpressionUUID->"2f62374d-f3df-131c-5511-af16866a7e66"],

Cell["Read the generators of that group:", "Text",
 CellID->1373525465,ExpressionUUID->"455ea632-3d4d-f0d3-7365-387cb4f9c239"],

Cell[BoxData[
 RowBox[{"stab5", "[", "\"\<PauliForm\>\"", "]"}]], "Input",
 CellLabel->"In[120]:= ",
 CellID->1964307623,ExpressionUUID->"1f0fb95c-030e-c889-4534-3106b6b89ad3"],

Cell[TextData[{
 "Five Pauli strings that determine the state completely. They are exactly \
the cluster-state generators ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["K", "TI"], 
    StyleBox["v", "TI"]], "=", 
   SubscriptBox[
    StyleBox["X", "TI"], 
    StyleBox["v", "TI"]], 
   UnderscriptBox["\[Product]", 
    RowBox[{
     StyleBox["w", "TI"], "\[Tilde]", 
     StyleBox["v", "TI"]}],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["w", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16268eae-a572-7912-3fdd-270bcc074878"],
 " along the chain, the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "346a0e1a-2221-987e-5c69-a04457d5eb44"],
 " on each site flanked by ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "366be24c-537a-43bb-5e68-0416660f1181"],
 " on its neighbors."
}], "Text",
 CellID->39040159,ExpressionUUID->"501b1457-1a1d-907b-0038-8e119fa9e341"],

Cell["\<\
Pauli expectations are closed-form algebra on the generators, with no state \
vector anywhere:\
\>", "Text",
 CellID->1242473813,ExpressionUUID->"291c68e0-f532-6cdd-5f23-81cdfcc73627"],

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<XZIII\>\"", " ", "->", " ", 
    RowBox[{"stab5", "[", 
     RowBox[{"\"\<Expectation\>\"", ",", " ", "\"\<XZIII\>\""}], "]"}]}], ",",
    " ", 
   RowBox[{"\"\<IZXZI\>\"", " ", "->", " ", 
    RowBox[{"stab5", "[", 
     RowBox[{"\"\<Expectation\>\"", ",", " ", "\"\<IZXZI\>\""}], "]"}]}], ",",
    " ", 
   RowBox[{"\"\<XXIII\>\"", " ", "->", " ", 
    RowBox[{"stab5", "[", 
     RowBox[{"\"\<Expectation\>\"", ",", " ", "\"\<XXIII\>\""}], "]"}]}]}], 
  "|>"}]], "Input",
 CellLabel->"In[121]:= ",
 CellID->290269587,ExpressionUUID->"5c29c458-c353-7b98-05d6-de05f6e649e2"],

Cell[TextData[{
 "The two generators ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["K", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1a2d6a-d2ad-c32a-1639-c537e759ae70"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["K", "TI"], "3"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6eb5612b-2266-f0f1-164b-79755710c2db"],
 " return deterministically ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f4b4965-e043-b514-4549-614e91f71c7e"],
 ", while ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"X", "X"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf36e21-2d79-2b6f-0980-878b440c79b5"],
 " on the first two sites, which anticommutes with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["K", "TI"], "1"], "=", 
   SubscriptBox[
    StyleBox["X", "TI"], "1"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fe9f85b-1ce6-27f0-1596-f20594908dda"],
 ", is exactly unbiased, all read off by ",
 Cell[BoxData[
  SubscriptBox["\|01d53d", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3eadea9f-7d43-757d-6652-03d974f65c47"],
 " phase tracking."
}], "Text",
 CellID->471335900,ExpressionUUID->"68be2dd2-eea3-f2cb-1845-c49f8b57c011"],

Cell[TextData[{
 "The advantage of the representation is scale. Apply twenty thousand random \
Clifford gates to a thousand qubits, a state whose amplitude vector would \
need ",
 Cell[BoxData[
  SuperscriptBox["2", "1000"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1279eb8d-ef8a-5dbb-4206-02d68a3f2781"],
 " entries. The qubit count:"
}], "Text",
 CellID->1843091513,ExpressionUUID->"6afb4307-9f81-9d1b-1a99-5b611a35e461"],

Cell[BoxData[
 RowBox[{
  RowBox[{"n", " ", "=", " ", "1000"}], ";"}]], "Input",
 CellLabel->"In[122]:= ",
 CellID->1978684664,ExpressionUUID->"2e902be9-4fb4-3e90-56af-c2b36a4684fa"],

Cell["\<\
Build the random gate stream, twenty thousand Hadamard, CNOT, and phase gates \
(seeded for reproducibility):\
\>", "Text",
 CellID->2064137570,ExpressionUUID->"46e8ad28-93a4-355d-6e97-457226569fa7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gates", " ", "=", " ", 
   RowBox[{"Flatten", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<H\>\"", " ", "->", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "n"}], "}"}], "]"}]}], ",", " ", 
        RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
         RowBox[{"RandomSample", "[", 
          RowBox[{
           RowBox[{"Range", "[", "n", "]"}], ",", " ", "2"}], "]"}]}], ",", 
        " ", 
        RowBox[{"\"\<S\>\"", " ", "->", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "n"}], "}"}], "]"}]}]}], "}"}], ",", " ", 
      RowBox[{"{", "6666", "}"}]}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[123]:= ",
 CellID->1265784226,ExpressionUUID->"43090fa7-5002-8b65-7136-a60161b4d64f"],

Cell[TextData[{
 "Apply them to the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d6689b0-bbf9-a698-3b1d-20fa3d8d0ce2"],
 "-qubit stabilizer state and time the evolution:"
}], "Text",
 CellID->872599864,ExpressionUUID->"4ac87485-b214-a6e0-7ac8-6deec7a60cca"],

Cell[BoxData[
 RowBox[{"First", " ", "@", " ", 
  RowBox[{"AbsoluteTiming", "[", 
   RowBox[{
    RowBox[{"big", " ", "=", " ", 
     RowBox[{
      RowBox[{"PauliStabilizer", "[", "n", "]"}], "[", 
      RowBox[{"\"\<ApplyCircuit\>\"", ",", " ", "gates"}], "]"}]}], ";"}], 
   "]"}]}]], "Input",
 CellLabel->"In[124]:= ",
 CellID->2056057710,ExpressionUUID->"56e1d4b5-6b25-2976-7e9e-cdff0ed0785c"],

Cell[TextData[{
 "The whole gate stream folds in a fraction of a second: ",
 Cell[BoxData["ApplyCircuit"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e41722a-1026-02f0-567f-7474a1d350da"],
 " runs the tableau updates through one compiled kernel whose per-gate cost \
is flat in ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aacec8a-85e6-bbaa-1a53-05d4339009f0"],
 " and independent of the ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c51a735-fee5-6802-446e-3f7efa903b68"],
 " that never gets built. Raw tableau speed is not the claim here, and a \
dedicated C++ stabilizer simulator is faster still; the claim is that this \
thousand-qubit state lives in the same object model as everything else in \
this document, so a property of it comes back as an exact closed form rather \
than a sampled estimate. The bipartite entanglement entropy across the \
half-chain cut is one such form, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["rank",
     FontSlant->"Plain"], 
    SubscriptBox["\|01d53d", "2"]], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox[
     RowBox[{
     "generators", "\[NonBreakingSpace]", "restricted", "\[NonBreakingSpace]",
       "to", "\[NonBreakingSpace]"}],
     FontSlant->"Plain"], 
    StyleBox["A", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", GridBox[{
     {
      StyleBox["A", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e54a15d-ecde-9aa9-066b-39068568e8f3"],
 ", exact at any qubit count:"
}], "Text",
 CellID->1360523735,ExpressionUUID->"27fb6428-ecec-27d4-4d99-7e75849e8d3e"],

Cell[BoxData[
 RowBox[{"big", "[", 
  RowBox[{"\"\<Entropy\>\"", ",", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"n", "/", "2"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[125]:= ",
 CellID->676766013,ExpressionUUID->"51f5ca74-88a2-9d2c-078a-ec3e2954e476"],

Cell[TextData[{
 "The entropy returns just below its half-chain maximum: the random circuit \
has driven the chain to near-maximal, Page-like entanglement, and whatever \
gate sequence the sampler draws, the value is an exact integer from an ",
 Cell[BoxData[
  SubscriptBox["\|01d53d", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1154648e-ef0b-aa2b-476c-7deb8abff971"],
 " rank, not an estimate. The boundary of the formalism is handled directly \
as well: a non-Clifford gate (",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c057904-8649-af2b-743b-716e33fdf271"],
 ", or a general phase) steps outside the stabilizer group, and QF returns a ",
 Cell[BoxData["StabilizerFrame"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2baf9433-2e90-ebaf-5954-0e7d4b2ab9f5"],
 ", a superposition of stabilizer states, rather than a wrong answer."
}], "Text",
 CellID->1428640414,ExpressionUUID->"340e6ec8-e38f-b030-5c35-8795963b031a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The representations convert exactly", "Subsection",
 CellID->1143649234,ExpressionUUID->"64bff79f-1679-3ebc-0c44-eed9a30d8486"],

Cell[TextData[{
 "The engines are not separate; one object model means the representations \
interconvert. Start from an ordinary three-qubit linear cluster circuit, a \
Hadamard on every wire followed by two nearest-neighbor ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"C", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "126dc52b-3dd5-bd31-4212-dd75b461041b"],
 " bonds:"
}], "Text",
 CellID->1571962290,ExpressionUUID->"28023c0b-10a3-7000-5831-b655a156436a"],

Cell[BoxData[
 RowBox[{"cluster3", " ", "=", " ", 
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<H\>\"", " ", "->", " ", 
      RowBox[{"Range", "[", "3", "]"}]}], ",", " ", "\"\<CZ\>\"", ",", " ", 
     RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}]}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[126]:= ",
 CellID->2091585593,ExpressionUUID->"4f1b960d-0301-b7cd-7538-0857b6b51d17"],

Cell["Draw it:", "Text",
 CellID->30157833,ExpressionUUID->"268b8fe7-2cf2-fa64-4e88-26c14484c94e"],

Cell[BoxData[
 RowBox[{"cluster3", "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[127]:= ",
 CellID->1715653387,ExpressionUUID->"41763b34-5a53-ec31-770d-b37e5fe7b71b"],

Cell[TextData[{
 "The bare ",
 Cell[BoxData["\"\<CZ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d61c4f4-c0fb-847a-0b1e-ddb1f08fef40"],
 " acts on the default first pair and ",
 Cell[BoxData[
  RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"2", ",", " ", "3"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72fe9a0c-0c49-239f-2285-1c56a5fc71e5"],
 " on the next, so the diagram shows the bond chain ",
 Cell[BoxData[
  RowBox[{
  "1", "\[NegativeThinSpace]", "-", "\[NegativeThinSpace]", "2", 
   "\[NegativeThinSpace]", "-", "\[NegativeThinSpace]", "3"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14bcbead-0cb8-f132-3c43-37f7a532c018"],
 ": nothing here is stabilizer-specific, only gates."
}], "Text",
 CellID->1904268993,ExpressionUUID->"4a015340-38cc-91ca-7a3f-4b2ab97ee310"],

Cell["\<\
Apply that same circuit through the stabilizer engine, which stores the state \
as its symmetry group rather than its amplitudes:\
\>", "Text",
 CellID->1610510011,ExpressionUUID->"44807b7f-366d-41a7-6cb0-73394318138d"],

Cell[BoxData[
 RowBox[{"stab3", " ", "=", " ", 
  RowBox[{"cluster3", "[", 
   RowBox[{"Method", " ", "->", " ", "\"\<Stabilizer\>\""}], "]"}]}]], "Input",\

 CellLabel->"In[128]:= ",
 CellID->1363210520,ExpressionUUID->"56b5d630-2397-dc8b-7e4a-c87a5623a6d1"],

Cell[TextData[{
 "A ",
 Cell[BoxData["PauliStabilizer"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "066e8396-42fa-b64f-2e15-1ad0768c1c95"],
 " returns, the state held as the three cluster generators that fix it. Now \
expand that tableau back into an exact state, that is, solve ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["i", "TI"]], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}], "=", 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fee4e15-659c-ade9-3596-605f0c2ef733"],
 " for the unique joint ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f99faa1-7599-adaa-15a6-f30b7c2df7f0"],
 " eigenstate of the three generators:"
}], "Text",
 CellID->751311520,ExpressionUUID->"6c80f068-193e-1d5a-14bf-ea3298cb67a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", "stab3", "]"}], " ", "//", " ", 
  "TraditionalForm"}]], "Input",
 CellLabel->"In[129]:= ",
 CellID->1811324800,ExpressionUUID->"77601adb-bf25-4789-1d1f-93853ad02dd3"],

Cell[TextData[{
 "The ket returns as ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", 
    SqrtBox["8"]], 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["x", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"-", "1"}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      RowBox[{
       SubscriptBox[
        StyleBox["x", "TI"], "1"], 
       SubscriptBox[
        StyleBox["x", "TI"], "2"], "+", 
       SubscriptBox[
        StyleBox["x", "TI"], "2"], 
       SubscriptBox[
        StyleBox["x", "TI"], "3"]}]], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "1"], 
         SubscriptBox[
          StyleBox["x", "TI"], "2"], 
         SubscriptBox[
          StyleBox["x", "TI"], "3"]}]},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48b830c7-d270-6a57-7847-a9a0e70538bd"],
 ": a uniform superposition over all eight bitstrings whose sign is fixed by \
the two cluster bonds, negative exactly on ",
 Cell[BoxData["011"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62f1d7f5-6807-0c72-128e-cebf09b25758"],
 " and ",
 Cell[BoxData["110"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e2af966-75ba-f15e-4629-f1407c4cc3a4"],
 ", the tableau expanded into exact amplitudes. The agreement with the \
default engine is not approximate; check it with ",
 Cell[BoxData["SameQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fcb302b-9e92-9019-25c8-aa751b24e363"],
 ", the language's structural identity:"
}], "Text",
 CellID->1255352889,ExpressionUUID->"361ba0ac-b25b-03c3-5e38-3909c7ee5129"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumState", "[", "stab3", "]"}], "[", "\"\<StateVector\>\"", 
   "]"}], " ", "===", " ", 
  RowBox[{
   RowBox[{"cluster3", "[", "]"}], "[", "\"\<StateVector\>\"", 
   "]"}]}]], "Input",
 CellLabel->"In[130]:= ",
 CellID->1056550259,ExpressionUUID->"36c5768f-9366-0c29-5efb-6fe926135773"],

Cell[TextData[{
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43fcd6d4-594a-1482-7183-cf9e58ff7ee8"],
 ": the two engines produced the same exact expression, global phase included."
}], "Text",
 CellID->1554899303,ExpressionUUID->"4719bc21-ede2-73f0-6d26-358a8b9741da"],

Cell["\<\
The conversion also runs back to circuits: the tableau synthesizes a Clifford \
circuit that prepares it.\
\>", "Text",
 CellID->1285549060,ExpressionUUID->"71a147e0-ad25-39c0-275f-5ecdc4d18b2a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"stab3", "[", "\"\<Circuit\>\"", "]"}], "[", "\"\<Diagram\>\"", 
  "]"}]], "Input",
 CellLabel->"In[131]:= ",
 CellID->1616846310,ExpressionUUID->"0d94734f-f5fd-5b1e-3bac-6b2883882664"],

Cell[TextData[{
 "A five-gate Clifford circuit returns, interleaved Hadamards and \
controlled-NOTs, and applying it to ",
 Cell[BoxData[
  TemplateBox[{"000"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a66d044-93ea-cfa5-7a1d-ca2e259c958f"],
 " reproduces the state vector exactly (verified). Circuit to tableau, \
tableau to state, tableau back to circuit: three representations of one \
object, each available where it is cheapest, with symbols, structure, or \
scale deciding which engine runs."
}], "Text",
 CellID->1706199142,ExpressionUUID->"08e3a6ae-198b-2f89-3890-3f08983e75d3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The code layer: a logical error rate in closed form", "Subsection",
 CellID->848974671,ExpressionUUID->"07ff9e3d-196e-b566-2d84-106798181c4c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Get", 
  "[", "\"\</Users/mohammadb/Documents/GitHub/QuantumFramework/\
OngoingProjects/QEC/QECCore/QECCore.wl\>\"", "]"}]], "Input",
 CellChangeTimes->{{4.000943596250736*^9, 4.00094359625076*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"cd4184da-beee-4902-8bb0-1252ef3c9c43"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "Null", ",", "Null", ",", "Null", ",", "Null", ",", "Null", ",", "Null", ",",
    "Null", ",", "Null", ",", "Null", ",", "Null", ",", "Null", ",", "Null", ",",
    "Null", ",", "Null", ",", "Null", ",", "Null", ",", "Null", ",", "Null", ",",
    "Null", ",", "Null", ",", "Null", ",", "Null", ",", "Null", ",", "Null", ",",
    "Null"}], "}"}]], "Output",
 CellChangeTimes->{4.0009435999086637`*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"b19c87f4-96ba-4e1e-8539-ed974b5ca056"]
}, Open  ]],

Cell[TextData[{
 "The engine stores a ",
 StyleBox["state", "TI"],
 " as its stabilizer group. A quantum error-correcting code is the companion \
object: a ",
 StyleBox["subspace", "TI"],
 " fixed by a group of commuting Pauli checks. ",
 Cell[BoxData["QECCode"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08a91809-3406-7705-3856-9253bdb35a6f"],
 " holds that subspace as a check matrix and derives everything else from it. \
Build the five-qubit code, the smallest code that corrects an arbitrary \
single-qubit error:"
}], "Text",
 CellID->1656178105,ExpressionUUID->"47ee4125-d524-d464-6d96-588edcd6bf4e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"code", " ", "=", " ", 
  RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}]}]], "Input",
 CellLabel->"In[7]:=",
 CellID->2128368636,ExpressionUUID->"1a0bea5a-c3ff-c671-4a08-0c07f58bad5b"],

Cell[BoxData[
 TagBox[
  TemplateBox[{
    RowBox[{
      StyleBox[
       TagBox["QECCode", "SummaryHead"], "NonInterpretableSummary"], 
      StyleBox["[", "NonInterpretableSummary"], 
      DynamicModuleBox[{
       Typeset`open$$ = False, Typeset`embedState$$ = "Ready"}, 
       TemplateBox[{
         PaneSelectorBox[{False -> GridBox[{{
               PaneBox[
                ButtonBox[
                 DynamicBox[
                  FEPrivate`FrontEndResource[
                  "FEBitmaps", "SummaryBoxOpener"]], 
                 ButtonFunction :> (Typeset`open$$ = True), Appearance -> 
                 None, BaseStyle -> {}, Evaluator -> Automatic, Method -> 
                 "Preemptive"], Alignment -> {Center, Center}, ImageSize -> 
                Dynamic[{
                  Automatic, 
                   3.5 (CurrentValue["FontCapHeight"]/AbsoluteCurrentValue[
                    Magnification])}]], 
               GraphicsBox[{
                 RasterBox[CompressedData["
1:eJxTTMoPSmVmYGBgAWIuIAaxIeCDPTptDAaHofwH9mfPgMATDHX0Uk8qjcv8
webOoe4vWpsz6i/8NADntOrm
                  "], {{0, 0}, {10, 4}}, {0, 1}], {{Antialiasing -> False, 
