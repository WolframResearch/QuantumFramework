Cell[TextData[{
 "Four bars summing to one, one tetrahedron outcome suppressed and another \
enhanced: the SIC measurement of qubit ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1287d3f9-6500-de4e-42bc-caa30cbaa494"],
 ". Here qubit ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],
 " is entangled with qubit ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087f5f2f-6486-1b59-3805-56890d3369a3"],
 ", so its reduced state is mixed, its Bloch vector lies inside the ball \
(length less than ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],
 "), and the four probabilities are correspondingly drawn in from the \
pure-state extremes toward the uniform value ",
 Cell[BoxData[
  FractionBox["1", "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],
 ". The same informationally complete measurement reports a mixed, entangled \
qubit as faithfully as a pure one, which is what tomography of a real, noisy \
qubit requires."
}], "Text",
 CellID->1090726268,ExpressionUUID->"13ecd9ee-6506-67bb-4193-d0c80cb34d81"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Continuous-variable quantum optics", "Subsection",
 CellID->2124519200,ExpressionUUID->"6724c974-bdf1-27a5-0edb-e13e3b858d8f"],

Cell[TextData[{
 "Bosonic Fock space, not qubits. The state of an ideal laser mode is the \
coherent state ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Alpha]", "TI"]},
    "Ket"], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SuperscriptBox[GridBox[{
         {
          StyleBox["\[Alpha]", "TI"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "/", "2"}]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["n", "TI"], "=", "0"}], "\[Infinity]",
      LimitsPositioning->False], 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["n", "TI"]], 
       SqrtBox[
        RowBox[{
         StyleBox["n", "TI"], "!"}]]], 
      TemplateBox[{
        StyleBox["n", "TI"]},
       "Ket"]}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b52875c-0948-9ae8-5961-1f06a8e2e832"],
 ", defined as the eigenstate of the photon annihilation operator, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], 
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53412643-5a68-df00-017e-b82d5f02a26a"],
 ", with a complex eigenvalue ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "696f5b1d-d56b-3a26-1f15-5346dc1f890c"],
 " because ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0eb02373-2484-618c-364f-bb3d4d3133d6"],
 " is not Hermitian. QF builds these objects directly in a truncated Fock \
space (sixteen levels by default). Check the eigenvalue equation with ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640353f1-ff8e-e9b3-0c31-4abafa38bb99"],
 " fully symbolic. Build the annihilation operator:"
}], "Text",
 CellID->617350884,ExpressionUUID->"37161f66-4600-a3a8-5d2d-974073baf1f2"],

