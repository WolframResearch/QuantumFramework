Cell[TextData[{
 "Then check the coherent-state identity it implies, with ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64802aa2-b136-451c-0cbf-c30fc0c32c66"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"],
 ", and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "233ecb8e-17f3-8d32-52c5-e2e8a187d418"],
 " all symbols:"
}], "Text",
 CellID->15883883,ExpressionUUID->"7dd949a9-d8cf-50b3-2be7-60f2d97a2299"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"uosc", " ", "@", " ", 
   RowBox[{"CoherentState", "[", "]"}]}], " ", "==", " ", 
  RowBox[{
   RowBox[{"E", "^", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "\[Omega]", " ", 
      RowBox[{"t", "/", "2"}]}], ")"}]}], " ", 
   RowBox[{
    RowBox[{"CoherentState", "[", "]"}], "[", 
    RowBox[{"\[FormalAlpha]", " ", 
     RowBox[{"E", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "\[Omega]", " ", "t"}], ")"}]}]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[63]:=",
 CellID->308842859,ExpressionUUID->"4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{4.00094269960585*^9},
 CellLabel->"Out[63]=",ExpressionUUID->"52137c66-d29a-4f31-996b-f9297c3d94bb"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "598f41e5-f1df-a461-0fb5-58ce806b0f4b"],
 ", with ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e0f0df5-2071-c96f-4634-a4bf51059bb5"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f6e12d5-e3b9-0bb9-2515-8b9e964c5983"],
 ", and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41ecc127-3c02-05fa-7793-d881b5b76fc0"],
 " all symbols: one evolution determines the dynamics of every coherent state \
at every frequency, an exact statement about the family rather than a \
simulation of one member. (QF's state ",
 Cell[BoxData["=="], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1190ff72-a9fe-60f8-47af-f73fcf8b32c2"],
 " compares up to global phase, so this fixes the label ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[Rule]", 
   StyleBox["\[Alpha]", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Omega]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19c80315-d7de-7125-4ff7-9b5ee26b400f"],
 "; the vacuum phase ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Omega]", "TI"], 
    StyleBox["t", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fdf78a7-59a9-97d9-15e5-7101585dfd23"],
 " is exact but lies in the global phase that ",
 Cell[BoxData["=="], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a87483f-bfa4-2eb6-2abd-62793a51749c"],
 " ignores, and appears only in an amplitude-level comparison.)"
}], "Text",
 CellID->1108042358,ExpressionUUID->"09b26917-59e6-8729-3f41-81515f90ea73"],

Cell[TextData[{
 "What distinguishes this most-classical light from other states is photon \
statistics. The second-order coherence at zero delay, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "2", 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     RowBox[{
      SuperscriptBox[
       StyleBox["a", "TI"], "\[Dagger]"], 
      SuperscriptBox[
       StyleBox["a", "TI"], "\[Dagger]"], 
      StyleBox["a", "TI"], "\[ThinSpace]", 
      StyleBox["a", "TI"]}], "\[VeryThinSpace]", 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    SuperscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      RowBox[{
       SuperscriptBox[
        StyleBox["a", "TI"], "\[Dagger]"], 
       StyleBox["a", "TI"]}], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], "2"]], "=", 
   FractionBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["n", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["n", "TI"], "-", "1"}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    SuperscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      StyleBox["n", "TI"], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], "2"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "521ad179-838d-ce9b-0239-c923363994e1"],
 ", is the normalized probability of detecting two photons at once; it \
classifies light by photon statistics: antibunched (",
 Cell[BoxData[
  RowBox[{"<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "136d7364-bcfb-8461-4113-6b4e348fef4b"],
 ", nonclassical), coherent (",
 Cell[BoxData[
  RowBox[{"=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b78534b-7a52-d624-5918-4b157fe4bd0e"],
 "), and bunched thermal (",
 Cell[BoxData[
  RowBox[{">", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30c454b2-bdb8-e427-60fc-4dfc3432cf0d"],
 ")."
}], "Text",
 CellID->1009200201,ExpressionUUID->"6879dfe8-0276-0c7b-1806-d6b2b7035741"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g2s", " ", "=", " ", 
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<Fock\>\"", " ", "->", " ", 
     RowBox[{"G2Coherence", "[", 
      RowBox[{"FockState", "[", "1", "]"}], "]"}]}], ",", " ", 
    RowBox[{"\"\<Coherent\>\"", " ", "->", " ", 
     RowBox[{"G2Coherence", "[", 
      RowBox[{
       RowBox[{"CoherentState", "[", "20", "]"}], "[", "1.5", "]"}], "]"}]}], 
    ",", "\n", "  ", 
    RowBox[{"\"\<Thermal\>\"", " ", "->", " ", 
     RowBox[{"G2Coherence", "[", 
      RowBox[{"ThermalState", "[", 
       RowBox[{"1.0", ",", " ", "20"}], "]"}], "]"}]}]}], "|>"}]}]], "Input",
 CellLabel->"In[64]:=",
 CellID->752465254,ExpressionUUID->"7cc522fa-6a93-e579-24fa-bba40f27cc43"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Fock\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"Coherent\"\>", "\[Rule]", "0.9999999999683007`"}], ",", 
   RowBox[{"\<\"Thermal\"\>", "\[Rule]", "1.999675737326063`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.000942700119524*^9},
 CellLabel->"Out[64]=",ExpressionUUID->"566dfb46-2743-4a50-bae5-bbc5a96e82ff"]
}, Open  ]],

Cell["\<\
Each class takes the value the formula predicts: zero for the single photon, \
one for the laser, two for thermal light. The three values chart directly:\
\>", "Text",
 CellID->891183881,ExpressionUUID->"5b82e386-6ff5-c0ee-09b1-fae009819234"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BarChart", "[", 
  RowBox[{"g2s", ",", " ", 
   RowBox[{"ChartLabels", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Fock |1\[RightAngleBracket]\>\"", ",", 
      " ", "\"\<Coherent\>\"", ",", " ", "\"\<Thermal\>\""}], "}"}]}], ",", 
   "\n", "  ", 
   RowBox[{
   "PlotLabel", " ", "->", " ", "\"\<Second-order coherence g2(0)\>\""}], ",",
    " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
