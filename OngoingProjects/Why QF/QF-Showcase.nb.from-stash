Cell[TextData[{
 "The peak iteration count from the exact rotation angle, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   StyleBox["round",
    FontSlant->"Plain"], "\[NegativeThinSpace]", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   FractionBox["\[Pi]", 
    RowBox[{"4", 
     StyleBox["\[Theta]", "TI"]}]], "-", 
   FractionBox["1", "2"], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02bfa0ec-e0fe-2fa7-3244-39c9908b758d"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", 
   StyleBox["arcsin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", 
   SqrtBox[
    RowBox[{"1", "/", 
     StyleBox["N", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cc1833e-1ead-5711-24fe-1b789b583a7b"],
 " (which is ",
 Cell[BoxData["12"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cb4236e-91b2-9328-644b-bb482044fe72"],
 " here, where the coarser ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftFloor]",
    SpanMaxSize->1], 
   RowBox[{
    FractionBox["\[Pi]", "4"], 
    SqrtBox[
     StyleBox["N", "TI"]]}], 
   StyleBox["\[RightFloor]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "631da35c-735e-7e3b-1122-3b0606eb4501"],
 " agrees):"
}], "Text",
 CellID->1615544595,ExpressionUUID->"44b7daea-ed84-b50e-6c4c-d3b784361c54"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kopt", " ", "=", " ", 
   RowBox[{"Round", "[", 
    RowBox[{
     RowBox[{"Pi", "/", 
      RowBox[{"(", 
       RowBox[{"4", " ", 
        RowBox[{"ArcSin", "[", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "/", 
           RowBox[{"2", "^", "n"}]}], "]"}], "]"}]}], ")"}]}], " ", "-", " ", 
     
     RowBox[{"1", "/", "2"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[117]:=",
 CellID->1805673747,ExpressionUUID->"39f2334d-24de-3dcb-6f81-ab174d688711"],

Cell[TextData[{
 "The full search: a Hadamard layer, then ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ec600b7-0050-8550-46fd-99f1b1eaefba"],
 " stacked iterations:"
}], "Text",
 CellID->1547520620,ExpressionUUID->"33bfe66e-cd59-d601-6144-f84be4edbd6b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"grover", " ", "=", " ", 
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"\"\<H\>\"", " ", "->", " ", 
       RowBox[{"Range", "[", "n", "]"}]}], "]"}], ",", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"step", ",", " ", "kopt"}], "]"}]}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[118]:=",
 CellID->858350929,ExpressionUUID->"6a3ee8c1-8740-e1ad-1bc5-01ab32fab3f7"],

