Cell[TextData[{
 "The MaxCut cost Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["C", "TI"]], "=", 
   UnderscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}],
    LimitsPositioning->False], 
   FractionBox[
    RowBox[{"1", "-", 
     SubscriptBox[
      StyleBox["Z", "TI"], 
      StyleBox["i", "TI"]], 
     SubscriptBox[
      StyleBox["Z", "TI"], 
      StyleBox["j", "TI"]]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],
 " is assembled straight from the edge list, one ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["i", "TI"]], 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b853673-18d0-d9fa-19ba-a83d996aabc0"],
 " term per edge, and carries a label that will name its block in the diagram \
below:"
}], "Text",
 CellID->1907680634,ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"hcost", " ", "=", " ", 
  RowBox[{"QuantumOperator", "[", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"id", " ", "=", " ", 
         RowBox[{
          RowBox[{"QuantumOperator", "[", 
           RowBox[{"StringJoin", "[", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"\"\<I\>\"", ",", " ", "n"}], "]"}], "]"}], "]"}], "/", 
          "2"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"id", " ", "-", " ", 
           RowBox[{"QuantumOperator", "[", 
            RowBox[{
             RowBox[{"\"\<ZZ\>\"", "/", "2"}], ",", " ", "#"}], "]"}]}], " ", 
          "&"}], ")"}], " ", "/@", " ", 
        RowBox[{"(", 
         RowBox[{"List", " ", "@@@", " ", 
          RowBox[{"EdgeList", "[", "graph", "]"}]}], ")"}]}]}], "]"}], "]"}], 
    ",", " ", 
    RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<Hamiltonian\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[27]:=",
 CellID->483148123,ExpressionUUID->"574a2197-51ef-7938-7d49-b8d1679a4802"],

