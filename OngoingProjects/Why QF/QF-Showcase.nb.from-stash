Cell["No qubit index was written by hand.", "Text",
 CellID->512383039,ExpressionUUID->"6af863a9-1098-c609-1a98-7af3a112ad53"],

Cell[TextData[{
 "The cost landscape is the expectation ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Bra"], 
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["C", "TI"]], 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "055bc2ad-6b92-a3be-3378-dbf70e24f184"],
 ", and here QF uses a feature worth stating explicitly: a ",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0fb60e-2211-365f-5934-286857a59ca5"],
 " can hold states as elements. Composing the prep circuit (the ket), the \
operator ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["H", "TI"], 
   StyleBox["C", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "201a2509-bdd9-2fa1-5039-bd53346c758b"],
 ", and the prep circuit's ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Dagger\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 " (the bra) builds ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Bra"], 
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["C", "TI"]], 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f932952-49a5-d34f-05a0-c11c6851a195"],
 " as a single object:"
}], "Text",
 CellID->273308241,ExpressionUUID->"160f17c4-d31a-fe19-3e34-8ea1e6acc563"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"meanvalue", " ", "=", " ", 
  RowBox[{"(", 
   RowBox[{"oneLayer", " ", "/*", " ", "hcost", " ", "/*", " ", 
    RowBox[{"oneLayer", "[", "\"\<Dagger\>\"", "]"}]}], ")"}]}]], "Input",
