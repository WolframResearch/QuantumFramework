Cell[TextData[{
 "The surface is the entire variational problem: smooth, with period ",
 Cell[BoxData["\[Pi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3279c00f-c9e2-8758-6206-da68ef94eda2"],
 " in ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50b12ff8-e606-85f7-004e-c6a593b0efdd"],
 " but ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640f47a5-4648-c62d-0c35-5e0f73e2ad77"],
 " in ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63a48922-0fac-666c-115b-208caa594cb6"],
 " (the cost angle enters through ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "387a9e0d-0234-0e73-6819-1057b7c15559"],
 ", not only ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f64ca0d-9927-5f44-651b-ec5718d225ae"],
 ", so ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "399d1ff3-4632-be92-6fa2-96bd73c404f8"],
 " needs a full ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1170384d-2f38-2c50-470f-b2174acd76ba"],
 " to repeat), and flat at the value ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ce33075-6d34-44a7-1490-aa3f04c12e8d"],
 " along the line ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],
 ", where the cost layer is inactive and the equal superposition cuts ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6334ac9c-43f1-85c0-12cb-45c67585ef2a"],
 " of the ",
 Cell[BoxData["6"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74397683-04f4-1d4d-1dc7-6fedac816797"],
 " edges on average. What an experiment estimates point by point, with shot \
noise on every sample, is here a single exact surface, and its peaks are not \
read from a grid but certified algebraically. Take the maximum exactly:"
}], "Text",
 CellID->11631581,ExpressionUUID->"735e49d5-32a1-4a48-2166-609f47541892"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Maximize", "[", 
  RowBox[{"landscape", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", "\[Gamma]"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[36]:=",
 CellID->1933762060,ExpressionUUID->"335d55a2-cf9b-493d-6163-4c0fea2e1807"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"3", " ", 
     RowBox[{"(", 
      RowBox[{"7", "-", 
       TemplateBox[<|"icon" -> "Root", "small" -> InterpretationBox[
           StyleBox[
            TemplateBox[{"\"-2.86\"", 
              DynamicBox[
               FEPrivate`FrontEndResource[
               "FEExpressions", "NumericalApproximationElider"]]}, 
             "RowDefault"], ShowStringCharacters -> 
            False], -2.86004293133733966669751680456101894379`15.\
954589770191003, Editable -> False], "approx" -> -2.8600429313373397`, 
         "interp" -> InterpretationBox["", 
           Root[-697 - 142 # + 47 #^2 + 4 #^3& , 2, 0]], "head" -> "Root", 
         "big" -> RowBox[{
            RowBox[{
              RowBox[{"-", "697"}], "-", 
              RowBox[{"142", " ", "#1"}], "+", 
              RowBox[{"47", " ", 
                SuperscriptBox["#1", "2"]}], "+", 
              RowBox[{"4", " ", 
                SuperscriptBox["#1", "3"]}]}], "&"}], "degree" -> "3", 
         "shortDegree" -> "3", "number" -> 2|>,
        "NumericalApproximationInterp"]}], ")"}]}], "8"], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]", "\[Rule]", 
      RowBox[{
       RowBox[{"-", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"18", " ", "\[Pi]"}], "-", 
         RowBox[{"ArcTan", "[", 
          TemplateBox[<|"icon" -> "Root", "small" -> InterpretationBox[
              StyleBox[
               TemplateBox[{"\"-3.45\"", 
                 DynamicBox[
                  FEPrivate`FrontEndResource[
                  "FEExpressions", "NumericalApproximationElider"]]}, 
                "RowDefault"], ShowStringCharacters -> 
               False], \
-3.44571169318643644174926521372981369495`15.954589770191003, Editable -> 
              False], "approx" -> -3.4457116931864364`, "interp" -> 
            InterpretationBox["", 
              Root[
              1 - 6 #^2 - 97 #^4 + 332 #^6 - 97 #^8 - 6 #^10 + #^12& , 1, 0]],
             "head" -> "Root", "big" -> RowBox[{
               RowBox[{"1", "-", 
                 RowBox[{"6", " ", 
                   SuperscriptBox["#1", "2"]}], "-", 
                 RowBox[{"97", " ", 
                   SuperscriptBox["#1", "4"]}], "+", 
                 RowBox[{"332", " ", 
                   SuperscriptBox["#1", "6"]}], "-", 
                 RowBox[{"97", " ", 
                   SuperscriptBox["#1", "8"]}], "-", 
                 RowBox[{"6", " ", 
                   SuperscriptBox["#1", "10"]}], "+", 
                 SuperscriptBox["#1", "12"]}], "&"}], "degree" -> "12", 
            "shortDegree" -> "12", "number" -> 1|>,
           "NumericalApproximationInterp"], "]"}]}], ")"}]}]}], ",", 
     RowBox[{"\[Gamma]", "\[Rule]", 
      RowBox[{
       RowBox[{"-", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"5", " ", "\[Pi]"}], "-", 
         RowBox[{"ArcTan", "[", 
          TemplateBox[<|"icon" -> "Root", "small" -> InterpretationBox[
              StyleBox[
               TemplateBox[{"\"-3.99\"", 
                 DynamicBox[
                  FEPrivate`FrontEndResource[
                  "FEExpressions", "NumericalApproximationElider"]]}, 
                "RowDefault"], ShowStringCharacters -> 
               False], \
-3.98675788166373967769118280557449907064`15.954589770191003, Editable -> 
              False], "approx" -> -3.9867578816637397`, "interp" -> 
            InterpretationBox["", 
              Root[
              1 - 18 #^2 - #^4 + 548 #^6 - #^8 - 18 #^10 + #^12& , 1, 0]], 
            "head" -> "Root", "big" -> RowBox[{
               RowBox[{"1", "-", 
                 RowBox[{"18", " ", 
                   SuperscriptBox["#1", "2"]}], "-", 
                 SuperscriptBox["#1", "4"], "+", 
                 RowBox[{"548", " ", 
                   SuperscriptBox["#1", "6"]}], "-", 
                 SuperscriptBox["#1", "8"], "-", 
                 RowBox[{"18", " ", 
                   SuperscriptBox["#1", "10"]}], "+", 
                 SuperscriptBox["#1", "12"]}], "&"}], "degree" -> "12", 
            "shortDegree" -> "12", "number" -> 1|>,
           "NumericalApproximationInterp"], "]"}]}], ")"}]}]}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{4.0009426926559153`*^9},
 CellLabel->"Out[36]=",ExpressionUUID->"8b0d0ac6-f2e7-4292-b947-036061fad52f"]
}, Open  ]],

Cell[TextData[{
 "The maximum returns as a closed-form algebraic number, a root of a cubic \
equal to ",
 Cell[BoxData[
  SubscriptBox[
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["C", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], 
   StyleBox["max",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bfbbd45-edb8-1b0b-6998-352e844d6651"],
 ", with the optimal angles likewise exact ",
 Cell[BoxData["Root"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "045023ab-c37d-b770-2c6f-baf4f6091a5a"],
 " expressions. A single QAOA layer does not reach the true cut of ",
 Cell[BoxData["4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73e8aeff-5b91-f8f4-2197-47b95e25cade"],
 ", and the exact landscape certifies that ceiling as a cubic root rather \
than an estimate. Falling short is the generic behavior of one layer; a case \
where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33e490f1-5bc8-e939-619b-09bb5e62b803"],
 " happens to saturate the cut is exceptional, and reaching ",
 Cell[BoxData["4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "794a4309-908b-2549-2f4a-5b53213f8f93"],
 " requires deeper QAOA with more layers. The point stands: the variational \
optimum is an exact symbolic quantity, a root of a cubic with closed-form \
angles, not a number sampled near the answer."
}], "Text",
 CellID->1055776787,ExpressionUUID->"167ebcf0-2b32-2a61-3e05-35ba4ec7794b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A full many-body computation in closed form", "Subsection",
 CellID->1859711813,ExpressionUUID->"15eb24b6-b946-3a65-43e8-bdf038f0894f"],

Cell[TextData[{
 "The same construction extends to a genuine many-body computation. Build the \
2-qubit Heisenberg Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   StyleBox["J", "TI"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["X", "TI"], 
    StyleBox["X", "TI"], "+", 
    StyleBox["Y", "TI"], 
    StyleBox["Y", "TI"], "+", 
    StyleBox["Z", "TI"], 
    StyleBox["Z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27d2a24c-1e84-19ee-4de1-44169b316b34"],
 " symbolically (Hamiltonian simulation, a central application of a quantum \
computer):"
}], "Text",
 CellID->1348896709,ExpressionUUID->"285985c7-a1c8-13eb-5866-1ca0d07d6131"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"hheis", " ", "=", " ", 
  RowBox[{"J", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", "\"\<XX\>\"", "]"}], " ", "+", " ", 
     RowBox[{"QuantumOperator", "[", "\"\<YY\>\"", "]"}], " ", "+", " ", 
     RowBox[{"QuantumOperator", "[", "\"\<ZZ\>\"", "]"}]}], 
    ")"}]}]}]], "Input",
 CellLabel->"In[37]:=",
 CellID->1427211115,ExpressionUUID->"57868ed1-450c-c474-7dbd-279b6cbeaf5e"],

