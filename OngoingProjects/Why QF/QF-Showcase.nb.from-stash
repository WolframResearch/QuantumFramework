Cell[TextData[{
 "The purity is ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583a98af-415b-100e-09d9-110970ee6354"],
 ", as it must be for any pure state."
}], "Text",
 CellID->793802945,ExpressionUUID->"07beae85-a317-6bf9-2d45-47eed6a239c3"],

Cell[TextData[{
 "Send it through amplitude damping, the decay channel ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "\[Function]", 
   SubscriptBox[
    StyleBox["K", "TI"], "0"], 
   StyleBox["\[Rho]", "TI"], 
   SubsuperscriptBox[
    StyleBox["K", "TI"], "0", "\[Dagger]"], "+", 
   SubscriptBox[
    StyleBox["K", "TI"], "1"], 
   StyleBox["\[Rho]", "TI"], 
   SubsuperscriptBox[
    StyleBox["K", "TI"], "1", "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["K", "TI"], "1"], "=", 
   RowBox[{
    SqrtBox[
     StyleBox["\[Gamma]", "TI"]], 
    TemplateBox[{"0"},
     "Ket"], 
    TemplateBox[{"1"},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60049622-f570-0e0e-103b-0f8ffc055554"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["K", "TI"], "0"], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{"0"},
      "Ket"], 
     TemplateBox[{"0"},
      "Bra"]}], "+", 
    RowBox[{
     SqrtBox[
      RowBox[{"1", "-", 
       StyleBox["\[Gamma]", "TI"]}]], 
     TemplateBox[{"1"},
      "Ket"], 
     TemplateBox[{"1"},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40ea559d-da93-7842-70ea-4cc6df264aa8"],
 ": the excitation is lost with probability ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23ccc6ee-92c0-e596-51f3-dfc8277acffc"],
 ", the model of spontaneous emission. The question: how much purity does \
that cost, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "2"], 
   StyleBox["]",
    SpanMaxSize->1], "-", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    FontSize->1.2 Inherited], 
   SubscriptBox["\[ScriptCapitalE]", 
    StyleBox["\[Gamma]", "TI"]], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], 
   StyleBox["]",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "114d8d02-b276-9c05-4772-256fc700e76f"],
 ", as an exact function of the damping rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dc22b63-32d1-862f-5bf1-c34d4765ed75"],
 " and the state:"
}], "Text",
 CellID->631769182,ExpressionUUID->"36ea7e2c-072a-2221-5eea-7076b2df710b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"psi", "[", "\"\<Purity\>\"", "]"}], " ", "-", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumChannel", "[", 
       RowBox[{"\"\<AmplitudeDamping\>\"", "[", "\[Gamma]", "]"}], "]"}], "[",
       "psi", "]"}], "[", "\"\<Purity\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{"\[Phi]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{"0", " ", "<=", " ", "\[Gamma]", " ", "<=", " ", "1"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[44]:=",
 CellID->1873681340,ExpressionUUID->"5b23761c-2477-64e8-0ad1-68464d024e32"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "2"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "\[Gamma]"}], ")"}], " ", "\[Gamma]", " ", 
  SuperscriptBox[
   RowBox[{"Sin", "[", 
    FractionBox["\[Theta]", "2"], "]"}], "4"]}]], "Output",
 CellChangeTimes->{4.000942694739954*^9},
 CellLabel->"Out[44]=",ExpressionUUID->"2f7e799a-721c-4706-90c9-97153118aa1a"]
}, Open  ]],

Cell[TextData[{
 "The purity loss returns exactly as ",
 Cell[BoxData[
  RowBox[{"2", "\[ThinSpace]", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["\[Gamma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "4"], "\[ThinSpace]", 
   FractionBox[
    StyleBox["\[Theta]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73216bcf-7cf1-61ac-22de-82a9748433f6"],
 ". The pure input has become mixed: irreversible, non-unitary dynamics \
captured directly as a channel object. The loss depends only on ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],
 " and the excited-state weight ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Theta]", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "409bca18-cbd6-e54d-70b8-ec45ee60cf97"],
 ", never on the azimuth ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b62b5f-1d3f-f012-404d-c31994cbc378"],
 ", and it vanishes at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79984792-c453-565a-2fb8-5edfede63ca0"],
 " (no damping), at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d45428e-8fa1-6801-4b7b-5be82a543b6b"],
 " (fully relaxed to the pure ground state), and at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "604bb87d-3174-a116-1048-32274006f07c"],
 " (",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "763191a2-6f8b-197a-1fce-080c0a3e6840"],
 ", which damping leaves untouched)."
}], "Text",
 CellID->1468251080,ExpressionUUID->"635fdfdb-2856-deda-1164-d68549e0a420"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The master equation, solved once for every state and every rate\
\>", "Subsection",
 CellID->1989234463,ExpressionUUID->"0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],

Cell[TextData[{
 "A channel is a single instance of decoherence; the full dynamics is the \
Lindblad master equation, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["H", "TI"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    UnderscriptBox["\[Sum]", 
     StyleBox["i", "TI"],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["i", "TI"]], 
    StyleBox["(",
     FontSize->1.2 Inherited], 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["i", "TI"]], 
    StyleBox["\[Rho]", "TI"], 
    SubsuperscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["i", "TI"], "\[Dagger]"], "-", 
    FractionBox["1", "2"], "{", 
    SubsuperscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["i", "TI"], "\[Dagger]"], 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["i", "TI"]]}], ",", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "}", 
    StyleBox[")",
     FontSize->1.2 Inherited]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8469dd-bfc7-2a7a-04bb-80873a727940"],
 ", and ",
 Cell[BoxData["QuantumEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],
 " solves it symbolically. Given a density matrix whose four entries are \
symbols and rates that remain symbols, a single solution covers every qubit \
experiment at once. Set the physical region: positive rates, a real level \
splitting, and forward time:"
}], "Text",
 CellID->1607696641,ExpressionUUID->"3921e4bb-f5e4-3596-68de-fde483969ffc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Gamma]1", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]\[Phi]", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[CapitalOmega]", " ", "\[Element]", " ", "Reals"}], " ", "&&", 
    " ", 
    RowBox[{"t", " ", ">=", " ", "0"}]}]}], ";"}]], "Input",
 CellLabel->"In[45]:=",
 CellID->1817342824,ExpressionUUID->"13db9173-5387-1c16-41f8-093d6632677c"],

Cell[TextData[{
 "Write the decay operator ",
 Cell[BoxData[
