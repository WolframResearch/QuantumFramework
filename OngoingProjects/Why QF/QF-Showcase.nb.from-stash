Cell[TextData[{
 "The operator is fully symbolic, and its matrix is displayed in the basis \
the algebra carried with it, the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "138e1639-4d05-8b97-41b5-886364b1d9fd"],
 " eigenbasis: the couplings remain symbols, and the coordinates remain \
attached to the object."
}], "Text",
 CellID->1315202099,ExpressionUUID->"156728ce-0023-e03b-431c-c1a8b1d7b301"],

Cell[TextData[{
 "A Hamiltonian is simplest in its energy eigenbasis, and the operator \
provides its own eigenvectors. Build a basis from them and read ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"],
 " there:"
}], "Text",
 CellID->376763343,ExpressionUUID->"26ff5c08-e081-ff27-4e85-56559135c20d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"hzfs", ",", " ", 
      RowBox[{"QuantumBasis", "[", 
       RowBox[{"hzfs", "[", "\"\<Eigenvectors\>\"", "]"}], "]"}]}], "]"}], 
    "[", "\"\<Matrix\>\"", "]"}], " ", "//", " ", "Normal"}], " ", "//", " ", 
  "FullSimplify"}]], "Input",
 CellLabel->"In[80]:=",
 CellID->126027414,ExpressionUUID->"07c988c4-3ef2-8066-2df6-21aeba84d34c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{
      RowBox[{"2", " ", "\[FormalD]"}], "-", "\[FormalE]"}], ",", "0"}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", 
     RowBox[{
      RowBox[{"2", " ", "\[FormalD]"}], "+", "\[FormalE]"}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{4.0009427010878487`*^9},
 CellLabel->"Out[80]=",ExpressionUUID->"cdf38d38-1f6b-4eb5-bf37-be0fc4a53075"]
}, Open  ]],

Cell[TextData[{
 "The matrix returns exactly as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["diag",
      FontSlant->"Plain"], 
     StyleBox["(",
      FontSize->1.2 Inherited], "0"}], ",", " ", 
    RowBox[{
     RowBox[{"2", 
      StyleBox["d", "TI"]}], "-", 
     StyleBox["e", "TI"]}], ",", " ", 
    RowBox[{
     RowBox[{"2", 
      StyleBox["d", "TI"]}], "+", 
     StyleBox["e", "TI"]}]}], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bc0a2f3-6150-447f-79ff-3bbd10e52f45"],
 ": the zero-field-split spectrum in closed form, symbols intact. Building a \
basis from an object's own eigenvectors works in any dimension, and the spin-",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ac66077-3bfa-1f18-2afe-7a31bd8f6262"],
 " operators are provided natively for every ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d863d84-94ab-5643-6bbd-b4ee1d5e3ca9"],
 "."
}], "Text",
 CellID->570920987,ExpressionUUID->"7ab8b877-e011-189c-2a47-323091a46ae6"],

Cell[TextData[{
 "Dimension need not be a power of two either. A particle hopping on an ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35eb0178-2238-e094-63e8-992257b2b2fe"],
 "-site ring lives in an ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da6433d-a7a4-ba24-3b5e-5b66d256090e"],
 "-dimensional Hilbert space, here ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "462f64f6-435d-c7dd-6fd5-7db076e9ad27"],
 ", with the tight-binding Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   RowBox[{"-", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["j", "TI"], "=", "1"}], 
      StyleBox["N", "TI"],
      LimitsPositioning->False], 
     RowBox[{
      StyleBox["(",
       FontSize->1.2 Inherited], 
      RowBox[{
       RowBox[{
        TemplateBox[{
          StyleBox["j", "TI"]},
         "Ket"], 
        TemplateBox[{
          RowBox[{
            StyleBox["j", "TI"], "+", "1"}]},
         "Bra"]}], "+", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            StyleBox["j", "TI"], "+", "1"}]},
         "Ket"], 
        TemplateBox[{
          StyleBox["j", "TI"]},
         "Bra"]}]}], 
      StyleBox[")",
       FontSize->1.2 Inherited]}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b06bf63-5f43-ed7c-793d-374d5af7b446"],
 ", site ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fd1c247-21a4-d962-35ee-e4215056a848"],
 " identified with site ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09347675-9fce-c17b-38cc-683f1a789041"],
 ". Fix the ring size:"
}], "Text",
 CellID->378517449,ExpressionUUID->"2c597ed5-00d9-d535-5467-779fb16dbc1f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"n", " ", "=", " ", "5"}], ";"}]], "Input",
 CellLabel->"In[81]:=",
 CellID->1671903560,ExpressionUUID->"66c4d8d6-27c8-a0db-0efb-d1905262f221"],

Cell[TextData[{
 "Build the hopping matrix, ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d3801b6-8b23-0df3-74c7-98f02ed657d9"],
 " for every pair of neighboring sites:"
}], "Text",
 CellID->1307059254,ExpressionUUID->"09816d05-11e9-fb6e-3fbe-856fa79dc9b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ring", " ", "=", " ", 
   RowBox[{"-", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Boole", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"i", " ", "-", " ", "j"}], ",", " ", "n"}], "]"}], " ", "==",
          " ", "1"}], " ", "||", " ", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"j", " ", "-", " ", "i"}], ",", " ", "n"}], "]"}], " ", "==",
          " ", "1"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "n"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "n"}], "}"}]}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[82]:=",
 CellID->538512558,ExpressionUUID->"35ec423d-cde2-7917-6394-6466eb97487d"],

Cell["Look at it in the site basis:", "Text",
 CellID->824717693,ExpressionUUID->"05e0e9bc-56b1-1bf2-339f-00e6634469d8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ring", " ", "//", " ", "MatrixForm"}]], "Input",
 CellLabel->"In[83]:=",
 CellID->496527141,ExpressionUUID->"46408f14-a324-388b-6e7f-2751d6d68ad1"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", 
      RowBox[{"-", "1"}], "0", "0", 
      RowBox[{"-", "1"}]},
     {
      RowBox[{"-", "1"}], "0", 
      RowBox[{"-", "1"}], "0", "0"},
     {"0", 
      RowBox[{"-", "1"}], "0", 
      RowBox[{"-", "1"}], "0"},
     {"0", "0", 
      RowBox[{"-", "1"}], "0", 
      RowBox[{"-", "1"}]},
     {
      RowBox[{"-", "1"}], "0", "0", 
      RowBox[{"-", "1"}], "0"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{4.000942701108347*^9},
 CellLabel->
  "Out[83]//MatrixForm=",ExpressionUUID->"cd21a6ab-cd09-4f16-805d-\
0d9ca9f3044b"]
}, Open  ]],

Cell[TextData[{
 "The matrix displays as a circulant: ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40213c85-9219-7c2b-71de-b5ef27ac4771"],
 " on the two neighbor diagonals and in the far corners, the bond that closes \
the chain into a ring, and zero everywhere else. In the site basis the \
physics is local hopping; by Bloch's theorem the same operator should be \
diagonal in the momentum (Fourier) basis. Rewrite it there and read the \
diagonal:"
}], "Text",
 CellID->2009363188,ExpressionUUID->"678faed4-2cca-f411-0db4-479e457cdf7b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Normal", " ", "@", " ", 
  RowBox[{"Chop", " ", "@", "\n", "  ", 
   RowBox[{"N", " ", "@", " ", 
    RowBox[{"Diagonal", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", 
       RowBox[{
        RowBox[{"QuantumOperator", "[", "ring", "]"}], ",", " ", 
        RowBox[{"QuantumBasis", "[", 
         RowBox[{"\"\<Fourier\>\"", "[", "n", "]"}], "]"}]}], "]"}], "[", 
      "\n", "     ", "\"\<Matrix\>\"", "]"}], "]"}]}]}]}]], "Input",
 CellLabel->"In[84]:=",
 CellID->55669068,ExpressionUUID->"3b3cac94-919f-f08d-6ac3-45de202bc2d7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "2.`"}], ",", 
   RowBox[{"-", "0.6180339887498948`"}], ",", "1.6180339887498947`", ",", 
   "1.6180339887498947`", ",", 
   RowBox[{"-", "0.6180339887498948`"}]}], "}"}]], "Output",
 CellChangeTimes->{4.0009427011528177`*^9},
 CellLabel->"Out[84]=",ExpressionUUID->"38b8688c-c33e-4b74-aac6-e5915168d35b"]
}, Open  ]],

Cell[TextData[{
 "The diagonal returns exactly the tight-binding dispersion ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["k", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", "2", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", "\[Pi]", 
    StyleBox["k", "TI"], "/", 
    StyleBox["N", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "634a1270-2707-566e-1149-943a52b23cb4"],
 " at the five Bloch momenta, and the off-diagonal terms vanish: a five-level \
system, diagonalized by a named basis the same way a qubit would be."
}], "Text",
 CellID->1753574084,ExpressionUUID->"571f0194-b08e-3ab4-7d24-98d1c138889e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["State estimation: tomography from measured counts", "Subsection",
 CellID->2038359728,ExpressionUUID->"79764466-e076-5945-2f0e-5e4391032baf"],

Cell[TextData[{
 "Tomography is the inverse of measurement: recover an unknown state from the \
statistics of measurements in several bases, and it is part of the same \
object model. The three qubit Pauli bases ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], ",", 
   StyleBox["Y", "TI"], ",", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e8dec7-14b1-519a-7c97-d7a19d4423e0"],
 " are mutually unbiased and together informationally complete: their outcome \
frequencies estimate the three expectations that pin down the density matrix \
through ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   StyleBox["I", "TI"], "+", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["X", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["X", "TI"], "+", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Y", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Y", "TI"], "+", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25f5c72f-3423-741a-538a-de89bdd65f60"],
 ". QF performs the entire procedure. First, pick an unknown state to \
reconstruct:"
}], "Text",
 CellID->1525364821,ExpressionUUID->"6dbbd446-5835-e39a-1b58-ce2059c1b1e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"true", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"N", " ", "@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"Pi", "/", "6"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"Pi", "/", "6"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", 
         RowBox[{"Pi", "/", "4"}]}], "]"}]}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[85]:=",
 CellID->1535108406,ExpressionUUID->"6d34e655-b983-17e8-14cb-f81f38367d32"],

