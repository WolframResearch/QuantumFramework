   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"\"\<JX\>\"", "[", "1", "]"}]}], "]"}]}]], "Input",
