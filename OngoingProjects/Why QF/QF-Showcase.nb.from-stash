Cell[TextData[{
 "Note that QF reads ",
 Cell[BoxData[
  RowBox[{"U", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Pi", "/", "2"}], ",", " ", "0", ",", " ", "Pi"}], ")"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58f4196d-ed82-4662-9977-305deabb7edc"],
 ": the angle is the Wolfram constant ",
 Cell[BoxData["Pi"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9345ccb-b101-4dcd-ad97-22ca84e118f6"],
 ". A spec-strict OpenQASM 3 parser like qiskit knows only the lowercase ",
 Cell[BoxData["pi"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a317be6e-df08-4daf-930a-3b3462f4256f"],
 " and rejects ",
 Cell[BoxData["Pi"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1511fd6b-3040-4c7b-a4d8-479dd8cfbf35"],
 " as an undefined symbol."
}], "Text",ExpressionUUID->"d32414b0-d7fd-4663-8cf3-1322025f2830"],

Cell["\<\
Once imported it is an ordinary QF object, exact end to end because every \
angle stayed a symbol.\
\>", "Text",ExpressionUUID->"ac4b2def-d4f8-4b74-8676-793cb2253800"],

Cell[TextData[{
 "In the CHSH game the players win when their answers satisfy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "\[Wedge]", 
   StyleBox["y", "TI"], "=", 
   StyleBox["a", "TI"], "\[CirclePlus]", 
   StyleBox["b", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cfaa100-8e76-48ec-9f4b-873df4f8704a"],
 ", and no classical strategy wins more than ",
 Cell[BoxData[
  FractionBox["3", "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7c129a5-d4f7-4bbf-b4e3-99b7a2d0689b"],
 " of the time; entanglement beats that bound. Read the circuit's joint \
measurement distribution, label the four outcomes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a08a5dd-1193-48ac-a35b-85c4d549d49f"],
 ", and ask Wolfram Language for the winning probability ",
 Cell[BoxData[
  StyleBox["Pr",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a6991b8-38ba-4e6e-9198-1dbbad4df307"],
 ", in closed form:"
}], "Text",ExpressionUUID->"ad737b3b-801f-4a99-a1c0-250646267d6f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Probability", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"BitAnd", "[", 
      RowBox[{"x", ",", " ", "y"}], "]"}], " ", "==", " ", 
     RowBox[{"BitXor", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}]}], ",", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "x", ",", " ", "y", ",", " ", "b"}], "}"}], " ", 
     "\[Distributed]", " ", 
     RowBox[{
      RowBox[{"chsh", "[", "]"}], "[", "\"\<MultivariateDistribution\>\"", 
      "]"}]}]}], "]"}], " ", "//", " ", "FullSimplify"}]], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"afbfa1ad-9372-4949-8c99-8d4d1bd66d77"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "4"], " ", 
  RowBox[{"(", 
   RowBox[{"2", "+", 
    SqrtBox["2"]}], ")"}]}]], "Output",
 CellChangeTimes->{3.997991256569573*^9, 3.9979918434797907`*^9},
 CellLabel->"Out[24]=",ExpressionUUID->"6be76014-fbc3-4228-bcd0-7597b6427c59"]
}, Open  ]],

Cell[TextData[{
 "Because the angles never left exact arithmetic, the winning probability \
returns as a closed form, ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    RowBox[{"2", "+", 
     SqrtBox["2"]}], "4"], "=", 
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", "/", "8"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7422255-968b-426a-856d-ba18f75c0954"],
 ", exactly the Tsirelson bound, the quantum maximum for CHSH and the \
algebraic number a sampled estimate only converges toward. A circuit authored \
in another tool became an exact probability read off with native WL \
statistics."
}], "Text",ExpressionUUID->"a5478bf6-662d-4d64-b6ab-481e349adeef"]
}, Closed]],

Cell[CellGroupData[{

Cell["A hardware-aware transpilation target", "Subsection",ExpressionUUID->"993c4710-989f-4e75-a881-31e437202d26"],

Cell[TextData[{
 Cell[BoxData["QiskitTarget"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7510f55c-fe57-4c0c-ac6e-f5d640d47167"],
 " carries a device spec (qubit count, native gate set, connectivity), \
validated at construction against qiskit's own ",
 Cell[BoxData["Target"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff054c7d-a326-4a40-afba-5e22ca591af5"],
 " schema through the Python bridge. Build a 5-qubit linear-chain device:"
}], "Text",ExpressionUUID->"0ec93c0a-5fb0-4b77-a70d-45b57fd084a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"target", " ", "=", " ", 
  RowBox[{"QiskitTarget", "[", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<NumQubits\>\"", " ", "->", " ", "5"}], ",", " ", 
     RowBox[{"\"\<BasisGates\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<cx\>\"", ",", " ", "\"\<rz\>\"", ",", " ", "\"\<sx\>\"", ",",
         " ", "\"\<x\>\""}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"\"\<CouplingMap\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}]}], "|>"}], 
   "]"}]}]], "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"88835d5e-3f9e-4dd1-9dde-7e7a4fc6bcb1"],

