Cell[TextData[{
 "Take the all-states-at-once initial density matrix ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070f3e08-556d-9d60-2d34-b0525c19e44a"],
 ", every entry a symbol:"
}], "Text",
 CellID->1899946997,ExpressionUUID->"6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],

Cell[CellGroupData[{

