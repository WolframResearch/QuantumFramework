Cell[TextData[{
 "Subtract ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], 
   TemplateBox[{
     StyleBox["\[Alpha]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd82739-42e3-b7ed-44e7-bf6376971d37"],
 " from ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   TemplateBox[{
     StyleBox["\[Alpha]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0971a20b-7913-467e-3f0e-445578a62d44"],
 " and read the amplitudes (the truncation edge excluded):"
}], "Text",
 CellID->1331866192,ExpressionUUID->"09df342d-d743-5809-3fe4-ae76e2f62b53"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"Most", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"aOp", "[", "alphaKet", "]"}], " ", "-", " ", 
      RowBox[{"\[FormalAlpha]", " ", "alphaKet"}]}], ")"}], 
    "[", "\"\<AmplitudesList\>\"", "]"}], "]"}], "]"}]], "Input",
 CellLabel->"In[61]:=",
 CellID->1391655620,ExpressionUUID->"0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"],

Cell[BoxData[
 RowBox[{"{", 
