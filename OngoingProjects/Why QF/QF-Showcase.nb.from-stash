Cell[TextData[{
 "The diagram is the whole protocol. The two measurements, written as the \
bare qubit lists ",
 Cell[BoxData[
  RowBox[{"{", "1", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "704169dd-a4db-5005-207e-8086cd6e236f"],
 " and ",
 Cell[BoxData[
  RowBox[{"{", "2", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b2d1c14-5aff-cd5f-2ad2-965e5e8b97a5"],
 ", place their outcomes on the record wires described in the introduction, \
numbered ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62ac11c1-6d0b-a8c0-1253-88ab04bffa2a"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e7621e1-2fba-a33a-560d-b8cb4a4c0e00"],
 " below the system wires. The corrections then act from those record wires: ",
 Cell[BoxData[
  RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", " ", "3"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15938457-0322-a4d9-43a0-1e11b6d40e23"],
 " is an ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f1ed2e3-b722-4b37-2525-cbccc2d7161d"],
 " on Bob's qubit controlled by the second record, and ",
 Cell[BoxData[
  RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "3"}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52e63e44-9d5c-26a1-029d-b02e14ee8c8b"],
 " a ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e766a94-5ec6-6187-160d-83de5b7333ed"],
 " controlled by the first, both ordinary controlled gates with a record wire \
in the control position. No classical bit ever leaves the object; the \
classical channel has become two record wires, promoted to a coherent quantum \
resource rather than removed (a record wire is a more expensive resource than \
a classical bit, not a free one)."
}], "Text",
 CellID->1505759259,ExpressionUUID->"2eead67c-41e5-1519-56e9-c82677907c63"],

Cell[TextData[{
 "Teleport a generic Bloch qubit ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Psi]", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["\[Theta]", "TI"], ",", 
      StyleBox["\[Phi]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], 
     FractionBox[
      StyleBox["\[Theta]", "TI"], "2"], 
     TemplateBox[{"0"},
      "Ket"]}], "+", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      StyleBox[
       RowBox[{"i", "\[Phi]"}], "TI"]], 
     StyleBox["sin",
      FontSlant->"Plain"], 
     FractionBox[
      StyleBox["\[Theta]", "TI"], "2"], 
     TemplateBox[{"1"},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23a655ec-dad2-e192-515e-4cc9df64b3f8"],
 ". The protocol succeeds if Bob ends up holding exactly the input, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["Bob",
     FontSlant->"Plain"]], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62ef85cc-c62f-39ac-1294-1ca9f3db8bf6"],
 ", which for a qubit means the two Bloch vectors coincide. First build the \
input state:"
}], "Text",
 CellID->1384053022,ExpressionUUID->"7d6c313b-6800-4a9b-2b13-a96509b518e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"psi", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[94]:=",
 CellID->1395659232,ExpressionUUID->"75dfb56b-bb47-a02b-23e4-2d353ef3f371"],

