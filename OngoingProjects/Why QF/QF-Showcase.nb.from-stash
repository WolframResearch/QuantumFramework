           RowBox[{
            FractionBox[
             RowBox[{"\[ImaginaryI]", " ", 
              SuperscriptBox["\[CapitalDelta]", "2"]}], 
             RowBox[{"4", " ", "v"}]], ",", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], 
              RowBox[{"3", "/", "4"}]], " ", "t", " ", 
             SqrtBox["v"]}]}], "]"}]}], "+", 
         RowBox[{"2", " ", 
          RowBox[{"Gamma", "[", 
           FractionBox[
            RowBox[{"\[ImaginaryI]", " ", 
             SuperscriptBox["\[CapitalDelta]", "2"]}], 
            RowBox[{"4", " ", "v"}]], "]"}], " ", 
          RowBox[{"Gamma", "[", 
           RowBox[{
            FractionBox["1", "2"], "-", 
            FractionBox[
             RowBox[{"\[ImaginaryI]", " ", 
              SuperscriptBox["\[CapitalDelta]", "2"]}], 
             RowBox[{"8", " ", "v"}]]}], "]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], 
              RowBox[{"1", "/", "4"}]], " ", "t", " ", 
             SqrtBox["v"], " ", 
             RowBox[{"ParabolicCylinderD", "[", 
              RowBox[{
               RowBox[{"-", 
                FractionBox[
                 RowBox[{"\[ImaginaryI]", " ", 
                  SuperscriptBox["\[CapitalDelta]", "2"]}], 
                 RowBox[{"4", " ", "v"}]]}], ",", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"-", "1"}], ")"}], 
                 RowBox[{"1", "/", "4"}]], " ", "t", " ", 
                SqrtBox["v"]}]}], "]"}]}], "-", 
            RowBox[{"ParabolicCylinderD", "[", 
             RowBox[{
              RowBox[{"1", "-", 
               FractionBox[
                RowBox[{"\[ImaginaryI]", " ", 
                 SuperscriptBox["\[CapitalDelta]", "2"]}], 
                RowBox[{"4", " ", "v"}]]}], ",", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], 
                RowBox[{"1", "/", "4"}]], " ", "t", " ", 
               SqrtBox["v"]}]}], "]"}]}], ")"}]}]}], ")"}]}]}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{4.000942442558942*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"f49588ea-a870-4530-af93-d95e6c4dc310"]
}, Open  ]],

Cell[TextData[{
 "The matrix is a genuine special-function object. Its first entry alone \
reads ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       StyleBox["v", "TI"], 
       SuperscriptBox[
        StyleBox["t", "TI"], "2"], "/", "4"}]], 
     SubscriptBox["\[ThinSpace]", "1"], 
     SubscriptBox[
      StyleBox["F", "TI"], "1"], "\[NegativeThinSpace]", 
     StyleBox["(",
      FontSize->1.2 Inherited], 
     FractionBox[
      RowBox[{
       StyleBox["i", "TI"], 
       SuperscriptBox["\[CapitalDelta]", "2"]}], 
      RowBox[{"8", 
       StyleBox["v", "TI"]}]]}], ";", " ", 
    FractionBox["1", "2"], ";", " ", 
    RowBox[{
     FractionBox[
      StyleBox["i", "TI"], "2"], "\[ThinSpace]", 
     StyleBox["v", "TI"], 
     SuperscriptBox[
      StyleBox["t", "TI"], "2"]}]}], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b12ee74-9953-131d-1921-003e18e67e67"],
 ", and across the four entries the Kummer function ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["", "1"], 
   SubscriptBox[
    StyleBox["F", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65262d3c-fccc-1dc6-0cdd-c579f579672c"],
 ", fractional-order Hermite functions, and parabolic cylinder functions ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["D", "TI"], 
   StyleBox["\[Nu]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e157ee2-48da-d240-062b-77cc696ca0aa"],
 " appear together, with ",
 Cell[BoxData["\[CapitalGamma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78287f93-0f12-7c52-2828-76ddaaa746b8"],
 "-function coefficients, the single dimensionless ratio ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalDelta]", "2"], "/", 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08285353-0e0e-39f8-3828-4b1dabb88bc2"],
 " setting every index and phase. These are one family in several forms: each \
solves the same Weber equation, shown here as the symbolic solver returned \
it. The matrix is a valid propagator (numerically ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],
 ", it solves the Schrodinger equation, and it is unitary), and at long times \
its asymptotics reduce to the Landau-Zener transition probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "\[Pi]", 
     SuperscriptBox["\[CapitalDelta]", "2"], "/", "2", 
     StyleBox["v", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "187adc3d-3961-76c2-4819-d667b8145c28"],
 ". Symbolic evolution here reaches beyond elementary functions to the \
special-function solution the physics requires."
}], "Text",
 CellID->311511756,ExpressionUUID->"641c78eb-7f03-7846-0c24-71b57ab64aac"],

Cell[TextData[{
 "Having the whole propagator, not just its asymptote, is clearest in a plot. \
First convert the special-function matrix into a numeric parametric operator: \
fix ",
 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],
 " and ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", "=", 
   SqrtBox[
    StyleBox["g", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],
 ", so a single dimensionless parameter ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], "=", 
   SuperscriptBox["\[CapitalDelta]", "2"], "/", 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6121b9de-dddd-aca8-10de-309bd469f6f2"],
 " sets the adiabaticity, and declare ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30209679-023a-ee91-61df-0823b7ccb4fb"],
 " and the time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29bc1606-c22d-409d-5f43-8863f7d812e7"],
 " as parameters:"
}], "Text",
 CellID->1381425643,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"op", " ", "=", " ", 
  RowBox[{"N", "@", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{"lzmat", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"v", " ", "->", " ", "1."}], ",", " ", 
        RowBox[{"\[CapitalDelta]", " ", "->", " ", 
         RowBox[{"Sqrt", "[", "g", "]"}]}]}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"g", ",", " ", "t"}], "}"}]}]}], "]"}]}]}]], "Input",
 CellLabel->"In[19]:=",
 CellID->377280352,ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"],

