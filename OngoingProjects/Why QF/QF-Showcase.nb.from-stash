          FractionBox[
           SubscriptBox[
            StyleBox["\[Gamma]", "TI"], "1"], "2"], "+", "2", 
          SubscriptBox[
           StyleBox["\[Gamma]", "TI"], 
           StyleBox["\[Phi]", "TI"]], "-", 
          StyleBox["i", "TI"], "\[CapitalOmega]"}], ")", 
         StyleBox["t", "TI"]}]]}], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "22"], "\[ThinSpace]", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
         SubscriptBox[
          StyleBox["\[Gamma]", "TI"], "1"], 
         StyleBox["t", "TI"]}]]}]}
    }], ")"}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1372538143,ExpressionUUID->"04469009-6b02-dcc3-2c7d-0a530eb4a629"],

Cell[TextData[{
 "The excited population decays at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],
 ", the lost population moves to the ground state, and the coherence \
precesses at ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5547dfb6-0e84-e145-037c-d6f0ab36b3af"],
 " while decaying at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", "2"], "=", 
   FractionBox[
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "1"], "2"], "+", "2", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12b61bfc-9cd7-eca9-424d-92a61563b6f3"],
 ": every experiment on every qubit, in one matrix. With ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "1"], "=", "1", "/", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "451364b5-819d-fb99-7321-7dff3029c9e3"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "=", "1", "/", 
   SubscriptBox["\[CapitalGamma]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13b49e24-0fb7-4441-414b-178eaa422eab"],
 " read from the exponents, the textbook bound between the two times is a \
theorem about this solution:"
}], "Text",
 CellID->485911656,ExpressionUUID->"445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{"ForAll", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Gamma]1", ",", " ", "\[Gamma]\[Phi]"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"\[Gamma]1", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Gamma]\[Phi]", " ", ">=", " ", "0"}]}], ",", " ", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
        RowBox[{"2", " ", "\[Gamma]\[Phi]"}]}], ")"}]}], " ", "<=", " ", 
     RowBox[{"2", "/", "\[Gamma]1"}]}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[50]:=",
 CellID->181917407,ExpressionUUID->"089aa42d-ce49-3603-38b9-3e76ebfd9d69"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{4.000942695801206*^9},
 CellLabel->"Out[50]=",ExpressionUUID->"908b7f4d-9f98-4abf-a5b0-9cbb1027b482"]
}, Open  ]],

Cell[TextData[{
 "The reduction returns ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48fccab3-b886-a0f7-7883-e3fd3930f2dd"],
 ": ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "\[LessEqual]", "2", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cdaad60-2181-5e26-34f9-454a5034250c"],
 " holds for every admissible rate pair, obtained from the computation rather \
than quoted from a textbook, and reducing the corresponding equality for the \
dephasing rate, ",
 Cell[BoxData[
  RowBox[{"Reduce", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
        RowBox[{"2", " ", "\[Gamma]\[Phi]"}]}], ")"}]}], " ", "==", " ", 
     RowBox[{"2", "/", "\[Gamma]1"}]}], ",", " ", "\[Gamma]\[Phi]"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "542cff75-84e0-b601-7dd3-f73f2c9a1d6b"],
 ", returns ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00dd9d4d-f7ec-565f-30e2-151681993ca5"],
 " (for ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "\[NotEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],
 "): the factor of two is saturated exactly when dephasing vanishes."
}], "Text",
 CellID->1906087345,ExpressionUUID->"3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A generalized measurement: a POVM", "Subsection",
 CellID->354048744,ExpressionUUID->"333832e2-8bec-4128-62c7-abcc2d991072"],

Cell[TextData[{
 "Real detectors are not always projective. A POVM is a set of positive \
effects ",
 Cell[BoxData[
  RowBox[{"{", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["i", "TI"]], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78cf51d6-d7cd-4672-28f5-4893e2782d58"],
 " summing to the identity, ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["i", "TI"]], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],
 ", with outcome probabilities given by the Born rule ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["i", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "710db4a8-d877-0db2-2732-2df5d9025798"],
 "; one is built from a list of effects with ",
 Cell[BoxData[
  RowBox[{"QuantumMeasurementOperator", "[", 
   RowBox[{"{", 
    RowBox[{"E1", ",", " ", "E2", ",", " ", "..."}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e12f72-3ad4-a92f-279e-c73cbf66f875"],
 ". A ",
 StyleBox["symmetric informationally complete", "TI"],
 " POVM is the maximally symmetric case: ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["d", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ea8612-dd18-b4f0-2ee9-185fd4921eda"],
 " rank-one effects ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["i", "TI"]], "=", 
   RowBox[{
    FractionBox["1", 
     StyleBox["d", "TI"]], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["i", "TI"]]},
     "Ket"], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["i", "TI"]]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b02f270-2101-5c3d-3931-f43a50b42707"],
 " with equal pairwise overlaps ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{
         SubscriptBox[
          StyleBox["\[Psi]", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["\[Psi]", "TI"], 
          StyleBox["j", "TI"]]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
   FractionBox["1", 
    RowBox[{
     StyleBox["d", "TI"], "+", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],
 ", four outcomes on a two-level system, pointing along the vertices of a \
tetrahedron in the Bloch ball. Measure a generic Bloch qubit ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Theta]", "TI"], ",", 
    StyleBox["\[Phi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],
 ", applying the Born rule symbolically to all four effects. Build the \
state:"
}], "Text",
 CellID->786710823,ExpressionUUID->"5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"psi", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[51]:=",
 CellID->1859374462,ExpressionUUID->"66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],

