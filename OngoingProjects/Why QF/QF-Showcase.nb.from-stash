Cell["Read its coupling map back:", "Text",ExpressionUUID->"2b1620ae-23ac-4278-a62d-0d051d7f36c6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"target", "[", "\"\<CouplingMap\>\"", "]"}]], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"eba116eb-9484-4d6a-b373-690cd0729754"],

