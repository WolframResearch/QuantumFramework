 ":"
}], "Text",
 CellID->1901179466,ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", "[", "psit", "]"}], " ", "//", " ", 
  "TraditionalForm"}]], "Input",
 CellLabel->"In[39]:=",
 CellID->210724908,ExpressionUUID->"0c02104f-9807-e6c4-3431-8a2919b3cc2e"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   TooltipBox[
    StyleBox[
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", "J", " ", "t"}]], " ", 
       RowBox[{"cos", "(", 
        RowBox[{"2", " ", "J", " ", "t"}], ")"}]}], 
      FormBox[
       InterpretationBox[
        StyleBox[
         TemplateBox[{
           RowBox[{
             FormBox["0", TraditionalForm], "\[InvisibleSpace]", 
             FormBox["1", TraditionalForm]}]},
          "Ket"],
         FontWeight->"Plain"],
        Wolfram`QuantumFramework`QuditName[{0, 1}, "Dual" -> False]],
       TraditionalForm], 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", "J", " ", "t"}]], " ", 
       RowBox[{"sin", "(", 
        RowBox[{"2", " ", "J", " ", "t"}], ")"}]}], 
      FormBox[
       InterpretationBox[
        StyleBox[
         TemplateBox[{
           RowBox[{
             FormBox["1", TraditionalForm], "\[InvisibleSpace]", 
             FormBox["0", TraditionalForm]}]},
          "Ket"],
         FontWeight->"Plain"],
        Wolfram`QuantumFramework`QuditName[{1, 0}, "Dual" -> False]],
       TraditionalForm]}],
     ShowStringCharacters->False],
    TagBox[
     GridBox[{{
        RowBox[{"J", " ", 
          RowBox[{"(", 
            RowBox[{
              TemplateBox[{"\"X\"", 
                RowBox[{"\[CircleTimes]", "2"}]}, "Superscript", SyntaxForm -> 
               SuperscriptBox], "+", 
              TemplateBox[{"\"Y\"", 
                RowBox[{"\[CircleTimes]", "2"}]}, "Superscript", SyntaxForm -> 
               SuperscriptBox], "+", 
              TemplateBox[{"\"Z\"", 
                RowBox[{"\[CircleTimes]", "2"}]}, "Superscript", SyntaxForm -> 
               SuperscriptBox]}], ")"}]}]}, {
        TemplateBox[{"\"QuantumState: \"", 
          RowBox[{
            RowBox[{"{", "}"}], "\[Rule]", 
            RowBox[{"{", 
              RowBox[{"2", ",", "2"}], "}"}]}]}, "RowDefault"]}}, 
      GridBoxAlignment -> {"Columns" -> {{Center}}}, DefaultBaseStyle -> 
      "Column", 
      GridBoxItemSize -> {
       "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"]],
   Wolfram`QuantumFramework`QuantumState[
   SparseArray[
    Automatic, {4}, 0, {
     1, {{0, 2}, {{2}, {3}}}, {
      E^(Complex[0, 1] $CellContext`J $CellContext`t) 
       Cos[2 $CellContext`J $CellContext`t], Complex[0, -1] 
       E^(Complex[0, 1] $CellContext`J $CellContext`t) 
       Sin[2 $CellContext`J $CellContext`t]}}], 
    Wolfram`QuantumFramework`QuantumBasis[<|
     "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
           
           Wolfram`QuantumFramework`QuditName[\[FormalCapitalI], "Dual" -> 
            False], 1} -> 1|>], "Output" -> 
      Wolfram`QuantumFramework`QuditBasis[<|{
           Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 1} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 1} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
      "Picture" -> "Schrodinger", 
      "Label" -> $CellContext`J (Superscript["X", 
          CircleTimes[2]] + Superscript["Y", 
          CircleTimes[2]] + Superscript["Z", 
          CircleTimes[2]]), "ParameterSpec" -> {{$CellContext`t, 0, 1}}|>]]], 
  TraditionalForm]], "Output",
 CellChangeTimes->{4.0009426928587513`*^9},
 CellLabel->
  "Out[39]//TraditionalForm=",ExpressionUUID->"05ad0f5e-0d1f-4bbe-b97e-\
8c06950ee9dc"]
}, Open  ]],

Cell[TextData[{
 "The evolved ket displays in closed form: the excitation oscillates \
coherently between ",
 Cell[BoxData[
  TemplateBox[{"01"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f909018-5ea1-6a32-15af-0a425b543918"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"10"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f4595f3-090a-1216-557a-0cbda8bf617c"],
 " at angular frequency ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06385f5e-e9d4-4e6c-2fd8-571b886114b6"],
 ", within an overall phase ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "J", "t"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],
 ". Now read off the entanglement entropy of one qubit as a function of time, \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    FontSize->1.2 Inherited], 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "1"], 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "1"], 
   StyleBox["]",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9a140e-d97a-4136-69b9-8e6bd80f101c"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "1"], "=", 
   RowBox[{
    SubscriptBox[
     StyleBox["Tr",
      FontSlant->"Plain"], "2"], 
    TemplateBox[{
      RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["t", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Ket"], 
    TemplateBox[{
      RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["t", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f9438da-b80f-a114-75ab-b18439bbf07e"],
 ", the standard measure of how entangled the two spins have become and a \
derived, nonlinear quantity:"
}], "Text",
 CellID->1992790374,ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"s", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumPartialTrace", "[", 
      RowBox[{"psit", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<VonNeumannEntropy\>\"", 
     "]"}], ",", " ", 
    RowBox[{
     RowBox[{"t", " ", "J"}], " ", "\[Element]", " ", "Reals"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[40]:=",
 CellID->292747604,ExpressionUUID->"3c8746fc-db76-c487-64bd-5fb9de00aeed"],

Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      RowBox[{
        RowBox[{"-", "2"}], " ", 
        SuperscriptBox[
         RowBox[{"Cos", "[", 
           RowBox[{"2", " ", "J", " ", "t"}], "]"}], "2"], " ", 
        RowBox[{"Log", "[", 
          SuperscriptBox[
           RowBox[{"Cos", "[", 
             RowBox[{"2", " ", "J", " ", "t"}], "]"}], "2"], "]"}]}], "+", 
      RowBox[{
        RowBox[{"(", 
          RowBox[{
            RowBox[{"-", "1"}], "+", 
            RowBox[{"Cos", "[", 
              RowBox[{"4", " ", "J", " ", "t"}], "]"}]}], ")"}], " ", 
        RowBox[{"Log", "[", 
          SuperscriptBox[
           RowBox[{"Sin", "[", 
             RowBox[{"2", " ", "J", " ", "t"}], "]"}], "2"], "]"}]}]}], 
    RowBox[{"Log", "[", "4", "]"}]], "\"b\"", "bits", "\"Bits\""},
  "Quantity"]], "Output",
 CellChangeTimes->{4.0009426932109756`*^9},
 CellLabel->"Out[40]=",ExpressionUUID->"ad2b00a4-36fd-4ef6-bf0c-8d336fd0e6a8"]
}, Open  ]],

Cell[TextData[{
 "QF returns the entire curve as a formula in ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11f0f87a-e6f0-91cd-478f-f227928ae317"],
 " and ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "473164ce-b547-c1f4-6ecf-7da83cf393de"],
 ": the binary entropy of the two oscillating populations, zero whenever the \
state is a product, a full bit at the Bell points, periodic with the exchange \
oscillation. Because it is a formula, it can be differentiated, expanded, or \
solved in closed form, and the same approach extends to larger symbolic spin \
chains."
}], "Text",
 CellID->1553818268,ExpressionUUID->"12c4fc3b-e00c-2bba-42fb-f66491b97980"],

Cell[TextData[{
 "Plot it (at ",
