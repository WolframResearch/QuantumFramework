Cell[CellGroupData[{

Cell["Claim 1: Symbolic-first, exact algebra by default", "Section",
 CellID->2043779557,ExpressionUUID->"4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],

Cell[TextData[{
 StyleBox["Key feature:",
  FontWeight->"Bold"],
 " symbolic algebra runs through the entire object model, not a single \
function. The basic objects, a state (",
 Cell[BoxData["QuantumState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "741b091d-feb2-1a39-1c38-a146fb476903"],
 "), a Hamiltonian (",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf5a20e-c541-e06e-698a-446becf5b2b4"],
 "), its time evolution (",
 Cell[BoxData["QuantumEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07964fa7-8d1e-ff14-2dae-660124a8c27e"],
 "), and a circuit (",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],
 "), are each fully symbolic and compose into exact closed-form results. They \
are treated here in that order, beginning with the simplest: a state whose \
amplitudes are symbols."
}], "Text",
 CellID->17830494,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell[TextData[{
 StyleBox["Closest competitor.",
  FontWeight->"Bold"],
 " An actively-maintained third-party symbolic-quantum Mathematica package \
matches the symbolic gate algebra, the symbolic Lindblad master equation, and \
the symbolic entropy shown here. What remains distinctive is the closed-form \
time-ordered propagator returned from a Hamiltonian object, expressed through \
parabolic-cylinder and Kummer functions that SymPy and every Julia package \
cannot represent at all."
}], "Text",
 CellID->1589986527,ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell[CellGroupData[{

Cell["A symbolic state", "Subsection",
 CellID->943101875,ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"],

Cell[TextData[{
 "A ",
 Cell[BoxData["QuantumState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbde497-e826-5557-4442-fdd089d33fbd"],
 " can carry free symbols. The object to build is the general qubit ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], 
     StyleBox["\[Alpha]", "TI"], 
     TemplateBox[{"0"},
      "Ket"]}], "+", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      StyleBox[
       RowBox[{"i", "\[Beta]"}], "TI"]], 
     StyleBox["sin",
      FontSlant->"Plain"], 
     StyleBox["\[Alpha]", "TI"], 
     TemplateBox[{"1"},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],
 ": not one state but the whole two-parameter family at once. Build it:"
}], "Text",
 CellID->67888809,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"psi", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Alpha]", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Alpha]", "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "\[Beta]"}], "]"}]}]}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[6]:=",
 CellID->1432876021,ExpressionUUID->"1f908cf3-3c70-d55a-45af-25bdb50abfa0"],

