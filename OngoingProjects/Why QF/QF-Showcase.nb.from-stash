Cell[TextData[{
 "The object reports its parameters ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["n", "TI"], ",", 
     StyleBox["k", "TI"], ",", 
     StyleBox["d", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{"5", ",", "1", ",", "3"}], 
    StyleBox["]",
     SpanMaxSize->1]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d2ec88d-5e53-28f6-54d5-e1d75be67adc"],
 ": five physical qubits carry one logical qubit at distance ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230fc3bf-d3e5-5aa5-5134-daf8e590288f"],
 ". Its four stabilizer generators and its logical operators are read off the \
check matrix, not supplied:"
}], "Text",
 CellID->471452856,ExpressionUUID->"0c6e076f-8b93-3c10-3415-9f492e27877a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"code", "[", "\"\<Generators\>\"", "]"}], ",", " ", 
   RowBox[{"code", "[", "\"\<LogicalX\>\"", "]"}], ",", " ", 
   RowBox[{"code", "[", "\"\<LogicalZ\>\"", "]"}]}], "}"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->1993504316,ExpressionUUID->"29094997-c9cb-f733-5f37-60d0e87fda19"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"XZZXI\"\>", ",", "\<\"IXZZX\"\>", ",", "\<\"XIXZZ\"\>", 
     ",", "\<\"ZXIXZ\"\>"}], "}"}], ",", 
   RowBox[{"{", "\<\"ZIIZX\"\>", "}"}], ",", 
   RowBox[{"{", "\<\"ZZZZZ\"\>", "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.0009436059973173`*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"f4afd1f7-ec05-4958-aa6f-a653e64a135f"]
}, Open  ]],

Cell[TextData[{
 "The generators return as the cyclic set ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["X", "TI"], 
    StyleBox["Z", "TI"], 
    StyleBox["Z", "TI"], 
    StyleBox["X", "TI"], 
    StyleBox["I", "TI"]}], ",", 
   StyleBox[
    RowBox[{"I", "X", "Z", "Z", "X"}], "TI"], ",", 
   StyleBox[
    RowBox[{"X", "I", "X", "Z", "Z"}], "TI"], ",", 
   RowBox[{
    StyleBox["Z", "TI"], 
    StyleBox["X", "TI"], 
    StyleBox["I", "TI"], 
    StyleBox["X", "TI"], 
    StyleBox["Z", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "284fc6fb-b6ce-6422-5874-dfa4c37b4f08"],
 ", with logical ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["X", "TI"], "_"], "=", 
   StyleBox["Z", "TI"], 
   StyleBox["I", "TI"], 
   StyleBox["I", "TI"], 
   StyleBox["Z", "TI"], 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cad16aa-0a89-b805-3452-8ff4af3d0b6f"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["Z", "TI"], "_"], "=", 
   StyleBox["Z", "TI"], 
   StyleBox["Z", "TI"], 
   StyleBox["Z", "TI"], 
   StyleBox["Z", "TI"], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5640583a-c911-1fe8-7e70-5267e8a46532"],
 "."
}], "Text",
 CellID->1944276818,ExpressionUUID->"6944803a-8297-e066-1f7b-1a643723b34c"],

Cell[TextData[{
 "Distance ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9e495e-a796-7cd0-26a6-611bd223463a"],
 " means the code should correct every weight-one error and no guarantee \
beyond that. This is the Knill-Laflamme condition, and it is checked on the \
Pauli algebra directly, with no ",
 Cell[BoxData[
  SuperscriptBox["2", "5"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "534f7e63-03c8-ee33-0175-704db662b519"],
 " state vector formed:"
}], "Text",
 CellID->524220529,ExpressionUUID->"3b07ad27-9e6a-154b-693c-44811b1f7f91"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"code", "[", 
    RowBox[{"\"\<CorrectableQ\>\"", ",", " ", 
     RowBox[{"\"\<Weight\>\"", "[", "1", "]"}]}], "]"}], ",", " ", 
   RowBox[{"code", "[", 
    RowBox[{"\"\<CorrectableQ\>\"", ",", " ", 
     RowBox[{"\"\<Weight\>\"", "[", "2", "]"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[9]:=",
 CellID->950216136,ExpressionUUID->"1c7a415c-3e53-b7cb-441a-5906bbe71d11"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellChangeTimes->{4.00094362045977*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"64a48746-5095-4eb3-b1d0-17611de6c30d"]
}, Open  ]],

Cell[TextData[{
 "The pair returns ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["True",
     FontSlant->"Plain"]}], ",", 
   RowBox[{
    StyleBox["False",
     FontSlant->"Plain"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "417aec05-2fbb-8238-7719-066f4a4fd102"],
 ": every single-qubit error is correctable, some weight-two error is not, \
which is distance ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4705486f-1ac0-4964-6d3b-62499f75184e"],
 " stated as a decision rather than a number."
}], "Text",
 CellID->338647958,ExpressionUUID->"3af5a034-7641-6879-6a8a-3a7e03f43b43"],

Cell[TextData[{
 "The figure of merit is the logical error rate: the probability that a \
correction cycle leaves a logical fault. Give the code depolarizing noise at \
a ",
 StyleBox["symbolic", "TI"],
 " rate ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68379bed-79e9-22be-19cc-12b77f9c7084"],
 ", and the rate comes back as an exact function of ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "460eb9f9-c41e-8ef4-6e35-30a2eda8d4de"],
 ", summed over all ",
 Cell[BoxData[
  SuperscriptBox["4", "5"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "258251be-7c16-7495-53b2-48f875a35eff"],
 " error patterns:"
}], "Text",
 CellID->961910044,ExpressionUUID->"35c1f832-722b-ca69-63fe-f27c07df98b3"],

