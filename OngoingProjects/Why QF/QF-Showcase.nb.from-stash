Cell["Read the reconstructed density matrix:", "Text",
 CellID->408837332,ExpressionUUID->"7c22b8c2-70f4-0562-25d1-31ac00816c48"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"est", "[", "\"\<MaximumLikelihoodState\>\"", "]"}], 
    "[", "\"\<DensityMatrix\>\"", "]"}], " ", "//", " ", "Normal"}], " ", "//",
   " ", "Chop"}]], "Input",
 CellLabel->"In[90]:=",
 CellID->1068510841,ExpressionUUID->"04fec585-b88c-469b-2c85-dcef39392ce1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.7514422909036321`", ",", 
     RowBox[{"0.301830527771225`", "\[VeryThinSpace]", "-", 
      RowBox[{"0.3093139292862141`", " ", "\[ImaginaryI]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"0.301830527771225`", "\[VeryThinSpace]", "+", 
      RowBox[{"0.3093139292862141`", " ", "\[ImaginaryI]"}]}], ",", 
     "0.24855770909636793`"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.000942701406787*^9},
 CellLabel->"Out[90]=",ExpressionUUID->"b02faf2f-8ea4-40dc-a818-d05eed19661d"]
}, Open  ]],

Cell[TextData[{
 "The recovered matrix agrees closely with the true one, whose exact entries \
are ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "11"], "=", 
   FractionBox["3", "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aa617d4-4041-969d-2a5d-8e9e71f5fce7"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "12"], "=", 
   FractionBox[
    SqrtBox["3"], "4"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], "\[Pi]", "/", "4"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e86e5c8-d785-1389-06bd-fc95e23061d3"],
 ", with entry-wise residuals at the scale shot noise sets, ",
 Cell[BoxData[
  RowBox[{"\[Tilde]", "1", "/", 
   SqrtBox["2000"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3582ea65-851b-2569-63b1-0c4f2caf8fb3"],
 "; which entries deviate, and by how much, changes with every fresh sample. \
To summarize the reconstruction in one number, compute its fidelity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["F", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], ",", 
    StyleBox["\[Sigma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   SqrtBox[
    RowBox[{
     SqrtBox[
      StyleBox["\[Rho]", "TI"]], "\[ThinSpace]", 
     StyleBox["\[Sigma]", "TI"], "\[ThinSpace]", 
     SqrtBox[
      StyleBox["\[Rho]", "TI"]]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e81d752-d9a7-cf7a-06be-cf1fd8539240"],
 " to the original state, equal to ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dc17641-57cc-3497-1bff-682b627e9efd"],
 " exactly when the two states coincide:"
}], "Text",
 CellID->1027032549,ExpressionUUID->"647a9320-5a37-336f-0c19-0a8a5fc381b5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumSimilarity", "[", 
  RowBox[{"true", ",", " ", 
   RowBox[{"est", "[", "\"\<MaximumLikelihoodState\>\"", "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[91]:=",
 CellID->171792661,ExpressionUUID->"57b40e76-1aa6-da65-7d4b-a0309f50a94f"],

Cell[BoxData["0.999984582472182`"], "Output",
 CellChangeTimes->{4.000942701422029*^9},
 CellLabel->"Out[91]=",ExpressionUUID->"5a13ecb9-0b55-4827-998e-cb9cbb20dfd4"]
}, Open  ]],

Cell[TextData[{
 "The fidelity is close to ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "575b10e3-003a-b957-7d78-89cdb1cc0bbd"],
 ", its deviation set by the shot noise, of order ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox["2000"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c7345dd-208f-a284-2401-5c87513bf0ee"],
 ": the unknown state recovered from finite, noisy synthetic data, using only \
counts in three bases. Beyond these unitary measurement bases, the same basis \
mechanism continues into the over-complete operator frames, where ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["B", "TI"], 
   RowBox[{"-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0121a537-2575-8479-30de-3d714c01ef43"],
 " becomes a dual frame and a state becomes a probability vector, the \
mechanism behind the SIC measurement above."
}], "Text",
 CellID->574949478,ExpressionUUID->"7f325126-465a-e19d-26c2-488073ecb3e7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Claim 3: Measurement records are quantum wires, and feedforward is a \
controlled gate\
\>", "Section",
 CellID->1664775781,ExpressionUUID->"739af998-c5c1-31b3-21b9-f0c5ec758399"],

Cell[TextData[{
 StyleBox["Key feature:",
  FontWeight->"Bold"],
 " Claim 2 used measurement to estimate a state; here measurement itself is \
decomposed. QF implements a projective measurement as von Neumann's \
measurement interaction, not as a collapse: it appends a pointer qudit and \
entangles it with the system, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["V", "TI"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["k", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     RowBox[{
      StyleBox["(",
       FontSize->1.2 Inherited], 
      RowBox[{
       SubscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["k", "TI"]], 
       TemplateBox[{
         StyleBox["\[Psi]", "TI"]},
        "Ket"]}], 
      StyleBox[")",
       FontSize->1.2 Inherited]}], "\[CircleTimes]", 
     TemplateBox[{
       StyleBox["k", "TI"]},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "003becda-d908-4451-31d8-0587d8bd2ebb"],
 ". The record of the measurement is therefore itself a quantum wire, \
numbered ",
 Cell[BoxData[
  RowBox[{"0", ",", 
   RowBox[{"-", "1"}], ",", 
   RowBox[{"-", "2"}], ",", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aeb468a-2cc6-59e2-2ae9-5fd445732bc8"],
 " alongside the system wires; every branch remains in the state, and \
feedforward, acting on the system conditioned on an earlier outcome, is \
simply a gate controlled on a record wire. Protocols that combine measurement \
with conditioned gates, teleportation, error correction, measurement-based \
computing, remain inside one symbolic object."
}], "Text",
 CellID->884697794,ExpressionUUID->"3873a668-04d7-31ac-6800-3832ad6383f6"],

Cell[TextData[{
 StyleBox["Closest competitor.",
  FontWeight->"Bold"],
 " Cirq and PennyLane both ship a ",
 Cell[BoxData["defer_measurements"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4156c81a-8a68-59d7-776d-e2442f1d2b3d"],
 " transform that turns mid-circuit measurement into exactly this \
controlled-on-a-record mechanism; QF's edge is generality, not kind: \
arbitrary observables, degenerate rank-",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e7ab4-00f8-e339-7ea6-73feb172ce03"],
 " projectors, POVM and Naimark dilations, qudits, and a record that can be \
read jointly and inverted, not just a deferred computational-basis bit."
}], "Text",
 CellID->784201795,ExpressionUUID->"0b3ec616-de69-0141-3ac5-d853db1c53ab"],

Cell[CellGroupData[{

Cell["Teleportation: the classical channel as a quantum wire", "Subsection",
 CellID->1193259712,ExpressionUUID->"7c0d57bf-7ae8-3253-2433-4ef97e8280b9"],

Cell[TextData[{
 "Teleportation is the clearest illustration of a measurement record used as \
a wire. In the textbook protocol Alice measures her two qubits in the Bell \
basis and sends the two classical bits to Bob, who applies ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["X", "TI"], 
    SubscriptBox[
     StyleBox["m", "TI"], "2"]], 
   SuperscriptBox[
    StyleBox["Z", "TI"], 
    SubscriptBox[
     StyleBox["m", "TI"], "1"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aaecb0d-dff0-cd78-3a55-e356d98a9442"],
 " to his half of an entangled pair. The deferred-measurement principle \
states that this classical communication is not required: the corrections can \
be conditioned on the records themselves. Build exactly that, qubit ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fe4a286-576e-fd11-759b-3be06218c47b"],
 " carrying the unknown state, qubits ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07179650-9fbb-2bc1-2d2c-081a1a4e792b"],
 " and ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aecd320-e31f-2936-2a93-ca8d96aa781c"],
 " in a Bell pair:"
}], "Text",
 CellID->1084903799,ExpressionUUID->"326b0854-5043-0b63-6268-a21e61f65649"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tele", " ", "=", " ", 
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", "\n", "    ", 
    RowBox[{
     RowBox[{"\"\<H\>\"", " ", "->", " ", "2"}], ",", " ", 
     RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
     RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", "\n", "    ", 
     RowBox[{"{", "1", "}"}], ",", " ", 
     RowBox[{"{", "2", "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "3"}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "3"}], "}"}]}]}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[92]:=",
 CellID->964492758,ExpressionUUID->"1d6edc53-4ce5-e0f2-4b15-d61d6491b2d8"],

