Cell["\<\
Read it at two representative points, the origin and half a fringe away in \
momentum:\
\>", "Text",
 CellID->1751712322,ExpressionUUID->"5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"wigner", "[", 
    RowBox[{"0", ",", " ", "0"}], "]"}], ",", " ", 
   RowBox[{"wigner", "[", 
    RowBox[{"0", ",", " ", 
     RowBox[{"1", "/", "2"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[67]:=",
 CellID->1390140890,ExpressionUUID->"2d0df906-1ebb-1081-5b32-f1609b4e62eb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.3182373522252574`", ",", 
   RowBox[{"-", "0.23563771177327072`"}]}], "}"}]], "Output",
 CellChangeTimes->{4.000942700199377*^9},
 CellLabel->"Out[67]=",ExpressionUUID->"e8495b9f-7645-483d-9a9e-440a2c1a543c"]
}, Open  ]],

Cell[TextData[{
 "The first value is positive, the second negative. The first is the \
important one: at the midpoint between the two coherent components, where a \
classical mixture of them would place almost no weight, the Wigner function \
instead has its strongest feature, an interference peak that reaches the \
ceiling ",
 Cell[BoxData[
  RowBox[{"1", "/", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519a4e0d-3467-bfb9-07ba-6057bd130583"],
 " that no Wigner function can exceed. The even cat is a parity eigenstate, \
so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "1", "/", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a891815-8c00-cf41-6ab6-925f25ba95ab"],
 " exactly (here up to the Fock truncation), not merely close to it; the \
neighboring fringe is firmly negative."
}], "Text",
 CellID->1031105928,ExpressionUUID->"0dbacffa-31b0-43f6-3b59-e6a4404511dc"],

Cell[TextData[{
 "The Wigner function is one of a family of phase-space quasi-probabilities, \
and its smoothed counterpart removes the negativity. The Husimi-",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "196a859c-b643-c1b3-4f69-1cd9c3f79399"],
 " function ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["Q", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    FractionBox["1", "\[Pi]"], 
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Bra"], 
    StyleBox["\[Rho]", "TI"], 
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c8a383-1e42-ef31-78f7-3aed9bf4b21b"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], "+", 
    StyleBox["i", "TI"], 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50735439-04fd-dee7-0001-4e63ac89a4cd"],
 ", is the Wigner function convolved with a coherent-state Gaussian; that \
smoothing makes it non-negative everywhere, at the cost of removing the \
nonclassicality the Wigner reveals. Build it over the same window, slightly \
taller in ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3597ba8d-914b-928f-63ac-33d720ffe0d5"],
 " since the Husimi is wider:"
}], "Text",
 CellID->1410588720,ExpressionUUID->"056fda38-a5bc-2884-3314-dc65cc497aee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"husimi", " ", "=", " ", 
  RowBox[{"HusimiQRepresentation", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"CatState", "[", "]"}], "[", 
     RowBox[{"2", ",", " ", "0"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", 
    RowBox[{"\"\<GridSize\>\"", " ", "->", " ", "90"}]}], "]"}]}]], "Input",
 CellLabel->"In[68]:=",
 CellID->1051974278,ExpressionUUID->"383c4a9f-130c-f8c1-69c4-63d9a6beca2b"],

