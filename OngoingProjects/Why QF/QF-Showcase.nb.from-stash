Cell[TextData[{
 "Simulate ",
 Cell[BoxData["2000"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c435daa-0d1c-c5df-0471-54f4a4aeaf25"],
 " measurement shots in each of the three Pauli bases (seeded for \
reproducibility):"
}], "Text",
 CellID->1528788962,ExpressionUUID->"21714cd0-c04e-e57a-570f-659df1f8cc40"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"data", " ", "=", " ", 
   RowBox[{"QuantumMeasurementSimulation", "[", 
    RowBox[{"true", ",", " ", 
     RowBox[{"QuantumMeasurementOperator", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\""}], 
       "}"}]}], ",", " ", "2000"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[86]:=",
 CellID->1505774531,ExpressionUUID->"74ff421b-073b-c6d4-1c85-6445b2cfac3e"],

Cell["Look at the raw counts:", "Text",
 CellID->535490749,ExpressionUUID->"3ebc3a74-dd7c-3fa6-6643-bc31d40e858c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Values", "[", "data", "]"}]], "Input",
 CellLabel->"In[88]:=",
 CellID->1238905205,ExpressionUUID->"7d5c93fe-a057-3a16-2b63-0abbd1e3897c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1605", ",", "395"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1620", ",", "380"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1504", ",", "496"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.000942701340556*^9},
 CellLabel->"Out[88]=",ExpressionUUID->"1ea4d739-3978-4120-9621-1cbacc4ea1a0"]
}, Open  ]],

Cell["\<\
Three pairs of counts return, one per basis: multinomially sampled tallies \
scattered around the Born-rule proportions, different on every fresh sample, \
and all a real experiment ever sees.\
\>", "Text",
 CellID->2125008310,ExpressionUUID->"487dadd0-5ed6-7873-7802-449a5b634b59"],

Cell["\<\
Now pass the counts to the estimator, which performs linear inversion \
followed by maximum-likelihood:\
\>", "Text",
 CellID->1684656716,ExpressionUUID->"5219761b-8a64-c9ff-0227-68452f169bc5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"est", " ", "=", " ", 
  RowBox[{"QuantumStateEstimate", "[", "data", "]"}]}]], "Input",
 CellLabel->"In[89]:=",
 CellID->2057792111,ExpressionUUID->"69346765-6d1c-e9c9-18cc-7f4f04aebb13"],

