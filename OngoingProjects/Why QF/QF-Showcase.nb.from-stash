  RowBox[{
   StyleBox["J", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7e6892-18cd-6f45-4b05-81dc997835af"],
 "):"
}], "Text",
 CellID->1870754514,ExpressionUUID->"325c8f47-cd85-89da-6263-2720e431db20"],

