Cell[TextData[{
 "The same state spreads into a three-term superposition over the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7af061c8-c44a-ae8e-2a80-7895edfcf4d4"],
 " levels: one ket in its own basis, a sum in the other. The named operator \
",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d437dad-8290-de9a-3b71-74f7372aa4e0"],
 " is itself stored in its own eigenbasis, so the expectation ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["x", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Bra"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["x", "TI"]], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aafc905-908a-67da-2a54-e16f213f4d20"],
 " involves three declared bases at once; compute it from both \
representations of the state:"
}], "Text",
 CellID->853117843,ExpressionUUID->"62016b94-8ad8-fb56-123e-82de2f52c9bc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<JX basis\>\"", " ", "->", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"mx", "[", "\"\<Dagger\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<JX\>\"", "[", "1", "]"}], "]"}], "[", "mx", "]"}], "]"}],
      "[", "\"\<Scalar\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Computational basis\>\"", " ", "->", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"mxZ", "[", "\"\<Dagger\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<JX\>\"", "[", "1", "]"}], "]"}], "[", "mxZ", "]"}], 
      "]"}], "[", "\"\<Scalar\>\"", "]"}]}]}], "|>"}]], "Input",
 CellLabel->"In[76]:=",
 CellID->623836386,ExpressionUUID->"0e7c794a-82c2-56e7-3604-711437773ccd"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"JX basis\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"Computational basis\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.0009427008228893`*^9},
 CellLabel->"Out[76]=",ExpressionUUID->"223adbc7-3d68-427e-a24c-ff1a8782a0d8"]
}, Open  ]],

Cell[TextData[{
 "Both entries return as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30f601cf-5001-fb68-608d-98a961b5c9b2"],
 ": the state in either coordinate system, the operator in a third, and QF \
reconciled them all; the invariant survives every change of coordinates."
}], "Text",
 CellID->564394165,ExpressionUUID->"04bc0f0b-f02f-243d-2c43-a75481db8f07"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Any finite dimension: a spin-1 qutrit and a five-site ring", \
"Subsection",
 CellID->2048244887,ExpressionUUID->"1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],

Cell[TextData[{
 "The same spin-1 system supports genuine three-level dynamics, not just a \
change of basis, and the representation extends to any dimension. Its \
zero-field-splitting Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", "2", 
   StyleBox["d", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["z", "TI"], "2"], "+", 
   StyleBox["e", "TI"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubsuperscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["x", "TI"], "2"], "-", 
    SubsuperscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["y", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705e212e-f5a4-7717-2065-b88bfc515a7d"],
 ", the model of an NV-center defect, is built from QF's native spin-1 \
operators with both couplings left symbolic. First the three spin-1 operators:"
}], "Text",
 CellID->1432457359,ExpressionUUID->"5c2f5325-a3f6-c048-05d5-4a8ed5809292"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"jx", ",", " ", "jy", ",", " ", "jz"}], "}"}], " ", "=", " ", 
  RowBox[{"QuantumOperator", " ", "/@", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<JX\>\"", "[", "1", "]"}], ",", " ", 
     RowBox[{"\"\<JY\>\"", "[", "1", "]"}], ",", " ", 
     RowBox[{"\"\<JZ\>\"", "[", "1", "]"}]}], "}"}]}]}]], "Input",
 CellLabel->"In[77]:=",
 CellID->200346680,ExpressionUUID->"211ecaf2-61ee-418f-5725-e3bc179b13d5"],

