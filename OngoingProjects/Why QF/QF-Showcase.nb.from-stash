Cell[TextData[{
 "The call returns a ",
 Cell[BoxData["ServiceObject"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "528dc1d5-50f2-4d74-8cc8-6d8dd52c82cd"],
 " connection handle. A QPU job needs a circuit that ends in a measurement; \
in QF a list of qubit indices placed in the circuit is exactly that, so ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4427edb-a7bd-48a1-96d3-f6cea24e4bd2"],
 " measures all three qubits. Build the measured GHZ circuit:"
}], "Text",ExpressionUUID->"75757f52-4068-4158-bc9d-9bbac8e23786"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ghz", " ", "=", " ", 
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<GHZ\>\"", "[", "3", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "}"}], 
   "]"}]}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"1f664915-c269-41ba-af9d-26fdf805f807"],

