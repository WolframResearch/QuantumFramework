Cell[TextData[{
 "Now ",
 Cell[BoxData[
  RowBox[{"op", "[", 
   RowBox[{"g", ",", " ", "t"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],
 " is the Landau-Zener propagator at adiabaticity ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],
 " and time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51fce014-dca1-0630-0783-fa51d5546d1a"],
 ", evaluated numerically on demand."
}], "Text",
 CellID->1717363484,ExpressionUUID->"657c1c65-980e-511d-1303-964f19bb2067"],

Cell[TextData[{
 "The survival is the probability of staying in the diabatic ground state ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],
 " across the sweep. Propagate ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9b7e66-629a-1114-26b9-7040172f607e"],
 " from well before the crossing at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "-", "10"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "585a51e6-774f-2dd2-087a-48c002fa7738"],
 " to time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["t", "TI"], ",", 
    RowBox[{"-", "10"}]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["op",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["g", "TI"], ",", 
    StyleBox["t", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["op",
    FontSlant->"Plain"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["g", "TI"], ",", 
      RowBox[{"-", "10"}]}], 
     StyleBox["]",
      SpanMaxSize->1]}], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370294fd-9e49-2d35-5d31-0da71bfc741f"],
 ", and read off ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{"0", 
        RowBox[{
          StyleBox["\[Psi]", "TI"], 
          StyleBox["(", SpanMaxSize -> 1], 
          StyleBox["t", "TI"], 
          StyleBox[")", SpanMaxSize -> 1]}]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2845529c-454d-b13b-587b-4bc66cf90001"],
 ":"
}], "Text",
 CellID->1781880651,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "survival", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"survival", "[", 
    RowBox[{"g_", ",", " ", "t_"}], "]"}], " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"op", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"-", "10"}]}], "]"}], "[", "\"\<Dagger\>\"", "]"}], "[", 
        "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], 
           "[", "\"\<Dagger\>\"", "]"}], "@", 
          RowBox[{
           RowBox[{"op", "[", 
            RowBox[{"g", ",", " ", "t"}], "]"}], "[", "c", "]"}]}], ")"}], 
        "[", "\"\<Scalar\>\"", "]"}], "]"}], "^", "2"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[20]:=",
 CellID->1536527082,ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"survival", "[", 
   RowBox[{"g", ",", " ", "t"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6405505f-4b92-3bd6-0c3b-4a196e24893c"],
 " is now a closed-form function of adiabaticity and time, assembled entirely \
by composing QF objects, without a differential solver."
}], "Text",
 CellID->1621535814,ExpressionUUID->"6878c7f8-419e-9db5-1807-dea27028e79f"],

Cell[TextData[{
 "Take three regimes: a fast (diabatic) sweep, an intermediate one, and a \
slow (adiabatic) sweep, set by the single ratio ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalDelta]", "2"], "/", 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48a3d607-c312-9dd3-7850-c860f6a4e739"],
 ":"
}], "Text",
 CellID->1193935837,ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ratios", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.1", ",", " ", "0.6", ",", " ", "1.6"}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[22]:=",
 CellID->105329933,ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell[TextData[{
 "Plot the survival across the crossing for each, with the asymptotic \
Landau-Zener formula ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "\[Pi]", 
    SuperscriptBox["\[CapitalDelta]", "2"], "/", "2", 
    StyleBox["v", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023f49e2-a747-9723-33c5-60cfd2f3fa09"],
 " drawn as dashed lines:"
}], "Text",
 CellID->1234416869,ExpressionUUID->"21aa1c49-e16c-f406-57a9-9612901edf6c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"survival", "[", 
       RowBox[{"g", ",", " ", "t"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"g", ",", " ", "ratios"}], "}"}]}], "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", 
     RowBox[{"-", "10"}], ",", " ", "10"}], "}"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time  t  (avoided crossing at t = 0)\>\"", ",", "\n", 
      "        ", "\"\<Survival  |\[LeftAngleBracket]0|\[Psi](t)\
\[RightAngleBracket]|^2\>\""}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<\[CapitalDelta]\.b2/v = 0.1  (diabatic)\>\"", ",", 
        " ", "\"\<0.6  (intermediate)\>\"", ",", "\n", 
        "    ", "\"\<1.6  (adiabatic)\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.78", ",", " ", "0.6"}], "}"}]}], "]"}]}], ",", "\n", "    ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Gray", ",", " ", "Dashed", ",", " ", 
      RowBox[{"Sequence", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "10"}], ",", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "Pi"}], " ", 
                 RowBox[{"#", "/", "2"}]}], "]"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"10", ",", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "Pi"}], " ", 
                 RowBox[{"#", "/", "2"}]}], "]"}]}], "}"}]}], "}"}], "]"}], 
          " ", "&"}], " ", "/@", " ", "ratios"}], ")"}]}]}], "}"}]}], ",", 
   "\n", "    ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "0", "}"}], ",", " ", "None"}], "}"}]}]}], "]"}]], "Input",\

 CellLabel->"In[23]:=",
 CellID->240380995,ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"],

